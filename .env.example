# Copy .env.example to .env and customize for your machine.
#  Or don't. The defaults in src/harness/config.ts will work for most MacOS setups.

# Antigravity Configuration
# Model selection for Antigravity CLI agent runs
ANTIGRAVITY_MODEL='gemini-3.8-flash-medium'
# Optional: GCP project for Antigravity CLI. Only needed if you use agy through a GCP project
# (falls back to gcp.project in ~/.gemini/antigravity-cli/settings.json). Leave unset for a personal account.
# ANTIGRAVITY_GCP_PROJECT=<YOUR-GCP-PROJECT-ID>

# Optional toggle: use Jetski CLI instead of the default Antigravity CLI for 'gd dev'
# GD_DEV_USE_JETSKI=1
