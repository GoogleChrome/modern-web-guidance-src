# Copy .env.example to .env and customize for your machine.
#  Or don't. The defaults in harness/config.js will work for most MacOS setups.

# Jetski Configuration
# Model selection for Jetski CLI agent runs
JETSKI_MODEL='Gemini 3.6 Flash'

# Optional toggle: use Gemini CLI instead of the default Jetski CLI for 'gd dev'
# GD_DEV_USE_GEMINI=1
