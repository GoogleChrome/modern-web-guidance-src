{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "allows": [],
        "patterns": [
          {
            "name": "Google Workstation Path (/usr/local/google/home/...)",
            "pattern": "/\\/usr\\/local\\/google\\/home\\/[a-zA-Z0-9_-]+/"
          },
          {
            "name": "Google Internal Corp URL (*.corp.google.com)",
            "pattern": "/https?:\\/\\/[a-zA-Z0-9.-]+\\.corp\\.google\\.com/"
          }
        ]
      }
    }
  ]
}
