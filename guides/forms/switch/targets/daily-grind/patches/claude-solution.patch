+    /* Switch */
+    .preferences {
+      margin-top: 40px;
+      text-align: center;
+    }
+
+    .switch-label {
+      display: inline-flex;
+      align-items: center;
+      gap: 12px;
+      cursor: pointer;
+    }
+
+    input[type="checkbox"][switch] {
+      accent-color: var(--accent-color, #1769e0);
+      margin: 0;
+      cursor: pointer;
+    }
+
+    input[type="checkbox"][switch]:focus-visible {
+      outline: 3px solid var(--focus-color, #ff8c00);
+      outline-offset: 4px;
+    }
+
+    /* Fallback styling when native switch is unsupported */
+    .no-native-switch input[type="checkbox"][switch] {
+      appearance: none;
+      -webkit-appearance: none;
+      display: inline-block;
+      position: relative;
+      width: 44px;
+      height: 24px;
+      border-radius: 12px;
+      background: #9e9e9e;
+      transition: background 0.2s;
+    }
+
+    .no-native-switch input[type="checkbox"][switch]::before {
+      content: "";
+      position: absolute;
+      top: 2px;
+      left: 2px;
+      width: 20px;
+      height: 20px;
+      border-radius: 50%;
+      background: white;
+      transition: transform 0.2s;
+    }
+
+    .no-native-switch input[type="checkbox"][switch]:checked {
+      background: var(--accent-color, #1769e0);
+    }
+
+    .no-native-switch input[type="checkbox"][switch]:checked::before {
+      transform: translateX(20px);
+    }
