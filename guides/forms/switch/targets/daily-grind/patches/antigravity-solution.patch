+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const notificationsSwitch = document.getElementById('notifications');
+    const preferenceStatus = document.getElementById('preference-status');
+
+    if (notificationsSwitch && preferenceStatus) {
+      notificationsSwitch.addEventListener('change', (event) => {
+        const isEnabled = event.target.checked;
+        preferenceStatus.textContent = isEnabled
+          ? 'Notifications are currently enabled.'
+          : 'Notifications are currently disabled.';
+      });
+    }
+  </script>
+
