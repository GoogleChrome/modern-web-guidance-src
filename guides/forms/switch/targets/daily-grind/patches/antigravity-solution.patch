+  <script>
+    (() => {
+      const storageKey = 'daily-grind:seasonal-alerts';
+      const form = document.getElementById('preferences-form');
+      const toggle = document.getElementById('seasonal-alerts');
+      const status = document.getElementById('seasonal-alerts-status');
+
+      if (!form || !toggle || !status) {
+        return;
+      }
+
+      const updateStatus = (enabled) => {
+        status.textContent = enabled
+          ? 'Notifications are currently on.'
+          : 'Notifications are currently off.';
+      };
+
+      try {
+        const saved = localStorage.getItem(storageKey);
+        if (saved === 'true') {
+          toggle.checked = true;
+        }
+      } catch {
+        // Ignore storage access errors in restricted contexts.
+      }
+
+      updateStatus(toggle.checked);
+
+      toggle.addEventListener('change', (event) => {
+        const isChecked = event.target.checked;
+        updateStatus(isChecked);
+        try {
+          localStorage.setItem(storageKey, String(isChecked));
+        } catch {
+          // Ignore storage access errors in restricted contexts.
+        }
+      });
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+      });
+    })();
+  </script>
+
