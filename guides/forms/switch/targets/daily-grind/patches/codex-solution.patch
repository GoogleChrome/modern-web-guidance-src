--- /dev/null
+++ b/preferences.js
@@ -0,0 +1,37 @@
+// @ts-check
+
+const themeToggle = document.getElementById('dark-theme');
+const themeStatus = document.getElementById('dark-theme-status');
+const storageKey = 'daily-grind-dark-theme';
+
+if (themeToggle instanceof HTMLInputElement && themeStatus instanceof HTMLElement) {
+  const applyTheme = () => {
+    document.documentElement.dataset.theme = themeToggle.checked ? 'dark' : 'light';
+    themeStatus.textContent = themeToggle.checked ? 'On' : 'Off';
+  };
+
+  try {
+    themeToggle.checked = localStorage.getItem(storageKey) === 'true';
+  } catch {
+    // The preference still works when browser storage is unavailable.
+  }
+  applyTheme();
+
+  themeToggle.addEventListener('change', () => {
+    applyTheme();
+    try {
+      localStorage.setItem(storageKey, String(themeToggle.checked));
+    } catch {
+      // Keep the selected theme for this visit if storage is blocked or full.
+    }
+  });
+
+  // Restore the matching appearance when navigating back to a cached page.
+  window.addEventListener('pageshow', applyTheme);
+}
+
+if (!('switch' in HTMLInputElement.prototype)) {
+  import('https://cdn.jsdelivr.net/npm/input-switch-polyfill@1.12.0/input-switch-polyfill.js').catch(() => {
+    // Preserve a usable, labeled native checkbox if the enhancement cannot load.
+  });
+}
