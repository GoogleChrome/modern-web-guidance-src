diff --git a/main.js b/main.js
new file mode 100644
index 0000000..fc4e0b9
--- /dev/null
+++ b/main.js
@@ -0,0 +1,22 @@
+// Keep the native control in browsers that support it. The local polyfill
+// supplies switch styling, semantics, accent-color syncing, and pointer drag.
+if (!('switch' in HTMLInputElement.prototype)) {
+  import('input-switch-polyfill').catch((error) => {
+    // The labeled checkbox remains usable if the enhancement cannot load.
+    console.error('Unable to load switch enhancement.', error);
+  });
+}
+
+const coffeeUpdates = document.getElementById('coffee-updates');
+const coffeeUpdatesStatus = document.getElementById('coffee-updates-status');
+
+if (coffeeUpdates instanceof HTMLInputElement && coffeeUpdatesStatus) {
+  const updateStatus = () => {
+    coffeeUpdatesStatus.textContent = coffeeUpdates.checked
+      ? 'Coffee updates are on.'
+      : 'Coffee updates are off.';
+  };
+
+  coffeeUpdates.addEventListener('change', updateStatus);
+  updateStatus();
+}
