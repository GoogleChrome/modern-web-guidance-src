diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..52dcec2
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,23 @@
+import { copyFile, mkdir, rename, rm } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+const root = new URL('../', import.meta.url);
+const destination = new URL('dist/', root);
+const staging = new URL('.build/', root);
+
+// Publish only after every required file is available, including the CSS
+// fetched by the polyfill relative to its own module URL.
+await rm(staging, { recursive: true, force: true });
+await mkdir(new URL('vendor/input-switch-polyfill/', staging), { recursive: true });
+for (const file of ['index.html', 'main.js']) {
+  await copyFile(new URL(file, root), new URL(file, staging));
+}
+for (const file of ['input-switch-polyfill.js', 'input-switch-polyfill.css']) {
+  await copyFile(
+    new URL(`node_modules/input-switch-polyfill/${file}`, root),
+    new URL(`vendor/input-switch-polyfill/${file}`, staging),
+  );
+}
+await rm(destination, { recursive: true, force: true });
+await rename(staging, destination);
+console.log(`Built static application at ${fileURLToPath(destination)}`);
