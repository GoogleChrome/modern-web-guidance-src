+  <script>
+    // Fallback for browsers that do not support customizable select
+    if (!CSS.supports('appearance', 'base-select')) {
+      const picker = document.getElementById('roast-picker');
+      if (picker) {
+        // Remove the custom button trigger
+        const button = picker.querySelector('button');
+        if (button) {
+          button.remove();
+        }
+        // Simplify options for standard select
+        const options = picker.querySelectorAll('option');
+        options.forEach(option => {
+          const label = option.querySelector('.label');
+          if (label) {
+            // Keep it simple, just text
+            option.textContent = label.textContent;
+          }
+        });
+        // Remove container styling that might look bad with standard select
+        picker.style.appearance = 'auto'; // ensure default appearance
+      }
+    }
+  </script>
