+/**
+ * Extracts only the host domain (hostname) without scheme, port, or path,
+ * as required by the WebOTP and origin-bound SMS specification.
+ */
+export function extractHostDomain(rawOriginOrHost: string): string {
+  const trimmed = rawOriginOrHost.trim();
+  if (!trimmed) {
+    return 'example.com';
+  }
+
+  try {
+    const withProtocol = /^https?:\/\//i.test(trimmed) ? trimmed : `https://${trimmed}`;
+    const parsed = new URL(withProtocol);
+    return parsed.hostname || 'example.com';
+  } catch {
+    return trimmed
+      .replace(/^https?:\/\//i, '')
+      .split('/')[0]
+      .split(':')[0]
+      .replace(/\s+/g, '') || 'example.com';
+  }
+}
+
+/**
+ * Formats an outgoing SMS message with human-readable text first and the
+ * origin-bound `@<domain> #<otp>` token on the final line.
+ * Supports optional cross-origin iframe domain binding (`@topDomain #code @iframeDomain`).
+ */
+export function formatOriginBoundSms(
+  domain: string,
+  code: string,
+  iframeDomain?: string
+): string {
+  const cleanHost = extractHostDomain(domain);
+  const cleanCode = code.replace(/\s+/g, '');
+
+  const originBoundLine = iframeDomain
+    ? `@${cleanHost} #${cleanCode} @${extractHostDomain(iframeDomain)}`
+    : `@${cleanHost} #${cleanCode}`;
+
+  return `Your verification code is ${cleanCode}.\n\n${originBoundLine}`;
+}
