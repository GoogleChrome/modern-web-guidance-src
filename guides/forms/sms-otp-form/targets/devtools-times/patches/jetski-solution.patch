+import type { APIRoute } from 'astro';
+import { formatOriginBoundSms } from '../../utils/smsOtp';
+
+export const POST: APIRoute = async ({ request, url }) => {
+  let otp = '';
+
+  const contentType = request.headers.get('content-type') || '';
+  try {
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      otp = typeof body?.otp === 'string' ? body.otp.trim() : '';
+    } else if (
+      contentType.includes('multipart/form-data') ||
+      contentType.includes('application/x-www-form-urlencoded')
+    ) {
+      const formData = await request.formData();
+      const rawOtp = formData.get('otp');
+      otp = typeof rawOtp === 'string' ? rawOtp.trim() : '';
+    } else {
+      const text = await request.text();
+      const params = new URLSearchParams(text);
+      otp = (params.get('otp') || text).trim();
+    }
+  } catch {
+    otp = '';
+  }
+
+  if (!/^\d{6}$/.test(otp)) {
+    return new Response(
+      JSON.stringify({
+        ok: false,
+        verified: false,
+        error: 'Please enter a valid 6-digit numeric verification code.',
+      }),
+      {
+        status: 400,
+        headers: {
+          'Content-Type': 'application/json',
+          'Permissions-Policy': 'otp-credentials=(self)',
+        },
+      }
+    );
+  }
+
+  const smsFormatExample = formatOriginBoundSms(url.hostname, otp);
+
+  return new Response(
+    JSON.stringify({
+      ok: true,
+      verified: true,
+      code: otp,
+      message: 'Phone number verified successfully.',
+      smsFormatExample,
+    }),
+    {
+      status: 200,
+      headers: {
+        'Content-Type': 'application/json',
+        'Permissions-Policy': 'otp-credentials=(self)',
+      },
+    }
+  );
+};
+
+export const GET: APIRoute = async ({ url }) => {
+  const sampleCode = '123456';
+  return new Response(
+    JSON.stringify({
+      ok: true,
+      smsFormatExample: formatOriginBoundSms(url.hostname, sampleCode),
+    }),
+    {
+      status: 200,
+      headers: {
+        'Content-Type': 'application/json',
+        'Permissions-Policy': 'otp-credentials=(self)',
+      },
+    }
+  );
+};
