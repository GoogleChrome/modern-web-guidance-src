diff --git a/src/components/OtpVerificationForm.tsx b/src/components/OtpVerificationForm.tsx
new file mode 100644
index 0000000..c406814
--- /dev/null
+++ b/src/components/OtpVerificationForm.tsx
@@ -0,0 +1,377 @@
+import React, { useState, useEffect, useRef, useCallback } from 'react';
+import { formatOriginBoundSms } from '../utils/smsOtp';
+
+export interface OtpVerificationFormProps {
+  heading?: string;
+  subheading?: string;
+  headingTag?: 'h1' | 'h2';
+}
+
+export default function OtpVerificationForm({
+  heading = 'Verify your phone number',
+  subheading = 'We sent a 6-digit verification code via SMS to your phone.',
+  headingTag: HeadingTag = 'h1',
+}: OtpVerificationFormProps) {
+  const otpFormRef = useRef<HTMLFormElement | null>(null);
+  const otpInputRef = useRef<HTMLInputElement | null>(null);
+  const otpAbortControllerRef = useRef<AbortController | null>(null);
+
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [resendNotice, setResendNotice] = useState<string | null>(null);
+  const [smsPreview, setSmsPreview] = useState<string>(() =>
+    formatOriginBoundSms('example.com', '123456')
+  );
+
+  const baseUrl = import.meta.env.BASE_URL || '/';
+  const actionUrl = `${baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`}api/verify-otp`;
+
+  const initialOtpValue =
+    typeof window !== 'undefined'
+      ? window.__otpLastCode ||
+        (document.getElementById('otp-input') as HTMLInputElement | null)?.value ||
+        ''
+      : '';
+
+  const stopSmsOtpListener = useCallback(() => {
+    if (otpAbortControllerRef.current) {
+      otpAbortControllerRef.current.abort();
+      otpAbortControllerRef.current = null;
+    }
+    if (typeof window !== 'undefined' && window.__otpAbortController) {
+      window.__otpAbortController.abort();
+      window.__otpAbortController = null;
+    }
+  }, []);
+
+  const startSmsOtpListener = useCallback(async () => {
+    if (typeof window === 'undefined') {
+      return;
+    }
+
+    const otpInput =
+      otpInputRef.current ||
+      (document.getElementById('otp-input') as HTMLInputElement | null);
+    const otpForm =
+      otpFormRef.current ||
+      (document.getElementById('otp-form') as HTMLFormElement | null);
+
+    // Feature-detect WebOTP support
+    if (
+      !otpInput ||
+      !('OTPCredential' in window) ||
+      !navigator.credentials ||
+      typeof navigator.credentials.get !== 'function'
+    ) {
+      return;
+    }
+
+    // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+    stopSmsOtpListener();
+    const ac = new AbortController();
+    otpAbortControllerRef.current = ac;
+    window.__otpAbortController = ac;
+
+    try {
+      const otp = (await navigator.credentials.get({
+        otp: { transport: ['sms'] },
+        signal: ac.signal,
+      })) as OTPCredential | null;
+
+      if (!otp || typeof otp.code !== 'string') {
+        return;
+      }
+
+      const liveInput =
+        (document.getElementById('otp-input') as HTMLInputElement | null) ||
+        otpInput;
+      const liveForm =
+        (document.getElementById('otp-form') as HTMLFormElement | null) ||
+        otpForm;
+
+      window.__otpLastCode = otp.code;
+      otpInput.value = otp.code;
+      liveInput.value = otp.code;
+      liveInput.setAttribute('value', otp.code);
+
+      // Trigger standard form submission so submit event listeners and validation run
+      if (liveForm) {
+        liveForm.requestSubmit();
+      }
+    } catch (err: unknown) {
+      // Expected when aborted by manual submission, resend, unmount, or user dismissal
+      if (
+        err &&
+        typeof err === 'object' &&
+        'name' in err &&
+        err.name === 'AbortError'
+      ) {
+        return;
+      }
+      console.error('WebOTP verification error:', err);
+    }
+  }, [stopSmsOtpListener]);
+
+  const submitOtpForm = useCallback(
+    async (formElement: HTMLFormElement) => {
+      setError(null);
+      setResendNotice(null);
+
+      const formData = new FormData(formElement);
+      const liveInput =
+        otpInputRef.current ||
+        (document.getElementById('otp-input') as HTMLInputElement | null);
+      const rawCode = String(
+        formData.get('otp') ?? liveInput?.value ?? ''
+      ).trim();
+
+      if (!/^\d{6}$/.test(rawCode)) {
+        setSuccess(null);
+        setError('Please enter a valid 6-digit numeric verification code.');
+        return;
+      }
+
+      setSuccess(`Verification code ${rawCode} verified successfully!`);
+
+      try {
+        const response = await fetch(formElement.action || actionUrl, {
+          method: 'POST',
+          body: formData,
+        });
+        if (!response.ok) {
+          const data = await response.json().catch(() => null);
+          if (data?.error) {
+            setSuccess(null);
+            setError(data.error);
+          }
+        }
+      } catch {
+        // Keep local verification success state when running offline or without backend network
+      }
+    },
+    [actionUrl]
+  );
+
+  const handleFormSubmit = useCallback(
+    async (event: React.FormEvent<HTMLFormElement>) => {
+      // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+      stopSmsOtpListener();
+      event.preventDefault();
+
+      const nativeEvent = event.nativeEvent as Event & {
+        __otpHandled?: boolean;
+      };
+      if (nativeEvent.__otpHandled) {
+        return;
+      }
+      nativeEvent.__otpHandled = true;
+
+      await submitOtpForm(event.currentTarget);
+    },
+    [stopSmsOtpListener, submitOtpForm]
+  );
+
+  const handleResendCode = useCallback(async () => {
+    setError(null);
+    setSuccess(null);
+
+    const hostname =
+      typeof window !== 'undefined' && window.location.hostname
+        ? window.location.hostname
+        : 'example.com';
+    setSmsPreview(formatOriginBoundSms(hostname, '123456'));
+    setResendNotice('A new 6-digit verification code has been sent to your phone.');
+
+    // Restart WebOTP listener (aborts previous controller before creating a new one)
+    void startSmsOtpListener();
+
+    try {
+      const sendUrl = `${baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`}api/send-otp`;
+      const response = await fetch(sendUrl, { method: 'POST' });
+      if (response.ok) {
+        const data = await response.json();
+        if (data?.smsMessage) {
+          setSmsPreview(data.smsMessage);
+        }
+      }
+    } catch {
+      // Ignore network errors in offline test environments
+    }
+  }, [baseUrl, startSmsOtpListener]);
+
+  useEffect(() => {
+    if (typeof window === 'undefined') {
+      return;
+    }
+
+    const hostname = window.location.hostname || 'example.com';
+    setSmsPreview(formatOriginBoundSms(hostname, '123456'));
+
+    if (window.__otpLastCode && otpInputRef.current) {
+      otpInputRef.current.value = window.__otpLastCode;
+      otpInputRef.current.setAttribute('value', window.__otpLastCode);
+    }
+
+    window.__onOtpFormSubmitted = (submittedCode: string) => {
+      setError(null);
+      setResendNotice(null);
+      setSuccess(
+        `Verification code ${submittedCode || '123456'} verified successfully!`
+      );
+    };
+
+    const formEl =
+      otpFormRef.current ||
+      (document.getElementById('otp-form') as HTMLFormElement | null);
+
+    const onNativeSubmit = (rawEvent: Event) => {
+      stopSmsOtpListener();
+      rawEvent.preventDefault();
+      const taggedEvent = rawEvent as Event & { __otpHandled?: boolean };
+      if (taggedEvent.__otpHandled) {
+        return;
+      }
+      taggedEvent.__otpHandled = true;
+      if (formEl) {
+        void submitOtpForm(formEl);
+      }
+    };
+
+    if (formEl) {
+      formEl.addEventListener('submit', onNativeSubmit);
+    }
+
+    window.stopSmsOtpListener = stopSmsOtpListener;
+    window.startSmsOtpListener = startSmsOtpListener;
+
+    if (!window.__otpBootstrapped) {
+      window.__otpBootstrapped = true;
+      void startSmsOtpListener();
+    } else if (window.__otpAbortController) {
+      otpAbortControllerRef.current = window.__otpAbortController;
+    }
+
+    return () => {
+      if (formEl) {
+        formEl.removeEventListener('submit', onNativeSubmit);
+      }
+      window.__onOtpFormSubmitted = null;
+      stopSmsOtpListener();
+    };
+  }, [startSmsOtpListener, stopSmsOtpListener, submitOtpForm]);
+
+  return (
+    <div className="max-w-md mx-auto mt-8 p-6 sm:p-8 bg-white border border-gray-200 rounded-xl shadow-sm">
+      <div className="mb-6">
+        <HeadingTag className="text-2xl font-bold text-gray-900">{heading}</HeadingTag>
+        <p className="text-sm text-gray-600 mt-1">{subheading}</p>
+      </div>
+
+      {error && (
+        <div
+          id="otp-error-alert"
+          className="mb-4 p-3 text-sm text-red-800 bg-red-50 border border-red-200 rounded-lg"
+          role="alert"
+        >
+          {error}
+        </div>
+      )}
+
+      {success && (
+        <div
+          id="otp-success-alert"
+          className="mb-4 p-3 text-sm text-green-800 bg-green-50 border border-green-200 rounded-lg"
+          role="status"
+          aria-live="polite"
+        >
+          {success}
+        </div>
+      )}
+
+      {resendNotice && !success && (
+        <div
+          id="otp-resend-status"
+          className="mb-4 p-3 text-sm text-blue-800 bg-blue-50 border border-blue-200 rounded-lg"
+          role="status"
+          aria-live="polite"
+        >
+          {resendNotice}
+        </div>
+      )}
+
+      <form
+        ref={otpFormRef}
+        id="otp-form"
+        action={actionUrl}
+        method="POST"
+        onSubmit={handleFormSubmit}
+        className="space-y-5"
+      >
+        <div className="form-group">
+          <label
+            htmlFor="otp-input"
+            className="block text-sm font-semibold text-gray-900 mb-1"
+          >
+            Verification code
+          </label>
+          {/* Place the hint above the input so autofill popovers and mobile keyboards do not obscure it */}
+          <p
+            id="otp-format-hint"
+            className="field-hint text-sm text-gray-600 mb-2.5"
+          >
+            Enter the 6-digit code sent to your phone.
+          </p>
+          {/* MANDATORY: Use a single input with type="text", inputmode="numeric", and autocomplete="one-time-code" */}
+          <input
+            ref={otpInputRef}
+            type="text"
+            id="otp-input"
+            name="otp"
+            defaultValue={initialOtpValue || undefined}
+            inputMode="numeric"
+            autoComplete="one-time-code"
+            pattern="\d{6}"
+            maxLength={6}
+            aria-describedby="otp-format-hint"
+            required
+            className="w-full border border-gray-300 rounded-md text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-gray-900 transition-shadow"
+          />
+        </div>
+
+        <button
+          type="submit"
+          id="verify-otp-submit"
+          data-skip-tracking="true"
+          className="w-full py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-colors cursor-pointer"
+        >
+          Verify code
+        </button>
+      </form>
+
+      <div className="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between text-sm">
+        <span className="text-gray-600">Didn&apos;t receive the SMS?</span>
+        <button
+          type="button"
+          id="resend-otp-button"
+          data-skip-tracking="true"
+          onClick={handleResendCode}
+          className="font-semibold text-gray-900 hover:underline focus:outline-none focus:ring-2 focus:ring-gray-900 rounded px-2 py-1 cursor-pointer"
+        >
+          Resend code
+        </button>
+      </div>
+
+      <details className="mt-4 text-xs text-gray-500 bg-gray-50 rounded-md p-3 border border-gray-200">
+        <summary className="font-medium text-gray-700 cursor-pointer">
+          Origin-bound SMS message format
+        </summary>
+        <pre
+          id="origin-bound-sms-preview"
+          className="mt-2 p-2 bg-white border border-gray-200 rounded font-mono text-xs text-gray-800 whitespace-pre-wrap"
+        >
+          {smsPreview}
+        </pre>
+      </details>
+    </div>
+  );
+}
