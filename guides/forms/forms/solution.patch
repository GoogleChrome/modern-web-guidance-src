+  <script>
+    const form = document.getElementById('rewardsForm');
+    const nextBtn = document.getElementById('nextBtn');
+    const prevBtn = document.getElementById('prevBtn');
+    const submitBtn = document.getElementById('submitBtn');
+    const errorSummary = document.getElementById('errorSummary');
+    const errorList = document.getElementById('errorList');
+    
+    let currentStep = 1;
+    
+    function updateStep(step) {
+      document.getElementById(`step${currentStep}Content`).style.display = 'none';
+      document.getElementById(`step${step}Content`).style.display = 'block';
+      
+      document.getElementById(`step${currentStep}`).classList.remove('active');
+      if (currentStep < step) {
+        document.getElementById(`step${currentStep}`).classList.add('done');
+      } else {
+        document.getElementById(`step${step}`).classList.remove('done');
+      }
+      document.getElementById(`step${step}`).classList.add('active');
+      
+      const trackerDesc = document.querySelector('.progress-container .visually-hidden');
+      const stepNames = { 1: 'Account Details', 2: 'Preferences', 3: 'Address and Payment' };
+      trackerDesc.textContent = `Step ${step} of 3: ${stepNames[step]}`;
+      
+      currentStep = step;
+      
+      if (currentStep === 1) {
+        prevBtn.style.display = 'none';
+        nextBtn.style.display = 'inline-block';
+        submitBtn.style.display = 'none';
+      } else if (currentStep === 2) {
+        prevBtn.style.display = 'inline-block';
+        nextBtn.style.display = 'inline-block';
+        submitBtn.style.display = 'none';
+      } else if (currentStep === 3) {
+        prevBtn.style.display = 'inline-block';
+        nextBtn.style.display = 'none';
+        submitBtn.style.display = 'inline-block';
+      }
+    }
+    
+    nextBtn.addEventListener('click', () => {
+      if (validateStep(currentStep)) {
+        updateStep(currentStep + 1);
+        errorSummary.style.display = 'none';
+      } else {
+        showErrorSummary(currentStep);
+      }
+    });
+    
+    prevBtn.addEventListener('click', () => {
+      updateStep(currentStep - 1);
+      errorSummary.style.display = 'none';
+    });
+    
+    const togglePassword = document.getElementById('togglePassword');
+    const passwordInput = document.getElementById('password');
+    
+    togglePassword.addEventListener('click', () => {
+      const isPassword = passwordInput.getAttribute('type') === 'password';
+      passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
+      togglePassword.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
+      
+      const eyeIcon = togglePassword.querySelector('.icon-eye');
+      const eyeOffIcon = togglePassword.querySelector('.icon-eye-off');
+      if (isPassword) {
+        eyeIcon.style.display = 'none';
+        eyeOffIcon.style.display = 'inline';
+      } else {
+        eyeIcon.style.display = 'inline';
+        eyeOffIcon.style.display = 'none';
+      }
+    });
+    
+    function validateStep(step) {
+      const content = document.getElementById(`step${step}Content`);
+      const inputs = content.querySelectorAll('input, select, textarea');
+      let isValid = true;
+      
+      inputs.forEach(input => {
+        if (!validateInput(input)) {
+          isValid = false;
+        }
+      });
+      
+      return isValid;
+    }
+    
+    function validateInput(input) {
+      const errorSpan = document.getElementById(`${input.id}Error`);
+      if (!errorSpan) return input.checkValidity();
+      
+      if (!input.checkValidity()) {
+        errorSpan.textContent = getCustomErrorMessage(input);
+        errorSpan.style.display = 'block';
+        input.setAttribute('aria-invalid', 'true');
+        if (input.id === 'password') {
+          input.setAttribute('aria-describedby', 'passwordError passwordHint');
+        } else {
+          input.setAttribute('aria-describedby', `${input.id}Error`);
+        }
+        return false;
+      } else {
+        errorSpan.textContent = '';
+        errorSpan.style.display = 'none';
+        input.removeAttribute('aria-invalid');
+        if (input.id === 'password') {
+          input.setAttribute('aria-describedby', 'passwordHint');
+        } else {
+          input.removeAttribute('aria-describedby');
+        }
+        return true;
+      }
+    }
+    
+    function getCustomErrorMessage(input) {
+      const validity = input.validity;
+      if (validity.valueMissing) {
+        return 'This field is required.';
+      }
+      if (validity.tooShort) {
+        return `Must be at least ${input.minLength} characters long.`;
+      }
+      if (validity.patternMismatch) {
+        if (input.id === 'zip') return 'Please enter a valid numeric ZIP code.';
+        if (input.id === 'ccNumber') return 'Please enter a valid credit card number.';
+        return 'Invalid format.';
+      }
+      if (validity.typeMismatch && input.type === 'email') {
+        return 'Please enter a valid email address.';
+      }
+      return input.validationMessage;
+    }
+    
+    function showErrorSummary(step) {
+      const content = document.getElementById(`step${step}Content`);
+      const inputs = content.querySelectorAll('input, select, textarea');
+      
+      errorList.innerHTML = '';
+      let count = 0;
+      
+      inputs.forEach(input => {
+        if (!input.checkValidity()) {
+          count++;
+          const labelEl = document.querySelector(`label[for="${input.id}"]`);
+          const labelText = labelEl ? labelEl.textContent.replace('*', '').trim() : input.id;
+          const li = document.createElement('li');
+          const a = document.createElement('a');
+          a.href = `#${input.id}`;
+          a.textContent = `${labelText}: ${getCustomErrorMessage(input)}`;
+          
+          a.addEventListener('click', (e) => {
+            e.preventDefault();
+            input.focus();
+          });
+          
+          li.appendChild(a);
+          errorList.appendChild(li);
+        }
+      });
+      
+      if (count > 0) {
+        errorSummary.style.display = 'block';
+        errorSummary.setAttribute('tabindex', '-1');
+        errorSummary.focus();
+      }
+    }
+    
+    form.addEventListener('blur', (e) => {
+      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
+        validateInput(e.target);
+      }
+    }, true);
+    
+    form.addEventListener('input', (e) => {
+      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') {
+        const errorSpan = document.getElementById(`${e.target.id}Error`);
+        if (e.target.checkValidity() && errorSpan) {
+          errorSpan.textContent = '';
+          errorSpan.style.display = 'none';
+          e.target.removeAttribute('aria-invalid');
+        }
+      }
+    });
+    
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      
+      if (validateStep(3)) {
+        submitBtn.disabled = true;
+        const originalText = submitBtn.textContent;
+        submitBtn.textContent = 'Processing...';
+        
+        setTimeout(() => {
+          alert('Registration Complete!');
+          submitBtn.disabled = false;
+          submitBtn.textContent = originalText;
+          updateStep(1);
+          form.reset();
+        }, 2000);
+      } else {
+        showErrorSummary(3);
+      }
+    });
+  </script>
 </body>
 
