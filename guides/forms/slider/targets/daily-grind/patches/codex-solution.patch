+  <script type="module">
+    const slider = document.getElementById('brew-strength');
+    const currentStrength = document.getElementById('brew-strength-value');
+    const strengthOptions = document.querySelectorAll('#brew-strength-options li');
+
+    if (slider instanceof HTMLInputElement && currentStrength instanceof HTMLOutputElement) {
+      const syncStrength = () => {
+        const value = slider.valueAsNumber;
+        const min = Number(slider.min);
+        const max = Number(slider.max);
+        const strength = strengthOptions[value - min]?.textContent;
+
+        if (strength) {
+          currentStrength.value = strength;
+          slider.setAttribute('aria-valuetext', strength);
+        }
+
+        slider.style.setProperty('--attr-min', String(min));
+        slider.style.setProperty('--attr-max', String(max));
+        slider.style.setProperty('--control-value', slider.value);
+        slider.style.setProperty('--slider-progress-fallback', `${(value - min) / (max - min) * 100}%`);
+      };
+
+      syncStrength();
+      slider.addEventListener('input', syncStrength);
+      window.addEventListener('pageshow', syncStrength);
+    }
+  </script>
+
