+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>The Daily Grind | Artisanal Coffee</title>
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    /* Navigation */
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    /* Hero Section */
+    .hero {
+      height: 60vh;
+      background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 0 20px;
+    }
+
+    .hero h1 {
+      font-size: 3rem;
+      margin-bottom: 1rem;
+    }
+
+    /* Content Sections */
+    .container {
+      max-width: 1100px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+      gap: 20px;
+      margin-top: 20px;
+    }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    .card h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    .brew-strength {
+      max-inline-size: 560px;
+      margin: 40px auto 0;
+      text-align: start;
+    }
+
+    .brew-strength label {
+      display: block;
+      font-size: 1.25rem;
+      font-weight: bold;
+    }
+
+    .brew-strength output {
+      display: block;
+      margin-block: 12px 4px;
+      font-weight: 600;
+      color: var(--primary);
+    }
+
+    .strength-scale {
+      display: flex;
+      justify-content: space-between;
+      font-size: 0.875rem;
+    }
+
+    .strength-slider {
+      --slider-track-size: 0.5rem;
+      --slider-thumb-size: 1.5rem;
+      --slider-track-radius: 999px;
+      --slider-thumb-radius: 50%;
+      --slider-track-color: var(--secondary);
+      --slider-fill-color: var(--primary);
+      --slider-thumb-color: var(--accent);
+      --slider-direction: to right;
+      --attr-min: 1;
+      --attr-max: 5;
+      --control-value: 3;
+      --slider-progress: calc((var(--control-value) - var(--attr-min)) / (var(--attr-max) - var(--attr-min)) * 100%);
+      -webkit-appearance: none;
+      appearance: none;
+      inline-size: 100%;
+      block-size: 2.75rem;
+      margin: 0;
+      padding: 0;
+      border: 0;
+      border-radius: 0;
+      background: transparent;
+      cursor: pointer;
+    }
+
+    .strength-slider:dir(rtl) {
+      --slider-direction: to left;
+    }
+
+    @supports (opacity: progress(1, 0, 100)) {
+      .strength-slider {
+        --slider-progress: calc(progress(var(--control-value), var(--attr-min), var(--attr-max)) * 100%);
+      }
+    }
+
+    .strength-slider::-webkit-slider-runnable-track {
+      block-size: var(--slider-track-size);
+      border: 0;
+      border-radius: var(--slider-track-radius);
+      background: linear-gradient(var(--slider-direction), var(--slider-fill-color) var(--slider-progress), var(--slider-track-color) var(--slider-progress));
+    }
+
+    .strength-slider::-webkit-slider-thumb {
+      -webkit-appearance: none;
+      appearance: none;
+      inline-size: var(--slider-thumb-size);
+      block-size: var(--slider-thumb-size);
+      margin-block-start: calc((var(--slider-track-size) - var(--slider-thumb-size)) / 2);
+      border: 2px solid var(--primary);
+      border-radius: var(--slider-thumb-radius);
+      background: var(--slider-thumb-color);
+    }
+
+    .strength-slider::-moz-range-track {
+      block-size: var(--slider-track-size);
+      border: 0;
+      border-radius: var(--slider-track-radius);
+      background: var(--slider-track-color);
+    }
+
+    .strength-slider::-moz-range-progress {
+      block-size: var(--slider-track-size);
+      border-radius: var(--slider-track-radius);
+      background: var(--slider-fill-color);
+    }
+
+    .strength-slider::-moz-range-thumb {
+      box-sizing: border-box;
+      inline-size: var(--slider-thumb-size);
+      block-size: var(--slider-thumb-size);
+      border: 2px solid var(--primary);
+      border-radius: var(--slider-thumb-radius);
+      background: var(--slider-thumb-color);
+    }
+
+    .strength-slider:focus-visible {
+      outline: 2px solid var(--slider-fill-color);
+      outline-offset: 4px;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      margin: 0 10px;
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.85rem;
+    }
+  </style>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero">
+    <h1>Wake Up Your Senses</h1>
+    <p>Ethically sourced, locally roasted, delivered to your cup.</p>
+    <a href="/order-online" class="btn">Order Now</a>
+  </header>
+
+  <main class="container">
+    <section>
+      <h2 style="text-align: center;">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+    <section class="card brew-strength" aria-labelledby="brew-strength-label">
+      <label id="brew-strength-label" for="brew-strength">Brew strength</label>
+      <p id="brew-strength-help">Find your preferred intensity, from light and mellow to rich and bold.</p>
+      <output id="brew-strength-value" for="brew-strength" aria-live="off">Balanced</output>
+      <input class="strength-slider" id="brew-strength" name="brew-strength" type="range"
+        min="1" max="5" step="1" value="3" aria-valuetext="Balanced"
+        aria-describedby="brew-strength-help">
+      <div class="strength-scale" aria-hidden="true"><span>Light</span><span>Extra bold</span></div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script>
+    const strengthSlider = document.getElementById('brew-strength');
+    const strengthOutput = document.getElementById('brew-strength-value');
+    const strengthLabels = ['Light', 'Mellow', 'Balanced', 'Bold', 'Extra bold'];
+
+    if (strengthSlider instanceof HTMLInputElement && strengthOutput instanceof HTMLOutputElement) {
+      function syncStrength() {
+        const label = strengthLabels[strengthSlider.valueAsNumber - 1];
+        strengthSlider.style.setProperty('--attr-min', strengthSlider.min);
+        strengthSlider.style.setProperty('--attr-max', strengthSlider.max);
+        strengthSlider.style.setProperty('--control-value', strengthSlider.value);
+        strengthSlider.setAttribute('aria-valuetext', label);
+        strengthOutput.value = label;
+      }
+
+      syncStrength();
+      strengthSlider.addEventListener('input', syncStrength);
+      strengthSlider.addEventListener('change', syncStrength);
+      window.addEventListener('pageshow', syncStrength);
+    }
+  </script>
+</body>
+
+</html>
