diff --git a/slider.js b/slider.js
new file mode 100644
index 0000000..54b6b75
--- /dev/null
+++ b/slider.js
@@ -0,0 +1,35 @@
+// @ts-check
+
+const slider = document.getElementById('coffee-strength');
+const output = document.getElementById('strength-value');
+const strengths = ['Mild', 'Smooth', 'Balanced', 'Bold', 'Extra bold'];
+
+if (slider instanceof HTMLInputElement && output instanceof HTMLOutputElement) {
+  function syncSliderValue() {
+    // Narrow again inside the callback so all DOM access remains type-safe.
+    if (!(slider instanceof HTMLInputElement) || !(output instanceof HTMLOutputElement)) return;
+
+    const min = slider.min === '' ? 0 : Number(slider.min);
+    const max = slider.max === '' ? 100 : Number(slider.max);
+    const value = slider.valueAsNumber;
+    const progress = max > min ? Math.min(1, Math.max(0, (value - min) / (max - min))) : 0;
+
+    // A numeric JS fallback works without typed attr(), progress(), or CSS division.
+    slider.style.setProperty('--attr-min', String(min));
+    slider.style.setProperty('--attr-max', String(max));
+    slider.style.setProperty('--control-value', slider.value);
+    slider.style.setProperty('--slider-progress', `${progress * 100}%`);
+
+    const strength = strengths[value - 1] ?? 'Custom';
+    output.value = `${strength} · ${value} of ${max}`;
+    slider.setAttribute('aria-valuetext', `${strength} strength, ${value} of ${max}`);
+  }
+
+  syncSliderValue();
+  slider.addEventListener('input', syncSliderValue);
+  // Keep styling current if the control's bounds or default value are updated.
+  new MutationObserver(syncSliderValue).observe(slider, {
+    attributes: true,
+    attributeFilter: ['min', 'max', 'value', 'step'],
+  });
+}
