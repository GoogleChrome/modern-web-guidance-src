+  <script>
+    const slider = document.querySelector('#range-slider');
+    const output = document.querySelector('#strength-output');
+    const labels = ['Mild', 'Light', 'Medium', 'Strong', 'Extra bold'];
+
+    function syncSliderValue() {
+      if (!slider) return;
+      const min = slider.min === '' ? 0 : Number(slider.min);
+      const max = slider.max === '' ? 100 : Number(slider.max);
+      const val = Number(slider.value);
+
+      slider.style.setProperty('--attr-min', String(slider.min || 0));
+      slider.style.setProperty('--attr-max', String(slider.max || 100));
+      slider.style.setProperty('--control-value', String(slider.value));
+
+      const progress = max > min ? ((val - min) / (max - min)) * 100 : 0;
+      slider.style.setProperty('--slider-progress', `${progress}%`);
+
+      const labelIndex = Math.min(Math.max(val - min, 0), labels.length - 1);
+      const labelText = labels[labelIndex] || 'Custom';
+      const text = `${labelText} (${val} of ${max})`;
+      slider.setAttribute('aria-valuetext', text);
+      if (output) {
+        output.textContent = text;
+        output.value = text;
+      }
+    }
+
+    syncSliderValue();
+    slider.addEventListener('input', syncSliderValue);
+    slider.addEventListener('change', syncSliderValue);
+
+    new MutationObserver(syncSliderValue).observe(slider, {
+      attributes: true,
+      attributeFilter: ['min', 'max', 'value', 'step'],
+    });
+  </script>
 </body>
 
