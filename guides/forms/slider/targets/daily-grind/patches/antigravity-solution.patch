+  <script>
+    const slider = document.querySelector('#brew-strength');
+    const sliderValueOutput = document.querySelector('#brew-strength-value');
+
+    const strengthLabels = {
+      1: 'Mild',
+      2: 'Light-Medium',
+      3: 'Medium',
+      4: 'Bold',
+      5: 'Extra Bold'
+    };
+
+    function syncSliderValue() {
+      const val = Number(slider.value);
+      const min = slider.min || 1;
+      const max = slider.max || 5;
+      const label = strengthLabels[val] || `Level ${val}`;
+
+      slider.style.setProperty('--attr-min', min);
+      slider.style.setProperty('--attr-max', max);
+      slider.style.setProperty('--control-value', slider.value);
+      slider.setAttribute('aria-valuetext', `${label} (Level ${val} of ${max})`);
+
+      if (sliderValueOutput) {
+        sliderValueOutput.textContent = label;
+      }
+    }
+
+    syncSliderValue();
+    slider.addEventListener('input', syncSliderValue);
+  </script>
+
