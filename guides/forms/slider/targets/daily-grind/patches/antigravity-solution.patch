+  <script>
+    (() => {
+      const BREW_STRENGTHS = [
+        { label: 'Mild', note: 'Light, bright, and mellow with gentle acidity.' },
+        { label: 'Medium', note: 'Balanced body and smooth, caramel-like sweetness.' },
+        { label: 'Bold', note: 'Deep, rich flavor with a full-bodied finish.' },
+        { label: 'Extra Bold', note: 'Intense, smoky, and dark-roasted for maximum kick.' }
+      ];
+
+      const slider = document.querySelector('#brew-strength');
+      const valueOutput = document.querySelector('#brew-strength-value');
+      const noteOutput = document.querySelector('#brew-strength-note');
+      const stopLabels = document.querySelectorAll('.brew-strength-stops span');
+
+      function syncBrewStrength() {
+        if (!slider) return;
+        const min = slider.min === '' ? 0 : Number(slider.min);
+        const max = slider.max === '' ? 100 : Number(slider.max);
+        const index = Math.min(
+          BREW_STRENGTHS.length - 1,
+          Math.max(0, Number(slider.value) || 0)
+        );
+        const strength = BREW_STRENGTHS[index];
+
+        slider.style.setProperty('--attr-min', String(min));
+        slider.style.setProperty('--attr-max', String(max));
+        slider.style.setProperty('--control-value', slider.value);
+        slider.setAttribute('aria-valuetext', strength.label);
+
+        if (valueOutput) {
+          valueOutput.textContent = strength.label;
+        }
+        if (noteOutput) {
+          noteOutput.textContent = strength.note;
+        }
+        stopLabels.forEach((stop, i) => {
+          stop.classList.toggle('is-active', i === index);
+        });
+      }
+
+      if (slider) {
+        syncBrewStrength();
+        slider.addEventListener('input', syncBrewStrength);
+        slider.addEventListener('change', syncBrewStrength);
+      }
+    })();
+  </script>
+
