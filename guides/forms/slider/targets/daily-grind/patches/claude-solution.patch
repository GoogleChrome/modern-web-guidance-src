+  <script>
+    (function () {
+      const slider = document.querySelector('#brew-strength-slider');
+      const output = document.querySelector('#brew-strength-value');
+      if (!slider || !output) return;
+
+      const labels = {
+        1: 'Mild',
+        2: 'Smooth',
+        3: 'Balanced',
+        4: 'Bold',
+        5: 'Extra Bold'
+      };
+
+      function syncSliderValue() {
+        const value = slider.value;
+        const max = slider.max || 100;
+        const label = labels[value] || '';
+
+        // Fallback for browsers without typed attr(); also drives the WebKit fill.
+        slider.style.setProperty('--attr-min', slider.min || 0);
+        slider.style.setProperty('--attr-max', max);
+        slider.style.setProperty('--control-value', value);
+
+        output.textContent = value + ' of ' + max + (label ? ' – ' + label : '');
+        slider.setAttribute('aria-valuetext', value + ' of ' + max + (label ? ', ' + label : ''));
+      }
+
+      syncSliderValue();
+      slider.addEventListener('input', syncSliderValue);
+    })();
+  </script>
