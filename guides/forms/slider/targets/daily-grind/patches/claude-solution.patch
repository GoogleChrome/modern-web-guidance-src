+  <script>
+    (function () {
+      const STRENGTHS = ['Mild', 'Medium', 'Bold', 'Extra Bold'];
+      const slider = document.getElementById('brew-strength');
+      const output = document.getElementById('brew-strength-value');
+      if (!slider || !output) return;
+
+      function syncSliderValue() {
+        // Fallback for browsers without typed attr() support.
+        slider.style.setProperty('--attr-min', slider.min || 0);
+        slider.style.setProperty('--attr-max', slider.max || 100);
+        slider.style.setProperty('--control-value', slider.value);
+
+        const label = STRENGTHS[Number(slider.value)] ?? slider.value;
+        output.textContent = label;
+        slider.setAttribute('aria-valuetext', label);
+      }
+
+      syncSliderValue();
+      slider.addEventListener('input', syncSliderValue);
+    })();
+  </script>
