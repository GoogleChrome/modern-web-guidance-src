+    /* Brew Strength Slider */
+    .strength-section {
+      margin-top: 40px;
+    }
+
+    .strength-card {
+      max-width: 560px;
+      margin: 20px auto 0;
+      text-align: start;
+    }
+
+    .strength-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      gap: 1rem;
+      margin-bottom: 0.5rem;
+    }
+
+    .strength-header label {
+      font-weight: bold;
+      color: var(--primary);
+    }
+
+    .strength-value {
+      font-weight: bold;
+      color: var(--accent);
+    }
+
+    .strength-slider {
+      --slider-track-size: 0.5rem;
+      --slider-thumb-size: 1.5rem;
+      --slider-track-radius: 999px;
+      --slider-thumb-radius: 50%;
+      /* #795548 on white ≈ 7:1 contrast */
+      --slider-track-color: var(--border);
+      /* #b45309 on white ≈ 5:1 contrast */
+      --slider-fill-color: var(--accent);
+      --slider-thumb-color: var(--primary);
+      --slider-direction: to right;
+
+      &:dir(rtl) {
+        --slider-direction: to left;
+      }
+
+      /* Read min and max from attributes; --control-value is synced by script. */
+      --attr-min: attr(min type(<number>), 0);
+      --attr-max: attr(max type(<number>), 100);
+      --control-value: attr(value type(<number>), 50);
+      --slider-progress: calc(
+        progress(var(--control-value), var(--attr-min), var(--attr-max)) * 100%
+      );
+
+      appearance: none;
+      inline-size: 100%;
+      block-size: 2.5rem;
+      margin: 0;
+      padding: 0;
+      border: 0;
+      border-radius: 0;
+      background: transparent;
+      cursor: pointer;
+    }
+
+    @supports not (opacity: progress(1, 0, 100)) {
+      .strength-slider {
+        --slider-progress: calc(
+          (var(--control-value) - var(--attr-min)) /
+          (var(--attr-max) - var(--attr-min)) * 100%
+        );
+      }
+    }
+
+    /* WebKit/Blink */
+    .strength-slider::-webkit-slider-runnable-track {
+      block-size: var(--slider-track-size);
+      border: 0;
+      border-radius: var(--slider-track-radius);
+      background: linear-gradient(
+        var(--slider-direction),
+        var(--slider-fill-color) var(--slider-progress),
+        var(--slider-track-color) var(--slider-progress)
+      );
+    }
+
+    .strength-slider::-webkit-slider-thumb {
+      -webkit-appearance: none;
+      appearance: none;
+      inline-size: var(--slider-thumb-size);
+      block-size: var(--slider-thumb-size);
+      margin-block-start: calc(
+        (var(--slider-track-size) - var(--slider-thumb-size)) / 2
+      );
+      border: 3px solid white;
+      border-radius: var(--slider-thumb-radius);
+      background: var(--slider-thumb-color);
+      box-shadow: 0 0 0 1px var(--slider-thumb-color), 0 1px 3px rgba(0, 0, 0, 0.3);
+    }
+
+    /* Firefox */
+    .strength-slider::-moz-range-track {
+      block-size: var(--slider-track-size);
+      border: 0;
+      border-radius: var(--slider-track-radius);
+      background: var(--slider-track-color);
+    }
+
+    .strength-slider::-moz-range-progress {
+      block-size: var(--slider-track-size);
+      border-radius: var(--slider-track-radius);
+      background: var(--slider-fill-color);
+    }
+
+    .strength-slider::-moz-range-thumb {
+      box-sizing: border-box;
+      inline-size: var(--slider-thumb-size);
+      block-size: var(--slider-thumb-size);
+      border: 3px solid white;
+      border-radius: var(--slider-thumb-radius);
+      background: var(--slider-thumb-color);
+      box-shadow: 0 0 0 1px var(--slider-thumb-color), 0 1px 3px rgba(0, 0, 0, 0.3);
+    }
+
+    .strength-slider:focus-visible {
+      /* #4e342e on white ≈ 12:1 contrast; offset keeps it separate from the track */
+      outline: 2px solid var(--primary);
+      outline-offset: 4px;
+    }
+
+    .strength-ticks {
+      display: flex;
+      justify-content: space-between;
+      list-style: none;
+      font-size: 0.85rem;
+      color: var(--text);
+      margin-top: 0.25rem;
+    }
+
