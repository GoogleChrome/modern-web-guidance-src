+    /* Responsive table */
+    .table-section {
+      margin-top: 60px;
+    }
+
+    .table-wrapper {
+      overflow: auto;
+      max-inline-size: 100%;
+      max-block-size: min(500px, 80vh);
+      container-type: inline-size;
+      background: white;
+      margin-top: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-wrapper table {
+      border-collapse: separate;
+      border-spacing: 0;
+      inline-size: 100%;
+      min-inline-size: 700px;
+    }
+
+    .table-wrapper th,
+    .table-wrapper td {
+      padding: 10px 16px;
+      text-align: start;
+      border-block-end: 1px solid var(--secondary);
+      white-space: nowrap;
+    }
+
+    .table-wrapper thead {
+      position: sticky;
+      inset-block-start: 0;
+      z-index: 1;
+    }
+
+    .table-wrapper thead th {
+      background: var(--primary);
+      color: white;
+    }
+
+    .table-wrapper tbody th {
+      position: sticky;
+      inset-inline-start: 0;
+      background: white;
+    }
+
+    .table-wrapper table {
+      --label-1: "Drink";
+      --label-2: "Size";
+      --label-3: "Calories";
+      --label-4: "Caffeine";
+      --label-5: "Price";
+    }
+
+    @container (width < 600px) {
+      .table-wrapper table {
+        min-inline-size: 0;
+      }
+
+      .table-wrapper table,
+      .table-wrapper thead,
+      .table-wrapper tbody,
+      .table-wrapper tr,
+      .table-wrapper th,
+      .table-wrapper td {
+        display: block;
+      }
+
+      .table-wrapper thead {
+        display: none;
+      }
+
+      .table-wrapper tr {
+        margin-block-end: 1.5rem;
+        border: 1px solid #ccc;
+      }
+
+      .table-wrapper tbody th {
+        position: sticky;
+        inset-block-start: 0;
+        inset-inline-start: auto;
+        z-index: 2;
+        background: #eee;
+      }
+
+      .table-wrapper td {
+        white-space: normal;
+      }
+
+      .table-wrapper td:nth-child(2)::before {
+        content: var(--label-2) ": " / var(--label-2);
+        font-weight: bold;
+      }
+
+      .table-wrapper td:nth-child(3)::before {
+        content: var(--label-3) ": " / var(--label-3);
+        font-weight: bold;
+      }
+
+      .table-wrapper td:nth-child(4)::before {
+        content: var(--label-4) ": " / var(--label-4);
+        font-weight: bold;
+      }
+
+      .table-wrapper td:nth-child(5)::before {
+        content: var(--label-5) ": " / var(--label-5);
+        font-weight: bold;
+      }
+    }
+
