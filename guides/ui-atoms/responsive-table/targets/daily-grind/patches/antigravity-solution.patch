+      text-align: left;
+      background: white;
+    }
+
+    th,
+    td {
+      padding: 0.75rem 1rem;
+      border-block-end: 1px solid var(--secondary);
+    }
+
+    /* Sticky column headers (desktop) */
+    thead {
+      position: sticky;
+      inset-block-start: 0;
+      z-index: 1;
+      background: var(--primary);
+      color: white;
+    }
+
+    thead th {
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+    }
+
+    /* Sticky row headers (desktop) */
+    tbody th {
+      position: sticky;
+      inset-inline-start: 0;
+      background: white;
+      color: var(--primary);
+      font-weight: 600;
+    }
+
+    @container (width < 600px) {
+      table,
+      thead,
+      tbody,
+      tr,
+      th,
+      td {
+        display: block;
+      }
+
+      thead {
+        /* MANDATORY: Hide column header from layout and screen readers. */
+        display: none;
+      }
+
+      tr {
+        margin-block-end: 1.5rem;
+        border: 1px solid #ccc;
+      }
+
+      /* Sticky row headers at the top of each block/card */
+      tbody th {
+        position: sticky;
+        inset-block-start: 0;
+        z-index: 2;
+        background: #eee;
+        color: var(--primary);
+      }
+
+      /* Define column labels as CSS variables */
+      table {
