+    /* Nutritional and Pricing Breakdown Table */
+    .table-wrapper {
+      overflow: auto;
+      max-inline-size: 100%;
+      max-block-size: min(500px, 80vh);
+      container-type: inline-size;
+      margin-block-start: 2rem;
