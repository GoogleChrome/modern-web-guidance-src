+
+      @container style(--truncated: 1) {
+        nav a:is(:hover, :focus-visible) > span {
+          /* Needs its own box to be moved. It stays inline otherwise, so the ellipsis renders. */
+          display: inline-block;
+          /* Forward by the link's width, then back by the text's own width */
+          margin-inline-start: 100%;
+          /* 1px short, so the text still overflows and the timeline stays active */
+          translate: calc(1px - 100%);
+          /* Set only here: when the pointer leaves, the text snaps back behind the ellipsis */
+          transition: margin-inline-start 1.5s ease-in, translate 1.5s ease-in;
+        }
+
