+  <script>
+    // Flags truncated navigation links with a class. This drives the reveal in browsers
+    // without container style queries (which cannot be feature-detected) and stands in
+    // for the scroll-driven animation where that is unsupported.
+    (() => {
+      const observer = new ResizeObserver(entries => {
+        for (const { target } of entries) {
+          target.classList.toggle('truncated', target.scrollWidth > target.clientWidth);
+        }
+      });
+
+      for (const link of document.querySelectorAll('nav a')) {
+        observer.observe(link);
+      }
+    })();
+  </script>
