+const app = document.querySelector<HTMLElement>('.app')!;
+const canvas = document.querySelector<HTMLCanvasElement>('#render-canvas')!;
+const context = canvas.getContext('2d')!;
+const randomize = document.querySelector<HTMLButtonElement>('#randomize')!;
+const download = document.querySelector<HTMLButtonElement>('#download')!;
+const quality = document.querySelector<HTMLSelectElement>('#quality')!;
+const inputs = [document.querySelector<HTMLInputElement>('#color-one')!, document.querySelector<HTMLInputElement>('#color-two')!];
+const status = document.querySelector<HTMLElement>('#render-status')!;
+let worker: Worker | undefined;
+let generation = 0;
+let hasFrame = false;
+const rgb = (hex: string) => [1, 3, 5].map(offset => parseInt(hex.slice(offset, offset + 2), 16));
+function updateSwatches() {
+  inputs.forEach(input => {
+    const [r, g, b] = rgb(input.value);
+    input.parentElement!.style.backgroundColor = `rgb(${r * .75}, ${g * .75}, ${b * .75})`;
+  });
+}
+function render() {
+  worker?.terminate();
+  hasFrame = false;
+  download.disabled = true;
+  status.lastChild!.textContent = ' Tracing light…';
+  document.querySelector<HTMLElement>('#progress')!.style.width = '0%';
+  document.querySelector('#sample-count')!.textContent = '0';
+  document.querySelector('#elapsed')!.textContent = '0.0s';
+  const samples = Number(quality.value);
+  const width = canvas.width, height = canvas.height;
+  try {
+    worker = new Worker(`${app.dataset.base}wasm/render-worker.js`, { type: 'module' });
+    worker.onerror = fail;
+    worker.onmessage = ({ data }) => {
+      if (data.error) { fail(); return; }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, height), 0, 0);
+      hasFrame = true;
+      download.disabled = false;
+      document.querySelector('#sample-count')!.textContent = String(data.samples);
+      document.querySelector('#elapsed')!.textContent = `${(data.elapsed / 1000).toFixed(1)}s`;
+      document.querySelector<HTMLElement>('#progress')!.style.width = `${data.samples / samples * 100}%`;
+      if (data.done) status.lastChild!.textContent = ' Render complete';
+    };
+    worker.postMessage({ width, height, samples, seed: crypto.getRandomValues(new Uint32Array(1))[0], colors: inputs.map(input => rgb(input.value)) });
+  } catch { fail(); }
+}
+function fail() {
+  status.lastChild!.textContent = ' Render failed. Try again.';
+  worker?.terminate();
+}
+randomize.addEventListener('click', () => {
+  inputs.forEach(input => {
+    // A bright dominant channel keeps tinted mirror and glass materials visible.
+    const color = Array.from(crypto.getRandomValues(new Uint8Array(3))).map(v => 65 + Math.round(v / 255 * 190));
+    color[color.indexOf(Math.max(...color))] = 255;
+    input.value = `#${color.map(v => v.toString(16).padStart(2, '0')).join('')}`;
+  });
+  document.querySelector('#palette-number')!.textContent = `PALETTE ${String(++generation).padStart(2, '0')}`;
+  updateSwatches();
+  render();
+});
+inputs.forEach(input => input.addEventListener('change', () => {
+  document.querySelector('#palette-number')!.textContent = 'CUSTOM';
+  updateSwatches();
+  render();
+}));
+quality.addEventListener('change', render);
+document.querySelector<HTMLInputElement>('#resolution')!.addEventListener('change', event => {
+  const width = [320, 640, 960][Number((event.target as HTMLInputElement).value)];
+  canvas.width = width;
+  canvas.height = width * 3 / 4;
+  const label = `${width} × ${canvas.height}`;
+  document.querySelector('#resolution-value')!.textContent = label;
+  document.querySelector('#canvas-resolution')!.textContent = label;
+  render();
+});
+download.addEventListener('click', () => {
+  if (!hasFrame) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const anchor = document.createElement('a');
+    anchor.href = url;
+    anchor.download = `smallpt-${generation}-${Date.now()}.png`;
+    anchor.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+window.addEventListener('pagehide', () => worker?.terminate());
+updateSwatches();
+render();
