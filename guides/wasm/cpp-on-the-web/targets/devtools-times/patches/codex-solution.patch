+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p public/wasm
+em++ native/smallpt.cpp -O3 -flto -nostdlib++ -fno-exceptions -fno-rtti --no-entry \
+  -sEXPORT_ES6 -sENVIRONMENT=worker \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8 -sSTACK_SIZE=1048576 -sSTRICT -sALLOW_MEMORY_GROWTH -sFILESYSTEM=0 \
+  -sEXPORTED_FUNCTIONS=_setup,_buffer,_render_rows \
+  -o public/wasm/smallpt.js
