@@ -0,0 +1,37 @@
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+// Return an owned RGBA buffer. The worker copies it before calling free().
+uint8_t *render_image(int width, int height, uint32_t seed) {
+  if (width < 1 || height < 1 || width > 1920 || height > 1080) return NULL;
+  uint8_t *pixels = malloc((size_t)width * height * 4);
+  if (!pixels) return NULL;
+  double angle = (seed % 10000) * 0.0006283185307;
+  double cr = -0.745 + 0.065 * cos(angle);
+  double ci = 0.185 + 0.085 * sin(angle);
+  double phase = (seed % 360) / 360.0;
+
+  for (int y = 0; y < height; y++) {
+    for (int x = 0; x < width; x++) {
+      double zr = 3.2 * (x - width / 2.0) / width;
+      double zi = 3.2 * (y - height / 2.0) / width;
+      int iteration = 0;
+      while (zr * zr + zi * zi < 256.0 && iteration < 600) {
+        double next = zr * zr - zi * zi + cr;
+        zi = 2.0 * zr * zi + ci;
+        zr = next;
+        iteration++;
+      }
+      size_t offset = ((size_t)y * width + x) * 4;
+      double smooth = iteration;
+      if (iteration < 600) smooth -= log2(log2(zr * zr + zi * zi)) - 1.0;
+      for (int channel = 0; channel < 3; channel++) {
+        double color = 0.5 + 0.5 * cos(6.283185307 * (smooth * 0.018 + phase + channel / 3.0));
+        pixels[offset + channel] = iteration == 600 ? (uint8_t)(8 + channel * 6) : (uint8_t)(255 * color);
+      }
+      pixels[offset + 3] = 255;
+    }
+  }
+  return pixels;
+}
