+// Build the initial canvas poster from the same C++ renderer; no browser or server needed.
+import { execFileSync } from 'node:child_process';
+import { readFileSync, unlinkSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import sharp from 'sharp';
+const executable = join(tmpdir(), 'smallpt-preview');
+if (!process.argv.includes('--from-ppm')) {
+  execFileSync('g++', ['-O3', '-DSMALLPT_PREVIEW', 'native/smallpt.cpp', '-o', executable]);
+  execFileSync(executable);
+}
+const ppm = readFileSync('public/preview.ppm');
+const header = Buffer.from('P6\n640 480\n255\n');
+await sharp(ppm.subarray(header.length), { raw: { width: 640, height: 480, channels: 3 } }).png().toFile('public/preview.png');
+unlinkSync('public/preview.ppm');
