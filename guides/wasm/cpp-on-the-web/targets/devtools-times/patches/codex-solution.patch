new file mode 100644
index 0000000..df9600f
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,19 @@
+import createSmallpt from './smallpt.js';
+const modulePromise = createSmallpt();
+self.onmessage = async ({ data }) => {
+  try {
+    const engine = await modulePromise;
+    const { width, height, samples, seed, colors } = data;
+    engine._setup(width, height, seed, ...colors.flat().map(v => v / 255 * .75));
+    const start = performance.now();
+    for (let sample = 0; sample < samples; sample += 4) {
+      for (let row = 0; row < height; row += 16) {
+        engine._render_rows(row, Math.min(row + 16, height));
+      }
+      const pixels = engine.HEAPU8.slice(engine._buffer(), engine._buffer() + width * height * 4);
+      self.postMessage({ pixels, samples: sample + 4, elapsed: performance.now() - start, done: sample + 4 >= samples }, [pixels.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error instanceof Error ? error.message : String(error) });
+  }
+};
