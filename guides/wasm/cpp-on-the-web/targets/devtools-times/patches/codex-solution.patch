diff --git a/src/workers/image-renderer.worker.ts b/src/workers/image-renderer.worker.ts
new file mode 100644
index 0000000..12ca4a9
--- /dev/null
+++ b/src/workers/image-renderer.worker.ts
@@ -0,0 +1,50 @@
+import type { RenderRequest, RenderResponse } from './image-protocol';
+
+interface RendererModule {
+  HEAPU8: Uint8Array;
+  _render_image(width: number, height: number, seed: number): number;
+  _free(pointer: number): void;
+}
+
+type RendererFactory = (options: { locateFile: (path: string) => string }) => Promise<RendererModule>;
+let modulePromise: Promise<RendererModule> | undefined;
+
+function loadRenderer() {
+  if (!modulePromise) {
+    const assetRoot = new URL(`${import.meta.env.BASE_URL}wasm/`, self.location.origin);
+    const moduleUrl = new URL('image-renderer.js', assetRoot).href;
+    modulePromise = import(/* @vite-ignore */ moduleUrl).then(
+      (module: { default: RendererFactory }) => module.default({
+        locateFile: (path) => new URL(path, assetRoot).href,
+      }),
+    );
+  }
+  return modulePromise;
+}
+
+function reply(message: RenderResponse, transfer: Transferable[] = []) {
+  self.postMessage(message, { transfer });
+}
+
+self.onmessage = async (event: MessageEvent<RenderRequest>) => {
+  try {
+    const { width, height, seed } = event.data;
+    if (!Number.isInteger(width) || !Number.isInteger(height) || width < 1 || height < 1 || width > 1920 || height > 1080 || !Number.isInteger(seed)) {
+      throw new Error('Invalid image dimensions or seed.');
+    }
+    const renderer = await loadRenderer();
+    const start = performance.now();
+    const pointer = renderer._render_image(width, height, seed);
+    if (!pointer) throw new Error('Unable to allocate image memory.');
+    try {
+      // Read the current heap after rendering: memory growth can replace its buffer.
+      const pixels = renderer.HEAPU8.slice(pointer, pointer + width * height * 4).buffer;
+      reply({ type: 'rendered', width, height, pixels, elapsed: performance.now() - start }, [pixels]);
+    } finally {
+      renderer._free(pointer);
+    }
+  } catch (error) {
+    modulePromise = undefined;
+    reply({ type: 'error', message: error instanceof Error ? error.message : 'Image generation failed.' });
+  }
+};
