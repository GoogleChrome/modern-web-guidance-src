--- /dev/null
+++ b/scripts/build-wasm.mjs
@@ -0,0 +1,20 @@
+import { mkdirSync } from 'node:fs';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+mkdirSync(new URL('../public/wasm/', import.meta.url), { recursive: true });
+const result = spawnSync('emcc', [
+  'native/image-renderer.c', '-o', 'public/wasm/image-renderer.js',
+  '-Oz', '-flto', '-g0', '--no-entry',
+  '-sEXPORT_ES6=1', '-sMODULARIZE=1', '-sENVIRONMENT=web,worker',
+  '-sSTRICT=1', '-sALLOW_MEMORY_GROWTH=1',
+  '-sINCOMING_MODULE_JS_API=["locateFile"]',
+  `-sASSERTIONS=${process.argv.includes('--assertions') ? '1' : '0'}`,
+  '-sEXPORTED_FUNCTIONS=["_render_image","_free"]',
+  '-sEXPORTED_RUNTIME_METHODS=["HEAPU8"]',
+], { cwd: root, stdio: 'inherit' });
+if (result.error) {
+  console.error('Install Emscripten and put emcc on PATH to rebuild the WebAssembly assets.', result.error.message);
+}
+process.exit(result.status ?? 1);
diff --git a/src/components/ImageGenerator.tsx b/src/components/ImageGenerator.tsx
new file mode 100644
index 0000000..20c61f4
--- /dev/null
+++ b/src/components/ImageGenerator.tsx
@@ -0,0 +1,91 @@
+import { useEffect, useRef, useState } from 'react';
+import type { RenderRequest, RenderResponse } from '../workers/image-protocol';
+
+export default function ImageGenerator() {
+  const canvas = useRef<HTMLCanvasElement>(null);
+  const worker = useRef<Worker | null>(null);
+  const timeout = useRef<ReturnType<typeof setTimeout> | undefined>(undefined);
+  const [busy, setBusy] = useState(true);
+  const [status, setStatus] = useState('Preparing your first image…');
+  const [failed, setFailed] = useState(false);
+
+  function stopTimer() {
+    clearTimeout(timeout.current);
+  }
+
+  function fail(message: string) {
+    stopTimer();
+    worker.current?.terminate();
+    worker.current = null;
+    setBusy(false);
+    setFailed(true);
+    setStatus(message);
+  }
+
+  function render() {
+    setBusy(true);
+    setFailed(false);
+    setStatus('Rendering a new image… You can keep exploring the page.');
+    try {
+      if (!worker.current) {
+        worker.current = new Worker(new URL('../workers/image-renderer.worker.ts', import.meta.url), { type: 'module' });
+        worker.current.onmessage = (event: MessageEvent<RenderResponse>) => {
+          stopTimer();
+          const result = event.data;
+          if (result.type === 'error') {
+            fail(`Could not render the image. ${result.message}`);
+            return;
+          }
+          try {
+            const context = canvas.current?.getContext('2d');
+            if (!context) throw new Error('Canvas is unavailable in this browser.');
+            context.putImageData(new ImageData(new Uint8ClampedArray(result.pixels), result.width, result.height), 0, 0);
+            setStatus(`Image rendered in ${(result.elapsed / 1000).toFixed(2)} seconds. Create another to explore a new pattern.`);
+            setBusy(false);
+          } catch (error) {
+            fail(error instanceof Error ? error.message : 'Could not display the image.');
+          }
+        };
+        worker.current.onerror = (event) => {
+          event.preventDefault();
+          fail('The image renderer could not start. Please try again.');
+        };
+        worker.current.onmessageerror = () => fail('The rendered image could not be received. Please try again.');
+      }
+      const request: RenderRequest = { width: 960, height: 540, seed: crypto.getRandomValues(new Uint32Array(1))[0]! };
+      worker.current.postMessage(request);
+      timeout.current = setTimeout(() => fail('Rendering took too long. Please try again.'), 30000);
+    } catch {
+      fail('Image generation is unavailable. Please try again in a browser with WebAssembly support.');
+    }
+  }
+
+  useEffect(() => {
+    render();
+    return () => {
+      stopTimer();
+      worker.current?.terminate();
+      worker.current = null;
+    };
+  }, []);
+
+  return (
+    <section aria-labelledby="image-generator-title" className="border-b border-gray-300 py-6 mb-6">
+      <p className="text-xs font-bold uppercase tracking-widest text-gray-500">The interactive edition</p>
+      <h2 id="image-generator-title" className="text-3xl font-brand mt-2">A world of infinite patterns</h2>
+      <p className="text-gray-600 mt-2 mb-4">Explore the beauty of Julia fractals. Each image reveals a new landscape of color and detail.</p>
+      <figure aria-busy={busy}>
+        <canvas ref={canvas} width={960} height={540} role="img" aria-label="A generated Julia fractal with flowing, colorful mathematical patterns" className="block w-full h-auto rounded bg-slate-950" />
+        <figcaption role="status" aria-live="polite" className={`text-sm mt-3 min-h-10 ${failed ? 'text-red-700' : 'text-gray-600'}`}>{status}</figcaption>
+      </figure>
+      <button type="button" onClick={render} disabled={busy} className="rounded bg-gray-900 px-5 py-3 text-white font-semibold hover:bg-amber-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-600 disabled:opacity-60 disabled:cursor-wait">
+        {busy ? 'Rendering…' : failed ? 'Try rendering again' : 'Render a new image'}
+      </button>
+      <details className="mt-4 text-sm text-gray-600">
+        <summary className="cursor-pointer hover:text-amber-700 focus-visible:outline-2">About these patterns</summary>
+        <p className="mt-2">Julia fractals come from repeating a simple mathematical rule. Small changes to its starting parameters produce entirely different shapes. Open this note or browse the news while your next image takes shape.</p>
+      </details>
+      <noscript>Enable JavaScript to generate interactive fractal images.</noscript>
+    </section>
+  );
+}
