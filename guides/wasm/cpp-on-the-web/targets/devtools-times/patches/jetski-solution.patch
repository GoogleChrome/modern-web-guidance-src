@@ -0,0 +1,396 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SmallptPathTracerProps {
+  baseUrl?: string;
+}
+
+const SPHERE_LABELS = [
+  'Left Wall',
+  'Right Wall',
+  'Back Wall',
+  'Front Wall',
+  'Floor',
+  'Ceiling',
+  'Mirror Sphere',
+  'Glass Sphere',
+];
+
+const DEFAULT_COLORS: number[][] = [
+  [0.75, 0.25, 0.25],
+  [0.25, 0.25, 0.75],
+  [0.75, 0.75, 0.75],
+  [0.0, 0.0, 0.0],
+  [0.75, 0.75, 0.75],
+  [0.75, 0.75, 0.75],
+  [0.999, 0.999, 0.999],
+  [0.999, 0.999, 0.999],
+];
+
+async function yieldToMain() {
+  const g = globalThis as any;
+  if ('scheduler' in g && 'yield' in g.scheduler) {
+    return await g.scheduler.yield();
+  }
+  return new Promise((resolve) => setTimeout(resolve, 0));
+}
+
+function toCssColor(rgb: number[]) {
+  const toGamma = (c: number) => Math.round(Math.pow(Math.max(0, Math.min(1, c)), 1 / 2.2) * 255);
+  return `rgb(${toGamma(rgb[0])}, ${toGamma(rgb[1])}, ${toGamma(rgb[2])})`;
+}
+
+export default function SmallptPathTracer({ baseUrl = '/devtools-times/' }: SmallptPathTracerProps) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const jobIdRef = useRef<number>(0);
+  const wasmMainThreadModRef = useRef<any>(null);
+
+  const [isRendering, setIsRendering] = useState<boolean>(true);
+  const [progress, setProgress] = useState<number>(0);
+  const [elapsedMs, setElapsedMs] = useState<number>(0);
+  const [sampsPerSubpixel, setSampsPerSubpixel] = useState<number>(2); // 2 * 4 = 8 spp
+  const [resolution, setResolution] = useState<{ w: number; h: number }>({ w: 320, h: 240 });
+  const [sphereColors, setSphereColors] = useState<number[][]>(DEFAULT_COLORS);
+  const [renderCount, setRenderCount] = useState<number>(0);
+  const [statusMessage, setStatusMessage] = useState<string>('Initializing WebAssembly path tracer...');
+
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const paintPixels = useCallback((buffer: ArrayBuffer | Uint8ClampedArray, w: number, h: number) => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    if (canvas.width !== w) canvas.width = w;
+    if (canvas.height !== h) canvas.height = h;
+    const ctx = canvas.getContext('2d');
+    if (!ctx) return;
+    const clamped =
+      buffer instanceof Uint8ClampedArray ? buffer : new Uint8ClampedArray(buffer);
+    const imgData = new ImageData(new Uint8ClampedArray(clamped), w, h);
+    ctx.putImageData(imgData, 0, 0);
+  }, []);
+
+  const runFallbackMainThread = useCallback(
+    async (action: 'render' | 'randomize' | 'reset', w: number, h: number, samps: number, seed: number, jobId: number) => {
+      try {
+        if (!wasmMainThreadModRef.current) {
+          const wasmJsUrl = `${normalizedBase}smallpt.js`;
+          const modFactory = (await import(/* @vite-ignore */ wasmJsUrl)).default;
+          wasmMainThreadModRef.current = await modFactory();
+        }
+        const mod = wasmMainThreadModRef.current;
+        if (jobIdRef.current !== jobId) return;
+
+        if (action === 'randomize') {
+          mod._randomize_sphere_colors(seed);
+        } else if (action === 'reset') {
+          mod._reset_sphere_colors();
+        }
+
+        const colors: number[][] = [];
+        for (let i = 0; i < 8; i++) {
+          colors.push([
+            mod._get_sphere_color_r(i),
+            mod._get_sphere_color_g(i),
+            mod._get_sphere_color_b(i),
+          ]);
+        }
+        setSphereColors(colors);
+
+        const t0 = performance.now();
+        mod._init_render(w, h);
+        const chunkRows = 16;
+
+        for (let y = 0; y < h; y += chunkRows) {
+          if (jobIdRef.current !== jobId) return;
+          const endY = Math.min(y + chunkRows, h);
+          mod._render_rows(w, h, y, endY, samps, seed);
+
+          const ptr = mod._get_rgba_ptr();
+          const view = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, w * h * 4);
+          paintPixels(view, w, h);
+
+          const pct = Math.round((endY / h) * 100);
+          const elapsed = performance.now() - t0;
+          setProgress(pct);
+          setElapsedMs(elapsed);
+          setStatusMessage(
+            endY >= h
+              ? `Rendered ${w}×${h} (${samps * 4} spp) in ${(elapsed / 1000).toFixed(2)}s`
+              : `Tracing rays in WebAssembly... ${pct}%`
+          );
+
+          if (endY < h) {
+            await yieldToMain();
+          }
+        }
+        if (jobIdRef.current === jobId) {
+          setIsRendering(false);
+          setRenderCount((c) => c + 1);
+        }
+      } catch (err) {
+        console.error('smallpt WebAssembly fallback error:', err);
+        setStatusMessage('Error running smallpt WebAssembly module.');
+        setIsRendering(false);
+      }
+    },
+    [normalizedBase, paintPixels]
+  );
+
+  const startRender = useCallback(
+    (action: 'render' | 'randomize' | 'reset', customSamps?: number, customRes?: { w: number; h: number }) => {
+      const w = customRes ? customRes.w : resolution.w;
+      const h = customRes ? customRes.h : resolution.h;
+      const samps = customSamps ?? sampsPerSubpixel;
+      const jobId = ++jobIdRef.current;
+      const seed = (Date.now() ^ Math.floor(Math.random() * 0xffffffff)) >>> 0;
+
+      setIsRendering(true);
+      setProgress(0);
+      setStatusMessage(
+        action === 'randomize'
+          ? 'Randomizing sphere colors & path tracing in WebAssembly...'
+          : 'Tracing global illumination paths in WebAssembly...'
+      );
+
+      if (workerRef.current) {
+        workerRef.current.postMessage({
+          type: action,
+          width: w,
+          height: h,
+          samps,
+          seed,
+          jobId,
+          chunkRows: 24,
+        });
+      } else {
+        runFallbackMainThread(action, w, h, samps, seed, jobId);
+      }
+    },
+    [resolution, sampsPerSubpixel, runFallbackMainThread]
+  );
+
+  useEffect(() => {
+    let worker: Worker | null = null;
+    try {
+      worker = new Worker(`${normalizedBase}smallpt-worker.js`, { type: 'module' });
+      workerRef.current = worker;
+
+      worker.onmessage = (e) => {
+        const data = e.data;
+        if (!data || data.jobId !== jobIdRef.current) return;
+
+        if (data.colors) {
+          setSphereColors(data.colors);
+        }
+        if (data.pixels) {
+          paintPixels(data.pixels, data.width, data.height);
+        }
+        setProgress(data.progress ?? 0);
+        setElapsedMs(data.elapsedMs ?? 0);
+
+        if (data.type === 'complete') {
+          setIsRendering(false);
+          setRenderCount((c) => c + 1);
+          setStatusMessage(
+            `Rendered ${data.width}×${data.height} (${data.samps * 4} spp) in ${(data.elapsedMs / 1000).toFixed(2)}s`
+          );
+        } else {
+          setStatusMessage(`Tracing rays in WebAssembly... ${data.progress}%`);
+        }
+      };
+
+      worker.onerror = () => {
+        workerRef.current = null;
+        runFallbackMainThread('render', resolution.w, resolution.h, sampsPerSubpixel, 0, jobIdRef.current);
+      };
+    } catch {
+      workerRef.current = null;
+    }
+
+    startRender('render');
+
+    return () => {
+      if (worker) {
+        worker.terminate();
+      }
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  return (
+    <section
+      id="smallpt-wasm-section"
+      aria-labelledby="smallpt-heading"
+      className="bg-white border border-gray-200 rounded-lg shadow-sm p-6 my-6"
+    >
+      <div className="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 border-b border-gray-200 pb-4 mb-6">
+        <div>
+          <span className="text-amber-800 text-xs font-semibold uppercase tracking-widest">
+            Interactive WebAssembly Demo
+          </span>
+          <h2 id="smallpt-heading" className="text-2xl md:text-3xl font-brand text-gray-900 mt-1">
+            smallpt: C++ Global Illumination Path Tracer in WebAssembly
+          </h2>
+          <p className="text-sm text-gray-600 mt-1">
+            Kevin Beason&apos;s 99-line C++ Monte Carlo path tracer compiled to client-side WebAssembly with Emscripten.
+          </p>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-3">
+          <button
+            type="button"
+            id="randomize-spheres-btn"
+            onClick={() => startRender('randomize')}
+            className="bg-amber-600 hover:bg-amber-500 active:bg-amber-700 text-white font-semibold text-sm px-4 py-2.5 rounded-md shadow-xs transition-colors cursor-pointer flex items-center gap-2"
+          >
+            <svg
+              aria-hidden="true"
+              className="w-4 h-4"
+              fill="none"
+              stroke="currentColor"
+               strokeWidth="2"
+              viewBox="0 0 24 24"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
+              />
+            </svg>
+            Randomize Sphere Colors &amp; Run Again
+          </button>
+
+          <button
+            type="button"
+            id="reset-spheres-btn"
+            onClick={() => startRender('reset')}
+            className="bg-gray-800 hover:bg-gray-700 text-white font-semibold text-sm px-3.5 py-2.5 rounded-md transition-colors cursor-pointer"
+          >
+            Reset Original Colors
+          </button>
+        </div>
+      </div>
+
+      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
+        <div className="lg:col-span-2 flex flex-col items-center bg-gray-950 rounded-lg p-4 overflow-hidden">
+          <div className="relative w-full max-w-[640px] aspect-[4/3] flex items-center justify-center">
+            <canvas
+              ref={canvasRef}
+              id="smallpt-canvas"
+              width={resolution.w}
+              height={resolution.h}
+              className="w-full h-full object-contain rounded border border-gray-800"
+            />
+          </div>
+
+          <div className="w-full max-w-[640px] mt-3">
+            <div className="flex justify-between items-center text-xs text-gray-300 mb-1.5">
+              <span id="smallpt-status" role="status" aria-live="polite">
+                {statusMessage}
+              </span>
+              <span className="font-mono">
+                {progress}% ({(elapsedMs / 1000).toFixed(2)}s)
+              </span>
+            </div>
+            <div className="w-full bg-gray-800 h-2 rounded-full overflow-hidden">
+              <div
+                className="bg-amber-500 h-full transition-all duration-150"
+                style={{ width: `${progress}%` }}
+              />
+            </div>
+          </div>
+        </div>
+
+        <div className="flex flex-col gap-5 bg-gray-50 p-4 rounded-lg border border-gray-200">
+          <div>
+            <h3 className="text-sm font-bold uppercase tracking-wider text-gray-800 mb-3">
+              Render Settings
+            </h3>
+
+            <div className="space-y-3">
+              <div>
+                <label htmlFor="smallpt-spp-select" className="block text-xs font-semibold text-gray-700 mb-1">
+                  Samples Per Pixel (SPP)
+                </label>
+                <select
+                  id="smallpt-spp-select"
+                  value={sampsPerSubpixel}
+                  onChange={(e) => {
+                    const nextSamps = Number(e.target.value);
+                    setSampsPerSubpixel(nextSamps);
+                    startRender('render', nextSamps, resolution);
+                  }}
+                  className="w-full rounded border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-900"
+                >
+                  <option value={1}>4 SPP (Fast Preview)</option>
+                  <option value={2}>8 SPP (Balanced)</option>
+                  <option value={4}>16 SPP (High Quality)</option>
+                  <option value={8}>32 SPP (Ultra Quality)</option>
+                </select>
+              </div>
+
+              <div>
+                <label htmlFor="smallpt-res-select" className="block text-xs font-semibold text-gray-700 mb-1">
+                  Resolution
+                </label>
+                <select
+                  id="smallpt-res-select"
+                  value={`${resolution.w}x${resolution.h}`}
+                  onChange={(e) => {
+                    const [w, h] = e.target.value.split('x').map(Number);
+                    const nextRes = { w, h };
+                    setResolution(nextRes);
+                    startRender('render', sampsPerSubpixel, nextRes);
+                  }}
+                  className="w-full rounded border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-900"
+                >
+                  <option value="160x120">160 × 120 (Fast)</option>
+                  <option value="320x240">320 × 240 (Standard)</option>
+                  <option value="512x384">512 × 384 (HD Cornell Box)</option>
+                </select>
+              </div>
+            </div>
+          </div>
+
+          <div className="border-t border-gray-200 pt-4">
+            <div className="flex items-center justify-between mb-2">
+              <h3 className="text-sm font-bold uppercase tracking-wider text-gray-800">
+                Scene Sphere Colors
+              </h3>
+              <span className="text-xs text-gray-500">Renders: {renderCount}</span>
+            </div>
+            <ul className="grid grid-cols-2 gap-2 text-xs text-gray-700">
+              {SPHERE_LABELS.map((label, idx) => {
+                const rgb = sphereColors[idx] || [0, 0, 0];
+                const cssColor = toCssColor(rgb);
+                return (
+                  <li
+                    key={label}
+                    className="flex items-center gap-2 bg-white px-2.5 py-1.5 rounded border border-gray-200"
+                  >
+                    <span
+                      className="w-4 h-4 rounded-full border border-gray-300 shrink-0"
+                      style={{ backgroundColor: cssColor }}
+                    />
+                    <span className="truncate" title={label}>
+                      {label}
+                    </span>
+                  </li>
+                );
+              })}
+            </ul>
+          </div>
+
+          <div className="border-t border-gray-200 pt-3 text-xs text-gray-600 space-y-1">
+            <p>
+              <strong>Features:</strong> Monte Carlo global illumination, soft shadows, color bleeding, diffuse, specular mirror, and dielectric glass refraction.
+            </p>
+            <p>
+              <strong>Status:</strong> {isRendering ? 'Rendering in WebAssembly...' : 'Idle (Ready)'}
+            </p>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
