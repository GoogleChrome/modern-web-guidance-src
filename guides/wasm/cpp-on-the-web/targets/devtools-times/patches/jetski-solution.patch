diff --git a/src/wasm/smallpt.cpp b/src/wasm/smallpt.cpp
new file mode 100644
index 0000000..fdcc258
--- /dev/null
+++ b/src/wasm/smallpt.cpp
@@ -0,0 +1,218 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008
+// Adapted for client-side WebAssembly execution with randomized sphere colors.
+#include <math.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <emscripten/emscripten.h>
+
+struct Vec {        // Usage: position, also color (r,g,b)
+  double x, y, z;
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left (0)
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght (1)
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back (2)
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt (3)
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm (4)
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top  (5)
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr (6)
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas (7)
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite (8)
+};
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) {
+    if (depth<25 && erand48(Xi)<p) f=f*(1/p);
+    else return obj.e; // R.R. with max depth guard for WebAssembly stack
+  }
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+static uint8_t *rgba_buf = nullptr;
+static Vec *accum_buf = nullptr;
+static int buf_w = 0, buf_h = 0;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void reset_sphere_colors() {
+  spheres[0].c = Vec(.75, .25, .25);
+  spheres[1].c = Vec(.25, .25, .75);
+  spheres[2].c = Vec(.75, .75, .75);
+  spheres[3].c = Vec(0, 0, 0);
+  spheres[4].c = Vec(.75, .75, .75);
+  spheres[5].c = Vec(.75, .75, .75);
+  spheres[6].c = Vec(1, 1, 1) * .999;
+  spheres[7].c = Vec(1, 1, 1) * .999;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) {
+    spheres[index].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_r(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.x : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_g(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.y : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_b(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.z : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)((seed ^ 0x5DEECE66DULL) & 0xFFFF)
+  };
+  auto randRange = [&](double minVal, double maxVal) {
+    return minVal + (maxVal - minVal) * erand48(Xi);
+  };
+  // Randomize Left, Right, Back, Bottom, Top walls and Mirror & Glass spheres
+  spheres[0].c = Vec(randRange(0.15, 0.9), randRange(0.15, 0.9), randRange(0.15, 0.9)); // Left
+  spheres[1].c = Vec(randRange(0.15, 0.9), randRange(0.15, 0.9), randRange(0.15, 0.9)); // Right
+  spheres[2].c = Vec(randRange(0.25, 0.9), randRange(0.25, 0.9), randRange(0.25, 0.9)); // Back
+  spheres[4].c = Vec(randRange(0.25, 0.9), randRange(0.25, 0.9), randRange(0.25, 0.9)); // Bottom
+  spheres[5].c = Vec(randRange(0.25, 0.9), randRange(0.25, 0.9), randRange(0.25, 0.9)); // Top
+  spheres[6].c = Vec(randRange(0.35, 0.999), randRange(0.35, 0.999), randRange(0.35, 0.999)); // Mirror
+  spheres[7].c = Vec(randRange(0.35, 0.999), randRange(0.35, 0.999), randRange(0.35, 0.999)); // Glass
+}
+
+EMSCRIPTEN_KEEPALIVE
+void init_render(int w, int h) {
+  if (w != buf_w || h != buf_h) {
+    if (rgba_buf) free(rgba_buf);
+    if (accum_buf) free(accum_buf);
+    buf_w = w;
+    buf_h = h;
+    rgba_buf = (uint8_t*)malloc(w * h * 4 * sizeof(uint8_t));
+    accum_buf = (Vec*)malloc(w * h * sizeof(Vec));
+  }
+  for (int i = 0; i < w * h; i++) {
+    accum_buf[i] = Vec();
+    rgba_buf[i * 4 + 0] = 0;
+    rgba_buf[i * 4 + 1] = 0;
+    rgba_buf[i * 4 + 2] = 0;
+    rgba_buf[i * 4 + 3] = 255;
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void render_rows(int w, int h, int start_y, int end_y, int samps, int pass_seed) {
+  if (w != buf_w || h != buf_h || !rgba_buf || !accum_buf) {
+    init_render(w, h);
+  }
+  if (samps < 1) samps = 1;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+  for (int y = start_y; y < end_y && y < h; y++) {
+    for (unsigned short x = 0; x < w; x++) {
+      unsigned short Xi[3] = {
+        (unsigned short)(x ^ pass_seed),
+        (unsigned short)(y ^ (pass_seed >> 8)),
+        (unsigned short)(y * y * y + pass_seed)
+      };
+      int i = (h - y - 1) * w + x;
+      Vec pixel_c = Vec();
+      for (int sy = 0; sy < 2; sy++) {     // 2x2 subpixel rows
+        for (int sx = 0; sx < 2; sx++, r = Vec()) { // 2x2 subpixel cols
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          }
+          pixel_c = pixel_c + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      accum_buf[i] = pixel_c;
+      rgba_buf[i * 4 + 0] = (uint8_t)toInt(pixel_c.x);
+      rgba_buf[i * 4 + 1] = (uint8_t)toInt(pixel_c.y);
+      rgba_buf[i * 4 + 2] = (uint8_t)toInt(pixel_c.z);
+      rgba_buf[i * 4 + 3] = 255;
+    }
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render(int w, int h, int samps) {
+  init_render(w, h);
+  render_rows(w, h, 0, h, samps, 0);
+  return rgba_buf;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_rgba_ptr() {
+  return rgba_buf;
+}
+
+}
