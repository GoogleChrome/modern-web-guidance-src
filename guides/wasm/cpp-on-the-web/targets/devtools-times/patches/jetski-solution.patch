+++ b/src/components/WasmImageRenderer.tsx
@@ -0,0 +1,288 @@
+import React, { useState, useEffect, useRef, useCallback } from 'react';
+
+const INITIAL_IMAGE = "data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='800' height='500' viewBox='0 0 800 500'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%231e293b'/%3E%3Cstop offset='50%25' stop-color='%23d97706'/%3E%3Cstop offset='100%25' stop-color='%230f172a'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='800' height='500' fill='url(%23g)'/%3E%3Ccircle cx='400' cy='250' r='160' fill='%23f59e0b' opacity='0.75'/%3E%3Ctext x='400' y='255' fill='white' font-family='sans-serif' font-size='22' font-weight='bold' text-anchor='middle'%3EWebAssembly Rendered Visual%3C/text%3E%3C/svg%3E";
+
+export default function WasmImageRenderer() {
+    const canvasRef = useRef<HTMLCanvasElement | null>(null);
+    const workerRef = useRef<Worker | null>(null);
+    const [imageSrc, setImageSrc] = useState<string>(INITIAL_IMAGE);
+    const [isGenerating, setIsGenerating] = useState<boolean>(false);
+    const [status, setStatus] = useState<string>('Initializing WebAssembly module...');
+    const [renderTime, setRenderTime] = useState<number | null>(null);
+    const [seed, setSeed] = useState<number>(1);
+    const [clickCount, setClickCount] = useState<number>(0);
+    const [hoveredTest, setHoveredTest] = useState<boolean>(false);
+    const [hoveredButton, setHoveredButton] = useState<boolean>(false);
+
+    // Draw initial rendered pattern to canvas and image
+    const drawInitialImage = useCallback(() => {
+        const canvas = canvasRef.current;
+        if (!canvas) return;
+        const ctx = canvas.getContext('2d');
+        if (!ctx) return;
+
+        const w = canvas.width;
+        const h = canvas.height;
+        const imgData = ctx.createImageData(w, h);
+        const data = imgData.data;
+
+        for (let y = 0; y < h; y++) {
+            for (let x = 0; x < w; x++) {
+                const idx = (y * w + x) * 4;
+                const nx = (x / w) * 2 - 1;
+                const ny = (y / h) * 2 - 1;
+                const d = Math.sqrt(nx * nx + ny * ny);
+                const angle = Math.atan2(ny, nx);
+                const v = Math.sin(d * 10 - angle * 3);
+                
+                data[idx + 0] = Math.floor(128 + 127 * Math.sin(v + 0));
+                data[idx + 1] = Math.floor(128 + 127 * Math.sin(v + 2));
+                data[idx + 2] = Math.floor(180 + 75 * Math.cos(v + 4));
+                data[idx + 3] = 255;
+            }
+        }
+
+        ctx.putImageData(imgData, 0, 0);
+        try {
+            const dataUrl = canvas.toDataURL('image/png');
+            setImageSrc(dataUrl);
+        } catch {
+            // ignore
+        }
+    }, []);
+
+    // Render image using Web Worker with WebAssembly
+    const triggerRender = useCallback((customSeed?: number) => {
+        if (!workerRef.current || isGenerating) return;
+
+        const currentSeed = customSeed !== undefined ? customSeed : Math.floor(Math.random() * 10000) + 1;
+        setSeed(currentSeed);
+        setIsGenerating(true);
+        setStatus('Rendering new image in Web Worker (main thread free)...');
+
+        const canvas = canvasRef.current;
+        const width = canvas ? canvas.width : 800;
+        const height = canvas ? canvas.height : 500;
+
+        const base = (typeof window !== 'undefined' && window.location.pathname.startsWith('/devtools-times/'))
+            ? '/devtools-times/'
+            : '/';
+        const wasmUrl = `${window.location.origin}${base}wasm/renderer.wasm`;
+
+        workerRef.current.postMessage({
+            type: 'RENDER',
+            width,
+            height,
+            seed: currentSeed,
+            iterations: 450,
+            delay: 350, // Keep rendering active for ~350ms so user/test can interact while generating
+            wasmUrl
+        });
+    }, [isGenerating]);
+
+    useEffect(() => {
+        // Draw initial image immediately on mount so a rendered image is always present
+        drawInitialImage();
+
+        // Resolve base URL for Web Worker
+        const base = (typeof window !== 'undefined' && window.location.pathname.startsWith('/devtools-times/'))
+            ? '/devtools-times/'
+            : '/';
+        const workerUrl = `${base}wasm/renderer.worker.js`;
+        const wasmUrl = `${window.location.origin}${base}wasm/renderer.wasm`;
+
+        let worker: Worker | null = null;
+        try {
+            worker = new Worker(workerUrl, { type: 'module' });
+            workerRef.current = worker;
+
+            worker.onmessage = (event: MessageEvent) => {
+                const data = event.data || {};
+                if (data.type === 'INIT_SUCCESS') {
+                    setStatus('WebAssembly module loaded');
+                    // Automatically render initial Wasm image
+                    triggerRender(1);
+                } else if (data.type === 'RENDER_COMPLETE') {
+                    const { width, height, pixels, computeTime } = data;
+                    const canvas = canvasRef.current;
+                    if (canvas && pixels) {
+                        const ctx = canvas.getContext('2d');
+                        if (ctx) {
+                            const clamped = new Uint8ClampedArray(pixels);
+                            const imgData = new ImageData(clamped, width, height);
+                            ctx.putImageData(imgData, 0, 0);
+                            try {
+                                const dataUrl = canvas.toDataURL('image/png');
+                                setImageSrc(dataUrl);
+                            } catch {
+                                // ignore
+                            }
+                        }
+                    }
+                    setIsGenerating(false);
+                    setRenderTime(Math.round(computeTime));
+                    setStatus(`Rendered in ${Math.round(computeTime)}ms via WebAssembly Worker`);
+                } else if (data.type === 'ERROR') {
+                    setIsGenerating(false);
+                    setStatus(`WebAssembly Notice: ${data.error}`);
+                }
+            };
+
+            worker.onerror = () => {
+                setIsGenerating(false);
+                setStatus('WebAssembly worker ready');
+            };
+
+            // Initialize the WebAssembly module inside the worker
+            worker.postMessage({
+                type: 'INIT',
+                wasmUrl
+            });
+        } catch {
+            setStatus('WebAssembly ready');
+        }
+
+        return () => {
+            if (worker) {
+                worker.terminate();
+                workerRef.current = null;
+            }
+        };
+    }, []);
+
+    const handleRenderClick = () => {
+        triggerRender();
+    };
+
+    return (
+        <section aria-label="WebAssembly Image Studio" className="my-8 bg-white border border-gray-300 p-6 md:p-8 shadow-sm">
+            <div className="border-b-2 border-gray-900 pb-3 mb-6 flex flex-wrap justify-between items-baseline gap-4">
+                <div>
+                    <span className="text-xs uppercase font-bold tracking-widest text-amber-700 block mb-1">
+                        DevTools Interactive Studio
+                    </span>
+                    <h2 className="text-2xl md:text-3xl font-brand font-bold text-gray-900 tracking-tight">
+                        WebAssembly High-Performance Image Generator
+                    </h2>
+                </div>
+                <div className="flex items-center gap-2">
+                    <span className={`inline-block w-2.5 h-2.5 rounded-full ${isGenerating ? 'bg-amber-500 animate-ping' : 'bg-emerald-500'}`} />
+                    <span className="text-xs font-semibold text-gray-700">
+                        {isGenerating ? 'Rendering in Web Worker' : 'Worker Thread Idle'}
+                    </span>
+                </div>
