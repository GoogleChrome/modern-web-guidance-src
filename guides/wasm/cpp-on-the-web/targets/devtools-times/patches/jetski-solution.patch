+#include <emscripten.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <math.h>
+
+extern "C" {
+
+// Color palette generation using smooth cosine gradients
+static inline void get_color(float t, int palette, uint8_t* r, uint8_t* g, uint8_t* b) {
+    if (t >= 1.0f) {
+        *r = 15; *g = 23; *b = 42; // Deep slate navy
+        return;
+    }
+    
+    // Smooth coloring with cosine gradients: color = a + b * cos(2*pi*(c*t + d))
+    float p = t * 6.28318530718f; // 2 * pi
+    float cr, cg, cb;
+    
+    switch (palette % 4) {
+        case 0: // Amber / Gold / Warm news palette
+            cr = 0.5f + 0.5f * cosf(p);
+            cg = 0.5f + 0.5f * cosf(p + 0.6f);
+            cb = 0.5f + 0.5f * cosf(p + 1.2f);
+            *r = (uint8_t)(cr * 240.0f + 15.0f);
+            *g = (uint8_t)(cg * 180.0f + 10.0f);
+            *b = (uint8_t)(cb * 100.0f + 5.0f);
+            break;
+        case 1: // Cyan / Ocean / Deep Blue
+            cr = 0.5f + 0.5f * cosf(p + 2.0f);
+            cg = 0.5f + 0.5f * cosf(p + 1.0f);
+            cb = 0.5f + 0.5f * cosf(p);
+            *r = (uint8_t)(cr * 80.0f);
+            *g = (uint8_t)(cg * 200.0f + 30.0f);
+            *b = (uint8_t)(cb * 240.0f + 15.0f);
+            break;
+        case 2: // Sunset / Purple / Coral
+            cr = 0.5f + 0.5f * cosf(p);
+            cg = 0.5f + 0.5f * cosf(p + 3.0f);
+            cb = 0.5f + 0.5f * cosf(p + 1.5f);
+            *r = (uint8_t)(cr * 230.0f + 25.0f);
+            *g = (uint8_t)(cg * 100.0f + 20.0f);
+            *b = (uint8_t)(cb * 220.0f + 35.0f);
+            break;
+        default: // Emerald / Cyberpunk Neon
+            cr = 0.5f + 0.5f * cosf(p + 1.5f);
+            cg = 0.5f + 0.5f * cosf(p);
+            cb = 0.5f + 0.5f * cosf(p + 2.5f);
+            *r = (uint8_t)(cr * 60.0f + 20.0f);
+            *g = (uint8_t)(cg * 240.0f + 15.0f);
+            *b = (uint8_t)(cb * 160.0f + 40.0f);
+            break;
+    }
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_image(int width, int height, int seed, int max_iterations) {
+    if (width <= 0 || height <= 0) return NULL;
+    
+    int total_bytes = width * height * 4;
+    uint8_t* buffer = (uint8_t*)malloc(total_bytes);
+    if (!buffer) return NULL;
+
+    // Seeds determine Julia set constant (cr, ci)
+    static const float julia_points[][2] = {
+        {-0.7f, 0.27015f},
+        {-0.4f, 0.6f},
+        {-0.8f, 0.156f},
+        {0.285f, 0.01f},
+        {-0.7269f, 0.1889f},
+        {-0.835f, -0.2321f},
+        {-0.70176f, -0.3842f},
+        {0.355f, 0.355f}
+    };
+    int num_points = sizeof(julia_points) / sizeof(julia_points[0]);
+    int p_idx = abs(seed) % num_points;
+    float cr = julia_points[p_idx][0] + ((seed % 17) - 8) * 0.003f;
+    float ci = julia_points[p_idx][1] + ((seed % 13) - 6) * 0.003f;
+    int palette = abs(seed) % 4;
+
+    float aspect = (float)width / (float)height;
+    float scale = 1.3f;
+
+    for (int y = 0; y < height; ++y) {
+        float zy0 = ((float)y / (float)height - 0.5f) * 2.0f * scale;
+        int row_idx = y * width * 4;
+
+        for (int x = 0; x < width; ++x) {
+            float zx = ((float)x / (float)width - 0.5f) * 2.0f * scale * aspect;
+            float zy = zy0;
+            
+            int iter = 0;
+            while (zx * zx + zy * zy < 4.0f && iter < max_iterations) {
+                float tmp = zx * zx - zy * zy + cr;
+                zy = 2.0f * zx * zy + ci;
+                zx = tmp;
+                iter++;
+            }
+
+            uint8_t r, g, b;
+            if (iter == max_iterations) {
+                r = 15; g = 23; b = 42; // Deep navy background
+            } else {
+                // Continuous potential coloring for smooth gradients
+                float dist_sq = zx * zx + zy * zy;
+                float log_zn = logf(dist_sq) / 2.0f;
+                float nu = logf(log_zn / 0.69314718f) / 0.69314718f;
+                float smooth_iter = (float)iter + 1.0f - nu;
+                if (smooth_iter < 0.0f) smooth_iter = 0.0f;
+                float t = smooth_iter / (float)max_iterations;
+                get_color(t, palette, &r, &g, &b);
+            }
+
+            int idx = row_idx + x * 4;
+            buffer[idx + 0] = r;
+            buffer[idx + 1] = g;
+            buffer[idx + 2] = b;
+            buffer[idx + 3] = 255; // Alpha
+        }
+    }
+
+    return buffer;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void free_buffer(uint8_t* ptr) {
+    if (ptr) {
+        free(ptr);
+    }
+}
+
+}
