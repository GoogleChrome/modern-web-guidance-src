@@ -0,0 +1,75 @@
+import Module from './smallpt.js';
+
+let wasmMod = null;
+let currentJobId = 0;
+
+async function ensureModule() {
+  if (!wasmMod) {
+    wasmMod = await Module();
+  }
+  return wasmMod;
+}
+
+function getSphereColors(mod) {
+  const colors = [];
+  for (let i = 0; i < 8; i++) {
+    colors.push([
+      mod._get_sphere_color_r(i),
+      mod._get_sphere_color_g(i),
+      mod._get_sphere_color_b(i),
+    ]);
+  }
+  return colors;
+}
+
+self.addEventListener('message', async (e) => {
+  const { type, width = 320, height = 240, samps = 2, seed, jobId = 0, chunkRows = 24 } = e.data || {};
+  currentJobId = jobId;
+
+  const mod = await ensureModule();
+  if (currentJobId !== jobId) return;
+
+  if (type === 'reset') {
+    mod._reset_sphere_colors();
+  } else if (type === 'randomize') {
+    const actualSeed = typeof seed === 'number' ? seed : ((Date.now() ^ Math.floor(Math.random() * 0xFFFFFFFF)) >>> 0);
+    mod._randomize_sphere_colors(actualSeed);
+  }
+
+  const colors = getSphereColors(mod);
+  const startTime = performance.now();
+  mod._init_render(width, height);
+
+  const passSeed = typeof seed === 'number' ? seed : 0;
+
+  for (let y = 0; y < height; y += chunkRows) {
+    if (currentJobId !== jobId) return;
+    const endY = Math.min(y + chunkRows, height);
+    mod._render_rows(width, height, y, endY, samps, passSeed);
+
+    const ptr = mod._get_rgba_ptr();
+    const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, width * height * 4).slice();
+    const done = endY >= height;
+    const elapsedMs = performance.now() - startTime;
+
+    self.postMessage(
+      {
+        type: done ? 'complete' : 'progress',
+        jobId,
+        width,
+        height,
+        samps,
+        completedRows: endY,
+        progress: Math.round((endY / height) * 100),
+        elapsedMs,
+        colors,
+        pixels: pixels.buffer,
+      },
+      [pixels.buffer]
+    );
+
+    if (!done) {
+      await new Promise((resolve) => setTimeout(resolve, 0));
+    }
+  }
+});
