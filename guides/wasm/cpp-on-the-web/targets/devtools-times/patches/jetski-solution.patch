diff --git a/src/wasm/SmallptPathTracer.tsx b/src/wasm/SmallptPathTracer.tsx
new file mode 100644
index 0000000..94f9194
--- /dev/null
+++ b/src/wasm/SmallptPathTracer.tsx
@@ -0,0 +1,170 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+const WIDTH = 160;
+const HEIGHT = 120;
+const SAMPLES = 12;
+
+interface WorkerResponse {
+  pixels?: Uint8ClampedArray;
+  width?: number;
+  height?: number;
+  samples?: number;
+  elapsedMs?: number;
+  requestId?: number;
+  randomized?: boolean;
+  error?: string;
+}
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const requestIdRef = useRef<number>(0);
+  const seedCounterRef = useRef<number>(1);
+
+  const [isRendering, setIsRendering] = useState<boolean>(true);
+  const [elapsedMs, setElapsedMs] = useState<number | null>(null);
+  const [renderCount, setRenderCount] = useState<number>(0);
+  const [isRandomized, setIsRandomized] = useState<boolean>(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const triggerRender = useCallback((randomize: boolean) => {
+    const worker = workerRef.current;
+    if (!worker) return;
+
+    const nextRequestId = ++requestIdRef.current;
+    const seed =
+      ((Date.now() ^ (seedCounterRef.current++ * 2654435761)) >>> 0) || 1;
+
+    setIsRendering(true);
+    setError(null);
+
+    worker.postMessage({
+      width: WIDTH,
+      height: HEIGHT,
+      samples: SAMPLES,
+      randomize,
+      seed,
+      requestId: nextRequestId,
+    });
+  }, []);
+
+  useEffect(() => {
+    const worker = new Worker(new URL('./worker.js', import.meta.url), {
+      type: 'module',
+    });
+    workerRef.current = worker;
+
+    worker.onmessage = (event: MessageEvent<WorkerResponse>) => {
+      const data = event.data;
+      if (!data) return;
+
+      if (data.error) {
+        setError(data.error);
+        setIsRendering(false);
+        return;
+      }
+
+      if (data.pixels && data.width && data.height) {
+        const canvas = canvasRef.current;
+        if (canvas) {
+          const ctx = canvas.getContext('2d');
+          if (ctx) {
+            const imageData = new ImageData(
+              new Uint8ClampedArray(data.pixels),
+              data.width,
+              data.height,
+            );
+            ctx.putImageData(imageData, 0, 0);
+          }
+        }
+        if (typeof data.elapsedMs === 'number') {
+          setElapsedMs(data.elapsedMs);
+        }
+        setIsRandomized(Boolean(data.randomized));
+        setRenderCount((prev) => prev + 1);
+        if (!data.requestId || data.requestId >= requestIdRef.current) {
+          setIsRendering(false);
+        }
+      }
+    };
+
+    worker.onerror = (err) => {
+      setError(err.message || 'WebAssembly worker error');
+      setIsRendering(false);
+    };
+
+    triggerRender(false);
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, [triggerRender]);
+
+  const handleRandomizeColors = () => {
+    triggerRender(true);
+  };
+
+  return (
+    <section
+      aria-labelledby="smallpt-heading"
+      className="bg-white border border-gray-300 rounded-sm p-4 md:p-6 my-6 shadow-xs"
+    >
+      <div className="flex flex-col md:flex-row items-center gap-6">
+        <div className="relative shrink-0 bg-gray-900 rounded-sm overflow-hidden border border-gray-300">
+          <canvas
+            ref={canvasRef}
+            id="smallpt-canvas"
+            width={WIDTH}
+            height={HEIGHT}
+            data-rendered={renderCount > 0 ? 'true' : 'false'}
+            data-randomized={isRandomized ? 'true' : 'false'}
+            data-render-count={renderCount}
+            className="block w-64 h-48 sm:w-80 sm:h-60 object-contain"
+          />
+        </div>
+
+        <div className="flex-1 text-left">
+          <div className="text-xs font-semibold uppercase tracking-wider text-amber-700 mb-1">
+            Interactive WebAssembly Demo
+          </div>
+          <h2
+            id="smallpt-heading"
+            className="text-xl font-bold text-gray-900 mb-2"
+          >
+            smallpt Global Illumination Path Tracer
+          </h2>
+          <p className="text-sm text-gray-600 mb-4">
+            Kevin Beason&apos;s open-source C++ Monte Carlo path tracer compiled
+            to WebAssembly with Emscripten and running off the main thread in a
+            Web Worker.
+          </p>
+
+          <div className="flex flex-wrap items-center gap-4">
+            <button
+              type="button"
+              id="randomize-sphere-colors"
+              onClick={handleRandomizeColors}
+              className="inline-flex items-center px-4 py-2 bg-gray-900 text-white text-sm font-medium rounded-sm hover:bg-amber-500 hover:text-gray-900 transition-colors cursor-pointer"
+            >
+              Randomize Sphere Colors
+            </button>
+
+            <span
+              className="text-xs text-gray-500"
+              aria-live="polite"
+            >
+              {error
+                ? `Error: ${error}`
+                : isRendering
+                  ? 'Rendering path-traced scene in WebAssembly...'
+                  : elapsedMs !== null
+                    ? `Rendered ${WIDTH}×${HEIGHT} (${SAMPLES} spp) in ${elapsedMs} ms`
+                    : 'Ready'}
+            </span>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
