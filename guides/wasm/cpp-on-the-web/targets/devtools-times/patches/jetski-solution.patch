new file mode 100644
index 0000000..385f92b
--- /dev/null
+++ b/public/wasm/renderer.worker.js
@@ -0,0 +1,92 @@
+// Web Worker for WebAssembly Image Generation
+// Runs WebAssembly module in background thread to avoid blocking main browser thread
+
+let ModuleInstance = null;
+let initPromise = null;
+
+async function getModule(wasmUrl) {
+    if (ModuleInstance) return ModuleInstance;
+    if (!initPromise) {
+        initPromise = (async () => {
+            const { default: createModule } = await import('./renderer.js');
+            const mod = await createModule({
+                locateFile: (path) => {
+                    if (path.endsWith('.wasm') && wasmUrl) {
+                        return wasmUrl;
+                    }
+                    return new URL(path, import.meta.url).href;
+                },
+                print: (text) => {
+                    // Suppress stdout noise
+                },
+                printErr: (text) => {
+                    // Suppress harmless fallback logs
+                }
+            });
+            ModuleInstance = mod;
+            return mod;
+        })();
+    }
+    return initPromise;
+}
+
+self.onmessage = async (event) => {
+    const data = event.data || {};
+    const { type, id, width = 800, height = 500, seed = 0, iterations = 400, wasmUrl, delay = 0 } = data;
+
+    try {
+        if (type === 'INIT') {
+            await getModule(wasmUrl);
+            self.postMessage({ type: 'INIT_SUCCESS', id });
+            return;
+        }
+
+        if (type === 'RENDER') {
+            const mod = await getModule(wasmUrl);
+            const startTime = performance.now();
+
+            const ptr = mod._render_image(width, height, seed, iterations);
+            if (!ptr) {
+                throw new Error('WebAssembly failed to allocate image buffer');
+            }
+
+            const totalBytes = width * height * 4;
+            const wasmMemory = mod.HEAPU8 || (mod.HEAP8 ? new Uint8Array(mod.HEAP8.buffer) : null);
+            if (!wasmMemory) {
+                throw new Error('WebAssembly memory not accessible');
+            }
+
+            const pixelData = new Uint8ClampedArray(width * height * 4);
+            pixelData.set(wasmMemory.subarray(ptr, ptr + totalBytes));
+            mod._free_buffer(ptr);
+
+            const computeTime = performance.now() - startTime;
+
+            if (delay > 0) {
+                const remaining = delay - computeTime;
+                if (remaining > 0) {
+                    await new Promise((r) => setTimeout(r, remaining));
+                }
+            }
+
+            self.postMessage(
+                {
+                    type: 'RENDER_COMPLETE',
+                    id,
+                    width,
+                    height,
+                    seed,
+                    computeTime,
+                    pixels: pixelData.buffer
+                },
+                [pixelData.buffer]
+            );
+        }
+    } catch (err) {
+        self.postMessage({
+            type: 'ERROR',
+            id,
+            error: err instanceof Error ? err.message : String(err)
+        });
+    }
+};
