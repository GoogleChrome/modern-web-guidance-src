diff --git a/src/wasm/worker.js b/src/wasm/worker.js
new file mode 100644
index 0000000..06d55e9
--- /dev/null
+++ b/src/wasm/worker.js
@@ -0,0 +1,71 @@
+import initSmallpt from './smallpt.js';
+
+let wasmInstancePromise = null;
+let renderQueue = Promise.resolve();
+
+function getWasm() {
+  if (!wasmInstancePromise) {
+    wasmInstancePromise = initSmallpt();
+  }
+  return wasmInstancePromise;
+}
+
+async function handleRenderRequest(data) {
+  const {
+    width = 160,
+    height = 120,
+    samples = 12,
+    randomize = false,
+    seed = 1,
+    requestId = 0,
+  } = data || {};
+
+  try {
+    const wasm = await getWasm();
+    if (randomize) {
+      wasm._randomize_colors(seed >>> 0);
+    } else {
+      wasm._reset_colors();
+    }
+
+    const byteLength = width * height * 4;
+    const ptr = wasm._malloc(byteLength);
+
+    try {
+      const startTime = performance.now();
+      wasm._render_frame(ptr, width, height, samples);
+      const elapsedMs = Math.round(performance.now() - startTime);
+
+      const pixels = new Uint8ClampedArray(
+        wasm.HEAPU8.buffer,
+        ptr,
+        byteLength,
+      ).slice();
+
+      self.postMessage(
+        {
+          pixels,
+          width,
+          height,
+          samples,
+          elapsedMs,
+          requestId,
+          randomized: Boolean(randomize),
+        },
+        [pixels.buffer],
+      );
+    } finally {
+      wasm._free(ptr);
+    }
+  } catch (err) {
+    self.postMessage({
+      error: err instanceof Error ? err.message : String(err),
+      requestId,
+    });
+  }
+}
+
+self.onmessage = (event) => {
+  const data = event.data;
+  renderQueue = renderQueue.then(() => handleRenderRequest(data));
+};
