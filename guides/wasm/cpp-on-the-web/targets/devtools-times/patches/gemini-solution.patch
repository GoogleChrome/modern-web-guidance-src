+<script>
+    document.addEventListener('DOMContentLoaded', () => {
+        const container = document.getElementById('wasm-filter-container');
+        if (!container) return;
+
+        const applyBtn = document.getElementById('apply-filter-btn') as HTMLButtonElement;
+        const statusEl = document.getElementById('filter-status');
+        const mainImage = document.getElementById('article-main-image') as HTMLImageElement;
+
+        if (!applyBtn || !statusEl || !mainImage) return;
+
+        const baseUrl = container.getAttribute('data-base-url') || '/devtools-times/';
+        let wasmModule: any = null;
+        let isProcessing = false;
+        let isApplied = false;
+
+        applyBtn.addEventListener('click', async () => {
+            if (isProcessing) return;
+            if (isApplied) {
+                statusEl.textContent = 'Filter already applied!';
+                statusEl.classList.remove('hidden');
+                return;
+            }
+
+            try {
+                isProcessing = true;
+                applyBtn.disabled = true;
+                applyBtn.classList.add('opacity-50', 'cursor-not-allowed');
+                statusEl.textContent = 'Loading WebAssembly...';
+                statusEl.classList.remove('hidden');
+
+                // 1. Dynamic import of the Wasm ES6 module compiled by Emscripten
+                const modulePath = `${baseUrl}wasm/filter.js`;
+                const moduleNamespace = await import(/* @vite-ignore */ modulePath);
+                const createModule = moduleNamespace.default;
+
+                statusEl.textContent = 'Initializing Module...';
+                wasmModule = await createModule();
+
+                statusEl.textContent = 'Processing image...';
+
+                // 2. Setup canvas and read image pixels
+                const canvas = document.createElement('canvas');
+                canvas.width = mainImage.naturalWidth || mainImage.width;
+                canvas.height = mainImage.naturalHeight || mainImage.height;
+
+                const ctx = canvas.getContext('2d');
+                if (!ctx) {
+                    throw new Error('Could not get 2D context from canvas');
+                }
+
+                // Draw current image onto the canvas
+                ctx.drawImage(mainImage, 0, 0, canvas.width, canvas.height);
+
+                // Get original image pixel data
+                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
+                const byteCount = imageData.data.length;
+
+                // 3. Allocate buffer inside WebAssembly linear memory
+                const bufferPtr = wasmModule._malloc(byteCount);
+                if (!bufferPtr) {
+                    throw new Error('WebAssembly memory allocation failed');
+                }
+
+                try {
+                    // Copy JS Uint8ClampedArray into WebAssembly heap
+                    wasmModule.HEAPU8.set(imageData.data, bufferPtr);
+
+                    // Invoke C++ processing function with pointer address via Embind
+                    wasmModule.applyImageFilter(bufferPtr.toString(), byteCount);
+
+                    // Copy processed bytes back to JS ImageData array
+                    imageData.data.set(
+                        wasmModule.HEAPU8.subarray(bufferPtr, bufferPtr + byteCount)
+                    );
+
+                    // Render updated pixels to canvas
+                    ctx.putImageData(imageData, 0, 0);
+                } finally {
+                    // 4. Crucial: Free allocated WebAssembly memory buffer
+                    wasmModule._free(bufferPtr);
+                }
+
+                // 5. Replace image in DOM with the modified canvas
+                canvas.className = mainImage.className;
+                canvas.id = 'article-main-image-canvas';
+                if (mainImage.parentNode) {
+                    mainImage.parentNode.replaceChild(canvas, mainImage);
+                }
+
+                isApplied = true;
+                statusEl.textContent = 'Sepia filter applied!';
+                statusEl.className = 'text-xs font-semibold text-emerald-700';
+                applyBtn.textContent = 'Filter Applied';
+            } catch (error) {
+                console.error('Error applying WebAssembly filter:', error);
+                statusEl.textContent = `Error: ${(error as Error).message || 'Failed to process image'}`;
+                statusEl.className = 'text-xs font-semibold text-rose-600';
+                applyBtn.disabled = false;
+                applyBtn.classList.remove('opacity-50', 'cursor-not-allowed');
+            } finally {
+                isProcessing = false;
+            }
+        });
+    });
+</script>
