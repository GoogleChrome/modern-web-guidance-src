diff --git a/scripts/build-wasm.sh b/scripts/build-wasm.sh
new file mode 100755
index 0000000..d02054d
--- /dev/null
+++ b/scripts/build-wasm.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Compiles src/wasm/image-gen/image_gen.cpp to a WebAssembly ES module.
+#
+# Requires the Emscripten SDK (emcc) on PATH: https://emscripten.org/docs/getting_started/downloads.html
+#
+# Output is written to public/wasm/ so Astro serves it as a static asset and
+# the compiled artifacts can be checked into the repo, letting `astro build`
+# run without needing Emscripten installed.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+
+SRC="${ROOT_DIR}/src/wasm/image-gen/image_gen.cpp"
+OUT_DIR="${ROOT_DIR}/public/wasm"
+OUT_JS="${OUT_DIR}/image-gen.mjs"
+
+mkdir -p "${OUT_DIR}"
+
+emcc "${SRC}" \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=web \
+  -sSTRICT \
+  -sALLOW_MEMORY_GROWTH \
+  -sMODULARIZE \
+  -sEXPORT_NAME=createImageGenModule \
+  -sEXPORTED_FUNCTIONS=_generate_image,_get_buffer,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=cwrap,HEAPU8 \
+  -sFILESYSTEM=0 \
+  -Oz -flto \
+  -o "${OUT_JS}"
+
+echo "Built ${OUT_JS} ($(du -h "${OUT_JS}" | cut -f1)) and its companion .wasm"
diff --git a/src/components/ImageGenerator.tsx b/src/components/ImageGenerator.tsx
new file mode 100644
index 0000000..7c518ab
--- /dev/null
+++ b/src/components/ImageGenerator.tsx
@@ -0,0 +1,130 @@
+import React, { useEffect, useRef, useState } from 'react';
+
+const IMAGE_WIDTH = 480;
+const IMAGE_HEIGHT = 320;
+
+type WorkerResponse =
+  | { type: 'ready' }
+  | { type: 'result'; requestId: number; width: number; height: number; pixels: ArrayBuffer }
+  | { type: 'error'; message: string; requestId?: number };
+
+export default function ImageGenerator() {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const requestIdRef = useRef(0);
+  const pendingRequestIdRef = useRef<number | null>(null);
+
+  const [isReady, setIsReady] = useState(false);
+  const [isGenerating, setIsGenerating] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [hasImage, setHasImage] = useState(false);
+
+  const drawPixels = (width: number, height: number, pixels: ArrayBuffer) => {
+    const canvas = canvasRef.current;
+    const context = canvas?.getContext('2d');
+    if (!canvas || !context) return;
+
+    canvas.width = width;
+    canvas.height = height;
+    const imageData = new ImageData(new Uint8ClampedArray(pixels), width, height);
+    context.putImageData(imageData, 0, 0);
+    setHasImage(true);
+  };
+
+  useEffect(() => {
+    const worker = new Worker(new URL('../workers/image-gen.worker.ts', import.meta.url), {
+      type: 'module',
+    });
+    workerRef.current = worker;
+
+    worker.onmessage = (event: MessageEvent<WorkerResponse>) => {
+      const message = event.data;
+
+      if (message.type === 'ready') {
+        setIsReady(true);
+        requestImage();
+        return;
+      }
+
+      if (message.type === 'result') {
+        if (message.requestId !== pendingRequestIdRef.current) return;
+        drawPixels(message.width, message.height, message.pixels);
+        setIsGenerating(false);
+        setError(null);
+        return;
+      }
+
+      if (message.type === 'error') {
+        setError(message.message);
+        setIsGenerating(false);
+      }
+    };
+
+    worker.onerror = (event: ErrorEvent) => {
+      event.preventDefault();
+      setError(event.message || 'The image generator worker crashed.');
+      setIsGenerating(false);
+    };
+
+    worker.postMessage({
+      type: 'init',
+      wasmUrl: `${import.meta.env.BASE_URL}wasm/image-gen.mjs`,
+    });
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const requestImage = () => {
+    const worker = workerRef.current;
+    if (!worker) return;
+
+    const requestId = requestIdRef.current + 1;
+    requestIdRef.current = requestId;
+    pendingRequestIdRef.current = requestId;
+
+    setIsGenerating(true);
+    setError(null);
+
+    worker.postMessage({
+      type: 'generate',
+      requestId,
+      width: IMAGE_WIDTH,
+      height: IMAGE_HEIGHT,
+      seed: Math.floor(Math.random() * 0xffffffff),
+    });
+  };
+
+  return (
+    <div className="flex flex-col items-center gap-4">
+      <div
+        className="relative w-full max-w-lg overflow-hidden rounded-lg border border-gray-300 bg-gray-900"
+        style={{ aspectRatio: `${IMAGE_WIDTH} / ${IMAGE_HEIGHT}` }}
+      >
+        <canvas ref={canvasRef} className="h-full w-full" aria-label="Generated fractal image" />
+        {!hasImage && (
+          <div className="absolute inset-0 flex items-center justify-center text-sm text-gray-400">
+            {error ? 'Unable to render image.' : 'Loading image generator…'}
+          </div>
+        )}
+      </div>
+
+      <div className="flex items-center gap-3">
+        <button
+          type="button"
+          onClick={requestImage}
+          disabled={!isReady}
+          className="rounded-md bg-amber-400 px-4 py-2 font-semibold text-gray-900 transition-colors hover:bg-amber-300 disabled:cursor-not-allowed disabled:opacity-50"
+        >
+          Generate new image
+        </button>
+        {isGenerating && <span className="text-sm text-gray-500">Rendering…</span>}
+      </div>
+
+      {error && <p className="text-sm text-red-600">{error}</p>}
+    </div>
+  );
+}
