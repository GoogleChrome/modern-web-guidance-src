diff --git a/scripts/build-wasm.sh b/scripts/build-wasm.sh
new file mode 100755
index 0000000..24b78c9
--- /dev/null
+++ b/scripts/build-wasm.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# Compiles the smallpt C++ path tracer to an ES6 WebAssembly module that runs
+# inside a module Web Worker. Invoked by `npm run build` before `astro build`.
+#
+# Usage: scripts/build-wasm.sh [release|debug]   (default: release)
+set -euo pipefail
+
+PROFILE="${1:-release}"
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+SRC_DIR="$ROOT/wasm/smallpt"
+OBJ_DIR="$ROOT/wasm/build/$PROFILE"
+OUT_DIR="$ROOT/src/wasm/generated"
+OUT_JS="$OUT_DIR/smallpt.js"
+
+if ! command -v em++ >/dev/null 2>&1; then
+  if [[ -f "$OUT_JS" && -f "$OUT_DIR/smallpt.wasm" ]]; then
+    echo "build-wasm: em++ not found; using prebuilt artifacts in src/wasm/generated" >&2
+    exit 0
+  fi
+  echo "build-wasm: em++ (Emscripten) is required to build the WebAssembly module" >&2
+  exit 1
+fi
+
+case "$PROFILE" in
+  release)
+    COMPILE_FLAGS=(-O3 -flto)
+    LINK_FLAGS=(-O3 -flto)
+    ;;
+  debug)
+    COMPILE_FLAGS=(-g)
+    LINK_FLAGS=(-g -sASSERTIONS)
+    ;;
+  *)
+    echo "build-wasm: unknown profile '$PROFILE' (expected release or debug)" >&2
+    exit 1
+    ;;
+esac
+
+mkdir -p "$OBJ_DIR" "$OUT_DIR"
+
+# Separate compilation: C++ source -> object file.
+em++ -c "$SRC_DIR/smallpt.cpp" -o "$OBJ_DIR/smallpt.o" \
+  -std=c++17 -Werror -Wall "${COMPILE_FLAGS[@]}"
+
+# Link into an ES6 module for a module Web Worker. The JS glue is minified by
+# Vite during `astro build`, so --closure is not used here.
+em++ "$OBJ_DIR/smallpt.o" -o "$OUT_JS" \
+  "${LINK_FLAGS[@]}" \
+  -Werror -Wall \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sENVIRONMENT=worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sEXPORTED_FUNCTIONS=_render,_malloc,_free \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8,HEAPF64
+
+echo "build-wasm: built $PROFILE module -> ${OUT_JS#"$ROOT/"}"
diff --git a/src/components/SmallptRender.tsx b/src/components/SmallptRender.tsx
new file mode 100644
index 0000000..92a843b
--- /dev/null
+++ b/src/components/SmallptRender.tsx
@@ -0,0 +1,127 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import {
+  SMALLPT_COLOR_COUNT,
+  type SmallptRenderRequest,
+  type SmallptWorkerResponse,
+} from '../workers/smallpt-protocol';
+
+const WIDTH = 240;
+const HEIGHT = 180;
+/** Samples per sub-pixel (4 sub-pixels per pixel => 24 samples per pixel). */
+const SAMPLES = 6;
+
+type Status =
+  | { kind: 'rendering' }
+  | { kind: 'done'; durationMs: number }
+  | { kind: 'error'; message: string };
+
+function randomColors(): number[] {
+  const colors: number[] = [];
+  for (let i = 0; i < SMALLPT_COLOR_COUNT; i++) {
+    // Random hue with moderate saturation so the scene stays well lit.
+    const h = Math.random();
+    const s = 0.4 + Math.random() * 0.5;
+    const v = 0.65 + Math.random() * 0.3;
+    colors.push(...hsvToRgb(h, s, v));
+  }
+  return colors;
+}
+
+function hsvToRgb(h: number, s: number, v: number): [number, number, number] {
+  const i = Math.floor(h * 6);
+  const f = h * 6 - i;
+  const p = v * (1 - s);
+  const q = v * (1 - f * s);
+  const t = v * (1 - (1 - f) * s);
+  switch (i % 6) {
+    case 0: return [v, t, p];
+    case 1: return [q, v, p];
+    case 2: return [p, v, t];
+    case 3: return [p, q, v];
+    case 4: return [t, p, v];
+    default: return [v, p, q];
+  }
+}
+
+export default function SmallptRender() {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const requestIdRef = useRef(0);
+  const [status, setStatus] = useState<Status>({ kind: 'rendering' });
+
+  const requestRender = useCallback((colors: number[] | null) => {
+    const worker = workerRef.current;
+    if (!worker) return;
+    const id = ++requestIdRef.current;
+    setStatus({ kind: 'rendering' });
+    const req: SmallptRenderRequest = {
+      type: 'render',
+      id,
+      width: WIDTH,
+      height: HEIGHT,
+      samples: SAMPLES,
+      seed: Math.floor(Math.random() * 0xffffffff),
+      colors,
+    };
+    worker.postMessage(req);
+  }, []);
+
+  useEffect(() => {
+    const worker = new Worker(new URL('../workers/smallpt.worker.ts', import.meta.url), {
+      type: 'module',
+    });
+    workerRef.current = worker;
+
+    worker.addEventListener('message', (event: MessageEvent<SmallptWorkerResponse>) => {
+      const msg = event.data;
+      if (msg.id !== requestIdRef.current) return; // stale result
+      if (msg.type === 'error') {
+        setStatus({ kind: 'error', message: msg.message });
+        return;
+      }
+      const ctx = canvasRef.current?.getContext('2d');
+      if (ctx) ctx.putImageData(new ImageData(msg.pixels, msg.width, msg.height), 0, 0);
+      setStatus({ kind: 'done', durationMs: msg.durationMs });
+    });
+    worker.addEventListener('error', (event) => {
+      setStatus({ kind: 'error', message: event.message || 'Worker failed to load' });
+    });
+
+    requestRender(null);
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, [requestRender]);
+
+  const rendering = status.kind === 'rendering';
+
+  return (
+    <figure className="flex flex-col items-center gap-3">
+      <canvas
+        ref={canvasRef}
+        width={WIDTH}
+        height={HEIGHT}
+        className="w-full max-w-md bg-gray-900"
+        style={{ aspectRatio: `${WIDTH} / ${HEIGHT}`, imageRendering: 'auto' }}
+        role="img"
+        aria-label="Path-traced Cornell box with a mirror sphere and a glass sphere, rendered by smallpt"
+      />
+      <figcaption className="text-sm text-gray-600" aria-live="polite">
+        {status.kind === 'rendering' && 'Rendering with smallpt (WebAssembly)…'}
+        {status.kind === 'done' &&
+          `Rendered ${WIDTH}×${HEIGHT} at ${SAMPLES * 4} samples/pixel in ${(status.durationMs / 1000).toFixed(2)}s`}
+        {status.kind === 'error' && `Render failed: ${status.message}`}
+      </figcaption>
+      <button
+        type="button"
+        onClick={() => requestRender(randomColors())}
+        disabled={rendering}
+        className="px-4 py-2 bg-gray-900 text-white text-sm font-semibold hover:bg-amber-400 hover:text-gray-900 disabled:opacity-50 disabled:cursor-wait"
+      >
+        Render again with random colors
+      </button>
+    </figure>
+  );
+}
