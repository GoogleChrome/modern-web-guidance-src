new file mode 100644
index 0000000..6c0b63f
--- /dev/null
+++ b/wasm/smallpt/smallpt.cpp
@@ -0,0 +1,208 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008
+// http://www.kevinbeason.com/smallpt/  (MIT License, see LICENSE.txt alongside)
+//
+// Adapted for WebAssembly:
+//  - Exposes a single `render` entry point that fills a whole RGBA8 buffer in
+//    linear memory per call (no per-pixel JS <-> Wasm boundary crossings).
+//  - The recursive `radiance` function is rewritten as an iterative loop so it
+//    cannot overflow Emscripten's small default stack.
+//  - erand48 is replaced with a small self-contained xorshift PRNG.
+//  - Diffuse colors of the scene's spheres can be supplied by the caller.
+
+#include <cmath>
+#include <cstdint>
+#include <emscripten/emscripten.h>
+
+namespace {
+
+constexpr double kPi = 3.14159265358979323846;
+
+struct Vec {
+  double x, y, z;
+  constexpr Vec(double x_ = 0, double y_ = 0, double z_ = 0) : x(x_), y(y_), z(z_) {}
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec &norm() { return *this = *this * (1 / std::sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(const Vec &b) const {
+    return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x);
+  }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  double intersect(const Ray &r) const {
+    Vec op = p - r.o;
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0;
+    det = std::sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+constexpr int kNumSpheres = 9;
+
+// Default Cornell box scene from the original smallpt.
+const Sphere kDefaultSpheres[kNumSpheres] = {
+    {1e5, Vec(1e5 + 1, 40.8, 81.6), Vec(), Vec(.75, .25, .25), DIFF},    // Left
+    {1e5, Vec(-1e5 + 99, 40.8, 81.6), Vec(), Vec(.25, .25, .75), DIFF},  // Right
+    {1e5, Vec(50, 40.8, 1e5), Vec(), Vec(.75, .75, .75), DIFF},          // Back
+    {1e5, Vec(50, 40.8, -1e5 + 170), Vec(), Vec(), DIFF},                // Front
+    {1e5, Vec(50, 1e5, 81.6), Vec(), Vec(.75, .75, .75), DIFF},          // Bottom
+    {1e5, Vec(50, -1e5 + 81.6, 81.6), Vec(), Vec(.75, .75, .75), DIFF},  // Top
+    {16.5, Vec(27, 16.5, 47), Vec(), Vec(1, 1, 1) * .999, SPEC},         // Mirror
+    {16.5, Vec(73, 16.5, 78), Vec(), Vec(1, 1, 1) * .999, REFR},         // Glass
+    {600, Vec(50, 681.6 - .27, 81.6), Vec(12, 12, 12), Vec(), DIFF},     // Light
+};
+
+Sphere spheres[kNumSpheres];
+
+struct Rng {
+  uint64_t s;
+  explicit Rng(uint64_t seed) : s(seed ? seed : 0x9E3779B97F4A7C15ull) {}
+  double next() {
+    s ^= s << 13;
+    s ^= s >> 7;
+    s ^= s << 17;
+    return static_cast<double>(s >> 11) * (1.0 / 9007199254740992.0);
+  }
+};
+
+inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+inline int toInt(double x) { return static_cast<int>(std::pow(clamp(x), 1 / 2.2) * 255 + .5); }
+
+inline bool intersect(const Ray &r, double &t, int &id) {
+  double d, inf = t = 1e20;
+  for (int i = kNumSpheres; i--;) {
+    if ((d = spheres[i].intersect(r)) && d < t) {
+      t = d;
+      id = i;
+    }
+  }
+  return t < inf;
+}
+
+// Iterative version of smallpt's recursive radiance(). The recursive glass
+// branch that splits into both reflection and refraction at shallow depths is
+// replaced by Russian-roulette selection, which is unbiased.
+Vec radiance(Ray r, Rng &rng) {
+  Vec acc;
+  Vec throughput(1, 1, 1);
+  for (int depth = 0;; ++depth) {
+    double t;
+    int id = 0;
+    if (!intersect(r, t, id)) return acc;
+    const Sphere &obj = spheres[id];
+    Vec x = r.o + r.d * t, n = (x - obj.p).norm(), nl = n.dot(r.d) < 0 ? n : n * -1, f = obj.c;
+    acc = acc + throughput.mult(obj.e);
+    double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+    if (depth + 1 > 5) {
+      if (rng.next() < p && depth < 64)
+        f = f * (1 / p);
+      else
+        return acc;
+    }
+    throughput = throughput.mult(f);
+
+    if (obj.refl == DIFF) {
+      double r1 = 2 * kPi * rng.next(), r2 = rng.next(), r2s = std::sqrt(r2);
+      Vec w = nl, u = ((std::fabs(w.x) > .1 ? Vec(0, 1) : Vec(1)) % w).norm(), v = w % u;
+      Vec d = (u * std::cos(r1) * r2s + v * std::sin(r1) * r2s + w * std::sqrt(1 - r2)).norm();
+      r = Ray(x, d);
+      continue;
+    }
+    if (obj.refl == SPEC) {
+      r = Ray(x, r.d - n * 2 * n.dot(r.d));
+      continue;
+    }
+    Ray reflRay(x, r.d - n * 2 * n.dot(r.d));
+    bool into = n.dot(nl) > 0;
+    double nc = 1, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+    if ((cos2t = 1 - nnt * nnt * (1 - ddn * ddn)) < 0) {
+      r = reflRay;
+      continue;
+    }
+    Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + std::sqrt(cos2t)))).norm();
+    double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1 - (into ? -ddn : tdir.dot(n));
+    double Re = R0 + (1 - R0) * c * c * c * c * c, Tr = 1 - Re, P = .25 + .5 * Re, RP = Re / P,
+           TP = Tr / (1 - P);
+    if (rng.next() < P) {
+      throughput = throughput * RP;
+      r = reflRay;
+    } else {
+      throughput = throughput * TP;
+      r = Ray(x, tdir);
+    }
+  }
+}
+
+}  // namespace
+
+extern "C" {
+
+// Renders the smallpt scene into `out` (w * h * 4 bytes, RGBA8, top row first).
+// `samples` is the number of samples per sub-pixel (smallpt uses 2x2 sub-pixels,
+// so total samples per pixel is 4 * samples).
+// `colors` is either null (use the default scene colors) or points to
+// 7 * 3 = 21 doubles in [0, 1] giving the diffuse RGB colors of:
+// left wall, right wall, back wall, floor, ceiling, mirror ball, glass ball.
+// Returns 0 on success, non-zero on invalid arguments.
+EMSCRIPTEN_KEEPALIVE
+int render(uint8_t *out, int w, int h, int samples, uint32_t seed, const double *colors) {
+  if (!out || w <= 0 || h <= 0 || samples <= 0) return 1;
+
+  for (int i = 0; i < kNumSpheres; ++i) spheres[i] = kDefaultSpheres[i];
+  if (colors) {
+    static const int kColoredIds[] = {0, 1, 2, 4, 5, 6, 7};
+    for (int k = 0; k < 7; ++k) {
+      const double *c = colors + k * 3;
+      // Keep materials energy-conserving (< 1) so Russian roulette terminates.
+      Vec col(clamp(c[0]) * .999, clamp(c[1]) * .999, clamp(c[2]) * .999);
+      spheres[kColoredIds[k]].c = col;
+    }
+  }
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * .5135 / h), cy = (cx % cam.d).norm() * .5135;
+  Rng rng(static_cast<uint64_t>(seed) * 0x2545F4914F6CDD1Dull + 1);
+
+  for (int y = 0; y < h; ++y) {
+    for (int x = 0; x < w; ++x) {
+      Vec c;
+      for (int sy = 0; sy < 2; ++sy) {
+        for (int sx = 0; sx < 2; ++sx) {
+          Vec r;
+          for (int s = 0; s < samples; ++s) {
+            double r1 = 2 * rng.next(), dx = r1 < 1 ? std::sqrt(r1) - 1 : 1 - std::sqrt(2 - r1);
+            double r2 = 2 * rng.next(), dy = r2 < 1 ? std::sqrt(r2) - 1 : 1 - std::sqrt(2 - r2);
+            // smallpt's y axis points up; flip so row 0 is the top of the image.
+            int py = h - 1 - y;
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + py) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), rng) * (1. / samples);
+          }
+          c = c + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      uint8_t *px = out + (static_cast<size_t>(y) * w + x) * 4;
+      px[0] = static_cast<uint8_t>(toInt(c.x));
+      px[1] = static_cast<uint8_t>(toInt(c.y));
+      px[2] = static_cast<uint8_t>(toInt(c.z));
+      px[3] = 255;
+    }
+  }
+  return 0;
+}
+
+}  // extern "C"
