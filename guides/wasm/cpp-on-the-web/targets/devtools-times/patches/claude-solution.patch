new file mode 100644
index 0000000..ab506bf
--- /dev/null
+++ b/src/wasm/generated/smallpt.d.ts
@@ -0,0 +1,28 @@
+// Type declarations for the Emscripten-generated ES6 module produced by
+// scripts/build-wasm.sh from wasm/smallpt/smallpt.cpp.
+
+export interface SmallptModule {
+  /**
+   * Renders the scene into `outPtr` (w * h * 4 bytes, RGBA8).
+   * `colorsPtr` is 0 for default colors, or points to 21 doubles (7 RGB triples).
+   * Returns 0 on success.
+   */
+  _render(
+    outPtr: number,
+    width: number,
+    height: number,
+    samples: number,
+    seed: number,
+    colorsPtr: number,
+  ): number;
+  _malloc(size: number): number;
+  _free(ptr: number): void;
+  HEAPU8: Uint8Array;
+  HEAPF64: Float64Array;
+}
+
+declare const createSmallptModule: (
+  moduleOverrides?: Record<string, unknown>,
+) => Promise<SmallptModule>;
+
+export default createSmallptModule;
