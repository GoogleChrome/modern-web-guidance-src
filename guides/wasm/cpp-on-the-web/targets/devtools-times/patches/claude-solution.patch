new file mode 100644
index 0000000..78865d6
--- /dev/null
+++ b/src/wasm/image-gen/image_gen.cpp
@@ -0,0 +1,96 @@
+// Procedural fractal image generator compiled to WebAssembly with Emscripten.
+//
+// Rebuild with `npm run build:wasm` (see scripts/build-wasm.sh). The compiled
+// output (public/wasm/image-gen.mjs + image-gen.wasm) is checked in so the
+// site does not need Emscripten installed to run `astro build`.
+
+#include <cstdint>
+#include <cstdlib>
+#include <emscripten/emscripten.h>
+
+extern "C" {
+
+static uint8_t* g_buffer = nullptr;
+static int g_buffer_width = 0;
+static int g_buffer_height = 0;
+
+// Ensures a pixel buffer (RGBA8, width * height * 4 bytes) of the requested
+// size is available and returns a pointer to it so JS can read it out of
+// wasm memory once generate_image() has populated it.
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_buffer(int width, int height) {
+  if (g_buffer != nullptr &&
+      (g_buffer_width != width || g_buffer_height != height)) {
+    free(g_buffer);
+    g_buffer = nullptr;
+  }
+
+  g_buffer_width = width;
+  g_buffer_height = height;
+
+  if (g_buffer == nullptr) {
+    g_buffer = static_cast<uint8_t*>(malloc(static_cast<size_t>(width) *
+                                             static_cast<size_t>(height) * 4));
+  }
+
+  return g_buffer;
+}
+
+// Renders a Julia-set fractal into the shared pixel buffer. `seed` drives the
+// complex constant and color palette so every call produces a distinct image.
+EMSCRIPTEN_KEEPALIVE
+void generate_image(int width, int height, uint32_t seed) {
+  uint8_t* buffer = get_buffer(width, height);
+  if (buffer == nullptr) {
+    return;
+  }
+
+  // Simple xorshift PRNG seeded per-call, kept deterministic for a given seed.
+  uint32_t rng = seed == 0 ? 1 : seed;
+  auto next_rand = [&rng]() -> uint32_t {
+    rng ^= rng << 13;
+    rng ^= rng >> 17;
+    rng ^= rng << 5;
+    return rng;
+  };
+
+  const double cReal = -0.8 + (static_cast<double>(next_rand() % 1000) / 1000.0 - 0.5) * 0.6;
+  const double cImag = 0.156 + (static_cast<double>(next_rand() % 1000) / 1000.0 - 0.5) * 0.6;
+  const int hueShift = static_cast<int>(next_rand() % 256);
+  const int maxIterations = 220;
+
+  for (int py = 0; py < height; py++) {
+    for (int px = 0; px < width; px++) {
+      double x = (px - width / 2.0) * (3.0 / width);
+      double y = (py - height / 2.0) * (3.0 / height);
+
+      int iteration = 0;
+      while (x * x + y * y <= 4.0 && iteration < maxIterations) {
+        double xTemp = x * x - y * y + cReal;
+        y = 2.0 * x * y + cImag;
+        x = xTemp;
+        iteration++;
+      }
+
+      int index = (py * width + px) * 4;
+      if (iteration == maxIterations) {
+        buffer[index + 0] = 8;
+        buffer[index + 1] = 8;
+        buffer[index + 2] = 16;
+        buffer[index + 3] = 255;
+      } else {
+        double t = static_cast<double>(iteration) / maxIterations;
+        int r = static_cast<int>(9.0 * (1.0 - t) * t * t * t * 255.0);
+        int g = static_cast<int>(15.0 * (1.0 - t) * (1.0 - t) * t * t * 255.0);
+        int b = static_cast<int>(8.5 * (1.0 - t) * (1.0 - t) * (1.0 - t) * t * 255.0);
+
+        buffer[index + 0] = static_cast<uint8_t>((r + hueShift) % 256);
+        buffer[index + 1] = static_cast<uint8_t>((g + hueShift / 2) % 256);
+        buffer[index + 2] = static_cast<uint8_t>((b + hueShift / 3) % 256);
+        buffer[index + 3] = 255;
+      }
+    }
+  }
+}
+
+}  // extern "C"
