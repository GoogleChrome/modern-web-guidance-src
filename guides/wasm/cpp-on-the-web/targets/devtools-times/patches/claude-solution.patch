--- /dev/null
+++ b/src/workers/image-gen.worker.ts
@@ -0,0 +1,83 @@
+// Runs the image-gen WebAssembly module off the main thread so generating a
+// new image never blocks page interactivity (hover states, clicks, etc).
+
+interface ImageGenModule {
+  HEAPU8: Uint8Array;
+  cwrap: (
+    ident: string,
+    returnType: string | null,
+    argTypes: string[]
+  ) => (...args: number[]) => number;
+}
+
+type WorkerRequest =
+  | { type: 'init'; wasmUrl: string }
+  | { type: 'generate'; requestId: number; width: number; height: number; seed: number };
+
+type WorkerResponse =
+  | { type: 'ready' }
+  | { type: 'result'; requestId: number; width: number; height: number; pixels: ArrayBuffer }
+  | { type: 'error'; message: string; requestId?: number };
+
+let modulePromise: Promise<ImageGenModule> | null = null;
+let generateImage: ((width: number, height: number, seed: number) => void) | null = null;
+let getBuffer: ((width: number, height: number) => number) | null = null;
+
+async function loadModule(wasmUrl: string): Promise<ImageGenModule> {
+  const createImageGenModule = (await import(/* @vite-ignore */ wasmUrl)).default as (
+    args?: Record<string, unknown>
+  ) => Promise<ImageGenModule>;
+  return createImageGenModule();
+}
+
+self.onmessage = async (event: MessageEvent<WorkerRequest>) => {
+  const message = event.data;
+
+  try {
+    if (message.type === 'init') {
+      modulePromise ??= loadModule(message.wasmUrl);
+      const wasmModule = await modulePromise;
+      generateImage = wasmModule.cwrap('generate_image', null, ['number', 'number', 'number']) as (
+        width: number,
+        height: number,
+        seed: number
+      ) => void;
+      getBuffer = wasmModule.cwrap('get_buffer', 'number', ['number', 'number']) as (
+        width: number,
+        height: number
+      ) => number;
+      const ready: WorkerResponse = { type: 'ready' };
+      self.postMessage(ready);
+      return;
+    }
+
+    if (message.type === 'generate') {
+      if (!modulePromise || !generateImage || !getBuffer) {
+        throw new Error('WebAssembly module has not been initialized yet.');
+      }
+
+      const wasmModule = await modulePromise;
+      const { width, height, seed, requestId } = message;
+
+      generateImage(width, height, seed);
+      const bufferPointer = getBuffer(width, height);
+      const pixels = wasmModule.HEAPU8.slice(bufferPointer, bufferPointer + width * height * 4);
+
