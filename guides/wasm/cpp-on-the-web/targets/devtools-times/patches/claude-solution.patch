+++ b/wasm/smallpt/build.sh
@@ -0,0 +1,20 @@
+#!/bin/sh
+# Builds smallpt to WebAssembly. Requires the Emscripten SDK (em++ on PATH).
+# Output goes to public/smallpt/ and is served as a static asset.
+set -eu
+cd "$(dirname "$0")"
+OUT=../../public/smallpt
+mkdir -p "$OUT"
+em++ smallpt.cpp -o "$OUT/smallpt.js" \
+  -O3 -flto -fno-exceptions -fno-rtti \
+  -sSTRICT \
+  -sEXPORT_ES6 \
+  -sEXPORT_NAME=createSmallpt \
+  -sENVIRONMENT=web,worker \
+  -sALLOW_MEMORY_GROWTH \
+  -sSTACK_SIZE=8MB \
+  -sFILESYSTEM=0 \
+  -sEXPORTED_RUNTIME_METHODS=HEAPU8 \
+  --no-entry \
+  "$@"
+ls -la "$OUT"
