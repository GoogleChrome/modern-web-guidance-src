diff --git a/src/workers/smallpt-protocol.ts b/src/workers/smallpt-protocol.ts
new file mode 100644
index 0000000..b38f072
--- /dev/null
+++ b/src/workers/smallpt-protocol.ts
@@ -0,0 +1,25 @@
+/** Number of RGB colors accepted by the renderer: left, right, back, floor, ceiling, mirror, glass. */
+export const SMALLPT_COLOR_COUNT = 7;
+
+export interface SmallptRenderRequest {
+  type: 'render';
+  id: number;
+  width: number;
+  height: number;
+  /** Samples per sub-pixel; total samples per pixel is 4x this. */
+  samples: number;
+  seed: number;
+  /** Flat array of SMALLPT_COLOR_COUNT * 3 values in [0, 1], or null for the default scene. */
+  colors: number[] | null;
+}
+
+export type SmallptWorkerResponse =
+  | {
+      type: 'done';
+      id: number;
+      width: number;
+      height: number;
+      pixels: Uint8ClampedArray<ArrayBuffer>;
+      durationMs: number;
+    }
+  | { type: 'error'; id: number; message: string };
diff --git a/src/workers/smallpt.worker.ts b/src/workers/smallpt.worker.ts
new file mode 100644
index 0000000..86566c7
--- /dev/null
+++ b/src/workers/smallpt.worker.ts
@@ -0,0 +1,68 @@
+/// <reference lib="webworker" />
+// Runs the smallpt WebAssembly path tracer off the main thread.
+import createSmallptModule, { type SmallptModule } from '../wasm/generated/smallpt.js';
+import {
+  SMALLPT_COLOR_COUNT,
+  type SmallptRenderRequest,
+  type SmallptWorkerResponse,
+} from './smallpt-protocol';
+
+declare const self: DedicatedWorkerGlobalScope;
+
+let modulePromise: Promise<SmallptModule> | null = null;
+
+function getModule(): Promise<SmallptModule> {
+  modulePromise ??= createSmallptModule();
+  return modulePromise;
+}
+
+function post(message: SmallptWorkerResponse, transfer: Transferable[] = []): void {
+  self.postMessage(message, transfer);
+}
+
+async function handleRender(req: SmallptRenderRequest): Promise<void> {
+  const wasm = await getModule();
+  const byteLength = req.width * req.height * 4;
+  const colorCount = SMALLPT_COLOR_COUNT * 3;
+
+  const outPtr = wasm._malloc(byteLength);
+  const colorsPtr = req.colors ? wasm._malloc(colorCount * Float64Array.BYTES_PER_ELEMENT) : 0;
+  if (!outPtr || (req.colors && !colorsPtr)) {
+    if (outPtr) wasm._free(outPtr);
+    if (colorsPtr) wasm._free(colorsPtr);
+    throw new Error('Out of WebAssembly memory');
+  }
+
+  try {
+    if (req.colors) {
+      if (req.colors.length !== colorCount) {
+        throw new Error(`Expected ${colorCount} color components, got ${req.colors.length}`);
+      }
+      // Read HEAPF64 after malloc, since memory growth replaces the view.
+      wasm.HEAPF64.set(req.colors, colorsPtr / Float64Array.BYTES_PER_ELEMENT);
+    }
+
+    const start = performance.now();
+    const status = wasm._render(outPtr, req.width, req.height, req.samples, req.seed >>> 0, colorsPtr);
+    const durationMs = performance.now() - start;
+    if (status !== 0) throw new Error(`render() failed with status ${status}`);
+
+    // Read HEAPU8 fresh after the call (memory may have grown) and copy out.
+    const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, outPtr, byteLength).slice();
+    post(
+      { type: 'done', id: req.id, width: req.width, height: req.height, pixels, durationMs },
+      [pixels.buffer],
+    );
+  } finally {
+    wasm._free(outPtr);
+    if (colorsPtr) wasm._free(colorsPtr);
+  }
+}
+
+self.addEventListener('message', (event: MessageEvent<SmallptRenderRequest>) => {
+  const req = event.data;
+  if (req?.type !== 'render') return;
+  handleRender(req).catch((err: unknown) => {
+    post({ type: 'error', id: req.id, message: err instanceof Error ? err.message : String(err) });
+  });
+});
