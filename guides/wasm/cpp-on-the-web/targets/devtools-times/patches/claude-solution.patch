index 0000000..6044f1d
--- /dev/null
+++ b/public/smallpt/smallpt-worker.js
@@ -0,0 +1,37 @@
+// Web Worker that drives the smallpt WebAssembly module off the main thread.
+// Protocol:
+//   main -> worker: { type: 'render', jobId, width, height, spp, seed, colors: [[r,g,b], ...] }
+//   worker -> main: { type: 'ready', spheres }
+//                   { type: 'rows', jobId, row, rows, pixels }   (RGBA8, transferred)
+//                   { type: 'done', jobId, ms }
+//                   { type: 'error', jobId, message }
+import createSmallpt from './smallpt.js';
+
+const ROWS_PER_CHUNK = 8;
+const modulePromise = createSmallpt();
+
+modulePromise
+  .then((M) => self.postMessage({ type: 'ready', spheres: M._sphere_count() }))
+  .catch((e) => self.postMessage({ type: 'error', message: String(e?.message ?? e) }));
+
+self.onmessage = async (event) => {
+  const { type, jobId, width, height, spp, seed, colors } = event.data;
+  if (type !== 'render') return;
+  try {
+    const M = await modulePromise;
+    colors.forEach(([r, g, b], i) => M._set_sphere_color(i, r, g, b));
+    const t0 = performance.now();
+    M._begin_render(width, height, spp, seed | 0);
+    for (let row = 0; row < height; row += ROWS_PER_CHUNK) {
+      const rows = Math.min(ROWS_PER_CHUNK, height - row);
+      M._render_rows(row, row + rows);
+      // Re-read HEAPU8 after every call: ALLOW_MEMORY_GROWTH can swap the buffer.
+      const ptr = M._pixels() + row * width * 4;
+      const pixels = new Uint8ClampedArray(M.HEAPU8.buffer, ptr, rows * width * 4).slice();
+      self.postMessage({ type: 'rows', jobId, row, rows, pixels }, [pixels.buffer]);
+    }
+    self.postMessage({ type: 'done', jobId, ms: performance.now() - t0 });
+  } catch (e) {
+    self.postMessage({ type: 'error', jobId, message: String(e?.message ?? e) });
+  }
+};
