index 0000000..39aff97
--- /dev/null
+++ b/src/components/SmallptDemo.tsx
@@ -0,0 +1,182 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+// smallpt's scene: indices into the `spheres[]` array in wasm/smallpt/smallpt.cpp.
+const SPHERE_NAMES = ['Left wall', 'Right wall', 'Back wall', 'Front wall', 'Floor', 'Ceiling', 'Mirror ball', 'Glass ball', 'Light'];
+const DEFAULT_COLORS: Color[] = [
+  [0.75, 0.25, 0.25], [0.25, 0.25, 0.75], [0.75, 0.75, 0.75], [0, 0, 0],
+  [0.75, 0.75, 0.75], [0.75, 0.75, 0.75], [0.999, 0.999, 0.999], [0.999, 0.999, 0.999], [0, 0, 0],
+];
+const WIDTH = 480;
+const HEIGHT = 360;
+const SPP = 16; // samples per pixel (smallpt uses 2x2 sub-pixels, so a multiple of 4)
+
+type Color = [number, number, number];
+type Phase = 'loading' | 'idle' | 'rendering' | 'error';
+
+type WorkerMessage =
+  | { type: 'ready'; spheres: number }
+  | { type: 'rows'; jobId: number; row: number; rows: number; pixels: Uint8ClampedArray<ArrayBuffer> }
+  | { type: 'done'; jobId: number; ms: number }
+  | { type: 'error'; jobId?: number; message: string };
+
+function hslToRgb(h: number, s: number, l: number): Color {
+  const k = (n: number) => (n + h / 30) % 12;
+  const a = s * Math.min(l, 1 - l);
+  const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
+  return [f(0), f(8), f(4)];
+}
+
+// Random albedos: saturated mid-tones for the diffuse walls, bright tints for the
+// mirror and glass balls. Kept below 1.0 so the path tracer stays energy-conserving.
+function randomColors(): Color[] {
+  return DEFAULT_COLORS.map((c, i) => {
+    if (i === 8) return c; // the light's colour stays black; it only emits
+    const hue = Math.random() * 360;
+    if (i === 6 || i === 7) return hslToRgb(hue, 0.4 + Math.random() * 0.4, 0.82 + Math.random() * 0.12);
+    return hslToRgb(hue, 0.5 + Math.random() * 0.45, 0.4 + Math.random() * 0.3);
+  });
+}
+
+function toCss([r, g, b]: Color): string {
+  const c = (v: number) => Math.round(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255);
+  return `rgb(${c(r)} ${c(g)} ${c(b)})`;
+}
+
+export default function SmallptDemo() {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const jobRef = useRef(0);
+  const [phase, setPhase] = useState<Phase>('loading');
+  const [progress, setProgress] = useState(0);
+  const [elapsedMs, setElapsedMs] = useState<number | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [colors, setColors] = useState<Color[]>(DEFAULT_COLORS);
+  const base = import.meta.env.BASE_URL;
+
+  // Spawn the worker and, once its wasm module is ready, render `initialColors`.
+  // Rendering happens in a synchronous loop inside the worker, so cancelling a
+  // job means terminating that worker and starting a fresh one.
+  const spawnWorker = useCallback((initialColors: Color[]) => {
+    workerRef.current?.terminate();
+    const worker = new Worker(`${base}smallpt/smallpt-worker.js`, { type: 'module' });
+    workerRef.current = worker;
+    setPhase('loading');
+    setProgress(0);
+    setElapsedMs(null);
+    setColors(initialColors);
+
+    const paintBlack = () => {
+      const ctx = canvasRef.current?.getContext('2d');
+      if (!ctx) return;
+      ctx.fillStyle = '#111';
+      ctx.fillRect(0, 0, WIDTH, HEIGHT);
+    };
+
+    worker.onmessage = (event: MessageEvent<WorkerMessage>) => {
+      const msg = event.data;
+      if (msg.type === 'ready') {
+        paintBlack();
+        const jobId = ++jobRef.current;
+        setPhase('rendering');
+        worker.postMessage({
+          type: 'render',
+          jobId,
+          width: WIDTH,
+          height: HEIGHT,
+          spp: SPP,
+          seed: Math.floor(Math.random() * 0xffff),
+          colors: initialColors,
+        });
+        return;
+      }
+      if (msg.type === 'error') {
+        setPhase('error');
+        setError(msg.message);
+        return;
+      }
+      if (msg.jobId !== jobRef.current) return; // stale job
+      if (msg.type === 'rows') {
+        const ctx = canvasRef.current?.getContext('2d');
+        if (ctx) ctx.putImageData(new ImageData(msg.pixels, WIDTH, msg.rows), 0, msg.row);
+        setProgress((msg.row + msg.rows) / HEIGHT);
+      } else if (msg.type === 'done') {
+        setPhase('idle');
+        setProgress(1);
+        setElapsedMs(msg.ms);
+      }
+    };
+    worker.onerror = (event) => {
+      setPhase('error');
+      setError(event.message || 'Failed to load the smallpt worker.');
+    };
+  }, [base]);
+
+  useEffect(() => {
+    if (typeof Worker === 'undefined' || typeof WebAssembly === 'undefined') {
+      setPhase('error');
+      setError('This browser does not support Web Workers or WebAssembly.');
+      return;
+    }
+    spawnWorker(DEFAULT_COLORS);
+    return () => {
+      workerRef.current?.terminate();
+      workerRef.current = null;
+    };
+  }, [spawnWorker]);
+
+  const busy = phase === 'rendering';
+  const status =
+    phase === 'loading' ? 'Loading WebAssembly module…'
+    : phase === 'error' ? `Error: ${error}`
+    : busy ? `Rendering ${WIDTH}×${HEIGHT} at ${SPP} spp… ${Math.round(progress * 100)}%`
+    : elapsedMs !== null ? `Rendered ${WIDTH}×${HEIGHT} at ${SPP} spp in ${(elapsedMs / 1000).toFixed(1)} s`
+    : 'Ready';
+
+  return (
+    <div className="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] items-start">
+      <div>
+        <canvas
+          ref={canvasRef}
+          width={WIDTH}
+          height={HEIGHT}
+          className="w-full h-auto bg-gray-900 rounded shadow"
+          aria-label="Path-traced Cornell box rendered by smallpt compiled to WebAssembly"
+        />
+        <div className="mt-3 h-1.5 w-full bg-gray-200 rounded overflow-hidden" aria-hidden="true">
+          <div
+            className="h-full bg-amber-400 transition-[width] duration-150"
+            style={{ width: `${Math.round(progress * 100)}%` }}
+          />
+        </div>
+        <p className="mt-2 text-sm text-gray-600" role="status" aria-live="polite">{status}</p>
+      </div>
+      <div className="space-y-4">
+        <button
+          type="button"
+          onClick={() => spawnWorker(randomColors())}
+          disabled={phase === 'error'}
+          className="w-full bg-gray-800 text-white text-sm font-semibold py-2.5 px-4 rounded hover:bg-gray-700 disabled:opacity-50 disabled:cursor-not-allowed"
+        >
+          {busy ? 'Restart with random colors' : 'Render again with random colors'}
+        </button>
+        <ul className="grid grid-cols-3 lg:grid-cols-2 gap-2 text-xs text-gray-700">
+          {colors.map((c, i) => (
+            <li key={SPHERE_NAMES[i]} className="flex items-center gap-2">
+              <span
+                className="inline-block w-5 h-5 rounded-full border border-gray-300 shrink-0"
+                style={{ background: i === 8 ? '#fffbe6' : toCss(c) }}
+                aria-hidden="true"
+              />
+              {SPHERE_NAMES[i]}
+            </li>
+          ))}
+        </ul>
+        <p className="text-xs text-gray-500">
+          Kevin Beason's <a className="underline hover:text-amber-500" href="http://www.kevinbeason.com/smallpt/">smallpt</a>,
+          99 lines of C++, compiled with Emscripten and running in a Web Worker. Light bounces are
+          sampled with Monte Carlo integration, so each run looks slightly different.
+        </p>
+      </div>
+    </div>
+  );
+}
