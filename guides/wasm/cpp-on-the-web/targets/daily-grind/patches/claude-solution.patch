+  <script type="module">
+    // Drives the smallpt WebAssembly path tracer (see smallpt/) from a pool of
+    // Web Workers and paints finished row bands onto the canvas as they arrive.
+    const WIDTH = 512, HEIGHT = 384, BAND_ROWS = 8, SPHERES = 9;
+    const canvas = document.getElementById('smallpt-canvas');
+    const button = document.getElementById('smallpt-rerender');
+    const quality = document.getElementById('smallpt-quality');
+    const status = document.getElementById('smallpt-status');
+    const ctx = canvas.getContext('2d');
+
+    const setStatus = (text) => { status.value = text; };
+
+    if (typeof WebAssembly !== 'object' || typeof Worker !== 'function') {
+      setStatus('This browser does not support WebAssembly workers.');
+    } else {
+      main().catch((err) => {
+        console.error(err);
+        setStatus('Could not start the path tracer: ' + (err && err.message ? err.message : err));
+      });
+    }
+
+    async function main() {
+      const poolSize = Math.max(1, Math.min(navigator.hardwareConcurrency || 2, 8));
+      const workerUrl = new URL('smallpt/worker.js', document.baseURI);
+      const workers = await Promise.all(Array.from({ length: poolSize }, () => spawn(workerUrl)));
+
+      let job = 0, queue = [], pending = 0, startedAt = 0;
+
+      for (const w of workers) {
+        w.onmessage = (event) => {
+          const m = event.data;
+          if (m.type === 'error') { setStatus('Render failed: ' + m.message); return; }
+          if (m.type !== 'rows' || m.job !== job) return; // stale band from a previous render
+          ctx.putImageData(new ImageData(m.pixels, WIDTH, m.rows), 0, m.top);
+          pending--;
+          if (pending === 0) {
+            const secs = ((performance.now() - startedAt) / 1000).toFixed(1);
+            setStatus(`Done: ${quality.value} spp in ${secs}s on ${workers.length} worker${workers.length === 1 ? '' : 's'}`);
+            button.disabled = false;
+          } else {
+            setStatus(`Rendering… ${Math.round(100 * (1 - pending / Math.ceil(HEIGHT / BAND_ROWS)))}%`);
+            dispatch(w);
+          }
+        };
+      }
+
+      function dispatch(w) {
+        if (queue.length === 0) return;
+        w.postMessage({ type: 'chunk', job, top: queue.shift(), rows: BAND_ROWS });
+      }
+
+      function render(colors, seed) {
+        job++;
+        queue = [];
+        for (let top = 0; top < HEIGHT; top += BAND_ROWS) queue.push(top);
+        pending = queue.length;
+        startedAt = performance.now();
+        button.disabled = true;
+        ctx.fillStyle = '#000';
+        ctx.fillRect(0, 0, WIDTH, HEIGHT);
+        setStatus('Rendering… 0%');
+        const spp = Number(quality.value);
+        for (const w of workers) {
+          w.postMessage({ type: 'setup', job, width: WIDTH, height: HEIGHT, spp, seed, colors });
+          dispatch(w);
+        }
+      }
+
+      button.addEventListener('click', () => render(randomColors(), Math.floor(Math.random() * 65536)));
+
+      // First render uses the original smallpt scene colors and RNG seed.
+      render(null, 0);
+    }
+
+    function spawn(url) {
+      return new Promise((resolve, reject) => {
+        const w = new Worker(url, { type: 'module' });
+        w.onmessage = (event) => {
+          if (event.data.type === 'ready') resolve(w);
+          else if (event.data.type === 'error') reject(new Error(event.data.message));
+        };
+        w.onerror = (event) => reject(new Error(event.message || 'worker failed to load'));
+      });
+    }
+
+    // Random surface colors for the scene's spheres as a flat [r,g,b,...] array.
+    // Spheres 0-5 are the walls, 6 is the mirror ball, 7 the glass ball; the
+    // light (8) keeps a black surface so it stays a pure emitter.
+    function randomColors() {
+      const out = new Float64Array(SPHERES * 3);
+      for (let i = 0; i < SPHERES - 1; i++) {
+        const shiny = i >= 6;
+        const h = Math.random();
+        const s = shiny ? 0.3 + Math.random() * 0.6 : 0.4 + Math.random() * 0.5;
+        const l = shiny ? 0.82 + Math.random() * 0.15 : 0.35 + Math.random() * 0.3;
+        out.set(hslToRgb(h, s, l), i * 3);
+      }
+      return out;
+    }
+
+    function hslToRgb(h, s, l) {
+      const k = (n) => (n + h * 12) % 12;
+      const a = s * Math.min(l, 1 - l);
+      const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
+      return [f(0), f(8), f(4)];
+    }
