+// Web Worker that drives one instance of the smallpt WebAssembly module off
+// the main thread. index.html spawns a pool of these and hands each one row
+// bands to render; smallpt seeds its RNG per row, so the result is identical
+// no matter how the rows are split between workers.
+//
+// Messages main -> worker:
+//   { type: 'setup', job, width, height, spp, seed, colors: Float64Array|null }
+//   { type: 'chunk', job, top, rows }        // top-down pixel rows [top, top+rows)
+// Messages worker -> main:
+//   { type: 'ready' }
+//   { type: 'rows', job, top, rows, pixels: Uint8ClampedArray }  (buffer transferred)
+//   { type: 'error', message }
+import createModule from './smallpt.js';
+
+const modulePromise = createModule();
+modulePromise.then(
+  () => postMessage({ type: 'ready' }),
+  (err) => postMessage({ type: 'error', message: String(err) }),
+);
+
+let cfg = null; // { job, width, height, spp, seed, base }
+
+self.onmessage = async (event) => {
+  const msg = event.data;
+  let M;
+  try {
+    M = await modulePromise;
+  } catch (err) {
+    postMessage({ type: 'error', message: String(err) });
+    return;
+  }
+
+  if (msg.type === 'setup') {
+    const { job, width, height, spp, seed, colors } = msg;
+    const base = M._init(width, height);
+    if (colors) {
+      const n = M._sphere_count() * 3;
+      const ptr = M._malloc(n * 8);
+      M.HEAPF64.set(colors.subarray(0, n), ptr / 8);
+      M._set_colors(ptr);
+      M._free(ptr);
+    } else {
+      M._reset_colors();
+    }
+    cfg = { job, width, height, spp, seed, base };
+    return;
+  }
+
+  if (msg.type === 'chunk') {
+    if (!cfg || cfg.job !== msg.job) return; // stale request from an old render
+    const { width, height, spp, seed, base } = cfg;
+    const top = msg.top;
+    const rows = Math.min(msg.rows, height - top);
+    // smallpt counts rows bottom-up; the module writes them top-down into the
+    // output buffer, so convert the requested band.
+    const y1 = height - top, y0 = y1 - rows;
+    M._render_rows(y0, y1, spp, seed);
+    // Re-read HEAPU8 after every call: it is replaced if memory grows.
+    const offset = base + top * width * 4;
+    const pixels = new Uint8ClampedArray(M.HEAPU8.slice(offset, offset + rows * width * 4).buffer);
+    postMessage({ type: 'rows', job: msg.job, top, rows, pixels }, [pixels.buffer]);
+  }
+};
