+      const rand = (min, max) => min + Math.random() * (max - min);
+      for (const i of DIFFUSE_WALLS) {
+        for (let c = 0; c < 3; c++) colors[i * 3 + c] = rand(0.1, 0.9);
+      }
+      for (const i of SHINY_SPHERES) {
