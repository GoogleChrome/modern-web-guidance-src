diff --git a/smallpt-worker.js b/smallpt-worker.js
new file mode 100644
index 0000000..044105c
--- /dev/null
+++ b/smallpt-worker.js
@@ -0,0 +1,43 @@
+// Module Web Worker that runs the smallpt path tracer (compiled to
+// WebAssembly with Emscripten) off the main thread.
+//
+// Request:  { id, width, height, samples, seed, colors: Float32Array | null }
+// Response: { id, pixels: Uint8ClampedArray, width, height, ms }
+//        or { id, error: string }
+import initSmallpt from './wasm/smallpt.js';
+
+const wasmReady = initSmallpt();
+
+self.addEventListener('message', async (event) => {
+  const { id, width, height, samples, seed, colors } = event.data;
+  try {
+    const wasm = await wasmReady;
+    const byteLength = width * height * 4;
+    const pixelPtr = wasm._malloc(byteLength);
+    const colorPtr = colors ? wasm._malloc(colors.byteLength) : 0;
+    if (!pixelPtr || (colors && !colorPtr)) {
+      throw new Error('Out of WebAssembly memory');
+    }
+
+    try {
+      if (colors) {
+        // Read HEAPF32 after malloc: memory growth replaces the old view.
+        wasm.HEAPF32.set(colors, colorPtr >> 2);
+      }
+
+      const start = performance.now();
+      // One call renders the whole frame into linear memory.
+      wasm._smallpt_render(pixelPtr, width, height, samples, seed >>> 0, colorPtr);
+      const ms = performance.now() - start;
+
+      // Read HEAPU8 fresh after the call and copy out before freeing.
+      const pixels = new Uint8ClampedArray(wasm.HEAPU8.buffer, pixelPtr, byteLength).slice();
+      self.postMessage({ id, pixels, width, height, ms }, [pixels.buffer]);
+    } finally {
+      wasm._free(pixelPtr);
+      if (colorPtr) wasm._free(colorPtr);
+    }
+  } catch (err) {
+    self.postMessage({ id, error: err instanceof Error ? err.message : String(err) });
+  }
+});
