index 0000000..46dc7f4
--- /dev/null
+++ b/smallpt/smallpt.cpp
@@ -0,0 +1,201 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008
+// http://www.kevinbeason.com/smallpt/  (MIT License, see LICENSE in this directory)
+//
+// Adapted for WebAssembly:
+//  - The recursive radiance() is rewritten as an iterative loop so it cannot
+//    overflow Emscripten's small default stack (64 KB).
+//  - Refraction picks a single reflect/refract path via Russian roulette
+//    instead of branching, which is what makes the loop form possible.
+//  - erand48() is replaced by a small self-contained xorshift RNG.
+//  - Instead of writing a PPM file, the whole image is rendered in a single
+//    exported call into a caller-provided RGBA buffer in linear memory, and
+//    sphere colors are supplied by the caller.
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <emscripten/emscripten.h>
+
+namespace {
+
+struct Vec {
+  double x, y, z;
+  explicit Vec(double x_ = 0, double y_ = 0, double z_ = 0) : x(x_), y(y_), z(z_) {}
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec &norm() { return *this = *this * (1 / std::sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(const Vec &b) const {
+    return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x);
+  }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  double intersect(const Ray &r) const {
+    Vec op = p - r.o;
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0;
+    det = std::sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+constexpr int kNumSpheres = 9;
+
+Sphere spheres[kNumSpheres] = {
+    // Scene: radius, position, emission, color, material
+    {1e5, Vec(1e5 + 1, 40.8, 81.6), Vec(), Vec(.75, .25, .25), DIFF},   // Left
+    {1e5, Vec(-1e5 + 99, 40.8, 81.6), Vec(), Vec(.25, .25, .75), DIFF}, // Right
+    {1e5, Vec(50, 40.8, 1e5), Vec(), Vec(.75, .75, .75), DIFF},         // Back
+    {1e5, Vec(50, 40.8, -1e5 + 170), Vec(), Vec(), DIFF},               // Front
+    {1e5, Vec(50, 1e5, 81.6), Vec(), Vec(.75, .75, .75), DIFF},         // Bottom
+    {1e5, Vec(50, -1e5 + 81.6, 81.6), Vec(), Vec(.75, .75, .75), DIFF}, // Top
+    {16.5, Vec(27, 16.5, 47), Vec(), Vec(1, 1, 1) * .999, SPEC},        // Mirror
+    {16.5, Vec(73, 16.5, 78), Vec(), Vec(1, 1, 1) * .999, REFR},        // Glass
+    {600, Vec(50, 681.6 - .27, 81.6), Vec(12, 12, 12), Vec(), DIFF},    // Light
+};
+
+// xorshift32: tiny, fast and good enough for Monte Carlo sampling.
+struct Rng {
+  uint32_t s;
+  explicit Rng(uint32_t seed) : s(seed ? seed : 0x9E3779B9u) {}
+  double operator()() {
+    s ^= s << 13;
+    s ^= s >> 17;
+    s ^= s << 5;
+    return (s >> 8) * (1.0 / 16777216.0); // [0, 1)
+  }
+};
+
+inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+inline uint8_t toInt(double x) {
+  return static_cast<uint8_t>(std::pow(clamp(x), 1 / 2.2) * 255 + .5);
+}
+
+inline bool intersect(const Ray &r, double &t, int &id) {
+  double d, inf = t = 1e20;
+  for (int i = kNumSpheres; i--;) {
+    if ((d = spheres[i].intersect(r)) && d < t) {
+      t = d;
+      id = i;
+    }
+  }
+  return t < inf;
+}
+
+constexpr int kMaxDepth = 64;
+
+Vec radiance(Ray r, Rng &rng) {
+  Vec cl(0, 0, 0); // accumulated radiance
+  Vec cf(1, 1, 1); // accumulated throughput
+  for (int depth = 1;; ++depth) {
+    double t;
+    int id = 0;
+    if (!intersect(r, t, id)) return cl;
+    const Sphere &obj = spheres[id];
+    Vec x = r.o + r.d * t, n = (x - obj.p).norm(), nl = n.dot(r.d) < 0 ? n : n * -1, f = obj.c;
+    double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z; // max reflectance
+    cl = cl + cf.mult(obj.e);
+    if (depth > kMaxDepth) return cl; // hard cap as a safety net
+    if (depth > 5) {                  // Russian roulette
+      if (rng() < p) f = f * (1 / p);
+      else return cl;
+    }
+    cf = cf.mult(f);
+    if (obj.refl == DIFF) { // Ideal diffuse reflection
+      double r1 = 2 * M_PI * rng(), r2 = rng(), r2s = std::sqrt(r2);
+      Vec w = nl, u = ((std::fabs(w.x) > .1 ? Vec(0, 1) : Vec(1)) % w).norm(), v = w % u;
+      Vec d = (u * std::cos(r1) * r2s + v * std::sin(r1) * r2s + w * std::sqrt(1 - r2)).norm();
+      r = Ray(x, d);
+      continue;
+    }
+    Ray reflRay(x, r.d - n * 2 * n.dot(r.d));
+    if (obj.refl == SPEC) { // Ideal specular reflection
+      r = reflRay;
+      continue;
+    }
+    // Ideal dielectric refraction
+    bool into = n.dot(nl) > 0; // Ray from outside going in?
+    double nc = 1, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+    if ((cos2t = 1 - nnt * nnt * (1 - ddn * ddn)) < 0) { // Total internal reflection
+      r = reflRay;
+      continue;
+    }
+    Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + std::sqrt(cos2t)))).norm();
+    double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1 - (into ? -ddn : tdir.dot(n));
+    double Re = R0 + (1 - R0) * c * c * c * c * c, Tr = 1 - Re, P = .25 + .5 * Re,
+           RP = Re / P, TP = Tr / (1 - P);
+    if (rng() < P) {
+      cf = cf * RP;
+      r = reflRay;
+    } else {
+      cf = cf * TP;
+      r = Ray(x, tdir);
+    }
+  }
+}
+
+} // namespace
+
+extern "C" {
+
+// Number of spheres in the scene; the colors buffer passed to smallpt_render
+// must hold 3 floats (r, g, b in [0, 1]) per sphere.
+EMSCRIPTEN_KEEPALIVE int smallpt_sphere_count() { return kNumSpheres; }
+
+// Renders the full w*h image in one call into `rgba` (w*h*4 bytes, top row
+// first). `samples` is the number of samples per subpixel (2x2 subpixels per
+// pixel). `colors` holds kNumSpheres RGB triples, or may be null to keep the
+// current colors.
+EMSCRIPTEN_KEEPALIVE void smallpt_render(uint8_t *rgba, int w, int h, int samples, uint32_t seed,
+                                         const float *colors) {
+  if (!rgba || w <= 0 || h <= 0 || samples <= 0) return;
+  if (colors) {
+    for (int i = 0; i < kNumSpheres; ++i) {
+      spheres[i].c = Vec(clamp(colors[i * 3]), clamp(colors[i * 3 + 1]), clamp(colors[i * 3 + 2]));
+    }
+  }
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm()); // camera position, direction
+  Vec cx = Vec(w * .5135 / h), cy = (cx % cam.d).norm() * .5135;
+  Rng rng(seed);
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      Vec c;
+      for (int sy = 0; sy < 2; sy++) {   // 2x2 subpixel rows
+        for (int sx = 0; sx < 2; sx++) { // 2x2 subpixel cols
+          Vec r;
+          for (int s = 0; s < samples; s++) {
+            double r1 = 2 * rng(), dx = r1 < 1 ? std::sqrt(r1) - 1 : 1 - std::sqrt(2 - r1);
+            double r2 = 2 * rng(), dy = r2 < 1 ? std::sqrt(r2) - 1 : 1 - std::sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            // Compute the origin before normalizing: Vec::norm() mutates in
+            // place and argument evaluation order is unspecified.
+            Vec origin = cam.o + d * 140;
+            r = r + radiance(Ray(origin, d.norm()), rng) * (1. / samples);
+          }
+          c = c + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      uint8_t *px = rgba + (static_cast<std::size_t>(h - y - 1) * w + x) * 4;
+      px[0] = toInt(c.x);
+      px[1] = toInt(c.y);
+      px[2] = toInt(c.z);
+      px[3] = 255;
+    }
+  }
+}
+
+} // extern "C"
