diff --git a/worker.js b/worker.js
new file mode 100644
index 0000000..54e4c75
--- /dev/null
+++ b/worker.js
@@ -0,0 +1,49 @@
+import initSmallpt from './smallpt.js';
+
+const wasmPromise = initSmallpt();
+let queue = Promise.resolve();
+
+async function handleRenderRequest(data) {
+  const width = data?.width ?? 320;
+  const height = data?.height ?? 240;
+  const samples = data?.samples ?? 1;
+  const randomize = Boolean(data?.randomize);
+  const seed = (data?.seed ?? 0) >>> 0;
+  const renderId = data?.renderId ?? 0;
+
+  const wasm = await wasmPromise;
+
+  if (randomize) {
+    wasm._randomize_spheres(seed);
+  }
+
+  const byteLength = width * height * 4;
+  const ptr = wasm._malloc(byteLength);
+
+  try {
+    const startTime = performance.now();
+    wasm._render_frame(ptr, width, height, samples);
+    const elapsedMs = performance.now() - startTime;
+    const pixels = new Uint8ClampedArray(
+      wasm.HEAPU8.buffer,
+      ptr,
+      byteLength,
+    ).slice();
+    self.postMessage(
+      { pixels, width, height, elapsedMs, renderId, randomized: randomize },
+      [pixels.buffer],
+    );
+  } finally {
+    wasm._free(ptr);
+  }
+}
+
+self.addEventListener('message', (event) => {
+  queue = queue
+    .then(() => handleRenderRequest(event.data))
+    .catch((error) => {
+      self.postMessage({
+        error: error instanceof Error ? error.message : String(error),
+      });
+    });
+});
