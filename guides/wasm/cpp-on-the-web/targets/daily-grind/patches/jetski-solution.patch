new file mode 100644
index 0000000..14cdffb
--- /dev/null
+++ b/main.js
@@ -0,0 +1,76 @@
+const canvas = document.getElementById('smallpt-canvas');
+const statusEl = document.getElementById('render-status');
+const randomizeBtn = document.getElementById('randomize-btn');
+
+if (canvas instanceof HTMLCanvasElement) {
+  const ctx = canvas.getContext('2d');
+  const worker = new Worker(new URL('./worker.js', import.meta.url), {
+    type: 'module',
+  });
+
+  let nextRenderId = 0;
+  let completedRenders = 0;
+
+  function requestRender(randomize) {
+    nextRenderId += 1;
+    const seed =
+      ((Date.now() & 0xffff) ^ Math.imul(nextRenderId, 0x9e3779b9)) >>> 0;
+
+    canvas.dataset.status = 'rendering';
+    if (statusEl) {
+      statusEl.textContent = randomize
+        ? 'Rendering with randomized sphere colors...'
+        : 'Rendering scene with smallpt WebAssembly path tracer...';
+    }
+
+    worker.postMessage({
+      width: canvas.width,
+      height: canvas.height,
+      samples: 1,
+      randomize,
+      seed,
+      renderId: nextRenderId,
+    });
+  }
+
+  worker.addEventListener('message', (event) => {
+    const { pixels, width, height, elapsedMs, randomized, error } =
+      event.data ?? {};
+
+    if (error) {
+      canvas.dataset.status = 'error';
+      if (statusEl) {
+        statusEl.textContent = `Render error: ${error}`;
+      }
+      return;
+    }
+
+    if (ctx && pixels && width && height) {
+      const clamped =
+        pixels instanceof Uint8ClampedArray
+          ? pixels
+          : new Uint8ClampedArray(pixels.buffer ?? pixels);
+      const imageData = new ImageData(clamped, width, height);
+      ctx.putImageData(imageData, 0, 0);
+
+      completedRenders += 1;
+      canvas.dataset.renderCount = String(completedRenders);
+      canvas.dataset.status = 'complete';
+
+      if (statusEl) {
+        const modeLabel = randomized
+          ? 'Randomized sphere colors'
+          : 'Default Cornell Box';
+        statusEl.textContent = `${modeLabel} — rendered ${width}×${height} in ${Math.round(elapsedMs ?? 0)} ms`;
+      }
+    }
+  });
+
+  if (randomizeBtn) {
+    randomizeBtn.addEventListener('click', () => {
+      requestRender(true);
+    });
+  }
+
+  requestRender(false);
+}
