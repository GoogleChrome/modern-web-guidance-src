+          div.append(swatch, label);
+          return div;
+        })
+      );
+    }
+
+    function drawPixels(width, height, pixels) {
+      if (canvas.width !== width || canvas.height !== height) {
+        canvas.width = width;
+        canvas.height = height;
+      }
+      const imageData = new ImageData(new Uint8ClampedArray(pixels), width, height);
+      ctx.putImageData(imageData, 0, 0);
+    }
+
+    function getSelectedParams() {
+      const [width, height] = resolutionSelect.value.split('x').map(Number);
+      const samps = Number(samplesSelect.value) || 2;
+      return { width, height, samps };
+    }
+
+    // Fallback to chunked main-thread rendering if Web Worker initialization fails
+    let fallbackModulePromise = null;
+    async function runFallbackOnMainThread({ width, height, samps, randomize, resetDefault, seed, activeRenderId }) {
+      if (!fallbackModulePromise) {
+        const { default: createModule } = await import('./smallpt.js');
+        fallbackModulePromise = createModule();
+      }
+      const mod = await fallbackModulePromise;
+      if (randomize) {
+        mod._randomize_sphere_colors(seed >>> 0);
+      } else if (resetDefault) {
+        mod._reset_default_colors();
+      }
+
+      const SPHERE_META = [
+        { index: 0, name: 'Left Wall' },
+        { index: 1, name: 'Right Wall' },
+        { index: 2, name: 'Back Wall' },
+        { index: 4, name: 'Floor' },
+        { index: 5, name: 'Ceiling' },
+        { index: 6, name: 'Mirror Sphere' },
+        { index: 7, name: 'Glass Sphere' }
+      ];
+      const to255 = v => Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255);
+      const palette = SPHERE_META.map(s => {
