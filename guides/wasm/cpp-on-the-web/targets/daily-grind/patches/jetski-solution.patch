+#include <cmath>
+#include <cstdlib>
+#include <vector>
+#include <emscripten.h>
+
+struct Vec {
+  double x, y, z;
+  Vec(double x_ = 0, double y_ = 0, double z_ = 0) : x(x_), y(y_), z(z_) {}
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec &norm() { return *this = *this * (1.0 / std::sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(const Vec &b) const {
+    return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x);
+  }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+  double rad;
+  Vec p, e, c;
+  Refl_t refl;
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_)
+      : rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {
+    Vec op = p - r.o;
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0;
+    det = std::sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+static inline double rnd(unsigned int &seed) {
+  seed = seed * 1664525u + 1013904223u;
+  return static_cast<double>(seed & 0xFFFFFF) / static_cast<double>(0x1000000);
+}
+
+inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+inline int toInt(double x) {
+  return static_cast<int>(std::pow(clamp(x), 1.0 / 2.2) * 255.0 + 0.5);
+}
+
+inline bool intersect(const Ray &r, double &t, int &id, const Sphere *spheres, int numSpheres) {
+  double d, inf = t = 1e20;
+  for (int i = numSpheres; i--;) {
+    if ((d = spheres[i].intersect(r)) && d < t) {
+      t = d;
+      id = i;
+    }
+  }
+  return t < inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned int &seed, const Sphere *spheres, int numSpheres) {
+  double t;
+  int id = 0;
+  if (!intersect(r, t, id, spheres, numSpheres)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x = r.o + r.d * t;
+  Vec n = (x - obj.p).norm();
+  Vec nl = n.dot(r.d) < 0 ? n : n * -1.0;
+  Vec f = obj.c;
+  double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+  if (++depth > 4) {
+    if (rnd(seed) < p) {
+      f = f * (1.0 / p);
+    } else {
+      return obj.e;
+    }
+  }
+  if (depth > 12) return obj.e;
+  if (obj.refl == DIFF) {
+    double r1 = 2.0 * M_PI * rnd(seed);
+    double r2 = rnd(seed);
+    double r2s = std::sqrt(r2);
+    Vec w = nl;
+    Vec u = ((std::abs(w.x) > 0.1 ? Vec(0, 1, 0) : Vec(1, 0, 0)) % w).norm();
+    Vec v = w % u;
+    Vec d = (u * std::cos(r1) * r2s + v * std::sin(r1) * r2s + w * std::sqrt(1.0 - r2)).norm();
+    Vec ambient(0.08, 0.08, 0.08);
+    return obj.e + f.mult(ambient + radiance(Ray(x, d), depth, seed, spheres, numSpheres));
+  } else if (obj.refl == SPEC) {
+    return obj.e + f.mult(radiance(Ray(x, r.d - n * 2.0 * n.dot(r.d)), depth, seed, spheres, numSpheres));
+  }
+  Ray reflRay(x, r.d - n * 2.0 * n.dot(r.d));
+  bool into = n.dot(nl) > 0;
+  double nc = 1.0, nt = 1.5;
+  double nnt = into ? nc / nt : nt / nc;
+  double ddn = r.d.dot(nl);
+  double cos2t;
+  if ((cos2t = 1.0 - nnt * nnt * (1.0 - ddn * ddn)) < 0) {
+    return obj.e + f.mult(radiance(reflRay, depth, seed, spheres, numSpheres));
+  }
+  Vec tdir = (r.d * nnt - n * ((into ? 1.0 : -1.0) * (ddn * nnt + std::sqrt(cos2t)))).norm();
+  double a = nt - nc, b = nt + nc;
+  double R0 = (a * a) / (b * b);
+  double c = 1.0 - (into ? -ddn : tdir.dot(n));
+  double Re = R0 + (1.0 - R0) * c * c * c * c * c;
+  double Tr = 1.0 - Re;
+  double P = 0.25 + 0.5 * Re;
+  double RP = Re / P;
+  double TP = Tr / (1.0 - P);
+  return obj.e + f.mult(depth > 2 ? (rnd(seed) < P ?
+    radiance(reflRay, depth, seed, spheres, numSpheres) * RP :
+    radiance(Ray(x, tdir), depth, seed, spheres, numSpheres) * TP) :
+    radiance(reflRay, depth, seed, spheres, numSpheres) * Re +
+    radiance(Ray(x, tdir), depth, seed, spheres, numSpheres) * Tr);
+}
+
+static std::vector<uint8_t> imageBuffer;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t *render(int w, int h, int samps, unsigned int seed) {
+  imageBuffer.resize(w * h * 4);
+  unsigned int rng = seed;
+
+  double r1 = 0.2 + 0.7 * rnd(rng);
+  double g1 = 0.2 + 0.7 * rnd(rng);
+  double b1 = 0.2 + 0.7 * rnd(rng);
+
+  double r2 = 0.2 + 0.7 * rnd(rng);
+  double g2 = 0.2 + 0.7 * rnd(rng);
+  double b2 = 0.2 + 0.7 * rnd(rng);
+
+  Sphere spheres[] = {
+    Sphere(1e5, Vec(1e5 + 1.0, 40.8, 81.6), Vec(), Vec(0.75, 0.25, 0.25), DIFF), // Left (red)
+    Sphere(1e5, Vec(-1e5 + 99.0, 40.8, 81.6), Vec(), Vec(0.25, 0.25, 0.75), DIFF), // Right (blue)
+    Sphere(1e5, Vec(50.0, 40.8, 1e5), Vec(), Vec(0.75, 0.75, 0.75), DIFF), // Back
+    Sphere(1e5, Vec(50.0, 40.8, -1e5 + 170.0), Vec(), Vec(), DIFF), // Front
+    Sphere(1e5, Vec(50.0, 1e5, 81.6), Vec(), Vec(0.75, 0.75, 0.75), DIFF), // Bottom
+    Sphere(1e5, Vec(50.0, -1e5 + 81.6, 81.6), Vec(), Vec(0.75, 0.75, 0.75), DIFF), // Top
+    Sphere(8.0, Vec(50.0, 81.6 - 8.0, 81.6), Vec(40.0, 40.0, 40.0), Vec(), DIFF), // Light
+    Sphere(16.5, Vec(27.0, 16.5, 47.0), Vec(), Vec(r1, g1, b1) * 0.99, SPEC), // Mirr
+    Sphere(16.5, Vec(73.0, 16.5, 78.0), Vec(), Vec(r2, g2, b2) * 0.99, REFR)  // Glas
+  };
+  int numSpheres = 9;
+
+  Ray cam(Vec(50.0, 52.0, 295.6), Vec(0.0, -0.042612, -1.0).norm());
+  Vec cx = Vec(static_cast<double>(w) * 0.5135 / static_cast<double>(h), 0.0, 0.0);
+  Vec cy = (cx % cam.d).norm() * 0.5135;
+
+  for (int y = 0; y < h; ++y) {
+    for (int x = 0; x < w; ++x) {
+      Vec r;
+      for (int s = 0; s < samps; ++s) {
+        double r1 = 2.0 * rnd(rng);
+        double dx = r1 < 1.0 ? std::sqrt(r1) - 1.0 : 1.0 - std::sqrt(2.0 - r1);
+        double r2 = 2.0 * rnd(rng);
+        double dy = r2 < 1.0 ? std::sqrt(r2) - 1.0 : 1.0 - std::sqrt(2.0 - r2);
+        Vec d = cx * (((static_cast<double>(x) + 0.5 + dx) / static_cast<double>(w)) - 0.5) +
+                cy * (((static_cast<double>(y) + 0.5 + dy) / static_cast<double>(h)) - 0.5) + cam.d;
