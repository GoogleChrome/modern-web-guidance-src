index 0000000..2c4fa22
--- /dev/null
+++ b/smallpt-worker.js
@@ -0,0 +1,82 @@
+import createModule from './smallpt.js';
+
+let wasmModule = null;
+let currentRenderId = 0;
+
+const SPHERE_META = [
+  { index: 0, name: 'Left Wall', role: 'Diffuse' },
+  { index: 1, name: 'Right Wall', role: 'Diffuse' },
+  { index: 2, name: 'Back Wall', role: 'Diffuse' },
+  { index: 4, name: 'Floor', role: 'Diffuse' },
+  { index: 5, name: 'Ceiling', role: 'Diffuse' },
+  { index: 6, name: 'Mirror Sphere', role: 'Specular' },
+  { index: 7, name: 'Glass Sphere', role: 'Refractive' }
+];
+
+function readSpherePalette(mod) {
+  return SPHERE_META.map(s => {
+    const r = mod._get_sphere_color_channel(s.index, 0);
+    const g = mod._get_sphere_color_channel(s.index, 1);
+    const b = mod._get_sphere_color_channel(s.index, 2);
+    const to255 = v => Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255);
+    return {
+      ...s,
+      r, g, b,
+      css: `rgb(${to255(r)}, ${to255(g)}, ${to255(b)})`
+    };
+  });
+}
+
+self.onmessage = async (e) => {
+  const { type, width = 320, height = 240, samps = 4, randomize = false, seed = 0, renderId = 0 } = e.data;
+  if (type !== 'render') return;
+
+  currentRenderId = renderId;
+
+  if (!wasmModule) {
+    wasmModule = await createModule();
+  }
+
+  if (randomize) {
+    wasmModule._randomize_sphere_colors(seed >>> 0);
+  } else if (e.data.resetDefault) {
+    wasmModule._reset_default_colors();
+  }
+
+  const palette = readSpherePalette(wasmModule);
+  self.postMessage({ type: 'palette', renderId, palette });
+
+  const ptr = wasmModule._init_render(width, height);
+  const chunkRows = 16;
+  const startTime = performance.now();
+
+  for (let y = 0; y < height; y += chunkRows) {
+    if (currentRenderId !== renderId) return;
+    const endY = Math.min(height, y + chunkRows);
+    wasmModule._render_rows(width, height, y, endY, samps, seed | 0);
+
+    const byteLength = width * height * 4;
+    const pixels = new Uint8ClampedArray(wasmModule.HEAPU8.buffer, ptr, byteLength).slice();
+    const elapsedMs = performance.now() - startTime;
+    const progress = Math.round((endY / height) * 100);
+    const done = endY >= height;
+
+    self.postMessage(
+      {
+        type: done ? 'complete' : 'progress',
+        renderId,
+        width,
+        height,
+        samps: samps * 4,
+        progress,
+        elapsedMs,
+        pixels,
+        palette
+      },
+      [pixels.buffer]
+    );
+
+    // Yield briefly in the worker event loop so cancellation messages can be processed
+    await new Promise(resolve => setTimeout(resolve, 0));
+  }
+};
