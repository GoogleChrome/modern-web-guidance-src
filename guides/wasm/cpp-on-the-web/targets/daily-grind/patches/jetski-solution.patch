+      imageBuffer[idx + 0] = toInt(r.x);
+      imageBuffer[idx + 1] = toInt(r.y);
+      imageBuffer[idx + 2] = toInt(r.z);
+      imageBuffer[idx + 3] = 255;
+    }
+  }
+  return imageBuffer.data();
+}
