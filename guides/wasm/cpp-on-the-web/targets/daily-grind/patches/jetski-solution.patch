+        const g = mod._get_sphere_color_channel(s.index, 1);
+        const b = mod._get_sphere_color_channel(s.index, 2);
+        return { ...s, css: `rgb(${to255(r)}, ${to255(g)}, ${to255(b)})` };
+      });
+      updatePaletteUI(palette);
+
+      const ptr = mod._init_render(width, height);
+      const chunkRows = 8;
+      const startTime = performance.now();
+
+      for (let y = 0; y < height; y += chunkRows) {
+        if (activeRenderId !== renderId) return;
+        const endY = Math.min(height, y + chunkRows);
+        mod._render_rows(width, height, y, endY, samps, seed | 0);
+        const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, width * height * 4);
+        drawPixels(width, height, pixels);
+        const progress = Math.round((endY / height) * 100);
+        const elapsed = Math.round(performance.now() - startTime);
+        progressFill.style.width = `${progress}%`;
