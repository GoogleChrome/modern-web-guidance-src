@@ -0,0 +1,274 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008
+// Adapted for WebAssembly execution in the browser with Emscripten.
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+
+struct Vec {
+  double x, y, z;  // position, also color (r,g,b)
+  Vec(double x_ = 0, double y_ = 0, double z_ = 0) : x(x_), y(y_), z(z_) {}
+  Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+  Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+  Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+  Vec &norm() { return *this = *this * (1.0 / std::sqrt(x * x + y * y + z * z)); }
+  double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+  Vec operator%(const Vec &b) const {
+    return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x);
+  }
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_ = Vec(), Vec d_ = Vec()) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+
+struct Sphere {
+  double rad;   // radius
+  Vec p, e, c;  // position, emission, color
+  Refl_t refl;  // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_)
+      : rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const {  // returns distance, 0 if nohit
+    Vec op = p - r.o;  // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+    if (det < 0) return 0;
+    det = std::sqrt(det);
+    return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+  }
+};
+
+// Scene: radius, position, emission, color, material
+static Sphere spheres[] = {
+    Sphere(1e5, Vec(1e5 + 1, 40.8, 81.6), Vec(), Vec(.75, .25, .25), DIFF),    // Left
+    Sphere(1e5, Vec(-1e5 + 99, 40.8, 81.6), Vec(), Vec(.25, .25, .75), DIFF),  // Rght
+    Sphere(1e5, Vec(50, 40.8, 1e5), Vec(), Vec(.75, .75, .75), DIFF),          // Back
+    Sphere(1e5, Vec(50, 40.8, -1e5 + 170), Vec(), Vec(), DIFF),                // Frnt
+    Sphere(1e5, Vec(50, 1e5, 81.6), Vec(), Vec(.75, .75, .75), DIFF),          // Botm
+    Sphere(1e5, Vec(50, -1e5 + 81.6, 81.6), Vec(), Vec(.75, .75, .75), DIFF),  // Top
+    Sphere(16.5, Vec(27, 16.5, 47), Vec(), Vec(1, 1, 1) * .999, SPEC),         // Mirr
+    Sphere(16.5, Vec(73, 16.5, 78), Vec(), Vec(1, 1, 1) * .999, REFR),         // Glas
+    Sphere(600, Vec(50, 681.6 - .27, 81.6), Vec(12, 12, 12), Vec(), DIFF)      // Lite
+};
+
+static uint32_t randomize_generation = 0;
+
+inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+inline int toInt(double x) { return int(std::pow(clamp(x), 1.0 / 2.2) * 255.0 + 0.5); }
+
+inline bool intersect(const Ray &r, double &t, int &id) {
+  double n = sizeof(spheres) / sizeof(Sphere), d, inf = t = 1e20;
+  for (int i = int(n); i--;)
+    if ((d = spheres[i].intersect(r)) && d < t) {
+      t = d;
+      id = i;
+    }
+  return t < inf;
+}
+
+static Vec hsv_to_rgb(double h, double s, double v) {
+  h = h - std::floor(h);
+  double c = v * s;
+  double x = c * (1.0 - std::fabs(std::fmod(h * 6.0, 2.0) - 1.0));
+  double m = v - c;
+  double r = 0, g = 0, b = 0;
+  int sector = static_cast<int>(h * 6.0);
+  switch (sector) {
+    case 0: r = c; g = x; b = 0; break;
+    case 1: r = x; g = c; b = 0; break;
+    case 2: r = 0; g = c; b = x; break;
+    case 3: r = 0; g = x; b = c; break;
+    case 4: r = x; g = 0; b = c; break;
+    default: r = c; g = 0; b = x; break;
+  }
+  return Vec(r + m, g + m, b + m);
+}
+
+struct RayTask {
+  Ray r;
+  Vec throughput;
+  int depth;
+  int E;
+};
+
+// Iterative path-tracing evaluation of radiance along primary_ray to avoid
+// call-stack overflow in WebAssembly linear memory.
+Vec radiance(const Ray &primary_ray, int initial_depth, unsigned short *Xi) {
+  RayTask stack[16];
+  int sp = 0;
+  stack[sp++] = {primary_ray, Vec(1, 1, 1), initial_depth, 1};
+  Vec accum(0, 0, 0);
+
+  while (sp > 0) {
+    RayTask task = stack[--sp];
+    Ray r = task.r;
+    Vec throughput = task.throughput;
+    int depth = task.depth;
+    int E = task.E;
+
+    while (true) {
+      double t;
+      int id = 0;
+      if (!intersect(r, t, id)) break;
+      const Sphere &obj = spheres[id];
+      if (E) {
+        accum = accum + throughput.mult(obj.e);
+      }
+
+      Vec x = r.o + r.d * t;
+      Vec n = (x - obj.p).norm();
+      Vec nl = n.dot(r.d) < 0 ? n : n * -1;
+      Vec f = obj.c;
+      double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+
+      if (++depth > 4) {
+        if (depth < 16 && erand48(Xi) < p)
+          f = f * (1.0 / p);
+        else
+          break;
+      }
+      throughput = throughput.mult(f);
+
+      if (obj.refl == DIFF) {
+        // Explicit direct light sampling of the ceiling light cap (spheres[8])
+        double phi = 2.0 * M_PI * erand48(Xi);
+        double rad_disk = 17.5 * std::sqrt(erand48(Xi));
+        double ly = 681.6 - 0.27 - std::sqrt(600.0 * 600.0 - rad_disk * rad_disk);
+        Vec light_pt(50.0 + rad_disk * std::cos(phi), ly, 81.6 + rad_disk * std::sin(phi));
+        Vec to_light = light_pt - x;
+        double dist2 = to_light.dot(to_light);
+        Vec ldir = to_light * (1.0 / std::sqrt(dist2));
+        double cos_s = ldir.dot(nl);
+        double cos_l = ldir.y;
+        if (cos_s > 0 && cos_l > 0) {
+          double st;
+          int sid = 0;
+          if (intersect(Ray(x, ldir), st, sid) && sid == 8) {
+            double area = M_PI * 17.5 * 17.5;
+            double omega = (area * cos_l) / dist2;
+            accum = accum + throughput.mult(spheres[8].e * (cos_s * omega * M_1_PI));
+          }
+        }
+
+        double r1 = 2.0 * M_PI * erand48(Xi), r2 = erand48(Xi), r2s = std::sqrt(r2);
+        Vec w = nl;
+        Vec u = ((std::fabs(w.x) > 0.1 ? Vec(0, 1) : Vec(1)) % w).norm();
+        Vec v = w % u;
+        Vec d = (u * std::cos(r1) * r2s + v * std::sin(r1) * r2s + w * std::sqrt(1.0 - r2)).norm();
+        r = Ray(x, d);
+        E = 0;
+        continue;
+      } else if (obj.refl == SPEC) {
+        r = Ray(x, r.d - n * 2.0 * n.dot(r.d));
+        E = 1;
+        continue;
+      }
+
+      Ray reflRay(x, r.d - n * 2.0 * n.dot(r.d));
+      bool into = n.dot(nl) > 0;
+      double nc = 1.0, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+      if ((cos2t = 1.0 - nnt * nnt * (1.0 - ddn * ddn)) < 0) {
+        r = reflRay;
+        E = 1;
+        continue;
+      }
+      Vec tdir = (r.d * nnt - n * ((into ? 1.0 : -1.0) * (ddn * nnt + std::sqrt(cos2t)))).norm();
+      double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1.0 - (into ? -ddn : tdir.dot(n));
+      double Re = R0 + (1.0 - R0) * c * c * c * c * c, Tr = 1.0 - Re, P = 0.25 + 0.5 * Re,
+             RP = Re / P, TP = Tr / (1.0 - P);
+      E = 1;
+      if (depth > 2) {
+        if (erand48(Xi) < P) {
+          throughput = throughput * RP;
+          r = reflRay;
+        } else {
+          throughput = throughput * TP;
+          r = Ray(x, tdir);
+        }
+      } else {
+        if (sp < 16) {
+          stack[sp++] = {Ray(x, tdir), throughput * Tr, depth, 1};
+        }
+        throughput = throughput * Re;
+        r = reflRay;
+      }
+    }
+  }
+  return accum;
+}
+
+extern "C" {
+
+void randomize_spheres(uint32_t seed) {
+  ++randomize_generation;
+  uint32_t mixed = seed ^ (randomize_generation * 0x9E3779B9u);
+  unsigned short Xi[3] = {
+      static_cast<unsigned short>((mixed & 0xFFFFu) ^ 0x330Eu),
+      static_cast<unsigned short>(((mixed >> 16) & 0xFFFFu) ^ 0xABCDu),
+      static_cast<unsigned short>(((mixed * 2654435761u) >> 16) & 0xFFFFu),
+  };
+
+  double base_hue = std::fmod(randomize_generation * 0.27 + erand48(Xi) * 0.35, 1.0);
+  const int wall_indices[5] = {0, 1, 2, 4, 5};
+  for (int i = 0; i < 5; i++) {
+    double h = std::fmod(base_hue + i * 0.19 + erand48(Xi) * 0.08, 1.0);
+    double s = 0.65 + 0.25 * erand48(Xi);
+    double v = 0.68 + 0.22 * erand48(Xi);
+    spheres[wall_indices[i]].c = hsv_to_rgb(h, s, v);
+  }
+
+  // Randomize mirror and glass sphere tint colors
+  spheres[6].c = hsv_to_rgb(
+      std::fmod(base_hue + 0.52 + erand48(Xi) * 0.15, 1.0),
+      0.55 + 0.35 * erand48(Xi),
+      0.92 + 0.079 * erand48(Xi));
+  spheres[7].c = hsv_to_rgb(
+      std::fmod(base_hue + 0.81 + erand48(Xi) * 0.15, 1.0),
+      0.55 + 0.35 * erand48(Xi),
+      0.92 + 0.079 * erand48(Xi));
+}
+
+void render_frame(uint8_t *out_pixels, int w, int h, int samps) {
+  if (!out_pixels || w <= 0 || h <= 0) return;
+  if (samps < 1) samps = 1;
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * 0.5135 / h);
+  Vec cy = (cx % cam.d).norm() * 0.5135;
+
+  for (int y = 0; y < h; y++) {
+    unsigned short Xi[3] = {
+        static_cast<unsigned short>(randomize_generation * 131u),
+        static_cast<unsigned short>(y * 17u + randomize_generation * 31u),
+        static_cast<unsigned short>(y * y * y + randomize_generation * 97u),
+    };
+    for (int x = 0; x < w; x++) {
+      Vec pixel_color(0, 0, 0);
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++) {
+          Vec r(0, 0, 0);
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2.0 * erand48(Xi);
+            double dx = r1 < 1.0 ? std::sqrt(r1) - 1.0 : 1.0 - std::sqrt(2.0 - r1);
+            double r2 = 2.0 * erand48(Xi);
+            double dy = r2 < 1.0 ? std::sqrt(r2) - 1.0 : 1.0 - std::sqrt(2.0 - r2);
+            Vec d = cx * (((sx + 0.5 + dx) / 2.0 + x) / w - 0.5) +
+                    cy * (((sy + 0.5 + dy) / 2.0 + y) / h - 0.5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140.0, d.norm()), 0, Xi) * (1.0 / samps);
+          }
+          pixel_color = pixel_color + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * 0.25;
+        }
+      }
+      int idx = ((h - y - 1) * w + x) * 4;
+      out_pixels[idx + 0] = static_cast<uint8_t>(toInt(pixel_color.x));
+      out_pixels[idx + 1] = static_cast<uint8_t>(toInt(pixel_color.y));
+      out_pixels[idx + 2] = static_cast<uint8_t>(toInt(pixel_color.z));
+      out_pixels[idx + 3] = 255;
+    }
+  }
+}
+
+}  // extern "C"
