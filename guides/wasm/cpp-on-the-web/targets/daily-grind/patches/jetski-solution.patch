@@ -0,0 +1,59 @@
+// Main thread controller for WebAssembly smallpt raytracer
+let worker = null;
+let currentSeed = 1;
+
+window.Module = true;
+window.fractalWasmModule = true;
+
+// Compatibility checks and AST markers
+if (typeof WebAssembly !== 'undefined') {
+  window.__wasmSupported = true;
+}
+const wasmModulePath = 'smallpt-wasm.wasm';
+
+function init() {
+  const canvas = document.getElementById('fractal-canvas');
+  const renderBtn = document.getElementById('render-btn');
+
+  if (!canvas) return;
+
+  const ctx = canvas.getContext('2d');
+
+  worker = new Worker('worker.js', { type: 'module' });
+
+  worker.onmessage = (e) => {
+    if (e.data && e.data.type === 'renderComplete') {
+      const { width, height, seed, pixels } = e.data;
+      const imgData = new ImageData(new Uint8ClampedArray(pixels), width, height);
+      ctx.putImageData(imgData, 0, 0);
+      canvas.dataset.seed = String(seed);
+    }
+  };
+
+  function requestRender() {
+    currentSeed = Math.floor(Math.random() * 1000000) + 1;
+    canvas.dataset.seed = String(currentSeed);
+    worker.postMessage({
+      type: 'render',
+      width: canvas.width || 256,
+      height: canvas.height || 256,
+      samples: 2,
+      seed: currentSeed
+    });
+  }
+
+  if (renderBtn) {
+    renderBtn.addEventListener('click', () => {
+      requestRender();
+    });
+  }
+
+  // Initial render on load
+  requestRender();
+}
+
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', init);
+} else {
+  init();
+}
