+const $ = (id) => document.getElementById(id);
+const canvas = $('canvas');
+const context = canvas.getContext('2d');
+const colors = [$('mirror-color'), $('glass-color')];
+let worker, running = false, runId = 0, hasPixels = false;
+let currentSamples = 64;
+const initialColors = ['#f6e4ce', '#d8e1fa'];
+const preview = new Image();
+preview.onload = () => { if (!hasPixels) context.drawImage(preview, 0, 0, canvas.width, canvas.height); };
+preview.src = './assets/preview.png';
+
+function setSamples(value) {
+  $('samples').value = value;
+  document.querySelectorAll('[data-samples]').forEach((button) => {
+    const selected = Number(button.dataset.samples) === Number(value);
+    button.classList.toggle('selected', selected);
+    button.setAttribute('aria-pressed', String(selected));
+  });
+}
+document.querySelectorAll('[data-samples]').forEach((button) => button.addEventListener('click', () => setSamples(button.dataset.samples)));
+function setRunning(value) {
+  running = value;
+  $('render-label').textContent = value ? 'Stop rendering' : 'Render scene';
+  document.querySelector('.play-icon').textContent = value ? '■' : '▶';
+  $('render-dot').style.background = value ? '#c5bbf2' : '#a8c4a2';
+}
+function stop() {
+  runId++;
+  worker?.terminate();
+  worker = null;
+  setRunning(false);
+}
+function fail(message) {
+  stop();
+  $('render-status').textContent = message;
+  $('render-dot').style.background = '#e3a291';
+}
+function render() {
+  stop();
+  const id = runId;
+  const width = Number($('resolution').value), height = width * 3 / 4;
+  currentSamples = Number($('samples').value);
+  // Keep the previous image visible while the next render progressively replaces it.
+  const previous = document.createElement('canvas');
+  previous.width = canvas.width; previous.height = canvas.height;
+  previous.getContext('2d').drawImage(canvas, 0, 0);
+  canvas.width = width; canvas.height = height;
+  context.drawImage(previous, 0, 0, width, height);
+  $('canvas-size').textContent = $('stat-resolution').textContent = `${width} × ${height}`;
+  $('stat-samples').innerHTML = `${currentSamples} <small>spp</small>`;
+  $('stat-time').innerHTML = '0.0 <small>s</small>';
+  $('progress-fill').style.width = '0%';
+  $('progress').setAttribute('aria-valuenow', '0');
+  $('render-status').textContent = 'Loading WebAssembly…';
+  setRunning(true);
+  try {
+    worker = new Worker(new URL('./render-worker.js', import.meta.url), { type: 'module' });
+    worker.onerror = () => { if (id === runId) fail('Renderer failed. Click Render scene to retry.'); };
+    worker.onmessage = ({ data }) => {
+      if (id !== runId) return;
+      if (data.error) { fail(data.error); return; }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels.buffer), width, data.count), 0, data.row);
+      hasPixels = true;
+      $('download').disabled = false;
+      $('stat-time').innerHTML = `${(data.elapsed / 1000).toFixed(1)} <small>s</small>`;
+      $('progress-fill').style.width = `${data.progress * 100}%`;
+      $('progress').setAttribute('aria-valuenow', String(Math.round(data.progress * 100)));
+      $('render-status').textContent = `Rendering · ${Math.round(data.progress * 100)}%`;
+      if (data.progress === 1) {
+        stop();
+        $('render-status').textContent = 'Render complete';
+      }
+    };
+    worker.postMessage({ width, height, samples: currentSamples,
+      seed: crypto.getRandomValues(new Uint32Array(1))[0],
+      colors: colors.map((input) => [1, 3, 5].map((offset) => parseInt(input.value.slice(offset, offset + 2), 16) / 255)) });
+  } catch (error) { fail(`Unable to start: ${error.message}`); }
+}
+$('render').addEventListener('click', () => {
+  if (running) { stop(); $('render-status').textContent = 'Render paused'; }
+  else render();
+});
+$('randomize').addEventListener('click', () => {
+  const random = crypto.getRandomValues(new Uint8Array(6));
+  colors.forEach((input, i) => {
+    // Keep bright, tinted materials so that indirect light and refraction remain visible.
+    const components = Array.from(random.slice(i * 3, i * 3 + 3), (n) => Math.round(105 + n / 255 * 145));
+    components[i % 3] = 250;
+    input.value = '#' + components.map((n) => n.toString(16).padStart(2, '0')).join('');
+  });
+  render();
+});
+$('reset').addEventListener('click', () => {
+  setSamples(64); $('resolution').value = '640';
+  colors.forEach((input, i) => { input.value = initialColors[i]; });
+  render();
+});
+$('download').addEventListener('click', () => canvas.toBlob((blob) => {
+  if (!blob) return;
+  const url = URL.createObjectURL(blob), anchor = document.createElement('a');
+  anchor.href = url; anchor.download = `smallpt-${canvas.width}x${canvas.height}-${currentSamples}spp.png`;
+  anchor.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
+}, 'image/png'));
+document.addEventListener('keydown', (event) => {
+  if (event.key === 'Enter' && event.target === document.body) $('render').click();
+});
+window.addEventListener('pagehide', stop);
+if (typeof WebAssembly === 'undefined' || typeof Worker === 'undefined') fail('This browser needs WebAssembly and Web Worker support.');
+else render();
