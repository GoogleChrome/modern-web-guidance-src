@@ -0,0 +1,7 @@
+export interface RendererModule {
+  _render(seed: number): number;
+  HEAPU8: Uint8Array;
+}
+export default function createRenderer(options: {
+  locateFile: (path: string) => string;
+}): Promise<RendererModule>;
