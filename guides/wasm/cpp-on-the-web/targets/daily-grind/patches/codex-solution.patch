new file mode 100644
index 0000000..2eb15d0
--- /dev/null
+++ b/src/protocol.ts
@@ -0,0 +1,6 @@
+export const WIDTH = 960;
+export const HEIGHT = 600;
+export type RenderRequest = { type: 'render'; seed: number };
+export type RenderResponse =
+  | { type: 'image'; pixels: ArrayBuffer; duration: number }
+  | { type: 'error'; message: string };
diff --git a/src/renderer.worker.ts b/src/renderer.worker.ts
new file mode 100644
index 0000000..aeda784
--- /dev/null
+++ b/src/renderer.worker.ts
@@ -0,0 +1,27 @@
+/// <reference lib="webworker" />
+import createRenderer, { type RendererModule } from './wasm/renderer.js';
+import { WIDTH, HEIGHT, type RenderRequest, type RenderResponse } from './protocol';
+
+const worker = self as unknown as DedicatedWorkerGlobalScope;
+let modulePromise: Promise<RendererModule> | undefined;
+worker.onmessage = async ({ data }: MessageEvent<RenderRequest>) => {
+  if (data.type !== 'render' || !Number.isFinite(data.seed)) return;
+  try {
+    modulePromise ??= createRenderer({
+      locateFile: () => new URL('./wasm/renderer.wasm', import.meta.url).href,
+    });
+    const module = await modulePromise;
+    const start = performance.now();
+    const pointer = module._render(data.seed >>> 0);
+    // Copy out of Wasm memory before transferring ownership to the page.
+    const pixels = module.HEAPU8.slice(pointer, pointer + WIDTH * HEIGHT * 4).buffer;
+    const response: RenderResponse = { type: 'image', pixels, duration: performance.now() - start };
+    worker.postMessage(response, [pixels]);
+  } catch (error) {
+    modulePromise = undefined;
+    const response: RenderResponse = {
+      type: 'error', message: error instanceof Error ? error.message : 'Could not render the image.',
+    };
+    worker.postMessage(response);
+  }
+};
