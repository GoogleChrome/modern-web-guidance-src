diff --git a/scripts/render-preview.mjs b/scripts/render-preview.mjs
new file mode 100644
index 0000000..cd9713e
--- /dev/null
+++ b/scripts/render-preview.mjs
@@ -0,0 +1,56 @@
+// Execute the browser-targeted Wasm module in Node, without a browser or server.
+import assert from 'node:assert/strict';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { deflateSync } from 'node:zlib';
+import createRenderer from '../assets/smallpt.js';
+const wasm = readFileSync(new URL('../assets/smallpt.wasm', import.meta.url));
+assert(WebAssembly.validate(wasm));
+const savedProcess = globalThis.process;
+const savedFetch = globalThis.fetch;
+globalThis.process = undefined;
+globalThis.window = {};
+globalThis.fetch = async () => new Response(wasm, { headers: { 'Content-Type': 'application/wasm' } });
+let m;
+try { m = await createRenderer(); }
+finally { globalThis.process = savedProcess; globalThis.fetch = savedFetch; delete globalThis.window; }
+function image(seed, color) {
+  assert.equal(m._init_render(48, 36, 16, seed), 1);
+  m._set_color(6, ...color);
+  m._render_rows(0, 36);
+  return Buffer.from(m.HEAPU8.slice(m._get_pixels(), m._get_pixels() + 48 * 36 * 4));
+}
+assert.equal(m._init_render(0, 24, 4, 1), 0);
+const first = image(42, [1, 1, 1]);
+assert.deepEqual(image(42, [1, 1, 1]), first, 'A fixed seed must reproduce the output');
+assert.notDeepEqual(image(42, [0.9, 0.3, 0.2]), first, 'Sphere color must change rendered pixels');
+assert(first.some((value, i) => i % 4 !== 3 && value > 0), 'Image must contain light');
+assert(first.every((value, i) => i % 4 !== 3 || value === 255), 'Pixels must be opaque');
+console.log('Wasm checks passed: initialization, rendering, deterministic seed, sphere recoloring, RGBA output.');
+const width = 640, height = 480;
+m._init_render(width, height, 256, 2026);
+m._set_color(6, 246/255, 228/255, 206/255);
+m._set_color(7, 216/255, 225/255, 250/255);
+const started = performance.now();
+for (let row = 0; row < height; row += 24) {
+  m._render_rows(row, Math.min(24, height - row));
+  if (row % 120 === 0) console.log(`Building rendered preview: ${Math.round(row / height * 100)}%`);
+}
+const rgba = m.HEAPU8.slice(m._get_pixels(), m._get_pixels() + width * height * 4);
+const scanlines = Buffer.alloc(height * (width * 4 + 1));
+for (let y = 0; y < height; y++) scanlines.set(rgba.subarray(y * width * 4, (y + 1) * width * 4), y * (width * 4 + 1) + 1);
+function crc32(bytes) {
+  let crc = 0xffffffff;
+  for (const byte of bytes) { crc ^= byte; for (let k = 0; k < 8; k++) crc = (crc >>> 1) ^ (0xedb88320 & -(crc & 1)); }
+  return (crc ^ 0xffffffff) >>> 0;
+}
+function chunk(type, data) {
+  const payload = Buffer.concat([Buffer.from(type), data]);
+  const size = Buffer.alloc(4), crc = Buffer.alloc(4);
+  size.writeUInt32BE(data.length); crc.writeUInt32BE(crc32(payload));
+  return Buffer.concat([size, payload, crc]);
+}
+const header = Buffer.alloc(13); header.writeUInt32BE(width); header.writeUInt32BE(height, 4); header[8] = 8; header[9] = 6;
+writeFileSync(new URL('../assets/preview.png', import.meta.url), Buffer.concat([
+  Buffer.from([137,80,78,71,13,10,26,10]), chunk('IHDR', header), chunk('IDAT', deflateSync(scanlines)), chunk('IEND', Buffer.alloc(0))
+]));
+console.log(`Preview built by WebAssembly in ${((performance.now() - started) / 1000).toFixed(1)} seconds.`);
diff --git a/src/renderer.cpp b/src/renderer.cpp
new file mode 100644
index 0000000..88aabd4
--- /dev/null
+++ b/src/renderer.cpp
@@ -0,0 +1,46 @@
+// Browser adapter for Kevin Beason's smallpt. Original integrator is unchanged.
+#define main smallpt_original_main
+#include "../vendor/smallpt/smallpt.cpp"
+#undef main
+#include <stdint.h>
+
+static unsigned char* pixels = nullptr;
+static int width, height, samples;
+static uint32_t renderSeed;
+extern "C" {
+int init_render(int w, int h, int spp, unsigned int seed) {
+  if (w < 1 || w > 1920 || h < 1 || h > 1080 || spp < 4 || spp > 1024) return 0;
+  width=w; height=h; samples=spp/4; renderSeed=seed;
+  free(pixels);
+  pixels = (unsigned char*)calloc(w*h*4, 1);
+  if (!pixels) return 0;
+  return 1;
+}
+void set_color(int id, double r, double g, double b) {
+  if (id == 6 || id == 7) spheres[id].c=Vec(clamp(r),clamp(g),clamp(b));
+}
+unsigned char* get_pixels() { return pixels; }
+void render_rows(int start, int count) {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for (int row=start; row<start+count && row<height; row++) {
+    int y=height-row-1;
+    unsigned short Xi[3]={(unsigned short)renderSeed,(unsigned short)(renderSeed>>16),(unsigned short)(y*y*y)};
+    for (int x=0; x<width; x++) {
+      Vec c;
+      for(int sy=0;sy<2;sy++) for(int sx=0;sx<2;sx++) {
+        Vec r;
+        for(int s=0;s<samples;s++) {
+          double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+          double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+          Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+          r=r+radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samples);
+        }
+        c=c+Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+      }
+      int i=(row*width+x)*4;
+      pixels[i]=toInt(c.x);pixels[i+1]=toInt(c.y);pixels[i+2]=toInt(c.z);pixels[i+3]=255;
+    }
+  }
+}
+}
