--- /dev/null
+++ b/tests/renderer.spec.ts
@@ -0,0 +1,54 @@
+import { test, expect } from '@playwright/test';
+
+test('Wasm renders distinct images while the page remains interactive', async ({ page }) => {
+  const errors: string[] = [];
+  page.on('pageerror', error => errors.push(error.message));
+  page.on('console', message => {
+    if (['error', 'warning'].includes(message.type())) errors.push(message.text());
+  });
+  const wasm = page.waitForResponse(response => response.url().endsWith('.wasm'));
+  await page.goto('/');
+  expect((await wasm).ok()).toBeTruthy();
+  const canvas = page.locator('#coffee-art');
+  await expect(canvas).toBeVisible();
+  const before = await canvas.evaluate((node: HTMLCanvasElement) => node.toDataURL());
+  const button = page.getByRole('button', { name: 'Render a new image' });
+  // CPU throttling makes the in-flight responsiveness check meaningful on fast hosts.
+  const cdp = await page.context().newCDPSession(page);
+  await cdp.send('Emulation.setCPUThrottlingRate', { rate: 4 });
+  await button.click();
+  await expect(canvas).toHaveAttribute('aria-busy', 'true');
+  const interaction = await page.evaluate(async () => {
+    let clicked = false;
+    const probe = document.createElement('button');
+    probe.textContent = 'Responsiveness probe';
+    probe.onclick = () => { clicked = true; };
+    document.body.append(probe);
+    const start = performance.now();
+    await new Promise<void>(resolve => requestAnimationFrame(() => {
+      probe.click(); resolve();
+    }));
+    const elapsed = performance.now() - start;
+    probe.remove();
+    return { clicked, elapsed, busy: document.querySelector('canvas')?.getAttribute('aria-busy') };
+  });
+  expect(interaction.clicked).toBe(true);
+  expect(interaction.elapsed).toBeLessThan(250);
+  expect(interaction.busy).toBe('true');
+  await expect(button).toBeEnabled({ timeout: 30000 });
+  const after = await canvas.evaluate((node: HTMLCanvasElement) => node.toDataURL());
+  expect(after).not.toBe(before);
+  expect(errors).toEqual([]);
+});
+
+test('initialization failures display a retry and can recover', async ({ page }) => {
+  const errors: string[] = [];
+  page.on('pageerror', error => errors.push(error.message));
+  await page.route('**/*.wasm', route => route.abort());
+  await page.goto('/');
+  await expect(page.getByRole('button', { name: 'Try again' })).toBeEnabled();
+  await page.unroute('**/*.wasm');
+  await page.getByRole('button', { name: 'Try again' }).click();
+  await expect(page.locator('#coffee-art')).toBeVisible();
+  expect(errors).toEqual([]);
+});
