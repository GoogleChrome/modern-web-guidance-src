diff --git a/render-worker.js b/render-worker.js
new file mode 100644
index 0000000..9d7e05a
--- /dev/null
+++ b/render-worker.js
@@ -0,0 +1,21 @@
+import createRenderer from './assets/smallpt.js';
+let renderer;
+self.onmessage = async ({ data }) => {
+  try {
+    renderer ??= await createRenderer();
+    const { width, height, samples, seed, colors } = data;
+    if (!renderer._init_render(width, height, samples, seed)) throw new Error('Invalid render settings.');
+    for (let i = 0; i < 2; i++) renderer._set_color(i + 6, ...colors[i]);
+    const started = performance.now();
+    for (let row = 0; row < height; row += 4) {
+      const count = Math.min(4, height - row);
+      renderer._render_rows(row, count);
+      const offset = renderer._get_pixels() + row * width * 4;
+      const pixels = renderer.HEAPU8.slice(offset, offset + count * width * 4);
+      self.postMessage({ row, count, pixels, progress: (row + count) / height,
+        elapsed: performance.now() - started }, [pixels.buffer]);
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || 'The renderer could not start.' });
+  }
+};
