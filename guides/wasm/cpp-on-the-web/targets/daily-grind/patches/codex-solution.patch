diff --git a/native/renderer.c b/native/renderer.c
new file mode 100644
index 0000000..b379fdb
--- /dev/null
+++ b/native/renderer.c
@@ -0,0 +1,54 @@
+#include <math.h>
+#include <stdint.h>
+
+#define WIDTH 960
+#define HEIGHT 600
+static uint8_t pixels[WIDTH * HEIGHT * 4];
+
+static double clamp(double x) { return fmax(0.0, fmin(1.0, x)); }
+
+// A supersampled, procedural cup of coffee. All pixel computation runs in Wasm.
+uint8_t *render(unsigned int seed) {
+  double phase = (seed % 10000) * 0.001;
+  for (int y = 0; y < HEIGHT; y++) {
+    for (int x = 0; x < WIDTH; x++) {
+      double rgb[3] = {0, 0, 0};
+      for (int sample = 0; sample < 4; sample++) {
+        double u = (x + (sample & 1) * 0.5 - WIDTH * 0.5) / 225.0;
+        double v = (y + (sample >> 1) * 0.5 - HEIGHT * 0.5) / 225.0;
+        double radius = sqrt(u*u + v*v);
+        double grain = sin(u * 85 + sin(v * 3 + phase) * 2) * 0.018;
+        double r = 0.24 + grain, g = 0.13 + grain, b = 0.085 + grain;
+        double handle = sqrt(pow((u - 1.03) / 0.40, 2) + pow(v / 0.28, 2));
+        if (handle < 1 && handle > 0.55) { r = 0.86; g = 0.82; b = 0.73; }
+        if (radius < 1.18) {
+          double shade = 0.87 + 0.05 * (u - v);
+          r = shade; g = shade * 0.96; b = shade * 0.87;
+        }
+        if (radius < 1.04) { r = 0.98; g = 0.95; b = 0.87; }
+        if (radius < 0.96) {
+          double swirl = sin(19 * radius + 2 * sin(atan2(v,u) * 3 + phase));
+          double crema = 0.08 * swirl + 0.09 * radius;
+          r = 0.43 + crema; g = 0.20 + crema * 0.8; b = 0.075 + crema * 0.4;
+          double vv = v + 0.09;
+          double bend = u + 0.045 * sin(v * 5 + phase);
+          double leaf = sin((vv + 0.72) * 2.1);
+          double width = fmax(0.0, leaf) * (0.43 + 0.06 * sin(phase));
+          double ripple = sin(vv * (45 + 4 * sin(phase)) + fabs(bend) * 16);
+          double foam = clamp((width - fabs(bend)) * 80) *
+            clamp((0.68 - vv) * 60) * clamp((vv + 0.72) * 60) *
+            clamp((ripple + 0.35) * 5);
+          double stem = clamp((0.018 - fabs(bend)) * 160) *
+            clamp((0.78 - vv) * 30) * clamp((vv + 0.65) * 30);
+          foam = fmax(foam, stem);
+          r += (0.99 - r) * foam; g += (0.91 - g) * foam; b += (0.72 - b) * foam;
+        }
+        rgb[0] += clamp(r); rgb[1] += clamp(g); rgb[2] += clamp(b);
+      }
+      int i = (y * WIDTH + x) * 4;
+      for (int c = 0; c < 3; c++) pixels[i+c] = (uint8_t)(rgb[c] * 255 / 4);
+      pixels[i+3] = 255;
+    }
+  }
+  return pixels;
+}
