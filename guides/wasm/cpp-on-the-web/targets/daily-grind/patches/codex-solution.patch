new file mode 100644
index 0000000..dfbf4d1
--- /dev/null
+++ b/scripts/build-wasm.mjs
@@ -0,0 +1,18 @@
+import { mkdirSync } from 'node:fs';
+import { spawnSync } from 'node:child_process';
+
+mkdirSync('src/wasm', { recursive: true });
+const assertions = process.argv.includes('--assertions');
+const result = spawnSync('emcc', [
+  'native/renderer.c', '-o', 'src/wasm/renderer.js',
+  '-Oz', '-flto', '-g0', '--no-entry',
+  '-sEXPORT_ES6=1', '-sMODULARIZE=1', '-sSTRICT=1',
+  // The module runs in a dedicated browser worker, without Node/shell support.
+  '-sENVIRONMENT=web,worker', '-sALLOW_MEMORY_GROWTH=1',
+  `-sASSERTIONS=${assertions ? 1 : 0}`,
+  '-sEXPORTED_FUNCTIONS=["_render"]',
+  '-sEXPORTED_RUNTIME_METHODS=["HEAPU8"]',
+  '-sINCOMING_MODULE_JS_API=["locateFile"]',
+], { stdio: 'inherit' });
+if (result.error) console.error('Emscripten (emcc) is required:', result.error.message);
+process.exit(result.status ?? 1);
diff --git a/src/main.ts b/src/main.ts
new file mode 100644
index 0000000..55335b8
--- /dev/null
+++ b/src/main.ts
@@ -0,0 +1,62 @@
+import { WIDTH, HEIGHT, type RenderRequest, type RenderResponse } from './protocol';
+
+function element<T extends HTMLElement>(id: string, type: new () => T): T {
+  const value = document.getElementById(id);
+  if (!(value instanceof type)) throw new Error(`Missing element: ${id}`);
+  return value;
+}
+const canvas = element('coffee-art', HTMLCanvasElement);
+const button = element('render-image', HTMLButtonElement);
+const status = element('render-status', HTMLParagraphElement);
+const context = canvas.getContext('2d');
+let worker: Worker | undefined;
+let busy = false;
+let timeout: ReturnType<typeof setTimeout> | undefined;
+
+function fail() {
+  clearTimeout(timeout);
+  worker?.terminate();
+  worker = undefined;
+  busy = false;
+  button.disabled = false;
+  canvas.setAttribute('aria-busy', 'false');
+  button.textContent = 'Try again';
+  status.textContent = 'The image could not be generated. Please try again.';
+}
+
+function render() {
+  if (busy) return;
+  busy = true;
+  button.disabled = true;
+  button.textContent = 'Brewing your image…';
+  canvas.setAttribute('aria-busy', 'true');
+  status.textContent = 'Creating your coffee art. Feel free to explore while it brews.';
+  try {
+    if (!context) { fail(); return; }
+    if (!worker) {
+      worker = new Worker(new URL('./renderer.worker.ts', import.meta.url), { type: 'module' });
+      worker.onerror = (event) => { event.preventDefault(); fail(); };
+      worker.onmessageerror = fail;
+      worker.onmessage = ({ data }: MessageEvent<RenderResponse>) => {
+        if (data.type === 'error') { fail(); return; }
+        try {
+          context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), WIDTH, HEIGHT), 0, 0);
+          canvas.hidden = false;
+          clearTimeout(timeout);
+          busy = false;
+          button.disabled = false;
+          button.textContent = 'Render a new image';
+          canvas.setAttribute('aria-busy', 'false');
+          status.textContent = `Freshly rendered in ${(data.duration / 1000).toFixed(2)} seconds. Every cup is unique.`;
+        } catch { fail(); }
+      };
+    }
+    const request: RenderRequest = { type: 'render', seed: crypto.getRandomValues(new Uint32Array(1))[0] };
+    worker.postMessage(request);
+    timeout = setTimeout(fail, 60000);
+  } catch { fail(); }
+}
+button.addEventListener('click', render);
+window.addEventListener('pagehide', () => { worker?.terminate(); worker = undefined; clearTimeout(timeout); busy = false; });
+window.addEventListener('pageshow', (event) => { if (event.persisted) render(); });
+render();
