diff --git a/src/components/WebMCPTools.tsx b/src/components/WebMCPTools.tsx
new file mode 100644
index 0000000..3bf7f73
--- /dev/null
+++ b/src/components/WebMCPTools.tsx
@@ -0,0 +1,158 @@
+import { useEffect } from "react";
+
+export default function WebMCPTools() {
+  useEffect(() => {
+    if (!document.modelContext) {
+      return;
+    }
+
+    const controller = new AbortController();
+    const { signal } = controller;
+    const baseUrl = import.meta.env.BASE_URL;
+
+    document.modelContext.registerTool(
+      {
+        name: "search-articles",
+        description:
+          "Search for articles by keyword across titles and summaries",
+        inputSchema: {
+          type: "object",
+          properties: {
+            query: {
+              type: "string",
+              description:
+                "The search term to find articles matching by title or summary",
+            },
+          },
+          required: ["query"],
+        },
+        annotations: {
+          readOnlyHint: true,
+          untrustedContentHint: true,
+        },
+        execute: async (params) => {
+          const query = params.query as string;
+          const response = await fetch(`${baseUrl}api/articles.json`);
+          const articles: Array<{
+            slug: string;
+            title: string;
+            summary: string;
+          }> = await response.json();
+          const lowerQuery = query.toLowerCase();
+          const results = articles.filter(
+            (article) =>
+              article.title.toLowerCase().includes(lowerQuery) ||
+              article.summary.toLowerCase().includes(lowerQuery)
+          );
+          return { results };
+        },
+      },
+      { signal }
+    );
+
+    document.modelContext.registerTool(
+      {
+        name: "get-reading-list",
+        description:
+          "Get the current reading list with saved article slug identifiers",
+        annotations: {
+          readOnlyHint: true,
+          untrustedContentHint: true,
+        },
+        execute: async () => {
+          const response = await fetch(`${baseUrl}api/reading-list.json`);
+          const data = await response.json();
+          return data;
+        },
+      },
+      { signal }
+    );
+
+    document.modelContext.registerTool(
+      {
+        name: "add-to-reading-list",
+        description: "Add an article to the reading list by its slug identifier",
+        inputSchema: {
+          type: "object",
+          properties: {
+            slug: {
+              type: "string",
+              description:
+                "The unique slug identifier of the article to bookmark",
+            },
+          },
+          required: ["slug"],
+        },
+        execute: async (params) => {
+          const slug = params.slug as string;
+          const getResponse = await fetch(`${baseUrl}api/reading-list.json`);
+          const { readingList } = await getResponse.json();
+          if (readingList.includes(slug)) {
+            return {
+              success: true,
+              message: "Article is already in the reading list",
+              readingList,
+            };
+          }
+          const response = await fetch(`${baseUrl}api/reading-list.json`, {
+            method: "POST",
+            headers: { "Content-Type": "application/json" },
+            body: JSON.stringify({ slug }),
+          });
+          const data = await response.json();
+          window.dispatchEvent(new CustomEvent("reading-list-updated"));
+          return { success: true, readingList: data.readingList };
+        },
+      },
+      { signal }
+    );
+
+    document.modelContext.registerTool(
+      {
+        name: "remove-from-reading-list",
+        description: "Remove an article from the reading list",
+        inputSchema: {
+          type: "object",
+          properties: {
+            slug: {
+              type: "string",
+              description:
+                "The unique slug identifier of the article to remove from the reading list",
+            },
+          },
+          required: ["slug"],
+        },
+        annotations: {
+          consequentialHint: true,
+        },
+        execute: async (params) => {
+          const slug = params.slug as string;
+          const getResponse = await fetch(`${baseUrl}api/reading-list.json`);
+          const { readingList } = await getResponse.json();
+          if (!readingList.includes(slug)) {
+            return {
+              success: true,
+              message: "Article is not in the reading list",
+              readingList,
+            };
+          }
+          const response = await fetch(`${baseUrl}api/reading-list.json`, {
+            method: "POST",
+            headers: { "Content-Type": "application/json" },
+            body: JSON.stringify({ slug }),
+          });
+          const data = await response.json();
+          window.dispatchEvent(new CustomEvent("reading-list-updated"));
+          return { success: true, readingList: data.readingList };
+        },
+      },
+      { signal }
+    );
+
+    return () => {
+      controller.abort();
+    };
+  }, []);
+
+  return null;
+}
