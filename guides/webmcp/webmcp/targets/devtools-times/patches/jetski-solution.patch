diff --git a/src/scripts/webmcp.ts b/src/scripts/webmcp.ts
new file mode 100644
index 0000000..239dcdf
--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,328 @@
+const baseUrl = import.meta.env.BASE_URL;
+
+type Article = {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+};
+
+type ReadingListResponse = {
+  readingList: string[];
+};
+
+type ReadingListChangedDetail = {
+  waitUntil: (promise: Promise<unknown>) => void;
+};
+
+let activeController: AbortController | null = null;
+
+const apiUrl = (path: string) => `${baseUrl}${path}`;
+
+const waitForUiRefresh = () =>
+  new Promise<void>((resolve) => {
+    requestAnimationFrame(() => {
+      requestAnimationFrame(() => resolve());
+    });
+  });
+
+const fetchArticles = async (): Promise<Article[]> => {
+  const response = await fetch(apiUrl('api/articles.json'));
+  if (!response.ok) {
+    throw new Error('Unable to load articles.');
+  }
+  return (await response.json()) as Article[];
+};
+
+const fetchReadingList = async (): Promise<ReadingListResponse> => {
+  const response = await fetch(apiUrl('api/reading-list.json'));
+  if (!response.ok) {
+    throw new Error('Unable to load the reading list.');
+  }
+  return (await response.json()) as ReadingListResponse;
+};
+
+const notifyReadingListChanged = async () => {
+  const refreshes: Promise<unknown>[] = [];
+
+  const detail: ReadingListChangedDetail = {
+    waitUntil: (promise) => {
+      refreshes.push(promise);
+    },
+  };
+
+  window.dispatchEvent(
+    new CustomEvent<ReadingListChangedDetail>('reading-list:changed', {
+      detail,
+    }),
+  );
+  window.dispatchEvent(
+    new CustomEvent<ReadingListChangedDetail>('reading-list-updated', {
+      detail,
+    }),
+  );
+
+  await Promise.allSettled(refreshes);
+  await waitForUiRefresh();
+};
+
+export const registerWebMcpTools = () => {
+  activeController?.abort();
+  activeController = null;
+
+  if (typeof document === 'undefined' || !document.modelContext) {
+    return;
+  }
+
+  const controller = new AbortController();
+  activeController = controller;
+  const options = { signal: controller.signal };
+
+  document.modelContext.registerTool(
+    {
+      name: 'search-articles',
+      description: 'Search for articles by keyword across titles and summaries in The DevTools Times catalog.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: {
+            type: 'string',
+            description: 'Search term to match against article titles and summaries',
+            minLength: 1,
+          },
+        },
+        required: ['query'],
+        additionalProperties: false,
+      },
+      execute: async (input: Record<string, unknown> = {}) => {
+        const query = String(input.query ?? '').trim().toLowerCase();
+        if (!query) {
+          throw new Error('A non-empty search query is required.');
+        }
+
+        const articles = await fetchArticles();
+        const results = articles
+          .filter(
+            (article) =>
+              article.title.toLowerCase().includes(query) ||
+              article.summary.toLowerCase().includes(query),
+          )
+          .map(({ slug, title, summary }) => ({ slug, title, summary }));
+
+        return { results };
+      },
+      annotations: {
+        readOnlyHint: true,
+        untrustedContentHint: true,
+      },
+    },
+    options,
+  );
+
+  document.modelContext.registerTool(
+    {
+      name: 'get-reading-list',
+      description: 'Get the current session reading list of saved articles with titles and summaries.',
+      execute: async () => {
+        const [{ readingList }, articles] = await Promise.all([
+          fetchReadingList(),
+          fetchArticles(),
+        ]);
+        const articleBySlug = new Map(articles.map((a) => [a.slug, a]));
+
+        const items = readingList.map((slug) => {
+          const article = articleBySlug.get(slug);
+          return {
+            slug,
+            title: article?.title ?? slug,
+            summary: article?.summary ?? '',
+          };
+        });
+
+        return { readingList, items };
+      },
+      annotations: {
+        readOnlyHint: true,
+        untrustedContentHint: true,
+      },
+    },
+    options,
+  );
+
+  document.modelContext.registerTool(
+    {
+      name: 'add-to-reading-list',
+      description: 'Add an article to the reading list by its unique slug identifier.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          slug: {
+            type: 'string',
+            description: 'The unique slug identifier of the article to bookmark',
+            minLength: 1,
+          },
+        },
+        required: ['slug'],
+        additionalProperties: false,
+      },
+      execute: async (input: Record<string, unknown> = {}) => {
+        const slug = String(input.slug ?? '').trim();
+        if (!slug) {
+          throw new Error('An article slug is required.');
+        }
+
+        const current = await fetchReadingList();
+        if (current.readingList.includes(slug)) {
+          return {
+            success: true,
+            message: 'Article is already in the reading list.',
+            readingList: current.readingList,
+          };
+        }
+
+        const response = await fetch(apiUrl('api/reading-list.json'), {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify({ slug }),
+        });
+
+        if (!response.ok) {
+          throw new Error('Unable to update the reading list.');
+        }
+
+        const data = (await response.json()) as ReadingListResponse;
+        await notifyReadingListChanged();
+
+        return {
+          success: true,
+          slug,
+          readingList: data.readingList,
+        };
+      },
+    },
+    options,
+  );
+
+  document.modelContext.registerTool(
+    {
+      name: 'remove-from-reading-list',
+      description: 'Remove an article from the reading list by its unique slug identifier.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          slug: {
+            type: 'string',
+            description: 'The unique slug identifier of the article to remove from the reading list',
+            minLength: 1,
+          },
+        },
+        required: ['slug'],
+        additionalProperties: false,
+      },
+      execute: async (input: Record<string, unknown> = {}) => {
+        const slug = String(input.slug ?? '').trim();
+        if (!slug) {
+          throw new Error('An article slug is required.');
+        }
+
+        const current = await fetchReadingList();
+        if (!current.readingList.includes(slug)) {
+          return {
+            success: true,
+            message: 'Article is not in the reading list.',
+            readingList: current.readingList,
+          };
+        }
+
+        const response = await fetch(apiUrl('api/reading-list.json'), {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify({ slug }),
+        });
+
+        if (!response.ok) {
+          throw new Error('Unable to update the reading list.');
+        }
+
+        const data = (await response.json()) as ReadingListResponse;
+        await notifyReadingListChanged();
+
+        return {
+          success: true,
+          slug,
+          readingList: data.readingList,
+        };
+      },
+      annotations: {
+        consequentialHint: true,
+      },
+    },
+    options,
+  );
+
+  document.modelContext.registerTool(
+    {
+      name: 'toggle-reading-list-item',
+      description: 'Toggle saving an article in the reading list by its unique slug identifier.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          slug: {
+            type: 'string',
+            description: 'The unique slug identifier of the article to toggle in the reading list',
+            minLength: 1,
+          },
+        },
+        required: ['slug'],
+        additionalProperties: false,
+      },
+      execute: async (input: Record<string, unknown> = {}) => {
+        const slug = String(input.slug ?? '').trim();
+        if (!slug) {
+          throw new Error('An article slug is required.');
+        }
+
+        const response = await fetch(apiUrl('api/reading-list.json'), {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify({ slug }),
+        });
+
+        if (!response.ok) {
+          throw new Error('Unable to update the reading list.');
+        }
+
+        const data = (await response.json()) as ReadingListResponse;
+        await notifyReadingListChanged();
+
+        return {
+          success: true,
+          slug,
+          saved: data.readingList.includes(slug),
+          readingList: data.readingList,
+        };
+      },
+    },
+    options,
+  );
+};
+
+if (typeof document !== 'undefined') {
+  document.addEventListener('astro:page-load', registerWebMcpTools);
+  document.addEventListener('astro:before-swap', () => {
+    activeController?.abort();
+    activeController = null;
+  });
+  window.addEventListener('pagehide', () => {
+    activeController?.abort();
+    activeController = null;
+  });
+
+  registerWebMcpTools();
+}
