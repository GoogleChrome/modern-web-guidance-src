+  <script>
+    (() => {
+      'use strict';
+
+      const SIZE_MULTIPLIER = { small: 0.85, regular: 1, large: 1.25 };
+      const MILK_OPTIONS = ['oat', 'whole', 'almond', 'none'];
+      const MAX_QUANTITY = 10;
+
+      /** @type {{ drink: string, size: string, milk: string | null, quantity: number, lineTotal: number }[]} */
+      const order = [];
+
+      const itemsEl = document.getElementById('order-items');
+      const emptyEl = document.getElementById('order-empty');
+      const totalEl = document.getElementById('order-total');
+      const statusEl = document.getElementById('order-status');
+
+      const formatPrice = (value) => `$${value.toFixed(2)}`;
+      const orderTotal = () => order.reduce((sum, item) => sum + item.lineTotal, 0);
+
+      const describeItem = (item) =>
+        `${item.quantity} × ${item.size} ${item.drink}` +
+        (item.milk ? ` (${item.milk === 'none' ? 'no milk' : item.milk + ' milk'})` : '') +
+        ` – ${formatPrice(item.lineTotal)}`;
+
+      function renderOrder() {
+        itemsEl.replaceChildren(
+          ...order.map((item) => {
+            const li = document.createElement('li');
+            li.textContent = describeItem(item);
+            return li;
+          })
+        );
+        emptyEl.hidden = order.length > 0;
+        totalEl.textContent = formatPrice(orderTotal());
+      }
+
+      /**
+       * Validates and adds a drink to the order. Returns a result message or throws a descriptive error.
+       * @param {HTMLFormElement} form
+       */
+      function addToOrder(form) {
+        const data = new FormData(form);
+        const drink = form.dataset.drink || '';
+        const basePrice = Number(form.dataset.price);
+        const size = String(data.get('size') || '');
+        const quantity = Number(data.get('quantity'));
+        const milkValue = data.get('milk');
+        const milk = milkValue === null ? null : String(milkValue);
+
+        if (!(size in SIZE_MULTIPLIER)) {
+          throw new Error(`Invalid size "${size}". Choose small, regular, or large.`);
+        }
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > MAX_QUANTITY) {
+          throw new Error(`Invalid quantity "${data.get('quantity')}". Enter a whole number from 1 to ${MAX_QUANTITY}.`);
+        }
+        if (milk !== null && !MILK_OPTIONS.includes(milk)) {
+          throw new Error(`Invalid milk "${milk}". Choose oat, whole, almond, or none.`);
+        }
+
+        const lineTotal = Math.round(basePrice * SIZE_MULTIPLIER[size] * quantity * 100) / 100;
+        const item = { drink, size, milk, quantity, lineTotal };
+        order.push(item);
+        renderOrder();
+
+        const message = `Added ${describeItem(item)}. Order total is now ${formatPrice(orderTotal())}.`;
+        statusEl.textContent = message;
+        return message;
+      }
+
+      document.querySelectorAll('form.order-form').forEach((form) => {
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          let result;
+          try {
+            result = { ok: true, message: addToOrder(form) };
+          } catch (error) {
+            const message = error instanceof Error ? error.message : String(error);
+            statusEl.textContent = message;
+            result = { ok: false, message };
+          }
+          // Respond to the agent after the UI has been updated (declarative WebMCP).
+          if (event.agentInvoked && typeof event.respondWith === 'function') {
+            event.respondWith(Promise.resolve(result.ok ? result.message : `Error: ${result.message}`));
+          } else if (result.ok) {
+            form.reset();
+          }
+        });
+      });
+
+      // Imperative WebMCP: read-only tool to inspect the current order.
+      if (window.isSecureContext && 'modelContext' in document && document.modelContext) {
+        const controller = new AbortController();
+        document.modelContext.registerTool(
+          {
+            name: 'get-current-order',
+            description: "Get the drinks currently in the customer's coffee order and the order total. Use to review or confirm the order.",
+            inputSchema: { type: 'object', properties: {} },
+            execute: async () => ({
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify({
+                    items: order.map(({ drink, size, milk, quantity, lineTotal }) => ({
+                      drink, size, milk, quantity, lineTotal: formatPrice(lineTotal),
+                    })),
+                    total: formatPrice(orderTotal()),
+                  }),
+                },
+              ],
+            }),
+            annotations: { readOnlyHint: true },
+          },
+          { signal: controller.signal }
+        );
+        window.addEventListener('pagehide', () => controller.abort(), { once: true });
+      }
+
+      renderOrder();
+    })();
+  </script>
+
 </body>
 
