+  <script>
+    (function () {
+      // AbortController for managing WebMCP tool lifecycle
+      const toolController = new AbortController();
+
+      // Helper to ensure tool execute functions resolve only after corresponding UI state updates have completed
+      function waitForUIUpdate() {
+        return new Promise((resolve) => {
+          requestAnimationFrame(() => {
+            requestAnimationFrame(resolve);
+          });
+        });
+      }
+
+      async function registerWebMCPTools() {
+        // Feature detect document.modelContext before calling any imperative WebMCP registration methods
+        if (typeof document === 'undefined' || !('modelContext' in document) || !document.modelContext || typeof document.modelContext.registerTool !== 'function') {
+          return;
+        }
+
+        const signal = toolController.signal;
+
+        try {
+          // Tool 1: get_seasonal_favorites (read-only query of seasonal menu items)
+          await document.modelContext.registerTool({
+            name: 'get_seasonal_favorites',
+            description: 'Retrieve the list of seasonal coffee favorites currently featured on the menu, including item names, descriptions, and details links.',
+            annotations: {
+              readOnlyHint: true
+            },
+            execute: async () => {
+              const cards = document.querySelectorAll('.card');
+              const favorites = Array.from(cards).map((card) => {
+                const titleEl = card.querySelector('h3');
+                const descEl = card.querySelector('p');
+                const linkEl = card.querySelector('a.btn');
+                return {
+                  name: titleEl ? titleEl.textContent.trim() : '',
+                  description: descEl ? descEl.textContent.trim() : '',
+                  link: linkEl ? linkEl.getAttribute('href') : ''
+                };
+              });
+
+              return {
+                content: [
+                  {
+                    type: 'text',
+                    text: JSON.stringify(favorites, null, 2)
+                  }
+                ],
+                favorites
+              };
+            }
+          }, { signal });
+
+          // Tool 2: view_item_details (view details and highlight item in UI with inputSchema)
+          await document.modelContext.registerTool({
+            name: 'view_item_details',
+            description: 'View details for a specific seasonal coffee item and highlight it on the page.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                itemName: {
+                  type: 'string',
+                  description: 'The exact name of the seasonal coffee item to view details for (e.g., "Maple Oat Latte", "Dark Roast Espresso", "Cold Brew").'
+                }
+              },
+              required: ['itemName']
+            },
+            annotations: {
+              readOnlyHint: true
+            },
+            execute: async (params) => {
+              const itemName = params && params.itemName ? String(params.itemName).toLowerCase() : '';
+              const cards = document.querySelectorAll('.card');
+              let foundItem = null;
+
+              cards.forEach((card) => {
+                const titleEl = card.querySelector('h3');
+                const cardName = titleEl ? titleEl.textContent.trim() : '';
+                if (itemName && cardName.toLowerCase().includes(itemName)) {
+                  card.classList.add('highlighted');
+                  card.scrollIntoView({ behavior: 'smooth', block: 'center' });
+                  const descEl = card.querySelector('p');
+                  const linkEl = card.querySelector('a.btn');
+                  foundItem = {
+                    name: cardName,
+                    description: descEl ? descEl.textContent.trim() : '',
+                    link: linkEl ? linkEl.getAttribute('href') : ''
+                  };
+                } else {
+                  card.classList.remove('highlighted');
+                }
+              });
+
+              // Ensure UI state updates have completed before resolving
+              await waitForUIUpdate();
+
+              if (!foundItem) {
+                return {
+                  content: [
+                    {
+                      type: 'text',
+                      text: `Item "${params?.itemName}" not found among seasonal favorites.`
+                    }
+                  ],
+                  found: false
+                };
+              }
+
+              return {
+                content: [
+                  {
+                    type: 'text',
+                    text: JSON.stringify(foundItem, null, 2)
+                  }
+                ],
+                found: true,
+                item: foundItem
+              };
+            }
+          }, { signal });
+
+          // Tool 3: get_featured_media (retrieves third-party promotional hero media)
+          await document.modelContext.registerTool({
+            name: 'get_featured_media',
+            description: 'Retrieve external third-party promotional hero media and photography details used on the page.',
+            annotations: {
+              readOnlyHint: true,
+              untrustedContentHint: true
+            },
+            execute: async () => {
+              const heroEl = document.querySelector('.hero');
+              let imageUrl = '';
+              if (heroEl) {
+                const computedBg = window.getComputedStyle(heroEl).backgroundImage || heroEl.style.backgroundImage;
+                const match = computedBg.match(/url\(["']?([^"']+)["']?\)/);
+                if (match && match[1]) {
+                  imageUrl = match[1];
+                }
+              }
+
+              const mediaInfo = {
+                type: 'hero_image',
+                source: imageUrl || 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80',
+                provider: 'Unsplash (third-party)',
+                alt: 'Coffee cup on artisanal cafe background'
+              };
+
+              return {
+                content: [
+                  {
+                    type: 'text',
+                    text: JSON.stringify(mediaInfo, null, 2)
+                  }
+                ],
+                media: mediaInfo
+              };
+            }
+          }, { signal });
+
+          // Tool 4: logout (consequential irreversible action)
+          await document.modelContext.registerTool({
+            name: 'logout',
+            description: 'Log out the current user session from The Daily Grind and return to guest state.',
+            annotations: {
+              consequentialHint: true
+            },
+            execute: async () => {
+              const logoutLink = document.querySelector('.logout-link');
+              if (logoutLink) {
+                logoutLink.textContent = 'Logged Out';
+                logoutLink.setAttribute('href', '#logged-out');
+                logoutLink.style.opacity = '0.6';
+              }
+
+              let banner = document.getElementById('session-status-banner');
+              if (!banner) {
+                banner = document.createElement('div');
+                banner.id = 'session-status-banner';
+                banner.style.background = '#ffab40';
+                banner.style.color = '#3e2723';
+                banner.style.padding = '10px';
+                banner.style.textAlign = 'center';
+                banner.style.fontWeight = 'bold';
+                const nav = document.querySelector('nav');
+                if (nav && nav.parentNode) {
+                  nav.parentNode.insertBefore(banner, nav.nextSibling);
+                }
+              }
+              banner.textContent = 'You have been successfully logged out.';
+
+              // Ensure UI state update has completed before resolving
+              await waitForUIUpdate();
+
+              return {
+                content: [
+                  {
+                    type: 'text',
+                    text: 'User successfully logged out. Session ended.'
+                  }
+                ],
+                success: true
+              };
+            }
+          }, { signal });
+
+        } catch (err) {
+          console.error('Error registering WebMCP tools:', err);
+        }
+      }
+
+      // Cleanup tool registrations using AbortController on page unload
+      window.addEventListener('pagehide', () => {
+        toolController.abort();
+      });
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', registerWebMCPTools);
+      } else {
+        registerWebMCPTools();
+      }
+
+      // Expose registration function and controller for dynamic/test invocations
+      window.registerWebMCPTools = registerWebMCPTools;
+      window.webMCPController = toolController;
+    })();
+  </script>
 </body>
 
 </html>
