+  <script>
+    (function () {
+      const MENU_CATALOG = {
+        'maple-oat-latte': {
+          id: 'maple-oat-latte',
+          toolName: 'order-maple-oat-latte',
+          title: 'Maple Oat Latte',
+          description:
+            'Place an order for a Maple Oat Latte when the user wants to purchase this seasonal maple-sweetened oat milk espresso drink.',
+          prices: { small: 4.75, medium: 5.5, large: 6.25 },
+          optionField: 'temperature',
+          validOptions: ['hot', 'iced'],
+          defaultOption: 'hot',
+          optionDescription:
+            'Serving preparation style, where hot uses velvety steamed oat milk and iced is poured chilled over artisanal cube ice.',
+          sizeDescription:
+            'Cup volume selection, where small is a compact 8 oz pour, medium is the standard 12 oz balance of espresso and oat milk, and large is a generous 16 oz serving with an extra espresso shot.',
+          quantityDescription: 'Number of Maple Oat Latte cups to prepare for this order.'
+        },
+        'dark-roast-espresso': {
+          id: 'dark-roast-espresso',
+          toolName: 'order-dark-roast-espresso',
+          title: 'Dark Roast Espresso',
+          description:
+            'Place an order for a Dark Roast Espresso when the user wants to purchase a bold, smoky dark-roasted espresso beverage.',
+          prices: { small: 3.0, medium: 3.75, large: 4.5 },
+          optionField: 'temperature',
+          validOptions: ['hot', 'iced'],
+          defaultOption: 'hot',
+          optionDescription:
+            'Serving style for the espresso, where hot is served in a preheated demitasse cup and iced is flash-chilled over ice.',
+          sizeDescription:
+            'Extraction pull volume, where small is a concentrated single ristretto shot, medium is a classic double shot, and large is an extended triple lungo pull.',
+          quantityDescription: 'Number of Dark Roast Espresso beverages to pull for this order.'
+        },
+        'cold-brew': {
+          id: 'cold-brew',
+          toolName: 'order-cold-brew',
+          title: 'Cold Brew',
+          description:
+            'Place an order for a Cold Brew when the user wants to purchase a smooth, slow-steeped cold brew coffee.',
+          prices: { small: 4.0, medium: 4.75, large: 5.5 },
+          optionField: 'iceLevel',
+          validOptions: ['light', 'regular', 'extra'],
+          defaultOption: 'regular',
+          optionDescription:
+            'Ice dilution preference, where light maximizes undiluted cold brew concentrate volume, regular provides balanced chilling, and extra keeps the beverage cold longer.',
+          sizeDescription:
+            'Serving glass volume for the steeped cold brew, where small is a 10 oz glass, medium is a 14 oz glass, and large is a 20 oz tumbler.',
+          quantityDescription: 'Number of Cold Brew cups to prepare for this order.'
+        }
+      };
+
+      const VALID_SIZES = ['small', 'medium', 'large'];
+      const MIN_QUANTITY = 1;
+      const MAX_QUANTITY = 10;
+      const RATE_LIMIT_WINDOW_MS = 1000;
+      const RATE_LIMIT_MAX_REQUESTS = 8;
+
+      const orderHistory = [];
+      const requestTimestamps = [];
+
+      function isRateLimited() {
+        const now = Date.now();
+        while (requestTimestamps.length > 0 && now - requestTimestamps[0] > RATE_LIMIT_WINDOW_MS) {
+          requestTimestamps.shift();
+        }
+        if (requestTimestamps.length >= RATE_LIMIT_MAX_REQUESTS) {
+          return true;
+        }
+        requestTimestamps.push(now);
+        return false;
+      }
+
+      function renderCardStatus(itemId, message, isError) {
+        const statusEl = document.getElementById('status-' + itemId);
+        if (!statusEl) return;
+        statusEl.textContent = message;
+        statusEl.className = 'order-status ' + (isError ? 'error' : 'success');
+      }
+
+      function renderOrderSummary() {
+        const summaryEl = document.getElementById('seasonal-order-summary');
+        if (!summaryEl) return;
+        if (orderHistory.length === 0) {
+          summaryEl.textContent = '';
+          return;
+        }
+        const totalCups = orderHistory.reduce(function (sum, entry) {
+          return sum + entry.quantity;
+        }, 0);
+        const totalCost = orderHistory.reduce(function (sum, entry) {
+          return sum + entry.totalPrice;
+        }, 0);
+        const latest = orderHistory[orderHistory.length - 1];
+        summaryEl.textContent =
+          'Cart Summary: ' +
+          totalCups +
+          (totalCups === 1 ? ' item' : ' items') +
+          ' ($' +
+          totalCost.toFixed(2) +
+          ') — Latest: ' +
+          latest.quantity +
+          'x ' +
+          latest.size +
+          ' ' +
+          latest.title +
+          ' (' +
+          latest.customization +
+          ')';
+      }
+
+      function syncFormControls(itemConfig, size, optionValue, quantity) {
+        const form = document.getElementById('form-' + itemConfig.id);
+        if (!form) return;
+        const sizeControl = form.elements.namedItem('size');
+        if (sizeControl) {
+          sizeControl.value = size;
+        }
+        const optionControl = form.elements.namedItem(itemConfig.optionField);
+        if (optionControl) {
+          optionControl.value = optionValue;
+        }
+        const quantityControl = form.elements.namedItem('quantity');
+        if (quantityControl) {
+          quantityControl.value = String(quantity);
+        }
+        const priceEl = document.querySelector('[data-price-display="' + itemConfig.id + '"]');
+        if (priceEl && itemConfig.prices[size]) {
+          priceEl.textContent = '$' + (itemConfig.prices[size] * quantity).toFixed(2);
+        }
+      }
+
+      function processCoffeeOrder(itemId, rawInput) {
+        const itemConfig = MENU_CATALOG[itemId];
+        if (!itemConfig) {
+          return {
+            isError: true,
+            content: [
+              {
+                type: 'text',
+                text: 'Unknown seasonal item requested. Please choose a valid seasonal coffee tool and retry.'
+              }
+            ]
+          };
+        }
+
+        if (isRateLimited()) {
+          const rateMsg =
+            'Too many orders submitted in a short period. Please wait a moment and retry placing the order for ' +
+            itemConfig.title +
+            '.';
+          renderCardStatus(itemId, rateMsg, true);
+          return {
+            isError: true,
+            content: [{ type: 'text', text: rateMsg }]
+          };
+        }
+
+        const input = rawInput && typeof rawInput === 'object' ? rawInput : {};
+        const rawSize = typeof input.size === 'string' ? input.size.trim().toLowerCase() : '';
+
+        if (!rawSize || VALID_SIZES.indexOf(rawSize) === -1) {
+          const sizeError =
+            'Invalid or missing size for ' +
+            itemConfig.title +
+            '. Please retry with size set to one of: ' +
+            VALID_SIZES.join(', ') +
+            '.';
+          renderCardStatus(itemId, sizeError, true);
+          return {
+            isError: true,
+            content: [{ type: 'text', text: sizeError }]
+          };
+        }
+
+        const rawQuantity = input.quantity === undefined || input.quantity === '' ? 1 : Number(input.quantity);
+        if (!Number.isInteger(rawQuantity) || rawQuantity < MIN_QUANTITY || rawQuantity > MAX_QUANTITY) {
+          const quantityError =
+            'Invalid quantity for ' +
+            itemConfig.title +
+            '. Please retry with a whole number quantity between ' +
+            MIN_QUANTITY +
+            ' and ' +
+            MAX_QUANTITY +
+            '.';
+          renderCardStatus(itemId, quantityError, true);
+          return {
+            isError: true,
+            content: [{ type: 'text', text: quantityError }]
+          };
+        }
+
+        const rawOption =
+          input[itemConfig.optionField] === undefined || input[itemConfig.optionField] === ''
+            ? itemConfig.defaultOption
+            : String(input[itemConfig.optionField]).trim().toLowerCase();
+
+        if (itemConfig.validOptions.indexOf(rawOption) === -1) {
+          const optionError =
+            'Invalid ' +
+            itemConfig.optionField +
+            ' for ' +
+            itemConfig.title +
+            '. Please retry with ' +
+            itemConfig.optionField +
+            ' set to one of: ' +
+            itemConfig.validOptions.join(', ') +
+            '.';
+          renderCardStatus(itemId, optionError, true);
+          return {
+            isError: true,
+            content: [{ type: 'text', text: optionError }]
+          };
+        }
+
+        const unitPrice = itemConfig.prices[rawSize];
+        const totalPrice = Number((unitPrice * rawQuantity).toFixed(2));
+        const orderEntry = {
+          id: itemConfig.id,
+          title: itemConfig.title,
+          size: rawSize,
+          customization: rawOption,
+          quantity: rawQuantity,
+          unitPrice: unitPrice,
+          totalPrice: totalPrice,
+          status: 'confirmed'
+        };
+
+        orderHistory.push(orderEntry);
+
+        // Update UI state synchronously before returning
+        syncFormControls(itemConfig, rawSize, rawOption, rawQuantity);
+        const confirmationText =
+          'Ordered ' +
+          rawQuantity +
+          'x ' +
+          rawSize +
+          ' ' +
+          itemConfig.title +
+          ' (' +
+          rawOption +
+          ') — $' +
+          totalPrice.toFixed(2);
+        renderCardStatus(itemId, confirmationText, false);
+        renderOrderSummary();
+
+        return {
+          isError: false,
+          content: [
+            {
+              type: 'text',
+              text: confirmationText
+            }
+          ],
+          order: orderEntry
+        };
+      }
+
+      // Wire up interactive form submissions and live price updates
+      Object.keys(MENU_CATALOG).forEach(function (itemId) {
+        const itemConfig = MENU_CATALOG[itemId];
+        const form = document.getElementById('form-' + itemId);
+        if (!form) return;
+
+        form.addEventListener('change', function () {
+          const sizeControl = form.elements.namedItem('size');
+          const quantityControl = form.elements.namedItem('quantity');
+          const priceEl = document.querySelector('[data-price-display="' + itemId + '"]');
+          if (!sizeControl || !quantityControl || !priceEl) return;
+          const selectedSize = sizeControl.value;
+          const qty = Math.max(1, Math.min(10, parseInt(quantityControl.value, 10) || 1));
+          if (itemConfig.prices[selectedSize]) {
+            priceEl.textContent = '$' + (itemConfig.prices[selectedSize] * qty).toFixed(2);
+          }
+        });
+
+        form.addEventListener('submit', function (event) {
+          event.preventDefault();
+          const formData = new FormData(form);
+          const payload = {
+            size: formData.get('size'),
+            quantity: formData.get('quantity')
+          };
+          payload[itemConfig.optionField] = formData.get(itemConfig.optionField);
+          processCoffeeOrder(itemId, payload);
+        });
+      });
+
+      // Register imperative WebMCP tools via document.modelContext with AbortSignal cleanup
+      const toolAbortController = new AbortController();
+
+      function buildToolDefinition(itemConfig) {
+        const properties = {
+          size: {
+            type: 'string',
+            enum: VALID_SIZES,
+            description: itemConfig.sizeDescription
+          },
+          quantity: {
+            type: 'integer',
+            minimum: MIN_QUANTITY,
+            maximum: MAX_QUANTITY,
+            description: itemConfig.quantityDescription
+          }
+        };
+        properties[itemConfig.optionField] = {
+          type: 'string',
+          enum: itemConfig.validOptions,
+          description: itemConfig.optionDescription
+        };
+
+        return {
+          name: itemConfig.toolName,
+          description: itemConfig.description,
+          inputSchema: {
+            type: 'object',
+            properties: properties,
+            required: ['size', 'quantity']
+          },
+          execute: async function (input) {
+            return processCoffeeOrder(itemConfig.id, input);
+          }
+        };
+      }
+
+      function registerSeasonalTools() {
+        const modelContext = document.modelContext;
+        if (!modelContext || typeof modelContext.registerTool !== 'function') {
+          return;
+        }
+        Object.keys(MENU_CATALOG).forEach(function (itemId) {
+          const itemConfig = MENU_CATALOG[itemId];
+          modelContext.registerTool(buildToolDefinition(itemConfig), {
+            signal: toolAbortController.signal
+          });
+        });
+      }
+
+      registerSeasonalTools();
+
+      window.addEventListener(
+        'pagehide',
+        function () {
+          toolAbortController.abort();
+        },
+        { once: true }
+      );
+    })();
+  </script>
 </body>
 
