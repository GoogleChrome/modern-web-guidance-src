+  <script>
+    (() => {
+      const coffees = new Map([
+        ['maple-oat-latte', 'Maple Oat Latte'],
+        ['dark-roast-espresso', 'Dark Roast Espresso'],
+        ['cold-brew', 'Cold Brew']
+      ]);
+      const orders = new Map();
+      const status = document.getElementById('order-status');
+
+      // Both the visible controls and WebMCP update the same tab-local order.
+      function orderCoffee(input) {
+        if (!input || typeof input !== 'object' || Array.isArray(input)) {
+          throw new Error('Provide a coffee and a quantity.');
+        }
+        const { coffee, quantity } = input;
+        if (!coffees.has(coffee)) {
+          throw new Error('Choose Maple Oat Latte, Dark Roast Espresso, or Cold Brew using its coffee identifier.');
+        }
+        if (!Number.isInteger(quantity) || quantity < 1 || quantity > 10) {
+          throw new Error('Quantity must be a whole number from 1 to 10.');
+        }
+        if (Object.keys(input).some(key => key !== 'coffee' && key !== 'quantity')) {
+          throw new Error('Only coffee and quantity are accepted.');
+        }
+
+        orders.set(coffee, (orders.get(coffee) || 0) + quantity);
+        const summary = Array.from(orders, ([id, count]) => `${count} × ${coffees.get(id)}`).join(', ');
+        const message = `Added ${quantity} × ${coffees.get(coffee)}. Current order in this tab: ${summary}.`;
+        status.textContent = message;
+        return { content: [{ type: 'text', text: message }] };
+      }
+
+      document.querySelectorAll('[data-order]').forEach(button => {
+        button.addEventListener('click', () => {
+          const quantity = document.getElementById(button.dataset.quantity);
+          if (!(quantity instanceof HTMLInputElement) || !quantity.reportValidity()) return;
+          try {
+            orderCoffee({ coffee: button.dataset.order, quantity: quantity.valueAsNumber });
+          } catch (error) {
+            status.textContent = error instanceof Error ? error.message : 'Unable to add coffee.';
+          }
+        });
+      });
+
+      let registration;
+      async function registerOrderingTool() {
+        if (!window.isSecureContext || !document.modelContext || registration) return;
+        const controller = new AbortController();
+        registration = controller;
+        try {
+          await document.modelContext.registerTool({
+            name: 'order-coffee',
+            description: 'Add a seasonal coffee to the current order in this browser tab. Use when the customer asks to order a drink.',
+            inputSchema: {
+              type: 'object',
+              properties: {
+                coffee: {
+                  type: 'string',
+                  enum: Array.from(coffees.keys()),
+                  description: 'The seasonal coffee to add to the order.'
+                },
+                quantity: {
+                  type: 'integer',
+                  minimum: 1,
+                  maximum: 10,
+                  description: 'The number of cups to add.'
+                }
+              },
+              required: ['coffee', 'quantity'],
+              additionalProperties: false
+            },
+            execute: async input => {
+              try {
+                return orderCoffee(input);
+              } catch (error) {
+                return {
+                  isError: true,
+                  content: [{ type: 'text', text: error instanceof Error ? error.message : 'Unable to add coffee.' }]
+                };
+              }
+            }
+          }, { signal: controller.signal });
+        } catch (error) {
+          controller.abort();
+          if (registration === controller) registration = undefined;
+          console.warn('Coffee ordering tool could not be registered.', error);
+        }
+      }
+
+      window.addEventListener('pagehide', () => {
+        registration?.abort();
+        registration = undefined;
+      });
+      window.addEventListener('pageshow', registerOrderingTool);
+      void registerOrderingTool();
+    })();
+  </script>
+
