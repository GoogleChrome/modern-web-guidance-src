+// @ts-check
+
+/**
+ * @typedef {{
+ *   name: string;
+ *   description: string;
+ *   inputSchema?: Record<string, unknown>;
+ *   execute: (input?: unknown) => Promise<unknown>;
+ *   annotations?: Record<string, boolean>;
+ * }} WebMCPTool
+ *
+ * @typedef {{
+ *   registerTool: (tool: WebMCPTool, options: { signal: AbortSignal }) => void;
+ * }} WebMCPModelContext
+ */
+
+(function registerDailyGrindTools() {
+  /** @type {Document & { modelContext?: WebMCPModelContext }} */
+  const webMCPDocument = document;
+  const modelContext = webMCPDocument.modelContext;
+
+  if (!modelContext || typeof modelContext.registerTool !== 'function') {
+    return;
+  }
+
+  const toolLifecycle = new AbortController();
+
+  window.addEventListener(
+    'pagehide',
+    () => {
+      toolLifecycle.abort();
+    },
+    { once: true }
+  );
+
+  /**
+   * Waits for pending browser work so reads taken by tools reflect the current UI.
+   * @returns {Promise<void>}
+   */
+  const afterUISettles = () =>
+    new Promise((resolve) => {
+      requestAnimationFrame(() => {
+        resolve();
+      });
+    });
+
+  /**
+   * @param {Element} card
+   */
+  const favoriteFromCard = (card) => {
+    const title = card.querySelector('h3')?.textContent?.trim() || '';
+    const description = card.querySelector('p')?.textContent?.trim() || '';
+    const detailsHref = card.querySelector('a')?.getAttribute('href') || '';
+
+    return {
+      title,
+      description,
+      detailsHref,
+    };
+  };
+
+  /** @type {WebMCPTool[]} */
+  const tools = [
+    {
+      name: 'get-seasonal-favorites',
+      description:
+        'Read the currently displayed seasonal coffee favorites and their detail links.',
+      execute: async () => {
+        await afterUISettles();
+
+        return Array.from(document.querySelectorAll('.card')).map(favoriteFromCard);
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'get-page-navigation',
+      description:
+        'Read the primary navigation, account, logout, call-to-action, and footer links on the current page.',
+      execute: async () => {
+        await afterUISettles();
+
+        return Array.from(document.querySelectorAll('a')).map((link) => ({
+          label: link.textContent?.trim() || '',
+          href: link.getAttribute('href') || '',
+          isLogout: link.classList.contains('logout-link'),
+        }));
+      },
+      annotations: { readOnlyHint: true },
+    },
+  ];
+
+  tools.forEach((tool) => {
+    modelContext.registerTool(tool, { signal: toolLifecycle.signal });
+  });
+})();
