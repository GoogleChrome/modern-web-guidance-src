@@ -207,6 +302,73 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const coffeeData = [
+      { name: 'Maple Oat Latte', roast: 'Medium', desc: 'Creamy oat milk with a hint of Vermont maple syrup.', category: 'Latte' },
+      { name: 'Dark Roast Espresso', roast: 'Dark', desc: 'Bold, smokey, and perfect for a morning boost.', category: 'Espresso' },
+      { name: 'Cold Brew', roast: 'Medium-Dark', desc: 'Steeped for 18 hours for maximum smoothness.', category: 'Cold Brew' },
+      { name: 'Ethiopian Yirgacheffe', roast: 'Light', desc: 'Floral aroma with bright citrus and berry notes.', category: 'Pour Over' },
+      { name: 'Colombian Supremo', roast: 'Medium', desc: 'Well-balanced with caramel sweetness and nutty undertones.', category: 'Drip' },
+      { name: 'French Roast', roast: 'Dark', desc: 'Intense and smoky with rich dark chocolate finish.', category: 'French Press' }
+    ];
+
+    function performAsyncSearch(formData) {
+      return new Promise((resolve) => {
+        const query = (formData.get('query') || '').toString().toLowerCase().trim();
+        const roast = (formData.get('roast') || '').toString().toLowerCase().trim();
+
+        const matched = coffeeData.filter(item => {
+          const matchesQuery = !query || item.name.toLowerCase().includes(query) || item.desc.toLowerCase().includes(query) || item.category.toLowerCase().includes(query);
+          const matchesRoast = !roast || item.roast.toLowerCase().includes(roast);
+          return matchesQuery && matchesRoast;
+        });
+
+        resolve(matched);
+      });
+    }
+
+    const form = document.querySelector('form');
+    const resultsContainer = document.getElementById('search-results');
+
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const formData = new FormData(event.target);
+      const searchPromise = performAsyncSearch(formData);
+
+      searchPromise.then((results) => {
+        if (resultsContainer) {
+          if (results.length === 0) {
+            resultsContainer.innerHTML = '<p style="text-align:center; margin-top:1.5rem;">No coffee found matching your criteria.</p>';
+          } else {
+            resultsContainer.innerHTML = `
+              <div class="grid" style="margin-top: 1.5rem;">
+                ${results.map(item => `
+                  <div class="card">
+                    <h3>${item.name}</h3>
+                    <p><strong>Roast:</strong> ${item.roast}</p>
+                    <p>${item.desc}</p>
+                  </div>
+                `).join('')}
+              </div>
+            `;
+          }
+        }
+      });
+
+      if (event.agentInvoked) {
+        event.respondWith(searchPromise);
+      }
+    });
+
+    window.addEventListener('toolactivated', ({ toolName }) => {
+      console.log(`Tool "${toolName}" was activated by the agent.`);
+    });
+
+    window.addEventListener('toolcancel', ({ toolName }) => {
+      console.log(`Tool "${toolName}" interaction was cancelled.`);
+    });
+  </script>
 </body>
 
