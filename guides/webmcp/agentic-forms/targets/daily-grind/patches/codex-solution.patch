diff --git a/coffee-finder.js b/coffee-finder.js
new file mode 100644
index 0000000..3339503
--- /dev/null
+++ b/coffee-finder.js
@@ -0,0 +1,64 @@
+// @ts-check
+
+/** @typedef {SubmitEvent & { agentInvoked?: boolean, respondWith?: (result: Promise<string>) => void }} AgentSubmitEvent */
+
+const coffees = [
+  { name: 'Maple Oat Latte', temperature: 'hot', flavor: 'sweet', description: 'Creamy oat milk with a hint of Vermont maple syrup.', url: '/menu/seasonal' },
+  { name: 'Dark Roast Espresso', temperature: 'hot', flavor: 'bold', description: 'Bold, smokey, and perfect for a morning boost.', url: '/menu/espresso' },
+  { name: 'Cold Brew', temperature: 'cold', flavor: 'smooth', description: 'Steeped for 18 hours for maximum smoothness.', url: '/menu/cold-brew' },
+];
+
+const finder = document.getElementById('coffee-finder');
+const results = document.getElementById('coffee-results');
+
+if (finder instanceof HTMLFormElement && results instanceof HTMLElement) {
+  finder.addEventListener('submit', (submitEvent) => {
+    submitEvent.preventDefault();
+    const event = /** @type {AgentSubmitEvent} */ (submitEvent);
+
+    /** @param {string} message */
+    const respond = (message) => {
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve(message));
+      }
+    };
+
+    const data = new FormData(finder);
+    const temperature = data.get('temperature');
+    const flavor = data.get('flavor');
+    if (!finder.checkValidity() || typeof temperature !== 'string' ||
+        typeof flavor !== 'string' || !['any', 'hot', 'cold'].includes(temperature) ||
+        !['any', 'sweet', 'bold', 'smooth'].includes(flavor)) {
+      const message = 'Please choose a valid temperature and flavor.';
+      results.textContent = message;
+      finder.reportValidity();
+      respond('Validation failed: ' + message);
+      return;
+    }
+
+    const matches = coffees.filter((coffee) =>
+      (temperature === 'any' || coffee.temperature === temperature) &&
+      (flavor === 'any' || coffee.flavor === flavor));
+    const summary = matches.length
+      ? `Found ${matches.length} coffee recommendation${matches.length === 1 ? '' : 's'}.`
+      : 'No coffees match those preferences. Try another flavor or choose any temperature.';
+    const content = document.createDocumentFragment();
+    const heading = document.createElement('p');
+    heading.textContent = summary;
+    content.append(heading);
+    if (matches.length) {
+      const list = document.createElement('ul');
+      for (const coffee of matches) {
+        const item = document.createElement('li');
+        const link = document.createElement('a');
+        link.href = coffee.url;
+        link.textContent = coffee.name;
+        item.append(link, ` — ${coffee.description}`);
+        list.append(item);
+      }
+      content.append(list);
+    }
+    results.replaceChildren(content);
+    respond(JSON.stringify({ summary, recommendations: matches }));
+  });
+}
