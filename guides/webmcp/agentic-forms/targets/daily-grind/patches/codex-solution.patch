+        description: 'a full-bodied dark roast with dark chocolate and caramel notes'
+      }
+    };
+
+    function findRecommendation(formData) {
+      const roast = String(formData.get('roast'));
+      const brewMethod = String(formData.get('brewMethod'));
+      const flavor = String(formData.get('flavor'));
+      const quantity = Number(formData.get('quantity'));
+      const coffee = recommendations[roast];
+      const methodLabel = finderForm.elements.brewMethod.selectedOptions[0].textContent;
+      const bagLabel = quantity === 1 ? 'bag' : 'bags';
+
+      return {
+        coffee,
+        message: `${coffee.name} is your match: ${coffee.description}. Its ${flavor} character works beautifully with ${methodLabel.toLowerCase()}. Recommended quantity: ${quantity} ${bagLabel}.`,
+        brewMethod,
+        flavor,
+        quantity
+      };
+    }
+
+    finderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      if (!finderForm.checkValidity()) {
+        finderForm.reportValidity();
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve('Unable to recommend a coffee: please provide a roast, brewing method, flavor note, and a quantity from 1 to 6.'));
+        }
+        return;
+      }
+
+      const resultPromise = Promise.resolve(findRecommendation(new FormData(finderForm)));
 
+      if (event.agentInvoked) {
+        event.respondWith(resultPromise.then((result) => result.message));
+      }
+
+      resultPromise.then((result) => {
+        resultTitle.textContent = `Meet ${result.coffee.name}.`;
+        resultCopy.textContent = result.message;
+        resultPanel.hidden = false;
+        formStatus.textContent = 'Your match is ready.';
+      });
+    });
+
+    window.addEventListener('toolactivated', (event) => {
+      if (event.toolName === 'find-coffee-recommendation') {
+        formStatus.textContent = 'An assistant is helping complete your coffee finder.';
+      }
+    });
+
+    window.addEventListener('toolcancel', (event) => {
+      if (event.toolName === 'find-coffee-recommendation') {
+        formStatus.textContent = 'Assistant interaction ended. You can continue here.';
+      }
+    });
+  </script>
+</body>
 </html>
