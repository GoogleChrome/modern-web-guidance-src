+  <script>
+    (() => {
+      const MENU = [
+        { name: 'Maple Oat Latte', roast: 'medium', temps: ['hot', 'iced'], price: 5.75, dairyFree: true, notes: ['maple', 'sweet', 'creamy', 'nutty'], description: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+        { name: 'Dark Roast Espresso', roast: 'dark', temps: ['hot'], price: 3.25, dairyFree: true, notes: ['bold', 'smoky', 'chocolate', 'bitter'], description: 'Bold, smokey, and perfect for a morning boost.' },
+        { name: 'Cold Brew', roast: 'medium', temps: ['iced'], price: 4.5, dairyFree: true, notes: ['smooth', 'chocolate', 'low acidity'], description: 'Steeped for 18 hours for maximum smoothness.' },
+        { name: 'Ethiopian Pour-Over', roast: 'light', temps: ['hot'], price: 4.95, dairyFree: true, notes: ['fruity', 'floral', 'citrus', 'bright', 'berry'], description: 'Hand-poured single origin with blueberry and jasmine notes.' },
+        { name: 'Classic Cappuccino', roast: 'dark', temps: ['hot'], price: 4.25, dairyFree: false, notes: ['creamy', 'foamy', 'rich', 'chocolate'], description: 'Equal parts espresso, steamed milk, and velvety foam.' },
+        { name: 'Vanilla Iced Latte', roast: 'medium', temps: ['iced'], price: 5.25, dairyFree: false, notes: ['vanilla', 'sweet', 'creamy'], description: 'Espresso over ice with whole milk and Madagascar vanilla.' },
+        { name: 'Honey Lavender Cortado', roast: 'light', temps: ['hot'], price: 4.75, dairyFree: false, notes: ['floral', 'honey', 'sweet', 'lavender'], description: 'Light roast espresso cut with lavender-honey steamed milk.' },
+        { name: 'Mocha Almond Freddo', roast: 'dark', temps: ['iced'], price: 5.95, dairyFree: true, notes: ['chocolate', 'nutty', 'almond', 'rich'], description: 'Shaken espresso with cocoa and almond milk over ice.' },
+      ];
+
+      const form = document.getElementById('coffee-finder-form');
+      const statusEl = document.getElementById('finder-status');
+      const resultsEl = document.getElementById('finder-results');
+      if (!form || !statusEl || !resultsEl) return;
+
+      const ROASTS = ['any', 'light', 'medium', 'dark'];
+      const TEMPS = ['any', 'hot', 'iced'];
+
+      const readCriteria = (data) => {
+        const errors = [];
+        const flavor = String(data.get('flavor') ?? '').trim().toLowerCase();
+        const roast = String(data.get('roast') ?? 'any');
+        const temperature = String(data.get('temperature') ?? 'any');
+        const maxPriceRaw = String(data.get('maxPrice') ?? '').trim();
+        const dairyFree = data.get('dairyFree') === 'yes';
+
+        if (!ROASTS.includes(roast)) {
+          errors.push({ field: 'roast', message: `must be one of ${ROASTS.join(', ')}` });
+        }
+        if (!TEMPS.includes(temperature)) {
+          errors.push({ field: 'temperature', message: `must be one of ${TEMPS.join(', ')}` });
+        }
+        let maxPrice = null;
+        if (maxPriceRaw !== '') {
+          maxPrice = Number(maxPriceRaw);
+          if (!Number.isFinite(maxPrice) || maxPrice <= 0) {
+            errors.push({ field: 'maxPrice', message: 'must be a positive number of dollars' });
+          }
+        }
+        return { errors, criteria: { flavor, roast, temperature, maxPrice, dairyFree } };
+      };
+
+      const findMatches = ({ flavor, roast, temperature, maxPrice, dairyFree }) =>
+        MENU.filter((drink) =>
+          (roast === 'any' || drink.roast === roast) &&
+          (temperature === 'any' || drink.temps.includes(temperature)) &&
+          (maxPrice === null || drink.price <= maxPrice) &&
+          (!dairyFree || drink.dairyFree) &&
+          (!flavor ||
+            drink.notes.some((note) => note.includes(flavor) || flavor.includes(note)) ||
+            drink.name.toLowerCase().includes(flavor) ||
+            drink.description.toLowerCase().includes(flavor))
+        );
+
+      const formatPrice = (price) => `$${price.toFixed(2)}`;
+
+      const renderResults = (matches) => {
+        resultsEl.replaceChildren(
+          ...matches.map((drink) => {
+            const card = document.createElement('div');
+            card.className = 'card';
+            const title = document.createElement('h3');
+            title.textContent = drink.name;
+            const desc = document.createElement('p');
+            desc.textContent = drink.description;
+            const meta = document.createElement('p');
+            const price = document.createElement('span');
+            price.className = 'price';
+            price.textContent = formatPrice(drink.price);
+            meta.append(price, ` · ${drink.roast} roast · ${drink.temps.join(' or ')}${drink.dairyFree ? ' · dairy-free' : ''}`);
+            card.append(title, desc, meta);
+            return card;
+          })
+        );
+      };
+
+      const summarize = (matches) => {
+        if (matches.length === 0) {
+          return 'No drinks on The Daily Grind menu match those preferences. Try loosening the roast, temperature, price, or flavor filters.';
+        }
+        const lines = matches.map((d) =>
+          `- ${d.name} (${formatPrice(d.price)}; ${d.roast} roast; ${d.temps.join('/')}${d.dairyFree ? '; dairy-free' : ''}): ${d.description}`
+        );
+        return `Found ${matches.length} matching drink${matches.length === 1 ? '' : 's'}:\n${lines.join('\n')}`;
+      };
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        const { errors, criteria } = readCriteria(new FormData(form));
+
+        if (errors.length > 0) {
+          const errorString = 'Validation failed: ' +
+            errors.map((err) => `${err.field} (${err.message})`).join(', ');
+          statusEl.textContent = errorString;
+          resultsEl.replaceChildren();
+          if (event.agentInvoked) {
+            event.respondWith(Promise.resolve(errorString));
+          }
+          return;
+        }
+
+        const matches = findMatches(criteria);
+        renderResults(matches);
+        statusEl.textContent = matches.length === 0
+          ? 'No matches found — try adjusting your preferences.'
+          : `We found ${matches.length} drink${matches.length === 1 ? '' : 's'} for you.`;
+
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(summarize(matches)));
+        }
+      });
+
+      // WebMCP lifecycle events. Chrome 156+ dispatches on document.modelContext;
+      // older versions dispatch on window.
+      const targetFor = (type, listener, options) =>
+        (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+          .addEventListener(type, listener, options);
+
+      targetFor('toolactivated', ({ toolName }) => {
+        if (toolName === form.getAttribute('toolname')) {
+          statusEl.textContent = 'Your assistant is searching the menu for you…';
+        }
+      });
+
+      targetFor('toolcancel', ({ toolName }) => {
+        if (toolName === form.getAttribute('toolname')) {
+          statusEl.textContent = 'Search cancelled.';
+        }
+      });
+    })();
+  </script>
+
 </body>
 
