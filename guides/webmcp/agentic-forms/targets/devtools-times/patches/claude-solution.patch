+}
+
+/* WebMCP Declarative API: visual feedback while an agent interacts with a form. */
+form:tool-form-active {
+  outline: 2px dashed #2563eb;
+  outline-offset: 2px;
+  background-color: rgba(37, 99, 235, 0.05);
+}
+
+button:tool-submit-active {
+  outline: 2px dashed #dc2626;
+  outline-offset: 2px;
+  animation: tool-submit-pulse 2s infinite;
+}
+
+@keyframes tool-submit-pulse {
+  0%,
+  100% {
+    opacity: 1;
+  }
+  50% {
+    opacity: 0.6;
+  }
 }
