@@ -152,6 +152,41 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Cross-Document View Transitions Configuration */
+    @media (prefers-reduced-motion: reduce) {
+      @view-transition {
+        navigation: enabled;
+      }
+    }
+
+    /* Custom directional animations */
+    :active-view-transition(next)::view-transition-old(body) {
+      animation: 0.4s ease-in both slide-out-next;
+    }
+    :active-view-transition(next)::view-transition-new(body) {
+      animation: 0.4s ease-out both slide-in-next;
+    }
+
+    :active-view-transition(previous)::view-transition-old(body) {
+      animation: 0.4s ease-in both slide-out-previous;
+    }
+    :active-view-transition(previous)::view-transition-new(body) {
+      animation: 0.4s ease-out both slide-in-previous;
+    }
+
+    @keyframes slide-out-next {
+      to { transform: translateX(-100%); }
+    }
+    @keyframes slide-in-next {
+      from { transform: translateX(100%); }
+    }
+    @keyframes slide-out-previous {
+      to { transform: translateX(100%); }
+    }
+    @keyframes slide-in-previous {
+      from { transform: translateX(-100%); }
+    }
   </style>
 </head>
 
