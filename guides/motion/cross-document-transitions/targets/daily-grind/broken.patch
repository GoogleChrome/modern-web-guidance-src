   </footer>
 
+  <script>
+    // Determine the view transition direction based on navigation urls
+    function getTransitionType(from, to) {
+      if (!from || !to) return 'next';
+      // Fallback/heuristic for home transitions
+      if (to.endsWith('/') || to.endsWith('index.html')) {
+        return 'previous';
+      }
+      return 'next';
+    }
+
+    // Capture the page reveal event to apply the correct transition type dynamically
+    window.addEventListener("pagereveal", async (e) => {
+      if (e.viewTransition && window.navigation?.activation) {
+        const fromUrl = window.navigation.activation.from?.url;
+        const toUrl = window.navigation.activation.entry?.url;
+        const transitionType = getTransitionType(fromUrl, toUrl);
+        // Attempt to assign the computed type to the view transition object
+        e.viewTransition.type = transitionType;
+      }
+    });
+  </script>
+
 </body>
 
 </html>
