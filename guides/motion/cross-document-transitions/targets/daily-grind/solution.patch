+  <script>
+    // Register pagereveal event listener to dynamically add transition types
+    window.addEventListener("pagereveal", (e) => {
+      if (e.viewTransition && window.navigation?.activation) {
+        const from = window.navigation.activation.from;
+        const entry = window.navigation.activation.entry;
+        
+        if (from && entry) {
+          const fromIndex = from.index;
+          const toIndex = entry.index;
+          
+          if (fromIndex !== -1 && toIndex !== -1) {
+            if (toIndex > fromIndex) {
+              e.viewTransition.types.add("next");
+            } else if (toIndex < fromIndex) {
+              e.viewTransition.types.add("previous");
+            }
+          } else {
+            // Fallback navigation type logic
+            const navigationType = window.navigation.activation.navigationType;
+            if (navigationType === "push") {
+              e.viewTransition.types.add("next");
+            } else if (navigationType === "traverse") {
+              e.viewTransition.types.add("previous");
+            }
+          }
+        } else {
+          // Default fallbacks if from/entry are not fully populated
+          const navigationType = window.navigation.activation.navigationType;
+          if (navigationType === "push") {
+            e.viewTransition.types.add("next");
+          }
+        }
+      }
+    });
+  </script>
