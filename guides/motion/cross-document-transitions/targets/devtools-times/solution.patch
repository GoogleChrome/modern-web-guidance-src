+}
+
+/* 1. Opt-in to Cross-Document View Transitions under media query for reduced motion */
+@media (prefers-reduced-motion: no-preference) {
+  @view-transition {
+    navigation: auto;
+  }
+}
+
+/* 2. Page-level transition animations using old/new root for fade effects */
+::view-transition-old(root) {
+  animation: 0.3s ease-in both fade-out;
+}
+
+::view-transition-new(root) {
+  animation: 0.3s ease-out both fade-in;
+}
+
+/* 3. Custom animations for different transition types using :active-view-transition-type() */
+:active-view-transition-type(next)::view-transition-old(root) {
+  animation: 0.4s ease-in both slide-out-next;
+}
+
+:active-view-transition-type(next)::view-transition-new(root) {
+  animation: 0.4s ease-out both slide-in-next;
+}
+
+:active-view-transition-type(previous)::view-transition-old(root) {
+  animation: 0.4s ease-in both slide-out-previous;
+}
+
+:active-view-transition-type(previous)::view-transition-new(root) {
+  animation: 0.4s ease-out both slide-in-previous;
+}
+
+/* Keyframes for fade and slide animations */
+@keyframes fade-out {
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes fade-in {
+  from {
+    opacity: 0;
+  }
+}
+
+@keyframes slide-out-next {
+  to {
+    transform: translateX(-100%);
+    opacity: 0;
+  }
+}
+
+@keyframes slide-in-next {
+  from {
+    transform: translateX(100%);
+  }
+}
+
+@keyframes slide-out-previous {
+  to {
+    transform: translateX(100%);
+    opacity: 0;
+  }
+}
+
+@keyframes slide-in-previous {
+  from {
+    transform: translateX(-100%);
+  }
+}
