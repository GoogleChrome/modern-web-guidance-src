+    <script is:inline>
+      window.addEventListener("pagereveal", async (e) => {
+        if (!e.viewTransition) return;
+
+        // Helper to get depth/hierarchy score of a URL path
+        function getDepth(urlStr) {
+          try {
+            const url = new URL(urlStr, window.location.origin);
+            const path = url.pathname.replace(/\/$/, ""); // remove trailing slash
+            const segments = path.split("/").filter(Boolean);
+            
+            // Remove base path 'devtools-times' if present
+            if (segments[0] === 'devtools-times') {
+              segments.shift();
+            }
+            
+            if (segments.length === 0) return 0; // Home
+            if (segments[0] === 'category') return 1;
+            if (segments[0] === 'articles') return 2;
+            if (segments[0] === 'multimedia') return segments.length > 1 ? 2 : 1;
+            if (segments[0] === 'reports') return segments.length > 1 ? 2 : 1;
+            return 1; // default
+          } catch (err) {
+            return 0;
+          }
+        }
+
+        let fromUrl = null;
+        let entryUrl = window.location.href;
+
+        if (window.navigation?.activation) {
+          const from = window.navigation.activation.from;
+          const entry = window.navigation.activation.entry;
+          
+          if (from && entry) {
+            const fromIndex = from.index;
+            const entryIndex = entry.index;
+            
+            if (typeof fromIndex === 'number' && typeof entryIndex === 'number' && fromIndex !== entryIndex) {
+              if (entryIndex > fromIndex) {
+                e.viewTransition.types.add("next");
+                return;
+              } else {
+                e.viewTransition.types.add("previous");
+                return;
+              }
+            }
+            fromUrl = from.url;
+            entryUrl = entry.url;
+          }
+        }
+
+        if (!fromUrl && document.referrer) {
+          fromUrl = document.referrer;
+        }
+
+        if (fromUrl) {
+          const fromDepth = getDepth(fromUrl);
+          const entryDepth = getDepth(entryUrl);
+          
+          if (entryDepth > fromDepth) {
+            e.viewTransition.types.add("next");
+          } else if (entryDepth < fromDepth) {
+            e.viewTransition.types.add("previous");
+          }
+        }
+      });
+    </script>
   </head>
