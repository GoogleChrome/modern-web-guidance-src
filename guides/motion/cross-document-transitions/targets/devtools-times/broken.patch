   font-style: normal;
-}
\ No newline at end of file
+}
+
+/* Enable cross-document view transitions for same-origin navigations */
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: enabled;
+  }
+}
+
+/* Page transitions */
+body.next {
+  &::view-transition-old(body) {
+    animation: 0.4s ease-in both slide-out-next;
+  }
+  &::view-transition-new(body) {
+    animation: 0.4s ease-out both slide-in-next;
+  }
+}
+
+body.previous {
+  &::view-transition-old(body) {
+    animation: 0.4s ease-in both slide-out-prev;
+  }
+  &::view-transition-new(body) {
+    animation: 0.4s ease-out both slide-in-prev;
+  }
+}
+
+@keyframes slide-out-next {
+  to {
+    transform: translateX(-100%);
+    opacity: 0;
+  }
+}
+
+@keyframes slide-in-next {
+  from {
+    transform: translateX(100%);
+  }
+}
+
+@keyframes slide-out-prev {
+  to {
+    transform: translateX(100%);
+    opacity: 0;
+  }
+}
+
+@keyframes slide-in-prev {
+  from {
+    transform: translateX(-100%);
+  }
+}
