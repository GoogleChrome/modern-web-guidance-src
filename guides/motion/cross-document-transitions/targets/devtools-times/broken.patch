diff --git a/src/layouts/Layout.astro b/src/layouts/Layout.astro
index dcf9696..0dce9eb 100644
--- a/src/layouts/Layout.astro
+++ b/src/layouts/Layout.astro
@@ -35,6 +35,37 @@ const baseUrl = import.meta.env.BASE_URL;
     <link rel="icon" href=`${baseUrl}/favicon.svg` />
 
     <ClientRouter />
+
+    <script is:inline>
+      // Helper to determine navigation transition direction
+      function getTransitionDirection(from, to) {
+        if (!from || !to) return 'next';
+        const fromPath = new URL(from.url).pathname;
+        const toPath = new URL(to.url).pathname;
+
+        // Transition from home to details or listing is "next"
+        if (fromPath === '/' && toPath !== '/') {
+          return 'next';
+        }
+        // Transition back to home is "previous"
+        if (fromPath !== '/' && toPath === '/') {
+          return 'previous';
+        }
+        return 'next';
+      }
+
+      window.addEventListener("pagereveal", (e) => {
+        if (e.viewTransition && window.navigation?.activation) {
+          const from = window.navigation.activation.from;
+          const to = window.navigation.activation.entry;
+          const direction = getTransitionDirection(from, to);
+
+          // Legacy: Instead of utilizing e.viewTransition.types.add(),
+          // we modify classes on body to trigger CSS transitions
+          document.body.classList.add(direction);
+        }
+      });
+    </script>
   </head>
   <body class="bg-gray-100">
     <div class="mx-auto">
diff --git a/src/styles/global.css b/src/styles/global.css
