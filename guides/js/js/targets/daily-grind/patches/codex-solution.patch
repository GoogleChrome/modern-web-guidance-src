diff --git a/menu.js b/menu.js
new file mode 100644
index 0000000..ebd117e
--- /dev/null
+++ b/menu.js
@@ -0,0 +1,147 @@
+(() => {
+  'use strict';
+
+  const categories = new Map([
+    ['seasonal', 'Seasonal'], ['espresso', 'Espresso'], ['cold-brew', 'Cold Brew'],
+  ]);
+  const menu = Object.freeze([
+    { id: 'maple-oat-latte', name: 'Maple Oat Latte', category: 'seasonal', price: 575, description: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+    { id: 'dark-roast-espresso', name: 'Dark Roast Espresso', category: 'espresso', price: 300, description: 'Bold, smokey, and perfect for a morning boost.' },
+    { id: 'cold-brew', name: 'Cold Brew', category: 'cold-brew', price: 450, description: 'Steeped for 18 hours for maximum smoothness.' },
+    { id: 'cinnamon-latte', name: 'Cinnamon Latte', category: 'seasonal', price: 550, description: 'Warming cinnamon with silky steamed milk.' },
+    { id: 'cappuccino', name: 'Cappuccino', category: 'espresso', price: 425, description: 'Rich espresso with a cloud of milk foam.' },
+    { id: 'vanilla-cold-brew', name: 'Vanilla Cold Brew', category: 'cold-brew', price: 500, description: 'Our smooth cold brew with fragrant vanilla.' },
+  ].map((item) => Object.freeze(item)));
+  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+  const price = (cents) => money.format(cents / 100);
+
+  // Validate required elements once so later DOM access has a known element type.
+  function element(id, type = HTMLElement) {
+    const found = document.getElementById(id);
+    if (!(found instanceof type)) throw new Error(`Missing or invalid element: ${id}`);
+    return found;
+  }
+  const controls = element('menu-controls');
+  const category = element('category', HTMLSelectElement);
+  const sort = element('sort', HTMLSelectElement);
+  const reverse = element('reverse', HTMLInputElement);
+  const group = element('group', HTMLInputElement);
+  const milk = element('milk', HTMLSelectElement);
+  const note = element('customer-note', HTMLInputElement);
+  const restore = element('restore-snapshot', HTMLButtonElement);
+  let order = [];
+  let snapshot = null;
+
+  function node(tag, text, className) {
+    const result = document.createElement(tag);
+    if (text !== undefined) result.textContent = text;
+    if (className) result.className = className;
+    return result;
+  }
+
+  function state() {
+    return { category: category.value, sort: sort.value, reverse: reverse.checked, group: group.checked };
+  }
+
+  function readURL() {
+    const params = new URLSearchParams(window.location.search);
+    const requestedCategory = params.get('category');
+    category.value = categories.has(requestedCategory) ? requestedCategory : 'all';
+    const requestedSort = params.get('sort');
+    sort.value = ['featured', 'price-asc', 'price-desc'].includes(requestedSort) ? requestedSort : 'featured';
+    reverse.checked = params.get('reverse') === 'true';
+    group.checked = params.get('group') === 'true';
+  }
+
+  function card(item) {
+    const result = node('article', undefined, 'card');
+    result.dataset.itemId = item.id;
+    const add = node('button', 'Add to Order', 'btn');
+    add.type = 'button';
+    add.setAttribute('aria-label', `Add ${item.name} to Order`);
+    add.addEventListener('click', () => {
+      order = [...order, {
+        menuId: item.id, name: item.name, price: item.price,
+        options: { milk: milk.value, customer: { note: note.value } },
+        addedAt: new Date(),
+      }];
+      renderOrder();
+      element('order-status').textContent = `${item.name} added to your order.`;
+    });
+    result.append(node('h3', item.name), node('p', item.description), node('p', price(item.price), 'price'), add);
+    return result;
+  }
+
+  function renderMenu() {
+    const current = state();
+    let items = menu.filter((item) => current.category === 'all' || item.category === current.category);
+    if (current.sort !== 'featured') {
+      items = items.toSorted((a, b) => current.sort === 'price-asc' ? a.price - b.price : b.price - a.price);
+    }
+    if (current.reverse) items = items.toReversed();
+    const content = document.createDocumentFragment();
+    if (current.group) {
+      const groups = Object.groupBy(items, (item) => item.category);
+      for (const [key, label] of categories) {
+        const bucket = groups[key] ?? [];
+        const section = node('section', undefined, 'menu-category');
+        section.append(node('h3', `${label} (${bucket.length})`));
+        if (bucket.length) {
+          const grid = node('div', undefined, 'grid');
+          grid.replaceChildren(...bucket.map(card));
+          section.append(grid);
+        } else {
+          section.append(node('p', 'No drinks match the current filter.'));
+        }
+        content.append(section);
+      }
+    } else {
+      const grid = node('div', undefined, 'grid');
+      grid.replaceChildren(...items.map(card));
+      content.append(grid);
+    }
+    element('menu-items').replaceChildren(content);
+    element('menu-count').textContent = `${items.length} drinks shown`;
+    const url = new URL(window.location.href);
+    for (const [key, value] of Object.entries(current)) url.searchParams.set(key, String(value));
+    window.history.replaceState(window.history.state, '', url);
+    controls.dispatchEvent(new CustomEvent('daily-grind:filter-change', { bubbles: true, detail: current }));
+  }
+
+  function renderOrder() {
+    const rows = order.map((item) => {
+      const row = node('li');
+      const timestamp = node('time', item.addedAt.toLocaleString());
+      timestamp.dateTime = item.addedAt.toISOString();
+      row.append(node('strong', `${item.name} — ${price(item.price)}`),
+        node('p', `Milk: ${item.options.milk}. Note: ${item.options.customer.note || 'None'}`), timestamp);
+      return row;
+    });
+    element('order-items').replaceChildren(...rows);
+    element('order-total').textContent = order.length
+      ? `${order.length} drink${order.length === 1 ? '' : 's'} · Total: ${price(order.reduce((sum, item) => sum + item.price, 0))}`
+      : 'Your draft order is empty.';
+  }
+
+  controls.addEventListener('change', renderMenu);
+  window.addEventListener('popstate', () => { readURL(); renderMenu(); });
+  element('save-snapshot').addEventListener('click', () => {
+    snapshot = structuredClone(order);
+    restore.disabled = false;
+    element('order-status').textContent = 'Snapshot saved.';
+  });
+  restore.addEventListener('click', () => {
+    if (snapshot === null) return;
+    order = structuredClone(snapshot);
+    renderOrder();
+    element('order-status').textContent = 'Snapshot restored.';
+  });
+  element('clear-order').addEventListener('click', () => {
+    order = [];
+    renderOrder();
+    element('order-status').textContent = 'Draft order cleared.';
+  });
+  readURL();
+  renderMenu();
+  renderOrder();
+})();
