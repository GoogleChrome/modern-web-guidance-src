diff --git a/scripts/app.js b/scripts/app.js
new file mode 100644
index 0000000..dfea6eb
--- /dev/null
+++ b/scripts/app.js
@@ -0,0 +1,275 @@
+const DRINKS = [
+  {
+    id: 'maple-oat-latte',
+    name: 'Maple Oat Latte',
+    category: 'seasonal',
+    categoryName: 'Seasonal',
+    price: 5.65,
+    description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+  },
+  {
+    id: 'dark-roast-espresso',
+    name: 'Dark Roast Espresso',
+    category: 'espresso',
+    categoryName: 'Espresso',
+    price: 3.45,
+    description: 'Bold, smokey, and perfect for a morning boost.',
+  },
+  {
+    id: 'cold-brew',
+    name: 'Cold Brew',
+    category: 'cold-brew',
+    categoryName: 'Cold Brew',
+    price: 4.40,
+    description: 'Steeped for 18 hours for maximum smoothness.',
+  },
+  {
+    id: 'toasted-pecan-macchiato',
+    name: 'Toasted Pecan Macchiato',
+    category: 'seasonal',
+    categoryName: 'Seasonal',
+    price: 6.10,
+    description: 'Espresso marked with steamed milk and toasted pecan praline.',
+  },
+  {
+    id: 'ristretto-cortado',
+    name: 'Ristretto Cortado',
+    category: 'espresso',
+    categoryName: 'Espresso',
+    price: 4.25,
+    description: 'Sweet ristretto shots equalized with silky microfoam.',
+  },
+  {
+    id: 'salted-caramel-cold-brew',
+    name: 'Salted Caramel Cold Brew',
+    category: 'cold-brew',
+    categoryName: 'Cold Brew',
+    price: 5.45,
+    description: 'Slow-steeped cold brew swirled with sea-salt caramel.',
+  },
+];
+
+const CATEGORY_DEFINITIONS = [
+  { id: 'seasonal', label: 'Seasonal' },
+  { id: 'espresso', label: 'Espresso' },
+  { id: 'cold-brew', label: 'Cold Brew' },
+];
+
+function getInitialFilters() {
+  const url = new URL(window.location.href);
+  return {
+    filter: url.searchParams.get('filter') || 'all',
+    order: url.searchParams.get('order') || 'featured',
+    desc: url.searchParams.get('desc') === '1',
+    grouped: url.searchParams.get('grouped') === '1',
+  };
+}
+
+function syncBrowserUrl(filters) {
+  const url = new URL(window.location.href);
+  if (filters.filter === 'all') url.searchParams.delete('filter');
+  else url.searchParams.set('filter', filters.filter);
+
+  if (filters.order === 'featured') url.searchParams.delete('order');
+  else url.searchParams.set('order', filters.order);
+
+  if (filters.desc) url.searchParams.set('desc', '1');
+  else url.searchParams.delete('desc');
+
+  if (filters.grouped) url.searchParams.set('grouped', '1');
+  else url.searchParams.delete('grouped');
+
+  window.history.replaceState(null, '', url.pathname + url.search + url.hash);
+}
+
+const filters = getInitialFilters();
+let orderState = {
+  lines: [],
+  tags: new Set(['pickup']),
+  lastModified: new Date(),
+};
+let storedSnapshot = null;
+
+const controlsPanel = document.getElementById('menu-controls');
+const categoryPicker = document.getElementById('category-picker');
+const sortPicker = document.getElementById('sort-picker');
+const reverseToggle = document.getElementById('reverse-toggle');
+const groupToggle = document.getElementById('group-toggle');
+const badgesContainer = document.getElementById('category-badges');
+const drinkGrid = document.getElementById('drink-grid');
+const cardTemplate = document.getElementById('card-template');
+
+const milkChoice = document.getElementById('milk-choice');
+const specialNote = document.getElementById('special-note');
+const snapshotSaveBtn = document.getElementById('snapshot-save');
+const snapshotRestoreBtn = document.getElementById('snapshot-restore');
+const draftClearBtn = document.getElementById('draft-clear');
+const draftList = document.getElementById('draft-list');
+const draftPlaceholder = document.getElementById('draft-placeholder');
+const snapshotMsg = document.getElementById('snapshot-msg');
+
+function deriveDisplayedDrinks() {
+  const matching = DRINKS.filter(
+    (item) => filters.filter === 'all' || item.category === filters.filter,
+  );
+
+  let sorted = matching;
+  switch (filters.order) {
+    case 'price_asc':
+      sorted = matching.toSorted((a, b) => a.price - b.price);
+      break;
+    case 'price_desc':
+      sorted = matching.toSorted((a, b) => b.price - a.price);
+      break;
+    case 'alpha':
+      sorted = matching.toSorted((a, b) => a.name.localeCompare(b.name));
+      break;
+    default:
+      break;
+  }
+
+  return filters.desc ? sorted.toReversed() : sorted;
+}
+
+function instantiateCard(drink) {
+  const fragment = cardTemplate.content.cloneNode(true);
+  const card = fragment.firstElementChild;
+  card.querySelector('[data-field="name"]').textContent = drink.name;
+  card.querySelector('[data-field="category"]').textContent = drink.categoryName;
+  card.querySelector('[data-field="price"]').textContent = `$${drink.price.toFixed(2)}`;
+  card.querySelector('[data-field="description"]').textContent = drink.description;
+  card.querySelector('[data-action="add"]').addEventListener('click', () => {
+    orderState.lines.push({
+      id: drink.id,
+      name: drink.name,
+      price: drink.price,
+      prefs: {
+        milk: milkChoice.value,
+        note: specialNote.value.trim() || 'Regular',
+        extras: new Set([milkChoice.value]),
+      },
+      createdAt: new Date(),
+    });
+    orderState.lastModified = new Date();
+    renderDraft();
+  });
+  return card;
+}
+
+function renderDrinks() {
+  const displayed = deriveDisplayedDrinks();
+  const groupedMap = Map.groupBy(displayed, (d) => d.category);
+
+  const badgeNodes = CATEGORY_DEFINITIONS.map((cat) => {
+    const items = groupedMap.get(cat.id) ?? [];
+    const badge = document.createElement('span');
+    badge.className = 'count-pill';
+    badge.textContent = `${cat.label}: ${items.length}`;
+    return badge;
+  });
+  badgesContainer.replaceChildren(...badgeNodes);
+
+  if (filters.grouped) {
+    drinkGrid.className = 'grouped-stack';
+    const sectionNodes = [];
+    for (const cat of CATEGORY_DEFINITIONS) {
+      const bucket = groupedMap.get(cat.id) ?? [];
+      if (bucket.length === 0) continue;
+      const groupSection = document.createElement('section');
+      groupSection.className = 'category-bucket';
+      const title = document.createElement('h3');
+      title.textContent = `${cat.label} (${bucket.length})`;
+      const cardsWrap = document.createElement('div');
+      cardsWrap.className = 'grid';
+      cardsWrap.replaceChildren(...bucket.map(instantiateCard));
+      groupSection.replaceChildren(title, cardsWrap);
+      sectionNodes.push(groupSection);
+    }
+    drinkGrid.replaceChildren(...sectionNodes);
+  } else {
+    drinkGrid.className = 'grid';
+    drinkGrid.replaceChildren(...displayed.map(instantiateCard));
+  }
+}
+
+function renderDraft() {
+  if (orderState.lines.length === 0) {
+    draftList.replaceChildren();
+    draftPlaceholder.hidden = false;
+    return;
+  }
+
+  draftPlaceholder.hidden = true;
+  const listNodes = orderState.lines.map((line) => {
+    const li = document.createElement('li');
+    const title = document.createElement('span');
+    title.textContent = `${line.name} (${line.prefs.milk}, ${line.prefs.note})`;
+    const meta = document.createElement('span');
+    meta.textContent = `$${line.price.toFixed(2)} • ${line.createdAt.toLocaleTimeString()}`;
+    li.replaceChildren(title, meta);
+    return li;
+  });
+  draftList.replaceChildren(...listNodes);
+}
+
+function emitStateEvent() {
+  const ev = new CustomEvent('daily-grind:filter-change', {
+    detail: { ...filters },
+    bubbles: true,
+    cancelable: false,
+  });
+  controlsPanel.dispatchEvent(ev);
+}
+
+function onFilterUpdated() {
+  syncBrowserUrl(filters);
+  renderDrinks();
+  emitStateEvent();
+}
+
+categoryPicker.value = filters.filter;
+sortPicker.value = filters.order;
+reverseToggle.checked = filters.desc;
+groupToggle.checked = filters.grouped;
+
+categoryPicker.addEventListener('change', () => {
+  filters.filter = categoryPicker.value;
+  onFilterUpdated();
+});
+
+sortPicker.addEventListener('change', () => {
+  filters.order = sortPicker.value;
+  onFilterUpdated();
+});
+
+reverseToggle.addEventListener('change', () => {
+  filters.desc = reverseToggle.checked;
+  onFilterUpdated();
+});
+
+groupToggle.addEventListener('change', () => {
+  filters.grouped = groupToggle.checked;
+  onFilterUpdated();
+});
+
+snapshotSaveBtn.addEventListener('click', () => {
+  storedSnapshot = structuredClone(orderState);
+  snapshotMsg.textContent = `Saved snapshot with ${storedSnapshot.lines.length} drink(s).`;
+});
+
+snapshotRestoreBtn.addEventListener('click', () => {
+  if (!storedSnapshot) return;
+  orderState = structuredClone(storedSnapshot);
+  renderDraft();
+  snapshotMsg.textContent = `Restored snapshot with ${orderState.lines.length} drink(s).`;
+});
+
+draftClearBtn.addEventListener('click', () => {
+  orderState.lines = [];
+  orderState.lastModified = new Date();
+  draftList.replaceChildren();
+  draftPlaceholder.hidden = false;
+});
+
+renderDrinks();
+renderDraft();
