+      function normalizeSortMode(rawSort) {
+        if (!rawSort) return 'featured';
+        const lower = String(rawSort).toLowerCase();
+        if (lower === 'price-asc' || lower === 'low-to-high' || lower === 'price-low-to-high' || lower === 'price-low-high' || lower === 'asc') {
+          return 'price-asc';
+        }
+        if (lower === 'price-desc' || lower === 'high-to-low' || lower === 'price-high-to-low' || lower === 'price-high-low' || lower === 'desc') {
+          return 'price-desc';
+        }
+        return 'featured';
+      }
+
+      function parseBoolParam(params, keys) {
+        for (const key of keys) {
+          if (params.has(key)) {
+            const raw = params.get(key);
+            if (raw === '' || raw === 'true' || raw === '1' || raw === 'on' || raw === 'yes') {
+              return true;
+            }
+            if (raw === 'false' || raw === '0' || raw === 'off' || raw === 'no') {
+              return false;
+            }
+          }
+        }
+        return false;
+      }
+
+      function readStateFromUrl() {
