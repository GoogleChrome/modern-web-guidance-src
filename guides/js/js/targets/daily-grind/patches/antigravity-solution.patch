+      function handleControlChange() {
+        filterState.category = categorySelectEl.value;
+        filterState.sort = sortSelectEl.value;
+        filterState.reverse = reverseToggleEl.checked;
+        filterState.groupByCategory = groupToggleEl.checked;
+
+        syncUrlFromState();
+        const processedItems = renderMenu();
+        dispatchFilterChangeEvent(processedItems);
+      }
+
+      function formatOrderTimestamp(dateValue) {
+        const dateObj = dateValue instanceof Date ? dateValue : new Date(dateValue);
+        return dateObj.toISOString();
+      }
+
+      function renderOrderList() {
+        const total = activeOrder.reduce((sum, item) => sum + item.price, 0);
+        const latestItem = activeOrder.findLast((item) => Boolean(item));
+        const latestSummary = latestItem ? ` | Last Added: ${latestItem.name}` : '';
+        orderSummaryEl.textContent = `Active Items: ${activeOrder.length} | Total: $${total.toFixed(2)}${latestSummary}`;
+
+        if (activeOrder.length === 0) {
+          orderEmptyStateEl.hidden = false;
+          orderListEl.replaceChildren();
+          return;
+        }
+
+        orderEmptyStateEl.hidden = true;
+        const itemElements = activeOrder.map((orderItem, index) => {
+          const li = document.createElement('li');
+          li.className = 'order-item';
+          li.dataset.orderId = orderItem.id;
+          li.dataset.drinkId = orderItem.drinkId;
+          li.dataset.milk = orderItem.options.milk;
+          li.dataset.note = orderItem.options.note;
+
+          const details = document.createElement('div');
+          details.className = 'order-item-details';
+
+          const titleRow = document.createElement('div');
+          titleRow.className = 'order-item-title';
+          titleRow.textContent = `${orderItem.name} — $${orderItem.price.toFixed(2)}`;
+
+          const optionsRow = document.createElement('div');
+          optionsRow.className = 'order-item-options';
+          const noteText = orderItem.options.note ? orderItem.options.note : 'No special note';
+          optionsRow.textContent = `Milk: ${orderItem.options.milk} | Note: ${noteText}`;
+
+          const timeRow = document.createElement('time');
+          timeRow.className = 'order-item-timestamp';
+          const isoTimestamp = formatOrderTimestamp(orderItem.addedAt);
+          timeRow.dateTime = isoTimestamp;
+          timeRow.textContent = `Added: ${isoTimestamp}`;
+
+          details.replaceChildren(titleRow, optionsRow, timeRow);
+
+          const actions = document.createElement('div');
+          actions.className = 'order-item-actions';
+
+          const updateBtn = document.createElement('button');
+          updateBtn.type = 'button';
+          updateBtn.className = 'btn btn-secondary btn-small update-order-item-btn';
+          updateBtn.textContent = 'Apply Current Options';
+          updateBtn.addEventListener('click', () => {
+            activeOrder[index].options.milk = customizationSelectEl.value || 'Whole';
+            activeOrder[index].options.note = customerNoteEl.value.trim();
+            renderOrderList();
+          });
+
+          const removeBtn = document.createElement('button');
+          removeBtn.type = 'button';
+          removeBtn.className = 'btn btn-outline btn-small remove-order-item-btn';
+          removeBtn.textContent = 'Remove';
+          removeBtn.addEventListener('click', () => {
+            activeOrder = activeOrder.toSpliced(index, 1);
+            renderOrderList();
+          });
+
+          actions.replaceChildren(updateBtn, removeBtn);
+          li.replaceChildren(details, actions);
+          return li;
+        });
+
+        orderListEl.replaceChildren(...itemElements);
+      }
+
+      function addDrinkToOrder(menuItem) {
+        const selectedMilk = customizationSelectEl.value || 'Whole';
+        const noteText = customerNoteEl.value.trim();
+
+        const rawOrderItem = {
+          id: `order-item-${++orderSequence}`,
+          drinkId: menuItem.id,
+          name: menuItem.name,
+          category: menuItem.category,
+          price: menuItem.price,
+          addedAt: new Date(),
+          options: {
+            milk: selectedMilk,
+            note: noteText,
+          },
+        };
+
+        const clonedItem = structuredClone(rawOrderItem);
+        activeOrder = [...activeOrder, clonedItem];
+        renderOrderList();
+      }
+
+      function saveOrderSnapshot() {
+        savedSnapshot = structuredClone(activeOrder);
+        hasSavedSnapshot = true;
+        snapshotStatusEl.textContent = `Snapshot saved (${savedSnapshot.length} ${savedSnapshot.length === 1 ? 'item' : 'items'})`;
+      }
+
+      function restoreOrderSnapshot() {
+        if (!hasSavedSnapshot && savedSnapshot.length === 0) {
+          activeOrder = [];
+          renderOrderList();
+          return;
+        }
+        activeOrder = structuredClone(savedSnapshot);
+        snapshotStatusEl.textContent = `Snapshot restored (${activeOrder.length} ${activeOrder.length === 1 ? 'item' : 'items'})`;
+        renderOrderList();
+      }
+
+      function clearActiveOrder() {
+        activeOrder = [];
+        renderOrderList();
+      }
+
+      categorySelectEl.addEventListener('change', handleControlChange);
+      sortSelectEl.addEventListener('change', handleControlChange);
+      reverseToggleEl.addEventListener('change', handleControlChange);
+      groupToggleEl.addEventListener('change', handleControlChange);
+
+      saveSnapshotBtn.addEventListener('click', saveOrderSnapshot);
+      restoreSnapshotBtn.addEventListener('click', restoreOrderSnapshot);
+      clearOrderBtn.addEventListener('click', clearActiveOrder);
+
+      window.addEventListener('popstate', () => {
+        readStateFromUrl();
+        const processedItems = renderMenu();
+        dispatchFilterChangeEvent(processedItems);
+      });
+
+      // Initialize from URL query parameters on load
+      readStateFromUrl();
+      syncUrlFromState();
+      const initialItems = renderMenu();
+      renderOrderList();
+      dispatchFilterChangeEvent(initialItems);
+    })();
+  </script>
 </body>
 
 </html>
