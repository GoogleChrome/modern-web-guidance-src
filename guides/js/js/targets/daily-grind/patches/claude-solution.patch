+  <script>
+    (() => {
+      'use strict';
+
+      const CATEGORIES = ['seasonal', 'espresso', 'cold-brew'];
+      const CATEGORY_LABELS = { seasonal: 'Seasonal', espresso: 'Espresso', 'cold-brew': 'Cold Brew' };
+      const SORTS = ['featured', 'price-asc', 'price-desc'];
+      const MILK_OPTIONS = ['Whole', 'Oat', 'Almond', 'Skim'];
+
+      // Underlying menu data: frozen so rendering can never mutate it.
+      const MENU = Object.freeze([
+        { id: 'maple-oat-latte', name: 'Maple Oat Latte', category: 'seasonal', price: 5.75, description: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+        { id: 'dark-roast-espresso', name: 'Dark Roast Espresso', category: 'espresso', price: 3.25, description: 'Bold, smokey, and perfect for a morning boost.' },
+        { id: 'cold-brew', name: 'Cold Brew', category: 'cold-brew', price: 4.5, description: 'Steeped for 18 hours for maximum smoothness.' },
+        { id: 'pumpkin-chai', name: 'Spiced Pumpkin Chai', category: 'seasonal', price: 5.5, description: 'Black tea, warm spices, and real pumpkin purée.' },
+        { id: 'cortado', name: 'Cortado', category: 'espresso', price: 3.95, description: 'Equal parts espresso and silky steamed milk.' },
+        { id: 'vanilla-sweet-cream-cold-brew', name: 'Vanilla Sweet Cream Cold Brew', category: 'cold-brew', price: 5.25, description: 'Our cold brew topped with house vanilla sweet cream.' },
+        { id: 'nitro-cold-brew', name: 'Nitro Cold Brew', category: 'cold-brew', price: 5.0, description: 'Nitrogen-infused for a velvety, cascading pour.' },
+      ].map((item) => Object.freeze(item)));
+
+      const priceFormatter = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+      const timeFormatter = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit', second: '2-digit' });
+
+      const controls = document.getElementById('menu-controls');
+      const categorySelect = document.getElementById('category-filter');
+      const sortSelect = document.getElementById('sort-order');
+      const reverseToggle = document.getElementById('reverse-toggle');
+      const groupToggle = document.getElementById('group-toggle');
+      const menuList = document.getElementById('menu-list');
+      const menuStatus = document.getElementById('menu-status');
+
+      const milkSelect = document.getElementById('milk-option');
+      const noteInput = document.getElementById('order-note');
+      const orderList = document.getElementById('order-items');
+      const orderSummary = document.getElementById('order-summary');
+      const saveButton = document.getElementById('save-snapshot');
+      const restoreButton = document.getElementById('restore-snapshot');
+      const clearButton = document.getElementById('clear-order');
+      const snapshotStatus = document.getElementById('snapshot-status');
+
+      /* ---------- Filter state & URL sync ---------- */
+
+      const TRUE_VALUES = new Set(['1', 'true', 'yes', 'on']);
+
+      function readStateFromUrl() {
+        const params = new URL(window.location.href).searchParams;
+        const category = params.get('category') ?? 'all';
+        const sort = params.get('sort') ?? 'featured';
+        return {
+          category: category === 'all' || CATEGORIES.includes(category) ? category : 'all',
+          sort: SORTS.includes(sort) ? sort : 'featured',
+          reverse: TRUE_VALUES.has((params.get('reverse') ?? '').toLowerCase()),
+          group: TRUE_VALUES.has((params.get('group') ?? '').toLowerCase()),
+        };
+      }
+
+      function writeStateToUrl(state) {
+        const url = new URL(window.location.href);
+        const params = url.searchParams;
+        params.set('category', state.category);
+        params.set('sort', state.sort);
+        params.set('reverse', String(state.reverse));
+        params.set('group', String(state.group));
+        if (url.href !== window.location.href) {
+          window.history.replaceState(window.history.state, '', url);
+        }
+      }
+
+      let filterState = readStateFromUrl();
+
+      function applyStateToControls(state) {
+        categorySelect.value = state.category;
+        sortSelect.value = state.sort;
+        reverseToggle.setAttribute('aria-pressed', String(state.reverse));
+        groupToggle.setAttribute('aria-pressed', String(state.group));
+      }
+
+      /* ---------- Menu rendering ---------- */
+
+      function getVisibleItems(state) {
+        const filtered = state.category === 'all'
+          ? MENU
+          : MENU.filter((item) => item.category === state.category);
+        let ordered = filtered;
+        if (state.sort === 'price-asc') {
+          ordered = filtered.toSorted((a, b) => a.price - b.price);
+        } else if (state.sort === 'price-desc') {
+          ordered = filtered.toSorted((a, b) => b.price - a.price);
+        }
+        return state.reverse ? ordered.toReversed() : ordered;
+      }
+
+      function createCard(item) {
+        const card = document.createElement('article');
+        card.className = 'card';
+        card.dataset.id = item.id;
+        card.dataset.category = item.category;
+
+        const title = document.createElement('h3');
+        title.textContent = item.name;
+
+        const desc = document.createElement('p');
+        desc.textContent = item.description;
+
+        const price = document.createElement('span');
+        price.className = 'price';
+        price.textContent = priceFormatter.format(item.price);
+
+        const addButton = document.createElement('button');
+        addButton.type = 'button';
+        addButton.className = 'btn add-to-order';
+        addButton.dataset.id = item.id;
+        addButton.textContent = 'Add to Order';
+        addButton.setAttribute('aria-label', `Add ${item.name} to Order`);
+
+        card.append(title, desc, price, addButton);
+        return card;
+      }
+
+      function createGrid(items) {
+        const grid = document.createElement('div');
+        grid.className = 'grid';
+        grid.replaceChildren(...items.map(createCard));
+        return grid;
+      }
+
+      function pluralItems(count) {
+        return `${count} ${count === 1 ? 'item' : 'items'}`;
+      }
+
+      function renderMenu(state) {
+        const items = getVisibleItems(state);
+        menuStatus.textContent = `Showing ${pluralItems(items.length)}`;
+
+        if (!state.group) {
+          if (items.length === 0) {
+            const empty = document.createElement('p');
+            empty.className = 'empty-message';
+            empty.textContent = 'No drinks match the selected filters.';
+            menuList.replaceChildren(empty);
+          } else {
+            menuList.replaceChildren(createGrid(items));
+          }
+          return;
+        }
+
+        const groups = Object.groupBy(items, (item) => item.category);
+        const sections = CATEGORIES.map((category) => {
+          const bucket = groups[category] ?? [];
+          const section = document.createElement('section');
+          section.className = 'menu-group';
+          section.dataset.category = category;
+
+          const heading = document.createElement('h3');
+          heading.textContent = CATEGORY_LABELS[category];
+          const count = document.createElement('span');
+          count.className = 'group-count';
+          count.textContent = ` (${pluralItems(bucket.length)})`;
+          heading.append(count);
+          section.append(heading);
+
+          if (bucket.length === 0) {
+            const empty = document.createElement('p');
+            empty.className = 'empty-message';
+            empty.textContent = 'No drinks match in this category.';
+            section.append(empty);
+          } else {
+            section.append(createGrid(bucket));
+          }
+          return section;
+        });
+        menuList.replaceChildren(...sections);
+      }
+
+      function dispatchFilterChange(state) {
+        controls.dispatchEvent(new CustomEvent('daily-grind:filter-change', {
+          detail: { ...state },
+          bubbles: true,
+          composed: true,
+        }));
+      }
+
+      function updateFilters(next) {
+        filterState = { ...filterState, ...next };
+        applyStateToControls(filterState);
+        writeStateToUrl(filterState);
+        renderMenu(filterState);
+        dispatchFilterChange(filterState);
+      }
+
+      categorySelect.addEventListener('change', () => updateFilters({ category: categorySelect.value }));
+      sortSelect.addEventListener('change', () => updateFilters({ sort: sortSelect.value }));
+      reverseToggle.addEventListener('click', () => updateFilters({ reverse: !filterState.reverse }));
+      groupToggle.addEventListener('click', () => updateFilters({ group: !filterState.group }));
+      window.addEventListener('popstate', () => updateFilters(readStateFromUrl()));
+
+      /* ---------- Draft order ---------- */
+
+      let order = [];
+      let snapshot = null;
+      let nextLineId = 1;
+
+      function renderOrder() {
+        if (order.length === 0) {
+          const empty = document.createElement('li');
+          empty.className = 'empty-message';
+          empty.textContent = 'Your draft order is empty.';
+          orderList.replaceChildren(empty);
+          orderSummary.textContent = '';
+          return;
+        }
+
+        const rows = order.map((line) => {
+          const li = document.createElement('li');
+          li.className = 'order-item';
+          li.dataset.lineId = String(line.lineId);
+
+          const name = document.createElement('strong');
+          name.textContent = `${line.item.name} — ${priceFormatter.format(line.item.price)}`;
+
+          const meta = document.createElement('span');
+          meta.className = 'order-meta';
+          const parts = [`Milk: ${line.options.milk}`];
+          if (line.options.note) parts.push(`Note: ${line.options.note}`);
+          parts.push(`Added ${timeFormatter.format(line.addedAt)}`);
+          meta.textContent = parts.join(' · ');
+
+          const time = document.createElement('time');
+          time.dateTime = line.addedAt.toISOString();
+          time.hidden = true;
+
+          li.append(name, meta, time);
+          return li;
+        });
+        orderList.replaceChildren(...rows);
+
+        const total = order.reduce((sum, line) => sum + line.item.price, 0);
+        orderSummary.textContent = `${pluralItems(order.length)} · Total ${priceFormatter.format(total)}`;
+      }
+
+      function addToOrder(menuId) {
+        const menuItem = MENU.find((item) => item.id === menuId);
+        if (!menuItem) return;
+        const milk = MILK_OPTIONS.includes(milkSelect.value) ? milkSelect.value : 'Whole';
+        const line = {
+          lineId: nextLineId++,
+          item: { id: menuItem.id, name: menuItem.name, category: menuItem.category, price: menuItem.price },
+          options: { milk, note: noteInput.value.trim() },
+          addedAt: new Date(),
+        };
+        order = [...order, line];
+        renderOrder();
+      }
+
+      menuList.addEventListener('click', (event) => {
+        const target = event.target instanceof Element ? event.target.closest('button.add-to-order') : null;
+        if (target instanceof HTMLButtonElement && target.dataset.id) {
+          addToOrder(target.dataset.id);
+        }
+      });
+
+      saveButton.addEventListener('click', () => {
+        snapshot = structuredClone(order);
+        restoreButton.disabled = false;
+        snapshotStatus.textContent = `Snapshot saved (${pluralItems(snapshot.length)}).`;
+      });
+
+      restoreButton.addEventListener('click', () => {
+        if (snapshot === null) return;
+        // Clone again so later edits to the active order never touch the saved snapshot.
+        order = structuredClone(snapshot);
+        renderOrder();
+        snapshotStatus.textContent = `Snapshot restored (${pluralItems(order.length)}).`;
+      });
+
+      clearButton.addEventListener('click', () => {
+        order = [];
+        renderOrder();
+        snapshotStatus.textContent = 'Draft order cleared.';
+      });
+
+      /* ---------- Initial load ---------- */
+
+      applyStateToControls(filterState);
+      writeStateToUrl(filterState);
+      renderMenu(filterState);
+      renderOrder();
+      dispatchFilterChange(filterState);
+    })();
+  </script>
+
 </body>
 
