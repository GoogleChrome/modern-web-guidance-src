diff --git a/menu.js b/menu.js
new file mode 100644
index 0000000..35fb6c1
--- /dev/null
+++ b/menu.js
@@ -0,0 +1,292 @@
+const MENU_DRINKS = [
+  {
+    slug: 'maple-oat-latte',
+    title: 'Maple Oat Latte',
+    category: 'seasonal',
+    categoryTitle: 'Seasonal',
+    priceCents: 580,
+    summary: 'Creamy oat milk with a hint of Vermont maple syrup.',
+  },
+  {
+    slug: 'dark-roast-espresso',
+    title: 'Dark Roast Espresso',
+    category: 'espresso',
+    categoryTitle: 'Espresso',
+    priceCents: 360,
+    summary: 'Bold, smokey, and perfect for a morning boost.',
+  },
+  {
+    slug: 'cold-brew',
+    title: 'Cold Brew',
+    category: 'cold-brew',
+    categoryTitle: 'Cold Brew',
+    priceCents: 460,
+    summary: 'Steeped for 18 hours for maximum smoothness.',
+  },
+  {
+    slug: 'honey-lavender-latte',
+    title: 'Honey Lavender Latte',
+    category: 'seasonal',
+    categoryTitle: 'Seasonal',
+    priceCents: 625,
+    summary: 'Wildflower honey and culinary lavender over espresso.',
+  },
+  {
+    slug: 'velvet-americano',
+    title: 'Velvet Americano',
+    category: 'espresso',
+    categoryTitle: 'Espresso',
+    priceCents: 395,
+    summary: 'Rich double shot finished with filtered hot water.',
+  },
+  {
+    slug: 'nitro-cold-brew',
+    title: 'Nitro Cold Brew',
+    category: 'cold-brew',
+    categoryTitle: 'Cold Brew',
+    priceCents: 550,
+    summary: 'Cascading nitrogen-infused cold brew with creamy crema.',
+  },
+  {
+    slug: 'caramel-oat-shakerato',
+    title: 'Caramel Oat Shakerato',
+    category: 'cold-brew',
+    categoryTitle: 'Cold Brew',
+    priceCents: 585,
+    summary: 'Shaken chilled espresso poured over toasted caramel oat milk.',
+  },
+];
+
+const CATEGORY_LIST = [
+  { id: 'seasonal', label: 'Seasonal' },
+  { id: 'espresso', label: 'Espresso' },
+  { id: 'cold-brew', label: 'Cold Brew' },
+];
+
+function readQueryState() {
+  const qs = new URLSearchParams(window.location.search);
+  return {
+    cat: qs.get('cat') ?? 'all',
+    sortBy: qs.get('sortBy') ?? 'default',
+    rev: qs.get('rev') === 'true',
+    group: qs.get('group') === 'true',
+  };
+}
+
+function writeQueryState(state) {
+  const qs = new URLSearchParams();
+  if (state.cat !== 'all') qs.set('cat', state.cat);
+  if (state.sortBy !== 'default') qs.set('sortBy', state.sortBy);
+  if (state.rev) qs.set('rev', 'true');
+  if (state.group) qs.set('group', 'true');
+  const suffix = qs.toString();
+  const href = suffix ? `${window.location.pathname}?${suffix}` : window.location.pathname;
+  window.history.replaceState(null, '', href);
+}
+
+const currentFilters = readQueryState();
+let currentOrder = {
+  entries: [],
+  metadata: { source: 'web-builder', createdAt: new Date() },
+};
+let savedSnapshot = null;
+
+const controlsRoot = document.getElementById('menu-controls');
+const catSelect = document.getElementById('filter-category');
+const sortSelect = document.getElementById('filter-sort');
+const revCheckbox = document.getElementById('toggle-reverse');
+const groupCheckbox = document.getElementById('toggle-grouped');
+const countsBar = document.getElementById('menu-counts');
+const catalogContainer = document.getElementById('catalog-container');
+
+const milkSelect = document.getElementById('order-milk');
+const notesInput = document.getElementById('order-notes');
+const saveBtn = document.getElementById('btn-save-draft');
+const restoreBtn = document.getElementById('btn-restore-draft');
+const clearBtn = document.getElementById('btn-clear-draft');
+const orderItemsEl = document.getElementById('order-items');
+const orderEmptyEl = document.getElementById('order-empty');
+const snapshotInfoEl = document.getElementById('order-snapshot-info');
+
+function computeVisibleDrinks() {
+  const filtered = MENU_DRINKS.filter(
+    (d) => currentFilters.cat === 'all' || d.category === currentFilters.cat,
+  );
+
+  let ordered = filtered;
+  if (currentFilters.sortBy === 'price-low') {
+    ordered = filtered.toSorted((a, b) => a.priceCents - b.priceCents);
+  } else if (currentFilters.sortBy === 'price-high') {
+    ordered = filtered.toSorted((a, b) => b.priceCents - a.priceCents);
+  } else if (currentFilters.sortBy === 'title') {
+    ordered = filtered.toSorted((a, b) => a.title.localeCompare(b.title));
+  }
+
+  return currentFilters.rev ? ordered.toReversed() : ordered;
+}
+
+function buildDrinkCard(drink) {
+  const card = document.createElement('article');
+  card.className = 'card';
+
+  const heading = document.createElement('h3');
+  heading.textContent = drink.title;
+
+  const meta = document.createElement('div');
+  meta.className = 'drink-meta';
+  const cat = document.createElement('span');
+  cat.textContent = drink.categoryTitle;
+  const price = document.createElement('span');
+  price.textContent = `$${(drink.priceCents / 100).toFixed(2)}`;
+  // Build detached child nodes with appendChild before mounting atomically with replaceChildren.
+  meta.appendChild(cat);
+  meta.appendChild(price);
+
+  const summary = document.createElement('p');
+  summary.textContent = drink.summary;
+
+  const btn = document.createElement('button');
+  btn.type = 'button';
+  btn.className = 'btn';
+  btn.textContent = 'Add to Order';
+  btn.addEventListener('click', () => {
+    currentOrder.entries.push({
+      slug: drink.slug,
+      title: drink.title,
+      priceCents: drink.priceCents,
+      options: {
+        milk: milkSelect.value,
+        note: notesInput.value.trim() || 'House standard',
+      },
+      addedAt: new Date(),
+    });
+    renderOrder();
+  });
+
+  card.appendChild(heading);
+  card.appendChild(meta);
+  card.appendChild(summary);
+  card.appendChild(btn);
+  return card;
+}
+
+function renderCatalog() {
+  const visible = computeVisibleDrinks();
+  const buckets = Object.groupBy(visible, (item) => item.category);
+
+  const countNodes = CATEGORY_LIST.map((cat) => {
+    const bucket = buckets[cat.id] ?? [];
+    const span = document.createElement('span');
+    span.className = 'tally-tag';
+    span.textContent = `${cat.label}: ${bucket.length}`;
+    return span;
+  });
+  countsBar.replaceChildren(...countNodes);
+
+  if (currentFilters.group) {
+    catalogContainer.className = 'grouped-catalog';
+    const sections = [];
+    for (const cat of CATEGORY_LIST) {
+      const items = buckets[cat.id] ?? [];
+      if (items.length === 0) continue;
+      const wrapper = document.createElement('div');
+      wrapper.className = 'cat-section';
+      const title = document.createElement('h3');
+      title.textContent = `${cat.label} (${items.length})`;
+      const row = document.createElement('div');
+      row.className = 'grid';
+      for (const item of items) {
+        row.appendChild(buildDrinkCard(item));
+      }
+      wrapper.appendChild(title);
+      wrapper.appendChild(row);
+      sections.push(wrapper);
+    }
+    catalogContainer.replaceChildren(...sections);
+  } else {
+    catalogContainer.className = 'grid';
+    catalogContainer.replaceChildren(...visible.map(buildDrinkCard));
+  }
+}
+
+function renderOrder() {
+  if (currentOrder.entries.length === 0) {
+    orderItemsEl.replaceChildren();
+    orderEmptyEl.hidden = false;
+    return;
+  }
+
+  orderEmptyEl.hidden = true;
+  const items = currentOrder.entries.map((entry) => {
+    const li = document.createElement('li');
+    const nameEl = document.createElement('span');
+    nameEl.textContent = `${entry.title} [${entry.options.milk} / ${entry.options.note}]`;
+    const priceEl = document.createElement('span');
+    priceEl.textContent = `$${(entry.priceCents / 100).toFixed(2)} • ${entry.addedAt.toLocaleTimeString()}`;
+    li.appendChild(nameEl);
+    li.appendChild(priceEl);
+    return li;
+  });
+  orderItemsEl.replaceChildren(...items);
+}
+
+function notifyFilterChange() {
+  const customEvent = new CustomEvent('daily-grind:filter-change', {
+    detail: structuredClone(currentFilters),
+    bubbles: true,
+    composed: true,
+  });
+  controlsRoot.dispatchEvent(customEvent);
+}
+
+function updateMenuAndSync() {
+  writeQueryState(currentFilters);
+  renderCatalog();
+  notifyFilterChange();
+}
+
+catSelect.value = currentFilters.cat;
+sortSelect.value = currentFilters.sortBy;
+revCheckbox.checked = currentFilters.rev;
+groupCheckbox.checked = currentFilters.group;
+
+catSelect.addEventListener('change', () => {
+  currentFilters.cat = catSelect.value;
+  updateMenuAndSync();
+});
+
+sortSelect.addEventListener('change', () => {
+  currentFilters.sortBy = sortSelect.value;
+  updateMenuAndSync();
+});
+
+revCheckbox.addEventListener('change', () => {
+  currentFilters.rev = revCheckbox.checked;
+  updateMenuAndSync();
+});
+
+groupCheckbox.addEventListener('change', () => {
+  currentFilters.group = groupCheckbox.checked;
+  updateMenuAndSync();
+});
+
+saveBtn.addEventListener('click', () => {
+  savedSnapshot = structuredClone(currentOrder);
+  snapshotInfoEl.textContent = `Saved ${savedSnapshot.entries.length} item(s) at ${new Date().toLocaleTimeString()}.`;
+});
+
+restoreBtn.addEventListener('click', () => {
+  if (!savedSnapshot) return;
+  currentOrder = structuredClone(savedSnapshot);
+  renderOrder();
+  snapshotInfoEl.textContent = `Restored ${currentOrder.entries.length} item(s).`;
+});
+
+clearBtn.addEventListener('click', () => {
+  currentOrder.entries = [];
+  orderItemsEl.replaceChildren();
+  orderEmptyEl.hidden = false;
+});
+
+renderCatalog();
+renderOrder();
