diff --git a/src/utils/privacy.ts b/src/utils/privacy.ts
new file mode 100644
index 0000000..8d9f0af
--- /dev/null
+++ b/src/utils/privacy.ts
@@ -0,0 +1,79 @@
+/**
+ * Privacy utilities for data handling and PII scrubbing.
+ */
+
+// Common regex patterns for Personally Identifiable Information (PII)
+const EMAIL_REGEX = /\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b/g;
+const PHONE_REGEX = /(?:\+?\d{1,3}[-.\s]?)?\(?\d{3}\)?[-.\s]?\d{3}[-.\s]?\d{4}\b/g;
+const TOKEN_PATTERNS = [
+  /bearer\s+[A-Za-z0-9\-._~+/]+=*/gi,
+  /(?:token|access_token|refresh_token|api_key|apikey|secret|password)[=:\s]+["']?([A-Za-z0-9\-._~+/]{6,}=*)["']?/gi,
+];
+
+/**
+ * Scrubs or masks Personally Identifiable Information (PII) such as emails,
+ * phone numbers, and tokens from strings or nested objects before outputting
+ * to logs or analytics payloads.
+ */
+export function scrubPII<T>(data: T): T {
+  if (data === null || data === undefined) {
+    return data;
+  }
+
+  if (typeof data === 'string') {
+    let result = data;
+    result = result.replace(EMAIL_REGEX, '[REDACTED_EMAIL]');
+    result = result.replace(PHONE_REGEX, '[REDACTED_PHONE]');
+    for (const pattern of TOKEN_PATTERNS) {
+      result = result.replace(pattern, (match) => {
+        if (/bearer/i.test(match)) {
+          return 'Bearer [REDACTED_TOKEN]';
+        }
+        const separator = match.includes(':') ? ': ' : '=';
+        const key = match.split(/[:=]/)[0];
+        return `${key}${separator}[REDACTED_TOKEN]`;
+      });
+    }
+    return result as unknown as T;
+  }
+
+  if (Array.isArray(data)) {
+    return data.map((item) => scrubPII(item)) as unknown as T;
+  }
+
+  if (typeof data === 'object') {
+    const scrubbedObj: Record<string, any> = {};
+    for (const [key, value] of Object.entries(data)) {
+      const lowerKey = key.toLowerCase();
+      if (
+        lowerKey.includes('password') ||
+        lowerKey.includes('secret') ||
+        lowerKey.includes('token') ||
+        lowerKey.includes('auth') ||
+        lowerKey.includes('apikey') ||
+        lowerKey.includes('api_key')
+      ) {
+        scrubbedObj[key] = '[REDACTED_TOKEN]';
+      } else if (lowerKey.includes('email')) {
+        scrubbedObj[key] = typeof value === 'string' ? scrubPII(value) : '[REDACTED_EMAIL]';
+      } else if (lowerKey.includes('phone')) {
+        scrubbedObj[key] = typeof value === 'string' ? scrubPII(value) : '[REDACTED_PHONE]';
+      } else {
+        scrubbedObj[key] = scrubPII(value);
+      }
+    }
+    return scrubbedObj as unknown as T;
+  }
+
+  return data;
+}
+
+/**
+ * Privacy-safe console logging that automatically scrubs PII from all arguments.
+ */
+export const safeLogger = {
+  log: (...args: any[]) => console.log(...args.map(scrubPII)),
+  warn: (...args: any[]) => console.warn(...args.map(scrubPII)),
+  error: (...args: any[]) => console.error(...args.map(scrubPII)),
+  info: (...args: any[]) => console.info(...args.map(scrubPII)),
+};
