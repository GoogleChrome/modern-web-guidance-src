+
+  const response = await next();
+
+  // Set restrictive Permissions-Policy header to disable unused powerful features by default
+  response.headers.set(
+    'Permissions-Policy',
+    'geolocation=(), camera=(), microphone=(), accelerometer=()'
+  );
+
+  // Set privacy-preserving Referrer-Policy header
+  response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
+
+  // Handle logout / signout flows with Clear-Site-Data header
+  const pathname = context.url.pathname.toLowerCase();
+  if (pathname.includes('logout') || pathname.includes('signout')) {
+    response.headers.set('Clear-Site-Data', '"cookies", "storage", "cache"');
+  }
+
+  // Ensure security and privacy attributes on all Set-Cookie headers
+  const setCookies = typeof response.headers.getSetCookie === 'function'
+    ? response.headers.getSetCookie()
+    : (response.headers.get('set-cookie') ? [response.headers.get('set-cookie')!] : []);
+
+  if (setCookies.length > 0) {
+    response.headers.delete('Set-Cookie');
+    for (let cookie of setCookies) {
+      if (!/;\s*HttpOnly/i.test(cookie)) {
+        cookie += '; HttpOnly';
+      }
+      if (!/;\s*Secure/i.test(cookie)) {
+        cookie += '; Secure';
+      }
+      if (/;\s*SameSite=None/i.test(cookie)) {
+        // Enforce Partitioned for cross-site CHIPS cookies
+        if (!/;\s*Partitioned/i.test(cookie)) {
+          cookie += '; Partitioned';
+        }
+      } else if (!/;\s*SameSite=/i.test(cookie)) {
+        // Default first-party session cookies to SameSite=Lax
+        cookie += '; SameSite=Lax';
+      }
+      response.headers.append('Set-Cookie', cookie);
+    }
+  }
+
+  return response;
 });
