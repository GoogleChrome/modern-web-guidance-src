diff --git a/scripts/serve.mjs b/scripts/serve.mjs
new file mode 100644
index 0000000..e18f130
--- /dev/null
+++ b/scripts/serve.mjs
@@ -0,0 +1,24 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+
+const files = new Map([
+  ['/main.js', ['dist/main.js', 'text/javascript; charset=utf-8']],
+  ['/main.js.map', ['dist/main.js.map', 'application/json']],
+]);
+const port = Number(process.env.PORT ?? 11222);
+const server = createServer(async (request, response) => {
+  try {
+    const pathname = new URL(request.url ?? '/', 'http://localhost').pathname;
+    const [file, type] = files.get(pathname) ?? ['dist/index.html', 'text/html; charset=utf-8'];
+    const body = await readFile(file);
+    response.writeHead(200, { 'Content-Type': type });
+    response.end(body);
+  } catch {
+    response.writeHead(500, { 'Content-Type': 'text/plain' });
+    response.end('Unable to load the application.');
+  }
+});
+server.listen(port, '0.0.0.0', () => {
+  const address = server.address();
+  if (address && typeof address === 'object') console.log(`Listening on http://localhost:${address.port}`);
+});
