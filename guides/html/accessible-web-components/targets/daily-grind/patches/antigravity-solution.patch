+class ToggleSwitch extends HTMLElement {
+  #internals;
+  #track;
+  #thumb;
+
+  static observedAttributes = ['aria-labelledby', 'aria-label', 'checked', 'disabled'];
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.internals = this.#internals;
+    this.#internals.role = 'switch';
+    this.#internals.ariaChecked = this.hasAttribute('checked') ? 'true' : 'false';
+
+    // Shadow DOM for encapsulated visual styling
+    const shadow = this.attachShadow({ mode: 'open' });
+    shadow.innerHTML = `
+      <style>
+        :host {
+          display: inline-flex;
+          align-items: center;
+          gap: 8px;
+          cursor: pointer;
+          user-select: none;
+          vertical-align: middle;
+          outline: none;
+        }
+        :host([disabled]) {
+          cursor: not-allowed;
+          opacity: 0.6;
+        }
+        :host(:focus-visible) {
+          outline: 2px solid var(--accent, #ffab40);
+          outline-offset: 3px;
+          border-radius: 12px;
+        }
+        .track {
+          width: 44px;
+          height: 24px;
+          background-color: var(--secondary, #8d6e63);
+          border-radius: 12px;
+          position: relative;
+          transition: background-color 0.2s;
+          display: inline-block;
+          flex-shrink: 0;
+        }
+        .thumb {
+          width: 18px;
+          height: 18px;
+          background-color: white;
+          border-radius: 50%;
+          position: absolute;
+          top: 3px;
+          left: 3px;
+          transition: transform 0.2s;
+        }
+        .track.checked {
+          background-color: var(--accent, #ffab40);
+        }
+        .track.checked .thumb {
+          transform: translateX(20px);
+        }
+      </style>
+      <span class="track" aria-hidden="true" part="track">
+        <span class="thumb" aria-hidden="true" part="thumb"></span>
+      </span>
+      <slot></slot>
+    `;
+
+    this.#track = shadow.querySelector('.track');
+    this.#thumb = shadow.querySelector('.thumb');
+
+    if (this.#internals.ariaChecked === 'true') {
+      this.#track.classList.add('checked');
+    }
+
+    // Interactive event listeners
+    this.addEventListener('click', () => this.toggle());
+    this.addEventListener('keydown', (e) => {
+      if (this.hasAttribute('disabled')) return;
+      if (e.key === ' ' || e.code === 'Space') {
+        e.preventDefault();
+        this.toggle();
+      }
+    });
+  }
+
+  connectedCallback() {
+    // Interactive control receives focus: put host in tab order if no tabindex attribute exists
+    if (!this.hasAttribute('tabindex')) {
+      this.tabIndex = 0;
+    }
+
+    this.#updateAccessibleName();
+
+    const slot = this.shadowRoot?.querySelector('slot');
+    if (slot) {
+      slot.addEventListener('slotchange', () => this.#updateAccessibleName());
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'aria-labelledby' || name === 'aria-label') {
+      this.#updateAccessibleName();
+    } else if (name === 'checked') {
+      const isChecked = this.hasAttribute('checked');
+      this.#internals.ariaChecked = String(isChecked);
+      this.#updateVisual(isChecked);
+    } else if (name === 'disabled') {
+      const isDisabled = this.hasAttribute('disabled');
+      this.#internals.ariaDisabled = String(isDisabled);
+    }
+  }
+
+  get checked() {
+    return this.#internals.ariaChecked === 'true';
+  }
+
+  set checked(val) {
+    const isChecked = Boolean(val);
+    this.#internals.ariaChecked = String(isChecked);
+    this.#updateVisual(isChecked);
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+
+  set disabled(val) {
+    if (val) {
+      this.setAttribute('disabled', '');
+    } else {
+      this.removeAttribute('disabled');
+    }
+  }
+
+  toggle() {
+    if (this.hasAttribute('disabled')) return;
+    const nextState = this.#internals.ariaChecked !== 'true';
+    this.#internals.ariaChecked = String(nextState);
+    this.#updateVisual(nextState);
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+    this.dispatchEvent(new Event('input', { bubbles: true }));
+  }
+
+  #updateVisual(checked) {
+    if (this.#track) {
+      this.#track.classList.toggle('checked', checked);
+    }
+  }
