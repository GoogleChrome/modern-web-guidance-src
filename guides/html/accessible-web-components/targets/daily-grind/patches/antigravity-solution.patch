+
+    this.addEventListener('click', () => this.toggle());
+    this.addEventListener('keydown', (e) => {
+      if (this.hasAttribute('disabled')) return;
+      if (e.key === ' ' || e.key === 'Enter') {
+        e.preventDefault();
+        this.toggle();
+      }
+    });
+  }
+
+  connectedCallback() {
+    if (!this.hasAttribute('tabindex')) this.tabIndex = 0;
+    if (!this.hasAttribute('aria-label') && !this.hasAttribute('aria-labelledby') && !this.#internals.ariaLabel) {
+      this.#internals.ariaLabel = 'Button';
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (name === 'pressed') {
+      this.#internals.ariaPressed = String(this.hasAttribute('pressed'));
+    }
+  }
+
+  get pressed() {
+    return this.#internals.ariaPressed === 'true';
+  }
+
+  set pressed(val) {
+    this.#internals.ariaPressed = String(Boolean(val));
+  }
+
+  toggle() {
+    if (this.hasAttribute('disabled')) return;
+    const nextState = this.#internals.ariaPressed !== 'true';
+    this.#internals.ariaPressed = String(nextState);
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+}
+
+class DisclosureToggle extends HTMLElement {
+  #internals;
+  static observedAttributes = ['aria-labelledby', 'aria-label', 'expanded', 'disabled'];
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.internals = this.#internals;
+    this.#internals.role = 'button';
+    this.#internals.ariaExpanded = this.hasAttribute('expanded') ? 'true' : 'false';
+
+    this.addEventListener('click', () => this.toggle());
+    this.addEventListener('keydown', (e) => {
+      if (e.key === ' ' || e.key === 'Enter') {
+        e.preventDefault();
+        this.toggle();
+      }
+    });
+  }
+
+  connectedCallback() {
+    if (!this.hasAttribute('tabindex')) this.tabIndex = 0;
+    if (!this.hasAttribute('aria-label') && !this.hasAttribute('aria-labelledby') && !this.#internals.ariaLabel) {
+      this.#internals.ariaLabel = 'Toggle';
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (name === 'expanded') {
+      this.#internals.ariaExpanded = String(this.hasAttribute('expanded'));
+    }
+  }
+
+  get expanded() {
+    return this.#internals.ariaExpanded === 'true';
+  }
+
+  set expanded(val) {
+    this.#internals.ariaExpanded = String(Boolean(val));
+  }
+
+  toggle() {
+    if (this.hasAttribute('disabled')) return;
+    const nextState = this.#internals.ariaExpanded !== 'true';
+    this.#internals.ariaExpanded = String(nextState);
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+}
+
+/**
+ * Static non-interactive custom element: card component.
+ * Does not set tabindex on the host element.
+ */
+class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+  }
+}
+
+class InfoCallout extends HTMLElement {
+  constructor() {
+    super();
+  }
+}
+
+// Expose globally and define custom elements
+if (typeof window !== 'undefined') {
+  window.ToggleSwitch = ToggleSwitch;
+  window.ToggleButton = ToggleButton;
+  window.DisclosureToggle = DisclosureToggle;
+  window.CoffeeCard = CoffeeCard;
+  window.InfoCallout = InfoCallout;
+
+  if (!customElements.get('toggle-switch')) {
+    customElements.define('toggle-switch', ToggleSwitch);
+  }
+  if (!customElements.get('toggle-button')) {
+    customElements.define('toggle-button', ToggleButton);
+  }
+  if (!customElements.get('disclosure-toggle')) {
+    customElements.define('disclosure-toggle', DisclosureToggle);
+  }
+  if (!customElements.get('coffee-card')) {
+    customElements.define('coffee-card', CoffeeCard);
+  }
+  if (!customElements.get('info-callout')) {
+    customElements.define('info-callout', InfoCallout);
+  }
+}
+
+export {
+  ToggleSwitch,
+  ToggleButton,
+  DisclosureToggle,
+  CoffeeCard,
+  InfoCallout
+};
