+  <script>
+    class ToggleSwitch extends HTMLElement {
+      #internals;
+      #checked = false;
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        if ('role' in this.#internals) {
+          this.#internals.role = 'switch';
+          this.#internals.ariaChecked = 'false';
+        } else {
+          // Fallback where the ElementInternals ARIA mixin is unavailable
+          this.setAttribute('role', 'switch');
+          this.setAttribute('aria-checked', 'false');
+        }
+        const root = this.attachShadow({ mode: 'open' });
+        root.innerHTML = `
+          <style>
+            .track { display: inline-block; width: 44px; height: 24px; border-radius: 12px;
+              background: #bcaaa4; position: relative; transition: background .2s; }
+            .thumb { position: absolute; top: 2px; left: 2px; width: 20px; height: 20px;
+              border-radius: 50%; background: #fff; transition: transform .2s; }
+            :host([data-on]) .track { background: #4e342e; }
+            :host([data-on]) .thumb { transform: translateX(20px); }
+          </style>
+          <span class="track" part="track"><span class="thumb"></span></span>`;
+        this.addEventListener('click', () => this.toggle());
+        this.addEventListener('keydown', (e) => {
+          if (e.key === ' ') { e.preventDefault(); this.toggle(); }
+        });
+      }
+      connectedCallback() {
+        if (!this.hasAttribute('tabindex')) this.tabIndex = 0;
+      }
+      toggle() {
+        this.#checked = !this.#checked;
+        if ('ariaChecked' in this.#internals) {
+          this.#internals.ariaChecked = String(this.#checked);
+        } else {
+          this.setAttribute('aria-checked', String(this.#checked));
+        }
+        this.toggleAttribute('data-on', this.#checked);
+      }
+    }
+    customElements.define('toggle-switch', ToggleSwitch);
+  </script>
