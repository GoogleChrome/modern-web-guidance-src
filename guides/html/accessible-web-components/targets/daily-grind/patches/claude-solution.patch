+  <script>
+    class FavoriteToggle extends HTMLElement {
+      static observedAttributes = ['label', 'pressed'];
+      #internals;
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        // Host is the control: role and state live in ElementInternals, no delegatesFocus.
+        this.#internals.role = 'switch';
+        this.#internals.ariaChecked = 'false';
+        const root = this.attachShadow({ mode: 'open' });
+        root.innerHTML = `
+          <style>
+            :host { display: inline-flex; align-items: center; gap: 0.4rem; margin-right: 0.75rem;
+              cursor: pointer; user-select: none; color: #4e342e; border-radius: 4px; }
+            :host(:focus-visible) { outline: 2px solid #ffab40; outline-offset: 2px; }
+            .icon { font-size: 1.4rem; line-height: 1; }
+            :host([pressed]) { color: #c62828; }
+          </style>
+          <span class="icon" aria-hidden="true">♡</span>
+          <span class="text">Favorite</span>`;
+        this.addEventListener('click', () => this.toggle());
+        this.addEventListener('keydown', (e) => {
+          if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); this.toggle(); }
+        });
+      }
+      connectedCallback() {
+        if (!this.hasAttribute('tabindex')) this.tabIndex = 0;
+        this.#sync();
+      }
+      attributeChangedCallback() { this.#sync(); }
+      get pressed() { return this.hasAttribute('pressed'); }
+      set pressed(value) { this.toggleAttribute('pressed', Boolean(value)); }
+      toggle() {
+        this.pressed = !this.pressed;
+        this.dispatchEvent(new CustomEvent('favorite-change', { bubbles: true, detail: { pressed: this.pressed } }));
+      }
+      #sync() {
+        const on = this.pressed;
+        this.#internals.ariaChecked = String(on);
+        const label = this.getAttribute('label');
+        this.#internals.ariaLabel = label ? `Favorite ${label}` : 'Favorite';
+        this.shadowRoot.querySelector('.icon').textContent = on ? '♥' : '♡';
+      }
+    }
+    customElements.define('favorite-toggle', FavoriteToggle);
+  </script>
