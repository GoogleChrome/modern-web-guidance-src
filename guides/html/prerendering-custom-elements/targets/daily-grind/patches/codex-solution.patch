+// This fallback is used only when a host has no pre-rendered shadow root.
+// Keep its structure and styles aligned with the declarative templates in index.html.
+const fallbackTemplate = document.createElement('template');
+fallbackTemplate.innerHTML = `
+<style>
+      :host { display: block; }
+      * { box-sizing: border-box; }
+      .card {
+        height: 100%;
+        background: white;
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+      }
+      ::slotted([slot="heading"]) {
+        margin: 0 0 10px;
+        color: var(--primary, #4e342e);
+      }
+      ::slotted(p) { margin: 0; }
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--primary, #4e342e);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+      }
+      ::slotted([slot="action"]:hover) { background: #3e2723; }
+      button {
+        display: block;
+        margin: 15px auto 0;
+        border: 1px solid var(--primary, #4e342e);
+        border-radius: 5px;
+        background: transparent;
+        color: var(--primary, #4e342e);
+        padding: 8px 12px;
+        font: inherit;
+        cursor: pointer;
+      }
+      button:hover { background: var(--secondary, #d7ccc8); }
+      button:focus-visible { outline: 3px solid var(--accent, #ffab40); outline-offset: 3px; }
+      #details { margin-top: 12px; }
+      [hidden] { display: none; }
+    </style>
+    <article class="card">
+      <slot name="heading"></slot>
+      <slot></slot>
+      <button id="toggle" type="button" aria-expanded="false" aria-controls="details">Tasting notes</button>
+      <div id="details" hidden><slot name="details"></slot></div>
+      <slot name="action"></slot>
+    </article>
+`;
+
+export class CoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+
+    let root = this.shadowRoot;
+    if (!root) {
+      // Older parsers leave the declarative template in the light DOM.
+      const declarativeTemplate = this.querySelector(':scope > template[shadowrootmode="open"]');
+      root = this.attachShadow({ mode: 'open' });
+      const template = declarativeTemplate instanceof HTMLTemplateElement
+        ? declarativeTemplate
+        : fallbackTemplate;
+      root.append(template.content.cloneNode(true));
+      declarativeTemplate?.remove();
+    }
+
+    const toggle = root.getElementById('toggle');
+    const details = root.getElementById('details');
+    if (!(toggle instanceof HTMLButtonElement) || !(details instanceof HTMLElement)) {
+      return;
+    }
+
+    // The constructor runs once, even when the host is disconnected and reinserted.
+    toggle.addEventListener('click', () => {
+      const expanded = this.toggleAttribute('open');
+      toggle.setAttribute('aria-expanded', String(expanded));
+      details.hidden = !expanded;
+    });
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
