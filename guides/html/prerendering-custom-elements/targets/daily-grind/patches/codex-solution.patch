diff --git a/tests/browser.cjs b/tests/browser.cjs
new file mode 100644
index 0000000..81993b4
--- /dev/null
+++ b/tests/browser.cjs
@@ -0,0 +1,133 @@
+const assert = require('node:assert/strict');
+const { test } = require('node:test');
+const { createServer } = require('node:http');
+const { readFile } = require('node:fs/promises');
+const { existsSync } = require('node:fs');
+const { join } = require('node:path');
+const { chromium } = require('@playwright/test');
+
+test('declarative cards render before JavaScript and hydrate in place', async (t) => {
+  const server = createServer(async (request, response) => {
+    const pathname = new URL(request.url, 'http://localhost').pathname;
+    const filename = pathname === '/' ? 'index.html' : pathname.slice(1);
+    if (!['index.html', 'coffee-card.js'].includes(filename)) {
+      response.writeHead(404).end();
+      return;
+    }
+    response.setHeader('Content-Type', filename.endsWith('.js') ? 'text/javascript' : 'text/html');
+    response.end(await readFile(join(__dirname, '..', filename)));
+  });
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise((resolve) => server.close(resolve)));
+  const browser = await chromium.launch({
+    executablePath: process.env.CHROME_PATH || (existsSync('/usr/bin/google-chrome') ? '/usr/bin/google-chrome' : undefined),
+    headless: true,
+    args: ['--no-sandbox'],
+  });
+  t.after(() => browser.close());
+  const url = `http://127.0.0.1:${server.address().port}`;
+
+  const startupPage = await browser.newPage();
+  const errors = [];
+  startupPage.on('pageerror', (error) => errors.push(error.message));
+  await startupPage.goto(url);
+  await startupPage.evaluate(() => customElements.whenDefined('coffee-card'));
+  await startupPage.locator('coffee-card').first().getByRole('button').click();
+  assert.equal(await startupPage.locator('coffee-card').first().locator('#details').isVisible(), true);
+  assert.deepEqual(errors, []);
+  await startupPage.close();
+
+  const noScriptContext = await browser.newContext({ javaScriptEnabled: false });
+  const noScriptPage = await noScriptContext.newPage();
+  await noScriptPage.goto(url);
+  assert.equal(await noScriptPage.locator('coffee-card .card').count(), 3);
+  assert.equal(await noScriptPage.locator('coffee-card .card').first().evaluate(
+    (card) => getComputedStyle(card).backgroundColor
+  ), 'rgb(255, 255, 255)');
+  assert.equal(await noScriptPage.locator('coffee-card .card').first().evaluate(
+    (card) => getComputedStyle(card).padding
+  ), '20px');
+  assert.equal(await noScriptPage.locator('coffee-card').first().evaluate((host) => {
+    const heading = host.querySelector('h3');
+    return host.shadowRoot !== null && host.querySelector('template') === null
+      && heading.parentNode === host
+      && host.shadowRoot.querySelector('slot[name="heading"]').assignedElements()[0] === heading
+      && host.shadowRoot.querySelector('h3') === null;
+  }), true);
+  await noScriptContext.close();
+
+  const context = await browser.newContext();
+  const page = await context.newPage();
+  await page.route('**/coffee-card.js', (route) => route.abort());
+  await page.goto(url);
+  await page.evaluate(() => {
+    const host = document.querySelector('coffee-card');
+    window.originalRoot = host.shadowRoot;
+    window.originalNodes = [...host.shadowRoot.querySelectorAll('*')];
+    window.shadowAttachments = 0;
+    const attach = HTMLElement.prototype.attachShadow;
+    HTMLElement.prototype.attachShadow = function (options) {
+      window.shadowAttachments++;
+      return attach.call(this, options);
+    };
+  });
+  await page.unroute('**/coffee-card.js');
+  await page.evaluate(() => import('/coffee-card.js?hydrate'));
+  assert.equal(await page.evaluate(() => {
+    const host = document.querySelector('coffee-card');
+    return host.shadowRoot === window.originalRoot
+      && window.originalNodes.every((node, index) => node === host.shadowRoot.querySelectorAll('*')[index])
+      && window.shadowAttachments === 0;
+  }), true);
+
+  const firstCard = page.locator('coffee-card').first();
+  const toggle = firstCard.getByRole('button', { name: 'Tasting notes' });
+  await toggle.click();
+  assert.equal(await toggle.getAttribute('aria-expanded'), 'true');
+  assert.equal(await firstCard.locator('#details').isVisible(), true);
+  await page.evaluate(() => {
+    const host = document.querySelector('coffee-card');
+    for (let i = 0; i < 3; i++) {
+      host.remove();
+      document.querySelector('.grid').prepend(host);
+    }
+    window.stateChanges = 0;
+    new MutationObserver((records) => { window.stateChanges += records.length; })
+      .observe(host, { attributes: true, attributeFilter: ['open'] });
+  });
+  await toggle.click();
+  assert.equal(await toggle.getAttribute('aria-expanded'), 'false');
+  assert.equal(await firstCard.locator('#details').isVisible(), false);
+  assert.equal(await page.evaluate(() => window.stateChanges), 1);
+  await context.close();
+
+  // innerHTML leaves DSD inert, simulating a browser without parser support.
+  const fallbackContext = await browser.newContext();
+  const fallbackPage = await fallbackContext.newPage();
+  await fallbackPage.route('**/coffee-card.js', (route) => route.abort());
+  await fallbackPage.goto(url);
+  await fallbackPage.evaluate(() => {
+    const original = document.querySelector('coffee-card');
+    const host = document.createElement('coffee-card');
+    const template = document.createElement('template');
+    template.setAttribute('shadowrootmode', 'open');
+    template.innerHTML = original.shadowRoot.innerHTML;
+    host.append(template, ...[...original.children].map((child) => child.cloneNode(true)));
+    host.id = 'fallback-card';
+    document.querySelector('.grid').append(host);
+  });
+  await fallbackPage.unroute('**/coffee-card.js');
+  await fallbackPage.evaluate(() => import('/coffee-card.js?hydrate'));
+  assert.equal(await fallbackPage.locator('#fallback-card').evaluate((host) =>
+    host.shadowRoot !== null && host.querySelector('template') === null
+  ), true);
+  await fallbackPage.locator('#fallback-card').getByRole('button').click();
+  assert.equal(await fallbackPage.locator('#fallback-card #details').isVisible(), true);
+  assert.equal(await fallbackPage.evaluate(() => {
+    const host = document.createElement('coffee-card');
+    document.querySelector('.grid').append(host);
+    return host.shadowRoot.querySelector('style') !== null
+      && host.shadowRoot.querySelector('button') !== null;
+  }), true);
+  await fallbackContext.close();
+});
