+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+    }
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+    .body {
+      margin: 10px 0;
+    }
+    .btn,
+    ::slotted(.btn) {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+      border: none;
+      cursor: pointer;
+      font: inherit;
+    }
+    .btn:hover,
+    ::slotted(.btn:hover) {
+      background: #3e2723;
+    }
+    #toggle {
+      display: inline-block;
+      background: var(--primary, #4e342e);
+      color: white;
+      padding: 8px 16px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 10px;
+      border: none;
+      cursor: pointer;
+      font: inherit;
+      transition: background 0.3s;
+    }
+    #toggle:hover {
+      background: #3e2723;
+    }
+    .details {
+      display: none;
+      margin-top: 10px;
+      font-size: 0.9rem;
+    }
+    :host([open]) .details {
+      display: block;
+    }
+  </style>
+  <div class="card">
+    <slot name="header"></slot>
+    <div class="body"><slot></slot></div>
+    <button id="toggle" class="btn" type="button">Toggle Details</button>
+    <div class="details">
+      <slot name="details"></slot>
+    </div>
+  </div>
+`;
+
+class MyCard extends HTMLElement {
+  constructor() {
+    super();
+    // Reuse the server-rendered shadow root if present; only create one if absent.
+    if (!this.shadowRoot) {
+      const dsdTemplate = this.querySelector('template[shadowrootmode]');
+      if (dsdTemplate) {
+        const mode = dsdTemplate.getAttribute('shadowrootmode') || 'open';
+        const shadowRoot = this.attachShadow({ mode });
+        shadowRoot.append(dsdTemplate.content);
+        dsdTemplate.remove();
+      } else {
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.append(template.content.cloneNode(true));
+      }
+    }
+    // Hydrate in place: attach listeners once against existing markup (not unguarded
+    // in connectedCallback, which re-runs if the element moves in the DOM), and do
+    // NOT re-render; that would discard the server's DOM and flash.
+    this.shadowRoot.getElementById('toggle')
+      ?.addEventListener('click', () => this.toggleAttribute('open'));
+  }
+
+  get open() {
+    return this.hasAttribute('open');
+  }
+
+  set open(value) {
+    this.toggleAttribute('open', Boolean(value));
+  }
+}
+
+if (typeof window !== 'undefined') {
+  window.MyCard = MyCard;
+}
+
+if (typeof customElements !== 'undefined') {
+  if (!customElements.get('my-card')) {
+    customElements.define('my-card', MyCard);
+  }
+  if (!customElements.get('coffee-card')) {
+    customElements.define('coffee-card', class extends MyCard {});
+  }
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { MyCard };
+}
