+  <script>
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = ['open'];
+
+      constructor() {
+        super();
+        if (!this.shadowRoot) {
+          // Fallback for engines without declarative shadow DOM support.
+          const tpl = this.querySelector(':scope > template[shadowrootmode]');
+          this.attachShadow({ mode: 'open' });
+          if (tpl) {
+            this.shadowRoot.append(tpl.content.cloneNode(true));
+            tpl.remove();
+          }
+        }
+        // Hydrate in place; listener attached once, in the constructor.
+        this.shadowRoot.getElementById('toggle')
+          ?.addEventListener('click', () => this.toggleAttribute('open'));
+        this.#sync();
+      }
+
+      attributeChangedCallback() {
+        this.#sync();
+      }
+
+      #sync() {
+        const btn = this.shadowRoot?.getElementById('toggle');
+        if (!btn) return;
+        const on = this.hasAttribute('open');
+        btn.setAttribute('aria-pressed', String(on));
+        btn.textContent = on ? '\u2665 Favorited' : '\u2661 Favorite';
+      }
+    }
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
