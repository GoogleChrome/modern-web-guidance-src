+import { cp, mkdir } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { execFileSync } from 'node:child_process';
+
+const root = new URL('./', import.meta.url);
+execFileSync(process.execPath, ['--check', fileURLToPath(new URL('components/seasonal-card.js', root))], {
+  stdio: 'inherit',
+});
+await mkdir(new URL('dist/components/', root), { recursive: true });
+await cp(new URL('index.html', root), new URL('dist/index.html', root));
+await cp(new URL('components/seasonal-card.js', root), new URL('dist/components/seasonal-card.js', root));
+console.log('Build complete: dist/');
