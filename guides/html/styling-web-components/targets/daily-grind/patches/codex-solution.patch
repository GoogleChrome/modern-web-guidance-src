+# Seasonal card
+
+Import the module once on any page; it has no framework or page CSS dependency.
+
+```html
+<script type="module" src="/components/seasonal-card.js"></script>
+<seasonal-card href="/menu/seasonal" action-label="Explore">
+  <span slot="title">Maple Oat Latte</span>
+  <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+</seasonal-card>
+```
+
+The title appears in a native level-three heading. Default slot content provides
+the description. Set `href` for the built-in link and `action-label` for its text
+(defaults to “View Details”). Both attributes can be changed after insertion.
+Without `href`, the action area is hidden unless a custom action is supplied.
+Use `slot="action"` on a link or button to replace the built-in link; that content
+stays in the light DOM and is styled by the consuming page.
+
+Font family and line height inherit from the page. Set these optional public
+custom properties on the card **or any ancestor**:
+
+| Property | Default |
+| --- | --- |
+| `--card-background` | white |
+| `--card-color` | inherited color |
+| `--card-title-color` | #4e342e |
+| `--card-padding` | 20px |
+| `--card-radius` | 8px |
+| `--card-shadow` | 0 2px 5px rgb(0 0 0 / 10%) |
+| `--card-button-background` | #4e342e |
+| `--card-button-color` | white |
+| `--card-button-hover-background` | #3e2723 |
+| `--card-button-padding` | 10px 20px |
+| `--card-button-radius` | 5px |
+| `--card-focus-color` | #ffab40 |
+
+For unrestricted styling, exposed parts are `card`, `title`, `description`,
+`actions`, and `button` (the built-in link). For example:
+
+```css
+.rewards {
+  --card-background: #182d28;
+  --card-color: #fff;
+  --card-title-color: #ffe3a3;
+  --card-button-background: #ffe3a3;
+  --card-button-color: #182d28;
+}
+.rewards seasonal-card::part(button) { border: 2px solid currentColor; }
+.rewards seasonal-card::part(card) { border-radius: 0; }
+```
+
+The host is an inline-size container. Below 30rem, the content and action stack;
+at 30rem and above, they sit side by side. This responds to the card's allocated
+width, including in sidebars, independently of the viewport. Browsers without
+container queries retain the stacked layout. Internal cascade layers order base
+and layout styles; no ancestor selectors or global card rules are required.
+
+Run `npm run build` to check component JavaScript syntax and copy the static site
+to `dist/`.
diff --git a/components/seasonal-card.js b/components/seasonal-card.js
new file mode 100644
index 0000000..81f92b8
--- /dev/null
+++ b/components/seasonal-card.js
@@ -0,0 +1,132 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    @layer base, layout;
+
+    @layer base {
+      :host {
+        display: block;
+        min-width: 0;
+        container-type: inline-size;
+        --_background: var(--card-background, white);
+        --_color: var(--card-color, inherit);
+        --_title-color: var(--card-title-color, #4e342e);
+        --_button-background: var(--card-button-background, #4e342e);
+        --_button-color: var(--card-button-color, white);
+        --_button-hover-background: var(--card-button-hover-background, #3e2723);
+      }
+
+      *, *::before, *::after { box-sizing: border-box; }
+
+      article {
+        display: grid;
+        gap: 15px;
+        padding: var(--card-padding, 20px);
+        border-radius: var(--card-radius, 8px);
+        background: var(--_background);
+        color: var(--_color);
+        box-shadow: var(--card-shadow, 0 2px 5px rgb(0 0 0 / 10%));
+        text-align: center;
+        overflow-wrap: anywhere;
+      }
+
+      h3 {
+        margin: 0 0 10px;
+        color: var(--_title-color);
+        font-size: 1.17em;
+        line-height: inherit;
+      }
+
+      ::slotted(p) { margin: 0; }
+      .content, .actions { min-width: 0; }
+      .actions { align-self: center; }
+      .actions[hidden] { display: none; }
+
+      a {
+        display: inline-block;
+        max-width: 100%;
+        padding: var(--card-button-padding, 10px 20px);
+        border-radius: var(--card-button-radius, 5px);
+        background: var(--_button-background);
+        color: var(--_button-color);
+        font: inherit;
+        text-decoration: none;
+        transition: background 0.3s;
+      }
+
+      a:hover { background: var(--_button-hover-background); }
+      a:focus-visible {
+        outline: 3px solid var(--card-focus-color, #ffab40);
+        outline-offset: 3px;
+      }
+      @media (prefers-reduced-motion: reduce) {
+        a { transition: none; }
+      }
+    }
+
+    @layer layout {
+      @container (min-width: 30rem) {
+        article {
+          grid-template-columns: minmax(0, 1fr) auto;
+          gap: 24px;
+          text-align: start;
+        }
+      }
+    }
+  </style>
+  <article part="card">
+    <div class="content">
+      <h3 part="title"><slot name="title"></slot></h3>
+      <div part="description"><slot></slot></div>
+    </div>
+    <div class="actions" part="actions">
+      <slot name="action"><a part="button">View Details</a></slot>
+    </div>
+  </article>
+`;
+
+/**
+ * A themeable content card. Import this module once on any consuming page.
+ * @extends HTMLElement
+ */
+export class SeasonalCard extends HTMLElement {
+  static get observedAttributes() {
+    return ['href', 'action-label'];
+  }
+
+  constructor() {
+    super();
+    const shadow = this.attachShadow({ mode: 'open' });
+    shadow.append(template.content.cloneNode(true));
+    this.actionLink = shadow.querySelector('a');
+    this.actionSlot = shadow.querySelector('slot[name="action"]');
+    this.actions = shadow.querySelector('.actions');
+    this.actionSlot?.addEventListener('slotchange', () => this.updateAction());
+  }
+
+  connectedCallback() {
+    this.updateAction();
+  }
+
+  attributeChangedCallback() {
+    this.updateAction();
+  }
+
+  updateAction() {
+    if (!this.actionLink || !this.actions) return;
+    const href = this.getAttribute('href');
+    if (href) {
+      this.actionLink.setAttribute('href', href);
+    } else {
+      this.actionLink.removeAttribute('href');
+    }
+    this.actionLink.textContent = this.getAttribute('action-label') || 'View Details';
+    const hasCustomAction = this.actionSlot instanceof HTMLSlotElement &&
+      this.actionSlot.assignedElements().length > 0;
+    this.actions.hidden = !href && !hasCustomAction;
+  }
+}
+
+if (!customElements.get('seasonal-card')) {
+  customElements.define('seasonal-card', SeasonalCard);
+}
