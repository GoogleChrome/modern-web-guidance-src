+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    @layer base, theme, variants, layout;
+
+    @layer base {
+      :host {
+        display: block;
+        min-width: 0;
+        box-sizing: border-box;
+        container: drink-card / inline-size;
+        border: 1px solid transparent;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgb(0 0 0 / 0.1);
+      }
+
+      *, *::before, *::after { box-sizing: border-box; }
+
+      article {
+        display: grid;
+        gap: 15px;
+        padding: 20px;
+        text-align: center;
+        overflow-wrap: anywhere;
+      }
+
+      .content { min-width: 0; }
+      .heading { margin-bottom: 10px; }
+      ::slotted(h3), ::slotted(p) { margin: 0; }
+      ::slotted(h3) { font-size: 1.17em; }
+
+      .action {
+        justify-self: center;
+        align-self: end;
+        display: inline-block;
+        max-width: 100%;
+        padding: 10px 20px;
+        border-radius: 5px;
+        font: inherit;
+        text-decoration: none;
+        transition: background 0.3s;
+      }
+
+      .action:focus-visible {
+        outline: 3px solid var(--_accent);
+        outline-offset: 3px;
+      }
+    }
+
+    @layer theme {
+      :host {
+        /* Keep public properties unset so ancestor themes can supply them. */
+        --_background: var(--drink-card-background, var(--light, white));
+        --_color: var(--drink-card-color, var(--text, #3e2723));
+        --_heading: var(--drink-card-heading, var(--primary, #4e342e));
+        --_action-background: var(--drink-card-action-background, var(--primary, #4e342e));
+        --_action-color: var(--drink-card-action-color, white);
+        --_accent: var(--drink-card-accent, var(--accent, #ffab40));
+        background: var(--_background);
+        color: var(--_color);
+        font-family: inherit;
+        line-height: inherit;
+      }
+
+      .heading { color: var(--_heading); }
+      .action {
+        background: var(--_action-background);
+        color: var(--_action-color);
+      }
+      .action:hover { background: var(--drink-card-action-hover, #3e2723); }
+    }
+
+    @layer variants {
+      :host([variant="featured"]) {
+        border-color: var(--_accent);
+        box-shadow: 0 3px 10px rgb(78 52 46 / 0.16);
+      }
+      :host([variant="subtle"]) {
+        border-color: var(--secondary, #d7ccc8);
+        box-shadow: none;
+      }
+    }
+
+    @layer layout {
+      /* Query the host's available space, independently of the viewport. */
+      @container drink-card (min-width: 20rem) {
+        article { padding: 24px; }
+      }
+      @container drink-card (min-width: 28rem) {
+        article {
+          grid-template-columns: minmax(0, 1fr) auto;
+          align-items: center;
+          gap: 24px;
+          text-align: start;
+        }
+        .action { align-self: center; }
+      }
+    }
+  </style>
+  <article>
+    <div class="content">
+      <div class="heading" part="heading"><slot name="title"></slot></div>
+      <slot name="description"></slot>
+    </div>
+    <a class="action" part="action"><slot name="action-label">View Details</slot></a>
+  </article>
+`;
+
+/**
+ * Seasonal drink presentation. Slots: title, description, action-label.
+ * Public styling hooks: --drink-card-* properties and heading/action parts.
+ * Variants: featured, subtle; an omitted or unknown variant uses the base style.
+ */
+class DrinkCard extends HTMLElement {
+  static observedAttributes = ['href'];
+
+  constructor() {
+    super();
+    const shadow = this.attachShadow({ mode: 'open' });
+    shadow.append(template.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    this.updateLink();
+  }
+
+  attributeChangedCallback() {
+    this.updateLink();
+  }
+
+  updateLink() {
+    const action = this.shadowRoot?.querySelector('a');
+    if (!action) return;
+
+    const href = this.getAttribute('href');
+    if (href === null) {
+      action.removeAttribute('href');
+    } else {
+      action.setAttribute('href', href);
+    }
+  }
+}
+
+customElements.define('drink-card', DrinkCard);
