diff --git a/src/coffee-card.ts b/src/coffee-card.ts
new file mode 100644
index 0000000..e6f462b
--- /dev/null
+++ b/src/coffee-card.ts
@@ -0,0 +1,115 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    @layer base, theme;
+
+    @layer base {
+      :host {
+        display: block;
+        min-width: 0;
+        container-type: inline-size;
+        container-name: coffee-card;
+        --_card-bg: var(--card-bg, white);
+        --_card-fg: var(--card-fg, #3e2723);
+        --_card-title-color: var(--card-title-color, #4e342e);
+      }
+
+      .card {
+        box-sizing: border-box;
+        display: grid;
+        grid-template-columns: minmax(0, 1fr);
+        gap: 15px;
+        align-items: center;
+        height: 100%;
+        padding: 20px;
+        text-align: center;
+        overflow-wrap: anywhere;
+      }
+
+      .heading { margin-bottom: 10px; }
+      ::slotted(h3), ::slotted(p) { margin: 0; }
+
+      .button {
+        justify-self: center;
+        display: inline-block;
+        box-sizing: border-box;
+        font: inherit;
+        color: inherit;
+        text-decoration: none;
+        padding: 10px 20px;
+        border-radius: 5px;
+        transition: background 0.3s;
+      }
+
+      .button:focus-visible { outline: 3px solid #ffab40; outline-offset: 3px; }
+
+      @container coffee-card (min-width: 30rem) {
+        .card {
+          grid-template-columns: minmax(0, 1fr) auto;
+          text-align: left;
+          gap: 24px;
+        }
+      }
+    }
+
+    @layer theme {
+      .card {
+        background: var(--_card-bg);
+        color: var(--_card-fg);
+        border-radius: 6px;
+        box-shadow: 0 1px 3px rgb(0 0 0 / 0.1);
+      }
+      .heading { color: var(--_card-title-color); }
+      .button { background: #4e342e; color: white; }
+      .button:hover { background: #3e2723; }
+    }
+  </style>
+  <article class="card" part="surface">
+    <div>
+      <div class="heading" part="heading"><slot name="heading"></slot></div>
+      <slot name="description"></slot>
+    </div>
+    <a class="button" part="button">View Details</a>
+  </article>
+`;
+
+/** Public theme properties inherit from any light DOM ancestor.
+ * Parts: surface, heading, button. Wide layout starts at 30rem per card.
+ */
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['href'];
+  readonly #link: HTMLAnchorElement;
+
+  constructor() {
+    super();
+    const shadow = this.attachShadow({ mode: 'open' });
+    shadow.append(template.content.cloneNode(true));
+    const link = shadow.querySelector<HTMLAnchorElement>('.button');
+    if (!link) throw new Error('Coffee card template is missing its link.');
+    this.#link = link;
+  }
+
+  connectedCallback(): void {
+    this.#updateLink();
+  }
+
+  attributeChangedCallback(): void {
+    this.#updateLink();
+  }
+
+  #updateLink(): void {
+    const href = this.getAttribute('href');
+    if (href !== null) this.#link.setAttribute('href', href);
+    else this.#link.removeAttribute('href');
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'coffee-card': CoffeeCard;
+  }
+}
+
+export {};
