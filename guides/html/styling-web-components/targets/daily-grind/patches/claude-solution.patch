diff --git a/menu-card.js b/menu-card.js
new file mode 100644
index 0000000..64a7e82
--- /dev/null
+++ b/menu-card.js
@@ -0,0 +1,114 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    @layer base, theme;
+
+    @layer base {
+      :host {
+        display: block; /* required so container-type applies */
+        container-type: inline-size;
+        --_card-bg: var(--card-bg, white);
+        --_card-fg: var(--card-fg, inherit);
+        --_card-title-color: var(--card-title-color, #4e342e);
+        --_card-radius: var(--card-radius, 8px);
+        --_card-padding: var(--card-padding, 20px);
+        --_card-shadow: var(--card-shadow, 0 2px 5px rgba(0, 0, 0, 0.1));
+        --_card-gap: var(--card-gap, 10px);
+        --_card-align: var(--card-align, center);
+        --_btn-bg: var(--card-btn-bg, #4e342e);
+        --_btn-bg-hover: var(--card-btn-bg-hover, #3e2723);
+        --_btn-fg: var(--card-btn-fg, white);
+        --_btn-radius: var(--card-btn-radius, 5px);
+      }
+
+      :host([hidden]) { display: none; }
+
+      .card {
+        display: grid;
+        grid-template-columns: 1fr;
+        gap: var(--_card-gap);
+        align-items: center;
+        background: var(--_card-bg);
+        color: var(--_card-fg);
+        padding: var(--_card-padding);
+        border-radius: var(--_card-radius);
+        box-shadow: var(--_card-shadow);
+        text-align: var(--_card-align);
+        height: 100%;
+      }
+
+      .title {
+        color: var(--_card-title-color);
+        font-size: 1.17em;
+        font-weight: bold;
+      }
+
+      ::slotted(*) { margin: 0; }
+
+      .action { margin-top: 5px; }
+
+      .button {
+        display: inline-block;
+        background: var(--_btn-bg);
+        color: var(--_btn-fg);
+        font: inherit;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: var(--_btn-radius);
+        transition: background 0.3s;
+      }
+
+      .button:hover,
+      .button:focus-visible {
+        background: var(--_btn-bg-hover);
+      }
+
+      :host(:not([href])) .action { display: none; }
+
+      @container (min-width: 30rem) {
+        .card {
+          grid-template-columns: 1fr auto;
+          grid-template-areas:
+            "title action"
+            "body action";
+          text-align: start;
+          column-gap: 1.5rem;
+        }
+        .title { grid-area: title; }
+        .body { grid-area: body; }
+        .action { grid-area: action; margin-top: 0; }
+      }
+    }
+
+    @layer theme {
+      /* Hook for built-in variants; consumers override via properties and ::part. */
+    }
+  </style>
+  <article class="card" part="card">
+    <h3 class="title" part="title"><slot name="title"></slot></h3>
+    <div class="body" part="body"><slot></slot></div>
+    <div class="action" part="action">
+      <a class="button" part="button"><slot name="action">View Details</slot></a>
+    </div>
+  </article>
+`;
+
+class MenuCard extends HTMLElement {
+  static observedAttributes = ['href'];
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' }).append(template.content.cloneNode(true));
+    this.#button = this.shadowRoot.querySelector('.button');
+  }
+
+  #button;
+
+  attributeChangedCallback(name, _old, value) {
+    if (name !== 'href') return;
+    if (value === null) this.#button.removeAttribute('href');
+    else this.#button.setAttribute('href', value);
+  }
+}
+
+customElements.define('menu-card', MenuCard);
