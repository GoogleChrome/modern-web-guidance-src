+
+  <script>
+    class MenuCard extends HTMLElement {
+      constructor() {
+        super();
+        const root = this.attachShadow({ mode: 'open' });
+        root.innerHTML = `
+          <style>
+            @layer base, theme;
+            @layer base {
+              :host {
+                --_card-bg: var(--card-bg, white);
+                --_card-fg: var(--card-fg, #3e2723);
+                display: block;
+                container-type: inline-size;
+              }
+              .card {
+                background: var(--_card-bg);
+                color: var(--_card-fg);
+                padding: 20px;
+                border-radius: 8px;
+                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+                text-align: center;
+                display: grid;
+                gap: 10px;
+                height: 100%;
+              }
+              a {
+                font: inherit;
+                color: inherit;
+                display: inline-block;
+                text-decoration: none;
+                margin-top: 15px;
+              }
+              ::slotted(h3) { margin-bottom: 10px; color: var(--card-title, #4e342e); }
+            }
+            @layer theme {
+              @container (min-width: 30rem) {
+                .card { grid-template-columns: 1fr 2fr; text-align: left; align-items: center; }
+              }
+            }
+          </style>
+          <div class="card">
+            <slot name="title"></slot>
+            <div><slot></slot><a part="action"></a></div>
+          </div>`;
+      }
+      connectedCallback() {
+        const a = this.shadowRoot.querySelector('a');
+        a.href = this.getAttribute('href') || '#';
+        a.textContent = this.getAttribute('label') || 'View Details';
+      }
+    }
+    customElements.define('menu-card', MenuCard);
+  </script>
