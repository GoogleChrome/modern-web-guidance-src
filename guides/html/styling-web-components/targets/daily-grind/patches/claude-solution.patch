+  <script>
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        const root = this.attachShadow({ mode: 'open' });
+        root.innerHTML = `
+          <style>
+            @layer base, variants;
+
+            @layer base {
+              :host {
+                /* Theme comes from the page's inherited custom properties */
+                --_bg: var(--card-bg, white);
+                --_title: var(--card-title-color, var(--primary, #4e342e));
+                --_shadow: var(--card-shadow, rgba(0, 0, 0, 0.1));
+                display: block;
+                container-type: inline-size;
+                background: var(--_bg);
+                border-radius: 8px;
+                box-shadow: 0 2px 5px var(--_shadow);
+                text-align: center;
+              }
+
+              .card {
+                display: grid;
+                gap: 10px;
+                padding: 20px;
+              }
+
+              [part="title"] {
+                color: var(--_title);
+              }
+
+              ::slotted([slot="title"]) {
+                margin: 0;
+                color: inherit;
+              }
+
+              ::slotted(p) {
+                margin: 0;
+              }
+            }
+
+            @layer variants {
+              :host([variant="featured"]) {
+                border-top: 4px solid var(--accent, #ffab40);
+                --_bg: var(--card-bg, var(--light, #fafafa));
+              }
+
+              :host([variant="compact"]) .card {
+                padding: 12px;
+              }
+
+              @container (min-width: 22rem) {
+                .card {
+                  text-align: left;
+                  grid-template-columns: 1fr auto;
+                  align-items: center;
+                }
+                [part="title"], [part="body"] {
+                  grid-column: 1;
+                }
+                [part="action"] {
+                  grid-column: 2;
+                  grid-row: 1 / span 2;
+                }
+              }
+            }
+          </style>
+          <div class="card">
+            <div part="title"><slot name="title"></slot></div>
+            <div part="body"><slot></slot></div>
+            <div part="action"><slot name="action"></slot></div>
+          </div>
+        `;
+      }
+    }
+    customElements.define('drink-card', DrinkCard);
+  </script>
