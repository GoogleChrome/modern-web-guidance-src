+  <script type="module">
+    const drinkCardTemplate = document.createElement('template');
+    drinkCardTemplate.innerHTML = `
+      <style>
+        @layer base, theme, variants;
+
+        @layer base {
+          :host {
+            display: block;
+            container-type: inline-size;
+            container-name: drink-card;
+            border-radius: var(--_card-radius);
+            transition: transform 0.2s ease, box-shadow 0.2s ease;
+          }
+
+          *, *::before, *::after {
+            box-sizing: border-box;
+            margin: 0;
+            padding: 0;
+          }
+
+          /* Native form controls do not inherit font/color by default across the shadow boundary */
+          button {
+            font: inherit;
+            color: inherit;
+            background: none;
+            border: none;
+            cursor: pointer;
+          }
+
+          .card {
+            display: grid;
+            grid-template-columns: 1fr;
+            gap: 12px;
+            height: 100%;
+            padding: var(--_card-padding);
+            border-radius: inherit;
+            text-align: center;
+          }
+
+          .card-header {
+            display: flex;
+            justify-content: space-between;
+            align-items: center;
+            gap: 8px;
+          }
+
+          .card-body {
+            display: flex;
+            flex-direction: column;
+            gap: 8px;
+          }
+
+          .card-footer {
+            display: flex;
+            justify-content: center;
+            align-items: center;
+            gap: 10px;
+            margin-top: auto;
+            padding-top: 6px;
+          }
+
+          /* Light touch-ups for projected Light DOM nodes; Light DOM rules still win */
+          ::slotted(h3) {
+            margin: 0 0 6px;
+            font-size: 1.25rem;
+            line-height: 1.3;
+          }
+
+          ::slotted(p) {
+            margin: 0;
+            line-height: 1.6;
+          }
+
+          /* Respond to the card's own inline dimensions rather than the viewport */
+          @container (min-width: 30rem) {
+            .card {
+              grid-template-columns: 1fr auto;
+              grid-template-areas:
+                "header footer"
+                "body footer";
+              text-align: left;
+              align-items: center;
+              column-gap: 24px;
+            }
+
+            .card-header {
+              grid-area: header;
+              justify-content: flex-start;
+            }
+
+            .card-body {
+              grid-area: body;
+            }
+
+            .card-footer {
+              grid-area: footer;
+              margin-top: 0;
+              padding-top: 0;
+              justify-content: flex-end;
+            }
+          }
+        }
+
+        @layer theme {
+          :host {
+            /* Private shadow custom properties read inherited public properties with single-source fallbacks */
+            --_card-bg: var(--card-bg, white);
+            --_card-fg: var(--card-fg, #3e2723);
+            --_card-primary: var(--card-primary, #4e342e);
+            --_card-secondary: var(--card-secondary, #d7ccc8);
+            --_card-accent: var(--card-accent, #ffab40);
+            --_card-radius: var(--card-radius, 8px);
+            --_card-shadow: var(--card-shadow, 0 2px 5px rgba(0, 0, 0, 0.1));
+            --_card-padding: var(--card-padding, 20px);
+            --_card-border: var(--card-border, 1px solid transparent);
+            box-shadow: var(--_card-shadow);
+          }
+
+          .card {
+            background: var(--_card-bg);
+            color: var(--_card-fg);
+            border: var(--_card-border);
+          }
+
+          ::slotted(h3) {
+            color: var(--_card-primary);
+          }
+
+          .badge {
+            display: inline-block;
+            padding: 3px 10px;
+            border-radius: 999px;
+            font-size: 0.75rem;
+            font-weight: 600;
+            letter-spacing: 0.03em;
+            text-transform: uppercase;
+            background: var(--_card-secondary);
+            color: var(--_card-primary);
+          }
+
+          .btn {
+            display: inline-block;
+            background: var(--_card-primary);
+            color: white;
+            padding: 10px 20px;
+            text-decoration: none;
+            border-radius: 5px;
+            font-weight: 500;
+            transition: background 0.3s ease, color 0.3s ease;
+          }
+
+          .btn:hover {
+            background: var(--_card-fg);
+          }
+
+          .favorite-btn {
+            display: inline-flex;
+            align-items: center;
+            justify-content: center;
+            width: 36px;
+            height: 36px;
+            border-radius: 50%;
+            border: 1px solid var(--_card-secondary);
+            color: var(--_card-primary);
+            transition: background 0.2s ease, border-color 0.2s ease;
+          }
+
+          .favorite-btn:hover {
+            border-color: var(--_card-accent);
+            background: rgba(255, 171, 64, 0.15);
+          }
+        }
+
+        @layer variants {
+          :host(:hover) {
+            transform: translateY(-2px);
+          }
+
+          :host([variant="featured"]),
+          :host([featured]) {
+            grid-column: 1 / -1;
+            --_card-bg: var(--card-featured-bg, #fff8f0);
+            --_card-border: 2px solid var(--_card-accent);
+            --_card-shadow: 0 4px 12px rgba(78, 52, 46, 0.15);
+          }
+
+          :host([variant="featured"]) .badge,
+          :host([featured]) .badge {
+            background: var(--_card-accent);
+            color: var(--_card-fg);
+          }
+
+          :host([variant="dark"]) {
+            --_card-bg: var(--card-dark-bg, #3e2723);
+            --_card-fg: var(--card-dark-fg, #fafafa);
+            --_card-primary: var(--card-dark-heading, #ffab40);
+            --_card-border: 1px solid rgba(255, 171, 64, 0.4);
+          }
+
+          :host([variant="dark"]) .badge {
+            background: rgba(255, 171, 64, 0.2);
+            color: var(--_card-accent);
+          }
+
+          :host([variant="dark"]) .btn {
+            background: var(--_card-accent);
+            color: #3e2723;
+          }
+
+          :host([variant="dark"]) .favorite-btn {
+            border-color: rgba(255, 171, 64, 0.4);
+            color: var(--_card-accent);
+          }
+
+          :host([variant="refreshing"]) {
+            --_card-border: 1px solid var(--_card-secondary);
+          }
+
+          :host([disabled]) {
+            opacity: 0.5;
+            pointer-events: none;
+          }
+
+          :host(:state(favorited)) .favorite-btn {
+            background: var(--_card-accent);
+            border-color: var(--_card-accent);
+            color: #3e2723;
+          }
+        }
+      </style>
+      <article class="card" part="card">
+        <header class="card-header" part="header">
+          <span class="badge" part="badge">Seasonal</span>
+          <button
+            type="button"
+            class="favorite-btn"
+            part="button"
+            aria-label="Toggle favorite"
+            aria-pressed="false"
+          >&#9734;</button>
+        </header>
+        <div class="card-body" part="body">
+          <slot></slot>
+        </div>
+        <footer class="card-footer" part="footer">
+          <a class="btn" part="action" href="/menu">View Details</a>
+        </footer>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['badge', 'href', 'cta-label', 'favorited', 'disabled'];
+
+      #internals;
+      #favorited = false;
+      #badgeEl;
+      #actionEl;
+      #favoriteBtn;
+
+      constructor() {
+        super();
+        const shadowRoot = this.attachShadow({ mode: 'open' });
+        shadowRoot.appendChild(drinkCardTemplate.content.cloneNode(true));
+
+        this.#internals = typeof this.attachInternals === 'function' ? this.attachInternals() : null;
+        this.#badgeEl = shadowRoot.querySelector('.badge');
+        this.#actionEl = shadowRoot.querySelector('.btn');
+        this.#favoriteBtn = shadowRoot.querySelector('.favorite-btn');
+
+        this.#favoriteBtn.addEventListener('click', () => {
+          if (this.hasAttribute('disabled')) return;
+          this.#setFavorited(!this.#favorited);
+        });
+      }
+
+      connectedCallback() {
+        this.#syncAttributes();
+      }
+
+      attributeChangedCallback() {
+        this.#syncAttributes();
+      }
+
+      #syncAttributes() {
+        if (this.#badgeEl) {
+          this.#badgeEl.textContent = this.getAttribute('badge') || 'Seasonal';
+        }
+        if (this.#actionEl) {
+          this.#actionEl.setAttribute('href', this.getAttribute('href') || '/menu');
+          this.#actionEl.textContent = this.getAttribute('cta-label') || 'View Details';
+        }
+        this.#setFavorited(this.hasAttribute('favorited'));
+      }
+
+      #setFavorited(isFavorited) {
+        this.#favorited = Boolean(isFavorited);
+        if (this.#internals && this.#internals.states) {
+          if (this.#favorited) {
+            this.#internals.states.add('favorited');
+          } else {
+            this.#internals.states.delete('favorited');
+          }
+        }
+        if (this.#favoriteBtn) {
+          this.#favoriteBtn.setAttribute('aria-pressed', String(this.#favorited));
+          this.#favoriteBtn.innerHTML = this.#favorited ? '&#9733;' : '&#9734;';
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
 </body>
 
