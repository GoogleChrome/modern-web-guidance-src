index 0000000..8af44f8
--- /dev/null
+++ b/grind-card.js
@@ -0,0 +1,440 @@
+/**
+ * `<grind-card>` Web Component
+ *
+ * A reusable, themeable, and container-responsive card component for
+ * The Daily Grind.
+ *
+ * Custom CSS Properties (Theming API - unset on :host so they inherit from any ancestor):
+ * - `--card-bg`: Card surface background (default: `white`)
+ * - `--card-fg`: Card body text color (default: `inherit`)
+ * - `--card-heading-color`: Card heading text color (default: `var(--primary, #4e342e)`)
+ * - `--card-border`: Card border shorthand (default: `none`)
+ * - `--card-radius`: Card border radius (default: `8px`)
+ * - `--card-padding`: Card internal padding (default: `20px`)
+ * - `--card-shadow`: Card box-shadow (default: `0 2px 5px rgba(0, 0, 0, 0.1)`)
+ * - `--card-gap`: Gap between card regions (default: `10px`)
+ * - `--card-align`: Text alignment in vertical layout (default: `center`)
+ * - `--card-btn-bg`: Action button/link background (default: `var(--primary, #4e342e)`)
+ * - `--card-btn-fg`: Action button/link text color (default: `white`)
+ * - `--card-btn-hover-bg`: Action button/link hover background (default: `#3e2723`)
+ * - `--card-btn-radius`: Action button/link border radius (default: `5px`)
+ * - `--card-btn-padding`: Action button/link padding (default: `10px 20px`)
+ * - `--card-badge-bg`: Badge background color (default: `var(--accent, #ffab40)`)
+ * - `--card-badge-fg`: Badge text color (default: `var(--text, #3e2723)`)
+ *
+ * Shadow Parts (`::part()`):
+ * - `card`: Outer card surface container
+ * - `header`: Header wrapper containing the title and optional badge
+ * - `badge`: Optional badge element
+ * - `title`: Card heading (`<h3>`)
+ * - `body`: Description/content container
+ * - `footer`: Actions/footer wrapper
+ * - `action` (also `button`): Primary call-to-action link/button inside the footer
+ *
+ * Slots:
+ * - `badge`: Optional badge content
+ * - `title`: Heading content (falls back to `heading` / `title` attribute)
+ * - (default): Body description content (falls back to `description` attribute)
+ * - `action` / `footer`: Custom action elements (falls back to built-in CTA using `href` and `cta-text` / `action-text`)
+ *
+ * Custom States (`:state()`):
+ * - `featured`: Present when the `featured` attribute is set or toggled
+ * - `disabled`: Present when the `disabled` attribute is set
+ * - `favorited`: Present when the `favorited` attribute is set or toggled
+ */
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    @layer base, theme, layout, state;
+
+    @layer base {
+      :host {
+        display: block;
+        container-type: inline-size;
+        container-name: grind-card;
+        box-sizing: border-box;
+
+        /* Private shadow aliases reading public inherited custom properties with single-source fallbacks */
+        --_card-bg: var(--card-bg, white);
+        --_card-fg: var(--card-fg, inherit);
+        --_card-heading-color: var(--card-heading-color, var(--primary, #4e342e));
+        --_card-border: var(--card-border, none);
+        --_card-radius: var(--card-radius, 8px);
+        --_card-padding: var(--card-padding, 20px);
+        --_card-shadow: var(--card-shadow, 0 2px 5px rgba(0, 0, 0, 0.1));
+        --_card-gap: var(--card-gap, 10px);
+        --_card-align: var(--card-align, center);
+        --_card-btn-bg: var(--card-btn-bg, var(--primary, #4e342e));
+        --_card-btn-fg: var(--card-btn-fg, white);
+        --_card-btn-hover-bg: var(--card-btn-hover-bg, #3e2723);
+        --_card-btn-radius: var(--card-btn-radius, 5px);
+        --_card-btn-padding: var(--card-btn-padding, 10px 20px);
+        --_card-badge-bg: var(--card-badge-bg, var(--accent, #ffab40));
+        --_card-badge-fg: var(--card-badge-fg, var(--text, #3e2723));
+      }
+
+      *,
+      *::before,
+      *::after {
+        box-sizing: border-box;
+      }
+
+      .card {
+        display: grid;
+        grid-template-columns: 1fr;
+        gap: var(--_card-gap);
+        align-items: center;
+        height: 100%;
+        background: var(--_card-bg);
+        color: var(--_card-fg);
+        border: var(--_card-border);
+        border-radius: var(--_card-radius);
+        padding: var(--_card-padding);
+        box-shadow: var(--_card-shadow);
+        text-align: var(--_card-align);
+        transition: box-shadow 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
+      }
+
+      .content {
+        display: flex;
+        flex-direction: column;
+        gap: var(--_card-gap);
+        min-width: 0;
+      }
+
+      .header {
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+        gap: 6px;
+      }
+
+      .badge {
+        display: inline-block;
+        background: var(--_card-badge-bg);
+        color: var(--_card-badge-fg);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.05em;
+        padding: 2px 8px;
+        border-radius: 999px;
+      }
+
+      .badge[hidden] {
+        display: none;
+      }
+
+      .title {
+        margin: 0;
+        font: inherit;
+        font-size: 1.17rem;
+        font-weight: 700;
+        line-height: 1.3;
+        color: var(--_card-heading-color);
+      }
+
+      .body {
+        margin: 0;
+        color: var(--_card-fg);
+      }
+
+      .footer {
+        margin-top: 5px;
+        display: flex;
+        justify-content: center;
+        align-items: center;
+        gap: 10px;
+      }
+
+      /* Form controls and interactive buttons/links inherit typography explicitly */
+      .action {
+        display: inline-block;
+        font: inherit;
+        color: var(--_card-btn-fg);
+        background: var(--_card-btn-bg);
+        padding: var(--_card-btn-padding);
+        border-radius: var(--_card-btn-radius);
+        border: none;
+        text-decoration: none;
+        cursor: pointer;
+        white-space: nowrap;
+        transition: background-color 0.3s ease, color 0.3s ease, transform 0.15s ease;
+      }
+
+      .action:hover,
+      .action:focus-visible {
+        background: var(--_card-btn-hover-bg);
+      }
+
+      .action[hidden] {
+        display: none;
+      }
+
+      /* Light touch-ups for projected Light DOM nodes */
+      ::slotted(p) {
+        margin: 0;
+      }
+
+      ::slotted(h1),
+      ::slotted(h2),
+      ::slotted(h3),
+      ::slotted(h4) {
+        margin: 0;
+        color: inherit;
+        font: inherit;
+      }
+
+      ::slotted(a),
+      ::slotted(button) {
+        font: inherit;
+      }
+    }
+
+    @layer layout {
+      /* Narrow spot (e.g. compact sidebar or narrow column) */
+      @container (max-width: 15rem) {
+        .card {
+          padding: 14px;
+          gap: 8px;
+        }
+
+        .footer {
+          width: 100%;
+        }
+
+        .action {
+          width: 100%;
+          text-align: center;
+        }
+      }
+
+      /* Wide spot: rearrange into a horizontal split layout */
+      @container (min-width: 28rem) {
+        .card {
+          grid-template-columns: 1fr auto;
+          text-align: left;
+          gap: 20px;
+        }
+
+        .header {
+          flex-direction: row;
+          align-items: baseline;
+          justify-content: flex-start;
+          flex-wrap: wrap;
+          gap: 10px;
+        }
+
+        .footer {
+          margin-top: 0;
+          justify-content: flex-end;
+        }
+      }
+    }
+
+    @layer state {
+      :host([disabled]),
+      :host(:state(disabled)) {
+        opacity: 0.55;
+        pointer-events: none;
+      }
+
+      :host(:state(featured)) .card {
+        outline: 2px solid var(--_card-badge-bg);
+        outline-offset: -2px;
+      }
+    }
+  </style>
+
+  <article class="card" part="card">
+    <div class="content" part="content">
+      <header class="header" part="header">
+        <span class="badge" part="badge" hidden>
+          <slot name="badge"></slot>
+        </span>
+        <h3 class="title" part="title">
+          <slot name="title"></slot>
+        </h3>
+      </header>
+      <div class="body" part="body">
+        <slot></slot>
+      </div>
+    </div>
+    <footer class="footer" part="footer">
+      <slot name="action">
+        <a class="action" part="action button" href="#">View Details</a>
+      </slot>
+    </footer>
+  </article>
+`;
+
+export class GrindCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'heading',
+      'title',
+      'description',
+      'href',
+      'cta-text',
+      'action-text',
+      'badge',
+      'featured',
+      'disabled',
+      'favorited'
+    ];
+  }
+
+  #internals;
+  #titleSlot;
+  #defaultSlot;
+  #badgeSlot;
+  #badgeEl;
+  #actionEl;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(template.content.cloneNode(true));
+
+    if (typeof this.attachInternals === 'function') {
+      this.#internals = this.attachInternals();
+    }
+
+    this.#titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+    this.#defaultSlot = this.shadowRoot.querySelector('slot:not([name])');
+    this.#badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+    this.#badgeEl = this.shadowRoot.querySelector('.badge');
+    this.#actionEl = this.shadowRoot.querySelector('.action');
+
+    this.#badgeSlot.addEventListener('slotchange', () => this.#syncBadge());
+    this.#titleSlot.addEventListener('slotchange', () => this.#syncTitle());
+    this.#defaultSlot.addEventListener('slotchange', () => this.#syncDescription());
+  }
+
+  connectedCallback() {
+    this.#syncAll();
+  }
+
+  attributeChangedCallback() {
+    if (this.isConnected) {
+      this.#syncAll();
+    }
+  }
+
+  get featured() {
+    return this.#hasState('featured') || this.hasAttribute('featured');
+  }
+
+  set featured(value) {
+    this.#setState('featured', Boolean(value));
+    this.toggleAttribute('featured', Boolean(value));
+  }
+
+  get favorited() {
+    return this.#hasState('favorited') || this.hasAttribute('favorited');
+  }
+
+  set favorited(value) {
+    this.#setState('favorited', Boolean(value));
+    this.toggleAttribute('favorited', Boolean(value));
+  }
+
+  get disabled() {
+    return this.#hasState('disabled') || this.hasAttribute('disabled');
+  }
+
+  set disabled(value) {
+    this.#setState('disabled', Boolean(value));
+    this.toggleAttribute('disabled', Boolean(value));
+  }
+
+  #hasState(name) {
+    return Boolean(this.#internals?.states?.has(name));
+  }
+
+  #setState(name, active) {
+    if (!this.#internals?.states) return;
+    if (active) {
+      this.#internals.states.add(name);
+    } else {
+      this.#internals.states.delete(name);
+    }
+  }
+
+  #syncAll() {
+    this.#syncTitle();
+    this.#syncDescription();
+    this.#syncBadge();
+    this.#syncAction();
+    this.#syncStates();
+  }
+
+  #syncTitle() {
+    if (!this.#titleSlot) return;
+    const assigned = this.#titleSlot.assignedNodes({ flatten: false });
+    if (assigned.length === 0) {
+      const headingText = this.getAttribute('heading') || this.getAttribute('title') || '';
+      this.#titleSlot.textContent = headingText;
+    }
+  }
+
+  #syncDescription() {
+    if (!this.#defaultSlot) return;
+    const assigned = this.#defaultSlot
+      .assignedNodes({ flatten: false })
+      .filter((node) => node.nodeType !== Node.TEXT_NODE || node.textContent.trim() !== '');
+    if (assigned.length === 0 && this.hasAttribute('description')) {
+      this.#defaultSlot.textContent = this.getAttribute('description') || '';
+    }
+  }
+
+  #syncBadge() {
+    if (!this.#badgeSlot || !this.#badgeEl) return;
+    const assigned = this.#badgeSlot
+      .assignedNodes({ flatten: false })
+      .filter((node) => node.nodeType !== Node.TEXT_NODE || node.textContent.trim() !== '');
+    const badgeAttr = this.getAttribute('badge');
+
+    if (assigned.length > 0) {
+      this.#badgeEl.hidden = false;
+    } else if (badgeAttr) {
+      this.#badgeSlot.textContent = badgeAttr;
+      this.#badgeEl.hidden = false;
+    } else {
+      this.#badgeSlot.textContent = '';
+      this.#badgeEl.hidden = true;
+    }
+  }
+
+  #syncAction() {
+    if (!this.#actionEl) return;
+    const href = this.getAttribute('href');
+    const ctaText =
+      this.getAttribute('cta-text') ||
+      this.getAttribute('action-text') ||
+      'View Details';
+
+    this.#actionEl.textContent = ctaText;
+    if (href) {
+      this.#actionEl.setAttribute('href', href);
+      this.#actionEl.hidden = false;
+    } else if (this.hasAttribute('cta-text') || this.hasAttribute('action-text')) {
+      this.#actionEl.setAttribute('href', '#');
+      this.#actionEl.hidden = false;
+    } else {
+      this.#actionEl.setAttribute('href', '#');
+      this.#actionEl.hidden = false;
+    }
+  }
+
+  #syncStates() {
+    this.#setState('featured', this.hasAttribute('featured'));
+    this.#setState('disabled', this.hasAttribute('disabled'));
+    this.#setState('favorited', this.hasAttribute('favorited'));
+  }
+}
+
+if (!customElements.get('grind-card')) {
+  customElements.define('grind-card', GrindCard);
+}
