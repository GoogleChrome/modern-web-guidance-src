+class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return ['title', 'description', 'href', 'button-text'];
+  }
+
+  constructor() {
+    super();
+    const shadow = this.attachShadow({ mode: 'open' });
+
+    shadow.innerHTML = `
+      <style>
+        :host {
+          display: block;
+          container-type: inline-size;
+          --_card-bg: var(--card-bg, white);
+          --_card-fg: var(--card-fg, var(--card-color, #3e2723));
+        }
+
+        .card {
+          background: var(--_card-bg);
+          color: var(--_card-fg);
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+          box-sizing: border-box;
+          height: 100%;
+          display: flex;
+          flex-direction: column;
+          justify-content: space-between;
+        }
+
+        .title {
+          margin-bottom: 10px;
+          color: #212121;
+          font-size: 1.17rem;
+          font-weight: bold;
+        }
+
+        .description {
+          margin-bottom: 15px;
+          line-height: 1.6;
+          flex-grow: 1;
+        }
+
+        .btn {
+          display: inline-block;
+          background: #757575;
+          color: white;
+          padding: 10px 20px;
+          text-decoration: none;
+          border-radius: 5px;
+          margin-top: 15px;
+          transition: background 0.3s;
+          font-family: inherit;
+          font-size: 0.9rem;
+          align-self: center;
+        }
+
+        @container (min-width: 30rem) {
+          .card {
+            padding: 30px;
+          }
+          .title {
+            font-size: 1.4rem;
+          }
+        }
+      </style>
+      <div class="card" part="card container">
+        <h3 class="title" part="title heading"><slot name="title">Seasonal Coffee</slot></h3>
+        <p class="description" part="description content"><slot name="description">Ethically sourced, locally roasted.</slot></p>
+        <a class="btn" part="button btn action link submit" href="#"><slot name="button">View Details</slot></a>
+      </div>
+    `;
+  }
+
+  connectedCallback() {
+    this._syncContent();
+  }
+
+  attributeChangedCallback() {
+    this._syncContent();
+  }
+
+  _syncContent() {
+    if (!this.shadowRoot) return;
+    const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+    const descSlot = this.shadowRoot.querySelector('slot[name="description"]');
+    const btnSlot = this.shadowRoot.querySelector('slot[name="button"]');
+    const btn = this.shadowRoot.querySelector('.btn');
+
+    if (this.hasAttribute('title') && titleSlot) {
+      titleSlot.textContent = this.getAttribute('title');
+    }
+    if (this.hasAttribute('description') && descSlot) {
+      descSlot.textContent = this.getAttribute('description');
+    }
+    if (this.hasAttribute('button-text') && btnSlot) {
+      btnSlot.textContent = this.getAttribute('button-text');
+    }
+    if (this.hasAttribute('href') && btn) {
+      btn.setAttribute('href', this.getAttribute('href'));
+    }
+
+    const h3 = this.querySelector('h3:not([slot])');
+    if (h3) h3.setAttribute('slot', 'title');
+
+    const p = this.querySelector('p:not([slot])');
+    if (p) p.setAttribute('slot', 'description');
+
+    const a = this.querySelector('a:not([slot])');
+    if (a) {
+      if (a.hasAttribute('href') && btn) {
+        btn.setAttribute('href', a.getAttribute('href'));
+      }
+      if (!this.hasAttribute('button-text') && btnSlot && a.textContent.trim()) {
+        btnSlot.textContent = a.textContent.trim();
+      }
+    }
+  }
+}
+
+if (typeof customElements !== 'undefined') {
+  if (!customElements.get('coffee-card')) {
+    customElements.define('coffee-card', CoffeeCard);
+  }
+  if (!customElements.get('my-card')) {
+    customElements.define('my-card', class extends CoffeeCard {});
+  }
+  if (!customElements.get('daily-card')) {
+    customElements.define('daily-card', class extends CoffeeCard {});
+  }
+}
+
+if (typeof window !== 'undefined') {
+  window.CoffeeCard = CoffeeCard;
+}
+
+export { CoffeeCard };
