diff --git a/my-toggle.js b/my-toggle.js
new file mode 100644
index 0000000..2f2d3cd
--- /dev/null
+++ b/my-toggle.js
@@ -0,0 +1,152 @@
+/**
+ * MyToggle autonomous custom element.
+ *
+ * Implements attribute/property reflection for:
+ * - count (numeric)
+ * - label (string)
+ * - disabled (boolean)
+ *
+ * @extends {HTMLElement}
+ */
+export class MyToggle extends HTMLElement {
+  /**
+   * Observed attributes snapshotted at customElements.define() time.
+   * @type {string[]}
+   */
+  static observedAttributes = ['label', 'count', 'disabled'];
+
+  constructor() {
+    super();
+  }
+
+  /**
+   * Numeric count property reflected to/from 'count' attribute.
+   * Coerced to number on read; serialized to string on write.
+   * @returns {number}
+   */
+  get count() {
+    const val = this.getAttribute('count');
+    if (val === null) return 0;
+    const num = Number(val);
+    return Number.isNaN(num) ? 0 : num;
+  }
+
+  /**
+   * @param {number | string} v
+   */
+  set count(v) {
+    const num = Number(v);
+    const str = String(Number.isNaN(num) ? 0 : num);
+    if (this.getAttribute('count') !== str) {
+      this.setAttribute('count', str);
+    }
+  }
+
+  /**
+   * String label property reflected to/from 'label' attribute.
+   * @returns {string}
+   */
+  get label() {
+    return this.getAttribute('label') ?? '';
+  }
+
+  /**
+   * @param {string | null | undefined} v
+   */
+  set label(v) {
+    if (v) {
+      const str = String(v);
+      if (this.getAttribute('label') !== str) {
+        this.setAttribute('label', str);
+      }
+    } else {
+      if (this.hasAttribute('label')) {
+        this.removeAttribute('label');
+      }
+    }
+  }
+
+  /**
+   * Boolean disabled property reflected to/from 'disabled' attribute.
+   * Setting false removes the attribute rather than writing "false".
+   * @returns {boolean}
+   */
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+
+  /**
+   * @param {boolean | unknown} on
+   */
+  set disabled(on) {
+    const bool = Boolean(on);
+    if (this.toggleAttribute) {
+      this.toggleAttribute('disabled', bool);
+    } else {
+      if (bool) {
+        if (!this.hasAttribute('disabled')) {
+          this.setAttribute('disabled', '');
+        }
+      } else {
+        if (this.hasAttribute('disabled')) {
+          this.removeAttribute('disabled');
+        }
+      }
+    }
+  }
+
+  /**
+   * Lifecycle: Element inserted into DOM.
+   */
+  connectedCallback() {
+    this.render();
+  }
+
+  /**
+   * Lifecycle: Element moved via Node.moveBefore().
+   */
+  connectedMoveCallback() {
+    // Preserve state across Node.moveBefore()
+  }
+
+  /**
+   * Lifecycle: Element removed from DOM.
+   */
+  disconnectedCallback() {
+    // Teardown
+  }
+
+  /**
+   * Lifecycle: Observed attribute changed.
+   * @param {string} name
+   * @param {string | null} oldVal
+   * @param {string | null} newVal
+   */
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) {
+      this.render();
+    }
+  }
+
+  /**
+   * Render component state into the DOM.
+   */
+  render() {
+    const count = this.count;
+    const label = this.label;
+    const disabled = this.disabled;
+    this.innerHTML = `
+      <div class="toggle-card${disabled ? ' is-disabled' : ''}">
+        <span class="label toggle-label">${label}</span>
+        <span class="count toggle-count">${count}</span>
+        <button type="button" class="btn toggle-btn"${disabled ? ' disabled' : ''}>
+          ${label ? label + ': ' : ''}${count}
+        </button>
+      </div>
+    `;
+  }
+}
+
+if (typeof customElements !== 'undefined' && !customElements.get('my-toggle')) {
+  customElements.define('my-toggle', MyToggle);
+}
