+  <script type="module">
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = [
+        'name',
+        'description',
+        'href',
+        'label',
+        'price',
+        'count',
+        'featured',
+        'disabled'
+      ];
+
+      #internals;
+      #initialized = false;
+      #boundHandleClick;
+
+      constructor() {
+        super();
+        if (typeof this.attachInternals === 'function') {
+          this.#internals = this.attachInternals();
+        }
+        this.#boundHandleClick = this.#handleClick.bind(this);
+      }
+
+      // String attributes reflected via getter/setter
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+      set name(v) {
+        v ? this.setAttribute('name', String(v)) : this.removeAttribute('name');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+      set description(v) {
+        v ? this.setAttribute('description', String(v)) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+      set href(v) {
+        v ? this.setAttribute('href', String(v)) : this.removeAttribute('href');
+      }
+
+      get label() {
+        return this.getAttribute('label') ?? '';
+      }
+      set label(v) {
+        v ? this.setAttribute('label', String(v)) : this.removeAttribute('label');
+      }
+
+      // Numeric attributes: coerce from string on read, serialize on write
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+      set price(v) {
+        this.setAttribute('price', String(Number(v) || 0));
+      }
+
+      get count() {
+        return Number(this.getAttribute('count')) || 0;
+      }
+      set count(v) {
+        this.setAttribute('count', String(Number(v) || 0));
+      }
+
+      // Boolean attributes: present = true, absent = false. Never set to "false"
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+      set featured(on) {
+        this.toggleAttribute('featured', !!on);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+      set disabled(on) {
+        this.toggleAttribute('disabled', !!on);
+      }
+
+      connectedCallback() {
+        // Make setup idempotent since connectedCallback can run more than once
+        this.removeEventListener('click', this.#boundHandleClick);
+        this.addEventListener('click', this.#boundHandleClick);
+
+        if (!this.#initialized) {
+          this.#upgradeProperties();
+          this.#initialized = true;
+        }
+
+        this.render();
+      }
+
+      disconnectedCallback() {
+        // Tear down listeners so we don't leak, while allowing re-insertion later
+        this.removeEventListener('click', this.#boundHandleClick);
+      }
+
+      connectedMoveCallback() {
+        // Preserve state and DOM without running full disconnect/reconnect teardown
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal && this.isConnected) {
+          this.render();
+        }
+      }
+
+      #upgradeProperties() {
+        for (const prop of CoffeeCard.observedAttributes) {
+          if (Object.prototype.hasOwnProperty.call(this, prop)) {
+            const value = this[prop];
+            delete this[prop];
+            this[prop] = value;
+          }
+        }
+      }
+
+      #handleClick(event) {
+        const actionBtn = event.target.closest('[data-action="select"]');
+        if (!actionBtn) return;
+
+        if (this.disabled) {
+          event.preventDefault();
+          return;
+        }
+
+        if (this.#internals?.states) {
+          if (this.#internals.states.has('selected')) {
+            this.#internals.states.delete('selected');
+          } else {
+            this.#internals.states.add('selected');
+          }
+        }
+      }
+
+      render() {
+        const nameText = this.name;
+        const descText = this.description;
+        const hrefVal = this.href || '#';
+        const ctaLabel = this.label || 'View Details';
+        const priceVal = this.price;
+        const countVal = this.count;
+        const isFeatured = this.featured;
+        const isDisabled = this.disabled;
+
+        this.classList.add('card');
+        this.replaceChildren();
+
+        if (isFeatured) {
+          const badge = document.createElement('span');
+          badge.className = 'card-badge';
+          badge.textContent = 'Featured';
+          this.appendChild(badge);
+        }
+
+        const heading = document.createElement('h3');
+        heading.textContent = nameText;
+        this.appendChild(heading);
+
+        const paragraph = document.createElement('p');
+        paragraph.textContent = descText;
+        this.appendChild(paragraph);
+
+        if (priceVal > 0) {
+          const meta = document.createElement('div');
+          meta.className = 'card-meta';
+          const total = (priceVal * (countVal > 0 ? countVal : 1)).toFixed(2);
+          meta.textContent = countVal > 1 ? `$${total} (${countVal}x)` : `$${priceVal.toFixed(2)}`;
+          this.appendChild(meta);
+        }
+
+        const link = document.createElement('a');
+        link.className = 'btn';
+        link.href = hrefVal;
+        link.dataset.action = 'select';
+        link.textContent = isDisabled ? 'Unavailable' : ctaLabel;
+        if (isDisabled) {
+          link.setAttribute('aria-disabled', 'true');
+          link.tabIndex = -1;
+        }
+        this.appendChild(link);
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
