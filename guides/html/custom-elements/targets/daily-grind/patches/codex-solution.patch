+// Attributes are the source of truth for this component's public API.
+export class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'href', 'price', 'disabled'];
+
+  #initialized = false;
+  #heading;
+  #description;
+  #price;
+  #link;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    const style = document.createElement('style');
+    style.textContent = `
+      :host { display: block; }
+      * { box-sizing: border-box; margin: 0; padding: 0; }
+      h3 { margin-bottom: 10px; color: var(--primary, #4e342e); }
+      a {
+        display: inline-block; background: var(--primary, #4e342e);
+        color: white; padding: 10px 20px; text-decoration: none;
+        border-radius: 5px; margin-top: 15px; transition: background 0.3s;
+      }
+      a:hover { background: #3e2723; }
+      a:focus-visible { outline: 2px solid var(--accent, #ffab40); outline-offset: 3px; }
+      a[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; }
+    `;
+    this.#heading = document.createElement('h3');
+    this.#description = document.createElement('p');
+    this.#price = document.createElement('p');
+    this.#link = document.createElement('a');
+    this.#link.textContent = 'View Details';
+    root.append(style, this.#heading, this.#description, this.#price, this.#link);
+  }
+
+  get name() { return this.getAttribute('name') ?? ''; }
+  set name(value) { this.setAttribute('name', String(value)); }
+
+  get description() { return this.getAttribute('description') ?? ''; }
+  set description(value) { this.setAttribute('description', String(value)); }
+
+  get href() { return this.getAttribute('href') ?? ''; }
+  set href(value) { this.setAttribute('href', String(value)); }
+
+  get price() {
+    const value = Number(this.getAttribute('price'));
+    return Number.isFinite(value) && value >= 0 ? value : 0;
+  }
+  set price(value) {
+    const number = Number(value);
+    this.setAttribute('price', String(Number.isFinite(number) && number >= 0 ? number : 0));
+  }
+
+  get disabled() { return this.hasAttribute('disabled'); }
+  set disabled(value) { this.toggleAttribute('disabled', Boolean(value)); }
+
+  connectedCallback() {
+    if (!this.#initialized) {
+      this.#initialized = true;
+      // Replay properties assigned while this was still an unknown element.
+      for (const property of CoffeeCard.observedAttributes) {
+        if (Object.prototype.hasOwnProperty.call(this, property)) {
+          const value = Reflect.get(this, property);
+          Reflect.deleteProperty(this, property);
+          Reflect.set(this, property, value);
+        }
+      }
+    }
+    this.#link.addEventListener('click', this.#onClick);
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    this.#link.removeEventListener('click', this.#onClick);
+  }
+
+  // A state-preserving move needs no teardown or setup.
+  connectedMoveCallback() {}
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue) this.#render();
+  }
+
+  #onClick = (event) => {
+    if (this.disabled) event.preventDefault();
+  };
+
+  #render() {
+    this.#heading.textContent = this.name;
+    this.#description.textContent = this.description;
+    this.#price.hidden = !this.hasAttribute('price');
+    this.#price.textContent = new Intl.NumberFormat('en-US', {
+      style: 'currency', currency: 'USD',
+    }).format(this.price);
+    this.#link.setAttribute('aria-disabled', String(this.disabled));
+    if (this.disabled || !this.href) {
+      this.#link.removeAttribute('href');
+      this.#link.setAttribute('role', 'link');
+      this.#link.tabIndex = -1;
+    } else {
+      this.#link.setAttribute('href', this.href);
+      this.#link.removeAttribute('role');
+      this.#link.removeAttribute('tabindex');
+    }
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
