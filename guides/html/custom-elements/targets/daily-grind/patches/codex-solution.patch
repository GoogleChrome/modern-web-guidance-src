+// @ts-check
+
+const template = document.querySelector('template#coffee-card-template');
+
+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'description', 'brew-hours', 'details-url', 'disabled'];
+
+  #heading;
+  #description;
+  #brewTime;
+  #link;
+
+  constructor() {
+    super();
+
+    if (!(template instanceof HTMLTemplateElement)) {
+      throw new Error('The coffee card template is missing.');
+    }
+
+    const shadow = this.attachShadow({ mode: 'open' });
+    shadow.append(template.content.cloneNode(true));
+
+    const heading = shadow.querySelector('h3');
+    const description = shadow.querySelector('p[data-description]');
+    const brewTime = shadow.querySelector('p[data-brew-time]');
+    const link = shadow.querySelector('a');
+
+    if (!heading || !description || !(brewTime instanceof HTMLParagraphElement) || !link) {
+      throw new Error('The coffee card template is incomplete.');
+    }
+
+    this.#heading = heading;
+    this.#description = description;
+    this.#brewTime = brewTime;
+    this.#link = link;
+  }
+
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+
+  set name(value) {
+    this.setAttribute('name', value);
+  }
+
+  get description() {
+    return this.getAttribute('description') ?? '';
+  }
+
+  set description(value) {
+    this.setAttribute('description', value);
+  }
+
+  get brewHours() {
+    const hours = Number(this.getAttribute('brew-hours'));
+    return Number.isFinite(hours) && hours > 0 ? hours : 0;
+  }
+
+  set brewHours(value) {
+    if (Number.isFinite(value) && value > 0) {
+      this.setAttribute('brew-hours', String(value));
+    } else {
+      this.removeAttribute('brew-hours');
+    }
+  }
+
+  get detailsUrl() {
+    return this.getAttribute('details-url') ?? '';
+  }
+
+  set detailsUrl(value) {
+    this.setAttribute('details-url', value);
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+
+  set disabled(value) {
+    this.toggleAttribute('disabled', Boolean(value));
+  }
+
+  connectedCallback() {
+    // Property assignments made before registration can shadow the accessors.
+    for (const property of /** @type {const} */ (['name', 'description', 'brewHours', 'detailsUrl', 'disabled'])) {
+      this.#upgradeProperty(property);
+    }
+
+    this.#renderName();
+    this.#renderDescription();
+    this.#renderBrewTime();
+    this.#renderLink();
+  }
+
+  /**
+   * @param {string} attribute
+   * @param {string | null} previous
+   * @param {string | null} current
+   */
+  attributeChangedCallback(attribute, previous, current) {
+    if (previous === current) return;
+
+    switch (attribute) {
+      case 'name':
+        this.#renderName();
+        break;
+      case 'description':
+        this.#renderDescription();
+        break;
+      case 'brew-hours':
+        this.#renderBrewTime();
+        break;
+      case 'details-url':
+      case 'disabled':
+        this.#renderLink();
+        break;
+    }
+  }
+
+  /** @param {'name' | 'description' | 'brewHours' | 'detailsUrl' | 'disabled'} property */
+  #upgradeProperty(property) {
+    if (!Object.hasOwn(this, property)) return;
+
+    const value = this[property];
+    if (Reflect.deleteProperty(this, property)) {
+      Reflect.set(this, property, value);
+    }
+  }
+
+  #renderName() {
+    this.#heading.textContent = this.name;
+    this.#link.setAttribute('aria-label', this.name ? `View Details for ${this.name}` : 'View Details');
+  }
+
+  #renderDescription() {
+    this.#description.textContent = this.description;
+  }
+
+  #renderBrewTime() {
+    const hours = this.brewHours;
+    this.#brewTime.textContent = hours ? `Brew time: ${hours} ${hours === 1 ? 'hour' : 'hours'}` : '';
+    this.#brewTime.hidden = hours === 0;
+  }
+
+  #renderLink() {
+    const destination = this.detailsUrl.trim();
+    let hasDestination = false;
+    if (destination) {
+      try {
+        const { protocol } = new URL(destination, this.baseURI);
+        hasDestination = protocol === 'https:' || protocol === 'http:';
+      } catch {
+        // Leave malformed destinations unavailable.
+      }
+    }
+
+    this.#link.hidden = !hasDestination;
+    if (!hasDestination || this.disabled) {
+      this.#link.removeAttribute('href');
+    } else {
+      this.#link.setAttribute('href', destination);
+    }
+
+    if (hasDestination && this.disabled) {
+      this.#link.setAttribute('role', 'link');
+      this.#link.setAttribute('aria-disabled', 'true');
+    } else {
+      this.#link.removeAttribute('role');
+      this.#link.removeAttribute('aria-disabled');
+    }
+  }
+}
+
+customElements.define('coffee-card', CoffeeCard);
