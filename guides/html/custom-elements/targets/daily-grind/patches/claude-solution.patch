+
+          h3 { margin: 0 0 10px; color: var(--primary, #4e342e); }
+          .price { margin: 0 0 10px; font-weight: bold; color: var(--text, #3e2723); }
+          .description { display: block; }
+          :host(:not(:state(has-description))) .description { display: none; }
+          ::slotted(p) { margin: 0; }
+
+          .btn {
+            display: inline-block;
+            background: var(--primary, #4e342e);
+            color: white;
+            padding: 10px 20px;
+            text-decoration: none;
+            border-radius: 5px;
+            margin-top: 15px;
+            transition: background 0.3s;
+          }
+          .btn:hover { background: #3e2723; }
+          .btn[aria-disabled="true"] {
+            background: #9e9e9e;
+            cursor: not-allowed;
+            pointer-events: none;
+          }
+        </style>
+        <span class="badge" part="badge" hidden>Featured</span>
+        <h3 part="name"></h3>
+        <p class="price" part="price" hidden></p>
+        <div class="description" part="description"><slot name="description"></slot></div>
+        <a class="btn" part="button">View Details</a>
+      `;
+
+      /**
+       * <coffee-card> — a menu item card.
+       *
+       * Attributes (reflected to properties):
+       *   name      (string)  → .name
+       *   href      (string)  → .href
+       *   price     (number)  → .price      (absent / invalid → NaN, price hidden)
+       *   featured  (boolean) → .featured
+       *   sold-out  (boolean) → .soldOut
+       *
+       * Slots:
+       *   description — the card's descriptive text.
+       *
+       * Custom states:
+       *   :state(has-description) — the description slot has assigned content.
+       */
+      class CoffeeCard extends HTMLElement {
+        static observedAttributes = ['name', 'href', 'price', 'featured', 'sold-out'];
+
+        #internals;
+        #els = null;
+        #abort = null;
+
+        constructor() {
+          super();
+          // Only build internal structure here; never read attributes/children in the constructor.
+          this.#internals = this.attachInternals();
+          const root = this.shadowRoot ?? this.attachShadow({ mode: 'open' });
+          root.replaceChildren(template.content.cloneNode(true));
+          this.#els = {
+            badge: root.querySelector('.badge'),
+            name: root.querySelector('h3'),
+            price: root.querySelector('.price'),
+            slot: root.querySelector('slot[name="description"]'),
+            button: root.querySelector('.btn'),
+          };
+        }
+
+        // --- String attributes -------------------------------------------------
+        get name() { return this.getAttribute('name') ?? ''; }
+        set name(v) {
+          v ? this.setAttribute('name', String(v)) : this.removeAttribute('name');
+        }
+
+        get href() { return this.getAttribute('href') ?? ''; }
+        set href(v) {
+          v ? this.setAttribute('href', String(v)) : this.removeAttribute('href');
+        }
+
+        // --- Numeric attribute -------------------------------------------------
+        get price() {
+          const raw = this.getAttribute('price');
+          if (raw === null || raw.trim() === '') return NaN;
+          const n = Number(raw);
+          return Number.isFinite(n) && n >= 0 ? n : NaN;
+        }
+        set price(v) {
+          const n = Number(v);
+          if (v === null || v === undefined || v === '' || !Number.isFinite(n)) {
+            this.removeAttribute('price');
+          } else {
+            this.setAttribute('price', String(n));
+          }
+        }
+
+        // --- Boolean attributes (present = true; never set to "false") --------
+        get featured() { return this.hasAttribute('featured'); }
+        set featured(on) { this.toggleAttribute('featured', !!on); }
+
+        get soldOut() { return this.hasAttribute('sold-out'); }
+        set soldOut(on) { this.toggleAttribute('sold-out', !!on); }
+
+        // --- Lifecycle ---------------------------------------------------------
+        connectedCallback() {
+          // Properties may have been set on the instance before upgrade; re-route
+          // them through the class setters so they reflect to attributes.
+          for (const prop of ['name', 'href', 'price', 'featured', 'soldOut']) {
+            this.#upgradeProperty(prop);
+          }
+
+          // Idempotent: connectedCallback runs on every insertion.
+          if (!this.#abort) {
+            this.#abort = new AbortController();
+            this.#els.slot.addEventListener('slotchange', () => this.#syncDescription(), {
+              signal: this.#abort.signal,
+            });
+          }
+
+          // Attributes/children may already exist (upgrade), so sync from them now.
+          this.#render();
+          this.#syncDescription();
+        }
+
+        // Moving via Node.moveBefore(): keep listeners and state as-is.
+        connectedMoveCallback() {}
+
+        disconnectedCallback() {
+          // Element may be re-inserted later; connectedCallback will set this up again.
+          this.#abort?.abort();
+          this.#abort = null;
+        }
+
+        attributeChangedCallback(name, oldVal, newVal) {
+          if (oldVal === newVal || !this.isConnected) return;
+          this.#render();
+        }
+
+        // --- Internals ---------------------------------------------------------
+        #upgradeProperty(prop) {
+          if (Object.prototype.hasOwnProperty.call(this, prop)) {
+            const value = this[prop];
+            delete this[prop];
+            this[prop] = value;
+          }
+        }
+
+        #setState(state, on) {
+          const states = this.#internals.states;
+          if (!states) return; // CustomStateSet unsupported
+          try {
+            on ? states.add(state) : states.delete(state);
+          } catch {
+            // Older implementations only accepted the legacy "--state" syntax.
+          }
+        }
+
+        #syncDescription() {
+          const hasContent = this.#els.slot
+            .assignedNodes({ flatten: true })
+            .some((n) => n.nodeType === Node.ELEMENT_NODE || n.textContent.trim() !== '');
+          this.#setState('has-description', hasContent);
+        }
+
+        #render() {
+          const { badge, name, price, button } = this.#els;
+          const soldOut = this.soldOut;
+
+          name.textContent = this.name;
+
+          const p = this.price;
+          price.hidden = Number.isNaN(p);
+          price.textContent = Number.isNaN(p) ? '' : priceFormatter.format(p);
+
+          badge.hidden = !this.featured;
+
+          const label = this.name ? `${this.name} details` : 'Item details';
+          if (soldOut || !this.href) {
+            button.removeAttribute('href');
+            button.setAttribute('aria-disabled', 'true');
+            button.textContent = soldOut ? 'Sold Out' : 'View Details';
+            button.setAttribute('aria-label', soldOut ? `${this.name || 'Item'} is sold out` : label);
+          } else {
+            button.setAttribute('href', this.href);
+            button.removeAttribute('aria-disabled');
+            button.textContent = 'View Details';
+            button.setAttribute('aria-label', label);
+          }
+        }
+      }
+
+      if (!customElements.get('coffee-card')) {
+        customElements.define('coffee-card', CoffeeCard);
+      }
+    })();
+  </script>
