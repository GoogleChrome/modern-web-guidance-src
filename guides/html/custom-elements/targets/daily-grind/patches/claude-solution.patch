+  <script type="module">
+    /**
+     * <coffee-card> — an autonomous custom element for a menu item.
+     *
+     * The card's content (heading, description, action link) lives in light DOM
+     * so it stays fully usable if this script never loads. The element enhances it
+     * with a formatted price and a "Sold out" status, driven by attributes:
+     *
+     *   name      (string)  → `name` property; keeps the card heading in sync
+     *   price     (number)  → `price` property; shown as a formatted currency value
+     *   sold-out  (boolean) → `soldOut` property; shows a textual "Sold out" status
+     */
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = ['name', 'price', 'sold-out'];
+
+      static #priceFormat = new Intl.NumberFormat('en-US', {
+        style: 'currency',
+        currency: 'USD',
+      });
+
+      /** @type {HTMLParagraphElement} */
+      #priceEl;
+      /** @type {HTMLParagraphElement} */
+      #statusEl;
+      /** @type {MutationObserver | null} */
+      #childObserver = null;
+
+      constructor() {
+        super();
+        // Create (but don't attach) the nodes this element owns; children must not
+        // be added in the constructor, and the full DOM may not be parsed yet.
+        this.#priceEl = document.createElement('p');
+        this.#priceEl.className = 'card-price';
+        this.#priceEl.hidden = true;
+
+        this.#statusEl = document.createElement('p');
+        this.#statusEl.className = 'card-status';
+        this.#statusEl.textContent = 'Sold out';
+        this.#statusEl.hidden = true;
+      }
+
+      // String attribute.
+      /** @returns {string} */
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+      /** @param {string} value */
+      set name(value) {
+        value ? this.setAttribute('name', String(value)) : this.removeAttribute('name');
+      }
+
+      // Numeric attribute: coerce on read, serialize on write.
+      /** @returns {number} */
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+      /** @param {number} value */
+      set price(value) {
+        const num = Number(value);
+        if (value === null || value === undefined || !Number.isFinite(num)) {
+          this.removeAttribute('price');
+        } else {
+          this.setAttribute('price', String(num));
+        }
+      }
+
+      // Boolean attribute: present = true, absent = false.
+      /** @returns {boolean} */
+      get soldOut() {
+        return this.hasAttribute('sold-out');
+      }
+      /** @param {boolean} on */
+      set soldOut(on) {
+        this.toggleAttribute('sold-out', Boolean(on));
+      }
+
+      connectedCallback() {
+        // Properties may have been set on the element before it was upgraded;
+        // re-run them through the setters so they reflect to attributes.
+        this.#upgradeProperty('name');
+        this.#upgradeProperty('price');
+        this.#upgradeProperty('soldOut');
+
+        // Idempotent: runs again whenever the element is re-inserted.
+        this.#ensureStructure();
+        this.#render();
+
+        // Children may still be arriving from the parser (or be replaced later),
+        // so keep the owned nodes in place as direct children change.
+        if (!this.#childObserver) {
+          this.#childObserver = new MutationObserver(() => {
+            this.#ensureStructure();
+            this.#render();
+          });
+          this.#childObserver.observe(this, { childList: true });
+        }
+      }
+
+      disconnectedCallback() {
+        // Tear down, but allow for re-insertion (connectedCallback re-creates it).
+        this.#childObserver?.disconnect();
+        this.#childObserver = null;
+      }
+
+      connectedMoveCallback() {
+        // Moved via moveBefore(): DOM and observer are still valid, nothing to do.
+      }
+
+      /**
+       * @param {string} _name
+       * @param {string | null} oldValue
+       * @param {string | null} newValue
+       */
+      attributeChangedCallback(_name, oldValue, newValue) {
+        if (oldValue === newValue || !this.isConnected) return;
+        this.#render();
+      }
+
+      /** @param {'name' | 'price' | 'soldOut'} prop */
+      #upgradeProperty(prop) {
+        if (Object.prototype.hasOwnProperty.call(this, prop)) {
+          const value = /** @type {any} */ (this)[prop];
+          delete /** @type {any} */ (this)[prop];
+          /** @type {any} */ (this)[prop] = value;
+        }
+      }
+
+      /** @returns {HTMLHeadingElement | null} */
+      #heading() {
+        return this.querySelector(':scope > h3');
+      }
+
+      /** Insert the owned nodes into light DOM if they're missing. */
+      #ensureStructure() {
+        let heading = this.#heading();
+        if (!heading && this.name) {
+          heading = document.createElement('h3');
+          this.prepend(heading);
+        }
+
+        if (this.#priceEl.parentNode !== this) {
+          if (heading) heading.after(this.#priceEl);
+          else this.prepend(this.#priceEl);
+        }
+
+        if (this.#statusEl.parentNode !== this) {
+          const action = this.querySelector(':scope > a');
+          if (action) action.before(this.#statusEl);
+          else this.append(this.#statusEl);
+        }
+      }
+
+      /** Update only the nodes whose content depends on attributes. */
+      #render() {
+        const name = this.name;
+        const heading = this.#heading();
+        if (heading && name && heading.textContent !== name) {
+          heading.textContent = name;
+        }
+
+        const rawPrice = this.getAttribute('price');
+        const hasPrice =
+          rawPrice !== null && rawPrice.trim() !== '' && Number.isFinite(Number(rawPrice));
+        this.#priceEl.hidden = !hasPrice;
+        if (hasPrice) {
+          const text = CoffeeCard.#priceFormat.format(this.price);
+          if (this.#priceEl.textContent !== text) this.#priceEl.textContent = text;
+        }
+
+        // Shown as text (not just color/strike-through) so it's announced too.
+        this.#statusEl.hidden = !this.soldOut;
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
+
