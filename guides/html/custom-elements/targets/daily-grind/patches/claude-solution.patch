+  <script>
+    class CupCounter extends HTMLElement {
+      static observedAttributes = ['label', 'count', 'disabled'];
+      #internals;
+      #ready = false;
+      #valueEl;
+      #labelEl;
+      #dec;
+      #inc;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+      }
+
+      get label() { return this.getAttribute('label') ?? ''; }
+      set label(v) { v ? this.setAttribute('label', v) : this.removeAttribute('label'); }
+
+      get count() { return Number(this.getAttribute('count')) || 0; }
+      set count(v) { this.setAttribute('count', String(v)); }
+
+      get disabled() { return this.hasAttribute('disabled'); }
+      set disabled(on) { this.toggleAttribute('disabled', !!on); }
+
+      connectedCallback() {
+        if (!this.#ready) {
+          this.#labelEl = document.createElement('span');
+          this.#labelEl.className = 'label';
+          this.#dec = document.createElement('button');
+          this.#dec.type = 'button';
+          this.#dec.textContent = '\u2212';
+          this.#dec.setAttribute('aria-label', 'Decrease');
+          this.#valueEl = document.createElement('span');
+          this.#valueEl.className = 'value';
+          this.#valueEl.setAttribute('aria-live', 'polite');
+          this.#inc = document.createElement('button');
+          this.#inc.type = 'button';
+          this.#inc.textContent = '+';
+          this.#inc.setAttribute('aria-label', 'Increase');
+          this.#dec.addEventListener('click', () => { this.count = Math.max(0, this.count - 1); });
+          this.#inc.addEventListener('click', () => { this.count = Math.min(10, this.count + 1); });
+          this.replaceChildren(this.#labelEl, this.#dec, this.#valueEl, this.#inc);
+          this.#ready = true;
+        }
+        this.render();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) this.render();
+      }
+
+      render() {
+        if (!this.#ready) return;
+        this.#labelEl.textContent = this.label;
+        this.#valueEl.textContent = String(this.count);
+        this.#dec.disabled = this.disabled || this.count <= 0;
+        this.#inc.disabled = this.disabled || this.count >= 10;
+        if (this.count >= 10) this.#internals.states.add('maxed');
+        else this.#internals.states.delete('maxed');
+      }
+    }
+    customElements.define('cup-counter', CupCounter);
+  </script>
 </body>
 
