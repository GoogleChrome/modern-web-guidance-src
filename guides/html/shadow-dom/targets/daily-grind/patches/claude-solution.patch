+  <script>
+    const cardTemplate = document.createElement('template');
+    cardTemplate.innerHTML = `
+      <article class="card">
+        <slot name="badge"></slot>
+        <slot name="title"></slot>
+        <slot></slot>
+        <slot name="action"></slot>
+      </article>
+    `;
+
+    const cardSheet = new CSSStyleSheet();
+    cardSheet.replaceSync(`
+      :host {
+        display: block;
+      }
+
+      .card {
+        position: relative;
+        height: 100%;
+        background: white;
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        line-height: 1.6;
+      }
+
+      ::slotted([slot="title"]) {
+        margin: 0 0 10px;
+        color: var(--primary, #4e342e);
+      }
+
+      ::slotted([slot="badge"]) {
+        position: absolute;
+        top: 10px;
+        right: 10px;
+        background: var(--accent, #ffab40);
+        color: var(--text, #3e2723);
+        font-size: 0.75rem;
+        font-weight: bold;
+        padding: 2px 8px;
+        border-radius: 999px;
+      }
+
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--primary, #4e342e);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      ::slotted([slot="action"]:hover) {
+        background: #3e2723;
+      }
+    `);
+
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [cardSheet];
+        this.shadowRoot.append(cardTemplate.content.cloneNode(true));
+        this.shadowRoot.querySelector('slot[name="badge"]')
+          .addEventListener('slotchange', (e) => {
+            this.toggleAttribute('has-badge', e.target.assignedElements().length > 0);
+          });
+      }
+    }
+    customElements.define('drink-card', DrinkCard);
+  </script>
