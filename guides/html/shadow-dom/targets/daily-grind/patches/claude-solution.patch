+  <script>
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <div class="card">
+        <slot name="header"></slot>
+        <div class="body"><slot></slot></div>
+        <slot name="footer"></slot>
+      </div>
+    `;
+
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      :host { display: block; }
+      .card {
+        background: white;
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        height: 100%;
+      }
+      ::slotted([slot="header"]) {
+        margin-bottom: 10px;
+        color: var(--primary, #4e342e);
+      }
+    `);
+
+    class CoffeeCard extends HTMLElement {
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        this.shadowRoot.append(template.content.cloneNode(true));
+        for (const slot of this.shadowRoot.querySelectorAll('slot[name]')) {
+          slot.addEventListener('slotchange', (e) => {
+            this.toggleAttribute('has-' + e.target.name, e.target.assignedElements().length > 0);
+          });
+        }
+      }
+    }
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
