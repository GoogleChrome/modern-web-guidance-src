+  <script type="module">
+    const template = document.getElementById('drink-card-template') || document.createElement('template');
+    if (!template.innerHTML.trim()) {
+      template.innerHTML = `
+        <article class="card">
+          <slot name="title"></slot>
+          <slot name="description"></slot>
+          <slot name="action"></slot>
+        </article>
+      `;
+    }
+
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      :host {
+        display: block;
+      }
+
+      .card {
+        background: white;
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+      }
+
+      ::slotted([slot="title"]) {
+        margin: 0 0 10px;
+        color: var(--primary);
+      }
+
+      ::slotted([slot="description"]) {
+        margin: 0;
+      }
+
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--primary);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      ::slotted([slot="action"]:hover) {
+        background: #3e2723;
+      }
+    `);
+
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        this.shadowRoot.append(template.content.cloneNode(true));
+
+        this.shadowRoot.querySelectorAll('slot').forEach((slot) => {
+          slot.addEventListener('slotchange', (e) => {
+            const nodes = e.target.assignedElements();
+            if (slot.name) {
+              this.toggleAttribute(`has-${slot.name}`, nodes.length > 0);
+            }
+          });
+        });
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
