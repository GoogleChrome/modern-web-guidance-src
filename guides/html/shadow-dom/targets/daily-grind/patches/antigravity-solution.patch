+  <script type="module">
+    const sheet = new CSSStyleSheet();
+    sheet.replaceSync(`
+      :host {
+        display: block;
+      }
+
+      *, *::before, *::after {
+        box-sizing: border-box;
+        margin: 0;
+        padding: 0;
+      }
+
+      .card {
+        position: relative;
+        background: white;
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+      }
+
+      :host([has-badge]) .card {
+        border-top: 3px solid var(--accent, #ffab40);
+      }
+
+      ::slotted([slot="badge"]) {
+        display: inline-block;
+        background: var(--accent, #ffab40);
+        color: var(--text, #3e2723);
+        font-size: 0.75rem;
+        font-weight: bold;
+        text-transform: uppercase;
+        padding: 2px 8px;
+        border-radius: 999px;
+        margin-bottom: 8px;
+      }
+
+      ::slotted([slot="header"]),
+      ::slotted([slot="title"]) {
+        margin-bottom: 10px;
+        color: var(--primary, #4e342e);
+      }
+
+      ::slotted([slot="footer"]),
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--primary, #4e342e);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      ::slotted([slot="footer"]:hover),
+      ::slotted([slot="action"]:hover) {
+        background: #3e2723;
+      }
+    `);
+
+    const template = document.createElement('template');
+    template.innerHTML = `
+      <article class="card">
+        <slot name="badge"></slot>
+        <slot name="header"></slot>
+        <slot name="title"></slot>
+        <div class="body"><slot></slot></div>
+        <slot name="footer"></slot>
+        <slot name="action"></slot>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.shadowRoot.adoptedStyleSheets = [sheet];
+        this.shadowRoot.append(template.content.cloneNode(true));
+
+        const badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+        badgeSlot.addEventListener('slotchange', (e) => {
+          const nodes = e.target.assignedElements();
+          this.toggleAttribute('has-badge', nodes.length > 0);
+        });
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
+
 </body>
 
