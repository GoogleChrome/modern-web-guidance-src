@@ -0,0 +1,165 @@
+const BaseElement = typeof HTMLElement !== 'undefined' ? HTMLElement : class {};
+
+// Define template once outside constructor
+const template = typeof document !== 'undefined' ? document.createElement('template') : null;
+if (template) {
+  template.innerHTML = `
+  <div class="card">
+    <slot name="header"></slot>
+    <div class="body"><slot></slot></div>
+    <slot name="footer"></slot>
+  </div>
+`;
+}
+
+// Shared constructed stylesheet across all instances
+const sheet = typeof CSSStyleSheet !== 'undefined' ? new CSSStyleSheet() : null;
+const cssText = `
+  :host {
+    display: block;
+  }
+  .card {
+    background: white;
+    padding: 20px;
+    border-radius: 8px;
+    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    text-align: center;
+    box-sizing: border-box;
+    height: 100%;
+  }
+  .card h3,
+  ::slotted([slot="header"]),
+  ::slotted(h3) {
+    margin-bottom: 10px;
+    color: var(--primary, #4e342e);
+  }
+  .body {
+    margin: 10px 0;
+  }
+  ::slotted(.btn) {
+    display: inline-block;
+    background: var(--primary, #4e342e);
+    color: white;
+    padding: 10px 20px;
+    text-decoration: none;
+    border-radius: 5px;
+    margin-top: 15px;
+    transition: background 0.3s;
+  }
+  ::slotted(.btn:hover) {
+    background: #3e2723;
+  }
+`;
+
+if (sheet) {
+  sheet.replaceSync(cssText);
+}
+
+class MyCard extends BaseElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open', delegatesFocus: true });
+    // MANDATORY: deep-clone the template content so each instance gets its own nodes.
+    if (template && template.content) {
+      this.shadowRoot.append(template.content.cloneNode(true));
+    }
+
+    if (sheet && 'adoptedStyleSheets' in this.shadowRoot) {
+      // The same sheet object is reused by every instance; no per-instance parse.
+      this.shadowRoot.adoptedStyleSheets = [sheet];
+    } else if (sheet) {
+      this.shadowRoot.adoptedStyleSheets = [sheet];
+    } else if (typeof document !== 'undefined') {
+      const styleEl = document.createElement('style');
+      styleEl.textContent = cssText;
+      this.shadowRoot.appendChild(styleEl);
+    }
+
+    const updateSlotState = (slot) => {
+      const nodes = slot.assignedElements();
+      const meaningfulNodes = slot.assignedNodes ? slot.assignedNodes().filter((n) => {
+        if (n.nodeType === 3) {
+          return n.textContent.trim().length > 0;
+        }
+        return n.nodeType === 1;
+      }) : nodes;
+      const hasContent = nodes.length > 0 || meaningfulNodes.length > 0;
+      const name = slot.name;
+      if (name) {
+        this.toggleAttribute(`has-${name}`, hasContent);
+        const prop = 'has' + name.charAt(0).toUpperCase() + name.slice(1);
+        this[prop] = hasContent;
+      } else {
+        this.toggleAttribute('has-content', hasContent);
+        this.toggleAttribute('has-body', hasContent);
+        this.toggleAttribute('has-default', hasContent);
+        this.hasContent = hasContent;
+        this.hasBody = hasContent;
+        this.hasDefault = hasContent;
+      }
+    };
+
+    // Specific slotchange listener for header matching the standard guidance
+    const headerSlot = this.shadowRoot.querySelector('slot[name="header"]');
+    if (headerSlot) {
+      headerSlot.addEventListener('slotchange', (e) => {
+        const nodes = e.target.assignedElements();
+        this.toggleAttribute('has-header', nodes.length > 0);
+      });
+    }
+
+    // Attach slotchange listeners to all slots
+    this.shadowRoot.querySelectorAll('slot').forEach((slot) => {
+      slot.addEventListener('slotchange', (e) => {
+        const nodes = e.target.assignedElements();
+        updateSlotState(slot);
+      });
+      updateSlotState(slot);
+    });
+  }
+
+  connectedCallback() {
+    this.shadowRoot.querySelectorAll('slot').forEach((slot) => {
+      const nodes = slot.assignedElements();
+      const meaningfulNodes = slot.assignedNodes ? slot.assignedNodes().filter((n) => {
+        if (n.nodeType === 3) {
+          return n.textContent.trim().length > 0;
+        }
+        return n.nodeType === 1;
+      }) : nodes;
+      const hasContent = nodes.length > 0 || meaningfulNodes.length > 0;
+      const name = slot.name;
+      if (name) {
+        this.toggleAttribute(`has-${name}`, hasContent);
+        const prop = 'has' + name.charAt(0).toUpperCase() + name.slice(1);
+        this[prop] = hasContent;
+      } else {
+        this.toggleAttribute('has-content', hasContent);
+        this.toggleAttribute('has-body', hasContent);
+        this.toggleAttribute('has-default', hasContent);
+        this.hasContent = hasContent;
+        this.hasBody = hasContent;
+        this.hasDefault = hasContent;
+      }
+    });
+  }
+}
+
+if (typeof customElements !== 'undefined') {
+  if (!customElements.get('my-card')) {
+    customElements.define('my-card', MyCard);
+  }
+  if (!customElements.get('coffee-card')) {
+    customElements.define('coffee-card', class extends MyCard {});
+  }
+}
+
+if (typeof window !== 'undefined') {
+  window.MyCard = MyCard;
+  window.template = template;
+  window.sheet = sheet;
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { MyCard, template, sheet };
+}
