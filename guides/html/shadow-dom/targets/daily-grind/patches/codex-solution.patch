+// Parse once; every card receives an independent copy of the shadow tree.
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      min-width: 0;
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      font-size: 16px;
+      line-height: 1.6;
+      color: #3e2723;
+    }
+
+    *, ::slotted(*) {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    article {
+      height: 100%;
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    h3 {
+      font-size: 1.17em;
+      margin-bottom: 10px;
+      color: #4e342e;
+    }
+
+    ::slotted([slot="title"]), ::slotted([slot="description"]) {
+      font: inherit;
+      color: inherit;
+    }
+
+    .badge {
+      display: inline-block;
+      margin-bottom: 10px;
+      padding: 2px 8px;
+      border-radius: 4px;
+      background: #ffab40;
+      font-size: 0.75em;
+      font-weight: bold;
+    }
+
+    .badge[hidden] { display: none; }
+
+    ::slotted([slot="badge"]) {
+      font: inherit;
+      color: inherit;
+    }
+
+    ::slotted(a[slot="action"]) {
+      display: inline-block;
+      background: #4e342e;
+      color: white;
+      font: inherit;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    ::slotted(a[slot="action"]:hover) { background: #3e2723; }
+    ::slotted(a[slot="action"]:focus-visible) {
+      outline: 3px solid #ffab40;
+      outline-offset: 3px;
+    }
+  </style>
+  <article>
+    <div class="badge" hidden><slot name="badge"></slot></div>
+    <h3><slot name="title"></slot></h3>
+    <p><slot name="description"></slot></p>
+    <slot name="action"></slot>
+  </article>
+`;
+
+class SeasonalCard extends HTMLElement {
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    root.append(template.content.cloneNode(true));
+
+    const badgeSlot = root.querySelector('slot[name="badge"]');
+    const badge = root.querySelector('.badge');
+    // slotchange covers initial assignment and later additions/removals,
+    // including children parsed after the custom element is connected.
+    if (badgeSlot instanceof HTMLSlotElement && badge instanceof HTMLElement) {
+      badgeSlot.addEventListener('slotchange', () => {
+        badge.hidden = badgeSlot.assignedElements().length === 0;
+      });
+    }
+  }
+}
+
+customElements.define('seasonal-card', SeasonalCard);
