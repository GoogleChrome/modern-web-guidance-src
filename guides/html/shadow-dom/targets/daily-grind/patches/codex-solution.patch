diff --git a/seasonal-card.js b/seasonal-card.js
new file mode 100644
index 0000000..023b903
--- /dev/null
+++ b/seasonal-card.js
@@ -0,0 +1,20 @@
+// @ts-check
+
+const template = document.getElementById('seasonal-card-template');
+
+if (!(template instanceof HTMLTemplateElement)) {
+  throw new Error('The seasonal-card template is missing.');
+}
+
+// Capture the parsed blueprint once; every instance receives independent nodes.
+const blueprint = template.content;
+
+class SeasonalCard extends HTMLElement {
+  constructor() {
+    super();
+    const shadow = this.attachShadow({ mode: 'open', delegatesFocus: true });
+    shadow.append(blueprint.cloneNode(true));
+  }
+}
+
+customElements.define('seasonal-card', SeasonalCard);
