@@ -0,0 +1,115 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host {
+      display: block;
+      margin-top: 12px;
+    }
+    button {
+      font: inherit;
+      color: var(--primary, #4e342e);
+      background: transparent;
+      border: 1px solid currentColor;
+      border-radius: 5px;
+      padding: 8px 14px;
+      cursor: pointer;
+      transition: background 0.2s, color 0.2s;
+    }
+    button[aria-pressed="true"] {
+      background: var(--secondary, #d7ccc8);
+    }
+    button:hover {
+      background: var(--secondary, #d7ccc8);
+    }
+    button:focus-visible {
+      outline: 3px solid var(--primary, #4e342e);
+      outline-offset: 3px;
+    }
+    .sr-only {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+  </style>
+  <button type="button" aria-pressed="false" aria-describedby="favorite-desc" part="button">Save favorite</button>
+  <span id="favorite-desc" class="sr-only">Toggle favorite status for this coffee</span>
+`;
+/** A latched favorite state; user changes emit a bubbling, composed change event. */
+export class CoffeeFavorite extends HTMLElement {
+    static observedAttributes = ['favorite', 'product-name'];
+    #button;
+    constructor() {
+        super();
+        const root = this.shadowRoot ?? this.attachShadow({ mode: 'open' });
+        if (!root.hasChildNodes()) {
+            root.append(template.content.cloneNode(true));
+        }
+        const button = root.querySelector('button');
+        if (!button) {
+            throw new Error('Expected button element in template');
+        }
+        this.#button = button;
+    }
+    get favorite() {
+        return this.hasAttribute('favorite');
+    }
+    set favorite(value) {
+        this.toggleAttribute('favorite', Boolean(value));
+    }
+    get productName() {
+        return this.getAttribute('product-name') ?? '';
+    }
+    set productName(value) {
+        if (value) {
+            this.setAttribute('product-name', value);
+        }
+        else {
+            this.removeAttribute('product-name');
+        }
+    }
+    connectedCallback() {
+        // Preserve state assigned by a consumer before the custom element upgraded.
+        if (Object.prototype.hasOwnProperty.call(this, 'favorite')) {
+            const value = this.favorite;
+            Reflect.deleteProperty(this, 'favorite');
+            this.favorite = value;
+        }
+        if (Object.prototype.hasOwnProperty.call(this, 'productName')) {
+            const value = this.productName;
+            Reflect.deleteProperty(this, 'productName');
+            this.productName = value;
+        }
+        this.#render();
+        this.#button.addEventListener('click', this.#toggle);
+    }
+    disconnectedCallback() {
+        this.#button.removeEventListener('click', this.#toggle);
+    }
+    attributeChangedCallback() {
+        this.#render();
+    }
+    #toggle = () => {
+        this.favorite = !this.favorite;
+        this.dispatchEvent(new CustomEvent('change', {
+            bubbles: true,
+            composed: true,
+            detail: { favorite: this.favorite },
+        }));
+    };
+    #render() {
+        const name = this.getAttribute('product-name')?.trim() || 'this coffee';
+        const isFav = this.favorite;
+        this.#button.setAttribute('aria-pressed', String(isFav));
+        this.#button.setAttribute('aria-label', `Favorite ${name}`);
+        this.#button.textContent = isFav ? 'Saved favorite' : 'Save favorite';
+    }
+}
+if (typeof customElements !== 'undefined' && !customElements.get('coffee-favorite')) {
+    customElements.define('coffee-favorite', CoffeeFavorite);
+}
