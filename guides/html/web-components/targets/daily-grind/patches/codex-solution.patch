diff --git a/src/coffee-favorite.ts b/src/coffee-favorite.ts
new file mode 100644
index 0000000..cb837ca
--- /dev/null
+++ b/src/coffee-favorite.ts
@@ -0,0 +1,86 @@
+const template = document.createElement('template');
+template.innerHTML = `
+  <style>
+    :host { display: block; margin-top: 12px; }
+    button {
+      font: inherit;
+      color: var(--primary, #4e342e);
+      background: transparent;
+      border: 1px solid currentColor;
+      border-radius: 5px;
+      padding: 8px 14px;
+      cursor: pointer;
+    }
+    button[aria-pressed="true"] { background: var(--secondary, #d7ccc8); }
+    button:hover { background: var(--secondary, #d7ccc8); }
+    button:focus-visible { outline: 3px solid var(--primary, #4e342e); outline-offset: 3px; }
+  </style>
+  <button type="button" aria-pressed="false" part="button">Save favorite</button>
+`;
+
+/** A latched favorite state; user changes emit a bubbling, composed change event. */
+export class CoffeeFavorite extends HTMLElement {
+  static observedAttributes = ['favorite', 'product-name'];
+
+  readonly #button: HTMLButtonElement;
+
+  constructor() {
+    super();
+    const root = this.attachShadow({ mode: 'open' });
+    root.append(template.content.cloneNode(true));
+    this.#button = root.querySelector('button')!;
+  }
+
+  get favorite(): boolean {
+    return this.hasAttribute('favorite');
+  }
+
+  set favorite(value: boolean) {
+    this.toggleAttribute('favorite', Boolean(value));
+  }
+
+  connectedCallback(): void {
+    // Preserve state assigned by a consumer before the custom element upgraded.
+    if (Object.prototype.hasOwnProperty.call(this, 'favorite')) {
+      const value = this.favorite;
+      Reflect.deleteProperty(this, 'favorite');
+      this.favorite = value;
+    }
+    this.#render();
+    this.#button.addEventListener('click', this.#toggle);
+  }
+
+  disconnectedCallback(): void {
+    this.#button.removeEventListener('click', this.#toggle);
+  }
+
+  attributeChangedCallback(): void {
+    this.#render();
+  }
+
+  #toggle = (): void => {
+    this.favorite = !this.favorite;
+    this.dispatchEvent(new CustomEvent<{ favorite: boolean }>('change', {
+      bubbles: true,
+      composed: true,
+      detail: { favorite: this.favorite },
+    }));
+  };
+
+  #render(): void {
+    const name = this.getAttribute('product-name')?.trim() || 'this coffee';
+    this.#button.setAttribute('aria-pressed', String(this.favorite));
+    this.#button.setAttribute('aria-label', `Favorite ${name}`);
+    this.#button.textContent = this.favorite ? 'Saved favorite' : 'Save favorite';
+  }
+}
+
+if (!customElements.get('coffee-favorite')) {
+  customElements.define('coffee-favorite', CoffeeFavorite);
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'coffee-favorite': CoffeeFavorite;
+  }
+}
