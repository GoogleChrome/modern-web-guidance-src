+
+interface Props {
+  label: string;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+export default function Modal({ label, onClose, children }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    const dialog = ref.current!;
+    const opener = document.activeElement;
+    dialog.showModal();
+    return () => {
+      dialog.close();
+      if (opener instanceof HTMLElement && opener.isConnected) opener.focus();
+    };
+  }, []);
+
+  return (
+    <dialog ref={ref} closedby="any" aria-label={label} onClose={onClose}
+      className="overlay-dialog bg-white shadow-xl w-full max-w-2xl"
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) ref.current?.close();
+      }}>
+      <form method="dialog" className="flex justify-end p-2">
+        <button type="submit" aria-label={`Close ${label}`} className="p-1 text-gray-600">✕</button>
+      </form>
+      {children}
+    </dialog>
+  );
+}
