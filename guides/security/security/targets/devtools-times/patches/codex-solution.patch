 import { defineMiddleware } from 'astro:middleware';
 
+const REPORTING_ENDPOINT =
+  'default="https://astro-news-pytrpecapa-uc.a.run.app/devtools-times/security-reports"';
+const STATE_CHANGING_METHODS = new Set(['POST', 'PUT', 'PATCH', 'DELETE']);
+
+const getCsp = (nonce: string) =>
+  [
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'self'",
+    "require-trusted-types-for 'script'",
+    'trusted-types default',
+    'report-to default',
+  ].join('; ');
+
+const isApiRequest = (pathname: string) =>
+  pathname.startsWith(`${import.meta.env.BASE_URL}api/`) || pathname.startsWith('/api/');
+
+const isDocumentResponse = (response: Response) => {
+  const contentType = response.headers.get('Content-Type') ?? '';
+  return contentType.includes('text/html');
+};
+
+const addNonceToScripts = (html: string, nonce: string) =>
+  html.replace(/<script\b(?![^>]*\bnonce=)/gi, `<script nonce="${nonce}"`);
+
+const createNonce = () => {
+  const bytes = new Uint8Array(16);
+  crypto.getRandomValues(bytes);
+  return btoa(String.fromCharCode(...bytes));
+};
+
+const appendVary = (headers: Headers, value: string) => {
+  const existing = headers.get('Vary');
+  if (!existing) {
+    headers.set('Vary', value);
+    return;
+  }
+
+  const values = new Set(
+    existing
+      .split(',')
+      .map((item) => item.trim())
+      .filter(Boolean),
+  );
+
+  value.split(',').forEach((item) => {
+    const trimmed = item.trim();
+    if (trimmed) values.add(trimmed);
+  });
+
+  headers.set('Vary', Array.from(values).join(', '));
+};
+
+const shouldBlockByFetchMetadata = (request: Request) => {
+  if (!STATE_CHANGING_METHODS.has(request.method.toUpperCase())) {
+    return false;
+  }
+
+  const site = request.headers.get('Sec-Fetch-Site');
+  const mode = request.headers.get('Sec-Fetch-Mode');
+  const dest = request.headers.get('Sec-Fetch-Dest');
+
+  if (!site || site === 'same-origin' || site === 'same-site' || site === 'none') {
+    return false;
+  }
+
+  return site === 'cross-site';
+};
+
+const applySecurityHeaders = (response: Response, pathname: string, nonce?: string) => {
+  response.headers.set('Strict-Transport-Security', 'max-age=31536000; includeSubDomains');
+  response.headers.set('X-Content-Type-Options', 'nosniff');
+  response.headers.set('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  response.headers.set('Permissions-Policy', 'camera=(), geolocation=(), microphone=()');
+  response.headers.set('X-Frame-Options', 'SAMEORIGIN');
+  response.headers.set('Reporting-Endpoints', REPORTING_ENDPOINT);
+  appendVary(response.headers, 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+
+  if (isApiRequest(pathname)) {
+    response.headers.set('Cross-Origin-Resource-Policy', 'same-origin');
+  }
+
+  if (nonce && isDocumentResponse(response)) {
+    response.headers.set('Content-Security-Policy', getCsp(nonce));
+    response.headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
+  }
+};
+
+const prepareResponse = async (response: Response, pathname: string, nonce?: string) => {
+  let securedResponse = response;
+
+  if (nonce && isDocumentResponse(response)) {
+    securedResponse = new Response(addNonceToScripts(await response.text(), nonce), {
+      status: response.status,
+      statusText: response.statusText,
+      headers: response.headers,
+    });
+    securedResponse.headers.delete('Content-Length');
+  }
+
+  applySecurityHeaders(securedResponse, pathname, nonce);
+  return securedResponse;
+};
+
 export const onRequest = defineMiddleware(async (context, next) => {
+  if (shouldBlockByFetchMetadata(context.request)) {
+    const response = new Response(null, { status: 403 });
+    return prepareResponse(response, context.url.pathname);
+  }
+
+  context.locals.cspNonce = createNonce();
