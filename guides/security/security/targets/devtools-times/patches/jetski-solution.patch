--- a/src/middleware.ts
+++ b/src/middleware.ts
@@ -1,13 +1,185 @@
-
 import { defineMiddleware } from 'astro:middleware';
+import crypto from 'node:crypto';
+
+const TRUSTED_ORIGINS = new Set([
+  'https://chrome.dev',
+  'https://astro-news-1026410574114.us-central1.run.app',
+  'https://astro-news-pytrpecapa-uc.a.run.app',
+]);
+
+function updateVaryHeader(headers: Headers, toAdd: string[]) {
+  const existing = headers.get('Vary');
+  const parts = existing ? existing.split(',').map((s) => s.trim()) : [];
+  for (const item of toAdd) {
+    if (!parts.some((p) => p.toLowerCase() === item.toLowerCase())) {
+      parts.push(item);
+    }
+  }
+  const formatted = parts.map((v) => {
+    const lower = v.toLowerCase();
+    if (lower === 'sec-fetch-dest') return 'Sec-Fetch-Dest';
+    if (lower === 'sec-fetch-mode') return 'Sec-Fetch-Mode';
+    if (lower === 'sec-fetch-site') return 'Sec-Fetch-Site';
+    if (lower === 'origin') return 'Origin';
+    return v;
+  });
+  headers.set('Vary', formatted.join(', '));
+}
 
 export const onRequest = defineMiddleware(async (context, next) => {
+  const { request, url } = context;
+  const method = request.method;
+  const isApi = url.pathname.includes('/api/');
+
+  // 1. Fetch Metadata resource isolation protection (Expectation 14)
+  const secFetchSite = request.headers.get('sec-fetch-site');
+  const secFetchMode = request.headers.get('sec-fetch-mode');
+  const secFetchDest = request.headers.get('sec-fetch-dest');
+
+  const origin = request.headers.get('origin');
+  const isTrustedOrigin =
+    origin !== null &&
+    (TRUSTED_ORIGINS.has(origin) || origin === url.origin);
+
+  if (secFetchSite) {
+    const isStateChanging = !['GET', 'HEAD', 'OPTIONS'].includes(method);
+    const isAllowedSite = ['same-origin', 'same-site', 'none'].includes(secFetchSite);
+    const isAllowedNavigation =
+      secFetchSite === 'cross-site' &&
+      secFetchMode === 'navigate' &&
+      (method === 'GET' || method === 'HEAD') &&
+      !['object', 'embed'].includes(secFetchDest || '');
+    const isAuthorizedCors = isTrustedOrigin;
+    const isAllowedPublicResource =
+      !isStateChanging &&
+      !isApi &&
+      ['image', 'style', 'font', 'script'].includes(secFetchDest || '');
+
+    if (!isAllowedSite && !isAllowedNavigation && !isAuthorizedCors && !isAllowedPublicResource) {
+      return new Response('Forbidden', {
+        status: 403,
+        statusText: 'Forbidden',
+        headers: {
+          'Content-Type': 'text/plain; charset=utf-8',
+          'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+          'X-Content-Type-Options': 'nosniff',
+          'Strict-Transport-Security': 'max-age=31536000; includeSubDomains',
+        },
+      });
+    }
+  }
+
+  // 2. CORS Handling & Origin Validation (Expectation 19)
+  if (method === 'OPTIONS' && origin) {
+    const preflightHeaders = new Headers();
+    if (isTrustedOrigin) {
+      preflightHeaders.set('Access-Control-Allow-Origin', origin);
+      preflightHeaders.set('Access-Control-Allow-Credentials', 'true');
+      preflightHeaders.set(
+        'Access-Control-Allow-Methods',
+        'GET, POST, PUT, DELETE, PATCH, OPTIONS'
+      );
+      preflightHeaders.set(
+        'Access-Control-Allow-Headers',
+        request.headers.get('access-control-request-headers') ||
+          'Content-Type, Authorization, X-Requested-With'
+      );
+      preflightHeaders.set('Access-Control-Max-Age', '86400');
+    }
+    preflightHeaders.set(
+      'Vary',
+      'Origin, Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site'
+    );
+    preflightHeaders.set('X-Content-Type-Options', 'nosniff');
+    preflightHeaders.set(
+      'Strict-Transport-Security',
+      'max-age=31536000; includeSubDomains'
+    );
+    return new Response(null, {
+      status: 204,
+      headers: preflightHeaders,
+    });
+  }
+
+  // 3. Session initialization (Expectation 3)
   if (context.session) {
-    // Initialize the reading list if it doesn't exist
     const readingList = await context.session.get('readingList');
     if (readingList === undefined) {
       await context.session.set('readingList', []);
     }
   }
-  return next();
+
+  // 4. Process the request
+  const response = await next();
+  const headers = response.headers;
+
+  // Companion security headers for all responses
+  headers.set('Strict-Transport-Security', 'max-age=31536000; includeSubDomains');
+  headers.set('X-Content-Type-Options', 'nosniff');
+  headers.set('X-Frame-Options', 'SAMEORIGIN');
+  headers.set(
+    'Permissions-Policy',
+    'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()'
+  );
+  headers.set(
+    'Reporting-Endpoints',
+    'default="https://reports.example/default", main-endpoint="https://reports.example/main"'
+  );
+
+  // Fetch Metadata Vary header on all responses (Expectation 14)
+  const varyItems = ['Sec-Fetch-Dest', 'Sec-Fetch-Mode', 'Sec-Fetch-Site'];
+  if (origin) {
+    varyItems.unshift('Origin');
+  }
+  updateVaryHeader(headers, varyItems);
+
+  // CORS headers on actual responses if origin is trusted (Expectation 19)
+  if (origin && isTrustedOrigin) {
+    headers.set('Access-Control-Allow-Origin', origin);
+    headers.set('Access-Control-Allow-Credentials', 'true');
+  }
+
+  // Check response content type
+  const contentType = headers.get('content-type') || '';
+  const isHtml = contentType.includes('text/html');
+
+  // Cross-Origin-Resource-Policy for internal API and document responses (Expectation 13)
+  if (isApi || isHtml) {
+    headers.set('Cross-Origin-Resource-Policy', 'same-origin');
+  }
+
+  // Document response specific headers (Expectations 5, 8, 9, 10, 11, 12, 16)
+  if (isHtml) {
+    headers.set('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+    headers.set('Referrer-Policy', 'strict-origin-when-cross-origin');
+
+    // CSP with nonce, strict-dynamic, report-sample, object-src 'none', base-uri 'none', frame-ancestors 'self', report-to, require-trusted-types-for 'script'
+    const nonce = crypto.randomBytes(16).toString('base64');
+    const cspDirectives = [
+      `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+      `object-src 'none'`,
+      `base-uri 'none'`,
+      `frame-ancestors 'self'`,
+      `report-to main-endpoint`,
+      `require-trusted-types-for 'script'`,
+    ];
+    headers.set('Content-Security-Policy', cspDirectives.join('; '));
+
+    // Inject nonce into all <script> tags
+    const html = await response.text();
+    const modifiedHtml = html.replace(/<script\b([^>]*)>/gi, (match, attrs) => {
+      if (/\bnonce=/i.test(attrs)) {
+        return match;
+      }
+      return `<script nonce="${nonce}"${attrs}>`;
+    });
+
+    return new Response(modifiedHtml, {
+      status: response.status,
+      statusText: response.statusText,
+      headers,
+    });
+  }
+
+  return response;
 });
