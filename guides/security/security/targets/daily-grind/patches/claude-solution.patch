+// Minimal Node server for The Daily Grind.
+// Serves the static homepage with hardened security headers and handles /logout.
+
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { randomBytes } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+
+const ROOT = dirname(fileURLToPath(import.meta.url));
+const PORT = Number.parseInt(process.env.PORT ?? '', 10) || 11222;
+
+const SESSION_COOKIE = '__Host-session';
+const REPORT_PATH = '/reports';
+const MAX_REPORT_BYTES = 64 * 1024;
+
+// Only explicitly listed files are served; nothing else in the project directory is exposed.
+const PAGES = new Map([
+  ['/', 'index.html'],
+  ['/index.html', 'index.html'],
+]);
+
+/** @param {import('node:http').ServerResponse} res */
+function setSecurityHeaders(res) {
+  // Fresh cryptographic nonce per response. The page currently has no scripts, so no
+  // script can execute unless it is later added with this nonce via a server template.
+  const nonce = randomBytes(16).toString('base64');
+
+  const csp = [
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "form-action 'self'",
+    "require-trusted-types-for 'script'",
+    'report-to main-endpoint',
+  ].join('; ');
+
+  res.setHeader('Reporting-Endpoints', `main-endpoint="${REPORT_PATH}", default="${REPORT_PATH}"`);
+  res.setHeader('Content-Security-Policy', csp);
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+  res.setHeader('Strict-Transport-Security', 'max-age=31536000; includeSubDomains; preload');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader(
+    'Permissions-Policy',
+    'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()',
+  );
+  res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+}
+
+/**
+ * Fetch Metadata resource isolation policy.
+ * @param {import('node:http').IncomingMessage} req
+ * @param {string} pathname
+ */
+function isAllowedByFetchMetadata(req, pathname) {
+  const site = req.headers['sec-fetch-site'];
+  const mode = req.headers['sec-fetch-mode'];
+  const dest = req.headers['sec-fetch-dest'];
+
+  if (!site) return true; // Legacy browsers that don't send Fetch Metadata.
+  if (site === 'same-origin' || site === 'same-site' || site === 'none') return true;
+
+  // Never let another site sign the visitor out (logout CSRF).
+  if (pathname === '/logout') return false;
+
+  // Allow top-level cross-site link navigations to pages.
+  return (
+    site === 'cross-site' &&
+    mode === 'navigate' &&
+    (req.method === 'GET' || req.method === 'HEAD') &&
+    dest !== 'object' &&
+    dest !== 'embed'
+  );
+}
+
+/**
+ * @param {import('node:http').ServerResponse} res
+ * @param {number} status
+ * @param {string} body
+ */
+function sendText(res, status, body) {
+  res.statusCode = status;
+  res.setHeader('Content-Type', 'text/plain; charset=utf-8');
+  res.end(body);
+}
+
+/** Strip query strings / fragments so secrets never end up in logs. */
+function redactUrl(value) {
+  if (typeof value !== 'string' || value === '') return undefined;
+  try {
+    const url = new URL(value);
+    return `${url.origin}${url.pathname}`;
+  } catch {
+    return value.split(/[?#]/)[0].slice(0, 200);
+  }
+}
+
+/**
+ * Accept violation reports, logging only non-sensitive fields.
+ * @param {import('node:http').IncomingMessage} req
+ * @param {import('node:http').ServerResponse} res
+ */
+function handleReport(req, res) {
+  let size = 0;
+  /** @type {Buffer[]} */
+  const chunks = [];
+  let aborted = false;
+
+  req.on('data', (chunk) => {
+    if (aborted) return;
+    size += chunk.length;
+    if (size > MAX_REPORT_BYTES) {
+      aborted = true;
+      sendText(res, 413, 'Payload Too Large');
+      req.destroy();
+      return;
+    }
+    chunks.push(chunk);
+  });
+
+  req.on('end', () => {
+    if (aborted) return;
+    try {
+      const parsed = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+      const reports = Array.isArray(parsed) ? parsed : [parsed];
+      for (const report of reports) {
+        const body = report?.body ?? report?.['csp-report'] ?? {};
+        console.warn('[security-report]', {
+          type: report?.type ?? 'csp-violation',
+          directive: body.effectiveDirective ?? body['effective-directive'],
+          blocked: redactUrl(body.blockedURL ?? body['blocked-uri']),
+          document: redactUrl(body.documentURL ?? body['document-uri'] ?? report?.url),
+          disposition: body.disposition,
+        });
+      }
+    } catch {
+      // Ignore malformed reports.
+    }
+    res.statusCode = 204;
+    res.end();
+  });
+}
+
+const server = createServer(async (req, res) => {
+  let pathname;
+  try {
+    pathname = new URL(req.url ?? '/', 'http://localhost').pathname;
+  } catch {
+    sendText(res, 400, 'Bad Request');
+    return;
+  }
+
+  setSecurityHeaders(res);
+
+  // Reject disallowed cross-site requests before any session handling.
+  if (!isAllowedByFetchMetadata(req, pathname)) {
+    sendText(res, 403, 'Forbidden');
+    return;
+  }
+
+  if (pathname === REPORT_PATH) {
+    if (req.method !== 'POST') {
+      res.setHeader('Allow', 'POST');
+      sendText(res, 405, 'Method Not Allowed');
+      return;
+    }
+    handleReport(req, res);
+    return;
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    res.setHeader('Allow', 'GET, HEAD');
+    sendText(res, 405, 'Method Not Allowed');
+    return;
+  }
+
+  if (pathname === '/logout') {
+    // Sign the visitor out: expire the session cookie and wipe client-side state.
+    res.setHeader(
+      'Set-Cookie',
+      `${SESSION_COOKIE}=; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Path=/; Secure; HttpOnly; SameSite=Lax`,
+    );
+    res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+    res.setHeader('Cache-Control', 'no-store');
+    res.statusCode = 303;
+    res.setHeader('Location', '/');
+    res.end();
+    return;
+  }
+
+  const file = PAGES.get(pathname);
+  if (!file) {
+    sendText(res, 404, 'Not Found');
+    return;
+  }
+
+  try {
+    const html = await readFile(join(ROOT, file));
+    res.statusCode = 200;
+    res.setHeader('Content-Type', 'text/html; charset=utf-8');
+    res.setHeader('Content-Length', html.length);
+    res.end(req.method === 'HEAD' ? undefined : html);
+  } catch {
+    sendText(res, 500, 'Internal Server Error');
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind is running on http://localhost:${PORT}`);
+});
