+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+const crypto = require('crypto');
+
+const PORT = parseInt(process.env.PORT, 10) || 11222;
+const htmlTemplate = fs.readFileSync(path.join(__dirname, 'index.html'), 'utf8');
+
+function generateNonce() {
+  return crypto.randomBytes(16).toString('base64');
+}
+
+function getSecurityHeaders(nonce) {
+  return {
+    'Strict-Transport-Security': 'max-age=31536000; includeSubDomains',
+    'X-Frame-Options': 'SAMEORIGIN',
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy': 'camera=(), geolocation=(), microphone=()',
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    'Reporting-Endpoints': 'main-endpoint="https://reports.dailygrind.example/main"',
+    'Content-Security-Policy': [
+      "script-src 'nonce-" + nonce + "' 'strict-dynamic' 'report-sample'",
+      "object-src 'none'",
+      "base-uri 'none'",
+      "frame-ancestors 'self'",
+      "require-trusted-types-for 'script'",
+      'report-to main-endpoint'
+    ].join('; '),
+    'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site'
+  };
+}
+
+const server = http.createServer(function (req, res) {
+  var fetchSite = req.headers['sec-fetch-site'];
+  var fetchMode = req.headers['sec-fetch-mode'];
+  var fetchDest = req.headers['sec-fetch-dest'];
+
+  if (fetchSite) {
+    if (['same-origin', 'same-site', 'none'].indexOf(fetchSite) === -1) {
+      var isAllowedNav = fetchSite === 'cross-site'
+        && fetchMode === 'navigate'
+        && req.method === 'GET'
+        && ['object', 'embed'].indexOf(fetchDest) === -1;
+
+      if (!isAllowedNav) {
+        res.writeHead(403, {
+          'Content-Type': 'text/plain',
+          'X-Content-Type-Options': 'nosniff',
+          'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site'
+        });
+        res.end('Forbidden');
+        return;
+      }
+    }
+  }
+
+  var nonce = generateNonce();
+  var headers = getSecurityHeaders(nonce);
+  var urlPath = req.url.split('?')[0];
+
+  if (urlPath === '/logout') {
+    res.writeHead(302, Object.assign({}, headers, {
+      'Clear-Site-Data': '"cookies", "storage", "cache"',
+      'Location': '/',
+      'Content-Type': 'text/html; charset=utf-8'
+    }));
+    res.end();
+    return;
+  }
+
+  var html = htmlTemplate.replace(/CSP_NONCE/g, nonce);
+
+  var existingCookies = req.headers.cookie || '';
+  var responseHeaders = Object.assign({}, headers, {
+    'Content-Type': 'text/html; charset=utf-8'
+  });
+
+  if (existingCookies.indexOf('__Host-session') === -1) {
+    responseHeaders['Set-Cookie'] = '__Host-session=' + crypto.randomUUID() + '; Secure; HttpOnly; SameSite=Lax; Path=/';
+  }
+
+  res.writeHead(200, responseHeaders);
+  res.end(html);
+});
+
+server.listen(PORT, function () {
+  console.log('Server running on port ' + PORT);
+});
