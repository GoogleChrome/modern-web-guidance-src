+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { Readable } from 'node:stream';
+import { handleRequest } from './server.mjs';
+
+// Exercise the handler in memory; never open a listening socket during the build.
+async function request(url = '/', { method = 'GET', headers = {}, body = '' } = {}) {
+  const input = Readable.from(body ? [Buffer.from(body)] : []);
+  Object.assign(input, { url, method, headers });
+  const output = {
+    headers: {},
+    setHeader(name, value) { this.headers[name.toLowerCase()] = value; },
+    end(value) { this.body = value ?? ''; },
+  };
+  await handleRequest(input, output);
+  return output;
+}
+
+test('HTML has a fresh CSP nonce, compatible styles and restrictive security headers', async () => {
+  const first = await request();
+  const second = await request();
+  assert.equal(first.statusCode, 200);
+  const nonce = first.body.match(/<style nonce="([^"]+)"/)[1];
+  assert.ok(first.headers['content-security-policy'].includes(`style-src 'nonce-${nonce}'`));
+  assert.ok(first.headers['content-security-policy'].includes(`script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`));
+  assert.notEqual(first.headers['content-security-policy'], second.headers['content-security-policy']);
+  assert.doesNotMatch(first.body, /__CSP_NONCE__|\sstyle=|<script\b|\son\w+=/i);
+  for (const directive of ["object-src 'none'", "base-uri 'none'", "frame-ancestors 'none'", "require-trusted-types-for 'script'", 'report-to default', 'img-src https://images.unsplash.com']) {
+    assert.ok(first.headers['content-security-policy'].includes(directive));
+  }
+  assert.equal(first.headers['reporting-endpoints'], 'default="/security-reports"');
+  assert.equal(first.headers['x-frame-options'], 'DENY');
+  assert.equal(first.headers['x-content-type-options'], 'nosniff');
+  assert.equal(first.headers['cross-origin-resource-policy'], 'same-origin');
+  assert.ok(first.headers['cross-origin-opener-policy'].startsWith('same-origin-allow-popups'));
+  assert.ok(first.headers['strict-transport-security']);
+  assert.ok(first.headers['permissions-policy'].includes('camera=()'));
+  assert.equal(first.headers['cache-control'], 'no-store');
+  assert.equal((await request('/', { method: 'HEAD' })).body, '');
+});
+
+test('logout clears browser state and redirects without caching', async () => {
+  const response = await request('/logout');
+  assert.equal(response.statusCode, 303);
+  assert.equal(response.headers.location, '/');
+  assert.equal(response.headers['clear-site-data'], '"cookies", "storage", "cache"');
+  assert.equal(response.headers['cache-control'], 'no-store');
+});
+
+test('Fetch Metadata blocks cross-site resource access before routing', async () => {
+  for (const url of ['/', '/logout', '/missing', '/security-reports']) {
+    const response = await request(url, { headers: { 'sec-fetch-site': 'cross-site' } });
+    assert.equal(response.statusCode, 403);
+    assert.equal(response.headers.vary, 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+    assert.equal(response.headers['clear-site-data'], undefined);
+  }
+  const response = await request('/', { headers: {
+    'sec-fetch-site': 'cross-site', 'sec-fetch-mode': 'navigate', 'sec-fetch-dest': 'document',
+  } });
+  assert.equal(response.statusCode, 200);
+  assert.equal((await request('/', { headers: { 'sec-fetch-site': 'same-site' } })).statusCode, 403);
+});
+
+test('only public HTML and requested endpoints are exposed', async () => {
+  for (const url of ['/server.mjs', '/package.json', '/guide.md', '/task.md', '/%2e%2e/package.json']) {
+    assert.equal((await request(url)).statusCode, 404);
+  }
+  assert.equal((await request('/', { method: 'POST' })).statusCode, 405);
+});
+
+test('report receiver enforces method, MIME type, valid JSON and size limit', async () => {
+  const headers = { 'content-type': 'application/reports+json' };
+  assert.equal((await request('/security-reports')).statusCode, 405);
+  assert.equal((await request('/security-reports', { method: 'POST' })).statusCode, 415);
+  assert.equal((await request('/security-reports', { method: 'POST', headers, body: '{}' })).statusCode, 204);
+  assert.equal((await request('/security-reports', { method: 'POST', headers, body: 'invalid' })).statusCode, 400);
+  assert.equal((await request('/security-reports', { method: 'POST', headers, body: 'x'.repeat(16385) })).statusCode, 413);
+});
diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..5fbcbed
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,129 @@
+import { createServer } from 'node:http';
+import { randomBytes } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { resolve } from 'node:path';
+
+const template = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+if (template.split('__CSP_NONCE__').length !== 2) {
+  throw new Error('Expected exactly one explicit style nonce placeholder');
+}
+
+/** @param {import('node:http').IncomingMessage} request
+ * @param {import('node:http').ServerResponse} response */
+export async function handleRequest(request, response) {
+  const nonce = randomBytes(18).toString('base64');
+  response.setHeader('Content-Security-Policy', [
+    "default-src 'none'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    `style-src 'nonce-${nonce}'`,
+    "style-src-attr 'none'",
+    'img-src https://images.unsplash.com',
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "form-action 'self'",
+    "require-trusted-types-for 'script'",
+    "trusted-types 'none'",
+    'report-to default',
+  ].join('; '));
+  response.setHeader('Reporting-Endpoints', 'default="/security-reports"');
+  response.setHeader('X-Frame-Options', 'DENY');
+  response.setHeader('X-Content-Type-Options', 'nosniff');
+  response.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  response.setHeader('Permissions-Policy', 'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()');
+  response.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups; report-to="default"');
+  response.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+  // Deploy behind an HTTPS terminator in production. Browsers ignore HSTS on HTTP.
+  // Start with a short lifetime; increase after verifying the HTTPS deployment.
+  response.setHeader('Strict-Transport-Security', 'max-age=300');
+  response.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+  response.setHeader('Cache-Control', 'no-store');
+
+  const send = (status, body = '') => {
+    response.statusCode = status;
+    response.setHeader('Content-Type', 'text/plain; charset=utf-8');
+    response.end(request.method === 'HEAD' ? undefined : body);
+  };
+
+  // No cross-site APIs or embeds exist. Permit incoming links, but not resource reads.
+  const site = request.headers['sec-fetch-site'];
+  if (site && site !== 'same-origin' && site !== 'none') {
+    const navigation = site === 'cross-site' && request.method === 'GET'
+      && request.headers['sec-fetch-mode'] === 'navigate'
+      && request.headers['sec-fetch-dest'] === 'document';
+    if (!navigation) return send(403, 'Forbidden');
+  }
+
+  let pathname;
+  try {
+    pathname = new URL(request.url ?? '/', 'http://localhost').pathname;
+  } catch {
+    return send(400, 'Bad Request');
+  }
+
+  if (pathname === '/security-reports') {
+    if (request.method !== 'POST') {
+      response.setHeader('Allow', 'POST');
+      return send(405, 'Method Not Allowed');
+    }
+    const contentType = request.headers['content-type']?.split(';')[0].trim();
+    if (!['application/reports+json', 'application/csp-report'].includes(contentType)) {
+      return send(415, 'Unsupported Media Type');
+    }
+    // Never persist raw reports: URLs, samples and extension data can contain secrets.
+    const chunks = [];
+    let size = 0;
+    try {
+      for await (const chunk of request) {
+        size += chunk.length;
+        if (size > 16384) return send(413, 'Payload Too Large');
+        chunks.push(chunk);
+      }
+      const report = JSON.parse(Buffer.concat(chunks).toString('utf8'));
+      if (!report || typeof report !== 'object') return send(400, 'Bad Request');
+      const entries = Array.isArray(report) ? report : [report];
+      // Fixed labels only: no attacker-controlled fields enter telemetry logs.
+      const count = entries.filter(entry => entry?.type === 'csp-violation'
+        || entry?.type === 'coop' || entry?.['csp-report']).length;
+      if (count) console.info('Security policy reports received:', count);
+      return send(204);
+    } catch {
+      return send(400, 'Bad Request');
+    }
+  }
+
+  if (!['GET', 'HEAD'].includes(request.method ?? '')) {
+    response.setHeader('Allow', 'GET, HEAD');
+    return send(405, 'Method Not Allowed');
+  }
+  if (pathname === '/logout') {
+    // There is no server-side session store or authentication cookie in this app.
+    // Clear all origin cookies (including HttpOnly cookies), storage and cached data.
+    response.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+    response.setHeader('Location', '/');
+    return send(303);
+  }
+  if (pathname !== '/' && pathname !== '/index.html') return send(404, 'Not Found');
+
+  response.statusCode = 200;
+  response.setHeader('Content-Type', 'text/html; charset=utf-8');
+  response.end(request.method === 'HEAD' ? undefined : template.replace('__CSP_NONCE__', nonce));
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const port = Number(process.env.PORT ?? 11222);
+  if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error('Invalid PORT');
+  const server = createServer((request, response) => {
+    handleRequest(request, response).catch(() => {
+      if (!response.headersSent) {
+        response.statusCode = 500;
+        response.setHeader('Content-Type', 'text/plain; charset=utf-8');
+      }
+      response.end('Internal Server Error');
+    });
+  });
+  server.requestTimeout = 15000;
+  server.headersTimeout = 10000;
+  server.listen(port);
+}
