index 0000000..4c3667b
--- /dev/null
+++ b/app.js
@@ -0,0 +1,165 @@
+/**
+ * The Daily Grind - Client Application
+ * Implements client-side security controls:
+ * - Safe DOM rendering (textContent, createElement, setHTML)
+ * - Trusted Types policy creation and enforcement
+ * - Strict origin validation for window message listeners
+ * - Explicit target origin specification for postMessage
+ */
+
+// Initialize Trusted Types Policy
+let dailyGrindSanitizer = null;
+if (typeof window !== 'undefined' && window.trustedTypes && typeof window.trustedTypes.createPolicy === 'function') {
+  try {
+    dailyGrindSanitizer = window.trustedTypes.createPolicy('dailyGrindSanitizer', {
+      createHTML: (input) => {
+        if (typeof DOMPurify !== 'undefined' && typeof DOMPurify.sanitize === 'function') {
+          return DOMPurify.sanitize(input);
+        }
+        return String(input)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+      },
+      createScript: (input) => input,
+      createScriptURL: (input) => input,
+    });
+  } catch (err) {
+    console.warn('Trusted Types policy initialization notice:', err);
+  }
+}
+
+/**
+ * Safely assign HTML content using Sanitizer API, Trusted Types, or safe text fallback.
+ * Never uses unsafe raw innerHTML directly with untrusted input.
+ */
+function safeSetHTML(element, rawHTML) {
+  if (!element) return;
+  if ('setHTML' in element && typeof element.setHTML === 'function') {
+    element.setHTML(rawHTML);
+  } else if (dailyGrindSanitizer) {
+    element.innerHTML = dailyGrindSanitizer.createHTML(rawHTML);
+  } else {
+    element.textContent = rawHTML;
+  }
+}
+
+// Trusted Origins Allowlist for cross-window communication
+const TRUSTED_MESSAGE_ORIGINS = Object.freeze([
+  'https://trusted-partner.com',
+  'https://auth.dailygrind.com',
+  'https://pay.dailygrind.com',
+  typeof window !== 'undefined' ? window.location.origin : 'http://localhost:11222',
+]);
+
+/**
+ * Message Event Listener with strict origin verification
+ */
+if (typeof window !== 'undefined') {
+  window.addEventListener('message', (event) => {
+    // Strictly validate event.origin against explicit allowlist
+    if (!TRUSTED_MESSAGE_ORIGINS.includes(event.origin)) {
+      console.warn('Security: Rejected postMessage from untrusted origin:', event.origin);
+      return;
+    }
+
+    const data = event.data;
+    if (!data || typeof data !== 'object') return;
+
+    if (data.action === 'UPDATE_BANNER' && typeof data.message === 'string') {
+      const banner = document.getElementById('notification-banner');
+      if (banner) {
+        // Safe DOM update using textContent
+        banner.textContent = data.message;
+        banner.style.display = 'block';
+      }
+    }
+
+    if (data.action === 'PARTNER_PROMO' && typeof data.promoHTML === 'string') {
+      const promoBox = document.getElementById('partner-promo');
+      if (promoBox) {
+        // Route through Trusted Types sanitizer
+        safeSetHTML(promoBox, data.promoHTML);
+      }
+    }
+  });
+}
+
+/**
+ * Securely send message to target window with explicit target origin.
+ * NEVER uses wildcard '*'.
+ */
+function sendSecureMessage(targetWindow, payload, targetOrigin = 'https://trusted-partner.com') {
+  if (!TRUSTED_MESSAGE_ORIGINS.includes(targetOrigin)) {
+    throw new Error('Target origin not allowed: ' + targetOrigin);
+  }
+  if (targetWindow && typeof targetWindow.postMessage === 'function') {
+    targetWindow.postMessage(payload, targetOrigin);
+  }
+}
+
+/**
+ * Render dynamic menu items safely using createElement and textContent
+ */
+function renderDynamicMenu(items) {
+  const container = document.getElementById('dynamic-menu');
+  if (!container) return;
+
+  // Clear existing content safely
+  container.textContent = '';
+
+  items.forEach((item) => {
+    const card = document.createElement('div');
+    card.className = 'card';
+
+    const title = document.createElement('h3');
+    title.textContent = item.name;
+
+    const desc = document.createElement('p');
+    desc.textContent = item.description;
+
+    const price = document.createElement('p');
+    price.className = 'price';
+    price.textContent = `$${Number(item.price).toFixed(2)}`;
+
+    const btn = document.createElement('a');
+    btn.className = 'btn';
+    btn.href = `/order-online?item=${encodeURIComponent(item.id || '')}`;
+    btn.textContent = 'Order Now';
+
+    card.appendChild(title);
+    card.appendChild(desc);
+    card.appendChild(price);
+    card.appendChild(btn);
+
+    container.appendChild(card);
+  });
+}
+
+/**
+ * Initialize application state on DOMContentLoaded
+ */
+if (typeof document !== 'undefined') {
+  document.addEventListener('DOMContentLoaded', () => {
+    // Check user session
+    fetch('/api/session', {
+      headers: { 'Accept': 'application/json' },
+      credentials: 'same-origin',
+    })
+      .then((res) => (res.ok ? res.json() : null))
+      .then((data) => {
+        if (data && data.user) {
+          const userGreeting = document.getElementById('user-greeting');
+          if (userGreeting) {
+            // Safe textContent update
+            userGreeting.textContent = `Welcome back, ${data.user.name}! (${data.user.rewardsPoints} Rewards Points)`;
+          }
+        }
+      })
+      .catch((err) => {
+        console.debug('Session check completed:', err);
+      });
+  });
+}
