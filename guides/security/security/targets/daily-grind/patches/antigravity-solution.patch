@@ -0,0 +1,172 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { randomBytes } from 'node:crypto';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+const PORT = Number(process.env.PORT) || 11222;
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.mjs': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.webp': 'image/webp',
+  '.ico': 'image/x-icon',
+  '.txt': 'text/plain; charset=utf-8',
+};
+
+function setSecurityHeaders(res, nonce) {
+  const csp = [
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "require-trusted-types-for 'script'",
+    "form-action 'self'",
+    'report-to main-endpoint',
+  ].join('; ');
+
+  res.setHeader(
+    'Reporting-Endpoints',
+    'default="/csp-reports", main-endpoint="/csp-reports"'
+  );
+  res.setHeader('Content-Security-Policy', csp);
+  res.setHeader('X-Frame-Options', 'DENY');
+  res.setHeader(
+    'Strict-Transport-Security',
+    'max-age=31536000; includeSubDomains; preload'
+  );
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader(
+    'Permissions-Policy',
+    'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()'
+  );
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+  res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+}
+
+function checkFetchMetadata(req, res) {
+  res.setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+
+  const site = req.headers['sec-fetch-site'];
+  const mode = req.headers['sec-fetch-mode'];
+  const dest = req.headers['sec-fetch-dest'];
+
+  if (!site) return true; // Fallback for legacy browsers
+
+  if (['same-origin', 'same-site', 'none'].includes(site)) return true;
+
+  // Allow standard navigate GET requests (link clicks)
+  if (
+    site === 'cross-site' &&
+    mode === 'navigate' &&
+    req.method === 'GET' &&
+    !['object', 'embed'].includes(dest)
+  ) {
+    return true;
+  }
+
+  return false;
+}
+
+const server = createServer(async (req, res) => {
+  const nonce = randomBytes(16).toString('base64');
+  setSecurityHeaders(res, nonce);
+
+  if (!checkFetchMetadata(req, res)) {
+    res.writeHead(403, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Forbidden');
+    return;
+  }
+
+  const parsedUrl = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+  const pathname = parsedUrl.pathname;
+
+  if (pathname === '/csp-reports' && req.method === 'POST') {
+    res.writeHead(204);
+    res.end();
+    return;
+  }
+
+  if (pathname === '/logout') {
+    res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+    res.setHeader(
+      'Set-Cookie',
+      '__Host-session=; Max-Age=0; SameSite=Lax; HttpOnly; Secure; Path=/'
+    );
+    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+    res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Signed Out | The Daily Grind</title>
+</head>
+<body>
+  <main>
+    <h1>You have been signed out</h1>
+    <p>Your session and site data have been cleared.</p>
+    <p><a href="/">Return to Home</a></p>
+  </main>
+</body>
+</html>`);
+    return;
+  }
+
+  if (req.method !== 'GET' && req.method !== 'HEAD') {
+    res.writeHead(405, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Method Not Allowed');
+    return;
+  }
+
+  const relativePath = pathname === '/' ? 'index.html' : pathname.replace(/^\/+/, '');
+  const resolvedPath = path.resolve(__dirname, relativePath);
+
+  // Prevent path traversal outside __dirname
+  if (!resolvedPath.startsWith(__dirname + path.sep) && resolvedPath !== path.join(__dirname, 'index.html')) {
+    res.writeHead(403, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Forbidden');
+    return;
+  }
+
+  try {
+    const ext = path.extname(resolvedPath).toLowerCase();
+    const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+    const data = await readFile(resolvedPath);
+
+    res.writeHead(200, { 'Content-Type': contentType });
+    if (req.method === 'HEAD') {
+      res.end();
+      return;
+    }
+
+    if (ext === '.html') {
+      const html = data.toString('utf-8').replaceAll('{{CSP_NONCE}}', nonce);
+      res.end(html);
+    } else {
+      res.end(data);
+    }
+  } catch (err) {
+    if (err && (err.code === 'ENOENT' || err.code === 'EISDIR')) {
+      res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Not Found');
+    } else {
+      res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Internal Server Error');
+    }
+  }
+});
+
+server.listen(PORT, () => {
+  console.log(`Server listening on http://localhost:${PORT}`);
+});
