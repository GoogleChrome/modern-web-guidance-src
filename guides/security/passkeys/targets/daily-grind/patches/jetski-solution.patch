+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: result.rpId || currentRpId,
+              credentialId: credentialJSON.id
+            });
+          }
+          setStatus('Passkey not recognized. Please try another sign-in method.');
+          return result;
+        }
+
+        if (result.authenticated) {
+          setStatus('Authentication successful! Welcome back.');
