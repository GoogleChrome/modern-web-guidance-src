+    async function registerPasskey() {
+      try {
+        setStatus('Fetching registration options from server...');
+        const optionsRes = await fetch('/api/webauthn/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ userId: currentUserId, rpId: currentRpId })
+        });
+        const optionsJSON = await optionsRes.json();
+
+        const options = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+        setStatus('Please verify your biometric or security key...');
+        const credential = await navigator.credentials.create({ publicKey: options });
+
+        if (!credential) {
+          throw new Error('Credential creation returned null');
+        }
+
+        const credentialJSON = credential.toJSON();
