+  <script>
+    const AAGUID_PROVIDERS = {
+      'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': { name: 'Google Password Manager', icon: 'gpm.png' },
+      'dd4ec2ec-1062-d1f0-e4d0-c4e2fb8a4400': { name: 'iCloud Keychain', icon: 'icloud.png' },
+      '531126d6-e717-415c-9320-3d9aa6981239': { name: '1Password', icon: '1pass.png' }
+    };
+
+    function getProviderInfo(aaguid) {
+      return AAGUID_PROVIDERS[aaguid] || { name: 'Standard Passkey', icon: null };
+    }
+
+    async function checkFeatureSupport() {
+      if (!('PublicKeyCredential' in window)) return false;
+      if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+        try {
+          return await PublicKeyCredential.isConditionalMediationAvailable();
+        } catch (e) {
+          return false;
+        }
+      }
+      return true;
+    }
+
+    async function initPasskeyFeature() {
+      const supported = await checkFeatureSupport();
+      const elements = document.querySelectorAll('.passkey-hidden');
+      elements.forEach(el => {
+        if (supported) {
+          el.classList.remove('passkey-hidden');
+          el.style.display = '';
+        } else {
+          el.style.display = 'none';
+        }
+      });
+    }
+
+    async function registerPasskey() {
+      try {
+        const optionsRes = await fetch('/api/webauthn/register/options', { method: 'POST' });
+        const optionsJSON = await optionsRes.json();
+        const options = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+        const credential = await navigator.credentials.create({ publicKey: options });
+        if (!credential) return;
+
+        const credJSON = credential.toJSON();
+        const verifyRes = await fetch('/api/webauthn/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(credJSON)
+        });
+        const result = await verifyRes.json();
+
+        if (result.verified && typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function') {
+          await PublicKeyCredential.signalAllAcceptedCredentials({
+            rpId: result.rpId || window.location.hostname,
+            userId: result.userId || 'user-default',
+            allAcceptedCredentialIds: result.credentialIds || [credJSON.id]
+          });
+        }
+        await loadCredentials();
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          console.warn('Registration cancelled');
+        } else if (err.name === 'AbortError') {
+          console.warn('Registration aborted');
+        } else {
+          console.error('Registration failed', err);
+        }
+      }
+    }
+
+    async function authenticatePasskey() {
+      try {
+        const optionsRes = await fetch('/api/webauthn/authenticate/options', { method: 'POST' });
+        const optionsJSON = await optionsRes.json();
+        const options = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+        const credential = await navigator.credentials.get({ publicKey: options });
+        if (!credential) return;
+
+        const credJSON = credential.toJSON();
+        const verifyRes = await fetch('/api/webauthn/authenticate/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(credJSON)
+        });
+        const result = await verifyRes.json();
+
+        if (result.unknownCredential && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: result.rpId || window.location.hostname,
+            credentialId: credJSON.id
+          });
+        }
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          console.warn('Authentication cancelled');
+        } else if (err.name === 'AbortError') {
+          console.warn('Authentication aborted');
+        } else {
+          console.error('Authentication failed', err);
+        }
+      }
+    }
+
+    async function deleteCredential(credId) {
+      try {
+        const res = await fetch('/api/webauthn/credentials/delete', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ credentialId: credId })
+        });
+        const result = await res.json();
+        if (typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function') {
+          await PublicKeyCredential.signalAllAcceptedCredentials({
+            rpId: result.rpId || window.location.hostname,
+            userId: result.userId || 'user-default',
+            allAcceptedCredentialIds: result.remainingCredentialIds || []
+          });
+        }
+        await loadCredentials();
+      } catch (err) {
+        console.error('Delete failed', err);
+      }
+    }
+
+    async function updateProfile(event) {
+      event.preventDefault();
+      const username = document.getElementById('profileName').value;
+      const displayName = document.getElementById('profileDisplay').value;
+      try {
+        const res = await fetch('/api/user/update', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username, displayName })
+        });
+        const result = await res.json();
+        if (typeof PublicKeyCredential.signalCurrentUserDetails === 'function') {
+          await PublicKeyCredential.signalCurrentUserDetails({
+            rpId: result.rpId || window.location.hostname,
+            userId: result.userId || 'user-default',
+            name: username,
+            displayName: displayName
+          });
+        }
+      } catch (err) {
+        console.error('Profile update failed', err);
+      }
+    }
+
+    async function loadCredentials() {
+      const list = document.getElementById('passkeyList');
+      if (!list) return;
+      try {
+        const res = await fetch('/api/webauthn/credentials');
+        const data = await res.json();
+        list.innerHTML = '';
+        (data.credentials || []).forEach(cred => {
+          const item = document.createElement('li');
+          const info = getProviderInfo(cred.aaguid);
+          item.textContent = info.name + ' - ' + (cred.name || cred.id) + ' ';
+          const delBtn = document.createElement('button');
+          delBtn.textContent = 'Remove';
+          delBtn.className = 'passkey-btn';
+          delBtn.onclick = () => deleteCredential(cred.id);
+          item.appendChild(delBtn);
+          list.appendChild(item);
+        });
+      } catch (e) {}
+    }
+
+    document.addEventListener('DOMContentLoaded', () => {
+      initPasskeyFeature();
+      loadCredentials();
+    });
+  </script>
 </body>
 
 </html>

