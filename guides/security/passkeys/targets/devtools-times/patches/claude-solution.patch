@@ -0,0 +1,20 @@
+import type { APIRoute } from 'astro';
+import { callPasswordService } from '../../../lib/passkeys/password';
+import { getAuthUser, json, markReauthenticated, readJson, requireSession } from '../../../lib/passkeys/server';
+
+/** Password fallback for reauthentication when the user has no usable passkey. */
+export const POST: APIRoute = async ({ request, session }) => {
+  const authUser = await getAuthUser(session);
+  if (!authUser) return json({ error: 'Not signed in' }, 401);
+
+  const body = await readJson<{ password?: unknown }>(request);
+  if (!body || typeof body.password !== 'string' || !body.password) {
+    return json({ error: 'Password is required' }, 400);
+  }
+
+  const result = await callPasswordService('login', authUser.username, body.password);
+  if (!result.ok) return json({ error: result.error ?? 'Verification failed' }, 401);
+
+  markReauthenticated(requireSession(session));
+  return json({ ok: true });
+};
diff --git a/src/pages/api/auth/register.ts b/src/pages/api/auth/register.ts
