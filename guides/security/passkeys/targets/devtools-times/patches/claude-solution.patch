+++ b/src/pages/api/auth/register.ts
@@ -0,0 +1,21 @@
+import type { APIRoute } from 'astro';
+import { callPasswordService, parseCredentials } from '../../../lib/passkeys/password';
+import { getRelyingParty, json, readJson, requireSession, signIn } from '../../../lib/passkeys/server';
+import { ensureUser } from '../../../lib/passkeys/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const credentials = parseCredentials(await readJson(request));
+  if (!credentials) return json({ error: 'Username and password are required' }, 400);
+
+  const result = await callPasswordService('register', credentials.username, credentials.password);
+  if (!result.ok) {
+    return json({ error: result.error ?? 'Unknown error' }, result.status >= 400 ? result.status : 400);
+  }
+
+  // The account was just created with these credentials: sign the user in so
+  // they can immediately add a passkey.
+  const user = await ensureUser(credentials.username);
+  await signIn(requireSession(session), user);
+  const { rpID } = getRelyingParty(url);
+  return json({ username: user.username, userId: user.userId, rpId: rpID });
+};
diff --git a/src/pages/api/passkeys/[id].ts b/src/pages/api/passkeys/[id].ts
new file mode 100644
index 0000000..f35a3e1
--- /dev/null
+++ b/src/pages/api/passkeys/[id].ts
@@ -0,0 +1,50 @@
+import type { APIRoute } from 'astro';
+import {
+  accountPayload,
+  getAuthUser,
+  getRelyingParty,
+  isRecentlyAuthenticated,
+  json,
+  readJson,
+  requireSession,
+} from '../../../lib/passkeys/server';
+import { deletePasskey, findUserById, renamePasskey } from '../../../lib/passkeys/store';
+
+const MAX_NAME_LENGTH = 64;
+
+export const PATCH: APIRoute = async ({ params, request, session, url }) => {
+  const authUser = await getAuthUser(session);
+  if (!authUser) return json({ error: 'not_signed_in' }, 401);
+  const id = params.id;
+  if (!id) return json({ error: 'Missing passkey id' }, 400);
+
+  const body = await readJson<{ name?: unknown }>(request);
+  const name = typeof body?.name === 'string' ? body.name.trim() : '';
+  if (!name || name.length > MAX_NAME_LENGTH) {
+    return json({ error: `Name must be 1–${MAX_NAME_LENGTH} characters.` }, 400);
+  }
+
+  if (!(await renamePasskey(authUser.userId, id, name))) return json({ error: 'Passkey not found' }, 404);
+
+  const user = await findUserById(authUser.userId);
+  if (!user) return json({ error: 'not_signed_in' }, 401);
+  return json(accountPayload(user, getRelyingParty(url).rpID));
+};
+
+export const DELETE: APIRoute = async ({ params, session, url }) => {
+  const authUser = await getAuthUser(session);
+  if (!authUser) return json({ error: 'not_signed_in' }, 401);
+  const id = params.id;
+  if (!id) return json({ error: 'Missing passkey id' }, 400);
+
+  // Removing a sign-in method requires a recent reauthentication.
+  if (!(await isRecentlyAuthenticated(requireSession(session)))) {
+    return json({ error: 'reauth_required' }, 403);
+  }
+
+  if (!(await deletePasskey(authUser.userId, id))) return json({ error: 'Passkey not found' }, 404);
+
+  const user = await findUserById(authUser.userId);
+  if (!user) return json({ error: 'not_signed_in' }, 401);
+  return json(accountPayload(user, getRelyingParty(url).rpID));
+};
diff --git a/src/pages/api/passkeys/authenticate.ts b/src/pages/api/passkeys/authenticate.ts
new file mode 100644
index 0000000..55dfc4a
--- /dev/null
+++ b/src/pages/api/passkeys/authenticate.ts
@@ -0,0 +1,89 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse, type AuthenticationResponseJSON } from '@simplewebauthn/server';
+import {
+  accountPayload,
+  base64urlToBytes,
+  getAuthUser,
+  getRelyingParty,
+  json,
+  markReauthenticated,
+  readJson,
+  requireSession,
+  signIn,
+} from '../../../lib/passkeys/server';
+import { findUserByCredentialId, findUserById, updatePasskeyUsage } from '../../../lib/passkeys/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const s = requireSession(session);
+  const body = await readJson<{ credential?: AuthenticationResponseJSON }>(request);
+  const credential = body?.credential;
+  if (!credential || typeof credential.id !== 'string' || !credential.response) {
+    return json({ error: 'Invalid credential' }, 400);
+  }
+
+  // Challenges are single-use.
+  const pending = await s.get('passkeyAuthenticationChallenge');
+  s.delete('passkeyAuthenticationChallenge');
+  if (!pending || pending.expiresAt < Date.now()) {
+    return json({ error: 'Sign-in expired. Please try again.' }, 400);
+  }
+
+  const { rpID, origins } = getRelyingParty(url);
+
+  const match = await findUserByCredentialId(credential.id);
+  if (!match) {
+    // Let the client tell the password manager to hide/remove this passkey.
+    return json({ error: 'unknown_credential', rpId: rpID, credentialId: credential.id }, 404);
+  }
+  const { user, passkey } = match;
+
+  const userHandle = credential.response.userHandle;
+  if (userHandle && userHandle !== user.userId) {
+    return json({ error: 'Passkey does not match account' }, 400);
+  }
+
+  let authUser: { userId: string; username: string } | undefined;
+  if (pending.purpose === 'reauth') {
+    authUser = await getAuthUser(session);
+    if (!authUser || authUser.userId !== user.userId) {
+      return json({ error: 'This passkey belongs to a different account.' }, 403);
+    }
+  }
+
+  let verification;
+  try {
+    verification = await verifyAuthenticationResponse({
+      response: credential,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: base64urlToBytes(passkey.publicKey),
+        counter: passkey.counter,
+        transports: passkey.transports,
+      },
+      requireUserVerification: pending.purpose === 'reauth',
+    });
+  } catch (err) {
+    return json({ error: err instanceof Error ? err.message : 'Verification failed' }, 400);
+  }
+
+  if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+  const info = verification.authenticationInfo;
+  await updatePasskeyUsage(user.userId, passkey.id, {
+    counter: info.newCounter,
+    backedUp: info.credentialBackedUp,
+    deviceType: info.credentialDeviceType,
+  });
+
+  if (pending.purpose === 'reauth') {
+    markReauthenticated(s);
+  } else {
+    await signIn(s, user);
+  }
+
+  const updated = (await findUserById(user.userId)) ?? user;
+  return json(accountPayload(updated, rpID));
+};
diff --git a/src/pages/api/passkeys/authentication-options.ts b/src/pages/api/passkeys/authentication-options.ts
new file mode 100644
index 0000000..4049e34
--- /dev/null
+++ b/src/pages/api/passkeys/authentication-options.ts
@@ -0,0 +1,44 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import {
+  CHALLENGE_TTL_MS,
+  getAuthUser,
+  getRelyingParty,
+  json,
+  readJson,
+  requireSession,
+} from '../../../lib/passkeys/server';
+import { findUserById } from '../../../lib/passkeys/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const s = requireSession(session);
+  const body = await readJson<{ purpose?: unknown }>(request);
+  const purpose = body?.purpose === 'reauth' ? 'reauth' : 'signin';
+  const { rpID } = getRelyingParty(url);
+
+  let allowCredentials: { id: string; transports?: string[] }[] = [];
+  if (purpose === 'reauth') {
+    const authUser = await getAuthUser(session);
+    if (!authUser) return json({ error: 'not_signed_in' }, 401);
+    const user = await findUserById(authUser.userId);
+    if (!user || user.passkeys.length === 0) return json({ error: 'no_passkeys' }, 400);
+    // Reauthentication: restrict to the signed-in user's passkeys.
+    allowCredentials = user.passkeys.map((p) => ({ id: p.id, transports: p.transports }));
+  }
+
+  const options = await generateAuthenticationOptions({
+    rpID,
+    // Empty for sign-in so discoverable credentials can be offered (autofill/button).
+    allowCredentials,
+    userVerification: purpose === 'reauth' ? 'required' : 'preferred',
+    timeout: CHALLENGE_TTL_MS,
+  });
+
+  s.set('passkeyAuthenticationChallenge', {
+    challenge: options.challenge,
+    purpose,
+    expiresAt: Date.now() + CHALLENGE_TTL_MS,
+  });
+
+  return json(options);
+};
