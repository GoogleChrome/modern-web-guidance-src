index 0000000..a227456
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,405 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import { KeyIcon, PencilIcon, TrashIcon } from '@heroicons/react/24/outline';
+import {
+  apiRequest,
+  authenticateWithPasskey,
+  describePasskeyError,
+  isCancellation,
+  isPasskeySupported,
+  PasskeyError,
+  registerPasskey,
+  signalAccountState,
+  type AccountPayload,
+  type PasskeySummary,
+} from '../lib/passkeys/client';
+
+interface Props {
+  initialAccount: AccountPayload;
+}
+
+const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
+
+function formatDate(iso: string | null): string {
+  if (!iso) return 'Never';
+  const date = new Date(iso);
+  return Number.isNaN(date.getTime()) ? 'Unknown' : dateFormatter.format(date);
+}
+
+export default function AccountSettings({ initialAccount }: Props) {
+  const [account, setAccount] = useState<AccountPayload>(initialAccount);
+  const [supported, setSupported] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [status, setStatus] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editName, setEditName] = useState('');
+
+  // Reauthentication dialog state.
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const reauthResolver = useRef<((ok: boolean) => void) | null>(null);
+  const [reauthPassword, setReauthPassword] = useState('');
+  const [reauthError, setReauthError] = useState<string | null>(null);
+  const [reauthBusy, setReauthBusy] = useState(false);
+
+  useEffect(() => {
+    setSupported(isPasskeySupported());
+    // Keep the password manager's view of this account in sync with the server.
+    void signalAccountState(initialAccount);
+  }, [initialAccount]);
+
+  const applyAccount = useCallback((next: AccountPayload) => {
+    setAccount(next);
+    void signalAccountState(next);
+  }, []);
+
+  // ---------------------------------------------------------------------------
+  // Reauthentication
+  // ---------------------------------------------------------------------------
+
+  const closeReauth = (ok: boolean) => {
+    dialogRef.current?.close();
+    setReauthPassword('');
+    setReauthError(null);
+    const resolve = reauthResolver.current;
+    reauthResolver.current = null;
+    resolve?.(ok);
+  };
+
+  const requestReauth = (): Promise<boolean> =>
+    new Promise((resolve) => {
+      reauthResolver.current = resolve;
+      setReauthError(null);
+      dialogRef.current?.showModal();
+    });
+
+  const reauthWithPasskey = async () => {
+    setReauthError(null);
+    setReauthBusy(true);
+    try {
+      await authenticateWithPasskey({ purpose: 'reauth' });
+      closeReauth(true);
+    } catch (err) {
+      if (!isCancellation(err)) setReauthError(describePasskeyError(err));
+    } finally {
+      setReauthBusy(false);
+    }
+  };
+
+  const reauthWithPassword = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setReauthError(null);
+    setReauthBusy(true);
+    try {
+      await apiRequest('/auth/reauth-password', { method: 'POST', body: { password: reauthPassword } });
+      closeReauth(true);
+    } catch (err) {
+      setReauthError(
+        err instanceof PasskeyError ? `Verification failed: ${err.message}` : 'Verification failed. Please try again.',
+      );
+    } finally {
+      setReauthBusy(false);
+    }
+  };
+
+  /** Runs a sensitive action, prompting for reauthentication if the server requires it. */
+  const withReauth = async <T,>(action: () => Promise<T>): Promise<T | undefined> => {
+    try {
+      return await action();
+    } catch (err) {
+      if (err instanceof PasskeyError && err.code === 'reauth_required') {
+        if (!(await requestReauth())) return undefined;
+        return action();
+      }
+      throw err;
+    }
+  };
+
+  // ---------------------------------------------------------------------------
+  // Management actions
+  // ---------------------------------------------------------------------------
+
+  const handleCreate = async () => {
+    setError(null);
+    setStatus(null);
+    setBusy(true);
+    try {
+      const next = await withReauth(() => registerPasskey());
+      if (next) {
+        setAccount(next);
+        setStatus('Passkey created.');
+      }
+    } catch (err) {
+      if (!isCancellation(err)) setError(describePasskeyError(err));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const startRename = (passkey: PasskeySummary) => {
+    setEditingId(passkey.id);
+    setEditName(passkey.name);
+    setError(null);
+    setStatus(null);
+  };
+
+  const handleRename = async (e: React.FormEvent, id: string) => {
+    e.preventDefault();
+    setBusy(true);
+    setError(null);
+    try {
+      const next = await apiRequest<AccountPayload>(`/passkeys/${encodeURIComponent(id)}`, {
+        method: 'PATCH',
+        body: { name: editName },
+      });
+      applyAccount(next);
+      setEditingId(null);
+      setStatus('Passkey renamed.');
+    } catch (err) {
+      setError(describePasskeyError(err));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const handleDelete = async (passkey: PasskeySummary) => {
+    if (!window.confirm(`Remove the passkey “${passkey.name}”? You won’t be able to sign in with it anymore.`)) return;
+    setBusy(true);
+    setError(null);
+    setStatus(null);
+    try {
+      const next = await withReauth(() =>
+        apiRequest<AccountPayload>(`/passkeys/${encodeURIComponent(passkey.id)}`, { method: 'DELETE' }),
+      );
+      if (next) {
+        // signalAllAcceptedCredentials lets the password manager hide the removed passkey.
+        applyAccount(next);
+        setStatus(
+          'Passkey removed from your account. You may also remove it from your password manager.',
+        );
+      }
+    } catch (err) {
+      setError(describePasskeyError(err));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const handleSignOut = async () => {
+    setBusy(true);
+    try {
+      await apiRequest('/auth/logout', { method: 'POST', body: {} });
+    } finally {
+      window.location.assign(import.meta.env.BASE_URL);
+    }
+  };
+
+  const hasPasskeys = account.passkeys.length > 0;
+
+  return (
+    <div className="max-w-2xl mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+      <div className="flex items-center justify-between mb-6">
+        <div>
+          <h2 className="text-2xl font-bold text-gray-800">Account settings</h2>
+          <p className="text-sm text-gray-600">Signed in as {account.username}</p>
+        </div>
+        <button
+          type="button"
+          onClick={handleSignOut}
+          disabled={busy}
+          className="text-sm font-medium text-gray-600 hover:text-gray-900 underline"
+        >
+          Sign out
+        </button>
+      </div>
+
+      {error && (
+        <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+      {status && (
+        <div className="mb-4 p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+          {status}
+        </div>
+      )}
+
+      <section aria-labelledby="passkeys-heading">
+        <div className="flex items-center justify-between mb-3">
+          <h3 id="passkeys-heading" className="text-lg font-semibold text-gray-900">
+            Passkeys
+          </h3>
+          {supported && (
+            <button
+              type="button"
+              onClick={handleCreate}
+              disabled={busy}
+              className={`py-2 px-3 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 ${
+                busy ? 'opacity-75 cursor-not-allowed' : ''
+              }`}
+            >
+              Create a passkey
+            </button>
+          )}
+        </div>
+
+        <p className="text-sm text-gray-600 mb-4">
+          Passkeys let you sign in with your fingerprint, face, or screen lock. They are stored in your password
+          manager and can’t be phished.
+        </p>
+
+        {!supported && (
+          <p className="mb-4 p-3 text-sm text-gray-700 bg-gray-100 rounded-lg">
+            Passkeys aren’t supported in this browser or on this connection.
+          </p>
+        )}
+
+        {hasPasskeys ? (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md">
+            {account.passkeys.map((passkey) => (
+              <li key={passkey.id} className="p-4 flex items-start gap-3">
+                <KeyIcon className="h-6 w-6 text-gray-500 shrink-0 mt-0.5" aria-hidden="true" />
+                <div className="flex-grow min-w-0">
+                  {editingId === passkey.id ? (
+                    <form onSubmit={(e) => handleRename(e, passkey.id)} className="flex flex-wrap gap-2">
+                      <label htmlFor={`rename-${passkey.id}`} className="sr-only">
+                        Passkey name
+                      </label>
+                      <input
+                        id={`rename-${passkey.id}`}
+                        type="text"
+                        value={editName}
+                        maxLength={64}
+                        required
+                        autoFocus
+                        onChange={(e) => setEditName(e.target.value)}
+                        className="flex-grow px-2 py-1 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
+                      />
+                      <button
+                        type="submit"
+                        disabled={busy}
+                        className="px-3 py-1 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
+                      >
+                        Save
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setEditingId(null)}
+                        className="px-3 py-1 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+                      >
+                        Cancel
+                      </button>
+                    </form>
+                  ) : (
+                    <p className="font-medium text-gray-900 truncate">{passkey.name}</p>
+                  )}
+                  <p className="text-xs text-gray-500 mt-1">
+                    {passkey.providerName ? `${passkey.providerName} · ` : ''}
+                    Created {formatDate(passkey.createdAt)} · Last used {formatDate(passkey.lastUsedAt)}
+                    {passkey.synced ? ' · Synced' : ''}
+                  </p>
+                </div>
+                {editingId !== passkey.id && (
+                  <div className="flex gap-1 shrink-0">
+                    <button
+                      type="button"
+                      onClick={() => startRename(passkey)}
+                      disabled={busy}
+                      aria-label={`Rename passkey ${passkey.name}`}
+                      className="p-2 rounded-md text-gray-600 hover:bg-gray-100 hover:text-gray-900"
+                    >
+                      <PencilIcon className="h-5 w-5" aria-hidden="true" />
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => handleDelete(passkey)}
+                      disabled={busy}
+                      aria-label={`Remove passkey ${passkey.name}`}
+                      className="p-2 rounded-md text-red-600 hover:bg-red-50 hover:text-red-800"
+                    >
+                      <TrashIcon className="h-5 w-5" aria-hidden="true" />
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        ) : (
+          <p className="text-sm text-gray-500">You haven’t created any passkeys yet.</p>
+        )}
+      </section>
+
+      <dialog
+        ref={dialogRef}
+        aria-labelledby="reauth-title"
+        onCancel={(e) => {
+          e.preventDefault();
+          closeReauth(false);
+        }}
+        className="m-auto p-6 rounded-lg shadow-lg max-w-sm w-full backdrop:bg-black/40"
+      >
+        <h3 id="reauth-title" className="text-lg font-semibold text-gray-900 mb-2">
+          Confirm it’s you
+        </h3>
+        <p className="text-sm text-gray-600 mb-4">For your security, please verify your identity to continue.</p>
+
+        {reauthError && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {reauthError}
+          </div>
+        )}
+
+        {supported && hasPasskeys && (
+          <>
+            <button
+              type="button"
+              onClick={reauthWithPasskey}
+              disabled={reauthBusy}
+              className="w-full py-2 px-4 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
+            >
+              Verify with a passkey
+            </button>
+            <div className="flex items-center my-4" aria-hidden="true">
+              <div className="flex-grow border-t border-gray-200" />
+              <span className="px-3 text-xs text-gray-500">or use your password</span>
+              <div className="flex-grow border-t border-gray-200" />
+            </div>
+          </>
+        )}
+
+        <form onSubmit={reauthWithPassword} className="space-y-3">
+          {/* Hidden username helps password managers fill the right credential. */}
+          <input type="text" name="username" autoComplete="username" value={account.username} readOnly hidden />
+          <label htmlFor="reauth-password" className="block text-sm font-medium text-gray-700">
+            Password
+          </label>
+          <input
+            id="reauth-password"
+            type="password"
+            name="password"
+            autoComplete="current-password"
+            value={reauthPassword}
+            onChange={(e) => setReauthPassword(e.target.value)}
+            required
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+          />
+          <div className="flex gap-2 justify-end">
+            <button
+              type="button"
+              onClick={() => closeReauth(false)}
+              className="px-3 py-2 rounded-md text-sm font-medium text-gray-700 border border-gray-300 hover:bg-gray-50"
+            >
+              Cancel
+            </button>
+            <button
+              type="submit"
+              disabled={reauthBusy}
+              className="px-3 py-2 rounded-md text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
+            >
+              Confirm
+            </button>
+          </div>
+        </form>
+      </dialog>
+    </div>
+  );
+}
