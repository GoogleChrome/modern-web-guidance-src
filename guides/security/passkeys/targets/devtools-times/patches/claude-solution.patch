diff --git a/src/pages/api/passkeys/register.ts b/src/pages/api/passkeys/register.ts
new file mode 100644
index 0000000..8aaa35e
--- /dev/null
+++ b/src/pages/api/passkeys/register.ts
@@ -0,0 +1,73 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse, type RegistrationResponseJSON } from '@simplewebauthn/server';
+import {
+  accountPayload,
+  bytesToBase64url,
+  defaultPasskeyName,
+  getAuthUser,
+  getRelyingParty,
+  json,
+  readJson,
+  requireSession,
+} from '../../../lib/passkeys/server';
+import { addPasskey, findUserByCredentialId, findUserById } from '../../../lib/passkeys/store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const authUser = await getAuthUser(session);
+  if (!authUser) return json({ error: 'not_signed_in' }, 401);
+  const s = requireSession(session);
+
+  const body = await readJson<{ credential?: RegistrationResponseJSON }>(request);
+  const credential = body?.credential;
+  if (!credential || typeof credential.id !== 'string' || !credential.response) {
+    return json({ error: 'Invalid credential' }, 400);
+  }
+
+  // Challenges are single-use.
+  const pending = await s.get('passkeyRegistrationChallenge');
+  s.delete('passkeyRegistrationChallenge');
+  if (!pending || pending.expiresAt < Date.now() || pending.userId !== authUser.userId) {
+    return json({ error: 'Registration expired. Please try again.' }, 400);
+  }
+
+  const { rpID, origins } = getRelyingParty(url);
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response: credential,
+      expectedChallenge: pending.challenge,
+      expectedOrigin: origins,
+      expectedRPID: rpID,
+      // Conditional create (automatic passkey upgrade) does not perform user
+      // verification, so UV is preferred rather than required here.
+      requireUserVerification: false,
+    });
+  } catch (err) {
+    return json({ error: err instanceof Error ? err.message : 'Verification failed' }, 400);
+  }
+
+  if (!verification.verified) return json({ error: 'Verification failed' }, 400);
+
+  const info = verification.registrationInfo;
+  if (await findUserByCredentialId(info.credential.id)) {
+    return json({ error: 'This passkey is already registered.' }, 409);
+  }
+
+  const now = new Date().toISOString();
+  await addPasskey(authUser.userId, {
+    id: info.credential.id,
+    publicKey: bytesToBase64url(info.credential.publicKey),
+    counter: info.credential.counter,
+    transports: info.credential.transports,
+    aaguid: info.aaguid, // UX hint only.
+    name: defaultPasskeyName(info.aaguid),
+    deviceType: info.credentialDeviceType,
+    backedUp: info.credentialBackedUp,
+    createdAt: now,
+    lastUsedAt: null,
+  });
+
+  const user = await findUserById(authUser.userId);
+  if (!user) return json({ error: 'not_signed_in' }, 401);
+  return json(accountPayload(user, rpID));
+};
diff --git a/src/pages/api/passkeys/registration-options.ts b/src/pages/api/passkeys/registration-options.ts
new file mode 100644
index 0000000..206e611
--- /dev/null
+++ b/src/pages/api/passkeys/registration-options.ts
@@ -0,0 +1,51 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import {
+  base64urlToBytes,
+  CHALLENGE_TTL_MS,
+  getAuthUser,
+  getRelyingParty,
+  isRecentlyAuthenticated,
+  json,
+  RP_NAME,
+  requireSession,
+} from '../../../lib/passkeys/server';
+import { findUserById } from '../../../lib/passkeys/store';
+
+export const POST: APIRoute = async ({ session, url }) => {
+  const authUser = await getAuthUser(session);
+  if (!authUser) return json({ error: 'not_signed_in' }, 401);
+  const s = requireSession(session);
+
+  // Adding a sign-in method is sensitive: require a recent (re)authentication.
+  if (!(await isRecentlyAuthenticated(s))) return json({ error: 'reauth_required' }, 403);
+
+  const user = await findUserById(authUser.userId);
+  if (!user) return json({ error: 'not_signed_in' }, 401);
+
+  const { rpID } = getRelyingParty(url);
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userID: base64urlToBytes(user.userId),
+    userName: user.username,
+    userDisplayName: user.username,
+    attestationType: 'none',
+    // Prevent re-registering a passkey the user already has with the same provider.
+    excludeCredentials: user.passkeys.map((p) => ({ id: p.id, transports: p.transports })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+    },
+    timeout: CHALLENGE_TTL_MS,
+  });
+
+  s.set('passkeyRegistrationChallenge', {
+    challenge: options.challenge,
+    userId: user.userId,
+    expiresAt: Date.now() + CHALLENGE_TTL_MS,
+  });
+
+  return json(options);
+};
