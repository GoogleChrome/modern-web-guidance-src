@@ -0,0 +1,36 @@
+/**
+ * Known authenticator AAGUIDs mapped to human-readable provider names.
+ *
+ * IMPORTANT: AAGUIDs are used exclusively as UX hints (e.g. showing
+ * "Google Password Manager" next to a passkey in the management list).
+ * Platform passkeys do not provide cryptographic attestation for their AAGUID,
+ * so it can be altered by user agents and MUST NOT influence any security or
+ * access decision.
+ */
+const KNOWN_PROVIDERS: Record<string, string> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': 'Google Password Manager',
+  'adce0002-35bc-c60a-648b-0b25f1f05503': 'Chrome on Mac',
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': 'iCloud Keychain',
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': 'iCloud Keychain (Managed)',
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': 'Windows Hello',
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': 'Windows Hello',
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': 'Windows Hello',
+  'bada5566-a7aa-401f-bd96-45619a55120d': '1Password',
+  'd548826e-79b4-db40-a3d8-11116f7e8349': 'Bitwarden',
+  '531126d6-e717-415c-9320-3d9aa6981239': 'Dashlane',
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af': 'NordPass',
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6': 'Keeper',
+  '53414d53-554e-4700-0000-000000000000': 'Samsung Pass',
+  '50726f74-6f6e-5061-7373-50726f746f6e': 'Proton Pass',
+  'f3809540-7f14-49c1-a8b3-8f813b225541': 'Enpass',
+  'fdb141b2-5d84-443e-8a35-4698c205a502': 'KeePassXC',
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a': 'Edge on Mac',
+};
+
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+/** Returns a display name for the passkey provider, or null if unknown. */
+export function providerNameForAaguid(aaguid: string): string | null {
+  if (!aaguid || aaguid === ZERO_AAGUID) return null;
+  return KNOWN_PROVIDERS[aaguid.toLowerCase()] ?? null;
+}
diff --git a/src/lib/passkeys/client.ts b/src/lib/passkeys/client.ts
new file mode 100644
index 0000000..2ce6bfe
--- /dev/null
+++ b/src/lib/passkeys/client.ts
@@ -0,0 +1,407 @@
+/**
+ * Browser-side passkey helpers built directly on the native WebAuthn APIs
+ * (navigator.credentials.create/get, PublicKeyCredential.parse*FromJSON,
+ * PublicKeyCredential.signal*). No third-party client wrapper is used.
+ */
+
+const API_BASE = `${import.meta.env.BASE_URL}api`;
+
+// ---------------------------------------------------------------------------
+// Types (declared locally so we don't depend on a specific lib.dom version)
+// ---------------------------------------------------------------------------
+
+type Base64URL = string;
+
+interface CredentialDescriptorJSON {
+  id: Base64URL;
+  type: 'public-key';
+  transports?: string[];
+}
+
+export interface CreationOptionsJSON {
+  rp: { id?: string; name: string };
+  user: { id: Base64URL; name: string; displayName: string };
+  challenge: Base64URL;
+  pubKeyCredParams: { type: 'public-key'; alg: number }[];
+  timeout?: number;
+  excludeCredentials?: CredentialDescriptorJSON[];
+  authenticatorSelection?: AuthenticatorSelectionCriteria;
+  attestation?: AttestationConveyancePreference;
+  hints?: string[];
+  extensions?: Record<string, unknown>;
+}
+
+export interface RequestOptionsJSON {
+  challenge: Base64URL;
+  timeout?: number;
+  rpId?: string;
+  allowCredentials?: CredentialDescriptorJSON[];
+  userVerification?: UserVerificationRequirement;
+  hints?: string[];
+  extensions?: Record<string, unknown>;
+}
+
+export interface PasskeySummary {
+  id: string;
+  name: string;
+  providerName: string | null;
+  createdAt: string;
+  lastUsedAt: string | null;
+  synced: boolean;
+}
+
+export interface AccountPayload {
+  rpId: string;
+  userId: string;
+  username: string;
+  passkeys: PasskeySummary[];
+}
+
+interface PublicKeyCredentialStatic {
+  parseCreationOptionsFromJSON?: (json: CreationOptionsJSON) => PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON?: (json: RequestOptionsJSON) => PublicKeyCredentialRequestOptions;
+  getClientCapabilities?: () => Promise<Record<string, boolean | undefined>>;
+  isConditionalMediationAvailable?: () => Promise<boolean>;
+  isUserVerifyingPlatformAuthenticatorAvailable?: () => Promise<boolean>;
+  signalUnknownCredential?: (opts: { rpId: string; credentialId: string }) => Promise<void>;
+  signalAllAcceptedCredentials?: (opts: {
+    rpId: string;
+    userId: string;
+    allAcceptedCredentialIds: string[];
+  }) => Promise<void>;
+  signalCurrentUserDetails?: (opts: {
+    rpId: string;
+    userId: string;
+    name: string;
+    displayName: string;
+  }) => Promise<void>;
+}
+
+type CredentialMediation = 'conditional' | 'optional' | 'required' | 'silent';
+
+export class PasskeyError extends Error {
+  constructor(
+    message: string,
+    readonly code: string,
+  ) {
+    super(message);
+    this.name = 'PasskeyError';
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Feature detection
+// ---------------------------------------------------------------------------
+
+function pkc(): PublicKeyCredentialStatic | undefined {
+  if (typeof window === 'undefined' || typeof window.PublicKeyCredential !== 'function') return undefined;
+  return window.PublicKeyCredential as unknown as PublicKeyCredentialStatic;
+}
+
+/** WebAuthn requires a secure context (https:// or http://localhost). */
+export function isPasskeySupported(): boolean {
+  return typeof window !== 'undefined' && window.isSecureContext && !!pkc() && !!navigator.credentials;
+}
+
+export interface PasskeyCapabilities {
+  supported: boolean;
+  conditionalGet: boolean;
+  conditionalCreate: boolean;
+}
+
+export async function getPasskeyCapabilities(): Promise<PasskeyCapabilities> {
+  const PKC = pkc();
+  if (!isPasskeySupported() || !PKC) {
+    return { supported: false, conditionalGet: false, conditionalCreate: false };
+  }
+  if (PKC.getClientCapabilities) {
+    try {
+      const caps = await PKC.getClientCapabilities();
+      return {
+        supported: true,
+        conditionalGet: !!caps.conditionalGet,
+        conditionalCreate: !!caps.conditionalCreate,
+      };
+    } catch {
+      // Fall through to legacy detection.
+    }
+  }
+  let conditionalGet = false;
+  try {
+    conditionalGet = (await PKC.isConditionalMediationAvailable?.()) ?? false;
+  } catch {
+    conditionalGet = false;
+  }
+  return { supported: true, conditionalGet, conditionalCreate: false };
+}
+
+// ---------------------------------------------------------------------------
+// Encoding helpers (fallback for browsers without parse*FromJSON / toJSON)
+// ---------------------------------------------------------------------------
+
+function b64urlToBuffer(value: string): ArrayBuffer {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
+  return bytes.buffer;
+}
+
+function bufferToB64url(buffer: ArrayBuffer | ArrayBufferView): string {
+  const bytes =
+    buffer instanceof ArrayBuffer ? new Uint8Array(buffer) : new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength);
+  let binary = '';
+  for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function descriptors(list?: CredentialDescriptorJSON[]): PublicKeyCredentialDescriptor[] | undefined {
+  return list?.map((d) => ({
+    id: b64urlToBuffer(d.id),
+    type: d.type,
+    transports: d.transports as AuthenticatorTransport[] | undefined,
+  }));
+}
+
+function parseCreationOptions(json: CreationOptionsJSON): PublicKeyCredentialCreationOptions {
+  const PKC = pkc();
+  if (PKC?.parseCreationOptionsFromJSON) return PKC.parseCreationOptionsFromJSON(json);
+  return {
+    ...json,
+    challenge: b64urlToBuffer(json.challenge),
+    user: { ...json.user, id: b64urlToBuffer(json.user.id) },
+    excludeCredentials: descriptors(json.excludeCredentials),
+  } as PublicKeyCredentialCreationOptions;
+}
+
+function parseRequestOptions(json: RequestOptionsJSON): PublicKeyCredentialRequestOptions {
+  const PKC = pkc();
+  if (PKC?.parseRequestOptionsFromJSON) return PKC.parseRequestOptionsFromJSON(json);
+  return {
+    ...json,
+    challenge: b64urlToBuffer(json.challenge),
+    allowCredentials: descriptors(json.allowCredentials),
+  } as PublicKeyCredentialRequestOptions;
+}
+
+function credentialToJSON(credential: PublicKeyCredential): unknown {
+  const withToJSON = credential as PublicKeyCredential & { toJSON?: () => unknown };
+  if (typeof withToJSON.toJSON === 'function') {
+    try {
+      return withToJSON.toJSON();
+    } catch {
+      // Fall back to manual serialization below.
+    }
+  }
+
+  const response = credential.response;
+  const base = {
+    id: credential.id,
+    rawId: bufferToB64url(credential.rawId),
+    type: credential.type,
+    authenticatorAttachment: credential.authenticatorAttachment ?? undefined,
+    clientExtensionResults: credential.getClientExtensionResults(),
+  };
+
+  if ('attestationObject' in response) {
+    const att = response as AuthenticatorAttestationResponse;
+    return {
+      ...base,
+      response: {
+        clientDataJSON: bufferToB64url(att.clientDataJSON),
+        attestationObject: bufferToB64url(att.attestationObject),
+        transports: typeof att.getTransports === 'function' ? att.getTransports() : undefined,
+      },
+    };
+  }
+
+  const assertion = response as AuthenticatorAssertionResponse;
+  return {
+    ...base,
+    response: {
+      clientDataJSON: bufferToB64url(assertion.clientDataJSON),
+      authenticatorData: bufferToB64url(assertion.authenticatorData),
+      signature: bufferToB64url(assertion.signature),
+      userHandle: assertion.userHandle ? bufferToB64url(assertion.userHandle) : undefined,
+    },
+  };
+}
+
+// ---------------------------------------------------------------------------
+// API
+// ---------------------------------------------------------------------------
+
+export async function apiRequest<T>(path: string, init?: { method?: string; body?: unknown }): Promise<T> {
+  const response = await fetch(`${API_BASE}${path}`, {
+    method: init?.method ?? 'GET',
+    headers: init?.body !== undefined ? { 'Content-Type': 'application/json' } : undefined,
+    body: init?.body !== undefined ? JSON.stringify(init.body) : undefined,
+    credentials: 'same-origin',
+  });
+  let data: unknown = null;
+  try {
+    data = await response.json();
+  } catch {
+    data = null;
+  }
+  if (!response.ok) {
+    const record = (data ?? {}) as { error?: unknown; rpId?: unknown; credentialId?: unknown };
+    const code = typeof record.error === 'string' ? record.error : 'request_failed';
+    const error = new PasskeyError(code, code) as PasskeyError & { details?: typeof record };
+    error.details = record;
+    throw error;
+  }
+  return data as T;
+}
+
+function isDomException(err: unknown, ...names: string[]): boolean {
+  return err instanceof DOMException && names.includes(err.name);
+}
+
+/** True for user cancellation / aborts, which should be handled silently. */
+export function isCancellation(err: unknown): boolean {
+  return isDomException(err, 'NotAllowedError', 'AbortError');
+}
+
+// ---------------------------------------------------------------------------
+// Signal API (keep password managers in sync with the server)
+// ---------------------------------------------------------------------------
+
+export async function signalAccountState(account: AccountPayload): Promise<void> {
+  const PKC = pkc();
+  if (!PKC) return;
+  const tasks: Promise<void>[] = [];
+  if (PKC.signalAllAcceptedCredentials) {
+    tasks.push(
+      PKC.signalAllAcceptedCredentials({
+        rpId: account.rpId,
+        userId: account.userId,
+        allAcceptedCredentialIds: account.passkeys.map((p) => p.id),
+      }),
+    );
+  }
+  if (PKC.signalCurrentUserDetails) {
+    tasks.push(
+      PKC.signalCurrentUserDetails({
+        rpId: account.rpId,
+        userId: account.userId,
+        name: account.username,
+        displayName: account.username,
+      }),
+    );
+  }
+  await Promise.allSettled(tasks);
+}
+
+async function signalUnknown(rpId: string, credentialId: string): Promise<void> {
+  const PKC = pkc();
+  if (!PKC?.signalUnknownCredential) return;
+  try {
+    await PKC.signalUnknownCredential({ rpId, credentialId });
+  } catch {
+    // Best effort.
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Registration
+// ---------------------------------------------------------------------------
+
+/**
+ * Creates a passkey for the signed-in user.
+ * `conditional: true` performs a conditional create (silent upgrade right after
+ * a password sign-in); the browser only creates it if a password was just used.
+ */
+export async function registerPasskey(opts: { conditional?: boolean; signal?: AbortSignal } = {}): Promise<AccountPayload> {
+  const optionsJSON = await apiRequest<CreationOptionsJSON>('/passkeys/registration-options', {
+    method: 'POST',
+    body: {},
+  });
+
+  let credential: Credential | null;
+  try {
+    credential = await navigator.credentials.create({
+      publicKey: parseCreationOptions(optionsJSON),
+      signal: opts.signal,
+      ...(opts.conditional ? { mediation: 'conditional' as CredentialMediation } : {}),
+    } as CredentialCreationOptions);
+  } catch (err) {
+    if (isDomException(err, 'InvalidStateError')) {
+      throw new PasskeyError('A passkey for this account already exists in this password manager.', 'already_registered');
+    }
+    throw err;
+  }
+  if (!(credential instanceof PublicKeyCredential)) {
+    throw new PasskeyError('Passkey creation was not completed.', 'no_credential');
+  }
+
+  const account = await apiRequest<AccountPayload>('/passkeys/register', {
+    method: 'POST',
+    body: { credential: credentialToJSON(credential) },
+  });
+  void signalAccountState(account);
+  return account;
+}
+
+// ---------------------------------------------------------------------------
+// Authentication / reauthentication
+// ---------------------------------------------------------------------------
+
+export async function authenticateWithPasskey(opts: {
+  purpose: 'signin' | 'reauth';
+  mediation?: 'conditional' | 'optional';
+  signal?: AbortSignal;
+}): Promise<AccountPayload> {
+  const optionsJSON = await apiRequest<RequestOptionsJSON>('/passkeys/authentication-options', {
+    method: 'POST',
+    body: { purpose: opts.purpose },
+  });
+
+  const credential = await navigator.credentials.get({
+    publicKey: parseRequestOptions(optionsJSON),
+    signal: opts.signal,
+    ...(opts.mediation === 'conditional' ? { mediation: 'conditional' as CredentialMediation } : {}),
+  } as CredentialRequestOptions);
+  if (!(credential instanceof PublicKeyCredential)) {
+    throw new PasskeyError('Passkey sign-in was not completed.', 'no_credential');
+  }
+
+  try {
+    const account = await apiRequest<AccountPayload>('/passkeys/authenticate', {
+      method: 'POST',
+      body: { credential: credentialToJSON(credential) },
+    });
+    void signalAccountState(account);
+    return account;
+  } catch (err) {
+    if (err instanceof PasskeyError && err.code === 'unknown_credential') {
+      const details = (err as PasskeyError & { details?: { rpId?: unknown } }).details;
+      const rpId = typeof details?.rpId === 'string' ? details.rpId : (optionsJSON.rpId ?? location.hostname);
+      await signalUnknown(rpId, credential.id);
+      throw new PasskeyError(
+        'This passkey is no longer registered with The DevTools Times. It has been removed from your password manager where supported. Please sign in another way.',
+        'unknown_credential',
+      );
+    }
+    throw err;
+  }
+}
+
+/** Human-friendly message for an error thrown by the helpers above. */
+export function describePasskeyError(err: unknown): string {
+  if (err instanceof PasskeyError) {
+    switch (err.code) {
+      case 'reauth_required':
+        return 'Please confirm it’s you to continue.';
+      case 'not_signed_in':
+        return 'Your session has expired. Please sign in again.';
+      default:
+        return err.message;
+    }
+  }
+  if (isDomException(err, 'SecurityError')) {
+    return 'Passkeys are not available on this domain.';
+  }
+  if (err instanceof Error && err.message) return err.message;
+  return 'Something went wrong with your passkey. Please try again.';
+}
diff --git a/src/lib/passkeys/password.ts b/src/lib/passkeys/password.ts
new file mode 100644
index 0000000..bbf577b
--- /dev/null
+++ b/src/lib/passkeys/password.ts
@@ -0,0 +1,47 @@
+import { EXTERNAL_AUTH_BASE } from './server';
+
+export interface UpstreamResult {
+  ok: boolean;
+  status: number;
+  error?: string;
+}
+
+/**
+ * Forwards username/password to the existing external account service.
+ * The server proxies these calls so that a successful result can establish a
+ * first-party session that passkeys can then be bound to.
+ */
+export async function callPasswordService(
+  action: 'login' | 'register',
+  username: string,
+  password: string,
+): Promise<UpstreamResult> {
+  try {
+    const response = await fetch(`${EXTERNAL_AUTH_BASE}/${action}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password }),
+    });
+    let data: { error?: unknown } = {};
+    try {
+      data = (await response.json()) as { error?: unknown };
+    } catch {
+      // Non-JSON body; fall through with empty data.
+    }
+    return {
+      ok: response.ok,
+      status: response.status,
+      error: typeof data.error === 'string' ? data.error : undefined,
+    };
+  } catch {
+    return { ok: false, status: 502, error: 'Upstream service unavailable' };
+  }
+}
+
+export function parseCredentials(body: unknown): { username: string; password: string } | null {
+  if (!body || typeof body !== 'object') return null;
+  const { username, password } = body as Record<string, unknown>;
+  if (typeof username !== 'string' || typeof password !== 'string') return null;
+  if (!username.trim() || !password) return null;
+  return { username: username.trim(), password };
+}
diff --git a/src/lib/passkeys/server.ts b/src/lib/passkeys/server.ts
new file mode 100644
index 0000000..dafec60
--- /dev/null
+++ b/src/lib/passkeys/server.ts
@@ -0,0 +1,121 @@
+import type { AstroSession } from 'astro';
+import { providerNameForAaguid } from './aaguid';
+import type { StoredPasskey, StoredUser } from './store';
+
+export const RP_NAME = 'The DevTools Times';
+/** How long a WebAuthn challenge stays valid. */
+export const CHALLENGE_TTL_MS = 5 * 60 * 1000;
+/** Sensitive actions (deleting passkeys) require authentication within this window. */
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export const EXTERNAL_AUTH_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+type Session = AstroSession;
+
+/**
+ * Relying Party configuration derived from the request.
+ *
+ * The RP ID must equal (or be a registrable suffix of) the page's hostname;
+ * otherwise browsers throw a SecurityError. It can be pinned with
+ * PASSKEY_RP_ID / PASSKEY_ORIGIN for deployments behind proxies.
+ */
+export function getRelyingParty(url: URL): { rpID: string; origins: string[] } {
+  const rpID = process.env.PASSKEY_RP_ID || url.hostname;
+  const origins = new Set<string>();
+  if (process.env.PASSKEY_ORIGIN) {
+    for (const origin of process.env.PASSKEY_ORIGIN.split(',')) {
+      if (origin.trim()) origins.add(origin.trim());
+    }
+  } else {
+    origins.add(url.origin);
+  }
+  return { rpID, origins: [...origins] };
+}
+
+export function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+  });
+}
+
+export function requireSession(session: AstroSession | undefined): Session {
+  if (!session) throw new Error('Sessions are not configured');
+  return session;
+}
+
+export async function getAuthUser(
+  session: AstroSession | undefined,
+): Promise<{ userId: string; username: string } | undefined> {
+  return (await session?.get('authUser')) ?? undefined;
+}
+
+/** Establishes a signed-in session, rotating the session ID to prevent fixation. */
+export async function signIn(session: Session, user: { userId: string; username: string }): Promise<void> {
+  await session.regenerate();
+  session.set('authUser', { userId: user.userId, username: user.username });
+  session.set('authenticatedAt', Date.now());
+}
+
+export function markReauthenticated(session: Session): void {
+  session.set('authenticatedAt', Date.now());
+}
+
+export async function isRecentlyAuthenticated(session: Session): Promise<boolean> {
+  const at = await session.get('authenticatedAt');
+  return typeof at === 'number' && Date.now() - at < REAUTH_WINDOW_MS;
+}
+
+export function base64urlToBytes(value: string): Uint8Array<ArrayBuffer> {
+  const buf = Buffer.from(value, 'base64url');
+  const out = new Uint8Array(new ArrayBuffer(buf.length));
+  out.set(buf);
+  return out;
+}
+
+export function bytesToBase64url(value: Uint8Array): string {
+  return Buffer.from(value).toString('base64url');
+}
+
+export interface PasskeySummary {
+  id: string;
+  name: string;
+  /** Provider name derived from AAGUID — UX hint only. */
+  providerName: string | null;
+  createdAt: string;
+  lastUsedAt: string | null;
+  synced: boolean;
+}
+
+export function summarizePasskey(passkey: StoredPasskey): PasskeySummary {
+  return {
+    id: passkey.id,
+    name: passkey.name,
+    providerName: providerNameForAaguid(passkey.aaguid),
+    createdAt: passkey.createdAt,
+    lastUsedAt: passkey.lastUsedAt,
+    synced: passkey.backedUp,
+  };
+}
+
+/** Payload consumed by the client for the management list and Signal API calls. */
+export function accountPayload(user: StoredUser, rpID: string) {
+  return {
+    rpId: rpID,
+    userId: user.userId,
+    username: user.username,
+    passkeys: user.passkeys.map(summarizePasskey),
+  };
+}
+
+export function defaultPasskeyName(aaguid: string): string {
+  return providerNameForAaguid(aaguid) ?? 'Passkey';
+}
+
+export async function readJson<T>(request: Request): Promise<T | null> {
+  try {
+    return (await request.json()) as T;
+  } catch {
+    return null;
+  }
+}
diff --git a/src/lib/passkeys/store.ts b/src/lib/passkeys/store.ts
new file mode 100644
index 0000000..9ec93bb
--- /dev/null
+++ b/src/lib/passkeys/store.ts
@@ -0,0 +1,171 @@
+import { randomBytes } from 'node:crypto';
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+
+/**
+ * Minimal persistent store for passkey users and credentials.
+ *
+ * Data is kept in a JSON file (configurable via PASSKEY_STORE_PATH). Writes are
+ * serialized and atomic (write to temp file + rename) so concurrent requests
+ * cannot corrupt the file.
+ */
+
+export interface StoredPasskey {
+  /** Credential ID (base64url). */
+  id: string;
+  /** COSE public key (base64url). */
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  /**
+   * Authenticator AAGUID. Used ONLY for UX hints (provider name in the
+   * management list). Never used for security or access decisions.
+   */
+  aaguid: string;
+  /** User-editable label. */
+  name: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  createdAt: string;
+  lastUsedAt: string | null;
+}
+
+export interface StoredUser {
+  /** WebAuthn user handle (base64url of 32 random bytes). Contains no PII. */
+  userId: string;
+  username: string;
+  passkeys: StoredPasskey[];
+}
+
+interface StoreData {
+  users: StoredUser[];
+}
+
+const STORE_PATH = resolve(process.env.PASSKEY_STORE_PATH ?? '.data/passkeys.json');
+
+let cache: StoreData | null = null;
+let writeQueue: Promise<void> = Promise.resolve();
+
+async function load(): Promise<StoreData> {
+  if (cache) return cache;
+  try {
+    const raw = await readFile(STORE_PATH, 'utf8');
+    const parsed = JSON.parse(raw) as Partial<StoreData>;
+    cache = { users: Array.isArray(parsed.users) ? parsed.users : [] };
+  } catch {
+    cache = { users: [] };
+  }
+  return cache;
+}
+
+async function persist(data: StoreData): Promise<void> {
+  await mkdir(dirname(STORE_PATH), { recursive: true });
+  const tmp = `${STORE_PATH}.${process.pid}.tmp`;
+  await writeFile(tmp, JSON.stringify(data, null, 2), 'utf8');
+  await rename(tmp, STORE_PATH);
+}
+
+/** Run a mutation exclusively and persist the result. */
+async function mutate<T>(fn: (data: StoreData) => T): Promise<T> {
+  let result!: T;
+  const run = writeQueue.then(async () => {
+    const data = await load();
+    result = fn(data);
+    await persist(data);
+  });
+  writeQueue = run.catch(() => undefined);
+  await run;
+  return result;
+}
+
+function normalize(username: string): string {
+  return username.trim().toLowerCase();
+}
+
+export async function findUserByUsername(username: string): Promise<StoredUser | undefined> {
+  const data = await load();
+  const key = normalize(username);
+  return data.users.find((u) => normalize(u.username) === key);
+}
+
+export async function findUserById(userId: string): Promise<StoredUser | undefined> {
+  const data = await load();
+  return data.users.find((u) => u.userId === userId);
+}
+
+export async function findUserByCredentialId(
+  credentialId: string,
+): Promise<{ user: StoredUser; passkey: StoredPasskey } | undefined> {
+  const data = await load();
+  for (const user of data.users) {
+    const passkey = user.passkeys.find((p) => p.id === credentialId);
+    if (passkey) return { user, passkey };
+  }
+  return undefined;
+}
+
+/** Returns the existing user record for this username, creating one if needed. */
+export async function ensureUser(username: string): Promise<StoredUser> {
+  return mutate((data) => {
+    const key = normalize(username);
+    let user = data.users.find((u) => normalize(u.username) === key);
+    if (!user) {
+      user = {
+        userId: randomBytes(32).toString('base64url'),
+        username: username.trim(),
+        passkeys: [],
+      };
+      data.users.push(user);
+    }
+    return user;
+  });
+}
+
+export async function addPasskey(userId: string, passkey: StoredPasskey): Promise<void> {
+  await mutate((data) => {
+    const user = data.users.find((u) => u.userId === userId);
+    if (!user) throw new Error('User not found');
+    if (data.users.some((u) => u.passkeys.some((p) => p.id === passkey.id))) {
+      throw new Error('Credential already registered');
+    }
+    user.passkeys.push(passkey);
+  });
+}
+
+export async function updatePasskeyUsage(
+  userId: string,
+  credentialId: string,
+  update: { counter: number; backedUp: boolean; deviceType: StoredPasskey['deviceType'] },
+): Promise<void> {
+  await mutate((data) => {
+    const passkey = data.users
+      .find((u) => u.userId === userId)
+      ?.passkeys.find((p) => p.id === credentialId);
+    if (!passkey) return;
+    passkey.counter = update.counter;
+    passkey.backedUp = update.backedUp;
+    passkey.deviceType = update.deviceType;
+    passkey.lastUsedAt = new Date().toISOString();
+  });
+}
+
+export async function renamePasskey(userId: string, credentialId: string, name: string): Promise<boolean> {
+  return mutate((data) => {
+    const passkey = data.users
+      .find((u) => u.userId === userId)
+      ?.passkeys.find((p) => p.id === credentialId);
+    if (!passkey) return false;
+    passkey.name = name;
+    return true;
+  });
+}
+
+export async function deletePasskey(userId: string, credentialId: string): Promise<boolean> {
+  return mutate((data) => {
+    const user = data.users.find((u) => u.userId === userId);
+    if (!user) return false;
+    const before = user.passkeys.length;
+    user.passkeys = user.passkeys.filter((p) => p.id !== credentialId);
+    return user.passkeys.length !== before;
+  });
+}
diff --git a/src/pages/account.astro b/src/pages/account.astro
