@@ -0,0 +1,22 @@
+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import { accountPayload, getAuthUser, getRelyingParty } from '../lib/passkeys/server';
+import { findUserById } from '../lib/passkeys/store';
+
+const baseUrl = import.meta.env.BASE_URL;
+const authUser = await getAuthUser(Astro.session);
+const user = authUser ? await findUserById(authUser.userId) : undefined;
+if (!user) {
+  return Astro.redirect(`${baseUrl}signin`);
+}
+
+Astro.response.headers.set('Cache-Control', 'no-store');
+const account = accountPayload(user, getRelyingParty(Astro.url).rpID);
+---
+
+<Layout title="Account Settings | The DevTools Times">
+  <div class="py-12 px-4 sm:px-6 lg:px-8">
+    <AccountSettings client:load initialAccount={account} />
+  </div>
+</Layout>
