diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..41adee5
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,113 @@
+import { useEffect, useRef, useState } from 'react';
+import { authRequest, authenticatePasskey, registerPasskey, registrationAvailable, passkeysSupported, passkeyError, syncPasskeys, syncUser, type Passkey, type Session } from '../utils/passkeys';
+
+const button = 'px-4 py-2 border rounded-md disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2';
+
+export default function AccountSettings({ session }: { session: Session }) {
+  const [user, setUser] = useState(session.user);
+  const [keys, setKeys] = useState<Passkey[] | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [canRegister, setCanRegister] = useState(false);
+  const [message, setMessage] = useState('');
+  const [error, setError] = useState('');
+  const [removing, setRemoving] = useState<string | null>(null);
+  const [password, setPassword] = useState('');
+  const locked = useRef(false);
+  const [controller] = useState(() => new AbortController());
+
+  async function refresh() {
+    const result = await authRequest<{ passkeys: Passkey[] }>('passkeys', undefined, 'GET', controller.signal);
+    setKeys(result.passkeys);
+    await syncPasskeys(user, result.passkeys).catch(() => {});
+  }
+  useEffect(() => {
+    void registrationAvailable().then(available => { if (!controller.signal.aborted) setCanRegister(available); });
+    void refresh().catch(error => { if (!controller.signal.aborted) setError(passkeyError(error)); });
+    return () => controller.abort();
+  }, []);
+
+  async function action(work: () => Promise<void>, success: string) {
+    if (locked.current) return;
+    locked.current = true;
+    setBusy(true); setError(''); setMessage('');
+    try { await work(); await refresh(); setMessage(success); }
+    catch (error) { if (!controller.signal.aborted) setError(passkeyError(error)); }
+    finally { locked.current = false; setBusy(false); }
+  }
+
+  async function verify() {
+    if (password) {
+      const currentPassword = password;
+      setPassword('');
+      await authRequest('passkeys/reauthentication/password', { password: currentPassword }, 'POST', controller.signal);
+    } else await authenticatePasskey(controller.signal, false, true);
+  }
+
+  return <section aria-labelledby="account-settings" className="space-y-4">
+    <h2 id="account-settings" className="text-2xl font-bold">Account settings</h2>
+    <p>Signed in as {user.username}</p>
+    <h3 className="text-xl font-semibold">Passkeys</h3>
+    <p className="text-sm text-gray-600">Use your fingerprint, face, screen lock, or security key to sign in. Your biometric information stays on your device.</p>
+    {error && <p role="alert" className="text-red-700">{error}</p>}
+    <p role="status">{message}</p>
+    <label className="block text-sm" htmlFor="verification-password">To verify with your password instead of a passkey, enter it here.</label>
+    <input id="verification-password" type="password" autoComplete="current-password" value={password} onChange={event => setPassword(event.target.value)} disabled={busy} className="border rounded-md px-3 py-2 w-full" />
+    <form className="space-y-2" onSubmit={event => {
+      event.preventDefault();
+      const fields = new FormData(event.currentTarget);
+      const username = String(fields.get('username') ?? '').trim();
+      const displayName = String(fields.get('displayName') ?? '').trim();
+      if (!username || !displayName) return;
+      void action(async () => {
+        await verify();
+        const updated = await authRequest<Session>('account', { username, displayName }, 'PATCH', controller.signal);
+        setUser(updated.user);
+        await syncUser(updated.user);
+      }, 'Account details updated.');
+    }}>
+      <label className="block" htmlFor="account-username">Username</label>
+      <input id="account-username" name="username" autoComplete="username" defaultValue={user.username} required maxLength={80} disabled={busy} className="border rounded-md px-3 py-2 w-full" />
+      <label className="block" htmlFor="display-name">Display name</label>
+      <input id="display-name" name="displayName" defaultValue={user.displayName} required maxLength={80} disabled={busy} className="border rounded-md px-3 py-2 w-full" />
+      <button className={button} disabled={busy}>Save account details</button>
+    </form>
+    {!passkeysSupported() && <p>Passkeys require a supported browser and HTTPS (or localhost). You can still sign in with your password.</p>}
+    <button type="button" className={button} disabled={busy || !canRegister} onClick={() => void action(async () => {
+      await verify();
+      await registerPasskey(controller.signal);
+    }, 'Passkey added.')}>Add a passkey</button>
+    {keys === null ? <p>Passkey list unavailable.</p> : keys.length === 0 ? <p>No passkeys registered.</p> : <ul className="space-y-4">
+      {keys.map(key => <li key={key.id} className="border rounded-md p-3 space-y-2">
+        <p className="font-semibold">{key.name}</p>
+        {key.provider && <p className="text-sm">{key.provider}</p>}
+        <p className="text-sm">Created: {new Date(key.createdAt).toLocaleDateString()}{key.lastUsedAt ? ` · Last used: ${new Date(key.lastUsedAt).toLocaleDateString()}` : ''}</p>
+        <form className="flex flex-wrap gap-2" onSubmit={event => {
+          event.preventDefault();
+          const name = String(new FormData(event.currentTarget).get('name') ?? '').trim();
+          if (name) void action(async () => {
+            await verify();
+            await authRequest(`passkeys/${encodeURIComponent(key.id)}`, { name }, 'PATCH', controller.signal);
+          }, 'Passkey renamed.');
+        }}>
+          <label className="sr-only" htmlFor={`name-${key.id}`}>Name for {key.name}</label>
+          <input id={`name-${key.id}`} name="name" defaultValue={key.name} required maxLength={80} disabled={busy} className="border rounded-md px-2 min-w-0" />
+          <button className={button} disabled={busy}>Rename</button>
+          <button type="button" className={button} disabled={busy} onClick={() => setRemoving(key.id)}>Remove</button>
+        </form>
+        {removing === key.id && <div className="space-y-2">
+          <p>Remove “{key.name}”? Keep another passkey or password so you can sign in again. You may also need to delete this passkey from your password manager.</p>
+          <button type="button" className={button} disabled={busy} onClick={() => void action(async () => {
+            await verify();
+            await authRequest(`passkeys/${encodeURIComponent(key.id)}`, undefined, 'DELETE', controller.signal);
+            setRemoving(null);
+          }, 'Passkey removed.')}>Confirm removal</button>
+          <button type="button" className={button} disabled={busy} onClick={() => setRemoving(null)}>Cancel</button>
+        </div>}
+      </li>)}
+    </ul>}
+    <button type="button" className={button} disabled={busy || !passkeysSupported()} onClick={() => void action(async () => {
+      await authenticatePasskey(controller.signal, false, true);
+    }, 'Identity verified.')}>Verify identity with a passkey</button>
+    {busy && <p role="status">Follow the instructions from your browser…</p>}
+  </section>;
+}
diff --git a/src/components/AuthForm.tsx b/src/components/AuthForm.tsx
new file mode 100644
index 0000000..7b13948
--- /dev/null
+++ b/src/components/AuthForm.tsx
@@ -0,0 +1,101 @@
+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import AccountSettings from './AccountSettings';
+import { authRequest, authenticatePasskey, registerPasskey, conditionalAvailable, conditionalCreate, registrationAvailable, passkeysSupported, passkeyError, type Session } from '../utils/passkeys';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [session, setSession] = useState<Session | null>(null);
+  const [supported, setSupported] = useState(false);
+  const [canRegister, setCanRegister] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [autofillAttempt, setAutofillAttempt] = useState(0);
+  const active = useRef<AbortController | null>(null);
+  const locked = useRef(false);
+
+  useEffect(() => {
+    setSupported(passkeysSupported());
+    const controller = new AbortController();
+    active.current = controller;
+    void registrationAvailable().then(available => { if (!controller.signal.aborted) setCanRegister(available); });
+    void (async () => {
+      try {
+        const current = await authRequest<Session>('session', undefined, 'GET', controller.signal);
+        if (current?.user && !controller.signal.aborted) { setSession(current); return; }
+      } catch { /* A signed-out visitor can still use either sign-in method. */ }
+      if (!signup && !controller.signal.aborted && await conditionalAvailable()) {
+        if (controller.signal.aborted) return;
+        try {
+          const result = await authenticatePasskey(controller.signal, true);
+          if (!controller.signal.aborted) setSession(result);
+        } catch { /* Autofill is optional; explicit sign-in remains available. */ }
+      }
+    })();
+    return () => { controller.abort(); active.current?.abort(); };
+  }, [signup, autofillAttempt]);
+
+  async function run(work: (signal: AbortSignal) => Promise<void>) {
+    if (locked.current) return;
+    locked.current = true;
+    active.current?.abort();
+    const controller = new AbortController(); active.current = controller;
+    setBusy(true); setError(''); setMessage('');
+    try { await work(controller.signal); }
+    catch (error) {
+      if (!controller.signal.aborted) {
+        setError(passkeyError(error));
+        if (!signup) setAutofillAttempt(attempt => attempt + 1);
+      }
+    }
+    finally { locked.current = false; setBusy(false); }
+  }
+
+  function passwordSubmit(event: FormEvent) {
+    event.preventDefault();
+    void run(async signal => {
+      await authRequest(signup ? 'register' : 'login', { username, password }, 'POST', signal);
+      setPassword('');
+      if (signup) setMessage('Account created. Sign in to add a passkey in account settings.');
+      else {
+        setMessage('Signed in successfully.');
+        const current = await authRequest<Session>('session', undefined, 'GET', signal).catch(() => null);
+        if (current?.user) {
+          await conditionalCreate(signal).catch(() => {});
+          if (!signal.aborted) setSession(current);
+        }
+      }
+    });
+  }
+
+  const button = 'w-full py-2 px-4 border rounded-md font-medium disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2';
+  return <div className="max-w-md mx-auto mt-10 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+    {session ? <AccountSettings session={session} /> : <>
+      <h2 className="text-2xl font-bold mb-6 text-center">{signup ? 'Sign Up' : 'Sign In'}</h2>
+      {error && <p role="alert" className="mb-4 text-red-700">{error}</p>}
+      <p role="status" className="mb-4 text-green-700">{message}</p>
+      <form onSubmit={passwordSubmit} className="space-y-4">
+        <div>
+          <label htmlFor="username" className="block text-sm font-medium mb-1">Username</label>
+          <input id="username" name="username" autoComplete={signup ? 'username' : 'username webauthn'} value={username} onChange={event => setUsername(event.target.value)} required disabled={busy} className="w-full px-3 py-2 border rounded-md" />
+        </div>
+        <div>
+          <label htmlFor="password" className="block text-sm font-medium mb-1">Password</label>
+          <input id="password" name="password" type="password" autoComplete={signup ? 'new-password' : 'current-password'} value={password} onChange={event => setPassword(event.target.value)} required minLength={signup ? 8 : undefined} pattern={signup ? '(?=.*[0-9]).{8,}' : undefined} disabled={busy} className="w-full px-3 py-2 border rounded-md" />
+          {signup && <p className="text-xs text-gray-500 mt-1">Must be at least 8 characters and contain a number.</p>}
+        </div>
+        <button className={`${button} bg-gray-900 text-white`} disabled={busy} data-skip-tracking="true">{busy ? 'Please wait…' : signup ? 'Sign Up' : 'Sign In'}</button>
+        <button type="button" className={button} disabled={busy || !supported || (signup && !canRegister)} data-skip-tracking="true" onClick={() => {
+          if (signup && !username.trim()) { setError('Enter a username to create your passkey account.'); return; }
+          void run(async signal => {
+            const result = signup ? await registerPasskey(signal, username.trim()) : await authenticatePasskey(signal);
+            if (!signal.aborted) { setPassword(''); setSession(result); }
+          });
+        }}>{signup ? 'Create account with a passkey' : 'Sign in with a passkey'}</button>
+      </form>
+      <p className="mt-4 text-sm text-gray-600">{supported ? 'Passkeys let you use your fingerprint, face, screen lock, or security key instead of a password.' : 'Passkeys need HTTPS (or localhost) and a supported browser. You can use your password here.'}</p>
+      {!signup && <p className="mt-4 text-sm">Sign in to manage your passkeys in account settings.</p>}
+    </>}
+  </div>;
+}
