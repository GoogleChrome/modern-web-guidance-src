@@ -0,0 +1,200 @@
+import 'webauthn-polyfills';
+
+// This application uses the existing Times authentication service. Challenges,
+// signature verification and account authorization always belong to that service.
+const API = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export interface Account {
+  id: string; // WebAuthn user handle, encoded as base64url by the server.
+  username: string;
+  displayName: string;
+  rpId: string;
+}
+export interface Passkey {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt?: string;
+  provider?: string; // Display hint only; never used for authorization.
+}
+export interface Session {
+  user: Account;
+}
+interface NativePasskeys {
+  parseCreationOptionsFromJSON?: (json: unknown) => PublicKeyCredentialCreationOptions;
+  parseRequestOptionsFromJSON?: (json: unknown) => PublicKeyCredentialRequestOptions;
+  isConditionalMediationAvailable?: () => Promise<boolean>;
+  getClientCapabilities?: () => Promise<Record<string, boolean>>;
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+}
+const native = () => PublicKeyCredential as unknown as NativePasskeys;
+
+export function passkeysSupported() {
+  return typeof window !== 'undefined' && window.isSecureContext && typeof PublicKeyCredential !== 'undefined' &&
+    !!navigator.credentials && !!native().parseCreationOptionsFromJSON &&
+    !!native().parseRequestOptionsFromJSON;
+}
+
+export class AuthError extends Error {
+  constructor(message: string, public code?: string, public status?: number) { super(message); }
+}
+
+export async function authRequest<T>(path: string, body?: unknown, method = 'POST', signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${API}/${path}`, {
+    method, credentials: 'include', cache: 'no-store', signal,
+    headers: { 'Content-Type': 'application/json' },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  const data: unknown = await response.json().catch(() => null);
+  if (!response.ok) {
+    const code = data && typeof data === 'object' && 'code' in data && typeof data.code === 'string' ? data.code : undefined;
+    throw new AuthError(response.status === 401 ? 'Please sign in again.' :
+      response.status === 404 || response.status === 501 ? 'Passkeys are not available from the sign-in service yet. You can still use your password.' :
+        'The sign-in service could not complete this request. Please try again.', code, response.status);
+  }
+  if (path === 'session' || path === 'account' || path.endsWith('/verify')) {
+    if (!data || typeof data !== 'object' || !('user' in data) ||
+      !data.user || typeof data.user !== 'object' ||
+      !['id', 'username', 'displayName', 'rpId'].every(field =>
+        typeof (data.user as Record<string, unknown>)[field] === 'string')) {
+      throw new AuthError('The sign-in service returned an invalid account response. Please try again.');
+    }
+  }
+  if (path === 'passkeys') {
+    if (!data || typeof data !== 'object' || !('passkeys' in data) || !Array.isArray(data.passkeys) ||
+      !data.passkeys.every((key: unknown) => key && typeof key === 'object' &&
+        'id' in key && typeof key.id === 'string' && /^[A-Za-z0-9_-]+$/.test(key.id) &&
+        'name' in key && typeof key.name === 'string' &&
+        'createdAt' in key && typeof key.createdAt === 'string')) {
+      throw new AuthError('The passkey list could not be loaded. Please try again.');
+    }
+  }
+  return data as T;
+}
+
+export function passkeyError(error: unknown): string {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was canceled or timed out. Try again or use your password.';
+    if (error.name === 'InvalidStateError') return 'This passkey is already registered. Try another device or password manager.';
+    if (error.name === 'SecurityError') return 'Passkeys require a secure connection and a matching website domain.';
+  }
+  return error instanceof AuthError ? error.message : 'Could not complete the passkey request. Please try again.';
+}
+
+function checkRP(rpId: string) {
+  if (!rpId || !(location.hostname === rpId || location.hostname.endsWith(`.${rpId}`))) {
+    throw new DOMException('Invalid relying party domain', 'SecurityError');
+  }
+}
+
+function encode(buffer: ArrayBuffer): string {
+  let binary = '';
+  for (const byte of new Uint8Array(buffer)) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function serialize(credential: PublicKeyCredential) {
+  const jsonCredential = credential as PublicKeyCredential & { toJSON?: () => unknown };
+  if (jsonCredential.toJSON) return jsonCredential.toJSON();
+  const response = credential.response;
+  const common = {
+    id: credential.id, rawId: encode(credential.rawId), type: credential.type,
+    authenticatorAttachment: credential.authenticatorAttachment,
+    clientExtensionResults: credential.getClientExtensionResults(),
+  };
+  if (response instanceof AuthenticatorAttestationResponse) {
+    return { ...common, response: {
+      clientDataJSON: encode(response.clientDataJSON), attestationObject: encode(response.attestationObject),
+      transports: response.getTransports(),
+    } };
+  }
+  const assertion = response as AuthenticatorAssertionResponse;
+  return { ...common, response: {
+    clientDataJSON: encode(assertion.clientDataJSON), authenticatorData: encode(assertion.authenticatorData),
+    signature: encode(assertion.signature), userHandle: assertion.userHandle ? encode(assertion.userHandle) : null,
+  } };
+}
+
+export async function authenticatePasskey(signal: AbortSignal, conditional = false, reauthenticate = false): Promise<Session> {
+  const { options, ceremonyId } = await authRequest<{ options: unknown; ceremonyId: string }>(
+    'passkeys/authentication/options', { purpose: reauthenticate ? 'reauthentication' : 'signin' }, 'POST', signal);
+  const publicKey = native().parseRequestOptionsFromJSON!(options);
+  checkRP(publicKey.rpId ?? location.hostname);
+  if (reauthenticate) {
+    if (!publicKey.allowCredentials?.length) throw new AuthError('No passkey is available for this account. Verify with your password instead.');
+    publicKey.userVerification = 'required';
+  }
+  const credential = await navigator.credentials.get({ publicKey, signal, mediation: conditional ? 'conditional' : 'optional' });
+  if (!(credential instanceof PublicKeyCredential)) throw new AuthError('No passkey was selected.');
+  try {
+    return await authRequest<Session>('passkeys/authentication/verify', {
+      ceremonyId, credential: serialize(credential), purpose: reauthenticate ? 'reauthentication' : 'signin',
+    }, 'POST', signal);
+  } catch (error) {
+    // Only an explicit unknown-credential response may remove a local suggestion.
+    if (!reauthenticate && error instanceof AuthError && error.status === 404 && error.code === 'UNKNOWN_CREDENTIAL') {
+      await native().signalUnknownCredential?.({ rpId: publicKey.rpId ?? location.hostname, credentialId: credential.id }).catch(() => {});
+    }
+    throw error;
+  }
+}
+
+export async function registerPasskey(signal: AbortSignal, username?: string, conditional = false): Promise<Session> {
+  const { options, ceremonyId } = await authRequest<{ options: unknown; ceremonyId: string }>(
+    'passkeys/registration/options', { username, purpose: username ? 'signup' : 'add', conditional, promotion: conditional || !!username }, 'POST', signal);
+  const publicKey = native().parseCreationOptionsFromJSON!(options);
+  checkRP(publicKey.rp.id ?? location.hostname);
+  publicKey.authenticatorSelection = { ...publicKey.authenticatorSelection, residentKey: 'required', requireResidentKey: true };
+  if (conditional || username) publicKey.authenticatorSelection.authenticatorAttachment = 'platform';
+  else delete publicKey.authenticatorSelection.authenticatorAttachment;
+  publicKey.attestation = 'none';
+  const creation: CredentialCreationOptions & { mediation?: 'conditional' } = { publicKey, signal };
+  if (conditional) creation.mediation = 'conditional';
+  const credential = await navigator.credentials.create(creation);
+  if (!(credential instanceof PublicKeyCredential)) throw new AuthError('No passkey was created.');
+  try {
+    return await authRequest<Session>('passkeys/registration/verify', { ceremonyId, credential: serialize(credential) }, 'POST', signal);
+  } catch (error) {
+    // A definitive rejection can clean up a failed conditional creation. A network
+    // failure is ambiguous: the server may already have accepted the credential.
+    if (conditional && error instanceof AuthError && error.code === 'REGISTRATION_REJECTED') {
+      await native().signalUnknownCredential?.({ rpId: publicKey.rp.id ?? location.hostname, credentialId: credential.id }).catch(() => {});
+    }
+    throw error;
+  }
+}
+
+export async function conditionalCreate(signal: AbortSignal) {
+  if (!passkeysSupported()) return;
+  const capabilities = await native().getClientCapabilities?.().catch(() => undefined);
+  if (capabilities?.conditionalCreate) await registerPasskey(signal, undefined, true);
+}
+
+export async function conditionalAvailable() {
+  if (passkeysSupported() && native().getClientCapabilities) {
+    return !!(await native().getClientCapabilities!().catch(() => ({} as Record<string, boolean>))).conditionalGet;
+  }
+  return passkeysSupported() && !!(await native().isConditionalMediationAvailable?.().catch(() => false));
+}
+
+export async function registrationAvailable() {
+  if (!passkeysSupported()) return false;
+  const capabilities = await native().getClientCapabilities?.().catch(() => undefined);
+  return !!capabilities?.passkeyPlatformAuthenticator && !!capabilities?.conditionalGet;
+}
+
+export async function syncPasskeys(user: Account, passkeys: Passkey[]) {
+  if (!passkeysSupported()) return;
+  checkRP(user.rpId);
+  await Promise.allSettled([
+    native().signalAllAcceptedCredentials?.({ rpId: user.rpId, userId: user.id, allAcceptedCredentialIds: passkeys.map(key => key.id) }),
+  ]);
+}
+
+export async function syncUser(user: Account) {
+  if (!passkeysSupported()) return;
+  checkRP(user.rpId);
+  await native().signalCurrentUserDetails?.({ rpId: user.rpId, userId: user.id, name: user.username, displayName: user.displayName }).catch(() => {});
+}
