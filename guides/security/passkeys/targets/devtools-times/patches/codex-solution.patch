diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
index 0000000..75b26df
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,123 @@
+const API_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+export function isPasskeySupported(): boolean {
+  return typeof window !== 'undefined' && 'PublicKeyCredential' in window;
+}
+
+export async function registerPasskey(
+  username: string,
+): Promise<{ success: boolean; error?: string }> {
+  try {
+    const optionsRes = await fetch(`${API_BASE}/passkey/registration/options`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username }),
+    });
+
+    if (!optionsRes.ok) {
+      const data = await optionsRes.json().catch(() => ({}));
+      return {
+        success: false,
+        error: data.error || 'Failed to get registration options',
+      };
+    }
+
+    const optionsJSON = await optionsRes.json();
+    const publicKeyOptions = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+    const credential = (await navigator.credentials.create({
+      publicKey: publicKeyOptions,
+    })) as PublicKeyCredential;
+
+    if (!credential) {
+      return { success: false, error: 'No credential created' };
+    }
+
+    const credentialJSON = typeof credential.toJSON === 'function'
+      ? credential.toJSON()
+      : PublicKeyCredential.prototype.toJSON.call(credential);
+
+    const verifyRes = await fetch(`${API_BASE}/passkey/registration/verify`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(credentialJSON),
+    });
+
+    if (!verifyRes.ok) {
+      const data = await verifyRes.json().catch(() => ({}));
+      return {
+        success: false,
+        error: data.error || 'Registration verification failed',
+      };
+    }
+
+    return { success: true };
+  } catch (err: any) {
+    if (err.name === 'NotAllowedError') {
+      return { success: false, error: 'Passkey registration was cancelled.' };
+    }
+    if (err.name === 'AbortError') {
+      return { success: false, error: 'Passkey registration was aborted.' };
+    }
+    return { success: false, error: 'An error occurred during passkey registration.' };
+  }
+}
+
+export async function authenticatePasskey(): Promise<{
+  success: boolean;
+  error?: string;
+}> {
+  try {
+    const optionsRes = await fetch(`${API_BASE}/passkey/authentication/options`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+    });
+
+    if (!optionsRes.ok) {
+      const data = await optionsRes.json().catch(() => ({}));
+      return {
+        success: false,
+        error: data.error || 'Failed to get authentication options',
+      };
+    }
+
+    const optionsJSON = await optionsRes.json();
+    const publicKeyOptions = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+    const credential = (await navigator.credentials.get({
+      publicKey: publicKeyOptions,
+    })) as PublicKeyCredential;
+
+    if (!credential) {
+      return { success: false, error: 'No credential returned' };
+    }
+
+    const credentialJSON = typeof credential.toJSON === 'function'
+      ? credential.toJSON()
+      : PublicKeyCredential.prototype.toJSON.call(credential);
+
+    const verifyRes = await fetch(`${API_BASE}/passkey/authentication/verify`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(credentialJSON),
+    });
+
+    if (!verifyRes.ok) {
+      const data = await verifyRes.json().catch(() => ({}));
+      return {
+        success: false,
+        error: data.error || 'Authentication verification failed',
+      };
+    }
+
+    return { success: true };
+  } catch (err: any) {
+    if (err.name === 'NotAllowedError') {
+      return { success: false, error: 'Passkey sign-in was cancelled.' };
+    }
+    if (err.name === 'AbortError') {
+      return { success: false, error: 'Passkey sign-in was aborted.' };
+    }
+    return { success: false, error: 'An error occurred during passkey sign-in.' };
+  }
+}
