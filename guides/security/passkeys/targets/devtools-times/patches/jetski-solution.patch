diff --git a/src/utils/passkeys.ts b/src/utils/passkeys.ts
new file mode 100644
index 0000000..7d981f2
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,362 @@
+/**
+ * Utilities for WebAuthn and Passkeys support.
+ * Implements guidance from WebAuthn / Passkeys discipline specifications.
+ */
+
+const API_BASE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+
+/**
+ * Returns a bare domain string without scheme, port, or path for Relying Party ID.
+ * Must match origin's hostname or registrable parent domain (or localhost).
+ */
+export function getRelyingPartyId(): string {
+  if (typeof window !== 'undefined' && window.location) {
+    return window.location.hostname;
+  }
+  return 'localhost';
+}
+
+/**
+ * Known AAGUID mapping used exclusively for UX hinting (provider names/icons).
+ * Note: AAGUIDs MUST NOT be used for authorization or access control decisions.
+ */
+export const AAGUID_MAP: Record<string, { name: string; icon?: string }> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': { name: 'Google Password Manager' },
+  'ad59dadf-6450-4bf6-0881-76dd617304a9': { name: 'Google Password Manager' },
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': { name: 'Windows Hello' },
+  '9f44433d-5523-4e35-9467-eed44470bc0e': { name: 'Windows Hello' },
+  'dd48076a-e17a-4be1-ab04-3be87bf782d9': { name: 'iCloud Keychain' },
+  '00000000-0000-0000-0000-000000000000': { name: 'Security Key' },
+};
+
+export function getPasskeyProviderInfo(aaguid: string): { name: string; icon?: string } {
+  // AAGUID is used exclusively to render provider names or icons in the UI
+  // and MUST NOT be used for authorization or access control decisions.
+  return AAGUID_MAP[aaguid.toLowerCase()] || { name: 'Passkey Provider' };
+}
+
+/**
+ * Feature detection check to verify if passkeys and platform authenticators are supported.
+ * Gates all passkey entry points and hides them when passkeys are unsupported.
+ */
+export async function isPasskeySupported(): Promise<boolean> {
+  if (typeof window === 'undefined' || !('PublicKeyCredential' in window)) {
+    return false;
+  }
+
+  if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+    try {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities && capabilities.passkeyPlatformAuthenticator !== undefined) {
+        return Boolean(capabilities.passkeyPlatformAuthenticator);
+      }
+    } catch {
+      // Fallback to checking platform authenticator availability
+    }
+  }
+
+  if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+    try {
+      return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    } catch {
+      return true;
+    }
+  }
+
+  return true;
+}
+
+/**
+ * Checks if conditional mediation (autofill UI) is available.
+ */
+export async function isConditionalMediationAvailable(): Promise<boolean> {
+  if (typeof window === 'undefined' || !('PublicKeyCredential' in window)) {
+    return false;
+  }
+
+  if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+    try {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities && capabilities.conditionalGet !== undefined) {
+        return Boolean(capabilities.conditionalGet);
+      }
+    } catch {
+      // Fallback
+    }
+  }
+
+  if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+    try {
+      return await PublicKeyCredential.isConditionalMediationAvailable();
+    } catch {
+      return false;
+    }
+  }
+
+  return false;
+}
+
+/**
+ * Helper to fetch from primary endpoint with fallback to relative path.
+ */
+async function fetchEndpoint(url: string, fallbackUrl: string, init?: RequestInit): Promise<Response> {
+  try {
+    const res = await fetch(url, init);
+    if (!res.ok && res.status === 404 && url !== fallbackUrl) {
+      return await fetch(fallbackUrl, init);
+    }
+    return res;
+  } catch (err) {
+    if (url !== fallbackUrl) {
+      return await fetch(fallbackUrl, init);
+    }
+    throw err;
+  }
+}
+
+export interface PasskeyResult {
+  success: boolean;
+  error?: string;
+  data?: any;
+}
+
+/**
+ * Registers a new passkey for a user.
+ */
+export async function registerPasskey(username: string): Promise<PasskeyResult> {
+  const optionsUrl = `${API_BASE}/register/options`;
+  const optionsFallback = '/api/register/options';
+
+  let optionsRes: Response;
+  try {
+    optionsRes = await fetchEndpoint(optionsUrl, optionsFallback, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username }),
+    });
+  } catch (err) {
+    return { success: false, error: 'Failed to connect to authentication server.' };
+  }
+
+  if (!optionsRes.ok) {
+    const errData = await optionsRes.json().catch(() => ({}));
+    return {
+      success: false,
+      error: errData.error || 'Failed to get passkey registration options.',
+    };
+  }
+
+  const optionsJSON = await optionsRes.json();
+
+  // Decode server-provided registration options with PublicKeyCredential.parseCreationOptionsFromJSON
+  const publicKeyOptions = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+
+  let credential: PublicKeyCredential | null = null;
+  // Wrap navigator.credentials calls in try/catch error handling
+  try {
+    const result = await navigator.credentials.create({
+      publicKey: publicKeyOptions,
+    });
+    if (!result) {
+      return { success: false, error: 'No credential was created.' };
+    }
+    credential = result as PublicKeyCredential;
+  } catch (err: unknown) {
+    if (err instanceof DOMException || (err instanceof Error && err.name)) {
+      if (err.name === 'NotAllowedError') {
+        return { success: false, error: 'Passkey registration was cancelled.' };
+      }
+      if (err.name === 'AbortError') {
+        return { success: false, error: 'Passkey registration was aborted.' };
+      }
+      if (err.name === 'InvalidStateError') {
+        return { success: false, error: 'A passkey already exists for this device.' };
+      }
+    }
+    return {
+      success: false,
+      error: 'An unexpected error occurred during passkey registration.',
+    };
+  }
+
+  // Serialize returned credential using PublicKeyCredential.prototype.toJSON
+  const credentialJSON = typeof credential.toJSON === 'function'
+    ? credential.toJSON()
+    : PublicKeyCredential.prototype.toJSON.call(credential);
+
+  const verifyUrl = `${API_BASE}/register/verify`;
+  const verifyFallback = '/api/register/verify';
+
+  let verifyRes: Response;
+  try {
+    verifyRes = await fetchEndpoint(verifyUrl, verifyFallback, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(credentialJSON),
+    });
+  } catch (err) {
+    return { success: false, error: 'Failed to verify credential with server.' };
+  }
+
+  const verifyData = await verifyRes.json().catch(() => ({}));
+
+  if (!verifyRes.ok) {
+    if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+      try {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: verifyData.rpId || getRelyingPartyId(),
+          credentialId: credential.id || verifyData.credentialId || '',
+        });
+      } catch {
+        // Best-effort signal
+      }
+    }
+    return {
+      success: false,
+      error: verifyData.error || 'Passkey registration verification failed.',
+    };
+  }
+
+  // Signal all accepted credentials after list changes
+  if (typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function') {
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId: verifyData.rpId || getRelyingPartyId(),
+        userId: verifyData.userId || username,
+        allAcceptedCredentialIds: verifyData.allAcceptedCredentialIds || [credential.id],
+      });
+    } catch {
+      // Best-effort signal
+    }
+  }
+
+  // Signal current user details
+  if (typeof PublicKeyCredential.signalCurrentUserDetails === 'function') {
+    try {
+      await PublicKeyCredential.signalCurrentUserDetails({
+        rpId: verifyData.rpId || getRelyingPartyId(),
+        userId: verifyData.userId || username,
+        name: verifyData.name || username,
+        displayName: verifyData.displayName || username,
+      });
+    } catch {
+      // Best-effort signal
+    }
+  }
+
+  return { success: true, data: verifyData };
+}
+
+export interface AuthenticatePasskeyOptions {
+  abortController?: AbortController;
+  mediation?: CredentialMediationRequirement;
+}
+
+/**
+ * Authenticates with a passkey.
+ */
+export async function authenticatePasskey(options?: AuthenticatePasskeyOptions): Promise<PasskeyResult> {
+  const optionsUrl = `${API_BASE}/login/options`;
+  const optionsFallback = '/api/login/options';
+
+  let optionsRes: Response;
+  try {
+    optionsRes = await fetchEndpoint(optionsUrl, optionsFallback, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({}),
+    });
+  } catch (err) {
+    return { success: false, error: 'Failed to connect to authentication server.' };
+  }
+
+  if (!optionsRes.ok) {
+    const errData = await optionsRes.json().catch(() => ({}));
+    return {
+      success: false,
+      error: errData.error || 'Failed to get passkey authentication options.',
+    };
+  }
+
+  const optionsJSON = await optionsRes.json();
+
+  // Decode server-provided authentication options with PublicKeyCredential.parseRequestOptionsFromJSON
+  const publicKeyOptions = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  let credential: PublicKeyCredential | null = null;
+  // Wrap navigator.credentials calls in try/catch error handling
+  try {
+    const result = await navigator.credentials.get({
+      publicKey: publicKeyOptions,
+      signal: options?.abortController?.signal,
+      mediation: options?.mediation,
+    });
+    if (!result) {
+      return { success: false, error: 'No credential was returned.' };
+    }
+    credential = result as PublicKeyCredential;
+  } catch (err: unknown) {
+    if (err instanceof DOMException || (err instanceof Error && err.name)) {
+      if (err.name === 'NotAllowedError') {
+        return { success: false, error: 'Passkey sign-in was cancelled.' };
+      }
+      if (err.name === 'AbortError') {
+        return { success: false, error: 'Passkey sign-in was aborted.' };
+      }
+    }
+    return {
+      success: false,
+      error: 'An unexpected error occurred during passkey sign-in.',
+    };
+  }
+
+  // Serialize returned credential using PublicKeyCredential.prototype.toJSON
+  const credentialJSON = typeof credential.toJSON === 'function'
+    ? credential.toJSON()
+    : PublicKeyCredential.prototype.toJSON.call(credential);
+
+  const verifyUrl = `${API_BASE}/login/verify`;
+  const verifyFallback = '/api/login/verify';
+
+  let verifyRes: Response;
+  try {
+    verifyRes = await fetchEndpoint(verifyUrl, verifyFallback, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(credentialJSON),
+    });
+  } catch (err) {
+    return { success: false, error: 'Failed to verify passkey with server.' };
+  }
+
+  const verifyData = await verifyRes.json().catch(() => ({}));
+
+  if (!verifyRes.ok) {
+    // If server reports asserted credential is unknown (404 status or UNKNOWN_CREDENTIAL error),
+    // invoke PublicKeyCredential.signalUnknownCredential
+    if (
+      verifyRes.status === 404 ||
+      verifyData.code === 'UNKNOWN_CREDENTIAL' ||
+      verifyData.error === 'UNKNOWN_CREDENTIAL' ||
+      (typeof verifyData.error === 'string' && verifyData.error.toLowerCase().includes('unknown'))
+    ) {
+      if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+        try {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: verifyData.rpId || getRelyingPartyId(),
