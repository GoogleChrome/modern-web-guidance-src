@@ -0,0 +1,754 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  authenticateWithPasskey,
+  createPasskey,
+  detectPasskeyCapabilities,
+  signalAllAcceptedCredentials,
+  signalCurrentUserDetails,
+} from '../utils/passkey-client';
+
+interface PasskeyItem {
+  id: string;
+  name: string;
+  aaguid: string;
+  providerName: string;
+  deviceType?: 'singleDevice' | 'multiDevice';
+  backedUp?: boolean;
+  transports?: string[];
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+interface UserProfile {
+  id: string;
+  username: string;
+  displayName: string;
+  createdAt: string;
+  hasPassword: boolean;
+  passkeys: PasskeyItem[];
+  allAcceptedCredentialIds: string[];
+}
+
+type ReauthCallback = () => Promise<void>;
+
+const REAUTH_WINDOW_MS = 5 * 60 * 1000; // 5 minutes
+
+export default function AccountSettings() {
+  const [loading, setLoading] = useState(true);
+  const [authenticated, setAuthenticated] = useState(false);
+  const [rpID, setRpID] = useState('localhost');
+  const [user, setUser] = useState<UserProfile | null>(null);
+  const [reauthenticatedAt, setReauthenticatedAt] = useState<number | null>(null);
+
+  // Profile form state
+  const [username, setUsername] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [newPassword, setNewPassword] = useState('');
+  const [profileSaving, setProfileSaving] = useState(false);
+
+  // Passkey management state
+  const [passkeySupported, setPasskeySupported] = useState(false);
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+  const [addingPasskey, setAddingPasskey] = useState(false);
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editingName, setEditingName] = useState('');
+
+  // Reauthentication modal state
+  const [reauthModalOpen, setReauthModalOpen] = useState(false);
+  const [reauthReason, setReauthReason] = useState('');
+  const [reauthPassword, setReauthPassword] = useState('');
+  const [reauthLoading, setReauthLoading] = useState(false);
+  const [reauthError, setReauthError] = useState<string | null>(null);
+  const [pendingAction, setPendingAction] = useState<ReauthCallback | null>(null);
+
+  // Quick sign-in state when not signed in
+  const [quickUsername, setQuickUsername] = useState('reader@devtoolstimes.com');
+  const [quickPassword, setQuickPassword] = useState('password123');
+
+  // Notifications
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+
+  const baseUrl = import.meta.env.BASE_URL || '/devtools-times/';
+
+  const fetchSession = useCallback(async () => {
+    setLoading(true);
+    try {
+      const res = await fetch(`${baseUrl}api/auth/session`);
+      const data = await res.json();
+      if (data.rpID) setRpID(data.rpID);
+
+      if (data.authenticated && data.user) {
+        setAuthenticated(true);
+        setUser(data.user);
+        setUsername(data.user.username);
+        setDisplayName(data.user.displayName || data.user.username);
+        setReauthenticatedAt(data.reauthenticatedAt || null);
+
+        // Sync accepted credentials & user details with credential manager
+        await signalAllAcceptedCredentials(
+          data.rpID || rpID,
+          data.user.id,
+          data.user.allAcceptedCredentialIds || []
+        );
+        await signalCurrentUserDetails(
+          data.rpID || rpID,
+          data.user.id,
+          data.user.username,
+          data.user.displayName || data.user.username
+        );
+      } else {
+        setAuthenticated(false);
+        setUser(null);
+      }
+    } catch {
+      setError('Failed to load account session.');
+    } finally {
+      setLoading(false);
+    }
+  }, [baseUrl, rpID]);
+
+  useEffect(() => {
+    detectPasskeyCapabilities().then((caps) => {
+      setPasskeySupported(caps.isSupported);
+    });
+    fetchSession();
+  }, [fetchSession]);
+
+  const isRecentlyReauthenticated = () => {
+    if (!reauthenticatedAt) return false;
+    return Date.now() - reauthenticatedAt < REAUTH_WINDOW_MS;
+  };
+
+  const requireReauthentication = (reason: string, action: ReauthCallback) => {
+    if (isRecentlyReauthenticated()) {
+      action();
+      return;
+    }
+    setReauthReason(reason);
+    setReauthError(null);
+    setReauthPassword('');
+    setPendingAction(() => action);
+    setReauthModalOpen(true);
+  };
+
+  const handlePasskeyReauth = async () => {
+    setReauthError(null);
+    setReauthLoading(true);
+    try {
+      const res = await authenticateWithPasskey({
+        baseUrl,
+        username: user?.username,
+        reauthenticate: true,
+      });
+
+      if (res.verified) {
+        setReauthenticatedAt(res.reauthenticatedAt || Date.now());
+        setReauthModalOpen(false);
+        if (pendingAction) {
+          await pendingAction();
+          setPendingAction(null);
+        }
+      }
+    } catch (err: any) {
+      setReauthError(err?.message || 'Passkey verification failed.');
+    } finally {
+      setReauthLoading(false);
+    }
+  };
+
+  const handlePasswordReauth = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setReauthError(null);
+    setReauthLoading(true);
+    try {
+      const res = await fetch(`${baseUrl}api/auth/session`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'reauthenticate-password',
+          password: reauthPassword,
+        }),
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        setReauthError(data.error || 'Invalid password.');
+      } else {
+        setReauthenticatedAt(data.reauthenticatedAt || Date.now());
+        setReauthModalOpen(false);
+        if (pendingAction) {
+          await pendingAction();
+          setPendingAction(null);
+        }
+      }
+    } catch {
+      setReauthError('Failed to verify password.');
+    } finally {
+      setReauthLoading(false);
+    }
+  };
+
+  const handleAddPasskey = async () => {
+    setError(null);
+    setSuccess(null);
+    setAddingPasskey(true);
+    try {
+      const res = await createPasskey({
+        baseUrl,
+        username: user?.username,
+        displayName: user?.displayName,
+        passkeyName: newPasskeyName.trim() || undefined,
+      });
+      if (res.verified) {
+        setNewPasskeyName('');
+        setSuccess(`Passkey "${res.passkey?.name || 'New Passkey'}" registered!`);
+        await fetchSession();
+      }
+    } catch (err: any) {
+      if (err?.name === 'InvalidStateError') {
+        setError('A passkey already exists on this authenticator for your account.');
+      } else if (err?.name === 'NotAllowedError') {
+        setError('Passkey creation was cancelled.');
+      } else {
+        setError(err?.message || 'Failed to register passkey.');
+      }
+    } finally {
+      setAddingPasskey(false);
+    }
+  };
+
+  const handleRenamePasskey = async (credentialId: string) => {
+    if (!editingName.trim()) return;
+    setError(null);
+    setSuccess(null);
+
+    try {
+      const res = await fetch(`${baseUrl}api/passkeys`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ credentialId, name: editingName.trim() }),
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        setError(data.error || 'Failed to rename passkey.');
+      } else {
+        setEditingId(null);
+        setEditingName('');
+        setSuccess('Passkey renamed.');
+        await fetchSession();
+      }
+    } catch {
+      setError('Failed to rename passkey.');
+    }
+  };
+
+  const executeDeletePasskey = async (credentialId: string) => {
+    setError(null);
+    setSuccess(null);
+    try {
+      const res = await fetch(`${baseUrl}api/passkeys`, {
+        method: 'DELETE',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ credentialId }),
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        setError(data.error || 'Failed to delete passkey.');
+      } else {
+        // Notify authenticator / password manager via WebAuthn Signal API
+        if (data.rpID && data.userId) {
+          await signalAllAcceptedCredentials(
+            data.rpID,
+            data.userId,
+            data.allAcceptedCredentialIds || []
+          );
+        }
+        setSuccess('Passkey deleted and synced with your credential manager.');
+        await fetchSession();
+      }
+    } catch {
+      setError('Failed to delete passkey.');
+    }
+  };
+
+  const executeProfileUpdate = async () => {
+    setError(null);
+    setSuccess(null);
+    setProfileSaving(true);
+    try {
+      const res = await fetch(`${baseUrl}api/auth/session`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'update-profile',
+          username,
+          displayName,
+          password: newPassword || undefined,
+        }),
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        setError(data.error || 'Failed to update profile.');
+      } else {
+        setNewPassword('');
+        // Signal updated username / displayName to authenticator via signalCurrentUserDetails
+        if (data.rpID && data.user) {
+          await signalCurrentUserDetails(
+            data.rpID,
+            data.user.id,
+            data.user.username,
+            data.user.displayName || data.user.username
+          );
+        }
+        setSuccess('Account details updated and synced with your passkey provider.');
+        await fetchSession();
+      }
+    } catch {
+      setError('Failed to update profile.');
+    } finally {
+      setProfileSaving(false);
+    }
+  };
+
+  const handleProfileFormSubmit = (e: React.FormEvent) => {
+    e.preventDefault();
+    requireReauthentication('confirm changes to your account profile or password', executeProfileUpdate);
+  };
+
+  const handleLogout = async () => {
+    await fetch(`${baseUrl}api/auth/session`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ action: 'logout' }),
+    });
+    setAuthenticated(false);
+    setUser(null);
+    setSuccess('You have been signed out.');
+  };
+
+  const handleQuickLogin = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    const res = await fetch(`${baseUrl}api/auth/session`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        action: 'login',
+        username: quickUsername,
+        password: quickPassword,
+      }),
+    });
+    const data = await res.json();
+    if (!res.ok) {
+      setError(data.error || 'Sign in failed');
+    } else {
+      await fetchSession();
+    }
+  };
+
+  const handleQuickPasskeyLogin = async () => {
+    setError(null);
+    try {
+      const res = await authenticateWithPasskey({ baseUrl });
+      if (res.verified) {
+        await fetchSession();
+      }
+    } catch (err: any) {
+      setError(err?.message || 'Passkey sign-in failed');
+    }
+  };
+
+  if (loading) {
+    return (
+      <div className="max-w-3xl mx-auto p-6 text-center text-gray-600">
+        Loading account settings...
+      </div>
+    );
+  }
+
+  if (!authenticated || !user) {
+    return (
+      <div className="max-w-md mx-auto mt-8 p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 className="text-2xl font-bold text-gray-900 mb-2">Account Settings</h2>
+        <p className="text-sm text-gray-600 mb-6">
+          Sign in to manage your passkeys, security settings, and profile details.
+        </p>
+
+        {error && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+
+        <form onSubmit={handleQuickLogin} className="space-y-4">
+          <div>
+            <label htmlFor="quick-username" className="block text-sm font-medium text-gray-700 mb-1">
+              Username
+            </label>
+            <input
+              id="quick-username"
+              type="text"
+              autoComplete="username webauthn"
+              value={quickUsername}
+              onChange={(e) => setQuickUsername(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md"
+            />
+          </div>
+          <div>
+            <label htmlFor="quick-password" className="block text-sm font-medium text-gray-700 mb-1">
+              Password
+            </label>
+            <input
+              id="quick-password"
+              type="password"
+              autoComplete="current-password webauthn"
+              value={quickPassword}
+              onChange={(e) => setQuickPassword(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md"
+            />
+          </div>
+          <button
+            type="submit"
+            className="w-full py-2 px-4 bg-gray-900 text-white text-sm font-medium rounded-md hover:bg-gray-800"
+          >
+            Sign In to Manage Account
+          </button>
+        </form>
+
+        {passkeySupported && (
+          <div className="mt-4">
+            <button
+              type="button"
+              onClick={handleQuickPasskeyLogin}
+              className="w-full flex items-center justify-center gap-2 py-2 px-4 border border-gray-300 rounded-md text-sm font-medium text-gray-800 bg-white hover:bg-gray-50"
+            >
+              Sign in with a passkey
+            </button>
+          </div>
+        )}
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-3xl mx-auto space-y-8">
+      {/* Header Bar */}
+      <div className="flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 pb-4">
+        <div>
+          <h1 className="text-2xl font-bold text-gray-900">Account &amp; Passkey Settings</h1>
+          <p className="text-sm text-gray-600">
+            Signed in as <span className="font-semibold text-gray-900">{user.username}</span>
+          </p>
+        </div>
+        <div className="flex items-center gap-3">
+          <button
+            type="button"
+            onClick={() =>
+              requireReauthentication('verify your identity for sensitive account actions', async () => {
+                setSuccess('Identity verified successfully.');
+              })
+            }
+            className="py-1.5 px-3 border border-gray-300 rounded text-xs font-medium text-gray-700 hover:bg-gray-50"
+          >
+            {isRecentlyReauthenticated() ? 'Verified Session' : 'Reauthenticate'}
+          </button>
+          <button
+            type="button"
+            onClick={handleLogout}
+            className="py-1.5 px-3 bg-gray-200 text-gray-800 rounded text-xs font-semibold hover:bg-gray-300"
+          >
+            Sign out
+          </button>
+        </div>
+      </div>
+
+      {error && (
+        <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {success && (
+        <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="alert">
+          {success}
+        </div>
+      )}
+
+      {/* Passkeys Management Section */}
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <div className="flex flex-wrap items-start justify-between gap-4 mb-6">
+          <div>
+            <h2 className="text-lg font-bold text-gray-900">Passkeys</h2>
+            <p className="text-sm text-gray-600">
+              Passkeys let you sign in securely using your fingerprint, face recognition, or device screen lock.
+            </p>
+          </div>
+        </div>
+
+        {/* Existing Passkey List */}
+        {user.passkeys.length === 0 ? (
+          <div className="p-6 bg-gray-50 border border-dashed border-gray-300 rounded-md text-center mb-6">
+            <p className="text-sm text-gray-600">No passkeys registered for your account yet.</p>
+          </div>
+        ) : (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-md mb-6">
+            {user.passkeys.map((pk) => (
+              <li key={pk.id} className="p-4 flex flex-wrap items-center justify-between gap-4">
+                <div className="flex items-start gap-3">
+                  <div className="p-2 bg-gray-100 rounded-full text-gray-700 mt-0.5">
+                    <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+                      <path
+                        strokeLinecap="round"
+                        strokeLinejoin="round"
+                        strokeWidth={2}
+                        d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                      />
+                    </svg>
+                  </div>
+                  <div>
+                    {editingId === pk.id ? (
+                      <div className="flex items-center gap-2">
+                        <input
+                          type="text"
+                          value={editingName}
+                          onChange={(e) => setEditingName(e.target.value)}
+                          className="px-2 py-1 text-sm border border-gray-300 rounded"
+                          aria-label="Passkey name"
+                        />
+                        <button
+                          type="button"
+                          onClick={() => handleRenamePasskey(pk.id)}
+                          className="px-2.5 py-1 bg-gray-900 text-white text-xs font-semibold rounded hover:bg-gray-800"
+                        >
+                          Save
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => setEditingId(null)}
+                          className="px-2 py-1 text-xs text-gray-600 hover:text-gray-900"
+                        >
+                          Cancel
+                        </button>
+                      </div>
+                    ) : (
+                      <div className="flex items-center gap-2">
+                        <span className="font-semibold text-sm text-gray-900">{pk.name}</span>
+                        {pk.providerName && (
+                          <span className="px-2 py-0.5 text-xs bg-gray-100 text-gray-600 rounded-full">
+                            {pk.providerName}
+                          </span>
+                        )}
+                        {pk.backedUp && (
+                          <span className="px-2 py-0.5 text-xs bg-blue-50 text-blue-700 rounded-full">
+                            Synced
+                          </span>
+                        )}
+                      </div>
+                    )}
+                    <div className="text-xs text-gray-500 mt-1">
+                      Created {new Date(pk.createdAt).toLocaleDateString()}
+                      {pk.lastUsedAt && ` · Last used ${new Date(pk.lastUsedAt).toLocaleDateString()}`}
+                    </div>
+                  </div>
+                </div>
+
+                <div className="flex items-center gap-2">
+                  {editingId !== pk.id && (
+                    <button
+                      type="button"
+                      onClick={() => {
+                        setEditingId(pk.id);
+                        setEditingName(pk.name);
+                      }}
+                      className="px-2.5 py-1 text-xs font-medium text-gray-700 border border-gray-300 rounded hover:bg-gray-50"
+                    >
+                      Rename
+                    </button>
+                  )}
+                  <button
+                    type="button"
+                    onClick={() =>
+                      requireReauthentication(`remove the passkey "${pk.name}"`, () =>
+                        executeDeletePasskey(pk.id)
+                      )
+                    }
+                    className="px-2.5 py-1 text-xs font-medium text-red-700 border border-red-200 bg-red-50 rounded hover:bg-red-100"
+                  >
+                    Delete
+                  </button>
+                </div>
+              </li>
+            ))}
+          </ul>
+        )}
+
+        {/* Create New Passkey Controls */}
+        <div className="flex flex-wrap items-center gap-3">
+          <input
+            type="text"
+            placeholder="Passkey label (optional, e.g. Work Laptop)"
+            value={newPasskeyName}
+            onChange={(e) => setNewPasskeyName(e.target.value)}
+            className="flex-1 min-w-[220px] px-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+          />
+          <button
+            type="button"
+            onClick={handleAddPasskey}
+            disabled={addingPasskey || !passkeySupported}
+            className="py-2 px-4 bg-gray-900 text-white text-sm font-medium rounded-md hover:bg-gray-800 disabled:opacity-50"
+          >
+            {addingPasskey ? 'Registering...' : 'Create a Passkey'}
+          </button>
+        </div>
+      </section>
+
+      {/* Profile & Sensitive Settings Section (Protected by Reauthentication) */}
+      <section className="p-6 bg-white border border-gray-200 rounded-lg shadow-sm">
+        <h2 className="text-lg font-bold text-gray-900 mb-1">Profile &amp; Credentials</h2>
+        <p className="text-sm text-gray-600 mb-6">
+          Updating your username or display name automatically syncs with your passkey provider using{' '}
+          <code className="text-xs bg-gray-100 px-1 py-0.5 rounded">signalCurrentUserDetails</code>.
+          Changes require reauthentication.
+        </p>
+
+        <form onSubmit={handleProfileFormSubmit} className="space-y-4 max-w-md">
+          <div>
+            <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">
+              Username
+            </label>
+            <input
+              id="account-username"
+              type="text"
+              autoComplete="username"
+              value={username}
+              onChange={(e) => setUsername(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+            />
+          </div>
+
+          <div>
+            <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+              Display Name
+            </label>
+            <input
+              id="account-display-name"
+              type="text"
+              autoComplete="name"
+              value={displayName}
+              onChange={(e) => setDisplayName(e.target.value)}
+              required
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+            />
+          </div>
+
+          <div>
+            <label htmlFor="account-new-password" className="block text-sm font-medium text-gray-700 mb-1">
+              New Password <span className="text-xs text-gray-400">(leave blank to keep current)</span>
+            </label>
+            <input
+              id="account-new-password"
+              type="password"
+              autoComplete="new-password"
+              value={newPassword}
+              onChange={(e) => setNewPassword(e.target.value)}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+            />
+          </div>
+
+          <button
+            type="submit"
+            disabled={profileSaving}
