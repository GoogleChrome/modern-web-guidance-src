@@ -0,0 +1,73 @@
+import type { APIRoute } from 'astro';
+import {
+  findUserById,
+  generateRegistrationOptions,
+  getOrCreatePendingUser,
+  getRPConfig,
+  isoBase64URL,
+  loadDb,
+  saveDb,
+} from '../../../utils/auth-store';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const { rpID, rpName, origin } = getRPConfig(request);
+
+    let userId = await session?.get('userId');
+    let user = userId ? findUserById(userId) : undefined;
+
+    if (!user) {
+      const requestedUsername = (body.username || '').trim();
+      if (!requestedUsername) {
+        return new Response(
+          JSON.stringify({ error: 'Username is required to register a passkey' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      user = getOrCreatePendingUser(requestedUsername, body.displayName || requestedUsername);
+    }
+
+    const userIDBuffer = isoBase64URL.toBuffer(user.id);
+
+    const options = await generateRegistrationOptions({
+      rpName,
+      rpID,
+      userID: userIDBuffer,
+      userName: user.username,
+      userDisplayName: user.displayName || user.username,
+      attestationType: 'none',
+      excludeCredentials: user.passkeys.map((pk) => ({
+        id: pk.id,
+        transports: pk.transports as any,
+      })),
+      authenticatorSelection: {
+        residentKey: 'required',
+        userVerification: 'preferred',
+      },
+    });
+
+    await session?.set('currentChallenge', options.challenge);
+    await session?.set('pendingUserId', user.id);
+
+    const db = loadDb();
+    db.challenges[options.challenge] = {
+      challenge: options.challenge,
+      userId: user.id,
+      rpID,
+      origin,
+      expiresAt: Date.now() + 5 * 60 * 1000,
+    };
+    saveDb(db);
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to generate registration options' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..30ef424
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,125 @@
+import type { APIRoute } from 'astro';
+import {
+  findUserById,
+  getProviderNameFromAAGUID,
+  getRPConfig,
+  isoBase64URL,
+  loadDb,
+  saveDb,
+  verifyRegistrationResponse,
+} from '../../../utils/auth-store';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const credential = body.credential || body;
+    const customName = body.name as string | undefined;
+
+    const { rpID, origin } = getRPConfig(request);
+    const sessionChallenge = await session?.get('currentChallenge');
+    const sessionUserId = (await session?.get('userId')) || (await session?.get('pendingUserId'));
+
+    const db = loadDb();
+
+    const verification = await verifyRegistrationResponse({
+      response: credential,
+      expectedChallenge: (challenge) => {
+        if (sessionChallenge && challenge === sessionChallenge) return true;
+        const stored = db.challenges[challenge];
+        if (stored && stored.expiresAt > Date.now()) return true;
+        return false;
+      },
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(
+        JSON.stringify({ verified: false, error: 'Passkey registration verification failed' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const { registrationInfo } = verification;
+    const clientData = JSON.parse(
+      Buffer.from(credential.response.clientDataJSON, 'base64url').toString('utf-8')
+    );
+    const challengeRecord = db.challenges[clientData.challenge];
+    const targetUserId = sessionUserId || challengeRecord?.userId || body.userId;
+
+    const user = targetUserId ? findUserById(targetUserId) : undefined;
+    if (!user) {
+      return new Response(
+        JSON.stringify({ verified: false, error: 'User account not found for registration' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Clean up challenge
+    if (clientData.challenge && db.challenges[clientData.challenge]) {
+      delete db.challenges[clientData.challenge];
+    }
+    await session?.set('currentChallenge', undefined);
+
+    const aaguid = registrationInfo.aaguid || '00000000-0000-0000-0000-000000000000';
+    // Note: AAGUID is used strictly for UX hints (provider name/icon) and never for security decisions
+    const providerName = getProviderNameFromAAGUID(aaguid, body.uaHint);
+    const passkeyName = customName?.trim() || providerName || `Passkey ${user.passkeys.length + 1}`;
+
+    const newPasskey = {
+      id: registrationInfo.credential.id,
+      publicKey: isoBase64URL.fromBuffer(registrationInfo.credential.publicKey),
+      counter: registrationInfo.credential.counter,
+      transports: registrationInfo.credential.transports || credential.response?.transports || [],
+      deviceType: registrationInfo.credentialDeviceType,
+      backedUp: registrationInfo.credentialBackedUp,
+      aaguid,
+      providerName,
+      name: passkeyName,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+    };
+
+    const existingIdx = user.passkeys.findIndex((p) => p.id === newPasskey.id);
+    if (existingIdx >= 0) {
+      user.passkeys[existingIdx] = newPasskey;
+    } else {
+      user.passkeys.push(newPasskey);
+    }
+
+    saveDb(db);
+
+    await session?.set('userId', user.id);
+    await session?.set('reauthenticatedAt', Date.now());
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        rpID,
+        passkey: {
+          id: newPasskey.id,
+          name: newPasskey.name,
+          aaguid: newPasskey.aaguid,
+          providerName: newPasskey.providerName,
+          deviceType: newPasskey.deviceType,
+          backedUp: newPasskey.backedUp,
+          createdAt: newPasskey.createdAt,
+          lastUsedAt: newPasskey.lastUsedAt,
+        },
+        user: {
+          id: user.id,
+          username: user.username,
+          displayName: user.displayName,
+          allAcceptedCredentialIds: user.passkeys.map((pk) => pk.id),
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ verified: false, error: err?.message || 'Registration verification error' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/utils/auth-store.ts b/src/utils/auth-store.ts
new file mode 100644
index 0000000..55db992
--- /dev/null
+++ b/src/utils/auth-store.ts
@@ -0,0 +1,221 @@
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from '@simplewebauthn/server';
+import { isoBase64URL, isoUint8Array } from '@simplewebauthn/server/helpers';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+
+export interface StoredPasskey {
+  id: string; // base64url credential ID
+  publicKey: string; // base64url encoded public key bytes
+  counter: number;
+  transports?: string[];
+  deviceType?: 'singleDevice' | 'multiDevice';
+  backedUp?: boolean;
+  aaguid: string;
+  providerName: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+export interface StoredUser {
+  id: string; // base64url encoded user ID
+  username: string;
+  displayName: string;
+  passwordHash: string;
+  createdAt: string;
+  passkeys: StoredPasskey[];
+}
+
+export interface DatabaseSchema {
+  users: Record<string, StoredUser>; // keyed by user.id
+  challenges: Record<string, { challenge: string; userId?: string; rpID: string; origin: string; expiresAt: number }>;
+}
+
+const DB_FILE = path.join(process.cwd(), '.auth-db.json');
+
+// Keep an in-memory cache synchronized with disk
+let memoryDb: DatabaseSchema | null = null;
+
+function getDefaultDb(): DatabaseSchema {
+  const defaultUserId = isoBase64URL.fromBuffer(isoUint8Array.fromUTF8String('user-demo-1'));
+  return {
+    users: {
+      [defaultUserId]: {
+        id: defaultUserId,
+        username: 'reader@devtoolstimes.com',
+        displayName: 'Alex Reader',
+        passwordHash: hashPassword('password123'),
+        createdAt: new Date().toISOString(),
+        passkeys: [],
+      },
+    },
+    challenges: {},
+  };
+}
+
+export function loadDb(): DatabaseSchema {
+  if (memoryDb) return memoryDb;
+  try {
+    if (fs.existsSync(DB_FILE)) {
+      const raw = fs.readFileSync(DB_FILE, 'utf-8');
+      memoryDb = JSON.parse(raw) as DatabaseSchema;
+      return memoryDb;
+    }
+  } catch (e) {
+    // Fallback to in-memory default
+  }
+  memoryDb = getDefaultDb();
+  saveDb(memoryDb);
+  return memoryDb;
+}
+
+export function saveDb(db: DatabaseSchema): void {
+  memoryDb = db;
+  try {
+    fs.writeFileSync(DB_FILE, JSON.stringify(db, null, 2), 'utf-8');
+  } catch (e) {
+    // Ignore write errors in read-only environments
+  }
+}
+
+export function hashPassword(password: string): string {
+  return crypto.createHash('sha256').update(password + '_devtools_times_salt').digest('hex');
+}
+
+export function verifyPassword(password: string, hash: string): boolean {
+  return hashPassword(password) === hash;
+}
+
+// Known AAGUID Directory (for UX hinting ONLY - never used for security decisions!)
+export const AAGUID_DIRECTORY: Record<string, { name: string; icon?: string }> = {
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4': { name: 'Google Password Manager' },
+  'adce0002-35bc-c60a-648b-0b25f1f05503': { name: 'Chrome on Mac' },
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd': { name: 'iCloud Keychain' },
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': { name: 'iCloud Keychain (Managed)' },
+  '00000000-0000-0000-0000-000000000000': { name: 'Device Passkey' },
+  'bada5566-a7aa-401f-bd96-45619a55120d': { name: '1Password' },
+  'd548826e-79b4-db40-a3d8-11116f7e8349': { name: 'Bitwarden' },
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': { name: 'Windows Hello' },
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9': { name: 'Windows Hello' },
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2': { name: 'Windows Hello' },
+  '531126d6-e717-415c-9320-3d9aa6981239': { name: 'Dashlane' },
+  'f3809540-7f14-49c1-a8b3-8f813b225541': { name: 'Enpass' },
+  'b78a0a55-6ef8-d246-a042-ba0f6d55050c': { name: 'Proton Pass' },
+};
+
+export function getProviderNameFromAAGUID(aaguid: string, fallbackHint?: string): string {
+  const normalized = (aaguid || '').toLowerCase();
+  if (AAGUID_DIRECTORY[normalized] && normalized !== '00000000-0000-0000-0000-000000000000') {
+    return AAGUID_DIRECTORY[normalized].name;
+  }
+  return fallbackHint || 'Passkey';
+}
+
+export function getRPConfig(request: Request): { rpID: string; rpName: string; origin: string } {
+  const url = new URL(request.url);
+  const forwardedHost = request.headers.get('x-forwarded-host');
+  const hostHeader = forwardedHost || request.headers.get('host') || url.host || 'localhost';
+  const hostname = hostHeader.split(':')[0];
+
+  const originHeader = request.headers.get('origin');
+  const forwardedProto = request.headers.get('x-forwarded-proto');
+  const protocol = forwardedProto ? `${forwardedProto}:` : url.protocol;
+  const origin = originHeader || `${protocol}//${hostHeader}`;
+
+  return {
+    rpID: hostname,
+    rpName: 'The DevTools Times',
+    origin,
+  };
+}
+
+export function findUserByUsername(username: string): StoredUser | undefined {
+  const db = loadDb();
+  const normalized = username.trim().toLowerCase();
+  return Object.values(db.users).find((u) => u.username.toLowerCase() === normalized);
+}
+
+export function findUserById(userId: string): StoredUser | undefined {
+  const db = loadDb();
+  return db.users[userId];
+}
+
+export function findUserByCredentialId(credentialId: string): { user: StoredUser; passkey: StoredPasskey } | undefined {
+  const db = loadDb();
+  for (const user of Object.values(db.users)) {
+    const passkey = user.passkeys.find((p) => p.id === credentialId);
+    if (passkey) {
+      return { user, passkey };
+    }
+  }
+  return undefined;
+}
+
+export function createUser(username: string, password?: string, displayName?: string): StoredUser {
+  const db = loadDb();
+  const existing = findUserByUsername(username);
+  if (existing) {
+    throw new Error('APP_ERR_1001: Username already exists');
+  }
+
+  const randomBytes = new Uint8Array(16);
+  crypto.getRandomValues(randomBytes);
+  const userId = isoBase64URL.fromBuffer(randomBytes);
+
+  const user: StoredUser = {
+    id: userId,
+    username: username.trim(),
+    displayName: (displayName || username).trim(),
+    passwordHash: password ? hashPassword(password) : '',
+    createdAt: new Date().toISOString(),
+    passkeys: [],
+  };
+
+  db.users[user.id] = user;
+  saveDb(db);
+  return user;
+}
+
+export function getOrCreatePendingUser(username: string, displayName?: string): StoredUser {
+  const existing = findUserByUsername(username);
+  if (existing) return existing;
+  return createUser(username, undefined, displayName);
+}
+
+export function updateUserDetails(userId: string, updates: { username?: string; displayName?: string; password?: string }): StoredUser {
+  const db = loadDb();
+  const user = db.users[userId];
+  if (!user) {
+    throw new Error('User not found');
+  }
+  if (updates.username && updates.username.trim() !== user.username) {
+    const conflict = findUserByUsername(updates.username);
+    if (conflict && conflict.id !== userId) {
+      throw new Error('Username already taken');
+    }
+    user.username = updates.username.trim();
+  }
+  if (updates.displayName !== undefined) {
+    user.displayName = updates.displayName.trim() || user.username;
+  }
+  if (updates.password) {
+    user.passwordHash = hashPassword(updates.password);
+  }
+  saveDb(db);
+  return user;
+}
+
+export {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+  isoBase64URL,
+  isoUint8Array,
+};
diff --git a/src/utils/passkey-client.ts b/src/utils/passkey-client.ts
new file mode 100644
index 0000000..9d3b403
--- /dev/null
+++ b/src/utils/passkey-client.ts
@@ -0,0 +1,390 @@
+// Client-side native WebAuthn / Passkey helpers
+// Strictly calls native browser APIs directly (no @simplewebauthn/browser wrapper)
+
+export interface PasskeyClientCapabilities {
+  isSupported: boolean;
+  isUVPAA: boolean;
+  isConditionalMediation: boolean;
+  conditionalCreate: boolean;
+  conditionalGet: boolean;
+  signalAllAcceptedCredentials: boolean;
+  signalCurrentUserDetails: boolean;
+  signalUnknownCredential: boolean;
+}
+
+export function base64urlToUint8Array(base64url: string): Uint8Array<ArrayBuffer> {
+  const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+  const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+  const rawData = window.atob(base64);
+  const outputArray = new Uint8Array(new ArrayBuffer(rawData.length));
+  for (let i = 0; i < rawData.length; ++i) {
+    outputArray[i] = rawData.charCodeAt(i);
+  }
+  return outputArray;
+}
+
+export function arrayBufferToBase64url(buffer: ArrayBuffer): string {
+  const bytes = new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return window
+    .btoa(binary)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
+
+export async function detectPasskeyCapabilities(): Promise<PasskeyClientCapabilities> {
+  const result: PasskeyClientCapabilities = {
+    isSupported: false,
+    isUVPAA: false,
+    isConditionalMediation: false,
+    conditionalCreate: false,
+    conditionalGet: false,
+    signalAllAcceptedCredentials: false,
+    signalCurrentUserDetails: false,
+    signalUnknownCredential: false,
+  };
+
+  if (typeof window === 'undefined' || !window.isSecureContext || typeof window.PublicKeyCredential === 'undefined') {
+    return result;
+  }
+
+  result.isSupported = true;
+  const PKC = window.PublicKeyCredential as any;
+
+  try {
+    if (typeof PKC.getClientCapabilities === 'function') {
+      const caps = await PKC.getClientCapabilities();
+      if (caps) {
+        result.conditionalCreate = Boolean(caps.conditionalCreate);
+        result.conditionalGet = Boolean(caps.conditionalGet);
+        result.isUVPAA = Boolean(
+          caps.userVerifyingPlatformAuthenticator ?? caps.passkeyPlatformAuthenticator
+        );
+        result.isConditionalMediation = Boolean(caps.conditionalGet);
+        result.signalAllAcceptedCredentials = Boolean(caps.signalAllAcceptedCredentials);
+        result.signalCurrentUserDetails = Boolean(caps.signalCurrentUserDetails);
+        result.signalUnknownCredential = Boolean(caps.signalUnknownCredential);
+      }
+    }
+  } catch {
+    // Fallback to legacy static feature checks
+  }
+
+  try {
+    if (!result.isUVPAA && typeof PKC.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+      result.isUVPAA = await PKC.isUserVerifyingPlatformAuthenticatorAvailable();
+    }
+  } catch {
+    // Ignore
+  }
+
+  try {
+    if (!result.isConditionalMediation && typeof PKC.isConditionalMediationAvailable === 'function') {
+      result.isConditionalMediation = await PKC.isConditionalMediationAvailable();
+      result.conditionalGet = result.isConditionalMediation;
+    }
+  } catch {
+    // Ignore
+  }
+
+  if (typeof PKC.signalAllAcceptedCredentials === 'function') {
+    result.signalAllAcceptedCredentials = true;
+  }
+  if (typeof PKC.signalCurrentUserDetails === 'function') {
+    result.signalCurrentUserDetails = true;
+  }
+  if (typeof PKC.signalUnknownCredential === 'function') {
+    result.signalUnknownCredential = true;
+  }
+
+  return result;
+}
+
+export function parseCreationOptions(optionsJSON: any): PublicKeyCredentialCreationOptions {
+  const PKC = window.PublicKeyCredential as any;
+  if (typeof PKC?.parseCreationOptionsFromJSON === 'function') {
+    return PKC.parseCreationOptionsFromJSON(optionsJSON);
+  }
+  return {
+    ...optionsJSON,
+    challenge: base64urlToUint8Array(optionsJSON.challenge),
+    user: {
+      ...optionsJSON.user,
+      id: base64urlToUint8Array(optionsJSON.user.id),
+    },
+    excludeCredentials: (optionsJSON.excludeCredentials || []).map((cred: any) => ({
+      ...cred,
+      id: base64urlToUint8Array(cred.id),
+    })),
+  };
+}
+
+export function parseRequestOptions(optionsJSON: any): PublicKeyCredentialRequestOptions {
+  const PKC = window.PublicKeyCredential as any;
+  if (typeof PKC?.parseRequestOptionsFromJSON === 'function') {
+    return PKC.parseRequestOptionsFromJSON(optionsJSON);
+  }
+  return {
+    ...optionsJSON,
+    challenge: base64urlToUint8Array(optionsJSON.challenge),
+    allowCredentials: optionsJSON.allowCredentials
+      ? optionsJSON.allowCredentials.map((cred: any) => ({
+          ...cred,
+          id: base64urlToUint8Array(cred.id),
+        }))
+      : undefined,
+  };
+}
+
+export function serializeCredential(credential: PublicKeyCredential): any {
+  const anyCred = credential as any;
+  if (typeof anyCred.toJSON === 'function') {
+    return anyCred.toJSON();
+  }
+
+  const response = credential.response as any;
+  if (response.attestationObject) {
+    // Registration (AuthenticatorAttestationResponse)
+    return {
+      id: credential.id,
+      rawId: arrayBufferToBase64url(credential.rawId),
+      type: credential.type,
+      authenticatorAttachment: (credential as any).authenticatorAttachment || undefined,
+      clientExtensionResults: credential.getClientExtensionResults?.() || {},
+      response: {
+        clientDataJSON: arrayBufferToBase64url(response.clientDataJSON),
+        attestationObject: arrayBufferToBase64url(response.attestationObject),
+        transports: typeof response.getTransports === 'function' ? response.getTransports() : [],
+      },
+    };
+  } else {
+    // Authentication (AuthenticatorAssertionResponse)
+    return {
+      id: credential.id,
+      rawId: arrayBufferToBase64url(credential.rawId),
+      type: credential.type,
+      authenticatorAttachment: (credential as any).authenticatorAttachment || undefined,
+      clientExtensionResults: credential.getClientExtensionResults?.() || {},
+      response: {
+        clientDataJSON: arrayBufferToBase64url(response.clientDataJSON),
+        authenticatorData: arrayBufferToBase64url(response.authenticatorData),
+        signature: arrayBufferToBase64url(response.signature),
+        userHandle: response.userHandle ? arrayBufferToBase64url(response.userHandle) : undefined,
+      },
+    };
+  }
+}
+
+export async function signalAllAcceptedCredentials(
+  rpId: string,
+  userId: string,
+  allAcceptedCredentialIds: string[]
+): Promise<void> {
+  if (typeof window === 'undefined' || typeof window.PublicKeyCredential === 'undefined') return;
+  const PKC = window.PublicKeyCredential as any;
+  if (typeof PKC.signalAllAcceptedCredentials === 'function') {
+    try {
+      await PKC.signalAllAcceptedCredentials({
+        rpId,
+        userId,
+        allAcceptedCredentialIds,
+      });
+    } catch {
+      // Non-fatal signal error
+    }
+  }
+}
+
+export async function signalCurrentUserDetails(
+  rpId: string,
+  userId: string,
+  name: string,
+  displayName: string
+): Promise<void> {
+  if (typeof window === 'undefined' || typeof window.PublicKeyCredential === 'undefined') return;
+  const PKC = window.PublicKeyCredential as any;
+  if (typeof PKC.signalCurrentUserDetails === 'function') {
+    try {
+      await PKC.signalCurrentUserDetails({
+        rpId,
+        userId,
+        name,
+        displayName,
+      });
+    } catch {
+      // Non-fatal signal error
+    }
+  }
+}
+
+export async function signalUnknownCredential(rpId: string, credentialId: string): Promise<void> {
+  if (typeof window === 'undefined' || typeof window.PublicKeyCredential === 'undefined') return;
+  const PKC = window.PublicKeyCredential as any;
+  if (typeof PKC.signalUnknownCredential === 'function') {
+    try {
+      await PKC.signalUnknownCredential({
+        rpId,
+        credentialId,
+      });
+    } catch {
+      // Non-fatal signal error
+    }
+  }
+}
+
+export function getBrowserPasskeyHint(): string {
+  if (typeof navigator === 'undefined') return 'Device Passkey';
+  const ua = navigator.userAgent;
+  if (/Macintosh|Mac OS X/i.test(ua)) return 'iCloud Keychain / macOS Passkey';
+  if (/iPhone|iPad|iPod/i.test(ua)) return 'iCloud Keychain';
+  if (/Android/i.test(ua)) return 'Google Password Manager';
+  if (/Windows/i.test(ua)) return 'Windows Hello';
+  if (/Linux/i.test(ua)) return 'Chrome Passkey';
+  return 'Device Passkey';
+}
+
+export async function createPasskey(options: {
+  baseUrl: string;
+  username?: string;
+  displayName?: string;
+  passkeyName?: string;
+  conditional?: boolean;
+}): Promise<{ verified: boolean; passkey?: any; user?: any; rpID?: string; error?: string }> {
+  const { baseUrl, username, displayName, passkeyName, conditional = false } = options;
+
+  const optsRes = await fetch(`${baseUrl}api/passkeys/register-options`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, displayName }),
+  });
+
+  const optionsJSON = await optsRes.json();
+  if (!optsRes.ok) {
+    throw new Error(optionsJSON.error || 'Failed to get passkey registration options');
+  }
+
+  const publicKeyOptions = parseCreationOptions(optionsJSON);
+
+  const createArgs: CredentialCreationOptions = {
+    publicKey: publicKeyOptions,
+  };
+  if (conditional) {
+    (createArgs as any).mediation = 'conditional';
+  }
+
+  const credential = (await navigator.credentials.create(createArgs)) as PublicKeyCredential | null;
+  if (!credential) {
+    throw new Error('Passkey creation was cancelled or returned no credential.');
+  }
+
+  const serialized = serializeCredential(credential);
+
+  const verifyRes = await fetch(`${baseUrl}api/passkeys/register-verify`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      credential: serialized,
+      name: passkeyName,
+      uaHint: getBrowserPasskeyHint(),
+    }),
+  });
+
+  const verifyData = await verifyRes.json();
+  if (!verifyRes.ok || !verifyData.verified) {
+    throw new Error(verifyData.error || 'Failed to verify passkey registration');
+  }
+
+  if (verifyData.rpID && verifyData.user) {
+    await signalAllAcceptedCredentials(
+      verifyData.rpID,
+      verifyData.user.id,
+      verifyData.user.allAcceptedCredentialIds || []
+    );
+    await signalCurrentUserDetails(
+      verifyData.rpID,
+      verifyData.user.id,
+      verifyData.user.username,
+      verifyData.user.displayName || verifyData.user.username
+    );
+  }
+
+  return verifyData;
+}
+
+export async function authenticateWithPasskey(options: {
+  baseUrl: string;
+  username?: string;
+  reauthenticate?: boolean;
+  conditional?: boolean;
+  signal?: AbortSignal;
+}): Promise<{ verified: boolean; user?: any; rpID?: string; reauthenticatedAt?: number; error?: string }> {
+  const { baseUrl, username, reauthenticate = false, conditional = false, signal } = options;
+
+  const optsRes = await fetch(`${baseUrl}api/passkeys/auth-options`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, reauthenticate }),
+  });
+
+  const optionsJSON = await optsRes.json();
+  if (!optsRes.ok) {
+    throw new Error(optionsJSON.error || 'Failed to get passkey authentication options');
+  }
+
+  const publicKeyOptions = parseRequestOptions(optionsJSON);
+
+  const getArgs: CredentialRequestOptions = {
+    publicKey: publicKeyOptions,
+    signal,
+  };
+  if (conditional) {
+    (getArgs as any).mediation = 'conditional';
+  }
+
+  const credential = (await navigator.credentials.get(getArgs)) as PublicKeyCredential | null;
+  if (!credential) {
+    throw new Error('No passkey credential selected.');
+  }
+
+  const serialized = serializeCredential(credential);
+
+  const verifyRes = await fetch(`${baseUrl}api/passkeys/auth-verify`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      credential: serialized,
+      reauthenticate,
+    }),
+  });
+
+  const verifyData = await verifyRes.json();
+
+  if (verifyData.unknownCredential && verifyData.rpID && verifyData.credentialId) {
+    await signalUnknownCredential(verifyData.rpID, verifyData.credentialId);
+    throw new Error(verifyData.error || 'This passkey is no longer recognized and has been removed.');
+  }
+
+  if (!verifyRes.ok || !verifyData.verified) {
+    throw new Error(verifyData.error || 'Passkey authentication failed');
+  }
+
+  if (verifyData.rpID && verifyData.user) {
+    await signalAllAcceptedCredentials(
+      verifyData.rpID,
+      verifyData.user.id,
+      verifyData.user.allAcceptedCredentialIds || []
+    );
+    await signalCurrentUserDetails(
+      verifyData.rpID,
+      verifyData.user.id,
+      verifyData.user.username,
+      verifyData.user.displayName || verifyData.user.username
+    );
+  }
+
+  return verifyData;
+}
