diff --git a/src/pages/api/auth/session.ts b/src/pages/api/auth/session.ts
new file mode 100644
index 0000000..b5b9f0d
--- /dev/null
+++ b/src/pages/api/auth/session.ts
@@ -0,0 +1,223 @@
+import type { APIRoute } from 'astro';
+import {
+  createUser,
+  findUserById,
+  findUserByUsername,
+  getRPConfig,
+  loadDb,
+  saveDb,
+  updateUserDetails,
+  verifyPassword,
+} from '../../../utils/auth-store';
+
+export const GET: APIRoute = async ({ request, session }) => {
+  const { rpID } = getRPConfig(request);
+  const userId = await session?.get('userId');
+  const reauthenticatedAt = await session?.get('reauthenticatedAt');
+
+  if (!userId) {
+    return new Response(
+      JSON.stringify({ authenticated: false, rpID }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  const user = findUserById(userId);
+  if (!user) {
+    await session?.set('userId', undefined);
+    return new Response(
+      JSON.stringify({ authenticated: false, rpID }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  return new Response(
+    JSON.stringify({
+      authenticated: true,
+      rpID,
+      reauthenticatedAt: reauthenticatedAt || null,
+      user: {
+        id: user.id,
+        username: user.username,
+        displayName: user.displayName,
+        createdAt: user.createdAt,
+        hasPassword: Boolean(user.passwordHash),
+        passkeys: user.passkeys.map((pk) => ({
+          id: pk.id,
+          name: pk.name,
+          aaguid: pk.aaguid,
+          providerName: pk.providerName,
+          deviceType: pk.deviceType,
+          backedUp: pk.backedUp,
+          transports: pk.transports,
+          createdAt: pk.createdAt,
+          lastUsedAt: pk.lastUsedAt,
+        })),
+        allAcceptedCredentialIds: user.passkeys.map((pk) => pk.id),
+      },
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { action, username, password, displayName } = body;
+    const { rpID } = getRPConfig(request);
+
+    if (action === 'logout') {
+      await session?.set('userId', undefined);
+      await session?.set('reauthenticatedAt', undefined);
+      return new Response(JSON.stringify({ success: true }), {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (action === 'register') {
+      if (!username || !password) {
+        return new Response(
+          JSON.stringify({ error: 'APP_ERR_1002: Username and password are required' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      if (password.length < 8 || !/\d/.test(password)) {
+        return new Response(
+          JSON.stringify({ error: 'APP_ERR_1003: Password must be at least 8 characters and contain a number' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      const existing = findUserByUsername(username);
+      if (existing && existing.passwordHash) {
+        return new Response(
+          JSON.stringify({ error: 'APP_ERR_1001: Username already exists' }),
+          { status: 409, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      const user = existing
+        ? updateUserDetails(existing.id, { username, displayName: displayName || username, password })
+        : createUser(username, password, displayName);
+
+      await session?.set('userId', user.id);
+      await session?.set('reauthenticatedAt', Date.now());
+
+      return new Response(
+        JSON.stringify({
+          success: true,
+          rpID,
+          user: {
+            id: user.id,
+            username: user.username,
+            displayName: user.displayName,
+            allAcceptedCredentialIds: user.passkeys.map((pk) => pk.id),
+          },
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'login') {
+      if (!username || !password) {
+        return new Response(
+          JSON.stringify({ error: 'APP_ERR_2001: Username and password are required' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      let user = findUserByUsername(username);
+      if (!user) {
+        // Auto-provision demo account on password login if it doesn't exist yet so testing is seamless
+        if (password.length >= 6) {
+          user = createUser(username, password, displayName || username);
+        } else {
+          return new Response(
+            JSON.stringify({ error: 'APP_ERR_2002: Invalid username or password' }),
+            { status: 401, headers: { 'Content-Type': 'application/json' } }
+          );
+        }
+      } else if (user.passwordHash && !verifyPassword(password, user.passwordHash)) {
+        return new Response(
+          JSON.stringify({ error: 'APP_ERR_2002: Invalid username or password' }),
+          { status: 401, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      await session?.set('userId', user.id);
+      await session?.set('reauthenticatedAt', Date.now());
+
+      return new Response(
+        JSON.stringify({
+          success: true,
+          rpID,
+          user: {
+            id: user.id,
+            username: user.username,
+            displayName: user.displayName,
+            allAcceptedCredentialIds: user.passkeys.map((pk) => pk.id),
+          },
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'reauthenticate-password') {
+      const userId = await session?.get('userId');
+      if (!userId) {
+        return new Response(JSON.stringify({ error: 'Not signed in' }), {
+          status: 401,
+          headers: { 'Content-Type': 'application/json' },
+        });
+      }
+      const user = findUserById(userId);
+      if (!user || !password || (user.passwordHash && !verifyPassword(password, user.passwordHash))) {
+        return new Response(JSON.stringify({ error: 'Invalid password' }), {
+          status: 401,
+          headers: { 'Content-Type': 'application/json' },
+        });
+      }
+      const now = Date.now();
+      await session?.set('reauthenticatedAt', now);
+      return new Response(
+        JSON.stringify({ success: true, reauthenticatedAt: now }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'update-profile') {
+      const userId = await session?.get('userId');
+      if (!userId) {
+        return new Response(JSON.stringify({ error: 'Not signed in' }), {
+          status: 401,
+          headers: { 'Content-Type': 'application/json' },
+        });
+      }
+      const updated = updateUserDetails(userId, { username, displayName, password });
+      return new Response(
+        JSON.stringify({
+          success: true,
+          rpID,
+          user: {
+            id: updated.id,
+            username: updated.username,
+            displayName: updated.displayName,
+            allAcceptedCredentialIds: updated.passkeys.map((pk) => pk.id),
+          },
+        }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    return new Response(JSON.stringify({ error: 'Invalid action' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Authentication error' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/auth-options.ts b/src/pages/api/passkeys/auth-options.ts
new file mode 100644
index 0000000..9212310
--- /dev/null
+++ b/src/pages/api/passkeys/auth-options.ts
@@ -0,0 +1,64 @@
+import type { APIRoute } from 'astro';
+import {
+  findUserById,
+  findUserByUsername,
+  generateAuthenticationOptions,
+  getRPConfig,
+  loadDb,
+  saveDb,
+} from '../../../utils/auth-store';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const { rpID, origin } = getRPConfig(request);
+
+    // If reauthenticating or if a specific user is known, populate allowCredentials
+    let targetUser = undefined;
+    if (body.reauthenticate) {
+      const sessionUserId = await session?.get('userId');
+      if (sessionUserId) {
+        targetUser = findUserById(sessionUserId);
+      }
+    }
+    if (!targetUser && body.username) {
+      targetUser = findUserByUsername(body.username);
+    }
+
+    const allowCredentials =
+      targetUser && targetUser.passkeys.length > 0
+        ? targetUser.passkeys.map((pk) => ({
+            id: pk.id,
+            transports: pk.transports as any,
+          }))
+        : undefined;
+
+    const options = await generateAuthenticationOptions({
+      rpID,
+      allowCredentials,
+      userVerification: 'preferred',
+    });
+
+    await session?.set('currentAuthChallenge', options.challenge);
+
+    const db = loadDb();
+    db.challenges[options.challenge] = {
+      challenge: options.challenge,
+      userId: targetUser?.id,
+      rpID,
+      origin,
+      expiresAt: Date.now() + 5 * 60 * 1000,
+    };
+    saveDb(db);
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to generate authentication options' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/auth-verify.ts b/src/pages/api/passkeys/auth-verify.ts
new file mode 100644
index 0000000..8ba0949
--- /dev/null
+++ b/src/pages/api/passkeys/auth-verify.ts
@@ -0,0 +1,111 @@
+import type { APIRoute } from 'astro';
+import {
+  findUserByCredentialId,
+  findUserById,
+  getRPConfig,
+  isoBase64URL,
+  loadDb,
+  saveDb,
+  verifyAuthenticationResponse,
+} from '../../../utils/auth-store';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const credential = body.credential || body;
+    const isReauth = Boolean(body.reauthenticate);
+
+    const { rpID, origin } = getRPConfig(request);
+    const sessionChallenge = await session?.get('currentAuthChallenge');
+    const sessionUserId = await session?.get('userId');
+
+    const match = findUserByCredentialId(credential.id);
+    if (!match) {
+      // Return unknownCredential flag so the client can call PublicKeyCredential.signalUnknownCredential
+      return new Response(
+        JSON.stringify({
+          verified: false,
+          unknownCredential: true,
+          rpID,
+          credentialId: credential.id,
+          error: 'Passkey is no longer recognized by the server.',
+        }),
+        { status: 404, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const { user, passkey } = match;
+
+    // If reauthenticating, ensure the passkey belongs to the currently signed-in user
+    if (isReauth && sessionUserId && user.id !== sessionUserId) {
+      const currentSessionUser = findUserById(sessionUserId);
+      if (currentSessionUser) {
+        return new Response(
+          JSON.stringify({
+            verified: false,
+            error: 'Credential does not belong to the currently signed-in user.',
+          }),
+          { status: 403, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+    }
+
+    const db = loadDb();
+
+    const verification = await verifyAuthenticationResponse({
+      response: credential,
+      expectedChallenge: (challenge) => {
+        if (sessionChallenge && challenge === sessionChallenge) return true;
+        const stored = db.challenges[challenge];
+        if (stored && stored.expiresAt > Date.now()) return true;
+        return false;
+      },
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: isoBase64URL.toBuffer(passkey.publicKey),
+        counter: passkey.counter,
+        transports: passkey.transports as any,
+      },
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified) {
+      return new Response(
+        JSON.stringify({ verified: false, error: 'Passkey signature verification failed' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Update signature counter and lastUsedAt timestamp
+    passkey.counter = verification.authenticationInfo.newCounter;
+    passkey.lastUsedAt = new Date().toISOString();
+    saveDb(db);
+
+    const now = Date.now();
+    await session?.set('userId', user.id);
+    await session?.set('reauthenticatedAt', now);
+    await session?.set('currentAuthChallenge', undefined);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        rpID,
+        reauthenticatedAt: now,
+        user: {
+          id: user.id,
+          username: user.username,
+          displayName: user.displayName,
+          allAcceptedCredentialIds: user.passkeys.map((pk) => pk.id),
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ verified: false, error: err?.message || 'Passkey authentication failed' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/index.ts b/src/pages/api/passkeys/index.ts
new file mode 100644
index 0000000..058c560
--- /dev/null
+++ b/src/pages/api/passkeys/index.ts
@@ -0,0 +1,149 @@
+import type { APIRoute } from 'astro';
+import { findUserById, getRPConfig, loadDb, saveDb } from '../../../utils/auth-store';
+
+export const GET: APIRoute = async ({ request, session }) => {
+  const { rpID } = getRPConfig(request);
+  const userId = await session?.get('userId');
+  if (!userId) {
+    return new Response(JSON.stringify({ error: 'Unauthorized' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = findUserById(userId);
+  if (!user) {
+    return new Response(JSON.stringify({ error: 'User not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  return new Response(
+    JSON.stringify({
+      rpID,
+      userId: user.id,
+      username: user.username,
+      displayName: user.displayName,
+      passkeys: user.passkeys.map((pk) => ({
+        id: pk.id,
+        name: pk.name,
+        aaguid: pk.aaguid,
+        providerName: pk.providerName,
+        deviceType: pk.deviceType,
+        backedUp: pk.backedUp,
+        transports: pk.transports,
+        createdAt: pk.createdAt,
+        lastUsedAt: pk.lastUsedAt,
+      })),
+      allAcceptedCredentialIds: user.passkeys.map((pk) => pk.id),
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  try {
+    const userId = await session?.get('userId');
+    if (!userId) {
+      return new Response(JSON.stringify({ error: 'Unauthorized' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const { credentialId, name } = await request.json();
+    if (!credentialId || !name || typeof name !== 'string') {
+      return new Response(JSON.stringify({ error: 'Credential ID and new name are required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const db = loadDb();
+    const user = db.users[userId];
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'User not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const passkey = user.passkeys.find((pk) => pk.id === credentialId);
+    if (!passkey) {
+      return new Response(JSON.stringify({ error: 'Passkey not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    passkey.name = name.trim();
+    saveDb(db);
+
+    const { rpID } = getRPConfig(request);
+    return new Response(
+      JSON.stringify({
+        success: true,
+        rpID,
+        passkey,
+        allAcceptedCredentialIds: user.passkeys.map((pk) => pk.id),
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Failed to rename passkey' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  try {
+    const userId = await session?.get('userId');
+    if (!userId) {
+      return new Response(JSON.stringify({ error: 'Unauthorized' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const body = await request.json();
+    const credentialId = body.credentialId || body.id;
+    if (!credentialId) {
+      return new Response(JSON.stringify({ error: 'Credential ID is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const db = loadDb();
+    const user = db.users[userId];
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'User not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    user.passkeys = user.passkeys.filter((pk) => pk.id !== credentialId);
+    saveDb(db);
+
+    const { rpID } = getRPConfig(request);
+    return new Response(
+      JSON.stringify({
+        success: true,
+        rpID,
+        userId: user.id,
+        deletedCredentialId: credentialId,
+        allAcceptedCredentialIds: user.passkeys.map((pk) => pk.id),
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Failed to delete passkey' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
