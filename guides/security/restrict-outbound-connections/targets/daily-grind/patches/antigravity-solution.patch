+import { fetchWithPolicyHandling } from './policy.js';
+
+const form = document.getElementById('newsletter-form');
+const emailInput = document.getElementById('newsletter-email');
+const statusEl = document.getElementById('newsletter-status');
+const submitBtn = document.getElementById('newsletter-submit');
+
+function showStatus(type, message) {
+  if (!statusEl) return;
+  statusEl.hidden = false;
+  statusEl.dataset.state = type;
+  statusEl.className = `newsletter-status status-${type}`;
+  statusEl.textContent = message;
+}
+
+if (form) {
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const email = emailInput ? emailInput.value.trim() : '';
+    if (!email) {
+      showStatus('error', 'Please enter a valid email address to subscribe.');
+      return;
+    }
+
+    // Use the form's action attribute (defaults to '/api/newsletter' on our own server,
+    // or if an injected script tampers with form.action or target endpoint, Connection-Allowlist
+    // and CSP will block any unauthorized outbound destination).
+    const endpoint = form.getAttribute('action') || '/api/newsletter';
+
+    if (submitBtn) submitBtn.disabled = true;
+    showStatus('pending', 'Sending your subscription request...');
+
+    const result = await fetchWithPolicyHandling(endpoint, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Accept: 'application/json',
+      },
+      body: JSON.stringify({ email }),
+      statusElement: statusEl,
+    });
+
+    if (submitBtn) submitBtn.disabled = false;
+
+    if (result.ok) {
+      const msg =
+        result.data?.message ||
+        `Thanks for subscribing! Confirmation sent for ${email}.`;
+      showStatus('allowed', msg);
+      form.reset();
+    } else {
+      const errDetail =
+        result.error instanceof Error ? result.error.message : String(result.error);
+      showStatus(
+        'blocked',
+        `Sorry, your request to ${endpoint} could not go through because it was blocked by our outbound connection security policy (${errDetail}).`,
+      );
+    }
+  });
+}
+
+// Expose helper on window so tests or interactive diagnostics can invoke outbound requests
+// and observe the customer-facing message when a request cannot go through.
+window.fetchWithPolicyHandling = fetchWithPolicyHandling;
+window.submitNewsletterRequest = async function submitNewsletterRequest(
+  email,
+  targetUrl = '/api/newsletter',
+) {
+  if (statusEl) statusEl.hidden = false;
+  const result = await fetchWithPolicyHandling(targetUrl, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      Accept: 'application/json',
+    },
+    body: JSON.stringify({ email }),
+    statusElement: statusEl,
+  });
+  if (!result.ok) {
+    const errDetail =
+      result.error instanceof Error ? result.error.message : String(result.error);
+    showStatus(
+      'blocked',
+      `Sorry, your request to ${targetUrl} could not go through because it was blocked by our outbound connection security policy (${errDetail}).`,
+    );
+  }
+  return result;
+};
