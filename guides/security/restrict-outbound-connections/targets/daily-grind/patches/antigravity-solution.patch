+// Outbound fetch helper that handles requests blocked by the connection policy.
+async function fetchWithPolicyHandling(url, { statusElement, ...fetchOptions } = {}) {
+  const el = statusElement || (typeof document !== 'undefined' ? (document.getElementById('network-status') || document.getElementById('status')) : null);
+  try {
+    const response = await fetch(url, fetchOptions);
+    if (!response.ok) throw new Error(`HTTP ${response.status}`);
+    const body = await response.text();
+    const msg = `Allowed: Loaded ${url} (${body.length} bytes).`;
+    if (el) {
+      el.textContent = msg;
+    }
+    if (typeof document !== 'undefined') {
+      const s1 = document.getElementById('network-status');
+      const s2 = document.getElementById('status');
+      if (s1 && s1 !== el) s1.textContent = msg;
+      if (s2 && s2 !== el) s2.textContent = msg;
+    }
+    return { ok: true, body, error: null };
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    const feedback = `Blocked: Request to ${url} was rejected by the outbound connection policy (${message}).`;
+    if (el) {
+      el.textContent = feedback;
+    }
+    if (typeof document !== 'undefined') {
+      const s1 = document.getElementById('network-status');
+      const s2 = document.getElementById('status');
+      if (s1 && s1 !== el) s1.textContent = feedback;
+      if (s2 && s2 !== el) s2.textContent = feedback;
+    }
+    return { ok: false, body: null, error };
+  }
+}
+
+if (typeof window !== 'undefined') {
+  window.fetchWithPolicyHandling = fetchWithPolicyHandling;
+}
+if (typeof globalThis !== 'undefined') {
+  globalThis.fetchWithPolicyHandling = fetchWithPolicyHandling;
+}
+
+if (typeof document !== 'undefined') {
+  const statusElement = document.getElementById('network-status') || document.getElementById('status');
+
+  document.getElementById('check-network')?.addEventListener('click', async () => {
+    await fetchWithPolicyHandling('/', { statusElement });
+    const own = statusElement ? statusElement.textContent : '';
+    await fetchWithPolicyHandling('https://third-party.example.net/collect', { statusElement });
+    if (statusElement) {
+      statusElement.textContent = `${own} ${statusElement.textContent}`.trim();
+      const s2 = document.getElementById('status');
+      if (s2 && s2 !== statusElement) s2.textContent = statusElement.textContent;
+    }
+  });
+
+  document.getElementById('btn-fetch-allowed')?.addEventListener('click', () => {
+    fetchWithPolicyHandling('/', { statusElement });
+  });
+
+  document.getElementById('btn-fetch-blocked')?.addEventListener('click', () => {
+    fetchWithPolicyHandling('https://third-party.example.net/collect', { statusElement });
+  });
+}
