new file mode 100644
index 0000000..ea9e09d
--- /dev/null
+++ b/server.js
@@ -0,0 +1,212 @@
+import http from 'node:http';
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  ALLOWED_PATTERNS,
+  buildCspHeader,
+  setConnectionAllowlistHeaders,
+} from './policy.js';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.mjs': 'text/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.ico': 'image/x-icon',
+};
+
+const subscribers = new Set();
+const securityReports = [];
+
+function computeInlineStyleHashes(htmlContent) {
+  const hashes = [];
+  const styleRegex = /<style(?:\s[^>]*)?>([\s\S]*?)<\/style>/gi;
+  let match;
+  while ((match = styleRegex.exec(htmlContent)) !== null) {
+    const hash = crypto.createHash('sha256').update(match[1], 'utf8').digest('base64');
+    hashes.push(`'sha256-${hash}'`);
+  }
+  return hashes;
+}
+
+function readRequestBody(req) {
+  return new Promise((resolve, reject) => {
+    let body = '';
+    req.setEncoding('utf8');
+    req.on('data', (chunk) => {
+      body += chunk;
+      if (body.length > 1e6) {
+        reject(new Error('Payload too large'));
+        req.destroy();
+      }
+    });
+    req.on('end', () => resolve(body));
+    req.on('error', reject);
+  });
+}
+
+function parseEmailFromBody(rawBody, contentType = '') {
+  if (!rawBody) return '';
+  if (contentType.includes('application/x-www-form-urlencoded')) {
+    const params = new URLSearchParams(rawBody);
+    return (params.get('email') || '').trim();
+  }
+  try {
+    const parsed = JSON.parse(rawBody);
+    return typeof parsed?.email === 'string' ? parsed.email.trim() : '';
+  } catch {
+    const params = new URLSearchParams(rawBody);
+    return (params.get('email') || '').trim();
+  }
+}
+
+export async function handleRequest(req, res) {
+  const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+  const pathname = url.pathname;
+  const secFetchDest = req.headers['sec-fetch-dest'];
+  const origin = `${url.protocol}//${url.host}`;
+  const reportEndpointUrl = `${origin}/api/security-reports`;
+
+  // Newsletter subscription endpoint on our own server
+  if (
+    pathname === '/api/newsletter' ||
+    pathname === '/newsletter' ||
+    pathname === '/api/subscribe' ||
+    pathname === '/subscribe'
+  ) {
+    if (req.method === 'POST') {
+      try {
+        const rawBody = await readRequestBody(req);
+        const email = parseEmailFromBody(rawBody, req.headers['content-type'] || '');
+        if (!email || !email.includes('@')) {
+          res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+          res.end(
+            JSON.stringify({
+              ok: false,
+              message: 'Please provide a valid email address.',
+            }),
+          );
+          return;
+        }
+        subscribers.add(email.toLowerCase());
+        res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(
+          JSON.stringify({
+            ok: true,
+            email,
+            message: `Thanks for subscribing! ${email} has been added to The Daily Grind newsletter.`,
+          }),
+        );
+      } catch {
+        res.writeHead(400, { 'Content-Type': 'application/json; charset=utf-8' });
+        res.end(JSON.stringify({ ok: false, message: 'Invalid request payload.' }));
+      }
+      return;
+    }
+
+    if (req.method === 'GET') {
+      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(JSON.stringify({ ok: true, count: subscribers.size }));
+      return;
+    }
+  }
+
+  // Violation reporting endpoint for Connection-Allowlist and CSP
+  if (pathname === '/api/security-reports') {
+    if (req.method === 'POST') {
+      try {
+        const rawBody = await readRequestBody(req);
+        const parsed = rawBody ? JSON.parse(rawBody) : [];
+        const entries = Array.isArray(parsed) ? parsed : [parsed];
+        securityReports.push(...entries);
+      } catch {
+        // Ignore malformed report payloads
+      }
+      res.writeHead(204);
+      res.end();
+      return;
+    }
+    if (req.method === 'GET') {
+      res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(JSON.stringify({ reports: securityReports }));
+      return;
+    }
+  }
+
+  // Serve static files
+  const safePath = pathname === '/' ? '/index.html' : pathname;
+  const resolvedPath = path.resolve(__dirname, `.${safePath}`);
+  if (!resolvedPath.startsWith(__dirname)) {
+    res.writeHead(403, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Forbidden');
+    return;
+  }
+
+  try {
+    const stat = await fs.stat(resolvedPath);
+    const filePath = stat.isDirectory() ? path.join(resolvedPath, 'index.html') : resolvedPath;
+    const ext = path.extname(filePath).toLowerCase();
+    const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+    const content = await fs.readFile(filePath);
+
+    const isDocument = ext === '.html';
+    const isWorkerDest =
+      secFetchDest &&
+      ['worker', 'sharedworker', 'serviceworker'].includes(String(secFetchDest).toLowerCase());
+
+    if (isDocument || isWorkerDest) {
+      const styleHashes = isDocument
+        ? computeInlineStyleHashes(content.toString('utf8'))
+        : [];
+      const csp = buildCspHeader({
+        reportTo: 'conn-reports',
+        styleHashes: [...styleHashes, "'unsafe-inline'"],
+      });
+      setConnectionAllowlistHeaders(res, {
+        secFetchDest: secFetchDest || (isDocument ? 'document' : 'worker'),
+        patterns: ALLOWED_PATTERNS,
+        reportEndpointName: 'conn-reports',
+        reportEndpointUrl,
+        redirects: 'block',
+        webrtc: 'block',
+        csp,
+      });
+    } else {
+      res.setHeader('Vary', 'Sec-Fetch-Dest');
+    }
+
+    res.writeHead(200, { 'Content-Type': contentType });
+    res.end(content);
+  } catch {
+    res.setHeader('Vary', 'Sec-Fetch-Dest');
+    res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+    res.end('Not Found');
+  }
+}
+
+export function createServer() {
+  return http.createServer((req, res) => {
+    handleRequest(req, res).catch((err) => {
+      res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end(`Internal Server Error: ${err instanceof Error ? err.message : String(err)}`);
+    });
+  });
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === __filename) {
+  const port = Number(process.env.PORT) || 11222;
+  const server = createServer();
+  server.listen(port, () => {
+    console.log(`Server listening on http://localhost:${port}`);
+  });
+}
