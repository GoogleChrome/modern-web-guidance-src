@@ -0,0 +1,67 @@
+import { fetchWithPolicyHandling } from './connection-allowlist.js';
+
+export { fetchWithPolicyHandling };
+
+export function initNewsletterForm() {
+  const form = document.getElementById('newsletter-form');
+  const emailInput = document.getElementById('newsletter-email');
+  const statusEl = document.getElementById('newsletter-status');
+
+  if (!form || !emailInput || !statusEl) return;
+
+  const updateStatus = (text, state) => {
+    statusEl.textContent = text;
+    statusEl.dataset.state = state;
+    statusEl.className = `status-message status-${state}`;
+    statusEl.hidden = false;
+  };
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const email = emailInput.value.trim();
+    if (!email) {
+      updateStatus('Please enter a valid email address.', 'error');
+      return;
+    }
+
+    const endpoint = form.getAttribute('action') || '/api/newsletter';
+    updateStatus('Sending signup request...', 'pending');
+
+    const result = await fetchWithPolicyHandling(endpoint, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+        Accept: 'application/json',
+      },
+      body: JSON.stringify({ email }),
+    });
+
+    if (result.ok) {
+      let successMsg = `Thanks for subscribing, ${email}! Check your inbox for fresh roast updates.`;
+      try {
+        const parsed = JSON.parse(result.body);
+        if (parsed && parsed.message) {
+          successMsg = parsed.message;
+        }
+      } catch {
+        // Use default message if response body is not JSON
+      }
+      updateStatus(successMsg, 'success');
+      form.reset();
+    } else {
+      const reason = result.error instanceof Error ? result.error.message : String(result.error);
+      updateStatus(
+        `Request could not go through: Request to ${endpoint} was blocked or failed (${reason}). Your email was not sent outside our server.`,
+        'error',
+      );
+    }
+  });
+}
+
+if (typeof document !== 'undefined') {
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initNewsletterForm);
+  } else {
+    initNewsletterForm();
+  }
+}
