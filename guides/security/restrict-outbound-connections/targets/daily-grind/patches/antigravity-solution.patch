+++ b/server.js
@@ -0,0 +1,202 @@
+import crypto from 'node:crypto';
+import fs from 'node:fs/promises';
+import http from 'node:http';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  buildConnectionAllowlistHeader,
+  buildContentSecurityPolicyHeader,
+  normalizeAllowlistPattern,
+  setConnectionAllowlistHeaders,
+} from './connection-allowlist.js';
+
+export {
+  buildConnectionAllowlistHeader,
+  buildContentSecurityPolicyHeader,
+  normalizeAllowlistPattern,
+  setConnectionAllowlistHeaders,
+};
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+
+const ALLOWED_PATTERNS = ['https://images.unsplash.com'];
+const REPORT_ENDPOINT_NAME = 'conn-reports';
+const REPORT_ENDPOINT_PATH = '/api/security-reports';
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'text/javascript; charset=utf-8',
+  '.mjs': 'text/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.ico': 'image/x-icon',
+};
+
+const subscribers = new Set();
+const securityReports = [];
+
+function extractInlineStyleHashes(html) {
+  const hashes = [];
+  const styleRegex = /<style(?:\s[^>]*)?>([\s\S]*?)<\/style>/gi;
+  let match;
+  while ((match = styleRegex.exec(html)) !== null) {
+    const digest = crypto.createHash('sha256').update(match[1], 'utf8').digest('base64');
+    hashes.push(`sha256-${digest}`);
+  }
+  return hashes;
+}
+
+async function readRequestBody(req) {
+  const chunks = [];
+  for await (const chunk of req) {
+    chunks.push(typeof chunk === 'string' ? Buffer.from(chunk) : chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+function parseEmailFromBody(rawBody, contentType = '') {
+  if (!rawBody) return '';
+  if (contentType.includes('application/x-www-form-urlencoded')) {
+    const params = new URLSearchParams(rawBody);
+    return (params.get('email') || '').trim();
+  }
+  try {
+    const parsed = JSON.parse(rawBody);
+    return typeof parsed?.email === 'string' ? parsed.email.trim() : '';
+  } catch {
+    const params = new URLSearchParams(rawBody);
+    return (params.get('email') || '').trim();
+  }
+}
+
+export function createAppServer({ rootDir = __dirname } = {}) {
+  return http.createServer(async (req, res) => {
+    try {
+      const host = req.headers.host || `localhost:${process.env.PORT || 11222}`;
+      const protocol = req.headers['x-forwarded-proto'] || 'http';
+      const url = new URL(req.url || '/', `${protocol}://${host}`);
+      const pathname = url.pathname;
+
+      const reportEndpointUrl = `${protocol}://${host}${REPORT_ENDPOINT_PATH}`;
+
+      // Handle violation reports sent by browser Reporting API
+      if (pathname === REPORT_ENDPOINT_PATH && req.method === 'POST') {
+        const bodyText = await readRequestBody(req);
+        try {
+          const parsed = JSON.parse(bodyText);
+          const reports = Array.isArray(parsed) ? parsed : [parsed];
+          securityReports.push(...reports);
+        } catch {
+          // Ignore malformed report payloads
+        }
+        res.statusCode = 204;
+        res.end();
+        return;
+      }
+
+      // Handle newsletter signup endpoint (/api/newsletter or /newsletter)
+      if ((pathname === '/api/newsletter' || pathname === '/newsletter') && req.method === 'POST') {
+        const rawBody = await readRequestBody(req);
+        const contentType = String(req.headers['content-type'] || '');
+        const email = parseEmailFromBody(rawBody, contentType);
+
+        if (!email || !email.includes('@')) {
+          res.statusCode = 400;
+          res.setHeader('Content-Type', 'application/json; charset=utf-8');
+          res.end(JSON.stringify({ ok: false, error: 'Please provide a valid email address.' }));
+          return;
+        }
+
+        subscribers.add(email.toLowerCase());
+        res.statusCode = 200;
+        res.setHeader('Content-Type', 'application/json; charset=utf-8');
+        res.end(
+          JSON.stringify({
+            ok: true,
+            email,
+            message: `Thanks for subscribing, ${email}! You're on the Daily Grind newsletter list.`,
+          }),
+        );
+        return;
+      }
+
+      if (req.method !== 'GET' && req.method !== 'HEAD') {
+        res.statusCode = 405;
+        res.setHeader('Content-Type', 'application/json; charset=utf-8');
+        res.end(JSON.stringify({ ok: false, error: 'Method Not Allowed' }));
+        return;
+      }
+
+      const relativePath = pathname === '/' || pathname === '/index.html' ? 'index.html' : pathname.slice(1);
+      const safePath = path.normalize(relativePath).replace(/^(\.\.(\/|\\|$))+/, '');
+      const filePath = path.join(rootDir, safePath);
+
+      if (!filePath.startsWith(rootDir)) {
+        res.statusCode = 403;
+        res.end('Forbidden');
+        return;
+      }
+
+      let content;
+      let ext = path.extname(filePath).toLowerCase();
+      try {
+        content = await fs.readFile(filePath);
+      } catch {
+        res.statusCode = 404;
+        res.setHeader('Content-Type', 'text/plain; charset=utf-8');
+        res.end('Not Found');
+        return;
+      }
+
+      const isHtml = ext === '.html';
+      const isWorkerScript =
+        ['worker', 'sharedworker', 'serviceworker'].includes(
+          String(req.headers['sec-fetch-dest'] || '').toLowerCase(),
+        ) || /(?:^|\/)(?:sw|service-worker|worker)\.m?js$/i.test(pathname);
+
+      // Default Sec-Fetch-Dest to 'document' for HTML document navigation requests when header is absent
+      // (e.g., direct HTTP tests or clients that omit Sec-Fetch-Dest) and 'worker' for worker scripts.
+      const defaultDest = isHtml ? 'document' : isWorkerScript ? 'worker' : 'empty';
+      const secFetchDest = req.headers['sec-fetch-dest'] || defaultDest;
+
+      const inlineStyleHashes = isHtml ? extractInlineStyleHashes(content.toString('utf8')) : [];
+
+      setConnectionAllowlistHeaders(res, {
+        secFetchDest,
+        patterns: ALLOWED_PATTERNS,
+        reportEndpointName: REPORT_ENDPOINT_NAME,
+        reportEndpointUrl,
+        redirects: 'block',
+        webrtc: 'block',
+        inlineStyleHashes,
+      });
+
+      res.statusCode = 200;
+      res.setHeader('Content-Type', MIME_TYPES[ext] || 'application/octet-stream');
+      if (req.method === 'HEAD') {
+        res.end();
+      } else {
+        res.end(content);
+      }
+    } catch (err) {
+      res.statusCode = 500;
+      res.setHeader('Content-Type', 'application/json; charset=utf-8');
+      res.end(JSON.stringify({ ok: false, error: 'Internal Server Error' }));
+    }
+  });
+}
+
+const isMain =
+  process.argv[1] && path.resolve(process.argv[1]) === path.resolve(fileURLToPath(import.meta.url));
+
+if (isMain) {
+  const port = Number(process.env.PORT) || 11222;
+  const server = createAppServer();
+  server.listen(port, () => {
+    console.log(`Daily Grind server listening on http://localhost:${port}`);
+  });
+}
