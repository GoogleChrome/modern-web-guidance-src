@@ -0,0 +1,30 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { extname, join, normalize } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { setConnectionAllowlistHeaders } from './connection-policy.mjs';
+
+const root = fileURLToPath(new URL('.', import.meta.url));
+const types = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.mjs': 'text/javascript' };
+const publicFiles = new Set(['/index.html', '/app.js']);
+
+createServer(async (req, res) => {
+  const path = new URL(req.url, 'http://localhost').pathname;
+  if (path === '/api/security-reports') {
+    req.resume();
+    res.writeHead(204).end();
+    return;
+  }
+  const file = path === '/' ? '/index.html' : normalize(path);
+  setConnectionAllowlistHeaders(res, { secFetchDest: req.headers['sec-fetch-dest'] });
+  if (!publicFiles.has(file)) {
+    res.writeHead(404, { 'Content-Type': 'text/plain' }).end('Not found');
+    return;
+  }
+  try {
+    const body = await readFile(join(root, file));
+    res.writeHead(200, { 'Content-Type': types[extname(file)] ?? 'application/octet-stream' }).end(body);
+  } catch {
+    res.writeHead(404).end('Not found');
+  }
+}).listen(Number(process.env.PORT) || 11222);
