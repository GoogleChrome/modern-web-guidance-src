+type FetchResult = { ok: true; body: string; error: null } | { ok: false; body: null; error: string };
+
+export async function fetchWithPolicyHandling(url: string, statusElement: HTMLElement): Promise<FetchResult> {
+  statusElement.textContent = 'Checking connection…';
+  try {
+    const response = await fetch(url);
+    if (!response.ok) throw new Error(`HTTP ${response.status}`);
+    const body = await response.text();
+    statusElement.textContent = 'Allowed: The request completed successfully.';
+    return { ok: true, body, error: null };
+  } catch (error: unknown) {
+    const message = error instanceof Error ? error.message : String(error);
+    statusElement.textContent = `Blocked or unavailable: The request could not complete. The outbound policy may have rejected it (${message}).`;
+    return { ok: false, body: null, error: message };
+  }
+}
+
+const status = document.getElementById('connection-status');
+if (status) {
+  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-request-url]')) {
+    button.addEventListener('click', async () => {
+      button.disabled = true;
+      try { await fetchWithPolicyHandling(button.dataset.requestUrl ?? '/api/health', status); }
+      finally { button.disabled = false; }
+    });
+  }
+}
diff --git a/src/policy.ts b/src/policy.ts
new file mode 100644
index 0000000..595c8cb
--- /dev/null
+++ b/src/policy.ts
@@ -0,0 +1,79 @@
+import type { ServerResponse } from 'node:http';
+
+const POLICY_DESTINATIONS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+export const EXTERNAL_PATTERNS = ['https://images.unsplash.com'] as const;
+const REPORT_NAME = 'conn-reports';
+export const CSP = [
+  "default-src 'self'",
+  "connect-src 'self' https://images.unsplash.com",
+  "img-src 'self' https://images.unsplash.com data: blob:",
+  "style-src 'self'",
+  "script-src 'self'",
+  "font-src 'self'",
+  "form-action 'self'",
+  "worker-src 'self'",
+  "object-src 'none'",
+  "base-uri 'self'",
+  `report-to ${REPORT_NAME}`,
+].join('; ');
+
+export function normalizeAllowlistPattern(pattern: string | URL): string {
+  const normalized = String(pattern).trim().replace(/^ws(s?):\/\//i, 'http$1://');
+  if (!/^https?:\/\/[^/?#]+/i.test(normalized) || /[\s,()]/.test(normalized)
+      || /[^\x20-\x7e]/.test(normalized)) {
+    throw new Error('Allowlist patterns require an HTTP(S) hostname and cannot contain whitespace, commas or regex groups.');
+  }
+  return normalized.replace(/^(https?:\/\/[^/?#]+)\/$/i, '$1');
+}
+
+interface AllowlistOptions {
+  allowSelf?: boolean;
+  patterns?: readonly (string | URL)[];
+  reportTo?: string;
+  redirects?: 'block' | 'allow';
+  webrtc?: 'block' | 'allow';
+}
+
+export function buildConnectionAllowlistHeader({
+  allowSelf = true, patterns = [], reportTo = REPORT_NAME, redirects = 'block', webrtc = 'block',
+}: AllowlistOptions = {}): string {
+  const items = new Set<string>(allowSelf ? ['response-origin'] : []);
+  for (const pattern of patterns) {
+    if (String(pattern).trim() === 'response-origin') items.add('response-origin');
+    else items.add(`"${normalizeAllowlistPattern(pattern).replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`);
+  }
+  let value = `(${[...items].join(' ')})`;
+  if (redirects === 'allow') value += '; redirects=allow';
+  if (webrtc === 'allow') value += '; webrtc=allow';
+  if (reportTo) {
+    if (!/^[a-z*][a-z0-9_.*-]*$/.test(reportTo)) throw new Error('Invalid reporting endpoint name.');
+    value += `; report-to=${reportTo}`;
+  }
+  return value;
+}
+
+interface PolicyOptions {
+  destination?: string;
+  isDocument?: boolean;
+  isWorker?: boolean;
+  reportOnly?: boolean;
+  reportOnlyPatterns?: readonly (string | URL)[];
+}
+
+export function setConnectionAllowlistHeaders(res: ServerResponse, {
+  destination, isDocument = false, isWorker = false, reportOnly = false, reportOnlyPatterns,
+}: PolicyOptions = {}): void {
+  const existing = String(res.getHeader('Vary') ?? '').split(',').map(value => value.trim()).filter(Boolean);
+  if (!existing.some(value => value.toLowerCase() === 'sec-fetch-dest')) existing.push('Sec-Fetch-Dest');
+  res.setHeader('Vary', existing.join(', '));
+  // Apply by response type too, covering direct requests without Fetch Metadata.
+  if (!isDocument && !isWorker && !POLICY_DESTINATIONS.has(destination?.toLowerCase() ?? '')) return;
+  res.setHeader('Reporting-Endpoints', `${REPORT_NAME}="/api/security-reports"`);
+  res.setHeader('Content-Security-Policy', CSP);
+  // All workers use the same superset as controlled documents, including service workers.
+  res.setHeader(reportOnly ? 'Connection-Allowlist-Report-Only' : 'Connection-Allowlist',
+    buildConnectionAllowlistHeader({ patterns: EXTERNAL_PATTERNS }));
+  if (!reportOnly && reportOnlyPatterns) {
+    res.setHeader('Connection-Allowlist-Report-Only', buildConnectionAllowlistHeader({ patterns: reportOnlyPatterns }));
+  }
+}
