diff --git a/security.mjs b/security.mjs
new file mode 100644
index 0000000..2e7e8cd
--- /dev/null
+++ b/security.mjs
@@ -0,0 +1,9 @@
+// Apply the same policy to documents and every worker script, including service
+// workers. Applying it unconditionally also avoids cache variants by destination.
+export const securityHeaders = {
+  'Connection-Allowlist': '(response-origin "https://images.unsplash.com"); report-to=conn-reports',
+  'Reporting-Endpoints': 'conn-reports="/api/security-reports"',
+  'Content-Security-Policy': "default-src 'self'; connect-src 'self'; img-src 'self' https://images.unsplash.com; script-src 'self'; style-src 'self'; font-src 'self'; form-action 'self'; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; report-to conn-reports",
+  'X-Content-Type-Options': 'nosniff',
+  'Referrer-Policy': 'same-origin',
+};
diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..4e53bda
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,95 @@
+import { createServer } from 'node:http';
+import { appendFile, mkdir, readFile } from 'node:fs/promises';
+import { securityHeaders } from './security.mjs';
+
+const files = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/newsletter.js', ['newsletter.js', 'text/javascript; charset=utf-8']],
+]);
+const dataDirectory = new URL('./data/', import.meta.url);
+
+class RequestError extends Error {
+  constructor(status, message) {
+    super(message);
+    this.status = status;
+  }
+}
+
+async function readBody(request, limit) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of request) {
+    size += chunk.length;
+    if (size > limit) throw new RequestError(413, 'Request is too large.');
+    chunks.push(chunk);
+  }
+  return Buffer.concat(chunks).toString('utf8');
+}
+
+const server = createServer(async (request, response) => {
+  for (const [name, value] of Object.entries(securityHeaders)) response.setHeader(name, value);
+  const json = (status, body) => {
+    response.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
+    response.end(JSON.stringify(body));
+  };
+  try {
+    const pathname = new URL(request.url ?? '/', 'http://localhost').pathname;
+    if (pathname === '/api/newsletter' || pathname === '/api/security-reports') {
+      if (request.method !== 'POST') {
+        response.setHeader('Allow', 'POST');
+        return json(405, { error: 'Use POST.' });
+      }
+      // Prevent third-party forms from submitting customer email addresses.
+      if (request.headers['sec-fetch-site'] === 'cross-site') {
+        return json(403, { error: 'Same-origin requests only.' });
+      }
+      const mediaType = request.headers['content-type']?.split(';')[0].trim().toLowerCase();
+      if (pathname === '/api/security-reports') {
+        if (mediaType !== 'application/reports+json' && mediaType !== 'application/csp-report') {
+          return json(415, { error: 'Expected a browser security report.' });
+        }
+        // Consume bounded reports without logging customer URLs or other private data.
+        await readBody(request, 65536);
+        response.writeHead(204, { 'Cache-Control': 'no-store' });
+        return response.end();
+      }
+      if (mediaType !== 'application/json') return json(415, { error: 'Expected JSON.' });
+      let body;
+      try {
+        body = JSON.parse(await readBody(request, 4096));
+      } catch (error) {
+        if (error instanceof RequestError) throw error;
+        throw new RequestError(400, 'Invalid JSON.');
+      }
+      const email = typeof body?.email === 'string' ? body.email.trim() : '';
+      if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
+        return json(400, { error: 'Enter a valid email address.' });
+      }
+      await mkdir(dataDirectory, { recursive: true, mode: 0o700 });
+      await appendFile(new URL('newsletter.jsonl', dataDirectory),
+        JSON.stringify({ email, subscribedAt: new Date().toISOString() }) + '\n', { mode: 0o600 });
+      return json(201, { message: 'Subscribed.' });
+    }
+    if (request.method !== 'GET' && request.method !== 'HEAD') {
+      response.setHeader('Allow', 'GET, HEAD');
+      return json(405, { error: 'Method not allowed.' });
+    }
+    const asset = files.get(pathname);
+    if (!asset) return json(404, { error: 'Page not found.' });
+    const content = await readFile(new URL(`dist/${asset[0]}`, import.meta.url));
+    response.writeHead(200, { 'Content-Type': asset[1], 'Cache-Control': 'no-cache' });
+    response.end(request.method === 'HEAD' ? undefined : content);
+  } catch (error) {
+    if (response.destroyed) return;
+    json(error instanceof RequestError ? error.status : 500, {
+      error: error instanceof RequestError ? error.message : 'Unable to complete the request. Please try again.',
+    });
+  }
+});
+server.requestTimeout = 15000;
+server.headersTimeout = 10000;
+const port = Number(process.env.PORT ?? 11222);
+if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error('Invalid PORT');
+server.listen(port);
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..259d7c3
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,168 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.section-title { text-align: center; }
+.newsletter { margin-top: 40px; }
+.newsletter form { max-width: 480px; margin: 20px auto 0; }
+.newsletter label { display: block; font-weight: bold; }
+.newsletter input {
+  width: 100%;
+  padding: 12px;
+  border: 1px solid var(--primary);
+  border-radius: 5px;
+  font: inherit;
+}
+.newsletter button { border: 0; font: inherit; cursor: pointer; }
+.newsletter button:disabled { opacity: 0.65; cursor: wait; }
+.newsletter [role="status"] { min-height: 3.2em; margin-top: 12px; }
+:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
+@media (max-width: 600px) {
+  nav { flex-wrap: wrap; gap: 12px; }
+  nav ul { flex-wrap: wrap; gap: 12px; }
+  nav ul li { margin-left: 0; }
+}
+
