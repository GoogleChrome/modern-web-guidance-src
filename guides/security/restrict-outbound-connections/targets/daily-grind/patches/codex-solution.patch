diff --git a/newsletter.js b/newsletter.js
new file mode 100644
index 0000000..9e7cdb1
--- /dev/null
+++ b/newsletter.js
@@ -0,0 +1,40 @@
+// @ts-check
+const form = document.querySelector('#newsletter-form');
+const email = document.querySelector('#newsletter-email');
+const button = document.querySelector('#newsletter-submit');
+const status = document.querySelector('#newsletter-status');
+
+if (form instanceof HTMLFormElement && email instanceof HTMLInputElement &&
+    button instanceof HTMLButtonElement && status instanceof HTMLElement) {
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (button.disabled || !form.reportValidity()) return;
+
+    button.disabled = true;
+    form.setAttribute('aria-busy', 'true');
+    status.textContent = 'Signing you up…';
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 10000);
+
+    try {
+      const response = await fetch('/api/newsletter', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        credentials: 'same-origin',
+        redirect: 'error',
+        signal: controller.signal,
+        body: JSON.stringify({ email: email.value.trim() }),
+      });
+      if (!response.ok) throw new Error('Signup request failed');
+      status.textContent = 'Thanks for signing up for The Daily Grind newsletter!';
+      form.reset();
+    } catch {
+      // Includes policy blocks (TypeError), offline requests, timeouts and HTTP errors.
+      status.textContent = 'We couldn’t complete your signup. Please check your connection and try again.';
+    } finally {
+      clearTimeout(timeout);
+      button.disabled = false;
+      form.removeAttribute('aria-busy');
+    }
+  });
+}
