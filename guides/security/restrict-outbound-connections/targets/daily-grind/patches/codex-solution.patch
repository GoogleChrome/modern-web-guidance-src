@@ -0,0 +1,82 @@
+import assert from 'node:assert/strict';
+import { test, after } from 'node:test';
+import { once } from 'node:events';
+import { buildConnectionAllowlistHeader, normalizeAllowlistPattern, setConnectionAllowlistHeaders } from '../dist/policy.js';
+
+test('serializes an inner list, normalizes origins and WebSocket schemes', () => {
+  assert.equal(buildConnectionAllowlistHeader({ patterns: [new URL('https://api.example.com'), 'wss://realtime.example.com/', 'https://*.cdn.example.com/*'] }),
+    '(response-origin "https://api.example.com" "https://realtime.example.com" "https://*.cdn.example.com/*"); report-to=conn-reports');
+  assert.equal(normalizeAllowlistPattern('ws://example.com/path'), 'http://example.com/path');
+  assert.equal(buildConnectionAllowlistHeader({ allowSelf: false, reportTo: '' }), '()');
+  assert.equal(buildConnectionAllowlistHeader({ redirects: 'allow', webrtc: 'allow' }),
+    '(response-origin); redirects=allow; webrtc=allow; report-to=conn-reports');
+  for (const pattern of ['/api/*', 'https://api.example.com/(a)', 'https://api.example.com,a', 'https://']) {
+    assert.throws(() => normalizeAllowlistPattern(pattern));
+  }
+  assert.throws(() => buildConnectionAllowlistHeader({ reportTo: '"conn-reports"' }));
+});
+
+test('preserves Vary and supports worker, staged and dual policies', () => {
+  for (const destination of ['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']) {
+    const headers = new Map([['Vary', 'Accept-Encoding']]);
+    const response = { getHeader: name => headers.get(name), setHeader: (name, value) => headers.set(name, value) };
+    setConnectionAllowlistHeaders(response, { destination, reportOnlyPatterns: [] });
+    assert.equal(headers.get('Vary'), 'Accept-Encoding, Sec-Fetch-Dest');
+    assert.equal(headers.get('Connection-Allowlist'), '(response-origin "https://images.unsplash.com"); report-to=conn-reports');
+    assert.equal(headers.get('Connection-Allowlist-Report-Only'), '(response-origin); report-to=conn-reports');
+  }
+  const headers = new Map();
+  const response = { getHeader: name => headers.get(name), setHeader: (name, value) => headers.set(name, value) };
+  setConnectionAllowlistHeaders(response, { destination: 'worker', reportOnly: true });
+  assert.equal(headers.has('Connection-Allowlist'), false);
+  assert.ok(headers.has('Connection-Allowlist-Report-Only'));
+});
+
+process.env.PORT = '0';
+const { server } = await import('../dist/server.js');
+if (!server.listening) await once(server, 'listening');
+after(() => new Promise(resolve => server.close(resolve)));
+const base = `http://127.0.0.1:${server.address().port}`;
+
+test('real HTTP document and worker responses contain matching policies', async () => {
+  for (const [path, destination] of [['/', 'document'], ['/menu/seasonal', 'iframe'], ['/client.js', 'worker'], ['/client.js', 'sharedworker'], ['/client.js', 'serviceworker']]) {
+    const response = await fetch(base + path, { headers: { 'Sec-Fetch-Dest': destination }, redirect: 'error' });
+    assert.equal(response.status, 200);
+    assert.equal(response.headers.get('connection-allowlist'), '(response-origin "https://images.unsplash.com"); report-to=conn-reports');
+    assert.equal(response.headers.get('reporting-endpoints'), 'conn-reports="/api/security-reports"');
+    assert.match(response.headers.get('content-security-policy'), /default-src 'self'.*connect-src 'self'.*form-action 'self'.*worker-src 'self'/);
+    assert.match(response.headers.get('vary'), /Sec-Fetch-Dest/);
+  }
+  const css = await fetch(base + '/styles.css', { headers: { 'Sec-Fetch-Dest': 'style' } });
+  assert.equal(css.headers.get('connection-allowlist'), null);
+  assert.match(css.headers.get('vary'), /Sec-Fetch-Dest/);
+  assert.equal((await fetch(base)).headers.has('connection-allowlist'), true);
+});
+
+test('same-origin connectivity and violation reporting endpoints work', async () => {
+  assert.deepEqual(await (await fetch(base + '/api/health')).json(), { ok: true });
+  const reports = [{ type: 'connection-allowlist', body: { url: base, connection: 'https://example.com/', allowlist: '(response-origin)', disposition: 'enforce' } }];
+  assert.equal((await fetch(base + '/api/security-reports', { method: 'POST', body: JSON.stringify(reports), headers: { 'Content-Type': 'application/reports+json' } })).status, 204);
+  assert.equal((await fetch(base + '/api/security-reports', { method: 'POST', body: 'invalid' })).status, 400);
+});
+
+test('client handles policy TypeError and updates visible status without rejection', async () => {
+  const originalDocument = globalThis.document;
+  const originalFetch = globalThis.fetch;
+  globalThis.document = { getElementById: () => null };
+  try {
+    const { fetchWithPolicyHandling } = await import('../dist/client.js');
+    const status = { textContent: '' };
+    globalThis.fetch = async () => { throw new TypeError('net::ERR_NETWORK_ACCESS_REVOKED'); };
+    const blocked = await fetchWithPolicyHandling('https://example.com/', status);
+    assert.equal(blocked.ok, false);
+    assert.match(status.textContent, /Blocked or unavailable/);
+    globalThis.fetch = originalFetch;
+    const allowed = await fetchWithPolicyHandling(base + '/api/health', status);
+    assert.equal(allowed.ok, true);
+    assert.match(status.textContent, /Allowed:/);
+  } finally {
+    globalThis.fetch = originalFetch;
+    globalThis.document = originalDocument;
+  }
+});
