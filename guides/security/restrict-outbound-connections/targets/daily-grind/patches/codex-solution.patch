@@ -0,0 +1,28 @@
+# The Daily Grind
+
+Run `npm run build` to generate `dist/`. Deploy with the included Node server
+(`npm start`, with optional `PORT`; default 11222) so the page, newsletter API,
+and security headers share an origin. Build before starting the server.
+
+The newsletter endpoint accepts JSON `POST /api/newsletter` with an `email`
+field. Successful submissions are appended to `data/newsletter.jsonl`; keep
+this directory on persistent storage and private to the server. A failed write
+returns an error rather than confirming a subscription. This records signups;
+delivery of newsletter emails is handled separately.
+
+Every server response carries an enforcing `Connection-Allowlist` allowing
+`response-origin` and `https://images.unsplash.com`. Redirects and WebRTC retain
+the policy's default blocking behavior. The same headers apply to worker
+responses if workers are added. CSP provides additional restrictions for browsers
+without Connection Allowlist support, including explicit same-origin form and
+worker restrictions. No inline scripts or styles are required.
+
+Browser violation reports go to the same-origin `/api/security-reports`
+endpoint, which consumes bounded reports without storing potentially sensitive
+URLs. Connect this endpoint to private monitoring if report retention is needed.
+
+`dist/_headers` also provides the policies for static hosts supporting that
+format. Static hosting alone does not implement the API endpoints; route them
+to the server on the same origin. Other hosting platforms must configure the
+equivalent HTTP response headers. Connection-Allowlist requires browser support
+and cannot be replaced with an HTML meta tag or JavaScript polyfill.
diff --git a/build.mjs b/build.mjs
new file mode 100644
index 0000000..1b774ba
--- /dev/null
+++ b/build.mjs
@@ -0,0 +1,20 @@
+import { mkdir, readFile, writeFile, copyFile } from 'node:fs/promises';
+import { execFileSync } from 'node:child_process';
+import { securityHeaders } from './security.mjs';
+
+for (const file of ['newsletter.js', 'server.mjs', 'security.mjs']) {
+  execFileSync(process.execPath, ['--check', file], { stdio: 'inherit' });
+}
+await mkdir(new URL('./dist/', import.meta.url), { recursive: true });
+for (const file of ['index.html', 'styles.css', 'newsletter.js']) {
+  await copyFile(new URL(file, import.meta.url), new URL(`dist/${file}`, import.meta.url));
+}
+// Static hosts that support _headers can enforce these policies too. The signup
+// and report endpoints still require the included server (or equivalent routes).
+await writeFile(new URL('./dist/_headers', import.meta.url),
+  '/*\n' + Object.entries(securityHeaders).map(([name, value]) => `  ${name}: ${value}\n`).join(''));
+const page = await readFile(new URL('./dist/index.html', import.meta.url), 'utf8');
+if (page.includes('<style>') || /\sstyle=/.test(page)) {
+  throw new Error('Inline styles are incompatible with the Content-Security-Policy');
+}
+console.log('Built homepage, assets and security headers.');
