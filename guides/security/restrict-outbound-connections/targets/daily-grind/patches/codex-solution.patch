diff --git a/newsletter.js b/newsletter.js
new file mode 100644
index 0000000..ff0527a
--- /dev/null
+++ b/newsletter.js
@@ -0,0 +1,44 @@
+// @ts-check
+const form = document.querySelector('#newsletter-form');
+const emailInput = document.querySelector('#newsletter-email');
+const submitButton = document.querySelector('#newsletter-form button');
+const statusElement = document.querySelector('#newsletter-status');
+
+if (form instanceof HTMLFormElement && emailInput instanceof HTMLInputElement &&
+    submitButton instanceof HTMLButtonElement && statusElement instanceof HTMLElement) {
+  let pending = false;
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (pending || !form.reportValidity()) return;
+    pending = true;
+    submitButton.disabled = true;
+    form.setAttribute('aria-busy', 'true');
+    statusElement.textContent = 'Signing you up…';
+
+    try {
+      const response = await fetch(form.action, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ email: emailInput.value.trim() }),
+        credentials: 'same-origin',
+        redirect: 'error',
+        signal: AbortSignal.timeout(15000),
+      });
+      if (!response.ok) {
+        statusElement.textContent = response.status === 400
+          ? 'Please enter a valid email address and try again.'
+          : 'We couldn’t sign you up right now. Please try again shortly.';
+        return;
+      }
+      statusElement.textContent = 'Thanks for subscribing! You’re on the list.';
+      form.reset();
+    } catch {
+      // Network failures, policy blocks, redirects, and timeouts are all handled.
+      statusElement.textContent = 'Your signup request couldn’t get through. Please check your connection and try again.';
+    } finally {
+      pending = false;
+      submitButton.disabled = false;
+      form.removeAttribute('aria-busy');
+    }
+  });
+}
