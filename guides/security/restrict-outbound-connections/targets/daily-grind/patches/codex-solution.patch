index 0000000..30c8153
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,58 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { setConnectionAllowlistHeaders } from './policy.js';
+
+const publicRoot = new URL('./public/', import.meta.url);
+const assets = new Map([
+  ['/styles.css', ['styles.css', 'text/css; charset=utf-8']],
+  ['/client.js', ['client.js', 'text/javascript; charset=utf-8']],
+]);
+
+export const server = createServer(async (req, res) => {
+  try {
+    const pathname = new URL(req.url ?? '/', 'http://localhost').pathname;
+    const dest = req.headers['sec-fetch-dest'];
+    const destination = typeof dest === 'string' ? dest : undefined;
+    res.setHeader('X-Content-Type-Options', 'nosniff');
+    if (pathname === '/api/security-reports' && req.method === 'POST') {
+      // Bounded ingestion. Do not echo or log potentially sensitive destination URLs.
+      let size = 0;
+      const chunks: Buffer[] = [];
+      for await (const chunk of req) {
+        size += Buffer.byteLength(chunk);
+        if (size > 65536) { res.writeHead(413).end(); return; }
+        chunks.push(Buffer.from(chunk));
+      }
+      try {
+        const reports: unknown = JSON.parse(Buffer.concat(chunks).toString());
+        if (!Array.isArray(reports)) throw new Error('Expected reporting batch');
+      } catch { res.writeHead(400).end(); return; }
+      res.writeHead(204).end();
+      return;
+    }
+    if (req.method !== 'GET' && req.method !== 'HEAD') { res.writeHead(405, { Allow: 'GET, HEAD' }).end(); return; }
+    if (pathname === '/api/health') {
+      res.writeHead(200, { 'Content-Type': 'application/json' });
+      res.end(req.method === 'HEAD' ? undefined : JSON.stringify({ ok: true }));
+      return;
+    }
+    const asset = assets.get(pathname);
+    // Serve the existing same-origin navigation routes without HTTP redirects.
+    const isDocument = !asset && !/\.[^/]+$/.test(pathname);
+    if (!asset && !isDocument) { res.writeHead(404).end('Not found'); return; }
+    setConnectionAllowlistHeaders(res, {
+      destination, isDocument,
+      reportOnly: process.env.CONNECTION_POLICY_MODE === 'report-only',
+    });
+    const body = await readFile(fileURLToPath(new URL(asset?.[0] ?? 'index.html', publicRoot)));
+    res.writeHead(200, { 'Content-Type': asset?.[1] ?? 'text/html; charset=utf-8' });
+    res.end(req.method === 'HEAD' ? undefined : body);
+  } catch {
+    res.writeHead(500).end('Unable to serve this request.');
+  }
+});
+
+const port = Number(process.env.PORT ?? 11222);
+if (!Number.isInteger(port) || port < 0 || port > 65535) throw new Error('Invalid PORT');
+server.listen(port, () => console.log(`Daily Grind listening on port ${port}`));
