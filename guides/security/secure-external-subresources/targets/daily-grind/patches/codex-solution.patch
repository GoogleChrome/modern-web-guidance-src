diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..b96a366
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,9 @@
+import { execFileSync } from 'node:child_process';
+import { copyFile, mkdir } from 'node:fs/promises';
+
+// This is a static site: validate JavaScript syntax and emit deployable files.
+execFileSync(process.execPath, ['--check', 'external-assets.js'], { stdio: 'inherit' });
+await mkdir('dist', { recursive: true });
+await Promise.all(['index.html', 'external-assets.js'].map((file) =>
+  copyFile(file, `dist/${file}`)));
+console.log('Built static site in dist/');
