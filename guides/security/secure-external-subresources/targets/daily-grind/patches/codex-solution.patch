+// Digests are release-time constants, never calculated from browser responses.
+// npm assets were checked against the registry tarball integrity. Images were
+// checked against Git blob IDs at the commit pinned in their URLs.
+
+/** @param {string} url @param {string} integrity */
+async function verifiedResponse(url, integrity) {
+  // Fail closed on engines without Fetch SRI; never silently fetch unverified.
+  if (!('integrity' in Request.prototype)) {
+    throw new Error('Subresource integrity is unavailable');
+  }
+  const response = await fetch(url, {
+    integrity,
+    mode: 'cors',
+    credentials: 'omit',
+    referrerPolicy: 'no-referrer',
+  });
+  if (!response.ok) throw new Error(`Asset request failed: ${response.status}`);
+  return response;
+}
+
+/** @param {HTMLElement} element */
+async function loadImage(element) {
+  const { image: url, integrity } = element.dataset;
+  if (!url || !integrity) throw new Error('Missing image integrity metadata');
+
+  // Quoted URLs and each modifier occur exactly once. Unsupported browsers use
+  // only verified blob URLs, never a plain, unverified external CSS fallback.
+  const protectedUrl = `url(${JSON.stringify(url)} cross-origin(anonymous) referrer-policy(no-referrer) integrity(${JSON.stringify(integrity)}))`;
+  if (globalThis.CSS?.supports('background-image', protectedUrl)) {
+    element.style.setProperty('--verified-image', protectedUrl);
+    return;
+  }
+
+  const response = await verifiedResponse(url, integrity);
+  const blobUrl = URL.createObjectURL(await response.blob());
+  // Retain the blob for the document lifetime so later CSS repaints still work.
+  // The browser releases these URLs when the document is destroyed.
+  element.style.setProperty('--verified-image', `url("${blobUrl}")`);
+}
+
+async function loadFont() {
+  const preload = document.querySelector('#brand-font');
+  if (!(preload instanceof HTMLLinkElement)) return;
+  const url = preload.href;
+  const integrity = preload.integrity;
+  const protectedUrl = `url(${JSON.stringify(url)} cross-origin(anonymous) referrer-policy(no-referrer) integrity(${JSON.stringify(integrity)}))`;
+  // FontFace accepts the same CSS src syntax as @font-face; format() remains
+  // outside url(). Unsupported engines get bytes checked by Fetch SRI instead.
+  const source = globalThis.CSS?.supports('background-image', protectedUrl)
+    ? `${protectedUrl} format("woff2")`
+    : await (await verifiedResponse(url, integrity)).arrayBuffer();
+  const font = new FontFace('Daily Grind', source, { weight: '400', display: 'swap' });
+  document.fonts.add(await font.load());
+}
+
+// Independent failures leave the system font and background colors in place.
+// An integrity failure must never retry with an unverified remote URL.
+void Promise.allSettled([
+  loadFont(),
+  ...Array.from(document.querySelectorAll('[data-image]'), (element) =>
+    element instanceof HTMLElement ? loadImage(element) : Promise.resolve()),
+]);
