+          </div>
+
+          {/* Fallback MFA enrollment notice when passkeys are unsupported */}
+          {passkeySupported === false && (
+            <div
+              id="mfa-fallback-banner"
+              className="mx-6 mt-5 p-4 bg-amber-50 border border-amber-200 rounded-md text-xs text-amber-900"
+            >
+              <p className="font-semibold mb-1">
+                Platform passkeys are not available on this device or browser
+              </p>
+              <p className="text-amber-800">
+                To keep your account secure, we encourage enrolling in standard multi-factor
+                authentication (MFA), such as a time-based one-time password (TOTP) authenticator
+                app or SMS verification codes.
+              </p>
+            </div>
+          )}
+
+          {/* Passkey Credentials List Container */}
+          <div id="passkey-credentials-list" className="p-6">
+            {loading ? (
+              <div className="py-8 text-center text-sm text-gray-500">
+                Loading registered passkeys...
+              </div>
+            ) : credentials.length === 0 ? (
+              <div
+                id="passkey-empty-state"
+                className="py-10 px-4 text-center border border-dashed border-gray-300 rounded-lg bg-gray-50"
+              >
+                <p className="text-base font-semibold text-gray-800">No passkeys found</p>
+                <p className="text-xs text-gray-500 mt-1 max-w-md mx-auto">
+                  You do not have any passkeys registered to your account yet. Create a passkey to
+                  enable fast, phishing-resistant sign-in.
+                </p>
+              </div>
+            ) : (
+              <ul className="divide-y divide-gray-200">
+                {credentials.map((cred) => {
+                  const { providerName, displayName, providerIcon } =
+                    getCredentialProviderMetadata(cred);
+                  const isEditing = editingCredentialId === cred.id;
+                  const isBusy = busyCredentialId === cred.id;
+                  const formattedRegisteredAt = formatEpochTimestamp(cred.registeredAt);
+                  const formattedLastUsedAt = cred.lastUsedAt
+                    ? formatEpochTimestamp(cred.lastUsedAt)
+                    : 'Never';
+
+                  return (
+                    <li
+                      key={cred.id}
+                      id={`passkey-row-${cred.id}`}
+                      className="py-4 first:pt-0 last:pb-0 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
+                    >
+                      <div className="flex items-start sm:items-center gap-4 min-w-0 flex-1">
+                        {/* Provider Icon */}
+                        <div className="w-10 h-10 rounded-lg border border-gray-200 bg-white flex items-center justify-center p-2 shrink-0">
+                          <img
+                            src={providerIcon || FALLBACK_KEY_ICON_DATA_URI}
+                            alt={providerName}
+                            className="w-6 h-6 object-contain"
+                          />
+                        </div>
+
+                        <div className="min-w-0 flex-1">
+                          {isEditing ? (
+                            <form
+                              onSubmit={(e) => {
+                                e.preventDefault();
+                                performCredentialRename(cred.id, credentialNameInput);
+                              }}
+                              className="flex flex-wrap items-center gap-2"
+                            >
+                              <input
+                                id={`rename-input-${cred.id}`}
+                                type="text"
+                                value={credentialNameInput}
+                                onChange={(e) => setCredentialNameInput(e.target.value)}
+                                aria-label="New passkey nickname"
+                                autoFocus
+                                className="px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+                              />
+                              <button
+                                id={`save-rename-btn-${cred.id}`}
+                                type="submit"
+                                disabled={isBusy}
+                                className="px-3 py-1.5 bg-gray-900 text-white text-xs font-semibold rounded-md hover:bg-gray-800 cursor-pointer"
+                              >
+                                Save
+                              </button>
+                              <button
+                                id={`cancel-rename-btn-${cred.id}`}
+                                type="button"
+                                onClick={() => {
+                                  setEditingCredentialId(null);
+                                  setCredentialNameInput('');
+                                }}
+                                className="px-3 py-1.5 border border-gray-300 text-gray-700 text-xs font-semibold rounded-md hover:bg-gray-100 cursor-pointer"
+                              >
+                                Cancel
+                              </button>
+                            </form>
+                          ) : (
+                            <div className="flex items-center gap-2 flex-wrap">
+                              <span className="text-sm font-bold text-gray-900 truncate">
+                                {displayName}
+                              </span>
+                              {displayName !== providerName && (
+                                <span className="text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded">
+                                  {providerName}
+                                </span>
+                              )}
+                              {cred.backedUp && (
+                                <span className="text-[11px] px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 rounded font-medium">
+                                  Synced
+                                </span>
+                              )}
+                            </div>
+                          )}
+
+                          {/* Registration Date & Last Used Date */}
+                          <div className="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
+                            <span>
+                              Registered:{' '}
+                              <time dateTime={new Date(cred.registeredAt).toISOString()}>
+                                {formattedRegisteredAt}
+                              </time>
+                            </span>
+                            <span>
+                              Last used:{' '}
+                              {cred.lastUsedAt ? (
+                                <time dateTime={new Date(cred.lastUsedAt).toISOString()}>
+                                  {formattedLastUsedAt}
+                                </time>
+                              ) : (
+                                'Never'
+                              )}
+                            </span>
+                          </div>
+                        </div>
+                      </div>
+
+                      {/* Per-Item Action Buttons: Rename & Delete */}
+                      <div className="flex items-center gap-2 shrink-0 self-end sm:self-center">
+                        <button
+                          id={`rename-passkey-btn-${cred.id}`}
+                          type="button"
+                          disabled={isBusy}
+                          onClick={() => {
+                            if (isEditing) {
+                              performCredentialRename(cred.id, credentialNameInput);
+                            } else {
+                              setEditingCredentialId(cred.id);
+                              setCredentialNameInput(displayName);
+                            }
+                          }}
+                          className="px-3 py-1.5 border border-gray-300 text-gray-700 hover:bg-gray-100 text-xs font-semibold rounded-md transition-colors disabled:opacity-50 cursor-pointer"
+                        >
+                          Rename
+                        </button>
+                        <button
+                          id={`delete-passkey-btn-${cred.id}`}
+                          type="button"
+                          disabled={isBusy}
+                          onClick={() => performDelete(cred.id)}
+                          className="px-3 py-1.5 border border-red-200 text-red-700 hover:bg-red-50 text-xs font-semibold rounded-md transition-colors disabled:opacity-50 cursor-pointer"
+                        >
+                          {isBusy ? 'Removing...' : 'Delete'}
+                        </button>
+                      </div>
+                    </li>
+                  );
+                })}
+              </ul>
+            )}
+          </div>
+        </section>
+      </div>
+    </div>
+  );
+}
