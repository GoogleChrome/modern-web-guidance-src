diff --git a/src/lib/aaguid.ts b/src/lib/aaguid.ts
new file mode 100644
index 0000000..caf1cb0
--- /dev/null
+++ b/src/lib/aaguid.ts
@@ -0,0 +1,58 @@
+import aaguids from '../data/aaguids.json';
+
+export interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+export interface ProviderDetails {
+  name: string;
+  providerIcon?: string;
+}
+
+const aaguidRegistry = aaguids as Record<string, AaguidEntry>;
+
+/**
+ * Resolves passkey provider information based on its AAGUID.
+ * 
+ * Rules:
+ * - If aaguid === '00000000-0000-0000-0000-000000000000', skips registry lookup
+ *   and sets name to a fallback (or "Unknown passkey provider") and providerIcon to undefined.
+ * - For non-zeroed AAGUIDs, looks up against registry.
+ */
+export function resolveAaguid(aaguid?: string, customName?: string, userAgent?: string): ProviderDetails {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    let fallbackName = customName;
+    if (!fallbackName) {
+      if (typeof navigator !== 'undefined' && navigator.userAgent) {
+        if (/Macintosh|Mac OS/i.test(navigator.userAgent)) {
+          fallbackName = 'Mac / Apple Device';
+        } else if (/Windows/i.test(navigator.userAgent)) {
+          fallbackName = 'Windows Device';
+        } else if (/Android/i.test(navigator.userAgent)) {
+          fallbackName = 'Android Device';
+        } else if (/iPhone|iPad/i.test(navigator.userAgent)) {
+          fallbackName = 'iOS Device';
+        } else {
+          fallbackName = 'Unknown passkey provider';
+        }
+      } else {
+        fallbackName = 'Unknown passkey provider';
+      }
+    }
+    return {
+      name: fallbackName || 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+
+  const provider = aaguidRegistry[aaguid.toLowerCase()] || aaguidRegistry[aaguid];
+  return {
+    name: customName || provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light || provider?.icon_dark || undefined,
+  };
+}
+
+export { aaguidRegistry, aaguids };
+export default aaguids;
diff --git a/src/lib/api.ts b/src/lib/api.ts
new file mode 100644
index 0000000..16c19d2
--- /dev/null
+++ b/src/lib/api.ts
@@ -0,0 +1,85 @@
+/**
+ * Client-side management synchronization and API helper
+ */
+
+export const getBaseUrl = (): string => {
+  const base = (typeof import.meta !== 'undefined' && import.meta.env && import.meta.env.BASE_URL) || '/';
+  return base.endsWith('/') ? base : `${base}/`;
+};
+
+export const getApiUrl = (endpoint: string): string => {
+  const base = getBaseUrl();
+  const cleanEndpoint = endpoint.startsWith('/') ? endpoint.slice(1) : endpoint;
+  return `${base}${cleanEndpoint}`;
+};
+
+export async function listFetch(): Promise<Response> {
+  const url = getApiUrl('api/credentials');
+  return fetch(url, {
+    method: 'GET',
+    headers: { 'Accept': 'application/json' },
+  });
+}
+
+export async function deleteFetch(credentialId: string): Promise<Response> {
+  const url = getApiUrl(`api/credential/${credentialId}`);
+  return fetch(url, {
+    method: 'DELETE',
+    headers: { 'Accept': 'application/json' },
+  });
+}
+
+export async function updateCredentialFetch(credentialId: string, name: string): Promise<Response> {
+  const url = getApiUrl(`api/credential/${credentialId}`);
+  return fetch(url, {
+    method: 'PUT',
+    headers: {
+      'Content-Type': 'application/json',
+      'Accept': 'application/json',
+    },
+    body: JSON.stringify({ name }),
+  });
+}
+
+export async function renameFetch({ name, displayName }: { name: string; displayName?: string }): Promise<Response> {
+  const url = getApiUrl('api/user/rename');
+  return fetch(url, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      'Accept': 'application/json',
+    },
+    body: JSON.stringify({ name, displayName: displayName || name }),
+  });
+}
+
+export async function getUserFetch(): Promise<Response> {
+  const url = getApiUrl('api/user');
+  return fetch(url, {
+    method: 'GET',
+    headers: { 'Accept': 'application/json' },
+  });
+}
+
+export function toBase64Url(input: string | Uint8Array): string {
+  if (typeof input === 'string') {
+    // If already Base64URL string (contains only url-safe base64 characters)
+    if (/^[A-Za-z0-9_-]+$/.test(input)) {
+      return input;
+    }
+    const bytes = new TextEncoder().encode(input);
+    return bytesToBase64Url(bytes);
+  }
+  return bytesToBase64Url(input);
+}
+
+export function bytesToBase64Url(bytes: Uint8Array): string {
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
diff --git a/src/lib/db.ts b/src/lib/db.ts
new file mode 100644
index 0000000..2192303
--- /dev/null
+++ b/src/lib/db.ts
@@ -0,0 +1,99 @@
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID string
+  passkeyUserId: string; // Base64URL-encoded user ID string
+  aaguid: string; // UUID string e.g. "ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4"
+  name?: string; // Custom or provider name
+  providerIcon?: string; // Optional icon data URI
+  registeredAt: number; // Raw epoch timestamp (ms)
+  lastUsedAt?: number; // Raw epoch timestamp (ms)
+  transports?: string[];
+  publicKey?: string;
+  counter?: number;
+}
+
+export interface User {
+  id: string; // Base64URL-encoded user ID string e.g. "M2YPl-KGnA8"
+  name: string; // Username e.g. "alex.doe@example.com"
+  displayName: string; // Display name e.g. "Alex Doe"
+}
+
+// Initial default user and credentials
+let userRecord: User = {
+  id: 'M2YPl-KGnA8',
+  name: 'alex.doe@example.com',
+  displayName: 'Alex Doe',
+};
+
+let credentialsStore: StoredPasskeyCredential[] = [
+  {
+    id: 'k7y9J2k-A1b2C3d4E5f6G7',
+    passkeyUserId: 'M2YPl-KGnA8',
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', // Google Password Manager
+    name: 'Google Password Manager',
+    registeredAt: 1770000000000,
+    lastUsedAt: 1771200000000,
+    transports: ['internal', 'hybrid'],
+  },
+  {
+    id: 'm4n5P6q-R7s8T9u0V1w2X3',
+    passkeyUserId: 'M2YPl-KGnA8',
+    aaguid: 'dd480769-ecd8-4489-9d9e-7753c0d472d9', // iCloud Keychain
+    name: 'iCloud Keychain',
+    registeredAt: 1768000000000,
+    lastUsedAt: 1771000000000,
+    transports: ['internal', 'hybrid'],
+  },
+  {
+    id: 'z1x2C3v-B4n5M6a7S8d9F0',
+    passkeyUserId: 'M2YPl-KGnA8',
+    aaguid: '00000000-0000-0000-0000-000000000000', // Zeroed AAGUID - Security Key
+    name: 'Security Key (USB)',
+    registeredAt: 1765000000000,
+    lastUsedAt: 1770500000000,
+    transports: ['usb', 'nfc'],
+  },
+];
+
+export const db = {
+  getUser: async (userId?: string): Promise<User> => {
+    return { ...userRecord };
+  },
+
+  updateUser: async (userId: string, data: { name?: string; displayName?: string }): Promise<User> => {
+    if (data.name !== undefined) userRecord.name = data.name;
+    if (data.displayName !== undefined) userRecord.displayName = data.displayName;
+    return { ...userRecord };
+  },
+
+  findCredentialsByUserId: async (userId: string): Promise<StoredPasskeyCredential[]> => {
+    // Return all matching credentials or all if userId matches default
+    return credentialsStore.filter(c => !userId || c.passkeyUserId === userId);
+  },
+
+  findCredentialById: async (id: string): Promise<StoredPasskeyCredential | undefined> => {
+    return credentialsStore.find(c => c.id === id);
+  },
+
+  saveCredential: async (cred: StoredPasskeyCredential): Promise<StoredPasskeyCredential> => {
+    const index = credentialsStore.findIndex(c => c.id === cred.id);
+    if (index >= 0) {
+      credentialsStore[index] = { ...credentialsStore[index], ...cred };
+      return credentialsStore[index];
+    } else {
+      credentialsStore.push({ ...cred });
+      return cred;
+    }
+  },
+
+  deleteCredential: async (id: string): Promise<boolean> => {
+    const prevLength = credentialsStore.length;
+    credentialsStore = credentialsStore.filter(c => c.id !== id);
+    return credentialsStore.length < prevLength;
+  },
+
+  getAllCredentials: async (): Promise<StoredPasskeyCredential[]> => {
+    return [...credentialsStore];
+  },
+};
+
+export default db;
