+          className="bg-white border border-gray-200 rounded-lg shadow-xs overflow-hidden"
+        >
+          <div className="px-6 py-5 bg-gray-50 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+            <div>
+              <h2 id="passkey-management-heading" className="text-lg font-bold text-gray-900">
+                Passkeys &amp; Security Keys
+              </h2>
+              <p className="text-xs text-gray-600 mt-0.5">
+                Passkeys let you sign in securely to The DevTools Times using Touch ID, Face ID,
+                Windows Hello, or a hardware security key.
+              </p>
+            </div>
+
+            {/* Conditional "Create passkey" Button based on PublicKeyCredential.getClientCapabilities() */}
+            {passkeySupported === true && (
+              <button
+                id="create-passkey-btn"
+                type="button"
+                disabled={creatingPasskey}
+                onClick={handleCreatePasskey}
+                className="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-gray-900 hover:bg-gray-800 text-white text-xs font-semibold uppercase tracking-wider rounded-md transition-colors disabled:opacity-50 shrink-0 cursor-pointer"
+              >
+                <svg
+                  className="w-4 h-4"
+                  fill="none"
+                  stroke="currentColor"
+                  viewBox="0 0 24 24"
+                  aria-hidden="true"
+                >
+                  <path
+                    strokeLinecap="round"
+                    strokeLinejoin="round"
+                    strokeWidth={2}
+                    d="M12 4v16m8-8H4"
