@@ -0,0 +1,248 @@
+import aaguidsData from './aaguids.json' with { type: 'json' };
+
+export interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+export const aaguids: Record<string, AaguidEntry> = aaguidsData;
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID
+  passkeyUserId: string; // Base64URL-encoded user ID
+  name: string; // Provider name or user-defined custom nickname
+  aaguid: string; // 128-bit UUID string
+  providerIcon?: string; // Data URI from AAGUID registry (or undefined for zeroed AAGUID)
+  registeredAt: number; // Epoch timestamp in ms
+  lastUsedAt?: number | null; // Epoch timestamp in ms (optional)
+  publicKey?: string; // Base64URL-encoded public key
+  counter?: number;
+  transports?: string[];
+  backedUp?: boolean;
+  deviceType?: 'singleDevice' | 'multiDevice';
+}
+
+export interface StoredUser {
+  id: string; // Base64URL-encoded user ID
+  name: string; // Account username / email
+  displayName: string; // Reader display name
+  rpId: string;
+}
+
+export const DEFAULT_USER_ID = 'M2YPl-KGnA8';
+
+export function deriveDeviceNameFromUserAgent(userAgent?: string | null): string {
+  if (!userAgent) return 'Unknown passkey provider';
+  if (/Macintosh|Mac OS X/i.test(userAgent)) return 'Mac Passkey';
+  if (/iPhone|iPad|iPod/i.test(userAgent)) return 'iCloud Keychain Device';
+  if (/Android/i.test(userAgent)) return 'Android Device Passkey';
+  if (/Windows/i.test(userAgent)) return 'Windows Device Passkey';
+  if (/Linux/i.test(userAgent)) return 'Linux Security Key';
+  return 'Unknown passkey provider';
+}
+
+/**
+ * Resolves passkey provider metadata from an AAGUID according to the guide:
+ * Before looking up the AAGUID in the registry, check if it equals
+ * '00000000-0000-0000-0000-000000000000'. If so, skip the registry lookup
+ * and set name to a fallback and providerIcon to undefined.
+ */
+export function resolveProviderFromAaguid(
+  registrationInfo: { aaguid: string },
+  userAgent?: string | null
+): {
+  aaguid: string;
+  name: string;
+  providerIcon: string | undefined;
+} {
+  const { aaguid } = registrationInfo;
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    // use the device name as the passkey provider based on
+    // the information derived from the user agent string,
+    // or just say "Unknown passkey provider"
+    return {
+      aaguid,
+      name: deriveDeviceNameFromUserAgent(userAgent),
+      providerIcon: undefined,
+    };
+  } else {
+    const provider = aaguids[aaguid];
+    const credential = {
+      aaguid,
+      name: provider?.name || 'Unknown passkey provider',
+      providerIcon: provider?.icon_light,
+    };
+    return credential;
+  }
+}
+
+/**
+ * Extracts the 16-byte AAGUID from a Base64URL-encoded authenticatorData buffer
+ * if Attested Credential Data (AT flag 0x40) is present.
+ */
+export function extractAaguidFromAuthData(base64UrlAuthData?: string): string | null {
+  if (!base64UrlAuthData) return null;
+  try {
+    const buf = Buffer.from(base64UrlAuthData, 'base64url');
+    if (buf.length < 53) return null;
+    const flags = buf[32];
+    const hasAttestedCredData = (flags & 0x40) !== 0;
+    if (!hasAttestedCredData) return null;
+    const hex = buf.subarray(37, 53).toString('hex');
+    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`.toLowerCase();
+  } catch {
+    return null;
+  }
+}
+
+// Initial seeded data for the signed-in reader in The DevTools Times
+const usersStore = new Map<string, StoredUser>([
+  [
+    DEFAULT_USER_ID,
+    {
+      id: DEFAULT_USER_ID,
+      name: 'eleanor.vance@devtoolstimes.com',
+      displayName: 'Eleanor Vance',
+      rpId: 'localhost',
+    },
+  ],
+]);
+
+const initialGoogleProvider = resolveProviderFromAaguid({
+  aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+});
+const initialAppleProvider = resolveProviderFromAaguid({
+  aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+});
+const initialOnePasswordProvider = resolveProviderFromAaguid({
+  aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d',
+});
+
+const credentialsStore = new Map<string, StoredPasskeyCredential>([
+  [
+    'Z3BtLWNyZWQtMDFfTTJZUGwtS0duQTg',
+    {
+      id: 'Z3BtLWNyZWQtMDFfTTJZUGwtS0duQTg',
+      passkeyUserId: DEFAULT_USER_ID,
+      aaguid: initialGoogleProvider.aaguid,
+      name: initialGoogleProvider.name,
+      providerIcon: initialGoogleProvider.providerIcon,
+      registeredAt: 1757862000000, // Sep 14, 2026
+      lastUsedAt: 1762185600000, // Nov 3, 2026
+      transports: ['internal', 'hybrid'],
+      backedUp: true,
+      deviceType: 'multiDevice',
+    },
+  ],
+  [
+    'aWNsb3VkLWNyZWQtMDJfTTJZUGwtS0duQTg',
+    {
+      id: 'aWNsb3VkLWNyZWQtMDJfTTJZUGwtS0duQTg',
+      passkeyUserId: DEFAULT_USER_ID,
+      aaguid: initialAppleProvider.aaguid,
+      name: initialAppleProvider.name,
+      providerIcon: initialAppleProvider.providerIcon,
+      registeredAt: 1759590000000, // Oct 4, 2026
+      lastUsedAt: 1761926400000, // Oct 31, 2026
+      transports: ['internal', 'hybrid'],
+      backedUp: true,
+      deviceType: 'multiDevice',
+    },
+  ],
+  [
+    'MXBhc3N3b3JkLWNyZWQtMDNfTTJZUGwtS0duQTg',
+    {
+      id: 'MXBhc3N3b3JkLWNyZWQtMDNfTTJZUGwtS0duQTg',
+      passkeyUserId: DEFAULT_USER_ID,
+      aaguid: initialOnePasswordProvider.aaguid,
+      name: initialOnePasswordProvider.name,
+      providerIcon: initialOnePasswordProvider.providerIcon,
+      registeredAt: 1760972400000, // Oct 20, 2026
+      lastUsedAt: null,
+      transports: ['internal'],
+      backedUp: true,
+      deviceType: 'multiDevice',
+    },
+  ],
+]);
+
+export const db = {
+  async findCredentialsByUserId(userId: string): Promise<StoredPasskeyCredential[]> {
+    const list: StoredPasskeyCredential[] = [];
+    for (const cred of credentialsStore.values()) {
+      if (cred.passkeyUserId === userId) {
+        list.push({ ...cred });
+      }
+    }
+    return list.sort((a, b) => b.registeredAt - a.registeredAt);
+  },
+
+  async findCredentialById(id: string): Promise<StoredPasskeyCredential | undefined> {
+    const cred = credentialsStore.get(id);
+    return cred ? { ...cred } : undefined;
+  },
+
+  async saveCredential(cred: StoredPasskeyCredential): Promise<StoredPasskeyCredential> {
+    const saved: StoredPasskeyCredential = { ...cred };
+    credentialsStore.set(saved.id, saved);
+    return { ...saved };
+  },
+
+  async deleteCredential(id: string): Promise<boolean> {
+    return credentialsStore.delete(id);
+  },
+
+  async getUserById(userId: string): Promise<StoredUser> {
+    const existing = usersStore.get(userId);
+    if (existing) {
+      return { ...existing };
+    }
+    const fallback: StoredUser = {
+      id: userId,
+      name: 'eleanor.vance@devtoolstimes.com',
+      displayName: 'Eleanor Vance',
+      rpId: 'localhost',
+    };
+    usersStore.set(userId, fallback);
+    return { ...fallback };
+  },
+
+  async updateUser(
+    userId: string,
+    updates: { name?: string; displayName?: string }
+  ): Promise<StoredUser> {
+    const current = await this.getUserById(userId);
+    const updated: StoredUser = {
+      ...current,
+      name: typeof updates.name === 'string' && updates.name.trim() ? updates.name.trim() : current.name,
+      displayName:
+        typeof updates.displayName === 'string' && updates.displayName.trim()
+          ? updates.displayName.trim()
+          : current.displayName,
+    };
+    usersStore.set(userId, updated);
+    return { ...updated };
+  },
+};
+
+export async function checkUserAuthenticated(context?: {
+  session?: any;
+  request?: Request;
+  url?: URL;
+}): Promise<StoredUser> {
+  let userId = DEFAULT_USER_ID;
+  try {
+    const sessionUserId = await context?.session?.get('passkeyUserId');
+    if (sessionUserId && typeof sessionUserId === 'string') {
+      userId = sessionUserId;
+    }
+  } catch {
+    // Fallback to default signed-in user ID if session is unavailable
+  }
+  const user = await db.getUserById(userId);
+  if (context?.url?.hostname) {
+    user.rpId = context.url.hostname;
+  }
+  return user;
+}
