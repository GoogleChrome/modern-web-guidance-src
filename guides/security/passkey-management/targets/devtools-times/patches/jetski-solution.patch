+++ b/src/pages/api/credentials.ts
@@ -0,0 +1,46 @@
+import type { APIRoute } from 'astro';
+import { db, type StoredPasskeyCredential } from '../../lib/db';
+
+export const GET: APIRoute = async ({ request }) => {
+  const url = new URL(request.url);
+  const userId = url.searchParams.get('userId') || 'M2YPl-KGnA8';
+  const list = await db.findCredentialsByUserId(userId);
+
+  return new Response(JSON.stringify(list), {
+    status: 200,
+    headers: {
+      'Content-Type': 'application/json',
+    },
+  });
+};
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const newCred: StoredPasskeyCredential = {
+      id: body.id || `cred-${Date.now()}`,
+      passkeyUserId: body.passkeyUserId || 'M2YPl-KGnA8',
+      aaguid: body.aaguid || '00000000-0000-0000-0000-000000000000',
+      name: body.name || 'New Passkey',
+      providerIcon: body.providerIcon,
+      registeredAt: body.registeredAt || Date.now(),
+      lastUsedAt: body.lastUsedAt || Date.now(),
+      transports: body.transports || ['internal'],
+    };
+
+    const saved = await db.saveCredential(newCred);
+    return new Response(JSON.stringify(saved), {
+      status: 201,
+      headers: {
+        'Content-Type': 'application/json',
+      },
+    });
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err.message || 'Invalid request' }), {
+      status: 400,
+      headers: {
+        'Content-Type': 'application/json',
+      },
+    });
+  }
+};
