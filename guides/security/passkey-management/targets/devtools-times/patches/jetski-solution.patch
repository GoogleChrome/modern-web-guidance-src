+++ b/src/pages/api/credentials/index.ts
@@ -0,0 +1,90 @@
+import type { APIRoute } from 'astro';
+import aaguidsData from '../../../utils/aaguids.json' with { type: 'json' };
+import {
+  db,
+  checkUserAuthenticated,
+  deriveDeviceNameFromUserAgent,
+  extractAaguidFromAuthData,
+  type StoredPasskeyCredential,
+  type AaguidEntry,
+} from '../../../utils/db';
+
+const aaguids: Record<string, AaguidEntry> = aaguidsData;
+
+export const GET: APIRoute = async (context) => {
+  const user = await checkUserAuthenticated(context);
+  const list = await db.findCredentialsByUserId(user.id);
+  return new Response(JSON.stringify(list), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const POST: APIRoute = async (context) => {
+  const user = await checkUserAuthenticated(context);
+  const body = await context.request.json().catch(() => ({}));
+  const userAgent = context.request.headers.get('user-agent');
+
+  const extractedAaguid =
+    body.aaguid ||
+    body.registrationInfo?.aaguid ||
+    extractAaguidFromAuthData(body.response?.authenticatorData) ||
+    '00000000-0000-0000-0000-000000000000';
+
+  const registrationInfo = {
+    aaguid: String(extractedAaguid).toLowerCase(),
+  };
+
+  const credentialId: string =
+    typeof body.id === 'string' && body.id
+      ? body.id
+      : Buffer.from(`cred-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`).toString(
+          'base64url'
+        );
+
+  const now = Date.now();
+  let credential: StoredPasskeyCredential;
+
+  const { aaguid } = registrationInfo;
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    // use the device name as the passkey provider based on
+    // the information derived from the user agent string,
+    // or just say "Unknown passkey provider"
+    credential = {
+      id: credentialId,
+      passkeyUserId: user.id,
+      aaguid,
+      name: body.name || deriveDeviceNameFromUserAgent(userAgent) || 'Unknown passkey provider',
+      providerIcon: undefined,
+      registeredAt: now,
+      lastUsedAt: now,
+      transports: Array.isArray(body.response?.transports)
+        ? body.response.transports
+        : ['internal'],
+      backedUp: true,
+      deviceType: 'multiDevice',
+    };
+  } else {
+    const provider = aaguids[aaguid];
+    credential = {
+      id: credentialId,
+      passkeyUserId: user.id,
+      aaguid,
+      name: body.name || provider?.name || 'Unknown passkey provider',
+      providerIcon: provider?.icon_light,
+      registeredAt: now,
+      lastUsedAt: now,
+      transports: Array.isArray(body.response?.transports)
+        ? body.response.transports
+        : ['internal'],
+      backedUp: true,
+      deviceType: 'multiDevice',
+    };
+  }
+
+  const saved = await db.saveCredential(credential);
+  return new Response(JSON.stringify(saved), {
+    status: 201,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
diff --git a/src/pages/api/register-options.ts b/src/pages/api/register-options.ts
new file mode 100644
index 0000000..458e593
--- /dev/null
+++ b/src/pages/api/register-options.ts
@@ -0,0 +1,48 @@
+import type { APIRoute } from 'astro';
+import crypto from 'node:crypto';
+import { db, checkUserAuthenticated } from '../../utils/db';
+
+const handleOptions: APIRoute = async (context) => {
+  const user = await checkUserAuthenticated(context);
+  const existingCredentials = await db.findCredentialsByUserId(user.id);
+  const challenge = crypto.randomBytes(32).toString('base64url');
+  const rpId = context.url?.hostname || user.rpId || 'localhost';
+
+  // Note: authenticatorSelection.authenticatorAttachment is intentionally omitted
+  // to allow registering both security keys and platform authenticators.
+  const creationOptions = {
+    challenge,
+    rp: {
+      name: 'The DevTools Times',
+      id: rpId,
+    },
+    user: {
+      id: user.id,
+      name: user.name,
+      displayName: user.displayName,
+    },
+    pubKeyCredParams: [
+      { alg: -7, type: 'public-key' },
+      { alg: -257, type: 'public-key' },
+    ],
+    timeout: 60000,
+    attestation: 'none',
+    excludeCredentials: existingCredentials.map((cred) => ({
+      id: cred.id,
+      type: 'public-key',
+      transports: cred.transports || ['internal', 'hybrid'],
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'required',
+    },
+  };
+
+  return new Response(JSON.stringify(creationOptions), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const GET = handleOptions;
+export const POST = handleOptions;
