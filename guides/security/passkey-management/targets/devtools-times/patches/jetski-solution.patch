+import type { APIRoute } from 'astro';
+import { db, checkUserAuthenticated } from '../../../utils/db';
+
+export const PUT: APIRoute = async (context) => {
+  const user = await checkUserAuthenticated(context);
+  const { id } = context.params;
+  const body = await context.request.json().catch(() => ({}));
+  const { name } = body;
+
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const cred = await db.findCredentialById(id);
+  if (!cred || cred.passkeyUserId !== user.id) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  cred.name = typeof name === 'string' && name.trim() ? name.trim() : cred.name;
+  await db.saveCredential(cred);
+
+  return new Response(JSON.stringify(cred), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const DELETE: APIRoute = async (context) => {
+  const user = await checkUserAuthenticated(context);
+  const { id } = context.params;
+
+  if (!id) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const cred = await db.findCredentialById(id);
+  if (!cred || cred.passkeyUserId !== user.id) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  await db.deleteCredential(id);
+
+  return new Response(JSON.stringify({ success: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
