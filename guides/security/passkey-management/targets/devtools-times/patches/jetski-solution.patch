+import 'webauthn-polyfills';
+import type { StoredPasskeyCredential, StoredUser } from './db';
+
+const API_BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
+
+export function ensureBase64Url(input: string): string {
+  if (!input) return '';
+  if (/^[A-Za-z0-9\-_]+$/.test(input)) {
+    return input;
+  }
+  const bytes = new TextEncoder().encode(input);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export async function listFetch(): Promise<Response> {
+  return fetch(`${API_BASE}/api/credentials`, {
+    method: 'GET',
+    headers: { Accept: 'application/json' },
+  });
+}
+
+export async function renameCredentialFetch(
+  credentialId: string,
+  payload: { name: string }
+): Promise<Response> {
+  return fetch(`${API_BASE}/api/credential/${encodeURIComponent(credentialId)}`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(payload),
+  });
+}
+
+export async function deleteFetch(credentialId: string): Promise<Response> {
+  return fetch(`${API_BASE}/api/credential/${encodeURIComponent(credentialId)}`, {
+    method: 'DELETE',
+    headers: { Accept: 'application/json' },
+  });
+}
+
+export async function getUserFetch(): Promise<Response> {
+  return fetch(`${API_BASE}/api/user`, {
+    method: 'GET',
+    headers: { Accept: 'application/json' },
+  });
+}
+
+export async function updateUserFetch(payload: {
+  name: string;
+  displayName: string;
+}): Promise<Response> {
+  return fetch(`${API_BASE}/api/user`, {
+    method: 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(payload),
+  });
+}
+
+export async function registerOptionsFetch(): Promise<Response> {
+  return fetch(`${API_BASE}/api/register-options`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+export async function saveRegisteredCredentialFetch(payload: Record<string, any>): Promise<Response> {
+  return fetch(`${API_BASE}/api/credentials`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(payload),
+  });
+}
+
+export async function syncAcceptedCredentials(
+  currentCredentialsList: StoredPasskeyCredential[],
+  rpIdParam?: string,
+  userIdParam?: string
+): Promise<void> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    !PublicKeyCredential.signalAllAcceptedCredentials
+  ) {
+    return;
+  }
+  try {
+    const rpId = rpIdParam || window.location.hostname || 'localhost';
+    const base64UrlUserId = ensureBase64Url(
+      userIdParam || currentCredentialsList[0]?.passkeyUserId || 'M2YPl-KGnA8'
+    );
+    const credentialIds = currentCredentialsList.map((c) => ensureBase64Url(c.id));
+
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId: base64UrlUserId,
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    console.error('SignalAllAcceptedCredentials sync failure:', e);
+  }
+}
+
+export async function syncCurrentUserDetails(
+  rpIdParam: string,
+  userIdParam: string,
+  updatedName: string,
+  updatedDisplayName: string
+): Promise<void> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    !PublicKeyCredential.signalCurrentUserDetails
+  ) {
+    return;
+  }
+  try {
+    const rpId = rpIdParam || window.location.hostname || 'localhost';
+    const userId = ensureBase64Url(userIdParam);
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId,
+      userId,
+      name: updatedName,
+      displayName: updatedDisplayName,
+    });
+  } catch (e) {
+    console.error('SignalCurrentUserDetails sync failure:', e);
+  }
+}
+
+export type { StoredPasskeyCredential, StoredUser };
