diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..f978ff6
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,699 @@
+import 'webauthn-polyfills';
+import React, { useState, useEffect, useCallback } from 'react';
+import { listFetch, deleteFetch, updateCredentialFetch, renameFetch, getUserFetch } from '../lib/api';
+import { resolveAaguid } from '../lib/aaguid';
+import type { StoredPasskeyCredential, User } from '../lib/db';
+
+export function formatHumanReadableDate(timestamp?: number | string | Date): string {
+  if (!timestamp) return 'Never';
+  let date: Date;
+  if (typeof timestamp === 'number') {
+    date = timestamp < 1e11 ? new Date(timestamp * 1000) : new Date(timestamp);
+  } else {
+    date = new Date(timestamp);
+  }
+  if (isNaN(date.getTime())) return 'Unknown date';
+
+  return date.toLocaleDateString('en-US', {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+    hour: '2-digit',
+    minute: '2-digit',
+  });
+}
+
+export default function PasskeyManagement() {
+  const [credentials, setCredentials] = useState<StoredPasskeyCredential[]>([]);
+  const [user, setUser] = useState<User>({
+    id: 'M2YPl-KGnA8',
+    name: 'alex.doe@example.com',
+    displayName: 'Alex Doe',
+  });
+  const [loading, setLoading] = useState(true);
+  const [managementStatus, setManagementStatus] = useState<string>('Idle');
+  const [isPasskeySupported, setIsPasskeySupported] = useState<boolean | null>(null);
+  const [actionError, setActionError] = useState<string | null>(null);
+  const [actionSuccess, setActionSuccess] = useState<string | null>(null);
+
+  // Rename credential modal state
+  const [renamingCred, setRenamingCred] = useState<StoredPasskeyCredential | null>(null);
+  const [newCredName, setNewCredName] = useState('');
+
+  // User rename modal/form state
+  const [isEditingUser, setIsEditingUser] = useState(false);
+  const [editUsername, setEditUsername] = useState('');
+  const [editDisplayName, setEditDisplayName] = useState('');
+
+  /**
+   * Signal API: syncAcceptedCredentials
+   * Communicates all accepted credentials to password manager.
+   */
+  const syncAcceptedCredentials = useCallback(async (currentCredentialsList: StoredPasskeyCredential[], userIdParam?: string) => {
+    try {
+      if (
+        typeof window !== 'undefined' &&
+        window.PublicKeyCredential &&
+        typeof window.PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+      ) {
+        const credentialIds = currentCredentialsList.map((c) => c.id);
+        const rpId = window.location.hostname || 'localhost';
+        const userId = userIdParam || user.id || 'M2YPl-KGnA8';
+
+        await window.PublicKeyCredential.signalAllAcceptedCredentials({
+          rpId,
+          userId,
+          allAcceptedCredentialIds: credentialIds,
+        });
+      }
+    } catch (e) {
+      console.error('SignalAllAcceptedCredentials sync failure:', e);
+    }
+  }, [user.id]);
+
+  /**
+   * Load management panel credentials and user info, then trigger initial page load sync.
+   */
+  const loadManagementPanel = useCallback(async () => {
+    try {
+      setLoading(true);
+      setManagementStatus('Loading...');
+      setActionError(null);
+
+      // Fetch user details
+      try {
+        const userRes = await getUserFetch();
+        if (userRes.ok) {
+          const userData: User = await userRes.json();
+          setUser(userData);
+          setEditUsername(userData.name);
+          setEditDisplayName(userData.displayName);
+        }
+      } catch (err) {
+        console.warn('Failed to load user info:', err);
+      }
+
+      // Fetch credentials list
+      const response = await listFetch();
+      if (response.ok) {
+        const list: StoredPasskeyCredential[] = await response.json();
+        setCredentials(list);
+        setManagementStatus('Idle');
+        // Sync on page load via Signal API
+        await syncAcceptedCredentials(list);
+      } else {
+        setActionError('Failed to fetch credentials list.');
+        setManagementStatus('Error loading credentials');
+      }
+    } catch (err: any) {
+      console.error('Error loading management panel:', err);
+      setActionError('An unexpected error occurred while loading passkeys.');
+      setManagementStatus(`Error: ${err.message}`);
+    } finally {
+      setLoading(false);
+    }
+  }, [syncAcceptedCredentials]);
+
+  /**
+   * Check client passkey capabilities using PublicKeyCredential.getClientCapabilities()
+   */
+  useEffect(() => {
+    const checkCapabilities = async () => {
+      try {
+        if (
+          typeof window !== 'undefined' &&
+          window.PublicKeyCredential &&
+          typeof window.PublicKeyCredential.getClientCapabilities === 'function'
+        ) {
+          const capabilities = await window.PublicKeyCredential.getClientCapabilities();
+          // Gate the Create Passkey button on passkeyPlatformAuthenticator capability
+          if (capabilities && capabilities.passkeyPlatformAuthenticator === true) {
+            setIsPasskeySupported(true);
+          } else {
+            setIsPasskeySupported(false);
+          }
+        } else {
+          setIsPasskeySupported(false);
+        }
+      } catch (err) {
+        console.error('Failed to get client capabilities:', err);
+        setIsPasskeySupported(false);
+      }
+    };
+
+    checkCapabilities();
+  }, []);
+
+  /**
+   * Page load initialization via DOMContentLoaded (or immediate if already loaded)
+   */
+  useEffect(() => {
+    if (typeof document !== 'undefined') {
+      if (document.readyState === 'loading') {
+        const handleDOMContentLoaded = () => {
+          loadManagementPanel();
+        };
+        document.addEventListener('DOMContentLoaded', handleDOMContentLoaded);
+        return () => {
+          document.removeEventListener('DOMContentLoaded', handleDOMContentLoaded);
+        };
+      } else {
+        loadManagementPanel();
+      }
+    }
+  }, [loadManagementPanel]);
+
+  /**
+   * Delete credential handler
+   * Immediately calls signalAllAcceptedCredentials with updated list after deletion.
+   */
+  async function performDelete(credentialId: string) {
+    setActionError(null);
+    setActionSuccess(null);
+    setManagementStatus('Deleting...');
+
+    try {
+      const response = await deleteFetch(credentialId);
+      if (response.ok) {
+        const updatedResponse = await listFetch();
+        if (updatedResponse.ok) {
+          const updatedList: StoredPasskeyCredential[] = await updatedResponse.json();
+          setCredentials(updatedList);
+          setActionSuccess('Passkey deleted successfully.');
+          setManagementStatus('Passkey Deleted');
+
+          // Sync after deletion immediately
+          if (
+            typeof window !== 'undefined' &&
+            window.PublicKeyCredential &&
+            typeof window.PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+          ) {
+            const credentialIds = updatedList.map((c) => c.id);
+            await window.PublicKeyCredential.signalAllAcceptedCredentials({
+              rpId: window.location.hostname || 'localhost',
+              userId: user.id || 'M2YPl-KGnA8',
+              allAcceptedCredentialIds: credentialIds,
+            });
+          }
+          await syncAcceptedCredentials(updatedList);
+        }
+      } else {
+        const errData = await response.json().catch(() => ({}));
+        setActionError(`Failed to delete passkey: ${errData.error || response.statusText}`);
+        setManagementStatus('Delete failed');
+      }
+    } catch (err: any) {
+      console.error('Delete passkey failure:', err);
+      setActionError('An unexpected error occurred during deletion.');
+      setManagementStatus(`Error: ${err.message}`);
+    }
+  }
+
+  /**
+   * Credential rename handler
+   */
+  async function performCredentialRename(e: React.FormEvent) {
+    e.preventDefault();
+    if (!renamingCred || !newCredName.trim()) return;
+
+    setActionError(null);
+    setActionSuccess(null);
+    setManagementStatus('Renaming passkey...');
+
+    try {
+      const response = await updateCredentialFetch(renamingCred.id, newCredName.trim());
+      if (response.ok) {
+        const updatedResponse = await listFetch();
+        if (updatedResponse.ok) {
+          const updatedList: StoredPasskeyCredential[] = await updatedResponse.json();
+          setCredentials(updatedList);
+          setActionSuccess('Passkey name updated successfully.');
+          setManagementStatus('Passkey Renamed');
+        }
+        setRenamingCred(null);
+        setNewCredName('');
+      } else {
+        const errData = await response.json().catch(() => ({}));
+        setActionError(`Failed to update name: ${errData.error || response.statusText}`);
+        setManagementStatus('Rename failed');
+      }
+    } catch (err: any) {
+      console.error('Update passkey name failure:', err);
+      setActionError('An unexpected error occurred while updating passkey name.');
+      setManagementStatus(`Error: ${err.message}`);
+    }
+  }
+
+  /**
+   * User username / display name rename handler
+   * Immediately calls signalCurrentUserDetails upon successful rename.
+   */
+  async function performRename(rpId: string, userId: string, updatedName: string, updatedDisplayName: string) {
+    setActionError(null);
+    setActionSuccess(null);
+    setManagementStatus('Updating profile...');
+
+    try {
+      const response = await renameFetch({ name: updatedName, displayName: updatedDisplayName });
+      if (response.ok) {
+        try {
+          if (
+            typeof window !== 'undefined' &&
+            window.PublicKeyCredential &&
+            typeof window.PublicKeyCredential.signalCurrentUserDetails === 'function'
+          ) {
+            await window.PublicKeyCredential.signalCurrentUserDetails({
+              rpId,
+              userId,
+              name: updatedName,
+              displayName: updatedDisplayName,
+            });
+          }
+        } catch (signalErr) {
+          console.error('SignalCurrentUserDetails sync failure:', signalErr);
+        }
+
+        setUser((prev) => ({
+          ...prev,
+          name: updatedName,
+          displayName: updatedDisplayName,
+        }));
+        setIsEditingUser(false);
+        setActionSuccess('Account details updated and synchronized with password manager!');
+        setManagementStatus('Profile Updated');
+      } else {
+        const errData = await response.json().catch(() => ({}));
+        setActionError(`Failed to update profile: ${errData.error || response.statusText}`);
+        setManagementStatus('Profile update failed');
+      }
+    } catch (err: any) {
+      console.error('Perform user rename failure:', err);
+      setActionError('An unexpected error occurred while updating user details.');
+      setManagementStatus(`Error: ${err.message}`);
+    }
+  }
+
+  const handleUserRenameSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const rpId = (typeof window !== 'undefined' && window.location.hostname) || 'localhost';
+    await performRename(rpId, user.id, editUsername, editDisplayName);
+  };
+
+  /**
+   * Create passkey handler
+   * Allows registering a platform passkey or security key by omitting authenticatorAttachment.
+   */
+  const handleCreatePasskey = async () => {
+    setActionError(null);
+    setActionSuccess(null);
+
+    try {
+      if (typeof navigator !== 'undefined' && navigator.credentials && navigator.credentials.create) {
+        const challenge = new Uint8Array(32);
+        if (typeof window !== 'undefined' && window.crypto) {
+          window.crypto.getRandomValues(challenge);
+        }
+
+        const credential = await navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The DevTools Times',
+              id: (typeof window !== 'undefined' && window.location.hostname) || 'localhost',
+            },
+            user: {
+              id: new TextEncoder().encode(user.id),
+              name: user.name,
+              displayName: user.displayName,
+            },
+            pubKeyCredParams: [
+              { alg: -7, type: 'public-key' }, // ES256
+              { alg: -257, type: 'public-key' }, // RS256
+            ],
+            timeout: 60000,
+            authenticatorSelection: {
+              userVerification: 'preferred',
+              residentKey: 'preferred',
+              // authenticatorAttachment omitted to allow platform passkeys & security keys
+            },
+          },
+        });
+
+        if (credential) {
+          const newCred: StoredPasskeyCredential = {
+            id: credential.id,
+            passkeyUserId: user.id,
+            aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+            name: 'New Passkey',
+            registeredAt: Date.now(),
+            lastUsedAt: Date.now(),
+          };
+
+          const saveRes = await fetch('/devtools-times/api/credentials', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(newCred),
+          }).catch(() => fetch('/api/credentials', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(newCred),
+          }));
+
+          if (saveRes && saveRes.ok) {
+            const updatedRes = await listFetch();
+            if (updatedRes.ok) {
+              const updatedList: StoredPasskeyCredential[] = await updatedRes.json();
+              setCredentials(updatedList);
+              await syncAcceptedCredentials(updatedList);
+              setActionSuccess('New passkey created and registered successfully!');
+            }
+          }
+        }
+      }
+    } catch (err: any) {
+      console.warn('Passkey registration cancelled or error:', err);
+      if (err.name !== 'NotAllowedError') {
+        setActionError(`Passkey registration error: ${err.message || err.name}`);
+      }
+    }
+  };
+
+  return (
+    <div className="max-w-4xl mx-auto p-6 font-inter" data-testid="passkey-management-panel">
+      {/* Header & Title */}
+      <div className="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-6 border-b border-gray-200 gap-4">
+        <div>
+          <h1 className="text-3xl font-bold text-gray-900">Passkey Management</h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Manage your registered passkeys and keep credentials synchronized with your password managers.
+          </p>
+        </div>
+
+        {/* Conditional "Create Passkey" button gated on getClientCapabilities */}
+        <div className="flex items-center">
+          {isPasskeySupported === true && (
+            <button
+              id="create-passkey-btn"
+              data-testid="create-passkey-button"
+              onClick={handleCreatePasskey}
+              className="inline-flex items-center justify-center px-4 py-2.5 bg-gray-900 hover:bg-gray-800 text-white text-sm font-semibold rounded-md shadow-sm transition-colors cursor-pointer"
+            >
+              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="2" stroke="currentColor" className="w-5 h-5 mr-2">
+                <path strokeLinecap="round" strokeLinejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
+              </svg>
+              Create Passkey
+            </button>
+          )}
+
+          {isPasskeySupported === false && (
+            <div data-testid="mfa-fallback-notice" className="text-xs text-amber-800 bg-amber-50 border border-amber-200 px-3 py-2 rounded-md">
+              <span className="font-semibold">Passkeys unsupported</span> on this platform. Standard MFA enrollment is recommended.
+            </div>
+          )}
+        </div>
+      </div>
+
+      {/* Status Notifications */}
+      <div id="status" data-testid="management-status" className="sr-only">
+        {managementStatus}
+      </div>
+
+      {actionError && (
+        <div className="mb-6 p-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg flex items-center justify-between" role="alert">
+          <span>{actionError}</span>
+          <button onClick={() => setActionError(null)} className="text-red-500 hover:text-red-700 font-bold ml-4">✕</button>
+        </div>
+      )}
+
+      {actionSuccess && (
+        <div className="mb-6 p-4 text-sm text-green-700 bg-green-50 border border-green-200 rounded-lg flex items-center justify-between" role="alert">
+          <span>{actionSuccess}</span>
+          <button onClick={() => setActionSuccess(null)} className="text-green-500 hover:text-green-700 font-bold ml-4">✕</button>
+        </div>
+      )}
+
+      {/* Account / User Details Card */}
+      <div className="bg-white border border-gray-200 rounded-xl p-5 mb-8 shadow-xs" id="profile-section">
+        <div className="flex items-center justify-between mb-4">
+          <div>
+            <h2 className="text-lg font-bold text-gray-900">Account Details</h2>
+            <p className="text-xs text-gray-500">Synchronized with your passkey identity and password manager</p>
+          </div>
+          {!isEditingUser && (
+            <button
+              id="rename-user-btn"
+              onClick={() => {
+                setEditUsername(user.name);
+                setEditDisplayName(user.displayName);
+                setIsEditingUser(true);
+              }}
+              data-testid="rename-user-button"
+              className="text-xs font-semibold px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded border border-gray-300 transition-colors"
+            >
+              Edit Profile Name
+            </button>
+          )}
+        </div>
+
+        {isEditingUser ? (
+          <form onSubmit={handleUserRenameSubmit} className="space-y-4 pt-2">
+            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
+              <div>
+                <label htmlFor="user-username-input" className="block text-xs font-semibold text-gray-700 uppercase mb-1">
+                  Username (Account Name)
+                </label>
+                <input
+                  id="user-username-input"
+                  type="text"
+                  value={editUsername}
+                  onChange={(e) => setEditUsername(e.target.value)}
+                  required
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                />
+              </div>
+              <div>
+                <label htmlFor="user-displayname-input" className="block text-xs font-semibold text-gray-700 uppercase mb-1">
+                  Display Name
+                </label>
+                <input
+                  id="user-displayname-input"
+                  type="text"
+                  value={editDisplayName}
+                  onChange={(e) => setEditDisplayName(e.target.value)}
+                  required
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                />
+              </div>
+            </div>
+
+            <div className="flex items-center justify-end space-x-3 pt-2">
+              <button
+                type="button"
+                onClick={() => setIsEditingUser(false)}
+                className="px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded border border-gray-300 transition-colors"
+              >
+                Cancel
+              </button>
+              <button
+                type="submit"
+                data-testid="save-user-rename-btn"
+                className="px-3 py-1.5 text-xs font-semibold text-white bg-gray-900 hover:bg-gray-800 rounded shadow-xs transition-colors"
+              >
+                Save Profile & Sync Passkeys
+              </button>
+            </div>
+          </form>
+        ) : (
+          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
+            <div className="bg-gray-50 p-3 rounded-lg border border-gray-100">
+              <span className="text-[10px] uppercase font-bold text-gray-400 block tracking-wider">Username</span>
+              <span className="text-sm font-medium text-gray-800 mt-0.5 block" data-testid="user-name">{user.name}</span>
+            </div>
+            <div className="bg-gray-50 p-3 rounded-lg border border-gray-100">
+              <span className="text-[10px] uppercase font-bold text-gray-400 block tracking-wider">Display Name</span>
+              <span className="text-sm font-medium text-gray-800 mt-0.5 block" data-testid="user-display-name">{user.displayName}</span>
+            </div>
+          </div>
+        )}
+      </div>
+
+      {/* Passkey Credentials List Section */}
+      <div className="bg-white border border-gray-200 rounded-xl p-5 shadow-xs">
+        <div className="flex items-center justify-between pb-4 mb-4 border-b border-gray-100">
+          <div>
+            <h2 className="text-lg font-bold text-gray-900">Saved Passkeys</h2>
+            <p className="text-xs text-gray-500">Passkeys created for signing in to this account</p>
+          </div>
+          <button
+            onClick={() => loadManagementPanel()}
+            className="text-xs text-gray-600 hover:text-gray-900 flex items-center gap-1 font-medium"
+          >
+            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="1.5" stroke="currentColor" className="w-3.5 h-3.5">
+              <path strokeLinecap="round" strokeLinejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
+            </svg>
+            Refresh
+          </button>
+        </div>
+
+        {/* Loading State */}
+        {loading && (
+          <div className="py-12 text-center text-gray-500">
+            <svg className="animate-spin h-6 w-6 text-gray-600 mx-auto mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
+              <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4"></circle>
+              <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
+            </svg>
+            <p className="text-sm">Loading registered passkeys...</p>
+          </div>
+        )}
+
+        {/* Empty State */}
+        {!loading && credentials.length === 0 && (
+          <div className="py-12 text-center text-gray-500" data-testid="empty-state">
+            <div className="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-3 text-gray-400">
+              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="1.5" stroke="currentColor" className="w-6 h-6">
+                <path strokeLinecap="round" strokeLinejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
+              </svg>
+            </div>
+            <p className="text-base font-semibold text-gray-700">No passkeys found</p>
+            <p className="text-xs text-gray-500 mt-1">You do not have any passkeys registered yet.</p>
+          </div>
+        )}
+
+        {/* Credential Rows */}
+        {!loading && credentials.length > 0 && (
+          <div className="credential-list divide-y divide-gray-100" id="list-container" data-testid="credential-list">
+            {credentials.map((cred) => {
+              const providerInfo = resolveAaguid(cred.aaguid, cred.name);
+              const displayName = cred.name || providerInfo.name;
+              const providerIcon = cred.providerIcon || providerInfo.providerIcon;
+
+              return (
+                <div
+                  key={cred.id}
+                  data-testid={`credential-item-${cred.id}`}
+                  className="credential-item passkey-row py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-gray-50/50 p-3 rounded-lg transition-colors"
+                >
+                  {/* Left: Icon & Names */}
+                  <div className="flex items-start space-x-3.5 credential-info">
+                    {/* Provider Icon */}
+                    <div className="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0 border border-gray-200 overflow-hidden">
+                      {providerIcon ? (
+                        <img
+                          src={providerIcon}
+                          data-testid="provider-icon"
+                          alt={displayName || 'Passkey provider icon'}
+                          className="w-7 h-7 object-contain passkey-provider-icon provider-icon"
+                        />
+                      ) : (
+                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" strokeWidth="1.5" stroke="currentColor" className="w-5 h-5 text-gray-600">
+                          <path strokeLinecap="round" strokeLinejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
+                        </svg>
+                      )}
+                    </div>
+
+                    {/* Name & Dates */}
+                    <div className="provider-details">
+                      <div className="flex items-center space-x-2">
+                        <span className="font-semibold text-gray-900 text-sm passkey-name provider-name" data-testid="provider-name">
+                          {displayName}
+                        </span>
+                        {cred.aaguid && cred.aaguid !== '00000000-0000-0000-0000-000000000000' && (
+                          <span className="text-[10px] px-1.5 py-0.5 bg-blue-50 text-blue-700 font-mono rounded">
+                            {providerInfo.name}
+                          </span>
+                        )}
+                      </div>
+
+                      <div className="flex flex-wrap items-center gap-x-4 gap-y-1 mt-1 text-xs text-gray-500">
+                        <span className="passkey-registered-date timestamp" data-testid="passkey-registered-date">
+                          Registered: {formatHumanReadableDate(cred.registeredAt)}
+                        </span>
+                        {cred.lastUsedAt && (
+                          <>
+                            <span className="text-gray-300">•</span>
+                            <span className="passkey-last-used-date timestamp font-medium text-gray-700" data-testid="last-used">
+                              Last used: {formatHumanReadableDate(cred.lastUsedAt)}
+                            </span>
+                          </>
+                        )}
+                      </div>
+                    </div>
+                  </div>
+
+                  {/* Right: Actions */}
+                  <div className="flex items-center space-x-2 self-end sm:self-center">
+                    <button
+                      onClick={() => {
+                        setRenamingCred(cred);
+                        setNewCredName(cred.name || displayName);
+                      }}
+                      data-testid={`rename-button-${cred.id}`}
+                      aria-label={`Rename passkey ${displayName}`}
+                      className="rename-btn passkey-rename-btn px-3 py-1.5 text-xs font-semibold text-gray-700 bg-white hover:bg-gray-100 border border-gray-300 rounded-md shadow-2xs transition-colors"
+                    >
+                      Rename
+                    </button>
+                    <button
+                      onClick={() => performDelete(cred.id)}
+                      data-testid={`delete-button-${cred.id}`}
+                      aria-label={`Delete passkey ${displayName}`}
+                      className="delete-btn passkey-delete-btn px-3 py-1.5 text-xs font-semibold text-red-600 bg-white hover:bg-red-50 border border-red-200 rounded-md shadow-2xs transition-colors"
+                    >
+                      Delete
+                    </button>
+                  </div>
+                </div>
+              );
+            })}
+          </div>
+        )}
+      </div>
+
+      {/* Modal: Rename Credential */}
+      {renamingCred && (
+        <div className="fixed inset-0 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 z-50">
+          <div className="bg-white rounded-xl max-w-md w-full p-6 shadow-xl border border-gray-200">
+            <h3 className="text-lg font-bold text-gray-900 mb-2">Rename Passkey</h3>
+            <p className="text-xs text-gray-500 mb-4">
+              Enter a custom label for this passkey to help you identify it in your settings.
+            </p>
+
+            <form onSubmit={performCredentialRename} className="space-y-4">
+              <div>
+                <label htmlFor="cred-rename-input" className="block text-xs font-semibold text-gray-700 uppercase mb-1">
+                  Passkey Name
+                </label>
+                <input
+                  id="cred-rename-input"
+                  type="text"
+                  value={newCredName}
+                  onChange={(e) => setNewCredName(e.target.value)}
+                  required
+                  autoFocus
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                />
+              </div>
+
+              <div className="flex items-center justify-end space-x-3 pt-3 border-t border-gray-100">
+                <button
+                  type="button"
+                  onClick={() => setRenamingCred(null)}
+                  className="px-4 py-2 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-md transition-colors"
+                >
+                  Cancel
+                </button>
+                <button
+                  type="submit"
+                  data-testid="save-cred-rename-btn"
+                  className="px-4 py-2 text-xs font-semibold text-white bg-gray-900 hover:bg-gray-800 rounded-md transition-colors"
+                >
+                  Save Changes
+                </button>
+              </div>
+            </form>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
