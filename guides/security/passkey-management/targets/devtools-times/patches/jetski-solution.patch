index 0000000..63a4fe8
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,783 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import 'webauthn-polyfills';
+import aaguidsData from './aaguids.json' with { type: 'json' };
+import {
+  listFetch,
+  renameCredentialFetch,
+  updateUserFetch,
+  deleteFetch,
+  getUserFetch,
+  registerOptionsFetch,
+  saveRegisteredCredentialFetch,
+  ensureBase64Url,
+  type StoredPasskeyCredential,
+  type StoredUser,
+} from './api';
+
+const aaguids: Record<string, { name: string; icon_light?: string; icon_dark?: string }> =
+  aaguidsData;
+
+const FALLBACK_KEY_ICON_DATA_URI =
+  'data:image/svg+xml;base64,' +
+  btoa(
+    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#1f2937" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>'
+  );
+
+function getDeviceFallbackName(): string {
+  if (typeof navigator === 'undefined') return 'Unknown passkey provider';
+  const ua = navigator.userAgent || '';
+  if (/Macintosh|Mac OS X/i.test(ua)) return 'Mac Passkey';
+  if (/iPhone|iPad|iPod/i.test(ua)) return 'iCloud Keychain Device';
+  if (/Android/i.test(ua)) return 'Android Device Passkey';
+  if (/Windows/i.test(ua)) return 'Windows Device Passkey';
+  return 'Unknown passkey provider';
+}
+
+export function getCredentialProviderMetadata(cred: StoredPasskeyCredential): {
+  providerName: string;
+  displayName: string;
+  providerIcon: string | undefined;
+} {
+  const { aaguid } = cred;
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    const fallbackName = getDeviceFallbackName() || 'Unknown passkey provider';
+    return {
+      providerName: fallbackName,
+      displayName: cred.name || fallbackName,
+      providerIcon: undefined,
+    };
+  } else {
+    const provider = aaguids[aaguid];
+    const providerName = provider?.name || 'Unknown passkey provider';
+    const providerIcon = cred.providerIcon || provider?.icon_light;
+    return {
+      providerName,
+      displayName: cred.name || providerName,
+      providerIcon,
+    };
+  }
+}
+
+export function formatEpochTimestamp(epochMs?: number | null): string {
+  if (epochMs === undefined || epochMs === null || Number.isNaN(Number(epochMs))) {
+    return 'Never';
+  }
+  return new Date(Number(epochMs)).toLocaleDateString('en-US', {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+  });
+}
+
+export default function PasskeyManagement() {
+  const [credentials, setCredentials] = useState<StoredPasskeyCredential[]>([]);
+  const [loading, setLoading] = useState<boolean>(true);
+  const [user, setUser] = useState<StoredUser>({
+    id: 'M2YPl-KGnA8',
+    name: 'eleanor.vance@devtoolstimes.com',
+    displayName: 'Eleanor Vance',
+    rpId: typeof window !== 'undefined' ? window.location.hostname || 'localhost' : 'localhost',
+  });
+
+  // User profile form fields
+  const [userNameInput, setUserNameInput] = useState<string>('eleanor.vance@devtoolstimes.com');
+  const [userDisplayNameInput, setUserDisplayNameInput] = useState<string>('Eleanor Vance');
+  const [savingUser, setSavingUser] = useState<boolean>(false);
+
+  // Per-credential rename states
+  const [editingCredentialId, setEditingCredentialId] = useState<string | null>(null);
+  const [credentialNameInput, setCredentialNameInput] = useState<string>('');
+  const [busyCredentialId, setBusyCredentialId] = useState<string | null>(null);
+
+  // Passkey capability detection state
+  const [passkeySupported, setPasskeySupported] = useState<boolean | null>(null);
+  const [creatingPasskey, setCreatingPasskey] = useState<boolean>(false);
+
+  // Status feedback
+  const [statusMessage, setStatusMessage] = useState<{
+    type: 'success' | 'error' | 'info';
+    text: string;
+  } | null>(null);
+
+  const rpId =
+    (typeof window !== 'undefined' && window.location.hostname) || user.rpId || 'localhost';
+  const base64UrlUserId = ensureBase64Url(user.id || 'M2YPl-KGnA8');
+
+  const syncAcceptedCredentials = useCallback(
+    async (currentCredentialsList: StoredPasskeyCredential[], currentUserId?: string) => {
+      if (
+        typeof window === 'undefined' ||
+        !window.PublicKeyCredential ||
+        !PublicKeyCredential.signalAllAcceptedCredentials
+      ) {
+        return;
+      }
+      try {
+        const credentialIds = currentCredentialsList.map((c) => ensureBase64Url(c.id));
+        const encodedUserId = ensureBase64Url(currentUserId || base64UrlUserId);
+
+        await PublicKeyCredential.signalAllAcceptedCredentials({
+          rpId,
+          userId: encodedUserId,
+          allAcceptedCredentialIds: credentialIds,
+        });
+      } catch (e) {
+        console.error('SignalAllAcceptedCredentials sync failure:', e);
+      }
+    },
+    [rpId, base64UrlUserId]
+  );
+
+  const renderUI = useCallback((list: StoredPasskeyCredential[]) => {
+    setCredentials(Array.isArray(list) ? list : []);
+  }, []);
+
+  const loadManagementPanel = useCallback(async () => {
+    setLoading(true);
+    try {
+      const [userRes, credRes] = await Promise.all([getUserFetch(), listFetch()]);
+      let activeUserId = base64UrlUserId;
+
+      if (userRes.ok) {
+        const userData: StoredUser = await userRes.json();
+        setUser(userData);
+        setUserNameInput(userData.name);
+        setUserDisplayNameInput(userData.displayName);
+        activeUserId = ensureBase64Url(userData.id);
+      }
+
+      if (credRes.ok) {
+        const list: StoredPasskeyCredential[] = await credRes.json();
+        renderUI(list);
+        // Sync accepted credentials on initial load
+        await syncAcceptedCredentials(list, activeUserId);
+      }
+    } catch (e) {
+      console.error('Failed to load passkey management panel:', e);
+      setStatusMessage({
+        type: 'error',
+        text: 'Unable to load your saved passkeys. Please refresh the page.',
+      });
+    } finally {
+      setLoading(false);
+    }
+  }, [base64UrlUserId, renderUI, syncAcceptedCredentials]);
+
+  // Feature-detect passkey platform authenticator support via PublicKeyCredential.getClientCapabilities()
+  useEffect(() => {
+    let mounted = true;
+    async function detectPasskeyCapabilities() {
+      if (
+        typeof window === 'undefined' ||
+        !window.PublicKeyCredential ||
+        !PublicKeyCredential.getClientCapabilities
+      ) {
+        if (mounted) setPasskeySupported(false);
+        return;
+      }
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        const supported = Boolean(
+          capabilities?.passkeyPlatformAuthenticator ||
+            capabilities?.userVerifyingPlatformAuthenticator
+        );
+        if (mounted) {
+          setPasskeySupported(supported);
+        }
+      } catch (err) {
+        console.error('Error checking client capabilities:', err);
+        if (mounted) setPasskeySupported(false);
+      }
+    }
+
+    detectPasskeyCapabilities();
+    loadManagementPanel();
+
+    return () => {
+      mounted = false;
+    };
+  }, [loadManagementPanel]);
+
+  // Delete credential and immediately sync remaining accepted credentials via Signal API
+  async function performDelete(credentialId: string) {
+    setBusyCredentialId(credentialId);
+    setStatusMessage(null);
+    try {
+      const response = await deleteFetch(credentialId);
+      if (response.ok) {
+        const updatedResponse = await listFetch();
+        const updatedList: StoredPasskeyCredential[] = await updatedResponse.json();
+
+        renderUI(updatedList);
+        // Sync remaining accepted credentials after deletion
+        await syncAcceptedCredentials(updatedList);
+        setStatusMessage({
+          type: 'success',
+          text: 'Passkey removed and synchronized with your password manager.',
+        });
+      } else {
+        const errData = await response.json().catch(() => ({}));
+        setStatusMessage({
+          type: 'error',
+          text: errData.error || 'Could not remove passkey.',
+        });
+      }
+    } catch (e) {
+      console.error('Failed to delete passkey:', e);
+      setStatusMessage({
+        type: 'error',
+        text: 'An error occurred while deleting the passkey.',
+      });
+    } finally {
+      setBusyCredentialId(null);
+    }
+  }
+
+  // Renaming a passkey's nickname updates the server record only (does NOT invoke signalCurrentUserDetails)
+  async function performCredentialRename(credentialId: string, newCredentialName: string) {
+    const trimmed = newCredentialName.trim();
+    if (!trimmed) return;
+    setBusyCredentialId(credentialId);
+    setStatusMessage(null);
+    try {
+      const response = await renameCredentialFetch(credentialId, { name: trimmed });
+      if (response.ok) {
+        const updatedResponse = await listFetch();
+        renderUI(await updatedResponse.json());
+        setEditingCredentialId(null);
+        setCredentialNameInput('');
+        setStatusMessage({
+          type: 'success',
+          text: `Passkey renamed to "${trimmed}".`,
+        });
+      } else {
+        const errData = await response.json().catch(() => ({}));
+        setStatusMessage({
+          type: 'error',
+          text: errData.error || 'Failed to rename passkey.',
+        });
+      }
+    } catch (e) {
+      console.error('Failed to rename credential:', e);
+      setStatusMessage({
+        type: 'error',
+        text: 'An error occurred while updating the passkey name.',
+      });
+    } finally {
+      setBusyCredentialId(null);
+    }
+  }
+
+  // Renaming the user's account username or displayName triggers signalCurrentUserDetails
+  async function performUserRename(
+    targetRpId: string,
+    userId: string,
+    updatedName: string,
+    updatedDisplayName: string
+  ) {
+    const cleanName = updatedName.trim();
+    const cleanDisplayName = updatedDisplayName.trim();
+    if (!cleanName || !cleanDisplayName) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Both username and display name are required.',
+      });
+      return;
+    }
+
+    setSavingUser(true);
+    setStatusMessage(null);
+    try {
+      const response = await updateUserFetch({
+        name: cleanName,
+        displayName: cleanDisplayName,
+      });
+
+      if (response.ok) {
+        const updatedUser: StoredUser = await response.json();
+        setUser(updatedUser);
+        setUserNameInput(updatedUser.name);
+        setUserDisplayNameInput(updatedUser.displayName);
+
+        if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+          try {
+            await PublicKeyCredential.signalCurrentUserDetails({
+              rpId: targetRpId,
+              userId: ensureBase64Url(userId),
+              name: cleanName,
+              displayName: cleanDisplayName,
+            });
+          } catch (e) {
+            console.error('SignalCurrentUserDetails sync failure:', e);
+          }
+        }
+
+        setStatusMessage({
+          type: 'success',
+          text: 'Account profile updated and synchronized with your authenticator.',
+        });
+      } else {
+        setStatusMessage({
+          type: 'error',
+          text: 'Failed to update account profile.',
+        });
+      }
+    } catch (e) {
+      console.error('Failed to update user details:', e);
+      setStatusMessage({
+        type: 'error',
+        text: 'An unexpected error occurred while saving your profile.',
+      });
+    } finally {
+      setSavingUser(false);
+    }
+  }
+
+  // Create a new passkey using navigator.credentials.create() omitting authenticatorSelection.authenticatorAttachment
+  async function handleCreatePasskey() {
+    setCreatingPasskey(true);
+    setStatusMessage(null);
+    try {
+      const optionsRes = await registerOptionsFetch();
+      const optionsJSON = await optionsRes.json();
+
+      let publicKeyOptions: PublicKeyCredentialCreationOptions;
+      if (
+        window.PublicKeyCredential &&
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function'
+      ) {
+        publicKeyOptions = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+      } else {
+        const decodeBase64Url = (str: string) => {
+          const base64 = str.replace(/-/g, '+').replace(/_/g, '/');
+          const pad = base64.length % 4 === 0 ? '' : '='.repeat(4 - (base64.length % 4));
+          const bin = atob(base64 + pad);
+          const bytes = new Uint8Array(bin.length);
+          for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
+          return bytes.buffer;
+        };
+        publicKeyOptions = {
+          ...optionsJSON,
+          challenge: decodeBase64Url(optionsJSON.challenge),
+          user: {
+            ...optionsJSON.user,
+            id: decodeBase64Url(optionsJSON.user.id),
+          },
+          excludeCredentials: (optionsJSON.excludeCredentials || []).map((c: any) => ({
+            ...c,
+            id: decodeBase64Url(c.id),
+          })),
+        };
+      }
+
+      // Allow registering a security key by omitting authenticatorSelection.authenticatorAttachment
+      const authenticatorSelection: AuthenticatorSelectionCriteria = {
+        residentKey: 'required',
+        userVerification: 'required',
+      };
+      publicKeyOptions.authenticatorSelection = authenticatorSelection;
+
+      const createdCred = (await navigator.credentials.create({
+        publicKey: publicKeyOptions,
+      })) as PublicKeyCredential | null;
+
+      if (!createdCred) {
+        setStatusMessage({
+          type: 'info',
+          text: 'Passkey registration was cancelled.',
+        });
+        return;
+      }
+
+      const serialized =
+        typeof createdCred.toJSON === 'function'
+          ? createdCred.toJSON()
+          : {
+              id: createdCred.id,
+              type: createdCred.type,
+            };
+
+      const verifyRes = await saveRegisteredCredentialFetch(serialized);
+      if (verifyRes.ok) {
+        const updatedResponse = await listFetch();
+        const updatedList: StoredPasskeyCredential[] = await updatedResponse.json();
+        renderUI(updatedList);
+        await syncAcceptedCredentials(updatedList);
+        setStatusMessage({
+          type: 'success',
+          text: 'New passkey registered and added to your account.',
+        });
+      } else {
+        setStatusMessage({
+          type: 'error',
+          text: 'Failed to verify and save the new passkey.',
+        });
+      }
+    } catch (err: any) {
+      if (err?.name === 'NotAllowedError') {
+        setStatusMessage({
+          type: 'info',
+          text: 'Passkey creation was dismissed or not completed.',
+        });
+      } else {
+        console.error('Passkey creation failed:', err);
+        setStatusMessage({
+          type: 'error',
+          text: 'Could not complete passkey registration on this device.',
+        });
+      }
+    } finally {
+      setCreatingPasskey(false);
+    }
+  }
+
+  return (
+    <div id="account-settings-container" className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
+      {/* Page Header */}
+      <div className="border-b-2 border-gray-900 pb-5 mb-8">
+        <p className="text-xs font-semibold uppercase tracking-widest text-gray-500 mb-1">
+          Subscriber Account &bull; Security &amp; Identity
+        </p>
+        <h1 className="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight">
+          Account Settings
+        </h1>
+        <p className="mt-2 text-sm text-gray-600 max-w-2xl">
+          Manage your reader profile details, registered passkeys, and passwordless sign-in
+          credentials synchronized with your browser authenticator.
+        </p>
+      </div>
+
+      {/* Status Alert Banner */}
+      {statusMessage && (
+        <div
+          id="passkey-status-alert"
+          role="status"
+          aria-live="polite"
+          className={`mb-6 p-4 rounded-md border flex items-center justify-between text-sm ${
+            statusMessage.type === 'success'
+              ? 'bg-emerald-50 border-emerald-200 text-emerald-900'
+              : statusMessage.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-900'
+              : 'bg-gray-50 border-gray-300 text-gray-800'
+          }`}
+        >
+          <span>{statusMessage.text}</span>
+          <button
+            type="button"
+            id="dismiss-status-btn"
+            onClick={() => setStatusMessage(null)}
+            className="ml-4 text-xs font-semibold underline hover:opacity-80"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      <div className="space-y-8">
+        {/* Section 1: User Account Profile & Rename UI */}
+        <section
+          id="reader-profile-section"
+          aria-labelledby="reader-profile-heading"
+          className="bg-white border border-gray-200 rounded-lg shadow-xs overflow-hidden"
+        >
+          <div className="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
+            <div>
+              <h2 id="reader-profile-heading" className="text-lg font-bold text-gray-900">
+                Reader Profile Details
+              </h2>
+              <p className="text-xs text-gray-600 mt-0.5">
+                Updating your username or display name automatically syncs with your saved passkeys
+                via the WebAuthn Signal API.
+              </p>
+            </div>
+            <span className="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-gray-200 text-gray-800">
+              Signed In
+            </span>
+          </div>
+
+          <form
+            id="user-profile-form"
+            onSubmit={(e) => {
+              e.preventDefault();
+              performUserRename(rpId, base64UrlUserId, userNameInput, userDisplayNameInput);
+            }}
+            className="p-6"
+          >
+            <div className="grid grid-cols-1 sm:grid-cols-2 gap-5">
+              <div>
+                <label
+                  htmlFor="account-username-input"
+                  className="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5"
+                >
+                  Username / Email
+                </label>
+                <input
+                  id="account-username-input"
+                  name="name"
+                  type="text"
+                  required
+                  value={userNameInput}
+                  onChange={(e) => setUserNameInput(e.target.value)}
+                  className="w-full px-3.5 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-gray-900"
+                />
+              </div>
+
+              <div>
+                <label
+                  htmlFor="account-displayname-input"
+                  className="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5"
+                >
+                  Display Name
+                </label>
+                <input
+                  id="account-displayname-input"
+                  name="displayName"
+                  type="text"
+                  required
+                  value={userDisplayNameInput}
+                  onChange={(e) => setUserDisplayNameInput(e.target.value)}
+                  className="w-full px-3.5 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900 focus:border-gray-900"
+                />
+              </div>
+            </div>
+
+            <div className="mt-5 flex items-center justify-between pt-4 border-t border-gray-100">
+              <span className="text-xs text-gray-500">
+                Reader ID: <code className="font-mono text-gray-700">{base64UrlUserId}</code>
+              </span>
