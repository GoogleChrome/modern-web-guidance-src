@@ -0,0 +1,58 @@
+import type { APIRoute } from 'astro';
+import { deviceNameFromUserAgent, resolveAaguid, ZERO_AAGUID } from '../../../lib/passkeys/aaguid';
+import { getExpectedOrigin, getRpId } from '../../../lib/passkeys/config';
+import { saveCredential, takeChallenge } from '../../../lib/passkeys/db';
+import { toPublicCredential } from '../../../lib/passkeys/serialize';
+import { getSignedInUser, jsonResponse, unauthorized } from '../../../lib/passkeys/session';
+import {
+  RegistrationVerificationError,
+  verifyRegistrationResponse,
+  type RegistrationResponseJSON,
+} from '../../../lib/passkeys/webauthn';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  const expected = takeChallenge(user.passkeyUserId);
+  if (!expected) {
+    return jsonResponse({ error: 'No pending registration challenge.' }, 400);
+  }
+
+  const credential = (await request.json()) as RegistrationResponseJSON;
+
+  try {
+    const verified = await verifyRegistrationResponse(credential, {
+      challenge: expected.challenge,
+      origin: getExpectedOrigin(url),
+      rpId: getRpId(url),
+    });
+
+    const { aaguid } = verified;
+    const fallbackName =
+      aaguid === ZERO_AAGUID
+        ? deviceNameFromUserAgent(request.headers.get('user-agent'))
+        : undefined;
+    const provider = resolveAaguid(aaguid, fallbackName);
+
+    const stored = {
+      id: verified.credentialId,
+      publicKey: verified.publicKey,
+      passkeyUserId: user.passkeyUserId,
+      aaguid,
+      name: provider.name,
+      providerIcon: provider.providerIcon,
+      registeredAt: Date.now(),
+      lastUsedAt: Date.now(),
+      transports: verified.transports,
+    };
+    saveCredential(stored);
+
+    return jsonResponse(toPublicCredential(stored), 201);
+  } catch (error) {
+    if (error instanceof RegistrationVerificationError) {
+      return jsonResponse({ error: error.message }, 400);
+    }
+    return jsonResponse({ error: 'Could not verify the registration response.' }, 400);
+  }
+};
