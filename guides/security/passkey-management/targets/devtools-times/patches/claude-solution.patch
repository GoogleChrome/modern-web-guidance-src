+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { getOrCreateSignedInUser } from '../../../lib/server/auth';
+import { saveCredential } from '../../../lib/server/db';
+import { resolveAaguid, ZERO_AAGUID } from '../../../lib/server/aaguid';
+import { deviceNameFromUserAgent } from '../../../lib/server/device';
+import { getRpId } from '../../../lib/server/rp';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getOrCreateSignedInUser(session);
+  const expectedChallenge = await session?.get('currentRegistrationChallenge');
+  if (!expectedChallenge) {
+    return new Response(JSON.stringify({ error: 'No registration in progress.' }), { status: 400 });
+  }
+
+  const response = await request.json();
+
+  let verification;
+  try {
+    verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: request.headers.get('origin') || url.origin,
+      expectedRPID: getRpId(url),
+    });
+  } catch (error) {
+    return new Response(JSON.stringify({ error: (error as Error).message }), { status: 400 });
+  }
+
+  session?.delete('currentRegistrationChallenge');
+
+  if (!verification.verified) {
+    return new Response(JSON.stringify({ error: 'Passkey registration could not be verified.' }), { status: 400 });
+  }
+
+  const { aaguid, credential } = verification.registrationInfo;
+  const fallbackName =
+    aaguid === ZERO_AAGUID ? deviceNameFromUserAgent(request.headers.get('user-agent')) : 'Unknown passkey provider';
+  const { name, providerIcon } = resolveAaguid(aaguid, fallbackName);
+
+  const stored = saveCredential({
+    id: credential.id,
+    passkeyUserId: user.id,
+    publicKey: isoBase64URL.fromBuffer(credential.publicKey),
+    counter: credential.counter,
+    transports: credential.transports,
+    aaguid,
+    name,
+    providerIcon,
+    registeredAt: Date.now(),
+    lastUsedAt: undefined,
+  });
+
+  return new Response(JSON.stringify(stored), {
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
