+import type { APIRoute } from 'astro';
+import { getOrCreateSignedInUser } from '../../lib/server/auth';
+import { updateUser } from '../../lib/server/db';
+import { getRpId } from '../../lib/server/rp';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getOrCreateSignedInUser(session);
+  return new Response(JSON.stringify({ ...user, rpId: getRpId(url) }), {
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const user = await getOrCreateSignedInUser(session);
+  const { name, displayName } = await request.json();
+
+  const updatedUser = updateUser(user.id, { name, displayName });
+  return new Response(JSON.stringify({ ...updatedUser, rpId: getRpId(url) }), {
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
