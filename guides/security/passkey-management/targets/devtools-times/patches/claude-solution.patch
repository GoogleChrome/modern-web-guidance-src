diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..7e2df2c
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,316 @@
+import React, { useCallback, useEffect, useState } from 'react';
+import { KeyIcon, PencilIcon, TrashIcon } from '@heroicons/react/24/outline';
+import { startRegistration } from '@simplewebauthn/browser';
+import {
+  deleteFetch,
+  getUserFetch,
+  listFetch,
+  registerPasskeyFetch,
+  registrationOptionsFetch,
+  renameCredentialFetch,
+  updateUserFetch,
+  type CurrentUser,
+  type StoredPasskeyCredential,
+} from '../lib/client/passkey-api';
+import { isPasskeyCreationSupported, signalAllAcceptedCredentials, signalCurrentUserDetails } from '../lib/client/webauthn';
+
+function formatDate(epochMs: number | undefined): string {
+  if (!epochMs) return 'Never used';
+  return new Date(epochMs).toLocaleDateString(undefined, {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+  });
+}
+
+export default function PasskeyManagement() {
+  const [credentials, setCredentials] = useState<StoredPasskeyCredential[] | null>(null);
+  const [user, setUser] = useState<CurrentUser | null>(null);
+  const [canCreatePasskey, setCanCreatePasskey] = useState(false);
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [renamingId, setRenamingId] = useState<string | null>(null);
+  const [renameDraft, setRenameDraft] = useState('');
+  const [nameDraft, setNameDraft] = useState('');
+  const [displayNameDraft, setDisplayNameDraft] = useState('');
+  const [creatingPasskey, setCreatingPasskey] = useState(false);
+
+  const loadCredentials = useCallback(async (currentUser: CurrentUser) => {
+    const response = await listFetch();
+    const list: StoredPasskeyCredential[] = await response.json();
+    setCredentials(list);
+
+    await signalAllAcceptedCredentials({
+      rpId: currentUser.rpId,
+      userId: currentUser.id,
+      allAcceptedCredentialIds: list.map((credential) => credential.id),
+    });
+
+    return list;
+  }, []);
+
+  useEffect(() => {
+    let cancelled = false;
+
+    async function loadManagementPanel() {
+      const userResponse = await getUserFetch();
+      const currentUser: CurrentUser = await userResponse.json();
+      if (cancelled) return;
+
+      setUser(currentUser);
+      setNameDraft(currentUser.name);
+      setDisplayNameDraft(currentUser.displayName);
+
+      await loadCredentials(currentUser);
+      if (cancelled) return;
+
+      setCanCreatePasskey(await isPasskeyCreationSupported());
+    }
+
+    loadManagementPanel();
+    return () => {
+      cancelled = true;
+    };
+  }, [loadCredentials]);
+
+  async function handleDelete(credentialId: string) {
+    setErrorMessage(null);
+    const response = await deleteFetch(credentialId);
+    if (!response.ok) {
+      setErrorMessage('Could not delete that passkey. Please try again.');
+      return;
+    }
+    if (user) {
+      await loadCredentials(user);
+    }
+    setStatusMessage('Passkey deleted.');
+  }
+
+  function startRename(credential: StoredPasskeyCredential) {
+    setRenamingId(credential.id);
+    setRenameDraft(credential.name);
+  }
+
+  async function submitRename(credentialId: string) {
+    setErrorMessage(null);
+    const response = await renameCredentialFetch(credentialId, renameDraft);
+    if (!response.ok) {
+      setErrorMessage('Could not rename that passkey. Please try again.');
+      return;
+    }
+    setRenamingId(null);
+    if (user) {
+      const updatedResponse = await listFetch();
+      setCredentials(await updatedResponse.json());
+    }
+  }
+
+  async function handleUserRename(e: React.FormEvent) {
+    e.preventDefault();
+    if (!user) return;
+    setErrorMessage(null);
+
+    const response = await updateUserFetch(nameDraft, displayNameDraft);
+    if (!response.ok) {
+      setErrorMessage('Could not update your account details. Please try again.');
+      return;
+    }
+
+    const updatedUser: CurrentUser = await response.json();
+    setUser(updatedUser);
+
+    await signalCurrentUserDetails({
+      rpId: updatedUser.rpId,
+      userId: updatedUser.id,
+      name: updatedUser.name,
+      displayName: updatedUser.displayName,
+    });
+    setStatusMessage('Account details updated.');
+  }
+
+  async function handleCreatePasskey() {
+    if (!user) return;
+    setErrorMessage(null);
+    setCreatingPasskey(true);
+
+    try {
+      const optionsResponse = await registrationOptionsFetch();
+      const optionsJSON = await optionsResponse.json();
+
+      const registrationResponse = await startRegistration({ optionsJSON });
+
+      const verifyResponse = await registerPasskeyFetch(registrationResponse);
+      if (!verifyResponse.ok) {
+        const { error } = await verifyResponse.json();
+        setErrorMessage(error || 'Could not create a passkey. Please try again.');
+        return;
+      }
+
+      await loadCredentials(user);
+      setStatusMessage('Passkey created.');
+    } catch (error) {
+      setErrorMessage((error as Error).message || 'Could not create a passkey. Please try again.');
+    } finally {
+      setCreatingPasskey(false);
+    }
+  }
+
+  return (
+    <div className="max-w-2xl mx-auto py-10 px-4 space-y-10">
+      <section>
+        <h1 className="text-2xl font-bold text-gray-900">Passkeys</h1>
+        <p className="text-sm text-gray-500 mt-1">
+          Manage the passkeys you use to sign in to The DevTools Times.
+        </p>
+      </section>
+
+      {statusMessage && (
+        <div className="p-3 text-sm text-green-700 bg-green-100 rounded-lg" role="status">
+          {statusMessage}
+        </div>
+      )}
+      {errorMessage && (
+        <div className="p-3 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
+          {errorMessage}
+        </div>
+      )}
+
+      <section>
+        {credentials === null && <p className="text-sm text-gray-500">Loading passkeys…</p>}
+
+        {credentials !== null && credentials.length === 0 && (
+          <p className="text-sm text-gray-500 border border-dashed border-gray-300 rounded-lg p-6 text-center">
+            No passkeys found.
+          </p>
+        )}
+
+        {credentials !== null && credentials.length > 0 && (
+          <ul className="divide-y divide-gray-200 border border-gray-200 rounded-lg">
+            {credentials.map((credential) => (
+              <li key={credential.id} className="flex items-center gap-4 p-4">
+                {credential.providerIcon ? (
+                  <img src={credential.providerIcon} alt="" className="w-8 h-8 shrink-0" />
+                ) : (
+                  <KeyIcon className="w-8 h-8 shrink-0 text-gray-400" aria-hidden="true" />
+                )}
+
+                <div className="flex-1 min-w-0">
+                  {renamingId === credential.id ? (
+                    <div className="flex items-center gap-2">
+                      <input
+                        type="text"
+                        value={renameDraft}
+                        onChange={(e) => setRenameDraft(e.target.value)}
+                        className="px-2 py-1 border border-gray-300 rounded-md text-sm w-full"
+                        autoFocus
+                      />
+                      <button
+                        type="button"
+                        onClick={() => submitRename(credential.id)}
+                        className="text-xs font-semibold text-blue-700 whitespace-nowrap"
+                      >
+                        Save
+                      </button>
+                      <button
+                        type="button"
+                        onClick={() => setRenamingId(null)}
+                        className="text-xs text-gray-500 whitespace-nowrap"
+                      >
+                        Cancel
+                      </button>
+                    </div>
+                  ) : (
+                    <p className="font-medium text-gray-900 truncate">{credential.name}</p>
+                  )}
+                  <p className="text-xs text-gray-500 mt-0.5">
+                    Registered {formatDate(credential.registeredAt)} · Last used {formatDate(credential.lastUsedAt)}
+                  </p>
+                </div>
+
+                {renamingId !== credential.id && (
+                  <div className="flex items-center gap-3 shrink-0">
+                    <button
+                      type="button"
+                      onClick={() => startRename(credential)}
+                      aria-label={`Rename ${credential.name}`}
+                      className="text-gray-400 hover:text-gray-700"
+                    >
+                      <PencilIcon className="w-5 h-5" />
+                    </button>
+                    <button
+                      type="button"
+                      onClick={() => handleDelete(credential.id)}
+                      aria-label={`Delete ${credential.name}`}
+                      className="text-gray-400 hover:text-red-600"
+                    >
+                      <TrashIcon className="w-5 h-5" />
+                    </button>
+                  </div>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      <section>
+        {canCreatePasskey ? (
+          <button
+            type="button"
+            onClick={handleCreatePasskey}
+            disabled={creatingPasskey}
+            className={`py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 ${
+              creatingPasskey ? 'opacity-75 cursor-not-allowed' : ''
+            }`}
+          >
+            {creatingPasskey ? 'Creating passkey…' : 'Create passkey'}
+          </button>
+        ) : (
+          <p className="text-sm text-gray-500">
+            Passkeys aren't supported on this device or browser. Consider enrolling in another
+            multi-factor authentication method instead.
+          </p>
+        )}
+      </section>
+
+      <section className="border-t border-gray-200 pt-8">
+        <h2 className="text-lg font-semibold text-gray-900">Account details</h2>
+        <p className="text-sm text-gray-500 mt-1">
+          Keep your username and display name in sync with your password manager.
+        </p>
+        <form onSubmit={handleUserRename} className="space-y-4 mt-4">
+          <div>
+            <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">
+              Username
+            </label>
+            <input
+              id="account-username"
+              type="text"
+              value={nameDraft}
+              onChange={(e) => setNameDraft(e.target.value)}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+          </div>
+          <div>
+            <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+              Display name
+            </label>
+            <input
+              id="account-display-name"
+              type="text"
+              value={displayNameDraft}
+              onChange={(e) => setDisplayNameDraft(e.target.value)}
+              className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
+            />
+          </div>
+          <button
+            type="submit"
+            className="py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800"
+          >
+            Save account details
+          </button>
+        </form>
+      </section>
+    </div>
+  );
+}
