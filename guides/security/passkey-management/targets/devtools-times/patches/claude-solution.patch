+import type { APIRoute } from 'astro';
+import { getOrCreateSignedInUser } from '../../../lib/server/auth';
+import { deleteCredential, findCredentialById, saveCredential } from '../../../lib/server/db';
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const user = await getOrCreateSignedInUser(session);
+  const { id } = params;
+  const { name } = await request.json();
+
+  const credential = id ? findCredentialById(id) : undefined;
+  if (!credential || credential.passkeyUserId !== user.id) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), { status: 404 });
+  }
+
+  const updated = saveCredential({ ...credential, name });
+  return new Response(JSON.stringify(updated), {
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getOrCreateSignedInUser(session);
+  const { id } = params;
+
+  const credential = id ? findCredentialById(id) : undefined;
+  if (!credential || credential.passkeyUserId !== user.id) {
+    return new Response(JSON.stringify({ error: 'Credential not found.' }), { status: 404 });
+  }
+
+  deleteCredential(credential.id);
+  return new Response(JSON.stringify({ success: true }), {
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
