+import type { StoredPasskeyCredential, StoredUser } from '../server/db';
+
+const JSON_HEADERS = { 'Content-Type': 'application/json' };
+
+export function listFetch(): Promise<Response> {
+  return fetch('/api/credentials');
+}
+
+export function renameCredentialFetch(credentialId: string, name: string): Promise<Response> {
+  return fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+    method: 'PUT',
+    headers: JSON_HEADERS,
+    body: JSON.stringify({ name }),
+  });
+}
+
+export function deleteFetch(credentialId: string): Promise<Response> {
+  return fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+    method: 'DELETE',
+  });
+}
+
+export type CurrentUser = StoredUser & { rpId: string };
+
+export function getUserFetch(): Promise<Response> {
+  return fetch('/api/user');
+}
+
+export function updateUserFetch(name: string, displayName: string): Promise<Response> {
+  return fetch('/api/user', {
+    method: 'PUT',
+    headers: JSON_HEADERS,
+    body: JSON.stringify({ name, displayName }),
+  });
+}
+
+export function registrationOptionsFetch(): Promise<Response> {
+  return fetch('/api/passkey/registration-options');
+}
+
+export function registerPasskeyFetch(response: unknown): Promise<Response> {
+  return fetch('/api/passkey/register', {
+    method: 'POST',
+    headers: JSON_HEADERS,
+    body: JSON.stringify(response),
+  });
+}
+
+export type { StoredPasskeyCredential };
diff --git a/src/lib/client/webauthn.ts b/src/lib/client/webauthn.ts
new file mode 100644
index 0000000..2303b97
--- /dev/null
+++ b/src/lib/client/webauthn.ts
@@ -0,0 +1,76 @@
+// These WebAuthn Level 3 APIs (client capabilities + the Signal API) aren't in
+// TypeScript's DOM lib yet, and not every browser implements them natively, so
+// this is both the type augmentation point and the polyfill install point
+// ("the context" the guide refers to).
+import 'webauthn-polyfills';
+
+export interface ClientCapabilities {
+  conditionalCreate?: boolean;
+  conditionalGet?: boolean;
+  hybridTransport?: boolean;
+  passkeyPlatformAuthenticator?: boolean;
+  relatedOrigins?: boolean;
+  signalAllAcceptedCredentials?: boolean;
+  signalCurrentUserDetails?: boolean;
+  signalUnknownCredential?: boolean;
+  userVerifyingPlatformAuthenticator?: boolean;
+}
+
+interface SignalAllAcceptedCredentialsOptions {
+  rpId: string;
+  userId: string;
+  allAcceptedCredentialIds: string[];
+}
+
+interface SignalCurrentUserDetailsOptions {
+  rpId: string;
+  userId: string;
+  name: string;
+  displayName: string;
+}
+
+type ExtendedPublicKeyCredential = typeof PublicKeyCredential & {
+  getClientCapabilities?: () => Promise<ClientCapabilities>;
+  signalAllAcceptedCredentials?: (options: SignalAllAcceptedCredentialsOptions) => Promise<void>;
+  signalCurrentUserDetails?: (options: SignalCurrentUserDetailsOptions) => Promise<void>;
+};
+
+function getPublicKeyCredential(): ExtendedPublicKeyCredential | undefined {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) return undefined;
+  return window.PublicKeyCredential as ExtendedPublicKeyCredential;
+}
+
+/**
+ * Feature-detects whether this browser can create a passkey backed by a
+ * platform authenticator, per the guide's "Conditional Create Passkey Button"
+ * requirement.
+ */
+export async function isPasskeyCreationSupported(): Promise<boolean> {
+  const publicKeyCredential = getPublicKeyCredential();
+  if (!publicKeyCredential?.getClientCapabilities) return false;
+
+  const capabilities = await publicKeyCredential.getClientCapabilities();
+  return Boolean(capabilities.passkeyPlatformAuthenticator);
+}
+
+export async function signalAllAcceptedCredentials(options: SignalAllAcceptedCredentialsOptions): Promise<void> {
+  const publicKeyCredential = getPublicKeyCredential();
+  if (!publicKeyCredential?.signalAllAcceptedCredentials) return;
+
+  try {
+    await publicKeyCredential.signalAllAcceptedCredentials(options);
+  } catch (error) {
+    console.error('SignalAllAcceptedCredentials sync failure:', error);
+  }
+}
+
+export async function signalCurrentUserDetails(options: SignalCurrentUserDetailsOptions): Promise<void> {
+  const publicKeyCredential = getPublicKeyCredential();
+  if (!publicKeyCredential?.signalCurrentUserDetails) return;
+
+  try {
+    await publicKeyCredential.signalCurrentUserDetails(options);
+  } catch (error) {
+    console.error('SignalCurrentUserDetails sync failure:', error);
+  }
+}
