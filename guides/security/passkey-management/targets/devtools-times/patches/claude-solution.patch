diff --git a/src/lib/passkeys/aaguid.ts b/src/lib/passkeys/aaguid.ts
new file mode 100644
index 0000000..6f21bb1
--- /dev/null
+++ b/src/lib/passkeys/aaguid.ts
@@ -0,0 +1,43 @@
+import registry from './aaguids.json';
+
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+export const UNKNOWN_PROVIDER = 'Unknown passkey provider';
+
+export interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+export interface ResolvedProvider {
+  name: string;
+  providerIcon?: string;
+}
+
+const aaguids = registry as Record<string, AaguidEntry>;
+
+/**
+ * Looks up an AAGUID in the local registry. AAGUIDs identify the authenticator
+ * model, not an instance, and are only trustworthy enough for management UI.
+ */
+export function resolveAaguid(aaguid: string, fallbackName?: string): ResolvedProvider {
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    return { name: fallbackName || UNKNOWN_PROVIDER, providerIcon: undefined };
+  }
+  const provider = aaguids[aaguid.toLowerCase()];
+  return {
+    name: provider?.name || fallbackName || UNKNOWN_PROVIDER,
+    providerIcon: provider?.icon_light,
+  };
+}
+
+/** Best-effort device name derived from a user-agent string, used for zeroed AAGUIDs. */
+export function deviceNameFromUserAgent(userAgent: string | null | undefined): string {
+  if (!userAgent) return UNKNOWN_PROVIDER;
+  if (/iPhone|iPad|iPod/i.test(userAgent)) return 'iOS device';
+  if (/Android/i.test(userAgent)) return 'Android device';
+  if (/Mac OS X/i.test(userAgent)) return 'Mac';
+  if (/Windows/i.test(userAgent)) return 'Windows device';
+  if (/Linux/i.test(userAgent)) return 'Linux device';
+  return UNKNOWN_PROVIDER;
+}
