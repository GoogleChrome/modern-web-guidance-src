+export interface StoredPasskeyCredential {
+  /** Base64URL-encoded credential ID. */
+  id: string;
+  /** Base64URL-encoded COSE public key. */
+  publicKey: string;
+  /** Base64URL-encoded user handle the credential was registered against. */
+  passkeyUserId: string;
+  /** Provider name from the AAGUID registry, or a user-supplied custom name. */
+  name: string;
+  aaguid: string;
+  providerIcon?: string;
+  /** Raw epoch milliseconds. */
+  registeredAt: number;
+  /** Raw epoch milliseconds. */
+  lastUsedAt?: number;
+  transports?: AuthenticatorTransport[];
+}
+
+export interface StoredUser {
+  /** Internal user ID. */
+  id: string;
+  /** Base64URL-encoded WebAuthn user handle. */
+  passkeyUserId: string;
+  username: string;
+  displayName: string;
+}
+
+export interface RegistrationChallenge {
+  challenge: string;
+  passkeyUserId: string;
+  createdAt: number;
+}
diff --git a/src/lib/passkeys/webauthn.ts b/src/lib/passkeys/webauthn.ts
