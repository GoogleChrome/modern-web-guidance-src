@@ -0,0 +1,33 @@
+import aaguids from './aaguids.json';
+
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+const registry = aaguids as Record<string, AaguidEntry>;
+
+export interface ResolvedPasskeyProvider {
+  name: string;
+  providerIcon: string | undefined;
+}
+
+/**
+ * Resolve a passkey's AAGUID into a human-friendly provider name and icon using
+ * the community-maintained passkey-authenticator-aaguids registry. A zeroed-out
+ * AAGUID is not an attestable provider identity, so it is never looked up.
+ */
+export function resolveAaguid(aaguid: string | undefined, fallbackName: string): ResolvedPasskeyProvider {
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    return { name: fallbackName, providerIcon: undefined };
+  }
+
+  const provider = registry[aaguid];
+  return {
+    name: provider?.name || fallbackName,
+    providerIcon: provider?.icon_light,
+  };
+}
