diff --git a/src/lib/passkeys/db.ts b/src/lib/passkeys/db.ts
new file mode 100644
index 0000000..0480c56
--- /dev/null
+++ b/src/lib/passkeys/db.ts
@@ -0,0 +1,107 @@
+import { resolveAaguid } from './aaguid';
+import { stringToBase64Url } from './base64url';
+import type { RegistrationChallenge, StoredPasskeyCredential, StoredUser } from './types';
+
+interface PasskeyStore {
+  users: Map<string, StoredUser>;
+  credentials: Map<string, StoredPasskeyCredential>;
+  challenges: Map<string, RegistrationChallenge>;
+}
+
+export const DEMO_USER_ID = 'user-1';
+
+const STORE_KEY = Symbol.for('devtools-times.passkey-store');
+const DAY = 24 * 60 * 60 * 1000;
+
+function seedCredential(
+  target: PasskeyStore,
+  passkeyUserId: string,
+  aaguid: string,
+  registeredDaysAgo: number,
+  lastUsedDaysAgo: number | undefined,
+): void {
+  const id = stringToBase64Url(`demo-credential-${target.credentials.size + 1}`);
+  const provider = resolveAaguid(aaguid);
+  target.credentials.set(id, {
+    id,
+    publicKey: stringToBase64Url(`demo-public-key-${id}`),
+    passkeyUserId,
+    aaguid,
+    name: provider.name,
+    providerIcon: provider.providerIcon,
+    registeredAt: Date.now() - registeredDaysAgo * DAY,
+    lastUsedAt: lastUsedDaysAgo === undefined ? undefined : Date.now() - lastUsedDaysAgo * DAY,
+    transports: ['internal', 'hybrid'],
+  });
+}
+
+function createStore(): PasskeyStore {
+  const target: PasskeyStore = {
+    users: new Map(),
+    credentials: new Map(),
+    challenges: new Map(),
+  };
+
+  const passkeyUserId = stringToBase64Url(DEMO_USER_ID);
+  target.users.set(DEMO_USER_ID, {
+    id: DEMO_USER_ID,
+    passkeyUserId,
+    username: 'ada.lovelace@example.com',
+    displayName: 'Ada Lovelace',
+  });
+  seedCredential(target, passkeyUserId, 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', 96, 2);
+  seedCredential(target, passkeyUserId, 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd', 41, 9);
+  seedCredential(target, passkeyUserId, 'cb69481e-8ff7-4039-93ec-0a2729a154a8', 12, undefined);
+
+  return target;
+}
+
+// The dev server re-evaluates modules on change; keep the store on globalThis so
+// registered passkeys survive hot reloads.
+const globalStore = globalThis as Record<symbol, unknown>;
+
+function getStore(): PasskeyStore {
+  const existing = globalStore[STORE_KEY] as PasskeyStore | undefined;
+  if (existing) return existing;
+  const created = createStore();
+  globalStore[STORE_KEY] = created;
+  return created;
+}
+
+export function findUserById(userId: string): StoredUser | undefined {
+  return getStore().users.get(userId);
+}
+
+export function saveUser(user: StoredUser): void {
+  getStore().users.set(user.id, user);
+}
+
+/** Credentials are keyed by the WebAuthn user handle of their owner. */
+export function findCredentialsByUserId(passkeyUserId: string): StoredPasskeyCredential[] {
+  return [...getStore().credentials.values()]
+    .filter((credential) => credential.passkeyUserId === passkeyUserId)
+    .sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export function findCredentialById(id: string): StoredPasskeyCredential | undefined {
+  return getStore().credentials.get(id);
+}
+
+export function saveCredential(credential: StoredPasskeyCredential): void {
+  getStore().credentials.set(credential.id, credential);
+}
+
+export function deleteCredential(id: string): void {
+  getStore().credentials.delete(id);
+}
+
+export function saveChallenge(challenge: RegistrationChallenge): void {
+  getStore().challenges.set(challenge.passkeyUserId, challenge);
+}
+
+export function takeChallenge(passkeyUserId: string): RegistrationChallenge | undefined {
+  const store = getStore();
+  const challenge = store.challenges.get(passkeyUserId);
+  store.challenges.delete(passkeyUserId);
+  return challenge;
+}
diff --git a/src/lib/passkeys/serialize.ts b/src/lib/passkeys/serialize.ts
new file mode 100644
index 0000000..0fd7795
--- /dev/null
+++ b/src/lib/passkeys/serialize.ts
@@ -0,0 +1,28 @@
+import { resolveAaguid } from './aaguid';
+import type { StoredPasskeyCredential } from './types';
+
+/** Credential shape sent to the browser — the public key never leaves the server. */
+export interface PublicCredential {
+  id: string;
+  passkeyUserId: string;
+  name: string;
+  aaguid: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+  transports?: AuthenticatorTransport[];
+}
+
+export function toPublicCredential(credential: StoredPasskeyCredential): PublicCredential {
+  const provider = resolveAaguid(credential.aaguid);
+  return {
+    id: credential.id,
+    passkeyUserId: credential.passkeyUserId,
+    name: credential.name || provider.name,
+    aaguid: credential.aaguid,
+    providerIcon: credential.providerIcon ?? provider.providerIcon,
+    registeredAt: credential.registeredAt,
+    lastUsedAt: credential.lastUsedAt,
+    transports: credential.transports,
+  };
+}
diff --git a/src/lib/passkeys/session.ts b/src/lib/passkeys/session.ts
