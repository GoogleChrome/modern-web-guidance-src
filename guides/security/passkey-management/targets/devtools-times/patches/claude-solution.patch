+import type { AstroSession } from 'astro';
+import { generateUserID, isoBase64URL } from '@simplewebauthn/server/helpers';
+import { createUser, findUserById, type StoredUser } from './db';
+
+/**
+ * This demo app has no standalone login flow wired up to real credentials, so a
+ * signed-in user is represented purely by a `passkeyUserId` kept in the Astro
+ * session (the same session primitive the reading list feature already relies
+ * on). The first time a visitor hits a passkey-aware endpoint, a user record is
+ * created for them and remembered in their session cookie.
+ */
+export async function getOrCreateSignedInUser(session: AstroSession | undefined): Promise<StoredUser> {
+  if (!session) {
+    throw new Error('Sessions are required for passkey management.');
+  }
+
+  const existingUserId = await session.get('passkeyUserId');
+  if (existingUserId) {
+    const existingUser = findUserById(existingUserId);
+    if (existingUser) {
+      return existingUser;
+    }
+  }
+
+  const userId = isoBase64URL.fromBuffer(await generateUserID());
+  const user = createUser({ id: userId, name: 'new.user', displayName: 'New User' });
+  session.set('passkeyUserId', userId);
+  return user;
+}
diff --git a/src/lib/server/db.ts b/src/lib/server/db.ts
new file mode 100644
index 0000000..2abccc9
--- /dev/null
+++ b/src/lib/server/db.ts
@@ -0,0 +1,112 @@
+import { isoBase64URL } from '@simplewebauthn/server/helpers';
+import { resolveAaguid } from './aaguid';
+
+/**
+ * A passkey credential as persisted by the relying party. `id` and `passkeyUserId`
+ * are always Base64URL-encoded strings so they can be handed directly to the
+ * Signal API and to `navigator.credentials.get()`'s `allowCredentials` list.
+ */
+export interface StoredPasskeyCredential {
+  id: string;
+  passkeyUserId: string;
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  aaguid: string;
+  name: string;
+  providerIcon?: string;
+  registeredAt: number;
+  lastUsedAt?: number;
+}
+
+export interface StoredUser {
+  id: string;
+  name: string;
+  displayName: string;
+}
+
+// A process-lifetime, in-memory store standing in for a real database. Reset
+// on server restart.
+const users = new Map<string, StoredUser>();
+const credentials = new Map<string, StoredPasskeyCredential>();
+
+function seedDemoData() {
+  const demoUserId = 'MqDhSVF2eU5XQTBiSQ';
+  users.set(demoUserId, {
+    id: demoUserId,
+    name: 'ada.lovelace',
+    displayName: 'Ada Lovelace',
+  });
+
+  const now = 1735689600000; // fixed seed timestamp so demo data is stable across restarts
+  const demoCredentialSeeds: Array<Omit<StoredPasskeyCredential, 'name' | 'providerIcon'>> = [
+    {
+      id: 'demo-credential-icloud-1',
+      passkeyUserId: demoUserId,
+      publicKey: isoBase64URL.fromBuffer(new Uint8Array([1, 2, 3, 4])),
+      counter: 0,
+      transports: ['internal', 'hybrid'],
+      aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+      registeredAt: now - 1000 * 60 * 60 * 24 * 30,
+      lastUsedAt: now - 1000 * 60 * 60 * 2,
+    },
+    {
+      id: 'demo-credential-gpm-1',
+      passkeyUserId: demoUserId,
+      publicKey: isoBase64URL.fromBuffer(new Uint8Array([5, 6, 7, 8])),
+      counter: 0,
+      transports: ['internal', 'hybrid'],
+      aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      registeredAt: now - 1000 * 60 * 60 * 24 * 10,
+      lastUsedAt: undefined,
+    },
+  ];
+
+  for (const seed of demoCredentialSeeds) {
+    const { name, providerIcon } = resolveAaguid(seed.aaguid, 'Unknown passkey provider');
+    credentials.set(seed.id, { ...seed, name, providerIcon });
+  }
+}
+
+seedDemoData();
+
+export function findUserById(userId: string): StoredUser | undefined {
+  return users.get(userId);
+}
+
+export function createUser(user: StoredUser): StoredUser {
+  users.set(user.id, user);
+  return user;
+}
+
+export function updateUser(
+  userId: string,
+  updates: { name?: string; displayName?: string },
+): StoredUser | undefined {
+  const user = users.get(userId);
+  if (!user) return undefined;
+  const updated: StoredUser = {
+    ...user,
+    ...(updates.name !== undefined ? { name: updates.name } : {}),
+    ...(updates.displayName !== undefined ? { displayName: updates.displayName } : {}),
+  };
+  users.set(userId, updated);
+  return updated;
+}
+
+export function findCredentialsByUserId(userId: string): StoredPasskeyCredential[] {
+  return [...credentials.values()].filter((credential) => credential.passkeyUserId === userId);
+}
+
+export function findCredentialById(credentialId: string): StoredPasskeyCredential | undefined {
+  return credentials.get(credentialId);
+}
+
+export function saveCredential(credential: StoredPasskeyCredential): StoredPasskeyCredential {
+  credentials.set(credential.id, credential);
+  return credential;
+}
+
+export function deleteCredential(credentialId: string): void {
+  credentials.delete(credentialId);
+}
