+export interface AccountDetails {
+  id: string;
+  /** Base64URL-encoded user handle, as required by the Signal API. */
+  userId: string;
+  username: string;
+  displayName: string;
+  rpId: string;
+}
+
+function endpoint(path: string): string {
+  return `${import.meta.env.BASE_URL}api/${path}`;
+}
+
+const JSON_HEADERS = { 'Content-Type': 'application/json' };
+
+export function accountFetch(): Promise<Response> {
+  return fetch(endpoint('user'));
+}
+
+export function renameUserFetch(body: { name: string; displayName: string }): Promise<Response> {
+  return fetch(endpoint('user'), {
+    method: 'PUT',
+    headers: JSON_HEADERS,
+    body: JSON.stringify(body),
+  });
+}
+
+export function listFetch(): Promise<Response> {
+  return fetch(endpoint('credentials'));
+}
+
+export function renameFetch(credentialId: string, name: string): Promise<Response> {
+  return fetch(endpoint(`credential/${encodeURIComponent(credentialId)}`), {
+    method: 'PUT',
+    headers: JSON_HEADERS,
+    body: JSON.stringify({ name }),
+  });
+}
+
+export function deleteFetch(credentialId: string): Promise<Response> {
+  return fetch(endpoint(`credential/${encodeURIComponent(credentialId)}`), {
+    method: 'DELETE',
+  });
+}
+
+export function registrationOptionsFetch(
+  attachment?: 'platform' | 'cross-platform',
+): Promise<Response> {
+  return fetch(endpoint('passkey/registration-options'), {
+    method: 'POST',
+    headers: JSON_HEADERS,
+    // Omitting the attachment lets the user pick a roaming security key.
+    body: JSON.stringify(attachment ? { attachment } : {}),
+  });
+}
+
+export function registerFetch(credential: unknown): Promise<Response> {
+  return fetch(endpoint('passkey/register'), {
+    method: 'POST',
+    headers: JSON_HEADERS,
+    body: JSON.stringify(credential),
+  });
+}
diff --git a/src/scripts/passkeys/manager.ts b/src/scripts/passkeys/manager.ts
new file mode 100644
index 0000000..8867ee8
--- /dev/null
+++ b/src/scripts/passkeys/manager.ts
@@ -0,0 +1,438 @@
+import 'webauthn-polyfills';
+
+import { resolveAaguid } from '../../lib/passkeys/aaguid';
+import type { PublicCredential } from '../../lib/passkeys/serialize';
+import {
+  accountFetch,
+  deleteFetch,
+  listFetch,
+  registerFetch,
+  registrationOptionsFetch,
+  renameFetch,
+  renameUserFetch,
+  type AccountDetails,
+} from './api';
+
+interface ManagerElements {
+  root: HTMLElement;
+  list: HTMLElement;
+  emptyState: HTMLElement;
+  status: HTMLElement;
+  rowTemplate: HTMLTemplateElement;
+  createButton: HTMLButtonElement;
+  securityKeyButton: HTMLButtonElement;
+  unsupportedNotice: HTMLElement;
+  accountName: HTMLElement;
+  accountDisplayName: HTMLElement;
+  accountEditButton: HTMLButtonElement;
+  accountDialog: HTMLDialogElement;
+  accountForm: HTMLFormElement;
+  accountNameInput: HTMLInputElement;
+  accountDisplayNameInput: HTMLInputElement;
+  renameDialog: HTMLDialogElement;
+  renameForm: HTMLFormElement;
+  renameInput: HTMLInputElement;
+}
+
+let elements: ManagerElements | null = null;
+let account: AccountDetails | null = null;
+let credentials: PublicCredential[] = [];
+let renameTargetId: string | null = null;
+
+const dateFormatter = new Intl.DateTimeFormat(undefined, {
+  year: 'numeric',
+  month: 'short',
+  day: 'numeric',
+});
+
+/** Turns the database-persisted raw epoch timestamp into a human-readable date. */
+function formatTimestamp(epochMilliseconds: number | undefined): string | null {
+  if (!epochMilliseconds || Number.isNaN(epochMilliseconds)) return null;
+  return dateFormatter.format(new Date(epochMilliseconds));
+}
+
+function collectElements(): ManagerElements | null {
+  const root = document.querySelector<HTMLElement>('#passkey-manager');
+  if (!root) return null;
+
+  const query = <T extends HTMLElement>(selector: string): T | null =>
+    root.querySelector<T>(selector);
+
+  const list = query('#passkey-list');
+  const emptyState = query('#passkey-empty');
+  const status = query('#passkey-status');
+  const rowTemplate = query<HTMLTemplateElement>('#passkey-row-template');
+  const createButton = query<HTMLButtonElement>('#create-passkey-button');
+  const securityKeyButton = query<HTMLButtonElement>('#create-security-key-button');
+  const unsupportedNotice = query('#passkey-unsupported');
+  const accountName = query('#account-username');
+  const accountDisplayName = query('#account-display-name');
+  const accountEditButton = query<HTMLButtonElement>('#account-edit-button');
+  const accountDialog = query<HTMLDialogElement>('#account-dialog');
+  const accountForm = query<HTMLFormElement>('#account-form');
+  const accountNameInput = query<HTMLInputElement>('#account-name-input');
+  const accountDisplayNameInput = query<HTMLInputElement>('#account-display-name-input');
+  const renameDialog = query<HTMLDialogElement>('#rename-dialog');
+  const renameForm = query<HTMLFormElement>('#rename-form');
+  const renameInput = query<HTMLInputElement>('#rename-input');
+
+  if (
+    !list ||
+    !emptyState ||
+    !status ||
+    !rowTemplate ||
+    !createButton ||
+    !securityKeyButton ||
+    !unsupportedNotice ||
+    !accountName ||
+    !accountDisplayName ||
+    !accountEditButton ||
+    !accountDialog ||
+    !accountForm ||
+    !accountNameInput ||
+    !accountDisplayNameInput ||
+    !renameDialog ||
+    !renameForm ||
+    !renameInput
+  ) {
+    return null;
+  }
+
+  return {
+    root,
+    list,
+    emptyState,
+    status,
+    rowTemplate,
+    createButton,
+    securityKeyButton,
+    unsupportedNotice,
+    accountName,
+    accountDisplayName,
+    accountEditButton,
+    accountDialog,
+    accountForm,
+    accountNameInput,
+    accountDisplayNameInput,
+    renameDialog,
+    renameForm,
+    renameInput,
+  };
+}
+
+function setStatus(message: string, tone: 'info' | 'error' = 'info'): void {
+  if (!elements) return;
+  elements.status.textContent = message;
+  elements.status.hidden = !message;
+  elements.status.dataset.tone = tone;
+}
+
+function renderAccount(): void {
+  if (!elements || !account) return;
+  elements.accountName.textContent = account.username;
+  elements.accountDisplayName.textContent = account.displayName;
+}
+
+function createRow(credential: PublicCredential): DocumentFragment {
+  const el = elements!;
+  const fragment = el.rowTemplate.content.cloneNode(true) as DocumentFragment;
+  const row = fragment.querySelector<HTMLElement>('[data-passkey-row]')!;
+  row.dataset.credentialId = credential.id;
+
+  // Resolve the AAGUID against the local registry, keeping any custom name.
+  const provider = resolveAaguid(credential.aaguid);
+  const providerIcon = credential.providerIcon ?? provider.providerIcon;
+  const name = credential.name || provider.name;
+
+  const icon = fragment.querySelector<HTMLImageElement>('[data-provider-icon]')!;
+  const iconFallback = fragment.querySelector<HTMLElement>('[data-provider-icon-fallback]')!;
+  if (providerIcon) {
+    icon.src = providerIcon;
+    icon.alt = provider.name;
+    icon.hidden = false;
+    iconFallback.hidden = true;
+  } else {
+    icon.hidden = true;
+    iconFallback.hidden = false;
+  }
+
+  fragment.querySelector('[data-provider-name]')!.textContent = name;
+  // The provider model is only worth showing once the user has renamed the passkey.
+  fragment.querySelector<HTMLElement>('[data-provider-model-wrapper]')!.hidden =
+    name === provider.name;
+  fragment.querySelector('[data-provider-model]')!.textContent = provider.name;
+
+  const registeredAt = formatTimestamp(credential.registeredAt);
+  fragment.querySelector('[data-registered-at]')!.textContent = registeredAt
+    ? `Added ${registeredAt}`
+    : 'Added recently';
+
+  const lastUsedAt = formatTimestamp(credential.lastUsedAt);
+  fragment.querySelector('[data-last-used-at]')!.textContent = lastUsedAt
+    ? `Last used ${lastUsedAt}`
+    : 'Never used';
+
+  for (const button of fragment.querySelectorAll<HTMLButtonElement>('[data-action]')) {
+    button.dataset.credentialId = credential.id;
+    button.setAttribute('aria-label', `${button.dataset.action === 'delete' ? 'Delete' : 'Rename'} ${name}`);
+  }
+
+  return fragment;
+}
+
+function renderUI(list: PublicCredential[]): void {
+  if (!elements) return;
+  credentials = list;
+  elements.list.replaceChildren();
+  elements.emptyState.hidden = list.length > 0;
+  for (const credential of list) {
+    elements.list.append(createRow(credential));
+  }
+}
+
+/**
+ * Tells password managers exactly which credential IDs the server still accepts
+ * so stale entries disappear from the user's synced vault.
+ */
+async function syncAcceptedCredentials(currentCredentialsList: PublicCredential[]): Promise<void> {
+  if (!account) return;
+  if (typeof PublicKeyCredential === 'undefined') return;
+  if (!('signalAllAcceptedCredentials' in PublicKeyCredential)) return;
+
+  try {
+    // Base64URL-encoded credential ID strings.
+    const credentialIds = currentCredentialsList.map((credential) => credential.id);
+
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: account.rpId,
+      userId: account.userId, // Base64URL-encoded user ID string.
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (error) {
+    console.error('SignalAllAcceptedCredentials sync failure:', error);
+  }
+}
+
+async function loadCredentials(): Promise<PublicCredential[]> {
+  const response = await listFetch();
+  if (!response.ok) {
+    setStatus('Could not load your passkeys.', 'error');
+    return [];
+  }
+  const list = (await response.json()) as PublicCredential[];
+  renderUI(list);
+  return list;
+}
+
+async function performDelete(credentialId: string): Promise<void> {
+  const response = await deleteFetch(credentialId);
+  if (!response.ok) {
+    setStatus('Could not delete that passkey.', 'error');
+    return;
+  }
+
+  const updatedResponse = await listFetch();
+  const updatedList = (await updatedResponse.json()) as PublicCredential[];
+
+  renderUI(updatedList);
+  // Sync after deletion so password managers drop the removed credential.
+  await syncAcceptedCredentials(updatedList);
+  setStatus('Passkey deleted.');
+}
+
+async function performCredentialRename(credentialId: string, name: string): Promise<void> {
+  const response = await renameFetch(credentialId, name);
+  if (!response.ok) {
+    setStatus('Could not rename that passkey.', 'error');
+    return;
+  }
+  await loadCredentials();
+  setStatus('Passkey renamed.');
+}
+
+async function performRename(updatedName: string, updatedDisplayName: string): Promise<void> {
+  if (!account) return;
+  const { rpId, userId } = account;
+
+  const response = await renameUserFetch({ name: updatedName, displayName: updatedDisplayName });
+  if (!response.ok) {
+    setStatus('Could not update your account details.', 'error');
+    return;
+  }
+
+  account = (await response.json()) as AccountDetails;
+  renderAccount();
+  setStatus('Account details updated.');
+
+  if (typeof PublicKeyCredential === 'undefined') return;
+  if (!('signalCurrentUserDetails' in PublicKeyCredential)) return;
+
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId,
+      userId, // Base64URL-encoded user ID.
+      name: updatedName, // Updated username.
+      displayName: updatedDisplayName, // Updated display name.
+    });
+  } catch (error) {
+    console.error('SignalCurrentUserDetails sync failure:', error);
+  }
+}
+
+async function createPasskey(attachment?: 'platform'): Promise<void> {
+  const el = elements;
+  if (!el) return;
+
+  el.createButton.disabled = true;
+  el.securityKeyButton.disabled = true;
+  setStatus('Follow your browser prompts to finish creating the passkey…');
+
+  try {
+    const optionsResponse = await registrationOptionsFetch(attachment);
+    if (!optionsResponse.ok) throw new Error('Could not start registration.');
+    const optionsJSON = (await optionsResponse.json()) as PublicKeyCredentialCreationOptionsJSON;
+
+    const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+    const credential = (await navigator.credentials.create({ publicKey })) as PublicKeyCredential | null;
+    if (!credential) throw new Error('Registration was cancelled.');
+
+    const registerResponse = await registerFetch(credential.toJSON());
+    if (!registerResponse.ok) {
+      const body = (await registerResponse.json().catch(() => ({}))) as { error?: string };
+      throw new Error(body.error || 'Could not save the new passkey.');
+    }
+
+    const updatedList = await loadCredentials();
+    await syncAcceptedCredentials(updatedList);
+    setStatus('Passkey created.');
+  } catch (error) {
+    if (error instanceof DOMException && error.name === 'NotAllowedError') {
+      setStatus('Passkey creation was cancelled.', 'error');
+    } else {
+      setStatus(error instanceof Error ? error.message : 'Could not create a passkey.', 'error');
+    }
+  } finally {
+    el.createButton.disabled = false;
+    el.securityKeyButton.disabled = false;
+  }
+}
+
+/**
+ * Feature-detects platform passkey support before offering registration.
+ * `webauthn-polyfills` backfills getClientCapabilities, so the presence of
+ * PublicKeyCredential is enough for the method to exist.
+ */
+async function hasPasskeySupport(): Promise<boolean> {
+  if (typeof window === 'undefined' || !('PublicKeyCredential' in window)) return false;
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(
+      capabilities.passkeyPlatformAuthenticator ?? capabilities.userVerifyingPlatformAuthenticator,
+    );
+  } catch (error) {
+    console.error('getClientCapabilities failure:', error);
+    return false;
+  }
+}
+
+async function applyCapabilityGating(): Promise<void> {
+  const el = elements;
+  if (!el) return;
+
+  const supported = await hasPasskeySupport();
+  el.createButton.hidden = !supported;
+  el.securityKeyButton.hidden = !supported;
+  el.unsupportedNotice.hidden = supported;
+}
+
+function openRenameDialog(credentialId: string): void {
+  const el = elements;
+  if (!el) return;
+  const credential = credentials.find((item) => item.id === credentialId);
+  renameTargetId = credentialId;
+  el.renameInput.value = credential?.name ?? '';
+  el.renameDialog.showModal();
+  el.renameInput.focus();
+}
+
+function openAccountDialog(): void {
+  const el = elements;
+  if (!el || !account) return;
+  el.accountNameInput.value = account.username;
+  el.accountDisplayNameInput.value = account.displayName;
+  el.accountDialog.showModal();
+}
+
+function bindEvents(el: ManagerElements): void {
+  el.list.addEventListener('click', (event) => {
+    const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-action]');
+    const credentialId = button?.dataset.credentialId;
+    if (!button || !credentialId) return;
+
+    if (button.dataset.action === 'rename') {
+      openRenameDialog(credentialId);
+    } else if (button.dataset.action === 'delete') {
+      void performDelete(credentialId);
+    }
+  });
+
+  el.renameForm.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const name = el.renameInput.value.trim();
+    const credentialId = renameTargetId;
+    el.renameDialog.close();
+    renameTargetId = null;
+    if (name && credentialId) void performCredentialRename(credentialId, name);
+  });
+
+  el.accountEditButton.addEventListener('click', () => openAccountDialog());
+
+  el.accountForm.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const updatedName = el.accountNameInput.value.trim();
+    const updatedDisplayName = el.accountDisplayNameInput.value.trim();
+    el.accountDialog.close();
+    if (updatedName && updatedDisplayName) void performRename(updatedName, updatedDisplayName);
+  });
+
+  for (const cancel of el.root.querySelectorAll<HTMLButtonElement>('[data-dialog-cancel]')) {
+    cancel.addEventListener('click', () => cancel.closest('dialog')?.close());
+  }
+
+  el.createButton.addEventListener('click', () => void createPasskey('platform'));
+  el.securityKeyButton.addEventListener('click', () => void createPasskey());
+}
+
+async function loadManagementPanel(): Promise<void> {
+  const accountResponse = await accountFetch();
+  if (!accountResponse.ok) {
+    setStatus('Sign in to manage your passkeys.', 'error');
+    return;
+  }
+  account = (await accountResponse.json()) as AccountDetails;
+  renderAccount();
+
+  const response = await listFetch();
+  const list = (await response.json()) as PublicCredential[];
+
+  renderUI(list);
+  // Sync on page load.
+  await syncAcceptedCredentials(list);
+}
+
+async function init(): Promise<void> {
+  elements = collectElements();
+  if (!elements) return;
+
+  bindEvents(elements);
+  await Promise.all([loadManagementPanel(), applyCapabilityGating()]);
+}
+
+document.addEventListener('DOMContentLoaded', () => {
+  void init();
+});
+
+// View transitions swap the DOM without a fresh DOMContentLoaded.
+document.addEventListener('astro:after-swap', () => {
+  void init();
+});
