@@ -0,0 +1,33 @@
+import type { APIContext } from 'astro';
+import { DEMO_USER_ID, findUserById } from './db';
+import type { StoredUser } from './types';
+
+type Session = APIContext['session'];
+
+/**
+ * Resolves the signed-in account for passkey management. This sample app has no
+ * password backend of its own, so the session is bootstrapped with the demo
+ * account the first time it is touched.
+ */
+export async function getSignedInUser(session: Session): Promise<StoredUser | null> {
+  if (!session) return null;
+
+  let userId = await session.get<string>('userId');
+  if (!userId) {
+    userId = DEMO_USER_ID;
+    await session.set('userId', userId);
+  }
+
+  return findUserById(userId) ?? null;
+}
+
+export function unauthorized(): Response {
+  return jsonResponse({ error: 'Not signed in.' }, 401);
+}
+
+export function jsonResponse(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
