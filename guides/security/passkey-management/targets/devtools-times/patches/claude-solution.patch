@@ -0,0 +1,46 @@
+import type { APIRoute } from 'astro';
+import { randomBase64Url } from '../../../lib/passkeys/base64url';
+import { getRpId, RP_NAME } from '../../../lib/passkeys/config';
+import { findCredentialsByUserId, saveChallenge } from '../../../lib/passkeys/db';
+import { getSignedInUser, jsonResponse, unauthorized } from '../../../lib/passkeys/session';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  const { attachment } = (await request.json().catch(() => ({}))) as {
+    attachment?: 'platform' | 'cross-platform';
+  };
+
+  const challenge = randomBase64Url();
+  saveChallenge({ challenge, passkeyUserId: user.passkeyUserId, createdAt: Date.now() });
+
+  return jsonResponse({
+    rp: { id: getRpId(url), name: RP_NAME },
+    user: {
+      id: user.passkeyUserId,
+      name: user.username,
+      displayName: user.displayName,
+    },
+    challenge,
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },
+      { type: 'public-key', alg: -257 },
+    ],
+    timeout: 60_000,
+    attestation: 'none',
+    excludeCredentials: findCredentialsByUserId(user.passkeyUserId).map((credential) => ({
+      id: credential.id,
+      type: 'public-key',
+      transports: credential.transports,
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      // Omitted entirely for security keys so any authenticator can respond.
+      ...(attachment === 'platform' ? { authenticatorAttachment: 'platform' } : {}),
+    },
+    extensions: { credProps: true },
+  });
+};
