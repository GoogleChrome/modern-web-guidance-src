+import type { APIRoute } from 'astro';
+import { deleteCredential, findCredentialById, saveCredential } from '../../../lib/passkeys/db';
+import { toPublicCredential } from '../../../lib/passkeys/serialize';
+import { getSignedInUser, jsonResponse, unauthorized } from '../../../lib/passkeys/session';
+
+const NOT_FOUND = { error: 'Credential not found.' };
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  const { id } = params;
+  const { name } = (await request.json()) as { name?: unknown };
+  if (typeof name !== 'string' || !name.trim()) {
+    return jsonResponse({ error: 'A credential name is required.' }, 400);
+  }
+
+  const credential = id ? findCredentialById(id) : undefined;
+  if (!credential || credential.passkeyUserId !== user.passkeyUserId) {
+    return jsonResponse(NOT_FOUND, 404);
+  }
+
+  credential.name = name.trim().slice(0, 64);
+  saveCredential(credential);
+  return jsonResponse(toPublicCredential(credential));
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  const { id } = params;
+  const credential = id ? findCredentialById(id) : undefined;
+  if (!credential || credential.passkeyUserId !== user.passkeyUserId) {
+    return jsonResponse(NOT_FOUND, 404);
+  }
+
+  deleteCredential(credential.id);
+  return jsonResponse({ success: true });
+};
