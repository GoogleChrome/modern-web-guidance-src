+import type { APIRoute } from 'astro';
+import { getRpId } from '../../lib/passkeys/config';
+import { saveUser } from '../../lib/passkeys/db';
+import { getSignedInUser, jsonResponse, unauthorized } from '../../lib/passkeys/session';
+import type { StoredUser } from '../../lib/passkeys/types';
+
+function serialize(user: StoredUser, url: URL) {
+  return {
+    id: user.id,
+    // Base64URL-encoded user handle, ready to hand to the Signal API.
+    userId: user.passkeyUserId,
+    username: user.username,
+    displayName: user.displayName,
+    rpId: getRpId(url),
+  };
+}
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+  return jsonResponse(serialize(user, url));
+};
+
+export const PUT: APIRoute = async ({ request, session, url }) => {
+  const user = await getSignedInUser(session);
+  if (!user) return unauthorized();
+
+  const { name, displayName } = (await request.json()) as {
+    name?: unknown;
+    displayName?: unknown;
+  };
+
+  if (typeof name === 'string' && name.trim()) {
+    user.username = name.trim().slice(0, 64);
+  }
+  if (typeof displayName === 'string' && displayName.trim()) {
+    user.displayName = displayName.trim().slice(0, 64);
+  }
+
+  saveUser(user);
+  return jsonResponse(serialize(user, url));
+};
