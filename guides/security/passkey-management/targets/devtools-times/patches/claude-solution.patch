+/** Best-effort, dependency-free device label derived from a User-Agent string. */
+export function deviceNameFromUserAgent(userAgent: string | null): string {
+  if (!userAgent) return 'Unknown passkey provider';
+
+  if (/iPhone/.test(userAgent)) return 'iPhone';
+  if (/iPad/.test(userAgent)) return 'iPad';
+  if (/Macintosh/.test(userAgent)) return 'Mac';
+  if (/Android/.test(userAgent)) return 'Android device';
+  if (/Windows/.test(userAgent)) return 'Windows device';
+  if (/Linux/.test(userAgent)) return 'Linux device';
+
+  return 'Unknown passkey provider';
+}
