+import aaguids from './aaguids.json';
+// Local subset of passkeydeveloper/passkey-authenticator-aaguids combined_aaguid.json.
+// AAGUIDs are display hints, never a basis for security decisions.
+const registry: Record<string, { name: string; icon_light?: string; icon_dark?: string }> = aaguids;
+export const fallbackIcon = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40"><rect width="40" height="40" rx="8" fill="#e5e7eb"/><circle cx="15" cy="18" r="5" fill="none" stroke="#374151" stroke-width="2"/><path d="M20 18h12m-4 0v5m-4-5v3" stroke="#374151" stroke-width="2"/></svg>')}`;
+export function passkeyProvider(aaguid: string) {
+  const key = aaguid.toLowerCase();
+  if (key === '00000000-0000-0000-0000-000000000000') return { name: 'Unknown passkey provider', icon: undefined };
+  const provider = registry[key];
+  return {
+    name: provider?.name || 'Unknown passkey provider',
+    icon: provider?.icon_light,
+  };
+}
