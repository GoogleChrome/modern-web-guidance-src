diff --git a/src/lib/accounts.ts b/src/lib/accounts.ts
new file mode 100644
index 0000000..cbe2e9f
--- /dev/null
+++ b/src/lib/accounts.ts
@@ -0,0 +1,52 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { randomBytes, scryptSync, timingSafeEqual, createHash } from 'node:crypto';
+import type { AstroCookies } from 'astro';
+import type { Account, StoredPasskeyCredential } from './passkey-types';
+
+// Use a persistent volume for this path in production. SQLite serializes writes.
+const path = resolve(process.env.ACCOUNT_DB_PATH || '.data/accounts.sqlite');
+mkdirSync(dirname(path), { recursive: true });
+export const db = new DatabaseSync(path);
+db.exec(`PRAGMA journal_mode=WAL;
+  PRAGMA foreign_keys=ON;
+  CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, name TEXT UNIQUE NOT NULL COLLATE NOCASE, displayName TEXT NOT NULL, password TEXT NOT NULL);
+  CREATE TABLE IF NOT EXISTS sessions (token TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES users(id), expires INTEGER NOT NULL);
+  CREATE TABLE IF NOT EXISTS credentials (id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES users(id), rpId TEXT NOT NULL, name TEXT NOT NULL, aaguid TEXT NOT NULL, registeredAt INTEGER NOT NULL, lastUsedAt INTEGER, publicKey TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL);
+  CREATE TABLE IF NOT EXISTS challenges (token TEXT PRIMARY KEY, userId TEXT NOT NULL, challenge TEXT NOT NULL, origin TEXT NOT NULL, kind TEXT NOT NULL, expires INTEGER NOT NULL);`);
+const cookieName = 'times_account';
+const cookiePath = import.meta.env.BASE_URL;
+const hash = (value: string) => createHash('sha256').update(value).digest('hex');
+export function passwordHash(password: string) {
+  const salt = randomBytes(16).toString('hex');
+  return `${salt}:${scryptSync(password, salt, 64).toString('hex')}`;
+}
+export function passwordMatches(password: string, stored: string) {
+  const [salt, value] = stored.split(':');
+  return timingSafeEqual(scryptSync(password, salt, 64), Buffer.from(value, 'hex'));
+}
+export function currentUser(cookies: AstroCookies): Account | undefined {
+  const token = cookies.get(cookieName)?.value;
+  if (!token) return;
+  return db.prepare('SELECT users.id, users.name, users.displayName FROM users JOIN sessions ON users.id = sessions.userId WHERE sessions.token = ? AND sessions.expires > ?').get(hash(token), Date.now()) as Account | undefined;
+}
+export function signIn(cookies: AstroCookies, userId: string, secure: boolean) {
+  const token = randomBytes(32).toString('base64url');
+  db.prepare('DELETE FROM sessions WHERE expires <= ?').run(Date.now());
+  db.prepare('INSERT INTO sessions VALUES (?, ?, ?)').run(hash(token), userId, Date.now() + 7 * 86400000);
+  cookies.set(cookieName, token, { path: cookiePath, httpOnly: true, secure, sameSite: 'lax', maxAge: 7 * 86400 });
+}
+export function listCredentials(userId: string, rpId: string): StoredPasskeyCredential[] {
+  return db.prepare('SELECT id, userId AS passkeyUserId, rpId, name, aaguid, registeredAt, lastUsedAt FROM credentials WHERE userId = ? AND rpId = ? ORDER BY registeredAt DESC').all(userId, rpId) as unknown as StoredPasskeyCredential[];
+}
+export function relyingParty(url: URL) {
+  const origin = process.env.WEBAUTHN_ORIGIN || url.origin;
+  return { origin, rpId: new URL(origin).hostname };
+}
+export function json(data: unknown, status = 200) {
+  return new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+}
+export function validName(value: unknown): value is string {
+  return typeof value === 'string' && value.trim().length > 0 && value.trim().length <= 100;
+}
