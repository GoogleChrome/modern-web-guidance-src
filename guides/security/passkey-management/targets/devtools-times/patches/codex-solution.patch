diff --git a/src/components/PasskeySettings.tsx b/src/components/PasskeySettings.tsx
new file mode 100644
index 0000000..ec8677f
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,216 @@
+import { useEffect, useState } from 'react';
+import type { FormEvent } from 'react';
+import { passkeyProvider } from '../lib/passkeys';
+import type { Account, StoredPasskeyCredential } from '../lib/passkeys';
+
+type Profile = Account & { rpId: string };
+const api = `${import.meta.env.BASE_URL}api/`;
+const button = 'rounded border border-gray-300 px-4 py-2 text-sm font-semibold hover:bg-gray-100 disabled:opacity-50';
+const input = 'block w-full rounded border border-gray-300 px-3 py-2 mt-1';
+
+async function request<T>(path: string, method = 'GET', body?: unknown): Promise<T> {
+  const response = await fetch(`${api}${path}`, {
+    method, credentials: 'same-origin', cache: 'no-store',
+    headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || 'Unable to complete this request. Please try again.');
+  return data as T;
+}
+
+function date(timestamp: number) {
+  return new Date(timestamp).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+}
+
+export default function PasskeySettings() {
+  const [profile, setProfile] = useState<Profile | null>(null);
+  const [credentials, setCredentials] = useState<StoredPasskeyCredential[]>([]);
+  const [name, setName] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [syncWarning, setSyncWarning] = useState('');
+  const [editing, setEditing] = useState<string | null>(null);
+  const [nickname, setNickname] = useState('');
+  const [deleting, setDeleting] = useState<string | null>(null);
+
+  async function syncAcceptedCredentials(user: Profile, list: StoredPasskeyCredential[]) {
+    if (typeof PublicKeyCredential === 'undefined' || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+    try {
+      await PublicKeyCredential.signalAllAcceptedCredentials({
+        rpId: user.rpId, userId: user.id,
+        allAcceptedCredentialIds: list.map(credential => credential.id),
+      });
+    } catch {
+      setSyncWarning('Your passkeys are saved on this account, but your password manager could not be synchronized. Reload to try again.');
+    }
+  }
+
+  useEffect(() => {
+    let active = true;
+    async function capabilities() {
+      try {
+        // Install JSON serialization and capability fallbacks in the browser only.
+        await import('webauthn-polyfills');
+        const capabilities = typeof PublicKeyCredential !== 'undefined'
+          ? await PublicKeyCredential.getClientCapabilities() : null;
+        if (active) setSupported(capabilities?.userVerifyingPlatformAuthenticator === true);
+      } catch {
+        if (active) setSupported(false);
+      }
+    }
+    async function load() {
+      try {
+        const [user, list] = await Promise.all([
+          request<Profile>('user'), request<StoredPasskeyCredential[]>('credentials'),
+        ]);
+        if (!active) return;
+        setProfile(user);
+        setName(user.name);
+        setDisplayName(user.displayName);
+        setCredentials(list);
+        await syncAcceptedCredentials(user, list);
+      } catch (error) {
+        if (active) setError(error instanceof Error ? error.message : 'Unable to load passkeys.');
+      } finally {
+        if (active) setLoading(false);
+      }
+    }
+    void capabilities();
+    void load();
+    return () => { active = false; };
+  }, []);
+
+  async function perform(action: () => Promise<void>) {
+    setBusy(true);
+    setError('');
+    setNotice('');
+    setSyncWarning('');
+    try { await action(); }
+    catch (error) { setError(error instanceof Error ? error.message : 'Unable to save changes. Please try again.'); }
+    finally { setBusy(false); }
+  }
+
+  async function handleDelete(id: string) {
+    if (!profile) return;
+    await perform(async () => {
+      await request(`credential/${encodeURIComponent(id)}`, 'DELETE');
+      // Reflect the successful deletion even if the subsequent list request fails.
+      setCredentials(current => current.filter(credential => credential.id !== id));
+      setDeleting(null);
+      const remaining = await request<StoredPasskeyCredential[]>('credentials');
+      setCredentials(remaining);
+      await syncAcceptedCredentials(profile, remaining);
+      setNotice('Passkey deleted.');
+    });
+  }
+
+  async function handleProfileRename(event: FormEvent) {
+    event.preventDefault();
+    await perform(async () => {
+      const updated = await request<Profile>('user', 'PUT', { name, displayName });
+      setProfile(updated);
+      setName(updated.name);
+      setDisplayName(updated.displayName);
+      if (typeof PublicKeyCredential !== 'undefined' && PublicKeyCredential.signalCurrentUserDetails) {
+        try {
+          await PublicKeyCredential.signalCurrentUserDetails({
+            rpId: updated.rpId, userId: updated.id, name: updated.name, displayName: updated.displayName,
+          });
+        } catch {
+          setSyncWarning('Your profile was saved, but your password manager could not be updated. Save your profile again to retry.');
+        }
+      }
+      setNotice('Account details saved.');
+    });
+  }
+
+  async function handleCredentialRename(event: FormEvent, id: string) {
+    event.preventDefault();
+    await perform(async () => {
+      const updated = await request<StoredPasskeyCredential>(`credential/${encodeURIComponent(id)}`, 'PUT', { name: nickname });
+      setCredentials(current => current.map(credential => credential.id === id ? updated : credential));
+      setEditing(null);
+      setNotice('Passkey renamed.');
+      // A nickname is a local label, not a change to the WebAuthn user identity.
+    });
+  }
+
+  async function handleCreate() {
+    if (!profile || !supported) return;
+    await perform(async () => {
+      const options = await request<PublicKeyCredentialCreationOptionsJSON>('passkeys/options', 'POST', {});
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      const credential = await navigator.credentials.create({ publicKey }) as PublicKeyCredential | null;
+      if (!credential) throw new Error('Passkey creation was cancelled. You can try again.');
+      await request('passkeys/register', 'POST', credential.toJSON());
+      const updated = await request<StoredPasskeyCredential[]>('credentials');
+      setCredentials(updated);
+      await syncAcceptedCredentials(profile, updated);
+      setNotice('Passkey created.');
+    });
+  }
+
+  return <div className="space-y-8" aria-busy={busy || loading}>
+    {error && <p role="alert" className="rounded bg-red-50 p-4 text-red-800">{error}</p>}
+    {notice && <p role="status" className="rounded bg-green-50 p-4 text-green-800">{notice}</p>}
+    {syncWarning && <p role="status" className="rounded bg-amber-50 p-4 text-amber-900">{syncWarning}</p>}
+    {loading ? <p role="status">Loading your passkeys…</p> : !profile ? <div className="space-y-3">
+      <a className={button} href={`${import.meta.env.BASE_URL}signin`}>Sign in</a>
+      <button className={`${button} ml-3`} onClick={() => window.location.reload()}>Retry</button>
+    </div> : <>
+      <section aria-labelledby="saved-passkeys" className="rounded-lg border border-gray-200 p-5">
+        <div className="flex flex-wrap items-center justify-between gap-4 mb-4">
+          <h2 id="saved-passkeys" className="text-xl font-bold">Saved passkeys</h2>
+          {supported && <button className={button} disabled={busy} onClick={handleCreate}>Create passkey</button>}
+        </div>
+        {supported === false && <p className="mb-4 text-sm text-gray-600">Passkey creation is unavailable in this browser or on this device. Use a supported device, or enable standard multi-factor authentication with your sign-in provider.</p>}
+        {credentials.length === 0 ? <p className="py-6 text-gray-600">No passkeys found. Add a passkey to keep a secure credential for your account.</p> :
+          <ul className="divide-y divide-gray-200" aria-label="Registered passkeys">
+            {credentials.map(credential => {
+              const provider = passkeyProvider(credential.aaguid);
+              return <li key={credential.id} className="py-5 space-y-3">
+                <div className="flex items-start gap-3">
+                  {provider.icon_light ? <img src={provider.icon_light} alt={`${provider.name} icon`} width={36} height={36} className="h-9 w-9 object-contain" /> :
+                    <span aria-label="Unknown provider" className="rounded bg-gray-100 p-2">🔑</span>}
+                  <div className="min-w-0 flex-1">
+                    <h3 className="font-semibold break-words">{credential.name || provider.name}</h3>
+                    <p className="text-sm text-gray-600">{provider.name}</p>
+                    <p className="text-sm text-gray-600">Registered: <time dateTime={new Date(credential.registeredAt).toISOString()}>{date(credential.registeredAt)}</time></p>
+                    <p className="text-sm text-gray-600">Last used: {credential.lastUsedAt == null ? 'Never used' : <time dateTime={new Date(credential.lastUsedAt).toISOString()}>{date(credential.lastUsedAt)}</time>}</p>
+                  </div>
+                </div>
+                <div className="flex gap-2">
+                  <button className={button} disabled={busy} aria-label={`Rename ${credential.name || provider.name}`} onClick={() => { setEditing(credential.id); setNickname(credential.name || provider.name); setDeleting(null); }}>Rename</button>
+                  <button className={button} disabled={busy} aria-label={`Delete ${credential.name || provider.name}`} onClick={() => { setDeleting(credential.id); setEditing(null); }}>Delete</button>
+                </div>
+                {editing === credential.id && <form onSubmit={event => handleCredentialRename(event, credential.id)} className="space-y-3">
+                  <label className="block text-sm">Passkey name<input autoFocus className={input} required maxLength={100} value={nickname} onChange={event => setNickname(event.target.value)} /></label>
+                  <button className={button} disabled={busy || !nickname.trim()}>Save name</button>{' '}
+                  <button className={button} type="button" disabled={busy} onClick={() => setEditing(null)}>Cancel</button>
+                </form>}
+                {deleting === credential.id && <div className="rounded bg-gray-50 p-3 space-y-3">
+                  <p>Delete this passkey from your account? You can register another passkey later.</p>
+                  <button className={button} disabled={busy} onClick={() => handleDelete(credential.id)}>Confirm deletion</button>{' '}
+                  <button className={button} disabled={busy} onClick={() => setDeleting(null)}>Cancel</button>
+                </div>}
+              </li>;
+            })}
+          </ul>}
+      </section>
+      <section aria-labelledby="account-details" className="rounded-lg border border-gray-200 p-5">
+        <h2 id="account-details" className="text-xl font-bold mb-4">Account details</h2>
+        <p className="text-sm text-gray-600 mb-4">These details identify your account in your password manager. Your existing sign-in username remains unchanged.</p>
+        <form onSubmit={handleProfileRename} className="space-y-4">
+          <label className="block text-sm font-medium">Username<input className={input} autoComplete="username" required maxLength={100} value={name} onChange={event => setName(event.target.value)} /></label>
+          <label className="block text-sm font-medium">Display name<input className={input} autoComplete="name" required maxLength={100} value={displayName} onChange={event => setDisplayName(event.target.value)} /></label>
+          <button className={button} disabled={busy || !name.trim() || !displayName.trim()}>Save account details</button>
+        </form>
+      </section>
+    </>}
+  </div>;
+}
