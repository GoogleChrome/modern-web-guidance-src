+export interface StoredPasskeyCredential {
+  id: string;
+  passkeyUserId: string;
+  aaguid: string;
+  name: string | null;
+  registeredAt: number;
+  lastUsedAt: number | null;
+}
+
+export interface AccountProfile {
+  userId: string;
+  name: string;
+  displayName: string;
+}
+
+export const RP_ID = 'astro-news-pytrpecapa-uc.a.run.app';
+
+export const defaultProfile: AccountProfile = {
+  // "devtools-times-user", encoded as Base64URL for WebAuthn Signal API calls.
+  userId: 'ZGV2dG9vbHMtdGltZXMtdXNlcg',
+  name: 'reader@devtoolstimes.com',
+  displayName: 'DevTools Times Reader',
+};
+
+export const defaultCredentials: StoredPasskeyCredential[] = [
+  {
+    id: 't73mU8Fh_S7W6YVgQhJvBAXI6UQ',
+    passkeyUserId: defaultProfile.userId,
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+    name: null,
+    registeredAt: Date.UTC(2026, 4, 18, 14, 22),
+    lastUsedAt: Date.UTC(2026, 7, 17, 9, 41),
+  },
+  {
+    id: 'qiYhWIGcrP3gM7jhuN4U68F2gLk',
+    passkeyUserId: defaultProfile.userId,
+    aaguid: 'b5397666-4885-aa6b-cebf-e52262a439a2',
+    name: 'Work laptop',
+    registeredAt: Date.UTC(2026, 1, 3, 16, 5),
+    lastUsedAt: Date.UTC(2026, 7, 12, 18, 16),
+  },
+];
+
+export function isBase64Url(value: string): boolean {
+  return /^[A-Za-z0-9_-]+$/.test(value);
+}
+
+export function cleanCredentialName(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const name = value.trim();
+  return name.length > 0 && name.length <= 80 ? name : null;
+}
+
+export function jsonError(message: string, status: number): Response {
+  return Response.json({ error: message }, { status });
+}
diff --git a/src/pages/api/account-profile.ts b/src/pages/api/account-profile.ts
