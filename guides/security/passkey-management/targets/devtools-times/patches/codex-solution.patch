+import type { APIRoute } from 'astro';
+import { currentUser, db, json, validName } from '../../lib/accounts';
+export const PUT: APIRoute = async ({ request, cookies, url }) => {
+  if (request.headers.get('origin') !== url.origin || !request.headers.get('content-type')?.includes('application/json')) return json({ error: 'Invalid request.' }, 403);
+  const user = currentUser(cookies);
+  if (!user) return json({ error: 'Please sign in.' }, 401);
+  try {
+    const { name, displayName } = await request.json();
+    if (!validName(name) || !validName(displayName)) return json({ error: 'Both names must contain 1–100 characters.' }, 400);
+    const duplicate = db.prepare('SELECT id FROM users WHERE name = ? AND id != ?').get(name.trim(), user.id);
+    if (duplicate) return json({ error: 'That username is already taken.' }, 409);
+    db.prepare('UPDATE users SET name = ?, displayName = ? WHERE id = ?').run(name.trim(), displayName.trim(), user.id);
+    return json({ ...user, name: name.trim(), displayName: displayName.trim() });
+  } catch {
+    return json({ error: 'Unable to update your account. Please try again.' }, 400);
+  }
+};
