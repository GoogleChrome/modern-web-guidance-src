diff --git a/src/components/AccountSettings.tsx b/src/components/AccountSettings.tsx
new file mode 100644
index 0000000..3a4c586
--- /dev/null
+++ b/src/components/AccountSettings.tsx
@@ -0,0 +1,156 @@
+import { useEffect, useState, type FormEvent } from 'react';
+import type { Account, SettingsData, StoredPasskeyCredential } from '../lib/passkey-types';
+import { api, syncAccepted, syncUser } from '../lib/passkey-client';
+import { fallbackIcon, passkeyProvider } from '../lib/passkey-providers';
+
+const inputClass = 'w-full border border-gray-300 rounded-md px-3 py-2';
+const buttonClass = 'rounded-md bg-gray-900 text-white px-4 py-2 text-sm font-semibold disabled:opacity-50';
+const date = (epoch: number) => new Date(epoch).toLocaleDateString(undefined, { dateStyle: 'medium' });
+
+export default function AccountSettings() {
+  const [data, setData] = useState<SettingsData>();
+  const [loading, setLoading] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [syncWarning, setSyncWarning] = useState('');
+  const [canCreate, setCanCreate] = useState(false);
+  const [capabilitiesChecked, setCapabilitiesChecked] = useState(false);
+  const [name, setName] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [editing, setEditing] = useState<string>();
+  const [nickname, setNickname] = useState('');
+  const [deleting, setDeleting] = useState<string>();
+
+  async function sync(action: () => Promise<void>) {
+    setSyncWarning('');
+    try { await action(); }
+    catch { setSyncWarning('Your changes are saved. Your password manager could not be synchronized; reload this page to retry passkey synchronization.'); }
+  }
+
+  useEffect(() => {
+    let active = true;
+    async function load() {
+      try {
+        const settings = await api<SettingsData>('account/settings');
+        if (!active) return;
+        setData(settings); setName(settings.user.name); setDisplayName(settings.user.displayName);
+        await sync(() => syncAccepted(settings.rpId, settings.user.id, settings.credentials));
+      } catch (e) { if (active) setError(e instanceof Error ? e.message : 'Could not load settings.'); }
+      finally { if (active) setLoading(false); }
+    }
+    async function detect() {
+      try {
+        await import('webauthn-polyfills');
+        if (!window.PublicKeyCredential || !window.isSecureContext) return;
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (active) setCanCreate(capabilities.userVerifyingPlatformAuthenticator === true);
+      } catch { /* Keep registration hidden when capabilities cannot be established. */ }
+      finally { if (active) setCapabilitiesChecked(true); }
+    }
+    void load(); void detect();
+    return () => { active = false; };
+  }, []);
+
+  async function run(action: () => Promise<void>) {
+    setBusy(true); setError(''); setMessage('');
+    try { await action(); }
+    catch (e) { setError(e instanceof Error ? e.message : 'The request failed.'); }
+    finally { setBusy(false); }
+  }
+
+  async function updateProfile(event: FormEvent) {
+    event.preventDefault();
+    if (!data) return;
+    await run(async () => {
+      const user = await api<Account>('user', 'PUT', { name, displayName });
+      setData({ ...data, user }); setName(user.name); setDisplayName(user.displayName);
+      await sync(() => syncUser(data.rpId, user));
+      setMessage('Account details saved.');
+    });
+  }
+  async function rename(event: FormEvent, id: string) {
+    event.preventDefault();
+    if (!data) return;
+    await run(async () => {
+      const credential = await api<StoredPasskeyCredential>(`credential/${encodeURIComponent(id)}`, 'PUT', { name: nickname });
+      setData({ ...data, credentials: data.credentials.map(c => c.id === id ? credential : c) });
+      setEditing(undefined); setMessage('Passkey name saved.');
+    });
+  }
+  async function remove(id: string) {
+    if (!data) return;
+    await run(async () => {
+      const result = await api<{ credentials: StoredPasskeyCredential[] }>(`credential/${encodeURIComponent(id)}`, 'DELETE');
+      setData({ ...data, credentials: result.credentials }); setDeleting(undefined);
+      await sync(() => syncAccepted(data.rpId, data.user.id, result.credentials));
+      setMessage('Passkey removed. You can still sign in with your password.');
+    });
+  }
+  async function create() {
+    if (!data) return;
+    await run(async () => {
+      const options = await api<PublicKeyCredentialCreationOptionsJSON>('account/registration/options', 'POST', {});
+      const credential = await navigator.credentials.create({ publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options) }) as PublicKeyCredential | null;
+      if (!credential) throw new Error('Passkey creation was cancelled.');
+      await api('account/registration/verify', 'POST', credential.toJSON());
+      const credentials = await api<StoredPasskeyCredential[]>('credentials');
+      setData({ ...data, credentials });
+      await sync(() => syncAccepted(data.rpId, data.user.id, credentials));
+      setMessage('Passkey created.');
+    });
+  }
+
+  if (loading) return <p role="status">Loading account settings…</p>;
+  if (!data) return <div><p role="alert">{error}</p><a className="underline" href={`${import.meta.env.BASE_URL}signin`}>Sign in</a><button className="ml-4 underline" onClick={() => window.location.reload()}>Retry</button></div>;
+  return <div className="space-y-8">
+    {error && <p role="alert" className="p-3 bg-red-50 text-red-800 rounded">{error}</p>}
+    {message && <p role="status" className="p-3 bg-green-50 text-green-800 rounded">{message}</p>}
+    {syncWarning && <div className="p-3 bg-amber-50 text-amber-900 rounded"><p role="status">{syncWarning}</p><button disabled={busy} className="text-sm underline mt-2" onClick={() => run(() => sync(async () => { await syncAccepted(data.rpId, data.user.id, data.credentials); await syncUser(data.rpId, data.user); }))}>Retry synchronization</button></div>}
+    <section aria-labelledby="profile-title" className="border border-gray-200 rounded-lg p-6">
+      <h2 id="profile-title" className="text-xl font-bold mb-4">Account details</h2>
+      <form onSubmit={updateProfile} className="space-y-4">
+        <div><label htmlFor="account-name" className="block mb-1">Username</label><input className={inputClass} id="account-name" autoComplete="username" value={name} onChange={e => setName(e.target.value)} required maxLength={100} disabled={busy} /></div>
+        <div><label htmlFor="account-display-name" className="block mb-1">Display name</label><input className={inputClass} id="account-display-name" autoComplete="nickname" value={displayName} onChange={e => setDisplayName(e.target.value)} required maxLength={100} disabled={busy} /></div>
+        <button className={buttonClass} disabled={busy}>Save account details</button>
+      </form>
+    </section>
+    <section aria-labelledby="passkeys-title" className="border border-gray-200 rounded-lg p-6">
+      <h2 id="passkeys-title" className="text-xl font-bold">Passkeys</h2>
+      <p className="text-sm text-gray-600 mt-2 mb-4">Sign in securely with your fingerprint, face, device PIN, or a security key. Give each passkey a name you recognize.</p>
+      {canCreate && <button onClick={create} disabled={busy} className={buttonClass}>{busy ? 'Please wait…' : 'Create passkey'}</button>}
+      {capabilitiesChecked && !canCreate && <p className="text-sm text-gray-600">Passkey creation is unavailable in this browser. Use a supported browser on a secure connection, or enroll in standard multi-factor authentication through your account provider.</p>}
+      {!data.credentials.length ? <p className="mt-6 text-gray-600">No passkeys found. Your password is still available for sign-in.</p> : <ul className="mt-6 divide-y divide-gray-200">
+        {data.credentials.map(credential => {
+          const provider = passkeyProvider(credential.aaguid);
+          const label = credential.name || provider.name;
+          return <li key={credential.id} className="py-5">
+            <div className="flex gap-3 items-start">
+              <img src={provider.icon || fallbackIcon} width={40} height={40} alt={`${provider.name} icon`} className="shrink-0" />
+              <div className="min-w-0 flex-1">
+                <h3 className="font-semibold break-words">{label}</h3>
+                {credential.name && <p className="text-sm text-gray-500">{provider.name}</p>}
+                <p className="text-sm text-gray-600">Registered <time dateTime={new Date(credential.registeredAt).toISOString()}>{date(credential.registeredAt)}</time></p>
+                <p className="text-sm text-gray-600">Last used: {credential.lastUsedAt ? <time dateTime={new Date(credential.lastUsedAt).toISOString()}>{date(credential.lastUsedAt)}</time> : 'Never'}</p>
+                <div className="flex gap-4 mt-3">
+                  <button className="text-sm underline" disabled={busy} aria-label={`Rename ${label}`} onClick={() => { setEditing(credential.id); setNickname(label); setDeleting(undefined); }}>Rename</button>
+                  <button className="text-sm underline text-red-700" disabled={busy} aria-label={`Delete ${label}`} onClick={() => { setDeleting(credential.id); setEditing(undefined); }}>Delete</button>
+                </div>
+                {editing === credential.id && <form className="mt-3 space-y-2" onSubmit={e => rename(e, credential.id)}>
+                  <label htmlFor="passkey-nickname" className="block text-sm">Passkey name</label>
+                  <input id="passkey-nickname" autoFocus className={inputClass} value={nickname} onChange={e => setNickname(e.target.value)} required maxLength={100} disabled={busy} />
+                  <button className={buttonClass} disabled={busy}>Save name</button><button type="button" className="ml-3 text-sm underline" disabled={busy} onClick={() => setEditing(undefined)}>Cancel</button>
+                </form>}
+                {deleting === credential.id && <div className="mt-3 p-3 bg-red-50 rounded">
+                  <p className="text-sm mb-2">Remove “{label}”? This passkey will no longer sign you in. You can still use your password.</p>
+                  <button className={buttonClass} disabled={busy} onClick={() => remove(credential.id)}>Confirm removal</button><button className="ml-3 text-sm underline" disabled={busy} onClick={() => setDeleting(undefined)}>Cancel</button>
+                </div>}
+              </div>
+            </div>
+          </li>;
+        })}
+      </ul>}
+    </section>
+    <button className="text-sm underline" disabled={busy} onClick={() => run(async () => { await api('account/logout', 'POST', {}); window.location.assign(import.meta.env.BASE_URL); })}>Sign out</button>
+  </div>;
+}
