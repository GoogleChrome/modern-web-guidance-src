diff --git a/tests/account-api.spec.ts b/tests/account-api.spec.ts
new file mode 100644
index 0000000..aebafb0
--- /dev/null
+++ b/tests/account-api.spec.ts
@@ -0,0 +1,66 @@
+import { test, expect } from '@playwright/test';
+import type { APIContext } from 'astro';
+import { randomUUID } from 'node:crypto';
+
+test('authenticated ownership, persistence, registration verification and origin protection', async ({ page }) => {
+  process.env.ACCOUNT_DB_PATH = `.data/test-${randomUUID()}.sqlite`;
+  const { ALL } = await import('../src/pages/api/[...accountPath]');
+  const store = await import('../src/lib/account-store');
+  const alice = store.accountForLogin('alice');
+  const bob = store.accountForLogin('bob');
+  const sessionData = new Map<string, unknown>([['accountId', alice.id]]);
+  const origin = 'http://localhost:11225';
+  const session = {
+    get: async (key: string) => sessionData.get(key),
+    set: (key: string, value: unknown) => sessionData.set(key, value),
+    delete: (key: string) => sessionData.delete(key),
+  };
+  async function call(path: string, method = 'GET', body?: unknown, requestOrigin = origin) {
+    const url = new URL(`/devtools-times/api/${path}`, origin);
+    return ALL({ url, params: { accountPath: path }, session, request: new Request(url, {
+      method, headers: { Origin: requestOrigin, 'Content-Type': 'application/json' },
+      body: body === undefined ? undefined : JSON.stringify(body),
+    }) } as unknown as APIContext);
+  }
+  sessionData.delete('accountId');
+  expect((await call('credentials')).status).toBe(401);
+  sessionData.set('accountId', alice.id);
+  expect((await call('user', 'PUT', { name: 'Eve' }, 'https://other.example')).status).toBe(403);
+  expect((await call('user', 'PUT', { name: '' })).status).toBe(400);
+  const updated = await (await call('user', 'PUT', { name: 'Alice renamed', displayName: 'Alice' })).json();
+  expect(updated.id).toBe(alice.id);
+  expect(store.accountById(alice.id)?.name).toBe('Alice renamed');
+  expect((await call('passkeys/register', 'POST', {})).status).toBe(400);
+
+  // A real virtual authenticator exercises navigator.credentials.create and server verification.
+  await page.route('**/*', route => new URL(route.request().url()).hostname === 'localhost' ? route.continue() : route.abort());
+  await page.goto('/devtools-times/settings/passkeys');
+  const cdp = await page.context().newCDPSession(page);
+  await cdp.send('WebAuthn.enable');
+  await cdp.send('WebAuthn.addVirtualAuthenticator', { options: {
+    protocol: 'ctap2', transport: 'usb', hasResidentKey: true, hasUserVerification: true,
+    isUserVerified: true, automaticPresenceSimulation: true,
+  } });
+  const options = await (await call('passkeys/options', 'POST', {})).json();
+  expect(options.authenticatorSelection.authenticatorAttachment).toBeUndefined();
+  const credential = await page.evaluate(async options => {
+    const credential = await navigator.credentials.create({ publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options) }) as PublicKeyCredential;
+    return credential.toJSON();
+  }, options);
+  expect((await call('passkeys/register', 'POST', credential)).status).toBe(201);
+  expect((await call('passkeys/register', 'POST', credential)).status).toBe(400);
+  const saved = await (await call('credentials')).json();
+  expect(saved).toHaveLength(1);
+  expect(saved[0].registeredAt).toEqual(expect.any(Number));
+  expect(saved[0].lastUsedAt).toBeNull();
+  expect(saved[0].publicKey).toBeUndefined();
+  sessionData.set('accountId', bob.id);
+  expect(await (await call('credentials')).json()).toEqual([]);
+  expect((await call(`credential/${saved[0].id}`, 'PUT', { name: 'Stolen' })).status).toBe(404);
+  expect((await call(`credential/${saved[0].id}`, 'DELETE')).status).toBe(404);
+  sessionData.set('accountId', alice.id);
+  expect((await call(`credential/${saved[0].id}`, 'PUT', { name: 'Security key' })).status).toBe(200);
+  expect(store.credentialsForUser(alice.id)[0].name).toBe('Security key');
+  expect((await call(`credential/${saved[0].id}`, 'DELETE')).status).toBe(200);
+  expect(await (await call('credentials')).json()).toEqual([]);
+});
diff --git a/tests/passkeys.spec.ts b/tests/passkeys.spec.ts
new file mode 100644
index 0000000..f8ec0e9
--- /dev/null
+++ b/tests/passkeys.spec.ts
@@ -0,0 +1,118 @@
+import { test, expect } from '@playwright/test';
+import type { Page } from '@playwright/test';
+import type { StoredPasskeyCredential } from '../src/lib/passkeys';
+
+type SignalWindow = Window & { signals: { accepted: unknown[]; details: unknown[] } };
+const profile = { id: 'dXNlcg', name: 'reader', displayName: 'Reader', rpId: 'localhost' };
+const initial: StoredPasskeyCredential[] = [
+  { id: 'Y3JlZDE', passkeyUserId: profile.id, aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', name: 'My laptop', registeredAt: 1700000000000, lastUsedAt: 1710000000000 },
+  { id: 'Y3JlZDI', passkeyUserId: profile.id, aaguid: '00000000-0000-0000-0000-000000000000', name: '', registeredAt: 1700000000000, lastUsedAt: null },
+];
+
+async function setup(page: Page, mode: 'supported' | 'unsupported' | 'no-api' | 'no-signals' | 'signal-error' = 'supported', failDelete = false) {
+  let credentials = structuredClone(initial);
+  let user = { ...profile };
+  await page.route('**/*', async route => {
+    const url = new URL(route.request().url());
+    if (url.hostname !== 'localhost') return route.abort();
+    const path = url.pathname.split('/api/')[1];
+    if (!path) return route.continue();
+    const method = route.request().method();
+    if (path === 'credentials') return route.fulfill({ json: credentials });
+    if (path === 'user') {
+      if (method === 'PUT') user = { ...user, ...route.request().postDataJSON() };
+      return route.fulfill({ json: user });
+    }
+    if (path.startsWith('credential/')) {
+      const id = path.slice('credential/'.length);
+      if (method === 'DELETE') {
+        if (failDelete) return route.fulfill({ status: 500, json: { error: 'Deletion failed.' } });
+        credentials = credentials.filter(item => item.id !== id);
+        return route.fulfill({ json: { success: true } });
+      }
+      const credential = credentials.find(item => item.id === id)!;
+      credential.name = route.request().postDataJSON().name;
+      return route.fulfill({ json: credential });
+    }
+    return route.fulfill({ json: {} });
+  });
+  await page.addInitScript(mode => {
+    (window as unknown as SignalWindow).signals = { accepted: [], details: [] };
+    if (mode === 'no-api') {
+      Object.defineProperty(window, 'PublicKeyCredential', { value: undefined });
+      return;
+    }
+    PublicKeyCredential.getClientCapabilities = async () => ({ userVerifyingPlatformAuthenticator: mode !== 'unsupported' });
+    Object.defineProperty(PublicKeyCredential, 'signalAllAcceptedCredentials', { configurable: true, value: mode === 'no-signals' ? undefined : async (args: unknown) => {
+      (window as unknown as SignalWindow).signals.accepted.push(args);
+      if (mode === 'signal-error') throw new Error('Provider unavailable');
+    } });
+    Object.defineProperty(PublicKeyCredential, 'signalCurrentUserDetails', { configurable: true, value: mode === 'no-signals' ? undefined : async (args: unknown) => {
+      (window as unknown as SignalWindow).signals.details.push(args);
+    } });
+  }, mode);
+  await page.goto('/devtools-times/settings/passkeys');
+  await expect(page.getByRole('heading', { name: 'My laptop' })).toBeVisible();
+}
+
+test('load, provider metadata, nickname, account rename, deletion and empty sync', async ({ page }) => {
+  await setup(page);
+  await expect(page.getByRole('img', { name: 'Google Password Manager icon' })).toBeVisible();
+  await expect(page.getByText('Last used: Never used')).toBeVisible();
+  await expect(page.locator('time').first()).toContainText('2023');
+  await expect(page.locator('time').nth(1)).toContainText('2024');
+  await expect(page.getByRole('button', { name: 'Create passkey' })).toBeVisible();
+  expect(await page.evaluate(() => (window as unknown as SignalWindow).signals.accepted)).toEqual([
+    { rpId: 'localhost', userId: profile.id, allAcceptedCredentialIds: initial.map(item => item.id) },
+  ]);
+  await page.getByRole('button', { name: 'Rename My laptop' }).click();
+  await page.getByLabel('Passkey name').fill('Work laptop');
+  await page.getByRole('button', { name: 'Save name' }).click();
+  await expect(page.getByRole('heading', { name: 'Work laptop' })).toBeVisible();
+  expect(await page.evaluate(() => (window as unknown as SignalWindow).signals.details)).toEqual([]);
+  await page.getByLabel('Username', { exact: true }).fill('new-reader');
+  await page.getByLabel('Display name').fill('New Reader');
+  await page.getByRole('button', { name: 'Save account details' }).click();
+  await expect(page.getByText('Account details saved.')).toBeVisible();
+  expect(await page.evaluate(() => (window as unknown as SignalWindow).signals.details)).toEqual([
+    { rpId: 'localhost', userId: profile.id, name: 'new-reader', displayName: 'New Reader' },
+  ]);
+  for (const name of ['Work laptop', 'Unknown passkey provider']) {
+    await page.getByRole('button', { name: `Delete ${name}`, exact: true }).click();
+    await page.getByRole('button', { name: 'Confirm deletion' }).click();
+    await expect(page.getByRole('button', { name: 'Confirm deletion' })).toHaveCount(0);
+  }
+  await expect(page.getByText(/No passkeys found/)).toBeVisible();
+  expect(await page.evaluate(() => (window as unknown as SignalWindow).signals.accepted)).toEqual([
+    { rpId: 'localhost', userId: profile.id, allAcceptedCredentialIds: ['Y3JlZDE', 'Y3JlZDI'] },
+    { rpId: 'localhost', userId: profile.id, allAcceptedCredentialIds: ['Y3JlZDI'] },
+    { rpId: 'localhost', userId: profile.id, allAcceptedCredentialIds: [] },
+  ]);
+});
+
+for (const mode of ['unsupported', 'no-api'] as const) {
+  test(`creation stays hidden when ${mode}`, async ({ page }) => {
+    await setup(page, mode);
+    await expect(page.getByText(/Passkey creation is unavailable/)).toBeVisible();
+    await expect(page.getByRole('button', { name: 'Create passkey' })).toHaveCount(0);
+  });
+}
+
+for (const mode of ['no-signals', 'signal-error'] as const) {
+  test(`management still works with ${mode}`, async ({ page }) => {
+    await setup(page, mode);
+    await page.getByRole('button', { name: 'Delete My laptop', exact: true }).click();
+    await page.getByRole('button', { name: 'Confirm deletion' }).click();
+    await expect(page.getByText('Passkey deleted.')).toBeVisible();
+    await expect(page.getByRole('heading', { name: 'My laptop' })).toHaveCount(0);
+  });
+}
+
+test('failed deletion keeps credential and does not signal a new list', async ({ page }) => {
+  await setup(page, 'supported', true);
+  await page.getByRole('button', { name: 'Delete My laptop', exact: true }).click();
+  await page.getByRole('button', { name: 'Confirm deletion' }).click();
+  await expect(page.getByRole('alert')).toHaveText('Deletion failed.');
+  await expect(page.getByRole('heading', { name: 'My laptop' })).toBeVisible();
+  expect(await page.evaluate(() => (window as unknown as SignalWindow).signals.accepted.length)).toBe(1);
+});
