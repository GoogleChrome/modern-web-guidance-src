@@ -0,0 +1,30 @@
+import type { APIRoute } from 'astro';
+import { defaultProfile, jsonError, type AccountProfile } from '../../lib/passkeys';
+
+export const prerender = false;
+
+export const GET: APIRoute = async ({ session }) => {
+  if (!session) return jsonError('Authentication is required.', 401);
+  const profile = (await session.get<AccountProfile>('accountProfile')) ?? defaultProfile;
+  return Response.json(profile, { headers: { 'Cache-Control': 'no-store' } });
+};
+
+export const PUT: APIRoute = async ({ request, session }) => {
+  if (!session) return jsonError('Authentication is required.', 401);
+
+  let body: Record<string, unknown>;
+  try {
+    body = await request.json();
+  } catch {
+    return jsonError('A JSON request body is required.', 400);
+  }
+  const name = typeof body.name === 'string' ? body.name.trim() : '';
+  const displayName = typeof body.displayName === 'string' ? body.displayName.trim() : '';
+  if (!name || name.length > 120 || !displayName || displayName.length > 120) {
+    return jsonError('Both names must contain 1–120 characters.', 400);
+  }
+
+  const profile: AccountProfile = { ...defaultProfile, name, displayName };
+  await session.set('accountProfile', profile);
+  return Response.json(profile);
+};
diff --git a/src/pages/api/credentials/[id].ts b/src/pages/api/credentials/[id].ts
new file mode 100644
index 0000000..4a820e2
--- /dev/null
+++ b/src/pages/api/credentials/[id].ts
@@ -0,0 +1,51 @@
+import type { APIRoute } from 'astro';
+import {
+  cleanCredentialName,
+  defaultCredentials,
+  defaultProfile,
+  jsonError,
+  type StoredPasskeyCredential,
+} from '../../../lib/passkeys';
+
+export const prerender = false;
+
+export const PUT: APIRoute = async ({ params, request, session }) => {
+  if (!session) return jsonError('Authentication is required.', 401);
+  const id = params.id;
+  const credentials =
+    (await session.get<StoredPasskeyCredential[]>('passkeyCredentials')) ??
+    structuredClone(defaultCredentials);
+  const credential = credentials.find(
+    (item) => item.id === id && item.passkeyUserId === defaultProfile.userId,
+  );
+  if (!credential) return jsonError('Credential not found.', 404);
+
+  let body: Record<string, unknown>;
+  try {
+    body = await request.json();
+  } catch {
+    return jsonError('A JSON request body is required.', 400);
+  }
+  const name = cleanCredentialName(body.name);
+  if (!name) return jsonError('Name must contain 1–80 characters.', 400);
+
+  credential.name = name;
+  await session.set('passkeyCredentials', credentials);
+  return Response.json(credential);
+};
+
+export const DELETE: APIRoute = async ({ params, session }) => {
+  if (!session) return jsonError('Authentication is required.', 401);
+  const id = params.id;
+  const credentials =
+    (await session.get<StoredPasskeyCredential[]>('passkeyCredentials')) ??
+    structuredClone(defaultCredentials);
+  const index = credentials.findIndex(
+    (item) => item.id === id && item.passkeyUserId === defaultProfile.userId,
+  );
+  if (index === -1) return jsonError('Credential not found.', 404);
+
+  credentials.splice(index, 1);
+  await session.set('passkeyCredentials', credentials);
+  return Response.json({ success: true });
+};
diff --git a/src/pages/api/credentials/index.ts b/src/pages/api/credentials/index.ts
