diff --git a/src/pages/api/account/[...action].ts b/src/pages/api/account/[...action].ts
new file mode 100644
index 0000000..d1f7465
--- /dev/null
+++ b/src/pages/api/account/[...action].ts
@@ -0,0 +1,94 @@
+import type { APIRoute } from 'astro';
+import { randomBytes } from 'node:crypto';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { currentUser, db, json, listCredentials, passwordHash, passwordMatches, relyingParty, signIn, validName } from '../../../lib/accounts';
+import type { Account } from '../../../lib/passkey-types';
+
+export const ALL: APIRoute = async ({ request, cookies, params, url }) => {
+  const action = params.action;
+  const { origin, rpId } = relyingParty(url);
+  // All mutations, including login, require same-origin JSON requests.
+  if (request.method !== 'GET' && (request.headers.get('origin') !== url.origin || !request.headers.get('content-type')?.includes('application/json'))) return json({ error: 'Invalid request origin or content type.' }, 403);
+  try {
+    const user = currentUser(cookies);
+    if (request.method === 'POST' && (action === 'login' || action === 'register')) {
+      const { username, password } = await request.json();
+      if (!validName(username) || typeof password !== 'string' || password.length < 8 || password.length > 256) return json({ error: 'Use a username of 1–100 characters and a password of 8–256 characters.' }, 400);
+      const existing = db.prepare('SELECT * FROM users WHERE name = ?').get(username.trim()) as (Account & { password: string }) | undefined;
+      if (action === 'register') {
+        if (existing) return json({ error: 'That username is already taken.' }, 409);
+        db.prepare('INSERT INTO users VALUES (?, ?, ?, ?)').run(randomBytes(32).toString('base64url'), username.trim(), username.trim(), passwordHash(password));
+        return json({ success: true });
+      }
+      if (!existing || !passwordMatches(password, existing.password)) return json({ error: 'Incorrect username or password.' }, 401);
+      signIn(cookies, existing.id, url.protocol === 'https:');
+      return json({ success: true });
+    }
+    if (request.method === 'POST' && action === 'authentication/options') {
+      const { username } = await request.json();
+      if (!validName(username)) return json({ error: 'Enter your username first.' }, 400);
+      const account = db.prepare('SELECT id FROM users WHERE name = ?').get(username.trim());
+      if (!account) return json({ error: 'No passkeys are available for this account.' }, 400);
+      const credentials = listCredentials(String(account.id), rpId);
+      if (!credentials.length) return json({ error: 'No passkeys are available for this account.' }, 400);
+      const options = await generateAuthenticationOptions({ rpID: rpId, allowCredentials: credentials.map(({ id }) => ({ id })), userVerification: 'required' });
+      saveChallenge(String(account.id), options.challenge, 'authentication');
+      return json(options);
+    }
+    if (request.method === 'POST' && action === 'authentication/verify') {
+      const challenge = takeChallenge('authentication');
+      if (!challenge) return json({ error: 'Passkey request expired. Try again.' }, 400);
+      const response = await request.json();
+      const credential = db.prepare('SELECT * FROM credentials WHERE id = ? AND userId = ? AND rpId = ?').get(response.id, challenge.userId, rpId);
+      if (!credential) return json({ error: 'Passkey not found.' }, 400);
+      const result = await verifyAuthenticationResponse({ response, expectedChallenge: challenge.challenge, expectedOrigin: origin, expectedRPID: rpId, credential: { id: String(credential.id), publicKey: new Uint8Array(Buffer.from(String(credential.publicKey), 'base64url')), counter: Number(credential.counter), transports: JSON.parse(String(credential.transports)) } });
+      if (!result.verified) return json({ error: 'Could not verify passkey.' }, 400);
+      db.prepare('UPDATE credentials SET lastUsedAt = ?, counter = ? WHERE id = ?').run(Date.now(), result.authenticationInfo.newCounter, String(credential.id));
+      signIn(cookies, challenge.userId, url.protocol === 'https:');
+      return json({ success: true });
+    }
+    if (!user) return json({ error: 'Please sign in to manage your account.' }, 401);
+    if (request.method === 'POST' && action === 'logout') {
+      const token = cookies.get('times_account')?.value;
+      if (token) {
+        const { createHash } = await import('node:crypto');
+        db.prepare('DELETE FROM sessions WHERE token = ?').run(createHash('sha256').update(token).digest('hex'));
+      }
+      cookies.delete('times_account', { path: import.meta.env.BASE_URL });
+      return json({ success: true });
+    }
+    if (request.method === 'GET' && action === 'settings') return json({ user, credentials: listCredentials(user.id, rpId), rpId });
+    if (request.method === 'POST' && action === 'registration/options') {
+      const options = await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID: rpId, userID: new Uint8Array(Buffer.from(user.id, 'base64url')), userName: user.name, userDisplayName: user.displayName, attestationType: 'none', excludeCredentials: listCredentials(user.id, rpId).map(({ id }) => ({ id })), authenticatorSelection: { residentKey: 'required', userVerification: 'required' } });
+      saveChallenge(user.id, options.challenge, 'registration');
+      return json(options);
+    }
+    if (request.method === 'POST' && action === 'registration/verify') {
+      const challenge = takeChallenge('registration');
+      if (!challenge || challenge.userId !== user.id) return json({ error: 'Passkey request expired. Try again.' }, 400);
+      const result = await verifyRegistrationResponse({ response: await request.json(), expectedChallenge: challenge.challenge, expectedOrigin: origin, expectedRPID: rpId });
+      if (!result.verified) return json({ error: 'Could not verify passkey.' }, 400);
+      const { credential, aaguid } = result.registrationInfo;
+      db.prepare('INSERT INTO credentials VALUES (?, ?, ?, ?, ?, ?, NULL, ?, ?, ?)').run(credential.id, user.id, rpId, '', aaguid, Date.now(), Buffer.from(credential.publicKey).toString('base64url'), credential.counter, JSON.stringify(credential.transports || []));
+      return json({ success: true });
+    }
+    return json({ error: 'Not found.' }, 404);
+
+    function saveChallenge(userId: string, challenge: string, kind: string) {
+      const token = randomBytes(32).toString('base64url');
+      db.prepare('DELETE FROM challenges WHERE expires <= ?').run(Date.now());
+      db.prepare('INSERT INTO challenges VALUES (?, ?, ?, ?, ?, ?)').run(token, userId, challenge, origin, kind, Date.now() + 300000);
+      cookies.set('times_challenge', token, { path: import.meta.env.BASE_URL, httpOnly: true, secure: url.protocol === 'https:', sameSite: 'strict', maxAge: 300 });
+    }
+    function takeChallenge(kind: string) {
+      const token = cookies.get('times_challenge')?.value || '';
+      const record = db.prepare('DELETE FROM challenges WHERE token = ? RETURNING *').get(token);
+      cookies.delete('times_challenge', { path: import.meta.env.BASE_URL });
+      if (!record || record.kind !== kind || record.origin !== origin || Number(record.expires) <= Date.now()) return;
+      return { userId: String(record.userId), challenge: String(record.challenge) };
+    }
+  } catch (error) {
+    console.error('Account request failed', error);
+    return json({ error: 'The request could not be completed. Please try again.' }, 400);
+  }
+};
diff --git a/src/pages/api/credential/[id].ts b/src/pages/api/credential/[id].ts
