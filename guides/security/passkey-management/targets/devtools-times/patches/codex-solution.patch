diff --git a/src/lib/account-store.ts b/src/lib/account-store.ts
new file mode 100644
index 0000000..7a1ef48
--- /dev/null
+++ b/src/lib/account-store.ts
@@ -0,0 +1,54 @@
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes } from 'node:crypto';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import type { Account, StoredPasskeyCredential } from './passkeys';
+import type { WebAuthnCredential } from '@simplewebauthn/server';
+
+const file = resolve(process.env.ACCOUNT_DB_PATH || '.data/accounts.sqlite');
+mkdirSync(dirname(file), { recursive: true });
+const db = new DatabaseSync(file);
+db.exec(`PRAGMA journal_mode = WAL;
+  PRAGMA foreign_keys = ON;
+  CREATE TABLE IF NOT EXISTS users (
+    id TEXT PRIMARY KEY, loginName TEXT UNIQUE NOT NULL, name TEXT NOT NULL, displayName TEXT NOT NULL
+  );
+  CREATE TABLE IF NOT EXISTS credentials (
+    id TEXT PRIMARY KEY, passkeyUserId TEXT NOT NULL REFERENCES users(id),
+    aaguid TEXT NOT NULL, name TEXT NOT NULL, registeredAt INTEGER NOT NULL,
+    lastUsedAt INTEGER, publicKey TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL
+  );`);
+
+export function accountById(id: string): Account | undefined {
+  return db.prepare('SELECT id, name, displayName FROM users WHERE id = ?').get(id) as Account | undefined;
+}
+
+// Only called after the existing identity service verifies the password.
+export function accountForLogin(loginName: string): Account {
+  db.prepare('INSERT OR IGNORE INTO users (id, loginName, name, displayName) VALUES (?, ?, ?, ?)')
+    .run(randomBytes(32).toString('base64url'), loginName, loginName, loginName);
+  return db.prepare('SELECT id, name, displayName FROM users WHERE loginName = ?').get(loginName) as unknown as Account;
+}
+
+export function updateAccount(id: string, name: string, displayName: string): Account {
+  db.prepare('UPDATE users SET name = ?, displayName = ? WHERE id = ?').run(name, displayName, id);
+  return accountById(id)!;
+}
+
+export function credentialsForUser(userId: string): StoredPasskeyCredential[] {
+  return db.prepare('SELECT id, passkeyUserId, aaguid, name, registeredAt, lastUsedAt FROM credentials WHERE passkeyUserId = ? ORDER BY registeredAt DESC')
+    .all(userId) as unknown as StoredPasskeyCredential[];
+}
+
+export function renameCredential(userId: string, id: string, name: string): boolean {
+  return db.prepare('UPDATE credentials SET name = ? WHERE id = ? AND passkeyUserId = ?').run(name, id, userId).changes > 0;
+}
+
+export function deleteCredential(userId: string, id: string): boolean {
+  return db.prepare('DELETE FROM credentials WHERE id = ? AND passkeyUserId = ?').run(id, userId).changes > 0;
+}
+
+export function saveCredential(userId: string, aaguid: string, name: string, credential: WebAuthnCredential) {
+  db.prepare('INSERT INTO credentials (id, passkeyUserId, aaguid, name, registeredAt, publicKey, counter, transports) VALUES (?, ?, ?, ?, ?, ?, ?, ?)')
+    .run(credential.id, userId, aaguid, name, Date.now(), Buffer.from(credential.publicKey).toString('base64url'), credential.counter, JSON.stringify(credential.transports ?? []));
+}
diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..99c467f
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,22 @@
+import registry from '../data/aaguids.json' with { type: 'json' };
+
+export interface Account {
+  id: string; // Base64URL WebAuthn user handle; never changes on profile rename.
+  name: string;
+  displayName: string;
+}
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL credential ID returned by the verified authenticator.
+  passkeyUserId: string;
+  aaguid: string;
+  name: string;
+  registeredAt: number;
+  lastUsedAt: number | null;
+}
+
+export function passkeyProvider(aaguid: string) {
+  const unknown = { name: 'Unknown passkey provider', icon_light: undefined as string | undefined };
+  if (aaguid === '00000000-0000-0000-0000-000000000000') return unknown;
+  return (registry as Record<string, { name: string; icon_light?: string }>)[aaguid.toLowerCase()] ?? unknown;
+}
diff --git a/src/pages/api/[...accountPath].ts b/src/pages/api/[...accountPath].ts
new file mode 100644
index 0000000..b6dcf19
--- /dev/null
+++ b/src/pages/api/[...accountPath].ts
@@ -0,0 +1,100 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse } from '@simplewebauthn/server';
+import type { RegistrationResponseJSON } from '@simplewebauthn/server';
+import { accountById, accountForLogin, credentialsForUser, deleteCredential, renameCredential, saveCredential, updateAccount } from '../../lib/account-store';
+import { passkeyProvider } from '../../lib/passkeys';
+
+const json = (value: unknown, status = 200) => new Response(JSON.stringify(value), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+function label(value: unknown): value is string {
+  return typeof value === 'string' && value.trim().length > 0 && value.trim().length <= 100;
+}
+
+export const ALL: APIRoute = async ({ request, url, params, session }) => {
+  const path = params.accountPath;
+  const method = request.method;
+  const origin = process.env.WEBAUTHN_ORIGIN || url.origin;
+  const rpID = new URL(origin).hostname;
+  if (!['GET', 'HEAD'].includes(method) && request.headers.get('Origin') !== origin) {
+    return json({ error: 'Request origin is not allowed.' }, 403);
+  }
+  if (!session) return json({ error: 'Session storage is unavailable.' }, 503);
+  try {
+    if (path === 'login' && method === 'POST') {
+      const body = await request.json();
+      if (!label(body.username) || typeof body.password !== 'string' || body.password.length > 1024) {
+        return json({ error: 'Enter your username and password.' }, 400);
+      }
+      const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login', {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username: body.username, password: body.password }), signal: AbortSignal.timeout(15000),
+      });
+      if (!response.ok) return json({ error: 'Invalid username or password.' }, 401);
+      const result = await response.json();
+      if (result.error) return json({ error: 'Invalid username or password.' }, 401);
+      const user = accountForLogin(body.username);
+      await session.regenerate();
+      session.set('accountId', user.id);
+      return json(user);
+    }
+    const accountId = await session.get('accountId');
+    const user = typeof accountId === 'string' ? accountById(accountId) : undefined;
+    if (!user) return json({ error: 'Sign in to manage your passkeys.' }, 401);
+
+    if (path === 'credentials' && method === 'GET') return json(credentialsForUser(user.id));
+    if (path === 'user' && method === 'GET') return json({ ...user, rpId: rpID });
+    if (path === 'user' && method === 'PUT') {
+      const body = await request.json();
+      const name = body.name ?? user.name;
+      const displayName = body.displayName ?? user.displayName;
+      if (!label(name) || !label(displayName)) return json({ error: 'Names must contain 1–100 characters.' }, 400);
+      return json({ ...updateAccount(user.id, name.trim(), displayName.trim()), rpId: rpID });
+    }
+    if (path?.startsWith('credential/')) {
+      const id = path.slice('credential/'.length);
+      if (method === 'DELETE') {
+        if (!deleteCredential(user.id, id)) return json({ error: 'Credential not found.' }, 404);
+        return json({ success: true });
+      }
+      if (method === 'PUT') {
+        const body = await request.json();
+        if (!label(body.name)) return json({ error: 'Passkey names must contain 1–100 characters.' }, 400);
+        if (!renameCredential(user.id, id, body.name.trim())) return json({ error: 'Credential not found.' }, 404);
+        return json(credentialsForUser(user.id).find(credential => credential.id === id));
+      }
+    }
+    if (path === 'passkeys/options' && method === 'POST') {
+      const options = await generateRegistrationOptions({
+        rpName: 'The DevTools Times', rpID,
+        userID: new Uint8Array(Buffer.from(user.id, 'base64url')),
+        userName: user.name, userDisplayName: user.displayName,
+        attestationType: 'none',
+        excludeCredentials: credentialsForUser(user.id).map(({ id }) => ({ id })),
+        // No authenticatorAttachment restriction: security keys are welcome too.
+        authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+      });
+      session.set('passkeyChallenge', { value: options.challenge, expires: Date.now() + 300000 });
+      return json(options);
+    }
+    if (path === 'passkeys/register' && method === 'POST') {
+      const challenge = await session.get('passkeyChallenge');
+      session.delete('passkeyChallenge');
+      if (!challenge || challenge.expires < Date.now()) return json({ error: 'Registration expired. Please try again.' }, 400);
+      const response = await request.json() as RegistrationResponseJSON;
+      const { verified, registrationInfo } = await verifyRegistrationResponse({
+        response, expectedChallenge: challenge.value, expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true,
+      });
+      if (!verified || !registrationInfo) return json({ error: 'Passkey verification failed.' }, 400);
+      const { aaguid, credential } = registrationInfo;
+      saveCredential(user.id, aaguid, passkeyProvider(aaguid).name, credential);
+      return json({ success: true }, 201);
+    }
+    return json({ error: 'Endpoint not found.' }, 404);
+  } catch (error) {
+    if (error instanceof SyntaxError) return json({ error: 'Invalid JSON request.' }, 400);
+    if (path === 'passkeys/register') return json({ error: 'Could not verify this passkey. Please try again.' }, 400);
+    console.error('Account request failed:', error);
+    return json({ error: 'Unable to complete this request. Please try again.' }, 500);
+  }
+};
