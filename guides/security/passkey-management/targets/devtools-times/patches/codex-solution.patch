--- /dev/null
+++ b/src/pages/api/credentials/index.ts
@@ -0,0 +1,62 @@
+import type { APIRoute } from 'astro';
+import {
+  cleanCredentialName,
+  defaultCredentials,
+  defaultProfile,
+  isBase64Url,
+  jsonError,
+  type StoredPasskeyCredential,
+} from '../../../lib/passkeys';
+
+export const prerender = false;
+
+export const GET: APIRoute = async ({ session }) => {
+  if (!session) return jsonError('Authentication is required.', 401);
+
+  let credentials = await session.get<StoredPasskeyCredential[]>('passkeyCredentials');
+  if (!credentials) {
+    credentials = structuredClone(defaultCredentials);
+    await session.set('passkeyCredentials', credentials);
+  }
+
+  return Response.json(credentials, {
+    headers: { 'Cache-Control': 'no-store' },
+  });
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (!session) return jsonError('Authentication is required.', 401);
+
+  let body: Record<string, unknown>;
+  try {
+    body = await request.json();
+  } catch {
+    return jsonError('A JSON request body is required.', 400);
+  }
+
+  const id = typeof body.id === 'string' ? body.id : '';
+  if (!isBase64Url(id)) return jsonError('A valid Base64URL credential ID is required.', 400);
+
+  const credentials =
+    (await session.get<StoredPasskeyCredential[]>('passkeyCredentials')) ??
+    structuredClone(defaultCredentials);
+  if (credentials.some((credential) => credential.id === id)) {
+    return jsonError('This passkey is already registered.', 409);
+  }
+
+  const credential: StoredPasskeyCredential = {
+    id,
+    passkeyUserId: defaultProfile.userId,
+    aaguid:
+      typeof body.aaguid === 'string'
+        ? body.aaguid
+        : '00000000-0000-0000-0000-000000000000',
+    name: cleanCredentialName(body.name),
+    registeredAt: Date.now(),
+    lastUsedAt: null,
+  };
+  credentials.push(credential);
+  await session.set('passkeyCredentials', credentials);
+
+  return Response.json(credential, { status: 201 });
+};
