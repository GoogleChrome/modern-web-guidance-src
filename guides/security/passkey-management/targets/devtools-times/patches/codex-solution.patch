--- /dev/null
+++ b/src/pages/api/credential/[id].ts
@@ -0,0 +1,24 @@
+import type { APIRoute } from 'astro';
+import { currentUser, db, json, listCredentials, relyingParty, validName } from '../../../lib/accounts';
+const mutate: APIRoute = async ({ request, cookies, params, url }) => {
+  if (request.headers.get('origin') !== url.origin || !request.headers.get('content-type')?.includes('application/json')) return json({ error: 'Invalid request.' }, 403);
+  const user = currentUser(cookies);
+  if (!user) return json({ error: 'Please sign in.' }, 401);
+  const { rpId } = relyingParty(url);
+  const credential = listCredentials(user.id, rpId).find(c => c.id === params.id);
+  if (!credential) return json({ error: 'Credential not found.' }, 404);
+  try {
+    if (request.method === 'DELETE') {
+      db.prepare('DELETE FROM credentials WHERE id = ? AND userId = ?').run(credential.id, user.id);
+      return json({ success: true, credentials: listCredentials(user.id, rpId) });
+    }
+    const { name } = await request.json();
+    if (!validName(name)) return json({ error: 'Use a name of 1–100 characters.' }, 400);
+    db.prepare('UPDATE credentials SET name = ? WHERE id = ? AND userId = ?').run(name.trim(), credential.id, user.id);
+    return json({ ...credential, name: name.trim() });
+  } catch {
+    return json({ error: 'Unable to update the passkey. Please try again.' }, 400);
+  }
+};
+export const PUT = mutate;
+export const DELETE = mutate;
