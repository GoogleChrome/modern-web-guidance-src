diff --git a/server/app.ts b/server/app.ts
new file mode 100644
index 0000000..ae1234e
--- /dev/null
+++ b/server/app.ts
@@ -0,0 +1,165 @@
+import express, { type ErrorRequestHandler } from 'express';
+import { createHash, randomBytes, timingSafeEqual } from 'node:crypto';
+import { generateRegistrationOptions, verifyRegistrationResponse } from '@simplewebauthn/server';
+import { Store, publicCredential } from './store.js';
+
+interface Configuration {
+  store: Store;
+  origin: string;
+  password?: string;
+  demo: boolean;
+}
+interface Session {
+  userId: string;
+  expires: number;
+  challenge?: { value: string; expires: number };
+}
+class HttpError extends Error {
+  constructor(public status: number, message: string) { super(message); }
+}
+function label(value: unknown): string {
+  if (typeof value !== 'string' || !value.trim() || value.trim().length > 100) {
+    throw new HttpError(400, 'Enter a name between 1 and 100 characters.');
+  }
+  return value.trim();
+}
+const digest = (value: string) => createHash('sha256').update(value).digest();
+
+export function createApp({ store, origin, password, demo }: Configuration) {
+  if (!demo && !password) throw new Error('ACCOUNT_PASSWORD is required outside demo mode.');
+  const loginPassword = password ?? 'demo';
+  const app = express();
+  const rpId = new URL(origin).hostname;
+  const sessions = new Map<string, Session>();
+  const attempts = new Map<string, { count: number; expires: number }>();
+  const cookieOptions = { httpOnly: true, sameSite: 'strict' as const, secure: origin.startsWith('https:'), path: '/' };
+  app.disable('x-powered-by');
+  app.use(express.json({ limit: '64kb' }));
+  app.use('/api', (req, res, next) => {
+    res.set('Cache-Control', 'no-store');
+    if (!['GET', 'HEAD'].includes(req.method) && req.get('origin') !== origin) {
+      return res.status(403).json({ error: 'Request origin is not allowed.' });
+    }
+    next();
+  });
+  app.post('/api/login', (req, res) => {
+    const key = req.ip ?? 'unknown';
+    const attempt = attempts.get(key);
+    const current = attempt && attempt.expires > Date.now() ? attempt : { count: 0, expires: Date.now() + 60_000 };
+    attempts.set(key, current);
+    if (++current.count > 10) return res.status(429).json({ error: 'Too many attempts. Try again in a minute.' });
+    if (typeof req.body?.password !== 'string' || !timingSafeEqual(digest(req.body.password), digest(loginPassword))) {
+      return res.status(401).json({ error: 'Incorrect password.' });
+    }
+    const token = randomBytes(32).toString('base64url');
+    sessions.set(token, { userId: store.read().user.id, expires: Date.now() + 8 * 60 * 60_000 });
+    res.cookie('session', token, { ...cookieOptions, maxAge: 8 * 60 * 60_000 });
+    res.json({ success: true });
+  });
+  app.use('/api', (req, res, next) => {
+    for (const [token, session] of sessions) if (session.expires <= Date.now()) sessions.delete(token);
+    for (const [key, attempt] of attempts) if (attempt.expires <= Date.now()) attempts.delete(key);
+    let token = req.headers.cookie?.split(';').map(part => part.trim()).find(part => part.startsWith('session='))?.slice(8);
+    let session = token ? sessions.get(token) : undefined;
+    // Explicit local demo only; production always requires a password session.
+    if (!session && demo && req.method === 'GET' && token !== 'signed-out') {
+      token = randomBytes(32).toString('base64url');
+      session = { userId: store.read().user.id, expires: Date.now() + 8 * 60 * 60_000 };
+      sessions.set(token, session);
+      res.cookie('session', token, cookieOptions);
+    }
+    if (!session || session.userId !== store.read().user.id) return res.status(401).json({ error: demo ? 'Please sign in to manage your account. The local demo password is “demo”.' : 'Please sign in to manage your account.' });
+    res.locals.session = session;
+    res.locals.token = token;
+    next();
+  });
+  app.post('/api/logout', (_req, res) => {
+    sessions.delete(res.locals.token as string);
+    res.cookie('session', 'signed-out', cookieOptions);
+    res.json({ success: true });
+  });
+  app.get('/api/user', (_req, res) => res.json({ ...store.read().user, rpId }));
+  app.get('/api/credentials', (_req, res) => {
+    const session = res.locals.session as Session;
+    res.json(store.read().credentials.filter(c => c.passkeyUserId === session.userId).map(publicCredential));
+  });
+  app.put('/api/user', (req, res) => {
+    const name = label(req.body?.name);
+    const displayName = label(req.body?.displayName);
+    const user = store.update(db => {
+      db.user.name = name;
+      db.user.displayName = displayName;
+      return db.user;
+    });
+    res.json({ ...user, rpId });
+  });
+  app.put('/api/credential/:id', (req, res) => {
+    const session = res.locals.session as Session;
+    const credential = store.update(db => {
+      const credential = db.credentials.find(c => c.id === req.params.id && c.passkeyUserId === session.userId);
+      if (!credential) throw new HttpError(404, 'Credential not found.');
+      credential.name = label(req.body?.name);
+      return publicCredential(credential);
+    });
+    res.json(credential);
+  });
+  app.delete('/api/credential/:id', (req, res) => {
+    const session = res.locals.session as Session;
+    store.update(db => {
+      const index = db.credentials.findIndex(c => c.id === req.params.id && c.passkeyUserId === session.userId);
+      if (index < 0) throw new HttpError(404, 'Credential not found.');
+      db.credentials.splice(index, 1);
+    });
+    res.json({ success: true });
+  });
+  app.post('/api/registration/options', async (_req, res) => {
+    const session = res.locals.session as Session;
+    const { user, credentials } = store.read();
+    const options = await generateRegistrationOptions({
+      rpName: 'The Daily Grind', rpID: rpId,
+      userID: new Uint8Array(Buffer.from(user.id, 'base64url')),
+      userName: user.name, userDisplayName: user.displayName,
+      attestationType: 'none',
+      excludeCredentials: credentials.filter(c => c.passkeyUserId === session.userId).map(c => ({ id: c.id, transports: c.transports })),
+      // Omitting authenticatorAttachment permits both platform and security keys.
+      authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+    });
+    session.challenge = { value: options.challenge, expires: Date.now() + 5 * 60_000 };
+    res.json(options);
+  });
+  app.post('/api/registration/verify', async (req, res) => {
+    const session = res.locals.session as Session;
+    const challenge = session.challenge;
+    delete session.challenge;
+    if (!challenge || challenge.expires < Date.now()) throw new HttpError(400, 'Registration expired. Please try again.');
+    let result;
+    try {
+      result = await verifyRegistrationResponse({ response: req.body, expectedChallenge: challenge.value, expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: true });
+    } catch {
+      throw new HttpError(400, 'Passkey verification failed. Please try again.');
+    }
+    if (!result.verified) throw new HttpError(400, 'Passkey could not be verified.');
+    const { credential, aaguid, credentialDeviceType, credentialBackedUp } = result.registrationInfo;
+    const saved = store.update(db => {
+      if (db.credentials.some(c => c.id === credential.id)) throw new HttpError(409, 'This passkey is already registered.');
+      const saved = {
+        id: credential.id, passkeyUserId: session.userId, aaguid, name: '',
+        registeredAt: Date.now(), lastUsedAt: null,
+        publicKey: Buffer.from(credential.publicKey).toString('base64url'), counter: credential.counter,
+        transports: credential.transports, deviceType: credentialDeviceType, backedUp: credentialBackedUp,
+      };
+      db.credentials.push(saved);
+      return publicCredential(saved);
+    });
+    res.status(201).json(saved);
+  });
+  app.use('/api', (_req, res) => res.status(404).json({ error: 'Endpoint not found.' }));
+  const errorHandler: ErrorRequestHandler = (error: unknown, _req, res, _next) => {
+    if (error instanceof HttpError) return void res.status(error.status).json({ error: error.message });
+    if (error instanceof SyntaxError) return void res.status(400).json({ error: 'Invalid request body.' });
+    console.error(error);
+    res.status(500).json({ error: 'Unable to save your changes. Please try again.' });
+  };
+  app.use(errorHandler);
+  return app;
+}
diff --git a/server/index.ts b/server/index.ts
new file mode 100644
index 0000000..ee5feb1
--- /dev/null
+++ b/server/index.ts
@@ -0,0 +1,22 @@
+import express from 'express';
+import { resolve } from 'node:path';
+import { createApp } from './app.js';
+import { Store } from './store.js';
+
+const port = Number(process.env.PORT ?? 11222);
+const production = process.env.NODE_ENV === 'production';
+const origin = process.env.APP_ORIGIN ?? `http://localhost:${port}`;
+if (production && (!process.env.APP_ORIGIN || !process.env.ACCOUNT_PASSWORD)) {
+  throw new Error('Production requires APP_ORIGIN and ACCOUNT_PASSWORD.');
+}
+const demo = !production && !process.env.ACCOUNT_PASSWORD;
+const app = createApp({ store: new Store(resolve(process.env.DATA_FILE ?? 'data/account.json')), origin, password: process.env.ACCOUNT_PASSWORD, demo });
+if (production) {
+  app.use(express.static('dist'));
+  app.get('/account', (_req, res) => res.sendFile(resolve('dist/index.html')));
+} else {
+  const { createServer } = await import('vite');
+  const vite = await createServer({ server: { middlewareMode: true }, appType: 'spa' });
+  app.use(vite.middlewares);
+}
+app.listen(port, () => console.log(`The Daily Grind: ${origin}${demo ? ' (local demo account)' : ''}`));
diff --git a/server/store.ts b/server/store.ts
new file mode 100644
index 0000000..e1eb77b
--- /dev/null
+++ b/server/store.ts
@@ -0,0 +1,55 @@
+import { mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { randomBytes } from 'node:crypto';
+import type { StoredPasskeyCredential } from '../src/types.js';
+import type { WebAuthnCredential } from '@simplewebauthn/server';
+
+export interface DatabaseCredential extends StoredPasskeyCredential {
+  publicKey: string;
+  counter: number;
+  transports?: WebAuthnCredential['transports'];
+  deviceType: string;
+  backedUp: boolean;
+}
+export interface Database {
+  user: { id: string; name: string; displayName: string };
+  credentials: DatabaseCredential[];
+}
+
+/** Single-process store. Commit to disk before publishing a new in-memory state. */
+export class Store {
+  private state: Database;
+  constructor(private readonly file: string) {
+    mkdirSync(dirname(file), { recursive: true });
+    try {
+      this.state = JSON.parse(readFileSync(file, 'utf8')) as Database;
+      if (!this.state.user?.id || !Array.isArray(this.state.credentials)) {
+        throw new Error('Invalid account database');
+      }
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
+      this.state = {
+        user: { id: randomBytes(32).toString('base64url'), name: 'coffee-lover', displayName: 'Coffee Lover' },
+        credentials: [],
+      };
+      this.commit(this.state);
+    }
+  }
+  read(): Database { return structuredClone(this.state); }
+  update<T>(operation: (draft: Database) => T): T {
+    const draft = this.read();
+    const result = operation(draft);
+    this.commit(draft);
+    return result;
+  }
+  private commit(state: Database) {
+    writeFileSync(`${this.file}.tmp`, JSON.stringify(state, null, 2), { mode: 0o600 });
+    renameSync(`${this.file}.tmp`, this.file);
+    this.state = state;
+  }
+}
+
+export function publicCredential(credential: DatabaseCredential): StoredPasskeyCredential {
+  const { id, passkeyUserId, aaguid, name, registeredAt, lastUsedAt } = credential;
+  return { id, passkeyUserId, aaguid, name, registeredAt, lastUsedAt };
+}
