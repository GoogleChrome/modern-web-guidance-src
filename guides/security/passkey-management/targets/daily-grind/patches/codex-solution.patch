+export interface UserProfile {
+  /** Base64URL encoding of the actual WebAuthn user handle. */
+  id: string;
+  name: string;
+  displayName: string;
+  rpId: string;
+}
+
+export interface StoredPasskeyCredential {
+  /** Base64URL credential ID, as returned by the registration verifier. */
+  id: string;
+  passkeyUserId: string;
+  aaguid: string;
+  name: string;
+  registeredAt: number;
+  lastUsedAt: number | null;
+}
diff --git a/tests/account.spec.ts b/tests/account.spec.ts
new file mode 100644
index 0000000..7e97f01
--- /dev/null
+++ b/tests/account.spec.ts
@@ -0,0 +1,195 @@
+import { test, expect, type Page } from '@playwright/test';
+import type { StoredPasskeyCredential } from '../src/types';
+
+declare global {
+  interface Window {
+    __signals: { accepted: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }[]; profile: unknown[] };
+    __capabilityCalls: number;
+  }
+}
+const user = { id: 'dXNlcg', name: 'coffee-lover', displayName: 'Coffee Lover', rpId: 'localhost' };
+const fixture: StoredPasskeyCredential[] = [
+  { id: 'Zmlyc3Q', passkeyUserId: user.id, aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', name: '', registeredAt: 1704067200000, lastUsedAt: 1714564800000 },
+  { id: 'c2Vjb25k', passkeyUserId: user.id, aaguid: '00000000-0000-0000-0000-000000000000', name: 'Backup key', registeredAt: 1704067200000, lastUsedAt: null },
+];
+
+async function instrument(page: Page, mode = 'supported') {
+  await page.addInitScript(({ mode }) => {
+    window.__signals = { accepted: [], profile: [] };
+    window.__capabilityCalls = 0;
+    if (mode === 'absent') {
+      Object.defineProperty(window, 'PublicKeyCredential', { value: undefined, configurable: true });
+      return;
+    }
+    Object.defineProperty(PublicKeyCredential, 'getClientCapabilities', { configurable: true, value: async () => {
+      window.__capabilityCalls++;
+      if (mode === 'rejected') throw new Error('Unavailable');
+      return { passkeyPlatformAuthenticator: mode !== 'unsupported' };
+    } });
+    Object.defineProperty(PublicKeyCredential, 'signalAllAcceptedCredentials', { configurable: true, value: mode === 'no-signals' ? undefined : async (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => {
+      window.__signals.accepted.push(options);
+      if (mode === 'signal-error') throw new Error('Synchronization unavailable');
+    } });
+    Object.defineProperty(PublicKeyCredential, 'signalCurrentUserDetails', { configurable: true, value: mode === 'no-signals' ? undefined : async (options: unknown) => {
+      window.__signals.profile.push(options);
+      if (mode === 'signal-error') throw new Error('Synchronization unavailable');
+    } });
+  }, { mode });
+}
+
+async function mockApi(page: Page, options: { empty?: boolean; failMutation?: boolean; failList?: boolean } = {}) {
+  let rows = options.empty ? [] : structuredClone(fixture);
+  let profile = { ...user };
+  const calls: string[] = [];
+  await page.route('**/api/**', async route => {
+    const request = route.request();
+    const path = new URL(request.url()).pathname;
+    const method = request.method();
+    calls.push(`${method} ${path}`);
+    if ((options.failMutation && method !== 'GET') || (options.failList && path === '/api/credentials')) {
+      await route.fulfill({ status: 500, json: { error: 'Service unavailable.' } });
+      return;
+    }
+    if (path === '/api/user') {
+      if (method === 'PUT') profile = { ...profile, ...request.postDataJSON() };
+      await route.fulfill({ json: profile });
+    } else if (path === '/api/credentials') await route.fulfill({ json: rows });
+    else if (path.startsWith('/api/credential/')) {
+      const id = path.split('/').at(-1);
+      if (method === 'DELETE') {
+        rows = rows.filter(row => row.id !== id);
+        await route.fulfill({ json: { success: true } });
+      } else {
+        const row = rows.find(row => row.id === id)!;
+        row.name = request.postDataJSON().name;
+        await route.fulfill({ json: row });
+      }
+    } else await route.fulfill({ status: 404, json: { error: 'Not found' } });
+  });
+  return calls;
+}
+
+test('load fetches credentials, renders registry metadata and dates, and syncs Base64URL IDs', async ({ page }) => {
+  await instrument(page);
+  const calls = await mockApi(page);
+  await page.goto('/account');
+  await expect(page.locator('.credential-row')).toHaveCount(2);
+  await expect(page.locator('.credential-row').first().locator('img')).toHaveAttribute('src', /^data:image\//);
+  await expect(page.locator('.credential-row').first()).toContainText('Google Password Manager');
+  await expect(page.locator('.credential-row').first().locator('time').last()).toHaveAttribute('datetime', '2024-05-01T12:00:00.000Z');
+  await expect(page.locator('.credential-row').last()).toContainText('Unknown passkey provider');
+  await expect(page.locator('.credential-row').last()).toContainText('Never used');
