+++ b/src/account.ts
@@ -0,0 +1,335 @@
+import 'webauthn-polyfills';
+import { resolveProvider } from './providers';
+import type { StoredPasskeyCredential, UserProfile } from './types';
+
+// Signal methods are still absent from TypeScript's DOM declarations.
+const PublicKeyCredential = window.PublicKeyCredential as typeof window.PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: { rpId: string; userId: string; allAcceptedCredentialIds: string[] }) => Promise<void>;
+  signalCurrentUserDetails?: (options: { rpId: string; userId: string; name: string; displayName: string }) => Promise<void>;
+};
+
+function element<T extends HTMLElement>(id: string): T {
+  const value = document.getElementById(id);
+  if (!value) throw new Error(`Missing element: ${id}`);
+  return value as T;
+}
+const status = element('account-status');
+const syncStatus = element('sync-status');
+const content = element('account-content');
+const list = element<HTMLUListElement>('credential-list');
+const profileForm = element<HTMLFormElement>('profile-form');
+const username = element<HTMLInputElement>('username');
+const displayName = element<HTMLInputElement>('display-name');
+const createButton = element<HTMLButtonElement>('create-passkey');
+const renameDialog = element<HTMLDialogElement>('rename-dialog');
+const deleteDialog = element<HTMLDialogElement>('delete-dialog');
+const nickname = element<HTMLInputElement>('passkey-name');
+const loginForm = element<HTMLFormElement>('login-form');
+let user: UserProfile | undefined;
+let credentials: StoredPasskeyCredential[] = [];
+let selected: StoredPasskeyCredential | undefined;
+let busy = false;
+class ApiError extends Error {
+  constructor(public status: number, message: string) { super(message); }
+}
+
+async function api<T>(path: string, method = 'GET', body?: unknown): Promise<T> {
+  const response = await fetch(path, {
+    method, credentials: 'same-origin', cache: 'no-store',
+    headers: body === undefined ? undefined : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data: unknown = await response.json().catch(() => null);
+  if (!response.ok) {
+    const message = data && typeof data === 'object' && 'error' in data && typeof data.error === 'string' ? data.error : 'Unable to reach your account. Please try again.';
+    throw new ApiError(response.status, message);
+  }
+  return data as T;
+}
+function message(text: string, error = false) {
+  status.textContent = text;
+  status.dataset.error = String(error);
+}
+function errorMessage(error: unknown): string {
+  if (error instanceof ApiError && error.status === 401) {
+    content.hidden = true;
+    loginForm.hidden = false;
+    user = undefined;
+    list.replaceChildren();
+  }
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
+function setBusy(value: boolean) {
+  busy = value;
+  document.querySelectorAll<HTMLButtonElement>('.account-panel button, dialog button').forEach(button => { button.disabled = value; });
+  profileForm.querySelectorAll<HTMLInputElement>('input').forEach(input => { input.disabled = value; });
+}
+
+/** IDs are already Base64URL at the API boundary; never encode them a second time. */
+function validateId(value: string): string {
+  if (!/^[A-Za-z0-9_-]+$/.test(value) || value.length % 4 === 1) throw new Error('Invalid Base64URL identifier.');
+  return value;
+}
+async function syncAcceptedCredentials(current: StoredPasskeyCredential[]) {
+  if (!user || typeof window.PublicKeyCredential === 'undefined' || typeof PublicKeyCredential.signalAllAcceptedCredentials !== 'function') return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: user.rpId, userId: validateId(user.id),
+      allAcceptedCredentialIds: current.map(credential => validateId(credential.id)),
+    });
+  } catch (error) {
+    console.warn('Accepted credential synchronization failed:', error);
+    syncStatus.textContent = 'Your account is up to date, but your password manager could not be synchronized. Reload this page to retry.';
+  }
+}
+const dateFormatter = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+function dateLabel(value: number): string {
+  return Number.isFinite(value) && !Number.isNaN(new Date(value).getTime()) ? dateFormatter.format(new Date(value)) : 'Date unavailable';
+}
+function appendDate(parent: HTMLElement, label: string, value: number | null) {
+  const line = document.createElement('p');
+  line.append(`${label}: `);
+  if (value === null || value === undefined) line.append('Never used');
+  else {
+    const time = document.createElement('time');
+    time.textContent = dateLabel(value);
+    if (Number.isFinite(value) && !Number.isNaN(new Date(value).getTime())) time.dateTime = new Date(value).toISOString();
+    line.append(time);
+  }
+  parent.append(line);
+}
+function renderCredentials(current: StoredPasskeyCredential[]) {
+  credentials = current;
+  list.replaceChildren();
+  element('empty-passkeys').hidden = current.length > 0;
+  for (const credential of current) {
+    const provider = resolveProvider(credential.aaguid);
+    const title = credential.name || provider.name;
+    const row = document.createElement('li');
+    row.className = 'credential-row';
+    row.dataset.credentialId = credential.id;
+    if (provider.icon_light) {
+      const icon = document.createElement('img');
+      icon.className = 'provider-icon';
+      icon.src = provider.icon_light;
+      icon.alt = `${provider.name} icon`;
+      row.append(icon);
+    } else {
+      const icon = document.createElement('span');
+      icon.className = 'provider-fallback';
+      icon.textContent = '⚿';
+      icon.setAttribute('aria-hidden', 'true');
+      row.append(icon);
+    }
+    const info = document.createElement('div');
+    info.className = 'credential-info';
+    const heading = document.createElement('h4');
+    heading.textContent = title;
+    info.append(heading);
+    const details = document.createElement('div');
+    details.className = 'credential-details';
+    if (credential.name) {
+      const providerName = document.createElement('p');
+      providerName.textContent = provider.name;
+      details.append(providerName);
+    }
+    appendDate(details, 'Registered', credential.registeredAt);
+    appendDate(details, 'Last used', credential.lastUsedAt);
+    info.append(details);
+    row.append(info);
+    const actions = document.createElement('div');
+    actions.className = 'credential-actions';
+    const rename = document.createElement('button');
+    rename.type = 'button';
+    rename.className = 'secondary';
+    rename.textContent = 'Rename';
+    rename.disabled = busy;
+    rename.setAttribute('aria-label', `Rename ${title}`);
+    rename.addEventListener('click', () => {
+      selected = credential;
+      nickname.value = title;
+      element('rename-error').textContent = '';
+      renameDialog.showModal();
+      nickname.focus();
+      nickname.select();
+    });
+    const remove = document.createElement('button');
+    remove.type = 'button';
+    remove.className = 'danger';
+    remove.textContent = 'Delete';
+    remove.disabled = busy;
+    remove.setAttribute('aria-label', `Delete ${title}`);
+    remove.addEventListener('click', () => {
+      selected = credential;
+      element('delete-description').textContent = `Remove “${title}” from your account?`;
+      element('delete-error').textContent = '';
+      deleteDialog.showModal();
+      element('cancel-delete').focus();
+    });
+    actions.append(rename, remove);
+    row.append(actions);
+    list.append(row);
+  }
+}
+
+async function checkCapabilities() {
+  createButton.hidden = true;
+  let supported = false;
+  try {
+    if (typeof window.PublicKeyCredential !== 'undefined') {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      supported = capabilities.passkeyPlatformAuthenticator === true || capabilities.userVerifyingPlatformAuthenticator === true;
+    }
+  } catch (error) { console.warn('Passkey capabilities unavailable:', error); }
+  createButton.hidden = !supported;
+  element('passkey-fallback').hidden = supported;
+}
+async function loadManagementPanel() {
+  if (busy) return;
+  setBusy(true);
+  message('Loading your account…');
+  syncStatus.textContent = '';
+  element('retry-load').hidden = true;
+  try {
+    user = await api<UserProfile>('/api/user');
+    const current = await api<StoredPasskeyCredential[]>('/api/credentials');
+    username.value = user.name;
+    displayName.value = user.displayName;
+    renderCredentials(current);
+    loginForm.hidden = true;
+    content.hidden = false;
+    message('');
+    await syncAcceptedCredentials(current);
+  } catch (error) {
+    message(errorMessage(error), true);
+    element('retry-load').hidden = false;
+  } finally { setBusy(false); }
+}
+
+element('retry-load').addEventListener('click', () => void loadManagementPanel());
+element('cancel-rename').addEventListener('click', () => renameDialog.close());
+element('cancel-delete').addEventListener('click', () => deleteDialog.close());
+for (const dialog of [renameDialog, deleteDialog]) dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+
+element<HTMLFormElement>('rename-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (!selected || busy) return;
+  const name = nickname.value.trim();
+  if (!name) { element('rename-error').textContent = 'Enter a passkey nickname.'; return; }
+  setBusy(true);
+  try {
+    const updated = await api<StoredPasskeyCredential>(`/api/credential/${encodeURIComponent(selected.id)}`, 'PUT', { name });
+    renderCredentials(credentials.map(credential => credential.id === updated.id ? updated : credential));
+    renameDialog.close();
+    // A nickname is only a server label, not an account profile change.
+    message('Passkey nickname saved.');
+  } catch (error) { element('rename-error').textContent = errorMessage(error); }
+  finally { setBusy(false); }
+});
+
+element<HTMLFormElement>('delete-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  if (!selected || busy) return;
+  setBusy(true);
+  let deleted = false;
+  syncStatus.textContent = '';
+  try {
+    await api(`/api/credential/${encodeURIComponent(selected.id)}`, 'DELETE');
+    deleted = true;
+    renderCredentials(credentials.filter(credential => credential.id !== selected?.id));
+    deleteDialog.close();
+    // Refetch the authoritative complete list, including changes from other tabs.
+    const remaining = await api<StoredPasskeyCredential[]>('/api/credentials');
+    renderCredentials(remaining);
+    await syncAcceptedCredentials(remaining);
+    message('Passkey deleted.');
+  } catch (error) {
+    if (deleted) {
+      message(`Passkey deleted, but the updated list could not be loaded. ${errorMessage(error)}`, true);
+      element('retry-load').hidden = false;
+    } else element('delete-error').textContent = errorMessage(error);
+  } finally { setBusy(false); }
+});
+
+profileForm.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy || !user) return;
+  const name = username.value.trim();
+  const newDisplayName = displayName.value.trim();
+  if (!name || !newDisplayName) { message('Enter both a username and a display name.', true); return; }
+  setBusy(true);
+  syncStatus.textContent = '';
+  try {
+    user = await api<UserProfile>('/api/user', 'PUT', { name, displayName: newDisplayName });
+    username.value = user.name;
+    displayName.value = user.displayName;
+    message('Profile saved.');
+    if (typeof window.PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.signalCurrentUserDetails === 'function') {
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({ rpId: user.rpId, userId: validateId(user.id), name: user.name, displayName: user.displayName });
+      } catch (error) {
+        console.warn('User details synchronization failed:', error);
+        syncStatus.textContent = 'Your profile was saved, but your password manager could not be updated. Save your profile again to retry.';
+      }
+    }
+  } catch (error) { message(errorMessage(error), true); }
+  finally { setBusy(false); }
+});
+
+createButton.addEventListener('click', async () => {
+  if (busy || !user || createButton.hidden) return;
+  setBusy(true);
+  syncStatus.textContent = '';
+  let saved = false;
+  try {
+    const options = await api<PublicKeyCredentialCreationOptionsJSON>('/api/registration/options', 'POST');
+    const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+    // Server options intentionally omit authenticatorSelection.authenticatorAttachment.
+    const result = await navigator.credentials.create({ publicKey });
+    if (!(result instanceof PublicKeyCredential)) throw new Error('Passkey creation was cancelled.');
+    await api('/api/registration/verify', 'POST', result.toJSON());
+    saved = true;
+    const current = await api<StoredPasskeyCredential[]>('/api/credentials');
+    renderCredentials(current);
+    await syncAcceptedCredentials(current);
+    message('Passkey created.');
+  } catch (error) {
+    const text = error instanceof DOMException && error.name === 'NotAllowedError' ? 'Passkey creation was cancelled or timed out. You can try again.' : errorMessage(error);
+    message(saved ? `Passkey created, but the list could not be refreshed. ${text}` : text, true);
+    if (saved) element('retry-load').hidden = false;
+  } finally { setBusy(false); }
+});
+
+loginForm.addEventListener('submit', async event => {
+  event.preventDefault();
+  if (busy) return;
+  setBusy(true);
+  try {
+    await api('/api/login', 'POST', { password: element<HTMLInputElement>('password').value });
+    element<HTMLInputElement>('password').value = '';
+    setBusy(false);
+    await loadManagementPanel();
+  } catch (error) { message(errorMessage(error), true); }
+  finally { setBusy(false); }
+});
+element('logout').addEventListener('click', async event => {
+  event.preventDefault();
+  if (busy) return;
+  setBusy(true);
+  try {
+    await api('/api/logout', 'POST');
+    user = undefined;
+    credentials = [];
+    list.replaceChildren();
+    content.hidden = true;
+    loginForm.hidden = false;
+    syncStatus.textContent = '';
+    message('You have signed out.');
+    location.hash = 'account';
+  } catch (error) { message(errorMessage(error), true); }
+  finally { setBusy(false); }
+});
+
+// Module scripts run after the document is parsed, including on /account.
+void checkCapabilities();
+void loadManagementPanel();
diff --git a/src/providers.ts b/src/providers.ts
new file mode 100644
index 0000000..8799900
--- /dev/null
+++ b/src/providers.ts
@@ -0,0 +1,10 @@
+import aaguids from './aaguids.json';
+
+interface Provider { name: string; icon_light?: string; icon_dark?: string }
+const registry: Record<string, Provider> = aaguids;
+export function resolveProvider(aaguid: string): Provider {
+  const id = aaguid.toLowerCase();
+  // A zero AAGUID deliberately reveals no provider; do not consult the registry.
+  if (id === '00000000-0000-0000-0000-000000000000') return { name: 'Unknown passkey provider' };
+  return Object.hasOwn(registry, id) ? registry[id] : { name: 'Unknown passkey provider' };
+}
