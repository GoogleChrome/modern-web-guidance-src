+  expect(calls.slice(-2)).toEqual(['DELETE /api/credential/c2Vjb25k', 'GET /api/credentials']);
+  await page.getByRole('button', { name: /^Delete Google/ }).click();
+  await page.getByRole('button', { name: 'Delete passkey', exact: true }).click();
+  await expect(page.locator('#empty-passkeys')).toBeVisible();
