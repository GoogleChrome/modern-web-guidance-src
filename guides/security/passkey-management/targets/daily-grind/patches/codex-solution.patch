@@ -0,0 +1,65 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createApp } from '../server/app';
+import { Store } from '../server/store';
+
+test('authenticated API enforces ownership, validates input, persists changes, and verifies registration', async () => {
+  const directory = mkdtempSync(join(tmpdir(), 'daily-grind-'));
+  const file = join(directory, 'account.json');
+  const store = new Store(file);
+  const userId = store.read().user.id;
+  store.update(db => {
+    for (const [id, owner] of [['b3duZWQ', userId], ['b3RoZXI', 'another-user']]) {
+      db.credentials.push({ id, passkeyUserId: owner, aaguid: '00000000-0000-0000-0000-000000000000', name: 'Saved key', registeredAt: 1704067200000, lastUsedAt: 1714564800000, publicKey: 'a2V5', counter: 0, deviceType: 'singleDevice', backedUp: false });
+    }
+  });
+  const origin = 'http://localhost:11222';
+  const server = createApp({ store, origin, demo: false, password: 'test-password' }).listen(0);
+  await new Promise<void>(resolve => server.once('listening', resolve));
+  const address = server.address();
+  assert(address && typeof address !== 'string');
+  const base = `http://localhost:${address.port}`;
+  let cookie = '';
+  const request = (path: string, method = 'GET', body?: unknown, requestOrigin = origin) => fetch(`${base}/api${path}`, { method, headers: { cookie, origin: requestOrigin, 'Content-Type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
+  try {
+    assert.equal((await request('/credentials')).status, 401);
+    assert.equal((await request('/login', 'POST', { password: 'bad' })).status, 401);
+    const login = await request('/login', 'POST', { password: 'test-password' });
+    assert.equal(login.status, 200);
+    cookie = login.headers.get('set-cookie')!.split(';')[0];
+    const list = await (await request('/credentials')).json();
+    assert.equal(list.length, 1);
+    assert.equal(list[0].id, 'b3duZWQ');
+    assert.equal(list[0].registeredAt, 1704067200000);
+    assert.equal(list[0].lastUsedAt, 1714564800000);
+    assert.equal(list[0].publicKey, undefined);
+    assert.equal((await request('/credential/b3RoZXI', 'DELETE')).status, 404);
+    assert.equal((await request('/credential/b3RoZXI', 'PUT', { name: 'stolen' })).status, 404);
+    assert.equal((await request('/credential/b3duZWQ', 'PUT', { name: '  ' })).status, 400);
+    assert.equal((await request('/credential/b3duZWQ', 'PUT', { name: 'Travel key' }, 'https://evil.example')).status, 403);
+    assert.equal((await request('/credential/b3duZWQ', 'PUT', { name: 'Travel key' })).status, 200);
+    assert.equal((await request('/user', 'PUT', { name: 'new-name', displayName: 'New Name' })).status, 200);
+    const persisted = new Store(file).read();
+    assert.equal(persisted.credentials[0].name, 'Travel key');
+    assert.equal(persisted.user.name, 'new-name');
+    assert.equal(persisted.user.id, userId);
+    const options = await (await request('/registration/options', 'POST')).json();
+    assert.equal(options.rp.id, 'localhost');
+    assert.equal(options.user.id, userId);
+    assert.equal(options.authenticatorSelection.authenticatorAttachment, undefined);
+    assert.equal(options.excludeCredentials.length, 1);
+    assert.equal((await request('/registration/verify', 'POST', {})).status, 400);
+    assert.equal((await request('/registration/verify', 'POST', {})).status, 400);
+    assert.equal((await request('/credential/b3duZWQ', 'DELETE')).status, 200);
+    assert.deepEqual(await (await request('/credentials')).json(), []);
+    assert.equal(new Store(file).read().credentials.length, 1);
+    assert.equal((await request('/logout', 'POST')).status, 200);
+    assert.equal((await request('/credentials')).status, 401);
+  } finally {
+    await new Promise<void>((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+    rmSync(directory, { recursive: true, force: true });
+  }
+});
