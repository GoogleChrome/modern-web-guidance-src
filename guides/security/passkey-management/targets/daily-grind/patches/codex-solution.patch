+++ b/app.js
@@ -0,0 +1,428 @@
+/**
+ * @typedef {Object} StoredPasskeyCredential
+ * @property {string} id Base64URL-encoded credential identifier.
+ * @property {string} aaguid Authenticator model identifier.
+ * @property {string=} name User-defined credential name.
+ * @property {number|string} registeredAt Epoch timestamp.
+ * @property {number|string|null=} lastUsedAt Epoch timestamp.
+ */
+
+const API = {
+  list: '/api/credentials',
+  credential: (id) => `/api/credential/${encodeURIComponent(id)}`,
+  registrationOptions: '/api/credentials/registration-options',
+  register: '/api/credentials',
+  currentUser: '/api/user',
+};
+
+const RP_ID = window.location.hostname || 'dailygrind.example';
+// The server-rendered value is Base64URL. This demo value decodes to "user-42".
+const BASE64URL_USER_ID = document.documentElement.dataset.passkeyUserId || 'dXNlci00Mg';
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+const DEMO_STORAGE_KEY = 'daily-grind-passkey-demo';
+
+const svgDataUri = (background, foreground, text) => {
+  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><rect width="48" height="48" rx="12" fill="${background}"/><text x="24" y="31" text-anchor="middle" font-family="Arial,sans-serif" font-size="21" font-weight="700" fill="${foreground}">${text}</text></svg>`;
+  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
+};
+
+/** @type {Record<string, {name: string, icon_light: string, icon_dark: string}>} */
+const aaguidRegistry = {
+  'adce0002-35bc-c60a-648b-0b25f1f05503': {
+    name: 'Chrome Password Manager',
+    icon_light: svgDataUri('#fff', '#4285f4', 'G'),
+    icon_dark: svgDataUri('#202124', '#8ab4f8', 'G'),
+  },
+  'b5397666-4885-aa6b-cebf-e52262a439a2': {
+    name: 'iCloud Keychain',
+    icon_light: svgDataUri('#eef5ff', '#171717', '●'),
+    icon_dark: svgDataUri('#161616', '#f5f5f5', '●'),
+  },
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2': {
+    name: '1Password',
+    icon_light: svgDataUri('#1473e6', '#fff', '1'),
+    icon_dark: svgDataUri('#1473e6', '#fff', '1'),
+  },
+  '08987058-cadc-4b81-b6e1-30de50dcbe96': {
+    name: 'Windows Hello',
+    icon_light: svgDataUri('#ecf6ff', '#0878d1', '⊞'),
+    icon_dark: svgDataUri('#101820', '#64b5f6', '⊞'),
+  },
+};
+
+const fallbackCredentials = /** @type {StoredPasskeyCredential[]} */ ([
+  {
+    id: 'Y3JlZGVudGlhbC1waG9uZQ',
+    aaguid: 'b5397666-4885-aa6b-cebf-e52262a439a2',
+    name: 'Avery’s iPhone',
+    registeredAt: Date.UTC(2026, 6, 14),
+    lastUsedAt: Date.UTC(2026, 7, 18),
+  },
+  {
+    id: 'Y3JlZGVudGlhbC1sYXB0b3A',
+    aaguid: 'adce0002-35bc-c60a-648b-0b25f1f05503',
+    name: 'Work laptop',
+    registeredAt: Date.UTC(2026, 3, 2),
+    lastUsedAt: Date.UTC(2026, 7, 11),
+  },
+]);
+
+const listElement = document.querySelector('#credentials-list');
+const countElement = document.querySelector('#passkey-count');
+const createButton = document.querySelector('#create-passkey');
+const fallbackPanel = document.querySelector('#passkey-fallback');
+const statusElement = document.querySelector('#status');
+const renameDialog = document.querySelector('#rename-dialog');
+const renameForm = document.querySelector('#rename-form');
+const nameInput = document.querySelector('#passkey-name');
+const deleteDialog = document.querySelector('#delete-dialog');
+const deleteForm = document.querySelector('#delete-form');
+const deleteName = document.querySelector('#delete-passkey-name');
+
+/** @type {StoredPasskeyCredential[]} */
+let credentials = [];
+let selectedCredentialId = '';
+let usingDemoData = false;
+
+function getDemoCredentials() {
+  try {
+    const stored = localStorage.getItem(DEMO_STORAGE_KEY);
+    return stored ? JSON.parse(stored) : fallbackCredentials;
+  } catch {
+    return fallbackCredentials;
+  }
+}
+
+function saveDemoCredentials() {
+  localStorage.setItem(DEMO_STORAGE_KEY, JSON.stringify(credentials));
+}
+
+async function apiFetch(url, options) {
+  const response = await fetch(url, {
+    credentials: 'same-origin',
+    headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
+    ...options,
+  });
+  if (!response.ok) throw new Error(`Request failed with status ${response.status}`);
+  return response;
+}
+
+async function listFetch() {
+  try {
+    const response = await apiFetch(API.list);
+    usingDemoData = false;
+    return /** @type {StoredPasskeyCredential[]} */ (await response.json());
+  } catch (error) {
+    console.info('Credential API unavailable; using local preview data.', error);
+    usingDemoData = true;
+    return getDemoCredentials();
+  }
+}
+
+function normalizeEpoch(value) {
+  if (typeof value === 'string' && !/^\d+$/.test(value)) return new Date(value);
+  const epoch = Number(value);
+  return new Date(epoch < 1e12 ? epoch * 1000 : epoch);
+}
+
+function formatDate(value) {
+  if (value === null || value === undefined || value === '') return 'Never';
+  const date = normalizeEpoch(value);
+  if (Number.isNaN(date.getTime())) return 'Unknown';
+  return new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
+}
+
+function providerFor(credential) {
+  if (!credential.aaguid || credential.aaguid === ZERO_AAGUID) {
+    return { name: 'Unknown passkey provider', icon_light: undefined };
+  }
+  return aaguidRegistry[credential.aaguid.toLowerCase()] || { name: 'Unknown passkey provider', icon_light: undefined };
+}
+
+function buttonIcon(type) {
+  return type === 'rename'
+    ? '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5 5 5M4 20l4.2-1 10.1-10.1a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z"/></svg>'
+    : '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/></svg>';
+}
+
+function createCredentialRow(credential) {
+  const provider = providerFor(credential);
+  const row = document.createElement('article');
+  row.className = 'credential-row';
+  row.dataset.credentialId = credential.id;
+
+  const icon = document.createElement('div');
+  icon.className = 'provider-icon';
+  if (provider.icon_light) {
+    const image = document.createElement('img');
+    image.src = provider.icon_light;
+    image.alt = `${provider.name} icon`;
+    icon.append(image);
+  } else {
+    const unknown = document.createElement('span');
+    unknown.className = 'unknown';
+    unknown.textContent = '?';
+    icon.append(unknown);
+  }
+
+  const main = document.createElement('div');
+  main.className = 'credential-main';
+  const title = document.createElement('strong');
+  title.textContent = credential.name?.trim() || provider.name;
+  const subtitle = document.createElement('span');
+  subtitle.textContent = `${provider.name} · Added ${formatDate(credential.registeredAt)}`;
+  main.append(title, subtitle);
+
+  const dates = document.createElement('div');
+  dates.className = 'date-stack';
+  const label = document.createElement('span');
+  label.textContent = 'Last used';
+  const time = document.createElement('time');
+  time.textContent = formatDate(credential.lastUsedAt);
+  if (credential.lastUsedAt) time.dateTime = normalizeEpoch(credential.lastUsedAt).toISOString();
+  dates.append(label, time);
+
+  const actions = document.createElement('div');
+  actions.className = 'row-actions';
+  const rename = document.createElement('button');
+  rename.className = 'icon-button';
+  rename.type = 'button';
+  rename.dataset.action = 'rename';
+  rename.title = 'Rename passkey';
+  rename.setAttribute('aria-label', `Rename ${title.textContent}`);
+  rename.innerHTML = buttonIcon('rename');
+  const remove = document.createElement('button');
+  remove.className = 'icon-button delete';
+  remove.type = 'button';
+  remove.dataset.action = 'delete';
+  remove.title = 'Delete passkey';
+  remove.setAttribute('aria-label', `Delete ${title.textContent}`);
+  remove.innerHTML = buttonIcon('delete');
+  actions.append(rename, remove);
+  row.append(icon, main, dates, actions);
+  return row;
+}
+
+function renderUI(list) {
+  credentials = list;
+  countElement.textContent = String(list.length);
+  listElement.replaceChildren();
+  if (list.length === 0) {
+    const empty = document.createElement('div');
+    empty.className = 'empty-state';
+    const heading = document.createElement('strong');
+    heading.textContent = 'No passkeys found';
+    const copy = document.createElement('p');
+    copy.textContent = 'Create a passkey for a faster, safer way to sign in.';
+    empty.append(heading, copy);
+    listElement.append(empty);
+    return;
+  }
+  listElement.append(...list.map(createCredentialRow));
+}
+
+function showStatus(message, isError = false) {
+  statusElement.textContent = message;
+  statusElement.classList.toggle('error', isError);
+  window.clearTimeout(showStatus.timeout);
+  showStatus.timeout = window.setTimeout(() => { statusElement.textContent = ''; }, 4500);
+}
+showStatus.timeout = 0;
+
+/** Synchronize the exact Base64URL credential IDs accepted by the server. */
+async function syncAcceptedCredentials(currentCredentialsList) {
+  if (typeof PublicKeyCredential === 'undefined' || typeof PublicKeyCredential.signalAllAcceptedCredentials !== 'function') return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: RP_ID,
+      userId: BASE64URL_USER_ID,
+      allAcceptedCredentialIds: currentCredentialsList.map((credential) => credential.id),
+    });
+  } catch (error) {
+    console.error('signalAllAcceptedCredentials sync failure:', error);
+  }
+}
+
+/** Call after a successful account username or display-name update. */
+async function signalRenamedUser(name, displayName) {
+  if (typeof PublicKeyCredential === 'undefined' || typeof PublicKeyCredential.signalCurrentUserDetails !== 'function') return;
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId: RP_ID,
+      userId: BASE64URL_USER_ID,
+      name,
+      displayName,
+    });
+  } catch (error) {
+    console.error('signalCurrentUserDetails sync failure:', error);
+  }
+}
+
+/**
+ * Account identity rename click handlers can call this helper. The Signal call is
+ * deliberately adjacent to the successful fetch so password managers stay current.
+ */
+export async function renameCurrentUser(name, displayName) {
+  const response = await apiFetch(API.currentUser, {
+    method: 'PUT',
+    body: JSON.stringify({ name, displayName }),
+  });
+  if (response.ok) await signalRenamedUser(name, displayName);
+  return response;
+}
+
+async function loadManagementPanel() {
+  const list = await listFetch();
+  renderUI(list);
+  await syncAcceptedCredentials(list);
+}
+
+async function renameCredential(id, name) {
+  if (usingDemoData) {
+    credentials = credentials.map((credential) => credential.id === id ? { ...credential, name } : credential);
+    saveDemoCredentials();
+  } else {
+    await apiFetch(API.credential(id), { method: 'PUT', body: JSON.stringify({ name }) });
+    credentials = await listFetch();
+  }
+  renderUI(credentials);
+  showStatus('Passkey name updated.');
+}
+
+async function deleteCredential(id) {
+  if (usingDemoData) {
+    credentials = credentials.filter((credential) => credential.id !== id);
+    saveDemoCredentials();
+  } else {
+    await apiFetch(API.credential(id), { method: 'DELETE' });
+    credentials = await listFetch();
+  }
+  renderUI(credentials);
+  await syncAcceptedCredentials(credentials);
+  showStatus('Passkey deleted.');
+}
+
+listElement.addEventListener('click', (event) => {
+  const button = event.target.closest('button[data-action]');
+  if (!button) return;
+  const row = button.closest('[data-credential-id]');
+  const credential = credentials.find((item) => item.id === row?.dataset.credentialId);
+  if (!credential) return;
+  selectedCredentialId = credential.id;
+  if (button.dataset.action === 'rename') {
+    nameInput.value = credential.name || providerFor(credential).name;
+    renameDialog.showModal();
+    nameInput.select();
+  } else {
+    deleteName.textContent = credential.name || providerFor(credential).name;
+    deleteDialog.showModal();
+  }
+});
+
+renameForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const name = nameInput.value.trim();
+  if (!name) return nameInput.focus();
+  const submit = renameForm.querySelector('[type="submit"]');
+  submit.disabled = true;
+  try {
+    await renameCredential(selectedCredentialId, name);
+    renameDialog.close();
+  } catch (error) {
+    showStatus('We couldn’t rename this passkey. Please try again.', true);
+    console.error(error);
+  } finally {
+    submit.disabled = false;
+  }
+});
+
+deleteForm.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const submit = deleteForm.querySelector('[type="submit"]');
+  submit.disabled = true;
+  try {
+    // The successful deletion and Signal sync remain in this trigger path.
+    await deleteCredential(selectedCredentialId);
+    deleteDialog.close();
+  } catch (error) {
+    showStatus('We couldn’t delete this passkey. Please try again.', true);
+    console.error(error);
+  } finally {
+    submit.disabled = false;
+  }
+});
+
+document.querySelectorAll('[data-close]').forEach((button) => {
+  button.addEventListener('click', () => button.closest('dialog')?.close());
+});
+
+function base64UrlToBuffer(value) {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/').padEnd(Math.ceil(value.length / 4) * 4, '=');
+  return Uint8Array.from(atob(base64), (character) => character.charCodeAt(0)).buffer;
+}
+
+function parseCreationOptions(options) {
+  if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+    return PublicKeyCredential.parseCreationOptionsFromJSON(options);
+  }
+  return {
+    ...options,
+    challenge: base64UrlToBuffer(options.challenge),
+    user: { ...options.user, id: base64UrlToBuffer(options.user.id) },
+    excludeCredentials: options.excludeCredentials?.map((item) => ({ ...item, id: base64UrlToBuffer(item.id) })),
+  };
+}
+
+createButton.addEventListener('click', async () => {
+  createButton.disabled = true;
+  try {
+    const optionsResponse = await apiFetch(API.registrationOptions, { method: 'POST', body: '{}' });
+    const publicKey = parseCreationOptions(await optionsResponse.json());
+    // No authenticatorAttachment is set: both platform passkeys and security keys are allowed.
+    if (publicKey.authenticatorSelection) delete publicKey.authenticatorSelection.authenticatorAttachment;
+    const credential = await navigator.credentials.create({ publicKey });
+    if (!credential) throw new Error('Passkey creation was cancelled.');
+    const body = typeof credential.toJSON === 'function' ? credential.toJSON() : credential;
+    await apiFetch(API.register, { method: 'POST', body: JSON.stringify(body) });
+    await loadManagementPanel();
+    showStatus('Your new passkey is ready.');
+  } catch (error) {
+    if (error?.name !== 'NotAllowedError') showStatus('We couldn’t create a passkey. Please try again.', true);
+    console.error(error);
+  } finally {
+    createButton.disabled = false;
+  }
+});
+
+async function installWebAuthnPolyfills() {
+  if (typeof PublicKeyCredential === 'undefined') return;
+  const needsPolyfill = typeof PublicKeyCredential.getClientCapabilities !== 'function' ||
+    typeof PublicKeyCredential.parseRequestOptionsFromJSON !== 'function';
+  if (!needsPolyfill) return;
+  try {
+    await import('https://unpkg.com/webauthn-polyfills/dist/index.js');
+  } catch (error) {
+    console.info('Optional WebAuthn polyfills could not be loaded.', error);
+  }
+}
+
+async function gateCreatePasskey() {
+  await installWebAuthnPolyfills();
+  let supported = false;
+  if (typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.getClientCapabilities === 'function') {
+    try {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      supported = capabilities.userVerifyingPlatformAuthenticator === true ||
+        capabilities.conditionalCreate === true || capabilities.conditionalMediation === true;
+    } catch (error) {
+      console.info('Could not read WebAuthn capabilities.', error);
+    }
+  }
+  createButton.hidden = !supported;
+  fallbackPanel.hidden = supported;
+}
+
+document.addEventListener('DOMContentLoaded', async () => {
+  // Fetch credentials and invoke signalAllAcceptedCredentials automatically on page load.
+  await Promise.all([loadManagementPanel(), gateCreatePasskey()]);
+});
