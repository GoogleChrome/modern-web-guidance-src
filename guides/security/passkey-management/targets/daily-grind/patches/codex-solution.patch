--- /dev/null
+++ b/styles.css
@@ -0,0 +1,117 @@
+:root {
+  --espresso: #39251d;
+  --espresso-2: #51382d;
+  --cream: #f8f5ef;
+  --paper: #fff;
+  --orange: #e96f32;
+  --orange-dark: #ca5520;
+  --orange-soft: #fff1e8;
+  --ink: #281d18;
+  --muted: #716761;
+  --line: #e7e1da;
+  --danger: #c73b36;
+  --shadow: 0 10px 28px rgba(58, 37, 29, .07);
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 320px; color: var(--ink); background: var(--cream); font-family: "DM Sans", system-ui, sans-serif; }
+button, input { font: inherit; }
+button, a { -webkit-tap-highlight-color: transparent; }
+a { color: inherit; }
+.app-shell { min-height: 100vh; display: grid; grid-template-columns: 274px 1fr; }
+
+.sidebar { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; background: var(--espresso); color: #fff; padding: 30px 22px 20px; }
+.brand { display: flex; align-items: center; gap: 12px; color: #fff; text-decoration: none; font: 800 15px/1 "Manrope", sans-serif; letter-spacing: .075em; }
+.brand-mark { width: 36px; height: 36px; flex: 0 0 36px; border-radius: 11px; display: grid; place-items: center; background: var(--orange); }
+.brand-mark svg { width: 28px; height: 28px; fill: #fff; color: #fff; }
+.side-nav { margin-top: 48px; display: flex; flex-direction: column; gap: 5px; }
+.nav-label { margin: 0 13px 8px; color: #aa9a91; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
+.nav-label.nav-section { margin-top: 26px; }
+.side-nav a { display: flex; align-items: center; gap: 12px; padding: 11px 13px; border-radius: 8px; color: #d8cdc7; text-decoration: none; font-size: 14px; font-weight: 500; }
+.side-nav a:hover { color: #fff; background: rgba(255,255,255,.06); }
+.side-nav a.active { color: #fff; background: rgba(233,111,50,.18); }
+.nav-icon { width: 20px; color: #a99991; text-align: center; font-size: 17px; }
+.active .nav-icon { color: #ff8c52; }
+.sidebar-footer { margin-top: auto; border-top: 1px solid rgba(255,255,255,.12); padding-top: 18px; }
+.user-menu { width: 100%; display: flex; align-items: center; gap: 10px; color: white; border: 0; background: transparent; text-align: left; cursor: pointer; padding: 5px; }
+.avatar { width: 38px; height: 38px; display: grid; place-items: center; background: #695248; border-radius: 50%; font-size: 12px; font-weight: 700; }
+.user-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; }
+.user-copy strong { font-size: 13px; }
+.user-copy small { color: #aa9a91; overflow: hidden; text-overflow: ellipsis; }
+
+main { min-width: 0; }
+.mobile-header { display: none; }
+.content { width: min(900px, calc(100% - 64px)); margin: 0 auto; padding: 42px 0 56px; }
+.breadcrumbs { display: flex; gap: 9px; align-items: center; color: #948983; font-size: 12px; margin-bottom: 34px; }
+.breadcrumbs a { text-decoration: none; }
+.breadcrumbs strong { color: var(--ink); font-weight: 600; }
+.page-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 30px; margin-bottom: 26px; }
+h1, h2, h3 { margin: 0; font-family: "Manrope", sans-serif; }
+h1 { font-size: clamp(30px, 4vw, 40px); letter-spacing: -.045em; line-height: 1.15; }
+.page-heading p, .card-header p { color: var(--muted); margin: 9px 0 0; font-size: 14px; }
+.primary-button, .secondary-button, .danger-button { border: 0; border-radius: 8px; min-height: 42px; padding: 0 17px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; cursor: pointer; font-weight: 700; font-size: 13px; transition: transform .15s, background .15s, box-shadow .15s; }
+.primary-button { color: #fff; background: var(--orange); box-shadow: 0 5px 13px rgba(233,111,50,.21); }
+.primary-button:hover { background: var(--orange-dark); transform: translateY(-1px); }
+.secondary-button { color: var(--ink); background: #fff; border: 1px solid var(--line); }
+.danger-button { color: #fff; background: var(--danger); }
+button:focus-visible, a:focus-visible, input:focus-visible { outline: 3px solid rgba(233,111,50,.3); outline-offset: 2px; }
+.status { min-height: 0; margin-bottom: 0; border-radius: 8px; font-size: 13px; transition: .2s; }
+.status:not(:empty) { min-height: 42px; padding: 11px 14px; margin-bottom: 16px; background: #eef8f0; color: #28663a; border: 1px solid #cce8d3; }
+.status.error:not(:empty) { background: #fff0ee; color: #8e302c; border-color: #f1cbc8; }
+
+.security-card { background: var(--paper); border: 1px solid var(--line); border-radius: 13px; box-shadow: var(--shadow); overflow: hidden; }
+.card-header { min-height: 100px; display: flex; align-items: center; justify-content: space-between; padding: 24px 28px; border-bottom: 1px solid var(--line); }
+.card-header h2 { font-size: 18px; }
+.count-badge { min-width: 28px; height: 28px; padding: 0 9px; display: grid; place-items: center; border-radius: 14px; background: #f1ede8; color: #665c56; font-size: 12px; font-weight: 700; }
+.credential-row { min-height: 105px; display: grid; grid-template-columns: 54px minmax(175px, 1fr) minmax(130px, .7fr) auto; align-items: center; gap: 18px; padding: 20px 28px; }
+.credential-row + .credential-row { border-top: 1px solid var(--line); }
+.provider-icon { width: 49px; height: 49px; border-radius: 12px; display: grid; place-items: center; background: #f2efeb; border: 1px solid #e7e0da; overflow: hidden; }
+.provider-icon img { width: 31px; height: 31px; object-fit: contain; }
+.provider-icon .unknown { color: #746963; font-size: 20px; font-weight: 800; }
+.credential-main { min-width: 0; }
+.credential-main strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: "Manrope", sans-serif; font-size: 14px; }
+.credential-main span, .date-stack span { display: block; margin-top: 5px; color: var(--muted); font-size: 12px; }
+.date-stack span { margin: 0 0 4px; }
+.date-stack time { font-size: 13px; font-weight: 600; }
+.row-actions { display: flex; gap: 7px; }
+.icon-button { width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 8px; background: #fff; color: #685d57; cursor: pointer; }
+.icon-button:hover { color: var(--orange-dark); border-color: #e7bda8; background: var(--orange-soft); }
+.icon-button.delete:hover { color: var(--danger); border-color: #e7b0ae; background: #fff1f0; }
+.icon-button svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
+.loading-row, .empty-state { min-height: 150px; display: flex; align-items: center; justify-content: center; gap: 12px; color: var(--muted); font-size: 14px; text-align: center; padding: 30px; }
+.empty-state { flex-direction: column; }
+.empty-state strong { color: var(--ink); font-family: "Manrope"; }
+.empty-state p { margin: 0; }
+.spinner { width: 18px; height: 18px; border: 2px solid #e3ddd8; border-top-color: var(--orange); border-radius: 50%; animation: spin .8s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+
+.fallback-card { margin-top: 18px; padding: 20px 22px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; border: 1px solid #ead6c9; border-radius: 11px; background: #fff9f4; }
+.fallback-card h2 { font-size: 15px; }.fallback-card p { margin: 4px 0 0; color: var(--muted); font-size: 13px; }.fallback-card a { color: var(--orange-dark); font-size: 13px; font-weight: 700; text-decoration: none; }
+.fallback-icon { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: var(--orange-soft); color: var(--orange-dark); font-weight: 800; }
+.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 18px; }
+.info-grid article { display: flex; gap: 15px; min-height: 108px; padding: 22px; border: 1px solid var(--line); border-radius: 11px; background: rgba(255,255,255,.55); }
+.info-grid h3 { font-size: 14px; }.info-grid p { color: var(--muted); margin: 6px 0 0; font-size: 12px; line-height: 1.55; }
+.info-icon { width: 34px; height: 34px; flex: 0 0 auto; display: grid; place-items: center; color: var(--orange-dark); background: var(--orange-soft); border-radius: 9px; font-size: 16px; }
+.help-line { margin: 27px 0 0; text-align: center; color: var(--muted); font-size: 12px; }.help-line a { color: var(--orange-dark); font-weight: 700; }
+
+.modal { width: min(430px, calc(100% - 32px)); border: 0; border-radius: 15px; padding: 0; color: var(--ink); box-shadow: 0 24px 70px rgba(37,23,17,.25); }
+.modal::backdrop { background: rgba(27,18,14,.55); backdrop-filter: blur(2px); }
+.modal form { padding: 30px; }
+.modal-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 11px; color: var(--orange-dark); background: var(--orange-soft); font-weight: 800; margin-bottom: 18px; }
+.modal-icon.danger { color: var(--danger); background: #fff0ee; }
+.modal h2 { font-size: 21px; }.modal p { color: var(--muted); font-size: 13px; line-height: 1.55; margin: 8px 0 21px; }.modal label { display: block; margin-bottom: 7px; font-size: 12px; font-weight: 700; }
+.modal input { width: 100%; height: 44px; padding: 0 12px; border: 1px solid #d7cec7; border-radius: 8px; color: var(--ink); }
+.modal-actions { display: flex; justify-content: flex-end; gap: 9px; margin-top: 25px; }
+
+@media (max-width: 760px) {
+  .app-shell { display: block; }.sidebar { display: none; }.mobile-header { height: 68px; padding: 0 20px; display: flex; align-items: center; justify-content: space-between; background: var(--espresso); }.mobile-header .icon-button { color: white; border-color: rgba(255,255,255,.2); background: transparent; }
+  .content { width: min(100% - 32px, 620px); padding: 28px 0 42px; }.breadcrumbs { margin-bottom: 25px; }.page-heading { align-items: flex-start; flex-direction: column; gap: 18px; }.page-heading .primary-button { width: 100%; }
+  .credential-row { grid-template-columns: 49px 1fr auto; gap: 13px; padding: 19px 18px; }.date-stack { grid-column: 2 / -1; display: flex; gap: 5px; align-items: baseline; margin-top: -8px; }.date-stack span::after { content: ":"; }.row-actions { grid-column: 3; grid-row: 1; }
+  .card-header { padding: 22px 19px; }.info-grid { grid-template-columns: 1fr; }.fallback-card { grid-template-columns: auto 1fr; }.fallback-card a { grid-column: 2; }
+}
+
+@media (max-width: 430px) {
+  .brand { font-size: 13px; }.brand-mark { width: 32px; height: 32px; flex-basis: 32px; }.credential-row { grid-template-columns: 42px 1fr; }.provider-icon { width: 42px; height: 42px; }.row-actions { grid-column: 2; grid-row: 3; }.date-stack { grid-column: 2; }.modal form { padding: 24px; }
+}
+
+@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
