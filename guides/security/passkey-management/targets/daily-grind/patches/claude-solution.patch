diff --git a/public/account.html b/public/account.html
new file mode 100644
index 0000000..76e6d7d
--- /dev/null
+++ b/public/account.html
@@ -0,0 +1,271 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+    }
+
+    nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      top: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    nav ul {
+      display: flex;
+      list-style: none;
+    }
+
+    nav ul li {
+      margin-left: 20px;
+    }
+
+    nav a {
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    nav a:hover {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    .container {
+      max-width: 760px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    h1 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    section {
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      padding: 24px;
+      margin-top: 24px;
+    }
+
+    section h2 {
+      color: var(--primary);
+      margin-bottom: 16px;
+    }
+
+    .field {
+      margin-bottom: 14px;
+      display: flex;
+      flex-direction: column;
+      gap: 4px;
+    }
+
+    label {
+      font-size: 0.85rem;
+      font-weight: bold;
+    }
+
+    input[type="text"] {
+      padding: 8px 10px;
+      border: 1px solid var(--secondary);
+      border-radius: 4px;
+      font-size: 1rem;
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border: none;
+      border-radius: 5px;
+      margin-top: 10px;
+      margin-right: 10px;
+      font-size: 0.95rem;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    .btn.secondary {
+      background: var(--secondary);
+      color: var(--text);
+    }
+
+    #credential-list {
+      list-style: none;
+    }
+
+    .credential-row {
+      display: flex;
+      align-items: center;
+      gap: 14px;
+      padding: 14px 0;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .credential-row:last-child {
+      border-bottom: none;
+    }
+
+    .provider-icon {
+      width: 36px;
+      height: 36px;
+      border-radius: 50%;
+      flex-shrink: 0;
+    }
+
+    .credential-info {
+      flex: 1;
+      min-width: 0;
+    }
+
+    .credential-name {
+      font-weight: bold;
+    }
+
+    .credential-dates {
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
+    .credential-actions {
+      display: flex;
+      gap: 8px;
+      flex-shrink: 0;
+    }
+
+    .credential-actions button {
+      padding: 6px 12px;
+      border-radius: 4px;
+      border: 1px solid var(--primary);
+      background: white;
+      color: var(--primary);
+      cursor: pointer;
+      font-size: 0.85rem;
+    }
+
+    .credential-actions button.danger {
+      border-color: #b71c1c;
+      color: #b71c1c;
+    }
+
+    #empty-state {
+      color: #6d4c41;
+      font-style: italic;
+    }
+
+    #mfa-fallback {
+      color: #6d4c41;
+      font-size: 0.9rem;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+  </style>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account.html">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <main class="container">
+    <h1>My Account</h1>
+    <p>Manage your profile details and the passkeys registered to your account.</p>
+
+    <section aria-labelledby="profile-heading">
+      <h2 id="profile-heading">Profile</h2>
+      <form id="user-form">
+        <div class="field">
+          <label for="user-name">Username</label>
+          <input type="text" id="user-name" name="name" autocomplete="username" required>
+        </div>
+        <div class="field">
+          <label for="user-display-name">Display name</label>
+          <input type="text" id="user-display-name" name="displayName" autocomplete="name" required>
+        </div>
+        <button type="submit" class="btn">Save profile</button>
+      </form>
+    </section>
+
+    <section aria-labelledby="passkeys-heading">
+      <h2 id="passkeys-heading">Passkeys</h2>
+
+      <ul id="credential-list"></ul>
+      <p id="empty-state" hidden>No passkeys found.</p>
+
+      <button id="create-passkey" type="button" class="btn" hidden>Create passkey</button>
