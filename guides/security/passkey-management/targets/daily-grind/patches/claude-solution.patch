+/**
+ * Optional Node backend for the passkey management endpoints.
+ *
+ *   npm install && node server/index.js
+ *
+ * The storefront also runs as pure static files (`npm start`), in which case
+ * `js/dev-backend.js` answers the same routes from the browser.
+ */
+import express from 'express';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import * as db from './db.js';
+import { createCredentialRoutes } from './routes.js';
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
+const PORT = Number(process.env.PORT ?? 11222);
+const RP_ID = process.env.RP_ID ?? 'localhost';
+const RP_NAME = 'The Daily Grind';
+const ORIGIN = process.env.ORIGIN ?? `http://${RP_ID}:${PORT}`;
+
+const DEMO_USER = {
+  id: Buffer.from('user-8f21c47a').toString('base64url'),
+  name: 'ava.martinez@example.com',
+  displayName: 'Ava Martinez',
+};
+
+if (!db.findUserById(DEMO_USER.id)) {
+  db.saveUser(DEMO_USER);
+}
+
+/** Replace with your real session middleware. */
+function checkUserAuthenticated(req, res, next) {
+  req.user = db.findUserById(DEMO_USER.id) ?? DEMO_USER;
+  if (!req.user) {
+    return res.status(401).json({ error: 'Sign in required.' });
+  }
+  return next();
+}
+
+const app = express();
+app.use(express.json());
+app.use(
+  createCredentialRoutes({
+    rpId: RP_ID,
+    rpName: RP_NAME,
+    origin: ORIGIN,
+    checkUserAuthenticated,
+  }),
+);
+app.use(express.static(ROOT));
+
+app.listen(PORT, () => {
+  console.log(`The Daily Grind is running on ${ORIGIN}`);
+});
