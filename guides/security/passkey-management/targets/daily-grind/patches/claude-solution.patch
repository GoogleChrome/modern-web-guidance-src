diff --git a/src/client/main.ts b/src/client/main.ts
new file mode 100644
index 0000000..2233dd1
--- /dev/null
+++ b/src/client/main.ts
@@ -0,0 +1,165 @@
+// Ensures PublicKeyCredential.getClientCapabilities and
+// PublicKeyCredential.prototype.toJSON / parseRequestOptionsFromJSON exist
+// in browsers that haven't shipped them natively yet.
+import 'webauthn-polyfills';
+
+import { deleteFetch, fetchCredentialList, fetchCurrentUser, renameCredentialFetch, updateUserFetch } from './api.js';
+import { resolveAaguidProvider } from './aaguidLookup.js';
+import { formatTimestamp } from './format.js';
+import { isPlatformPasskeySupported, createPasskeyCredential, credentialRawIdToBase64url } from './registration.js';
+import { syncAllAcceptedCredentials, syncCurrentUserDetails } from './webauthnSignals.js';
+import type { AccountUser, PasskeyCredential } from './types.js';
+
+const listEl = document.getElementById('credential-list') as HTMLElement;
+const emptyStateEl = document.getElementById('empty-state') as HTMLElement;
+const createButton = document.getElementById('create-passkey') as HTMLButtonElement;
+const createSecurityKeyButton = document.getElementById('create-security-key') as HTMLButtonElement;
+const mfaFallbackEl = document.getElementById('mfa-fallback') as HTMLElement;
+const userForm = document.getElementById('user-form') as HTMLFormElement;
+const userNameInput = document.getElementById('user-name') as HTMLInputElement;
+const userDisplayNameInput = document.getElementById('user-display-name') as HTMLInputElement;
+
+let currentUser: AccountUser | undefined;
+
+function renderCredentialRow(cred: PasskeyCredential, iconUrl: string | undefined): HTMLLIElement {
+  const li = document.createElement('li');
+  li.className = 'credential-row';
+  li.dataset.credentialId = cred.id;
+
+  const icon = document.createElement('img');
+  icon.className = 'provider-icon';
+  icon.alt = '';
+  icon.src = iconUrl ?? cred.providerIcon ?? '';
+  icon.hidden = !icon.src;
+
+  const info = document.createElement('div');
+  info.className = 'credential-info';
+
+  const name = document.createElement('p');
+  name.className = 'credential-name';
+  name.textContent = cred.name;
+
+  const dates = document.createElement('p');
+  dates.className = 'credential-dates';
+  dates.textContent = `Registered ${formatTimestamp(cred.registeredAt)} · Last used ${formatTimestamp(cred.lastUsedAt)}`;
+
+  info.append(name, dates);
+
+  const actions = document.createElement('div');
+  actions.className = 'credential-actions';
+
+  const renameBtn = document.createElement('button');
+  renameBtn.type = 'button';
+  renameBtn.textContent = 'Rename';
+  renameBtn.addEventListener('click', () => handleRename(cred));
+
+  const deleteBtn = document.createElement('button');
+  deleteBtn.type = 'button';
+  deleteBtn.className = 'danger';
+  deleteBtn.textContent = 'Delete';
+  deleteBtn.addEventListener('click', () => handleDelete(cred.id));
+
+  actions.append(renameBtn, deleteBtn);
+  li.append(icon, info, actions);
+  return li;
+}
+
+async function renderCredentialList(credentials: PasskeyCredential[]): Promise<void> {
+  listEl.innerHTML = '';
+  emptyStateEl.hidden = credentials.length > 0;
+
+  const resolved = await Promise.all(
+    credentials.map((cred) => resolveAaguidProvider(cred.aaguid).then((provider) => provider.providerIcon)),
+  );
+
+  credentials.forEach((cred, index) => {
+    listEl.appendChild(renderCredentialRow(cred, resolved[index]));
+  });
+}
+
+async function loadManagementPanel(): Promise<void> {
+  const [credentials, user] = await Promise.all([fetchCredentialList(), fetchCurrentUser()]);
+  currentUser = user;
+  userNameInput.value = user.name;
+  userDisplayNameInput.value = user.displayName;
+
+  await renderCredentialList(credentials);
+  // Sync accepted credentials on initial page load, per the Signal API spec.
+  await syncAllAcceptedCredentials(
+    user.id,
+    credentials.map((c) => c.id),
+  );
+}
+
+async function handleDelete(credentialId: string): Promise<void> {
+  const response = await deleteFetch(credentialId);
+  if (!response.ok || !currentUser) return;
+
+  const updatedList = await fetchCredentialList();
+  await renderCredentialList(updatedList);
+  // Sync remaining accepted credentials immediately after deletion.
+  await syncAllAcceptedCredentials(
+    currentUser.id,
+    updatedList.map((c) => c.id),
+  );
+}
+
+// Renaming a passkey's nickname is a server-side label change only; it does
+// NOT invoke signalCurrentUserDetails.
+async function handleRename(cred: PasskeyCredential): Promise<void> {
+  const newName = window.prompt('Rename passkey', cred.name);
+  if (!newName || !newName.trim() || newName === cred.name) return;
+
+  const response = await renameCredentialFetch(cred.id, { name: newName.trim() });
+  if (!response.ok) return;
+
+  await renderCredentialList(await fetchCredentialList());
+}
+
+async function handleUserRename(event: SubmitEvent): Promise<void> {
+  event.preventDefault();
+  if (!currentUser) return;
+
+  const updatedName = userNameInput.value.trim();
+  const updatedDisplayName = userDisplayNameInput.value.trim();
+  if (!updatedName || !updatedDisplayName) return;
+
+  const response = await updateUserFetch({ name: updatedName, displayName: updatedDisplayName });
+  if (!response.ok) return;
+
+  currentUser = { ...currentUser, name: updatedName, displayName: updatedDisplayName };
+  // Synchronize the renamed account details with the password manager.
+  await syncCurrentUserDetails(currentUser.id, updatedName, updatedDisplayName);
+}
+
+async function handleCreatePasskey(attachment: AuthenticatorAttachment | undefined): Promise<void> {
+  if (!currentUser) return;
+  try {
+    // A real deployment fetches this challenge from a server-generated
+    // registration-options endpoint; a random client challenge stands in
+    // here since that endpoint is outside this management UI's scope.
+    const challenge = crypto.getRandomValues(new Uint8Array(32)).buffer;
+    const credential = await createPasskeyCredential(currentUser, challenge, attachment);
+    console.log('Registered new credential:', credentialRawIdToBase64url(credential));
+    await loadManagementPanel();
+  } catch (e) {
+    console.error('Passkey registration failed:', e);
+  }
+}
+
+async function initializeCreateButtons(): Promise<void> {
+  const supported = await isPlatformPasskeySupported();
+  createButton.hidden = !supported;
+  createSecurityKeyButton.hidden = !supported;
+  mfaFallbackEl.hidden = supported;
+}
+
+createButton.addEventListener('click', () => handleCreatePasskey('platform'));
+// Omitting authenticatorAttachment allows registering a roaming security key.
+createSecurityKeyButton.addEventListener('click', () => handleCreatePasskey(undefined));
+userForm.addEventListener('submit', handleUserRename);
+
+window.addEventListener('DOMContentLoaded', () => {
+  void loadManagementPanel();
+  void initializeCreateButtons();
+});
diff --git a/src/client/registration.ts b/src/client/registration.ts
