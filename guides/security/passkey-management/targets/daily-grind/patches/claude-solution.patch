--- /dev/null
+++ b/js/session-sync.js
@@ -0,0 +1,27 @@
+/**
+ * Site-wide page-load synchronization: every page fetches the signed-in user's
+ * accepted credentials and reports them to the password manager, so revoked
+ * passkeys disappear from the vault even if the user never opens settings.
+ */
+import { getSession, listCredentials } from './api.js';
+import { installDevBackend } from './dev-backend.js';
+import { ensureWebAuthnPolyfills } from './polyfills.js';
+import { signalAcceptedCredentials } from './signals.js';
+
+installDevBackend();
+
+async function syncAcceptedCredentialsOnLoad() {
+  try {
+    await ensureWebAuthnPolyfills();
+    const [{ user, rpId }, credentials] = await Promise.all([getSession(), listCredentials()]);
+    await signalAcceptedCredentials({
+      rpId: rpId ?? window.location.hostname,
+      userId: user.id,
+      credentials,
+    });
+  } catch (error) {
+    console.error('Page load credential sync failed:', error);
+  }
+}
+
+document.addEventListener('DOMContentLoaded', syncAcceptedCredentialsOnLoad);
diff --git a/js/signals.js b/js/signals.js
new file mode 100644
