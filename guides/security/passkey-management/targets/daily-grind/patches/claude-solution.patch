@@ -0,0 +1,140 @@
+/**
+ * Credential CRUD + registration endpoints consumed by `js/api.js`.
+ * The static demo mirrors these responses in `js/dev-backend.js`.
+ */
+import { Router } from 'express';
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+} from '@simplewebauthn/server';
+import * as db from './db.js';
+import { resolveProvider } from './aaguid.js';
+
+export function createCredentialRoutes({ rpId, rpName, origin, checkUserAuthenticated }) {
+  const router = Router();
+  const challenges = new Map();
+
+  router.get('/api/session', checkUserAuthenticated, (req, res) => {
+    const user = db.findUserById(req.user.id) ?? req.user;
+    return res.json({
+      user: { id: user.id, name: user.name, displayName: user.displayName },
+      rpId,
+      rpName,
+    });
+  });
+
+  router.get('/api/credentials', checkUserAuthenticated, async (req, res) => {
+    const list = await db.findCredentialsByUserId(req.user.id);
+    return res.json(list);
+  });
+
+  router.put('/api/user', checkUserAuthenticated, async (req, res) => {
+    const { name, displayName } = req.body ?? {};
+    const user = db.findUserById(req.user.id) ?? req.user;
+    user.name = name?.trim() || user.name;
+    user.displayName = displayName?.trim() || user.displayName;
+    await db.saveUser(user);
+    return res.json({ id: user.id, name: user.name, displayName: user.displayName });
+  });
+
+  router.put('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+    const { id } = req.params;
+    const { name } = req.body ?? {};
+    if (!name?.trim()) {
+      return res.status(400).json({ error: 'A credential name is required.' });
+    }
+    const cred = await db.findCredentialById(id);
+    if (!cred || cred.passkeyUserId !== req.user.id) {
+      return res.status(404).json({ error: 'Credential not found.' });
+    }
+    cred.name = name.trim();
+    await db.saveCredential(cred);
+    return res.json(cred);
+  });
+
+  router.delete('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+    const { id } = req.params;
+    const cred = await db.findCredentialById(id);
+    if (!cred || cred.passkeyUserId !== req.user.id) {
+      return res.status(404).json({ error: 'Credential not found.' });
+    }
+    await db.deleteCredential(id);
+    return res.json({ success: true });
+  });
+
+  router.post('/api/registration/options', checkUserAuthenticated, async (req, res) => {
+    const user = db.findUserById(req.user.id) ?? req.user;
+    const excludeCredentials = (await db.findCredentialsByUserId(user.id)).map((credential) => ({
+      id: credential.id,
+      transports: credential.transports,
+    }));
+
+    const authenticatorSelection = {
+      residentKey: 'required',
+      userVerification: 'preferred',
+    };
+    // Security keys are enrolled by leaving `authenticatorAttachment` unset.
+    if (req.body?.attachment) {
+      authenticatorSelection.authenticatorAttachment = req.body.attachment;
+    }
+
+    const options = await generateRegistrationOptions({
+      rpID: rpId,
+      rpName,
+      userID: Buffer.from(user.id, 'base64url'),
+      userName: user.name,
+      userDisplayName: user.displayName,
+      attestationType: 'none',
+      excludeCredentials,
+      authenticatorSelection,
+    });
+
+    challenges.set(user.id, options.challenge);
+    return res.json(options);
+  });
+
+  router.post('/api/registration/verify', checkUserAuthenticated, async (req, res) => {
+    const user = db.findUserById(req.user.id) ?? req.user;
+    const expectedChallenge = challenges.get(user.id);
+    if (!expectedChallenge) {
+      return res.status(400).json({ error: 'No registration in progress.' });
+    }
+    challenges.delete(user.id);
+
+    let verification;
+    try {
+      verification = await verifyRegistrationResponse({
+        response: req.body,
+        expectedChallenge,
+        expectedOrigin: origin,
+        expectedRPID: rpId,
+      });
+    } catch (error) {
+      return res.status(400).json({ error: error.message });
+    }
+
+    if (!verification.verified) {
+      return res.status(400).json({ error: 'Registration could not be verified.' });
+    }
+
+    const { credential, aaguid } = verification.registrationInfo;
+    const { name, providerIcon } = resolveProvider(aaguid, req.get('user-agent'));
+
+    const stored = {
+      id: credential.id,
+      passkeyUserId: user.id,
+      publicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      counter: credential.counter,
+      transports: credential.transports ?? [],
+      aaguid,
+      name,
+      providerIcon,
+      registeredAt: Date.now(),
+      lastUsedAt: Date.now(),
+    };
+    await db.saveCredential(stored);
+    return res.status(201).json(stored);
+  });
+
+  return router;
+}
