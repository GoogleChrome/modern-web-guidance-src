@@ -0,0 +1,61 @@
+/**
+ * Regenerates js/aaguids.json from the community passkey AAGUID registry.
+ *
+ * Usage: node scripts/build-aaguids.mjs
+ *
+ * The upstream file is ~7 MB because it embeds every authenticator icon as a
+ * data URI, so we ship only the providers our users actually register with.
+ */
+import { writeFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+const SOURCE =
+  'https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json';
+
+const KEEP = [
+  'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4', // Google Password Manager
+  'fbfc3007-154e-4ecc-8c0b-6e020557d7bd', // Apple Passwords
+  'dd4ec289-e01d-41c9-bb89-70fa845d4bf2', // iCloud Keychain (Managed)
+  '08987058-cadc-4b81-b6e1-30de50dcbe96', // Windows Hello
+  '9ddd1817-af5a-4672-a2b9-3e3dd95000a9', // Windows Hello
+  '6028b017-b1d4-4c02-b4b3-afcdafc96bb2', // Windows Hello
+  'adce0002-35bc-c60a-648b-0b25f1f05503', // Chrome on Mac
+  '771b48fd-d3d4-4f74-9232-fc157ab0507a', // Edge on Mac
+  '53414d53-554e-4700-0000-000000000000', // Samsung Pass
+  'bada5566-a7aa-401f-bd96-45619a55120d', // 1Password
+  'd548826e-79b4-db40-a3d8-11116f7e8349', // Bitwarden
+  '531126d6-e717-415c-9320-3d9aa6981239', // Dashlane
+  'b84e4048-15dc-4dd0-8640-f4f60813c8af', // NordPass
+  '0ea242b4-43c4-4a1b-8b17-dd6d0b6baec6', // Keeper
+  'f3809540-7f14-49c1-a8b3-8f813b225541', // Enpass
+  '50726f74-6f6e-5061-7373-50726f746f6e', // Proton Pass
+  'fa2b99dc-9e39-4257-8f92-4a30d23c4118', // YubiKey 5 Series with NFC
+  'cb69481e-8ff7-4039-93ec-0a2729a154a8', // YubiKey 5 Series
+  'd8522d9f-575b-4866-88a9-ba99fa02f35b', // YubiKey Bio Series - FIDO Edition
+  'b7d3f68e-88a6-471e-9ecf-2df26d041ede', // Security Key NFC by Yubico
+  '42b4fb4a-2866-43b2-9bf7-6c6669c2e5d3', // Google Titan Security Key v2
+];
+
+const response = await fetch(SOURCE);
+if (!response.ok) {
+  throw new Error(`Registry download failed: ${response.status}`);
+}
+const registry = await response.json();
+
+const trimmed = {};
+for (const aaguid of KEEP) {
+  const entry = registry[aaguid];
+  if (!entry) {
+    console.warn(`Skipping ${aaguid}: not present upstream`);
+    continue;
+  }
+  trimmed[aaguid] = {
+    name: entry.name,
+    icon_light: entry.icon_light,
+    icon_dark: entry.icon_dark ?? entry.icon_light,
+  };
+}
+
+const target = fileURLToPath(new URL('../js/aaguids.json', import.meta.url));
+await writeFile(target, `${JSON.stringify(trimmed, null, 2)}\n`, 'utf8');
+console.log(`Wrote ${Object.keys(trimmed).length} providers to ${target}`);
