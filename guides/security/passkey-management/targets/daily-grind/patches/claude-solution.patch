diff --git a/js/account.js b/js/account.js
new file mode 100644
index 0000000..07f4c94
--- /dev/null
+++ b/js/account.js
@@ -0,0 +1,311 @@
+/** Passkey management panel for the account settings page. */
+import {
+  deleteFetch,
+  getSession,
+  listCredentials,
+  renameCredentialFetch,
+  renameUserFetch,
+} from './api.js';
+import { loadAaguidRegistry, resolveProviderFrom } from './aaguid.js';
+import { installDevBackend } from './dev-backend.js';
+import { createPasskey, detectPasskeyCapabilities } from './passkey.js';
+import { signalAcceptedCredentials, signalUserDetails } from './signals.js';
+
+installDevBackend();
+
+const FALLBACK_ICON =
+  'data:image/svg+xml;utf8,' +
+  encodeURIComponent(
+    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%234e342e" stroke-width="1.8" stroke-linecap="round"><circle cx="8.5" cy="12" r="4.2"/><path d="M12.7 12H21m-3 0v3.2M15.4 12v2.4"/></svg>',
+  );
+
+const dateFormatter = new Intl.DateTimeFormat(undefined, {
+  year: 'numeric',
+  month: 'short',
+  day: 'numeric',
+});
+
+const state = {
+  rpId: window.location.hostname,
+  user: null,
+  credentials: [],
+  registry: {},
+};
+
+const elements = {};
+
+function formatTimestamp(epochMs) {
+  if (!epochMs) {
+    return null;
+  }
+  const date = new Date(Number(epochMs));
+  return Number.isNaN(date.getTime()) ? null : dateFormatter.format(date);
+}
+
+function setStatus(message, tone = 'info') {
+  elements.status.textContent = message;
+  elements.status.dataset.tone = tone;
+}
+
+function renderCredentials() {
+  const { list, empty, template } = elements;
+  list.replaceChildren();
+
+  if (state.credentials.length === 0) {
+    empty.hidden = false;
+    return;
+  }
+  empty.hidden = true;
+
+  for (const credential of state.credentials) {
+    const provider = resolveProviderFrom(state.registry, credential.aaguid);
+    const row = template.content.firstElementChild.cloneNode(true);
+    row.dataset.credentialId = credential.id;
+
+    const icon = row.querySelector('.credential-icon');
+    icon.src = credential.providerIcon || provider.providerIcon || FALLBACK_ICON;
+    icon.alt = provider.name;
+
+    row.querySelector('.credential-name').textContent = credential.name || provider.name;
+
+    const registered = formatTimestamp(credential.registeredAt);
+    row.querySelector('.credential-registered').textContent = registered
+      ? `Added ${registered}`
+      : 'Added recently';
+
+    const lastUsed = formatTimestamp(credential.lastUsedAt);
+    row.querySelector('.credential-last-used').textContent = lastUsed
+      ? `Last used ${lastUsed}`
+      : 'Never used';
+
+    row.querySelector('.rename-credential').setAttribute(
+      'aria-label',
+      `Rename ${credential.name || provider.name}`,
+    );
+    row.querySelector('.delete-credential').setAttribute(
+      'aria-label',
+      `Delete ${credential.name || provider.name}`,
+    );
+
+    list.append(row);
+  }
+}
+
+function renderProfile() {
+  elements.profileName.textContent = state.user?.name ?? '—';
+  elements.profileDisplayName.textContent = state.user?.displayName ?? '—';
+}
+
+async function refreshCredentials() {
+  state.credentials = await listCredentials();
+  renderCredentials();
+  return state.credentials;
+}
+
+/** Keeps the password manager's credential list identical to the server's. */
+function syncAcceptedCredentials(credentials = state.credentials) {
+  return signalAcceptedCredentials({
+    rpId: state.rpId,
+    userId: state.user.id,
+    credentials,
+  });
+}
+
+function syncCurrentUserDetails() {
+  return signalUserDetails({
+    rpId: state.rpId,
+    userId: state.user.id,
+    name: state.user.name,
+    displayName: state.user.displayName,
+  });
+}
+
+async function handleDelete(credentialId) {
+  setStatus('Deleting passkey…');
+  try {
+    const response = await deleteFetch(credentialId);
+    if (!response.ok) {
+      throw new Error('The passkey could not be deleted.');
+    }
+    const updated = await refreshCredentials();
+    // Immediately tell password managers the credential is no longer accepted.
+    await syncAcceptedCredentials(updated);
+    setStatus('Passkey deleted and synced with your password manager.', 'success');
+  } catch (error) {
+    console.error(error);
+    setStatus(error.message, 'error');
+  }
+}
+
+async function handleCredentialRename(credentialId, name) {
+  setStatus('Saving new name…');
+  try {
+    const response = await renameCredentialFetch(credentialId, name);
+    if (!response.ok) {
+      throw new Error('The passkey could not be renamed.');
+    }
+    await refreshCredentials();
+    // Re-assert the account record so vault entries stay in step with the rename.
+    await syncCurrentUserDetails();
+    setStatus('Passkey renamed.', 'success');
+  } catch (error) {
+    console.error(error);
+    setStatus(error.message, 'error');
+  }
+}
+
+async function handleUserRename({ name, displayName }) {
+  setStatus('Saving account details…');
+  try {
+    const response = await renameUserFetch({ name, displayName });
+    if (!response.ok) {
+      throw new Error('The account details could not be updated.');
+    }
+    state.user = await response.json();
+    renderProfile();
+    // Push the new username / display name to the user's password manager.
+    await syncCurrentUserDetails();
+    setStatus('Account details updated and synced with your password manager.', 'success');
+  } catch (error) {
+    console.error(error);
+    setStatus(error.message, 'error');
+  }
+}
+
+async function handleCreatePasskey({ attachment }) {
+  setStatus('Follow your device prompts to create a passkey…');
+  try {
+    await createPasskey({ attachment });
+    const updated = await refreshCredentials();
+    await syncAcceptedCredentials(updated);
+    setStatus('Passkey created.', 'success');
+  } catch (error) {
+    if (error.name === 'NotAllowedError' || error.name === 'AbortError') {
+      setStatus('Passkey creation was cancelled.');
+      return;
+    }
+    console.error(error);
+    setStatus(error.message ?? 'Passkey creation failed.', 'error');
+  }
+}
+
+function openCredentialRenameDialog(credentialId) {
+  const credential = state.credentials.find((item) => item.id === credentialId);
+  if (!credential) {
+    return;
+  }
+  elements.credentialNameInput.value =
+    credential.name || resolveProviderFrom(state.registry, credential.aaguid).name;
+  elements.credentialRenameDialog.dataset.credentialId = credentialId;
+  elements.credentialRenameDialog.showModal();
+}
+
+function openUserRenameDialog() {
+  elements.userNameInput.value = state.user?.name ?? '';
+  elements.userDisplayNameInput.value = state.user?.displayName ?? '';
+  elements.userRenameDialog.showModal();
+}
+
+async function applyCapabilityGate() {
+  const capabilities = await detectPasskeyCapabilities();
+  const supported = capabilities.webAuthn && capabilities.platformAuthenticator;
+
+  elements.createActions.hidden = !supported;
+  elements.createPasskeyButton.hidden = !supported;
+  elements.unsupportedNotice.hidden = supported;
+  document.body.dataset.passkeySupport = supported ? 'supported' : 'unsupported';
+  return capabilities;
+}
+
+function cacheElements() {
+  elements.status = document.querySelector('#passkey-status');
+  elements.list = document.querySelector('#credential-list');
+  elements.empty = document.querySelector('#credential-empty');
+  elements.template = document.querySelector('#credential-row-template');
+  elements.profileName = document.querySelector('#profile-name');
+  elements.profileDisplayName = document.querySelector('#profile-display-name');
+  elements.createActions = document.querySelector('#create-actions');
+  elements.createPasskeyButton = document.querySelector('#create-passkey-button');
+  elements.createSecurityKeyButton = document.querySelector('#create-security-key-button');
+  elements.unsupportedNotice = document.querySelector('#passkey-unsupported');
+  elements.credentialRenameDialog = document.querySelector('#credential-rename-dialog');
+  elements.credentialRenameForm = document.querySelector('#credential-rename-form');
+  elements.credentialNameInput = document.querySelector('#credential-name-input');
+  elements.userRenameDialog = document.querySelector('#user-rename-dialog');
+  elements.userRenameForm = document.querySelector('#user-rename-form');
+  elements.userNameInput = document.querySelector('#user-name-input');
+  elements.userDisplayNameInput = document.querySelector('#user-display-name-input');
+  elements.renameUserButton = document.querySelector('#rename-user-button');
+}
+
+function bindEvents() {
+  elements.list.addEventListener('click', (event) => {
+    const row = event.target.closest('[data-credential-id]');
+    if (!row) {
+      return;
+    }
+    if (event.target.closest('.delete-credential')) {
+      handleDelete(row.dataset.credentialId);
+    } else if (event.target.closest('.rename-credential')) {
+      openCredentialRenameDialog(row.dataset.credentialId);
+    }
+  });
+
+  elements.credentialRenameForm.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const name = elements.credentialNameInput.value.trim();
+    const { credentialId } = elements.credentialRenameDialog.dataset;
+    elements.credentialRenameDialog.close();
+    if (name && credentialId) {
+      handleCredentialRename(credentialId, name);
+    }
+  });
+
+  elements.userRenameForm.addEventListener('submit', (event) => {
+    event.preventDefault();
+    const name = elements.userNameInput.value.trim();
+    const displayName = elements.userDisplayNameInput.value.trim();
+    elements.userRenameDialog.close();
+    if (name && displayName) {
+      handleUserRename({ name, displayName });
+    }
+  });
+
+  elements.renameUserButton.addEventListener('click', openUserRenameDialog);
+
+  elements.createPasskeyButton.addEventListener('click', () =>
+    handleCreatePasskey({ attachment: 'platform' }),
+  );
+
+  // Security keys are registered by omitting `authenticatorAttachment`.
+  elements.createSecurityKeyButton.addEventListener('click', () => handleCreatePasskey({}));
+
+  for (const dialog of document.querySelectorAll('dialog')) {
+    dialog.querySelector('.dialog-cancel')?.addEventListener('click', () => dialog.close());
+  }
+}
+
+async function init() {
+  cacheElements();
+  bindEvents();
+
+  try {
+    const [registry, session] = await Promise.all([loadAaguidRegistry(), getSession()]);
+    state.registry = registry;
+    state.user = session.user;
+    state.rpId = session.rpId ?? state.rpId;
+    renderProfile();
+
+    await refreshCredentials();
+    // Page-load synchronization with the user's password manager.
+    await syncAcceptedCredentials();
+    setStatus(`${state.credentials.length} passkey(s) synced with your password manager.`);
+  } catch (error) {
+    console.error(error);
+    setStatus('We could not load your passkeys. Please refresh and try again.', 'error');
+  }
+
+  await applyCapabilityGate();
+}
+
+document.addEventListener('DOMContentLoaded', init);
diff --git a/js/api.js b/js/api.js
new file mode 100644
index 0000000..85a729d
--- /dev/null
+++ b/js/api.js
@@ -0,0 +1,70 @@
+/** Thin wrappers around the credential management endpoints. */
+
+const JSON_HEADERS = { 'Content-Type': 'application/json' };
+
+async function readJson(response) {
+  const payload = await response.json().catch(() => ({}));
+  if (!response.ok) {
+    throw new Error(payload.error || `Request failed with status ${response.status}`);
+  }
+  return payload;
+}
+
+export function sessionFetch() {
+  return fetch('/api/session', { credentials: 'same-origin' });
+}
+
+export function listFetch() {
+  return fetch('/api/credentials', { credentials: 'same-origin' });
+}
+
+export function renameCredentialFetch(credentialId, name) {
+  return fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+    method: 'PUT',
+    headers: JSON_HEADERS,
+    credentials: 'same-origin',
+    body: JSON.stringify({ name }),
+  });
+}
+
+export function deleteFetch(credentialId) {
+  return fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+    method: 'DELETE',
+    credentials: 'same-origin',
+  });
+}
+
+export function renameUserFetch({ name, displayName }) {
+  return fetch('/api/user', {
+    method: 'PUT',
+    headers: JSON_HEADERS,
+    credentials: 'same-origin',
+    body: JSON.stringify({ name, displayName }),
+  });
+}
+
+export function registrationOptionsFetch({ attachment } = {}) {
+  return fetch('/api/registration/options', {
+    method: 'POST',
+    headers: JSON_HEADERS,
+    credentials: 'same-origin',
+    body: JSON.stringify({ attachment }),
+  });
+}
+
+export function registrationVerifyFetch(credentialJson) {
+  return fetch('/api/registration/verify', {
+    method: 'POST',
+    headers: JSON_HEADERS,
+    credentials: 'same-origin',
+    body: JSON.stringify(credentialJson),
+  });
+}
+
+export async function getSession() {
+  return readJson(await sessionFetch());
+}
+
+export async function listCredentials() {
+  return readJson(await listFetch());
+}
diff --git a/js/base64url.js b/js/base64url.js
new file mode 100644
index 0000000..203a86d
--- /dev/null
+++ b/js/base64url.js
@@ -0,0 +1,49 @@
+/** Base64URL helpers. The Signal API only accepts Base64URL-encoded strings. */
+
+const BASE64URL_PATTERN = /^[A-Za-z0-9_-]+$/;
+
+export function bufferToBase64Url(buffer) {
+  const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+  let binary = '';
+  for (const byte of bytes) {
+    binary += String.fromCharCode(byte);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function base64UrlToBuffer(value) {
+  const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+  const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
+  const binary = atob(padded);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i += 1) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+export function textToBase64Url(text) {
+  return bufferToBase64Url(new TextEncoder().encode(text));
+}
+
+export function isBase64Url(value) {
+  return typeof value === 'string' && value.length > 0 && BASE64URL_PATTERN.test(value);
+}
+
+/**
+ * Guarantees a Base64URL string for values that may still be raw text or bytes,
+ * so Signal API calls never receive an unencoded user/credential id.
+ */
+export function toBase64Url(value) {
+  if (value instanceof ArrayBuffer || ArrayBuffer.isView(value)) {
+    return bufferToBase64Url(value instanceof ArrayBuffer ? new Uint8Array(value) : value);
+  }
+  const text = String(value ?? '');
+  return isBase64Url(text) ? text : textToBase64Url(text);
+}
+
+export function randomBase64Url(byteLength = 32) {
+  const bytes = new Uint8Array(byteLength);
+  crypto.getRandomValues(bytes);
+  return bufferToBase64Url(bytes);
+}
diff --git a/js/dev-backend.js b/js/dev-backend.js
new file mode 100644
index 0000000..949ff0d
--- /dev/null
+++ b/js/dev-backend.js
@@ -0,0 +1,234 @@
+/**
+ * In-browser stand-in for the credential endpoints implemented in
+ * `server/routes.js`. The storefront is deployed as static files, so this
+ * intercepts `/api/*` requests and serves them from localStorage instead.
+ * The request/response shapes match the real Node backend exactly.
+ */
+import { loadAaguidRegistry, resolveProviderFrom, ZERO_AAGUID } from './aaguid.js';
+import { base64UrlToBuffer, randomBase64Url, textToBase64Url } from './base64url.js';
+
+const STORAGE_KEY = 'daily-grind.passkeys.v1';
+const RP_NAME = 'The Daily Grind';
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+let memoryStore = null;
+let installed = false;
+
+function seedStore() {
+  const now = Date.now();
+  const userId = textToBase64Url('user-8f21c47a');
+  return {
+    user: {
+      id: userId,
+      name: 'ava.martinez@example.com',
+      displayName: 'Ava Martinez',
+    },
+    credentials: [
+      {
+        id: 'sQ8Xn2rGk1TfLp0YvJd3Zw',
+        passkeyUserId: userId,
+        aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+        name: 'Google Password Manager',
+        transports: ['internal', 'hybrid'],
+        registeredAt: now - 45 * DAY_MS,
+        lastUsedAt: now - 4 * 60 * 60 * 1000,
+      },
+      {
+        id: 'Bt7hCa9mQx4ReVu2NoLs1A',
+        passkeyUserId: userId,
+        aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+        name: 'Apple Passwords',
+        transports: ['internal', 'hybrid'],
+        registeredAt: now - 12 * DAY_MS,
+        lastUsedAt: now - 3 * DAY_MS,
+      },
+      {
+        id: 'Kd3pWz8bYh6QsMi5TcRe0U',
+        passkeyUserId: userId,
+        aaguid: 'fa2b99dc-9e39-4257-8f92-4a30d23c4118',
+        name: 'Backup security key',
+        transports: ['usb', 'nfc'],
+        registeredAt: now - 120 * DAY_MS,
+        lastUsedAt: null,
+      },
+    ],
+  };
+}
+
+function readStore() {
+  if (memoryStore) {
+    return memoryStore;
+  }
+  try {
+    const raw = window.localStorage.getItem(STORAGE_KEY);
+    memoryStore = raw ? JSON.parse(raw) : seedStore();
+  } catch (error) {
+    console.warn('Falling back to in-memory credential storage:', error);
+    memoryStore = seedStore();
+  }
+  return memoryStore;
+}
+
+function writeStore(store) {
+  memoryStore = store;
+  try {
+    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(store));
+  } catch {
+    // Private browsing: the in-memory copy is still authoritative for the tab.
+  }
+}
+
+function aaguidFromAuthenticatorData(value) {
+  if (!value) {
+    return ZERO_AAGUID;
+  }
+  try {
+    const bytes = base64UrlToBuffer(value);
+    if (bytes.length < 53) {
+      return ZERO_AAGUID;
+    }
+    const hex = Array.from(bytes.slice(37, 53), (byte) => byte.toString(16).padStart(2, '0')).join(
+      '',
+    );
+    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(
+      16,
+      20,
+    )}-${hex.slice(20)}`;
+  } catch {
+    return ZERO_AAGUID;
+  }
+}
+
+async function handleRegistrationVerify(store, body) {
+  const registry = await loadAaguidRegistry();
+  const aaguid = aaguidFromAuthenticatorData(body?.response?.authenticatorData);
+  const { name, providerIcon } = resolveProviderFrom(registry, aaguid);
+
+  const credential = {
+    id: body?.id || randomBase64Url(16),
+    passkeyUserId: store.user.id,
+    aaguid,
+    name,
+    providerIcon,
+    transports: body?.response?.transports ?? [],
+    registeredAt: Date.now(),
+    lastUsedAt: Date.now(),
+  };
+  store.credentials = [...store.credentials.filter((c) => c.id !== credential.id), credential];
+  writeStore(store);
+  return { status: 201, body: credential };
+}
+
+async function route(method, pathname, body, rpId) {
+  const store = readStore();
+
+  if (method === 'GET' && pathname === '/api/session') {
+    return { status: 200, body: { user: store.user, rpId, rpName: RP_NAME } };
+  }
+
+  if (method === 'GET' && pathname === '/api/credentials') {
+    const list = store.credentials.filter((c) => c.passkeyUserId === store.user.id);
+    return { status: 200, body: list };
+  }
+
+  if (method === 'PUT' && pathname === '/api/user') {
+    store.user = {
+      ...store.user,
+      name: body?.name?.trim() || store.user.name,
+      displayName: body?.displayName?.trim() || store.user.displayName,
+    };
+    writeStore(store);
+    return { status: 200, body: store.user };
+  }
+
+  if (method === 'POST' && pathname === '/api/registration/options') {
+    const authenticatorSelection = {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+    };
+    // A security key registration omits `authenticatorAttachment` entirely.
+    if (body?.attachment) {
+      authenticatorSelection.authenticatorAttachment = body.attachment;
+    }
+    return {
+      status: 200,
+      body: {
+        challenge: randomBase64Url(32),
+        rp: { id: rpId, name: RP_NAME },
+        user: { id: store.user.id, name: store.user.name, displayName: store.user.displayName },
+        pubKeyCredParams: [
+          { type: 'public-key', alg: -7 },
+          { type: 'public-key', alg: -257 },
+        ],
+        excludeCredentials: store.credentials.map((credential) => ({
+          type: 'public-key',
+          id: credential.id,
+          transports: credential.transports,
+        })),
+        authenticatorSelection,
+        attestation: 'none',
+        timeout: 120000,
+      },
+    };
+  }
+
+  if (method === 'POST' && pathname === '/api/registration/verify') {
+    return handleRegistrationVerify(store, body);
+  }
+
+  const credentialMatch = pathname.match(/^\/api\/credential\/(.+)$/);
+  if (credentialMatch) {
+    const id = decodeURIComponent(credentialMatch[1]);
+    const credential = store.credentials.find((c) => c.id === id);
+    if (!credential || credential.passkeyUserId !== store.user.id) {
+      return { status: 404, body: { error: 'Credential not found.' } };
+    }
+
+    if (method === 'PUT') {
+      const name = body?.name?.trim();
+      if (!name) {
+        return { status: 400, body: { error: 'A credential name is required.' } };
+      }
+      credential.name = name;
+      writeStore(store);
+      return { status: 200, body: credential };
+    }
+
+    if (method === 'DELETE') {
+      store.credentials = store.credentials.filter((c) => c.id !== id);
+      writeStore(store);
+      return { status: 200, body: { success: true } };
+    }
+  }
+
+  return { status: 404, body: { error: 'Not found.' } };
+}
+
+export function installDevBackend() {
+  if (installed || typeof window === 'undefined') {
+    return;
+  }
+  installed = true;
+
+  const originalFetch = window.fetch.bind(window);
+
+  window.fetch = async (input, init) => {
+    const request = new Request(input, init);
+    const url = new URL(request.url, window.location.href);
+
+    if (url.origin !== window.location.origin || !url.pathname.startsWith('/api/')) {
+      return originalFetch(input, init);
+    }
+
+    const body = ['POST', 'PUT', 'PATCH'].includes(request.method)
+      ? await request.json().catch(() => ({}))
+      : null;
+
+    const result = await route(request.method, url.pathname, body, url.hostname);
+    return new Response(JSON.stringify(result.body), {
+      status: result.status,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  };
+}
diff --git a/js/passkey.js b/js/passkey.js
new file mode 100644
index 0000000..af5548c
--- /dev/null
+++ b/js/passkey.js
@@ -0,0 +1,111 @@
+/** Passkey capability detection and registration. */
+import { registrationOptionsFetch, registrationVerifyFetch } from './api.js';
+import { base64UrlToBuffer, bufferToBase64Url } from './base64url.js';
+import { ensureWebAuthnPolyfills } from './polyfills.js';
+
+/**
+ * Feature-detects passkey support with `getClientCapabilities()` so the
+ * registration entry point is only offered when it can actually succeed.
+ */
+export async function detectPasskeyCapabilities() {
+  await ensureWebAuthnPolyfills();
+
+  if (typeof window.PublicKeyCredential === 'undefined') {
+    return { webAuthn: false, platformAuthenticator: false, conditionalMediation: false };
+  }
+
+  let capabilities = {};
+  if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+    try {
+      capabilities = (await PublicKeyCredential.getClientCapabilities()) ?? {};
+    } catch (error) {
+      console.warn('getClientCapabilities() failed:', error);
+    }
+  }
+
+  let platformAuthenticator =
+    capabilities.passkeyPlatformAuthenticator ?? capabilities.userVerifyingPlatformAuthenticator;
+
+  if (
+    platformAuthenticator === undefined &&
+    typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function'
+  ) {
+    platformAuthenticator = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable().catch(
+      () => false,
+    );
+  }
+
+  return {
+    webAuthn: true,
+    platformAuthenticator: Boolean(platformAuthenticator),
+    conditionalMediation: Boolean(capabilities.conditionalGet),
+    capabilities,
+  };
+}
+
+function parseCreationOptions(optionsJson) {
+  if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+    return PublicKeyCredential.parseCreationOptionsFromJSON(optionsJson);
+  }
+  return {
+    ...optionsJson,
+    challenge: base64UrlToBuffer(optionsJson.challenge),
+    user: { ...optionsJson.user, id: base64UrlToBuffer(optionsJson.user.id) },
+    excludeCredentials: (optionsJson.excludeCredentials ?? []).map((credential) => ({
+      ...credential,
+      id: base64UrlToBuffer(credential.id),
+    })),
+  };
+}
+
+function credentialToJSON(credential) {
+  if (typeof credential.toJSON === 'function') {
+    return credential.toJSON();
+  }
+  const { response } = credential;
+  return {
+    id: credential.id,
+    rawId: bufferToBase64Url(credential.rawId),
+    type: credential.type,
+    authenticatorAttachment: credential.authenticatorAttachment,
+    clientExtensionResults: credential.getClientExtensionResults(),
+    response: {
+      clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+      attestationObject: bufferToBase64Url(response.attestationObject),
+      authenticatorData:
+        typeof response.getAuthenticatorData === 'function'
+          ? bufferToBase64Url(response.getAuthenticatorData())
+          : undefined,
+      transports:
+        typeof response.getTransports === 'function' ? response.getTransports() : undefined,
+    },
+  };
+}
+
+/**
+ * Registers a new credential. Omitting `attachment` leaves
+ * `authenticatorSelection.authenticatorAttachment` unset so the user can
+ * enroll a roaming security key.
+ */
+export async function createPasskey({ attachment } = {}) {
+  await ensureWebAuthnPolyfills();
+
+  const optionsResponse = await registrationOptionsFetch({ attachment });
+  if (!optionsResponse.ok) {
+    throw new Error('Could not start passkey registration.');
+  }
+  const optionsJson = await optionsResponse.json();
+
+  const credential = await navigator.credentials.create({
+    publicKey: parseCreationOptions(optionsJson),
+  });
+  if (!credential) {
+    throw new Error('No credential was created.');
+  }
+
+  const verifyResponse = await registrationVerifyFetch(credentialToJSON(credential));
+  if (!verifyResponse.ok) {
+    throw new Error('The new passkey could not be verified.');
+  }
+  return verifyResponse.json();
+}
diff --git a/js/polyfills.js b/js/polyfills.js
new file mode 100644
index 0000000..85d600d
--- /dev/null
+++ b/js/polyfills.js
@@ -0,0 +1,34 @@
+/**
+ * Loads `webauthn-polyfills` when the browser is missing the JSON serialization
+ * helpers, `getClientCapabilities()` or the Signal API. The bare specifier is
+ * resolved by the import map declared in the page.
+ */
+
+let polyfillPromise;
+
+function needsPolyfill() {
+  if (typeof window.PublicKeyCredential === 'undefined') {
+    return false;
+  }
+  return (
+    typeof PublicKeyCredential.parseRequestOptionsFromJSON !== 'function' ||
+    typeof PublicKeyCredential.parseCreationOptionsFromJSON !== 'function' ||
+    typeof PublicKeyCredential.getClientCapabilities !== 'function'
+  );
+}
+
+export function ensureWebAuthnPolyfills() {
+  polyfillPromise ??= (async () => {
+    if (!needsPolyfill()) {
+      return false;
+    }
+    try {
+      await import('webauthn-polyfills');
+      return true;
+    } catch (error) {
+      console.warn('webauthn-polyfills could not be loaded:', error);
+      return false;
+    }
+  })();
+  return polyfillPromise;
+}
