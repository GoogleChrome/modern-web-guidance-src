@@ -0,0 +1,66 @@
+/**
+ * Build check: parses every source file and verifies that the asset paths the
+ * HTML pages reference actually exist.
+ *
+ * Usage: node scripts/check.mjs
+ */
+import { execFileSync } from 'node:child_process';
+import { readFileSync, readdirSync, existsSync, statSync } from 'node:fs';
+import { extname, join, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
+const SKIP_DIRS = new Set(['node_modules', '.git', 'data']);
+
+function walk(directory) {
+  const entries = [];
+  for (const entry of readdirSync(directory)) {
+    if (SKIP_DIRS.has(entry)) {
+      continue;
+    }
+    const path = join(directory, entry);
+    if (statSync(path).isDirectory()) {
+      entries.push(...walk(path));
+    } else {
+      entries.push(path);
+    }
+  }
+  return entries;
+}
+
+const files = walk(ROOT);
+const failures = [];
+
+for (const file of files) {
+  const extension = extname(file);
+  if (extension === '.js' || extension === '.mjs') {
+    try {
+      execFileSync(process.execPath, ['--check', file], { stdio: 'pipe' });
+    } catch (error) {
+      failures.push(`${file}: ${error.stderr?.toString().trim() || error.message}`);
+    }
+  } else if (extension === '.json') {
+    try {
+      JSON.parse(readFileSync(file, 'utf8'));
+    } catch (error) {
+      failures.push(`${file}: ${error.message}`);
+    }
+  } else if (extension === '.html') {
+    const html = readFileSync(file, 'utf8');
+    for (const [, path] of html.matchAll(/(?:src|href)="(\/(?:js|css)\/[^"]+)"/g)) {
+      if (!existsSync(join(ROOT, path))) {
+        failures.push(`${file}: missing asset ${path}`);
+      }
+    }
+  }
+}
+
+if (failures.length > 0) {
+  console.error('Build check failed:');
+  for (const failure of failures) {
+    console.error(`  - ${failure}`);
+  }
+  process.exit(1);
+}
+
+console.log(`Build check passed (${files.length} files).`);
