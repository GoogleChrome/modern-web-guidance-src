+import type { AccountUser, PasskeyCredential } from './types.js';
+
+async function jsonRequest(input: string, init?: RequestInit): Promise<Response> {
+  return fetch(input, {
+    ...init,
+    headers: { 'Content-Type': 'application/json', ...(init?.headers ?? {}) },
+  });
+}
+
+export function listFetch(): Promise<Response> {
+  return fetch('/api/credentials');
+}
+
+export function renameCredentialFetch(credentialId: string, body: { name: string }): Promise<Response> {
+  return jsonRequest(`/api/credential/${encodeURIComponent(credentialId)}`, {
+    method: 'PUT',
+    body: JSON.stringify(body),
+  });
+}
+
+export function deleteFetch(credentialId: string): Promise<Response> {
+  return fetch(`/api/credential/${encodeURIComponent(credentialId)}`, { method: 'DELETE' });
+}
+
+export function updateUserFetch(body: { name: string; displayName: string }): Promise<Response> {
+  return jsonRequest('/api/user', { method: 'PUT', body: JSON.stringify(body) });
+}
+
+export function currentUserFetch(): Promise<Response> {
+  return fetch('/api/user');
+}
+
+export async function fetchCredentialList(): Promise<PasskeyCredential[]> {
+  const response = await listFetch();
+  if (!response.ok) throw new Error('Failed to load credentials.');
+  return response.json();
+}
+
+export async function fetchCurrentUser(): Promise<AccountUser> {
+  const response = await currentUserFetch();
+  if (!response.ok) throw new Error('Failed to load account details.');
+  return response.json();
+}
