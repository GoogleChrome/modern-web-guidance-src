diff --git a/src/client/aaguidLookup.ts b/src/client/aaguidLookup.ts
new file mode 100644
index 0000000..a609eb9
--- /dev/null
+++ b/src/client/aaguidLookup.ts
@@ -0,0 +1,52 @@
+const ZEROED_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+export interface ResolvedProvider {
+  name: string;
+  providerIcon: string | undefined;
+}
+
+let registryPromise: Promise<Record<string, AaguidEntry>> | undefined;
+
+function loadRegistry(): Promise<Record<string, AaguidEntry>> {
+  if (!registryPromise) {
+    registryPromise = fetch('/aaguids.json').then((response) => {
+      if (!response.ok) throw new Error('Failed to load AAGUID registry.');
+      return response.json();
+    });
+  }
+  return registryPromise;
+}
+
+function deviceNameFromUserAgent(userAgent: string): string {
+  if (/iphone|ipad|ipod/i.test(userAgent)) return 'iOS device';
+  if (/android/i.test(userAgent)) return 'Android device';
+  if (/mac os x/i.test(userAgent)) return 'Mac device';
+  if (/windows/i.test(userAgent)) return 'Windows device';
+  if (/linux/i.test(userAgent)) return 'Linux device';
+  return 'Unknown passkey provider';
+}
+
+/**
+ * Resolves provider name/icon for a credential row by looking its AAGUID up
+ * against the local registry. The zeroed AAGUID means the authenticator
+ * attested no model info, so it is never looked up — only a device-derived
+ * fallback is used.
+ */
+export async function resolveAaguidProvider(aaguid: string): Promise<ResolvedProvider> {
+  if (aaguid === ZEROED_AAGUID) {
+    return { name: deviceNameFromUserAgent(navigator.userAgent), providerIcon: undefined };
+  }
+
+  const registry = await loadRegistry();
+  const provider = registry[aaguid];
+  return {
+    name: provider?.name ?? 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
