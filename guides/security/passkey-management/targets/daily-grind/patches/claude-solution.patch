diff --git a/js/aaguid.js b/js/aaguid.js
new file mode 100644
index 0000000..d2a83bb
--- /dev/null
+++ b/js/aaguid.js
@@ -0,0 +1,59 @@
+/**
+ * Maps an authenticator's AAGUID to the passkey provider that created the
+ * credential, using the community registry bundled in `aaguids.json`.
+ */
+
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+export const UNKNOWN_PROVIDER = 'Unknown passkey provider';
+
+const REGISTRY_URL = new URL('./aaguids.json', import.meta.url);
+
+let registryPromise;
+
+export function loadAaguidRegistry() {
+  registryPromise ??= fetch(REGISTRY_URL)
+    .then((response) => {
+      if (!response.ok) {
+        throw new Error(`AAGUID registry request failed: ${response.status}`);
+      }
+      return response.json();
+    })
+    .catch((error) => {
+      console.error('Could not load the AAGUID registry:', error);
+      return {};
+    });
+  return registryPromise;
+}
+
+/** Best-effort device label used when the AAGUID is zeroed out. */
+export function deviceNameFromUserAgent(userAgent = navigator.userAgent ?? '') {
+  const device = [
+    [/iPhone/i, 'iPhone'],
+    [/iPad/i, 'iPad'],
+    [/Macintosh|Mac OS X/i, 'Mac'],
+    [/Android/i, 'Android device'],
+    [/Windows/i, 'Windows device'],
+    [/CrOS/i, 'Chromebook'],
+    [/Linux/i, 'Linux device'],
+  ].find(([pattern]) => pattern.test(userAgent));
+  return device ? `Passkey on ${device[1]}` : UNKNOWN_PROVIDER;
+}
+
+/**
+ * Resolves provider details for an AAGUID. Zeroed AAGUIDs carry no model
+ * information, so the registry is skipped entirely for them.
+ */
+export function resolveProviderFrom(registry, aaguid, { userAgent } = {}) {
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    return { name: deviceNameFromUserAgent(userAgent), providerIcon: undefined };
+  }
+  const provider = registry?.[aaguid.toLowerCase()];
+  return {
+    name: provider?.name || UNKNOWN_PROVIDER,
+    providerIcon: provider?.icon_light,
+  };
+}
+
+export async function resolveProvider(aaguid, options) {
+  return resolveProviderFrom(await loadAaguidRegistry(), aaguid, options);
+}
