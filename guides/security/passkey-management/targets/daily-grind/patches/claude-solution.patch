diff --git a/account.html b/account.html
new file mode 100644
index 0000000..23bc63e
--- /dev/null
+++ b/account.html
@@ -0,0 +1,150 @@
+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Security Settings | The Daily Grind</title>
+  <link rel="stylesheet" href="/css/styles.css">
+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "https://unpkg.com/webauthn-polyfills"
+      }
+    }
+  </script>
+  <script type="module">
+    // Kicked off without top-level await so a slow CDN cannot delay DOMContentLoaded.
+    (async () => {
+      if (window.PublicKeyCredential && !PublicKeyCredential.parseRequestOptionsFromJSON) {
+        try {
+          await import('webauthn-polyfills');
+        } catch (error) {
+          console.warn('webauthn-polyfills could not be preloaded:', error);
+        }
+      }
+    })();
+  </script>
+  <script type="module" src="/js/account.js"></script>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account.html">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <main class="container">
+    <header class="page-header">
+      <h1>Security settings</h1>
+      <p>Passkeys let you sign in to The Daily Grind with your face, fingerprint, or screen lock
+        instead of a password. Manage the passkeys saved for your account below.</p>
+    </header>
+
+    <section class="panel" id="profile-panel" aria-labelledby="profile-heading">
+      <div class="panel-head">
+        <h2 id="profile-heading">Account details</h2>
+        <button type="button" class="btn btn-small btn-secondary" id="rename-user-button">Rename</button>
+      </div>
+      <dl class="profile-details">
+        <div>
+          <dt>Username</dt>
+          <dd id="profile-name">&mdash;</dd>
+        </div>
+        <div>
+          <dt>Display name</dt>
+          <dd id="profile-display-name">&mdash;</dd>
+        </div>
+      </dl>
+    </section>
+
+    <section class="panel" id="passkeys-panel" aria-labelledby="passkeys-heading">
+      <div class="panel-head">
+        <h2 id="passkeys-heading">Your passkeys</h2>
+        <div class="panel-actions" id="create-actions" hidden>
+          <button type="button" class="btn" id="create-passkey-button">Create passkey</button>
+          <button type="button" class="btn btn-secondary" id="create-security-key-button">Use a security
+            key</button>
+        </div>
+      </div>
+
+      <p class="notice" id="passkey-unsupported" hidden>
+        This browser or device can&rsquo;t create passkeys yet. Protect your account with
+        <a href="/account/two-factor">an authenticator app or SMS verification</a> instead.
+      </p>
+
+      <p class="status" id="passkey-status" role="status" aria-live="polite"></p>
+
+      <ul class="credential-list" id="credential-list"></ul>
+
+      <p class="empty-state" id="credential-empty" hidden>No passkeys found. Create one to sign in without a
+        password.</p>
+    </section>
+  </main>
+
+  <template id="credential-row-template">
+    <li class="credential">
+      <img class="credential-icon" src="" alt="" width="40" height="40">
+      <div class="credential-info">
+        <p class="credential-name"></p>
+        <p class="credential-meta">
+          <span class="credential-registered"></span>
+          <span class="credential-last-used"></span>
+        </p>
+      </div>
+      <div class="credential-actions">
+        <button type="button" class="btn btn-small btn-secondary rename-credential">Rename</button>
+        <button type="button" class="btn btn-small btn-danger delete-credential">Delete</button>
+      </div>
+    </li>
+  </template>
+
+  <dialog id="credential-rename-dialog">
+    <form method="dialog" id="credential-rename-form">
+      <h2>Rename passkey</h2>
+      <label class="field" for="credential-name-input">Passkey name
+        <input type="text" id="credential-name-input" name="name" maxlength="64" required>
+      </label>
+      <div class="dialog-actions">
+        <button type="button" class="btn btn-small btn-secondary dialog-cancel">Cancel</button>
+        <button type="submit" class="btn btn-small">Save</button>
+      </div>
+    </form>
+  </dialog>
+
+  <dialog id="user-rename-dialog">
+    <form method="dialog" id="user-rename-form">
+      <h2>Rename account</h2>
+      <label class="field" for="user-name-input">Username
+        <input type="text" id="user-name-input" name="name" maxlength="128" required>
+      </label>
+      <label class="field" for="user-display-name-input">Display name
+        <input type="text" id="user-display-name-input" name="displayName" maxlength="128" required>
+      </label>
+      <div class="dialog-actions">
+        <button type="button" class="btn btn-small btn-secondary dialog-cancel">Cancel</button>
+        <button type="submit" class="btn btn-small">Save</button>
+      </div>
+    </form>
+  </dialog>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
diff --git a/css/styles.css b/css/styles.css
new file mode 100644
index 0000000..dade0e7
--- /dev/null
+++ b/css/styles.css
@@ -0,0 +1,374 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --danger: #b3261e;
+  --muted: #6d5b55;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border: 1px solid var(--primary);
+  border-radius: 5px;
+  margin-top: 15px;
+  font: inherit;
+  cursor: pointer;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Account & passkey management */
+.page-header {
+  margin-bottom: 24px;
+}
+
+.page-header h1 {
+  color: var(--primary);
+}
+
+.page-header p {
+  color: var(--muted);
+  max-width: 70ch;
+}
+
+.panel {
+  background: white;
+  border-radius: 10px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  padding: 24px;
+  margin-bottom: 24px;
+}
+
+.panel-head {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.panel h2 {
+  color: var(--primary);
+  font-size: 1.3rem;
+}
+
+.panel-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+}
+
+.panel-actions .btn {
+  margin-top: 0;
+}
+
+.btn-secondary {
+  background: white;
+  color: var(--primary);
+}
+
+.btn-secondary:hover {
+  background: var(--secondary);
+}
+
+.btn-small {
+  padding: 6px 14px;
+  margin-top: 0;
+  font-size: 0.85rem;
+}
+
+.btn-danger {
+  background: white;
+  color: var(--danger);
+  border-color: var(--danger);
+}
+
+.btn-danger:hover {
+  background: var(--danger);
+  color: white;
+}
+
+.profile-details {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+  gap: 12px;
+  margin: 12px 0;
+}
+
+.profile-details dt {
+  font-size: 0.8rem;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+  color: var(--muted);
+}
+
+.profile-details dd {
+  font-size: 1.05rem;
+}
+
+.credential-list {
+  list-style: none;
+  margin-top: 16px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.credential {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 14px 16px;
+  border: 1px solid var(--secondary);
+  border-radius: 8px;
+}
+
+.credential-icon {
+  width: 40px;
+  height: 40px;
+  object-fit: contain;
+  flex: 0 0 40px;
+  background: var(--light);
+  border-radius: 8px;
+  padding: 4px;
+}
+
+.credential-info {
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+.credential-name {
+  font-weight: 600;
+  overflow-wrap: anywhere;
+}
+
+.credential-meta {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 16px;
+  font-size: 0.85rem;
+  color: var(--muted);
+}
+
+.credential-actions {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+}
+
+.empty-state {
+  margin-top: 16px;
+  padding: 24px;
+  border: 1px dashed var(--secondary);
+  border-radius: 8px;
+  text-align: center;
+  color: var(--muted);
+}
+
+.notice {
+  margin-top: 16px;
+  padding: 14px 16px;
+  border-radius: 8px;
+  background: #fff4e0;
+  border: 1px solid var(--accent);
+}
+
+.status {
+  margin-top: 12px;
+  min-height: 1.6em;
+  font-size: 0.9rem;
+  color: var(--muted);
+}
+
+.status[data-tone='success'] {
+  color: #1b5e20;
+}
+
+.status[data-tone='error'] {
+  color: var(--danger);
+}
+
+dialog {
+  border: none;
+  border-radius: 10px;
+  /* The `* { margin: 0 }` reset above would otherwise pin modals to the corner. */
+  margin: auto;
+  padding: 24px;
+  max-width: 420px;
+  width: calc(100% - 40px);
+  color: var(--text);
+  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
+}
+
+dialog::backdrop {
+  background: rgba(62, 39, 35, 0.45);
+}
+
+dialog h2 {
+  color: var(--primary);
+  font-size: 1.2rem;
+  margin-bottom: 8px;
+}
+
+.field {
+  display: block;
+  margin-top: 12px;
+  font-size: 0.85rem;
+  color: var(--muted);
+}
+
+.field input {
+  display: block;
+  width: 100%;
+  margin-top: 4px;
+  padding: 10px;
+  font: inherit;
+  color: var(--text);
+  border: 1px solid var(--secondary);
+  border-radius: 6px;
+}
+
+.dialog-actions {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 20px;
+}
+
+.dialog-actions .btn {
+  margin-top: 0;
+}
