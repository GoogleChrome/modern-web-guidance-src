--- /dev/null
+++ b/src/client/webauthnSignals.ts
@@ -0,0 +1,54 @@
+export const RP_ID = window.location.hostname;
+
+interface SignalAllAcceptedCredentialsOptions {
+  rpId: string;
+  userId: string;
+  allAcceptedCredentialIds: string[];
+}
+
+interface SignalCurrentUserDetailsOptions {
+  rpId: string;
+  userId: string;
+  name: string;
+  displayName: string;
+}
+
+type PublicKeyCredentialWithSignals = typeof PublicKeyCredential & {
+  signalAllAcceptedCredentials?: (options: SignalAllAcceptedCredentialsOptions) => Promise<void>;
+  signalCurrentUserDetails?: (options: SignalCurrentUserDetailsOptions) => Promise<void>;
+};
+
+function getSignalCapablePkc(): PublicKeyCredentialWithSignals | undefined {
+  if (!('PublicKeyCredential' in window)) return undefined;
+  return PublicKeyCredential as PublicKeyCredentialWithSignals;
+}
+
+/**
+ * Tells the password manager which credential IDs (Base64URL strings) are
+ * still valid for this user, so stale/deleted entries are pruned client-side.
+ * Must be feature-detected per the Signal API spec; swallow failures so a
+ * sync hiccup never blocks the UI it was triggered from.
+ */
+export async function syncAllAcceptedCredentials(userId: string, allAcceptedCredentialIds: string[]): Promise<void> {
+  const pkc = getSignalCapablePkc();
+  if (!pkc?.signalAllAcceptedCredentials) return;
+  try {
+    await pkc.signalAllAcceptedCredentials({ rpId: RP_ID, userId, allAcceptedCredentialIds });
+  } catch (e) {
+    console.error('SignalAllAcceptedCredentials sync failure:', e);
+  }
+}
+
+/**
+ * Pushes the signed-in user's latest username/displayName to the password
+ * manager so saved passkeys show up-to-date account details.
+ */
+export async function syncCurrentUserDetails(userId: string, name: string, displayName: string): Promise<void> {
+  const pkc = getSignalCapablePkc();
+  if (!pkc?.signalCurrentUserDetails) return;
+  try {
+    await pkc.signalCurrentUserDetails({ rpId: RP_ID, userId, name, displayName });
+  } catch (e) {
+    console.error('SignalCurrentUserDetails sync failure:', e);
+  }
+}
diff --git a/src/server/aaguidRegistry.ts b/src/server/aaguidRegistry.ts
new file mode 100644
index 0000000..4b6f526
--- /dev/null
+++ b/src/server/aaguidRegistry.ts
@@ -0,0 +1,52 @@
+import * as fs from 'node:fs';
+import * as path from 'node:path';
+
+const ZEROED_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+// The registry is served to the client as a static asset at /aaguids.json,
+// so the server reads the same file from disk instead of keeping a copy.
+const registryPath = path.join(process.cwd(), 'public', 'aaguids.json');
+const registry: Record<string, AaguidEntry> = JSON.parse(fs.readFileSync(registryPath, 'utf-8'));
+
+export interface ResolvedProvider {
+  name: string;
+  providerIcon: string | undefined;
+}
+
+/**
+ * Derives a human-friendly fallback name from a User-Agent string when the
+ * authenticator reports the zeroed AAGUID (no attested model information).
+ */
+function deviceNameFromUserAgent(userAgent: string | undefined): string {
+  if (!userAgent) return 'Unknown passkey provider';
+  if (/iphone|ipad|ipod/i.test(userAgent)) return 'iOS device';
+  if (/android/i.test(userAgent)) return 'Android device';
+  if (/mac os x/i.test(userAgent)) return 'Mac device';
+  if (/windows/i.test(userAgent)) return 'Windows device';
+  if (/linux/i.test(userAgent)) return 'Linux device';
+  return 'Unknown passkey provider';
+}
+
+/**
+ * Resolves a passkey provider's display name and icon from its AAGUID.
+ * The zeroed AAGUID carries no attested model information, so it is never
+ * looked up against the registry: it only ever produces a device-derived
+ * or generic fallback.
+ */
+export function resolveAaguidProvider(aaguid: string, userAgent?: string): ResolvedProvider {
+  if (aaguid === ZEROED_AAGUID) {
+    return { name: deviceNameFromUserAgent(userAgent), providerIcon: undefined };
+  }
+
+  const provider = registry[aaguid];
+  return {
+    name: provider?.name ?? 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
diff --git a/src/server/app.ts b/src/server/app.ts
new file mode 100644
index 0000000..94b2af5
--- /dev/null
+++ b/src/server/app.ts
@@ -0,0 +1,79 @@
+import express, { type Express } from 'express';
+import path from 'node:path';
+import { checkUserAuthenticated } from './auth';
+import * as db from './db';
+import { resolveAaguidProvider } from './aaguidRegistry';
+import type { StoredPasskeyCredential } from './types';
+
+type CredentialResponse = StoredPasskeyCredential & { name: string; providerIcon?: string };
+
+function toResponse(cred: StoredPasskeyCredential, userAgent?: string): CredentialResponse {
+  // AAGUID-derived name/icon are resolved fresh on every read so registry
+  // updates apply retroactively, but a user-set nickname always wins.
+  const resolved = resolveAaguidProvider(cred.aaguid, userAgent);
+  return {
+    ...cred,
+    name: cred.name || resolved.name,
+    providerIcon: cred.providerIcon ?? resolved.providerIcon,
+  };
+}
+
+export function createApp(): Express {
+  const app = express();
+  app.use(express.json());
+  app.use(express.static(path.join(process.cwd(), 'public')));
+
+  app.get('/api/credentials', checkUserAuthenticated, async (req, res) => {
+    const list = await db.findCredentialsByUserId(req.user!.id);
+    res.json(list.map((cred) => toResponse(cred, req.header('user-agent'))));
+  });
+
+  app.put('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+    const { id } = req.params;
+    const { name } = req.body as { name?: string };
+    const cred = await db.findCredentialById(id);
+    if (!cred || cred.passkeyUserId !== req.user!.id) {
+      res.status(404).json({ error: 'Credential not found.' });
+      return;
+    }
+    if (typeof name !== 'string' || !name.trim()) {
+      res.status(400).json({ error: 'A non-empty name is required.' });
+      return;
+    }
+    cred.name = name.trim();
+    await db.saveCredential(cred);
+    res.json(toResponse(cred, req.header('user-agent')));
+  });
+
+  app.delete('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+    const { id } = req.params;
+    const cred = await db.findCredentialById(id);
+    if (!cred || cred.passkeyUserId !== req.user!.id) {
+      res.status(404).json({ error: 'Credential not found.' });
+      return;
+    }
+    await db.deleteCredential(id);
+    res.json({ success: true });
+  });
+
+  app.put('/api/user', checkUserAuthenticated, async (req, res) => {
+    const { name, displayName } = req.body as { name?: string; displayName?: string };
+    const updatedUser = await db.updateUser(req.user!.id, { name, displayName });
+    if (!updatedUser) {
+      res.status(404).json({ error: 'User not found.' });
+      return;
+    }
+    res.json(updatedUser);
+  });
+
+  app.get('/api/user', checkUserAuthenticated, async (req, res) => {
+    const user = await db.findUserById(req.user!.id);
+    if (!user) {
+      res.status(404).json({ error: 'User not found.' });
+      return;
+    }
+    res.json(user);
+  });
+
+  return app;
+}
diff --git a/src/server/auth.ts b/src/server/auth.ts
new file mode 100644
index 0000000..7723195
--- /dev/null
+++ b/src/server/auth.ts
@@ -0,0 +1,31 @@
+import type { NextFunction, Request, Response } from 'express';
+
+export interface AuthenticatedUser {
+  id: string;
+}
+
+declare global {
+  namespace Express {
+    interface Request {
+      user?: AuthenticatedUser;
+    }
+  }
+}
+
+const DEMO_USER_ID = 'M2YPl-KGnA8';
+
+/**
+ * Stand-in for the app's real session/cookie auth. The signed-in user's ID
+ * would normally come from a verified session; this demo trusts an
+ * `x-user-id` header (falling back to a fixed demo account) so the
+ * credential-management endpoints below have someone to scope requests to.
+ */
+export function checkUserAuthenticated(req: Request, res: Response, next: NextFunction): void {
+  const userId = (req.header('x-user-id') || DEMO_USER_ID).trim();
+  if (!userId) {
+    res.status(401).json({ error: 'Not authenticated.' });
+    return;
+  }
+  req.user = { id: userId };
+  next();
+}
