--- /dev/null
+++ b/js/signals.js
@@ -0,0 +1,60 @@
+/**
+ * Signal API helpers. These keep the credentials stored in the user's password
+ * manager in lockstep with the credentials our backend still accepts.
+ *
+ * Every id handed to the Signal API must be a Base64URL-encoded string.
+ */
+import { toBase64Url } from './base64url.js';
+
+export function signalsSupported() {
+  return (
+    typeof window.PublicKeyCredential !== 'undefined' &&
+    typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function' &&
+    typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+  );
+}
+
+/**
+ * Tells password managers exactly which credential ids the server still
+ * accepts; anything missing from the list is removed from their vault.
+ */
+export async function signalAcceptedCredentials({ rpId, userId, credentials = [] }) {
+  if (!signalsSupported()) {
+    return false;
+  }
+  try {
+    const allAcceptedCredentialIds = credentials
+      .map((credential) => (typeof credential === 'string' ? credential : credential?.id))
+      .filter(Boolean)
+      .map(toBase64Url);
+
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId: toBase64Url(userId),
+      allAcceptedCredentialIds,
+    });
+    return true;
+  } catch (error) {
+    console.error('SignalAllAcceptedCredentials sync failure:', error);
+    return false;
+  }
+}
+
+/** Pushes the current username / display name to the password manager. */
+export async function signalUserDetails({ rpId, userId, name, displayName }) {
+  if (!signalsSupported()) {
+    return false;
+  }
+  try {
+    await PublicKeyCredential.signalCurrentUserDetails({
+      rpId,
+      userId: toBase64Url(userId),
+      name,
+      displayName,
+    });
+    return true;
+  } catch (error) {
+    console.error('SignalCurrentUserDetails sync failure:', error);
+    return false;
+  }
+}
