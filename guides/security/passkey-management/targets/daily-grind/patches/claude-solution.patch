--- /dev/null
+++ b/src/client/registration.ts
@@ -0,0 +1,76 @@
+import { bufferToBase64url } from './base64url.js';
+import { RP_ID } from './webauthnSignals.js';
+
+type ClientCapabilities = Record<string, boolean>;
+
+type PublicKeyCredentialWithCapabilities = typeof PublicKeyCredential & {
+  getClientCapabilities?: () => Promise<ClientCapabilities>;
+};
+
+/**
+ * Feature-detects whether this browser/OS combination can create platform
+ * passkeys at all before the "Create passkey" button is ever shown. Per the
+ * guide's fallback strategy, 'webauthn-polyfills' guarantees
+ * getClientCapabilities exists whenever PublicKeyCredential does, so the
+ * only remaining check is the capability itself.
+ */
+export async function isPlatformPasskeySupported(): Promise<boolean> {
+  if (!('PublicKeyCredential' in window)) return false;
+  const pkc = PublicKeyCredential as PublicKeyCredentialWithCapabilities;
+  if (!pkc.getClientCapabilities) return false;
+  try {
+    const capabilities = await pkc.getClientCapabilities();
+    return Boolean(capabilities.passkeyPlatformAuthenticator);
+  } catch (e) {
+    console.error('getClientCapabilities failed:', e);
+    return false;
+  }
+}
+
+export interface RegistrationUser {
+  id: string; // Base64URL-encoded user ID
+  name: string;
+  displayName: string;
+}
+
+/**
+ * Starts a WebAuthn registration ceremony. Passing `attachment: undefined`
+ * omits `authenticatorSelection.authenticatorAttachment` entirely so the
+ * browser also offers roaming security keys instead of restricting to
+ * platform authenticators.
+ */
+export async function createPasskeyCredential(
+  user: RegistrationUser,
+  challenge: ArrayBuffer,
+  attachment: AuthenticatorAttachment | undefined,
+): Promise<PublicKeyCredential> {
+  const publicKey: PublicKeyCredentialCreationOptions = {
+    rp: { id: RP_ID, name: 'The Daily Grind' },
+    user: {
+      id: Uint8Array.from(atob(user.id.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0)),
+      name: user.name,
+      displayName: user.displayName,
+    },
+    challenge,
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 }, // ES256
+      { type: 'public-key', alg: -257 }, // RS256
+    ],
+    authenticatorSelection: {
+      residentKey: 'required',
+      userVerification: 'required',
+      ...(attachment ? { authenticatorAttachment: attachment } : {}),
+    },
+    attestation: 'none',
+  };
+
+  const credential = await navigator.credentials.create({ publicKey });
+  if (!(credential instanceof PublicKeyCredential)) {
+    throw new Error('Passkey registration did not return a credential.');
+  }
+  return credential;
+}
+
+export function credentialRawIdToBase64url(credential: PublicKeyCredential): string {
+  return bufferToBase64url(credential.rawId);
+}
