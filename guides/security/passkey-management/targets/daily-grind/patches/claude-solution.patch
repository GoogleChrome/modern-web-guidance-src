@@ -0,0 +1,74 @@
+import type { StoredPasskeyCredential, StoredUser } from './types';
+
+const DEMO_USER_ID = 'M2YPl-KGnA8';
+
+const users = new Map<string, StoredUser>([
+  [DEMO_USER_ID, { id: DEMO_USER_ID, name: 'jane.doe', displayName: 'Jane Doe' }],
+]);
+
+const credentials = new Map<string, StoredPasskeyCredential>([
+  [
+    'cred-1a2b3c',
+    {
+      id: 'cred-1a2b3c',
+      passkeyUserId: DEMO_USER_ID,
+      name: 'Google Password Manager',
+      aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      providerIcon:
+        'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PGNpcmNsZSBjeD0iMTIiIGN5PSIxMiIgcj0iMTAiIGZpbGw9IiM0Mjg1RjQiLz48L3N2Zz4=',
+      publicKey: 'mock-public-key-1',
+      counter: 4,
+      transports: ['internal', 'hybrid'],
+      registeredAt: Date.UTC(2025, 0, 12, 9, 30),
+      lastUsedAt: Date.UTC(2026, 8, 20, 14, 5),
+    },
+  ],
+  [
+    'cred-4d5e6f',
+    {
+      id: 'cred-4d5e6f',
+      passkeyUserId: DEMO_USER_ID,
+      name: 'iCloud Keychain',
+      aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+      providerIcon:
+        'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PGNpcmNsZSBjeD0iMTIiIGN5PSIxMiIgcj0iMTAiIGZpbGw9IiMwMDdBRkYiLz48L3N2Zz4=',
+      publicKey: 'mock-public-key-2',
+      counter: 1,
+      transports: ['internal'],
+      registeredAt: Date.UTC(2025, 5, 2, 18, 0),
+    },
+  ],
+]);
+
+export async function findCredentialsByUserId(userId: string): Promise<StoredPasskeyCredential[]> {
+  return Array.from(credentials.values()).filter((cred) => cred.passkeyUserId === userId);
+}
+
+export async function findCredentialById(id: string): Promise<StoredPasskeyCredential | undefined> {
+  return credentials.get(id);
+}
+
+export async function saveCredential(credential: StoredPasskeyCredential): Promise<StoredPasskeyCredential> {
+  credentials.set(credential.id, credential);
+  return credential;
+}
+
+export async function deleteCredential(id: string): Promise<void> {
+  credentials.delete(id);
+}
+
+export async function findUserById(id: string): Promise<StoredUser | undefined> {
+  return users.get(id);
+}
+
+export async function updateUser(
+  id: string,
+  updates: { name?: string; displayName?: string },
+): Promise<StoredUser | undefined> {
+  const user = users.get(id);
+  if (!user) return undefined;
+  if (updates.name !== undefined) user.name = updates.name;
+  if (updates.displayName !== undefined) user.displayName = updates.displayName;
+  users.set(id, user);
+  return user;
+}
