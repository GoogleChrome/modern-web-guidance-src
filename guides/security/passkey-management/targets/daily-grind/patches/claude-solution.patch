new file mode 100644
index 0000000..c3d7fba
--- /dev/null
+++ b/server/aaguid.js
@@ -0,0 +1,39 @@
+/** Server-side AAGUID lookup against the bundled community registry. */
+import { readFileSync } from 'node:fs';
+import { join, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+export const UNKNOWN_PROVIDER = 'Unknown passkey provider';
+
+const registry = JSON.parse(
+  readFileSync(join(dirname(fileURLToPath(import.meta.url)), '..', 'js', 'aaguids.json'), 'utf8'),
+);
+
+function deviceNameFromUserAgent(userAgent = '') {
+  const device = [
+    [/iPhone/i, 'iPhone'],
+    [/iPad/i, 'iPad'],
+    [/Macintosh|Mac OS X/i, 'Mac'],
+    [/Android/i, 'Android device'],
+    [/Windows/i, 'Windows device'],
+    [/CrOS/i, 'Chromebook'],
+    [/Linux/i, 'Linux device'],
+  ].find(([pattern]) => pattern.test(userAgent));
+  return device ? `Passkey on ${device[1]}` : UNKNOWN_PROVIDER;
+}
+
+/**
+ * Zeroed AAGUIDs identify no authenticator model, so the registry lookup is
+ * skipped and the device name derived from the user agent is used instead.
+ */
+export function resolveProvider(aaguid, userAgent) {
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    return { name: deviceNameFromUserAgent(userAgent), providerIcon: undefined };
+  }
+  const provider = registry[aaguid.toLowerCase()];
+  return {
+    name: provider?.name || UNKNOWN_PROVIDER,
+    providerIcon: provider?.icon_light,
+  };
+}
diff --git a/server/db.js b/server/db.js
new file mode 100644
index 0000000..675bee7
--- /dev/null
+++ b/server/db.js
@@ -0,0 +1,68 @@
+/**
+ * Minimal JSON-file credential store. Swap this module for your real database
+ * layer; `routes.js` only depends on the functions exported here.
+ *
+ * StoredPasskeyCredential:
+ *   { id, passkeyUserId, publicKey, counter, aaguid, name, providerIcon,
+ *     transports, registeredAt, lastUsedAt }
+ */
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const DATA_FILE = join(dirname(fileURLToPath(import.meta.url)), 'data', 'store.json');
+
+function emptyStore() {
+  return { users: {}, credentials: {} };
+}
+
+function read() {
+  if (!existsSync(DATA_FILE)) {
+    return emptyStore();
+  }
+  try {
+    return JSON.parse(readFileSync(DATA_FILE, 'utf8'));
+  } catch (error) {
+    console.error('Credential store is unreadable, starting empty:', error);
+    return emptyStore();
+  }
+}
+
+function write(store) {
+  mkdirSync(dirname(DATA_FILE), { recursive: true });
+  writeFileSync(DATA_FILE, `${JSON.stringify(store, null, 2)}\n`, 'utf8');
+}
+
+export function findUserById(userId) {
+  return read().users[userId] ?? null;
+}
+
+export function saveUser(user) {
+  const store = read();
+  store.users[user.id] = user;
+  write(store);
+  return user;
+}
+
+export function findCredentialsByUserId(userId) {
+  return Object.values(read().credentials)
+    .filter((credential) => credential.passkeyUserId === userId)
+    .sort((a, b) => b.registeredAt - a.registeredAt);
+}
+
+export function findCredentialById(credentialId) {
+  return read().credentials[credentialId] ?? null;
+}
+
+export function saveCredential(credential) {
+  const store = read();
+  store.credentials[credential.id] = credential;
+  write(store);
+  return credential;
+}
+
+export function deleteCredential(credentialId) {
+  const store = read();
+  delete store.credentials[credentialId];
+  write(store);
+}
