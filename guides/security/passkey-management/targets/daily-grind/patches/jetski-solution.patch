+  --surface-subtle: #f5efeb;
+  --border: #e4d8d1;
+  --danger: #b71c1c;
+  --danger-bg: #ffebee;
+  --success: #1b5e20;
+  --success-bg: #e8f5e9;
+  --warning: #e65100;
+  --warning-bg: #fff3e0;
+  --shadow-sm: 0 2px 6px rgba(62, 39, 35, 0.06);
+  --shadow-md: 0 6px 20px rgba(62, 39, 35, 0.09);
+  --radius-sm: 6px;
