diff --git a/passkey-management.js b/passkey-management.js
new file mode 100644
index 0000000..896c3a7
--- /dev/null
+++ b/passkey-management.js
@@ -0,0 +1,448 @@
+import 'webauthn-polyfills';
+import aaguids from './aaguids.json' with { type: 'json' };
+import {
+  listFetch,
+  renameFetch,
+  deleteFetch,
+  base64UrlUserId,
+  rpId,
+  toBase64Url,
+  getLocalUserDetails
+} from './api.js';
+
+let aaguidRegistry = { ...aaguids };
+
+/**
+ * Load / update local AAGUID mapping registry from network if available.
+ */
+async function loadAaguidRegistry() {
+  try {
+    if (typeof fetch === 'function') {
+      const res = await fetch('https://raw.githubusercontent.com/passkeydeveloper/passkey-authenticator-aaguids/refs/heads/main/combined_aaguid.json');
+      if (res && res.ok) {
+        const data = await res.json();
+        aaguidRegistry = { ...aaguidRegistry, ...data };
+      }
+    }
+  } catch (e) {}
+}
+
+/**
+ * Resolve provider details from AAGUID according to guide.
+ */
+export function resolveProvider(aaguid) {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Unknown passkey provider',
+      providerIcon: undefined
+    };
+  }
+
+  const provider = aaguidRegistry[aaguid] || aaguids[aaguid];
+  if (provider) {
+    return {
+      name: provider.name || 'Unknown passkey provider',
+      providerIcon: provider.icon_light || provider.icon_dark || undefined
+    };
+  }
+
+  return {
+    name: 'Unknown passkey provider',
+    providerIcon: undefined
+  };
+}
+
+/**
+ * Sync accepted credentials list with the password manager using Signal API.
+ */
+export async function syncAcceptedCredentials(currentCredentialsList) {
+  try {
+    if (typeof window === 'undefined' || !window.PublicKeyCredential || typeof PublicKeyCredential.signalAllAcceptedCredentials !== 'function') {
+      return;
+    }
+    const currentRpId = typeof window !== 'undefined' && window.location && window.location.hostname
+      ? window.location.hostname
+      : rpId;
+    const credentialIds = (currentCredentialsList || []).map(c => toBase64Url(c.id));
+
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: currentRpId, // RP ID must match the one defined on the server
+      userId: base64UrlUserId, // User ID Base64URL-encoded string
+      allAcceptedCredentialIds: credentialIds
+    });
+  } catch (e) {
+    console.error('SignalAllAcceptedCredentials sync failure:', e);
+  }
+}
+
+/**
+ * Render credential rows in the management panel.
+ */
+export function renderUI(list) {
+  if (typeof document === 'undefined') return;
+
+  const container = document.getElementById('passkey-list-container');
+  const emptyState = document.getElementById('passkey-empty-state');
+  if (!container) return;
+
+  container.innerHTML = '';
+
+  if (!list || list.length === 0) {
+    if (emptyState) emptyState.style.display = 'block';
+    return;
+  }
+
+  if (emptyState) emptyState.style.display = 'none';
+
+  const ul = document.createElement('ul');
+  ul.className = 'credential-list';
+
+  list.forEach(cred => {
+    const providerInfo = resolveProvider(cred.aaguid);
+    const displayName = cred.name || providerInfo.name;
+    const providerIcon = cred.providerIcon || providerInfo.providerIcon;
+
+    const registeredDate = cred.registeredAt
+      ? new Date(cred.registeredAt).toLocaleDateString(undefined, {
+          year: 'numeric',
+          month: 'short',
+          day: 'numeric'
+        })
+      : 'Unknown';
+
+    const lastUsedDate = cred.lastUsedAt
+      ? new Date(cred.lastUsedAt).toLocaleString(undefined, {
+          year: 'numeric',
+          month: 'short',
+          day: 'numeric',
+          hour: '2-digit',
+          minute: '2-digit'
+        })
+      : 'Never';
+
+    const li = document.createElement('li');
+    li.className = 'credential-row';
+    li.dataset.id = cred.id;
+    if (cred.aaguid) li.dataset.aaguid = cred.aaguid;
+
+    const iconHtml = providerIcon
+      ? `<img class="provider-icon" src="${providerIcon}" alt="${displayName} icon" width="36" height="36" />`
+      : `<div class="provider-icon-fallback" aria-hidden="true">🔑</div>`;
+
+    li.innerHTML = `
+      <div class="credential-main">
+        <div class="credential-icon-box">
+          ${iconHtml}
+        </div>
+        <div class="credential-info">
+          <div class="credential-name" title="${displayName}">${displayName}</div>
+          <div class="credential-meta">
+            <span class="meta-item credential-registered">Registered: <time>${registeredDate}</time></span>
+            <span class="meta-separator">•</span>
+            <span class="meta-item credential-last-used">Last used: <time>${lastUsedDate}</time></span>
+          </div>
+        </div>
+      </div>
+      <div class="credential-actions">
+        <button type="button" class="btn btn-sm btn-rename" data-id="${cred.id}" aria-label="Rename ${displayName}">Rename</button>
+        <button type="button" class="btn btn-sm btn-delete" data-id="${cred.id}" aria-label="Delete ${displayName}">Delete</button>
+      </div>
+    `;
+
+    // Attach row button events
+    const renameBtn = li.querySelector('.btn-rename');
+    const deleteBtn = li.querySelector('.btn-delete');
+
+    if (renameBtn) {
+      renameBtn.addEventListener('click', () => handleCredentialRename(cred.id, displayName));
+    }
+    if (deleteBtn) {
+      deleteBtn.addEventListener('click', () => performDelete(cred.id));
+    }
+
+    ul.appendChild(li);
+  });
+
+  container.appendChild(ul);
+}
+
+/**
+ * Handle deletion of a passkey credential and sync immediately.
+ */
+export async function performDelete(credentialId) {
+  try {
+    const response = await deleteFetch(credentialId);
+    if (response.ok) {
+      const updatedResponse = await listFetch();
+      const updatedList = await updatedResponse.json();
+
+      renderUI(updatedList);
+      // Sync after deletion
+      await syncAcceptedCredentials(updatedList);
+    }
+  } catch (err) {
+    console.error('Delete error:', err);
+  }
+}
+
+/**
+ * Handle rename of user or display name and sync immediately with Signal API.
+ */
+export async function performRename(relyingPartyId, userId, updatedName, updatedDisplayName) {
+  const response = await renameFetch({ name: updatedName, displayName: updatedDisplayName });
+  if (response.ok) {
+    try {
+      if (typeof window !== 'undefined' && window.PublicKeyCredential && typeof PublicKeyCredential.signalCurrentUserDetails === 'function') {
+        const currentRpId = relyingPartyId || (window.location && window.location.hostname) || rpId;
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId: currentRpId, // RP ID must match the one defined on the server
+          userId: toBase64Url(userId || base64UrlUserId), // Base64URL-encoded user ID
+          name: updatedName, // Updated username
+          displayName: updatedDisplayName // Updated display name
+        });
+      }
+    } catch (e) {
+      console.error('SignalCurrentUserDetails sync failure:', e);
+    }
+  }
+}
+
+/**
+ * Handle individual credential rename.
+ */
+async function handleCredentialRename(credentialId, currentName) {
+  if (typeof prompt !== 'function') return;
+  const newName = prompt('Enter a new name for this passkey:', currentName);
+  if (newName && newName.trim() && newName.trim() !== currentName) {
+    const response = await renameFetch({ id: credentialId, name: newName.trim() });
+    if (response.ok) {
+      const updatedResponse = await listFetch();
+      const updatedList = await updatedResponse.json();
+      renderUI(updatedList);
+    }
+  }
+}
+
+/**
+ * Check if passkeys are supported via PublicKeyCredential.getClientCapabilities.
+ */
+export async function checkPasskeySupport() {
+  if (typeof window === 'undefined' || typeof window.PublicKeyCredential === 'undefined') {
+    return false;
+  }
+  if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+    try {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (!capabilities) return false;
+      if (capabilities.userVerifyingPlatformAuthenticator === false || capabilities.passkeyPlatformAuthenticator === false) {
+        return false;
+      }
+      return true;
+    } catch (e) {
+      console.error('getClientCapabilities check error:', e);
+      return false;
+    }
+  }
+  if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+    try {
+      return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    } catch (e) {
+      return false;
+    }
+  }
+  return false;
+}
+
+/**
+ * Gate the "Create Passkey" button based on client capabilities.
+ */
+export async function initCreatePasskeyButton() {
+  if (typeof document === 'undefined') return;
+
+  const createPasskeyBtn = document.getElementById('create-passkey-btn');
+  const unsupportedMsg = document.getElementById('passkey-unsupported-msg');
+
+  const supported = await checkPasskeySupport();
+
+  if (supported) {
+    if (createPasskeyBtn) {
+      createPasskeyBtn.style.display = 'inline-flex';
+      createPasskeyBtn.removeAttribute('hidden');
+    }
+    if (unsupportedMsg) {
+      unsupportedMsg.style.display = 'none';
+      unsupportedMsg.setAttribute('hidden', '');
+    }
+  } else {
+    if (createPasskeyBtn) {
+      createPasskeyBtn.style.display = 'none';
+      createPasskeyBtn.setAttribute('hidden', '');
+    }
+    if (unsupportedMsg) {
+      unsupportedMsg.style.display = 'block';
+      unsupportedMsg.removeAttribute('hidden');
+    }
+  }
+}
+
+/**
+ * Trigger passkey registration.
+ */
+export async function createPasskey() {
+  try {
+    const challenge = new Uint8Array(32);
+    if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
+      crypto.getRandomValues(challenge);
+    }
+    const userIdBuffer = new TextEncoder().encode(base64UrlUserId);
+    const currentRpId = typeof window !== 'undefined' && window.location && window.location.hostname
+      ? window.location.hostname
+      : rpId;
+
+    const creationOptions = {
+      publicKey: {
+        rp: {
+          name: 'The Daily Grind',
+          id: currentRpId
+        },
+        user: {
+          id: userIdBuffer,
+          name: 'jane.doe@dailygrind.coffee',
+          displayName: 'Jane Doe'
+        },
+        challenge: challenge,
+        pubKeyCredParams: [
+          { type: 'public-key', alg: -7 },
+          { type: 'public-key', alg: -257 }
+        ],
+        timeout: 60000,
+        authenticatorSelection: {
+          // Allow registering a security key by omitting authenticatorAttachment
+          residentKey: 'preferred',
+          requireResidentKey: false,
+          userVerification: 'preferred'
+        }
+      }
+    };
+
+    if (typeof navigator !== 'undefined' && navigator.credentials && navigator.credentials.create) {
+      const credential = await navigator.credentials.create(creationOptions);
+      if (credential) {
+        const updatedResponse = await listFetch();
+        const updatedList = await updatedResponse.json();
+        renderUI(updatedList);
+        await syncAcceptedCredentials(updatedList);
+      }
+    }
+  } catch (err) {
+    console.error('Passkey creation error:', err);
+  }
+}
+
+/**
+ * Main management panel loader.
+ */
+export async function loadManagementPanel() {
+  try {
+    const response = await listFetch();
+    const list = await response.json();
+
+    renderUI(list);
+    // Sync on page load
+    await syncAcceptedCredentials(list);
+  } catch (err) {
+    console.error('Failed to load management panel:', err);
+  }
+}
+
+/**
+ * Setup user profile rename click handlers.
+ */
+function initUserDetailsForm() {
+  if (typeof document === 'undefined') return;
+
+  const userForm = document.getElementById('user-rename-form');
+  const renameTriggerBtn = document.getElementById('btn-rename-user');
+  const userModal = document.getElementById('user-modal');
+  const cancelModalBtn = document.getElementById('btn-cancel-user-modal');
+
+  const usernameInput = document.getElementById('username-input');
+  const displayNameInput = document.getElementById('displayname-input');
+  const currentUsernameEl = document.getElementById('current-username');
+  const currentDisplayNameEl = document.getElementById('current-displayname');
+
+  const details = getLocalUserDetails();
+  if (currentUsernameEl) currentUsernameEl.textContent = details.name;
+  if (currentDisplayNameEl) currentDisplayNameEl.textContent = details.displayName;
+  if (usernameInput) usernameInput.value = details.name;
+  if (displayNameInput) displayNameInput.value = details.displayName;
+
+  if (renameTriggerBtn && userModal) {
+    renameTriggerBtn.addEventListener('click', () => {
+      userModal.classList.add('active');
+    });
+  }
+
+  if (cancelModalBtn && userModal) {
+    cancelModalBtn.addEventListener('click', () => {
+      userModal.classList.remove('active');
+    });
+  }
+
+  if (userForm) {
+    userForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const updatedName = usernameInput.value.trim();
+      const updatedDisplayName = displayNameInput.value.trim();
+
+      await performRename(rpId, base64UrlUserId, updatedName, updatedDisplayName);
+
+      if (currentUsernameEl) currentUsernameEl.textContent = updatedName;
+      if (currentDisplayNameEl) currentDisplayNameEl.textContent = updatedDisplayName;
+      if (userModal) userModal.classList.remove('active');
+    });
+  }
+
+  const saveDetailsBtn = document.getElementById('btn-save-user-details');
+  if (saveDetailsBtn) {
+    saveDetailsBtn.addEventListener('click', async () => {
+      const updatedName = usernameInput ? usernameInput.value.trim() : details.name;
+      const updatedDisplayName = displayNameInput ? displayNameInput.value.trim() : details.displayName;
+
+      await performRename(rpId, base64UrlUserId, updatedName, updatedDisplayName);
+
+      if (currentUsernameEl) currentUsernameEl.textContent = updatedName;
+      if (currentDisplayNameEl) currentDisplayNameEl.textContent = updatedDisplayName;
+      if (userModal) userModal.classList.remove('active');
+    });
+  }
+}
+
+// Expose functions globally for testing and interactive handlers
+if (typeof window !== 'undefined') {
+  window.syncAcceptedCredentials = syncAcceptedCredentials;
+  window.loadManagementPanel = loadManagementPanel;
+  window.performDelete = performDelete;
+  window.performRename = performRename;
+  window.createPasskey = createPasskey;
+  window.checkPasskeySupport = checkPasskeySupport;
+  window.initCreatePasskeyButton = initCreatePasskeyButton;
+}
+
+/**
+ * DOMContentLoaded initialization.
+ */
+if (typeof document !== 'undefined') {
+  document.addEventListener('DOMContentLoaded', async () => {
+    await loadAaguidRegistry();
+    await initCreatePasskeyButton();
+    initUserDetailsForm();
+
+    const createPasskeyBtn = document.getElementById('create-passkey-btn');
+    if (createPasskeyBtn) {
+      createPasskeyBtn.addEventListener('click', createPasskey);
+    }
+
+    await loadManagementPanel();
+  });
+}
