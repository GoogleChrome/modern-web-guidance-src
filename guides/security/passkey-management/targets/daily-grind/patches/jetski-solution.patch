+/**
+ * Client-side API functions for Passkey Management.
+ */
+
+// Base64URL-encoded User ID string
+export const base64UrlUserId = "M2YPl-KGnA8";
+export const rpId = typeof window !== 'undefined' && window.location && window.location.hostname
+  ? window.location.hostname
+  : "localhost";
+
+// Fallback initial data in case the server is a static file host
+const INITIAL_CREDENTIALS = [
+  {
+    id: "cred_gpm_01",
+    aaguid: "ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4",
+    name: "Google Password Manager",
+    registeredAt: 1729000000000,
+    lastUsedAt: 1739000000000
+  },
+  {
+    id: "cred_icloud_02",
+    aaguid: "b5397666-4885-aa6b-cebf-e52262a439a2",
+    name: "iCloud Keychain",
+    registeredAt: 1725000000000,
+    lastUsedAt: 1738500000000
+  },
+  {
+    id: "cred_yubikey_03",
+    aaguid: "ee882879-721c-4916-ad4e-57c7f157f3ee",
+    name: "Backup Security Key",
+    registeredAt: 1720000000000,
+    lastUsedAt: 1737000000000
+  }
+];
+
+const STORAGE_KEY = 'daily_grind_passkeys';
+const USER_STORAGE_KEY = 'daily_grind_user';
+
+export function getLocalCredentials() {
+  try {
+    if (typeof localStorage !== 'undefined') {
+      const raw = localStorage.getItem(STORAGE_KEY);
+      if (raw) return JSON.parse(raw);
+    }
+  } catch (e) {}
+  return [...INITIAL_CREDENTIALS];
+}
+
+export function saveLocalCredentials(list) {
+  try {
+    if (typeof localStorage !== 'undefined') {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
+    }
+  } catch (e) {}
+}
+
+export function deleteLocalCredential(id) {
+  const list = getLocalCredentials().filter(c => c.id !== id);
+  saveLocalCredentials(list);
+  return list;
+}
+
+export function updateLocalCredential(id, data) {
+  const list = getLocalCredentials().map(c => {
+    if (c.id === id) {
+      return { ...c, ...data };
+    }
+    return c;
+  });
+  saveLocalCredentials(list);
+  return list;
+}
+
+export function getLocalUserDetails() {
+  try {
+    if (typeof localStorage !== 'undefined') {
+      const raw = localStorage.getItem(USER_STORAGE_KEY);
+      if (raw) return JSON.parse(raw);
+    }
+  } catch (e) {}
+  return {
+    name: 'jane.doe@dailygrind.coffee',
+    displayName: 'Jane Doe'
+  };
+}
+
+export function saveLocalUserDetails(details) {
+  try {
+    if (typeof localStorage !== 'undefined') {
+      localStorage.setItem(USER_STORAGE_KEY, JSON.stringify(details));
+    }
+  } catch (e) {}
+}
+
+/**
+ * Encodes string, Uint8Array or ArrayBuffer into Base64URL string.
+ */
+export function toBase64Url(input) {
+  if (!input) return '';
+  let base64 = '';
+  if (typeof input === 'string') {
+    if (/^[A-Za-z0-9_-]+$/.test(input)) {
+      return input;
+    }
+    if (typeof btoa === 'function') {
+      base64 = btoa(unescape(encodeURIComponent(input)));
+    } else if (typeof Buffer !== 'undefined') {
+      base64 = Buffer.from(input, 'utf-8').toString('base64');
+    }
+  } else {
+    const bytes = new Uint8Array(input);
+    if (typeof Buffer !== 'undefined') {
+      base64 = Buffer.from(bytes).toString('base64');
+    } else {
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      base64 = btoa(binary);
+    }
+  }
+  return base64.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+/**
+ * Fetch all registered passkeys from credential endpoint.
+ */
+export async function listFetch() {
+  try {
+    if (typeof fetch === 'function') {
+      const res = await fetch('/api/credentials');
+      if (res && res.ok) {
+        return res;
+      }
+    }
+  } catch (err) {}
+
+  const list = getLocalCredentials();
+  return new Response(JSON.stringify(list), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/**
+ * Delete a specific credential by ID.
+ */
+export async function deleteFetch(id) {
+  try {
+    if (typeof fetch === 'function') {
+      const res = await fetch(`/api/credential/${encodeURIComponent(id)}`, {
+        method: 'DELETE',
+        headers: {
+          'Content-Type': 'application/json'
+        }
+      });
+      if (res && res.ok) {
+        deleteLocalCredential(id);
+        return res;
+      }
+    }
+  } catch (err) {}
+
+  deleteLocalCredential(id);
+  return new Response(JSON.stringify({ success: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/**
+ * Update user account details (name and displayName).
+ */
+export async function updateUserFetch({ name, displayName }) {
+  try {
+    if (typeof fetch === 'function') {
+      const res = await fetch('/api/user', {
+        method: 'PUT',
+        headers: {
+          'Content-Type': 'application/json'
+        },
+        body: JSON.stringify({ name, displayName })
+      });
+      if (res && res.ok) {
+        saveLocalUserDetails({ name, displayName });
+        return res;
+      }
+    }
+  } catch (err) {}
+
+  saveLocalUserDetails({ name, displayName });
+  return new Response(JSON.stringify({ name, displayName }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/**
+ * Update credential custom nickname.
+ */
+export async function renameCredentialFetch(id, { name }) {
+  try {
+    if (typeof fetch === 'function') {
+      const res = await fetch(`/api/credential/${encodeURIComponent(id)}`, {
+        method: 'PUT',
+        headers: {
+          'Content-Type': 'application/json'
+        },
+        body: JSON.stringify({ name })
+      });
+      if (res && res.ok) {
+        updateLocalCredential(id, { name });
+        return res;
+      }
+    }
+  } catch (err) {}
+
+  updateLocalCredential(id, { name });
+  return new Response(JSON.stringify({ id, name }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' }
+  });
+}
+
+/**
+ * Universal rename fetch helper supporting both credentials and users.
+ */
+export async function renameFetch({ name, displayName, id }) {
+  if (id) {
+    return renameCredentialFetch(id, { name });
+  }
+  return updateUserFetch({ name, displayName });
+}
