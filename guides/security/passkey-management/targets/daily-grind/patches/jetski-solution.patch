@@ -0,0 +1,187 @@
+import express from 'express';
+import crypto from 'node:crypto';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import aaguids from './aaguids.json' with { type: 'json' };
+import { db } from './db.js';
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+export const app = express();
+export const router = express.Router();
+
+app.use(express.json());
+
+/**
+ * Middleware ensuring the signed-in customer session is attached to `req.user`.
+ */
+export async function checkUserAuthenticated(req, res, next) {
+  const user = await db.findUserById(db.DEFAULT_USER_ID);
+  if (!user) {
+    return res.status(401).json({ error: 'Authentication required.' });
+  }
+  req.user = user;
+  next();
+}
+
+// 1. List all user credentials
+router.get('/api/credentials', checkUserAuthenticated, async (req, res) => {
+  const list = await db.findCredentialsByUserId(req.user.id);
+  return res.json(list);
+});
+
+// 2. Update credential names
+router.put('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+  const { id } = req.params;
+  const { name } = req.body || {};
+  const cred = await db.findCredentialById(id);
+  if (!cred || cred.passkeyUserId !== req.user.id) {
+    return res.status(404).json({ error: 'Credential not found.' });
+  }
+  cred.name = typeof name === 'string' && name.trim() ? name.trim() : cred.name;
+  await db.saveCredential(cred);
+  return res.json(cred);
+});
+
+// 3. Delete credentials
+router.delete('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+  const { id } = req.params;
+  const cred = await db.findCredentialById(id);
+  if (!cred || cred.passkeyUserId !== req.user.id) {
+    return res.status(404).json({ error: 'Credential not found.' });
+  }
+  await db.deleteCredential(id);
+  return res.json({ success: true });
+});
+
+// 4. Get & Update user account details
+router.get('/api/user', checkUserAuthenticated, async (req, res) => {
+  return res.json({
+    ...req.user,
+    rpId: req.hostname || 'localhost',
+  });
+});
+
+router.put('/api/user', checkUserAuthenticated, async (req, res) => {
+  const { name, displayName } = req.body || {};
+  const updatedUser = await db.updateUser(req.user.id, { name, displayName });
+  return res.json(updatedUser);
+});
+
+// 5. Passkey Registration Options (omits authenticatorSelection.authenticatorAttachment)
+async function handleRegisterOptions(req, res) {
+  const existingCredentials = await db.findCredentialsByUserId(req.user.id);
+  const challenge = crypto.randomBytes(32).toString('base64url');
+  const rpId = req.hostname || 'localhost';
+
+  const options = {
+    rp: {
+      name: 'The Daily Grind',
+      id: rpId,
+    },
+    user: {
+      id: req.user.id,
+      name: req.user.name,
+      displayName: req.user.displayName,
+    },
+    challenge,
+    pubKeyCredParams: [
+      { alg: -7, type: 'public-key' },
+      { alg: -257, type: 'public-key' },
+    ],
+    timeout: 60000,
+    excludeCredentials: existingCredentials.map((cred) => ({
+      id: cred.id,
+      type: 'public-key',
+      transports: cred.transports || ['internal', 'hybrid'],
+    })),
+    // Omit authenticatorAttachment so users can register either a platform passkey or a security key
+    authenticatorSelection: {
+      residentKey: 'preferred',
+      userVerification: 'preferred',
+    },
+    attestation: 'none',
+  };
+
+  return res.json(options);
+}
+
+router.post('/api/register-options', checkUserAuthenticated, handleRegisterOptions);
+router.get('/api/register-options', checkUserAuthenticated, handleRegisterOptions);
+router.post('/api/registerRequest', checkUserAuthenticated, handleRegisterOptions);
+
+// 6. Verify Registration & Determine Passkey Provider from AAGUID
+async function handleRegisterVerify(req, res) {
+  const body = req.body || {};
+  const registrationInfo = {
+    aaguid: body.aaguid || 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+    id: body.id || body.rawId || crypto.randomBytes(16).toString('base64url'),
+    publicKey: body.response?.attestationObject || '',
+    transports: body.response?.transports || ['internal', 'hybrid'],
+  };
+
+  const { aaguid } = registrationInfo;
+  let credential;
+
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    // Use the device name as the passkey provider based on the user agent string,
+    // or fallback to "Unknown passkey provider"
+    const ua = req.headers['user-agent'] || '';
+    let fallbackName = 'Unknown passkey provider';
+    if (/Macintosh|Mac OS X/i.test(ua)) {
+      fallbackName = 'Mac Passkey (Unknown passkey provider)';
+    } else if (/Windows/i.test(ua)) {
+      fallbackName = 'Windows Passkey (Unknown passkey provider)';
+    }
+    credential = {
+      id: registrationInfo.id,
+      passkeyUserId: req.user.id,
+      aaguid,
+      name: fallbackName,
+      providerIcon: undefined,
+      publicKey: registrationInfo.publicKey,
+      transports: registrationInfo.transports,
+      registeredAt: Date.now(),
+      lastUsedAt: Date.now(),
+    };
+  } else {
+    const provider = aaguids[aaguid];
+    credential = {
+      id: registrationInfo.id,
+      passkeyUserId: req.user.id,
+      aaguid,
+      name: provider?.name || 'Unknown passkey provider',
+      providerIcon: provider?.icon_light,
+      publicKey: registrationInfo.publicKey,
+      transports: registrationInfo.transports,
+      registeredAt: Date.now(),
+      lastUsedAt: Date.now(),
+    };
+  }
+
+  await db.saveCredential(credential);
+  return res.json(credential);
+}
+
+router.post('/api/register-verify', checkUserAuthenticated, handleRegisterVerify);
+router.post('/api/registerResponse', checkUserAuthenticated, handleRegisterVerify);
+router.post('/api/credentials', checkUserAuthenticated, handleRegisterVerify);
+
+app.use(router);
+
+// Serve static assets and HTML pages
+app.use(express.static(__dirname));
+
+app.get('/account', (_req, res) => {
+  res.sendFile(path.join(__dirname, 'account', 'index.html'));
+});
+
+if (process.argv[1] && path.resolve(process.argv[1]) === __filename) {
+  const port = Number(process.env.PORT) || 11222;
+  app.listen(port, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${port}`);
+  });
+}
+
+export default app;
