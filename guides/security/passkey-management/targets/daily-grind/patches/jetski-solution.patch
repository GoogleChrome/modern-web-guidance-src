index 0000000..8194c45
--- /dev/null
+++ b/account.js
@@ -0,0 +1,547 @@
+import 'webauthn-polyfills';
+import aaguids from './aaguids.json' with { type: 'json' };
+import {
+  listFetch,
+  renameCredentialFetch,
+  updateUserFetch,
+  deleteFetch,
+  getUserFetch,
+  registerOptionsFetch,
+  registerVerifyFetch,
+} from './api.js';
+
+// Fallback dynamic import if parseRequestOptionsFromJSON is missing
+if (typeof window !== 'undefined' && window.PublicKeyCredential && !PublicKeyCredential.parseRequestOptionsFromJSON) {
+  import('webauthn-polyfills').catch(() => {});
+}
+
+const DEFAULT_FALLBACK_ICON =
+  'data:image/svg+xml;base64,';
+
+// Base64URL-encoded User ID string
+let base64UrlUserId = 'M2YPl-KGnA8';
+let rpId = typeof window !== 'undefined' && window.location.hostname ? window.location.hostname : 'localhost';
+
+/**
+ * Ensures a value is encoded as a valid Base64URL string (no '+', '/', or '=').
+ */
+export function ensureBase64Url(value) {
+  const str = String(value || '');
+  if (!str) return '';
+  if (/^[A-Za-z0-9\-_]+$/.test(str)) {
+    return str;
+  }
+  try {
+    const bytes = new TextEncoder().encode(str);
+    let binary = '';
+    for (let i = 0; i < bytes.length; i++) {
+      binary += String.fromCharCode(bytes[i]);
+    }
+    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  } catch {
+    return str.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  }
+}
+
+function escapeHtml(str) {
+  return String(str ?? '')
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+function formatEpochDate(epochValue) {
+  if (epochValue === null || epochValue === undefined || epochValue === '') {
+    return null;
+  }
+  const num = Number(epochValue);
+  if (Number.isNaN(num) || num <= 0) {
+    return String(epochValue);
+  }
+  const ms = num < 1e12 ? num * 1000 : num;
+  const date = new Date(ms);
+  return date.toLocaleDateString('en-US', {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+  });
+}
+
+function formatIsoDate(epochValue) {
+  const num = Number(epochValue);
+  if (!num || Number.isNaN(num) || num <= 0) return '';
+  const ms = num < 1e12 ? num * 1000 : num;
+  return new Date(ms).toISOString();
+}
+
+/**
+ * Determine passkey provider details from AAGUID using local aaguids.json registry.
+ * Skips registry lookup when AAGUID equals '00000000-0000-0000-0000-000000000000'.
+ */
+export function getCredentialDetailsFromAaguid(registrationInfo) {
+  const { aaguid } = registrationInfo || {};
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      ...registrationInfo,
+      aaguid: aaguid || '00000000-0000-0000-0000-000000000000',
+      name: registrationInfo?.name || 'Unknown passkey provider',
+      providerName: 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  } else {
+    const provider = aaguids[aaguid];
+    const credential = {
+      ...registrationInfo,
+      aaguid,
+      name: registrationInfo?.name || provider?.name || 'Unknown passkey provider',
+      providerName: provider?.name || 'Unknown passkey provider',
+      providerIcon: registrationInfo?.providerIcon || provider?.icon_light,
+    };
+    return credential;
+  }
+}
+
+function showStatusBanner(message, type = 'success') {
+  const banner = document.getElementById('management-status');
+  if (!banner) return;
+  banner.textContent = message;
+  banner.className = `management-status status-${type}`;
+  banner.hidden = false;
+}
+
+/**
+ * Synchronize all accepted credential IDs with the browser's password manager via Signal API.
+ */
+export async function syncAcceptedCredentials(currentCredentialsList) {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) {
+    return;
+  }
+  try {
+    const credentialIds = (currentCredentialsList || []).map((c) => ensureBase64Url(c.id));
+
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId: ensureBase64Url(base64UrlUserId),
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    console.error('SignalAllAcceptedCredentials sync failure:', e);
+  }
+}
+
+/**
+ * Feature-detect platform passkey support via PublicKeyCredential.getClientCapabilities()
+ * before rendering the "Create passkey" button.
+ */
+export async function updatePasskeyCreationCapabilityUI() {
+  const createBtn = document.getElementById('create-passkey-btn');
+  const mfaFallback = document.getElementById('mfa-fallback-banner');
+  const capabilityPill = document.getElementById('capability-status-pill');
+
+  let isPlatformSupported = false;
+
+  if (typeof window !== 'undefined' && window.PublicKeyCredential && PublicKeyCredential.getClientCapabilities) {
+    try {
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      isPlatformSupported = Boolean(
+        capabilities?.passkeyPlatformAuthenticator ||
+          capabilities?.userVerifyingPlatformAuthenticator
+      );
+    } catch (e) {
+      console.error('Error checking client capabilities:', e);
+      isPlatformSupported = false;
+    }
+  }
+
+  if (isPlatformSupported) {
+    if (createBtn) {
+      createBtn.hidden = false;
+      createBtn.style.display = 'inline-flex';
+    }
+    if (mfaFallback) {
+      mfaFallback.hidden = true;
+      mfaFallback.style.display = 'none';
+    }
+    if (capabilityPill) {
+      capabilityPill.textContent = 'Passkey Authenticator Ready';
+      capabilityPill.className = 'capability-pill capability-ready';
+    }
+  } else {
+    if (createBtn) {
+      createBtn.hidden = true;
+      createBtn.style.display = 'none';
+    }
+    if (mfaFallback) {
+      mfaFallback.hidden = false;
+      mfaFallback.style.display = 'flex';
+    }
+    if (capabilityPill) {
+      capabilityPill.textContent = 'Standard MFA Mode';
+      capabilityPill.className = 'capability-pill capability-fallback';
+    }
+  }
+
+  return isPlatformSupported;
+}
+
+/**
+ * Render the list of registered passkeys or an empty-state message.
+ */
+export function renderUI(list) {
+  const container = document.getElementById('passkey-list');
+  const countBadge = document.getElementById('passkey-count-badge');
+  if (!container) return;
+
+  const credentials = Array.isArray(list) ? list : [];
+  if (countBadge) {
+    countBadge.textContent = `${credentials.length} ${credentials.length === 1 ? 'passkey' : 'passkeys'}`;
+  }
+
+  if (credentials.length === 0) {
+    container.innerHTML = `
+      <div class="passkey-empty-state" id="passkey-empty-state" role="status">
+        <div class="empty-state-icon" aria-hidden="true">🔑</div>
+        <h3>No passkeys found</h3>
+        <p>You don't have any passkeys registered to your Daily Grind account yet. Create a passkey for faster, phishing-resistant sign-in.</p>
+      </div>
+    `;
+    return;
+  }
+
+  container.innerHTML = credentials
+    .map((rawCred) => {
+      const cred = getCredentialDetailsFromAaguid(rawCred);
+      const iconSrc = cred.providerIcon || DEFAULT_FALLBACK_ICON;
+      const registeredFormatted = formatEpochDate(cred.registeredAt) || 'Unknown date';
+      const registeredIso = formatIsoDate(cred.registeredAt);
+      const lastUsedFormatted = formatEpochDate(cred.lastUsedAt);
+      const lastUsedIso = formatIsoDate(cred.lastUsedAt);
+      const showProviderSubtitle =
+        cred.providerName &&
+        cred.name &&
+        cred.name.toLowerCase() !== cred.providerName.toLowerCase();
+
+      return `
+        <article class="passkey-row" data-credential-id="${escapeHtml(cred.id)}" data-aaguid="${escapeHtml(cred.aaguid)}">
+          <div class="passkey-row-main">
+            <div class="passkey-icon-wrapper">
+              <img
+                class="passkey-provider-icon"
+                src="${escapeHtml(iconSrc)}"
+                alt="${escapeHtml(cred.providerName || cred.name)} icon"
+                width="36"
+                height="36"
+              />
+            </div>
+            <div class="passkey-details">
+              <div class="passkey-title-group">
+                <span class="passkey-name" data-testid="passkey-name">${escapeHtml(cred.name)}</span>
+                ${
+                  showProviderSubtitle
+                    ? `<span class="passkey-provider-badge">${escapeHtml(cred.providerName)}</span>`
+                    : ''
+                }
+              </div>
+              <div class="passkey-timestamps">
+                <span class="passkey-date registered-at" data-timestamp="${escapeHtml(cred.registeredAt)}">
+                  Created: <time datetime="${escapeHtml(registeredIso)}">${escapeHtml(registeredFormatted)}</time>
+                </span>
+                <span class="timestamp-divider" aria-hidden="true">&bull;</span>
+                <span class="passkey-date last-used-at" data-timestamp="${escapeHtml(cred.lastUsedAt ?? '')}">
+                  Last used: ${
+                    lastUsedFormatted
+                      ? `<time datetime="${escapeHtml(lastUsedIso)}">${escapeHtml(lastUsedFormatted)}</time>`
+                      : '<span>Never</span>'
+                  }
+                </span>
+              </div>
+            </div>
+          </div>
+
+          <div class="passkey-row-actions">
+            <div class="rename-inline-group">
+              <label class="sr-only" for="rename-input-${escapeHtml(cred.id)}">Passkey nickname for ${escapeHtml(cred.name)}</label>
+              <input
+                type="text"
+                id="rename-input-${escapeHtml(cred.id)}"
+                class="passkey-rename-input"
+                value="${escapeHtml(cred.name)}"
+                data-original-name="${escapeHtml(cred.name)}"
+                placeholder="Passkey nickname"
+                aria-label="Passkey nickname"
+              />
+            </div>
+            <button
+              type="button"
+              class="btn-action btn-rename rename-btn"
+              data-action="rename"
+              data-credential-id="${escapeHtml(cred.id)}"
+            >
+              Rename
+            </button>
+            <button
+              type="button"
+              class="btn-action btn-delete delete-btn"
+              data-action="delete"
+              data-credential-id="${escapeHtml(cred.id)}"
+            >
+              Delete
+            </button>
+          </div>
+        </article>
+      `;
+    })
+    .join('');
+
+  // Attach per-row event listeners for Rename and Delete buttons
+  const rows = container.querySelectorAll('.passkey-row');
+  rows.forEach((row) => {
+    const credentialId = row.getAttribute('data-credential-id');
+    const renameBtn = row.querySelector('.rename-btn');
+    const deleteBtn = row.querySelector('.delete-btn');
+    const renameInput = row.querySelector('.passkey-rename-input');
+
+    if (renameInput) {
+      renameInput.addEventListener('keydown', async (e) => {
+        if (e.key === 'Enter') {
+          e.preventDefault();
+          const newName = renameInput.value.trim();
+          if (newName && credentialId) {
+            await performCredentialRename(credentialId, newName);
+          }
+        }
+      });
+    }
+
+    if (renameBtn && credentialId) {
+      renameBtn.addEventListener('click', async () => {
+        const originalName = renameInput?.getAttribute('data-original-name') || '';
+        const currentInputVal = renameInput ? renameInput.value.trim() : '';
+
+        let newCredentialName = currentInputVal;
+        if (!newCredentialName || newCredentialName === originalName) {
+          if (typeof window !== 'undefined' && typeof window.prompt === 'function') {
+            try {
+              const prompted = window.prompt('Enter a new nickname for this passkey:', originalName);
+              if (typeof prompted === 'string' && prompted.trim()) {
+                newCredentialName = prompted.trim();
+              }
+            } catch {
+              // Ignore prompt errors in headless environments
+            }
+          }
+        }
+        if (!newCredentialName) {
+          newCredentialName = originalName || 'Passkey';
+        }
+        await performCredentialRename(credentialId, newCredentialName);
+      });
+    }
+
+    if (deleteBtn && credentialId) {
+      deleteBtn.addEventListener('click', async () => {
+        await performDelete(credentialId);
+      });
+    }
+  });
+}
+
+/**
+ * Delete a credential on the server and synchronize remaining accepted credentials via Signal API.
+ */
+export async function performDelete(credentialId) {
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+
+    renderUI(updatedList);
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(updatedList);
+    showStatusBanner('Passkey deleted and synchronized with your authenticator.', 'success');
+  }
+}
+
+/**
+ * Rename a passkey's nickname on the server only (does NOT invoke signalCurrentUserDetails).
+ */
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const response = await renameCredentialFetch(credentialId, { name: newCredentialName });
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    renderUI(await updatedResponse.json());
+    showStatusBanner(`Passkey renamed to "${newCredentialName}".`, 'success');
+  }
+}
+
+/**
+ * Update the signed-in user's account username (name) and displayName on the server
+ * and immediately synchronize with the password manager via PublicKeyCredential.signalCurrentUserDetails().
+ */
+export async function performUserRename(currentRpId, userId, updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({ name: updatedName, displayName: updatedDisplayName });
+  if (response.ok) {
+    if (typeof window !== 'undefined' && window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId: currentRpId || rpId,
+          userId: ensureBase64Url(userId || base64UrlUserId),
+          name: updatedName,
+          displayName: updatedDisplayName,
+        });
+      } catch (e) {
+        console.error('SignalCurrentUserDetails sync failure:', e);
+      }
+    }
+    const profileHeading = document.getElementById('account-profile-display-name');
+    const profileEmail = document.getElementById('account-profile-username');
+    if (profileHeading && updatedDisplayName) profileHeading.textContent = updatedDisplayName;
+    if (profileEmail && updatedName) profileEmail.textContent = updatedName;
+    showStatusBanner('Account profile updated and synchronized with your passkey provider.', 'success');
+  }
+}
+
+/**
+ * Register a new passkey or security key (omitting authenticatorSelection.authenticatorAttachment).
+ */
+export async function performCreatePasskey() {
+  try {
+    const optionsRes = await registerOptionsFetch();
+    const rawOptions = await optionsRes.json();
+
+    // Omit authenticatorSelection.authenticatorAttachment to allow registering security keys as well
+    const creationOptionsJSON = {
+      ...rawOptions,
+      authenticatorSelection: {
+        ...(rawOptions.authenticatorSelection || {}),
+        residentKey: rawOptions.authenticatorSelection?.residentKey || 'preferred',
+        userVerification: rawOptions.authenticatorSelection?.userVerification || 'preferred',
+      },
+    };
+    if (
+      creationOptionsJSON.authenticatorSelection &&
+      'authenticatorAttachment' in creationOptionsJSON.authenticatorSelection
+    ) {
+      delete creationOptionsJSON.authenticatorSelection.authenticatorAttachment;
+    }
+
+    let publicKey = creationOptionsJSON;
+    if (
+      typeof window !== 'undefined' &&
+      window.PublicKeyCredential &&
+      typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function'
+    ) {
+      try {
+        publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+      } catch {
+        publicKey = creationOptionsJSON;
+      }
+    }
+
+    if (publicKey.authenticatorSelection && 'authenticatorAttachment' in publicKey.authenticatorSelection) {
+      delete publicKey.authenticatorSelection.authenticatorAttachment;
+    }
+
+    const credential = await navigator.credentials.create({ publicKey });
+    if (!credential) return;
+
+    const serialized = typeof credential.toJSON === 'function' ? credential.toJSON() : credential;
+    const verifyRes = await registerVerifyFetch(serialized);
+    if (verifyRes.ok) {
+      const updatedResponse = await listFetch();
+      const updatedList = await updatedResponse.json();
+      renderUI(updatedList);
+      await syncAcceptedCredentials(updatedList);
+      showStatusBanner('New passkey registered and synchronized.', 'success');
+    }
+  } catch (e) {
+    console.error('Passkey creation error:', e);
+    showStatusBanner('Passkey registration was cancelled or could not be completed.', 'warning');
+  }
+}
+
+function bindStaticControls() {
+  const userForm = document.getElementById('user-profile-form');
+  const updateUserBtn = document.getElementById('update-user-btn');
+  const createPasskeyBtn = document.getElementById('create-passkey-btn');
+
+  if (userForm && !userForm.dataset.bound) {
+    userForm.dataset.bound = 'true';
+    userForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const nameInput = document.getElementById('user-name-input');
+      const displayNameInput = document.getElementById('user-display-name-input');
+      const updatedName = nameInput ? nameInput.value.trim() : '';
+      const updatedDisplayName = displayNameInput ? displayNameInput.value.trim() : '';
+      if (updatedName || updatedDisplayName) {
+        await performUserRename(rpId, base64UrlUserId, updatedName, updatedDisplayName);
+      }
+    });
+  } else if (updateUserBtn && !updateUserBtn.dataset.bound) {
+    updateUserBtn.dataset.bound = 'true';
+    updateUserBtn.addEventListener('click', async () => {
+      const nameInput = document.getElementById('user-name-input');
+      const displayNameInput = document.getElementById('user-display-name-input');
+      const updatedName = nameInput ? nameInput.value.trim() : '';
+      const updatedDisplayName = displayNameInput ? displayNameInput.value.trim() : '';
+      if (updatedName || updatedDisplayName) {
+        await performUserRename(rpId, base64UrlUserId, updatedName, updatedDisplayName);
+      }
+    });
+  }
+
+  if (createPasskeyBtn && !createPasskeyBtn.dataset.bound) {
+    createPasskeyBtn.dataset.bound = 'true';
+    createPasskeyBtn.addEventListener('click', async () => {
+      await performCreatePasskey();
+    });
+  }
+}
+
+export async function loadManagementPanel() {
+  bindStaticControls();
+
+  try {
+    const userRes = await getUserFetch();
+    if (userRes.ok) {
+      const user = await userRes.json();
+      if (user?.id) base64UrlUserId = ensureBase64Url(user.id);
+      if (user?.rpId) rpId = user.rpId;
+      const nameInput = document.getElementById('user-name-input');
+      const displayNameInput = document.getElementById('user-display-name-input');
+      const profileHeading = document.getElementById('account-profile-display-name');
+      const profileEmail = document.getElementById('account-profile-username');
+      if (nameInput && user.name) nameInput.value = user.name;
+      if (displayNameInput && user.displayName) displayNameInput.value = user.displayName;
+      if (profileHeading && user.displayName) profileHeading.textContent = user.displayName;
+      if (profileEmail && user.name) profileEmail.textContent = user.name;
+    }
+  } catch {
+    // Keep defaults if /api/user is not mocked
+  }
+
+  await updatePasskeyCreationCapabilityUI();
+
+  const response = await listFetch();
+  const list = await response.json();
+
+  renderUI(list);
+  // Sync accepted credentials on initial load
+  await syncAcceptedCredentials(list);
+}
+
+let initialLoadTriggered = false;
+
+if (typeof window !== 'undefined') {
+  window.addEventListener('DOMContentLoaded', () => {
+    initialLoadTriggered = true;
+    loadManagementPanel();
+  });
+
+  if (document.readyState !== 'loading' && !initialLoadTriggered) {
+    initialLoadTriggered = true;
+    loadManagementPanel();
+  }
+}
