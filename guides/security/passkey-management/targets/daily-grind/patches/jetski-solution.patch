+import aaguids from './aaguids.json' with { type: 'json' };
+
+const DEFAULT_USER_ID = 'M2YPl-KGnA8';
+
+let fallbackUser = {
+  id: DEFAULT_USER_ID,
+  name: 'alex.rivera@dailygrind.coffee',
+  displayName: 'Alex Rivera',
+};
+
+let fallbackCredentials = [
+  {
+    id: 'Y3JlZF9ncG1fZGFpbHlncmluZF8wMQ',
+    passkeyUserId: DEFAULT_USER_ID,
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+    name: aaguids['ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4']?.name || 'Google Password Manager',
+    providerIcon: aaguids['ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4']?.icon_light,
+    registeredAt: 1726412400000,
+    lastUsedAt: 1730559600000,
+    transports: ['internal', 'hybrid'],
+  },
+  {
+    id: 'Y3JlZF9pY2xvdWRfZGFpbHlncmluZF8wMg',
+    passkeyUserId: DEFAULT_USER_ID,
+    aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+    name: aaguids['fbfc3007-154e-4ecc-8c0b-6e020557d7bd']?.name || 'iCloud Keychain',
+    providerIcon: aaguids['fbfc3007-154e-4ecc-8c0b-6e020557d7bd']?.icon_light,
+    registeredAt: 1728572400000,
+    lastUsedAt: 1730127600000,
+    transports: ['internal', 'hybrid'],
+  },
+  {
+    id: 'Y3JlZF8xcGFzc3dvcmRfZGFpbHlncmluZF8wMw',
+    passkeyUserId: DEFAULT_USER_ID,
+    aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d',
+    name: aaguids['bada5566-a7aa-401f-bd96-45619a55120d']?.name || '1Password',
+    providerIcon: aaguids['bada5566-a7aa-401f-bd96-45619a55120d']?.icon_light,
+    registeredAt: 1729436400000,
+    lastUsedAt: 1729868400000,
+    transports: ['internal', 'hybrid'],
+  },
+];
+
+function createJsonResponse(data, status = 200) {
+  return new Response(JSON.stringify(data), {
+    status,
+    headers: { 'Content-Type': 'application/json' },
+  });
+}
+
+function isStaticServerFallbackNeeded(response) {
+  if (!response) return true;
+  if (response.ok) return false;
+  const contentType = response.headers?.get?.('content-type') || '';
+  if (contentType.includes('application/json')) {
+    return false;
+  }
+  return response.status === 404 || response.status === 405 || response.status === 501;
+}
+
+export async function listFetch() {
+  try {
+    const response = await fetch('/api/credentials', {
+      method: 'GET',
+      headers: { Accept: 'application/json' },
+    });
+    if (!isStaticServerFallbackNeeded(response)) {
+      return response;
+    }
+  } catch {
+    // Fallback to in-memory store when offline / static server
+  }
+  return createJsonResponse(fallbackCredentials.map((c) => ({ ...c })));
+}
+
+export async function renameCredentialFetch(credentialId, payload) {
+  const { name } = payload || {};
+  try {
+    const response = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ name }),
+    });
+    if (!isStaticServerFallbackNeeded(response)) {
+      return response;
+    }
+  } catch {
+    // Fallback to in-memory store
+  }
+  const target = fallbackCredentials.find((c) => c.id === credentialId);
+  if (!target) {
+    return createJsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  target.name = typeof name === 'string' && name.trim() ? name.trim() : target.name;
+  return createJsonResponse({ ...target });
+}
+
+export async function deleteFetch(credentialId) {
+  try {
+    const response = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'DELETE',
+      headers: { Accept: 'application/json' },
+    });
+    if (!isStaticServerFallbackNeeded(response)) {
+      return response;
+    }
+  } catch {
+    // Fallback to in-memory store
+  }
+  const index = fallbackCredentials.findIndex((c) => c.id === credentialId);
+  if (index === -1) {
+    return createJsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  fallbackCredentials.splice(index, 1);
+  return createJsonResponse({ success: true });
+}
+
+export async function updateUserFetch({ name, displayName }) {
+  try {
+    const response = await fetch('/api/user', {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ name, displayName }),
+    });
+    if (!isStaticServerFallbackNeeded(response)) {
+      return response;
+    }
+  } catch {
+    // Fallback to in-memory store
+  }
+  fallbackUser = {
+    ...fallbackUser,
+    name: typeof name === 'string' && name.trim() ? name.trim() : fallbackUser.name,
+    displayName:
+      typeof displayName === 'string' && displayName.trim()
+        ? displayName.trim()
+        : fallbackUser.displayName,
+  };
+  return createJsonResponse({ ...fallbackUser });
+}
+
+export async function getUserFetch() {
+  try {
+    const response = await fetch('/api/user', {
+      method: 'GET',
+      headers: { Accept: 'application/json' },
+    });
+    if (!isStaticServerFallbackNeeded(response)) {
+      return response;
+    }
+  } catch {
+    // Fallback to in-memory store
+  }
+  return createJsonResponse({
+    ...fallbackUser,
+    rpId: typeof window !== 'undefined' ? window.location.hostname || 'localhost' : 'localhost',
+  });
+}
+
+export async function registerOptionsFetch() {
+  try {
+    const response = await fetch('/api/register-options', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({}),
+    });
+    if (!isStaticServerFallbackNeeded(response)) {
+      return response;
+    }
+  } catch {
+    // Fallback
+  }
+  const rpId = typeof window !== 'undefined' ? window.location.hostname || 'localhost' : 'localhost';
+  return createJsonResponse({
+    rp: { name: 'The Daily Grind', id: rpId },
+    user: {
+      id: fallbackUser.id,
+      name: fallbackUser.name,
+      displayName: fallbackUser.displayName,
+    },
+    challenge: 'Y2hhbGxlbmdlX2RhaWx5X2dyaW5kX3Bhc3NrZXk',
+    pubKeyCredParams: [
+      { alg: -7, type: 'public-key' },
+      { alg: -257, type: 'public-key' },
+    ],
+    timeout: 60000,
+    excludeCredentials: fallbackCredentials.map((c) => ({
+      id: c.id,
+      type: 'public-key',
+      transports: c.transports || ['internal', 'hybrid'],
+    })),
+    authenticatorSelection: {
+      residentKey: 'preferred',
+      userVerification: 'preferred',
+    },
+    attestation: 'none',
+  });
+}
+
+export async function registerVerifyFetch(credentialPayload) {
+  try {
+    const response = await fetch('/api/register-verify', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify(credentialPayload),
+    });
+    if (!isStaticServerFallbackNeeded(response)) {
+      return response;
+    }
+  } catch {
+    // Fallback
+  }
+  const aaguid = credentialPayload?.aaguid || 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4';
+  const id = credentialPayload?.id || `Y3JlZF_${Date.now().toString(36)}`;
+  let newCred;
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    newCred = {
+      id,
+      passkeyUserId: fallbackUser.id,
+      aaguid,
+      name: 'Unknown passkey provider',
+      providerIcon: undefined,
+      registeredAt: Date.now(),
+      lastUsedAt: Date.now(),
+    };
+  } else {
+    const provider = aaguids[aaguid];
+    newCred = {
+      id,
+      passkeyUserId: fallbackUser.id,
+      aaguid,
+      name: provider?.name || 'Unknown passkey provider',
+      providerIcon: provider?.icon_light,
+      registeredAt: Date.now(),
+      lastUsedAt: Date.now(),
+    };
+  }
+  fallbackCredentials.push(newCred);
+  return createJsonResponse({ ...newCred });
+}
