+++ b/db.js
@@ -0,0 +1,170 @@
+import aaguids from './aaguids.json' with { type: 'json' };
+
+const DEFAULT_USER_ID = 'M2YPl-KGnA8';
+
+const users = new Map([
+  [
+    DEFAULT_USER_ID,
+    {
+      id: DEFAULT_USER_ID,
+      name: 'alex.rivera@dailygrind.coffee',
+      displayName: 'Alex Rivera',
+    },
+  ],
+]);
+
+/**
+ * Resolve passkey provider metadata from AAGUID using the local registry.
+ * Skips registry lookup when AAGUID is all zeros.
+ *
+ * @param {object} registrationInfo
+ * @param {string} [userAgent]
+ */
+export function buildCredentialFromRegistration(registrationInfo, userAgent = '') {
+  const {
+    aaguid = '00000000-0000-0000-0000-000000000000',
+    credentialID,
+    id,
+    passkeyUserId = DEFAULT_USER_ID,
+    publicKey = '',
+    counter = 0,
+    transports = ['internal', 'hybrid'],
+    registeredAt = Date.now(),
+    lastUsedAt = Date.now(),
+  } = registrationInfo || {};
+
+  const credId = id || credentialID || `cred_${Date.now().toString(36)}`;
+
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    let fallbackName = 'Unknown passkey provider';
+    if (userAgent) {
+      if (/Macintosh|Mac OS X/i.test(userAgent)) fallbackName = 'Mac Passkey';
+      else if (/Windows/i.test(userAgent)) fallbackName = 'Windows Device Passkey';
+      else if (/iPhone|iPad|iOS/i.test(userAgent)) fallbackName = 'iOS Passkey';
+      else if (/Android/i.test(userAgent)) fallbackName = 'Android Passkey';
+    }
+    return {
+      id: credId,
+      passkeyUserId,
+      aaguid,
+      name: fallbackName,
+      providerIcon: undefined,
+      publicKey,
+      counter,
+      transports,
+      registeredAt,
+      lastUsedAt,
+    };
+  } else {
+    const provider = aaguids[aaguid];
+    const credential = {
+      id: credId,
+      passkeyUserId,
+      aaguid,
+      name: provider?.name || 'Unknown passkey provider',
+      providerIcon: provider?.icon_light,
+      publicKey,
+      counter,
+      transports,
+      registeredAt,
+      lastUsedAt,
+    };
+    return credential;
+  }
+}
+
+const initialCredentials = [
+  {
+    id: 'Y3JlZF9ncG1fZGFpbHlncmluZF8wMQ',
+    passkeyUserId: DEFAULT_USER_ID,
+    aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+    name: aaguids['ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4']?.name || 'Google Password Manager',
+    providerIcon: aaguids['ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4']?.icon_light,
+    registeredAt: 1726412400000,
+    lastUsedAt: 1730559600000,
+    transports: ['internal', 'hybrid'],
+  },
+  {
+    id: 'Y3JlZF9pY2xvdWRfZGFpbHlncmluZF8wMg',
+    passkeyUserId: DEFAULT_USER_ID,
+    aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+    name: aaguids['fbfc3007-154e-4ecc-8c0b-6e020557d7bd']?.name || 'iCloud Keychain',
+    providerIcon: aaguids['fbfc3007-154e-4ecc-8c0b-6e020557d7bd']?.icon_light,
+    registeredAt: 1728572400000,
+    lastUsedAt: 1730127600000,
+    transports: ['internal', 'hybrid'],
+  },
+  {
+    id: 'Y3JlZF8xcGFzc3dvcmRfZGFpbHlncmluZF8wMw',
+    passkeyUserId: DEFAULT_USER_ID,
+    aaguid: 'bada5566-a7aa-401f-bd96-45619a55120d',
+    name: aaguids['bada5566-a7aa-401f-bd96-45619a55120d']?.name || '1Password',
+    providerIcon: aaguids['bada5566-a7aa-401f-bd96-45619a55120d']?.icon_light,
+    registeredAt: 1729436400000,
+    lastUsedAt: 1729868400000,
+    transports: ['internal', 'hybrid'],
+  },
+];
+
+const credentialsStore = new Map(initialCredentials.map((cred) => [cred.id, { ...cred }]));
+
+export const db = {
+  DEFAULT_USER_ID,
+
+  async findUserById(userId) {
+    return users.get(userId) || null;
+  },
+
+  async updateUser(userId, { name, displayName }) {
+    const existing = users.get(userId) || {
+      id: userId,
+      name: 'alex.rivera@dailygrind.coffee',
+      displayName: 'Alex Rivera',
+    };
+    const updatedUser = {
+      ...existing,
+      name: typeof name === 'string' && name.trim() ? name.trim() : existing.name,
+      displayName:
+        typeof displayName === 'string' && displayName.trim()
+          ? displayName.trim()
+          : existing.displayName,
+    };
+    users.set(userId, updatedUser);
+    return { ...updatedUser };
+  },
+
+  async findCredentialsByUserId(userId) {
+    const result = [];
+    for (const cred of credentialsStore.values()) {
+      if (cred.passkeyUserId === userId) {
+        result.push({ ...cred });
+      }
+    }
+    return result;
+  },
+
+  async findCredentialById(id) {
+    const cred = credentialsStore.get(id);
+    return cred ? { ...cred } : null;
+  },
+
+  async saveCredential(cred) {
+    if (!cred || !cred.id) {
+      throw new Error('Credential must have an id.');
+    }
+    const record = {
+      ...cred,
+      passkeyUserId: cred.passkeyUserId || DEFAULT_USER_ID,
+      registeredAt: cred.registeredAt ?? Date.now(),
+      lastUsedAt: cred.lastUsedAt ?? Date.now(),
+    };
+    credentialsStore.set(record.id, record);
+    return { ...record };
+  },
+
+  async deleteCredential(id) {
+    return credentialsStore.delete(id);
+  },
+};
+
+export default db;
