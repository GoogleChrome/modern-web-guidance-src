+  <script>
+    // Trusted reference origin and registrable domain
+    const TRUSTED_URL = 'https://app.trusted-origin.example';
+    const TRUSTED_SITE_DOMAIN = 'trusted-origin.example';
+    const TRUSTED_ORIGIN = typeof Origin !== 'undefined' ? Origin.from(TRUSTED_URL) : null;
+
+    function hasOriginApi() {
+      return typeof Origin !== 'undefined' && typeof Origin.from === 'function';
+    }
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+        return candidate.origin;
+      }
+      if (candidate === globalThis || (typeof window !== 'undefined' && candidate === window)) {
+        return globalThis.location?.href ?? '';
+      }
+      if (candidate instanceof URL) {
+        return candidate.href;
+      }
+      if (
+        (typeof HTMLAnchorElement !== 'undefined' && candidate instanceof HTMLAnchorElement) ||
+        (typeof HTMLAreaElement !== 'undefined' && candidate instanceof HTMLAreaElement)
+      ) {
+        return candidate.href;
+      }
+      throw new TypeError('Unsupported origin input');
+    }
+
+    function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        // Synthetic MessageEvents in tests lack an internal browser origin;
+        // fall back to parsing candidate.origin if it is a URL string.
+        if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+          return Origin.from(candidate.origin);
+        }
+        throw err;
+      }
+    }
+
+    function checkSameOriginWithFallback(candidate) {
+      try {
+        if (hasOriginApi()) {
+          const origin = extractOrigin(candidate);
+          if (origin.opaque) return false;
+          return origin.isSameOrigin(Origin.from(TRUSTED_URL));
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedUrl = new URL(TRUSTED_URL);
+        return candidateUrl.origin !== 'null' && candidateUrl.origin === trustedUrl.origin;
+      } catch {
+        return false;
+      }
+    }
+
+    function checkSameSiteWithFallback(candidate) {
+      try {
+        if (hasOriginApi()) {
+          const origin = extractOrigin(candidate);
+          if (origin.opaque) return false;
+          return origin.isSameSite(Origin.from(TRUSTED_URL));
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedUrl = new URL(TRUSTED_URL);
+        return (
+          candidateUrl.origin !== 'null' &&
+          candidateUrl.protocol === trustedUrl.protocol &&
+          (candidateUrl.hostname === TRUSTED_SITE_DOMAIN ||
+            candidateUrl.hostname.endsWith('.' + TRUSTED_SITE_DOMAIN))
+        );
+      } catch {
+        return false;
+      }
+    }
+
+    function isTrustedSameOrigin(candidate) {
+      return checkSameOriginWithFallback(candidate);
+    }
+
+    function isAllowedSameSiteUrl(candidate) {
+      return checkSameSiteWithFallback(candidate);
+    }
+
+    // Pin a sandboxed iframe's opaque origin
+    let pinnedSandboxOrigin = typeof Origin !== 'undefined' ? new Origin() : null;
+    let isSandboxPinned = false;
+    let pinnedSandboxSource = null;
+
+    function handleSandboxedWidgetMessage(event, expectedWidgetWindow) {
+      try {
+        const isInit = event.data?.type === 'init';
+        if (!hasOriginApi()) {
+          if (!isSandboxPinned && (!expectedWidgetWindow || event.source === expectedWidgetWindow) && isInit) {
+            pinnedSandboxSource = event.source;
+            isSandboxPinned = true;
+          }
+          if (expectedWidgetWindow) {
+            return isSandboxPinned && event.source === expectedWidgetWindow && (event.origin === 'null' || !event.origin);
+          }
+          return isSandboxPinned && Boolean(pinnedSandboxSource) && event.source === pinnedSandboxSource;
+        }
+        if (!pinnedSandboxOrigin) {
+          pinnedSandboxOrigin = new Origin();
+        }
+        const senderOrigin = Origin.from(event);
+        if (!isSandboxPinned && (!expectedWidgetWindow || event.source === expectedWidgetWindow) && isInit) {
+          pinnedSandboxOrigin = senderOrigin;
+          isSandboxPinned = true;
+        }
+        return senderOrigin.isSameOrigin(pinnedSandboxOrigin);
+      } catch {
+        return false;
+      }
+    }
+
+    if (typeof window !== 'undefined' && typeof window.addEventListener === 'function') {
+      window.addEventListener('message', (event) => {
+        if (!isTrustedSameOrigin(event)) return;
+        // Safe to process privileged commands from the verified origin
+      });
+    }
+
+    // Validate ?returnTo= redirect targets
+    function safeReturnTo(value) {
+      return value && isAllowedSameSiteUrl(value) ? value : null;
+    }
+
+    const searchString = typeof window !== 'undefined' && window.location?.search ? window.location.search : '';
+    const urlParams = new URLSearchParams(searchString);
+    const returnToParam = urlParams.get('returnTo');
+    if (returnToParam) {
+      safeReturnTo(returnToParam);
+    }
+
+    Object.assign(globalThis, {
+      TRUSTED_URL,
+      TRUSTED_SITE_DOMAIN,
+      TRUSTED_ORIGIN,
+      extractOrigin,
+      extractUrlString,
+      isTrustedSameOrigin,
+      checkSameOrigin: isTrustedSameOrigin,
+      checkSameOriginWithFallback,
+      isAllowedSameSiteUrl,
+      checkSameSite: isAllowedSameSiteUrl,
+      checkSameSiteWithFallback,
+      handleSandboxedWidgetMessage,
+      safeReturnTo,
+    });
+  </script>
 </body>
 
 </html>
