+import { test, expect } from '@playwright/test';
+
+for (const disableOrigin of [false, true]) {
+  test(`origin boundaries and real sandbox senders (Origin removed: ${disableOrigin})`, async ({ page }) => {
+    const errors: Error[] = [];
+    page.on('pageerror', (error) => errors.push(error));
+    if (disableOrigin) {
+      await page.addInitScript(() => {
+        Reflect.deleteProperty(globalThis, 'Origin');
+      });
+    }
+    await page.goto('/');
+    expect(await page.evaluate(() => typeof Reflect.get(globalThis, 'Origin')))
+      .toBe(disableOrigin ? 'undefined' : 'function');
+    await expect(page.locator('#widget-status')).toHaveText('Rewards widget connected.');
+
+    async function checkOrigin(url: string, accepted: boolean) {
+      await page.locator('#origin-input').fill(url);
+      await page.getByRole('button', { name: 'Check origin', exact: true }).click();
+      await expect(page.locator('#origin-result')).toContainText(accepted ? 'Accepted:' : 'Rejected:');
+    }
+    await checkOrigin('https://app.trusted-origin.example:443/path?foo=1', true);
+    await checkOrigin('https://app.trusted-origin.example.attacker.example', false);
+    await checkOrigin('https://billing.trusted-origin.example', false);
+    await checkOrigin('null', false);
+    await checkOrigin('data:text/html,test', false);
+    await checkOrigin('https://', false);
+
+    async function checkSite(url: string, accepted: boolean) {
+      await page.locator('#site-input').fill(url);
+      await page.getByRole('button', { name: 'Check destination' }).click();
+      await expect(page.locator('#site-result')).toContainText(accepted ? 'Accepted:' : 'Rejected:');
+      if (accepted) await expect(page.locator('#continue-link')).toBeVisible();
+      else {
+        await expect(page.locator('#continue-link')).toBeHidden();
+        await expect(page.locator('#continue-link')).not.toHaveAttribute('href');
+      }
+    }
+    await checkSite('https://billing.trusted-origin.example:8443/orders', true);
+    await checkSite('http://billing.trusted-origin.example', false);
+    await checkSite('https://app.trusted-origin.example.attacker.example', false);
+    await checkSite('null', false);
+
+    // Exercise the page's real account message listener with synthetic test events.
+    await page.evaluate(() => {
+      window.dispatchEvent(new MessageEvent('message', {
+        origin: 'https://app.trusted-origin.example:443/account',
+        data: { type: 'rewards-update', points: 42 },
+      }));
+    });
+    await expect(page.locator('#reward-points')).toHaveText('42');
+    await page.evaluate(() => {
+      window.dispatchEvent(new MessageEvent('message', {
+        origin: 'https://app.trusted-origin.example.attacker.example',
+        data: { type: 'rewards-update', points: 1000 },
+      }));
+    });
+    await expect(page.locator('#message-status')).toContainText('rejected');
+    await expect(page.locator('#reward-points')).toHaveText('42');
+
+    await page.frameLocator('#rewards-widget').getByRole('button').click();
+    await expect(page.locator('#widget-status')).toContainText('accepted');
+    await page.frameLocator('#other-widget').getByRole('button').click();
+    await expect(page.locator('#widget-status')).toContainText('rejected');
+    await page.frameLocator('#rewards-widget').getByRole('button').click();
+    await expect(page.locator('#widget-status')).toContainText('accepted');
+    expect(errors).toEqual([]);
+  });
+}
+
+test('returnTo is validated before offering navigation', async ({ page }) => {
+  await page.goto('/?returnTo=' + encodeURIComponent('https://billing.trusted-origin.example/orders'));
+  await expect(page.locator('#continue-link')).toHaveAttribute('href', 'https://billing.trusted-origin.example/orders');
+  await page.goto('/?returnTo=' + encodeURIComponent('data:text/html,untrusted'));
+  await expect(page.locator('#site-result')).toContainText('Rejected:');
+  await expect(page.locator('#continue-link')).not.toHaveAttribute('href');
+});
