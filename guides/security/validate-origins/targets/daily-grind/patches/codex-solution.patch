index 0000000..495e75c
--- /dev/null
+++ b/src/main.ts
@@ -0,0 +1,104 @@
+import { createOriginValidator, createSandboxVerifier } from './origin-validation';
+
+export const TRUSTED_URL = 'https://app.trusted-origin.example';
+export const { isTrustedSameOrigin, isAllowedSameSiteUrl } = createOriginValidator(TRUSTED_URL);
+
+function element<T extends HTMLElement>(id: string): T {
+  const result = document.getElementById(id);
+  if (!result) throw new Error(`Missing element: ${id}`);
+  return result as T;
+}
+
+const messageStatus = element('message-status');
+const widgetStatus = element('widget-status');
+const sandbox = element<HTMLIFrameElement>('rewards-widget');
+let verifyWidget: ReturnType<typeof createSandboxVerifier> | undefined;
+
+// A fresh verifier prevents pins from surviving a new iframe document.
+sandbox.addEventListener('load', () => {
+  const peer = sandbox.contentWindow;
+  verifyWidget = peer ? createSandboxVerifier(peer) : undefined;
+  // Messages are ordered per sender; init arrives before subsequent updates.
+  peer?.postMessage({ type: 'initialize' }, '*');
+});
+
+window.addEventListener('message', (event: MessageEvent<unknown>) => {
+  const data = event.data;
+  if (typeof data !== 'object' || data === null || !('type' in data)) return;
+
+  if (data.type === 'init' || data.type === 'widget-update') {
+    const accepted = verifyWidget?.(event) ?? false;
+    widgetStatus.textContent = accepted
+      ? data.type === 'init' ? 'Rewards widget connected.' : 'Rewards update accepted from your widget.'
+      : 'Rewards update rejected: sender is not the connected widget.';
+    return;
+  }
+
+  if (data.type === 'rewards-update') {
+    if (!isTrustedSameOrigin(event)) {
+      messageStatus.textContent = 'Account message rejected: untrusted origin.';
+      return;
+    }
+    if (!('points' in data) || typeof data.points !== 'number' ||
+      !Number.isSafeInteger(data.points) || data.points < 0) {
+      messageStatus.textContent = 'Account message rejected: invalid reward points.';
+      return;
+    }
+    element('reward-points').textContent = String(data.points);
+    messageStatus.textContent = 'Account message accepted.';
+  }
+});
+
+const originForm = element<HTMLFormElement>('origin-form');
+originForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const accepted = isTrustedSameOrigin(element<HTMLInputElement>('origin-input').value);
+  element('origin-result').textContent = accepted ? 'Accepted: trusted account origin.' : 'Rejected: untrusted or invalid origin.';
+});
+
+const siteForm = element<HTMLFormElement>('site-form');
+siteForm.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const candidate = element<HTMLInputElement>('site-input').value;
+  const accepted = isAllowedSameSiteUrl(candidate);
+  const link = element<HTMLAnchorElement>('continue-link');
+  link.hidden = !accepted;
+  if (accepted) link.href = new URL(candidate).href;
+  else link.removeAttribute('href');
+  element('site-result').textContent = accepted ? 'Accepted: same-site destination.' : 'Rejected: external, insecure, or invalid destination.';
+});
+
+// URLSearchParams decodes returnTo; URL validation runs before creating a link.
+const returnTo = new URL(window.location.href).searchParams.get('returnTo');
+if (returnTo !== null) {
+  element<HTMLInputElement>('site-input').value = returnTo;
+  siteForm.requestSubmit();
+}
+
+// Native anchor extraction works for existing relative links as well.
+const pageValidator = createOriginValidator(window.location.href);
+for (const link of document.querySelectorAll<HTMLAnchorElement>('a[href]')) {
+  link.dataset.site = pageValidator.isAllowedSameSiteUrl(link) ? 'internal' : 'external';
+}
+
+// Set srcdoc after handlers are installed, so initialization cannot be missed.
+sandbox.srcdoc = `<!doctype html><html lang="en"><meta charset="utf-8">
+  <style>body{font:14px system-ui;color:#3e2723}button{padding:8px;cursor:pointer}</style>
+  <p>Your rewards widget</p><button type="button">Refresh rewards</button>
+  <script>
+    addEventListener('message', function(event) {
+      if (event.source === parent && event.data?.type === 'initialize') {
+        parent.postMessage({type:'init'}, '*');
+      }
+    });
+    document.querySelector('button').onclick = function() {
+      parent.postMessage({type:'widget-update'}, '*');
+    };
+  <\/script></html>`;
+
+element<HTMLIFrameElement>('other-widget').srcdoc = `<!doctype html><html lang="en"><meta charset="utf-8">
+  <style>body{font:14px system-ui;color:#3e2723}button{padding:8px;cursor:pointer}</style>
+  <p>A separate widget</p><button type="button">Send rewards update</button>
+  <script>document.querySelector('button').onclick = function() {
+    parent.postMessage({type:'widget-update'}, '*');
+  };<\/script></html>`;
diff --git a/src/origin-validation.ts b/src/origin-validation.ts
new file mode 100644
index 0000000..fc9523a
--- /dev/null
+++ b/src/origin-validation.ts
@@ -0,0 +1,122 @@
+import { getDomain } from 'tldts';
+
+// Local types for the experimental browser API, which is not yet in lib.dom.
+export interface BrowserOrigin {
+  readonly opaque: boolean;
+  isSameOrigin(other: BrowserOrigin): boolean;
+  isSameSite(other: BrowserOrigin): boolean;
+}
+
+export interface OriginConstructor {
+  new (): BrowserOrigin;
+  from(candidate: unknown): BrowserOrigin;
+}
+
+function originApi(): OriginConstructor | undefined {
+  const api = (globalThis as typeof globalThis & { Origin?: OriginConstructor }).Origin;
+  return typeof api === 'function' && typeof api.from === 'function' ? api : undefined;
+}
+
+function isMessage(candidate: unknown): candidate is MessageEvent<unknown> {
+  return typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent;
+}
+
+function extractOrigin(api: OriginConstructor, candidate: unknown): BrowserOrigin {
+  try {
+    return api.from(candidate);
+  } catch (error) {
+    // Synthetic events lack a browser-internal origin. Parsing their string is
+    // safe for tuple validation, but must never be used to pin opaque identity.
+    if (isMessage(candidate)) return api.from(candidate.origin);
+    throw error;
+  }
+}
+
+function extractUrl(candidate: unknown): URL {
+  if (typeof candidate === 'string') return new URL(candidate);
+  if (candidate instanceof URL) return new URL(candidate.href);
+  if (isMessage(candidate)) return new URL(candidate.origin);
+  if (candidate === globalThis && typeof location !== 'undefined') {
+    return new URL(location.href);
+  }
+  if (
+    (typeof HTMLAnchorElement !== 'undefined' && candidate instanceof HTMLAnchorElement) ||
+    (typeof HTMLAreaElement !== 'undefined' && candidate instanceof HTMLAreaElement)
+  ) return new URL(candidate.href);
+  throw new TypeError('Unsupported origin input');
+}
+
+export function createOriginValidator(trustedUrl: string) {
+  const reference = new URL(trustedUrl);
+  if (reference.origin === 'null') throw new TypeError('The trusted origin must be non-opaque');
+
+  function isTrustedSameOrigin(candidate: unknown): boolean {
+    try {
+      const api = originApi();
+      if (api) {
+        const origin = extractOrigin(api, candidate);
+        return !origin.opaque && origin.isSameOrigin(api.from(reference));
+      }
+      const url = extractUrl(candidate);
+      return url.origin !== 'null' && url.origin === reference.origin;
+    } catch {
+      return false;
+    }
+  }
+
+  function isAllowedSameSiteUrl(candidate: unknown): boolean {
+    try {
+      const api = originApi();
+      if (api) {
+        const origin = extractOrigin(api, candidate);
+        return !origin.opaque && origin.isSameSite(api.from(reference));
+      }
+      const url = extractUrl(candidate);
+      if (url.origin === 'null' || url.protocol !== reference.protocol) return false;
+      if (url.hostname === reference.hostname) return true;
+      // Include private suffixes to keep distinct shared-hosting tenants apart.
+      const site = getDomain(reference.hostname, { allowPrivateDomains: true });
+      return site !== null && getDomain(url.hostname, { allowPrivateDomains: true }) === site;
+    } catch {
+      return false;
+    }
+  }
+
+  return { isTrustedSameOrigin, isAllowedSameSiteUrl };
+}
+
+/** One verifier per iframe lifetime. Recreate it after the iframe navigates. */
+export function createSandboxVerifier(expectedWidgetWindow: Window) {
+  const api = originApi();
+  let pinnedOrigin: BrowserOrigin | undefined = api ? new api() : undefined;
+  let pinned = false;
+
+  return (event: MessageEvent<unknown>): boolean => {
+    try {
+      if (event.source !== expectedWidgetWindow) return false;
+      const data: unknown = event.data;
+      const isInit = typeof data === 'object' && data !== null &&
+        'type' in data && data.type === 'init';
+      if (api) {
+        // Use the event itself: serialized "null" cannot preserve identity.
+        const sender = api.from(event);
+        if (!sender.opaque) return false;
+        if (!pinned) {
+          if (!isInit) return false;
+          pinnedOrigin = sender;
+          pinned = true;
+        }
+        return pinnedOrigin !== undefined && sender.isSameOrigin(pinnedOrigin);
+      }
+      // Older browsers can bind the peer by WindowProxy, never by "null" alone.
+      if (event.origin !== 'null') return false;
+      if (!pinned) {
+        if (!isInit) return false;
+        pinned = true;
+      }
+      return true;
+    } catch {
+      return false;
+    }
+  };
+}
diff --git a/tests/origin-validation.test.ts b/tests/origin-validation.test.ts
new file mode 100644
index 0000000..23c46e7
--- /dev/null
+++ b/tests/origin-validation.test.ts
@@ -0,0 +1,128 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { getDomain } from 'tldts';
+import { createOriginValidator, createSandboxVerifier, type BrowserOrigin } from '../src/origin-validation';
+
+afterEach(() => vi.unstubAllGlobals());
+
+// Model the browser extraction contract, including the identity that synthetic
+// MessageEvent objects cannot carry. Browser tests exercise real iframe events.
+const eventOrigins = new WeakMap<MessageEvent, TestOrigin>();
+class TestOrigin implements BrowserOrigin {
+  readonly opaque: boolean;
+  constructor(readonly url?: URL) { this.opaque = !url || url.origin === 'null'; }
+  static from(candidate: unknown): TestOrigin {
+    if (candidate instanceof TestOrigin) return candidate;
+    if (candidate instanceof MessageEvent) {
+      const origin = eventOrigins.get(candidate);
+      if (!origin) throw new TypeError('Synthetic event');
+      return origin;
+    }
+    if (typeof candidate === 'string' || candidate instanceof URL) {
+      return new TestOrigin(new URL(String(candidate)));
+    }
+    throw new TypeError('Unsupported input');
+  }
+  isSameOrigin(other: BrowserOrigin): boolean {
+    if (!(other instanceof TestOrigin)) throw new TypeError('Expected Origin');
+    return this.opaque || other.opaque ? this === other : this.url!.origin === other.url!.origin;
+  }
+  isSameSite(other: BrowserOrigin): boolean {
+    if (!(other instanceof TestOrigin)) throw new TypeError('Expected Origin');
+    if (this.opaque || other.opaque) return this === other;
+    const a = this.url!;
+    const b = other.url!;
+    const siteA = getDomain(a.hostname, { allowPrivateDomains: true }) ?? a.hostname;
+    const siteB = getDomain(b.hostname, { allowPrivateDomains: true }) ?? b.hostname;
+    return a.protocol === b.protocol && siteA === siteB;
+  }
+}
+
+for (const native of [false, true]) {
+  describe(native ? 'Origin API' : 'URL fallback', () => {
+    function validator(url = 'https://app.trusted-origin.example') {
+      vi.stubGlobal('Origin', native ? TestOrigin : undefined);
+      return createOriginValidator(url);
+    }
+
+    it('accepts normalized trusted URLs and synthetic message events', () => {
+      const check = validator().isTrustedSameOrigin;
+      expect(check('https://app.trusted-origin.example:443/path?query=1')).toBe(true);
+      expect(check(new URL('https://APP.TRUSTED-ORIGIN.EXAMPLE/path'))).toBe(true);
+      expect(check(new MessageEvent('message', { origin: 'https://app.trusted-origin.example' }))).toBe(true);
+    });
+
+    it('rejects prefix spoofing, subdomains, credentials tricks and port changes', () => {
+      const check = validator().isTrustedSameOrigin;
+      for (const url of [
+        'https://app.trusted-origin.example.attacker.example',
+        'https://billing.trusted-origin.example',
+        'https://app.trusted-origin.example@attacker.example',
+        'https://app.trusted-origin.example:8443',
+        'http://app.trusted-origin.example',
+      ]) expect(check(url), url).toBe(false);
+    });
+
+    it('accepts same-site subdomains and nondefault ports, rejects scheme downgrades', () => {
+      const check = validator().isAllowedSameSiteUrl;
+      expect(check('https://billing.trusted-origin.example:8443/orders')).toBe(true);
+      expect(check('https://trusted-origin.example')).toBe(true);
+      expect(check('http://billing.trusted-origin.example')).toBe(false);
+      expect(check('https://app.trusted-origin.example.attacker.example')).toBe(false);
+    });
+
+    it('handles multi-label public suffixes and private hosting domains', () => {
+      const uk = validator('https://app.example.co.uk').isAllowedSameSiteUrl;
+      expect(uk('https://billing.example.co.uk:8443')).toBe(true);
+      expect(uk('https://attacker.co.uk')).toBe(false);
+      const github = validator('https://tenant-a.github.io').isAllowedSameSiteUrl;
+      expect(github('https://sub.tenant-a.github.io')).toBe(true);
+      expect(github('https://tenant-b.github.io')).toBe(false);
+    });
+
+    it('fails closed for invalid, opaque, and unsupported inputs without throwing', () => {
+      const v = validator();
+      for (const candidate of ['null', 'example', 'https://', 'data:text/plain,test',
+        'javascript:alert(1)', '', null, undefined, {}, { href: 'https://app.trusted-origin.example' },
+        new MessageEvent('message', { origin: 'null' })]) {
+        expect(v.isTrustedSameOrigin(candidate)).toBe(false);
+        expect(v.isAllowedSameSiteUrl(candidate)).toBe(false);
+      }
+    });
+
+    it('does not group distinct IP addresses or localhost names into one site', () => {
+      expect(validator('https://127.0.0.1').isAllowedSameSiteUrl('https://127.0.0.2')).toBe(false);
+      expect(validator('https://localhost').isAllowedSameSiteUrl('https://other.localhost')).toBe(false);
+      expect(validator('https://127.0.0.1').isAllowedSameSiteUrl('https://127.0.0.1:8443')).toBe(true);
+    });
+
+    it('pins only init from the expected sandbox, then rejects other senders', () => {
+      validator();
+      const peer = {} as Window;
+      const other = {} as Window;
+      const identity = new TestOrigin();
+      const check = createSandboxVerifier(peer);
+      function event(source: Window, type: string, origin = identity) {
+        const message = new MessageEvent('message', { origin: 'null', data: { type } });
+        Object.defineProperty(message, 'source', { value: source });
+        eventOrigins.set(message, origin);
+        return message;
+      }
+      expect(check(event(peer, 'widget-update'))).toBe(false);
+      expect(check(event(other, 'init'))).toBe(false);
+      expect(check(event(peer, 'init'))).toBe(true);
+      expect(check(event(peer, 'widget-update'))).toBe(true);
+      expect(check(event(other, 'widget-update'))).toBe(false);
+      if (native) {
+        // Even the same WindowProxy with a new document's opaque origin fails.
+        expect(check(event(peer, 'init', new TestOrigin()))).toBe(false);
+        const synthetic = new MessageEvent('message', { origin: 'null', data: { type: 'init' } });
+        Object.defineProperty(synthetic, 'source', { value: peer });
+        expect(check(synthetic)).toBe(false);
+      }
+    });
+  });
+}
+
+it('rejects an opaque trusted configuration', () => {
+  expect(() => createOriginValidator('data:text/plain,test')).toThrow(TypeError);
+});
