+---
+import Layout from '../layouts/Layout.astro';
+import LocalNetworkAccess from '../components/LocalNetworkAccess.tsx';
+---
+
+<Layout title="Local Network Access — The DevTools Times">
+  <div class="max-w-3xl mx-auto px-4 py-8 md:py-12">
+    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Local Network Access</h1>
+    <p class="text-gray-500 text-sm mb-6">
+      Demonstrates the <strong>Local Network Access (LNA)</strong> permission API — how a public web
+      application requests access to devices on a user's local network or loopback interface.
+    </p>
+
+    <div class="prose max-w-none mb-8">
+      <p>
+        When a page served from a <code>public</code> origin connects to a private LAN address
+        (RFC&nbsp;1918 ranges, <code>.local</code> mDNS names) or to <code>localhost</code> /
+        <code>127.0.0.1</code>, browsers gate the connection behind a permission prompt. LNA splits
+        this into two granular permissions:
+      </p>
+      <ul>
+        <li>
+          <code>local-network</code> — required for LAN / intranet addresses.
+        </li>
+        <li>
+          <code>loopback-network</code> — required for <code>127.0.0.1</code>, <code>::1</code>, or
+          <code>localhost</code>.
+        </li>
+      </ul>
+      <p>
+        The app queries each permission state before connecting. When the state is{' '}
+        <strong>prompt</strong>, it waits for an explicit user gesture. When <strong>denied</strong>,
+        it shows remediation instructions. Fetch calls include the mandatory{' '}
+        <code>targetAddressSpace</code> option so the browser can exempt the mixed-content check
+        before DNS resolution.
+      </p>
+    </div>
+
+    <LocalNetworkAccess client:load />
+  </div>
+</Layout>
diff --git a/src/utils/local-network-access.ts b/src/utils/local-network-access.ts
