+++ b/src/utils/localNetworkAccess.ts
@@ -0,0 +1,76 @@
+/**
+ * Helpers for the Local Network Access (LNA) permissions ('local-network' and
+ * 'loopback-network'). These are intentionally kept separate from the legacy,
+ * combined 'local-network-access' permission name, which must never be queried
+ * directly since older Chrome versions crash the renderer on that query.
+ */
+
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type TargetAddressSpace = 'local' | 'loopback';
+
+export interface LnaRequestInit extends RequestInit {
+  targetAddressSpace?: TargetAddressSpace;
+}
+
+/**
+ * Cross-browser permission check for a granular LNA permission. Falls back to
+ * 'prompt' (rather than throwing) when the Permissions API is unavailable or
+ * the browser doesn't yet recognize the permission name, so callers can still
+ * gate the first request behind an explicit user gesture.
+ */
+export async function queryLnaPermissionSafe(permissionName: LnaPermissionName): Promise<PermissionState> {
+  if (!navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({ name: permissionName } as unknown as PermissionDescriptor);
+    return status.state;
+  } catch {
+    // Unrecognized PermissionName in this browser; proceed as if a prompt is required.
+    return 'prompt';
+  }
+}
+
+/**
+ * Queries a granular LNA permission and keeps `onChange` in sync with the live
+ * PermissionStatus, mirroring browser Site Settings changes without a reload.
+ * Returns an unsubscribe function; safe to call even where the Permissions API
+ * or the permission name itself isn't supported.
+ */
+export async function watchLnaPermission(
+  permissionName: LnaPermissionName,
+  onChange: (state: PermissionState) => void,
+): Promise<() => void> {
+  if (!navigator.permissions?.query) {
+    onChange('prompt');
+    return () => {};
+  }
+  try {
+    const status = await navigator.permissions.query({ name: permissionName } as unknown as PermissionDescriptor);
+    const listener = () => onChange(status.state);
+    status.addEventListener('change', listener);
+    onChange(status.state);
+    return () => status.removeEventListener('change', listener);
+  } catch {
+    onChange('prompt');
+    return () => {};
+  }
+}
+
+/**
+ * Fetches a resource on the local network or loopback interface, declaring
+ * `targetAddressSpace` so the browser exempts the request from Mixed Content
+ * blocking ahead of DNS resolution and verifies the resolved IP afterward.
+ */
+export async function fetchLocalResource(
+  url: string,
+  targetAddressSpace: TargetAddressSpace,
+  init: RequestInit = {},
+): Promise<Response> {
+  const requestInit: LnaRequestInit = {
+    ...init,
+    targetAddressSpace,
+  };
+  const request = new Request(url, requestInit);
+  return fetch(request);
+}
