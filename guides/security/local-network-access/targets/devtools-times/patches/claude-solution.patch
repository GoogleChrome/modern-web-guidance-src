@@ -0,0 +1,112 @@
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type LnaPermissionState = 'granted' | 'prompt' | 'denied';
+
+export function updatePermissionUI(permissionName: LnaPermissionName, state: LnaPermissionState): void {
+  const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+  const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+  if (statusBadge) {
+    statusBadge.textContent = state;
+  }
+  if (remediationBox) {
+    (remediationBox as HTMLElement).hidden = state !== 'denied';
+  }
+}
+
+export async function checkNetworkPermission(permissionName: LnaPermissionName): Promise<LnaPermissionState> {
+  const status = await navigator.permissions.query({ name: permissionName as unknown as PermissionName });
+
+  status.addEventListener('change', () => {
+    updatePermissionUI(permissionName, status.state as LnaPermissionState);
+  });
+
+  updatePermissionUI(permissionName, status.state as LnaPermissionState);
+  return status.state as LnaPermissionState;
+}
+
+/**
+ * Cross-browser permission check for the granular LNA permissions.
+ * Never falls back to querying 'local-network-access', which crashes older Chrome versions.
+ */
+export async function queryLnaPermissionSafe(permissionName: LnaPermissionName): Promise<LnaPermissionState> {
+  if (!navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({ name: permissionName as unknown as PermissionName });
+    return status.state as LnaPermissionState;
+  } catch {
+    // Unrecognized permission name; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Connects to a local network device (e.g., LAN printer or IoT hub) over HTTP.
+ */
+export async function fetchLocalDeviceStatus(deviceUrl = 'http://192.168.1.100:8080/api/status'): Promise<unknown> {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+  } as RequestInit & { targetAddressSpace: string });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Device responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Connects to a local companion daemon running on the user's loopback interface.
+ */
+export async function fetchLoopbackDaemon(daemonUrl = 'http://127.0.0.1:45678/health'): Promise<unknown> {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+  } as RequestInit & { targetAddressSpace: string });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion app responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Opens a WebSocket connection to a local network device (IP literal, .local, or localhost).
+ * Pass only subprotocol string(s) as the second argument (never an options object).
+ */
+export function openLocalWebSocket(wsUrl = 'ws://192.168.1.100:8080/stream'): WebSocket {
+  // Browsers exempt ws:// from Mixed Content when the host is a local/loopback IP literal,
+  // .local, or localhost, and gate the connection on 'local-network' or 'loopback-network'.
+  return new WebSocket(wsUrl, ['v1.telemetry']);
+}
+
+/**
+ * Opens a WebTransport session to a local network endpoint using a pinned self-signed certificate hash.
+ * transport.ready resolves only after the user grants the 'local-network' permission.
+ */
+export async function openLocalWebTransport(
+  wtUrl = 'https://192.168.1.100:4433/wt',
+  certSha256Bytes: ArrayBuffer,
+): Promise<unknown> {
+  // WebTransport strictly requires https:// and never triggers Mixed Content blocks.
+  // The browser automatically verifies the resolved IP address space and gates
+  // transport.ready behind the 'local-network' or 'loopback-network' permission prompt.
+  const WebTransportClass = (globalThis as unknown as { WebTransport: new (url: string, options?: unknown) => { ready: Promise<void> } }).WebTransport;
+  const transport = new WebTransportClass(wtUrl, {
+    serverCertificateHashes: [
+      {
+        algorithm: 'sha-256',
+        value: certSha256Bytes,
+      },
+    ],
+  });
+
+  await transport.ready;
+  return transport;
+}
