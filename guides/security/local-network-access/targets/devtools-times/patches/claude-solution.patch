+import React, { useEffect, useRef, useState } from 'react';
+import {
+  fetchLocalResource,
+  watchLnaPermission,
+  type LnaPermissionName,
+  type TargetAddressSpace,
+} from '../utils/localNetworkAccess';
+
+interface DeviceConfig {
+  id: string;
+  label: string;
+  description: string;
+  permissionName: LnaPermissionName;
+  targetAddressSpace: TargetAddressSpace;
+  endpoint: string;
+}
+
+const DEVICES: DeviceConfig[] = [
+  {
+    id: 'lan-printer',
+    label: 'Home Network Printer',
+    description: 'Send this article straight to a printer on your Wi-Fi network.',
+    permissionName: 'local-network',
+    targetAddressSpace: 'local',
+    // Illustrative LAN printer address; replace with device discovery in production.
+    endpoint: 'http://192.168.1.50:9100/print',
+  },
+  {
+    id: 'desktop-companion',
+    label: 'Desktop Print Assistant',
+    description: 'Use the companion app running on this computer to format and print.',
+    permissionName: 'loopback-network',
+    targetAddressSpace: 'loopback',
+    endpoint: 'http://127.0.0.1:9812/print',
+  },
+];
+
+type ConnectionState = 'idle' | 'connecting' | 'success' | 'error';
+
+function DeviceConnector({ device, articleSlug }: { device: DeviceConfig; articleSlug: string }) {
+  const [permissionState, setPermissionState] = useState<PermissionState>('prompt');
+  const [connectionState, setConnectionState] = useState<ConnectionState>('idle');
+  const [errorMessage, setErrorMessage] = useState('');
+  const hasAutoConnected = useRef(false);
+
+  const connect = async () => {
+    setConnectionState('connecting');
+    setErrorMessage('');
+    try {
+      const response = await fetchLocalResource(device.endpoint, device.targetAddressSpace, {
+        method: 'POST',
+        mode: 'cors',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ articleSlug }),
+      });
+      if (!response.ok) {
+        throw new Error(`${device.label} responded with HTTP ${response.status}`);
+      }
+      setConnectionState('success');
+    } catch (error) {
+      setConnectionState('error');
+      setErrorMessage(error instanceof Error ? error.message : `Could not reach ${device.label}.`);
+    }
+  };
+
+  useEffect(() => {
+    let cancelled = false;
+    let unsubscribe = () => {};
+
+    watchLnaPermission(device.permissionName, (state) => {
+      if (cancelled) return;
+      setPermissionState(state);
+
+      // Only auto-connect once access is already granted. When the state is
+      // 'prompt' we deliberately do nothing here and wait for the button click
+      // below so the permission dialog is never triggered on page load.
+      if (state === 'granted' && !hasAutoConnected.current) {
+        hasAutoConnected.current = true;
+        connect();
+      }
+    }).then((unsub) => {
+      if (cancelled) {
+        unsub();
+      } else {
+        unsubscribe = unsub;
+      }
+    });
+
+    return () => {
+      cancelled = true;
+      unsubscribe();
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [device.permissionName]);
+
+  const isDenied = permissionState === 'denied';
+
+  return (
+    <div className="border border-gray-200 rounded-md p-4">
+      <div className="flex items-center justify-between gap-3 flex-wrap">
+        <div>
+          <h4 className="font-semibold text-gray-800">{device.label}</h4>
+          <p className="text-sm text-gray-600">{device.description}</p>
+        </div>
+        <span
+          data-permission-status={device.permissionName}
+          className={`text-xs font-mono px-2 py-1 rounded whitespace-nowrap ${
+            permissionState === 'granted'
+              ? 'bg-green-100 text-green-800'
+              : permissionState === 'denied'
+                ? 'bg-red-100 text-red-800'
+                : 'bg-gray-100 text-gray-600'
+          }`}
+        >
+          {permissionState}
+        </span>
+      </div>
+
+      {isDenied ? (
+        <div
+          data-remediation={device.permissionName}
+          className="mt-3 text-sm text-red-700 bg-red-50 border border-red-200 rounded p-3"
+        >
+          Access to your {device.permissionName === 'local-network' ? 'local network' : 'loopback'} device is
+          blocked. Open this site's settings in your browser and set{' '}
+          <strong>{device.permissionName === 'local-network' ? 'Local network' : 'Loopback network'}</strong> to
+          "Allow", then reload the page.
+        </div>
+      ) : (
+        <button
+          onClick={connect}
+          disabled={connectionState === 'connecting'}
+          className="mt-3 px-4 py-2 bg-amber-400 text-gray-900 font-semibold rounded hover:bg-amber-500 disabled:opacity-50"
+        >
+          {connectionState === 'connecting' ? 'Connecting…' : `Print with ${device.label}`}
+        </button>
+      )}
+
+      {connectionState === 'success' && <p className="mt-2 text-sm text-green-700">Sent to {device.label}.</p>}
+      {connectionState === 'error' && (
+        <p className="mt-2 text-sm text-red-700">
+          {errorMessage} Check that the device is powered on, connected to the same network, and allowed in your
+          browser's site settings.
+        </p>
+      )}
+    </div>
+  );
+}
+
+export default function LocalPrinterWidget({ articleSlug }: { articleSlug: string }) {
+  const [showSetup, setShowSetup] = useState(false);
+
+  return (
+    <section className="border-t border-b border-gray-200 py-6 my-6">
+      <h3 className="text-lg font-bold text-gray-900 mb-1">Print This Article</h3>
+      <p className="text-sm text-gray-600 mb-4">
+        Connect a printer on your local network or the desktop companion app to print a copy.
+      </p>
+      <div className="grid sm:grid-cols-2 gap-4">
+        {DEVICES.map((device) => (
+          <DeviceConnector key={device.id} device={device} articleSlug={articleSlug} />
+        ))}
+      </div>
+
+      <button
+        onClick={() => setShowSetup((s) => !s)}
+        className="mt-4 text-sm text-amber-600 hover:text-amber-700 underline"
+      >
+        {showSetup ? 'Hide setup assistant' : 'Need help pairing your printer?'}
+      </button>
+
+      {showSetup && (
+        <div className="mt-3 border border-gray-200 rounded-md overflow-hidden">
+          {/* Delegate local/loopback access to the embedded partner setup widget,
+              since Permissions-Policy defaults iframe access to 'self'. */}
+          <iframe
+            src="https://printer-setup.partner.example.com/device-bridge"
+            allow="local-network; loopback-network"
+            title="Local Printer Setup Assistant"
+            className="w-full h-64"
+          />
+        </div>
+      )}
+    </section>
+  );
+}
