diff --git a/src/utils/local-network.ts b/src/utils/local-network.ts
new file mode 100644
index 0000000..25d0cb4
--- /dev/null
+++ b/src/utils/local-network.ts
@@ -0,0 +1,268 @@
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type TargetAddressSpace = 'local' | 'loopback';
+
+export interface LocalDeviceStatus {
+  status: string;
+  deviceName?: string;
+  addressSpace?: TargetAddressSpace;
+  printerReady?: boolean;
+  paperLevel?: number;
+  timestamp?: string;
+  [key: string]: unknown;
+}
+
+export interface LoopbackDaemonStatus {
+  status: string;
+  service?: string;
+  version?: string;
+  addressSpace?: TargetAddressSpace;
+  offlineArticlesCount?: number;
+  timestamp?: string;
+  [key: string]: unknown;
+}
+
+/**
+ * Updates permission status badges and remediation boxes in the DOM.
+ * @param {'local-network' | 'loopback-network'} permissionName
+ * @param {PermissionState} state
+ */
+export function updatePermissionUI(
+  permissionName: LnaPermissionName,
+  state: PermissionState
+): void {
+  if (typeof document === 'undefined') {
+    return;
+  }
+
+  const statusBadge = document.querySelector<HTMLElement>(
+    `[data-permission-status="${permissionName}"]`
+  );
+  const remediationBox = document.querySelector<HTMLElement>(
+    `[data-remediation="${permissionName}"]`
+  );
+  if (statusBadge) {
+    statusBadge.textContent = state;
+  }
+  if (remediationBox) {
+    // Show remediation instructions whenever permission is explicitly denied
+    remediationBox.hidden = state !== 'denied';
+  }
+
+  // Also synchronize any additional matching elements on the page
+  document
+    .querySelectorAll<HTMLElement>(`[data-permission-status="${permissionName}"]`)
+    .forEach((el) => {
+      el.textContent = state;
+    });
+  document
+    .querySelectorAll<HTMLElement>(`[data-remediation="${permissionName}"]`)
+    .forEach((el) => {
+      el.hidden = state !== 'denied';
+    });
+}
+
+/**
+ * Cross-browser permission check for the granular LNA permissions.
+ * Never falls back to querying 'local-network-access', which crashes older Chrome versions.
+ * @param {'local-network' | 'loopback-network'} permissionName
+ */
+export async function queryLnaPermissionSafe(
+  permissionName: LnaPermissionName
+): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+    return status.state;
+  } catch {
+    // Unrecognized permission name; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Queries the granular Local Network Access permission for the target space
+ * and subscribes to permission state changes.
+ * @param {'local-network' | 'loopback-network'} permissionName
+ * @param {(state: PermissionState) => void} [onChange]
+ */
+export async function checkNetworkPermission(
+  permissionName: LnaPermissionName,
+  onChange?: (state: PermissionState) => void
+): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    updatePermissionUI(permissionName, 'prompt');
+    onChange?.('prompt');
+    return 'prompt';
+  }
+
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+
+    // Keep UI synchronized if the user changes permission in browser site settings
+    status.addEventListener('change', () => {
+      updatePermissionUI(permissionName, status.state);
+      onChange?.(status.state);
+    });
+
+    updatePermissionUI(permissionName, status.state);
+    onChange?.(status.state);
+    return status.state;
+  } catch {
+    // Progressive fallback when 'local-network' or 'loopback-network' is unrecognized
+    updatePermissionUI(permissionName, 'prompt');
+    onChange?.('prompt');
+    return 'prompt';
+  }
+}
+
+/**
+ * Connects to a local network device (e.g., LAN printer or IoT hub) over HTTP.
+ * Example endpoint URL is illustrative; replace with your device's address.
+ */
+export async function fetchLocalDeviceStatus(
+  deviceUrl = 'http://192.168.1.100:8080/api/status'
+): Promise<LocalDeviceStatus> {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Device responded with HTTP ${response.status}`);
+  }
+  return response.json() as Promise<LocalDeviceStatus>;
+}
+
+/**
+ * Connects to a local companion daemon running on the user's loopback interface.
+ * Example loopback port is illustrative; replace with your service's port.
+ */
+export async function fetchLoopbackDaemon(
+  daemonUrl = 'http://127.0.0.1:45678/health'
+): Promise<LoopbackDaemonStatus> {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion app responded with HTTP ${response.status}`);
+  }
+  return response.json() as Promise<LoopbackDaemonStatus>;
+}
+
+/**
+ * Sends a print or display request to a local network device (e.g., LAN printer).
+ */
+export async function sendArticleToLocalPrinter(
+  articlePayload: { slug: string; title: string; summary?: string },
+  printerUrl = 'http://192.168.1.100:8080/api/print'
+): Promise<{ printed: boolean; jobId?: string }> {
+  const request = new Request(printerUrl, {
+    method: 'POST',
+    mode: 'cors',
+    headers: {
+      'Content-Type': 'application/json',
+    },
+    body: JSON.stringify(articlePayload),
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Local printer responded with HTTP ${response.status}`);
+  }
+  return response.json() as Promise<{ printed: boolean; jobId?: string }>;
+}
+
+/**
+ * Syncs reading list or article data with the loopback companion daemon.
+ */
+export async function syncWithLoopbackDaemon(
+  syncPayload: { articles: string[] },
+  daemonSyncUrl = 'http://127.0.0.1:45678/sync'
+): Promise<{ synced: boolean; count?: number }> {
+  const request = new Request(daemonSyncUrl, {
+    method: 'POST',
+    mode: 'cors',
+    headers: {
+      'Content-Type': 'application/json',
+    },
+    body: JSON.stringify(syncPayload),
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+  });
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion daemon responded with HTTP ${response.status}`);
+  }
+  return response.json() as Promise<{ synced: boolean; count?: number }>;
+}
+
+/**
+ * Opens a WebSocket connection to a local network device (IP literal, .local, or localhost).
+ */
+export function openLocalWebSocket(
+  wsUrl = 'ws://192.168.1.100:8080/stream'
+): WebSocket {
+  // Pass only subprotocol string(s) as the second argument (never an options object).
+  // Browsers exempt ws:// from Mixed Content when the host is a local/loopback IP literal,
+  // .local, or localhost, and gate the connection on 'local-network' or 'loopback-network'.
+  const socket = new WebSocket(wsUrl, ['v1.telemetry']);
+  return socket;
+}
+
+/**
+ * Opens a WebTransport session to a local network endpoint using a pinned self-signed certificate hash.
+ */
+export async function openLocalWebTransport(
+  wtUrl = 'https://192.168.1.100:4433/wt',
+  certSha256Bytes: BufferSource = new Uint8Array(32)
+): Promise<WebTransport> {
+  const transport = new WebTransport(wtUrl, {
+    serverCertificateHashes: [
+      {
+        algorithm: 'sha-256',
+        value: certSha256Bytes,
+      },
+    ],
+  });
+
+  // transport.ready resolves only after the user grants the 'local-network' permission
+  // and rejects with WebTransportError if the permission is denied.
+  await transport.ready;
+  return transport;
+}
+
+/**
+ * Formats an actionable error message for connection or permission failures.
+ */
+export function formatLnaErrorRemediation(
+  permissionName: LnaPermissionName,
+  error: unknown
+): string {
+  const rawMessage =
+    error instanceof Error ? error.message : 'Connection failed.';
+  const targetLabel =
+    permissionName === 'local-network'
+      ? 'local network device (LAN)'
+      : 'local companion service (loopback)';
+  const settingLabel =
+    permissionName === 'local-network' ? 'Local network' : 'Loopback network';
+
+  return `Unable to reach ${targetLabel} (${rawMessage}). Please verify that the device or service is powered on, connected to the same network, and that "${settingLabel}" access is set to "Allow" in your browser's Site Settings.`;
+}
