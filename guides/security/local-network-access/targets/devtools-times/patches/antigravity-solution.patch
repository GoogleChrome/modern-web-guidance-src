@@ -0,0 +1,612 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  checkNetworkPermission,
+  fetchLocalDeviceStatus,
+  fetchLoopbackDaemon,
+  openLocalWebSocket,
+  openLocalWebTransport,
+  sendArticleToLocalPrinter,
+  syncWithLoopbackDaemon,
+  formatLnaErrorRemediation,
+  type LocalDeviceStatus,
+  type LoopbackDaemonStatus,
+} from '../utils/local-network';
+
+export interface LocalNetworkPanelProps {
+  articleSlug?: string;
+  articleTitle?: string;
+  articleSummary?: string;
+  compact?: boolean;
+}
+
+export const LocalNetworkPanel: React.FC<LocalNetworkPanelProps> = ({
+  articleSlug,
+  articleTitle,
+  articleSummary,
+  compact = false,
+}) => {
+  const [isExpanded, setIsExpanded] = useState<boolean>(!compact);
+  const [isSecure, setIsSecure] = useState<boolean>(true);
+
+  // Permission states for the two granular Local Network Access permissions
+  const [localNetworkPerm, setLocalNetworkPerm] = useState<PermissionState>('prompt');
+  const [loopbackNetworkPerm, setLoopbackNetworkPerm] = useState<PermissionState>('prompt');
+
+  // Configurable local & loopback endpoints (with guide defaults)
+  const [localDeviceUrl, setLocalDeviceUrl] = useState<string>(
+    'http://192.168.1.100:8080/api/status'
+  );
+  const [loopbackDaemonUrl, setLoopbackDaemonUrl] = useState<string>(
+    'http://127.0.0.1:45678/health'
+  );
+  const [wsUrl, setWsUrl] = useState<string>('ws://192.168.1.100:8080/stream');
+  const [wtUrl, setWtUrl] = useState<string>('https://192.168.1.100:4433/wt');
+
+  // Connection & status state for local-network (LAN printer / newsroom device)
+  const [localDeviceStatus, setLocalDeviceStatus] = useState<LocalDeviceStatus | null>(null);
+  const [localLoading, setLocalLoading] = useState<boolean>(false);
+  const [localError, setLocalError] = useState<string | null>(null);
+  const [printStatusMessage, setPrintStatusMessage] = useState<string | null>(null);
+
+  // Connection & status state for loopback-network (companion daemon)
+  const [loopbackStatus, setLoopbackStatus] = useState<LoopbackDaemonStatus | null>(null);
+  const [loopbackLoading, setLoopbackLoading] = useState<boolean>(false);
+  const [loopbackError, setLoopbackError] = useState<string | null>(null);
+  const [syncStatusMessage, setSyncStatusMessage] = useState<string | null>(null);
+
+  // Real-time WebSocket & WebTransport state
+  const [wsConnectionState, setWsConnectionState] = useState<
+    'idle' | 'connecting' | 'connected' | 'error' | 'closed'
+  >('idle');
+  const [wsTelemetryMessage, setWsTelemetryMessage] = useState<string | null>(null);
+  const [wsError, setWsError] = useState<string | null>(null);
+  const wsRef = useRef<WebSocket | null>(null);
+
+  const [wtConnectionState, setWtConnectionState] = useState<
+    'idle' | 'connecting' | 'connected' | 'error' | 'closed'
+  >('idle');
+  const [wtError, setWtError] = useState<string | null>(null);
+  const wtRef = useRef<WebTransport | null>(null);
+
+  // Connect to local network device over HTTP with targetAddressSpace: 'local'
+  const handleConnectLocalDevice = async (urlToFetch = localDeviceUrl) => {
+    setLocalLoading(true);
+    setLocalError(null);
+    try {
+      const data = await fetchLocalDeviceStatus(urlToFetch);
+      setLocalDeviceStatus(data);
+    } catch (err) {
+      setLocalError(formatLnaErrorRemediation('local-network', err));
+    } finally {
+      setLocalLoading(false);
+      await checkNetworkPermission('local-network', setLocalNetworkPerm);
+    }
+  };
+
+  // Connect to loopback companion daemon over HTTP with targetAddressSpace: 'loopback'
+  const handleConnectLoopbackDaemon = async (urlToFetch = loopbackDaemonUrl) => {
+    setLoopbackLoading(true);
+    setLoopbackError(null);
+    try {
+      const data = await fetchLoopbackDaemon(urlToFetch);
+      setLoopbackStatus(data);
+    } catch (err) {
+      setLoopbackError(formatLnaErrorRemediation('loopback-network', err));
+    } finally {
+      setLoopbackLoading(false);
+      await checkNetworkPermission('loopback-network', setLoopbackNetworkPerm);
+    }
+  };
+
+  // Print current article on LAN printer (user gesture, targetAddressSpace: 'local')
+  const handlePrintOnLan = async () => {
+    if (!articleSlug || !articleTitle) return;
+    setLocalLoading(true);
+    setLocalError(null);
+    setPrintStatusMessage(null);
+    try {
+      const printerEndpoint = localDeviceUrl.replace(/\/status$/, '/print');
+      const res = await sendArticleToLocalPrinter(
+        {
+          slug: articleSlug,
+          title: articleTitle,
+          summary: articleSummary,
+        },
+        printerEndpoint
+      );
+      setPrintStatusMessage(
+        res.jobId
+          ? `Sent "${articleTitle}" to LAN printer (Job #${res.jobId}).`
+          : `Sent "${articleTitle}" to LAN printer.`
+      );
+    } catch (err) {
+      setLocalError(formatLnaErrorRemediation('local-network', err));
+    } finally {
+      setLocalLoading(false);
+      await checkNetworkPermission('local-network', setLocalNetworkPerm);
+    }
+  };
+
+  // Sync article / reading list with loopback companion app (user gesture, targetAddressSpace: 'loopback')
+  const handleSyncLoopback = async () => {
+    setLoopbackLoading(true);
+    setLoopbackError(null);
+    setSyncStatusMessage(null);
+    try {
+      const syncEndpoint = loopbackDaemonUrl.replace(/\/health$/, '/sync');
+      const articlesToSync = articleSlug ? [articleSlug] : [];
+      const res = await syncWithLoopbackDaemon({ articles: articlesToSync }, syncEndpoint);
+      setSyncStatusMessage(
+        res.synced
+          ? `Synced ${res.count ?? articlesToSync.length} item(s) with local companion daemon.`
+          : 'Sync completed with local companion daemon.'
+      );
+    } catch (err) {
+      setLoopbackError(formatLnaErrorRemediation('loopback-network', err));
+    } finally {
+      setLoopbackLoading(false);
+      await checkNetworkPermission('loopback-network', setLoopbackNetworkPerm);
+    }
+  };
+
+  // Open WebSocket telemetry stream to local network device (user gesture)
+  const handleOpenWebSocket = () => {
+    setWsError(null);
+    setWsTelemetryMessage(null);
+
+    if (wsRef.current) {
+      wsRef.current.close();
+      wsRef.current = null;
+    }
+
+    try {
+      setWsConnectionState('connecting');
+      const socket = openLocalWebSocket(wsUrl);
+      wsRef.current = socket;
+
+      socket.addEventListener('open', () => {
+        setWsConnectionState('connected');
+        checkNetworkPermission('local-network', setLocalNetworkPerm);
+      });
+
+      socket.addEventListener('message', (event) => {
+        setWsTelemetryMessage(String(event.data));
+      });
+
+      socket.addEventListener('error', () => {
+        setWsConnectionState('error');
+        setWsError(
+          formatLnaErrorRemediation(
+            'local-network',
+            new TypeError('WebSocket connection to local device failed')
+          )
+        );
+        checkNetworkPermission('local-network', setLocalNetworkPerm);
+      });
+
+      socket.addEventListener('close', () => {
+        setWsConnectionState((prev) => (prev === 'error' ? 'error' : 'closed'));
+      });
+    } catch (err) {
+      setWsConnectionState('error');
+      setWsError(formatLnaErrorRemediation('local-network', err));
+    }
+  };
+
+  // Open WebTransport session to local network device (user gesture)
+  const handleOpenWebTransport = async () => {
+    setWtError(null);
+
+    if (wtRef.current) {
+      try {
+        wtRef.current.close();
+      } catch {
+        // Ignore close errors
+      }
+      wtRef.current = null;
+    }
+
+    if (typeof WebTransport === 'undefined') {
+      setWtConnectionState('error');
+      setWtError('WebTransport is not supported in this browser environment.');
+      return;
+    }
+
+    try {
+      setWtConnectionState('connecting');
+      const placeholderCertHash = new Uint8Array(32);
+      const transport = await openLocalWebTransport(wtUrl, placeholderCertHash);
+      wtRef.current = transport;
+      setWtConnectionState('connected');
+      await checkNetworkPermission('local-network', setLocalNetworkPerm);
+    } catch (err) {
+      setWtConnectionState('error');
+      setWtError(formatLnaErrorRemediation('local-network', err));
+      await checkNetworkPermission('local-network', setLocalNetworkPerm);
+    }
+  };
+
+  // Step 1: Pre-check granular permissions on mount; only auto-connect when state === 'granted'
+  useEffect(() => {
+    if (typeof window !== 'undefined') {
+      setIsSecure(window.isSecureContext);
+    }
+
+    let isMounted = true;
+
+    async function initPermissions() {
+      const localState = await checkNetworkPermission('local-network', (newState) => {
+        if (isMounted) setLocalNetworkPerm(newState);
+      });
+      if (isMounted) setLocalNetworkPerm(localState);
+
+      // Only connect automatically when permission is already 'granted'
+      if (localState === 'granted' && window.isSecureContext) {
+        handleConnectLocalDevice();
+      }
+
+      const loopbackState = await checkNetworkPermission('loopback-network', (newState) => {
+        if (isMounted) setLoopbackNetworkPerm(newState);
+      });
+      if (isMounted) setLoopbackNetworkPerm(loopbackState);
+
+      // Only connect automatically when permission is already 'granted'
+      if (loopbackState === 'granted' && window.isSecureContext) {
+        handleConnectLoopbackDaemon();
+      }
+    }
+
+    initPermissions();
+
+    return () => {
+      isMounted = false;
+      if (wsRef.current) {
+        wsRef.current.close();
+      }
+      if (wtRef.current) {
+        try {
+          wtRef.current.close();
+        } catch {
+          // ignore
+        }
+      }
+    };
+  }, []);
+
+  const badgeColor = (state: PermissionState) => {
+    if (state === 'granted') return 'bg-green-100 text-green-800 border-green-300';
+    if (state === 'denied') return 'bg-red-100 text-red-800 border-red-300';
+    return 'bg-amber-100 text-amber-800 border-amber-300';
+  };
+
+  return (
+    <section
+      aria-label="Local Network and Companion Access"
+      className="bg-gray-50 border border-gray-200 rounded-md p-4 my-4 text-xs text-gray-800"
+    >
+      {/* Summary Header Bar */}
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center space-x-2">
+          <span className="font-bold text-sm text-gray-900">
+            Local Network &amp; Companion Access
+          </span>
+          <span className="text-gray-500 hidden sm:inline">
+            (LAN Printer &amp; Offline Reader Daemon)
+          </span>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-3">
+          <div className="flex items-center space-x-1">
+            <span className="text-gray-600 font-medium">Local Network:</span>
+            <span
+              data-permission-status="local-network"
+              className={`px-2 py-0.5 rounded border font-semibold ${badgeColor(
+                localNetworkPerm
+              )}`}
+            >
+              {localNetworkPerm}
+            </span>
+          </div>
+
+          <div className="flex items-center space-x-1">
+            <span className="text-gray-600 font-medium">Loopback:</span>
+            <span
+              data-permission-status="loopback-network"
+              className={`px-2 py-0.5 rounded border font-semibold ${badgeColor(
+                loopbackNetworkPerm
+              )}`}
+            >
+              {loopbackNetworkPerm}
+            </span>
+          </div>
+
+          <button
+            type="button"
+            onClick={() => setIsExpanded((prev) => !prev)}
+            className="text-gray-700 hover:text-gray-900 font-semibold underline cursor-pointer"
+          >
+            {isExpanded ? 'Hide Controls' : 'Configure Devices'}
+          </button>
+        </div>
+      </div>
+
+      {/* Secure context warning if served over non-HTTPS non-loopback */}
+      {!isSecure && (
+        <div
+          role="alert"
+          className="mt-3 p-3 bg-red-50 border border-red-300 rounded text-red-800"
+        >
+          <strong>Insecure Context Detected:</strong> Local Network Access permissions require a
+          Secure Context (<code>https://</code>). Requests to local or loopback endpoints are
+          automatically denied on insecure <code>http://</code> origins.
+        </div>
+      )}
+
+      {/* Actionable Remediation UI for local-network (always in DOM, hidden when state !== 'denied') */}
+      <div
+        data-remediation="local-network"
+        hidden={localNetworkPerm !== 'denied'}
+        className="mt-3 p-3 bg-red-50 border border-red-300 rounded text-red-900"
+      >
+        <p className="font-semibold">Local Network Access is Blocked (`local-network`)</p>
+        <p className="mt-1">
+          To connect to your LAN printer or local newsroom display, click the tune/lock icon next to
+          the URL in your browser&apos;s address bar, open <strong>Site settings</strong>, and change{' '}
+          <strong>Local network</strong> from <em>Block</em> to <em>Allow</em>.
+        </p>
+      </div>
+
+      {/* Actionable Remediation UI for loopback-network (always in DOM, hidden when state !== 'denied') */}
+      <div
+        data-remediation="loopback-network"
+        hidden={loopbackNetworkPerm !== 'denied'}
+        className="mt-3 p-3 bg-red-50 border border-red-300 rounded text-red-900"
+      >
+        <p className="font-semibold">Loopback Network Access is Blocked (`loopback-network`)</p>
+        <p className="mt-1">
+          To sync articles with the DevTools Times Desktop Companion on your machine (
+          <code>127.0.0.1</code> / <code>localhost</code>), open your browser&apos;s{' '}
+          <strong>Site settings</strong> and change <strong>Loopback network</strong> from{' '}
+          <em>Block</em> to <em>Allow</em>.
+        </p>
+      </div>
+
+      {/* Main Controls Panel */}
+      <div className={isExpanded ? 'mt-4 grid grid-cols-1 md:grid-cols-2 gap-4' : 'hidden'}>
+        {/* 1. Local Network Device (LAN Printer / Telemetry Hub) */}
+        <div className="bg-white border border-gray-200 rounded p-3 flex flex-col justify-between">
+          <div>
+            <h3 className="font-bold text-gray-900 text-sm mb-1">
+              1. Local Network Device (<code>targetAddressSpace: &apos;local&apos;</code>)
+            </h3>
+            <p className="text-gray-600 mb-2">
+              Connect to a LAN printer or newsroom telemetry display on your local network (e.g.,{' '}
+              <code>192.168.1.x</code> or <code>.local</code>) to check device status or print
+              articles directly.
+            </p>
+
+            {localNetworkPerm === 'prompt' && (
+              <p className="text-amber-800 bg-amber-50 border border-amber-200 rounded p-2 mb-2">
+                <strong>Permission needed:</strong> Clicking a button below will ask your browser
+                for <code>local-network</code> permission to communicate with your LAN device.
+              </p>
+            )}
+
+            <label className="block text-gray-700 font-medium mb-1">
+              LAN Device Endpoint URL:
+              <input
+                type="url"
+                value={localDeviceUrl}
+                onChange={(e) => setLocalDeviceUrl(e.target.value)}
+                className="mt-1 block w-full border border-gray-300 rounded px-2 py-1 text-xs"
+              />
+            </label>
+          </div>
+
+          <div className="mt-3 space-y-2">
+            <div className="flex flex-wrap gap-2">
+              <button
+                type="button"
+                onClick={() => handleConnectLocalDevice(localDeviceUrl)}
+                disabled={localLoading}
+                className="bg-gray-800 text-white font-semibold py-1.5 px-3 rounded hover:bg-gray-700 disabled:opacity-50 cursor-pointer"
+              >
+                {localLoading ? 'Connecting...' : 'Check LAN Device Status'}
+              </button>
+
+              {articleSlug && articleTitle && (
+                <button
+                  type="button"
+                  onClick={handlePrintOnLan}
+                  disabled={localLoading}
+                  className="bg-amber-600 text-white font-semibold py-1.5 px-3 rounded hover:bg-amber-500 disabled:opacity-50 cursor-pointer"
+                >
+                  Print Article on LAN Printer
+                </button>
+              )}
+            </div>
+
+            {localDeviceStatus && (
+              <div className="p-2 bg-green-50 border border-green-200 rounded text-green-900">
+                Connected to LAN device: <strong>{localDeviceStatus.status || 'Online'}</strong>
+              </div>
+            )}
+
+            {printStatusMessage && (
+              <div className="p-2 bg-green-50 border border-green-200 rounded text-green-900">
+                {printStatusMessage}
+              </div>
+            )}
+
+            {localError && (
+              <div role="alert" className="p-2 bg-red-50 border border-red-200 rounded text-red-800">
+                {localError}
+              </div>
+            )}
+          </div>
+        </div>
+
+        {/* 2. Loopback Companion Service (Desktop Reader Daemon) */}
+        <div className="bg-white border border-gray-200 rounded p-3 flex flex-col justify-between">
+          <div>
+            <h3 className="font-bold text-gray-900 text-sm mb-1">
+              2. Loopback Companion Daemon (<code>targetAddressSpace: &apos;loopback&apos;</code>)
+            </h3>
+            <p className="text-gray-600 mb-2">
+              Connect to the DevTools Times Companion service running locally on your computer (
+              <code>127.0.0.1</code>, <code>[::1]</code>, or <code>localhost</code>) for offline
+              reading list synchronization.
+            </p>
+
+            {loopbackNetworkPerm === 'prompt' && (
+              <p className="text-amber-800 bg-amber-50 border border-amber-200 rounded p-2 mb-2">
+                <strong>Permission needed:</strong> Clicking below will trigger the{' '}
+                <code>loopback-network</code> permission prompt to connect to your local companion
+                daemon.
+              </p>
+            )}
+
+            <label className="block text-gray-700 font-medium mb-1">
+              Loopback Daemon Health URL:
+              <input
+                type="url"
+                value={loopbackDaemonUrl}
+                onChange={(e) => setLoopbackDaemonUrl(e.target.value)}
+                className="mt-1 block w-full border border-gray-300 rounded px-2 py-1 text-xs"
+              />
+            </label>
+          </div>
+
+          <div className="mt-3 space-y-2">
+            <div className="flex flex-wrap gap-2">
+              <button
+                type="button"
+                onClick={() => handleConnectLoopbackDaemon(loopbackDaemonUrl)}
+                disabled={loopbackLoading}
+                className="bg-gray-800 text-white font-semibold py-1.5 px-3 rounded hover:bg-gray-700 disabled:opacity-50 cursor-pointer"
+              >
+                {loopbackLoading ? 'Connecting...' : 'Connect Companion Daemon'}
+              </button>
+
+              <button
+                type="button"
+                onClick={handleSyncLoopback}
+                disabled={loopbackLoading}
+                className="bg-gray-600 text-white font-semibold py-1.5 px-3 rounded hover:bg-gray-500 disabled:opacity-50 cursor-pointer"
+              >
+                Sync Offline Reading List
+              </button>
+            </div>
+
+            {loopbackStatus && (
+              <div className="p-2 bg-green-50 border border-green-200 rounded text-green-900">
+                Companion daemon status: <strong>{loopbackStatus.status || 'Healthy'}</strong>
+              </div>
+            )}
+
+            {syncStatusMessage && (
+              <div className="p-2 bg-green-50 border border-green-200 rounded text-green-900">
+                {syncStatusMessage}
+              </div>
+            )}
+
+            {loopbackError && (
+              <div role="alert" className="p-2 bg-red-50 border border-red-200 rounded text-red-800">
+                {loopbackError}
+              </div>
+            )}
+          </div>
+        </div>
+
+        {/* 3. Real-Time Local Telemetry (WebSocket & WebTransport) */}
+        <div className="bg-white border border-gray-200 rounded p-3">
+          <h3 className="font-bold text-gray-900 text-sm mb-1">
+            3. Real-Time Local Streams (<code>WebSocket</code> &amp; <code>WebTransport</code>)
+          </h3>
+          <p className="text-gray-600 mb-2">
+            Stream live newsroom ticker telemetry from a local hardware bridge using{' '}
+            <code>WebSocket</code> (subprotocol <code>v1.telemetry</code>) or{' '}
+            <code>WebTransport</code> over QUIC.
+          </p>
+
+          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-2">
+            <label className="block text-gray-700 font-medium">
+              WebSocket URL:
+              <input
+                type="text"
+                value={wsUrl}
+                onChange={(e) => setWsUrl(e.target.value)}
+                className="mt-1 block w-full border border-gray-300 rounded px-2 py-1 text-xs"
+              />
+            </label>
+            <label className="block text-gray-700 font-medium">
+              WebTransport URL:
+              <input
+                type="url"
+                value={wtUrl}
+                onChange={(e) => setWtUrl(e.target.value)}
+                className="mt-1 block w-full border border-gray-300 rounded px-2 py-1 text-xs"
+              />
+            </label>
+          </div>
+
+          <div className="flex flex-wrap gap-2 mt-2">
+            <button
+              type="button"
+              onClick={handleOpenWebSocket}
+              className="bg-gray-800 text-white font-semibold py-1.5 px-3 rounded hover:bg-gray-700 cursor-pointer"
+            >
+              Open Local WebSocket ({wsConnectionState})
+            </button>
+            <button
+              type="button"
+              onClick={handleOpenWebTransport}
+              className="bg-gray-700 text-white font-semibold py-1.5 px-3 rounded hover:bg-gray-600 cursor-pointer"
+            >
+              Open Local WebTransport ({wtConnectionState})
+            </button>
+          </div>
+
+          {wsTelemetryMessage && (
+            <div className="mt-2 p-2 bg-blue-50 border border-blue-200 rounded text-blue-900">
+              Telemetry: {wsTelemetryMessage}
+            </div>
+          )}
+
+          {wsError && (
+            <div role="alert" className="mt-2 p-2 bg-red-50 border border-red-200 rounded text-red-800">
+              {wsError}
+            </div>
+          )}
+
+          {wtError && (
+            <div role="alert" className="mt-2 p-2 bg-red-50 border border-red-200 rounded text-red-800">
+              {wtError}
+            </div>
+          )}
+        </div>
+
+        {/* 4. Delegated Cross-Origin Partner Device Bridge Iframe */}
+        <div className="bg-white border border-gray-200 rounded p-3">
+          <h3 className="font-bold text-gray-900 text-sm mb-1">
+            4. Partner Device Bridge (<code>Permissions-Policy</code> Delegation)
+          </h3>
+          <p className="text-gray-600 mb-2">
+            Cross-origin hardware setup frame delegated <code>local-network</code> and{' '}
+            <code>loopback-network</code> permissions via the <code>allow</code> attribute and HTTP{' '}
+            <code>Permissions-Policy</code> header.
+          </p>
+          <iframe
+            src="https://setup.partner.example.com/device-bridge"
+            allow="local-network; loopback-network"
+            title="Local Device Bridge"
+            loading="lazy"
+            className="w-full h-16 border border-gray-200 rounded bg-gray-50"
+          />
+        </div>
+      </div>
+    </section>
+  );
+};
+
+export default LocalNetworkPanel;
