--- /dev/null
+++ b/tests/local-network.spec.mjs
@@ -0,0 +1,102 @@
+import { test, expect } from '@playwright/test';
+
+// Serve the actual app under an HTTPS test origin. Local service responses and
+// experimental permission names are mocked, so no real device is required.
+async function openConnections(page, { state = 'prompt', unsupported = false, failure = false, insecure = false } = {}) {
+  const errors = [];
+  page.on('pageerror', error => errors.push(error.message));
+  await page.addInitScript(({ state, unsupported, failure }) => {
+    window.networkTest = { queries: [], requests: [], statuses: {} };
+    Object.defineProperty(navigator, 'permissions', { value: {
+      async query({ name }) {
+        window.networkTest.queries.push(name);
+        if (unsupported) throw new TypeError('Unknown permission name');
+        const status = new EventTarget();
+        status.state = state;
+        window.networkTest.statuses[name] = status;
+        return status;
+      },
+    } });
+    const originalFetch = window.fetch;
+    window.fetch = async (url, options) => {
+      if (options?.targetAddressSpace) {
+        window.networkTest.requests.push({ url, targetAddressSpace: options.targetAddressSpace });
+        if (failure) throw new TypeError('Failed to fetch');
+        return new Response(JSON.stringify({ status: 'ready' }), { headers: { 'Content-Type': 'application/json' } });
+      }
+      return originalFetch(url, options);
+    };
+  }, { state, unsupported, failure });
+  await page.route('**/*', async route => {
+    const url = new URL(route.request().url());
+    if (url.hostname === 'times.test') {
+      const response = await route.fetch({ url: `http://127.0.0.1:4398${url.pathname}${url.search}` });
+      await route.fulfill({ response });
+    } else if (url.hostname === '127.0.0.1') await route.continue();
+    else await route.abort();
+  });
+  await page.goto(insecure ? 'http://127.0.0.1:4398/devtools-times/local-connections' : 'https://times.test/devtools-times/local-connections');
+  await expect(page.getByText(/permission: checking/)).toHaveCount(0);
+  return errors;
+}
+
+for (const unsupported of [false, true]) {
+  test(`prompt requires a click${unsupported ? ' when permission queries are unsupported' : ''}`, async ({ page }) => {
+    const errors = await openConnections(page, { unsupported });
+    await expect(page.getByRole('button', { name: 'Connect to device' })).toBeEnabled();
+    expect(await page.evaluate(() => window.networkTest.requests)).toEqual([]);
