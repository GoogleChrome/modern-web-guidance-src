diff --git a/src/components/LocalConnections.tsx b/src/components/LocalConnections.tsx
new file mode 100644
index 0000000..224b578
--- /dev/null
+++ b/src/components/LocalConnections.tsx
@@ -0,0 +1,128 @@
+import { useEffect, useRef, useState } from 'react';
+import { fetchNetworkStatus, queryNetworkPermission, requireHttps, type AddressSpace } from '../utils/local-network';
+
+function Connection({ space, title, initialUrl }: { space: AddressSpace; title: string; initialUrl: string }) {
+  const [url, setUrl] = useState(initialUrl);
+  const [permission, setPermission] = useState<PermissionState | 'checking'>('checking');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [result, setResult] = useState<string | null>(null);
+  const [secure, setSecure] = useState(false);
+  const currentUrl = useRef(url);
+  const state = useRef<PermissionState | 'checking'>('checking');
+  const active = useRef(false);
+  const request = useRef<AbortController | null>(null);
+  const permissionLabel = space === 'local' ? 'Local network' : 'Loopback network';
+  const recovery = space === 'local'
+    ? 'Check that the device is powered on and connected to the same network. In browser Site settings, allow Local network access, then retry.'
+    : 'Check that your companion app is running at this address. In browser Site settings, allow Loopback network access, then retry.';
+
+  async function connect(userGesture: boolean) {
+    if (request.current || state.current === 'checking' || state.current === 'denied' ||
+      (state.current !== 'granted' && !userGesture)) return;
+    const controller = new AbortController();
+    request.current = controller;
+    setBusy(true);
+    setError('');
+    setResult(null);
+    const timeout = window.setTimeout(() => controller.abort(), 10000);
+    try {
+      const data = await fetchNetworkStatus(currentUrl.current, space, controller.signal);
+      if (active.current && request.current === controller) {
+        setResult(JSON.stringify(data, null, 2) ?? 'Connected.');
+      }
+    } catch (cause: unknown) {
+      if (active.current && request.current === controller) {
+        const detail = controller.signal.aborted ? 'The connection timed out.'
+          : cause instanceof Error ? cause.message : 'The connection failed.';
+        setError(`${detail} ${recovery} If access is allowed, check the address and the service’s CORS configuration.`);
+        const status = await queryNetworkPermission(space);
+        if (active.current && request.current === controller && status) {
+          state.current = status.state;
+          setPermission(status.state);
+        }
+      }
+    } finally {
+      window.clearTimeout(timeout);
+      if (active.current && request.current === controller) {
+        request.current = null;
+        setBusy(false);
+      }
+    }
+  }
+
+  useEffect(() => {
+    active.current = true;
+    let disposed = false;
+    let status: PermissionStatus | null = null;
+    const sync = () => {
+      if (disposed) return;
+      const next = status?.state ?? 'prompt';
+      state.current = next;
+      setPermission(next);
+      if (next !== 'granted') {
+        request.current?.abort();
+        request.current = null;
+        setBusy(false);
+        setResult(null);
+      }
+      if (next === 'denied') setError(recovery);
+      else setError('');
+    };
+    async function initialize() {
+      try {
+        requireHttps();
+        setSecure(true);
+        status = await queryNetworkPermission(space);
+        if (disposed) return;
+        status?.addEventListener('change', sync);
+        sync();
+        // Only a pre-existing grant permits automatic connection.
+        if (state.current === 'granted') await connect(false);
+      } catch (cause: unknown) {
+        if (!disposed) {
+          setError(cause instanceof Error ? cause.message : 'Unable to initialize local connections.');
+          setPermission('prompt');
+        }
+      }
+    }
+    void initialize();
+    return () => {
+      disposed = true;
+      active.current = false;
+      status?.removeEventListener('change', sync);
+      request.current?.abort();
+      request.current = null;
+    };
+  }, [space]);
+
+  return (
+    <section className="border border-gray-300 rounded-lg p-5 space-y-4" aria-labelledby={`${space}-heading`}>
+      <h2 id={`${space}-heading`} className="text-2xl font-brand">{title}</h2>
+      <p className="text-sm text-gray-700">
+        {space === 'local' ? 'Read status from a device on your local network.' : 'Read status from a companion app running on this computer.'}
+        {' '}Connecting may ask your browser for {permissionLabel.toLowerCase()} permission. Use a service you trust.
+      </p>
+      <form onSubmit={(event) => { event.preventDefault(); void connect(true); }} className="space-y-3">
+        <label htmlFor={`${space}-url`} className="block text-sm font-semibold">Service status URL</label>
+        <input id={`${space}-url`} type="url" required value={url} disabled={busy}
+          onChange={(event) => { setUrl(event.target.value); currentUrl.current = event.target.value; setResult(null); }}
+          className="border border-gray-400 rounded p-2 w-full" />
+        <p className="text-sm" aria-live="polite">{permissionLabel} permission: {permission}</p>
+        <button type="submit" disabled={!secure || busy || permission === 'checking' || permission === 'denied'}
+          className="bg-gray-900 text-white rounded px-4 py-2 disabled:opacity-50">
+          {busy ? 'Connecting…' : `Connect to ${space === 'local' ? 'device' : 'companion app'}`}
+        </button>
+      </form>
+      {error && <p role="alert" className="text-red-800 bg-red-50 p-3 rounded">{error}</p>}
+      {result !== null && <div role="status"><p className="font-semibold">Connected successfully</p><pre className="overflow-auto text-sm bg-gray-100 p-3 mt-2">{result}</pre></div>}
+    </section>
+  );
+}
+
+export default function LocalConnections() {
+  return <div className="grid gap-6 md:grid-cols-2">
+    <Connection space="local" title="Local network device" initialUrl="http://192.168.1.100:8080/api/status" />
+    <Connection space="loopback" title="Companion app" initialUrl="http://127.0.0.1:45678/health" />
+  </div>;
+}
