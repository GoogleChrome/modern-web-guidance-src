diff --git a/src/utils/local-network.ts b/src/utils/local-network.ts
new file mode 100644
index 0000000..0397472
--- /dev/null
+++ b/src/utils/local-network.ts
@@ -0,0 +1,59 @@
+export type AddressSpace = 'local' | 'loopback';
+export type NetworkPermission = 'local-network' | 'loopback-network';
+
+export const permissionFor = (space: AddressSpace): NetworkPermission =>
+  space === 'local' ? 'local-network' : 'loopback-network';
+
+// These granular names are not yet included in every TypeScript DOM library.
+export async function queryNetworkPermission(space: AddressSpace): Promise<PermissionStatus | null> {
+  try {
+    if (!navigator.permissions?.query) return null;
+    return await navigator.permissions.query({
+      name: permissionFor(space) as PermissionName,
+    });
+  } catch {
+    // Unsupported permission queries must still require a user gesture.
+    return null;
+  }
+}
+
+export function requireHttps(): void {
+  if (!window.isSecureContext || window.location.protocol !== 'https:') {
+    throw new Error('Open this page over HTTPS to connect to a local device or companion app.');
+  }
+}
+
+export function validateEndpoint(value: string, space: AddressSpace): URL {
+  const url = new URL(value);
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
+    throw new Error('Enter an HTTP or HTTPS address without embedded credentials.');
+  }
+  const host = url.hostname.toLowerCase().replace(/\.$/, '');
+  const loopback = host === 'localhost' || host.endsWith('.localhost') ||
+    host === '[::1]' || /^127\./.test(host);
+  if (space === 'loopback' && !loopback) {
+    throw new Error('Use localhost, a 127.x.x.x address, or [::1] for the companion app.');
+  }
+  if (space === 'local' && loopback) {
+    throw new Error('Use the companion app control for loopback addresses.');
+  }
+  // Custom LAN hostnames are allowed. The browser verifies their resolved space.
+  return url;
+}
+
+export async function fetchNetworkStatus(value: string, space: AddressSpace, signal: AbortSignal): Promise<unknown> {
+  requireHttps();
+  const url = validateEndpoint(value, space);
+  const options: RequestInit & { targetAddressSpace: AddressSpace } = {
+    method: 'GET',
+    mode: 'cors',
+    credentials: 'omit',
+    redirect: 'error',
+    cache: 'no-store',
+    targetAddressSpace: space,
+    signal,
+  };
+  const response = await fetch(url.href, options);
+  if (!response.ok) throw new Error(`The service returned HTTP ${response.status}.`);
+  return response.json();
+}
