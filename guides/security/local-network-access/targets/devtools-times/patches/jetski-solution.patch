+/**
+ * Helpers for Local Network Access (LNA) permissions ('local-network' and
+ * 'loopback-network'). These granular permissions govern connections from public
+ * origins to the user's private local network (RFC 1918) and loopback interface.
+ *
+ * NOTE: The legacy combined 'local-network-access' permission name must NEVER
+ * be queried via navigator.permissions.query(), as doing so causes browser crashes
+ * in older Chrome renderers.
+ */
+
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type TargetAddressSpace = 'local' | 'loopback' | 'public';
+
+export interface LnaRequestInit extends RequestInit {
+  targetAddressSpace?: TargetAddressSpace;
+}
+
+/**
+ * Cross-browser permission check for granular Local Network Access permissions.
+ * Falls back gracefully to 'prompt' when the Permissions API is unavailable or
+ * when the permission name is unrecognized by the browser.
+ *
+ * @param {'local-network' | 'loopback-network'} permissionName
+ */
+export async function queryLnaPermissionSafe(permissionName: LnaPermissionName): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({ name: permissionName } as unknown as PermissionDescriptor);
+    return status.state;
+  } catch {
+    // Unrecognized permission name; treat as 'prompt' so request proceeds on explicit user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Alias for queryLnaPermissionSafe to match standard guidance.
+ *
+ * @param {'local-network' | 'loopback-network'} permissionName
+ */
+export async function checkNetworkPermission(permissionName: LnaPermissionName): Promise<PermissionState> {
+  return queryLnaPermissionSafe(permissionName);
+}
+
+/**
+ * Queries the granular permission and watches for state updates (e.g., changes made
+ * in browser site settings).
+ *
+ * @param {'local-network' | 'loopback-network'} permissionName
+ * @param {(state: PermissionState) => void} onChange
+ * @returns {Promise<() => void>} Cleanup function to remove event listener
+ */
+export async function watchLnaPermission(
+  permissionName: LnaPermissionName,
+  onChange: (state: PermissionState) => void
+): Promise<() => void> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    onChange('prompt');
+    return () => {};
+  }
+  try {
+    const status = await navigator.permissions.query({ name: permissionName } as unknown as PermissionDescriptor);
+    const listener = () => onChange(status.state);
+    status.addEventListener('change', listener);
+    onChange(status.state);
+    return () => status.removeEventListener('change', listener);
+  } catch {
+    onChange('prompt');
+    return () => {};
+  }
+}
+
+/**
+ * Connects to a local network device (e.g. LAN printer or IoT hub) over HTTP.
+ * Declares targetAddressSpace: 'local' to exempt the request from Mixed Content blocking
+ * and verify the resolved IP belongs to the local address space.
+ *
+ * @param {string} deviceUrl
+ */
+export async function fetchLocalDeviceStatus(deviceUrl = 'http://192.168.1.100:8080/api/status'): Promise<any> {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: 'local',
+  });
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Device responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Connects to a local companion daemon running on the user's loopback interface.
+ * Declares targetAddressSpace: 'loopback' to verify the resolved address space.
+ *
+ * @param {string} daemonUrl
+ */
+export async function fetchLoopbackDaemon(daemonUrl = 'http://127.0.0.1:45678/health'): Promise<any> {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    targetAddressSpace: 'loopback',
+  });
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion app responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Generic helper to fetch a resource with explicit targetAddressSpace declaration.
+ *
+ * @param {string} url
+ * @param {TargetAddressSpace} targetAddressSpace
+ * @param {RequestInit} [init]
+ */
+export async function fetchLocalResource(
+  url: string,
+  targetAddressSpace: TargetAddressSpace,
+  init: RequestInit = {}
+): Promise<Response> {
+  const request = new Request(url, {
+    ...init,
+    targetAddressSpace,
+  });
+  return fetch(request);
+}
+
+/**
+ * Cross-browser WebSocket helper that passes targetAddressSpace: 'local' or 'loopback'
+ * via WebSocketInit where supported, falling back to standard WebSocket.
+ *
+ * @param {string} url
+ * @param {{ protocols?: string[]; targetAddressSpace?: TargetAddressSpace }} [options]
+ */
+export function connectLocalWebSocketSafe(
+  url: string,
+  { protocols = [] as string[], targetAddressSpace = 'local' as TargetAddressSpace } = {}
+): WebSocket {
+  try {
+    return new WebSocket(url, { protocols, targetAddressSpace } as any);
+  } catch {
+    return new WebSocket(url, protocols);
+  }
+}
+
+/**
+ * Opens a WebSocket connection to a local network device with targetAddressSpace: 'local'.
+ *
+ * @param {string} [wsUrl]
+ */
+export function openLocalWebSocket(wsUrl = 'ws://192.168.1.100:8080/stream'): WebSocket {
+  return connectLocalWebSocketSafe(wsUrl, {
+    protocols: ['v1.telemetry'],
+    targetAddressSpace: 'local',
+  });
+}
