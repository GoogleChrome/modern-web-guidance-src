+        </form>
+        <form class="card" data-connection="loopback">
+          <h3>Companion app</h3>
+          <p>Allow Loopback network access to check the companion service running on this computer.</p>
+          <label for="loopback-url">Companion health URL (replace the example)</label>
+          <input id="loopback-url" name="endpoint" type="url" value="http://127.0.0.1:45678/health" required spellcheck="false">
+          <p>Permission: <span data-permission-status="loopback-network">Checking…</span></p>
+          <button class="btn" type="submit" disabled>Connect to companion</button>
+          <p class="feedback" data-feedback role="status" aria-live="polite"></p>
+          <p data-error role="alert" hidden></p>
+          <p data-remediation="loopback-network" hidden>Open your browser’s Site settings for this site, set <strong>Loopback network</strong> to Allow (or Ask), then try again. If needed, reload this page.</p>
