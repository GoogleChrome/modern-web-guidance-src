+type NetworkPermission = 'local-network' | 'loopback-network';
+type AddressSpace = 'local' | 'loopback';
+type LocalRequestInit = RequestInit & { targetAddressSpace: AddressSpace };
+
+function element<T extends HTMLElement>(id: string, kind: new () => T): T {
+  const node = document.getElementById(id);
+  if (!(node instanceof kind)) throw new Error(`Missing equipment control: ${id}`);
+  return node;
+}
+
+function endpoint(value: string, space: AddressSpace): URL {
+  const url = new URL(value);
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.hash) {
+    throw new Error('Use an HTTP or HTTPS URL without credentials or a fragment.');
+  }
+  const host = url.hostname.toLowerCase().replace(/\.$/, '');
+  const loopback = host === 'localhost' || host.endsWith('.localhost') || host === '[::1]' || /^127\./.test(host);
+  if (space === 'loopback' && !loopback) throw new Error('The utility address must use localhost, 127.x.x.x, or [::1].');
+  if (space === 'local' && loopback) throw new Error('Use a LAN address for the brewer, not a loopback address.');
+  // Custom LAN DNS names are allowed; the browser verifies the resolved address space.
+  return url;
+}
+
+async function setup(id: string, permission: NetworkPermission, space: AddressSpace): Promise<void> {
+  const form = element(`${id}-form`, HTMLFormElement);
+  const input = element(`${id}-url`, HTMLInputElement);
+  const badge = element(`${id}-permission`, HTMLSpanElement);
+  const feedback = element(`${id}-feedback`, HTMLParagraphElement);
+  const remediation = element(`${id}-remediation`, HTMLParagraphElement);
+  const button = form.querySelector('button');
+  if (!button) throw new Error('Missing connect button');
+  let state: PermissionState = 'prompt';
+  let known = false;
+  let ready = false;
+  let controller: AbortController | undefined;
+  let generation = 0;
+  const secure = window.isSecureContext && location.protocol === 'https:';
+
+  function render(): void {
+    badge.textContent = known ? state : 'Ask on connect (permission query unavailable)';
+    remediation.hidden = state !== 'denied';
+    button!.disabled = !secure || !ready || state === 'denied' || !!controller;
+  }
+
+  function cancel(): void {
+    generation++;
+    controller?.abort();
+    controller = undefined;
+    render();
+  }
+
+  async function connect(): Promise<void> {
+    if (!secure || !ready || state === 'denied' || controller) return;
+    let url: URL;
+    try { url = endpoint(input.value.trim(), space); }
+    catch (error) {
+      feedback.textContent = error instanceof Error ? error.message : 'Enter a valid endpoint URL.';
+      return;
+    }
+    const attempt = ++generation;
+    const active = new AbortController();
+    controller = active;
+    render();
+    feedback.textContent = 'Connecting… If asked, allow access in the browser permission prompt.';
+    const timeout = window.setTimeout(() => active.abort(), 12000);
+    try {
+      const options: LocalRequestInit = {
+        method: 'GET', mode: 'cors', credentials: 'omit', cache: 'no-store',
+        redirect: 'error', targetAddressSpace: space, signal: active.signal,
+      };
+      const response = await fetch(new Request(url, options));
+      if (!response.ok) throw new Error(`Service returned HTTP ${response.status}. Check the status endpoint and try again.`);
+      // A successful CORS-readable response is enough to confirm connectivity.
+      await response.body?.cancel();
+      if (attempt === generation) feedback.textContent = `Connected. Status endpoint responded successfully (HTTP ${response.status}).`;
+    } catch (error) {
+      if (attempt !== generation) return;
+      feedback.textContent = active.signal.aborted
+        ? 'Connection timed out. Check the service is running and reachable, then retry.'
+        : error instanceof TypeError
+          ? 'Connection failed. Check the address, browser network permissions, and service CORS settings. Ensure the brewer is on the same Wi-Fi or the utility is running. Your browser may not support local HTTP connections.'
+          : error instanceof Error ? error.message : 'Connection failed. Check the service and try again.';
+    } finally {
+      window.clearTimeout(timeout);
+      if (attempt === generation) { controller = undefined; render(); }
+    }
+  }
+
+  form.addEventListener('submit', event => { event.preventDefault(); void connect(); });
+  input.addEventListener('input', () => { cancel(); feedback.textContent = 'Address changed. Connect to check this endpoint.'; });
+  window.addEventListener('pagehide', cancel);
+  try {
+    if (navigator.permissions?.query) {
+      // DOM typings may lag behind the browser's granular LNA descriptors.
+      const descriptor = { name: permission } as unknown as PermissionDescriptor;
+      const status = await navigator.permissions.query(descriptor);
+      known = true;
+      state = status.state;
+      status.addEventListener('change', () => {
+        state = status.state;
+        cancel();
+        feedback.textContent = state === 'denied' ? 'Access blocked. Update browser Site settings to reconnect.' : 'Permission updated. Ready to connect.';
+        if (state === 'granted') void connect();
+      });
+    }
+  } catch {
+    // Unsupported permission names fall back to an explicit user gesture.
+    state = 'prompt';
+  }
+  ready = true;
+  render();
+  feedback.textContent = !secure ? 'HTTPS is required to connect.' : state === 'denied'
+    ? 'Access blocked. Update browser Site settings to reconnect.'
+    : 'Ready. Connect to check the service and allow access if prompted.';
+  if (state === 'granted') void connect();
+}
+
+element('secure-notice', HTMLParagraphElement).hidden = window.isSecureContext && location.protocol === 'https:';
+void setup('brewer', 'local-network', 'local');
+void setup('companion', 'loopback-network', 'loopback');
