+++ b/tests/network.test.ts
@@ -0,0 +1,100 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { test, type TestContext } from 'node:test';
+import { JSDOM } from 'jsdom';
+import { canConnect, fetchDeviceStatus } from '../src/network.ts';
+
+const html = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+let instance = 0;
+
+function replaceGlobal(t: TestContext, name: string, value: unknown): void {
+  const original = Object.getOwnPropertyDescriptor(globalThis, name);
+  Object.defineProperty(globalThis, name, { configurable: true, writable: true, value });
+  t.after(() => {
+    if (original) Object.defineProperty(globalThis, name, original);
+    else Reflect.deleteProperty(globalThis, name);
+  });
+}
+
+test('only granted permission or an explicit prompt-state gesture permits a request', () => {
+  assert.equal(canConnect('prompt', false), false);
+  assert.equal(canConnect('prompt', true), true);
+  assert.equal(canConnect('granted', false), true);
+  assert.equal(canConnect('denied', true), false);
+  assert.equal(canConnect('denied', false), false);
+});
+
+for (const scenario of ['prompt', 'granted', 'denied', 'unsupported', 'missing', 'failure', 'http-error', 'insecure'] as const) {
+  test(`connection panel: ${scenario}`, async (t) => {
+    const dom = new JSDOM(html, { url: scenario === 'insecure' ? 'http://coffee.example' : 'https://coffee.example' });
+    t.after(() => dom.window.close());
+    Object.defineProperty(dom.window, 'isSecureContext', { value: scenario !== 'insecure' });
+    replaceGlobal(t, 'window', dom.window);
+    replaceGlobal(t, 'document', dom.window.document);
+    const queries: string[] = [];
+    const statuses: Array<EventTarget & { state: PermissionState }> = [];
+    const permissions = {
+      async query({ name }: { name: string }) {
+        queries.push(name);
+        if (scenario === 'unsupported') throw new TypeError('Unknown permission');
+        const status = Object.assign(new EventTarget(), {
+          state: (scenario === 'granted' || scenario === 'denied' ? scenario : 'prompt') as PermissionState,
+        });
+        statuses.push(status);
+        return status;
+      },
+    };
+    replaceGlobal(t, 'navigator', { permissions: scenario === 'missing' ? undefined : permissions });
+    const requests: Array<{ url: string; options: RequestInit & { targetAddressSpace?: string } }> = [];
+    t.mock.method(globalThis, 'fetch', async (url: string | URL | Request, options: RequestInit = {}) => {
+      requests.push({ url: String(url), options });
+      if (scenario === 'failure') throw new TypeError('Failed to fetch');
+      return new Response(null, { status: scenario === 'http-error' ? 503 : 200 });
+    });
+    await import(`../src/main.ts?test=${instance++}`);
+    await new Promise<void>((resolve) => setImmediate(resolve));
+    const forms = [...dom.window.document.querySelectorAll<HTMLFormElement>('form')];
+    assert.equal(forms.length, 2);
+    assert.deepEqual(queries, scenario === 'insecure' || scenario === 'missing' ? [] : ['local-network', 'loopback-network']);
+    assert.equal(requests.length, scenario === 'granted' ? 2 : 0);
+
+    if (scenario === 'insecure') {
+      assert.equal(dom.window.document.querySelector<HTMLElement>('#secure-context-error')?.hidden, false);
+      await assert.rejects(fetchDeviceStatus('http://127.0.0.1/health', 'loopback'), /HTTPS/);
+      assert.equal(requests.length, 0);
+      return;
+    }
+    if (scenario === 'denied') {
+      for (const form of forms) {
+        assert.equal(form.querySelector<HTMLElement>('[data-remediation]')?.hidden, false);
+        assert.equal(form.querySelector('button')?.disabled, true);
+        form.dispatchEvent(new dom.window.Event('submit', { cancelable: true }));
+      }
+      assert.equal(requests.length, 0);
+      statuses.forEach((status) => {
+        status.state = 'prompt';
+        status.dispatchEvent(new Event('change'));
+      });
+      for (const form of forms) assert.equal(form.querySelector('button')?.disabled, false);
+      assert.equal(requests.length, 0);
+      return;
+    }
+    if (scenario !== 'granted') {
+      for (const form of forms) form.querySelector('button')?.click();
+      await new Promise<void>((resolve) => setImmediate(resolve));
+    }
+    assert.equal(requests.length, 2);
+    assert.deepEqual(requests.map((request) => request.options.targetAddressSpace), ['local', 'loopback']);
+    assert.ok(requests.every((request) => request.options.mode === 'cors'));
+    for (const form of forms) {
+      if (scenario === 'failure' || scenario === 'http-error') {
+        assert.equal(form.querySelector<HTMLElement>('[data-error]')?.hidden, false);
+        assert.equal(form.querySelector<HTMLElement>('[data-remediation]')?.hidden, false);
+        assert.match(form.querySelector('[data-error]')?.textContent ?? '', /browser permissions/);
+      } else {
+        assert.match(form.querySelector('[data-feedback]')?.textContent ?? '', /Connected/);
+      }
+      assert.equal(form.querySelector('button')?.disabled, false);
+    }
+  });
+}
