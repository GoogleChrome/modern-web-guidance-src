+          <p>Allow Local network access to read your device’s status on the same network.</p>
+          <label for="local-url">Device status URL (replace the example)</label>
+          <input id="local-url" name="endpoint" type="url" value="http://192.168.1.100:8080/api/status" required spellcheck="false">
