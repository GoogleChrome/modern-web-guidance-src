diff --git a/src/main.ts b/src/main.ts
new file mode 100644
index 0000000..6d541df
--- /dev/null
+++ b/src/main.ts
@@ -0,0 +1,81 @@
+import { canConnect, fetchDeviceStatus, queryNetworkPermission, type AddressSpace, type NetworkPermission } from './network';
+
+function required<T extends Element>(parent: ParentNode, selector: string): T {
+  const element = parent.querySelector<T>(selector);
+  if (!element) throw new Error(`Missing connection control: ${selector}`);
+  return element;
+}
+
+async function setupConnection(form: HTMLFormElement, space: AddressSpace): Promise<void> {
+  const permission: NetworkPermission = space === 'local' ? 'local-network' : 'loopback-network';
+  const button = required<HTMLButtonElement>(form, 'button');
+  const input = required<HTMLInputElement>(form, 'input');
+  const badge = required<HTMLElement>(form, '[data-permission-status]');
+  const feedback = required<HTMLElement>(form, '[data-feedback]');
+  const error = required<HTMLElement>(form, '[data-error]');
+  const remediation = required<HTMLElement>(form, '[data-remediation]');
+  let state: PermissionState = 'prompt';
+  let ready = false;
+  let busy = false;
+
+  function updatePermission(next: PermissionState): void {
+    state = next;
+    badge.textContent = next;
+    remediation.hidden = next !== 'denied';
+    button.disabled = !ready || busy || next === 'denied';
+    if (next === 'denied') feedback.textContent = 'Access is blocked. Update your browser permissions to connect.';
+    else if (!busy) feedback.textContent = next === 'prompt' ? 'Click Connect when you’re ready to allow access.' : 'Access allowed. Ready to connect.';
+  }
+
+  async function connect(userInitiated: boolean): Promise<void> {
+    if (!ready || busy || !canConnect(state, userInitiated)) return;
+    busy = true;
+    button.disabled = true;
+    input.disabled = true;
+    error.hidden = true;
+    feedback.textContent = 'Connecting…';
+    try {
+      await fetchDeviceStatus(input.value, space);
+      feedback.textContent = state === 'denied' ? 'Access is blocked. Update your browser permissions to connect.' : 'Connected. The service responded successfully.';
+    } catch (cause: unknown) {
+      feedback.textContent = 'Could not connect.';
+      const detail = cause instanceof Error ? cause.message : 'The connection failed.';
+      error.textContent = `${detail} ${space === 'local' ? 'Check that the device is powered on and connected to the same network.' : 'Check that the companion app is running on this computer.'} Verify the URL and browser permissions. The service must allow this site’s origin using standard CORS (Access-Control-Allow-Origin).`;
+      error.hidden = false;
+      remediation.hidden = false;
+    } finally {
+      busy = false;
+      input.disabled = false;
+      button.disabled = state === 'denied';
+    }
+  }
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    void connect(true);
+  });
+
+  if (!window.isSecureContext || window.location.protocol !== 'https:') {
+    required<HTMLElement>(document, '#secure-context-error').hidden = false;
+    badge.textContent = 'HTTPS required';
+    input.disabled = true;
+    return;
+  }
+  const initialState = await queryNetworkPermission(permission, updatePermission);
+  ready = true;
+  updatePermission(initialState);
+  await connect(false);
+}
+
+for (const form of document.querySelectorAll<HTMLFormElement>('[data-connection]')) {
+  const space = form.dataset.connection;
+  if (space === 'local' || space === 'loopback') {
+    void setupConnection(form, space).catch(() => {
+      const error = form.querySelector<HTMLElement>('[data-error]');
+      if (error) {
+        error.textContent = 'Could not initialize device access. Reload this page and check your browser’s Site settings.';
+        error.hidden = false;
+      }
+    });
+  }
+}
diff --git a/src/network.ts b/src/network.ts
new file mode 100644
index 0000000..3ead4af
--- /dev/null
+++ b/src/network.ts
@@ -0,0 +1,51 @@
+export type AddressSpace = 'local' | 'loopback';
+export type NetworkPermission = 'local-network' | 'loopback-network';
+
+// Experimental LNA fields are not yet included in TypeScript's DOM definitions.
+type NetworkRequestInit = RequestInit & { targetAddressSpace: AddressSpace };
+
+export async function queryNetworkPermission(
+  name: NetworkPermission,
+  onChange: (state: PermissionState) => void,
+): Promise<PermissionState> {
+  try {
+    if (!navigator.permissions?.query) return 'prompt';
+    const status = await navigator.permissions.query({ name: name as PermissionName });
+    status.addEventListener('change', () => onChange(status.state));
+    return status.state;
+  } catch {
+    // Unsupported granular permissions still require an explicit user gesture.
+    return 'prompt';
+  }
+}
+
+export function canConnect(state: PermissionState, userInitiated: boolean): boolean {
+  return state === 'granted' || (state === 'prompt' && userInitiated);
+}
+
+export async function fetchDeviceStatus(endpoint: string, space: AddressSpace): Promise<void> {
+  if (!window.isSecureContext || window.location.protocol !== 'https:') {
+    throw new Error('Open this page over HTTPS before connecting.');
+  }
+  const url = new URL(endpoint);
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
+    throw new Error('Enter an HTTP or HTTPS device URL without embedded credentials.');
+  }
+  const controller = new AbortController();
+  const timeout = window.setTimeout(() => controller.abort(), 10000);
+  const options: NetworkRequestInit = {
+    method: 'GET',
+    mode: 'cors',
+    credentials: 'omit',
+    cache: 'no-store',
+    redirect: 'error',
+    targetAddressSpace: space,
+    signal: controller.signal,
+  };
+  try {
+    const response = await fetch(url.href, options);
+    if (!response.ok) throw new Error(`The service returned HTTP ${response.status}.`);
+  } finally {
+    window.clearTimeout(timeout);
+  }
+}
