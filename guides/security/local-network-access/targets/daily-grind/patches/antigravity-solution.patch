+      if (!window.isSecureContext) {
+        if (secureIndicator) {
+          secureIndicator.textContent = 'Insecure Context (HTTP) — Local Network Access Blocked';
+          secureIndicator.dataset.secureContext = 'false';
+        }
+        if (insecureWarning) {
+          insecureWarning.hidden = false;
+        }
+      }
+
+      const localBtn = document.getElementById('connect-local-brewer-btn');
+      if (localBtn) {
+        localBtn.addEventListener('click', () => {
+          connectLocalBrewer();
+        });
+      }
+
+      const wsBtn = document.getElementById('stream-local-brewer-btn');
+      if (wsBtn) {
+        wsBtn.addEventListener('click', () => {
+          startBrewerTelemetryStream();
+        });
+      }
+
+      const loopbackBtn = document.getElementById('connect-loopback-utility-btn');
+      if (loopbackBtn) {
+        loopbackBtn.addEventListener('click', () => {
+          connectLoopbackUtility();
+        });
+      }
+
+      // Pre-check granular permissions on load.
+      // Only auto-connect when permission is already 'granted'; never fire requests on 'prompt' or 'denied'.
+      const localState = await checkNetworkPermission('local-network');
+      if (localState === 'granted') {
+        await connectLocalBrewer();
+      }
+
+      const loopbackState = await checkNetworkPermission('loopback-network');
+      if (loopbackState === 'granted') {
+        await connectLoopbackUtility();
+      }
+    }
+
+    Object.assign(window, {
+      queryLnaPermissionSafe,
+      checkNetworkPermission,
+      updatePermissionUI,
+      fetchLocalDeviceStatus,
+      fetchLoopbackDaemon,
+      openLocalWebSocket,
+      openLocalWebTransport,
+      connectLocalBrewer,
+      connectLoopbackUtility,
+      startBrewerTelemetryStream,
+    });
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initEquipmentConnections);
+    } else {
+      initEquipmentConnections();
+    }
+  </script>
 </body>
 
