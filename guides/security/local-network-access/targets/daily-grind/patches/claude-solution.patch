+  <script>
+    (function () {
+      'use strict';
+
+      /**
+       * Cross-browser permission check for the granular Local Network Access permissions.
+       * Never queries the legacy combined 'local-network-access' name, which can crash
+       * older Chrome renderers; unsupported/unrecognized names are treated as 'prompt'
+       * so the connect button still works and the request itself triggers the browser prompt.
+       * @param {'local-network' | 'loopback-network'} permissionName
+       */
+      async function queryLnaPermissionSafe(permissionName) {
+        if (!navigator.permissions || !navigator.permissions.query) {
+          return 'prompt';
+        }
+        try {
+          const status = await navigator.permissions.query({ name: permissionName });
+          status.addEventListener('change', () => updatePermissionUI(permissionName, status.state));
+          updatePermissionUI(permissionName, status.state);
+          return status.state;
+        } catch (err) {
+          updatePermissionUI(permissionName, 'prompt');
+          return 'prompt';
+        }
+      }
+
+      function updatePermissionUI(permissionName, state) {
+        const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+        const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+        if (statusBadge) {
+          statusBadge.textContent = state;
+        }
+        if (remediationBox) {
+          remediationBox.hidden = state !== 'denied';
+        }
+      }
+
+      function showDeviceResult(elementId, message, isError) {
+        const el = document.getElementById(elementId);
+        if (!el) return;
+        el.textContent = message;
+        el.style.color = isError ? '#b3261e' : 'var(--primary)';
+      }
+
+      /**
+       * Connects to the user's LAN-attached smart brewer.
+       * Example endpoint is illustrative; replace with the paired device's address.
+       */
+      async function connectLocalBrewer() {
+        try {
+          const request = new Request('http://192.168.1.50:8080/api/brew-status', {
+            method: 'GET',
+            mode: 'cors',
+            // Declares the 'local' address space so the browser exempts this http://
+            // request from Mixed Content blocking and gates it on 'local-network' permission.
+            targetAddressSpace: 'local',
+          });
+          const response = await fetch(request);
+          if (!response.ok) {
+            throw new Error(`Brewer responded with HTTP ${response.status}`);
+          }
+          const data = await response.json();
+          showDeviceResult('local-device-result', `Connected — brewer status: ${data.status || 'ready'}`, false);
+        } catch (err) {
+          showDeviceResult(
+            'local-device-result',
+            `Could not reach your Wi-Fi brewer. Confirm it's powered on, on the same network, and that Local network access is allowed for this site in browser settings. (${err.message})`,
+            true
+          );
+        }
+      }
+
+      /**
+       * Connects to the Barista Console companion app on the user's loopback interface.
+       * Example endpoint is illustrative; replace with the companion app's port.
+       */
+      async function connectBaristaConsole() {
+        try {
+          const request = new Request('http://127.0.0.1:45990/api/queue', {
+            method: 'GET',
+            mode: 'cors',
+            // Declares the 'loopback' address space for the same reasons as 'local' above.
+            targetAddressSpace: 'loopback',
+          });
+          const response = await fetch(request);
+          if (!response.ok) {
+            throw new Error(`Console responded with HTTP ${response.status}`);
+          }
+          const data = await response.json();
+          showDeviceResult('loopback-device-result', `Connected — ${data.queueLength ?? 0} orders in queue`, false);
+        } catch (err) {
+          showDeviceResult(
+            'loopback-device-result',
+            `Could not reach the Barista Console companion app. Confirm it's running on this computer and that Loopback access is allowed for this site in browser settings. (${err.message})`,
+            true
+          );
+        }
+      }
+
+      async function init() {
+        const [localState, loopbackState] = await Promise.all([
+          queryLnaPermissionSafe('local-network'),
+          queryLnaPermissionSafe('loopback-network'),
+        ]);
+
+        // Only auto-connect when permission is already granted. When the state is
+        // 'prompt' or 'denied', wait for an explicit click on the connect buttons below.
+        if (localState === 'granted') {
+          connectLocalBrewer();
+        }
+        if (loopbackState === 'granted') {
+          connectBaristaConsole();
+        }
+
+        const localBtn = document.getElementById('connect-local-btn');
+        const loopbackBtn = document.getElementById('connect-loopback-btn');
+        if (localBtn) {
+          localBtn.addEventListener('click', connectLocalBrewer);
+        }
+        if (loopbackBtn) {
+          loopbackBtn.addEventListener('click', connectBaristaConsole);
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
+
