+  <script>
+    (function () {
+      'use strict';
+
+      var BREWER_URL = 'http://192.168.1.100:8080/api/status';
+      var COMPANION_URL = 'http://127.0.0.1:45678/health';
+
+      /**
+       * Queries the granular LNA permission with a try/catch fallback.
+       * Never queries 'local-network-access' — that name crashes older Chrome renderers.
+       * @param {'local-network'|'loopback-network'} permissionName
+       * @returns {Promise<'granted'|'prompt'|'denied'>}
+       */
+      async function queryLnaPermissionSafe(permissionName) {
+        if (!navigator.permissions || !navigator.permissions.query) {
+          return 'prompt';
+        }
+        try {
+          var status = await navigator.permissions.query({ name: permissionName });
+          return status.state;
+        } catch (_) {
+          // Unrecognized permission name in this browser — proceed on user gesture.
+          return 'prompt';
+        }
+      }
+
+      /**
+       * Updates the badge and remediation box for the given permission, and hides
+       * the connect button when access is explicitly denied.
+       * @param {'local-network'|'loopback-network'} permissionName
+       * @param {string} state
+       */
+      function updatePermissionUI(permissionName, state) {
+        var badge = document.querySelector('[data-permission-status="' + permissionName + '"]');
+        var remediation = document.querySelector('[data-remediation="' + permissionName + '"]');
+        var btnId = permissionName === 'local-network' ? 'connect-brewer' : 'connect-companion';
+        var btn = document.getElementById(btnId);
+
+        if (badge) {
+          badge.textContent = state;
+          badge.className = 'perm-badge perm-' + state;
+        }
+        if (remediation) {
+          remediation.hidden = state !== 'denied';
+        }
+        if (btn) {
+          btn.hidden = state === 'denied';
+        }
+      }
+
+      /**
+       * Queries a permission, wires up a 'change' listener to keep the UI in
+       * sync when the user adjusts settings, and returns the current state.
+       * @param {'local-network'|'loopback-network'} permissionName
+       * @returns {Promise<string>}
+       */
+      async function checkNetworkPermission(permissionName) {
+        var state = await queryLnaPermissionSafe(permissionName);
+
+        // Attach a live listener only when the Permissions API is fully supported.
+        if (navigator.permissions && navigator.permissions.query) {
+          try {
+            var status = await navigator.permissions.query({ name: permissionName });
+            status.addEventListener('change', function () {
+              updatePermissionUI(permissionName, status.state);
+              if (status.state === 'granted') {
+                if (permissionName === 'local-network') connectBrewer();
+                else connectCompanion();
+              }
+            });
+          } catch (_) { /* unrecognized name — no live listener */ }
+        }
+
+        updatePermissionUI(permissionName, state);
+        return state;
+      }
+
+      /**
+       * Renders a result or error into the named status box.
+       * @param {string} elementId
+       * @param {string} message
+       * @param {boolean} [isError]
+       */
+      function setStatus(elementId, message, isError) {
+        var el = document.getElementById(elementId);
+        if (!el) return;
+        el.textContent = message;
+        el.hidden = false;
+        el.className = 'status-box ' + (isError ? 'status-error' : 'status-ok');
+      }
+
+      /** Fetches status from the local-network Wi-Fi coffee brewer. */
+      async function connectBrewer() {
+        setStatus('brewer-status', 'Connecting to Wi-Fi Coffee Brewer…', false);
+        try {
+          var req = new Request(BREWER_URL, {
+            method: 'GET',
+            mode: 'cors',
+            // MANDATORY: exempts the http:// URL from Mixed Content blocking and
+            // verifies the resolved IP is in the local address space.
+            targetAddressSpace: 'local',
+          });
+          var response = await fetch(req);
+          if (!response.ok) {
+            throw new Error('Brewer responded with HTTP ' + response.status);
+          }
+          var data = await response.json();
+          setStatus('brewer-status', 'Connected. Status: ' + JSON.stringify(data), false);
+        } catch (err) {
+          setStatus(
+            'brewer-status',
+            'Connection failed: ' + err.message +
+            '. Ensure the brewer is powered on, connected to the same network, and that Local network access is allowed in browser Site Settings.',
+            true
+          );
+        }
+      }
+
+      /** Fetches health from the loopback brewing companion utility. */
+      async function connectCompanion() {
+        setStatus('companion-status', 'Connecting to Brewing Companion Utility…', false);
+        try {
+          var req = new Request(COMPANION_URL, {
+            method: 'GET',
+            mode: 'cors',
+            // MANDATORY: exempts the http:// URL from Mixed Content blocking and
+            // verifies the resolved IP is in the loopback address space.
+            targetAddressSpace: 'loopback',
+          });
+          var response = await fetch(req);
+          if (!response.ok) {
+            throw new Error('Companion app responded with HTTP ' + response.status);
+          }
+          var data = await response.json();
+          setStatus('companion-status', 'Connected. Status: ' + JSON.stringify(data), false);
+        } catch (err) {
+          setStatus(
+            'companion-status',
+            'Connection failed: ' + err.message +
+            '. Ensure the brewing companion utility is running on this device and that Loopback network access is allowed in browser Site Settings.',
+            true
+          );
+        }
+      }
+
+      async function init() {
+        var results = await Promise.all([
+          checkNetworkPermission('local-network'),
+          checkNetworkPermission('loopback-network'),
+        ]);
+        var brewState = results[0];
+        var companionState = results[1];
+
+        // Auto-connect when permission was already granted before the page loaded.
+        if (brewState === 'granted') connectBrewer();
+        if (companionState === 'granted') connectCompanion();
+
+        // Buttons trigger the first permission-gating request via an explicit user gesture.
+        var brewerBtn = document.getElementById('connect-brewer');
+        if (brewerBtn) brewerBtn.addEventListener('click', connectBrewer);
+
+        var companionBtn = document.getElementById('connect-companion');
+        if (companionBtn) companionBtn.addEventListener('click', connectCompanion);
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
