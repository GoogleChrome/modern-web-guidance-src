@@ -0,0 +1,41 @@
+import DOMPurify from 'dompurify';
+
+// Treat card markup as untrusted, including any future CMS-provided content.
+const cards = [
+  `<div class="card">
+    <h3>Maple Oat Latte</h3>
+    <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+    <a href="/menu/seasonal" class="btn">View Details</a>
+  </div>`,
+  `<div class="card">
+    <h3>Dark Roast Espresso</h3>
+    <p>Bold, smokey, and perfect for a morning boost.</p>
+    <a href="/menu/espresso" class="btn">View Details</a>
+  </div>`,
+  `<div class="card">
+    <h3>Cold Brew</h3>
+    <p>Steeped for 18 hours for maximum smoothness.</p>
+    <a href="/menu/cold-brew" class="btn">View Details</a>
+  </div>`,
+];
+
+const rules = {
+  createHTML: (input) => DOMPurify.sanitize(input, {
+    ALLOWED_TAGS: ['div', 'h3', 'p', 'a'],
+    ALLOWED_ATTR: ['class', 'href'],
+    ALLOW_DATA_ATTR: false,
+    ALLOW_ARIA_ATTR: false,
+    // The browser policy wraps the sanitized string in TrustedHTML.
+    RETURN_TRUSTED_TYPE: false,
+  }),
+};
+
+// Keep sanitization active even where the browser cannot enforce Trusted Types.
+const policy = window.trustedTypes
+  ? window.trustedTypes.createPolicy('seasonal-favorites', rules)
+  : rules;
+
+const container = document.getElementById('seasonal-favorites');
+if (container) {
+  container.innerHTML = policy.createHTML(cards.join(''));
+}
