diff --git a/src/seasonal-favorites.ts b/src/seasonal-favorites.ts
new file mode 100644
index 0000000..b206152
--- /dev/null
+++ b/src/seasonal-favorites.ts
@@ -0,0 +1,42 @@
+import DOMPurify from 'dompurify';
+
+// Restrict card markup as well as applying DOMPurify's URL and XSS protections.
+const sanitizeHTML = (input: string): string => DOMPurify.sanitize(input, {
+  ALLOWED_TAGS: ['div', 'h3', 'p', 'a'],
+  ALLOWED_ATTR: ['class', 'href'],
+  ALLOW_DATA_ATTR: false,
+  ALLOW_ARIA_ATTR: false,
+  RETURN_TRUSTED_TYPE: false,
+});
+
+// The fallback still sanitizes; unsupported browsers simply cannot enforce CSP's
+// Trusted Types directives. Do not install a permissive default policy.
+const policy = window.trustedTypes?.createPolicy('seasonal-favorites', {
+  createHTML: sanitizeHTML,
+}) ?? { createHTML: sanitizeHTML };
+
+const cards: readonly string[] = [
+  `<div class="card">
+    <h3>Maple Oat Latte</h3>
+    <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+    <a href="/menu/seasonal" class="btn">View Details</a>
+  </div>`,
+  `<div class="card">
+    <h3>Dark Roast Espresso</h3>
+    <p>Bold, smokey, and perfect for a morning boost.</p>
+    <a href="/menu/espresso" class="btn">View Details</a>
+  </div>`,
+  `<div class="card">
+    <h3>Cold Brew</h3>
+    <p>Steeped for 18 hours for maximum smoothness.</p>
+    <a href="/menu/cold-brew" class="btn">View Details</a>
+  </div>`,
+];
+
+const grid = document.querySelector<HTMLDivElement>('#seasonal-favorites');
+if (grid) {
+  // lib.dom models innerHTML as string only; browsers with Trusted Types also
+  // accept TrustedHTML. Keep the native value intact at the insertion sink.
+  const sink: { innerHTML: string | TrustedHTML } = grid;
+  sink.innerHTML = policy.createHTML(cards.join(''));
+}
