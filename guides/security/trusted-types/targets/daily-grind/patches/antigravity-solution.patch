+  <script>
+    if (!window.trustedTypes) {
+      window.trustedTypes = {
+        createPolicy: (name, rules) => rules,
+      };
+    }
+
+    const myPolicy = trustedTypes.createPolicy('sanitize-html', {
+      createHTML: (input) => {
+        if (typeof DOMPurify !== 'undefined' && typeof DOMPurify.sanitize === 'function') {
+          return DOMPurify.sanitize(String(input), { RETURN_TRUSTED_TYPE: false });
+        }
+        return String(input)
+          .replace(/<(script|iframe|object|embed|applet|style|svg|math|form|base|meta|link)\b[^>]*>[\s\S]*?<\/\1\s*>/gi, '')
+          .replace(/<\/?(script|iframe|object|embed|applet|style|svg|math|form|base|meta|link)\b[^>]*\/?>/gi, '')
+          .replace(/\s+on[a-z]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s"'=<>`]+)/gi, '')
+          .replace(/\s+srcdoc\s*=\s*(?:"[^"]*"|'[^']*'|[^\s"'=<>`]+)/gi, '')
+          .replace(
+            /\s+(href|src|xlink:href|action|formaction)\s*=\s*("([^"]*)"|'([^']*)'|([^\s"'=<>`]+))/gi,
+            (match, attr, fullVal, dqVal, sqVal, uqVal) => {
+              const rawVal = dqVal ?? sqVal ?? uqVal ?? '';
+              const decoded = rawVal
+                .replace(/&#x([0-9a-f]+);?/gi, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
+                .replace(/&#([0-9]+);?/g, (_, dec) => String.fromCharCode(parseInt(dec, 10)))
+                .replace(/[\s\u0000-\u001f]+/g, '')
+                .toLowerCase();
+              if (
+                decoded.startsWith('javascript:') ||
+                decoded.startsWith('vbscript:') ||
+                decoded.startsWith('data:')
+              ) {
+                return '';
+              }
+              return match;
+            }
+          );
+      },
+    });
+
+    const seasonalFavorites = [
+      `<div class="card">
+        <h3>Maple Oat Latte</h3>
+        <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+        <a href="/menu/seasonal" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Dark Roast Espresso</h3>
+        <p>Bold, smokey, and perfect for a morning boost.</p>
+        <a href="/menu/espresso" class="btn">View Details</a>
+      </div>`,
+      `<div class="card">
+        <h3>Cold Brew</h3>
+        <p>Steeped for 18 hours for maximum smoothness.</p>
+        <a href="/menu/cold-brew" class="btn">View Details</a>
+      </div>`,
+    ];
+
+    const grid = document.querySelector('.grid');
+    if (grid) {
+      const cleanHTML = myPolicy.createHTML(seasonalFavorites.join('\n'));
+      grid.innerHTML = cleanHTML;
+    }
+  </script>
+
 </body>
 
