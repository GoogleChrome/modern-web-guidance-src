   <title>The Daily Grind | Artisanal Coffee</title>
   <style>
     :root {
@@ -204,9 +205,51 @@
       <a href="/contact">Contact Us</a> |
       <a href="/privacy-policy">Privacy</a>
     </div>
+    <p id="special-note"></p>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Tinyfill fallback for browsers without Trusted Types support.
+    if (!window.trustedTypes) {
+      window.trustedTypes = {
+        createPolicy: (name, rules) => rules,
+      };
+    } else if (typeof window.trustedTypes.createPolicy !== 'function') {
+      window.trustedTypes.createPolicy = (name, rules) => rules;
+    }
+
+    function sanitizeHTML(input) {
+      let html = String(input);
+      // Strip executable script and embedding tags
+      html = html.replace(/<(script|iframe|style|object|embed|svg|base)\b[^>]*>[\s\S]*?<\/\1>/gi, '');
+      html = html.replace(/<(script|iframe|style|object|embed|svg|base)\b[^>]*\/?>/gi, '');
+      // Strip inline event handler attributes (e.g. onerror, onclick)
+      html = html.replace(/\s+on[a-z0-9_-]+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '');
+      // Neutralize javascript: and dangerous data: URLs
+      html = html.replace(/\b(href|src)\s*=\s*(?:"javascript:[^"]*"|'javascript:[^']*'|javascript:[^\s>]+)/gi, '$1="#"');
+      html = html.replace(/\b(href|src)\s*=\s*(?:"data:text\/html[^"]*"|'data:text\/html[^']*'|data:text\/html[^\s>]+)/gi, '$1="#"');
+      return html;
+    }
+
+    // createPolicy() wraps the returned string in a TrustedHTML object.
+    const sanitizePolicy = window.trustedTypes.createPolicy('sanitize-html', {
+      createHTML: (input) => sanitizeHTML(input),
+    });
+
+    window.sanitizePolicy = sanitizePolicy;
+
+    // Untrusted content goes through the policy before reaching the sink.
+    const searchParams = new URLSearchParams(window.location.search);
+    const untrustedInput = searchParams.get('note') ||
+      searchParams.get('name') ||
+      '<strong>Today\'s special:</strong> Maple Oat Latte <img src="x" onerror="alert(1)"><script>alert(2)<\/script>';
+    const noteEl = document.getElementById('special-note');
+    if (noteEl) {
+      noteEl.innerHTML = sanitizePolicy.createHTML(untrustedInput);
+    }
+  </script>
+
 </body>
 
