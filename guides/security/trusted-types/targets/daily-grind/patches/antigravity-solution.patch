+  <script type="module">
+    import DOMPurify from 'dompurify';
+
+    if (!window.trustedTypes) {
+      window.trustedTypes = {
+        createPolicy: (name, rules) => rules,
+      };
+    }
+
+    const myPolicy = trustedTypes.createPolicy('sanitize-html', {
+      createHTML: (input) =>
+        DOMPurify.sanitize(input, { RETURN_TRUSTED_TYPE: false }),
+    });
+
+    const escapePolicy = trustedTypes.createPolicy('escape-html', {
+      createHTML: (input) =>
+        String(input)
+          .replaceAll('&', '&amp;')
+          .replaceAll('<', '&lt;')
+          .replaceAll('>', '&gt;')
+          .replaceAll('"', '&quot;')
+          .replaceAll("'", '&#39;'),
+    });
+
+    const seasonalCards = [
+      `
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+      `,
+      `
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+      `,
+      `
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      `,
+    ];
+
+    const grid = document.querySelector('.grid');
+    if (grid) {
+      const cleanHTML = myPolicy.createHTML(seasonalCards.join(''));
+      grid.innerHTML = cleanHTML;
+    }
+  </script>
+
 </body>
 
