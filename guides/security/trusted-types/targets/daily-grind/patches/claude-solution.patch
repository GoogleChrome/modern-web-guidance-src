+  <script>
+    (function () {
+      // Tinyfill: provide a mock API for browsers without native Trusted Types support.
+      if (!window.trustedTypes) {
+        window.trustedTypes = {
+          createPolicy: function (name, rules) {
+            return rules;
+          },
+        };
+      }
+
+      var myPolicy = window.trustedTypes.createPolicy('my-no-pretzel-policy', {
+        createHTML: function (input) {
+          return input.replace(/pretzel/gi, 'popcorn');
+        },
+      });
+
+      var inputField = document.getElementById('input-field');
+      var outputEl = document.getElementById('output');
+      var errorLog = document.getElementById('error-log');
+      var btnUnsafe = document.getElementById('btn-unsafe');
+      var btnSafe = document.getElementById('btn-safe');
+
+      btnUnsafe.addEventListener('click', function () {
+        try {
+          // Assigns a raw string directly to innerHTML. Under an enforced
+          // Trusted Types CSP, this throws a TypeError instead of executing.
+          outputEl.innerHTML = inputField.value;
+          errorLog.style.display = 'none';
+        } catch (error) {
+          errorLog.textContent = error.toString();
+          errorLog.style.display = 'block';
+        }
+      });
+
+      btnSafe.addEventListener('click', function () {
+        try {
+          var trustedHTML = myPolicy.createHTML(inputField.value);
+          outputEl.innerHTML = trustedHTML;
+          errorLog.style.display = 'none';
+        } catch (error) {
+          errorLog.textContent = error.toString();
+          errorLog.style.display = 'block';
+        }
+      });
+    })();
+  </script>
+
