     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Tinyfill for browsers without Trusted Types support.
+    if (!window.trustedTypes) {
+      window.trustedTypes = {
+        createPolicy: (name, rules) => rules,
+      };
+    }
+
+    const ALLOWED_TAGS = new Set(['P', 'STRONG', 'EM', 'B', 'I', 'BR', 'SPAN', 'A', 'UL', 'OL', 'LI']);
+    const ALLOWED_ATTRS = new Set(['href', 'title']);
+
+    function sanitizeHTML(input) {
+      const doc = new DOMParser().parseFromString(String(input), 'text/html');
+      const walk = (parent) => {
+        for (const el of Array.from(parent.children)) {
+          if (!ALLOWED_TAGS.has(el.tagName)) {
+            el.remove();
+            continue;
+          }
+          for (const attr of Array.from(el.attributes)) {
+            const name = attr.name.toLowerCase();
+            const unsafeHref = name === 'href' && !/^(https?:|mailto:|\/|#)/i.test(attr.value.trim());
+            if (!ALLOWED_ATTRS.has(name) || name.startsWith('on') || unsafeHref) {
+              el.removeAttribute(attr.name);
+            }
+          }
+          walk(el);
+        }
+      };
+      walk(doc.body);
+      return doc.body.innerHTML;
+    }
+
+    // createPolicy() wraps the returned string in a TrustedHTML object.
+    const sanitizePolicy = window.trustedTypes.createPolicy('sanitize-html', {
+      createHTML: (input) => sanitizeHTML(input),
+    });
+
+    // Untrusted content (e.g. from user input) goes through the policy before reaching the sink.
+    const untrustedInput = '<strong>Today\'s special:</strong> Maple Oat Latte <img src="x" onerror="alert(1)"><script>alert(2)<\/script>';
+    document.getElementById('special-note').innerHTML = sanitizePolicy.createHTML(untrustedInput);
+  </script>
+
