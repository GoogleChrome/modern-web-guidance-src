+// Tinyfill for browsers without Trusted Types: same policy code runs, no enforcement.
+if (!window.trustedTypes) {
+  window.trustedTypes = {
+    createPolicy: (name, rules) => rules,
+  };
+}
+
+const ALLOWED_TAGS = new Set(['DIV', 'H3', 'P', 'A', 'STRONG', 'EM', 'SPAN', 'BR']);
+const ALLOWED_ATTRS = {
+  '*': new Set(['class']),
+  A: new Set(['href']),
+};
+const SAFE_URL = /^(?:https?:|mailto:|\/(?!\/)|#|[^:]*$)/i;
+
+// Allowlist sanitizer working on an inert document (scripts never run, images never load).
+function sanitizeNode(node) {
+  for (const child of Array.from(node.childNodes)) {
+    if (child.nodeType === Node.TEXT_NODE) continue;
+    if (child.nodeType !== Node.ELEMENT_NODE || !ALLOWED_TAGS.has(child.tagName)) {
+      child.remove();
+      continue;
+    }
+    for (const attr of Array.from(child.attributes)) {
+      const allowed =
+        ALLOWED_ATTRS['*'].has(attr.name) || ALLOWED_ATTRS[child.tagName]?.has(attr.name);
+      if (!allowed || (attr.name === 'href' && !SAFE_URL.test(attr.value.trim()))) {
+        child.removeAttribute(attr.name);
+      }
+    }
+    sanitizeNode(child);
+  }
+}
+
+const sanitizePolicy = trustedTypes.createPolicy('sanitize-html', {
+  createHTML: (input) => {
+    const doc = new DOMParser().parseFromString(`<body>${String(input)}</body>`, 'text/html');
+    sanitizeNode(doc.body);
+    return doc.body.innerHTML;
+  },
+});
+
+const seasonalFavoritesHTML = [
+  `<div class="card">
+    <h3>Maple Oat Latte</h3>
+    <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+    <a href="/menu/seasonal" class="btn">View Details</a>
+  </div>`,
+  `<div class="card">
+    <h3>Dark Roast Espresso</h3>
+    <p>Bold, smokey, and perfect for a morning boost.</p>
+    <a href="/menu/espresso" class="btn">View Details</a>
+  </div>`,
+  `<div class="card">
+    <h3>Cold Brew</h3>
+    <p>Steeped for 18 hours for maximum smoothness.</p>
+    <a href="/menu/cold-brew" class="btn">View Details</a>
+  </div>`,
+];
+
+const grid = document.getElementById('seasonal-grid');
+if (grid) {
+  grid.innerHTML = sanitizePolicy.createHTML(seasonalFavoritesHTML.join('\n'));
+}
