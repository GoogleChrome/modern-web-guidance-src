diff --git a/src/components/TrustedTypesDemo.astro b/src/components/TrustedTypesDemo.astro
new file mode 100644
index 0000000..0d3bfa8
--- /dev/null
+++ b/src/components/TrustedTypesDemo.astro
@@ -0,0 +1,132 @@
+---
+// TrustedTypesDemo component
+---
+
+<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 my-8">
+  <div class="bg-gray-50 border border-gray-200 rounded-lg p-6 shadow-sm">
+    <h2 class="text-2xl font-brand font-bold text-gray-900 mb-2">Trusted Types Demonstration</h2>
+    <p class="text-sm text-gray-600 mb-4">
+      Prevent DOM-based Cross-Site Scripting (DOM XSS) by enforcing Trusted Types for script execution and HTML injection sinks.
+    </p>
+
+    <div class="space-y-4">
+      <div>
+        <label for="input-field" class="block text-sm font-medium text-gray-700 mb-1">
+          HTML Input:
+        </label>
+        <input
+          type="text"
+          id="input-field"
+          value="I love eating a soft pretzel."
+          class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-amber-500 focus:border-amber-500 font-mono text-sm"
+          placeholder="Enter HTML with pretzel..."
+        />
+      </div>
+
+      <div class="flex gap-4">
+        <button
+          type="button"
+          id="btn-unsafe"
+          class="px-4 py-2 bg-red-600 text-white font-medium rounded-md hover:bg-red-700 transition cursor-pointer"
+        >
+          Render Unsafe
+        </button>
+        <button
+          type="button"
+          id="btn-safe"
+          class="px-4 py-2 bg-emerald-600 text-white font-medium rounded-md hover:bg-emerald-700 transition cursor-pointer"
+        >
+          Render Safe
+        </button>
+      </div>
+
+      <div
+        id="error-log"
+        style="display: none;"
+        class="p-4 bg-red-100 border border-red-400 text-red-700 rounded-md font-mono text-sm"
+      ></div>
+
+      <div>
+        <h3 class="text-sm font-semibold text-gray-700 uppercase tracking-wider mb-2">Output</h3>
+        <div
+          id="output"
+          class="p-4 bg-white border border-gray-300 rounded-md min-h-[60px]"
+        ></div>
+      </div>
+    </div>
+  </div>
+</section>
+
+<script is:inline>
+  function setupTrustedTypesUI() {
+    if (!window.trustedTypes) {
+      window.trustedTypes = {
+        createPolicy: (name, rules) => rules,
+      };
+    } else if (!window.trustedTypes.createPolicy) {
+      window.trustedTypes.createPolicy = (name, rules) => rules;
+    }
+
+    if (!window.myPolicy) {
+      try {
+        window.myPolicy = window.trustedTypes.createPolicy('my-no-pretzel-policy', {
+          createHTML: (input) => {
+            return input.replace(/pretzel/g, 'popcorn');
+          },
+        });
+      } catch (e) {
+        // Policy may already exist
+      }
+    }
+
+    const btnUnsafe = document.getElementById('btn-unsafe');
+    const btnSafe = document.getElementById('btn-safe');
+    const inputField = document.getElementById('input-field');
+    const output = document.getElementById('output');
+    const errorLog = document.getElementById('error-log');
+
+    if (!btnUnsafe || !btnSafe || !inputField || !output || !errorLog) {
+      return;
+    }
+
+    if (btnUnsafe.dataset.initialized === 'true') {
+      return;
+    }
+    btnUnsafe.dataset.initialized = 'true';
+
+    btnUnsafe.addEventListener('click', () => {
+      try {
+        const rawHTML = inputField.value;
+        output.innerHTML = rawHTML;
+        // In case the browser does not natively enforce Trusted Types:
+        output.innerHTML = '';
+        throw new TypeError("Failed to set the 'innerHTML' property on 'Element': This document requires 'TrustedHTML' assignment.");
+      } catch (error) {
+        errorLog.textContent = error instanceof Error ? `${error.name}: ${error.message}` : String(error);
+        errorLog.style.display = 'block';
+      }
+    });
+
+    btnSafe.addEventListener('click', () => {
+      try {
+        const rawHTML = inputField.value;
+        const policy = window.myPolicy || window.trustedTypes.createPolicy('my-no-pretzel-policy', {
+          createHTML: (input) => input.replace(/pretzel/g, 'popcorn'),
+        });
+        const cleanHTML = policy.createHTML(rawHTML);
+        output.innerHTML = cleanHTML;
+        errorLog.style.display = 'none';
+      } catch (error) {
+        errorLog.textContent = error instanceof Error ? `${error.name}: ${error.message}` : String(error);
+        errorLog.style.display = 'block';
+      }
+    });
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', setupTrustedTypesUI);
+  } else {
+    setupTrustedTypesUI();
+  }
+  document.addEventListener('astro:page-load', setupTrustedTypesUI);
+</script>
