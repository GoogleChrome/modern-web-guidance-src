diff --git a/src/components/TrustedTypesDemo.astro b/src/components/TrustedTypesDemo.astro
new file mode 100644
index 0000000..1b8025d
--- /dev/null
+++ b/src/components/TrustedTypesDemo.astro
@@ -0,0 +1,58 @@
+<section class="border-b border-gray-300 p-4 md:p-6" aria-labelledby="trusted-types-title">
+  <h1 id="trusted-types-title" class="text-2xl font-bold mb-2">Trusted Types playground</h1>
+  <p class="mb-4">Try an unsafe HTML update, or use the policy to allow basic formatting and replace “pretzel” with “popcorn”. Attributes and other markup are displayed as text.</p>
+  <label for="input-field" class="block font-semibold mb-2">HTML content</label>
+  <textarea id="input-field" rows="3" class="block w-full border border-gray-400 rounded p-3 mb-3">{'<p>I love a soft <strong>pretzel</strong>.</p>'}</textarea>
+  <div class="flex flex-wrap gap-3 mb-4">
+    <button id="btn-unsafe" type="button" class="border border-gray-500 rounded px-4 py-2">Unsafe update</button>
+    <button id="btn-safe" type="button" class="bg-gray-900 text-white rounded px-4 py-2">Safe update</button>
+  </div>
+  <p id="fallback-notice" class="mb-3" hidden>This browser does not enforce Trusted Types. Safe updates still sanitize the HTML; unsafe updates are disabled.</p>
+  <p id="error-log" role="alert" class="text-red-700 mb-3" style="display: none"></p>
+  <h2 class="font-semibold mb-2">Output</h2>
+  <div id="output" aria-live="polite" class="border border-gray-300 rounded p-3 min-h-12"></div>
+</section>
+
+<script>
+  import { htmlPolicy, supportsTrustedTypes } from '../utils/trusted-types';
+
+  const input = document.querySelector<HTMLTextAreaElement>('#input-field');
+  const output = document.querySelector<HTMLDivElement>('#output');
+  const errorLog = document.querySelector<HTMLParagraphElement>('#error-log');
+  const unsafeButton = document.querySelector<HTMLButtonElement>('#btn-unsafe');
+  const safeButton = document.querySelector<HTMLButtonElement>('#btn-safe');
+  const fallbackNotice = document.querySelector<HTMLParagraphElement>('#fallback-notice');
+
+  if (input && output && errorLog && unsafeButton && safeButton) {
+    if (fallbackNotice) fallbackNotice.hidden = supportsTrustedTypes;
+    const showError = (error: unknown) => {
+      errorLog.textContent = error instanceof Error ? `${error.name}: ${error.message}` : String(error);
+      errorLog.style.display = 'block';
+    };
+
+    unsafeButton.addEventListener('click', () => {
+      try {
+        // Without native enforcement, never send untrusted input to an HTML sink.
+        if (!supportsTrustedTypes) {
+          throw new TypeError('Unsafe HTML updates require native Trusted Types enforcement.');
+        }
+        // Intentionally demonstrate the browser's rejection of a raw string.
+        output.innerHTML = input.value;
+      } catch (error) {
+        showError(error);
+      }
+    });
+
+    safeButton.addEventListener('click', () => {
+      try {
+        // lib.dom declares this sink as string-only. The assertion preserves the
+        // actual TrustedHTML object at runtime; it does not stringify it.
+        output.innerHTML = htmlPolicy.createHTML(input.value) as string;
+        errorLog.textContent = '';
+        errorLog.style.display = 'none';
+      } catch (error) {
+        showError(error);
+      }
+    });
+  }
+</script>
