diff --git a/src/utils/trusted-types.ts b/src/utils/trusted-types.ts
new file mode 100644
index 0000000..e238be9
--- /dev/null
+++ b/src/utils/trusted-types.ts
@@ -0,0 +1,46 @@
+interface HTMLPolicy {
+  createHTML(input: string): string | TrustedHTMLValue;
+}
+
+interface TrustedHTMLValue {
+  readonly __trustedHTML: unique symbol;
+}
+
+interface HTMLPolicyFactory {
+  createPolicy(name: string, rules: { createHTML(input: string): string }): HTMLPolicy;
+}
+
+declare global {
+  interface Window {
+    trustedTypes?: HTMLPolicyFactory;
+  }
+}
+
+export const supportsTrustedTypes = typeof window.trustedTypes?.createPolicy === 'function';
+
+if (!window.trustedTypes) {
+  // Tinyfill: still run the policy transformation in browsers without the API.
+  window.trustedTypes = {
+    createPolicy: (_name, rules) => ({ createHTML: (input) => rules.createHTML(input) }),
+  };
+}
+
+/**
+ * Escape everything first, then restore only exact, attribute-free formatting
+ * tags. No untrusted input is parsed in an HTML sink during sanitization.
+ * Scripts, event handlers, URLs, SVG, and malformed tags remain inert text.
+ */
+export function sanitizeHTML(input: string): string {
+  return input
+    .replace(/pretzel/g, 'popcorn')
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;')
+    .replace(/&lt;(\/?(?:p|b|strong|i|em|u|s|small|mark|sub|sup|code|pre|blockquote|ul|ol|li|h[1-6])|br\s*\/?)&gt;/gi, '<$1>');
+}
+
+export const htmlPolicy = window.trustedTypes.createPolicy('my-no-pretzel-policy', {
+  createHTML: sanitizeHTML,
+});
