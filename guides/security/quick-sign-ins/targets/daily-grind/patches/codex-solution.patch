index 0000000..cb6caad
--- /dev/null
+++ b/signin.ts
@@ -0,0 +1,257 @@
+import 'webauthn-polyfills';
+
+type RequestOptionsJSON = {
+  challenge: string;
+  rpId?: string;
+  timeout?: number;
+  userVerification?: UserVerificationRequirement;
+  allowCredentials?: { id: string; type: 'public-key'; transports?: AuthenticatorTransport[] }[];
+};
+
+type WebAuthnAPI = typeof PublicKeyCredential & {
+  getClientCapabilities?: () => Promise<Record<string, boolean>>;
+  parseRequestOptionsFromJSON: (options: RequestOptionsJSON) => PublicKeyCredentialRequestOptions;
+  signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+};
+
+type ImmediateRequest = CredentialRequestOptions & { password: true; uiMode: 'immediate' };
+type Assertion = PublicKeyCredential & { toJSON: () => { id: string } };
+type SavedPassword = Credential & { password: string };
+
+function element<T extends HTMLElement>(id: string, constructor: { new(): T }): T {
+  const node = document.getElementById(id);
+  if (!(node instanceof constructor)) throw new Error(`Missing element: ${id}`);
+  return node;
+}
+
+const dialog = element('signin-dialog', HTMLDialogElement);
+const form = element('signin-form', HTMLFormElement);
+const username = element('username', HTMLInputElement);
+const password = element('password', HTMLInputElement);
+const message = element('signin-message', HTMLParagraphElement);
+const status = element('auth-status', HTMLParagraphElement);
+const signInLink = element('signin-link', HTMLAnchorElement);
+const logoutLink = element('logout-link', HTMLAnchorElement);
+const passkeyButton = element('passkey-signin', HTMLButtonElement);
+const closeButton = element('close-signin', HTMLButtonElement);
+const webauthn = window.PublicKeyCredential as WebAuthnAPI | undefined;
+
+let signedIn = document.body.dataset.signedIn === 'true';
+let busy = false;
+let destination: string | null = null;
+let immediateSupported = false;
+let prepared: { publicKey: PublicKeyCredentialRequestOptions; expires: number } | null = null;
+let preparation: Promise<void> | null = null;
+
+function updateHeader(): void {
+  signInLink.hidden = signedIn;
+  logoutLink.hidden = !signedIn;
+  document.body.dataset.signedIn = String(signedIn);
+}
+
+async function post(path: string, body?: unknown): Promise<Response> {
+  const response = await fetch(path, {
+    method: 'POST',
+    credentials: 'same-origin',
+    cache: 'no-store',
+    headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  return response;
+}
+
+async function requestOptions(): Promise<PublicKeyCredentialRequestOptions> {
+  if (!webauthn) throw new Error('Passkeys are unavailable in this browser. Please use your password.');
+  const response = await post('/api/login/options');
+  if (!response.ok) throw new Error('Sign in is temporarily unavailable. Please try again.');
+  const json: RequestOptionsJSON = await response.json();
+  if (!json || typeof json.challenge !== 'string' || !json.challenge) {
+    throw new Error('Sign in is temporarily unavailable. Please try again.');
+  }
+  return webauthn.parseRequestOptionsFromJSON(json);
+}
+
+// Prepare data only. Credential requests must originate from a user action.
+function prepareImmediateSignIn(): Promise<void> {
+  if (preparation) return preparation;
+  const operation = (async () => {
+    try {
+      if (!window.isSecureContext || !navigator.credentials?.get || !webauthn?.getClientCapabilities) return;
+      const capabilities = await webauthn.getClientCapabilities();
+      immediateSupported = Boolean(capabilities?.immediateGet);
+      if (!immediateSupported || signedIn) return;
+      const publicKey = await requestOptions();
+      // Immediate requests must never restrict the credential IDs.
+      delete publicKey.allowCredentials;
+      prepared = { publicKey, expires: Date.now() + Math.min(publicKey.timeout ?? 60000, 60000) };
+    } catch {
+      // Unsupported clients and network failures retain the inline sign-in flow.
+      prepared = null;
+    }
+  })();
+  preparation = operation;
+  void operation.then(() => { if (preparation === operation) preparation = null; });
+  return operation;
+}
+
+async function verifyCredential(credential: Credential | null, publicKey: PublicKeyCredentialRequestOptions): Promise<void> {
+  if (!credential) throw new DOMException('No credential selected', 'NotAllowedError');
+  if (credential.type === 'public-key') {
+    const assertion = credential as Assertion;
+    const encoded = assertion.toJSON();
+    const response = await post('/api/login/verify', encoded);
+    if (response.status === 404) {
+      if (webauthn?.signalUnknownCredential) {
+        try {
+          await webauthn.signalUnknownCredential({
+            rpId: publicKey.rpId || window.location.hostname,
+            credentialId: encoded.id,
+          });
+        } catch {
+          // Password-manager synchronization must not block alternative sign in.
+        }
+      }
+      throw new Error('This passkey is no longer recognized. Use your password or another passkey.');
+    }
+    if (!response.ok) throw new Error('We could not verify this passkey. Please try another sign-in method.');
+    return;
+  }
+  if (credential.type === 'password' && 'password' in credential && typeof credential.password === 'string') {
+    await verifyPassword(credential.id, (credential as SavedPassword).password);
+    return;
+  }
+  throw new Error('Please sign in with your password or a passkey.');
+}
+
+async function verifyPassword(id: string, secret: string): Promise<void> {
+  const response = await post('/api/login/password', { username: id, password: secret });
+  if (!response.ok) {
+    throw new Error(response.status === 401
+      ? 'Your username or password was not recognized. Please try again.'
+      : 'Sign in is temporarily unavailable. Please try again.');
+  }
+}
+
+function setBusy(value: boolean): void {
+  busy = value;
+  form.querySelectorAll('input, button').forEach(node => {
+    if (node instanceof HTMLInputElement || node instanceof HTMLButtonElement) node.disabled = value;
+  });
+  passkeyButton.disabled = value;
+  closeButton.disabled = value;
+  form.setAttribute('aria-busy', String(value));
+  status.textContent = value ? 'Signing you in…' : '';
+}
+
+function showFallback(text = 'Sign in to continue where you left off.'): void {
+  message.textContent = text;
+  if (!dialog.open) dialog.showModal();
+}
+
+function completeSignIn(): void {
+  signedIn = true;
+  prepared = null;
+  password.value = '';
+  updateHeader();
+  dialog.close();
+  status.textContent = 'You are signed in.';
+  const next = destination;
+  destination = null;
+  if (next) window.location.assign(next);
+}
+
+function errorMessage(error: unknown): string {
+  if (error instanceof Error && error.name === 'NotAllowedError') {
+    return 'Sign in with your password, or choose a passkey from another device.';
+  }
+  if (error instanceof TypeError) return 'Unable to connect. Please try signing in again.';
+  return error instanceof Error ? error.message : 'Unable to sign in. Please try again.';
+}
+
+// This handler calls get() synchronously with the click, preserving activation.
+function quickSignIn(event: MouseEvent, link: HTMLAnchorElement): void {
+  if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+  if (signedIn && link !== signInLink) return;
+  event.preventDefault();
+  if (busy) return;
+  destination = link === signInLink ? null : link.href;
+  const options = prepared;
+  if (!immediateSupported || !options || options.expires <= Date.now()) {
+    showFallback();
+    return;
+  }
+  prepared = null;
+  setBusy(true);
+  const request: ImmediateRequest = {
+    password: true,
+    publicKey: options.publicKey,
+    uiMode: 'immediate',
+  };
+  // No AbortSignal and no allowCredentials list for immediate UI.
+  void (async () => {
+    try {
+      const credential = await navigator.credentials.get(request);
+      await verifyCredential(credential, options.publicKey);
+      setBusy(false);
+      completeSignIn();
+    } catch (error) {
+      setBusy(false);
+      showFallback(errorMessage(error));
+    }
+  })();
+}
+
+document.querySelectorAll<HTMLAnchorElement>('[data-quick-signin], #signin-link').forEach(link => {
+  link.addEventListener('click', event => quickSignIn(event, link));
+});
+
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  if (busy) return;
+  const id = username.value;
+  const secret = password.value;
+  setBusy(true);
+  void (async () => {
+    try {
+      await verifyPassword(id, secret);
+      setBusy(false);
+      completeSignIn();
+    } catch (error) {
+      setBusy(false);
+      message.textContent = errorMessage(error);
+      password.focus();
+    }
+  })();
+});
+
+passkeyButton.addEventListener('click', () => {
+  if (busy) return;
+  setBusy(true);
+  void (async () => {
+    try {
+      // Finish any preparation first so session challenges cannot overwrite each other.
+      await preparation;
+      prepared = null;
+      const publicKey = await requestOptions();
+      const credential = await navigator.credentials.get({ publicKey });
+      await verifyCredential(credential, publicKey);
+      setBusy(false);
+      completeSignIn();
+    } catch (error) {
+      setBusy(false);
+      message.textContent = errorMessage(error);
+    }
+  })();
+});
+
+closeButton.addEventListener('click', () => { if (!busy) dialog.close(); });
+dialog.addEventListener('cancel', event => { if (busy) event.preventDefault(); });
+dialog.addEventListener('close', () => {
+  password.value = '';
+  destination = null;
+  if (!signedIn) void prepareImmediateSignIn();
+});
+
+passkeyButton.hidden = !window.isSecureContext || !webauthn || !navigator.credentials?.get;
+updateHeader();
+void prepareImmediateSignIn();
