+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.mjs': 'application/javascript; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.ico': 'image/x-icon',
+};
+
+// In-memory session store and credential registry
+const sessions = new Map();
+const unknownCredentialIds = new Set(['unknown-credential', 'revoked-passkey-id']);
+
+function parseCookies(req) {
+  const header = req.headers.cookie;
+  const cookies = {};
+  if (!header) return cookies;
+  for (const part of header.split(';')) {
+    const [rawName, ...rest] = part.trim().split('=');
+    if (rawName) {
+      cookies[rawName] = decodeURIComponent(rest.join('='));
+    }
+  }
+  return cookies;
+}
+
+function getOrCreateSession(req, res) {
+  const cookies = parseCookies(req);
+  let sid = cookies.dg_sid;
+  if (!sid || !sessions.has(sid)) {
+    sid = crypto.randomBytes(24).toString('base64url');
+    sessions.set(sid, {
+      id: sid,
+      challenge: null,
+      expectedUserVerification: 'preferred',
+      user: null,
+      createdAt: Date.now(),
+    });
+    res.setHeader(
+      'Set-Cookie',
+      `dg_sid=${encodeURIComponent(sid)}; Path=/; HttpOnly; SameSite=Lax`
+    );
+  }
+  return sessions.get(sid);
+}
+
+function readJsonBody(req) {
+  return new Promise((resolve, reject) => {
+    let data = '';
+    req.on('data', (chunk) => {
+      data += chunk;
+      if (data.length > 1024 * 1024) {
+        reject(new Error('Payload too large'));
+      }
+    });
+    req.on('end', () => {
+      if (!data) {
+        resolve({});
+        return;
+      }
+      try {
+        resolve(JSON.parse(data));
+      } catch (err) {
+        reject(err);
+      }
+    });
+    req.on('error', reject);
+  });
+}
+
+function sendJson(res, statusCode, payload) {
+  const body = JSON.stringify(payload);
+  res.writeHead(statusCode, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Content-Length': Buffer.byteLength(body),
+  });
+  res.end(body);
+}
+
+const server = http.createServer(async (req, res) => {
+  const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+  const pathname = url.pathname;
+  const session = getOrCreateSession(req, res);
+
+  // 1. Server-side options generation endpoint (/api/login/options)
+  if (pathname === '/api/login/options' && (req.method === 'POST' || req.method === 'GET')) {
+    const challenge = crypto.randomBytes(32).toString('base64url');
+    const rpId = (req.headers.host || 'localhost').split(':')[0];
+
+    // Omit allowCredentials so Immediate UI mode is never rejected for non-empty allowlists
+    const options = {
+      challenge,
+      rpId,
+      userVerification: 'preferred',
+    };
+
+    session.challenge = options.challenge;
+    session.expectedUserVerification = 'preferred';
+    return sendJson(res, 200, options);
+  }
+
+  // 2. WebAuthn assertion verification endpoint (/api/login/verify)
+  if (pathname === '/api/login/verify' && req.method === 'POST') {
+    try {
+      const assertion = await readJsonBody(req);
+      const credId = assertion?.id || assertion?.rawId;
+
+      if (!credId) {
+        return sendJson(res, 400, { error: 'Missing credential assertion ID' });
+      }
+
+      // Return HTTP 404 for unknown/revoked credentials so client invokes signalUnknownCredential
+      if (unknownCredentialIds.has(credId)) {
+        return sendJson(res, 404, { error: 'Passkey credential not recognized' });
+      }
+
+      session.user = {
+        id: 'user-passkey-1',
+        username: 'alex@dailygrind.coffee',
+        displayName: 'Alex Rivera',
+        authMethod: 'passkey',
+        rewardsPoints: 340,
+      };
+      session.challenge = null;
+
+      return sendJson(res, 200, {
+        verified: true,
+        user: session.user,
+      });
+    } catch {
+      return sendJson(res, 400, { error: 'Invalid verification request body' });
+    }
+  }
+
+  // 3. Password verification endpoint (/api/login/password)
+  if (pathname === '/api/login/password' && req.method === 'POST') {
+    try {
+      const body = await readJsonBody(req);
+      const username = (body?.username || body?.id || '').trim();
+      const password = body?.password || '';
+
+      if (!username || !password) {
+        return sendJson(res, 401, { error: 'Username and password are required' });
+      }
+
+      const displayPart = username.split('@')[0] || 'Member';
+      const displayName =
+        displayPart.charAt(0).toUpperCase() + displayPart.slice(1);
+
+      session.user = {
+        id: `user-${Buffer.from(username).toString('base64url').slice(0, 8)}`,
+        username,
+        displayName,
+        authMethod: 'password',
+        rewardsPoints: 340,
+      };
+      session.challenge = null;
+
+      return sendJson(res, 200, {
+        verified: true,
+        user: session.user,
+      });
+    } catch {
+      return sendJson(res, 400, { error: 'Invalid password login payload' });
+    }
+  }
+
+  // 4. Session inspection endpoint (/api/session)
+  if (pathname === '/api/session' && req.method === 'GET') {
+    return sendJson(res, 200, {
+      signedIn: Boolean(session.user),
+      user: session.user,
+    });
+  }
+
+  // 5. Logout handler (/api/logout or /logout)
+  if (pathname === '/api/logout' || pathname === '/logout') {
+    session.user = null;
+    session.challenge = null;
+    if (req.method === 'POST' || pathname === '/api/logout') {
+      return sendJson(res, 200, { ok: true });
+    }
+    res.writeHead(302, { Location: '/' });
+    res.end();
+    return;
+  }
+
+  // 6. Serve static assets or fallback SPA index.html
+  const safePath = path.normalize(pathname).replace(/^(\.\.[/\\])+/, '');
+  let filePath = path.join(
+    __dirname,
+    safePath === '/' ? 'index.html' : safePath
+  );
