+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const rootDir = path.resolve(__dirname, '..');
+
+function buildWebAuthnPolyfillsBundle() {
+  const uaParserCode = fs.readFileSync(
+    path.join(rootDir, 'node_modules/ua-parser-js/src/ua-parser.js'),
+    'utf8'
+  );
+  const compareVersionsCode = fs.readFileSync(
+    path.join(rootDir, 'node_modules/compare-versions/lib/umd/index.js'),
+    'utf8'
+  );
+  const base64urlCode = fs.readFileSync(
+    path.join(rootDir, 'node_modules/webauthn-polyfills/esm/base64url.js'),
+    'utf8'
+  );
+  const jsonSerializationCode = fs
+    .readFileSync(
+      path.join(rootDir, 'node_modules/webauthn-polyfills/esm/json_serialization.js'),
+      'utf8'
+    )
+    .replace(/^import\s+.*?;?\s*$/gm, '');
+  const isVersionCode = fs
+    .readFileSync(
+      path.join(rootDir, 'node_modules/webauthn-polyfills/esm/is_version.js'),
+      'utf8'
+    )
+    .replace(/^import\s+.*?;?\s*$/gm, '');
+  const clientCapabilitiesCode = fs
+    .readFileSync(
+      path.join(rootDir, 'node_modules/webauthn-polyfills/esm/client_capabilities.js'),
+      'utf8'
+    )
+    .replace(/^import\s+.*?;?\s*$/gm, '');
+
+  const bundle = `// Generated ES module bundle of webauthn-polyfills
+const __uaModule = { exports: {} };
+(function(module, exports) {
+${uaParserCode}
+})(__uaModule, __uaModule.exports);
+const UAParser = __uaModule.exports.UAParser || __uaModule.exports || globalThis.UAParser;
+
+const __cvModule = { exports: {} };
+(function(module, exports) {
+${compareVersionsCode}
+})(__cvModule, __cvModule.exports);
+const { compare } = __cvModule.exports;
+
+${base64urlCode.replace(/^export\s+/gm, '')}
+
+${jsonSerializationCode.replace(/^export\s+/gm, '')}
+
+${isVersionCode.replace(/^export\s+/gm, '')}
+
+${clientCapabilitiesCode.replace(/^export\s+/gm, '')}
+
+export {
+  Base64URL,
+  parseCreationOptionsFromJSON,
+  parseRequestOptionsFromJSON,
+  toJSON,
+  prepareGetClientCapabilities,
+  applyPolyfill
+};
+`;
+
+  const vendorDir = path.join(rootDir, 'vendor');
+  fs.mkdirSync(vendorDir, { recursive: true });
+  fs.writeFileSync(path.join(vendorDir, 'webauthn-polyfills.mjs'), bundle, 'utf8');
+  console.log('Built vendor/webauthn-polyfills.mjs successfully.');
+}
+
+buildWebAuthnPolyfillsBundle();
