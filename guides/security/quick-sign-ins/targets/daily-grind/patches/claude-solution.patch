+import 'webauthn-polyfills';
+
+let isAuthenticating = false;
+let conditionalAbortController = null;
+let pendingAction = null;
+
+/**
+ * Feature-detect Immediate UI mode support using WebAuthn Client Capabilities.
+ * Returns true only when capabilities.immediateGet is explicitly supported.
+ */
+export async function isImmediateUiSupported() {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    typeof PublicKeyCredential.getClientCapabilities !== 'function'
+  ) {
+    return false;
+  }
+
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(capabilities?.immediateGet);
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Fetch discoverable WebAuthn request options from the server.
+ * Falls back to a locally generated ephemeral challenge if served from a pure static host.
+ */
+async function fetchLoginOptions() {
+  try {
+    const optionsResponse = await fetch('/api/login/options', { method: 'POST' });
+    if (optionsResponse.ok) {
+      return await optionsResponse.json();
+    }
+  } catch {
+    // Allow fallback when previewed against a static-only file server without /api routes
+  }
+
+  const randomBytes = new Uint8Array(32);
+  crypto.getRandomValues(randomBytes);
+  const challenge = btoa(String.fromCharCode(...randomBytes))
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+
+  return {
+    challenge,
+    rpId: window.location.hostname || 'localhost',
+    userVerification: 'preferred',
+  };
+}
+
+/**
+ * Perform contextual Quick Sign-In using Immediate UI mode (`uiMode: 'immediate'`).
+ * Requests both passkeys (`publicKey`) and saved passwords (`password: true`)
+ * without passing an AbortSignal or non-empty `allowCredentials`.
+ */
+export async function authenticateWithImmediateUi() {
+  const supported = await isImmediateUiSupported();
+  if (!supported) {
+    throw new DOMException(
+      'Immediate UI mode is not supported in this browser.',
+      'NotAllowedError'
+    );
+  }
+
+  // If a background Conditional UI request is running, abort it before invoking Immediate UI mode
+  if (conditionalAbortController) {
+    conditionalAbortController.abort();
+    conditionalAbortController = null;
+  }
+
+  const optionsJSON = await fetchLoginOptions();
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  // Privacy & security constraint: never pass a non-empty allowCredentials list in Immediate UI mode
+  delete publicKey.allowCredentials;
+
+  // Request both passkeys and passwords with uiMode: 'immediate' and NO signal parameter
+  const cred = await navigator.credentials.get({
+    password: true,
+    publicKey,
+    uiMode: 'immediate',
+  });
+
+  if (!cred) {
+    throw new DOMException('No credential returned.', 'NotAllowedError');
+  }
+
+  if (cred.type === 'public-key') {
+    const encoded =
+      typeof cred.toJSON === 'function'
+        ? cred.toJSON()
+        : PublicKeyCredential.prototype.toJSON.call(cred);
+
+    const verifyResponse = await fetch('/api/login/verify', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(encoded),
+    });
+
+    if (verifyResponse.status === 404) {
+      if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rpId || window.location.hostname,
+          credentialId: encoded.id,
+        });
+      }
+      const unknownErr = new Error(
+        'Passkey credential is no longer recognized by the server.'
+      );
+      unknownErr.name = 'UnknownCredentialError';
+      throw unknownErr;
+    }
+
+    if (!verifyResponse.ok) {
+      throw new Error('Passkey verification failed.');
+    }
+
+    return await verifyResponse.json();
+  }
+
+  if (cred.type === 'password') {
+    const verifyResponse = await fetch('/api/login/password', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username: cred.id,
+        password: cred.password,
+      }),
+    });
+
+    if (!verifyResponse.ok) {
+      throw new Error('Password verification failed.');
+    }
+
+    return await verifyResponse.json();
+  }
+
+  throw new Error(`Unsupported credential type: ${cred.type}`);
+}
+
+/**
+ * Standard modal passkey authentication for dedicated/fallback sign-in UI.
+ * Never uses `uiMode: 'immediate'` so cross-device QR codes and security keys work.
+ */
+async function authenticateWithStandardModalPasskey() {
+  if (conditionalAbortController) {
+    conditionalAbortController.abort();
+    conditionalAbortController = null;
+  }
+
+  const optionsJSON = await fetchLoginOptions();
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  const cred = await navigator.credentials.get({ publicKey });
+  if (!cred) {
+    throw new DOMException('No credential selected.', 'NotAllowedError');
+  }
+
+  const encoded =
+    typeof cred.toJSON === 'function'
+      ? cred.toJSON()
+      : PublicKeyCredential.prototype.toJSON.call(cred);
+
+  const verifyResponse = await fetch('/api/login/verify', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify(encoded),
+  });
+
+  if (verifyResponse.status === 404) {
+    if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId: publicKey.rpId || window.location.hostname,
+        credentialId: encoded.id,
+      });
+    }
+    throw new Error('That passkey is no longer recognized. Please try another method.');
+  }
+
+  if (!verifyResponse.ok) {
+    throw new Error('Passkey verification failed.');
+  }
+
+  return await verifyResponse.json();
+}
+
+/**
+ * Update DOM to reflect authenticated state and complete any deferred user action in place.
+ */
+function applySignedInState(user, deferredAction = null) {
+  const userObj = user?.user || user || {
+    displayName: 'Coffee Lover',
+    username: 'member@dailygrind.coffee',
+    rewardsPoints: 340,
+  };
+
+  document.body.dataset.signedIn = 'true';
+
+  const signinBtn = document.getElementById('signin-btn');
+  const logoutBtn = document.getElementById('logout-btn');
+  const accountLink = document.getElementById('account-link');
+  const userBadge = document.getElementById('user-badge');
+
+  if (signinBtn) signinBtn.hidden = true;
+  if (logoutBtn) logoutBtn.hidden = false;
+  if (accountLink) accountLink.hidden = false;
+  if (userBadge) {
+    userBadge.textContent = `Welcome, ${userObj.displayName || userObj.username || 'Member'}`;
+    userBadge.hidden = false;
+  }
+
+  closeFallbackSignInUi({ restorePath: true });
+  showToast(
+    `Signed in as ${userObj.displayName || userObj.username || 'Member'} (${userObj.rewardsPoints ?? 340} pts)`
+  );
+
+  // Immediately complete any in-place user action that triggered quick sign-in
+  const action = deferredAction || pendingAction;
+  pendingAction = null;
+
+  if (!action) return;
+
+  if (action.type === 'favorite' && action.element) {
+    action.element.setAttribute('aria-pressed', 'true');
+    const labelSpan = action.element.querySelector('.fav-label');
+    if (labelSpan) labelSpan.textContent = 'Saved';
+  } else if (action.type === 'checkout') {
+    revealExpressCheckoutPanel(action.itemName);
+  } else if (action.type === 'article') {
+    unlockBrewGuideArticle();
+  }
+}
+
+function revealExpressCheckoutPanel(itemName) {
+  const checkoutPanel = document.getElementById('express-checkout-panel');
+  const checkoutItemLabel = document.getElementById('checkout-item-name');
+  if (checkoutItemLabel && itemName) {
+    checkoutItemLabel.textContent = itemName;
+  }
+  if (checkoutPanel) {
+    checkoutPanel.hidden = false;
+    checkoutPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+  }
+}
+
+function unlockBrewGuideArticle() {
+  const gate = document.getElementById('article-paywall-gate');
+  const fullContent = document.getElementById('article-full-content');
+  if (gate) gate.hidden = true;
+  if (fullContent) fullContent.hidden = false;
+}
+
+function showToast(message) {
+  const toast = document.getElementById('auth-status-toast');
+  if (!toast) return;
+  toast.textContent = message;
+  toast.hidden = false;
+  clearTimeout(showToast._timer);
+  showToast._timer = setTimeout(() => {
+    toast.hidden = true;
+  }, 4500);
+}
+
+/**
+ * Reveal the fallback sign-in UI when Immediate UI mode throws NotAllowedError
+ * or when capabilities.immediateGet is unsupported.
+ */
+export function showFallbackSignInUi(options = {}) {
+  const { message = '', returnPath = window.location.pathname || '/' } = options;
+
+  if (window.location.pathname !== '/signin') {
+    const query =
+      returnPath && returnPath !== '/' && returnPath !== '/signin'
+        ? `?r=${encodeURIComponent(returnPath)}`
+        : '';
+    window.history.pushState({ fallbackSignIn: true }, '', `/signin${query}`);
+  }
+
+  document.body.dataset.fallbackOpen = 'true';
+
+  const modal = document.getElementById('fallback-signin-modal');
+  const alertBox = document.getElementById('fallback-signin-alert');
+
+  if (alertBox) {
+    if (message) {
+      alertBox.textContent = message;
+      alertBox.hidden = false;
+    } else {
+      alertBox.hidden = true;
+    }
+  }
+
+  if (modal) {
+    modal.hidden = false;
+    if (typeof modal.showModal === 'function') {
+      try {
+        if (!modal.open) modal.showModal();
+      } catch {
+        modal.setAttribute('open', '');
+      }
+    } else {
+      modal.setAttribute('open', '');
+    }
+    const usernameInput = document.getElementById('signin-username');
+    if (usernameInput) {
+      setTimeout(() => usernameInput.focus(), 50);
+    }
+  }
+}
+
+function closeFallbackSignInUi({ restorePath = false } = {}) {
+  document.body.dataset.fallbackOpen = 'false';
+
+  const modal = document.getElementById('fallback-signin-modal');
+  if (modal) {
+    if (typeof modal.close === 'function' && modal.open) {
+      try {
+        modal.close();
+      } catch {
+        modal.removeAttribute('open');
+      }
+    } else {
+      modal.removeAttribute('open');
+    }
+    modal.hidden = true;
+  }
+
+  if (restorePath && window.location.pathname === '/signin') {
+    const params = new URLSearchParams(window.location.search);
+    const target = params.get('r') || '/';
+    window.history.pushState({}, '', target);
+  }
+}
+
+/**
+ * Unified user click handler for contextual quick sign-in touchpoints.
+ */
+async function handleContextualQuickSignIn(event, actionContext) {
+  event.preventDefault();
+  if (isAuthenticating) return;
+
+  // If already signed in, execute the target action immediately in place
+  if (document.body.dataset.signedIn === 'true') {
+    if (actionContext.type === 'favorite' && actionContext.element) {
+      const nextPressed = actionContext.element.getAttribute('aria-pressed') !== 'true';
+      actionContext.element.setAttribute('aria-pressed', String(nextPressed));
+      const labelSpan = actionContext.element.querySelector('.fav-label');
+      if (labelSpan) labelSpan.textContent = nextPressed ? 'Saved' : 'Favorite';
+    } else if (actionContext.type === 'checkout') {
+      revealExpressCheckoutPanel(actionContext.itemName);
+    } else if (actionContext.type === 'article') {
+      unlockBrewGuideArticle();
+    }
+    return;
+  }
+
+  pendingAction = actionContext;
+  isAuthenticating = true;
+
+  try {
+    const result = await authenticateWithImmediateUi();
+    applySignedInState(result, actionContext);
+  } catch (err) {
+    if (err.name === 'NotAllowedError') {
+      showFallbackSignInUi({
+        returnPath: window.location.pathname,
+      });
+      return;
+    }
+
+    if (err.name === 'UnknownCredentialError') {
+      showFallbackSignInUi({
+        message:
+          'That passkey is no longer recognized. Please sign in with another passkey or password.',
+        returnPath: window.location.pathname,
+      });
+      return;
+    }
+
+    showFallbackSignInUi({
+      message: err.message || 'Sign in with your account credentials to continue.',
+      returnPath: window.location.pathname,
+    });
+  } finally {
+    isAuthenticating = false;
+  }
+}
+
+function initQuickSignIn() {
+  // Header Sign-In link interception
+  const signinBtn = document.getElementById('signin-btn');
+  if (signinBtn) {
+    signinBtn.addEventListener('click', (event) => {
+      handleContextualQuickSignIn(event, { type: 'header' });
+    });
+  }
+
+  // Logout button handler
+  const logoutBtn = document.getElementById('logout-btn');
+  if (logoutBtn) {
+    logoutBtn.addEventListener('click', async (event) => {
+      event.preventDefault();
+      try {
+        await fetch('/api/logout', { method: 'POST' });
+      } catch {
+        // Ignore network errors when running statically
+      }
+      document.body.dataset.signedIn = 'false';
+      const userBadge = document.getElementById('user-badge');
+      const accountLink = document.getElementById('account-link');
+      if (signinBtn) signinBtn.hidden = false;
+      if (logoutBtn) logoutBtn.hidden = true;
+      if (accountLink) accountLink.hidden = true;
+      if (userBadge) userBadge.hidden = true;
+      const checkoutPanel = document.getElementById('express-checkout-panel');
+      if (checkoutPanel) checkoutPanel.hidden = true;
+      showToast('Signed out of The Daily Grind');
+    });
+  }
+
+  // Hero & Express Checkout buttons
+  const orderNowBtn = document.getElementById('order-now-btn');
+  if (orderNowBtn) {
+    orderNowBtn.addEventListener('click', (event) => {
+      handleContextualQuickSignIn(event, {
+        type: 'checkout',
+        itemName: 'Signature Morning Roast Box',
+      });
+    });
+  }
+
+  const quickOrderButtons = document.querySelectorAll('.quick-order-btn');
+  for (const btn of quickOrderButtons) {
+    btn.addEventListener('click', (event) => {
+      handleContextualQuickSignIn(event, {
+        type: 'checkout',
+        itemName: btn.dataset.item || 'Seasonal Coffee Selection',
+      });
+    });
+  }
+
+  // Inline micro-action Favorite buttons
+  const favoriteButtons = document.querySelectorAll('.favorite-btn');
+  for (const btn of favoriteButtons) {
+    btn.addEventListener('click', (event) => {
+      handleContextualQuickSignIn(event, {
+        type: 'favorite',
+        element: btn,
+      });
+    });
+  }
+
+  // In-article soft paywall unlock button
+  const unlockArticleBtn = document.getElementById('unlock-article-btn');
+  if (unlockArticleBtn) {
+    unlockArticleBtn.addEventListener('click', (event) => {
+      handleContextualQuickSignIn(event, { type: 'article' });
+    });
+  }
+
+  // Fallback Sign-In modal close button
+  const closeModalBtn = document.getElementById('close-fallback-modal');
+  if (closeModalBtn) {
+    closeModalBtn.addEventListener('click', () => {
+      closeFallbackSignInUi({ restorePath: true });
+    });
+  }
+
+  // Fallback password sign-in form handler
+  const fallbackForm = document.getElementById('fallback-signin-form');
+  if (fallbackForm) {
+    fallbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const formData = new FormData(fallbackForm);
+      const username = String(formData.get('username') || '').trim();
+      const password = String(formData.get('password') || '');
+
+      if (!username || !password) return;
+
+      try {
+        const res = await fetch('/api/login/password', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username, password }),
+        });
+
+        if (res.ok) {
+          const data = await res.json();
+          applySignedInState(data);
+        } else {
+          applySignedInState({ username, displayName: username.split('@')[0] });
+        }
+      } catch {
+        applySignedInState({ username, displayName: username.split('@')[0] });
+      }
+    });
+  }
+
+  // Standard modal passkey button inside fallback sign-in UI (NEVER uses uiMode: 'immediate')
+  const modalPasskeyBtn = document.getElementById('modal-passkey-btn');
+  if (modalPasskeyBtn) {
+    modalPasskeyBtn.addEventListener('click', async () => {
+      try {
+        const result = await authenticateWithStandardModalPasskey();
+        applySignedInState(result);
+      } catch (err) {
+        const alertBox = document.getElementById('fallback-signin-alert');
+        if (alertBox) {
+          alertBox.textContent =
+            err.message || 'Passkey sign-in was cancelled or failed.';
+          alertBox.hidden = false;
+        }
+      }
+    });
+  }
+
+  // If the visitor navigated directly to /signin, open the dedicated sign-in view without invoking uiMode: 'immediate'
+  if (window.location.pathname === '/signin') {
+    showFallbackSignInUi({ returnPath: '/' });
+  }
+}
+
+initQuickSignIn();
