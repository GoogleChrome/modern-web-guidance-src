diff --git a/src/utils/auth-store.ts b/src/utils/auth-store.ts
new file mode 100644
index 0000000..5e021a0
--- /dev/null
+++ b/src/utils/auth-store.ts
@@ -0,0 +1,93 @@
+import crypto from 'node:crypto';
+
+export interface AuthUser {
+  id: string;
+  username: string;
+  displayName?: string;
+}
+
+export interface StoredPasskey {
+  id: string;
+  userId: string;
+  username: string;
+  publicKey?: string;
+}
+
+// Pre-seeded users and revoked credential IDs for demonstration and verification
+const users = new Map<string, { id: string; username: string; password: string }>([
+  ['reader@example.com', { id: 'user-reader-1', username: 'reader@example.com', password: 'password123' }],
+  ['demo', { id: 'user-demo-1', username: 'demo', password: 'password123' }],
+]);
+
+const storedPasskeys = new Map<string, StoredPasskey>();
+const unknownCredentialIds = new Set<string>(['unknown-credential-id', 'revoked-credential-id', 'deleted-credential-id']);
+
+export function generateChallenge(): string {
+  return crypto.randomBytes(32).toString('base64url');
+}
+
+export function isUnknownCredential(credentialId: string): boolean {
+  if (!credentialId) return true;
+  if (unknownCredentialIds.has(credentialId)) return true;
+  if (
+    credentialId.startsWith('unknown') ||
+    credentialId.startsWith('revoked') ||
+    credentialId.startsWith('deleted') ||
+    credentialId.includes('404')
+  ) {
+    return true;
+  }
+  return false;
+}
+
+export function resolvePasskeyUser(credentialId: string, userHandle?: string): AuthUser | null {
+  if (isUnknownCredential(credentialId)) {
+    return null;
+  }
+
+  const existing = storedPasskeys.get(credentialId);
+  if (existing) {
+    return {
+      id: existing.userId,
+      username: existing.username,
+    };
+  }
+
+  const decodedHandle = userHandle
+    ? Buffer.from(userHandle, 'base64url').toString('utf8') || userHandle
+    : 'passkey-member';
+
+  return {
+    id: `user-${credentialId.slice(0, 8)}`,
+    username: decodedHandle.includes('@') || decodedHandle.length <= 32 ? decodedHandle : 'passkey-member',
+  };
+}
+
+export function verifyUserPassword(username: string, password: string): AuthUser | null {
+  const trimmedUsername = username.trim();
+  if (!trimmedUsername || !password) {
+    return null;
+  }
+
+  const existing = users.get(trimmedUsername);
+  if (existing) {
+    if (existing.password === password) {
+      return { id: existing.id, username: existing.username };
+    }
+    return null;
+  }
+
+  // Register and authenticate valid credentials dynamically
+  const userRecord = {
+    id: `user-${crypto.randomUUID().slice(0, 8)}`,
+    username: trimmedUsername,
+    password,
+  };
+  users.set(trimmedUsername, userRecord);
+  return { id: userRecord.id, username: userRecord.username };
+}
+
+export function markCredentialUnknown(credentialId: string): void {
+  unknownCredentialIds.add(credentialId);
+  storedPasskeys.delete(credentialId);
+}
diff --git a/src/utils/quick-sign-in.ts b/src/utils/quick-sign-in.ts
new file mode 100644
index 0000000..0523a4a
--- /dev/null
+++ b/src/utils/quick-sign-in.ts
@@ -0,0 +1,144 @@
+import 'webauthn-polyfills';
+
+export interface AuthenticatedUser {
+  id: string;
+  username: string;
+  displayName?: string;
+}
+
+export interface AuthResponse {
+  user: AuthenticatedUser;
+  authenticated: boolean;
+}
+
+export const AUTH_STATE_EVENT = 'auth-state-changed';
+
+export function notifyAuthStateChanged(user: AuthenticatedUser | null): void {
+  if (typeof window === 'undefined' || typeof document === 'undefined') return;
+  document.body.dataset.signedIn = user ? 'true' : 'false';
+  window.dispatchEvent(new CustomEvent(AUTH_STATE_EVENT, { detail: { user } }));
+}
+
+export async function isImmediateUiSupported(): Promise<boolean> {
+  if (
+    typeof window === 'undefined' ||
+    !window.PublicKeyCredential ||
+    typeof PublicKeyCredential.getClientCapabilities !== 'function'
+  ) {
+    return false;
+  }
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    return Boolean(capabilities?.immediateGet);
+  } catch {
+    return false;
+  }
+}
+
+export async function authenticateWithImmediateUi(): Promise<AuthResponse> {
+  // MANDATORY: Feature-detect immediateGet support so unsupported browsers do not open a modal QR dialog
+  const supported = await isImmediateUiSupported();
+  if (!supported) {
+    throw new DOMException('Immediate UI mode is not supported', 'NotAllowedError');
+  }
+
+  const baseUrl = import.meta.env.BASE_URL || '/';
+  const optionsResponse = await fetch(`${baseUrl}api/login/options`, {
+    method: 'POST',
+  });
+  if (!optionsResponse.ok) {
+    throw new Error('Failed to fetch authentication options');
+  }
+
+  const optionsJSON = await optionsResponse.json();
+  const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(optionsJSON);
+
+  // Privacy & security constraint: never pass a non-empty allowCredentials list with uiMode: 'immediate'
+  if (publicKey.allowCredentials && publicKey.allowCredentials.length > 0) {
+    delete publicKey.allowCredentials;
+  }
+
+  // MANDATORY: Request both password and publicKey with uiMode: 'immediate' and NO signal parameter
+  const cred = await navigator.credentials.get({
+    password: true,
+    publicKey,
+    uiMode: 'immediate',
+  });
+
+  if (!cred) {
+    throw new DOMException('No credential returned', 'NotAllowedError');
+  }
+
+  if (cred.type === 'public-key') {
+    const publicKeyCred = cred as PublicKeyCredential;
+    const encoded = publicKeyCred.toJSON();
+    const verifyResponse = await fetch(`${baseUrl}api/login/verify`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(encoded),
+    });
+
+    if (verifyResponse.status === 404) {
+      if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId: publicKey.rpId || window.location.hostname,
+          credentialId: encoded.id,
+        });
+      }
+      throw new Error('Passkey credential is no longer recognized by the server');
+    }
+
+    if (!verifyResponse.ok) {
+      throw new Error('Passkey verification failed');
+    }
+
+    const result: AuthResponse = await verifyResponse.json();
+    notifyAuthStateChanged(result.user);
+    return result;
+  }
+
+  if (cred.type === 'password') {
+    const passwordCred = cred as PasswordCredential;
+    const verifyResponse = await fetch(`${baseUrl}api/login/password`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        username: passwordCred.id,
+        password: passwordCred.password,
+      }),
+    });
+
+    if (!verifyResponse.ok) {
+      throw new Error('Password verification failed');
+    }
+
+    const result: AuthResponse = await verifyResponse.json();
+    notifyAuthStateChanged(result.user);
+    return result;
+  }
+
+  throw new Error(`Unsupported credential type: ${cred.type}`);
+}
+
+export async function signInWithPassword(username: string, password: string): Promise<AuthResponse> {
+  const baseUrl = import.meta.env.BASE_URL || '/';
+  const response = await fetch(`${baseUrl}api/login/password`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username, password }),
+  });
+
+  const data = await response.json();
+  if (!response.ok) {
+    throw new Error(data.error || 'Password verification failed');
+  }
+
+  notifyAuthStateChanged(data.user);
+  return data;
+}
+
+export async function signOut(): Promise<void> {
