diff --git a/src/components/ArticlePaywallBanner.tsx b/src/components/ArticlePaywallBanner.tsx
new file mode 100644
index 0000000..4d98b0d
--- /dev/null
+++ b/src/components/ArticlePaywallBanner.tsx
@@ -0,0 +1,149 @@
+import React, { useState, useEffect } from 'react';
+import {
+  AUTH_STATE_EVENT,
+  authenticateWithImmediateUi,
+  signInWithPassword,
+  type AuthenticatedUser,
+} from '../utils/quick-sign-in';
+
+interface Props {
+  initialUser?: AuthenticatedUser | null;
+}
+
+export default function ArticlePaywallBanner({ initialUser = null }: Props) {
+  const [user, setUser] = useState<AuthenticatedUser | null>(initialUser);
+  const [isAuthenticating, setIsAuthenticating] = useState(false);
+  const [showInlineFallback, setShowInlineFallback] = useState(false);
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+
+  useEffect(() => {
+    const handleAuthChange = (event: Event) => {
+      const customEvent = event as CustomEvent<{ user: AuthenticatedUser | null }>;
+      setUser(customEvent.detail?.user ?? null);
+    };
+    window.addEventListener(AUTH_STATE_EVENT, handleAuthChange);
+    return () => {
+      window.removeEventListener(AUTH_STATE_EVENT, handleAuthChange);
+    };
+  }, []);
+
+  if (user) {
+    return null;
+  }
+
+  const handleContinueReadingClick = async (event: React.MouseEvent<HTMLButtonElement>) => {
+    event.preventDefault();
+    if (isAuthenticating) return;
+
+    setIsAuthenticating(true);
+    setError(null);
+    try {
+      const result = await authenticateWithImmediateUi();
+      setUser(result.user);
+      setShowInlineFallback(false);
+    } catch (err) {
+      // Expand inline sign-in form on NotAllowedError or credential verification failure
+      setShowInlineFallback(true);
+      if (err instanceof Error && err.name !== 'NotAllowedError') {
+        setError(err.message);
+      }
+    } finally {
+      setIsAuthenticating(false);
+    }
+  };
+
+  const handleInlineSubmit = async (event: React.FormEvent) => {
+    event.preventDefault();
+    setError(null);
+    setIsAuthenticating(true);
+    try {
+      const result = await signInWithPassword(username, password);
+      setUser(result.user);
+      setShowInlineFallback(false);
+    } catch (err) {
+      setError(err instanceof Error ? err.message : 'Sign-in failed');
+    } finally {
+      setIsAuthenticating(false);
+    }
+  };
+
+  return (
+    <aside
+      aria-label="Member quick sign-in"
+      className="my-8 p-6 bg-gray-50 border border-gray-200 rounded-lg"
+    >
+      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+        <div>
+          <h3 className="text-lg font-bold text-gray-900">
+            Enjoying The DevTools Times?
+          </h3>
+          <p className="text-sm text-gray-600 mt-1">
+            Sign in with your passkey or saved password in a single tap without leaving this article.
+          </p>
+        </div>
+        {!showInlineFallback && (
+          <button
+            type="button"
+            id="continue-reading-btn"
+            onClick={handleContinueReadingClick}
+            disabled={isAuthenticating}
+            className="px-4 py-2 bg-gray-900 text-white text-sm font-semibold rounded-md hover:bg-gray-800 whitespace-nowrap cursor-pointer"
+          >
+            {isAuthenticating ? 'Checking credentials...' : 'Continue reading with your account'}
+          </button>
+        )}
+      </div>
+
+      {showInlineFallback && (
+        <form onSubmit={handleInlineSubmit} className="mt-4 pt-4 border-t border-gray-200 space-y-3">
+          {error && (
+            <p className="text-xs text-red-700 bg-red-50 p-2 rounded" role="alert">
+              {error}
+            </p>
+          )}
+          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
+            <div>
+              <label htmlFor="paywall-username" className="block text-xs font-medium text-gray-700 mb-1">
+                Username
+              </label>
+              <input
+                type="text"
+                id="paywall-username"
+                autoComplete="username webauthn"
+                value={username}
+                onChange={(e) => setUsername(e.target.value)}
+                required
+                className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md"
+              />
+            </div>
+            <div>
+              <label htmlFor="paywall-password" className="block text-xs font-medium text-gray-700 mb-1">
+                Password
+              </label>
+              <input
+                type="password"
+                id="paywall-password"
+                autoComplete="current-password"
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                required
+                className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-md"
+              />
+            </div>
+          </div>
+          <div className="flex items-center gap-3">
+            <button
+              type="submit"
+              disabled={isAuthenticating}
+              className="px-4 py-1.5 bg-gray-900 text-white text-xs font-semibold rounded-md hover:bg-gray-800"
+            >
+              Sign in to continue
+            </button>
+          </div>
+        </form>
+      )}
+    </aside>
+  );
+}
