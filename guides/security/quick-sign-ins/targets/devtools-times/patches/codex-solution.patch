@@ -0,0 +1,51 @@
+import type { APIRoute } from 'astro';
+import { resolvePasskeyUser } from '../../../utils/auth-store';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  let body: {
+    id?: string;
+    rawId?: string;
+    type?: string;
+    response?: {
+      clientDataJSON?: string;
+      authenticatorData?: string;
+      signature?: string;
+      userHandle?: string;
+    };
+  };
+
+  try {
+    body = await request.json();
+  } catch {
+    return new Response(JSON.stringify({ error: 'Invalid JSON payload' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  if (!body || !body.id || body.type !== 'public-key') {
+    return new Response(JSON.stringify({ error: 'Invalid public-key credential assertion' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = resolvePasskeyUser(body.id, body.response?.userHandle);
+  if (!user) {
+    // Return 404 so client calls PublicKeyCredential.signalUnknownCredential()
+    return new Response(JSON.stringify({ error: 'Credential not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  if (session) {
+    await session.delete('challenge');
+    await session.set('user', user);
+  }
+
+  return new Response(JSON.stringify({ user, authenticated: true }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
