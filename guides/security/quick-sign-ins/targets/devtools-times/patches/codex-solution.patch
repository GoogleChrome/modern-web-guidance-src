+interface Props {
+  initialUser?: AuthenticatedUser | null;
+  baseUrl?: string;
+}
+
+export default function HeaderAuth({ initialUser = null, baseUrl = import.meta.env.BASE_URL || '/' }: Props) {
+  const [user, setUser] = useState<AuthenticatedUser | null>(initialUser);
+  const [isAuthenticating, setIsAuthenticating] = useState(false);
+
+  useEffect(() => {
+    document.body.dataset.signedIn = user ? 'true' : 'false';
+
+    const handleAuthChange = (event: Event) => {
+      const customEvent = event as CustomEvent<{ user: AuthenticatedUser | null }>;
+      setUser(customEvent.detail?.user ?? null);
+    };
+
+    window.addEventListener(AUTH_STATE_EVENT, handleAuthChange);
+    return () => {
+      window.removeEventListener(AUTH_STATE_EVENT, handleAuthChange);
+    };
+  }, [user]);
+
+  const handleSignInClick = async (event: React.MouseEvent<HTMLAnchorElement>) => {
+    event.preventDefault();
+    if (isAuthenticating) return;
+
+    setIsAuthenticating(true);
+    try {
+      const result = await authenticateWithImmediateUi();
+      setUser(result.user);
+    } catch (err) {
+      // On NotAllowedError or fallback condition, proceed with navigating to dedicated sign-in page
+      const returnPath = `${window.location.pathname}${window.location.search}`;
+      window.location.href = `${baseUrl}signin?r=${encodeURIComponent(returnPath)}`;
+    } finally {
+      setIsAuthenticating(false);
+    }
+  };
+
+  const handleSignOutClick = async (event: React.MouseEvent<HTMLButtonElement>) => {
+    event.preventDefault();
+    await signOut();
+    setUser(null);
+  };
+
+  if (user) {
+    return (
+      <div className="flex items-center space-x-3">
+        <span className="text-xs font-medium text-gray-700" data-testid="header-username">
+          {user.username}
+        </span>
+        <button
+          type="button"
+          id="header-signout-btn"
+          onClick={handleSignOutClick}
+          className="bg-gray-200 text-gray-800 text-xs font-semibold py-2 px-3 rounded hover:bg-gray-300 cursor-pointer"
+        >
+          Sign out
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex items-center space-x-3">
+      <a
+        href={`${baseUrl}signup`}
+        id="header-signup-link"
+        data-skip-tracking="true"
+        className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700"
+      >
+        Sign up
+      </a>
+      <a
+        href={`${baseUrl}signin`}
+        id="header-signin-link"
+        onClick={handleSignInClick}
+        data-skip-tracking="true"
+        className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400"
+      >
+        {isAuthenticating ? 'Signing in...' : 'Sign in'}
+      </a>
+    </div>
+  );
+}
