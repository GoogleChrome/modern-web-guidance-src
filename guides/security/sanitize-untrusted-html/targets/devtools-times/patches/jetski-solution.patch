diff --git a/src/utils/safeSetHTML.ts b/src/utils/safeSetHTML.ts
new file mode 100644
index 0000000..973e27a
--- /dev/null
+++ b/src/utils/safeSetHTML.ts
@@ -0,0 +1,61 @@
+const elements = ['p', 'b', 'i', 'strong', 'em', 'br', 'ul', 'ol', 'li', 'blockquote'];
+const attributes = ['class'];
+
+type SafeHTMLElement = Element & {
+  setHTML(
+    html: string,
+    options?: {
+      sanitizer?: { elements?: string[]; attributes?: string[] };
+    }
+  ): void;
+};
+
+let domPurifyPromise: Promise<typeof import('dompurify')['default']> | undefined;
+const revisions = new WeakMap<Element, number>();
+
+/**
+ * Safely parse and display untrusted HTML content using Element.setHTML() when available,
+ * or lazily loaded DOMPurify as a matching fallback.
+ */
+export async function safeSetHTML(container: Element, html: string): Promise<void> {
+  const revision = (revisions.get(container) ?? 0) + 1;
+  revisions.set(container, revision);
+
+  if ('setHTML' in Element.prototype) {
+    try {
+      (container as SafeHTMLElement).setHTML(html, {
+        sanitizer: { elements, attributes },
+      });
+      return;
+    } catch {
+      try {
+        (container as SafeHTMLElement).setHTML(html);
+        return;
+      } catch {
+        // Fall through to DOMPurify fallback
+      }
+    }
+  }
+
+  domPurifyPromise ??= import('dompurify')
+    .then((module) => module.default)
+    .catch((error: unknown) => {
+      domPurifyPromise = undefined;
+      throw error;
+    });
+
+  const purifier = await domPurifyPromise;
+  if (revisions.get(container) !== revision) return;
+
+  const fragment = purifier.sanitize(html, {
+    ALLOWED_TAGS: [...elements, '#text'],
+    ALLOWED_ATTR: attributes,
+    ALLOW_ARIA_ATTR: false,
+    ALLOW_DATA_ATTR: false,
+    KEEP_CONTENT: false,
+    RETURN_DOM_FRAGMENT: true,
+  });
+
+  // Move sanitized nodes directly; do not serialize and reparse the result.
+  container.replaceChildren(fragment);
+}
