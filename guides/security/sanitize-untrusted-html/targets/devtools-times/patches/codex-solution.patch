diff --git a/src/components/CommentPreview.astro b/src/components/CommentPreview.astro
new file mode 100644
index 0000000..8433055
--- /dev/null
+++ b/src/components/CommentPreview.astro
@@ -0,0 +1,55 @@
+<reader-comment-preview class="block p-4 md:p-6 border-t border-gray-200">
+  <h2 class="text-2xl font-brand mb-2">Preview your comment</h2>
+  <p class="text-sm text-gray-600 mb-4" id="comment-help">
+    Try formatting your comment with paragraphs, bold, italics, lists, or quotes.
+    This preview is private and is not published or saved.
+  </p>
+  <form>
+    <label for="comment-html" class="block font-semibold mb-2">Comment HTML</label>
+    <textarea id="comment-html" name="html" rows="5" aria-describedby="comment-help"
+      class="block w-full border border-gray-400 rounded p-3 font-mono text-sm"
+      placeholder="<p>Hello <b>readers</b>!</p>"></textarea>
+    <button type="submit" class="mt-3 rounded bg-gray-800 px-4 py-2 text-white hover:bg-gray-700 disabled:opacity-50">
+      Preview comment
+    </button>
+  </form>
+  <p role="status" class="text-sm text-gray-600 mt-3"></p>
+  <h3 class="font-semibold mt-4 mb-2" id="comment-preview-heading">Preview</h3>
+  <div id="output" role="region" aria-labelledby="comment-preview-heading"
+    class="prose max-w-none min-h-20 border border-gray-200 rounded p-4 break-words"></div>
+</reader-comment-preview>
+
+<script>
+  import { safeSetHTML } from '../utils/safeSetHTML';
+
+  class ReaderCommentPreview extends HTMLElement {
+    connectedCallback() {
+      const form = this.querySelector('form');
+      const input = this.querySelector('textarea');
+      const button = this.querySelector('button');
+      const output = this.querySelector<HTMLElement>('[role="region"]');
+      const status = this.querySelector<HTMLElement>('[role="status"]');
+      if (!form || !input || !button || !output || !status) return;
+
+      form.onsubmit = async event => {
+        event.preventDefault();
+        if (button.disabled) return;
+        button.disabled = true;
+        status.textContent = 'Preparing preview…';
+        try {
+          await safeSetHTML(output, input.value);
+          status.textContent = 'Preview updated. Only supported formatting is shown.';
+        } catch {
+          output.replaceChildren();
+          status.textContent = 'Unable to prepare a safe preview. Please try again.';
+        } finally {
+          button.disabled = false;
+        }
+      };
+    }
+  }
+
+  if (!customElements.get('reader-comment-preview')) {
+    customElements.define('reader-comment-preview', ReaderCommentPreview);
+  }
+</script>
