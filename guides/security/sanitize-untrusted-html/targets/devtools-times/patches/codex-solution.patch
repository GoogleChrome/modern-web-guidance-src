diff --git a/src/utils/safeSetHTML.ts b/src/utils/safeSetHTML.ts
new file mode 100644
index 0000000..29878cf
--- /dev/null
+++ b/src/utils/safeSetHTML.ts
@@ -0,0 +1,36 @@
+const elements = ['p', 'b', 'i', 'strong', 'em', 'br', 'ul', 'ol', 'li', 'blockquote'];
+const attributes: string[] = [];
+
+type SafeHTMLElement = Element & {
+  setHTML: (html: string, options: {
+    sanitizer: { elements: string[]; attributes: string[] };
+  }) => void;
+};
+
+let purifierPromise: Promise<typeof import('dompurify')['default']> | undefined;
+
+/** Parse untrusted input only through a sanitizer, never through a live DOM sink. */
+export async function safeSetHTML(container: Element, html: string): Promise<void> {
+  if ('setHTML' in Element.prototype) {
+    (container as SafeHTMLElement).setHTML(html, {
+      sanitizer: { elements, attributes },
+    });
+    return;
+  }
+
+  purifierPromise ??= import('dompurify').then(module => module.default).catch(error => {
+    purifierPromise = undefined;
+    throw error;
+  });
+  const purifier = await purifierPromise;
+  const fragment = purifier.sanitize(html, {
+    ALLOWED_TAGS: [...elements, '#text'],
+    ALLOWED_ATTR: attributes,
+    ALLOW_ARIA_ATTR: false,
+    ALLOW_DATA_ATTR: false,
+    KEEP_CONTENT: false,
+    RETURN_DOM_FRAGMENT: true,
+  });
+  // Move sanitized nodes directly; do not serialize and reparse the result.
+  container.replaceChildren(fragment);
+}
