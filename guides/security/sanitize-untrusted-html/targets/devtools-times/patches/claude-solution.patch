diff --git a/src/utils/sanitize.ts b/src/utils/sanitize.ts
new file mode 100644
index 0000000..a0b9688
--- /dev/null
+++ b/src/utils/sanitize.ts
@@ -0,0 +1,40 @@
+// Renders untrusted HTML safely using the native Sanitizer API
+// (https://wicg.github.io/sanitizer-api/), falling back to DOMPurify only
+// when the browser doesn't support it, so the fallback bundle is never
+// downloaded by browsers that don't need it.
+
+const ALLOWED_ELEMENTS = ['p', 'b', 'i', 'strong', 'em', 'br'];
+const ALLOWED_ATTRIBUTES = ['class'];
+
+const SANITIZER_CONFIG: SanitizerConfig = {
+  elements: ALLOWED_ELEMENTS,
+  attributes: ALLOWED_ATTRIBUTES,
+};
+
+let domPurifyPromise: Promise<typeof import('dompurify').default> | undefined;
+
+function loadDOMPurify() {
+  // Code-split with the bundler so DOMPurify is only downloaded when needed.
+  domPurifyPromise ??= import('dompurify').then((mod) => mod.default ?? mod);
+  return domPurifyPromise;
+}
+
+/**
+ * Sanitizes `html` and inserts it into `el`, matching behavior between the
+ * native Sanitizer API and its DOMPurify fallback: disallowed elements are
+ * removed together with their content.
+ */
+export async function safeSetHTML(el: Element, html: string): Promise<void> {
+  if ('setHTML' in Element.prototype) {
+    el.setHTML(html, { sanitizer: SANITIZER_CONFIG });
+    return;
+  }
+
+  const DOMPurify = await loadDOMPurify();
+  el.innerHTML = DOMPurify.sanitize(html, {
+    ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+    ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+    // Match the native Sanitizer: remove disallowed elements with their content.
+    KEEP_CONTENT: false,
+  });
+}
