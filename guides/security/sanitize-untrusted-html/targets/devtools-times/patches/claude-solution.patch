diff --git a/src/components/CommentSection.tsx b/src/components/CommentSection.tsx
new file mode 100644
index 0000000..1f7c751
--- /dev/null
+++ b/src/components/CommentSection.tsx
@@ -0,0 +1,115 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { safeSetHTML } from '../utils/sanitize';
+
+interface Comment {
+  id: number;
+  author: string;
+  html: string;
+}
+
+const INITIAL_COMMENTS: Comment[] = [
+  {
+    id: 1,
+    author: 'Jordan R.',
+    html: '<p>Great reporting on this <b>story</b> — thanks for the detailed breakdown.</p>',
+  },
+  {
+    id: 2,
+    author: 'Casey M.',
+    html: '<p>I appreciate the <em>balanced</em> perspective here.</p>',
+  },
+];
+
+interface SanitizedHtmlProps {
+  html: string;
+  className?: string;
+}
+
+function SanitizedHtml({ html, className }: SanitizedHtmlProps) {
+  const ref = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    safeSetHTML(el, html);
+  }, [html]);
+
+  return <div ref={ref} className={className} data-testid="comment-output" />;
+}
+
+export default function CommentSection() {
+  const [comments, setComments] = useState<Comment[]>(INITIAL_COMMENTS);
+  const [author, setAuthor] = useState('');
+  const [draft, setDraft] = useState('');
+  const nextId = useRef(INITIAL_COMMENTS.length + 1);
+
+  const handleSubmit = (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!draft.trim()) return;
+
+    setComments((prev) => [
+      ...prev,
+      { id: nextId.current++, author: author.trim() || 'Anonymous', html: draft },
+    ]);
+    setDraft('');
+  };
+
+  return (
+    <section id="comments" className="max-w-3xl mx-auto px-4 py-8 border-t border-gray-200">
+      <h2 className="text-2xl font-brand text-gray-900 mb-4">Comments</h2>
+
+      <ul className="space-y-4 mb-8">
+        {comments.map((comment) => (
+          <li key={comment.id} className="p-4 bg-gray-50 rounded-lg border border-gray-200">
+            <p className="text-sm font-semibold text-gray-800 mb-1">{comment.author}</p>
+            <SanitizedHtml html={comment.html} className="prose prose-sm max-w-none text-gray-700" />
+          </li>
+        ))}
+      </ul>
+
+      <form onSubmit={handleSubmit} className="space-y-3">
+        <div>
+          <label htmlFor="comment-author" className="block text-sm font-medium text-gray-700 mb-1">
+            Name
+          </label>
+          <input
+            id="comment-author"
+            type="text"
+            value={author}
+            onChange={(e) => setAuthor(e.target.value)}
+            placeholder="Anonymous"
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-400"
+          />
+        </div>
+
+        <div>
+          <label htmlFor="comment-body" className="block text-sm font-medium text-gray-700 mb-1">
+            Add a comment (basic formatting like <code>&lt;b&gt;</code> and <code>&lt;i&gt;</code> is supported)
+          </label>
+          <textarea
+            id="comment-body"
+            value={draft}
+            onChange={(e) => setDraft(e.target.value)}
+            rows={4}
+            className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-amber-400"
+          />
+        </div>
+
+        <div>
+          <p className="block text-sm font-medium text-gray-700 mb-1">Preview</p>
+          <SanitizedHtml
+            html={draft}
+            className="prose prose-sm max-w-none text-gray-700 min-h-[2rem] p-3 bg-white border border-dashed border-gray-300 rounded-md"
+          />
+        </div>
+
+        <button
+          type="submit"
+          className="py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900"
+        >
+          Post Comment
+        </button>
+      </form>
+    </section>
+  );
+}
