+  <script type="module">
+    const ALLOWED_ELEMENTS = ['p', 'b', 'i', 'strong', 'em'];
+    const ALLOWED_ATTRIBUTES = ['class'];
+
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.1.6/+esm').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    export async function safeSetHTML(el, html) {
+      const elements = ALLOWED_ELEMENTS;
+      const attributes = ALLOWED_ATTRIBUTES;
+
+      if ('setHTML' in Element.prototype) {
+        // setHTML() accepts a plain configuration object as the sanitizer
+        el.setHTML(html, { sanitizer: { elements, attributes } });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...elements, '#text'],
+          ALLOWED_ATTR: attributes,
+          // Match the native Sanitizer: strip aria-*/data-* and disallowed element content
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    async function updatePreview(previewEl, rawHTML) {
+      if (!rawHTML.trim()) {
+        previewEl.replaceChildren();
+        return;
+      }
+
+      if ('parseHTML' in Document) {
+        const doc = Document.parseHTML(rawHTML, {
+          sanitizer: {
+            elements: ALLOWED_ELEMENTS,
+            attributes: ALLOWED_ATTRIBUTES
+          }
+        });
+        previewEl.replaceChildren(...doc.body.childNodes);
+      } else {
+        await safeSetHTML(previewEl, rawHTML);
+      }
+    }
+
+    const initialReviews = [
+      {
+        author: 'Sarah J.',
+        drink: 'Maple Oat Latte',
+        html: '<p>The <strong>Maple Oat Latte</strong> has the <em>perfect</em> balance of sweetness and rich espresso!</p>'
+      },
+      {
+        author: 'Marcus T.',
+        drink: 'Dark Roast Espresso',
+        html: '<p>Bold and <b>unapologetically strong</b>. Exactly what I need every morning.</p>'
+      },
+      {
+        author: 'Elena R.',
+        drink: 'Cold Brew',
+        html: '<p>So <i>incredibly smooth</i> with zero bitterness. Best cold brew in town!</p>'
+      }
+    ];
+
+    const reviewsList = document.getElementById('reviews-list');
+    const reviewForm = document.getElementById('review-form');
+    const reviewerNameInput = document.getElementById('reviewer-name');
+    const drinkSelect = document.getElementById('drink-select');
+    const reviewHtmlInput = document.getElementById('review-html');
+    const reviewPreview = document.getElementById('review-preview');
+
+    async function renderReview({ author, drink, html }, prepend = false) {
+      const item = document.createElement('article');
+      item.className = 'review-item';
+
+      const header = document.createElement('div');
+      header.className = 'review-header';
+
+      const authorSpan = document.createElement('span');
+      authorSpan.className = 'review-author';
+      authorSpan.textContent = author;
+
+      const drinkSpan = document.createElement('span');
+      drinkSpan.className = 'review-drink';
+      drinkSpan.textContent = drink;
+
+      header.append(authorSpan, drinkSpan);
+
+      const content = document.createElement('div');
+      content.className = 'review-content';
+      await safeSetHTML(content, html);
+
+      item.append(header, content);
+
+      if (prepend && reviewsList.firstChild) {
+        reviewsList.prepend(item);
+      } else {
+        reviewsList.appendChild(item);
+      }
+    }
+
+    reviewHtmlInput.addEventListener('input', () => {
+      updatePreview(reviewPreview, reviewHtmlInput.value);
+    });
+
+    reviewForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const author = reviewerNameInput.value.trim();
+      const drink = drinkSelect.value;
+      const html = reviewHtmlInput.value;
+
+      if (!author || !html.trim()) return;
+
+      await renderReview({ author, drink, html }, true);
+      reviewForm.reset();
+      reviewPreview.replaceChildren();
+    });
+
+    for (const review of initialReviews) {
+      await renderReview(review);
+    }
+  </script>
