+  <script>
+    // Sanitizer config: rich text only, no scripts/handlers/styles.
+    const reviewElements = ['p', 'b', 'i', 'strong', 'em', 'u', 'br', 'ul', 'ol', 'li', 'blockquote', 'span', 'a'];
+    const reviewAttributes = ['class', 'href'];
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.es.mjs')
+        .then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        el.setHTML(html, { sanitizer: { elements: reviewElements, attributes: reviewAttributes } });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...reviewElements, '#text'],
+          ALLOWED_ATTR: reviewAttributes,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    document.querySelectorAll('.reviews').forEach((box) => {
+      const form = box.querySelector('.review-form');
+      const textarea = form.querySelector('textarea');
+      const list = box.querySelector('.review-list');
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+        const html = textarea.value.trim();
+        if (!html) return;
+        const item = document.createElement('li');
+        try {
+          await safeSetHTML(item, html);
+        } catch {
+          return;
+        }
+        list.prepend(item);
+        textarea.value = '';
+      });
+    });
+  </script>
+
 </body>
 
