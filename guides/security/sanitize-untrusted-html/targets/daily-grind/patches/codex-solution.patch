diff --git a/src/main.ts b/src/main.ts
new file mode 100644
index 0000000..97b7e0d
--- /dev/null
+++ b/src/main.ts
@@ -0,0 +1,26 @@
+import { safeSetHTML } from './sanitize';
+
+const form = document.querySelector<HTMLFormElement>('#preview-form');
+const input = document.querySelector<HTMLTextAreaElement>('#html-input');
+const output = document.querySelector<HTMLDivElement>('#output');
+const status = document.querySelector<HTMLParagraphElement>('#preview-status');
+
+if (!form || !input || !output || !status) {
+  throw new Error('The HTML preview controls are missing.');
+}
+
+let request = 0;
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  const current = ++request;
+  status.textContent = 'Preparing preview…';
+  try {
+    await safeSetHTML(output, input.value);
+    if (current === request) status.textContent = 'Preview updated. Only supported formatting is shown.';
+  } catch {
+    if (current === request) {
+      output.replaceChildren();
+      status.textContent = 'The preview could not be loaded. Please try again.';
+    }
+  }
+});
diff --git a/src/sanitize.ts b/src/sanitize.ts
new file mode 100644
index 0000000..abdd8f4
--- /dev/null
+++ b/src/sanitize.ts
@@ -0,0 +1,43 @@
+const elements = ['p', 'b', 'i', 'strong', 'em'];
+const attributes = ['class'];
+
+type NativeSanitizerElement = Element & {
+  setHTML(html: string, options: {
+    sanitizer: { elements: string[]; attributes: string[] };
+  }): void;
+};
+
+let domPurifyPromise: Promise<typeof import('dompurify')['default']> | undefined;
+const revisions = new WeakMap<Element, number>();
+
+/** Render only approved formatting. A newer render always wins over a pending import. */
+export async function safeSetHTML(element: Element, html: string): Promise<void> {
+  const revision = (revisions.get(element) ?? 0) + 1;
+  revisions.set(element, revision);
+
+  if ('setHTML' in Element.prototype) {
+    (element as NativeSanitizerElement).setHTML(html, {
+      sanitizer: { elements: [...elements], attributes: [...attributes] },
+    });
+    return;
+  }
+
+  domPurifyPromise ??= import('dompurify').then((module) => module.default).catch((error: unknown) => {
+    domPurifyPromise = undefined;
+    throw error;
+  });
+  const DOMPurify = await domPurifyPromise;
+  if (revisions.get(element) !== revision) return;
+
+  // Insert sanitized nodes directly: no serialization or second HTML parsing sink.
+  // Under Trusted Types CSP, allow DOMPurify's internal `dompurify` policy.
+  const fragment = DOMPurify.sanitize(html, {
+    ALLOWED_TAGS: [...elements, '#text'],
+    ALLOWED_ATTR: [...attributes],
+    ALLOW_ARIA_ATTR: false,
+    ALLOW_DATA_ATTR: false,
+    KEEP_CONTENT: false,
+    RETURN_DOM_FRAGMENT: true,
+  });
+  element.replaceChildren(fragment);
+}
diff --git a/tests/preview.spec.ts b/tests/preview.spec.ts
new file mode 100644
index 0000000..ca0ffe8
--- /dev/null
+++ b/tests/preview.spec.ts
@@ -0,0 +1,53 @@
+import { test, expect } from '@playwright/test';
+
+for (const fallback of [false, true]) {
+  test(`${fallback ? 'fallback' : 'native'} sanitization preserves formatting and prevents execution`, async ({ page }) => {
+    const messages: string[] = [];
+    const dialogs: string[] = [];
+    const sanitizerRequests: string[] = [];
+    page.on('console', (message) => {
+      if (message.text().includes('INJECTED')) messages.push(message.text());
+    });
+    page.on('dialog', async (dialog) => {
+      dialogs.push(dialog.message());
+      await dialog.dismiss();
+    });
+    page.on('request', (request) => {
+      if (request.url().includes('dompurify')) sanitizerRequests.push(request.url());
+    });
+    await page.addInitScript((forceFallback) => {
+      if (forceFallback) Reflect.deleteProperty(Element.prototype, 'setHTML');
+    }, fallback);
+    await page.goto('/');
+    if (!fallback) expect(await page.evaluate(() => 'setHTML' in Element.prototype)).toBe(true);
+    expect(sanitizerRequests).toHaveLength(0);
+    await page.getByLabel('Your note (HTML)').fill(`
+      <p class="note" onclick="alert('INJECTED')">Hello <b>coffee</b> <em>friends</em></p>
+      <script>console.log('INJECTED');alert('INJECTED')</script>
+      <img src="/missing" onerror="console.log('INJECTED');alert('INJECTED')">
+      <svg onload="alert('INJECTED')"><script>alert('INJECTED')</script></svg>
+      <iframe srcdoc="<script>alert('INJECTED')</script>"></iframe>
+      <div>discard this wrapper and its contents</div>
+      <p style="color:red" data-test="no" aria-label="no" onmouseover="alert('INJECTED')">Safe ending</p>
+    `);
+    await page.getByRole('button', { name: 'Render preview' }).click();
+    await expect(page.getByRole('status')).toContainText('Preview updated');
+    const output = page.locator('#output');
+    await expect(output.locator('p.note > b')).toHaveText('coffee');
+    await expect(output.locator('em')).toHaveText('friends');
+    await expect(output.locator('script, img, svg, iframe, div')).toHaveCount(0);
+    expect(await output.evaluate((element) => [...element.querySelectorAll('*')].flatMap((node) =>
+      [...node.attributes].filter((attribute) => attribute.name !== 'class').map((attribute) => attribute.name)
+    ))).toEqual([]);
+    await expect(output).not.toContainText('discard');
+    await output.locator('b').click();
+    await output.locator('p').last().hover();
+    expect(messages).toEqual([]);
+    expect(dialogs).toEqual([]);
+    expect(sanitizerRequests.length > 0).toBe(fallback);
+
+    await page.getByLabel('Your note (HTML)').fill('');
+    await page.getByRole('button', { name: 'Render preview' }).click();
+    await expect(output).toBeEmpty();
+  });
+}
