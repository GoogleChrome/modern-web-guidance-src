diff --git a/reviews.ts b/reviews.ts
new file mode 100644
index 0000000..cc110e7
--- /dev/null
+++ b/reviews.ts
@@ -0,0 +1,100 @@
+export {};
+
+const allowedElements = ['p', 'br', 'b', 'strong', 'i', 'em', 'ul', 'ol', 'li', 'blockquote'];
+
+// Keep these types local for TypeScript DOM libraries without the Sanitizer API.
+type SanitizingElement = HTMLDivElement & {
+  setHTML: (html: string, options: {
+    sanitizer: { elements: string[]; attributes: string[] };
+  }) => void;
+};
+
+let purifierPromise: Promise<typeof import('dompurify')['default']> | undefined;
+
+async function renderFeedback(container: HTMLDivElement, html: string): Promise<void> {
+  if ('setHTML' in Element.prototype) {
+    (container as SanitizingElement).setHTML(html, {
+      sanitizer: { elements: allowedElements, attributes: [] },
+    });
+    return;
+  }
+
+  // Download the fallback only when native sanitization is unavailable.
+  purifierPromise ??= import('dompurify').then((module) => module.default).catch((error: unknown) => {
+    purifierPromise = undefined;
+    throw error;
+  });
+  const purifier = await purifierPromise;
+  const fragment = purifier.sanitize(html, {
+    ALLOWED_TAGS: [...allowedElements, '#text'],
+    ALLOWED_ATTR: [],
+    ALLOW_ARIA_ATTR: false,
+    ALLOW_DATA_ATTR: false,
+    KEEP_CONTENT: false,
+    RETURN_DOM_FRAGMENT: true,
+  });
+  // Move sanitized nodes directly; never serialize and reparse untrusted HTML.
+  container.replaceChildren(fragment);
+}
+
+const form = document.querySelector<HTMLFormElement>('#review-form');
+const drink = document.querySelector<HTMLSelectElement>('#review-drink');
+const feedback = document.querySelector<HTMLTextAreaElement>('#review-feedback');
+const status = document.querySelector<HTMLParagraphElement>('#review-status');
+const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
+const destinations = new Map([
+  ['maple-reviews', document.querySelector<HTMLUListElement>('#maple-reviews')],
+  ['espresso-reviews', document.querySelector<HTMLUListElement>('#espresso-reviews')],
+  ['cold-brew-reviews', document.querySelector<HTMLUListElement>('#cold-brew-reviews')],
+]);
+
+if (form && drink && feedback && status && submit) {
+  submit.disabled = false;
+  let submitting = false;
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    if (submitting || !form.reportValidity()) return;
+
+    const destination = destinations.get(drink.value);
+    if (!destination) {
+      status.textContent = 'Please select a drink.';
+      return;
+    }
+    const rawFeedback = feedback.value;
+    if (!rawFeedback.trim() || rawFeedback.length > 5000) {
+      status.textContent = 'Please write a review between 1 and 5,000 characters.';
+      feedback.focus();
+      return;
+    }
+
+    submitting = true;
+    submit.disabled = true;
+    status.textContent = 'Preparing your review…';
+    try {
+      const content = document.createElement('div');
+      content.className = 'review-content';
+      await renderFeedback(content, rawFeedback);
+      if (!content.textContent?.trim()) {
+        status.textContent = 'Please include some review text using the supported formatting.';
+        feedback.focus();
+        return;
+      }
+
+      const item = document.createElement('li');
+      item.append(content);
+      destination.append(item);
+      const emptyMessage = destination.parentElement?.querySelector('.empty-reviews');
+      if (emptyMessage instanceof HTMLElement) emptyMessage.hidden = true;
+      // Preserve any new text typed while the fallback was loading.
+      if (feedback.value === rawFeedback) feedback.value = '';
+      status.textContent = 'Your review has been added.';
+      feedback.focus();
+    } catch {
+      status.textContent = 'Your review could not be displayed safely. Please try again.';
+    } finally {
+      submitting = false;
+      submit.disabled = false;
+    }
+  });
+}
