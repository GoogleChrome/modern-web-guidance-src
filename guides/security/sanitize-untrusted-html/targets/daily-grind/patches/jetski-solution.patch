+// @ts-check
+
+const elements = ['p', 'b', 'i', 'strong', 'em'];
+const attributes = ['class'];
+
+const DOMPURIFY_CDN = 'https://unpkg.com/dompurify@3.4.16/dist/purify.es.mjs';
+
+/** @type {Promise<any> | undefined} */
+let domPurifyPromise;
+
+/** @type {WeakMap<Element, number>} */
+const revisions = new WeakMap();
+
+/**
+ * Dynamically load DOMPurify only when native Sanitizer API is missing.
+ * @returns {Promise<any>}
+ */
+export function loadDOMPurify() {
+  domPurifyPromise ??= import('dompurify')
+    .then((mod) => mod.default ?? mod)
+    .catch(() => import('/node_modules/dompurify/dist/purify.es.mjs').then((mod) => mod.default ?? mod))
+    .catch(() => import(DOMPURIFY_CDN).then((mod) => mod.default ?? mod))
+    .catch((error) => {
+      domPurifyPromise = undefined;
+      throw error;
+    });
+  return domPurifyPromise;
+}
+
+/**
+ * Safely parse untrusted HTML without inserting into live DOM.
+ * @param {string} html
+ * @returns {Promise<Document | DocumentFragment>}
+ */
+export async function safeParseHTML(html) {
+  if ('parseHTML' in Document) {
+    // @ts-ignore
+    return Document.parseHTML(html);
+  }
+  const DOMPurify = await loadDOMPurify();
+  return DOMPurify.sanitize(html, {
+    ALLOWED_TAGS: [...elements, '#text'],
+    ALLOWED_ATTR: [...attributes],
+    KEEP_CONTENT: false,
+    RETURN_DOM_FRAGMENT: true,
+  });
+}
+
+/**
+ * Safely parse and display untrusted HTML into the specified container element.
+ * Uses native Element.prototype.setHTML() when available, falling back to DOMPurify.
+ *
+ * @param {Element} element
+ * @param {string} html
+ * @returns {Promise<void>}
+ */
+export async function safeSetHTML(element, html) {
+  const revision = (revisions.get(element) ?? 0) + 1;
+  revisions.set(element, revision);
+
+  if ('setHTML' in Element.prototype) {
+    /** @type {any} */
+    let sanitizerConfig = { elements: [...elements], attributes: [...attributes] };
+    if (typeof Sanitizer === 'function') {
+      try {
+        sanitizerConfig = new Sanitizer({ elements: [...elements], attributes: [...attributes] });
+      } catch {
+        // Fall back to plain config object
+      }
+    }
+    try {
+      /** @type {any} */ (element).setHTML(html, { sanitizer: sanitizerConfig });
+    } catch {
+      /** @type {any} */ (element).setHTML(html);
+    }
+    return;
+  }
+
+  const DOMPurify = await loadDOMPurify();
+  if (revisions.get(element) !== revision) return;
+
+  const fragment = DOMPurify.sanitize(html, {
+    ALLOWED_TAGS: [...elements, '#text'],
+    ALLOWED_ATTR: [...attributes],
+    ALLOW_ARIA_ATTR: false,
+    ALLOW_DATA_ATTR: false,
+    KEEP_CONTENT: false,
+    RETURN_DOM_FRAGMENT: true,
+  });
+  element.replaceChildren(fragment);
+}
+
+// Expose globally for testing or script invocation
+if (typeof window !== 'undefined') {
+  /** @type {any} */ (window).safeSetHTML = safeSetHTML;
+  /** @type {any} */ (window).safeParseHTML = safeParseHTML;
+}
+
+function initPreview() {
+  const form = document.querySelector('#preview-form');
+  const input = /** @type {HTMLTextAreaElement | null} */ (document.querySelector('#html-input'));
+  const output = document.querySelector('#output');
+  const status = document.querySelector('#preview-status');
+
+  if (!form || !input || !output || !status) {
+    return;
+  }
+
+  let request = 0;
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const current = ++request;
+    status.textContent = 'Preparing preview…';
+    try {
+      await safeSetHTML(output, input.value);
+      if (current === request) {
+        status.textContent = 'Preview updated. Only supported formatting is shown.';
+      }
+    } catch {
+      if (current === request) {
+        output.replaceChildren();
+        status.textContent = 'The preview could not be loaded. Please try again.';
+      }
+    }
+  });
+}
+
+if (typeof document !== 'undefined') {
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initPreview);
+  } else {
+    initPreview();
+  }
+}
