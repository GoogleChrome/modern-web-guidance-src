+  <script>
+    const KEM_PUBLIC_KEY_ALGORITHMS = {
+      1184: 'ML-KEM-768',
+      1216: 'MLKEM768-X25519',
+      1568: 'ML-KEM-1024',
+    };
+    const NO_BYTES = new Uint8Array(0);
+
+    function supportsPostQuantumEnvelope() {
+      return (
+        typeof globalThis.SubtleCrypto?.supports === 'function' &&
+        SubtleCrypto.supports('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305') &&
+        SubtleCrypto.supports('decapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305')
+      );
+    }
+
+    async function generateRecipientKeys() {
+      if (supportsPostQuantumEnvelope()) {
+        const keyPair = await crypto.subtle.generateKey(
+          'MLKEM768-X25519',
+          false,
+          ['encapsulateKey', 'decapsulateKey']
+        );
+        const publicKeyBytes = new Uint8Array(
+          await crypto.subtle.exportKey('raw-public', keyPair.publicKey)
+        );
+        return {
+          suite: 'MLKEM768-X25519+ChaCha20-Poly1305',
+          keyFormat: 'raw-public',
+          keyPair,
+          publicKeyBytes,
+        };
+      }
+      const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+      const publicKeyBytes = new Uint8Array(
+        await crypto.subtle.exportKey('raw', keyPair.publicKey)
+      );
+      return {
+        suite: 'X25519+HKDF+AES-GCM',
+        keyFormat: 'raw',
+        keyPair,
+        publicKeyBytes,
+      };
+    }
+
+    async function deriveFallbackAesKey(privateKey, peerPublicKey, infoBytes = NO_BYTES) {
+      const sharedSecret = await crypto.subtle.deriveBits(
+        { name: 'X25519', public: peerPublicKey },
+        privateKey,
+        256
+      );
+      const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+      return crypto.subtle.deriveKey(
+        {
+          name: 'HKDF',
+          hash: 'SHA-256',
+          salt: new Uint8Array(32),
+          info: infoBytes,
+        },
+        hkdfKey,
+        { name: 'AES-GCM', length: 256 },
+        false,
+        ['encrypt', 'decrypt']
+      );
+    }
+
+    async function encapsulateEnvelopeKey(recipientPublicKeyOrBytes, infoBytes = NO_BYTES) {
+      const pubKey =
+        recipientPublicKeyOrBytes instanceof CryptoKey
+          ? recipientPublicKeyOrBytes
+          : await (() => {
+              const bytes =
+                recipientPublicKeyOrBytes instanceof Uint8Array
+                  ? recipientPublicKeyOrBytes
+                  : new Uint8Array(recipientPublicKeyOrBytes);
+              const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+              return kemName
+                ? crypto.subtle.importKey('raw-public', bytes, kemName, true, ['encapsulateKey'])
+                : crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+            })();
+
+      if (pubKey.algorithm.name !== 'X25519') {
+        const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+          pubKey.algorithm.name,
+          pubKey,
+          'ChaCha20-Poly1305',
+          false,
+          ['encrypt', 'decrypt']
+        );
+        return { sharedKey, capsuleBytes: new Uint8Array(ciphertext) };
+      }
+
+      const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+      const capsuleBytes = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+      const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+      return { sharedKey, capsuleBytes };
+    }
+
+    async function decapsulateEnvelopeKey(recipientPrivateKey, capsuleBytes, infoBytes = NO_BYTES) {
+      if (recipientPrivateKey.algorithm.name !== 'X25519') {
+        return crypto.subtle.decapsulateKey(
+          recipientPrivateKey.algorithm.name,
+          recipientPrivateKey,
+          capsuleBytes,
+          'ChaCha20-Poly1305',
+          false,
+          ['encrypt', 'decrypt']
+        );
+      }
+
+      const ephemeralPubKey = await crypto.subtle.importKey('raw', capsuleBytes, 'X25519', true, []);
+      return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+    }
+
+    async function encryptMessage(key, plaintext, additionalData = NO_BYTES) {
+      const iv = crypto.getRandomValues(new Uint8Array(12));
+      const buf = await crypto.subtle.encrypt(
+        { name: key.algorithm.name, iv, additionalData },
+        key,
+        new TextEncoder().encode(plaintext)
+      );
+      return { iv, ciphertext: new Uint8Array(buf) };
+    }
+
+    async function decryptMessage(key, iv, ciphertext, additionalData = NO_BYTES) {
+      const buf = await crypto.subtle.decrypt(
+        { name: key.algorithm.name, iv, additionalData },
+        key,
+        ciphertext
+      );
+      return new TextDecoder().decode(buf);
+    }
+
+    const hex = (b) => Array.from(b, (x) => x.toString(16).padStart(2, '0')).join('');
+    const $ = (id) => document.getElementById(id);
+
+    async function runFlow() {
+      const errEl = $('out-error');
+      if (errEl) errEl.textContent = '';
+      try {
+        const aad = new TextEncoder().encode('order-note-v1');
+        const { suite, keyPair, publicKeyBytes } = await generateRecipientKeys();
+        const privateKey = keyPair.privateKey;
+        const { sharedKey, capsuleBytes } = await encapsulateEnvelopeKey(publicKeyBytes);
+        const inputEl = $('note-input');
+        const text = inputEl ? inputEl.value : 'Extra hot, no foam, name: Alex';
+        const { iv, ciphertext } = await encryptMessage(sharedKey, text, aad);
+        const recipientKey = await decapsulateEnvelopeKey(privateKey, capsuleBytes);
+        const plain = await decryptMessage(recipientKey, iv, ciphertext, aad);
+        if ($('out-suite')) $('out-suite').textContent = suite;
+        if ($('out-capsule-len')) $('out-capsule-len').textContent = String(capsuleBytes.byteLength);
+        if ($('out-capsule')) $('out-capsule').textContent = hex(capsuleBytes);
+        if ($('out-iv')) $('out-iv').textContent = hex(iv);
+        if ($('out-cipher')) $('out-cipher').textContent = hex(ciphertext);
+        if ($('out-plain')) $('out-plain').textContent = plain;
+        return { suite, capsuleBytes, iv, ciphertext, plain };
+      } catch (e) {
+        if ($('out-error')) $('out-error').textContent = 'Encryption failed: ' + e.message;
+        throw e;
+      }
+    }
+
+    window.supportsPostQuantumEnvelope = supportsPostQuantumEnvelope;
+    window.generateRecipientKeys = generateRecipientKeys;
+    window.deriveFallbackAesKey = deriveFallbackAesKey;
+    window.encapsulateEnvelopeKey = encapsulateEnvelopeKey;
+    window.decapsulateEnvelopeKey = decapsulateEnvelopeKey;
+    window.encryptMessage = encryptMessage;
+    window.decryptMessage = decryptMessage;
+    window.runFlow = runFlow;
+
+    const btn = $('encrypt-btn');
+    if (btn) {
+      btn.addEventListener('click', () => {
+        runFlow().catch(console.error);
+      });
+    }
+
+    runFlow().catch(console.error);
+  </script>
