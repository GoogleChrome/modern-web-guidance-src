+++ b/src/main.ts
@@ -0,0 +1,74 @@
+import { decryptEnvelope, encryptEnvelope, loadRecipient, parseEnvelope, toBase64, type Recipient } from './encryption';
+
+function element<T extends HTMLElement>(id: string, type: { new(): T }): T {
+  const value = document.getElementById(id);
+  if (!(value instanceof type)) throw new Error(`Missing UI element: ${id}`);
+  return value;
+}
+const encryptButton = element('encrypt-message', HTMLButtonElement);
+const decryptButton = element('decrypt-message', HTMLButtonElement);
+const plaintext = element('plaintext', HTMLTextAreaElement);
+const envelope = element('envelope', HTMLTextAreaElement);
+const publicKey = element('public-key', HTMLTextAreaElement);
+const recovered = element('recovered-message', HTMLOutputElement);
+const status = element('crypto-status', HTMLParagraphElement);
+const suite = element('crypto-suite', HTMLParagraphElement);
+let recipient: Recipient | undefined;
+let busy = false;
+
+function report(message: string, error = false): void {
+  status.textContent = message;
+  status.dataset.error = String(error);
+}
+function updateButtons(): void {
+  encryptButton.disabled = busy || !recipient;
+  decryptButton.disabled = busy || !recipient || !envelope.value.trim();
+}
+async function operate(operation: () => Promise<void>): Promise<void> {
+  busy = true;
+  recovered.textContent = '';
+  report('Working…');
+  updateButtons();
+  try {
+    await operation();
+  } catch (error) {
+    const message = error instanceof Error && error.name === 'OperationError'
+      ? 'Authentication failed. The envelope was changed or belongs to a different recipient.'
+      : error instanceof Error ? error.message : 'Encryption could not complete.';
+    report(message, true);
+  } finally {
+    busy = false;
+    updateButtons();
+  }
+}
+encryptButton.addEventListener('click', () => {
+  if (!recipient || busy) return;
+  const target = recipient;
+  void operate(async () => {
+    envelope.value = '';
+    envelope.value = JSON.stringify(await encryptEnvelope(target, plaintext.value), null, 2);
+    report('Message encrypted with a fresh key and 12-byte IV. Select Decrypt message to recover it.');
+  });
+});
+decryptButton.addEventListener('click', () => {
+  if (!recipient || busy) return;
+  const target = recipient;
+  void operate(async () => {
+    recovered.textContent = await decryptEnvelope(target, parseEnvelope(envelope.value));
+    report('Message decrypted and authenticated successfully.');
+  });
+});
+envelope.addEventListener('input', () => { recovered.textContent = ''; updateButtons(); });
+
+void (async () => {
+  try {
+    recipient = await loadRecipient();
+    suite.textContent = `Encryption: ${recipient.suite}${recipient.suite.startsWith('MLKEM') ? ' (hybrid post-quantum)' : ' (classical fallback; post-quantum WebCrypto unavailable)'}.`;
+    publicKey.value = toBase64(recipient.publicKeyBytes);
+    report('Ready. Your recipient keys are saved on this device for future sessions.');
+    updateButtons();
+  } catch (error) {
+    suite.textContent = 'Encryption unavailable.';
+    report(error instanceof Error ? error.message : 'Unable to initialize browser encryption.', true);
+  }
+})();
diff --git a/tests/browser-check.ts b/tests/browser-check.ts
new file mode 100644
index 0000000..6007a19
--- /dev/null
+++ b/tests/browser-check.ts
@@ -0,0 +1,41 @@
+import assert from 'node:assert/strict';
+import { chromium } from 'playwright';
+import { createServer } from 'vite';
+
+const server = await createServer({ server: { host: '127.0.0.1', port: 11223 } });
+await server.listen();
+const browser = await chromium.launch({ headless: true, executablePath: process.env.CHROMIUM_EXECUTABLE_PATH });
+try {
+  const page = await browser.newPage();
+  const errors: string[] = [];
+  page.on('pageerror', error => errors.push(error.message));
+  await page.goto('http://127.0.0.1:11223');
+  await page.waitForFunction(() => !document.querySelector<HTMLButtonElement>('#encrypt-message')?.disabled);
+  const plaintext = 'My coffee note ☕ <script>alert(1)</script>';
+  await page.locator('#plaintext').fill(plaintext);
+  await page.locator('#encrypt-message').click();
+  await page.waitForFunction(() => !document.querySelector<HTMLButtonElement>('#decrypt-message')?.disabled);
+  const envelope = await page.locator('#envelope').inputValue();
+  const publicKey = await page.locator('#public-key').inputValue();
+  await page.locator('#decrypt-message').click();
+  await page.waitForFunction(() => document.querySelector('#crypto-status')?.textContent?.includes('successfully'));
+  assert.equal(await page.locator('#recovered-message').textContent(), plaintext);
+  await page.reload();
+  await page.waitForFunction(() => !document.querySelector<HTMLButtonElement>('#encrypt-message')?.disabled);
+  assert.equal(await page.locator('#public-key').inputValue(), publicKey);
+  await page.locator('#envelope').fill(envelope);
+  await page.locator('#decrypt-message').click();
+  await page.waitForFunction(() => document.querySelector('#crypto-status')?.textContent?.includes('successfully'));
+  assert.equal(await page.locator('#recovered-message').textContent(), plaintext);
+  const modified = JSON.parse(envelope) as { ciphertext: string };
+  modified.ciphertext = (modified.ciphertext[0] === 'A' ? 'B' : 'A') + modified.ciphertext.slice(1);
+  await page.locator('#envelope').fill(JSON.stringify(modified));
+  await page.locator('#decrypt-message').click();
+  await page.waitForFunction(() => document.querySelector('#crypto-status')?.textContent?.includes('Authentication failed'));
+  assert.equal(await page.locator('#recovered-message').textContent(), '');
+  assert.deepEqual(errors, []);
+  console.log('Browser verification passed: plaintext recovery, IndexedDB reload, and tamper rejection.');
+} finally {
+  await browser.close();
+  await server.close();
+}
diff --git a/tests/encryption.test.ts b/tests/encryption.test.ts
new file mode 100644
index 0000000..ff646af
--- /dev/null
+++ b/tests/encryption.test.ts
@@ -0,0 +1,142 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { webcrypto } from 'node:crypto';
+import { indexedDB } from 'fake-indexeddb';
+import { decryptEnvelope, encryptEnvelope, generateRecipientKeys, loadRecipient, parseEnvelope, supportsPostQuantumEnvelope, type ModernSubtle } from '../src/encryption';
+
+Object.defineProperty(globalThis, 'crypto', { value: webcrypto, configurable: true });
+Object.defineProperty(globalThis, 'SubtleCrypto', { value: webcrypto.subtle.constructor, configurable: true });
+Object.defineProperty(globalThis, 'indexedDB', { value: indexedDB, configurable: true });
+
+test('classical envelopes recover Unicode and empty messages with fresh IVs and capsules', async () => {
+  assert.equal(supportsPostQuantumEnvelope(), false);
+  const recipient = await generateRecipientKeys();
+  assert.equal(recipient.keyPair.privateKey.extractable, false);
+  const plaintext = 'Oat latte ☕ — café\n<script>alert(1)</script>';
+  const first = await encryptEnvelope(recipient, plaintext);
+  const second = await encryptEnvelope(recipient, plaintext);
+  assert.equal(Buffer.from(first.iv, 'base64').length, 12);
+  assert.notEqual(first.iv, second.iv);
+  assert.notEqual(first.capsule, second.capsule);
+  assert.equal(await decryptEnvelope(recipient, parseEnvelope(JSON.stringify(first))), plaintext);
+  assert.equal(await decryptEnvelope(recipient, await encryptEnvelope(recipient, '')), '');
+  const clonedRecipient = structuredClone(recipient);
+  assert.equal(await decryptEnvelope(clonedRecipient, first), plaintext);
+});
+
+test('tampering, wrong recipients, and malformed envelopes are rejected', async () => {
+  const recipient = await generateRecipientKeys();
+  const envelope = await encryptEnvelope(recipient, 'Private coffee order');
+  for (const field of ['ciphertext', 'capsule', 'iv'] as const) {
+    const bytes = Buffer.from(envelope[field], 'base64');
+    bytes[0] = bytes[0]! ^ 1;
+    await assert.rejects(decryptEnvelope(recipient, { ...envelope, [field]: bytes.toString('base64') }));
+  }
+  await assert.rejects(decryptEnvelope(await generateRecipientKeys(), envelope));
+  await assert.rejects(decryptEnvelope(recipient, { ...envelope, iv: 'bad!' }));
+  await assert.rejects(decryptEnvelope(recipient, { ...envelope, version: 2 } as unknown as typeof envelope));
+  assert.throws(() => parseEnvelope('{"version":1,"suite":"unknown"}'));
+});
+
+test('P-256 fallback when X25519 is unavailable', async () => {
+  const original = crypto.subtle.generateKey.bind(crypto.subtle);
+  const generate = crypto.subtle.generateKey;
+  crypto.subtle.generateKey = (async (...args: Parameters<SubtleCrypto['generateKey']>) => {
+    if (args[0] === 'X25519') throw new DOMException('Unsupported', 'NotSupportedError');
+    return original(...args);
+  }) as SubtleCrypto['generateKey'];
+  try {
+    const recipient = await generateRecipientKeys();
+    assert.equal(recipient.suite, 'P-256+HKDF+AES-GCM');
+    assert.equal(await decryptEnvelope(recipient, await encryptEnvelope(recipient, 'P-256 coffee')), 'P-256 coffee');
+  } finally {
+    crypto.subtle.generateKey = generate;
+  }
+});
+
+test('recipient survives IndexedDB structured cloning and reload', async () => {
+  const original = await loadRecipient();
+  const envelope = await encryptEnvelope(original, 'Saved recipient');
+  const reloaded = await loadRecipient();
+  assert.deepEqual(reloaded.publicKeyBytes, original.publicKeyBytes);
+  assert.equal(reloaded.keyPair.privateKey.extractable, false);
+  assert.equal(await decryptEnvelope(reloaded, envelope), 'Saved recipient');
+});
+
+test('hybrid API contracts: static probe, explicit formats, KEM usages, and ChaCha20 round trip', async () => {
+  // Node supports ML-KEM-768 but not the hybrid. Adapt only the KEM name and
+  // capsule size to exercise the hybrid application branch with real crypto.
+  const native = crypto.subtle as unknown as ModernSubtle;
+  const calls: string[] = [];
+  const adapter: ModernSubtle = {
+    async generateKey(algorithm, extractable, usages) {
+      assert.equal(algorithm, 'MLKEM768-X25519');
+      assert.equal(extractable, false);
+      assert.deepEqual(usages, ['encapsulateKey', 'decapsulateKey']);
+      calls.push('generate');
+      return native.generateKey('ML-KEM-768', extractable, usages);
+    },
+    async exportKey(format, key) {
+      assert.equal(format, 'raw-public');
+      calls.push('export');
+      return native.exportKey(format, key);
+    },
+    async importKey(format, bytes, algorithm, extractable, usages) {
+      assert.equal(format, 'raw-public');
+      assert.equal(algorithm, 'MLKEM768-X25519');
+      assert.deepEqual(usages, ['encapsulateKey']);
+      calls.push('import');
+      return native.importKey(format, bytes, 'ML-KEM-768', extractable, usages);
+    },
+    async encapsulateKey(algorithm, key, sharedAlgorithm, extractable, usages) {
+      assert.equal(algorithm, 'MLKEM768-X25519');
+      assert.equal(sharedAlgorithm, 'ChaCha20-Poly1305');
+      assert.equal(extractable, false);
+      assert.deepEqual(usages, ['encrypt', 'decrypt']);
+      calls.push('encapsulate');
+      const result = await native.encapsulateKey('ML-KEM-768', key, sharedAlgorithm, extractable, usages);
+      const capsule = new Uint8Array(1120);
+      capsule.set(new Uint8Array(result.ciphertext));
+      return { sharedKey: result.sharedKey, ciphertext: capsule.buffer };
+    },
+    async decapsulateKey(algorithm, key, capsule, sharedAlgorithm, extractable, usages) {
+      assert.equal(algorithm, 'MLKEM768-X25519');
+      assert.equal(sharedAlgorithm, 'ChaCha20-Poly1305');
+      assert.equal(extractable, false);
+      assert.deepEqual(usages, ['encrypt', 'decrypt']);
+      calls.push('decapsulate');
+      assert.ok(capsule instanceof Uint8Array);
+      return native.decapsulateKey('ML-KEM-768', key, capsule.slice(0, 1088), sharedAlgorithm, extractable, usages);
+    },
+  };
+  Object.defineProperty(globalThis, 'SubtleCrypto', { configurable: true, value: {
+    supports(operation: string, algorithm: string, sharedAlgorithm: string) {
+      assert.ok(['encapsulateKey', 'decapsulateKey'].includes(operation));
+      assert.equal(algorithm, 'MLKEM768-X25519');
+      assert.equal(sharedAlgorithm, 'ChaCha20-Poly1305');
+      calls.push('supports');
+      return true;
+    },
+  } });
+  const subtle = new Proxy(crypto.subtle, {
+    get(target, property) {
+      if (property in adapter) return adapter[property as keyof ModernSubtle];
+      const value: unknown = Reflect.get(target, property);
+      return typeof value === 'function' ? value.bind(target) : value;
+    },
+  });
+  Object.defineProperty(globalThis, 'crypto', { configurable: true, value: { subtle, getRandomValues: webcrypto.getRandomValues.bind(webcrypto) } });
+  try {
+    const recipient = await generateRecipientKeys();
+    assert.equal(recipient.suite, 'MLKEM768-X25519+ChaCha20-Poly1305');
+    const envelope = await encryptEnvelope(recipient, 'Post-quantum coffee ☕');
+    assert.equal(await decryptEnvelope(recipient, envelope), 'Post-quantum coffee ☕');
+    const tampered = Buffer.from(envelope.ciphertext, 'base64');
+    tampered[0] = tampered[0]! ^ 1;
+    await assert.rejects(decryptEnvelope(recipient, { ...envelope, ciphertext: tampered.toString('base64') }));
+    for (const operation of ['supports', 'generate', 'export', 'import', 'encapsulate', 'decapsulate']) assert.ok(calls.includes(operation));
+  } finally {
+    Object.defineProperty(globalThis, 'crypto', { value: webcrypto, configurable: true });
+    Object.defineProperty(globalThis, 'SubtleCrypto', { value: webcrypto.subtle.constructor, configurable: true });
+  }
+});
