index 0000000..93f043e
--- /dev/null
+++ b/src/encryption.ts
@@ -0,0 +1,170 @@
+const KEM = 'MLKEM768-X25519';
+export type Suite = 'MLKEM768-X25519+ChaCha20-Poly1305' | 'X25519+HKDF+AES-GCM' | 'P-256+HKDF+AES-GCM';
+export interface Recipient {
+  suite: Suite;
+  keyPair: CryptoKeyPair;
+  publicKeyBytes: Uint8Array<ArrayBuffer>;
+}
+export interface Envelope {
+  version: 1;
+  suite: Suite;
+  capsule: string;
+  iv: string;
+  ciphertext: string;
+}
+// Isolate the modern API declarations until they are included in lib.dom.
+export interface ModernSubtle {
+  generateKey(algorithm: string, extractable: boolean, usages: string[]): Promise<CryptoKeyPair>;
+  exportKey(format: 'raw-public', key: CryptoKey): Promise<ArrayBuffer>;
+  importKey(format: 'raw-public', bytes: BufferSource, algorithm: string, extractable: boolean, usages: string[]): Promise<CryptoKey>;
+  encapsulateKey(algorithm: string, publicKey: CryptoKey, sharedAlgorithm: string, extractable: boolean, usages: KeyUsage[]): Promise<{ sharedKey: CryptoKey; ciphertext: ArrayBuffer }>;
+  decapsulateKey(algorithm: string, privateKey: CryptoKey, capsule: BufferSource, sharedAlgorithm: string, extractable: boolean, usages: KeyUsage[]): Promise<CryptoKey>;
+}
+type SupportConstructor = { supports?: (operation: string, algorithm: string, sharedAlgorithm: string) => boolean };
+const modern = () => crypto.subtle as unknown as ModernSubtle;
+const encoder = new TextEncoder();
+const isSuite = (value: unknown): value is Suite => value === 'MLKEM768-X25519+ChaCha20-Poly1305' || value === 'X25519+HKDF+AES-GCM' || value === 'P-256+HKDF+AES-GCM';
+function requireKeyPair(key: CryptoKeyPair | CryptoKey): CryptoKeyPair {
+  if (!('privateKey' in key) || !('publicKey' in key)) throw new Error('Expected an asymmetric key pair.');
+  return key;
+}
+
+export function supportsPostQuantumEnvelope(): boolean {
+  const constructor = globalThis.SubtleCrypto as unknown as SupportConstructor | undefined;
+  try {
+    return typeof constructor?.supports === 'function' &&
+      constructor.supports('encapsulateKey', KEM, 'ChaCha20-Poly1305') &&
+      constructor.supports('decapsulateKey', KEM, 'ChaCha20-Poly1305') &&
+      typeof modern().encapsulateKey === 'function' && typeof modern().decapsulateKey === 'function';
+  } catch {
+    return false;
+  }
+}
+
+export async function generateRecipientKeys(): Promise<Recipient> {
+  if (!globalThis.crypto?.subtle) throw new Error('Encryption requires a secure context (HTTPS or localhost).');
+  if (supportsPostQuantumEnvelope()) {
+    const keyPair = await modern().generateKey(KEM, false, ['encapsulateKey', 'decapsulateKey']);
+    return { suite: 'MLKEM768-X25519+ChaCha20-Poly1305', keyPair,
+      publicKeyBytes: new Uint8Array(await modern().exportKey('raw-public', keyPair.publicKey)) };
+  }
+  try {
+    const keyPair = requireKeyPair(await crypto.subtle.generateKey('X25519', false, ['deriveBits']));
+    return { suite: 'X25519+HKDF+AES-GCM', keyPair,
+      publicKeyBytes: new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey)) };
+  } catch (error) {
+    if (!(error instanceof Error) || error.name !== 'NotSupportedError') throw error;
+    const keyPair = await crypto.subtle.generateKey({ name: 'ECDH', namedCurve: 'P-256' }, false, ['deriveBits']);
+    return { suite: 'P-256+HKDF+AES-GCM', keyPair,
+      publicKeyBytes: new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey)) };
+  }
+}
+
+function agreement(suite: Suite): AlgorithmIdentifier | EcKeyImportParams {
+  return suite === 'P-256+HKDF+AES-GCM' ? { name: 'ECDH', namedCurve: 'P-256' } : 'X25519';
+}
+function context(suite: Suite): Uint8Array<ArrayBuffer> {
+  return new Uint8Array(encoder.encode(JSON.stringify({ version: 1, suite, purpose: 'daily-grind-private-message' })));
+}
+async function deriveKey(privateKey: CryptoKey, publicKey: CryptoKey, suite: Suite): Promise<CryptoKey> {
+  const secret = await crypto.subtle.deriveBits({ name: privateKey.algorithm.name, public: publicKey }, privateKey, 256);
+  const baseKey = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+  new Uint8Array(secret).fill(0);
+  return crypto.subtle.deriveKey({ name: 'HKDF', hash: 'SHA-256', salt: new Uint8Array(32), info: context(suite) },
+    baseKey, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']);
+}
+
+export function toBase64(bytes: Uint8Array): string {
+  let binary = '';
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary);
+}
+function fromBase64(value: string): Uint8Array<ArrayBuffer> {
+  if (!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value)) throw new Error('Invalid Base64 in envelope.');
+  return Uint8Array.from(atob(value), character => character.charCodeAt(0));
+}
+
+export async function encryptEnvelope(recipient: Recipient, plaintext: string): Promise<Envelope> {
+  let sharedKey: CryptoKey;
+  let capsule: Uint8Array<ArrayBuffer>;
+  if (recipient.suite === 'MLKEM768-X25519+ChaCha20-Poly1305') {
+    const publicKey = await modern().importKey('raw-public', recipient.publicKeyBytes, KEM, true, ['encapsulateKey']);
+    const result = await modern().encapsulateKey(KEM, publicKey, 'ChaCha20-Poly1305', false, ['encrypt', 'decrypt']);
+    sharedKey = result.sharedKey;
+    capsule = new Uint8Array(result.ciphertext);
+  } else {
+    const algorithm = agreement(recipient.suite);
+    const publicKey = await crypto.subtle.importKey('raw', recipient.publicKeyBytes, algorithm, true, []);
+    const ephemeral = requireKeyPair(await crypto.subtle.generateKey(algorithm, false, ['deriveBits']));
+    capsule = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+    sharedKey = await deriveKey(ephemeral.privateKey, publicKey, recipient.suite);
+  }
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const ciphertext = await crypto.subtle.encrypt({ name: sharedKey.algorithm.name, iv, additionalData: context(recipient.suite) }, sharedKey, encoder.encode(plaintext));
+  return { version: 1, suite: recipient.suite, capsule: toBase64(capsule), iv: toBase64(iv), ciphertext: toBase64(new Uint8Array(ciphertext)) };
+}
+
+export function parseEnvelope(json: string): Envelope {
+  const value: unknown = JSON.parse(json);
+  if (typeof value !== 'object' || value === null) throw new Error('Invalid envelope.');
+  const fields = value as Record<string, unknown>;
+  if (fields.version !== 1 || !isSuite(fields.suite) || typeof fields.capsule !== 'string' || typeof fields.iv !== 'string' || typeof fields.ciphertext !== 'string') throw new Error('Invalid envelope version, suite, or fields.');
+  return { version: 1, suite: fields.suite, capsule: fields.capsule, iv: fields.iv, ciphertext: fields.ciphertext };
+}
+
+export async function decryptEnvelope(recipient: Recipient, envelope: Envelope): Promise<string> {
+  if (envelope.version !== 1 || envelope.suite !== recipient.suite) throw new Error('Envelope does not match this recipient’s encryption suite.');
+  const capsule = fromBase64(envelope.capsule);
+  const iv = fromBase64(envelope.iv);
+  const ciphertext = fromBase64(envelope.ciphertext);
+  const capsuleLength = recipient.suite === 'MLKEM768-X25519+ChaCha20-Poly1305' ? 1120 : recipient.suite === 'P-256+HKDF+AES-GCM' ? 65 : 32;
+  if (iv.length !== 12 || capsule.length !== capsuleLength || ciphertext.length < 16) throw new Error('Invalid envelope lengths.');
+  let sharedKey: CryptoKey;
+  if (recipient.suite === 'MLKEM768-X25519+ChaCha20-Poly1305') {
+    sharedKey = await modern().decapsulateKey(KEM, recipient.keyPair.privateKey, capsule, 'ChaCha20-Poly1305', false, ['encrypt', 'decrypt']);
+  } else {
+    const publicKey = await crypto.subtle.importKey('raw', capsule, agreement(recipient.suite), true, []);
+    sharedKey = await deriveKey(recipient.keyPair.privateKey, publicKey, recipient.suite);
+  }
+  const plaintext = await crypto.subtle.decrypt({ name: sharedKey.algorithm.name, iv, additionalData: context(envelope.suite) }, sharedKey, ciphertext);
+  return new TextDecoder('utf-8', { fatal: true }).decode(plaintext);
+}
+
+export async function loadRecipient(): Promise<Recipient> {
+  const database = await new Promise<IDBDatabase>((resolve, reject) => {
+    const request = indexedDB.open('daily-grind-encryption', 1);
+    request.onupgradeneeded = () => request.result.createObjectStore('keys');
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+    request.onblocked = () => reject(new Error('Recipient storage is blocked by another tab.'));
+  });
+  try {
+    const saved: unknown = await new Promise((resolve, reject) => {
+      const request = database.transaction('keys').objectStore('keys').get('recipient-kem-key');
+      request.onsuccess = () => resolve(request.result);
+      request.onerror = () => reject(request.error);
+    });
+    if (saved !== undefined) {
+      const recipient = saved as Recipient;
+      if (!isSuite(recipient.suite) || !(recipient.keyPair?.privateKey instanceof CryptoKey) || recipient.keyPair.privateKey.extractable || !(recipient.publicKeyBytes instanceof Uint8Array)) throw new Error('Stored recipient keys are invalid.');
+      if (recipient.suite === 'MLKEM768-X25519+ChaCha20-Poly1305' && !supportsPostQuantumEnvelope()) throw new Error('This browser cannot use the saved post-quantum recipient keys. Open this page in a compatible browser.');
+      return recipient;
+    }
+    const recipient = await generateRecipientKeys();
+    try {
+      await new Promise<void>((resolve, reject) => {
+        // Add prevents concurrent tabs from overwriting a recipient identity.
+        const transaction = database.transaction('keys', 'readwrite');
+        transaction.objectStore('keys').add(recipient, 'recipient-kem-key');
+        transaction.oncomplete = () => resolve();
+        transaction.onabort = () => reject(transaction.error);
+      });
+    } catch (error) {
+      if (error instanceof Error && error.name === 'ConstraintError') return await loadRecipient();
+      throw error;
+    }
+    return recipient;
+  } finally {
+    database.close();
+  }
+}
