+import { createHash } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { decodeSdJwtSync, SDJwtInstance, type Hasher } from '@sd-jwt/core';
+import {
+  createLocalJWKSet,
+  createRemoteJWKSet,
+  importJWK,
+  jwtVerify,
+  type JWK,
+  type JWTVerifyOptions,
+} from 'jose';
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// 'EdDSA' is included for compatibility with live issuers and Chrome Origin Trial builds.
+export const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+export const normalizeAlg = (alg: string): string => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+export interface VerifyEmailVerificationTokenParams {
+  rawToken: string;
+  submittedEmail: string;
+  expectedNonce: string;
+  expectedAudience: string;
+  dnsResolver?: (domain: string) => Promise<string[][]>;
+  fetchFn?: typeof fetch;
+  allowedAlgs?: string[];
+  maxTokenAge?: string;
+  clockTolerance?: string;
+  keyBindingMaxAgeSeconds?: number;
+  skewSeconds?: number;
+}
+
+export interface VerifiedEmailResult {
+  email: string;
+  email_verified: boolean;
+  issuer: string;
+  payload: Record<string, unknown>;
+  [key: string]: unknown;
+}
+
+/**
+ * Validates an Email Verification Token (SD-JWT with Key Binding JWT) on the server.
+ */
+export async function verifyEmailVerificationToken(
+  params: VerifyEmailVerificationTokenParams
+): Promise<VerifiedEmailResult> {
+  const {
+    rawToken,
+    submittedEmail,
+    expectedNonce,
+    expectedAudience,
+    dnsResolver,
+    fetchFn = fetch,
+    allowedAlgs = ALLOWED_ALGS,
+    maxTokenAge = '5m',
+    clockTolerance = '1m',
+    keyBindingMaxAgeSeconds = 300,
+    skewSeconds = 60,
+  } = params;
+
+  if (!submittedEmail || typeof submittedEmail !== 'string') {
+    throw new Error('Submitted email is required.');
+  }
+  if (!expectedNonce || typeof expectedNonce !== 'string') {
+    throw new Error('Expected nonce is required.');
+  }
+  if (!expectedAudience || typeof expectedAudience !== 'string') {
+    throw new Error('Expected audience is required.');
+  }
+  if (!rawToken || typeof rawToken !== 'string') {
+    throw new Error('Verification token is required.');
+  }
+
+  const hasher = (data: string | ArrayBuffer, alg: string): Uint8Array => {
+    const buf = typeof data === 'string' ? Buffer.from(data, 'utf-8') : Buffer.from(data);
+    return createHash(alg === 'sha-256' ? 'sha256' : alg).update(buf).digest();
+  };
+
+  // Step 1: Parse the SD-JWT claims and validate the email address
+  let decoded: ReturnType<typeof decodeSdJwtSync>;
+  try {
+    decoded = decodeSdJwtSync(rawToken, hasher);
+  } catch (err: any) {
+    throw new Error(`Failed to decode SD-JWT: ${err.message}`);
+  }
+
+  if (!decoded || !decoded.jwt) {
+    throw new Error('Invalid SD-JWT: missing issuer JWT.');
+  }
+
+  const evtPayload = decoded.jwt.payload as Record<string, any>;
+  const iss = evtPayload?.iss;
+
+  // Expectation 8: Reject presentations where KB-JWT is missing
+  if (!decoded.kbJwt) {
+    throw new Error('Missing Key Binding JWT (KB-JWT).');
+  }
+
+  if (!iss || typeof iss !== 'string') {
+    throw new Error('Missing issuer (iss) in EVT payload.');
+  }
+
+  if (evtPayload.email_verified !== true) {
+    throw new Error('EVT payload email_verified claim must be true.');
+  }
+
+  // Expectation 5: Case-insensitive email comparison
+  const evtEmail = evtPayload.email;
+  if (!evtEmail || typeof evtEmail !== 'string') {
+    throw new Error('Missing email claim in EVT payload.');
+  }
+  if (evtEmail.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation and load the issuer JWKS
+  const domain = submittedEmail.split('@')[1];
+  if (!domain) {
+    throw new Error(`Invalid email address "${submittedEmail}": missing domain.`);
+  }
+
+  const resolveTxtFn = dnsResolver ?? dns.resolveTxt;
+  let txtRecordsRaw: string[][];
+  try {
+    txtRecordsRaw = await resolveTxtFn(`_email-verification.${domain.toLowerCase()}`);
+  } catch (err: any) {
+    throw new Error(`DNS resolution failed for _email-verification.${domain}: ${err.message}`);
+  }
+
+  const txtRecords = txtRecordsRaw.map((r) => r.join(''));
+  // Expectation 6: Confirm derived https://<issuer-host> origin matches iss byte-for-byte
+  const matchesTxt = txtRecords.some(
+    (txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss
+  );
+  if (!matchesTxt) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') {
+    throw new Error('Issuer must use HTTPS.');
+  }
+
+  const discoResponse = await fetchFn(discoveryUrl);
+  if (!discoResponse.ok) {
+    throw new Error(`Failed to fetch issuer metadata from ${discoveryUrl}: ${discoResponse.status}`);
+  }
+  const metadata = (await discoResponse.json()) as {
+    issuer?: string;
+    jwks_uri?: string;
+    jwks?: { keys: JWK[] };
+  };
+
+  // Expectation 6: Confirm metadata.issuer === iss byte-for-byte
+  if (metadata.issuer !== iss) {
+    throw new Error(`Metadata issuer "${metadata.issuer}" does not match token issuer "${iss}".`);
+  }
+  if (!metadata.jwks_uri || typeof metadata.jwks_uri !== 'string' || !metadata.jwks_uri.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata: jwks_uri must start with https://');
+  }
+
+  // Load the issuer JWKS
+  let issuerJwks: any;
+  let rawJwksKeys: JWK[] = [];
+
+  if (metadata.jwks?.keys) {
+    rawJwksKeys = metadata.jwks.keys;
+    issuerJwks = createLocalJWKSet(metadata.jwks);
+  } else {
+    // Attempt fetching jwks_uri directly with fetchFn to obtain raw keys if needed for fallback iteration
+    try {
+      const jwksRes = await fetchFn(new URL(metadata.jwks_uri));
+      if (jwksRes.ok) {
+        const jwksData = (await jwksRes.json()) as { keys?: JWK[] };
+        if (jwksData?.keys) {
+          rawJwksKeys = jwksData.keys;
+          issuerJwks = createLocalJWKSet({ keys: rawJwksKeys });
+        }
+      }
+    } catch {
+      // If fetching fails or in specialized mock environment, fall back to createRemoteJWKSet
+    }
+    if (!issuerJwks) {
+      issuerJwks = createRemoteJWKSet(new URL(metadata.jwks_uri));
+    }
+  }
+
+  // Step 3: Verify the EVT signature and Key Binding JWT (KB-JWT)
+  const evtOptions: JWTVerifyOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: allowedAlgs,
+    maxTokenAge,
+    clockTolerance,
+  };
+
+  // Pre-validate KB-JWT structure and claims
+  const kbPayload = decoded.kbJwt.payload as Record<string, any>;
+  const kbHeader = decoded.kbJwt.header as Record<string, any>;
+
+  // Expectation 8: Reject mismatched nonce, audience, or alg
+  if (kbPayload.nonce !== expectedNonce) {
+    throw new Error(`Mismatched KB-JWT nonce. Expected "${expectedNonce}", got "${kbPayload.nonce}".`);
+  }
+  if (kbPayload.aud !== expectedAudience) {
+    throw new Error(`Mismatched KB-JWT audience. Expected "${expectedAudience}", got "${kbPayload.aud}".`);
+  }
+
+  const holderJwk = evtPayload.cnf?.jwk as (JWK & { alg?: string }) | undefined;
+  if (!holderJwk) {
+    throw new Error('Missing cnf.jwk holder key in EVT payload.');
+  }
+
+  const holderAlg = holderJwk.alg ? String(holderJwk.alg) : '';
+  const kbAlg = kbHeader?.alg ? String(kbHeader.alg) : '';
+
+  if (
+    !holderAlg ||
+    !kbAlg ||
+    !allowedAlgs.includes(holderAlg) ||
+    !allowedAlgs.includes(kbAlg) ||
+    normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+  ) {
+    throw new Error(
+      `Missing, disallowed, or mismatched KB-JWT algorithm. holderAlg="${holderAlg}", kbAlg="${kbAlg}".`
+    );
+  }
+
+  const headerKid = decoded.jwt.header?.kid;
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err: any) {
+        // Expectation 7: When kid is omitted and multiple keys match in the JWKS,
+        // jose throws ERR_JWKS_MULTIPLE_MATCHING_KEYS (an AsyncIterable of candidate CryptoKeys).
+        if (err?.code === 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') {
+          let matched = false;
+          for await (const publicKey of err) {
+            try {
+              await jwtVerify(compactEvt, publicKey, evtOptions);
+              matched = true;
+              break;
+            } catch {}
+          }
+          if (!matched) throw err;
+        } else if (!headerKid && rawJwksKeys.length > 0) {
+          // If kid was omitted and multiple keys exist in raw JWKS, iterate through them
+          let matched = false;
+          for (const rawKey of rawJwksKeys) {
+            try {
+              const importedKey = await importJWK(rawKey, String(rawKey.alg || decoded.jwt.header?.alg));
+              await jwtVerify(compactEvt, importedKey, evtOptions);
+              matched = true;
+              break;
+            } catch {}
+          }
+          if (!matched) throw err;
+        } else {
+          throw err;
+        }
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const currentHolderJwk = evtPayload.cnf?.jwk;
+      const currentHolderAlg = currentHolderJwk?.alg ? String(currentHolderJwk.alg) : '';
+      const currentKbAlg = decoded.kbJwt?.header?.alg ? String(decoded.kbJwt.header.alg) : '';
+
+      if (
+        !currentHolderAlg ||
+        !currentKbAlg ||
+        !allowedAlgs.includes(currentHolderAlg) ||
+        !allowedAlgs.includes(currentKbAlg) ||
+        normalizeAlg(currentKbAlg) !== normalizeAlg(currentHolderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+
+      const holderKey = await importJWK(currentHolderJwk, currentKbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [currentKbAlg],
+        maxTokenAge,
+        clockTolerance,
+      });
+      return true;
+    },
+  });
+
+  // sdJwt.verify validates disclosures, EVT signature, KB-JWT signature,
+  // and confirms nonce, aud, iat, and sd_hash in the Key Binding JWT.
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    allowedKeyBindingAlgorithms: allowedAlgs,
+    keyBindingMaxAgeSeconds,
+    skewSeconds,
+  });
+
+  return {
+    email: evtPayload.email,
+    email_verified: evtPayload.email_verified,
+    issuer: iss,
+    payload: (verified.payload as Record<string, unknown>) || evtPayload,
+  };
+}
