@@ -0,0 +1,248 @@
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { randomUUID } from 'node:crypto';
+import { sessionStore } from './session.js';
+import { handleSignupSubmission, type SubmissionResult } from './submission.js';
+
+export const PORT = Number(process.env.PORT || 11222);
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+function getIndexHtmlPath(): string {
+  const possiblePaths = [
+    path.resolve(process.cwd(), 'index.html'),
+    path.resolve(__dirname, '../index.html'),
+    path.resolve(__dirname, 'index.html'),
+  ];
+  for (const p of possiblePaths) {
+    if (fs.existsSync(p)) return p;
+  }
+  return path.resolve(process.cwd(), 'index.html');
+}
+
+function parseCookies(header?: string | string[]): Record<string, string> {
+  const cookies: Record<string, string> = {};
+  if (!header) return cookies;
+  const cookieStr = Array.isArray(header) ? header.join('; ') : header;
+  const pairs = cookieStr.split(';');
+  for (const pair of pairs) {
+    const idx = pair.indexOf('=');
+    if (idx !== -1) {
+      const key = pair.slice(0, idx).trim();
+      const val = pair.slice(idx + 1).trim();
+      cookies[key] = decodeURIComponent(val);
+    }
+  }
+  return cookies;
+}
+
+export async function parseBody(req: http.IncomingMessage): Promise<Record<string, string>> {
+  return new Promise((resolve, reject) => {
+    let body = '';
+    req.on('data', (chunk: Buffer | string) => {
+      body += chunk.toString();
+      // 1MB max body limit
+      if (body.length > 1e6) {
+        req.destroy();
+        reject(new Error('Payload too large'));
+      }
+    });
+    req.on('end', () => {
+      const contentType = req.headers['content-type'] || '';
+      if (contentType.includes('application/json')) {
+        try {
+          resolve(JSON.parse(body || '{}'));
+        } catch {
+          resolve({});
+        }
+      } else {
+        // Form urlencoded or plain text
+        const params = new URLSearchParams(body);
+        const result: Record<string, string> = {};
+        for (const [key, val] of params.entries()) {
+          result[key] = val;
+        }
+        resolve(result);
+      }
+    });
+    req.on('error', reject);
+  });
+}
+
+/**
+ * Handles incoming HTTP requests.
+ */
+export async function requestListener(
+  req: http.IncomingMessage,
+  res: http.ServerResponse
+): Promise<void> {
+  const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+  const pathname = url.pathname;
+
+  // Session handling
+  const cookies = parseCookies(req.headers['cookie']);
+  let sessionId = cookies['sid'];
+  let isNewSession = false;
+
+  if (!sessionId) {
+    sessionId = randomUUID();
+    isNewSession = true;
+  }
+
+  const setCookieHeader = `sid=${encodeURIComponent(sessionId)}; Path=/; HttpOnly; SameSite=Lax`;
+
+  // POST routes: Verify email form submission
+  if (
+    req.method === 'POST' &&
+    (pathname === '/api/verify-email' ||
+      pathname === '/verify-email' ||
+      pathname === '/account' ||
+      pathname === '/signup')
+  ) {
+    try {
+      const body = await parseBody(req);
+      const email = String(body.email || '').trim();
+      const token = String(body.token || '').trim();
+
+      // Read origin
+      const host = req.headers.host || 'localhost';
+      const origin = req.headers.origin || `http://${host}`;
+
+      const result: SubmissionResult = await handleSignupSubmission(
+        { email, token, sessionId, headers: req.headers },
+        { expectedAudience: process.env.RP_ORIGIN || origin }
+      );
+
+      const acceptsJson = (req.headers['accept'] || '').includes('application/json');
+      const contentType = (req.headers['content-type'] || '');
+
+      if (acceptsJson || contentType.includes('application/json')) {
+        res.writeHead(200, {
+          'Content-Type': 'application/json',
+          'Cache-Control': 'no-store',
+        });
+        res.end(JSON.stringify(result));
+        return;
+      }
+
+      // Browser form submission response
+      res.writeHead(200, {
+        'Content-Type': 'text/html; charset=utf-8',
+        'Cache-Control': 'no-store',
+      });
+      res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <title>Verification Result | The Daily Grind</title>
+  <style>
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #fafafa; color: #3e2723; padding: 40px; text-align: center; }
+    .card { background: white; max-width: 500px; margin: 40px auto; padding: 30px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
+    h1 { color: #4e342e; }
+    .btn { display: inline-block; background: #4e342e; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; margin-top: 20px; }
+  </style>
+</head>
+<body>
+  <div class="card">
+    <h1>${result.verified ? 'Email Verified!' : 'Check Your Inbox'}</h1>
+    <p>${result.message}</p>
+    <p><strong>Email:</strong> ${result.email}</p>
+    <p><strong>Method:</strong> ${result.method === 'evt' ? 'Email Verification Token (Instant)' : 'OTP / Magic Link (Fallback)'}</p>
+    <a href="/" class="btn">Back to Home</a>
+  </div>
+</body>
+</html>`);
+      return;
+    } catch (err: any) {
+      res.writeHead(500, {
+        'Content-Type': 'application/json',
+        'Cache-Control': 'no-store',
+      });
+      res.end(JSON.stringify({ error: err.message }));
+      return;
+    }
+  }
+
+  // GET routes rendering the verification form
+  if (
+    req.method === 'GET' &&
+    (pathname === '/' ||
+      pathname === '/index.html' ||
+      pathname === '/account' ||
+      pathname === '/signup' ||
+      pathname === '/verify-email')
+  ) {
+    // Generate fresh cryptographic nonce (256 bits of entropy) stored in server session
+    const nonce = sessionStore.createNonce(sessionId);
+
+    let html = '';
+    const indexPath = getIndexHtmlPath();
+    if (fs.existsSync(indexPath)) {
+      html = fs.readFileSync(indexPath, 'utf-8');
+    }
+
+    // Replace the nonce attribute in the hidden verification token input
+    // Matching autocomplete="email-verification-token" or name="token"
+    html = html.replace(
+      /(<input[^>]*autocomplete=["']email-verification-token["'][^>]*nonce=["'])[^"']*(")/i,
+      `$1${nonce}$2`
+    );
+    html = html.replace(
+      /(<input[^>]*nonce=["'])[^"']*("[^>]*autocomplete=["']email-verification-token["'])/i,
+      `$1${nonce}$2`
+    );
+
+    const headers: Record<string, string> = {
+      'Content-Type': 'text/html; charset=utf-8',
+      'Cache-Control': 'no-store', // MANDATORY: Cache-Control: no-store
+    };
+    if (isNewSession) {
+      headers['Set-Cookie'] = setCookieHeader;
+    }
+
+    res.writeHead(200, headers);
+    res.end(html);
+    return;
+  }
+
+  // Static file serving fallback
+  const filePath = path.resolve(process.cwd(), pathname.replace(/^\//, ''));
+  if (req.method === 'GET' && fs.existsSync(filePath) && fs.statSync(filePath).isFile()) {
+    const ext = path.extname(filePath).toLowerCase();
+    const mimeTypes: Record<string, string> = {
+      '.html': 'text/html',
+      '.js': 'application/javascript',
+      '.css': 'text/css',
+      '.json': 'application/json',
+      '.png': 'image/png',
+      '.jpg': 'image/jpeg',
+      '.svg': 'image/svg+xml',
+    };
+    res.writeHead(200, { 'Content-Type': mimeTypes[ext] || 'application/octet-stream' });
+    fs.createReadStream(filePath).pipe(res);
+    return;
+  }
+
+  res.writeHead(404, { 'Content-Type': 'text/plain' });
+  res.end('Not Found');
+}
+
+export function createServer(): http.Server {
+  return http.createServer(requestListener);
+}
+
+export function startServer(port = PORT): http.Server {
+  const server = createServer();
+  server.listen(port, () => {
+    console.log(`Server listening on port ${port}`);
+  });
+  return server;
+}
+
+// Auto-run if executed as main module
+if (process.argv[1] && path.resolve(process.argv[1]) === path.resolve(__filename)) {
+  startServer();
+}
