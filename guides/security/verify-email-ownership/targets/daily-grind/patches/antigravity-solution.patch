+
+// Helper to generate a test token presentation
+async function createTestEVTPresentation(options: {
+  issuer?: string;
+  email?: string;
+  emailVerified?: boolean;
+  expectedAudience?: string;
+  expectedNonce?: string;
+  omitKid?: boolean;
+  tamperSdHash?: boolean;
+  tamperNonce?: boolean;
+  tamperAudience?: boolean;
+  mismatchedAlg?: boolean;
+  omitKbJwt?: boolean;
+  issuerKey?: any;
+  issuerKid?: string;
+}) {
+  const iss = options.issuer || 'https://issuer.example.com';
+  const email = options.email || 'user@example.com';
+  const emailVerified = options.emailVerified ?? true;
+  const aud = options.expectedAudience || 'https://rp.example.com';
+  const nonce = options.expectedNonce || 'test-session-nonce-128bits';
+
+  const issuerKeyPair = options.issuerKey || (await generateKeyPair('ES256'));
+  const holderKeyPair = await generateKeyPair('ES256');
+
+  const holderJwk = (await exportJWK(holderKeyPair.publicKey)) as JWK & { alg?: string };
+  holderJwk.alg = options.mismatchedAlg ? 'EdDSA' : 'ES256';
+
+  const evtPayload = {
+    iss,
+    email,
+    email_verified: emailVerified,
+    cnf: { jwk: holderJwk },
+  };
+
+  const header: Record<string, any> = { alg: 'ES256', typ: 'ev+sd-jwt' };
+  if (!options.omitKid) {
+    header.kid = options.issuerKid || 'k1';
+  }
+
+  const issuerJwt = await new SignJWT(evtPayload)
+    .setProtectedHeader(header)
+    .setIssuedAt()
+    .setExpirationTime('5m')
+    .sign(issuerKeyPair.privateKey);
+
+  if (options.omitKbJwt) {
+    return {
+      presentation: `${issuerJwt}~`,
+      issuerKeyPair,
+      holderKeyPair,
+    };
+  }
+
+  const sdHash = options.tamperSdHash
+    ? 'invalid-tampered-sd-hash'
+    : createHash('sha256').update(issuerJwt + '~').digest('base64url');
+
+  const kbNonce = options.tamperNonce ? 'wrong-tampered-nonce' : nonce;
+  const kbAud = options.tamperAudience ? 'https://wrong-rp.example.com' : aud;
+
+  const kbHeader: Record<string, any> = {
+    alg: 'ES256',
+    typ: 'kb+jwt',
+  };
+
+  const kbJwt = await new SignJWT({
+    nonce: kbNonce,
+    aud: kbAud,
+    iat: Math.floor(Date.now() / 1000),
+    sd_hash: sdHash,
+  })
+    .setProtectedHeader(kbHeader)
+    .sign(holderKeyPair.privateKey);
+
+  return {
+    presentation: `${issuerJwt}~${kbJwt}`,
+    issuerKeyPair,
+    holderKeyPair,
+  };
+}
+
+test('Expectation 1: Verification form HTML structure in index.html', () => {
+  const html = fs.readFileSync('./index.html', 'utf-8');
+
+  // Verify form element exists
+  assert.match(html, /<form[^>]*action=["']\/api\/verify-email["'][^>]*>/i);
+
+  // Verify input email with autocomplete="email"
+  assert.match(html, /<input[^>]*type=["']email["'][^>]*autocomplete=["']email["'][^>]*>/i);
+
+  // Verify sibling input hidden with autocomplete="email-verification-token" and non-empty nonce
+  assert.match(
+    html,
+    /<input[^>]*type=["']hidden["'][^>]*nonce=["'][^"']+["'][^>]*autocomplete=["']email-verification-token["'][^>]*>/i
+  );
+});
+
+test('Expectation 2: Server generates fresh nonce per render, stores in session, serves Cache-Control: no-store', async () => {
+  const server = http.createServer(requestListener);
+  await new Promise<void>((resolve) => server.listen(0, resolve));
+  const address = server.address() as any;
+  const port = address.port;
+
+  try {
+    const res1 = await fetch(`http://localhost:${port}/`);
+    assert.strictEqual(res1.status, 200);
+    assert.strictEqual(res1.headers.get('cache-control'), 'no-store');
+
+    const setCookie = res1.headers.get('set-cookie');
+    assert.ok(setCookie, 'Set-Cookie header should be present');
+    assert.match(setCookie, /sid=[^;]+/, 'Session cookie should store sid');
+
+    const html1 = await res1.text();
+    const nonceMatch1 = html1.match(/nonce=["']([^"']+)["'][^>]*autocomplete=["']email-verification-token["']/i);
+    assert.ok(nonceMatch1, 'Nonce should be rendered in form');
+    const nonce1 = nonceMatch1[1];
+    assert.ok(nonce1.length >= 22, 'Nonce should have >= 128 bits entropy');
+
+    // Ensure client cookie does NOT contain the raw nonce
+    assert.ok(!setCookie.includes(nonce1), 'Client cookie must not store raw nonce directly');
+
+    // Second render gets a fresh nonce
+    const res2 = await fetch(`http://localhost:${port}/`, {
+      headers: { cookie: setCookie },
+    });
+    const html2 = await res2.text();
+    const nonceMatch2 = html2.match(/nonce=["']([^"']+)["'][^>]*autocomplete=["']email-verification-token["']/i);
+    assert.ok(nonceMatch2);
+    const nonce2 = nonceMatch2[1];
+    assert.notStrictEqual(nonce1, nonce2, 'Subsequent form render must generate a fresh single-use nonce');
+  } finally {
+    server.close();
+  }
+});
