+test('Expectation 5: Server atomically consumes nonce and compares email case-insensitively', async () => {
+  const sessionId = 'test-atomic-session-1';
+  const nonce = sessionStore.createNonce(sessionId);
+  assert.ok(nonce);
+
+  // First consume succeeds
+  const consumed = sessionStore.consumeNonce(sessionId);
+  assert.strictEqual(consumed, nonce);
+
+  // Second consume immediately returns null (replay attack prevented)
+  const replayed = sessionStore.consumeNonce(sessionId);
+  assert.strictEqual(replayed, null);
+
+  // Email comparison case-insensitivity
+  const mockIssuerKp = await generateKeyPair('ES256');
+  const mockJwk = (await exportJWK(mockIssuerKp.publicKey)) as JWK;
+  mockJwk.kid = 'k1'; mockJwk.alg = 'ES256';
+
+  const mockDnsResolver = async (_d: string) => [['iss=issuer.example.com']];
+  const mockFetch = async (url: string | URL | Request) => {
+    const urlStr = url.toString();
+    if (urlStr.includes('/.well-known/email-verification')) {
+      return new Response(JSON.stringify({
+        issuer: 'https://issuer.example.com',
+        jwks_uri: 'https://issuer.example.com/jwks.json',
+      }));
+    }
+    if (urlStr.includes('/jwks.json')) {
+      return new Response(JSON.stringify({ keys: [mockJwk] }));
+    }
+    return new Response('Not found', { status: 404 });
+  };
+
+  const { presentation } = await createTestEVTPresentation({
+    issuer: 'https://issuer.example.com',
+    email: 'TestUser@Example.COM',
+    expectedAudience: 'https://rp.example.com',
+    expectedNonce: 'fresh-nonce-123',
+    issuerKey: mockIssuerKp,
+  });
+
+  // Submitted with lowercase
+  const result = await verifyEmailVerificationToken({
+    rawToken: presentation,
+    submittedEmail: 'testuser@example.com',
+    expectedNonce: 'fresh-nonce-123',
+    expectedAudience: 'https://rp.example.com',
+    dnsResolver: mockDnsResolver,
+    fetchFn: mockFetch as any,
+  });
+  assert.strictEqual(result.email, 'TestUser@Example.COM');
+
+  // Mismatched email must fail
+  await assert.rejects(
+    () =>
+      verifyEmailVerificationToken({
+        rawToken: presentation,
+        submittedEmail: 'different@example.com',
+        expectedNonce: 'fresh-nonce-123',
+        expectedAudience: 'https://rp.example.com',
+        dnsResolver: mockDnsResolver,
+        fetchFn: mockFetch as any,
+      }),
+    /Submitted email does not match the EVT email claim/
+  );
+});
