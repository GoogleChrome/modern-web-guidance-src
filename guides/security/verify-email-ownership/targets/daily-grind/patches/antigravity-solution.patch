+test('Expectation 9: Fallback flow when no token is submitted or verification fails', async () => {
+  // Case A: No token submitted -> falls back gracefully
+  const resNoToken = await handleSignupSubmission({
+    email: 'user@example.com',
+    token: '',
+    sessionId: 'session-no-token',
+  });
+  assert.strictEqual(resNoToken.status, 200);
+  assert.strictEqual(resNoToken.verified, false);
+  assert.strictEqual(resNoToken.method, 'fallback_otp');
+
+  // Case B: Token verification fails -> falls back gracefully without throwing
+  const resInvalidToken = await handleSignupSubmission({
+    email: 'user@example.com',
+    token: 'invalid-malformed-token',
+    sessionId: 'session-invalid-token',
+  });
+  assert.strictEqual(resInvalidToken.status, 200);
+  assert.strictEqual(resInvalidToken.verified, false);
+  assert.strictEqual(resInvalidToken.method, 'fallback_otp');
+
+  // Case C: Valid token -> completes account creation fast path
+  const mockIssuerKp = await generateKeyPair('ES256');
+  const mockJwk = (await exportJWK(mockIssuerKp.publicKey)) as JWK;
+  mockJwk.kid = 'k1'; mockJwk.alg = 'ES256';
+
+  const mockDnsResolver = async (_d: string) => [['iss=issuer.example.com']];
