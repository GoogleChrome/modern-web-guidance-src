@@ -0,0 +1,135 @@
+import type * as http from 'node:http';
+import { consumeSessionNonce } from './session.js';
+import {
+  verifyEmailVerificationToken,
+  type VerifyEmailVerificationTokenParams,
+} from './verifier.js';
+
+export const RP_ORIGIN = process.env.RP_ORIGIN || 'https://rp.example.com';
+
+export interface SubmissionResult {
+  status: number;
+  success: boolean;
+  verified: boolean;
+  email: string;
+  method: 'evt' | 'fallback_otp';
+  message: string;
+  json: () => Promise<SubmissionResult>;
+  text: () => Promise<string>;
+}
+
+export function createSubmissionResult(data: {
+  status?: number;
+  success: boolean;
+  verified: boolean;
+  email: string;
+  method: 'evt' | 'fallback_otp';
+  message: string;
+}): SubmissionResult {
+  const result: SubmissionResult = {
+    status: data.status ?? 200,
+    success: data.success,
+    verified: data.verified,
+    email: data.email,
+    method: data.method,
+    message: data.message,
+    json: async () => result,
+    text: async () => JSON.stringify(result),
+  };
+  return result;
+}
+
+/**
+ * Fast path: email ownership is cryptographically verified; skip OTP email.
+ */
+export async function completeAccountCreation(submittedEmail: string): Promise<SubmissionResult> {
+  return createSubmissionResult({
+    status: 200,
+    success: true,
+    verified: true,
+    email: submittedEmail,
+    method: 'evt',
+    message: 'Email ownership verified via Email Verification Token. Account creation complete.',
+  });
+}
+
+/**
+ * Fallback path: send standard OTP code or magic link email to submittedEmail.
+ */
+export async function sendTraditionalVerificationEmail(
+  submittedEmail: string
+): Promise<SubmissionResult> {
+  return createSubmissionResult({
+    status: 200,
+    success: true,
+    verified: false,
+    email: submittedEmail,
+    method: 'fallback_otp',
+    message: 'Verification email with OTP / magic link sent. Please check your inbox.',
+  });
+}
+
+export interface HandleSignupSubmissionOptions
+  extends Partial<Omit<VerifyEmailVerificationTokenParams, 'rawToken' | 'submittedEmail' | 'expectedNonce'>> {
+  expectedAudience?: string;
+  expectedNonce?: string;
+}
+
+/**
+ * Handles form submission for email verification.
+ * Follows progressive enhancement: if token verification succeeds, fast-paths to completeAccountCreation;
+ * if no token is provided or verification fails, falls back gracefully to sendTraditionalVerificationEmail.
+ */
+export async function handleSignupSubmission(
+  request: Request | http.IncomingMessage | Record<string, any>,
+  options: HandleSignupSubmissionOptions = {}
+): Promise<SubmissionResult> {
+  let submittedEmail = '';
+  let rawToken = '';
+
+  if (typeof (request as Request).formData === 'function') {
+    // Web standard Request
+    const formData = await (request as Request).formData();
+    submittedEmail = String(formData.get('email') || '').trim();
+    rawToken = String(formData.get('token') || '').trim();
+  } else if (typeof (request as Request).json === 'function' && !(request as http.IncomingMessage).headers) {
+    try {
+      const body = (await (request as Request).json()) as Record<string, any>;
+      submittedEmail = String(body.email || '').trim();
+      rawToken = String(body.token || '').trim();
+    } catch {
+      // Ignored
+    }
+  } else if ('body' in request && (request as any).body) {
+    const b = (request as any).body;
+    submittedEmail = String(b.email || '').trim();
+    rawToken = String(b.token || '').trim();
+  } else if ('email' in request) {
+    submittedEmail = String((request as any).email || '').trim();
+    rawToken = String((request as any).token || '').trim();
+  }
+
+  // Atomically read and delete the single-use nonce from server-side session state
+  const expectedNonce = options.expectedNonce || (await consumeSessionNonce(request as any));
+  const expectedAudience = options.expectedAudience || RP_ORIGIN;
+
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail,
+        expectedNonce,
+        expectedAudience,
+        ...options,
+      });
+      // Fast path: email ownership is cryptographically verified; skip OTP email.
+      return completeAccountCreation(submittedEmail);
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Fallback path: send standard OTP code or magic link email to submittedEmail.
+  return sendTraditionalVerificationEmail(submittedEmail);
+}
