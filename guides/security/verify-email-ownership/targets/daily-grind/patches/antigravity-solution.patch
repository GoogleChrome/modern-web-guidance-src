+      return new Response(JSON.stringify({
+        issuer: 'https://issuer.example.com',
+        jwks_uri: 'https://issuer.example.com/jwks.json',
+      }));
+    }
+    return new Response(JSON.stringify({ keys: [mockJwk] }));
+  };
+
+  const sessionId = 'session-valid';
+  const expectedNonce = sessionStore.createNonce(sessionId);
+  const { presentation } = await createTestEVTPresentation({
+    issuerKey: mockIssuerKp,
+    expectedNonce,
+    expectedAudience: 'https://rp.example.com',
+    email: 'user@example.com',
+  });
+
+  const resValid = await handleSignupSubmission(
+    {
+      email: 'user@example.com',
+      token: presentation,
+      sessionId,
+    },
+    {
+      expectedAudience: 'https://rp.example.com',
+      dnsResolver: mockDnsResolver,
+      fetchFn: mockFetch as any,
+    }
+  );
+
+  assert.strictEqual(resValid.status, 200);
+  assert.strictEqual(resValid.verified, true);
+  assert.strictEqual(resValid.method, 'evt');
+});
