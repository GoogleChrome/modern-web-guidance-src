index 0000000..b89aa67
--- /dev/null
+++ b/src/session.ts
@@ -0,0 +1,134 @@
+import { randomBytes } from 'node:crypto';
+import type * as http from 'node:http';
+
+export interface SessionData {
+  nonce?: string;
+  createdAt: number;
+  [key: string]: unknown;
+}
+
+export class SessionStore {
+  private sessions = new Map<string, SessionData>();
+  private readonly maxAgeMs: number;
+
+  constructor(maxAgeMs = 15 * 60 * 1000) {
+    this.maxAgeMs = maxAgeMs;
+  }
+
+  /**
+   * Generates a fresh, single-use cryptographic nonce with at least 128 bits of entropy
+   * (32 bytes = 256 bits) and stores it in server-side session state for the given sessionId.
+   */
+  createNonce(sessionId: string): string {
+    this.cleanExpired();
+    // 32 bytes provides 256 bits of cryptographic entropy (>= 128 bits required)
+    const nonce = randomBytes(32).toString('base64url');
+    const existing = this.sessions.get(sessionId) || { createdAt: Date.now() };
+    existing.nonce = nonce;
+    existing.createdAt = Date.now();
+    this.sessions.set(sessionId, existing);
+    return nonce;
+  }
+
+  /**
+   * Atomically reads and deletes the expected nonce from server-side session storage
+   * immediately upon receipt to prevent replay attacks.
+   */
+  consumeNonce(sessionId: string): string | null {
+    this.cleanExpired();
+    const session = this.sessions.get(sessionId);
+    if (!session || !session.nonce) {
+      return null;
+    }
+    const nonce = session.nonce;
+    delete session.nonce;
+    return nonce;
+  }
+
+  getSession(sessionId: string): SessionData | undefined {
+    return this.sessions.get(sessionId);
+  }
+
+  setSession(sessionId: string, data: SessionData): void {
+    this.sessions.set(sessionId, data);
+  }
+
+  deleteSession(sessionId: string): void {
+    this.sessions.delete(sessionId);
+  }
+
+  clear(): void {
+    this.sessions.clear();
+  }
+
+  private cleanExpired(): void {
+    const now = Date.now();
+    for (const [id, session] of this.sessions.entries()) {
+      if (now - session.createdAt > this.maxAgeMs) {
+        this.sessions.delete(id);
+      }
+    }
+  }
+}
+
+export const sessionStore = new SessionStore();
+
+/**
+ * Extracts session ID from standard Request, IncomingMessage, cookie string, or headers object.
+ */
+export function getSessionIdFromRequest(
+  request: Request | http.IncomingMessage | { headers?: Record<string, string | string[] | undefined>; sessionId?: string } | string | null | undefined
+): string | null {
+  if (!request) return null;
+  if (typeof request === 'string') {
+    // If it looks like a cookie string or a session ID
+    if (request.includes('sid=')) {
+      const match = request.match(/(?:^|;\s*)sid=([^;]+)/);
+      return match ? decodeURIComponent(match[1]) : null;
+    }
+    return request;
+  }
+
+  if (typeof request === 'object' && 'sessionId' in request && typeof (request as any).sessionId === 'string') {
+    return (request as any).sessionId;
+  }
+
+  let cookieHeader: string | null = null;
+
+  if ('headers' in request && request.headers) {
+    if (typeof (request.headers as Headers).get === 'function') {
+      cookieHeader = (request.headers as Headers).get('cookie');
+    } else if (typeof request.headers === 'object') {
+      const raw = (request.headers as Record<string, string | string[] | undefined>)['cookie'];
+      cookieHeader = Array.isArray(raw) ? raw.join('; ') : raw || null;
+    }
+  }
+
+  if (!cookieHeader) return null;
+  const match = cookieHeader.match(/(?:^|;\s*)sid=([^;]+)/);
+  return match ? decodeURIComponent(match[1]) : null;
+}
+
+/**
+ * Generates and stores a new nonce for the given session.
+ */
+export function createSessionNonce(sessionId: string): string {
+  return sessionStore.createNonce(sessionId);
+}
+
+/**
+ * Atomically reads and deletes the single-use nonce from server-side session state.
+ * Accepts a web standard Request, Node IncomingMessage, or a sessionId string.
+ */
+export async function consumeSessionNonce(
+  requestOrSessionId: Request | http.IncomingMessage | { headers?: Record<string, string | string[] | undefined> } | string
+): Promise<string | null> {
+  const sessionId = typeof requestOrSessionId === 'string' && !requestOrSessionId.includes('sid=')
+    ? requestOrSessionId
+    : getSessionIdFromRequest(requestOrSessionId);
+
+  if (!sessionId) {
+    return null;
+  }
+  return sessionStore.consumeNonce(sessionId);
+}
