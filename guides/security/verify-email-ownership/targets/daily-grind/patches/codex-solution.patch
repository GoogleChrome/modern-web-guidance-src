@@ -0,0 +1,31 @@
+import nodemailer from 'nodemailer';
+import { mkdir, writeFile } from 'node:fs/promises';
+import { randomBytes } from 'node:crypto';
+import { resolve } from 'node:path';
+
+export type SendCode = (email: string, code: string) => Promise<void>;
+
+export function createMailer(): SendCode {
+  const smtpUrl = process.env.SMTP_URL;
+  if (!smtpUrl && process.env.NODE_ENV === 'production') {
+    throw new Error('SMTP_URL is required in production');
+  }
+  const transport = smtpUrl
+    ? nodemailer.createTransport(smtpUrl)
+    : nodemailer.createTransport({ streamTransport: true, buffer: true, newline: 'unix' });
+  return async (email, code) => {
+    const result = await transport.sendMail({
+      from: process.env.MAIL_FROM || 'The Daily Grind <accounts@dailygrind.example>',
+      to: email,
+      subject: 'Your Daily Grind verification code',
+      text: `Your verification code is ${code}. It expires in 10 minutes. If you did not request this code, ignore this email.`,
+    });
+    if (!smtpUrl) {
+      const directory = resolve('.mail');
+      await mkdir(directory, { recursive: true, mode: 0o700 });
+      const path = resolve(directory, `${Date.now()}-${randomBytes(8).toString('hex')}.eml`);
+      await writeFile(path, result.message as Buffer, { mode: 0o600 });
+      console.info(`Development verification email saved to ${path}`);
+    }
+  };
+}
diff --git a/src/server.ts b/src/server.ts
new file mode 100644
index 0000000..337711c
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,198 @@
+import { createServer, type IncomingMessage, type ServerResponse } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { resolve } from 'node:path';
+import { SessionStore } from './sessions.js';
+import { verifyEmailVerificationToken } from './verification.js';
+import { createMailer, type SendCode } from './mail.js';
+
+const COOKIE = '__Host-daily-grind-session';
+const escapeHtml = (text: string): string => text.replace(/[&<>"']/g, character =>
+  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]!);
+
+async function formBody(request: IncomingMessage): Promise<URLSearchParams> {
+  if (request.headers['content-type']?.split(';')[0] !== 'application/x-www-form-urlencoded') {
+    throw new Error('Unsupported form encoding');
+  }
+  const chunks: Buffer[] = [];
+  let size = 0;
+  for await (const chunk of request) {
+    const buffer = Buffer.from(chunk as Uint8Array);
+    size += buffer.length;
+    if (size > 100000) throw new Error('Form is too large');
+    chunks.push(buffer);
+  }
+  return new URLSearchParams(Buffer.concat(chunks).toString('utf8'));
+}
+
+const validEmail = (email: string) => email.length <= 254 &&
+  /^[^\s@<>\x00-\x1f\x7f]+@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$/i.test(email);
+
+export interface AppOptions {
+  origin: string;
+  template: string;
+  sendCode: SendCode;
+  verifyToken?: typeof verifyEmailVerificationToken;
+  store?: SessionStore;
+  originTrialToken?: string;
+}
+
+export function createApp(options: AppOptions) {
+  const originUrl = new URL(options.origin);
+  if (originUrl.origin !== options.origin ||
+      (originUrl.protocol !== 'https:' && !['localhost', '127.0.0.1', '[::1]'].includes(originUrl.hostname))) {
+    throw new Error('RP_ORIGIN must be an exact HTTPS origin (HTTP is allowed only on localhost)');
+  }
+  const store = options.store ?? new SessionStore();
+  const verifyToken = options.verifyToken ?? verifyEmailVerificationToken;
+  const emailLimits = new Map<string, { count: number; expires: number }>();
+  function allowEmail(ip: string): boolean {
+    const now = Date.now();
+    for (const [key, value] of emailLimits) if (value.expires <= now) emailLimits.delete(key);
+    const limit = emailLimits.get(ip) ?? { count: 0, expires: now + 600000 };
+    if (limit.count >= 10 || emailLimits.size >= 10000) return false;
+    limit.count++;
+    emailLimits.set(ip, limit);
+    return true;
+  }
+
+  return createServer((request, response) => {
+    void handle(request, response).catch(error => {
+      console.error('Account request failed:', error instanceof Error ? error.message : 'Unknown error');
+      if (!response.headersSent) {
+        response.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' });
+        response.end('We could not complete your request. Please try again.');
+      } else response.end();
+    });
+  });
+
+  async function handle(request: IncomingMessage, response: ServerResponse): Promise<void> {
+    response.setHeader('Cache-Control', 'no-store');
+    response.setHeader('Content-Type', 'text/html; charset=utf-8');
+    response.setHeader('X-Content-Type-Options', 'nosniff');
+    response.setHeader('Referrer-Policy', 'same-origin');
+    response.setHeader('Content-Security-Policy', "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://images.unsplash.com; script-src 'none'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'");
+    if (options.originTrialToken) response.setHeader('Origin-Trial', options.originTrialToken);
+    const path = new URL(request.url ?? '/', options.origin).pathname;
+    const sessionId = request.headers.cookie?.split(';').map(value => value.trim())
+      .find(value => value.startsWith(`${COOKIE}=`))?.slice(COOKIE.length + 1);
+    const { id, session, fresh } = store.open(sessionId);
+    if (fresh) response.setHeader('Set-Cookie', `${COOKIE}=${id}; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=3600`);
+
+    // Consume the nonce immediately on submission, BEFORE reading the body or doing I/O.
+    const expectedNonce = request.method === 'POST' && path === '/api/verify-email'
+      ? store.consumeNonce(session) : undefined;
+
+    function page(content: string, status = 200): void {
+      response.statusCode = status;
+      response.end(options.template.replace('<!--VERIFICATION_CONTENT-->', content));
+    }
+    function emailForm(message = '', email = '', status = 200): void {
+      const nonce = store.renderNonce(session);
+      page(`<p class="status" role="status">${escapeHtml(message)}</p>
+        <form method="POST" action="/api/verify-email">
+          <label for="email">Email address</label>
+          <input type="email" id="email" name="email" autocomplete="email" maxlength="254" value="${escapeHtml(email)}" required>
+          <input type="hidden" name="token" autocomplete="email-verification-token" nonce="${nonce}">
+          <button class="btn" type="submit">Continue</button>
+        </form>`, status);
+    }
+    function codeForm(message: string, status = 200): void {
+      page(`<p class="status" role="status">${escapeHtml(message)}</p>
+        <form method="POST" action="/api/verify-code">
+          <label for="code">Verification code</label>
+          <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required>
+          <button class="btn" type="submit">Verify email</button>
+        </form><p><a href="/account">Use another email or request a new code</a></p>`, status);
+    }
+    function success(email: string): void {
+      session.verifiedEmail = email;
+      delete session.challenge;
+      page(`<p class="status" role="status">Your email, ${escapeHtml(email)}, is verified. Welcome to The Daily Grind!</p>`);
+    }
+
+    if (request.method === 'POST') {
+      if (request.headers.origin && request.headers.origin !== options.origin) {
+        page('<p>This request came from another site. <a href="/account">Return to your account</a>.</p>', 403);
+        return;
+      }
+      if (!['/api/verify-email', '/api/verify-code'].includes(path)) {
+        page('<p>Page not found.</p>', 404);
+        return;
+      }
+      let form: URLSearchParams;
+      try { form = await formBody(request); }
+      catch { emailForm('Please submit a valid email form.', '', 400); return; }
+      if (path === '/api/verify-code') {
+        const email = store.verifyCode(session, form.get('code')?.trim() ?? '');
+        if (email) success(email);
+        else if (session.challenge) codeForm('That code did not match. Please try again.', 400);
+        else emailForm('Your code expired or reached its attempt limit. Request a new code.', '', 400);
+        return;
+      }
+
+      const email = form.get('email')?.trim() ?? '';
+      if (!validEmail(email)) { emailForm('Enter a valid email address.', email, 400); return; }
+      const token = form.get('token')?.trim() ?? '';
+      if (token && expectedNonce) {
+        try {
+          await verifyToken({ rawToken: token, submittedEmail: email, expectedNonce, expectedAudience: options.origin });
+          success(email);
+          return;
+        } catch {
+          // Never log the token or email. Any verification failure uses the same fallback.
+          console.warn('Email token verification failed; continuing with email code.');
+        }
+      }
+      if (session.lastEmailSent && Date.now() - session.lastEmailSent < 60000) {
+        if (session.challenge && session.challenge.email.toLowerCase() === email.toLowerCase()) {
+          codeForm('A code was already sent. Check your inbox, or request a new code in a minute.');
+        } else emailForm('Please wait a minute before requesting another code.', email, 429);
+        return;
+      }
+      if (!allowEmail(request.socket.remoteAddress ?? 'unknown')) {
+        emailForm('Too many requests. Please try again in a few minutes.', email, 429);
+        return;
+      }
+      const code = store.createChallenge(session, email);
+      try {
+        await options.sendCode(email, code);
+        codeForm(`We sent a six-digit code to ${email}. Enter it below within 10 minutes.`);
+      } catch {
+        delete session.challenge;
+        delete session.lastEmailSent;
+        emailForm('We could not send your code. Please try again.', email, 503);
+      }
+      return;
+    }
+    if (request.method !== 'GET') { response.statusCode = 405; response.end(); return; }
+    if (path === '/logout') {
+      store.delete(id);
+      response.setHeader('Set-Cookie', `${COOKIE}=; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=0`);
+      response.writeHead(303, { Location: '/' });
+      response.end();
+    } else if (['/', '/account', '/rewards'].includes(path)) {
+      if (session.verifiedEmail) success(session.verifiedEmail);
+      else emailForm();
+    } else page('<p>Page not found. <a href="/">Return home</a>.</p>', 404);
+  }
+}
+
+async function main(): Promise<void> {
+  const port = Number(process.env.PORT || 11222);
+  const origin = process.env.RP_ORIGIN || `http://localhost:${port}`;
+  if (process.env.NODE_ENV === 'production' && !process.env.RP_ORIGIN) {
+    throw new Error('RP_ORIGIN is required in production');
+  }
+  const template = await readFile(resolve('index.html'), 'utf8');
+  const server = createApp({
+    origin, template, sendCode: createMailer(),
+    ...(process.env.ORIGIN_TRIAL_TOKEN ? { originTrialToken: process.env.ORIGIN_TRIAL_TOKEN } : {}),
+  });
+  server.requestTimeout = 15000;
+  server.listen(port, () => console.info(`The Daily Grind is running at ${origin}`));
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === resolve(process.argv[1])) {
+  void main().catch(error => { console.error(error); process.exitCode = 1; });
+}
diff --git a/src/sessions.ts b/src/sessions.ts
new file mode 100644
index 0000000..a815a0d
--- /dev/null
+++ b/src/sessions.ts
@@ -0,0 +1,76 @@
+import { randomBytes, randomInt, createHmac, timingSafeEqual } from 'node:crypto';
+
+interface Challenge { email: string; digest: Buffer; expires: number; attempts: number }
+export interface Session {
+  expires: number;
+  nonce?: { value: string; expires: number };
+  challenge?: Challenge;
+  verifiedEmail?: string;
+  lastEmailSent?: number;
+}
+
+// A single-process server-side store. No nonce or OTP is stored in the cookie.
+// For multiple workers, replace this with a shared store using GETDEL/transactions.
+export class SessionStore {
+  private readonly sessions = new Map<string, Session>();
+  private readonly otpSecret = randomBytes(32);
+
+  open(id?: string): { id: string; session: Session; fresh: boolean } {
+    this.prune();
+    const existing = id ? this.sessions.get(id) : undefined;
+    if (existing && existing.expires > Date.now()) return { id: id!, session: existing, fresh: false };
+    if (this.sessions.size >= 10000) throw new Error('Session capacity reached');
+    const newId = randomBytes(32).toString('base64url');
+    const session: Session = { expires: Date.now() + 3600000 };
+    this.sessions.set(newId, session);
+    return { id: newId, session, fresh: true };
+  }
+
+  renderNonce(session: Session): string {
+    const value = randomBytes(32).toString('base64url');
+    session.nonce = { value, expires: Date.now() + 300000 };
+    return value;
+  }
+
+  consumeNonce(session: Session): string | undefined {
+    // Synchronous read/delete in one JS event-loop turn, before any await.
+    const nonce = session.nonce;
+    delete session.nonce;
+    return nonce && nonce.expires > Date.now() ? nonce.value : undefined;
+  }
+
+  createChallenge(session: Session, email: string): string {
+    const code = randomInt(1000000).toString().padStart(6, '0');
+    session.challenge = { email, digest: this.digest(email, code), expires: Date.now() + 600000, attempts: 0 };
+    session.lastEmailSent = Date.now();
+    delete session.verifiedEmail;
+    return code;
+  }
+
+  verifyCode(session: Session, code: string): string | undefined {
+    const challenge = session.challenge;
+    if (!challenge || challenge.expires <= Date.now() || challenge.attempts >= 5) {
+      delete session.challenge;
+      return undefined;
+    }
+    challenge.attempts++;
+    const valid = /^\d{6}$/.test(code) && timingSafeEqual(challenge.digest, this.digest(challenge.email, code));
+    if (valid) {
+      delete session.challenge;
+      session.verifiedEmail = challenge.email;
+      return challenge.email;
+    }
+    if (challenge.attempts >= 5) delete session.challenge;
+    return undefined;
+  }
+
+  delete(id: string): void { this.sessions.delete(id); }
+  private digest(email: string, code: string): Buffer {
+    return createHmac('sha256', this.otpSecret).update(`${email}\0${code}`).digest();
+  }
+  private prune(): void {
+    for (const [id, session] of this.sessions) {
+      if (session.expires <= Date.now()) this.sessions.delete(id);
+    }
+  }
+}
diff --git a/src/verification.ts b/src/verification.ts
