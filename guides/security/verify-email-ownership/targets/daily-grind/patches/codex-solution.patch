index 0000000..0ab495c
--- /dev/null
+++ b/src/verification.ts
@@ -0,0 +1,151 @@
+import { createHash } from 'node:crypto';
+import { resolveTxt } from 'node:dns/promises';
+import { decodeSdJwtSync, getClaimsSync, SDJwtInstance, type Hasher } from '@sd-jwt/core';
+import { createLocalJWKSet, importJWK, jwtVerify, errors, type JSONWebKeySet, type JWK } from 'jose';
+
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg: string) => alg === 'Ed25519' ? 'EdDSA' : alg;
+const hashNames: Record<string, string> = { 'sha-256': 'sha256', 'sha-384': 'sha384', 'sha-512': 'sha512' };
+export const hasher: Hasher = (data, alg) => {
+  const name = hashNames[alg];
+  if (!name) throw new Error('Unsupported disclosure hash algorithm');
+  return createHash(name).update(typeof data === 'string' ? data : new Uint8Array(data)).digest();
+};
+const hasherSync = (data: string, alg: string) => {
+  const name = hashNames[alg];
+  if (!name) throw new Error('Unsupported disclosure hash algorithm');
+  return createHash(name).update(data).digest();
+};
+
+export interface VerificationDependencies {
+  resolveTxt: (hostname: string) => Promise<string[][]>;
+  fetchJson: (url: URL) => Promise<unknown>;
+}
+
+function httpsUrl(value: unknown): URL {
+  if (typeof value !== 'string') throw new Error('Missing HTTPS URL');
+  const url = new URL(value);
+  if (url.protocol !== 'https:' || url.username || url.password || url.hash) {
+    throw new Error('Invalid HTTPS URL');
+  }
+  return url;
+}
+
+async function fetchJson(url: URL): Promise<unknown> {
+  const response = await fetch(url, { redirect: 'error', signal: AbortSignal.timeout(5000) });
+  if (!response.ok) throw new Error('Issuer discovery request failed');
+  if (!response.body) throw new Error('Empty issuer discovery response');
+  let length = 0;
+  const chunks: Uint8Array[] = [];
+  for await (const chunk of response.body) {
+    length += chunk.length;
+    if (length > 262144) {
+      await response.body.cancel().catch(() => {});
+      throw new Error('Issuer discovery response too large');
+    }
+    chunks.push(chunk);
+  }
+  return JSON.parse(Buffer.concat(chunks).toString('utf8')) as unknown;
+}
+
+const defaults: VerificationDependencies = { resolveTxt, fetchJson };
+const isObject = (value: unknown): value is Record<string, unknown> =>
+  typeof value === 'object' && value !== null && !Array.isArray(value);
+
+export async function verifyEmailVerificationToken(
+  input: { rawToken: string; submittedEmail: string; expectedNonce: string; expectedAudience: string },
+  dependencies: VerificationDependencies = defaults,
+): Promise<void> {
+  const { rawToken, submittedEmail, expectedNonce, expectedAudience } = input;
+  if (!expectedNonce || rawToken.length > 65536) throw new Error('Missing nonce or oversized token');
+  // Decode using the SD-JWT library, including selectively disclosed claims.
+  // These claims remain untrusted until BOTH signatures and the binding are verified.
+  const decoded = decodeSdJwtSync(rawToken, hasherSync);
+  if (!decoded.kbJwt || !decoded.jwt.payload) throw new Error('Missing issuer JWT or KB-JWT');
+  const payload = getClaimsSync(decoded.jwt.payload, decoded.disclosures, hasherSync);
+  const iss = payload.iss;
+  if (typeof iss !== 'string' || payload.email_verified !== true ||
+      typeof payload.email !== 'string' || payload.email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Missing issuer or email ownership claims');
+  }
+  const issuerUrl = httpsUrl(iss);
+  if (issuerUrl.origin !== iss || issuerUrl.port || issuerUrl.pathname !== '/' ||
+      !/^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$/i.test(issuerUrl.hostname)) {
+    throw new Error('Issuer must be an exact HTTPS hostname origin');
+  }
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+  const records = await dependencies.resolveTxt(`_email-verification.${domain}`);
+  if (!records.some(record => {
+    const txt = record.join('');
+    if (!txt.startsWith('iss=')) return false;
+    const host = txt.slice(4).trim();
+    return /^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$/i.test(host) && `https://${host}` === iss;
+  })) throw new Error('Issuer is not delegated by the email domain');
+
+  // No issuer HTTP requests are made before exact DNS delegation is confirmed.
+  const metadata = await dependencies.fetchJson(new URL('/.well-known/email-verification', iss));
+  if (!isObject(metadata) || metadata.issuer !== iss) throw new Error('Issuer metadata mismatch');
+  const jwks = await dependencies.fetchJson(httpsUrl(metadata.jwks_uri));
+  if (!isObject(jwks) || !Array.isArray(jwks.keys) || !jwks.keys.every(isObject) || jwks.keys.length > 100) {
+    throw new Error('Invalid JWKS');
+  }
+  const issuerKeys = createLocalJWKSet(jwks as unknown as JSONWebKeySet);
+  const evtOptions = {
+    typ: 'ev+sd-jwt', issuer: iss, algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m', clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    allowedDisclosureHashAlgorithms: ['sha-256', 'sha-384', 'sha-512'],
+    verifier: async (data, sig) => {
+      const compact = `${data}.${sig}`;
+      try {
+        await jwtVerify(compact, issuerKeys, evtOptions);
+      } catch (error) {
+        if (!(error instanceof errors.JWKSMultipleMatchingKeys)) throw error;
+        // Providers may omit kid. Try every eligible public key, not just the first.
+        let matched = false;
+        for await (const key of error) {
+          try {
+            await jwtVerify(compact, key, evtOptions);
+            matched = true;
+            break;
+          } catch { /* Try the next candidate. */ }
+        }
+        if (!matched) throw error;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig, verifiedPayload) => {
+      const holderJwk = verifiedPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt?.header.alg;
+      if (!holderJwk || typeof holderAlg !== 'string' || typeof kbAlg !== 'string' || !ALLOWED_ALGS.includes(holderAlg) ||
+          !ALLOWED_ALGS.includes(kbAlg) || normalizeAlg(holderAlg) !== normalizeAlg(kbAlg) ||
+          holderJwk.d || holderJwk.k) {
+        throw new Error('Missing, private, disallowed, or mismatched holder key algorithm');
+      }
+      const key = await importJWK(holderJwk as JWK, kbAlg);
+      await jwtVerify(`${data}.${sig}`, key, {
+        typ: 'kb+jwt', audience: expectedAudience, algorithms: [kbAlg],
+        maxTokenAge: '5m', clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified', 'cnf'],
+    allowedIssuerAlgorithms: ALLOWED_ALGS,
+    allowedKeyBindingAlgorithms: ALLOWED_ALGS,
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+  if (!verified.kb || verified.payload.email_verified !== true ||
+      typeof verified.payload.email !== 'string' ||
+      verified.payload.email.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Verified email ownership claims mismatch');
+  }
+}
diff --git a/tests/server.test.ts b/tests/server.test.ts
new file mode 100644
index 0000000..cf163d2
--- /dev/null
+++ b/tests/server.test.ts
@@ -0,0 +1,116 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import type { AddressInfo } from 'node:net';
+import { createApp } from '../src/server.js';
+import { SessionStore } from '../src/sessions.js';
+
+test('nonces are fresh, consumed atomically, expire, and are not session identifiers', () => {
+  const store = new SessionStore();
+  const { id, session } = store.open();
+  const first = store.renderNonce(session);
+  const second = store.renderNonce(session);
+  assert.notEqual(first, second);
+  assert.notEqual(second, id);
+  assert.equal(Buffer.from(second, 'base64url').length, 32);
+  assert.equal(store.consumeNonce(session), second);
+  assert.equal(store.consumeNonce(session), undefined);
+  store.renderNonce(session);
+  session.nonce!.expires = 0;
+  assert.equal(store.consumeNonce(session), undefined);
+});
+
+test('OTP codes are single-use, expire, and stop after five attempts', () => {
+  const store = new SessionStore();
+  const { session } = store.open();
+  const code = store.createChallenge(session, 'user@example.com');
+  assert.equal(store.verifyCode(session, code), 'user@example.com');
+  assert.equal(store.verifyCode(session, code), undefined);
+  const expired = store.createChallenge(session, 'user@example.com');
+  session.challenge!.expires = 0;
+  assert.equal(store.verifyCode(session, expired), undefined);
+  const limited = store.createChallenge(session, 'user@example.com');
+  const wrong = limited === '000000' ? '111111' : '000000';
+  for (let i = 0; i < 5; i++) assert.equal(store.verifyCode(session, wrong), undefined);
+  assert.equal(store.verifyCode(session, limited), undefined);
+});
+
+test('form, fast path, replay, empty token, and invalid-token fallback work end to end', async t => {
+  const template = await readFile('index.html', 'utf8');
+  const sent: { email: string; code: string }[] = [];
+  const nonces: string[] = [];
+  const server = createApp({ origin: 'http://localhost:11222', template,
+    sendCode: async (email, code) => { sent.push({ email, code }); },
+    verifyToken: async input => {
+      nonces.push(input.expectedNonce);
+      if (input.rawToken !== 'valid-test-token') throw new Error('Invalid token');
+    },
+  });
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => { server.closeAllConnections(); server.close(); });
+  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+  async function open() {
+    const response = await fetch(`${url}/account`);
+    assert.equal(response.headers.get('cache-control'), 'no-store');
+    const cookie = response.headers.get('set-cookie')!;
+    assert.match(cookie, /HttpOnly; Secure; SameSite=Lax/);
+    const html = await response.text();
+    assert.match(html, /<input type="email"[^>]*autocomplete="email"/);
+    const nonce = html.match(/autocomplete="email-verification-token" nonce="([^"]+)"/)![1]!;
+    assert.ok(!cookie.includes(nonce));
+    const form = html.match(/<form[^>]*action="\/api\/verify-email"[\s\S]*?<\/form>/)![0];
+    assert.match(form, /type="email"/);
+    assert.match(form, /type="hidden"/);
+    assert.ok(!html.includes('<script'));
+    return { cookie: cookie.split(';')[0]!, nonce };
+  }
+  async function post(path: string, cookie: string, fields: Record<string, string>) {
+    return fetch(`${url}${path}`, { method: 'POST', headers: { Cookie: cookie }, body: new URLSearchParams(fields) });
+  }
+  const fast = await open();
+  const result = await post('/api/verify-email', fast.cookie, { email: 'User@Example.com', token: 'valid-test-token' });
+  assert.match(await result.text(), /is verified/);
+  assert.deepEqual(nonces, [fast.nonce]);
+  assert.equal(sent.length, 0);
+  const replay = await post('/api/verify-email', fast.cookie, { email: 'User@Example.com', token: 'valid-test-token' });
+  assert.match(await replay.text(), /six-digit code/);
+  assert.equal(nonces.length, 1);
+  assert.equal(sent.length, 1);
+
+  for (const token of ['', 'invalid-token']) {
+    const session = await open();
+    const response = await post('/api/verify-email', session.cookie, { email: 'user@example.com', token });
+    assert.equal(response.status, 200);
+    const html = await response.text();
+    assert.match(html, /autocomplete="one-time-code"/);
+    const message = sent.at(-1)!;
+    assert.ok(!html.includes(message.code));
+    const verified = await post('/api/verify-code', session.cookie, { code: message.code });
+    assert.match(await verified.text(), /is verified/);
+    const reused = await post('/api/verify-code', session.cookie, { code: message.code });
+    assert.equal(reused.status, 400);
+  }
+});
+
+test('nonce is deleted before a slow request body is read', async t => {
+  const store = new SessionStore();
+  const { id, session } = store.open();
+  store.renderNonce(session);
+  const { request } = await import('node:http');
+  const server = createApp({ origin: 'http://localhost:11222', template: '<!--VERIFICATION_CONTENT-->', store,
+    sendCode: async () => {},
+  });
+  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => { server.closeAllConnections(); server.close(); });
+  const req = request({ hostname: '127.0.0.1', port: (server.address() as AddressInfo).port,
+    method: 'POST', path: '/api/verify-email', headers: {
+      Cookie: `__Host-daily-grind-session=${id}`, 'Content-Type': 'application/x-www-form-urlencoded',
+      'Content-Length': 100,
+    },
+  });
+  req.on('error', () => {});
+  req.flushHeaders();
+  await new Promise<void>(resolve => server.once('request', () => resolve()));
+  assert.equal(session.nonce, undefined);
+  req.destroy();
+});
diff --git a/tests/verification.test.ts b/tests/verification.test.ts
new file mode 100644
index 0000000..d26f25a
--- /dev/null
+++ b/tests/verification.test.ts
@@ -0,0 +1,138 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { CompactSign, decodeProtectedHeader, exportJWK, generateKeyPair, SignJWT } from 'jose';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createHash, randomBytes } from 'node:crypto';
+import { hasher, verifyEmailVerificationToken, type VerificationDependencies } from '../src/verification.js';
+
+const issuer = 'https://issuer.example.com';
+const audience = 'https://coffee.example.com';
+const nonce = 'server-generated-single-use-nonce';
+const email = 'Coffee@Example.com';
+
+async function fixture(alg = 'ES256') {
+  const issuerKey = await generateKeyPair(alg, { extractable: true });
+  const wrongKey = await generateKeyPair(alg, { extractable: true });
+  const holderKey = await generateKeyPair(alg, { extractable: true });
+  const holderJwk = { ...await exportJWK(holderKey.publicKey), alg };
+  const keys = [await exportJWK(wrongKey.publicKey), await exportJWK(issuerKey.publicKey)];
+  const calls: string[] = [];
+  const deps: VerificationDependencies = {
+    resolveTxt: async host => { calls.push(host); return [['iss=issuer.', 'example.com']]; },
+    fetchJson: async url => {
+      calls.push(url.href);
+      return url.pathname === '/.well-known/email-verification'
+        ? { issuer, jwks_uri: `${issuer}/keys` } : { keys };
+    },
+  };
+  async function make(options: {
+    email?: string; iss?: string; verified?: boolean; holderAlg?: string;
+    nonce?: string; aud?: string; iat?: number; issuerIat?: number;
+    disclosures?: boolean; badIssuerSignature?: boolean;
+  } = {}) {
+    const now = Math.floor(Date.now() / 1000);
+    const signer = new SDJwtInstance({
+      hasher, hashAlg: 'sha-256', signAlg: alg,
+      saltGenerator: length => randomBytes(length).toString('base64url'),
+      signer: async data => {
+        const compact = await new CompactSign(Buffer.from(data.split('.')[1]!, 'base64url'))
+          .setProtectedHeader({ ...decodeProtectedHeader(`${data}.`), alg })
+          .sign(options.badIssuerSignature ? wrongKey.privateKey : issuerKey.privateKey);
+        return compact.split('.')[2]!;
+      },
+      kbSignAlg: alg,
+      kbSigner: async data => {
+        const compact = await new CompactSign(Buffer.from(data.split('.')[1]!, 'base64url'))
+          .setProtectedHeader({ ...decodeProtectedHeader(`${data}.`), alg }).sign(holderKey.privateKey);
+        return compact.split('.')[2]!;
+      },
+    });
+    const payload = {
+      iss: options.iss ?? issuer, iat: options.issuerIat ?? now, exp: now + 300,
+      email: options.email ?? email, email_verified: options.verified ?? true,
+      cnf: { jwk: { ...holderJwk, alg: options.holderAlg ?? alg } },
+    };
+    const credential = await signer.issue(payload,
+      options.disclosures ? { _sd: ['email', 'email_verified'] } : undefined,
+      { header: { typ: 'ev+sd-jwt' } });
+    const token = await signer.present(credential, undefined, {
+      kb: { payload: { iat: options.iat ?? now, aud: options.aud ?? audience, nonce: options.nonce ?? nonce } },
+    });
+    return { token, credential };
+  }
+  async function changeBinding(token: string, changes: Record<string, unknown>) {
+    const decoded = decodeSdJwtSync(token, (data, alg) => createHash(alg.replace('-', '')).update(data).digest());
+    const kb = await new SignJWT({ ...decoded.kbJwt!.payload, ...changes })
+      .setProtectedHeader({ typ: 'kb+jwt', alg }).sign(holderKey.privateKey);
+    return token.slice(0, token.lastIndexOf('~') + 1) + kb;
+  }
+  const verify = (token: string, overrides: Partial<VerificationDependencies> = {}) =>
+    verifyEmailVerificationToken({ rawToken: token, submittedEmail: email.toLowerCase(), expectedNonce: nonce, expectedAudience: audience }, { ...deps, ...overrides });
+  return { make, verify, changeBinding, calls, deps };
+}
+
+test('verifies email case-insensitively and tries multiple JWKS keys with no kid', async () => {
+  const f = await fixture();
+  const { token } = await f.make();
+  await f.verify(token);
+  assert.deepEqual(f.calls, ['_email-verification.example.com', `${issuer}/.well-known/email-verification`, `${issuer}/keys`]);
+});
+
+test('selectively disclosed email claims are verified', async () => {
+  const f = await fixture();
+  await f.verify((await f.make({ disclosures: true })).token);
+});
+
+for (const alg of ['EdDSA', 'Ed25519']) {
+  test(`supports issuer and holder ${alg} signatures`, async () => {
+    const f = await fixture(alg);
+    await f.verify((await f.make()).token);
+  });
+}
+
+test('rejects missing KB-JWT and mismatched aud, nonce, sd_hash, and algorithm', async () => {
+  const f = await fixture();
+  const { token, credential } = await f.make();
+  await assert.rejects(f.verify(credential));
+  await assert.rejects(f.verify((await f.make({ aud: 'https://attacker.example' })).token));
+  await assert.rejects(f.verify((await f.make({ nonce: 'other-nonce' })).token));
+  await assert.rejects(f.verify(await f.changeBinding(token, { sd_hash: 'tampered' })));
+  await assert.rejects(f.verify((await f.make({ holderAlg: 'EdDSA' })).token));
+  await assert.rejects(f.verify((await f.make({ holderAlg: 'HS256' })).token));
+});
+
+test('rejects invalid email claims, missing trust, and stale tokens', async () => {
+  const f = await fixture();
+  for (const options of [
+    { email: 'someone-else@example.com' }, { verified: false },
+    { issuerIat: Math.floor(Date.now() / 1000) - 500 },
+    { iat: Math.floor(Date.now() / 1000) - 500 },
+    { iat: Math.floor(Date.now() / 1000) + 500 },
+  ]) await assert.rejects(f.verify((await f.make(options)).token));
+  const { token } = await f.make();
+  await assert.rejects(f.verify(token, { resolveTxt: async () => [['iss=attacker.example']] }));
+  await assert.rejects(f.verify(token, { fetchJson: async () => ({ issuer: `${issuer}/`, jwks_uri: `${issuer}/keys` }) }));
+  await assert.rejects(f.verify(token, { fetchJson: async () => ({ issuer, jwks_uri: 'http://issuer.example.com/keys' }) }));
+});
+
+test('rejects non-origin issuers and DNS mismatch before any HTTP request', async () => {
+  const f = await fixture();
+  for (const iss of [`${issuer}/`, `${issuer}:443`, `${issuer}/path`, 'http://issuer.example.com']) {
+    await assert.rejects(f.verify((await f.make({ iss })).token));
+  }
+  await assert.rejects(f.verify((await f.make()).token, { resolveTxt: async () => [['iss=ISSUER.example.com']] }));
+  assert.equal(f.calls.length, 0);
+});
+
+test('rejects invalid issuer and holder signatures', async () => {
+  const f = await fixture();
+  const { token } = await f.make();
+  const otherKey = await generateKeyPair('ES256');
+  await assert.rejects(f.verify(token, { fetchJson: async url => url.pathname === '/keys'
+    ? { keys: [await exportJWK(otherKey.publicKey)] }
+    : { issuer, jwks_uri: `${issuer}/keys` } }));
+  const decoded = decodeSdJwtSync(token, (data, alg) => createHash(alg.replace('-', '')).update(data).digest());
+  const badKb = await new SignJWT(decoded.kbJwt!.payload)
+    .setProtectedHeader({ typ: 'kb+jwt', alg: 'ES256' }).sign(otherKey.privateKey);
+  await assert.rejects(f.verify(token.slice(0, token.lastIndexOf('~') + 1) + badKb));
+});
