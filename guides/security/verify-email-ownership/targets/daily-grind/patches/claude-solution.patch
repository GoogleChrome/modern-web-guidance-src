new file mode 100644
index 0000000..d6e74ec
--- /dev/null
+++ b/src/accounts.ts
@@ -0,0 +1,66 @@
+import { createHash, randomInt, timingSafeEqual } from 'node:crypto';
+
+export type VerificationMethod = 'email-verification-token' | 'email-otp';
+
+export interface RewardsAccount {
+  name: string;
+  email: string;
+  verifiedVia: VerificationMethod;
+  createdAt: Date;
+}
+
+/** In-memory account store for the demo; replace with your database. */
+const accounts = new Map<string, RewardsAccount>();
+
+export type CreateResult =
+  | { status: 'created'; account: RewardsAccount }
+  | { status: 'exists'; account: RewardsAccount };
+
+export function completeAccountCreation(
+  name: string,
+  email: string,
+  verifiedVia: VerificationMethod,
+): CreateResult {
+  const key = email.toLowerCase();
+  const existing = accounts.get(key);
+  if (existing) return { status: 'exists', account: existing };
+  // Preserve the submitted email string; only the lookup key is normalized.
+  const account: RewardsAccount = { name, email, verifiedVia, createdAt: new Date() };
+  accounts.set(key, account);
+  // Ownership is verified, but deliverability is not: still send a transactional
+  // welcome email and handle bounces normally.
+  sendEmail(email, 'Welcome to Daily Grind Rewards', `Hi ${name}, your rewards account is ready.`);
+  return { status: 'created', account };
+}
+
+export const OTP_TTL_MS = 10 * 60 * 1000;
+export const OTP_MAX_ATTEMPTS = 5;
+
+export function hashCode(code: string): string {
+  return createHash('sha256').update(code).digest('hex');
+}
+
+export function codeMatches(submitted: string, expectedHash: string): boolean {
+  const a = Buffer.from(hashCode(submitted), 'hex');
+  const b = Buffer.from(expectedHash, 'hex');
+  return a.length === b.length && timingSafeEqual(a, b);
+}
+
+/**
+ * Fallback path: sends a standard one-time passcode email. Returns the hash of the
+ * code so the caller can store it in server-side session state.
+ */
+export function sendTraditionalVerificationEmail(email: string): string {
+  const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+  sendEmail(
+    email,
+    'Your Daily Grind Rewards verification code',
+    `Your verification code is ${code}. It expires in 10 minutes.`,
+  );
+  return hashCode(code);
+}
+
+/** Mail transport stub; wire up your email provider here. */
+function sendEmail(to: string, subject: string, body: string): void {
+  console.log(`[mail] to=${to} subject="${subject}"\n${body}`);
+}
diff --git a/src/evp.ts b/src/evp.ts
new file mode 100644
index 0000000..dfd3eb5
--- /dev/null
+++ b/src/evp.ts
@@ -0,0 +1,199 @@
+import { createHash } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { SDJwtInstance, decodeSdJwtSync } from '@sd-jwt/core';
+import type { Hasher, HasherSync } from '@sd-jwt/core';
+import { createRemoteJWKSet, errors as joseErrors, importJWK, jwtVerify } from 'jose';
+import type { JWK, JWTVerifyOptions } from 'jose';
+
+/**
+ * Server-side verification of an Email Verification Protocol (EVP) presentation
+ * (`EVT~KB-JWT`) submitted via `<input autocomplete="email-verification-token">`.
+ */
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// TODO: Remove 'EdDSA' once live issuers (e.g. Gmail) and Chrome Origin Trial builds finish
+// transitioning from 'EdDSA' (with crv: 'Ed25519') to 'Ed25519'.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg: string): string => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+const NETWORK_TIMEOUT_MS = 5_000;
+
+const nodeHashAlg = (alg: string): string => (alg === 'sha-256' ? 'sha256' : alg);
+
+const hasherSync: HasherSync = (data, alg) =>
+  createHash(nodeHashAlg(alg)).update(data).digest();
+
+const hasher: Hasher = (data, alg) =>
+  createHash(nodeHashAlg(alg))
+    .update(typeof data === 'string' ? data : Buffer.from(data))
+    .digest();
+
+interface IssuerMetadata {
+  issuer?: unknown;
+  jwks_uri?: unknown;
+}
+
+type RemoteJwks = ReturnType<typeof createRemoteJWKSet>;
+const jwksCache = new Map<string, RemoteJwks>();
+
+function getRemoteJwks(jwksUri: string): RemoteJwks {
+  let jwks = jwksCache.get(jwksUri);
+  if (!jwks) {
+    jwks = createRemoteJWKSet(new URL(jwksUri), { timeoutDuration: NETWORK_TIMEOUT_MS });
+    jwksCache.set(jwksUri, jwks);
+  }
+  return jwks;
+}
+
+export interface VerifyEvtParams {
+  rawToken: string;
+  submittedEmail: string;
+  expectedNonce: string;
+  expectedAudience: string;
+}
+
+export interface VerifiedEmail {
+  email: string;
+  issuer: string;
+}
+
+/** Step 2: DNS delegation check, then issuer discovery + JWKS loading. */
+async function loadIssuerJwks(submittedEmail: string, iss: string): Promise<RemoteJwks> {
+  const domain = submittedEmail.slice(submittedEmail.lastIndexOf('@') + 1).toLowerCase();
+  if (!domain) throw new Error('Submitted email has no domain.');
+
+  const txtRecords = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) => r.join(''));
+  if (!txtRecords.some((txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss)) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') throw new Error('Issuer must use HTTPS.');
+  const response = await fetch(discoveryUrl, {
+    headers: { accept: 'application/json' },
+    signal: AbortSignal.timeout(NETWORK_TIMEOUT_MS),
+  });
+  if (!response.ok) throw new Error(`Issuer metadata request failed (${response.status}).`);
+  const metadata = (await response.json()) as IssuerMetadata;
+  if (
+    metadata.issuer !== iss ||
+    typeof metadata.jwks_uri !== 'string' ||
+    !metadata.jwks_uri.startsWith('https://')
+  ) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+  return getRemoteJwks(metadata.jwks_uri);
+}
+
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience,
+}: VerifyEvtParams): Promise<VerifiedEmail> {
+  // Step 1: Parse the SD-JWT claims and validate the email address.
+  const decoded = decodeSdJwtSync(rawToken, hasherSync);
+  const evtPayload = decoded.jwt.payload;
+  const iss = evtPayload['iss'];
+  const kbJwt = decoded.kbJwt;
+
+  if (
+    !expectedNonce ||
+    !decoded.jwt ||
+    !kbJwt ||
+    typeof iss !== 'string' ||
+    !iss ||
+    evtPayload['email_verified'] !== true
+  ) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+  const evtEmail = evtPayload['email'];
+  // MANDATORY: Compare email addresses case-insensitively.
+  if (typeof evtEmail !== 'string' || evtEmail.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation and load the issuer JWKS.
+  const issuerJwks = await loadIssuerJwks(submittedEmail, iss);
+
+  // Step 3: Verify the EVT signature and Key Binding JWT.
+  const evtOptions: JWTVerifyOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance<Record<string, unknown>>({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws JWKSMultipleMatchingKeys, which yields each matching CryptoKey.
+        if (!(err instanceof joseErrors.JWKSMultipleMatchingKeys)) throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {
+            // Try the next candidate key.
+          }
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const cnf = evtPayload['cnf'] as { jwk?: JWK } | undefined;
+      const holderJwk = cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlgRaw: unknown = kbJwt.header?.alg;
+      const kbAlg = typeof kbAlgRaw === 'string' ? kbAlgRaw : undefined;
+      if (
+        !holderJwk ||
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  if (!verified.kb) throw new Error('Key Binding JWT was not verified.');
+  const verifiedEmail = verified.payload['email'];
+  if (
+    verified.payload['email_verified'] !== true ||
+    typeof verifiedEmail !== 'string' ||
+    verifiedEmail.toLowerCase() !== submittedEmail.toLowerCase()
+  ) {
+    throw new Error('Verified EVT claims do not match the submitted email.');
+  }
+
+  return { email: submittedEmail, issuer: iss };
+}
diff --git a/src/server.ts b/src/server.ts
new file mode 100644
index 0000000..c429a5a
--- /dev/null
+++ b/src/server.ts
@@ -0,0 +1,269 @@
+import { readFileSync } from 'node:fs';
+import { createServer } from 'node:http';
+import type { IncomingMessage, ServerResponse } from 'node:http';
+import { fileURLToPath } from 'node:url';
+import {
+  OTP_MAX_ATTEMPTS,
+  OTP_TTL_MS,
+  codeMatches,
+  completeAccountCreation,
+  sendTraditionalVerificationEmail,
+} from './accounts.js';
+import type { CreateResult } from './accounts.js';
+import { verifyEmailVerificationToken } from './evp.js';
+import {
+  clearPendingVerification,
+  consumeSessionNonce,
+  getPendingVerification,
+  issueFormNonce,
+  setPendingVerification,
+} from './session.js';
+
+const PORT = Number(process.env['PORT'] ?? 11222);
+// Public relying-party origin; must exactly match the origin the browser sees (KB-JWT `aud`).
+const RP_ORIGIN = (process.env['RP_ORIGIN'] ?? `http://localhost:${PORT}`).replace(/\/+$/, '');
+// Email Verification API Origin Trial token for RP_ORIGIN.
+const ORIGIN_TRIAL_TOKEN = process.env['ORIGIN_TRIAL_TOKEN']?.trim() ?? '';
+
+const MAX_BODY_BYTES = 32 * 1024;
+const NONCE_PLACEHOLDER = '{{EVT_NONCE}}';
+const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+const homepageTemplate = readFileSync(
+  fileURLToPath(new URL('../index.html', import.meta.url)),
+  'utf8',
+);
+if (!homepageTemplate.includes(NONCE_PLACEHOLDER)) {
+  throw new Error(`index.html is missing the ${NONCE_PLACEHOLDER} placeholder.`);
+}
+
+class HttpError extends Error {
+  constructor(
+    readonly status: number,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+function send(res: ServerResponse, status: number, html: string): void {
+  res.statusCode = status;
+  res.setHeader('Content-Type', 'text/html; charset=utf-8');
+  res.setHeader('Cache-Control', 'no-store');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.end(html);
+}
+
+function page(title: string, bodyHtml: string): string {
+  return `<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>${escapeHtml(title)} | The Daily Grind</title>
+  <style>
+    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #fafafa; color: #3e2723; margin: 0; }
+    main { max-width: 480px; margin: 60px auto; background: #fff; padding: 32px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,.1); }
+    h1 { color: #4e342e; margin-top: 0; }
+    label { display: block; font-weight: 600; margin: 16px 0 6px; }
+    input { width: 100%; padding: 10px; border: 1px solid #d7ccc8; border-radius: 5px; font-size: 1rem; box-sizing: border-box; }
+    .btn { display: inline-block; background: #4e342e; color: #fff; padding: 10px 20px; border: 0; border-radius: 5px; margin-top: 16px; text-decoration: none; cursor: pointer; font-size: 1rem; }
+    .error { color: #b71c1c; }
+  </style>
+</head>
+<body><main>${bodyHtml}</main></body>
+</html>`;
+}
+
+async function readForm(req: IncomingMessage): Promise<URLSearchParams> {
+  const contentType = req.headers['content-type'] ?? '';
+  if (!contentType.toLowerCase().startsWith('application/x-www-form-urlencoded')) {
+    throw new HttpError(415, 'Unsupported form encoding.');
+  }
+  const chunks: Buffer[] = [];
+  let size = 0;
+  for await (const chunk of req) {
+    const buf = Buffer.isBuffer(chunk) ? chunk : Buffer.from(String(chunk));
+    size += buf.length;
+    if (size > MAX_BODY_BYTES) throw new HttpError(413, 'Form submission too large.');
+    chunks.push(buf);
+  }
+  return new URLSearchParams(Buffer.concat(chunks).toString('utf8'));
+}
+
+function renderHomepage(req: IncomingMessage, res: ServerResponse): void {
+  // Fresh single-use nonce per form render, stored in server-side session state.
+  const nonce = issueFormNonce(req, res);
+  if (ORIGIN_TRIAL_TOKEN) res.setHeader('Origin-Trial', ORIGIN_TRIAL_TOKEN);
+  send(res, 200, homepageTemplate.split(NONCE_PLACEHOLDER).join(escapeHtml(nonce)));
+}
+
+function renderAccountResult(res: ServerResponse, result: CreateResult): void {
+  const { account } = result;
+  if (result.status === 'exists') {
+    send(
+      res,
+      200,
+      page(
+        'Already a member',
+        `<h1>You're already a member</h1>
+         <p>A rewards account for <strong>${escapeHtml(account.email)}</strong> already exists.</p>
+         <a class="btn" href="/account">Go to My Account</a>`,
+      ),
+    );
+    return;
+  }
+  send(
+    res,
+    201,
+    page(
+      'Welcome to Rewards',
+      `<h1>Welcome, ${escapeHtml(account.name)}!</h1>
+       <p>Your Daily Grind Rewards account for <strong>${escapeHtml(account.email)}</strong> is ready.
+       Your first drink is on us.</p>
+       <a class="btn" href="/">Back to the homepage</a>`,
+    ),
+  );
+}
+
+function renderOtpForm(res: ServerResponse, email: string, error?: string): void {
+  send(
+    res,
+    error ? 400 : 200,
+    page(
+      'Verify your email',
+      `<h1>Check your inbox</h1>
+       <p>We sent a 6-digit code to <strong>${escapeHtml(email)}</strong>. Enter it below to finish joining Rewards.</p>
+       ${error ? `<p class="error" role="alert">${escapeHtml(error)}</p>` : ''}
+       <form method="POST" action="/api/verify-email/confirm">
+         <label for="code">Verification code</label>
+         <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code"
+                pattern="[0-9]{6}" maxlength="6" required>
+         <button class="btn" type="submit">Verify</button>
+       </form>`,
+    ),
+  );
+}
+
+function renderError(res: ServerResponse, status: number, message: string): void {
+  send(
+    res,
+    status,
+    page(
+      'Something went wrong',
+      `<h1>Something went wrong</h1>
+       <p class="error" role="alert">${escapeHtml(message)}</p>
+       <a class="btn" href="/#rewards-signup">Try again</a>`,
+    ),
+  );
+}
+
+async function handleSignupSubmission(req: IncomingMessage, res: ServerResponse): Promise<void> {
+  // Atomically read and delete the single-use nonce as soon as the POST arrives.
+  const expectedNonce = consumeSessionNonce(req);
+  const form = await readForm(req);
+  const name = String(form.get('name') ?? '').trim().slice(0, 100);
+  const submittedEmail = String(form.get('email') ?? '').trim();
+  // Untrusted input: empty when unsupported, signed out of the provider, etc.
+  const rawToken = String(form.get('token') ?? '').trim();
+
+  if (!name) throw new HttpError(400, 'Please enter your name.');
+  if (submittedEmail.length > 254 || !EMAIL_RE.test(submittedEmail)) {
+    throw new HttpError(400, 'Please enter a valid email address.');
+  }
+
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail,
+        expectedNonce,
+        expectedAudience: RP_ORIGIN,
+      });
+      // Fast path: email ownership is cryptographically verified; skip the OTP email.
+      clearPendingVerification(req);
+      renderAccountResult(res, completeAccountCreation(name, submittedEmail, 'email-verification-token'));
+      return;
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Fallback path: send a standard OTP email and never block sign-up.
+  const codeHash = sendTraditionalVerificationEmail(submittedEmail);
+  setPendingVerification(req, res, {
+    email: submittedEmail,
+    name,
+    codeHash,
+    expiresAt: Date.now() + OTP_TTL_MS,
+    attemptsLeft: OTP_MAX_ATTEMPTS,
+  });
+  renderOtpForm(res, submittedEmail);
+}
+
+async function handleOtpConfirmation(req: IncomingMessage, res: ServerResponse): Promise<void> {
+  const form = await readForm(req);
+  const code = String(form.get('code') ?? '').trim();
+  const pending = getPendingVerification(req);
+  if (!pending) {
+    throw new HttpError(400, 'Your verification code has expired. Please sign up again.');
+  }
+  if (!/^\d{6}$/.test(code) || !codeMatches(code, pending.codeHash)) {
+    pending.attemptsLeft -= 1;
+    if (pending.attemptsLeft <= 0) {
+      clearPendingVerification(req);
+      throw new HttpError(400, 'Too many incorrect attempts. Please sign up again.');
+    }
+    renderOtpForm(res, pending.email, 'That code is incorrect. Please try again.');
+    return;
+  }
+  clearPendingVerification(req);
+  renderAccountResult(res, completeAccountCreation(pending.name, pending.email, 'email-otp'));
+}
+
+const server = createServer((req, res) => {
+  const { pathname } = new URL(req.url ?? '/', 'http://localhost');
+  const method = req.method ?? 'GET';
+
+  const route = async (): Promise<void> => {
+    if ((pathname === '/' || pathname === '/index.html') && (method === 'GET' || method === 'HEAD')) {
+      renderHomepage(req, res);
+    } else if (pathname === '/api/verify-email' && method === 'POST') {
+      await handleSignupSubmission(req, res);
+    } else if (pathname === '/api/verify-email/confirm' && method === 'POST') {
+      await handleOtpConfirmation(req, res);
+    } else {
+      throw new HttpError(404, 'Page not found.');
+    }
+  };
+
+  route().catch((err: unknown) => {
+    if (res.headersSent) {
+      res.destroy();
+      return;
+    }
+    if (err instanceof HttpError) {
+      renderError(res, err.status, err.message);
+    } else {
+      console.error('Unhandled request error:', err);
+      renderError(res, 500, 'Unexpected server error.');
+    }
+  });
+});
+
+server.listen(PORT, () => {
+  console.log(`The Daily Grind listening on http://localhost:${PORT} (RP origin ${RP_ORIGIN})`);
+  if (!ORIGIN_TRIAL_TOKEN) {
+    console.warn('ORIGIN_TRIAL_TOKEN is not set; browser-assisted email verification is disabled.');
+  }
+});
