+++ b/src/session.ts
@@ -0,0 +1,131 @@
+import { randomBytes } from 'node:crypto';
+import type { IncomingMessage, ServerResponse } from 'node:http';
+
+export const SESSION_COOKIE = 'dg_sid';
+const SESSION_TTL_MS = 30 * 60 * 1000;
+const NONCE_TTL_MS = 10 * 60 * 1000;
+
+export interface PendingVerification {
+  email: string;
+  name: string;
+  codeHash: string;
+  expiresAt: number;
+  attemptsLeft: number;
+}
+
+interface SessionState {
+  /** Single-use nonce for the email-verification-token input, never sent in a cookie. */
+  evtNonce?: { value: string; expiresAt: number };
+  /** Pending fallback (OTP email) verification for this session. */
+  pending?: PendingVerification;
+  expiresAt: number;
+}
+
+/**
+ * Server-side session store. In-memory for this demo; swap for Redis or a
+ * database (with an atomic GETDEL) when running more than one instance.
+ */
+const sessions = new Map<string, SessionState>();
+
+setInterval(() => {
+  const now = Date.now();
+  for (const [id, state] of sessions) {
+    if (state.expiresAt <= now) sessions.delete(id);
+  }
+}, 60_000).unref();
+
+function parseCookies(header: string | undefined): Record<string, string> {
+  const out: Record<string, string> = {};
+  if (!header) return out;
+  for (const part of header.split(';')) {
+    const idx = part.indexOf('=');
+    if (idx === -1) continue;
+    const key = part.slice(0, idx).trim();
+    const value = part.slice(idx + 1).trim();
+    if (key) {
+      try {
+        out[key] = decodeURIComponent(value);
+      } catch {
+        out[key] = value;
+      }
+    }
+  }
+  return out;
+}
+
+function getSessionId(req: IncomingMessage): string | undefined {
+  const id = parseCookies(req.headers.cookie)[SESSION_COOKIE];
+  return id && /^[A-Za-z0-9_-]{43}$/.test(id) ? id : undefined;
+}
+
+function getLiveSession(id: string | undefined): SessionState | undefined {
+  if (!id) return undefined;
+  const state = sessions.get(id);
+  if (!state) return undefined;
+  if (state.expiresAt <= Date.now()) {
+    sessions.delete(id);
+    return undefined;
+  }
+  return state;
+}
+
+/** Returns the existing session (or creates one), setting the session cookie. */
+function ensureSession(req: IncomingMessage, res: ServerResponse): SessionState {
+  let id = getSessionId(req);
+  let state = getLiveSession(id);
+  if (!id || !state) {
+    id = randomBytes(32).toString('base64url');
+    state = { expiresAt: 0 };
+    sessions.set(id, state);
+  }
+  state.expiresAt = Date.now() + SESSION_TTL_MS;
+  res.setHeader(
+    'Set-Cookie',
+    `${SESSION_COOKIE}=${id}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${SESSION_TTL_MS / 1000}`,
+  );
+  return state;
+}
+
+/** Generates a fresh 256-bit nonce for this form render and stores it server-side. */
+export function issueFormNonce(req: IncomingMessage, res: ServerResponse): string {
+  const state = ensureSession(req, res);
+  const value = randomBytes(32).toString('base64url');
+  state.evtNonce = { value, expiresAt: Date.now() + NONCE_TTL_MS };
+  return value;
+}
+
+/**
+ * Atomically reads and deletes the single-use nonce for the request's session.
+ * (Synchronous read+delete cannot interleave with another request in Node's event loop.)
+ */
+export function consumeSessionNonce(req: IncomingMessage): string | undefined {
+  const state = getLiveSession(getSessionId(req));
+  const nonce = state?.evtNonce;
+  if (state) delete state.evtNonce;
+  if (!nonce || nonce.expiresAt <= Date.now()) return undefined;
+  return nonce.value;
+}
+
+export function setPendingVerification(
+  req: IncomingMessage,
+  res: ServerResponse,
+  pending: PendingVerification,
+): void {
+  ensureSession(req, res).pending = pending;
+}
+
+export function getPendingVerification(req: IncomingMessage): PendingVerification | undefined {
+  const state = getLiveSession(getSessionId(req));
+  const pending = state?.pending;
+  if (!state || !pending) return undefined;
+  if (pending.expiresAt <= Date.now()) {
+    delete state.pending;
+    return undefined;
+  }
+  return pending;
+}
+
+export function clearPendingVerification(req: IncomingMessage): void {
+  const state = getLiveSession(getSessionId(req));
+  if (state) delete state.pending;
+}
