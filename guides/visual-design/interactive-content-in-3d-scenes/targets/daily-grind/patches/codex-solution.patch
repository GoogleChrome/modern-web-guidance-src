--- a/index.html
+++ b/index.html
@@ -74,6 +74,7 @@
 
     /* Hero Section */
     .hero {
+      position: relative;
       height: 60vh;
       background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
         url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
@@ -93,6 +94,40 @@
       margin-bottom: 1rem;
     }
 
+    .hero-content {
+      width: min(620px, 100%);
+      padding: 20px;
+      text-align: center;
+      color: white;
+    }
+
+    .hero canvas {
+      position: absolute;
+      inset: 0;
+      width: 100%;
+      height: 100%;
+    }
+
+    .hero canvas[hidden] { display: none; }
+
+    .hero canvas .hero-content {
+      width: min(620px, calc(100vw - 40px));
+      transform-origin: 0 0;
+    }
+
+    a:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @media (max-width: 600px) {
+      nav { flex-direction: column; gap: 12px; }
+      nav ul { flex-wrap: wrap; justify-content: center; gap: 12px; }
+      nav ul li { margin-left: 0; }
+      .hero h1 { font-size: 2.2rem; }
+      .hero { min-height: 380px; }
+    }
+
     /* Content Sections */
     .container {
       max-width: 1100px;
