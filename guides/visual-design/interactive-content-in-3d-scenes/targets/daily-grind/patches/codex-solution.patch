new file mode 100644
index 0000000..87c6375
--- /dev/null
+++ b/src/hero-scene.ts
@@ -0,0 +1,251 @@
+// Keep experimental APIs local and optional: partial implementations also fall back.
+interface CanvasPaintEvent extends Event {
+  changedElements?: readonly Element[];
+}
+interface HTMLSceneCanvas extends HTMLCanvasElement {
+  requestPaint?: () => void;
+  onpaint?: ((event: CanvasPaintEvent) => void) | null;
+  getElementTransform?: (element: Element, matrix: DOMMatrix) => DOMMatrix;
+}
+interface HTMLSceneGL extends WebGL2RenderingContext {
+  texElementImage2D?: (target: number, internalFormat: number, element: Element) => void;
+}
+
+function enhanceHero(canvas: HTMLSceneCanvas, content: HTMLElement): void {
+  // The HTML remains visible and functional, including when JavaScript is disabled.
+  if (!('requestPaint' in HTMLCanvasElement.prototype) ||
+      typeof canvas.requestPaint !== 'function' ||
+      typeof canvas.getElementTransform !== 'function' ||
+      typeof ResizeObserver === 'undefined' || typeof DOMMatrix === 'undefined') return;
+
+  let gl: HTMLSceneGL | null;
+  try {
+    gl = canvas.getContext('webgl2', { alpha: true, premultipliedAlpha: true });
+  } catch {
+    return;
+  }
+  if (!gl || typeof gl.texElementImage2D !== 'function') return;
+  const context = gl;
+  const originalParent = content.parentElement;
+  if (!originalParent) return;
+  const originalNextSibling = content.nextSibling;
+  const shaders: WebGLShader[] = [];
+  let program: WebGLProgram | null = null;
+  let buffer: WebGLBuffer | null = null;
+  let texture: WebGLTexture | null = null;
+  let observer: ResizeObserver | undefined;
+  let frame = 0;
+  let stopped = false;
+  let dirty = true;
+  let dprQuery: MediaQueryList | undefined;
+
+  function fallback(): void {
+    if (stopped) return;
+    stopped = true;
+    cancelAnimationFrame(frame);
+    observer?.disconnect();
+    window.removeEventListener('resize', onWindowResize);
+    window.removeEventListener('pagehide', onPageHide);
+    dprQuery?.removeEventListener('change', onDprChange);
+    canvas.removeEventListener('webglcontextlost', fallback);
+    canvas.onpaint = null;
+    content.style.removeProperty('transform');
+    originalParent!.insertBefore(content, originalNextSibling);
+    canvas.hidden = true;
+    shaders.forEach(shader => context.deleteShader(shader));
+    context.deleteTexture(texture);
+    context.deleteBuffer(buffer);
+    context.deleteProgram(program);
+  }
+
+  function onPageHide(event: PageTransitionEvent): void {
+    if (!event.persisted) fallback();
+  }
+
+  function resize(entry?: ResizeObserverEntry): void {
+    if (stopped) return;
+    const rect = canvas.getBoundingClientRect();
+    const physical = entry?.devicePixelContentBoxSize?.[0];
+    const expectedWidth = Math.round(rect.width * devicePixelRatio);
+    const expectedHeight = Math.round(rect.height * devicePixelRatio);
+    // Some emulated displays report physical boxes at the host's scale factor.
+    // Retain the observer's pixel snapping only when it matches the active DPR.
+    const validPhysical = physical && Math.abs(physical.inlineSize - expectedWidth) <= 1 &&
+      Math.abs(physical.blockSize - expectedHeight) <= 1;
+    const width = Math.max(1, validPhysical ? physical.inlineSize : expectedWidth);
+    const height = Math.max(1, validPhysical ? physical.blockSize : expectedHeight);
+    if (canvas.width !== width || canvas.height !== height) {
+      canvas.width = width;
+      canvas.height = height;
+      dirty = true;
+    }
+  }
+
+  function onDprChange(): void {
+    resize();
+    watchDpr();
+  }
+
+  function onWindowResize(): void {
+    resize();
+  }
+
+  function watchDpr(): void {
+    dprQuery?.removeEventListener('change', onDprChange);
+    dprQuery = matchMedia(`(resolution: ${devicePixelRatio}dppx)`);
+    dprQuery.addEventListener('change', onDprChange);
+  }
+
+  function compile(type: number, source: string): WebGLShader {
+    const shader = context.createShader(type);
+    if (!shader) throw new Error('Shader allocation failed');
+    shaders.push(shader);
+    context.shaderSource(shader, source);
+    context.compileShader(shader);
+    if (!context.getShaderParameter(shader, context.COMPILE_STATUS)) {
+      throw new Error(context.getShaderInfoLog(shader) ?? 'Shader compilation failed');
+    }
+    return shader;
+  }
+
+  try {
+    const vertex = compile(context.VERTEX_SHADER, `#version 300 es
+      in vec2 position;
+      uniform mat4 mvp;
+      out vec2 uv;
+      void main() {
+        uv = vec2(position.x + 0.5, 0.5 - position.y);
+        gl_Position = mvp * vec4(position, 0.0, 1.0);
+      }`);
+    const fragment = compile(context.FRAGMENT_SHADER, `#version 300 es
+      precision mediump float;
+      uniform sampler2D htmlTexture;
+      in vec2 uv;
+      out vec4 color;
+      void main() { color = texture(htmlTexture, uv); }`);
+    program = context.createProgram();
+    if (!program) throw new Error('Program allocation failed');
+    context.attachShader(program, vertex);
+    context.attachShader(program, fragment);
+    context.linkProgram(program);
+    if (!context.getProgramParameter(program, context.LINK_STATUS)) {
+      throw new Error(context.getProgramInfoLog(program) ?? 'Program linking failed');
+    }
+    context.useProgram(program);
+    buffer = context.createBuffer();
+    texture = context.createTexture();
+    if (!buffer || !texture) throw new Error('GPU allocation failed');
+    context.bindBuffer(context.ARRAY_BUFFER, buffer);
+    context.bufferData(context.ARRAY_BUFFER, new Float32Array([
+      -0.5, -0.5, 0.5, -0.5, -0.5, 0.5, 0.5, 0.5,
+    ]), context.STATIC_DRAW);
+    const position = context.getAttribLocation(program, 'position');
+    context.enableVertexAttribArray(position);
+    context.vertexAttribPointer(position, 2, context.FLOAT, false, 0, 0);
+    context.activeTexture(context.TEXTURE0);
+    context.bindTexture(context.TEXTURE_2D, texture);
+    context.texParameteri(context.TEXTURE_2D, context.TEXTURE_MIN_FILTER, context.LINEAR);
+    context.texParameteri(context.TEXTURE_2D, context.TEXTURE_MAG_FILTER, context.LINEAR);
+    context.texParameteri(context.TEXTURE_2D, context.TEXTURE_WRAP_S, context.CLAMP_TO_EDGE);
+    context.texParameteri(context.TEXTURE_2D, context.TEXTURE_WRAP_T, context.CLAMP_TO_EDGE);
+    context.uniform1i(context.getUniformLocation(program, 'htmlTexture'), 0);
+    const mvpUniform = context.getUniformLocation(program, 'mvp');
+    if (mvpUniform === null) throw new Error('Missing matrix uniform');
+
+    // Move the actual DOM, preserving native focus, selection and link behavior.
+    canvas.append(content);
+    canvas.hidden = false;
+    canvas.addEventListener('webglcontextlost', fallback);
+
+    canvas.onpaint = (event): void => {
+      if (stopped || (!dirty && event.changedElements?.length === 0)) return;
+      try {
+        const cssWidth = canvas.clientWidth;
+        const cssHeight = canvas.clientHeight;
+        if (!cssWidth || !cssHeight || !content.offsetWidth || !content.offsetHeight) return;
+        const gridWidth = content.offsetWidth * canvas.width / cssWidth;
+        const gridHeight = content.offsetHeight * canvas.height / cssHeight;
+        const aspect = canvas.width / canvas.height;
+        const distance = 3;
+        const f = 1 / Math.tan(Math.PI / 8);
+        const near = 0.1;
+        const far = 100;
+        const projection = new DOMMatrix([
+          f / aspect, 0, 0, 0,
+          0, f, 0, 0,
+          0, 0, (far + near) / (near - far), -1,
+          0, 0, 2 * far * near / (near - far), 0,
+        ]);
+        const unitsPerPixel = 2 * distance / (f * canvas.height);
+        const modelView = new DOMMatrix().translate(0, 0, -distance)
+          .rotate(0, -6, 0)
+          .scale(gridWidth * unitsPerPixel, gridHeight * unitsPerPixel, 1);
+        // Use exactly the same MVP for drawing and DOM hit testing.
+        const mvp = projection.multiply(modelView);
+        const normalization = new DOMMatrix()
+          .scale(1 / gridWidth, -1 / gridHeight, 1 / gridHeight)
+          .translate(-gridWidth / 2, -gridHeight / 2);
+        const viewport = new DOMMatrix()
+          .translate(canvas.width / 2, canvas.height / 2)
+          .scale(canvas.width / 2, -canvas.height / 2, canvas.height / 2);
+        const screenSpace = viewport.multiply(mvp).multiply(normalization);
+        let transform = canvas.getElementTransform!(content, screenSpace);
+        // Reinitializing preserves all 16 entries on older Chromium builds.
+        if (transform.is2D) {
+          transform = DOMMatrix.fromFloat64Array(transform.toFloat64Array());
+        }
+        const cssTransform = transform.toString();
+        if (content.style.transform !== cssTransform) content.style.transform = cssTransform;
+
+        context.bindTexture(context.TEXTURE_2D, texture);
+        context.texElementImage2D!(context.TEXTURE_2D, context.RGBA8, content);
+        if (context.getError() !== context.NO_ERROR) throw new Error('HTML texture upload failed');
+        context.viewport(0, 0, canvas.width, canvas.height);
+        context.clearColor(0, 0, 0, 0);
+        context.clear(context.COLOR_BUFFER_BIT);
+        context.uniformMatrix4fv(mvpUniform, false, mvp.toFloat32Array());
+        context.drawArrays(context.TRIANGLE_STRIP, 0, 4);
+        dirty = false;
+      } catch {
+        fallback();
+      }
+    };
+
+    // Observe once, outside onpaint. Element size changes also invalidate the scene.
+    observer = new ResizeObserver(entries => {
+      const entry = entries.find(item => item.target === canvas);
+      if (entry) resize(entry);
+      dirty = true;
+    });
+    const supportsDevicePixels = typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    try {
+      observer.observe(canvas, supportsDevicePixels ? { box: 'device-pixel-content-box' } : {});
+    } catch {
+      observer.observe(canvas);
+    }
+    observer.observe(content);
+    window.addEventListener('resize', onWindowResize);
+    window.addEventListener('pagehide', onPageHide);
+    watchDpr();
+    resize();
+    function requestFrame(): void {
+      if (stopped) return;
+      try {
+        canvas.requestPaint!();
+        if (!stopped) frame = requestAnimationFrame(requestFrame);
+      } catch {
+        fallback();
+      }
+    }
+    frame = requestAnimationFrame(requestFrame);
+  } catch {
+    fallback();
+  }
+}
+
+const canvas = document.getElementById('hero-canvas');
+const content = document.getElementById('hero-content');
+if (canvas instanceof HTMLCanvasElement && content instanceof HTMLElement) {
+  enhanceHero(canvas, content);
+}
diff --git a/tests/hero.spec.ts b/tests/hero.spec.ts
