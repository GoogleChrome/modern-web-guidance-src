index 0000000..d2dd5a2
--- /dev/null
+++ b/tests/hero.spec.ts
@@ -0,0 +1,75 @@
+import { expect, test } from '@playwright/test';
+
+test('unsupported browsers retain a visible, keyboard-accessible order link', async ({ page }) => {
+  await page.addInitScript(() => {
+    Reflect.deleteProperty(HTMLCanvasElement.prototype, 'requestPaint');
+  });
+  await page.goto('/');
+  await expect(page.locator('#hero-canvas')).toBeHidden();
+  await expect(page.getByRole('heading', { level: 1 })).toBeVisible();
+  const order = page.getByRole('link', { name: 'Order Now' });
+  await order.focus();
+  await expect(order).toBeFocused();
+  await page.keyboard.press('Enter');
+  await expect(page).toHaveURL(/\/order-online$/);
+});
+
+test('HTML remains visible with JavaScript disabled', async ({ browser, baseURL }) => {
+  const context = await browser.newContext({ javaScriptEnabled: false });
+  const page = await context.newPage();
+  await page.goto(baseURL!);
+  await expect(page.getByRole('link', { name: 'Order Now' })).toBeVisible();
+  await context.close();
+});
+
+test('partial API support falls back without hiding content', async ({ page }) => {
+  await page.addInitScript(() => {
+    Reflect.deleteProperty(WebGL2RenderingContext.prototype, 'texElementImage2D');
+  });
+  await page.goto('/');
+  await expect(page.locator('#hero-canvas')).toBeHidden();
+  await expect(page.locator('.hero > #hero-content')).toBeVisible();
+});
+
+test('native canvas renders HTML, updates it, and preserves pointer interaction', async ({ page }) => {
+  const errors: string[] = [];
+  page.on('pageerror', error => errors.push(error.message));
+  await page.goto('/');
+  const canvas = page.locator('#hero-canvas');
+  await expect(canvas).toBeVisible();
+  await expect(page.locator('canvas > #hero-content')).toHaveCSS('transform', /matrix3d/);
+  await page.locator('#hero-content h1').evaluate(element => { element.textContent = 'Freshly roasted for you'; });
+  await expect(page.getByRole('heading', { name: 'Freshly roasted for you' })).toBeVisible();
+  await expect(canvas).toBeVisible();
+  await page.getByRole('link', { name: 'Order Now' }).click();
+  await expect(page).toHaveURL(/\/order-online$/);
+  expect(errors).toEqual([]);
+});
+
+test('native scene tracks device pixels on desktop and mobile resize', async ({ browser, baseURL }) => {
+  const context = await browser.newContext({ deviceScaleFactor: 2 });
+  const page = await context.newPage();
+  await page.goto(baseURL!);
+  for (const viewport of [{ width: 1000, height: 800 }, { width: 390, height: 844 }]) {
+    await page.setViewportSize(viewport);
+    await expect.poll(() => page.locator('canvas').evaluate(canvas => {
+      return [canvas.width, canvas.height];
+    })).toEqual([viewport.width * 2, Math.round(Math.max(380, viewport.height * 0.6) * 2)]);
+    await expect(page.locator('canvas > #hero-content')).toHaveCSS('transform', /matrix3d/);
+  }
+  await page.getByRole('link', { name: 'Order Now' }).click();
+  await expect(page).toHaveURL(/\/order-online$/);
+  await context.close();
+});
+
+test('context loss restores the same DOM and clears its projection', async ({ page }) => {
+  await page.goto('/');
+  await expect(page.locator('canvas > #hero-content')).toHaveCSS('transform', /matrix3d/);
+  await page.locator('canvas').evaluate(canvas => {
+    canvas.getContext('webgl2')?.getExtension('WEBGL_lose_context')?.loseContext();
+  });
+  await expect(page.locator('#hero-canvas')).toBeHidden();
+  await expect(page.locator('.hero > #hero-content')).toHaveCSS('transform', 'none');
+  await page.getByRole('link', { name: 'Order Now' }).click();
+  await expect(page).toHaveURL(/\/order-online$/);
+});
