diff --git a/src/utils/interactive-canvas.ts b/src/utils/interactive-canvas.ts
new file mode 100644
index 0000000..c815728
--- /dev/null
+++ b/src/utils/interactive-canvas.ts
@@ -0,0 +1,453 @@
+/**
+ * Utilities for HTML-in-Canvas interactive 3D rendering.
+ * Implements guidance for rendering real DOM descendant elements directly inside WebGL/WebGPU canvases.
+ */
+
+export interface Interactive3DOptions {
+  canvas: HTMLCanvasElement;
+  uiElement: HTMLElement;
+  fallbackElement?: HTMLElement | null;
+  statusElement?: HTMLElement | null;
+}
+
+/**
+ * Feature detection for HTML-in-Canvas.
+ * MUST be conducted before using the HTML-in-Canvas API.
+ */
+export function isHtmlInCanvasSupported(): boolean {
+  return 'requestPaint' in HTMLCanvasElement.prototype;
+}
+
+/**
+ * Setup screen size observer to scale canvas to match device pixels and prevent blurriness.
+ */
+export function setupDevicePixelResizeObserver(
+  canvas: HTMLCanvasElement,
+  onResize?: () => void
+): ResizeObserver {
+  const observer = new ResizeObserver(([entry]) => {
+    const dpc = (entry as any).devicePixelContentBoxSize;
+    canvas.width = dpc
+      ? dpc[0].inlineSize
+      : Math.round(entry.contentRect.width * window.devicePixelRatio);
+    canvas.height = dpc
+      ? dpc[0].blockSize
+      : Math.round(entry.contentRect.height * window.devicePixelRatio);
+
+    if (onResize) {
+      onResize();
+    } else if (isHtmlInCanvasSupported() && typeof canvas.requestPaint === 'function') {
+      canvas.requestPaint();
+    }
+  });
+
+  const supportsDevicePixelContentBox =
+    typeof ResizeObserverEntry !== 'undefined' &&
+    'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+  const options: ResizeObserverOptions = supportsDevicePixelContentBox
+    ? { box: 'device-pixel-content-box' as ResizeObserverBoxOptions }
+    : {};
+
+  observer.observe(canvas, options);
+  return observer;
+}
+
+/**
+ * Updates the CSS transform property of the descendant HTML element
+ * based on the 3D MVP transform matrix calculated during canvas rendering.
+ */
+export function updateElementTransform(
+  canvas: HTMLCanvasElement,
+  targetHTMLElement: HTMLElement,
+  htmlElementMVP: Float32Array | number[]
+): void {
+  if (typeof canvas.getElementTransform === 'function') {
+    // 1. Convert WebGL MVP Matrix to DOM Matrix
+    const mvpDOM = new DOMMatrix(Array.from(htmlElementMVP));
+
+    // 2. Normalize the HTML element (Canvas Grid pixels -> WebGL Model Space)
+    const clientWidth = canvas.clientWidth || canvas.width || 1;
+    const clientHeight = canvas.clientHeight || canvas.height || 1;
+    const dprX = canvas.width / clientWidth;
+    const dprY = canvas.height / clientHeight;
+    const gridWidth = (targetHTMLElement.offsetWidth || 200) * dprX;
+    const gridHeight = (targetHTMLElement.offsetHeight || 150) * dprY;
+
+    const toGLModel = new DOMMatrix()
+      // Scale pixels to 1 unit, flip Y (as in CSS it points down, and in WebGL it points up)
+      .scale(1 / gridWidth, -1 / gridHeight, 1 / gridHeight)
+      // Center the origin: (0,0) becomes (-width/2, -height/2) before scaling
+      .translate(-gridWidth / 2, -gridHeight / 2);
+
+    // 3. Map to the canvas viewport
+    const clipToCanvasViewport = new DOMMatrix()
+      // Move center (0,0) to center of canvas
+      .translate(canvas.width / 2, canvas.height / 2)
+      // Scale normalized clip (-1..1) to viewport size
+      .scale(canvas.width / 2, -canvas.height / 2, canvas.height / 2);
+
+    // 4. Multiply: (Clip -> Pixels) * (MVP) * (pixels -> unit square)
+    const screenSpaceTransform = clipToCanvasViewport
+      .multiply(mvpDOM)
+      .multiply(toGLModel);
+
+    // 5. Apply to the transform
+    let computedTransform = canvas.getElementTransform(
+      targetHTMLElement,
+      screenSpaceTransform,
+    );
+
+    if (computedTransform && computedTransform.is2D) {
+      // Workaround for Chromium bug https://crbug.com/512171941
+      // affecting Chrome versions under 149 where `transform.is2D`
+      // is incorrectly true for a 3D DOMMatrix.
+      computedTransform = DOMMatrix.fromFloat64Array(computedTransform.toFloat64Array());
+    }
+
+    if (computedTransform) {
+      targetHTMLElement.style.transform = computedTransform.toString();
+    }
+  } else {
+    // Fallback if getElementTransform is not available
+    const mvpDOM = new DOMMatrix(Array.from(htmlElementMVP));
+    const clientWidth = canvas.clientWidth || 1;
+    const clientHeight = canvas.clientHeight || 1;
+    const dprX = canvas.width / clientWidth;
+    const dprY = canvas.height / clientHeight;
+    const gridWidth = (targetHTMLElement.offsetWidth || 200) * dprX;
+    const gridHeight = (targetHTMLElement.offsetHeight || 150) * dprY;
+
+    const toGLModel = new DOMMatrix()
+      .scale(1 / gridWidth, -1 / gridHeight, 1 / gridHeight)
+      .translate(-gridWidth / 2, -gridHeight / 2);
+
+    const clipToCanvasViewport = new DOMMatrix()
+      .translate(canvas.width / 2, canvas.height / 2)
+      .scale(canvas.width / 2, -canvas.height / 2, canvas.height / 2);
+
+    const screenSpaceTransform = clipToCanvasViewport
+      .multiply(mvpDOM)
+      .multiply(toGLModel);
+
+    targetHTMLElement.style.transform = screenSpaceTransform.toString();
+  }
+}
+
+/**
+ * Fallback UI strategy for browsers that do not support HTML-in-Canvas.
+ * Places the interactive HTML content on top of the canvas using CSS so users can still interact.
+ */
+export function applyFallbackStrategy(
+  canvas: HTMLCanvasElement,
+  uiElement: HTMLElement,
+  fallbackElement?: HTMLElement | null,
+  statusElement?: HTMLElement | null
+): void {
+  canvas.classList.add('canvas-fallback');
+  if (statusElement) {
+    statusElement.textContent = 'Fallback Mode';
+    statusElement.className = 'px-2.5 py-1 text-xs rounded-full bg-gray-500/20 text-gray-300 font-medium';
+  }
+
+  // Display the HTML content on top of the canvas using CSS
+  uiElement.style.position = 'absolute';
+  uiElement.style.top = '50%';
+  uiElement.style.left = '50%';
+  uiElement.style.transform = 'translate(-50%, -50%)';
+  uiElement.style.zIndex = '10';
+  uiElement.style.pointerEvents = 'auto';
+
+  if (fallbackElement) {
+    fallbackElement.classList.remove('hidden');
+    fallbackElement.style.display = 'flex';
+  }
+}
+
+// 4x4 matrix helper functions
+function mat4Perspective(out: Float32Array, fovy: number, aspect: number, near: number, far: number): Float32Array {
+  const f = 1.0 / Math.tan(fovy / 2);
+  const nf = 1 / (near - far);
+  out[0] = f / aspect; out[1] = 0; out[2] = 0; out[3] = 0;
+  out[4] = 0; out[5] = f; out[6] = 0; out[7] = 0;
+  out[8] = 0; out[9] = 0; out[10] = (far + near) * nf; out[11] = -1;
+  out[12] = 0; out[13] = 0; out[14] = 2 * far * near * nf; out[15] = 0;
+  return out;
+}
+
+function mat4Translate(out: Float32Array, a: Float32Array, v: [number, number, number]): Float32Array {
+  const x = v[0], y = v[1], z = v[2];
+  if (a !== out) out.set(a);
+  out[12] = a[0] * x + a[4] * y + a[8] * z + a[12];
+  out[13] = a[1] * x + a[5] * y + a[9] * z + a[13];
+  out[14] = a[2] * x + a[6] * y + a[10] * z + a[14];
+  out[15] = a[3] * x + a[7] * y + a[11] * z + a[15];
+  return out;
+}
+
+function mat4RotateY(out: Float32Array, a: Float32Array, rad: number): Float32Array {
+  const s = Math.sin(rad);
+  const c = Math.cos(rad);
+  const a00 = a[0], a01 = a[1], a02 = a[2], a03 = a[3];
+  const a20 = a[8], a21 = a[9], a22 = a[10], a23 = a[11];
+  if (a !== out) out.set(a);
+  out[0] = a00 * c - a20 * s;
+  out[1] = a01 * c - a21 * s;
+  out[2] = a02 * c - a22 * s;
+  out[3] = a03 * c - a23 * s;
+  out[8] = a00 * s + a20 * c;
+  out[9] = a01 * s + a21 * c;
+  out[10] = a02 * s + a22 * c;
+  out[11] = a03 * s + a23 * c;
+  return out;
+}
+
+function mat4Multiply(out: Float32Array, a: Float32Array, b: Float32Array): Float32Array {
+  const a00 = a[0], a01 = a[1], a02 = a[2], a03 = a[3];
+  const a10 = a[4], a11 = a[5], a12 = a[6], a13 = a[7];
+  const a20 = a[8], a21 = a[9], a22 = a[10], a23 = a[11];
+  const a30 = a[12], a31 = a[13], a32 = a[14], a33 = a[15];
+
+  let b0 = b[0], b1 = b[1], b2 = b[2], b3 = b[3];
+  out[0] = b0 * a00 + b1 * a10 + b2 * a20 + b3 * a30;
+  out[1] = b0 * a01 + b1 * a11 + b2 * a21 + b3 * a31;
+  out[2] = b0 * a02 + b1 * a12 + b2 * a22 + b3 * a32;
+  out[3] = b0 * a03 + b1 * a13 + b2 * a23 + b3 * a33;
+
+  b0 = b[4]; b1 = b[5]; b2 = b[6]; b3 = b[7];
+  out[4] = b0 * a00 + b1 * a10 + b2 * a20 + b3 * a30;
+  out[5] = b0 * a01 + b1 * a11 + b2 * a21 + b3 * a31;
+  out[6] = b0 * a02 + b1 * a12 + b2 * a22 + b3 * a32;
+  out[7] = b0 * a03 + b1 * a13 + b2 * a23 + b3 * a33;
+
+  b0 = b[8]; b1 = b[9]; b2 = b[10]; b3 = b[11];
+  out[8] = b0 * a00 + b1 * a10 + b2 * a20 + b3 * a30;
+  out[9] = b0 * a01 + b1 * a11 + b2 * a21 + b3 * a31;
+  out[10] = b0 * a02 + b1 * a12 + b2 * a22 + b3 * a32;
+  out[11] = b0 * a03 + b1 * a13 + b2 * a23 + b3 * a33;
+
+  b0 = b[12]; b1 = b[13]; b2 = b[14]; b3 = b[15];
+  out[12] = b0 * a00 + b1 * a10 + b2 * a20 + b3 * a30;
+  out[13] = b0 * a01 + b1 * a11 + b2 * a21 + b3 * a31;
+  out[14] = b0 * a02 + b1 * a12 + b2 * a22 + b3 * a32;
+  out[15] = b0 * a03 + b1 * a13 + b2 * a23 + b3 * a33;
+  return out;
+}
+
+/**
+ * Initializes interactive 3D HTML-in-Canvas scene.
+ */
+export function initInteractive3DScene(options: Interactive3DOptions): () => void {
+  const { canvas, uiElement, fallbackElement, statusElement } = options;
+
+  // 1. Feature detection: Check if HTML-in-Canvas is supported in the browser
+  if (!isHtmlInCanvasSupported()) {
+    applyFallbackStrategy(canvas, uiElement, fallbackElement, statusElement);
+    return () => {};
+  }
+
+  // 2. Add layoutsubtree attribute to the canvas element
+  canvas.setAttribute('layoutsubtree', 'true');
+
+  if (statusElement) {
+    statusElement.textContent = 'Active (HTML-in-Canvas)';
+    statusElement.className = 'px-2.5 py-1 text-xs rounded-full bg-green-500/20 text-green-400 font-medium';
+  }
+
+  // Initialize WebGL context
+  const gl = canvas.getContext('webgl2') || canvas.getContext('webgl');
+  if (!gl) {
+    applyFallbackStrategy(canvas, uiElement, fallbackElement, statusElement);
+    return () => {};
+  }
+
+  // Shaders
+  const vsSource = `
+    attribute vec4 aVertexPosition;
+    attribute vec2 aTextureCoord;
+    uniform mat4 uModelViewMatrix;
+    uniform mat4 uProjectionMatrix;
+    varying highp vec2 vTextureCoord;
+    void main(void) {
+      gl_Position = uProjectionMatrix * uModelViewMatrix * aVertexPosition;
+      vTextureCoord = aTextureCoord;
+    }
+  `;
+
+  const fsSource = `
+    varying highp vec2 vTextureCoord;
+    uniform sampler2D uSampler;
+    void main(void) {
+      gl_FragColor = texture2D(uSampler, vTextureCoord);
+    }
+  `;
+
+  function createShader(glCtx: WebGLRenderingContext | WebGL2RenderingContext, type: number, src: string) {
+    const shader = glCtx.createShader(type);
+    if (!shader) return null;
+    glCtx.shaderSource(shader, src);
+    glCtx.compileShader(shader);
+    if (!glCtx.getShaderParameter(shader, glCtx.COMPILE_STATUS)) {
+      glCtx.deleteShader(shader);
+      return null;
+    }
+    return shader;
+  }
+
+  const vShader = createShader(gl, gl.VERTEX_SHADER, vsSource);
+  const fShader = createShader(gl, gl.FRAGMENT_SHADER, fsSource);
