+---
+// Interactive 3D News Showcase using HTML-in-Canvas
+---
+
+<section class="my-8 w-full max-w-6xl mx-auto px-4" aria-label="Interactive 3D Experience">
+  <div class="bg-slate-900 border border-slate-700 rounded-xl overflow-hidden shadow-2xl">
+    <!-- Showcase Header -->
+    <div class="flex items-center justify-between px-6 py-4 bg-slate-800/80 border-b border-slate-700">
+      <div>
+        <span class="text-xs font-semibold uppercase tracking-wider text-amber-400">Interactive Feature</span>
+        <h2 class="text-xl md:text-2xl font-bold text-white">3D Interactive News Dimension</h2>
+      </div>
+      <div class="flex items-center gap-2">
+        <span id="canvas-status-badge" class="px-2.5 py-1 text-xs rounded-full bg-amber-500/20 text-amber-400 font-medium">
+          Checking HTML-in-Canvas...
+        </span>
+      </div>
+    </div>
+
+    <!-- 3D Canvas Viewport -->
+    <div class="relative w-full h-[480px] bg-slate-950 flex items-center justify-center overflow-hidden">
+      <!--
+        The <canvas> element includes the layoutsubtree attribute to expose
+        descendant HTML elements to browser features and DOM rendering.
+      -->
+      <canvas
+        id="interactive-3d-canvas"
+        layoutsubtree="true"
+        class="w-full h-full block cursor-grab active:cursor-grabbing"
+      >
+        <!--
+          Descendant HTML element exposed to browser features and projected into 3D scene.
+          Users can natively select text, focus inputs, and click buttons.
+        -->
+        <div
+          id="interactive-3d-html-element"
+          class="interactive-dom-layer bg-white/95 backdrop-blur-md p-6 rounded-xl shadow-2xl border border-white/30 text-gray-900 w-72 select-text"
+        >
+          <div class="flex items-center justify-between mb-2">
+            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-600 bg-amber-100 px-2 py-0.5 rounded">Live DOM</span>
+            <span class="text-xs text-gray-400">WebGL 3D</span>
+          </div>
+          <h3 class="text-base font-bold text-gray-900 mb-1 leading-snug">The Future of Media</h3>
+          <p class="text-xs text-gray-600 mb-4 leading-relaxed">
+            Real interactive DOM rendered into a 3D canvas with synchronized pointer interactions.
+          </p>
+          <form id="interactive-quick-poll" class="space-y-2.5" onsubmit="return false;">
+            <div>
+              <label for="reader-comment-input" class="sr-only">Quick note</label>
+              <input
+                type="text"
+                id="reader-comment-input"
+                name="comment"
+                placeholder="Share your thought..."
+                class="w-full px-3 py-1.5 text-xs bg-gray-50 border border-gray-300 rounded focus:ring-2 focus:ring-amber-500 focus:outline-none focus:bg-white text-gray-800"
+              />
+            </div>
+            <div class="flex items-center gap-2">
+              <button
+                type="submit"
+                id="interactive-submit-button"
+                class="flex-1 py-1.5 px-3 bg-amber-600 hover:bg-amber-700 active:bg-amber-800 text-white text-xs font-semibold rounded shadow transition cursor-pointer"
+              >
+                Submit
+              </button>
+              <button
+                type="button"
+                id="interactive-reset-button"
+                class="py-1.5 px-3 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs font-semibold rounded transition cursor-pointer"
+              >
+                Clear
+              </button>
+            </div>
+            <p id="interactive-response-message" class="text-[11px] text-green-700 font-medium hidden">
+              Thank you for your interaction!
+            </p>
+          </form>
+        </div>
+      </canvas>
+
+      <!-- Fallback UI Strategy for browsers that do not support HTML-in-Canvas -->
+      <div
+        id="interactive-3d-fallback-ui"
+        class="fallback-ui hidden absolute inset-0 z-10 flex-col items-center justify-center bg-slate-900/90 text-white p-6 text-center pointer-events-auto"
+      >
+        <div class="bg-white text-gray-900 p-6 rounded-xl shadow-2xl max-w-sm w-full mx-4 border border-gray-200">
+          <div class="flex items-center justify-center w-10 h-10 mx-auto mb-3 bg-amber-100 rounded-full text-amber-600">
+            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
+              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
+            </svg>
+          </div>
+          <h3 class="text-base font-bold text-gray-900 mb-1">Standard Display Mode</h3>
+          <p class="text-xs text-gray-600 mb-4">
+            Your browser does not support the HTML-in-Canvas API. The interactive content is presented via CSS overlay fallback.
+          </p>
+          <div class="space-y-2">
+            <input
+              type="text"
+              placeholder="Share your thought..."
+              class="w-full px-3 py-1.5 text-xs bg-gray-50 border border-gray-300 rounded text-gray-800"
+            />
+            <button
+              type="button"
+              class="w-full py-1.5 px-3 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded shadow"
+            >
+              Submit Note
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+  </div>
+</section>
+
+<script>
+  import { initInteractive3DScene, isHtmlInCanvasSupported } from '../utils/interactive-canvas';
+
+  function setupScene() {
+    const canvas = document.getElementById('interactive-3d-canvas') as HTMLCanvasElement | null;
+    const uiElement = document.getElementById('interactive-3d-html-element') as HTMLElement | null;
+    const fallbackElement = document.getElementById('interactive-3d-fallback-ui') as HTMLElement | null;
+    const statusBadge = document.getElementById('canvas-status-badge') as HTMLElement | null;
+
+    if (!canvas || !uiElement) return;
+
+    // Hook up poll form interactivity
+    const pollForm = document.getElementById('interactive-quick-poll') as HTMLFormElement | null;
+    const commentInput = document.getElementById('reader-comment-input') as HTMLInputElement | null;
+    const responseMsg = document.getElementById('interactive-response-message') as HTMLElement | null;
+    const resetBtn = document.getElementById('interactive-reset-button') as HTMLButtonElement | null;
+
+    if (pollForm && commentInput && responseMsg) {
+      pollForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (commentInput.value.trim()) {
+          responseMsg.classList.remove('hidden');
+          if (isHtmlInCanvasSupported() && typeof canvas.requestPaint === 'function') {
+            canvas.requestPaint();
+          }
+        }
+      });
+    }
+
+    if (resetBtn && commentInput && responseMsg) {
+      resetBtn.addEventListener('click', () => {
+        commentInput.value = '';
+        responseMsg.classList.add('hidden');
+        if (isHtmlInCanvasSupported() && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+      });
+    }
+
+    // Initialize 3D scene with HTML-in-Canvas support, device pixel resize observer,
+    // onpaint handler, texElementImage2D, and CSS transform syncing.
+    initInteractive3DScene({
+      canvas,
+      uiElement,
+      fallbackElement,
+      statusElement: statusBadge,
+    });
+  }
+
+  // Initialize on DOM ready
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', setupScene);
+  } else {
+    setupScene();
+  }
+
+  // Support Astro view transitions / client router
+  document.addEventListener('astro:page-load', setupScene);
+</script>
