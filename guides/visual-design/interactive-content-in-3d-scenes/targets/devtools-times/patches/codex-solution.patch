@@ -0,0 +1,74 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+  articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<news-scene class="news-scene">
+  <h2 class="font-brand text-3xl mb-4">Explore the news</h2>
+  <div class="scene-stage" data-stage>
+    <canvas layoutsubtree hidden></canvas>
+    <!-- This same DOM card is moved into the canvas only after feature detection. -->
+    <div class="news-card" data-card>
+      <div aria-live="polite" aria-atomic="true">
+        {articles.map((article, index) => (
+          <article data-story hidden={index !== 0}>
+            <p class="eyebrow">{article.data.category} · {index + 1} of {articles.length}</p>
+            <h3 class="font-brand"><a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>{article.data.title}</a></h3>
+            <p class="summary">{article.data.summary}</p>
+            <a class="read-story" href={`${import.meta.env.BASE_URL}articles/${article.id}`}>Read story →</a>
+          </article>
+        ))}
+      </div>
+      <div class="card-actions">
+        <button type="button" data-next hidden>Next story</button>
+        <button type="button" data-angle hidden aria-pressed="false">Straighten card</button>
+      </div>
+    </div>
+  </div>
+</news-scene>
+
+<style>
+  .news-scene { display: block; padding: 24px; }
+  .scene-stage { background: #f3f0e8; border: 1px solid #ded8ca; padding: 32px 24px; }
+  canvas { width: 100%; display: block; }
+  canvas[hidden], [hidden] { display: none; }
+  .news-card { box-sizing: border-box; width: 100%; max-width: 600px; margin: auto; padding: 24px; background: #fff; color: #171717; border: 1px solid #bdb6a7; transform-origin: 0 0; }
+  .scene-stage[data-enhanced] { padding: 0; }
+  .scene-stage[data-enhanced] .news-card { margin: 0; max-width: none; }
+  .eyebrow { color: #854d0e; text-transform: uppercase; letter-spacing: .08em; font-size: 12px; }
+  h3 { font-size: 28px; line-height: 1.15; margin: 12px 0; }
+  .summary { line-height: 1.5; margin-bottom: 16px; }
+  .read-story { font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
+  .card-actions { display: flex; flex-wrap: wrap; gap: 12px; }
+  .card-actions:has(button:not([hidden])) { margin-top: 20px; }
+  button { font: inherit; font-size: 14px; background: #fef3c7; border: 1px solid #92400e; padding: 8px 12px; cursor: pointer; }
+  a:hover { color: #92400e; }
+  button:hover { background: #fde68a; }
+  :is(a, button):focus-visible { outline: 3px solid #2563eb; outline-offset: 3px; }
+  @media (max-width: 480px) { .news-scene { padding: 16px; } .scene-stage { padding: 24px 12px; } .news-card { padding: 18px; } }
+</style>
+
+<script>
+  import { enhanceNewsScene } from '../scripts/news-scene';
+
+  class NewsScene extends HTMLElement {
+    private cleanup?: () => void;
+
+    connectedCallback() {
+      this.cleanup?.();
+      this.cleanup = enhanceNewsScene(this);
+    }
+
+    disconnectedCallback() {
+      this.cleanup?.();
+      this.cleanup = undefined;
+    }
+  }
+
+  if (!customElements.get('news-scene')) customElements.define('news-scene', NewsScene);
+</script>
