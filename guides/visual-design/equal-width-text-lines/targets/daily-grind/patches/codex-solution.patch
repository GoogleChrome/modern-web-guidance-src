diff --git a/text-fit.js b/text-fit.js
new file mode 100644
index 0000000..844b1df
--- /dev/null
+++ b/text-fit.js
@@ -0,0 +1,74 @@
+// @ts-check
+
+if (!CSS.supports('text-fit', 'grow per-line-all 300%')) {
+  const lockups = [...document.querySelectorAll('.lockup')]
+    .filter((element) => element instanceof HTMLElement);
+  /** @type {Set<HTMLElement>} */
+  const pending = new Set();
+  /** @type {WeakMap<HTMLElement, number>} */
+  const widths = new WeakMap();
+  let frame = 0;
+
+  /** @param {HTMLElement} lockup */
+  function schedule(lockup) {
+    pending.add(lockup);
+    if (frame) return;
+    frame = requestAnimationFrame(() => {
+      frame = 0;
+      const groups = [...pending].map((heading) => ({
+        heading,
+        lines: [...heading.querySelectorAll(':scope > span')]
+          .filter((element) => element instanceof HTMLElement),
+      }));
+      pending.clear();
+
+      // Reset every line before measuring; never measure a previous fit.
+      for (const { lines } of groups) {
+        for (const line of lines) line.style.removeProperty('--text-fit-scale');
+      }
+
+      // Batch all layout reads across every heading before writing any scales.
+      const measurements = groups.map(({ heading, lines }) => {
+        const width = heading.getBoundingClientRect().width;
+        return lines.map((line) => {
+          const lineWidth = line.getBoundingClientRect().width;
+          const scale = width > 0 && lineWidth > 0
+            ? Math.min(3, Math.max(1, width / lineWidth))
+            : 1;
+          return { line, scale };
+        });
+      });
+
+      for (const lines of measurements) {
+        for (const { line, scale } of lines) {
+          line.style.setProperty('--text-fit-scale', String(scale));
+        }
+      }
+    });
+  }
+
+  const resizeObserver = new ResizeObserver((entries) => {
+    for (const entry of entries) {
+      if (!(entry.target instanceof HTMLElement)) continue;
+      // Fitting changes height. Only inline-size changes need another fit.
+      const width = entry.contentRect.width;
+      if (widths.get(entry.target) === width) continue;
+      widths.set(entry.target, width);
+      schedule(entry.target);
+    }
+  });
+
+  for (const lockup of lockups) {
+    resizeObserver.observe(lockup);
+    new MutationObserver(() => schedule(lockup)).observe(lockup, {
+      childList: true,
+      characterData: true,
+      subtree: true,
+    });
+    schedule(lockup);
+  }
+
+  const refitAll = () => lockups.forEach(schedule);
+  void document.fonts.ready.then(refitAll);
+  document.fonts.addEventListener('loadingdone', refitAll);
+}
