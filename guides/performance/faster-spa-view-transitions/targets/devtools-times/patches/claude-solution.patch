diff --git a/src/components/SpaViewSwitcher.astro b/src/components/SpaViewSwitcher.astro
new file mode 100644
index 0000000..a29878a
--- /dev/null
+++ b/src/components/SpaViewSwitcher.astro
@@ -0,0 +1,175 @@
+---
+import type { RenderResult } from "astro:content";
+
+export interface SpaView {
+  id: string;
+  label: string;
+  title: string;
+  description: string;
+  category: string;
+  publishDate: string;
+  Content: RenderResult["Content"];
+}
+
+export interface Props {
+  views: SpaView[];
+  tablistLabel: string;
+}
+
+const { views, tablistLabel } = Astro.props;
+const activeId = views[0]?.id;
+---
+
+<spa-view-switcher class="block">
+  <div
+    role="tablist"
+    aria-label={tablistLabel}
+    class="flex flex-wrap gap-1 border-b border-gray-300"
+  >
+    {
+      views.map((view) => {
+        const isActive = view.id === activeId;
+        return (
+          <button
+            type="button"
+            role="tab"
+            id={`tab-${view.id}`}
+            data-view-target={`view-${view.id}`}
+            aria-controls={`view-${view.id}`}
+            aria-selected={isActive ? "true" : "false"}
+            tabindex={isActive ? 0 : -1}
+            class:list={[
+              "cursor-pointer rounded-t-md border-b-2 px-3 py-2 text-sm font-semibold transition-colors",
+              isActive
+                ? "border-amber-400 text-gray-900"
+                : "border-transparent text-gray-500 hover:bg-gray-100 hover:text-gray-900",
+            ]}
+          >
+            {view.label}
+          </button>
+        );
+      })
+    }
+  </div>
+
+  <div class="spa-view-stack mt-6">
+    {
+      views.map((view) => {
+        const isActive = view.id === activeId;
+        const { Content } = view;
+        return (
+          <section
+            id={`view-${view.id}`}
+            role="tabpanel"
+            tabindex="-1"
+            aria-labelledby={`tab-${view.id}`}
+            aria-hidden={isActive ? "false" : "true"}
+            class:list={["spa-view outline-none", { inactive: !isActive }]}
+          >
+            <h2 class="text-2xl font-bold text-gray-900">{view.title}</h2>
+            <p class="mt-1 text-xs font-semibold tracking-wide text-gray-500 uppercase">
+              {view.category} &middot; {view.publishDate}
+            </p>
+            <p class="mt-3 text-gray-700">{view.description}</p>
+            <div class="prose mt-4 max-w-none">
+              <Content />
+            </div>
+          </section>
+        );
+      })
+    }
+  </div>
+</spa-view-switcher>
+
+<script>
+  class SpaViewSwitcher extends HTMLElement {
+    private wired = false;
+
+    connectedCallback() {
+      if (this.wired) return;
+      this.wired = true;
+
+      this.addEventListener("click", (event) => {
+        const target = event.target as Element | null;
+        const tab = target?.closest<HTMLElement>("[data-view-target]");
+        if (!tab || !this.contains(tab)) return;
+        const viewId = tab.dataset.viewTarget;
+        if (viewId) this.switchToView(viewId);
+      });
+
+      // Manual activation: arrow keys move focus between tabs, the button's
+      // native click (Enter/Space) performs the actual view switch.
+      this.addEventListener("keydown", (event) => {
+        const target = event.target as Element | null;
+        const tab = target?.closest<HTMLElement>('[role="tab"]');
+        if (!tab || !this.contains(tab)) return;
+
+        const tabs = this.tabs();
+        const current = tabs.indexOf(tab);
+        let next: number;
+        switch (event.key) {
+          case "ArrowRight":
+          case "ArrowDown":
+            next = (current + 1) % tabs.length;
+            break;
+          case "ArrowLeft":
+          case "ArrowUp":
+            next = (current - 1 + tabs.length) % tabs.length;
+            break;
+          case "Home":
+            next = 0;
+            break;
+          case "End":
+            next = tabs.length - 1;
+            break;
+          default:
+            return;
+        }
+        event.preventDefault();
+        for (const other of tabs) other.tabIndex = -1;
+        tabs[next].tabIndex = 0;
+        tabs[next].focus();
+      });
+    }
+
+    switchToView(viewId: string) {
+      const activeView = this.querySelector<HTMLElement>(
+        `#${CSS.escape(viewId)}`,
+      );
+      if (!activeView) return;
+
+      // Cache the rendering state of every view, then reveal the target one.
+      for (const view of this.views()) {
+        view.classList.add("inactive");
+        view.setAttribute("aria-hidden", "true");
+      }
+      activeView.classList.remove("inactive");
+      activeView.setAttribute("aria-hidden", "false");
+
+      for (const tab of this.tabs()) {
+        const selected = tab.dataset.viewTarget === viewId;
+        tab.setAttribute("aria-selected", selected ? "true" : "false");
+        tab.tabIndex = selected ? 0 : -1;
+        tab.classList.toggle("border-amber-400", selected);
+        tab.classList.toggle("text-gray-900", selected);
+        tab.classList.toggle("border-transparent", !selected);
+        tab.classList.toggle("text-gray-500", !selected);
+      }
+
+      // Keep the tab order logical by moving focus into the newly shown view.
+      activeView.focus({ preventScroll: true });
+    }
+
+    private views() {
+      return Array.from(this.querySelectorAll<HTMLElement>(".spa-view"));
+    }
+
+    private tabs() {
+      return Array.from(this.querySelectorAll<HTMLElement>('[role="tab"]'));
+    }
+  }
+
+  if (!customElements.get("spa-view-switcher")) {
+    customElements.define("spa-view-switcher", SpaViewSwitcher);
+  }
+</script>
