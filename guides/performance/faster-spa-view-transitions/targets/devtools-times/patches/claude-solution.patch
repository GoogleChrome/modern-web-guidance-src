+<script>
+    // The report set is small and fixed, so every view can stay cached in memory.
+    // A dynamic view set would need an LRU eviction policy here instead.
+    function setupReportTabs() {
+        const root = document.querySelector<HTMLElement>('[data-spa-views]');
+        if (!root) return;
+
+        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
+        const views = Array.from(root.querySelectorAll<HTMLElement>('.spa-view'));
+        if (tabs.length === 0 || views.length === 0) return;
+
+        function switchToView(viewId: string, moveFocus: boolean) {
+            const activeView = views.find((view) => view.id === viewId);
+            if (!activeView) return;
+
+            for (const view of views) {
+                const isActive = view === activeView;
+                view.classList.toggle('inactive', !isActive);
+                view.setAttribute('aria-hidden', isActive ? 'false' : 'true');
+            }
+
+            for (const tab of tabs) {
+                const isSelected = tab.getAttribute('aria-controls') === viewId;
+                tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
+                tab.tabIndex = isSelected ? 0 : -1;
+            }
+
+            if (moveFocus) {
+                activeView.focus({ preventScroll: true });
+            }
+        }
+
+        tabs.forEach((tab, index) => {
+            tab.addEventListener('click', () => {
+                const viewId = tab.getAttribute('aria-controls');
+                if (!viewId) return;
+                switchToView(viewId, true);
+                history.replaceState(null, '', `#${viewId}`);
+            });
+
+            tab.addEventListener('keydown', (event) => {
+                const offset =
+                    event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
+                if (offset === 0) return;
+                event.preventDefault();
+                tabs[(index + offset + tabs.length) % tabs.length]?.focus();
+            });
+        });
+
+        const requestedId = decodeURIComponent(location.hash.slice(1));
+        const initialView = views.find((view) => view.id === requestedId) ?? views[0];
+        if (initialView) switchToView(initialView.id, false);
+    }
+
+    document.addEventListener('astro:page-load', setupReportTabs);
+</script>
diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..36b4bb3 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,38 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+/* Stack every SPA view in the same grid cell so switching never reflows the page. */
+.spa-view-stack {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+}
+
+.spa-view {
+  grid-area: 1 / 1;
+  content-visibility: visible;
+}
+
+.spa-view:focus {
+  outline: none;
+}
+
+.spa-view:focus-visible {
+  outline: 2px solid var(--color-amber-400);
+  outline-offset: 4px;
+}
+
+.spa-view.inactive {
+  /* MANDATORY: cache the rendering state of inactive views instead of destroying them */
+  content-visibility: hidden;
+  /* Collapse the skipped subtree so it claims no space in the stack */
+  contain-intrinsic-size: 0 0;
+  pointer-events: none;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
 }
