+<script>
+  import { navigate } from 'astro:transitions/client';
+
+  /*
+   * Client-side SPA view switching for the homepage sections.
+   *
+   * Inactive views are NOT destroyed: they get the `inactive` class
+   * (`content-visibility: hidden`), so the browser keeps their DOM and cached
+   * rendering state and skips layout/paint for them. Returning to a previously
+   * visited view is therefore near-instant.
+   *
+   * The set of views is small and fixed (5), so every view is kept alive and
+   * no eviction strategy is required.
+   */
+
+  let controller: AbortController | null = null;
+
+  function initSpaViews(): void {
+    controller?.abort();
+    controller = null;
+
+    const root = document.querySelector<HTMLElement>('[data-spa-root]');
+    if (!root) return;
+
+    const views = Array.from(root.querySelectorAll<HTMLElement>(':scope > .spa-view'));
+    if (views.length === 0) return;
+
+    controller = new AbortController();
+    const { signal } = controller;
+
+    const viewIds = new Set(views.map((view) => view.dataset.viewId ?? ''));
+    const defaultViewId = root.dataset.defaultView ?? views[0].dataset.viewId ?? '';
+    let currentViewId = views.find((view) => !view.classList.contains('inactive'))?.dataset.viewId ?? null;
+
+    const viewIdFromHash = (hash: string): string | null => {
+      let id: string;
+      try {
+        id = decodeURIComponent(hash.replace(/^#/, ''));
+      } catch {
+        return null;
+      }
+      return viewIds.has(id) ? id : null;
+    };
+
+    const updateLinks = (viewId: string): void => {
+      document.querySelectorAll<HTMLAnchorElement>('a[data-spa-link]').forEach((link) => {
+        if (link.dataset.spaLink === viewId) {
+          link.setAttribute('aria-current', 'page');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    };
+
+    const switchToView = (viewId: string, focus: 'none' | 'scroll' | 'preserve-scroll'): void => {
+      const activeView = views.find((view) => view.dataset.viewId === viewId);
+      if (!activeView) return;
+
+      if (viewId !== currentViewId) {
+        // Hide (but keep) every other view
+        for (const view of views) {
+          if (view === activeView) continue;
+          view.classList.add('inactive');
+          view.setAttribute('aria-hidden', 'true');
+          view.setAttribute('inert', '');
+        }
+
+        // Show the target view
+        activeView.classList.remove('inactive');
+        activeView.setAttribute('aria-hidden', 'false');
+        activeView.removeAttribute('inert');
+
+        currentViewId = viewId;
+        updateLinks(viewId);
+      }
+
+      // Move focus to the new view to keep a logical tab order
+      if (focus === 'scroll') {
+        activeView.focus();
+      } else if (focus === 'preserve-scroll') {
+        activeView.focus({ preventScroll: true });
+      }
+    };
+
+    // Sync the view with the current URL (initial load, back/forward, manual hash edits)
+    const syncWithLocation = (focus: 'none' | 'preserve-scroll'): void => {
+      const viewId = viewIdFromHash(location.hash) ?? defaultViewId;
+      if (viewId !== currentViewId) {
+        switchToView(viewId, focus);
+      }
+    };
+
+    // Intercept same-page links pointing to a view (section nav, flyout "See all" links, ...).
+    // Capture phase so we run before the Astro ClientRouter's document click handler.
+    document.addEventListener(
+      'click',
+      (event: MouseEvent) => {
+        if (
+          event.defaultPrevented ||
+          event.button !== 0 ||
+          event.metaKey ||
+          event.ctrlKey ||
+          event.shiftKey ||
+          event.altKey
+        ) {
+          return;
+        }
+
+        const target = event.target;
+        if (!(target instanceof Element)) return;
+        const link = target.closest<HTMLAnchorElement>('a[href]');
+        if (!link || (link.target && link.target !== '_self') || link.hasAttribute('download')) return;
+
+        const url = new URL(link.href, location.href);
+        if (url.origin !== location.origin || url.pathname !== location.pathname || url.search !== location.search) {
+          return;
+        }
+
+        const viewId = viewIdFromHash(url.hash);
+        if (!viewId) return;
+
+        event.preventDefault();
+        switchToView(viewId, 'scroll');
+
+        // Record the view in history via the Astro router so back/forward stay
+        // intra-page (no full page swap that would destroy the cached views).
+        if (url.href !== location.href) {
+          void navigate(url.href);
+        }
+      },
+      { capture: true, signal },
+    );
+
+    window.addEventListener('popstate', () => syncWithLocation('preserve-scroll'), { signal });
+    window.addEventListener('hashchange', () => syncWithLocation('preserve-scroll'), { signal });
+
+    // Initial view based on the URL hash (e.g. arriving via /#reports)
+    syncWithLocation('none');
+  }
+
+  document.addEventListener('astro:page-load', initSpaViews);
+  document.addEventListener('astro:before-swap', () => {
+    controller?.abort();
+    controller = null;
+  });
+</script>
