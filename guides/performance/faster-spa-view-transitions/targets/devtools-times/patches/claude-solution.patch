+}
+
+/*
+ * SPA section views (homepage: Top News, World, Politics, Multimedia, Reports).
+ * Inactive views keep their DOM and cached rendering state; the browser skips
+ * layout and paint for their contents, so switching back is near-instant.
+ */
+.spa-views {
+  position: relative;
+}
+
+.spa-view.inactive {
+  /* Cache the rendering state of inactive views instead of destroying them */
+  content-visibility: hidden;
+
+  /* Take hidden views out of the layout flow so they don't occupy space */
+  position: absolute;
+  inset: 0 0 auto 0;
+}
+
+.spa-view:focus {
+  outline: none;
+}
+
+.spa-view:focus-visible {
+  outline: 2px solid var(--color-amber-400);
+  outline-offset: -2px;
+}
+
+/* Fallback for browsers without content-visibility support */
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
