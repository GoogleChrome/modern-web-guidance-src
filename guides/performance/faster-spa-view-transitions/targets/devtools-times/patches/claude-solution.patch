diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..0c2c7a6 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,28 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+/* SPA view caching: inactive views keep their rendering state in memory so
+   returning to them skips a full layout and paint pass. */
+.spa-view-stack {
+  position: relative;
+}
+
+.spa-view {
+  content-visibility: visible;
+}
+
+.spa-view.inactive {
+  /* MANDATORY: Use hidden to cache the rendering state of inactive views */
+  content-visibility: hidden;
+
+  /* Prevent hidden views from taking up physical space in layout flow */
+  position: absolute;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
 }
