+<script>
+    function setUpViewSwitcher(root: HTMLElement) {
+        if (root.dataset.spaViewSwitcherReady === 'true') return;
+        root.dataset.spaViewSwitcherReady = 'true';
+
+        const tabs = Array.from(root.querySelectorAll<HTMLElement>('[data-view-target]'));
+        const views = Array.from(root.querySelectorAll<HTMLElement>('.spa-view'));
+
+        function switchToView(viewId: string) {
+            const activeView = views.find((view) => view.id === viewId);
+            if (!activeView) return;
+
+            for (const view of views) {
+                const isActive = view === activeView;
+                view.classList.toggle('inactive', !isActive);
+                view.setAttribute('aria-hidden', isActive ? 'false' : 'true');
+            }
+
+            for (const tab of tabs) {
+                tab.setAttribute(
+                    'aria-selected',
+                    tab.dataset.viewTarget === viewId ? 'true' : 'false'
+                );
+            }
+
+            // Move focus to the new view so the tab order continues from the visible content.
+            activeView.focus();
+        }
+
+        for (const tab of tabs) {
+            const target = tab.dataset.viewTarget;
+            if (!target) continue;
+            tab.addEventListener('click', () => switchToView(target));
+        }
+    }
+
+    document.addEventListener('astro:page-load', () => {
+        document
+            .querySelectorAll<HTMLElement>('[data-spa-view-switcher]')
+            .forEach(setUpViewSwitcher);
+    });
+</script>
