\ No newline at end of file
+}
+
+.view-switcher {
+  position: relative;
+  min-height: 32rem;
+}
+
+.edition-tab {
+  border-bottom: 3px solid transparent;
+  color: #4b5563;
+  cursor: pointer;
+  font-size: 0.875rem;
+  font-weight: 700;
+  padding: 0.9rem 1.15rem 0.75rem;
+  transition: border-color 150ms ease, color 150ms ease;
+}
+
+.edition-tab:hover {
+  color: #111827;
+}
+
+.edition-tab:focus-visible {
+  border-radius: 0.25rem;
+  outline: 2px solid #92400e;
+  outline-offset: -2px;
+}
+
+.edition-tab.active {
+  border-bottom-color: #d97706;
+  color: #111827;
+}
+
+.spa-view {
+  content-visibility: visible;
+  outline: none;
+}
+
+.spa-view:focus-visible {
+  box-shadow: inset 0 0 0 3px #d97706;
+}
+
+.spa-view.inactive {
+  content-visibility: hidden;
+  pointer-events: none;
+  position: absolute;
+  width: 100%;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
