+}
+
+.cached-view-switcher {
+  overflow: hidden;
+}
+
+.view-tabs {
+  display: flex;
+  gap: 0.25rem;
+  border-bottom: 1px solid #d1d5db;
+}
+
+.view-tab {
+  margin-bottom: -1px;
+  border-bottom: 3px solid transparent;
+  padding: 0.65rem 1rem;
+  color: #4b5563;
+  font-size: 0.875rem;
+  font-weight: 700;
+  cursor: pointer;
+}
+
+.view-tab:hover {
+  color: #111827;
+}
+
+.view-tab[aria-selected="true"] {
+  border-bottom-color: #f59e0b;
+  color: #111827;
+}
+
+.view-tab:focus-visible,
+.spa-view:focus-visible {
+  outline: 3px solid #2563eb;
+  outline-offset: -3px;
+}
+
+.spa-view-stack {
+  position: relative;
+}
+
+.spa-view.inactive {
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0;
+  width: 100%;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
