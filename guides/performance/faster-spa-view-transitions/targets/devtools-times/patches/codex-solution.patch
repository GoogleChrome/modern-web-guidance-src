+<script is:inline data-astro-rerun>
+    (() => {
+        const switcher = document.querySelector('.view-switcher');
+        if (!switcher) return;
 
-        <!-- "Politics" section with the new grid variant -->
-        <TopStoryTeaserGrid title="Politics" articles={politicsArticles} />
