+<script>
+    const initializeViewSwitchers = () => {
+        document.querySelectorAll<HTMLElement>('[data-view-switcher]').forEach((switcher) => {
+            if (switcher.dataset.initialized === 'true') return;
+            switcher.dataset.initialized = 'true';
 
-        <!-- "Politics" section with the new grid variant -->
-        <TopStoryTeaserGrid title="Politics" articles={politicsArticles} />
