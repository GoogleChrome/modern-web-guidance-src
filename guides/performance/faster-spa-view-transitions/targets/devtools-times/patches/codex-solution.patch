\ No newline at end of file
+        const tabs = Array.from(switcher.querySelectorAll('[role="tab"]'));
+        const views = Array.from(switcher.querySelectorAll('.spa-view'));
+
+        const switchToView = (viewId, moveFocus = true) => {
+            const activeView = views.find((view) => view.id === viewId);
+            const activeTab = tabs.find((tab) => tab.getAttribute('aria-controls') === viewId);
+            if (!activeView || !activeTab) return;
+
+            views.forEach((view) => {
+                view.classList.add('inactive');
+                view.setAttribute('aria-hidden', 'true');
+            });
+
+            tabs.forEach((tab) => {
+                const isActive = tab === activeTab;
+                tab.classList.toggle('active', isActive);
+                tab.setAttribute('aria-selected', String(isActive));
+                tab.setAttribute('tabindex', isActive ? '0' : '-1');
+            });
+
+            activeView.classList.remove('inactive');
+            activeView.setAttribute('aria-hidden', 'false');
+
+            if (moveFocus) activeView.focus();
+        };
+
+        tabs.forEach((tab, index) => {
+            tab.addEventListener('click', () => {
+                const viewId = tab.getAttribute('data-view-target');
+                if (viewId) switchToView(viewId);
+            });
+
+            tab.addEventListener('keydown', (event) => {
+                if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+                event.preventDefault();
+
+                let nextIndex = index;
+                if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
+                if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
+                if (event.key === 'Home') nextIndex = 0;
+                if (event.key === 'End') nextIndex = tabs.length - 1;
+
+                const nextTab = tabs[nextIndex];
+                const viewId = nextTab?.getAttribute('data-view-target');
+                if (viewId) {
+                    nextTab.focus();
+                    switchToView(viewId);
+                }
+            });
+        });
+    })();
+</script>
