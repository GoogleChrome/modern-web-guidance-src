+<script>
+    const viewSwitcherControllers = new WeakMap<HTMLElement, AbortController>();
+
+    function setupViewSwitcher(switcher: HTMLElement): void {
+        viewSwitcherControllers.get(switcher)?.abort();
+
+        const controller = new AbortController();
+        viewSwitcherControllers.set(switcher, controller);
+
+        const views = Array.from(switcher.querySelectorAll<HTMLElement>('.spa-view'));
+        const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[role="tab"][data-view-target]'));
+
+        const knownView = (viewName: string | undefined): viewName is string =>
+            Boolean(viewName && views.some((view) => view.dataset.view === viewName));
+
+        const switchToView = (viewName: string, moveFocus = true): void => {
+            if (!knownView(viewName)) return;
+
+            for (const view of views) {
+                const isActive = view.dataset.view === viewName;
+                view.classList.toggle('inactive', !isActive);
+                view.setAttribute('aria-hidden', String(!isActive));
+                view.toggleAttribute('inert', !isActive);
+
+                if (isActive && moveFocus) {
+                    view.focus({ preventScroll: true });
+                }
+            }
+
+            for (const tab of tabs) {
+                const isActive = tab.dataset.viewTarget === viewName;
+                tab.setAttribute('aria-selected', String(isActive));
+                tab.tabIndex = isActive ? 0 : -1;
+            }
+        };
+
+        switcher.addEventListener('click', (event) => {
+            const target = event.target;
+            if (!(target instanceof Element)) return;
+
+            const tab = target.closest<HTMLButtonElement>('[role="tab"][data-view-target]');
+            const viewName = tab?.dataset.viewTarget;
+            if (!knownView(viewName)) return;
+
+            switchToView(viewName);
+            const nextUrl = new URL(window.location.href);
+            nextUrl.hash = `view-${viewName}`;
+            window.history.pushState({ cachedView: viewName }, '', nextUrl);
+        }, { signal: controller.signal });
+
+        switcher.addEventListener('keydown', (event) => {
+            if (!(event instanceof KeyboardEvent) || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
+            const currentIndex = tabs.findIndex((tab) => tab === document.activeElement);
+            if (currentIndex < 0) return;
+
+            event.preventDefault();
+            const nextIndex = event.key === 'Home'
+                ? 0
+                : event.key === 'End'
+                    ? tabs.length - 1
+                    : (currentIndex + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
+            tabs[nextIndex]?.focus();
+            tabs[nextIndex]?.click();
+        }, { signal: controller.signal });
+
+        const restoreHistoryView = (): void => {
+            const hashView = window.location.hash.startsWith('#view-')
+                ? window.location.hash.slice('#view-'.length)
+                : undefined;
+            switchToView(knownView(hashView) ? hashView : 'top-news');
+        };
+
+        window.addEventListener('popstate', restoreHistoryView, { signal: controller.signal });
+
+        const initialView = window.location.hash.startsWith('#view-')
+            ? window.location.hash.slice('#view-'.length)
+            : undefined;
+        switchToView(knownView(initialView) ? initialView : 'top-news', false);
+    }
+
+    document.addEventListener('astro:page-load', () => {
+        document.querySelectorAll<HTMLElement>('[data-view-switcher]').forEach(setupViewSwitcher);
+    });
+</script>
