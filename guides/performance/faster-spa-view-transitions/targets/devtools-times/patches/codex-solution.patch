+}
+
+.spa-view {
+  content-visibility: visible;
+  outline: none;
+}
+
+.spa-view:focus-visible {
+  outline: 2px solid #92400e;
+  outline-offset: 2px;
+}
+
+.spa-view.inactive {
+  content-visibility: hidden;
+  position: absolute;
+  inset-inline: 0;
+  top: 0;
+  pointer-events: none;
+}
+
+.view-tab {
+  border-bottom: 3px solid transparent;
+  color: #4b5563;
+  cursor: pointer;
+  font-size: 0.875rem;
+  font-weight: 700;
+  padding: 0.75rem 1rem;
+}
+
+.view-tab:hover {
+  color: #92400e;
+}
+
+.view-tab.active {
+  border-bottom-color: #92400e;
+  color: #111827;
+}
+
+.view-tab:focus-visible {
+  outline: 2px solid #92400e;
+  outline-offset: -2px;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
