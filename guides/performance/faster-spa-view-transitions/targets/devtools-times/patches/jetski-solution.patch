diff --git a/src/scripts/spa-views.ts b/src/scripts/spa-views.ts
new file mode 100644
index 0000000..39a9635
--- /dev/null
+++ b/src/scripts/spa-views.ts
@@ -0,0 +1,167 @@
+/**
+ * Faster SPA View Transitions via State Caching (content-visibility)
+ */
+
+declare global {
+  interface Window {
+    switchToView: (viewId: string | HTMLElement | number) => void;
+  }
+}
+
+/**
+ * Switches the active SPA view.
+ * - Hides inactive views by adding `.inactive` class and setting `aria-hidden="true"`.
+ * - Shows the target view by removing `.inactive` class and setting `aria-hidden="false"`.
+ * - Moves keyboard focus to the newly active view container to ensure a logical tab-order.
+ */
+export function switchToView(viewTarget: string | HTMLElement | number): void {
+  let activeView: HTMLElement | null = null;
+
+  if (typeof viewTarget === 'string') {
+    const cleanId = viewTarget.startsWith('#') ? viewTarget.slice(1) : viewTarget;
+    activeView = (document.getElementById(cleanId) ||
+      document.querySelector(viewTarget) ||
+      document.querySelector(`[data-view="${cleanId}"]`) ||
+      document.querySelector(`[data-view-id="${cleanId}"]`)) as HTMLElement | null;
+  } else if (typeof viewTarget === 'number') {
+    const views = document.querySelectorAll<HTMLElement>('.spa-view');
+    if (views[viewTarget]) {
+      activeView = views[viewTarget];
+    }
+  } else if (viewTarget instanceof HTMLElement) {
+    activeView = viewTarget;
+  }
+
+  if (!activeView) {
+    console.warn(`[SPA Views] View target not found:`, viewTarget);
+    return;
+  }
+
+  // Hide all views
+  const allViews = document.querySelectorAll<HTMLElement>('.spa-view');
+  allViews.forEach(view => {
+    view.classList.add('inactive');
+    view.setAttribute('aria-hidden', 'true');
+  });
+
+  // Show the target view
+  activeView.classList.remove('inactive');
+  activeView.setAttribute('aria-hidden', 'false');
+
+  // MANDATORY: Move focus to the new view to ensure a logical tab-order
+  if (!activeView.hasAttribute('tabindex')) {
+    activeView.setAttribute('tabindex', '-1');
+  }
+  activeView.focus();
+
+  // Update tab button UI / aria states
+  const targetId = activeView.id;
+  document.querySelectorAll<HTMLElement>('[data-view-target], [role="tab"]').forEach(tab => {
+    const tabTarget =
+      tab.getAttribute('data-view-target') ||
+      tab.getAttribute('aria-controls') ||
+      tab.getAttribute('href')?.replace('#', '');
+    const isActive =
+      tabTarget === targetId ||
+      (activeView?.dataset?.view && tabTarget === activeView.dataset.view) ||
+      (tab.id && targetId && tab.id === `tab-${targetId}`);
+
+    if (isActive) {
+      tab.classList.add('active', 'bg-gray-900', 'text-white');
+      tab.classList.remove('text-gray-700', 'hover:bg-gray-200');
+      tab.setAttribute('aria-selected', 'true');
+      tab.setAttribute('tabindex', '0');
+    } else {
+      tab.classList.remove('active', 'bg-gray-900', 'text-white');
+      tab.classList.add('text-gray-700', 'hover:bg-gray-200');
+      tab.setAttribute('aria-selected', 'false');
+      tab.setAttribute('tabindex', '-1');
+    }
+  });
+
+  // Dispatch custom event
+  window.dispatchEvent(
+    new CustomEvent('spa:view-changed', {
+      detail: { activeView, viewId: activeView.id },
+    })
+  );
+}
+
+// Make switchToView accessible globally on window and globalThis
+if (typeof window !== 'undefined') {
+  window.switchToView = switchToView;
+  (globalThis as any).switchToView = switchToView;
+}
+
+// Initialize SPA view event listeners
+export function initSpaViews(): void {
+  // Attach click listener for tabs / view switch triggers via event delegation
+  document.addEventListener('click', (event: MouseEvent) => {
+    const target = event.target as HTMLElement | null;
+    if (!target) return;
+
+    const tabBtn = target.closest<HTMLElement>('[data-view-target], [role="tab"], a[href^="#view-"]');
+    if (!tabBtn) return;
+
+    const viewTarget =
+      tabBtn.getAttribute('data-view-target') ||
+      tabBtn.getAttribute('aria-controls') ||
+      tabBtn.getAttribute('href')?.replace(/^#/, '');
+
+    if (viewTarget) {
+      const cleanId = viewTarget.startsWith('#') ? viewTarget.slice(1) : viewTarget;
+      const viewElement = document.getElementById(cleanId) || document.querySelector(`[data-view="${cleanId}"]`);
+      if (viewElement && viewElement.classList.contains('spa-view')) {
+        event.preventDefault();
+        switchToView(viewTarget);
+      }
+    }
+  });
+
+  // Keyboard navigation for tabs
+  document.addEventListener('keydown', (event: KeyboardEvent) => {
+    const target = event.target as HTMLElement | null;
+    if (!target || target.getAttribute('role') !== 'tab') return;
+
+    const tablist = target.closest('[role="tablist"]');
+    if (!tablist) return;
+
+    const tabs = Array.from(tablist.querySelectorAll<HTMLElement>('[role="tab"]'));
+    const currentIndex = tabs.indexOf(target);
+    if (currentIndex === -1) return;
+
+    let nextIndex = -1;
+    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
+      nextIndex = (currentIndex + 1) % tabs.length;
+    } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
+      nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
+    } else if (event.key === 'Home') {
+      nextIndex = 0;
+    } else if (event.key === 'End') {
+      nextIndex = tabs.length - 1;
+    }
+
+    if (nextIndex !== -1) {
+      event.preventDefault();
+      const nextTab = tabs[nextIndex];
+      nextTab.focus();
+      const viewTarget =
+        nextTab.getAttribute('data-view-target') ||
+        nextTab.getAttribute('aria-controls') ||
+        nextTab.getAttribute('href')?.replace(/^#/, '');
+      if (viewTarget) {
+        switchToView(viewTarget);
+      }
+    }
+  });
+}
+
+// Auto-run on script execution / Astro transitions
+if (typeof document !== 'undefined') {
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initSpaViews, { once: true });
+  } else {
+    initSpaViews();
+  }
+  document.addEventListener('astro:page-load', initSpaViews);
+}
