     <link rel="icon" href=`${baseUrl}/favicon.svg` />
 
     <ClientRouter />
+
+    <script is:inline>
+      function switchToView(viewId) {
+        // Hide all views
+        document.querySelectorAll('.spa-view').forEach(view => {
+          view.classList.add('inactive');
+          view.setAttribute('aria-hidden', 'true');
+        });
+        
+        // Show the target view
+        const activeView = typeof viewId === 'string'
+          ? (document.getElementById(viewId) || (viewId.startsWith('#') ? document.querySelector(viewId) : null))
+          : viewId;
+
+        if (activeView) {
+          activeView.classList.remove('inactive');
+          activeView.setAttribute('aria-hidden', 'false');
+          
+          // MANDATORY: Move focus to the new view to ensure a logical tab-order
+          activeView.focus();
+        }
+
+        // Update any tab buttons matching the view
+        document.querySelectorAll('[data-view-target]').forEach(tab => {
+          const targetId = tab.getAttribute('data-view-target');
+          const isTarget = targetId === (typeof viewId === 'string' ? viewId.replace(/^#/, '') : activeView?.id);
+          tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
+          if (isTarget) {
+            tab.classList.add('border-gray-900', 'text-gray-900', 'font-bold');
+            tab.classList.remove('border-transparent', 'text-gray-500', 'font-semibold');
+          } else {
+            tab.classList.remove('border-gray-900', 'text-gray-900', 'font-bold');
+            tab.classList.add('border-transparent', 'text-gray-500', 'font-semibold');
+          }
+        });
+      }
+      window.switchToView = switchToView;
+    </script>
   </head>
   <body class="bg-gray-100">
     <div class="mx-auto">
