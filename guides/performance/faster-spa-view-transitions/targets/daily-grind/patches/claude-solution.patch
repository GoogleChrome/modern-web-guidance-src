+    /* ------------------------------------------------------------------
+       SPA view caching
+
+       Views are never destroyed on navigation. Inactive views keep their
+       DOM, listeners and state, and the browser keeps their cached
+       rendering state, so returning to a view skips layout + paint.
+
+       This app has a fixed set of five views, so unconditional caching is
+       safe. A highly dynamic app (dozens of generated reports, unbounded
+       dynamic routes) would need an LRU eviction strategy instead.
+       ------------------------------------------------------------------ */
+    .spa-views {
+      position: relative;
+    }
+
+    .spa-view {
+      /* Views are programmatically focused on transition; the focus ring
+         would otherwise appear on a non-interactive container. */
+      outline: none;
+    }
+
+    .spa-view.inactive {
+      /* MANDATORY: Use hidden to cache the rendering state of inactive views */
+      content-visibility: hidden;
+
+      /* Keep hidden views out of the layout flow. `content-visibility:
+         hidden` only skips the *contents*, so the element box itself would
+         still be part of the flow and still paint its own background. */
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 100%;
+      pointer-events: none;
+    }
+
+    /* Fallback: browsers without `content-visibility` support would render
+       every view at once, so collapse inactive views the traditional way.
+       This trades the caching benefit for correctness. */
+    @supports not (content-visibility: hidden) {
+      .spa-view.inactive {
+        display: none;
+      }
+    }
+
