+  <script>
+    (function () {
+      'use strict';
+
+      // A small, fixed set of views: caching every visited view is safe here,
+      // so no eviction strategy is required.
+      var ROUTES = {
+        '/': { id: 'home', title: 'The Daily Grind | Artisanal Coffee', label: 'Home' },
+        '/menu': { id: 'menu', title: 'Menu | The Daily Grind', label: 'Menu' },
+        '/locations': { id: 'locations', title: 'Locations | The Daily Grind', label: 'Locations' },
+        '/rewards': { id: 'rewards', title: 'Rewards | The Daily Grind', label: 'Rewards' },
+        '/account': { id: 'account', title: 'My Account | The Daily Grind', label: 'My Account' }
+      };
+
+      var stack = document.getElementById('view-stack');
+      var initializers = {
+        menu: initMenu,
+        rewards: initRewards,
+        account: initAccount
+      };
+      var scrollPositions = {};
+      var currentViewId = null;
+
+      function normalizePath(path) {
+        if (path.length > 1 && path.charAt(path.length - 1) === '/') {
+          path = path.slice(0, -1);
+        }
+        return path;
+      }
+
+      function routeForPath(path) {
+        return ROUTES[normalizePath(path)] || null;
+      }
+
+      function routeForId(id) {
+        for (var path in ROUTES) {
+          if (Object.prototype.hasOwnProperty.call(ROUTES, path) && ROUTES[path].id === id) {
+            return { path: path, route: ROUTES[path] };
+          }
+        }
+        return null;
+      }
+
+      // Returns the cached view element, creating it from its template on first visit only.
+      function getOrCreateView(route) {
+        var existing = document.getElementById('view-' + route.id);
+        if (existing) return existing;
+
+        var tpl = document.getElementById('tpl-' + route.id);
+        var view = document.createElement('div');
+        view.className = 'spa-view inactive';
+        view.id = 'view-' + route.id;
+        view.setAttribute('data-view-id', route.id);
+        view.setAttribute('tabindex', '-1');
+        view.setAttribute('role', 'region');
+        view.setAttribute('aria-label', route.label);
+        view.setAttribute('aria-hidden', 'true');
+        view.setAttribute('inert', '');
+        if (tpl && tpl.content) {
+          view.appendChild(tpl.content.cloneNode(true));
+        }
+        stack.appendChild(view);
+
+        var init = initializers[route.id];
+        if (init) init(view);
+        return view;
+      }
+
+      function switchToView(route, options) {
+        var focus = !options || options.focus !== false;
+        if (currentViewId === route.id) return;
+
+        if (currentViewId !== null) {
+          scrollPositions[currentViewId] = window.scrollY;
+        }
+
+        var activeView = getOrCreateView(route);
+
+        // Hide all other views, keeping their DOM and rendering state cached.
+        var views = stack.querySelectorAll('.spa-view');
+        for (var i = 0; i < views.length; i++) {
+          var view = views[i];
+          if (view === activeView) continue;
+          view.classList.add('inactive');
+          view.setAttribute('aria-hidden', 'true');
+          view.setAttribute('inert', '');
+        }
+
+        // Show the target view.
+        activeView.classList.remove('inactive');
+        activeView.setAttribute('aria-hidden', 'false');
+        activeView.removeAttribute('inert');
+
+        currentViewId = route.id;
+        document.title = route.title;
+        updateNav(route.id);
+
+        window.scrollTo(0, scrollPositions[route.id] || 0);
+
+        // Move focus to the new view to keep a logical tab order.
+        if (focus) activeView.focus({ preventScroll: true });
+      }
+
+      function updateNav(id) {
+        var links = document.querySelectorAll('a[data-view]');
+        for (var i = 0; i < links.length; i++) {
+          if (links[i].getAttribute('data-view') === id) {
+            links[i].setAttribute('aria-current', 'page');
+          } else {
+            links[i].removeAttribute('aria-current');
+          }
+        }
+      }
+
+      function navigate(path) {
+        var route = routeForPath(path);
+        if (!route) return false;
+        if (normalizePath(window.location.pathname) !== normalizePath(path)) {
+          history.pushState({ view: route.id }, '', path);
+        }
+        switchToView(route);
+        return true;
+      }
+
+      document.addEventListener('click', function (event) {
+        if (event.defaultPrevented || event.button !== 0 ||
+          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+          return;
+        }
+        var target = event.target;
+        var link = target instanceof Element ? target.closest('a[data-view]') : null;
+        if (!link) return;
+        var match = routeForId(link.getAttribute('data-view'));
+        if (!match) return;
+        event.preventDefault();
+        navigate(match.path);
+      });
+
+      window.addEventListener('popstate', function () {
+        var route = routeForPath(window.location.pathname) || ROUTES['/'];
+        switchToView(route);
+      });
+
+      if ('scrollRestoration' in history) {
+        history.scrollRestoration = 'manual';
+      }
+
+      // ---- View behaviours (state persists while the view is cached) ----
+
+      function initMenu(view) {
+        var buttons = view.querySelectorAll('[data-filter]');
+        var cards = view.querySelectorAll('[data-category]');
+        view.addEventListener('click', function (event) {
+          var btn = event.target instanceof Element ? event.target.closest('[data-filter]') : null;
+          if (!btn) return;
+          var filter = btn.getAttribute('data-filter');
+          for (var i = 0; i < buttons.length; i++) {
+            buttons[i].setAttribute('aria-pressed', String(buttons[i] === btn));
+          }
+          for (var j = 0; j < cards.length; j++) {
+            var show = filter === 'all' || cards[j].getAttribute('data-category') === filter;
+            cards[j].hidden = !show;
+          }
+        });
+      }
+
+      function initRewards(view) {
+        var GOAL = 150;
+        var points = 120;
+        var pointsEl = view.querySelector('[data-points]');
+        var progressEl = view.querySelector('[data-progress]');
+        var labelEl = view.querySelector('[data-progress-label]');
+        var checkin = view.querySelector('[data-checkin]');
+
+        function render() {
+          var remainder = points % GOAL;
+          var free = Math.floor(points / GOAL);
+          if (pointsEl) pointsEl.textContent = String(points);
+          if (progressEl) progressEl.style.width = (remainder / GOAL * 100) + '%';
+          if (labelEl) {
+            labelEl.textContent = (GOAL - remainder) + ' points until your next free drink' +
+              (free > 0 ? ' · ' + free + ' free drink' + (free > 1 ? 's' : '') + ' earned!' : '');
+          }
+        }
+
+        if (checkin) {
+          checkin.addEventListener('click', function () {
+            points += 10;
+            render();
+          });
+        }
+        render();
+      }
+
+      function initAccount(view) {
+        var form = view.querySelector('[data-account-form]');
+        var status = view.querySelector('[data-form-status]');
+        if (!form) return;
+        form.addEventListener('submit', function (event) {
+          event.preventDefault();
+          if (status) status.textContent = 'Your changes have been saved.';
+        });
+      }
+
+      // ---- Initial route ----
+      var initialRoute = routeForPath(window.location.pathname) || ROUTES['/'];
+      history.replaceState({ view: initialRoute.id }, '', window.location.href);
+      switchToView(initialRoute, { focus: false });
+    })();
+  </script>
+
 </body>
 
