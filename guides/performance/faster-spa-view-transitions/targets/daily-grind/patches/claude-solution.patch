+    /* ---------------------------------------------------------------
+       SPA view caching
+       ---------------------------------------------------------------
+       Inactive views keep their DOM and cached rendering state so that
+       returning to them skips a full layout + paint pass.
+    */
+    #view-root {
+      position: relative;
+    }
+
+    .spa-view:focus {
+      outline: none;
+    }
+
+    .spa-view.inactive {
+      /* MANDATORY: cache the rendering state of inactive views */
+      content-visibility: hidden;
+
+      /* Keep hidden views out of the layout flow. The element box itself is
+         still painted, so it must stay free of its own background/border. */
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 100%;
+      pointer-events: none;
+    }
+
+    /* Fallback: browsers without content-visibility would otherwise paint
+       every view at once. */
+    @supports not (content-visibility: hidden) {
+      .spa-view.inactive {
+        display: none;
+      }
+    }
   </style>
