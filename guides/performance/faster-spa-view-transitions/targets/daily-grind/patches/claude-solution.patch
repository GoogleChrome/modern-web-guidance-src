+  <script>
+    (function () {
+      'use strict';
+
+      // Five fixed views, so every view is cached for the lifetime of the page.
+      // A dynamic route space would need an LRU eviction pass here instead.
+      var views = Array.prototype.slice.call(document.querySelectorAll('.spa-view'));
+      var triggers = Array.prototype.slice.call(document.querySelectorAll('[data-view]'));
+
+      var ROUTES = {
+        '': 'view-home',
+        'home': 'view-home',
+        'menu': 'view-menu',
+        'locations': 'view-locations',
+        'rewards': 'view-rewards',
+        'account': 'view-account'
+      };
+
+      var TITLES = {
+        'view-home': 'The Daily Grind | Artisanal Coffee',
+        'view-menu': 'Menu | The Daily Grind',
+        'view-locations': 'Locations | The Daily Grind',
+        'view-rewards': 'Rewards | The Daily Grind',
+        'view-account': 'My Account | The Daily Grind'
+      };
+
+      function viewIdFromHash() {
+        var key = window.location.hash.replace(/^#\/?/, '');
+        return ROUTES[key] || 'view-home';
+      }
+
+      function switchToView(viewId, moveFocus) {
+        var activeView = document.getElementById(viewId);
+        if (!activeView) return;
+
+        views.forEach(function (view) {
+          var isActive = view === activeView;
+          // Inactive views keep their DOM and rendering state; only the
+          // content-visibility state is toggled.
+          view.classList.toggle('inactive', !isActive);
+          view.setAttribute('aria-hidden', isActive ? 'false' : 'true');
+        });
+
+        triggers.forEach(function (trigger) {
+          if (trigger.getAttribute('data-view') === viewId) {
+            trigger.setAttribute('aria-current', 'page');
+          } else {
+            trigger.removeAttribute('aria-current');
+          }
+        });
+
+        document.title = TITLES[viewId] || document.title;
+
+        if (moveFocus) {
+          activeView.focus({ preventScroll: true });
+          window.scrollTo(0, 0);
+        }
+      }
+
+      triggers.forEach(function (trigger) {
+        trigger.addEventListener('click', function (event) {
+          var viewId = trigger.getAttribute('data-view');
+          if (!document.getElementById(viewId)) return;
+
+          event.preventDefault();
+          var hash = viewId === 'view-home' ? '#home' : '#' + viewId.replace('view-', '');
+          if (window.location.hash !== hash) {
+            history.pushState({ viewId: viewId }, '', hash);
+          }
+          switchToView(viewId, true);
+        });
+      });
+
+      window.addEventListener('popstate', function () {
+        switchToView(viewIdFromHash(), true);
+      });
+
+      switchToView(viewIdFromHash(), false);
+    })();
+  </script>
+
