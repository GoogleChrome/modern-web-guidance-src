+  <script>
+    (function () {
+      'use strict';
+
+      // A fixed, small set of views, so every view is cached for the life of
+      // the page. An LRU eviction pass would only be needed if views were
+      // generated dynamically from unbounded routes.
+      var DEFAULT_VIEW = 'view-home';
+      var views = Array.prototype.slice.call(document.querySelectorAll('.spa-view'));
+      var navLinks = Array.prototype.slice.call(document.querySelectorAll('nav a[data-view]'));
+
+      var routes = {};
+      navLinks.forEach(function (link) {
+        routes[link.getAttribute('href')] = link.getAttribute('data-view');
+      });
+
+      function viewIdFromHash(hash) {
+        var id = routes[hash];
+        return id && document.getElementById(id) ? id : DEFAULT_VIEW;
+      }
+
+      function switchToView(viewId, moveFocus) {
+        var activeView = document.getElementById(viewId);
+        if (!activeView) return;
+
+        views.forEach(function (view) {
+          var isActive = view === activeView;
+          view.classList.toggle('inactive', !isActive);
+          view.setAttribute('aria-hidden', isActive ? 'false' : 'true');
+        });
+
+        navLinks.forEach(function (link) {
+          if (link.getAttribute('data-view') === viewId) {
+            link.setAttribute('aria-current', 'page');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        if (moveFocus) {
+          // Keep the tab order logical: the next Tab starts inside the view
+          // the user just navigated to.
+          activeView.focus();
+        }
+      }
+
+      document.addEventListener('click', function (event) {
+        var link = event.target.closest ? event.target.closest('a[data-view]') : null;
+        if (!link) return;
+        var viewId = link.getAttribute('data-view');
+        if (!document.getElementById(viewId)) return;
+        event.preventDefault();
+        var hash = link.getAttribute('href');
+        if (window.location.hash !== hash) {
+          window.location.hash = hash;
+        } else {
+          switchToView(viewId, true);
+        }
+      });
+
+      window.addEventListener('hashchange', function () {
+        switchToView(viewIdFromHash(window.location.hash), true);
+      });
+
+      switchToView(viewIdFromHash(window.location.hash), false);
+
+      // Exposed so tests and other scripts can drive navigation directly.
+      window.switchToView = switchToView;
+    })();
+  </script>
+
