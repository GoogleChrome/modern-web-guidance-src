+  <script>
+    (function () {
+      'use strict';
+
+      var ROUTES = {
+        '/': 'view-home',
+        '/index.html': 'view-home',
+        '/menu': 'view-menu',
+        '/locations': 'view-locations',
+        '/rewards': 'view-rewards',
+        '/account': 'view-account'
+      };
+      var DEFAULT_VIEW = 'view-home';
+
+      function pathForView(viewId) {
+        for (var path in ROUTES) {
+          if (ROUTES[path] === viewId && path !== '/index.html') return path;
+        }
+        return '/';
+      }
+
+      function viewForPath(pathname) {
+        return ROUTES[pathname] || DEFAULT_VIEW;
+      }
+
+      function switchToView(viewId, options) {
+        var opts = options || {};
+        var activeView = document.getElementById(viewId) || document.getElementById(DEFAULT_VIEW);
+
+        // Hide every view: the cached rendering state survives, the DOM is
+        // never torn down.
+        var allViews = document.querySelectorAll('.spa-view');
+        for (var i = 0; i < allViews.length; i++) {
+          var view = allViews[i];
+          view.classList.add('inactive');
+          view.setAttribute('aria-hidden', 'true');
+        }
+
+        // Show the target view.
+        activeView.classList.remove('inactive');
+        activeView.setAttribute('aria-hidden', 'false');
+
+        var links = document.querySelectorAll('nav a[data-view]');
+        for (var j = 0; j < links.length; j++) {
+          if (links[j].getAttribute('data-view') === activeView.id) {
+            links[j].setAttribute('aria-current', 'page');
+          } else {
+            links[j].removeAttribute('aria-current');
+          }
+        }
+
+        // MANDATORY: Move focus to the new view to ensure a logical tab-order.
+        activeView.focus({ preventScroll: true });
+
+        if (opts.scrollToTop) window.scrollTo(0, 0);
+        return activeView;
+      }
+
+      function navigate(viewId) {
+        if (window.history && window.history.pushState) {
+          var path = pathForView(viewId);
+          if (path !== window.location.pathname) {
+            window.history.pushState({ viewId: viewId }, '', path);
+          }
+        }
+        switchToView(viewId, { scrollToTop: true });
+      }
+
+      document.addEventListener('click', function (event) {
+        if (event.defaultPrevented || event.button !== 0) return;
+        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+
+        var target = event.target.closest ? event.target.closest('[data-view]') : null;
+        if (!target) return;
+
+        var viewId = target.getAttribute('data-view');
+        if (!document.getElementById(viewId)) return;
+
+        event.preventDefault();
+        navigate(viewId);
+      });
+
+      window.addEventListener('popstate', function (event) {
+        var viewId = (event.state && event.state.viewId) || viewForPath(window.location.pathname);
+        switchToView(viewId, { scrollToTop: true });
+      });
+
+      switchToView(viewForPath(window.location.pathname), { scrollToTop: false });
+
+      // Exposed so tests and other modules can drive navigation.
+      window.switchToView = switchToView;
+    })();
+  </script>
+
