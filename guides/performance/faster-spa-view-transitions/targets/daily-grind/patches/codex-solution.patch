diff --git a/navigation.js b/navigation.js
new file mode 100644
index 0000000..3f40760
--- /dev/null
+++ b/navigation.js
@@ -0,0 +1,42 @@
+// @ts-check
+
+const views = Array.from(document.querySelectorAll('.spa-view'));
+const links = Array.from(document.querySelectorAll('nav a'));
+const titles = new Map([
+  ['/', 'Artisanal Coffee'],
+  ['/menu', 'Menu'],
+  ['/locations', 'Locations'],
+  ['/rewards', 'Rewards'],
+  ['/account', 'My Account'],
+]);
+
+function showView() {
+  const route = window.location.hash.slice(1) || '/';
+  const target = views.find(view => view instanceof HTMLElement && view.dataset.route === route);
+  if (!(target instanceof HTMLElement)) {
+    window.location.replace('#/');
+    return;
+  }
+
+  // Keep this bounded set of five views mounted, including their input and UI state.
+  for (const view of views) {
+    if (!(view instanceof HTMLElement)) continue;
+    const inactive = view !== target;
+    view.classList.toggle('inactive', inactive);
+    view.inert = inactive;
+    view.setAttribute('aria-hidden', String(inactive));
+  }
+  for (const link of links) {
+    if (link.getAttribute('href') === `#${route}`) {
+      link.setAttribute('aria-current', 'page');
+    } else {
+      link.removeAttribute('aria-current');
+    }
+  }
+  document.title = `The Daily Grind | ${titles.get(route) || 'Artisanal Coffee'}`;
+  target.focus({ preventScroll: true });
+  window.scrollTo(0, 0);
+}
+
+window.addEventListener('hashchange', showView);
+showView();
