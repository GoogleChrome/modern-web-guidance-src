+(() => {
+  'use strict';
+
+  const views = [...document.querySelectorAll('.spa-view')];
+  const controls = [...document.querySelectorAll('[data-view-target]')];
+
+  function switchToView(viewName, updateHistory = true) {
+    const activeView = views.find((view) => view.dataset.view === viewName);
+    if (!activeView) return;
+
+    views.forEach((view) => {
+      const isActive = view === activeView;
+      view.classList.toggle('inactive', !isActive);
+      view.setAttribute('aria-hidden', String(!isActive));
+    });
+
+    controls.forEach((control) => {
+      if (!control.classList.contains('nav-link')) return;
+      if (control.dataset.viewTarget === viewName) {
+        control.setAttribute('aria-current', 'page');
+      } else {
+        control.removeAttribute('aria-current');
+      }
+    });
+
+    if (updateHistory) history.pushState({ view: viewName }, '', `#${viewName}`);
+    activeView.focus({ preventScroll: true });
+    window.scrollTo({ top: 0, behavior: 'auto' });
+  }
+
+  controls.forEach((control) => {
+    control.addEventListener('click', () => switchToView(control.dataset.viewTarget));
+  });
+
+  window.addEventListener('popstate', (event) => {
+    switchToView(event.state?.view || location.hash.slice(1) || 'home', false);
+  });
+
+  const initialView = location.hash.slice(1);
+  if (initialView && views.some((view) => view.dataset.view === initialView)) {
+    switchToView(initialView, false);
+  } else {
+    history.replaceState({ view: 'home' }, '', '#home');
+  }
+})();
