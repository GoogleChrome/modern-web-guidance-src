+++ b/styles.css
@@ -0,0 +1,151 @@
+:root {
+  --ink: #1c2926;
+  --paper: #f6f0e5;
+  --cream: #fffaf0;
+  --coral: #e9654b;
+  --yellow: #f3bd31;
+  --mint: #b8d5c8;
+  --line: rgba(28, 41, 38, 0.18);
+  --shadow: 0 20px 50px rgba(28, 41, 38, 0.12);
+}
+
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body { margin: 0; color: var(--ink); background: var(--paper); font: 16px/1.6 "DM Sans", sans-serif; }
+a { color: inherit; }
+button, input { font: inherit; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
+.skip-link { position: fixed; top: 8px; left: 8px; z-index: 100; padding: 10px 16px; background: var(--cream); transform: translateY(-150%); }
+.skip-link:focus { transform: translateY(0); }
+
+.site-header { height: 76px; padding: 0 clamp(20px, 5vw, 72px); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); background: rgba(246, 240, 229, 0.94); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 20; }
+.brand { display: inline-flex; align-items: center; gap: 11px; color: var(--ink); text-decoration: none; font-size: .78rem; font-weight: 700; letter-spacing: .13em; }
+.brand-mark { width: 37px; height: 37px; display: grid; place-items: center; border: 2px solid var(--ink); border-radius: 50%; font: 700 .72rem/1 "Fraunces", serif; letter-spacing: -.03em; }
+.nav-links { display: flex; align-items: center; gap: clamp(18px, 3vw, 42px); list-style: none; margin: 0; padding: 0; }
+.nav-links a { position: relative; text-decoration: none; font-size: .85rem; font-weight: 600; }
+.nav-links a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: -7px; height: 2px; background: var(--coral); transition: right .2s ease; }
+.nav-links a:hover::after, .nav-links a[aria-current="page"]::after { right: 0; }
+.nav-toggle { display: none; border: 0; background: transparent; padding: 8px; }
+.nav-toggle > span:not(.sr-only) { display: block; width: 24px; height: 2px; margin: 5px; background: var(--ink); }
+
+.view-stack { position: relative; min-height: calc(100vh - 76px); }
+.spa-view { min-height: calc(100vh - 76px); content-visibility: visible; outline: none; }
+.spa-view:focus-visible { box-shadow: inset 0 0 0 3px var(--coral); }
+.spa-view.inactive { content-visibility: hidden; position: absolute; inset: 0; width: 100%; pointer-events: none; }
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive { display: none; }
+}
+
+h1, h2, h3, p { margin-top: 0; }
+h1, h2, h3 { font-family: "Fraunces", Georgia, serif; line-height: 1.08; }
+h1 { font-size: clamp(3rem, 7vw, 6.7rem); letter-spacing: -.055em; }
+h2 { font-size: clamp(2rem, 4vw, 3.6rem); letter-spacing: -.04em; }
+.eyebrow { margin-bottom: 18px; font-size: .73rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
+.hero { min-height: 650px; display: grid; grid-template-columns: 1.05fr .95fr; }
+.hero-copy { padding: clamp(70px, 9vw, 130px) clamp(28px, 7vw, 110px); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; background: var(--yellow); }
+.hero-copy h1 { max-width: 740px; margin-bottom: 28px; }
+.hero-intro { max-width: 550px; font-size: clamp(1rem, 1.5vw, 1.25rem); }
+.actions { display: flex; gap: 26px; align-items: center; margin-top: 20px; }
+.button { display: inline-flex; align-items: center; justify-content: center; gap: 20px; min-height: 50px; padding: 12px 22px; border: 2px solid var(--ink); text-decoration: none; font-weight: 700; cursor: pointer; transition: transform .2s, box-shadow .2s; }
+.button:hover { transform: translate(-3px, -3px); box-shadow: 5px 5px 0 var(--ink); }
+.button-primary { color: var(--cream); background: var(--ink); }
+.text-link { font-weight: 700; text-underline-offset: 5px; }
+.hero-art { position: relative; min-height: 580px; overflow: hidden; background: linear-gradient(145deg, rgba(28,41,38,.05), transparent 40%), url("https://images.unsplash.com/photo-1512568400610-62da28bc8a13?auto=format&fit=crop&w=1200&q=85") center/cover; }
+.hero-art::after { content: ""; position: absolute; inset: 18px; border: 1px solid rgba(255,255,255,.55); }
+.hero-stamp { position: absolute; z-index: 2; top: 35px; right: 35px; width: 100px; height: 100px; display: grid; place-items: center; text-align: center; border-radius: 50%; color: var(--cream); background: var(--coral); font: 600 1.1rem/1.1 "Fraunces", serif; transform: rotate(9deg); }
+
+.home-content, .content-shell { max-width: 1320px; margin: auto; padding: clamp(70px, 9vw, 130px) clamp(24px, 6vw, 84px); }
+.intro-row { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; margin-bottom: 45px; }
+.intro-row h2 { margin-bottom: 0; }
+.intro-row > p { max-width: 500px; margin: 0 0 8px auto; }
+.coffee-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
+.coffee-card { position: relative; min-height: 430px; padding: 26px; overflow: hidden; border: 1px solid var(--line); }
+.coffee-card .cup { height: 210px; display: grid; place-items: center; margin: -26px -26px 25px; background: rgba(255,255,255,.3); font-size: 5.5rem; }
+.coffee-card h3 { margin: 6px 0 10px; font-size: 1.65rem; }
+.coffee-card p:not(.card-number) { max-width: 300px; font-size: .9rem; }
+.card-number { margin: 0; font-size: .72rem; font-weight: 700; letter-spacing: .12em; }
+.card-maple { background: var(--mint); }
+.card-mocha { background: #ddb49c; }
+.card-cold { background: #bed2df; }
+.price { position: absolute; right: 25px; bottom: 24px; font-weight: 700; }
+
+.page-heading { padding: clamp(75px, 9vw, 125px) clamp(24px, 8vw, 130px); }
+.page-heading.coral { background: var(--coral); }
+.page-heading.yellow { background: var(--yellow); }
+.page-heading h1 { margin-bottom: 22px; }
+.page-heading > p:last-child { max-width: 620px; font-size: 1.15rem; }
+.menu-layout { display: grid; gap: 70px; }
+.menu-group { display: grid; grid-template-columns: 80px 1fr; gap: 30px; }
+.menu-index { font-weight: 700; }
+.menu-group h2 { padding-bottom: 22px; border-bottom: 2px solid var(--ink); font-size: 2.3rem; }
+.menu-list { list-style: none; margin: 0; padding: 0; }
+.menu-list li { display: flex; justify-content: space-between; gap: 30px; padding: 22px 0; border-bottom: 1px solid var(--line); }
+.menu-list strong, .menu-list small { display: block; }
+.menu-list small { margin-top: 5px; color: #53605c; }
+.menu-list b { white-space: nowrap; }
+
+.location-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
+.location-card { min-height: 320px; padding: 34px; border: 1px solid var(--line); background: var(--cream); display: flex; flex-direction: column; }
+.location-card > span { font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
+.location-card h2 { margin: 55px 0 18px; font-size: 2rem; }
+.location-card a { margin-top: auto; font-weight: 700; text-underline-offset: 5px; }
+
+.split-page { min-height: calc(100vh - 76px); display: grid; grid-template-columns: 1fr 1fr; }
+.rewards-art { min-height: 650px; position: relative; display: grid; place-items: center; overflow: hidden; background: var(--mint); }
+.rewards-art > span { z-index: 2; width: 180px; height: 180px; display: grid; place-items: center; border-radius: 50%; border: 4px solid var(--ink); background: var(--yellow); font: 700 4rem "Fraunces", serif; }
+.orbit { position: absolute; border: 2px solid var(--ink); border-radius: 50%; transform: rotate(-20deg); }
+.orbit-one { width: 520px; height: 240px; }
+.orbit-two { width: 290px; height: 590px; }
+.rewards-copy { padding: clamp(70px, 9vw, 125px) clamp(30px, 8vw, 120px); background: var(--cream); }
+.rewards-copy h1 { font-size: clamp(3rem, 5.5vw, 5.6rem); }
+.steps { list-style: none; margin: 45px 0; padding: 0; }
+.steps li { display: flex; gap: 20px; padding: 17px 0; border-top: 1px solid var(--line); }
+.steps li > span { width: 35px; height: 35px; flex: 0 0 auto; display: grid; place-items: center; border: 1px solid var(--ink); border-radius: 50%; }
+.steps p { margin: 2px 0 0; font-size: .9rem; }
+
+.account-page { min-height: calc(100vh - 76px); padding: clamp(70px, 9vw, 130px) clamp(24px, 10vw, 160px); display: grid; grid-template-columns: 1fr minmax(320px, 480px); align-items: center; gap: clamp(50px, 10vw, 150px); background: var(--coral); }
+.account-intro h1 { font-size: clamp(3.5rem, 7vw, 7rem); }
+.account-intro > p:last-child { max-width: 540px; font-size: 1.1rem; }
+.account-card { padding: clamp(28px, 5vw, 55px); background: var(--cream); box-shadow: var(--shadow); }
+.account-card > label { display: block; margin: 18px 0 7px; font-size: .82rem; font-weight: 700; }
+.account-card input[type="email"], .account-card input[type="password"] { width: 100%; padding: 14px 12px; border: 1px solid var(--ink); border-radius: 0; background: white; }
+.form-row { display: flex; justify-content: space-between; gap: 15px; margin: 20px 0; font-size: .8rem; }
+.checkbox { display: flex; align-items: center; gap: 7px; }
+.account-card .button { width: 100%; }
+.form-note { margin: 20px 0 0; text-align: center; font-size: .85rem; }
+
+.site-footer { padding: 42px clamp(20px, 5vw, 72px); display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: center; border-top: 1px solid var(--line); background: var(--ink); color: var(--cream); }
+.site-footer p { margin: 0; text-align: center; font-size: .82rem; }
+.site-footer .copyright { text-align: right; opacity: .7; }
+.footer-brand { color: var(--cream); }
+.footer-brand .brand-mark { border-color: var(--cream); }
+
+@media (max-width: 850px) {
+  .hero, .split-page, .account-page { grid-template-columns: 1fr; }
+  .hero-art { min-height: 420px; grid-row: 1; }
+  .coffee-grid, .location-grid { grid-template-columns: 1fr; }
+  .coffee-card { min-height: 390px; }
+  .coffee-card .cup { height: 180px; }
+  .rewards-art { min-height: 480px; }
+  .account-page { align-items: stretch; }
+  .site-footer { grid-template-columns: 1fr; gap: 22px; text-align: center; }
+  .site-footer .copyright { text-align: center; }
+}
+
+@media (max-width: 650px) {
+  .site-header { height: 66px; }
+  .view-stack, .spa-view { min-height: calc(100vh - 66px); }
+  .nav-toggle { display: block; }
+  .nav-links { position: absolute; top: 66px; left: 0; right: 0; padding: 24px; display: none; flex-direction: column; align-items: flex-start; background: var(--paper); border-bottom: 1px solid var(--line); box-shadow: var(--shadow); }
+  .nav-links.open { display: flex; }
+  .intro-row { grid-template-columns: 1fr; }
+  .intro-row > p { margin: 0; }
+  .menu-group { grid-template-columns: 1fr; gap: 5px; }
+  .actions { align-items: flex-start; flex-direction: column; }
+  .form-row { flex-direction: column; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after { transition-duration: .01ms !important; }
+}
