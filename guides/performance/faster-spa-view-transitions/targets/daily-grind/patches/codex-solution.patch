+// @ts-check
+
+/** @typedef {'home' | 'menu' | 'locations' | 'rewards' | 'account'} ViewName */
+
+const views = /** @type {NodeListOf<HTMLElement>} */ (document.querySelectorAll('.spa-view'));
+const viewLinks = /** @type {NodeListOf<HTMLAnchorElement>} */ (document.querySelectorAll('[data-view-link]'));
+const navToggle = /** @type {HTMLButtonElement | null} */ (document.querySelector('.nav-toggle'));
+const navLinks = document.querySelector('.nav-links');
+const skipLink = /** @type {HTMLAnchorElement | null} */ (document.querySelector('.skip-link'));
+
+/** @type {Record<string, ViewName>} */
+const pathToView = {
+  '/': 'home',
+  '/index.html': 'home',
+  '/menu': 'menu',
+  '/locations': 'locations',
+  '/rewards': 'rewards',
+  '/account': 'account',
+};
+
+/** @param {ViewName} viewName */
+function pathForView(viewName) {
+  return viewName === 'home' ? '/' : `/${viewName}`;
+}
+
+/**
+ * Activate one retained view and remove every other view from layout,
+ * painting, pointer interaction, and the accessibility tree.
+ * @param {ViewName} viewName
+ * @param {{ updateHistory?: boolean, moveFocus?: boolean }} [options]
+ */
+function switchToView(viewName, { updateHistory = true, moveFocus = true } = {}) {
+  const activeView = /** @type {HTMLElement | null} */ (document.querySelector(`[data-view="${viewName}"]`));
+  if (!activeView) return;
+
+  views.forEach((view) => {
+    const isActive = view === activeView;
+    view.classList.toggle('inactive', !isActive);
+    view.setAttribute('aria-hidden', String(!isActive));
+  });
+
+  viewLinks.forEach((link) => {
+    const isCurrent = link.dataset.viewLink === viewName;
+    if (isCurrent) link.setAttribute('aria-current', 'page');
+    else link.removeAttribute('aria-current');
+  });
+
+  document.title = viewName === 'home'
+    ? 'The Daily Grind | Coffee, made personal'
+    : `${viewName[0].toUpperCase()}${viewName.slice(1)} | The Daily Grind`;
+
+  if (updateHistory && window.location.pathname !== pathForView(viewName)) {
+    window.history.pushState({ view: viewName }, '', pathForView(viewName));
+  }
+
+  navLinks?.classList.remove('open');
+  navToggle?.setAttribute('aria-expanded', 'false');
+  skipLink?.setAttribute('href', `#${activeView.id}`);
+  window.scrollTo({ top: 0, behavior: 'auto' });
+
+  if (moveFocus) activeView.focus({ preventScroll: true });
+}
+
+viewLinks.forEach((link) => {
+  link.addEventListener('click', (event) => {
+    const viewName = link.dataset.viewLink;
+    if (!viewName || !(viewName in /** @type {object} */ ({ home: 1, menu: 1, locations: 1, rewards: 1, account: 1 }))) return;
+    event.preventDefault();
+    switchToView(/** @type {ViewName} */ (viewName));
+  });
+});
+
+navToggle?.addEventListener('click', () => {
+  const isOpen = navLinks?.classList.toggle('open') ?? false;
+  navToggle.setAttribute('aria-expanded', String(isOpen));
+});
+
+window.addEventListener('popstate', () => {
+  switchToView(pathToView[window.location.pathname] ?? 'home', { updateHistory: false });
+});
+
+document.querySelector('.account-card')?.addEventListener('submit', (event) => event.preventDefault());
+
+// Resolve the initial route without stealing focus during page load.
+switchToView(pathToView[window.location.pathname] ?? 'home', { updateHistory: false, moveFocus: false });
