+(() => {
+  'use strict';
+
+  const views = Array.from(document.querySelectorAll('.spa-view'));
+  const links = Array.from(document.querySelectorAll('.spa-link[data-view]'));
+  const validViewIds = new Set(views.map((view) => view.id));
+
+  const pathToView = new Map([
+    ['/', 'home'],
+    ['/menu', 'menu'],
+    ['/locations', 'locations'],
+    ['/rewards', 'rewards'],
+    ['/account', 'account'],
+  ]);
+
+  /**
+   * Switch to an already-rendered view without destroying its DOM state.
+   * @param {string} viewId
+   * @param {{ focus?: boolean }} [options]
+   * @returns {boolean} Whether the requested view exists.
+   */
+  function switchToView(viewId, { focus = true } = {}) {
+    if (!validViewIds.has(viewId)) {
+      return false;
+    }
+
+    for (const view of views) {
+      const isActive = view.id === viewId;
+      view.classList.toggle('inactive', !isActive);
+      view.setAttribute('aria-hidden', String(!isActive));
+    }
+
+    for (const link of links) {
+      if (link.dataset.view === viewId) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    }
+
+    if (focus) {
+      const activeView = document.getElementById(viewId);
+      activeView?.focus({ preventScroll: true });
+    }
+
+    return true;
+  }
+
+  /** @param {string} path */
+  function viewForPath(path) {
+    const normalizedPath = path !== '/' ? path.replace(/\/$/, '') : path;
+    return pathToView.get(normalizedPath) ?? 'home';
+  }
+
+  for (const link of links) {
+    link.addEventListener('click', (event) => {
+      if (
+        event.defaultPrevented ||
+        event.button !== 0 ||
+        event.metaKey ||
+        event.ctrlKey ||
+        event.shiftKey ||
+        event.altKey
+      ) {
+        return;
+      }
+
+      const viewId = link.dataset.view;
+      if (!viewId || !validViewIds.has(viewId)) {
+        return;
+      }
+
+      event.preventDefault();
+      const url = new URL(link.href, window.location.href);
+      window.history.pushState({ viewId }, '', url.pathname);
+      switchToView(viewId);
+    });
+  }
+
+  window.addEventListener('popstate', () => {
+    switchToView(viewForPath(window.location.pathname));
+  });
+
+  // Deep links activate the matching cached view. Avoid stealing focus on first load.
+  switchToView(viewForPath(window.location.pathname), { focus: false });
+
+  // Expose the transition helper for integrations that need to activate a view.
+  window.switchToView = switchToView;
+})();
