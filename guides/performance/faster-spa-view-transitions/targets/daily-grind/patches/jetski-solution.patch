+  <!-- SPA Navigation & View Caching Script -->
+  <script>
+    /**
+     * Switches the active view in the Single-Page Application (SPA).
+     * Implements DOM state caching via content-visibility: hidden,
+     * updates aria-hidden attributes, and shifts focus to the active view.
+     * @param {string|HTMLElement} viewId - The ID or DOM element of the view to activate.
+     */
+    function switchToView(viewId) {
+      let activeView = null;
+      if (typeof viewId === 'string') {
+        const cleanId = viewId.replace(/^[#/]+/, '').split('/')[0];
+        activeView = document.getElementById(viewId) ||
+                     document.getElementById(cleanId) ||
+                     document.getElementById(cleanId.replace(/-view$/, '')) ||
+                     document.getElementById(cleanId + '-view');
+      } else if (viewId instanceof HTMLElement) {
+        activeView = viewId;
+      }
+
+      if (!activeView) {
+        console.warn('View not found:', viewId);
+        return;
+      }
+
+      // Hide all views
+      document.querySelectorAll('.spa-view').forEach(view => {
+        view.classList.add('inactive');
+        view.setAttribute('aria-hidden', 'true');
+      });
+
+      // Show the target view
+      activeView.classList.remove('inactive');
+      activeView.setAttribute('aria-hidden', 'false');
+
+      // MANDATORY: Move focus to the new view to ensure a logical tab-order
+      activeView.focus();
+    }
+
+    // Expose switchToView to global window object
+    window.switchToView = switchToView;
+
+    // Set up SPA routing and link click interception
+    document.addEventListener('DOMContentLoaded', () => {
+      // Intercept navigation link clicks
+      document.addEventListener('click', (e) => {
+        const link = e.target.closest('a');
+        if (!link) return;
+
+        const href = link.getAttribute('href');
+        if (!href) return;
+
+        if (href.startsWith('/') || href.startsWith('#')) {
+          const rawTarget = href.replace(/^[#/]+/, '').split('/')[0] || 'home';
+          const targetElement = document.getElementById(rawTarget) ||
+                                document.getElementById(rawTarget + '-view') ||
+                                document.getElementById(rawTarget.replace(/-view$/, ''));
+
+          if (targetElement && targetElement.classList.contains('spa-view')) {
+            e.preventDefault();
+            switchToView(targetElement.id);
+            if (window.history && window.history.pushState) {
+              window.history.pushState(null, '', href);
+            }
+          }
+        }
+      });
+
+      // Handle browser back and forward button navigation
+      window.addEventListener('popstate', () => {
+        const rawTarget = window.location.pathname.replace(/^\//, '') ||
+                          window.location.hash.replace(/^#/, '') ||
+                          'home';
+        const viewId = rawTarget.split('/')[0] || 'home';
+        const targetElement = document.getElementById(viewId) ||
+                              document.getElementById(viewId + '-view') ||
+                              document.getElementById(viewId.replace(/-view$/, ''));
+        if (targetElement && targetElement.classList.contains('spa-view')) {
+          switchToView(targetElement.id);
+        } else {
+          switchToView('home');
+        }
+      });
+    });
+  </script>
