+  <script>
+    function switchToView(viewId) {
+      let activeView = null;
+      if (typeof viewId === 'string') {
+        const cleanId = viewId.replace(/^[#/]+/, '');
+        activeView = document.getElementById(viewId) ||
+                     document.getElementById(cleanId) ||
+                     document.getElementById(cleanId.replace(/^view-/, '')) ||
+                     document.getElementById('view-' + cleanId) ||
+                     document.querySelector(`[data-view="${cleanId}"]`) ||
+                     document.querySelector(`[data-view="${viewId}"]`);
+      } else if (viewId instanceof HTMLElement) {
+        activeView = viewId;
+      }
+
+      if (!activeView) {
+        console.warn('View not found:', viewId);
+        return;
+      }
+
+      // Hide all views
+      document.querySelectorAll('.spa-view').forEach(view => {
+        view.classList.add('inactive');
+        view.setAttribute('aria-hidden', 'true');
+      });
+
+      // Show the target view
+      activeView.classList.remove('inactive');
+      activeView.setAttribute('aria-hidden', 'false');
+
+      // MANDATORY: Move focus to the new view to ensure a logical tab-order
+      if (!activeView.hasAttribute('tabindex')) {
+        activeView.setAttribute('tabindex', '-1');
+      }
+      activeView.focus();
+    }
+
+    // Expose globally
+    window.switchToView = switchToView;
+
+    // Attach link handlers and history navigation
+    document.addEventListener('DOMContentLoaded', () => {
+      document.querySelectorAll('a[href], [data-view]').forEach(elem => {
+        elem.addEventListener('click', (e) => {
+          const targetView = elem.getAttribute('data-view');
+          const href = elem.getAttribute('href');
+          
+          let viewId = targetView;
+          if (!viewId && href) {
+            if (href.startsWith('#')) {
+              viewId = href.slice(1);
+            } else if (href.startsWith('/')) {
+              const path = href.slice(1).split('/')[0];
+              viewId = path || 'home';
+            }
+          }
+
+          if (viewId) {
+            const cleanId = viewId.replace(/^[#/]+/, '');
+            const targetElem = document.getElementById(viewId) ||
+                               document.getElementById(cleanId) ||
+                               document.getElementById(cleanId.replace(/^view-/, '')) ||
+                               document.getElementById('view-' + cleanId) ||
+                               document.querySelector(`[data-view="${cleanId}"]`);
+            if (targetElem) {
+              e.preventDefault();
+              switchToView(viewId);
+              if (window.location.hash !== '#' + cleanId) {
+                history.pushState(null, '', '#' + cleanId);
+              }
+            }
+          }
+        });
+      });
+
+      window.addEventListener('hashchange', () => {
+        const hash = window.location.hash.slice(1);
+        if (hash) {
+          switchToView(hash);
+        }
+      });
+
+      window.addEventListener('popstate', () => {
+        const hash = window.location.hash.slice(1);
+        if (hash) {
+          switchToView(hash);
+        } else {
+          switchToView('home');
+        }
+      });
+
+      // Activate initial view based on hash if present
+      const initialHash = window.location.hash.slice(1);
+      if (initialHash) {
+        switchToView(initialHash);
+      }
+    });
+  </script>
 </body>
 
 </html>
