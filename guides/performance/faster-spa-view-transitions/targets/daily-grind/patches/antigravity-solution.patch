+  <script>
+    function switchToView(viewId, options = { moveFocus: true, pushState: true }) {
+      const activeView = document.getElementById(viewId);
+      if (!activeView) return;
+
+      // Hide all views while preserving their rendered DOM state via content-visibility: hidden
+      document.querySelectorAll('.spa-view').forEach(view => {
+        view.classList.add('inactive');
+        view.setAttribute('aria-hidden', 'true');
+        view.setAttribute('inert', 'inert');
+      });
+
+      // Show the target view
+      activeView.classList.remove('inactive');
+      activeView.setAttribute('aria-hidden', 'false');
+      activeView.removeAttribute('inert');
+
+      // Update active navigation link styling
+      let targetHref = null;
+      document.querySelectorAll('.nav-view-link').forEach(link => {
+        if (link.dataset.view === viewId) {
+          link.classList.add('active-link');
+          link.setAttribute('aria-current', 'page');
+          targetHref = link.getAttribute('href');
+        } else {
+          link.classList.remove('active-link');
+          link.removeAttribute('aria-current');
+        }
+      });
+
+      if (options.pushState && targetHref && window.location.pathname !== targetHref) {
+        window.history.pushState({ viewId }, '', targetHref);
+      }
+
+      // MANDATORY: Move focus to the new view to ensure a logical tab-order
+      if (options.moveFocus !== false) {
+        activeView.focus();
+      }
+    }
+
+    document.querySelectorAll('.nav-view-link').forEach(link => {
+      link.addEventListener('click', event => {
+        event.preventDefault();
+        const viewId = link.dataset.view;
+        if (viewId) {
+          switchToView(viewId);
+        }
+      });
+    });
+
+    window.addEventListener('popstate', event => {
+      if (event.state && event.state.viewId) {
+        switchToView(event.state.viewId, { moveFocus: true, pushState: false });
+      } else {
+        const pathToView = {
+          '/menu': 'view-menu',
+          '/locations': 'view-locations',
+          '/rewards': 'view-rewards',
+          '/account': 'view-account'
+        };
+        const targetView = pathToView[window.location.pathname] || 'view-menu';
+        switchToView(targetView, { moveFocus: false, pushState: false });
+      }
+    });
+  </script>
+
