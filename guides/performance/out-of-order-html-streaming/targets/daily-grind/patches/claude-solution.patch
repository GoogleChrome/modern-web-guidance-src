+  <!-- Streamed later in the same document: patches the Seasonal Favorites range.
+       It re-declares the range so further template updates remain possible. -->
+  <template for="seasonal-cards">
+    <?start name="seasonal-cards">
+    <div class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>
+    <?end>
+  </template>
+
+  <script>
+    // Imperative update of Seasonal Favorites using the built-in HTML setter APIs.
+    // Falls back to innerHTML-free DOM construction where setHTML is unsupported.
+    window.updateSeasonalFavorites = async function (html) {
+      const grid = document.getElementById('seasonal-grid');
+      if (typeof grid.setHTML === 'function') {
+        grid.setHTML(html);
+      } else if (typeof grid.setHTMLUnsafe === 'function') {
+        grid.setHTMLUnsafe(html);
+      } else {
+        const doc = new DOMParser().parseFromString(html, 'text/html');
+        grid.replaceChildren(...doc.body.childNodes);
+      }
+    };
+
+    // Stream a fetched HTML fragment into the grid incrementally.
+    window.streamSeasonalFavorites = async function (url) {
+      const grid = document.getElementById('seasonal-grid');
+      const response = await fetch(url);
+      if (typeof grid.streamHTML === 'function') {
+        await response.body
+          .pipeThrough(new TextDecoderStream())
+          .pipeTo(grid.streamHTML());
+      } else {
+        await window.updateSeasonalFavorites(await response.text());
+      }
+    };
+  </script>
+
