+  <script>
+    // Load polyfills only where the native features are missing.
+    (function () {
+      const needsSetters = !('setHTMLUnsafe' in Element.prototype) || !('streamHTMLUnsafe' in Element.prototype);
+      const needsTemplateFor = !('htmlFor' in HTMLTemplateElement.prototype) && !('for' in HTMLTemplateElement.prototype);
+      const load = (pkg) => {
+        const s = document.createElement('script');
+        s.src = 'https://unpkg.com/' + pkg;
+        document.head.appendChild(s);
+      };
+      if (needsTemplateFor) load('template-for-polyfill');
+      if (needsSetters) load('html-setters-polyfill');
+    })();
+  </script>
+
+  <script type="module">
+    const grid = document.getElementById('seasonal-grid');
+    const reviews = document.getElementById('reviews');
+    const promo = document.getElementById('promo');
+
+    async function fetchStream(url) {
+      const response = await fetch(url, { headers: { Accept: 'text/html' } });
+      if (!response.ok || !response.body) throw new Error(url + ' failed: ' + response.status);
+      return response;
+    }
+
+    function pipe(response, writable) {
+      return typeof response.textStream === 'function'
+        ? response.textStream().pipeTo(writable)
+        : response.body.pipeThrough(new TextDecoderStream()).pipeTo(writable);
+    }
+
+    // First-party menu markup: trusted, no scripts needed.
+    async function refreshMenu() {
+      try {
+        const response = await fetchStream('/api/menu/seasonal');
+        await pipe(response, grid.streamHTMLUnsafe());
+      } catch (err) {
+        console.error(err);
+      }
+    }
+
+    // Customer-submitted content: untrusted, use the sanitizing (safe) API.
+    async function refreshReviews() {
+      try {
+        const response = await fetchStream('/api/reviews');
+        await pipe(response, reviews.streamHTML());
+      } catch (err) {
+        console.error(err);
+      }
+    }
+
+    // Our own CMS promo block ships an embedded widget script, so scripts must run.
+    async function loadPromo() {
+      try {
+        const response = await fetchStream('/api/cms/promo');
+        promo.setHTMLUnsafe(await response.text(), { runScripts: true });
+      } catch (err) {
+        console.error(err);
+      }
+    }
+
+    loadPromo();
+    refreshReviews();
+
+    // Refresh cards when the menu changes on the server.
+    if ('EventSource' in window) {
+      const events = new EventSource('/api/menu/events');
+      events.addEventListener('menu-changed', refreshMenu);
+    }
+    document.addEventListener('visibilitychange', () => {
+      if (document.visibilityState === 'visible') refreshMenu();
+    });
+  </script>
+
