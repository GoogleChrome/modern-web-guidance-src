+  <script>
+    // Polyfills for browsers without native support (markers stay as <?...> syntax).
+    (function () {
+      var needsSetters = !('setHTMLUnsafe' in Element.prototype) || !('streamHTMLUnsafe' in Element.prototype);
+      var needsTemplateFor = !('htmlFor' in HTMLTemplateElement.prototype) && !('for' in HTMLTemplateElement.prototype);
+      var load = function (src) {
+        return new Promise(function (resolve) {
+          var s = document.createElement('script');
+          s.src = src;
+          s.onload = s.onerror = resolve;
+          document.head.appendChild(s);
+        });
+      };
+      var jobs = [];
+      if (needsSetters) jobs.push(load('https://unpkg.com/html-setters-polyfill'));
+      if (needsTemplateFor) jobs.push(load('https://unpkg.com/template-for-polyfill'));
+      window.polyfillsReady = Promise.all(jobs);
+    })();
+  </script>
+  <script>
+    async function streamInto(el, url, opts) {
+      await window.polyfillsReady;
+      const res = await fetch(url, { headers: { Accept: 'text/html' } });
+      if (!res.ok || !res.body) throw new Error(url + ' ' + res.status);
+      const stream = opts.unsafe
+        ? el.streamHTMLUnsafe({ runScripts: true })
+        : el.streamHTML();
+      await res.body.pipeThrough(new TextDecoderStream()).pipeTo(stream);
+    }
+
+    // Refresh cards with fresh server HTML (trusted menu markup, no scripts needed -> safe API).
+    function refreshSeasonalCards() {
+      return streamInto(document.getElementById('seasonal-grid'), '/menu/seasonal-cards.html', { unsafe: false })
+        .catch(function (e) { console.warn('Seasonal refresh failed', e); });
+    }
+
+    // Customer-submitted content: always the sanitizing (safe) API.
+    function loadReviews() {
+      return streamInto(document.getElementById('reviews'), '/reviews.html', { unsafe: false })
+        .catch(function (e) { console.warn('Reviews failed', e); });
+    }
+
+    // Our own CMS promo block, which ships its own widget script: trusted, so run scripts.
+    function loadPromo() {
+      return streamInto(document.getElementById('promo'), '/cms/promo.html', { unsafe: true })
+        .catch(function (e) { console.warn('Promo failed', e); });
+    }
+
+    loadReviews();
+    loadPromo();
+
+    // Menu changes: cross-tab notification, and when the tab becomes visible again.
+    if ('BroadcastChannel' in window) {
+      new BroadcastChannel('menu-updates').onmessage = refreshSeasonalCards;
+    }
+    document.addEventListener('visibilitychange', function () {
+      if (document.visibilityState === 'visible') refreshSeasonalCards();
+    });
+  </script>
