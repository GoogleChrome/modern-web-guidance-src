+  <script>
+    // Imperative update of a card in place. Uses the native setter when available.
+    function updateSeasonalCard(index, { title, description, href }) {
+      const card = document.querySelectorAll('#seasonal-grid .card')[index];
+      if (!card) return;
+      const html = `<h3></h3><p></p><a class="btn">View Details</a>`;
+      if (typeof card.setHTMLUnsafe === 'function') {
+        card.setHTMLUnsafe(html);
+      } else {
+        card.innerHTML = html;
+      }
+      card.querySelector('h3').textContent = title;
+      card.querySelector('p').textContent = description;
+      card.querySelector('a').href = href;
+    }
+    window.updateSeasonalCard = updateSeasonalCard;
+  </script>
