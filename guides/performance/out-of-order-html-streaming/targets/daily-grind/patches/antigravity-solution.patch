+
+  <script>
+    /**
+     * Imperative updates for the Seasonal Favorites section and individual coffee cards
+     * using the native HTML setters and streaming setters APIs.
+     */
+    const seasonalSection = document.getElementById('seasonal-favorites');
+
+    // Update an individual coffee card in-place using setHTML / replaceWithHTML or streamHTML
+    async function updateCoffeeCard(cardSelector, htmlOrStream, options = {}) {
+      const card = document.querySelector(cardSelector);
+      if (!card) return;
+
+      if (typeof htmlOrStream === 'string') {
+        if (options.replace) {
+          if (options.unsafe) {
+            card.replaceWithHTMLUnsafe(htmlOrStream, options);
+          } else {
+            card.replaceWithHTML(htmlOrStream, options);
+          }
+        } else {
+          if (options.unsafe) {
+            card.setHTMLUnsafe(htmlOrStream, options);
+          } else {
+            card.setHTML(htmlOrStream, options);
+          }
+        }
+      } else if (htmlOrStream && typeof htmlOrStream.pipeTo === 'function') {
+        const writable = options.replace
+          ? (options.unsafe ? card.streamReplaceWithHTMLUnsafe(options) : card.streamReplaceWithHTML(options))
+          : (options.unsafe ? card.streamHTMLUnsafe(options) : card.streamHTML(options));
+        await htmlOrStream.pipeTo(writable);
+      }
+    }
+
+    // Stream or set updates into the Seasonal Favorites grid or section
+    async function streamSeasonalFavorites(urlOrChunks, options = {}) {
+      const grid = document.getElementById('seasonal-grid') || seasonalSection;
+      if (!grid) return;
+
+      if (typeof urlOrChunks === 'string') {
+        const response = await fetch(urlOrChunks);
+        if (typeof response.textStream === 'function') {
+          await response.textStream().pipeTo(
+            options.unsafe ? grid.streamHTMLUnsafe(options) : grid.streamHTML(options)
+          );
+        } else if (response.body) {
+          await response.body
+            .pipeThrough(new TextDecoderStream())
+            .pipeTo(options.unsafe ? grid.streamHTMLUnsafe(options) : grid.streamHTML(options));
+        }
+        return;
+      }
+
+      if (Array.isArray(urlOrChunks)) {
+        const stream = new ReadableStream({
+          async start(controller) {
+            for (const chunk of urlOrChunks) {
+              controller.enqueue(chunk);
+            }
+            controller.close();
+          }
+        });
+        await stream.pipeTo(
+          options.unsafe ? grid.streamHTMLUnsafe(options) : grid.streamHTML(options)
+        );
+      }
+    }
+
+    // Append a new coffee card to the seasonal grid using appendHTML / streamAppendHTML
+    async function appendCoffeeCard(htmlOrStream, options = {}) {
+      const grid = document.getElementById('seasonal-grid');
+      if (!grid) return;
+
+      if (typeof htmlOrStream === 'string') {
+        if (options.unsafe) {
+          grid.appendHTMLUnsafe(htmlOrStream, options);
+        } else {
+          grid.appendHTML(htmlOrStream, options);
+        }
+      } else if (htmlOrStream && typeof htmlOrStream.pipeTo === 'function') {
+        const writable = options.unsafe
+          ? grid.streamAppendHTMLUnsafe(options)
+          : grid.streamAppendHTML(options);
+        await htmlOrStream.pipeTo(writable);
+      }
+    }
+
+    // Wire up interactive controls for imperative updates
+    document.getElementById('refresh-seasonal-btn')?.addEventListener('click', async () => {
+      const chunks = [
+        `<div class="card" id="card-maple-oat-latte" data-card="maple-oat-latte">
+          <h3>Spiced Maple Oat Latte</h3>
+          <p>Creamy oat milk infused with Vermont maple syrup and warm autumn spices.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>`,
+        `<div class="card" id="card-dark-roast-espresso" data-card="dark-roast-espresso">
+          <h3>Single-Origin Dark Espresso</h3>
+          <p>Bold, smokey notes of dark chocolate for the ultimate morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>`,
+        `<div class="card" id="card-cold-brew" data-card="cold-brew">
+          <h3>Vanilla Bean Cold Brew</h3>
+          <p>Steeped for 18 hours and finished with Madagascar vanilla bean.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>`
+      ];
+      await streamSeasonalFavorites(chunks);
+    });
+
+    document.getElementById('add-special-btn')?.addEventListener('click', async () => {
+      const existingSpecial = document.getElementById('card-roasters-special');
+      const specialHTML = `
+        <div class="card" id="card-roasters-special" data-card="roasters-special">
+          <h3>Cardamom Honey Cortado</h3>
+          <p>Equal parts rich espresso and steamed milk with wildflower honey.</p>
+          <a href="/menu/specials" class="btn">View Details</a>
+        </div>
+      `;
+      if (existingSpecial) {
+        await updateCoffeeCard('#card-roasters-special', specialHTML, { replace: true });
+      } else {
+        await appendCoffeeCard(specialHTML);
+      }
+    });
+
+    // Expose imperative update helpers for programmatic usage
+    window.dailyGrindUpdates = {
+      updateCoffeeCard,
+      streamSeasonalFavorites,
+      appendCoffeeCard
+    };
+  </script>
