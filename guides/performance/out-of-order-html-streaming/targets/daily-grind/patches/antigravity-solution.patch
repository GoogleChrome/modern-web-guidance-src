+
+  <template for="customer-reviews">
+    <div class="card">
+      <h3>Customer Reviews</h3>
+      <p>"The Maple Oat Latte is the best seasonal drink in town!" &mdash; Alex R.</p>
+    </div>
+  </template>
+
+  <template for="cms-promo">
+    <div class="card">
+      <h3>Rewards Promo</h3>
+      <p>Double points on all seasonal drinks this week!</p>
+    </div>
