+  <script type="module">
+    const grid = document.getElementById('seasonal-cards-grid');
+    const refreshBtn = document.getElementById('refresh-seasonal-btn');
+
+    /**
+     * Updates an individual seasonal card or the seasonal grid statically using the native setHTML() API.
+     */
+    export function updateSeasonalCardHTML(cardSelectorOrElement, htmlContent, options = {}) {
+      const target = typeof cardSelectorOrElement === 'string'
+        ? document.querySelector(cardSelectorOrElement)
+        : cardSelectorOrElement;
+      if (!target) return;
+
+      if (typeof target.setHTML === 'function') {
+        target.setHTML(htmlContent, options);
+      } else if (typeof target.setHTMLUnsafe === 'function') {
+        target.setHTMLUnsafe(htmlContent, options);
+      } else {
+        target.innerHTML = htmlContent;
+      }
+    }
+
+    /**
+     * Replaces a seasonal card element using the native replaceWithHTML() API.
+     */
+    export function replaceSeasonalCardHTML(cardSelectorOrElement, htmlContent, options = {}) {
+      const target = typeof cardSelectorOrElement === 'string'
+        ? document.querySelector(cardSelectorOrElement)
+        : cardSelectorOrElement;
+      if (!target) return;
+
+      if (typeof target.replaceWithHTML === 'function') {
+        target.replaceWithHTML(htmlContent, options);
+      } else if (typeof target.replaceWithHTMLUnsafe === 'function') {
+        target.replaceWithHTMLUnsafe(htmlContent, options);
+      } else {
+        target.outerHTML = htmlContent;
+      }
+    }
+
+    /**
+     * Appends new seasonal card HTML to the grid using the native appendHTML() API.
+     */
+    export function appendSeasonalCardHTML(htmlContent, options = {}) {
+      if (!grid) return;
+      if (typeof grid.appendHTML === 'function') {
+        grid.appendHTML(htmlContent, options);
+      } else if (typeof grid.appendHTMLUnsafe === 'function') {
+        grid.appendHTMLUnsafe(htmlContent, options);
+      } else {
+        grid.insertAdjacentHTML('beforeend', htmlContent);
+      }
+    }
+
+    /**
+     * Dynamically streams HTML updates into a target element (or the seasonal grid)
+     * using the browser's built-in streamHTML() / streamHTMLUnsafe() APIs.
+     */
+    export async function streamSeasonalUpdates(urlOrResponse, target = grid, options = {}) {
+      if (!target) return;
+      const response = typeof urlOrResponse === 'string'
+        ? await fetch(urlOrResponse)
+        : urlOrResponse;
+
+      const getWritable = () => {
+        if (options.runScripts && typeof target.streamHTMLUnsafe === 'function') {
+          return target.streamHTMLUnsafe(options);
+        }
+        if (typeof target.streamHTML === 'function') {
+          return target.streamHTML(options);
+        }
+        if (typeof target.streamHTMLUnsafe === 'function') {
+          return target.streamHTMLUnsafe(options);
+        }
+        return null;
+      };
+
+      const writable = getWritable();
+      if (writable) {
+        if (typeof response.textStream === 'function') {
+          await response.textStream().pipeTo(writable);
+        } else if (response.body) {
+          await response.body
+            .pipeThrough(new TextDecoderStream())
+            .pipeTo(writable);
+        }
+      } else {
+        const html = await response.text();
+        updateSeasonalCardHTML(target, html, options);
+      }
+    }
+
+    // Expose helpers on window for imperative updates
+    window.seasonalFavorites = {
+      updateSeasonalCardHTML,
+      replaceSeasonalCardHTML,
+      appendSeasonalCardHTML,
+      streamSeasonalUpdates,
+    };
+
+    if (refreshBtn && grid) {
+      refreshBtn.addEventListener('click', async () => {
+        try {
+          const response = await fetch('/api/seasonal-favorites');
+          if (response.ok) {
+            await streamSeasonalUpdates(response, grid);
+            return;
+          }
+        } catch {
+          // Fallback to local simulated stream if endpoint is not available
+        }
+
+        const updatedCardsHTML = `
+          <div class="card" id="seasonal-card-1" data-seasonal-card="1">
+            <h3>Spiced Pumpkin Cold Foam</h3>
+            <p>Velvety cold brew topped with house-made pumpkin spice sweet cream.</p>
+            <a href="/menu/seasonal" class="btn">View Details</a>
+          </div>
+          <div class="card" id="seasonal-card-2" data-seasonal-card="2">
+            <h3>Toasted Chestnut Cortado</h3>
+            <p>Equal parts rich espresso and steamed milk infused with roasted chestnut.</p>
+            <a href="/menu/espresso" class="btn">View Details</a>
+          </div>
+          <div class="card" id="seasonal-card-3" data-seasonal-card="3">
+            <h3>Cardamom Honey Latte</h3>
+            <p>Fragrant ground cardamom and wildflower honey balanced with smooth espresso.</p>
+            <a href="/menu/seasonal" class="btn">View Details</a>
+          </div>
+        `;
+
+        if (typeof grid.streamHTML === 'function') {
+          const stream = new ReadableStream({
+            start(controller) {
+              controller.enqueue(updatedCardsHTML);
+              controller.close();
+            }
+          });
+          await stream.pipeTo(grid.streamHTML());
+        } else {
+          updateSeasonalCardHTML(grid, updatedCardsHTML);
+        }
+      });
+    }
+  </script>
