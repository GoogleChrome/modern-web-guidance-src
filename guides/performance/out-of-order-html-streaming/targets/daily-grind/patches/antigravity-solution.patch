+  <!-- Streamed Seasonal Favorites cards replacing the placeholder cards -->
+  <template for="seasonal-cards">
+    <div class="card">
+      <h3>Maple Oat Latte</h3>
+      <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+      <a href="/menu/seasonal" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Dark Roast Espresso</h3>
+      <p>Bold, smokey, and perfect for a morning boost.</p>
+      <a href="/menu/espresso" class="btn">View Details</a>
+    </div>
+    <div class="card">
+      <h3>Cold Brew</h3>
+      <p>Steeped for 18 hours for maximum smoothness.</p>
+      <a href="/menu/cold-brew" class="btn">View Details</a>
+    </div>
+  </template>
+
+  <script>
+    const seasonalGrid = document.getElementById('seasonal-cards-grid');
+    const menuSelect = document.getElementById('menu-select');
+    const customerReviews = document.getElementById('customer-reviews');
+    const reviewForm = document.getElementById('review-form');
+    const cmsPromo = document.getElementById('cms-promo');
+
+    // 1. Refresh coffee cards with fresh HTML streamed from the server whenever the menu changes
+    async function refreshSeasonalCards(menu = menuSelect.value) {
+      const response = await fetch(`/api/menu/seasonal?menu=${encodeURIComponent(menu)}`);
+
+      if (typeof response.textStream === 'function') {
+        await response
+          .textStream()
+          .pipeTo(seasonalGrid.streamHTML());
+      } else {
+        await response.body
+          .pipeThrough(new TextDecoderStream())
+          .pipeTo(seasonalGrid.streamHTML());
+      }
+    }
+
+    menuSelect.addEventListener('change', (event) => {
+      refreshSeasonalCards(event.target.value);
+    });
+
+    document.addEventListener('menu-change', (event) => {
+      refreshSeasonalCards(event.detail?.menu || menuSelect.value);
+    });
+
+    // 2. Render untrusted customer-submitted reviews using safe HTML setters (sanitized by default)
+    const initialCustomerReviewsHTML = `
+      <article class="review-item">
+        <strong>Elena R.</strong>
+        <p>The Maple Oat Latte is the best fall drink in town!</p>
+      </article>
+      <article class="review-item">
+        <strong>Marcus T.</strong>
+        <p>Smooth 18-hour Cold Brew every single morning.</p>
+      </article>
+    `;
+
+    function renderCustomerReviews(reviewsHTML) {
+      if (typeof customerReviews.setHTML === 'function') {
+        customerReviews.setHTML(reviewsHTML);
+      }
+    }
+
+    function appendCustomerReview(authorHTML, commentHTML) {
+      const reviewMarkup = `
+        <article class="review-item">
+          <strong>${authorHTML}</strong>
+          <p>${commentHTML}</p>
+        </article>
+      `;
+      if (typeof customerReviews.appendHTML === 'function') {
+        customerReviews.appendHTML(reviewMarkup);
+      } else if (typeof customerReviews.setHTML === 'function') {
+        customerReviews.setHTML(customerReviews.innerHTML + reviewMarkup);
+      }
+    }
+
+    reviewForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const author = document.getElementById('review-author').value;
+      const comment = document.getElementById('review-comment').value;
+      appendCustomerReview(author, comment);
+      reviewForm.reset();
+    });
+
+    // 3. Render trusted CMS promo block that comes with its own embedded widget script
+    // Uses setHTMLUnsafe / streamHTMLUnsafe with { runScripts: true } so the embedded CMS widget script executes
+    const trustedCmsPromoHTML = `
+      <div class="cms-promo-block">
+        <h3>Double Bean Rewards</h3>
+        <p>Order any seasonal drink today and earn 2x loyalty beans!</p>
+        <div id="cms-promo-widget" data-promo-code="AUTUMN2X">Loading reward widget...</div>
+        <script>
+          (() => {
+            const widget = document.getElementById('cms-promo-widget');
+            if (widget) {
+              const code = widget.getAttribute('data-promo-code');
+              widget.textContent = 'Active Promo Code: ' + code;
+            }
+          })();
+        <\/script>
+      </div>
+    `;
+
+    function renderCmsPromo(promoHTML) {
+      if (typeof cmsPromo.setHTMLUnsafe === 'function') {
+        cmsPromo.setHTMLUnsafe(promoHTML, { runScripts: true });
+      }
+    }
+
+    async function streamCmsPromo(url = '/api/cms/seasonal-promo') {
+      const response = await fetch(url);
+      if (typeof response.textStream === 'function') {
+        await response
+          .textStream()
+          .pipeTo(cmsPromo.streamHTMLUnsafe({ runScripts: true }));
+      } else {
+        await response.body
+          .pipeThrough(new TextDecoderStream())
+          .pipeTo(cmsPromo.streamHTMLUnsafe({ runScripts: true }));
+      }
+    }
+
+    renderCustomerReviews(initialCustomerReviewsHTML);
+    renderCmsPromo(trustedCmsPromoHTML);
+  </script>
 </body>
 
