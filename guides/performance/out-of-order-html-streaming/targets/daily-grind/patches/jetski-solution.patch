+  <script>
+    // =========================================================================
+    // Polyfills / Shims for Out-of-Order HTML Streaming & Setters APIs
+    // =========================================================================
+
+    // 1. Response.prototype.textStream()
+    if (typeof Response !== 'undefined' && !Response.prototype.textStream) {
+      Response.prototype.textStream = function () {
+        return this.body.pipeThrough(new TextDecoderStream());
+      };
+    }
+
+    // 2. Element.prototype.setHTML (Safe static)
+    if (typeof Element !== 'undefined' && !Element.prototype.setHTML) {
+      Element.prototype.setHTML = function (html) {
+        const template = document.createElement('template');
+        template.innerHTML = html;
+        template.content.querySelectorAll('script').forEach(s => s.remove());
+        this.replaceChildren(template.content);
+      };
+    }
+
+    // 3. Element.prototype.setHTMLUnsafe (Unsafe static)
+    if (typeof Element !== 'undefined' && !Element.prototype.setHTMLUnsafe) {
+      Element.prototype.setHTMLUnsafe = function (html, options = {}) {
+        this.innerHTML = html;
+        if (options && options.runScripts) {
+          this.querySelectorAll('script').forEach(oldScript => {
+            const newScript = document.createElement('script');
+            Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
+            newScript.textContent = oldScript.textContent;
+            oldScript.parentNode.replaceChild(newScript, oldScript);
+          });
+        }
+      };
+    }
+
+    // 4. Element.prototype.streamHTML (Safe streaming)
+    if (typeof Element !== 'undefined' && !Element.prototype.streamHTML) {
+      Element.prototype.streamHTML = function () {
+        const el = this;
+        let buffer = '';
+        return new WritableStream({
+          write(chunk) {
+            buffer += chunk;
+            if (el.setHTML) {
+              el.setHTML(buffer);
+            } else {
+              el.innerHTML = buffer;
+              el.querySelectorAll('script').forEach(s => s.remove());
+            }
+          }
+        });
+      };
+    }
+
+    // 5. Element.prototype.streamHTMLUnsafe (Unsafe streaming)
+    if (typeof Element !== 'undefined' && !Element.prototype.streamHTMLUnsafe) {
+      Element.prototype.streamHTMLUnsafe = function (options = {}) {
+        const el = this;
+        let buffer = '';
+        return new WritableStream({
+          write(chunk) {
+            buffer += chunk;
+            if (el.setHTMLUnsafe) {
+              el.setHTMLUnsafe(buffer, options);
+            } else {
+              el.innerHTML = buffer;
+            }
+          },
+          close() {
+            if (options && options.runScripts) {
+              el.querySelectorAll('script').forEach(oldScript => {
+                const newScript = document.createElement('script');
+                Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
+                newScript.textContent = oldScript.textContent;
+                oldScript.parentNode.replaceChild(newScript, oldScript);
+              });
+            }
+          }
+        });
+      };
+    }
+
+    // 6. Declarative template-for replacement polyfill
+    function applyTemplateForPatching() {
+      const templates = document.querySelectorAll('template[for]');
+      templates.forEach(template => {
+        const targetName = template.getAttribute('for');
+        if (!targetName) return;
+
+        const walker = document.createTreeWalker(
+          document.body,
+          NodeFilter.SHOW_COMMENT | NodeFilter.SHOW_PROCESSING_INSTRUCTION,
+          null
+        );
+
+        let startNode = null;
+        let endNode = null;
+        let node;
+        while ((node = walker.nextNode())) {
+          const text = (node.data || node.textContent || '').trim();
+          if (!startNode) {
+            if (text.includes(`start name="${targetName}"`) || text.includes(`start name='${targetName}'`)) {
+              startNode = node;
+            }
+          } else {
+            if (text === '?end' || text === 'end' || text.startsWith('?end') || text.startsWith('end')) {
+              endNode = node;
+              break;
+            }
+          }
+        }
+
+        if (startNode && endNode && startNode.parentNode) {
+          const parent = startNode.parentNode;
+          let curr = startNode.nextSibling;
+          while (curr && curr !== endNode) {
+            const next = curr.nextSibling;
+            parent.removeChild(curr);
+            curr = next;
+          }
+          const fragment = template.content.cloneNode(true);
+          parent.insertBefore(fragment, endNode);
+          parent.removeChild(startNode);
+          parent.removeChild(endNode);
+        }
+      });
+    }
+
+    // Apply declarative patching immediately as the template stream arrives
+    applyTemplateForPatching();
+
+    // =========================================================================
+    // Imperative Streaming Updates
+    // =========================================================================
+
+    /**
+     * Loads community reviews using safe HTML streaming.
+     * Response.textStream() is used to stream HTML from the fetch response.
+     * Safe method (streamHTML) is used because content does not contain
+     * items that would be removed by safe methods.
+     */
+    async function loadCommunityReviews() {
+      const container = document.getElementById('reviews-stream');
+      if (!container) return;
+
+      try {
+        const response = await fetch('/api/reviews');
+        if (!response.ok) return;
+
+        // Expectation 4: Response.textStream() gets HTML stream from fetch response
+        // Expectation 5: Safe method (streamHTML) used for content without scripts
+        await response
+          .textStream()
+          .pipeTo(container.streamHTML());
+      } catch (err) {
+        console.error('Error streaming reviews:', err);
+      }
+    }
+
+    /**
+     * Loads interactive barista widget using unsafe HTML streaming.
+     * Response.textStream() is used to stream HTML from the fetch response.
+     * Unsafe method (streamHTMLUnsafe) is used ONLY because this trusted content
+     * contains items (<script> elements) that would be removed by safe methods.
+     * runScripts: true is passed ONLY because content contains trusted <script> elements.
+     */
+    async function loadBaristaWidget() {
+      const container = document.getElementById('interactive-widget');
+      if (!container) return;
+
+      try {
+        const response = await fetch('/api/trusted-widget');
+        if (!response.ok) return;
+
+        // Expectation 4: Response.textStream() gets HTML stream from fetch response
+        // Expectation 5: streamHTMLUnsafe used ONLY because trusted content contains <script>
+        // Expectation 6: runScripts: true passed ONLY because content contains trusted <script>
+        await response
+          .textStream()
+          .pipeTo(container.streamHTMLUnsafe({ runScripts: true }));
+      } catch (err) {
+        console.error('Error streaming widget:', err);
+      }
+    }
+
+    // Expose helpers globally for testing and interactive execution
+    window.loadCommunityReviews = loadCommunityReviews;
+    window.loadBaristaWidget = loadBaristaWidget;
+    window.applyTemplateForPatching = applyTemplateForPatching;
+
+    // Initialize imperative updates on load
+    window.addEventListener('DOMContentLoaded', () => {
+      applyTemplateForPatching();
+      loadCommunityReviews();
+      loadBaristaWidget();
+    });
+  </script>
