+      const initialCards = document.querySelector('template[for="seasonal-cards"]');
+      if (initialCards instanceof HTMLTemplateElement) {
+        const walker = document.createTreeWalker(cards, NodeFilter.SHOW_COMMENT | NodeFilter.SHOW_PROCESSING_INSTRUCTION);
+        let start = null;
+        let node;
+        while ((node = walker.nextNode())) {
+          if (/^\?start\s+name="seasonal-cards"\s*\??$/.test(node.nodeValue || '')) start = node;
+          if (start && /^\?end\s*\??$/.test(node.nodeValue || '')) {
