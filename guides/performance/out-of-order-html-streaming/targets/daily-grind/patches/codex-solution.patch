@@ -0,0 +1,41 @@
+// @ts-check
+
+/**
+ * Replace the cards using safe native HTML APIs. Returns false if the requested
+ * API is unavailable, leaving the existing cards as the fallback.
+ * @param {string | ReadableStream<string>} content
+ * @returns {Promise<boolean>}
+ */
+export async function updateSeasonalFavorites(content) {
+  const target = /** @type {(HTMLElement & {
+    setHTML?: (html: string) => void,
+    streamHTML?: () => WritableStream<string>
+  }) | null} */ (document.getElementById('seasonal-favorites'));
+
+  if (!target) throw new Error('Seasonal Favorites grid is missing.');
+  if (typeof content === 'string'
+    ? typeof target.setHTML !== 'function'
+    : typeof target.streamHTML !== 'function') {
+    return false;
+  }
+
+  const hadFocus = target.contains(document.activeElement);
+  target.setAttribute('aria-busy', 'true');
+  try {
+    if (typeof content === 'string') {
+      target.setHTML?.(content);
+    } else {
+      const destination = target.streamHTML?.();
+      if (!destination) return false;
+      await content.pipeTo(destination);
+    }
+    return true;
+  } finally {
+    target.removeAttribute('aria-busy');
+    if (hadFocus && (document.activeElement === document.body || !document.activeElement)) {
+      const heading = document.getElementById('seasonal-favorites-heading');
+      heading?.setAttribute('tabindex', '-1');
+      heading?.focus({ preventScroll: true });
+    }
+  }
+}
