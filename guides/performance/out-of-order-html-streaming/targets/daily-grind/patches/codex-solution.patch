--- /dev/null
+++ b/html-support.ts
@@ -0,0 +1,4 @@
+// Capture this before template-for-polyfill wraps setHTML, including in browsers
+// that do not implement the underlying safe setter at all.
+export const supportsNativeSafeHTML = 'setHTML' in Element.prototype
+  && typeof Element.prototype.setHTML === 'function';
