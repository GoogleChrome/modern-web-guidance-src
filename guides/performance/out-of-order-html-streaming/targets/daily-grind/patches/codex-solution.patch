+        try {
+          // This fixed same-origin endpoint must contain only our trusted CMS
+          // output. Never pass customer submissions through this path.
+          const response = await fetchHTML('/api/cms/seasonal-promo');
+          if (response.body && typeof promo.streamHTMLUnsafe === 'function') {
+            await response.body.pipeThrough(new TextDecoderStream())
+              .pipeTo(promo.streamHTMLUnsafe({ runScripts: true }));
+          } else if (typeof promo.setHTMLUnsafe === 'function') {
+            promo.setHTMLUnsafe(await response.text(), { runScripts: true });
+          } else {
+            // Fallback deliberately preserves the trust boundary and executes
+            // embedded scripts only for this first-party CMS fragment.
+            const template = document.createElement('template');
+            template.innerHTML = await response.text();
+            const scripts = Array.from(template.content.querySelectorAll('script'));
+            promo.replaceChildren(template.content);
+            for (const inert of scripts) {
+              const active = document.createElement('script');
+              for (const attribute of inert.attributes) active.setAttribute(attribute.name, attribute.value);
+              active.textContent = inert.textContent;
+              inert.replaceWith(active);
+            }
+          }
+        } catch {
+          document.getElementById('promo-status').textContent = 'Seasonal offers are currently unavailable.';
+        }
+      }
+
+      void loadReviews();
+      void loadPromo();
+    })();
