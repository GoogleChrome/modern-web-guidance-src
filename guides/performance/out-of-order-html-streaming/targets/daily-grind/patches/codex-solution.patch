+          }
+        }
+      }
+      menuStatus.textContent = '';
+
+      // Narrow allowlist fallback for browsers without the native safe setter.
+      // Rebuild nodes: never copy event handlers, styles, embeds, or scripts.
+      function safeFragment(html) {
+        const parsed = new DOMParser().parseFromString(html, 'text/html');
+        const allowed = new Set(['DIV', 'ARTICLE', 'H3', 'P', 'A', 'BLOCKQUOTE', 'CITE', 'STRONG', 'EM', 'UL', 'LI', 'SPAN', 'BR']);
+        const blocked = new Set(['SCRIPT', 'STYLE', 'IFRAME', 'OBJECT', 'EMBED', 'SVG', 'MATH', 'TEMPLATE']);
+        function copy(source, target) {
+          for (const child of source.childNodes) {
+            if (child.nodeType === Node.TEXT_NODE) {
+              target.appendChild(document.createTextNode(child.textContent || ''));
+            } else if (child instanceof Element && !blocked.has(child.tagName)) {
+              if (!allowed.has(child.tagName)) {
+                copy(child, target);
+                continue;
+              }
+              const clean = document.createElement(child.localName);
+              for (const name of ['card', 'btn']) {
+                if (child.classList.contains(name)) clean.classList.add(name);
+              }
+              if (child.tagName === 'A' && child.hasAttribute('href')) {
+                try {
+                  const url = new URL(child.getAttribute('href'), location.href);
+                  if (url.protocol === 'https:' || url.protocol === 'http:') clean.setAttribute('href', url.href);
+                } catch { /* Ignore invalid URLs. */ }
+              }
+              copy(child, clean);
