+            } catch {
+              if (previousCards) cards.replaceChildren(...previousCards);
+              menuStatus.textContent = 'The menu could not be refreshed. Please try again.';
+            } finally {
+              cards.removeAttribute('aria-busy');
+            }
+          }
+        } finally {
+          refreshing = false;
+        }
+      }
+      window.addEventListener('menu-changed', refreshMenu);
