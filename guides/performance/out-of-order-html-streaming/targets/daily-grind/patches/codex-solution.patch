+import { supportsNativeSafeHTML } from './html-support';
+import 'html-setters-polyfill';
+import 'template-for-polyfill';
+import DOMPurify from 'dompurify';
+
+// The setters polyfill cannot supply the Sanitizer API on older browsers.
+// Use DOMPurify only for that safe fallback; never enable scripts for user content.
+type HTMLTarget = HTMLElement & {
+  setHTML?: (html: string) => void;
+  streamHTML: () => WritableStream<string>;
+  streamHTMLUnsafe: (options: { runScripts: boolean }) => WritableStream<string>;
+};
+
+function target(id: string): HTMLTarget {
+  const element = document.getElementById(id);
+  if (!(element instanceof HTMLElement)) throw new Error(`Missing element: ${id}`);
+  return element as HTMLTarget;
+}
+
+async function fetchHTML(element: HTMLElement, signal?: AbortSignal): Promise<Response> {
+  const url = new URL(element.dataset.source ?? '', location.href);
+  if (url.origin !== location.origin) throw new Error('HTML sources must be same-origin');
+  const response = await fetch(url, {
+    signal, cache: 'no-store', headers: { Accept: 'text/html' }, credentials: 'same-origin',
+    redirect: 'error',
+  });
+  if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) {
+    throw new Error('HTML is unavailable');
+  }
+  return response;
+}
+
+async function safeHTML(element: HTMLTarget, response: Response, signal?: AbortSignal): Promise<void> {
+  if (supportsNativeSafeHTML && element.setHTML && response.body) {
+    await response.body.pipeThrough(new TextDecoderStream()).pipeTo(element.streamHTML(), { signal });
+  } else {
+    const html = await response.text();
+    signal?.throwIfAborted();
+    element.replaceChildren(DOMPurify.sanitize(html, { RETURN_DOM_FRAGMENT: true }));
+  }
+}
+
+const cards = target('seasonal-cards');
+const status = target('menu-status');
+const refresh = target('refresh-menu');
+let activeRefresh: AbortController | undefined;
+
+async function refreshMenu(): Promise<void> {
+  activeRefresh?.abort();
+  const controller = new AbortController();
+  activeRefresh = controller;
+  refresh.setAttribute('aria-disabled', 'true');
+  cards.setAttribute('aria-busy', 'true');
+  status.textContent = 'Refreshing seasonal favorites…';
+  // Keep existing cards until the response is available. Focus returns to the
+  // persistent refresh control only when an update would remove the focused card.
+  const previous = cards.cloneNode(true);
+  try {
+    const response = await fetchHTML(cards, controller.signal);
+    if (cards.contains(document.activeElement)) refresh.focus();
+    await safeHTML(cards, response, controller.signal);
+    status.textContent = 'Seasonal favorites are up to date.';
+  } catch {
+    if (controller.signal.aborted) return;
+    cards.replaceChildren(...Array.from(previous.childNodes));
+    status.textContent = 'Could not refresh the menu. Please try again.';
+  } finally {
+    if (activeRefresh === controller) {
+      cards.removeAttribute('aria-busy');
+      refresh.removeAttribute('aria-disabled');
+      activeRefresh = undefined;
+    }
+  }
+}
+
+refresh.addEventListener('click', () => { void refreshMenu(); });
+document.addEventListener('menu-changed', () => { void refreshMenu(); });
+
+// The server emits a named SSE event after a menu change. Manual refresh still
+// works on static hosts. EventSource reconnects automatically after disconnects.
+const eventsURL = cards.dataset.events;
+if (eventsURL && 'EventSource' in window) {
+  let events: EventSource;
+  const connect = (): void => {
+    events = new EventSource(eventsURL);
+    events.addEventListener('menu-changed', () => { void refreshMenu(); });
+  };
+  connect();
+  window.addEventListener('pagehide', () => events.close());
+  window.addEventListener('pageshow', (event) => { if (event.persisted) connect(); });
+}
+
+async function loadReviews(): Promise<void> {
+  const reviews = target('customer-reviews');
+  try {
+    await safeHTML(reviews, await fetchHTML(reviews));
+  } catch {
+    reviews.textContent = 'Customer reviews are currently unavailable.';
+  }
+}
+
+async function loadPromo(): Promise<void> {
+  const promo = target('cms-promo');
+  try {
+    // This endpoint must contain only trusted, first-party CMS output. Never
+    // combine reviews or other customer input with this executable HTML stream.
+    const response = await fetchHTML(promo);
+    if (!response.body) throw new Error('Missing promo stream');
+    await response.body.pipeThrough(new TextDecoderStream())
+      .pipeTo(promo.streamHTMLUnsafe({ runScripts: true }));
+  } catch {
+    promo.textContent = 'Our latest offer is currently unavailable.';
+  }
+}
+
+// Polyfilled declarative patches run through a MutationObserver. Observe the
+// actual card insertion rather than assuming when a late template will arrive.
+function markInitialCardsReady(): void {
+  if (!cards.querySelector('.skeleton')) {
+    if (!activeRefresh) status.textContent = 'Seasonal favorites are ready.';
+    initialCardsObserver.disconnect();
+  }
+}
+const initialCardsObserver = new MutationObserver(markInitialCardsReady);
+initialCardsObserver.observe(cards, { childList: true, subtree: true });
+markInitialCardsReady();
+void loadReviews();
+void loadPromo();
