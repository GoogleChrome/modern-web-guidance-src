+import { build } from 'esbuild';
+import { cp, mkdir, readFile, writeFile } from 'node:fs/promises';
+
+await mkdir('dist', { recursive: true });
+await build({ entryPoints: ['app.ts'], bundle: true, format: 'esm', target: 'es2022', outfile: 'dist/app.js' });
+const html = await readFile('index.html', 'utf8');
+await writeFile('dist/index.html', html.replace('./dist/app.js', './app.js'));
+await cp('partials', 'dist/partials', { recursive: true });
+console.log('Built Daily Grind in dist/');
