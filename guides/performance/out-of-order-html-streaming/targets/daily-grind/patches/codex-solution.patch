diff --git a/tests/streaming.spec.ts b/tests/streaming.spec.ts
new file mode 100644
index 0000000..e42c0de
--- /dev/null
+++ b/tests/streaming.spec.ts
@@ -0,0 +1,68 @@
+import { test, expect } from '@playwright/test';
+
+test('sends a shell with loading markers before the final template', async () => {
+  const response = await fetch('http://127.0.0.1:11222');
+  const reader = response.body!.pipeThrough(new TextDecoderStream()).getReader();
+  const first = await reader.read();
+  expect(first.value).toContain('<?start name="coffee-tip">');
+  expect(first.value).toContain('Loading your brewing tip');
+  expect(first.value).not.toContain('<template for="coffee-tip">');
+  let remaining = '';
+  for (;;) {
+    const { value, done } = await reader.read();
+    if (done) break;
+    remaining += value;
+  }
+  expect(remaining).toContain('<template for="coffee-tip">');
+});
+
+test('patches the fallback and refreshes without moving keyboard focus', async ({ page }) => {
+  const errors: string[] = [];
+  page.on('pageerror', error => errors.push(error.message));
+  await page.goto('/');
+  const content = page.locator('#coffee-tip-content');
+  await expect(content).toContainText('A Better Cup at Home');
+  await expect(content.locator('.skeleton')).toHaveCount(0);
+  await expect(page.locator('template[for="coffee-tip"]')).toHaveCount(0);
+  const before = await content.boundingBox();
+  const button = page.getByRole('button', { name: 'Refresh brewing tip' });
+  await button.focus();
+  await page.keyboard.press('Enter');
+  await expect(content).toContainText('Keep Your Coffee Fresh');
+  await expect(page.locator('#tip-status')).toHaveText('Brewing tip updated.');
+  await expect(button).toBeFocused();
+  expect((await content.boundingBox())?.height).toBe(before?.height);
+  expect(errors).toEqual([]);
+});
+
+test('recovers from fetch failure and allows retry', async ({ page }) => {
+  await page.goto('/');
+  await page.route('**/partials/coffee-tip.html', route => route.fulfill({ status: 503 }));
+  const button = page.getByRole('button', { name: 'Refresh brewing tip' });
+  await button.click();
+  await expect(page.locator('#tip-status')).toContainText('Please try again');
+  await expect(button).toBeEnabled();
+  await expect(page.locator('#coffee-tip-content')).toHaveAttribute('aria-busy', 'false');
+  await expect(page.locator('#coffee-tip-content')).toContainText('A Better Cup at Home');
+  await page.unroute('**/partials/coffee-tip.html');
+  await button.click();
+  await expect(page.locator('#tip-status')).toHaveText('Brewing tip updated.');
+});
+
+test('sanitizes the compatibility path and fits a narrow viewport', async ({ page }) => {
+  await page.setViewportSize({ width: 375, height: 812 });
+  await page.addInitScript(() => {
+    Object.defineProperty(Element.prototype, 'streamHTML', { value: undefined, configurable: true });
+    Object.defineProperty(Response.prototype, 'textStream', { value: undefined, configurable: true, writable: true });
+  });
+  await page.goto('/');
+  await page.route('**/partials/coffee-tip.html', route => route.fulfill({
+    contentType: 'text/html',
+    body: '<article class="card"><h3>Fresh café ☕</h3><script>window.unsafeExecuted=true</script><img src=x onerror="window.unsafeExecuted=true"><p onclick="window.unsafeExecuted=true">Enjoy your coffee.</p></article>',
+  }));
+  await page.getByRole('button', { name: 'Refresh brewing tip' }).click();
+  await expect(page.locator('#coffee-tip-content')).toContainText('Fresh café ☕');
+  await expect(page.locator('#coffee-tip-content script, #coffee-tip-content img, #coffee-tip-content [onclick]')).toHaveCount(0);
+  expect(await page.evaluate(() => 'unsafeExecuted' in window)).toBe(false);
+  expect(await page.evaluate(() => document.documentElement.scrollWidth <= window.innerWidth)).toBe(true);
+});
