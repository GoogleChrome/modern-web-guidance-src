+<div class="card" data-rewards-promo>
+  <h3>Make your next coffee more rewarding</h3>
+  <p>Join Daily Grind Rewards for our latest seasonal offers.</p>
+  <button type="button" class="btn" data-rewards-widget>Explore Rewards</button>
+</div>
+<script>
+  // Self-contained CMS widget: no dependency on other deferred blocks.
+  document.querySelectorAll('[data-rewards-widget]').forEach((button) => {
+    button.addEventListener('click', () => { window.location.assign('/rewards'); });
+  });
+</script>
