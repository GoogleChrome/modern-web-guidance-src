+          // Reconcile edits missed while disconnected, including initial connect.
+          menuEvents.addEventListener('open', refreshMenu);
+        };
+        connectMenuEvents();
+        window.addEventListener('pagehide', () => menuEvents.close());
+        window.addEventListener('pageshow', event => {
+          if (event.persisted) connectMenuEvents();
+        });
+      }
