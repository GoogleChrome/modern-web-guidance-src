--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,32 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+
+const routes = new Map([
+  ['/', ['dist/index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['dist/index.html', 'text/html; charset=utf-8']],
+  ['/assets/app.js', ['dist/assets/app.js', 'text/javascript; charset=utf-8']],
+  ['/partials/coffee-tip.html', ['dist/partials/coffee-tip.html', 'text/html; charset=utf-8']],
+]);
+
+createServer(async (request, response) => {
+  const pathname = new URL(request.url ?? '/', 'http://localhost').pathname;
+  const route = routes.get(pathname);
+  if (!route || !['GET', 'HEAD'].includes(request.method ?? '')) {
+    response.writeHead(route ? 405 : 404).end('Not found');
+    return;
+  }
+  try {
+    const [file, contentType] = route;
+    const html = await readFile(file, 'utf8');
+    response.writeHead(200, { 'Content-Type': contentType, 'Cache-Control': 'no-store' });
+    if (request.method === 'HEAD') { response.end(); return; }
+    const patchIndex = html.indexOf('<template for="coffee-tip">');
+    if (patchIndex === -1) { response.end(html); return; }
+    response.write(html.slice(0, patchIndex));
+    // Simulate deferred work while the shell and loading state render first.
+    const timer = setTimeout(() => response.end(html.slice(patchIndex)), 200);
+    response.on('close', () => clearTimeout(timer));
+  } catch {
+    response.writeHead(500).end('Unable to load this page.');
+  }
+}).listen(Number(process.env.PORT ?? 11222), '0.0.0.0');
diff --git a/src/app.ts b/src/app.ts
new file mode 100644
index 0000000..c4285ca
--- /dev/null
+++ b/src/app.ts
@@ -0,0 +1,73 @@
+import 'template-for-polyfill';
+import DOMPurify from 'dompurify';
+
+// Preserve native decoding when available, including multi-byte chunk boundaries.
+if (typeof Response.prototype.textStream !== 'function') {
+  Response.prototype.textStream = function (): ReadableStream<string> {
+    if (!this.body) throw new TypeError('The response has no body.');
+    return this.body.pipeThrough(new TextDecoderStream());
+  };
+}
+
+type StreamingElement = HTMLElement & {
+  streamHTML?: () => WritableStream<string>;
+};
+
+function safeHTMLStream(target: StreamingElement): WritableStream<string> {
+  if (typeof target.streamHTML === 'function') return target.streamHTML();
+
+  // Older browsers buffer until close. Sanitize the complete document, never
+  // individual chunks, which may end in the middle of a tag or attribute.
+  let html = '';
+  return new WritableStream<string>({
+    write(chunk) { html += chunk; },
+    close() {
+      const content = DOMPurify.sanitize(html, {
+        RETURN_DOM_FRAGMENT: true,
+        ALLOWED_TAGS: ['article', 'h3', 'p', 'strong', 'em'],
+        ALLOWED_ATTR: ['class'],
+      });
+      target.replaceChildren(content);
+    },
+    abort() { html = ''; },
+  });
+}
+
+const content = document.getElementById('coffee-tip-content');
+const button = document.getElementById('refresh-tip');
+const status = document.getElementById('tip-status');
+
+if (content && button instanceof HTMLButtonElement && status) {
+  // The control stays outside the patched range, so keyboard focus is preserved.
+  button.disabled = false;
+  button.addEventListener('click', async () => {
+    if (button.getAttribute('aria-disabled') === 'true') return;
+    button.setAttribute('aria-disabled', 'true');
+    content.setAttribute('aria-busy', 'true');
+    status.textContent = 'Refreshing your brewing tip…';
+    const controller = new AbortController();
+    const timeout = window.setTimeout(() => controller.abort(), 15000);
+    try {
+      const response = await fetch('/partials/coffee-tip.html', {
+        signal: controller.signal,
+        cache: 'no-store',
+        headers: { Accept: 'text/html' },
+      });
+      if (!response.ok || !response.body ||
+          !response.headers.get('content-type')?.includes('text/html')) {
+        throw new Error('Unable to load the brewing tip.');
+      }
+      // The fragment needs no scripts or unsafe markup, so use the safe API.
+      await response.textStream().pipeTo(safeHTMLStream(content), {
+        signal: controller.signal,
+      });
+      status.textContent = 'Brewing tip updated.';
+    } catch {
+      status.textContent = 'The brewing tip could not be refreshed. Please try again.';
+    } finally {
+      window.clearTimeout(timeout);
+      content.setAttribute('aria-busy', 'false');
+      button.removeAttribute('aria-disabled');
+    }
+  });
+}
