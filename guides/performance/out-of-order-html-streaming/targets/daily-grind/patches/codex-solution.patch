+
+      async function setSafeHTML(target, response) {
+        if (response.body && typeof target.streamHTML === 'function') {
+          await response.body.pipeThrough(new TextDecoderStream()).pipeTo(target.streamHTML());
+        } else {
+          const html = await response.text();
+          if (typeof target.setHTML === 'function') target.setHTML(html);
+          else target.replaceChildren(safeFragment(html));
+        }
+      }
+
+      async function fetchHTML(path) {
+        const response = await fetch(path, { headers: { Accept: 'text/html' }, cache: 'no-store' });
+        if (!response.ok) throw new Error(`HTML request failed: ${response.status}`);
+        if (!response.headers.get('content-type')?.toLowerCase().startsWith('text/html')) {
+          throw new Error('Expected an HTML fragment');
+        }
+        return response;
+      }
+
+      // Server contract: fragment endpoints return text/html. The SSE endpoint
+      // sends `event: menu-changed` (with a data field) after menu edits.
+      // Local menu editors can also dispatch `menu-changed` on window.
+      // Serialize refreshes so an older stream cannot overwrite a newer menu.
+      let refreshing = false;
+      let refreshPending = false;
+      async function refreshMenu() {
+        refreshPending = true;
+        if (refreshing) return;
+        refreshing = true;
+        try {
+          while (refreshPending) {
+            refreshPending = false;
+            menuStatus.textContent = 'Updating seasonal favorites…';
+            let previousCards = null;
+            try {
+              const response = await fetchHTML('/api/menu/seasonal');
+              // Keep the focused link intact until the visitor leaves the cards.
+              if (cards.contains(document.activeElement)) {
+                await new Promise(resolve => {
+                  const onFocusOut = () => queueMicrotask(() => {
+                    if (!cards.contains(document.activeElement)) {
+                      cards.removeEventListener('focusout', onFocusOut);
+                      resolve();
+                    }
+                  });
+                  cards.addEventListener('focusout', onFocusOut);
+                });
+              }
