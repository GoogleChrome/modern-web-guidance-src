+<script>
+    // Imperative counterpart to the declarative streaming above: refreshing
+    // pipes a fetch response straight into the DOM instead of the
+    // fetch-JSON-then-rebuild-markup approach used elsewhere in this app.
+    const widget = document.getElementById('trending-now-widget');
+    const button = document.getElementById('trending-refresh-button');
+    const target = document.getElementById('trending-now-content');
+
+    button?.addEventListener('click', async () => {
+        if (!(button instanceof HTMLButtonElement) || !widget || !target) return;
+
+        button.disabled = true;
+        try {
+            const articleId = widget.dataset.articleId ?? '';
+            const response = await fetch(
+                `${import.meta.env.BASE_URL}api/trending-fragment?id=${encodeURIComponent(articleId)}`,
+            );
+
+            if (typeof target.streamHTMLUnsafe === 'function' && typeof response.textStream === 'function' && response.body) {
+                // The fragment is generated server-side from trusted data and
+                // contains a <script>, which a "safe" setter would strip. It's
+                // trusted content, so we use the unsafe streaming setter and
+                // explicitly opt in to running that script.
+                await response.textStream().pipeTo(target.streamHTMLUnsafe({ runScripts: true }));
+            } else {
+                // Fallback for browsers without the native (or polyfilled)
+                // HTML streaming setters: fetch the whole fragment and set it
+                // without executing its script.
+                target.innerHTML = await response.text();
+            }
+        } finally {
+            button.disabled = false;
+        }
+    });
+</script>
