+export interface PopularityData {
+  id: string;
+  views: number;
+  trending: boolean;
+}
+
+/**
+ * Simulates an expensive, database-heavy readership lookup. This is
+ * deliberately slow so it's a good candidate to stream in after the rest of
+ * the article shell, rather than blocking the whole page on it.
+ */
+export async function computePopularity(id: string): Promise<PopularityData> {
+  await new Promise((resolve) => setTimeout(resolve, 700));
+
+  return {
+    id,
+    views: Math.floor(Math.random() * 10000) + 500,
+    trending: Math.random() > 0.3,
+  };
+}
+
+// Renders the loading placeholder for the trending widget. Kept the same
+// height as the real content (see renderTrendingContent) so patching it in
+// later doesn't shift the layout.
+export function renderTrendingSkeleton(): string {
+  return `
+    <div class="flex items-center justify-between gap-4" aria-hidden="true">
+      <div class="space-y-2">
+        <div class="h-3 w-28 animate-pulse rounded bg-gray-200"></div>
+        <div class="h-7 w-36 animate-pulse rounded bg-gray-200"></div>
+      </div>
+      <div class="h-6 w-24 animate-pulse rounded-full bg-gray-200"></div>
+    </div>
+  `;
+}
+
+// Renders the final readership content, generated entirely from trusted,
+// server-computed data (no user input is interpolated). Because this markup
+// includes a <script>, it must be patched in with an "unsafe" HTML setter
+// (a safe setter would strip the script tag).
+export function renderTrendingContent(data: PopularityData): string {
+  const views = data.views.toLocaleString();
+  const badge = data.trending
+    ? `<span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">🔥 Trending</span>`
+    : `<span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600">Steady</span>`;
+
+  return `
+    <div class="flex items-center justify-between gap-4">
+      <div>
+        <p class="text-sm text-gray-500">Live readership</p>
+        <p class="text-3xl font-brand text-gray-900">${views} views</p>
+      </div>
+      ${badge}
+    </div>
+    <script>
+      (function () {
+        var widget = document.currentScript && document.currentScript.closest('[data-trending-widget]');
+        if (!widget) return;
+        widget.classList.add('trending-pulse');
+        window.setTimeout(function () {
+          widget.classList.remove('trending-pulse');
+        }, 1200);
+      })();
+    </script>
+  `;
+}
