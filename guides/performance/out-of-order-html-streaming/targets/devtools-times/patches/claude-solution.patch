+import type { APIRoute } from 'astro';
+import { computePopularity, renderTrendingContent } from '../../utils/popularity';
+
+// Returns an HTML fragment (not JSON) so the client can pipe it straight
+// into the DOM with the imperative HTML streaming setters, instead of
+// fetching JSON and re-building markup by hand.
+export const GET: APIRoute = async ({ url }) => {
+  const id = url.searchParams.get('id') ?? 'unknown';
+  const popularity = await computePopularity(id);
+
+  return new Response(renderTrendingContent(popularity), {
+    status: 200,
+    headers: {
+      'Content-Type': 'text/html; charset=utf-8',
+    },
+  });
+};
