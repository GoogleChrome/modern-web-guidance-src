diff --git a/src/pages/api/partial-update.ts b/src/pages/api/partial-update.ts
new file mode 100644
index 0000000..6dd60b5
--- /dev/null
+++ b/src/pages/api/partial-update.ts
@@ -0,0 +1,22 @@
+import type { APIRoute } from 'astro';
+
+export const GET: APIRoute = async () => {
+  const encoder = new TextEncoder();
+  const stream = new ReadableStream({
+    start(controller) {
+      controller.enqueue(encoder.encode('<div class="p-4 bg-gray-50 rounded-md border border-gray-200">'));
+      controller.enqueue(encoder.encode('<h4 class="font-bold text-gray-900 text-sm mb-1">Live Update</h4>'));
+      controller.enqueue(encoder.encode('<p class="text-sm text-gray-700">Streamed partial update delivered via imperative Response.textStream().</p>'));
+      controller.enqueue(encoder.encode('</div>'));
+      controller.close();
+    },
+  });
+
+  return new Response(stream, {
+    status: 200,
+    headers: {
+      'Content-Type': 'text/html; charset=utf-8',
+      'Transfer-Encoding': 'chunked',
+    },
+  });
+};
