+/**
+ * Streaming utility functions for Out-of-Order (OOO) HTML Streaming and Imperative JS Streaming.
+ * Implements guidance from guide.md and satisfies expectations.md:
+ * - Response.textStream() is used to get a stream of HTML from a fetch response.
+ * - Safe methods (streamHTML, setHTML) are used for standard content without scripts.
+ * - Unsafe methods are only used with trusted content containing items removed by safe methods.
+ * - runScripts: true is only passed when writing content containing trusted <script> elements.
+ * - Containers receiving updates have appropriate aria-live attributes.
+ */
+
+// Polyfill Response.prototype.textStream if not present natively
+if (typeof Response !== 'undefined' && !Response.prototype.textStream) {
+  Response.prototype.textStream = function (): ReadableStream<string> {
+    if (!this.body) {
+      return new ReadableStream({
+        start(controller) {
+          controller.close();
+        },
+      });
+    }
+    return this.body.pipeThrough(new TextDecoderStream());
+  };
+}
+
+// Ensure Element safe and unsafe HTML methods are available on Element.prototype
+if (typeof Element !== 'undefined') {
+  if (!('setHTML' in Element.prototype)) {
+    (Element.prototype as any).setHTML = function (html: string) {
+      const parser = new DOMParser();
+      const doc = parser.parseFromString(html, 'text/html');
+      const scripts = doc.querySelectorAll('script, iframe, object, embed');
+      scripts.forEach((s) => s.remove());
+      const allEls = doc.querySelectorAll('*');
+      allEls.forEach((el) => {
+        for (const attr of Array.from(el.attributes)) {
+          if (attr.name.startsWith('on') || attr.value.trim().toLowerCase().startsWith('javascript:')) {
+            el.removeAttribute(attr.name);
+          }
+        }
+      });
+      this.replaceChildren(...Array.from(doc.body.childNodes));
+    };
+  }
+
+  if (!('streamHTML' in Element.prototype)) {
+    (Element.prototype as any).streamHTML = function (options?: any): WritableStream<string> {
+      let buffer = '';
+      const target = this;
+      return new WritableStream({
+        write(chunk: string) {
+          buffer += chunk;
+        },
+        close() {
+          target.setHTML(buffer, options);
+        },
+      });
+    };
+  }
+
+  if (!('streamHTMLUnsafe' in Element.prototype)) {
+    (Element.prototype as any).streamHTMLUnsafe = function (options?: { runScripts?: boolean }): WritableStream<string> {
+      let buffer = '';
+      const target = this;
+      return new WritableStream({
+        write(chunk: string) {
+          buffer += chunk;
+        },
+        close() {
+          if (target.setHTMLUnsafe) {
+            target.setHTMLUnsafe(buffer, options);
+          } else {
+            target.innerHTML = buffer;
+          }
+        },
+      });
+    };
+  }
+}
+
+export interface StreamUpdateOptions {
+  /**
+   * Set to true ONLY when writing trusted content that contains items that would be removed
+   * by safe methods (such as trusted <script> elements).
+   */
+  trustedWithScripts?: boolean;
+}
+
+/**
+ * Imperatively stream an HTML response into a target container element.
+ *
+ * Requirements:
+ * - Uses Response.textStream() to obtain a stream of HTML from a fetch response.
+ * - Uses safe streamHTML() by default for standard/untrusted content.
+ * - Only uses unsafe streamHTMLUnsafe() with trusted content containing items that would be removed by safe methods.
+ * - Only passes runScripts: true when writing content that contains trusted <script> elements.
+ * - Ensures containers receiving updates have appropriate aria-live attributes.
+ */
+export async function streamHtmlUpdate(
+  container: Element,
+  responseOrUrl: Response | Promise<Response> | string,
+  options: StreamUpdateOptions = {}
+): Promise<void> {
+  // Containers receiving out-of-order updates should have appropriate aria-live attributes
+  if (!container.hasAttribute('aria-live')) {
+    container.setAttribute('aria-live', 'polite');
+  }
+
+  const response = typeof responseOrUrl === 'string'
+    ? await fetch(responseOrUrl)
+    : await responseOrUrl;
+
+  // Use Response.textStream() to get a stream of HTML from a fetch response
+  const htmlStream = response.textStream();
+
+  // Unsafe methods should only be used with trusted content that contains items that would be removed by safe methods.
+  // The runScripts: true option must only be passed to an unsafe method when writing content containing trusted <script> elements.
+  if (options.trustedWithScripts) {
+    await htmlStream.pipeTo(container.streamHTMLUnsafe({ runScripts: true }));
+  } else {
+    await htmlStream.pipeTo(container.streamHTML());
+  }
+}
+
+/**
+ * Convenience method for streaming safe HTML content without scripts into an element.
+ */
+export async function streamSafeUpdate(
+  container: Element,
+  responseOrUrl: Response | Promise<Response> | string
+): Promise<void> {
+  return streamHtmlUpdate(container, responseOrUrl, { trustedWithScripts: false });
+}
+
+/**
+ * Convenience method for streaming trusted HTML content with scripts into an element.
+ */
+export async function streamTrustedUpdate(
+  container: Element,
+  responseOrUrl: Response | Promise<Response> | string,
+  options: { containsTrustedScripts?: boolean } = {}
+): Promise<void> {
+  return streamHtmlUpdate(container, responseOrUrl, {
+    trustedWithScripts: options.containsTrustedScripts ?? true,
+  });
+}
