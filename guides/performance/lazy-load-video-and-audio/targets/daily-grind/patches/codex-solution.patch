diff --git a/media.js b/media.js
new file mode 100644
index 0000000..9b68d2d
--- /dev/null
+++ b/media.js
@@ -0,0 +1,47 @@
+// @ts-check
+
+/** @param {HTMLMediaElement} media */
+function restoreMedia(media) {
+  if (media instanceof HTMLVideoElement && media.dataset.poster) {
+    media.poster = media.dataset.poster;
+    delete media.dataset.poster;
+  }
+  if (media.dataset.src) {
+    media.src = media.dataset.src;
+    delete media.dataset.src;
+  }
+  for (const source of media.querySelectorAll('source[data-src]')) {
+    if (source instanceof HTMLSourceElement && source.dataset.src) {
+      source.src = source.dataset.src;
+      delete source.dataset.src;
+    }
+  }
+}
+
+const lazyMedia = document.querySelectorAll('video[loading="lazy"], audio[loading="lazy"][controls]');
+const supportsLazyMedia = Object.hasOwn(HTMLMediaElement.prototype, 'loading');
+
+if (supportsLazyMedia) {
+  // Native loading defers the restored poster and media resources.
+  for (const media of lazyMedia) {
+    if (media instanceof HTMLMediaElement) restoreMedia(media);
+  }
+} else if ('IntersectionObserver' in window) {
+  const observer = new IntersectionObserver((entries) => {
+    for (const entry of entries) {
+      if (!entry.isIntersecting || !(entry.target instanceof HTMLMediaElement)) continue;
+      restoreMedia(entry.target);
+      entry.target.load();
+      observer.unobserve(entry.target);
+    }
+  }, { rootMargin: '200px 0px' });
+
+  for (const media of lazyMedia) observer.observe(media);
+} else {
+  // Older browsers still have working players; preload="none" limits downloads.
+  for (const media of lazyMedia) {
+    if (!(media instanceof HTMLMediaElement)) continue;
+    restoreMedia(media);
+    media.load();
+  }
+}
