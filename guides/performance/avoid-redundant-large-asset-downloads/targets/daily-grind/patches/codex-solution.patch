diff --git a/scripts/build.js b/scripts/build.js
new file mode 100644
index 0000000..c8f6505
--- /dev/null
+++ b/scripts/build.js
@@ -0,0 +1,34 @@
+import { readFile, writeFile, mkdir, copyFile } from 'node:fs/promises';
+import { webcrypto } from 'node:crypto';
+
+// Vendor the existing photograph once; subsequent builds use the same bytes.
+// Runtime requests always use our real, same-origin copy, with no CORS dependency.
+const source = 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80';
+await mkdir('assets', { recursive: true });
+let bytes;
+try {
+  bytes = await readFile('assets/coffee-hero.jpg');
+} catch (error) {
+  if (error.code !== 'ENOENT') throw error;
+  const response = await fetch(source);
+  if (!response.ok) throw new Error(`Photo download failed: ${response.status}`);
+  if (!response.headers.get('content-type')?.startsWith('image/')) {
+    throw new Error('Expected an image response');
+  }
+  bytes = Buffer.from(await response.arrayBuffer());
+  await writeFile('assets/coffee-hero.jpg', bytes);
+}
+
+const digest = await webcrypto.subtle.digest('SHA-256', bytes);
+const hash = { algorithm: 'SHA-256', value: Buffer.from(digest).toString('hex') };
+const assetUrl = `/assets/coffee-hero-${hash.value}.jpg`;
+await mkdir('dist/assets', { recursive: true });
+await mkdir('dist/src', { recursive: true });
+await writeFile(`dist${assetUrl}`, bytes);
+await Promise.all(['load-asset.js', 'hero.js'].map(file =>
+  copyFile(`src/${file}`, `dist/src/${file}`),
+));
+const html = await readFile('index.html', 'utf8');
+const loader = `<script type="module">\nimport { loadHero } from '/src/hero.js';\nloadHero(${JSON.stringify(assetUrl)}, ${JSON.stringify(hash)});\n</script>`;
+await writeFile('dist/index.html', html.replace('<!-- ASSET_LOADER -->', loader));
+console.log(`Built site with SHA-256 ${hash.value}`);
