--- /dev/null
+++ b/src/hero.js
@@ -0,0 +1,23 @@
+import { loadAsset } from './load-asset.js';
+
+/**
+ * @param {string} url
+ * @param {import('./cos.js').AssetHash} hash
+ */
+export async function loadHero(url, hash) {
+  const hero = document.querySelector('.hero');
+  if (!(hero instanceof HTMLElement)) return;
+  try {
+    // This site's selected photograph uses the default same-site scope.
+    const blob = await loadAsset(url, hash);
+    const objectUrl = URL.createObjectURL(blob);
+    hero.style.backgroundImage =
+      `linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url("${objectUrl}")`;
+    window.addEventListener('pagehide', (event) => {
+      if (!event.persisted) URL.revokeObjectURL(objectUrl);
+    });
+  } catch (error) {
+    // Keep the readable solid-color hero if the network is also unavailable.
+    console.warn('Unable to load the hero photograph.', error);
+  }
+}
diff --git a/src/load-asset.js b/src/load-asset.js
new file mode 100644
index 0000000..efc878e
--- /dev/null
+++ b/src/load-asset.js
@@ -0,0 +1,60 @@
+/** @typedef {import('./cos.js').AssetHash} AssetHash */
+/** @typedef {import('./cos.js').SharingScope} SharingScope */
+
+// Detect support once for this page, before any asset request.
+const storage = globalThis.navigator?.crossOriginStorage;
+const supportsCOS = typeof storage?.requestFileHandle === 'function';
+let blocked = false;
+
+/** @param {unknown} error */
+function isNotAllowed(error) {
+  return typeof error === 'object' && error !== null &&
+    'name' in error && error.name === 'NotAllowedError';
+}
+
+/**
+ * Load exact, build-hashed bytes, checking COS before any network request.
+ * Omit origins for same-site assets; use '*' only for popular public resources.
+ * For several assets, use Promise.all(assets.map(asset => loadAsset(...))).
+ * Each requestFileHandle call always receives one hash.
+ * @param {string} url
+ * @param {AssetHash} hash
+ * @param {SharingScope} [origins]
+ * @returns {Promise<Blob>}
+ */
+export async function loadAsset(url, hash, origins) {
+  if (supportsCOS && !blocked) {
+    try {
+      const handle = await storage.requestFileHandle(hash);
+      return await handle.getFile();
+    } catch (error) {
+      // Policy denial disables subsequent COS calls in this context.
+      // NotFoundError is only a miss, including privacy/popularity gating
+      // for '*' resources: it never establishes that a file is absent.
+      if (isNotAllowed(error)) blocked = true;
+    }
+  }
+
+  const response = await fetch(url);
+  if (!response.ok) {
+    throw new Error(`Asset request failed (${response.status}): ${url}`);
+  }
+  const blob = await response.blob();
+
+  if (supportsCOS && !blocked) {
+    try {
+      const handle = await storage.requestFileHandle(hash, {
+        create: true,
+        ...(origins === undefined ? {} : { origins }),
+      });
+      const writable = await handle.createWritable();
+      await writable.write(blob);
+      await writable.close();
+      // Never read from a newly created handle; the full blob is in hand.
+    } catch (error) {
+      if (isNotAllowed(error)) blocked = true;
+      // Storage is optional. A failed write must not break the asset consumer.
+    }
+  }
+  return blob;
+}
diff --git a/tests/load-asset.test.js b/tests/load-asset.test.js
new file mode 100644
index 0000000..50de47d
--- /dev/null
+++ b/tests/load-asset.test.js
@@ -0,0 +1,144 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { webcrypto } from 'node:crypto';
+
+const originalNavigator = Object.getOwnPropertyDescriptor(globalThis, 'navigator');
+const originalFetch = globalThis.fetch;
+const hash = { algorithm: 'SHA-256', value: 'a'.repeat(64) };
+let sequence = 0;
+
+afterEach(() => {
+  if (originalNavigator) Object.defineProperty(globalThis, 'navigator', originalNavigator);
+  else delete globalThis.navigator;
+  globalThis.fetch = originalFetch;
+});
+
+async function setup(storage) {
+  Object.defineProperty(globalThis, 'navigator', {
+    configurable: true, value: { crossOriginStorage: storage },
+  });
+  return (await import(`../src/load-asset.js?test=${sequence++}`)).loadAsset;
+}
+
+function rejected(name) {
+  return new DOMException('Simulated storage rejection', name);
+}
+
+test('unsupported browsers fetch immediately', async () => {
+  const load = await setup(undefined);
+  let fetches = 0;
+  globalThis.fetch = async () => { fetches++; return new Response('complete asset'); };
+  assert.equal(await (await load('/asset', hash)).text(), 'complete asset');
+  assert.equal(fetches, 1);
+});
+
+test('a cache hit never fetches or requests a writable handle', async () => {
+  const cached = new Blob(['cached']);
+  const load = await setup({ requestFileHandle: async (...args) => {
+    assert.deepEqual(args, [hash]);
+    return { getFile: async () => cached };
+  } });
+  globalThis.fetch = () => { assert.fail('Unexpected fetch'); };
+  assert.equal(await load('/asset', hash), cached);
+});
+
+for (const origins of [undefined, '*', ['https://coffee.example', 'https://shop.example']]) {
+  test(`NotFoundError falls back and fully writes with scope ${JSON.stringify(origins)}`, async () => {
+    const calls = [];
+    const load = await setup({ requestFileHandle: async (requestedHash, options) => {
+      assert.deepEqual(requestedHash, hash);
+      if (!options) { calls.push('lookup'); throw rejected('NotFoundError'); }
+      assert.deepEqual(options, { create: true, ...(origins === undefined ? {} : { origins }) });
+      calls.push('create');
+      return {
+        getFile() { assert.fail('Must not read the newly-created handle'); },
+        async createWritable() {
+          calls.push('writable');
+          return {
+            async write(blob) { calls.push(`write:${await blob.text()}`); },
+            async close() { calls.push('close'); },
+          };
+        },
+      };
+    } });
+    globalThis.fetch = async () => { calls.push('fetch'); return new Response('all bytes'); };
+    assert.equal(await (await load('/asset', hash, origins)).text(), 'all bytes');
+    assert.deepEqual(calls, ['lookup', 'fetch', 'create', 'writable', 'write:all bytes', 'close']);
+  });
+}
+
+for (const stage of ['requestFileHandle', 'getFile']) {
+  test(`NotAllowedError at ${stage} suppresses write-back and subsequent COS calls`, async () => {
+    let calls = 0;
+    const load = await setup({ requestFileHandle: async () => {
+      calls++;
+      if (stage === 'requestFileHandle') throw rejected('NotAllowedError');
+      return { getFile: async () => { throw rejected('NotAllowedError'); } };
+    } });
+    globalThis.fetch = async () => new Response('network');
+    for (let i = 0; i < 2; i++) assert.equal(await (await load('/asset', hash)).text(), 'network');
+    assert.equal(calls, 1);
+  });
+}
+
+for (const stage of ['lookup', 'read', 'create', 'writable', 'write', 'close']) {
+  test(`${stage} rejection preserves network fallback`, async () => {
+    const load = await setup({ requestFileHandle: async (_, options) => {
+      if (!options) {
+        if (stage !== 'read') throw rejected('UnknownError');
+        return { getFile: async () => { throw rejected('UnknownError'); } };
+      }
+      if (stage === 'create') throw rejected('QuotaExceededError');
+      return { createWritable: async () => {
+        if (stage === 'writable') throw rejected('UnknownError');
+        return {
+          async write() { if (stage === 'write') throw rejected('UnknownError'); },
+          async close() { if (stage === 'close') throw rejected('UnknownError'); },
+        };
+      } };
+    } });
+    globalThis.fetch = async () => new Response('network bytes');
+    assert.equal(await (await load('/asset', hash)).text(), 'network bytes');
+  });
+}
+
+test('HTTP errors and network failures propagate without storing an error response', async () => {
+  let calls = 0;
+  const load = await setup({ requestFileHandle: async () => {
+    calls++; throw rejected('NotFoundError');
+  } });
+  globalThis.fetch = async () => new Response('not found', { status: 404 });
+  await assert.rejects(load('/asset', hash), /404/);
+  globalThis.fetch = async () => { throw new TypeError('Offline'); };
+  await assert.rejects(load('/asset', hash), /Offline/);
+  assert.equal(calls, 2);
+});
+
+test('concurrent assets use individual hash lookups through Promise.all', async () => {
+  const seen = [];
+  const load = await setup({ requestFileHandle: async requestedHash => {
+    assert.equal(Array.isArray(requestedHash), false);
+    seen.push(requestedHash);
+    return { getFile: async () => new Blob([requestedHash.value]) };
+  } });
+  const hashes = [hash, { ...hash, value: 'b'.repeat(64) }];
+  const files = await Promise.all(hashes.map(value => load('/asset', value)));
+  assert.deepEqual(seen, hashes);
+  assert.deepEqual(await Promise.all(files.map(file => file.text())), hashes.map(value => value.value));
+});
+
+test('built hash matches the exact served bytes and the page has no direct image fetch', async () => {
+  const html = await readFile('dist/index.html', 'utf8');
+  const match = html.match(/loadHero\(("[^"]+"), (\{[^\n]+\})\)/);
+  assert.ok(match);
+  const url = JSON.parse(match[1]);
+  const builtHash = JSON.parse(match[2]);
+  assert.equal(builtHash.algorithm, 'SHA-256');
+  assert.match(builtHash.value, /^[a-f0-9]{64}$/);
+  const bytes = await readFile(`dist${url}`);
+  const digest = await webcrypto.subtle.digest(builtHash.algorithm, bytes);
+  assert.equal(Buffer.from(digest).toString('hex'), builtHash.value);
+  assert.ok(!html.includes('images.unsplash.com'));
+  assert.ok(!html.includes('url('));
+});
