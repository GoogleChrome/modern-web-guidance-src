diff --git a/src/utils/loadAsset.ts b/src/utils/loadAsset.ts
new file mode 100644
index 0000000..6353431
--- /dev/null
+++ b/src/utils/loadAsset.ts
@@ -0,0 +1,101 @@
+export interface AssetHash {
+  algorithm: 'SHA-256' | 'SHA-384' | 'SHA-512';
+  value: string;
+}
+
+export type SharingScope = '*' | string[];
+
+interface StorageHandle {
+  getFile(): Promise<File>;
+  createWritable(): Promise<{
+    write(data: Blob): Promise<void>;
+    close(): Promise<void>;
+  }>;
+}
+
+interface CrossOriginStorage {
+  requestFileHandle(
+    hash: AssetHash,
+    options?: { create: true; origins?: SharingScope },
+  ): Promise<StorageHandle>;
+}
+
+declare global {
+  interface Navigator {
+    crossOriginStorage?: CrossOriginStorage;
+  }
+}
+
+function isNotAllowed(error: unknown): boolean {
+  return typeof error === 'object' && error !== null &&
+    'name' in error && (error as { name: unknown }).name === 'NotAllowedError';
+}
+
+let lastStorage: CrossOriginStorage | undefined = undefined;
+let isBlocked = false;
+
+/** COS is progressive enhancement. Only the working network path is required for core functionality. */
+export async function loadAsset(
+  url: string,
+  hash: AssetHash,
+  origins?: SharingScope,
+): Promise<Blob> {
+  const storage = typeof navigator === 'undefined' ? undefined :
+    (navigator as Navigator & { crossOriginStorage?: CrossOriginStorage }).crossOriginStorage;
+  const supportsCOS = typeof storage?.requestFileHandle === 'function';
+
+  if (storage !== lastStorage) {
+    lastStorage = storage;
+    isBlocked = false;
+  }
+
+  if (supportsCOS && !isBlocked) {
+    try {
+      const handle = await storage.requestFileHandle(hash);
+      return await handle.getFile();
+    } catch (error: unknown) {
+      // NotFoundError is an expected miss, including for globally shared files:
+      // scope, popularity gating, and privacy GREASE may hide an existing file.
+      // NotAllowedError instead signals denied access; skip write-back and further COS calls.
+      if (isNotAllowed(error)) {
+        isBlocked = true;
+      }
+    }
+  }
+
+  const response = await fetch(url);
+  if (!response.ok) {
+    throw new Error(`Asset download failed (${response.status}): ${url}`);
+  }
+  const blob = await response.blob();
+
+  if (supportsCOS && !isBlocked) {
+    try {
+      const handle = await storage.requestFileHandle(hash, {
+        create: true,
+        ...(origins === undefined ? {} : { origins }),
+      });
+      const writable = await handle.createWritable();
+      await writable.write(blob);
+      await writable.close();
+      // Never read a newly-created handle. We already have the complete blob.
+    } catch (error: unknown) {
+      if (isNotAllowed(error)) {
+        isBlocked = true;
+      }
+      // Quota, policy, and write failures must not break the consuming feature.
+    }
+  }
+  return blob;
+}
+
+export interface SharedAsset {
+  url: string;
+  hash: AssetHash;
+  origins?: SharingScope;
+}
+
+/** Each COS request accepts one hash; distinct resources load concurrently via Promise.all. */
+export function loadAssets(assets: readonly SharedAsset[]): Promise<Blob[]> {
+  return Promise.all(assets.map(({ url, hash, origins }) => loadAsset(url, hash, origins)));
+}
diff --git a/src/utils/searchLibrary.ts b/src/utils/searchLibrary.ts
new file mode 100644
index 0000000..06ec8cf
--- /dev/null
+++ b/src/utils/searchLibrary.ts
@@ -0,0 +1,27 @@
+import type Fuse from 'fuse.js';
+import { searchLibrary } from 'virtual:shared-assets';
+import { loadAsset } from './loadAsset';
+
+let pending: Promise<typeof Fuse> | undefined;
+
+/** Load once per page, on demand. Type-only imports do not bundle a second copy. */
+export function loadSearchLibrary(): Promise<typeof Fuse> {
+  if (!pending) {
+    pending = (async () => {
+      const { url, hash, origins } = searchLibrary;
+      const blob = await loadAsset(url, hash, origins);
+      const moduleUrl = URL.createObjectURL(new Blob([blob], { type: 'text/javascript' }));
+      try {
+        const library: { default: typeof Fuse } = await import(/* @vite-ignore */ moduleUrl);
+        if (typeof library.default !== 'function') throw new Error('Invalid search library');
+        return library.default;
+      } finally {
+        URL.revokeObjectURL(moduleUrl);
+      }
+    })().catch((error: unknown) => {
+      pending = undefined;
+      throw error;
+    });
+  }
+  return pending;
+}
diff --git a/tests/loadAsset.test.mjs b/tests/loadAsset.test.mjs
new file mode 100644
index 0000000..0fb2dc3
--- /dev/null
+++ b/tests/loadAsset.test.mjs
@@ -0,0 +1,178 @@
+import assert from 'node:assert/strict';
+import { afterEach, test } from 'node:test';
+import { loadAsset, loadAssets } from '../src/utils/loadAsset.ts';
+import sharedAssets from '../build/shared-assets.mjs';
+import { webcrypto } from 'node:crypto';
+import { readFile } from 'node:fs/promises';
+
+const hash = { algorithm: 'SHA-256', value: 'ab'.repeat(32) };
+const originalNavigator = Object.getOwnPropertyDescriptor(globalThis, 'navigator');
+const originalFetch = globalThis.fetch;
+const bytes = new Uint8Array([0, 1, 127, 128, 255]);
+
+afterEach(() => {
+  if (originalNavigator) Object.defineProperty(globalThis, 'navigator', originalNavigator);
+  else delete globalThis.navigator;
+  globalThis.fetch = originalFetch;
+});
+
+function setup(storage) {
+  Object.defineProperty(globalThis, 'navigator', {
+    configurable: true,
+    value: { crossOriginStorage: storage },
+  });
+  const events = [];
+  globalThis.fetch = async url => {
+    events.push(['fetch', url]);
+    return new Response(bytes);
+  };
+  return events;
+}
+
+test('unsupported browsers immediately use the real network URL', async () => {
+  const events = setup(undefined);
+  const blob = await loadAsset('/library.mjs', hash);
+  assert.deepEqual(new Uint8Array(await blob.arrayBuffer()), bytes);
+  assert.deepEqual(events, [['fetch', '/library.mjs']]);
+});
+
+test('a local hit reads the file and makes no network or write calls', async () => {
+  const file = new Blob([bytes]);
+  const events = setup({
+    async requestFileHandle(...args) {
+      assert.deepEqual(args, [hash]);
+      return { async getFile() { return file; } };
+    },
+  });
+  assert.equal(await loadAsset('/library.mjs', hash, '*'), file);
+  assert.deepEqual(events, []);
+});
+
+for (const origins of [undefined, '*', ['https://trusted.example']]) {
+  test(`a miss writes all bytes and closes with scope ${JSON.stringify(origins)}`, async () => {
+    const events = setup({
+      async requestFileHandle(receivedHash, options) {
+        assert.deepEqual(receivedHash, hash);
+        if (!options) {
+          events.push(['lookup']);
+          throw new DOMException('May be hidden by scope, popularity or privacy', 'NotFoundError');
+        }
+        assert.deepEqual(options, { create: true, ...(origins === undefined ? {} : { origins }) });
+        events.push(['create']);
+        return {
+          getFile() { assert.fail('Must not read the create handle'); },
+          async createWritable() {
+            events.push(['writable']);
+            return {
+              async write(blob) {
+                assert.deepEqual(new Uint8Array(await blob.arrayBuffer()), bytes);
+                events.push(['write']);
+              },
+              async close() { events.push(['close']); },
+            };
+          },
+        };
+      },
+    });
+    const blob = await loadAsset('/library.mjs', hash, origins);
+    assert.deepEqual(new Uint8Array(await blob.arrayBuffer()), bytes);
+    assert.deepEqual(events.map(event => event[0]), ['lookup', 'fetch', 'create', 'writable', 'write', 'close']);
+  });
+}
+
+for (const stage of ['requestFileHandle', 'getFile']) {
+  test(`NotAllowedError from ${stage} fetches but skips write-back`, async () => {
+    let calls = 0;
+    const deny = () => { throw new DOMException('Denied', 'NotAllowedError'); };
+    const events = setup({
+      async requestFileHandle() {
+        calls++;
+        if (stage === 'requestFileHandle') deny();
+        return { getFile: deny };
+      },
+    });
+    await loadAsset('/library.mjs', hash);
+    assert.equal(calls, 1);
+    assert.equal(events.length, 1);
+  });
+}
+
+for (const stage of ['lookup', 'read', 'create', 'writable', 'write', 'close']) {
+  test(`other failures at ${stage} preserve the network result`, async () => {
+    const fail = () => { throw new Error('Storage unavailable'); };
+    const events = setup({
+      async requestFileHandle(_hash, options) {
+        if (!options) {
+          if (stage === 'lookup') fail();
+          if (stage === 'read') return { getFile: fail };
+          throw new DOMException('Miss', 'NotFoundError');
+        }
+        if (stage === 'create') fail();
+        return {
+          async createWritable() {
+            if (stage === 'writable') fail();
+            return {
+              async write() { if (stage === 'write') fail(); },
+              async close() { if (stage === 'close') fail(); },
+            };
+          },
+        };
+      },
+    });
+    const blob = await loadAsset('/library.mjs', hash);
+    assert.deepEqual(new Uint8Array(await blob.arrayBuffer()), bytes);
+    assert.equal(events.length, 1);
+  });
+}
+
+test('HTTP failures are rejected rather than stored as assets', async () => {
+  let calls = 0;
+  setup({ async requestFileHandle() { calls++; throw new Error('Miss'); } });
+  globalThis.fetch = async () => new Response('not found', { status: 404 });
+  await assert.rejects(loadAsset('/missing.mjs', hash), /404/);
+  assert.equal(calls, 1);
+});
+
+test('network failures propagate', async () => {
+  setup(undefined);
+  globalThis.fetch = async () => { throw new Error('Offline'); };
+  await assert.rejects(loadAsset('/library.mjs', hash), /Offline/);
+});
+
+test('distinct hashes use concurrent individual lookups', async () => {
+  const received = [];
+  const releases = [];
+  setup({
+    requestFileHandle(receivedHash) {
+      received.push(receivedHash);
+      return new Promise(resolve => releases.push(() => resolve({ getFile: async () => new Blob([bytes]) })));
+    },
+  });
+  const secondHash = { ...hash, value: 'cd'.repeat(32) };
+  const pending = loadAssets([
+    { url: '/one.mjs', hash },
+    { url: '/two.mjs', hash: secondHash },
+  ]);
+  assert.deepEqual(received, [hash, secondHash]);
+  releases.forEach(release => release());
+  assert.equal((await pending).length, 2);
+});
+
+test('build manifest hashes the exact emitted standalone library', async () => {
+  const plugin = sharedAssets();
+  plugin.configResolved({ base: '/devtools-times/' });
+  const code = await plugin.load(plugin.resolveId('virtual:shared-assets'));
+  const { searchLibrary } = await import(`data:text/javascript,${encodeURIComponent(code)}`);
+  let emitted;
+  await plugin.generateBundle.call({ emitFile(file) { emitted = file; } });
+  const source = await readFile(new URL(import.meta.resolve('fuse.js')));
+  assert.deepEqual(emitted.source, source);
+  assert.equal(searchLibrary.url, `/devtools-times/${emitted.fileName}`);
+  assert.equal(searchLibrary.origins, '*');
+  assert.match(searchLibrary.hash.value, /^[0-9a-f]{64}$/);
+  const digest = await webcrypto.subtle.digest(searchLibrary.hash.algorithm, emitted.source);
+  assert.equal(searchLibrary.hash.value, Buffer.from(digest).toString('hex'));
+  const library = await import(`data:text/javascript,${encodeURIComponent(source.toString())}`);
+  const index = new library.default([{ title: 'Science breakthrough' }], { keys: ['title'] });
+  assert.equal(index.search('Science')[0].item.title, 'Science breakthrough');
+});
