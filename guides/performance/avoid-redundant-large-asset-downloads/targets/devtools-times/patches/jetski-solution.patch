diff --git a/build/shared-assets.mjs b/build/shared-assets.mjs
new file mode 100644
index 0000000..bc7f73e
--- /dev/null
+++ b/build/shared-assets.mjs
@@ -0,0 +1,57 @@
+import { readFile } from 'node:fs/promises';
+import { webcrypto } from 'node:crypto';
+
+// Read the published, self-contained ESM distribution without transforming it.
+// The manifest and the served file always describe the same exact bytes.
+export default function sharedAssets() {
+  const id = 'virtual:shared-assets';
+  const resolvedId = `\0${id}`;
+  const fileName = 'assets/fuse-7.1.0.mjs';
+  let base = '/';
+  const asset = (async () => {
+    const bytes = await readFile(new URL(import.meta.resolve('fuse.js')));
+    const digest = await webcrypto.subtle.digest('SHA-256', bytes);
+    const value = Buffer.from(digest).toString('hex').toLowerCase();
+    return { bytes, hash: { algorithm: 'SHA-256', value } };
+  })();
+
+  return {
+    name: 'shared-assets',
+    configResolved(config) {
+      base = config.base;
+    },
+    resolveId(source) {
+      if (source === id) return resolvedId;
+    },
+    async load(source) {
+      if (source !== resolvedId) return;
+      const { hash } = await asset;
+      return `export const searchLibrary = ${JSON.stringify({
+        url: `${base}${fileName}`,
+        hash,
+        // Fuse is a public MIT-licensed library distributed across unrelated sites.
+        origins: '*',
+      })};`;
+    },
+    configureServer(server) {
+      server.middlewares.use(async (request, response, next) => {
+        const pathname = request.url?.split('?')[0];
+        if (pathname !== `${base}${fileName}` && pathname !== `/${fileName}`) {
+          next();
+          return;
+        }
+        try {
+          const { bytes } = await asset;
+          response.setHeader('Content-Type', 'text/javascript');
+          response.end(bytes);
+        } catch (error) {
+          next(error);
+        }
+      });
+    },
+    async generateBundle() {
+      const { bytes } = await asset;
+      this.emitFile({ type: 'asset', fileName, source: bytes });
+    },
+  };
+}
