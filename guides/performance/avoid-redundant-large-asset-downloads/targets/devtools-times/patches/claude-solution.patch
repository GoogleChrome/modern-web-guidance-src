+import type { AssetHash } from './crossOriginAssetLoader';
+
+// Computed at build time from the exact published bytes of each vendor
+// asset (crypto.subtle.digest('SHA-256', bytes)). Regenerate whenever a
+// vendor file's contents change, since a stale hash just becomes a
+// permanent cache miss rather than a broken load.
+export const CHART_ENGINE_HASH: AssetHash = {
+  algorithm: 'SHA-256',
+  value: 'd0b05f29add242d49ca2af6081efd5c749dceddf17fb8055eb74438b13786b6c',
+};
+
+export const CHART_THEME_HASH: AssetHash = {
+  algorithm: 'SHA-256',
+  value: '404e7eba82cbc94cabb85b41d1ed5d96b55c755d2c07755e1fdb49c051d3a709',
+};
diff --git a/src/utils/crossOriginAssetLoader.ts b/src/utils/crossOriginAssetLoader.ts
new file mode 100644
index 0000000..6c9c670
--- /dev/null
+++ b/src/utils/crossOriginAssetLoader.ts
@@ -0,0 +1,74 @@
+export interface AssetHash {
+  algorithm: string;
+  value: string;
+}
+
+export type AssetOrigins = '*' | string[];
+
+/**
+ * Loads a large shared asset (AI model weights, a Wasm module, a
+ * fully-bundled JS library, etc.) from Cross-Origin Storage (COS) when the
+ * browser supports it, falling back to a normal network fetch otherwise.
+ * Network responses are written back to COS so the next origin that asks
+ * for the same content hash can skip the download entirely.
+ *
+ * @param url The asset's real, working network URL, used as the fallback.
+ * @param hash The build-time content hash identifying the asset in COS.
+ * @param origins Sharing scope for the write-back; omit for same-site only.
+ */
+export async function loadSharedAsset(
+  url: string,
+  hash: AssetHash,
+  origins?: AssetOrigins,
+): Promise<Blob> {
+  const cos = navigator.crossOriginStorage;
+  // Feature-detect once, up front. Browsers without COS skip straight to a
+  // normal fetch instead of attempting a call that can't succeed.
+  const supportsCOS = !!cos?.requestFileHandle;
+  // Set when Permissions Policy blocks COS in this context (e.g. a
+  // cross-origin iframe the embedder didn't opt in), since every further
+  // COS call here would reject the same way.
+  let blocked = false;
+
+  if (supportsCOS && cos) {
+    try {
+      // Check COS before the network. If another origin already stored this
+      // exact hash, this resolves without any network request at all.
+      const handle = await cos.requestFileHandle(hash);
+      return await handle.getFile();
+    } catch (err) {
+      // A NotFoundError never proves the file is absent from COS: the
+      // origin may be outside its sharing scope, a globally shared file may
+      // not be on the browser's popular-hash list yet, or the browser may
+      // deliberately GREASE the response to protect privacy. Any rejection
+      // (including NotFoundError) falls back to the network below; only a
+      // NotAllowedError additionally skips the write-back, since it means
+      // COS itself is blocked in this context.
+      blocked = err instanceof Error && err.name === 'NotAllowedError';
+    }
+  }
+
+  const response = await fetch(url);
+  const fileBlob = await response.blob();
+
+  if (supportsCOS && cos && !blocked) {
+    try {
+      const handle = await cos.requestFileHandle(hash, {
+        create: true,
+        // Only pass `origins` when the caller chose a scope, so omitting it
+        // keeps the same-site-only default.
+        ...(origins ? { origins } : {}),
+      });
+      const writable = await handle.createWritable();
+      await writable.write(fileBlob);
+      await writable.close();
+      // Never call getFile() on this handle before write()/close() has
+      // resolved; the blob already in hand is returned below instead.
+    } catch {
+      // Storing is a nice-to-have for future visitors, not required for
+      // this call to succeed.
+    }
+  }
+
+  return fileBlob;
+}
