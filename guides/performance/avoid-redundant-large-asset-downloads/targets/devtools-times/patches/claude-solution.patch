+import React, { useEffect, useRef, useState } from 'react';
+import { loadSharedAsset } from '../utils/crossOriginAssetLoader';
+import { CHART_ENGINE_HASH, CHART_THEME_HASH } from '../utils/assetHashes';
+
+interface ChartPoint {
+    label: string;
+    value: number;
+}
+
+interface Props {
+    data: ChartPoint[];
+}
+
+function injectScript(blob: Blob): Promise<void> {
+    return new Promise((resolve, reject) => {
+        const script = document.createElement('script');
+        const objectUrl = URL.createObjectURL(blob);
+        script.src = objectUrl;
+        script.onload = () => {
+            URL.revokeObjectURL(objectUrl);
+            resolve();
+        };
+        script.onerror = () => {
+            URL.revokeObjectURL(objectUrl);
+            reject(new Error('Failed to evaluate shared chart asset'));
+        };
+        document.body.appendChild(script);
+    });
+}
+
+export default function ReportsPulseChart({ data }: Props) {
+    const containerRef = useRef<HTMLDivElement>(null);
+    const [status, setStatus] = useState<'loading' | 'ready' | 'error'>('loading');
+
+    useEffect(() => {
+        let cancelled = false;
+
+        async function renderChart() {
+            try {
+                const base = import.meta.env.BASE_URL;
+
+                // These two files are proprietary build output for this site,
+                // not a popular shared library like three.js, so `origins` is
+                // deliberately omitted and any write-back stays same-site-only.
+                // Each hash is looked up independently via Promise.all rather
+                // than a single batched call.
+                const [engineBlob, themeBlob] = await Promise.all([
+                    loadSharedAsset(`${base}vendor/chart-engine.js`, CHART_ENGINE_HASH),
+                    loadSharedAsset(`${base}vendor/chart-theme.js`, CHART_THEME_HASH),
+                ]);
+
+                if (cancelled) return;
+
+                await Promise.all([injectScript(engineBlob), injectScript(themeBlob)]);
+
+                if (cancelled || !containerRef.current) return;
+
+                window.ChartEngine?.renderBarChart(containerRef.current, data, window.ChartTheme);
+                setStatus('ready');
+            } catch (error) {
+                console.error('Failed to load reports pulse chart:', error);
+                if (!cancelled) setStatus('error');
+            }
+        }
+
+        renderChart();
+
+        return () => {
+            cancelled = true;
+        };
+    }, [data]);
+
+    return (
+        <div className="my-6 p-4 border border-gray-200 rounded-md not-prose">
+            <h3 className="text-sm font-semibold text-gray-500 mb-2">Reports by Category</h3>
+            {status === 'error' && (
+                <p className="text-sm text-gray-500">Chart is unavailable right now.</p>
+            )}
+            <div ref={containerRef} />
+        </div>
+    );
+}
