+(function (global) {
+  'use strict';
+
+  function renderBarChart(container, data, theme) {
+    if (!container) {
+      return;
+    }
+
+    container.innerHTML = '';
+
+    var palette = (theme && theme.colors) || ['#f59e0b'];
+    var values = data.map(function (point) {
+      return point.value;
+    });
+    var maxValue = Math.max.apply(Math, [1].concat(values));
+
+    var wrapper = document.createElement('div');
+    wrapper.style.display = 'flex';
+    wrapper.style.alignItems = 'flex-end';
+    wrapper.style.gap = '12px';
+    wrapper.style.padding = '8px';
+
+    data.forEach(function (point, index) {
+      var column = document.createElement('div');
+      column.style.display = 'flex';
+      column.style.flexDirection = 'column';
+      column.style.alignItems = 'center';
+      column.style.flex = '1';
+
+      var track = document.createElement('div');
+      track.style.display = 'flex';
+      track.style.alignItems = 'flex-end';
+      track.style.height = '120px';
+      track.style.width = '100%';
+
+      var bar = document.createElement('div');
+      var heightPercent = (point.value / maxValue) * 100;
+      bar.style.width = '100%';
+      bar.style.height = heightPercent + '%';
+      bar.style.backgroundColor = palette[index % palette.length];
+      bar.style.borderRadius = '4px 4px 0 0';
+      bar.title = point.label + ': ' + point.value;
+      track.appendChild(bar);
+
+      var label = document.createElement('span');
+      label.textContent = point.label;
+      label.style.fontSize = '11px';
+      label.style.marginTop = '6px';
+      label.style.color = '#4b5563';
+      label.style.textAlign = 'center';
+
+      column.appendChild(track);
+      column.appendChild(label);
+      wrapper.appendChild(column);
+    });
+
+    container.appendChild(wrapper);
+  }
+
+  global.ChartEngine = { renderBarChart: renderBarChart };
+})(window);
