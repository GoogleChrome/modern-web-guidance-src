@@ -0,0 +1,20 @@
+/*
+ * Self-hosted @font-face for the "Grenze" brand font, normally served by
+ * Google Fonts. This file is shipped as a static asset (not run through the
+ * Tailwind/Lightning CSS build pipeline) so the `integrity()` /
+ * `cross-origin-storage()` url() modifiers below survive unminified/unstripped.
+ *
+ * The COS-enhanced source is listed first so a browser that supports the
+ * Cross-Origin Storage API tries it first; the plain url() fallback after it
+ * points at the font's real, working network location and is used by every
+ * browser that doesn't recognize cross-origin-storage()/integrity().
+ */
+@font-face {
+  font-family: "Grenze";
+  font-style: normal;
+  font-weight: 500;
+  font-display: swap;
+  src:
+    url("https://fonts.gstatic.com/s/grenze/v18/O4ZOFGb7hR12Bxqt9ErXQpCpkHScyrnU2HA.ttf" integrity("sha256-ZFxYd0EgA2BFH0GBDESTVekxjztdMebPDBX4Ld+IuCc=") cross-origin-storage(*)) format("truetype"),
+    url("https://fonts.gstatic.com/s/grenze/v18/O4ZOFGb7hR12Bxqt9ErXQpCpkHScyrnU2HA.ttf") format("truetype");
+}
