diff --git a/src/utils/shared-config.ts b/src/utils/shared-config.ts
new file mode 100644
index 0000000..b3d1c13
--- /dev/null
+++ b/src/utils/shared-config.ts
@@ -0,0 +1,22 @@
+export interface SharedConfig {
+  theme: string;
+  version: number;
+}
+
+export async function loadSharedConfig(): Promise<SharedConfig> {
+  let mod: { default: SharedConfig };
+  try {
+    // @ts-ignore
+    mod = await import('/assets/shared-config.js', {
+      with: {
+        integrity: 'sha256-/HriZgQoB51h9br04HIpeiJWX0ephs2au4oCPqxQNKU=',
+        crossOriginStorage: '*',
+      },
+    });
+  } catch {
+    // Fall back to a plain import of the same URL.
+    // @ts-ignore
+    mod = await import('/assets/shared-config.js');
+  }
+  return mod.default;
+}
