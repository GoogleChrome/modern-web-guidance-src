diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..d5b4024
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,24 @@
+import { createHash } from 'node:crypto';
+import { copyFile, mkdir, readFile } from 'node:fs/promises';
+
+const root = new URL('../', import.meta.url);
+const html = await readFile(new URL('index.html', root), 'utf8');
+const stylesheet = await readFile(new URL('assets/site.css', root));
+const integrity = `sha384-${createHash('sha384').update(stylesheet).digest('base64')}`;
+const link = html.match(/<link\b[^>]*href="\/assets\/site\.css"[^>]*>/)?.[0];
+
+// Fail before publishing if edited stylesheet bytes no longer match the SRI hash.
+if (!link?.includes(`integrity="${integrity}"`)) {
+  throw new Error(`Update the stylesheet integrity in index.html to "${integrity}".`);
+}
+if (!/\scrossoriginstorage\s*>/.test(link)) {
+  throw new Error('The site stylesheet must opt into same-site COS with a valueless attribute.');
+}
+if (!link.includes('crossorigin="anonymous"')) {
+  throw new Error('Keep the stylesheet CORS mode independent of its COS sharing scope.');
+}
+
+await mkdir(new URL('dist/assets/', root), { recursive: true });
+await copyFile(new URL('index.html', root), new URL('dist/index.html', root));
+await copyFile(new URL('assets/site.css', root), new URL('dist/assets/site.css', root));
+console.log('Built dist/ and verified stylesheet integrity and same-site COS sharing.');
