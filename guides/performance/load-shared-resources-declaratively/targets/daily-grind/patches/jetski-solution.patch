+    document.addEventListener('DOMContentLoaded', () => {
+      if (window.AOS) {
+        AOS.init({ once: true, duration: 600 });
+      }
+    });
+  </script>
+  <script type="module">
+    const CONFETTI_URL = 'https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.module.mjs';
+    const CONFETTI_INTEGRITY = 'sha384-Oln2s8an2v2F4OgGGETrhijDrdp+DA3ZVlo49yyNanHu76+bzSgjdTZ+WgF2uGIr';
+
+    async function loadConfetti() {
+      try {
+        // MANDATORY: dynamic import() inside try/catch. A browser without native
+        // support for the crossOriginStorage import attribute rejects this before
+        // fetching anything, even when navigator.crossOriginStorage exists
+        // (for example, added by an extension), so the catch block is the real fallback path.
+        const mod = await import(CONFETTI_URL, {
+          with: {
+            integrity: CONFETTI_INTEGRITY,
+            crossOriginStorage: '*',
+          },
+        });
+        return mod.default;
+      } catch {
+        const mod = await import(CONFETTI_URL);
+        return mod.default;
+      }
+    }
+
+    document.getElementById('claim-btn')?.addEventListener('click', async () => {
+      const confetti = await loadConfetti();
+      confetti({ particleCount: 80, spread: 70, origin: { y: 0.7 } });
+    });
+  </script>
