+      style.setProperty('--bridge-edge', `${event.clientX < rect.left ? 0 : rect.width}px`);
+      style.setProperty('--bridge-height', `${rect.height}px`);
+      const update = ({ clientX, clientY, target }) => {
+        if (target !== submenu && submenu.contains(target)) return stop();
+        style.setProperty('--bridge-x', `${clientX - rect.left}px`);
+        style.setProperty('--bridge-y', `${clientY - rect.top}px`);
+      };
+      const timer = setTimeout(() => stop(), 300);
+      const stop = () => {
+        clearTimeout(timer);
+        document.removeEventListener('pointermove', update);
+        submenu.removeEventListener('toggle', stop);
+        submenu.removeAttribute('data-bridge');
+      };
+      update(event);
+      submenu.dataset.bridge = '';
+      document.addEventListener('pointermove', update);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+
+    // Close menus that no longer contain focus (Tab out, outside focus, or a sibling item taking focus)
+    document.addEventListener('focusin', event => {
+      document.querySelectorAll('[popover]:popover-open').forEach(menu => {
+        if (!menu.contains(event.target) && triggerFor(menu) !== event.target) menu.hidePopover();
+      });
+    });
+
+    document.addEventListener('keydown', event => { lastKey = event.key; }, true);
+
+    // Activation of commands and checkable items
+    document.addEventListener('click', event => {
+      const item = event.target.closest('[popover] [focusgroup] button:not([commandfor]), [popover] [focusgroup] a[href]');
+      if (!item) return;
+      const menu = item.closest('[popover]');
+      const root = rootOf(item);
+      const fromPointer = event.detail !== 0;
+      const finish = delay => setTimeout(() => closeAndRestore(root, { fromPointer }), delay);
+      const role = item.getAttribute('role');
+
+      if (item.matches('a[href]')) {
+        if (root && isOpen(root)) root.hidePopover();
+        return;
+      }
+      if (role === 'menuitemcheckbox') {
+        item.setAttribute('aria-checked', String(item.getAttribute('aria-checked') !== 'true'));
+        if (!fromPointer && lastKey === ' ') return; // Space toggles and stays open
+        return void finish(300);
+      }
+      if (role === 'menuitemradio') {
+        item.closest('[role="group"]').querySelectorAll('[role="menuitemradio"]')
+          .forEach(radio => radio.setAttribute('aria-checked', String(radio === item)));
+        return void finish(300);
+      }
+      if (item.dataset.action === 'add') {
+        const choices = [...root.querySelectorAll('[aria-checked="true"]')].map(el => el.textContent.trim());
+        status.textContent = `Added ${root.dataset.item} (${choices.join(', ')}) to your order.`;
+      }
+      closeAndRestore(root, { fromPointer });
+    });
+  </script>
+
 </body>
 
