+
+        // Hover switches open top-level menubar menus
+        if (isMenubarTrigger(trigger)) {
+          const menubar = trigger.closest('[role="menubar"]');
+          trigger.addEventListener('pointerenter', () => {
+            if (!canHover.matches) return;
+            const barTriggers = [...menubar.querySelectorAll(':scope > button[commandfor]')];
+            const openOther = barTriggers.find(t => t !== trigger && isOpen(menuFor(t)));
+            if (openOther) {
+              menuFor(openOther).hidePopover();
+              trigger.focus({ focusVisible: false });
+              showPopoverAnchored(menu, trigger);
+            }
+          });
+        }
+
+        // Safe triangle when pointer leaves a submenu trigger whose submenu is open
+        if (isSubmenuTrigger(trigger)) {
+          trigger.addEventListener('pointerleave', event => {
+            startBridge(menu, event);
+          });
+        }
+      });
+
+      // 7. Hover follows focus inside menus
+      document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+        group.addEventListener('pointermove', event => {
+          const item = event.target.closest('button');
+          if (!item || item.closest('[focusgroup]') !== group) return;
+          if (item.disabled || item.getAttribute('aria-disabled') === 'true') return;
+          if (document.activeElement !== item) {
+            item.focus({ focusVisible: false, preventScroll: true });
+          }
+        });
+      });
+
+      // 8. Outside focus & sibling submenu cleanup
+      document.addEventListener('focusin', event => {
+        const target = event.target;
+        const inMenu = target.closest('[popover]');
+        const inTrigger = target.closest('button[commandfor]');
+
+        if (!inMenu && !inTrigger) {
+          closeAllMenus();
+          return;
+        }
+
+        // If focus moved to an item inside a menu, close any open sibling submenu in that same menu
+        if (inMenu) {
+          const group = target.closest('[focusgroup~="menu"]');
+          if (group) {
+            group.querySelectorAll(':scope > [popover]').forEach(sub => {
+              const subTrigger = triggerFor(sub);
+              if (isOpen(sub) && target !== subTrigger && !sub.contains(target)) {
+                sub.hidePopover();
+              }
+            });
+          }
+        }
+      });
+
+      // 9. Command & checkable item activation
+      const statusEl = document.getElementById('menu-status');
+
+      function announce(message) {
+        if (statusEl) statusEl.textContent = message;
+      }
+
+      function updateCardSummary(card) {
+        if (!card) return;
+        const drink = card.dataset.drink;
+        const summaryEl = card.querySelector('.card-summary');
+        const menu = card.querySelector('[popover]');
+        if (!summaryEl || !menu) return;
+        const checked = [...menu.querySelectorAll('button[aria-checked="true"]')]
+          .map(btn => btn.textContent.trim());
+        if (checked.length) {
+          summaryEl.textContent = checked.slice(0, 3).join(' · ');
+        }
+        return drink;
+      }
+
+      document.querySelectorAll('[focusgroup~="menu"] button:not([commandfor])').forEach(item => {
+        item.addEventListener('pointerdown', event => {
+          // Keep focus from flashing outline before click completes
+          event.preventDefault();
+        });
+
+        item.addEventListener('click', event => {
+          const role = item.getAttribute('role');
+          const fromPointer = event.detail !== 0;
+          const activatedBySpace = !fromPointer && lastKey === ' ';
+          lastKey = null;
+
+          const rootMenu = rootMenuFor(item);
+          const rootTrigger = triggerFor(rootMenu);
+          const card = rootTrigger ? rootTrigger.closest('.card') : null;
+          const contextName = card ? card.dataset.drink : (rootTrigger ? rootTrigger.textContent.replace('▾', '').trim() : 'Menu');
+          const label = item.textContent.trim();
+
+          if (role === 'menuitemcheckbox') {
+            const checked = item.getAttribute('aria-checked') !== 'true';
+            item.setAttribute('aria-checked', String(checked));
+            updateCardSummary(card);
+            announce(`${contextName}: ${label} ${checked ? 'enabled' : 'disabled'}.`);
+            // Space on a checkbox toggles and stays open (APG); Enter or pointer closes after ~300ms
+            if (activatedBySpace) return;
+            setTimeout(() => {
+              closeAndRestore(rootMenu, { fromPointer });
+            }, 300);
+            return;
+          }
+
+          if (role === 'menuitemradio') {
+            const group = item.closest('[role="group"]') || item.closest('[focusgroup~="menu"]');
+            if (group) {
+              group.querySelectorAll('button[role="menuitemradio"]').forEach(radio => {
+                radio.setAttribute('aria-checked', String(radio === item));
+              });
+            }
+            updateCardSummary(card);
+            announce(`${contextName}: Selected ${label}.`);
+            setTimeout(() => {
+              closeAndRestore(rootMenu, { fromPointer });
+            }, 300);
+            return;
+          }
+
+          announce(`${contextName}: Activated "${label}".`);
+          closeAndRestore(rootMenu, { fromPointer });
+        });
+      });
+
+      // 10. Keyboard navigation (Menubar roving triggers, submenus, Escape, Home/End, Tab-to-exit, Typeahead)
+      function switchMenubarTrigger(currentTrigger, dir) {
+        const menubar = currentTrigger ? currentTrigger.closest('[role="menubar"]') : null;
+        if (!menubar) return;
+        const barTriggers = [...menubar.querySelectorAll(':scope > button[commandfor]')];
+        const idx = barTriggers.indexOf(currentTrigger);
+        if (idx < 0) return;
+        const nextTrigger = barTriggers[(idx + dir + barTriggers.length) % barTriggers.length];
+        const currentMenu = menuFor(currentTrigger);
+        if (isOpen(currentMenu)) currentMenu.hidePopover();
+        nextTrigger.focus();
+      }
+
+      document.addEventListener('keydown', event => {
+        lastKey = event.key;
+        const target = event.target;
+
+        // Handle Tab to exit the menu system cleanly without stepping through commands
+        if (event.key === 'Tab') {
+          const inPopover = target.closest('[popover]');
+          const inTrigger = target.closest('button[commandfor]');
+          if (inPopover || inTrigger) {
+            const rootMenu = inPopover ? rootMenuFor(inPopover) : menuFor(inTrigger);
+            const rootTrigger = triggerFor(rootMenu) || inTrigger;
+            if (rootTrigger) {
+              const menubar = rootTrigger.closest('[role="menubar"]');
+              const focusTarget = (menubar && event.shiftKey)
+                ? menubar.querySelector(':scope > button[commandfor]')
+                : rootTrigger;
+              if (focusTarget && document.activeElement !== focusTarget) {
+                suppressPreview.add(focusTarget);
+                focusTarget.focus({ focusVisible: false });
+                queueMicrotask(() => suppressPreview.delete(focusTarget));
+              }
+            }
+            closeAllMenus();
+          }
+          return;
+        }
+
+        // Keydown on a top-level trigger
+        const trigger = target.closest('button[commandfor]');
+        if (trigger && !isSubmenuTrigger(trigger)) {
+          const menu = menuFor(trigger);
+          if (event.key === 'ArrowDown' || event.key === 'Home') {
+            event.preventDefault();
+            openAndEnter(trigger, false);
+            return;
+          }
+          if (event.key === 'ArrowUp' || event.key === 'End') {
+            event.preventDefault();
+            openAndEnter(trigger, true);
+            return;
+          }
+          if (isMenubarTrigger(trigger) && (event.key === 'ArrowRight' || event.key === 'ArrowLeft')) {
+            event.preventDefault();
+            switchMenubarTrigger(trigger, event.key === 'ArrowRight' ? 1 : -1);
+            return;
+          }
+          if (event.key === 'Escape' && isOpen(menu)) {
+            event.preventDefault();
+            event.stopPropagation();
+            closeAndRestore(menu, { fromPointer: false });
+            return;
+          }
+          return;
+        }
+
+        // Keydown inside an open menu ([focusgroup~="menu"])
+        const currentMenu = target.closest('[popover]');
+        if (!currentMenu) return;
+        const group = target.closest('[focusgroup~="menu"]');
+        const isNestedSubmenu = Boolean(currentMenu.parentElement.closest('[popover]'));
+        const rootMenu = rootMenuFor(currentMenu);
+        const rootTrigger = triggerFor(rootMenu);
+
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(currentMenu, { fromPointer: false });
+          return;
+        }
+
+        if (event.key === 'ArrowLeft') {
+          event.preventDefault();
+          event.stopPropagation();
+          if (isNestedSubmenu) {
+            closeAndRestore(currentMenu, { fromPointer: false });
+          } else if (rootTrigger && isMenubarTrigger(rootTrigger)) {
+            switchMenubarTrigger(rootTrigger, -1);
+          }
+          return;
+        }
+
+        if (event.key === 'ArrowRight') {
+          event.preventDefault();
+          event.stopPropagation();
+          if (trigger && isSubmenuTrigger(trigger)) {
+            openAndEnter(trigger, false);
+          } else if (rootTrigger && isMenubarTrigger(rootTrigger)) {
+            switchMenubarTrigger(rootTrigger, 1);
+          }
+          return;
+        }
+
+        if ((event.key === 'Home' || event.key === 'End') && group) {
+          event.preventDefault();
+          const items = ownItems(group);
+          const dest = event.key === 'Home' ? items[0] : items[items.length - 1];
+          if (dest) dest.focus({ preventScroll: true });
+          return;
+        }
+
+        // Typeahead on printable character (do not intercept Space)
+        if (group && event.key.length === 1 && event.key !== ' ' && !event.ctrlKey && !event.metaKey && !event.altKey) {
+          const char = event.key.toLowerCase();
+          const items = ownItems(group);
+          const currentIdx = items.indexOf(document.activeElement);
+          const ordered = [...items.slice(currentIdx + 1), ...items.slice(0, currentIdx + 1)];
+          const match = ordered.find(item => item.textContent.trim().toLowerCase().startsWith(char));
+          if (match) {
+            event.preventDefault();
+            match.focus({ preventScroll: true });
+          }
+        }
+      });
+    })();
+  </script>
 </body>
 
 </html>
