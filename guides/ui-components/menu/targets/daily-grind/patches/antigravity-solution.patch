+              closeAndRestore(rootMenu, { fromPointer });
+            }
+          }, 300);
+          return;
+        }
+
+        // Standard command activation
+        const card = rootMenu.closest('.card');
+        if (card) {
+          const summary = card.querySelector('.card-meta');
+          if (summary && !label.startsWith('Add ')) {
+            const parts = summary.textContent.split('•');
+            summary.textContent = `${(parts[0] || 'Medium').trim()} • ${label}`;
+          }
+        }
+        announce(`Action selected: ${label}`);
+        closeAndRestore(rootMenu, { fromPointer });
+      });
+
+      // Keyboard navigation across triggers, menus, and submenus
+      document.addEventListener('keydown', event => {
+        const active = document.activeElement;
+        if (!active) return;
+
+        // Tab leaves the menu system and closes every open menu
+        if (event.key === 'Tab') {
+          const openMenus = [...document.querySelectorAll('[popover]:popover-open')];
+          if (openMenus.length > 0) {
+            const rootMenu = rootMenuFor(active) || openMenus.find(m => !m.parentElement?.closest('[popover]')) || openMenus[0];
+            const rootTrigger = triggerFor(rootMenu);
+            suppressPreview = true;
+            try {
+              if (rootTrigger && active !== rootTrigger && rootMenu.contains(active)) {
+                rootTrigger.focus({ focusVisible: false });
+              }
+              openMenus.forEach(m => {
+                if (isOpen(m)) m.hidePopover();
+              });
+            } finally {
+              suppressPreview = false;
+            }
+          }
+          return;
+        }
+
+        // Space on menuitemcheckbox toggles and stays open (APG)
+        if (
+          event.key === ' ' &&
+          active.matches('[focusgroup~="menu"] button[role="menuitemcheckbox"]')
+        ) {
+          event.preventDefault();
+          const checked = active.getAttribute('aria-checked') !== 'true';
+          active.setAttribute('aria-checked', String(checked));
+          const label = active.childNodes[0]?.textContent?.trim() || active.textContent.trim();
+          announce(`${label}: ${checked ? 'Enabled' : 'Disabled'}`);
+          return;
+        }
+
+        // 1. Keydown on a Top-Level Trigger
+        if (active.matches('button[commandfor]') && isTopLevel(active)) {
+          const menu = menuFor(active);
+          const bar = menubarFor(active);
+
+          if ((event.key === 'ArrowLeft' || event.key === 'ArrowRight') && bar) {
+            event.preventDefault();
+            const barTriggers = triggers.filter(t => menubarFor(t) === bar && isTopLevel(t));
+            const idx = barTriggers.indexOf(active);
+            if (idx < 0) return;
+            const nextIdx = (idx + (event.key === 'ArrowLeft' ? -1 : 1) + barTriggers.length) % barTriggers.length;
+            const nextTrigger = barTriggers[nextIdx];
+            if (isOpen(menu)) menu.hidePopover();
+            setMenubarTabStop(bar, nextTrigger);
+            nextTrigger.focus();
+            return;
+          }
+
+          if (event.key === 'ArrowDown' || event.key === 'Home') {
+            event.preventDefault();
+            if (isOpen(menu)) {
+              ownItems(menu)[0]?.focus();
+            } else if (menu) {
+              enterDirection.set(menu, 'first');
+              enterOnOpen.add(menu);
+              active.click();
+            }
+            return;
+          }
+
+          if (event.key === 'ArrowUp' || event.key === 'End') {
+            event.preventDefault();
+            if (isOpen(menu)) {
+              const items = ownItems(menu);
+              items[items.length - 1]?.focus();
+            } else if (menu) {
+              enterDirection.set(menu, 'last');
+              enterOnOpen.add(menu);
+              active.click();
+            }
+            return;
+          }
+
+          if (event.key === 'Escape' && isOpen(menu)) {
+            event.preventDefault();
+            event.stopPropagation();
+            closeAndRestore(menu);
+            return;
+          }
+          return;
+        }
+
+        // 2. Keydown inside a Menu ([focusgroup~="menu"])
+        const currentMenu = active.closest('[popover]');
+        if (!currentMenu) return;
+
+        const isSubmenu = Boolean(currentMenu.parentElement?.closest('[popover]'));
+
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(currentMenu);
+          return;
+        }
+
+        if (event.key === 'Home' || event.key === 'End') {
+          event.preventDefault();
+          const items = ownItems(currentMenu);
+          if (items.length) {
+            items[event.key === 'Home' ? 0 : items.length - 1].focus();
+          }
+          return;
+        }
+
+        if (event.key === 'ArrowRight') {
+          event.preventDefault();
+          event.stopPropagation();
+          // On a submenu trigger: open the submenu and focus its first item
+          if (active.hasAttribute('commandfor')) {
+            const subMenu = menuFor(active);
+            if (isOpen(subMenu)) {
+              ownItems(subMenu)[0]?.focus();
+            } else if (subMenu) {
+              enterDirection.set(subMenu, 'first');
+              enterOnOpen.add(subMenu);
+              active.click();
+            }
+            return;
+          }
+          // On an item without a child submenu: close hierarchy and preview next top-level menu in menubar
+          const rootMenu = rootMenuFor(currentMenu);
+          const rootTrigger = triggerFor(rootMenu);
+          const bar = menubarFor(rootTrigger);
+          if (bar && rootTrigger) {
+            const barTriggers = triggers.filter(t => menubarFor(t) === bar && isTopLevel(t));
+            const idx = barTriggers.indexOf(rootTrigger);
+            if (idx >= 0) {
+              const nextTrigger = barTriggers[(idx + 1) % barTriggers.length];
+              rootMenu.hidePopover();
+              setMenubarTabStop(bar, nextTrigger);
+              nextTrigger.focus();
+            }
+          }
+          return;
+        }
+
+        if (event.key === 'ArrowLeft') {
+          event.preventDefault();
+          event.stopPropagation();
+          if (isSubmenu) {
+            closeAndRestore(currentMenu);
+            return;
+          }
+          const rootTrigger = triggerFor(currentMenu);
+          const bar = menubarFor(rootTrigger);
+          if (bar && rootTrigger) {
+            const barTriggers = triggers.filter(t => menubarFor(t) === bar && isTopLevel(t));
+            const idx = barTriggers.indexOf(rootTrigger);
+            if (idx >= 0) {
+              const prevTrigger = barTriggers[(idx - 1 + barTriggers.length) % barTriggers.length];
+              currentMenu.hidePopover();
+              setMenubarTabStop(bar, prevTrigger);
+              prevTrigger.focus();
+            }
+          }
+          return;
+        }
+
+        // Typeahead on printable characters (excluding Space)
+        if (event.key.length === 1 && event.key !== ' ' && !event.ctrlKey && !event.metaKey && !event.altKey) {
+          const items = ownItems(currentMenu);
+          const currentIdx = items.indexOf(active);
+          const char = event.key.toLowerCase();
+          const ordered = currentIdx >= 0
+            ? [...items.slice(currentIdx + 1), ...items.slice(0, currentIdx + 1)]
+            : items;
+          const match = ordered.find(item => item.textContent.trim().toLowerCase().startsWith(char));
+          if (match) {
+            event.preventDefault();
+            match.focus();
+          }
+        }
+      }, true);
+    })();
+  </script>
 </body>
 
 </html>
