+    const target = event.target;
+    states.filter(state => !state.parent && isOpen(state)).forEach(state => {
+      if (target !== state.trigger && !state.menu.contains(target)) hide(state);
+    });
+  });
+  document.addEventListener('pointerdown', event => {
+    pointerTrigger = null;
+    if (nativePopover || !(event.target instanceof Node)) return;
+    const target = event.target;
+    states.filter(state => !state.parent && isOpen(state)).forEach(state => {
+      if (!state.menu.contains(target) && !state.trigger.contains(target)) hide(state);
+    });
+  }, true);
+  window.addEventListener('resize', () => states.forEach(position));
+  document.addEventListener('scroll', () => states.forEach(position), true);
