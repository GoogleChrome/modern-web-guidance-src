index 0000000..5439d7f
--- /dev/null
+++ b/menu.js
@@ -0,0 +1,197 @@
+// Each card owns its options; selecting an option never changes another drink.
+document.querySelectorAll('.order-menu').forEach((host, index) => {
+  const prefix = `order-${index}`;
+  const drink = host.dataset.drink;
+  const trigger = (id, label, className = '') => `<button id="${id}-trigger" class="${className}" type="button" aria-haspopup="menu" aria-expanded="false" commandfor="${id}" command="toggle-popover">${label}<span class="hint" aria-hidden="true"> ▸</span></button>`;
+  const menu = (id, content) => `<div id="${id}" class="popup" popover="auto"><div focusgroup="menu nomemory" aria-labelledby="${id}-trigger">${content}</div></div>`;
+  const radios = (name, options, selected) => `<div role="group" aria-label="${name}">${options.map(option => `<button type="button" role="menuitemradio" aria-checked="${option === selected}" data-option="${name}">${option}</button>`).join('')}</div>`;
+  host.innerHTML = trigger(prefix, 'Customize & order', 'btn order-trigger') + menu(prefix,
+    '<button type="button" data-add>Add to order</button><hr>' +
+    trigger(`${prefix}-custom`, 'Customize drink') + menu(`${prefix}-custom`,
+      '<button type="button" role="menuitemcheckbox" aria-checked="false" data-option="Extra shot">Extra shot</button>' +
+      trigger(`${prefix}-size`, 'Size') + menu(`${prefix}-size`, radios('Size', ['Small', 'Medium', 'Large'], 'Medium')) +
+      trigger(`${prefix}-milk`, 'Milk') + menu(`${prefix}-milk`, radios('Milk', ['No milk', 'Oat milk', 'Whole milk'], host.dataset.milk))));
+  host.querySelector('.order-trigger').setAttribute('aria-label', `Customize and order ${drink}`);
+});
+
+async function initializeMenus() {
+  if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+    await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+  }
+  const nativeGroup = 'focusGroup' in HTMLElement.prototype;
+  const nativeCommand = 'commandForElement' in HTMLButtonElement.prototype;
+  const anchored = CSS.supports('position-area', 'block-end');
+  const triggers = [...document.querySelectorAll('button[commandfor]')];
+  const menus = [...document.querySelectorAll('.popup')];
+  const enterOnOpen = new WeakSet();
+  const suppressPreview = new WeakSet();
+  const pendingClose = new WeakMap();
+  let pointerTrigger = null;
+  let windowBlurred = false;
+  const menuFor = trigger => document.getElementById(trigger.getAttribute('commandfor'));
+  const triggerFor = menu => triggers.find(trigger => menuFor(trigger) === menu);
+  const nativePopover = CSS.supports('selector(:popover-open)');
+  const isOpen = menu => menu.classList.contains(':popover-open') || (nativePopover && menu.matches(':popover-open'));
+  const items = group => [...group.querySelectorAll('button, a[href]')].filter(item => item.closest('[focusgroup]') === group && !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+  const focus = (item, pointer = false) => item?.focus({ preventScroll: true, focusVisible: !pointer });
+  const enter = menu => focus(items(menu.firstElementChild)[0]);
+  const close = (menu, pointer = false) => {
+    const trigger = triggerFor(menu);
+    suppressPreview.add(trigger);
+    focus(trigger, pointer);
+    if (isOpen(menu)) menu.hidePopover();
+    setTimeout(() => suppressPreview.delete(trigger), 0);
+  };
+  const root = menu => { while (menu.parentElement.closest('.popup')) menu = menu.parentElement.closest('.popup'); return menu; };
+  function position(menu) {
+    if (anchored || !isOpen(menu)) return;
+    const trigger = triggerFor(menu).getBoundingClientRect();
+    const nested = !!menu.parentElement.closest('.popup');
+    const box = menu.getBoundingClientRect();
+    let x = nested ? trigger.right : trigger.left;
+    let y = nested ? trigger.top : trigger.bottom;
+    if (x + box.width > innerWidth - 8) x = nested ? trigger.left - box.width : trigger.right - box.width;
+    if (nested && x < 8) { x = trigger.left + 16; y = trigger.bottom; menu.style.width = `${Math.min(240, innerWidth - x - 8)}px`; }
+    else if (y + box.height > innerHeight - 8) y = nested ? innerHeight - box.height - 8 : trigger.top - box.height;
+    menu.style.setProperty('--menu-left', `${Math.max(8, Math.min(x, innerWidth - menu.getBoundingClientRect().width - 8))}px`);
+    menu.style.setProperty('--menu-top', `${Math.max(8, y)}px`);
+  }
+  if (anchored && !('source' in ToggleEvent.prototype)) triggers.forEach((trigger, index) => {
+    trigger.style.anchorName = `--menu-${index}`;
+    menuFor(trigger).style.positionAnchor = `--menu-${index}`;
+  });
+  window.addEventListener('blur', () => { windowBlurred = true; });
+  window.addEventListener('focus', () => setTimeout(() => { windowBlurred = false; }, 0));
+  triggers.forEach(trigger => {
+    const menu = menuFor(trigger);
+    trigger.addEventListener('pointerdown', event => { event.preventDefault(); pointerTrigger = trigger; });
+    trigger.addEventListener('click', event => {
+      clearTimeout(pendingClose.get(root(menu)));
+      if (pointerTrigger !== trigger && event.detail === 0 && !isOpen(menu)) enterOnOpen.add(menu);
+      if (!nativeCommand) {
+        event.preventDefault();
+        if (isOpen(menu)) close(menu, pointerTrigger === trigger);
+        else menu.showPopover({ source: trigger });
+      }
+      pointerTrigger = null;
+    });
+    trigger.addEventListener('keydown', event => {
+      if (event.key !== 'ArrowDown' && !(event.key === 'ArrowRight' && trigger.closest('[focusgroup]'))) return;
+      event.preventDefault(); event.stopPropagation();
+      if (isOpen(menu)) enter(menu);
+      else { enterOnOpen.add(menu); trigger.click(); }
+    });
+    if (trigger.closest('[focusgroup]')) {
+      trigger.addEventListener('focus', event => {
+        if (windowBlurred || suppressPreview.has(trigger) || menu.contains(event.relatedTarget)) return;
+        if (!isOpen(menu)) menu.showPopover({ source: trigger });
+      });
+      trigger.addEventListener('blur', event => {
+        if (!menu.contains(event.relatedTarget) && isOpen(menu)) menu.hidePopover();
+      });
+      trigger.addEventListener('pointerleave', event => startBridge(menu, event));
+    }
+  });
+  document.addEventListener('pointerup', () => setTimeout(() => { pointerTrigger = null; }, 0));
+  menus.forEach(menu => {
+    menu.addEventListener('toggle', event => {
+      if (event.target !== menu) return;
+      const opened = isOpen(menu);
+      triggerFor(menu).setAttribute('aria-expanded', String(opened));
+      if (opened) {
+        position(menu);
+        if (enterOnOpen.has(menu)) { enterOnOpen.delete(menu); enter(menu); }
+        else if (!menu.parentElement.closest('.popup')) focus(triggerFor(menu), true);
+      } else {
+        menu.removeAttribute('data-bridge');
+        clearTimeout(pendingClose.get(menu));
+        if (menu.contains(document.activeElement)) focus(triggerFor(menu));
+      }
+    });
+    const group = menu.firstElementChild;
+    if (!nativeGroup) {
+      group.setAttribute('role', 'menu');
+      items(group).forEach(item => { if (!item.hasAttribute('role')) item.setAttribute('role', 'menuitem'); item.tabIndex = -1; });
+    }
+    group.addEventListener('keydown', event => {
+      if (event.target.closest('[focusgroup]') !== group) return;
+      const own = items(group);
+      if ((!nativeGroup && ['ArrowDown', 'ArrowUp'].includes(event.key)) || ['Home', 'End'].includes(event.key)) {
+        const current = own.indexOf(document.activeElement);
+        const next = event.key === 'Home' ? 0 : event.key === 'End' ? own.length - 1 : (current + (event.key === 'ArrowUp' ? -1 : 1) + own.length) % own.length;
+        event.preventDefault(); event.stopPropagation(); focus(own[next]);
+      } else if (event.key === 'Escape' || (event.key === 'ArrowLeft' && menu.parentElement.closest('.popup'))) {
+        event.preventDefault(); event.stopPropagation(); close(menu);
+      } else if (event.key === 'Tab') {
+        // Restore to the root trigger before the browser performs normal Tab navigation.
+        close(root(menu));
+      } else if (event.key === ' ' && event.target.getAttribute('role') === 'menuitemcheckbox') {
+        event.preventDefault(); event.stopPropagation(); activate(event.target, false, true);
+      }
+    });
+    let hoverTimer;
+    group.addEventListener('pointermove', event => {
+      const item = event.target.closest('button, a[href]');
+      if (!item || item.closest('[focusgroup]') !== group || item.contains(document.activeElement)) return;
+      if (!item.contains(document.elementFromPoint(event.clientX, event.clientY))) return;
+      clearTimeout(hoverTimer);
+      if (item.hasAttribute('commandfor')) hoverTimer = setTimeout(() => focus(item, true), 100);
+      else focus(item, true);
+    });
+    group.addEventListener('pointerleave', () => clearTimeout(hoverTimer));
+    group.addEventListener('click', event => {
+      const item = event.target.closest('button, a[href]');
+      if (!item || item.closest('[focusgroup]') !== group || item.hasAttribute('commandfor')) return;
+      activate(item, event.detail > 0);
+    });
+  });
+  function activate(item, pointer, stay = false) {
+    const host = item.closest('.order-menu');
+    const role = item.getAttribute('role');
+    const checkable = role === 'menuitemcheckbox' || role === 'menuitemradio';
+    if (role === 'menuitemcheckbox') item.setAttribute('aria-checked', String(item.getAttribute('aria-checked') !== 'true'));
+    if (role === 'menuitemradio') [...item.parentElement.children].forEach(sibling => sibling.setAttribute('aria-checked', String(sibling === item)));
+    const status = document.getElementById('order-status');
+    if (host) {
+      const choices = [...host.querySelectorAll('[aria-checked="true"]')].map(option => option.textContent.trim());
+      status.textContent = `${host.dataset.drink}: ${choices.join(', ')}${item.hasAttribute('data-add') ? ' — added to your order.' : ' — preferences updated.'}`;
+    } else if (item.tagName === 'BUTTON') status.textContent = `${item.textContent.trim()} selected.`;
+    const menu = root(item.closest('.popup'));
+    clearTimeout(pendingClose.get(menu));
+    if (!stay) {
+      if (checkable) pendingClose.set(menu, setTimeout(() => close(menu, pointer), 300));
+      else close(menu, pointer);
+    }
+  }
+  document.addEventListener('focusin', event => {
+    if (event.target.closest('.popup') || (triggers.includes(event.target) && isOpen(menuFor(event.target)))) return;
+    menus.filter(isOpen).reverse().forEach(menu => menu.hidePopover());
+  });
+  const reposition = () => menus.filter(isOpen).forEach(position);
+  window.addEventListener('resize', reposition);
+  window.addEventListener('scroll', reposition, true);
+  function startBridge(menu, event) {
+    if (!matchMedia('(hover: hover)').matches || !isOpen(menu)) return;
+    const rect = menu.getBoundingClientRect();
+    const left = event.clientX < rect.left;
+    if (!left && event.clientX <= rect.right) return;
+    menu.style.setProperty('--pointer-x', `${event.clientX - rect.left}px`);
+    menu.style.setProperty('--pointer-y', `${event.clientY - rect.top}px`);
+    menu.dataset.bridge = '';
+    let lastX = event.clientX;
+    let timer;
+    const stop = () => { clearTimeout(timer); menu.removeAttribute('data-bridge'); menu.removeEventListener('pointermove', extend); menu.removeEventListener('toggle', stop); };
+    const extend = event => {
+      if (event.target !== menu || (left ? event.clientX < lastX : event.clientX > lastX)) { stop(); return; }
+      lastX = event.clientX;
+      clearTimeout(timer); timer = setTimeout(stop, 300);
+    };
+    timer = setTimeout(stop, 300);
+    menu.addEventListener('pointermove', extend);
+    menu.addEventListener('toggle', stop);
+  }
+}
+initializeMenus().catch(error => {
+  console.error('Unable to initialize menus', error);
+  document.getElementById('order-status').textContent = 'Menus could not load. Please use View Details to browse drinks.';
+});
