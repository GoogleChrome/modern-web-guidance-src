diff --git a/menus.css b/menus.css
new file mode 100644
index 0000000..f61aa79
--- /dev/null
+++ b/menus.css
@@ -0,0 +1,89 @@
+button { font: inherit; cursor: pointer; }
+.menu-trigger { border: 1px solid currentColor; border-radius: 5px; }
+nav .menu-trigger { background: transparent; color: white; padding: 4px 12px; font-size: .9rem; }
+.menu-trigger::after { content: ' ▾'; }
+.menu-trigger[aria-expanded="true"] { background: var(--accent); color: var(--text); }
+.menu-trigger:focus-visible, .popup-menu a:focus-visible, .popup-menu button:focus-visible {
+  outline: 3px solid var(--accent); outline-offset: 2px;
+}
+.popup-menu {
+  position: fixed;
+  inset: auto;
+  margin: 0;
+  padding: 6px;
+  width: 252px;
+  min-inline-size: 0;
+  max-inline-size: calc(100vw - 16px);
+  max-block-size: calc(100dvh - 24px);
+  overflow: auto;
+  border: 1px solid var(--secondary);
+  border-radius: 8px;
+  background: white;
+  color: var(--text);
+  box-shadow: 0 8px 28px #3e27232b;
+  text-align: start;
+  z-index: 1100;
+}
+.popup-menu .popup-menu { overflow: visible; }
+.popup-menu [focusgroup] { --menu-icon-size: 1.25rem; }
+.popup-menu [focusgroup] > button,
+.popup-menu [focusgroup] > a,
+.popup-menu [role="group"] > button {
+  display: flex; align-items: center; gap: .5rem;
+  width: 100%; padding: 9px 8px; border: 0; border-radius: 4px;
+  background: transparent; color: var(--text); text-decoration: none;
+  font-size: .9rem; line-height: 1.4; text-align: start;
+}
+.popup-menu button::before, .popup-menu a::before {
+  content: ''; flex: none; inline-size: var(--menu-icon-size);
+}
+.popup-menu button[aria-checked="true"]::before { content: '✓'; }
+.popup-menu button:focus, .popup-menu a:focus,
+.popup-menu button[aria-expanded="true"] { background: #f3ece6; }
+@media (hover: hover) {
+  .popup-menu button:hover, .popup-menu a:hover { background: #f3ece6; }
+}
+.popup-menu .hint { margin-inline-start: auto; }
+.popup-menu hr { border: 0; border-top: 1px solid var(--secondary); margin: 5px 8px; }
+.popup-menu [data-bridge]::before {
+  content: ''; position: absolute; inset: -100vh -100vw;
+  clip-path: polygon(
+    calc(100vw + var(--bridge-x)) calc(100vh + var(--bridge-y)),
+    calc(100vw + var(--bridge-edge)) 100vh,
+    calc(100vw + var(--bridge-edge)) calc(100vh + var(--bridge-height))
+  );
+}
+.order-status { margin: 0 auto; max-width: 1100px; padding: 0 20px; text-align: center; }
+.order-status:empty { display: none; }
+.customization-summary { margin-top: 12px; font-size: .85rem; }
+@supports (position-area: block-end) {
+  .popup-menu { position-area: block-end span-inline-end; position-try-fallbacks: flip-inline, flip-block; }
+  .popup-menu .popup-menu {
+    position-area: inline-end span-block-end;
+    position-try-fallbacks: flip-inline, flip-block, --below;
+  }
+  @position-try --below {
+    position-area: block-end span-inline-end;
+    margin-inline-start: 1rem;
+    min-inline-size: 0;
+    max-inline-size: calc(100% - 1rem);
+  }
+}
+@supports not (position-area: block-end) {
+  .popup-menu { left: var(--menu-left); top: var(--menu-top); }
+}
+/* Used only when the browser has no Popover API. */
+.popup-menu[data-fallback]:not([data-open]) { display: none; }
+@media (prefers-reduced-motion: no-preference) {
+  .popup-menu { opacity: 0; translate: 0 -4px;
+    transition: opacity .1s, translate .1s, display .1s allow-discrete, overlay .1s allow-discrete; }
+  .popup-menu:popover-open, .popup-menu[data-open] { opacity: 1; translate: 0;
+    @starting-style { opacity: 0; translate: 0 -4px; }
+  }
+}
+@media (max-width: 600px) {
+  nav { flex-wrap: wrap; gap: 12px; }
+  nav ul { flex-wrap: wrap; align-items: center; gap: 12px; }
+  nav ul li { margin-left: 0; }
+  .hero h1 { font-size: 2.3rem; }
+}
