index 0000000..c2bd748
--- /dev/null
+++ b/menus.js
@@ -0,0 +1,404 @@
+// @ts-check
+/** @typedef {{label: string, href?: string, children?: Entry[], action?: () => string, role?: 'menuitemcheckbox' | 'menuitemradio', checked?: boolean, group?: string}} Entry */
+/** @typedef {{trigger: HTMLButtonElement, menu: HTMLDivElement, group: HTMLDivElement, parent: MenuState | null, enter: 'first' | 'last' | null, pointerOpen: boolean, timer?: ReturnType<typeof setTimeout>, bridge?: () => void}} MenuState */
+(() => {
+  const nativePopover = 'showPopover' in HTMLElement.prototype;
+  const nativeInvoker = 'commandForElement' in HTMLButtonElement.prototype;
+  const nativeFocus = 'focusGroup' in HTMLElement.prototype;
+  const anchored = CSS.supports('position-area: block-end');
+  const canHover = matchMedia('(hover: hover)');
+  /** @type {MenuState[]} */
+  const states = [];
+  /** @type {HTMLButtonElement | null} */
+  let pointerTrigger = null;
+  let serial = 0;
+  const status = document.getElementById('order-status');
+  /** @param {string} message */
+  function announce(message) {
+    if (status) status.textContent = message;
+  }
+  /** @param {MenuState} state */
+  function isOpen(state) {
+    return nativePopover ? state.menu.matches(':popover-open') : state.menu.hasAttribute('data-open');
+  }
+  /** @param {HTMLElement} element @param {boolean} [pointer] */
+  function focus(element, pointer = false) {
+    // focusVisible is progressively enhanced; unknown dictionary members are ignored.
+    element.focus(/** @type {FocusOptions} */ ({ preventScroll: true, focusVisible: !pointer }));
+  }
+  /** @param {MenuState} state */
+  function items(state) {
+    return Array.from(state.group.querySelectorAll('button, a')).filter(
+      /** @returns {item is HTMLButtonElement | HTMLAnchorElement} */
+      item => (item instanceof HTMLButtonElement || item instanceof HTMLAnchorElement)
+        && item.closest('[focusgroup]') === state.group
+        && !(item instanceof HTMLButtonElement && item.disabled)
+        && item.getAttribute('aria-disabled') !== 'true'
+    );
+  }
+  /** @param {MenuState} state */
+  function root(state) {
+    while (state.parent) state = state.parent;
+    return state;
+  }
+  /** @param {MenuState} state */
+  function position(state) {
+    if (anchored || !isOpen(state)) return;
+    const rect = state.trigger.getBoundingClientRect();
+    const width = state.menu.offsetWidth;
+    const height = state.menu.offsetHeight;
+    const viewportWidth = document.documentElement.clientWidth;
+    const viewportHeight = window.innerHeight;
+    let left = rect.left;
+    let top = rect.bottom;
+    if (state.parent) {
+      left = rect.right;
+      top = rect.top;
+      if (left + width > viewportWidth - 8) left = rect.left - width;
+      if (left < 8) {
+        left = Math.min(rect.left + 16, viewportWidth - width - 8);
+        top = rect.bottom;
+      }
+    } else if (top + height > viewportHeight - 8 && rect.top >= height + 8) {
+      top = rect.top - height;
+    }
+    state.menu.style.setProperty('--menu-left', `${Math.max(8, Math.min(left, viewportWidth - width - 8))}px`);
+    state.menu.style.setProperty('--menu-top', `${Math.max(8, Math.min(top, viewportHeight - height - 8))}px`);
+    state.menu.style.maxHeight = `${Math.max(80, viewportHeight - Math.max(8, top) - 8)}px`;
+  }
+  /** @param {MenuState} state */
+  function sync(state) {
+    const open = isOpen(state);
+    state.trigger.setAttribute('aria-expanded', String(open));
+    if (open) {
+      position(state);
+      if (state.enter) {
+        const list = items(state);
+        const item = state.enter === 'last' ? list.at(-1) : list[0];
+        state.enter = null;
+        if (item) focus(item);
+      } else if (state.pointerOpen) {
+        focus(state.trigger, true);
+      }
+      state.pointerOpen = false;
+    } else {
+      state.enter = null;
+      clearTimeout(state.timer);
+      state.bridge?.();
+      states.filter(child => child.parent === state).forEach(hide);
+    }
+  }
+  /** @param {MenuState} state */
+  function hide(state) {
+    clearTimeout(state.timer);
+    state.bridge?.();
+    states.filter(child => child.parent === state).forEach(hide);
+    if (!isOpen(state)) return;
+    if (nativePopover) state.menu.hidePopover();
+    else {
+      state.menu.removeAttribute('data-open');
+      state.menu.dispatchEvent(new Event('toggle'));
+    }
+  }
+  /** @param {MenuState} state */
+  function show(state) {
+    if (state.parent && !isOpen(state.parent)) return;
+    if (isOpen(state)) return;
+    states.filter(other => other !== state && other.parent === state.parent).forEach(hide);
+    if (nativePopover) {
+      const popover = /** @type {{showPopover: (options?: {source: HTMLElement}) => void}} */ (state.menu);
+      popover.showPopover({ source: state.trigger });
+    } else {
+      state.menu.dataset.open = '';
+      state.menu.dispatchEvent(new Event('toggle'));
+    }
+  }
+  /** @param {MenuState} state @param {boolean} [pointer] */
+  function closeAndRestore(state, pointer = false) {
+    focus(state.trigger, pointer);
+    hide(state);
+  }
+  /** @param {MenuState} state @param {'first' | 'last'} [edge] */
+  function enter(state, edge = 'first') {
+    clearTimeout(state.timer);
+    if (isOpen(state)) {
+      const list = items(state);
+      const item = edge === 'last' ? list.at(-1) : list[0];
+      if (item) focus(item);
+    } else {
+      state.enter = edge;
+      state.trigger.click();
+    }
+  }
+  /** @param {MenuState} state @param {PointerEvent} event */
+  function startBridge(state, event) {
+    state.bridge?.();
+    if (!canHover.matches || !isOpen(state)) return;
+    const rect = state.menu.getBoundingClientRect();
+    if (event.clientX >= rect.left && event.clientX <= rect.right) return;
+    const style = state.menu.style;
+    style.setProperty('--bridge-edge', `${event.clientX < rect.left ? 0 : rect.width}px`);
+    style.setProperty('--bridge-height', `${rect.height}px`);
+    /** @param {PointerEvent} pointer */
+    const update = pointer => {
+      if (pointer.target instanceof Node && pointer.target !== state.menu && state.menu.contains(pointer.target)) {
+        stop();
+        return;
+      }
+      style.setProperty('--bridge-x', `${pointer.clientX - rect.left}px`);
+      style.setProperty('--bridge-y', `${pointer.clientY - rect.top}px`);
+    };
+    const timer = setTimeout(() => stop(), 300);
+    const stop = () => {
+      clearTimeout(timer);
+      document.removeEventListener('pointermove', update);
+      state.menu.removeAttribute('data-bridge');
+      state.bridge = undefined;
+    };
+    update(event);
+    state.menu.dataset.bridge = '';
+    document.addEventListener('pointermove', update);
+    state.bridge = stop;
+  }
+  /** @param {string} label @param {Entry[]} entries @param {MenuState | null} parent @param {string} [accessibleLabel] @returns {MenuState} */
+  function createMenu(label, entries, parent, accessibleLabel = label) {
+    const id = `coffee-menu-${++serial}`;
+    const trigger = document.createElement('button');
+    trigger.type = 'button';
+    trigger.id = `${id}-trigger`;
+    trigger.textContent = label;
+    trigger.setAttribute('aria-label', accessibleLabel);
+    trigger.setAttribute('aria-haspopup', 'menu');
+    trigger.setAttribute('aria-expanded', 'false');
+    trigger.setAttribute('commandfor', id);
+    trigger.setAttribute('command', 'toggle-popover');
+    if (parent && !nativeFocus) trigger.setAttribute('role', 'menuitem');
+    if (!parent) trigger.className = 'menu-trigger';
+    else {
+      const hint = document.createElement('span');
+      hint.className = 'hint';
+      hint.setAttribute('aria-hidden', 'true');
+      hint.textContent = '›';
+      trigger.append(hint);
+    }
+    const menu = document.createElement('div');
+    menu.id = id;
+    menu.className = 'popup-menu';
+    menu.setAttribute('popover', 'auto');
+    if (!nativePopover) menu.dataset.fallback = '';
+    const group = document.createElement('div');
+    group.setAttribute('focusgroup', 'menu nomemory');
+    group.setAttribute('aria-labelledby', trigger.id);
+    menu.append(group);
+    /** @type {MenuState} */
+    const state = { trigger, menu, group, parent, enter: null, pointerOpen: false };
+    states.push(state);
+    // Older anchor implementations do not establish an implicit anchor from source.
+    if (anchored && (!nativeInvoker || !('ToggleEvent' in window) || !('source' in ToggleEvent.prototype))) {
+      trigger.style.setProperty('anchor-name', `--${id}`);
+      menu.style.setProperty('position-anchor', `--${id}`);
+    }
+    if (!nativeFocus) group.setAttribute('role', 'menu');
+    /** @type {Map<string, HTMLDivElement>} */
+    const radioGroups = new Map();
+    entries.forEach(entry => {
+      if (entry.children) {
+        const child = createMenu(entry.label, entry.children, state);
+        group.append(child.trigger, child.menu);
+        return;
+      }
+      const item = entry.href ? document.createElement('a') : document.createElement('button');
+      item.textContent = entry.label;
+      if (item instanceof HTMLAnchorElement) item.href = entry.href || '/menu';
+      else item.type = 'button';
+      if (entry.role) {
+        item.setAttribute('role', entry.role);
+        item.setAttribute('aria-checked', String(!!entry.checked));
+      } else if (!nativeFocus) item.setAttribute('role', 'menuitem');
+      let container = group;
+      if (entry.group) {
+        let wrapper = radioGroups.get(entry.group);
+        if (!wrapper) {
+          wrapper = document.createElement('div');
+          wrapper.setAttribute('role', 'group');
+          wrapper.setAttribute('aria-label', entry.group);
+          radioGroups.set(entry.group, wrapper);
+          group.append(wrapper);
+        }
+        container = wrapper;
+      }
+      container.append(item);
+      let stayOpen = false;
+      item.addEventListener('keydown', event => {
+        if (!(event instanceof KeyboardEvent)) return;
+        if (event.key === ' ' && entry.role === 'menuitemcheckbox') {
+          event.preventDefault();
+          stayOpen = true;
+          item.click();
+        }
+      });
+      item.addEventListener('click', event => {
+        if (!(event instanceof MouseEvent)) return;
+        const pointer = event.detail > 0;
+        if (entry.role === 'menuitemradio') {
+          container.querySelectorAll('[role="menuitemradio"]').forEach(radio => radio.setAttribute('aria-checked', String(radio === item)));
+        } else if (entry.role === 'menuitemcheckbox') {
+          item.setAttribute('aria-checked', String(item.getAttribute('aria-checked') !== 'true'));
+        }
+        const message = entry.action?.();
+        if (message) announce(message);
+        if (stayOpen) { stayOpen = false; return; }
+        const top = root(state);
+        clearTimeout(top.timer);
+        if (entry.role) top.timer = setTimeout(() => { if (isOpen(top)) closeAndRestore(top, pointer); }, 300);
+        else closeAndRestore(top, pointer);
+      });
+    });
+    if (!nativeFocus) {
+      items(state).forEach(item => { item.tabIndex = -1; });
+      group.addEventListener('keydown', event => {
+        if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
+        const list = items(state);
+        const index = list.findIndex(item => item === document.activeElement);
+        if (index < 0) return;
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        const next = event.key === 'Home' ? 0 : event.key === 'End' ? list.length - 1
+          : (index + (event.key === 'ArrowUp' ? -1 : 1) + list.length) % list.length;
+        focus(list[next]);
+      }, true);
+    }
+    trigger.addEventListener('pointerdown', event => {
+      if (event.button !== 0) return;
+      event.preventDefault();
+      pointerTrigger = trigger;
+    });
+    trigger.addEventListener('click', event => {
+      state.pointerOpen = pointerTrigger === trigger;
+      if (event.detail === 0 && !isOpen(state) && !state.enter) state.enter = 'first';
+      if (!nativeInvoker || !nativePopover) {
+        event.preventDefault();
+        if (isOpen(state)) closeAndRestore(state, pointerTrigger === trigger);
+        else show(state);
+      }
+      // Toggle events run after the native command default action.
+      setTimeout(() => { pointerTrigger = null; }, 0);
+    });
+    trigger.addEventListener('keydown', event => {
+      if ((!parent && ['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) || (parent && event.key === 'ArrowRight')) {
+        event.preventDefault();
+        event.stopPropagation();
+        enter(state, event.key === 'ArrowUp' || event.key === 'End' ? 'last' : 'first');
+      } else if (event.key === 'Escape' && isOpen(state)) {
+        event.preventDefault(); event.stopPropagation(); closeAndRestore(state);
+      }
+    });
+    trigger.addEventListener('pointerleave', event => { if (parent) startBridge(state, event); });
+    group.addEventListener('pointermove', event => {
+      if (!canHover.matches || !(event.target instanceof Element)) return;
+      const item = event.target.closest('button, a');
+      if (item instanceof HTMLElement && item.closest('[focusgroup]') === group && item !== document.activeElement) focus(item, true);
+    });
+    group.addEventListener('focusin', event => {
+      if (!(event.target instanceof HTMLElement) || event.target.closest('[focusgroup]') !== group) return;
+      states.filter(child => child.parent === state).forEach(child => {
+        clearTimeout(child.timer);
+        if (child.trigger !== event.target) hide(child);
+        else if (!isOpen(child) && pointerTrigger !== child.trigger) child.timer = setTimeout(() => {
+          if (isOpen(state) && document.activeElement === child.trigger) show(child);
+        }, 180);
+      });
+    });
+    group.addEventListener('keydown', event => {
+      if (!(event.target instanceof Element) || event.target.closest('[focusgroup]') !== group) return;
+      if (event.key === 'Escape' || (event.key === 'ArrowLeft' && parent)) {
+        event.preventDefault(); event.stopPropagation(); closeAndRestore(state);
+      } else if (event.key === 'Home' || event.key === 'End') {
+        event.preventDefault(); event.stopPropagation(); enter(state, event.key === 'Home' ? 'first' : 'last');
+      }
+    });
+    menu.addEventListener('toggle', () => sync(state));
+    return state;
+  }
+
+  const navigation = document.querySelector('[data-drink-menu]');
+  if (navigation) {
+    const state = createMenu('Menu', [
+      { label: 'Browse the full menu', href: '/menu' },
+      { label: 'Drinks', children: [
+        { label: 'Coffee', children: [
+          { label: 'Espresso drinks', href: '/menu/espresso' },
+          { label: 'Cold brew', href: '/menu/cold-brew' },
+          { label: 'Seasonal favorites', href: '/menu/seasonal' }
+        ] },
+        { label: 'Tea & more', children: [
+          { label: 'Hot tea', href: '/menu/tea' },
+          { label: 'Iced tea', href: '/menu/iced-tea' },
+          { label: 'Hot chocolate', href: '/menu/hot-chocolate' }
+        ] }
+      ] },
+      { label: 'Order online', href: '/order-online' }
+    ], null);
+    navigation.replaceChildren(state.trigger, state.menu);
+  }
+  document.querySelectorAll('.card').forEach(card => {
+    const link = card.querySelector('a');
+    const drink = card.querySelector('h3')?.textContent || 'Coffee';
+    if (!link) return;
+    const selection = { size: 'Regular', milk: drink === 'Maple Oat Latte' ? 'Oat milk' : 'No milk', extra: false };
+    const summary = document.createElement('p');
+    summary.className = 'customization-summary';
+    const describe = () => `${selection.size}, ${selection.milk.toLowerCase()}${selection.extra ? ', extra espresso shot' : ''}`;
+    const update = () => {
+      summary.textContent = describe();
+      return `${drink}: ${describe()}.`;
+    };
+    /** @param {'size' | 'milk'} key @param {string[]} labels @returns {Entry[]} */
+    const options = (key, labels) => labels.map(label => ({
+      label, role: 'menuitemradio', checked: selection[key] === label, group: key === 'size' ? 'Drink size' : 'Milk choice',
+      action: () => { selection[key] = label; return update(); }
+    }));
+    const state = createMenu('Order options', [
+      { label: 'Add to order', action: () => {
+        orderCount++;
+        return `Added ${drink} (${describe()}) to your order. ${orderCount} drink${orderCount === 1 ? '' : 's'} in your order.`;
+      } },
+      { label: 'Customize', children: [
+        { label: 'Size', children: options('size', ['Small', 'Regular', 'Large']) },
+        { label: 'Milk', children: options('milk', ['No milk', 'Whole milk', 'Oat milk', 'Almond milk']) },
+        { label: 'Extras', children: [{ label: 'Extra espresso shot', role: 'menuitemcheckbox', checked: false,
+          action: () => { selection.extra = !selection.extra; return update(); } }] }
+      ] },
+      { label: 'View drink details', href: link.getAttribute('href') || '/menu' }
+    ], null, `Order options for ${drink}`);
+    state.trigger.classList.add('btn');
+    link.replaceWith(state.trigger, state.menu, summary);
+    update();
+  });
+  let orderCount = 0;
+
+  // Tab exits through the root trigger so focus never remains in hidden content.
+  document.addEventListener('keydown', event => {
