+button { font: inherit; cursor: pointer; }
+.btn { border: 0; }
+.nav-trigger { color: white; background: transparent; border: 1px solid var(--secondary); border-radius: 4px; padding: 4px 12px; }
+.nav-trigger:hover, .nav-trigger[aria-expanded="true"] { color: var(--accent); background: #3e2723; }
+.order-trigger { margin-top: 10px; background: white; color: var(--primary); border: 1px solid var(--primary); }
+.order-trigger[aria-expanded="true"] { background: var(--secondary); }
+:is(button, a):focus-visible { outline: 3px solid #c76b00; outline-offset: 3px; }
+.popup { position: fixed; inset: auto; margin: 0; padding: 6px; width: 240px; min-inline-size: 0; max-inline-size: calc(100vw - 16px); max-block-size: calc(100dvh - 16px); overflow: auto; color: var(--text); background: white; border: 1px solid var(--secondary); border-radius: 8px; box-shadow: 0 6px 24px #27150f33; text-align: start; }
+[focusgroup~="menu"] { --menu-icon-size: 1.1rem; }
+[focusgroup~="menu"] > :is(button, a), [focusgroup~="menu"] > [role="group"] > button { display: flex; align-items: center; gap: 8px; width: 100%; padding: 9px 8px; border: 0; border-radius: 4px; color: var(--text); background: transparent; text-decoration: none; font: inherit; text-align: start; line-height: 1.4; }
+[focusgroup~="menu"] :is(button, a)::before { content: ""; flex: none; inline-size: var(--menu-icon-size); }
+[focusgroup~="menu"] button[aria-checked="true"]::before { content: "✓"; }
+[focusgroup~="menu"] > :is(button, a):hover, [focusgroup~="menu"] > :is(button, a):focus-visible, [role="group"] > button:hover, [role="group"] > button:focus-visible, [focusgroup~="menu"] > button[aria-expanded="true"] { background: #f0e8e3; }
+.hint { margin-inline-start: auto; }
+.popup hr { margin: 5px 0; border: 0; border-top: 1px solid var(--secondary); }
+[focusgroup~="menu"] > .popup { overflow: visible; }
+.order-status { max-width: 1060px; margin: 20px auto; padding-inline: 20px; }
+.order-status:empty { display: none; }
+@supports (position-area: block-end) {
+  .popup { position-area: block-end span-inline-end; position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline; }
+  [focusgroup~="menu"] > .popup { position-area: inline-end span-block-end; position-try-fallbacks: flip-inline, flip-block, --below; }
+  @position-try --below { position-area: block-end span-inline-end; margin-inline-start: 1rem; min-inline-size: 0; max-inline-size: calc(100% - 1rem); }
+}
+@supports not (position-area: block-end) {
+  .popup { left: var(--menu-left, 8px); top: var(--menu-top, 8px); }
+}
+[data-bridge]::before { content: ""; position: absolute; inset: -100vh -100vw; --bridge-slack: 5px; --bridge-side: sign(var(--pointer-x)); --bridge-edge: calc(50% + var(--bridge-side) * (50% - 100vw)); --bridge-apex: calc(100vw + var(--pointer-x) + var(--bridge-side) * var(--bridge-slack)); clip-path: polygon(var(--bridge-apex) calc(100vh + var(--pointer-y) - var(--bridge-slack)), var(--bridge-edge) 100vh, var(--bridge-edge) calc(100% - 100vh), var(--bridge-apex) calc(100vh + var(--pointer-y) + var(--bridge-slack))); }
+@supports not (width: calc(sign(1px) * 1px)) {
+  [data-bridge]::before { --bridge-edge: clamp(100vw, 50% + var(--pointer-x) * 1e6, 100% - 100vw); --bridge-apex: calc(100vw + var(--pointer-x) + clamp(-1 * var(--bridge-slack), var(--pointer-x) * 1e6, var(--bridge-slack))); }
+}
+@media (max-width: 650px) { nav { flex-wrap: wrap; gap: 12px; } nav ul { flex-wrap: wrap; align-items: center; gap: 12px; } nav ul li { margin-left: 0; } .hero h1 { font-size: 2.3rem; } }
