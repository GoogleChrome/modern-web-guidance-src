+    /* Progress Ring Component */
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    .progress-ring-wrapper,
+    .ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      margin: 30px auto;
+    }
+
+    progress.progress-ring {
+      --size: 150px;
+      --thickness: 16px;
+      --track-color: var(--secondary);
+      --fill-color: var(--accent);
+      --value: attr(value type(<number>));
+      appearance: none;
+      -webkit-appearance: none;
+      -moz-appearance: none;
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+
+      transition: --value 0s cubic-bezier(0.4, 0, 0.2, 1);
+
+      background: conic-gradient(
+        var(--fill-color) calc(var(--value) * 1%),
+        var(--track-color) 0
+      );
+
+      /* MANDATORY: Clip the background to the border-area. */
+      background-clip: border-area;
+      border: var(--thickness) solid transparent;
+      background-origin: border-box;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.4s;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      progress.progress-ring {
+        transition-duration: 0s;
+      }
+    }
+
+    @supports (background-clip: border-area) {
+      progress.progress-ring {
+        background-clip: border-area;
+        border: var(--thickness) solid transparent;
+        background-origin: border-box;
+      }
+    }
+
+    /* Fallback for browsers without background-clip: border-area support */
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        border: 0;
+        mask-image: radial-gradient(
+          transparent calc(50% - var(--thickness)),
+          black calc(50% - var(--thickness) + 0.5px)
+        );
+        -webkit-mask-image: radial-gradient(
+          transparent calc(50% - var(--thickness)),
+          black calc(50% - var(--thickness) + 0.5px)
+        );
+      }
+    }
+
+    /* Hide native progress chrome so only the conic-gradient ring is visible */
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::slider-fill {
+      display: none;
+      background: none;
+    }
+
+    /* Success state once the progress reaches 100% */
+    progress.progress-ring[value="100"],
+    progress[value="100"] {
+      --fill-color: #10b981;
+    }
+
+    .progress-ring-content,
+    .ring-content {
+      position: absolute;
+      font-weight: bold;
+      font-size: 1.5rem;
+      color: var(--primary);
+    }
   </style>
