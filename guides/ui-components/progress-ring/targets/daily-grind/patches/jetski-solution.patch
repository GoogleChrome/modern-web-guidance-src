+  <script>
+    (function () {
+      const progress = document.getElementById("rewards-progress") || document.querySelector("progress.progress-ring");
+      if (!progress) return;
+
+      // Fallback for browsers that don't support attr() on non-content properties:
+      // A MutationObserver monitors the value attribute and updates the --value property.
+      let supportsAttr = false;
+      try {
+        supportsAttr = Boolean(
+          window.CSS &&
+          CSS.supports &&
+          (CSS.supports("width: attr(value type(<number>))") ||
+           CSS.supports("width", "attr(value type(<number>))"))
+        );
+      } catch (e) {
+        supportsAttr = false;
+      }
+
+      if (!supportsAttr) {
+        const syncValue = () => {
+          const val = progress.getAttribute("value");
+          if (val !== null) {
+            progress.style.setProperty("--value", val);
+            const label = document.getElementById("rewards-progress-label") || (progress.parentElement ? progress.parentElement.querySelector(".progress-ring-content") : null);
+            if (label) {
+              label.textContent = val + "%";
+            }
+          }
+        };
+
+        syncValue();
+
+        const observer = new MutationObserver(() => {
+          syncValue();
+        });
+
+        observer.observe(progress, {
+          attributes: true,
+          attributeFilter: ["value"],
+        });
+
+        // Ensure property setter also reflects to value attribute and updates CSS property
+        try {
+          const descriptor = Object.getOwnPropertyDescriptor(HTMLProgressElement.prototype, "value");
+          if (descriptor && descriptor.set) {
+            Object.defineProperty(progress, "value", {
+              get() {
+                return descriptor.get.call(this);
+              },
+              set(val) {
+                descriptor.set.call(this, val);
+                this.setAttribute("value", String(val));
+              },
+              configurable: true,
+            });
+          }
+        } catch (e) {}
+      }
+    })();
+  </script>
+
