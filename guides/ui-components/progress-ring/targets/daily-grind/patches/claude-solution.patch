       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Progress Ring */
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      margin: 30px auto;
+    }
+
+    progress.progress-ring {
+      --size: 150px;
+      --thickness: 16px;
+      --track-color: var(--secondary);
+      --fill-color: var(--accent);
+      --value: attr(value type(<number>));
+      appearance: none;
+      -webkit-appearance: none;
+      -moz-appearance: none;
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+
+      transition: --value 0s ease-in-out;
+
+      background: conic-gradient(
+        var(--fill-color) calc(var(--value) * 1%),
+        var(--track-color) 0
+      );
+
+      /* MANDATORY: Clip the background to the border-area, hollowing out the center. */
+      background-clip: border-area;
+      border: var(--thickness) solid transparent;
+      background-origin: border-box;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.4s;
+      }
+    }
+
+    /* Fallback for browsers without background-clip: border-area support */
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        border: 0;
+        mask-image: radial-gradient(
+          transparent calc(50% - var(--thickness)),
+          black calc(50% - var(--thickness) + 0.5px)
+        );
+      }
+    }
+
+    /* Hide native progress chrome so only the conic-gradient ring is visible */
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value {
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      background: none;
+    }
+
+    /* Success state once the ring reaches 100% */
+    progress.progress-ring[value="100"] {
+      --fill-color: #10b981;
+    }
+
+    .progress-ring-content {
+      position: absolute;
+      font-weight: bold;
+      font-size: 1.4rem;
+      color: var(--primary);
+    }
   </style>
