+  <script>
+    (function () {
+      const progress = document.getElementById("rewards-progress");
+      if (!progress) return;
+
+      // Fallback for browsers that don't support typed attr(): sync attributes to custom properties.
+      if (!CSS.supports("width: attr(value type(<number>))")) {
+        const sync = () => {
+          progress.style.setProperty("--value", progress.getAttribute("value") ?? "0");
+          progress.style.setProperty("--max", progress.getAttribute("max") ?? "100");
+        };
+        sync();
+        const observer = new MutationObserver(sync);
+        observer.observe(progress, {
+          attributes: true,
+          attributeFilter: ["value", "max"],
+        });
+      }
+    })();
+  </script>
