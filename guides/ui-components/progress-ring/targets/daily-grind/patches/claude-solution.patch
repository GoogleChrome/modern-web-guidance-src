+    /* Loyalty Rewards */
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    .loyalty {
+      margin-top: 60px;
+    }
+
+    .loyalty-card {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      justify-content: center;
+      gap: 40px;
+      background: white;
+      padding: 30px 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      margin-top: 20px;
+    }
+
+    .loyalty-info {
+      max-width: 400px;
+      text-align: center;
+    }
+
+    .loyalty-info h3 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+    }
+
+    progress.progress-ring {
+      --size: 180px;
+      --thickness: 16px;
+      --track-color: var(--secondary);
+      --fill-color: var(--accent);
+      --value: attr(value type(<number>));
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+      appearance: none;
+      background: conic-gradient(var(--fill-color) calc(var(--value) * 1%),
+          var(--track-color) 0);
+      background-clip: border-area;
+      border: var(--thickness) solid transparent;
+      background-origin: border-box;
+      transition: --value 0s ease-in-out;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.4s;
+      }
+    }
+
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        mask-image: radial-gradient(transparent calc(50% - var(--thickness)),
+            black calc(50% - var(--thickness) + 0.5px));
+        border: 0;
+      }
+    }
+
+    /* Hide native bars */
+    progress.progress-ring::-webkit-progress-bar {
+      background: none;
+    }
+
+    progress.progress-ring::-webkit-progress-value {
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      background: none;
+    }
+
+    progress.progress-ring[value="100"] {
+      --fill-color: #6d4c41;
+    }
+
+    .progress-ring-content {
+      position: absolute;
+      text-align: center;
+      line-height: 1.2;
+      color: var(--primary);
+    }
+
+    .progress-ring-content strong {
+      display: block;
+      font-size: 2rem;
+    }
+
+    .progress-ring-content span {
+      font-size: 0.8rem;
+    }
+
