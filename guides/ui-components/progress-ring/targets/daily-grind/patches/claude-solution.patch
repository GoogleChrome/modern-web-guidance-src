+  <script>
+    (function () {
+      var progress = document.getElementById('rewards-progress');
+      if (!progress) return;
+
+      // Fallback for browsers that don't support attr() on non-content CSS properties:
+      // keep the --value custom property in sync with the value attribute manually.
+      var supportsAttrValue =
+        window.CSS && CSS.supports && CSS.supports('width', 'attr(value type(<number>))');
+
+      if (!supportsAttrValue) {
+        var sync = function () {
+          progress.style.setProperty('--value', progress.getAttribute('value'));
+        };
+        sync();
+        var observer = new MutationObserver(sync);
+        observer.observe(progress, { attributes: true, attributeFilter: ['value'] });
+      }
+    })();
+  </script>
