+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    @property --max {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 100;
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      flex: 0 0 auto;
+    }
+
+    progress.progress-ring {
+      --size: 200px;
+      --thickness: 18px;
+      --track-color: var(--secondary);
+      --fill-color: var(--primary);
+      --value: attr(value type(<number>), 0);
+      --max: attr(max type(<number>), 100);
+
+      -webkit-appearance: none;
+      appearance: none;
+      display: block;
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+      color: var(--fill-color);
+
+      background: conic-gradient(
+        var(--fill-color) calc(var(--value) / var(--max) * 100%),
+        var(--track-color) 0
+      );
+
+      /* Clip the background to the border-area to hollow out the center. */
+      background-clip: border-area;
+      border: var(--thickness) solid transparent;
+      background-origin: border-box;
+
+      /* Immediate by default; animate only for users without motion sensitivity. */
+      transition: --value 0s ease-in-out;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.4s;
+      }
+    }
+
+    /* Hide native progress bar UI */
+    progress.progress-ring::-webkit-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::slider-fill {
+      display: none;
+      background: none;
+    }
+
+    /* Fallback for browsers without background-clip: border-area */
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        border: 0;
+        -webkit-mask-image: radial-gradient(
+          farthest-side,
+          transparent calc(100% - var(--thickness)),
+          black calc(100% - var(--thickness) + 0.5px)
+        );
+        mask-image: radial-gradient(
+          farthest-side,
+          transparent calc(100% - var(--thickness)),
+          black calc(100% - var(--thickness) + 0.5px)
+        );
+      }
+    }
+
+    /* Success state: free drink earned */
+    progress.progress-ring[value="10"][max="10"] {
