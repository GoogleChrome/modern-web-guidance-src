+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    .rewards {
+      margin-top: 40px;
+      border-top: 4px solid var(--accent);
+      padding: 28px 20px;
+    }
+
+    .rewards h2 {
+      color: var(--primary);
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      width: 180px;
+      height: 180px;
+      margin: 24px auto;
+    }
+
+    progress.progress-ring {
+      --thickness: 14px;
+      --value: calc(100 * attr(value type(<number>)) / attr(max type(<number>)));
+      appearance: none;
+      display: block;
+      width: 100%;
+      height: 100%;
+      border-radius: 50%;
+      border: var(--thickness) solid transparent;
+      background: conic-gradient(var(--accent) calc(var(--value) * 1%), var(--secondary) 0);
+      background-origin: border-box;
+      background-clip: border-area;
+      transition: --value 0s ease-in-out;
+    }
+
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        border: 0;
+        mask-image: radial-gradient(circle closest-side, transparent calc(100% - var(--thickness)), black calc(100% - var(--thickness) + 0.5px));
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.4s;
+      }
+    }
+
+    .progress-ring-content {
+      position: absolute;
+      display: grid;
+      text-align: center;
+      line-height: 1.4;
+      pointer-events: none;
+    }
+
+    .progress-ring-content strong {
+      font-size: 2rem;
+      color: var(--primary);
+    }
+
+    .progress-ring-content span {
+      font-size: 0.85rem;
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
@@ -195,6 +276,21 @@
         </div>
       </div>
     </section>
+
+    <section class="card rewards" aria-labelledby="rewards-heading">
+      <h2 id="rewards-heading">Loyalty Rewards</h2>
+      <p>Good coffee deserves a little reward. Your next drink is on us after 10 drinks.</p>
+      <div class="progress-ring-wrapper">
+        <progress class="progress-ring" id="loyalty-progress" value="7" max="10"
+          aria-label="Drinks earned toward your next free drink" aria-describedby="rewards-status"></progress>
+        <div class="progress-ring-content" aria-hidden="true">
+          <strong id="rewards-count">7 / 10</strong>
+          <span>drinks earned</span>
+        </div>
+      </div>
+      <p id="rewards-status">3 more drinks until your next free drink!</p>
+      <a href="/rewards" class="btn">View My Rewards</a>
+    </section>
   </main>
 
   <footer>
@@ -207,6 +303,35 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const progress = document.getElementById('loyalty-progress');
+    const count = document.getElementById('rewards-count');
+    const status = document.getElementById('rewards-status');
+
+    if (progress instanceof HTMLProgressElement && count && status) {
+      const supportsTypedAttributes = CSS.supports('width: attr(value type(<number>))');
+      const updateRewards = () => {
+        const earned = progress.value;
+        const goal = progress.max;
+        const remaining = goal - earned;
+
+        if (!supportsTypedAttributes) {
+          progress.style.setProperty('--value', String(100 * earned / goal));
+        }
+
+        count.textContent = `${earned} / ${goal}`;
+        status.textContent = remaining === 0
+          ? 'Your free drink is ready!'
+          : `${remaining} more ${remaining === 1 ? 'drink' : 'drinks'} until your next free drink!`;
+      };
+
+      updateRewards();
+      new MutationObserver(updateRewards).observe(progress, {
+        attributes: true,
+        attributeFilter: ['value', 'max'],
+      });
+    }
+  </script>
 </body>
 
