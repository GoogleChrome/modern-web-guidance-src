+  <script>
+    const rewardsProgress = document.querySelector('progress.progress-ring');
+    const rewardsCount = document.getElementById('rewards-count');
+    const rewardsStatus = document.getElementById('rewards-status');
+
+    if (rewardsProgress instanceof HTMLProgressElement && rewardsCount && rewardsStatus) {
+      const needsValueFallback = !CSS.supports('width: attr(value type(<number>))');
+      const updateRewards = () => {
+        const { value, max } = rewardsProgress;
+        if (needsValueFallback) {
+          rewardsProgress.style.setProperty('--value', String(value / max * 100));
+        }
+        rewardsCount.textContent = `${value} / ${max}`;
+        const remaining = max - value;
+        rewardsStatus.textContent = remaining > 0
+          ? `Just ${remaining} more ${remaining === 1 ? 'drink' : 'drinks'} until your next free drink!`
+          : 'Your free drink is ready! Visit us to enjoy your reward.';
+      };
+
+      updateRewards();
+      new MutationObserver(updateRewards).observe(rewardsProgress, {
+        attributes: true,
+        attributeFilter: ['value', 'max'],
+      });
+    }
+  </script>
