+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      width: min(100%, 180px);
+      aspect-ratio: 1;
+      margin: 24px auto;
+    }
+
+    progress.progress-ring {
+      --thickness: 14px;
+      --track-color: var(--secondary);
+      --fill-color: var(--accent);
+      appearance: none;
+      display: block;
+      width: 100%;
+      height: 100%;
+      border-radius: 50%;
+      border: var(--thickness) solid transparent;
+      background: conic-gradient(var(--fill-color) calc(var(--value) * 1%), var(--track-color) 0);
+      background-origin: border-box;
+      background-clip: border-area;
+      transition: --value 0s ease-in-out;
+    }
+
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      display: none;
+      background: none;
+    }
+
+    @supports (width: attr(value type(<number>))) {
+      progress.progress-ring {
+        --value: calc(clamp(0, attr(value type(<number>)), attr(max type(<number>))) / attr(max type(<number>)) * 100);
+      }
+    }
+
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        border: 0;
+        mask-image: radial-gradient(closest-side, transparent calc(100% - var(--thickness)), black calc(100% - var(--thickness) + 0.5px));
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.4s;
+      }
+    }
+
+    .progress-ring-content {
+      position: absolute;
+      text-align: center;
+      pointer-events: none;
+    }
+
+    .progress-ring-content strong {
+      display: block;
+      font-size: 2rem;
+      line-height: 1.2;
+      color: var(--primary);
+    }
+
+    @media (forced-colors: active) {
+      progress.progress-ring {
+        --fill-color: Highlight;
+        --track-color: CanvasText;
+        forced-color-adjust: none;
+      }
+    }
