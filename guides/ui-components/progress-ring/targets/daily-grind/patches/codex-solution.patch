index 66c9173..069f193 100644
--- a/index.html
+++ b/index.html
@@ -120,6 +120,102 @@
       color: var(--primary);
     }
 
+    @property --value {
+      syntax: '<number>';
+      inherits: true;
+      initial-value: 0;
+    }
+
+    .rewards {
+      margin-bottom: 40px;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      flex-wrap: wrap;
+      gap: 28px;
+      background: #fff8ef;
+    }
+
+    .progress-ring-wrapper {
+      position: relative;
+      display: grid;
+      place-items: center;
+      flex-shrink: 0;
+    }
+
+    progress.progress-ring {
+      --size: 150px;
+      --thickness: 16px;
+      --track-color: #e4d8cd;
+      --fill-color: #925b26;
+      --value: attr(value type(<number>));
+      appearance: none;
+      display: block;
+      width: var(--size);
+      height: var(--size);
+      border-radius: 50%;
+      border: var(--thickness) solid transparent;
+      background: conic-gradient(var(--fill-color) calc(var(--value) * 1%), var(--track-color) 0);
+      background-origin: border-box;
+      background-clip: border-area;
+      transition: --value 0s ease-in-out;
+    }
+
+    progress.progress-ring::-webkit-progress-bar,
+    progress.progress-ring::-webkit-progress-value {
+      display: none;
+      background: none;
+    }
+
+    progress.progress-ring::-moz-progress-bar {
+      background: none;
+    }
+
+    @supports not (background-clip: border-area) {
+      progress.progress-ring {
+        border: 0;
+        mask-image: radial-gradient(circle closest-side, transparent calc(100% - var(--thickness)), black calc(100% - var(--thickness) + 0.5px));
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      progress.progress-ring {
+        transition-duration: 0.4s;
+      }
+    }
+
+    progress.progress-ring[value="100"] {
+      --fill-color: #21804a;
+    }
+
+    .progress-ring-content {
+      position: absolute;
+      font-size: 1.8rem;
+      font-weight: 700;
+      pointer-events: none;
+    }
+
+    .rewards-details {
+      max-width: 360px;
+      text-align: left;
+    }
+
+    .rewards-details label {
+      display: block;
+      margin-top: 16px;
+      font-weight: 600;
+    }
+
+    .rewards-details input {
+      width: 100%;
+      accent-color: var(--primary);
+    }
+
+    .rewards-details input:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 4px;
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
@@ -175,6 +271,18 @@
   </header>
 
