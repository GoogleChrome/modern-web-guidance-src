diff --git a/src/progress.js b/src/progress.js
new file mode 100644
index 0000000..cbf8348
--- /dev/null
+++ b/src/progress.js
@@ -0,0 +1,29 @@
+const supportsTypedAttr = CSS.supports('width: attr(value type(<number>))');
+
+document.querySelectorAll('.progress-ring-wrapper').forEach((wrapper) => {
+  const progress = wrapper.querySelector('progress');
+  const content = wrapper.querySelector('.progress-ring-content');
+  if (!(progress instanceof HTMLProgressElement)) return;
+
+  const sync = () => {
+    // Native progress.value clamps values to the component's 0–100 range.
+    const value = progress.value;
+    if (!supportsTypedAttr) {
+      progress.style.setProperty('--value', String(value));
+    }
+    if (content) content.textContent = `${Math.round(value)}%`;
+  };
+
+  // Observe in all browsers to also keep optional center text synchronized.
+  const observer = new MutationObserver(sync);
+  observer.observe(progress, { attributes: true, attributeFilter: ['value'] });
+  sync();
+});
+
+const control = document.querySelector('#reward-progress');
+const progress = document.querySelector('.rewards progress');
+if (control instanceof HTMLInputElement && progress instanceof HTMLProgressElement) {
+  control.addEventListener('input', () => {
+    progress.value = control.valueAsNumber;
+  });
+}
