+  <script>
+    (function () {
+      const progress = document.getElementById('loyalty-progress');
+      const percentageEl = document.getElementById('loyalty-percentage');
+      const pointsEl = document.getElementById('loyalty-points');
+      const statusMessageEl = document.getElementById('loyalty-status-message');
+      const addBeansBtn = document.getElementById('add-beans-btn');
+
+      if (!progress) return;
+
+      // Fallback for browsers that don't support CSS attr() with type(<number>)
+      if (!CSS.supports('width: attr(value type(<number>))')) {
+        progress.style.setProperty('--value', progress.getAttribute('value'));
+        const observer = new MutationObserver(() => {
+          progress.style.setProperty('--value', progress.getAttribute('value'));
+        });
+        observer.observe(progress, {
+          attributes: true,
+          attributeFilter: ['value'],
+        });
+      }
+
+      if (addBeansBtn) {
+        addBeansBtn.addEventListener('click', () => {
+          const currentVal = Number(progress.getAttribute('value')) || 0;
+          const nextVal = currentVal >= 100 ? 25 : Math.min(100, currentVal + 25);
+          progress.setAttribute('value', String(nextVal));
+
+          if (percentageEl) percentageEl.textContent = `${nextVal}%`;
+          if (pointsEl) pointsEl.textContent = `${nextVal} / 100 Beans`;
+          if (statusMessageEl) {
+            if (nextVal >= 100) {
+              statusMessageEl.innerHTML = '<strong>Congratulations!</strong> Your next handcrafted drink is free!';
+              addBeansBtn.textContent = 'Redeem & Reset';
+            } else {
+              const remaining = 100 - nextVal;
+              statusMessageEl.innerHTML = `You're only <strong>${remaining} Beans</strong> away from a complimentary handcrafted beverage!`;
+              addBeansBtn.textContent = '+25 Beans (Log Visit)';
+            }
+          }
+        });
+      }
+    })();
+  </script>
