+  <script>
+    const progress = document.getElementById("loyalty-progress");
+    const percentageText = document.getElementById("loyalty-percentage");
+    const pointsText = document.getElementById("loyalty-points");
+    const statusText = document.getElementById("rewards-status");
+    const addVisitBtn = document.getElementById("add-visit-btn");
+
+    // Initialize --value for fallback before any attribute mutation
+    if (!CSS.supports("width: attr(value type(<number>))")) {
+      progress.style.setProperty("--value", progress.getAttribute("value"));
+      const observer = new MutationObserver(() => {
+        progress.style.setProperty("--value", progress.getAttribute("value"));
+      });
+      observer.observe(progress, {
+        attributes: true,
+        attributeFilter: ["value"],
+      });
+    }
+
+    if (addVisitBtn) {
+      addVisitBtn.addEventListener("click", () => {
+        let current = Number(progress.getAttribute("value")) || 0;
+        let next = current >= 100 ? 25 : Math.min(100, current + 25);
+        progress.setAttribute("value", String(next));
+        percentageText.textContent = `${next}%`;
+        pointsText.textContent = `${next} / 100 pts`;
+        if (next >= 100) {
+          statusText.textContent = "Congratulations! You've earned a free artisanal beverage!";
+          addVisitBtn.textContent = "Redeem & Start Next (+25 pts)";
+        } else {
+          statusText.textContent = `You're ${100 - next} points away from your next free artisanal beverage!`;
+          addVisitBtn.textContent = "Log a Visit (+25 pts)";
+        }
+      });
+    }
+  </script>
+
