+---
+export interface Props {
+  value?: number;
+  max?: number;
+  ariaLabel?: string;
+  size?: string;
+  thickness?: string;
+  class?: string;
+}
+
+const {
+  value = 75,
+  max = 100,
+  ariaLabel = "Task progress",
+  size,
+  thickness,
+  class: className = "",
+} = Astro.props;
+
+const styleMap: string[] = [];
+if (size) styleMap.push(`--size: ${size}`);
+if (thickness) styleMap.push(`--thickness: ${thickness}`);
+const inlineStyle = styleMap.length > 0 ? styleMap.join("; ") : undefined;
+---
+
+<div class={`progress-ring-wrapper ring-wrapper ${className}`.trim()}>
+  <progress
+    value={value}
+    max={max}
+    aria-label={ariaLabel}
+    class="progress-ring"
+    style={inlineStyle}
+  ></progress>
+  <!-- Optional: Content to display in the center -->
+  <div class="progress-ring-content ring-content">
+    <slot>{value}%</slot>
+  </div>
+</div>
+
+<script>
+  function initProgressRings() {
+    if (!CSS.supports("width: attr(value type(<number>))")) {
+      const rings = document.querySelectorAll<HTMLProgressElement>("progress.progress-ring");
+      rings.forEach((progress) => {
+        progress.style.setProperty("--value", progress.getAttribute("value"));
+        if ((progress as any)._hasObserver) return;
+        (progress as any)._hasObserver = true;
+
+        const observer = new MutationObserver(() => {
+          progress.style.setProperty("--value", progress.getAttribute("value"));
+          const wrapper = progress.closest(".progress-ring-wrapper, .ring-wrapper");
+          if (wrapper) {
+            const content = wrapper.querySelector(".progress-ring-content, .ring-content");
+            if (content && content.textContent && content.textContent.trim().endsWith("%")) {
+              content.textContent = `${progress.getAttribute("value")}%`;
+            }
+          }
+        });
+        observer.observe(progress, {
+          attributes: true,
+          attributeFilter: ["value"],
+        });
+      });
+    }
+  }
+
+  initProgressRings();
+  document.addEventListener("DOMContentLoaded", initProgressRings);
+  document.addEventListener("astro:page-load", initProgressRings);
+
+  if (typeof MutationObserver !== "undefined") {
+    const docObserver = new MutationObserver(() => {
+      initProgressRings();
+    });
+    docObserver.observe(document.documentElement, {
+      childList: true,
+      subtree: true,
+    });
+  }
+</script>
