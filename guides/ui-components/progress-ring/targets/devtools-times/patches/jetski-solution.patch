+import React, { useEffect, useRef } from 'react';
+
+export interface ProgressRingProps {
+  value?: number;
+  max?: number;
+  ariaLabel?: string;
+  size?: string;
+  thickness?: string;
+  className?: string;
+  children?: React.ReactNode;
+}
+
+export const ProgressRing: React.FC<ProgressRingProps> = ({
+  value = 75,
+  max = 100,
+  ariaLabel = "Task progress",
+  size,
+  thickness,
+  className = "",
+  children,
+}) => {
+  const progressRef = useRef<HTMLProgressElement>(null);
+  const contentRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const progress = progressRef.current;
+    if (!progress) return;
+
+    if (typeof CSS === "undefined" || !CSS.supports("width: attr(value type(<number>))")) {
+      progress.style.setProperty("--value", progress.getAttribute("value") || String(value));
+
+      const observer = new MutationObserver(() => {
+        const val = progress.getAttribute("value");
+        if (val !== null) {
+          progress.style.setProperty("--value", val);
+          if (contentRef.current && contentRef.current.textContent?.trim().endsWith("%")) {
+            contentRef.current.textContent = `${val}%`;
+          }
+        }
+      });
+      observer.observe(progress, {
+        attributes: true,
+        attributeFilter: ["value"],
+      });
+
+      return () => observer.disconnect();
+    }
+  }, [value]);
+
+  const style: React.CSSProperties & Record<string, string | number> = {};
+  if (size) style["--size"] = size;
+  if (thickness) style["--thickness"] = thickness;
+
+  return (
+    <div className={`progress-ring-wrapper ring-wrapper ${className}`.trim()}>
+      <progress
+        ref={progressRef}
+        value={value}
+        max={max}
+        aria-label={ariaLabel}
+        className="progress-ring"
+        style={style}
+      />
+      {/* Optional: Content to display in the center */}
+      <div ref={contentRef} className="progress-ring-content ring-content">
+        {children !== undefined ? children : `${value}%`}
+      </div>
+    </div>
+  );
+};
+
+export default ProgressRing;
