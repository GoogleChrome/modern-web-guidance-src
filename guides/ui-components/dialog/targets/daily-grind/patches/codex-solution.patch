diff --git a/main.ts b/main.ts
new file mode 100644
index 0000000..6d06deb
--- /dev/null
+++ b/main.ts
@@ -0,0 +1,94 @@
+const drinks = {
+  maple: {
+    name: 'Maple Oat Latte',
+    description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+    servings: ['Small', 'Medium', 'Large'],
+  },
+  espresso: {
+    name: 'Dark Roast Espresso',
+    description: 'Bold, smokey, and perfect for a morning boost.',
+    servings: ['Single shot', 'Double shot'],
+  },
+  'cold-brew': {
+    name: 'Cold Brew',
+    description: 'Steeped for 18 hours for maximum smoothness.',
+    servings: ['Small', 'Medium', 'Large'],
+  },
+} satisfies Record<string, { name: string; description: string; servings: string[] }>;
+
+type DrinkId = keyof typeof drinks;
+
+function isDrinkId(value: string): value is DrinkId {
+  return Object.hasOwn(drinks, value);
+}
+
+const dialog = document.querySelector('#drink-dialog');
+const title = document.querySelector('#drink-title');
+const description = document.querySelector('#drink-description');
+const choice = document.querySelector('#drink-choice');
+const serving = document.querySelector('#drink-serving');
+const quantity = document.querySelector('#drink-quantity');
+const orderForm = document.querySelector('#drink-order');
+const summary = document.querySelector('#order-summary');
+
+if (!(dialog instanceof HTMLDialogElement)
+  || !(choice instanceof HTMLSelectElement)
+  || !(serving instanceof HTMLSelectElement)
+  || !(quantity instanceof HTMLInputElement)
+  || !(orderForm instanceof HTMLFormElement)
+  || !title || !description || !summary) {
+  throw new Error('The drink dialog is missing required elements.');
+}
+
+function selectDrink(id: DrinkId): void {
+  const drink = drinks[id];
+  // These elements are checked at initialization, before handlers are registered.
+  if (!title || !description || !(choice instanceof HTMLSelectElement)
+    || !(serving instanceof HTMLSelectElement)) return;
+  choice.value = id;
+  title.textContent = drink.name;
+  description.textContent = drink.description;
+  serving.replaceChildren(...drink.servings.map((size) => new Option(size, size)));
+}
+
+for (const button of document.querySelectorAll('button[data-drink]')) {
+  if (!(button instanceof HTMLButtonElement)) continue;
+  button.addEventListener('click', () => {
+    const id = button.dataset.drink;
+    if (!id || !isDrinkId(id) || dialog.open) return;
+    orderForm.reset();
+    selectDrink(id);
+    dialog.showModal();
+  });
+}
+
+choice.addEventListener('change', () => {
+  if (isDrinkId(choice.value)) selectDrink(choice.value);
+});
+
+dialog.addEventListener('close', () => {
+  const result = dialog.returnValue;
+  dialog.returnValue = '';
+  if (result !== 'save' || !isDrinkId(choice.value)) return;
+  summary.textContent = `Selection saved: ${quantity.valueAsNumber} × ${drinks[choice.value].name}, ${serving.value}. Order and pay at the café; no order has been placed.`;
+});
+
+// Older browsers still provide native Escape and platform close requests.
+// Add light dismissal only when the native closedby API is missing.
+if (!('closedBy' in HTMLDialogElement.prototype)) {
+  const outside = (event: PointerEvent): boolean => {
+    const bounds = dialog.getBoundingClientRect();
+    return event.clientX < bounds.left || event.clientX > bounds.right
+      || event.clientY < bounds.top || event.clientY > bounds.bottom;
+  };
+  let outsidePointer: number | undefined;
+  dialog.addEventListener('pointerdown', (event) => {
+    outsidePointer = event.isPrimary && event.button === 0 && outside(event)
+      ? event.pointerId : undefined;
+  });
+  dialog.addEventListener('pointerup', (event) => {
+    if (outsidePointer === event.pointerId && outside(event) && dialog.open) dialog.close();
+    outsidePointer = undefined;
+  });
+  dialog.addEventListener('pointercancel', () => { outsidePointer = undefined; });
+}
