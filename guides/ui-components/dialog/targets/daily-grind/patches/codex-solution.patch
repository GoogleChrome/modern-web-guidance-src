diff --git a/order.js b/order.js
new file mode 100644
index 0000000..df2572f
--- /dev/null
+++ b/order.js
@@ -0,0 +1,109 @@
+// @ts-check
+const dialog = document.querySelector('#order-dialog');
+const form = document.querySelector('#order-form');
+const drink = document.querySelector('#drink');
+const milk = document.querySelector('#milk');
+const title = document.querySelector('#order-title');
+const description = document.querySelector('#drink-description');
+const discard = document.querySelector('#discard-order');
+const closeButton = document.querySelector('#close-order');
+const status = document.querySelector('#order-status');
+
+if (!(dialog instanceof HTMLDialogElement) || !(form instanceof HTMLFormElement) ||
+    !(drink instanceof HTMLSelectElement) || !(milk instanceof HTMLSelectElement) ||
+    !(discard instanceof HTMLButtonElement) || !(closeButton instanceof HTMLButtonElement) ||
+    !title || !description || !status) {
+  throw new Error('Order dialog markup is incomplete.');
+}
+
+const drinks = new Map([
+  ['maple', { name: 'Maple Oat Latte', description: 'Creamy oat milk with a hint of Vermont maple syrup.', milk: 'Oat' }],
+  ['espresso', { name: 'Dark Roast Espresso', description: 'Bold, smokey, and perfect for a morning boost.', milk: 'None' }],
+  ['cold', { name: 'Cold Brew', description: 'Steeped for 18 hours for maximum smoothness.', milk: 'None' }],
+]);
+const snapshot = () => JSON.stringify(Array.from(new FormData(form).entries()));
+let initialOptions = '';
+const dirty = () => snapshot() !== initialOptions;
+function updateDetails() {
+  const selected = drinks.get(drink.value);
+  if (!selected) return;
+  title.textContent = selected.name;
+  description.textContent = selected.description;
+}
+function syncChanges() {
+  dialog.setAttribute('closedby', dirty() ? 'none' : 'any');
+  if (!dirty()) {
+    dialog.removeAttribute('data-confirming');
+    closeButton.textContent = 'Close';
+    closeButton.removeAttribute('aria-describedby');
+  }
+}
+function requestDismiss() {
+  if (!dirty()) {
+    dialog.close();
+    return;
+  }
+  dialog.setAttribute('data-confirming', '');
+  closeButton.textContent = 'Keep editing';
+  closeButton.setAttribute('aria-describedby', 'discard-message');
+  closeButton.focus();
+}
+document.querySelectorAll('[data-order]').forEach((button) => {
+  button.addEventListener('click', () => {
+    if (!(button instanceof HTMLButtonElement)) return;
+    form.reset();
+    drink.value = button.dataset.order || 'maple';
+    milk.value = drinks.get(drink.value)?.milk || 'None';
+    updateDetails();
+    initialOptions = snapshot();
+    syncChanges();
+    status.textContent = '';
+    dialog.showModal();
+  });
+});
+form.addEventListener('input', syncChanges);
+form.addEventListener('change', () => { updateDetails(); syncChanges(); });
+dialog.addEventListener('cancel', (event) => {
+  if (dirty()) { event.preventDefault(); requestDismiss(); }
+});
+closeButton.addEventListener('click', () => {
+  if (dialog.hasAttribute('data-confirming')) {
+    dialog.removeAttribute('data-confirming');
+    closeButton.textContent = 'Close';
+    closeButton.removeAttribute('aria-describedby');
+  } else {
+    requestDismiss();
+  }
+});
+discard.addEventListener('click', () => dialog.close('discard'));
+// Also protects dirty orders and supports light dismissal without closedBy support.
+/** @param {PointerEvent} event */
+function outside(event) {
+  const rect = dialog.getBoundingClientRect();
+  return event.clientX < rect.left || event.clientX > rect.right ||
+    event.clientY < rect.top || event.clientY > rect.bottom;
+}
+let pressedOutside = false;
+dialog.addEventListener('pointerdown', (event) => { pressedOutside = outside(event); });
+dialog.addEventListener('pointerup', (event) => {
+  if (pressedOutside && outside(event) && (dirty() || !('closedBy' in HTMLDialogElement.prototype))) {
+    requestDismiss();
+  }
+  pressedOutside = false;
+});
+dialog.addEventListener('pointercancel', () => { pressedOutside = false; });
+form.addEventListener('submit', (event) => {
+  event.preventDefault();
+  const options = new FormData(form);
+  status.textContent = `${options.get('quantity')} × ${options.get('size')} ${drinks.get(drink.value)?.name}, milk: ${milk.value}, added to your order. No payment has been taken.`;
+  dialog.close('added');
+});
+dialog.addEventListener('close', () => {
+  dialog.returnValue = '';
+  form.reset();
+  dialog.removeAttribute('data-confirming');
+  dialog.setAttribute('closedby', 'any');
+  closeButton.textContent = 'Close';
+  closeButton.removeAttribute('aria-describedby');
+  pressedOutside = false;
+});
