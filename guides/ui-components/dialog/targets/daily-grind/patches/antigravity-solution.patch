+  <script type="module">
+    // MANDATORY: feature detect on HTMLButtonElement.prototype and load only when native support is missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('invokers-polyfill'); // npm install invokers-polyfill
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy steamed oat milk blended with rich espresso and pure Grade A Vermont maple syrup, finished with a dash of cinnamon.',
+        price: '$5.50',
+        calories: '190 cal',
+        notes: 'Notes: Maple, Toasted Oat, Cinnamon',
+        defaultSize: 'Medium',
+        defaultMilk: 'Oat Milk',
+        defaultSweetness: 'Standard'
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and full-bodied double shot pulled from dark-roasted Sumatra and Colombian beans for the ultimate morning boost.',
+        price: '$3.75',
+        calories: '15 cal',
+        notes: 'Notes: Dark Chocolate, Molasses, Smokey Oak',
+        defaultSize: 'Small',
+        defaultMilk: 'None',
+        defaultSweetness: 'Unsweetened'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Coarse-ground Ethiopian beans steeped in filtered cold water for 18 hours for maximum smoothness and naturally sweet cocoa notes.',
+        price: '$4.75',
+        calories: '25 cal',
+        notes: 'Notes: Sweet Cocoa, Caramel, Smooth Finish',
+        defaultSize: 'Medium',
+        defaultMilk: 'None',
+        defaultSweetness: 'Unsweetened'
+      }
+    };
+
+    const dialog = document.getElementById('order-dialog');
+    const form = document.getElementById('order-form');
+    const titleEl = document.getElementById('order-dialog-title');
+    const descEl = document.getElementById('order-dialog-description');
+    const priceEl = document.getElementById('order-dialog-price');
+    const caloriesEl = document.getElementById('order-dialog-calories');
+    const notesEl = document.getElementById('order-dialog-notes');
+    const drinkSelect = document.getElementById('drink-select');
+    const milkSelect = document.getElementById('milk-select');
+    const sweetnessSelect = document.getElementById('sweetness-select');
+    const quantityInput = document.getElementById('quantity-input');
+    const warningEl = document.getElementById('unsaved-warning');
+    const discardBtn = document.getElementById('discard-btn');
+    const feedbackEl = document.getElementById('order-feedback');
+
+    let isDirty = false;
+
+    function updateDrinkDisplay(drinkKey) {
+      const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+      titleEl.textContent = drink.name;
+      descEl.textContent = drink.description;
+      priceEl.textContent = drink.price;
+      caloriesEl.textContent = drink.calories;
+      notesEl.textContent = drink.notes;
+    }
+
+    function resetDirtyState() {
+      isDirty = false;
+      dialog.setAttribute('closedby', 'any');
+      warningEl.classList.remove('is-visible');
+      discardBtn.hidden = true;
+    }
+
+    function markDirty() {
+      if (!isDirty) {
+        isDirty = true;
+        dialog.setAttribute('closedby', 'none');
+      }
+    }
+
+    function promptUnsavedConfirmation() {
+      warningEl.classList.add('is-visible');
+      discardBtn.hidden = false;
+      discardBtn.focus();
+    }
+
+    function initializeDialogForDrink(drinkKey) {
+      const key = DRINKS[drinkKey] ? drinkKey : 'maple-oat-latte';
+      const drink = DRINKS[key];
+      drinkSelect.value = key;
+      updateDrinkDisplay(key);
+
+      const sizeRadio = form.querySelector(`input[name="size"][value="${drink.defaultSize}"]`);
+      if (sizeRadio) sizeRadio.checked = true;
+      milkSelect.value = drink.defaultMilk;
+      sweetnessSelect.value = drink.defaultSweetness;
+      quantityInput.value = '1';
+
+      resetDirtyState();
+    }
+
+    for (const btn of document.querySelectorAll('button[commandfor="order-dialog"][command="show-modal"]')) {
+      btn.addEventListener('click', () => {
+        initializeDialogForDrink(btn.dataset.drink);
+        if (!('commandForElement' in HTMLButtonElement.prototype) && !dialog.open) {
+          dialog.showModal();
+        }
+      });
+    }
+
+    for (const btn of dialog.querySelectorAll('button[command="request-close"]')) {
+      btn.addEventListener('click', () => {
+        if (!('commandForElement' in HTMLButtonElement.prototype)) {
+          if (typeof dialog.requestClose === 'function') {
+            dialog.requestClose();
+          } else {
+            const cancelEvent = new Event('cancel', { cancelable: true });
+            if (dialog.dispatchEvent(cancelEvent)) {
+              dialog.close();
+            }
+          }
+        }
+      });
+    }
+
+    form.addEventListener('change', (e) => {
+      if (e.target === drinkSelect) {
+        updateDrinkDisplay(drinkSelect.value);
+      }
+      markDirty();
+    });
+
+    form.addEventListener('input', () => {
+      markDirty();
+    });
+
+    dialog.addEventListener('cancel', (e) => {
+      if (isDirty) {
+        e.preventDefault();
+        promptUnsavedConfirmation();
+      }
+    });
+
+    dialog.addEventListener('close', () => {
+      const action = dialog.returnValue;
+      dialog.returnValue = '';
+
+      if (action === 'order') {
+        const drink = DRINKS[drinkSelect.value] || DRINKS['maple-oat-latte'];
+        const sizeInput = form.querySelector('input[name="size"]:checked');
+        const size = sizeInput ? sizeInput.value : 'Medium';
+        const qty = quantityInput.value || '1';
+        feedbackEl.textContent = `Added ${qty}x ${size} ${drink.name} (${milkSelect.value}, ${sweetnessSelect.value}) to your order.`;
+        feedbackEl.hidden = false;
+      }
+
+      resetDirtyState();
+    });
+
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      // Test the pointer position, not event.target: the <dialog> is also the target for its own
+      // padding and the gaps between its children, so a target check would close on those clicks
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dialog); });
+        // Require the press and the release outside, so a text-selection drag that ends on the backdrop does not dismiss
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e, dialog) && dialog.getAttribute('closedby') === 'any') {
+            dialog.close();
+          }
+        });
+      }
+    }
+  </script>
+
 </body>
 
