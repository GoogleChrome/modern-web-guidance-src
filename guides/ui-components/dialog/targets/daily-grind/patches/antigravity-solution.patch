+  <script type="module">
+    // MANDATORY: feature detect on HTMLButtonElement.prototype and load only when native support is missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('invokers-polyfill').catch(() => {
+        document.addEventListener('click', (e) => {
+          const btn = e.target.closest('button[command][commandfor]');
+          if (!btn) return;
+          const target = document.getElementById(btn.getAttribute('commandfor'));
+          if (!target || !(target instanceof HTMLDialogElement)) return;
+          const cmd = btn.getAttribute('command');
+          if (cmd === 'show-modal') {
+            if (!target.open) target.showModal();
+          } else if (cmd === 'close') {
+            if (target.open) target.close();
+          } else if (cmd === 'request-close') {
+            if (target.open) {
+              if ('requestClose' in target) target.requestClose();
+              else target.close();
+            }
+          }
+        });
+      });
+    }
+
+    // Fallback for `closedby="any"` (`dialog-closedby`)
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      // Test the pointer position, not event.target: the <dialog> is also the target for its own
+      // padding and the gaps between its children, so a target check would close on those clicks
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e, dialog); });
+        // Require the press and the release outside, so a text-selection drag that ends on the backdrop does not dismiss
+        dialog.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e, dialog)) dialog.close(); });
+      }
+    }
+
+    // Read dialog.returnValue in a close listener to learn which button was used,
+    // then reset it with dialog.returnValue = '' to prevent stale values from leaking.
+    const statusBanner = document.getElementById('order-status-banner');
+    for (const dialog of document.querySelectorAll('dialog')) {
+      dialog.addEventListener('close', () => {
+        const action = dialog.returnValue;
+        dialog.returnValue = '';
+
+        if (!action || action === 'cancel') {
+          return;
+        }
+
+        const form = dialog.querySelector('form');
+        const heading = dialog.querySelector('h2');
+        const data = form ? new FormData(form) : null;
+        const drinkName = (data && data.get('drink')) || (heading ? heading.textContent : 'Coffee');
+        const size = (data && (data.get('size') || data.get('shots'))) || '';
+
+        if (statusBanner) {
+          statusBanner.textContent = `Added ${size ? size + ' ' : ''}${drinkName} to your order!`;
+          statusBanner.hidden = false;
+        }
+      });
+    }
+  </script>
