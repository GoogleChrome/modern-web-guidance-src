+  <script type="module">
+    // Load the Invoker Commands polyfill only where native support is missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.sh/invokers-polyfill');
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        prices: { small: 4.75, medium: 5.25, large: 5.75 },
+        milk: 'oat',
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        prices: { small: 3.0, medium: 3.5, large: 4.0 },
+        milk: 'none',
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        prices: { small: 4.25, medium: 4.75, large: 5.25 },
+        milk: 'none',
+      },
+    };
+    const DEFAULT_DRINK = 'maple-oat-latte';
+
+    const dialog = document.getElementById('drink-dialog');
+    const form = document.getElementById('drink-form');
+    const title = document.getElementById('drink-dialog-title');
+    const description = document.getElementById('drink-dialog-description');
+    const price = document.getElementById('drink-dialog-price');
+    const discardButton = document.getElementById('drink-discard');
+    const status = document.getElementById('order-status');
+
+    const currency = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
+    const serialize = () => new URLSearchParams(new FormData(form)).toString();
+
+    let pristineState = '';
+
+    const isDirty = () => serialize() !== pristineState;
+
+    function showDrinkDetails(id) {
+      const drink = DRINKS[id] ?? DRINKS[DEFAULT_DRINK];
+      title.textContent = drink.name;
+      description.textContent = drink.description;
+      price.textContent = currency.format(drink.prices.small);
+    }
+
+    function setConfirming(confirming) {
+      dialog.classList.toggle('is-confirming', confirming);
+    }
+
+    // Prevent light dismiss and close requests while the order has unsaved changes
+    function syncDismissal() {
+      const dirty = isDirty();
+      dialog.setAttribute('closedby', dirty ? 'none' : 'any');
+      if (!dirty) setConfirming(false);
+    }
+
+    function prepare(drinkId) {
+      form.reset();
+      const id = drinkId in DRINKS ? drinkId : DEFAULT_DRINK;
+      form.elements.drink.value = id;
+      form.elements.milk.value = DRINKS[id].milk;
+      showDrinkDetails(id);
+      pristineState = serialize();
+      setConfirming(false);
+      dialog.setAttribute('closedby', 'any');
+    }
+
+    // Fired on the dialog by the invoking button (natively or via the polyfill) before it opens
+    dialog.addEventListener('command', (event) => {
+      if (event.command !== 'show-modal') return;
+      const source = event.source;
+      prepare(source instanceof HTMLElement ? source.dataset.drink ?? DEFAULT_DRINK : DEFAULT_DRINK);
+    });
+
+    form.addEventListener('input', (event) => {
+      if (event.target === form.elements.drink) showDrinkDetails(form.elements.drink.value);
+      syncDismissal();
+    });
+    form.addEventListener('change', syncDismissal);
+
+    // Guard unsaved changes for Esc, the back gesture and the Cancel (request-close) button,
+    // including browsers where closedby is not supported
+    dialog.addEventListener('cancel', (event) => {
+      if (!isDirty()) return;
+      event.preventDefault();
+      setConfirming(true);
+      discardButton.focus();
+    });
+
+    discardButton.addEventListener('click', () => {
+      dialog.close('discard');
+    });
+
+    dialog.addEventListener('close', () => {
+      const result = dialog.returnValue;
+      dialog.returnValue = '';
+
+      if (result === 'order') {
+        const data = new FormData(form);
+        const drink = DRINKS[String(data.get('drink'))] ?? DRINKS[DEFAULT_DRINK];
+        const size = String(data.get('size') ?? 'medium');
+        const quantity = Number(data.get('quantity')) || 1;
+        const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+        const total = currency.format((drink.prices[size] ?? drink.prices.medium) * quantity);
+        status.textContent = `Added ${quantity} × ${sizeLabel} ${drink.name} to your order (${total}).`;
+      }
+
+      form.reset();
+      pristineState = serialize();
+      setConfirming(false);
+      dialog.setAttribute('closedby', 'any');
+    });
+
+    // Light-dismiss fallback where closedby is not supported
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      // Test the pointer position, not event.target: the dialog is also the target for its own padding
+      const outside = (e) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
+      dialog.addEventListener('pointerup', (e) => {
+        // Re-check closedby at release time so an order with unsaved changes stays open
+        if (pressedOutside && outside(e) && dialog.getAttribute('closedby') === 'any') dialog.close();
+        pressedOutside = false;
+      });
+    }
+  </script>
+
 </body>
 
