+      if (!menu || !isOpen(menu)) return;
+      const prevSuppress = suppressPreview;
+      suppressPreview = true;
+      try {
+        menu.hidePopover();
+      } catch {} finally {
+        suppressPreview = prevSuppress;
+      }
+    }
+
+    function moveToRootTrigger(from, direction) {
+      const idx = rootTriggers.indexOf(from);
+      if (idx < 0) return;
+      const next = rootTriggers[(idx + direction + rootTriggers.length) % rootTriggers.length];
+      rootTriggers.forEach(trigger => {
+        trigger.tabIndex = trigger === next ? 0 : -1;
+      });
+      closeAllMenus();
+      if (document.activeElement === next) {
+        openPopover(menuFor(next), next);
+      } else {
+        next.focus({ preventScroll: true });
+      }
+    }
+
+    function enterMenu(menu, which = 'first') {
+      const group = menu?.querySelector(':scope > [focusgroup~="menu"]');
+      const items = getMenuItems(group);
+      const target = which === 'last' ? items[items.length - 1] : items[0];
+      target?.focus({ preventScroll: true });
+    }
+
+    function startBridge(submenu, event) {
+      if (!canHover.matches || !submenu || !isOpen(submenu)) return;
+      const rect = submenu.getBoundingClientRect();
+      const left = event.clientX < rect.left;
+      if (!left && event.clientX <= rect.right) return;
+      submenu.style.setProperty('--pointer-x', `${event.clientX - rect.left}px`);
+      submenu.style.setProperty('--pointer-y', `${event.clientY - rect.top}px`);
+      submenu.dataset.bridge = '';
+      let timer;
+      let lastX = event.clientX;
+      const stop = () => {
+        clearTimeout(timer);
+        submenu.removeEventListener('pointermove', extend);
+        submenu.removeEventListener('toggle', stop);
+        submenu.removeAttribute('data-bridge');
+      };
+      const extend = ({ target, clientX }) => {
+        if (target !== submenu || (left ? clientX < lastX : clientX > lastX)) return stop();
+        lastX = clientX;
+        clearTimeout(timer);
+        timer = setTimeout(stop, 300);
+      };
+      timer = setTimeout(stop, 300);
+      submenu.addEventListener('pointermove', extend);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+
+    // Window blur/focus guard so app-switching doesn't reopen the last previewed menu
+    window.addEventListener('blur', () => {
+      windowBlurred = true;
+    });
+    window.addEventListener('focus', () => {
+      setTimeout(() => {
+        windowBlurred = false;
+      }, 0);
+    });
+
+    window.addEventListener('pointerup', () => {
+      setTimeout(() => {
+        pointerTrigger = null;
+        pointerActivatedItem = null;
+      }, 0);
+    });
+    window.addEventListener('pointercancel', () => {
+      pointerTrigger = null;
+      pointerActivatedItem = null;
+    });
+
+    // Outside focus closes every open menu; menubar and its popovers count as inside
+    document.addEventListener('focusin', event => {
+      if (menubar.contains(event.target)) return;
+      closeAllMenus();
+    });
+
+    // Trigger interactions (both top-level and submenu triggers)
+    allTriggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+      if (!menu) return;
+
+      trigger.addEventListener('pointerdown', () => {
+        pointerTrigger = trigger;
+      });
+
+      trigger.addEventListener('mousedown', event => {
+        // Prevent focus-on-mousedown so focus-preview doesn't race ahead of click toggle
+        event.preventDefault();
+      });
+
+      trigger.addEventListener('click', () => {
+        const wasOpen = isOpen(menu);
+        const fromPointer = pointerTrigger === trigger;
+        pointerTrigger = null;
+
+        if (!wasOpen) {
+          if (fromPointer) {
+            pointerOpenedMenus.add(menu);
+          } else if (!enterTargetOnOpen.has(menu)) {
+            enterTargetOnOpen.set(menu, 'first');
+          }
+        }
+
+        if (!supportsInvoker) {
+          if (wasOpen) {
+            menu.hidePopover();
+          } else {
+            openPopover(menu, trigger);
+          }
+        }
+      });
+
+      trigger.addEventListener('focus', event => {
+        if (windowBlurred || suppressPreview) return;
+        if (isOpen(menu)) return;
+        if (event.relatedTarget && menu.contains(event.relatedTarget)) return;
+        openPopover(menu, trigger);
+      });
+
+      trigger.addEventListener('blur', event => {
+        if (!isOpen(menu)) return;
+        const next = event.relatedTarget;
+        if (next && menu.contains(next)) return;
+        try {
+          menu.hidePopover();
+        } catch {}
+      });
+
+      if (isRootTrigger(trigger)) {
+        trigger.addEventListener('pointerenter', () => {
+          if (!canHover.matches) return;
+          const anyOtherOpen = rootTriggers.some(other => other !== trigger && isOpen(menuFor(other)));
+          if (!anyOtherOpen) return;
+          closeAllMenus();
+          if (document.activeElement === trigger) {
+            openPopover(menu, trigger);
+          } else {
+            trigger.focus({ preventScroll: true, focusVisible: false });
+          }
+        });
+
+        trigger.addEventListener('keydown', event => {
+          if (event.key === 'ArrowRight') {
+            event.preventDefault();
+            moveToRootTrigger(trigger, 1);
+          } else if (event.key === 'ArrowLeft') {
+            event.preventDefault();
+            moveToRootTrigger(trigger, -1);
+          } else if (event.key === 'ArrowDown' || event.key === 'Home' || event.key === 'End') {
+            event.preventDefault();
+            const which = event.key === 'End' ? 'last' : 'first';
+            if (isOpen(menu)) {
+              enterMenu(menu, which);
+            } else {
+              enterTargetOnOpen.set(menu, which);
+              trigger.click();
+            }
+          } else if (event.key === 'Escape' && isOpen(menu)) {
+            event.preventDefault();
+            event.stopPropagation();
+            hideMenuQuietly(menu);
+          }
+        });
+      } else {
+        trigger.addEventListener('pointerleave', event => {
+          clearTimeout(submenuHoverTimer);
+          startBridge(menu, event);
+        });
+      }
+    });
+
+    // Toggle sync, positioning fallback, and post-open focus placement
+    allMenus.forEach(menu => {
+      menu.addEventListener('toggle', event => {
+        const trigger = triggerFor(menu);
+        const opened = event.newState === 'open';
+        if (trigger) {
+          trigger.setAttribute('aria-expanded', String(opened));
+        }
+
+        if (!opened) {
+          enterTargetOnOpen.delete(menu);
+          pointerOpenedMenus.delete(menu);
+          return;
+        }
+
+        if (!supportsAnchorPos && trigger) {
+          positionPopoverFallback(trigger, menu);
+        }
+
+        if (enterTargetOnOpen.has(menu)) {
+          const which = enterTargetOnOpen.get(menu);
+          enterTargetOnOpen.delete(menu);
+          enterMenu(menu, which);
+        } else if (pointerOpenedMenus.has(menu) && trigger) {
+          pointerOpenedMenus.delete(menu);
+          suppressPreview = true;
+          trigger.focus({ preventScroll: true, focusVisible: false });
+          suppressPreview = false;
+        }
+      });
+    });
+
+    // Hover follows focus inside menus (with bridge guard and submenu hover delay)
+    menubar.addEventListener('pointermove', event => {
+      if (!canHover.matches) return;
+      const item = event.target.closest('[focusgroup~="menu"] > button, [focusgroup~="menu"] > a[href], [focusgroup~="menu"] > [role="group"] > button, [focusgroup~="menu"] > [role="group"] > a[href]');
+      if (!item || item.disabled || item.getAttribute('aria-disabled') === 'true') return;
+
+      const hit = document.elementFromPoint(event.clientX, event.clientY);
+      if (!hit || !item.contains(hit)) return;
+
+      if (document.activeElement !== item) {
+        clearTimeout(submenuHoverTimer);
+        if (isSubmenuTrigger(item)) {
+          suppressPreview = true;
+          item.focus({ preventScroll: true, focusVisible: false });
+          suppressPreview = false;
+          const submenu = menuFor(item);
+          submenuHoverTimer = setTimeout(() => {
+            if (document.activeElement === item && submenu && !isOpen(submenu)) {
+              openPopover(submenu, item);
+            }
+          }, 120);
+        } else {
+          item.focus({ preventScroll: true, focusVisible: false });
+        }
+      }
+    });
+
+    // Track pointer activation on menu items so restored focus hides ring on pointer commands
+    menubar.addEventListener('pointerdown', event => {
+      const item = event.target.closest('[focusgroup~="menu"] button, [focusgroup~="menu"] a[href]');
+      if (item && !isSubmenuTrigger(item)) {
+        pointerActivatedItem = item;
+      }
+    });
+
+    // Keyboard navigation inside menus and Tab exit across the menubar
+    menubar.addEventListener('keydown', event => {
+      const active = document.activeElement;
+      if (!active || !menubar.contains(active)) return;
+
+      if (event.key === 'Tab') {
+        suppressPreview = true;
+        closeAllMenus();
+        const exitTrigger = event.shiftKey ? rootTriggers[0] : rootTriggers[rootTriggers.length - 1];
+        if (exitTrigger && exitTrigger !== active) {
+          exitTrigger.focus({ preventScroll: true });
+        }
+        suppressPreview = false;
+        return;
+      }
+
+      const currentPopover = active.closest('[popover]');
+      if (!currentPopover) return;
+
+      const rootPopover = active.closest('[role="menubar"] > [popover]');
+      const activeRootTrigger = rootPopover ? triggerFor(rootPopover) : null;
+      const inSubmenu = currentPopover !== rootPopover;
+
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        event.stopPropagation();
+        const parentTrigger = triggerFor(currentPopover);
+        if (parentTrigger) {
+          suppressPreview = true;
+          parentTrigger.focus({ preventScroll: true });
+          suppressPreview = false;
+        }
+        hideMenuQuietly(currentPopover);
+        return;
+      }
+
+      if (event.key === 'ArrowLeft') {
+        event.preventDefault();
+        event.stopPropagation();
+        if (inSubmenu) {
+          const parentTrigger = triggerFor(currentPopover);
+          if (parentTrigger) {
+            suppressPreview = true;
+            parentTrigger.focus({ preventScroll: true });
+            suppressPreview = false;
+          }
+          hideMenuQuietly(currentPopover);
+        } else if (activeRootTrigger) {
+          moveToRootTrigger(activeRootTrigger, -1);
+        }
+        return;
+      }
+
+      if (event.key === 'ArrowRight') {
+        event.preventDefault();
+        event.stopPropagation();
+        if (isSubmenuTrigger(active)) {
+          const submenu = menuFor(active);
+          if (submenu) {
+            if (isOpen(submenu)) {
+              enterMenu(submenu, 'first');
+            } else {
+              enterTargetOnOpen.set(submenu, 'first');
+              active.click();
+            }
+          }
+        } else if (activeRootTrigger) {
+          moveToRootTrigger(activeRootTrigger, 1);
+        }
+        return;
+      }
+
+      // Space on a checkbox toggles and stays open (APG); Enter closes after check-mark delay
+      if (event.key === ' ' && active.getAttribute('role') === 'menuitemcheckbox') {
+        event.preventDefault();
+        const checked = active.getAttribute('aria-checked') === 'true';
+        const nextChecked = !checked;
+        active.setAttribute('aria-checked', String(nextChecked));
+        announce(`${active.textContent.trim()} ${nextChecked ? 'checked' : 'unchecked'}`);
+      }
+    });
+
+    // Item activation (commands, checkboxes, radios, links)
+    menubar.addEventListener('click', event => {
+      const item = event.target.closest('[focusgroup~="menu"] button, [focusgroup~="menu"] a[href]');
+      if (!item || isSubmenuTrigger(item)) return;
+      if (item.disabled || item.getAttribute('aria-disabled') === 'true') {
+        event.preventDefault();
+        return;
+      }
+
+      const viaPointer = pointerActivatedItem === item;
+      pointerActivatedItem = null;
+      const rootPopover = item.closest('[role="menubar"] > [popover]');
+      const rootTrigger = rootPopover ? triggerFor(rootPopover) : null;
+      const role = item.getAttribute('role');
+
+      const finishActivation = () => {
+        if (rootTrigger) {
+          suppressPreview = true;
+          rootTrigger.focus({
+            preventScroll: true,
+            ...(viaPointer ? { focusVisible: false } : {})
+          });
+          suppressPreview = false;
+        }
+        closeAllMenus();
+      };
+
+      if (role === 'menuitemcheckbox') {
+        const nextChecked = item.getAttribute('aria-checked') !== 'true';
+        item.setAttribute('aria-checked', String(nextChecked));
+        announce(`${item.textContent.trim()} ${nextChecked ? 'checked' : 'unchecked'}`);
+        clearTimeout(pendingCheckCloseTimer);
+        pendingCheckCloseTimer = setTimeout(finishActivation, 300);
+        return;
+      }
+
+      if (role === 'menuitemradio') {
+        const group = item.closest('[role="group"]');
+        if (group) {
+          group.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+            radio.setAttribute('aria-checked', String(radio === item));
+          });
+        }
+        announce(`${item.textContent.trim()} selected`);
+        clearTimeout(pendingCheckCloseTimer);
+        pendingCheckCloseTimer = setTimeout(finishActivation, 300);
+        return;
+      }
+
+      if (item.tagName === 'A') {
+        closeAllMenus();
+        return;
+      }
+
+      // Standard menu command button
+      announce(`Activated ${item.textContent.trim()}`);
+      finishActivation();
+    });
+  </script>
+
