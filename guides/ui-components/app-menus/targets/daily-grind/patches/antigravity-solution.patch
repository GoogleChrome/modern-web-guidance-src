+      rootTriggers.forEach(item => { item.tabIndex = item === next ? 0 : -1; });
+      closeAllMenus();
+      // Focusing the trigger previews its menu.
+      next.focus({ preventScroll: true });
+    }
+
+    // If targeting earlier implementations where showPopover({ source }) does not establish an
+    // implicit anchor, link each trigger and menu in JavaScript instead of per-menu CSS rules.
+    if (!('ToggleEvent' in window && Object.hasOwn(ToggleEvent.prototype, 'source'))) {
+      triggers.forEach((trigger, index) => {
+        const anchorName = `--menu-trigger-${index}`;
+        trigger.style.anchorName = anchorName;
+        const menu = menuFor(trigger);
+        if (menu) menu.style.positionAnchor = anchorName;
+      });
+    }
+
+    // Without command invokers, the command attribute does nothing, so a click has to toggle the
+    // popover itself.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      triggers.forEach(trigger => {
+        const menu = menuFor(trigger);
+        if (!menu) return;
+        trigger.addEventListener('click', event => {
+          // Cancel the default action too, so a browser that does support invokers cannot toggle twice.
+          event.preventDefault();
+          const fromPointer = pointerTrigger === trigger;
+          pointerTrigger = null;
+          if (isOpen(menu)) closeAndRestore(menu);
+          else {
+            if (!fromPointer) enterOnOpen.add(menu);
+            menu.showPopover({ source: trigger });
+          }
+        });
+      });
+    }
+
+    rootTriggers.forEach((trigger, index) => {
+      trigger.tabIndex = index === 0 ? 0 : -1;
+    });
+
+    // Focus coming back from another window is not a new intent either: without this guard the
+    // last-used trigger previews its menu every time the user switches back to the app.
+    let returningToWindow = false;
+    window.addEventListener('blur', () => { returningToWindow = true; });
+    window.addEventListener('focus', () => setTimeout(() => { returningToWindow = false; }));
+
+    triggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+      if (!menu) return;
+
+      // Focusing a trigger previews its menu without moving focus. Focus returning from inside
+      // its own menu, or from another window, is not a new intent, so it does not start a preview.
+      let previewTimer;
+      trigger.addEventListener('focus', event => {
+        clearTimeout(previewTimer);
+        if (menu.contains(event.relatedTarget) || returningToWindow || isOpen(menu)) return;
+        if (trigger.closest('[popover]') && !trigger.matches(':focus-visible')) {
+          previewTimer = setTimeout(() => menu.showPopover({ source: trigger }), 80);
+        } else {
+          menu.showPopover({ source: trigger });
+        }
+      });
+
+      // Leaving a trigger that is only previewing closes that preview.
+      trigger.addEventListener('blur', event => {
+        clearTimeout(previewTimer);
+        if (isPreviewed(menu) && !menu.contains(event.relatedTarget)) menu.hidePopover();
+      });
+
+      // Keep focus where it is on mousedown, so a click cannot start a preview mid-click.
+      trigger.addEventListener('pointerdown', event => {
+        event.preventDefault();
+        pointerTrigger = trigger;
+      });
+
+      trigger.addEventListener('pointerleave', event => {
+        if (trigger.closest('[popover]')) startBridge(menu, event);
+      });
+
+      // Tab leaves the menu system rather than moving into the previewed menu that follows the trigger.
+      trigger.addEventListener('keydown', event => {
+        if (event.key === 'Tab') closeAllMenus();
+      });
+    });
+
+    rootTriggers.forEach(trigger => {
+      const menu = menuFor(trigger);
+      if (!menu) return;
+
+      // Hover switches between top-level menus once one is open. Focusing the hovered trigger
+      // (without a ring) runs the same preview-on-focus as keyboard. Nothing open: do nothing.
+      trigger.addEventListener('pointerenter', () => {
+        const open = rootTriggers.map(menuFor).find(isOpen);
+        if (!open || open === menu) return;
+        open.hidePopover();
+        trigger.focus({ preventScroll: true, focusVisible: false });
+      });
+
+      trigger.addEventListener('keydown', event => {
+        if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+          event.preventDefault();
+          moveToRootTrigger(trigger, event.key === 'ArrowRight' ? 1 : -1);
+        } else if (event.key === 'ArrowDown') {
+          event.preventDefault();
+          if (isOpen(menu)) focusFirst(menu);
+          else {
+            enterOnOpen.add(menu);
+            trigger.click(); // One entry point for every intentional open.
+          }
+        } else if (event.key === 'Home' || event.key === 'End') {
+          // Enter the previewed menu at its first or last item instead of scrolling the page.
+          event.preventDefault();
+          if (!isOpen(menu)) menu.showPopover({ source: trigger });
+          const items = menuItems(menu);
+          (event.key === 'Home' ? items[0] : items.at(-1))?.focus({ preventScroll: true });
+        }
+      });
+    });
+
+    menus.forEach(menu => {
+      // The command event fires on the popover, before toggle-popover runs. It only decides whether
+      // a keyboard open should enter the menu; every activation opens or closes natively.
+      menu.addEventListener('command', event => {
+        if (event.command !== 'toggle-popover') return;
+        const fromPointer = pointerTrigger === event.source;
+        pointerTrigger = null;
+        if (!isOpen(menu)) {
+          // Only a keyboard open enters the menu. A pointer open leaves focus on the trigger, and a
+          // pointer click on an open menu's trigger closes it natively.
+          if (!fromPointer) enterOnOpen.add(menu);
+        } else {
+          event.source?.focus({ preventScroll: true });
+        }
+      });
+
+      menu.addEventListener('toggle', event => {
+        const trigger = triggerFor(menu);
+        trigger?.setAttribute('aria-expanded', String(event.newState === 'open'));
+        if (event.newState !== 'open') return;
+        if (!supportsAnchors && trigger) placeFallback(menu, trigger);
+        if (enterOnOpen.delete(menu)) focusFirst(menu);
+        // Pointer open: keep focus on the trigger (no ring) so arrow keys work. The menu is already
+        // open, so the trigger's focus listener does not start a second preview.
+        else if (!menu.contains(document.activeElement)) trigger?.focus({ preventScroll: true, focusVisible: false });
+      });
+
+      // Hover follows focus: the pointed-at item takes focus without a ring, so hover and focus
+      // are one item. The safe-triangle bridge (CSS) keeps sibling items from receiving the
+      // pointer while it travels toward an open submenu.
+      menu.addEventListener('pointermove', event => {
+        const item = event.target.closest('button');
+        if (!item || item.closest('[popover]') !== menu || item === document.activeElement) return;
+        // The target can be stale: the move that leaves a submenu trigger is hit-tested before the
+        // bridge exists, so check what is under the pointer now.
+        if (!item.contains(document.elementFromPoint(event.clientX, event.clientY))) return;
+        item.focus({ preventScroll: true, focusVisible: false });
+      });
+
+      // Focus landing on any other item in this menu closes its open submenus, including ones that
+      // were entered (focus inside them), where no trigger blur would fire.
+      menu.addEventListener('focusin', event => {
+        menu.querySelectorAll(':scope [popover]:is(:popover-open, .\\:popover-open)').forEach(submenu => {
+          if (!submenu.contains(event.target) && triggerFor(submenu) !== event.target) submenu.hidePopover();
+        });
+      });
+
+      menu.addEventListener('keydown', event => {
+        lastKey = event.key;
+        const active = document.activeElement;
+        const parentMenu = menu.parentElement?.closest('[popover]');
+        const activeSubmenu = active?.matches('[commandfor]') ? menuFor(active) : null;
+        if (event.key === 'Tab') {
+          // Leave the menu system: close everything, then let Tab continue from the trigger.
+          closeAllMenus();
+        } else if ((event.key === 'Home' || event.key === 'End') && menuItems(menu).includes(active)) {
+          // Home and End move to the first and last enabled item in this level.
+          event.preventDefault();
+          const items = menuItems(menu);
+          (event.key === 'Home' ? items[0] : items.at(-1))?.focus({ preventScroll: true });
+        } else if (event.key === 'ArrowRight' && activeSubmenu) {
+          event.preventDefault();
+          event.stopPropagation();
+          if (isOpen(activeSubmenu)) focusFirst(activeSubmenu);
+          else {
+            enterOnOpen.add(activeSubmenu);
+            active.click();
+          }
+        } else if (event.key === 'ArrowRight' && parentMenu) {
+          // APG: from a submenu item without a submenu, move to the next menubar item.
+          // Keep focus on its trigger while previewing; explicit activation enters its menu.
+          event.preventDefault();
+          event.stopPropagation();
+          moveToRootTrigger(triggerFor(rootMenuOf(menu)), 1);
+        } else if ((event.key === 'ArrowLeft' && parentMenu) || event.key === 'Escape') {
+          // Close only this level; the parent menu stays open.
+          event.preventDefault();
+          event.stopPropagation();
+          closeAndRestore(menu);
+        } else if ((event.key === 'ArrowLeft' || event.key === 'ArrowRight') && !parentMenu) {
+          event.preventDefault();
+          event.stopPropagation();
+          // Switch to the adjacent top-level menu as a preview; ArrowDown enters it.
+          moveToRootTrigger(triggerFor(menu), event.key === 'ArrowRight' ? 1 : -1);
+        }
+      });
+
+      // Commands activate on click, whether from pointer, Enter, or Space.
+      // Submenu triggers are invokers, so their click toggles the submenu natively.
+      menu.addEventListener('click', event => {
+        const item = event.target.closest('button');
+        if (!item || item.matches('[commandfor]') || item.closest('[popover]') !== menu) return;
+        event.stopPropagation();
+        const role = item.getAttribute('role');
+        if (role === 'menuitemcheckbox') {
+          const checked = item.getAttribute('aria-checked') !== 'true';
+          item.setAttribute('aria-checked', String(checked));
+          if (status) status.textContent = `${item.textContent.trim()} ${checked ? 'on' : 'off'}`;
+          // APG: Space toggles and keeps the menu open; Enter (or pointer) toggles and closes.
+          if (lastKey === ' ') { lastKey = null; return; }
+        } else if (role === 'menuitemradio') {
+          item.closest('[role="group"]')?.querySelectorAll('[role="menuitemradio"]')
+            .forEach(radio => radio.setAttribute('aria-checked', String(radio === item)));
+          if (status) status.textContent = `${item.textContent.trim()} selected`;
+        } else {
+          if (status) status.textContent = `${item.textContent.trim()} selected`;
+        }
+        lastKey = null;
+        // A keyboard-initiated click has detail 0.
+        const root = rootMenuOf(menu);
+        const fromPointer = event.detail > 0;
+        // Selecting a checkable item changes its check mark: hold the menu open briefly so it is seen.
+        if (role === 'menuitemcheckbox' || role === 'menuitemradio') {
+          setTimeout(() => { if (isOpen(root)) closeAndRestore(root, { fromPointer }); }, 300);
+        } else {
+          closeAndRestore(root, { fromPointer });
+        }
+      });
+    });
+
+    // Tab leaves the menu system: once focus lands on page content, close every open menu.
+    document.addEventListener('focusin', event => {
+      if (!event.target.closest('[popover], [role="menubar"]')) closeAllMenus();
+    });
+  </script>
 </body>
 
