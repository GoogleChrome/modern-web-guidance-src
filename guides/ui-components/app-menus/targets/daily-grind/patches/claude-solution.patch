+        if (!items.includes(document.activeElement)) return;
+        event.preventDefault();
+        items[event.key === 'Home' ? 0 : items.length - 1].focus({ preventScroll: true });
+      });
+
+      menu.addEventListener('keydown', event => {
+        if (event.defaultPrevented) return;
+        const closeLevel = () => {
+          event.preventDefault();
+          event.stopPropagation();
+          // Restore focus before hiding: HTML does not restore it for nested popovers.
+          trigger.focus({ preventScroll: true });
+          hide(menu);
+        };
+        switch (event.key) {
+          case 'Escape':
+            closeLevel();
+            break;
+          case 'ArrowLeft':
+            if (root) {
+              event.preventDefault();
+              moveToRootTrigger(trigger, -1);
+            } else {
+              closeLevel();
+            }
+            break;
+          case 'ArrowRight':
+            // Unhandled ArrowRight in a submenu bubbles up to the top-level menu.
+            if (root) {
+              event.preventDefault();
+              moveToRootTrigger(trigger, 1);
+            }
+            break;
+        }
+      });
+
+      // Hover follows focus.
+      itemsOf(group).forEach(item => {
+        item.addEventListener('pointermove', event => {
+          if (event.pointerType === 'touch' || document.activeElement === item) return;
+          // The move that leaves a submenu trigger was hit-tested before the bridge existed.
+          if (!item.contains(document.elementFromPoint(event.clientX, event.clientY))) return;
+          pointerFocus = true;
+          item.focus({ preventScroll: true });
+          pointerFocus = false;
+        });
+      });
+    });
+
+    // Command activation: links navigate; close the menus and restore focus to the bar.
+    menubar.addEventListener('click', event => {
+      const item = event.target.closest('[focusgroup] a[href], [focusgroup] button:not([commandfor])');
+      if (!item) return;
+      const rootMenu = item.closest('[role="menubar"] > [popover]');
+      const fromPointer = event.detail > 0;
+      triggerFor(rootMenu).focus(fromPointer ? { focusVisible: false, preventScroll: true } : { preventScroll: true });
+      hide(rootMenu);
+    });
+
+    // Tab leaves the bar and closes every menu.
+    menubar.addEventListener('keydown', event => {
+      if (event.key !== 'Tab' || event.defaultPrevented) return;
+      const target = tabbableOutside(event.shiftKey);
+      if (target) {
+        event.preventDefault();
+        target.focus();
+      } else {
+        closeAll();
+      }
+    });
+
+    // Focus outside the bar (the bar and its menus are one system) closes every menu.
+    document.addEventListener('focusin', event => {
+      if (!menubar.contains(event.target)) closeAll();
+    });
+
+    document.addEventListener('pointerdown', event => {
+      pointerTrigger = triggers.find(trigger => trigger.contains(event.target)) ?? null;
+    }, true);
+    document.addEventListener('keydown', () => { pointerTrigger = null; }, true);
+
+    // App switching must not reopen the last menu.
+    window.addEventListener('blur', event => {
+      if (event.target === window) windowBlurred = true;
+    });
+    window.addEventListener('focus', event => {
+      if (event.target === window) setTimeout(() => { windowBlurred = false; });
+    });
+
+    // --- Safe triangle ----------------------------------------------------
+
+    function startBridge(submenu, event) {
+      if (!canHover.matches || !isOpen(submenu)) return;
+      const rect = submenu.getBoundingClientRect();
+      const left = event.clientX < rect.left;
+      if (!left && event.clientX <= rect.right) return; // --below: no side edge.
+      submenu.style.setProperty('--pointer-x', `${event.clientX - rect.left}px`);
+      submenu.style.setProperty('--pointer-y', `${event.clientY - rect.top}px`);
+      submenu.dataset.bridge = '';
+      let timer;
+      let lastX = event.clientX;
+      const stop = () => {
+        clearTimeout(timer);
+        submenu.removeEventListener('pointermove', extend);
+        submenu.removeAttribute('data-bridge');
+      };
+      const extend = ({ target, clientX }) => {
+        // Reached an item, or turned away from the submenu.
+        if (target !== submenu || (left ? clientX < lastX : clientX > lastX)) return stop();
+        lastX = clientX;
+        clearTimeout(timer);
+        timer = setTimeout(stop, 300);
+      };
+      timer = setTimeout(stop, 300);
+      submenu.addEventListener('pointermove', extend);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+  </script>
+
 </body>
 
