+    menubar.addEventListener('pointermove', event => {
+      const item = event.target.closest?.(ITEM_SELECTOR);
+      if (!item || !item.closest('[popover]')) return;
+      if (document.activeElement !== item) item.focus({ preventScroll: true, focusVisible: false });
+      if (hoverItem === item) return;
+      hoverItem = item;
+      clearTimeout(hoverTimer);
+      if (!item.hasAttribute('commandfor')) return;
+      const submenu = menuFor(item);
+      hoverTimer = setTimeout(() => {
+        if (hoverItem === item && document.activeElement === item && !isOpen(submenu) &&
+          isOpen(item.closest('[popover]'))) {
+          openMenu(submenu, item);
+        }
+      }, 200);
+    });
+    menubar.addEventListener('pointerleave', () => {
+      hoverItem = null;
+      clearTimeout(hoverTimer);
+    });
+
+    // Safe triangle: report the pointer so CSS can bridge to the submenu.
+    function startBridge(submenu, event) {
+      if (!supportsBridge || !canHover.matches || !isOpen(submenu)) return;
+      const rect = submenu.getBoundingClientRect();
+      if (event.clientX >= rect.left && event.clientX <= rect.right) return; // --below: no side edge.
+      const style = submenu.style;
+      style.setProperty('--bridge-edge', `${event.clientX < rect.left ? 0 : rect.width}px`);
+      style.setProperty('--bridge-height', `${rect.height}px`);
+      const update = ({ clientX, clientY, target }) => {
+        if (target !== submenu && submenu.contains(target)) return stop(); // Reached an item.
+        style.setProperty('--bridge-x', `${clientX - rect.left}px`);
+        style.setProperty('--bridge-y', `${clientY - rect.top}px`);
+      };
+      const timer = setTimeout(() => stop(), 300);
+      const stop = () => {
+        clearTimeout(timer);
+        document.removeEventListener('pointermove', update);
+        submenu.removeEventListener('toggle', stop);
+        submenu.removeAttribute('data-bridge');
+      };
+      update(event);
+      submenu.dataset.bridge = '';
+      document.addEventListener('pointermove', update);
+      submenu.addEventListener('toggle', stop, { once: true });
+    }
+
+    triggers.filter(trigger => !rootTriggers.includes(trigger)).forEach(trigger => {
+      trigger.addEventListener('pointerleave', event => startBridge(menuFor(trigger), event));
+    });
+
+    // Focusgroup fallback: never installed when native focusgroup is present.
+    if (!('focusGroup' in HTMLElement.prototype)) {
+      document.querySelectorAll('[focusgroup~="menu"]').forEach(group => {
+        group.setAttribute('role', 'menu');
+        group.querySelectorAll(`${ITEM_SELECTOR}`).forEach(item => {
+          if (!item.hasAttribute('role')) item.setAttribute('role', 'menuitem');
+        });
+        group.addEventListener('keydown', event => {
+          if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
+          // Own items only: a nested submenu has its own focusgroup, a role="group" wrapper does not.
+          const items = [...group.querySelectorAll(ITEM_SELECTOR)]
+            .filter(item => item.closest('[focusgroup]') === group)
+            .filter(item => !item.disabled && item.getAttribute('aria-disabled') !== 'true');
+          const current = items.indexOf(document.activeElement);
+          if (current < 0) return;
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 :
+            (current + (event.key === 'ArrowUp' ? -1 : 1) + items.length) % items.length;
+          event.preventDefault();
+          event.stopImmediatePropagation();
+          items[next].focus({ preventScroll: true });
+        }, true);
+      });
+    }
+  </script>
