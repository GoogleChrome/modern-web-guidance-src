+// @ts-check
+(() => {
+  const bar = document.querySelector('[role="menubar"]');
+  if (!(bar instanceof HTMLElement)) return;
+  const triggers = Array.from(bar.querySelectorAll(':scope > button'))
+    .filter((element) => element instanceof HTMLButtonElement);
+  const nativePopover = 'popover' in HTMLElement.prototype;
+  const nativeInvoker = 'commandForElement' in HTMLButtonElement.prototype;
+  const nativeGroup = 'focusGroup' in HTMLElement.prototype;
+  const anchored = CSS.supports('position-area: block-end');
+  let suppressPreview = false;
+  let windowInactive = false;
+  const enterOnOpen = new WeakSet();
+
+  /** @param {HTMLButtonElement} trigger */
+  function menuFor(trigger) {
+    const menu = document.getElementById(trigger.getAttribute('commandfor') || '');
+    if (!(menu instanceof HTMLElement)) throw new Error('Missing application menu');
+    return menu;
+  }
+  /** @param {HTMLElement} menu */
+  function isOpen(menu) {
+    return nativePopover ? menu.matches(':popover-open') : menu.hasAttribute('data-fallback-open');
+  }
+  /** @param {HTMLElement} menu */
+  function items(menu) {
+    return Array.from(menu.querySelectorAll('a[href]'))
+      .filter(item => item instanceof HTMLAnchorElement)
+      .filter(item => item.getAttribute('aria-disabled') !== 'true');
+  }
+  /** @param {HTMLButtonElement} trigger */
+  function position(trigger) {
+    const menu = menuFor(trigger);
+    if (anchored && nativePopover) return;
+    const rect = trigger.getBoundingClientRect();
+    const bounds = menu.getBoundingClientRect();
+    const left = Math.max(8, Math.min(rect.left, innerWidth - bounds.width - 8));
+    const top = Math.max(8, Math.min(rect.bottom, innerHeight - bounds.height - 8));
+    menu.style.setProperty('--menu-left', `${left}px`);
+    menu.style.setProperty('--menu-top', `${top}px`);
+    if (!nativePopover) {
+      menu.style.left = `${left}px`;
+      menu.style.top = `${top}px`;
+    }
+  }
+  function closeAll() {
+    for (const trigger of triggers) {
+      const menu = menuFor(trigger);
+      if (!isOpen(menu)) continue;
+      if (nativePopover) menu.hidePopover();
+      else {
+        menu.removeAttribute('data-fallback-open');
+        menu.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+      }
+    }
+  }
+  /** @param {HTMLButtonElement} trigger */
+  function show(trigger) {
+    const menu = menuFor(trigger);
+    if (isOpen(menu)) return;
+    closeAll();
+    if (nativePopover) {
+      // Older DOM typings omit the progressively enhanced source option.
+      const showPopover = /** @type {(options: {source: HTMLElement}) => void} */ (menu.showPopover.bind(menu));
+      showPopover({ source: trigger });
+    }
+    else {
+      menu.hidden = false;
+      menu.setAttribute('data-fallback-open', '');
+      trigger.setAttribute('aria-expanded', 'true');
+    }
+    position(trigger);
+  }
+  /** @param {HTMLButtonElement} trigger @param {boolean} [pointer] */
+  function restore(trigger, pointer = false) {
+    suppressPreview = true;
+    trigger.focus({ preventScroll: true, ... (pointer ? { focusVisible: false } : {}) });
+    closeAll();
+    suppressPreview = false;
+  }
+  /** @param {HTMLButtonElement} trigger @param {number} direction @param {boolean} [pointer] */
+  function move(trigger, direction, pointer = false) {
+    const next = triggers[(triggers.indexOf(trigger) + direction + triggers.length) % triggers.length];
+    closeAll();
+    // Pointer switching retains the keyboard entry point.
+    if (!pointer) triggers.forEach(button => { button.tabIndex = button === next ? 0 : -1; });
+    next.focus({ preventScroll: true, ...(pointer ? { focusVisible: false } : {}) });
+    show(next);
+  }
+
+  for (const trigger of triggers) {
+    const menu = menuFor(trigger);
+    const group = menu.querySelector('[focusgroup]');
+    if (!nativePopover) menu.hidden = true;
+    if (anchored && (!('ToggleEvent' in window) || !('source' in ToggleEvent.prototype))) {
+      trigger.style.setProperty('anchor-name', `--${trigger.id}`);
+      menu.style.setProperty('position-anchor', `--${trigger.id}`);
+    }
+    if (!nativeGroup) {
+      group?.setAttribute('role', 'menu');
+      items(menu).forEach(item => item.setAttribute('role', 'menuitem'));
+    }
+    menu.addEventListener('toggle', () => {
+      trigger.setAttribute('aria-expanded', String(isOpen(menu)));
+      if (isOpen(menu)) {
+        position(trigger);
+        if (enterOnOpen.has(menu)) {
+          enterOnOpen.delete(menu);
+          items(menu)[0]?.focus({ preventScroll: true });
+        }
+      } else enterOnOpen.delete(menu);
+    });
+    trigger.addEventListener('focus', event => {
+      if (!suppressPreview && !windowInactive &&
+          !(event.relatedTarget instanceof Node && menu.contains(event.relatedTarget))) show(trigger);
+    });
+    trigger.addEventListener('blur', event => {
+      if (!(event.relatedTarget instanceof Node && menu.contains(event.relatedTarget))) closeAll();
+    });
+    trigger.addEventListener('pointerdown', event => {
+      if (event.button === 0) event.preventDefault();
+    });
+    trigger.addEventListener('pointerenter', event => {
+      if (event.pointerType === 'touch' || isOpen(menu)) return;
+      if (triggers.some(button => isOpen(menuFor(button)))) {
+        move(trigger, 0, true);
+      }
+    });
+    trigger.addEventListener('click', event => {
+      const pointer = event.detail > 0;
+      if (!nativeInvoker || !nativePopover) {
+        event.preventDefault();
+        if (isOpen(menu)) restore(trigger, pointer);
+        else {
+          show(trigger);
+          if (pointer) {
+            suppressPreview = true;
+            trigger.focus({ preventScroll: true });
+            suppressPreview = false;
+          } else items(menu)[0]?.focus({ preventScroll: true });
+        }
+      } else if (pointer) {
+        // Focus without starting a preview before the native toggle action.
+        suppressPreview = true;
+        trigger.focus({ preventScroll: true });
+        suppressPreview = false;
+      } else if (!isOpen(menu)) {
+        enterOnOpen.add(menu);
+      }
+    });
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+        event.preventDefault();
+        move(trigger, event.key === 'ArrowRight' ? 1 : -1);
+      } else if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        if (!isOpen(menu)) trigger.click();
+        enterOnOpen.delete(menu);
+        const options = items(menu);
+        options[event.key === 'End' || event.key === 'ArrowUp' ? options.length - 1 : 0]?.focus({ preventScroll: true });
+      } else if (event.key === 'Escape') {
+        event.preventDefault();
+        restore(trigger);
+      }
+    });
+    menu.addEventListener('keydown', event => {
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        event.stopPropagation();
+        restore(trigger);
+      } else if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
+        event.preventDefault();
+        move(trigger, event.key === 'ArrowRight' ? 1 : -1);
+      } else if (!nativeGroup && ['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        const options = items(menu);
+        const index = options.findIndex(item => item === document.activeElement);
+        const next = event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1 :
+          (index + (event.key === 'ArrowUp' ? -1 : 1) + options.length) % options.length;
+        options[next]?.focus({ preventScroll: true });
+      }
+    });
+    items(menu).forEach(item => {
+      item.addEventListener('pointermove', event => {
+        if (event.pointerType !== 'touch') item.focus({ preventScroll: true });
+      });
+      item.addEventListener('click', event => restore(trigger, event.detail > 0));
+    });
+  }
+  bar.addEventListener('keydown', event => {
+    if (event.key !== 'Tab') return;
+    // Move the sequential focus origin out of the popup before native Tab navigation.
+    if (bar.contains(document.activeElement)) {
+      suppressPreview = true;
+      const entry = triggers.find(trigger => trigger.tabIndex === 0);
+      entry?.focus({ preventScroll: true });
+      suppressPreview = false;
+    }
+    closeAll();
+  });
+  document.addEventListener('focusin', event => {
+    if (event.target instanceof Node && !bar.contains(event.target)) closeAll();
+  });
+  document.addEventListener('pointerdown', event => {
+    if (event.target instanceof Node && !bar.contains(event.target)) closeAll();
+  });
+  window.addEventListener('blur', () => { windowInactive = true; closeAll(); });
+  window.addEventListener('focus', () => { setTimeout(() => { windowInactive = false; }, 0); });
+  const reposition = () => triggers.forEach(trigger => { if (isOpen(menuFor(trigger))) position(trigger); });
+  window.addEventListener('resize', reposition);
+  window.addEventListener('scroll', reposition, true);
+})();
