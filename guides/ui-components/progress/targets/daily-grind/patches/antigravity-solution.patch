+  <script>
+    (function () {
+      const rewardProgress = document.getElementById('reward-progress');
+      const rewardStatus = document.getElementById('reward-status');
+      const addBeansBtn = document.getElementById('add-beans-btn');
+      const syncRewardBtn = document.getElementById('sync-reward-btn');
+      const resetRewardBtn = document.getElementById('reset-reward-btn');
+
+      addBeansBtn.addEventListener('click', () => {
+        const current = rewardProgress.hasAttribute('value') ? Number(rewardProgress.value) : 75;
+        const next = Math.min(100, current + 25);
+        rewardProgress.value = next;
+        rewardStatus.textContent = next === 100
+          ? '100 / 100 Beans — Free Drink Unlocked!'
+          : `${next} / 100 Beans`;
+      });
+
+      syncRewardBtn.addEventListener('click', () => {
+        rewardProgress.removeAttribute('value');
+        rewardStatus.textContent = 'Syncing reward balance...';
+      });
+
+      resetRewardBtn.addEventListener('click', () => {
+        rewardProgress.value = 75;
+        rewardStatus.textContent = '75 / 100 Beans';
+      });
+
+      const orderProgress = document.getElementById('order-progress');
+      const orderStatus = document.getElementById('order-status');
+      const orderIndeterminateBtn = document.getElementById('order-indeterminate-btn');
+      const orderBrewingBtn = document.getElementById('order-brewing-btn');
+      const orderReadyBtn = document.getElementById('order-ready-btn');
+
+      orderIndeterminateBtn.addEventListener('click', () => {
+        orderProgress.removeAttribute('value');
+        orderStatus.textContent = 'Assigning barista...';
+      });
+
+      orderBrewingBtn.addEventListener('click', () => {
+        orderProgress.value = 60;
+        orderStatus.textContent = 'Brewing espresso (60%)';
+      });
+
+      orderReadyBtn.addEventListener('click', () => {
+        orderProgress.value = 100;
+        orderStatus.textContent = 'Order complete — Ready for pickup!';
+      });
+    })();
+  </script>
