+  <script>
+    (() => {
+      const menuSection = document.getElementById('coffee-menu');
+      if (!menuSection) return;
+
+      const tablist = menuSection.querySelector('[focusgroup~="tablist"]');
+      const tabs = Array.from(tablist.querySelectorAll('button'));
+      const panels = Array.from(menuSection.querySelectorAll('[role="tabpanel"]'));
+
+      function selectTab(selected) {
+        if (!selected) return;
+
+        for (const tab of tabs) {
+          const isSelected = tab === selected;
+          tab.ariaSelected = String(isSelected);
+          tab.toggleAttribute('focusgroupstart', isSelected);
+        }
+
+        for (const panel of panels) {
+          const isSelected = panel.getAttribute('aria-labelledby') === selected.id;
+          if (isSelected) {
+            panel.hidden = false;
+            panel.setAttribute('tabindex', '0');
+          } else {
+            panel.hidden = 'until-found';
+            panel.removeAttribute('tabindex');
+          }
+        }
+
+        selected.scrollIntoView({
+          block: 'nearest',
+          inline: 'nearest',
+          container: 'nearest',
+        });
+      }
+
+      for (const tab of tabs) {
+        tab.addEventListener('focus', () => selectTab(tab));
+        tab.addEventListener('click', () => selectTab(tab));
+      }
+
+      for (const panel of panels) {
+        panel.addEventListener('beforematch', () => {
+          const tabId = panel.getAttribute('aria-labelledby');
+          const associatedTab = tabs.find((tab) => tab.id === tabId);
+          if (associatedTab) {
+            selectTab(associatedTab);
+          }
+        });
+      }
+
+      // Fallback arrow-key navigation when native focusgroup is not supported
+      if (!('focusgroup' in HTMLElement.prototype)) {
+        tablist.addEventListener('keydown', (event) => {
+          const currentIndex = tabs.indexOf(document.activeElement);
+          if (currentIndex === -1) return;
+
+          let nextIndex = -1;
+          if (event.key === 'ArrowRight') {
+            nextIndex = (currentIndex + 1) % tabs.length;
+          } else if (event.key === 'ArrowLeft') {
+            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
+          } else if (event.key === 'Home') {
+            nextIndex = 0;
+          } else if (event.key === 'End') {
+            nextIndex = tabs.length - 1;
+          }
+
+          if (nextIndex !== -1) {
+            event.preventDefault();
+            tabs[nextIndex].focus();
+          }
+        });
+      }
+    })();
+  </script>
+
