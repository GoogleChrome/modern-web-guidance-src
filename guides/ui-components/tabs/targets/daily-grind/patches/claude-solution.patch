+    .tablist {
+      display: flex;
+      overflow-x: auto;
+      scrollbar-width: none;
+      overscroll-behavior-inline: contain;
+      border-block-end: 1px solid var(--secondary);
+      scroll-snap-type: inline proximity;
+      /* How far each edge fade reaches */
+      --fade-size: 3rem;
