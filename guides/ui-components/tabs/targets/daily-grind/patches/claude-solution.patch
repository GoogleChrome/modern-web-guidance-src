+  <script type="module">
+    // Load the focusgroup polyfill only when native support is missing.
+    if (!Object.hasOwn(HTMLElement.prototype, 'focusGroup')) {
+      try {
+        const { polyfill } = await import('https://esm.sh/@microsoft/focusgroup-polyfill');
+        polyfill();
+      } catch (error) {
+        console.warn('focusgroup polyfill failed to load', error);
+      }
+    }
+
+    const menu = document.getElementById('coffee-menu');
+    const tablist = menu.querySelector('.tablist');
+    const tabs = Array.from(tablist.querySelectorAll(':scope > button'));
+    const panels = Array.from(menu.querySelectorAll('[role="tabpanel"]'));
+
+    const panelFor = tab => panels.find(panel => panel.getAttribute('aria-labelledby') === tab.id);
+    const tabFor = panel => tabs.find(tab => tab.id === panel.getAttribute('aria-labelledby'));
+
+    function select(selected) {
+      if (!selected || selected.getAttribute('aria-selected') === 'true') return;
+      for (const tab of tabs) {
+        const isSelected = tab === selected;
+        tab.setAttribute('aria-selected', String(isSelected));
+        tab.toggleAttribute('focusgroupstart', isSelected);
+        const panel = panelFor(tab);
+        if (panel) panel.hidden = isSelected ? false : 'until-found';
+      }
+      // Scroll only the tablist so the selected tab (and part of its neighbor) is visible.
+      selected.scrollIntoView({ block: 'nearest', inline: 'nearest', container: 'nearest' });
+    }
+
+    // Selection follows focus (arrow keys via focusgroup), plus pointer activation.
+    tablist.addEventListener('focusin', event => {
+      if (tabs.includes(event.target)) select(event.target);
+    });
+    tablist.addEventListener('click', event => {
+      const tab = event.target.closest('button');
+      if (tab && tabs.includes(tab)) select(tab);
+    });
+
+    // Keep tab state in sync when find-in-page reveals a hidden panel.
+    for (const panel of panels) {
+      panel.addEventListener('beforematch', () => select(tabFor(panel)));
+    }
+
+    // Edge-fade fallback for browsers without scroll-driven animations.
+    if (!CSS.supports('animation-timeline', 'scroll()')) {
+      const [first, last] = [tabs[0], tabs[tabs.length - 1]];
+      const observer = new IntersectionObserver(entries => {
+        for (const { target, intersectionRatio } of entries) {
+          tablist.classList.toggle(target === first ? 'more-start' : 'more-end', intersectionRatio < 1);
+        }
+      }, { root: tablist, threshold: 1, rootMargin: '1px' });
+      observer.observe(first);
+      observer.observe(last);
+    }
+  </script>
