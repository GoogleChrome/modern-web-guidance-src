+    /* Tabs */
+    @property --fade-start { syntax: '<length>'; inherits: false; initial-value: 0px; }
+    @property --fade-end { syntax: '<length>'; inherits: false; initial-value: 0px; }
+
+    @keyframes scroll-fade {
+      0% { --fade-start: 0px; }
+      5%, 95% { --fade-start: 2.5rem; --fade-end: 2.5rem; }
+      100% { --fade-start: 2.5rem; --fade-end: 0px; }
+    }
+
+    .tablist {
+      display: flex;
+      overflow-x: auto;
+      scrollbar-width: none;
+      scroll-snap-type: inline proximity;
+      border-block-end: 1px solid var(--secondary);
+      margin-top: 20px;
+      --fade-start: 0px;
+      --fade-end: 0px;
+      mask-image: linear-gradient(to right, transparent, #000 var(--fade-start), #000 calc(100% - var(--fade-end)), transparent);
+      animation: scroll-fade linear both;
+      animation-timeline: scroll(self inline);
+    }
+
+    .tablist::-webkit-scrollbar { display: none; }
+
+    .tablist > [aria-selected] {
+      flex: none;
+      scroll-snap-align: start;
+      position: relative;
+      background: none;
+      border: 0;
+      font: inherit;
+      color: var(--text);
+      padding: 12px 18px;
+      cursor: pointer;
+      white-space: nowrap;
+    }
+
+    .tablist > [aria-selected]:hover { color: var(--primary); }
+
+    .tablist > [aria-selected="true"] {
+      color: var(--primary);
+      font-weight: 600;
+    }
+
+    .tablist > [aria-selected="true"]::after {
+      content: "";
+      position: absolute;
+      inset: auto 0 0;
+      border-block-end: 3px solid var(--accent);
+    }
+
+    .tablist > [aria-selected]:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: -4px;
+    }
+
+    .panels { display: grid; }
+    .panels > [role="tabpanel"] { grid-area: 1 / 1; min-width: 0; }
+    .panels > [role="tabpanel"] > .grid { margin-top: 20px; }
+
     footer {
       background: var(--secondary);
       text-align: center;
