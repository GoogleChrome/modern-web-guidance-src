+    <script type="module">
+    const menuTablist = document.querySelector(".menu-tabs");
+    if (!menuTablist) throw new Error("Coffee menu tablist is missing.");
+    const tablist = menuTablist;
+    const tabs = Array.from(tablist.querySelectorAll("[role=\"tab\"]"));
+    const panels = Array.from(document.querySelectorAll(".menu-panels [role=\"tabpanel\"]"));
+    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
+
+    // Detect the container option without scrolling any part of the document.
+    let supportsScrollContainer = false;
+    const probeOptions = {
+      get container() {
+        supportsScrollContainer = true;
+        return "nearest";
+      },
+    };
+    document.createElement("div").scrollIntoView(probeOptions);
+
+    function revealTab(tab) {
+      const behavior = reducedMotion.matches ? "instant" : "smooth";
+      if (supportsScrollContainer) {
+        const options = { block: "nearest", inline: "nearest", container: "nearest", behavior };
+        tab.scrollIntoView(options);
+      } else {
+        const listBounds = tablist.getBoundingClientRect();
+        const tabBounds = tab.getBoundingClientRect();
+        const padding = parseFloat(getComputedStyle(tablist).scrollPaddingInlineStart) || 0;
+        const left = tabBounds.left - listBounds.left - padding;
+        const right = tabBounds.right - listBounds.right + padding;
+        const delta = left < 0 ? left : right > 0 ? right : 0;
+        tablist.scrollBy({ left: delta, behavior });
+      }
+    }
+
+    function selectTab(selected) {
+      for (const tab of tabs) {
+        const active = tab === selected;
+        tab.setAttribute("aria-selected", String(active));
+        tab.toggleAttribute("focusgroupstart", active);
+      }
+      for (const panel of panels) {
+        if (panel.getAttribute("aria-labelledby") === selected.id) {
+          panel.removeAttribute("hidden");
+        } else {
+          panel.setAttribute("hidden", "until-found");
+        }
+      }
+      revealTab(selected);
+    }
+
+    for (const tab of tabs) {
+      tab.addEventListener("focus", () => selectTab(tab));
+      tab.addEventListener("click", () => selectTab(tab));
+    }
+
+    for (const panel of panels) {
+      panel.addEventListener("beforematch", () => {
+        const tab = tabs.find(tab => tab.id === panel.getAttribute("aria-labelledby"));
+        if (tab) selectTab(tab);
+      });
+    }
+
+    // Keep overflow hints usable on browsers without scroll-driven animations.
+    if (!CSS.supports("animation-timeline", "scroll(self inline)")) {
+      const first = tabs[0];
+      const last = tabs[tabs.length - 1];
+      const observer = new IntersectionObserver(entries => {
+        for (const entry of entries) {
+          tablist.classList.toggle(entry.target === first ? "more-start" : "more-end", entry.intersectionRatio < 1);
+        }
+      }, { root: tablist, threshold: 1, rootMargin: "1px" });
+      observer.observe(first);
+      observer.observe(last);
+    }
+
+    if (!Object.hasOwn(HTMLElement.prototype, "focusGroup")) {
+      const { polyfill } = await import("https://esm.sh/@microsoft/focusgroup-polyfill");
+      polyfill(tablist);
+    }
+  </script>
