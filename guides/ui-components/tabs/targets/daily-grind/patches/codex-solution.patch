+  <script>
+    const menu = document.querySelector('#coffee-menu');
+    const tablist = menu.querySelector('[role="tablist"]');
+    const scroller = menu.querySelector('.tab-scroll');
+    const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
+    const panels = tabs.map(tab => document.getElementById(tab.id.replace('-tab', '-panel')));
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const nativeFocusgroup = 'focusgroup' in HTMLElement.prototype;
+
+    function updateScrollHints() {
+      scroller.toggleAttribute('data-more-left', tablist.scrollLeft > 1);
+      scroller.toggleAttribute('data-more-right',
+        tablist.scrollLeft + tablist.clientWidth < tablist.scrollWidth - 1);
+    }
+
+    function revealTab(tab) {
+      // Scroll only this row, including in browsers without scrollIntoView's
+      // container option. Changing categories must never move the page.
+      const row = tablist.getBoundingClientRect();
+      const item = tab.getBoundingClientRect();
+      const inset = 4;
+      let distance = 0;
+      if (item.left < row.left + inset) distance = item.left - row.left - inset;
+      else if (item.right > row.right - inset) distance = item.right - row.right + inset;
+      if (distance) tablist.scrollBy({ left: distance, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
+    }
+
+    function selectTab(selected) {
+      tabs.forEach((tab, index) => {
+        const active = tab === selected;
+        tab.setAttribute('aria-selected', String(active));
+        tab.toggleAttribute('focusgroupstart', active);
+        tab.tabIndex = active ? 0 : -1;
+        if (active) panels[index].removeAttribute('hidden');
+        else panels[index].setAttribute('hidden', 'until-found');
+      });
+      revealTab(selected);
+      updateScrollHints();
+    }
+
+    tabs.forEach((tab, index) => {
+      tab.addEventListener('click', () => selectTab(tab));
+      tab.addEventListener('focus', () => selectTab(tab));
+      panels[index].addEventListener('beforematch', () => selectTab(tab));
+    });
+
+    // Progressive fallback for browsers that do not yet implement focusgroup.
+    if (!nativeFocusgroup) {
+      tablist.addEventListener('keydown', event => {
+        const index = tabs.indexOf(document.activeElement);
+        if (index < 0 || event.altKey || event.ctrlKey || event.metaKey) return;
+        let next;
+        switch (event.key) {
+          case 'ArrowRight': next = (index + 1) % tabs.length; break;
+          case 'ArrowLeft': next = (index - 1 + tabs.length) % tabs.length; break;
+          case 'Home': next = 0; break;
+          case 'End': next = tabs.length - 1; break;
+          default: return;
+        }
+        event.preventDefault();
+        tabs[next].focus({ preventScroll: true });
+      });
+    }
+
+    tablist.addEventListener('scroll', updateScrollHints, { passive: true });
+    function handleResize() {
+      revealTab(tabs.find(tab => tab.getAttribute('aria-selected') === 'true'));
+      updateScrollHints();
+    }
+    if ('ResizeObserver' in window) new ResizeObserver(handleResize).observe(tablist);
+    else window.addEventListener('resize', handleResize);
+    updateScrollHints();
+  </script>
