+  <script>
+    // Explicit route labels keep product names readable and ancestor links valid.
+    const breadcrumbPages = new Map([
+      ['/menu', ['Menu']],
+      ['/menu/seasonal', ['Menu', 'Maple Oat Latte']],
+      ['/menu/espresso', ['Menu', 'Dark Roast Espresso']],
+      ['/menu/cold-brew', ['Menu', 'Cold Brew']],
+      ['/locations', ['Locations']],
+      ['/rewards', ['Rewards']],
+      ['/account', ['My Account']],
+      ['/logout', ['Logout']],
+      ['/order-online', ['Order Online']],
+      ['/about', ['Our Story']],
+      ['/careers', ['Join the Team']],
+      ['/contact', ['Contact Us']],
+      ['/privacy-policy', ['Privacy']],
+    ]);
+    const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
+    const labels = breadcrumbPages.get(currentPath);
+    const breadcrumb = document.querySelector('.breadcrumb');
+
+    if (labels && breadcrumb) {
+      const list = document.createElement('ol');
+      const steps = [
+        { label: 'Home', href: '/' },
+        ...labels.map((label, index) => ({
+          label,
+          href: index === labels.length - 1 ? currentPath : '/menu',
+        })),
+      ];
+
+      steps.forEach((step, index) => {
+        const item = document.createElement('li');
+        const link = document.createElement('a');
+        link.href = step.href;
+        link.textContent = step.label;
+        if (index === steps.length - 1) link.setAttribute('aria-current', 'page');
+        item.append(link);
+        list.append(item);
+      });
+
+      breadcrumb.replaceChildren(list);
+    } else if (currentPath !== '/' && currentPath !== '/index.html' && breadcrumb) {
+      // Do not misidentify an unknown route as the home page.
+      breadcrumb.hidden = true;
+    }
+  </script>
+
 </body>
 
