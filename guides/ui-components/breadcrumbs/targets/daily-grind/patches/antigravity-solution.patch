+  <script>
+    (function () {
+      const breadcrumbList = document.getElementById('breadcrumb-list');
+      const cards = document.querySelectorAll('.card[data-item-title]');
+      const sectionHeading = document.getElementById('section-heading');
+
+      const baseTrail = [
+        { label: 'Home', href: '/' },
+        { label: 'Menu', href: '/menu' },
+        { label: 'Seasonal Favorites', href: '/menu/seasonal' }
+      ];
+
+      function renderBreadcrumbs(activeItem) {
+        const items = activeItem
+          ? [...baseTrail, { label: activeItem.title, href: activeItem.href }]
+          : baseTrail;
+
+        breadcrumbList.innerHTML = '';
+        items.forEach((item, index) => {
+          const li = document.createElement('li');
+          const a = document.createElement('a');
+          a.href = item.href;
+          a.textContent = item.label;
+          if (index === items.length - 1) {
+            a.setAttribute('aria-current', 'page');
+          }
+          a.addEventListener('click', (e) => {
+            e.preventDefault();
+            if (index < baseTrail.length) {
+              showOverview();
+            }
+          });
+          li.appendChild(a);
+          breadcrumbList.appendChild(li);
+        });
+      }
+
+      function showOverview() {
+        cards.forEach((card) => {
+          card.hidden = false;
+        });
+        if (sectionHeading) {
+          sectionHeading.textContent = 'Seasonal Favorites';
+        }
+        renderBreadcrumbs(null);
+      }
+
+      function showItemDetail(title, href) {
+        cards.forEach((card) => {
+          card.hidden = card.dataset.itemTitle !== title;
+        });
+        if (sectionHeading) {
+          sectionHeading.textContent = title;
+        }
+        renderBreadcrumbs({ title, href });
+      }
+
+      document.querySelectorAll('.breadcrumb > ol > li > a').forEach((a, index) => {
+        a.addEventListener('click', (e) => {
+          e.preventDefault();
+          if (index < baseTrail.length) {
+            showOverview();
+          }
+        });
+      });
+
+      document.querySelectorAll('[data-trail-item]').forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.preventDefault();
+          const title = btn.getAttribute('data-trail-item');
+          const href = btn.getAttribute('href') || '#';
+          showItemDetail(title, href);
+        });
+      });
+
+      const menuNav = document.querySelector('[data-breadcrumb-item="menu"]');
+      if (menuNav) {
+        menuNav.addEventListener('click', (e) => {
+          e.preventDefault();
+          showOverview();
+        });
+      }
+    })();
+  </script>
+
