diff --git a/hovercards.mjs b/hovercards.mjs
new file mode 100644
index 0000000..2af04dd
--- /dev/null
+++ b/hovercards.mjs
@@ -0,0 +1,82 @@
+const expandedTriggers = new WeakSet();
+
+/** @param {string | null} text */
+function normalize(text) {
+  return (text ?? "").replace(/\s+/g, " ").trim();
+}
+
+/** @param {Node} node @returns {string} */
+function textWithAlt(node) {
+  if (node instanceof Text) return node.data;
+  if (!(node instanceof Element)) return "";
+  if (node.matches("img, area")) return node.getAttribute("alt") ?? "";
+  return Array.from(node.childNodes, textWithAlt).join("");
+}
+
+/** @param {Element} trigger */
+function triggerName(trigger) {
+  const labelIds = normalize(trigger.getAttribute("aria-labelledby")).split(" ").filter(Boolean);
+  const labelText = labelIds.map((id) => {
+    const label = document.getElementById(id);
+    return label ? normalize(label.getAttribute("aria-label")) || textWithAlt(label) : "";
+  }).join(" ");
+
+  return normalize(labelText)
+    || normalize(trigger.getAttribute("aria-label"))
+    || normalize(textWithAlt(trigger))
+    || normalize(trigger.getAttribute("title"));
+}
+
+/** @param {Element} hint */
+function isOpen(hint) {
+  return hint.matches(String.raw`:is(:popover-open, .\:popover-open)`);
+}
+
+function wireInterestHints() {
+  for (const trigger of document.querySelectorAll("[interestfor]")) {
+    const id = trigger.getAttribute("interestfor");
+    if (!id) continue;
+    const hint = document.getElementById(id);
+    if (!hint || hint.getAttribute("popover") !== "hint") continue;
+
+    const name = triggerName(trigger);
+    if (name === normalize(textWithAlt(hint))) continue;
+    if (!hint.hasAttribute("role")) hint.setAttribute("role", "tooltip");
+
+    if (!name) {
+      if (!trigger.hasAttribute("aria-labelledby")) trigger.setAttribute("aria-labelledby", id);
+    } else if (trigger.getAttribute("popovertarget") === id || trigger.getAttribute("commandfor") === id) {
+      if (!trigger.hasAttribute("aria-expanded")) {
+        trigger.setAttribute("aria-expanded", String(isOpen(hint)));
+        expandedTriggers.add(trigger);
+      }
+    } else if (!trigger.hasAttribute("aria-describedby")) {
+      trigger.setAttribute("aria-describedby", id);
+    }
+  }
+}
+
+document.addEventListener("toggle", (event) => {
+  const hint = event.target;
+  if (!(hint instanceof HTMLElement) || hint.getAttribute("popover") !== "hint" || !hint.id) return;
+
+  for (const trigger of document.querySelectorAll("[interestfor]")) {
+    if (expandedTriggers.has(trigger) && trigger.getAttribute("interestfor") === hint.id) {
+      trigger.setAttribute("aria-expanded", String(isOpen(hint)));
+    }
+  }
+}, { capture: true });
+
+Object.assign(window, { wireInterestHints });
+wireInterestHints();
+
+async function loadHovercardPolyfills() {
+  if (!Object.prototype.hasOwnProperty.call(HTMLElement.prototype, "popover")) {
+    await import("https://unpkg.com/@oddbird/popover-polyfill@0.7.3/dist/popover.min.js");
+  }
+  if (!("interestForElement" in HTMLButtonElement.prototype)) {
+    await import("https://unpkg.com/interestfor@1.0.14/src/interestfor.min.js");
+  }
+}
+
+loadHovercardPolyfills().catch((error) => console.warn("Drink preview polyfills could not load.", error));
