+      display: block;
+    }
+
+    .hovercard p {
+      font-size: 0.88rem;
+      line-height: 1.45;
+    }
+
+    /* Cross-document View Transitions */
+    @view-transition {
+      navigation: auto;
+    }
+
+    ::view-transition-group(*) {
+      animation-duration: 0s;
+    }
+
