+    /* Hovercard Component */
+    [popover].hovercard {
+      position-area: block-end span-inline-end;
+      position-try-fallbacks: flip-block, flip-inline;
+      margin-top: 8px;
+      width: 300px;
+      background: white;
+      color: var(--text);
+      padding: 16px;
+      border: 1px solid var(--secondary);
