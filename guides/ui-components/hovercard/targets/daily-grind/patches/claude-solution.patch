+  <script type="module">
+    // Conditionally load polyfills only where the native features are missing.
+    // Links remain plain navigations if any of this fails (progressive enhancement).
+    const supportsPopover = ('popover' in HTMLElement.prototype);
+    const supportsAnchor = CSS.supports('position-area', 'block-end');
+    const supportsInterest = ('interestForElement' in HTMLAnchorElement.prototype);
+
+    if (!supportsPopover) {
+      await import('https://cdn.jsdelivr.net/npm/@oddbird/popover-polyfill@0.5/dist/popover.min.js').catch(() => {});
+    }
+
+    if (!supportsAnchor) {
+      import('https://cdn.jsdelivr.net/npm/@oddbird/css-anchor-positioning@0.6/dist/css-anchor-positioning.js').catch(() => {});
+    }
+
+    if (!supportsInterest && ('popover' in HTMLElement.prototype)) {
+      // Minimal interest-invoker fallback: show on hover/focus, hide on loss of
+      // interest. Hides explicitly because `popover="hint"` may fall back to
+      // `manual` behaviour in browsers without `hint` support.
+      const SHOW_DELAY = 500;
+      const HIDE_DELAY = 250;
+
+      const setup = () => {
+        document.querySelectorAll('a[interestfor]').forEach((trigger) => {
+          const card = document.getElementById(trigger.getAttribute('interestfor') ?? '');
+          if (!card) return;
+
+          let showTimer;
+          let hideTimer;
+
+          const show = () => {
+            clearTimeout(hideTimer);
+            clearTimeout(showTimer);
+            showTimer = setTimeout(() => {
+              // Close any other open hovercard first.
+              document.querySelectorAll('.hovercard:popover-open').forEach((other) => {
+                if (other !== card) other.hidePopover();
+              });
+              if (!card.matches(':popover-open')) card.showPopover();
+            }, SHOW_DELAY);
+          };
+
+          const hide = () => {
+            clearTimeout(showTimer);
+            clearTimeout(hideTimer);
+            hideTimer = setTimeout(() => {
+              if (card.matches(':popover-open')) card.hidePopover();
+            }, HIDE_DELAY);
+          };
+
+          trigger.setAttribute('aria-describedby', card.id);
+          for (const el of [trigger, card]) {
+            el.addEventListener('mouseenter', show);
+            el.addEventListener('mouseleave', hide);
+            el.addEventListener('focusin', show);
+            el.addEventListener('focusout', hide);
+          }
+          trigger.addEventListener('keydown', (event) => {
+            if (event.key === 'Escape') {
+              clearTimeout(showTimer);
+              if (card.matches(':popover-open')) card.hidePopover();
+            }
+          });
+        });
+      };
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', setup);
+      } else {
+        setup();
+      }
+    }
+  </script>
