+  <script type="module">
+    // ---- ARIA wiring for interest-triggered hints --------------------------
+    // Runs in every browser, after the DOM is parsed (module scripts are
+    // deferred) and BEFORE the interestfor polyfill is loaded.
+    const normalize = (text) => (text ?? "").replace(/\s+/g, " ").trim();
+
+    /** Text content of a node, including image alt text. */
+    const textWithAlt = (node) => {
+      if (node.nodeType === Node.TEXT_NODE) return node.textContent ?? "";
+      if (node.nodeType !== Node.ELEMENT_NODE) return "";
+      const el = /** @type {Element} */ (node);
+      if (el.localName === "img") return ` ${el.getAttribute("alt") ?? ""} `;
+      let out = "";
+      for (const child of el.childNodes) out += textWithAlt(child);
+      return out;
+    };
+
+    /** Approximate accessible name of a trigger. */
+    const accessibleName = (el) => {
+      const labelledBy = el.getAttribute("aria-labelledby");
+      if (labelledBy) {
+        const text = labelledBy
+          .split(/\s+/)
+          .map((id) => document.getElementById(id))
+          .filter(Boolean)
+          .map((ref) => textWithAlt(ref))
+          .join(" ");
+        if (normalize(text)) return normalize(text);
+      }
+      const label = normalize(el.getAttribute("aria-label"));
+      if (label) return label;
+      const content = normalize(textWithAlt(el));
+      if (content) return content;
+      return normalize(el.getAttribute("title"));
+    };
+
+    const isPopoverOpen = (popover) => {
+      if (popover.classList.contains(":popover-open")) return true;
+      try {
+        return popover.matches(":popover-open");
+      } catch {
+        return false;
+      }
+    };
+
+    /** Triggers whose aria-expanded state this script owns. */
+    const ownedTriggers = new WeakSet();
+
+    function wireInterestHints(root = document) {
+      for (const trigger of root.querySelectorAll("[interestfor]")) {
+        const hintId = trigger.getAttribute("interestfor");
+        if (!hintId) continue;
+        const hint = document.getElementById(hintId);
+        if (!hint || hint.getAttribute("popover") !== "hint") continue;
+
+        const name = accessibleName(trigger);
+        const hintText = normalize(textWithAlt(hint));
+        if (name === hintText) continue;
+
+        if (!hint.hasAttribute("role")) hint.setAttribute("role", "tooltip");
+
+        if (!name) {
+          if (!trigger.hasAttribute("aria-labelledby")) {
+            trigger.setAttribute("aria-labelledby", hintId);
+          }
+          continue;
+        }
+
+        const opensOnActivation =
+          trigger.getAttribute("popovertarget") === hintId ||
+          trigger.getAttribute("commandfor") === hintId;
+
+        if (opensOnActivation) {
+          if (!trigger.hasAttribute("aria-expanded")) {
+            trigger.setAttribute("aria-expanded", String(isPopoverOpen(hint)));
+            ownedTriggers.add(trigger);
+          }
+        } else if (!trigger.hasAttribute("aria-describedby")) {
+          trigger.setAttribute("aria-describedby", hintId);
+        }
+      }
+    }
+
+    // `toggle` does not bubble: listen in the capture phase.
+    document.addEventListener(
+      "toggle",
+      (event) => {
+        const popover = event.target;
+        if (!(popover instanceof Element) || !popover.id) return;
+        const open =
+          "newState" in event ? event.newState === "open" : isPopoverOpen(popover);
+        for (const trigger of document.querySelectorAll("[interestfor]")) {
+          if (
+            trigger.getAttribute("interestfor") === popover.id &&
+            ownedTriggers.has(trigger)
+          ) {
+            trigger.setAttribute("aria-expanded", String(open));
+          }
+        }
+      },
+      true,
+    );
+
+    wireInterestHints();
+    // Exposed so content inserted later can be wired too.
+    window.wireInterestHints = wireInterestHints;
+
+    // ---- Conditional polyfills ---------------------------------------------
+    // Popover API (needed before the interestfor polyfill can show hints).
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    // Interest invokers.
+    if (!("interestForElement" in HTMLButtonElement.prototype)) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+
+    // CSS anchor positioning.
+    if (!CSS.supports("anchor-name: --a")) {
+      import("https://unpkg.com/@oddbird/css-anchor-positioning");
+    }
+  </script>
