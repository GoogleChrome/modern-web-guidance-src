+
+    /* Hovercards */
+    @view-transition {
+      navigation: auto;
+    }
+
+    /* Don't show transitions when loading this page */
+    ::view-transition-group(*) {
+      animation-duration: 0s;
+    }
+
+    [popover].hovercard {
+      position-area: block-end span-inline-end;
+      position-try-fallbacks: flip-block, flip-inline;
+      margin: 8px 0;
+      width: min(300px, 90vw);
+      padding: 16px 20px;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
+      opacity: 0;
+      transform-origin: top;
+    }
+
+    [popover].hovercard h2 {
+      font-size: 1.2rem;
+      color: var(--primary);
+      margin-bottom: 4px;
+    }
+
+    [popover].hovercard .meta {
+      font-size: 0.8rem;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      color: #795548;
+      margin-bottom: 8px;
+    }
+
+    [popover].hovercard ul {
+      margin: 8px 0 0 18px;
+      font-size: 0.9rem;
+    }
+
+    [popover].hovercard:popover-open {
+      opacity: 1;
+      transform: translateY(0) scale(1);
+    }
+
+    @starting-style {
+      [popover].hovercard:popover-open {
+        opacity: 0;
+        transform: translateY(-10px) scale(0.95);
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      [popover].hovercard {
+        transition:
+          opacity,
+          transform,
+          display,
+          overlay;
+        transition-duration: 0.4s;
+        transition-behavior: allow-discrete;
+      }
+    }
+
+    /* Assign names only while open so just the visible card morphs */
+    [popover].hovercard:popover-open {
+      view-transition-name: --hovercard;
+      view-transition-class: morph;
+
+      h2 {
+        view-transition-name: --title;
+        view-transition-class: morph;
+      }
+    }
   </style>
