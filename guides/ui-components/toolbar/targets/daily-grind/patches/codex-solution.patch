+  <script>
+    const favoritesToolbar = document.getElementById('favorites-actions');
+    const favoritesCards = document.getElementById('favorites-cards');
+    const favoritesStatus = document.getElementById('favorites-status');
+    const toggleDetails = document.getElementById('toggle-details');
+    const copyFavorites = document.getElementById('copy-favorites');
+
+    if (favoritesToolbar && favoritesCards && favoritesStatus && toggleDetails && copyFavorites) {
+      if ('interestForElement' in HTMLButtonElement.prototype && CSS.supports('position-area', 'block-end')) {
+        favoritesToolbar.querySelectorAll('button[title]').forEach((b, i) => {
+          const tip = Object.assign(document.createElement('div'), { id: `codex-tip-${i}`, textContent: b.title });
+          tip.popover = 'hint';
+          b.setAttribute('interestfor', tip.id);
+          b.removeAttribute('title');
+          document.body.append(tip);
+        });
+      }
+
+      const buttons = Array.from(favoritesToolbar.querySelectorAll('button'));
+      const viewButtons = buttons.filter((button) => button.dataset.view);
+
+      for (const button of viewButtons) {
+        button.addEventListener('click', () => {
+          if (button.getAttribute('aria-disabled') === 'true') return;
+          favoritesCards.dataset.view = button.dataset.view;
+          for (const viewButton of viewButtons) {
+            viewButton.setAttribute('aria-pressed', String(viewButton === button));
+          }
+        });
+      }
+
+      toggleDetails.addEventListener('click', () => {
+        if (toggleDetails.getAttribute('aria-disabled') === 'true') return;
+        const next = toggleDetails.getAttribute('aria-pressed') !== 'true';
+        toggleDetails.setAttribute('aria-pressed', String(next));
+        favoritesCards.dataset.details = String(next);
+      });
+
+      copyFavorites.addEventListener('click', async () => {
+        if (copyFavorites.getAttribute('aria-disabled') === 'true') return;
+        copyFavorites.setAttribute('aria-disabled', 'true');
+        favoritesStatus.textContent = '';
+        const drinks = Array.from(favoritesCards.querySelectorAll('.card')).map((card) => {
+          const name = card.querySelector('h3')?.textContent?.trim() ?? '';
+          const description = card.querySelector('p')?.textContent?.trim() ?? '';
+          return `${name}: ${description}`;
+        });
+        try {
+          await navigator.clipboard.writeText(drinks.join('\n'));
+          favoritesStatus.textContent = 'Featured drinks copied.';
+        } catch {
+          favoritesStatus.textContent = 'Could not copy drinks. Please try again or copy the drink text directly.';
+        } finally {
+          copyFavorites.removeAttribute('aria-disabled');
+        }
+      });
+
+      if (!('focusGroup' in HTMLElement.prototype)) {
+        buttons.forEach((button, index) => { button.tabIndex = index === 0 ? 0 : -1; });
+        favoritesToolbar.addEventListener('focusin', (event) => {
+          const btn = event.target.closest('button');
+          if (!btn || !buttons.includes(btn)) return;
+          buttons.forEach((button) => { button.tabIndex = button === btn ? 0 : -1; });
+        });
+        favoritesToolbar.addEventListener('keydown', (event) => {
+          const btn = event.target.closest('button');
+          const index = buttons.indexOf(btn);
+          if (index < 0 || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+          const vertical = favoritesToolbar.getAttribute('aria-orientation') === 'vertical';
+          const rtl = getComputedStyle(favoritesToolbar).direction === 'rtl';
+          let nextIndex;
+          if (event.key === 'Home') nextIndex = 0;
+          else if (event.key === 'End') nextIndex = buttons.length - 1;
+          else {
+            const forward = vertical ? 'ArrowDown' : rtl ? 'ArrowLeft' : 'ArrowRight';
+            const backward = vertical ? 'ArrowUp' : rtl ? 'ArrowRight' : 'ArrowLeft';
+            if (event.key === forward) nextIndex = (index + 1) % buttons.length;
+            else if (event.key === backward) nextIndex = (index - 1 + buttons.length) % buttons.length;
+            else return;
+          }
+          event.preventDefault();
+          buttons[nextIndex].focus();
+        });
+      }
+    }
+  </script>
