+  <script>
+    (() => {
+      const bar = document.getElementById("favorites-actions");
+      const grid = document.getElementById("favorites-grid");
+      const status = document.getElementById("favorites-status");
+      const more = document.getElementById("favorites-more");
+      const menu = document.getElementById("favorites-more-menu");
+      if (!bar || !grid || !status || !more || !menu) return;
+
+      const menuList = menu.querySelector("[focusgroup]");
+      const menuItems = Array.from(menu.querySelectorAll("button"));
+      const sortItem = menu.querySelector('[data-action="sort"]');
+      const layoutButtons = Array.from(bar.querySelectorAll("button[data-layout]"));
+      const descriptionsButton = document.getElementById("favorites-descriptions");
+      const copyButton = document.getElementById("favorites-copy");
+      const printButton = document.getElementById("favorites-print");
+      const originalOrder = Array.from(grid.children);
+      const hasFocusgroup = "focusGroup" in HTMLElement.prototype;
+      let announceTimer = 0;
+
+      const announce = (message, delay = 0) => {
+        clearTimeout(announceTimer);
+        status.textContent = "";
+        announceTimer = window.setTimeout(() => { status.textContent = message; }, delay || 50);
+      };
+
+      const isDisabled = (el) => el.getAttribute("aria-disabled") === "true";
+
+      /* ---------- Toolbar actions ---------- */
+
+      const setLayout = (layout) => {
+        layoutButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.layout === layout)));
+        grid.classList.toggle("is-list", layout === "list");
+      };
+
+      layoutButtons.forEach((b) => {
+        b.addEventListener("click", () => {
+          if (isDisabled(b)) return;
+          setLayout(b.dataset.layout || "grid");
+        });
+      });
+
+      const setDescriptions = (show) => {
+        descriptionsButton.setAttribute("aria-pressed", String(show));
+        grid.classList.toggle("hide-descriptions", !show);
+      };
+
+      descriptionsButton.addEventListener("click", () => {
+        if (isDisabled(descriptionsButton)) return;
+        setDescriptions(descriptionsButton.getAttribute("aria-pressed") !== "true");
+      });
+
+      copyButton.addEventListener("click", async () => {
+        if (isDisabled(copyButton)) return;
+        const text = Array.from(grid.querySelectorAll(".card"))
+          .map((card) => {
+            const name = card.querySelector("h3")?.textContent?.trim() ?? "";
+            const desc = card.querySelector("p")?.textContent?.trim() ?? "";
+            return desc ? `${name} – ${desc}` : name;
+          })
+          .join("\n");
+        try {
+          await navigator.clipboard.writeText(text);
+          announce("Drink list copied");
+        } catch {
+          announce("Copy failed");
+        }
+      });
+
+      printButton.addEventListener("click", () => {
+        if (isDisabled(printButton)) return;
+        window.print();
+      });
+
+      /* ---------- Overflow menu ---------- */
+
+      const setSorted = (sorted) => {
+        sortItem.setAttribute("aria-checked", String(sorted));
+        const cards = sorted
+          ? originalOrder.slice().sort((a, b) =>
+            (a.querySelector("h3")?.textContent ?? "").localeCompare(b.querySelector("h3")?.textContent ?? ""))
+          : originalOrder;
+        cards.forEach((card) => grid.append(card));
+      };
+
+      const toggleSort = () => {
+        const sorted = sortItem.getAttribute("aria-checked") !== "true";
+        setSorted(sorted);
+        announce(sorted ? "Sort A to Z on" : "Sort A to Z off");
+      };
+
+      const closeMenu = () => {
+        if (menu.matches(":popover-open")) menu.hidePopover();
+      };
+
+      menu.addEventListener("toggle", (event) => {
+        const open = event.newState === "open";
+        more.setAttribute("aria-expanded", String(open));
+        if (!open) return;
+        if (!CSS.supports("position-area", "block-end")) {
+          // Without anchor positioning, place the menu below its trigger, flipping above if needed
+          const t = more.getBoundingClientRect();
+          const m = menu.getBoundingClientRect();
+          const below = t.bottom + m.height <= innerHeight;
+          menu.style.top = `${below ? t.bottom : t.top - m.height}px`;
+          menu.style.left = `${Math.max(0, Math.min(t.right - m.width, innerWidth - m.width))}px`;
+        }
+        menuItems[0]?.focus();
+      });
+
+      sortItem.addEventListener("click", () => {
+        if (isDisabled(sortItem)) return;
+        toggleSort();
+      });
+
+      menu.querySelector('[data-action="reset"]').addEventListener("click", (event) => {
+        if (isDisabled(event.currentTarget)) return;
+        setLayout("grid");
+        setDescriptions(true);
+        setSorted(false);
+        closeMenu();
+        more.focus();
+        // Delay so the focus-change announcement does not preempt this message
+        announce("View reset", 500);
+      });
+
+      menu.addEventListener("keydown", (event) => {
+        if (event.key === "Tab") {
+          // Close without trapping focus; let Tab continue from the trigger
+          closeMenu();
+          more.focus();
+          return;
+        }
+        if (event.target === sortItem && (event.key === " " || event.key === "Enter")) {
+          event.preventDefault();
+          if (isDisabled(sortItem)) return;
+          toggleSort();
+          if (event.key === "Enter") {
+            closeMenu();
+            more.focus();
+          }
+          return;
+        }
+        if (hasFocusgroup) return;
+        // Fallback menu navigation when focusgroup is unsupported
+        const i = menuItems.indexOf(document.activeElement);
+        let next = -1;
+        if (event.key === "ArrowDown") next = (i + 1) % menuItems.length;
+        else if (event.key === "ArrowUp") next = (i - 1 + menuItems.length) % menuItems.length;
+        else if (event.key === "Home") next = 0;
+        else if (event.key === "End") next = menuItems.length - 1;
+        if (next < 0) return;
+        event.preventDefault();
+        menuItems[next].focus();
+      });
+
+      if (!hasFocusgroup) {
+        menuList.setAttribute("role", "menu");
+        menuItems.forEach((item) => {
+          if (!item.hasAttribute("role")) item.setAttribute("role", "menuitem");
+          item.tabIndex = -1;
+        });
+      }
+
+      /* ---------- Roving tab stop fallback for the toolbar ---------- */
+
+      if (!hasFocusgroup) {
+        const items = Array.from(bar.querySelectorAll("button"));
+        items.forEach((b, i) => (b.tabIndex = i ? -1 : 0));
+        bar.addEventListener("focusin", ({ target }) => {
+          if (items.includes(target)) items.forEach((b) => (b.tabIndex = b === target ? 0 : -1));
+        });
+        bar.addEventListener("keydown", (event) => {
+          const vertical = bar.getAttribute("aria-orientation") === "vertical";
+          const rtl = getComputedStyle(bar).direction === "rtl";
+          const steps = vertical
+            ? { ArrowDown: 1, ArrowUp: -1 }
+            : { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 };
+          const i = items.indexOf(document.activeElement);
+          if (i < 0) return;
+          let next;
+          if (event.key in steps) next = (i + steps[event.key] + items.length) % items.length;
+          else if (event.key === "Home") next = 0;
+          else if (event.key === "End") next = items.length - 1;
+          else return;
+          event.preventDefault();
+          items[next].focus();
+        });
+      }
+
+      /* ---------- Hide separators that would sit alone at a row end ---------- */
+
+      const separators = Array.from(bar.querySelectorAll('[role="separator"]'));
+      const updateSeparators = () => {
+        separators.forEach((sep) => {
+          const prev = sep.previousElementSibling;
+          const next = sep.nextElementSibling;
+          const top = sep.offsetTop;
+          const orphan = !prev || !next || prev.offsetTop + prev.offsetHeight <= top || next.offsetTop >= top + sep.offsetHeight;
+          sep.classList.toggle("is-orphan", orphan);
+        });
+      };
+      if ("ResizeObserver" in window) new ResizeObserver(updateSeparators).observe(bar);
+      updateSeparators();
+
+      /* ---------- Upgrade title tooltips to interest-invoked hints ---------- */
+
+      if ("interestForElement" in HTMLButtonElement.prototype && CSS.supports("position-area", "block-end")) {
+        bar.querySelectorAll("button[title]").forEach((b, i) => {
+          const tip = Object.assign(document.createElement("div"), {
+            id: `favorites-tip-${i}`,
+            className: "toolbar-tip",
+            textContent: b.title,
+          });
+          tip.popover = "hint";
+          b.setAttribute("interestfor", tip.id);
+          b.removeAttribute("title");
+          document.body.append(tip);
+        });
+      }
+
+      /* ---------- Popover polyfill where popover is unsupported ---------- */
+
+      if (!HTMLElement.prototype.hasOwnProperty("popover")) {
+        import("https://cdn.jsdelivr.net/npm/@oddbird/popover-polyfill@latest/dist/popover-fn.js")
+          .then(({ apply }) => apply())
+          .catch(() => { /* menu stays unavailable; toolbar controls still work */ });
+      }
+    })();
+  </script>
+
