+          if (!CSS.supports("position-area", "block-end")) {
+            const t = more.getBoundingClientRect();
+            const m = menu.getBoundingClientRect();
+            const below = t.bottom + m.height <= innerHeight;
+            menu.style.top = `${below ? t.bottom : t.top - m.height}px`;
+            menu.style.left = `${Math.max(0, Math.min(t.right - m.width, innerWidth - m.width))}px`;
+          }
+          menuItems[0]?.focus();
+        }
+      });
+
+      // Close popover on Tab without trapping focus, and let Space on menuitemcheckbox toggle without closing
+      menu.addEventListener("keydown", (e) => {
+        if (e.key === "Tab") {
+          menu.hidePopover();
+          return;
+        }
+        if (e.key === " ") {
+          const item = e.target.closest('[role="menuitemcheckbox"]');
+          if (item) {
+            e.preventDefault();
+            const nextChecked = item.getAttribute("aria-checked") !== "true";
+            item.setAttribute("aria-checked", nextChecked ? "true" : "false");
+            grid.dataset.showNotes = nextChecked ? "true" : "false";
+            syncState();
+            status.textContent = nextChecked ? "Tasting notes on" : "Tasting notes off";
+          }
+        }
+      });
+
+      // Menu item activations
+      menuInner.addEventListener("click", (e) => {
+        const item = e.target.closest("button[data-menu-action]");
+        if (!item) return;
+        const action = item.dataset.menuAction;
+        let announcement = "";
+
+        if (action === "toggle-notes") {
+          const nextChecked = item.getAttribute("aria-checked") !== "true";
+          item.setAttribute("aria-checked", nextChecked ? "true" : "false");
+          grid.dataset.showNotes = nextChecked ? "true" : "false";
+          syncState();
+          announcement = nextChecked ? "Tasting notes on" : "Tasting notes off";
+        } else if (action === "sort-alpha") {
+          cards
+            .slice()
+            .sort((a, b) => (a.dataset.name || "").localeCompare(b.dataset.name || ""))
+            .forEach((c) => grid.append(c));
+          grid.dataset.sorted = "alpha";
+          syncState();
+          announcement = "Sorted alphabetically";
+        } else if (action === "clear-all") {
+          resetAll();
+          announcement = "All options reset";
+        }
+
+        menu.hidePopover();
+        more.focus();
+        if (announcement) {
+          setTimeout(() => {
+            status.textContent = announcement;
+          }, 500);
+        }
+      });
+    })();
+  </script>
 </body>
 
