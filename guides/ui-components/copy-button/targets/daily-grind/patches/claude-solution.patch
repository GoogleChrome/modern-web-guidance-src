+  <script>
+    (() => {
+      const timers = new WeakMap();
+      let lastMessage = '';
+
+      function report(button, ok) {
+        const tip = button.nextElementSibling; // the role="status" bubble
+        clearTimeout(timers.get(button));
+        button.removeAttribute('data-copied');
+        button.removeAttribute('data-failed');
+        let message = ok ? 'Copied' : 'Copy failed';
+        if (message === lastMessage) message += '\u00A0'; // VoiceOver skips identical repeats
+        lastMessage = message;
+        if (tip) tip.textContent = '';
+        void button.offsetWidth; // restart the CSS animation
+        button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+        requestAnimationFrame(() => {
+          if (tip) tip.textContent = message;
+        });
+        timers.set(button, setTimeout(() => {
+          button.removeAttribute('data-copied');
+          button.removeAttribute('data-failed');
+          if (tip) tip.textContent = '';
+        }, 2000));
+      }
+
+      async function copy(button, target) {
+        // innerText (unlike textContent) keeps rendered line breaks
+        const text = target.matches('input, textarea') ? target.value : target.innerText.trim();
+        if (!text) return;
+        try {
+          await navigator.clipboard.writeText(text);
+          report(button, true);
+        } catch {
+          report(button, false); // clipboard missing (insecure context) or permission denied
+        }
+      }
+
+      if ('CommandEvent' in window) {
+        // `command` events do not bubble: listen in the capture phase.
+        document.addEventListener('command', (event) => {
+          if (event.command === '--copy' && event.source && event.target instanceof Element) {
+            copy(event.source, event.target);
+          }
+        }, true);
+      } else {
+        // Fallback: resolve the target from commandfor, as the browser does.
+        document.addEventListener('click', (event) => {
+          const button = event.target instanceof Element && event.target.closest('button[command="--copy"]');
+          if (!button) return;
+          const target = document.getElementById(button.getAttribute('commandfor'));
+          if (target) copy(button, target);
+        });
+      }
+    })();
+  </script>
+
