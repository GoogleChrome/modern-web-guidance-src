+    /* Copy buttons */
+    .copy {
+      position: relative; /* positioning context for the bubble */
+      display: inline-flex;
+    }
+
+    .copy-button {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      min-inline-size: 32px;
+      min-block-size: 32px;
+      padding: 4px;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: rgba(255, 255, 255, 0.95);
+      color: var(--primary);
+      cursor: pointer;
+      transition: background 0.2s, border-color 0.2s;
+    }
+
+    .copy-button:hover {
+      background: var(--secondary);
+    }
+
+    .copy-button:focus-visible {
+      outline: 2px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .copy-button .icon-check {
+      display: none;
+    }
+
+    .copy-button[data-copied] .icon-copy {
+      display: none;
+    }
+
+    .copy-button[data-copied] .icon-check {
+      display: block;
+      animation: copy-pop 0.3s ease-out;
+    }
+
+    .copy-button[data-failed] {
+      border-color: #b71c1c;
+    }
+
+    .tip {
+      position: absolute;
+      inset-block-end: calc(100% + 6px);
+      inset-inline-end: 0;
+      padding: 2px 8px;
+      border-radius: 4px;
+      background: var(--text);
+      color: white;
+      font-size: 0.75rem;
+      line-height: 1.4;
+      white-space: nowrap;
+      pointer-events: none;
+      opacity: 0; /* hidden with opacity so it stays in the accessibility tree */
+      transition: opacity 0.15s;
+    }
+
+    .copy-button[data-copied]+.tip,
+    .copy-button[data-failed]+.tip {
+      opacity: 1;
+      animation: tip-rise 0.2s ease-out;
+    }
+
+    .copy-button[data-failed]+.tip {
+      background: #b71c1c;
+    }
+
+    @keyframes copy-pop {
+      from { transform: scale(0.5); }
+      to { transform: scale(1); }
+    }
+
+    @keyframes tip-rise {
+      from { opacity: 0; translate: 0 4px; }
+      to { opacity: 1; translate: 0 0; }
+    }
+
+    @keyframes fade-in {
+      from { opacity: 0; }
+      to { opacity: 1; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .copy-button[data-copied] .icon-check,
+      .copy-button[data-copied]+.tip,
+      .copy-button[data-failed]+.tip {
+        animation: fade-in 0.2s ease-out;
+      }
+    }
+
+    /* Touch devices (no hover): the button stays visible, in flow beside the text */
+    .copyable {
+      display: flex;
+      align-items: start;
+      gap: 0.5rem;
+    }
+
+    .copyable p {
+      flex: 1;
+    }
+
+    .copyable .copy {
