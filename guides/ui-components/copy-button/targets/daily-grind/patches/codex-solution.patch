+  <script>
+    const feedback = new WeakMap();
+    let lastMessage = '';
+
+    function report(button, ok) {
+      const tip = button.nextElementSibling;
+      if (!(tip instanceof HTMLElement)) return;
+
+      const previous = feedback.get(button);
+      if (previous) {
+        clearTimeout(previous.timer);
+        cancelAnimationFrame(previous.frame);
+      }
+      button.removeAttribute('data-copied');
+      button.removeAttribute('data-failed');
+      tip.textContent = '';
+      let message = ok ? 'Copied' : 'Copy failed';
+      if (message === lastMessage) message += '\u00a0';
+      lastMessage = message;
+      void button.offsetWidth;
+      button.setAttribute(ok ? 'data-copied' : 'data-failed', '');
+      const frame = requestAnimationFrame(() => { tip.textContent = message; });
+      const timer = setTimeout(() => {
+        cancelAnimationFrame(frame);
+        button.removeAttribute('data-copied');
+        button.removeAttribute('data-failed');
+        tip.textContent = '';
+        feedback.delete(button);
+      }, 2000);
+      feedback.set(button, { timer, frame });
+    }
+
+    async function copy(button, target) {
+      const text = target.innerText.trim();
+      if (!text) return;
+      try {
+        await navigator.clipboard.writeText(text);
+        report(button, true);
+      } catch {
+        report(button, false);
+      }
+    }
+
+    if ('CommandEvent' in window) {
+      document.addEventListener('command', (event) => {
+        if (event.command === '--copy' &&
+            event.source instanceof HTMLButtonElement &&
+            event.source.matches('.copy-button') &&
+            event.target instanceof HTMLElement) {
+          void copy(event.source, event.target);
+        }
+      }, true);
+    } else {
+      document.addEventListener('click', (event) => {
+        if (!(event.target instanceof Element)) return;
+        const button = event.target.closest('button.copy-button[command="--copy"]');
+        if (!(button instanceof HTMLButtonElement)) return;
+        const target = document.getElementById(button.getAttribute('commandfor') || '');
+        if (target instanceof HTMLElement) void copy(button, target);
+      });
+    }
+  </script>
