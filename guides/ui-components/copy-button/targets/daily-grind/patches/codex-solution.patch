+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { Script } from 'node:vm';
+
+const page = await readFile(new URL('./index.html', import.meta.url), 'utf8');
+for (const [, source] of page.matchAll(/<script\b[^>]*>([\s\S]*?)<\/script>/gi)) {
+  new Script(source, { filename: 'index.html' });
+}
+const output = new URL('./dist/', import.meta.url);
+await mkdir(output, { recursive: true });
+await writeFile(new URL('index.html', output), page);
+console.log('Built dist/index.html; inline JavaScript syntax checked.');
