+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const dark = matchMedia("(prefers-color-scheme: dark)");
+      const systemScheme = () => (dark.matches ? "dark" : "light");
+
+      function stored() {
+        try {
+          return localStorage.getItem("color-scheme");
+        } catch (e) {
+          return null;
+        }
+      }
+
+      document.getElementById("theme-toggle").addEventListener("click", () => {
+        const rendered = meta.content === "dark" || meta.content === "light" ? meta.content : systemScheme();
+        const target = rendered === "dark" ? "light" : "dark";
+        const value = target === systemScheme() ? null : target;
+        try {
+          if (value) localStorage.setItem("color-scheme", value);
+          else localStorage.removeItem("color-scheme");
+        } catch (e) {}
+        meta.content = value ?? "light dark";
+      });
+
+      window.addEventListener("storage", (e) => {
+        if (e.key === "color-scheme" || e.key === null) {
+          meta.content = stored() ?? "light dark";
+        }
+      });
+    })();
+  </script>
