+  <script>
+    const schemeMeta = document.querySelector('meta[name="color-scheme"]');
+    const themeToggle = document.getElementById('theme-toggle');
+    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
+
+    themeToggle.addEventListener('click', () => {
+      const systemScheme = systemDark.matches ? 'dark' : 'light';
+      const currentScheme = schemeMeta.content === 'light' || schemeMeta.content === 'dark'
+        ? schemeMeta.content
+        : systemScheme;
+      const targetScheme = currentScheme === 'dark' ? 'light' : 'dark';
+      const override = targetScheme === systemScheme ? null : targetScheme;
+
+      schemeMeta.content = override ?? 'light dark';
+      try {
+        if (override === null) {
+          localStorage.removeItem('color-scheme');
+        } else {
+          localStorage.setItem('color-scheme', override);
+        }
+      } catch {}
+    });
+
+    window.addEventListener('storage', (event) => {
+      if (event.key !== 'color-scheme' && event.key !== null) return;
+      try {
+        if (event.storageArea !== window.localStorage) return;
+      } catch {
+        return;
+      }
+      schemeMeta.content = event.newValue === 'light' || event.newValue === 'dark'
+        ? event.newValue
+        : 'light dark';
+    });
+
+    themeToggle.hidden = false;
+  </script>
+
