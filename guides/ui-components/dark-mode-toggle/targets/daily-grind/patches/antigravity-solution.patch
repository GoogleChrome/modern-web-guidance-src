+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggle = document.getElementById('theme-toggle');
+
+      function getStoredScheme() {
+        try {
+          const val = localStorage.getItem('color-scheme');
+          if (val === 'light' || val === 'dark') return val;
+        } catch {}
+        if (meta.content === 'light' || meta.content === 'dark') {
+          return meta.content;
+        }
+        return null;
+      }
+
+      function getSystemScheme() {
+        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+      }
+
+      toggle.addEventListener('click', () => {
+        const systemScheme = getSystemScheme();
+        const storedScheme = getStoredScheme();
+        const currentRendered = storedScheme ?? systemScheme;
+        const targetScheme = currentRendered === 'dark' ? 'light' : 'dark';
+
+        if (targetScheme !== systemScheme) {
+          try {
+            localStorage.setItem('color-scheme', targetScheme);
+          } catch {}
+          meta.content = targetScheme;
+        } else {
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch {}
+          meta.content = 'light dark';
+        }
+      });
+
+      window.addEventListener('storage', (event) => {
+        if (event.key === 'color-scheme' || event.key === null) {
+          const val = event.key === null ? null : event.newValue;
+          meta.content = (val === 'light' || val === 'dark') ? val : 'light dark';
+        }
+      });
+    })();
+  </script>
+
