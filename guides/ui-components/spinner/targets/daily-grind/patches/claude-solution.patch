+  <script>
+    function resetBusyLinks() {
+      document.querySelectorAll('.btn[aria-busy="true"]').forEach(function (link) {
+        link.removeAttribute('aria-busy');
+        link.removeAttribute('aria-disabled');
+        var spinner = link.querySelector('.loading-spinner');
+        if (spinner) spinner.remove();
+      });
+    }
+
+    document.querySelectorAll('.btn[data-loading-label]').forEach(function (link) {
+      link.addEventListener('click', function (event) {
+        if (link.getAttribute('aria-busy') === 'true') {
+          event.preventDefault();
+          return;
+        }
+        if (event.defaultPrevented || event.button !== 0 ||
+            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        var spinner = document.createElement('progress');
+        spinner.className = 'loading-spinner';
+        spinner.setAttribute('aria-label', link.dataset.loadingLabel);
+        link.setAttribute('aria-busy', 'true');
+        link.setAttribute('aria-disabled', 'true');
+        link.prepend(spinner);
+      });
+    });
+
+    // Clear busy state when returning via back/forward cache.
+    window.addEventListener('pageshow', function (event) {
+      if (event.persisted) resetBusyLinks();
+    });
+  </script>
