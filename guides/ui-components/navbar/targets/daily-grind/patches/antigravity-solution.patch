+  <script>
+    (() => {
+      const header = document.querySelector(".site-header");
+      const inner = header?.querySelector(".header-inner");
+      const siteMenu = document.getElementById("site-menu");
+      if (!header || !inner || !siteMenu) return;
+
+      const navLinks = siteMenu.querySelectorAll("a[href]");
+      const currentPath = window.location.pathname;
+      const matchedLink = Array.from(navLinks).find((link) => {
+        const linkPath = new URL(link.getAttribute("href"), window.location.origin).pathname;
+        return linkPath === currentPath;
+      });
+      if (matchedLink) {
+        navLinks.forEach((link) => {
+          if (link === matchedLink) {
+            link.setAttribute("aria-current", "page");
+          } else {
+            link.removeAttribute("aria-current");
+          }
+        });
+      }
+
+      const dropdowns = header.querySelectorAll(".nav-dropdown");
+      let lastHeaderWidth = 0;
+      let measureRaf = 0;
+
+      const syncLayout = () => {
+        const isInline = header.classList.contains("is-wide");
+        const currentHeaderWidth = header.clientWidth;
+
+        if (!isInline && currentHeaderWidth <= lastHeaderWidth) {
+          lastHeaderWidth = currentHeaderWidth;
+          return;
+        }
+
+        const wasOpen = siteMenu.matches(":popover-open, .\\:popover-open");
+        header.classList.add("is-measuring");
+        cancelAnimationFrame(measureRaf);
+
+        siteMenu.removeAttribute("popover");
+        header.classList.add("is-wide");
+
+        const wide = inner.scrollWidth <= inner.clientWidth;
+        header.classList.toggle("is-wide", wide);
+
+        if (!wide) {
+          siteMenu.setAttribute("popover", "auto");
+          if (wasOpen) {
+            siteMenu.showPopover();
+          }
+        }
+
+        for (const item of dropdowns) {
+          const trigger = item.querySelector(".dropdown-trigger");
+          const submenu = item.querySelector(".dropdown-list");
+          if (!trigger || !submenu) continue;
+          if (wide) {
+            submenu.setAttribute("popover", "auto");
+          } else {
+            submenu.removeAttribute("popover");
+          }
+          submenu.hidden = !wide;
+          trigger.setAttribute("aria-expanded", "false");
+        }
+
+        lastHeaderWidth = header.clientWidth;
+        measureRaf = requestAnimationFrame(() => {
+          header.classList.remove("is-measuring");
+        });
+      };
+
+      for (const item of dropdowns) {
+        const trigger = item.querySelector(".dropdown-trigger");
+        const submenu = item.querySelector(".dropdown-list");
+        if (!trigger || !submenu) continue;
+
+        let isHoverPreview = false;
+
+        trigger.addEventListener("click", (event) => {
+          if (header.classList.contains("is-wide")) {
+            if (isHoverPreview) {
+              isHoverPreview = false;
+              event.preventDefault();
+            }
+          } else {
+            submenu.hidden = !submenu.hidden;
+            trigger.setAttribute("aria-expanded", String(!submenu.hidden));
+          }
+        });
+
+        submenu.addEventListener("toggle", (event) => {
+          const isOpen = event.newState === "open";
+          trigger.setAttribute("aria-expanded", String(isOpen));
+          if (!isOpen) {
+            isHoverPreview = false;
+          } else if (
+            header.classList.contains("is-wide") &&
+            !CSS.supports("position-area", "block-end")
+          ) {
+            const triggerRect = trigger.getBoundingClientRect();
+            const size = submenu.getBoundingClientRect();
+            let top = triggerRect.bottom + 8;
+            if (top + size.height > window.innerHeight) {
+              top = Math.max(0, triggerRect.top - size.height - 8);
+            }
+            const left = Math.min(
+              Math.max(0, triggerRect.left),
+              Math.max(0, window.innerWidth - size.width)
+            );
+            submenu.style.top = `${top}px`;
+            submenu.style.left = `${left}px`;
+          }
+        });
+
+        item.addEventListener("pointerenter", (event) => {
+          if (
+            header.classList.contains("is-wide") &&
+            window.matchMedia("(hover: hover)").matches &&
+            event.pointerType !== "touch" &&
+            !submenu.matches(":popover-open, .\\:popover-open")
+          ) {
+            isHoverPreview = true;
+            submenu.showPopover({ source: trigger });
+          }
+        });
+
+        item.addEventListener("pointerleave", () => {
+          if (header.classList.contains("is-wide") && isHoverPreview) {
+            isHoverPreview = false;
+            submenu.hidePopover();
+          }
+        });
+
+        item.addEventListener("focusout", (event) => {
+          if (
+            header.classList.contains("is-wide") &&
+            event.relatedTarget &&
+            !item.contains(event.relatedTarget) &&
+            submenu.matches(":popover-open, .\\:popover-open")
+          ) {
+            submenu.hidePopover();
+          }
+        });
+      }
+
+      const observer = new ResizeObserver(syncLayout);
+      observer.observe(header);
+      observer.observe(siteMenu);
+      syncLayout();
+    })();
+  </script>
 </body>
 
