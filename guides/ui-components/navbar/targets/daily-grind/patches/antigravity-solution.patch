+  <script type="module">
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    (() => {
+      const header = document.querySelector(".site-header");
+      const inner = header?.querySelector(".header-inner");
+      const siteMenu = document.getElementById("site-menu");
+      const menuButton = header?.querySelector(".menu-button");
+      const dropdown = header?.querySelector(".nav-dropdown");
+      const trigger = dropdown?.querySelector(".dropdown-trigger");
+      const submenu = dropdown?.querySelector(".dropdown-list");
+
+      if (!header || !inner || !siteMenu || !menuButton || !dropdown || !trigger || !submenu) {
+        return;
+      }
+
+      const updateCurrentPage = () => {
+        const currentPath = window.location.pathname;
+        const navLinks = Array.from(siteMenu.querySelectorAll("a[href]"));
+        const match = navLinks.find((link) => {
+          try {
+            const url = new URL(link.getAttribute("href"), window.location.href);
+            return url.origin === window.location.origin && url.pathname === currentPath;
+          } catch {
+            return false;
+          }
+        });
+
+        if (match) {
+          for (const link of navLinks) {
+            if (link === match) {
+              link.setAttribute("aria-current", "page");
+            } else {
+              link.removeAttribute("aria-current");
+            }
+          }
+        }
+      };
+      updateCurrentPage();
+
+      const setExpanded = (open) => trigger.setAttribute("aria-expanded", String(open));
+      const isOpen = (el) => el && el.matches(":is(:popover-open, .\\:popover-open)");
+
+      function placeSubmenu() {
+        const anchor = trigger.getBoundingClientRect();
+        const size = submenu.getBoundingClientRect();
+        const gap = 8;
+        let top = anchor.bottom + gap;
+        if (top + size.height > window.innerHeight) {
+          top = Math.max(0, anchor.top - gap - size.height);
+        }
+        const left = Math.max(0, Math.min(anchor.left, window.innerWidth - size.width));
+        submenu.style.top = `${top}px`;
+        submenu.style.left = `${left}px`;
+      }
+
+      const canHover = matchMedia("(hover: hover)");
+      let previewing = false;
+
+      submenu.hidden = true;
+      trigger.addEventListener("click", (event) => {
+        if (previewing) {
+          previewing = false;
+          event.preventDefault();
+          return;
+        }
+        if (submenu.matches("[popover]")) return;
+        submenu.hidden = !submenu.hidden;
+        setExpanded(!submenu.hidden);
+      });
+
+      submenu.addEventListener("toggle", (event) => {
+        setExpanded(event.newState === "open");
+        if (event.newState === "closed") previewing = false;
+
+        if (event.newState === "open" && !CSS.supports("position-area", "block-end")) {
+          placeSubmenu();
+        }
+      });
+
+      dropdown.addEventListener("pointerenter", (event) => {
+        if (event.pointerType === "touch" || !canHover.matches) return;
+        if (!submenu.matches("[popover]") || isOpen(submenu)) return;
+        previewing = true;
+        try {
+          submenu.showPopover({ source: trigger });
+        } catch {
+          submenu.showPopover();
+        }
+      });
+
+      dropdown.addEventListener("pointerleave", () => {
+        if (!previewing) return;
+        previewing = false;
+        submenu.hidePopover();
+      });
+
+      dropdown.addEventListener("focusout", (event) => {
+        if (!isOpen(submenu) || !event.relatedTarget || dropdown.contains(event.relatedTarget)) return;
+        submenu.hidePopover();
+      });
+
+      let lastWidth = -1;
+      let isWide;
+      let measureRaf = 0;
+
+      function syncLayoutState() {
+        const wasOpen = isOpen(siteMenu);
+        header.classList.add("is-measuring");
+        cancelAnimationFrame(measureRaf);
+
+        siteMenu.removeAttribute("popover");
+        header.classList.add("is-wide");
+
+        const wide = inner.scrollWidth <= inner.clientWidth;
+        header.classList.toggle("is-wide", wide);
+
+        if (!wide) {
+          siteMenu.setAttribute("popover", "auto");
+          if (wasOpen) {
+            siteMenu.showPopover();
+          }
+        }
+
+        measureRaf = requestAnimationFrame(() => {
+          header.classList.remove("is-measuring");
+        });
+
+        if (wide === isWide) return;
+        isWide = wide;
+
+        if (wide) {
+          submenu.setAttribute("popover", "auto");
+        } else {
+          submenu.removeAttribute("popover");
+        }
+        submenu.hidden = !wide;
+        setExpanded(false);
+      }
+
+      new ResizeObserver(() => {
+        const width = header.clientWidth;
+        const grew = width > lastWidth;
+        lastWidth = width;
+        if (isWide !== false || grew) syncLayoutState();
+      }).observe(header);
+
+      new ResizeObserver(() => {
+        if (isWide !== false) syncLayoutState();
+      }).observe(siteMenu);
+
+      syncLayoutState();
+    })();
+  </script>
