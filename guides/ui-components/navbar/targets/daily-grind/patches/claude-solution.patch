+  <script>
+    (function () {
+      var header = document.querySelector(".site-header");
+      var inner = header.querySelector(".header-inner");
+      var menu = document.getElementById("site-menu");
+
+      // Mark the current page
+      var path = location.pathname.replace(/\/+$/, "") || "/";
+      menu.querySelectorAll("a").forEach(function (a) {
+        var p = new URL(a.href, location.href).pathname.replace(/\/+$/, "") || "/";
+        if (p === path) a.setAttribute("aria-current", "page");
+      });
+
+      var lastWidth = 0;
+      function update(entries) {
+        var width = header.clientWidth;
+        var wide = header.classList.contains("is-wide");
+        if (!wide && width <= lastWidth && entries) { lastWidth = width; return; }
+        lastWidth = width;
+
+        var wasOpen = menu.matches(":popover-open");
+        header.classList.add("is-measuring");
+        if (menu.hasAttribute("popover")) menu.removeAttribute("popover");
+        header.classList.add("is-wide");
+        var fits = inner.scrollWidth <= inner.clientWidth;
+        header.classList.toggle("is-wide", fits);
+        if (fits) {
+          menu.removeAttribute("popover");
+        } else {
+          menu.setAttribute("popover", "auto");
+          if (wasOpen) menu.showPopover();
+        }
+        requestAnimationFrame(function () { header.classList.remove("is-measuring"); });
+      }
+
+      var ro = new ResizeObserver(update);
+      ro.observe(header);
+      ro.observe(menu);
+      update();
+    })();
+  </script>
+
 </body>
 
