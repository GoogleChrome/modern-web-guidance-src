+  <script type="module">
+    // MANDATORY: Feature detect 'popover' on HTMLElement.prototype; load the polyfill only when missing.
+    if (!Object.hasOwn(HTMLElement.prototype, "popover")) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const header = document.querySelector(".site-header");
+    const inner = header?.querySelector(".header-inner");
+    const menu = header?.querySelector("#site-menu");
+
+    if (header && inner && menu) {
+      const isOpen = (el) => el.matches(":popover-open") || el.classList.contains(":popover-open");
+      const canHover = matchMedia("(hover: hover)");
+      const supportsAnchor = CSS.supports("position-area", "block-end");
+
+      // --- Current page -------------------------------------------------
+      const normalize = (path) => path.replace(/\/index\.html$/, "/").replace(/(.)\/$/, "$1");
+      const here = normalize(location.pathname);
+      for (const link of header.querySelectorAll("a[href]")) {
+        const current = normalize(new URL(link.href, location.href).pathname) === here;
+        if (current) link.setAttribute("aria-current", "page");
+        else link.removeAttribute("aria-current");
+      }
+
+      // --- Submenus -----------------------------------------------------
+      const dropdowns = [...header.querySelectorAll(".nav-dropdown")].flatMap((item) => {
+        const trigger = item.querySelector(".dropdown-trigger");
+        const submenu = item.querySelector(".dropdown-list");
+        if (!trigger || !submenu) return [];
+        trigger.classList.toggle("has-current", !!submenu.querySelector('[aria-current="page"]'));
+        return [{ item, trigger, submenu, preview: false }];
+      });
+
+      let wide = false;
+
+      const placeSubmenu = ({ trigger, submenu }) => {
+        const anchor = trigger.getBoundingClientRect();
+        const size = submenu.getBoundingClientRect();
+        let top = anchor.bottom + 8;
+        if (top + size.height > innerHeight) top = Math.max(0, anchor.top - size.height - 8);
+        const left = Math.min(Math.max(0, anchor.left), Math.max(0, innerWidth - size.width));
+        submenu.style.top = `${top}px`;
+        submenu.style.left = `${left}px`;
+      };
+
+      for (const dropdown of dropdowns) {
+        const { item, trigger, submenu } = dropdown;
+
+        trigger.addEventListener("click", (event) => {
+          if (wide) {
+            // Clicking while hover-previewing pins the submenu open instead of toggling it closed.
+            if (dropdown.preview) {
+              dropdown.preview = false;
+              event.preventDefault();
+            }
+            return;
+          }
+          // Narrow layout: inline disclosure.
+          const expand = submenu.hidden;
+          submenu.hidden = !expand;
+          trigger.setAttribute("aria-expanded", String(expand));
+        });
+
+        submenu.addEventListener("toggle", (event) => {
+          const open = event.newState === "open";
+          trigger.setAttribute("aria-expanded", String(open));
+          if (!open) dropdown.preview = false;
+          if (open && !supportsAnchor) placeSubmenu(dropdown);
+        });
+
+        item.addEventListener("pointerenter", (event) => {
+          if (!wide || !canHover.matches || event.pointerType === "touch") return;
+          if (!submenu.hasAttribute("popover") || isOpen(submenu)) return;
+          dropdown.preview = true;
+          submenu.showPopover({ source: trigger });
+        });
+
+        item.addEventListener("pointerleave", (event) => {
+          if (!wide || event.pointerType === "touch") return;
+          if (dropdown.preview && isOpen(submenu)) submenu.hidePopover();
+          dropdown.preview = false;
+        });
+
+        item.addEventListener("focusout", (event) => {
+          if (!wide || !isOpen(submenu)) return;
+          const next = event.relatedTarget;
+          if (next instanceof Node && !item.contains(next)) submenu.hidePopover();
+        });
+      }
+
+      const syncSubmenus = () => {
+        for (const dropdown of dropdowns) {
+          const { trigger, submenu } = dropdown;
+          if (wide) {
+            submenu.setAttribute("popover", "auto");
+          } else {
+            submenu.removeAttribute("popover");
+            submenu.style.removeProperty("top");
+            submenu.style.removeProperty("left");
+          }
+          submenu.hidden = !wide;
+          dropdown.preview = false;
+          trigger.setAttribute("aria-expanded", "false");
+        }
+      };
+
+      // --- Layout -------------------------------------------------------
+      let lastWidth = -1;
+      let initialized = false;
+
+      const updateLayout = () => {
+        const width = header.clientWidth;
+        const grew = width > lastWidth;
+        lastWidth = width;
+        // While collapsed, only remeasure when the header has grown (avoids thrashing).
+        if (initialized && !wide && !grew) return;
+
+        const menuWasOpen = menu.hasAttribute("popover") && isOpen(menu);
+
+        header.classList.add("is-measuring", "is-wide");
+        // Measure the list inline (in flow), not as a top-layer popover.
+        menu.removeAttribute("popover");
+        const fits = inner.scrollWidth <= inner.clientWidth;
+        header.classList.toggle("is-wide", fits);
+
+        if (!fits) {
+          menu.setAttribute("popover", "auto");
+          if (menuWasOpen) menu.showPopover();
+        }
+
+        if (!initialized || fits !== wide) {
+          wide = fits;
+          syncSubmenus();
+        }
+        initialized = true;
+
+        requestAnimationFrame(() => header.classList.remove("is-measuring"));
+      };
