diff --git a/navigation.js b/navigation.js
new file mode 100644
index 0000000..b5dc4de
--- /dev/null
+++ b/navigation.js
@@ -0,0 +1,101 @@
+// Load the fallback only on browsers without native popovers.
+if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
+  await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+}
+
+const header = document.querySelector('.site-header');
+const inner = document.querySelector('.header-inner');
+const menu = document.querySelector('#site-menu');
+const trigger = document.querySelector('.dropdown-trigger');
+const submenu = document.querySelector('#coffee-menu');
+const dropdown = document.querySelector('.nav-dropdown');
+
+if (header instanceof HTMLElement && inner instanceof HTMLElement &&
+    menu instanceof HTMLElement && trigger instanceof HTMLButtonElement &&
+    submenu instanceof HTMLElement && dropdown instanceof HTMLElement) {
+  let wide = false;
+  let previousWidth = -1;
+  let preview = false;
+  let initialized = false;
+  const isOpen = (element) => element.matches(':is(:popover-open, .\\:popover-open)');
+  const positionSubmenu = () => {
+    if (!wide || !isOpen(submenu) || CSS.supports('position-area', 'block-end')) return;
+    const rect = trigger.getBoundingClientRect();
+    const size = submenu.getBoundingClientRect();
+    const top = rect.bottom + 8;
+    submenu.style.insetBlockStart = `${Math.max(0, top + size.height > innerHeight ? rect.top - size.height - 8 : top)}px`;
+    submenu.style.insetInlineStart = `${Math.max(0, Math.min(rect.left, innerWidth - size.width))}px`;
+  };
+
+  const measure = () => {
+    const width = inner.clientWidth;
+    if (!wide && width <= previousWidth) return;
+    previousWidth = width;
+    const wasOpen = isOpen(menu);
+    header.classList.add('is-measuring', 'is-wide');
+    menu.removeAttribute('popover');
+    const nextWide = inner.scrollWidth <= width;
+    header.classList.toggle('is-wide', nextWide);
+    if (!nextWide) {
+      menu.setAttribute('popover', 'auto');
+      if (wasOpen) menu.showPopover();
+    }
+    if (nextWide !== wide || !initialized) {
+      preview = false;
+      submenu.style.removeProperty('inset-block-start');
+      submenu.style.removeProperty('inset-inline-start');
+      if (nextWide) submenu.setAttribute('popover', 'auto');
+      else submenu.removeAttribute('popover');
+      submenu.hidden = !nextWide;
+      trigger.setAttribute('aria-expanded', 'false');
+      initialized = true;
+    }
+    wide = nextWide;
+    positionSubmenu();
+    requestAnimationFrame(() => header.classList.remove('is-measuring'));
+  };
+
+  trigger.addEventListener('click', (event) => {
+    if (!wide) {
+      event.preventDefault();
+      submenu.hidden = !submenu.hidden;
+      trigger.setAttribute('aria-expanded', String(!submenu.hidden));
+    } else if (preview) {
+      preview = false;
+      event.preventDefault();
+    }
+  });
+  submenu.addEventListener('toggle', () => {
+    if (!wide) return;
+    const open = isOpen(submenu);
+    trigger.setAttribute('aria-expanded', String(open));
+    if (!open) preview = false;
+    positionSubmenu();
+  });
+  dropdown.addEventListener('pointerenter', (event) => {
+    if (wide && event.pointerType !== 'touch' && matchMedia('(hover: hover)').matches && !isOpen(submenu)) {
+      preview = true;
+      submenu.showPopover({ source: trigger });
+    }
+  });
+  dropdown.addEventListener('pointerleave', () => {
+    if (wide && preview && isOpen(submenu)) submenu.hidePopover();
+    preview = false;
+  });
+  dropdown.addEventListener('focusout', (event) => {
+    if (wide && event.relatedTarget instanceof Node && !dropdown.contains(event.relatedTarget) && isOpen(submenu)) submenu.hidePopover();
+  });
+  const observer = new ResizeObserver(measure);
+  observer.observe(inner);
+  observer.observe(menu);
+  measure();
+  window.addEventListener('resize', positionSubmenu);
+  window.addEventListener('scroll', positionSubmenu, { passive: true });
+}
+
+const currentPath = location.pathname.replace(/\/+$/, '') || '/';
+for (const link of document.querySelectorAll('.site-header a[href]')) {
+  if (link instanceof HTMLAnchorElement && (new URL(link.href).pathname.replace(/\/+$/, '') || '/') === currentPath) {
+    link.setAttribute('aria-current', 'page');
+  }
+}
