+  <script type="module">
+    const header = document.querySelector('.site-header');
+    const inner = header.querySelector('.header-inner');
+    const menu = header.querySelector('.site-menu');
+    const button = header.querySelector('.menu-button');
+    const normalizePath = (path) => path.replace(/\/index\.html$/, '/').replace(/\/+$/, '') || '/';
+    const currentPath = normalizePath(window.location.pathname);
+
+    for (const link of header.querySelectorAll('a[href]')) {
+      const path = normalizePath(new URL(link.href).pathname);
+      if (path === currentPath) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    }
+
+    if ('showPopover' in HTMLElement.prototype && 'ResizeObserver' in window) {
+      let previousWidth = -1;
+      let pending = false;
+
+      const updateLayout = () => {
+        pending = false;
+        const width = inner.clientWidth;
+        const wasWide = header.classList.contains('is-wide');
+        if (!wasWide && width <= previousWidth) return;
+        previousWidth = width;
+
+        const wasOpen = menu.matches(':popover-open');
+        const focusedElement = document.activeElement;
+        header.classList.add('is-measuring', 'is-wide');
+        menu.removeAttribute('popover');
+        const wide = inner.scrollWidth <= inner.clientWidth;
+        header.classList.toggle('is-wide', wide);
+
+        if (!wide) {
+          menu.setAttribute('popover', 'auto');
+          if (wasOpen) menu.showPopover();
+          else if (menu.contains(focusedElement)) button.focus();
+        } else if (focusedElement === button) {
+          (menu.querySelector('[aria-current="page"]') || menu.querySelector('a')).focus();
+        }
+
+        requestAnimationFrame(() => header.classList.remove('is-measuring'));
+      };
+
+      const scheduleLayout = () => {
+        if (pending) return;
+        pending = true;
+        requestAnimationFrame(updateLayout);
+      };
+
+      const observer = new ResizeObserver(scheduleLayout);
+      observer.observe(inner);
+      observer.observe(menu);
+      scheduleLayout();
+    }
+  </script>
 </body>
 
