+    /* Seasonal favorite cards */
+    .grid {
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
+    }
+
+    article.card {
+      container-type: inline-size;
+      display: grid;
+      grid-row: span 4;
+      grid-template-rows: subgrid;
+      row-gap: 10px;
+      padding: 0;
+      overflow: hidden;
+      align-content: start;
+    }
+
+    article.card > :not(img) {
+      margin-inline: 20px;
+    }
+
+    article.card > img {
+      width: 100%;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      display: block;
+    }
+
+    article.card > h3 {
+      margin: 10px 20px 0;
+    }
+
+    article.card > footer {
+      background: none;
+      padding: 0;
+      margin-top: 0;
+      margin-bottom: 20px;
+      display: flex;
+      flex-direction: column;
+      align-items: stretch;
+      gap: 10px;
+      text-align: center;
+    }
+
+    article.card .order-form {
+      display: flex;
+      flex-direction: column;
+      gap: 10px;
+    }
+
+    article.card label {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      gap: 8px;
+    }
+
+    article.card select {
+      font: inherit;
+      padding: 6px 10px;
+      border: 1px solid var(--primary);
+      border-radius: 5px;
+      background: white;
+      color: var(--text);
+    }
+
+    article.card .btn {
+      margin-top: 0;
+      border: 2px solid var(--primary);
+      font: inherit;
+      cursor: pointer;
+      text-align: center;
+    }
+
+    article.card .btn-secondary {
+      background: transparent;
+      color: var(--primary);
+    }
+
+    article.card .btn-secondary:hover {
+      background: var(--secondary);
+    }
+
+    article.card .btn:focus-visible,
+    article.card select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .visually-hidden {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    .order-status {
+      text-align: center;
+      margin-top: 20px;
+      min-height: 1.6em;
+    }
+
+    .card:has(> img) {
+      grid-template-columns: 40% 1fr;
+    }
+
+    @container (max-width: 419.98px) {
+      .card:has(> img) > * {
+        grid-column: 1 / -1;
+      }
+    }
+
+    @container (min-width: 420px) {
+      .card > img {
+        grid-column: 1;
+        grid-row: 1 / span 4;
+        height: 100%;
+        aspect-ratio: auto;
+      }
+
+      .card > :not(img) {
+        grid-column: 2;
+      }
+
+      article.card > :not(img),
+      article.card > footer {
+        text-align: left;
+      }
+    }
+
+    @container (max-width: 260px) {
+      .card > p {
+        font-size: 0.9rem;
+      }
+    }
