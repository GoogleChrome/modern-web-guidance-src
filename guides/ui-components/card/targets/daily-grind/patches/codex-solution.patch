+  <script>
+    // @ts-check
+    const orderItems = document.getElementById('order-items');
+    const orderEmpty = document.getElementById('order-empty');
+    const orderStatus = document.getElementById('order-status');
+    /** @type {Map<string, {quantity: number, element: HTMLLIElement}>} */
+    const order = new Map();
+
+    document.querySelectorAll('form[data-drink]').forEach((form) => {
+      if (!(form instanceof HTMLFormElement)) return;
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const drink = form.dataset.drink;
+        const size = new FormData(form).get('size');
+        if (!drink || typeof size !== 'string' || !['small', 'medium', 'large'].includes(size)) return;
+        if (!orderItems || !orderEmpty || !orderStatus) return;
+
+        const key = JSON.stringify([drink, size]);
+        let item = order.get(key);
+        if (!item) {
+          item = { quantity: 0, element: document.createElement('li') };
+          order.set(key, item);
+          orderItems.append(item.element);
+        }
+        item.quantity += 1;
+        item.element.textContent = `${item.quantity} × ${size} ${drink}`;
+        orderEmpty.hidden = true;
+        const total = Array.from(order.values()).reduce((sum, entry) => sum + entry.quantity, 0);
+        orderStatus.textContent = `Added ${size} ${drink}. Your order has ${total} ${total === 1 ? 'drink' : 'drinks'}.`;
+      });
+    });
+  </script>
