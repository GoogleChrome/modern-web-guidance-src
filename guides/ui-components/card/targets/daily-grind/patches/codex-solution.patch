+  <script type="module">
+    const forms = document.querySelectorAll('.card form');
+    const items = document.getElementById('order-items');
+    const status = document.getElementById('order-status');
+    const sizes = ['small', 'medium', 'large'];
+    const drinks = Array.from(forms, form => form.getAttribute('data-drink'));
+    /** @type {{drink: string, size: string, quantity: number}[]} */
+    let order = [];
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-order') || '[]');
+      if (Array.isArray(saved)) {
+        order = saved.filter(item => item && drinks.includes(item.drink) && sizes.includes(item.size)
+          && Number.isSafeInteger(item.quantity) && item.quantity > 0);
+      }
+    } catch { /* Ordering remains available when storage is unavailable. */ }
+
+    function renderOrder() {
+      if (!items) return;
+      items.replaceChildren();
+      for (const item of order) {
+        const row = document.createElement('li');
+        row.textContent = `${item.quantity} × ${item.size} ${item.drink} `;
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.textContent = 'Remove';
+        remove.setAttribute('aria-label', `Remove ${item.size} ${item.drink} from order`);
+        remove.addEventListener('click', () => {
+          order = order.filter(entry => entry !== item);
+          saveOrder();
+          renderOrder();
+          if (status) status.textContent = `Removed ${item.size} ${item.drink}.`;
+          const addButton = document.querySelector('.card button');
+          if (addButton instanceof HTMLButtonElement) addButton.focus();
+        });
+        row.append(remove);
+        items.append(row);
+      }
+    }
+
+    function saveOrder() {
+      try { localStorage.setItem('daily-grind-order', JSON.stringify(order)); }
+      catch { /* Keep the current order in memory if storage is unavailable. */ }
+    }
+
+    renderOrder();
+    if (order.length && status) status.textContent = 'Your saved order is ready to review.';
+    forms.forEach(form => {
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        const select = form.querySelector('select');
+        const drink = form.getAttribute('data-drink');
+        if (!(select instanceof HTMLSelectElement) || !drink || !sizes.includes(select.value)) return;
+        const size = select.value;
+        const existing = order.find(item => item.drink === drink && item.size === size);
+        if (existing) existing.quantity += 1;
+        else order.push({ drink, size, quantity: 1 });
+        saveOrder();
+        renderOrder();
+        if (status) status.textContent = `Added ${size} ${drink} to your order.`;
+      });
+    });
+  </script>
