+    document.querySelectorAll('.add-to-order').forEach((button) => {
+      button.addEventListener('click', () => {
+        const card = button.closest('.card');
+        if (!card) return;
+        const drink = card.dataset.drink || card.querySelector('h3')?.textContent?.trim() || 'Drink';
+        const selectedSize = card.querySelector('input[type="radio"]:checked')?.value || 'Medium';
+        const status = document.getElementById('order-status');
+        if (status) {
+          status.textContent = `Added ${selectedSize} ${drink} to your order.`;
+        }
+      });
+    });
+  </script>
