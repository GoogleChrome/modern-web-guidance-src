diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..6f958c9
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,54 @@
+---
+interface Props {
+  sections: { id: string; label: string }[];
+}
+
+const { sections } = Astro.props;
+---
+
+<nav class="section-nav" aria-label="On this page" data-scrollspy>
+  {sections.map(({ id, label }) => (
+    <a href={`#${id}`} aria-current="false">{label}</a>
+  ))}
+</nav>
+
+<style>
+  .section-nav {
+    scroll-target-group: auto;
+    position: sticky;
+    top: 0;
+    z-index: 20;
+    display: flex;
+    justify-content: center;
+    gap: clamp(0.25rem, 2vw, 1.5rem);
+    padding: 0.5rem;
+    background: white;
+    border-block: 1px solid #d1d5db;
+  }
+
+  a {
+    padding: 0.5rem 0.375rem;
+    border-bottom: 3px solid transparent;
+    color: #374151;
+    font-size: 0.875rem;
+    font-weight: 600;
+    white-space: nowrap;
+  }
+
+  a:is(:target-current, .\:target-current) {
+    color: #92400e;
+    border-bottom-color: currentColor;
+    background: #fffbeb;
+    text-decoration: underline;
+    text-underline-offset: 0.2em;
+  }
+
+  a:focus-visible {
+    outline: 2px solid #92400e;
+    outline-offset: 2px;
+  }
+</style>
+
+<script>
+  import '../scripts/scrollspy';
+</script>
