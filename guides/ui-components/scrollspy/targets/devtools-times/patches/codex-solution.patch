diff --git a/src/scripts/scrollspy.ts b/src/scripts/scrollspy.ts
new file mode 100644
index 0000000..bec5a2c
--- /dev/null
+++ b/src/scripts/scrollspy.ts
@@ -0,0 +1,84 @@
+/** Track only this page's section links, leaving the site navigation untouched. */
+export function initScrollspy(): (() => void) | undefined {
+  const nav = document.querySelector<HTMLElement>('[data-scrollspy]');
+  if (!nav) return;
+
+  const targets = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
+    .flatMap((link) => {
+      const section = document.getElementById(link.hash.slice(1));
+      return section ? [{ link, section }] : [];
+    });
+  if (!targets.length) return;
+
+  const native = CSS.supports('scroll-target-group: auto') &&
+    CSS.supports('selector(a:target-current)');
+  const controller = new AbortController();
+  const { signal } = controller;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let frame = 0;
+
+  function sync() {
+    // Native CSS is the source of truth wherever the complete feature is supported.
+    const nativeLink = native
+      ? nav?.querySelector<HTMLAnchorElement>('a:target-current')
+      : null;
+    const readingLine = Math.max(80, (nav?.getBoundingClientRect().height ?? 0) + 16) + 1;
+    let current = targets[0];
+    for (const target of targets) {
+      if (target.section.getBoundingClientRect().top <= readingLine) current = target;
+    }
+    // The final section can be too short to reach the reading line.
+    if (window.scrollY > 0 &&
+        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+      current = targets[targets.length - 1];
+    }
+    const activeLink = nativeLink ?? current.link;
+    for (const { link } of targets) {
+      const active = link === activeLink;
+      link.setAttribute('aria-current', String(active));
+      link.classList.toggle(':target-current', !native && active);
+    }
+  }
+
+  function schedule() {
+    cancelAnimationFrame(frame);
+    frame = requestAnimationFrame(sync);
+  }
+
+  // The observer handles the fallback; the scroll listener also covers long
+  // sections, gaps, and browsers without a scrollend event.
+  const observer = !native ? new IntersectionObserver(schedule, {
+    rootMargin: '-64px 0px -50% 0px',
+    threshold: [0, 0.5, 1],
+  }) : undefined;
+  targets.forEach(({ section }) => observer?.observe(section));
+
+  document.addEventListener('scroll', () => {
+    if (!native) schedule();
+    clearTimeout(timer);
+    timer = setTimeout(schedule, 120);
+  }, { passive: true, signal });
+  document.addEventListener('scrollend', schedule, { signal });
+  window.addEventListener('hashchange', schedule, { signal });
+  window.addEventListener('resize', schedule, { signal });
+  window.addEventListener('load', schedule, { signal });
+  sync();
+  schedule();
+
+  return () => {
+    controller.abort();
+    observer?.disconnect();
+    clearTimeout(timer);
+    cancelAnimationFrame(frame);
+  };
+}
+
+let cleanup: (() => void) | undefined;
+function initialize() {
+  cleanup?.();
+  cleanup = initScrollspy();
+}
+
+initialize();
+document.addEventListener('astro:page-load', initialize);
+document.addEventListener('astro:before-swap', () => cleanup?.());
