diff --git a/src/components/ScrollSpyNav.astro b/src/components/ScrollSpyNav.astro
new file mode 100644
index 0000000..685eda8
--- /dev/null
+++ b/src/components/ScrollSpyNav.astro
@@ -0,0 +1,95 @@
+---
+export interface Section {
+  id: string;
+  label: string;
+}
+
+export interface Props {
+  sections: Section[];
+}
+
+const { sections } = Astro.props;
+---
+
+<nav
+  data-scrollspy-nav
+  aria-label="Page sections"
+  class="scrollspy-nav sticky top-0 z-20 flex flex-wrap gap-x-6 gap-y-1 border-b border-gray-200 bg-white/95 px-4 py-3 backdrop-blur-sm md:px-6"
+>
+  {
+    sections.map((section) => (
+      <a
+        href={`#${section.id}`}
+        aria-current="false"
+        class="scrollspy-nav__link border-b-2 border-transparent pb-1 text-sm font-semibold text-gray-600 transition-colors hover:text-amber-500"
+      >
+        {section.label}
+      </a>
+    ))
+  }
+</nav>
+
+<script>
+  function initScrollSpy() {
+    const nav = document.querySelector<HTMLElement>('[data-scrollspy-nav]');
+    if (!nav) return;
+
+    const navLinks = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
+    const supportsScrollTargetGroup = CSS.supports('scroll-target-group: auto');
+
+    if (supportsScrollTargetGroup) {
+      const syncAriaCurrent = () => {
+        const currentLink = nav.querySelector<HTMLAnchorElement>('a:target-current');
+        navLinks.forEach((link) => {
+          link.setAttribute('aria-current', link === currentLink ? 'true' : 'false');
+        });
+      };
+
+      // Sync once on load, then keep in sync once scrolling settles.
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else {
+      // Fallback for browsers without native scroll-target-group support.
+      const sections = navLinks
+        .map((link) => document.getElementById(link.getAttribute('href')?.slice(1) ?? ''))
+        .filter((el): el is HTMLElement => el !== null);
+
+      const observer = new IntersectionObserver(
+        (entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              const id = entry.target.getAttribute('id');
+              navLinks.forEach((link) => {
+                const isActive = link.getAttribute('href') === `#${id}`;
+                link.classList.toggle('\:target-current', isActive);
+                link.setAttribute('aria-current', isActive ? 'true' : 'false');
+              });
+            }
+          });
+        },
+        { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
+      );
+
+      sections.forEach((section) => observer.observe(section));
+    }
+  }
+
+  // Re-run after every Astro view transition navigation as well as the first load.
+  document.addEventListener('astro:page-load', initScrollSpy);
+</script>
+
+<style>
+  /* MANDATORY: The container of markers must have scroll-target-group: auto */
+  .scrollspy-nav {
+    scroll-target-group: auto;
+  }
+
+  /* MANDATORY: Use :is() so unsupported browsers don't drop the whole rule,
+     and mirror the fallback ":target-current" class applied by the
+     IntersectionObserver fallback script. */
+  .scrollspy-nav__link:is(:target-current, .\:target-current) {
+    color: var(--accent, #b45309);
+    border-bottom-color: currentColor;
+    font-weight: 700;
+  }
+</style>
