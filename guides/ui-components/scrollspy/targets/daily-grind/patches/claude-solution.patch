+  <script type="module">
+    // Scrollspy: keep aria-current in sync with the highlighted section link.
+    const sectionLinks = Array.from(
+      document.querySelectorAll('.nav-sections a[href^="#"]')
+    );
+
+    if (CSS.supports('scroll-target-group: auto')) {
+      // Native support: :target-current handles the visual state; mirror it
+      // with aria-current for assistive technologies.
+      const syncAriaCurrent = () => {
+        const currentLink = document.querySelector('.nav-sections a:target-current');
+        sectionLinks.forEach((link) => {
+          link.setAttribute('aria-current', link === currentLink ? 'true' : 'false');
+        });
+      };
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else if ('IntersectionObserver' in window) {
+      // Fallback: track the section crossing the middle of the viewport.
+      const sections = sectionLinks
+        .map((link) => document.getElementById(link.getAttribute('href').slice(1)))
+        .filter((section) => section !== null);
+
+      const observer = new IntersectionObserver((entries) => {
+        entries.forEach((entry) => {
+          if (!entry.isIntersecting) return;
+          const id = entry.target.getAttribute('id');
+          sectionLinks.forEach((link) => {
+            const isActive = link.getAttribute('href') === `#${id}`;
+            link.classList.toggle('target-current', isActive);
+            link.setAttribute('aria-current', isActive ? 'true' : 'false');
+          });
+        });
+      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
+
+      sections.forEach((section) => observer.observe(section));
+    }
+  </script>
+
 </body>
 
