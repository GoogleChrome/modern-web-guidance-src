diff --git a/scrollspy.js b/scrollspy.js
new file mode 100644
index 0000000..40ede60
--- /dev/null
+++ b/scrollspy.js
@@ -0,0 +1,76 @@
+// @ts-check
+const nav = document.querySelector('nav');
+const links = Array.from(document.querySelectorAll('nav ul a[href^="#"]'))
+  .filter((link) => link instanceof HTMLAnchorElement);
+const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+  CSS.supports('selector(:target-current)');
+
+/** @param {Element | null} current */
+function markCurrent(current) {
+  for (const link of links) {
+    link.setAttribute('aria-current', link === current ? 'true' : 'false');
+    link.classList.toggle('target-current', !nativeTracking && link === current);
+  }
+}
+
+function syncCurrent() {
+  if (nativeTracking) {
+    markCurrent(document.querySelector('nav ul a:target-current'));
+    return;
+  }
+
+  // Select by document order, independent of IntersectionObserver entry order.
+  const readingLine = (nav?.getBoundingClientRect().height ?? 0) + 24;
+  let current = links[0] ?? null;
+  sections.forEach((section, index) => {
+    if (section && section.getBoundingClientRect().top <= readingLine) {
+      current = links[index];
+    }
+  });
+  // The last section may be too short to reach the reading line.
+  if (window.scrollY > 0 && window.innerHeight + window.scrollY >=
+      document.documentElement.scrollHeight - 2) {
+    current = links[links.length - 1] ?? null;
+  }
+  markCurrent(current);
+}
+
+let scheduled = false;
+function scheduleSync() {
+  if (scheduled) return;
+  scheduled = true;
+  requestAnimationFrame(() => {
+    scheduled = false;
+    syncCurrent();
+  });
+}
+
+function updateNavHeight() {
+  document.documentElement.style.setProperty('--nav-height',
+    `${nav?.getBoundingClientRect().height ?? 80}px`);
+  scheduleSync();
+}
+
+if (nav) new ResizeObserver(updateNavHeight).observe(nav);
+updateNavHeight();
+
+if (!nativeTracking) {
+  const observer = new IntersectionObserver(scheduleSync, { threshold: [0, 0.5, 1] });
+  sections.forEach(section => { if (section) observer.observe(section); });
+  document.addEventListener('scroll', scheduleSync, { passive: true });
+} else {
+  // Debouncing also covers browsers without the scrollend event.
+  let scrollTimer = 0;
+  document.addEventListener('scroll', () => {
+    window.clearTimeout(scrollTimer);
+    scrollTimer = window.setTimeout(scheduleSync, 120);
+  }, { passive: true });
+}
+
+document.addEventListener('scrollend', scheduleSync);
+window.addEventListener('hashchange', scheduleSync);
+window.addEventListener('pageshow', scheduleSync);
+window.addEventListener('resize', updateNavHeight);
+window.addEventListener('load', scheduleSync);
+scheduleSync();
