+  <script type="module">
+    /**
+     * Carousel controller: wires the HTML previous/next and marker buttons,
+     * keeps the active marker in sync, announces settled slides, and parks an
+     * end slide (CSS `order`) so navigation loops without cloning slides.
+     * @param {HTMLElement} carousel
+     */
+    function initCarousel(carousel) {
+      const track = carousel.querySelector('.carousel-track');
+      const prevButton = carousel.querySelector('[data-direction="previous"]');
+      const nextButton = carousel.querySelector('[data-direction="next"]');
+      const status = carousel.querySelector('[role="status"]');
+      const markerNav = carousel.querySelector('.carousel-markers');
+      const layoutGroup = carousel.querySelector('.carousel-layout');
+
+      if (!(track instanceof HTMLElement) || !(prevButton instanceof HTMLButtonElement) ||
+        !(nextButton instanceof HTMLButtonElement) || !(status instanceof HTMLElement) ||
+        !(markerNav instanceof HTMLElement)) {
+        return;
+      }
+
+      /** @type {HTMLElement[]} */
+      const slides = Array.from(track.children).filter((el) => el instanceof HTMLElement);
+      const total = slides.length;
+      if (total === 0) return;
+
+      const looping = total >= 3 &&
+        !carousel.hasAttribute('data-finite') &&
+        CSS.supports('order', 'calc(sibling-index() - sibling-count())');
+
+      /** Slide the in-flight click/marker navigation is heading to. @type {HTMLElement | null} */
+      let pendingTarget = null;
+      /** Original index of the last settled slide. @type {number} */
+      let settledIndex = 0;
+      /** Original index of the slide whose marker is active. @type {number} */
+      let markerIndex = -1;
+      /** Original index currently written to --current. @type {number | null} */
+      let parkedFor = null;
+
+      const isVertical = () => carousel.dataset.orientation === 'vertical';
+
+      /** Distance from the track's center to the slide's center on the scrolling axis. */
+      const offsetFromCenter = (/** @type {HTMLElement} */ slide) => {
+        const t = track.getBoundingClientRect();
+        const s = slide.getBoundingClientRect();
+        return isVertical()
+          ? (s.top + s.height / 2) - (t.top + t.height / 2)
+          : (s.left + s.width / 2) - (t.left + t.width / 2);
+      };
+
+      /** Slide start position on the scrolling axis (viewport coordinates). */
+      const axisStart = (/** @type {HTMLElement} */ slide) => {
+        const r = slide.getBoundingClientRect();
+        return isVertical() ? r.top : r.left;
+      };
+
+      const scrollPosition = () => (isVertical() ? track.scrollTop : track.scrollLeft);
+
+      /** @param {number} delta @param {ScrollBehavior} behavior */
+      const scrollTrackBy = (delta, behavior) => {
+        track.scrollBy(isVertical() ? { top: delta, behavior } : { left: delta, behavior });
+      };
+
+      /** Slides sorted by visual position (differs from DOM order while a slide is parked). */
+      const visualOrder = () => slides.slice().sort((a, b) => axisStart(a) - axisStart(b));
+
+      const nearestSlide = () => {
+        let best = slides[0];
+        let bestDistance = Infinity;
+        for (const slide of slides) {
+          const distance = Math.abs(offsetFromCenter(slide));
+          if (distance < bestDistance) {
+            bestDistance = distance;
+            best = slide;
+          }
+        }
+        return best;
+      };
+
+      // Markers: one named button per slide.
+      /** @type {HTMLButtonElement[]} */
+      const markers = slides.map((slide, index) => {
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.setAttribute('aria-label', slide.dataset.markerName ?? `Go to slide ${index + 1}`);
+        button.addEventListener('click', () => goTo(slide));
+        markerNav.append(button);
+        return button;
+      });
+
+      /** @param {number} index */
+      const setActiveMarker = (index) => {
+        if (index === markerIndex) return;
+        markerIndex = index;
+        markers.forEach((marker, i) => {
+          if (i === index) marker.setAttribute('aria-current', 'true');
+          else marker.removeAttribute('aria-current');
+        });
+      };
+
+      /** Scroll the track (never the page) so the slide sits at its snap position. */
+      const goTo = (/** @type {HTMLElement} */ slide) => {
+        const delta = offsetFromCenter(slide);
+        if (Math.abs(delta) < 1) {
+          pendingTarget = null;
+          setActiveMarker(slides.indexOf(slide));
+          return;
+        }
+        pendingTarget = slide;
+        setActiveMarker(slides.indexOf(slide));
+        // 'auto' defers to the CSS scroll-behavior, which is smooth only without reduced motion.
+        scrollTrackBy(delta, 'auto');
+      };
+
+      /** @param {1 | -1} direction */
+      const step = (direction) => {
+        const order = visualOrder();
+        const base = pendingTarget ?? nearestSlide();
+        const target = order[order.indexOf(base) + direction];
+        if (target) goTo(target);
+      };
+
+      const updateButtons = () => {
+        if (looping) {
+          prevButton.disabled = false;
+          nextButton.disabled = false;
+          return;
+        }
+        const order = visualOrder();
+        const position = order.indexOf(slides[settledIndex]);
+        prevButton.disabled = position <= 0;
+        nextButton.disabled = position >= order.length - 1;
+      };
+
+      /** Which slides the CSS parks for a given --current value. */
+      const parkedSlides = (/** @type {number} */ current) => {
+        /** @type {HTMLElement[]} */
+        const parked = [];
+        if (current >= total - 2) parked.push(slides[0]);
+        if (current <= 1) parked.push(slides[total - 1]);
+        return parked.filter((slide) => slide !== slides[current]);
+      };
