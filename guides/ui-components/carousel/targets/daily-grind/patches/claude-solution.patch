+      /** Update --current and invisibly compensate the scroll if the parking changes. */
+      const park = (/** @type {number} */ index) => {
+        if (!looping) return;
+        if (parkedFor !== index) {
+          const current = slides[index];
+          const before = axisStart(current);
+          const overflowProperty = isVertical() ? 'overflowY' : 'overflowX';
+
+          track.style.scrollSnapType = 'none';
+          track.style[overflowProperty] = 'hidden';
+          track.style.setProperty('--current', String(index));
+          const after = axisStart(current);
+          if (after !== before) scrollTrackBy(after - before, 'instant');
+          track.style.scrollSnapType = '';
+          parkedFor = index;
+
+          // Restoring the overflow immediately breaks looping (and flickers on iOS Safari).
+          requestAnimationFrame(() => requestAnimationFrame(() => {
+            track.style.overflowX = '';
+            track.style.overflowY = '';
+          }));
+        }
+        const parked = parkedSlides(index);
+        slides.forEach((slide) => { slide.inert = parked.includes(slide); });
+      };
+
+      /** Single handler driven by the settled scroll position. */
+      const settle = () => {
+        pendingTarget = null;
+        const index = slides.indexOf(nearestSlide());
+        park(index);
+        setActiveMarker(index);
+        if (index !== settledIndex) {
+          settledIndex = index;
+          status.textContent = `Slide ${index + 1} of ${total}`;
+        }
+        updateButtons();
+      };
+
+      const onScrollEnd = () => {
+        if (pendingTarget && Math.abs(offsetFromCenter(pendingTarget)) <= 2) {
+          settle();
+          return;
+        }
+        // A scrollend that arrives after the next scroll has started must be ignored,
+        // so only settle once the position has stayed put for two frames.
+        const position = scrollPosition();
+        requestAnimationFrame(() => requestAnimationFrame(() => {
+          if (Math.abs(scrollPosition() - position) > 0.5) return;
+          settle();
+        }));
+      };
+
+      // Live marker updates, throttled to one per frame, skipped while a target is pending.
+      let frame = 0;
+      track.addEventListener('scroll', () => {
+        if (pendingTarget || frame) return;
+        frame = requestAnimationFrame(() => {
+          frame = 0;
+          if (pendingTarget) return;
+          setActiveMarker(slides.indexOf(nearestSlide()));
+        });
+      }, { passive: true });
+
+      // Settle on scrollend; a debounced scroll listener only where it is unsupported.
+      if ('onscrollend' in window) {
+        track.addEventListener('scrollend', onScrollEnd);
+      } else {
+        /** @type {number | undefined} */
+        let timer;
+        track.addEventListener('scroll', () => {
+          clearTimeout(timer);
+          timer = window.setTimeout(onScrollEnd, 150);
+        }, { passive: true });
+      }
+
+      // Direct user scrolling replaces any pending scripted target.
+      const clearPending = () => { pendingTarget = null; };
+      for (const type of ['pointerdown', 'wheel', 'touchstart']) {
+        track.addEventListener(type, clearPending, { passive: true });
+      }
+      track.addEventListener('keydown', (event) => {
+        if (event.target === track) clearPending();
+      });
+
+      prevButton.addEventListener('click', () => step(-1));
+      nextButton.addEventListener('click', () => step(1));
+
+      // Layout switcher: horizontal (inline axis) or vertical (block axis).
+      if (layoutGroup instanceof HTMLElement) {
+        const layoutButtons = Array.from(layoutGroup.querySelectorAll('button[data-layout]'));
+        /** @param {string} orientation */
+        const setOrientation = (orientation) => {
+          if (orientation !== 'horizontal' && orientation !== 'vertical') return;
+          if (carousel.dataset.orientation === orientation) return;
+          pendingTarget = null;
+          carousel.dataset.orientation = orientation;
+          track.style.overflowX = '';
+          track.style.overflowY = '';
+          track.style.scrollSnapType = 'none';
+          track.scrollTo({ left: 0, top: 0, behavior: 'instant' });
+          scrollTrackBy(offsetFromCenter(slides[settledIndex]), 'instant');
+          track.style.scrollSnapType = '';
+          layoutButtons.forEach((button) => {
+            button.setAttribute('aria-pressed', String(button.getAttribute('data-layout') === orientation));
+          });
+          updateButtons();
+        };
+        layoutButtons.forEach((button) => {
+          button.addEventListener('click', () => setOrientation(button.getAttribute('data-layout') ?? ''));
+        });
+        layoutGroup.hidden = false;
+      }
+
+      // Initial sync: markers, buttons and parking, without announcing.
+      settledIndex = slides.indexOf(nearestSlide());
+      park(settledIndex);
+      setActiveMarker(settledIndex);
+      updateButtons();
+    }
+
+    document.querySelectorAll('.carousel').forEach((carousel) => {
+      if (carousel instanceof HTMLElement) initCarousel(carousel);
+    });
+  </script>
