+// Native scrolling remains available independently of these controls.
+document.querySelectorAll('.carousel').forEach((carousel) => {
+  const track = carousel.querySelector('.carousel-track');
+  const slides = Array.from(track.children);
+  const markers = Array.from(carousel.querySelectorAll('.carousel-markers button'));
+  const previous = carousel.querySelector('[data-direction="previous"]');
+  const next = carousel.querySelector('[data-direction="next"]');
+  const status = carousel.querySelector('[role="status"]');
+  const layout = carousel.querySelector('select');
+  const looping = slides.length >= 3 && CSS.supports('order', 'sibling-index()')
+    && CSS.supports('order', 'sibling-count()');
+  const nativeEnd = 'onscrollend' in track;
+  let pending = null;
+  let active = -1;
+  let settled = 0;
+  let frame = 0;
+  let timer;
+  let restoring = false;
+  let restoreVersion = 0;
+  const queuedSteps = [];
+  const vertical = () => carousel.dataset.orientation === 'vertical';
+  const center = (element) => {
+    const rect = element.getBoundingClientRect();
+    return vertical() ? rect.top + rect.height / 2 : rect.left + rect.width / 2;
+  };
+  const distance = (slide) => center(slide) - center(track);
+  const nearest = () => slides.reduce((best, slide, index) =>
+    Math.abs(distance(slide)) < Math.abs(distance(slides[best])) ? index : best, 0);
+  const mark = (index) => {
+    if (active === index) return;
+    markers.forEach((marker, i) => marker.setAttribute('aria-current', String(i === index)));
+    active = index;
+  };
+  const scrollBy = (amount, instant = false) => track.scrollBy({
+    [vertical() ? 'top' : 'left']: amount,
+    behavior: instant ? 'instant' : 'auto',
+  });
+
+  // Only the end slides change visual order; original labels and DOM order stay intact.
+  const park = (index) => {
+    if (!looping) return;
+    const version = ++restoreVersion;
+    restoring = true;
+    track.style.scrollSnapType = 'none';
+    track.style[vertical() ? 'overflowY' : 'overflowX'] = 'hidden';
+    const before = center(slides[index]);
+    track.style.setProperty('--current', String(index));
+    slides.forEach((slide, i) => {
+      slide.inert = i !== index && ((i === slides.length - 1 && index <= 1)
+        || (i === 0 && index >= slides.length - 2));
+    });
+    scrollBy(center(slides[index]) - before, true);
+    requestAnimationFrame(() => requestAnimationFrame(() => {
+      if (version !== restoreVersion) return;
+      track.style.removeProperty('overflow-x');
+      track.style.removeProperty('overflow-y');
+      track.style.removeProperty('scroll-snap-type');
+      restoring = false;
+      if (pending !== null) scrollBy(distance(slides[pending]));
+      else if (queuedSteps.length) step(queuedSteps.shift());
+    }));
+  };
+  const settle = (announce = true) => {
+    if (restoring) return;
+    const index = nearest();
+    // A stale scrollend from an interrupted animation must not cancel its successor.
+    if (pending !== null && (index !== pending || Math.abs(distance(slides[pending])) > 2)) return;
+    pending = null;
+    mark(index);
+    previous.disabled = !looping && index === 0;
+    next.disabled = !looping && index === slides.length - 1;
+    if (announce && index !== settled) status.textContent = `Slide ${index + 1} of ${slides.length}`;
+    settled = index;
+    park(index);
+  };
+  const go = (index) => {
+    pending = index;
+    mark(index);
+    if (restoring) return;
+    if (Math.abs(distance(slides[index])) <= 2) settle();
+    else scrollBy(distance(slides[index]));
+  };
+  const step = (direction) => {
+    if (queuedSteps.length) {
+      queuedSteps.push(direction);
+      return;
+    }
+    const order = slides.map((slide, index) => ({ index, position: center(slide) }))
+      .sort((a, b) => a.position - b.position);
+    const position = order.findIndex((slide) => slide.index === (pending ?? nearest()));
+    const target = order[position + direction];
+    if (target) go(target.index);
+    // Wait for the in-flight step to settle before parking a new neighbor.
+    else if (looping && pending !== null) queuedSteps.push(direction);
+  };
+  previous.addEventListener('click', () => step(-1));
+  next.addEventListener('click', () => step(1));
+  markers.forEach((marker, index) => marker.addEventListener('click', () => go(index)));
+  // Direct interaction takes ownership from a scripted smooth scroll.
+  const cancelPending = () => { pending = null; queuedSteps.length = 0; };
+  track.addEventListener('pointerdown', cancelPending);
+  track.addEventListener('wheel', cancelPending, { passive: true });
+  track.addEventListener('keydown', (event) => {
+    if (event.target === track) cancelPending();
+  });
+  track.addEventListener('scroll', () => {
+    if (restoring) return;
+    if (pending === null && !frame) frame = requestAnimationFrame(() => {
+      frame = 0;
+      if (pending === null && !restoring) mark(nearest());
+    });
+    if (!nativeEnd) {
+      clearTimeout(timer);
+      timer = setTimeout(() => settle(), 150);
+    }
+  }, { passive: true });
+  if (nativeEnd) track.addEventListener('scrollend', () => settle());
+  layout.addEventListener('change', () => {
+    const index = pending ?? nearest();
+    pending = null;
+    queuedSteps.length = 0;
+    carousel.dataset.orientation = layout.value;
+    track.scrollTo({ top: 0, left: 0, behavior: 'instant' });
+    scrollBy(distance(slides[index]), true);
+    settle(false);
+  });
+  if (looping) track.setAttribute('data-loop', '');
+  settle(false);
+});
