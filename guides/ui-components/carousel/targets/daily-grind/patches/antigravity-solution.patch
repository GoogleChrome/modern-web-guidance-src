index 0000000..0d2a908
--- /dev/null
+++ b/carousel.js
@@ -0,0 +1,469 @@
+/**
+ * Carousel Component
+ *
+ * Implements accessible native scrolling carousel with CSS scroll snap,
+ * looping via CSS order and parking compensation, live marker updates,
+ * scrollend settling, and horizontal or vertical layouts.
+ */
+
+export class Carousel {
+  /**
+   * @param {HTMLElement} element
+   * @param {Object} [options]
+   * @param {'horizontal'|'vertical'} [options.orientation]
+   * @param {boolean} [options.finite]
+   */
+  constructor(element, options = {}) {
+    this.carousel = element;
+    this.options = options;
+
+    this.track = this.carousel.querySelector('.carousel-track');
+    if (!this.track) return;
+
+    this.slides = Array.from(this.track.children);
+    if (this.slides.length === 0) return;
+
+    this.prevButton = this.carousel.querySelector('[data-direction="previous"]');
+    this.nextButton = this.carousel.querySelector('[data-direction="next"]');
+    this.statusEl = this.carousel.querySelector('[role="status"]');
+    this.markersNav = this.carousel.querySelector('.carousel-markers');
+    this.layoutButtons = Array.from(this.carousel.querySelectorAll('.carousel-layout-switcher button, [data-layout]'));
+
+    this.pendingTarget = null;
+    this.scrollGeneration = 0;
+    this.userHasScrolled = false;
+    this.lastSettledSlide = this.slides[0];
+    this.currentActiveIndex = 0;
+    this.markerButtons = [];
+    this.scrollRafId = null;
+    this.debounceTimer = null;
+
+    if (options.orientation) {
+      this.carousel.dataset.orientation = options.orientation;
+    }
+
+    this.init();
+  }
+
+  isVertical() {
+    return (
+      this.carousel.dataset.orientation === 'vertical' ||
+      this.carousel.getAttribute('aria-orientation') === 'vertical' ||
+      this.carousel.classList.contains('carousel--vertical') ||
+      this.carousel.classList.contains('vertical') ||
+      this.carousel.classList.contains('is-vertical')
+    );
+  }
+
+  isLoopingEnabled() {
+    const supportsSiblingIndex =
+      typeof CSS !== 'undefined' &&
+      CSS.supports &&
+      (CSS.supports('order', 'sibling-index()') || CSS.supports('order', 'sibling-count()'));
+
+    const isFiniteRequested =
+      this.options.finite === true ||
+      this.carousel.hasAttribute('data-finite') ||
+      this.carousel.classList.contains('finite');
+
+    return Boolean(supportsSiblingIndex && this.slides.length >= 3 && !isFiniteRequested);
+  }
+
+  init() {
+    this.setupMarkers();
+    this.setupControls();
+    this.setupScrollListeners();
+    this.setupLayoutSwitcher();
+    this.setupMutationObserver();
+
+    // Initial setup (silent in status region)
+    if (this.isLoopingEnabled()) {
+      this.track.style.setProperty('--current', '0');
+      this.updateInert(0);
+      if (this.prevButton) this.prevButton.disabled = false;
+      if (this.nextButton) this.nextButton.disabled = false;
+    } else {
+      if (this.prevButton) this.prevButton.disabled = true;
+      if (this.nextButton) this.nextButton.disabled = this.slides.length <= 1;
+    }
+
+    this.setActiveMarker(0);
+    this.updateLayoutToggleButtons();
+  }
+
+  setupMarkers() {
+    if (!this.markersNav) return;
+
+    // Check if markers are already defined in HTML
+    let buttons = Array.from(this.markersNav.querySelectorAll('button'));
+    if (buttons.length === 0) {
+      this.slides.forEach((slide, index) => {
+        const btn = document.createElement('button');
+        btn.type = 'button';
+        const markerName = slide.dataset.markerName || `Go to slide ${index + 1}`;
+        btn.setAttribute('aria-label', markerName);
+        if (index === 0) {
+          btn.setAttribute('aria-current', 'true');
+        }
+        this.markersNav.appendChild(btn);
+        buttons.push(btn);
+      });
+    }
+
+    this.markerButtons = buttons;
+    this.markerButtons.forEach((btn, index) => {
+      btn.addEventListener('click', () => {
+        this.userHasScrolled = true;
+        this.navigateToSlide(this.slides[index]);
+      });
+    });
+  }
+
+  setupControls() {
+    if (this.prevButton) {
+      this.prevButton.addEventListener('click', () => {
+        this.handleDirectionClick('previous');
+      });
+    }
+
+    if (this.nextButton) {
+      this.nextButton.addEventListener('click', () => {
+        this.handleDirectionClick('next');
+      });
+    }
+  }
+
+  setupLayoutSwitcher() {
+    this.layoutButtons.forEach(btn => {
+      btn.addEventListener('click', () => {
+        const layout = btn.dataset.layout || 'horizontal';
+        this.setOrientation(layout);
+      });
+    });
+  }
+
+  setOrientation(orientation) {
+    this.carousel.dataset.orientation = orientation;
+    this.carousel.setAttribute('aria-orientation', orientation);
+  }
+
+  setupMutationObserver() {
+    if (typeof MutationObserver === 'undefined') return;
+
+    this.observer = new MutationObserver(mutations => {
+      for (const m of mutations) {
+        if (
+          m.type === 'attributes' &&
+          (m.attributeName === 'data-orientation' ||
+            m.attributeName === 'aria-orientation' ||
+            m.attributeName === 'class')
+        ) {
+          this.handleOrientationChange();
+        }
+      }
+    });
+
+    this.observer.observe(this.carousel, {
+      attributes: true,
+      attributeFilter: ['data-orientation', 'aria-orientation', 'class']
+    });
+  }
+
+  handleOrientationChange() {
+    this.updateLayoutToggleButtons();
+
+    const isVert = this.isVertical();
+    const currentSlide = this.lastSettledSlide || this.slides[0];
+    const prevSnap = this.track.style.scrollSnapType;
+    this.track.style.scrollSnapType = 'none';
+
+    if (isVert) {
+      this.track.scrollLeft = 0;
+      const trackRect = this.track.getBoundingClientRect();
+      const slideRect = currentSlide.getBoundingClientRect();
+      const delta = slideRect.top + slideRect.height / 2 - (trackRect.top + trackRect.height / 2);
+      this.track.scrollTop += delta;
+    } else {
+      this.track.scrollTop = 0;
+      const trackRect = this.track.getBoundingClientRect();
+      const slideRect = currentSlide.getBoundingClientRect();
+      const delta = slideRect.left + slideRect.width / 2 - (trackRect.left + trackRect.width / 2);
+      this.track.scrollLeft += delta;
+    }
+
+    this.track.style.scrollSnapType = prevSnap || '';
+    this.onSettle();
+  }
+
+  updateLayoutToggleButtons() {
+    const isVert = this.isVertical();
+    this.layoutButtons.forEach(btn => {
+      const active =
+        (btn.dataset.layout === 'vertical' && isVert) ||
+        (btn.dataset.layout === 'horizontal' && !isVert);
+      btn.classList.toggle('active', active);
+      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
+    });
+  }
+
+  getSlidesInVisualOrder() {
+    const isVert = this.isVertical();
+    const prop = isVert ? 'top' : 'left';
+    return [...this.slides].sort((a, b) => {
+      return a.getBoundingClientRect()[prop] - b.getBoundingClientRect()[prop];
+    });
+  }
+
+  getNearestSlide() {
+    const isVert = this.isVertical();
+    const trackRect = this.track.getBoundingClientRect();
+    const trackCenter = isVert
+      ? trackRect.top + trackRect.height / 2
+      : trackRect.left + trackRect.width / 2;
+
+    let minDistance = Infinity;
+    let nearest = this.slides[0];
+
+    for (const slide of this.slides) {
+      const slideRect = slide.getBoundingClientRect();
+      const slideCenter = isVert
+        ? slideRect.top + slideRect.height / 2
+        : slideRect.left + slideRect.width / 2;
+      const distance = Math.abs(slideCenter - trackCenter);
+      if (distance < minDistance) {
+        minDistance = distance;
+        nearest = slide;
+      }
+    }
+
+    return nearest;
+  }
+
+  setActiveMarker(index) {
+    if (index < 0 || index >= this.slides.length) return;
+    this.markerButtons.forEach((btn, i) => {
+      if (i === index) {
+        btn.setAttribute('aria-current', 'true');
+      } else {
+        btn.removeAttribute('aria-current');
+      }
+    });
+    this.currentActiveIndex = index;
+  }
+
+  updateInert(settledIndex) {
+    this.slides.forEach(s => (s.inert = false));
+    if (this.isLoopingEnabled() && this.slides.length >= 3) {
+      const n = this.slides.length;
+      // First slide parks after the last when --current is the last or second-to-last index
+      const isFirstParked = settledIndex >= n - 2 && settledIndex !== 0;
+      if (isFirstParked) {
+        this.slides[0].inert = true;
+      }
+      // Last slide parks before the first when --current is 0 or 1
+      const isLastParked = settledIndex <= 1 && settledIndex !== n - 1;
+      if (isLastParked) {
+        this.slides[n - 1].inert = true;
+      }
+    }
+  }
+
+  navigateToSlide(targetSlide) {
+    if (!targetSlide) return;
+    this.userHasScrolled = true;
+    this.pendingTarget = targetSlide;
+    this.scrollGeneration++;
+
+    const targetIndex = this.slides.indexOf(targetSlide);
+    this.setActiveMarker(targetIndex);
+
+    const isVert = this.isVertical();
+    const trackRect = this.track.getBoundingClientRect();
+    const targetRect = targetSlide.getBoundingClientRect();
+
+    const delta = isVert
+      ? targetRect.top + targetRect.height / 2 - (trackRect.top + trackRect.height / 2)
+      : targetRect.left + targetRect.width / 2 - (trackRect.left + trackRect.width / 2);
+
+    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    const behavior = prefersReducedMotion ? 'auto' : 'smooth';
+
+    if (isVert) {
+      this.track.scrollBy({ top: delta, behavior });
+    } else {
+      this.track.scrollBy({ left: delta, behavior });
+    }
+  }
+
+  handleDirectionClick(direction) {
+    this.userHasScrolled = true;
+    const visualSlides = this.getSlidesInVisualOrder();
+    const currentSlide = this.pendingTarget || this.getNearestSlide();
+    const currentIndex = visualSlides.indexOf(currentSlide);
+
+    let targetSlide = null;
+    const looping = this.isLoopingEnabled();
+
+    if (direction === 'next') {
+      if (looping) {
+        targetSlide = visualSlides[(currentIndex + 1) % visualSlides.length];
+      } else {
+        if (currentIndex < visualSlides.length - 1) {
+          targetSlide = visualSlides[currentIndex + 1];
+        }
+      }
+    } else if (direction === 'previous') {
+      if (looping) {
+        targetSlide = visualSlides[(currentIndex - 1 + visualSlides.length) % visualSlides.length];
+      } else {
+        if (currentIndex > 0) {
+          targetSlide = visualSlides[currentIndex - 1];
+        }
+      }
+    }
+
+    if (targetSlide) {
+      this.navigateToSlide(targetSlide);
+    }
+  }
+
+  setupScrollListeners() {
+    // Live marker updates throttled with requestAnimationFrame
+    this.track.addEventListener(
+      'scroll',
+      () => {
+        this.userHasScrolled = true;
+        // Skip listener entirely while a click or key press has a pending target
+        if (this.pendingTarget) return;
+
+        if (this.scrollRafId !== null) return;
+        this.scrollRafId = requestAnimationFrame(() => {
+          this.scrollRafId = null;
+          if (this.pendingTarget) return;
+
+          const nearest = this.getNearestSlide();
+          if (!nearest) return;
+          const index = this.slides.indexOf(nearest);
+          if (index !== this.currentActiveIndex) {
+            this.setActiveMarker(index);
+          }
+        });
+      },
+      { passive: true }
+    );
+
+    // Settle handler
+    const supportsScrollEnd = 'onscrollend' in window;
+
+    if (supportsScrollEnd) {
+      this.track.addEventListener('scrollend', () => {
+        this.onSettle(this.scrollGeneration);
+      });
+    } else {
+      this.track.addEventListener(
+        'scroll',
+        () => {
+          clearTimeout(this.debounceTimer);
+          const currentGen = this.scrollGeneration;
+          this.debounceTimer = setTimeout(() => {
+            this.onSettle(currentGen);
+          }, 150);
+        },
+        { passive: true }
+      );
+    }
+  }
+
+  onSettle(sourceGen) {
+    // Ignore a scrollend that arrives after the next scroll has started
+    if (sourceGen !== undefined && sourceGen !== this.scrollGeneration) {
+      return;
+    }
+
+    this.pendingTarget = null;
+    const settledSlide = this.getNearestSlide();
+    if (!settledSlide) return;
+
+    const settledIndex = this.slides.indexOf(settledSlide);
+    const isVert = this.isVertical();
+    const looping = this.isLoopingEnabled();
+
+    // Announce "Slide N of M" in the status region only when settled slide changes
+    // from previously settled slide (silent on initial load and compensating park scrolls)
+    if (settledSlide !== this.lastSettledSlide) {
+      if (this.userHasScrolled && this.statusEl) {
+        this.statusEl.textContent = `Slide ${settledIndex + 1} of ${this.slides.length}`;
+      }
+      this.lastSettledSlide = settledSlide;
+    }
+
+    this.setActiveMarker(settledIndex);
+
+    if (!looping) {
+      const visualSlides = this.getSlidesInVisualOrder();
+      const visualIndex = visualSlides.indexOf(settledSlide);
+      if (this.prevButton) this.prevButton.disabled = visualIndex === 0;
+      if (this.nextButton) this.nextButton.disabled = visualIndex === visualSlides.length - 1;
+    } else {
+      if (this.prevButton) this.prevButton.disabled = false;
+      if (this.nextButton) this.nextButton.disabled = false;
+
+      // Looping parking update & compensating scroll
+      const prop = isVert ? 'top' : 'left';
+      const beforeOffset = settledSlide.getBoundingClientRect()[prop];
+
+      const prevSnap = this.track.style.scrollSnapType;
+      this.track.style.scrollSnapType = 'none';
+
+      this.track.style.setProperty('--current', String(settledIndex));
+
+      const afterOffset = settledSlide.getBoundingClientRect()[prop];
+      const delta = afterOffset - beforeOffset;
+
+      if (delta !== 0) {
+        if (isVert) {
+          this.track.style.overflowY = 'hidden';
+          this.track.scrollTop += delta;
+        } else {
+          this.track.style.overflowX = 'hidden';
+          this.track.scrollLeft += delta;
+        }
+
+        // Lock overflow on the scrolling axis and restore two animation frames later
+        requestAnimationFrame(() => {
+          requestAnimationFrame(() => {
+            if (isVert) {
+              this.track.style.overflowY = '';
+            } else {
+              this.track.style.overflowX = '';
+            }
+          });
+        });
+      }
+
+      this.track.style.scrollSnapType = prevSnap || '';
+      this.updateInert(settledIndex);
+    }
+  }
+}
+
+export function initCarousel(element, options) {
+  return new Carousel(element, options);
+}
+
+// Auto-initialize when loaded in browser
+if (typeof window !== 'undefined') {
+  const initAll = () => {
+    document.querySelectorAll('.carousel').forEach(el => {
+      if (!el.__carousel) {
+        el.__carousel = new Carousel(el);
+      }
+    });
+  };
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initAll);
+  } else {
+    initAll();
+  }
+}
