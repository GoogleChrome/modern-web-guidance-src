@@ -0,0 +1,234 @@
+/* Carousel Component Styles */
+
+.carousel {
+  position: relative;
+  width: 100%;
+  max-width: 800px;
+  margin: 0 auto;
+}
+
+/* Track and snapping */
+.carousel-track {
+  display: flex;
+  gap: 1rem;
+  overflow-x: auto;
+  /* mandatory so the track always rests on a slide, which the settled-scroll status relies on */
+  scroll-snap-type: x mandatory;
+  touch-action: manipulation;
+  padding: 1rem 0;
+  scrollbar-width: thin;
+}
+
+.carousel-track > * {
+  flex: 0 0 100%; /* one slide per view; use a smaller basis for a peek layout */
+  scroll-snap-align: center;
+  box-sizing: border-box;
+}
+
+/* Enable scroll-behavior: smooth on the track only inside prefers-reduced-motion: no-preference */
+@media (prefers-reduced-motion: no-preference) {
+  .carousel-track {
+    scroll-behavior: smooth;
+  }
+}
+
+/* Vertical layout adaptation */
+.carousel[data-orientation="vertical"],
+.carousel[aria-orientation="vertical"],
+.carousel.carousel--vertical,
+.carousel.vertical,
+.carousel.is-vertical {
+  max-width: 480px;
+}
+
+.carousel[data-orientation="vertical"] .carousel-track,
+.carousel[aria-orientation="vertical"] .carousel-track,
+.carousel.carousel--vertical .carousel-track,
+.carousel.vertical .carousel-track,
+.carousel.is-vertical .carousel-track {
+  flex-direction: column;
+  overflow-x: hidden;
+  overflow-y: auto;
+  scroll-snap-type: y mandatory;
+  height: 420px;
+  padding: 0 1rem;
+}
+
+.carousel[data-orientation="vertical"] .carousel-track > *,
+.carousel[aria-orientation="vertical"] .carousel-track > *,
+.carousel.carousel--vertical .carousel-track > *,
+.carousel.vertical .carousel-track > *,
+.carousel.is-vertical .carousel-track > * {
+  flex: 0 0 100%;
+  height: 100%;
+}
+
+/* Slide content container */
+.carousel-slide {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  padding: 0 40px;
+}
+
+.carousel[data-orientation="vertical"] .carousel-slide,
+.carousel[aria-orientation="vertical"] .carousel-slide,
+.carousel.carousel--vertical .carousel-slide,
+.carousel.vertical .carousel-slide,
+.carousel.is-vertical .carousel-slide {
+  padding: 40px 0;
+}
+
+.carousel-slide .card {
+  width: 100%;
+  max-width: 360px;
+}
+
+/* Controls */
+.carousel-controls {
+  position: absolute;
+  top: 50%;
+  left: 0;
+  right: 0;
+  transform: translateY(-50%);
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  pointer-events: none;
+  z-index: 10;
+  padding: 0 4px;
+}
+
+.carousel[data-orientation="vertical"] .carousel-controls,
+.carousel[aria-orientation="vertical"] .carousel-controls,
+.carousel.carousel--vertical .carousel-controls,
+.carousel.vertical .carousel-controls,
+.carousel.is-vertical .carousel-controls {
+  top: 0;
+  bottom: 0;
+  left: 50%;
+  right: auto;
+  transform: translateX(-50%);
+  flex-direction: column;
+  justify-content: space-between;
+  align-items: center;
+  height: 100%;
+  padding: 4px 0;
+}
+
+.carousel-controls button {
+  pointer-events: auto;
+  touch-action: manipulation;
+  background: white;
+  color: var(--primary);
+  border: 1px solid var(--secondary);
+  border-radius: 20px;
+  padding: 8px 16px;
+  font-size: 0.85rem;
+  font-weight: 600;
+  cursor: pointer;
+  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
+  transition: background-color 0.2s, color 0.2s;
+}
+
+.carousel-controls button:hover:not(:disabled) {
+  background: var(--primary);
+  color: white;
+}
+
+.carousel-controls button:disabled {
+  opacity: 0.35;
+  cursor: not-allowed;
+}
+
+/* Focus visible styling */
+.carousel-controls button:focus-visible,
+.carousel-markers button:focus-visible,
+.carousel-track:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 2px;
+}
+
+/* Markers */
+.carousel-markers {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: 0.75rem;
+  margin-top: 1rem;
+}
+
+.carousel-markers button {
+  width: 14px;
+  height: 14px;
+  border-radius: 50%;
+  border: 2px solid var(--primary);
+  background: transparent;
+  cursor: pointer;
+  padding: 0;
+  touch-action: manipulation;
+  transition: background-color 0.2s, transform 0.2s;
+}
+
+.carousel-markers button[aria-current="true"] {
+  background: var(--primary);
+  transform: scale(1.15);
+}
+
+/* Visually hidden status region */
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+/* Layout switcher controls */
+.carousel-layout-switcher {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 1rem;
+}
+
+.carousel-layout-switcher span {
+  font-size: 0.9rem;
+  font-weight: 600;
+  color: var(--text);
+}
+
+.carousel-layout-switcher button {
+  background: white;
+  border: 1px solid var(--secondary);
+  border-radius: 4px;
+  padding: 4px 12px;
+  font-size: 0.85rem;
+  cursor: pointer;
+  transition: background 0.2s, color 0.2s;
+}
+
+.carousel-layout-switcher button[aria-pressed="true"],
+.carousel-layout-switcher button.active {
+  background: var(--primary);
+  color: white;
+  border-color: var(--primary);
+}
+
+/* Looping: continuous navigation rules */
+@supports (order: sibling-index()) or (order: sibling-count()) {
+  /* The first slide parks after the last while --current is the last or second-to-last index. */
+  .carousel-track > :first-child {
+    order: clamp(0, var(--current) - (sibling-count() - 3), 1);
+  }
+
+  /* The last slide parks before the first while --current is 0 or 1. */
+  .carousel-track > :last-child {
+    order: calc(-1 * clamp(0, 2 - var(--current), 1));
+  }
+}
