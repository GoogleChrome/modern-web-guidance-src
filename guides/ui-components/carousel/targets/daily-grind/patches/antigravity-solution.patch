+            } else {
+              track.scrollLeft += diff;
+            }
+          }
+
+          requestAnimationFrame(() => {
+            requestAnimationFrame(() => {
+              if (vertical) {
+                track.style.overflowY = '';
+              } else {
+                track.style.overflowX = '';
+              }
