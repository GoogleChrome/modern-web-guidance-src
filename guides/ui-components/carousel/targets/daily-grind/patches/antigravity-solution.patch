+  <script type="module">
+    function initCarousel() {
+      const carousel = document.querySelector('.carousel');
+      if (!carousel) return;
+
+      const track = carousel.querySelector('.carousel-track');
+      if (!track) return;
+      const slides = Array.from(track.children);
+      if (slides.length === 0) return;
+
+      const prevBtn = carousel.querySelector('button[data-direction="previous"]');
+      const nextBtn = carousel.querySelector('button[data-direction="next"]');
+      const statusEl = carousel.querySelector('[role="status"]');
+      const markersNav = carousel.querySelector('.carousel-markers');
+
+      const supportsScrollEnd = 'onscrollend' in window;
+      const supportsSiblingIndex = CSS.supports('order', 'sibling-index()') || CSS.supports('order', 'calc(sibling-count())');
+      const isLooping = supportsSiblingIndex && slides.length >= 3;
+
+      let pendingTarget = null;
+      let activeMarkerIndex = 0;
+      let previouslySettledSlide = null;
+      let isInitialLoad = true;
+      let scrollSequence = 0;
+
+      function isVertical() {
+        if (carousel.dataset.layout === 'vertical' || carousel.dataset.orientation === 'vertical') return true;
+        if (carousel.classList.contains('carousel--vertical') || carousel.classList.contains('vertical')) return true;
+        return getComputedStyle(track).flexDirection === 'column';
+      }
+
+      function prefersReducedMotion() {
+        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      }
+
+      function getVisualSlides() {
+        const vertical = isVertical();
+        return [...slides].sort((a, b) => {
+          const rectA = a.getBoundingClientRect();
+          const rectB = b.getBoundingClientRect();
+          return vertical ? rectA.top - rectB.top : rectA.left - rectB.left;
+        });
+      }
+
+      function getNearestSlide() {
+        const vertical = isVertical();
+        const trackRect = track.getBoundingClientRect();
+        const trackCenter = vertical
+          ? trackRect.top + track.clientHeight / 2
+          : trackRect.left + track.clientWidth / 2;
+
+        let nearest = slides[0];
+        let minDiff = Infinity;
+
+        for (const slide of slides) {
+          const slideRect = slide.getBoundingClientRect();
+          const slideCenter = vertical
+            ? slideRect.top + slideRect.height / 2
+            : slideRect.left + slideRect.width / 2;
+          const diff = Math.abs(slideCenter - trackCenter);
+          if (diff < minDiff) {
+            minDiff = diff;
+            nearest = slide;
+          }
+        }
+        return nearest;
+      }
+
+      // Build or wire markers
+      let markerButtons = Array.from(markersNav ? markersNav.querySelectorAll('button') : []);
+      if (markersNav && markerButtons.length === 0) {
+        markerButtons = slides.map((slide, idx) => {
+          const btn = document.createElement('button');
+          btn.type = 'button';
+          const name = slide.getAttribute('data-marker-name') || `Go to slide ${idx + 1}`;
+          btn.setAttribute('aria-label', name);
+          btn.title = name;
+          markersNav.appendChild(btn);
+          return btn;
+        });
+      }
+
+      function setActiveMarker(index) {
+        activeMarkerIndex = index;
+        markerButtons.forEach((btn, idx) => {
+          if (idx === index) {
+            btn.setAttribute('aria-current', 'true');
+          } else {
+            btn.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function scrollToSlide(slide, immediate = false) {
+        const vertical = isVertical();
+        const trackRect = track.getBoundingClientRect();
+        const slideRect = slide.getBoundingClientRect();
+
+        const trackCenter = vertical
+          ? trackRect.top + track.clientHeight / 2
+          : trackRect.left + track.clientWidth / 2;
+        const slideCenter = vertical
+          ? slideRect.top + slideRect.height / 2
+          : slideRect.left + slideRect.width / 2;
+
+        const offset = slideCenter - trackCenter;
+        const behavior = immediate || prefersReducedMotion() ? 'auto' : 'smooth';
+
+        if (Math.abs(offset) > 0.5) {
+          if (vertical) {
+            track.scrollBy({ top: offset, behavior });
+          } else {
+            track.scrollBy({ left: offset, behavior });
+          }
+        }
+      }
+
+      function navigate(direction) {
+        scrollSequence++;
+        const thisScrollId = scrollSequence;
+
+        const baseSlide = (pendingTarget && slides.includes(pendingTarget))
+          ? pendingTarget
+          : getNearestSlide();
+
+        const visualSlides = getVisualSlides();
+        const baseIdx = visualSlides.indexOf(baseSlide);
+        if (baseIdx === -1) return;
+
+        let targetSlide;
+        if (direction === 'next') {
+          if (isLooping) {
+            targetSlide = visualSlides[(baseIdx + 1) % visualSlides.length];
+          } else {
+            targetSlide = visualSlides[Math.min(baseIdx + 1, visualSlides.length - 1)];
+          }
+        } else {
+          if (isLooping) {
+            targetSlide = visualSlides[(baseIdx - 1 + visualSlides.length) % visualSlides.length];
+          } else {
+            targetSlide = visualSlides[Math.max(baseIdx - 1, 0)];
+          }
+        }
+
+        pendingTarget = targetSlide;
+        const targetOrigIdx = slides.indexOf(targetSlide);
+
+        setActiveMarker(targetOrigIdx);
+        scrollToSlide(targetSlide);
+
+        if (prefersReducedMotion()) {
