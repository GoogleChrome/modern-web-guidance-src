   "name": "daily-grind",
   "version": "1.0.0",
   "scripts": {
+    "build": "node --input-type=module -e \"import { mkdir, copyFile } from 'node:fs/promises'; await mkdir('dist', { recursive: true }); await copyFile('index.html', 'dist/index.html');\"",
     "start": "pnpm dlx statikk --port ${PORT:-11222}"
   },
   "pnpm": {
