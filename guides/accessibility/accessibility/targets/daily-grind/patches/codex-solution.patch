+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Artisanal Coffee | The Daily Grind</title>
+  <style>
+    :root {
+      --primary: #4e342e;
+      --secondary: #d7ccc8;
+      --accent: #ffab40;
+      --text: #3e2723;
+      --light: #fafafa;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+      line-height: 1.6;
+      color: var(--text);
+      background-color: var(--light);
+      overflow-wrap: break-word;
+    }
+
+    .visually-hidden:where(:not(:focus-within, :active)) {
+      position: absolute !important;
+      clip-path: inset(50%) !important;
+      overflow: hidden !important;
+      width: 1px !important;
+      height: 1px !important;
+      margin: -1px !important;
+      padding: 0 !important;
+      border: 0 !important;
+      white-space: nowrap !important;
+    }
+
+    .skip-link {
+      position: fixed;
+      top: 1rem;
+      left: 1rem;
+      z-index: 2000;
+      padding: 0.75rem 1rem;
+      color: var(--primary);
+      background: white;
+    }
+
+    :focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 3px;
+      box-shadow: 0 0 0 6px white;
+    }
+
+    [tabindex="-1"] {
+      scroll-margin-block: 1rem;
+    }
+
+    a {
+      min-inline-size: 24px;
+      min-block-size: 24px;
+    }
+
+    /* Navigation */
+    .primary-nav {
+      background: var(--primary);
+      color: white;
+      padding: 1rem 5%;
+      display: flex;
+      flex-wrap: wrap;
+      gap: 1rem 2rem;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    .logo {
+      font-size: 1.5rem;
+      font-weight: bold;
+      letter-spacing: 1px;
+    }
+
+    .primary-nav ul {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 0.5rem 1.25rem;
+      list-style: none;
+    }
+
+    .primary-nav a {
+      display: inline-flex;
+      align-items: center;
+      padding-block: 0.25rem;
+      color: white;
+      text-decoration: none;
+      font-size: 0.9rem;
+      transition: color 0.3s;
+    }
+
+    .primary-nav a:hover {
+      color: var(--accent);
+    }
+
+    .logout-link {
+      border: 1px solid var(--accent);
+      padding: 5px 12px;
+      border-radius: 4px;
+    }
+
+    /* Hero Section */
+    .hero {
+      min-height: 60vh;
+      background-color: var(--primary);
+      /* Decorative coffee photo; the text contains the complete message.
+         The overlay maintains white text contrast even over bright pixels. */
+      background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: white;
+      text-align: center;
+      padding: 3rem 20px;
+    }
+
+    .hero h1 {
+      font-size: 3rem;
+      margin-bottom: 1rem;
+    }
+
+    /* Content Sections */
+    .container {
+      max-width: 1100px;
+      margin: 40px auto;
+      padding: 0 20px;
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+      gap: 20px;
+      margin-top: 20px;
+      list-style: none;
+    }
+
+    .section-title {
+      text-align: center;
+    }
+
+    .card {
+      background: white;
+      padding: 20px;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+    }
+
+    .card h3 {
+      margin-bottom: 10px;
+      color: var(--primary);
+    }
+
+    .btn {
+      display: inline-block;
+      background: var(--primary);
+      color: white;
+      padding: 10px 20px;
+      text-decoration: none;
+      border-radius: 5px;
+      margin-top: 15px;
+      transition: background 0.3s;
+    }
+
+    .btn:hover {
+      background: #3e2723;
+    }
+
+    footer {
+      background: var(--secondary);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: 0.5rem 1.25rem;
+      list-style: none;
+      margin-bottom: 20px;
+    }
+
+    .footer-links a {
+      display: inline-flex;
+      align-items: center;
+      padding-block: 0.25rem;
+      color: var(--text);
+      text-decoration: underline;
+      text-underline-offset: 0.2em;
+      font-size: 0.85rem;
+    }
+
+    @media (pointer: coarse) {
+      a {
+        min-inline-size: 44px;
+        min-block-size: 44px;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .primary-nav a,
+      .btn {
+        transition: none;
+      }
+    }
+
+    @media (forced-colors: active) {
+      :focus-visible {
+        outline-color: Highlight;
+        box-shadow: none;
+      }
+
+      .btn {
+        border: 1px solid ButtonText;
+      }
+    }
+  </style>
+</head>
+
+<body>
+
+  <header>
+    <a href="#main-heading" class="skip-link visually-hidden">Skip to main content</a>
+    <nav class="primary-nav" aria-label="Primary">
+      <div class="logo">THE DAILY GRIND</div>
+      <ul>
+        <li><a href="/menu">Menu</a></li>
+        <li><a href="/locations">Locations</a></li>
+        <li><a href="/rewards">Rewards</a></li>
+        <li><a href="/account">My Account</a></li>
+        <li><a href="/logout" class="logout-link">Logout</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero">
+      <h1 id="main-heading" tabindex="-1">Wake Up Your Senses</h1>
+      <p>Ethically sourced, locally roasted, delivered to your cup.</p>
+      <a href="/order-online" class="btn">Order Now</a>
+    </section>
+
+    <section class="container">
+      <h2 class="section-title">Seasonal Favorites</h2>
+      <ul class="grid" role="list">
+        <li class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details<span class="visually-hidden"> for Maple Oat Latte</span></a>
+        </li>
+        <li class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details<span class="visually-hidden"> for Dark Roast Espresso</span></a>
+        </li>
+        <li class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details<span class="visually-hidden"> for Cold Brew</span></a>
+        </li>
+      </ul>
+    </section>
+  </main>
+
+  <footer>
+    <nav aria-label="Footer">
+      <ul class="footer-links">
+        <li><a href="/about">Our Story</a></li>
+        <li><a href="/careers">Join the Team</a></li>
+        <li><a href="/contact">Contact Us</a></li>
+        <li><a href="/privacy-policy">Privacy</a></li>
+      </ul>
+    </nav>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
