+<style>
+/* 1. Define the container wrapper */
+.card-container {
+    container-type: inline-size;
+    width: 100%;
+}
+
+/* Default styles for small containers (stacked layout) */
+.card {
+    display: flex;
+    flex-direction: column;
+    gap: 1rem;
+}
+
+.card-image-wrapper {
+    width: 100%;
+    flex-shrink: 0;
+}
+
+.card-content {
+    width: 100%;
+}
+
+.card-title {
+    font-size: 1.125rem;
+    line-height: 1.75rem;
+}
+
+.card-summary {
+    display: block;
+}
+
+/* Fallback using media queries for older browsers */
+@media (min-width: 600px) {
+    .card {
+        flex-direction: row;
+        align-items: flex-start;
+    }
+    .card-image-wrapper {
+        width: 40%;
+    }
+    .card-content {
+        width: 60%;
+    }
+}
+
+/* Overwrite with container queries where supported */
+@supports (container-type: inline-size) {
+    @media (min-width: 600px) {
+        .card {
+            /* Reset media query fallback so container query dictates layout */
+            flex-direction: column;
+            align-items: stretch;
+        }
+        .card-image-wrapper {
+            width: 100%;
+        }
+        .card-content {
+            width: 100%;
+        }
+    }
+    
+    /* 2 & 3. Apply styles based on container size (triggers side-by-side layout when container is wider than 400px) */
+    @container (min-width: 400px) {
+        .card {
+            flex-direction: row;
+            align-items: flex-start;
+        }
+        .card-image-wrapper {
+            width: 40%;
+        }
+        .card-content {
+            width: 60%;
+        }
+        .card-title {
+            font-size: 1.25rem;
+            line-height: 1.75rem;
+        }
+    }
+
+    @container (min-width: 650px) {
+        .card-title {
+            font-size: 1.5rem;
+            line-height: 2rem;
+        }
+    }
+}
+</style>
