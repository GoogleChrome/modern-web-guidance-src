+</div>
+
+<style>
+.card-container {
+  /* Define the container type. Use 'inline-size' for width-based queries. */
+  container-type: inline-size;
+  width: 100%;
+}
+
+/* Default styles for small containers (stacked layout) */
+/* Default safe stacked layout */
+.card {
+  display: flex;
+  flex-direction: column;
+  gap: 1rem;
+  height: 100%;
+}
+
+.card-image-wrapper {
+  width: 100%;
+  flex-shrink: 0;
+}
+
+.card-image {
+  width: 100%;
+  height: auto;
+  aspect-ratio: 16 / 9;
+  object-fit: cover;
+  border-radius: 0.375rem;
+}
+
+.card-content {
+  display: flex;
+  flex-direction: column;
+  flex-grow: 1;
+  min-width: 0;
+}
+
+.card-title-link {
+  display: flex;
+  flex-direction: column;
+}
+
+.card-title {
+  font-size: 1.125rem;
+  font-weight: 500;
+  line-height: 1.35;
+  margin-top: 0.25rem;
+}
+
+.card-details {
+  font-size: 0.875rem;
+  line-height: 1.5;
+  color: #4b5563;
+}
+
+/* Fallback using media queries for older browsers */
+@media (min-width: 600px) {
+  .card {
+    flex-direction: row;
+    align-items: center;
+  }
+
+  .card-image-wrapper {
+    width: 40%;
+    flex-shrink: 0;
+  }
+
+  .card-image {
+    width: 100%;
+    height: 100%;
+    aspect-ratio: 16 / 9;
+  }
+}
+
+/* Overwrite with container queries where supported */
+@supports (container-type: inline-size) {
+  @media (min-width: 600px) {
+    .card {
+      /* Reset media query fallback if needed, or let container query handle it */
+      flex-direction: column;
+    }
+
+    .card-image-wrapper {
+      width: 100%;
+    }
+  }
+
+  /* Styles for larger containers (side-by-side layout) */
+  /* This triggers when the container is wider than 400px */
+  @container (min-width: 400px) {
+    .card {
+      flex-direction: row;
+      align-items: center;
+      gap: 1.25rem;
+    }
+
+    .card-image-wrapper {
+      width: 40%;
+      max-width: 40%;
+      flex-shrink: 0;
+    }
+
+    .card-image {
+      width: 100%;
+      height: 100%;
+      aspect-ratio: 16 / 9;
+      object-fit: cover;
+    }
+
+    .card-title {
+      font-size: 1.25rem;
+    }
+
+    .card-details {
+      display: block;
+      font-size: 0.95rem;
+    }
+  }
+
+  @container (min-width: 600px) {
+    .card {
+      flex-direction: row;
+      align-items: center;
+      gap: 2rem;
+    }
+
+    .card-image-wrapper {
+      width: 45%;
+      max-width: 50%;
+      flex-shrink: 0;
+    }
+
+    .card-title {
+      font-size: 1.875rem;
+      line-height: 1.25;
+    }
+
+    .card-details {
+      display: block;
+      font-size: 1.125rem;
+      line-height: 1.625;
+      margin-top: 0.5rem;
+    }
+  }
+}
+</style>
