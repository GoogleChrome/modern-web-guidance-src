diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..fffa4bd 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,106 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+.article-teaser-container {
+  container-type: inline-size;
+}
+
+.article-teaser-card {
+  display: flex;
+  flex-direction: column;
+}
+
+.article-teaser-media {
+  display: block;
+  flex-shrink: 0;
+}
+
+.article-teaser-body {
+  min-width: 0;
+}
+
+.article-teaser-image {
+  aspect-ratio: 16 / 9;
+  width: 100%;
+}
+
+@media (min-width: 48rem) {
+  .article-teaser-container .article-teaser-card {
+    align-items: stretch;
+    flex-direction: row;
+    gap: 1rem;
+  }
+
+  .article-teaser-container .article-teaser-media {
+    width: 42%;
+    max-width: 14rem;
+  }
+
+  .article-teaser-container .article-teaser-body {
+    flex: 1;
+    margin-top: 0;
+  }
+
+  .article-teaser-container .article-teaser-image {
+    aspect-ratio: auto;
+    height: 100%;
+    min-height: 10rem;
+  }
+}
+
+@supports (container-type: inline-size) {
+  @media (min-width: 48rem) {
+    .article-teaser-container .article-teaser-card {
+      flex-direction: column;
+      gap: 0;
+    }
+
+    .article-teaser-container .article-teaser-media {
+      width: auto;
+      max-width: none;
+    }
+
+    .article-teaser-container .article-teaser-body {
+      margin-top: 0.75rem;
+    }
+
+    .article-teaser-container .article-teaser-image {
+      aspect-ratio: 16 / 9;
+      height: auto;
+      min-height: 0;
+    }
+  }
+
+  @container (min-width: 400px) {
+    .article-teaser-card {
+      align-items: stretch;
+      flex-direction: row;
+      gap: 1rem;
+    }
+
+    .article-teaser-media {
+      width: 42%;
+      max-width: 14rem;
+    }
+
+    .article-teaser-body {
+      flex: 1;
+      margin-top: 0;
+    }
+
+    .article-teaser-image {
+      aspect-ratio: auto;
+      height: 100%;
+      min-height: 10rem;
+    }
+  }
+
+  @container (min-width: 620px) {
+    .article-teaser-summary {
+      font-size: 1.0625rem;
+      line-height: 1.6;
+    }
+  }
+}
