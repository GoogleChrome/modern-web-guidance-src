@@ -4,4 +4,74 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+/*
+ * Article teasers are used in both narrow grids and wide content regions. The
+ * wrapper establishes the component's own inline-size as the responsive input,
+ * so its layout does not depend on where it happens to be rendered.
+ */
+.article-teaser-container {
+  container-name: article-teaser;
+  container-type: inline-size;
+}
+
+/* Safe default for small containers and browsers without container queries. */
+.article-teaser-card {
+  flex-direction: column;
+}
+
+.article-teaser-media {
+  display: block;
+}
+
+/* Usable progressive fallback when container queries are unavailable. */
+@media (min-width: 600px) {
+  .article-teaser-card {
+    flex-direction: row;
+    align-items: stretch;
+    gap: 1rem;
+  }
+
+  .article-teaser-media {
+    flex: 0 0 40%;
+  }
+
+  .article-teaser-content {
+    margin-top: 0;
+  }
+}
+
+@supports (container-type: inline-size) {
+  /* Let component width, rather than viewport width, control enhanced layouts. */
+  @media (min-width: 600px) {
+    .article-teaser-card {
+      flex-direction: column;
+      gap: 0;
+    }
+
+    .article-teaser-media {
+      flex-basis: auto;
+    }
+
+    .article-teaser-content {
+      margin-top: 0.75rem;
+    }
+  }
+
+  @container (min-width: 400px) {
+    .article-teaser-card {
+      flex-direction: row;
+      align-items: stretch;
+      gap: 1rem;
+    }
+
+    .article-teaser-media {
+      flex: 0 0 40%;
+    }
+
+    .article-teaser-content {
+      margin-top: 0;
+    }
+  }
+}
