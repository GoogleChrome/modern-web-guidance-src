@@ -0,0 +1,22 @@
+import { readFile } from "node:fs/promises";
+
+const html = await readFile(new URL("../index.html", import.meta.url), "utf8");
+
+const requirements = [
+  [/<html\s+lang="en">/i, "an English language declaration"],
+  [/<meta\s+name="viewport"/i, "a viewport meta tag"],
+  [/container-type:\s*inline-size/i, "an inline-size query container"],
+  [/@container\s+coffee-card\s*\(min-width:\s*400px\)/i, "the 400px card container query"],
+  [/@supports\s*\(container-type:\s*inline-size\)/i, "a progressive-enhancement boundary"],
+  [/@media\s*\(min-width:\s*700px\)/i, "a legacy media-query fallback"],
+];
+
+const missing = requirements
+  .filter(([pattern]) => !pattern.test(html))
+  .map(([, label]) => label);
+
+if (missing.length > 0) {
+  throw new Error(`index.html is missing: ${missing.join(", ")}`);
+}
+
+console.log("Static build validation passed.");
