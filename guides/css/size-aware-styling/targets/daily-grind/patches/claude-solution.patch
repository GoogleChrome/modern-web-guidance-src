+    /*
+     * Card component: layout adapts to the width of its own container
+     * (the .card-container element), not the viewport. This lets the
+     * exact same card markup/CSS look right whether it's placed in a
+     * narrow grid slot or a full-width featured section.
+     */
+    .card-container {
+      /* Establish this element as a query container for its children. */
+      container-type: inline-size;
+      container-name: card;
+    }
+
+    /* Safe default (also acts as the fallback for browsers without
+       container query support): stacked, centered layout. */
     .card {
       background: white;
       padding: 20px;
       border-radius: 8px;
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
+      display: flex;
