+    /* Extra detail copy, only shown when the card has enough room. */
+    .card-details {
+      display: none;
+      color: #6d4c41;
+      font-size: 0.85rem;
+      margin-top: 8px;
+    }
+
+    /* Fallback for browsers without container query support: fall
+       back to a viewport-based guess so wide screens still get a
+       reasonable side-by-side layout. Progressively replaced below
+       by the real @container rules where supported. */
+    @media (min-width: 700px) {
+      .card {
+        flex-direction: row;
+        text-align: left;
+        align-items: center;
+      }
+
+      .card-media {
+        width: 120px;
+        height: 120px;
+        flex-shrink: 0;
+        display: flex;
+        align-items: center;
+        justify-content: center;
+      }
+    }
+
+    /* Container query enhancement: once the browser can measure the
+       card's own container, use that instead of the viewport. */
+    @supports (container-type: inline-size) {
+      @media (min-width: 700px) {
+        /* Reset the viewport-based fallback so it doesn't fight with
+           the container-based rules below. */
+        .card {
+          flex-direction: column;
+          text-align: center;
+        }
+
+        .card-media {
+          width: auto;
+          height: auto;
+        }
+      }
+
+      /* Side-by-side layout once the container itself is wide enough,
+         regardless of viewport size. */
+      @container card (min-width: 400px) {
+        .card {
+          flex-direction: row;
+          text-align: left;
+          align-items: center;
+        }
+
+        .card-media {
+          width: 150px;
+          height: 150px;
+          flex-shrink: 0;
+          display: flex;
+          align-items: center;
+          justify-content: center;
+        }
+      }
+
+      /* Reveal extra detail copy once there's plenty of room. */
+      @container card (min-width: 600px) {
+        .card-details {
+          display: block;
+        }
+      }
+    }
