+    /*
+     * Card component: each card is wrapped in a container-query container so
+     * its layout responds to the space it is given (e.g. in the grid above
+     * vs. a narrow sidebar), not the viewport width.
+     */
+    .card-container {
+      /* MANDATORY: marks this element as a query container for its children. */
+      container-type: inline-size;
+      container-name: card;
+    }
+
+    /* Safe default layout: stacked, used whenever container queries (or their
+       fallbacks below) don't apply. */
     .card {
       background: white;
       padding: 20px;
       border-radius: 8px;
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
+      display: flex;
