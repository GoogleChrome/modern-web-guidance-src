+      line-height: 1;
+      flex-shrink: 0;
+    }
+
+    .card-body {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      flex: 1;
     }
 
     .card h3 {
@@ -120,6 +151,68 @@
       color: var(--primary);
     }
 
+    /* Extra detail only shown when there is plenty of room. */
+    .card-details {
+      display: none;
+      margin-top: 10px;
+      padding-top: 10px;
+      border-top: 1px solid var(--secondary);
+      font-size: 0.85rem;
+    }
+
+    /* Fallback for browsers without container query support: fall back to
+       viewport width to decide when there is "probably" enough room. */
+    @media (min-width: 700px) {
+      .card {
+        flex-direction: row;
+        text-align: left;
+        align-items: center;
+      }
+
+      .card-body {
+        align-items: flex-start;
+      }
+    }
+
+    /* Progressive enhancement: where container queries are supported, let the
+       card's own width (not the viewport) drive the layout. */
+    @supports (container-type: inline-size) {
+      .card {
+        /* Reset to the safe stacked default; @container rules below take over. */
+        flex-direction: column;
+        text-align: center;
+        align-items: center;
+      }
+
+      .card-body {
+        align-items: center;
+      }
+
+      /* Side-by-side layout once the card itself has room. */
+      @container card (min-width: 400px) {
+        .card {
+          flex-direction: row;
+          text-align: left;
+          align-items: center;
+        }
+
+        .card-body {
+          align-items: flex-start;
+        }
+
+        .card-icon {
+          font-size: 3rem;
+        }
+      }
+
+      /* Show extra detail once the card is wide enough to fit it comfortably. */
+      @container card (min-width: 600px) {
+        .card-details {
+          display: block;
+        }
+      }
+    }
+
