+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>The Daily Grind | Artisanal Coffee</title>
+  <style>
+    @layer reset, base, theme, components, utilities;
+
+    @layer reset {
+      * {
+        box-sizing: border-box;
+        margin: 0;
+        padding: 0;
+      }
+    }
+
+    @layer theme {
+      :root {
+        --primary: #4e342e;
+        --secondary: #d7ccc8;
+        --accent: #ffab40;
+        --text: #3e2723;
+        --light: #fafafa;
+        --surface: #ffffff;
+        --card-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      }
+    }
+
+    @layer base {
+      body {
+        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+        line-height: 1.6;
+        color: var(--text);
+        background-color: var(--light);
+      }
+
+      :where(a):focus-visible {
+        outline: 2px solid currentColor;
+        outline-offset: 4px;
+      }
+    }
+
+    @layer components {
+      /* Navigation */
+      nav {
+        background: var(--primary);
+        color: white;
+        padding-block: 1rem;
+        padding-inline: 5%;
+        display: flex;
+        justify-content: space-between;
+        align-items: center;
+        position: sticky;
+        inset-block-start: 0;
+        z-index: 1000;
+      }
+
+      .logo {
+        font-size: 1.5rem;
+        font-weight: bold;
+        letter-spacing: 1px;
+      }
+
+      nav ul {
+        display: flex;
+        list-style: none;
+      }
+
+      nav ul li:not(:first-child) {
+        margin-inline-start: 20px;
+      }
+
+      nav a {
+        color: white;
+        text-decoration: none;
+        font-size: 0.9rem;
+        transition: color 0.3s;
+      }
+
+      nav a:where(:hover, :focus-visible):not(:disabled, [aria-disabled="true"]) {
+        color: var(--accent);
+      }
+
+      .logout-link {
+        border: 1px solid var(--accent);
+        padding-block: 5px;
+        padding-inline: 12px;
+        border-radius: 4px;
+      }
+
+      /* Hero Section */
+      .hero {
+        block-size: 60vh;
+        min-block-size: 60vh;
+        background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+          url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+        background-size: cover;
+        background-position: center;
+        display: flex;
+        flex-direction: column;
+        justify-content: center;
+        align-items: center;
+        color: white;
+        text-align: center;
+        padding-block: 0;
+        padding-inline: 20px;
+      }
+
+      .hero h1 {
+        font-size: 3rem;
+        margin-block-end: 1rem;
+      }
+
+      /* Content Sections */
+      .container {
+        max-inline-size: 1100px;
+        margin-block: 40px;
+        margin-inline: auto;
+        padding-block: 0;
+        padding-inline: 20px;
+      }
+
+      .grid {
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+        gap: 20px;
+        margin-block-start: 20px;
+      }
+
+      .card {
+        background: var(--surface);
+        padding-block: 20px;
+        padding-inline: 20px;
+        border-radius: 8px;
+        box-shadow: var(--card-shadow);
+        text-align: center;
+      }
+
+      .card h3 {
+        margin-block-end: 10px;
+        color: var(--primary);
+      }
+
+      .btn {
+        display: inline-block;
+        background: var(--primary);
+        color: white;
+        padding-block: 10px;
+        padding-inline: 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-block-start: 15px;
+        transition: background 0.3s;
+      }
+
+      :is(.btn, button):where(:hover, :focus-visible):not(:disabled, [aria-disabled="true"]) {
+        background: #3e2723;
+      }
+
+      .card:has(.btn:where(:hover, :focus-visible):not(:disabled, [aria-disabled="true"])) {
+        outline: 2px solid var(--primary);
+        outline-offset: 2px;
+      }
+
+      footer {
+        background: var(--secondary);
+        text-align: center;
+        padding-block: 40px;
+        padding-inline: 20px;
+        margin-block-start: 40px;
+      }
+
+      .footer-links {
+        margin-block-end: 20px;
+      }
+
+      .footer-links a {
+        margin-block: 0;
+        margin-inline: 10px;
+        color: var(--text);
+        text-decoration: none;
+        font-size: 0.85rem;
+      }
+    }
+
+    @layer utilities {
+      .text-center {
+        text-align: center;
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        :is(nav a, .btn) {
+          transition: none;
+        }
+      }
+    }
+  </style>
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="hero">
+    <h1>Wake Up Your Senses</h1>
+    <p>Ethically sourced, locally roasted, delivered to your cup.</p>
+    <a href="/order-online" class="btn">Order Now</a>
+  </header>
+
+  <main class="container">
+    <section>
+      <h2 class="text-center">Seasonal Favorites</h2>
+      <div class="grid">
+        <div class="card">
+          <h3>Maple Oat Latte</h3>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+          <a href="/menu/seasonal" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Dark Roast Espresso</h3>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+          <a href="/menu/espresso" class="btn">View Details</a>
+        </div>
+        <div class="card">
+          <h3>Cold Brew</h3>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+          <a href="/menu/cold-brew" class="btn">View Details</a>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+</body>
+
+</html>
