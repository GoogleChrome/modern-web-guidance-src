diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..b440207 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,111 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+:root {
+  --brand-accent: #b45309; /* amber-700 */
+  --brand-accent-hover: #92400e; /* amber-800 */
+}
+
+/*
+ * Semantic surface context.
+ * Featured surfaces only declare the context; they never name the components
+ * that adapt to it. Style queries match descendants of the element that sets
+ * the property, so no `container-type` is required.
+ */
+.featured {
+  --surface: featured;
+}
+
+/*
+ * Context-aware teaser components.
+ * Components only react to the inherited `--surface` flag; they never inspect
+ * which section produced it.
+ */
+@layer components {
+  /* Default (standard surface): badge hidden */
+  .teaser-badge {
+    display: none;
+    align-self: flex-start;
+    margin-bottom: 0.5rem;
+    padding: 0.125rem 0.5rem;
+    border-radius: 9999px;
+    background: var(--brand-accent);
+    color: white;
+    font-size: 0.6875rem;
+    font-weight: 700;
+    letter-spacing: 0.08em;
+    line-height: 1.25rem;
+    text-transform: uppercase;
+  }
+
+  /* Default (standard surface): subtle outlined button */
+  .teaser-action {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.25rem;
+    padding: 0.375rem 0.875rem;
+    border-radius: 0.375rem;
+    border: 1px solid currentColor;
+    background: transparent;
+    color: var(--brand-accent);
+    font-size: 0.875rem;
+    font-weight: 600;
+    line-height: 1.25rem;
+    transition:
+      background-color 150ms ease,
+      color 150ms ease,
+      border-color 150ms ease;
+  }
+
+  .teaser-action:hover {
+    background: color-mix(in srgb, var(--brand-accent) 8%, transparent);
+  }
+
+  .teaser-action:focus-visible {
+    outline: 2px solid var(--brand-accent);
+    outline-offset: 2px;
+  }
+
+  /*
+   * Selector-based fallback for browsers without container style query
+   * support. `:where()` keeps specificity equal to the style query rules
+   * below so they win by source order when supported.
+   * Remove once style queries are widely available.
+   */
+  :where(.featured) .teaser-badge {
+    display: inline-block;
+  }
+
+  :where(.featured) .teaser-action {
+    background: var(--brand-accent);
+    border-color: var(--brand-accent);
+    color: white;
+  }
+
+  :where(.featured) .teaser-action:hover {
+    background: var(--brand-accent-hover);
+    border-color: var(--brand-accent-hover);
+  }
+
+  /* Progressive enhancement: react to the semantic surface context */
+  @container style(--surface: featured) {
+    .teaser-badge {
+      /* Reveal promotional badge only on featured surfaces */
+      display: inline-block;
+    }
+
+    .teaser-action {
+      /* Switch to the filled, prominent variant */
+      background: var(--brand-accent);
+      border-color: var(--brand-accent);
+      color: white;
+    }
+
+    .teaser-action:hover {
+      background: var(--brand-accent-hover);
+      border-color: var(--brand-accent-hover);
+    }
+  }
+}
