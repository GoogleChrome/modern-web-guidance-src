diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..862565c 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,74 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+/*
+ * Usage-aware component variations (container style queries).
+ *
+ * `.surface-featured` is applied by *context providers* (e.g. the hero
+ * section on the homepage, the lead story in a teaser grid) to flag the
+ * surface as promotional. Teaser cards react to the inherited `--surface`
+ * custom property without knowing what produced it, and surfaces never
+ * name the components that react to them.
+ */
+.surface-featured {
+  --surface: featured;
+}
+
+.teaser-media {
+  position: relative;
+}
+
+.teaser-badge {
+  display: none;
+  position: absolute;
+  inset-block-start: 0.75rem;
+  inset-inline-end: 0.75rem;
+  inline-size: max-content;
+  padding-block: 0.25rem;
+  padding-inline: 0.75rem;
+  background: #f59e0b;
+  color: white;
+  font-size: 0.75rem;
+  font-weight: 600;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+  border-radius: 999px;
+}
+
+.teaser-category-chip {
+  display: inline-block;
+  inline-size: fit-content;
+  padding-block: 0.25rem;
+  padding-inline: 0.75rem;
+  background: transparent;
+  border: 1px solid currentColor;
+  border-radius: 999px;
+  transition: background-color 0.2s ease, color 0.2s ease;
+}
+
+/* Progressive-enhancement fallback: selector-based, works everywhere. */
+:where(.surface-featured) .teaser-badge {
+  display: block;
+}
+
+:where(.surface-featured) .teaser-category-chip {
+  background: #f59e0b;
+  color: white;
+  border-color: transparent;
+}
+
+/* Style query: overrides the selector fallback once supported (same
+   specificity, later in source order — no browser-support branching needed). */
+@container style(--surface: featured) {
+  .teaser-badge {
+    display: block;
+  }
+
+  .teaser-category-chip {
+    background: #f59e0b;
+    color: white;
+    border-color: transparent;
+  }
 }
