diff --git a/src/components/ArticlePromotion.astro b/src/components/ArticlePromotion.astro
new file mode 100644
index 0000000..3b911d8
--- /dev/null
+++ b/src/components/ArticlePromotion.astro
@@ -0,0 +1,82 @@
+---
+interface Props {
+    href: string;
+    title: string;
+}
+
+const { href, title } = Astro.props;
+---
+
+<div class="article-promotion">
+    <span class="promotion-badge">Featured story</span>
+    <a class="story-button" href={href} aria-label={`Read story: ${title}`}>Read story</a>
+</div>
+
+<style>
+    .article-promotion {
+        display: flex;
+        flex-wrap: wrap;
+        align-items: center;
+        gap: 0.75rem;
+        margin-block-start: 1rem;
+    }
+
+    .promotion-badge {
+        display: none;
+        padding-block: 0.25rem;
+        padding-inline: 0.625rem;
+        border-radius: 999px;
+        background: #fef3c7;
+        color: #78350f;
+        font-size: 0.75rem;
+        font-weight: 600;
+    }
+
+    .story-button {
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        min-block-size: 2.75rem;
+        padding-block: 0.5rem;
+        padding-inline: 1rem;
+        border: 1px solid currentColor;
+        border-radius: 0.375rem;
+        background: transparent;
+        color: #92400e;
+        font-weight: 600;
+        text-decoration: none;
+    }
+
+    .story-button:hover {
+        text-decoration: underline;
+    }
+
+    .story-button:focus-visible {
+        outline: 2px solid #92400e;
+        outline-offset: 3px;
+    }
+
+    /* Compatibility fallback; :where() keeps the context specificity at zero. */
+    :global(:where([data-surface="featured"])) .promotion-badge {
+        display: inline-flex;
+    }
+
+    :global(:where([data-surface="featured"])) .story-button {
+        background: #92400e;
+        border-color: #92400e;
+        color: #fff;
+    }
+
+    /* Any ancestor can supply this semantic context, independently of markup. */
+    @container style(--surface: featured) {
+        .promotion-badge {
+            display: inline-flex;
+        }
+
+        .story-button {
+            background: #92400e;
+            border-color: #92400e;
+            color: #fff;
+        }
+    }
+</style>
