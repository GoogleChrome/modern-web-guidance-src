diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..41beb39 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,77 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+:root {
+  --brand-accent: #d97706;
+}
+
+/* 1. Set the context on a layout container */
+.featured,
+section.featured,
+main.featured {
+  --surface: featured; /* Semantic context flag for children */
+}
+
+/* 2. Component reacts to inherited flag */
+.button,
+.action-button {
+  /* Default: Outlined informational style */
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 0.25rem 0.625rem;
+  font-size: 0.75rem;
+  font-weight: 500;
+  border-radius: 0.375rem;
+  cursor: pointer;
+  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
+  background: transparent;
+  border: 1px solid currentColor;
+}
+
+.badge,
+.promotional-badge {
+  /* Default: Hidden — only revealed in featured surfaces */
+  display: none;
+  width: fit-content;
+  padding: 0.125rem 0.5rem;
+  font-size: 0.75rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  border-radius: 0.25rem;
+  background-color: var(--brand-accent);
+  color: white;
+}
+
+/* Selector-based contextual styles — broad browser support */
+:where(.featured) .button,
+:where(.featured) .action-button {
+  background: var(--brand-accent);
+  color: white;
+  border: none;
+}
+
+:where(.featured) .badge,
+:where(.featured) .promotional-badge {
+  display: block;
+}
+
+/* Progressive enhancement: style queries override when supported */
+@container style(--surface: featured) {
+  .button,
+  .action-button {
+    /* Automatic switch to Filled promotional style */
+    background: var(--brand-accent);
+    color: white;
+    border: none;
+  }
+
+  .badge,
+  .promotional-badge {
+    /* Reveal decorative elements only in featured context */
+    display: block;
+  }
+}
