+  <script>
+    (() => {
+      const SOURCE_LANGUAGE = 'en';
+
+      const LANGUAGES = [
+        ['ar', 'Arabic'], ['bg', 'Bulgarian'], ['bn', 'Bengali'], ['cs', 'Czech'],
+        ['da', 'Danish'], ['de', 'German'], ['el', 'Greek'], ['es', 'Spanish'],
+        ['fi', 'Finnish'], ['fr', 'French'], ['he', 'Hebrew'], ['hi', 'Hindi'],
+        ['hr', 'Croatian'], ['hu', 'Hungarian'], ['id', 'Indonesian'], ['it', 'Italian'],
+        ['ja', 'Japanese'], ['kn', 'Kannada'], ['ko', 'Korean'], ['lt', 'Lithuanian'],
+        ['mr', 'Marathi'], ['nl', 'Dutch'], ['no', 'Norwegian'], ['pl', 'Polish'],
+        ['pt', 'Portuguese'], ['ro', 'Romanian'], ['ru', 'Russian'], ['sk', 'Slovak'],
+        ['sl', 'Slovenian'], ['sv', 'Swedish'], ['ta', 'Tamil'], ['te', 'Telugu'],
+        ['th', 'Thai'], ['tr', 'Turkish'], ['uk', 'Ukrainian'], ['vi', 'Vietnamese'],
+        ['zh', 'Chinese (Simplified)'], ['zh-Hant', 'Chinese (Traditional)'],
+      ];
+
+      const select = document.getElementById('translate-language');
+      const translateBtn = document.getElementById('translate-btn');
+      const resetBtn = document.getElementById('translate-reset-btn');
+      const statusEl = document.getElementById('translate-status');
+      const progressEl = document.getElementById('translate-progress');
+      const progressBar = document.getElementById('translate-progress-bar');
+
+      const nodes = Array.from(document.querySelectorAll('[data-translate]'));
+      const originals = new Map(nodes.map((node) => [node, node.textContent]));
+      const translators = new Map();
+
+      const languageName = (code) =>
+        (LANGUAGES.find(([value]) => value === code) || [code, code])[1];
+
+      const setStatus = (message, tone) => {
+        statusEl.textContent = message;
+        if (tone) {
+          statusEl.dataset.tone = tone;
+        } else {
+          delete statusEl.dataset.tone;
+        }
+      };
+
+      const showProgress = (fraction) => {
+        progressEl.hidden = false;
+        progressBar.style.width = `${Math.round(fraction * 100)}%`;
+      };
+
+      const hideProgress = () => {
+        progressEl.hidden = true;
+        progressBar.style.width = '0%';
+      };
+
+      // Identical options object is shared by availability() and create().
+      const buildOptions = (targetLanguage) => ({
+        sourceLanguage: SOURCE_LANGUAGE,
+        targetLanguage,
+      });
+
+      const disableFeature = (message) => {
+        select.disabled = true;
+        translateBtn.disabled = true;
+        resetBtn.hidden = true;
+        hideProgress();
+        setStatus(message, 'error');
+      };
+
+      const restoreOriginal = () => {
+        for (const node of nodes) {
+          node.textContent = originals.get(node);
+        }
+        document.documentElement.lang = SOURCE_LANGUAGE;
+        resetBtn.hidden = true;
+      };
+
+      for (const [code, label] of LANGUAGES) {
+        const option = document.createElement('option');
+        option.value = code;
+        option.textContent = label;
+        select.append(option);
+      }
+      select.value = 'fr';
+
+      if (!('Translator' in self)) {
+        disableFeature('Client-side translation is currently unsupported in this browser.');
+        return;
+      }
+
+      let availabilityToken = 0;
+
+      const refreshAvailability = async () => {
+        const token = ++availabilityToken;
+        const targetLanguage = select.value;
+        translateBtn.disabled = true;
+        setStatus(`Checking availability for ${languageName(targetLanguage)}…`);
+
+        let availability;
+        try {
+          availability = await Translator.availability(buildOptions(targetLanguage));
+        } catch (error) {
+          if (token !== availabilityToken) return;
+          setStatus(`Translation to ${languageName(targetLanguage)} is unavailable: ${error.message}`, 'error');
+          return;
+        }
+
+        if (token !== availabilityToken) return;
+
+        switch (availability) {
+          case 'available':
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Translate';
+            setStatus(`${languageName(targetLanguage)} is ready to translate on this device.`);
+            break;
+          case 'downloadable':
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Download & translate';
+            setStatus(`${languageName(targetLanguage)} needs a one-time model download. Press the button to start it.`);
+            break;
+          case 'downloading':
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Translate';
+            setStatus(`The ${languageName(targetLanguage)} model is still downloading. Press the button to translate when it finishes.`);
+            break;
+          case 'unavailable':
+          default:
+            translateBtn.disabled = true;
+            translateBtn.textContent = 'Translate';
+            setStatus(`Translation to ${languageName(targetLanguage)} is not supported on this device.`, 'error');
+            break;
+        }
+      };
+
+      const getTranslator = async (targetLanguage) => {
+        const cached = translators.get(targetLanguage);
+        if (cached) return cached;
+
+        // Called from a click handler so the download has the required user gesture.
+        const translator = await Translator.create({
+          ...buildOptions(targetLanguage),
+          monitor(m) {
+            m.addEventListener('downloadprogress', (event) => {
+              showProgress(event.loaded);
+              setStatus(`Downloading the ${languageName(targetLanguage)} model: ${Math.round(event.loaded * 100)}%`);
+            });
+          },
+        });
+
+        translators.set(targetLanguage, translator);
+        return translator;
+      };
+
+      translateBtn.addEventListener('click', async () => {
+        const targetLanguage = select.value;
+        select.disabled = true;
+        translateBtn.disabled = true;
+
+        try {
+          const availability = await Translator.availability(buildOptions(targetLanguage));
+          if (availability === 'unavailable') {
+            setStatus(`Translation to ${languageName(targetLanguage)} is not supported on this device.`, 'error');
+            return;
+          }
+
+          const translator = await getTranslator(targetLanguage);
+          hideProgress();
+          setStatus(`Translating into ${languageName(targetLanguage)}…`);
+
+          for (const node of nodes) {
+            node.textContent = await translator.translate(originals.get(node));
+          }
+
+          document.documentElement.lang = targetLanguage;
+          resetBtn.hidden = false;
+          setStatus(`Translated into ${languageName(targetLanguage)} on your device.`);
+        } catch (error) {
+          hideProgress();
+          restoreOriginal();
+          const reason = error.name === 'NotAllowedError'
+            ? 'the browser blocked the model download'
+            : error.message;
+          setStatus(`Translation failed: ${reason}. The original text is shown instead.`, 'error');
+        } finally {
+          hideProgress();
+          select.disabled = false;
+          translateBtn.disabled = false;
+        }
+      });
+
+      resetBtn.addEventListener('click', () => {
+        restoreOriginal();
+        setStatus('Showing the original English text.');
+      });
+
+      select.addEventListener('change', () => {
+        restoreOriginal();
+        refreshAvailability();
+      });
+
+      refreshAvailability();
+    })();
+  </script>
+
 </body>
 
