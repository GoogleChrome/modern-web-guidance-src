+  <script>
+    (() => {
+      'use strict';
+
+      // BCP 47 codes supported by Chrome's Translator API.
+      const SUPPORTED_LANGUAGES = [
+        ['ar', 'Arabic'], ['bg', 'Bulgarian'], ['bn', 'Bengali'], ['cs', 'Czech'],
+        ['da', 'Danish'], ['de', 'German'], ['el', 'Greek'], ['en', 'English'],
+        ['es', 'Spanish'], ['fi', 'Finnish'], ['fr', 'French'], ['hi', 'Hindi'],
+        ['hr', 'Croatian'], ['hu', 'Hungarian'], ['id', 'Indonesian'], ['it', 'Italian'],
+        ['he', 'Hebrew'], ['ja', 'Japanese'], ['kn', 'Kannada'], ['ko', 'Korean'],
+        ['lt', 'Lithuanian'], ['mr', 'Marathi'], ['nl', 'Dutch'], ['no', 'Norwegian'],
+        ['pl', 'Polish'], ['pt', 'Portuguese'], ['ro', 'Romanian'], ['ru', 'Russian'],
+        ['sk', 'Slovak'], ['sl', 'Slovenian'], ['sv', 'Swedish'], ['ta', 'Tamil'],
+        ['te', 'Telugu'], ['th', 'Thai'], ['tr', 'Turkish'], ['uk', 'Ukrainian'],
+        ['vi', 'Vietnamese'], ['zh', 'Chinese (Simplified)'], ['zh-Hant', 'Chinese (Traditional)'],
+      ];
+
+      const PAGE_LANGUAGE = 'en';
+
+      const bar = document.getElementById('translate-bar');
+      const select = document.getElementById('target-language');
+      const translateBtn = document.getElementById('translate-btn');
+      const restoreBtn = document.getElementById('restore-btn');
+      const statusEl = document.getElementById('translate-status');
+      const progressEl = document.getElementById('download-progress');
+      const progressFill = document.getElementById('download-progress-fill');
+
+      const nodes = Array.from(document.querySelectorAll('[data-translate]'));
+      const originalText = new Map(
+        nodes.map((node) => [node, node.textContent.replace(/\s+/g, ' ').trim()]),
+      );
+
+      let currentAvailability = 'unavailable';
+      let busy = false;
+
+      const setStatus = (message, tone) => {
+        statusEl.textContent = message;
+        if (tone) {
+          statusEl.dataset.tone = tone;
+        } else {
+          delete statusEl.dataset.tone;
+        }
+      };
+
+      const showProgress = (ratio) => {
+        progressEl.hidden = false;
+        progressFill.style.width = `${Math.round(ratio * 100)}%`;
+      };
+
+      const hideProgress = () => {
+        progressEl.hidden = true;
+        progressFill.style.width = '0%';
+      };
+
+      const restoreOriginal = () => {
+        for (const [node, text] of originalText) {
+          node.textContent = text;
+        }
+        document.documentElement.lang = PAGE_LANGUAGE;
+        restoreBtn.hidden = true;
+      };
+
+      const languageName = (code) => {
+        const match = SUPPORTED_LANGUAGES.find(([value]) => value === code);
+        return match ? match[1] : code;
+      };
+
+      // --- Fallback: the Translator API is not in this browser at all. ---
+      const disableTranslation = (message) => {
+        select.disabled = true;
+        translateBtn.disabled = true;
+        restoreBtn.hidden = true;
+        hideProgress();
+        setStatus(message);
+      };
+
+      if (!('Translator' in self)) {
+        disableTranslation(
+          'Client-side translation is currently unsupported in this browser. ' +
+          'Open The Daily Grind in Chrome 138+ or Edge 148+ on desktop to read this page in your language.',
+        );
+        bar.dataset.unsupported = 'true';
+        return;
+      }
+
+      for (const [code, label] of SUPPORTED_LANGUAGES) {
+        if (code === PAGE_LANGUAGE) continue;
+        const option = document.createElement('option');
+        option.value = code;
+        option.textContent = label;
+        select.append(option);
+      }
+
+      const suggestedLanguage = () => {
+        const codes = [navigator.language, ...(navigator.languages || [])];
+        for (const code of codes) {
+          if (!code) continue;
+          const exact = SUPPORTED_LANGUAGES.find(([value]) => value.toLowerCase() === code.toLowerCase());
+          if (exact && exact[0] !== PAGE_LANGUAGE) return exact[0];
+          const base = code.split('-')[0].toLowerCase();
+          const primary = SUPPORTED_LANGUAGES.find(([value]) => value.toLowerCase() === base);
+          if (primary && primary[0] !== PAGE_LANGUAGE) return primary[0];
+        }
+        return 'es';
+      };
+
+      select.value = suggestedLanguage();
+
+      // The identical options object is handed to both availability() and create().
+      const buildOptions = (targetLanguage) => ({
+        sourceLanguage: PAGE_LANGUAGE,
+        targetLanguage,
+      });
+
+      const refreshAvailability = async () => {
+        const targetLanguage = select.value;
+
+        if (!targetLanguage) {
+          currentAvailability = 'unavailable';
+          translateBtn.disabled = true;
+          setStatus('Choose a language to translate this page on your device.');
+          return;
+        }
+
+        translateBtn.disabled = true;
+        setStatus(`Checking on-device support for English → ${languageName(targetLanguage)}…`);
+
+        const options = buildOptions(targetLanguage);
+        let availability;
+        try {
+          availability = await Translator.availability(options);
+        } catch (error) {
+          console.error('Translator.availability() failed', error);
+          currentAvailability = 'unavailable';
+          setStatus('Translation is unavailable right now. Please try again later.', 'error');
+          return;
+        }
+
+        // Ignore a stale response if the user changed the language meanwhile.
+        if (select.value !== targetLanguage) return;
+
+        currentAvailability = availability;
+
+        switch (availability) {
+          case 'available':
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Translate page';
+            setStatus(`${languageName(targetLanguage)} is ready on this device — no download needed.`);
+            break;
+          case 'downloadable':
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Download & translate';
+            setStatus(
+              `${languageName(targetLanguage)} needs a one-time language pack. ` +
+              'Select "Download & translate" to fetch it.',
+            );
+            break;
+          case 'downloading':
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Resume & translate';
+            setStatus(
+              `The ${languageName(targetLanguage)} language pack is already downloading. ` +
+              'Select "Resume & translate" to follow its progress.',
+            );
+            break;
+          case 'unavailable':
+          default:
+            translateBtn.disabled = true;
+            translateBtn.textContent = 'Translate page';
+            setStatus(
+              `${languageName(targetLanguage)} is not supported on this device. ` +
+              'Try another language, or use your browser’s built-in page translation.',
+              'error',
+            );
+            break;
+        }
+      };
+
+      const translatePage = async (translator, targetLanguage) => {
+        for (const [node, text] of originalText) {
+          if (!text) continue;
+
+          if (node.hasAttribute('data-translate-long')) {
+            // Long copy streams in so readers see it fill progressively.
+            let streamed = '';
+            node.textContent = '';
+            for await (const chunk of translator.translateStreaming(text)) {
+              streamed += chunk;
+              node.textContent = streamed;
+            }
+          } else {
+            node.textContent = await translator.translate(text);
+          }
+        }
+        document.documentElement.lang = targetLanguage;
+        restoreBtn.hidden = false;
+      };
+
+      // create() runs inside this click handler so the download has a user gesture.
+      translateBtn.addEventListener('click', async () => {
+        const targetLanguage = select.value;
+        if (busy || !targetLanguage || currentAvailability === 'unavailable') return;
+
+        busy = true;
+        translateBtn.disabled = true;
+        select.disabled = true;
+        hideProgress();
+
+        const options = buildOptions(targetLanguage);
+
+        if (currentAvailability === 'available') {
+          setStatus(`Translating into ${languageName(targetLanguage)}…`);
+        } else {
+          setStatus(`Preparing the ${languageName(targetLanguage)} language pack…`);
+        }
+
+        let translator;
+        try {
+          translator = await Translator.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (event) => {
+                const ratio = event.total ? event.loaded / event.total : event.loaded;
+                showProgress(ratio);
+                setStatus(`Downloading ${languageName(targetLanguage)} model… ${Math.round(ratio * 100)}%`);
+              });
+            },
+          });
+
+          hideProgress();
+          setStatus(`Translating into ${languageName(targetLanguage)}…`);
+          await translatePage(translator, targetLanguage);
+          setStatus(`This page is now shown in ${languageName(targetLanguage)}, translated on your device.`);
+          currentAvailability = 'available';
+        } catch (error) {
+          console.error('On-device translation failed', error);
+          restoreOriginal();
+          hideProgress();
+          const reason = error && error.name === 'NotAllowedError'
+            ? 'The browser blocked the language pack download. Select the button again to retry.'
+            : 'We could not translate this page on your device. The original English text is shown instead.';
+          setStatus(reason, 'error');
+        } finally {
+          translator?.destroy?.();
+          busy = false;
+          select.disabled = false;
+          translateBtn.disabled = false;
+        }
+      });
+
+      restoreBtn.addEventListener('click', () => {
+        restoreOriginal();
+        setStatus('Showing the original English text.');
+      });
+
+      select.addEventListener('change', () => {
+        restoreOriginal();
+        refreshAvailability();
+      });
+
+      refreshAvailability();
+    })();
+  </script>
+
