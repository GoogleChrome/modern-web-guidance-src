@@ -0,0 +1,179 @@
+/**
+ * @typedef {'available'|'downloadable'|'downloading'|'unavailable'} TranslatorAvailability
+ * @typedef {{loaded: number}} DownloadProgressEvent
+ * @typedef {{addEventListener(type: 'downloadprogress', listener: (event: DownloadProgressEvent) => void): void}} TranslatorMonitor
+ * @typedef {{translate(text: string): Promise<string>, destroy?: () => void}} TranslatorInstance
+ * @typedef {{sourceLanguage: string, targetLanguage: string, monitor: (monitor: TranslatorMonitor) => void}} TranslatorOptions
+ * @typedef {{availability(options: TranslatorOptions): Promise<TranslatorAvailability>, create(options: TranslatorOptions): Promise<TranslatorInstance>}} TranslatorFactory
+ */
+
+const translatorCard = document.querySelector('#translator-card');
+const targetLanguage = document.querySelector('#target-language');
+const translateButton = document.querySelector('#translate-button');
+const translateButtonLabel = document.querySelector('#translate-button-label');
+const resetButton = document.querySelector('#reset-button');
+const statusMessage = document.querySelector('#status-message');
+const progressWrap = document.querySelector('#progress-wrap');
+const progressBar = document.querySelector('#download-progress');
+const progressValue = document.querySelector('#progress-value');
+const translatableElements = [...document.querySelectorAll('[data-translate]')];
+const navToggle = document.querySelector('.nav-toggle');
+const navLinks = document.querySelector('#nav-links');
+
+/** @type {Map<Element, string>} */
+const originalText = new Map(translatableElements.map((element) => [element, element.textContent?.trim() ?? '']));
+/** @type {TranslatorInstance|null} */
+let activeTranslator = null;
+/** @type {TranslatorOptions|null} */
+let currentTranslatorOptions = null;
+/** @type {TranslatorAvailability|null} */
+let availability = null;
+let translatedLanguage = '';
+let requestVersion = 0;
+
+function getTranslatorFactory() {
+  // The current Translator API is exposed directly on the global Window object.
+  return 'Translator' in window ? /** @type {TranslatorFactory} */ (window.Translator) : null;
+}
+
+/** @param {string} message @param {'checking'|'ready'|'error'} [state] */
+function setStatus(message, state = 'checking') {
+  statusMessage.textContent = message;
+  translatorCard?.querySelector('.translator-status')?.classList.toggle('is-ready', state === 'ready');
+  translatorCard?.querySelector('.translator-status')?.classList.toggle('is-error', state === 'error');
+}
+
+/** @param {number} loaded */
+function updateDownloadProgress(loaded) {
+  const percent = Math.max(0, Math.min(100, Math.round(loaded * 100)));
+  progressWrap.hidden = false;
+  progressBar.value = percent;
+  progressBar.textContent = `${percent}%`;
+  progressValue.textContent = `${percent}%`;
+  setStatus(percent < 100 ? 'Downloading the language model…' : 'Language model ready.', percent < 100 ? 'checking' : 'ready');
+}
+
+/** @returns {TranslatorOptions} */
+function makeTranslatorOptions() {
+  return {
+    sourceLanguage: 'en',
+    targetLanguage: targetLanguage.value,
+    monitor(monitor) {
+      monitor.addEventListener('downloadprogress', (event) => updateDownloadProgress(event.loaded));
+    },
+  };
+}
+
+async function checkAvailability() {
+  const factory = getTranslatorFactory();
+  const version = ++requestVersion;
+  availability = null;
+  currentTranslatorOptions = null;
+  translateButton.disabled = true;
+  progressWrap.hidden = true;
+  resetButton.hidden = translatedLanguage === '';
+
+  if (!factory) {
+    setStatus('On-device translation is not supported in this browser. Try Chrome 138+ or Edge 148+ on desktop.', 'error');
+    translateButtonLabel.textContent = 'Translation unavailable';
+    return;
+  }
+
+  setStatus('Checking this language pair…');
+  try {
+    const options = makeTranslatorOptions();
+    currentTranslatorOptions = options;
+    const result = await factory.availability(options);
+    if (version !== requestVersion) return;
+    availability = result;
+
+    if (result === 'available') {
+      setStatus('Ready to translate privately on this device.', 'ready');
+      translateButtonLabel.textContent = 'Translate the menu';
+      translateButton.disabled = false;
+    } else if (result === 'downloadable') {
+      setStatus('A small language model is needed. Download starts when you continue.');
+      translateButtonLabel.textContent = 'Download & translate';
+      translateButton.disabled = false;
+    } else if (result === 'downloading') {
+      setStatus('The language model is downloading. Continue to view progress.');
+      translateButtonLabel.textContent = 'Continue download';
+      translateButton.disabled = false;
+    } else {
+      setStatus('This language pair is not available on your device.', 'error');
+      translateButtonLabel.textContent = 'Language unavailable';
+    }
+  } catch (error) {
+    console.error('Could not check translation availability.', error);
+    setStatus('We could not check on-device translation right now. Please try again.', 'error');
+    translateButtonLabel.textContent = 'Try again';
+    translateButton.disabled = false;
+  }
+}
+
+async function translateMenu() {
+  const factory = getTranslatorFactory();
+  if (!factory) return;
+
+  translateButton.disabled = true;
+  targetLanguage.disabled = true;
+  translateButtonLabel.textContent = availability === 'available' ? 'Translating…' : 'Preparing model…';
+
+  try {
+    activeTranslator?.destroy?.();
+    // create() runs only from this click handler. It receives the same options
+    // object that availability() checked, including both language codes.
+    const options = currentTranslatorOptions ?? makeTranslatorOptions();
+    activeTranslator = await factory.create(options);
+    const translations = await Promise.all(
+      translatableElements.map((element) => activeTranslator.translate(originalText.get(element) ?? '')),
+    );
+    translations.forEach((translation, index) => { translatableElements[index].textContent = translation; });
+    translatedLanguage = targetLanguage.value;
+    document.querySelector('#translatable-menu')?.setAttribute('lang', translatedLanguage);
+    progressWrap.hidden = true;
+    resetButton.hidden = false;
+    setStatus('Menu translated on your device.', 'ready');
+    translateButtonLabel.textContent = 'Translate again';
+  } catch (error) {
+    console.error('On-device translation failed.', error);
+    const denied = error instanceof DOMException && error.name === 'NotAllowedError';
+    setStatus(denied ? 'Click the button again to allow the model download.' : 'Translation did not finish. Please try again.', 'error');
+    translateButtonLabel.textContent = 'Try again';
+  } finally {
+    translateButton.disabled = false;
+    targetLanguage.disabled = false;
+  }
+}
+
+function resetTranslation() {
+  originalText.forEach((text, element) => { element.textContent = text; });
+  translatedLanguage = '';
+  document.querySelector('#translatable-menu')?.setAttribute('lang', 'en');
+  resetButton.hidden = true;
+  setStatus('Original English menu restored.', 'ready');
+}
+
+targetLanguage?.addEventListener('change', () => {
+  activeTranslator?.destroy?.();
+  activeTranslator = null;
+  resetTranslation();
+  void checkAvailability();
+});
+translateButton?.addEventListener('click', () => {
+  if (availability === null && translateButtonLabel.textContent === 'Try again') void checkAvailability();
+  else void translateMenu();
+});
+resetButton?.addEventListener('click', resetTranslation);
+
+navToggle?.addEventListener('click', () => {
+  const open = navToggle.getAttribute('aria-expanded') !== 'true';
+  navToggle.setAttribute('aria-expanded', String(open));
+  navLinks?.classList.toggle('is-open', open);
+});
+navLinks?.addEventListener('click', () => {
+  navToggle?.setAttribute('aria-expanded', 'false');
+  navLinks.classList.remove('is-open');
+});
+
+void checkAvailability();
