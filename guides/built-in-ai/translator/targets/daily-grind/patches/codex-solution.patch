+@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap');
+
+:root {
+  --ink: #241813;
+  --coffee: #43291f;
+  --cream: #f4efe5;
+  --paper: #fbf9f4;
+  --orange: #eb7047;
+  --sage: #c7c8ad;
+  --line: rgba(36, 24, 19, 0.18);
+  --serif: 'DM Serif Display', Georgia, serif;
+  --sans: 'DM Sans', system-ui, sans-serif;
+}
+
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body { margin: 0; color: var(--ink); background: var(--paper); font-family: var(--sans); line-height: 1.6; }
+a { color: inherit; }
+button, select { font: inherit; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
+.skip-link { position: fixed; z-index: 100; top: -60px; left: 1rem; padding: .65rem 1rem; color: white; background: var(--ink); transition: top .2s; }
+.skip-link:focus { top: 1rem; }
+
+.site-nav { height: 84px; padding: 0 clamp(1.25rem, 5vw, 5rem); display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,.18); position: absolute; z-index: 10; width: 100%; color: white; }
+.logo { display: flex; gap: .75rem; align-items: center; text-decoration: none; text-transform: uppercase; font-size: .84rem; font-weight: 700; letter-spacing: .18em; }
+.logo-mark { display: grid; place-items: center; width: 39px; height: 39px; border: 1px solid currentColor; border-radius: 50%; font-family: var(--serif); font-size: .78rem; letter-spacing: 0; }
+.nav-links { display: flex; align-items: center; gap: 2.25rem; }
+.nav-links a { text-decoration: none; font-size: .83rem; font-weight: 600; }
+.nav-links a:not(.nav-order):hover { color: #f3c9b8; }
+.nav-order { border: 1px solid rgba(255,255,255,.65); padding: .7rem 1.05rem; transition: .2s; }
+.nav-order:hover { background: white; color: var(--ink); }
+.nav-toggle { display: none; padding: .4rem; color: white; background: none; border: 0; }
+.nav-toggle span:not(.sr-only) { display: block; width: 22px; height: 1px; background: currentColor; margin: 5px 0; }
+
+.hero { min-height: 720px; height: 92vh; max-height: 900px; position: relative; display: flex; align-items: center; padding: 7rem clamp(1.5rem, 8vw, 9rem) 4rem; color: white; background: linear-gradient(90deg, rgba(25,14,10,.88) 0%, rgba(25,14,10,.4) 58%, rgba(25,14,10,.22)), url('https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&fit=crop&w=1800&q=88') center/cover; }
+.hero-inner { width: min(760px, 100%); }
+.eyebrow { margin: 0 0 1.25rem; text-transform: uppercase; letter-spacing: .22em; font-size: .71rem; font-weight: 700; }
+.eyebrow::before { content: ''; display: inline-block; width: 30px; height: 1px; margin: 0 .8rem .25rem 0; background: currentColor; }
+.hero h1, .translator-intro h2, .section-heading h2, .story-copy h2 { margin: 0; font-family: var(--serif); font-weight: 400; line-height: .96; letter-spacing: -.03em; }
+.hero h1 { font-size: clamp(4rem, 7.2vw, 7.3rem); }
+.hero h1 em { color: #f3b191; font-weight: 400; }
+.hero-copy { max-width: 500px; margin: 2rem 0; color: rgba(255,255,255,.82); font-size: 1.04rem; }
+.hero-actions { display: flex; gap: 2rem; align-items: center; }
+.button { min-height: 50px; padding: .8rem 1.3rem; display: inline-flex; align-items: center; justify-content: space-between; gap: 2rem; border: 0; text-decoration: none; font-weight: 700; cursor: pointer; transition: transform .2s, background .2s, opacity .2s; }
+.button:hover:not(:disabled) { transform: translateY(-2px); }
+.button:disabled { cursor: not-allowed; opacity: .48; }
+.button-light { color: var(--ink); background: white; }
+.button-accent { width: 100%; color: white; background: var(--orange); }
+.text-link { display: inline-flex; gap: .65rem; text-underline-offset: .35rem; font-size: .86rem; font-weight: 600; }
+.hero-note { position: absolute; right: clamp(1.5rem, 5vw, 5rem); bottom: 3rem; margin: 0; padding-left: 1rem; border-left: 1px solid rgba(255,255,255,.6); font-size: .72rem; line-height: 1.7; text-transform: uppercase; letter-spacing: .14em; }
+
+.translator-section { padding: clamp(4rem, 8vw, 8rem) clamp(1.5rem, 8vw, 9rem); display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(340px, .9fr); gap: clamp(3rem, 10vw, 10rem); align-items: center; background: var(--cream); }
+.eyebrow-dark { color: #795e52; }
+.translator-intro h2, .section-heading h2 { font-size: clamp(2.8rem, 4.3vw, 4.8rem); }
+.translator-intro > p:last-child { max-width: 520px; margin: 1.8rem 0 0; color: #6b5c55; }
+.translator-card { padding: clamp(1.5rem, 4vw, 2.4rem); background: white; box-shadow: 0 22px 60px rgba(64,42,32,.11); }
+.language-row { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: end; }
+.language-field label { display: block; margin-bottom: .45rem; color: #7d6b63; text-transform: uppercase; font-size: .65rem; letter-spacing: .15em; font-weight: 700; }
+.language-field select { width: 100%; padding: .7rem .2rem; color: var(--ink); background: transparent; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; font-weight: 600; }
+.language-field select:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
+.language-arrow { padding-bottom: .7rem; color: var(--orange); }
+.translator-status { display: flex; gap: .7rem; align-items: center; min-height: 54px; margin: 1.25rem 0 .8rem; padding: .7rem .9rem; color: #665750; background: #f8f5ee; font-size: .78rem; }
+.status-dot { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: #c69b60; box-shadow: 0 0 0 4px rgba(198,155,96,.15); }
+.translator-status.is-ready .status-dot { background: #688569; box-shadow: 0 0 0 4px rgba(104,133,105,.15); }
+.translator-status.is-error .status-dot { background: #b64f3d; box-shadow: 0 0 0 4px rgba(182,79,61,.15); }
+.progress-wrap { margin: -.2rem 0 1rem; }
+.progress-label { display: flex; justify-content: space-between; margin-bottom: .35rem; color: #7d6b63; font-size: .68rem; }
+progress { width: 100%; height: 5px; appearance: none; border: 0; }
+progress::-webkit-progress-bar { background: #eee7dc; }
+progress::-webkit-progress-value { background: var(--orange); }
+progress::-moz-progress-bar { background: var(--orange); }
+.reset-button { width: 100%; margin: .8rem 0 0; padding: .4rem; color: #735a50; background: transparent; border: 0; text-decoration: underline; text-underline-offset: .25rem; cursor: pointer; }
+.privacy-note { margin: 1rem 0 0; color: #8b7c75; text-align: center; font-size: .67rem; }
+
+.menu-section { padding: clamp(5rem, 9vw, 9rem) clamp(1.5rem, 7vw, 8rem); }
+.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 3.5rem; }
+.text-link-dark { color: #69544b; }
+.menu-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
+.menu-card { min-height: 390px; padding: 1.5rem; display: flex; flex-direction: column; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
+.menu-card-featured { background: var(--sage); }
+.card-number { color: #826e65; font-family: var(--serif); font-style: italic; }
+.card-content { flex: 1; display: flex; flex-direction: column; justify-content: end; }
+.card-kicker { margin: 0 0 .75rem; color: #785f54; text-transform: uppercase; font-size: .66rem; font-weight: 700; letter-spacing: .17em; }
+.menu-card h3 { max-width: 300px; margin: 0; font-family: var(--serif); font-size: clamp(2rem, 3vw, 2.7rem); font-weight: 400; line-height: 1.05; }
+.menu-card .card-content > p:not(.card-kicker) { min-height: 76px; margin: 1.2rem 0; color: #675650; font-size: .87rem; }
+.card-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; border-top: 1px solid var(--line); font-weight: 700; font-size: .78rem; }
+.card-footer a { font-weight: 600; }
+
+.story-section { min-height: 650px; display: grid; grid-template-columns: 1fr 1fr; background: var(--coffee); color: white; }
+.story-photo { min-height: 520px; background: url('https://images.unsplash.com/photo-1498804103079-a6351b050096?auto=format&fit=crop&w=1200&q=85') center/cover; }
+.story-copy { padding: clamp(4rem, 9vw, 9rem); display: flex; flex-direction: column; justify-content: center; align-items: start; }
+.story-copy h2 { font-size: clamp(3.4rem, 5.4vw, 6rem); }
+.story-copy > p:not(.eyebrow) { max-width: 470px; margin: 2rem 0; color: rgba(255,255,255,.72); }
+
+footer { padding: 5rem clamp(1.5rem, 7vw, 8rem) 2rem; display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 4rem; color: #e9dfd4; background: #1d1512; }
+.logo-mark-light { margin-bottom: 1.5rem; }
+.footer-brand p { margin: 0; font-family: var(--serif); font-size: 2rem; line-height: 1.1; }
+.footer-column { display: flex; flex-direction: column; align-items: start; }
+.footer-column h2 { margin: 0 0 1.2rem; color: #a89287; text-transform: uppercase; font-size: .68rem; letter-spacing: .18em; }
+.footer-column p, .footer-column a { margin: 0 0 .65rem; color: rgba(255,255,255,.65); font-size: .8rem; }
+.footer-bottom { grid-column: 1 / -1; margin-top: 2rem; padding-top: 1.5rem; display: flex; justify-content: space-between; border-top: 1px solid rgba(255,255,255,.13); color: rgba(255,255,255,.42); font-size: .68rem; }
+
+@media (max-width: 850px) {
+  .site-nav { height: 70px; }
+  .nav-toggle { display: block; }
+  .nav-links { display: none; position: absolute; top: 70px; left: 0; width: 100%; padding: 1.5rem; flex-direction: column; align-items: stretch; background: var(--ink); }
+  .nav-links.is-open { display: flex; }
+  .nav-order { text-align: center; }
+  .hero { min-height: 650px; }
+  .hero-note { display: none; }
+  .translator-section { grid-template-columns: 1fr; gap: 2.5rem; }
+  .menu-grid { grid-template-columns: 1fr; }
+  .menu-card { min-height: 330px; }
+  .story-section { grid-template-columns: 1fr; }
+  .story-photo { min-height: 430px; }
+  footer { grid-template-columns: 1fr 1fr; }
+  .footer-brand { grid-column: 1 / -1; }
+}
+
+@media (max-width: 540px) {
+  .hero { height: auto; min-height: 680px; }
+  .hero h1 { font-size: 3.5rem; }
+  .hero-actions { align-items: stretch; flex-direction: column; gap: 1.2rem; }
+  .button-light { align-self: start; }
+  .language-row { grid-template-columns: 1fr; }
+  .language-arrow { display: none; }
+  .section-heading { align-items: start; flex-direction: column; }
+  .story-copy { padding: 4rem 1.5rem; }
+  footer { grid-template-columns: 1fr; }
+  .footer-brand, .footer-bottom { grid-column: 1; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after { transition-duration: .01ms !important; }
+}
