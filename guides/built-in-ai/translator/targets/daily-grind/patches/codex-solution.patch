+// @ts-check
+
+/** @typedef {'available' | 'downloadable' | 'downloading' | 'unavailable'} Availability */
+/** @typedef {{ sourceLanguage: string, targetLanguage: string }} LanguageOptions */
+/** @typedef {{ loaded: number }} DownloadProgressEvent */
+/** @typedef {{ addEventListener: (type: 'downloadprogress', listener: (event: DownloadProgressEvent) => void) => void }} CreateMonitor */
+/** @typedef {{ translate: (text: string) => Promise<string>, destroy?: () => void }} TranslatorInstance */
+/** @typedef {{ availability: (options: LanguageOptions) => Promise<Availability>, create: (options: LanguageOptions & { monitor: (monitor: CreateMonitor) => void }) => Promise<TranslatorInstance> }} TranslatorFactory */
+
+const languages = [
+  ['ar', 'Arabic'], ['bg', 'Bulgarian'], ['bn', 'Bengali'], ['cs', 'Czech'],
+  ['da', 'Danish'], ['de', 'German'], ['el', 'Greek'], ['en', 'English'],
+  ['es', 'Spanish'], ['fi', 'Finnish'], ['fr', 'French'], ['hi', 'Hindi'],
+  ['hr', 'Croatian'], ['hu', 'Hungarian'], ['id', 'Indonesian'], ['it', 'Italian'],
+  ['he', 'Hebrew'], ['ja', 'Japanese'], ['kn', 'Kannada'], ['ko', 'Korean'],
+  ['lt', 'Lithuanian'], ['mr', 'Marathi'], ['nl', 'Dutch'], ['no', 'Norwegian'],
+  ['pl', 'Polish'], ['pt', 'Portuguese'], ['ro', 'Romanian'], ['ru', 'Russian'],
+  ['sk', 'Slovak'], ['sl', 'Slovenian'], ['sv', 'Swedish'], ['ta', 'Tamil'],
+  ['te', 'Telugu'], ['th', 'Thai'], ['tr', 'Turkish'], ['uk', 'Ukrainian'],
+  ['vi', 'Vietnamese'], ['zh', 'Chinese (Simplified)'], ['zh-Hant', 'Chinese (Traditional)'],
+];
+
+/** @template {HTMLElement} T @param {string} id @returns {T} */
+function requireElement(id) {
+  const element = document.getElementById(id);
+  if (!element) throw new Error(`Missing required element: #${id}`);
+  return /** @type {T} */ (element);
+}
+
+const sourceLanguage = /** @type {HTMLSelectElement} */ (requireElement('source-language'));
+const targetLanguage = /** @type {HTMLSelectElement} */ (requireElement('target-language'));
+const swapButton = /** @type {HTMLButtonElement} */ (requireElement('swap-languages'));
+const sourceText = /** @type {HTMLTextAreaElement} */ (requireElement('source-text'));
+const characterCount = requireElement('character-count');
+const output = requireElement('translation-output');
+const translateButton = /** @type {HTMLButtonElement} */ (requireElement('translate-button'));
+const status = requireElement('api-status');
+const statusText = requireElement('status-text');
+const progressTrack = requireElement('download-progress');
+const progressBar = requireElement('download-progress-bar');
+
+/** @type {TranslatorInstance | null} */
+let translator = null;
+/** @type {LanguageOptions | null} */
+let checkedOptions = null;
+/** @type {Availability | null} */
+let availability = null;
+let availabilityRequest = 0;
+let busy = false;
+
+for (const [code, name] of languages) {
+  sourceLanguage.add(new Option(name, code));
+  targetLanguage.add(new Option(name, code));
+}
+sourceLanguage.value = 'en';
+targetLanguage.value = 'es';
+
+/** @param {string} message @param {'checking' | 'ready' | 'error'} state */
+function setStatus(message, state) {
+  statusText.textContent = message;
+  status.dataset.state = state;
+}
+
+/** @param {boolean} visible */
+function showProgress(visible) {
+  progressTrack.classList.toggle('visible', visible);
+}
+
+/** @param {boolean} value */
+function setBusy(value) {
+  busy = value;
+  sourceLanguage.disabled = value;
+  targetLanguage.disabled = value;
+  swapButton.disabled = value;
+}
+
+/** @param {number} value */
+function setProgress(value) {
+  const percent = Math.max(0, Math.min(100, Math.round(value * 100)));
+  progressBar.style.width = `${percent}%`;
+  progressTrack.setAttribute('aria-valuenow', String(percent));
+  setStatus(`Downloading language model… ${percent}%`, 'checking');
+}
+
+function resetTranslator() {
+  translator?.destroy?.();
+  translator = null;
+  availability = null;
+  checkedOptions = null;
+  showProgress(false);
+  setProgress(0);
+}
+
+/** @returns {LanguageOptions} */
+function getLanguageOptions() {
+  return {
+    sourceLanguage: sourceLanguage.value,
+    targetLanguage: targetLanguage.value,
+  };
+}
+
+/** @returns {TranslatorFactory | null} */
+function getTranslatorApi() {
+  // The standardized API lives directly on the Window object.
+  if (!('Translator' in window)) return null;
+  return /** @type {Window & { Translator: TranslatorFactory }} */ (window).Translator;
+}
+
+/** @param {Availability} result */
+function displayAvailability(result) {
+  switch (result) {
+    case 'available':
+      setStatus('Ready for private, on-device translation.', 'ready');
+      translateButton.textContent = 'Translate';
+      translateButton.disabled = busy;
+      break;
+    case 'downloadable':
+      setStatus('A language model will download when you translate.', 'ready');
+      translateButton.textContent = 'Download & translate';
+      translateButton.disabled = busy;
+      break;
+    case 'downloading':
+      setStatus('The language model is currently downloading.', 'checking');
+      translateButton.textContent = 'Continue & translate';
+      translateButton.disabled = busy;
+      break;
+    case 'unavailable':
+      setStatus('This language pair is not available on this device.', 'error');
+      translateButton.textContent = 'Unavailable';
+      translateButton.disabled = true;
+      break;
+  }
+}
+
+async function checkAvailability() {
+  const requestId = ++availabilityRequest;
+  resetTranslator();
+
+  if (sourceLanguage.value === targetLanguage.value) {
+    setStatus('Choose two different languages.', 'error');
+    translateButton.textContent = 'Translate';
+    translateButton.disabled = true;
+    return;
+  }
+
+  const translatorApi = getTranslatorApi();
+  if (!translatorApi) {
+    setStatus('On-device translation is unsupported in this browser. Try Chrome 138+ or Edge 148+ on desktop.', 'error');
+    translateButton.textContent = 'Unsupported';
+    translateButton.disabled = true;
+    return;
+  }
+
+  const options = getLanguageOptions();
+  checkedOptions = options;
+  setStatus('Checking this language pair…', 'checking');
+  translateButton.disabled = true;
+
+  try {
+    // Keep this exact options object for create(), ensuring an identical language pair.
+    const result = await translatorApi.availability(options);
+    if (requestId !== availabilityRequest) return;
+    availability = result;
+    displayAvailability(result);
+  } catch (error) {
+    if (requestId !== availabilityRequest) return;
+    console.error('Unable to check Translator availability:', error);
+    availability = 'unavailable';
+    setStatus('Could not start on-device translation. Please try again.', 'error');
+    translateButton.disabled = true;
+  }
+}
+
+/** @returns {Promise<TranslatorInstance>} */
+async function createTranslatorFromGesture() {
+  const translatorApi = getTranslatorApi();
+  if (!translatorApi || !checkedOptions) throw new Error('Translator is not available');
+
+  const options = checkedOptions;
+  showProgress(availability === 'downloadable' || availability === 'downloading');
+
+  return translatorApi.create({
+    ...options,
+    monitor(monitor) {
+      monitor.addEventListener('downloadprogress', (event) => {
+        showProgress(true);
+        setProgress(event.loaded);
+      });
+    },
+  });
+}
+
+async function translate() {
+  const text = sourceText.value.trim();
+  if (!text) {
+    sourceText.focus();
+    setStatus('Enter some text to translate.', 'error');
+    return;
+  }
+  if (busy || availability === 'unavailable' || !checkedOptions) return;
+
+  setBusy(true);
+  translateButton.disabled = true;
+  translateButton.textContent = translator ? 'Translating…' : 'Starting…';
+
+  try {
+    // This create call stays in the click-handler path, preserving the required user gesture.
+    translator ??= await createTranslatorFromGesture();
+    showProgress(false);
+    setStatus('Translating privately on this device…', 'checking');
+    translateButton.textContent = 'Translating…';
+    const result = await translator.translate(text);
+    output.textContent = result;
+    output.classList.remove('placeholder');
+    setStatus('Translation complete — nothing was sent to a server.', 'ready');
+  } catch (error) {
+    console.error('Translation failed:', error);
+    setStatus('Translation failed. Check browser support and try again.', 'error');
+  } finally {
+    setBusy(false);
+    translateButton.disabled = availability === 'unavailable';
+    translateButton.textContent = translator ? 'Translate again' : 'Try again';
+  }
+}
+
+function languagesChanged() {
+  output.textContent = 'Your translation will appear here.';
+  output.classList.add('placeholder');
+  void checkAvailability();
+}
+
+sourceText.addEventListener('input', () => {
+  characterCount.textContent = `${sourceText.value.length.toLocaleString()} / 5,000`;
+});
+
+sourceLanguage.addEventListener('change', languagesChanged);
+targetLanguage.addEventListener('change', languagesChanged);
+swapButton.addEventListener('click', () => {
+  const previousSource = sourceLanguage.value;
+  sourceLanguage.value = targetLanguage.value;
+  targetLanguage.value = previousSource;
+  languagesChanged();
+});
+translateButton.addEventListener('click', () => void translate());
+
+void checkAvailability();
