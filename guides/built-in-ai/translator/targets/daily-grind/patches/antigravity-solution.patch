+  <script>
+    (() => {
+      const SOURCE_LANGUAGE = 'en';
+
+      // Supported BCP 47 language codes from Chrome's Translator API
+      const SUPPORTED_LANGUAGES = [
+        { code: 'ar', label: 'Arabic' },
+        { code: 'bg', label: 'Bulgarian' },
+        { code: 'bn', label: 'Bengali' },
+        { code: 'zh', label: 'Chinese (Simplified)' },
+        { code: 'zh-Hant', label: 'Chinese (Traditional)' },
+        { code: 'hr', label: 'Croatian' },
+        { code: 'cs', label: 'Czech' },
+        { code: 'da', label: 'Danish' },
+        { code: 'nl', label: 'Dutch' },
+        { code: 'fi', label: 'Finnish' },
+        { code: 'fr', label: 'French' },
+        { code: 'de', label: 'German' },
+        { code: 'el', label: 'Greek' },
+        { code: 'he', label: 'Hebrew' },
+        { code: 'hi', label: 'Hindi' },
+        { code: 'hu', label: 'Hungarian' },
+        { code: 'id', label: 'Indonesian' },
+        { code: 'it', label: 'Italian' },
+        { code: 'ja', label: 'Japanese' },
+        { code: 'kn', label: 'Kannada' },
+        { code: 'ko', label: 'Korean' },
+        { code: 'lt', label: 'Lithuanian' },
+        { code: 'mr', label: 'Marathi' },
+        { code: 'no', label: 'Norwegian' },
+        { code: 'pl', label: 'Polish' },
+        { code: 'pt', label: 'Portuguese' },
+        { code: 'ro', label: 'Romanian' },
+        { code: 'ru', label: 'Russian' },
+        { code: 'sk', label: 'Slovak' },
+        { code: 'sl', label: 'Slovenian' },
+        { code: 'es', label: 'Spanish' },
+        { code: 'sv', label: 'Swedish' },
+        { code: 'ta', label: 'Tamil' },
+        { code: 'te', label: 'Telugu' },
+        { code: 'th', label: 'Thai' },
+        { code: 'tr', label: 'Turkish' },
+        { code: 'uk', label: 'Ukrainian' },
+        { code: 'vi', label: 'Vietnamese' },
+      ];
+
+      const languageSelect = document.getElementById('language-select');
+      const translateBtn = document.getElementById('translate-btn');
+      const resetLangBtn = document.getElementById('reset-lang-btn');
+      const statusEl = document.getElementById('translator-status');
+      const progressWrap = document.getElementById('translator-progress-wrap');
+      const progressEl = document.getElementById('translator-progress');
+      const progressText = document.getElementById('translator-progress-text');
+      const translatableContainer = document.getElementById('translatable-content');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translate]'));
+
+      // Preserve crisp original English text for every translatable node
+      const originalTexts = new Map(
+        translatableElements.map((el) => [el, el.textContent.trim()])
+      );
+
+      // Populate language dropdown
+      for (const { code, label } of SUPPORTED_LANGUAGES) {
+        const option = document.createElement('option');
+        option.value = code;
+        option.textContent = label;
+        languageSelect.appendChild(option);
+      }
+
+      const translatorCache = new Map();
+      const availabilityCache = new Map();
+      let activeRequestId = 0;
+
+      function getLanguageLabel(code) {
+        if (code === SOURCE_LANGUAGE) return 'English';
+        const match = SUPPORTED_LANGUAGES.find((lang) => lang.code === code);
+        return match ? match.label : code;
+      }
+
+      function setStatus(message) {
+        statusEl.textContent = message;
+      }
+
+      function showProgress(percent) {
+        const clamped = Math.min(100, Math.max(0, Math.round(percent)));
+        progressWrap.hidden = false;
+        progressEl.value = clamped;
+        progressText.textContent = `${clamped}%`;
+      }
+
+      function hideProgress() {
+        progressWrap.hidden = true;
+        progressEl.value = 0;
+        progressText.textContent = '0%';
+      }
+
+      function restoreOriginalContent(statusMessage = '') {
+        activeRequestId += 1;
+        hideProgress();
+        for (const [el, text] of originalTexts.entries()) {
+          el.textContent = text;
+        }
+        translatableContainer.setAttribute('lang', SOURCE_LANGUAGE);
+        resetLangBtn.hidden = true;
+        setStatus(statusMessage);
+      }
+
+      async function translateElements(translator, targetLanguage, requestId) {
+        setStatus(`Translating to ${getLanguageLabel(targetLanguage)}...`);
+
+        // Translate short items first in memory so we can switch container lang cleanly
+        const shortResults = [];
+        const longElements = [];
+
+        for (const el of translatableElements) {
+          if (requestId !== activeRequestId) return;
+          const sourceText = originalTexts.get(el) || '';
+          if (sourceText.length > 140 && typeof translator.translateStreaming === 'function') {
+            longElements.push({ el, sourceText });
+          } else {
+            const translated = await translator.translate(sourceText);
+            if (requestId !== activeRequestId) return;
+            shortResults.push({ el, translated });
+          }
+        }
+
+        if (requestId !== activeRequestId) return;
+
+        // Apply mandatory BCP 47 lang attribute to the translated content container
+        translatableContainer.setAttribute('lang', targetLanguage);
+
+        for (const { el, translated } of shortResults) {
+          el.textContent = translated;
+        }
+
+        for (const { el, sourceText } of longElements) {
+          if (requestId !== activeRequestId) return;
+          let accumulated = '';
+          const stream = translator.translateStreaming(sourceText);
+          for await (const chunk of stream) {
+            if (requestId !== activeRequestId) return;
+            accumulated += chunk;
+            el.textContent = accumulated;
+          }
+        }
+
+        if (requestId !== activeRequestId) return;
+        resetLangBtn.hidden = false;
+        setStatus(`Translated to ${getLanguageLabel(targetLanguage)} on device.`);
+      }
+
+      async function createAndTranslate(options, requestId, skipCreateIfCached = true) {
+        const cacheKey = `${options.sourceLanguage}->${options.targetLanguage}`;
+        let translator = skipCreateIfCached ? translatorCache.get(cacheKey) : undefined;
+
+        if (!translator) {
+          setStatus(`Preparing ${getLanguageLabel(options.targetLanguage)} model...`);
+          translator = await Translator.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                if (requestId !== activeRequestId) return;
+                const percent = Math.round((e.loaded || 0) * 100);
+                setStatus(`Downloading ${getLanguageLabel(options.targetLanguage)} language pack...`);
+                showProgress(percent);
+              });
+            },
+          });
+
+          if (requestId !== activeRequestId) return;
+          translatorCache.set(cacheKey, translator);
+          availabilityCache.set(options.targetLanguage, 'available');
+          hideProgress();
+        }
+
+        await translateElements(translator, options.targetLanguage, requestId);
+      }
+
+      async function handleLanguageSelection() {
+        const targetLanguage = languageSelect.value;
+
+        if (targetLanguage === SOURCE_LANGUAGE) {
+          translateBtn.textContent = 'Translate';
+          translateBtn.disabled = true;
+          restoreOriginalContent('On-device translation ready.');
+          return;
+        }
+
+        const requestId = ++activeRequestId;
+        hideProgress();
+        translateBtn.disabled = true;
+        setStatus(`Checking ${getLanguageLabel(targetLanguage)} availability...`);
+
+        const options = {
+          sourceLanguage: SOURCE_LANGUAGE,
+          targetLanguage,
+        };
+
+        try {
+          const availability = await Translator.availability(options);
+          if (requestId !== activeRequestId) return;
+          availabilityCache.set(targetLanguage, availability);
+
+          if (availability === 'available') {
+            translateBtn.textContent = 'Translate';
+            translateBtn.disabled = false;
+            await createAndTranslate(options, requestId);
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            // User gesture is strictly required before Translator.create() starts or attaches to download
+            translateBtn.textContent = 'Download & Translate';
+            translateBtn.disabled = false;
+            const actionNote =
+              availability === 'downloading'
+                ? 'Language pack is downloading.'
+                : 'Language pack requires a one-time download.';
+            setStatus(`${actionNote} Click "Download & Translate" to continue.`);
+          } else {
+            translateBtn.textContent = 'Translate';
+            translateBtn.disabled = true;
+            setStatus(`On-device translation to ${getLanguageLabel(targetLanguage)} is unavailable on this device.`);
+          }
+        } catch (err) {
+          if (requestId !== activeRequestId) return;
+          hideProgress();
+          if (err && err.name === 'NotAllowedError') {
+            translateBtn.textContent = 'Download & Translate';
+            translateBtn.disabled = false;
+            setStatus('Click "Download & Translate" to start downloading the language pack.');
+            return;
+          }
+          translateBtn.textContent = 'Translate';
+          translateBtn.disabled = true;
+          console.warn('Translator availability check failed:', err);
+          setStatus('Unable to check language availability right now.');
+        }
+      }
+
+      async function handleTranslateButtonClick() {
+        const targetLanguage = languageSelect.value;
+        if (targetLanguage === SOURCE_LANGUAGE) {
+          restoreOriginalContent('Showing original English.');
+          return;
+        }
+
+        const requestId = ++activeRequestId;
+        const options = {
+          sourceLanguage: SOURCE_LANGUAGE,
+          targetLanguage,
+        };
+
+        const cachedAvailability = availabilityCache.get(targetLanguage);
+        translateBtn.disabled = true;
+
+        try {
+          if (cachedAvailability === 'downloadable' || cachedAvailability === 'downloading') {
+            // Invoke Translator.create() directly inside the click handler to preserve the user gesture
+            await createAndTranslate(options, requestId);
+          } else {
+            const availability = await Translator.availability(options);
+            if (requestId !== activeRequestId) return;
+            availabilityCache.set(targetLanguage, availability);
+
+            if (availability === 'unavailable') {
+              translateBtn.textContent = 'Translate';
+              translateBtn.disabled = true;
+              setStatus(`On-device translation to ${getLanguageLabel(targetLanguage)} is unavailable on this device.`);
+              return;
+            }
+
+            await createAndTranslate(options, requestId);
+          }
+
+          if (requestId === activeRequestId) {
+            translateBtn.textContent = 'Translate';
+            translateBtn.disabled = false;
+          }
+        } catch (err) {
+          if (requestId !== activeRequestId) return;
+          hideProgress();
+          translateBtn.disabled = false;
+
+          if (err && err.name === 'NotAllowedError') {
+            translateBtn.textContent = 'Download & Translate';
+            setStatus('Click "Download & Translate" to start downloading the language pack.');
+            return;
+          }
+
+          console.warn('Translation failed:', err);
+          restoreOriginalContent('Translation could not be completed. Showing original English.');
+          translateBtn.textContent = 'Translate';
+        }
+      }
+
+      // Feature detection via global Translator interface only
+      if (!('Translator' in self)) {
+        languageSelect.disabled = true;
+        translateBtn.disabled = true;
+        setStatus('Client-side translation is currently unsupported in this browser.');
+        return;
+      }
+
+      setStatus('On-device translation ready. Choose a language to translate.');
+      languageSelect.addEventListener('change', handleLanguageSelection);
+      translateBtn.addEventListener('click', handleTranslateButtonClick);
+      resetLangBtn.addEventListener('click', () => {
+        languageSelect.value = SOURCE_LANGUAGE;
+        translateBtn.textContent = 'Translate';
+        translateBtn.disabled = true;
+        restoreOriginalContent('Showing original English.');
+      });
+    })();
+  </script>
+
 </body>
 
