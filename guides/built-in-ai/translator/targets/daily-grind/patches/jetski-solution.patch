+              ? Math.round((e.loaded / e.total) * 100)
+              : Math.round(e.loaded * 100);
+
+            console.log(`Downloaded ${Math.round(e.loaded * 100)}%`);
+
+            if (typeof onProgress === 'function') {
+              onProgress(percent, e);
+            }
+          });
+        }
+      });
