+  <script>
+    // Translator API Implementation adhering strictly to web standards and guide.md
+    
+    // Check if Translator API is available in global scope (window.Translator / self.Translator)
+    // NOTE: Strictly avoiding deprecated window.ai.translator namespace
+    function isTranslatorSupported() {
+      return 'Translator' in self;
+    }
+
+    // Get current options from language selects
+    function getSelectedOptions() {
+      const sourceSelect = document.getElementById('source-language');
+      const targetSelect = document.getElementById('target-language');
+      return {
+        sourceLanguage: sourceSelect ? sourceSelect.value : 'en',
+        targetLanguage: targetSelect ? targetSelect.value : 'es'
+      };
+    }
+
+    // Update status banner and progress indicators
+    function updateStatus(status, message) {
+      const statusEl = document.getElementById('status-message');
+      if (statusEl) {
+        statusEl.className = `status-banner ${status}`;
+        statusEl.textContent = message;
+      }
+    }
+
+    function showDownloadProgress(percent) {
+      const progressContainer = document.getElementById('download-progress-container');
+      const progressBar = document.getElementById('download-progress');
+      const percentLabel = document.getElementById('progress-percent');
+      if (progressContainer && progressContainer.style) {
+        progressContainer.style.display = 'flex';
+      }
+      if (progressBar) {
+        progressBar.value = percent;
+      }
+      if (percentLabel) {
+        percentLabel.textContent = `${percent}%`;
+      }
+      if (percent >= 100 && progressContainer && progressContainer.style) {
+        setTimeout(() => {
+          if (progressContainer && progressContainer.style) {
+            progressContainer.style.display = 'none';
+          }
+        }, 1500);
+      }
+    }
+
+    // Check availability for current language pair options
+    async function checkAvailability(options) {
+      if (!isTranslatorSupported()) {
+        updateStatus('unsupported', 'Client-side translation is currently unsupported in this browser.');
+        return 'unavailable';
+      }
+
+      try {
+        const availability = await self.Translator.availability(options);
+        if (availability === 'available') {
+          updateStatus('available', 'Translation model is ready on this device.');
+        } else if (availability === 'downloadable') {
+          updateStatus('downloadable', 'Language pack requires download. Click Translate to initiate download.');
+        } else if (availability === 'downloading') {
+          updateStatus('downloading', 'Language pack is currently downloading. Click Translate to attach.');
+        } else if (availability === 'unavailable') {
+          updateStatus('unavailable', 'Translation model is unavailable on this device for the selected language pair.');
+        }
+        return availability;
+      } catch (error) {
+        console.warn('Error checking Translator availability:', error);
+        updateStatus('unavailable', 'Translation model is unavailable on this device.');
+        return 'unavailable';
+      }
+    }
+
+    // Create a Translator instance with progress monitoring
+    async function createTranslatorInstance(options) {
+      if (!isTranslatorSupported()) {
+        throw new Error('Translator API is not supported in this browser.');
+      }
+
+      const progressContainer = document.getElementById('download-progress-container');
+      if (progressContainer && progressContainer.style) {
+        progressContainer.style.display = 'flex';
+      }
+
+      const translator = await self.Translator.create({
+        sourceLanguage: options.sourceLanguage,
+        targetLanguage: options.targetLanguage,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const percent = Math.round(e.loaded * 100);
+            console.log(`Downloaded ${percent}%`);
+            showDownloadProgress(percent);
+          });
+        },
+      });
+
+      return translator;
+    }
+
+    // Translate page content
+    async function handleTranslatePage() {
+      const options = getSelectedOptions();
+
+      if (!isTranslatorSupported()) {
+        updateStatus('unsupported', 'Client-side translation is currently unsupported in this browser.');
+        return;
+      }
+
+      try {
+        const availability = await self.Translator.availability(options);
+        if (availability === 'unavailable') {
+          console.warn('Translation model is unavailable on this device.');
+          updateStatus('unavailable', 'Translation model is unavailable on this device.');
+          return;
+        }
+
+        updateStatus('downloading', 'Preparing translator...');
+        const translator = await createTranslatorInstance(options);
+
+        // Translate translatable elements on the page
+        const translatableElements = document.querySelectorAll('[data-translate]');
+        for (const el of translatableElements) {
+          if (!el.dataset.originalText) {
+            el.dataset.originalText = el.innerText.trim();
+          }
+          const textToTranslate = el.dataset.originalText;
+          if (textToTranslate) {
+            const translated = await translator.translate(textToTranslate);
+            el.innerText = translated;
+          }
+        }
+
+        updateStatus('available', 'Page translation complete!');
+      } catch (error) {
+        console.error('Translation failed:', error);
+        updateStatus('unavailable', `Translation failed: ${error.message}`);
+      }
+    }
+
+    // Translate custom text (standard translate)
+    async function handleTranslateCustomText() {
+      const options = getSelectedOptions();
+      const inputEl = document.getElementById('custom-input-text');
+      const outputEl = document.getElementById('custom-output-text');
+      const text = inputEl ? inputEl.value.trim() : '';
+
+      if (!text) return;
+
+      if (!isTranslatorSupported()) {
+        updateStatus('unsupported', 'Client-side translation is currently unsupported in this browser.');
+        if (outputEl) outputEl.textContent = 'Client-side translation is currently unsupported in this browser.';
+        return;
+      }
+
+      try {
+        const availability = await self.Translator.availability(options);
+        if (availability === 'unavailable') {
+          console.warn('Translation model is unavailable on this device.');
+          updateStatus('unavailable', 'Translation model is unavailable on this device.');
+          if (outputEl) outputEl.textContent = 'Translation model is unavailable on this device for the selected language pair.';
+          return;
+        }
+
+        if (outputEl) outputEl.textContent = 'Translating...';
+        const translator = await createTranslatorInstance(options);
+        const result = await translator.translate(text);
+        if (outputEl) outputEl.textContent = result;
+        console.log(result);
+        updateStatus('available', 'Translation complete!');
+      } catch (error) {
+        console.error('Translation failed:', error);
+        if (outputEl) outputEl.textContent = `Translation failed: ${error.message}`;
+        updateStatus('unavailable', `Translation failed: ${error.message}`);
+      }
+    }
+
+    // Translate custom text (streaming translate)
+    async function handleTranslateStreaming() {
+      const options = getSelectedOptions();
+      const inputEl = document.getElementById('custom-input-text');
+      const outputEl = document.getElementById('custom-output-text');
+      const text = inputEl ? inputEl.value.trim() : '';
+
+      if (!text) return;
+
+      if (!isTranslatorSupported()) {
+        updateStatus('unsupported', 'Client-side translation is currently unsupported in this browser.');
+        if (outputEl) outputEl.textContent = 'Client-side translation is currently unsupported in this browser.';
+        return;
+      }
+
+      try {
+        const availability = await self.Translator.availability(options);
+        if (availability === 'unavailable') {
+          console.warn('Translation model is unavailable on this device.');
+          updateStatus('unavailable', 'Translation model is unavailable on this device.');
+          if (outputEl) outputEl.textContent = 'Translation model is unavailable on this device for the selected language pair.';
+          return;
+        }
+
+        if (outputEl) outputEl.textContent = '';
+        const translator = await createTranslatorInstance(options);
+        const stream = translator.translateStreaming(text);
+        for await (const chunk of stream) {
+          if (outputEl) outputEl.textContent = chunk;
+          console.log(chunk);
+        }
+        updateStatus('available', 'Streaming translation complete!');
+      } catch (error) {
+        console.error('Streaming translation failed:', error);
+        if (outputEl) outputEl.textContent = `Translation failed: ${error.message}`;
+        updateStatus('unavailable', `Translation failed: ${error.message}`);
+      }
+    }
+
+    // Initialize event listeners when DOM is loaded
+    document.addEventListener('DOMContentLoaded', () => {
+      const startBtn = document.getElementById('start-translation-btn');
+      const customBtn = document.getElementById('translate-custom-btn');
+      const streamingBtn = document.getElementById('translate-streaming-btn');
+      const sourceSelect = document.getElementById('source-language');
+      const targetSelect = document.getElementById('target-language');
+
+      if (startBtn) {
+        startBtn.addEventListener('click', handleTranslatePage);
+      }
+      if (customBtn) {
+        customBtn.addEventListener('click', handleTranslateCustomText);
+      }
+      if (streamingBtn) {
+        streamingBtn.addEventListener('click', handleTranslateStreaming);
+      }
+
+      const onLanguageChange = () => {
+        const options = getSelectedOptions();
+        checkAvailability(options);
+      };
+
+      if (sourceSelect) {
+        sourceSelect.addEventListener('change', onLanguageChange);
+      }
+      if (targetSelect) {
+        targetSelect.addEventListener('change', onLanguageChange);
+      }
+
+      // Initial availability check
+      if (isTranslatorSupported()) {
+        checkAvailability(getSelectedOptions());
+      } else {
+        updateStatus('unsupported', 'Client-side translation is currently unsupported in this browser.');
+        if (startBtn) startBtn.disabled = true;
+        if (customBtn) customBtn.disabled = true;
+        if (streamingBtn) streamingBtn.disabled = true;
+      }
+    });
+  </script>
