diff --git a/src/components/ArticleTranslator.tsx b/src/components/ArticleTranslator.tsx
new file mode 100644
index 0000000..529b086
--- /dev/null
+++ b/src/components/ArticleTranslator.tsx
@@ -0,0 +1,210 @@
+import React from 'react';
+import { ArrowPathIcon, LanguageIcon } from '@heroicons/react/24/outline';
+import { useOnDeviceTranslation } from '../hooks/useOnDeviceTranslation';
+import {
+  DEFAULT_SOURCE_LANGUAGE,
+  getLanguageName,
+  SUPPORTED_LANGUAGES,
+  UNSUPPORTED_BROWSER_MESSAGE,
+} from '../utils/translator';
+
+interface Props {
+  targetContainerIds: string[];
+  originalLang?: string;
+}
+
+export default function ArticleTranslator({
+  targetContainerIds,
+  originalLang = DEFAULT_SOURCE_LANGUAGE,
+}: Props) {
+  const {
+    supported,
+    sourceLanguage,
+    targetLanguage,
+    availability,
+    phase,
+    downloadProgress,
+    activeLanguage,
+    errorMessage,
+    handleTranslate,
+    handleReset,
+    handleSourceChange,
+    handleTargetChange,
+  } = useOnDeviceTranslation({
+    targetContainerIds,
+    originalLang,
+    shouldCheckAvailability: true,
+  });
+
+  const isBusy = phase === 'downloading' || phase === 'translating';
+  const isPairUnavailable =
+    supported === true && availability === 'unavailable';
+  const controlsDisabled = supported !== true || isBusy;
+  const translateButtonDisabled =
+    supported !== true ||
+    isBusy ||
+    isPairUnavailable ||
+    sourceLanguage === targetLanguage;
+
+  const translateButtonLabel = (() => {
+    if (phase === 'downloading') {
+      return downloadProgress !== null
+        ? `Downloading (${downloadProgress}%)...`
+        : 'Downloading model...';
+    }
+    if (phase === 'translating') {
+      return 'Translating...';
+    }
+    if (availability === 'downloadable') {
+      return 'Download & Translate';
+    }
+    if (availability === 'downloading') {
+      return 'Resume & Translate';
+    }
+    return 'Translate';
+  })();
+
+  return (
+    <section
+      lang="en"
+      aria-label="Article translation controls"
+      className="bg-gray-50 border border-gray-200 rounded-md p-3.5 mb-6"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-2 text-sm font-semibold text-gray-800">
+          <LanguageIcon className="w-5 h-5 text-amber-700 shrink-0" />
+          <span>Translate Article</span>
+          <span className="text-[11px] font-medium uppercase tracking-wider bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded">
+            On-device
+          </span>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-2">
+          <label className="sr-only" htmlFor="article-source-lang">
+            Source language
+          </label>
+          <select
+            id="article-source-lang"
+            aria-label="Source language"
+            value={sourceLanguage}
+            disabled={controlsDisabled}
+            onChange={(e) => handleSourceChange(e.target.value)}
+            className="text-xs sm:text-sm bg-white border border-gray-300 rounded px-2 py-1.5 text-gray-800 disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.name}
+              </option>
+            ))}
+          </select>
+
+          <span className="text-xs text-gray-400" aria-hidden="true">
+            →
+          </span>
+
+          <label className="sr-only" htmlFor="article-target-lang">
+            Target language
+          </label>
+          <select
+            id="article-target-lang"
+            aria-label="Target language"
+            value={targetLanguage}
+            disabled={controlsDisabled}
+            onChange={(e) => handleTargetChange(e.target.value)}
+            className="text-xs sm:text-sm bg-white border border-gray-300 rounded px-2 py-1.5 text-gray-800 disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option
+                key={lang.code}
+                value={lang.code}
+                disabled={lang.code === sourceLanguage}
+              >
+                {lang.name}
+              </option>
+            ))}
+          </select>
+
+          <button
+            type="button"
+            onClick={handleTranslate}
+            disabled={translateButtonDisabled}
+            className="inline-flex items-center gap-1.5 bg-gray-900 text-white text-xs sm:text-sm font-semibold px-3 py-1.5 rounded hover:bg-amber-700 transition-colors disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed"
+          >
+            {isBusy && (
+              <ArrowPathIcon className="w-4 h-4 animate-spin shrink-0" />
+            )}
+            <span>{translateButtonLabel}</span>
+          </button>
+
+          {activeLanguage && (
+            <button
+              type="button"
+              onClick={handleReset}
+              className="text-xs sm:text-sm font-medium text-gray-700 hover:text-gray-900 border border-gray-300 bg-white px-2.5 py-1.5 rounded transition-colors"
+            >
+              Show Original
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Status / Progress / Graceful Fallback Note */}
+      <div aria-live="polite" className="mt-2 text-xs text-gray-600">
+        {supported === false && (
+          <p className="text-gray-500">{UNSUPPORTED_BROWSER_MESSAGE}</p>
+        )}
+
+        {supported === true && phase === 'downloading' && (
+          <div className="space-y-1">
+            <p className="text-amber-800 font-medium">
+              Downloading {getLanguageName(sourceLanguage)} →{' '}
+              {getLanguageName(targetLanguage)} language model
+              {downloadProgress !== null ? `: ${downloadProgress}%` : '...'}
+            </p>
+            <div className="w-full h-1.5 bg-gray-200 rounded-full overflow-hidden">
+              <div
+                className="h-full bg-amber-600 transition-all duration-150"
+                style={{ width: `${downloadProgress ?? 0}%` }}
+              />
+            </div>
+          </div>
+        )}
+
+        {supported === true && phase === 'translating' && (
+          <p className="text-amber-800 font-medium">
+            Translating article into {getLanguageName(targetLanguage)} on
+            device...
+          </p>
+        )}
+
+        {supported === true &&
+          phase === 'idle' &&
+          availability === 'downloadable' && (
+            <p>
+              Model download required for {getLanguageName(sourceLanguage)} →{' '}
+              {getLanguageName(targetLanguage)}. Click &ldquo;Download &amp;
+              Translate&rdquo; to begin.
+            </p>
+          )}
+
+        {supported === true && isPairUnavailable && phase !== 'error' && (
+          <p className="text-amber-800">
+            Translation from {getLanguageName(sourceLanguage)} to{' '}
+            {getLanguageName(targetLanguage)} is unavailable on this device.
+          </p>
+        )}
+
+        {supported === true && phase === 'translated' && activeLanguage && (
+          <p className="text-emerald-800 font-medium">
+            Showing on-device translation in {getLanguageName(activeLanguage)}{' '}
+            (<code>lang=&quot;{activeLanguage}&quot;</code>).
+          </p>
+        )}
+
+        {errorMessage && (
+          <p className="text-red-700 font-medium">{errorMessage}</p>
+        )}
+      </div>
+    </section>
+  );
+}
diff --git a/src/components/TeaserTranslator.tsx b/src/components/TeaserTranslator.tsx
new file mode 100644
index 0000000..3cedb62
--- /dev/null
+++ b/src/components/TeaserTranslator.tsx
@@ -0,0 +1,245 @@
+import React, { useEffect, useRef, useState } from 'react';
+import { ArrowPathIcon, LanguageIcon } from '@heroicons/react/24/outline';
+import { useOnDeviceTranslation } from '../hooks/useOnDeviceTranslation';
+import {
+  DEFAULT_SOURCE_LANGUAGE,
+  getLanguageName,
+  SUPPORTED_LANGUAGES,
+  UNSUPPORTED_BROWSER_MESSAGE,
+} from '../utils/translator';
+
+interface Props {
+  targetContainerId: string;
+  originalLang?: string;
+}
+
+export default function TeaserTranslator({
+  targetContainerId,
+  originalLang = DEFAULT_SOURCE_LANGUAGE,
+}: Props) {
+  const [isOpen, setIsOpen] = useState(false);
+  const wrapperRef = useRef<HTMLDivElement | null>(null);
+
+  const {
+    supported,
+    sourceLanguage,
+    targetLanguage,
+    availability,
+    phase,
+    downloadProgress,
+    activeLanguage,
+    errorMessage,
+    handleTranslate,
+    handleReset,
+    handleSourceChange,
+    handleTargetChange,
+  } = useOnDeviceTranslation({
+    targetContainerIds: [targetContainerId],
+    originalLang,
+    shouldCheckAvailability: isOpen,
+    preferStreaming: false,
+  });
+
+  useEffect(() => {
+    if (!isOpen) return;
+
+    const handleOutsideClick = (event: MouseEvent) => {
+      if (
+        wrapperRef.current &&
+        !wrapperRef.current.contains(event.target as Node)
+      ) {
+        setIsOpen(false);
+      }
+    };
+
+    const handleKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') {
+        setIsOpen(false);
+      }
+    };
+
+    document.addEventListener('mousedown', handleOutsideClick);
+    window.addEventListener('keydown', handleKeyDown);
+    return () => {
+      document.removeEventListener('mousedown', handleOutsideClick);
+      window.removeEventListener('keydown', handleKeyDown);
+    };
+  }, [isOpen]);
+
+  const isBusy = phase === 'downloading' || phase === 'translating';
+  const isPairUnavailable =
+    supported === true && availability === 'unavailable';
+
+  return (
+    <div
+      ref={wrapperRef}
+      lang="en"
+      className="relative inline-flex flex-col items-end"
+    >
+      <div className="inline-flex items-center gap-1">
+        <button
+          type="button"
+          onClick={() => setIsOpen((prev) => !prev)}
+          disabled={supported === false}
+          aria-expanded={supported === true ? isOpen : undefined}
+          aria-label={
+            supported === false
+              ? UNSUPPORTED_BROWSER_MESSAGE
+              : 'Translate teaser'
+          }
+          title={
+            supported === false
+              ? UNSUPPORTED_BROWSER_MESSAGE
+              : 'Translate teaser on device'
+          }
+          className={`inline-flex items-center gap-1 px-1.5 py-1 rounded text-xs font-medium transition-colors ${
+            supported === false
+              ? 'text-gray-300 cursor-not-allowed'
+              : activeLanguage
+                ? 'text-amber-700 bg-amber-50 hover:bg-amber-100'
+                : 'text-gray-500 hover:text-amber-700 hover:bg-gray-100'
+          }`}
+        >
+          <LanguageIcon className="h-4 w-4 shrink-0" />
+          <span>
+            {activeLanguage ? activeLanguage.toUpperCase() : 'Translate'}
+          </span>
+        </button>
+
+        {activeLanguage && (
+          <button
+            type="button"
+            onClick={handleReset}
+            className="text-[11px] font-medium text-gray-500 hover:text-gray-800 underline px-1"
+          >
+            Original
+          </button>
+        )}
+      </div>
+
+      {supported === false && (
+        <p className="text-[11px] text-gray-400 text-right leading-tight mt-0.5 max-w-[200px]">
+          {UNSUPPORTED_BROWSER_MESSAGE}
+        </p>
+      )}
+
+      {supported === true && isOpen && (
+        <div
+          aria-live="polite"
+          className="absolute right-0 top-full mt-1.5 w-64 bg-white border border-gray-200 rounded-md p-3 text-left shadow-lg z-30"
+        >
+          <div className="flex items-center justify-between mb-2">
+            <span className="text-xs font-semibold text-gray-800">
+              Translate Teaser
+            </span>
+            <span className="text-[10px] font-medium uppercase tracking-wider bg-amber-100 text-amber-900 px-1.5 py-0.5 rounded">
+              On-device
+            </span>
+          </div>
+
+          <div className="flex items-center gap-1.5 mb-2">
+            <select
+              aria-label="Teaser source language"
+              value={sourceLanguage}
+              disabled={isBusy}
+              onChange={(e) => handleSourceChange(e.target.value)}
+              className="w-1/2 text-xs bg-white border border-gray-300 rounded px-1.5 py-1 text-gray-800 disabled:bg-gray-100"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.name}
+                </option>
+              ))}
+            </select>
+
+            <span className="text-xs text-gray-400" aria-hidden="true">
+              →
+            </span>
+
+            <select
+              aria-label="Teaser target language"
+              value={targetLanguage}
+              disabled={isBusy}
+              onChange={(e) => handleTargetChange(e.target.value)}
+              className="w-1/2 text-xs bg-white border border-gray-300 rounded px-1.5 py-1 text-gray-800 disabled:bg-gray-100"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option
+                  key={lang.code}
+                  value={lang.code}
+                  disabled={lang.code === sourceLanguage}
+                >
+                  {lang.name}
+                </option>
+              ))}
+            </select>
+          </div>
+
+          <div className="flex items-center gap-1.5">
+            <button
+              type="button"
+              onClick={handleTranslate}
+              disabled={
+                isBusy ||
+                isPairUnavailable ||
+                sourceLanguage === targetLanguage
+              }
+              className="flex-1 inline-flex items-center justify-center gap-1 bg-gray-900 text-white text-xs font-semibold px-2.5 py-1.5 rounded hover:bg-amber-700 transition-colors disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed"
+            >
+              {isBusy && (
+                <ArrowPathIcon className="w-3.5 h-3.5 animate-spin shrink-0" />
+              )}
+              <span>
+                {phase === 'downloading'
+                  ? downloadProgress !== null
+                    ? `Downloading (${downloadProgress}%)`
+                    : 'Downloading...'
+                  : phase === 'translating'
+                    ? 'Translating...'
+                    : availability === 'downloadable'
+                      ? 'Download & Translate'
+                      : 'Translate'}
+              </span>
+            </button>
+
+            {activeLanguage && (
+              <button
+                type="button"
+                onClick={handleReset}
+                className="text-xs font-medium text-gray-700 border border-gray-300 bg-white px-2 py-1.5 rounded hover:bg-gray-100"
+              >
+                Original
+              </button>
+            )}
+          </div>
+
+          {phase === 'downloading' && (
+            <div className="mt-2 w-full h-1 bg-gray-200 rounded-full overflow-hidden">
+              <div
+                className="h-full bg-amber-600 transition-all duration-150"
+                style={{ width: `${downloadProgress ?? 0}%` }}
+              />
+            </div>
+          )}
+
+          {isPairUnavailable && phase !== 'error' && (
+            <p className="mt-1.5 text-[11px] text-amber-800">
+              {getLanguageName(sourceLanguage)} →{' '}
+              {getLanguageName(targetLanguage)} is unavailable on this device.
+            </p>
+          )}
+
+          {phase === 'translated' && activeLanguage && (
+            <p className="mt-1.5 text-[11px] text-emerald-800">
+              Translated to {getLanguageName(activeLanguage)}.
+            </p>
+          )}
+
+          {errorMessage && (
+            <p className="mt-1.5 text-[11px] text-red-700">{errorMessage}</p>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
