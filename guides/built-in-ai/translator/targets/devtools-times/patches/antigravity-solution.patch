diff --git a/src/hooks/useOnDeviceTranslation.ts b/src/hooks/useOnDeviceTranslation.ts
new file mode 100644
index 0000000..a735083
--- /dev/null
+++ b/src/hooks/useOnDeviceTranslation.ts
@@ -0,0 +1,262 @@
+import { useEffect, useRef, useState } from 'react';
+import {
+  checkLanguagePairAvailability,
+  collectTranslatableTextNodes,
+  createMonitoredTranslator,
+  DEFAULT_SOURCE_LANGUAGE,
+  getLanguageName,
+  isTranslatorSupported,
+  pickAlternativeLanguage,
+  translateWithPreservedWhitespace,
+  type CapturedTextNode,
+} from '../utils/translator';
+
+export type TranslationPhase =
+  | 'idle'
+  | 'downloading'
+  | 'translating'
+  | 'translated'
+  | 'error';
+
+export interface UseOnDeviceTranslationOptions {
+  targetContainerIds: string[];
+  originalLang?: string;
+  shouldCheckAvailability?: boolean;
+  preferStreaming?: boolean;
+}
+
+export function useOnDeviceTranslation({
+  targetContainerIds,
+  originalLang = DEFAULT_SOURCE_LANGUAGE,
+  shouldCheckAvailability = true,
+  preferStreaming,
+}: UseOnDeviceTranslationOptions) {
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [sourceLanguage, setSourceLanguage] = useState(originalLang);
+  const [targetLanguage, setTargetLanguage] = useState(() =>
+    pickAlternativeLanguage(originalLang)
+  );
+  const [availability, setAvailability] =
+    useState<TranslatorAvailabilityStatus | null>(null);
+  const [phase, setPhase] = useState<TranslationPhase>('idle');
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [activeLanguage, setActiveLanguage] = useState<string | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+  const capturedContainersRef = useRef<Map<string, CapturedTextNode[]>>(
+    new Map()
+  );
+  const translatorRef = useRef<TranslatorInstance | null>(null);
+  const requestIdRef = useRef(0);
+
+  useEffect(() => {
+    setSupported(isTranslatorSupported());
+    return () => {
+      requestIdRef.current += 1;
+      translatorRef.current?.destroy?.();
+      translatorRef.current = null;
+    };
+  }, []);
+
+  useEffect(() => {
+    if (supported !== true || !shouldCheckAvailability) {
+      return;
+    }
+
+    let cancelled = false;
+    setAvailability(null);
+    setErrorMessage(null);
+
+    checkLanguagePairAvailability({
+      sourceLanguage,
+      targetLanguage,
+    }).then((status) => {
+      if (!cancelled) {
+        setAvailability(status);
+      }
+    });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [supported, shouldCheckAvailability, sourceLanguage, targetLanguage]);
+
+  const ensureCapturedNodes = (): Map<string, CapturedTextNode[]> => {
+    for (const containerId of targetContainerIds) {
+      if (capturedContainersRef.current.has(containerId)) {
+        continue;
+      }
+      const element = document.getElementById(containerId);
+      if (!element) {
+        continue;
+      }
+      const textNodes = collectTranslatableTextNodes(element);
+      capturedContainersRef.current.set(
+        containerId,
+        textNodes.map((node) => ({
+          node,
+          originalText: node.textContent ?? '',
+        }))
+      );
+    }
+    return capturedContainersRef.current;
+  };
+
+  const applyContainerLang = (lang: string) => {
+    for (const containerId of targetContainerIds) {
+      const element = document.getElementById(containerId);
+      if (element) {
+        element.setAttribute('lang', lang);
+      }
+    }
+  };
+
+  const handleReset = () => {
+    requestIdRef.current += 1;
+    for (const entries of capturedContainersRef.current.values()) {
+      for (const entry of entries) {
+        entry.node.textContent = entry.originalText;
+      }
+    }
+    applyContainerLang(originalLang);
+    setActiveLanguage(null);
+    setPhase('idle');
+    setDownloadProgress(null);
+    setErrorMessage(null);
+  };
+
+  const handleSourceChange = (nextSource: string) => {
+    setSourceLanguage(nextSource);
+    if (nextSource === targetLanguage) {
+      setTargetLanguage(pickAlternativeLanguage(nextSource));
+    }
+  };
+
+  const handleTargetChange = (nextTarget: string) => {
+    setTargetLanguage(nextTarget);
+    if (nextTarget === sourceLanguage) {
+      setSourceLanguage(pickAlternativeLanguage(nextTarget));
+    }
+  };
+
+  const handleTranslate = async () => {
+    if (!supported) {
+      return;
+    }
+
+    const requestId = ++requestIdRef.current;
+    const isCancelled = () => requestIdRef.current !== requestId;
+    const options: TranslatorLanguageOptions = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    setErrorMessage(null);
+    setDownloadProgress(null);
+
+    try {
+      const currentAvailability =
+        availability ?? (await checkLanguagePairAvailability(options));
+      if (isCancelled()) return;
+      setAvailability(currentAvailability);
+
+      if (currentAvailability === 'unavailable') {
+        setPhase('error');
+        setErrorMessage(
+          `Translation from ${getLanguageName(sourceLanguage)} to ${getLanguageName(targetLanguage)} is unavailable on this device.`
+        );
+        return;
+      }
+
+      if (
+        currentAvailability === 'downloadable' ||
+        currentAvailability === 'downloading'
+      ) {
+        setPhase('downloading');
+        setDownloadProgress(0);
+      } else {
+        setPhase('translating');
+      }
+
+      translatorRef.current?.destroy?.();
+      translatorRef.current = null;
+
+      const translator = await createMonitoredTranslator(options, (percent) => {
+        if (!isCancelled()) {
+          setPhase('downloading');
+          setDownloadProgress(percent);
+        }
+      });
+
+      if (isCancelled()) {
+        translator.destroy?.();
+        return;
+      }
+
+      translatorRef.current = translator;
+      setAvailability('available');
+      setPhase('translating');
+      setDownloadProgress(null);
+
+      const captured = ensureCapturedNodes();
+      applyContainerLang(targetLanguage);
+
+      for (const containerId of targetContainerIds) {
+        const entries = captured.get(containerId);
+        if (!entries) continue;
+
+        for (const entry of entries) {
+          if (isCancelled()) return;
+
+          const translated = await translateWithPreservedWhitespace(
+            translator,
+            entry.originalText,
+            {
+              isCancelled,
+              preferStreaming,
+              onChunk:
+                preferStreaming === false
+                  ? undefined
+                  : (partial) => {
+                      if (!isCancelled()) {
+                        entry.node.textContent = partial;
+                      }
+                    },
+            }
+          );
+
+          if (isCancelled()) return;
+          entry.node.textContent = translated;
+        }
+      }
+
+      if (!isCancelled()) {
+        setActiveLanguage(targetLanguage);
+        setPhase('translated');
+      }
+    } catch (error) {
+      if (isCancelled()) return;
+      const message =
+        error instanceof Error && error.message
+          ? error.message
+          : 'Unable to complete on-device translation.';
+      setPhase('error');
+      setErrorMessage(message);
+    }
+  };
+
+  return {
+    supported,
+    sourceLanguage,
+    targetLanguage,
+    availability,
+    phase,
+    downloadProgress,
+    activeLanguage,
+    errorMessage,
+    handleTranslate,
+    handleReset,
+    handleSourceChange,
+    handleTargetChange,
+  };
+}
