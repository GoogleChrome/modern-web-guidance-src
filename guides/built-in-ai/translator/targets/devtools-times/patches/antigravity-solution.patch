diff --git a/src/utils/translator.ts b/src/utils/translator.ts
new file mode 100644
index 0000000..8d14f1f
--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,245 @@
+export interface SupportedLanguage {
+  code: string;
+  name: string;
+}
+
+/**
+ * BCP 47 languages supported by the on-device Translator API.
+ */
+export const SUPPORTED_LANGUAGES: readonly SupportedLanguage[] = [
+  { code: 'ar', name: 'Arabic' },
+  { code: 'bg', name: 'Bulgarian' },
+  { code: 'bn', name: 'Bengali' },
+  { code: 'cs', name: 'Czech' },
+  { code: 'da', name: 'Danish' },
+  { code: 'de', name: 'German' },
+  { code: 'el', name: 'Greek' },
+  { code: 'en', name: 'English' },
+  { code: 'es', name: 'Spanish' },
+  { code: 'fi', name: 'Finnish' },
+  { code: 'fr', name: 'French' },
+  { code: 'he', name: 'Hebrew' },
+  { code: 'hi', name: 'Hindi' },
+  { code: 'hr', name: 'Croatian' },
+  { code: 'hu', name: 'Hungarian' },
+  { code: 'id', name: 'Indonesian' },
+  { code: 'it', name: 'Italian' },
+  { code: 'ja', name: 'Japanese' },
+  { code: 'kn', name: 'Kannada' },
+  { code: 'ko', name: 'Korean' },
+  { code: 'lt', name: 'Lithuanian' },
+  { code: 'mr', name: 'Marathi' },
+  { code: 'nl', name: 'Dutch' },
+  { code: 'no', name: 'Norwegian' },
+  { code: 'pl', name: 'Polish' },
+  { code: 'pt', name: 'Portuguese' },
+  { code: 'ro', name: 'Romanian' },
+  { code: 'ru', name: 'Russian' },
+  { code: 'sk', name: 'Slovak' },
+  { code: 'sl', name: 'Slovenian' },
+  { code: 'sv', name: 'Swedish' },
+  { code: 'ta', name: 'Tamil' },
+  { code: 'te', name: 'Telugu' },
+  { code: 'th', name: 'Thai' },
+  { code: 'tr', name: 'Turkish' },
+  { code: 'uk', name: 'Ukrainian' },
+  { code: 'vi', name: 'Vietnamese' },
+  { code: 'zh', name: 'Chinese' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)' },
+];
+
+export const DEFAULT_SOURCE_LANGUAGE = 'en';
+export const DEFAULT_TARGET_LANGUAGE = 'es';
+
+export const UNSUPPORTED_BROWSER_MESSAGE =
+  'Client-side translation is currently unsupported in this browser.';
+
+export function getLanguageName(code: string): string {
+  return SUPPORTED_LANGUAGES.find((lang) => lang.code === code)?.name ?? code;
+}
+
+/**
+ * Checks exclusively for the standard global Translator interface.
+ */
+export function isTranslatorSupported(): boolean {
+  return (
+    typeof self !== 'undefined' &&
+    'Translator' in self &&
+    typeof self.Translator !== 'undefined' &&
+    typeof self.Translator.availability === 'function' &&
+    typeof self.Translator.create === 'function'
+  );
+}
+
+/**
+ * Queries Translator.availability() for the given language pair.
+ */
+export async function checkLanguagePairAvailability(
+  options: TranslatorLanguageOptions
+): Promise<TranslatorAvailabilityStatus> {
+  if (!isTranslatorSupported()) {
+    return 'unavailable';
+  }
+  if (options.sourceLanguage === options.targetLanguage) {
+    return 'unavailable';
+  }
+
+  try {
+    return await self.Translator!.availability({
+      sourceLanguage: options.sourceLanguage,
+      targetLanguage: options.targetLanguage,
+    });
+  } catch {
+    return 'unavailable';
+  }
+}
+
+/**
+ * Instantiates a Translator with identical language options and a downloadprogress monitor.
+ * Must only be called from a user gesture when availability is 'downloadable' or 'downloading'.
+ */
+export async function createMonitoredTranslator(
+  options: TranslatorLanguageOptions,
+  onProgress?: (percent: number) => void
+): Promise<TranslatorInstance> {
+  if (!isTranslatorSupported()) {
+    throw new Error(UNSUPPORTED_BROWSER_MESSAGE);
+  }
+
+  const pairOptions: TranslatorLanguageOptions = {
+    sourceLanguage: options.sourceLanguage,
+    targetLanguage: options.targetLanguage,
+  };
+
+  return self.Translator!.create({
+    ...pairOptions,
+    monitor(m) {
+      m.addEventListener('downloadprogress', (event) => {
+        const ratio =
+          event.total && event.total > 1
+            ? event.loaded / event.total
+            : event.loaded;
+        const percent = Math.min(100, Math.max(0, Math.round(ratio * 100)));
+        onProgress?.(percent);
+      });
+    },
+  });
+}
+
+const SKIPPED_ANCESTOR_TAGS = new Set([
+  'SCRIPT',
+  'STYLE',
+  'CODE',
+  'PRE',
+  'NOSCRIPT',
+  'TEXTAREA',
+  'SVG',
+]);
+
+function hasSkippedAncestor(node: Text, root: HTMLElement): boolean {
+  let current: HTMLElement | null = node.parentElement;
+  while (current && current !== root) {
+    if (
+      SKIPPED_ANCESTOR_TAGS.has(current.tagName) ||
+      current.dataset.translateIgnore === 'true'
+    ) {
+      return true;
+    }
+    current = current.parentElement;
+  }
+  return false;
+}
+
+/**
+ * Collects translatable text nodes inside a root element while skipping scripts and code blocks.
+ */
+export function collectTranslatableTextNodes(root: HTMLElement): Text[] {
+  const nodes: Text[] = [];
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+
+  let current = walker.nextNode();
+  while (current) {
+    const textNode = current as Text;
+    if (
+      textNode.textContent &&
+      textNode.textContent.trim().length > 0 &&
+      !hasSkippedAncestor(textNode, root)
+    ) {
+      nodes.push(textNode);
+    }
+    current = walker.nextNode();
+  }
+
+  return nodes;
+}
+
+export interface CapturedTextNode {
+  node: Text;
+  originalText: string;
+}
+
+const STREAMING_THRESHOLD_CHARS = 100;
+
+/**
+ * Translates a single string while preserving surrounding whitespace, using streaming for longer text.
+ */
+export async function translateWithPreservedWhitespace(
+  translator: TranslatorInstance,
+  originalText: string,
+  options?: {
+    isCancelled?: () => boolean;
+    onChunk?: (partialText: string) => void;
+    preferStreaming?: boolean;
+  }
+): Promise<string> {
+  const leading = originalText.match(/^\s*/)?.[0] ?? '';
+  const trailing = originalText.match(/\s*$/)?.[0] ?? '';
+  const trimmed = originalText.trim();
+
+  if (!trimmed) {
+    return originalText;
+  }
+
+  const useStreaming =
+    (options?.preferStreaming ?? trimmed.length >= STREAMING_THRESHOLD_CHARS) &&
+    typeof translator.translateStreaming === 'function';
+
+  if (useStreaming) {
+    const stream = translator.translateStreaming(trimmed);
+    const reader = stream.getReader();
+    let accumulated = '';
+
+    try {
+      while (true) {
+        if (options?.isCancelled?.()) {
+          await reader.cancel().catch(() => {});
+          return originalText;
+        }
+        const { done, value } = await reader.read();
+        if (done) {
+          break;
+        }
+        if (value) {
+          accumulated += value;
+          options?.onChunk?.(`${leading}${accumulated}${trailing}`);
+        }
+      }
+    } finally {
+      reader.releaseLock();
+    }
+
+    return `${leading}${accumulated}${trailing}`;
+  }
+
+  const translated = await translator.translate(trimmed);
+  return `${leading}${translated}${trailing}`;
+}
+
+/**
+ * Picks a sensible alternative language when source and target collide.
+ */
+export function pickAlternativeLanguage(excludeCode: string): string {
+  return excludeCode === DEFAULT_TARGET_LANGUAGE
+    ? DEFAULT_SOURCE_LANGUAGE
+    : DEFAULT_TARGET_LANGUAGE;
+}
