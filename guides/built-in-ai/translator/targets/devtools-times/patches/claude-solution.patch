+      listener: EventListenerOrEventListenerObject,
+      options?: boolean | EventListenerOptions,
+    ): void;
+  }
+
+  /** Language pair options shared by `availability()` and `create()`. */
+  interface TranslatorLanguagePairOptions {
+    /** BCP 47 language code of the input text. */
+    sourceLanguage: string;
+    /** BCP 47 language code of the output text. */
+    targetLanguage: string;
+  }
+
+  interface TranslatorCreateOptions extends TranslatorLanguagePairOptions {
+    monitor?: (monitor: CreateMonitor) => void;
+    signal?: AbortSignal;
+  }
+
+  interface TranslatorRunOptions {
+    signal?: AbortSignal;
+  }
+
+  interface TranslatorInstance {
+    readonly sourceLanguage: string;
+    readonly targetLanguage: string;
+    readonly inputQuota: number;
+    translate(input: string, options?: TranslatorRunOptions): Promise<string>;
+    translateStreaming(
+      input: string,
+      options?: TranslatorRunOptions,
