diff --git a/src/components/TranslateControl.tsx b/src/components/TranslateControl.tsx
new file mode 100644
index 0000000..80e9bf0
--- /dev/null
+++ b/src/components/TranslateControl.tsx
@@ -0,0 +1,455 @@
+import { useCallback, useEffect, useId, useMemo, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+/**
+ * On-device article translation using the built-in Translator API.
+ *
+ * The control translates the text content of the DOM elements referenced by
+ * `targetIds` in place, and applies the matching BCP 47 `lang` attribute to
+ * each translated container. The original text is kept so readers can switch
+ * languages or restore the original at any time.
+ */
+
+export const SUPPORTED_LANGUAGES: ReadonlyArray<{ code: string; name: string }> = [
+  { code: 'ar', name: 'Arabic' },
+  { code: 'bg', name: 'Bulgarian' },
+  { code: 'bn', name: 'Bengali' },
+  { code: 'cs', name: 'Czech' },
+  { code: 'da', name: 'Danish' },
+  { code: 'de', name: 'German' },
+  { code: 'el', name: 'Greek' },
+  { code: 'en', name: 'English' },
+  { code: 'es', name: 'Spanish' },
+  { code: 'fi', name: 'Finnish' },
+  { code: 'fr', name: 'French' },
+  { code: 'hi', name: 'Hindi' },
+  { code: 'hr', name: 'Croatian' },
+  { code: 'hu', name: 'Hungarian' },
+  { code: 'id', name: 'Indonesian' },
+  { code: 'it', name: 'Italian' },
+  { code: 'he', name: 'Hebrew' },
+  { code: 'ja', name: 'Japanese' },
+  { code: 'kn', name: 'Kannada' },
+  { code: 'ko', name: 'Korean' },
+  { code: 'lt', name: 'Lithuanian' },
+  { code: 'mr', name: 'Marathi' },
+  { code: 'nl', name: 'Dutch' },
+  { code: 'no', name: 'Norwegian' },
+  { code: 'pl', name: 'Polish' },
+  { code: 'pt', name: 'Portuguese' },
+  { code: 'ro', name: 'Romanian' },
+  { code: 'ru', name: 'Russian' },
+  { code: 'sk', name: 'Slovak' },
+  { code: 'sl', name: 'Slovenian' },
+  { code: 'sv', name: 'Swedish' },
+  { code: 'ta', name: 'Tamil' },
+  { code: 'te', name: 'Telugu' },
+  { code: 'th', name: 'Thai' },
+  { code: 'tr', name: 'Turkish' },
+  { code: 'uk', name: 'Ukrainian' },
+  { code: 'vi', name: 'Vietnamese' },
+  { code: 'zh', name: 'Chinese' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)' },
+];
+
+const RTL_LANGUAGES = new Set(['ar', 'he']);
+
+const UNSUPPORTED_MESSAGE = 'Client-side translation is currently unsupported in this browser.';
+const UNAVAILABLE_MESSAGE = 'This language pair is not available for on-device translation on this device.';
+
+const SKIP_TAGS = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEMPLATE', 'CODE', 'PRE', 'SVG']);
+
+interface Props {
+  /** IDs of the elements whose text content should be translated. */
+  targetIds: string[];
+  /** Language of the original content (BCP 47). */
+  sourceLanguage?: string;
+  /** Initially selected target language (BCP 47). */
+  defaultTargetLanguage?: string;
+  /** `full` renders inline controls, `compact` renders an icon button with a popover (for teasers). */
+  variant?: 'full' | 'compact';
+}
+
+type Status = 'idle' | 'downloading' | 'translating' | 'translated' | 'error';
+
+interface OriginalTextNode {
+  node: Text;
+  text: string;
+}
+
+interface OriginalContainer {
+  element: HTMLElement;
+  lang: string | null;
+  dir: string | null;
+  textNodes: OriginalTextNode[];
+}
+
+/** Feature detection: only the global `Translator` interface is used. */
+function getTranslatorApi(): TranslatorConstructor | undefined {
+  if (typeof self === 'undefined' || !('Translator' in self)) return undefined;
+  return self.Translator;
+}
+
+function collectTextNodes(root: HTMLElement): OriginalTextNode[] {
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
+      for (let el = node.parentElement; el && el !== root.parentElement; el = el.parentElement) {
+        if (SKIP_TAGS.has(el.tagName.toUpperCase()) || el.hasAttribute('data-translate-skip')) {
+          return NodeFilter.FILTER_REJECT;
+        }
+      }
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+  const nodes: OriginalTextNode[] = [];
+  for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+    const textNode = n as Text;
+    nodes.push({ node: textNode, text: textNode.nodeValue ?? '' });
+  }
+  return nodes;
+}
+
+function languageName(code: string): string {
+  return SUPPORTED_LANGUAGES.find((l) => l.code === code)?.name ?? code;
+}
+
+export default function TranslateControl({
+  targetIds,
+  sourceLanguage: initialSource = 'en',
+  defaultTargetLanguage = 'es',
+  variant = 'full',
+}: Props) {
+  const uid = useId();
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [open, setOpen] = useState(variant === 'full');
+  const [sourceLanguage, setSourceLanguage] = useState(initialSource);
+  const [targetLanguage, setTargetLanguage] = useState(
+    defaultTargetLanguage === initialSource ? (initialSource === 'en' ? 'es' : 'en') : defaultTargetLanguage,
+  );
+  const [availability, setAvailability] = useState<TranslatorAvailability | 'checking' | null>(null);
+  const [status, setStatus] = useState<Status>('idle');
+  const [progress, setProgress] = useState<number | null>(null);
+  const [message, setMessage] = useState<string | null>(null);
+  const [translatedTo, setTranslatedTo] = useState<string | null>(null);
+
+  const translatorRef = useRef<TranslatorInstance | null>(null);
+  const originalsRef = useRef<OriginalContainer[] | null>(null);
+  const runIdRef = useRef(0);
+  const abortRef = useRef<AbortController | null>(null);
+
+  // Identical options object for availability() and create().
+  const options = useMemo<TranslatorCreateCoreOptions>(
+    () => ({ sourceLanguage, targetLanguage }),
+    [sourceLanguage, targetLanguage],
+  );
+
+  // Feature detection runs on the client only.
+  useEffect(() => {
+    setSupported(getTranslatorApi() !== undefined);
+  }, []);
+
+  // Clean up translator and pending work on unmount.
+  useEffect(() => {
+    return () => {
+      abortRef.current?.abort();
+      translatorRef.current?.destroy();
+      translatorRef.current = null;
+    };
+  }, []);
+
+  // Check availability for the selected language pair.
+  useEffect(() => {
+    const api = getTranslatorApi();
+    if (!supported || !api || !open) return;
+    if (sourceLanguage === targetLanguage) {
+      setAvailability(null);
+      return;
+    }
+    let cancelled = false;
+    setAvailability('checking');
+    api
+      .availability(options)
+      .then((result) => {
+        if (!cancelled) setAvailability(result);
+      })
+      .catch((err: unknown) => {
+        console.warn('Translator availability check failed:', err);
+        if (!cancelled) setAvailability('unavailable');
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [supported, open, options, sourceLanguage, targetLanguage]);
+
+  const captureOriginals = useCallback((): OriginalContainer[] => {
+    if (originalsRef.current) {
+      // Drop containers that were removed from the DOM (e.g. after navigation).
+      originalsRef.current = originalsRef.current.filter((c) => c.element.isConnected);
+      if (originalsRef.current.length > 0) return originalsRef.current;
+    }
+    const containers: OriginalContainer[] = [];
+    for (const id of targetIds) {
+      const element = document.getElementById(id);
+      if (!element) continue;
+      containers.push({
+        element,
+        lang: element.getAttribute('lang'),
+        dir: element.getAttribute('dir'),
+        textNodes: collectTextNodes(element),
+      });
+    }
+    originalsRef.current = containers;
+    return containers;
+  }, [targetIds]);
+
+  const restoreOriginal = useCallback(() => {
+    runIdRef.current += 1;
+    abortRef.current?.abort();
+    abortRef.current = null;
+    const originals = originalsRef.current;
+    if (originals) {
+      for (const container of originals) {
+        for (const { node, text } of container.textNodes) node.nodeValue = text;
+        if (container.lang === null) container.element.removeAttribute('lang');
+        else container.element.setAttribute('lang', container.lang);
+        if (container.dir === null) container.element.removeAttribute('dir');
+        else container.element.setAttribute('dir', container.dir);
+        container.element.removeAttribute('aria-busy');
+      }
+    }
+    setTranslatedTo(null);
+    setStatus('idle');
+    setProgress(null);
+    setMessage(null);
+  }, []);
+
+  const getTranslator = useCallback(
+    async (api: TranslatorConstructor, signal: AbortSignal): Promise<TranslatorInstance> => {
+      const existing = translatorRef.current;
+      if (
+        existing &&
+        existing.sourceLanguage === options.sourceLanguage &&
+        existing.targetLanguage === options.targetLanguage
+      ) {
+        return existing;
+      }
+      existing?.destroy();
+      translatorRef.current = null;
+
+      const translator = await api.create({
+        ...options,
+        signal,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            setStatus('downloading');
+            setProgress(Math.round(e.loaded * 100));
+          });
+        },
+      });
+      translatorRef.current = translator;
+      return translator;
+    },
+    [options],
+  );
+
+  // Must be invoked from a user gesture (click) so create() may download the language pack.
+  const handleTranslate = useCallback(async () => {
+    const api = getTranslatorApi();
+    if (!api) {
+      setSupported(false);
+      return;
+    }
+    if (sourceLanguage === targetLanguage) {
+      restoreOriginal();
+      return;
+    }
+    if (availability === 'unavailable') {
+      setMessage(UNAVAILABLE_MESSAGE);
+      return;
+    }
+
+    abortRef.current?.abort();
+    const controller = new AbortController();
+    abortRef.current = controller;
+    const runId = ++runIdRef.current;
+    const isCurrent = () => runId === runIdRef.current && !controller.signal.aborted;
+
+    setMessage(null);
+    setProgress(null);
+    setStatus(availability === 'available' ? 'translating' : 'downloading');
+
+    const containers = captureOriginals();
+    if (containers.length === 0) {
+      setStatus('error');
+      setMessage('There is no content to translate.');
+      return;
+    }
+
+    try {
+      const translator = await getTranslator(api, controller.signal);
+      if (!isCurrent()) return;
+      setStatus('translating');
+      setProgress(null);
+      setAvailability('available');
+
+      for (const container of containers) {
+        container.element.setAttribute('aria-busy', 'true');
+      }
+
+      for (const container of containers) {
+        for (const entry of container.textNodes) {
+          const match = /^(\s*)([\s\S]*?)(\s*)$/.exec(entry.text);
+          const leading = match?.[1] ?? '';
+          const core = match?.[2] ?? entry.text;
+          const trailing = match?.[3] ?? '';
+          if (!core) continue;
+          const translated = await translator.translate(core, { signal: controller.signal });
+          if (!isCurrent()) return;
+          entry.node.nodeValue = `${leading}${translated}${trailing}`;
+        }
+        // Accessibility: mark the translated container with the target language.
+        container.element.setAttribute('lang', targetLanguage);
+        if (RTL_LANGUAGES.has(targetLanguage)) container.element.setAttribute('dir', 'rtl');
+        else if (container.dir === null) container.element.removeAttribute('dir');
+        else container.element.setAttribute('dir', container.dir);
+        container.element.removeAttribute('aria-busy');
+      }
+
+      setTranslatedTo(targetLanguage);
+      setStatus('translated');
+    } catch (err: unknown) {
+      if (!isCurrent()) return;
+      console.error('Translation failed:', err);
+      for (const container of containers) container.element.removeAttribute('aria-busy');
+      setStatus('error');
+      setProgress(null);
+      if (err instanceof DOMException && err.name === 'NotAllowedError') {
+        setMessage('Translation needs your permission. Please click "Translate" again.');
+      } else if (err instanceof DOMException && err.name === 'NotSupportedError') {
+        setAvailability('unavailable');
+        setMessage(UNAVAILABLE_MESSAGE);
+      } else {
+        setMessage('Translation failed. Please try again.');
+      }
+    }
+  }, [availability, captureOriginals, getTranslator, restoreOriginal, sourceLanguage, targetLanguage]);
+
+  const busy = status === 'downloading' || status === 'translating';
+  const isUnsupported = supported === false;
+  const controlsDisabled = supported !== true || busy;
+  const translateDisabled =
+    controlsDisabled ||
+    sourceLanguage === targetLanguage ||
+    availability === 'unavailable' ||
+    availability === 'checking';
+
+  let statusText: string | null = null;
+  if (isUnsupported) statusText = UNSUPPORTED_MESSAGE;
+  else if (message) statusText = message;
+  else if (status === 'downloading')
+    statusText = progress === null ? 'Downloading language pack…' : `Downloading language pack… ${progress}%`;
+  else if (status === 'translating') statusText = 'Translating on your device…';
+  else if (status === 'translated' && translatedTo) statusText = `Translated to ${languageName(translatedTo)}.`;
+  else if (availability === 'unavailable') statusText = UNAVAILABLE_MESSAGE;
+  else if (availability === 'downloadable' || availability === 'downloading')
+    statusText = 'The language pack will be downloaded to your device on first use.';
+
+  const selectClass =
+    'border border-gray-300 rounded px-2 py-1 text-sm bg-white text-gray-800 disabled:opacity-50 disabled:cursor-not-allowed';
+  const buttonClass =
+    'px-3 py-1 rounded text-sm font-semibold bg-amber-400 text-gray-900 hover:bg-amber-500 disabled:opacity-50 disabled:cursor-not-allowed';
+
+  const panel = (
+    <div className="flex flex-col gap-2" data-translate-skip>
+      <div className="flex flex-wrap items-center gap-2">
+        <label className="sr-only" htmlFor={`${uid}-source`}>
+          Translate from
+        </label>
+        <select
+          id={`${uid}-source`}
+          className={selectClass}
+          value={sourceLanguage}
+          disabled={controlsDisabled}
+          onChange={(e) => setSourceLanguage(e.target.value)}
+        >
+          {SUPPORTED_LANGUAGES.map((l) => (
+            <option key={l.code} value={l.code}>
+              {l.name}
+            </option>
+          ))}
+        </select>
+        <span className="text-sm text-gray-500" aria-hidden="true">
+          →
+        </span>
+        <label className="sr-only" htmlFor={`${uid}-target`}>
+          Translate to
+        </label>
+        <select
+          id={`${uid}-target`}
+          className={selectClass}
+          value={targetLanguage}
+          disabled={controlsDisabled}
+          onChange={(e) => setTargetLanguage(e.target.value)}
+        >
+          {SUPPORTED_LANGUAGES.map((l) => (
+            <option key={l.code} value={l.code}>
+              {l.name}
+            </option>
+          ))}
+        </select>
+        <button type="button" className={buttonClass} disabled={translateDisabled} onClick={handleTranslate}>
+          {busy ? 'Translating…' : 'Translate'}
+        </button>
+        {translatedTo && !busy && (
+          <button
+            type="button"
+            className="px-2 py-1 text-sm text-gray-600 underline hover:text-amber-600"
+            onClick={restoreOriginal}
+          >
+            Show original
+          </button>
+        )}
+      </div>
+      {status === 'downloading' && progress !== null && (
+        <progress className="w-full h-1" max={100} value={progress} aria-label="Language pack download progress" />
+      )}
+      <p className="text-xs text-gray-500 min-h-4" role="status" aria-live="polite">
+        {statusText}
+      </p>
+    </div>
+  );
+
+  if (variant === 'full') {
+    return (
+      <div className="flex items-start gap-2" data-translate-skip>
+        <LanguageIcon className="h-5 w-5 mt-1 text-gray-500 shrink-0" aria-hidden="true" />
+        {panel}
+      </div>
+    );
+  }
+
+  return (
+    <div className="relative" data-translate-skip>
+      <button
+        type="button"
+        className="p-1"
+        aria-expanded={open}
+        aria-controls={`${uid}-panel`}
+        aria-label={translatedTo ? `Translated to ${languageName(translatedTo)}. Change translation` : 'Translate'}
+        title={isUnsupported ? UNSUPPORTED_MESSAGE : 'Translate'}
+        onClick={() => setOpen((o) => !o)}
+      >
+        <LanguageIcon className={`h-5 w-5 ${translatedTo ? 'text-amber-400' : 'text-gray-400'}`} />
+      </button>
+      {open && (
+        <div
+          id={`${uid}-panel`}
+          className="absolute right-0 bottom-full mb-2 z-20 w-72 bg-white border border-gray-200 rounded-md shadow-lg p-3"
+        >
+          {panel}
+        </div>
+      )}
+    </div>
+  );
+}
