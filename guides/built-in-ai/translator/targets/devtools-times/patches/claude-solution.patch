@@ -0,0 +1,103 @@
+/**
+ * Helpers around the built-in on-device Translator API.
+ * Everything goes through the global `Translator` interface — the deprecated
+ * `window.ai.translator` namespace is never touched.
+ */
+
+export interface TranslatorLanguage {
+  code: string;
+  label: string;
+}
+
+/** BCP 47 codes supported by Chrome's implementation of the Translator API. */
+export const SUPPORTED_LANGUAGES: TranslatorLanguage[] = [
+  { code: 'ar', label: 'Arabic' },
+  { code: 'bg', label: 'Bulgarian' },
+  { code: 'bn', label: 'Bengali' },
+  { code: 'cs', label: 'Czech' },
+  { code: 'da', label: 'Danish' },
+  { code: 'de', label: 'German' },
+  { code: 'el', label: 'Greek' },
+  { code: 'en', label: 'English' },
+  { code: 'es', label: 'Spanish' },
+  { code: 'fi', label: 'Finnish' },
+  { code: 'fr', label: 'French' },
+  { code: 'hi', label: 'Hindi' },
+  { code: 'hr', label: 'Croatian' },
+  { code: 'hu', label: 'Hungarian' },
+  { code: 'id', label: 'Indonesian' },
+  { code: 'it', label: 'Italian' },
+  { code: 'he', label: 'Hebrew' },
+  { code: 'ja', label: 'Japanese' },
+  { code: 'kn', label: 'Kannada' },
+  { code: 'ko', label: 'Korean' },
+  { code: 'lt', label: 'Lithuanian' },
+  { code: 'mr', label: 'Marathi' },
+  { code: 'nl', label: 'Dutch' },
+  { code: 'no', label: 'Norwegian' },
+  { code: 'pl', label: 'Polish' },
+  { code: 'pt', label: 'Portuguese' },
+  { code: 'ro', label: 'Romanian' },
+  { code: 'ru', label: 'Russian' },
+  { code: 'sk', label: 'Slovak' },
+  { code: 'sl', label: 'Slovenian' },
+  { code: 'sv', label: 'Swedish' },
+  { code: 'ta', label: 'Tamil' },
+  { code: 'te', label: 'Telugu' },
+  { code: 'th', label: 'Thai' },
+  { code: 'tr', label: 'Turkish' },
+  { code: 'uk', label: 'Ukrainian' },
+  { code: 'vi', label: 'Vietnamese' },
+  { code: 'zh', label: 'Chinese (Simplified)' },
+  { code: 'zh-Hant', label: 'Chinese (Traditional)' },
+];
+
+export function getLanguageLabel(code: string): string {
+  return SUPPORTED_LANGUAGES.find((lang) => lang.code === code)?.label ?? code;
+}
+
+/**
+ * Returns the global `Translator` factory, or `null` when the browser does not
+ * ship the built-in Translator API (Firefox, Safari, mobile, older Chrome).
+ */
+export function getTranslatorFactory(): TranslatorFactory | null {
+  if (typeof self === 'undefined' || !('Translator' in self)) {
+    return null;
+  }
+  return Translator;
+}
+
+/** Text above this length is streamed instead of awaited in one go. */
+export const STREAMING_THRESHOLD = 200;
+
+/**
+ * Translates `text` with an existing translator instance. Long inputs use
+ * `translateStreaming()` so partial output can be rendered as it arrives.
+ */
+export async function translateText(
+  translator: TranslatorInstance,
+  text: string,
+  onPartial?: (partial: string) => void,
+  signal?: AbortSignal,
+): Promise<string> {
+  if (text.length <= STREAMING_THRESHOLD) {
+    const result = await translator.translate(text, { signal });
+    onPartial?.(result);
+    return result;
+  }
+
+  const stream = translator.translateStreaming(text, { signal });
+  const reader = stream.getReader();
+  let translated = '';
+  try {
+    while (true) {
+      const { value, done } = await reader.read();
+      if (done) break;
+      translated += value;
+      onPartial?.(translated);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  return translated;
+}
