+++ b/src/components/ArticleTranslator.tsx
@@ -0,0 +1,356 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import {
+  SUPPORTED_LANGUAGES,
+  getLanguageLabel,
+  getTranslatorFactory,
+  translateText,
+} from '../utils/translator';
+
+interface Props {
+  /** CSS selector of the element whose text content should be translated. */
+  targetSelector: string;
+  /** BCP 47 code of the language the article is written in. */
+  sourceLanguage?: string;
+  /** BCP 47 code preselected in the language picker. */
+  defaultTargetLanguage?: string;
+}
+
+type Phase =
+  | 'checking'
+  | 'idle'
+  | 'downloading'
+  | 'translating'
+  | 'translated'
+  | 'error';
+
+interface TranslatableNode {
+  node: Text;
+  original: string;
+}
+
+const FALLBACK_NOTE =
+  'Client-side translation is currently unsupported in this browser.';
+
+function collectTextNodes(root: HTMLElement): TranslatableNode[] {
+  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent || parent.closest('[data-no-translate]')) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      if (parent.tagName === 'SCRIPT' || parent.tagName === 'STYLE') {
+        return NodeFilter.FILTER_REJECT;
+      }
+      return (node.textContent ?? '').trim().length > 1
+        ? NodeFilter.FILTER_ACCEPT
+        : NodeFilter.FILTER_REJECT;
+    },
+  });
+
+  const nodes: TranslatableNode[] = [];
+  let current = walker.nextNode();
+  while (current) {
+    const text = current as Text;
+    nodes.push({ node: text, original: text.data });
+    current = walker.nextNode();
+  }
+  return nodes;
+}
+
+export default function ArticleTranslator({
+  targetSelector,
+  sourceLanguage = 'en',
+  defaultTargetLanguage = 'es',
+}: Props) {
+  const [isApiSupported, setIsApiSupported] = useState<boolean | null>(null);
+  const [targetLanguage, setTargetLanguage] = useState(() =>
+    defaultTargetLanguage === sourceLanguage
+      ? (SUPPORTED_LANGUAGES.find((l) => l.code !== sourceLanguage)?.code ?? 'es')
+      : defaultTargetLanguage,
+  );
+  const [availability, setAvailability] = useState<TranslatorAvailability | null>(
+    null,
+  );
+  const [phase, setPhase] = useState<Phase>('checking');
+  const [progress, setProgress] = useState(0);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+  const nodesRef = useRef<TranslatableNode[]>([]);
+  const translatorRef = useRef<TranslatorInstance | null>(null);
+  const abortRef = useRef<AbortController | null>(null);
+
+  const restoreOriginal = useCallback(() => {
+    for (const { node, original } of nodesRef.current) {
+      node.data = original;
+    }
+    nodesRef.current = [];
+  }, []);
+
+  const releaseTranslator = useCallback(() => {
+    abortRef.current?.abort();
+    abortRef.current = null;
+    translatorRef.current?.destroy();
+    translatorRef.current = null;
+  }, []);
+
+  // Check availability for the selected language pair. The identical options
+  // object shape is later handed to Translator.create().
+  useEffect(() => {
+    const translatorApi = getTranslatorFactory();
+    if (!translatorApi) {
+      setIsApiSupported(false);
+      setPhase('error');
+      setErrorMessage(FALLBACK_NOTE);
+      return;
+    }
+
+    setIsApiSupported(true);
+
+    let cancelled = false;
+    setPhase('checking');
+    setErrorMessage(null);
+
+    const options: TranslatorLanguagePairOptions = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    translatorApi
+      .availability(options)
+      .then((status) => {
+        if (cancelled) return;
+        setAvailability(status);
+        setPhase('idle');
+      })
+      .catch(() => {
+        if (cancelled) return;
+        setAvailability('unavailable');
+        setPhase('error');
+        setErrorMessage(
+          `Could not check translation support for ${getLanguageLabel(targetLanguage)}.`,
+        );
+      });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  useEffect(() => releaseTranslator, [releaseTranslator]);
+
+  const handleLanguageChange = (
+    event: React.ChangeEvent<HTMLSelectElement>,
+  ) => {
+    restoreOriginal();
+    releaseTranslator();
+    setProgress(0);
+    setTargetLanguage(event.target.value);
+  };
+
+  // Invoked from a click, which satisfies the user gesture requirement that
+  // Translator.create() enforces while a language pack still has to download.
+  const handleTranslate = async () => {
+    const translatorApi = getTranslatorFactory();
+    if (!translatorApi) {
+      setIsApiSupported(false);
+      setPhase('error');
+      setErrorMessage(FALLBACK_NOTE);
+      return;
+    }
+
+    const root = document.querySelector<HTMLElement>(targetSelector);
+    if (!root) {
+      setPhase('error');
+      setErrorMessage('Nothing to translate on this page.');
+      return;
+    }
+
+    const options: TranslatorLanguagePairOptions = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    setErrorMessage(null);
+    setProgress(0);
+
+    try {
+      const status = await translatorApi.availability(options);
+      setAvailability(status);
+
+      if (status === 'unavailable') {
+        setPhase('error');
+        setErrorMessage(
+          `Translating ${getLanguageLabel(sourceLanguage)} to ${getLanguageLabel(
+            targetLanguage,
+          )} is not available on this device.`,
+        );
+        return;
+      }
+
+      setPhase(status === 'available' ? 'translating' : 'downloading');
+
+      const controller = new AbortController();
+      abortRef.current = controller;
+
+      const translator = await translatorApi.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (event) => {
+            setProgress(Math.round(event.loaded * 100));
+          });
+        },
+        signal: controller.signal,
+      });
+      translatorRef.current = translator;
+
+      setPhase('translating');
+      restoreOriginal();
+      const nodes = collectTextNodes(root);
+      nodesRef.current = nodes;
+
+      for (const { node, original } of nodes) {
+        await translateText(
+          translator,
+          original,
+          (partial) => {
+            node.data = partial;
+          },
+          controller.signal,
+        );
+      }
+
+      setPhase('translated');
+    } catch (error) {
+      if (error instanceof DOMException && error.name === 'AbortError') {
+        return;
+      }
+      restoreOriginal();
+      releaseTranslator();
+      setPhase('error');
+      setErrorMessage(
+        error instanceof DOMException && error.name === 'NotAllowedError'
+          ? 'The translation model download needs to be started from a user interaction. Please try again.'
+          : `Translation failed: ${
+              error instanceof Error ? error.message : String(error)
+            }`,
+      );
+    }
+  };
+
+  const handleShowOriginal = () => {
+    restoreOriginal();
+    releaseTranslator();
+    setProgress(0);
+    setPhase('idle');
+  };
+
+  const isBusy = phase === 'downloading' || phase === 'translating';
+  const isUnavailable = availability === 'unavailable';
+  const canTranslate = isApiSupported === true && !isBusy && !isUnavailable;
+
+  const statusText = (() => {
+    if (isApiSupported === false) return FALLBACK_NOTE;
+    if (phase === 'checking') return 'Checking on-device model availability…';
+    if (phase === 'downloading')
+      return `Downloading the ${getLanguageLabel(targetLanguage)} language pack… ${progress}%`;
+    if (phase === 'translating')
+      return progress > 0 && progress < 100
+        ? `Translating… (model ${progress}% downloaded)`
+        : 'Translating on device…';
+    if (phase === 'translated')
+      return `Translated into ${getLanguageLabel(targetLanguage)} on your device.`;
+    if (phase === 'error') return errorMessage ?? 'Something went wrong.';
+    if (availability === 'downloadable')
+      return `A one-time ${getLanguageLabel(targetLanguage)} model download is required.`;
+    if (availability === 'downloading')
+      return `The ${getLanguageLabel(targetLanguage)} model is already downloading — translating will attach to it.`;
+    if (availability === 'available')
+      return `The ${getLanguageLabel(targetLanguage)} model is ready on this device.`;
+    if (availability === 'unavailable')
+      return `Translating ${getLanguageLabel(sourceLanguage)} to ${getLanguageLabel(
+        targetLanguage,
+      )} is not available on this device.`;
+    return null;
+  })();
+
+  return (
+    <section
+      data-no-translate
+      aria-label="Translate this article"
+      className="border border-gray-200 bg-gray-50 p-4 mb-6"
+    >
+      <div className="flex flex-wrap items-center gap-3">
+        <span className="flex items-center gap-2 text-sm font-semibold text-gray-800">
+          <LanguageIcon className="h-5 w-5 text-gray-500" aria-hidden="true" />
+          Read this article in
+        </span>
+
+        <label className="sr-only" htmlFor="translator-target-language">
+          Target language
+        </label>
+        <select
+          id="translator-target-language"
+          value={targetLanguage}
+          onChange={handleLanguageChange}
+          disabled={isApiSupported === false || isBusy}
+          className="border border-gray-300 bg-white px-2 py-1 text-sm text-gray-800 disabled:opacity-50"
+        >
+          {SUPPORTED_LANGUAGES.filter(
+            (language) => language.code !== sourceLanguage,
+          ).map((language) => (
+            <option key={language.code} value={language.code}>
+              {language.label}
+            </option>
+          ))}
+        </select>
+
+        <button
+          type="button"
+          onClick={handleTranslate}
+          disabled={!canTranslate}
+          className="bg-gray-900 px-3 py-1 text-sm font-semibold text-white hover:bg-amber-400 hover:text-gray-900 disabled:cursor-not-allowed disabled:bg-gray-400"
+        >
+          {isBusy ? 'Working…' : 'Translate'}
+        </button>
+
+        {phase === 'translated' && (
+          <button
+            type="button"
+            onClick={handleShowOriginal}
+            className="border border-gray-400 px-3 py-1 text-sm font-semibold text-gray-800 hover:border-gray-900"
+          >
+            Show original
+          </button>
+        )}
+      </div>
+
+      {statusText && (
+        <p
+          role="status"
+          aria-live="polite"
+          className={`mt-2 text-xs ${
+            phase === 'error' ? 'text-red-700' : 'text-gray-600'
+          }`}
+        >
+          {statusText}
+        </p>
+      )}
+
+      {phase === 'downloading' && (
+        <progress
+          className="mt-2 w-full"
+          value={progress}
+          max={100}
+          aria-label="Model download progress"
+        />
+      )}
+
+      {isApiSupported === false && (
+        <p className="mt-1 text-xs text-gray-500">
+          On-device translation needs Chrome 138+ or Edge 148+ on desktop.
+        </p>
+      )}
+    </section>
+  );
+}
