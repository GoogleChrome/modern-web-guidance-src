diff --git a/src/components/TranslationControl.astro b/src/components/TranslationControl.astro
new file mode 100644
index 0000000..abea5b7
--- /dev/null
+++ b/src/components/TranslationControl.astro
@@ -0,0 +1,176 @@
+---
+interface Props {
+    label: string;
+}
+
+const { label } = Astro.props;
+const languages = {
+    ar: 'Arabic', bg: 'Bulgarian', bn: 'Bengali', cs: 'Czech', da: 'Danish',
+    de: 'German', el: 'Greek', es: 'Spanish', fi: 'Finnish', fr: 'French',
+    he: 'Hebrew', hi: 'Hindi', hr: 'Croatian', hu: 'Hungarian', id: 'Indonesian',
+    it: 'Italian', ja: 'Japanese', kn: 'Kannada', ko: 'Korean', lt: 'Lithuanian',
+    mr: 'Marathi', nl: 'Dutch', no: 'Norwegian', pl: 'Polish', pt: 'Portuguese',
+    ro: 'Romanian', ru: 'Russian', sk: 'Slovak', sl: 'Slovenian', sv: 'Swedish',
+    ta: 'Tamil', te: 'Telugu', th: 'Thai', tr: 'Turkish', uk: 'Ukrainian',
+    vi: 'Vietnamese', zh: 'Chinese', 'zh-Hant': 'Chinese (Traditional)',
+};
+---
+
+<article-translation class="block mt-3 text-sm text-gray-700">
+    <form class="flex flex-wrap items-center gap-2" aria-label={`Translate ${label}`}>
+        <label class="inline-flex items-center gap-2">
+            Language
+            <select disabled class="rounded border border-gray-400 bg-white px-2 py-1 disabled:opacity-60">
+                <option value="en">English (original)</option>
+                {Object.entries(languages).map(([code, name]) => <option value={code}>{name}</option>)}
+            </select>
+        </label>
+        <button type="submit" disabled class="rounded border border-gray-400 px-2 py-1 enabled:hover:bg-amber-50 disabled:opacity-60">
+            Translate
+        </button>
+    </form>
+    <p role="status" class="mt-1">On-device translation requires JavaScript.</p>
+</article-translation>
+
+<script>
+    type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+
+    interface TranslatorOptions {
+        sourceLanguage: string;
+        targetLanguage: string;
+        monitor: (monitor: EventTarget) => void;
+    }
+
+    interface BrowserTranslator {
+        translate(text: string): Promise<string>;
+        destroy(): void;
+    }
+
+    interface TranslatorAPI {
+        availability(options: TranslatorOptions): Promise<Availability>;
+        create(options: TranslatorOptions): Promise<BrowserTranslator>;
+    }
+
+    class ArticleTranslation extends HTMLElement {
+        connectedCallback() {
+            const scope = this.closest('[data-translation-scope]');
+            const form = this.querySelector('form');
+            const select = this.querySelector('select');
+            const button = this.querySelector('button');
+            const status = this.querySelector<HTMLElement>('[role="status"]');
+            if (!scope || !form || !select || !button || !status) return;
+
+            const api = (window as Window & { Translator?: TranslatorAPI }).Translator;
+            if (!api) {
+                status.textContent = 'On-device translation is unavailable in this browser.';
+                return;
+            }
+
+            const containers = Array.from(scope.querySelectorAll('[data-translation-text]'));
+            const originals = new Map<Text, string>();
+            for (const container of containers) {
+                const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
+                while (walker.nextNode()) {
+                    const node = walker.currentNode as Text;
+                    if (node.data.trim() && !node.parentElement?.closest('script, style, [translate="no"]')) {
+                        originals.set(node, node.data);
+                    }
+                }
+            }
+
+            let currentLanguage = 'en';
+            let options: TranslatorOptions | undefined;
+            let checkId = 0;
+
+            function displayLanguage(language: string) {
+                currentLanguage = language;
+                for (const container of containers) {
+                    container.setAttribute('lang', language);
+                    container.setAttribute('dir', language === 'ar' || language === 'he' ? 'rtl' : 'ltr');
+                }
+            }
+
+            select.disabled = false;
+            status.textContent = '';
+            select.addEventListener('change', async () => {
+                const id = ++checkId;
+                const targetLanguage = select.value;
+                options = undefined;
+                button.disabled = true;
+                button.textContent = targetLanguage === 'en' ? 'Show original' : 'Translate';
+                status.textContent = '';
+                if (targetLanguage === currentLanguage) return;
+                if (targetLanguage === 'en') {
+                    button.disabled = false;
+                    return;
+                }
+
+                const pair: TranslatorOptions = {
+                    sourceLanguage: 'en',
+                    targetLanguage,
+                    monitor(monitor) {
+                        monitor.addEventListener('downloadprogress', (event) => {
+                            const progress = event as ProgressEvent;
+                            status.textContent = `Downloading language pack… ${Math.round(progress.loaded * 100)}%`;
+                        });
+                    },
+                };
+                status.textContent = 'Checking language availability…';
+                try {
+                    const availability = await api.availability(pair);
+                    if (id !== checkId) return;
+                    if (availability === 'unavailable') {
+                        status.textContent = 'This language is unavailable on this device.';
+                        return;
+                    }
+                    options = pair;
+                    button.disabled = false;
+                    status.textContent = availability === 'available' ? '' : 'A language pack is required.';
+                } catch {
+                    if (id === checkId) status.textContent = 'Could not check this language. Try selecting it again.';
+                }
+            });
+
+            form.addEventListener('submit', async (event) => {
+                event.preventDefault();
+                if (button.disabled) return;
+                if (select.value === 'en') {
+                    for (const [node, text] of originals) node.data = text;
+                    displayLanguage('en');
+                    status.textContent = 'Showing the original English.';
+                    button.disabled = true;
+                    return;
+                }
+                if (!options) return;
+
+                const pair = options;
+                let translator: BrowserTranslator | undefined;
+                button.disabled = true;
+                select.disabled = true;
+                status.textContent = 'Preparing translation…';
+                try {
+                    translator = await api.create(pair);
+                    status.textContent = 'Translating…';
+                    const translations = new Map<Text, string>();
+                    for (const [node, text] of originals) {
+                        const source = text.trim();
+                        const start = text.indexOf(source);
+                        const translated = await translator.translate(source);
+                        translations.set(node, text.slice(0, start) + translated + text.slice(start + source.length));
+                    }
+                    for (const [node, text] of translations) node.data = text;
+                    displayLanguage(pair.targetLanguage);
+                    status.textContent = `Translated to ${select.selectedOptions[0]?.textContent}.`;
+                } catch {
+                    status.textContent = 'Translation failed. Try again.';
+                    button.disabled = false;
+                } finally {
+                    select.disabled = false;
+                    translator?.destroy();
+                }
+            });
+        }
+    }
+
+    customElements.define('article-translation', ArticleTranslation);
+</script>
