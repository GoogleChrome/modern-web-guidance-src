+import React, { useState, useEffect, useCallback, useRef } from 'react';
+import {
+  isTranslatorSupported,
+  checkAvailability,
+  createTranslator,
+  SUPPORTED_LANGUAGES,
+  type TranslatorAvailability,
+  type TranslatorOptions,
+  type TranslatorInstance,
+  type TranslationDownloadProgressEvent,
+} from '../utils/translator';
+import {
+  LanguageIcon,
+  ArrowPathIcon,
+  ArrowDownTrayIcon,
+  CheckIcon,
+  ExclamationCircleIcon,
+} from '@heroicons/react/24/outline';
+
+interface Props {
+  sourceLanguage?: string;
+  articleSelector?: string;
+  headlineSelector?: string;
+  summarySelector?: string;
+}
+
+export default function ArticleTranslator({
+  sourceLanguage = 'en',
+  articleSelector = '#article-body',
+  headlineSelector = '#article-headline',
+  summarySelector = '#article-summary',
+}: Props) {
+  const [isSupported, setIsSupported] = useState<boolean>(true);
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [availability, setAvailability] = useState<TranslatorAvailability | 'checking'>('checking');
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+  // Cache of original DOM content to enable restoring original text
+  const originalContentRef = useRef<{
+    headline?: string;
+    summary?: string;
+    elements: { el: HTMLElement; originalHtml: string; originalText: string }[];
+  }>({ elements: [] });
+
+  // Check API support and language pair availability
+  const checkStatus = useCallback(async (target: string) => {
+    setErrorMessage(null);
+    if (!isTranslatorSupported()) {
+      setIsSupported(false);
+      setAvailability('unavailable');
+      return;
+    }
+
+    setIsSupported(true);
+    setAvailability('checking');
+
+    const options: TranslatorOptions = {
+      sourceLanguage,
+      targetLanguage: target,
+    };
+
+    const status = await checkAvailability(options);
+    setAvailability(status);
+  }, [sourceLanguage]);
+
+  useEffect(() => {
+    checkStatus(targetLanguage);
+  }, [targetLanguage, checkStatus]);
+
+  // Restore original content
+  const handleRestoreOriginal = () => {
+    if (headlineSelector && originalContentRef.current.headline !== undefined) {
+      const headlineEl = document.querySelector(headlineSelector);
+      if (headlineEl) headlineEl.textContent = originalContentRef.current.headline;
+    }
+
+    if (summarySelector && originalContentRef.current.summary !== undefined) {
+      const summaryEl = document.querySelector(summarySelector);
+      if (summaryEl) summaryEl.textContent = originalContentRef.current.summary;
+    }
+
+    originalContentRef.current.elements.forEach(({ el, originalHtml }) => {
+      el.innerHTML = originalHtml;
+    });
+
+    setIsTranslated(false);
+  };
+
+  // Perform translation on click (user gesture)
+  const handleTranslate = async () => {
+    if (isTranslated) {
+      handleRestoreOriginal();
+      return;
+    }
+
+    setErrorMessage(null);
+    setIsTranslating(true);
+    setDownloadProgress(null);
+
+    const options: TranslatorOptions = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    try {
+      // Create translator instance with progress monitoring
+      const translator: TranslatorInstance = await createTranslator(
+        options,
+        (progressPercent: number, _event: TranslationDownloadProgressEvent) => {
+          setDownloadProgress(progressPercent);
+        }
+      );
+
+      // Collect elements to translate if not already stored
+      const elementsToTranslate: HTMLElement[] = [];
+      const container = document.querySelector(articleSelector);
+      if (container) {
+        const textElements = container.querySelectorAll<HTMLElement>('p, h2, h3, h4, li, blockquote');
+        textElements.forEach((el) => {
+          if (el.textContent && el.textContent.trim().length > 0) {
+            elementsToTranslate.push(el);
+          }
+        });
+      }
+
+      // Store original content
+      const headlineEl = headlineSelector ? document.querySelector<HTMLElement>(headlineSelector) : null;
+      const summaryEl = summarySelector ? document.querySelector<HTMLElement>(summarySelector) : null;
+
+      originalContentRef.current = {
+        headline: headlineEl?.textContent || undefined,
+        summary: summaryEl?.textContent || undefined,
+        elements: elementsToTranslate.map((el) => ({
+          el,
+          originalHtml: el.innerHTML,
+          originalText: el.textContent || '',
+        })),
+      };
+
+      // 1. Translate headline
+      if (headlineEl && originalContentRef.current.headline) {
+        try {
+          if (typeof translator.translateStreaming === 'function') {
+            const stream = translator.translateStreaming(originalContentRef.current.headline);
+            if (Symbol.asyncIterator in stream) {
+              for await (const chunk of stream as AsyncIterable<string>) {
+                headlineEl.textContent = chunk;
+              }
+            } else {
+              const res = await translator.translate(originalContentRef.current.headline);
+              headlineEl.textContent = res;
+            }
+          } else {
+            const res = await translator.translate(originalContentRef.current.headline);
+            headlineEl.textContent = res;
+          }
+        } catch (e) {
+          console.warn('Failed to translate headline:', e);
+        }
+      }
+
+      // 2. Translate summary
+      if (summaryEl && originalContentRef.current.summary) {
+        try {
+          if (typeof translator.translateStreaming === 'function') {
+            const stream = translator.translateStreaming(originalContentRef.current.summary);
+            if (Symbol.asyncIterator in stream) {
+              for await (const chunk of stream as AsyncIterable<string>) {
+                summaryEl.textContent = chunk;
+              }
+            } else {
+              const res = await translator.translate(originalContentRef.current.summary);
+              summaryEl.textContent = res;
+            }
+          } else {
+            const res = await translator.translate(originalContentRef.current.summary);
+            summaryEl.textContent = res;
+          }
+        } catch (e) {
+          console.warn('Failed to translate summary:', e);
+        }
+      }
+
+      // 3. Translate body paragraphs
+      for (const item of originalContentRef.current.elements) {
+        if (!item.originalText.trim()) continue;
+        try {
+          if (typeof translator.translateStreaming === 'function') {
+            const stream = translator.translateStreaming(item.originalText);
+            if (Symbol.asyncIterator in stream) {
+              for await (const chunk of stream as AsyncIterable<string>) {
+                item.el.textContent = chunk;
+              }
+            } else {
+              const res = await translator.translate(item.originalText);
+              item.el.textContent = res;
+            }
+          } else {
+            const res = await translator.translate(item.originalText);
+            item.el.textContent = res;
+          }
+        } catch (e) {
+          console.warn('Failed to translate element:', e);
+        }
+      }
+
+      setIsTranslated(true);
+      if (typeof translator.destroy === 'function') {
+        translator.destroy();
+      }
+    } catch (err: any) {
+      console.error('Translation error:', err);
+      setErrorMessage(err?.message || 'Translation failed. Please try again.');
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  const getAvailabilityBadge = () => {
+    switch (availability) {
+      case 'available':
+        return (
+          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
+            <CheckIcon className="w-3 h-3" /> Ready
+          </span>
+        );
+      case 'downloadable':
+        return (
+          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
+            <ArrowDownTrayIcon className="w-3 h-3" /> Download needed
+          </span>
+        );
+      case 'downloading':
+        return (
+          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800 animate-pulse">
+            <ArrowPathIcon className="w-3 h-3 animate-spin" /> Downloading...
+          </span>
+        );
+      case 'unavailable':
+      default:
+        return (
+          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-600">
+            <ExclamationCircleIcon className="w-3 h-3" /> Unsupported
+          </span>
+        );
+    }
+  };
+
+  if (!isSupported) {
+    return (
+      <div className="flex items-center text-xs text-gray-500 gap-1.5 py-1">
+        <LanguageIcon className="w-4 h-4 text-gray-400" />
+        <span>Client-side translation is unsupported in this browser.</span>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex flex-wrap items-center gap-2 py-2 text-sm bg-gray-50 border border-gray-200 rounded-lg px-3">
+      <div className="flex items-center gap-1.5 text-gray-700 font-medium">
+        <LanguageIcon className="w-5 h-5 text-gray-600" />
+        <span className="text-xs uppercase tracking-wide text-gray-500 font-semibold">Translate:</span>
+      </div>
+
+      {/* Language Selector */}
+      <select
+        value={targetLanguage}
+        onChange={(e) => {
+          setTargetLanguage(e.target.value);
+          if (isTranslated) {
+            handleRestoreOriginal();
+          }
+        }}
+        disabled={isTranslating}
+        className="text-xs bg-white border border-gray-300 rounded px-2 py-1 focus:ring-1 focus:ring-amber-500 focus:outline-none cursor-pointer"
+        aria-label="Target translation language"
+      >
+        {SUPPORTED_LANGUAGES.filter((lang) => lang.code !== sourceLanguage).map((lang) => (
+          <option key={lang.code} value={lang.code}>
+            {lang.name} ({lang.code})
+          </option>
+        ))}
+      </select>
+
+      {/* Availability Status Badge */}
+      <div className="hidden sm:flex items-center">
+        {getAvailabilityBadge()}
+      </div>
+
+      {/* Translate / Restore Action Button */}
+      <button
+        type="button"
+        id="start-translation-btn"
+        onClick={handleTranslate}
+        disabled={isTranslating || availability === 'unavailable'}
+        className={`inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded transition-colors ${
+          isTranslated
+            ? 'bg-gray-200 text-gray-800 hover:bg-gray-300'
+            : availability === 'unavailable'
+            ? 'bg-gray-200 text-gray-400 cursor-not-allowed'
+            : 'bg-amber-400 text-gray-900 hover:bg-amber-500 shadow-sm'
+        }`}
+      >
+        {isTranslating ? (
+          <>
+            <ArrowPathIcon className="w-3.5 h-3.5 animate-spin" />
+            {downloadProgress !== null
+              ? `Downloading ${downloadProgress}%...`
+              : 'Translating...'}
+          </>
+        ) : isTranslated ? (
+          'Show Original'
+        ) : (
+          'Translate'
+        )}
+      </button>
+
+      {/* Download Progress Display */}
+      {downloadProgress !== null && (
+        <div className="flex items-center gap-2 text-xs text-amber-700 w-full sm:w-auto">
+          <div className="w-24 bg-gray-200 rounded-full h-1.5 overflow-hidden">
+            <div
+              className="bg-amber-500 h-1.5 rounded-full transition-all duration-200"
+              style={{ width: `${downloadProgress}%` }}
+            />
+          </div>
+          <span>{downloadProgress}%</span>
+        </div>
+      )}
+
+      {/* Error Message */}
+      {errorMessage && (
+        <div className="text-xs text-red-600 w-full mt-1">
+          {errorMessage}
+        </div>
+      )}
+    </div>
+  );
+}
