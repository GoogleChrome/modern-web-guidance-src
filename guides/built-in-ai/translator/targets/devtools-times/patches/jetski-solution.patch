diff --git a/src/utils/translator.ts b/src/utils/translator.ts
new file mode 100644
index 0000000..fe1a0c3
--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,194 @@
+import type {
+  TranslatorLanguageOptions,
+  TranslatorCreateOptions,
+  TranslatorAvailability,
+  TranslatorInstance,
+  TranslationDownloadMonitor,
+  TranslationDownloadProgressEvent,
+} from '../../global';
+
+export interface LanguageOption {
+  code: string;
+  name: string;
+  nativeName?: string;
+}
+
+/**
+ * Languages supported by the Built-in AI Translator API.
+ */
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'ar', name: 'Arabic', nativeName: 'العربية' },
+  { code: 'bg', name: 'Bulgarian', nativeName: 'Български' },
+  { code: 'bn', name: 'Bengali', nativeName: 'বাংলা' },
+  { code: 'cs', name: 'Czech', nativeName: 'Čeština' },
+  { code: 'da', name: 'Danish', nativeName: 'Dansk' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch' },
+  { code: 'el', name: 'Greek', nativeName: 'Ελληνικά' },
+  { code: 'en', name: 'English', nativeName: 'English' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español' },
+  { code: 'fi', name: 'Finnish', nativeName: 'Suomi' },
+  { code: 'fr', name: 'French', nativeName: 'Français' },
+  { code: 'he', name: 'Hebrew', nativeName: 'עברית' },
+  { code: 'hi', name: 'Hindi', nativeName: 'हिन्दी' },
+  { code: 'hr', name: 'Croatian', nativeName: 'Hrvatski' },
+  { code: 'hu', name: 'Hungarian', nativeName: 'Magyar' },
+  { code: 'id', name: 'Indonesian', nativeName: 'Bahasa Indonesia' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語' },
+  { code: 'kn', name: 'Kannada', nativeName: 'ಕನ್ನಡ' },
+  { code: 'ko', name: 'Korean', nativeName: '한국어' },
+  { code: 'lt', name: 'Lithuanian', nativeName: 'Lietuvių' },
+  { code: 'mr', name: 'Marathi', nativeName: 'मराठी' },
+  { code: 'nl', name: 'Dutch', nativeName: 'Nederlands' },
+  { code: 'no', name: 'Norwegian', nativeName: 'Norsk' },
+  { code: 'pl', name: 'Polish', nativeName: 'Polski' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português' },
+  { code: 'ro', name: 'Romanian', nativeName: 'Română' },
+  { code: 'ru', name: 'Russian', nativeName: 'Русский' },
+  { code: 'sk', name: 'Slovak', nativeName: 'Slovenčina' },
+  { code: 'sl', name: 'Slovenian', nativeName: 'Slovenščina' },
+  { code: 'sv', name: 'Swedish', nativeName: 'Svenska' },
+  { code: 'ta', name: 'Tamil', nativeName: 'தமிழ்' },
+  { code: 'te', name: 'Telugu', nativeName: 'తెలుగు' },
+  { code: 'th', name: 'Thai', nativeName: 'ไทย' },
+  { code: 'tr', name: 'Turkish', nativeName: 'Türkçe' },
+  { code: 'uk', name: 'Ukrainian', nativeName: 'Українська' },
+  { code: 'vi', name: 'Vietnamese', nativeName: 'Tiếng Việt' },
+  { code: 'zh', name: 'Chinese (Simplified)', nativeName: '简体中文' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)', nativeName: '繁體中文' },
+];
+
+/**
+ * Checks whether the Translator API is available in the global browser scope.
+ * The Translator API is accessed on window.Translator.
+ */
+export function isTranslatorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return 'Translator' in window && typeof window.Translator !== 'undefined';
+}
+
+/**
+ * Checks model availability for a given language pair.
+ * Must be called with both sourceLanguage and targetLanguage options.
+ * Returns 'available' | 'downloadable' | 'downloading' | 'unavailable'.
+ */
+export async function checkAvailability(
+  options: TranslatorLanguageOptions
+): Promise<TranslatorAvailability> {
+  if (!isTranslatorSupported() || !window.Translator) {
+    return 'unavailable';
+  }
+
+  try {
+    const availability = await window.Translator.availability({
+      sourceLanguage: options.sourceLanguage,
+      targetLanguage: options.targetLanguage,
+    });
+    return availability;
+  } catch (error) {
+    console.error('Error checking Translator availability:', error);
+    return 'unavailable';
+  }
+}
+
+/**
+ * Creates a Translator instance with the given language options and a download progress monitor.
+ * Passes the exact same sourceLanguage and targetLanguage options to Translator.create().
+ */
+export async function createTranslator(
+  options: TranslatorLanguageOptions,
+  onDownloadProgress?: (progressPercent: number, event: TranslationDownloadProgressEvent) => void,
+  signal?: AbortSignal
+): Promise<TranslatorInstance> {
+  if (!isTranslatorSupported() || !window.Translator) {
+    throw new Error('Translator API is not supported in this browser.');
+  }
+
+  const createOptions: TranslatorCreateOptions = {
+    sourceLanguage: options.sourceLanguage,
+    targetLanguage: options.targetLanguage,
+    monitor(monitor: TranslationDownloadMonitor) {
+      monitor.addEventListener('downloadprogress', (e: TranslationDownloadProgressEvent) => {
+        const progress = typeof e.loaded === 'number' ? Math.round(e.loaded * 100) : 0;
+        console.log(`Downloaded ${progress}%`);
+        if (onDownloadProgress) {
+          onDownloadProgress(progress, e);
+        }
+      });
+    },
+    ...(signal ? { signal } : {}),
+  };
+
+  return await window.Translator.create(createOptions);
+}
+
+/**
+ * Translates a single text string using a newly created Translator instance.
+ */
+export async function translate(
+  text: string,
+  options: TranslatorLanguageOptions,
+  onDownloadProgress?: (percent: number, event: TranslationDownloadProgressEvent) => void
+): Promise<string> {
+  const translator = await createTranslator(options, onDownloadProgress);
+  try {
+    return await translator.translate(text);
+  } finally {
+    if (typeof translator.destroy === 'function') {
+      translator.destroy();
+    }
+  }
+}
+
+/**
+ * Translates a text string with streaming chunks using a newly created Translator instance.
+ */
+export async function translateStreaming(
+  text: string,
+  options: TranslatorLanguageOptions,
+  onChunk: (chunk: string) => void,
+  onDownloadProgress?: (percent: number, event: TranslationDownloadProgressEvent) => void
+): Promise<string> {
+  const translator = await createTranslator(options, onDownloadProgress);
+  try {
+    return await translateStreamingWithInstance(translator, text, onChunk);
+  } finally {
+    if (typeof translator.destroy === 'function') {
+      translator.destroy();
+    }
+  }
+}
+
+/**
+ * Translates text with an existing Translator instance using translate().
+ */
+export async function translateWithInstance(
+  translator: TranslatorInstance,
+  text: string
+): Promise<string> {
+  return await translator.translate(text);
+}
+
+/**
+ * Translates text with an existing Translator instance using translateStreaming() when available,
+ * falling back to translate().
+ */
+export async function translateStreamingWithInstance(
+  translator: TranslatorInstance,
+  text: string,
+  onChunk?: (chunk: string) => void
+): Promise<string> {
+  if (typeof translator.translateStreaming === 'function') {
+    const stream = translator.translateStreaming(text);
+    let result = '';
+    for await (const chunk of stream) {
+      result = chunk;
+      onChunk?.(chunk);
+    }
+    return result;
+  } else {
+    const result = await translator.translate(text);
+    onChunk?.(result);
+    return result;
+  }
+}
