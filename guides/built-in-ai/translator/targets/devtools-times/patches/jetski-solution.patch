diff --git a/src/utils/translator.ts b/src/utils/translator.ts
new file mode 100644
index 0000000..11d2705
--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,219 @@
+export interface TranslationDownloadProgressEvent extends Event {
+  readonly loaded: number;
+  readonly total?: number;
+}
+
+export interface TranslationDownloadMonitor extends EventTarget {
+  addEventListener(
+    type: 'downloadprogress',
+    listener: (event: TranslationDownloadProgressEvent) => void,
+    options?: boolean | AddEventListenerOptions
+  ): void;
+  removeEventListener(
+    type: 'downloadprogress',
+    listener: (event: TranslationDownloadProgressEvent) => void,
+    options?: boolean | EventListenerOptions
+  ): void;
+}
+
+export type TranslatorAvailability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+
+export interface TranslatorOptions {
+  sourceLanguage: string;
+  targetLanguage: string;
+}
+
+export interface TranslatorCreateOptions extends TranslatorOptions {
+  monitor?: (monitor: TranslationDownloadMonitor) => void;
+  signal?: AbortSignal;
+}
+
+export interface TranslatorInstance {
+  readonly sourceLanguage: string;
+  readonly targetLanguage: string;
+  translate(input: string): Promise<string>;
+  translateStreaming(input: string): AsyncIterable<string> | ReadableStream<string>;
+  destroy(): void;
+}
+
+export interface TranslatorFactory {
+  availability(options: TranslatorOptions): Promise<TranslatorAvailability>;
+  create(options: TranslatorCreateOptions): Promise<TranslatorInstance>;
+}
+
+export interface SupportedLanguage {
+  code: string;
+  name: string;
+}
+
+export const SUPPORTED_LANGUAGES: SupportedLanguage[] = [
+  { code: 'ar', name: 'Arabic' },
+  { code: 'bg', name: 'Bulgarian' },
+  { code: 'bn', name: 'Bengali' },
+  { code: 'cs', name: 'Czech' },
+  { code: 'da', name: 'Danish' },
+  { code: 'de', name: 'German' },
+  { code: 'el', name: 'Greek' },
+  { code: 'en', name: 'English' },
+  { code: 'es', name: 'Spanish' },
+  { code: 'fi', name: 'Finnish' },
+  { code: 'fr', name: 'French' },
+  { code: 'hi', name: 'Hindi' },
+  { code: 'hr', name: 'Croatian' },
+  { code: 'hu', name: 'Hungarian' },
+  { code: 'id', name: 'Indonesian' },
+  { code: 'it', name: 'Italian' },
+  { code: 'he', name: 'Hebrew' },
+  { code: 'ja', name: 'Japanese' },
+  { code: 'kn', name: 'Kannada' },
+  { code: 'ko', name: 'Korean' },
+  { code: 'lt', name: 'Lithuanian' },
+  { code: 'mr', name: 'Marathi' },
+  { code: 'nl', name: 'Dutch' },
+  { code: 'no', name: 'Norwegian' },
+  { code: 'pl', name: 'Polish' },
+  { code: 'pt', name: 'Portuguese' },
+  { code: 'ro', name: 'Romanian' },
+  { code: 'ru', name: 'Russian' },
+  { code: 'sk', name: 'Slovak' },
+  { code: 'sl', name: 'Slovenian' },
+  { code: 'sv', name: 'Swedish' },
+  { code: 'ta', name: 'Tamil' },
+  { code: 'te', name: 'Telugu' },
+  { code: 'th', name: 'Thai' },
+  { code: 'tr', name: 'Turkish' },
+  { code: 'uk', name: 'Ukrainian' },
+  { code: 'vi', name: 'Vietnamese' },
+  { code: 'zh', name: 'Chinese' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)' },
+];
+
+/**
+ * Checks if the global Translator API is supported in the browser.
+ * MANDATORY: Access the Translator API exclusively via the global Translator interface (window.Translator / self.Translator).
+ * DO NOT check or use window.ai.translator.
+ */
+export function isTranslatorSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return 'Translator' in window && typeof (window as any).Translator?.availability === 'function';
+}
+
+/**
+ * Checks the availability of a language pair for translation.
+ * MANDATORY: Must be called with both sourceLanguage and targetLanguage options.
+ * Returns 'available' | 'downloadable' | 'downloading' | 'unavailable'.
+ */
+export async function checkAvailability(options: TranslatorOptions): Promise<TranslatorAvailability> {
+  if (!isTranslatorSupported()) {
+    return 'unavailable';
+  }
+
+  try {
+    const translatorApi = (window as any).Translator as TranslatorFactory;
+    const availability = await translatorApi.availability({
+      sourceLanguage: options.sourceLanguage,
+      targetLanguage: options.targetLanguage,
+    });
+    return availability;
+  } catch (error) {
+    console.error('Failed to check Translator availability:', error);
+    return 'unavailable';
+  }
+}
+
+/**
+ * Creates a Translator instance with download progress monitoring.
+ * MANDATORY:
+ * 1. Passes identical sourceLanguage and targetLanguage options as used in availability().
+ * 2. Implements a monitor for download progress using the 'downloadprogress' event.
+ */
+export async function createTranslator(
+  options: TranslatorOptions,
+  onProgress?: (progressPercent: number, event: TranslationDownloadProgressEvent) => void
+): Promise<TranslatorInstance> {
+  if (!isTranslatorSupported()) {
+    throw new Error('Translator API is not available on window.Translator in this browser.');
+  }
+
+  const translatorApi = (window as any).Translator as TranslatorFactory;
+
+  const createOptions: TranslatorCreateOptions = {
+    sourceLanguage: options.sourceLanguage,
+    targetLanguage: options.targetLanguage,
+    monitor(m: TranslationDownloadMonitor) {
+      m.addEventListener('downloadprogress', (e: TranslationDownloadProgressEvent) => {
+        const percent = typeof e.loaded === 'number' ? Math.round(e.loaded * 100) : 0;
+        console.log(`Downloaded ${percent}%`);
+        if (onProgress) {
+          onProgress(percent, e);
+        }
+      });
+    },
+  };
+
+  return await translatorApi.create(createOptions);
+}
+
+/**
+ * Translates text from sourceLanguage to targetLanguage using standard translate().
+ */
+export async function translateText(
+  text: string,
+  options: TranslatorOptions,
+  onProgress?: (progressPercent: number, event: TranslationDownloadProgressEvent) => void
+): Promise<string> {
+  const translator = await createTranslator(options, onProgress);
+  try {
+    return await translator.translate(text);
+  } finally {
+    if (typeof translator.destroy === 'function') {
+      translator.destroy();
+    }
+  }
+}
+
+/**
+ * Translates text using streaming translation (translateStreaming), with fallback to translate().
+ */
+export async function translateTextStreaming(
+  text: string,
+  options: TranslatorOptions,
+  onChunk: (accumulatedOrChunk: string) => void,
+  onProgress?: (progressPercent: number, event: TranslationDownloadProgressEvent) => void
+): Promise<string> {
+  const translator = await createTranslator(options, onProgress);
+  try {
+    if (typeof translator.translateStreaming === 'function') {
+      const stream = translator.translateStreaming(text);
+      let lastText = '';
+
+      if (Symbol.asyncIterator in stream) {
+        for await (const chunk of stream as AsyncIterable<string>) {
+          lastText = chunk;
+          onChunk(chunk);
+        }
+        return lastText;
+      } else if (stream instanceof ReadableStream) {
+        const reader = stream.getReader();
+        while (true) {
+          const { done, value } = await reader.read();
+          if (done) break;
+          if (typeof value === 'string') {
+            lastText = value;
+            onChunk(value);
+          }
+        }
+        return lastText;
+      }
+    }
+
+    // Fallback to standard translate if translateStreaming is not available
+    const result = await translator.translate(text);
+    onChunk(result);
+    return result;
+  } finally {
+    if (typeof translator.destroy === 'function') {
+      translator.destroy();
+    }
+  }
+}
