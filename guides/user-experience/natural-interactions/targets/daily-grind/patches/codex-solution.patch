+  <script>
+    const supportsPopover = 'showPopover' in HTMLElement.prototype;
+    const triggers = document.querySelectorAll('.card button[popovertarget]');
+
+    triggers.forEach((trigger) => {
+      const panel = document.getElementById(trigger.getAttribute('popovertarget'));
+      const closeButton = panel.querySelector('.close-details');
+      let open = false;
+
+      // Use viewport coordinates so placement also works without CSS anchors.
+      function placePanel() {
+        const rect = trigger.getBoundingClientRect();
+        const width = Math.min(320, window.innerWidth - 24);
+        const left = Math.max(12, Math.min(rect.left, window.innerWidth - width - 12));
+        const below = window.innerHeight - rect.bottom - 20;
+        const above = rect.top - 20;
+        const opensBelow = below >= Math.min(240, above);
+        panel.style.left = `${left}px`;
+        panel.style.top = opensBelow ? `${Math.max(12, rect.bottom + 8)}px` : 'auto';
+        panel.style.bottom = opensBelow ? 'auto' : `${Math.max(12, window.innerHeight - rect.top + 8)}px`;
+        panel.style.maxHeight = `${Math.max(0, opensBelow ? below : above)}px`;
+        const originX = Math.max(0, Math.min(width, rect.left + rect.width / 2 - left));
+        panel.style.transformOrigin = `${originX}px ${opensBelow ? 'top' : 'bottom'}`;
+      }
+
+      function updateState(isOpen) {
+        open = isOpen;
+        trigger.setAttribute('aria-expanded', String(isOpen));
+        panel.classList.toggle('is-open', isOpen);
+      }
+
+      function closePanel(restoreFocus = false) {
+        if (!open) return;
+        if (supportsPopover) panel.hidePopover();
+        else {
+          panel.hidden = true;
+          updateState(false);
+        }
+        if (restoreFocus) trigger.focus({ preventScroll: true });
+      }
+
+      if (supportsPopover) {
+        panel.hidden = false;
+        panel.addEventListener('beforetoggle', (event) => {
+          if (event.newState === 'open') placePanel();
+          updateState(event.newState === 'open');
+        });
+      } else {
+        trigger.addEventListener('click', () => {
+          if (open) closePanel();
+          else {
+            document.dispatchEvent(new Event('close-drink-details'));
+            placePanel();
+            panel.hidden = false;
+            updateState(true);
+            panel.querySelector('a').focus({ preventScroll: true });
+          }
+        });
+        document.addEventListener('close-drink-details', () => closePanel());
+        document.addEventListener('click', (event) => {
+          if (!panel.contains(event.target) && !trigger.contains(event.target)) closePanel();
+        });
+        document.addEventListener('keydown', (event) => {
+          if (event.key === 'Escape' && open) {
+            event.preventDefault();
+            closePanel(true);
+          }
+        });
+      }
+
+      closeButton.addEventListener('click', () => closePanel(true));
+      window.addEventListener('resize', () => closePanel(panel.contains(document.activeElement)));
+      document.addEventListener('scroll', (event) => {
+        if (open && !panel.contains(event.target)) {
+          closePanel(panel.contains(document.activeElement));
+        }
+      }, true);
+    });
+  </script>
