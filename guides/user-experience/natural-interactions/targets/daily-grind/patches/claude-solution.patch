+  <script>
+    (function () {
+      var popovers = document.querySelectorAll('.details');
+      var supportsPopover = Object.prototype.hasOwnProperty.call(HTMLElement.prototype, 'popover');
+      var supportsAnchor = window.CSS && CSS.supports && CSS.supports('position-area: bottom');
+
+      function placeBelow(popover, trigger) {
+        if (supportsAnchor || !trigger) return;
+        var rect = trigger.getBoundingClientRect();
+        var width = popover.offsetWidth || 320;
+        var left = rect.left + rect.width / 2 - width / 2;
+        left = Math.max(16, Math.min(left, window.innerWidth - width - 16));
+        popover.style.position = 'fixed';
+        popover.style.top = rect.bottom + 'px';
+        popover.style.left = left + 'px';
+      }
+
+      function openerFor(popover) {
+        return document.querySelector('[popovertarget="' + popover.id + '"]:not([popovertargetaction="hide"])');
+      }
+
+      if (supportsPopover) {
+        popovers.forEach(function (popover) {
+          popover.addEventListener('toggle', function (event) {
+            if (event.newState === 'open') placeBelow(popover, openerFor(popover));
+          });
+        });
+        return;
+      }
+
+      // Fallback for browsers without the Popover API.
+      function hide(popover, restoreFocus) {
+        if (!popover.classList.contains(':popover-open')) return;
+        popover.classList.remove(':popover-open');
+        var opener = openerFor(popover);
+        if (opener) opener.setAttribute('aria-expanded', 'false');
+        if (restoreFocus && opener) opener.focus();
+      }
+
+      function show(popover) {
+        popovers.forEach(function (p) { if (p !== popover) hide(p, false); });
+        popover.classList.add(':popover-open');
+        var opener = openerFor(popover);
+        if (opener) opener.setAttribute('aria-expanded', 'true');
+        placeBelow(popover, opener);
+      }
+
+      document.querySelectorAll('[popovertarget]').forEach(function (trigger) {
+        var popover = document.getElementById(trigger.getAttribute('popovertarget'));
+        if (!popover) return;
+        trigger.addEventListener('click', function (event) {
+          event.stopPropagation();
+          var action = trigger.getAttribute('popovertargetaction') || 'toggle';
+          var isOpen = popover.classList.contains(':popover-open');
+          if (action === 'hide' || (action === 'toggle' && isOpen)) hide(popover, action === 'hide');
+          else show(popover);
+        });
+      });
+
+      document.addEventListener('click', function (event) {
+        popovers.forEach(function (p) { if (!p.contains(event.target)) hide(p, false); });
+      });
+
+      document.addEventListener('keydown', function (event) {
+        if (event.key !== 'Escape') return;
+        popovers.forEach(function (p) { hide(p, p.contains(document.activeElement)); });
+      });
+    })();
+  </script>
+
