diff --git a/src/styles/global.css b/src/styles/global.css
index e9a9abb..2c11f4d 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,87 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+/*
+ * Top-layer entry/exit animations for <dialog> and [popover] elements.
+ * See guide: animate-to-from-top-layer.
+ */
+
+/* ---- Dialog (Search / Reading List) ---- */
+
+dialog.app-dialog {
+  opacity: 0;
+  transform: scale(0.95) translateY(-12px);
+
+  transition-property: opacity, transform, display, overlay;
+  transition-duration: 0.3s;
+  transition-timing-function: ease-out;
+  /* MANDATORY: allows the `display` (and `overlay`) transition to run instead of jumping instantly. */
+  transition-behavior: allow-discrete;
+
+  &[open] {
+    opacity: 1;
+    transform: scale(1) translateY(0);
+
+    @starting-style {
+      opacity: 0;
+      transform: scale(0.95) translateY(-12px);
+    }
+  }
+}
+
+dialog.app-dialog::backdrop {
+  background-color: rgb(0 0 0 / 0%);
+  transition:
+    display 0.3s allow-discrete,
+    overlay 0.3s allow-discrete,
+    background-color 0.3s ease-out;
+}
+
+dialog.app-dialog[open]::backdrop {
+  background-color: rgb(0 0 0 / 50%);
+
+  @starting-style {
+    background-color: rgb(0 0 0 / 0%);
+  }
+}
+
+/* ---- Popover (bottom-nav flyout menu) ---- */
+
+[popover].app-popover {
+  opacity: 0;
+  transform: translateY(-8px);
+
+  transition-property: opacity, transform, display, overlay;
+  transition-duration: 0.25s;
+  transition-timing-function: ease-out;
+  transition-behavior: allow-discrete;
+
+  &:popover-open {
+    opacity: 1;
+    transform: translateY(0);
+
+    @starting-style {
+      opacity: 0;
+      transform: translateY(-8px);
+    }
+  }
+}
+
+/* ---- Respect reduced-motion preferences ---- */
+
+@media (prefers-reduced-motion: reduce) {
+  dialog.app-dialog,
+  [popover].app-popover {
+    transform: none;
+    transition-duration: 0.1s;
+  }
+
+  dialog.app-dialog[open],
+  [popover].app-popover:popover-open {
+    @starting-style {
+      transform: none;
+    }
+  }
 }
