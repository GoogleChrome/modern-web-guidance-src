--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -4,4 +4,96 @@
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
+}
+
+/* Top-layer entry/exit animations for <dialog> and [popover] elements. */
+
+dialog {
+  margin-top: 10vh;
+  opacity: 0;
+  transform: scale(0.95);
+
+  transition-property: opacity, transform, display, overlay;
+  transition-duration: 0.3s;
+  transition-timing-function: ease-out;
+  transition-behavior: allow-discrete; /* must come after the shorthand */
+}
+
+dialog[open] {
+  opacity: 1;
+  transform: scale(1);
+
+  @starting-style {
+    opacity: 0;
+    transform: scale(0.95);
+  }
+}
+
+dialog::backdrop {
+  background-color: rgba(17, 24, 39, 0);
+
+  transition:
+    background-color 0.3s ease-out,
+    display 0.3s allow-discrete,
+    overlay 0.3s allow-discrete;
+}
+
+dialog[open]::backdrop {
+  background-color: rgba(17, 24, 39, 0.4);
+
+  @starting-style {
+    background-color: rgba(17, 24, 39, 0);
+  }
+}
+
+[popover] {
+  opacity: 0;
+  transform: translateY(-0.5rem) scale(0.98);
+
+  transition-property: opacity, transform, display, overlay;
+  transition-duration: 0.25s;
+  transition-timing-function: ease-out;
+  transition-behavior: allow-discrete; /* must come after the shorthand */
+}
+
+[popover]:popover-open {
+  opacity: 1;
+  transform: translateY(0) scale(1);
+
+  @starting-style {
+    opacity: 0;
+    transform: translateY(-0.5rem) scale(0.98);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  dialog,
+  [popover] {
+    transform: none;
+    transition-duration: 1ms;
+  }
+
+  dialog::backdrop {
+    transition-duration: 1ms;
+  }
+
+  @starting-style {
+    dialog[open],
+    [popover]:popover-open {
+      transform: none;
+    }
+  }
+}
+
+/* Anchor the category mega-menu popover beneath the bottom nav bar. */
+.bottom-nav-bar {
+  anchor-name: --bottom-nav-bar;
+}
+
+.mega-menu-popover {
+  position: fixed;
+  inset-inline: 0;
+  top: 110px;
+  top: anchor(--bottom-nav-bar bottom);
+  margin: 0;
 }
