+    /* Dialog and Popover Layout */
+    dialog {
+      margin: auto;
+      padding: 2rem;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      max-width: 500px;
+      width: 90%;
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
+    }
+
+    [popover] {
+      margin: auto;
+      padding: 1.5rem;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      background: white;
+      color: var(--text);
+      max-width: 350px;
+      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
+    }
+
+    .popover-btn {
+      background: transparent;
+      border: 1px solid var(--accent);
+      color: white;
+      padding: 5px 12px;
+      border-radius: 4px;
+      cursor: pointer;
+      font-size: 0.9rem;
+      transition: background 0.3s;
+    }
+
+    .popover-btn:hover {
+      background: var(--accent);
+      color: var(--primary);
+    }
+
+    /* Base (closed/exit) state & transitions */
+    dialog,
+    [popover] {
+      opacity: 0;
+      transform: scale(0.9);
+
+      transition:
+        opacity 0.3s ease-out,
+        transform 0.3s ease-out,
+        display 0.3s allow-discrete,
+        overlay 0.3s allow-discrete;
+      transition-property: opacity, transform, display, overlay;
+      transition-duration: 0.3s;
+      transition-timing-function: ease-out;
+      transition-behavior: allow-discrete;
+    }
+
+    /* Visible (open) state */
+    dialog[open],
+    [popover]:popover-open {
+      opacity: 1;
+      transform: scale(1);
+
+      /* Entry starting state */
+      @starting-style {
+        opacity: 0;
+        transform: scale(0.9);
+      }
+    }
+
+    @starting-style {
+      dialog[open],
+      [popover]:popover-open {
+        opacity: 0;
+        transform: scale(0.9);
+      }
+    }
+
+    /* Backdrop animations */
+    dialog::backdrop,
+    [popover]::backdrop {
+      background-color: rgba(0, 0, 0, 0);
+      transition:
+        display 0.3s allow-discrete,
+        overlay 0.3s allow-discrete,
+        background-color 0.3s ease-out;
+      transition-behavior: allow-discrete;
+    }
+
+    dialog[open]::backdrop,
+    [popover]:popover-open::backdrop {
+      background-color: rgba(0, 0, 0, 0.5);
+
+      @starting-style {
+        background-color: rgba(0, 0, 0, 0);
+      }
+    }
+
+    @starting-style {
+      dialog[open]::backdrop,
+      [popover]:popover-open::backdrop {
+        background-color: rgba(0, 0, 0, 0);
+      }
+    }
+
+    /* Reduced Motion Support */
+    @media (prefers-reduced-motion: reduce) {
+      dialog,
+      [popover] {
+        transform: none;
+        transition-duration: 0.1s;
+      }
+
+      dialog[open],
+      [popover]:popover-open {
+        transform: none;
+
+        @starting-style {
+          transform: none;
+        }
+      }
+
+      @starting-style {
+        dialog[open],
+        [popover]:popover-open {
+          transform: none;
+        }
+      }
+    }
   </style>
