+  <script>
+    (function () {
+      const dialog = document.getElementById('rewards-dialog');
+      const openBtn = document.getElementById('open-rewards-dialog');
+
+      // Feature detection for native top-layer animations
+      const supportsTopLayerAnimation =
+        window.CSS &&
+        CSS.supports('transition-behavior', 'allow-discrete') &&
+        CSS.supports('overlay', 'auto');
+
+      function closeDialog() {
+        if (supportsTopLayerAnimation) {
+          // The CSS transition (including `overlay`/`display`) handles
+          // keeping the dialog visible in the top layer during exit.
+          dialog.close();
+          return;
+        }
+
+        // Manual JS fallback for browsers without top-layer animations:
+        // wait for the transition to finish before actually closing.
+        dialog.classList.add('is-closing');
+        dialog.addEventListener('transitionend', function onEnd() {
+          dialog.classList.remove('is-closing');
+          dialog.close();
+          dialog.removeEventListener('transitionend', onEnd);
+        });
+      }
+
+      openBtn.addEventListener('click', () => dialog.showModal());
+
+      dialog.addEventListener('click', (event) => {
+        if (event.target.closest('[data-close-dialog]')) {
+          event.preventDefault();
+          closeDialog();
+        }
+      });
+
+      dialog.addEventListener('submit', (event) => {
+        if (!supportsTopLayerAnimation) {
+          event.preventDefault();
+          closeDialog();
+        }
+      });
+    })();
+  </script>
+
