+  <script>
+    // Feature detection for native top-layer animation support.
+    const supportsTopLayerAnimation =
+      window.CSS &&
+      CSS.supports('transition-behavior', 'allow-discrete') &&
+      CSS.supports('overlay', 'auto');
+
+    const rewardsDialog = document.getElementById('rewards-dialog');
+    document.getElementById('open-rewards-dialog').addEventListener('click', () => {
+      rewardsDialog.showModal();
+    });
+
+    if (!supportsTopLayerAnimation) {
+      // Manual JS fallback: skip the transition and let the dialog/popover
+      // toggle instantly, since @starting-style/allow-discrete/overlay
+      // are unavailable in this browser.
+      rewardsDialog.style.transitionDuration = '0s';
+      document.getElementById('hours-popover').style.transitionDuration = '0s';
+    }
+  </script>
