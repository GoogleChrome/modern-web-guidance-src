+// Reorder Seasonal Favorites horizontal card row
+(function () {
+  'use strict';
+
+  const container = document.getElementById('seasonal-favorites');
+  const liveRegion = document.getElementById('reorder-live-region');
+  if (!container) return;
+
+  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+  // Announcement helper: debounced by ~500ms, clearing previous message first
+  let announceTimeout = null;
+  function announce(message) {
+    if (!liveRegion) return;
+    clearTimeout(announceTimeout);
+    liveRegion.textContent = '';
+    announceTimeout = setTimeout(() => {
+      liveRegion.textContent = message;
+    }, 500);
+  }
+
+  function getItemName(item) {
+    const heading = item.querySelector('h3, h2, [data-item-title]');
+    return heading ? heading.textContent.trim() : 'Item';
+  }
+
+  function getCards() {
+    return Array.from(container.children).filter((c) => c.classList.contains('card') || c.classList.contains('item'));
+  }
+
+  // Move node helper with feature detection and fallback
+  function moveNode(parent, node, refNode) {
+    if ('moveBefore' in Element.prototype) {
+      parent.moveBefore(node, refNode);
+    } else {
+      if (refNode) {
+        refNode.before(node);
+      } else {
+        parent.append(node);
+      }
+    }
+  }
+
+  // Operation ID tracker for quick re-grab
+  let dragOperationCount = 0;
+  const itemDragOperation = new WeakMap();
+
+  // Pointer drag state
+  let activePointerId = null;
+  let activeHandle = null;
+  let draggedItem = null;
+  let isDragging = false;
+  let startPointerX = 0;
+  let startPointerY = 0;
+  let dragStartScrollLeft = 0;
+  let dragStartScrollTop = 0;
+  let lastPointerClientX = 0;
+  let lastPointerClientY = 0;
+  let currentDropSpot = null;
+
+  // Auto-scroll state
+  let autoScrollRaf = null;
+  let lastFrameTime = 0;
+
+  function startAutoScroll() {
+    lastFrameTime = performance.now();
+    autoScrollRaf = requestAnimationFrame(autoScrollStep);
+  }
+
+  function stopAutoScroll() {
+    if (autoScrollRaf !== null) {
+      cancelAnimationFrame(autoScrollRaf);
+      autoScrollRaf = null;
+    }
+  }
+
+  function autoScrollStep(currentTime) {
+    if (!draggedItem || !isDragging) return;
+
+    const dt = Math.min((currentTime - lastFrameTime) / 1000, 0.1);
+    lastFrameTime = currentTime;
+
+    const containerRect = container.getBoundingClientRect();
+    const itemWidth = draggedItem.offsetWidth || 250;
+    const edgeZone = Math.min(itemWidth, container.clientWidth / 3);
+
+    const leftEdge = containerRect.left + container.clientLeft;
+    const rightEdge = leftEdge + container.clientWidth;
+
+    let scrollSpeed = 0;
+    const maxSpeed = 800;
+    const baseSpeed = 400;
+
+    if (lastPointerClientX < leftEdge + edgeZone) {
+      const distance = (leftEdge + edgeZone) - lastPointerClientX;
+      const ratio = Math.min(distance / edgeZone, 2.5);
+      scrollSpeed = -Math.min(maxSpeed, ratio * baseSpeed);
+    } else if (lastPointerClientX > rightEdge - edgeZone) {
+      const distance = lastPointerClientX - (rightEdge - edgeZone);
+      const ratio = Math.min(distance / edgeZone, 2.5);
+      scrollSpeed = Math.min(maxSpeed, ratio * baseSpeed);
+    }
+
+    if (scrollSpeed !== 0) {
+      const prevScroll = container.scrollLeft;
+      container.scrollLeft += scrollSpeed * dt;
+      const deltaScroll = container.scrollLeft - prevScroll;
+
+      if (deltaScroll !== 0) {
+        updateDraggedItemPosition(lastPointerClientX, lastPointerClientY);
+        updateDropSpot(lastPointerClientX);
+      }
+    }
+
+    autoScrollRaf = requestAnimationFrame(autoScrollStep);
+  }
+
+  function updateDraggedItemPosition(clientX, clientY) {
+    if (!draggedItem) return;
+    const scrollDeltaX = container.scrollLeft - dragStartScrollLeft;
+    const scrollDeltaY = container.scrollTop - dragStartScrollTop;
+    const totalTranslateX = (clientX - startPointerX) + scrollDeltaX;
+    const totalTranslateY = (clientY - startPointerY) + scrollDeltaY;
+    draggedItem.style.translate = `${totalTranslateX}px ${totalTranslateY}px`;
+  }
+
+  function findDropSpot(clientX) {
+    const isRtl = getComputedStyle(container).direction === 'rtl';
+    const containerRect = container.getBoundingClientRect();
+    const containerPaddingLeft = containerRect.left + container.clientLeft;
+    const clampedClientX = Math.max(
+      containerPaddingLeft,
+      Math.min(clientX, containerPaddingLeft + container.clientWidth)
+    );
+    const pointerX = (clampedClientX - containerPaddingLeft) + container.scrollLeft;
+
+    const siblings = getCards().filter((child) => child !== draggedItem);
+
+    if (isRtl) {
+      for (const sibling of siblings) {
+        const midpoint = sibling.offsetLeft + sibling.offsetWidth / 2;
+        if (pointerX >= midpoint) {
+          return sibling;
+        }
+      }
+      return null;
+    } else {
+      for (const sibling of siblings) {
+        const midpoint = sibling.offsetLeft + sibling.offsetWidth / 2;
+        if (pointerX < midpoint) {
+          return sibling;
+        }
+      }
+      return null;
+    }
+  }
+
+  function clearDropMarker() {
+    container.removeAttribute('data-drop');
+    container.style.removeProperty('--drop-x');
+    container.style.removeProperty('--drop-y');
+    container.style.removeProperty('--drop-w');
+    container.style.removeProperty('--drop-h');
+  }
+
+  function updateDropSpot(clientX) {
+    if (!draggedItem) return;
+
+    currentDropSpot = findDropSpot(clientX);
+
+    // Skip no-op drops: show no marker when drop spot is item's own slot
+    if (currentDropSpot === draggedItem.nextElementSibling) {
+      clearDropMarker();
+      return;
+    }
+
+    const siblings = getCards().filter((child) => child !== draggedItem);
+    let nextItem = null;
+    let prevItem = null;
+
+    if (currentDropSpot !== null) {
+      nextItem = currentDropSpot;
+      const idx = siblings.indexOf(nextItem);
+      prevItem = idx > 0 ? siblings[idx - 1] : null;
+    } else {
+      nextItem = null;
+      prevItem = siblings.length > 0 ? siblings[siblings.length - 1] : null;
+    }
+
+    const isRtl = getComputedStyle(container).direction === 'rtl';
+    const defaultGap = 20;
+    let dropX, dropY, dropH, dropW;
+
+    if (prevItem && nextItem) {
+      const prevRect = prevItem.getBoundingClientRect();
+      const nextRect = nextItem.getBoundingClientRect();
+      if (isRtl) {
+        dropW = Math.max(0, prevRect.left - nextRect.right);
+        dropX = nextRect.right + dropW / 2;
+      } else {
+        dropW = Math.max(0, nextRect.left - prevRect.right);
+        dropX = prevRect.right + dropW / 2;
+      }
+      dropY = Math.min(prevRect.top, nextRect.top);
+      dropH = Math.max(prevRect.bottom, nextRect.bottom) - dropY;
+    } else if (nextItem) {
+      const nextRect = nextItem.getBoundingClientRect();
+      dropW = defaultGap;
+      dropX = isRtl ? (nextRect.right + defaultGap / 2) : (nextRect.left - defaultGap / 2);
+      dropY = nextRect.top;
+      dropH = nextRect.height;
+    } else if (prevItem) {
+      const prevRect = prevItem.getBoundingClientRect();
+      dropW = defaultGap;
+      dropX = isRtl ? (prevRect.left - defaultGap / 2) : (prevRect.right + defaultGap / 2);
+      dropY = prevRect.top;
+      dropH = prevRect.height;
+    } else {
+      clearDropMarker();
+      return;
+    }
+
+    container.style.setProperty('--drop-x', `${dropX}px`);
+    container.style.setProperty('--drop-y', `${dropY}px`);
+    container.style.setProperty('--drop-w', `${dropW}px`);
+    container.style.setProperty('--drop-h', `${dropH}px`);
+    container.setAttribute('data-drop', '');
+  }
+
+  function cancelPointerDrag() {
+    if (!draggedItem) return;
+
+    stopAutoScroll();
+    clearDropMarker();
+    document.documentElement.classList.remove('is-dragging', 'dragging');
+
+    draggedItem.getAnimations().forEach((a) => a.finish());
+    const currentRect = draggedItem.getBoundingClientRect();
+    draggedItem.style.translate = '';
+
+    draggedItem.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+
+    const targetRect = draggedItem.getBoundingClientRect();
+    const deltaX = currentRect.left - targetRect.left;
+    const deltaY = currentRect.top - targetRect.top;
+
+    const itemToClean = draggedItem;
+    const currentDragId = ++dragOperationCount;
+    itemDragOperation.set(itemToClean, currentDragId);
+
+    if (!prefersReducedMotion && (Math.abs(deltaX) > 0.5 || Math.abs(deltaY) > 0.5)) {
+      const anim = itemToClean.animate([
+        { translate: `${deltaX}px ${deltaY}px` },
+        { translate: '0px 0px' }
+      ], {
+        duration: 250,
+        easing: 'cubic-bezier(0.2, 0, 0, 1)'
+      });
+      anim.onfinish = () => {
+        if (itemDragOperation.get(itemToClean) === currentDragId) {
+          itemToClean.classList.remove('is-dragged');
+        }
+      };
+    } else {
+      if (itemDragOperation.get(itemToClean) === currentDragId) {
+        itemToClean.classList.remove('is-dragged');
+      }
+    }
+
+    announce('Reorder cancelled.');
+
+    if (activeHandle && activePointerId !== null) {
+      try {
+        if (activeHandle.hasPointerCapture(activePointerId)) {
+          activeHandle.releasePointerCapture(activePointerId);
+        }
+      } catch (e) {}
+    }
+
+    draggedItem = null;
+    activeHandle = null;
+    activePointerId = null;
+    isDragging = false;
+    currentDropSpot = null;
+  }
+
+  // Pointer event handlers
+  function onPointerDown(event) {
+    if (event.button !== 0) return;
+    const handle = event.target.closest('.drag-handle, .handle');
+    if (!handle || !container.contains(handle)) return;
+
+    if (activePointerId !== null) return; // Follow one pointer
+
+    const card = handle.closest('.card, .item');
+    if (!card) return;
+
+    activePointerId = event.pointerId;
+    activeHandle = handle;
+    draggedItem = card;
+    isDragging = false;
+    startPointerX = event.clientX;
+    startPointerY = event.clientY;
+    dragStartScrollLeft = container.scrollLeft;
+    dragStartScrollTop = container.scrollTop;
+    lastPointerClientX = event.clientX;
+    lastPointerClientY = event.clientY;
+
+    try {
+      handle.setPointerCapture(event.pointerId);
+    } catch (e) {
+      // Ignore if setPointerCapture fails
+    }
+  }
