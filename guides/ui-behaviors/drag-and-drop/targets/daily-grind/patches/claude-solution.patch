+        try {
+          focusVisible = target.matches(':focus-visible');
+        } catch {
+          /* :focus-visible unsupported; assume keyboard focus */
+        }
+        if (!focusVisible || keyboard?.moving || drag) return;
+        const item = target.closest('.reorder-item');
+        if (!(item instanceof HTMLElement) || item.getAnimations().length > 0) return;
+        reveal(item);
+      });
+    })();
+  </script>
