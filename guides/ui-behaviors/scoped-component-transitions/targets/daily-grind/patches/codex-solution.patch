diff --git a/src/main.ts b/src/main.ts
new file mode 100644
index 0000000..5c4189a
--- /dev/null
+++ b/src/main.ts
@@ -0,0 +1,103 @@
+export {};
+
+interface ScopedTransition {
+  ready: Promise<void>;
+}
+
+// Element-scoped transitions are newer than the DOM declarations shipped by
+// TypeScript. Keep this local type optional so unsupported browsers still work.
+type TransitionScope = HTMLElement & {
+  startViewTransition?: (update: () => void) => ScopedTransition;
+};
+
+function requireElement<T extends HTMLElement>(
+  selector: string,
+  constructor: { new (): T },
+): T {
+  const element = document.querySelector(selector);
+  if (!(element instanceof constructor)) {
+    throw new Error(`Missing required element: ${selector}`);
+  }
+  return element;
+}
+
+function runScopedTransition(scope: TransitionScope, updateDOM: () => void): void {
+  const update = (): void => {
+    const focused = document.activeElement;
+    updateDOM();
+    // appendChild preserves identity but may blur a moved, focused descendant.
+    if (focused instanceof HTMLElement && scope.contains(focused)
+      && document.activeElement !== focused) {
+      focused.focus({ preventScroll: true });
+    }
+  };
+  if (typeof scope.startViewTransition !== 'function') {
+    update();
+    return;
+  }
+
+  const transition = scope.startViewTransition(update);
+  // Repeated actions on this scope can skip the previous animation.
+  transition.ready.catch(() => {});
+}
+
+const grid = requireElement('#favorites-grid', HTMLDivElement);
+const sortButton = requireElement('#sort-favorites', HTMLButtonElement);
+const reverseButton = requireElement('#reverse-favorites', HTMLButtonElement);
+const resetButton = requireElement('#reset-favorites', HTMLButtonElement);
+const status = requireElement('#favorites-status', HTMLParagraphElement);
+// Retain original nodes, including removed cards, for identity-preserving reset.
+const originalCards = Array.from(grid.querySelectorAll<HTMLElement>('.card'));
+
+function visibleCards(): HTMLElement[] {
+  return Array.from(grid.children).filter((child): child is HTMLElement =>
+    child instanceof HTMLElement && child.classList.contains('card'),
+  );
+}
+
+function announce(message: string): void {
+  const count = grid.childElementCount;
+  status.textContent = count === 0
+    ? `${message} No favorites shown. Use Reset favorites to restore them.`
+    : `${message} ${count} ${count === 1 ? 'favorite' : 'favorites'} shown.`;
+}
+
+sortButton.addEventListener('click', () => {
+  runScopedTransition(grid, () => {
+    const cards = visibleCards().sort((a, b) =>
+      (a.dataset.name ?? '').localeCompare(b.dataset.name ?? ''),
+    );
+    for (const card of cards) grid.appendChild(card);
+    announce('Sorted A–Z.');
+  });
+});
+
+reverseButton.addEventListener('click', () => {
+  runScopedTransition(grid, () => {
+    for (const card of visibleCards().reverse()) grid.appendChild(card);
+    announce('Order reversed.');
+  });
+});
+
+resetButton.addEventListener('click', () => {
+  runScopedTransition(grid, () => {
+    for (const card of originalCards) grid.appendChild(card);
+    announce('Favorites restored.');
+  });
+});
+
+for (const card of originalCards) {
+  const removeButton = card.querySelector<HTMLButtonElement>('.remove-favorite');
+  removeButton?.addEventListener('click', () => {
+    // The whole grid is the scope, so its height also animates on removal.
+    runScopedTransition(grid, () => {
+      if (card.parentElement !== grid) return;
+      const hadFocus = card.contains(document.activeElement);
+      const adjacentCard = card.nextElementSibling ?? card.previousElementSibling;
+      const focusTarget = adjacentCard?.querySelector<HTMLElement>('button, a[href]') ?? resetButton;
+      card.remove();
+      if (hadFocus) focusTarget.focus();
+      announce(`${card.dataset.name ?? 'Favorite'} removed.`);
+    });
+  });
+}
