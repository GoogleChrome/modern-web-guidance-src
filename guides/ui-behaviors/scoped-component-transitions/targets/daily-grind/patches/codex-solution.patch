+// @ts-check
+export {};
+
+/** @typedef {{ ready: Promise<void>, updateCallbackDone: Promise<void>, finished: Promise<void> }} ScopedTransition */
+/** @typedef {HTMLElement & { startViewTransition?: (update: () => void) => ScopedTransition }} ScopedElement */
+
+/**
+ * Only the supplied component is captured. Never fall back to a document transition.
+ * @param {HTMLElement} scope
+ * @param {() => void} update
+ */
+function runScopedTransition(scope, update) {
+  const element = /** @type {ScopedElement} */ (scope);
+  if (!('startViewTransition' in Element.prototype) ||
+      typeof element.startViewTransition !== 'function' ||
+      window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+    update();
+    return;
+  }
+  const transition = element.startViewTransition(update);
+  // A new interaction can skip the previous animation on this same scope.
+  void transition.ready.catch(() => {});
+  void transition.finished.catch(() => {});
+  void transition.updateCallbackDone.catch((error) => console.error('Could not update favorites', error));
+}
+
+const list = document.querySelector('#favorites-list');
+const restore = document.querySelector('#restore-favorites');
+const status = document.querySelector('#favorites-status');
+
+if (list instanceof HTMLElement && restore instanceof HTMLButtonElement && status instanceof HTMLElement) {
+  const originalCards = Array.from(list.querySelectorAll('.card-wrapper'));
+
+  function refreshControls() {
+    if (!(list instanceof HTMLElement) || !(restore instanceof HTMLButtonElement)) return;
+    const cards = Array.from(list.children);
+    cards.forEach((card, index) => {
+      const earlier = card.querySelector('[data-action="earlier"]');
+      const later = card.querySelector('[data-action="later"]');
+      if (earlier instanceof HTMLButtonElement) earlier.disabled = index === 0;
+      if (later instanceof HTMLButtonElement) later.disabled = index === cards.length - 1;
+    });
+    restore.disabled = cards.length === originalCards.length;
+  }
+
+  list.addEventListener('click', (event) => {
+    if (!(event.target instanceof Element)) return;
+    const button = event.target.closest('button');
+    const card = button?.closest('.card-wrapper');
+    if (!(button instanceof HTMLButtonElement) || !(card instanceof HTMLElement)) return;
+    const action = button.dataset.action;
+    if (action === 'temperature') {
+      const scope = button.closest('.drink-customization');
+      const label = scope?.querySelector('.drink-temperature');
+      if (!(scope instanceof HTMLElement) || !label) return;
+      runScopedTransition(scope, () => {
+        const temperature = label.textContent === 'Served hot' ? 'iced' : 'hot';
+        const next = temperature === 'hot' ? 'iced' : 'hot';
+        label.textContent = `Served ${temperature}`;
+        button.textContent = `Serve ${next}`;
+        button.setAttribute('aria-label', `Serve ${card.dataset.drink} ${next}`);
+      });
+      return;
+    }
+    if (action !== 'remove' && action !== 'earlier' && action !== 'later') return;
+    runScopedTransition(list, () => {
+      // Resolve neighbors in the callback so rapid interactions use the current order.
+      if (card.parentElement !== list) return;
+      const hadFocus = card.contains(document.activeElement);
+      if (action === 'remove') {
+        const neighbor = card.nextElementSibling ?? card.previousElementSibling;
+        card.remove();
+        refreshControls();
+        if (hadFocus) {
+          const target = neighbor?.querySelector('button:not(:disabled)');
+          if (target instanceof HTMLElement) target.focus();
+          else restore.focus();
+        }
+        status.textContent = list.children.length
+          ? `${card.dataset.drink} removed.`
+          : 'All drinks removed. Use Restore removed drinks to bring them back.';
+      } else {
+        const neighbor = action === 'earlier' ? card.previousElementSibling : card.nextElementSibling;
+        if (!neighbor) return;
+        if (action === 'earlier') list.insertBefore(card, neighbor);
+        else list.insertBefore(neighbor, card);
+        refreshControls();
+        if (hadFocus) {
+          const target = button.disabled ? card.querySelector('button:not(:disabled)') : button;
+          if (target instanceof HTMLElement) target.focus();
+        }
+        status.textContent = `${card.dataset.drink} moved ${action}.`;
+      }
+    });
+  });
+
+  restore.addEventListener('click', () => {
+    runScopedTransition(list, () => {
+      // Keep node identity and each drink's customization when restoring.
+      for (const card of originalCards) {
+        if (card.parentElement !== list) list.appendChild(card);
+      }
+      const hadFocus = document.activeElement === restore;
+      refreshControls();
+      if (hadFocus) list.querySelector('button')?.focus();
+      status.textContent = 'All seasonal drinks restored.';
+    });
+  });
+  refreshControls();
+}
