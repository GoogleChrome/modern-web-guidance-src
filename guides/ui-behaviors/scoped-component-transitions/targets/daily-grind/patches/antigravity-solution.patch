+  <script>
+    // Feature detection specifically on Element.prototype or the target Element instance (not document.startViewTransition)
+    const supportsScopedTransition = typeof Element !== 'undefined' && 'startViewTransition' in Element.prototype;
+
+    /**
+     * Runs an element-scoped view transition.
+     * Wraps DOM updates in scopeEl.startViewTransition() rather than document.startViewTransition().
+     * Performs feature detection on Element.prototype or the target Element instance.
+     * If unsupported, executes the updateDOM callback immediately as a fallback without throwing an error.
+     */
+    function runScopedTransition(scopeEl, updateDOM) {
+      const isSupported = (typeof Element !== 'undefined' && 'startViewTransition' in Element.prototype) ||
+        (typeof scopeEl?.startViewTransition === 'function');
+
+      if (!isSupported || typeof scopeEl?.startViewTransition !== 'function') {
+        updateDOM();
+        return;
+      }
+
+      const transition = scopeEl.startViewTransition(() => {
+        updateDOM();
+      });
+
+      transition?.ready?.catch?.(() => {});
+      return transition;
+    }
+
+    function runWithTransition(scopeEl, updateDOM) {
+      return runScopedTransition(scopeEl, updateDOM);
+    }
+
+    /**
+     * Reorders items by moving existing DOM nodes rather than recreating them from scratch.
+     */
+    function reorderItems(listEl, orderedIds) {
+      const targetEl = typeof listEl === 'string' ? document.querySelector(listEl) : listEl;
+      if (!targetEl) return;
+
+      const existing = new Map(
+        Array.from(targetEl.children, (li) => [li.dataset.id || li.id, li])
+      );
+
+      runScopedTransition(targetEl, () => {
+        for (const id of orderedIds) {
+          const li = existing.get(id);
+          if (li) {
+            targetEl.appendChild(li);
+          }
+        }
+      });
+    }
+
+    /**
+     * Removes an item while preserving keyboard focus.
+     */
+    function removeItem(cardEl, itemEl) {
+      const targetCard = typeof cardEl === 'string' ? document.querySelector(cardEl) : cardEl;
+      const targetItem = typeof itemEl === 'string' ? document.querySelector(itemEl) : itemEl;
+      if (!targetCard || !targetItem) return;
+
+      const hadFocus = targetItem.contains(document.activeElement);
+      const nextFocusTarget =
+        targetItem.nextElementSibling?.querySelector('button, a') ??
+        targetItem.previousElementSibling?.querySelector('button, a') ??
+        targetCard.querySelector('button, a');
+
+      runScopedTransition(targetCard, () => {
+        targetItem.remove();
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    /**
+     * Updates an item preserving existing DOM nodes.
+     */
+    function updateItem(containerEl, idOrEl, updateFnOrData) {
+      const targetContainer = typeof containerEl === 'string' ? document.querySelector(containerEl) : containerEl;
+      if (!targetContainer) return;
+
+      const targetEl = (typeof idOrEl === 'object' && idOrEl instanceof Element)
+        ? idOrEl
+        : targetContainer.querySelector(`[data-id="${idOrEl}"], #${idOrEl}`);
+      if (!targetEl) return;
+
+      runScopedTransition(targetContainer, () => {
+        if (typeof updateFnOrData === 'function') {
+          updateFnOrData(targetEl);
+        } else if (typeof updateFnOrData === 'object' && updateFnOrData !== null) {
+          if (updateFnOrData.title) {
+            const title = targetEl.querySelector('h3');
+            if (title) title.textContent = updateFnOrData.title;
+          }
+          if (updateFnOrData.desc) {
+            const desc = targetEl.querySelector('p');
+            if (desc) desc.textContent = updateFnOrData.desc;
+          }
+        }
+      });
+    }
+
+    // Expose helpers globally
+    if (typeof window !== 'undefined') {
+      window.supportsScopedTransition = supportsScopedTransition;
+      window.runScopedTransition = runScopedTransition;
+      window.runWithTransition = runWithTransition;
+      window.reorderItems = reorderItems;
+      window.removeItem = removeItem;
+      window.updateItem = updateItem;
+    }
+
+    function setupSeasonalFavorites() {
+      const gridEl = document.getElementById('favorites-grid');
+      if (!gridEl) return;
+
+      const initialIds = Array.from(gridEl.children, (el) => el.dataset.id || el.id);
+
+      const btnReorder = document.getElementById('btn-reorder');
+      if (btnReorder) {
+        btnReorder.addEventListener('click', () => {
+          const currentIds = Array.from(gridEl.children, (el) => el.dataset.id || el.id);
+          const shuffled = [...currentIds].sort(() => Math.random() - 0.5);
+          reorderItems(gridEl, shuffled);
+        });
+      }
+
+      const btnSort = document.getElementById('btn-sort');
+      if (btnSort) {
+        btnSort.addEventListener('click', () => {
+          const sortedIds = Array.from(gridEl.children)
+            .sort((a, b) => {
+              const titleA = a.querySelector('h3')?.textContent || '';
+              const titleB = b.querySelector('h3')?.textContent || '';
+              return titleA.localeCompare(titleB);
+            })
+            .map((el) => el.dataset.id || el.id);
+          reorderItems(gridEl, sortedIds);
+        });
+      }
+
+      const btnReverse = document.getElementById('btn-reverse');
+      if (btnReverse) {
+        btnReverse.addEventListener('click', () => {
+          const reversedIds = Array.from(gridEl.children, (el) => el.dataset.id || el.id).reverse();
+          reorderItems(gridEl, reversedIds);
+        });
+      }
+
+      const btnReset = document.getElementById('btn-reset');
+      if (btnReset) {
+        btnReset.addEventListener('click', () => {
+          reorderItems(gridEl, initialIds);
+        });
+      }
+
+      gridEl.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.btn-remove');
+        if (removeBtn) {
+          const cardEl = removeBtn.closest('.card');
+          if (cardEl) {
+            removeItem(gridEl, cardEl);
+          }
+        }
+      });
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', setupSeasonalFavorites);
+    } else {
+      setupSeasonalFavorites();
+    }
+  </script>
+
