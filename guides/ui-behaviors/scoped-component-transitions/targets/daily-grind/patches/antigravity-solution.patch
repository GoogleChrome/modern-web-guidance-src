+  <script>
+    // Feature detect specifically on Element.prototype (not document.startViewTransition)
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM();
+        return;
+      }
+
+      // Call startViewTransition on the component element, not document
+      const transition = scopeEl.startViewTransition(() => {
+        updateDOM();
+      });
+
+      // Re-triggering startViewTransition() on the same element skips the active transition
+      // and rejects `ready`. Catch the rejection to avoid unhandled promise rejection errors.
+      transition.ready.catch(() => {});
+    }
+
+    // Reorder child items by moving existing DOM nodes (required for `match-element`)
+    function reorderItems(listEl, orderedIds) {
+      const existing = new Map(
+        Array.from(listEl.children, (el) => [el.dataset.id, el])
+      );
+
+      runScopedTransition(listEl, () => {
+        for (const id of orderedIds) {
+          const item = existing.get(id);
+          if (item) listEl.appendChild(item);
+        }
+      });
+    }
+
+    // Remove an item while preserving exit animation and keyboard focus
+    // Scope to the outer container (`cardEl` or `sectionEl`) so its height/geometry also transitions smoothly
+    function removeItem(scopeEl, itemEl) {
+      const hadFocus = itemEl.contains(document.activeElement);
+      const nextFocusTarget =
+        itemEl.nextElementSibling?.querySelector('button') ??
+        itemEl.previousElementSibling?.querySelector('button') ??
+        scopeEl.querySelector('button');
+
+      runScopedTransition(scopeEl, () => {
+        itemEl.remove();
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    const seasonalSection = document.getElementById('seasonal-favorites');
+    const seasonalGrid = document.getElementById('seasonal-grid');
+
+    // Global card reordering controls
+    document.getElementById('sort-drinks-az')?.addEventListener('click', () => {
+      if (!seasonalGrid) return;
+      const orderedIds = Array.from(seasonalGrid.children)
+        .sort((a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || ''))
+        .map((el) => el.dataset.id);
+      reorderItems(seasonalGrid, orderedIds);
+    });
+
+    document.getElementById('reverse-drinks')?.addEventListener('click', () => {
+      if (!seasonalGrid) return;
+      const orderedIds = Array.from(seasonalGrid.children)
+        .reverse()
+        .map((el) => el.dataset.id);
+      reorderItems(seasonalGrid, orderedIds);
+    });
+
+    // Event delegation for card and customization item actions
+    seasonalSection?.addEventListener('click', (event) => {
+      const target = event.target.closest('button');
+      if (!target) return;
+
+      // 1. Reverse customization items inside a single drink card (scoped to `ul.customizations-list`)
+      if (target.classList.contains('reverse-items-btn')) {
+        const cardEl = target.closest('.card');
+        const listEl = cardEl?.querySelector('.customizations-list');
+        if (!listEl) return;
+        const orderedIds = Array.from(listEl.children)
+          .reverse()
+          .map((li) => li.dataset.id);
+        reorderItems(listEl, orderedIds);
+        return;
+      }
+
+      // 2. Move customization item up/down inside a drink card (scoped to `ul.customizations-list`)
+      if (target.classList.contains('move-item-up') || target.classList.contains('move-item-down')) {
+        const itemEl = target.closest('li');
+        const listEl = itemEl?.closest('.customizations-list');
+        if (!itemEl || !listEl) return;
+
+        const isUp = target.classList.contains('move-item-up');
+        const sibling = isUp ? itemEl.previousElementSibling : itemEl.nextElementSibling;
+        if (!sibling) return;
+
+        const hadFocus = itemEl.contains(document.activeElement);
+        const focusedEl = document.activeElement;
+
+        runScopedTransition(listEl, () => {
+          if (isUp) {
+            listEl.insertBefore(itemEl, sibling);
+          } else {
+            listEl.insertBefore(sibling, itemEl);
+          }
+          if (hadFocus && focusedEl instanceof HTMLElement) {
+            focusedEl.focus();
+          }
+        });
+        return;
+      }
+
+      // 3. Remove customization item inside a drink card (scoped to `.card` so card height animates)
+      if (target.classList.contains('remove-item-btn') && !target.classList.contains('remove-card-btn')) {
+        const itemEl = target.closest('li');
+        const cardEl = target.closest('.card');
+        if (itemEl && cardEl) {
+          removeItem(cardEl, itemEl);
+        }
+        return;
+      }
+
+      // 4. Move drink card left/right in the grid (scoped to `#seasonal-grid`)
+      if (target.classList.contains('move-card-prev') || target.classList.contains('move-card-next')) {
+        const wrapperEl = target.closest('.card-wrapper');
+        if (!wrapperEl || !seasonalGrid) return;
+
+        const isPrev = target.classList.contains('move-card-prev');
+        const sibling = isPrev ? wrapperEl.previousElementSibling : wrapperEl.nextElementSibling;
+        if (!sibling) return;
+
+        const hadFocus = wrapperEl.contains(document.activeElement);
+        const focusedEl = document.activeElement;
+
+        runScopedTransition(seasonalGrid, () => {
+          if (isPrev) {
+            seasonalGrid.insertBefore(wrapperEl, sibling);
+          } else {
+            seasonalGrid.insertBefore(sibling, wrapperEl);
+          }
+          if (hadFocus && focusedEl instanceof HTMLElement) {
+            focusedEl.focus();
+          }
+        });
+        return;
+      }
+
+      // 5. Remove drink card from the Seasonal Favorites section (scoped to `#seasonal-favorites`)
+      if (target.classList.contains('remove-card-btn')) {
+        const wrapperEl = target.closest('.card-wrapper');
+        if (wrapperEl && seasonalSection) {
+          removeItem(seasonalSection, wrapperEl);
+        }
+        return;
+      }
+    });
+  </script>
