+  <script>
+    (() => {
+      'use strict';
+
+      // Feature detect element-scoped view transitions specifically (not document.startViewTransition).
+      const supportsScopedTransition =
+        typeof Element !== 'undefined' && 'startViewTransition' in Element.prototype;
+
+      /**
+       * Run a DOM update as a view transition scoped to `scopeEl`, so the sticky nav and
+       * the rest of the page stay interactive and other scopes can transition concurrently.
+       * @param {HTMLElement} scopeEl
+       * @param {() => void} updateDOM
+       */
+      function runScopedTransition(scopeEl, updateDOM) {
+        if (!supportsScopedTransition) {
+          // Fallback: apply the update immediately, without animation.
+          updateDOM();
+          return;
+        }
+        const transition = scopeEl.startViewTransition(() => {
+          updateDOM();
+        });
+        // Rapid re-triggers on the same scope skip the active transition and reject `ready`.
+        transition.ready.catch(() => {});
+      }
+
+      const grid = document.getElementById('favorites-grid');
+      const emptyNote = document.getElementById('favorites-empty');
+      const resetBtn = document.getElementById('favorites-reset');
+      if (!(grid instanceof HTMLUListElement) || !(resetBtn instanceof HTMLButtonElement)) return;
+
+      // Keep the original nodes (and order) so "Restore" can re-insert the same DOM nodes,
+      // preserving identity for `view-transition-name: match-element`.
+      /** @type {HTMLElement[]} */
+      const originalCards = Array.from(grid.children).filter(
+        (el) => el instanceof HTMLElement,
+      );
+      /** @type {Map<HTMLElement, HTMLElement[]>} */
+      const originalItems = new Map();
+      for (const wrapper of originalCards) {
+        const list = wrapper.querySelector('.customizations');
+        if (list) {
+          originalItems.set(
+            wrapper,
+            Array.from(list.children).filter((el) => el instanceof HTMLElement),
+          );
+        }
+      }
+
+      /** @param {HTMLElement} card */
+      function syncCardState(card) {
+        const list = card.querySelector('.customizations');
+        const note = card.querySelector('.classic-note');
+        if (!(list instanceof HTMLElement)) return;
+        const items = Array.from(list.children);
+        items.forEach((item, index) => {
+          const up = item.querySelector('[data-action="item-up"]');
+          if (up instanceof HTMLButtonElement) up.disabled = index === 0;
+        });
+        list.hidden = items.length === 0;
+        if (note instanceof HTMLElement) note.hidden = items.length !== 0;
+      }
+
+      function syncGridState() {
+        const wrappers = Array.from(grid.children);
+        wrappers.forEach((wrapper, index) => {
+          const left = wrapper.querySelector('[data-action="card-left"]');
+          const right = wrapper.querySelector('[data-action="card-right"]');
+          if (left instanceof HTMLButtonElement) left.disabled = index === 0;
+          if (right instanceof HTMLButtonElement) right.disabled = index === wrappers.length - 1;
+        });
+        if (emptyNote) emptyNote.hidden = wrappers.length !== 0;
+      }
+
+      /**
+       * Moving a node in the DOM drops focus; restore it (or a sensible sibling) afterwards.
+       * @param {Element | null} previous
+       * @param {Element | null} container
+       * @param {string[]} fallbackSelectors
+       */
+      function restoreFocus(previous, container, fallbackSelectors) {
+        if (!(previous instanceof HTMLElement) || document.activeElement === previous) return;
+        if (previous instanceof HTMLButtonElement && previous.disabled && container) {
+          for (const selector of fallbackSelectors) {
+            const candidate = container.querySelector(selector);
+            if (candidate instanceof HTMLButtonElement && !candidate.disabled) {
+              candidate.focus();
+              return;
+            }
+          }
+        }
+        previous.focus();
+      }
+
+      /** @param {HTMLElement} wrapper @param {-1 | 1} direction */
+      function moveCard(wrapper, direction) {
+        const sibling =
+          direction < 0 ? wrapper.previousElementSibling : wrapper.nextElementSibling;
+        if (!sibling) return;
+        const focused = document.activeElement;
+        // Scope to the grid: only card order changes, so the nav and page stay interactive.
+        runScopedTransition(grid, () => {
+          if (direction < 0) grid.insertBefore(wrapper, sibling);
+          else grid.insertBefore(sibling, wrapper);
+          syncGridState();
+          if (wrapper.contains(focused)) {
+            restoreFocus(focused, wrapper, [
+              '[data-action="card-left"]',
+              '[data-action="card-right"]',
+              '[data-action="card-remove"]',
+            ]);
+          }
+        });
+      }
+
+      /** @param {HTMLElement} wrapper */
+      function removeCard(wrapper) {
+        const hadFocus = wrapper.contains(document.activeElement);
+        const nextFocusTarget =
+          wrapper.nextElementSibling?.querySelector('[data-action="card-remove"]') ??
+          wrapper.previousElementSibling?.querySelector('[data-action="card-remove"]') ??
+          resetBtn;
+        runScopedTransition(grid, () => {
+          wrapper.remove();
+          syncGridState();
+          if (hadFocus && nextFocusTarget instanceof HTMLElement) nextFocusTarget.focus();
+        });
+      }
+
+      /** @param {HTMLElement} card @param {HTMLElement} item */
+      function moveItemUp(card, item) {
+        const list = item.parentElement;
+        const prev = item.previousElementSibling;
+        if (!list || !prev) return;
+        const focused = document.activeElement;
+        // Scope to this card only, so other cards can transition at the same time.
+        runScopedTransition(card, () => {
+          list.insertBefore(item, prev);
+          syncCardState(card);
+          if (item.contains(focused)) {
+            restoreFocus(focused, item, ['[data-action="item-remove"]']);
+          }
+        });
+      }
+
+      /** @param {HTMLElement} card @param {HTMLElement} item */
+      function removeItem(card, item) {
+        const hadFocus = item.contains(document.activeElement);
+        const nextFocusTarget =
+          item.nextElementSibling?.querySelector('[data-action="item-remove"]') ??
+          item.previousElementSibling?.querySelector('[data-action="item-remove"]') ??
+          card.querySelector('[data-action="card-remove"]');
+        // Scope to the whole card so its height change animates alongside the list.
+        runScopedTransition(card, () => {
+          item.remove();
+          syncCardState(card);
+          if (hadFocus && nextFocusTarget instanceof HTMLElement) nextFocusTarget.focus();
+        });
+      }
+
+      function restoreFavorites() {
+        runScopedTransition(grid, () => {
+          for (const wrapper of originalCards) {
+            const list = wrapper.querySelector('.customizations');
+            const items = originalItems.get(wrapper);
+            if (list && items) {
+              for (const item of items) list.appendChild(item);
+            }
+            const card = wrapper.querySelector('.card');
+            if (card instanceof HTMLElement) syncCardState(card);
+            grid.appendChild(wrapper);
+          }
+          syncGridState();
+        });
+      }
+
+      grid.addEventListener('click', (event) => {
+        const target = event.target;
+        if (!(target instanceof Element)) return;
+        const button = target.closest('button[data-action]');
+        if (!(button instanceof HTMLButtonElement) || button.disabled) return;
+        const wrapper = button.closest('.card-wrapper');
+        const card = button.closest('.card');
+        if (!(wrapper instanceof HTMLElement) || !(card instanceof HTMLElement)) return;
+        const item = button.closest('.customization');
+
+        switch (button.dataset.action) {
+          case 'card-left':
+            moveCard(wrapper, -1);
+            break;
+          case 'card-right':
+            moveCard(wrapper, 1);
+            break;
+          case 'card-remove':
+            removeCard(wrapper);
+            break;
+          case 'item-up':
+            if (item instanceof HTMLElement) moveItemUp(card, item);
+            break;
+          case 'item-remove':
+            if (item instanceof HTMLElement) removeItem(card, item);
+            break;
+        }
+      });
+
+      resetBtn.addEventListener('click', restoreFavorites);
+
+      for (const wrapper of originalCards) {
+        const card = wrapper.querySelector('.card');
+        if (card instanceof HTMLElement) syncCardState(card);
+      }
+      syncGridState();
+    })();
+  </script>
 </body>
 
