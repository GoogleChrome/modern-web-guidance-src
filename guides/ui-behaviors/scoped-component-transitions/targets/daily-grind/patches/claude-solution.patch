+  <script>
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    function runWithTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM();
+        return;
+      }
+      const transition = scopeEl.startViewTransition(() => {
+        updateDOM();
+      });
+      transition.ready.catch(() => {});
+    }
+
+    const grid = document.getElementById('favorites');
+    const originalOrder = Array.from(grid.children);
+
+    // Reorder by moving existing nodes (required for match-element)
+    function reorder(cards) {
+      runWithTransition(grid, () => {
+        for (const card of cards) {
+          if (card.isConnected) grid.appendChild(card);
+        }
+      });
+    }
+
+    document.getElementById('sort-btn').addEventListener('click', () => {
+      const sorted = Array.from(grid.children).sort((a, b) =>
+        a.querySelector('h3').textContent.localeCompare(b.querySelector('h3').textContent));
+      reorder(sorted);
+    });
+
+    document.getElementById('reset-btn').addEventListener('click', () => {
+      reorder(originalOrder);
+    });
+
+    grid.addEventListener('click', (e) => {
+      const btn = e.target.closest('.remove-btn');
+      if (!btn) return;
+      const card = btn.closest('.card');
+      const next = card.nextElementSibling?.querySelector('button') ??
+        card.previousElementSibling?.querySelector('button') ??
+        document.getElementById('sort-btn');
+      const hadFocus = card.contains(document.activeElement);
+      runWithTransition(grid, () => {
+        card.remove();
+        if (hadFocus) next.focus();
+      });
+    });
+  </script>
