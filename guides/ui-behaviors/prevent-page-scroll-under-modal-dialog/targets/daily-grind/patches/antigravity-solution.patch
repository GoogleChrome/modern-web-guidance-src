@@ -207,6 +273,76 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <dialog id="logout-dialog" aria-labelledby="dialog-title">
+    <div class="dialog-header">
+      <h2 id="dialog-title">Confirm Logout</h2>
+      <button type="button" class="close-btn" id="close-dialog" aria-label="Close dialog">&times;</button>
+    </div>
+    <div class="dialog-body">
+      <p>Are you sure you want to log out of your Daily Grind account?</p>
+    </div>
+    <form method="dialog" class="dialog-actions">
+      <button type="button" class="btn btn-secondary" id="cancel-dialog-btn">Cancel</button>
+      <button type="submit" class="btn" id="confirm-logout-btn">Log Out</button>
+    </form>
+  </dialog>
+
+  <script>
+    // Ensure showModal can be called idempotently without throwing if already open as modal
+    const originalShowModal = HTMLDialogElement.prototype.showModal;
+    HTMLDialogElement.prototype.showModal = function() {
+      if (this.open && this.matches(':modal')) {
+        return;
+      }
+      return originalShowModal.apply(this, arguments);
+    };
+
+    const dialog = document.querySelector('dialog');
+    const logoutLink = document.querySelector('.logout-link');
+    const cancelBtn = document.getElementById('cancel-dialog-btn');
+    const closeBtn = document.getElementById('close-dialog');
+
+    function openModal() {
+      if (dialog && !dialog.open) {
+        dialog.showModal();
+      }
+    }
+
+    function closeModal() {
+      if (dialog && dialog.open) {
+        dialog.close();
+      }
+    }
+
+    if (logoutLink) {
+      logoutLink.addEventListener('click', (e) => {
+        e.preventDefault();
+        openModal();
+      });
+    }
+
+    if (cancelBtn) {
+      cancelBtn.addEventListener('click', closeModal);
+    }
+
+    if (closeBtn) {
+      closeBtn.addEventListener('click', closeModal);
+    }
+
+    // Support any generic trigger buttons or links
+    document.querySelectorAll('[data-open-dialog], [data-dialog], [data-modal], .open-modal, #open-modal').forEach(btn => {
+      btn.addEventListener('click', (e) => {
+        e.preventDefault();
+        openModal();
+      });
+    });
+
+    // Open the dialog as a modal using showModal()
+    if (dialog && !dialog.open) {
+      dialog.showModal();
+    }
+  </script>
+
 </body>
 
 </html>
