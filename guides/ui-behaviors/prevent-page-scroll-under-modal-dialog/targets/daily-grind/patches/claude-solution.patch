@@ -152,6 +152,59 @@
       text-decoration: none;
       font-size: 0.85rem;
     }
+
+    /* Seasonal Patio Notice (modal dialog) */
+    .patio-notice {
+      max-width: min(480px, 90vw);
+      max-height: 85vh;
+      margin: auto;
+      padding: 30px;
+      border: none;
+      border-radius: 8px;
+      color: var(--text);
+      background: white;
+      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
+      text-align: center;
+    }
+
+    dialog:modal {
+      /* Keep scroll gestures inside the modal (even when its content does not
+         overflow) from chaining to the page underneath. */
+      overscroll-behavior: contain;
+    }
+
+    dialog::backdrop {
+      background: rgba(0, 0, 0, 0.6);
+      /* ::backdrop defaults to overflow: visible (not a scroll container).
+         overflow: hidden makes it a non-scrollable scroll container so that
+         overscroll-behavior applies and scrolling over it is trapped. */
+      overflow: hidden;
+      overscroll-behavior: contain;
+    }
+
+    .patio-notice h2 {
+      color: var(--primary);
+      margin-bottom: 10px;
+    }
+
+    .patio-notice p {
+      margin-bottom: 10px;
+    }
+
+    .patio-notice form {
+      margin: 0;
+    }
+
+    .patio-notice button.btn {
+      border: none;
+      font: inherit;
+      cursor: pointer;
+    }
+
+    .patio-notice button.btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
   </style>
 </head>
 
@@ -207,6 +260,25 @@
