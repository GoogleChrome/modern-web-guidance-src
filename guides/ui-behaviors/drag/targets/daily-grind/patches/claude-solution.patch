+      <button type="button" data-move="dock-bottom-left">Dock bottom left</button>
+      <button type="button" data-move="dock-bottom-right">Dock bottom right</button>
+      <button type="button" data-move="left">Move left</button>
+      <button type="button" data-move="right">Move right</button>
+      <button type="button" data-move="up">Move up</button>
+      <button type="button" data-move="down">Move down</button>
+    </div>
+
+    <form class="quick-order-body" id="quick-order-form" action="/order-online" method="get">
+      <label>Drink
+        <select name="drink" id="qo-drink">
+          <option value="maple-oat-latte" data-price="5.25">Maple Oat Latte &ndash; $5.25</option>
+          <option value="dark-roast-espresso" data-price="3.50">Dark Roast Espresso &ndash; $3.50</option>
+          <option value="cold-brew" data-price="4.75">Cold Brew &ndash; $4.75</option>
+        </select>
+      </label>
+      <div class="quick-order-row">
+        <label>Size
+          <select name="size" id="qo-size">
+            <option value="small" data-extra="0">Small</option>
+            <option value="medium" data-extra="0.50" selected>Medium (+$0.50)</option>
+            <option value="large" data-extra="1.00">Large (+$1.00)</option>
+          </select>
+        </label>
+        <label>Quantity
+          <input type="number" name="qty" id="qo-qty" min="1" max="20" value="1" inputmode="numeric">
+        </label>
+      </div>
+      <button type="submit" class="btn" id="qo-add">Order this drink</button>
+      <ul class="cart-list" id="qo-cart" aria-label="Your cart" hidden></ul>
