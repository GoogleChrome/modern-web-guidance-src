+  <aside class="quick-order" id="quick-order" data-draggable aria-labelledby="quick-order-title">
+    <div class="quick-order-header">
+      <h2 id="quick-order-title">Quick Order</h2>
+      <div class="drag-tools" hidden>
+        <button type="button" class="panel-icon-btn" id="quick-order-help-toggle" aria-expanded="false"
+          aria-controls="quick-order-help" aria-label="Show how to move the quick order panel">?</button>
+        <button type="button" class="panel-icon-btn" id="quick-order-move-toggle" aria-expanded="false"
+          aria-controls="quick-order-move" aria-label="Move quick order panel options">Move</button>
+        <button type="button" class="panel-icon-btn drag-handle" data-drag-handle
+          aria-label="Quick order panel handle. Use arrow keys to move.">&#8942;&#8942;</button>
