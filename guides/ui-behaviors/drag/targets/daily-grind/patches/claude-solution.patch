+
+  <div class="visually-hidden" aria-live="polite" id="quick-order-status"></div>
+
+  <script>
+    (function () {
+      const panel = document.querySelector('[data-draggable]');
+      if (!(panel instanceof HTMLElement)) return;
+      const handle = panel.querySelector('[data-drag-handle]');
+      const tools = panel.querySelector('.drag-tools');
+      const status = document.getElementById('quick-order-status');
+      const helpToggle = document.getElementById('quick-order-help-toggle');
+      const help = document.getElementById('quick-order-help');
+      const moveToggle = document.getElementById('quick-order-move-toggle');
+      const moveMenu = document.getElementById('quick-order-move');
+      if (!(handle instanceof HTMLElement) || !tools || !status || !helpToggle || !help || !moveToggle || !moveMenu) return;
+
+      const STEP = 15;
+      const DRAG_THRESHOLD = 4;
+      const MARGIN = 16;
+      const NAME = 'Quick order panel';
+
+      tools.hidden = false;
+
+      /* ---------- Live announcements ---------- */
+      let statusTimer = 0;
+      function announce(message) {
+        status.textContent = message;
+        clearTimeout(statusTimer);
+        statusTimer = window.setTimeout(() => { status.textContent = ''; }, 1000);
+      }
+
+      function describePosition() {
+        const rect = panel.getBoundingClientRect();
+        const cx = rect.left + rect.width / 2;
+        const cy = rect.top + rect.height / 2;
+        const v = cy < window.innerHeight / 3 ? 'top' : cy > (window.innerHeight * 2) / 3 ? 'bottom' : 'middle';
+        const h = cx < window.innerWidth / 3 ? 'left' : cx > (window.innerWidth * 2) / 3 ? 'right' : 'center';
+        if (v === 'middle' && h === 'center') return 'to the center of the screen';
+        if (v === 'middle') return 'to the ' + h + ' side of the screen';
+        if (h === 'center') return 'to the ' + v + ' of the screen';
+        return 'to the ' + v + ' ' + h + ' of the screen';
+      }
+
+      /* ---------- Positioning ---------- */
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        panel.style.left = Math.max(0, Math.min(left, maxLeft)) + 'px';
+        panel.style.top = Math.max(0, Math.min(top, maxTop)) + 'px';
+      }
+
+      function currentPosition() {
+        const rect = panel.getBoundingClientRect();
+        return { left: rect.left, top: rect.top };
+      }
+
+      function moveBy(dx, dy) {
+        const pos = currentPosition();
+        moveTo(pos.left + dx, pos.top + dy);
+      }
+
+      function reclamp() {
+        // Only re-clamp once the panel has been given explicit coordinates.
+        if (!panel.style.left) return;
+        const pos = currentPosition();
+        moveTo(pos.left, pos.top);
+      }
+
+      window.addEventListener('resize', reclamp);
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(reclamp).observe(panel);
+      }
+
+      /* ---------- Pointer dragging ---------- */
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let dragging = false;
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0) return;
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        dragging = false;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        if (!dragging) {
+          if (Math.hypot(event.clientX - startX, event.clientY - startY) < DRAG_THRESHOLD) return;
+          dragging = true;
+          handle.classList.add('dragging');
+        }
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        handle.classList.remove('dragging');
+        if (dragging) {
+          dragging = false;
+          announce(NAME + ' moved ' + describePosition());
+        }
+      });
+
+      /* ---------- Keyboard movement ---------- */
+      const KEY_MOVES = {
+        ArrowLeft: [-STEP, 0, 'left'],
+        ArrowRight: [STEP, 0, 'right'],
+        ArrowUp: [0, -STEP, 'up'],
+        ArrowDown: [0, STEP, 'down'],
+      };
+
+      handle.addEventListener('keydown', (event) => {
+        const move = KEY_MOVES[event.key];
+        if (!move) return;
+        event.preventDefault();
+        moveBy(move[0], move[1]);
+        announce(NAME + ' moved ' + move[2]);
+      });
+
+      /* ---------- Single-pointer alternatives (Move menu) ---------- */
+      function setExpanded(toggle, region, open) {
+        toggle.setAttribute('aria-expanded', String(open));
+        region.hidden = !open;
+      }
+
+      helpToggle.addEventListener('click', () => {
+        setExpanded(helpToggle, help, help.hidden);
+      });
+
+      moveToggle.addEventListener('click', () => {
+        setExpanded(moveToggle, moveMenu, moveMenu.hidden);
+      });
+
+      moveMenu.addEventListener('click', (event) => {
+        const target = event.target;
+        if (!(target instanceof Element)) return;
+        const button = target.closest('button[data-move]');
+        if (!button) return;
+        const action = button.getAttribute('data-move');
+        const farLeft = window.innerWidth;
+        const farTop = window.innerHeight;
+        const pos = currentPosition();
+        let message = '';
+        switch (action) {
+          case 'dock-top-left': moveTo(MARGIN, MARGIN); message = 'docked top left'; break;
+          case 'dock-top-right': moveTo(farLeft - panel.offsetWidth - MARGIN, MARGIN); message = 'docked top right'; break;
+          case 'dock-bottom-left': moveTo(MARGIN, farTop - panel.offsetHeight - MARGIN); message = 'docked bottom left'; break;
+          case 'dock-bottom-right': moveTo(farLeft - panel.offsetWidth - MARGIN, farTop - panel.offsetHeight - MARGIN); message = 'docked bottom right'; break;
+          case 'left': moveTo(pos.left - STEP * 4, pos.top); message = 'moved left'; break;
+          case 'right': moveTo(pos.left + STEP * 4, pos.top); message = 'moved right'; break;
+          case 'up': moveTo(pos.left, pos.top - STEP * 4); message = 'moved up'; break;
+          case 'down': moveTo(pos.left, pos.top + STEP * 4); message = 'moved down'; break;
+          default: return;
+        }
+        announce(NAME + ' ' + message);
+      });
+
+      /* ---------- Cart (progressive enhancement of the order form) ---------- */
+      const form = document.getElementById('quick-order-form');
+      const drink = document.getElementById('qo-drink');
+      const size = document.getElementById('qo-size');
+      const qty = document.getElementById('qo-qty');
+      const addBtn = document.getElementById('qo-add');
+      const cartList = document.getElementById('qo-cart');
+      const total = document.getElementById('qo-total');
+      const checkout = document.getElementById('qo-checkout');
+      if (!(form instanceof HTMLFormElement) || !(drink instanceof HTMLSelectElement) ||
+          !(size instanceof HTMLSelectElement) || !(qty instanceof HTMLInputElement) ||
+          !addBtn || !cartList || !total || !checkout) return;
+
+      addBtn.textContent = 'Add to cart';
+      const cart = [];
+      const money = (n) => '$' + n.toFixed(2);
+
+      function renderCart() {
+        cartList.replaceChildren();
+        let sum = 0;
+        cart.forEach((item, index) => {
+          sum += item.price * item.qty;
+          const li = document.createElement('li');
+          const label = document.createElement('span');
+          label.textContent = item.qty + ' × ' + item.size + ' ' + item.name + ' – ' + money(item.price * item.qty);
+          const remove = document.createElement('button');
+          remove.type = 'button';
+          remove.textContent = '×';
+          remove.setAttribute('aria-label', 'Remove ' + item.size + ' ' + item.name);
+          remove.addEventListener('click', () => {
+            cart.splice(index, 1);
+            renderCart();
+            announce('Removed ' + item.name + ' from cart');
+            drink.focus();
+          });
+          li.append(label, remove);
+          cartList.append(li);
+        });
+        const empty = cart.length === 0;
+        cartList.hidden = empty;
+        total.hidden = empty;
+        checkout.hidden = empty;
+        total.textContent = 'Total: ' + money(sum);
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+        const drinkOpt = drink.selectedOptions[0];
+        const sizeOpt = size.selectedOptions[0];
+        const count = Math.max(1, Math.min(20, Math.round(Number(qty.value) || 1)));
+        const name = drinkOpt.textContent.split('–')[0].trim();
+        const price = Number(drinkOpt.dataset.price || 0) + Number(sizeOpt.dataset.extra || 0);
+        cart.push({ name: name, size: sizeOpt.value, qty: count, price: price });
+        renderCart();
+        announce('Added ' + count + ' ' + sizeOpt.value + ' ' + name + ' to cart');
+      });
+
+      checkout.addEventListener('click', () => {
+        window.location.href = '/order-online';
+      });
+    })();
+  </script>
+
 </body>
 
