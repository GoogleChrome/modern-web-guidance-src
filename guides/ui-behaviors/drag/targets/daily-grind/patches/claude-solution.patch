+  <!-- Floating Quick Order Panel -->
+  <div id="quick-order-panel" class="quick-order-panel" role="region" aria-label="Quick Order">
+    <div
+      id="panel-handle"
+      class="panel-handle"
+      tabindex="0"
+      aria-label="Quick order panel – use arrow keys to move"
+    >
+      <span class="handle-grip" aria-hidden="true">&#8942;&#8942;</span>
+      <span class="panel-title">Quick Order</span>
+      <span class="cart-badge" id="cart-badge" aria-live="polite">0 items</span>
+    </div>
+    <div class="panel-body">
+      <ul class="order-list" aria-label="Menu items">
+        <li class="order-item">
+          <span class="item-name">Maple Oat Latte</span>
+          <div class="qty-controls">
+            <button class="qty-btn qty-dec" aria-label="Decrease Maple Oat Latte quantity">&#8722;</button>
+            <span class="qty-value" aria-live="polite">0</span>
+            <button class="qty-btn qty-inc" aria-label="Increase Maple Oat Latte quantity">+</button>
+          </div>
+          <span class="item-price">$5.50</span>
+        </li>
+        <li class="order-item">
+          <span class="item-name">Dark Roast Espresso</span>
+          <div class="qty-controls">
+            <button class="qty-btn qty-dec" aria-label="Decrease Dark Roast Espresso quantity">&#8722;</button>
+            <span class="qty-value" aria-live="polite">0</span>
+            <button class="qty-btn qty-inc" aria-label="Increase Dark Roast Espresso quantity">+</button>
+          </div>
+          <span class="item-price">$4.00</span>
+        </li>
+        <li class="order-item">
+          <span class="item-name">Cold Brew</span>
+          <div class="qty-controls">
+            <button class="qty-btn qty-dec" aria-label="Decrease Cold Brew quantity">&#8722;</button>
+            <span class="qty-value" aria-live="polite">0</span>
+            <button class="qty-btn qty-inc" aria-label="Increase Cold Brew quantity">+</button>
+          </div>
+          <span class="item-price">$4.75</span>
+        </li>
+      </ul>
+      <div class="panel-total-row">
+        <span class="total-label">Total:</span>
+        <span class="total-amount" id="order-total" aria-live="polite">$0.00</span>
+        <button class="place-order-btn" id="place-order-btn">Place Order</button>
+      </div>
+    </div>
+  </div>
+
+  <script>
+    (function () {
+      'use strict';
+
+      var panel = document.getElementById('quick-order-panel');
+      var handle = document.getElementById('panel-handle');
+
+      // Convert from CSS bottom/right to JS-controlled left/top so moveTo() works.
+      // margin: 0 clears any UA default margin that would shift getBoundingClientRect.
+      panel.style.margin = '0';
+      var initRect = panel.getBoundingClientRect();
+      panel.style.left = initRect.left + 'px';
+      panel.style.top = initRect.top + 'px';
+      panel.style.bottom = '';
+      panel.style.right = '';
+
+      // Reveal drag affordances now that JS is active.
+      handle.classList.add('drag-enabled');
+
+      var offsetX = 0;
+      var offsetY = 0;
+
+      function moveTo(left, top) {
+        var maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        var maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+        panel.style.left = Math.max(0, Math.min(left, maxLeft)) + 'px';
+        panel.style.top = Math.max(0, Math.min(top, maxTop)) + 'px';
+      }
+
+      handle.addEventListener('pointerdown', function (event) {
+        if (event.button !== 0 || event.target.closest('button, input, select, textarea, a')) return;
+        var rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', function (event) {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        handle.classList.add('dragging');
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', function () {
+        handle.classList.remove('dragging');
+      });
+
+      handle.addEventListener('keydown', function (event) {
+        var step = 15;
+        var rect = panel.getBoundingClientRect();
+        var left = rect.left;
+        var top = rect.top;
+
+        switch (event.key) {
+          case 'ArrowLeft':  left -= step; break;
+          case 'ArrowRight': left += step; break;
+          case 'ArrowUp':    top  -= step; break;
+          case 'ArrowDown':  top  += step; break;
+          default: return;
+        }
+        event.preventDefault();
+        moveTo(left, top);
+      });
+
+      window.addEventListener('resize', function () {
+        var rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      });
+
+      // ── Cart state ──
+      var ITEMS = [
+        { price: 5.50 },
+        { price: 4.00 },
+        { price: 4.75 }
+      ];
+      var quantities = [0, 0, 0];
+      var qtyEls = document.querySelectorAll('.qty-value');
+      var totalEl = document.getElementById('order-total');
+      var badgeEl = document.getElementById('cart-badge');
+
+      function updateCart() {
+        var total = 0;
+        var count = 0;
+        quantities.forEach(function (q, i) {
+          total += q * ITEMS[i].price;
+          count += q;
+        });
+        totalEl.textContent = '$' + total.toFixed(2);
+        badgeEl.textContent = count === 1 ? '1 item' : count + ' items';
+      }
+
+      document.querySelectorAll('.order-item').forEach(function (row, i) {
+        var decBtn = row.querySelector('.qty-dec');
+        var incBtn = row.querySelector('.qty-inc');
+
+        decBtn.addEventListener('click', function () {
+          if (quantities[i] > 0) {
+            quantities[i]--;
+            qtyEls[i].textContent = quantities[i];
+            updateCart();
+          }
+        });
+
+        incBtn.addEventListener('click', function () {
+          quantities[i]++;
+          qtyEls[i].textContent = quantities[i];
+          updateCart();
+        });
+      });
+
+      document.getElementById('place-order-btn').addEventListener('click', function () {
+        var count = quantities.reduce(function (s, q) { return s + q; }, 0);
+        if (count === 0) {
+          alert('Please add at least one item before placing your order.');
+          return;
+        }
+        alert('Order placed! Thank you for choosing The Daily Grind.');
+        quantities.fill(0);
+        qtyEls.forEach(function (el) { el.textContent = '0'; });
+        updateCart();
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
