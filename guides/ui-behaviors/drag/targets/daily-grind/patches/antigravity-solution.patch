+  <script>
+    (() => {
+      const draggable = document.getElementById('quick-order-panel');
+      const handle = document.getElementById('quick-order-handle');
+      const grip = document.getElementById('quick-order-grip');
+
+      if (draggable && handle) {
+        handle.classList.add('drag-handle');
+        handle.setAttribute('tabindex', '0');
+        handle.setAttribute(
+          'aria-label',
+          'Quick Order & Cart header — drag or use arrow keys to move panel'
+        );
+        if (grip) {
+          grip.hidden = false;
+        }
+
+        let offsetX = 0;
+        let offsetY = 0;
+        let isPointerDragging = false;
+        let activePointerId = null;
+
+        function moveTo(left, top) {
+          const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+          const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+
+          draggable.style.margin = '0';
+          draggable.style.right = 'auto';
+          draggable.style.bottom = 'auto';
+          draggable.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+          draggable.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+        }
+
+        function clampCurrentPosition() {
+          const rect = draggable.getBoundingClientRect();
+          moveTo(rect.left, rect.top);
+        }
+
+        clampCurrentPosition();
+
+        handle.addEventListener('pointerdown', (event) => {
+          if (event.button !== 0 || event.target.closest('button, input, select, textarea, a')) return;
+
+          const rect = draggable.getBoundingClientRect();
+          offsetX = event.clientX - rect.left;
+          offsetY = event.clientY - rect.top;
+          isPointerDragging = true;
+          activePointerId = event.pointerId;
+          try {
+            handle.setPointerCapture(event.pointerId);
+          } catch {
+            // Fallback for synthetic pointer events without an active hardware pointer
+          }
+        });
+
+        handle.addEventListener('pointermove', (event) => {
+          const hasCapture = handle.hasPointerCapture && handle.hasPointerCapture(event.pointerId);
+          if (!hasCapture && (!isPointerDragging || event.pointerId !== activePointerId)) return;
+          handle.classList.add('dragging');
+          moveTo(event.clientX - offsetX, event.clientY - offsetY);
+        });
+
+        function stopPointerDrag(event) {
+          if (event && activePointerId !== null && event.pointerId !== activePointerId) return;
+          isPointerDragging = false;
+          activePointerId = null;
+          handle.classList.remove('dragging');
+          if (event && handle.hasPointerCapture && handle.hasPointerCapture(event.pointerId)) {
+            try {
+              handle.releasePointerCapture(event.pointerId);
+            } catch {
+              // Ignore
+            }
+          }
+        }
+
+        handle.addEventListener('pointerup', stopPointerDrag);
+        handle.addEventListener('pointercancel', stopPointerDrag);
+        handle.addEventListener('lostpointercapture', () => {
+          isPointerDragging = false;
+          activePointerId = null;
+          handle.classList.remove('dragging');
+        });
+
+        const KEYBOARD_STEP = 15;
+
+        handle.addEventListener('keydown', (event) => {
+          const rect = draggable.getBoundingClientRect();
+          let left = rect.left;
+          let top = rect.top;
+
+          switch (event.key) {
+            case 'ArrowLeft':
+              left -= KEYBOARD_STEP;
+              break;
+            case 'ArrowRight':
+              left += KEYBOARD_STEP;
+              break;
+            case 'ArrowUp':
+              top -= KEYBOARD_STEP;
+              break;
+            case 'ArrowDown':
+              top += KEYBOARD_STEP;
+              break;
+            default:
+              return;
+          }
+
+          event.preventDefault();
+          moveTo(left, top);
+        });
+
+        window.addEventListener('resize', clampCurrentPosition);
+        if (typeof ResizeObserver !== 'undefined') {
+          const resizeObserver = new ResizeObserver(() => {
+            clampCurrentPosition();
+          });
+          resizeObserver.observe(draggable);
+        }
+      }
+
+      // Interactive Coffee Cart & Quick-Order Controls
+      const cartList = document.getElementById('cart-items');
+      const badge = document.getElementById('cart-count-badge');
+      const subtotalEl = document.getElementById('cart-subtotal');
+      const checkoutBtn = document.getElementById('checkout-btn');
+      const addBtn = document.getElementById('add-to-cart-btn');
+      const form = document.getElementById('quick-order-form');
+      const drinkSelect = document.getElementById('quick-drink-select');
+      const sizeSelect = document.getElementById('quick-size-select');
+      const qtyInput = document.getElementById('quick-qty-input');
+      const noteInput = document.getElementById('quick-note-input');
+      const statusMsg = document.getElementById('order-status-msg');
+
+      const cartState = [
+        { id: 'maple-oat-latte-Medium', name: 'Maple Oat Latte', size: 'Medium', price: 5.50, qty: 1, note: '' },
+        { id: 'cold-brew-Medium', name: 'Cold Brew', size: 'Medium', price: 4.75, qty: 1, note: '' }
+      ];
+
+      function renderCart() {
+        if (!cartList) return;
+        cartList.innerHTML = '';
+
+        let totalQty = 0;
+        let subtotal = 0;
+
+        cartState.forEach((item) => {
+          totalQty += item.qty;
+          subtotal += item.price * item.qty;
+
+          const li = document.createElement('li');
+          li.className = 'cart-item';
+          li.dataset.id = item.id;
+
+          const info = document.createElement('div');
+          info.className = 'cart-item-info';
+
+          const nameSpan = document.createElement('span');
+          nameSpan.className = 'cart-item-name';
+          nameSpan.textContent = item.name;
+
+          const metaSpan = document.createElement('span');
+          metaSpan.className = 'cart-item-meta';
+          const noteSuffix = item.note ? ` • ${item.note}` : '';
+          metaSpan.textContent = `${item.size} • $${item.price.toFixed(2)} each${noteSuffix}`;
+
+          info.appendChild(nameSpan);
+          info.appendChild(metaSpan);
+
+          const controls = document.createElement('div');
+          controls.className = 'cart-item-controls';
+
+          const decBtn = document.createElement('button');
+          decBtn.type = 'button';
+          decBtn.className = 'qty-btn';
+          decBtn.dataset.action = 'decrease';
+          decBtn.dataset.id = item.id;
+          decBtn.setAttribute('aria-label', `Decrease ${item.name} quantity`);
+          decBtn.textContent = '−';
+
+          const qtySpan = document.createElement('span');
+          qtySpan.className = 'cart-item-qty';
+          qtySpan.textContent = String(item.qty);
+
+          const incBtn = document.createElement('button');
+          incBtn.type = 'button';
+          incBtn.className = 'qty-btn';
+          incBtn.dataset.action = 'increase';
+          incBtn.dataset.id = item.id;
+          incBtn.setAttribute('aria-label', `Increase ${item.name} quantity`);
+          incBtn.textContent = '+';
+
+          controls.appendChild(decBtn);
+          controls.appendChild(qtySpan);
+          controls.appendChild(incBtn);
+
+          li.appendChild(info);
+          li.appendChild(controls);
+          cartList.appendChild(li);
+        });
+
+        if (cartState.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'cart-item';
+          emptyLi.textContent = 'Your coffee cart is empty.';
+          cartList.appendChild(emptyLi);
+        }
+
+        if (badge) {
+          badge.textContent = `${totalQty} ${totalQty === 1 ? 'item' : 'items'}`;
+        }
+        if (subtotalEl) {
+          subtotalEl.textContent = `Subtotal: $${subtotal.toFixed(2)}`;
+        }
+        if (checkoutBtn) {
+          checkoutBtn.textContent = `Checkout ($${subtotal.toFixed(2)})`;
+        }
+      }
+
+      if (cartList) {
+        cartList.addEventListener('click', (event) => {
+          const btn = event.target.closest('button[data-action]');
+          if (!btn) return;
+          const itemEl = btn.closest('.cart-item');
+          const id = btn.dataset.id || (itemEl && itemEl.dataset.id);
+          const idx = cartState.findIndex((entry) => entry.id === id);
+          if (idx === -1) return;
+
+          if (btn.dataset.action === 'increase') {
+            cartState[idx].qty += 1;
+          } else if (btn.dataset.action === 'decrease') {
+            cartState[idx].qty -= 1;
+            if (cartState[idx].qty <= 0) {
+              cartState.splice(idx, 1);
+            }
+          }
+          renderCart();
+        });
+      }
+
+      function addSelectedDrinkToCart() {
+        if (!drinkSelect || !sizeSelect || !qtyInput) return;
+        const selectedOption = drinkSelect.options[drinkSelect.selectedIndex];
+        const name = selectedOption.dataset.name || selectedOption.textContent;
+        const basePrice = parseFloat(selectedOption.dataset.price || '4.50');
+        const size = sizeSelect.value || 'Medium';
+        const upcharge = size === 'Large' ? 0.75 : 0;
+        const price = basePrice + upcharge;
+        const qty = Math.max(1, Math.min(10, parseInt(qtyInput.value, 10) || 1));
+        const note = noteInput ? noteInput.value.trim() : '';
+        const id = `${drinkSelect.value}-${size}-${note}`;
+
+        const existing = cartState.find((item) => item.id === id);
+        if (existing) {
+          existing.qty += qty;
+        } else {
+          cartState.push({ id, name, size, price, qty, note });
+        }
+
+        if (noteInput) noteInput.value = '';
+        qtyInput.value = '1';
+        renderCart();
+
+        if (statusMsg) {
+          statusMsg.textContent = `Added ${qty}x ${size} ${name} to cart.`;
+        }
+      }
+
+      if (addBtn) {
+        addBtn.addEventListener('click', addSelectedDrinkToCart);
+      }
+
+      if (form) {
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+          if (cartState.length === 0) {
+            addSelectedDrinkToCart();
+          }
+          if (statusMsg) {
+            statusMsg.textContent = 'Order submitted! Ready for pickup in 5–8 mins.';
+          }
+        });
+      }
+    })();
+  </script>
+
