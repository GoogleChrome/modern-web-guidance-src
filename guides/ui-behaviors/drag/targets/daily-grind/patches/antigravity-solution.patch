+            const openUpwards = btnRect.bottom + 240 > window.innerHeight && btnRect.top > 240;
+            moveMenu.style.top = openUpwards ? 'auto' : 'calc(100% + 6px)';
+            moveMenu.style.bottom = openUpwards ? 'calc(100% + 6px)' : 'auto';
+            if (menuItems.length > 0) {
+              menuItems[0].focus();
+            }
+          }
+        });
+
+        moveMenu.addEventListener('click', (event) => {
+          const item = event.target.closest('[data-move-action]');
+          if (!item) return;
+
+          const action = item.dataset.moveAction;
+          const rect = draggable.getBoundingClientRect();
+          const step = 40;
+          let description = '';
+
+          switch (action) {
+            case 'move-left':
+              moveTo(rect.left - step, rect.top);
+              description = 'moved left';
+              break;
+            case 'move-right':
+              moveTo(rect.left + step, rect.top);
+              description = 'moved right';
+              break;
+            case 'move-up':
+              moveTo(rect.left, rect.top - step);
+              description = 'moved up';
+              break;
+            case 'move-down':
+              moveTo(rect.left, rect.top + step);
+              description = 'moved down';
+              break;
+            case 'dock-left':
+              moveTo(0, rect.top);
+              description = 'docked left';
+              break;
+            case 'dock-right':
+              moveTo(window.innerWidth - draggable.offsetWidth, rect.top);
+              description = 'docked right';
+              break;
+            case 'dock-top':
+              moveTo(rect.left, 0);
+              description = 'docked top';
+              break;
+            case 'dock-bottom':
+              moveTo(rect.left, window.innerHeight - draggable.offsetHeight);
+              description = 'docked bottom';
+              break;
+            default:
+              return;
+          }
+
+          announce(`Quick Order panel ${description}`);
+          closeMoveMenu(true);
+        });
+
+        moveMenu.addEventListener('keydown', (event) => {
+          const currentIndex = menuItems.indexOf(document.activeElement);
+          if (event.key === 'Escape') {
+            event.preventDefault();
+            closeMoveMenu(true);
+          } else if (event.key === 'ArrowDown') {
+            event.preventDefault();
+            const next = menuItems[(currentIndex + 1) % menuItems.length];
+            next?.focus();
+          } else if (event.key === 'ArrowUp') {
+            event.preventDefault();
+            const prev = menuItems[(currentIndex - 1 + menuItems.length) % menuItems.length];
+            prev?.focus();
+          } else if (event.key === 'Tab') {
+            closeMoveMenu(false);
+          }
+        });
+
+        document.addEventListener('click', (event) => {
+          if (!moveMenu.hidden && !moveMenu.contains(event.target) && event.target !== moveBtn) {
+            closeMoveMenu(false);
+          }
+        });
+      }
+
+      // Help toggle
+      if (helpBtn && helpBox) {
+        helpBtn.addEventListener('click', () => {
+          const willShow = helpBox.hidden;
+          helpBox.hidden = !willShow;
+          helpBtn.setAttribute('aria-expanded', String(willShow));
+          clampCurrentPosition();
+        });
+      }
+
+      // Collapse / expand toggle
+      if (collapseBtn && panelBody) {
+        collapseBtn.addEventListener('click', () => {
+          const willCollapse = !panelBody.hidden;
+          panelBody.hidden = willCollapse;
+          draggable.classList.toggle('is-collapsed', willCollapse);
+          collapseBtn.setAttribute('aria-expanded', String(!willCollapse));
+          collapseBtn.setAttribute(
+            'aria-label',
+            willCollapse ? 'Expand Quick Order panel' : 'Collapse Quick Order panel'
+          );
+          collapseBtn.title = willCollapse ? 'Expand panel' : 'Minimize panel';
+          collapseBtn.textContent = willCollapse ? '+' : '−';
+          clampCurrentPosition();
+        });
+      }
+
+      // Re-clamp on viewport or panel size changes
+      window.addEventListener('resize', clampCurrentPosition);
+      if (typeof ResizeObserver === 'function') {
+        const resizeObserver = new ResizeObserver(clampCurrentPosition);
+        resizeObserver.observe(draggable);
+      }
+
+      // Quick Order cart state & interactive controls
+      const cart = new Map([
+        ['maple-oat-latte', { id: 'maple-oat-latte', name: 'Maple Oat Latte', price: 5.25, qty: 1 }]
+      ]);
+
+      const drinkSelect = document.getElementById('drink-select');
+      const addDrinkBtn = document.getElementById('add-drink-btn');
+      const cartItemsList = document.getElementById('cart-items');
+      const cartCountEl = document.getElementById('cart-count');
+      const cartSubtotalEl = document.getElementById('cart-subtotal');
+      const orderNoteInput = document.getElementById('order-note');
+      const placeOrderBtn = document.getElementById('place-order-btn');
+      const clearCartBtn = document.getElementById('clear-cart-btn');
+      const orderStatusMsg = document.getElementById('order-status-msg');
+
+      function renderCart() {
+        if (!cartItemsList || !cartCountEl || !cartSubtotalEl || !placeOrderBtn || !clearCartBtn) return;
+
+        cartItemsList.innerHTML = '';
+        let totalQty = 0;
+        let subtotal = 0;
+
+        if (cart.size === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'cart-empty';
+          emptyLi.textContent = 'Your quick order cart is empty.';
+          cartItemsList.appendChild(emptyLi);
+        } else {
+          for (const item of cart.values()) {
+            totalQty += item.qty;
+            subtotal += item.price * item.qty;
+
+            const li = document.createElement('li');
+            li.className = 'cart-item';
+            li.dataset.itemId = item.id;
+
+            const infoDiv = document.createElement('div');
+            infoDiv.className = 'cart-item-info';
+
+            const nameDiv = document.createElement('div');
+            nameDiv.className = 'cart-item-name';
+            nameDiv.textContent = item.name;
+
+            const metaDiv = document.createElement('div');
+            metaDiv.className = 'cart-item-meta';
+            metaDiv.textContent = `$${item.price.toFixed(2)} each`;
+
+            infoDiv.append(nameDiv, metaDiv);
+
+            const qtyDiv = document.createElement('div');
+            qtyDiv.className = 'cart-item-qty';
+
+            const decBtn = document.createElement('button');
+            decBtn.type = 'button';
+            decBtn.className = 'qty-btn panel-control';
+            decBtn.dataset.qtyAction = 'decrease';
+            decBtn.setAttribute('aria-label', `Decrease quantity of ${item.name}`);
+            decBtn.textContent = '−';
+
+            const qtySpan = document.createElement('span');
+            qtySpan.className = 'qty-value';
+            qtySpan.textContent = String(item.qty);
+
+            const incBtn = document.createElement('button');
+            incBtn.type = 'button';
+            incBtn.className = 'qty-btn panel-control';
+            incBtn.dataset.qtyAction = 'increase';
+            incBtn.setAttribute('aria-label', `Increase quantity of ${item.name}`);
+            incBtn.textContent = '+';
+
+            qtyDiv.append(decBtn, qtySpan, incBtn);
+            li.append(infoDiv, qtyDiv);
+            cartItemsList.appendChild(li);
+          }
+        }
+
+        cartCountEl.textContent = String(totalQty);
+        cartSubtotalEl.textContent = `$${subtotal.toFixed(2)}`;
+        placeOrderBtn.disabled = totalQty === 0;
+        clearCartBtn.disabled = totalQty === 0;
+      }
+
+      if (addDrinkBtn && drinkSelect) {
+        addDrinkBtn.addEventListener('click', () => {
+          const selected = drinkSelect.options[drinkSelect.selectedIndex];
+          if (!selected) return;
+
+          const id = selected.value;
+          const name = selected.dataset.name || selected.textContent;
+          const price = Number(selected.dataset.price || 0);
+
+          const existing = cart.get(id);
+          if (existing) {
+            existing.qty += 1;
+          } else {
+            cart.set(id, { id, name, price, qty: 1 });
+          }
+          if (orderStatusMsg) orderStatusMsg.hidden = true;
+          renderCart();
+        });
+      }
+
+      if (cartItemsList) {
+        cartItemsList.addEventListener('click', (event) => {
+          const btn = event.target.closest('[data-qty-action]');
+          if (!btn) return;
+          const itemEl = btn.closest('[data-item-id]');
+          const id = itemEl?.dataset.itemId;
+          if (!id || !cart.has(id)) return;
+
+          const item = cart.get(id);
+          if (btn.dataset.qtyAction === 'increase') {
+            item.qty += 1;
+          } else if (btn.dataset.qtyAction === 'decrease') {
+            item.qty -= 1;
+            if (item.qty <= 0) {
+              cart.delete(id);
+            }
+          }
+          if (orderStatusMsg) orderStatusMsg.hidden = true;
+          renderCart();
+        });
+      }
+
+      if (clearCartBtn) {
+        clearCartBtn.addEventListener('click', () => {
+          cart.clear();
+          if (orderNoteInput) orderNoteInput.value = '';
+          if (orderStatusMsg) orderStatusMsg.hidden = true;
+          renderCart();
+        });
+      }
+
+      if (placeOrderBtn) {
+        placeOrderBtn.addEventListener('click', () => {
+          if (cart.size === 0) return;
+          const totalItems = Array.from(cart.values()).reduce((sum, item) => sum + item.qty, 0);
+          const note = orderNoteInput?.value.trim();
+          const noteSuffix = note ? ` (Note: ${note})` : '';
+          if (orderStatusMsg) {
+            orderStatusMsg.textContent = `Order placed for ${totalItems} ${totalItems === 1 ? 'drink' : 'drinks'}${noteSuffix}. Ready in ~8 mins.`;
+            orderStatusMsg.hidden = false;
+          }
+          cart.clear();
+          if (orderNoteInput) orderNoteInput.value = '';
+          renderCart();
+        });
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
