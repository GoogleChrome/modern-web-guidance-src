diff --git a/src/drag.ts b/src/drag.ts
new file mode 100644
index 0000000..edb5406
--- /dev/null
+++ b/src/drag.ts
@@ -0,0 +1,78 @@
+const panel = document.querySelector<HTMLElement>('#coffee-panel');
+const handle = document.querySelector<HTMLButtonElement>('#coffee-drag-handle');
+
+if (panel && handle) {
+  let activePointer: number | null = null;
+  let offsetX = 0;
+  let offsetY = 0;
+
+  // Pointer, keyboard, and resize updates all use the same viewport limits.
+  function moveTo(left: number, top: number): void {
+    if (!panel) return;
+    const rect = panel.getBoundingClientRect();
+    const maxLeft = Math.max(0, window.innerWidth - rect.width);
+    const maxTop = Math.max(0, window.innerHeight - rect.height);
+    panel.style.right = 'auto';
+    panel.style.bottom = 'auto';
+    panel.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+    panel.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+  }
+
+  function reclamp(): void {
+    if (!panel) return;
+    const rect = panel.getBoundingClientRect();
+    moveTo(rect.left, rect.top);
+  }
+
+  function endDrag(event: PointerEvent): void {
+    if (!handle || event.pointerId !== activePointer) return;
+    activePointer = null;
+    handle.classList.remove('dragging');
+    if (handle.hasPointerCapture(event.pointerId)) {
+      handle.releasePointerCapture(event.pointerId);
+    }
+  }
+
+  handle.addEventListener('pointerdown', (event: PointerEvent) => {
+    if (event.button !== 0 || !event.isPrimary || activePointer !== null) return;
+    // Only the dedicated grip starts a drag; panel links and text are unaffected.
+    const rect = panel.getBoundingClientRect();
+    offsetX = event.clientX - rect.left;
+    offsetY = event.clientY - rect.top;
+    handle.setPointerCapture(event.pointerId);
+    activePointer = event.pointerId;
+    handle.classList.add('dragging');
+    handle.focus({ preventScroll: true });
+    event.preventDefault();
+  });
+
+  handle.addEventListener('pointermove', (event: PointerEvent) => {
+    if (event.pointerId !== activePointer) return;
+    moveTo(event.clientX - offsetX, event.clientY - offsetY);
+  });
+  handle.addEventListener('pointerup', endDrag);
+  handle.addEventListener('pointercancel', endDrag);
+  handle.addEventListener('lostpointercapture', endDrag);
+
+  handle.addEventListener('keydown', (event: KeyboardEvent) => {
+    const step = 15;
+    let dx = 0;
+    let dy = 0;
+    switch (event.key) {
+      case 'ArrowLeft': dx = -step; break;
+      case 'ArrowRight': dx = step; break;
+      case 'ArrowUp': dy = -step; break;
+      case 'ArrowDown': dy = step; break;
+      default: return;
+    }
+    event.preventDefault();
+    const rect = panel.getBoundingClientRect();
+    moveTo(rect.left + dx, rect.top + dy);
+  });
+
+  // Reveal the grip only after its interactions are ready.
+  handle.hidden = false;
+  reclamp();
+  window.addEventListener('resize', reclamp);
+  new ResizeObserver(reclamp).observe(panel);
+}
