diff --git a/quick-order.js b/quick-order.js
new file mode 100644
index 0000000..730a5ec
--- /dev/null
+++ b/quick-order.js
@@ -0,0 +1,127 @@
+// @ts-check
+
+const panel = document.querySelector('[data-draggable]');
+const handle = panel?.querySelector('[data-drag-handle]');
+const help = panel?.querySelector('[data-move-help]');
+const status = document.querySelector('[data-move-status]');
+
+if (
+  panel instanceof HTMLElement &&
+  handle instanceof HTMLButtonElement &&
+  help instanceof HTMLDetailsElement &&
+  status instanceof HTMLElement
+) {
+  initializeMovement(panel, handle, help, status);
+}
+
+/**
+ * @param {HTMLElement} panel
+ * @param {HTMLButtonElement} handle
+ * @param {HTMLDetailsElement} help
+ * @param {HTMLElement} status
+ */
+function initializeMovement(panel, handle, help, status) {
+  const steps = new Map([
+    ['ArrowLeft', { x: -15, y: 0, direction: 'left' }],
+    ['ArrowUp', { x: 0, y: -15, direction: 'up' }],
+    ['ArrowDown', { x: 0, y: 15, direction: 'down' }],
+    ['ArrowRight', { x: 15, y: 0, direction: 'right' }],
+  ]);
+
+  /** @type {{ id: number, offsetX: number, offsetY: number, moved: boolean } | null} */
+  let drag = null;
+  let announcementTimer = 0;
+
+  /**
+   * @param {number} left
+   * @param {number} top
+   */
+  function moveTo(left, top) {
+    const { width, height, x, y } = panel.getBoundingClientRect();
+    const viewport = document.documentElement;
+    const nextLeft = Math.max(0, Math.min(left, viewport.clientWidth - width));
+    const nextTop = Math.max(0, Math.min(top, viewport.clientHeight - height));
+
+    if (nextLeft === x && nextTop === y) return false;
+
+    panel.style.right = 'auto';
+    panel.style.bottom = 'auto';
+    panel.style.left = `${nextLeft}px`;
+    panel.style.top = `${nextTop}px`;
+    return true;
+  }
+
+  /** @param {string} message */
+  function announce(message) {
+    window.clearTimeout(announcementTimer);
+    status.textContent = message;
+    announcementTimer = window.setTimeout(() => {
+      status.textContent = '';
+    }, 1000);
+  }
+
+  /** @param {{ x: number, y: number, direction: string }} step */
+  function moveByStep(step) {
+    const { left, top } = panel.getBoundingClientRect();
+    if (moveTo(left + step.x, top + step.y)) {
+      announce(`Quick order panel moved ${step.direction}.`);
+    }
+  }
+
+  handle.addEventListener('pointerdown', (event) => {
+    if (event.button !== 0 || drag) return;
+
+    const { left, top } = panel.getBoundingClientRect();
+    handle.setPointerCapture(event.pointerId);
+    drag = {
+      id: event.pointerId,
+      offsetX: event.clientX - left,
+      offsetY: event.clientY - top,
+      moved: false,
+    };
+  });
+
+  handle.addEventListener('pointermove', (event) => {
+    if (!drag || drag.id !== event.pointerId || !handle.hasPointerCapture(event.pointerId)) return;
+
+    const moved = moveTo(event.clientX - drag.offsetX, event.clientY - drag.offsetY);
+    if (moved) {
+      drag.moved = true;
+      handle.classList.add('dragging');
+    }
+  });
+
+  handle.addEventListener('lostpointercapture', (event) => {
+    if (!drag || drag.id !== event.pointerId) return;
+
+    if (drag.moved) announce('Quick order panel moved.');
+    drag = null;
+    handle.classList.remove('dragging');
+  });
+
+  handle.addEventListener('keydown', (event) => {
+    const step = steps.get(event.key);
+    if (!step) return;
+
+    event.preventDefault();
+    moveByStep(step);
+  });
+
+  for (const button of help.querySelectorAll('button[data-move]')) {
+    const step = steps.get(button.getAttribute('data-move') ?? '');
+    if (step) button.addEventListener('click', () => moveByStep(step));
+  }
+
+  function keepInViewport() {
+    const { left, top } = panel.getBoundingClientRect();
+    moveTo(left, top);
+  }
+
+  panel.classList.add('is-floating');
+  handle.hidden = false;
+  help.hidden = false;
+  keepInViewport();
+
+  window.addEventListener('resize', keepInViewport);
+  new ResizeObserver(keepInViewport).observe(panel);
+}
