+  <script>
+    // @ts-check
+    const panel = document.querySelector('.quick-order');
+    const handle = document.getElementById('order-handle');
+    const coffee = document.getElementById('coffee');
+    const quantity = document.getElementById('quantity');
+    const total = document.getElementById('coffee-total');
+    const totalRow = document.getElementById('order-total');
+
+    if (coffee instanceof HTMLSelectElement && quantity instanceof HTMLInputElement && total && totalRow) {
+      const updateTotal = () => {
+        const price = Number(coffee.selectedOptions[0]?.dataset.price);
+        total.textContent = quantity.validity.valid
+          ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(price * quantity.valueAsNumber / 100)
+          : 'Choose 1–20';
+      };
+      coffee.addEventListener('change', updateTotal);
+      quantity.addEventListener('input', updateTotal);
+      totalRow.hidden = false;
+      updateTotal();
+    }
+
+    if (panel instanceof HTMLElement && handle instanceof HTMLElement) {
+      /** @type {{ id: number, offsetX: number, offsetY: number } | null} */
+      let drag = null;
+      const moveTo = (/** @type {number} */ left, /** @type {number} */ top) => {
+        panel.style.left = `${Math.max(0, Math.min(left, window.innerWidth - panel.offsetWidth))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, window.innerHeight - panel.offsetHeight))}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+      };
+      const reclamp = () => {
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      };
+      handle.tabIndex = 0;
+      handle.setAttribute('aria-label', 'Move coffee order panel with arrow keys');
+      handle.classList.add('drag-ready');
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || !event.isPrimary || drag) return;
+        const rect = panel.getBoundingClientRect();
+        handle.setPointerCapture(event.pointerId);
+        drag = { id: event.pointerId, offsetX: event.clientX - rect.left, offsetY: event.clientY - rect.top };
+        handle.classList.add('dragging');
+        handle.focus({ preventScroll: true });
+      });
+      handle.addEventListener('pointermove', (event) => {
+        if (drag?.id !== event.pointerId) return;
+        moveTo(event.clientX - drag.offsetX, event.clientY - drag.offsetY);
+      });
+      const stopDrag = (/** @type {PointerEvent} */ event) => {
+        if (drag?.id !== event.pointerId) return;
+        drag = null;
+        handle.classList.remove('dragging');
+        if (handle.hasPointerCapture(event.pointerId)) handle.releasePointerCapture(event.pointerId);
+      };
+      handle.addEventListener('pointerup', stopDrag);
+      handle.addEventListener('pointercancel', stopDrag);
+      handle.addEventListener('lostpointercapture', stopDrag);
+      handle.addEventListener('keydown', (event) => {
+        let dx = 0;
+        let dy = 0;
+        switch (event.key) {
+          case 'ArrowLeft': dx = -15; break;
+          case 'ArrowRight': dx = 15; break;
+          case 'ArrowUp': dy = -15; break;
+          case 'ArrowDown': dy = 15; break;
+          default: return;
+        }
+        event.preventDefault();
+        const rect = panel.getBoundingClientRect();
+        moveTo(rect.left + dx, rect.top + dy);
+      });
+      window.addEventListener('resize', reclamp);
+      new ResizeObserver(reclamp).observe(panel);
+      reclamp();
+    }
+  </script>
