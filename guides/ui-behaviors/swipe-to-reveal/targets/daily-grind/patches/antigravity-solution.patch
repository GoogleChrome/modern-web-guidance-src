+  <script>
+    (() => {
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const getScrollBehavior = () => (reducedMotionQuery.matches ? 'auto' : 'smooth');
+
+      const setActionTabIndexes = (reveal, isRevealed) => {
+        const value = isRevealed ? '0' : '-1';
+        for (const control of reveal.querySelectorAll('.SwipeReveal-panel button, .SwipeReveal-panel a')) {
+          control.setAttribute('tabindex', value);
+        }
+      };
+
+      const setRevealState = (reveal, isRevealed, activeTrigger = null) => {
+        const triggers = reveal.querySelectorAll('.SwipeReveal-content [aria-label$="actions"]');
+        for (const actionButton of triggers) {
+          const expanded = isRevealed && (!activeTrigger || actionButton === activeTrigger);
+          actionButton.setAttribute('aria-expanded', expanded ? 'true' : 'false');
+        }
+        setActionTabIndexes(reveal, isRevealed);
+        reveal.classList.remove('is-pending');
+        reveal.classList.toggle('is-revealed', isRevealed);
+      };
+
+      const getSnapTargetOffset = (reveal, target) => {
+        if (target.classList.contains('SwipeReveal-content')) {
+          return target.offsetLeft;
+        }
+        if (target.matches('.SwipeReveal-panel:first-child')) {
+          return target.offsetLeft;
+        }
+        return Math.max(0, target.offsetLeft + target.offsetWidth - reveal.clientWidth);
+      };
+
+      const findClosestSnapTarget = (reveal) => {
+        const targets = Array.from(reveal.querySelectorAll('.SwipeReveal-content, .SwipeReveal-panel'));
+        if (targets.length === 0) return null;
+
+        let closestTarget = targets[0];
+        let minDistance = Infinity;
+
+        for (const target of targets) {
+          const distance = Math.abs(reveal.scrollLeft - getSnapTargetOffset(reveal, target));
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestTarget = target;
+          }
+        }
+        return closestTarget;
+      };
+
+      const syncRevealFromScroll = (reveal) => {
+        const closest = findClosestSnapTarget(reveal);
+        if (!closest) return;
+        setRevealState(reveal, closest.classList.contains('SwipeReveal-panel'));
+      };
+
+      // Trigger button open/close control
+      for (const trigger of document.querySelectorAll('.SwipeReveal-content [aria-label$="actions"]')) {
+        trigger.addEventListener('click', () => {
+          const reveal = trigger.closest('.SwipeReveal');
+          if (!reveal) return;
+
+          const label = (trigger.getAttribute('aria-label') || '').toLowerCase();
+          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
+
+          if (isExpanded) {
+            if (label.includes('leading') || label.includes('trailing')) {
+              const firstPanel = reveal.querySelector('.SwipeReveal-panel');
+              const leadingScrollPanelWidth = firstPanel ? firstPanel.offsetWidth : 0;
+              reveal.scrollTo({
+                left: leadingScrollPanelWidth,
+                behavior: getScrollBehavior(),
+              });
+            } else {
+              reveal.scrollTo({
+                left: 0,
+                behavior: getScrollBehavior(),
+              });
+            }
+
+            setRevealState(reveal, false);
+            return;
+          }
+
+          const panels = Array.from(reveal.querySelectorAll('.SwipeReveal-panel'));
+          if (panels.length === 0) return;
+
+          let targetScrollLeft = reveal.scrollWidth;
+
+          if (label.includes('leading')) {
+            targetScrollLeft = 0;
+          } else if (label.includes('trailing')) {
+            targetScrollLeft = reveal.scrollWidth;
+          } else if (panels.length === 1) {
+            targetScrollLeft = reveal.scrollWidth;
+          } else {
+            const content = reveal.querySelector('.SwipeReveal-content');
+            const firstTrigger = content ? content.querySelector('[aria-label$="actions"]') : null;
+            targetScrollLeft = trigger === firstTrigger ? 0 : reveal.scrollWidth;
+          }
+
+          reveal.scrollTo({
+            left: targetScrollLeft,
+            behavior: getScrollBehavior(),
+          });
+
+          setRevealState(reveal, true, trigger);
+        });
+      }
+
+      // Sync state on swipe (Scroll Snap Events + geometric fallback) and focus return
+      const reveals = Array.from(document.querySelectorAll('.SwipeReveal'));
+      const supportsSnapEvents = 'onscrollsnapchanging' in HTMLElement.prototype;
+
+      for (const reveal of reveals) {
+        const content = reveal.querySelector('.SwipeReveal-content');
+        if (content) {
+          content.addEventListener('focusin', (event) => {
+            if (event.target instanceof Element && event.target.matches(':focus-visible')) {
+              content.scrollIntoView({ block: 'nearest', inline: 'start' });
+            }
+          });
+        }
+
+        reveal.addEventListener('keydown', (event) => {
+          if (event.key !== 'Escape') return;
+          const trigger = reveal.querySelector('.SwipeReveal-content [aria-label$="actions"]');
+          if (!trigger || trigger.getAttribute('aria-expanded') !== 'true') return;
+          trigger.focus();
+          reveal.scrollTo({ left: 0, behavior: getScrollBehavior() });
+          setRevealState(reveal, false);
+        });
+
+        if (supportsSnapEvents) {
+          reveal.addEventListener('scrollsnapchanging', (event) => {
+            const pendingTarget = event.snapTargetInline;
+            if (!pendingTarget) return;
+            reveal.classList.toggle('is-pending', pendingTarget.classList.contains('SwipeReveal-panel'));
+          });
+
+          reveal.addEventListener('scrollsnapchange', (event) => {
+            const snappedTarget = event.snapTargetInline;
+            if (!snappedTarget) return;
+            setRevealState(reveal, snappedTarget.classList.contains('SwipeReveal-panel'));
+          });
+        } else {
+          let scrollTimeout;
+          let rafId = null;
+
+          const promotePendingToActive = () => {
+            syncRevealFromScroll(reveal);
+          };
+
+          reveal.addEventListener('scroll', () => {
+            if (!rafId) {
+              rafId = requestAnimationFrame(() => {
+                rafId = null;
+                const closest = findClosestSnapTarget(reveal);
+                if (!closest) return;
+                reveal.classList.toggle('is-pending', closest.classList.contains('SwipeReveal-panel'));
+              });
+            }
+
+            clearTimeout(scrollTimeout);
+            scrollTimeout = setTimeout(promotePendingToActive, 100);
+          }, { passive: true });
+
+          reveal.addEventListener('scrollend', () => {
+            clearTimeout(scrollTimeout);
+            promotePendingToActive();
+          });
+        }
+      }
+
+      const initAllReveals = () => {
+        for (const reveal of reveals) {
+          syncRevealFromScroll(reveal);
+        }
+      };
+
+      if (document.readyState === 'complete') {
+        initAllReveals();
+      } else {
+        window.addEventListener('load', initAllReveals, { once: true });
+      }
+
+      // Handle contextual drink action clicks (never auto-triggered on swipe)
+      const statusEl = document.getElementById('favorites-status');
+      for (const actionBtn of document.querySelectorAll('.SwipeReveal-action')) {
+        actionBtn.addEventListener('click', () => {
+          const reveal = actionBtn.closest('.SwipeReveal');
+          const drink = reveal ? reveal.dataset.drink : 'Drink';
+          const action = actionBtn.dataset.action;
+
+          if (action === 'favorite') {
+            const nextPressed = actionBtn.getAttribute('aria-pressed') !== 'true';
+            actionBtn.setAttribute('aria-pressed', nextPressed ? 'true' : 'false');
+            actionBtn.textContent = nextPressed ? 'Favorited' : 'Favorite';
+            if (statusEl) {
+              statusEl.textContent = nextPressed
+                ? `${drink} saved to your favorites.`
+                : `${drink} removed from your favorites.`;
+            }
+          } else if (action === 'order') {
+            if (statusEl) {
+              statusEl.textContent = `${drink} added to your order.`;
+            }
+          } else if (action === 'share') {
+            if (statusEl) {
+              statusEl.textContent = `Share link ready for ${drink}.`;
+            }
+          }
+        });
+      }
+    })();
+  </script>
