+  <script>
+    for (const reveal of document.querySelectorAll('.SwipeReveal')) {
+      const content = reveal.querySelector('.SwipeReveal-content');
+      const panel = reveal.querySelector('.SwipeReveal-panel');
+      const trigger = content?.querySelector('button[aria-controls]');
+      const favorite = panel?.querySelector('button[aria-pressed]');
+      if (!(reveal instanceof HTMLElement) || !content || !panel ||
+          !(trigger instanceof HTMLButtonElement) || !favorite) continue;
+
+      const actions = panel.querySelectorAll('a, button');
+
+      const syncExpanded = () => {
+        const maxOffset = reveal.scrollWidth - reveal.clientWidth;
+        const expanded = maxOffset > 1 && reveal.scrollLeft >= maxOffset - 1;
+        trigger.setAttribute('aria-expanded', String(expanded));
+        for (const action of actions) {
+          action.setAttribute('tabindex', expanded ? '0' : '-1');
+        }
+        if (reveal.scrollLeft <= 1 && panel.contains(document.activeElement)) {
+          trigger.focus({ preventScroll: true });
+        }
+      };
+
+      trigger.addEventListener('click', (event) => {
+        const expanded = trigger.getAttribute('aria-expanded') === 'true';
+        reveal.scrollTo({
+          left: expanded ? 0 : reveal.scrollWidth - reveal.clientWidth,
+          behavior: event.detail === 0 ? 'instant' : 'auto',
+        });
+        syncExpanded();
+      });
+
+      reveal.addEventListener('scroll', syncExpanded, { passive: true });
+      reveal.addEventListener('scrollsnapchange', syncExpanded);
+
+      content.addEventListener('focusin', (event) => {
+        if (event.target instanceof Element && event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+
+      favorite.addEventListener('click', () => {
+        const pressed = favorite.getAttribute('aria-pressed') === 'true';
+        favorite.setAttribute('aria-pressed', String(!pressed));
+      });
+
+      syncExpanded();
+    }
+  </script>
