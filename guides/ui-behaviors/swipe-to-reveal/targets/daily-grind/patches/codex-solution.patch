+  <script>
+    for (const track of document.querySelectorAll('.SwipeReveal')) {
+      const content = track.querySelector('.SwipeReveal-content');
+      const panel = track.querySelector('.SwipeReveal-panel');
+      const reveal = track.querySelector('.reveal-actions');
+      const close = track.querySelector('.close-actions');
+
+      if (!(track instanceof HTMLElement) || !(content instanceof HTMLElement) ||
+          !(panel instanceof HTMLElement) || !(reveal instanceof HTMLButtonElement) ||
+          !(close instanceof HTMLButtonElement)) continue;
+
+      content.addEventListener('focusin', (event) => {
+        if (event.target instanceof Element && event.target.matches(':focus-visible')) {
+          content.scrollIntoView({ block: 'nearest', inline: 'start' });
+        }
+      });
+
+      reveal.addEventListener('click', () => {
+        panel.scrollIntoView({ block: 'nearest', inline: 'end' });
+        const firstAction = panel.querySelector('a');
+        if (firstAction instanceof HTMLElement) firstAction.focus({ preventScroll: true });
+      });
+
+      close.addEventListener('click', () => {
+        track.scrollTo({ left: 0 });
+        reveal.focus({ preventScroll: true });
+      });
+    }
+  </script>
