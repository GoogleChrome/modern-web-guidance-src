+    /* Swipe to reveal: Seasonal Favorites drink cards */
+    .card.SwipeReveal {
+      padding: 0;
+      /* Column 1: full-width drink content. Column 2: auto-sized actions. */
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      overflow-y: hidden;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      /* Fall back to chaining if `chain` is unsupported, then prevent the
+         action strip from bouncing while still chaining to the document. */
+      overscroll-behavior: auto;
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      position: relative;
+      padding: 20px 48px;
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      background: white;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .SwipeReveal-trigger {
+      position: absolute;
+      top: 8px;
+      right: 8px;
+      min-width: 32px;
+      min-height: 32px;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      border: 1px solid var(--secondary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font-size: 1.1rem;
+      line-height: 1;
+      cursor: pointer;
+      transition: background 0.3s;
+    }
+
+    .SwipeReveal-trigger:hover,
+    .SwipeReveal-trigger[aria-expanded="true"] {
+      background: var(--secondary);
+    }
+
+    .SwipeReveal-hint {
+      display: block;
+      margin-top: 10px;
+      font-size: 0.75rem;
+      color: #6d4c41;
+    }
+
+    .SwipeReveal-panel {
+      /* Snapping the trailing panel to `end` brings all actions fully into view. */
+      scroll-snap-align: end;
+      display: flex;
+
+      &:first-child {
+        scroll-snap-align: start;
+      }
