+  <script>
+    (() => {
+      const TRIGGER_SELECTOR = '.SwipeReveal-content [aria-label$="actions"]';
+      const statusRegion = document.getElementById('swipe-status');
+
+      function announce(message) {
+        if (!statusRegion) return;
+        statusRegion.textContent = '';
+        // Defer so repeated identical messages are still announced.
+        requestAnimationFrame(() => {
+          statusRegion.textContent = message;
+        });
+      }
+
+      function setActionTabIndexes(reveal, isOpen) {
+        for (const panel of reveal.querySelectorAll('.SwipeReveal-panel')) {
+          for (const control of panel.querySelectorAll('a, button')) {
+            control.setAttribute('tabindex', isOpen ? '0' : '-1');
+          }
+        }
+      }
+
+      function setExpanded(reveal, isOpen) {
+        for (const actionButton of reveal.querySelectorAll(TRIGGER_SELECTOR)) {
+          actionButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
+        }
+        setActionTabIndexes(reveal, isOpen);
+      }
+
+      // Determine whether the trailing panel is currently revealed based on the
+      // resting scroll position (works for both LTR and RTL writing modes).
+      function isPanelRevealed(reveal) {
+        const panel = reveal.querySelector('.SwipeReveal-panel');
+        if (!panel) return false;
+        return Math.abs(reveal.scrollLeft) > panel.offsetWidth / 2;
+      }
+
+      function syncState(reveal, snapTarget) {
+        const isOpen = snapTarget instanceof Element
+          ? snapTarget.classList.contains('SwipeReveal-panel')
+          : isPanelRevealed(reveal);
+        const trigger = reveal.querySelector(TRIGGER_SELECTOR);
+        const wasOpen = trigger?.getAttribute('aria-expanded') === 'true';
+        if (wasOpen !== isOpen) setExpanded(reveal, isOpen);
+      }
+
+      for (const reveal of document.querySelectorAll('.SwipeReveal')) {
+        // Keep accessibility state in sync when the panel is swiped open/closed
+        // rather than toggled with the trigger button.
+        if ('onscrollsnapchange' in window) {
+          reveal.addEventListener('scrollsnapchange', (event) => {
+            syncState(reveal, event.snapTargetInline);
+          });
+        } else if ('onscrollend' in window) {
+          reveal.addEventListener('scrollend', () => syncState(reveal));
+        } else {
+          let timer;
+          reveal.addEventListener('scroll', () => {
+            clearTimeout(timer);
+            timer = setTimeout(() => syncState(reveal), 150);
+          }, { passive: true });
+        }
+
+        // Tabbing back into the content closes the panel (keyboard only, so
+        // pointer interactions are unaffected).
+        const content = reveal.querySelector('.SwipeReveal-content');
+        content?.addEventListener('focusin', (event) => {
+          const target = event.target;
+          if (!(target instanceof Element) || !target.matches(':focus-visible')) return;
+          if (target.matches(TRIGGER_SELECTOR)) return;
+          if (isPanelRevealed(reveal)) {
+            content.scrollIntoView({ block: 'nearest', inline: 'start' });
+            setExpanded(reveal, false);
+          }
+        });
+      }
+
+      for (const trigger of document.querySelectorAll(TRIGGER_SELECTOR)) {
+        trigger.addEventListener('click', () => {
+          const reveal = trigger.closest('.SwipeReveal');
+          if (!reveal) return;
+
+          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
+          if (isExpanded) {
+            reveal.scrollTo({ left: 0 });
+            setExpanded(reveal, false);
+            return;
+          }
+
+          if (!reveal.querySelector('.SwipeReveal-panel')) return;
+
+          const isRtl = getComputedStyle(reveal).direction === 'rtl';
+          reveal.scrollTo({ left: isRtl ? -reveal.scrollWidth : reveal.scrollWidth });
+          setExpanded(reveal, true);
+        });
+      }
+
+      // Actions are only executed when the user explicitly activates them.
+      for (const favorite of document.querySelectorAll('.SwipeReveal-action--favorite')) {
+        favorite.addEventListener('click', () => {
+          const pressed = favorite.getAttribute('aria-pressed') === 'true';
+          favorite.setAttribute('aria-pressed', pressed ? 'false' : 'true');
+          favorite.textContent = pressed ? 'Favorite' : 'Favorited';
+          const name = (favorite.getAttribute('aria-label') || '').replace(/^Favorite\s+/, '');
+          announce(pressed ? `${name} removed from favorites` : `${name} added to favorites`);
+        });
+      }
+
+      for (const share of document.querySelectorAll('.SwipeReveal-action--share')) {
+        share.addEventListener('click', async () => {
+          const name = (share.getAttribute('aria-label') || '').replace(/^Share\s+/, '');
+          const url = new URL(share.dataset.shareUrl || '/', window.location.href).href;
+          try {
+            if (navigator.share) {
+              await navigator.share({ title: name, url });
+            } else if (navigator.clipboard) {
+              await navigator.clipboard.writeText(url);
+              announce(`Link to ${name} copied to clipboard`);
+            } else {
+              announce(`Sharing is not supported in this browser`);
+            }
+          } catch (error) {
+            if (error instanceof DOMException && error.name === 'AbortError') return;
+            announce(`Could not share ${name}`);
+          }
+        });
+      }
+    })();
+  </script>
+
