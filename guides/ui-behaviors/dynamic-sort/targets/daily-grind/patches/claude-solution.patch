+  <script>
+    (() => {
+      const grid = document.getElementById('seasonal-grid');
+      const select = document.getElementById('seasonal-sort');
+      const status = document.getElementById('seasonal-sort-status');
+      if (!grid || !select || !status) return;
+
+      // Above this many items, capturing every card for a view transition is too costly.
+      const MAX_ANIMATED_ITEMS = 300;
+
+      const cards = Array.from(grid.children);
+      // Remember the original (featured) order once, without touching layout.
+      cards.forEach((card, index) => { card.dataset.featuredIndex = String(index); });
+
+      const nameOf = (card) => (card.querySelector('h3')?.textContent ?? '').trim();
+      const collator = new Intl.Collator(undefined, { sensitivity: 'base', numeric: true });
+
+      const sorters = {
+        'featured': {
+          label: 'featured',
+          compare: (a, b) => Number(a.dataset.featuredIndex) - Number(b.dataset.featuredIndex),
+        },
+        'name-asc': {
+          label: 'name, A to Z',
+          compare: (a, b) => collator.compare(nameOf(a), nameOf(b)),
+        },
+        'name-desc': {
+          label: 'name, Z to A',
+          compare: (a, b) => collator.compare(nameOf(b), nameOf(a)),
+        },
+      };
+
+      const supportsMoveBefore = Object.hasOwn(Element.prototype, 'moveBefore');
+
+      // Move the existing nodes into the new order (never recreate them).
+      function reorder(container, orderedNodes) {
+        const move = supportsMoveBefore
+          ? (node) => container.moveBefore(node, null)
+          : (node) => container.append(node);
+        for (const node of orderedNodes) move(node);
+      }
+
+      function reorderWithTransition(container, orderedNodes) {
+        const update = () => reorder(container, orderedNodes);
+
+        if (orderedNodes.length > MAX_ANIMATED_ITEMS) {
+          update();
+        } else if (typeof container.startViewTransition === 'function') {
+          // Scoped transition: the rest of the page stays interactive.
+          container.startViewTransition(update);
+        } else if (typeof document.startViewTransition === 'function') {
+          document.startViewTransition(update);
+        } else {
+          update();
+        }
+      }
+
+      select.addEventListener('change', () => {
+        const sorter = sorters[select.value] ?? sorters.featured;
+        const ordered = Array.from(grid.children).sort(sorter.compare);
+
+        reorderWithTransition(grid, ordered);
+
+        // Announce the result once; focus stays on the select.
+        const count = ordered.length;
+        status.textContent = `Sorted by ${sorter.label}, ${count} ${count === 1 ? 'item' : 'items'}`;
+      });
+    })();
+  </script>
+
