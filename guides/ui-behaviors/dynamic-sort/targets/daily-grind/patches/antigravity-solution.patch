+  <script>
+    (function () {
+      const grid = document.getElementById('favorites-grid') || document.querySelector('.grid');
+      const sortSelect = document.getElementById('sort');
+      const statusEl = document.getElementById('reorder-status');
+      const sortNameBtn = document.getElementById('sort-name');
+      const sortPriceBtn = document.getElementById('sort-price');
+      const directionBtn = document.getElementById('direction');
+      const sortReverseBtn = document.getElementById('sort-reverse');
+
+      if (!grid) return;
+
+      // Assign initial index to preserve original order
+      Array.from(grid.children).forEach((card, index) => {
+        if (!card.dataset.initialIndex) {
+          card.dataset.initialIndex = String(index);
+        }
+      });
+
+      const collator = new Intl.Collator(document.documentElement.lang || undefined, {
+        numeric: true,
+        sensitivity: 'base',
+      });
+
+      function getCardName(card) {
+        return card.dataset.name || card.querySelector('h3')?.textContent?.trim() || card.textContent?.trim() || '';
+      }
+
+      function getCardPrice(card) {
+        if (card.dataset.price) {
+          const val = parseFloat(card.dataset.price);
+          if (!isNaN(val)) return val;
+        }
+        const match = card.textContent?.match(/\$(\d+(?:\.\d+)?)/);
+        return match ? parseFloat(match[1]) : 0;
+      }
+
+      const comparators = {
+        'default': (a, b) => Number(a.dataset.initialIndex || 0) - Number(b.dataset.initialIndex || 0),
+        'name-asc': (a, b) => collator.compare(getCardName(a), getCardName(b)),
+        'name-desc': (a, b) => collator.compare(getCardName(b), getCardName(a)),
+        'price-asc': (a, b) => (getCardPrice(a) - getCardPrice(b)) || collator.compare(getCardName(a), getCardName(b)),
+        'price-desc': (a, b) => (getCardPrice(b) - getCardPrice(a)) || collator.compare(getCardName(a), getCardName(b)),
+      };
+
+      // Reorder existing DOM nodes into the new order without recreating them
+      function reorder(container, orderedNodes) {
+        const supportsMoveBefore =
+          Object.hasOwn(Element.prototype, 'moveBefore') ||
+          'moveBefore' in Element.prototype;
+
+        let move;
+        if (supportsMoveBefore) {
+          move = (node) => container.moveBefore(node, null);
+        } else {
+          // Fallback for browsers that do not support moveBefore
+          move = (node) => container.append(node);
+        }
+
+        for (const node of orderedNodes) {
+          move(node);
+        }
+      }
+
+      // Optionally animate the reorder with view transitions
+      function reorderWithTransition(list, orderedNodes) {
+        const update = () => reorder(list, orderedNodes);
+
+        // Large lists: skip the view transition when the list is larger than a few hundred items
+        if (orderedNodes.length > 200) {
+          update();
+          return;
+        }
+
+        // Prefer a transition scoped to the list: the rest of the page stays interactive.
+        // Fall back to a document-level transition, then to a plain update.
+        if (list.startViewTransition) {
+          const transition = list.startViewTransition(update);
+          transition?.ready?.catch?.(() => {});
+        } else if (document.startViewTransition) {
+          const transition = document.startViewTransition(update);
+          transition?.ready?.catch?.(() => {});
+        } else {
+          update();
+        }
+      }
+
+      function announce(message) {
+        if (statusEl) {
+          statusEl.textContent = message;
+        }
+      }
+
+      let currentSortKey = 'default';
+      let isDescending = false;
+
+      function updateControlsUI(key, desc) {
+        if (sortNameBtn) {
+          sortNameBtn.setAttribute('aria-pressed', String(key === 'name'));
+        }
+        if (sortPriceBtn) {
+          sortPriceBtn.setAttribute('aria-pressed', String(key === 'price'));
+        }
+        if (directionBtn) {
+          directionBtn.setAttribute('aria-pressed', String(desc));
+          directionBtn.textContent = desc ? 'Descending' : 'Ascending';
+        }
+        if (sortReverseBtn) {
+          sortReverseBtn.setAttribute('aria-pressed', String(key === 'reverse'));
+        }
+      }
+
+      function executeSort(sortType, desc, customLabel) {
+        currentSortKey = sortType;
+        isDescending = desc;
+
+        const currentCards = Array.from(grid.children);
+        if (currentCards.length === 0) return;
+
+        let ordered;
+        let descriptor = customLabel;
+
+        if (sortType === 'reverse') {
+          ordered = [...currentCards].reverse();
+          descriptor = descriptor || 'reverse order';
+        } else if (sortType === 'default') {
+          ordered = [...currentCards].sort(comparators['default']);
+          descriptor = descriptor || 'Featured';
+        } else {
+          const compKey = `${sortType}-${desc ? 'desc' : 'asc'}`;
+          if (comparators[compKey]) {
+            ordered = [...currentCards].sort(comparators[compKey]);
+          } else {
+            ordered = currentCards;
+          }
+          if (!descriptor) {
+            const directionText = desc ? (sortType === 'name' ? 'Z to A' : 'high to low') : (sortType === 'name' ? 'A to Z' : 'low to high');
+            const typeText = sortType === 'name' ? 'Name' : 'Price';
+            descriptor = `${typeText} (${directionText})`;
+          }
+        }
+
+        reorderWithTransition(grid, ordered);
+        announce(`Sorted by ${descriptor}, ${ordered.length} items`);
+        updateControlsUI(sortType, desc);
+      }
+
+      if (sortSelect) {
+        sortSelect.addEventListener('change', () => {
+          const val = sortSelect.value;
+          const selectedOption = sortSelect.selectedOptions[0];
+          const label = selectedOption ? selectedOption.text : val;
+
+          if (val === 'default') {
+            executeSort('default', false, label);
+          } else if (val === 'name-asc') {
+            executeSort('name', false, label);
+          } else if (val === 'name-desc') {
+            executeSort('name', true, label);
+          } else if (val === 'price-asc') {
+            executeSort('price', false, label);
+          } else if (val === 'price-desc') {
+            executeSort('price', true, label);
+          }
+        });
+      }
+
+      if (sortNameBtn) {
+        sortNameBtn.addEventListener('click', () => {
+          const newDesc = currentSortKey === 'name' ? !isDescending : false;
+          const val = newDesc ? 'name-desc' : 'name-asc';
+          if (sortSelect) sortSelect.value = val;
+          const opt = sortSelect ? Array.from(sortSelect.options).find((o) => o.value === val) : null;
+          executeSort('name', newDesc, opt?.text);
+        });
+      }
+
+      if (sortPriceBtn) {
+        sortPriceBtn.addEventListener('click', () => {
+          const newDesc = currentSortKey === 'price' ? !isDescending : false;
+          const val = newDesc ? 'price-desc' : 'price-asc';
+          if (sortSelect) sortSelect.value = val;
+          const opt = sortSelect ? Array.from(sortSelect.options).find((o) => o.value === val) : null;
+          executeSort('price', newDesc, opt?.text);
+        });
+      }
+
+      if (directionBtn) {
+        directionBtn.addEventListener('click', () => {
+          const newDesc = !isDescending;
+          const key = (currentSortKey === 'name' || currentSortKey === 'price') ? currentSortKey : 'name';
+          const val = `${key}-${newDesc ? 'desc' : 'asc'}`;
+          if (sortSelect) sortSelect.value = val;
+          const opt = sortSelect ? Array.from(sortSelect.options).find((o) => o.value === val) : null;
+          executeSort(key, newDesc, opt?.text);
+        });
+      }
+
+      if (sortReverseBtn) {
+        sortReverseBtn.addEventListener('click', () => {
+          executeSort('reverse', false, 'reverse order');
+        });
+      }
+    })();
+  </script>
+
 </body>
 
