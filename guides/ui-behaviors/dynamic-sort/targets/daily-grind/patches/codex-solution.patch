diff --git a/seasonal-sort.js b/seasonal-sort.js
new file mode 100644
index 0000000..1cb0992
--- /dev/null
+++ b/seasonal-sort.js
@@ -0,0 +1,75 @@
+(() => {
+  const list = document.getElementById('seasonal-favorites');
+  const control = document.getElementById('seasonal-sort');
+  const controls = document.getElementById('seasonal-sort-controls');
+  const status = document.getElementById('seasonal-sort-status');
+  if (!(list instanceof HTMLElement) || !(control instanceof HTMLSelectElement)
+      || !controls || !status) return;
+
+  // Cache keys once; sorting and moving never read layout or replace cards.
+  const cards = Array.from(list.children).map((node, index) => ({
+    node,
+    index,
+    name: node.querySelector('h3')?.textContent?.trim() ?? '',
+  }));
+  const collator = new Intl.Collator(document.documentElement.lang, { sensitivity: 'base' });
+  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+  const animationLimit = 200;
+  let revision = 0;
+  let activeTransition;
+
+  controls.hidden = false;
+  control.addEventListener('change', () => {
+    const currentRevision = ++revision;
+    activeTransition?.skipTransition();
+    const order = control.value;
+    const ordered = [...cards].sort((a, b) => {
+      if (order === 'featured') return a.index - b.index;
+      const comparison = collator.compare(a.name, b.name);
+      return (order === 'name-desc' ? -comparison : comparison) || a.index - b.index;
+    });
+    const label = control.selectedOptions[0]?.textContent ?? 'Featured order';
+    const update = () => {
+      // A skipped transition may still invoke its callback after a newer choice.
+      if (currentRevision !== revision) return;
+      for (const { node } of ordered) {
+        if (typeof list.moveBefore === 'function') list.moveBefore(node, null);
+        else list.append(node);
+      }
+      status.textContent = `Sorted by ${label}, ${ordered.length} items.`;
+    };
+
+    if (reducedMotion.matches || cards.length > animationLimit) {
+      list.classList.remove('animate-sort');
+      update();
+      return;
+    }
+
+    const scope = typeof list.startViewTransition === 'function' ? list : document;
+    if (typeof scope.startViewTransition !== 'function') {
+      update();
+      return;
+    }
+
+    list.classList.add('animate-sort');
+    try {
+      const transition = scope.startViewTransition(update);
+      activeTransition = transition;
+      // Unsupported capture conditions must never prevent sorting.
+      transition.ready.catch(() => {});
+      transition.finished.catch(() => {}).finally(() => {
+        if (currentRevision === revision) {
+          list.classList.remove('animate-sort');
+          activeTransition = undefined;
+        }
+      });
+    } catch {
+      list.classList.remove('animate-sort');
+      update();
+    }
+  });
+
+  reducedMotion.addEventListener('change', () => {
+    if (reducedMotion.matches) activeTransition?.skipTransition();
+  });
+})();
