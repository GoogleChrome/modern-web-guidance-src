diff --git a/js/card-links.js b/js/card-links.js
new file mode 100644
index 0000000..7cdc698
--- /dev/null
+++ b/js/card-links.js
@@ -0,0 +1,12 @@
+// DO: assign the shared morph name on the specific card the user
+// clicked, right before navigation starts. This is non-critical to
+// this page's own render, so it is loaded as a plain deferred
+// module rather than blocking="render".
+document.querySelectorAll('.card[data-item] a.btn').forEach((link) => {
+  link.addEventListener('click', () => {
+    const title = link.closest('.card')?.querySelector('h3');
+    if (title) {
+      title.style.viewTransitionName = 'menu-heading';
+    }
+  });
+});
diff --git a/js/menu-highlight.js b/js/menu-highlight.js
new file mode 100644
index 0000000..985f6b1
--- /dev/null
+++ b/js/menu-highlight.js
@@ -0,0 +1,8 @@
+// Non-critical enhancement: highlights the menu row matching the
+// `item` query param (set when arriving via a "View Details" link).
+// Not required for the initial render, so this loads as a plain
+// deferred module rather than blocking="render".
+const item = new URLSearchParams(location.search).get('item');
+if (item) {
+  document.querySelector(`.menu-item[data-item="${item}"]`)?.classList.add('is-highlighted');
+}
diff --git a/js/theme.js b/js/theme.js
new file mode 100644
index 0000000..16155b8
--- /dev/null
+++ b/js/theme.js
@@ -0,0 +1,6 @@
+// DO: apply the stored theme before first paint so the view
+// transition snapshot reflects the correct theme. Marked
+// blocking="render" in the document head so this always runs
+// before the transition animates, regardless of module timing.
+const storedTheme = localStorage.getItem('theme');
+document.documentElement.dataset.theme = storedTheme === 'dark' ? 'dark' : 'light';
diff --git a/js/transition-setup.js b/js/transition-setup.js
new file mode 100644
index 0000000..74cecca
--- /dev/null
+++ b/js/transition-setup.js
@@ -0,0 +1,43 @@
+// MANDATORY: This listener must be registered before the page renders.
+// Loaded as an async, blocking="render" script in the head so it is
+// registered early without blocking HTML parsing. If registered too
+// late (e.g. a deferred script), the pagereveal event may already
+// have fired.
+window.addEventListener('pagereveal', async (event) => {
+  // Graceful degradation: browsers without view transition support
+  // never populate event.viewTransition, so this is a no-op there.
+  if (!event.viewTransition) return;
+
+  // Optional chaining keeps this safe in browsers without the
+  // Navigation API (e.g. Firefox, Safari) instead of throwing on a
+  // missing global.
+  const from = window.navigation?.activation?.from;
+  if (!from) return;
+
+  let fromUrl;
+  try {
+    fromUrl = new URL(from.url);
+  } catch {
+    return;
+  }
+
+  const cameFromHome = fromUrl.pathname === '/' || fromUrl.pathname === '/index.html';
+
+  // DO: only assign the dynamic name on the destination page, and
+  // only when the navigation context calls for a morph (arriving
+  // from the homepage's product grid). This mirrors the source
+  // page, where only the clicked card's title receives the matching
+  // name (see js/card-links.js) so no two elements ever share it.
+  if (location.pathname === '/menu.html' && cameFromHome) {
+    const heading = document.querySelector('#menu-heading');
+    if (heading) {
+      heading.style.viewTransitionName = 'menu-heading';
+
+      // MANDATORY: Remove the temporary name after the transition
+      // finishes. Stale names interfere with subsequent navigations
+      // and prevent the page from entering the bfcache.
+      await event.viewTransition.finished;
+      heading.style.viewTransitionName = '';
+    }
+  }
+});
