new file mode 100644
index 0000000..7a6c589
--- /dev/null
+++ b/css/styles.css
@@ -0,0 +1,274 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+/*
+  MANDATORY: Include this rule in every page that participates
+  in cross-document view transitions.
+  `navigation: auto` enables transitions for standard navigations
+  (link clicks, form submissions, back/forward).
+*/
+@view-transition {
+  navigation: auto;
+}
+
+/* MANDATORY Copy-Paste Safety: Disable cross-document view transitions for users requesting reduced motion */
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+[data-theme='dark'] {
+  --primary: #2b1f1c;
+  --secondary: #4e342e;
+  --accent: #ffc978;
+  --text: #f5efe6;
+  --light: #1c1512;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  /* DO: assign statically via CSS since the logo represents the
+     same persistent element on every page, regardless of where
+     the user navigated from. */
+  view-transition-name: site-logo;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+nav a[aria-current='page'] {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  min-height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  align-items: center;
+  gap: 2rem;
+  color: white;
+  text-align: center;
+  padding: 40px 20px;
+}
+
+.hero-content {
+  max-width: 600px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Sidebar callout: only shown to users on wider viewports, so it
+   is only render-blocked on those viewports (see <link rel="expect">
+   media attribute in the document head). */
+.hero-sidebar {
+  display: none;
+  background: rgba(0, 0, 0, 0.45);
+  border: 1px solid var(--accent);
+  border-radius: 8px;
+  padding: 20px 24px;
+  max-width: 260px;
+  text-align: left;
+}
+
+.hero-sidebar h2 {
+  font-size: 1.1rem;
+  color: var(--accent);
+  margin-bottom: 8px;
+}
+
+@media (min-width: 769px) {
+  .hero-sidebar {
+    display: block;
+  }
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+/*
+  DO: give each card title its own unique static name so it can
+  morph into the matching heading on the destination page. Each
+  selector below targets exactly one element per page, so no two
+  elements ever share a name (see data-item attribute on each card).
+*/
+.card[data-item='seasonal'] h3 {
+  view-transition-name: item-seasonal-title;
+}
+
+.card[data-item='espresso'] h3 {
+  view-transition-name: item-espresso-title;
+}
+
+.card[data-item='cold-brew'] h3 {
+  view-transition-name: item-cold-brew-title;
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Menu page */
+.menu-hero {
+  background: var(--primary);
+  color: white;
+  text-align: center;
+  padding: 60px 20px;
+}
+
+.menu-hero h1 {
+  font-size: 2.5rem;
+  margin-bottom: 0.5rem;
+}
+
+.menu-hero p {
+  color: var(--secondary);
+}
+
+.menu-section h2 {
+  color: var(--primary);
+  margin-bottom: 10px;
+}
+
+.menu-item {
+  display: flex;
+  justify-content: space-between;
+  gap: 20px;
+  padding: 16px 0;
+  border-bottom: 1px solid var(--secondary);
+}
+
+.menu-item:last-child {
+  border-bottom: none;
+}
+
+.menu-item .price {
+  font-weight: bold;
+  color: var(--primary);
+  white-space: nowrap;
+}
+
+.menu-item.is-highlighted {
+  background: var(--secondary);
+  border-radius: 8px;
+  padding-left: 12px;
+  padding-right: 12px;
+}
