+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Menu | The Daily Grind</title>
+
+  <!-- Render-blocking by default when placed in <head>: this contains
+       the mandatory @view-transition opt-in, so it must not be
+       dynamically injected without blocking="render". -->
+  <link rel="stylesheet" href="/css/styles.css">
+
+  <!--
+    DO: Mark layout-critical scripts with blocking="render".
+    Applies the stored theme before first paint so the transition
+    snapshot reflects the correct theme.
+  -->
+  <script type="module" blocking="render" src="/js/theme.js"></script>
+
+  <!--
+    MANDATORY: Registers the pagereveal listener before the page
+    renders. This is the destination page for the card-to-heading
+    morph, so the listener must be in place before the transition
+    starts (see js/transition-setup.js).
+  -->
+  <script async blocking="render" src="/js/transition-setup.js"></script>
+
+  <!--
+    DO: Block rendering until the hero heading has been parsed.
+    Without this, the browser could snapshot the new page before
+    #menu-heading exists, degrading the morph from the clicked
+    product card into a plain fade-out/fade-in.
+  -->
+  <link rel="expect" href="#menu-heading" blocking="render">
+</head>
+
+<body>
+
+  <nav>
+    <div class="logo">THE DAILY GRIND</div>
+    <ul>
+      <li><a href="/menu.html" aria-current="page">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="menu-hero" id="menu-hero">
+    <h1 id="menu-heading">Our Full Menu</h1>
+    <p>Freshly roasted, brewed to order, every single day.</p>
+  </header>
+
+  <!-- Below-the-fold content is intentionally NOT render-blocked. -->
+  <main class="container">
+    <section class="menu-section">
+      <h2>Coffee</h2>
+      <div class="menu-item" data-item="espresso">
+        <div>
+          <strong>Dark Roast Espresso</strong>
+          <p>Bold, smokey, and perfect for a morning boost.</p>
+        </div>
+        <span class="price">$3.25</span>
+      </div>
+      <div class="menu-item" data-item="cold-brew">
+        <div>
+          <strong>Cold Brew</strong>
+          <p>Steeped for 18 hours for maximum smoothness.</p>
+        </div>
+        <span class="price">$4.50</span>
+      </div>
+      <div class="menu-item">
+        <div>
+          <strong>Drip Coffee</strong>
+          <p>A classic cup of our house blend.</p>
+        </div>
+        <span class="price">$2.75</span>
+      </div>
+    </section>
+
+    <section class="menu-section">
+      <h2>Seasonal Favorites</h2>
+      <div class="menu-item" data-item="seasonal">
+        <div>
+          <strong>Maple Oat Latte</strong>
+          <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
+        </div>
+        <span class="price">$5.25</span>
+      </div>
+      <div class="menu-item">
+        <div>
+          <strong>Cinnamon Cappuccino</strong>
+          <p>Silky microfoam dusted with Ceylon cinnamon.</p>
+        </div>
+        <span class="price">$4.75</span>
+      </div>
+      <div class="menu-item">
+        <div>
+          <strong>Mocha</strong>
+          <p>Rich espresso and dark chocolate, topped with cream.</p>
+        </div>
+        <span class="price">$5.00</span>
+      </div>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <!-- Non-critical to this page's own render: safe to load normally. -->
+  <script type="module" src="/js/menu-highlight.js"></script>
+
+</body>
+
+</html>
