+import { cp, mkdir, readFile, rm } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const pages = ['index.html', 'menu.html'];
+
+for (const page of pages) {
+  const html = await readFile(path.join(root, page), 'utf8');
+  const requiredPatterns = [
+    /@view-transition\s*{\s*navigation:\s*auto;/,
+    /@media\s*\(prefers-reduced-motion:\s*reduce\)[\s\S]*?@view-transition\s*{\s*navigation:\s*none;/,
+    /<link\s+rel="expect"[^>]+blocking="render"[^>]+media=/,
+    /<script\s+blocking="render">/,
+  ];
+
+  for (const pattern of requiredPatterns) {
+    if (!pattern.test(html)) {
+      throw new Error(`${page} is missing required transition markup: ${pattern}`);
+    }
+  }
+}
+
+const output = path.join(root, 'dist');
+await rm(output, { recursive: true, force: true });
+await mkdir(output, { recursive: true });
+await Promise.all(pages.map((page) => cp(path.join(root, page), path.join(output, page))));
+
+console.log(`Built ${pages.length} pages into dist/.`);
