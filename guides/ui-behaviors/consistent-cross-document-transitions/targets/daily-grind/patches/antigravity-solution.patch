diff --git a/js/transition-setup.js b/js/transition-setup.js
new file mode 100644
index 0000000..cb4eef8
--- /dev/null
+++ b/js/transition-setup.js
@@ -0,0 +1,45 @@
+// Apply initial theme and layout state before rendering begins
+document.documentElement.dataset.theme =
+  localStorage.getItem('theme') || 'light';
+document.documentElement.dataset.layout =
+  localStorage.getItem('layout') || 'grid';
+
+window.addEventListener('pagereveal', async (event) => {
+  if (!event.viewTransition) return;
+
+  const from =
+    typeof navigation !== 'undefined' ? navigation.activation?.from : null;
+  if (!from) return;
+
+  const fromUrl = new URL(from.url);
+  const normalizePath = (p) => p.replace(/\.html$/, '').replace(/\/$/, '') || '/';
+  const fromPath = normalizePath(fromUrl.pathname);
+  const toPath = normalizePath(window.location.pathname);
+
+  let targetElement = null;
+
+  if ((fromPath === '/' || fromPath === '/menu') && toPath.startsWith('/menu/')) {
+    targetElement = document.querySelector('#seasonal-favorites .card[data-featured="true"] h3');
+  } else if (fromPath.startsWith('/menu/') && (toPath === '/' || toPath === '/menu')) {
+    const slug = fromPath.split('/').pop();
+    targetElement = document.querySelector(`#seasonal-favorites .card[data-item="${slug}"] h3`);
+  }
+
+  if (!targetElement) return;
+
+  targetElement.style.viewTransitionName = 'featured-item-title';
+
+  try {
+    await event.viewTransition.ready;
+  } catch (error) {
+    // Skipped view transitions reject `ready` with InvalidStateError.
+    if (error.name !== 'InvalidStateError') {
+      throw error;
+    }
+  } finally {
+    // MANDATORY: Remove the temporary name after the transition finishes
+    // so stale names do not interfere with subsequent navigations or bfcache.
+    await event.viewTransition.finished;
+    targetElement.style.viewTransitionName = '';
+  }
+});
