+  <script>
+    (() => {
+      // Daily roast banner pause / resume
+      const banner = document.querySelector('.roast-banner');
+      const toggle = banner?.querySelector('.roast-banner__toggle');
+      toggle?.addEventListener('click', () => {
+        const paused = banner.classList.toggle('is-paused');
+        toggle.setAttribute('aria-pressed', String(paused));
+        toggle.textContent = paused ? 'Play' : 'Pause';
+      });
+
+      // Drink details overlay
+      const drinks = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          sizes: '12 oz, 16 oz, 20 oz',
+          caffeine: '150 mg (16 oz)',
+          notes: 'Maple, toasted oat, caramel'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          sizes: 'Single, Double',
+          caffeine: '130 mg (double)',
+          notes: 'Dark chocolate, smoke, molasses'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          sizes: '16 oz, 24 oz',
+          caffeine: '200 mg (16 oz)',
+          notes: 'Cocoa, brown sugar, low acidity'
+        }
+      };
+
+      const dialog = document.querySelector('.drink-dialog');
+      if (dialog && typeof dialog.showModal === 'function') {
+        const title = dialog.querySelector('#drink-dialog-title');
+        const description = dialog.querySelector('.drink-dialog__description');
+        const link = dialog.querySelector('.drink-dialog__link');
+
+        document.querySelectorAll('.card .btn[data-drink]').forEach((button) => {
+          button.addEventListener('click', (event) => {
+            const drink = drinks[button.dataset.drink];
+            if (!drink) return; // fall back to normal navigation
+            event.preventDefault();
+            title.textContent = drink.name;
+            description.textContent = drink.description;
+            for (const field of ['sizes', 'caffeine', 'notes']) {
+              dialog.querySelector(`[data-field="${field}"]`).textContent = drink[field];
+            }
+            link.href = button.getAttribute('href');
+            dialog.showModal();
+          });
+        });
+
+        // Close when clicking the backdrop
+        dialog.addEventListener('click', (event) => {
+          if (event.target === dialog) dialog.close();
+        });
+      }
+
+      // Animation / transition event tracking
+      const supportsAnimationEventObject =
+        typeof AnimationEvent !== 'undefined' && 'animation' in AnimationEvent.prototype;
+      const supportsTransitionEventObject =
+        typeof TransitionEvent !== 'undefined' && 'animation' in TransitionEvent.prototype;
+
+      const resolveAnimation = (event) => {
+        const isTransition = event instanceof TransitionEvent;
+        const supported = isTransition ? supportsTransitionEventObject : supportsAnimationEventObject;
+        // Preferred: the exact Animation object that fired the event
+        if (supported && event.animation) return event.animation;
+        // Fallback for engines without event.animation
+        if (!(event.target instanceof Element)) return null;
+        return event.target.getAnimations().find((anim) =>
+          isTransition
+            ? anim.transitionProperty === event.propertyName
+            : anim.animationName === event.animationName
+        ) ?? null;
+      };
+
+      const recordState = (event) => {
+        const animation = resolveAnimation(event);
+        const name = animation
+          ? animation.animationName ?? animation.transitionProperty ?? animation.id ?? 'animation'
+          : event.animationName ?? event.propertyName ?? 'unknown';
+        const pseudo = animation?.effect?.pseudoElement ?? event.pseudoElement ?? '';
+        const playState = animation?.playState ?? 'unknown';
+        document.body.dataset.lastAnimationState =
+          `${event.type}:${name}${pseudo}:${playState}`;
+      };
+
+      [
+        'animationstart',
+        'animationiteration',
+        'animationend',
+        'animationcancel',
+        'transitionrun',
+        'transitionstart',
+        'transitionend',
+        'transitioncancel'
+      ].forEach((type) => document.addEventListener(type, recordState));
+    })();
+  </script>
