diff --git a/script.js b/script.js
new file mode 100644
index 0000000..a21427f
--- /dev/null
+++ b/script.js
@@ -0,0 +1,135 @@
+// @ts-check
+
+/** @param {Event} event */
+function recordAnimationState(event) {
+  if (!(event instanceof AnimationEvent || event instanceof TransitionEvent)) return;
+  // Read the exact animation from the event, including pseudo-element animations.
+  // Older browsers do not expose this property; keep tracking their event lifecycle.
+  const animation = /** @type {(AnimationEvent | TransitionEvent) & { animation?: Animation }} */ (event).animation;
+  const fallback = event.type.endsWith('cancel') ? 'idle'
+    : event.type.endsWith('end') ? 'finished'
+    : event.type === 'transitionrun' ? 'pending' : 'running';
+  document.body.dataset.lastAnimationState = animation?.playState ?? fallback;
+}
+
+for (const type of [
+  'animationstart', 'animationiteration', 'animationend', 'animationcancel',
+  'transitionrun', 'transitionstart', 'transitionend', 'transitioncancel',
+]) {
+  document.addEventListener(type, recordAnimationState);
+}
+
+const banner = document.querySelector('.roast-banner');
+const toggle = document.querySelector('.roast-toggle');
+const motionNote = document.querySelector('.motion-note');
+const dialog = document.querySelector('#drink-details');
+const title = document.querySelector('#drink-title');
+const description = document.querySelector('#drink-description');
+const notes = document.querySelector('#drink-notes');
+const closeButton = document.querySelector('.dialog-close');
+
+if (!(banner instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)
+  || !(motionNote instanceof HTMLElement) || !(dialog instanceof HTMLDialogElement)
+  || !(title instanceof HTMLElement) || !(description instanceof HTMLElement)
+  || !(notes instanceof HTMLElement) || !(closeButton instanceof HTMLButtonElement)) {
+  throw new Error('Daily Grind UI is missing required elements.');
+}
+
+const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+let paused = false;
+const syncBanner = () => {
+  banner.classList.toggle('is-paused', paused || reducedMotion.matches);
+  toggle.hidden = reducedMotion.matches;
+  motionNote.hidden = !reducedMotion.matches;
+  toggle.setAttribute('aria-pressed', String(paused));
+  toggle.textContent = paused ? 'Resume roast banner' : 'Pause roast banner';
+};
+toggle.addEventListener('click', () => {
+  paused = !paused;
+  syncBanner();
+});
+reducedMotion.addEventListener('change', syncBanner);
+syncBanner();
+
+/** @type {Record<string, {name: string, description: string, notes: string}>} */
+const drinks = {
+  maple: {
+    name: 'Maple Oat Latte',
+    description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+    notes: 'Espresso meets silky oat milk and gentle maple sweetness. A cozy seasonal favorite.',
+  },
+  espresso: {
+    name: 'Dark Roast Espresso',
+    description: 'Bold, smokey, and perfect for a morning boost.',
+    notes: 'A concentrated dark roast with a rich aroma and a lingering, full-bodied finish.',
+  },
+  'cold-brew': {
+    name: 'Cold Brew',
+    description: 'Steeped for 18 hours for maximum smoothness.',
+    notes: 'Slow-steeped coffee served cold for a mellow, refreshing sip.',
+  },
+};
+
+/** @type {number | undefined} */
+let closeTimer;
+/** @type {HTMLButtonElement | null} */
+let detailsOpener = null;
+
+const finishClose = () => {
+  window.clearTimeout(closeTimer);
+  closeTimer = undefined;
+  dialog.close();
+};
+const closeDetails = () => {
+  if (!dialog.open || dialog.classList.contains('is-closing')) return;
+  // Keep the dialog modal and focus trapped throughout its exit transition.
+  dialog.classList.add('is-closing');
+  // Also finish when a transition is unavailable or cancelled by a preference change.
+  closeTimer = window.setTimeout(finishClose, 280);
+};
+
+document.querySelectorAll('button[data-drink]').forEach((button) => {
+  if (!(button instanceof HTMLButtonElement)) return;
+  button.addEventListener('click', () => {
+    const drink = drinks[button.dataset.drink ?? ''];
+    if (!drink || dialog.open) return;
+    detailsOpener = button;
+    title.textContent = drink.name;
+    description.textContent = drink.description;
+    notes.textContent = drink.notes;
+    dialog.classList.remove('is-closing');
+    dialog.showModal();
+  });
+});
+closeButton.addEventListener('click', closeDetails);
+dialog.addEventListener('cancel', (event) => {
+  event.preventDefault();
+  closeDetails();
+});
+dialog.addEventListener('transitionend', (event) => {
+  if (event.target === dialog && event.pseudoElement === ''
+    && event.propertyName === 'opacity' && dialog.classList.contains('is-closing')) {
+    finishClose();
+  }
+});
+dialog.addEventListener('close', () => {
+  window.clearTimeout(closeTimer);
+  dialog.classList.remove('is-closing');
+  detailsOpener?.focus();
+  detailsOpener = null;
+});
+// Dismiss only clicks that both begin and end outside the dialog's bounds.
+/** @param {MouseEvent} event */
+const isOutside = (event) => {
+  const bounds = dialog.getBoundingClientRect();
+  return event.clientX < bounds.left || event.clientX > bounds.right
+    || event.clientY < bounds.top || event.clientY > bounds.bottom;
+};
+let pointerStartedOutside = false;
+dialog.addEventListener('pointerdown', (event) => {
+  pointerStartedOutside = event.target === dialog && isOutside(event);
+});
+dialog.addEventListener('click', (event) => {
+  if (pointerStartedOutside && event.target === dialog && isOutside(event)) closeDetails();
+  pointerStartedOutside = false;
+});
