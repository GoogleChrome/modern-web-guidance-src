diff --git a/motion.css b/motion.css
new file mode 100644
index 0000000..da17461
--- /dev/null
+++ b/motion.css
@@ -0,0 +1,134 @@
+/* Static styles are the default; spatial motion is opt-in below. */
+:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 5px;
+}
+
+nav a {
+  display: inline-block;
+  position: relative;
+  transition: color 180ms ease, background-color 180ms ease;
+}
+
+nav a::after {
+  content: '';
+  position: absolute;
+  inset: auto 0 -5px;
+  height: 2px;
+  background: currentColor;
+  opacity: 0;
+  transform: scaleX(0);
+  transform-origin: left;
+  transition: opacity 180ms ease;
+}
+
+nav a:is(:hover, :focus-visible) { color: var(--accent); }
+nav a:is(:hover, :focus-visible)::after { opacity: 1; transform: scaleX(1); }
+.btn { transition: background-color 180ms ease, color 180ms ease; }
+.btn:is(:hover, :focus-visible) { background-color: #3e2723; }
+.hero > .btn { background: var(--accent); color: var(--text); font-weight: 600; }
+.hero > .btn:is(:hover, :focus-visible) { background: #ffc46e; }
+.card { border: 1px solid transparent; transition: border-color 200ms ease; }
+.card:is(:hover, :focus-within) { border-color: var(--secondary); }
+
+.roast-banner {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  width: min(100%, 660px);
+  margin-top: 28px;
+  padding: 10px 14px;
+  border: 1px solid #ffffff70;
+  border-radius: 8px;
+  background: #271812bf;
+}
+.roast-window { flex: 1; min-width: 0; overflow: hidden; }
+.roast-track { display: flex; width: 100%; }
+.roast-track span { flex: 0 0 100%; padding-inline: 12px; }
+.roast-track span[aria-hidden] { display: none; }
+.roast-toggle {
+  flex: 0 0 auto;
+  padding: 7px 10px;
+  border: 1px solid currentColor;
+  border-radius: 4px;
+  background: transparent;
+  color: white;
+  font: inherit;
+  font-size: 0.8rem;
+  cursor: pointer;
+  transition: background-color 180ms ease, color 180ms ease;
+}
+.roast-toggle:is(:hover, :focus-visible) { background: var(--accent); color: var(--text); }
+.roast-banner.is-paused .roast-track { animation-play-state: paused; }
+.motion-note { margin-top: 8px; font-size: 0.8rem; }
+[hidden] { display: none !important; }
+
+body:has(dialog[open]) { overflow: hidden; }
+dialog {
+  margin: auto;
+  width: min(480px, calc(100% - 32px));
+  max-height: calc(100dvh - 48px);
+  padding: 0;
+  border: 0;
+  border-radius: 14px;
+  color: var(--text);
+  background: var(--light);
+  opacity: 0;
+  transition: opacity 200ms ease, display 200ms, overlay 200ms;
+  transition-behavior: allow-discrete;
+}
+dialog[open]:not(.is-closing) { opacity: 1; }
+dialog::backdrop {
+  background: #1d100dcc;
+  opacity: 0;
+  transition: opacity 200ms ease, display 200ms, overlay 200ms;
+  transition-behavior: allow-discrete;
+}
+dialog[open]:not(.is-closing)::backdrop { opacity: 1; }
+@starting-style {
+  dialog[open]:not(.is-closing),
+  dialog[open]:not(.is-closing)::backdrop { opacity: 0; }
+}
+.dialog-content { padding: 32px; }
+.dialog-content p { margin-top: 12px; }
+.dialog-content .eyebrow { margin-top: 0; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.75rem; }
+#drink-notes { color: #70534b; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+
+@media (prefers-reduced-motion: no-preference) {
+  nav a::after { transition: opacity 180ms ease, transform 220ms ease; }
+  .btn { transition: background-color 180ms ease, color 180ms ease, transform 220ms ease; }
+  .btn:is(:hover, :focus-visible) { transform: translateY(-3px); }
+  .btn:active { transform: translateY(0); }
+  .card { transition: border-color 200ms ease, transform 260ms cubic-bezier(.2,.7,.3,1); }
+  .card:is(:hover, :focus-within) { transform: translateY(-6px); }
+  .hero h1 { animation: hero-enter 650ms ease-out both; }
+  .hero > p:first-of-type { animation: hero-enter 650ms 100ms ease-out both; }
+  .hero > .btn { animation: hero-enter 650ms 200ms ease-out backwards; }
+  .roast-window { mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); }
+  .roast-track { animation: daily-roast 18s linear infinite; }
+  .roast-track { width: max-content; }
+  .roast-track span { white-space: nowrap; flex-basis: auto; }
+  .roast-track span[aria-hidden] { display: block; }
+  dialog {
+    transform: translateY(18px) scale(.98);
+    transition: opacity 200ms ease, transform 240ms ease, display 240ms, overlay 240ms;
+    transition-behavior: allow-discrete;
+  }
+  dialog[open]:not(.is-closing) { transform: translateY(0) scale(1); }
+  @starting-style {
+    dialog[open]:not(.is-closing) { transform: translateY(18px) scale(.98); }
+  }
+}
+@keyframes hero-enter { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes daily-roast { to { transform: translateX(-50%); } }
+
+@media (max-width: 640px) {
+  nav { flex-direction: column; gap: 12px; }
+  nav ul { flex-wrap: wrap; justify-content: center; gap: 12px; }
+  nav ul li { margin: 0; }
+  .hero h1 { font-size: 2.3rem; }
+  .roast-banner { flex-direction: column; }
+  .roast-window { width: 100%; flex: auto; }
+  .grid { grid-template-columns: minmax(0, 1fr); }
+}
