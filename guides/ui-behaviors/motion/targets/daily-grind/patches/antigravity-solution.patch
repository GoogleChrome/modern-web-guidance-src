+          meta: '16 oz / 20 oz • 200 mg Caffeine • Served Over Ice',
+          href: '/menu/cold-brew'
+        }
+      };
+
+      const hasAnimationEventSupport =
+        typeof AnimationEvent !== 'undefined' &&
+        'animation' in AnimationEvent.prototype;
+      const hasTransitionEventSupport =
+        typeof TransitionEvent !== 'undefined' &&
+        'animation' in TransitionEvent.prototype;
+
+      document.body.dataset.animationEventSupported = String(
+        hasAnimationEventSupport && hasTransitionEventSupport
+      );
+
+      function handleMotionEvent(event) {
+        const animation = event.animation;
+        const fallbackState = event.type.endsWith('end')
+          ? 'finished'
+          : event.type.endsWith('cancel')
