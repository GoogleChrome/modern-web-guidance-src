+      const notesEl = document.getElementById('overlay-drink-notes');
+      const metaEl = document.getElementById('overlay-drink-meta');
+      const menuLinkEl = document.getElementById('overlay-menu-link');
+      const detailButtons = document.querySelectorAll('.view-details-btn');
+
+      function renderDrinkContent(drinkKey) {
+        const data = DRINK_DETAILS[drinkKey] || DRINK_DETAILS['maple-oat-latte'];
+        if (badgeEl) badgeEl.textContent = data.badge;
+        if (titleEl) titleEl.textContent = data.title;
+        if (descEl) descEl.textContent = data.description;
+        if (metaEl) metaEl.textContent = data.meta;
