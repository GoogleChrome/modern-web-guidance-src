diff --git a/tests/scroll.test.mjs b/tests/scroll.test.mjs
new file mode 100644
index 0000000..be05996
--- /dev/null
+++ b/tests/scroll.test.mjs
@@ -0,0 +1,92 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import vm from 'node:vm';
+
+const source = await readFile(new URL('../app.js', import.meta.url), 'utf8');
+
+function setup() {
+  const sections = [];
+  const context = vm.createContext({
+    document: {
+      querySelectorAll(selector) {
+        return selector === 'section.highlight'
+          ? sections.filter((section) => section.highlighted)
+          : [];
+      },
+    },
+  });
+  vm.runInContext(source, context);
+  function target(result) {
+    const section = {
+      highlighted: false,
+      focused: false,
+      classList: {
+        add(name) { assert.equal(name, 'highlight'); section.highlighted = true; },
+        remove(name) { assert.equal(name, 'highlight'); section.highlighted = false; },
+      },
+      scrollIntoView(options) {
+        assert.equal(options.behavior, 'smooth');
+        assert.equal(options.block, 'start');
+        return result;
+      },
+      querySelector() {
+        return { focus(options) {
+          assert.equal(options.preventScroll, true);
+          section.focused = true;
+        } };
+      },
+    };
+    sections.push(section);
+    return section;
+  }
+  return { target, navigate: context.scrollToAndHighlight };
+}
+
+test('clears old state immediately and waits for the scroll promise before effects', async () => {
+  const { target, navigate } = setup();
+  const previous = target(Promise.resolve());
+  await navigate(previous);
+  let finish;
+  const next = target(new Promise((resolve) => { finish = resolve; }));
+  const pending = navigate(next);
+  assert.equal(previous.highlighted, false);
+  assert.equal(next.highlighted, false);
+  assert.equal(next.focused, false);
+  finish();
+  await pending;
+  assert.equal(next.highlighted, true);
+  assert.equal(next.focused, true);
+});
+
+test('superseded scrolls cannot highlight or focus their old targets', async () => {
+  const { target, navigate } = setup();
+  let finish;
+  const old = target(new Promise((resolve) => { finish = resolve; }));
+  const pending = navigate(old);
+  const latest = target(Promise.resolve());
+  await navigate(latest);
+  finish();
+  await pending;
+  assert.equal(old.highlighted, false);
+  assert.equal(old.focused, false);
+  assert.equal(latest.highlighted, true);
+});
+
+test('an already-positioned target with a resolved promise works on repeated navigation', async () => {
+  const { target, navigate } = setup();
+  const section = target(Promise.resolve());
+  await navigate(section);
+  const pending = navigate(section);
+  assert.equal(section.highlighted, false);
+  await pending;
+  assert.equal(section.highlighted, true);
+  assert.equal(section.focused, true);
+});
+
+test('legacy browsers returning undefined still apply effects', async () => {
+  const { target, navigate } = setup();
+  const section = target(undefined);
+  await navigate(section);
+  assert.equal(section.highlighted, true);
+});
