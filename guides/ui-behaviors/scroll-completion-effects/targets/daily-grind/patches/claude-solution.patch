+<script>
+    let currentScrollId = 0;
+    const sections = document.querySelectorAll('section');
+
+    async function scrollToAndHighlight(target) {
+      const scrollId = ++currentScrollId;
+      sections.forEach((sec) => sec.classList.remove('highlight'));
+
+      await target.scrollIntoView({ behavior: 'smooth', block: 'center' });
+
+      // Skip the effect if a newer scroll superseded this one
+      if (scrollId !== currentScrollId) return;
+
+      target.classList.add('highlight');
+      target.querySelector('h2')?.focus({ preventScroll: true });
+    }
+
+    document.querySelectorAll('[data-scroll-target]').forEach((link) => {
+      link.addEventListener('click', async (event) => {
+        event.preventDefault();
+        const target = document.getElementById(link.dataset.scrollTarget);
+        if (target) await scrollToAndHighlight(target);
+      });
+    });
+  </script>
