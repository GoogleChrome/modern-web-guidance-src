+  <script>
+    let currentScrollId = 0;
+
+    async function scrollToAndHighlight(targetElement) {
+      if (!targetElement) return;
+
+      const scrollId = ++currentScrollId;
+
+      // Clear any active highlight or post-scroll state on previously targeted elements
+      document.querySelectorAll('.highlight').forEach((el) => {
+        el.classList.remove('highlight');
+      });
+      document.querySelectorAll('section').forEach((sec) => {
+        sec.classList.remove('highlight');
+      });
+
+      // Await the Promise returned directly by the scroll method
+      await targetElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
+
+      // Abort follow-up effect if another scroll was triggered while awaiting
+      if (scrollId !== currentScrollId) return;
+
+      // Apply post-scroll effect
+      targetElement.classList.add('highlight');
+
+      // Move focus with preventScroll: true
+      if (typeof targetElement.focus === 'function') {
+        targetElement.focus({ preventScroll: true });
+      }
+    }
+
+    // Expose for direct testing or programmatic navigation
+    window.scrollToAndHighlight = scrollToAndHighlight;
+
+    function getTargetElement(control) {
+      if (!control) return null;
+
+      // 1. Check data-target attribute
+      if (control.dataset && control.dataset.target) {
+        try {
+          const el = document.querySelector(control.dataset.target);
+          if (el) return el;
+        } catch (_) {}
+      }
+
+      // 2. Check href attribute
+      const href = control.getAttribute('href');
+      if (href) {
+        if (href.includes('#')) {
+          const hash = href.substring(href.indexOf('#'));
+          if (hash.length > 1) {
+            try {
+              const el = document.querySelector(hash);
+              if (el) return el;
+            } catch (_) {}
+          }
+        }
+        if (href.startsWith('/')) {
+          const id = href.replace(/^\//, '');
+          const el = document.getElementById(id);
+          if (el) return el;
+        }
+      }
+
+      // 3. Fallback matching text
+      const text = control.textContent.trim().toLowerCase();
+      if (text) {
+        const el = document.getElementById(text.replace(/\s+/g, '-'));
+        if (el) return el;
+      }
+
+      return null;
+    }
+
+    document.addEventListener('click', async (event) => {
+      const control = event.target.closest('a, button, [data-target]');
+      if (!control) return;
+
+      const target = getTargetElement(control);
+      if (target) {
+        event.preventDefault();
+        await scrollToAndHighlight(target);
+      }
+    });
+  </script>
+
