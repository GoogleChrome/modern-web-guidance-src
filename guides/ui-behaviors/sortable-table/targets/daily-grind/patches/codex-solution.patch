+  <script>
+    const table = document.getElementById('seasonal-drinks');
+    const status = document.getElementById('seasonal-sort-status');
+    if (table instanceof HTMLTableElement && status) {
+      const tbody = table.tBodies[0];
+      const headers = Array.from(table.querySelectorAll('thead th[data-type]'));
+      const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
+
+      function sortBy(button) {
+        const header = button.closest('th');
+        if (!(header instanceof HTMLTableCellElement) || !headers.includes(header)) return;
+        const direction = header.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
+        const factor = direction === 'ascending' ? 1 : -1;
+        const rows = Array.from(tbody.rows).map((row) => {
+          const cell = row.cells[header.cellIndex];
+          return { row, value: cell.dataset.value ?? cell.textContent.trim() };
+        });
+        rows.sort((a, b) => factor * (header.dataset.type === 'number'
+          ? Number(a.value) - Number(b.value)
+          : collator.compare(a.value, b.value)));
+        for (const th of headers) th.removeAttribute('aria-sort');
+        header.setAttribute('aria-sort', direction);
+        for (const { row } of rows) {
+          if (typeof tbody.moveBefore === 'function') tbody.moveBefore(row, null);
+          else tbody.appendChild(row);
+        }
+        status.textContent = `Sorted by ${button.textContent.trim()}, ${direction}, ${rows.length} rows`;
+      }
+
+      table.addEventListener('command', (event) => {
+        if (event.command === '--sort' && event.source instanceof HTMLButtonElement) {
+          sortBy(event.source);
+        }
+      });
+
+      for (const header of headers) {
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.setAttribute('commandfor', table.id);
+        button.setAttribute('command', '--sort');
+        button.append(document.createTextNode(header.textContent));
+        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+        svg.setAttribute('class', 'sort-icon');
+        svg.setAttribute('viewBox', '0 0 16 16');
+        svg.setAttribute('aria-hidden', 'true');
+        svg.setAttribute('fill', 'currentColor');
+        for (const [name, path] of [['sort-up', 'M3 6 L8 1 L13 6 Z'], ['sort-down', 'M3 10 L8 15 L13 10 Z']]) {
+          const arrow = document.createElementNS('http://www.w3.org/2000/svg', 'path');
+          arrow.setAttribute('class', name);
+          arrow.setAttribute('d', path);
+          svg.append(arrow);
+        }
+        button.append(svg);
+        if (!('commandForElement' in HTMLButtonElement.prototype)) {
+          button.addEventListener('click', () => sortBy(button));
+        }
+        header.replaceChildren(button);
+      }
+    }
+  </script>
