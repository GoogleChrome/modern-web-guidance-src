+  <script>
+    (() => {
+      const table = document.getElementById('seasonal-drinks');
+      const status = document.getElementById('seasonal-drinks-status');
+      if (!(table instanceof HTMLTableElement) || !table.tHead || !table.tBodies[0] || !status) return;
+
+      const tbody = table.tBodies[0];
+      const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let activeTransition = null;
+
+      function sortRows(rows, index, type, direction) {
+        const factor = direction === 'ascending' ? 1 : -1;
+        // Read each row's value once before sorting; prefer the raw data-value over formatted text.
+        const keyed = rows.map((row) => {
+          const cell = row.cells[index];
+          const raw = cell ? (cell.dataset.value ?? cell.textContent.trim()) : '';
+          return { row, key: type === 'number' ? Number.parseFloat(raw) : raw };
+        });
+        keyed.sort((a, b) => {
+          if (type === 'number') {
+            const av = Number.isNaN(a.key) ? -Infinity : a.key;
+            const bv = Number.isNaN(b.key) ? -Infinity : b.key;
+            return factor * (av === bv ? 0 : av < bv ? -1 : 1);
+          }
+          return factor * collator.compare(a.key, b.key);
+        });
+        return keyed.map((entry) => entry.row);
+      }
+
+      // Move existing rows to the end in sorted order; never rebuild the tbody.
+      function reorder(container, orderedRows) {
+        for (const row of orderedRows) {
+          if (typeof container.moveBefore === 'function') {
+            container.moveBefore(row, null);
+          } else {
+            container.insertBefore(row, null);
+          }
+        }
+      }
+
+      function reorderWithTransition(rows) {
+        const update = () => reorder(tbody, rows);
+
+        // Rapid clicks: finish any running animation immediately before starting the next.
+        if (activeTransition) activeTransition.skipTransition();
+
+        if (reducedMotion.matches) {
+          update();
+          return;
+        }
+
+        let transition = null;
+        if (typeof table.startViewTransition === 'function') {
+          // Element-scoped: the rest of the page stays interactive during the animation.
+          transition = table.startViewTransition(update);
+        } else if (typeof document.startViewTransition === 'function') {
+          transition = document.startViewTransition(update);
+        } else {
+          update();
+          return;
+        }
+
+        activeTransition = transition;
+        transition.finished.finally(() => {
+          if (activeTransition === transition) activeTransition = null;
+        });
+      }
+
+      function sortBy(button) {
+        const th = button.closest('th');
+        if (!th || th.parentElement !== table.tHead.rows[0]) return;
+
+        const direction = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
+
+        for (const header of table.tHead.rows[0].cells) header.removeAttribute('aria-sort');
+        th.setAttribute('aria-sort', direction);
+
+        const rows = sortRows([...tbody.rows], th.cellIndex, th.dataset.type, direction);
+        reorderWithTransition(rows);
+        // One message per sort; the status element is already in the DOM.
+        status.textContent = `Sorted by ${button.textContent.trim()}, ${direction}, ${rows.length} rows`;
+      }
+
+      const supportsInvokers =
+        typeof HTMLButtonElement !== 'undefined' && 'commandForElement' in HTMLButtonElement.prototype;
+
+      if (supportsInvokers) {
+        table.addEventListener('command', (event) => {
+          if (event.command !== '--sort' || !(event.source instanceof HTMLButtonElement)) return;
+          sortBy(event.source);
+        });
+      } else {
+        // Fallback for browsers without invoker commands: identical behavior via click.
+        for (const button of table.tHead.querySelectorAll('button[command="--sort"]')) {
+          button.addEventListener('click', () => sortBy(button));
+        }
+      }
+    })();
+  </script>
