+  <script>
+    const table = document.getElementById('seasonal-drinks');
+    const tbody = table.tBodies[0];
+    const status = document.getElementById('sort-status');
+    const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
+
+    // Reorders the existing <tr> nodes; never recreates them.
+    function reorder(container, orderedNodes) {
+      const move =
+        'moveBefore' in Element.prototype
+          ? (node) => container.moveBefore(node, null)
+          : (node) => container.append(node);
+      for (const node of orderedNodes) move(node);
+    }
+
+    function reorderWithTransition(orderedNodes) {
+      const update = () => reorder(tbody, orderedNodes);
+      if (table.startViewTransition) {
+        table.startViewTransition(update);
+      } else if (document.startViewTransition) {
+        document.startViewTransition(update);
+      } else {
+        update();
+      }
+    }
+
+    function cellValue(row, index, type) {
+      const cell = row.cells[index];
+      const raw = cell.dataset.value ?? cell.textContent.trim().replace(/,/g, '').replace(/^[$€£]/, '');
+      return type === 'number' ? Number(raw) : raw;
+    }
+
+    function sortRows(rows, index, type, direction) {
+      const factor = direction === 'ascending' ? 1 : -1;
+      return rows.sort((a, b) => {
+        const x = cellValue(a, index, type);
+        const y = cellValue(b, index, type);
+        return factor * (type === 'number' ? x - y : collator.compare(x, y));
+      });
+    }
+
+    table.addEventListener('command', (event) => {
+      if (event.command !== '--sort') return;
+
+      const th = event.source.closest('th');
+      const direction = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
+
+      for (const header of table.tHead.rows[0].cells) header.removeAttribute('aria-sort');
+      th.setAttribute('aria-sort', direction);
+
+      const rows = sortRows([...tbody.rows], th.cellIndex, th.dataset.type, direction);
+      reorderWithTransition(rows);
+
+      const label = event.source.textContent.trim();
+      status.textContent = `Sorted by ${label}, ${direction}, ${rows.length} rows`;
+    });
+
+    // Fallback: If Invoker Commands are unsupported, add click listener on header buttons
+    if (!('CommandEvent' in window)) {
+      document.documentElement.classList.add('no-invokers');
+      table.addEventListener('click', (event) => {
+        const button = event.target.closest('button[command="--sort"]');
+        if (button && button.getAttribute('commandfor') === table.id) {
+          const th = button.closest('th');
+          const direction = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
+
+          for (const header of table.tHead.rows[0].cells) header.removeAttribute('aria-sort');
+          th.setAttribute('aria-sort', direction);
+
+          const rows = sortRows([...tbody.rows], th.cellIndex, th.dataset.type, direction);
+          reorderWithTransition(rows);
+
+          const label = button.textContent.trim();
+          status.textContent = `Sorted by ${label}, ${direction}, ${rows.length} rows`;
+        }
+      });
+    }
+  </script>
