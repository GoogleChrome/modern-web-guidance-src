+  <script>
+    const drinks = [
+      {
+        title: "Maple Oat Latte",
+        desc: "Creamy oat milk with a hint of Vermont maple syrup.",
+        link: "/menu/seasonal"
+      },
+      {
+        title: "Dark Roast Espresso",
+        desc: "Bold, smokey, and perfect for a morning boost.",
+        link: "/menu/espresso"
+      },
+      {
+        title: "Cold Brew",
+        desc: "Steeped for 18 hours for maximum smoothness.",
+        link: "/menu/cold-brew"
+      }
+    ];
+
+    let currentIndex = 0;
+
+    const titleEl = document.getElementById("drink-title");
+    const descEl = document.getElementById("drink-desc");
+    const linkEl = document.getElementById("drink-link");
+    const counterEl = document.getElementById("counter");
+    const prevBtn = document.getElementById("prev");
+    const nextBtn = document.getElementById("next");
+
+    function updateDOM() {
+      const drink = drinks[currentIndex];
+      if (titleEl) titleEl.textContent = drink.title;
+      if (descEl) descEl.textContent = drink.desc;
+      if (linkEl) linkEl.href = drink.link;
+      if (counterEl) counterEl.textContent = `${currentIndex + 1} of ${drinks.length}`;
+      if (prevBtn) prevBtn.disabled = currentIndex === 0;
+      if (nextBtn) nextBtn.disabled = currentIndex === drinks.length - 1;
+    }
+
+    /**
+     * Navigates to a new view with a directional transition.
+     * @param {Function} updateDOM - Callback to update the DOM state.
+     * @param {string} direction - Either 'forward' or 'backward'.
+     */
+    function navigate(updateDOM, direction) {
+      // Feature detect for browsers that do not support View Transitions
+      if (!document.startViewTransition) {
+        updateDOM();
+        return;
+      }
+
+      // Start transition with the specific navigation type
+      document.startViewTransition({
+        update: updateDOM,
+        types: [direction] // Matches the CSS :active-view-transition-type() selectors
+      });
+    }
+
+    if (nextBtn) {
+      nextBtn.addEventListener("click", () => {
+        if (currentIndex < drinks.length - 1) {
+          currentIndex++;
+          navigate(updateDOM, "forward");
+        }
+      });
+    }
+
+    if (prevBtn) {
+      prevBtn.addEventListener("click", () => {
+        if (currentIndex > 0) {
+          currentIndex--;
+          navigate(updateDOM, "backward");
+        }
+      });
+    }
+
+    updateDOM();
+  </script>
+
