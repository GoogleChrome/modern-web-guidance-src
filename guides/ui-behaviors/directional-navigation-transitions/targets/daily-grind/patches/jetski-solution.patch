+  <script>
+    const slides = [
+      {
+        title: "Seasonal Favorites",
+        items: [
+          { name: "Maple Oat Latte", desc: "Creamy oat milk with a hint of Vermont maple syrup.", link: "/menu/seasonal" },
+          { name: "Dark Roast Espresso", desc: "Bold, smokey, and perfect for a morning boost.", link: "/menu/espresso" },
+          { name: "Cold Brew", desc: "Steeped for 18 hours for maximum smoothness.", link: "/menu/cold-brew" }
+        ]
+      },
+      {
+        title: "Signature Blends",
+        items: [
+          { name: "House Blend", desc: "Balanced body with subtle nutty and chocolate notes.", link: "/menu/house-blend" },
+          { name: "Ethiopian Yirgacheffe", desc: "Bright floral aroma with distinct citrus and berry accents.", link: "/menu/ethiopian" },
+          { name: "Colombian Supremo", desc: "Rich aroma with sweet caramel and mild acidity.", link: "/menu/colombian" }
+        ]
+      },
+      {
+        title: "Bakery & Treats",
+        items: [
+          { name: "Almond Croissant", desc: "Flaky, buttery pastry filled with rich almond cream.", link: "/menu/croissant" },
+          { name: "Blueberry Scone", desc: "Freshly baked daily with wild mountain blueberries.", link: "/menu/scone" },
+          { name: "Cinnamon Roll", desc: "Warm, gooey swirl topped with cream cheese glaze.", link: "/menu/cinnamon-roll" }
+        ]
+      }
+    ];
+
+    let currentSlide = 0;
+
+    function updateDOM() {
+      const slide = slides[currentSlide];
+      const titleEl = document.getElementById("section-title");
+      const container = document.getElementById("cards-container");
+      const indicator = document.getElementById("page-indicator");
+
+      if (titleEl) titleEl.textContent = slide.title;
+      if (indicator) indicator.textContent = `Page ${currentSlide + 1} of ${slides.length}`;
+      if (container) {
+        container.innerHTML = slide.items.map(item => `
+          <div class="card">
+            <h3>${item.name}</h3>
+            <p>${item.desc}</p>
+            <a href="${item.link}" class="btn">View Details</a>
+          </div>
+        `).join("");
+      }
+    }
+
+    /**
+     * Navigates to a new view with a directional transition.
+     * @param {Function} updateDOM - Callback to update the DOM state.
+     * @param {string} direction - Either 'forward' or 'backward'.
+     */
+    function navigate(updateDOM, direction) {
+      // Feature detect for browsers that do not support View Transitions
+      if (!document.startViewTransition) {
+        updateDOM();
+        return;
+      }
+
+      // Start transition with the specific navigation type
+      document.startViewTransition({
+        update: updateDOM,
+        types: [direction] // Matches the CSS :active-view-transition-type() selectors
+      });
+    }
+
+    const prevBtn = document.getElementById("previous");
+    const nextBtn = document.getElementById("next");
+
+    if (prevBtn) {
+      prevBtn.addEventListener("click", () => {
+        currentSlide = (currentSlide - 1 + slides.length) % slides.length;
+        navigate(updateDOM, "backward");
+      });
+    }
+
+    if (nextBtn) {
+      nextBtn.addEventListener("click", () => {
+        currentSlide = (currentSlide + 1) % slides.length;
+        navigate(updateDOM, "forward");
+      });
+    }
+  </script>
 </body>
 
