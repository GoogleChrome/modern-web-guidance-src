+// @ts-check
+
+/** @typedef {'forward' | 'backward'} NavigationDirection */
+
+/**
+ * @typedef {Object} Story
+ * @property {string} title
+ * @property {string} summary
+ * @property {string} image
+ * @property {string} alt
+ * @property {string} caption
+ * @property {string} slug
+ */
+
+/** @type {readonly Story[]} */
+const stories = [
+  {
+    title: "From cloud forest to first crack",
+    summary:
+      "High in the green hills of Huehuetenango, careful hands begin the journey of our house roast.",
+    image:
+      "https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1400&q=85",
+    alt: "Freshly roasted coffee beans scattered on a wooden surface",
+    caption: "Huehuetenango, Guatemala · 1,850 m",
+    slug: "origin",
+  },
+  {
+    title: "The ritual of a slower morning",
+    summary:
+      "Before the city stirs, the first batch is already turning in the roaster. Meet the small rituals that make every cup feel considered.",
+    image:
+      "https://images.unsplash.com/photo-1445116572660-236099ec97a0?auto=format&fit=crop&w=1400&q=85",
+    alt: "A warmly lit neighborhood coffee shop interior",
+    caption: "Portland, Oregon · 6:14 AM",
+    slug: "morning-ritual",
+  },
+  {
+    title: "Dialing in the perfect pour",
+    summary:
+      "A gram here, a second there. Our bar team shares why precision leaves room for something wonderfully human.",
+    image:
+      "https://images.unsplash.com/photo-1497636577773-f1231844b336?auto=format&fit=crop&w=1400&q=85",
+    alt: "A barista carefully pouring steamed milk into a cup",
+    caption: "Burnside café · 8:42 AM",
+    slug: "perfect-pour",
+  },
+  {
+    title: "Built around the neighborhood",
+    summary:
+      "Coffee tastes better in good company. Step inside the workshop where reclaimed wood became our favorite long table.",
+    image:
+      "https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=1400&q=85",
+    alt: "Friends gathering around a long table inside a coffee shop",
+    caption: "Alberta Arts District · 4:20 PM",
+    slug: "neighborhood",
+  },
+];
+
+const requiredElement = (id) => {
+  const element = document.getElementById(id);
+  if (!element) throw new Error(`Required element #${id} was not found.`);
+  return element;
+};
+
+const title = requiredElement("story-title");
+const summary = requiredElement("story-summary");
+const image = requiredElement("story-image");
+const caption = requiredElement("story-caption");
+const storyNumber = requiredElement("story-number");
+const currentPage = requiredElement("current-page");
+const totalPages = requiredElement("total-pages");
+const storyLink = requiredElement("story-link");
+const previousButton = requiredElement("previous");
+const nextButton = requiredElement("next");
+
+let activeIndex = 1;
+
+const pageLabel = (value) => String(value).padStart(2, "0");
+
+function renderStory() {
+  const story = stories[activeIndex];
+  if (!story) return;
+
+  title.textContent = story.title;
+  summary.textContent = story.summary;
+  image.setAttribute("src", story.image);
+  image.setAttribute("alt", story.alt);
+  caption.textContent = story.caption;
+  storyLink.setAttribute("href", `#${story.slug}`);
+
+  const number = pageLabel(activeIndex + 1);
+  storyNumber.textContent = number;
+  currentPage.textContent = number;
+}
+
+/**
+ * Updates the current story with a directional view transition when supported.
+ * @param {NavigationDirection} direction
+ */
+function navigate(direction) {
+  const offset = direction === "forward" ? 1 : -1;
+  const updateDOM = () => {
+    activeIndex = (activeIndex + offset + stories.length) % stories.length;
+    renderStory();
+  };
+
+  if (!document.startViewTransition) {
+    updateDOM();
+    return;
+  }
+
+  document.startViewTransition({
+    update: updateDOM,
+    types: [direction],
+  });
+}
+
+previousButton.addEventListener("click", () => navigate("backward"));
+nextButton.addEventListener("click", () => navigate("forward"));
+
+document.addEventListener("keydown", (event) => {
+  if (event.key === "ArrowLeft") navigate("backward");
+  if (event.key === "ArrowRight") navigate("forward");
+});
+
+totalPages.textContent = pageLabel(stories.length);
+renderStory();
