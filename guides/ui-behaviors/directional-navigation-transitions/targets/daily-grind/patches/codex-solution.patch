@@ -0,0 +1,376 @@
+@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap");
+
+:root {
+  color-scheme: light;
+  --ink: #241711;
+  --paper: #f3efe7;
+  --cream: #e5ddce;
+  --clay: #a84f32;
+  --line: rgb(36 23 17 / 20%);
+  font-family: "DM Sans", sans-serif;
+  color: var(--ink);
+  background: var(--paper);
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  min-width: 320px;
+  scroll-behavior: smooth;
+}
+
+body {
+  min-height: 100vh;
+  margin: 0;
+  background:
+    radial-gradient(circle at 5% 25%, rgb(168 79 50 / 7%), transparent 28rem),
+    var(--paper);
+}
+
+a {
+  color: inherit;
+}
+
+.site-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  width: min(100% - 48px, 1320px);
+  min-height: 92px;
+  margin-inline: auto;
+  border-bottom: 1px solid var(--line);
+}
+
+.brand {
+  display: inline-flex;
+  gap: 12px;
+  align-items: center;
+  font-size: 0.88rem;
+  font-weight: 600;
+  letter-spacing: 0.08em;
+  text-decoration: none;
+  text-transform: uppercase;
+}
+
+.brand-mark {
+  display: grid;
+  width: 39px;
+  aspect-ratio: 1;
+  place-items: center;
+  border-radius: 50%;
+  color: var(--paper);
+  background: var(--ink);
+  font-family: "Newsreader", serif;
+  font-size: 0.9rem;
+  letter-spacing: -0.03em;
+}
+
+nav {
+  display: flex;
+  gap: clamp(20px, 3vw, 48px);
+  align-items: center;
+}
+
+nav a {
+  font-size: 0.82rem;
+  font-weight: 500;
+  text-decoration: none;
+}
+
+nav a:not(.nav-cta):hover {
+  text-decoration: underline;
+  text-underline-offset: 5px;
+}
+
+.nav-cta {
+  padding: 11px 17px;
+  border: 1px solid var(--ink);
+  border-radius: 999px;
+  transition: color 160ms ease, background 160ms ease;
+}
+
+.nav-cta:hover {
+  color: var(--paper);
+  background: var(--ink);
+}
+
+.story-shell {
+  width: min(100% - 48px, 1320px);
+  margin: 0 auto;
+  padding: clamp(44px, 7vw, 104px) 0 40px;
+}
+
+.story {
+  display: grid;
+  grid-template-columns: minmax(260px, 0.82fr) minmax(420px, 1.35fr);
+  gap: clamp(48px, 8vw, 128px);
+  align-items: center;
+  min-height: 560px;
+}
+
+.story-copy {
+  padding-left: clamp(0px, 4vw, 64px);
+}
+
+.eyebrow {
+  display: flex;
+  gap: 10px;
+  margin: 0 0 30px;
+  color: var(--clay);
+  font-size: 0.7rem;
+  font-weight: 600;
+  letter-spacing: 0.18em;
+  text-transform: uppercase;
+}
+
+h1 {
+  max-width: 610px;
+  margin: 0;
+  font-family: "Newsreader", Georgia, serif;
+  font-size: clamp(3.6rem, 6vw, 6.9rem);
+  font-weight: 400;
+  letter-spacing: -0.055em;
+  line-height: 0.9;
+}
+
+.lede {
+  max-width: 470px;
+  margin: 34px 0 28px;
+  color: rgb(36 23 17 / 72%);
+  font-size: clamp(0.95rem, 1.3vw, 1.1rem);
+  line-height: 1.75;
+}
+
+.text-link {
+  display: inline-flex;
+  gap: 14px;
+  align-items: center;
+  padding-bottom: 5px;
+  border-bottom: 1px solid var(--ink);
+  font-size: 0.78rem;
+  font-weight: 600;
+  letter-spacing: 0.05em;
+  text-decoration: none;
+  text-transform: uppercase;
+}
+
+.story-visual {
+  position: relative;
+  align-self: stretch;
+  min-height: 540px;
+  margin: 0;
+  overflow: hidden;
+  background: var(--cream);
+}
+
+.story-visual::after {
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(180deg, transparent 60%, rgb(20 10 5 / 46%));
+  content: "";
+  pointer-events: none;
+}
+
+.story-visual img {
+  width: 100%;
+  height: 100%;
+  min-height: 540px;
+  object-fit: cover;
+}
+
+.story-visual figcaption {
+  position: absolute;
+  z-index: 1;
+  right: 24px;
+  bottom: 22px;
+  color: white;
+  font-size: 0.7rem;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.story-controls {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-top: 36px;
+  padding-top: 24px;
+  border-top: 1px solid var(--line);
+}
+
+.story-controls p {
+  margin: 0;
+  font-family: "Newsreader", serif;
+  font-size: 1.05rem;
+}
+
+.control-buttons {
+  display: flex;
+  gap: 8px;
+}
+
+button {
+  min-width: 132px;
+  padding: 13px 18px;
+  border: 1px solid var(--ink);
+  border-radius: 0;
+  color: var(--ink);
+  background: transparent;
+  font: 600 0.72rem/1 "DM Sans", sans-serif;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+  cursor: pointer;
+  transition: color 160ms ease, background 160ms ease;
+}
+
+button:hover {
+  color: var(--paper);
+  background: var(--ink);
+}
+
+button:focus-visible,
+a:focus-visible {
+  outline: 3px solid var(--clay);
+  outline-offset: 4px;
+}
+
+footer {
+  display: flex;
+  justify-content: space-between;
+  width: min(100% - 48px, 1320px);
+  margin: 50px auto 0;
+  padding: 26px 0;
+  border-top: 1px solid var(--line);
+  color: rgb(36 23 17 / 65%);
+  font-size: 0.72rem;
+}
+
+footer p {
+  margin: 0;
+}
+
+@keyframes slide-to-left {
+  to {
+    transform: translateX(-100%);
+  }
+}
+
+@keyframes slide-from-right {
+  from {
+    transform: translateX(100%);
+  }
+}
+
+@keyframes slide-to-right {
+  to {
+    transform: translateX(100%);
+  }
+}
+
+@keyframes slide-from-left {
+  from {
+    transform: translateX(-100%);
+  }
+}
+
+::view-transition-group(root) {
+  animation: 0.4s ease-in-out both;
+}
+
+html:active-view-transition-type(forward)::view-transition-old(root) {
+  animation-name: slide-to-left;
+}
+
+html:active-view-transition-type(forward)::view-transition-new(root) {
+  animation-name: slide-from-right;
+}
+
+html:active-view-transition-type(backward)::view-transition-old(root) {
+  animation-name: slide-to-right;
+}
+
+html:active-view-transition-type(backward)::view-transition-new(root) {
+  animation-name: slide-from-left;
+}
+
+@media (max-width: 820px) {
+  .site-header {
+    min-height: 76px;
+  }
+
+  nav > a:not(.nav-cta) {
+    display: none;
+  }
+
+  .story {
+    grid-template-columns: 1fr;
+    gap: 38px;
+  }
+
+  .story-copy {
+    padding: 0 4vw;
+  }
+
+  .story-visual,
+  .story-visual img {
+    min-height: min(65vh, 560px);
+  }
+}
+
+@media (max-width: 520px) {
+  .site-header,
+  .story-shell,
+  footer {
+    width: min(100% - 28px, 1320px);
+  }
+
+  .brand > span:last-child {
+    display: none;
+  }
+
+  .nav-cta {
+    padding: 10px 13px;
+  }
+
+  h1 {
+    font-size: clamp(3.1rem, 15vw, 4.6rem);
+  }
+
+  .story-controls {
+    align-items: flex-start;
+    gap: 20px;
+  }
+
+  .control-buttons {
+    flex-direction: column-reverse;
+  }
+
+  button {
+    min-width: 118px;
+  }
+
+  footer {
+    gap: 16px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+
+  *,
+  *::before,
+  *::after {
