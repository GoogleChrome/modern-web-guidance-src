diff --git a/seasonal.js b/seasonal.js
new file mode 100644
index 0000000..6caa517
--- /dev/null
+++ b/seasonal.js
@@ -0,0 +1,53 @@
+// Keep navigation bounded and serialize transitions so snapshots stay consistent.
+const cards = Array.from(document.querySelectorAll('#seasonal-slides .card'));
+const previous = document.getElementById('seasonal-previous');
+const next = document.getElementById('seasonal-next');
+const status = document.getElementById('seasonal-status');
+
+if (previous instanceof HTMLButtonElement && next instanceof HTMLButtonElement && status && cards.length) {
+  let current = 0;
+  let busy = false;
+
+  const updateControls = () => {
+    previous.disabled = busy || current === 0;
+    next.disabled = busy || current === cards.length - 1;
+  };
+
+  const navigate = async (direction) => {
+    const target = current + (direction === 'forward' ? 1 : -1);
+    if (busy || target < 0 || target >= cards.length) return;
+
+    let updated = false;
+    const update = () => {
+      if (updated) return;
+      cards[current].hidden = true;
+      cards[target].hidden = false;
+      current = target;
+      status.textContent = `${current + 1} of ${cards.length}: ${cards[current].querySelector('h3')?.textContent ?? ''}`;
+      updated = true;
+    };
+
+    busy = true;
+    updateControls();
+    try {
+      if (typeof document.startViewTransition === 'function'
+        && CSS.supports('selector(:active-view-transition-type(forward))')
+        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        const transition = document.startViewTransition({ update, types: [direction] });
+        await transition.finished;
+      } else {
+        update();
+      }
+    } catch {
+      // A failed or skipped snapshot must never prevent navigation.
+      update();
+    } finally {
+      busy = false;
+      updateControls();
+    }
+  };
+
+  previous.addEventListener('click', () => { void navigate('backward'); });
+  next.addEventListener('click', () => { void navigate('forward'); });
+  updateControls();
+}
