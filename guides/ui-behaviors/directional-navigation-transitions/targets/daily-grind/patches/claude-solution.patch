+  <script>
+    (function () {
+      var carousel = document.querySelector('.carousel');
+      if (!carousel) return;
+
+      var slides = Array.prototype.slice.call(carousel.querySelectorAll('.carousel-viewport > .card'));
+      var prevBtn = carousel.querySelector('[data-carousel-prev]');
+      var nextBtn = carousel.querySelector('[data-carousel-next]');
+      var status = carousel.querySelector('[data-carousel-status]');
+      var current = 0;
+
+      function show(index) {
+        slides.forEach(function (slide, i) {
+          slide.hidden = i !== index;
+        });
+        current = index;
+        if (status) status.textContent = (index + 1) + ' / ' + slides.length;
+      }
+
+      /**
+       * Navigates to a new slide with a directional transition.
+       * @param {Function} updateDOM - Callback to update the DOM state.
+       * @param {string} direction - Either 'forward' or 'backward'.
+       */
+      function navigate(updateDOM, direction) {
+        // Feature detect for browsers that do not support View Transitions
+        if (!document.startViewTransition) {
+          updateDOM();
+          return;
+        }
+
+        // Older implementations only accept a callback and lack transition types;
+        // without types the direction can't be expressed, so update immediately.
+        var supportsTypes = typeof ViewTransition !== 'undefined' &&
+          'types' in ViewTransition.prototype;
+        if (!supportsTypes) {
+          updateDOM();
+          return;
+        }
+
+        // Start transition with the specific navigation type
+        document.startViewTransition({
+          update: updateDOM,
+          types: [direction] // Matches the CSS :active-view-transition-type() selectors
+        });
+      }
+
+      function go(step) {
+        if (slides.length < 2) return;
+        var target = (current + step + slides.length) % slides.length;
+        navigate(function () { show(target); }, step > 0 ? 'forward' : 'backward');
+      }
+
+      if (nextBtn) nextBtn.addEventListener('click', function () { go(1); });
+      if (prevBtn) prevBtn.addEventListener('click', function () { go(-1); });
+
+      carousel.addEventListener('keydown', function (event) {
+        if (event.key === 'ArrowRight') { go(1); }
+        else if (event.key === 'ArrowLeft') { go(-1); }
+      });
+
+      show(0);
+    })();
+  </script>
+
