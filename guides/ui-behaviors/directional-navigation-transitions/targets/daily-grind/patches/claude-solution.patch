+  <script>
+    const BREWS = [
+      {
+        name: 'Maple Oat Latte',
+        blurb: 'Creamy oat milk with a hint of Vermont maple syrup, finished with a dusting of cinnamon.',
+        notes: ['Maple', 'Toasted Oat', 'Cinnamon'],
+        href: '/menu/seasonal'
+      },
+      {
+        name: 'Dark Roast Espresso',
+        blurb: 'Bold, smokey, and perfect for a morning boost. Pulled as a double shot, every time.',
+        notes: ['Cocoa', 'Smoke', 'Molasses'],
+        href: '/menu/espresso'
+      },
+      {
+        name: 'Cold Brew',
+        blurb: 'Steeped for 18 hours for maximum smoothness, then cut with filtered water over ice.',
+        notes: ['Caramel', 'Citrus Peel', 'Low Acid'],
+        href: '/menu/cold-brew'
+      },
+      {
+        name: 'Honey Cardamom Cortado',
+        blurb: 'Equal parts espresso and steamed milk, sweetened with wildflower honey.',
+        notes: ['Honey', 'Cardamom', 'Cream'],
+        href: '/menu/cortado'
+      }
+    ];
+
+    const feature = document.getElementById('feature');
+    const pagerStatus = document.getElementById('pager-status');
+    const prevButton = document.getElementById('prev-btn');
+    const nextButton = document.getElementById('next-btn');
+
+    let currentIndex = 0;
+
+    function render() {
+      const brew = BREWS[currentIndex];
+      feature.replaceChildren();
+
+      const heading = document.createElement('h2');
+      heading.textContent = brew.name;
+
+      const blurb = document.createElement('p');
+      blurb.textContent = brew.blurb;
+
+      const notes = document.createElement('ul');
+      notes.className = 'tasting-notes';
+      for (const note of brew.notes) {
+        const item = document.createElement('li');
+        item.textContent = note;
+        notes.append(item);
+      }
+
+      const link = document.createElement('a');
+      link.className = 'btn';
+      link.href = brew.href;
+      link.textContent = 'View Details';
+
+      feature.append(heading, blurb, notes, link);
+      pagerStatus.textContent = `${currentIndex + 1} / ${BREWS.length}`;
+    }
+
+    /**
+     * Navigates to a new view with a directional transition.
+     * @param {Function} updateDOM - Callback to update the DOM state.
+     * @param {string} direction - Either 'forward' or 'backward'.
+     */
+    function navigate(updateDOM, direction) {
+      // Feature detect for browsers that do not support View Transitions
+      if (!document.startViewTransition) {
+        updateDOM();
+        return;
+      }
+
+      // Start transition with the specific navigation type
+      document.startViewTransition({
+        update: updateDOM,
+        types: [direction] // Matches the CSS :active-view-transition-type() selectors
+      });
+    }
+
+    function goTo(index, direction) {
+      navigate(() => {
+        currentIndex = (index + BREWS.length) % BREWS.length;
+        render();
+      }, direction);
+    }
+
+    nextButton.addEventListener('click', () => goTo(currentIndex + 1, 'forward'));
+    prevButton.addEventListener('click', () => goTo(currentIndex - 1, 'backward'));
+
+    render();
+  </script>
+
