+    <script is:inline>
+      /**
+       * Navigates to a new view with a directional transition.
+       * @param {Function} updateDOM - Callback to update the DOM state.
+       * @param {string} direction - Either 'forward' or 'backward'.
+       */
+      function navigate(updateDOM, direction) {
+        // Feature detect for browsers that do not support View Transitions
+        if (!document.startViewTransition) {
+          if (typeof updateDOM === 'function') {
+            updateDOM();
+          }
+          return;
+        }
+
+        // Start transition with the specific navigation type
+        try {
+          const transition = document.startViewTransition({
+            update: typeof updateDOM === 'function' ? updateDOM : () => {},
+            types: [direction] // Matches the CSS :active-view-transition-type() selectors
+          });
+          if (transition && transition.types && typeof transition.types.add === 'function') {
+            try {
+              transition.types.add(direction);
+            } catch (_) {}
+          }
+          return transition;
+        } catch (e) {
+          const transition = document.startViewTransition(
+            typeof updateDOM === 'function' ? updateDOM : () => {}
+          );
+          if (transition && transition.types && typeof transition.types.add === 'function') {
+            try {
+              transition.types.add(direction);
+            } catch (_) {}
+          }
+          return transition;
+        }
+      }
+
+      window.navigate = navigate;
+
+      function handleDirectionalClick(event) {
+        const btn = event.target.closest('button, a');
+        if (!btn) return;
+
+        const btnText = (btn.textContent || '').trim().toLowerCase();
+        const directionAttr = btn.getAttribute('data-direction');
+
+        let direction = null;
+        if (directionAttr === 'forward' || directionAttr === 'backward') {
+          direction = directionAttr;
+        } else if (btnText === 'next' || btnText.startsWith('next')) {
+          direction = 'forward';
+        } else if (btnText === 'previous' || btnText.startsWith('prev') || btnText.startsWith('previous')) {
+          direction = 'backward';
+        }
+
+        if (!direction) return;
+
+        const targetUrl = btn.getAttribute('data-target-url') || (btn.tagName === 'A' ? btn.getAttribute('href') : null);
+
+        if (targetUrl) {
+          event.preventDefault();
+          event.stopPropagation();
+
+          const updateCallback = async () => {
+            try {
+              const res = await fetch(targetUrl);
+              const html = await res.text();
+              const parser = new DOMParser();
+              const doc = parser.parseFromString(html, 'text/html');
+
+              document.title = doc.title;
+              const currentMain = document.querySelector('main');
+              const newMain = doc.querySelector('main');
+              if (currentMain && newMain) {
+                currentMain.replaceWith(newMain);
+              } else {
+                document.body.innerHTML = doc.body.innerHTML;
+              }
+              window.history.pushState({}, '', targetUrl);
+            } catch (err) {
+              window.location.href = targetUrl;
+            }
+          };
+
+          navigate(updateCallback, direction);
+        }
+      }
+
+      document.addEventListener('click', handleDirectionalClick, true);
+
+      document.addEventListener('astro:before-swap', (e) => {
+        if (e.viewTransition && e.viewTransition.types) {
+          const dir = e.direction === 'back' ? 'backward' : 'forward';
+          try {
+            e.viewTransition.types.add(dir);
+          } catch (_) {}
+        }
+      });
+    </script>
   </head>
