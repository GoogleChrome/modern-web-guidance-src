diff --git a/src/components/FeaturedStorySlider.astro b/src/components/FeaturedStorySlider.astro
new file mode 100644
index 0000000..2e29093
--- /dev/null
+++ b/src/components/FeaturedStorySlider.astro
@@ -0,0 +1,161 @@
+---
+import type { CollectionEntry } from 'astro:content';
+import { Image } from 'astro:assets';
+import { getArticleImage } from '../utils/images';
+import { ArrowLongLeftIcon, ArrowLongRightIcon, BookOpenIcon } from '@heroicons/react/24/outline';
+
+export interface Props {
+    title: string;
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { title, articles } = Astro.props;
+
+if (articles.length < 2) {
+    throw new Error('FeaturedStorySlider requires at least 2 articles.');
+}
+
+const slides = await Promise.all(
+    articles.map(async (article) => ({
+        article,
+        image: await getArticleImage(article),
+        category: article.data.category.charAt(0).toUpperCase() + article.data.category.slice(1),
+    }))
+);
+
+const baseUrl = import.meta.env.BASE_URL;
+---
+
+<section class="p-4 md:p-6" data-featured-slider aria-roledescription="carousel" aria-label={title}>
+    <div class="flex flex-wrap items-baseline justify-between gap-x-4 border-b-2 border-gray-900 pb-2 mb-6 lg:mb-8">
+        <h2 class="text-3xl font-bold">{title}</h2>
+        <p class="text-sm text-gray-500" aria-live="polite">
+            Story <span data-slide-position>1</span> of {slides.length}
+        </p>
+    </div>
+
+    <div class="shadow-sm overflow-hidden">
+        {slides.map(({ article, image, category }, index) => (
+            <article
+                class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-8"
+                data-slide
+                hidden={index !== 0}
+                aria-roledescription="slide"
+                aria-label={`Story ${index + 1} of ${slides.length}`}
+            >
+                <a href={`${baseUrl}articles/${article.id}`} class="block w-full">
+                    <Image
+                        src={image}
+                        alt={article.data.title}
+                        width={800}
+                        height={450}
+                        format="webp"
+                        class="w-full h-full object-cover aspect-video"
+                    />
+                </a>
+                <div class="flex flex-col justify-center p-2 sm:p-4 lg:p-6">
+                    <a
+                        href={`${baseUrl}category/${article.data.category.toLowerCase()}`}
+                        class="text-amber-800 text-sm font-brand tracking-widest hover:underline"
+                    >
+                        {category}
+                    </a>
+                    <a href={`${baseUrl}articles/${article.id}`}>
+                        <h3 class="mt-2 text-3xl lg:text-4xl font-brand leading-tight hover:text-amber-400 transition-colors">
+                            {article.data.title}
+                        </h3>
+                    </a>
+                    <p class="mt-4 text-gray-700 text-base lg:text-lg">{article.data.summary}</p>
+                    <div class="flex items-center text-gray-500 text-sm mt-6">
+                        <BookOpenIcon className="w-4 h-4 mr-1.5" />
+                        <span>{article.data.readingTime} Min Read</span>
+                    </div>
+                </div>
+            </article>
+        ))}
+    </div>
+
+    <div class="flex justify-between items-center gap-4 mt-6">
+        <button
+            type="button"
+            data-slider-prev
+            class="inline-flex items-center gap-2 border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-900 hover:border-gray-900 hover:text-amber-800 transition-colors cursor-pointer"
+        >
+            <ArrowLongLeftIcon className="w-5 h-5" />
+            Previous
+        </button>
+        <button
+            type="button"
+            data-slider-next
+            class="inline-flex items-center gap-2 border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-900 hover:border-gray-900 hover:text-amber-800 transition-colors cursor-pointer"
+        >
+            Next
+            <ArrowLongRightIcon className="w-5 h-5" />
+        </button>
+    </div>
+</section>
+
+<script>
+    type Direction = 'forward' | 'backward';
+
+    /**
+     * Navigates to a new view with a directional transition.
+     */
+    function navigate(updateDOM: () => void, direction: Direction) {
+        // Feature detect for browsers that do not support View Transitions.
+        if (!document.startViewTransition) {
+            updateDOM();
+            return;
+        }
+
+        document.startViewTransition({
+            update: updateDOM,
+            types: [direction], // Matches the CSS :active-view-transition-type() selectors
+        });
+    }
+
+    function setupSlider(slider: HTMLElement) {
+        if (slider.dataset.sliderReady === 'true') return;
+        slider.dataset.sliderReady = 'true';
+
+        const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-slide]'));
+        const previousButton = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
+        const nextButton = slider.querySelector<HTMLButtonElement>('[data-slider-next]');
+        const position = slider.querySelector<HTMLElement>('[data-slide-position]');
+
+        if (slides.length < 2 || !previousButton || !nextButton) return;
+
+        let current = slides.findIndex((slide) => !slide.hidden);
+        if (current < 0) current = 0;
+
+        const render = () => {
+            slides.forEach((slide, index) => {
+                slide.hidden = index !== current;
+            });
+            if (position) position.textContent = String(current + 1);
+        };
+
+        const go = (offset: number, direction: Direction) => {
+            const target = (current + offset + slides.length) % slides.length;
+            navigate(() => {
+                current = target;
+                render();
+            }, direction);
+        };
+
+        nextButton.addEventListener('click', () => go(1, 'forward'));
+        previousButton.addEventListener('click', () => go(-1, 'backward'));
+
+        render();
+    }
+
+    function initSliders() {
+        document
+            .querySelectorAll<HTMLElement>('[data-featured-slider]')
+            .forEach(setupSlider);
+    }
+
+    initSliders();
+    // Re-initialize after client-side navigations performed by Astro's ClientRouter.
+    document.addEventListener('astro:page-load', initSliders);
+</script>
