diff --git a/src/components/TopStoriesCarousel.astro b/src/components/TopStoriesCarousel.astro
new file mode 100644
index 0000000..c21949c
--- /dev/null
+++ b/src/components/TopStoriesCarousel.astro
@@ -0,0 +1,142 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+export interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+const baseUrl = import.meta.env.BASE_URL;
+---
+
+<section class="bg-white border-b border-gray-300" aria-label="Top Stories" data-top-stories-carousel>
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
+        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
+            <div class="flex items-center gap-3 overflow-hidden flex-1 min-w-0" aria-live="polite">
+                <span class="text-xs font-bold uppercase tracking-wider text-amber-800 shrink-0">Top Stories</span>
+                <span class="text-xs text-gray-500 shrink-0 font-medium" data-story-counter>1 / {articles.length}</span>
+                <div class="border-l border-gray-300 pl-3 min-w-0 flex-1 relative overflow-hidden">
+                    {articles.map((article, index) => (
+                        <div
+                            class="story-slide flex items-baseline gap-3 min-w-0"
+                            data-slide-index={index}
+                            style={index === 0 ? "display: flex;" : "display: none;"}
+                        >
+                            <a href={`${baseUrl}articles/${article.id}`} class="min-w-0 truncate">
+                                <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer truncate">
+                                    {article.data.title}
+                                </h3>
+                            </a>
+                            <span class="text-xs text-gray-500 shrink-0 hidden md:inline">
+                                {article.data.date.toLocaleDateString()}
+                            </span>
+                        </div>
+                    ))}
+                </div>
+            </div>
+
+            <div class="flex items-center gap-2 shrink-0 self-end sm:self-auto">
+                <button
+                    type="button"
+                    id="prev"
+                    class="px-3 py-1.5 border border-gray-300 rounded text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50 hover:border-gray-400 hover:text-amber-800 flex items-center gap-1 cursor-pointer transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
+                    aria-label="Previous"
+                >
+                    <span aria-hidden="true">&larr;</span> Previous
+                </button>
+                <button
+                    type="button"
+                    id="next"
+                    class="px-3 py-1.5 border border-gray-300 rounded text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50 hover:border-gray-400 hover:text-amber-800 flex items-center gap-1 cursor-pointer transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600"
+                    aria-label="Next"
+                >
+                    Next <span aria-hidden="true">&rarr;</span>
+                </button>
+            </div>
+        </div>
+    </div>
+</section>
+
+<script>
+    type Direction = 'forward' | 'backward';
+
+    /**
+     * Navigates to a new view with a directional transition.
+     * @param {Function} updateDOM - Callback to update the DOM state.
+     * @param {string} direction - Either 'forward' or 'backward'.
+     */
+    function navigate(updateDOM: () => void, direction: Direction) {
+        // Feature detect for browsers that do not support View Transitions
+        if (!document.startViewTransition) {
+            updateDOM();
+            return;
+        }
+
+        // Start transition with the specific navigation type
+        try {
+            const transition = document.startViewTransition({
+                update: updateDOM,
+                types: [direction] // Matches the CSS :active-view-transition-type() selectors
+            });
+            if (transition && 'types' in transition && (transition as any).types?.add) {
+                try {
+                    (transition as any).types.add(direction);
+                } catch (_) {}
+            }
+            return transition;
+        } catch (_) {
+            updateDOM();
+        }
+    }
+
+    if (typeof window !== 'undefined') {
+        (window as any).navigate = navigate;
+    }
+
+    function initTopStoriesCarousel() {
+        const carousel = document.querySelector<HTMLElement>('[data-top-stories-carousel]');
+        if (!carousel) return;
+
+        if (carousel.dataset.initialized === 'true') return;
+        carousel.dataset.initialized = 'true';
+
+        const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.story-slide'));
+        const counter = carousel.querySelector<HTMLElement>('[data-story-counter]');
+        const prevButton = carousel.querySelector<HTMLButtonElement>('#prev');
+        const nextButton = carousel.querySelector<HTMLButtonElement>('#next');
+
+        if (slides.length <= 1 || !prevButton || !nextButton) return;
+
+        let currentIndex = 0;
+
+        function updateSlideUI(newIndex: number) {
+            currentIndex = newIndex;
+            slides.forEach((slide, idx) => {
+                slide.style.display = idx === currentIndex ? 'flex' : 'none';
+            });
+            if (counter) {
+                counter.textContent = `${currentIndex + 1} / ${slides.length}`;
+            }
+        }
+
+        function goToSlide(newIndex: number, direction: Direction) {
+            const wrappedIndex = (newIndex + slides.length) % slides.length;
+            navigate(() => {
+                updateSlideUI(wrappedIndex);
+            }, direction);
+        }
+
+        prevButton.addEventListener('click', (e) => {
+            e.preventDefault();
+            goToSlide(currentIndex - 1, 'backward');
+        });
+
+        nextButton.addEventListener('click', (e) => {
+            e.preventDefault();
+            goToSlide(currentIndex + 1, 'forward');
+        });
+    }
+
+    initTopStoriesCarousel();
+    document.addEventListener('astro:page-load', initTopStoriesCarousel);
+</script>
