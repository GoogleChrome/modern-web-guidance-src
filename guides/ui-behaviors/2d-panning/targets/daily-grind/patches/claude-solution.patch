+  <script>
+    // Fallback for browsers without `scroll-axis-lock`: apply raw, unlocked
+    // 2D deltas directly to scrollLeft/scrollTop (never CSS transform).
+    (function () {
+      if (window.CSS && CSS.supports && CSS.supports('scroll-axis-lock', 'none')) return;
+
+      var viewport = document.querySelector('.map-viewport');
+      if (!viewport) return;
+      var lastPointer = null;
+
+      // 1. Trackpad and mouse wheel fallback
+      viewport.addEventListener('wheel', function (e) {
+        if (e.ctrlKey) return; // leave pinch-zoom gestures to the browser
+        var scale = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? viewport.clientHeight : 1;
+        e.preventDefault();
+        viewport.scrollLeft += e.deltaX * scale;
+        viewport.scrollTop += e.deltaY * scale;
+      }, { passive: false });
+
+      // 2. Touch and pointer drag fallback
+      viewport.addEventListener('pointerdown', function (e) {
+        // Ignore non-primary buttons and clicks on native scrollbars
+        var rect = viewport.getBoundingClientRect();
+        if (
+          !e.isPrimary ||
+          e.button !== 0 ||
+          e.clientX - rect.left - viewport.clientLeft >= viewport.clientWidth ||
+          e.clientY - rect.top - viewport.clientTop >= viewport.clientHeight
+        ) {
+          return;
+        }
+        lastPointer = { x: e.clientX, y: e.clientY };
+        viewport.setPointerCapture(e.pointerId);
+      });
+
+      viewport.addEventListener('pointermove', function (e) {
+        if (!lastPointer) return;
+        viewport.scrollLeft -= e.clientX - lastPointer.x;
+        viewport.scrollTop -= e.clientY - lastPointer.y;
+        lastPointer = { x: e.clientX, y: e.clientY };
+      });
+
+      function endPointerPan() {
+        lastPointer = null;
+      }
+      viewport.addEventListener('pointerup', endPointerPan);
+      viewport.addEventListener('pointercancel', endPointerPan);
+    })();
+  </script>
