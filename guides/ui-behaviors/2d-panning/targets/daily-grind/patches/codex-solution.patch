+  <script>
+    const viewport = document.querySelector('.pan-viewport');
+    if (viewport instanceof HTMLElement && !CSS.supports('scroll-axis-lock', 'none')) {
+      viewport.classList.add('pointer-fallback');
+      let activePointer = null;
+
+      viewport.addEventListener('wheel', (event) => {
+        // Preserve browser zoom gestures.
+        if (event.ctrlKey) return;
+        event.preventDefault();
+        const unitX = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? viewport.clientWidth : 1;
+        const unitY = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? viewport.clientHeight : 1;
+        viewport.scrollLeft += event.deltaX * unitX;
+        viewport.scrollTop += event.deltaY * unitY;
+      }, { passive: false });
+
+      viewport.addEventListener('pointerdown', (event) => {
+        const rect = viewport.getBoundingClientRect();
+        const x = event.clientX - rect.left - viewport.clientLeft;
+        const y = event.clientY - rect.top - viewport.clientTop;
+        if (!event.isPrimary || event.button !== 0 || activePointer !== null ||
+            x < 0 || y < 0 || x >= viewport.clientWidth || y >= viewport.clientHeight) return;
+        activePointer = { id: event.pointerId, x: event.clientX, y: event.clientY };
+        viewport.focus({ preventScroll: true });
+        viewport.setPointerCapture(event.pointerId);
+        viewport.classList.add('is-panning');
+      });
+
+      viewport.addEventListener('pointermove', (event) => {
+        if (activePointer === null || event.pointerId !== activePointer.id) return;
+        viewport.scrollLeft -= event.clientX - activePointer.x;
+        viewport.scrollTop -= event.clientY - activePointer.y;
+        activePointer.x = event.clientX;
+        activePointer.y = event.clientY;
+      });
+
+      const endPan = (event) => {
+        if (activePointer === null || event.pointerId !== activePointer.id) return;
+        activePointer = null;
+        viewport.classList.remove('is-panning');
+        if (viewport.hasPointerCapture(event.pointerId)) viewport.releasePointerCapture(event.pointerId);
+      };
+      viewport.addEventListener('pointerup', endPan);
+      viewport.addEventListener('pointercancel', endPan);
+      viewport.addEventListener('lostpointercapture', endPan);
+    }
+  </script>
