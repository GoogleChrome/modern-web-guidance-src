+  <script>
+    // Keep native scrolling and momentum wherever unrestricted panning is supported.
+    const mapViewport = document.querySelector('.map-viewport');
+    if (mapViewport instanceof HTMLElement && !CSS.supports('scroll-axis-lock', 'none')) {
+      /** @type {{ id: number, x: number, y: number } | null} */
+      let pointer = null;
+
+      mapViewport.addEventListener('wheel', (event) => {
+        // Preserve browser zoom gestures, including trackpad pinch-to-zoom.
+        if (event.ctrlKey || !event.cancelable) return;
+        event.preventDefault();
+        const lineHeight = parseFloat(getComputedStyle(mapViewport).lineHeight) || 16;
+        const unitX = event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? mapViewport.clientWidth
+          : event.deltaMode === WheelEvent.DOM_DELTA_LINE ? lineHeight : 1;
+        const unitY = event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? mapViewport.clientHeight
+          : event.deltaMode === WheelEvent.DOM_DELTA_LINE ? lineHeight : 1;
+        mapViewport.scrollLeft += event.deltaX * unitX;
+        mapViewport.scrollTop += event.deltaY * unitY;
+      }, { passive: false });
+
+      mapViewport.addEventListener('pointerdown', (event) => {
+        if (!event.isPrimary || event.button !== 0 || pointer) return;
+        const rect = mapViewport.getBoundingClientRect();
+        const x = event.clientX - rect.left - mapViewport.clientLeft;
+        const y = event.clientY - rect.top - mapViewport.clientTop;
+        // Leave native scrollbar interaction to the browser.
+        if (x < 0 || y < 0 || x >= mapViewport.clientWidth || y >= mapViewport.clientHeight) return;
+        pointer = { id: event.pointerId, x: event.clientX, y: event.clientY };
+        mapViewport.setPointerCapture(event.pointerId);
+        mapViewport.focus({ preventScroll: true });
+        mapViewport.classList.add('is-panning');
+      });
+
+      mapViewport.addEventListener('pointermove', (event) => {
+        if (!pointer || event.pointerId !== pointer.id) return;
+        mapViewport.scrollLeft -= event.clientX - pointer.x;
+        mapViewport.scrollTop -= event.clientY - pointer.y;
+        pointer.x = event.clientX;
+        pointer.y = event.clientY;
+      });
+
+      /** @param {PointerEvent} event */
+      const endPan = (event) => {
+        if (!pointer || event.pointerId !== pointer.id) return;
+        pointer = null;
+        mapViewport.classList.remove('is-panning');
+        if (mapViewport.hasPointerCapture(event.pointerId)) {
+          mapViewport.releasePointerCapture(event.pointerId);
+        }
+      };
+      mapViewport.addEventListener('pointerup', endPan);
+      mapViewport.addEventListener('pointercancel', endPan);
+      mapViewport.addEventListener('lostpointercapture', endPan);
+      mapViewport.classList.add('has-pan-fallback');
+    }
+  </script>
