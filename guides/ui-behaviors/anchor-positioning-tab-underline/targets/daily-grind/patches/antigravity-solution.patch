@@ -207,6 +239,31 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const navList = document.querySelector('nav[aria-label="Primary"] ul');
+    if (navList) {
+      const tabLinks = navList.querySelectorAll('a:not(.logout-link)');
+      tabLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          const currentActive = navList.querySelector('li.active');
+          if (currentActive) {
+            currentActive.classList.remove('active');
+            const currentLink = currentActive.querySelector('a');
+            if (currentLink) {
+              currentLink.removeAttribute('aria-current');
+            }
+          }
+          const nextItem = link.closest('li');
+          if (nextItem) {
+            nextItem.classList.add('active');
+          }
+          link.setAttribute('aria-current', 'page');
+        });
+      });
+    }
+  </script>
+
 </body>
 
