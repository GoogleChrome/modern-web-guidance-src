+  <script>
+    (function () {
+      const tabs = Array.from(document.querySelectorAll('nav li.nav-tab'));
+
+      function setActive(tab) {
+        tabs.forEach(function (item) {
+          const link = item.querySelector('a');
+          const isActive = item === tab;
+          item.classList.toggle('active', isActive);
+          if (!link) return;
+          if (isActive) {
+            link.setAttribute('aria-current', 'page');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // Reflect the current URL on load, if it matches a nav item.
+      const current = tabs.find(function (item) {
+        const link = item.querySelector('a');
+        return link && link.pathname === window.location.pathname;
+      });
+      if (current) setActive(current);
+
+      // Move the underline in-page when a nav item is selected. The animation
+      // cannot run across full page loads, so the selection is handled here.
+      tabs.forEach(function (item) {
+        const link = item.querySelector('a');
+        if (!link) return;
+        link.addEventListener('click', function (event) {
+          if (event.defaultPrevented || event.button !== 0 ||
+            event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+            return;
+          }
+          event.preventDefault();
+          setActive(item);
+        });
+      });
+    })();
+  </script>
+
 </body>
 
