+    /* Active nav item: anchor for the animated underline */
+    nav ul li.active {
+      anchor-name: --active-nav-item;
+    }
+
+    nav ul li.active > a {
+      color: var(--accent);
+    }
+
+    /* Animated underline indicator, drawn by a pseudo-element on the list */
+    nav ul::before {
+      content: '';
+      position: absolute;
+      position-anchor: --active-nav-item;
+      inset-block-start: calc(anchor(self-end) + .1lh);
+      inset-inline-start: anchor(self-start);
+      inset-inline-end: anchor(self-end);
+      /* Border (not background/box-shadow) so it survives forced colors mode */
+      border-block-end: .25lh solid var(--accent);
+      pointer-events: none;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      nav ul::before {
+        transition: inset .2s;
+      }
+    }
+
+    /* Fallback: no anchor positioning support, use a static border */
+    @supports not (position-anchor: --active-nav-item) {
+      nav ul::before {
+        content: none;
+      }
+
+      nav ul li.active {
+        border-block-end: .25lh solid var(--accent);
+      }
+    }
+
