+  <script>
+    const navigationLinks = document.querySelectorAll('nav a:not(.logout-link)');
+
+    function selectNavigationLink(selectedLink) {
+      navigationLinks.forEach((link) => {
+        const isSelected = link === selectedLink;
+        link.parentElement.classList.toggle('active', isSelected);
+        if (isSelected) {
+          link.setAttribute('aria-current', 'page');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    const currentLink = Array.from(navigationLinks).find(
+      (link) => new URL(link.href).pathname === window.location.pathname
+    );
+    if (currentLink) selectNavigationLink(currentLink);
+
+    navigationLinks.forEach((link) => {
+      link.addEventListener('click', (event) => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        selectNavigationLink(link);
+      });
+    });
+  </script>
 </body>
 
