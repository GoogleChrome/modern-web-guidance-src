+  <script>
+    const navItems = document.querySelector('nav')?.querySelectorAll('a') ?? [];
+    let activeNavItem = Array.from(navItems).find((link) => link.hasAttribute('aria-current'));
+
+    for (const navItem of navItems) {
+      if (!navItem.hasAttribute('data-nav-item')) {
+        continue;
+      }
+
+      navItem.addEventListener('click', (event) => {
+        if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+          return;
+        }
+
+        event.preventDefault();
+        if (navItem === activeNavItem) {
+          return;
+        }
+
+        activeNavItem?.removeAttribute('aria-current');
+        activeNavItem?.parentElement?.classList.remove('active');
+        navItem.setAttribute('aria-current', 'page');
+        navItem.parentElement?.classList.add('active');
+        activeNavItem = navItem;
+      });
+    }
+  </script>
