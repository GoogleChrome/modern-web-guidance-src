+  <script>
+    (() => {
+      const DIRECTION_TOLERANCE_PX = 2;
+      const ALIGNMENT_WEIGHT = 2;
+      const FOCUSABLE_SELECTOR = [
+        'a[href]',
+        'area[href]',
+        'button:not([disabled])',
+        'input:not([disabled]):not([type="hidden"])',
+        'select:not([disabled])',
+        'textarea:not([disabled])',
+        '[tabindex]',
+        '[contenteditable]:not([contenteditable="false"])',
+      ].join(', ');
+      const ARROW_CONTROL_SELECTOR =
+        ':read-write, select, input[type="range"], [role="slider"]';
+
+      const DIRECTION_CONFIG = {
+        ArrowRight: {
+          inDirection: (cur, cand) => cand.left >= cur.right - DIRECTION_TOLERANCE_PX,
+          gap: (cur, cand) => Math.max(0, cand.left - cur.right),
+          perpStart: 'top',
+          perpEnd: 'bottom',
+        },
+        ArrowLeft: {
+          inDirection: (cur, cand) => cand.right <= cur.left + DIRECTION_TOLERANCE_PX,
+          gap: (cur, cand) => Math.max(0, cur.left - cand.right),
+          perpStart: 'top',
+          perpEnd: 'bottom',
+        },
+        ArrowDown: {
+          inDirection: (cur, cand) => cand.top >= cur.bottom - DIRECTION_TOLERANCE_PX,
+          gap: (cur, cand) => Math.max(0, cand.top - cur.bottom),
+          perpStart: 'left',
+          perpEnd: 'right',
+        },
+        ArrowUp: {
+          inDirection: (cur, cand) => cand.bottom <= cur.top + DIRECTION_TOLERANCE_PX,
+          gap: (cur, cand) => Math.max(0, cur.top - cand.bottom),
+          perpStart: 'left',
+          perpEnd: 'right',
+        },
+      };
+
+      function isElementVisible(el) {
+        if (typeof el.checkVisibility === 'function') {
+          if (!el.checkVisibility({ visibilityProperty: true })) {
+            return false;
+          }
+        }
+        const rect = el.getBoundingClientRect();
+        return rect.width > 0 && rect.height > 0;
+      }
+
+      function getCandidates(container) {
+        return Array.from(container.querySelectorAll(FOCUSABLE_SELECTOR)).filter(
+          (el) => !el.closest('[inert]') && isElementVisible(el)
+        );
+      }
+
+      function setActiveCandidate(candidates, activeEl) {
+        for (const el of candidates) {
+          el.setAttribute('tabindex', el === activeEl ? '0' : '-1');
+        }
+      }
+
+      function syncRovingTabindex(container) {
+        const candidates = getCandidates(container);
+        if (candidates.length === 0) return;
+        const currentTabbable = candidates.find(
+          (el) => el.getAttribute('tabindex') === '0'
+        );
+        setActiveCandidate(candidates, currentTabbable ?? candidates[0]);
+      }
+
+      function findSpatialCandidate(currentEl, candidates, direction) {
+        const config = DIRECTION_CONFIG[direction];
+        if (!config) return null;
+
+        const currentRect = currentEl.getBoundingClientRect();
+        const aligned = [];
+        const fallback = [];
+
+        for (const el of candidates) {
+          if (el === currentEl) continue;
+          const rect = el.getBoundingClientRect();
+          if (rect.width <= 0 || rect.height <= 0) continue;
+          if (!config.inDirection(currentRect, rect)) continue;
+
+          const gap = config.gap(currentRect, rect);
+          const { perpStart, perpEnd } = config;
+          const overlaps =
+            Math.min(currentRect[perpEnd], rect[perpEnd]) >
+            Math.max(currentRect[perpStart], rect[perpStart]);
+          const currentPerpCenter =
+            (currentRect[perpStart] + currentRect[perpEnd]) / 2;
+          const candPerpCenter = (rect[perpStart] + rect[perpEnd]) / 2;
+          const perpOffset = Math.abs(candPerpCenter - currentPerpCenter);
+
+          const entry = { el, gap, perpOffset };
+          if (overlaps) {
+            aligned.push(entry);
+          } else {
+            fallback.push(entry);
+          }
+        }
+
+        if (aligned.length > 0) {
+          aligned.sort((a, b) => a.gap - b.gap || a.perpOffset - b.perpOffset);
+          return aligned[0].el;
+        }
+
+        if (fallback.length > 0) {
+          fallback.sort(
+            (a, b) =>
+              a.gap +
+              ALIGNMENT_WEIGHT * a.perpOffset -
+              (b.gap + ALIGNMENT_WEIGHT * b.perpOffset)
+          );
+          return fallback[0].el;
+        }
+
+        return null;
+      }
+
+      function getInnermostTarget(e) {
+        const path = typeof e.composedPath === 'function' ? e.composedPath() : [];
+        const target = path[0] ?? e.target;
+        return target instanceof Element ? target : null;
+      }
+
+      function initSpatialGrid(container) {
+        syncRovingTabindex(container);
+
+        container.addEventListener('focusin', (e) => {
+          const target = getInnermostTarget(e);
+          if (!target) return;
+
+          const candidates = getCandidates(container);
+          if (candidates.includes(target)) {
+            setActiveCandidate(candidates, target);
+          }
+        });
+
+        container.addEventListener('keydown', (e) => {
+          if (e.defaultPrevented) return;
+          if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+          if (!Object.hasOwn(DIRECTION_CONFIG, e.key)) return;
+
+          const target = getInnermostTarget(e);
+          if (!target) return;
+          if (target.matches(ARROW_CONTROL_SELECTOR)) return;
+
+          const candidates = getCandidates(container);
+          if (!candidates.includes(target)) return;
+
+          const next = findSpatialCandidate(target, candidates, e.key);
+          if (!next) return;
+
+          e.preventDefault();
+          setActiveCandidate(candidates, next);
+          next.focus({ preventScroll: true });
+          next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+      }
+
+      document
+        .querySelectorAll('.grid[role="grid"]')
+        .forEach((grid) => initSpatialGrid(grid));
+    })();
+  </script>
+
