+// @ts-check
+
+const itemSelector = '[role="gridcell"] > a[href]';
+const gridSelector = '[data-spatial-grid]';
+const edgeTolerance = 0.5;
+
+/** @typedef {'ArrowLeft' | 'ArrowRight' | 'ArrowUp' | 'ArrowDown'} Direction */
+
+/**
+ * @param {HTMLAnchorElement} current
+ * @param {HTMLAnchorElement[]} items
+ * @param {Direction} direction
+ */
+function findNextItem(current, items, direction) {
+  const horizontal = direction === 'ArrowLeft' || direction === 'ArrowRight';
+  const forward = direction === 'ArrowRight' || direction === 'ArrowDown';
+  const start = horizontal ? 'left' : 'top';
+  const end = horizontal ? 'right' : 'bottom';
+  const crossStart = horizontal ? 'top' : 'left';
+  const crossEnd = horizontal ? 'bottom' : 'right';
+  const origin = current.getBoundingClientRect();
+  const originCenter = (origin[crossStart] + origin[crossEnd]) / 2;
+
+  /** @type {{ item: HTMLAnchorElement, gap: number, offset: number } | undefined} */
+  let aligned;
+  /** @type {{ item: HTMLAnchorElement, score: number } | undefined} */
+  let fallback;
+
+  for (const item of items) {
+    if (item === current) continue;
+    const rect = item.getBoundingClientRect();
+    const edgeGap = forward ? rect[start] - origin[end] : origin[start] - rect[end];
+    if (edgeGap < -edgeTolerance) continue;
+
+    const gap = Math.max(0, edgeGap);
+    const offset = Math.abs((rect[crossStart] + rect[crossEnd]) / 2 - originCenter);
+    const overlaps = rect[crossStart] < origin[crossEnd] && rect[crossEnd] > origin[crossStart];
+
+    if (overlaps) {
+      if (!aligned || gap < aligned.gap || (gap === aligned.gap && offset < aligned.offset)) {
+        aligned = { item, gap, offset };
+      }
+    } else {
+      const score = gap + 2 * offset;
+      if (!fallback || score < fallback.score) fallback = { item, score };
+    }
+  }
+
+  return aligned?.item ?? fallback?.item;
+}
+
+/** @param {HTMLAnchorElement} item */
+function isVisible(item) {
+  if (item.closest('[inert], [hidden]')) return false;
+  if (typeof item.checkVisibility === 'function') {
+    return item.checkVisibility({ checkVisibilityCSS: true, checkOpacity: true });
+  }
+  return item.getClientRects().length > 0 && getComputedStyle(item).visibility === 'visible';
+}
+
+for (const grid of document.querySelectorAll(gridSelector)) {
+  const getItems = () => Array.from(grid.querySelectorAll(itemSelector))
+    .filter((/** @type {Element} */ item) => item.closest(gridSelector) === grid)
+    .filter((item) => item instanceof HTMLAnchorElement);
+
+  /** @param {Element} active */
+  function setTabStop(active) {
+    for (const item of getItems()) item.tabIndex = item === active ? 0 : -1;
+  }
+
+  const firstItem = getItems().find(isVisible);
+  if (firstItem) setTabStop(firstItem);
+
+  grid.addEventListener('focusin', (event) => {
+    const target = event.composedPath()[0];
+    if (target instanceof HTMLAnchorElement && getItems().includes(target)) setTabStop(target);
+  });
+
+  grid.addEventListener('keydown', (event) => {
+    if (!(event instanceof KeyboardEvent) || event.defaultPrevented || event.isComposing ||
+        event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
+
+    const direction = event.key;
+    if (direction !== 'ArrowLeft' && direction !== 'ArrowRight' &&
+        direction !== 'ArrowUp' && direction !== 'ArrowDown') return;
+
+    const target = event.composedPath()[0];
+    if (!(target instanceof HTMLAnchorElement) || target.isContentEditable ||
+        target.matches(':read-write, [role="slider"]') || target !== document.activeElement) return;
+
+    const items = getItems().filter(isVisible);
+    if (!items.includes(target)) return;
+
+    const next = findNextItem(target, items, direction);
+    if (!next) return;
+
+    setTabStop(next);
+    next.focus({ preventScroll: true });
+    if (document.activeElement !== next) {
+      setTabStop(target);
+      return;
+    }
+    event.preventDefault();
+    next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+  });
+}
