+<script>
+  (function () {
+    var container = document.getElementById('spatial-grid');
+    var SELECTOR = 'a[href], button:not([disabled])';
+    var TOLERANCE = 2;
+    var WEIGHT = 3;
+
+    function candidates() {
+      return Array.prototype.slice.call(container.querySelectorAll(SELECTOR))
+        .filter(function (el) { return el.checkVisibility(); });
+    }
+
+    function initTabindex() {
+      var items = candidates();
+      items.forEach(function (el, i) { el.tabIndex = i === 0 ? 0 : -1; });
+    }
+
+    function overlap(a0, a1, b0, b1) {
+      return Math.min(a1, b1) - Math.max(a0, b0) > 0;
+    }
+
+    function find(current, items, dir) {
+      var c = current.getBoundingClientRect();
+      var horiz = dir === 'ArrowLeft' || dir === 'ArrowRight';
+      var aligned = null, fallback = null;
+      items.forEach(function (el) {
+        if (el === current) return;
+        var r = el.getBoundingClientRect();
+        var gap;
+        if (dir === 'ArrowRight') { if (r.left < c.right - TOLERANCE) return; gap = r.left - c.right; }
+        else if (dir === 'ArrowLeft') { if (r.right > c.left + TOLERANCE) return; gap = c.left - r.right; }
+        else if (dir === 'ArrowDown') { if (r.top < c.bottom - TOLERANCE) return; gap = r.top - c.bottom; }
+        else { if (r.bottom > c.top + TOLERANCE) return; gap = c.top - r.bottom; }
+        gap = Math.max(gap, 0);
+        var off = horiz
+          ? Math.abs((r.top + r.bottom) / 2 - (c.top + c.bottom) / 2)
+          : Math.abs((r.left + r.right) / 2 - (c.left + c.right) / 2);
+        var ov = horiz
+          ? overlap(c.top, c.bottom, r.top, r.bottom)
+          : overlap(c.left, c.right, r.left, r.right);
+        if (ov) {
+          if (!aligned || gap < aligned.gap || (gap === aligned.gap && off < aligned.off)) aligned = { el: el, gap: gap, off: off };
+        } else {
+          var score = gap + WEIGHT * off;
+          if (!fallback || score < fallback.score) fallback = { el: el, score: score };
+        }
+      });
+      return aligned ? aligned.el : fallback ? fallback.el : null;
+    }
+
+    container.addEventListener('keydown', function (e) {
+      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].indexOf(e.key) === -1) return;
+      var t = e.composedPath()[0];
+      if (t instanceof Element && t.matches(':read-write, select, input[type="range"], [role="slider"]')) return;
+      var items = candidates();
+      var current = document.activeElement;
+      if (items.indexOf(current) === -1) return;
+      var next = find(current, items, e.key);
+      if (!next) return;
+      e.preventDefault();
+      items.forEach(function (el) { el.tabIndex = el === next ? 0 : -1; });
+      next.focus();
+      next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+    });
+
+    initTabindex();
+  })();
+</script>
