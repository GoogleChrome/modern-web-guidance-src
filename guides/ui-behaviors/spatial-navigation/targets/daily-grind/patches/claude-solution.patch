+  <script>
+    (() => {
+      'use strict';
+
+      // Sub-pixel rounding allowance for edge comparisons.
+      const TOLERANCE = 1;
+      // Weight for perpendicular misalignment in fallback scoring (>= 2; larger favours aligned items).
+      const PERPENDICULAR_WEIGHT = 3;
+      const ITEM_SELECTOR = 'a[href], button:not([disabled])';
+      const KEY_DIRECTIONS = {
+        ArrowUp: 'up',
+        ArrowDown: 'down',
+        ArrowLeft: 'left',
+        ArrowRight: 'right',
+      };
+
+      /** Visible focusable items in the widget, in DOM order. */
+      function getCandidates(container) {
+        return Array.from(container.querySelectorAll(ITEM_SELECTOR)).filter((el) =>
+          el.checkVisibility({ visibilityProperty: true, opacityProperty: true })
+        );
+      }
+
+      /**
+       * Returns geometry along the navigation axis for `direction`:
+       * gap = distance from current's far edge to candidate's near edge (negative = behind).
+       */
+      function measure(current, candidate, direction) {
+        const horizontal = direction === 'left' || direction === 'right';
+        let gap;
+        switch (direction) {
+          case 'right': gap = candidate.left - current.right; break;
+          case 'left': gap = current.left - candidate.right; break;
+          case 'down': gap = candidate.top - current.bottom; break;
+          case 'up': gap = current.top - candidate.bottom; break;
+        }
+        // Perpendicular extents and centres.
+        const [curStart, curEnd, candStart, candEnd] = horizontal
+          ? [current.top, current.bottom, candidate.top, candidate.bottom]
+          : [current.left, current.right, candidate.left, candidate.right];
+        const overlaps = candStart < curEnd - TOLERANCE && candEnd > curStart + TOLERANCE;
+        const offset = Math.abs((candStart + candEnd) / 2 - (curStart + curEnd) / 2);
+        return { gap, overlaps, offset };
+      }
+
+      /** Picks the best candidate in `direction` from live geometry, or null. */
+      function findTarget(container, current, direction) {
+        const currentRect = current.getBoundingClientRect();
+        let bestAligned = null;
+        let bestFallback = null;
+
+        for (const el of getCandidates(container)) {
+          if (el === current) continue;
+          const { gap, overlaps, offset } = measure(currentRect, el.getBoundingClientRect(), direction);
+          // Edge-based direction filter.
+          if (gap < -TOLERANCE) continue;
+          const g = Math.max(gap, 0);
+
+          if (overlaps) {
+            if (
+              !bestAligned ||
+              g < bestAligned.gap - TOLERANCE ||
+              (Math.abs(g - bestAligned.gap) <= TOLERANCE && offset < bestAligned.offset)
+            ) {
+              bestAligned = { el, gap: g, offset };
+            }
+          } else if (!bestAligned) {
+            const score = g + PERPENDICULAR_WEIGHT * offset;
+            if (!bestFallback || score < bestFallback.score) {
+              bestFallback = { el, score };
+            }
+          }
+        }
+
+        return bestAligned?.el ?? bestFallback?.el ?? null;
+      }
+
+      function setActive(container, item) {
+        for (const el of container.querySelectorAll(ITEM_SELECTOR)) {
+          el.tabIndex = el === item ? 0 : -1;
+        }
+      }
+
+      /** Ensure exactly one visible item is the tab stop. */
+      function ensureTabStop(container) {
+        const candidates = getCandidates(container);
+        if (candidates.length === 0) return;
+        const active = candidates.find((el) => el.tabIndex === 0) ?? candidates[0];
+        setActive(container, active);
+      }
+
+      function initSpatialNav(container) {
+        ensureTabStop(container);
+
+        // Keep the roving tab stop in sync when items are focused by mouse or other means.
+        container.addEventListener('focusin', (e) => {
+          const target = e.target;
+          if (target instanceof HTMLElement && target.matches(ITEM_SELECTOR) && container.contains(target)) {
+            setActive(container, target);
+          }
+        });
+
+        container.addEventListener('keydown', (e) => {
+          const direction = KEY_DIRECTIONS[e.key];
+          if (!direction) return;
+          if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+
+          const target = e.composedPath()[0];
+          if (!(target instanceof HTMLElement)) return;
+          if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) return;
+          // Only act when the focused element is itself a candidate item of this widget.
+          if (!target.matches(ITEM_SELECTOR) || !getCandidates(container).includes(target)) return;
+
+          const next = findTarget(container, target, direction);
+          if (!next) return; // Let the browser scroll natively.
+
+          e.preventDefault();
+          setActive(container, next);
+          next.focus({ preventScroll: true });
+          next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+      }
+
+      document.querySelectorAll('[data-spatial-nav]').forEach((el) => {
+        if (el instanceof HTMLElement) initSpatialNav(el);
+      });
+    })();
+  </script>
