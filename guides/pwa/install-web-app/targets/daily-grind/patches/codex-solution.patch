diff --git a/build.mjs b/build.mjs
new file mode 100644
index 0000000..e5bd8b5
--- /dev/null
+++ b/build.mjs
@@ -0,0 +1,12 @@
+import { cp, mkdir } from 'node:fs/promises';
+
+const output = new URL('./dist/', import.meta.url);
+await mkdir(output, { recursive: true });
+
+for (const asset of ['index.html', 'manifest.webmanifest', 'icons']) {
+  await cp(new URL(asset, import.meta.url), new URL(asset, output), {
+    recursive: true,
+  });
+}
+
+console.log('Built The Daily Grind static site in dist/');
