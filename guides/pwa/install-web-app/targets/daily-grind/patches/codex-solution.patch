+  <script type="module">
+    const installControl = document.getElementById('install-app');
+    const installStatus = document.getElementById('install-status');
+
+    installControl?.addEventListener('installresult', (event) => {
+      if (!installStatus || !('result' in event)) return;
+
+      switch (event.result) {
+        case 'success':
+          installStatus.textContent = 'The Daily Grind was installed or opened.';
+          break;
+        case 'aborted':
+          installStatus.textContent = 'Installation was canceled or could not complete.';
+          break;
+        case 'invalid-data':
+          installStatus.textContent = 'Installation could not start because the app data is invalid.';
+          break;
+      }
+    });
