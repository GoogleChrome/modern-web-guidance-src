diff --git a/scripts/build.mjs b/scripts/build.mjs
new file mode 100644
index 0000000..aff49cf
--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,47 @@
+import assert from 'node:assert/strict';
+import { cp, mkdir, readFile, rm, writeFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+const read = (file) => readFile(path.join(root, file), 'utf8');
+const [html, oldManifest, newManifest, association] = await Promise.all([
+  read('index.html'),
+  read('manifest.json').then(JSON.parse),
+  read('new/manifest.json').then(JSON.parse),
+  read('.well-known/web-app-origin-association').then(JSON.parse),
+]);
+
+// These example origins share the explicitly known registrable domain example.com.
+// Keep this allowlist in sync with the deployment configuration when changing domains.
+const oldOrigin = 'https://old-app.example.com';
+const newOrigin = 'https://new-app.example.com';
+for (const origin of [oldOrigin, newOrigin]) {
+  const url = new URL(origin);
+  assert.equal(url.protocol, 'https:');
+  assert.ok(url.hostname.endsWith('.example.com'), 'Migration must stay same-site');
+}
+assert.ok(newManifest.id, 'The new app needs an explicit identity');
+assert.equal(new URL(oldManifest.id, oldOrigin).href, newManifest.migrate_from[0].id);
+assert.equal(new URL(newManifest.id, newOrigin).href, oldManifest.migrate_to[0].id);
+assert.equal(oldManifest.migrate_to[0].install_url, `${newOrigin}/`);
+assert.equal(association[newOrigin].allow_migration, true);
+assert.equal(association[`${newOrigin}/manifest.json`].allow_migration, true);
+assert.ok(html.includes('rel="manifest" href="/manifest.json"'));
+assert.ok(html.includes(`href="${newOrigin}/"`), 'The old app needs a fallback link');
+
+const banner = /\n  <aside class="migration-banner"[\s\S]*?<\/aside>\n/;
+assert.ok(banner.test(html), 'Expected a migration banner in the old app');
+const newHtml = html.replace(banner, '\n');
+
+const output = path.join(root, 'dist');
+await rm(output, { recursive: true, force: true });
+for (const site of ['old', 'new']) {
+  const destination = path.join(output, site);
+  await mkdir(destination, { recursive: true });
+  await writeFile(path.join(destination, 'index.html'), site === 'old' ? html : newHtml);
+  await cp(path.join(root, site === 'old' ? 'manifest.json' : 'new/manifest.json'), path.join(destination, 'manifest.json'));
+  await cp(path.join(root, 'icons'), path.join(destination, 'icons'), { recursive: true });
+}
+await cp(path.join(root, '.well-known'), path.join(output, 'old/.well-known'), { recursive: true });
+console.log('Migration configuration validated. Built dist/old and dist/new.');
