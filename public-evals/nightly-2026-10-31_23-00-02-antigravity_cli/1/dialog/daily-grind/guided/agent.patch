+    const notesEl = document.getElementById('dialog-drink-notes');
+    const totalEl = document.getElementById('order-total');
+    const orderForm = document.getElementById('order-form');
+    const quantityInput = document.getElementById('order-quantity');
+    const orderStatus = document.getElementById('order-status');
+
+    function formatCurrency(amount) {
+      return `$${amount.toFixed(2)}`;
+    }
+
+    function updateOrderTotal() {
+      const selectedDrinkInput = orderForm.querySelector('input[name="drink"]:checked');
+      const selectedSizeInput = orderForm.querySelector('input[name="size"]:checked');
+      const drinkKey = selectedDrinkInput ? selectedDrinkInput.value : 'maple-oat-latte';
+      const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+      const upcharge = selectedSizeInput ? parseFloat(selectedSizeInput.dataset.upcharge || '0') : 0;
+      const qty = Math.max(1, parseInt(quantityInput.value || '1', 10));
+      const unitPrice = Math.max(0, drink.basePrice + upcharge);
+      totalEl.textContent = formatCurrency(unitPrice * qty);
+    }
+
+    function selectDrink(drinkKey, setDefaultMilk = false) {
+      const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+      titleEl.textContent = drink.name;
+      imageEl.src = drink.image;
+      imageEl.alt = drink.imageAlt;
+      priceEl.textContent = formatCurrency(drink.basePrice);
+      caloriesEl.textContent = drink.calories;
+      caffeineEl.textContent = drink.caffeine;
+      descEl.textContent = drink.description;
+      notesEl.textContent = drink.notes;
+
+      for (const radio of orderForm.querySelectorAll('input[name="drink"]')) {
+        const isMatch = radio.value === drinkKey;
+        radio.checked = isMatch;
+        if (isMatch) {
+          radio.setAttribute('autofocus', '');
+        } else {
+          radio.removeAttribute('autofocus');
+        }
+      }
+
+      if (setDefaultMilk) {
+        for (const milkRadio of orderForm.querySelectorAll('input[name="milk"]')) {
+          milkRadio.checked = milkRadio.value === drink.defaultMilk;
+        }
+      }
+
+      updateOrderTotal();
+    }
+
+    // Wire up trigger buttons to populate drink details and open modal dialog
