+    if (closeBtn) {
+      closeBtn.addEventListener('click', () => {
+        if (dialog.open) {
+          dialog.close('cancel');
+        }
+      });
+    }
+
+    // Update details and total price when options change inside the form
+    orderForm.addEventListener('change', (e) => {
+      if (e.target.name === 'drink') {
+        selectDrink(e.target.value, true);
+      } else {
+        updateOrderTotal();
+      }
+    });
+
+    quantityInput.addEventListener('input', updateOrderTotal);
+
+    // Handle dialog close and reset returnValue to prevent stale values on subsequent Esc dismissals
+    dialog.addEventListener('close', () => {
+      const action = dialog.returnValue;
+      dialog.returnValue = '';
+
+      if (action === 'order') {
+        const formData = new FormData(orderForm);
+        const drinkKey = formData.get('drink');
+        const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+        const size = formData.get('size');
+        const milk = formData.get('milk');
+        const qty = formData.get('quantity') || '1';
+        orderStatus.textContent = `Added ${qty} × ${size} ${drink.name} (${milk}) — ${totalEl.textContent} to your order.`;
+        orderStatus.hidden = false;
+      }
+    });
+
+    // Fallback for browsers without <dialog closedby="any"> support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dlg) => {
+        const r = dlg.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dlg of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = true;
+        dlg.addEventListener('pointerdown', (e) => {
+          pressedOutside = outside(e, dlg);
+        });
+        dlg.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e, dlg)) dlg.close();
+        });
+        dlg.addEventListener('click', (e) => {
+          if (e.target === dlg && pressedOutside && outside(e, dlg) && dlg.open) {
+            dlg.close();
+          }
+          pressedOutside = true;
+        });
+      }
+    }
+  </script>
