+  <script>
+    (function () {
+      const DRINKS = {
+        'maple-oat-latte': {
+          name: 'Maple Oat Latte',
+          basePrice: 5.50,
+          badge: 'Hot or Iced \u2022 180 kcal',
+          description: 'Creamy oat milk steamed with double-shot espresso and pure grade-A Vermont maple syrup, topped with a dash of cinnamon.',
+          notes: 'Toasted oats, rich maple, warm spice.',
+          defaultMilk: 'oat'
+        },
+        'dark-roast-espresso': {
+          name: 'Dark Roast Espresso',
+          basePrice: 3.75,
+          badge: 'Hot \u2022 15 kcal',
+          description: 'Bold, smokey single-origin dark roast pulled as a rich double shot with velvety crema, perfect for a morning boost.',
+          notes: 'Dark chocolate, roasted walnut, smoky finish.',
+          defaultMilk: 'none'
+        },
+        'cold-brew': {
+          name: 'Cold Brew',
+          basePrice: 4.75,
+          badge: 'Iced \u2022 25 kcal',
+          description: 'Coarse-ground artisanal beans steeped in filtered cold water for 18 hours for maximum smoothness and low acidity.',
+          notes: 'Sweet caramel, cocoa nibs, crisp finish.',
+          defaultMilk: 'none'
+        }
+      };
+
+      const modal = document.getElementById('order-modal');
+      const modalTitle = document.getElementById('modal-title');
+      const modalPrice = document.getElementById('modal-price');
+      const modalBadge = document.getElementById('modal-badge');
+      const modalDescription = document.getElementById('modal-description');
+      const modalNotes = document.getElementById('modal-notes');
+      const drinkSelect = document.getElementById('drink-select');
+      const milkSelect = document.getElementById('milk-select');
+      const quantityInput = document.getElementById('quantity-input');
+      const orderTotalAmount = document.getElementById('order-total-amount');
+      const orderForm = document.getElementById('order-form');
+      const orderStatus = document.getElementById('order-status');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const cancelBtn = document.getElementById('modal-cancel-btn');
+      const triggerButtons = document.querySelectorAll('[data-open-modal]');
+
+      let lastFocusedTrigger = null;
+
+      function updateTotal() {
+        const drinkKey = drinkSelect.value;
+        const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+        const checkedSize = orderForm.querySelector('input[name="size"]:checked');
+        const upcharge = checkedSize ? parseFloat(checkedSize.dataset.upcharge || '0') : 0;
+        const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+        const total = (drink.basePrice + upcharge) * qty;
+        orderTotalAmount.textContent = '$' + total.toFixed(2);
+      }
+
+      function renderDrinkDetails(drinkKey, resetOptions) {
+        const key = DRINKS[drinkKey] ? drinkKey : 'maple-oat-latte';
+        const drink = DRINKS[key];
+
+        drinkSelect.value = key;
+        modalTitle.textContent = drink.name;
+        modalPrice.textContent = '$' + drink.basePrice.toFixed(2) + ' base';
+        modalBadge.textContent = drink.badge;
+        modalDescription.textContent = drink.description;
+        modalNotes.innerHTML = '<strong>Tasting notes:</strong> ' + drink.notes;
+
+        if (resetOptions) {
+          milkSelect.value = drink.defaultMilk;
+          const mediumRadio = orderForm.querySelector('input[name="size"][value="medium"]');
+          if (mediumRadio) mediumRadio.checked = true;
+          quantityInput.value = '1';
+          orderStatus.hidden = true;
+          orderStatus.textContent = '';
+        }
+
+        updateTotal();
+      }
+
+      function openOrderModal(mode, triggerEl) {
+        lastFocusedTrigger = triggerEl || document.activeElement;
+        const initialDrink = mode === 'order-now' ? 'maple-oat-latte' : mode;
+        renderDrinkDetails(initialDrink, true);
+
+        if (typeof modal.showModal === 'function') {
+          if (!modal.open) {
+            modal.showModal();
+          }
+        } else {
+          modal.setAttribute('open', '');
+        }
+
+        if (mode === 'order-now') {
+          drinkSelect.focus();
+        } else {
+          closeBtn.focus();
+        }
+      }
+
+      function closeOrderModal() {
+        if (modal.open) {
+          modal.close();
+        } else {
+          modal.removeAttribute('open');
+        }
+      }
+
+      triggerButtons.forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          openOrderModal(btn.getAttribute('data-open-modal'), btn);
+        });
+      });
+
+      drinkSelect.addEventListener('change', function () {
+        renderDrinkDetails(drinkSelect.value, false);
+        milkSelect.value = DRINKS[drinkSelect.value].defaultMilk;
+      });
+
+      orderForm.addEventListener('change', updateTotal);
+      quantityInput.addEventListener('input', updateTotal);
+
+      closeBtn.addEventListener('click', closeOrderModal);
+      cancelBtn.addEventListener('click', closeOrderModal);
+
+      // Light dismiss on backdrop click (fallback for browsers without closedby="any" support)
+      modal.addEventListener('click', function (event) {
+        if (event.target === modal) {
+          closeOrderModal();
+        }
+      });
+
+      // Restore focus to the button that opened the dialog whenever it closes
+      modal.addEventListener('close', function () {
+        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
+          lastFocusedTrigger.focus();
+        }
+      });
+
+      // Keep keyboard Tab focus cycled inside the open modal
+      modal.addEventListener('keydown', function (event) {
+        if (event.key !== 'Tab') return;
+        const focusable = Array.from(
+          modal.querySelectorAll('button:not([disabled]), select:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])')
+        );
+        if (focusable.length === 0) return;
+        const first = focusable[0];
+        const last = focusable[focusable.length - 1];
+        if (event.shiftKey && document.activeElement === first) {
+          event.preventDefault();
+          last.focus();
+        } else if (!event.shiftKey && document.activeElement === last) {
+          event.preventDefault();
+          first.focus();
+        }
+      });
+
+      orderForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        const drink = DRINKS[drinkSelect.value];
+        const sizeEl = orderForm.querySelector('input[name="size"]:checked');
+        const sizeLabel = sizeEl ? sizeEl.value : 'medium';
+        const qty = quantityInput.value;
+        orderStatus.textContent = 'Added ' + qty + 'x ' + sizeLabel + ' ' + drink.name + ' to your order!';
+        orderStatus.hidden = false;
+        setTimeout(function () {
+          closeOrderModal();
+        }, 900);
+      });
+    })();
+  </script>
+
 </body>
 
