+  <script>
+    (() => {
+      const draggable = document.getElementById('quick-order-panel');
+      const handle = document.getElementById('quick-order-handle');
+      const grip = document.getElementById('quick-order-grip');
+
+      if (!draggable || !handle) return;
+
+      // Progressive enhancement: attach drag affordances and keyboard accessibility on init
+      handle.classList.add('drag-handle');
+      handle.tabIndex = 0;
+      handle.setAttribute(
+        'aria-label',
+        'Quick Order Cart header — drag or use arrow keys to move panel'
+      );
+      if (grip) {
+        grip.hidden = false;
+      }
+
+      const KEYBOARD_STEP = 15;
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let isDragging = false;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+
+        draggable.style.right = 'auto';
+        draggable.style.bottom = 'auto';
+        draggable.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        draggable.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      }
+
+      function clampCurrentPosition() {
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (
+          event.button !== 0 ||
+          event.target.closest('button, input, select, textarea, a')
+        ) {
+          return;
+        }
+
+        const rect = draggable.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        isDragging = false;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+        if (!isDragging && Math.hypot(event.clientX - startX, event.clientY - startY) < 4) {
+          return;
+        }
+        isDragging = true;
+        handle.classList.add('dragging');
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        isDragging = false;
+        handle.classList.remove('dragging');
+      });
+
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle) return;
+
+        const rect = draggable.getBoundingClientRect();
+        let nextLeft = rect.left;
+        let nextTop = rect.top;
+
+        switch (event.key) {
+          case 'ArrowLeft':
+            nextLeft -= KEYBOARD_STEP;
+            break;
+          case 'ArrowRight':
+            nextLeft += KEYBOARD_STEP;
+            break;
+          case 'ArrowUp':
+            nextTop -= KEYBOARD_STEP;
+            break;
+          case 'ArrowDown':
+            nextTop += KEYBOARD_STEP;
+            break;
+          default:
+            return;
+        }
+
+        event.preventDefault();
+        moveTo(nextLeft, nextTop);
+      });
+
+      window.addEventListener('resize', clampCurrentPosition);
+      if (typeof ResizeObserver !== 'undefined') {
+        const resizeObserver = new ResizeObserver(() => {
+          clampCurrentPosition();
+        });
+        resizeObserver.observe(draggable);
+      }
+
+      // Interactive Cart Controls
+      const bodyForm = document.getElementById('quick-order-body');
+      const toggleBtn = document.getElementById('panel-toggle-btn');
+      const sizeSelect = document.getElementById('cart-size-select');
+      const subtotalEl = document.getElementById('cart-subtotal');
+      const taxEl = document.getElementById('cart-tax');
+      const totalEl = document.getElementById('cart-total');
+      const badgeEl = document.getElementById('cart-count-badge');
+      const clearBtn = document.getElementById('cart-clear-btn');
+      const statusEl = document.getElementById('cart-status');
+      const itemRows = Array.from(draggable.querySelectorAll('.cart-item'));
+
+      function updateCartSummary() {
+        const sizeUpcharge = sizeSelect && sizeSelect.value === 'large' ? 0.75 : 0;
+        let totalQty = 0;
+        let subtotal = 0;
+
+        for (const row of itemRows) {
+          const basePrice = parseFloat(row.dataset.price || '0');
+          const input = row.querySelector('.qty-input');
+          const qty = Math.max(0, parseInt(input.value || '0', 10) || 0);
+          input.value = String(qty);
+          totalQty += qty;
+          subtotal += qty * (basePrice + sizeUpcharge);
+        }
+
+        const tax = subtotal * 0.08;
+        const total = subtotal + tax;
+
+        if (badgeEl) {
+          badgeEl.textContent = `${totalQty} ${totalQty === 1 ? 'item' : 'items'}`;
+        }
+        if (subtotalEl) subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
+        if (taxEl) taxEl.textContent = `$${tax.toFixed(2)}`;
+        if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
+      }
+
+      draggable.addEventListener('click', (event) => {
+        const qtyBtn = event.target.closest('.qty-btn');
+        if (!qtyBtn) return;
+
+        const row = qtyBtn.closest('.cart-item');
+        const input = row && row.querySelector('.qty-input');
+        if (!input) return;
+
+        const current = parseInt(input.value || '0', 10) || 0;
+        const action = qtyBtn.dataset.qtyAction;
+        input.value = String(
+          action === 'increment' ? Math.min(20, current + 1) : Math.max(0, current - 1)
+        );
+        if (statusEl) statusEl.textContent = '';
+        updateCartSummary();
+      });
+
+      draggable.addEventListener('input', (event) => {
+        if (event.target.matches('.qty-input, #cart-size-select')) {
+          if (statusEl) statusEl.textContent = '';
+          updateCartSummary();
+        }
+      });
+
+      document.querySelectorAll('.quick-add-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const itemId = btn.getAttribute('data-add-item');
+          const row = draggable.querySelector(`.cart-item[data-item-id="${itemId}"]`);
+          const input = row && row.querySelector('.qty-input');
+          if (!input) return;
+          if (bodyForm && bodyForm.hidden) {
+            bodyForm.hidden = false;
+            if (toggleBtn) {
+              toggleBtn.setAttribute('aria-expanded', 'true');
+              toggleBtn.textContent = 'Minimize';
+            }
+          }
+          input.value = String(Math.min(20, (parseInt(input.value || '0', 10) || 0) + 1));
+          if (statusEl) statusEl.textContent = 'Added to Quick Order cart!';
+          updateCartSummary();
+        });
+      });
+
+      if (clearBtn) {
+        clearBtn.addEventListener('click', (event) => {
+          event.preventDefault();
+          for (const row of itemRows) {
+            const input = row.querySelector('.qty-input');
+            if (input) input.value = '0';
+          }
+          if (statusEl) statusEl.textContent = 'Cart cleared.';
+          updateCartSummary();
+        });
+      }
+
+      if (toggleBtn && bodyForm) {
+        toggleBtn.addEventListener('click', () => {
+          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
+          const nextExpanded = !isExpanded;
+          toggleBtn.setAttribute('aria-expanded', String(nextExpanded));
+          toggleBtn.textContent = nextExpanded ? 'Minimize' : 'Expand';
+          bodyForm.hidden = !nextExpanded;
+          clampCurrentPosition();
+        });
+      }
+
+      if (bodyForm) {
+        bodyForm.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const totalText = totalEl ? totalEl.textContent : '$0.00';
+          const badgeText = badgeEl ? badgeEl.textContent : '0 items';
+          if ( badgeText.startsWith('0 ') ) {
+            if (statusEl) statusEl.textContent = 'Please add at least one drink to order.';
+            return;
+          }
+          if (statusEl) {
+            statusEl.textContent = `Order queued (${badgeText}, ${totalText}) — ready in ~5 mins!`;
+          }
+        });
+      }
+
+      updateCartSummary();
+    })();
+  </script>
 </body>
 
