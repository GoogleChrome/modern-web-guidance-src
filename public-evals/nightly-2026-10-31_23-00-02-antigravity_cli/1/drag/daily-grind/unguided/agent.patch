+            id: 'item-2',
+            name: 'Cold Brew',
+            size: 'Large',
+            milk: 'None / Black',
+            temp: 'Iced',
+            extraShots: 1,
+            unitPrice: 6.50,
+            qty: 1,
+            img: DRINK_CATALOG['Cold Brew'].img
+          }
+        ]
+      };
+
+      // Elements
+      const panel = document.getElementById('floating-cart');
+      const dragHandle = document.getElementById('cart-drag-handle');
+      const toggleMinimizeBtn = document.getElementById('toggle-minimize-btn');
+      const resetPositionBtn = document.getElementById('reset-position-btn');
+      const drinkSelect = document.getElementById('drink-select');
+      const milkSelect = document.getElementById('milk-select');
+      const sizeButtons = document.querySelectorAll('#size-Selector .pill-option');
+      const tempButtons = document.querySelectorAll('#temp-selector .pill-option');
+      const fulfillmentButtons = document.querySelectorAll('#fulfillment-selector .pill-option');
+      const shotsMinusBtn = document.getElementById('shots-minus');
+      const shotsPlusBtn = document.getElementById('shots-plus');
+      const shotsCountEl = document.getElementById('shots-count');
+      const builderPricePreview = document.getElementById('builder-price-preview');
+      const addCustomDrinkBtn = document.getElementById('add-custom-drink-btn');
+      const cartItemsContainer = document.getElementById('cart-items-container');
+      const cartCountBadge = document.getElementById('cart-count-badge');
+      const cartSubtotalEl = document.getElementById('cart-subtotal');
+      const cartTaxEl = document.getElementById('cart-tax');
+      const cartTotalEl = document.getElementById('cart-total');
+      const clearCartBtn = document.getElementById('clear-cart-btn');
+      const checkoutBtn = document.getElementById('checkout-btn');
+      const orderStatusBanner = document.getElementById('order-status-banner');
+      const fulfillmentLabel = document.getElementById('Fulfillment-label');
+
+      function getCurrentBuilderUnitPrice() {
+        const drinkName = drinkSelect.value;
+        const base = DRINK_CATALOG[drinkName] ? DRINK_CATALOG[drinkName].price : 4.50;
+        return base + state.sizeUpcharge + state.extraShots * 1.00;
+      }
+
+      function updateBuilderPreview() {
+        const price = getCurrentBuilderUnitPrice();
+        builderPricePreview.textContent = '$' + price.toFixed(2);
+      }
+
+      function renderCart() {
+        cartItemsContainer.innerHTML = '';
+
+        const totalCount = state.items.reduce((sum, item) => sum + item.qty, 0);
+        cartCountBadge.textContent = String(totalCount);
+
+        if (state.items.length === 0) {
+          const emptyEl = document.createElement('div');
+          emptyEl.className = 'cart-empty-msg';
+          emptyEl.textContent = 'Your coffee cart is empty. Customize a drink above or quick-add a seasonal favorite!';
+          cartItemsContainer.appendChild(emptyEl);
+        } else {
+          state.items.forEach((item) => {
+            const row = document.createElement('div');
+            row.className = 'cart-item';
+
+            const shotsText = item.extraShots > 0 ? ` • +${item.extraShots} shot${item.extraShots > 1 ? 's' : ''}` : '';
+
+            row.innerHTML = `
+              <img class="cart-item-thumb" src="${item.img}" alt="${item.name}">
+              <div class="cart-item-info">
+                <div class="cart-item-title">${item.name}</div>
+                <div class="cart-item-meta">${item.size} • ${item.temp} • ${item.milk}${shotsText}</div>
+              </div>
+              <div class="cart-item-controls">
+                <button type="button" class="qty-btn" data-action="dec" data-id="${item.id}" aria-label="Decrease quantity">−</button>
+                <span class="item-qty">${item.qty}</span>
+                <button type="button" class="qty-btn" data-action="inc" data-id="${item.id}" aria-label="Increase quantity">+</button>
+              </div>
+              <div class="item-price">$${(item.unitPrice * item.qty).toFixed(2)}</div>
+              <button type="button" class="remove-item-btn" data-action="remove" data-id="${item.id}" title="Remove item" aria-label="Remove item">✕</button>
+            `;
+            cartItemsContainer.appendChild(row);
+          });
+        }
+
+        const subtotal = state.items.reduce((sum, item) => sum + item.unitPrice * item.qty, 0);
+        const tax = subtotal * 0.08;
+        const fees = subtotal > 0 ? state.deliveryFee : 0;
+        const total = subtotal + tax + fees;
+
+        cartSubtotalEl.textContent = '$' + subtotal.toFixed(2);
+        cartTaxEl.textContent = '$' + (tax + fees).toFixed(2);
+        cartTotalEl.textContent = '$' + total.toFixed(2);
+        checkoutBtn.disabled = state.items.length === 0;
+      }
+
+      function addDrinkToCart(drinkObj) {
+        const existing = state.items.find(
+          (i) =>
+            i.name === drinkObj.name &&
+            i.size === drinkObj.size &&
+            i.milk === drinkObj.milk &&
+            i.temp === drinkObj.temp &&
+            i.extraShots === drinkObj.extraShots
+        );
+
+        if (existing) {
+          existing.qty += 1;
+        } else {
+          state.items.push({
+            id: 'item-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
+            ...drinkObj,
+            qty: 1
+          });
+        }
+        orderStatusBanner.classList.remove('visible');
+        renderCart();
+      }
+
+      // Builder Controls Events
+      drinkSelect.addEventListener('change', () => {
+        const info = DRINK_CATALOG[drinkSelect.value];
+        if (info) {
+          milkSelect.value = info.defaultMilk;
+          state.temp = info.defaultTemp;
+          tempButtons.forEach((btn) => {
+            btn.classList.toggle('active', btn.dataset.temp === state.temp);
+          });
+        }
+        updateBuilderPreview();
+      });
+
+      sizeButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          sizeButtons.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+          state.size = btn.dataset.size;
+          state.sizeUpcharge = parseFloat(btn.dataset.upcharge || '0');
+          updateBuilderPreview();
+        });
+      });
+
+      tempButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          tempButtons.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+          state.temp = btn.dataset.temp;
+        });
+      });
+
+      shotsMinusBtn.addEventListener('click', () => {
+        if (state.extraShots > 0) {
+          state.extraShots -= 1;
+          shotsCountEl.textContent = String(state.extraShots);
+          updateBuilderPreview();
+        }
+      });
+
+      shotsPlusBtn.addEventListener('click', () => {
+        if (state.extraShots < 4) {
+          state.extraShots += 1;
+          shotsCountEl.textContent = String(state.extraShots);
+          updateBuilderPreview();
+        }
+      });
+
+      addCustomDrinkBtn.addEventListener('click', () => {
+        const name = drinkSelect.value;
+        const catalogItem = DRINK_CATALOG[name];
+        addDrinkToCart({
+          name,
+          size: state.size,
+          milk: milkSelect.value,
+          temp: state.temp,
+          extraShots: state.extraShots,
+          unitPrice: getCurrentBuilderUnitPrice(),
+          img: catalogItem ? catalogItem.img : ''
+        });
+      });
+
+      // Card Quick-Add Buttons
+      document.querySelectorAll('.quick-add-card-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const drinkName = btn.dataset.drink;
+          const info = DRINK_CATALOG[drinkName];
+          if (!info) return;
+          panel.classList.remove('minimized');
+          toggleMinimizeBtn.textContent = '−';
+          toggleMinimizeBtn.setAttribute('aria-expanded', 'true');
+          addDrinkToCart({
+            name: drinkName,
+            size: 'Medium',
+            milk: info.defaultMilk,
+            temp: info.defaultTemp,
+            extraShots: 0,
+            unitPrice: info.price + 0.50,
+            img: info.img
+          });
+        });
+      });
+
+      // Cart Item Quantity / Remove Delegation
+      cartItemsContainer.addEventListener('click', (e) => {
+        const target = e.target.closest('button[data-action]');
+        if (!target) return;
+        const { action, id } = target.dataset;
+        const idx = state.items.findIndex((i) => i.id === id);
+        if (idx === -1) return;
+
+        if (action === 'inc') {
+          state.items[idx].qty += 1;
+        } else if (action === 'dec') {
+          state.items[idx].qty -= 1;
+          if (state.items[idx].qty <= 0) {
+            state.items.splice(idx, 1);
+          }
+        } else if (action === 'remove') {
+          state.items.splice(idx, 1);
+        }
+        orderStatusBanner.classList.remove('visible');
+        renderCart();
+      });
+
+      // Fulfillment Mode Toggle
+      fulfillmentButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          fulfillmentButtons.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+          state.fulfillmentMode = btn.dataset.mode;
+          state.deliveryFee = parseFloat(btn.dataset.fee || '0');
+          fulfillmentLabel.textContent = state.deliveryFee > 0 ? 'Bike Delivery' : 'In-Store Pickup';
+          renderCart();
+        });
+      });
+
+      clearCartBtn.addEventListener('click', () => {
+        state.items = [];
+        orderStatusBanner.classList.remove('visible');
+        renderCart();
+      });
+
+      checkoutBtn.addEventListener('click', () => {
+        if (state.items.length === 0) return;
+        const orderNum = Math.floor(100 + Math.random() * 900);
+        const totalText = cartTotalEl.textContent;
+        orderStatusBanner.textContent = `✓ Order #${orderNum} confirmed (${totalText}) for ${state.fulfillmentMode}!`;
+        orderStatusBanner.classList.add('visible');
+      });
+
+      // Minimize / Expand Panel
+      toggleMinimizeBtn.addEventListener('click', () => {
+        const isMinimized = panel.classList.toggle('minimized');
+        toggleMinimizeBtn.textContent = isMinimized ? '+' : '−';
+        toggleMinimizeBtn.setAttribute('aria-expanded', String(!isMinimized));
+      });
+
+      // Reset Panel Position
+      resetPositionBtn.addEventListener('click', () => {
+        panel.style.left = '';
+        panel.style.top = '';
+        panel.style.right = '24px';
+        panel.style.bottom = '24px';
+      });
+
+      // Dragging via Header Handle (Pointer Events + Mouse/Touch Support)
+      let isDragging = false;
+      let dragOffsetX = 0;
+      let dragOffsetY = 0;
+
+      function clampPosition(left, top) {
+        const rect = panel.getBoundingClientRect();
+        const maxLeft = Math.max(8, window.innerWidth - rect.width - 8);
+        const maxTop = Math.max(8, window.innerHeight - rect.height - 8);
+        return {
+          left: Math.min(Math.max(8, left), maxLeft),
+          top: Math.min(Math.max(8, top), maxTop)
+        };
+      }
+
+      dragHandle.addEventListener('pointerdown', (e) => {
+        // Ignore clicks on header buttons
+        if (e.target.closest('button')) return;
+
+        isDragging = true;
+        const rect = panel.getBoundingClientRect();
+        dragOffsetX = e.clientX - rect.left;
+        dragOffsetY = e.clientY - rect.top;
+
+        panel.style.left = rect.left + 'px';
+        panel.style.top = rect.top + 'px';
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        panel.classList.add('dragging');
+
+        if (dragHandle.setPointerCapture) {
+          dragHandle.setPointerCapture(e.pointerId);
+        }
+        e.preventDefault();
+      });
+
+      window.addEventListener('pointermove', (e) => {
+        if (!isDragging) return;
+        const pos = clampPosition(e.clientX - dragOffsetX, e.clientY - dragOffsetY);
+        panel.style.left = pos.left + 'px';
+        panel.style.top = pos.top + 'px';
+      });
+
+      function endDrag(e) {
+        if (!isDragging) return;
+        isDragging = false;
+        panel.classList.remove('dragging');
+        if (e && e.pointerId !== undefined && dragHandle.releasePointerCapture) {
+          try {
+            dragHandle.releasePointerCapture(e.pointerId);
+          } catch (_) {}
+        }
+      }
+
+      window.addEventListener('pointerup', endDrag);
+      window.addEventListener('pointercancel', endDrag);
+
+      window.addEventListener('resize', () => {
+        if (panel.style.left && panel.style.left !== 'auto') {
+          const rect = panel.getBoundingClientRect();
+          const pos = clampPosition(rect.left, rect.top);
+          panel.style.left = pos.left + 'px';
+          panel.style.top = pos.top + 'px';
+        }
+      });
+
+      // Initial render
+      updateBuilderPreview();
+      renderCart();
+    })();
+  </script>
+
 </body>
 
 </html>
