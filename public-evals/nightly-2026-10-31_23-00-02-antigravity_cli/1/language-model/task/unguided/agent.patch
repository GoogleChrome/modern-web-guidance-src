+  <script>
+    const SYSTEM_PROMPT = `You are a friendly and knowledgeable barista at The Daily Grind Artisanal Coffee shop.
+You specialize in answering customer questions about our signature drinks:
+1. Maple Oat Latte: Made with creamy oat milk, rich espresso, and a hint of authentic Vermont maple syrup. Available hot or iced.
+2. Cold Brew: Steeped in small batches for 18 hours using ethically sourced single-origin beans for maximum smoothness and low acidity.
+Keep answers helpful, warm, and concise.`;
+
+    let activeSession = null;
+    let clonedSessions = [];
+    let currentAbortController = null;
+
+    const progressEl = document.getElementById('download-progress');
+    const contextUsageEl = document.getElementById('context-usage');
+    const baristaAnswerEl = document.getElementById('barista-answer');
+    const sentimentOutputEl = document.getElementById('sentiment-output');
+    const cloneStatusEl = document.getElementById('clone-status');
+
+    function updateContextUsage(session) {
+      if (!session) {
+        contextUsageEl.textContent = 'Context Usage: No active session';
+        return;
+      }
+      const usage = session.inputUsage ?? session.tokensSoFar ?? 0;
+      const quota = session.inputQuota ?? session.maxTokens ?? 0;
+      const left = session.tokensLeft ?? (quota - usage);
+      contextUsageEl.textContent = `Context Usage: ${usage} / ${quota} tokens (${left} remaining) | Cloned Sessions: ${clonedSessions.length}`;
+    }
+
+    function createDownloadMonitor(monitor) {
+      monitor.addEventListener('downloadprogress', (e) => {
+        const total = e.total || 1;
+        const loaded = e.loaded || 0;
+        const percent = total <= 1 ? Math.round(loaded * 100) : Math.round((loaded / total) * 100);
+        progressEl.textContent = `Downloading built-in AI model: ${percent}% (${loaded} / ${total})`;
+      });
+    }
+
+    async function checkModelAvailability(options = {}) {
+      if (typeof LanguageModel !== 'undefined' && typeof LanguageModel.availability === 'function') {
+        const availability = await LanguageModel.availability(options);
+        if (availability === 'unavailable') {
+          throw new Error('The built-in LanguageModel is unavailable on this device.');
+        }
+        return { api: LanguageModel, status: availability };
+      }
+      throw new Error('Built-in AI LanguageModel API is not supported in this browser.');
+    }
+
+    async function getOrCreateBaristaSession() {
+      if (activeSession) {
+        return activeSession;
+      }
+
+      const { api, status } = await checkModelAvailability({
+        expectedInputs: [{ type: 'text', languages: ['en'] }],
+        expectedOutputs: [{ type: 'text', languages: ['en'] }]
+      });
+
+      if (status === 'downloadable' || status === 'downloading') {
+        progressEl.textContent = 'Model is downloading...';
+      } else {
+        progressEl.textContent = 'Model is readily available.';
+      }
+
+      activeSession = await api.create({
+        initialPrompts: [
+          { role: 'system', content: SYSTEM_PROMPT }
+        ],
+        expectedInputs: [{ type: 'text', languages: ['en'] }],
+        expectedOutputs: [{ type: 'text', languages: ['en'] }],
+        monitor: createDownloadMonitor
+      });
+
+      activeSession.addEventListener('quotaoverflow', () => {
+        progressEl.textContent = 'Session context quota overflow detected. Pruning old sessions.';
+      });
+
+      updateContextUsage(activeSession);
+      return activeSession;
+    }
+
+    function cleanupUnneededSessions() {
+      let cleanedCount = 0;
+      while (clonedSessions.length > 0) {
+        const oldClone = clonedSessions.shift();
+        if (oldClone && typeof oldClone.destroy === 'function') {
+          oldClone.destroy();
+          cleanedCount++;
+        }
+      }
+      updateContextUsage(activeSession);
+      return cleanedCount;
+    }
+
+    // 1. Ask the Barista (Streaming + Availability Check)
+    document.getElementById('ask-the-barista').addEventListener('click', async () => {
+      const questionInput = document.getElementById('barista-question');
+      const promptText = questionInput.value.trim() || 'Tell me about the Maple Oat Latte and the Cold Brew.';
+
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      currentAbortController = new AbortController();
+
+      baristaAnswerEl.textContent = '';
+      try {
+        const session = await getOrCreateBaristaSession();
+
+        if (typeof session.measureInputUsage === 'function') {
+          const estimatedTokens = await session.measureInputUsage(promptText, {
+            signal: currentAbortController.signal
+          });
+          const remaining = (session.inputQuota ?? 0) - (session.inputUsage ?? 0);
+          if (session.inputQuota && estimatedTokens > remaining) {
+            session.destroy();
+            activeSession = null;
+            await getOrCreateBaristaSession();
+          }
+        }
+
+        const stream = session.promptStreaming(promptText, {
+          signal: currentAbortController.signal
+        });
+
+        for await (const chunk of stream) {
+          baristaAnswerEl.textContent += chunk;
+        }
+
+        updateContextUsage(session);
+      } catch (err) {
+        if (err.name === 'AbortError') {
+          baristaAnswerEl.textContent = 'Request aborted.';
+        } else {
+          baristaAnswerEl.textContent = `Error: ${err.message}`;
+        }
+      } finally {
+        currentAbortController = null;
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON Output with responseConstraint)
+    document.getElementById('sentiment-btn').addEventListener('click', async () => {
+      const feedbackInput = document.getElementById('feedback-input');
+      const reviewText = feedbackInput.value.trim() || 'The Maple Oat Latte was delicious and the Cold Brew is super smooth!';
+
+      sentimentOutputEl.textContent = 'Analyzing feedback...';
+      let analyzerSession = null;
+
+      const feedbackSchema = {
+        type: 'object',
+        properties: {
+          score: {
+            type: 'number',
+            description: 'Sentiment score from 1 (very negative) to 5 (very positive)'
+          },
+          category: {
+            type: 'string',
+            enum: ['Maple Oat Latte', 'Cold Brew', 'Customer Service', 'General']
+          }
+        },
+        required: ['score', 'category'],
+        additionalProperties: false
+      };
+
+      try {
+        const { api } = await checkModelAvailability({
+          expectedInputs: [{ type: 'text', languages: ['en'] }],
+          expectedOutputs: [{ type: 'text', languages: ['en'] }]
+        });
+
+        analyzerSession = await api.create({
+          initialPrompts: [
+            {
+              role: 'system',
+              content: 'Analyze the customer coffee shop feedback and return a JSON object containing a numeric sentiment score and category.'
+            }
+          ],
+          monitor: createDownloadMonitor
+        });
+
+        const rawResult = await analyzerSession.prompt(
+          `Analyze the following customer feedback: "${reviewText}"`,
+          { responseConstraint: feedbackSchema }
+        );
+
+        const parsed = JSON.parse(rawResult);
+        sentimentOutputEl.textContent = JSON.stringify(parsed, null, 2);
+      } catch (err) {
+        sentimentOutputEl.textContent = `Error: ${err.message}`;
+      } finally {
+        if (analyzerSession && typeof analyzerSession.destroy === 'function') {
+          analyzerSession.destroy();
+        }
+      }
+    });
+
+    // 3. Conversation Branching & Session Cloning (Clone + Context Tracking + Resource Cleanup)
+    document.getElementById('clone-btn').addEventListener('click', async () => {
+      const controller = new AbortController();
+      try {
+        const baseSession = await getOrCreateBaristaSession();
+
+        // Clean up older cloned sessions before creating a new branch to conserve resources
+        if (clonedSessions.length >= 1) {
+          cleanupUnneededSessions();
+        }
+
+        const clonedSession = await baseSession.clone({
+          signal: controller.signal
+        });
+
+        clonedSessions.push(clonedSession);
+        updateContextUsage(clonedSession);
+
+        const usage = clonedSession.inputUsage ?? 0;
+        const quota = clonedSession.inputQuota ?? 0;
+        cloneStatusEl.textContent = `Cloned active session successfully! Branch context usage: ${usage} / ${quota} tokens.`;
+      } catch (err) {
+        cloneStatusEl.textContent = `Clone error: ${err.message}`;
+      }
+    });
+
+    document.getElementById('cleanup-btn').addEventListener('click', () => {
+      const cleaned = cleanupUnneededSessions();
+      cloneStatusEl.textContent = `Cleaned up ${cleaned} unneeded cloned session(s).`;
+    });
+
+    window.addEventListener('pagehide', () => {
+      cleanupUnneededSessions();
+      if (activeSession && typeof activeSession.destroy === 'function') {
+        activeSession.destroy();
+        activeSession = null;
+      }
+    });
+  </script>
 </body>
 
