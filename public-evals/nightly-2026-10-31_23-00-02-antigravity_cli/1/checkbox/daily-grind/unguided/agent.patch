+    /* Customization Checkboxes */
+    .customizations {
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      padding: 12px 14px 10px;
+      margin: 16px 0 4px;
+      text-align: left;
+      background-color: var(--light);
+    }
+
+    .customizations legend {
+      font-size: 0.78rem;
+      font-weight: 700;
