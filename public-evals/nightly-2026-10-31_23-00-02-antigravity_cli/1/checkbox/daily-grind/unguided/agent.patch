+      border-radius: 12px;
+      transition: background-color 0.25s ease, color 0.25s ease, transform 0.2s ease;
+    }
+
+    /* Checked states & animations */
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-left .checkbox-box {
+      background-color: var(--primary);
+      border-color: var(--primary);
+      transform: scale(1.08);
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-left .checkbox-box .bean-icon {
+      opacity: 0;
+      transform: scale(0.3) rotate(-45deg);
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-left .checkbox-box .check-icon {
+      stroke-dashoffset: 0;
+      opacity: 1;
+      transform: scale(1);
