+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-left .checkbox-label-text {
+      color: var(--primary);
+      font-weight: 600;
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-badge {
+      background-color: var(--accent);
+      color: var(--text);
+      transform: scale(1.05);
+    }
+
+    .custom-checkbox:has(input[type="checkbox"]:checked) {
+      border-color: var(--accent);
