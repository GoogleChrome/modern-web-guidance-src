+      box-shadow: 0 0 0 4px rgba(255, 171, 64, 0.25);
+    }
+
+    .custom-checkbox:has(input[type="checkbox"]:focus-visible) {
+      border-color: var(--primary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .custom-checkbox,
+      .checkbox-box,
+      .checkbox-box .bean-icon,
+      .checkbox-box .check-icon,
+      .option-icon,
+      .checkbox-label-text,
+      .checkbox-badge {
+        transition: none !important;
+      }
+    }
