+                  box-shadow 0.2s ease;
+    }
+
+    /* Unchecked coffee bean motif inside checkbox */
+    .checkbox-box .bean-icon {
+      width: 12px;
+      height: 12px;
+      fill: var(--secondary);
+      opacity: 0.7;
+      transform: scale(1) rotate(0deg);
+      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+                  opacity 0.2s ease;
+    }
+
+    /* Checkmark icon inside checkbox */
+    .checkbox-box .check-icon {
+      position: absolute;
+      width: 14px;
+      height: 14px;
+      fill: none;
+      stroke: var(--accent);
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 22;
+      stroke-dashoffset: 22;
+      opacity: 0;
+      transform: scale(0.6);
+      transition: stroke-dashoffset 0.28s cubic-bezier(0.4, 0, 0.2, 1) 0.05s,
+                  opacity 0.2s ease,
+                  transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .option-icon {
+      width: 16px;
+      height: 16px;
