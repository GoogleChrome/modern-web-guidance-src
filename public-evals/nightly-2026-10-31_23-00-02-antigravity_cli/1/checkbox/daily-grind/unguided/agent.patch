+      box-shadow: 0 2px 6px rgba(78, 52, 46, 0.08);
+    }
+
+    /* Keyboard focus accessibility styles */
+    .custom-checkbox input[type="checkbox"]:focus-visible ~ .checkbox-left .checkbox-box {
+      outline: 2px solid var(--accent);
