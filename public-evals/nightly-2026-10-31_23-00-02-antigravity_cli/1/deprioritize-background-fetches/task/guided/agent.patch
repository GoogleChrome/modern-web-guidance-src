diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,28 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Data Loader</title>
+</head>
+<body>
+  <main>
+    <h1>Data Loader</h1>
+    <button type="button" id="fetch-btn">Load Data</button>
+  </main>
+  <script type="module">
+    document.getElementById('fetch-btn').addEventListener('click', () => {
+      // High priority (default) for mission-critical data
+      fetch('/api/data');
+
+      // Deprioritize background analytics to prevent network contention
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low'
+      });
+    });
+  </script>
+</body>
+</html>
