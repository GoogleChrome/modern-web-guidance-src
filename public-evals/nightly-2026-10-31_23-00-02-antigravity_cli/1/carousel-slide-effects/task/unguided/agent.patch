+    }
+
+    /* Horizontal Product Carousel */
+    .carousel-section {
+      margin-top: 60px;
+    }
+
+    .carousel-header {
+      text-align: center;
+      margin-bottom: 10px;
+    }
+
+    .carousel-subtitle {
+      text-align: center;
+      color: #5d4037;
+      font-size: 0.95rem;
+      margin-bottom: 15px;
+    }
+
+    .scroller {
+      display: flex;
+      gap: 28px;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scroll-behavior: smooth;
+      padding: 45px calc(50% - 140px);
+      margin: 0 auto;
+      list-style: none;
+      scrollbar-width: thin;
+      scrollbar-color: var(--primary) var(--secondary);
+      -webkit-overflow-scrolling: touch;
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+      border-radius: 8px;
+    }
+
+    .scroller::-webkit-scrollbar {
+      height: 10px;
+    }
+
+    .scroller::-webkit-scrollbar-track {
+      background: var(--secondary);
+      border-radius: 5px;
+    }
+
+    .scroller::-webkit-scrollbar-thumb {
+      background: var(--primary);
+      border-radius: 5px;
+    }
+
+    @keyframes scale-on-scroll {
+      0% {
+        transform: scale(0.78);
+        opacity: 0.65;
+      }
+      50% {
+        transform: scale(1.1);
+        opacity: 1;
+      }
+      100% {
+        transform: scale(0.78);
+        opacity: 0.65;
+      }
+    }
+
+    .scroller .card {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      overflow: hidden;
+      padding: 0 0 20px 0;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
+      transition: box-shadow 0.3s ease;
+      view-timeline-name: --card-timeline;
+      view-timeline-axis: inline;
+      animation: scale-on-scroll linear both;
+      animation-timeline: view(inline);
+      animation-range: cover 0% cover 100%;
+    }
+
+    .scroller .card:focus-within {
+      box-shadow: 0 8px 24px rgba(78, 52, 46, 0.3);
+      outline: 2px solid var(--accent);
+    }
+
+    .scroller .card img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      display: block;
+      margin-bottom: 15px;
+    }
+
+    .scroller .card-body {
+      padding: 0 20px;
+      display: flex;
+      flex-direction: column;
+      flex-grow: 1;
+      justify-content: space-between;
+    }
+
+    .scroller .price {
+      font-weight: bold;
+      font-size: 1.15rem;
+      color: var(--primary);
+      margin-top: 10px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+
+      .scroller .card {
+        animation: none;
+        transform: none;
+        opacity: 1;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
