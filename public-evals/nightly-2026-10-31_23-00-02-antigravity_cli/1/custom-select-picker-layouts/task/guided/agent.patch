+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      if (!CSS.supports("appearance", "base-select")) {
+        return;
+      }
+
+      const select = document.getElementById("roast-select");
+      if (!select) return;
+
+      select.addEventListener("keydown", (e) => {
+        if (!select.matches(":open")) return;
+        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
+
+        const options = Array.from(select.querySelectorAll("option"));
+        const active = document.activeElement?.closest("option") || select.selectedOptions[0];
+        if (!active) return;
+
+        const activeRect = active.getBoundingClientRect();
+        const dir = e.key === "ArrowRight" ? 1 : -1;
+
+        const candidates = options
+          .filter((opt) => opt !== active)
+          .map((opt) => ({ opt, rect: opt.getBoundingClientRect() }))
+          .filter(({ rect }) => (dir > 0 ? rect.left > activeRect.left : rect.left < activeRect.left))
+          .sort((a, b) => Math.abs(a.rect.left - activeRect.left) - Math.abs(b.rect.left - activeRect.left));
+
+        if (candidates.length > 0) {
+          e.preventDefault();
+          candidates[0].opt.focus();
+        }
+      });
+    });
+  </script>
