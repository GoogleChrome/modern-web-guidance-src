     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers that don't support scroll-driven animations
+    if (
+      !CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)') &&
+      !window.matchMedia('(prefers-reduced-motion: reduce)').matches
+    ) {
+      const nav = document.querySelector('nav');
+
+      const initialHeight = 100;
+      const finalHeight = 50;
+      const scrollDistance = 50;
+
+      window.addEventListener('scroll', () => {
+        const scrollY = window.scrollY;
+        const scrollPercent = Math.min(1, scrollY / scrollDistance);
+        const newHeight = initialHeight - (initialHeight - finalHeight) * scrollPercent;
+
+        nav.style.height = `${newHeight}px`;
+        nav.style.boxShadow = scrollPercent > 0 ? `0 2px 10px rgba(0, 0, 0, ${0.3 * scrollPercent})` : 'none';
+      }, { passive: true });
+    }
+  </script>
+
 </body>
 
