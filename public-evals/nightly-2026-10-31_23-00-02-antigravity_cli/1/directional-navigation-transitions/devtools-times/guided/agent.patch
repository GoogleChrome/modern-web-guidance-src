         </div>
     </div>
 
+    <script>
+        function initTopStoriesSlider() {
+            const slider = document.querySelector('[data-top-stories-slider]');
+            if (!slider || slider.hasAttribute('data-initialized')) return;
+            slider.setAttribute('data-initialized', 'true');
+
+            const scopeEl = slider.querySelector('[data-slider-scope]') as HTMLElement | null;
+            const slides = Array.from(slider.querySelectorAll('[data-story-slide]')) as HTMLElement[];
+            const prevBtn = slider.querySelector('[data-slider-prev]') as HTMLButtonElement | null;
+            const nextBtn = slider.querySelector('[data-slider-next]') as HTMLButtonElement | null;
+
+            if (!scopeEl || slides.length === 0 || !prevBtn || !nextBtn) return;
+
+            let currentIndex = 0;
+
+            function showSlide(nextIndex: number, direction: 'forward' | 'backward') {
+                const updateDOM = () => {
+                    slides.forEach((slide, idx) => {
+                        const isActive = idx === nextIndex;
+                        slide.hidden = !isActive;
+                        slide.classList.toggle('hidden', !isActive);
+                        slide.classList.toggle('block', isActive);
+                    });
+                    currentIndex = nextIndex;
+                };
+
+                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+                if (prefersReducedMotion) {
+                    updateDOM();
+                    return;
+                }
+
+                const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+                if (supportsScopedTransition) {
+                    const transition = (scopeEl as any).startViewTransition({
+                        update: updateDOM,
+                        types: [direction],
+                    });
+                    transition.ready?.catch(() => {});
+                    return;
+                }
+
+                if (!document.startViewTransition) {
+                    updateDOM();
+                    return;
+                }
+
+                const transition = document.startViewTransition({
+                    update: updateDOM,
+                    types: [direction],
+                });
+                transition.ready?.catch(() => {});
+            }
+
+            prevBtn.addEventListener('click', () => {
+                const nextIndex = (currentIndex - 1 + slides.length) % slides.length;
+                showSlide(nextIndex, 'backward');
+            });
+
+            nextBtn.addEventListener('click', () => {
+                const nextIndex = (currentIndex + 1) % slides.length;
+                showSlide(nextIndex, 'forward');
+            });
+        }
+
+        initTopStoriesSlider();
+        document.addEventListener('astro:page-load', initTopStoriesSlider);
+    </script>
+
