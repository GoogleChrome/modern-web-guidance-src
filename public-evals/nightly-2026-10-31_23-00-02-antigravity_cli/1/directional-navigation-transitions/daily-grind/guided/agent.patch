+  <script>
+    const viewport = document.getElementById('favorites-viewport');
+    const cards = Array.from(viewport.querySelectorAll('.card'));
+    const prevBtn = document.getElementById('prev-favorite');
+    const nextBtn = document.getElementById('next-favorite');
+    const statusEl = document.getElementById('favorites-status');
+
+    let currentIndex = 0;
+
+    function renderActiveCard(index) {
+      cards.forEach((card, i) => {
+        card.hidden = i !== index;
+      });
+      statusEl.textContent = `${index + 1} / ${cards.length}`;
+    }
+
+    /**
+     * Navigates to a new favorite card with a directional view transition.
+     * @param {Function} updateDOM - Callback to update the DOM state.
+     * @param {string} direction - Either 'forward' or 'backward'.
+     */
+    function navigateFavorite(updateDOM, direction) {
+      if ('startViewTransition' in Element.prototype) {
+        const transition = viewport.startViewTransition({
+          update: updateDOM,
+          types: [direction]
+        });
+        transition.ready.catch(() => {});
+        return;
+      }
+
+      if (document.startViewTransition) {
+        const transition = document.startViewTransition({
+          update: updateDOM,
+          types: [direction]
+        });
+        transition.ready.catch(() => {});
+        return;
+      }
+
+      updateDOM();
+    }
+
+    nextBtn.addEventListener('click', () => {
+      const nextIndex = (currentIndex + 1) % cards.length;
+      navigateFavorite(() => {
+        currentIndex = nextIndex;
+        renderActiveCard(currentIndex);
+      }, 'forward');
+    });
+
+    prevBtn.addEventListener('click', () => {
+      const prevIndex = (currentIndex - 1 + cards.length) % cards.length;
+      navigateFavorite(() => {
+        currentIndex = prevIndex;
+        renderActiveCard(currentIndex);
+      }, 'backward');
+    });
+  </script>
+
