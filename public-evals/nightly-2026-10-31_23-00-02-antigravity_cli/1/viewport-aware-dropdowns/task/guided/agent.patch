+    /* Options Trigger & Anchor-Positioned Popover Panel */
+    nav ul {
+      align-items: center;
+    }
+
+    .trigger-btn {
+      anchor-name: --options-anchor;
+      background: transparent;
+      color: white;
+      border: 1px solid rgba(255, 255, 255, 0.4);
+      padding: 5px 12px;
+      border-radius: 4px;
+      font-family: inherit;
+      font-size: 0.9rem;
+      cursor: pointer;
+      transition: color 0.3s, border-color 0.3s;
+    }
+
+    .trigger-btn:hover,
+    .trigger-btn:focus-visible {
+      color: var(--accent);
+      border-color: var(--accent);
+    }
+
+    .panel {
+      position-anchor: --options-anchor;
+      position-area: block-end span-inline-end;
+      position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline;
+      inset: auto;
+      margin: 0;
+      padding: 8px;
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
+      min-inline-size: 180px;
+    }
+
+    [popover]:is(:popover-open, .\:popover-open) {
+      display: flex;
+      flex-direction: column;
+      gap: 4px;
+    }
+
+    @supports not (position-area: block-end span-inline-end) {
+      .panel {
+        bottom: auto;
+        right: auto;
+        top: anchor(bottom);
+        left: anchor(left);
+      }
+    }
+
+    .action-item {
+      display: block;
+      inline-size: 100%;
+      padding: 8px 12px;
+      background: transparent;
+      color: var(--text);
+      border: none;
+      border-radius: 4px;
+      font-family: inherit;
+      font-size: 0.9rem;
+      text-align: start;
+      cursor: pointer;
+      transition: background-color 0.2s, color 0.2s;
+    }
+
+    .action-item:hover,
+    .action-item:focus-visible {
+      background-color: var(--secondary);
+      color: var(--primary);
+    }
+
