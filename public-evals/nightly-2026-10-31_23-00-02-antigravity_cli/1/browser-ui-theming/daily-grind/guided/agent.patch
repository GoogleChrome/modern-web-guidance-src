+  <script>
+    const slider = document.querySelector('#espresso-shots');
+    const shotsOutput = document.querySelector('#shots-output');
+
+    if (slider) {
+      function syncSliderValue() {
+        slider.style.setProperty('--attr-min', slider.min || 1);
+        slider.style.setProperty('--attr-max', slider.max || 4);
+        slider.style.setProperty('--control-value', slider.value);
+        const label = `${slider.value} ${Number(slider.value) === 1 ? 'shot' : 'shots'}`;
+        slider.setAttribute('aria-valuetext', label);
+        if (shotsOutput) {
+          shotsOutput.textContent = label;
+        }
+      }
+
+      syncSliderValue();
+      slider.addEventListener('input', syncSliderValue);
+    }
+
+    if (!CSS.supports('selector(:has(*))')) {
+      document.querySelectorAll('.choice-label input').forEach((input) => {
+        const updateChoiceState = () => {
+          if (input.type === 'radio' && input.name) {
+            document.querySelectorAll(`input[type="radio"][name="${input.name}"]`).forEach((radio) => {
+              const label = radio.closest('.choice-label');
+              if (label) label.classList.toggle('is-checked', radio.checked);
+            });
+          } else {
+            const label = input.closest('.choice-label');
+            if (label) label.classList.toggle('is-checked', input.checked);
+          }
+        };
+        updateChoiceState();
+        input.addEventListener('change', updateChoiceState);
+      });
+    }
+
+    const orderForm = document.querySelector('#coffee-order-form');
+    const orderStatus = document.querySelector('#order-status');
+    if (orderForm && orderStatus) {
+      orderForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const data = new FormData(orderForm);
+        const name = data.get('customer_name');
+        const drinkSelect = orderForm.querySelector('#drink-base');
+        const drinkName = drinkSelect && drinkSelect.selectedOptions[0]
+          ? drinkSelect.selectedOptions[0].textContent
+          : data.get('drink_base');
+        const size = data.get('cup_size');
+        const shots = data.get('espresso_shots');
+        const pickup = data.get('pickup_time');
+        orderStatus.textContent = `Order received for ${name}: ${size} ${drinkName} (${shots} ${Number(shots) === 1 ? 'shot' : 'shots'}) ready at ${pickup}.`;
+      });
+    }
+  </script>
