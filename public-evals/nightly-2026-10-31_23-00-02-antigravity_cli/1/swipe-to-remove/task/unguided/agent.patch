+  <script>
+    (function () {
+      const SWIPE_THRESHOLD = 80;
+      const ACTION_COLOR = '#e53935';
+      const DEFAULT_TRACK_COLOR = '#d7ccc8';
+
+      function getClientX(event) {
+        if (event.touches && event.touches.length > 0) {
+          return event.touches[0].clientX;
+        }
+        if (event.changedTouches && event.changedTouches.length > 0) {
+          return event.changedTouches[0].clientX;
+        }
+        return typeof event.clientX === 'number' ? event.clientX : 0;
+      }
+
+      function initSwipeableItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        let isDragging = false;
+        let isRemoving = false;
+        let startX = 0;
+        let currentDeltaX = 0;
+
+        function onStart(event) {
+          if (isRemoving || isDragging) return;
+          isDragging = true;
+          startX = getClientX(event);
+          currentDeltaX = 0;
+          item.classList.add('is-dragging');
+          track.style.transition = 'none';
+        }
+
+        function onMove(event) {
+          if (!isDragging || isRemoving) return;
+          const clientX = getClientX(event);
+          currentDeltaX = clientX - startX;
+
+          track.style.transform = `translateX(${currentDeltaX}px)`;
+
+          const threshold = Math.min(SWIPE_THRESHOLD, (item.offsetWidth || 320) * 0.25);
+          if (Math.abs(currentDeltaX) >= threshold) {
+            item.classList.add('is-past-threshold');
+            item.style.backgroundColor = ACTION_COLOR;
+          } else {
+            item.classList.remove('is-past-threshold');
+            item.style.backgroundColor = DEFAULT_TRACK_COLOR;
+          }
+        }
+
+        function onEnd() {
+          if (!isDragging || isRemoving) return;
+          isDragging = false;
+          item.classList.remove('is-dragging');
+          track.style.transition = 'transform 0.25s ease';
+
+          const threshold = Math.min(SWIPE_THRESHOLD, (item.offsetWidth || 320) * 0.25);
+          if (Math.abs(currentDeltaX) >= threshold) {
+            isRemoving = true;
+            const direction = currentDeltaX >= 0 ? 1 : -1;
+            const slideDistance = (item.offsetWidth || 400) * direction;
+
+            item.classList.add('is-past-threshold');
+            item.style.backgroundColor = ACTION_COLOR;
+            track.style.transform = `translateX(${slideDistance}px)`;
+
+            const currentHeight = item.offsetHeight;
+            item.style.height = `${currentHeight}px`;
+            item.style.maxHeight = `${currentHeight}px`;
+            // Force reflow before collapsing height
+            void item.offsetHeight;
+
+            item.classList.add('is-removing');
+            item.style.height = '0px';
+            item.style.maxHeight = '0px';
+            item.style.marginBottom = '0px';
+            item.style.marginTop = '0px';
+            item.style.paddingTop = '0px';
+            item.style.paddingBottom = '0px';
+            item.style.opacity = '0';
+
+            let removed = false;
+            const finalizeRemoval = () => {
+              if (removed) return;
+              removed = true;
+              if (item.parentNode) {
+                item.parentNode.removeChild(item);
+              }
+            };
+
+            item.addEventListener('transitionend', (e) => {
+              if (e.target === item && (e.propertyName === 'height' || e.propertyName === 'max-height')) {
+                finalizeRemoval();
+              }
+            });
+            setTimeout(finalizeRemoval, 340);
+          } else {
+            track.style.transform = 'translateX(0px)';
+            item.classList.remove('is-past-threshold');
+            item.style.backgroundColor = DEFAULT_TRACK_COLOR;
+          }
+        }
+
+        [item, track, content].forEach((el) => {
+          el.addEventListener('pointerdown', onStart);
+          el.addEventListener('mousedown', onStart);
+          el.addEventListener('touchstart', onStart, { passive: true });
+          el.addEventListener('pointermove', onMove);
+          el.addEventListener('mousemove', onMove);
+          el.addEventListener('touchmove', onMove, { passive: true });
+          el.addEventListener('pointerup', onEnd);
+          el.addEventListener('mouseup', onEnd);
+          el.addEventListener('touchend', onEnd);
+        });
+
+        window.addEventListener('pointermove', onMove);
+        window.addEventListener('mousemove', onMove);
+        window.addEventListener('touchmove', onMove, { passive: true });
+
+        window.addEventListener('pointerup', onEnd);
+        window.addEventListener('pointercancel', onEnd);
+        window.addEventListener('mouseup', onEnd);
+        window.addEventListener('touchend', onEnd);
+        window.addEventListener('touchcancel', onEnd);
+      }
+
+      document.querySelectorAll('.SwipeableList-item').forEach(initSwipeableItem);
+    })();
+  </script>
+
 </body>
 
