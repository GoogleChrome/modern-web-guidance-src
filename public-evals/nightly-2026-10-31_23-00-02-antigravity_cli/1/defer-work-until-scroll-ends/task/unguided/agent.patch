+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const statusEl = document.getElementById('status');
+      const originCards = Array.from(scroller.querySelectorAll('.origin-card'));
+
+      let isScrolling = false;
+      let fallbackTimer = null;
+
+      function getMostVisibleOrigin() {
+        const scrollerRect = scroller.getBoundingClientRect();
+        const scrollerCenter = (scrollerRect.top + scrollerRect.bottom) / 2;
+
+        let bestOrigin = '';
+        let maxVisibleHeight = -1;
+        let bestCenterDistance = Infinity;
+
+        for (let i = 0; i < originCards.length; i++) {
+          const card = originCards[i];
+          const rect = card.getBoundingClientRect();
+          const visibleTop = Math.max(scrollerRect.top, rect.top);
+          const visibleBottom = Math.min(scrollerRect.bottom, rect.bottom);
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+          const cardCenter = (rect.top + rect.bottom) / 2;
+          const centerDistance = Math.abs(cardCenter - scrollerCenter);
+
+          if (
+            visibleHeight > maxVisibleHeight ||
+            (visibleHeight === maxVisibleHeight && centerDistance < bestCenterDistance)
+          ) {
+            maxVisibleHeight = visibleHeight;
+            bestCenterDistance = centerDistance;
+            bestOrigin =
+              card.getAttribute('data-origin') ||
+              (card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : '');
+          }
+        }
+
+        return bestOrigin;
+      }
+
+      function handleScrollEnd() {
+        if (fallbackTimer !== null) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = null;
+        }
+        isScrolling = false;
+        statusEl.classList.remove('is-scrolling');
+        const visibleOrigin = getMostVisibleOrigin();
+        statusEl.textContent = 'Scroll ended. Visible: ' + visibleOrigin;
+      }
+
+      scroller.addEventListener(
+        'scroll',
+        function () {
+          if (!isScrolling) {
+            isScrolling = true;
+            statusEl.classList.add('is-scrolling');
+            statusEl.textContent = 'Scrolling...';
+          }
+          if (fallbackTimer !== null) {
+            clearTimeout(fallbackTimer);
+          }
+          fallbackTimer = setTimeout(handleScrollEnd, 150);
+        },
+        { passive: true }
+      );
+
+      scroller.addEventListener(
+        'scrollend',
+        function () {
+          handleScrollEnd();
+        },
+        { passive: true }
+      );
+    })();
+  </script>
