+  <script>
+    const scroller = document.querySelector('#scroller');
+    const statusEl = document.querySelector('#status');
+    const originCards = Array.from(scroller.querySelectorAll('.origin-card'));
+
+    function findMostVisibleOrigin(container, items) {
+      const containerRect = container.getBoundingClientRect();
+      let mostVisibleItem = items[0] || null;
+      let maxVisibleHeight = -1;
+
+      for (const item of items) {
+        const rect = item.getBoundingClientRect();
+        const visibleTop = Math.max(rect.top, containerRect.top);
+        const visibleBottom = Math.min(rect.bottom, containerRect.bottom);
+        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+        if (visibleHeight > maxVisibleHeight) {
+          maxVisibleHeight = visibleHeight;
+          mostVisibleItem = item;
+        }
+      }
+
+      return mostVisibleItem;
+    }
+
+    function initializeScroller() {
+      // Lightweight feedback during active scroll without layout reads
+      scroller.addEventListener('scroll', () => {
+        if (statusEl.textContent !== 'Scrolling...') {
+          statusEl.textContent = 'Scrolling...';
+          statusEl.classList.add('is-scrolling');
+        }
+      }, { passive: true });
+
+      // Defer layout recalculation until scrolling has completely ended
+      scroller.addEventListener('scrollend', () => {
+        const mostVisible = findMostVisibleOrigin(scroller, originCards);
+        if (mostVisible) {
+          const originName = mostVisible.dataset.origin || mostVisible.querySelector('h3')?.textContent.trim() || '';
+          statusEl.textContent = `Scroll ended. Visible: ${originName}`;
+          statusEl.classList.remove('is-scrolling');
+        }
+      });
+    }
+
+    if ('onscrollend' in window) {
+      initializeScroller();
+    } else {
+      initializeScroller();
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(window.scrollendtimer);
+        window.scrollendtimer = setTimeout(() => {
+          scroller.dispatchEvent(new CustomEvent('scrollend'));
+        }, 100);
+      }, { passive: true });
+    }
+  </script>
