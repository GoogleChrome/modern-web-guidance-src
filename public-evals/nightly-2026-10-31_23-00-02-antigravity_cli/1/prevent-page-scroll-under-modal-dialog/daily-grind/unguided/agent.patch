   <script>
     const noticeDialog = document.getElementById("notice-dialog");
+    const closeNoticeBtn = document.getElementById("close-notice");
+
+    function syncScrollLock() {
+      const isOpen = Boolean(document.querySelector("dialog[open], dialog:modal"));
+      document.documentElement.classList.toggle("modal-open", isOpen);
+      document.body.classList.toggle("modal-open", isOpen);
+      document.documentElement.style.overflow = isOpen ? "hidden" : "";
+      document.body.style.overflow = isOpen ? "hidden" : "";
+    }
+
     if (noticeDialog) {
-      noticeDialog.show();
-      document.body.classList.add("modal-open");
-      document.body.style.overflow = "hidden";
+      noticeDialog.showModal();
+      syncScrollLock();
+
+      noticeDialog.addEventListener("close", syncScrollLock);
+      noticeDialog.addEventListener("cancel", syncScrollLock);
+
+      const observer = new MutationObserver(syncScrollLock);
+      observer.observe(noticeDialog, {
+        attributes: true,
+        attributeFilter: ["open"],
+      });
+    }
+
+    if (closeNoticeBtn && noticeDialog) {
+      closeNoticeBtn.addEventListener("click", () => {
+        noticeDialog.close();
+        syncScrollLock();
+      });
     }
   </script>
