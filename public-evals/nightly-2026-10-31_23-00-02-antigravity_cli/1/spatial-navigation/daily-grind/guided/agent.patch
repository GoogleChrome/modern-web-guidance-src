+  <script>
+    (() => {
+      const FOCUSABLE_SELECTOR =
+        'a[href], button:not(:disabled), input:not(:disabled), select:not(:disabled), textarea:not(:disabled), [tabindex]:not([tabindex="-1"]), [data-spatial-candidate]';
+
+      const DIRECTION_MAP = {
+        ArrowUp: 'up',
+        ArrowDown: 'down',
+        ArrowLeft: 'left',
+        ArrowRight: 'right',
+      };
+
+      const TOLERANCE = 2;
+      const FALLBACK_WEIGHT = 2.5;
+
+      function isVisible(el) {
+        if (typeof el.checkVisibility === 'function') {
+          return el.checkVisibility();
+        }
+        const rect = el.getBoundingClientRect();
+        return rect.width > 0 && rect.height > 0;
+      }
+
+      function getCandidates(container) {
+        const elements = Array.from(
+          container.querySelectorAll('[data-spatial-candidate], .card a[href], .card button:not(:disabled), .card [tabindex]')
+        );
+        const candidates = elements.length > 0
+          ? elements
+          : Array.from(container.querySelectorAll(FOCUSABLE_SELECTOR));
+        return candidates.filter((el) => !el.disabled && isVisible(el));
+      }
+
+      function syncRovingTabindex(container, activeCandidate) {
+        const candidates = getCandidates(container);
+        if (candidates.length === 0) return;
+
+        const target =
+          activeCandidate && candidates.includes(activeCandidate)
+            ? activeCandidate
+            : candidates.find((el) => el.getAttribute('tabindex') === '0') || candidates[0];
+
+        for (const candidate of candidates) {
+          candidate.setAttribute('tabindex', candidate === target ? '0' : '-1');
+        }
+      }
+
+      function findSpatialCandidate(current, candidates, direction) {
+        const currentRect = current.getBoundingClientRect();
+        const currentCenterX = (currentRect.left + currentRect.right) / 2;
+        const currentCenterY = (currentRect.top + currentRect.bottom) / 2;
+
+        const isHorizontal = direction === 'left' || direction === 'right';
+        const aligned = [];
+        const unaligned = [];
+
+        for (const candidate of candidates) {
+          if (candidate === current) continue;
+          const rect = candidate.getBoundingClientRect();
+
+          let gap = 0;
+          if (direction === 'right') {
+            if (rect.left < currentRect.right - TOLERANCE) continue;
+            gap = Math.max(0, rect.left - currentRect.right);
+          } else if (direction === 'left') {
+            if (rect.right > currentRect.left + TOLERANCE) continue;
+            gap = Math.max(0, currentRect.left - rect.right);
+          } else if (direction === 'down') {
+            if (rect.top < currentRect.bottom - TOLERANCE) continue;
+            gap = Math.max(0, rect.top - currentRect.bottom);
+          } else if (direction === 'up') {
+            if (rect.bottom > currentRect.top + TOLERANCE) continue;
+            gap = Math.max(0, currentRect.top - rect.bottom);
+          }
+
+          const candidateCenterX = (rect.left + rect.right) / 2;
+          const candidateCenterY = (rect.top + rect.bottom) / 2;
+
+          const overlapsPerpendicular = isHorizontal
+            ? Math.min(currentRect.bottom, rect.bottom) > Math.max(currentRect.top, rect.top) + TOLERANCE
+            : Math.min(currentRect.right, rect.right) > Math.max(currentRect.left, rect.left) + TOLERANCE;
+
+          const perpendicularCentreOffset = isHorizontal
+            ? Math.abs(candidateCenterY - currentCenterY)
+            : Math.abs(candidateCenterX - currentCenterX);
+
+          const entry = {
+            candidate,
+            gap,
+            perpendicularCentreOffset,
+            fallbackScore: gap + FALLBACK_WEIGHT * perpendicularCentreOffset,
+          };
+
+          if (overlapsPerpendicular) {
+            aligned.push(entry);
+          } else {
+            unaligned.push(entry);
+          }
+        }
+
+        if (aligned.length > 0) {
+          aligned.sort((a, b) => {
+            if (Math.abs(a.gap - b.gap) > TOLERANCE) {
+              return a.gap - b.gap;
+            }
+            return a.perpendicularCentreOffset - b.perpendicularCentreOffset;
+          });
+          return aligned[0].candidate;
+        }
+
+        if (unaligned.length > 0) {
+          unaligned.sort((a, b) => a.fallbackScore - b.fallbackScore);
+          return unaligned[0].candidate;
+        }
+
+        return null;
+      }
+
+      function initSpatialContainer(container) {
+        syncRovingTabindex(container);
+
+        container.addEventListener('focusin', (e) => {
+          const target = e.composedPath()[0];
+          if (!(target instanceof HTMLElement)) return;
+          const candidates = getCandidates(container);
+          if (candidates.includes(target)) {
+            syncRovingTabindex(container, target);
+          }
+        });
+
+        container.addEventListener('keydown', (e) => {
+          const direction = DIRECTION_MAP[e.key];
+          if (!direction) return;
+
+          if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) {
+            return;
+          }
+
+          const target = e.composedPath()[0];
+          if (!(target instanceof HTMLElement)) return;
+
+          if (target.matches(':read-write, select, input[type="range"], [role="slider"]')) {
+            return;
+          }
+
+          const candidates = getCandidates(container);
+          if (!candidates.includes(target)) {
+            return;
+          }
+
+          const nextCandidate = findSpatialCandidate(target, candidates, direction);
+          if (!nextCandidate) {
+            return;
+          }
+
+          e.preventDefault();
+          syncRovingTabindex(container, nextCandidate);
+          nextCandidate.focus();
+          nextCandidate.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+      }
+
+      document.querySelectorAll('.grid, [data-spatial-nav]').forEach(initSpatialContainer);
+
+      const layoutButtons = document.querySelectorAll('.layout-btn[data-layout-mode]');
+      const gridContainer = document.querySelector('.grid');
+      if (gridContainer && layoutButtons.length > 0) {
+        layoutButtons.forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const mode = btn.getAttribute('data-layout-mode');
+            gridContainer.setAttribute('data-layout', mode);
+            layoutButtons.forEach((b) => {
+              b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
+            });
+            syncRovingTabindex(gridContainer);
+          });
+        });
+      }
+    })();
+  </script>
 </body>
 
