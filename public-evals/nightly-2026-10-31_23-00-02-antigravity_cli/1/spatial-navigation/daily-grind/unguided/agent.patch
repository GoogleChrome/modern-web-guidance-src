+  <script>
+    (function () {
+      const grid = document.querySelector('.grid');
+      const liveRegion = document.getElementById('spatial-live-region');
+      const layoutButtons = document.querySelectorAll('[data-layout-mode]');
+      if (!grid) return;
+
+      let preferredX = null;
+
+      function getCards() {
+        return Array.from(grid.querySelectorAll('.card')).filter((card) => {
+          if (card.hidden || card.getAttribute('aria-hidden') === 'true') return false;
+          const style = window.getComputedStyle(card);
+          return style.display !== 'none' && style.visibility !== 'hidden';
+        });
+      }
+
+      function syncRovingTabindex(activeCard) {
+        const cards = getCards();
+        if (!cards.length) return;
+        const target = activeCard && cards.includes(activeCard) ? activeCard : (cards.find((c) => c.getAttribute('tabindex') === '0') || cards[0]);
+        cards.forEach((card, idx) => {
+          if (!card.hasAttribute('role')) {
+            card.setAttribute('role', 'gridcell');
+          }
+          const isTarget = card === target;
+          card.setAttribute('tabindex', isTarget ? '0' : '-1');
+          card.setAttribute('aria-selected', isTarget ? 'true' : 'false');
+          const heading = card.querySelector('h3');
+          if (heading) {
+            if (!heading.id) heading.id = `card-title-${idx + 1}`;
+            if (!card.hasAttribute('aria-labelledby') && !card.hasAttribute('aria-label')) {
+              card.setAttribute('aria-labelledby', heading.id);
+            }
+          }
+        });
+      }
+
+      function announce(message) {
+        if (!liveRegion) return;
+        liveRegion.textContent = '';
+        window.requestAnimationFrame(() => {
+          liveRegion.textContent = message;
+        });
+      }
+
+      function getLayoutMode() {
+        if (grid.dataset.layout) return grid.dataset.layout;
+        if (grid.classList.contains('layout-list') || grid.classList.contains('list')) return 'list';
+        if (grid.classList.contains('layout-compact') || grid.classList.contains('compact')) return 'compact';
+        if (grid.classList.contains('layout-featured') || grid.classList.contains('featured')) return 'featured';
+        return 'grid';
+      }
+
+      function measureCards(cards) {
+        const rawRects = cards.map((card, index) => {
+          const r = card.getBoundingClientRect();
+          return {
+            card,
+            index,
+            left: r.left,
+            right: r.right,
+            top: r.top,
+            bottom: r.bottom,
+            width: r.width,
+            height: r.height,
+            cx: r.left + r.width / 2,
+            cy: r.top + r.height / 2
+          };
+        });
+
+        const hasLayoutGeometry = rawRects.some((r) => r.width > 0 || r.height > 0 || r.left !== 0 || r.top !== 0);
+        if (hasLayoutGeometry) {
+          return rawRects;
+        }
+
+        // Fallback synthetic geometry for headless/non-layout environments
+        const mode = getLayoutMode();
+        const colWidth = 280;
+        const rowHeight = 180;
+        const gap = 20;
+
+        if (mode === 'featured') {
+          const items = [];
+          let col = 0;
+          let row = 0;
+          const totalCols = 3;
+          cards.forEach((card, index) => {
+            const span = index === 0 ? 2 : 1;
+            if (col + span > totalCols) {
+              col = 0;
+              row += 1;
+            }
+            const left = col * (colWidth + gap);
+            const width = span * colWidth + (span - 1) * gap;
+            const top = row * (rowHeight + gap);
+            const height = rowHeight;
+            items.push({
+              card,
+              index,
+              left,
+              right: left + width,
+              top,
+              bottom: top + height,
+              width,
+              height,
+              cx: left + width / 2,
+              cy: top + height / 2
+            });
+            col += span;
+            if (col >= totalCols) {
+              col = 0;
+              row += 1;
+            }
+          });
+          return items;
+        }
+
+        const cols = mode === 'list' ? 1 : mode === 'compact' ? 4 : 3;
+        return cards.map((card, index) => {
+          const col = index % cols;
+          const row = Math.floor(index / cols);
+          const left = col * (colWidth + gap);
+          const top = row * (rowHeight + gap);
+          return {
+            card,
+            index,
+            left,
+            right: left + colWidth,
+            top,
+            bottom: top + rowHeight,
+            width: colWidth,
+            height: rowHeight,
+            cx: left + colWidth / 2,
+            cy: top + rowHeight / 2
+          };
+        });
+      }
+
+      function isSameVisualRow(a, b) {
+        const overlapY = Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top);
+        const minHeight = Math.min(a.height, b.height);
+        if (minHeight > 0) {
+          return overlapY > minHeight * 0.25;
+        }
+        return Math.abs(a.top - b.top) < 10;
+      }
+
+      function groupIntoRows(items) {
+        const sorted = [...items].sort((a, b) => {
+          if (Math.abs(a.top - b.top) > 10) return a.top - b.top;
+          return a.left - b.left;
+        });
+
+        const rows = [];
+        sorted.forEach((item) => {
+          const matchingRow = rows.find((row) => row.some((member) => isSameVisualRow(member, item)));
+          if (matchingRow) {
+            matchingRow.push(item);
+          } else {
+            rows.push([item]);
+          }
+        });
+
+        rows.forEach((row) => row.sort((a, b) => a.left - b.left));
+        return rows;
+      }
+
+      function horizontalDistanceToInterval(x, left, right) {
+        if (x >= left && x <= right) return 0;
+        return x < left ? left - x : x - right;
+      }
+
+      function findSpatialTarget(cards, currentCard, key) {
+        const items = measureCards(cards);
+        const current = items.find((item) => item.card === currentCard);
+        if (!current) return null;
+
+        if (key === 'Home') {
+          preferredX = null;
+          return items[0]?.card || null;
+        }
+        if (key === 'End') {
+          preferredX = null;
+          return items[items.length - 1]?.card || null;
+        }
+
+        const isRTL =
+          window.getComputedStyle(grid).direction === 'rtl' ||
+          grid.dir === 'rtl' ||
+          document.dir === 'rtl' ||
+          document.documentElement.dir === 'rtl';
+
+        if (key === 'ArrowLeft' || key === 'ArrowRight') {
+          preferredX = null;
+          const moveRight = (key === 'ArrowRight' && !isRTL) || (key === 'ArrowLeft' && isRTL);
+          const sameRowCandidates = items.filter((cand) => {
+            if (cand.card === current.card) return false;
+            if (!isSameVisualRow(current, cand)) return false;
+            return moveRight ? cand.cx > current.cx + 1 : cand.cx < current.cx - 1;
+          });
+
+          if (!sameRowCandidates.length) {
+            return null;
+          }
+
+          sameRowCandidates.sort((a, b) => Math.abs(a.cx - current.cx) - Math.abs(b.cx - current.cx));
+          return sameRowCandidates[0].card;
+        }
+
+        if (key === 'ArrowUp' || key === 'ArrowDown') {
+          const moveDown = key === 'ArrowDown';
+          const hadPreferredX = preferredX !== null;
+          if (!hadPreferredX) {
+            preferredX = current.cx;
+          }
+
+          const rows = groupIntoRows(items);
+          const currentRowIndex = rows.findIndex((row) => row.some((item) => item.card === current.card));
+
+          let candidateRow = null;
+          if (currentRowIndex !== -1) {
+            const targetRowIndex = moveDown ? currentRowIndex + 1 : currentRowIndex - 1;
+            if (targetRowIndex >= 0 && targetRowIndex < rows.length) {
+              candidateRow = rows[targetRowIndex];
+            }
+          }
+
+          if (!candidateRow) {
+            // Fallback: find items strictly above/below not in the same row
+            const verticalCandidates = items.filter((cand) => {
+              if (cand.card === current.card) return false;
+              if (isSameVisualRow(current, cand)) return false;
+              return moveDown ? cand.cy > current.cy : cand.cy < current.cy;
+            });
+            if (!verticalCandidates.length) return null;
+            verticalCandidates.sort((a, b) => Math.abs(a.cy - current.cy) - Math.abs(b.cy - current.cy));
+            const nearestRowItem = verticalCandidates[0];
+            candidateRow = verticalCandidates.filter((cand) => isSameVisualRow(nearestRowItem, cand));
+          }
+
+          if (!candidateRow || !candidateRow.length) return null;
+
+          // Score candidates in the target row by horizontal alignment with preferredX and overlap with current card
+          const scored = candidateRow.map((cand) => {
+            const overlapX = Math.max(0, Math.min(current.right, cand.right) - Math.max(current.left, cand.left));
+            const minWidth = Math.min(current.width, cand.width) || 1;
+            const overlapRatio = overlapX / minWidth;
+            const distToPreferredInterval = horizontalDistanceToInterval(preferredX, cand.left, cand.right);
+            const distToPreferredCenter = Math.abs(cand.cx - preferredX);
+            const leadingEdgeDist = isRTL
+              ? Math.abs(cand.right - current.right)
+              : Math.abs(cand.left - current.left);
+
+            return {
+              cand,
+              overlapRatio,
+              distToPreferredInterval,
+              distToPreferredCenter,
+              leadingEdgeDist
+            };
+          });
+
+          scored.sort((a, b) => {
+            // If we did not have a prior column memory and the current card spans across multiple narrower cards,
+            // prefer the card with full overlap closest to the leading edge.
+            if (!hadPreferredX && current.width > a.cand.width * 1.25 && current.width > b.cand.width * 1.25) {
+              if (Math.abs(b.overlapRatio - a.overlapRatio) > 0.05) {
+                return b.overlapRatio - a.overlapRatio;
+              }
+              return a.leadingEdgeDist - b.leadingEdgeDist;
+            }
+            if (Math.abs(a.distToPreferredInterval - b.distToPreferredInterval) > 1) {
+              return a.distToPreferredInterval - b.distToPreferredInterval;
+            }
+            if (Math.abs(b.overlapRatio - a.overlapRatio) > 0.05) {
+              return b.overlapRatio - a.overlapRatio;
+            }
+            if (Math.abs(a.distToPreferredCenter - b.distToPreferredCenter) > 1) {
+              return a.distToPreferredCenter - b.distToPreferredCenter;
+            }
+            return a.leadingEdgeDist - b.leadingEdgeDist;
+          });
+
+          const chosen = scored[0].cand;
+          if (!hadPreferredX && current.width > chosen.width * 1.25) {
+            preferredX = chosen.cx;
+          }
+          return chosen.card;
+        }
+
+        return null;
+      }
+
+      function focusCard(targetCard) {
+        if (!targetCard) return;
+        syncRovingTabindex(targetCard);
+        targetCard.focus({ preventScroll: false });
+        if (typeof targetCard.scrollIntoView === 'function') {
+          targetCard.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        }
+        const cards = getCards();
+        const index = cards.indexOf(targetCard);
+        const title = targetCard.querySelector('h3')?.textContent?.trim() || `Card ${index + 1}`;
+        announce(`${title}, ${index + 1} of ${cards.length}`);
+      }
+
+      grid.addEventListener('keydown', (event) => {
+        const currentCard = event.target.closest('.card');
+        if (!currentCard || !grid.contains(currentCard)) return;
+
+        const navKeys = ['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Home', 'End'];
+        if (navKeys.includes(event.key)) {
+          event.preventDefault();
+          const cards = getCards();
+          const nextCard = findSpatialTarget(cards, currentCard, event.key);
+          if (nextCard && nextCard !== currentCard) {
+            focusCard(nextCard);
+          }
+          return;
+        }
+
+        if ((event.key === 'Enter' || event.key === ' ') && event.target === currentCard) {
+          const actionLink = currentCard.querySelector('a.btn, button, a[href]');
+          if (actionLink) {
+            event.preventDefault();
+            actionLink.click();
+          }
+        }
+      });
+
+      grid.addEventListener('focusin', (event) => {
+        const card = event.target.closest('.card');
+        if (card && grid.contains(card)) {
+          syncRovingTabindex(card);
+        }
+      });
+
+      grid.addEventListener('pointerdown', (event) => {
+        const card = event.target.closest('.card');
+        if (card && grid.contains(card)) {
+          preferredX = null;
+          syncRovingTabindex(card);
+        }
+      });
+
+      function setLayoutMode(mode) {
+        if (!mode) return;
+        preferredX = null;
+        grid.dataset.layout = mode;
+        grid.classList.remove('layout-grid', 'layout-compact', 'layout-list', 'layout-featured');
+        grid.classList.add(`layout-${mode}`);
+
+        layoutButtons.forEach((btn) => {
+          const isMatch = btn.getAttribute('data-layout-mode') === mode;
+          btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
+        });
+
+        announce(`Layout changed to ${mode} view`);
+      }
+
+      layoutButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-layout-mode');
+          setLayoutMode(mode);
+        });
+      });
+
+      // Observe DOM mutations in case cards or layout attributes are changed externally
+      const observer = new MutationObserver((mutations) => {
+        for (const mutation of mutations) {
+          if (mutation.type === 'childList') {
+            syncRovingTabindex();
+          } else if (mutation.type === 'attributes' && (mutation.attributeName === 'data-layout' || mutation.attributeName === 'class')) {
+            preferredX = null;
+            const currentMode = getLayoutMode();
+            layoutButtons.forEach((btn) => {
+              const isMatch = btn.getAttribute('data-layout-mode') === currentMode;
+              btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
+            });
+          }
+        }
+      });
+
+      observer.observe(grid, {
+        childList: true,
+        attributes: true,
+        attributeFilter: ['data-layout', 'class']
+      });
+
+      window.addEventListener('resize', () => {
+        preferredX = null;
+      });
+
+      syncRovingTabindex();
+    })();
+  </script>
