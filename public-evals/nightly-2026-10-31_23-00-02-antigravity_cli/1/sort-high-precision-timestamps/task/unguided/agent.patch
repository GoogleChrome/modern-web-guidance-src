+    /**
+     * Format a BigInt nanosecond interval into a clear human-readable string
+     * that preserves full sub-millisecond (microsecond & nanosecond) fidelity.
+     */
+    function formatNanosecondInterval(deltaNs) {
+      const ns = BigInt(deltaNs);
+      if (ns === 0n) {
+        return '0 ns (Initial Event)';
+      }
+
+      const wholeSeconds = ns / 1000000000n;
+      const remAfterSec = ns % 1000000000n;
+      const wholeMs = remAfterSec / 1000000n;
+      const remAfterMs = remAfterSec % 1000000n;
+      const wholeUs = remAfterMs / 1000n;
+      const remNs = remAfterMs % 1000n;
+
+      const parts = [];
+      if (wholeSeconds > 0n) parts.push(`${wholeSeconds} s`);
+      if (wholeMs > 0n) parts.push(`${wholeMs} ms`);
+      if (wholeUs > 0n) parts.push(`${wholeUs} µs`);
+      if (remNs > 0n) parts.push(`${remNs} ns`);
+
+      return `+${parts.join(' ')} (${ns.toLocaleString('en-US')} ns)`;
+    }
