+        if (sortedIndex === 0) {
+          return {
+            ...event,
+            sequenceNumber: 1,
+            intervalNanoseconds: 0n,
+            intervalDuration: null,
+            intervalFormatted: '0 ns (Initial Event)',
+            intervalIso: 'PT0S',
+            isSubMillisecondInterval: false
