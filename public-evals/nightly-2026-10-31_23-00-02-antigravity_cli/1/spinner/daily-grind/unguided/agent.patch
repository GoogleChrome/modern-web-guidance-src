+  <script>
+    (function () {
+      const statusRegion = document.getElementById('loading-status');
+      const seasonalSection = document.getElementById('seasonal-favorites');
+      const orderBtn = document.getElementById('order-now-btn');
+      const detailButtons = document.querySelectorAll('.view-details-btn');
+
+      function announceStatus(message) {
+        if (statusRegion) {
+          statusRegion.textContent = message;
+        }
+      }
+
+      function setButtonLoading(btn, isLoading, loadingText, defaultText) {
+        const label = btn.querySelector('.btn-label');
+        btn.classList.toggle('is-loading', isLoading);
+        btn.setAttribute('aria-busy', isLoading ? 'true' : 'false');
+        btn.setAttribute('aria-disabled', isLoading ? 'true' : 'false');
+        if (label) {
+          label.textContent = isLoading ? loadingText : defaultText;
+        }
+      }
+
+      if (orderBtn) {
+        const defaultOrderText = orderBtn.querySelector('.btn-label')?.textContent || 'Order Now';
+        orderBtn.addEventListener('click', function (event) {
+          event.preventDefault();
+          if (orderBtn.getAttribute('aria-busy') === 'true') {
+            return;
+          }
+
+          const loadingText = orderBtn.getAttribute('data-loading-text') || 'Starting Order...';
+          setButtonLoading(orderBtn, true, loadingText, defaultOrderText);
+          announceStatus('Starting your online order, please wait...');
+
+          const targetHref = orderBtn.getAttribute('href');
+          setTimeout(function () {
+            announceStatus('Order ready. Redirecting to online ordering.');
+            if (targetHref) {
+              window.location.href = targetHref;
+            }
+          }, 800);
+        });
+      }
+
+      detailButtons.forEach(function (btn) {
+        const defaultText = btn.querySelector('.btn-label')?.textContent || 'View Details';
+        btn.addEventListener('click', function (event) {
+          event.preventDefault();
+          if (btn.getAttribute('aria-busy') === 'true') {
+            return;
+          }
+
+          const card = btn.closest('.card');
+          const drinkName = card?.getAttribute('data-drink') || 'drink';
+          const loadingText = btn.getAttribute('data-loading-text') || 'Loading Details...';
+
+          setButtonLoading(btn, true, loadingText, defaultText);
+          if (card) {
+            card.setAttribute('aria-busy', 'true');
+          }
+          if (seasonalSection) {
+            seasonalSection.setAttribute('aria-busy', 'true');
+          }
+          announceStatus('Loading details for ' + drinkName + '...');
+
+          setTimeout(function () {
+            setButtonLoading(btn, false, loadingText, defaultText);
+            if (card) {
+              card.setAttribute('aria-busy', 'false');
+              const detailsContainer = card.querySelector('.drink-details');
+              const detailsText = card.getAttribute('data-details');
+              if (detailsContainer && detailsText) {
+                detailsContainer.textContent = detailsText;
+                detailsContainer.classList.add('is-visible');
+              }
+            }
+            const anyBusy = Array.from(detailButtons).some(function (b) {
+              return b.getAttribute('aria-busy') === 'true';
+            });
+            if (seasonalSection && !anyBusy) {
+              seasonalSection.setAttribute('aria-busy', 'false');
+            }
+            announceStatus('Loaded details for ' + drinkName + '.');
+          }, 600);
+        });
+      });
+    })();
+  </script>
