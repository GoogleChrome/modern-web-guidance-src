+  <script>
+    (function () {
+      function activateLoadingState(button, event) {
+        if (button.getAttribute('aria-busy') === 'true') {
+          if (event) event.preventDefault();
+          return;
+        }
+
+        const targetHref = button.getAttribute('href');
+        if (event) {
+          event.preventDefault();
+        }
+
+        button.setAttribute('aria-busy', 'true');
+        button.setAttribute('aria-disabled', 'true');
+
+        const spinner = button.querySelector('progress.loading-spinner');
+        if (spinner) {
+          spinner.hidden = false;
+        }
+
+        const label = button.querySelector('.btn-label');
+        const loadingText = button.dataset.loadingText;
+        if (label && loadingText) {
+          label.dataset.originalText = label.textContent;
+          label.textContent = loadingText;
+        }
+
+        const card = button.closest('.card');
+        const section = button.closest('#seasonal-favorites');
+        if (card) {
+          card.setAttribute('aria-busy', 'true');
+        }
+        if (section) {
+          section.setAttribute('aria-busy', 'true');
+          const sectionLoading = document.getElementById('seasonal-loading');
+          const sectionLoadingText = document.getElementById('seasonal-loading-text');
+          const drinkName = button.dataset.drinkName;
+          if (sectionLoading) {
+            if (sectionLoadingText && drinkName) {
+              sectionLoadingText.textContent = `Loading ${drinkName} details...`;
+            }
+            sectionLoading.hidden = false;
+          }
+        }
+
+        if (targetHref) {
+          setTimeout(() => {
+            window.location.href = targetHref;
+          }, 600);
+        }
+      }
+
+      const orderBtn = document.getElementById('order-now-btn');
+      if (orderBtn) {
+        orderBtn.addEventListener('click', (event) => {
+          activateLoadingState(orderBtn, event);
+        });
+      }
+
+      const detailButtons = document.querySelectorAll('.drink-details-btn');
+      detailButtons.forEach((btn) => {
+        btn.addEventListener('click', (event) => {
+          activateLoadingState(btn, event);
+        });
+      });
+    })();
+  </script>
