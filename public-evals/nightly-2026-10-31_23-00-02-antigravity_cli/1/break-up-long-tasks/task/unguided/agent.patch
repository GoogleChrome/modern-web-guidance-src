+  <script>
+    (function () {
+      const ORIGINS = [
+        { name: 'Ethiopian Yirgacheffe', acidity: 88, body: 62, sweetness: 84, bitterness: 28, aroma: 92, notes: 'Jasmine, Bergamot, Peach' },
+        { name: 'Colombian Supremo', acidity: 72, body: 76, sweetness: 82, bitterness: 40, aroma: 80, notes: 'Caramel, Red Apple, Milk Chocolate' },
+        { name: 'Sumatra Mandheling', acidity: 45, body: 94, sweetness: 68, bitterness: 72, aroma: 78, notes: 'Dark Cocoa, Cedar, Earthy Spice' },
+        { name: 'Guatemalan Antigua', acidity: 76, body: 82, sweetness: 79, bitterness: 48, aroma: 86, notes: 'Toffee, Orange Zest, Roasted Hazelnut' },
+        { name: 'Kenyan AA', acidity: 92, body: 70, sweetness: 77, bitterness: 34, aroma: 89, notes: 'Blackcurrant, Grapefruit, Winey' },
+        { name: 'Brazilian Santos', acidity: 54, body: 84, sweetness: 86, bitterness: 55, aroma: 74, notes: 'Roasted Almond, Sweet Malt, Brown Sugar' }
+      ];
+
+      const ROAST_TARGETS = {
+        balanced: { acidity: 72, body: 78, sweetness: 84, bitterness: 42, aroma: 85 },
+        bright: { acidity: 88, body: 65, sweetness: 82, bitterness: 28, aroma: 92 },
+        bold: { acidity: 48, body: 92, sweetness: 72, bitterness: 70, aroma: 80 },
+        velvet: { acidity: 64, body: 88, sweetness: 88, bitterness: 52, aroma: 86 }
+      };
+
+      const BREW_MODIFIERS = {
+        espresso: { acidity: 0.95, body: 1.15, sweetness: 1.05, bitterness: 1.08, aroma: 1.04 },
+        pourover: { acidity: 1.08, body: 0.92, sweetness: 1.06, bitterness: 0.90, aroma: 1.10 },
+        coldbrew: { acidity: 0.78, body: 1.06, sweetness: 1.12, bitterness: 0.82, aroma: 0.96 },
+        frenchpress: { acidity: 0.90, body: 1.12, sweetness: 1.00, bitterness: 1.05, aroma: 1.02 }
+      };
+
+      /**
+       * Yields control back to the browser main thread so input, rendering,
+       * and animations stay responsive during large batch computations.
+       */
+      function yieldToMain() {
+        if (typeof globalThis.scheduler !== 'undefined' && typeof globalThis.scheduler.yield === 'function') {
+          return globalThis.scheduler.yield();
+        }
+        return new Promise((resolve) => {
+          setTimeout(resolve, 0);
+        });
+      }
+
+      /**
+       * Simulates thermodynamic Maillard & extraction curves for a single coffee blend.
+       */
+      function evaluateRecipeBlend(index, targetProfile, brewMethod) {
+        const primary = ORIGINS[index % ORIGINS.length];
+        const secondary = ORIGINS[(index * 7 + 3) % ORIGINS.length];
+        const tertiary = ORIGINS[(index * 13 + 5) % ORIGINS.length];
+
+        const w1 = 0.45 + ((index % 17) * 0.01);
+        const w2 = 0.35 - ((index % 11) * 0.01);
+        const w3 = Math.max(0.05, 1 - w1 - w2);
+
+        const mod = BREW_MODIFIERS[brewMethod] || BREW_MODIFIERS.pourover;
+        const target = ROAST_TARGETS[targetProfile] || ROAST_TARGETS.balanced;
+
+        // Multi-step iterative Maillard & extraction diffusion simulation per recipe
+        let thermalCurve = 0;
+        for (let step = 1; step <= 40; step++) {
+          const tempFactor = Math.sin((index + step) * 0.13) * Math.cos(step * 0.07);
+          thermalCurve += tempFactor * 0.15;
+        }
+
+        const clamp = (val) => Math.min(100, Math.max(10, Math.round(val)));
+
+        const acidity = clamp((primary.acidity * w1 + secondary.acidity * w2 + tertiary.acidity * w3) * mod.acidity + thermalCurve);
+        const body = clamp((primary.body * w1 + secondary.body * w2 + tertiary.body * w3) * mod.body - thermalCurve * 0.5);
+        const sweetness = clamp((primary.sweetness * w1 + secondary.sweetness * w2 + tertiary.sweetness * w3) * mod.sweetness + thermalCurve * 0.8);
+        const bitterness = clamp((primary.bitterness * w1 + secondary.bitterness * w2 + tertiary.bitterness * w3) * mod.bitterness);
+        const aroma = clamp((primary.aroma * w1 + secondary.aroma * w2 + tertiary.aroma * w3) * mod.aroma + thermalCurve * 0.6);
+
+        const diff =
+          Math.abs(acidity - target.acidity) * 0.22 +
+          Math.abs(body - target.body) * 0.22 +
+          Math.abs(sweetness - target.sweetness) * 0.26 +
+          Math.abs(bitterness - target.bitterness) * 0.15 +
+          Math.abs(aroma - target.aroma) * 0.15;
+
+        const cuppingScore = Number(Math.max(70, Math.min(99.4, 96.5 - diff * 0.45)).toFixed(1));
+        const balanceIndex = Number(((sweetness * 0.4 + body * 0.3 + aroma * 0.3) / 100).toFixed(2));
+
+        return {
+          id: index + 1,
+          name: `${primary.name.split(' ')[0]} & ${secondary.name.split(' ')[0]} Reserve #${index + 1}`,
+          composition: `${Math.round(w1 * 100)}% ${primary.name}, ${Math.round(w2 * 100)}% ${secondary.name}, ${Math.round(w3 * 100)}% ${tertiary.name}`,
+          notes: `${primary.notes.split(', ')[0]}, ${secondary.notes.split(', ')[1] || secondary.notes.split(', ')[0]}, ${tertiary.notes.split(', ').pop()}`,
+          acidity,
+          body,
+          sweetness,
+          bitterness,
+          aroma,
+          cuppingScore,
+          balanceIndex
+        };
+      }
+
+      const runBtn = document.getElementById('run-simulation-btn');
+      const roastSelect = document.getElementById('roast-profile');
+      const batchSelect = document.getElementById('batch-size');
+      const brewSelect = document.getElementById('brew-method');
+      const statusEl = document.getElementById('simulation-status');
+      const percentEl = document.getElementById('simulation-percentage');
+      const progressBar = document.getElementById('simulation-progressbar');
+      const progressFill = document.getElementById('simulation-progress-fill');
+      const processedEl = document.getElementById('metric-processed');
+      const yieldsEl = document.getElementById('metric-yields');
+      const topScoreEl = document.getElementById('metric-top-score');
+      const avgBalanceEl = document.getElementById('metric-avg-balance');
+      const resultsContainer = document.getElementById('simulation-results');
+
+      let isRunning = false;
+
+      function renderTopBlends(blends) {
+        resultsContainer.innerHTML = blends
+          .map(
+            (b) => `
+          <article class="blend-card">
+            <div class="blend-card-header">
+              <h4>${b.name}</h4>
+              <span class="score-badge">${b.cuppingScore} pts</span>
+            </div>
+            <p class="blend-notes"><strong>Origin Ratio:</strong> ${b.composition}</p>
+            <p class="blend-notes"><strong>Tasting Notes:</strong> ${b.notes}</p>
+            <div class="attribute-bars">
+              <div class="attr-row">
+                <span>Sweetness</span>
+                <div class="attr-bar-bg"><div class="attr-bar-fill" style="width: ${b.sweetness}%"></div></div>
+                <span>${b.sweetness}%</span>
+              </div>
+              <div class="attr-row">
+                <span>Acidity</span>
+                <div class="attr-bar-bg"><div class="attr-bar-fill" style="width: ${b.acidity}%"></div></div>
+                <span>${b.acidity}%</span>
+              </div>
+              <div class="attr-row">
+                <span>Body</span>
+                <div class="attr-bar-bg"><div class="attr-bar-fill" style="width: ${b.body}%"></div></div>
+                <span>${b.body}%</span>
+              </div>
+              <div class="attr-row">
+                <span>Aroma</span>
+                <div class="attr-bar-bg"><div class="attr-bar-fill" style="width: ${b.aroma}%"></div></div>
+                <span>${b.aroma}%</span>
+              </div>
+            </div>
+          </article>
+        `
+          )
+          .join('');
+      }
+
+      async function runBatchSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+        runBtn.disabled = true;
+
+        const totalBlends = parseInt(batchSelect.value, 10) || 3000;
+        const targetProfile = roastSelect.value;
+        const brewMethod = brewSelect.value;
+
+        let processedCount = 0;
+        let yieldCount = 0;
+        let balanceSum = 0;
+        let topBlends = [];
+
+        // Time budget per chunk (~12ms) and max items per chunk so tasks stay well under the 50ms Long Task threshold
+        const CHUNK_TIME_BUDGET_MS = 12;
+        const MAX_ITEMS_PER_CHUNK = 150;
+
+        statusEl.textContent = `Simulating ${totalBlends.toLocaleString()} recipe blends...`;
+        let chunkStart = performance.now();
+        let itemsInCurrentChunk = 0;
+
+        for (let i = 0; i < totalBlends; i++) {
+          const result = evaluateRecipeBlend(i, targetProfile, brewMethod);
+          processedCount++;
+          itemsInCurrentChunk++;
+          balanceSum += result.balanceIndex;
+
+          if (topBlends.length < 3 || result.cuppingScore > topBlends[topBlends.length - 1].cuppingScore) {
+            topBlends.push(result);
+            topBlends.sort((a, b) => b.cuppingScore - a.cuppingScore);
+            if (topBlends.length > 3) {
+              topBlends.pop();
+            }
+          }
+
+          const elapsed = performance.now() - chunkStart;
+          const shouldYield =
+            (elapsed >= CHUNK_TIME_BUDGET_MS || itemsInCurrentChunk >= MAX_ITEMS_PER_CHUNK) &&
+            i < totalBlends - 1;
+
+          if (shouldYield) {
+            yieldCount++;
+            const pct = Math.round((processedCount / totalBlends) * 100);
+            percentEl.textContent = `${pct}%`;
+            progressFill.style.width = `${pct}%`;
+            progressBar.setAttribute('aria-valuenow', String(pct));
+            processedEl.textContent = processedCount.toLocaleString();
+            yieldsEl.textContent = yieldCount.toLocaleString();
+            topScoreEl.textContent = `${topBlends[0].cuppingScore} pts`;
+            avgBalanceEl.textContent = `${Math.round((balanceSum / processedCount) * 100)}%`;
+
+            await yieldToMain();
+            chunkStart = performance.now();
+            itemsInCurrentChunk = 0;
+          }
+        }
+
+        percentEl.textContent = '100%';
+        progressFill.style.width = '100%';
+        progressBar.setAttribute('aria-valuenow', '100');
+        processedEl.textContent = processedCount.toLocaleString();
+        yieldsEl.textContent = yieldCount.toLocaleString();
+        topScoreEl.textContent = `${topBlends[0].cuppingScore} pts`;
+        avgBalanceEl.textContent = `${Math.round((balanceSum / processedCount) * 100)}%`;
+        statusEl.textContent = `Completed ${processedCount.toLocaleString()} blends across ${yieldCount + 1} non-blocking task chunks.`;
+
+        renderTopBlends(topBlends);
+        isRunning = false;
+        runBtn.disabled = false;
+      }
+
+      runBtn.addEventListener('click', runBatchSimulation);
+
+      // Run an initial batch simulation automatically after page load
+      window.addEventListener('DOMContentLoaded', () => {
+        runBatchSimulation();
+      });
+    })();
+  </script>
