+
+      const fragmentShaderSource = `
+        precision highp float;
+
+        varying vec2 v_uv;
+        uniform sampler2D u_texture;
+        uniform vec2 u_resolution;
+        uniform float u_time;
+        uniform vec2 u_mouse;
+        uniform vec2 u_mouseVelocity;
+        uniform float u_hoverIntensity;
+        uniform vec4 u_ripples[8];
+
+        void main() {
+          vec2 uv = v_uv;
+          float aspect = u_resolution.x / max(u_resolution.y, 1.0);
+          vec2 aspectScale = vec2(aspect, 1.0);
+
+          vec2 totalDisplacement = vec2(0.0);
+          float waveHighlight = 0.0;
+
+          // 1. Ambient continuous GPU wave distortion for hero HTML content
+          float ambientWaveX = sin(uv.y * 18.0 + u_time * 2.2) * cos(uv.x * 12.0 - u_time * 1.6);
+          float ambientWaveY = cos(uv.x * 16.0 + u_time * 1.9) * sin(uv.y * 14.0 + u_time * 1.4);
+          totalDisplacement += vec2(ambientWaveX, ambientWaveY) * 0.0028;
+
+          // 2. Interactive cursor proximity ripple & wake distortion
+          vec2 toMouse = (uv - u_mouse) * aspectScale;
+          float mouseDist = length(toMouse);
+          vec2 mouseDir = mouseDist > 0.0001 ? toMouse / mouseDist : vec2(0.0);
+          float cursorField = exp(-mouseDist * 9.0) * u_hoverIntensity;
+          float cursorRipple = sin(mouseDist * 48.0 - u_time * 7.5) * cursorField;
+          float velocityBoost = clamp(length(u_mouseVelocity) * 1.8, 0.0, 1.5);
+          totalDisplacement += mouseDir * cursorRipple * (0.0065 + velocityBoost * 0.006);
+          totalDisplacement += u_mouseVelocity * exp(-mouseDist * 10.0) * 0.008;
+          waveHighlight += cursorRipple * 0.25;
+
+          // 3. Expanding ring ripples from pointer movement, clicks, and button interactions
+          for (int i = 0; i < 8; i++) {
+            vec4 ripple = u_ripples[i];
+            float startTime = ripple.z;
+            float amplitude = ripple.w;
+            if (amplitude > 0.0001) {
+              float age = max(0.0, u_time - startTime);
+              if (age < 3.0) {
+                vec2 delta = (uv - ripple.xy) * aspectScale;
+                float dist = length(delta);
+                vec2 dir = dist > 0.0001 ? delta / dist : vec2(0.0);
+
+                float radius = age * 0.42;
+                float ringDist = dist - radius;
+                float envelope = exp(-ringDist * ringDist * 95.0);
