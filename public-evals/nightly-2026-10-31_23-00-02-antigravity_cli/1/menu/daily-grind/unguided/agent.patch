+
+      function closeAllMenus(exceptContainer = null) {
+        menuContainers.forEach((container) => {
+          if (container === exceptContainer) return;
+          const rootTrigger = container.querySelector('[aria-haspopup="menu"]');
+          const allMenus = container.querySelectorAll('.ui-menu');
+          const allTriggers = container.querySelectorAll('[aria-expanded="true"]');
+
+          if (rootTrigger) rootTrigger.setAttribute('aria-expanded', 'false');
+          allTriggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
+          allMenus.forEach((m) => m.classList.remove('is-open'));
+        });
+      }
+
+      function closeSubmenusOf(parentMenu, exceptSubmenu = null) {
+        if (!parentMenu) return;
+        const groups = parentMenu.querySelectorAll(':scope > .ui-menu-item-group');
+        groups.forEach((group) => {
+          const trigger = group.querySelector(':scope > .ui-menu-item[aria-haspopup="menu"]');
+          const submenu = group.querySelector(':scope > .ui-submenu');
+          if (submenu && submenu !== exceptSubmenu) {
+            submenu.classList.remove('is-open');
+            if (trigger) trigger.setAttribute('aria-expanded', 'false');
+            closeSubmenusOf(submenu);
+          }
+        });
+      }
+
+      function openSubmenu(trigger, submenu) {
+        if (!trigger || !submenu) return;
+        const parentMenu = trigger.closest('.ui-menu');
+        closeSubmenusOf(parentMenu, submenu);
+        trigger.setAttribute('aria-expanded', 'true');
+        submenu.classList.add('is-open');
+      }
+
+      // Update a card's customization tags and computed price
