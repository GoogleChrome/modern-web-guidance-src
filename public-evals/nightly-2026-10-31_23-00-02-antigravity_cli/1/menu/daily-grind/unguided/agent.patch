+              cb.setAttribute('aria-checked', 'false')
+            );
+            const types = ['size', 'temp', 'milk', 'shots', 'sweetness'];
+            types.forEach((type) => {
+              const group = card.querySelectorAll(`.ui-menu-item[data-option-type="${type}"]`);
+              group.forEach((item, idx) => {
+                const isBase = item.getAttribute('data-price-delta') === '0' && idx === 0;
+                item.setAttribute('aria-checked', isBase ? 'true' : 'false');
+              });
+              const anyChecked = Array.from(group).some((i) => i.getAttribute('aria-checked') === 'true');
+              if (!anyChecked && group[0]) group[0].setAttribute('aria-checked', 'true');
+            });
+          }
+          updateCardSummary(card);
+        });
+      }
+
+      // Setup interactive events for each menu container
+      menuContainers.forEach((container) => {
+        const rootTrigger = container.querySelector(':scope > [aria-haspopup="menu"]');
+        const rootMenu = container.querySelector(':scope > .ui-menu');
+
+        if (!rootTrigger || !rootMenu) return;
+
+        rootTrigger.addEventListener('click', (e) => {
+          e.stopPropagation();
+          const isOpen = rootMenu.classList.contains('is-open');
+          closeAllMenus(container);
+          if (isOpen) {
+            closeAllMenus();
+          } else {
+            rootTrigger.setAttribute('aria-expanded', 'true');
+            rootMenu.classList.add('is-open');
+          }
+        });
+
+        // Submenu hover & click interactions
+        const submenuGroups = container.querySelectorAll('.ui-menu-item-group');
+        submenuGroups.forEach((group) => {
+          const trigger = group.querySelector(':scope > .ui-menu-item[aria-haspopup="menu"]');
+          const submenu = group.querySelector(':scope > .ui-submenu');
+          if (!trigger || !submenu) return;
+
+          group.addEventListener('mouseenter', () => {
+            openSubmenu(trigger, submenu);
+          });
+
+          trigger.addEventListener('click', (e) => {
+            e.preventDefault();
+            e.stopPropagation();
+            const isOpen = submenu.classList.contains('is-open');
+            if (isOpen) {
+              submenu.classList.remove('is-open');
+              trigger.setAttribute('aria-expanded', 'false');
+              closeSubmenusOf(submenu);
+            } else {
+              openSubmenu(trigger, submenu);
+            }
+          });
+        });
+
+        // Menu item selection
+        container.addEventListener('click', (e) => {
+          const item = e.target.closest('.ui-menu-item');
+          if (!item) return;
+
+          // If it's a submenu parent trigger, handled above
+          if (item.getAttribute('aria-haspopup') === 'menu') {
+            return;
+          }
+
+          e.stopPropagation();
+          const role = item.getAttribute('role');
+          const card = item.closest('[data-drink-card]');
+
+          // Handle radio options (Size, Milk, Shots, Fulfillment Mode)
+          if (role === 'menuitemradio') {
+            const optionType = item.getAttribute('data-option-type');
+            const radioGroup = item.getAttribute('data-radio-group');
+
+            if (card && optionType) {
+              const peers = card.querySelectorAll(`.ui-menu-item[role="menuitemradio"][data-option-type="${optionType}"]`);
+              peers.forEach((peer) => peer.setAttribute('aria-checked', 'false'));
+              item.setAttribute('aria-checked', 'true');
+              updateCardSummary(card);
+              const drinkTitle = card.querySelector('h3')?.textContent || 'Drink';
+              showToast(`${drinkTitle}: ${item.getAttribute('data-option-label')} selected`);
+            } else if (radioGroup) {
+              const peers = container.querySelectorAll(`.ui-menu-item[role="menuitemradio"][data-radio-group="${radioGroup}"]`);
+              peers.forEach((peer) => peer.setAttribute('aria-checked', 'false'));
+              item.setAttribute('aria-checked', 'true');
+              showToast(item.getAttribute('data-nav-action') || 'Preference updated');
+            }
+            return;
+          }
+
+          // Handle checkbox options (Add-ons, Syrups, Toppings)
+          if (role === 'menuitemcheckbox') {
+            const isChecked = item.getAttribute('aria-checked') === 'true';
+            item.setAttribute('aria-checked', isChecked ? 'false' : 'true');
+            if (card) {
+              updateCardSummary(card);
+              const drinkTitle = card.querySelector('h3')?.textContent || 'Drink';
+              const actionVerb = isChecked ? 'Removed' : 'Added';
+              showToast(`${drinkTitle}: ${actionVerb} ${item.getAttribute('data-option-label')}`);
+            }
+            return;
+          }
+
+          // Handle Navigation Category Filter or Action
+          const filterCategory = item.getAttribute('data-filter-category');
+          const navAction = item.getAttribute('data-nav-action');
+          if (filterCategory || navAction) {
+            if (filterCategory) {
+              filterCardsByCategory(filterCategory, navAction);
+            }
+            if (navAction && item.tagName !== 'A') {
+              showToast(navAction);
+            }
+            closeAllMenus();
+            return;
+          }
+
+          // Handle Preset Actions
+          const presetAction = item.getAttribute('data-preset-action');
+          if (presetAction) {
+            applyDrinkPreset(presetAction);
+            showToast(`Applied preset: ${item.textContent.trim()}`);
+            closeAllMenus();
+            return;
+          }
+
+          // Handle Card Quick Actions
+          const cardAction = item.getAttribute('data-card-action');
+          if (cardAction && card) {
+            const drinkTitle = card.querySelector('h3')?.textContent || 'Drink';
+            if (cardAction === 'add-to-order') {
+              addCardToCart(card);
+            } else if (cardAction === 'save-favorite') {
+              showToast(`Saved customized ${drinkTitle} to Favorites`);
+            }
+            closeAllMenus();
+          }
+        });
+
+        // Keyboard navigation (ArrowUp, ArrowDown, ArrowRight, ArrowLeft, Escape)
+        container.addEventListener('keydown', (e) => {
+          const activeEl = document.activeElement;
+          const currentMenu = activeEl?.closest('.ui-menu') || rootMenu;
+          const visibleItems = Array.from(
+            currentMenu.querySelectorAll(':scope > li > .ui-menu-item, :scope > .ui-menu-item-group > .ui-menu-item')
+          );
+
+          const currentIndex = visibleItems.indexOf(activeEl);
+
+          if (e.key === 'Escape') {
+            e.preventDefault();
+            const parentGroup = currentMenu.closest('.ui-menu-item-group');
+            if (parentGroup) {
+              const parentTrigger = parentGroup.querySelector(':scope > .ui-menu-item[aria-haspopup="menu"]');
+              currentMenu.classList.remove('is-open');
+              if (parentTrigger) {
+                parentTrigger.setAttribute('aria-expanded', 'false');
+                parentTrigger.focus();
+              }
+            } else {
+              closeAllMenus();
+              rootTrigger.focus();
+            }
+          } else if (e.key === 'ArrowDown') {
+            e.preventDefault();
+            if (!rootMenu.classList.contains('is-open')) {
+              rootTrigger.click();
+              const firstItem = rootMenu.querySelector('.ui-menu-item');
+              if (firstItem) firstItem.focus();
+            } else if (visibleItems.length > 0) {
+              const nextIndex = (currentIndex + 1) % visibleItems.length;
+              visibleItems[nextIndex].focus();
+            }
+          } else if (e.key === 'ArrowUp') {
+            e.preventDefault();
+            if (visibleItems.length > 0) {
+              const prevIndex = (currentIndex - 1 + visibleItems.length) % visibleItems.length;
+              visibleItems[prevIndex].focus();
+            }
+          } else if (e.key === 'ArrowRight') {
+            if (activeEl && activeEl.getAttribute('aria-haspopup') === 'menu') {
+              e.preventDefault();
+              const group = activeEl.closest('.ui-menu-item-group');
+              const submenu = group?.querySelector(':scope > .ui-submenu');
+              if (submenu) {
+                openSubmenu(activeEl, submenu);
+                const firstSubItem = submenu.querySelector('.ui-menu-item');
+                if (firstSubItem) firstSubItem.focus();
+              }
+            }
+          } else if (e.key === 'ArrowLeft') {
+            const parentGroup = currentMenu.closest('.ui-menu-item-group');
+            if (parentGroup) {
+              e.preventDefault();
+              const parentTrigger = parentGroup.querySelector(':scope > .ui-menu-item[aria-haspopup="menu"]');
+              currentMenu.classList.remove('is-open');
+              if (parentTrigger) {
+                parentTrigger.setAttribute('aria-expanded', 'false');
+                parentTrigger.focus();
+              }
+            }
+          }
+        });
+      });
+
+      // Direct "Add to Order" buttons on each card
+      document.querySelectorAll('[data-quick-order-btn]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const card = btn.closest('[data-drink-card]');
+          addCardToCart(card);
+        });
+      });
+
+      // Close menus when clicking outside
+      document.addEventListener('click', (e) => {
+        if (!e.target.closest('[data-menu-container]')) {
+          closeAllMenus();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
