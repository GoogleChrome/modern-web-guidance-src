+              const nextTrigger = barTriggers[(idx + 1) % barTriggers.length];
+              rootPopover.hidePopover();
+              setMenubarTabStop(nextTrigger);
+              focusWithMode(nextTrigger, { fromPointer: false });
+              showMenu(menuFor(nextTrigger), nextTrigger);
+            }
+          } else if (event.key === 'Tab') {
+            // Leave the menu system cleanly without trapping focus or leaving focus in hidden content
+            if (rootTrigger) {
+              setMenubarTabStop(rootTrigger);
+              focusWithMode(rootTrigger, { fromPointer: false, suppressPreview: true });
+            }
+            closeAllMenus();
+          }
+        });
+
+        // Command & Checkable item activation (skip submenu triggers)
+        if (!isSubTrigger) {
+          item.addEventListener('click', event => {
+            const fromPointer = event.detail > 0;
+            const role = item.getAttribute('role');
+            const rootPopover = getRootMenu(item);
+            const actionText = item.dataset.action || item.textContent.trim();
+
+            if (role === 'menuitemcheckbox') {
+              const nextChecked = item.getAttribute('aria-checked') !== 'true';
+              item.setAttribute('aria-checked', String(nextChecked));
+              announceAction(`${actionText} (${nextChecked ? 'Enabled' : 'Disabled'})`, item);
+
+              // Space on a checkbox toggles and stays open (APG); Enter or pointer click closes after ~300ms
+              if (!fromPointer && lastKeyPressed === ' ') {
+                return;
+              }
+              setTimeout(() => {
+                closeAndRestore(rootPopover, { fromPointer });
+              }, 300);
+              return;
+            }
+
+            if (role === 'menuitemradio') {
+              const radioGroup = item.closest('[role="group"]') || group;
+              radioGroup.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+                radio.setAttribute('aria-checked', String(radio === item));
+              });
+              announceAction(actionText, item);
+              setTimeout(() => {
+                closeAndRestore(rootPopover, { fromPointer });
+              }, 300);
+              return;
+            }
+
+            // Standard command item
+            announceAction(actionText, item);
+            closeAndRestore(rootPopover, { fromPointer });
+          });
+        }
+      });
+    });
+
+    // 8. Outside focusin listener: close every open menu when focus lands outside the menu system
+    document.addEventListener('focusin', event => {
+      const target = event.target;
+      if (!(target instanceof Element)) return;
+      if (!target.closest('[popover], button[commandfor], [role="menubar"]')) {
+        closeAllMenus();
+      }
+    });
+  </script>
 </body>
 
 </html>
