+  <script>
+    const TARGET_TIMEZONES = [
+      { id: 'America/New_York', label: 'New York' },
+      { id: 'Europe/London', label: 'London' },
+      { id: 'Asia/Tokyo', label: 'Tokyo' },
+      { id: 'UTC', label: 'UTC' }
+    ];
+
+    function updateTastingSchedule() {
+      if (typeof Temporal === 'undefined') return;
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const timeZone = hostTzSelect.value;
+
+      if (!date || !time || !timeZone) {
+        return;
+      }
+
+      const inputStr = `${date}T${time}[${timeZone}]`;
+
+      // Detect DST transition gap or overlap conflicts using disambiguation: 'reject'
+      let hasConflict = false;
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          hasConflict = true;
+        }
+      }
+
+      // Safely resolve the host time using disambiguation: 'compatible' (default)
+      const hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+
+      if (hasConflict) {
+        const earlierTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'earlier' });
+        const laterTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'later' });
+        const resolvedFormatted = hostTime.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' });
+        const requestedPlain = Temporal.PlainDateTime.from(`${date}T${time}`);
+        const isGap = !hostTime.toPlainDateTime().equals(requestedPlain);
+
+        if (isGap) {
+          hostWarning.textContent = `Daylight Saving Time Conflict: The selected time (${time}) falls in a DST spring-forward transition gap and does not exist in ${timeZone}. Using 'compatible' disambiguation, it was resolved forward to ${resolvedFormatted} (${hostTime.offset}).`;
+        } else {
+          hostWarning.textContent = `Daylight Saving Time Conflict: The selected time (${time}) is ambiguous in ${timeZone} due to a DST fall-back overlap (occurring twice, at ${earlierTime.offset} and ${laterTime.offset}). Using 'compatible' disambiguation, it was resolved to the first occurrence at ${resolvedFormatted} (${hostTime.offset}).`;
+        }
+        hostWarning.hidden = false;
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.hidden = true;
+      }
+
+      // Render timezone cards using immutable Temporal.ZonedDateTime.prototype.withTimeZone()
+      grid.innerHTML = '';
+      for (const tz of TARGET_TIMEZONES) {
+        const targetZdt = hostTime.withTimeZone(tz.id);
+        const formattedTime = targetZdt.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+        const formattedDate = targetZdt.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+
+        const card = document.createElement('div');
+        card.className = `card tz-card${tz.id === timeZone ? ' is-host' : ''}`;
+        card.dataset.timezone = tz.id;
+
+        const title = document.createElement('h3');
+        title.textContent = tz.label;
+
+        const tzCode = document.createElement('div');
+        tzCode.className = 'tz-name';
+        tzCode.textContent = tz.id;
+
+        const timeEl = document.createElement('div');
+        timeEl.className = 'tz-time';
+        timeEl.textContent = formattedTime;
+
+        const dateEl = document.createElement('div');
+        dateEl.className = 'tz-date';
+        dateEl.textContent = formattedDate;
+
+        const offsetEl = document.createElement('span');
+        offsetEl.className = 'tz-offset';
+        offsetEl.textContent = `UTC${targetZdt.offset}`;
+
+        card.append(title, tzCode, timeEl, dateEl, offsetEl);
+        grid.appendChild(card);
+      }
+    }
+
+    function initializeApp() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+
+      [dateInput, timeInput, hostTzSelect].forEach((el) => {
+        el.addEventListener('input', updateTastingSchedule);
+        el.addEventListener('change', updateTastingSchedule);
+      });
+
+      updateTastingSchedule();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
