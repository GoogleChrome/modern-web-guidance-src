+  <script>
+    (function () {
+      const TARGET_TIMEZONES = Object.freeze([
+        { label: 'New York', id: 'America/New_York' },
+        { label: 'London', id: 'Europe/London' },
+        { label: 'Tokyo', id: 'Asia/Tokyo' },
+        { label: 'UTC', id: 'UTC' }
+      ]);
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      function format12HourTime(zdt) {
+        return zdt.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit',
+          hour12: true
+        });
+      }
+
+      function formatDisplayDate(zdt) {
+        return zdt.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+      }
+
+      function updateSchedule() {
+        const dateVal = dateInput.value;
+        const timeVal = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateVal || !timeVal || !hostTz) {
+          return;
+        }
+
+        const plainDate = Temporal.PlainDate.from(dateVal);
+        const plainTime = Temporal.PlainTime.from(timeVal);
+        const requestedPlainDateTime = plainDate.toPlainDateTime(plainTime);
+
+        const earlierZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'earlier'
+        });
+        const laterZdt = requestedPlainDateTime.toZonedDateTime(hostTz, {
+          disambiguation: 'later'
+        });
+
+        let hasDstConflict = false;
+        try {
+          requestedPlainDateTime.toZonedDateTime(hostTz, {
+            disambiguation: 'reject'
+          });
+        } catch (err) {
+          hasDstConflict = true;
+        }
+
+        if (!earlierZdt.equals(laterZdt)) {
+          hasDstConflict = true;
+        }
+
+        const hostZdt = Object.freeze(
+          requestedPlainDateTime.toZonedDateTime(hostTz, {
+            disambiguation: 'compatible'
+          })
+        );
+
+        if (hasDstConflict) {
+          const isGap = !hostZdt.toPlainDateTime().equals(requestedPlainDateTime);
+          const resolvedTimeFormatted = format12HourTime(hostZdt);
+          const requestedTimeFormatted = plainTime.toLocaleString('en-US', {
+            hour: 'numeric',
+            minute: '2-digit',
+            hour12: true
+          });
+
+          if (isGap) {
+            hostWarning.textContent =
+              `Daylight Saving Time Gap Detected: The selected local time (${requestedTimeFormatted}) does not exist in ${hostTz} because clocks spring forward from ${format12HourTime(earlierZdt)} (${earlierZdt.offset}) across the transition gap. Using standard compatible disambiguation, the event time was resolved forward to ${resolvedTimeFormatted} (UTC${hostZdt.offset}).`;
+          } else {
+            hostWarning.textContent =
+              `Daylight Saving Time Overlap Detected: The selected local time (${requestedTimeFormatted}) is ambiguous in ${hostTz} because clocks fall back and repeat this hour (occurring first at UTC${earlierZdt.offset} and again at UTC${laterZdt.offset}). Using standard compatible disambiguation, the event time was resolved to the first (earlier) occurrence at ${resolvedTimeFormatted} (UTC${hostZdt.offset}).`;
+          }
+          hostWarning.classList.add('visible');
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.classList.remove('visible');
+        }
+
+        grid.innerHTML = '';
+
+        for (const tz of TARGET_TIMEZONES) {
+          const targetZdt = hostZdt.withTimeZone(tz.id);
+          const formattedTime = format12HourTime(targetZdt);
+          const formattedDate = formatDisplayDate(targetZdt);
+
+          const card = document.createElement('div');
+          card.className = 'card tz-card' + (tz.id === hostTz ? ' is-host' : '');
+          card.dataset.timezone = tz.id;
+
+          const titleEl = document.createElement('h3');
+          titleEl.textContent = tz.label;
+
+          const idEl = document.createElement('div');
+          idEl.className = 'tz-id';
+          idEl.textContent = tz.id;
+
+          const timeEl = document.createElement('div');
+          timeEl.className = 'tz-time';
+          timeEl.textContent = formattedTime;
+
+          const dateEl = document.createElement('div');
+          dateEl.className = 'tz-date';
+          dateEl.textContent = formattedDate;
+
+          const offsetEl = document.createElement('span');
+          offsetEl.className = 'tz-offset';
+          offsetEl.textContent = `UTC${targetZdt.offset}`;
+
+          card.appendChild(titleEl);
+          card.appendChild(idEl);
+          card.appendChild(timeEl);
+          card.appendChild(dateEl);
+          card.appendChild(offsetEl);
+
+          grid.appendChild(card);
+        }
+      }
+
+      dateInput.addEventListener('input', updateSchedule);
+      dateInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      hostTzSelect.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+
+      updateSchedule();
+    })();
+  </script>
 </body>
 
