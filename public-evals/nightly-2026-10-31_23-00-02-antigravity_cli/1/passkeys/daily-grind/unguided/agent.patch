+        let candidatePasskeys = [];
+        if (targetCustomer) {
+          candidatePasskeys = targetCustomer.passkeys || [];
+          if (specificPasskeyId) {
+            candidatePasskeys = candidatePasskeys.filter(pk => pk.id === specificPasskeyId);
+          }
+        } else {
+          customers.forEach(c => {
+            (c.passkeys || []).forEach(pk => candidatePasskeys.push(pk));
+          });
+        }
+
+        if (candidatePasskeys.length === 0) {
+          throw new Error('No registered passkeys found for this customer account.');
+        }
