+
+          if (typeof callback === 'function') {
+            await callback(passkey);
+          }
+        } catch (err) {
+          showAlert(err.message || 'Passkey reauthentication failed.', 'error');
+        }
+      });
+
+      triggerReauthBtn.addEventListener('click', () => {
+        openReauthModal('Manual passkey step-up verification', () => {
+          showAlert('Identity re-verified with your passkey! Sensitive account actions are unlocked.', 'success');
+        });
+      });
+
+      // Profile Updates (Protected by Passkey Reauthentication)
+      profileForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        hideAlert();
+
+        const customer = getActiveCustomer();
+        if (!customer) return;
+
+        const updatedEmail = profileEmail.value.trim().toLowerCase();
+        const emailChanged = updatedEmail !== customer.email.toLowerCase();
+        const needsStepUp = requireReauthEachSave.checked || emailChanged || !isReauthFresh();
+
+        const applyProfileUpdate = () => {
+          const duplicate = customers.find(c => c.id !== customer.id && c.email.toLowerCase() === updatedEmail);
+          if (duplicate) {
+            showAlert('Another customer account is already using that email address.', 'error');
+            return;
+          }
+
+          customer.fullName = profileName.value.trim();
+          customer.email = updatedEmail;
+          customer.phone = profilePhone.value.trim();
+          customer.favoriteDrink = profileDrink.value;
+          customer.roastPreference = profileRoast.value;
+          customer.deliveryNote = profileAddress.value.trim();
+
+          logCustomerActivity(customer, 'Updated customer profile & coffee preferences');
+          saveCustomers(customers);
+          renderApp();
+          showAlert('Customer profile updated and saved after passkey verification.', 'success');
+        };
+
+        if (needsStepUp) {
+          openReauthModal('Save changes to customer profile (' + profileName.value.trim() + ')', applyProfileUpdate);
+        } else {
+          applyProfileUpdate();
+        }
+      });
+
+      // Add New Passkey to Account
+      addPasskeyForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        hideAlert();
+
+        const customer = getActiveCustomer();
+        if (!customer) return;
+
+        const label = newPasskeyLabel.value.trim();
+        const attachment = newPasskeyAttachment.value;
+        if (!label) return;
+
+        const enrollNewKey = async () => {
+          try {
+            const newPk = await createPasskeyCredential(customer, label, attachment);
+            customer.passkeys.push(newPk);
+            logCustomerActivity(customer, `Added new passkey "${newPk.name}"`);
+            saveCustomers(customers);
+            newPasskeyLabel.value = '';
+            renderApp();
+            showAlert(`New passkey "${newPk.name}" enrolled and saved to your account.`, 'success');
+          } catch (err) {
+            showAlert(err.message || 'Failed to add passkey.', 'error');
+          }
+        };
+
+        if (!isReauthFresh()) {
+          openReauthModal(`Enroll new passkey "${label}"`, enrollNewKey);
+        } else {
+          enrollNewKey();
+        }
+      });
+
+      // Rename Saved Passkey
+      cancelRenameBtn.addEventListener('click', () => {
+        renameModal.classList.remove('open');
+      });
+
+      renameForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const customer = getActiveCustomer();
+        if (!customer) return;
+
+        const pkId = renamePasskeyIdInput.value;
+        const newName = renamePasskeyInput.value.trim();
+        if (!newName) return;
+
+        const pk = (customer.passkeys || []).find(p => p.id === pkId);
+        if (pk) {
+          const oldName = pk.name;
+          pk.name = newName;
+          logCustomerActivity(customer, `Renamed passkey "${oldName}" to "${newName}"`);
+          saveCustomers(customers);
+          renameModal.classList.remove('open');
+          renderApp();
+          showAlert(`Passkey renamed to "${newName}".`, 'success');
+        }
+      });
+
+      // Delete Saved Passkey (Requires Reauthentication & prevents removing last passkey)
+      function handleDeletePasskey(pkId) {
+        hideAlert();
+        const customer = getActiveCustomer();
+        if (!customer) return;
+
+        if ((customer.passkeys || []).length <= 1) {
+          showAlert('Cannot remove your only saved passkey. Add a backup passkey before removing this one.', 'error');
+          return;
+        }
+
+        const pk = customer.passkeys.find(p => p.id === pkId);
+        if (!pk) return;
+
+        openReauthModal(`Remove saved passkey "${pk.name}"`, () => {
+          customer.passkeys = customer.passkeys.filter(p => p.id !== pkId);
+          if (session.passkeyId === pkId && customer.passkeys.length > 0) {
+            session.passkeyId = customer.passkeys[0].id;
+            saveSession(session);
+          }
+          logCustomerActivity(customer, `Removed passkey "${pk.name}"`);
+          saveCustomers(customers);
+          renderApp();
+          showAlert(`Passkey "${pk.name}" has been removed from your account.`, 'info');
+        });
+      }
+
+      // Sign Out / Logout handlers
+      function handleLogout(e) {
+        if (e) e.preventDefault();
+        const customer = getActiveCustomer();
+        if (customer) {
+          logCustomerActivity(customer, 'Signed out of account session');
+          saveCustomers(customers);
+        }
+        session = null;
+        saveSession(null);
+        renderApp();
+        showAlert('You have been signed out of your Daily Grind account.', 'info');
+      }
+
+      navLogoutBtn.addEventListener('click', handleLogout);
+      dashboardLogoutBtn.addEventListener('click', handleLogout);
+
+      // Quick Menu "Order with Account" buttons
+      document.querySelectorAll('[data-quick-drink]').forEach(btn => {
+        btn.addEventListener('click', () => {
+          const drink = btn.getAttribute('data-quick-drink');
+          const customer = getActiveCustomer();
+          if (customer) {
+            profileDrink.value = drink;
+            showAlert(`Selected "${drink}" in your profile preferences. Click Save Profile Changes to update your default order.`, 'info');
+          } else {
+            document.getElementById('reg-drink').value = drink;
+            showAlert(`Sign in with your passkey or register to order "${drink}".`, 'info');
+          }
+        });
+      });
+
+      // Periodic refresh for step-up reauthentication countdown
+      setInterval(() => {
+        if (getActiveCustomer()) {
+          renderReauthStatus();
+        }
+      }, 5000);
+
+      // Initial render
+      renderApp();
+    })();
+  </script>
+
 </body>
 
