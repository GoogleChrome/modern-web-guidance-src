+import type { APIRoute } from 'astro';
+import crypto from 'node:crypto';
+
+interface StoredPasskeyRecord {
+  id: string;
+  name: string;
+  userId: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  transports: string[];
+  authenticatorAttachment: 'platform' | 'cross-platform';
+  backedUp: boolean;
+  backupEligible: boolean;
+  userVerified: boolean;
+  signCount: number;
+  aaguid: string;
+  providerName: string;
+  publicKeyAlgorithm: number;
+  rpId: string;
+}
+
+const serverChallenges = new Map<string, { createdAt: number; action: string; userId?: string }>();
+const serverPasskeys = new Map<string, StoredPasskeyRecord>([
+  [
+    'cred_icloud_macbook_pro_9f8a7b6c5d4e3f2a',
+    {
+      id: 'cred_icloud_macbook_pro_9f8a7b6c5d4e3f2a',
+      name: 'MacBook Pro (iCloud Keychain)',
+      userId: 'usr_alex_rivera_01',
+      createdAt: '2026-09-15T14:22:00.000Z',
+      lastUsedAt: '2026-10-31T19:45:10.000Z',
+      transports: ['internal', 'hybrid'],
+      authenticatorAttachment: 'platform',
+      backedUp: true,
+      backupEligible: true,
+      userVerified: true,
+      signCount: 14,
+      aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd',
+      providerName: 'iCloud Keychain',
+      publicKeyAlgorithm: -7,
+      rpId: 'localhost',
+    },
+  ],
+  [
+    'cred_yubikey_5_nfc_1a2b3c4d5e6f7a8b',
+    {
+      id: 'cred_yubikey_5_nfc_1a2b3c4d5e6f7a8b',
+      name: 'YubiKey 5C NFC (Backup Key)',
+      userId: 'usr_alex_rivera_01',
+      createdAt: '2026-10-02T09:10:00.000Z',
+      lastUsedAt: '2026-10-20T11:05:00.000Z',
+      transports: ['usb', 'nfc'],
+      authenticatorAttachment: 'cross-platform',
+      backedUp: false,
+      backupEligible: false,
+      userVerified: true,
+      signCount: 4,
+      aaguid: '2fc0579f-8113-47ea-b116-bb5a8db9202a',
+      providerName: 'YubiKey 5 Series',
+      publicKeyAlgorithm: -7,
+      rpId: 'localhost',
+    },
+  ],
+]);
+
+function generateChallengeBase64Url(): string {
+  return crypto.randomBytes(32).toString('base64url');
+}
+
+export const GET: APIRoute = async ({ url }) => {
+  const userId = url.searchParams.get('userId');
+  const items = Array.from(serverPasskeys.values()).filter(
+    (item) => !userId || item.userId === userId
+  );
+
+  return new Response(
+    JSON.stringify({
+      passkeys: items,
+      rpName: 'The DevTools Times',
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { action } = body;
+
+    if (action === 'register-options') {
+      const challenge = generateChallengeBase64Url();
+      serverChallenges.set(challenge, {
+        createdAt: Date.now(),
+        action: 'register',
+        userId: body.userId,
+      });
+
+      return new Response(
+        JSON.stringify({
+          challenge,
+          rp: {
+            name: 'The DevTools Times',
+          },
+          user: {
+            id: Buffer.from(String(body.userId || 'usr_default')).toString('base64url'),
+            name: body.username || 'reader',
+            displayName: body.displayName || body.username || 'DevTools Reader',
+          },
+          pubKeyCredParams: [
+            { alg: -7, type: 'public-key' },
+            { alg: -257, type: 'public-key' },
+            { alg: -8, type: 'public-key' },
+          ],
+          timeout: 60000,
+          attestation: 'none',
+          excludeCredentials: (body.excludeCredentialIds || []).map((id: string) => ({
+            id,
+            type: 'public-key',
+          })),
+          authenticatorSelection: {
+            residentKey: 'required',
+            userVerification: 'required',
+            ...(body.authenticatorAttachment
+              ? { authenticatorAttachment: body.authenticatorAttachment }
+              : {}),
+          },
+        }),
+        {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (action === 'register-verify') {
+      const { challenge, credential } = body;
+      if (challenge && serverChallenges.has(challenge)) {
+        serverChallenges.delete(challenge);
+      }
+      if (credential && credential.id) {
+        serverPasskeys.set(credential.id, credential);
+      }
+      return new Response(
+        JSON.stringify({
+          verified: true,
+          credential,
+        }),
+        {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (action === 'auth-options' || action === 'reauth-options') {
+      const challenge = generateChallengeBase64Url();
+      serverChallenges.set(challenge, {
+        createdAt: Date.now(),
+        action: action === 'reauth-options' ? 'reauth' : 'auth',
+      });
+
+      return new Response(
+        JSON.stringify({
+          challenge,
+          timeout: 60000,
+          userVerification: 'required',
+          allowCredentials: (body.allowCredentialIds || []).map((id: string) => ({
+            id,
+            type: 'public-key',
+          })),
+        }),
+        {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (action === 'auth-verify' || action === 'reauth-verify') {
+      const { challenge, credentialId, signCount } = body;
+      if (challenge && serverChallenges.has(challenge)) {
+        serverChallenges.delete(challenge);
+      }
+      const existing = credentialId ? serverPasskeys.get(credentialId) : undefined;
+      if (existing) {
+        serverPasskeys.set(credentialId, {
+          ...existing,
+          lastUsedAt: new Date().toISOString(),
+          signCount: typeof signCount === 'number' ? signCount : existing.signCount + 1,
+        });
+      }
+
+      return new Response(
+        JSON.stringify({
+          verified: true,
+          reauthenticated: action === 'reauth-verify',
+          sudoToken:
+            action === 'reauth-verify'
+              ? `sudo_${crypto.randomBytes(16).toString('hex')}`
+              : undefined,
+          expiresInSeconds: 300,
+        }),
+        {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    return new Response(JSON.stringify({ error: 'Unsupported passkey action' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    return new Response(
+      JSON.stringify({ error: error?.message || 'Passkey API error' }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
+
+export const PATCH: APIRoute = async ({ request }) => {
+  try {
+    const { credentialId, name } = await request.json();
+    if (!credentialId || !name) {
+      return new Response(JSON.stringify({ error: 'credentialId and name are required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+    const existing = serverPasskeys.get(credentialId);
+    if (existing) {
+      serverPasskeys.set(credentialId, { ...existing, name: String(name).trim() });
+    }
+    return new Response(
+      JSON.stringify({
+        updated: true,
+        credentialId,
+        name: String(name).trim(),
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (error: any) {
+    return new Response(JSON.stringify({ error: error?.message || 'Failed to rename passkey' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
+
+export const DELETE: APIRoute = async ({ request }) => {
+  try {
+    const { credentialId } = await request.json();
+    if (!credentialId) {
+      return new Response(JSON.stringify({ error: 'credentialId is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+    serverPasskeys.delete(credentialId);
+    return new Response(
+      JSON.stringify({
+        deleted: true,
+        credentialId,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (error: any) {
+    return new Response(JSON.stringify({ error: error?.message || 'Failed to delete passkey' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
