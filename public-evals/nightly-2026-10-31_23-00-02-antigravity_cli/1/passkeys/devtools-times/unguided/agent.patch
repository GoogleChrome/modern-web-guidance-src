+export async function signalPasskeyRemoved(credentialId: string, userId: string): Promise<void> {
+  const rpId = getRpId();
+  const pkAny = typeof window !== 'undefined' ? (window.PublicKeyCredential as any) : null;
+  if (!pkAny) return;
+
+  try {
+    if (typeof pkAny.signalUnknownCredential === 'function') {
+      await pkAny.signalUnknownCredential({
+        rpId,
+        credentialId,
+      });
+      appendCeremonyLog({
+        type: 'signal',
+        status: 'info',
+        summary: 'Sent PublicKeyCredential.signalUnknownCredential',
+        details: `Notified credential manager that passkey ${credentialId.slice(0, 12)}... was removed.`,
+      });
+    }
+    if (typeof pkAny.signalAllAcceptedCredentials === 'function') {
+      const remainingIds = getStoredPasskeys(userId).map((p) => p.id);
+      await pkAny.signalAllAcceptedCredentials({
+        rpId,
+        userId: bufferToBase64url(stringToBuffer(userId)),
+        allAcceptedCredentialIds: remainingIds,
+      });
+      appendCeremonyLog({
+        type: 'signal',
+        status: 'info',
+        summary: 'Sent PublicKeyCredential.signalAllAcceptedCredentials',
+        details: `Synced ${remainingIds.length} active credential(s) for user ${userId}.`,
+      });
+    }
+  } catch {
+    // Non-fatal if browser doesn't support Signal API
+  }
+}
+
+export async function signalUserDetailsUpdated(user: UserAccount): Promise<void> {
+  const rpId = getRpId();
+  const pkAny = typeof window !== 'undefined' ? (window.PublicKeyCredential as any) : null;
+  if (!pkAny || typeof pkAny.signalCurrentUserDetails !== 'function') return;
+
+  try {
+    await pkAny.signalCurrentUserDetails({
+      rpId,
+      userId: bufferToBase64url(stringToBuffer(user.id)),
+      name: user.username,
+      displayName: user.displayName,
+    });
+    appendCeremonyLog({
+      type: 'signal',
+      status: 'info',
+      summary: 'Sent PublicKeyCredential.signalCurrentUserDetails',
+      details: `Updated passkey provider user profile for ${user.username} (${user.displayName}).`,
+    });
+  } catch {
+    // Non-fatal
+  }
+}
