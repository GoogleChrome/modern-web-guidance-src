+export function getReauthRemainingSeconds(session: AuthSession | null): number {
+  if (!session || !session.reauthenticatedAt) return 0;
+  const remainingMs = REAUTH_TTL_MS - (Date.now() - new Date(session.reauthenticatedAt).getTime());
+  return Math.max(0, Math.ceil(remainingMs / 1000));
