+export function parseAuthenticatorData(authDataBuffer: ArrayBuffer): {
+  userPresent: boolean;
+  userVerified: boolean;
+  backupEligible: boolean;
+  backedUp: boolean;
+  signCount: number;
+  aaguid: string;
+} {
+  const view = new DataView(authDataBuffer);
+  if (authDataBuffer.byteLength < 37) {
+    return {
+      userPresent: true,
+      userVerified: true,
+      backupEligible: true,
+      backedUp: true,
+      signCount: 0,
+      aaguid: '00000000-0000-0000-0000-000000000000',
+    };
+  }
+  const flags = view.getUint8(32);
+  const userPresent = (flags & 0x01) !== 0;
+  const userVerified = (flags & 0x04) !== 0;
+  const backupEligible = (flags & 0x08) !== 0;
+  const backedUp = (flags & 0x10) !== 0;
+  const attestedCredentialDataIncluded = (flags & 0x40) !== 0;
+  const signCount = view.getUint32(33, false);
+
+  let aaguid = '00000000-0000-0000-0000-000000000000';
+  if (attestedCredentialDataIncluded && authDataBuffer.byteLength >= 53) {
+    const aaguidBytes = new Uint8Array(authDataBuffer, 37, 16);
+    const hex = Array.from(aaguidBytes)
+      .map((b) => b.toString(16).padStart(2, '0'))
+      .join('');
+    aaguid = `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`;
+  }
+
+  return {
+    userPresent,
+    userVerified,
+    backupEligible,
+    backedUp,
+    signCount,
+    aaguid,
+  };
+}
