+              <div>
+                <div className="text-xs font-bold text-amber-950">Step-Up Reauthentication</div>
+                <p className="text-[11px] text-amber-800">
+                  Verify your identity on demand with a passkey challenge (`userVerification: &quot;required&quot;`).
+                </p>
+              </div>
+              <button
+                type="button"
+                onClick={() => {
