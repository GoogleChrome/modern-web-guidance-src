+  const ua = navigator.userAgent || '';
+  if (attachment === 'cross-platform') {
+    return 'Hardware Security Key';
+  }
+  if (/Macintosh|Mac OS X/i.test(ua)) {
+    return 'MacBook Touch ID (iCloud Keychain)';
+  }
+  if (/iPhone|iPad|iPod/i.test(ua)) {
+    return 'iPhone / iPad (iCloud Keychain)';
+  }
+  if (/Android/i.test(ua)) {
+    return 'Android (Google Password Manager)';
+  }
+  if (/Windows/i.test(ua)) {
+    return 'Windows Hello Passkey';
+  }
+  if (/Linux/i.test(ua)) {
+    return 'Chrome on Linux Passkey';
+  }
+  return 'This Device Passkey';
+}
