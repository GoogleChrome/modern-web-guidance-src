+              >
+                Verify Now
+              </button>
+            </div>
+          </div>
+        </section>
+      </div>
+
+      {/* Section 3: WebAuthn Environment & Ceremony Activity Log */}
+      <section className="bg-white border border-gray-200 rounded-xl shadow-xs p-6 space-y-4">
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
+          <div>
+            <h2 className="text-base font-bold text-gray-900">
+              WebAuthn Client Capabilities &amp; Ceremony Log
+            </h2>
+            <p className="text-xs text-gray-500">
+              Real-time browser passkey capabilities and recent WebAuthn registration, authentication, and Signal API events.
+            </p>
+          </div>
+          {capabilities && (
+            <div className="flex flex-wrap gap-1.5 text-[11px]">
+              <span className="px-2 py-0.5 rounded bg-gray-100 text-gray-800 font-mono">
+                UVPAA: {String(capabilities.platformAuthenticatorAvailable)}
+              </span>
+              <span className="px-2 py-0.5 rounded bg-gray-100 text-gray-800 font-mono">
+                Conditional UI: {String(capabilities.conditionalMediationAvailable)}
+              </span>
+              <span className="px-2 py-0.5 rounded bg-gray-100 text-gray-800 font-mono">
+                Signal API: {String(capabilities.signalApiSupported)}
+              </span>
+            </div>
+          )}
+        </div>
+
+        {logs.length === 0 ? (
+          <p className="text-xs text-gray-500 py-3">
+            No WebAuthn ceremonies recorded in this session yet. Try testing, renaming, or adding a passkey above.
+          </p>
+        ) : (
+          <ul className="divide-y divide-gray-100 text-xs max-h-56 overflow-y-auto">
+            {logs.map((entry) => (
+              <li key={entry.id} className="py-2.5 flex items-start justify-between gap-4">
+                <div>
+                  <span
+                    className={`inline-block uppercase font-bold text-[10px] px-1.5 py-0.5 rounded mr-2 ${
+                      entry.status === 'success'
+                        ? 'bg-emerald-100 text-emerald-800'
+                        : entry.status === 'error'
+                        ? 'bg-red-100 text-red-800'
+                        : 'bg-blue-100 text-blue-800'
+                    }`}
+                  >
+                    {entry.type}
+                  </span>
+                  <span className="font-semibold text-gray-800">{entry.summary}</span>
+                  {entry.details && <p className="text-gray-500 mt-0.5">{entry.details}</p>}
+                </div>
+                <span className="text-gray-400 font-mono text-[11px] shrink-0">
+                  {new Date(entry.timestamp).toLocaleTimeString()}
+                </span>
+              </li>
+            ))}
+          </ul>
+        )}
+      </section>
+
+      <ReauthModal
+        isOpen={reauthModalOpen}
+        user={session.user}
+        actionDescription={reauthActionDescription}
+        onSuccess={handleReauthSuccess}
+        onClose={() => {
+          setReauthModalOpen(false);
+          setPendingAction(null);
+        }}
+      />
+    </div>
+  );
+}
