@@ -0,0 +1,296 @@
+import React, { useState, useEffect } from 'react';
+import {
+  authenticateWithPasskeyCeremony,
+  verifyPasswordAndReauth,
+  getStoredPasskeys,
+  type UserAccount,
+  type PasskeyCredential,
+} from '../utils/passkeys';
+
+interface ReauthModalProps {
+  isOpen: boolean;
+  user: UserAccount;
+  actionDescription: string;
+  onSuccess: (method: 'passkey' | 'password') => void;
+  onClose: () => void;
+}
+
+export default function ReauthModal({
+  isOpen,
+  user,
+  actionDescription,
+  onSuccess,
+  onClose,
+}: ReauthModalProps) {
+  const [mode, setMode] = useState<'passkey' | 'password'>('passkey');
+  const [selectedCredentialId, setSelectedCredentialId] = useState<string>('');
+  const [password, setPassword] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [showFallbackOption, setShowFallbackOption] = useState(false);
+  const [userPasskeys, setUserPasskeys] = useState<PasskeyCredential[]>([]);
+
+  useEffect(() => {
+    if (isOpen) {
+      const pks = getStoredPasskeys(user.id);
+      setUserPasskeys(pks);
+      setSelectedCredentialId('');
+      setError(null);
+      setPassword('');
+      setShowFallbackOption(false);
+      setMode('passkey');
+    }
+  }, [isOpen, user.id]);
+
+  useEffect(() => {
+    if (!isOpen) return;
+    const onKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') {
+        onClose();
+      }
+    };
+    window.addEventListener('keydown', onKeyDown);
+    return () => window.removeEventListener('keydown', onKeyDown);
+  }, [isOpen, onClose]);
+
+  if (!isOpen) return null;
+
+  const handlePasskeyReauth = async (allowFallback = false) => {
+    setLoading(true);
+    setError(null);
+    try {
+      await authenticateWithPasskeyCeremony({
+        username: user.username,
+        credentialId: selectedCredentialId || undefined,
+        isReauth: true,
+        allowFallbackOnCancel: allowFallback,
+      });
+      onSuccess('passkey');
+    } catch (err: any) {
+      setShowFallbackOption(true);
+      setError(
+        err?.name === 'NotAllowedError'
+          ? 'Passkey verification was cancelled or timed out. Try again or use a simulated passkey assertion below.'
+          : err?.message || 'Could not complete passkey reauthentication.'
+      );
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handlePasswordReauth = (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+    try {
+      const ok = verifyPasswordAndReauth(user.username, password);
+      if (!ok) {
+        setError('Invalid password. Enter at least 4 characters (demo password: devtools123).');
+        setLoading(false);
+        return;
+      }
+      onSuccess('password');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 bg-black/50 backdrop-blur-xs z-[99999] flex items-center justify-center p-4"
+      onClick={onClose}
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="reauth-modal-title"
+    >
+      <div
+        className="bg-white border border-gray-200 rounded-xl shadow-2xl max-w-md w-full overflow-hidden"
+        onClick={(e) => e.stopPropagation()}
+      >
+        {/* Header */}
+        <div className="bg-gray-900 text-white px-6 py-4 flex items-center justify-between">
+          <div className="flex items-center space-x-2.5">
+            <div className="p-1.5 rounded-lg bg-amber-500/20 text-amber-400">
+              <svg
+                xmlns="http://www.w3.org/2000/svg"
+                className="h-5 w-5"
+                fill="none"
+                viewBox="0 0 24 24"
+                stroke="currentColor"
+                strokeWidth={2}
+              >
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
+                />
+              </svg>
+            </div>
+            <div>
+              <h3 id="reauth-modal-title" className="text-base font-bold">
+                Reauthentication Required
+              </h3>
+              <p className="text-xs text-gray-300">Sudo protection • Verify your identity</p>
+            </div>
+          </div>
+          <button
+            type="button"
+            onClick={onClose}
+            className="text-gray-400 hover:text-white p-1 rounded-md transition-colors"
+            aria-label="Close reauthentication dialog"
+          >
+            <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+              <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+            </svg>
+          </button>
+        </div>
+
+        {/* Body */}
+        <div className="p-6 space-y-5">
+          <div className="bg-amber-50 border border-amber-200 rounded-lg p-3.5 text-xs text-amber-900">
+            <p className="font-semibold mb-0.5">Protected Action:</p>
+            <p>{actionDescription}</p>
+          </div>
+
+          <div className="flex items-center justify-between text-xs bg-gray-50 px-3 py-2 rounded-md border border-gray-200">
+            <span className="text-gray-500">Account</span>
+            <span className="font-semibold text-gray-800">
+              {user.displayName} ({user.username})
+            </span>
+          </div>
+
+          {/* Method switcher */}
+          {!user.passwordlessOnly && (
+            <div className="grid grid-cols-2 gap-1 p-1 bg-gray-100 rounded-lg text-xs font-medium">
+              <button
+                type="button"
+                onClick={() => {
+                  setMode('passkey');
+                  setError(null);
+                }}
+                className={`py-1.5 px-3 rounded-md transition-colors ${
+                  mode === 'passkey'
+                    ? 'bg-white text-gray-900 shadow-xs font-semibold'
+                    : 'text-gray-600 hover:text-gray-900'
+                }`}
+              >
+                Passkey (Recommended)
+              </button>
+              <button
+                type="button"
+                onClick={() => {
+                  setMode('password');
+                  setError(null);
+                }}
+                className={`py-1.5 px-3 rounded-md transition-colors ${
+                  mode === 'password'
+                    ? 'bg-white text-gray-900 shadow-xs font-semibold'
+                    : 'text-gray-600 hover:text-gray-900'
+                }`}
+              >
+                Password
+              </button>
+            </div>
+          )}
