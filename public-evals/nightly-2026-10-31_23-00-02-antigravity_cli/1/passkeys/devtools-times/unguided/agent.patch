+export async function detectWebAuthnCapabilities(): Promise<WebAuthnCapabilities> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) {
+    return {
+      webauthnSupported: false,
+      platformAuthenticatorAvailable: false,
+      conditionalMediationAvailable: false,
+      signalApiSupported: false,
+      clientCapabilities: {},
+    };
+  }
+
+  let platformAuthenticatorAvailable = false;
+  let conditionalMediationAvailable = false;
+  let clientCapabilities: Record<string, boolean> = {};
+
+  try {
+    if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+      platformAuthenticatorAvailable =
+        await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    }
+  } catch {
+    platformAuthenticatorAvailable = false;
+  }
+
+  try {
+    if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+      conditionalMediationAvailable =
+        await PublicKeyCredential.isConditionalMediationAvailable();
+    }
+  } catch {
+    conditionalMediationAvailable = false;
+  }
+
+  try {
+    const pkAny = PublicKeyCredential as any;
+    if (typeof pkAny.getClientCapabilities === 'function') {
+      clientCapabilities = await pkAny.getClientCapabilities();
+    }
+  } catch {
+    clientCapabilities = {};
+  }
+
+  const pkAny = PublicKeyCredential as any;
+  const signalApiSupported =
+    typeof pkAny.signalUnknownCredential === 'function' ||
+    typeof pkAny.signalAllAcceptedCredentials === 'function' ||
+    typeof pkAny.signalCurrentUserDetails === 'function';
+
+  return {
+    webauthnSupported: true,
+    platformAuthenticatorAvailable,
+    conditionalMediationAvailable,
+    signalApiSupported,
+    clientCapabilities,
+  };
+}
