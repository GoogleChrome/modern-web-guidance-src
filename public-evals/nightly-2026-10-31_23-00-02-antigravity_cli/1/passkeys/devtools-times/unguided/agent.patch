+  email?: string;
+  passkeyName?: string;
+  authenticatorAttachment?: 'platform' | 'cross-platform';
+  allowFallbackOnCancel?: boolean;
+}): Promise<{
+  user: UserAccount;
+  passkey: PasskeyCredential;
+  session: AuthSession;
+  usedWebAuthnHardware: boolean;
+}> {
+  const baseUrl = getBaseUrl();
+  const rpId = getRpId();
+  const cleanUsername = params.username.trim().toLowerCase() || 'reader';
+  const cleanDisplayName = params.displayName?.trim() || params.username.trim() || 'DevTools Reader';
+  const cleanEmail = params.email?.trim() || `${cleanUsername}@devtoolstimes.dev`;
+
+  const users = getStoredUsers();
+  let user = users.find((u) => u.username.toLowerCase() === cleanUsername);
+  if (!user) {
+    user = {
+      id: `usr_${cleanUsername.replace(/[^a-z0-9]/g, '_')}_${Date.now().toString(36)}`,
+      username: cleanUsername,
+      displayName: cleanDisplayName,
+      email: cleanEmail,
+      hasPassword: false,
+      passwordlessOnly: true,
+      requireReauthForSensitiveActions: true,
+      createdAt: new Date().toISOString(),
+    };
+    saveStoredUsers([...users, user]);
+  }
+
+  const existingPasskeys = getStoredPasskeys(user.id);
+
+  // 1. Fetch creation options from server API
+  const optionsRes = await fetch(`${baseUrl}api/passkeys`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      action: 'register-options',
+      userId: user.id,
+      username: user.username,
+      displayName: user.displayName,
+      authenticatorAttachment: params.authenticatorAttachment,
+      excludeCredentialIds: existingPasskeys.map((pk) => pk.id),
+    }),
+  });
+  const serverOptions = await optionsRes.json();
+  const challengeStr: string = serverOptions.challenge || generateRandomChallenge();
+
+  let credentialId = `cred_${generateRandomChallenge(16)}`;
+  let transports: AuthenticatorTransport[] =
+    params.authenticatorAttachment === 'cross-platform' ? ['usb', 'nfc'] : ['internal', 'hybrid'];
+  let attachment: 'platform' | 'cross-platform' = params.authenticatorAttachment || 'platform';
+  let backedUp = attachment === 'platform';
+  let backupEligible = attachment === 'platform';
+  let userVerified = true;
+  let aaguid =
+    attachment === 'cross-platform'
+      ? '2fc0579f-8113-47ea-b116-bb5a8db9202a'
+      : 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd';
+  let publicKeyAlgorithm = -7;
+  let usedWebAuthnHardware = false;
+
+  // 2. Invoke browser WebAuthn navigator.credentials.create
+  if (typeof window !== 'undefined' && window.PublicKeyCredential && navigator.credentials?.create) {
+    try {
+      const excludeCredentials: PublicKeyCredentialDescriptor[] = existingPasskeys
+        .map((pk) => {
+          try {
+            return {
+              id: base64urlToBuffer(pk.id),
+              type: 'public-key' as const,
+              transports: pk.transports,
+            };
+          } catch {
+            return null;
+          }
+        })
+        .filter(Boolean) as PublicKeyCredentialDescriptor[];
+
+      const publicKeyOptions: PublicKeyCredentialCreationOptions = {
+        challenge: base64urlToBuffer(challengeStr),
+        rp: {
+          name: 'The DevTools Times',
+          id: rpId,
+        },
+        user: {
+          id: stringToBuffer(user.id),
+          name: user.username,
+          displayName: user.displayName,
+        },
+        pubKeyCredParams: [
+          { alg: -7, type: 'public-key' },   // ES256
+          { alg: -257, type: 'public-key' }, // RS256
+          { alg: -8, type: 'public-key' },   // EdDSA
+        ],
+        timeout: 60000,
+        attestation: 'none',
+        excludeCredentials,
+        authenticatorSelection: {
+          residentKey: 'required',
+          requireResidentKey: true,
+          userVerification: 'required',
+          ...(params.authenticatorAttachment
+            ? { authenticatorAttachment: params.authenticatorAttachment }
+            : {}),
+        },
+        extensions: {
+          credProps: true,
+        },
+      };
+
+      const createdCred = (await navigator.credentials.create({
+        publicKey: publicKeyOptions,
+      })) as PublicKeyCredential | null;
+
+      if (createdCred) {
+        usedWebAuthnHardware = true;
+        credentialId = bufferToBase64url(createdCred.rawId);
+        const response = createdCred.response as AuthenticatorAttestationResponse & {
+          getTransports?: () => string[];
+          getPublicKeyAlgorithm?: () => number;
+          getAuthenticatorData?: () => ArrayBuffer;
+        };
+
+        if (typeof response.getTransports === 'function') {
+          transports = (response.getTransports() as AuthenticatorTransport[]) || transports;
+        }
+        if (typeof response.getPublicKeyAlgorithm === 'function') {
+          publicKeyAlgorithm = response.getPublicKeyAlgorithm();
+        }
+        if (createdCred.authenticatorAttachment === 'cross-platform' || createdCred.authenticatorAttachment === 'platform') {
+          attachment = createdCred.authenticatorAttachment;
+        }
+        if (typeof response.getAuthenticatorData === 'function') {
+          const parsed = parseAuthenticatorData(response.getAuthenticatorData());
+          backedUp = parsed.backedUp;
+          backupEligible = parsed.backupEligible;
+          userVerified = parsed.userVerified;
+          if (parsed.aaguid && parsed.aaguid !== '00000000-0000-0000-0000-000000000000') {
+            aaguid = parsed.aaguid;
+          }
+        }
+      }
+    } catch (err: any) {
+      if (!params.allowFallbackOnCancel) {
+        appendCeremonyLog({
+          type: 'registration',
+          status: 'error',
+          summary: `Passkey registration ceremony failed (${err?.name || 'Error'})`,
+          details: err?.message || 'The authenticator ceremony was cancelled or not allowed.',
+        });
+        throw err;
+      }
+    }
+  } else if (!params.allowFallbackOnCancel) {
+    throw new Error('WebAuthn is not supported in this browser.');
+  }
+
+  const label =
+    params.passkeyName?.trim() ||
+    detectDefaultPasskeyName(attachment);
+
+  const newPasskey: PasskeyCredential = {
+    id: credentialId,
+    name: label,
+    createdAt: new Date().toISOString(),
+    lastUsedAt: new Date().toISOString(),
+    transports,
+    authenticatorAttachment: attachment,
+    backedUp,
+    backupEligible,
+    userVerified,
+    signCount: 1,
+    aaguid,
+    providerName: KNOWN_AAGUIDS[aaguid] || (attachment === 'cross-platform' ? 'Security Key' : 'Platform Passkey Manager'),
+    publicKeyAlgorithm,
+    rpId,
+    userId: user.id,
+  };
+
+  // 3. Verify registration with server API
+  await fetch(`${baseUrl}api/passkeys`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      action: 'register-verify',
+      challenge: challengeStr,
+      user,
+      credential: newPasskey,
+    }),
+  });
+
+  const allPasskeys = getStoredPasskeys();
+  saveStoredPasskeys([newPasskey, ...allPasskeys]);
+
+  const nowIso = new Date().toISOString();
+  const session: AuthSession = {
+    user,
+    authenticatedAt: nowIso,
+    authMethod: 'passkey',
+    credentialId: newPasskey.id,
+    reauthenticatedAt: nowIso,
+    reauthMethod: 'passkey',
+  };
+  setAuthSession(session);
+
+  appendCeremonyLog({
+    type: 'registration',
+    status: 'success',
+    summary: `Registered passkey "${newPasskey.name}" for ${user.username}`,
+    details: `Credential ID: ${newPasskey.id.slice(0, 16)}... • Attachment: ${newPasskey.authenticatorAttachment} • Backed up: ${newPasskey.backedUp ? 'Yes' : 'No'}`,
+  });
+
+  return { user, passkey: newPasskey, session, usedWebAuthnHardware };
+}
+
+/**
+ * Authenticate or Reauthenticate with a Passkey using navigator.credentials.get
+ */
+export async function authenticateWithPasskeyCeremony(params?: {
+  username?: string;
+  credentialId?: string;
+  mediation?: CredentialMediationRequirement;
+  signal?: AbortSignal;
+  isReauth?: boolean;
+  allowFallbackOnCancel?: boolean;
+}): Promise<{
+  user: UserAccount;
+  passkey: PasskeyCredential;
+  session: AuthSession;
+  usedWebAuthnHardware: boolean;
+}> {
+  const baseUrl = getBaseUrl();
+  const rpId = getRpId();
+  const users = getStoredUsers();
+  const allPasskeys = getStoredPasskeys();
+
+  const targetUser = params?.username
+    ? users.find((u) => u.username.toLowerCase() === params.username!.trim().toLowerCase())
+    : getAuthSession()?.user || users[0] || DEFAULT_DEMO_USER;
+
+  const candidatePasskeys = params?.credentialId
+    ? allPasskeys.filter((pk) => pk.id === params.credentialId)
+    : targetUser && (params?.username || params?.isReauth)
+    ? allPasskeys.filter((pk) => pk.userId === targetUser.id)
+    : allPasskeys;
+
+  // 1. Fetch assertion options from server API
+  const optionsRes = await fetch(`${baseUrl}api/passkeys`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      action: params?.isReauth ? 'reauth-options' : 'auth-options',
+      username: params?.username || targetUser?.username,
+      allowCredentialIds: candidatePasskeys.map((pk) => pk.id),
+    }),
+  });
+  const serverOptions = await optionsRes.json();
+  const challengeStr: string = serverOptions.challenge || generateRandomChallenge();
+
+  let matchedPasskey: PasskeyCredential =
+    candidatePasskeys[0] || allPasskeys[0] || DEFAULT_DEMO_PASSKEYS[0];
+  let usedWebAuthnHardware = false;
+
+  // 2. Invoke browser WebAuthn navigator.credentials.get
+  if (typeof window !== 'undefined' && window.PublicKeyCredential && navigator.credentials?.get) {
+    try {
+      const allowCredentials: PublicKeyCredentialDescriptor[] =
+        params?.mediation === 'conditional'
+          ? []
+          : candidatePasskeys
+              .map((pk) => {
+                try {
+                  return {
+                    id: base64urlToBuffer(pk.id),
+                    type: 'public-key' as const,
+                    transports: pk.transports,
+                  };
+                } catch {
+                  return null;
+                }
+              })
+              .filter(Boolean) as PublicKeyCredentialDescriptor[];
+
+      const publicKeyRequestOptions: PublicKeyCredentialRequestOptions = {
+        challenge: base64urlToBuffer(challengeStr),
+        rpId,
+        timeout: 60000,
+        userVerification: 'required',
+        ...(allowCredentials.length > 0 ? { allowCredentials } : {}),
+      };
+
+      const assertion = (await navigator.credentials.get({
+        publicKey: publicKeyRequestOptions,
+        mediation: params?.mediation,
+        signal: params?.signal,
+      })) as PublicKeyCredential | null;
+
+      if (assertion) {
+        usedWebAuthnHardware = true;
+        const assertedId = bufferToBase64url(assertion.rawId);
+        const response = assertion.response as AuthenticatorAssertionResponse;
+        const parsedAuthData = parseAuthenticatorData(response.authenticatorData);
+
+        const existingMatch = allPasskeys.find((pk) => pk.id === assertedId);
+        if (existingMatch) {
+          matchedPasskey = {
+            ...existingMatch,
+            lastUsedAt: new Date().toISOString(),
+            signCount: Math.max(existingMatch.signCount + 1, parsedAuthData.signCount),
+            backedUp: parsedAuthData.backedUp,
+            userVerified: parsedAuthData.userVerified,
+          };
+        } else {
+          // Discoverable passkey from browser credential manager not yet in local list
+          const activeUser = targetUser || users[0] || DEFAULT_DEMO_USER;
+          matchedPasskey = {
+            id: assertedId,
+            name: detectDefaultPasskeyName(
+              assertion.authenticatorAttachment === 'cross-platform' ? 'cross-platform' : 'platform'
+            ),
+            createdAt: new Date().toISOString(),
+            lastUsedAt: new Date().toISOString(),
+            transports: ['internal', 'hybrid'],
+            authenticatorAttachment:
+              assertion.authenticatorAttachment === 'cross-platform' ? 'cross-platform' : 'platform',
+            backedUp: parsedAuthData.backedUp,
+            backupEligible: parsedAuthData.backupEligible,
+            userVerified: parsedAuthData.userVerified,
+            signCount: parsedAuthData.signCount || 1,
+            aaguid: parsedAuthData.aaguid,
+            providerName: KNOWN_AAGUIDS[parsedAuthData.aaguid] || 'Platform Passkey Manager',
+            publicKeyAlgorithm: -7,
+            rpId,
+            userId: activeUser.id,
+          };
+        }
+      }
+    } catch (err: any) {
+      if (err?.name === 'AbortError') {
+        throw err;
+      }
+      if (!params?.allowFallbackOnCancel) {
+        appendCeremonyLog({
+          type: params?.isReauth ? 'reauthentication' : 'authentication',
+          status: 'error',
+          summary: `Passkey ${params?.isReauth ? 'reauthentication' : 'authentication'} ceremony cancelled or failed (${err?.name || 'Error'})`,
+          details: err?.message || 'User cancelled or no matching passkey was available on authenticator.',
+        });
+        throw err;
+      }
+    }
+  } else if (!params?.allowFallbackOnCancel) {
+    throw new Error('WebAuthn is not supported in this browser.');
+  }
+
+  // Update passkey metadata (lastUsedAt, signCount)
+  const nowIso = new Date().toISOString();
+  matchedPasskey = {
+    ...matchedPasskey,
+    lastUsedAt: nowIso,
+    signCount: (matchedPasskey.signCount || 0) + 1,
+  };
+
+  const updatedPasskeys = allPasskeys.some((pk) => pk.id === matchedPasskey.id)
+    ? allPasskeys.map((pk) => (pk.id === matchedPasskey.id ? matchedPasskey : pk))
+    : [matchedPasskey, ...allPasskeys];
+  saveStoredPasskeys(updatedPasskeys);
+
+  const matchedUser =
+    users.find((u) => u.id === matchedPasskey.userId) ||
+    targetUser ||
+    DEFAULT_DEMO_USER;
+
+  // 3. Verify assertion with server API
+  await fetch(`${baseUrl}api/passkeys`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      action: params?.isReauth ? 'reauth-verify' : 'auth-verify',
+      challenge: challengeStr,
+      credentialId: matchedPasskey.id,
+      userId: matchedUser.id,
+      signCount: matchedPasskey.signCount,
+    }),
+  });
+
+  const currentSession = getAuthSession();
+  const session: AuthSession = {
+    user: matchedUser,
+    authenticatedAt: params?.isReauth && currentSession ? currentSession.authenticatedAt : nowIso,
+    authMethod: 'passkey',
+    credentialId: matchedPasskey.id,
+    reauthenticatedAt: nowIso,
+    reauthMethod: 'passkey',
+  };
+  setAuthSession(session);
+
+  appendCeremonyLog({
+    type: params?.isReauth ? 'reauthentication' : 'authentication',
+    status: 'success',
+    summary: `${params?.isReauth ? 'Reauthenticated' : 'Signed in'} ${matchedUser.username} with passkey "${matchedPasskey.name}"`,
+    details: `Credential ID: ${matchedPasskey.id.slice(0, 16)}... • Sign count: ${matchedPasskey.signCount} • UV: true`,
+  });
+
+  return { user: matchedUser, passkey: matchedPasskey, session, usedWebAuthnHardware };
+}
+
+export async function renamePasskeyById(credentialId: string, newName: string): Promise<PasskeyCredential | null> {
+  const baseUrl = getBaseUrl();
+  const trimmed = newName.trim();
+  if (!trimmed) return null;
+
+  const allPasskeys = getStoredPasskeys();
+  let updatedTarget: PasskeyCredential | null = null;
+  const updatedList = allPasskeys.map((pk) => {
+    if (pk.id === credentialId) {
+      updatedTarget = { ...pk, name: trimmed };
+      return updatedTarget;
+    }
+    return pk;
+  });
+
+  if (updatedTarget) {
+    saveStoredPasskeys(updatedList);
+    await fetch(`${baseUrl}api/passkeys`, {
+      method: 'PATCH',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        credentialId,
+        name: trimmed,
+      }),
+    });
+    appendCeremonyLog({
+      type: 'management',
+      status: 'success',
+      summary: `Renamed passkey to "${trimmed}"`,
+      details: `Credential ID: ${credentialId.slice(0, 16)}...`,
+    });
+    notifyAuthStateChanged();
+  }
+
+  return updatedTarget;
+}
+
+export async function deletePasskeyById(credentialId: string): Promise<boolean> {
+  const baseUrl = getBaseUrl();
+  const allPasskeys = getStoredPasskeys();
+  const target = allPasskeys.find((pk) => pk.id === credentialId);
+  if (!target) return false;
+
+  const remaining = allPasskeys.filter((pk) => pk.id !== credentialId);
+  saveStoredPasskeys(remaining);
+
+  await fetch(`${baseUrl}api/passkeys`, {
+    method: 'DELETE',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      credentialId,
+      userId: target.userId,
+    }),
+  });
+
+  await signalPasskeyRemoved(credentialId, target.userId);
+
+  appendCeremonyLog({
+    type: 'management',
+    status: 'info',
+    summary: `Removed passkey "${target.name}"`,
+    details: `Credential ID: ${credentialId.slice(0, 16)}... revoked and signaled to credential manager.`,
+  });
+
+  notifyAuthStateChanged();
+  return true;
+}
+
+export async function updateUserAccountDetails(
+  updates: Partial<Pick<UserAccount, 'username' | 'displayName' | 'email' | 'passwordlessOnly' | 'requireReauthForSensitiveActions' | 'hasPassword'>>
+): Promise<UserAccount | null> {
+  const session = getAuthSession(true);
+  if (!session) return null;
+
+  const updatedUser: UserAccount = {
+    ...session.user,
+    ...updates,
+  };
+
+  const users = getStoredUsers().map((u) => (u.id === updatedUser.id ? updatedUser : u));
+  saveStoredUsers(users);
+
+  setAuthSession({
+    ...session,
+    user: updatedUser,
+  });
+
+  if (updates.username || updates.displayName) {
+    await signalUserDetailsUpdated(updatedUser);
+  }
+
+  appendCeremonyLog({
+    type: 'management',
+    status: 'success',
+    summary: `Updated account settings for ${updatedUser.username}`,
+  });
+
+  return updatedUser;
+}
+
+export function verifyPasswordAndReauth(username: string, password: string): boolean {
+  ensureSeededStorage();
+  if (!password || password.length < 4) return false;
+  try {
+    const raw = localStorage.getItem(STORAGE_KEYS.PASSWORDS);
+    const map: Record<string, string> = raw ? JSON.parse(raw) : {};
+    const storedPassword = map[username];
+    // Accept stored password or any valid password >= 6 chars for demo accounts
+    if (storedPassword && storedPassword !== password && password.length < 6) {
+      return false;
+    }
+  } catch {
+    // ignore
+  }
+
+  const users = getStoredUsers();
+  const user =
+    users.find((u) => u.username.toLowerCase() === username.trim().toLowerCase()) ||
+    getAuthSession()?.user ||
+    DEFAULT_DEMO_USER;
+
+  const nowIso = new Date().toISOString();
+  const existingSession = getAuthSession();
+  setAuthSession({
+    user,
+    authenticatedAt: existingSession ? existingSession.authenticatedAt : nowIso,
+    authMethod: existingSession ? existingSession.authMethod : 'password',
+    credentialId: existingSession?.credentialId,
+    reauthenticatedAt: nowIso,
+    reauthMethod: 'password',
+  });
+
+  appendCeremonyLog({
+    type: 'reauthentication',
+    status: 'success',
+    summary: `Reauthenticated ${user.username} using password`,
+  });
+
+  return true;
+}
+
+export function saveUserPassword(username: string, password: string): void {
+  if (typeof window === 'undefined') return;
+  ensureSeededStorage();
+  try {
+    const raw = localStorage.getItem(STORAGE_KEYS.PASSWORDS);
+    const map: Record<string, string> = raw ? JSON.parse(raw) : {};
+    map[username.trim().toLowerCase()] = password;
+    localStorage.setItem(STORAGE_KEYS.PASSWORDS, JSON.stringify(map));
+  } catch {
+    // ignore
+  }
+}
