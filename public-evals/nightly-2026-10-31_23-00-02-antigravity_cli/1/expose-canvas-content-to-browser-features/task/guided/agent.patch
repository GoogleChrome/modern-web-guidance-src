+  <script>
+    const canvas = document.getElementById("canvas");
+    const canvasWrapper = document.getElementById("canvas-wrapper");
+    const ctx = canvas.getContext("2d");
+    const uiElement = document.getElementById("ui-element");
+    const nameInput = document.getElementById("customer-name");
+    const milkSelect = document.getElementById("milk-select");
+    const syrupSelect = document.getElementById("syrup-select");
+    const orderPreview = document.getElementById("order-preview");
+    const orderStatus = document.getElementById("order-status");
+
+    const milkPalette = {
+      "Oat Milk": "#e6ccb2",
+      "Whole Milk": "#f5ebe0",
+      "Almond Milk": "#ddb892",
+      "Soy Milk": "#ede0d4",
+      "Coconut Milk": "#faf3dd"
+    };
+
+    const syrupPalette = {
+      "Vermont Maple": "#b05b27",
+      "Vanilla Bean": "#f3d59b",
+      "Salted Caramel": "#d4882a",
+      "Toasted Hazelnut": "#7f4f24",
+      "No Syrup": "#4e342e"
+    };
+
+    function updateOrderSummaryText() {
+      const customerName = nameInput.value.trim() || "Guest";
+      const milk = milkSelect.value;
+      const syrup = syrupSelect.value;
+      orderPreview.textContent = `Cup for ${customerName}: ${milk} + ${syrup}`;
+    }
+
+    function drawCoffeeCup(context, width, height) {
+      const centerX = width / 2;
+      const dpr = window.devicePixelRatio || 1;
+      const scale = Math.min(width / 720, height / 520) || dpr;
+
+      // Subtle warm backdrop
+      const bgGradient = context.createLinearGradient(0, 0, 0, height);
+      bgGradient.addColorStop(0, "#fdfbf9");
+      bgGradient.addColorStop(1, "#efe8e2");
+      context.fillStyle = bgGradient;
+      context.fillRect(0, 0, width, height);
+
+      // Soft shadow beneath the cup
+      context.save();
+      context.fillStyle = "rgba(62, 39, 35, 0.14)";
+      context.beginPath();
+      context.ellipse(centerX, height - 24 * scale, 135 * scale, 16 * scale, 0, 0, Math.PI * 2);
+      context.fill();
+      context.restore();
+
+      // Steam wisps above the lid
+      context.save();
+      context.strokeStyle = "rgba(141, 110, 99, 0.35)";
+      context.lineWidth = 3 * scale;
+      context.lineCap = "round";
+      [-45, 0, 45].forEach((offset, idx) => {
+        const startX = centerX + offset * scale;
+        const startY = 44 * scale;
+        context.beginPath();
+        context.moveTo(startX, startY);
+        context.bezierCurveTo(
+          startX - 14 * scale,
+          startY - 14 * scale,
+          startX + 14 * scale,
+          startY - 26 * scale,
+          startX + (idx - 1) * 6 * scale,
+          startY - 38 * scale
+        );
+        context.stroke();
+      });
+      context.restore();
+
+      // Coffee cup body (trapezoid)
+      const topY = 82 * scale;
+      const bottomY = height - 28 * scale;
+      const topHalfWidth = 195 * scale;
+      const bottomHalfWidth = 145 * scale;
+
+      context.save();
+      context.beginPath();
+      context.moveTo(centerX - topHalfWidth, topY);
+      context.lineTo(centerX + topHalfWidth, topY);
+      context.lineTo(centerX + bottomHalfWidth, bottomY);
+      context.lineTo(centerX - bottomHalfWidth, bottomY);
+      context.closePath();
+
+      const cupGrad = context.createLinearGradient(centerX - topHalfWidth, topY, centerX + topHalfWidth, bottomY);
+      cupGrad.addColorStop(0, "#fffdf9");
+      cupGrad.addColorStop(0.5, milkPalette[milkSelect.value] || "#f5ebe0");
+      cupGrad.addColorStop(1, "#d7ccc8");
+      context.fillStyle = cupGrad;
+      context.fill();
+      context.lineWidth = 3 * scale;
+      context.strokeStyle = "#4e342e";
+      context.stroke();
+      context.restore();
+
+      // Syrup accent band near the top of the cup
+      context.save();
+      context.fillStyle = syrupPalette[syrupSelect.value] || "#ffab40";
+      context.beginPath();
+      context.moveTo(centerX - (topHalfWidth - 5 * scale), topY + 18 * scale);
+      context.lineTo(centerX + (topHalfWidth - 5 * scale), topY + 18 * scale);
+      context.lineTo(centerX + (topHalfWidth - 9 * scale), topY + 34 * scale);
+      context.lineTo(centerX - (topHalfWidth - 9 * scale), topY + 34 * scale);
+      context.closePath();
+      context.fill();
+      context.restore();
+
+      // Kraft cardboard sleeve behind the interactive HTML label
+      const sleeveTopY = topY + 46 * scale;
+      const sleeveBottomY = bottomY - 34 * scale;
+      const sleeveTopHalfW = 182 * scale;
+      const sleeveBottomHalfW = 154 * scale;
+
+      context.save();
+      context.beginPath();
+      context.moveTo(centerX - sleeveTopHalfW, sleeveTopY);
+      context.lineTo(centerX + sleeveTopHalfW, sleeveTopY);
+      context.lineTo(centerX + sleeveBottomHalfW, sleeveBottomY);
+      context.lineTo(centerX - sleeveBottomHalfW, sleeveBottomY);
+      context.closePath();
+      context.fillStyle = "#c89f7c";
+      context.fill();
+      context.lineWidth = 2.5 * scale;
+      context.strokeStyle = "#5d4037";
+      context.stroke();
+      context.restore();
+
+      // Coffee cup lid
+      context.save();
+      context.fillStyle = "#4e342e";
+      context.beginPath();
+      context.roundRect(centerX - 210 * scale, topY - 22 * scale, 420 * scale, 26 * scale, 8 * scale);
+      context.fill();
+
+      context.fillStyle = "#3e2723";
+      context.beginPath();
+      context.roundRect(centerX - 180 * scale, topY - 38 * scale, 360 * scale, 18 * scale, [10 * scale, 10 * scale, 0, 0]);
+      context.fill();
+      context.restore();
+    }
+
+    // Check browser support for the HTML-in-Canvas API before using it
+    if ('content' in HTMLCanvasElement.prototype) {
+      canvas.onpaint = () => {
+        ctx.reset();
+        drawCoffeeCup(ctx, canvas.width, canvas.height);
+
+        const labelX = Math.max(0, Math.round((canvas.width - uiElement.offsetWidth) / 2));
+        const labelY = Math.max(0, Math.round((canvas.height - uiElement.offsetHeight) / 2 + 12));
+
+        // Draw the drawable HTML element onto the coffee cup sleeve;
+        // in 2D context, drawElementImage automatically syncs DOM hit-test bounds and accessibility geometry.
+        ctx.drawElementImage(uiElement, labelX, labelY);
+      };
+    } else {
+      // Fallback strategy: place the interactive HTML content on top of the canvas using CSS
+      canvasWrapper.classList.add("fallback-mode");
+      drawCoffeeCup(ctx, canvas.width, canvas.height);
+    }
+
+    function requestCanvasUpdate() {
+      updateOrderSummaryText();
+      if ('content' in HTMLCanvasElement.prototype) {
+        canvas.requestPaint();
+      } else {
+        drawCoffeeCup(ctx, canvas.width, canvas.height);
+      }
+    }
+
+    // Scale canvas grid to match the device scale factor to prevent blurriness
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+
+      if ('content' in HTMLCanvasElement.prototype) {
+        canvas.requestPaint();
+      } else {
+        drawCoffeeCup(ctx, canvas.width, canvas.height);
+      }
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== "undefined" &&
+      "devicePixelContentBoxSize" in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: "device-pixel-content-box" }
+      : {};
+    observer.observe(canvas, options);
+
+    nameInput.addEventListener("input", requestCanvasUpdate);
+    milkSelect.addEventListener("change", requestCanvasUpdate);
+    syrupSelect.addEventListener("change", requestCanvasUpdate);
+
+    uiElement.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const customerName = nameInput.value.trim() || "Guest";
+      orderStatus.textContent = `Order queued for ${customerName} (${milkSelect.value}, ${syrupSelect.value})!`;
+      requestCanvasUpdate();
+    });
+  </script>
+
 </body>
 
