     .btn:hover {
       background: #3e2723;
     }
 
+    /* Featured Promo Badge */
+    .seasonal-header {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 12px;
+      margin-bottom: 10px;
+    }
+
+    .target {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      width: 84px;
+      height: 84px;
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      font-weight: bold;
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      text-align: center;
+      padding: 8px;
+      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
+      cursor: pointer;
+
+      /* MANDATORY: Apply identity transformations to establish a stable stacking context without will-change */
+      translate: 0px;
+      rotate: 0deg;
+      scale: 1;
+
+      /* Concurrent animations using individual transform properties */
+      animation:
+        badge-spin 8s linear infinite,
+        badge-slide 3s ease-in-out infinite alternate;
+
+      /* Transition only the scale property so animations continue uninterrupted on hover */
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover {
+      scale: 1.25;
+    }
+
+    @keyframes badge-spin {
+      from {
+        rotate: 0deg;
+      }
+      to {
+        rotate: 360deg;
+      }
+    }
+
+    @keyframes badge-slide {
+      from {
+        translate: -30px 0;
+      }
+      to {
+        translate: 30px 0;
+      }
+    }
+
