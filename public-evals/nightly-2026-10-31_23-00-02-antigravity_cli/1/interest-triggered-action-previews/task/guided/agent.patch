+  <script type="module">
+    const previewBox = document.getElementById("seasonal-preview");
+
+    previewBox.addEventListener("interest", (event) => {
+      const drinkName = event.source?.dataset.drink;
+      const drinkColor = event.source?.dataset.color;
+      if (drinkName) {
+        previewBox.textContent = drinkName;
+        previewBox.dataset.preview = drinkName;
+      }
+      if (drinkColor) {
+        previewBox.style.color = drinkColor;
+      }
+    });
+
+    previewBox.addEventListener("loseinterest", () => {
+      previewBox.textContent = previewBox.dataset.defaultText || "Select a drink to preview";
+      delete previewBox.dataset.preview;
+      previewBox.style.removeProperty("color");
+    });
+
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+  </script>
