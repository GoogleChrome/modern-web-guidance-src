+  <script>
+    const toggleBtn = document.getElementById('toggle-spacious');
+    const targetContainer = document.getElementById('target-container');
+
+    toggleBtn.addEventListener('click', () => {
+      const currentDensity = getComputedStyle(targetContainer).getPropertyValue('--density').trim();
+      const nextDensity = currentDensity === 'spacious' ? 'compact' : 'spacious';
+      targetContainer.style.setProperty('--density', nextDensity);
+      toggleBtn.setAttribute('aria-pressed', String(nextDensity === 'spacious'));
+    });
+  </script>
