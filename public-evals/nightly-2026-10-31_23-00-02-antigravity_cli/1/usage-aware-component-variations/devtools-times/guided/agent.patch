+}
+
+:where(.spotlight) .teaser-title {
+  font-size: var(--text-2xl);
+}
+
+:where(.spotlight) .teaser-summary {
+  display: none;
+}
+
+:where(.spotlight) .bookmark-button {
+  background: var(--color-brand-tint);
+  color: var(--color-brand-accent);
+  border-color: transparent;
+}
+
+/* Brief surface fallback */
+:where(.brief) .article-teaser {
+  padding: var(--space-lg);
+  box-shadow: var(--shadow-card);
+}
+
+:where(.brief) .teaser-media {
+  display: none;
+}
+
+:where(.brief) .teaser-content {
+  margin-block-start: 0;
+}
+
+:where(.brief) .teaser-title {
+  font-size: var(--text-2xl);
+}
+
+/* Ticker surface fallback */
+:where(.ticker) .article-teaser {
+  background: transparent;
+}
+
+:where(.ticker) .teaser-media,
+:where(.ticker) .teaser-meta-header,
+:where(.ticker) .teaser-summary,
+:where(.ticker) .teaser-footer {
+  display: none;
+}
+
+:where(.ticker) .teaser-content {
+  margin-block-start: 0;
+}
+
+:where(.ticker) .teaser-title {
+  font-family: inherit;
+  font-size: var(--text-base);
+  font-weight: 700;
+}
+
+:where(.ticker) .teaser-date {
+  display: block;
+}
+
+/* 4. Progressive Enhancement: Container Style Queries */
+
+@container style(--surface: featured) {
+  .article-teaser {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
+    gap: var(--space-xl);
+    padding: var(--space-xl);
+    box-shadow: var(--shadow-card);
+    align-items: center;
+  }
+
+  .teaser-content {
+    margin-block-start: 0;
+    order: 1;
+  }
+
+  .teaser-media {
+    order: 2;
+  }
+
+  .teaser-image {
+    border-radius: 0;
+    block-size: 100%;
+  }
+
+  .teaser-badge {
+    display: inline-flex;
+  }
+
+  .teaser-title {
+    font-size: var(--text-hero);
+    margin-block-start: var(--space-xs);
+  }
+
+  .teaser-summary {
+    font-size: var(--text-lg);
+    margin-block-start: var(--space-md);
+  }
+
+  .teaser-footer {
+    margin-block-start: var(--space-lg);
+  }
+
+  .bookmark-button {
+    background: var(--color-brand-accent);
+    color: var(--color-surface);
+    border-color: transparent;
+  }
+
+  .bookmark-button:hover:not(:disabled) {
+    background: var(--color-brand-accent-hover);
+    color: var(--color-surface);
+  }
+
+  .bookmark-label {
+    display: inline;
+  }
+}
+
+@container style(--surface: spotlight) {
+  .article-teaser {
+    box-shadow: var(--shadow-card);
+    background: var(--color-surface-subtle);
+    overflow: hidden;
+  }
+
+  .teaser-image {
+    border-radius: 0;
+  }
+
+  .teaser-content {
+    padding: var(--space-lg);
+    margin-block-start: 0;
+  }
+
+  .teaser-badge {
+    display: inline-flex;
+    background: var(--color-brand-tint);
+    color: var(--color-brand-accent);
+  }
+
+  .teaser-title {
+    font-size: var(--text-2xl);
+  }
+
+  .teaser-summary {
+    display: none;
+  }
+
+  .bookmark-button {
+    background: var(--color-brand-tint);
+    color: var(--color-brand-accent);
+    border-color: transparent;
+  }
+}
+
+@container style(--surface: brief) {
+  .article-teaser {
+    padding: var(--space-lg);
+    box-shadow: var(--shadow-card);
+  }
+
+  .teaser-media {
+    display: none;
+  }
+
+  .teaser-content {
+    margin-block-start: 0;
+  }
+
+  .teaser-title {
+    font-size: var(--text-2xl);
+  }
+}
+
+@container style(--surface: ticker) {
+  .article-teaser {
+    background: transparent;
+  }
+
+  .teaser-media,
+  .teaser-meta-header,
+  .teaser-summary,
+  .teaser-footer {
+    display: none;
+  }
+
+  .teaser-content {
+    margin-block-start: 0;
+  }
+
+  .teaser-title {
+    font-family: inherit;
+    font-size: var(--text-base);
+    font-weight: 700;
+  }
+
+  .teaser-date {
+    display: block;
+  }
+}
+
+.ticker-item:not(:first-child) {
+  border-inline-start: 1px solid var(--color-border-strong);
+  padding-inline-start: var(--space-md);
+}
