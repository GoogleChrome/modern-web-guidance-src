+}
+
+/* 1. Semantic Context Containers (no container-type needed for style queries) */
+.featured {
+  --surface: featured;
+}
+
+.spotlight {
+  --surface: spotlight;
+}
+
+.brief {
+  --surface: brief;
+}
+
+.ticker {
+  --surface: ticker;
+}
+
+/* 2. Default Component Styles */
+.article-teaser {
+  display: flex;
+  flex-direction: column;
+  block-size: 100%;
+  background: var(--color-surface);
+}
+
+.teaser-media {
+  display: block;
+  flex-shrink: 0;
+}
+
+.teaser-image {
+  inline-size: 100%;
+  block-size: auto;
+  object-fit: cover;
+  border-radius: var(--radius-md);
+  aspect-ratio: 16 / 9;
+}
+
+.teaser-content {
+  display: flex;
+  flex-direction: column;
+  flex-grow: 1;
+  margin-block-start: var(--space-sm);
+}
+
+.teaser-meta-header {
+  display: flex;
+  align-items: center;
+  gap: var(--space-xs);
+}
+
+.teaser-badge {
+  display: none;
+  padding-inline: var(--space-xs);
+  padding-block: var(--space-2xs);
+  font-size: var(--text-xs);
