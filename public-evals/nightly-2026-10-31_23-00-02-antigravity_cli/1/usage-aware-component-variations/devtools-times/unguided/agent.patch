@@ -0,0 +1,274 @@
+import React, { useState, useEffect } from 'react';
+import {
+  resolveSemanticContext,
+  type SemanticDomain,
+} from '../utils/semanticContext';
+
+export interface SemanticCalloutProps {
+  title: string;
+  summary: string;
+  category: string;
+  author: string;
+  readingTime?: number;
+  tags?: string[];
+}
+
+export const SemanticCallout: React.FC<SemanticCalloutProps> = ({
+  title,
+  summary,
+  category,
+  author,
+  readingTime = 4,
+  tags = [],
+}) => {
+  const initialProfile = resolveSemanticContext({
+    category,
+    readingTime,
+    tags,
+    title,
+  });
+
+  const [domain, setDomain] = useState<SemanticDomain>(initialProfile.domain);
+  const [density, setDensity] = useState<'compact' | 'balanced' | 'immersive'>(
+    initialProfile.density
+  );
+
+  useEffect(() => {
+    const handler = (event: Event) => {
+      const customEvent = event as CustomEvent<{
+        domain: SemanticDomain;
+        density: 'compact' | 'balanced' | 'immersive';
+      }>;
+      if (customEvent.detail) {
+        setDomain(customEvent.detail.domain);
+        setDensity(customEvent.detail.density);
+      }
+    };
+    window.addEventListener('semantic-context-change', handler);
+    return () => window.removeEventListener('semantic-context-change', handler);
+  }, []);
+
+  const mappedCategory =
+    domain === initialProfile.domain
+      ? category
+      : domain === 'civic'
+      ? 'Politics'
+      : domain === 'culture'
+      ? 'Culture'
+      : domain === 'science'
+      ? 'Science'
+      : 'Sports';
+
+  const profile = resolveSemanticContext({
+    category: mappedCategory,
+    readingTime,
+    tags,
+    title,
+  });
+
+  if (domain === 'civic') {
+    return (
+      <aside
+        className={`my-6 ${
+          density === 'compact' ? 'p-4' : 'p-6'
+        } bg-stone-50 border-t-4 border-rose-800 border-x border-b border-stone-200 shadow-xs transition-all duration-300`}
+        aria-label="Civic & Policy Context Brief"
+        data-semantic-component="callout"
+        data-semantic-domain="civic"
+      >
+        <div className="flex flex-wrap items-center justify-between gap-2 pb-3 mb-3 border-b border-stone-300">
+          <div className="flex items-center gap-2">
+            <span className="inline-block w-2.5 h-2.5 bg-rose-800" />
+            <h2 className="text-xs font-bold uppercase tracking-widest text-rose-900">
+              Civic &amp; Policy Context Brief
+            </h2>
+          </div>
+          <span className="text-[11px] font-mono uppercase text-stone-600 bg-stone-200/80 px-2 py-0.5">
+            Desk: {category} | {profile.tokens.formatLabel}
+          </span>
+        </div>
+
+        <div
+          className={`grid grid-cols-1 ${
+            density === 'compact' ? 'md:grid-cols-2' : 'md:grid-cols-3'
+          } gap-4`}
+        >
+          <div className="md:col-span-2">
+            <p className="text-xs uppercase font-semibold tracking-wider text-stone-500 mb-1">
+              Executive Summary &amp; Public Impact
+            </p>
+            <p className="text-sm text-stone-800 leading-relaxed font-medium">
+              {summary}
+            </p>
+          </div>
+          {density !== 'compact' && (
+            <div className="bg-white p-3 border border-stone-200 flex flex-col justify-between">
+              <span className="text-[11px] font-bold uppercase tracking-wider text-rose-800">
+                Verification &amp; Scope
+              </span>
+              <dl className="mt-2 space-y-1 text-xs">
+                <div className="flex justify-between">
+                  <dt className="text-stone-500">Correspondent:</dt>
+                  <dd className="font-semibold text-stone-800">{author}</dd>
+                </div>
+                <div className="flex justify-between">
+                  <dt className="text-stone-500">Urgency Index:</dt>
+                  <dd className="font-bold text-rose-800">
+                    {profile.urgency.toUpperCase()}
+                  </dd>
+                </div>
+                <div className="flex justify-between">
