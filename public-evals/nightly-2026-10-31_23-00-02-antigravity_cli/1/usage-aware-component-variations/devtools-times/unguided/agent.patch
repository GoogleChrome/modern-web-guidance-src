@@ -0,0 +1,139 @@
+import React from 'react';
+import {
+  resolveSemanticContext,
+  type SemanticDomain,
+  type SemanticFormat,
+} from '../utils/semanticContext';
+
+export interface SemanticBadgeProps {
+  category: string;
+  readingTime?: number;
+  collectionType?: 'articles' | 'reports' | 'multimedia';
+  overrideDomain?: SemanticDomain;
+  overrideFormat?: SemanticFormat;
+  showFormat?: boolean;
+  href?: string;
+  size?: 'sm' | 'md';
+}
+
+export const SemanticBadge: React.FC<SemanticBadgeProps> = ({
+  category,
+  readingTime = 4,
+  collectionType = 'articles',
+  overrideDomain,
+  overrideFormat,
+  showFormat = true,
+  href,
+  size = 'sm',
+}) => {
+  const baseProfile = resolveSemanticContext({
+    category,
+    readingTime,
+    collectionType,
+  });
+
+  const domain = overrideDomain || baseProfile.domain;
+  const format = overrideFormat || baseProfile.format;
+  const profile = resolveSemanticContext({
+    category:
+      overrideDomain === 'civic'
+        ? 'Politics'
+        : overrideDomain === 'culture'
+        ? 'Culture'
+        : overrideDomain === 'science'
+        ? 'Science'
+        : overrideDomain === 'kinetic'
+        ? 'Sports'
+        : category,
+    readingTime,
+    collectionType,
+  });
+
+  const capitalizedCategory =
+    category.charAt(0).toUpperCase() + category.slice(1);
+
+  const renderBadgeContent = () => {
+    switch (domain) {
+      case 'civic':
+        return (
+          <span className="inline-flex items-center gap-1.5">
+            <span
+              className="w-1.5 h-1.5 bg-rose-400 inline-block"
+              aria-hidden="true"
+            />
+            <span>{capitalizedCategory}</span>
+            {showFormat && (
+              <span className="opacity-75 font-normal border-l border-rose-300/40 pl-1.5">
+                {profile.tokens.formatLabel}
+              </span>
+            )}
+          </span>
+        );
+
+      case 'culture':
+        return (
+          <span className="inline-flex items-center gap-1.5">
+            <span aria-hidden="true" className="text-amber-700 not-italic">
+              §
+            </span>
+            <span>{capitalizedCategory}</span>
+            {showFormat && (
+              <span className="opacity-80 not-italic text-[10px] uppercase tracking-widest border-l border-amber-400/60 pl-1.5">
+                {profile.tokens.formatLabel}
+              </span>
+            )}
+          </span>
+        );
+
+      case 'science':
+        return (
+          <span className="inline-flex items-center gap-1">
+            <span className="text-teal-400 opacity-80" aria-hidden="true">
+              [
+            </span>
+            <span>{category.toUpperCase()}</span>
+            {showFormat && (
+              <span className="text-slate-400">
+                ::{format.toUpperCase()}
+              </span>
+            )}
+            <span className="text-teal-400 opacity-80" aria-hidden="true">
+              ]
+            </span>
+          </span>
+        );
+
+      case 'kinetic':
+      default:
+        return (
+          <span className="inline-flex items-center gap-1.5">
+            <span
+              className="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"
+              aria-hidden="true"
+            />
+            <span>{capitalizedCategory}</span>
+            {showFormat && (
+              <span className="opacity-85 font-medium border-l border-emerald-400/50 pl-1.5">
+                {profile.tokens.formatLabel}
+              </span>
+            )}
+          </span>
+        );
+    }
+  };
+
+  const sizeMod = size === 'md' ? 'text-xs py-1 px-3' : '';
+  const combinedClasses = `${profile.tokens.badgeClasses} ${sizeMod} inline-flex items-center transition-all duration-200`;
+
+  if (href) {
+    return (
+      <a href={href} className={`${combinedClasses} hover:opacity-90`}>
+        {renderBadgeContent()}
+      </a>
+    );
+  }
+
+  return <span className={combinedClasses}>{renderBadgeContent()}</span>;
+};
+
+export default SemanticBadge;
