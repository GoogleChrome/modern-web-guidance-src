diff --git a/src/utils/semanticContext.ts b/src/utils/semanticContext.ts
new file mode 100644
index 0000000..93db231
--- /dev/null
+++ b/src/utils/semanticContext.ts
@@ -0,0 +1,309 @@
+export type SemanticDomain = 'civic' | 'culture' | 'science' | 'kinetic';
+
+export type SemanticFormat =
+  | 'brief'
+  | 'feature'
+  | 'deep-dive'
+  | 'report'
+  | 'multimedia';
+
+export type SemanticPlacement = 'hero' | 'featured' | 'standard' | 'compact';
+
+export interface SemanticVisualTokens {
+  domainLabel: string;
+  formatLabel: string;
+  accentText: string;
+  accentBg: string;
+  accentBgSoft: string;
+  accentBorder: string;
+  surfaceBg: string;
+  cardBorder: string;
+  badgeClasses: string;
+  headlineFontClass: string;
+  metadataFontClass: string;
+  headerRuleClass: string;
+  imageFrameClass: string;
+  accentHex: string;
+  layoutVariant: 'editorial-split' | 'gallery-frame' | 'technical-grid' | 'dynamic-pulse';
+}
+
+export interface SemanticContextProfile {
+  domain: SemanticDomain;
+  format: SemanticFormat;
+  placement: SemanticPlacement;
+  category: string;
+  readingTime: number;
+  urgency: 'high' | 'medium' | 'low';
+  density: 'compact' | 'balanced' | 'immersive';
+  visualLogicSummary: string;
+  tokens: SemanticVisualTokens;
+  metrics: {
+    label: string;
+    value: string;
+  }[];
+}
+
+const DOMAIN_MAP: Record<string, SemanticDomain> = {
+  // Civic & Policy
+  news: 'civic',
+  politics: 'civic',
+  national: 'civic',
+  economy: 'civic',
+  labor: 'civic',
+  business: 'civic',
+  'news & politics': 'civic',
+
+  // Arts & Culture
+  culture: 'culture',
+  media: 'culture',
+  'arts & culture': 'culture',
+
+  // Science & Tech
+  science: 'science',
+  'science & tech': 'science',
+  'web development': 'science',
+
+  // Kinetic: Sports, Lifestyle & Urban
+  sports: 'kinetic',
+  lifestyle: 'kinetic',
+  'urban development': 'kinetic',
+  pets: 'kinetic',
+  'lifestyle & sports': 'kinetic',
+};
+
+export function resolveSemanticDomain(category: string = ''): SemanticDomain {
+  const normalized = category.trim().toLowerCase();
+  if (DOMAIN_MAP[normalized]) {
+    return DOMAIN_MAP[normalized];
+  }
+  if (normalized.includes('politic') || normalized.includes('econ') || normalized.includes('news')) {
+    return 'civic';
+  }
+  if (normalized.includes('art') || normalized.includes('cultur') || normalized.includes('media')) {
+    return 'culture';
+  }
+  if (normalized.includes('sci') || normalized.includes('tech') || normalized.includes('web')) {
+    return 'science';
+  }
+  return 'kinetic';
+}
+
+export function resolveSemanticFormat(options: {
+  readingTime?: number;
+  collectionType?: 'articles' | 'reports' | 'multimedia';
+  tags?: string[];
+}): SemanticFormat {
+  if (options.collectionType === 'reports') return 'report';
+  if (options.collectionType === 'multimedia') return 'multimedia';
+
+  const rt = options.readingTime ?? 4;
+  if (rt <= 3) return 'brief';
+  if (rt >= 6) return 'deep-dive';
+  return 'feature';
+}
+
+export function getVisualTokensForDomain(
+  domain: SemanticDomain,
+  format: SemanticFormat
+): SemanticVisualTokens {
+  switch (domain) {
+    case 'civic':
+      return {
+        domainLabel: 'Civic & Policy',
+        formatLabel:
+          format === 'deep-dive'
+            ? 'Investigative Dossier'
+            : format === 'brief'
+            ? 'Policy Dispatch'
+            : format === 'report'
+            ? 'Policy Report'
+            : format === 'multimedia'
+            ? 'Public Briefing'
+            : 'Civic Analysis',
+        accentText: 'text-rose-800',
+        accentBg: 'bg-rose-800',
+        accentBgSoft: 'bg-rose-50/80',
+        accentBorder: 'border-rose-800',
+        surfaceBg: 'bg-stone-50',
+        cardBorder: 'border-t-2 border-rose-800 border-x border-b border-stone-200',
+        badgeClasses:
+          'bg-rose-900 text-white uppercase tracking-widest text-[11px] font-bold px-2.5 py-0.5 rounded-none',
+        headlineFontClass: 'font-brand tracking-tight text-stone-900',
+        metadataFontClass: 'font-sans text-xs uppercase tracking-wider text-stone-600',
+        headerRuleClass: 'border-b-2 border-rose-900',
+        imageFrameClass: 'rounded-none border border-stone-300',
+        accentHex: '#9f1239',
+        layoutVariant: 'editorial-split',
+      };
+
+    case 'culture':
+      return {
+        domainLabel: 'Arts & Culture',
+        formatLabel:
+          format === 'deep-dive'
+            ? 'Longform Essay'
+            : format === 'brief'
+            ? 'Cultural Note'
+            : format === 'report'
+            ? 'Cultural Index'
+            : format === 'multimedia'
+            ? 'Stage & Screen'
+            : 'Critical Feature',
+        accentText: 'text-amber-800',
+        accentBg: 'bg-amber-800',
+        accentBgSoft: 'bg-amber-50/70',
+        accentBorder: 'border-amber-700',
+        surfaceBg: 'bg-amber-50/30',
+        cardBorder: 'border border-amber-200/80 border-l-4 border-l-amber-700',
+        badgeClasses:
+          'bg-amber-100 text-amber-900 italic font-serif text-xs px-3 py-0.5 rounded-full border border-amber-300',
+        headlineFontClass: 'font-brand text-stone-900 tracking-normal',
+        metadataFontClass: 'font-serif italic text-xs text-amber-900/80',
+        headerRuleClass: 'border-b border-amber-600/60',
+        imageFrameClass: 'rounded-lg shadow-sm ring-1 ring-amber-900/10',
+        accentHex: '#b45309',
+        layoutVariant: 'gallery-frame',
+      };
+
+    case 'science':
+      return {
+        domainLabel: 'Science & Systems',
+        formatLabel:
+          format === 'deep-dive'
+            ? 'Research Monograph'
+            : format === 'brief'
+            ? 'Telemetry Brief'
+            : format === 'report'
+            ? 'Sector Audit'
+            : format === 'multimedia'
+            ? 'Lab Briefing'
+            : 'Empirical Study',
+        accentText: 'text-teal-800',
+        accentBg: 'bg-teal-800',
+        accentBgSoft: 'bg-teal-50/70',
+        accentBorder: 'border-teal-700',
+        surfaceBg: 'bg-slate-50',
+        cardBorder: 'border border-slate-200 border-t-2 border-t-teal-600',
+        badgeClasses:
+          'bg-slate-900 text-teal-300 font-mono text-[11px] tracking-tight px-2 py-0.5 rounded border border-teal-500/40',
+        headlineFontClass: 'font-brand text-slate-900 tracking-tight',
+        metadataFontClass: 'font-mono text-xs text-slate-600',
+        headerRuleClass: 'border-b-2 border-teal-700',
+        imageFrameClass: 'rounded-sm ring-1 ring-slate-300',
+        accentHex: '#0f766e',
+        layoutVariant: 'technical-grid',
+      };
+
+    case 'kinetic':
+    default:
+      return {
+        domainLabel: 'Pulse & Motion',
+        formatLabel:
+          format === 'deep-dive'
+            ? 'Endurance Feature'
+            : format === 'brief'
+            ? 'Field Flash'
+            : format === 'report'
+            ? 'Market Dynamics'
+            : format === 'multimedia'
+            ? 'Action Replay'
+            : 'Field Dispatch',
+        accentText: 'text-emerald-800',
+        accentBg: 'bg-emerald-700',
+        accentBgSoft: 'bg-emerald-50/70',
+        accentBorder: 'border-emerald-600',
+        surfaceBg: 'bg-zinc-50',
+        cardBorder: 'border border-zinc-200 border-b-4 border-b-emerald-600',
+        badgeClasses:
+          'bg-emerald-700 text-white font-sans font-bold uppercase tracking-wider text-[11px] px-2.5 py-0.5 rounded-sm',
+        headlineFontClass: 'font-brand text-zinc-900',
+        metadataFontClass: 'font-sans font-semibold text-xs text-emerald-800',
+        headerRuleClass: 'border-b-2 border-emerald-700',
+        imageFrameClass: 'rounded-md shadow-xs',
+        accentHex: '#047857',
+        layoutVariant: 'dynamic-pulse',
+      };
+  }
+}
+
+export function resolveSemanticContext(options: {
+  category?: string;
+  readingTime?: number;
+  collectionType?: 'articles' | 'reports' | 'multimedia';
+  placement?: SemanticPlacement;
+  tags?: string[];
+  title?: string;
+}): SemanticContextProfile {
+  const category = options.category || 'news';
+  const readingTime = options.readingTime ?? 4;
+  const placement = options.placement ?? 'standard';
+  const domain = resolveSemanticDomain(category);
+  const format = resolveSemanticFormat({
+    readingTime,
+    collectionType: options.collectionType,
+    tags: options.tags,
+  });
+
+  const tokens = getVisualTokensForDomain(domain, format);
+
+  const urgency: 'high' | 'medium' | 'low' =
+    format === 'brief' || domain === 'civic'
+      ? 'high'
+      : domain === 'science' || domain === 'kinetic'
+      ? 'medium'
+      : 'low';
+
+  const density: 'compact' | 'balanced' | 'immersive' =
+    format === 'brief' || placement === 'compact'
+      ? 'compact'
+      : format === 'deep-dive' || placement === 'hero'
+      ? 'immersive'
+      : 'balanced';
+
+  const visualLogicDescriptions: Record<SemanticDomain, string> = {
+    civic:
+      'Authoritative editorial rules, high-contrast crimson accents, structured policy hierarchy',
+    culture:
+      'Curatorial gallery spacing, warm amber tones, serif italic metadata & pull-quote framing',
+    science:
+      'Analytical grid precision, monospace telemetry badges, slate & teal empirical hierarchy',
+    kinetic:
+      'High-momentum layout, emerald pulse indicators, bold action-oriented visual framing',
+  };
+
+  const metricsByDomain: Record<SemanticDomain, { label: string; value: string }[]> = {
+    civic: [
+      { label: 'Scope', value: category.charAt(0).toUpperCase() + category.slice(1) },
+      { label: 'Urgency', value: urgency.toUpperCase() },
+      { label: 'Format', value: tokens.formatLabel },
+    ],
+    culture: [
+      { label: 'Curation', value: category.charAt(0).toUpperCase() + category.slice(1) },
+      { label: 'Pacing', value: `${readingTime} min contemplation` },
+      { label: 'Mode', value: 'Gallery Editorial' },
+    ],
+    science: [
+      { label: 'Domain', value: `SYS // ${category.toUpperCase()}` },
+      { label: 'Depth', value: `L${Math.min(5, Math.max(1, Math.round(readingTime / 2)))} Analysis` },
+      { label: 'Readout', value: `${readingTime}:00 EST` },
+    ],
+    kinetic: [
+      { label: 'Arena', value: category.charAt(0).toUpperCase() + category.slice(1) },
+      { label: 'Tempo', value: readingTime <= 3 ? 'Fast Pace' : 'Sustained' },
+      { label: 'Cadence', value: `${readingTime} Min` },
+    ],
+  };
+
+  return {
+    domain,
+    format,
+    placement,
+    category,
+    readingTime,
+    urgency,
+    density,
+    visualLogicSummary: visualLogicDescriptions[domain],
+    tokens,
+    metrics: metricsByDomain[domain],
+  };
+}
