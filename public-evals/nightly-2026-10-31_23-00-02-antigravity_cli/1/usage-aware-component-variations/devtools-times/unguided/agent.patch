diff --git a/src/components/SemanticContextBar.tsx b/src/components/SemanticContextBar.tsx
new file mode 100644
index 0000000..f523674
--- /dev/null
+++ b/src/components/SemanticContextBar.tsx
@@ -0,0 +1,202 @@
+import React, { useState, useEffect } from 'react';
+import {
+  resolveSemanticContext,
+  type SemanticDomain,
+  type SemanticFormat,
+} from '../utils/semanticContext';
+
+export interface SemanticContextBarProps {
+  initialCategory: string;
+  readingTime?: number;
+  collectionType?: 'articles' | 'reports' | 'multimedia';
+  targetContainerId?: string;
+}
+
+const DOMAIN_OPTIONS: {
+  id: SemanticDomain;
+  label: string;
+  sampleCategory: string;
+  shortDesc: string;
+}[] = [
+  {
+    id: 'civic',
+    label: 'Civic & Policy',
+    sampleCategory: 'Politics',
+    shortDesc: 'Authoritative editorial rules & policy brief matrix',
+  },
+  {
+    id: 'culture',
+    label: 'Arts & Culture',
+    sampleCategory: 'Culture',
+    shortDesc: 'Gallery spacing, serif italics & curatorial framing',
+  },
+  {
+    id: 'science',
+    label: 'Science & Systems',
+    sampleCategory: 'Science',
+    shortDesc: 'Analytical grid, monospace telemetry & empirical metrics',
+  },
+  {
+    id: 'kinetic',
+    label: 'Pulse & Motion',
+    sampleCategory: 'Sports',
+    shortDesc: 'Dynamic momentum bars & field condition indicators',
+  },
+];
+
+const DENSITY_OPTIONS: {
+  id: 'compact' | 'balanced' | 'immersive';
+  label: string;
+}[] = [
+  { id: 'compact', label: 'Compact Scan' },
+  { id: 'balanced', label: 'Balanced Editorial' },
+  { id: 'immersive', label: 'Immersive Longform' },
+];
+
+export const SemanticContextBar: React.FC<SemanticContextBarProps> = ({
+  initialCategory,
+  readingTime = 4,
+  collectionType = 'articles',
+  targetContainerId = 'semantic-article-root',
+}) => {
+  const autoProfile = resolveSemanticContext({
+    category: initialCategory,
+    readingTime,
+    collectionType,
+  });
+
+  const [activeDomain, setActiveDomain] = useState<SemanticDomain>(
+    autoProfile.domain
+  );
+  const [activeDensity, setActiveDensity] = useState<
+    'compact' | 'balanced' | 'immersive'
+  >(autoProfile.density);
+  const [isAuto, setIsAuto] = useState<boolean>(true);
+
+  const effectiveCategory = isAuto
+    ? initialCategory
+    : DOMAIN_OPTIONS.find((d) => d.id === activeDomain)?.sampleCategory ||
+      initialCategory;
+
+  const currentProfile = resolveSemanticContext({
+    category: effectiveCategory,
+    readingTime,
+    collectionType,
+  });
+
+  useEffect(() => {
+    const container = document.getElementById(targetContainerId);
+    if (container) {
+      container.setAttribute('data-semantic-domain', activeDomain);
+      container.setAttribute('data-semantic-density', activeDensity);
+    }
+    window.dispatchEvent(
+      new CustomEvent('semantic-context-change', {
+        detail: {
+          domain: activeDomain,
+          density: activeDensity,
+          isAuto,
+          category: effectiveCategory,
+          format: currentProfile.format,
+        },
+      })
+    );
+  }, [activeDomain, activeDensity, isAuto, effectiveCategory, currentProfile.format, targetContainerId]);
+
+  const handleSelectDomain = (domain: SemanticDomain) => {
+    setIsAuto(false);
+    setActiveDomain(domain);
+  };
+
+  const handleResetAuto = () => {
+    setIsAuto(true);
+    setActiveDomain(autoProfile.domain);
+    setActiveDensity(autoProfile.density);
+  };
+
+  return (
+    <div
+      className={`mb-6 rounded-md p-3.5 transition-all duration-300 ${currentProfile.tokens.surfaceBg} ${currentProfile.tokens.cardBorder}`}
+      data-testid="semantic-context-bar"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-2.5">
+          <span className={currentProfile.tokens.badgeClasses}>
+            {isAuto ? 'Auto Context' : 'Context Override'}
+          </span>
+          <span
+            className={`font-semibold text-sm ${currentProfile.tokens.accentText}`}
+          >
+            {currentProfile.tokens.domainLabel}
+          </span>
+          <span className="text-gray-400 text-xs">•</span>
+          <span className={currentProfile.tokens.metadataFontClass}>
+            {currentProfile.tokens.formatLabel}
+          </span>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-1.5">
+          <span className="text-[11px] uppercase tracking-wider text-gray-500 mr-1">
+            Semantic Mode:
+          </span>
+          {DOMAIN_OPTIONS.map((option) => {
+            const isSelected = activeDomain === option.id;
+            return (
+              <button
+                key={option.id}
+                type="button"
+                onClick={() => handleSelectDomain(option.id)}
+                className={`text-xs px-2.5 py-1 rounded transition-colors cursor-pointer ${
+                  isSelected
+                    ? `${currentProfile.tokens.accentBg} text-white font-semibold shadow-xs`
+                    : 'bg-white/80 text-gray-700 hover:bg-gray-200/70 border border-gray-300'
+                }`}
+                aria-pressed={isSelected}
+              >
+                {option.label}
+              </button>
+            );
+          })}
+          {!isAuto && (
+            <button
+              type="button"
+              onClick={handleResetAuto}
+              className="text-xs px-2 py-1 text-gray-600 underline hover:text-gray-900 cursor-pointer ml-1"
+            >
+              Reset
+            </button>
+          )}
+        </div>
+      </div>
+
+      <div className="mt-2.5 pt-2.5 border-t border-gray-200/80 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-600">
+        <p className="italic">{currentProfile.visualLogicSummary}</p>
+        <div className="flex items-center gap-1.5">
+          <span className="text-[11px] uppercase tracking-wider text-gray-500">
+            Density:
+          </span>
+          {DENSITY_OPTIONS.map((d) => (
+            <button
+              key={d.id}
+              type="button"
+              onClick={() => {
+                setIsAuto(false);
+                setActiveDensity(d.id);
+              }}
+              className={`px-2 py-0.5 rounded text-[11px] cursor-pointer transition-colors ${
+                activeDensity === d.id
+                  ? 'bg-gray-800 text-white font-medium'
+                  : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-100'
+              }`}
+              aria-pressed={activeDensity === d.id}
+            >
+              {d.label}
+            </button>
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default SemanticContextBar;
