+import React, { useState } from 'react';
+import {
+  resolveSemanticContext,
+  type SemanticDomain,
+} from '../utils/semanticContext';
+import SemanticBadge from './SemanticBadge';
+
+export interface CollectionItem {
+  id: string;
+  slug?: string;
+  data: {
+    title: string;
+    description: string;
+    publishDate: string;
+    category: string;
+  };
+}
+
+export interface AdaptiveCollectionExplorerProps {
+  items: CollectionItem[];
+  collectionType: 'reports' | 'multimedia';
+  baseUrl?: string;
+}
+
+const DOMAIN_FILTERS: { id: 'all' | SemanticDomain; label: string }[] = [
+  { id: 'all', label: 'All Semantic Contexts' },
+  { id: 'civic', label: 'Civic & Policy' },
+  { id: 'culture', label: 'Arts & Culture' },
+  { id: 'science', label: 'Science & Systems' },
+  { id: 'kinetic', label: 'Pulse & Motion' },
+];
+
+export const AdaptiveCollectionExplorer: React.FC<
+  AdaptiveCollectionExplorerProps
+> = ({ items, collectionType, baseUrl = '/' }) => {
+  const [selectedDomain, setSelectedDomain] = useState<'all' | SemanticDomain>(
+    'all'
+  );
+
+  const enrichedItems = items.map((item) => {
+    const profile = resolveSemanticContext({
+      category: item.data.category,
+      collectionType,
+      readingTime: collectionType === 'reports' ? 7 : 4,
+    });
+    return { item, profile };
+  });
+
+  const filteredItems =
+    selectedDomain === 'all'
+      ? enrichedItems
+      : enrichedItems.filter((entry) => entry.profile.domain === selectedDomain);
+
+  return (
+    <div data-semantic-explorer={collectionType}>
+      {/* Semantic Filter Bar */}
+      <div className="flex flex-wrap items-center justify-between gap-3 mb-8 pb-4 border-b border-gray-200">
+        <div className="flex flex-wrap items-center gap-2">
+          <span className="text-xs font-semibold uppercase tracking-wider text-gray-500 mr-1">
+            Filter by Context:
+          </span>
+          {DOMAIN_FILTERS.map((filter) => {
+            const active = selectedDomain === filter.id;
+            return (
+              <button
+                key={filter.id}
+                type="button"
+                onClick={() => setSelectedDomain(filter.id)}
+                className={`text-xs px-3 py-1.5 rounded transition-colors cursor-pointer ${
+                  active
+                    ? 'bg-gray-900 text-white font-semibold'
+                    : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
+                }`}
+                aria-pressed={active}
+              >
+                {filter.label}
+              </button>
+            );
+          })}
+        </div>
+        <span className="text-xs font-mono text-gray-500">
+          Showing {filteredItems.length} of {items.length}{' '}
+          {collectionType === 'reports' ? 'dossiers' : 'broadcasts'}
+        </span>
+      </div>
+
+      {/* Context-Adaptive Items Grid */}
+      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
+        {filteredItems.map(({ item, profile }) => {
+          const itemSlug = item.slug || item.id;
+          const itemHref = `${baseUrl.replace(/\/?$/, '/')}${collectionType}/${itemSlug}`;
+
+          if (collectionType === 'multimedia') {
+            return (
+              <article
+                key={item.id}
+                data-semantic-domain={profile.domain}
+                data-semantic-format="multimedia"
+                className="bg-slate-950 text-white rounded-lg overflow-hidden border border-slate-800 shadow-md flex flex-col justify-between p-6 group hover:border-amber-400/60 transition-all"
+              >
+                <div>
+                  <div className="flex items-center justify-between gap-2 mb-4">
+                    <SemanticBadge
+                      category={item.data.category}
+                      collectionType="multimedia"
+                    />
+                    <span className="text-[11px] font-mono text-slate-400">
+                      {item.data.publishDate}
+                    </span>
+                  </div>
+
+                  <div className="flex items-start gap-4">
+                    <div
+                      className={`w-12 h-12 rounded-full flex items-center justify-center flex-shrink-0 ${profile.tokens.accentBg} text-white shadow-sm`}
+                      aria-hidden="true"
+                    >
+                      <svg
+                        className="w-5 h-5 ml-0.5"
+                        fill="currentColor"
+                        viewBox="0 0 20 20"
+                      >
+                        <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z" />
+                      </svg>
+                    </div>
+                    <div>
+                      <a href={itemHref} className="block">
+                        <h2 className="text-2xl font-brand text-white group-hover:text-amber-400 transition-colors">
+                          {item.data.title}
+                        </h2>
+                      </a>
+                      <p className="text-sm text-slate-300 mt-1.5 leading-relaxed">
+                        {item.data.description}
+                      </p>
+                    </div>
+                  </div>
+                </div>
+
+                <div className="mt-6 pt-4 border-t border-slate-800/90 flex items-center justify-between text-xs text-slate-400">
+                  <span className="font-mono uppercase tracking-wider">
+                    Mode: {profile.tokens.domainLabel}
+                  </span>
+                  <a
+                    href={itemHref}
+                    className="text-amber-400 font-semibold hover:underline"
+                  >
+                    Launch Stream &rarr;
+                  </a>
+                </div>
+              </article>
+            );
+          }
+
+          // Reports collection: Dossier / Analytical Report visual logic
+          return (
+            <article
+              key={item.id}
+              data-semantic-domain={profile.domain}
+              data-semantic-format="report"
+              className={`${profile.tokens.surfaceBg} ${profile.tokens.cardBorder} p-6 flex flex-col justify-between transition-all hover:shadow-md`}
+            >
+              <div>
+                <div className="flex items-center justify-between gap-2 mb-3">
+                  <SemanticBadge
+                    category={item.data.category}
+                    collectionType="reports"
+                  />
+                  <span className={profile.tokens.metadataFontClass}>
+                    Published {item.data.publishDate}
+                  </span>
+                </div>
+
+                <a href={itemHref} className="block group">
+                  <h2
+                    className={`text-2xl ${profile.tokens.headlineFontClass} group-hover:text-amber-700 transition-colors mb-2`}
+                  >
+                    {item.data.title}
+                  </h2>
+                </a>
+
+                <p className="text-sm text-gray-700 leading-relaxed mb-4">
+                  {item.data.description}
+                </p>
+              </div>
+
+              <div className="pt-3 border-t border-gray-200/80 flex items-center justify-between text-xs">
+                <span className={profile.tokens.metadataFontClass}>
+                  Classification: {profile.tokens.formatLabel}
+                </span>
+                <a
+                  href={itemHref}
+                  className={`font-semibold ${profile.tokens.accentText} hover:underline`}
+                >
+                  Read Dossier &rarr;
+                </a>
+              </div>
+            </article>
+          );
+        })}
+      </div>
+    </div>
+  );
+};
+
+export default AdaptiveCollectionExplorer;
