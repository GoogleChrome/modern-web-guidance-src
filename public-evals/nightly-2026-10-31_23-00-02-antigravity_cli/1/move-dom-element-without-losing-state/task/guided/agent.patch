+  <script>
+    const theaterBtn = document.getElementById('theater-mode-btn');
+    const videoIframe = document.getElementById('roasting-video');
+    const heroSection = document.querySelector('.hero');
+    const videoContainer = document.getElementById('video-container');
+
+    function moveElementPreservingState(targetParent, nodeToMove) {
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(nodeToMove, null);
+      } else {
+        targetParent.insertBefore(nodeToMove, null);
+      }
+    }
+
+    theaterBtn.addEventListener('click', () => {
+      const isInHero = heroSection.contains(videoIframe);
+      const targetParent = isInHero ? videoContainer : heroSection;
+
+      moveElementPreservingState(targetParent, videoIframe);
+
+      const nowInHero = !isInHero;
+      heroSection.classList.toggle('theater-active', nowInHero);
+      theaterBtn.setAttribute('aria-pressed', String(nowInHero));
+      theaterBtn.textContent = nowInHero ? 'Exit Theater Mode' : 'Theater Mode';
+    });
+  </script>
+
