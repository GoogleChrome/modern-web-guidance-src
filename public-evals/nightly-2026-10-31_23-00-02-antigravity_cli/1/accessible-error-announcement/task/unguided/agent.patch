+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorEl = document.getElementById('newsletter-error');
+      const ERROR_MESSAGE = 'Please enter a valid email address.';
+
+      if (!form || !emailInput || !errorEl) return;
+
+      let hasInteracted = false;
+
+      function isUserInvalid() {
+        try {
+          return emailInput.matches(':user-invalid');
+        } catch (e) {
+          return false;
+        }
+      }
+
+      function setErrorState(showError) {
+        if (showError) {
+          emailInput.setAttribute('aria-invalid', 'true');
+          emailInput.classList.add('is-invalid');
+          errorEl.hidden = false;
+          errorEl.removeAttribute('aria-hidden');
+          errorEl.classList.add('visible');
+          if (errorEl.textContent !== ERROR_MESSAGE) {
+            errorEl.textContent = ERROR_MESSAGE;
+          }
+        } else {
+          emailInput.setAttribute('aria-invalid', 'false');
+          emailInput.classList.remove('is-invalid');
+          errorEl.textContent = '';
+          errorEl.hidden = true;
+          errorEl.setAttribute('aria-hidden', 'true');
+          errorEl.classList.remove('visible');
+        }
+      }
+
+      function syncValidationState() {
+        const isValid = emailInput.checkValidity();
+        if (isValid) {
+          setErrorState(false);
+        } else if (hasInteracted || isUserInvalid()) {
+          setErrorState(true);
+        } else {
+          setErrorState(false);
+        }
+      }
+
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        syncValidationState();
+      });
+
+      emailInput.addEventListener('change', function () {
+        hasInteracted = true;
+        syncValidationState();
+      });
+
+      emailInput.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        syncValidationState();
+      });
+
+      emailInput.addEventListener('input', function () {
+        syncValidationState();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        syncValidationState();
+      });
+
+      setErrorState(false);
+    })();
+  </script>
+
 </body>
 
