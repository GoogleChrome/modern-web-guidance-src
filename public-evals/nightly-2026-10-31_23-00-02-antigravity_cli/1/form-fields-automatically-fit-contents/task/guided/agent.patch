+    /* Custom Order / Inquiry Form */
+    .order-section {
+      margin-block-start: 3rem;
+      background: white;
+      padding: 2rem;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .order-section h2 {
+      color: var(--primary);
+      margin-block-end: 1rem;
+      text-align: center;
+    }
+
+    .order-form fieldset {
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      padding: 1.5rem;
+    }
+
+    .order-form legend {
+      font-weight: bold;
+      color: var(--primary);
+      padding-inline: 0.5rem;
+    }
+
+    .form-group {
+      margin-block-end: 1.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+    }
+
+    .form-group label {
+      display: inline-block;
+      font-weight: 600;
+      margin-block-end: 0.35rem;
+      padding: 10px 0;
+      margin-block-start: -10px;
+    }
+
+    .order-form input,
+    .order-form select,
+    .order-form textarea {
+      font-family: inherit;
+      font-size: 1rem;
+      line-height: 1.5;
+      color: var(--text);
+      background-color: var(--light);
+      border: 1px solid #999;
+      border-radius: 4px;
+      padding: 0.75rem;
+      min-height: 48px;
+      box-sizing: border-box;
+      align-self: start;
+    }
+
+    @media (pointer: coarse) {
+      .order-form input,
+      .order-form select,
+      .order-form textarea {
+        min-height: 52px;
+      }
+    }
+
+    .order-form input:focus-visible,
+    .order-form select:focus-visible,
+    .order-form textarea:focus-visible,
+    .order-form button:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .order-form input:invalid:user-invalid,
+    .order-form select:invalid:user-invalid,
+    .order-form textarea:invalid:user-invalid {
+      border-color: #c62828;
+    }
+
+    /* Applies horizontal auto-sizing to inputs */
+    .order-form input {
+      field-sizing: content;
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: min(50ch, 100%);
+    }
+
+    /* Sizes the select element to fit the active option only */
+    .order-form select {
+      field-sizing: content;
+      width: auto;
+      max-inline-size: min(50ch, 100%);
+    }
+
+    /* Applies vertical auto-sizing to textareas while maintaining stable horizontal width */
+    .order-form textarea {
+      field-sizing: content;
+      height: auto;
+      width: min(50ch, 100%);
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+    }
+
+    button.btn {
+      border: none;
+      font-family: inherit;
+      font-size: 1rem;
+      min-height: 48px;
+      cursor: pointer;
+    }
+
