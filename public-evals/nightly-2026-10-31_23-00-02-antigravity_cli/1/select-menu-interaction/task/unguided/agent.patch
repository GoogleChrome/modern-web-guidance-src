+  <script>
+    (function () {
+      const orderForm = document.getElementById('order-form');
+      const shopSelect = document.getElementById('local-shop');
+      const shopError = document.getElementById('local-shop-error');
+      const orderSuccess = document.getElementById('order-success');
+
+      let hasInteractedOrSubmitted = false;
+
+      function updateValidationState() {
+        if (!hasInteractedOrSubmitted) {
+          shopSelect.classList.remove('invalid', 'valid', 'touched');
+          shopSelect.setAttribute('aria-invalid', 'false');
+          shopError.classList.remove('visible');
+          shopError.hidden = true;
+          return true;
+        }
+
+        shopSelect.classList.add('touched');
+        const isValid = shopSelect.checkValidity() && shopSelect.value.trim() !== '';
+
+        if (!isValid) {
+          shopSelect.classList.add('invalid');
+          shopSelect.classList.remove('valid');
+          shopSelect.setAttribute('aria-invalid', 'true');
+          shopError.hidden = false;
+          shopError.classList.add('visible');
+          orderSuccess.classList.remove('visible');
+          orderSuccess.hidden = true;
+        } else {
+          shopSelect.classList.remove('invalid');
+          shopSelect.classList.add('valid');
+          shopSelect.setAttribute('aria-invalid', 'false');
+          shopError.classList.remove('visible');
+          shopError.hidden = true;
+        }
+
+        return isValid;
+      }
+
+      // Mark as interacted when user changes the value or blurs the select menu
+      shopSelect.addEventListener('change', function () {
+        hasInteractedOrSubmitted = true;
+        updateValidationState();
+      });
+
+      shopSelect.addEventListener('blur', function () {
+        hasInteractedOrSubmitted = true;
+        updateValidationState();
+      });
+
+      // Handle native constraint validation invalid event (e.g., when clicking submit button)
+      shopSelect.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteractedOrSubmitted = true;
+        updateValidationState();
+      });
+
+      // Handle form submission
+      orderForm.addEventListener('submit', function (event) {
+        event.preventDefault();
+        hasInteractedOrSubmitted = true;
+        const isValid = updateValidationState();
+
+        if (!isValid) {
+          shopSelect.focus();
+          return;
+        }
+
+        const selectedOption = shopSelect.options[shopSelect.selectedIndex];
+        orderSuccess.textContent = 'Order started for ' + selectedOption.text + '!';
+        orderSuccess.hidden = false;
+        orderSuccess.classList.add('visible');
+      });
+    })();
+  </script>
+
