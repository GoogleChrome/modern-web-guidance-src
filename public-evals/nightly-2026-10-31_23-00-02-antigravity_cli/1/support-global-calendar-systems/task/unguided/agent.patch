+  <script type="module">
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal === 'undefined') {
+        const { Temporal } = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = Temporal;
+      }
+      return globalThis.Temporal;
+    }
+
+    const CALENDARS = [
+      { id: 'islamic-umalqura', cardId: 'card-islamic-umalqura', dateElId: 'islamic-date' },
+      { id: 'hebrew', cardId: 'card-hebrew', dateElId: 'hebrew-date' },
+      { id: 'japanese', cardId: 'card-japanese', dateElId: 'japanese-date' }
+    ];
+
+    function getTimelineLabel(Temporal, selectedDate, todayDate) {
+      const cmp = Temporal.PlainDate.compare(selectedDate, todayDate);
+      if (cmp < 0) return 'Past';
+      if (cmp > 0) return 'Future';
+      return 'Today';
+    }
+
+    function formatCalendarDate(calDate, calendarId) {
+      const options = {
+        calendar: calendarId,
+        year: 'numeric',
+        month: 'long',
+        day: 'numeric'
+      };
+      if (calendarId === 'japanese') {
+        options.era = 'long';
+      }
+      return calDate.toLocaleString('en-US', options);
+    }
+
+    function renderCalendars(Temporal, isoDateString) {
+      if (!isoDateString) return;
+
+      let baseDate;
+      try {
+        baseDate = Temporal.PlainDate.from(isoDateString);
+      } catch {
+        return;
+      }
+
+      const today = Temporal.Now.plainDateISO();
+      const timelineLabel = getTimelineLabel(Temporal, baseDate, today);
+
+      for (const calConfig of CALENDARS) {
+        const card = document.getElementById(calConfig.cardId);
+        if (!card) continue;
+
+        const calDate = baseDate.withCalendar(calConfig.id);
+        const formatted = formatCalendarDate(calDate, calConfig.id);
+
+        const dateEl = document.getElementById(calConfig.dateElId);
+        if (dateEl) {
+          dateEl.textContent = formatted;
+        }
+
+        const timelineEl = card.querySelector('[data-field="timeline"]');
+        if (timelineEl) {
+          timelineEl.textContent = timelineLabel;
+          timelineEl.className = `timeline-badge timeline-${timelineLabel.toLowerCase()}`;
+        }
+
+        const yearEl = card.querySelector('[data-field="year"]');
+        if (yearEl) {
+          yearEl.textContent = String(calDate.year);
+        }
+
+        const monthEl = card.querySelector('[data-field="month"]');
+        if (monthEl) {
+          monthEl.textContent = String(calDate.month);
+        }
+
+        const monthCodeEl = card.querySelector('[data-field="month-code"]');
+        if (monthCodeEl) {
+          monthCodeEl.textContent = calDate.monthCode;
+        }
+
+        const monthsInYearEl = card.querySelector('[data-field="months-in-year"]');
+        if (monthsInYearEl) {
+          monthsInYearEl.textContent = String(calDate.monthsInYear);
+        }
+
+        const breakdownList = card.querySelector('[data-field="month-breakdown"]');
+        if (breakdownList) {
+          breakdownList.innerHTML = '';
+          const totalMonths = calDate.monthsInYear;
+          for (let m = 1; m <= totalMonths; m++) {
+            const monthSample = calDate.with({ month: m, day: 1 });
+            const li = document.createElement('li');
+            li.className = 'month-item' + (m === calDate.month ? ' active-month' : '');
+
+            const codeSpan = document.createElement('span');
+            codeSpan.className = 'month-code';
+            codeSpan.textContent = monthSample.monthCode;
+
+            const daysSpan = document.createElement('span');
+            daysSpan.className = 'month-days';
+            daysSpan.textContent = `${monthSample.daysInMonth} days`;
+
+            li.append(codeSpan, document.createTextNode(': '), daysSpan);
+            breakdownList.appendChild(li);
+          }
+        }
+      }
+    }
+
+    async function initCalendarTool() {
+      const Temporal = await ensureTemporal();
+      const dateInput = document.getElementById('calendar-date-input');
+      const todayIso = Temporal.Now.plainDateISO().toString();
+
+      if (dateInput) {
+        if (!dateInput.value) {
+          dateInput.value = todayIso;
+        }
+        renderCalendars(Temporal, dateInput.value);
+
+        const handleDateUpdate = (event) => {
+          renderCalendars(Temporal, event.target.value);
+        };
+        dateInput.addEventListener('input', handleDateUpdate);
+        dateInput.addEventListener('change', handleDateUpdate);
+      }
+    }
+
+    initCalendarTool();
+  </script>
 </body>
 
