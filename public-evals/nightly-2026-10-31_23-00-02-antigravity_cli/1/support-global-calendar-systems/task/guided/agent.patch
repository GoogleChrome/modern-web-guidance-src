+  <script>
+    const CALENDAR_CONFIGS = [
+      {
+        id: 'islamic-umalqura',
+        prefix: 'islamic',
+        locale: 'en-u-ca-islamic-umalqura',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric',
+          era: 'long'
+        }
+      },
+      {
+        id: 'hebrew',
+        prefix: 'hebrew',
+        locale: 'en-u-ca-hebrew',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric',
+          era: 'long'
+        }
+      },
+      {
+        id: 'japanese',
+        prefix: 'japanese',
+        locale: 'en-u-ca-japanese',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric',
+          era: 'long'
+        }
+      }
+    ];
+
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    function renderCalendars(isoDateString) {
+      let baseIsoDate;
+      try {
+        baseIsoDate = isoDateString
+          ? Temporal.PlainDate.from(isoDateString)
+          : Temporal.Now.plainDateISO();
+      } catch {
+        baseIsoDate = Temporal.Now.plainDateISO();
+      }
+
+      const todayIso = Temporal.Now.plainDateISO();
+
+      for (const config of CALENDAR_CONFIGS) {
+        const supported = isCalendarSupported(config.id);
+        const targetDate = supported
+          ? baseIsoDate.withCalendar(config.id)
+          : baseIsoDate;
+        const todayInCalendar = supported
+          ? todayIso.withCalendar(config.id)
+          : todayIso;
+
+        // 1. Formatted localized date (with era names for era-based calendars like Japanese)
+        const formattedDate = targetDate.toLocaleString(config.locale, config.formatOptions);
+        const dateEl = document.getElementById(`${config.prefix}-date`);
+        if (dateEl) {
+          dateEl.textContent = formattedDate;
+        }
+
+        // 2. Converted year, numeric month, and unique stable month code
+        const yearEl = document.getElementById(`${config.prefix}-year`);
+        if (yearEl) {
+          yearEl.textContent = String(targetDate.year);
+        }
+
+        const monthEl = document.getElementById(`${config.prefix}-month`);
+        if (monthEl) {
+          monthEl.textContent = String(targetDate.month);
+        }
+
+        const monthCodeEl = document.getElementById(`${config.prefix}-month-code`);
+        if (monthCodeEl) {
+          monthCodeEl.textContent = targetDate.monthCode;
+        }
+
+        // 3. Total number of months in that specific calendar year
+        const monthsInYearEl = document.getElementById(`${config.prefix}-months-in-year`);
+        if (monthsInYearEl) {
+          monthsInYearEl.textContent = String(targetDate.monthsInYear);
+        }
+
+        // 4. Timeline label comparing selected date against current date ('Past', 'Future', or 'Today')
+        const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+        const relativeLabel = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+        const timelineEl = document.getElementById(`${config.prefix}-timeline`);
+        if (timelineEl) {
+          timelineEl.textContent = relativeLabel;
+          timelineEl.className = `timeline-badge timeline-${relativeLabel}`;
+        }
+
+        // 5. Month breakdown showing each month's code and how many days are in that month for that specific year
+        const listEl = document.getElementById(`${config.prefix}-months-list`);
+        if (listEl) {
+          listEl.replaceChildren();
+          const totalMonths = targetDate.monthsInYear;
+          for (let m = 1; m <= totalMonths; m++) {
+            const monthDate = targetDate.with({ month: m, day: 1 });
+            const li = document.createElement('li');
+            li.className = 'month-item' + (monthDate.monthCode === targetDate.monthCode ? ' active-month' : '');
+
+            const codeSpan = document.createElement('span');
+            codeSpan.className = 'month-code';
+            codeSpan.textContent = monthDate.monthCode;
+
+            const daysSpan = document.createElement('span');
+            daysSpan.className = 'month-days';
+            daysSpan.textContent = `${monthDate.daysInMonth} days`;
+
+            li.append(codeSpan, daysSpan);
+            listEl.appendChild(li);
+          }
+        }
+      }
+    }
+
+    function initializeCalendarExplorer() {
+      const dateInput = document.getElementById('calendar-date-picker');
+      const todayIso = Temporal.Now.plainDateISO();
+      if (dateInput) {
+        if (!dateInput.value) {
+          dateInput.value = todayIso.toString();
+        }
+        dateInput.addEventListener('input', (event) => {
+          renderCalendars(event.target.value);
+        });
+        dateInput.addEventListener('change', (event) => {
+          renderCalendars(event.target.value);
+        });
+        renderCalendars(dateInput.value);
+      } else {
+        renderCalendars(todayIso.toString());
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeCalendarExplorer();
+    })();
+  </script>
 </body>
 
