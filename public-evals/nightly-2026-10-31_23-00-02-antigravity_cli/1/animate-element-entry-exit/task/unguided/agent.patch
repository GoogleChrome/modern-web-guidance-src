+
+    <section class="promo-section">
+      <h2 style="text-align: center;">Special Promotions</h2>
+      <div class="promo-controls">
+        <button id="addBtn" class="btn">Add Promo Card</button>
+        <button id="removeBtn" class="btn">Remove Last Promo</button>
+        <button id="toggleBtn" class="btn">Toggle Featured Promo</button>
+      </div>
+      <div id="domContainer" class="grid">
+        <div id="toggleCard" class="card">
+          <h3>Happy Hour BOGO</h3>
+          <p>Buy one espresso drink, get a second free from 2 PM to 4 PM!</p>
+          <a href="/rewards" class="btn">Claim Offer</a>
+        </div>
