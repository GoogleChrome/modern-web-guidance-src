   </main>
 
+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promos = [
+      { title: 'Free Pastry Friday', desc: 'Get a complimentary croissant with any large drip coffee.' },
+      { title: 'Double Points Weekend', desc: 'Earn 2x rewards stars on all whole bean coffee bags.' },
+      { title: 'Student Discount', desc: 'Enjoy 15% off your order with a valid student ID.' },
+      { title: 'Bring Your Own Mug', desc: 'Save $0.50 every time you bring a reusable cup.' }
+    ];
+    let promoIndex = 0;
+
+    addBtn.addEventListener('click', () => {
+      const promo = promos[promoIndex % promos.length];
+      promoIndex++;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <h3>${promo.title}</h3>
+        <p>${promo.desc}</p>
+        <a href="/rewards" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.classList.add('removing');
+      lastCard.addEventListener('transitionend', () => {
+        lastCard.remove();
+      }, { once: true });
+
+      // Fallback removal in case transitions are disabled or hidden
+      setTimeout(() => {
+        if (lastCard.parentNode) {
+          lastCard.remove();
+        }
+      }, 350);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.hidden = !toggleCard.hidden;
+    });
+  </script>
