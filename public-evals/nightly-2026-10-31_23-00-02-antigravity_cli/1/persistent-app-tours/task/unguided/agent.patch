+  <script>
+    const featureLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeBtn = document.getElementById('close-tour');
+
+    function isTourOpen() {
+      if (typeof tourStep.matches === 'function' && tourStep.hasAttribute('popover')) {
+        try {
+          return tourStep.matches(':popover-open');
+        } catch (e) {}
+      }
+      return !tourStep.hidden && getComputedStyle(tourStep).display !== 'none';
+    }
+
+    function openTour() {
+      if (typeof tourStep.showPopover === 'function') {
+        try {
+          if (!tourStep.matches(':popover-open')) {
+            tourStep.showPopover();
+          }
+        } catch (e) {}
+      } else {
+        tourStep.hidden = false;
+        tourStep.style.display = 'block';
+      }
+    }
+
+    function closeTour() {
+      if (typeof tourStep.hidePopover === 'function') {
+        try {
+          if (tourStep.matches(':popover-open')) {
+            tourStep.hidePopover();
+          }
+        } catch (e) {}
+      } else {
+        tourStep.hidden = true;
+        tourStep.style.display = 'none';
+      }
+    }
+
+    openTour();
+
+    closeBtn.addEventListener('click', () => {
+      closeTour();
+    });
+
+    featureLink.addEventListener('click', (event) => {
+      if (isTourOpen()) {
+        event.preventDefault();
+      }
+    });
+
+    if (typeof CSS === 'undefined' || !CSS.supports('anchor-name', '--feature')) {
+      function updatePosition() {
+        if (!isTourOpen()) return;
+        const rect = featureLink.getBoundingClientRect();
+        tourStep.style.top = `${rect.bottom}px`;
+        tourStep.style.left = `${rect.left}px`;
+      }
+      updatePosition();
+      window.addEventListener('resize', updatePosition);
+      window.addEventListener('scroll', updatePosition, true);
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(updatePosition);
+        ro.observe(document.documentElement);
+        ro.observe(featureLink);
+      }
+    }
+  </script>
+
