+  <script>
+    (function () {
+      function hydrateMediaElement(el) {
+        if (!el || el.dataset.loaded === 'true') return;
+        el.dataset.loaded = 'true';
+
+        if (el.dataset.poster) {
+          el.poster = el.dataset.poster;
+          el.removeAttribute('data-poster');
+        }
+
+        if (el.dataset.src) {
+          el.src = el.dataset.src;
+          el.removeAttribute('data-src');
+        }
+
+        var sources = el.querySelectorAll('source[data-src]');
+        for (var i = 0; i < sources.length; i++) {
+          sources[i].src = sources[i].dataset.src;
+          sources[i].removeAttribute('data-src');
+        }
+
+        if (el.dataset.preload) {
+          el.preload = el.dataset.preload;
+          el.setAttribute('preload', el.dataset.preload);
+        }
+
+        if (typeof el.load === 'function') {
+          el.load();
+        }
+      }
+
+      function hydrateImageElement(img) {
+        if (!img || img.dataset.loaded === 'true') return;
+        img.dataset.loaded = 'true';
+        if (img.dataset.src) {
+          img.src = img.dataset.src;
+          img.removeAttribute('data-src');
+        }
+      }
+
+      var lazyMediaElements = document.querySelectorAll('.lazy-media');
+      var lazyImages = document.querySelectorAll('.lazy-image');
+
+      // Fallback if user interacts before observer triggers
+      lazyMediaElements.forEach(function (el) {
+        ['play', 'focus', 'mouseenter', 'touchstart'].forEach(function (evt) {
+          el.addEventListener(evt, function () {
+            hydrateMediaElement(el);
+          }, { once: true, passive: true });
+        });
+      });
+
+      if ('IntersectionObserver' in window) {
+        var mediaObserver = new IntersectionObserver(function (entries, observer) {
+          entries.forEach(function (entry) {
+            if (entry.isIntersecting) {
+              var target = entry.target;
+              if (target.classList.contains('lazy-image')) {
+                hydrateImageElement(target);
+              } else {
+                hydrateMediaElement(target);
+              }
+              observer.unobserve(target);
+            }
+          });
+        }, {
+          rootMargin: '200px 0px',
+          threshold: 0.01
+        });
+
+        lazyMediaElements.forEach(function (el) {
+          mediaObserver.observe(el);
+        });
+
+        lazyImages.forEach(function (img) {
+          mediaObserver.observe(img);
+        });
+      } else {
+        lazyMediaElements.forEach(hydrateMediaElement);
+        lazyImages.forEach(hydrateImageElement);
+      }
+    })();
+  </script>
