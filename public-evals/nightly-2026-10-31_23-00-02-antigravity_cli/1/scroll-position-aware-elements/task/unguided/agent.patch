+  <script>
+    (() => {
+      const scroller = document.querySelector('.scroller');
+      const backToTopBtn = document.querySelector('.back-to-top');
+      const sentinel = document.querySelector('.scroll-sentinel');
+
+      if (!scroller || !backToTopBtn) return;
+
+      backToTopBtn.addEventListener('click', () => {
+        scroller.scrollTo({ top: 0, behavior: 'smooth' });
+      });
+
+      const supportsScrollState =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        CSS.supports('container-type', 'scroll-state');
+
+      if (sentinel && 'IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          ([entry]) => {
+            const isAtTop = entry.isIntersecting;
+            backToTopBtn.classList.toggle('is-visible', !isAtTop);
+            if (!supportsScrollState) {
+              backToTopBtn.toggleAttribute('inert', isAtTop);
+            }
+          },
+          { root: scroller, threshold: 0 }
+        );
+        observer.observe(sentinel);
+      }
+    })();
+  </script>
