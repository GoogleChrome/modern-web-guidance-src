+        interactivity: inert;
+        pointer-events: none;
+        translate: 0 calc(100% + 2rem);
+        transform: translateY(1rem);
+      }
+    }
+
+    @container scroll-state(scrollable: top) {
+      .back-to-top {
+        opacity: 1;
+        visibility: visible;
+        interactivity: auto;
+        pointer-events: auto;
+        translate: 0 0;
+        transform: translateY(0);
+      }
+    }
+
+    @supports not (container-type: scroll-state) {
+      .back-to-top.is-visible {
