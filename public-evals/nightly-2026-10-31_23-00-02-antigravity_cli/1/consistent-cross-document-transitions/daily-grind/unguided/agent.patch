+
+.card {
+  background: var(--card-bg);
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+  min-height: 180px;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  align-items: center;
+  contain: layout style;
+}
+
+.card-img {
+  width: 100%;
+  height: 180px;
+  aspect-ratio: 16 / 10;
+  object-fit: cover;
+  border-radius: 6px;
+  margin-bottom: 12px;
+  background-color: var(--secondary);
+}
+
+#card-maple-oat {
+  view-transition-name: card-maple-oat;
+}
+
+#card-dark-roast {
+  view-transition-name: card-dark-roast;
+}
+
+#card-cold-brew {
+  view-transition-name: card-cold-brew;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+:root[data-theme="dark"] .card h3 {
+  color: var(--accent);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s, transform 0.2s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+/* Footer - Not render-blocking */
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+  content-visibility: auto;
+  contain-intrinsic-size: auto 140px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* View Transition Animations */
+@keyframes vt-fade-in {
+  from {
+    opacity: 0;
+    transform: translateY(12px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes vt-fade-out {
+  from {
+    opacity: 1;
+    transform: translateY(0);
+  }
+  to {
+    opacity: 0;
+    transform: translateY(-12px);
+  }
+}
+
+::view-transition-old(root) {
+  animation: 220ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
+}
+
+::view-transition-new(root) {
+  animation: 280ms cubic-bezier(0, 0, 0.2, 1) 40ms both vt-fade-in;
+}
+
+::view-transition-group(site-nav),
+::view-transition-group(brand-logo),
+::view-transition-group(hero-banner),
+::view-transition-group(hero-title),
+::view-transition-group(hero-subtitle),
+::view-transition-group(hero-cta),
+::view-transition-group(seasonal-favorites-section),
+::view-transition-group(card-maple-oat),
+::view-transition-group(card-dark-roast),
+::view-transition-group(card-cold-brew) {
+  animation-duration: 300ms;
+  animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-group(*),
+  ::view-transition-old(*),
+  ::view-transition-new(*) {
+    animation-duration: 0.01ms !important;
+  }
+}
