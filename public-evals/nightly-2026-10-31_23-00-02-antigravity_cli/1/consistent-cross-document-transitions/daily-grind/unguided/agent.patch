+  text-align: center;
+  padding: 0 20px;
+  contain: layout paint;
+  view-transition-name: hero-banner;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+  view-transition-name: hero-title;
+}
+
+.hero p {
+  font-size: 1.15rem;
+  max-width: 640px;
+  view-transition-name: hero-subtitle;
+}
+
+.hero .btn {
+  view-transition-name: hero-cta;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  width: 100%;
+  margin: 40px auto;
+  padding: 0 20px;
+  flex: 1 0 auto;
+}
+
