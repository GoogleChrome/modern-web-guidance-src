--- /dev/null
+++ b/theme.js
@@ -0,0 +1,69 @@
+(function initThemeAndLayout() {
+  var root = document.documentElement;
+
+  // Apply persisted or system theme and initial layout density before first render / transition
+  try {
+    var savedTheme = localStorage.getItem('daily-grind-theme');
+    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
+    var activeTheme = savedTheme || (prefersDark ? 'dark' : 'light');
+    root.dataset.theme = activeTheme;
+
+    var savedLayout = localStorage.getItem('daily-grind-layout') || 'grid';
+    root.dataset.layout = savedLayout;
+    root.dataset.vtReady = 'true';
+  } catch (e) {
+    root.dataset.theme = 'light';
+    root.dataset.layout = 'grid';
+    root.dataset.vtReady = 'true';
+  }
+
+  function normalizePath(urlStr) {
+    try {
+      var u = new URL(urlStr, window.location.origin);
+      return u.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '') || '/';
+    } catch (e) {
+      return '/';
+    }
+  }
+
+  // Handle outgoing cross-document view transitions
+  window.addEventListener('pageswap', function (event) {
+    if (!event.viewTransition) return;
+    var activation = event.activation;
+    if (!activation || !activation.entry) return;
+
+    var fromPath = normalizePath(activation.from ? activation.from.url : window.location.href);
+    var toPath = normalizePath(activation.entry.url);
+
+    root.dataset.transitionFrom = fromPath;
+    root.dataset.transitionTo = toPath;
+
+    if (event.viewTransition.types) {
+      if (toPath === '/') {
+        event.viewTransition.types.add('back-home');
+      } else {
+        event.viewTransition.types.add('to-subpage');
+      }
+    }
+  });
+
+  // Handle incoming cross-document view transitions
+  window.addEventListener('pagereveal', function (event) {
+    if (!event.viewTransition) return;
+    var activation = window.navigation && window.navigation.activation;
+    if (activation && activation.from) {
+      var fromPath = normalizePath(activation.from.url);
+      var toPath = normalizePath(activation.entry ? activation.entry.url : window.location.href);
+      root.dataset.transitionFrom = fromPath;
+      root.dataset.transitionTo = toPath;
+
+      if (event.viewTransition.types) {
+        if (toPath === '/') {
+          event.viewTransition.types.add('back-home');
+        } else {
+          event.viewTransition.types.add('to-subpage');
+        }
+      }
+    }
+  });
+})();
