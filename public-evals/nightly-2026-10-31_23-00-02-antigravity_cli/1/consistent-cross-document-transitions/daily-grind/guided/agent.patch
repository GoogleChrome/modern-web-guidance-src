@@ -0,0 +1,361 @@
+/* Cross-Document View Transitions Opt-in */
+@view-transition {
+  navigation: auto;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  @view-transition {
+    navigation: none;
+  }
+}
+
+:root {
+  --primary: #4e342e;
+  --primary-dark: #3e2723;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+  --surface: #ffffff;
+  --muted: #6d4c41;
+  --shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
+}
+
+:root[data-theme="dark"] {
+  --primary: #3e2723;
+  --primary-dark: #271815;
+  --secondary: #4e342e;
+  --accent: #ffab40;
+  --text: #efebe9;
+  --light: #1e1412;
+  --surface: #2d1f1c;
+  --muted: #d7ccc8;
+  --shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
+}
+
+:where(html, body, nav, header, main, section, article, aside, footer, div, h1, h2, h3, p, ul, li, a, img, button) {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Shared View Transition Names for Persistent / Morphing Elements */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  view-transition-name: site-nav;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+  color: white;
+  text-decoration: none;
+  view-transition-name: site-logo;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+  align-items: center;
+}
+
+nav ul li {
+  margin-inline-start: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s ease;
+}
+
+nav a:hover,
+nav a[aria-current="page"] {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  min-height: 60vh;
+  background-color: var(--primary);
+  background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 40px 20px;
+  view-transition-name: hero;
+}
+
+.hero--menu {
+  background-image: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)),
+    url('https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=1350&q=80');
+}
+
+.hero--locations {
+  background-image: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)),
+    url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=1350&q=80');
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-block-end: 1rem;
+  view-transition-name: page-title;
+}
+
+.hero p {
+  font-size: 1.15rem;
+  max-width: 640px;
+  view-transition-name: hero-subtitle;
+}
+
+.hero .btn {
+  view-transition-name: hero-cta;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.section-title {
+  text-align: center;
+  margin-block-end: 10px;
+  color: var(--primary);
+}
+
+.section-lead {
+  text-align: center;
+  color: var(--muted);
+  margin-block-end: 24px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-block-start: 20px;
+}
+
+.card {
+  background: var(--surface);
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: var(--shadow);
+  text-align: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.card-media {
+  width: 100%;
+  height: auto;
+  aspect-ratio: 16 / 10;
+  object-fit: cover;
+  border-radius: 6px;
+  margin-block-end: 14px;
+  background-color: var(--secondary);
+}
+
+.card h3 {
+  margin-block-end: 10px;
+  color: var(--primary);
+}
+
+.card-price {
+  font-weight: bold;
+  color: var(--primary);
+  margin-block-start: 8px;
+}
+
+#card-seasonal {
+  view-transition-name: featured-seasonal;
+}
+
+#card-espresso {
+  view-transition-name: featured-espresso;
+}
+
+#card-cold-brew {
+  view-transition-name: featured-cold-brew;
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-block-start: 15px;
+  transition: background-color 0.3s ease, transform 0.2s ease;
+}
+
+.btn:hover {
+  background: var(--primary-dark);
+}
+
+.btn--secondary {
+  background: transparent;
+  color: var(--primary);
+  border: 1px solid var(--primary);
+}
+
+.btn--secondary:hover {
+  background: var(--secondary);
+  color: var(--primary-dark);
+}
+
+.detail-banner {
+  background: var(--surface);
+  border-radius: 10px;
+  box-shadow: var(--shadow);
+  padding: 32px;
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 28px;
+  align-items: center;
+}
+
+.detail-banner img {
+  width: 100%;
+  height: auto;
+  aspect-ratio: 4 / 3;
+  object-fit: cover;
+  border-radius: 8px;
+  background-color: var(--secondary);
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-block-start: 40px;
+}
+
+.footer-links {
+  margin-block-end: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.footer-links a:hover {
+  text-decoration: underline;
+}
+
+/* Custom Cross-Document View Transition Animations */
+@media (prefers-reduced-motion: no-preference) {
+  ::view-transition-old(root) {
+    animation: 0.28s ease-in both vt-fade-out;
+  }
+
+  ::view-transition-new(root) {
+    animation: 0.32s ease-out both vt-fade-in;
+  }
+
+  ::view-transition-group(page-title),
+  ::view-transition-group(hero),
+  ::view-transition-group(featured-seasonal),
+  ::view-transition-group(featured-espresso),
+  ::view-transition-group(featured-cold-brew) {
+    animation-duration: 0.35s;
+    animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+  }
+
+  :active-view-transition-type(forwards) {
+    &::view-transition-old(root) {
+      animation-name: vt-slide-out-left;
+    }
+
+    &::view-transition-new(root) {
+      animation-name: vt-slide-in-right;
+    }
+  }
+
+  :active-view-transition-type(backwards) {
+    &::view-transition-old(root) {
+      animation-name: vt-slide-out-right;
+    }
+
+    &::view-transition-new(root) {
+      animation-name: vt-slide-in-left;
+    }
+  }
+}
+
+@keyframes vt-fade-out {
+  to {
+    opacity: 0;
+  }
+}
+
+@keyframes vt-fade-in {
+  from {
+    opacity: 0;
+  }
+}
+
+@keyframes vt-slide-out-left {
+  to {
+    transform: translateX(-6%);
+    opacity: 0;
+  }
+}
+
+@keyframes vt-slide-in-right {
+  from {
+    transform: translateX(6%);
+    opacity: 0;
+  }
+}
