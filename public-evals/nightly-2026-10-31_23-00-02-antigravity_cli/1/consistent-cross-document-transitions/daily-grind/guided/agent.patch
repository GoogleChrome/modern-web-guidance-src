diff --git a/js/theme-init.js b/js/theme-init.js
new file mode 100644
index 0000000..132c413
--- /dev/null
+++ b/js/theme-init.js
@@ -0,0 +1,13 @@
+// Apply stored theme and initial layout state before the page renders
+// so cross-document view transition snapshots capture the stable visual state.
+(() => {
+  try {
+    const savedTheme = localStorage.getItem('theme') || 'light';
+    document.documentElement.dataset.theme = savedTheme;
+    const savedLayout = localStorage.getItem('layout') || 'standard';
+    document.documentElement.dataset.layout = savedLayout;
+  } catch {
+    document.documentElement.dataset.theme = 'light';
+    document.documentElement.dataset.layout = 'standard';
+  }
+})();
