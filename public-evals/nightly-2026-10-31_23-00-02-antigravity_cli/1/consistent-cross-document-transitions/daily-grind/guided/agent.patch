+      <div class="grid">
+        <div class="card">
+          <h3>Ethical Sourcing</h3>
+          <p>100% transparent farm-gate pricing with smallholder co-ops.</p>
+          <a href="/menu/seasonal" class="btn">Seasonal Harvest</a>
+        </div>
+        <div class="card">
+          <h3>Precision Roasting</h3>
+          <p>Small-batch drum roasting tailored to espresso and filter profiles.</p>
+          <a href="/menu/espresso" class="btn">Espresso Craft</a>
+        </div>
