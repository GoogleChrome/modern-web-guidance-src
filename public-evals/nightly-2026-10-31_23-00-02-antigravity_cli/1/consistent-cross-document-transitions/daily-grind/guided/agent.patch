new file mode 100644
index 0000000..bb938ba
--- /dev/null
+++ b/js/transition-setup.js
@@ -0,0 +1,95 @@
+// Context-dependent cross-document view transition setup
+if ('onpagereveal' in window) {
+  const ROUTE_DEPTH = {
+    '/': 0,
+    '/index.html': 0,
+    '/menu': 1,
+    '/menu/': 1,
+    '/menu.html': 1,
+    '/locations': 1,
+    '/locations/': 1,
+    '/locations.html': 1,
+    '/rewards': 1,
+    '/rewards/': 1,
+    '/account': 1,
+    '/account/': 1,
+    '/order-online': 1,
+    '/order-online/': 1,
+    '/about': 1,
+    '/about/': 1,
+    '/careers': 1,
+    '/careers/': 1,
+    '/contact': 1,
+    '/contact/': 1,
+    '/privacy-policy': 1,
+    '/privacy-policy/': 1,
+    '/logout': 1,
+    '/logout/': 1,
+    '/menu/seasonal': 2,
+    '/menu/seasonal/': 2,
+    '/menu/espresso': 2,
+    '/menu/espresso/': 2,
+    '/menu/cold-brew': 2,
+    '/menu/cold-brew/': 2,
+  };
+
+  const normalizePath = (pathname) => {
+    if (!pathname || pathname === '/index.html') return '/';
+    return pathname.length > 1 && pathname.endsWith('/')
+      ? pathname.slice(0, -1)
+      : pathname;
+  };
+
+  window.addEventListener('pagereveal', async (event) => {
+    if (!event.viewTransition) return;
+
+    const activation = window.navigation?.activation;
+    if (!activation?.from) return;
+
+    const fromPath = normalizePath(new URL(activation.from.url).pathname);
+    const toPath = normalizePath(
+      activation.entry?.url
+        ? new URL(activation.entry.url).pathname
+        : window.location.pathname
+    );
+
+    const fromDepth = ROUTE_DEPTH[fromPath] ?? 1;
+    const toDepth = ROUTE_DEPTH[toPath] ?? 1;
+
+    if (event.viewTransition.types) {
+      if (toDepth > fromDepth) {
+        event.viewTransition.types.add('forwards');
+      } else if (toDepth < fromDepth) {
+        event.viewTransition.types.add('backwards');
+      }
+    }
+
+    // Dynamically pair product detail card/heading based on navigation context
+    let dynamicTarget = null;
+    const detailSlugMap = {
+      '/menu/seasonal': 'card-seasonal',
+      '/menu/espresso': 'card-espresso',
+      '/menu/cold-brew': 'card-cold-brew',
+    };
+
+    if (detailSlugMap[fromPath] && (toPath === '/' || toPath === '/menu')) {
+      dynamicTarget = document.getElementById(detailSlugMap[fromPath]);
+    } else if (detailSlugMap[toPath]) {
+      dynamicTarget = document.getElementById('detail-highlight');
+    }
+
+    if (dynamicTarget) {
+      dynamicTarget.style.viewTransitionName = 'active-coffee-card';
+      try {
+        await event.viewTransition.ready;
+      } catch (error) {
+        if (error.name !== 'InvalidStateError') {
+          throw error;
+        }
+      } finally {
+        await event.viewTransition.finished;
+        dynamicTarget.style.viewTransitionName = '';
+      }
+    }
+  });
+}
