diff --git a/src/pages/api/send-otp.ts b/src/pages/api/send-otp.ts
new file mode 100644
index 0000000..942d128
--- /dev/null
+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,71 @@
+import type { APIRoute } from 'astro';
+
+function resolveHostDomain(request: Request, requestedDomain?: string): string {
+  const raw = requestedDomain || request.headers.get('host') || new URL(request.url).hostname || 'localhost';
+  return raw
+    .replace(/^https?:\/\//i, '')
+    .split('/')[0]
+    .split(':')[0]
+    .replace(/\s+/g, '') || 'localhost';
+}
+
+export function formatOriginBoundSms(domain: string, code: string): string {
+  const cleanDomain = domain
+    .replace(/^https?:\/\//i, '')
+    .split('/')[0]
+    .split(':')[0]
+    .replace(/\s+/g, '');
+  const cleanCode = String(code).replace(/\s+/g, '');
+  return `Your verification code is ${cleanCode}.\n\n@${cleanDomain} #${cleanCode}`;
+}
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const phone = typeof body.phone === 'string' ? body.phone.trim() : '';
+
+    if (!phone) {
+      return new Response(
+        JSON.stringify({ error: 'Phone number is required.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const code = '123456';
+    const domain = resolveHostDomain(request, body.domain);
+    const smsMessage = formatOriginBoundSms(domain, code);
+
+    if (session) {
+      await session.set('pendingOtp', {
+        phone,
+        code,
+        domain,
+        expiresAt: Date.now() + 10 * 60 * 1000,
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        phone,
+        domain,
+        smsMessage,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to send verification code.' }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
