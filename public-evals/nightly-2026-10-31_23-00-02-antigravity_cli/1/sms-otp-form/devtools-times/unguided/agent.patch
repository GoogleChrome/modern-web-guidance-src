@@ -0,0 +1,64 @@
+import type { APIRoute } from 'astro';
+
+const PHONE_REGEX = /^\+?[0-9\s\-()]{7,20}$/;
+
+function isValidPhone(phone: string): boolean {
+  const trimmed = phone.trim();
+  if (!PHONE_REGEX.test(trimmed)) {
+    return false;
+  }
+  const digits = trimmed.replace(/\D/g, '');
+  return digits.length >= 7 && digits.length <= 15;
+}
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    const body = await request.json();
+    const phone = typeof body?.phone === 'string' ? body.phone.trim() : '';
+
+    if (!phone || !isValidPhone(phone)) {
+      return new Response(
+        JSON.stringify({
+          error: 'Invalid phone number. Please enter a valid phone number.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const normalizedPhone = phone.replace(/\D/g, '');
+    const code = Math.floor(100000 + Math.random() * 900000).toString();
+    const host = url.hostname || 'astro-news-pytrpecapa-uc.a.run.app';
+    const smsMessage = `Your DevTools Times verification code is ${code}.\n\n@${host} #${code}`;
+
+    if (session) {
+      await session.set('pendingOtp', {
+        phone: normalizedPhone,
+        code,
+        expiresAt: Date.now() + 10 * 60 * 1000,
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        message: 'Verification code sent via SMS.',
+        smsPreview: smsMessage,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Failed to send verification code.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
