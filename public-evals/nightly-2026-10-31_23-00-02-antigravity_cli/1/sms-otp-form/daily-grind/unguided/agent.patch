+  <script>
+    (function () {
+      const otpForm = document.getElementById('otp-form');
+      const otpInput = document.getElementById('otp-input');
+      const otpStatus = document.getElementById('otp-status');
+
+      if (!otpForm || !otpInput) return;
+
+      let ac = new AbortController();
+
+      function showStatus(message, isError = false) {
+        if (!otpStatus) return;
+        otpStatus.textContent = message;
+        otpStatus.style.color = isError ? '#c62828' : '#2e7d32';
+      }
+
+      otpForm.addEventListener('submit', function (e) {
+        e.preventDefault();
+        ac.abort();
+        const code = otpInput.value.trim();
+        if (!/^\d{4,8}$/.test(code)) {
+          showStatus('Please enter a valid numeric verification code.', true);
+          return;
+        }
+        showStatus('Passcode verified! Signing you in...');
+      });
+
+      if ('OTPCredential' in window && navigator.credentials && typeof navigator.credentials.get === 'function') {
+        window.addEventListener('DOMContentLoaded', function () {
+          navigator.credentials.get({
+            otp: { transport: ['sms'] },
+            signal: ac.signal
+          }).then(function (otp) {
+            if (otp && otp.code) {
+              otpInput.value = otp.code;
+              if (typeof otpForm.requestSubmit === 'function') {
+                otpForm.requestSubmit();
+              } else {
+                otpForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
+              }
+            }
+          }).catch(function (err) {
+            // Silently ignore AbortError or unsupported environments
+          });
+        });
+      }
+    })();
+  </script>
