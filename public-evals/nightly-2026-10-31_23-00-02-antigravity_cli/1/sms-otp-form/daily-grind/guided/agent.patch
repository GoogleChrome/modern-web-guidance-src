+  <script>
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const resendCodeBtn = document.getElementById('resend-code-btn');
+    const verifySubmitBtn = document.getElementById('verify-submit-btn');
+    const otpStatus = document.getElementById('otp-status');
+    const smsTemplatePreview = document.getElementById('sms-template-preview');
+
+    // Format origin-bound SMS preview using the current host domain (no scheme, port, or path)
+    const currentDomain = window.location.hostname || 'dailygrind.example';
+
+    function formatOriginBoundSms(domain, code) {
+      return `Your Daily Grind verification code is ${code}.\n\n@${domain} #${code}`;
+    }
+
+    if (smsTemplatePreview) {
+      smsTemplatePreview.textContent = formatOriginBoundSms(currentDomain, '123456');
+    }
+
+    function updateStatus(message, type) {
+      if (!otpStatus) return;
+      otpStatus.textContent = message;
+      otpStatus.className = `status-message status-${type}`;
+      otpStatus.hidden = !message;
+    }
+
+    let otpAbortController = null;
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      // Feature-detect WebOTP support
+      if (!otpInput || !('OTPCredential' in window)) {
+        return;
+      }
+
+      // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+
+        if (!otp) return;
+        otpInput.value = otp.code;
+        otpInput.setCustomValidity('');
+
+        // Trigger standard form submission so submit event listeners and validation run
+        if (otpForm) {
+          otpForm.requestSubmit();
+        }
+      } catch (err) {
+        // Expected when aborted by manual submission, resend, unmount, or user dismissal
+        if (err && err.name === 'AbortError') {
+          return;
+        }
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    // Validate on blur and clear custom validity/errors on input
+    if (otpInput) {
+      otpInput.addEventListener('invalid', () => {
+        otpInput.setCustomValidity('Please enter the 6-digit numeric verification code.');
+      });
+
+      otpInput.addEventListener('input', () => {
+        otpInput.setCustomValidity('');
+        if (otpStatus && otpStatus.classList.contains('status-error')) {
+          otpStatus.hidden = true;
+        }
+      });
+
+      otpInput.addEventListener('blur', () => {
+        if (otpInput.value && !/^\d{6}$/.test(otpInput.value)) {
+          otpInput.setCustomValidity('Please enter the 6-digit numeric verification code.');
+          updateStatus('Error: Please enter a valid 6-digit numeric code.', 'error');
+        }
+      });
+    }
+
+    if (resendCodeBtn) {
+      resendCodeBtn.addEventListener('click', () => {
+        // Abort previous WebOTP listener and start a fresh one for the new SMS
+        startSmsOtpListener();
+        if (verifySubmitBtn) {
+          verifySubmitBtn.disabled = false;
+        }
+        if (smsTemplatePreview) {
+          smsTemplatePreview.textContent = formatOriginBoundSms(currentDomain, '123456');
+        }
+        updateStatus('A new 6-digit verification code has been sent via SMS.', 'info');
+        if (otpInput) {
+          otpInput.value = '';
+          otpInput.setCustomValidity('');
+          otpInput.focus();
+        }
+      });
+    }
+
+    if (otpForm) {
+      otpForm.addEventListener('submit', async (event) => {
+        // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+        stopSmsOtpListener();
+
+        event.preventDefault();
+
+        if (otpInput && !/^\d{6}$/.test(otpInput.value)) {
+          otpInput.setCustomValidity('Please enter the 6-digit numeric verification code.');
+          updateStatus('Error: Please enter a valid 6-digit numeric code.', 'error');
+          otpInput.focus();
+          return;
+        }
+
+        if (verifySubmitBtn) {
+          verifySubmitBtn.disabled = true;
+        }
+
+        const formData = new FormData(otpForm);
+        const submittedCode = formData.get('otp');
+        updateStatus(`Code ${submittedCode} verified! You are now signed in for Rewards and online ordering.`, 'success');
+      });
+    }
+
+    // Abort in-flight WebOTP request when page unloads/hides
+    window.addEventListener('pagehide', stopSmsOtpListener);
+
+    // Start listening when the OTP verification step becomes active
+    startSmsOtpListener();
+  </script>
 </body>
 
