+  <script>
+    (function () {
+      const switches = document.querySelectorAll('button[role="switch"]');
+      const summaryEl = document.getElementById('active-prefs-summary');
+      const cards = document.querySelectorAll('.card');
+      const roastBadges = document.querySelectorAll('.roast-badge');
+
+      function updateApplicationState() {
+        const themeSwitch = document.getElementById('dark-mode-switch');
+        const dairyFreeSwitch = document.getElementById('switch-dairy-free');
+        const decafSwitch = document.getElementById('switch-decaf');
+        const cupSwitch = document.getElementById('switch-reusable-cup');
+
+        const isDark = themeSwitch && themeSwitch.getAttribute('aria-checked') === 'true';
+        const isDairyFree = dairyFreeSwitch && dairyFreeSwitch.getAttribute('aria-checked') === 'true';
+        const isDecaf = decafSwitch && decafSwitch.getAttribute('aria-checked') === 'true';
+        const isReusableCup = cupSwitch && cupSwitch.getAttribute('aria-checked') === 'true';
+
+        if (isDark) {
+          document.body.setAttribute('data-theme', 'dark');
+        } else {
+          document.body.removeAttribute('data-theme');
+        }
+
+        cards.forEach(function (card) {
+          if (isDairyFree && card.getAttribute('data-dairy-free') === 'false') {
+            card.setAttribute('hidden', '');
+          } else {
+            card.removeAttribute('hidden');
+          }
+        });
+
+        roastBadges.forEach(function (badge) {
+          if (!badge.dataset.originalText) {
+            badge.dataset.originalText = badge.textContent;
+          }
+          badge.textContent = isDecaf ? 'Swiss Water Decaf' : badge.dataset.originalText;
+        });
+
+        if (summaryEl) {
+          const parts = [
+            isDairyFree ? 'Dairy-free menu' : 'Standard menu',
+            isDecaf ? 'Swiss Water Decaf' : 'Caffeinated'
+          ];
+          if (isReusableCup) {
+            parts.push('Reusable cup (-$0.50)');
+          }
+          summaryEl.textContent = parts.join(' • ');
+        }
+      }
+
+      function toggleSwitch(switchEl) {
+        if (switchEl.disabled || switchEl.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+        const isChecked = switchEl.getAttribute('aria-checked') === 'true';
+        const nextState = !isChecked;
+        switchEl.setAttribute('aria-checked', String(nextState));
+
+        switchEl.dispatchEvent(
+          new CustomEvent('switchchange', {
+            bubbles: true,
+            detail: {
+              checked: nextState,
+              target: switchEl.getAttribute('data-switch-target')
+            }
+          })
+        );
+
+        updateApplicationState();
+      }
+
+      switches.forEach(function (switchEl) {
+        switchEl.addEventListener('click', function () {
+          toggleSwitch(switchEl);
+        });
+      });
+
+      // Allow clicking associated text labels to toggle their switch
+      document.querySelectorAll('[data-switch-for]').forEach(function (labelEl) {
+        labelEl.addEventListener('click', function () {
+          const targetId = labelEl.getAttribute('data-switch-for');
+          const switchEl = document.getElementById(targetId);
+          if (switchEl) {
+            switchEl.focus();
+            toggleSwitch(switchEl);
+          }
+        });
+      });
+
+      updateApplicationState();
+    })();
+  </script>
 </body>
 
 </html>
