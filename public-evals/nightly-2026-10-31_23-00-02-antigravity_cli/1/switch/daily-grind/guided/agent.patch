+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const form = document.getElementById('preferences-form');
+    const status = document.getElementById('preferences-status');
+
+    form.addEventListener('change', (event) => {
+      const target = event.target;
+      if (target instanceof HTMLInputElement && target.type === 'checkbox') {
+        const label = form.querySelector(`label[for="${target.id}"] span`);
+        const settingName = label ? label.textContent.trim() : target.name;
+        const stateText = target.checked ? 'enabled' : 'disabled';
+        status.textContent = `${settingName}: ${stateText}.`;
+      }
+    });
+  </script>
