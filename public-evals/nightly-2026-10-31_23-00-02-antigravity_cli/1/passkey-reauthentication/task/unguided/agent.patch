+  <script>
+    function base64UrlToUint8Array(input) {
+      if (input instanceof Uint8Array) return input;
+      if (input instanceof ArrayBuffer) return new Uint8Array(input);
+      if (ArrayBuffer.isView(input)) {
+        return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+      }
+      if (Array.isArray(input)) return new Uint8Array(input);
+      if (typeof input === 'string') {
+        const base64 = input.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+        try {
+          const binary = atob(padded);
+          const bytes = new Uint8Array(binary.length);
+          for (let i = 0; i < binary.length; i++) {
+            bytes[i] = binary.charCodeAt(i);
+          }
+          return bytes;
+        } catch (err) {
+          return new TextEncoder().encode(input);
+        }
+      }
+      return new Uint8Array();
+    }
+
+    function bufferToBase64Url(input) {
+      if (!input) return input;
+      if (typeof input === 'string') return input;
+      const bytes = input instanceof Uint8Array
+        ? input
+        : ArrayBuffer.isView(input)
+          ? new Uint8Array(input.buffer, input.byteOffset, input.byteLength)
+          : input instanceof ArrayBuffer
+            ? new Uint8Array(input)
+            : Array.isArray(input)
+              ? new Uint8Array(input)
+              : null;
+      if (!bytes) return input;
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    async function handleReauth() {
+      const statusEl = document.getElementById('reauth-status');
+      try {
+        if (statusEl) statusEl.textContent = 'Requesting verification challenge...';
+
+        const optionsRes = await fetch('/api/reauth/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin'
+        });
+
+        if (!optionsRes.ok) {
+          throw new Error('Failed to fetch re-authentication options');
+        }
+
+        const optionsData = await optionsRes.json();
+        const rawOptions = optionsData.publicKey || optionsData;
+
+        const allowCredentials = (rawOptions.allowCredentials || rawOptions.credentials || []).map((cred) => ({
+          ...cred,
+          type: cred.type || 'public-key',
+          id: base64UrlToUint8Array(cred.id)
+        }));
+
+        const publicKey = {
+          ...rawOptions,
+          challenge: base64UrlToUint8Array(rawOptions.challenge),
+          allowCredentials,
+          userVerification: rawOptions.userVerification || 'preferred'
+        };
+
+        const assertion = await navigator.credentials.get({ publicKey });
+        if (!assertion) {
+          throw new Error('No credential assertion returned');
+        }
+
+        const response = assertion.response || {};
+        const verifyPayload = {
+          id: assertion.id || bufferToBase64Url(assertion.rawId),
+          rawId: bufferToBase64Url(assertion.rawId || assertion.id),
+          type: assertion.type || 'public-key',
+          authenticatorAttachment: assertion.authenticatorAttachment || undefined,
+          clientExtensionResults: typeof assertion.getClientExtensionResults === 'function'
+            ? assertion.getClientExtensionResults()
+            : (assertion.clientExtensionResults || {}),
+          response: {
+            clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+            authenticatorData: bufferToBase64Url(response.authenticatorData),
+            signature: bufferToBase64Url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64Url(response.userHandle) : null
+          }
+        };
+
+        const verifyRes = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          credentials: 'same-origin',
+          body: JSON.stringify(verifyPayload)
+        });
+
+        if (!verifyRes.ok) {
+          throw new Error('Failed to verify re-authentication assertion');
+        }
+
+        if (statusEl) statusEl.textContent = 'Identity verified.';
+      } catch (error) {
+        if (statusEl) statusEl.textContent = error.message || 'Verification failed.';
+      }
+    }
+
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    if (reauthButton) {
+      reauthButton.addEventListener('click', handleReauth);
+    }
+  </script>
