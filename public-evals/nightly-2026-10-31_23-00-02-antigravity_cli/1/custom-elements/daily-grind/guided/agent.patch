+  <script type="module">
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = [
+        'name',
+        'description',
+        'href',
+        'price',
+        'featured',
+        'sold-out',
+        'disabled'
+      ];
+
+      #internals;
+      #clickHandler;
+
+      constructor() {
+        super();
+        if (typeof this.attachInternals === 'function') {
+          this.#internals = this.attachInternals();
+        }
+        this.#clickHandler = (event) => this.#onClick(event);
+      }
+
+      // String attributes reflected via getter/setter
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+      set name(v) {
+        v ? this.setAttribute('name', String(v)) : this.removeAttribute('name');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+      set description(v) {
+        v ? this.setAttribute('description', String(v)) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+      set href(v) {
+        v ? this.setAttribute('href', String(v)) : this.removeAttribute('href');
+      }
+
+      // Numeric attribute: coerce from string on read, serialize on write
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+      set price(v) {
+        this.setAttribute('price', String(Number(v) || 0));
+      }
+
+      // Boolean attributes: present = true, absent = false. Never set to "false"
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+      set featured(on) {
+        this.toggleAttribute('featured', !!on);
+      }
+
+      get soldOut() {
+        return this.hasAttribute('sold-out');
+      }
+      set soldOut(on) {
+        this.toggleAttribute('sold-out', !!on);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+      set disabled(on) {
+        this.toggleAttribute('disabled', !!on);
+      }
+
+      connectedCallback() {
+        // Make setup idempotent as connectedCallback can run more than once
+        this.classList.add('card');
+        this.removeEventListener('click', this.#clickHandler);
+        this.addEventListener('click', this.#clickHandler);
+        this.render();
+      }
+
+      connectedMoveCallback() {
+        // Skips disconnect/reconnect teardown and re-render when relocated via Node.moveBefore()
+      }
+
+      disconnectedCallback() {
+        // Clean up listeners without treating teardown as permanent
+        this.removeEventListener('click', this.#clickHandler);
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal && this.isConnected) {
+          this.render();
+        }
+      }
+
+      #onClick(event) {
+        if (this.soldOut || this.disabled) {
+          event.preventDefault();
+          return;
+        }
+        const link = event.target.closest('a.btn');
+        if (link && this.#internals?.states) {
+          this.#internals.states.add('selected');
+        }
+      }
+
+      render() {
+        let badgeEl = this.querySelector('.card-badge');
+        if (this.featured) {
+          if (!badgeEl) {
+            badgeEl = document.createElement('span');
+            badgeEl.className = 'card-badge';
+            this.prepend(badgeEl);
+          }
+          badgeEl.textContent = 'Seasonal Pick';
+        } else if (badgeEl) {
+          badgeEl.remove();
+        }
+
+        let headingEl = this.querySelector('h3');
+        if (!headingEl) {
+          headingEl = document.createElement('h3');
+          this.append(headingEl);
+        }
+        if (this.name) {
+          headingEl.textContent = this.name;
+        }
+
+        let descEl = this.querySelector('p:not(.card-price)');
+        if (!descEl) {
+          descEl = document.createElement('p');
+          headingEl.after(descEl);
+        }
+        if (this.description) {
+          descEl.textContent = this.description;
+        }
+
+        let priceEl = this.querySelector('.card-price');
+        if (this.price > 0) {
+          if (!priceEl) {
+            priceEl = document.createElement('p');
+            priceEl.className = 'card-price';
+            descEl.after(priceEl);
+          }
+          priceEl.textContent = `$${this.price.toFixed(2)}`;
+        } else if (priceEl) {
+          priceEl.remove();
+        }
+
+        let linkEl = this.querySelector('a.btn');
+        if (!linkEl) {
+          linkEl = document.createElement('a');
+          linkEl.className = 'btn';
+          this.append(linkEl);
+        }
+        const isUnavailable = this.soldOut || this.disabled;
+        linkEl.setAttribute('href', this.href || '#');
+        if (isUnavailable) {
+          linkEl.setAttribute('aria-disabled', 'true');
+          linkEl.textContent = this.soldOut ? 'Sold Out' : 'Unavailable';
+        } else {
+          linkEl.removeAttribute('aria-disabled');
+          linkEl.textContent = 'View Details';
+        }
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
 </body>
 
