+  <script>
+    class CoffeeCard extends HTMLElement {
+      static get observedAttributes() {
+        return [
+          'name',
+          'description',
+          'href',
+          'cta-text',
+          'price',
+          'calories',
+          'featured',
+          'sold-out',
+        ];
+      }
+
+      constructor() {
+        super();
+        this._isConnected = false;
+        this._handleClick = this._handleClick.bind(this);
+      }
+
+      connectedCallback() {
+        this._isConnected = true;
+        this._upgradeProperty('name');
+        this._upgradeProperty('description');
+        this._upgradeProperty('href');
+        this._upgradeProperty('ctaText');
+        this._upgradeProperty('price');
+        this._upgradeProperty('calories');
+        this._upgradeProperty('featured');
+        this._upgradeProperty('soldOut');
+
+        this.addEventListener('click', this._handleClick);
+        this.render();
+      }
+
+      disconnectedCallback() {
+        this._isConnected = false;
+        this.removeEventListener('click', this._handleClick);
+      }
+
+      adoptedCallback() {
+        if (this._isConnected) {
+          this.render();
+        }
+      }
+
+      attributeChangedCallback(attrName, oldValue, newValue) {
+        if (oldValue === newValue) return;
+        if (this._isConnected) {
+          this.render();
+        }
+      }
+
+      _upgradeProperty(prop) {
+        if (Object.prototype.hasOwnProperty.call(this, prop)) {
+          const value = this[prop];
+          delete this[prop];
+          this[prop] = value;
+        }
+      }
+
+      _handleClick(event) {
+        const link = event.target.closest('a.btn');
+        if (!link) return;
+        if (this.soldOut) {
+          event.preventDefault();
+          return;
+        }
+        this.dispatchEvent(
+          new CustomEvent('coffee-select', {
+            bubbles: true,
+            composed: true,
+            detail: {
+              name: this.name,
+              href: this.href,
+              price: this.price,
+              calories: this.calories,
+              featured: this.featured,
+              soldOut: this.soldOut,
+            },
+          })
+        );
+      }
+
+      // String attributes/properties
+      get name() {
+        return this.getAttribute('name') || '';
+      }
+
+      set name(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('name');
+        } else {
+          this.setAttribute('name', String(value));
+        }
+      }
+
+      get description() {
+        return this.getAttribute('description') || '';
+      }
+
+      set description(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('description');
+        } else {
+          this.setAttribute('description', String(value));
+        }
+      }
+
+      get href() {
+        return this.getAttribute('href') || '#';
+      }
+
+      set href(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('href');
+        } else {
+          this.setAttribute('href', String(value));
+        }
+      }
+
+      get ctaText() {
+        return this.getAttribute('cta-text') || 'View Details';
+      }
+
+      set ctaText(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('cta-text');
+        } else {
+          this.setAttribute('cta-text', String(value));
+        }
+      }
+
+      // Numeric attributes/properties
+      get price() {
+        const val = this.getAttribute('price');
+        if (val === null || val.trim() === '') return 0;
+        const num = Number(val);
+        return Number.isFinite(num) ? num : 0;
+      }
+
+      set price(value) {
+        if (value === null || value === undefined || value === '') {
+          this.removeAttribute('price');
+        } else {
+          const num = Number(value);
+          if (Number.isFinite(num)) {
+            this.setAttribute('price', String(num));
+          } else {
+            this.removeAttribute('price');
+          }
+        }
+      }
+
+      get calories() {
+        const val = this.getAttribute('calories');
+        if (val === null || val.trim() === '') return 0;
+        const num = Number(val);
+        return Number.isFinite(num) ? num : 0;
+      }
+
+      set calories(value) {
+        if (value === null || value === undefined || value === '') {
+          this.removeAttribute('calories');
+        } else {
+          const num = Number(value);
+          if (Number.isFinite(num)) {
+            this.setAttribute('calories', String(num));
+          } else {
+            this.removeAttribute('calories');
+          }
+        }
+      }
+
+      // Boolean attributes/properties
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+
+      set featured(value) {
+        if (Boolean(value)) {
+          this.setAttribute('featured', '');
+        } else {
+          this.removeAttribute('featured');
+        }
+      }
+
+      get soldOut() {
+        return this.hasAttribute('sold-out');
+      }
+
+      set soldOut(value) {
+        if (Boolean(value)) {
+          this.setAttribute('sold-out', '');
+        } else {
+          this.removeAttribute('sold-out');
+        }
+      }
+
+      render() {
+        const card = document.createElement('div');
+        card.className = 'card';
+
+        if (this.soldOut) {
+          const badge = document.createElement('span');
+          badge.className = 'badge sold-out-badge';
+          badge.textContent = 'Sold Out';
+          card.appendChild(badge);
+        } else if (this.featured) {
+          const badge = document.createElement('span');
+          badge.className = 'badge';
+          badge.textContent = 'Featured';
+          card.appendChild(badge);
+        }
+
+        const content = document.createElement('div');
+
+        const title = document.createElement('h3');
+        title.textContent = this.name;
+        content.appendChild(title);
+
+        const desc = document.createElement('p');
+        desc.textContent = this.description;
+        content.appendChild(desc);
+
+        const hasPrice = this.hasAttribute('price') && this.price > 0;
+        const hasCalories = this.hasAttribute('calories') && this.calories > 0;
+
+        if (hasPrice || hasCalories) {
+          const meta = document.createElement('div');
+          meta.className = 'card-meta';
+
+          if (hasPrice) {
+            const priceEl = document.createElement('span');
+            priceEl.className = 'card-price';
+            priceEl.textContent = `$${this.price.toFixed(2)}`;
+            meta.appendChild(priceEl);
+          }
+
+          if (hasCalories) {
+            const calEl = document.createElement('span');
+            calEl.className = 'card-calories';
+            calEl.textContent = `${this.calories} cal`;
+            meta.appendChild(calEl);
+          }
+
+          content.appendChild(meta);
+        }
+
+        card.appendChild(content);
+
+        const link = document.createElement('a');
+        link.href = this.href;
+        link.className = this.soldOut ? 'btn disabled' : 'btn';
+        if (this.soldOut) {
+          link.setAttribute('aria-disabled', 'true');
+          link.textContent = 'Unavailable';
+        } else {
+          link.textContent = this.ctaText;
+        }
+        card.appendChild(link);
+
+        this.replaceChildren(card);
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
 </body>
 
