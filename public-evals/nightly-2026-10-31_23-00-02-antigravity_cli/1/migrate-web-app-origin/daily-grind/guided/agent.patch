+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_user_config';
+      const OLD_ORIGIN = 'https://old-app.dailygrind.com';
+      const NEW_ORIGIN = 'https://new-app.dailygrind.com';
+      const SITE_DOMAIN = 'dailygrind.com';
+
+      const roastSelect = document.getElementById('pref-roast');
+      const milkSelect = document.getElementById('pref-milk');
+      const statusText = document.getElementById('prefs-status');
+      const migrateLink = document.getElementById('migrate-now-link');
+      const syncBtn = document.getElementById('sync-config-btn');
+      const dismissBtn = document.getElementById('dismiss-migration-btn');
+      const banner = document.getElementById('migration-banner');
+
+      function extractOrigin(candidate) {
+        try {
+          return Origin.from(candidate);
+        } catch (err) {
+          if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+            return Origin.from(candidate.origin);
+          }
+          throw err;
+        }
+      }
+
+      function isTrustedMigrationOrigin(candidate) {
+        try {
+          if ('Origin' in globalThis) {
+            const candidateOrigin = extractOrigin(candidate);
+            return (
+              candidateOrigin.isSameOrigin(Origin.from(OLD_ORIGIN)) ||
+              candidateOrigin.isSameOrigin(Origin.from(NEW_ORIGIN)) ||
+              candidateOrigin.isSameSite(Origin.from(NEW_ORIGIN))
+            );
+          }
+          const rawUrl =
+            typeof candidate === 'string'
+              ? candidate
+              : typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent
+                ? candidate.origin
+                : candidate?.href ?? '';
+          const parsed = new URL(rawUrl);
+          return (
+            parsed.origin !== 'null' &&
+            (parsed.origin === OLD_ORIGIN ||
+              parsed.origin === NEW_ORIGIN ||
+              (parsed.protocol === 'https:' &&
+                (parsed.hostname === SITE_DOMAIN || parsed.hostname.endsWith(`.${SITE_DOMAIN}`))))
+          );
+        } catch {
+          return false;
+        }
+      }
+
+      function loadConfig() {
+        try {
+          const urlParams = new URLSearchParams(window.location.search);
+          const migratedConfigParam = urlParams.get('migrated_config');
+          if (migratedConfigParam) {
+            const parsed = JSON.parse(atob(migratedConfigParam));
+            if (parsed && typeof parsed === 'object') {
+              saveConfig(parsed, 'Configuration restored from previous origin.');
+              const cleanUrl = new URL(window.location.href);
+              cleanUrl.searchParams.delete('migrated_config');
+              window.history.replaceState({}, document.title, cleanUrl.toString());
+              return parsed;
+            }
+          }
+          const raw = localStorage.getItem(STORAGE_KEY);
+          return raw ? JSON.parse(raw) : { roast: 'medium', milk: 'oat' };
+        } catch {
+          return { roast: 'medium', milk: 'oat' };
+        }
+      }
+
+      function saveConfig(config, message) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
+          if (roastSelect && config.roast) roastSelect.value = config.roast;
+          if (milkSelect && config.milk) milkSelect.value = config.milk;
+          if (statusText && message) statusText.textContent = message;
+          updateMigrationLink(config);
+        } catch {
+          // Ignore storage quota errors
+        }
+      }
+
+      function getCurrentConfig() {
+        return {
+          roast: roastSelect ? roastSelect.value : 'medium',
+          milk: milkSelect ? milkSelect.value : 'oat',
+          updatedAt: Date.now(),
+        };
+      }
+
+      function updateMigrationLink(config) {
+        if (!migrateLink) return;
+        try {
+          const targetUrl = new URL('/index.html', NEW_ORIGIN);
+          const encoded = btoa(JSON.stringify(config));
+          targetUrl.searchParams.set('migrated_config', encoded);
+          migrateLink.href = targetUrl.toString();
+        } catch {
+          // Fallback to static href
+        }
+      }
+
+      // Listen for cross-origin configuration transfer messages between old and new origins
+      window.addEventListener('message', (event) => {
+        if (!isTrustedMigrationOrigin(event)) return;
+        const data = event.data;
+        if (!data || typeof data !== 'object') return;
+
+        if (data.type === 'REQUEST_USER_CONFIG' && event.source) {
+          const targetOrigin = event.origin && event.origin !== 'null' ? event.origin : NEW_ORIGIN;
+          event.source.postMessage(
+            {
+              type: 'SYNC_USER_CONFIG',
+              config: loadConfig(),
+            },
+            targetOrigin
+          );
+        } else if (data.type === 'SYNC_USER_CONFIG' && data.config) {
+          saveConfig(data.config, 'Configuration synced from previous origin.');
+        }
+      });
+
+      const initialConfig = loadConfig();
+      if (roastSelect && initialConfig.roast) roastSelect.value = initialConfig.roast;
+      if (milkSelect && initialConfig.milk) milkSelect.value = initialConfig.milk;
+      updateMigrationLink(initialConfig);
+
+      [roastSelect, milkSelect].forEach((el) => {
+        if (!el) return;
+        el.addEventListener('change', () => {
+          saveConfig(getCurrentConfig(), 'Preferences saved and ready for origin transfer.');
+        });
+      });
+
+      if (syncBtn) {
+        syncBtn.addEventListener('click', () => {
+          const config = getCurrentConfig();
+          saveConfig(config, 'Preferences encoded into migration handoff link.');
+          if (window.opener) {
+            window.opener.postMessage({ type: 'SYNC_USER_CONFIG', config }, NEW_ORIGIN);
+          }
+        });
+      }
+
+      if (dismissBtn && banner) {
+        dismissBtn.addEventListener('click', () => {
+          banner.hidden = true;
+        });
+      }
+    })();
+  </script>
 </body>
 
 </html>
