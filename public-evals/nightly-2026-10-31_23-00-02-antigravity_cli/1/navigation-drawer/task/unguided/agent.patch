+  <script>
+    const drawer = document.getElementById('drawer-menu');
+    const menuBtn = document.getElementById('menu-btn');
+    const dismissSnap = drawer.querySelector('.drawer-snap-dismiss');
+
+    function closeFromSwipe() {
+      if (!drawer.matches(':popover-open')) return;
+      drawer.dataset.swiped = 'true';
+      drawer.hidePopover();
+      drawer.scrollLeft = 0;
+      requestAnimationFrame(() => {
+        delete drawer.dataset.swiped;
+      });
+    }
+
+    // Keep aria-expanded and scroll snap position synchronized with Popover state
+    drawer.addEventListener('beforetoggle', (event) => {
+      if (event.newState === 'open') {
+        delete drawer.dataset.swiped;
+        drawer.scrollLeft = 0;
+      }
+    });
+
+    drawer.addEventListener('toggle', (event) => {
+      const isOpen = event.newState === 'open';
+      menuBtn.setAttribute('aria-expanded', String(isOpen));
+      if (isOpen) {
+        drawer.scrollLeft = 0;
+      }
+    });
+
+    // Native CSS Scroll Snap dismissal via scrollsnapchange and scrollend
+    if ('onscrollsnapchange' in window) {
+      drawer.addEventListener('scrollsnapchange', (event) => {
+        if (event.snapTargetInline === dismissSnap) {
+          closeFromSwipe();
+        }
+      });
+    }
+
+    drawer.addEventListener('scrollend', () => {
+      if (drawer.scrollLeft >= drawer.clientWidth * 0.4) {
+        closeFromSwipe();
+      }
+    });
+
+    // Pointer / touch swipe fallback for environments without native touch scroll momentum
+    let startX = null;
+    let startY = null;
+    let currentX = null;
+    let currentY = null;
+
+    drawer.addEventListener('touchstart', (e) => {
+      if (e.touches.length !== 1) return;
+      startX = e.touches[0].clientX;
+      startY = e.touches[0].clientY;
+      currentX = startX;
+      currentY = startY;
+    }, { passive: true });
+
+    drawer.addEventListener('touchmove', (e) => {
+      if (startX === null || e.touches.length !== 1) return;
+      currentX = e.touches[0].clientX;
+      currentY = e.touches[0].clientY;
+    }, { passive: true });
+
+    drawer.addEventListener('touchend', () => {
+      if (startX === null || currentX === null) return;
+      const dx = currentX - startX;
+      const dy = Math.abs(currentY - startY);
+      startX = null;
+      currentX = null;
+      if (dx < -50 && Math.abs(dx) > dy && drawer.scrollLeft === 0) {
+        closeFromSwipe();
+      }
+    }, { passive: true });
+
+    drawer.addEventListener('pointerdown', (e) => {
+      if (e.pointerType !== 'mouse') return;
+      startX = e.clientX;
+      startY = e.clientY;
+      currentX = startX;
+      currentY = startY;
+    });
+
+    drawer.addEventListener('pointermove', (e) => {
+      if (e.pointerType !== 'mouse' || startX === null) return;
+      currentX = e.clientX;
+      currentY = e.clientY;
+    });
+
+    drawer.addEventListener('pointerup', (e) => {
+      if (e.pointerType !== 'mouse' || startX === null) return;
+      const dx = e.clientX - startX;
+      const dy = Math.abs(e.clientY - startY);
+      startX = null;
+      if (dx < -50 && Math.abs(dx) > dy) {
+        closeFromSwipe();
+      }
+    });
+
+    // Clicking the dismiss snap area also closes the drawer
+    drawer.addEventListener('click', (e) => {
+      if (e.target === drawer || e.target === dismissSnap) {
+        drawer.hidePopover();
+      }
+    });
+  </script>
