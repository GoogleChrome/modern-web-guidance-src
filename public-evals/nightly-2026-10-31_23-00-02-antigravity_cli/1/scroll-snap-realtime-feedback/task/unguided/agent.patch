+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+      let activeIndex = 0;
+      let pendingIndex = -1;
+      let snapEventActive = false;
+
+      function setPending(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        pendingIndex = index;
+        thumbnails.forEach((thumb, i) => {
+          thumb.classList.toggle('pending', i === index);
+        });
+      }
+
+      function setActive(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        activeIndex = index;
+        pendingIndex = -1;
+        snapEventActive = false;
+        thumbnails.forEach((thumb, i) => {
+          thumb.classList.remove('pending');
+          if (i === index) {
+            thumb.classList.add('active');
+            thumb.setAttribute('aria-current', 'true');
+          } else {
+            thumb.classList.remove('active');
+            thumb.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function getNearestIndex(scrollLeft) {
+        let bestIndex = 0;
+        let minDistance = Infinity;
+        items.forEach((item, i) => {
+          const dist = Math.abs(item.offsetLeft - scrollLeft);
+          if (dist < minDistance) {
+            minDistance = dist;
+            bestIndex = i;
+          }
+        });
+        return bestIndex;
+      }
+
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        const target = event.snapTargetInline || event.snapTargetBlock;
+        const index = items.indexOf(target);
+        if (index !== -1) {
+          snapEventActive = true;
+          setPending(index);
+        }
+      });
+
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const target = event.snapTargetInline || event.snapTargetBlock;
+        const index = items.indexOf(target);
+        if (index !== -1) {
+          setActive(index);
+        }
+      });
+
+      gallery.addEventListener('scroll', () => {
+        if (snapEventActive) return;
+        const currentScroll = gallery.scrollLeft;
+        const activeOffset = items[activeIndex] ? items[activeIndex].offsetLeft : 0;
+        const diff = currentScroll - activeOffset;
+        if (Math.abs(diff) <= 2) return;
+
+        let targetIndex = getNearestIndex(currentScroll);
+        if (targetIndex === activeIndex) {
+          if (diff > 0 && activeIndex + 1 < items.length) {
+            targetIndex = activeIndex + 1;
+          } else if (diff < 0 && activeIndex - 1 >= 0) {
+            targetIndex = activeIndex - 1;
+          }
+        }
+        setPending(targetIndex);
+      });
+
+      gallery.addEventListener('scrollend', () => {
+        const nearest = getNearestIndex(gallery.scrollLeft);
+        const index = (nearest === activeIndex && pendingIndex !== -1 && gallery.scrollLeft === (items[activeIndex] ? items[activeIndex].offsetLeft : 0))
+          ? pendingIndex
+          : nearest;
+        setActive(index);
+      });
+
+      const origScrollTo = gallery.scrollTo.bind(gallery);
+      gallery.scrollTo = function (optionsOrX, y) {
+        let targetLeft = gallery.scrollLeft;
+        let behavior = 'smooth';
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          if (typeof optionsOrX.left === 'number') targetLeft = optionsOrX.left;
+          if (optionsOrX.behavior) behavior = optionsOrX.behavior;
+        } else if (typeof optionsOrX === 'number') {
+          targetLeft = optionsOrX;
+        }
+        if (Math.abs(targetLeft - gallery.scrollLeft) > 2 && behavior !== 'instant') {
+          const idx = getNearestIndex(targetLeft);
+          snapEventActive = true;
+          setPending(idx);
+        }
+        return origScrollTo(optionsOrX, y);
+      };
+
+      const origScrollBy = gallery.scrollBy.bind(gallery);
+      gallery.scrollBy = function (optionsOrX, y) {
+        let deltaLeft = 0;
+        let behavior = 'smooth';
+        if (typeof optionsOrX === 'object' && optionsOrX !== null) {
+          if (typeof optionsOrX.left === 'number') deltaLeft = optionsOrX.left;
+          if (optionsOrX.behavior) behavior = optionsOrX.behavior;
+        } else if (typeof optionsOrX === 'number') {
+          deltaLeft = optionsOrX;
+        }
+        const targetLeft = gallery.scrollLeft + deltaLeft;
+        if (Math.abs(deltaLeft) > 2 && behavior !== 'instant') {
+          const idx = getNearestIndex(targetLeft);
+          snapEventActive = true;
+          setPending(idx);
+        }
+        return origScrollBy(optionsOrX, y);
+      };
+
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          const targetLeft = items[index].offsetLeft;
+          if (Math.abs(gallery.scrollLeft - targetLeft) > 2) {
+            gallery.scrollTo({ left: targetLeft, behavior: 'smooth' });
+          } else {
+            setActive(index);
+          }
+        });
+      });
+    })();
+  </script>
+
