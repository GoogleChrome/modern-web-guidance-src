+  <script>
+    (function () {
+      const progressBar = document.querySelector('.scroll-progress');
+      if (!progressBar) return;
+
+      const supportsScrollTimeline =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        (CSS.supports('animation-timeline: scroll()') ||
+          CSS.supports('animation-timeline: scroll(root)'));
+
+      let ticking = false;
+
+      function updateScrollProgress() {
+        const scrollTop = window.scrollY || document.documentElement.scrollTop;
+        const scrollHeight =
+          document.documentElement.scrollHeight - document.documentElement.clientHeight;
+        const progress =
+          scrollHeight > 0 ? Math.min(Math.max(scrollTop / scrollHeight, 0), 1) : 0;
+
+        progressBar.style.setProperty('--scroll-progress', progress);
+        progressBar.setAttribute('aria-valuenow', Math.round(progress * 100));
+
+        if (!supportsScrollTimeline) {
+          progressBar.style.transform = `scaleX(${progress})`;
+        }
+
+        ticking = false;
+      }
+
+      function onScroll() {
+        if (!ticking) {
+          window.requestAnimationFrame(updateScrollProgress);
+          ticking = true;
+        }
+      }
+
+      window.addEventListener('scroll', onScroll, { passive: true });
+      window.addEventListener('resize', onScroll, { passive: true });
+      updateScrollProgress();
+    })();
+  </script>
