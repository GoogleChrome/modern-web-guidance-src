+            lotCode: 'Single Origin #ET-18H',
+            title: 'Yirgacheffe Kochere Washing Station',
+            story: 'Heirloom Ethiopian varietals dried on raised African beds yield delicate bergamot and dark berry aromatics that shine when cold-extracted.',
+            elevation: '1,950 - 2,150 MASL',
+            process: 'Natural Raised-Bed Dried',
+            roastTemp: '406°F Medium-Light Omni'
+          }
+        }
+      };
+
+      const SLUG_ORDER = ['seasonal', 'espresso', 'cold-brew'];
+      const ALIAS_MAP = {
+        'maple-oat-latte': 'seasonal',
+        'seasonal': 'seasonal',
+        'dark-roast-espresso': 'espresso',
+        'espresso': 'espresso',
+        'cold-brew': 'cold-brew',
+        'coldbrew': 'cold-brew'
+      };
+
+      // DOM Elements
+      const navStack = document.getElementById('navStack');
+      const screenHome = document.getElementById('screenHome');
+      const screenDetail = document.getElementById('screenDetail');
+      const screenSubDetail = document.getElementById('screenSubDetail');
+      const edgeSwipeZone = document.getElementById('edgeSwipeZone');
+      const swipeHintPill = document.getElementById('swipeHintPill');
+      const toastEl = document.getElementById('toastNotification');
+
+      // Current Navigation State
+      let currentRoute = {
+        depth: 0,       // 0 = Home, 1 = Detail, 2 = Origin Sub-Detail
+        slug: null
+      };
+
+      // Customization State
+      let customization = {
+        sizeDelta: 0,
+        shotDelta: 0
+      };
+
+      function showToast(message) {
+        toastEl.textContent = message;
+        toastEl.classList.add('show');
+        clearTimeout(showToast._timer);
+        showToast._timer = setTimeout(() => {
+          toastEl.classList.remove('show');
+        }, 2600);
+      }
+
+      /**
+       * Parse current browser location (pathname, query param, or hash) into a stack route
+       */
+      function parseLocationToRoute(loc) {
+        const pathname = (loc.pathname || '/').replace(/\/+$/, '') || '/';
+        const hash = (loc.hash || '').replace(/^#\/?/, '');
+        const params = new URLSearchParams(loc.search || '');
+
+        // Check query parameters first (?item=seasonal&view=origin)
+        const queryItem = params.get('item') || params.get('drink');
+        if (queryItem && ALIAS_MAP[queryItem.toLowerCase()]) {
+          const slug = ALIAS_MAP[queryItem.toLowerCase()];
+          const isOrigin = params.get('view') === 'origin' || params.get('sub') === 'origin';
+          return { depth: isOrigin ? 2 : 1, slug };
+        }
+
+        // Check pathname e.g. /menu/seasonal or /menu/seasonal/origin
+        const pathMatch = pathname.match(/^\/menu\/([^/]+)(?:\/(origin))?$/i);
+        if (pathMatch) {
+          const rawSlug = pathMatch[1].toLowerCase();
+          const slug = ALIAS_MAP[rawSlug];
+          if (slug) {
+            return { depth: pathMatch[2] ? 2 : 1, slug };
+          }
+        }
+
+        // Check hash e.g. #/menu/seasonal or #seasonal
+        if (hash) {
+          const hashMatch = hash.match(/^(?:menu\/)?([^/]+)(?:\/(origin))?$/i);
+          if (hashMatch) {
+            const rawSlug = hashMatch[1].toLowerCase();
+            const slug = ALIAS_MAP[rawSlug];
+            if (slug) {
+              return { depth: hashMatch[2] ? 2 : 1, slug };
+            }
+          }
+        }
+
+        return { depth: 0, slug: null };
+      }
+
+      /**
+       * Build canonical path for a route
+       */
+      function buildPathForRoute(route) {
+        if (!route || route.depth === 0 || !route.slug) {
+          return '/';
+        }
+        if (route.depth === 2) {
+          return `/menu/${route.slug}/origin`;
+        }
+        return `/menu/${route.slug}`;
+      }
+
+      /**
+       * Render the Level 2 and Level 3 screens for a given Seasonal Favorites item slug
+       */
+      function renderDetailContent(slug) {
+        const item = SEASONAL_ITEMS[slug];
+        if (!item) return;
+
+        // Reset customization deltas on item switch
+        customization.sizeDelta = 0;
+        customization.shotDelta = 0;
+
+        document.getElementById('detailNavTitle').textContent = item.title;
+        document.getElementById('detailBreadcrumbCurrent').textContent = item.title;
+        const heroImg = document.getElementById('detailHeroImg');
+        heroImg.src = item.image;
+        heroImg.alt = item.title;
+
+        document.getElementById('detailCategoryBadge').textContent = item.badge;
+        document.getElementById('detailHeading').textContent = item.title;
+        document.getElementById('detailSubtitle').textContent = item.shortDesc;
+        document.getElementById('detailCaloriesBadge').textContent = item.calories;
+        document.getElementById('detailLongDescription').textContent = item.longDesc;
+
+        // Render Tasting Notes bars
+        const tastingGrid = document.getElementById('detailTastingGrid');
+        tastingGrid.innerHTML = item.tastingNotes.map(note => `
+          <div class="tasting-row">
+            <div class="tasting-label">
+              <span>${note.label}</span>
+              <span>${note.score}%</span>
+            </div>
+            <div class="tasting-bar-bg">
+              <div class="tasting-bar-fill" style="width: ${note.score}%"></div>
+            </div>
+          </div>
+        `).join('');
+
+        // Update Level 3 Origin trigger
+        const originLink = document.getElementById('originDrilldownLink');
+        originLink.setAttribute('href', `/menu/${item.slug}/origin`);
+        document.getElementById('originTeaserTitle').textContent = `Roast & Farm Origin: ${item.origin.title}`;
+
+        // Update Level 3 Screen Content
+        document.getElementById('subDetailBackBtn').setAttribute('href', item.path);
+        document.getElementById('subDetailBackLabel').textContent = item.title;
+        document.getElementById('subBreadcrumbParent').setAttribute('href', item.path);
+        document.getElementById('subBreadcrumbParent').textContent = item.title;
+        document.getElementById('originRegionPill').textContent = item.origin.lotCode;
+        document.getElementById('originFullTitle').textContent = item.origin.title;
+        document.getElementById('originStoryText').textContent = item.origin.story;
+        document.getElementById('originElevation').textContent = item.origin.elevation;
+        document.getElementById('originProcess').textContent = item.origin.process;
+        document.getElementById('originRoastTemp').textContent = item.origin.roastTemp;
+
+        // Reset segmented buttons
+        document.querySelectorAll('#sizeOptions .seg-btn').forEach((btn, idx) => {
+          btn.classList.toggle('active', idx === 1);
+        });
+        document.querySelectorAll('#shotOptions .seg-btn').forEach((btn, idx) => {
+          btn.classList.toggle('active', idx === 0);
+        });
+        document.querySelectorAll('#tempOptions .seg-btn').forEach((btn) => {
+          btn.classList.toggle('active', btn.dataset.temp === item.defaultTemp);
+        });
+
+        updateDisplayedPrice(item.basePrice);
+
+        // Render Prev / Next sibling seasonal items
+        const idx = SLUG_ORDER.indexOf(slug);
+        const prevSlug = SLUG_ORDER[(idx - 1 + SLUG_ORDER.length) % SLUG_ORDER.length];
+        const nextSlug = SLUG_ORDER[(idx + 1) % SLUG_ORDER.length];
+        const prevItem = SEASONAL_ITEMS[prevSlug];
+        const nextItem = SEASONAL_ITEMS[nextSlug];
+
+        const siblingContainer = document.getElementById('siblingNavContainer');
+        siblingContainer.innerHTML = `
+          <a href="${prevItem.path}" class="sibling-link" data-drill-slug="${prevItem.slug}">
+            <small>&larr; Previous Seasonal</small>
+            <strong>${prevItem.title}</strong>
+          </a>
+          <a href="${nextItem.path}" class="sibling-link" data-drill-slug="${nextItem.slug}" style="text-align: right;">
+            <small>Next Seasonal &rarr;</small>
+            <strong>${nextItem.title}</strong>
+          </a>
+        `;
+      }
+
+      function updateDisplayedPrice(basePrice) {
+        const total = (basePrice + customization.sizeDelta + customization.shotDelta).toFixed(2);
+        document.getElementById('detailLivePrice').textContent = `$${total}`;
+        document.getElementById('orderBtnPrice').textContent = `$${total}`;
+      }
+
+      /**
+       * Apply route state to the visual navigation stack
+       */
+      function applyRouteToStack(route, options = { updateHistory: false, replaceHistory: false }) {
+        const prevDepth = currentRoute.depth;
+        const prevSlug = currentRoute.slug;
+
+        if (route.slug && SEASONAL_ITEMS[route.slug]) {
+          if (route.slug !== prevSlug) {
+            renderDetailContent(route.slug);
+          }
+        }
+
+        currentRoute = {
+          depth: route.depth,
+          slug: route.slug
+        };
+
+        // Keep temporary visibility during slide-out transition
+        if (prevDepth >= 1 && route.depth === 0) {
+          screenDetail.classList.add('is-animating');
+          setTimeout(() => screenDetail.classList.remove('is-animating'), 400);
+        }
+        if (prevDepth === 2 && route.depth < 2) {
+          screenSubDetail.classList.add('is-animating');
+          setTimeout(() => screenSubDetail.classList.remove('is-animating'), 400);
+        }
+
+        navStack.dataset.depth = String(route.depth);
+        navStack.classList.toggle('has-detail', route.depth >= 1);
+        navStack.classList.toggle('has-subdetail', route.depth >= 2);
+
+        screenHome.setAttribute('aria-hidden', route.depth > 0 ? 'true' : 'false');
+        screenDetail.setAttribute('aria-hidden', route.depth === 1 ? 'false' : 'true');
+        screenSubDetail.setAttribute('aria-hidden', route.depth === 2 ? 'false' : 'true');
+
+        if (route.depth === 1) {
+          screenDetail.scrollTop = 0;
+        } else if (route.depth === 2) {
+          screenSubDetail.scrollTop = 0;
+        }
+
+        const canonicalPath = buildPathForRoute(route);
+        document.getElementById('activeDeepLinkText').textContent = canonicalPath;
+
+        // Update document title
+        if (route.depth === 0) {
+          document.title = 'The Daily Grind | Artisanal Coffee';
+        } else {
+          const item = SEASONAL_ITEMS[route.slug];
+          const suffix = route.depth === 2 ? 'Origin & Roast' : 'Seasonal Favorites';
+          document.title = `${item.title} (${suffix}) | The Daily Grind`;
+        }
+
+        // Sync with Browser History API
+        if (options.updateHistory) {
+          const statePayload = { depth: route.depth, slug: route.slug, path: canonicalPath };
+          try {
+            if (options.replaceHistory) {
+              window.history.replaceState(statePayload, '', canonicalPath);
+            } else {
+              window.history.pushState(statePayload, '', canonicalPath);
+            }
+          } catch (err) {
+            // Fallback to location.hash if pushState on pathname is restricted
+            window.location.hash = canonicalPath === '/' ? '' : `#${canonicalPath}`;
+          }
+        }
+      }
+
+      /**
+       * Navigate forward/drill-down into a specific route
+       */
+      function navigateTo(route) {
+        if (route.depth === currentRoute.depth && route.slug === currentRoute.slug) {
+          return;
+        }
+        applyRouteToStack(route, { updateHistory: true, replaceHistory: false });
+      }
+
+      /**
+       * Navigate one level back in the hierarchy in sync with browser history
+       */
+      function navigateBackOneLevel() {
+        if (currentRoute.depth === 0) return;
+
+        // If we pushed states inside this session, history.back() keeps browser Forward/Back buttons in exact sync
+        if (window.history.state && window.history.state.fromStackPush) {
+          window.history.back();
+          return;
+        }
+
+        // If user landed directly via a deep link, compute parent route and push/replace
+        if (currentRoute.depth === 2) {
+          applyRouteToStack({ depth: 1, slug: currentRoute.slug }, { updateHistory: true });
+        } else {
+          applyRouteToStack({ depth: 0, slug: null }, { updateHistory: true });
+        }
+      }
+
+      /**
+       * Enhanced push helper that marks internal stack history entries
+       */
+      function drillDownToSlug(slug, depth = 1) {
+        if (!SEASONAL_ITEMS[slug]) return;
+        const route = { depth, slug };
+        const canonicalPath = buildPathForRoute(route);
+        applyRouteToStack(route, { updateHistory: false });
+        try {
+          window.history.pushState(
+            { depth, slug, path: canonicalPath, fromStackPush: true },
+            '',
+            canonicalPath
+          );
+        } catch (e) {
+          window.location.hash = `#${canonicalPath}`;
+        }
+      }
+
+      // Click Delegation for Seasonal Cards, Links, and Back Controls
+      document.addEventListener('click', (e) => {
+        // 1. Check for drill-down item triggers
+        const drillTrigger = e.target.closest('[data-drill-slug]');
+        if (drillTrigger) {
+          e.preventDefault();
+          const slug = drillTrigger.getAttribute('data-drill-slug');
+          drillDownToSlug(slug, 1);
+          return;
+        }
+
+        // 2. Check for Level 3 Origin drill-down trigger
+        const originTrigger = e.target.closest('#originDrilldownLink');
+        if (originTrigger) {
+          e.preventDefault();
+          if (currentRoute.slug) {
+            drillDownToSlug(currentRoute.slug, 2);
+          }
+          return;
+        }
+
+        // 3. Check for Pop to Root triggers
+        const popRootTrigger = e.target.closest('[data-action="pop-root"], #homeLogo');
+        if (popRootTrigger) {
+          e.preventDefault();
+          if (currentRoute.depth > 0) {
+            applyRouteToStack({ depth: 0, slug: null }, { updateHistory: true });
+          }
+          return;
+        }
+
+        // 4. Intercept top-nav / footer standard links so SPA doesn't 404
+        const navRootLink = e.target.closest('[data-nav-root]');
+        if (navRootLink) {
+          e.preventDefault();
+          const label = navRootLink.textContent.trim();
+          showToast(`Viewing ${label} section on The Daily Grind`);
+          return;
+        }
+      });
+
+      // Keyboard Accessibility on Cards (Enter / Space) & Escape to pop back
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && currentRoute.depth > 0) {
+          e.preventDefault();
+          navigateBackOneLevel();
+          return;
+        }
+        if ((e.key === 'Enter' || e.key === ' ') && e.target.matches('.card[data-drill-slug]')) {
+          e.preventDefault();
+          drillDownToSlug(e.target.getAttribute('data-drill-slug'), 1);
+        }
+      });
+
+      // Back Buttons in Level 2 and Level 3 headers
+      document.getElementById('detailBackBtn').addEventListener('click', (e) => {
+        e.preventDefault();
+        navigateBackOneLevel();
+      });
+
+      document.getElementById('secondaryBackBtn').addEventListener('click', (e) => {
+        e.preventDefault();
+        navigateBackOneLevel();
+      });
+
+      document.getElementById('subDetailBackBtn').addEventListener('click', (e) => {
+        e.preventDefault();
+        navigateBackOneLevel();
+      });
+
+      document.getElementById('subDetailPopOneBtn').addEventListener('click', (e) => {
+        e.preventDefault();
+        navigateBackOneLevel();
+      });
+
+      document.getElementById('subBreadcrumbParent').addEventListener('click', (e) => {
+        e.preventDefault();
+        if (currentRoute.depth === 2) {
+          navigateBackOneLevel();
+        }
+      });
+
+      // Interactive Customization Options
+      document.getElementById('sizeOptions').addEventListener('click', (e) => {
+        const btn = e.target.closest('.seg-btn');
+        if (!btn || !currentRoute.slug) return;
+        document.querySelectorAll('#sizeOptions .seg-btn').forEach(b => b.classList.remove('active'));
+        btn.classList.add('active');
+        customization.sizeDelta = parseFloat(btn.dataset.delta || '0');
+        updateDisplayedPrice(SEASONAL_ITEMS[currentRoute.slug].basePrice);
+      });
+
+      document.getElementById('tempOptions').addEventListener('click', (e) => {
+        const btn = e.target.closest('.seg-btn');
+        if (!btn) return;
+        document.querySelectorAll('#tempOptions .seg-btn').forEach(b => b.classList.remove('active'));
+        btn.classList.add('active');
+      });
+
+      document.getElementById('shotOptions').addEventListener('click', (e) => {
+        const btn = e.target.closest('.seg-btn');
+        if (!btn || !currentRoute.slug) return;
+        document.querySelectorAll('#shotOptions .seg-btn').forEach(b => b.classList.remove('active'));
+        btn.classList.add('active');
+        customization.shotDelta = parseFloat(btn.dataset.delta || '0');
+        updateDisplayedPrice(SEASONAL_ITEMS[currentRoute.slug].basePrice);
+      });
+
+      document.getElementById('addToOrderBtn').addEventListener('click', () => {
+        if (!currentRoute.slug) return;
+        const item = SEASONAL_ITEMS[currentRoute.slug];
+        const size = document.querySelector('#sizeOptions .seg-btn.active')?.dataset.size || 'Medium';
+        const temp = document.querySelector('#tempOptions .seg-btn.active')?.dataset.temp || 'Hot';
+        showToast(`Added ${size} ${temp} ${item.title} to your order!`);
+      });
+
+      // Share / Copy Deep Link buttons
+      function copyCurrentDeepLink() {
+        const url = window.location.href;
+        if (navigator.clipboard && navigator.clipboard.writeText) {
+          navigator.clipboard.writeText(url).then(() => {
+            showToast(`Copied deep link: ${buildPathForRoute(currentRoute)}`);
+          }).catch(() => {
+            showToast(`Deep link ready: ${buildPathForRoute(currentRoute)}`);
+          });
+        } else {
+          showToast(`Deep link ready: ${buildPathForRoute(currentRoute)}`);
+        }
+      }
+
+      document.getElementById('copyDeepLinkBtn').addEventListener('click', copyCurrentDeepLink);
+      document.getElementById('inlineCopyBtn').addEventListener('click', copyCurrentDeepLink);
+
+      // Browser History Popstate & Hashchange Synchronization
+      window.addEventListener('popstate', (event) => {
+        if (event.state && typeof event.state.depth === 'number') {
+          applyRouteToStack(
+            { depth: event.state.depth, slug: event.state.slug },
+            { updateHistory: false }
+          );
+        } else {
+          const parsed = parseLocationToRoute(window.location);
+          applyRouteToStack(parsed, { updateHistory: false });
+        }
+      });
+
+      window.addEventListener('hashchange', () => {
+        const parsed = parseLocationToRoute(window.location);
+        applyRouteToStack(parsed, { updateHistory: false });
+      });
+
+      // Touch & Pointer Swipe-Back Gesture Implementation
+      let gestureState = {
+        active: false,
+        startX: 0,
+        startY: 0,
+        currentX: 0,
+        isHorizontalSwipe: null,
+        activeScreenEl: null,
+        underScreenEl: null
+      };
+
+      function getActiveScreenElements() {
+        if (currentRoute.depth === 2) {
+          return { active: screenSubDetail, under: screenDetail };
+        }
+        if (currentRoute.depth === 1) {
+          return { active: screenDetail, under: screenHome };
+        }
+        return null;
+      }
+
+      function onSwipeStart(clientX, clientY, fromEdgeZone) {
+        if (currentRoute.depth === 0) return;
+        const screens = getActiveScreenElements();
+        if (!screens) return;
+
+        // Allow starting swipe from left edge zone or anywhere if horizontal flick right
+        gestureState.active = true;
+        gestureState.startX = clientX;
+        gestureState.startY = clientY;
+        gestureState.currentX = clientX;
+        gestureState.isHorizontalSwipe = fromEdgeZone ? true : null;
+        gestureState.activeScreenEl = screens.active;
+        gestureState.underScreenEl = screens.under;
+      }
+
+      function onSwipeMove(clientX, clientY) {
+        if (!gestureState.active || !gestureState.activeScreenEl) return;
+
+        const deltaX = clientX - gestureState.startX;
+        const deltaY = clientY - gestureState.startY;
+
+        if (gestureState.isHorizontalSwipe === null) {
+          if (Math.abs(deltaX) < 10 && Math.abs(deltaY) < 10) return;
+          // Only lock as horizontal back-swipe if moving rightward and horizontal > vertical
+          if (deltaX > 12 && Math.abs(deltaX) > Math.abs(deltaY) * 1.35) {
+            gestureState.isHorizontalSwipe = true;
+          } else {
+            gestureState.active = false;
+            return;
+          }
+        }
+
+        if (!gestureState.isHorizontalSwipe) return;
+
+        const clampedX = Math.max(0, deltaX);
+        gestureState.currentX = clientX;
+
+        const viewportWidth = window.innerWidth || 375;
+        const progress = Math.min(1, clampedX / viewportWidth);
+
+        gestureState.activeScreenEl.classList.add('is-dragging');
+        gestureState.underScreenEl.classList.add('is-dragging');
+
+        // Translate active screen rightwards with finger/pointer
+        gestureState.activeScreenEl.style.transform = `translate3d(${clampedX}px, 0, 0)`;
+
+        // Parallax-restore underlying screen smoothly toward 0%
+        const underOffset = -26 * (1 - progress);
+        const underScale = 0.96 + 0.04 * progress;
+        const underBrightness = 0.72 + 0.28 * progress;
+        gestureState.underScreenEl.style.transform = `translate3d(${underOffset}%, 0, 0) scale(${underScale})`;
+        gestureState.underScreenEl.style.filter = `brightness(${underBrightness})`;
+
+        swipeHintPill.classList.toggle('visible', clampedX > 90);
+      }
+
+      function onSwipeEnd() {
+        if (!gestureState.active) return;
+
+        const deltaX = gestureState.currentX - gestureState.startX;
+        const wasHorizontal = gestureState.isHorizontalSwipe;
+        const activeEl = gestureState.activeScreenEl;
+        const underEl = gestureState.underScreenEl;
+
+        gestureState.active = false;
+        swipeHintPill.classList.remove('visible');
+
+        if (activeEl) {
+          activeEl.classList.remove('is-dragging');
+          activeEl.style.transform = '';
+        }
+        if (underEl) {
+          underEl.classList.remove('is-dragging');
+          underEl.style.transform = '';
+          underEl.style.filter = '';
+        }
+
+        const threshold = Math.min(110, (window.innerWidth || 375) * 0.26);
+        if (wasHorizontal && deltaX > threshold) {
+          navigateBackOneLevel();
+        }
+      }
+
+      // Touch Events (Mobile / Tablet / Touchscreens)
+      navStack.addEventListener('touchstart', (e) => {
+        if (e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        onSwipeStart(touch.clientX, touch.clientY, touch.clientX <= 40);
+      }, { passive: true });
+
+      navStack.addEventListener('touchmove', (e) => {
+        if (!gestureState.active || e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        onSwipeMove(touch.clientX, touch.clientY);
+      }, { passive: true });
+
+      navStack.addEventListener('touchend', onSwipeEnd);
+      navStack.addEventListener('touchcancel', onSwipeEnd);
+
+      // Mouse / Pointer Drag from Edge Zone or Detail Screen
+      edgeSwipeZone.addEventListener('pointerdown', (e) => {
+        onSwipeStart(e.clientX, e.clientY, true);
+      });
+
+      navStack.addEventListener('pointerdown', (e) => {
+        if (currentRoute.depth === 0) return;
+        // Ignore interactive controls
+        if (e.target.closest('a, button, input, select, textarea')) return;
+        onSwipeStart(e.clientX, e.clientY, e.clientX <= 40);
+      });
+
+      window.addEventListener('pointermove', (e) => {
+        if (!gestureState.active) return;
+        onSwipeMove(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointerup', onSwipeEnd);
+
+      // Initial Deep-Link Bootstrapping on Page Load
+      const initialRoute = parseLocationToRoute(window.location);
+      if (initialRoute.depth > 0 && initialRoute.slug) {
+        // Seed initial state in history so back navigation has state context
+        applyRouteToStack(initialRoute, { updateHistory: true, replaceHistory: true });
+      } else {
+        applyRouteToStack({ depth: 0, slug: null }, { updateHistory: false });
+      }
+    })();
+  </script>
