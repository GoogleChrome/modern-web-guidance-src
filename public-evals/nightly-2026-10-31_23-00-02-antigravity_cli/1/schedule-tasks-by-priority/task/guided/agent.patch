+  <script>
+    const statusEl = document.getElementById('scheduler-status');
+    const queueCountEl = document.getElementById('queue-count');
+    const completedCountEl = document.getElementById('completed-count');
+    const logListEl = document.getElementById('ops-log');
+    const btnUrgent = document.getElementById('btn-urgent-checkout');
+    const btnStandard = document.getElementById('btn-standard-menu');
+    const btnBackground = document.getElementById('btn-background-telemetry');
+    const btnBatch = document.getElementById('btn-batch-mixed');
+    const btnClear = document.getElementById('btn-clear-log');
+
+    let pendingTasks = 0;
+    let completedTasks = 0;
+    let taskCounter = 0;
+
+    let schedulerReadyPromise;
+    if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+      statusEl.textContent = 'Loading scheduler polyfill...';
+      schedulerReadyPromise = new Promise((resolve) => {
+        const script = document.createElement('script');
+        script.src = 'https://unpkg.com/scheduler-polyfill';
+        script.onload = () => {
+          statusEl.textContent = 'Ready (Polyfill Active)';
+          resolve();
+        };
+        script.onerror = () => {
+          statusEl.textContent = 'Ready (Fallback Mode)';
+          resolve();
+        };
+        document.head.appendChild(script);
+      });
+    } else {
+      statusEl.textContent = 'Ready (Native Scheduler API)';
+      schedulerReadyPromise = Promise.resolve();
+    }
+
+    function updateCounters() {
+      queueCountEl.textContent = String(pendingTasks);
+      completedCountEl.textContent = String(completedTasks);
+    }
+
+    function appendLogItem(id, label, priority, stateText) {
+      const emptyState = document.getElementById('ops-empty-state');
+      if (emptyState) {
+        emptyState.remove();
+      }
+      const li = document.createElement('li');
+      li.className = 'ops-log-item';
+      li.id = `task-log-${id}`;
+      li.dataset.priority = priority;
+
+      const leftSpan = document.createElement('span');
+      const badge = document.createElement('span');
+      badge.className = `ops-badge badge-${priority}`;
+      badge.textContent = priority;
+
+      const textNode = document.createTextNode(`#${id} ${label}`);
+      leftSpan.appendChild(badge);
+      leftSpan.appendChild(textNode);
+
+      const rightSpan = document.createElement('span');
+      rightSpan.className = 'ops-state';
+      rightSpan.textContent = stateText;
+
+      li.appendChild(leftSpan);
+      li.appendChild(rightSpan);
+      logListEl.prepend(li);
+      return rightSpan;
+    }
+
+    // Break up long synchronous work using scheduler.yield() with a 50ms deadline budget
+    async function processWorkItems(items) {
+      let deadline = performance.now() + 50;
+
+      for (const item of items) {
+        // Simulate computational processing per item (~1.5ms)
+        const sliceEnd = performance.now() + 1.5;
+        while (performance.now() < sliceEnd) {
+          Math.sqrt(item * 1337);
+        }
+
+        // MANDATORY: Yield to the main thread periodically when the 50ms deadline is exceeded
+        if (performance.now() >= deadline) {
+          if ('scheduler' in window && 'yield' in window.scheduler) {
+            await scheduler.yield();
+          } else {
+            await new Promise(resolve => setTimeout(resolve, 0));
+          }
+          deadline = performance.now() + 50;
+        }
+      }
+    }
+
+    async function scheduleOperation(label, priority, itemCount) {
+      const taskId = ++taskCounter;
+      pendingTasks++;
+      updateCounters();
+
+      const stateSpan = appendLogItem(taskId, label, priority, 'Queued...');
+      await schedulerReadyPromise;
+
+      const items = Array.from({ length: itemCount }, (_, i) => i + 1);
+      const startTime = performance.now();
+
+      const runTask = async () => {
+        statusEl.textContent = `Running: ${label} (${priority})`;
+        stateSpan.textContent = 'Running...';
+        await processWorkItems(items);
+        const elapsed = Math.round(performance.now() - startTime);
+        stateSpan.textContent = `Completed (${elapsed}ms)`;
+        pendingTasks = Math.max(0, pendingTasks - 1);
+        completedTasks++;
+        updateCounters();
+        if (pendingTasks === 0) {
+          statusEl.textContent = 'Idle — All queued tasks finished';
+        }
+      };
+
+      if ('scheduler' in window && 'postTask' in window.scheduler) {
+        return scheduler.postTask(runTask, { priority });
+      } else {
+        return new Promise((resolve) => setTimeout(() => resolve(runTask()), 0));
+      }
+    }
+
+    btnUrgent.addEventListener('click', () => {
+      // Schedule a high-priority task that blocks user interaction
+      scheduleOperation('Urgent Checkout Processing', 'user-blocking', 25);
+    });
+
+    btnStandard.addEventListener('click', () => {
+      // Schedule a default priority task ('user-visible' by default)
+      scheduleOperation('Seasonal Menu Price & Stock Sync', 'user-visible', 45);
+    });
+
+    btnBackground.addEventListener('click', () => {
+      // Schedule a low-priority background task
+      scheduleOperation('Background Telemetry & Analytics Flush', 'background', 80);
+    });
+
+    btnBatch.addEventListener('click', () => {
+      // Enqueue mixed tasks in reverse urgency to demonstrate priority execution order:
+      // background -> user-visible -> user-blocking
+      scheduleOperation('Batch: Telemetry Log Aggregation', 'background', 60);
+      scheduleOperation('Batch: Menu Nutritional Update', 'user-visible', 40);
+      scheduleOperation('Batch: Express Order Checkout', 'user-blocking', 25);
+      scheduleOperation('Batch: Bean Inventory Sync', 'user-visible', 35);
+      scheduleOperation('Batch: VIP Payment Verification', 'user-blocking', 20);
+    });
+
+    btnClear.addEventListener('click', () => {
+      logListEl.innerHTML = '<li class="ops-log-item" id="ops-empty-state">No operations queued yet. Select a task above to begin.</li>';
+      completedTasks = 0;
+      updateCounters();
+    });
+  </script>
 </body>
 
