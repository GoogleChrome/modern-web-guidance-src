+  <script>
+    (function () {
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 1,
+        'user-visible': 2,
+        'background': 3
+      };
+
+      const TASK_CONFIGS = {
+        checkout: {
+          name: 'Urgent Checkout Task',
+          category: 'Checkout',
+          priority: 'user-blocking',
+          badgeClass: 'ops-badge-urgent',
+          label: 'user-blocking',
+          workMs: 24,
+          chunks: 3
+        },
+        menu: {
+          name: 'Standard Menu Update',
+          category: 'Menu Update',
+          priority: 'user-visible',
+          badgeClass: 'ops-badge-standard',
+          label: 'user-visible',
+          workMs: 24,
+          chunks: 3
+        },
+        telemetry: {
+          name: 'Background Telemetry Logging',
+          category: 'Telemetry',
+          priority: 'background',
+          badgeClass: 'ops-badge-background',
+          label: 'background',
+          workMs: 24,
+          chunks: 3
+        }
+      };
+
+      const statusTextEl = document.getElementById('ops-status-text');
+      const pendingCountEl = document.getElementById('ops-pending-count');
+      const completedCountEl = document.getElementById('ops-completed-count');
+      const logListEl = document.getElementById('ops-log-list');
+      const pingCountEl = document.getElementById('ui-ping-count');
+
+      let taskSequence = 0;
+      let pendingCount = 0;
+      let completedCount = 0;
+      let executionOrder = 0;
+      let uiPingCount = 0;
+
+      // Fallback priority queue when scheduler.postTask is unavailable
+      const fallbackQueue = [];
+      let fallbackScheduled = false;
+
+      function updateMetrics() {
+        pendingCountEl.textContent = String(pendingCount);
+        completedCountEl.textContent = String(completedCount);
+        statusTextEl.textContent = pendingCount > 0 ? 'Processing Queue...' : 'Idle';
+      }
+
+      function yieldToMain(priority) {
+        if (typeof window !== 'undefined' && window.scheduler) {
+          if (typeof window.scheduler.yield === 'function') {
+            return window.scheduler.yield();
+          }
+          if (typeof window.scheduler.postTask === 'function') {
+            return window.scheduler.postTask(() => {}, { priority: priority || 'user-visible' });
+          }
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      function schedulePrioritizedTask(callback, priority) {
+        if (typeof window !== 'undefined' && window.scheduler && typeof window.scheduler.postTask === 'function') {
+          return window.scheduler.postTask(callback, { priority });
+        }
+
+        return new Promise((resolve, reject) => {
+          fallbackQueue.push({
+            callback,
+            priority,
+            weight: PRIORITY_WEIGHTS[priority] || 2,
+            seq: ++taskSequence,
+            resolve,
+            reject
+          });
+
+          fallbackQueue.sort((a, b) => (a.weight - b.weight) || (a.seq - b.seq));
+
+          if (!fallbackScheduled) {
+            fallbackScheduled = true;
+            setTimeout(processFallbackQueue, 0);
+          }
+        });
+      }
+
+      async function processFallbackQueue() {
+        while (fallbackQueue.length > 0) {
+          const next = fallbackQueue.shift();
+          try {
+            const result = await next.callback();
+            next.resolve(result);
+          } catch (err) {
+            next.reject(err);
+          }
+        }
+        fallbackScheduled = false;
+      }
+
+      function performCpuChunk(durationMs) {
+        const start = performance.now();
+        let acc = 0;
+        while (performance.now() - start < durationMs) {
+          acc += Math.sqrt(start + acc);
+        }
+        return acc;
+      }
+
+      function createLogEntry(task, orderIndex) {
+        const emptyEl = document.getElementById('ops-log-empty');
+        if (emptyEl) {
+          emptyEl.remove();
+        }
+
+        const li = document.createElement('li');
+        li.className = 'ops-log-item';
+        li.setAttribute('data-priority', task.priority);
+        li.setAttribute('data-task-type', task.type);
+        li.setAttribute('data-order', String(orderIndex));
+
+        const left = document.createElement('div');
+        const badge = document.createElement('span');
+        badge.className = 'ops-badge ' + task.badgeClass;
+        badge.textContent = task.priority;
+
+        const title = document.createElement('strong');
+        title.textContent = '#' + orderIndex + ' ' + task.name;
+
+        left.appendChild(badge);
+        left.appendChild(title);
+
+        const right = document.createElement('span');
+        right.className = 'ops-task-meta';
+        right.textContent = 'Running...';
+
+        li.appendChild(left);
+        li.appendChild(right);
+        logListEl.appendChild(li);
+
+        return { li, right };
+      }
+
+      function enqueueTask(type, customLabel) {
+        const config = TASK_CONFIGS[type];
+        if (!config) return Promise.resolve();
+
+        const task = {
+          type,
+          name: customLabel || config.name,
+          priority: config.priority,
+          badgeClass: config.badgeClass,
+          workMs: config.workMs,
+          chunks: config.chunks
+        };
+
+        pendingCount++;
+        updateMetrics();
+
+        return schedulePrioritizedTask(async () => {
+          const currentOrder = ++executionOrder;
+          const startTime = performance.now();
+          const { li, right } = createLogEntry(task, currentOrder);
+
+          const chunkDuration = Math.max(2, Math.floor(task.workMs / task.chunks));
+          for (let i = 0; i < task.chunks; i++) {
+            performCpuChunk(chunkDuration);
+            if (i < task.chunks - 1) {
+              await yieldToMain(task.priority);
+            }
+          }
+
+          const elapsed = Math.max(1, Math.round(performance.now() - startTime));
+          right.textContent = 'Completed (' + elapsed + 'ms)';
+          li.setAttribute('data-status', 'completed');
+
+          pendingCount = Math.max(0, pendingCount - 1);
+          completedCount++;
+          updateMetrics();
+
+          return {
+            order: currentOrder,
+            name: task.name,
+            priority: task.priority,
+            elapsed
+          };
+        }, task.priority);
+      }
+
+      function runMixedBatch() {
+        // Queue mixed tasks in non-priority order so the scheduler executes them in priority order:
+        // 1. user-blocking (Urgent Checkout Task)
+        // 2. user-visible (Standard Menu Update)
+        // 3. background (Background Telemetry Logging)
+        return Promise.all([
+          enqueueTask('telemetry', 'Background Telemetry Logging (Batch)'),
+          enqueueTask('menu', 'Standard Menu Update (Batch)'),
+          enqueueTask('checkout', 'Urgent Checkout Task (Batch)'),
+          enqueueTask('telemetry', 'Background Telemetry Sync (Batch)'),
+          enqueueTask('menu', 'Standard Menu Price Refresh (Batch)'),
+          enqueueTask('checkout', 'Urgent Express Checkout (Batch)')
+        ]);
+      }
+
+      function clearQueueLog() {
+        executionOrder = 0;
+        completedCount = 0;
+        logListEl.innerHTML = '<li id="ops-log-empty" class="ops-log-empty">No operations executed yet. Select a task or run a mixed batch above.</li>';
+        updateMetrics();
+      }
+
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        enqueueTask('checkout');
+      });
+
+      document.getElementById('btn-standard-menu').addEventListener('click', () => {
+        enqueueTask('menu');
+      });
+
+      document.getElementById('btn-background-telemetry').addEventListener('click', () => {
+        enqueueTask('telemetry');
+      });
+
+      document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+        runMixedBatch();
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', () => {
+        clearQueueLog();
+      });
+
+      document.getElementById('btn-ui-ping').addEventListener('click', () => {
+        uiPingCount++;
+        pingCountEl.textContent = String(uiPingCount);
+      });
+    })();
+  </script>
 </body>
 
 </html>
