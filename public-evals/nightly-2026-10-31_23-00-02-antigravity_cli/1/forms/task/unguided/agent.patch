+      });
+
+      function validateStep(stepNumber) {
+        const stepFieldset = steps[stepNumber - 1];
+        if (!stepFieldset) return true;
+
+        const inputs = Array.from(stepFieldset.querySelectorAll('input, select, textarea')).filter(function (el) {
+          return el.type !== 'hidden' && !el.disabled;
+        });
+
+        const errors = [];
+        const seenRadioGroups = new Set();
+
+        inputs.forEach(function (input) {
+          if (input.type === 'radio') {
+            if (seenRadioGroups.has(input.name)) return;
+            seenRadioGroups.add(input.name);
+            const checked = stepFieldset.querySelector('input[name="' + input.name + '"]:checked');
+            const brewError = document.getElementById('favorite-brew-error');
+            if (!checked) {
+              if (brewError) brewError.textContent = 'Please select your preferred drink style.';
+              errors.push({ id: input.id, message: 'Please select your preferred drink style.' });
+            } else if (brewError) {
+              brewError.textContent = '';
+            }
+            return;
+          }
+
+          if (fieldMeta[input.id]) {
+            const valid = validateField(input);
+            if (!valid) {
+              const errEl = document.getElementById(fieldMeta[input.id].errorId);
+              errors.push({
+                id: input.id,
+                message: errEl ? errEl.textContent : 'Invalid field'
+              });
+            }
+          }
+        });
+
+        renderErrorSummary(errors);
+        return errors.length === 0;
+      }
+
+      function renderErrorSummary(errors) {
+        errorSummaryList.textContent = '';
+        if (!errors || errors.length === 0) {
+          errorSummary.hidden = true;
+          return;
+        }
+
+        errors.forEach(function (err) {
+          const li = document.createElement('li');
+          const link = document.createElement('a');
+          link.href = '#' + err.id;
+          link.textContent = err.message;
+          link.addEventListener('click', function (e) {
+            e.preventDefault();
+            const target = document.getElementById(err.id);
+            if (target) target.focus();
+          });
+          li.appendChild(link);
+          errorSummaryList.appendChild(li);
+        });
+
+        errorSummary.hidden = false;
+        errorSummary.focus();
+      }
+
+      // Safely populate review summary using textContent (XSS-safe)
+      function populateReviewSummary() {
+        const firstName = document.getElementById('first-name').value.trim();
+        const lastName = document.getElementById('last-name').value.trim();
+        const email = document.getElementById('email').value.trim();
+        const phone = document.getElementById('phone').value.trim();
+        const zip = document.getElementById('postal-code').value.trim();
+        const selectedBrew = form.querySelector('input[name="favorite-brew"]:checked');
+        const milk = document.getElementById('milk-preference').value;
+
+        document.getElementById('review-name').textContent = (firstName + ' ' + lastName).trim() || '—';
+        document.getElementById('review-email').textContent = email || '—';
+        document.getElementById('review-phone').textContent = phone || '—';
+        document.getElementById('review-zip').textContent = zip || '—';
+        document.getElementById('review-brew').textContent = selectedBrew ? selectedBrew.value : '—';
+        document.getElementById('review-milk').textContent = milk || '—';
+      }
+
+      function goToStep(targetStep, shouldFocusLegend) {
+        if (targetStep < 1 || targetStep > totalSteps) return;
+
+        currentStep = targetStep;
+        errorSummary.hidden = true;
+
+        steps.forEach(function (fieldset, index) {
+          const stepIndex = index + 1;
+          const isCurrent = stepIndex === currentStep;
+          fieldset.hidden = !isCurrent;
+          fieldset.setAttribute('aria-hidden', String(!isCurrent));
+        });
+
+        stepIndicators.forEach(function (indicator, index) {
+          const stepIndex = index + 1;
+          if (stepIndex === currentStep) {
+            indicator.setAttribute('aria-current', 'step');
+            indicator.classList.remove('is-complete');
+          } else if (stepIndex < currentStep) {
+            indicator.removeAttribute('aria-current');
+            indicator.classList.add('is-complete');
+          } else {
+            indicator.removeAttribute('aria-current');
+            indicator.classList.remove('is-complete');
+          }
+        });
+
+        const progressPercent = ((currentStep / totalSteps) * 100).toFixed(2) + '%';
+        progressBar.setAttribute('aria-valuenow', String(currentStep));
+        progressBarFill.style.width = progressPercent;
+
+        prevBtn.hidden = currentStep === 1;
+        nextBtn.hidden = currentStep === totalSteps;
+        submitBtn.hidden = currentStep !== totalSteps;
+
+        if (currentStep === 1) {
+          nextBtn.textContent = 'Continue to Profile \u2192';
+        } else if (currentStep === 2) {
+          nextBtn.textContent = 'Review Registration \u2192';
+        }
+
+        if (currentStep === 3) {
+          populateReviewSummary();
+        }
+
+        const activeFieldset = steps[currentStep - 1];
+        const activeLegend = activeFieldset.querySelector('.step-legend');
+        if (activeLegend) {
+          liveAnnouncer.textContent = activeLegend.textContent;
+          if (shouldFocusLegend) {
+            activeLegend.focus();
+          }
+        }
+      }
+
+      nextBtn.addEventListener('click', function () {
+        if (validateStep(currentStep)) {
+          goToStep(currentStep + 1, true);
+        }
+      });
+
+      prevBtn.addEventListener('click', function () {
+        goToStep(currentStep - 1, true);
+      });
+
+      // Edit step buttons inside Step 3 Review Card
+      Array.from(form.querySelectorAll('.edit-step-btn')).forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const target = Number(btn.getAttribute('data-jump-step'));
+          if (target >= 1 && target < currentStep) {
+            goToStep(target, true);
+          }
+        });
+      });
+
+      // Form Submission with Security & Validation Checks
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+
+        if (isSubmitting) return;
+
+        // Honeypot check: silently reject automated bot submissions
+        if (honeypotInput && honeypotInput.value.trim() !== '') {
+          return;
+        }
+
+        // Verify CSRF token presence
+        if (!csrfInput.value || !csrfInput.value.startsWith('dg_csrf_')) {
+          initSecurityTokens();
+        }
+
+        // Validate all steps in order before completing submission
+        for (let stepIdx = 1; stepIdx <= totalSteps; stepIdx += 1) {
+          if (!validateStep(stepIdx)) {
+            if (currentStep !== stepIdx) {
+              goToStep(stepIdx, false);
+              validateStep(stepIdx);
+            }
+            return;
+          }
+        }
+
+        // Lock submission to prevent duplicate requests
+        isSubmitting = true;
+        submitBtn.disabled = true;
+        prevBtn.disabled = true;
+        submitBtn.textContent = 'Creating Account...';
+        form.setAttribute('aria-busy', 'true');
+
+        const firstName = document.getElementById('first-name').value.trim();
+        const lastName = document.getElementById('last-name').value.trim();
+        const selectedBrew = form.querySelector('input[name="favorite-brew"]:checked');
+
+        // Clear sensitive password fields immediately after read
+        passwordInput.value = '';
+        confirmPasswordInput.value = '';
+
+        // Populate confirmation card safely using textContent
+        document.getElementById('card-member-name').textContent = firstName + ' ' + lastName;
+        document.getElementById('card-member-brew').textContent = selectedBrew ? selectedBrew.value : 'Artisanal Coffee';
+
+        const randomId = Math.floor(100000 + Math.random() * 900000);
+        document.getElementById('card-member-id').textContent = 'ID: #DG-' + randomId;
+
+        form.hidden = true;
+        document.querySelector('.step-progress').hidden = true;
+        errorSummary.hidden = true;
+        confirmationBox.hidden = false;
+        confirmationBox.focus();
+      });
+    })();
+  </script>
 </body>
 
 </html>
