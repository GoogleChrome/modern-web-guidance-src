+  <script>
+    (function () {
+      const statusBanner = document.getElementById('auth-status-banner');
+      const inlineLoginPanel = document.getElementById('inline-login-panel');
+      const inlineLoginForm = document.getElementById('inline-login-form');
+      const inlineLoginDismiss = document.getElementById('inline-login-dismiss');
+
+      function showStatus(message) {
+        if (!statusBanner) return;
+        statusBanner.textContent = message;
+        statusBanner.classList.add('visible');
+      }
+
+      function handleAuthenticatedCredential(credential, targetHref) {
+        if (!credential) return;
+        if (inlineLoginPanel) {
+          inlineLoginPanel.classList.remove('visible');
+        }
+        const label = credential.id || 'Returning Customer';
+        const method = credential.type === 'password' ? 'saved password' : 'passkey';
+        showStatus(`Signed in as ${label} via ${method}. Continuing to ${targetHref || 'page'}...`);
+      }
+
+      async function attemptImmediateSignIn(event) {
+        const link = event.currentTarget;
+        const targetHref = link ? link.getAttribute('href') : '';
+        event.preventDefault();
+
+        if (window.PublicKeyCredential && typeof window.PublicKeyCredential.getClientCapabilities === 'function') {
+          try {
+            await window.PublicKeyCredential.getClientCapabilities();
+          } catch (_) {
+            // Continue even if capability check fails
+          }
+        }
+
+        try {
+          const challenge = new Uint8Array(32);
+          if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
+            window.crypto.getRandomValues(challenge);
+          }
+
+          const credential = await navigator.credentials.get({
+            publicKey: {
+              challenge: challenge,
+              rpId: window.location.hostname || 'localhost'
+            },
+            password: true,
+            mediation: 'immediate'
+          });
+
+          if (credential) {
+            handleAuthenticatedCredential(credential, targetHref);
+          }
+        } catch (error) {
+          if (error && error.name === 'NotAllowedError') {
+            // No saved local passkey or password available (or user dismissed).
+            // Keep the customer on the current page without redirecting to a separate login screen.
+            if (inlineLoginPanel && (targetHref === '/rewards' || targetHref === '/account' || targetHref === '/order-online')) {
+              inlineLoginPanel.classList.add('visible');
+            }
+          } else {
+            console.error('Immediate sign-in error:', error);
+          }
+        }
+      }
+
+      // Attach immediate sign-in to browsing and customer action links,
+      // excluding the logout link and informational/legal footer links.
+      const browsingLinks = document.querySelectorAll(
+        'nav a:not(.logout-link):not([href="/logout"]), .hero a, main a'
+      );
+      browsingLinks.forEach((link) => {
+        link.addEventListener('click', attemptImmediateSignIn);
+      });
+
+      // Handle logout and footer links in-page without triggering credential prompts
+      const nonAuthLinks = document.querySelectorAll('a.logout-link, a[href="/logout"], footer a');
+      nonAuthLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          if (link.classList.contains('logout-link') || link.getAttribute('href') === '/logout') {
+            if (statusBanner) {
+              statusBanner.textContent = '';
+              statusBanner.classList.remove('visible');
+            }
+          }
+        });
+      });
+
+      if (inlineLoginDismiss && inlineLoginPanel) {
+        inlineLoginDismiss.addEventListener('click', () => {
+          inlineLoginPanel.classList.remove('visible');
+        });
+      }
+
+      if (inlineLoginForm && inlineLoginPanel) {
+        inlineLoginForm.addEventListener('submit', (event) => {
+          event.preventDefault();
+          const formData = new FormData(inlineLoginForm);
+          const username = formData.get('username') || 'Customer';
+          inlineLoginPanel.classList.remove('visible');
+          showStatus(`Signed in as ${username}.`);
+        });
+      }
+    })();
+  </script>
+
 </body>
 
