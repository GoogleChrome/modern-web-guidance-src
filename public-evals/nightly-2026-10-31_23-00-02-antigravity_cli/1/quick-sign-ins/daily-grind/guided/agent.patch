+        isAuthenticating = true;
+        try {
+          const user = await authenticateWithImmediateUi();
+          completePendingAction(user, actionContext);
+        } catch (err) {
+          if (err.name === 'NotAllowedError') {
+            showFallbackSignInUi(actionContext);
+            return;
+          }
+          console.error('Authentication error:', err);
+          showFallbackSignInUi(actionContext);
+        } finally {
+          isAuthenticating = false;
+        }
+      });
+    }
+
+    // Handle Logout in place
+    navLogoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      document.body.dataset.signedIn = 'false';
+      navLogoutItem.hidden = true;
+      navSigninItem.hidden = false;
+      userGreeting.textContent = '';
+      showStatusBanner('You have been signed out.');
+    });
+  </script>
 </body>
 
 </html>
