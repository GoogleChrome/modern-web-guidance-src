+  <script>
+    const COFFEE_ITEMS = {
+      'maple-oat-latte': {
+        id: 'maple-oat-latte',
+        title: 'Maple Oat Latte',
+        price: '$5.75',
+        calories: '210 kcal',
+        heroClass: 'thumbnail-maple',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1200&q=80',
+        description:
+          'Creamy oat milk with a hint of Vermont maple syrup, combined with our signature double-shot espresso and topped with a light dusting of cinnamon.',
+        notes: 'Warm maple, toasted oats, velvety caramel finish.'
+      },
+      'dark-roast-espresso': {
+        id: 'dark-roast-espresso',
+        title: 'Dark Roast Espresso',
+        price: '$3.95',
+        calories: '15 kcal',
+        heroClass: 'thumbnail-espresso',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1200&q=80',
+        description:
+          'Bold, smokey, and perfect for a morning boost. Pulled from single-origin Sumatra beans roasted to a deep, aromatic finish.',
+        notes: 'Dark cocoa, roasted walnut, rich crema.'
+      },
+      'cold-brew': {
+        id: 'cold-brew',
+        title: 'Cold Brew',
+        price: '$4.85',
+        calories: '10 kcal',
+        heroClass: 'thumbnail-cold-brew',
+        image: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=1200&q=80',
+        description:
+          'Steeped for 18 hours in cold filtered water for maximum smoothness and naturally sweet chocolate undertones with zero bitterness.',
+        notes: 'Sweet molasses, smooth dark chocolate, crisp finish.'
+      }
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const heroEl = document.getElementById('hero');
+    const heroImg = document.getElementById('hero-img');
+    const detailTitle = document.getElementById('title');
+    const detailPrice = document.getElementById('detail-price');
+    const detailCalories = document.getElementById('detail-calories');
+    const detailDescription = document.getElementById('detail-description');
+    const detailNotes = document.getElementById('detail-notes');
+    const backButton = document.getElementById('back-button');
+    const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+    let activeThumbnail = null;
+
+    function prefersReducedMotion() {
+      return (
+        typeof window.matchMedia === 'function' &&
+        window.matchMedia('(prefers-reduced-motion: reduce)').matches
+      );
+    }
+
+    function applyTransitionNames(containerEl, titleEl) {
+      if (containerEl) {
+        containerEl.classList.add('is-transitioning-hero');
+        containerEl.style.viewTransitionName = 'hero';
+      }
+      if (titleEl) {
+        titleEl.classList.add('is-transitioning-title');
+        titleEl.style.viewTransitionName = 'title';
+      }
+    }
+
+    function clearElementTransition(el) {
+      if (!el) return;
+      el.classList.remove('is-transitioning-hero', 'is-transitioning-title');
+      el.style.removeProperty('view-transition-name');
+      if (!el.getAttribute('style')) {
+        el.removeAttribute('style');
+      }
+    }
+
+    function cleanupAllTransitions() {
+      thumbnails.forEach((thumb) => {
+        clearElementTransition(thumb);
+        const thumbTitle = thumb.querySelector('.title');
+        clearElementTransition(thumbTitle);
+      });
+      clearElementTransition(heroEl);
+      clearElementTransition(detailTitle);
+    }
+
+    function populateDetailView(item) {
+      heroEl.className = item.heroClass;
+      heroImg.src = item.image;
+      heroImg.alt = item.title;
+      detailTitle.textContent = item.title;
+      detailPrice.textContent = item.price;
+      detailCalories.textContent = item.calories;
+      detailDescription.textContent = item.description;
+      detailNotes.innerHTML = '<strong>Tasting Notes:</strong> ' + item.notes;
+    }
+
+    function showDetailView(thumbnail) {
+      const itemId = thumbnail.getAttribute('data-id');
+      const item = COFFEE_ITEMS[itemId];
+      if (!item) return;
+
+      activeThumbnail = thumbnail;
+      const thumbTitle = thumbnail.querySelector('.title');
+
+      const updateDOM = () => {
+        populateDetailView(item);
+        clearElementTransition(thumbnail);
+        clearElementTransition(thumbTitle);
+        applyTransitionNames(heroEl, detailTitle);
+
+        listPage.classList.add('hidden');
+        detailPage.classList.remove('hidden');
+        detailTitle.focus({ preventScroll: true });
+      };
+
+      if (!document.startViewTransition || prefersReducedMotion()) {
+        updateDOM();
+        cleanupAllTransitions();
+        detailTitle.focus();
+        return;
+      }
+
+      cleanupAllTransitions();
+      applyTransitionNames(thumbnail, thumbTitle);
+
+      const transition = document.startViewTransition(() => {
+        updateDOM();
+      });
+
+      transition.finished.finally(() => {
+        cleanupAllTransitions();
+        detailTitle.focus();
+      });
+    }
+
+    function showListView() {
+      const targetThumbnail = activeThumbnail || thumbnails[0];
+      const thumbTitle = targetThumbnail ? targetThumbnail.querySelector('.title') : null;
+
+      const updateDOM = () => {
+        clearElementTransition(heroEl);
+        clearElementTransition(detailTitle);
+        if (targetThumbnail) {
+          applyTransitionNames(targetThumbnail, thumbTitle);
+        }
+
+        detailPage.classList.add('hidden');
+        listPage.classList.remove('hidden');
+        listHeading.focus({ preventScroll: true });
+      };
+
+      if (!document.startViewTransition || prefersReducedMotion()) {
+        updateDOM();
+        cleanupAllTransitions();
+        listHeading.focus();
+        return;
+      }
+
+      cleanupAllTransitions();
+      applyTransitionNames(heroEl, detailTitle);
+
+      const transition = document.startViewTransition(() => {
+        updateDOM();
+      });
+
+      transition.finished.finally(() => {
+        cleanupAllTransitions();
+        listHeading.focus();
+      });
+    }
+
+    thumbnails.forEach((thumbnail) => {
+      thumbnail.addEventListener('click', () => {
+        showDetailView(thumbnail);
+      });
+
+      thumbnail.addEventListener('keydown', (event) => {
+        if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          showDetailView(thumbnail);
+        }
+      });
+    });
+
+    backButton.addEventListener('click', () => {
+      showListView();
+    });
+
+    document.getElementById('nav-menu').addEventListener('click', (event) => {
+      event.preventDefault();
+      if (!detailPage.classList.contains('hidden')) {
+        showListView();
+      } else {
+        listHeading.focus();
+      }
+    });
+
+    document.getElementById('nav-logo').addEventListener('click', () => {
+      if (!detailPage.classList.contains('hidden')) {
+        showListView();
+      } else {
+        listHeading.focus();
+      }
+    });
+  </script>
 </body>
 
 </html>
