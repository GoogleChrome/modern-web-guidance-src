+  <script>
+    const thumbnails = document.querySelectorAll('.thumbnail');
+    const backButton = document.getElementById('back-button');
+    const navMenuLink = document.getElementById('nav-menu-link');
+    const hero = document.getElementById('hero');
+    const detailTitle = document.getElementById('title');
+    const detailSummary = document.getElementById('detail-summary');
+    const detailDescription = document.getElementById('detail-description');
+    const detailRoast = document.getElementById('detail-roast');
+    const detailSize = document.getElementById('detail-size');
+    const detailPrice = document.getElementById('detail-price');
+    const listHeading = document.getElementById('list-heading');
+
+    function populateDetailView(thumbnail) {
+      const cardTitle = thumbnail.querySelector('.title')?.textContent || '';
+      const computedStyle = getComputedStyle(thumbnail);
+
+      hero.style.backgroundImage = computedStyle.backgroundImage;
+      hero.style.backgroundColor = computedStyle.backgroundColor;
+      hero.setAttribute('aria-label', `${cardTitle} featured photo`);
+
+      detailTitle.textContent = cardTitle;
+      detailSummary.textContent = thumbnail.dataset.summary || '';
+      detailDescription.textContent = thumbnail.dataset.details || '';
+      detailRoast.textContent = thumbnail.dataset.roast || '';
+      detailSize.textContent = thumbnail.dataset.size || '';
+      detailPrice.textContent = thumbnail.dataset.price || '';
+      document.title = `${cardTitle} | The Daily Grind`;
+    }
+
+    function cleanupSelectedThumbnails() {
+      document.querySelectorAll('.selected').forEach((element) => {
+        element.classList.remove('selected');
+      });
+    }
+
+    function goFromListToDetail(e) {
+      const thumbnail = e.currentTarget;
+      cleanupSelectedThumbnails();
+      thumbnail.classList.add('selected');
+      populateDetailView(thumbnail);
+
+      if (!document.startViewTransition) {
+        document.body.classList.add('detail');
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.add('detail');
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList(e) {
+      if (e) {
+        e.preventDefault();
+      }
+      if (!document.body.classList.contains('detail')) {
+        return;
+      }
+
+      if (!document.startViewTransition) {
+        document.body.classList.remove('detail');
+        document.title = 'Seasonal Favorites | The Daily Grind';
+        listHeading?.focus();
+        cleanupSelectedThumbnails();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.remove('detail');
+        document.title = 'Seasonal Favorites | The Daily Grind';
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        cleanupSelectedThumbnails();
+      });
+    }
+
+    thumbnails.forEach((thumbnail) => {
+      thumbnail.addEventListener('click', goFromListToDetail);
+    });
+
+    backButton.addEventListener('click', goFromDetailToList);
+    navMenuLink.addEventListener('click', goFromDetailToList);
+  </script>
 </body>
 
