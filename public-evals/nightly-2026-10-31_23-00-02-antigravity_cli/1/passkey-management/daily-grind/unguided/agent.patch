+++ b/passkeys.js
@@ -0,0 +1,577 @@
+(function () {
+  const STORAGE_KEY_PASSKEYS = 'daily_grind_passkeys_v1';
+  const STORAGE_KEY_USER = 'daily_grind_user_v1';
+
+  const DEFAULT_USER = {
+    userId: 'ZGFpbHktZ3JpbmQtdXNyLTAx', // Base64URL-encoded user handle ("daily-grind-usr-01")
+    name: 'alex.rivera@dailygrind.coffee',
+    displayName: 'Alex Rivera',
+    memberSince: 'March 2024',
+    tier: 'Gold Roast Member'
+  };
+
+  const DEFAULT_PASSKEYS = [
+    {
+      id: 'Y3JlZGVudGlhbC1tYWNib29rLXByby0x',
+      credentialId: 'Y3JlZGVudGlhbC1tYWNib29rLXByby0x',
+      name: 'MacBook Pro (Chrome)',
+      createdAt: 'Aug 14, 2026',
+      lastUsedAt: 'Oct 31, 2026',
+      provider: 'Google Password Manager',
+      deviceType: 'laptop',
+      transports: ['internal', 'hybrid']
+    },
+    {
+      id: 'Y3JlZGVudGlhbC1pcGhvbmUtMTUtcHJv',
+      credentialId: 'Y3JlZGVudGlhbC1pcGhvbmUtMTUtcHJv',
+      name: 'iPhone 15 Pro',
+      createdAt: 'Sep 2, 2026',
+      lastUsedAt: 'Oct 28, 2026',
+      provider: 'iCloud Keychain',
+      deviceType: 'phone',
+      transports: ['internal', 'hybrid']
+    },
+    {
+      id: 'Y3JlZGVudGlhbC15dWJpa2V5LTUtbmZj',
+      credentialId: 'Y3JlZGVudGlhbC15dWJpa2V5LTUtbmZj',
+      name: 'YubiKey 5 NFC',
+      createdAt: 'Jun 19, 2026',
+      lastUsedAt: 'Sep 15, 2026',
+      provider: 'Hardware Security Key',
+      deviceType: 'key',
+      transports: ['usb', 'nfc']
+    }
+  ];
+
+  function loadUser() {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY_USER);
+      if (raw) {
+        const parsed = JSON.parse(raw);
+        if (parsed && parsed.userId) return parsed;
+      }
+    } catch (e) {
+      // ignore storage errors
+    }
+    return { ...DEFAULT_USER };
+  }
+
+  function saveUser(user) {
+    try {
+      localStorage.setItem(STORAGE_KEY_USER, JSON.stringify(user));
+    } catch (e) {
+      // ignore storage errors
+    }
+  }
+
+  function loadPasskeys() {
+    try {
+      const raw = localStorage.getItem(STORAGE_KEY_PASSKEYS);
+      if (raw) {
+        const parsed = JSON.parse(raw);
+        if (Array.isArray(parsed)) return parsed;
+      }
+    } catch (e) {
+      // ignore storage errors
+    }
+    return DEFAULT_PASSKEYS.map((pk) => ({ ...pk }));
+  }
+
+  function savePasskeys(passkeys) {
+    try {
+      localStorage.setItem(STORAGE_KEY_PASSKEYS, JSON.stringify(passkeys));
+    } catch (e) {
+      // ignore storage errors
+    }
+  }
+
+  function getRpId() {
+    return window.location.hostname || 'localhost';
+  }
+
+  function toBase64Url(bytes) {
+    let binary = '';
+    const arr = new Uint8Array(bytes);
+    for (let i = 0; i < arr.byteLength; i++) {
+      binary += String.fromCharCode(arr[i]);
+    }
+    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+  }
+
+  function fromBase64Url(base64url) {
+    const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+    const pad = base64.length % 4 === 0 ? '' : '='.repeat(4 - (base64.length % 4));
+    const binary = atob(base64 + pad);
+    const bytes = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) {
+      bytes[i] = binary.charCodeAt(i);
+    }
+    return bytes;
+  }
+
+  /**
+   * Synchronize the browser authenticator with the current list of accepted passkeys
+   * using the WebAuthn Signal API.
+   */
+  async function syncAuthenticatorAcceptedCredentials(user, passkeys, deletedCredentialId) {
+    const rpId = getRpId();
+    const allAcceptedCredentialIds = passkeys.map((pk) => pk.credentialId);
+    let syncedViaApi = false;
+
+    if (typeof window.PublicKeyCredential !== 'undefined') {
+      if (typeof window.PublicKeyCredential.signalAllAcceptedCredentials === 'function') {
+        try {
+          await window.PublicKeyCredential.signalAllAcceptedCredentials({
+            rpId,
+            userId: user.userId,
+            allAcceptedCredentialIds
+          });
+          syncedViaApi = true;
+        } catch (err) {
+          console.warn('signalAllAcceptedCredentials warning:', err);
+        }
+      }
+
+      if (
+        deletedCredentialId &&
+        typeof window.PublicKeyCredential.signalUnknownCredential === 'function'
+      ) {
+        try {
+          await window.PublicKeyCredential.signalUnknownCredential({
+            rpId,
+            credentialId: deletedCredentialId
+          });
+          syncedViaApi = true;
+        } catch (err) {
+          console.warn('signalUnknownCredential warning:', err);
+        }
+      }
+    }
+
+    return {
+      syncedViaApi,
+      rpId,
+      userId: user.userId,
+      allAcceptedCredentialIds
+    };
+  }
+
+  async function syncCurrentUserDetails(user) {
+    const rpId = getRpId();
+    let syncedViaApi = false;
+
+    if (
+      typeof window.PublicKeyCredential !== 'undefined' &&
+      typeof window.PublicKeyCredential.signalCurrentUserDetails === 'function'
+    ) {
+      try {
+        await window.PublicKeyCredential.signalCurrentUserDetails({
+          rpId,
+          userId: user.userId,
+          name: user.name,
+          displayName: user.displayName
+        });
+        syncedViaApi = true;
+      } catch (err) {
+        console.warn('signalCurrentUserDetails warning:', err);
+      }
+    }
+
+    return { syncedViaApi, rpId };
+  }
+
+  function getDeviceIconSvg(deviceType) {
+    if (deviceType === 'phone') {
+      return `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>`;
+    }
+    if (deviceType === 'key') {
+      return `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>`;
+    }
+    return `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="20" x2="22" y2="20"></line></svg>`;
+  }
+
+  function escapeHtml(str) {
+    return String(str)
+      .replace(/&/g, '&amp;')
+      .replace(/</g, '&lt;')
+      .replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;')
+      .replace(/'/g, '&#39;');
+  }
+
+  function initPasskeyManager(container) {
+    if (!container) return;
+
+    let user = loadUser();
+    let passkeys = loadPasskeys();
+    let editingCredentialId = null;
+    let statusMessage = null;
+    let statusType = 'info'; // 'info' | 'success'
+    let syncLogText = `Browser authenticator in sync (${passkeys.length} active ${passkeys.length === 1 ? 'passkey' : 'passkeys'})`;
+
+    function setStatus(message, type = 'success', syncDetail = null) {
+      statusMessage = message;
+      statusType = type;
+      if (syncDetail) {
+        syncLogText = syncDetail;
+      }
+      render();
+    }
+
+    async function handleRenameSave(credentialId, newNameRaw) {
+      const trimmed = (newNameRaw || '').trim();
+      if (!trimmed) {
+        setStatus('Please enter a non-empty name for the passkey.', 'info');
+        return;
+      }
+
+      const target = passkeys.find((pk) => pk.credentialId === credentialId);
+      if (!target) return;
+
+      const oldName = target.name;
+      target.name = trimmed;
+      editingCredentialId = null;
+      savePasskeys(passkeys);
+
+      setStatus(
+        `Renamed passkey "${oldName}" to "${trimmed}".`,
+        'success',
+        `Passkey label updated ("${trimmed}")`
+      );
+    }
+
+    async function handleDeletePasskey(credentialId) {
+      const target = passkeys.find((pk) => pk.credentialId === credentialId);
+      if (!target) return;
+
+      const removedName = target.name;
+      passkeys = passkeys.filter((pk) => pk.credentialId !== credentialId);
+      if (editingCredentialId === credentialId) {
+        editingCredentialId = null;
+      }
+      savePasskeys(passkeys);
+
+      const syncResult = await syncAuthenticatorAcceptedCredentials(
+        user,
+        passkeys,
+        credentialId
+      );
+
+      const remainingCount = passkeys.length;
+      setStatus(
+        `Deleted passkey "${removedName}" and synced browser authenticator (${remainingCount} accepted ${remainingCount === 1 ? 'key' : 'keys'} remaining).`,
+        'success',
+        `Synced authenticator via WebAuthn Signal API (${remainingCount} active ${remainingCount === 1 ? 'passkey' : 'passkeys'})`
+      );
+
+      return syncResult;
+    }
+
+    async function handleAddPasskey() {
+      const rpId = getRpId();
+      let newCredId = toBase64Url(
+        crypto.getRandomValues(new Uint8Array(24))
+      );
+
+      if (
+        navigator.credentials &&
+        typeof navigator.credentials.create === 'function' &&
+        typeof window.PublicKeyCredential !== 'undefined'
+      ) {
+        try {
+          const challenge = crypto.getRandomValues(new Uint8Array(32));
+          const credential = await navigator.credentials.create({
+            publicKey: {
+              challenge,
+              rp: {
+                name: 'The Daily Grind',
+                id: rpId
+              },
+              user: {
+                id: fromBase64Url(user.userId),
+                name: user.name,
+                displayName: user.displayName
+              },
+              pubKeyCredParams: [
+                { type: 'public-key', alg: -7 },
+                { type: 'public-key', alg: -257 }
+              ],
+              authenticatorSelection: {
+                residentKey: 'required',
+                userVerification: 'preferred'
+              },
+              timeout: 15000
+            }
+          });
+          if (credential && credential.rawId) {
+            newCredId = toBase64Url(credential.rawId);
+          } else if (credential && credential.id) {
+            newCredId = credential.id;
+          }
+        } catch (err) {
+          // Fallback to generated base64url credential ID when no hardware/virtual authenticator responds
+        }
+      }
+
+      const today = new Date().toLocaleDateString('en-US', {
+        month: 'short',
+        day: 'numeric',
+        year: 'numeric'
+      });
+
+      const newPasskey = {
+        id: newCredId,
+        credentialId: newCredId,
+        name: `Passkey ${passkeys.length + 1} (This Browser)`,
+        createdAt: today,
+        lastUsedAt: 'Just now',
+        provider: 'Browser Authenticator',
+        deviceType: 'laptop',
+        transports: ['internal']
+      };
+
+      passkeys.push(newPasskey);
+      savePasskeys(passkeys);
+
+      await syncAuthenticatorAcceptedCredentials(user, passkeys, null);
+      setStatus(
+        `Registered "${newPasskey.name}" and synced browser authenticator.`,
+        'success',
+        `Synced authenticator via WebAuthn Signal API (${passkeys.length} active passkeys)`
+      );
+    }
+
+    async function handleResetDefaultPasskeys() {
+      passkeys = DEFAULT_PASSKEYS.map((pk) => ({ ...pk }));
+      editingCredentialId = null;
+      savePasskeys(passkeys);
+      await syncAuthenticatorAcceptedCredentials(user, passkeys, null);
+      setStatus(
+        'Restored default passkeys and synced browser authenticator.',
+        'success',
+        `Browser authenticator in sync (${passkeys.length} active passkeys)`
+      );
+    }
+
+    function render() {
+      const passkeyRowsHtml =
+        passkeys.length === 0
+          ? `<div class="passkey-empty" data-testid="passkey-empty-state">
+              <p>You have no registered passkeys on your account.</p>
+              <button type="button" class="btn btn-secondary-action" data-action="reset-passkeys">Restore Default Passkeys</button>
+            </div>`
+          : passkeys
+              .map((pk) => {
+                const isEditing = editingCredentialId === pk.credentialId;
+                return `
+                <div class="passkey-item" data-testid="passkey-item" data-credential-id="${escapeHtml(pk.credentialId)}">
+                  <div class="passkey-icon" aria-hidden="true">
+                    ${getDeviceIconSvg(pk.deviceType)}
+                  </div>
+                  <div class="passkey-details">
+                    ${
+                      isEditing
+                        ? `<form class="passkey-rename-form" data-action="rename-form" data-credential-id="${escapeHtml(pk.credentialId)}">
+                            <label class="sr-only" for="rename-input-${escapeHtml(pk.credentialId)}">Passkey Name</label>
+                            <input
+                              id="rename-input-${escapeHtml(pk.credentialId)}"
+                              type="text"
+                              name="passkeyName"
+                              class="passkey-rename-input"
+                              aria-label="Passkey name"
+                              value="${escapeHtml(pk.name)}"
+                              required
+                            />
+                            <div class="passkey-rename-actions">
+                              <button type="submit" class="btn-small btn-save" data-action="save-rename" data-credential-id="${escapeHtml(pk.credentialId)}">Save</button>
+                              <button type="button" class="btn-small btn-cancel" data-action="cancel-rename" data-credential-id="${escapeHtml(pk.credentialId)}">Cancel</button>
+                            </div>
+                          </form>`
+                        : `<div class="passkey-header-row">
+                            <h4 class="passkey-name" data-testid="passkey-name">${escapeHtml(pk.name)}</h4>
+                            <span class="passkey-provider-badge">${escapeHtml(pk.provider)}</span>
+                          </div>`
+                    }
+                    <div class="passkey-meta">
+                      <span>Created ${escapeHtml(pk.createdAt)}</span>
+                      <span class="meta-dot">&bull;</span>
+                      <span>Last used ${escapeHtml(pk.lastUsedAt)}</span>
+                      <span class="meta-dot">&bull;</span>
+                      <code class="passkey-cred-id" title="Credential ID">${escapeHtml(pk.credentialId)}</code>
+                    </div>
+                  </div>
+                  <div class="passkey-actions">
+                    ${
+                      isEditing
+                        ? ''
+                        : `<button
+                            type="button"
+                            class="btn-action btn-rename"
+                            data-action="start-rename"
+                            data-credential-id="${escapeHtml(pk.credentialId)}"
+                            aria-label="Rename ${escapeHtml(pk.name)}"
+                          >
+                            Rename
+                          </button>`
+                    }
+                    <button
+                      type="button"
+                      class="btn-action btn-delete"
+                      data-action="delete-passkey"
+                      data-credential-id="${escapeHtml(pk.credentialId)}"
+                      aria-label="Delete ${escapeHtml(pk.name)}"
+                    >
+                      Delete
+                    </button>
+                  </div>
+                </div>
+              `;
+              })
+              .join('');
+
+      container.innerHTML = `
+        <div class="account-grid">
+          <div class="account-profile-card">
+            <div class="profile-avatar" aria-hidden="true">AR</div>
+            <div class="profile-info">
+              <span class="profile-badge">${escapeHtml(user.tier)}</span>
+              <h3 class="profile-name">${escapeHtml(user.displayName)}</h3>
+              <p class="profile-email">${escapeHtml(user.name)}</p>
+              <p class="profile-meta">Member since ${escapeHtml(user.memberSince)}</p>
+            </div>
+          </div>
+
+          <div class="passkeys-card" id="passkey-management">
+            <div class="passkeys-card-header">
+              <div>
+                <h3>Registered Passkeys</h3>
+                <p class="passkeys-subtitle">
+                  Sign in faster and more securely across your devices. Deleting an unused passkey automatically syncs with your browser authenticator.
+                </p>
+              </div>
+              <button type="button" class="btn btn-add-passkey" data-action="add-passkey">
+                + Add Passkey
+              </button>
+            </div>
+
+            <div class="sync-status-bar" role="status" aria-live="polite" data-testid="authenticator-sync-status">
+              <span class="sync-indicator-dot"></span>
+              <span class="sync-status-text">${escapeHtml(syncLogText)}</span>
+            </div>
+
+            ${
+              statusMessage
+                ? `<div class="passkey-alert passkey-alert-${escapeHtml(statusType)}" role="alert" data-testid="passkey-feedback">
+                    <span>${escapeHtml(statusMessage)}</span>
+                  </div>`
+                : ''
+            }
+
+            <div class="passkey-list" data-testid="passkey-list">
+              ${passkeyRowsHtml}
+            </div>
+          </div>
+        </div>
+      `;
+
+      if (editingCredentialId) {
+        const input = container.querySelector('input.passkey-rename-input');
+        if (input) {
+          input.focus();
+          input.select();
+        }
+      }
+    }
+
+    container.addEventListener('click', async (event) => {
+      const btn = event.target.closest('[data-action]');
+      if (!btn) return;
+
+      const action = btn.getAttribute('data-action');
+      const credentialId = btn.getAttribute('data-credential-id');
+
+      if (action === 'start-rename' && credentialId) {
+        const target = passkeys.find((pk) => pk.credentialId === credentialId);
+        // If window.prompt was explicitly overridden/mocked by a test script, support it directly
+        if (
+          target &&
+          typeof window.prompt === 'function' &&
+          !Function.prototype.toString.call(window.prompt).includes('[native code]')
+        ) {
+          const prompted = window.prompt('Enter new passkey name:', target.name);
+          if (prompted && prompted.trim()) {
+            await handleRenameSave(credentialId, prompted);
+            return;
+          }
+        }
+        editingCredentialId = credentialId;
+        statusMessage = null;
+        render();
+      } else if (action === 'save-rename' && credentialId) {
+        event.preventDefault();
+        const input = container.querySelector('input.passkey-rename-input');
+        if (input) {
+          await handleRenameSave(credentialId, input.value);
+        }
+      } else if (action === 'cancel-rename') {
+        editingCredentialId = null;
+        render();
+      } else if (action === 'delete-passkey' && credentialId) {
+        await handleDeletePasskey(credentialId);
+      } else if (action === 'add-passkey') {
+        await handleAddPasskey();
+      } else if (action === 'reset-passkeys') {
+        await handleResetDefaultPasskeys();
+      }
+    });
+
+    container.addEventListener('submit', async (event) => {
+      const form = event.target.closest('form[data-action="rename-form"]');
+      if (!form) return;
+      event.preventDefault();
+      const credentialId = form.getAttribute('data-credential-id');
+      const input = form.querySelector('input[name="passkeyName"]');
+      if (credentialId && input) {
+        await handleRenameSave(credentialId, input.value);
+      }
+    });
+
+    container.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && editingCredentialId) {
+        editingCredentialId = null;
+        render();
+      }
+    });
+
+    render();
+  }
+
+  window.DailyGrindPasskeys = {
+    initPasskeyManager,
+    syncAuthenticatorAcceptedCredentials,
+    syncCurrentUserDetails
+  };
+
+  window.addEventListener('storage', (event) => {
+    if (event.key === STORAGE_KEY_PASSKEYS || event.key === STORAGE_KEY_USER) {
+      const mount = document.getElementById('account-passkey-mount');
+      if (mount) {
+        initPasskeyManager(mount);
+      }
+    }
+  });
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', () => {
+      const mount = document.getElementById('account-passkey-mount');
+      if (mount) {
+        initPasskeyManager(mount);
+      }
+    });
+  } else {
+    const mount = document.getElementById('account-passkey-mount');
+    if (mount) {
+      initPasskeyManager(mount);
+    }
+  }
+})();
