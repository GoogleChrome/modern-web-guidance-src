+  return jsonResponse(list, 200);
+}
+
+/**
+ * PUT /api/credential/:id - Update a credential's custom nickname
+ */
+export async function renameCredentialFetch(credentialId, { name }) {
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ name }),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch (_) {
+    // Fallback to local simulated store
+  }
+  const list = loadCredentialsFromStorage();
+  const cred = list.find((c) => c.id === credentialId);
+  if (!cred) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  cred.name = name;
+  saveCredentialsToStorage(list);
+  return jsonResponse(cred, 200);
+}
+
+/**
+ * DELETE /api/credential/:id - Delete a credential
+ */
+export async function deleteFetch(credentialId) {
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'DELETE',
+      headers: { Accept: 'application/json' },
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch (_) {
+    // Fallback to local simulated store
+  }
+  const list = loadCredentialsFromStorage();
+  const idx = list.findIndex((c) => c.id === credentialId);
+  if (idx === -1) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  list.splice(idx, 1);
+  saveCredentialsToStorage(list);
+  return jsonResponse({ success: true }, 200);
+}
+
+/**
+ * PUT /api/user - Update user account name and displayName
+ */
+export async function updateUserFetch({ name, displayName }) {
+  try {
+    const res = await fetch('/api/user', {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ name, displayName }),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch (_) {
+    // Fallback to local simulated store
+  }
+  const user = getStoredUser();
+  user.name = name;
+  user.displayName = displayName;
+  saveUserToStorage(user);
+  return jsonResponse(user, 200);
+}
+
+/**
+ * POST /api/register/options - Generate WebAuthn creation options
+ */
+export async function optionsFetch({ promotion = false } = {}) {
+  try {
+    const res = await fetch('/api/register/options', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ promotion }),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return await res.json();
+    }
+  } catch (_) {
+    // Fallback to local options generator
+  }
+
+  const user = getStoredUser();
+  const userExistingCredentials = loadCredentialsFromStorage();
+  const rpId = window.location.hostname || 'localhost';
+
+  const options = {
+    challenge: generateRandomBase64Url(32),
+    rp: {
+      id: rpId,
+      name: 'The Daily Grind',
+    },
+    user: {
+      id: user.id,
+      name: user.name,
+      displayName: user.displayName,
+    },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },
+      { type: 'public-key', alg: -257 },
+    ],
+    excludeCredentials: userExistingCredentials.map((cred) => ({
+      type: 'public-key',
+      id: cred.id,
+      transports: cred.transports || ['internal', 'hybrid'],
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(promotion && { authenticatorAttachment: 'platform' }),
+    },
+  };
+
+  return options;
+}
+
+/**
+ * POST /api/register/verify - Verify and store new passkey credential
+ */
+export async function registerVerifyFetch(encodedResponse) {
+  try {
+    const res = await fetch('/api/register/verify', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify(encodedResponse),
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch (_) {
+    // Fallback to local verification and persistence
+  }
+
+  const user = getStoredUser();
+  const list = loadCredentialsFromStorage();
+  const aaguid = encodedResponse.aaguid || 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4';
+
+  let name = 'Unknown passkey provider';
+  let providerIcon = undefined;
+
+  if (aaguid === '00000000-0000-0000-0000-000000000000') {
+    name = 'Unknown passkey provider';
+    providerIcon = undefined;
+  } else {
+    const provider = aaguids[aaguid];
+    name = provider?.name || 'Unknown passkey provider';
+    providerIcon = provider?.icon_light;
+  }
+
+  const newCredential = {
+    id: encodedResponse.id || generateRandomBase64Url(20),
+    passkeyUserId: user.id,
+    credentialPublicKey: encodedResponse.response?.publicKey || '',
+    credentialType: 'public-key',
+    credentialDeviceType: encodedResponse.authenticatorAttachment === 'cross-platform' ? 'singleDevice' : 'multiDevice',
+    credentialBackedUp: true,
+    aaguid,
+    providerIcon,
+    name,
+    transports: encodedResponse.response?.transports || ['internal', 'hybrid'],
+    registeredAt: Date.now(),
+    lastUsedAt: undefined,
+    counter: 0,
+  };
+
+  list.push(newCredential);
+  saveCredentialsToStorage(list);
+  return jsonResponse(newCredential, 200);
+}
