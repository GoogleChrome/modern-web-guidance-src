+import 'webauthn-polyfills';
+import aaguids from './aaguids.json' with { type: 'json' };
+import {
+  listFetch,
+  renameCredentialFetch,
+  updateUserFetch,
+  deleteFetch,
+  optionsFetch,
+  registerVerifyFetch,
+  getStoredUser,
+} from './api.js';
+
+// RP ID matches the current origin domain (or localhost for local development)
+const rpId = window.location.hostname || 'localhost';
+
+// Base64URL-encoded User ID string
+const base64UrlUserId = 'M2YPl-KGnA8';
+
+let currentCredentials = [];
+let activeRenameId = null;
+
+function formatTimestamp(epochMs) {
+  if (!epochMs) return 'Never used';
+  try {
+    return new Intl.DateTimeFormat('en-US', {
+      year: 'numeric',
+      month: 'short',
+      day: 'numeric',
+    }).format(new Date(epochMs));
+  } catch (_) {
+    return new Date(epochMs).toLocaleDateString();
+  }
+}
+
+function getFallbackProviderIcon() {
+  return 'data:image/svg+xml;utf8,' + encodeURIComponent(
+    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4e342e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>`
+  );
+}
+
+function resolveCredentialMetadata(cred) {
+  const { aaguid } = cred;
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      providerName: 'Unknown passkey provider',
+      displayName: cred.name || 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  const providerName = provider?.name || 'Unknown passkey provider';
+  return {
+    providerName,
+    displayName: cred.name || providerName,
+    providerIcon: cred.providerIcon || provider?.icon_light,
+  };
+}
+
+function showStatusMessage(message, type = 'success') {
+  const banner = document.getElementById('status-banner');
+  if (!banner) return;
+  banner.textContent = message;
+  banner.className = `status-banner status-${type}`;
+  banner.hidden = false;
+  clearTimeout(banner._hideTimer);
+  banner._hideTimer = setTimeout(() => {
+    banner.hidden = true;
+  }, 5000);
+}
+
+export async function syncAcceptedCredentials(currentCredentialsList) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  try {
+    const credentialIds = currentCredentialsList.map((c) => c.id); // Array of Base64URL credential ID strings
+
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // RP ID must match the one defined on the server
+      userId: base64UrlUserId, // User ID Base64URL-encoded string
+      allAcceptedCredentialIds: credentialIds,
+    });
+  } catch (e) {
+    console.error('SignalAllAcceptedCredentials sync failure:', e);
+  }
+}
+
+export async function performDelete(credentialId) {
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+
+    renderUI(updatedList);
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(updatedList);
+    showStatusMessage('Passkey deleted and synced with your browser authenticator.', 'success');
+  } else {
+    showStatusMessage('Could not delete passkey. Please try again.', 'error');
+  }
+}
+
+// Renaming a passkey's nickname updates the server record only
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const trimmed = (newCredentialName || '').trim();
+  if (!trimmed) {
+    showStatusMessage('Please enter a non-empty name for the passkey.', 'error');
+    return;
+  }
+  const response = await renameCredentialFetch(credentialId, { name: trimmed });
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    renderUI(await updatedResponse.json());
+    showStatusMessage(`Passkey renamed to "${trimmed}".`, 'success');
+  } else {
+    showStatusMessage('Could not rename passkey. Please try again.', 'error');
+  }
+}
+
+// Renaming the user's account username or displayName triggers signalCurrentUserDetails
+export async function performUserRename(targetRpId, userId, updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({ name: updatedName, displayName: updatedDisplayName });
+  if (response.ok) {
+    if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId: targetRpId, // RP ID must match the one defined on the server
+          userId, // Base64URL-encoded user ID
+          name: updatedName, // Updated username
+          displayName: updatedDisplayName, // Updated display name
+        });
+      } catch (e) {
+        console.error('SignalCurrentUserDetails sync failure:', e);
+      }
+    }
+    updateProfileHeaderUI({ name: updatedName, displayName: updatedDisplayName });
+    showStatusMessage('Account profile updated and synced with your passkey provider.', 'success');
+  } else {
+    showStatusMessage('Could not update profile details.', 'error');
+  }
+}
+
+function updateProfileHeaderUI(user) {
+  const greetingEl = document.getElementById('account-greeting-name');
+  if (greetingEl && user.displayName) {
+    greetingEl.textContent = user.displayName;
+  }
+  const emailEl = document.getElementById('account-greeting-email');
+  if (emailEl && user.name) {
+    emailEl.textContent = user.name;
+  }
+  const nameInput = document.getElementById('user-name-input');
+  if (nameInput && user.name && document.activeElement !== nameInput) {
+    nameInput.value = user.name;
+  }
+  const displayNameInput = document.getElementById('user-display-name-input');
+  if (displayNameInput && user.displayName && document.activeElement !== displayNameInput) {
+    displayNameInput.value = user.displayName;
+  }
+}
+
+function showStandardPasswordFallbackUI() {
+  const createBtn = document.getElementById('create-passkey-btn');
+  const fallbackNotice = document.getElementById('passkey-unsupported-fallback');
+  if (createBtn) {
+    createBtn.disabled = true;
+    createBtn.hidden = true;
+  }
+  if (fallbackNotice) {
+    fallbackNotice.hidden = false;
+  }
+}
+
+async function checkPasskeyCapabilities() {
+  const createBtn = document.getElementById('create-passkey-btn');
+  const fallbackNotice = document.getElementById('passkey-unsupported-fallback');
+
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    showStandardPasswordFallbackUI();
+    return false;
+  }
+
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    if (
+      capabilities.passkeyPlatformAuthenticator === false ||
+      capabilities.conditionalGet === false
+    ) {
+      showStandardPasswordFallbackUI();
+      return false;
+    }
+    if (createBtn) {
+      createBtn.disabled = false;
+      createBtn.hidden = false;
+    }
+    if (fallbackNotice) {
+      fallbackNotice.hidden = true;
+    }
+    return true;
+  } catch (e) {
+    console.warn('Error checking WebAuthn client capabilities:', e);
+    return true;
+  }
+}
+
+export async function registerPasskey(isPromotion = false) {
+  // Verify passkey capability and conditional UI are available
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    showStandardPasswordFallbackUI();
+    return;
+  }
+
+  const capabilities = await PublicKeyCredential.getClientCapabilities();
+  if (
+    !capabilities.passkeyPlatformAuthenticator ||
+    !capabilities.conditionalGet
+  ) {
+    // Hide "Create passkey" buttons and fall back to password flows instead
+    showStandardPasswordFallbackUI();
+    return;
+  }
+
+  const creationOptionsJSON = await optionsFetch({ promotion: isPromotion });
+  const publicKey =
+    PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+  let credential;
+  try {
+    // passkey prompt execution
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      console.log('A passkey already exists for this account.');
+      showStatusMessage('A passkey already exists for this account on your authenticator.', 'error');
+    } else if (err.name === 'SecurityError') {
+      console.error('Configuration RP ID or Secure Context error.');
+      showStatusMessage('Configuration RP ID or Secure Context error.', 'error');
+    } else if (err.name === 'NotAllowedError') {
+      console.log('User cancelled the passkey dialog.');
+      showStatusMessage('Passkey creation was cancelled.', 'info');
+    } else if (err.name === 'AbortError') {
+      console.log('The creation operation has been aborted.');
+    }
+    return; // Safe API exit, do not signal unknown for standard WebAuthn cancels
+  }
+
+  // Server Verification phase (Segregated Try/Catch)
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok) {
+      // Server verification failed to verify/authenticate the credential (orphaned)
+      if (PublicKeyCredential.signalUnknownCredential) {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId, // RP ID must match the one defined on the server
+          credentialId: encodedResponse.id, // Base64URL-encoded credential ID
+        });
+      }
+      showStatusMessage('Server could not verify the new passkey.', 'error');
+      return;
+    }
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+    renderUI(updatedList);
+    await syncAcceptedCredentials(updatedList);
+    showStatusMessage('New passkey registered and synced with your account!', 'success');
+  } catch (serverErr) {
+    console.error('Server verification network failure:', serverErr);
+    if (PublicKeyCredential.signalUnknownCredential) {
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId, // RP ID must match the one defined on the server
+        credentialId: encodedResponse.id, // Base64URL-encoded credential ID
+      });
+    }
+    showStatusMessage('Network error during passkey verification.', 'error');
+  }
+}
+
+export function renderUI(list) {
+  currentCredentials = Array.isArray(list) ? list : [];
+  const listContainer = document.getElementById('passkey-list');
+  const emptyState = document.getElementById('passkey-empty-state');
+  const countBadge = document.getElementById('passkey-count-badge');
+
+  if (countBadge) {
+    countBadge.textContent = `${currentCredentials.length} ${
+      currentCredentials.length === 1 ? 'passkey' : 'passkeys'
+    }`;
+  }
+
+  if (!listContainer) return;
+  listContainer.innerHTML = '';
+
+  if (currentCredentials.length === 0) {
+    if (emptyState) emptyState.hidden = false;
+    return;
+  }
+
+  if (emptyState) emptyState.hidden = true;
+
+  currentCredentials.forEach((cred) => {
+    const { providerName, displayName, providerIcon } = resolveCredentialMetadata(cred);
+    const iconSrc = providerIcon || getFallbackProviderIcon();
+    const registeredDateStr = formatTimestamp(cred.registeredAt);
+    const lastUsedDateStr = cred.lastUsedAt
+      ? formatTimestamp(cred.lastUsedAt)
+      : 'Never used';
+
+    const item = document.createElement('li');
+    item.className = 'passkey-row';
+    item.dataset.credentialId = cred.id;
+
+    const infoGroup = document.createElement('div');
+    infoGroup.className = 'passkey-info';
+
+    const iconImg = document.createElement('img');
+    iconImg.className = 'passkey-provider-icon';
+    iconImg.src = iconSrc;
+    iconImg.alt = `${providerName} icon`;
+    iconImg.width = 36;
+    iconImg.height = 36;
+
+    const detailsDiv = document.createElement('div');
+    detailsDiv.className = 'passkey-details';
+
+    const titleRow = document.createElement('div');
+    titleRow.className = 'passkey-title-row';
+
+    const nameSpan = document.createElement('span');
+    nameSpan.className = 'passkey-name';
+    nameSpan.textContent = displayName;
+    titleRow.appendChild(nameSpan);
+
+    if (cred.credentialBackedUp) {
+      const syncBadge = document.createElement('span');
+      syncBadge.className = 'passkey-badge synced';
+      syncBadge.textContent = 'Synced';
+      titleRow.appendChild(syncBadge);
+    }
+
+    if (displayName !== providerName && providerName !== 'Unknown passkey provider') {
+      const providerSub = document.createElement('span');
+      providerSub.className = 'passkey-provider-sub';
+      providerSub.textContent = providerName;
+      titleRow.appendChild(providerSub);
+    }
+
+    const metaRow = document.createElement('div');
+    metaRow.className = 'passkey-timestamps';
+
+    const regSpan = document.createElement('span');
+    regSpan.className = 'timestamp-item';
+    regSpan.innerHTML = `<strong>Registered:</strong> <time datetime="${new Date(cred.registeredAt).toISOString()}">${registeredDateStr}</time>`;
+
+    const usedSpan = document.createElement('span');
+    usedSpan.className = 'timestamp-item';
+    if (cred.lastUsedAt) {
+      usedSpan.innerHTML = `<strong>Last used:</strong> <time datetime="${new Date(cred.lastUsedAt).toISOString()}">${lastUsedDateStr}</time>`;
+    } else {
+      usedSpan.innerHTML = `<strong>Last used:</strong> Never`;
+    }
+
+    metaRow.appendChild(regSpan);
+    metaRow.appendChild(usedSpan);
+
+    // Inline rename form (hidden by default)
+    const inlineRenameForm = document.createElement('form');
+    inlineRenameForm.className = 'inline-rename-form';
+    inlineRenameForm.hidden = true;
+
+    const renameInput = document.createElement('input');
+    renameInput.type = 'text';
+    renameInput.className = 'rename-input';
+    renameInput.value = displayName;
+    renameInput.setAttribute('aria-label', `New name for ${displayName}`);
+    renameInput.required = true;
+    renameInput.maxLength = 60;
+
+    const saveRenameBtn = document.createElement('button');
+    saveRenameBtn.type = 'submit';
+    saveRenameBtn.className = 'btn btn-sm btn-primary';
+    saveRenameBtn.textContent = 'Save';
+
+    const cancelRenameBtn = document.createElement('button');
+    cancelRenameBtn.type = 'button';
+    cancelRenameBtn.className = 'btn btn-sm btn-outline';
+    cancelRenameBtn.textContent = 'Cancel';
+
+    inlineRenameForm.appendChild(renameInput);
+    inlineRenameForm.appendChild(saveRenameBtn);
+    inlineRenameForm.appendChild(cancelRenameBtn);
+
+    detailsDiv.appendChild(titleRow);
+    detailsDiv.appendChild(metaRow);
+    detailsDiv.appendChild(inlineRenameForm);
+
+    infoGroup.appendChild(iconImg);
+    infoGroup.appendChild(detailsDiv);
+
+    // Action buttons
+    const actionsDiv = document.createElement('div');
+    actionsDiv.className = 'passkey-actions';
+
+    const renameBtn = document.createElement('button');
+    renameBtn.type = 'button';
+    renameBtn.className = 'btn btn-sm btn-outline rename-passkey-btn';
+    renameBtn.textContent = 'Rename';
+    renameBtn.setAttribute('aria-label', `Rename passkey ${displayName}`);
+
+    const deleteBtn = document.createElement('button');
+    deleteBtn.type = 'button';
+    deleteBtn.className = 'btn btn-sm btn-danger delete-passkey-btn';
+    deleteBtn.textContent = 'Delete';
+    deleteBtn.setAttribute('aria-label', `Delete passkey ${displayName}`);
+
+    // Rename handler
+    renameBtn.addEventListener('click', () => {
+      const dialog = document.getElementById('rename-passkey-dialog');
+      if (dialog && typeof dialog.showModal === 'function') {
+        activeRenameId = cred.id;
+        const dialogInput = document.getElementById('dialog-passkey-name-input');
+        if (dialogInput) {
+          dialogInput.value = displayName;
+        }
+        dialog.showModal();
+      } else {
+        inlineRenameForm.hidden = false;
+        titleRow.hidden = true;
+        renameBtn.hidden = true;
+        renameInput.value = displayName;
+        renameInput.focus();
+        renameInput.select();
+      }
+    });
+
+    cancelRenameBtn.addEventListener('click', () => {
+      inlineRenameForm.hidden = true;
+      titleRow.hidden = false;
+      renameBtn.hidden = false;
+    });
+
+    inlineRenameForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      await performCredentialRename(cred.id, renameInput.value);
+    });
+
+    // Delete handler
+    deleteBtn.addEventListener('click', async () => {
+      deleteBtn.disabled = true;
+      deleteBtn.textContent = 'Deleting...';
+      await performDelete(cred.id);
+    });
+
+    actionsDiv.appendChild(renameBtn);
+    actionsDiv.appendChild(deleteBtn);
+
+    item.appendChild(infoGroup);
+    item.appendChild(actionsDiv);
+    listContainer.appendChild(item);
+  });
+}
+
+function wireEvents() {
+  const createBtn = document.getElementById('create-passkey-btn');
+  if (createBtn) {
+    createBtn.addEventListener('click', () => {
+      registerPasskey(false);
+    });
+  }
+
+  const profileForm = document.getElementById('user-profile-form');
+  if (profileForm) {
+    profileForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const nameInput = document.getElementById('user-name-input');
+      const displayNameInput = document.getElementById('user-display-name-input');
+      const updatedName = nameInput ? nameInput.value.trim() : '';
+      const updatedDisplayName = displayNameInput ? displayNameInput.value.trim() : '';
+      if (!updatedName || !updatedDisplayName) {
+        showStatusMessage('Both username (email) and display name are required.', 'error');
+        return;
+      }
+      await performUserRename(rpId, base64UrlUserId, updatedName, updatedDisplayName);
+    });
+  }
+
+  const renameDialog = document.getElementById('rename-passkey-dialog');
+  const renameDialogForm = document.getElementById('rename-passkey-dialog-form');
+  const renameDialogCancel = document.getElementById('rename-dialog-cancel');
+
+  if (renameDialogForm && renameDialog) {
+    renameDialogForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const dialogInput = document.getElementById('dialog-passkey-name-input');
+      if (activeRenameId && dialogInput) {
+        const newName = dialogInput.value.trim();
+        renameDialog.close();
+        await performCredentialRename(activeRenameId, newName);
+        activeRenameId = null;
+      }
+    });
+  }
+
+  if (renameDialogCancel && renameDialog) {
+    renameDialogCancel.addEventListener('click', () => {
+      activeRenameId = null;
+      renameDialog.close();
+    });
+  }
+}
+
+export async function loadManagementPanel() {
+  const user = getStoredUser();
+  updateProfileHeaderUI(user);
+
+  await checkPasskeyCapabilities();
+
+  const response = await listFetch();
+  const list = await response.json();
+
+  renderUI(list);
+  // Sync accepted credentials on initial load
+  await syncAcceptedCredentials(list);
+}
+
+wireEvents();
+
+if (document.readyState === 'loading') {
+  window.addEventListener('DOMContentLoaded', loadManagementPanel);
+} else {
+  loadManagementPanel();
+}
