+import React, { useState, useEffect, useCallback } from 'react';
+import type { AccountProfile, StoredPasskey } from '../middleware';
+import {
+  KeyIcon,
+  PencilSquareIcon,
+  TrashIcon,
+  PlusIcon,
+  CheckCircleIcon,
+  ExclamationTriangleIcon,
+  ArrowPathIcon,
+  ShieldCheckIcon,
+  UserCircleIcon,
+  DevicePhoneMobileIcon,
+  ComputerDesktopIcon,
+  CpuChipIcon,
+} from '@heroicons/react/24/outline';
+
+interface AccountSettingsProps {
+  initialAccount: AccountProfile;
+  initialPasskeys: StoredPasskey[];
+}
+
+interface SyncLogEntry {
+  id: string;
+  timestamp: string;
+  method:
+    | 'signalAllAcceptedCredentials'
+    | 'signalCurrentUserDetails'
+    | 'signalUnknownCredential';
+  status: 'synced' | 'simulated';
+  summary: string;
+  payload: Record<string, unknown>;
+}
+
+const STORAGE_KEY_PASSKEYS = 'devtools_times_passkeys';
+const STORAGE_KEY_ACCOUNT = 'devtools_times_account';
+
+function getRpId(): string {
+  if (typeof window !== 'undefined' && window.location.hostname) {
+    return window.location.hostname;
+  }
+  return 'localhost';
+}
+
+export default function AccountSettings({
+  initialAccount,
+  initialPasskeys,
+}: AccountSettingsProps) {
+  const [account, setAccount] = useState<AccountProfile>(initialAccount);
+  const [passkeys, setPasskeys] = useState<StoredPasskey[]>(initialPasskeys);
+
+  // Account profile form state
+  const [profileDisplayName, setProfileDisplayName] = useState(initialAccount.displayName);
+  const [profileUsername, setProfileUsername] = useState(initialAccount.username);
+  const [savingProfile, setSavingProfile] = useState(false);
+
+  // Passkey editing state
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editingName, setEditingName] = useState<string>('');
+  const [BusyKeyId, setBusyKeyId] = useState<string | null>(null);
+
+  // New passkey creation state
+  const [newKeyName, setNewKeyName] = useState('');
+  const [isCreatingKey, setIsCreatingKey] = useState(false);
+  const [showCreateForm, setShowCreateForm] = useState(false);
+
+  // Notifications & Authenticator Sync state
+  const [feedback, setFeedback] = useState<{
+    type: 'success' | 'error' | 'info';
+    text: string;
+  } | null>(null);
+  const [syncLogs, setSyncLogs] = useState<SyncLogEntry[]>([]);
+  const [signalSupported, setSignalSupported] = useState<boolean>(false);
+
+  useEffect(() => {
+    if (
+      typeof window !== 'undefined' &&
+      'PublicKeyCredential' in window &&
+      typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+    ) {
+      setSignalSupported(true);
+    }
+
+    // Load latest state from API or fallback to localStorage
+    const loadState = async () => {
+      try {
+        const res = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`);
+        if (res.ok) {
+          const data = await res.json();
+          if (data.account) {
+            setAccount(data.account);
+            setProfileDisplayName(data.account.displayName);
+            setProfileUsername(data.account.username);
+          }
+          if (Array.isArray(data.passkeys)) {
+            setPasskeys(data.passkeys);
+          }
+        }
+      } catch {
+        // Fallback to localStorage if offline
+        const savedAccount = localStorage.getItem(STORAGE_KEY_ACCOUNT);
+        const savedPasskeys = localStorage.getItem(STORAGE_KEY_PASSKEYS);
+        if (savedAccount) {
+          const parsed = JSON.parse(savedAccount);
+          setAccount(parsed);
+          setProfileDisplayName(parsed.displayName);
+          setProfileUsername(parsed.username);
+        }
+        if (savedPasskeys) {
+          setPasskeys(JSON.parse(savedPasskeys));
+        }
+      }
+    };
+    loadState();
+  }, []);
+
+  const persistLocal = (nextAccount: AccountProfile, nextPasskeys: StoredPasskey[]) => {
+    try {
+      localStorage.setItem(STORAGE_KEY_ACCOUNT, JSON.stringify(nextAccount));
+      localStorage.setItem(STORAGE_KEY_PASSKEYS, JSON.stringify(nextPasskeys));
+    } catch {
+      // ignore storage errors
+    }
+  };
+
+  /**
+   * Synchronize accepted credential list with the browser authenticator
+   * using WebAuthn Signal API: PublicKeyCredential.signalAllAcceptedCredentials
+   */
+  const syncAllAcceptedCredentials = useCallback(
+    async (userId: string, activePasskeys: StoredPasskey[]) => {
+      const rpId = getRpId();
+      const allAcceptedCredentialIds = activePasskeys.map((pk) => pk.credentialId);
+      const payload = {
+        rpId,
+        userId,
+        allAcceptedCredentialIds,
+      };
+
+      let status: 'synced' | 'simulated' = 'simulated';
+      if (
+        typeof window !== 'undefined' &&
+        'PublicKeyCredential' in window &&
+        typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+      ) {
+        try {
+          await PublicKeyCredential.signalAllAcceptedCredentials(payload);
+          status = 'synced';
+        } catch (err) {
+          console.warn('PublicKeyCredential.signalAllAcceptedCredentials error:', err);
+        }
+      }
+
+      setSyncLogs((prev) => [
+        {
+          id: `sync-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
+          timestamp: new Date().toLocaleTimeString(),
+          method: 'signalAllAcceptedCredentials',
+          status,
+          summary: `Signaled ${allAcceptedCredentialIds.length} accepted passkey(s) to browser authenticator`,
+          payload,
+        },
+        ...prev.slice(0, 9),
+      ]);
+
+      return status;
+    },
+    []
+  );
+
+  /**
+   * Signal an unknown/removed credential to the browser authenticator
+   * using WebAuthn Signal API: PublicKeyCredential.signalUnknownCredential
+   */
+  const syncUnknownCredential = useCallback(async (credentialId: string) => {
+    const rpId = getRpId();
+    const payload = {
+      rpId,
+      credentialId,
+    };
+
+    let status: 'synced' | 'simulated' = 'simulated';
+    if (
+      typeof window !== 'undefined' &&
+      'PublicKeyCredential' in window &&
+      typeof PublicKeyCredential.signalUnknownCredential === 'function'
+    ) {
+      try {
+        await PublicKeyCredential.signalUnknownCredential(payload);
+        status = 'synced';
+      } catch (err) {
+        console.warn('PublicKeyCredential.signalUnknownCredential error:', err);
+      }
+    }
+
+    setSyncLogs((prev) => [
+      {
+        id: `sync-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
+        timestamp: new Date().toLocaleTimeString(),
+        method: 'signalUnknownCredential',
+        status,
+        summary: `Signaled removed credential (${credentialId.slice(0, 10)}…) to authenticator`,
+        payload,
+      },
+      ...prev.slice(0, 9),
+    ]);
+
+    return status;
+  }, []);
+
+  /**
+   * Synchronize user display name and username with the browser authenticator
+   * using WebAuthn Signal API: PublicKeyCredential.signalCurrentUserDetails
+   */
+  const syncCurrentUserDetails = useCallback(
+    async (userId: string, name: string, displayName: string) => {
+      const rpId = getRpId();
+      const payload = {
+        rpId,
+        userId,
+        name,
+        displayName,
+      };
+
+      let status: 'synced' | 'simulated' = 'simulated';
+      if (
+        typeof window !== 'undefined' &&
+        'PublicKeyCredential' in window &&
+        typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+      ) {
+        try {
+          await PublicKeyCredential.signalCurrentUserDetails(payload);
+          status = 'synced';
+        } catch (err) {
+          console.warn('PublicKeyCredential.signalCurrentUserDetails error:', err);
+        }
+      }
+
+      setSyncLogs((prev) => [
+        {
+          id: `sync-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
+          timestamp: new Date().toLocaleTimeString(),
+          method: 'signalCurrentUserDetails',
+          status,
+          summary: `Signaled updated display name "${displayName}" (${name}) to browser authenticator`,
+          payload,
+        },
+        ...prev.slice(0, 9),
+      ]);
+
+      return status;
+    },
+    []
+  );
+
+  // Start editing a passkey's display name
+  const handleStartEdit = (pk: StoredPasskey) => {
+    setEditingId(pk.id);
+    setEditingName(pk.name);
+    setFeedback(null);
+  };
+
+  const handleCancelEdit = () => {
+    setEditingId(null);
+    setEditingName('');
+  };
+
+  // Save updated display name for a passkey and sync with browser authenticator
+  const handleSavePasskeyName = async (pk: StoredPasskey) => {
+    const trimmed = editingName.trim();
+    if (!trimmed) {
+      setFeedback({
+        type: 'error',
+        text: 'Please enter a valid display name for the passkey.',
+      });
+      return;
+    }
+
+    setBusyKeyId(pk.id);
+    setFeedback(null);
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'rename',
+          id: pk.id,
+          credentialId: pk.credentialId,
+          name: trimmed,
+          displayName: trimmed,
+        }),
+      });
+
+      let updatedPasskeys: StoredPasskey[];
+      if (response.ok) {
+        const data = await response.json();
+        updatedPasskeys = data.passkeys;
+      } else {
+        updatedPasskeys = passkeys.map((item) =>
+          item.id === pk.id ? { ...item, name: trimmed, displayName: trimmed } : item
+        );
+      }
+
+      setPasskeys(updatedPasskeys);
+      persistLocal(account, updatedPasskeys);
+      setEditingId(null);
+      setEditingName('');
+
+      // Sync display name update with browser authenticator via WebAuthn Signal API
+      await syncCurrentUserDetails(account.userId, account.username, trimmed);
+
+      setFeedback({
+        type: 'success',
+        text: `Passkey display name updated to "${trimmed}" and synced with your browser authenticator.`,
+      });
+    } catch {
+      const updatedPasskeys = passkeys.map((item) =>
+        item.id === pk.id ? { ...item, name: trimmed, displayName: trimmed } : item
+      );
+      setPasskeys(updatedPasskeys);
+      persistLocal(account, updatedPasskeys);
+      setEditingId(null);
+      await syncCurrentUserDetails(account.userId, account.username, trimmed);
+      setFeedback({
+        type: 'success',
+        text: `Passkey display name updated to "${trimmed}" and synced with your browser authenticator.`,
+      });
+    } finally {
+      setBusyKeyId(null);
+    }
+  };
+
+  // Remove a passkey and sync accepted credentials with browser authenticator
+  const handleRemovePasskey = async (pk: StoredPasskey) => {
+    setBusyKeyId(pk.id);
+    setFeedback(null);
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'remove',
+          id: pk.id,
+          credentialId: pk.credentialId,
+        }),
+      });
+
+      let remainingPasskeys: StoredPasskey[];
+      if (response.ok) {
+        const data = await response.json();
+        remainingPasskeys = data.passkeys;
+      } else {
+        remainingPasskeys = passkeys.filter((item) => item.id !== pk.id);
+      }
+
+      setPasskeys(remainingPasskeys);
+      persistLocal(account, remainingPasskeys);
+
+      // Keep browser authenticator in sync using WebAuthn Signal APIs
+      await syncUnknownCredential(pk.credentialId);
+      await syncAllAcceptedCredentials(account.userId, remainingPasskeys);
+
+      setFeedback({
+        type: 'success',
+        text: `Removed passkey "${pk.name}" and synchronized remaining credentials with your browser authenticator.`,
+      });
+    } catch {
+      const remainingPasskeys = passkeys.filter((item) => item.id !== pk.id);
+      setPasskeys(remainingPasskeys);
+      persistLocal(account, remainingPasskeys);
+      await syncUnknownCredential(pk.credentialId);
+      await syncAllAcceptedCredentials(account.userId, remainingPasskeys);
+      setFeedback({
+        type: 'success',
+        text: `Removed passkey "${pk.name}" and synchronized remaining credentials with your browser authenticator.`,
+      });
+    } finally {
+      setBusyKeyId(null);
+    }
+  };
+
+  // Update reader account display name & username and sync with browser authenticator
+  const handleUpdateProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplay = profileDisplayName.trim();
+    const trimmedUser = profileUsername.trim();
+    if (!trimmedDisplay || !trimmedUser) {
+      setFeedback({
+        type: 'error',
+        text: 'Both Display Name and Username / Email are required.',
+      });
+      return;
+    }
+
+    setSavingProfile(true);
+    setFeedback(null);
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'updateProfile',
+          displayName: trimmedDisplay,
+          username: trimmedUser,
+          email: trimmedUser,
+        }),
+      });
+
+      let nextAccount = {
+        ...account,
+        displayName: trimmedDisplay,
+        username: trimmedUser,
+        email: trimmedUser,
+      };
+      let nextPasskeys = passkeys.map((pk) => ({
+        ...pk,
+        displayName: trimmedDisplay,
+        username: trimmedUser,
+      }));
+
+      if (response.ok) {
+        const data = await response.json();
+        nextAccount = data.account;
+        nextPasskeys = data.passkeys;
+      }
+
+      setAccount(nextAccount);
+      setPasskeys(nextPasskeys);
+      persistLocal(nextAccount, nextPasskeys);
+
+      // Signal updated user details to the browser authenticator
+      await syncCurrentUserDetails(
+        nextAccount.userId,
+        nextAccount.username,
+        nextAccount.displayName
+      );
+
+      setFeedback({
+        type: 'success',
+        text: `Account display name updated to "${nextAccount.displayName}" and synced with your browser authenticator.`,
+      });
+    } catch {
+      const nextAccount = {
+        ...account,
+        displayName: trimmedDisplay,
+        username: trimmedUser,
+        email: trimmedUser,
+      };
+      setAccount(nextAccount);
+      persistLocal(nextAccount, passkeys);
+      await syncCurrentUserDetails(
+        nextAccount.userId,
+        nextAccount.username,
+        nextAccount.displayName
+      );
+      setFeedback({
+        type: 'success',
+        text: `Account display name updated to "${nextAccount.displayName}" and synced with your browser authenticator.`,
+      });
+    } finally {
+      setSavingProfile(false);
+    }
+  };
+
+  // Register a new passkey (attempts WebAuthn navigator.credentials.create with graceful fallback)
+  const handleCreatePasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setIsCreatingKey(true);
+    setFeedback(null);
+
+    const chosenName = newKeyName.trim() || 'Chrome Profile Passkey';
+    let generatedCredentialId = '';
+
+    try {
+      if (
+        typeof window !== 'undefined' &&
+        window.PublicKeyCredential &&
+        navigator.credentials &&
+        typeof navigator.credentials.create === 'function'
+      ) {
+        const challenge = crypto.getRandomValues(new Uint8Array(32));
+        const userIdBytes = new TextEncoder().encode(account.userId);
+        const credential = (await navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The DevTools Times',
+              id: getRpId(),
+            },
+            user: {
+              id: userIdBytes,
+              name: account.username,
+              displayName: account.displayName,
+            },
+            pubKeyCredParams: [
+              { alg: -7, type: 'public-key' },
+              { alg: -257, type: 'public-key' },
+            ],
+            authenticatorSelection: {
+              residentKey: 'required',
+              userVerification: 'preferred',
+            },
+            timeout: 15000,
+          },
+        })) as PublicKeyCredential | null;
+
+        if (credential && credential.id) {
+          generatedCredentialId = credential.id;
+        }
+      }
+    } catch {
+      // If user cancels native dialog or headless browser has no virtual authenticator, fallback to generated ID
+    }
+
+    if (!generatedCredentialId) {
+      generatedCredentialId = btoa(
+        String.fromCharCode(...crypto.getRandomValues(new Uint8Array(24)))
+      )
+        .replace(/\+/g, '-')
+        .replace(/\//g, '_')
+        .replace(/=+$/, '');
+    }
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'create',
+          credentialId: generatedCredentialId,
+          name: chosenName,
+          displayName: account.displayName,
+          provider: 'Browser Authenticator',
+        }),
+      });
+
+      if (response.ok) {
+        const data = await response.json();
+        setPasskeys(data.passkeys);
+        persistLocal(account, data.passkeys);
+        await syncAllAcceptedCredentials(account.userId, data.passkeys);
+      }
+      setNewKeyName('');
+      setShowCreateForm(false);
+      setFeedback({
+        type: 'success',
+        text: `Passkey "${chosenName}" registered and synchronized with your browser authenticator.`,
+      });
+    } finally {
+      setIsCreatingKey(false);
+    }
+  };
+
+  // Manual full sync button
+  const handleManualSync = async () => {
+    setFeedback(null);
+    await syncCurrentUserDetails(account.userId, account.username, account.displayName);
+    await syncAllAcceptedCredentials(account.userId, passkeys);
+    setFeedback({
+      type: 'info',
+      text: 'Synchronized current user details and all accepted passkey credentials with your browser authenticator.',
+    });
+  };
+
+  const formatDate = (iso: string) => {
+    try {
+      return new Date(iso).toLocaleDateString('en-US', {
+        year: 'numeric',
+        month: 'short',
+        day: 'numeric',
+      });
+    } catch {
+      return iso;
+    }
+  };
+
+  const renderDeviceIcon = (pk: StoredPasskey) => {
+    const lower = pk.name.toLowerCase();
+    if (lower.includes('iphone') || lower.includes('pixel') || lower.includes('mobile')) {
+      return <DevicePhoneMobileIcon className="w-6 h-6 text-gray-700" />;
