+    if (lower.includes('yubikey') || lower.includes('hardware') || pk.transports.includes('usb')) {
+      return <CpuChipIcon className="w-6 h-6 text-gray-700" />;
+    }
+    return <ComputerDesktopIcon className="w-6 h-6 text-gray-700" />;
+  };
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
+      {/* Page Header */}
+      <div className="border-b-2 border-gray-900 pb-4 mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
+        <div>
+          <p className="text-xs font-bold uppercase tracking-widest text-gray-500 mb-1">
+            Subscriber Account
+          </p>
+          <h1 className="text-3xl md:text-4xl font-bold text-gray-900 font-serif">
+            Account Settings
+          </h1>
+        </div>
+        <div className="flex items-center space-x-2 text-sm text-gray-700 bg-gray-100 px-3 py-1.5 rounded-full border border-gray-200">
+          <UserCircleIcon className="w-5 h-5 text-gray-800" />
+          <span>
+            Signed in as <strong className="font-semibold text-gray-900">{account.displayName}</strong>
+          </span>
+          <span className="inline-block w-2 h-2 rounded-full bg-green-600 ml-1" title="Active Session" />
+        </div>
+      </div>
+
+      {/* Feedback Banner */}
+      {feedback && (
+        <div
+          role="status"
+          aria-live="polite"
+          className={`mb-6 p-4 rounded-lg border flex items-start justify-between gap-3 ${
