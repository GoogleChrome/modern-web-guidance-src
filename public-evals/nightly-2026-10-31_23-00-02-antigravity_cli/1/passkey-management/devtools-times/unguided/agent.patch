+---
+import Layout from '../layouts/Layout.astro';
+import AccountSettings from '../components/AccountSettings';
+import {
+  DEFAULT_ACCOUNT,
+  DEFAULT_PASSKEYS,
+  type AccountProfile,
+  type StoredPasskey,
+} from '../middleware';
+
+const account: AccountProfile = (await Astro.session?.get('account')) || DEFAULT_ACCOUNT;
+const passkeys: StoredPasskey[] = (await Astro.session?.get('passkeys')) || DEFAULT_PASSKEYS;
+---
+
+<Layout title="Account Settings | The DevTools Times">
+  <AccountSettings
+    client:load
+    initialAccount={account}
+    initialPasskeys={passkeys}
+  />
+</Layout>
diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
