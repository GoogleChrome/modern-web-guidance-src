--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,191 @@
+import type { APIRoute } from 'astro';
+import {
+  DEFAULT_ACCOUNT,
+  DEFAULT_PASSKEYS,
+  type AccountProfile,
+  type StoredPasskey,
+} from '../../middleware';
+
+export const GET: APIRoute = async ({ session }) => {
+  const account: AccountProfile = (await session?.get('account')) || DEFAULT_ACCOUNT;
+  const passkeys: StoredPasskey[] = (await session?.get('passkeys')) || DEFAULT_PASSKEYS;
+
+  return new Response(
+    JSON.stringify({
+      account,
+      passkeys,
+    }),
+    {
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json();
+  const { action } = body;
+
+  let account: AccountProfile = (await session?.get('account')) || { ...DEFAULT_ACCOUNT };
+  let passkeys: StoredPasskey[] = (await session?.get('passkeys')) || [...DEFAULT_PASSKEYS];
+
+  if (action === 'rename') {
+    const { id, credentialId, name, displayName } = body;
+    const newName = (name ?? displayName ?? '').trim();
+    if (!newName) {
+      return new Response(JSON.stringify({ error: 'Display name is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    passkeys = passkeys.map((pk) => {
+      if (pk.id === id || pk.credentialId === credentialId || pk.credentialId === id) {
+        return {
+          ...pk,
+          name: newName,
+          displayName: newName,
+        };
+      }
+      return pk;
+    });
+
+    await session?.set('passkeys', passkeys);
+
+    return new Response(
+      JSON.stringify({
+        account,
+        passkeys,
+        message: 'Passkey display name updated.',
+      }),
+      {
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'updateProfile') {
+    const { displayName, username, email } = body;
+    const nextDisplayName = (displayName ?? account.displayName).trim();
+    const nextUsername = (username ?? email ?? account.username).trim();
+
+    if (!nextDisplayName) {
+      return new Response(JSON.stringify({ error: 'Display name is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    account = {
+      ...account,
+      displayName: nextDisplayName,
+      username: nextUsername,
+      email: email ? email.trim() : nextUsername,
+    };
+
+    passkeys = passkeys.map((pk) => ({
+      ...pk,
+      displayName: nextDisplayName,
+      username: nextUsername,
+    }));
+
+    await session?.set('account', account);
+    await session?.set('passkeys', passkeys);
+
+    return new Response(
+      JSON.stringify({
+        account,
+        passkeys,
+        message: 'Account profile details updated.',
+      }),
+      {
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'remove' || action === 'delete') {
+    const { id, credentialId } = body;
+    const removedKey = passkeys.find(
+      (pk) => pk.id === id || pk.credentialId === credentialId || pk.credentialId === id
+    );
+
+    passkeys = passkeys.filter(
+      (pk) => pk.id !== id && pk.credentialId !== credentialId && pk.credentialId !== id
+    );
+
+    await session?.set('passkeys', passkeys);
+
+    return new Response(
+      JSON.stringify({
+        account,
+        passkeys,
+        removedCredentialId: removedKey?.credentialId || credentialId || id,
+        message: 'Passkey removed.',
+      }),
+      {
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'create') {
+    const { credentialId, name, displayName, provider, transports, backedUp } = body;
+    const newPasskey: StoredPasskey = {
+      id: `pk-${Date.now()}`,
+      credentialId:
+        credentialId ||
+        btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(24))))
+          .replace(/\+/g, '-')
+          .replace(/\//g, '_')
+          .replace(/=+$/, ''),
+      name: (name || 'Passkey on This Device').trim(),
+      displayName: (displayName || account.displayName).trim(),
+      userId: account.userId,
+      username: account.username,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+      aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4',
+      provider: provider || 'Browser Authenticator',
+      transports: transports || ['internal', 'hybrid'],
+      backedUp: backedUp ?? true,
+    };
+
+    passkeys = [newPasskey, ...passkeys];
+    await session?.set('passkeys', passkeys);
+
+    return new Response(
+      JSON.stringify({
+        account,
+        passkeys,
+        createdPasskey: newPasskey,
+        message: 'New passkey registered.',
+      }),
+      {
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'reset') {
+    account = { ...DEFAULT_ACCOUNT };
+    passkeys = [...DEFAULT_PASSKEYS];
+    await session?.set('account', account);
+    await session?.set('passkeys', passkeys);
+
+    return new Response(
+      JSON.stringify({
+        account,
+        passkeys,
+        message: 'Demo passkeys and account state restored.',
+      }),
+      {
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  return new Response(JSON.stringify({ error: 'Unsupported action' }), {
+    status: 400,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
