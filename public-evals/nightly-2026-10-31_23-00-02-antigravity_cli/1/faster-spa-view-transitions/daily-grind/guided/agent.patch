+    });
+
+    // Interactive view state handlers (preserved across view switches)
+    const menuSearch = document.getElementById('menu-search');
+    const menuCategory = document.getElementById('menu-category');
+    function filterMenu() {
+      const query = menuSearch.value.trim().toLowerCase();
+      const category = menuCategory.value;
+      document.querySelectorAll('#menu-grid .card').forEach(card => {
+        const matchesCategory = category === 'all' || card.dataset.category === category;
+        const matchesQuery = !query || card.textContent.toLowerCase().includes(query);
+        card.hidden = !(matchesCategory && matchesQuery);
+      });
+    }
+    menuSearch.addEventListener('input', filterMenu);
+    menuCategory.addEventListener('change', filterMenu);
+
+    document.querySelectorAll('.add-to-order-btn').forEach(btn => {
+      let count = 0;
+      btn.addEventListener('click', () => {
+        count += 1;
+        btn.textContent = `Added (${count})`;
+      });
+    });
+
+    const locationSearch = document.getElementById('location-search');
+    locationSearch.addEventListener('input', () => {
+      const query = locationSearch.value.trim().toLowerCase();
+      document.querySelectorAll('#locations-grid .card').forEach(card => {
+        card.hidden = Boolean(query && !card.textContent.toLowerCase().includes(query));
+      });
+    });
+
+    document.querySelectorAll('.select-store-btn').forEach(btn => {
+      btn.addEventListener('click', () => {
+        document.querySelectorAll('.select-store-btn').forEach(other => {
+          other.textContent = 'Set as Preferred Cafe';
+          other.classList.remove('btn-secondary');
+        });
+        btn.textContent = 'Preferred Cafe ✓';
+        btn.classList.add('btn-secondary');
+      });
+    });
+
+    const rewardsBalanceEl = document.getElementById('rewards-balance');
+    document.querySelectorAll('.redeem-btn').forEach(btn => {
+      btn.addEventListener('click', () => {
+        const cost = Number(btn.dataset.cost);
+        const current = Number(rewardsBalanceEl.textContent);
+        if (current >= cost) {
+          rewardsBalanceEl.textContent = String(current - cost);
+          btn.textContent = 'Redeemed ✓';
+        }
+      });
+    });
+
+    const accountForm = document.getElementById('account-form');
+    const accountStatus = document.getElementById('account-status');
+    accountForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      accountStatus.classList.add('visible');
+    });
+
+    // Initialize view based on initial URL path without stealing initial focus
+    const initialViewId = ROUTE_TO_VIEW[window.location.pathname] || 'view-home';
+    if (initialViewId !== 'view-home') {
+      switchToView(initialViewId, { updateHistory: false, manageFocus: false });
+    }
+  </script>
+
 </body>
 
 </html>
