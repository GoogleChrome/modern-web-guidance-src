+    const ROUTE_TO_VIEW = {
+      '/': 'view-home',
+      '/menu': 'view-menu',
+      '/locations': 'view-locations',
+      '/rewards': 'view-rewards',
+      '/account': 'view-account'
+    };
+
+    const VIEW_TO_ROUTE = {
+      'view-home': '/',
+      'view-menu': '/menu',
+      'view-locations': '/locations',
+      'view-rewards': '/rewards',
+      'view-account': '/account'
+    };
+
+    function switchToView(viewId, { updateHistory = true, manageFocus = true } = {}) {
+      const activeView = document.getElementById(viewId);
+      if (!activeView) return;
+
+      // Hide all views while preserving their DOM and cached rendering state
+      document.querySelectorAll('.spa-view').forEach(view => {
+        if (view.id !== viewId) {
+          view.classList.add('inactive');
+          view.setAttribute('aria-hidden', 'true');
+          view.setAttribute('inert', 'inert');
+        }
+      });
+
+      // Show the target view
+      activeView.classList.remove('inactive');
+      activeView.setAttribute('aria-hidden', 'false');
+      activeView.removeAttribute('inert');
+
+      // Update active navigation link state
+      document.querySelectorAll('nav a[data-spa-link]').forEach(link => {
+        if (link.dataset.spaLink === viewId) {
+          link.setAttribute('aria-current', 'page');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+
+      // Update document title for accessibility
+      if (activeView.dataset.title) {
+        document.title = activeView.dataset.title;
+      }
+
+      // Sync URL in browser history
+      const targetPath = VIEW_TO_ROUTE[viewId] || '/';
+      if (updateHistory && window.location.pathname !== targetPath) {
+        window.history.pushState({ viewId }, '', targetPath);
+      }
+
+      // Move focus to the new view to ensure a logical tab-order
+      if (manageFocus) {
+        activeView.focus();
+      }
+    }
+
+    // Intercept SPA navigation clicks
+    document.addEventListener('click', (event) => {
+      const link = event.target.closest('a[data-spa-link]');
+      if (!link) return;
+
+      // Allow modified clicks (new tab/window) to behave normally
+      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
+        return;
+      }
+
+      event.preventDefault();
+      const targetViewId = link.dataset.spaLink;
+      switchToView(targetViewId);
+    });
+
+    // Handle browser back/forward navigation
+    window.addEventListener('popstate', (event) => {
