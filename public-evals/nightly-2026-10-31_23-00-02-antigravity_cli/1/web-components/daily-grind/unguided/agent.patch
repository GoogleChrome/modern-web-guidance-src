+          background: rgba(255, 255, 255, 0.22);
+        }
+        .cart-badge {
+          background: var(--accent, #ffab40);
+          color: #2b1810;
+          font-size: 0.78rem;
+          font-weight: 800;
+          min-width: 1.35rem;
+          height: 1.35rem;
+          border-radius: 999px;
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          padding: 0 0.35rem;
+          transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
+        }
+        .cart-badge.bump {
+          transform: scale(1.3);
+        }
+        .menu-toggle {
+          display: none;
+          background: transparent;
+          border: 1px solid rgba(255, 255, 255, 0.3);
+          color: #ffffff;
+          padding: 0.4rem 0.65rem;
+          border-radius: 6px;
+          font-size: 1.1rem;
+          cursor: pointer;
+        }
+        @media (max-width: 768px) {
+          .menu-toggle {
+            display: inline-flex;
+            align-items: center;
+            justify-content: center;
+          }
+          ul {
+            display: none;
+            position: absolute;
+            top: 100%;
+            left: 0;
+            right: 0;
+            background: #3e2723;
+            flex-direction: column;
+            padding: 1rem 5%;
+            gap: 0.75rem;
+            border-top: 1px solid rgba(255, 255, 255, 0.1);
+            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
+          }
+          ul.open {
+            display: flex;
+          }
+        }
+      </style>
+      <nav aria-label="Primary Navigation">
+        <a href="/" class="logo">
+          <span class="logo-icon" aria-hidden="true">&#9749;</span>
+          <span>${brand}</span>
+        </a>
+        <div class="nav-right">
+          <button
+            type="button"
+            class="menu-toggle"
+            aria-expanded="false"
+            aria-controls="primary-nav-list"
+            aria-label="Toggle navigation menu"
+          >
+            &#9776;
+          </button>
+          <ul id="primary-nav-list">
+            <li><a href="/menu">Menu</a></li>
+            <li><a href="/locations">Locations</a></li>
+            <li><a href="/rewards">Rewards</a></li>
+            <li><a href="/account">My Account</a></li>
+            <li><a href="/logout" class="logout-link">Logout</a></li>
+          </ul>
+          <button
+            type="button"
+            class="cart-trigger"
+            aria-label="Shopping bag, ${this._cartCount} items"
+            aria-haspopup="dialog"
+          >
+            <span aria-hidden="true">&#128717;</span>
+            <span>Order Bag</span>
+            <span class="cart-badge" aria-live="polite">${this._cartCount}</span>
+          </button>
+        </div>
+      </nav>
+    `;
+
+    const toggleBtn = this.shadowRoot.querySelector('.menu-toggle');
+    const navList = this.shadowRoot.querySelector('#primary-nav-list');
+    toggleBtn?.addEventListener('click', () => {
+      this._mobileMenuOpen = !this._mobileMenuOpen;
+      toggleBtn.setAttribute('aria-expanded', String(this._mobileMenuOpen));
+      navList.classList.toggle('open', this._mobileMenuOpen);
+    });
+
+    const cartBtn = this.shadowRoot.querySelector('.cart-trigger');
+    cartBtn?.addEventListener('click', () => {
+      window.dispatchEvent(new CustomEvent('dg-open-cart', { bubbles: true, composed: true }));
+    });
+  }
+}
