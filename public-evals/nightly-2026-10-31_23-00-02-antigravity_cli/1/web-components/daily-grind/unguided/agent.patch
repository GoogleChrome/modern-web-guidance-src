+/**
+ * 1. <dg-navbar>
+ * Accessible sticky navigation bar with mobile menu drawer and interactive cart trigger.
+ */
+class DgNavbar extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._cartCount = 0;
+    this._mobileMenuOpen = false;
+    this._onCartUpdated = this._onCartUpdated.bind(this);
+  }
+
+  connectedCallback() {
+    window.addEventListener('dg-cart-updated', this._onCartUpdated);
+    this.render();
+  }
+
+  disconnectedCallback() {
+    window.removeEventListener('dg-cart-updated', this._onCartUpdated);
+  }
+
+  _onCartUpdated(e) {
+    this._cartCount = e.detail?.totalItems ?? 0;
+    const badge = this.shadowRoot.querySelector('.cart-badge');
+    const cartBtn = this.shadowRoot.querySelector('.cart-trigger');
+    if (badge) {
+      badge.textContent = String(this._cartCount);
+      badge.classList.toggle('bump', true);
+      setTimeout(() => badge.classList.remove('bump'), 250);
+    }
+    if (cartBtn) {
+      cartBtn.setAttribute('aria-label', `Shopping bag, ${this._cartCount} ${this._cartCount === 1 ? 'item' : 'items'}`);
+    }
+  }
+
+  render() {
+    const brand = this.getAttribute('brand') || 'THE DAILY GRIND';
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: block;
+          position: sticky;
+          top: 0;
+          z-index: 1000;
+        }
+        nav {
+          background: var(--primary, #4e342e);
+          color: #ffffff;
+          padding: 0.9rem 5%;
+          display: flex;
+          justify-content: space-between;
+          align-items: center;
+          box-shadow: 0 2px 12px rgba(0, 0, 0, 0.18);
+        }
+        .logo {
+          font-size: 1.45rem;
+          font-weight: 800;
+          letter-spacing: 1.2px;
+          color: #ffffff;
+          text-decoration: none;
+          display: inline-flex;
+          align-items: center;
+          gap: 0.5rem;
+        }
+        .logo-icon {
+          color: var(--accent, #ffab40);
+          font-size: 1.3rem;
+        }
+        .nav-right {
+          display: flex;
+          align-items: center;
+          gap: 1.25rem;
+        }
+        ul {
+          display: flex;
+          list-style: none;
+          margin: 0;
+          padding: 0;
+          align-items: center;
+          gap: 1.25rem;
+        }
+        a {
+          color: #ffffff;
+          text-decoration: none;
+          font-size: 0.92rem;
+          font-weight: 500;
+          transition: color 0.25s ease, background-color 0.25s ease;
+          padding: 0.35rem 0.5rem;
+          border-radius: 4px;
+        }
