+          color: var(--accent, #ffab40);
+          outline: none;
+        }
+        a:focus-visible, button:focus-visible {
+          box-shadow: 0 0 0 2px var(--accent, #ffab40);
+        }
+        .logout-link {
+          border: 1px solid var(--accent, #ffab40);
