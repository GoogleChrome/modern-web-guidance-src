+/**
+ * 3. <dg-coffee-card>
+ * Reusable, accessible Web Component representing an individual coffee product card.
+ * Supports attributes: item-id, title, description, price, category, badge, image, href, calories, caffeine, roast, origin, notes, allergens
+ * Emits custom events: `dg-card-details` and `dg-add-to-cart` (bubbles: true, composed: true)
+ */
+class DgCoffeeCard extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._selectedSize = 'Medium';
+    this._selectedMilk = 'Oat Milk';
+    this._favorited = false;
+  }
+
+  static get observedAttributes() {
+    return [
+      'item-id',
+      'title',
+      'description',
+      'price',
+      'category',
+      'badge',
+      'image',
+      'href',
+      'calories',
+      'caffeine',
+      'roast',
+      'origin',
+      'notes',
+      'allergens'
+    ];
+  }
+
+  attributeChangedCallback() {
+    if (this.isConnected) {
+      this.render();
+    }
+  }
+
+  connectedCallback() {
+    this.render();
+  }
+
+  get itemData() {
+    const basePrice = parseFloat(this.getAttribute('price') || '4.75');
+    const sizeUpcharge = this._selectedSize === 'Large' ? 0.75 : this._selectedSize === 'Small' ? -0.50 : 0;
+    return {
+      id: this.getAttribute('item-id') || this.getAttribute('title')?.toLowerCase().replace(/\s+/g, '-') || 'coffee-item',
+      title: this.getAttribute('title') || 'Artisanal Coffee',
+      description: this.getAttribute('description') || '',
+      basePrice,
+      price: Number((basePrice + sizeUpcharge).toFixed(2)),
+      category: this.getAttribute('category') || 'seasonal',
+      badge: this.getAttribute('badge') || '',
+      image: this.getAttribute('image') || 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80',
+      href: this.getAttribute('href') || '/menu',
+      calories: this.getAttribute('calories') || '120',
+      caffeine: this.getAttribute('caffeine') || '150mg',
+      roast: this.getAttribute('roast') || 'Medium Roast',
+      origin: this.getAttribute('origin') || 'House Blend',
+      notes: this.getAttribute('notes') || 'Smooth, balanced, aromatic',
+      allergens: this.getAttribute('allergens') || 'None',
+      size: this._selectedSize,
+      milk: this._selectedMilk
+    };
+  }
+
+  render() {
+    const data = this.itemData;
