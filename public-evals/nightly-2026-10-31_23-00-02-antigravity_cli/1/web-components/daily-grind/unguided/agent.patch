+        }
+        .footer-links {
+          margin-bottom: 1.1rem;
+          display: flex;
+          flex-wrap: wrap;
+          justify-content: center;
+          gap: 0.75rem;
+        }
+        .footer-links a {
+          color: var(--text, #3e2723);
+          text-decoration: none;
+          font-size: 0.88rem;
+          font-weight: 600;
+        }
+        .footer-links a:hover {
+          text-decoration: underline;
+        }
+        .copy {
+          font-size: 0.84rem;
+          margin: 0;
+        }
+      </style>
+      <footer role="contentinfo">
+        <div class="newsletter">
+          <h3>Join the Roaster’s Club</h3>
+          <p>Get early access to single-origin drops and seasonal tasting events.</p>
+          ${
+            this._subscribed
+              ? `<p role="status" aria-live="polite"><strong>Thanks for subscribing! Check your inbox for 15% off your next cup.</strong></p>`
+              : `<form id="newsletter-form" aria-label="Newsletter sign up">
+                   <input type="email" placeholder="you@example.com" aria-label="Email address" required />
+                   <button type="submit">Subscribe</button>
+                 </form>`
+          }
+        </div>
+        <div class="footer-links">
+          <a href="/about">Our Story</a>
+          <span aria-hidden="true">|</span>
+          <a href="/careers">Join the Team</a>
+          <span aria-hidden="true">|</span>
+          <a href="/contact">Contact Us</a>
+          <span aria-hidden="true">|</span>
+          <a href="/privacy-policy">Privacy</a>
+        </div>
+        <p class="copy">&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+      </footer>
+    `;
+
+    const form = this.shadowRoot.querySelector('#newsletter-form');
+    form?.addEventListener('submit', (e) => {
+      e.preventDefault();
+      this._subscribed = true;
+      this.render();
+    });
+  }
+}
+
+// Register all custom elements safely
+const CUSTOM_ELEMENTS = [
+  ['dg-navbar', DgNavbar],
+  ['dg-hero', DgHero],
+  ['dg-coffee-card', DgCoffeeCard],
+  ['dg-menu-section', DgMenuSection],
+  ['dg-brew-finder', DgBrewFinder],
+  ['dg-rewards-calculator', DgRewardsCalculator],
+  ['dg-details-modal', DgDetailsModal],
+  ['dg-order-drawer', DgOrderDrawer],
+  ['dg-footer', DgFooter]
+];
+
+for (const [tag, clazz] of CUSTOM_ELEMENTS) {
+  if (!customElements.get(tag)) {
+    customElements.define(tag, clazz);
+  }
+}
+
+export {
+  COFFEE_ITEMS,
+  DgNavbar,
+  DgHero,
+  DgCoffeeCard,
+  DgMenuSection,
+  DgBrewFinder,
+  DgRewardsCalculator,
+  DgDetailsModal,
+  DgOrderDrawer,
+  DgFooter
+};
