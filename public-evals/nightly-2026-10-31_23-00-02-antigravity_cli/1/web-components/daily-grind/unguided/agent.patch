+        this._isOpen = false;
+        this.render();
+      }
+    });
+
+    this.shadowRoot.querySelectorAll('.qty-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const key = btn.dataset.key;
+        const delta = parseInt(btn.dataset.delta, 10);
+        const target = this._items.find((i) => i.key === key);
+        if (target) {
+          target.qty += delta;
+          if (target.qty <= 0) {
+            this._items = this._items.filter((i) => i.key !== key);
+          }
+          this._broadcastCartUpdate();
+          this.render();
+        }
+      });
+    });
+  }
+}
