+          border-radius: 4px;
+        }
+        .logout-link:hover {
+          background: rgba(255, 171, 64, 0.12);
+        }
+        .cart-trigger {
+          background: rgba(255, 255, 255, 0.12);
+          color: #ffffff;
+          border: 1px solid rgba(255, 255, 255, 0.25);
+          padding: 0.45rem 0.85rem;
+          border-radius: 999px;
+          cursor: pointer;
+          display: inline-flex;
