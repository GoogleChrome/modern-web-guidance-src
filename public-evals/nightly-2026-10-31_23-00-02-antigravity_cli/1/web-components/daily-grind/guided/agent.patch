+/**
+ * Daily Grind Reusable & Accessible Web Components
+ *
+ * Components:
+ * - <dg-navbar>: Accessible navigation header with responsive toggle & cart badge
+ * - <dg-hero>: Accessible promotional hero banner with slots and custom properties
+ * - <dg-coffee-card>: Encapsulated coffee product card with size/temperature customization,
+ *   favorite toggle (exposing `:state(favorited)`), expandable tasting notes modal/details,
+ *   and add-to-order actions.
+ * - <dg-menu-showcase>: Interactive filterable & searchable menu showcase managing
+ *   category filtering, dietary/roast tags, and live region announcements.
+ * - <dg-brew-customizer>: Interactive coffee & brew calculator / customizer widget.
+ * - <dg-order-drawer>: Interactive order summary & cart drawer using native <dialog>
+ *   inside Shadow DOM with full keyboard and screen-reader accessibility.
+ * - <dg-footer>: Reusable site footer with newsletter signup and links.
+ */
+
+// ============================================================================
+// 1. <dg-coffee-card> — Reusable Coffee Product Card Web Component
+// ============================================================================
+
+const coffeeCardSheet = new CSSStyleSheet();
+coffeeCardSheet.replaceSync(`
