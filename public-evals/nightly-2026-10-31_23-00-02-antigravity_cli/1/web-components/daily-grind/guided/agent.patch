+  #applyFilters() {
+    const filterBtns = this.shadowRoot.querySelectorAll('.filter-btn');
+    filterBtns.forEach((btn) => {
+      btn.setAttribute('aria-pressed', String(btn.dataset.category === this.#category));
+    });
+
+    const cards = this.#getSlottedCards();
+    let visibleCount = 0;
+
+    for (const card of cards) {
+      const cardCategory = (card.getAttribute('category') || '').toLowerCase();
+      const cardText = `${card.getAttribute('name') || ''} ${card.getAttribute('description') || ''} ${card.getAttribute('notes') || ''} ${card.getAttribute('origin') || ''}`.toLowerCase();
+      const isFav = card.hasAttribute('favorited');
+
+      const matchesCategory = this.#category === 'all' || cardCategory === this.#category;
+      const matchesQuery = !this.#query || cardText.includes(this.#query);
+      const matchesFav = !this.#favoritesOnly || isFav;
+
+      const visible = matchesCategory && matchesQuery && matchesFav;
+      card.hidden = !visible;
+      if (visible) visibleCount++;
