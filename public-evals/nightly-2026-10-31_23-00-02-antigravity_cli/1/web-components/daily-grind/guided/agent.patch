+export class DgOrderDrawer extends HTMLElement {
+  #items = new Map();
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [orderDrawerSheet];
+    this.shadowRoot.append(orderDrawerTemplate.content.cloneNode(true));
+
+    this.#bindEvents();
+  }
+
+  get totalQuantity() {
+    let count = 0;
+    for (const item of this.#items.values()) {
+      count += item.qty;
+    }
+    return count;
+  }
+
+  addItem(itemDetail) {
+    const key = itemDetail.id;
+    const existing = this.#items.get(key);
+    if (existing) {
+      existing.qty += 1;
+    } else {
+      this.#items.set(key, { ...itemDetail, qty: 1 });
+    }
+    this.#renderItems();
+    this.#notifyChange();
+  }
+
+  open() {
+    const dialog = this.shadowRoot.getElementById('order-dialog');
+    if (dialog && !dialog.open) {
+      dialog.showModal();
+    }
+  }
+
+  close() {
+    const dialog = this.shadowRoot.getElementById('order-dialog');
+    if (dialog && dialog.open) {
+      dialog.close();
+    }
+  }
+
+  #bindEvents() {
+    const dialog = this.shadowRoot.getElementById('order-dialog');
+    const closeBtn = this.shadowRoot.getElementById('close-drawer-btn');
+
+    closeBtn.addEventListener('click', () => this.close());
+
+    // Light dismiss on backdrop click
+    dialog.addEventListener('click', (e) => {
+      if (e.target === dialog) {
+        this.close();
+      }
+    });
+  }
+
+  #updateQuantity(key, delta) {
+    const entry = this.#items.get(key);
+    if (!entry) return;
+    entry.qty += delta;
+    if (entry.qty <= 0) {
+      this.#items.delete(key);
+    }
+    this.#renderItems();
+    this.#notifyChange();
+  }
+
+  #notifyChange() {
+    this.dispatchEvent(
+      new CustomEvent('dg-order-updated', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          totalQuantity: this.totalQuantity,
+        },
+      })
+    );
+  }
+
+  #renderItems() {
+    const listEl = this.shadowRoot.getElementById('order-items');
+    const emptyEl = this.shadowRoot.getElementById('empty-cart-msg');
+    const totalEl = this.shadowRoot.getElementById('order-total');
+
+    listEl.innerHTML = '';
+    let total = 0;
+
+    for (const [key, item] of this.#items.entries()) {
+      total += item.unitPrice * item.qty;
+      const li = document.createElement('li');
+      li.className = 'order-item';
+
+      const info = document.createElement('div');
+      info.className = 'item-info';
+      const title = document.createElement('strong');
+      title.textContent = item.name;
+      const meta = document.createElement('span');
+      meta.textContent = `${item.sizeLabel} · $${item.unitPrice.toFixed(2)} each`;
+      info.append(title, meta);
+
+      const actions = document.createElement('div');
+      actions.className = 'item-actions';
+
+      const decBtn = document.createElement('button');
+      decBtn.type = 'button';
+      decBtn.className = 'qty-btn';
+      decBtn.textContent = '−';
+      decBtn.setAttribute('aria-label', `Decrease quantity of ${item.name}`);
+      decBtn.addEventListener('click', () => this.#updateQuantity(key, -1));
+
+      const qtySpan = document.createElement('span');
+      qtySpan.textContent = String(item.qty);
+      qtySpan.setAttribute('aria-label', `Quantity ${item.qty}`);
+
+      const incBtn = document.createElement('button');
+      incBtn.type = 'button';
+      incBtn.className = 'qty-btn';
+      incBtn.textContent = '+';
+      incBtn.setAttribute('aria-label', `Increase quantity of ${item.name}`);
+      incBtn.addEventListener('click', () => this.#updateQuantity(key, 1));
+
+      actions.append(decBtn, qtySpan, incBtn);
+      li.append(info, actions);
+      listEl.append(li);
+    }
+
+    emptyEl.hidden = this.#items.size > 0;
+    totalEl.textContent = `$${total.toFixed(2)}`;
+  }
+}
+
+customElements.define('dg-order-drawer', DgOrderDrawer);
