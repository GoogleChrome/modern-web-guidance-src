+`);
+
+const coffeeCardTemplate = document.createElement('template');
+coffeeCardTemplate.innerHTML = `
+  <article class="card" part="card">
+    <div class="media-wrap" part="media">
+      <img id="card-img" src="" alt="" loading="lazy" decoding="async" />
+      <div class="badge-row">
+        <span id="card-badge" class="badge" part="badge">Seasonal</span>
+        <button type="button" id="fav-btn" class="fav-btn" part="favorite-button" aria-pressed="false" aria-label="Save to favorites">
+          <svg class="fav-icon" viewBox="0 0 24 24" aria-hidden="true">
+            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
+          </svg>
+        </button>
+      </div>
+    </div>
+
+    <div class="content" part="content">
+      <div class="header-row">
+        <h3 id="card-title" part="title"><slot name="title">Artisanal Coffee</slot></h3>
+        <span id="card-price" class="price" part="price" aria-live="polite">$4.50</span>
+      </div>
+
+      <p id="card-desc" class="description" part="description">
+        <slot>Freshly roasted specialty coffee crafted with care.</slot>
+      </p>
+
+      <ul id="card-tags" class="meta-tags" aria-label="Flavor notes and dietary tags"></ul>
+
+      <details class="tasting-details" part="details">
+        <summary>Origin &amp; Roast Profile</summary>
+        <div class="tasting-body">
+          <div class="tasting-stat">
+            <strong>Roast Level</strong>
+            <span id="stat-roast">Medium</span>
+          </div>
+          <div class="tasting-stat">
+            <strong>Origin</strong>
+            <span id="stat-origin">Single Origin</span>
+          </div>
+          <div class="tasting-stat">
+            <strong>Caffeine</strong>
+            <span id="stat-caffeine">140mg</span>
+          </div>
+          <div class="tasting-stat">
+            <strong>Prep Time</strong>
+            <span id="stat-prep">3 mins</span>
+          </div>
+        </div>
+      </details>
+
+      <div class="controls" part="controls">
+        <div class="fieldset-row" role="group" aria-labelledby="size-group-label">
+          <span id="size-group-label" class="fieldset-label">Size</span>
+          <div class="size-group">
+            <button type="button" class="size-btn" data-size="S" data-delta="-0.5" aria-pressed="false">8oz</button>
+            <button type="button" class="size-btn" data-size="M" data-delta="0" aria-pressed="true">12oz</button>
+            <button type="button" class="size-btn" data-size="L" data-delta="0.75" aria-pressed="false">16oz</button>
+          </div>
+        </div>
+
+        <div class="actions">
+          <button type="button" id="add-btn" class="add-btn" part="cta">
+            <span id="add-btn-text">Add to Order</span>
+          </button>
+          <a id="details-link" href="/menu" class="details-link" part="link">Details</a>
+        </div>
+      </div>
+    </div>
+  </article>
+`;
+
+const SIZE_LABELS = { S: 'Small (8oz)', M: 'Medium (12oz)', L: 'Large (16oz)' };
+
+export class DgCoffeeCard extends HTMLElement {
+  static observedAttributes = [
+    'name',
+    'description',
+    'price',
+    'category',
+    'badge',
+    'image',
+    'href',
+    'roast',
+    'origin',
+    'caffeine',
+    'notes',
+    'favorited',
+    'size',
+    'disabled',
+  ];
+
+  #internals;
+  #size = 'M';
+  #addedTimer = null;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [coffeeCardSheet];
+    this.shadowRoot.append(coffeeCardTemplate.content.cloneNode(true));
+
+    this.#bindEvents();
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    if (this.#addedTimer) {
+      clearTimeout(this.#addedTimer);
+      this.#addedTimer = null;
+    }
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'size' && ['S', 'M', 'L'].includes(newVal)) {
+      this.#size = newVal;
+    }
+    if (name === 'favorited') {
+      this.#syncFavoriteState();
+    }
+    if (this.isConnected) {
+      this.#render();
+    }
+  }
+
+  // Reflected properties
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+  set name(v) {
+    v ? this.setAttribute('name', v) : this.removeAttribute('name');
+  }
+
+  get description() {
+    return this.getAttribute('description') ?? '';
+  }
+  set description(v) {
+    v ? this.setAttribute('description', v) : this.removeAttribute('description');
+  }
+
+  get price() {
+    return Number(this.getAttribute('price')) || 4.5;
+  }
+  set price(v) {
+    this.setAttribute('price', String(v));
+  }
+
+  get category() {
+    return this.getAttribute('category') ?? 'seasonal';
+  }
+  set category(v) {
+    v ? this.setAttribute('category', v) : this.removeAttribute('category');
+  }
+
+  get favorited() {
+    return this.hasAttribute('favorited');
+  }
+  set favorited(on) {
+    this.toggleAttribute('favorited', !!on);
+  }
+
+  get disabled() {
+    return this.hasAttribute('disabled');
+  }
+  set disabled(on) {
+    this.toggleAttribute('disabled', !!on);
+  }
+
+  get selectedSize() {
+    return this.#size;
+  }
+  set selectedSize(v) {
+    if (['S', 'M', 'L'].includes(v)) {
+      this.#size = v;
+      this.setAttribute('size', v);
+      this.#render();
+    }
+  }
+
+  get currentPrice() {
+    const deltaMap = { S: -0.5, M: 0, L: 0.75 };
+    return Math.max(0, this.price + (deltaMap[this.#size] ?? 0));
+  }
+
+  #bindEvents() {
+    const favBtn = this.shadowRoot.getElementById('fav-btn');
+    favBtn.addEventListener('click', () => {
+      this.favorited = !this.favorited;
+      this.#syncFavoriteState();
+      this.dispatchEvent(
+        new CustomEvent('dg-favorite-change', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            id: this.id || this.name.toLowerCase().replace(/\s+/g, '-'),
+            name: this.name,
+            favorited: this.favorited,
+          },
+        })
+      );
+    });
+
+    const sizeButtons = this.shadowRoot.querySelectorAll('.size-btn');
+    sizeButtons.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const newSize = btn.dataset.size;
+        if (newSize && newSize !== this.#size) {
+          this.#size = newSize;
+          this.#updateSizeUI();
+          this.dispatchEvent(
+            new CustomEvent('dg-size-change', {
+              bubbles: true,
+              composed: true,
+              detail: {
+                name: this.name,
+                size: this.#size,
+                price: this.currentPrice,
+              },
+            })
+          );
+        }
+      });
+    });
+
+    const addBtn = this.shadowRoot.getElementById('add-btn');
+    addBtn.addEventListener('click', () => {
+      this.dispatchEvent(
+        new CustomEvent('dg-add-to-order', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            id: `${this.id || this.name.toLowerCase().replace(/\s+/g, '-')}-${this.#size}`,
+            name: this.name,
+            size: this.#size,
+            sizeLabel: SIZE_LABELS[this.#size],
+            unitPrice: this.currentPrice,
+            category: this.category,
+            image: this.getAttribute('image') || '',
+          },
+        })
+      );
+
+      // Provide accessible visual & state confirmation
+      this.#internals.states.add('just-added');
+      const addText = this.shadowRoot.getElementById('add-btn-text');
+      addText.textContent = `Added (${this.#size})!`;
+      if (this.#addedTimer) clearTimeout(this.#addedTimer);
+      this.#addedTimer = setTimeout(() => {
+        this.#internals.states.delete('just-added');
+        addText.textContent = 'Add to Order';
+      }, 1400);
+    });
+  }
+
+  #syncFavoriteState() {
+    const isFav = this.favorited;
+    if (isFav) {
+      this.#internals.states.add('favorited');
+    } else {
+      this.#internals.states.delete('favorited');
+    }
+    const favBtn = this.shadowRoot.getElementById('fav-btn');
+    if (favBtn) {
+      favBtn.setAttribute('aria-pressed', String(isFav));
+      favBtn.setAttribute(
+        'aria-label',
+        isFav ? `Remove ${this.name || 'item'} from favorites` : `Save ${this.name || 'item'} to favorites`
+      );
+    }
+  }
+
+  #updateSizeUI() {
+    const sizeButtons = this.shadowRoot.querySelectorAll('.size-btn');
+    sizeButtons.forEach((btn) => {
+      const active = btn.dataset.size === this.#size;
+      btn.setAttribute('aria-pressed', String(active));
+    });
+    const priceEl = this.shadowRoot.getElementById('card-price');
+    if (priceEl) {
+      priceEl.textContent = `$${this.currentPrice.toFixed(2)}`;
+    }
+    const addBtn = this.shadowRoot.getElementById('add-btn');
+    if (addBtn && this.name) {
+      addBtn.setAttribute(
+        'aria-label',
+        `Add ${SIZE_LABELS[this.#size]} ${this.name} to order for $${this.currentPrice.toFixed(2)}`
+      );
+    }
+  }
+
+  #render() {
+    const titleEl = this.shadowRoot.getElementById('card-title');
+    const descEl = this.shadowRoot.getElementById('card-desc');
+    const badgeEl = this.shadowRoot.getElementById('card-badge');
+    const imgEl = this.shadowRoot.getElementById('card-img');
+    const linkEl = this.shadowRoot.getElementById('details-link');
+    const tagsEl = this.shadowRoot.getElementById('card-tags');
+
+    if (this.name) {
+      titleEl.textContent = this.name;
+    }
+    if (this.description) {
+      descEl.textContent = this.description;
+    }
+
+    const badge = this.getAttribute('badge') || this.category;
+    if (badge) {
+      badgeEl.textContent = badge;
+      badgeEl.hidden = false;
+    } else {
+      badgeEl.hidden = true;
+    }
+
+    const imgSrc =
+      this.getAttribute('image') ||
+      'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80';
+    imgEl.src = imgSrc;
+    imgEl.alt = this.getAttribute('image-alt') || `${this.name || 'Coffee'} served fresh`;
+
+    const href = this.getAttribute('href') || '/menu';
+    linkEl.href = href;
+    linkEl.setAttribute('aria-label', `View details for ${this.name || 'this coffee'}`);
+
+    // Stats
+    this.shadowRoot.getElementById('stat-roast').textContent = this.getAttribute('roast') || 'Medium';
+    this.shadowRoot.getElementById('stat-origin').textContent = this.getAttribute('origin') || 'House Blend';
+    this.shadowRoot.getElementById('stat-caffeine').textContent = this.getAttribute('caffeine') || '150mg';
+
+    // Notes tags
+    const notesRaw = this.getAttribute('notes') || '';
+    const notes = notesRaw
+      .split(',')
+      .map((s) => s.trim())
+      .filter(Boolean);
