+    const favCheckbox = this.shadowRoot.getElementById('fav-only-checkbox');
+    favCheckbox.addEventListener('change', (e) => {
+      this.#favoritesOnly = e.target.checked;
+      this.#applyFilters();
+    });
+
+    const resetBtn = this.shadowRoot.getElementById('reset-filters-btn');
+    resetBtn.addEventListener('click', () => {
+      this.#category = 'all';
+      this.#query = '';
+      this.#favoritesOnly = false;
+      searchInput.value = '';
+      favCheckbox.checked = false;
+      this.#applyFilters();
+    });
+
+    const slot = this.shadowRoot.getElementById('cards-slot');
+    slot.addEventListener('slotchange', () => {
+      this.#applyFilters();
+    });
+
+    this.addEventListener('dg-favorite-change', () => {
+      if (this.#favoritesOnly) {
+        this.#applyFilters();
+      }
+    });
+  }
+
+  #getSlottedCards() {
+    const slot = this.shadowRoot.getElementById('cards-slot');
+    return slot
+      .assignedElements({ flatten: true })
+      .filter((el) => el.tagName.toLowerCase() === 'dg-coffee-card');
+  }
