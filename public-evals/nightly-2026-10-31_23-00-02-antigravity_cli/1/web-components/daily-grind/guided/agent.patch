+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [menuShowcaseSheet];
+    this.shadowRoot.append(menuShowcaseTemplate.content.cloneNode(true));
+
+    this.#bindEvents();
+  }
+
+  connectedCallback() {
+    this.#applyFilters();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'active-category' && newVal) {
+      this.#category = newVal;
+      this.#applyFilters();
+    }
+  }
+
+  get activeCategory() {
+    return this.#category;
+  }
+  set activeCategory(val) {
+    this.#category = val || 'all';
+    this.setAttribute('active-category', this.#category);
+    this.#applyFilters();
+  }
+
+  #bindEvents() {
+    const filterBtns = this.shadowRoot.querySelectorAll('.filter-btn');
+    filterBtns.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        this.#category = btn.dataset.category || 'all';
+        this.#applyFilters();
+      });
+    });
+
+    const searchInput = this.shadowRoot.getElementById('search-input');
+    searchInput.addEventListener('input', (e) => {
+      this.#query = e.target.value.trim().toLowerCase();
