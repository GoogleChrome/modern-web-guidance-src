+
+      function updateSystemOptionLabel() {
+        if (!systemOption) return;
+        const sysTheme = darkMediaQuery.matches ? 'dark' : 'light';
+        systemOption.textContent = `System Default (Currently ${sysTheme})`;
+      }
+
+      function applyTheme(value, persist = true) {
+        const normalized = (value === 'light' || value === 'dark') ? value : 'light dark';
+
+        // Update <meta name="color-scheme"> and force the chosen theme on the root element
+        if (metaColorScheme) {
+          metaColorScheme.content = normalized;
+        }
+        rootEl.style.colorScheme = normalized;
+        rootEl.dataset.theme = normalized === 'light dark' ? 'system' : normalized;
+
+        if (themeSelect && themeSelect.value !== normalized) {
+          themeSelect.value = normalized;
+        }
+
+        if (persist) {
+          try {
+            if (normalized === 'light dark') {
+              localStorage.removeItem('color-scheme');
+            } else {
+              localStorage.setItem('color-scheme', normalized);
+            }
+          } catch (e) {}
+        }
+      }
+
+      // Initialize from stored preference or default to system
+      let initialScheme = 'light dark';
+      try {
+        const stored = localStorage.getItem('color-scheme');
+        if (stored === 'light' || stored === 'dark') {
+          initialScheme = stored;
+        }
+      } catch (e) {}
+
+      updateSystemOptionLabel();
+      applyTheme(initialScheme, false);
+
+      themeSelect.addEventListener('change', (e) => {
+        applyTheme(e.target.value, true);
+      });
+
+      // Listen for system color-scheme changes to keep the System Default label accurate
+      darkMediaQuery.addEventListener('change', () => {
+        updateSystemOptionLabel();
+      });
+
+      // Keep tabs in sync when localStorage changes
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          applyTheme(e.newValue ?? 'light dark', false);
+        }
+      });
+
+      // Filter functionality for the Late Night Specials select menu
+      const specialsSelect = document.getElementById('specials-category');
+      const specialItems = document.querySelectorAll('#specials-scroll .special-item');
+      if (specialsSelect) {
+        specialsSelect.addEventListener('change', (e) => {
+          const category = e.target.value;
+          specialItems.forEach((item) => {
+            item.hidden = category !== 'all' && item.dataset.category !== category;
+          });
+        });
+      }
+    })();
+  </script>
