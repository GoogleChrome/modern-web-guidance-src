+  <script>
+    const promoAlert = document.getElementById('promo-alert');
+    const alertDismiss = document.getElementById('alert-dismiss');
+
+    if (!CSS.supports('selector(:has(*))') && alertDismiss && promoAlert) {
+      alertDismiss.addEventListener('change', (e) => {
+        promoAlert.classList.toggle('is-dismissed', e.target.checked);
