+  <script>
+    const drinkCardSheet = new CSSStyleSheet();
+    drinkCardSheet.replaceSync(`
+      :host {
+        display: block;
+        --_primary: var(--primary, #4e342e);
+        --_accent: var(--accent, #ffab40);
+        --_text: var(--text, #3e2723);
+        --_card-bg: var(--card-bg, white);
+      }
+
+      .card {
+        position: relative;
+        background: var(--_card-bg);
+        color: var(--_text);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        height: 100%;
+        display: flex;
+        flex-direction: column;
+        align-items: center;
+      }
+
+      .badge-wrapper {
+        display: none;
+        margin-bottom: 8px;
+      }
+
+      :host([limited]) .badge-wrapper,
+      :host([badge]:not([badge=""])) .badge-wrapper,
+      :host(:state(has-badge)) .badge-wrapper {
+        display: inline-block;
+      }
+
+      .badge,
+      ::slotted([slot="badge"]) {
+        display: inline-block;
+        background: var(--_accent);
+        color: var(--_text);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.05em;
+        padding: 3px 10px;
+        border-radius: 999px;
+      }
+
+      .title,
+      ::slotted([slot="title"]) {
+        margin: 0 0 10px;
+        color: var(--_primary);
+        font-size: 1.17em;
+        font-weight: bold;
+      }
+
+      .description,
+      ::slotted([slot="description"]),
+      ::slotted(p) {
+        margin: 0;
+        color: var(--_text);
+      }
+
+      .action-wrapper {
+        margin-top: auto;
+        padding-top: 15px;
+      }
+
+      .btn,
+      ::slotted([slot="action"]) {
+        display: inline-block;
+        background: var(--_primary);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        transition: background 0.3s;
+      }
+
+      .btn:hover,
+      ::slotted([slot="action"]:hover) {
+        background: #3e2723;
+      }
+    `);
+
+    const drinkCardTemplate = document.createElement('template');
+    drinkCardTemplate.innerHTML = `
+      <article class="card" part="card">
+        <div class="badge-wrapper" part="badge-wrapper">
+          <slot name="badge"><span class="badge" part="badge">Limited</span></slot>
+        </div>
+        <slot name="title"><h3 class="title" part="title"></h3></slot>
+        <slot name="description"><slot><p class="description" part="description"></p></slot></slot>
+        <div class="action-wrapper" part="action-wrapper">
+          <slot name="action"><a class="btn" part="action" href="#">View Details</a></slot>
+        </div>
+      </article>
+    `;
+
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = [
+        'drink-title',
+        'description',
+        'href',
+        'action-label',
+        'limited',
+        'badge',
+      ];
+
+      #internals;
+      #titleEl;
+      #descriptionEl;
+      #actionEl;
+      #badgeEl;
+      #badgeSlot;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.shadowRoot.adoptedStyleSheets = [drinkCardSheet];
+        this.shadowRoot.append(drinkCardTemplate.content.cloneNode(true));
+
+        this.#titleEl = this.shadowRoot.querySelector('.title');
+        this.#descriptionEl = this.shadowRoot.querySelector('.description');
+        this.#actionEl = this.shadowRoot.querySelector('.btn');
+        this.#badgeEl = this.shadowRoot.querySelector('.badge');
+        this.#badgeSlot = this.shadowRoot.querySelector('slot[name="badge"]');
+
+        this.#badgeSlot.addEventListener('slotchange', () => this.#syncBadgeState());
+      }
+
+      connectedCallback() {
+        this.#render();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.#render();
+        }
+      }
+
+      get drinkTitle() {
+        return this.getAttribute('drink-title') ?? '';
+      }
+
+      set drinkTitle(v) {
+        v ? this.setAttribute('drink-title', v) : this.removeAttribute('drink-title');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+
+      set description(v) {
+        v ? this.setAttribute('description', v) : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '#';
+      }
+
+      set href(v) {
+        v ? this.setAttribute('href', v) : this.removeAttribute('href');
+      }
+
+      get actionLabel() {
+        return this.getAttribute('action-label') ?? 'View Details';
+      }
+
+      set actionLabel(v) {
+        v ? this.setAttribute('action-label', v) : this.removeAttribute('action-label');
+      }
+
+      get limited() {
+        return this.hasAttribute('limited');
+      }
+
+      set limited(on) {
+        this.toggleAttribute('limited', !!on);
+      }
+
+      get badge() {
+        return this.getAttribute('badge') ?? '';
+      }
+
+      set badge(v) {
+        v ? this.setAttribute('badge', v) : this.removeAttribute('badge');
+      }
+
+      #syncBadgeState() {
+        const hasSlottedBadge = this.#badgeSlot.assignedNodes({ flatten: false }).some(
+          (node) => node.nodeType === Node.ELEMENT_NODE || (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '')
+        );
+        if (hasSlottedBadge) {
+          this.#internals.states.add('has-badge');
+        } else {
+          this.#internals.states.delete('has-badge');
+        }
+      }
+
+      #render() {
+        if (!this.#titleEl) return;
+        this.#titleEl.textContent = this.drinkTitle;
+        this.#descriptionEl.textContent = this.description;
+        this.#actionEl.setAttribute('href', this.href);
+        this.#actionEl.textContent = this.actionLabel;
+
+        const badgeAttr = this.getAttribute('badge');
+        this.#badgeEl.textContent = badgeAttr ? badgeAttr : 'Limited';
+        this.#syncBadgeState();
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
 </body>
 
