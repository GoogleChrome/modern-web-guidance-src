+        const st = cardStates[cardId];
+        const sizeInfo = meta.sizes[st.size] || { priceDelta: 0, cal: meta.baseCal };
+        return {
+          price: (meta.basePrice + sizeInfo.priceDelta).toFixed(2),
+          cal: sizeInfo.cal
+        };
+      }
+
+      function renderCardDOM(cardEl, cardId) {
+        const meta = CARD_DATA[cardId];
+        const st = cardStates[cardId];
+        const metrics = computeCardMetrics(cardId);
+
+        cardEl.classList.toggle('is-expanded', st.expanded);
+
+        const priceEl = cardEl.querySelector('.price-tag');
+        if (priceEl) priceEl.textContent = '$' + metrics.price;
+
+        const calEl = cardEl.querySelector('.card-cal');
+        if (calEl) calEl.textContent = metrics.cal + ' cal';
+
+        const toggleBtn = cardEl.querySelector('[data-action="toggle-card"]');
+        if (toggleBtn) {
+          toggleBtn.textContent = st.expanded ? 'Hide Details' : 'View Details';
+        }
+
+        const slotEl = cardEl.querySelector('.card-dynamic-slot');
+        if (!slotEl) return;
+
+        if (!st.expanded) {
+          slotEl.innerHTML = '';
+          return;
+        }
+
+        let tabBodyHTML = '';
+        if (st.tab === 'customize') {
+          const sizeButtons = Object.keys(meta.sizes)
+            .map(
+              (sz) =>
+                `<button type="button" class="option-pill ${st.size === sz ? 'selected' : ''}" data-action="select-size" data-size="${sz}">${sz}</button>`
+            )
+            .join('');
+          const milkButtons = meta.milks
+            .map(
+              (mk) =>
+                `<button type="button" class="option-pill ${st.milk === mk ? 'selected' : ''}" data-action="select-milk" data-milk="${mk}">${mk}</button>`
+            )
+            .join('');
+          tabBodyHTML = `
+            <div class="card-details-pane">
+              <div class="option-group">
+                <span class="option-group-label">Select Size</span>
+                <div class="pill-row">${sizeButtons}</div>
+              </div>
+              <div class="option-group">
+                <span class="option-group-label">Preparation / Milk</span>
+                <div class="pill-row">${milkButtons}</div>
+              </div>
+            </div>
+          `;
+        } else if (st.tab === 'tasting') {
+          tabBodyHTML = `
+            <div class="card-details-pane">
+              <div class="tasting-grid">
+                <div class="tasting-stat">
+                  <span>Roast Profile</span>
+                  <strong>${meta.roast}</strong>
+                </div>
+                <div class="tasting-stat">
+                  <span>Origin</span>
+                  <strong>${meta.origin}</strong>
+                </div>
+              </div>
+              <div class="tasting-stat">
+                <span>Flavor Notes</span>
+                <strong>${meta.notes}</strong>
+              </div>
+            </div>
+          `;
+        } else {
+          tabBodyHTML = `
+            <div class="card-details-pane">
+              <div class="tasting-grid">
+                <div class="tasting-stat">
+                  <span>Caffeine</span>
+                  <strong>${meta.nutrition.caffeine}</strong>
+                </div>
+                <div class="tasting-stat">
+                  <span>Calories (${st.size})</span>
+                  <strong>${metrics.cal} kcal</strong>
+                </div>
+                <div class="tasting-stat">
+                  <span>Total Sugar</span>
+                  <strong>${meta.nutrition.sugar}</strong>
+                </div>
+                <div class="tasting-stat">
+                  <span>Protein</span>
+                  <strong>${meta.nutrition.protein}</strong>
+                </div>
+              </div>
+            </div>
+          `;
+        }
+
+        slotEl.innerHTML = `
+          <div class="card-tabs" role="tablist">
+            <button type="button" class="card-tab ${st.tab === 'customize' ? 'active' : ''}" data-action="switch-tab" data-tab="customize">Customize</button>
+            <button type="button" class="card-tab ${st.tab === 'tasting' ? 'active' : ''}" data-action="switch-tab" data-tab="tasting">Tasting Notes</button>
+            <button type="button" class="card-tab ${st.tab === 'nutrition' ? 'active' : ''}" data-action="switch-tab" data-tab="nutrition">Nutrition</button>
+          </div>
+          ${tabBodyHTML}
+        `;
+      }
+
+      // Attach scoped transition handlers to each card independently
+      document.querySelectorAll('.card[data-card-id]').forEach((cardEl) => {
+        const cardId = cardEl.getAttribute('data-card-id');
+
+        cardEl.addEventListener('click', (event) => {
+          const actionEl = event.target.closest('[data-action]');
+          if (!actionEl) return;
+
+          event.preventDefault();
+          recordInteraction();
+
+          const action = actionEl.getAttribute('data-action');
+          const st = cardStates[cardId];
+
+          if (action === 'toggle-card') {
+            // Animate ONLY this card subtree via cardEl.startViewTransition()
+            cardEl.startViewTransition(() => {
+              st.expanded = !st.expanded;
+              renderCardDOM(cardEl, cardId);
+            });
+          } else if (action === 'switch-tab') {
+            const nextTab = actionEl.getAttribute('data-tab');
+            if (nextTab && st.tab !== nextTab) {
+              cardEl.startViewTransition(() => {
+                st.tab = nextTab;
+                renderCardDOM(cardEl, cardId);
+              });
+            }
+          } else if (action === 'select-size') {
+            const nextSize = actionEl.getAttribute('data-size');
+            if (nextSize && st.size !== nextSize) {
+              cardEl.startViewTransition(() => {
+                st.size = nextSize;
+                renderCardDOM(cardEl, cardId);
+              });
+            }
+          } else if (action === 'select-milk') {
+            const nextMilk = actionEl.getAttribute('data-milk');
+            if (nextMilk && st.milk !== nextMilk) {
+              cardEl.startViewTransition(() => {
+                st.milk = nextMilk;
+                renderCardDOM(cardEl, cardId);
+              });
+            }
+          } else if (action === 'quick-add') {
+            const metrics = computeCardMetrics(cardId);
+            updateBagUI(parseFloat(metrics.price));
+            cardEl.startViewTransition(() => {
+              st.addedCount += 1;
+              actionEl.textContent = `Added (${st.addedCount})`;
+            });
+          }
+        });
+      });
+
+      /* ========================================================================
+         3. Component Group 2: Scoped Roastery Menu List (#brew-list-panel)
+         ======================================================================== */
+      const ROASTERY_ITEMS = [
+        {
+          id: 'honey-cortado',
+          name: 'Wildflower Honey Cortado',
+          category: 'espresso',
+          price: 4.65,
+          caffeine: 150,
+          summary: 'Equal parts ristretto espresso and velvety steamed milk with raw local honey.',
+          origin: 'Costa Rica Tarrazú'
+        },
+        {
+          id: 'nitro-vanilla',
+          name: 'Nitro Sweet Cream Draft',
+          category: 'cold',
+          price: 5.45,
+          caffeine: 225,
+          summary: 'Nitrogen-infused cold brew cascading under house-made Madagascar vanilla cream.',
+          origin: 'Ethiopia Sidamo'
+        },
+        {
+          id: 'gesha-pourover',
+          name: 'Panama Boquete Gesha V60',
+          category: 'pour-over',
+          price: 6.50,
+          caffeine: 135,
+          summary: 'Hand-poured to order with jasmine aromatics, bergamot, and white peach clarity.',
+          origin: 'Boquete Highlands'
+        },
+        {
+          id: 'cardamom-latte',
+          name: 'Spiced Cardamom Rose Latte',
+          category: 'espresso',
+          price: 5.60,
+          caffeine: 150,
+          summary: 'Freshly ground green cardamom pods infused with double espresso and micro-foam.',
+          origin: 'Guatemala Huehuetenango'
+        },
+        {
+          id: 'kyoto-drip',
+          name: 'Kyoto Slow-Tower Ice Drip',
+          category: 'cold',
+          price: 5.95,
+          caffeine: 195,
+          summary: 'Single-drop ice extraction over 12 hours yielding wine-like floral complexity.',
+          origin: 'Kenya Nyeri AA'
+        }
+      ];
+
+      const listState = {
+        filter: 'all',
+        sortIndex: 0, // 0: Featured, 1: Price Low-High, 2: Caffeine High-Low
+        expandedItemId: 'honey-cortado'
+      };
+      const SORT_MODES = ['Featured', 'Price ↑', 'Caffeine ↓'];
+
+      const brewListPanel = document.getElementById('brew-list-panel');
+      const brewListEl = document.getElementById('brew-list');
+      const sortListBtn = document.getElementById('sort-list-btn');
+      const sortModeLabel = document.getElementById('sort-mode-label');
+
+      function renderBrewListDOM() {
+        if (!brewListEl) return;
+        let items = ROASTERY_ITEMS.filter(
+          (item) => listState.filter === 'all' || item.category === listState.filter
+        );
+
+        if (listState.sortIndex === 1) {
+          items = items.slice().sort((a, b) => a.price - b.price);
+        } else if (listState.sortIndex === 2) {
+          items = items.slice().sort((a, b) => b.caffeine - a.caffeine);
+        }
+
+        if (sortModeLabel) {
+          sortModeLabel.textContent = SORT_MODES[listState.sortIndex];
+        }
+
+        document.querySelectorAll('#brew-list-panel .filter-chip').forEach((chip) => {
+          chip.classList.toggle('active', chip.getAttribute('data-filter') === listState.filter);
+        });
+
+        brewListEl.innerHTML = items
+          .map((item) => {
+            const isExpanded = listState.expandedItemId === item.id;
+            const vtName = 'brew-item-' + item.id;
+            return `
+              <li class="brew-item" data-item-id="${item.id}" data-vt-name="${vtName}" style="view-transition-name: ${vtName};">
+                <div class="brew-item-main">
+                  <div>
+                    <div class="brew-item-title">${item.name}</div>
+                    <div class="brew-item-meta">${item.origin} • ${item.caffeine}mg caffeine</div>
+                  </div>
+                  <div class="brew-item-right">
+                    <span class="price-tag">$${item.price.toFixed(2)}</span>
+                    <button type="button" class="btn btn-secondary" data-list-action="toggle-item" data-item-id="${item.id}" style="padding: 5px 10px; font-size: 0.78rem;">
+                      ${isExpanded ? 'Less' : 'Notes'}
+                    </button>
+                  </div>
+                </div>
+                ${
+                  isExpanded
+                    ? `<div class="brew-item-drawer">
+                        <span>${item.summary}</span>
+                        <button type="button" class="btn" data-list-action="order-item" data-price="${item.price}" style="padding: 5px 12px; font-size: 0.78rem;">Add to Order</button>
+                      </div>`
+                    : ''
+                }
+              </li>
+            `;
+          })
+          .join('');
+      }
+
+      renderBrewListDOM();
+
+      if (brewListPanel) {
+        brewListPanel.addEventListener('click', (event) => {
+          const filterBtn = event.target.closest('.filter-chip[data-filter]');
+          if (filterBtn) {
+            recordInteraction();
+            const nextFilter = filterBtn.getAttribute('data-filter');
+            if (nextFilter && nextFilter !== listState.filter) {
+              brewListPanel.startViewTransition(() => {
+                listState.filter = nextFilter;
+                renderBrewListDOM();
+              });
+            }
+            return;
+          }
+
+          const actionBtn = event.target.closest('[data-list-action]');
+          if (actionBtn) {
+            recordInteraction();
+            const listAction = actionBtn.getAttribute('data-list-action');
+            if (listAction === 'toggle-item') {
+              const itemId = actionBtn.getAttribute('data-item-id');
+              brewListPanel.startViewTransition(() => {
+                listState.expandedItemId = listState.expandedItemId === itemId ? null : itemId;
+                renderBrewListDOM();
+              });
+            } else if (listAction === 'order-item') {
+              const price = parseFloat(actionBtn.getAttribute('data-price') || '5.00');
+              updateBagUI(price);
+              brewListPanel.startViewTransition(() => {
+                actionBtn.textContent = 'Added ✓';
+              });
+            }
+          }
+        });
+      }
+
+      if (sortListBtn && brewListPanel) {
+        sortListBtn.addEventListener('click', () => {
+          recordInteraction();
+          brewListPanel.startViewTransition(() => {
+            listState.sortIndex = (listState.sortIndex + 1) % SORT_MODES.length;
+            renderBrewListDOM();
+          });
+        });
+      }
+
+      /* ========================================================================
+         4. Component Group 3: Scoped Live Brew & Rewards Panel (#rewards-panel)
+         ======================================================================== */
+      const BREW_STAGES = [
+        {
+          step: 1,
+          title: 'Stage 1: Weighing Single-Origin Beans',
+          detail: 'Barista Maya is dosing 18.5g of freshly roasted Ethiopian & Vermont Reserve beans.',
+          eta: 'Est. 3 mins remaining'
+        },
+        {
+          step: 2,
+          title: 'Stage 2: Precision Burr Grinding',
+          detail: 'Dialed in for a silky 28-second extraction with rich caramel crema.',
+          eta: 'Est. 2 mins remaining'
+        },
+        {
+          step: 3,
+          title: 'Stage 3: Pulling Espresso & Steaming Oat Milk',
+          detail: 'Velvety micro-foam steamed to 145°F and poured over double ristretto.',
+          eta: 'Est. 1 min remaining'
+        },
+        {
+          step: 4,
+          title: 'Stage 4: Ready at Pickup Counter!',
+          detail: 'Your handcrafted beverage is waiting at the Artisanal Pickup Bar.',
+          eta: 'Complete • Enjoy warm!'
+        }
+      ];
+
+      const panelState = {
+        stageIndex: 0,
+        beansPoints: 140
+      };
+
+      const rewardsPanel = document.getElementById('rewards-panel');
+      const statusPanelBody = document.getElementById('status-panel-body');
+      const rewardsBadgeEl = document.getElementById('rewards-points-badge');
+
+      function renderStatusPanelDOM() {
+        if (!statusPanelBody) return;
+        const currentStage = BREW_STAGES[panelState.stageIndex];
+        if (rewardsBadgeEl) {
+          rewardsBadgeEl.textContent = panelState.beansPoints + ' Beans';
+        }
+
+        const progressBars = BREW_STAGES.map((st, idx) => {
+          let cls = 'stage-step';
+          if (idx < panelState.stageIndex) cls += ' completed';
+          else if (idx === panelState.stageIndex) cls += ' current';
+          return `<div class="${cls}" data-vt-name="stage-bar-${idx}" style="view-transition-name: stage-bar-${idx};"></div>`;
+        }).join('');
+
+        const nextRewardPct = Math.min(100, Math.round(((panelState.beansPoints % 200) / 200) * 100));
+
+        statusPanelBody.innerHTML = `
+          <div class="stage-progress">${progressBars}</div>
+          <div class="stage-card" data-vt-name="stage-active-card" style="view-transition-name: stage-active-card;">
+            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
+              <h4>${currentStage.title}</h4>
+              <span style="font-size:0.76rem; font-weight:700; color:var(--primary-light);">${currentStage.eta}</span>
+            </div>
+            <p>${currentStage.detail}</p>
+          </div>
+          <div style="font-size:0.82rem; color:var(--text-muted); margin-bottom:12px;">
+            <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
+              <span>Free Artisan Drink Progress</span>
+              <strong>${nextRewardPct}% (${panelState.beansPoints} total beans)</strong>
+            </div>
+            <div style="height:7px; background:var(--secondary); border-radius:999px; overflow:hidden;">
+              <div data-vt-name="reward-meter-fill" style="view-transition-name: reward-meter-fill; width:${nextRewardPct}%; height:100%; background:var(--success);"></div>
+            </div>
+          </div>
+        `;
+      }
+
+      renderStatusPanelDOM();
+
+      const advanceBrewBtn = document.getElementById('advance-brew-btn');
+      const redeemRewardBtn = document.getElementById('redeem-reward-btn');
+
+      if (advanceBrewBtn && rewardsPanel) {
+        advanceBrewBtn.addEventListener('click', () => {
+          recordInteraction();
+          rewardsPanel.startViewTransition(() => {
+            panelState.stageIndex = (panelState.stageIndex + 1) % BREW_STAGES.length;
+            renderStatusPanelDOM();
+          });
+        });
+      }
+
+      if (redeemRewardBtn && rewardsPanel) {
+        redeemRewardBtn.addEventListener('click', () => {
+          recordInteraction();
+          rewardsPanel.startViewTransition(() => {
+            panelState.beansPoints += 25;
+            renderStatusPanelDOM();
+          });
+        });
+      }
+
+      /* ========================================================================
+         5. Concurrent Multi-Component Wave & Always-Interactive Controls
+         ======================================================================== */
+      const speedSelect = document.getElementById('vt-speed-select');
+      if (speedSelect) {
+        speedSelect.addEventListener('change', () => {
+          recordInteraction();
+          document.documentElement.style.setProperty('--vt-duration', speedSelect.value);
+        });
+      }
+
+      function triggerConcurrentTransitionsWave() {
+        recordInteraction();
+        const cards = Array.from(document.querySelectorAll('.card[data-card-id]'));
+
+        // Fire staggered overlapping transitions on each independent card, list, and panel
+        cards.forEach((cardEl, idx) => {
+          const cardId = cardEl.getAttribute('data-card-id');
+          setTimeout(() => {
+            cardEl.startViewTransition(() => {
+              const st = cardStates[cardId];
+              st.expanded = !st.expanded;
+              renderCardDOM(cardEl, cardId);
+            });
+          }, idx * 90);
+        });
+
+        if (brewListPanel) {
+          setTimeout(() => {
+            brewListPanel.startViewTransition(() => {
+              listState.sortIndex = (listState.sortIndex + 1) % SORT_MODES.length;
+              renderBrewListDOM();
+            });
+          }, 120);
+        }
+
+        if (rewardsPanel) {
+          setTimeout(() => {
+            rewardsPanel.startViewTransition(() => {
+              panelState.stageIndex = (panelState.stageIndex + 1) % BREW_STAGES.length;
+              panelState.beansPoints += 25;
+              renderStatusPanelDOM();
+            });
+          }, 180);
+        }
+      }
+
+      const triggerAllBtn = document.getElementById('trigger-all-btn');
+      const heroConcurrentBtn = document.getElementById('hero-concurrent-btn');
+      if (triggerAllBtn) triggerAllBtn.addEventListener('click', triggerConcurrentTransitionsWave);
+      if (heroConcurrentBtn) heroConcurrentBtn.addEventListener('click', triggerConcurrentTransitionsWave);
+
+      const navBagBtn = document.getElementById('nav-bag-btn');
+      if (navBagBtn) {
+        navBagBtn.addEventListener('click', () => {
+          recordInteraction();
+          updateBagUI(4.75);
+        });
+      }
+
+      const pingInteractiveBtn = document.getElementById('ping-interactive-btn');
+      const liveNoteMirror = document.getElementById('live-note-mirror');
+      if (pingInteractiveBtn) {
+        pingInteractiveBtn.addEventListener('click', () => {
+          recordInteraction();
+          if (liveNoteMirror) {
+            liveNoteMirror.textContent = 'Clicked #' + interactionCounter;
+          }
+        });
+      }
+
+      const noteInput = document.getElementById('barista-note-input');
+      if (noteInput) {
+        noteInput.addEventListener('input', () => {
+          recordInteraction();
+          if (liveNoteMirror) {
+            liveNoteMirror.textContent = noteInput.value ? 'Note: ' + noteInput.value : 'Ready';
+          }
+        });
+      }
+    })();
+  </script>
