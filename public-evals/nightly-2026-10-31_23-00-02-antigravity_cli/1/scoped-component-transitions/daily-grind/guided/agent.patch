+  <script>
+    // Feature detect specifically on Element.prototype (not document.startViewTransition)
+    const supportsScopedTransition = 'startViewTransition' in Element.prototype;
+
+    /**
+     * Trigger a transition scoped to a single component subtree.
+     * Falls back to running the DOM update immediately without blocking the page or obscuring fixed/popover elements.
+     */
+    function runScopedTransition(scopeEl, updateDOM) {
+      if (!supportsScopedTransition) {
+        updateDOM();
+        return;
+      }
+
+      // MANDATORY: Call startViewTransition on the component element, not document
+      const transition = scopeEl.startViewTransition(() => {
+        updateDOM();
+      });
+
+      // Re-triggering startViewTransition() on the same element skips the active transition
+      // and rejects `ready`. Catch the rejection to avoid unhandled promise rejection errors.
+      transition.ready.catch(() => {});
+    }
+
+    /**
+     * Reorder items by moving existing DOM nodes (required for `view-transition-name: match-element`).
+     * Scoped to `listEl` since only the list order changes, keeping controls outside `listEl` interactive.
+     */
+    function reorderItems(listEl, orderedIds) {
+      const existing = new Map(
+        Array.from(listEl.children, (li) => [li.dataset.id, li]),
+      );
+
+      runScopedTransition(listEl, () => {
+        for (const id of orderedIds) {
+          const li = existing.get(id);
+          if (li) listEl.appendChild(li);
+        }
+      });
+    }
+
+    /**
+     * Move a single item up (or wrap to bottom if already first) by moving the existing DOM node.
+     */
+    function moveItemUp(listEl, itemEl) {
+      const prev = itemEl.previousElementSibling;
+      runScopedTransition(listEl, () => {
+        if (prev) {
+          listEl.insertBefore(itemEl, prev);
+        } else {
+          listEl.appendChild(itemEl);
+        }
+      });
+    }
+
+    /**
+     * Remove an item while preserving exit animation and keyboard focus.
+     * Scoped to the outer `cardEl` so the card itself also transitions its height change.
+     */
+    function removeItem(cardEl, itemEl) {
+      const hadFocus = itemEl.contains(document.activeElement);
+      const nextFocusTarget =
+        itemEl.nextElementSibling?.querySelector('.remove-btn, button') ??
+        itemEl.previousElementSibling?.querySelector('.remove-btn, button') ??
+        cardEl.querySelector('button');
+
+      runScopedTransition(cardEl, () => {
+        itemEl.remove();
+        if (hadFocus) {
+          nextFocusTarget?.focus();
+        }
+      });
+    }
+
+    const extraAddonsPool = [
+      { name: 'Toasted Hazelnut Shot', meta: '30 kcal • Syrup', calories: 30 },
+      { name: 'Whipped Oat Cloud', meta: '65 kcal • Topping', calories: 65 },
+      { name: 'Raw Agave Nectar', meta: '40 kcal • Sweetener', calories: 40 },
+      { name: 'Cardamom Infused Dust', meta: '5 kcal • Spice', calories: 5 },
+      { name: 'Single-Origin Espresso Shot', meta: '10 kcal • Boost', calories: 10 },
+      { name: 'Cacao Nib Crunch', meta: '25 kcal • Texture', calories: 25 },
+    ];
+    let addonCounter = 100;
+
+    /**
+     * Add a new customization item inside the card.
+     * Scoped to `cardEl` so both the list and card height animate smoothly.
+     */
+    function addAddonItem(cardEl, listEl) {
+      const template = extraAddonsPool[addonCounter % extraAddonsPool.length];
+      const id = `custom-${++addonCounter}`;
+
+      const li = document.createElement('li');
+      li.dataset.id = id;
+      li.dataset.calories = String(template.calories);
+
+      const info = document.createElement('div');
+      info.className = 'addon-info';
+
+      const nameSpan = document.createElement('span');
+      nameSpan.className = 'addon-name';
+      nameSpan.textContent = template.name;
+
+      const metaSpan = document.createElement('span');
+      metaSpan.className = 'addon-meta';
+      metaSpan.textContent = template.meta;
+
+      info.append(nameSpan, metaSpan);
+
+      const actions = document.createElement('div');
+      actions.className = 'addon-actions';
+
+      const upBtn = document.createElement('button');
+      upBtn.type = 'button';
+      upBtn.className = 'icon-btn';
+      upBtn.dataset.action = 'move-up';
+      upBtn.setAttribute('aria-label', `Move ${template.name} up`);
+      upBtn.textContent = '↑';
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.className = 'icon-btn remove-btn';
+      removeBtn.dataset.action = 'remove-addon';
+      removeBtn.setAttribute('aria-label', `Remove ${template.name}`);
+      removeBtn.textContent = '✕';
+
+      actions.append(upBtn, removeBtn);
