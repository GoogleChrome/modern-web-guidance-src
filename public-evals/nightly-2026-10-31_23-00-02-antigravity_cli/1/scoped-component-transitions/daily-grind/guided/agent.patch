+        listEl.appendChild(li);
+      });
+    }
+
+    /**
+     * Toggle the tasting notes panel inside a card.
+     * Scoped to `cardEl` so the card morphs its own geometry while other cards remain interactive.
+     */
+    function toggleDetails(cardEl, toggleBtn) {
+      const detailsEl = cardEl.querySelector('.card-details');
+      if (!detailsEl) return;
+
+      runScopedTransition(cardEl, () => {
+        const isHidden = detailsEl.hasAttribute('hidden');
+        if (isHidden) {
+          detailsEl.removeAttribute('hidden');
+          toggleBtn.setAttribute('aria-expanded', 'true');
+        } else {
+          detailsEl.setAttribute('hidden', '');
+          toggleBtn.setAttribute('aria-expanded', 'false');
+        }
+      });
+    }
+
+    // Delegate interactions inside the cards grid
+    const cardsGrid = document.getElementById('cards-grid');
+    cardsGrid.addEventListener('click', (event) => {
+      const btn = event.target.closest('button[data-action]');
+      if (!btn) return;
+
+      const action = btn.dataset.action;
+      const cardEl = btn.closest('.card');
+      if (!cardEl) return;
+
+      const listEl = cardEl.querySelector('.addon-list');
+
+      if (action === 'sort-addons' && listEl) {
+        const items = Array.from(listEl.children);
+        const currentDir = listEl.dataset.sortDir === 'asc' ? 'desc' : 'asc';
+        listEl.dataset.sortDir = currentDir;
+
+        const orderedIds = items
+          .sort((a, b) => {
+            const nameA = a.querySelector('.addon-name')?.textContent.trim() ?? '';
+            const nameB = b.querySelector('.addon-name')?.textContent.trim() ?? '';
+            return currentDir === 'asc'
+              ? nameA.localeCompare(nameB)
+              : nameB.localeCompare(nameA);
+          })
+          .map((li) => li.dataset.id);
+
+        reorderItems(listEl, orderedIds);
+      } else if (action === 'add-addon' && listEl) {
+        addAddonItem(cardEl, listEl);
+      } else if (action === 'toggle-details') {
+        toggleDetails(cardEl, btn);
+      } else if (action === 'move-up' && listEl) {
+        const itemEl = btn.closest('li');
+        if (itemEl) moveItemUp(listEl, itemEl);
+      } else if (action === 'remove-addon') {
+        const itemEl = btn.closest('li');
+        if (itemEl) removeItem(cardEl, itemEl);
+      }
+    });
+
+    // Outer transition on the grid wrapper: moves `.card-wrapper` elements while inner `.card` scopes stay isolated
+    document.getElementById('shuffle-cards-btn')?.addEventListener('click', () => {
+      const wrappers = Array.from(cardsGrid.children);
+      if (wrappers.length < 2) return;
+
+      runScopedTransition(cardsGrid, () => {
+        // Rotate card wrappers
+        cardsGrid.appendChild(wrappers[0]);
+      });
+    });
+
+    // Trigger concurrent transitions across all individual cards simultaneously
+    document.getElementById('animate-all-btn')?.addEventListener('click', () => {
+      const cards = cardsGrid.querySelectorAll('.card');
+      cards.forEach((cardEl) => {
+        const listEl = cardEl.querySelector('.addon-list');
+        if (!listEl) return;
+        const ids = Array.from(listEl.children, (li) => li.dataset.id).reverse();
+        reorderItems(listEl, ids);
+      });
+    });
