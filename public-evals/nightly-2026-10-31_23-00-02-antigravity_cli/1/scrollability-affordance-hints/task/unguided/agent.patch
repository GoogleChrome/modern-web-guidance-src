+  <script>
+    (function () {
+      const scrollContainer = document.getElementById('reviews-list');
+      const indicatorTop = document.querySelector('.indicator-top');
+      const indicatorBottom = document.querySelector('.indicator-bottom');
+
+      if (!scrollContainer || !indicatorTop || !indicatorBottom) return;
+
+      function updateScrollIndicators() {
+        const scrollTop = scrollContainer.scrollTop;
+        const maxScrollTop = scrollContainer.scrollHeight - scrollContainer.clientHeight;
+
+        const showTop = scrollTop > 0;
+        const showBottom = maxScrollTop - scrollTop > 1;
+
+        indicatorTop.classList.toggle('visible', showTop);
+        indicatorBottom.classList.toggle('visible', showBottom);
+      }
+
+      scrollContainer.addEventListener('scroll', updateScrollIndicators, { passive: true });
+      window.addEventListener('resize', updateScrollIndicators);
+      window.addEventListener('load', updateScrollIndicators);
+      updateScrollIndicators();
+    })();
+  </script>
+
