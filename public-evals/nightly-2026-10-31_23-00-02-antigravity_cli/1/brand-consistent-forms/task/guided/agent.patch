+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const roastSlider = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-level-output');
+      const progressBar = document.getElementById('setup-progress');
+      const progressText = document.getElementById('progress-text');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const statusMsg = document.getElementById('subscription-status');
+
+      function getRoastLabel(val) {
+        const num = Number(val);
+        if (num < 25) return `Light Roast (${num}%)`;
+        if (num < 45) return `Medium-Light Roast (${num}%)`;
+        if (num <= 60) return `Medium Roast (${num}%)`;
+        if (num <= 80) return `Medium-Dark Roast (${num}%)`;
+        return `Dark Roast (${num}%)`;
+      }
+
+      function updateSliderProgress(val) {
+        roastSlider.style.setProperty('--progress', `${val}%`);
+        if (roastOutput) {
+          roastOutput.textContent = getRoastLabel(val);
+        }
+      }
+
+      function updateCompletionProgress() {
+        let completedSteps = 0;
+        const totalSteps = 3;
+
+        const selectedFrequency = form.querySelector('input[name="delivery_frequency"]:checked');
+        if (selectedFrequency) completedSteps += 1;
+        if (roastSlider && roastSlider.value !== '') completedSteps += 1;
+        if (emailCheckbox && emailCheckbox.checked) completedSteps += 1;
+
+        const percentage = Math.round((completedSteps / totalSteps) * 100);
+        progressBar.value = percentage;
+        progressBar.textContent = `${percentage}%`;
+        if (progressText) {
+          progressText.textContent = `${percentage}%`;
+        }
+      }
+
+      if (roastSlider) {
+        updateSliderProgress(roastSlider.value);
+        roastSlider.addEventListener('input', (e) => {
+          updateSliderProgress(e.target.value);
+          updateCompletionProgress();
+        });
+      }
+
+      form.addEventListener('change', updateCompletionProgress);
+      updateCompletionProgress();
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (statusMsg) {
+          statusMsg.textContent = 'Your personalized coffee subscription preferences have been saved!';
+        }
+      });
+    })();
+  </script>
