+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const progress = document.getElementById('subscription-progress');
+      const progressText = document.getElementById('progress-value-text');
+      const roastSlider = document.getElementById('roast-preference');
+      const roastDisplay = document.getElementById('roast-level-display');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const statusMsg = document.getElementById('subscription-status');
+
+      const roastNames = {
+        1: 'Light Roast (1 / 5)',
+        2: 'Medium-Light Roast (2 / 5)',
+        3: 'Medium Roast (3 / 5)',
+        4: 'Medium-Dark Roast (4 / 5)',
+        5: 'Dark Roast (5 / 5)'
+      };
+
+      function updateSubscriptionState() {
+        const selectedFrequency = form.querySelector('input[name="deliveryFrequency"]:checked');
+        const hasRoast = Boolean(roastSlider && roastSlider.value);
+        const hasEmailsChecked = Boolean(emailCheckbox && emailCheckbox.checked);
+
+        if (roastSlider && roastDisplay) {
+          roastDisplay.textContent = roastNames[roastSlider.value] || ('Level ' + roastSlider.value + ' / 5');
+        }
+
+        let completedSteps = 0;
+        const totalSteps = 3;
+        if (selectedFrequency) completedSteps += 1;
+        if (hasRoast) completedSteps += 1;
+        if (hasEmailsChecked) completedSteps += 1;
+
+        const percent = Math.round((completedSteps / totalSteps) * 100);
+        if (progress) {
+          progress.value = percent;
+          progress.textContent = percent + '%';
+        }
+        if (progressText) {
+          progressText.textContent = percent + '% Complete';
+        }
+      }
+
+      if (form) {
+        form.addEventListener('input', updateSubscriptionState);
+        form.addEventListener('change', updateSubscriptionState);
+        form.addEventListener('submit', function (event) {
+          event.preventDefault();
+          if (progress) {
+            progress.value = 100;
+            progress.textContent = '100%';
+          }
+          if (progressText) {
+            progressText.textContent = '100% Complete';
+          }
+          if (statusMsg) {
+            statusMsg.textContent = 'Your personalized coffee subscription is ready!';
+          }
+        });
+        updateSubscriptionState();
+      }
+    })();
+  </script>
