+    /* Roast Selector */
+    .roast-selector-group {
+      margin-top: 1.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.5rem;
+    }
+
+    .roast-selector-group label {
+      font-weight: 600;
+      font-size: 0.95rem;
+      letter-spacing: 0.5px;
+      color: var(--light);
+    }
+
+    /* Enable customization for the select and its picker */
+    .roast-select,
+    .roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    /* Style the visible trigger button */
+    .roast-select {
+      font-family: inherit;
+      background-color: var(--primary);
+      color: var(--accent);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      padding: 0.75rem 1rem;
+      font-size: 1rem;
+      min-height: 48px;
+      min-width: 220px;
+      cursor: pointer;
+    }
+
+    .roast-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Style the dropdown options list */
+    .roast-select::picker(select) {
+      font-family: inherit;
+      background-color: var(--primary);
+      color: var(--accent);
+      border: 2px solid var(--accent);
+      border-radius: 5px;
+      padding: 0.5rem;
+    }
+
+    /* Customize internal part colors to match palette */
+    .roast-select::picker-icon {
+      color: var(--accent);
+    }
+
+    .roast-select option::checkmark {
+      color: var(--accent);
+    }
+
+    /* Style individual options and hover effects */
+    .roast-select option {
+      padding: 0.6rem 0.75rem;
+      border-radius: 4px;
+      background-color: var(--primary);
+      color: var(--accent);
+      cursor: pointer;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      background-color: var(--accent);
+      color: var(--primary);
+    }
+
+    .roast-select option:hover::checkmark,
+    .roast-select option:focus-visible::checkmark {
+      color: var(--primary);
+    }
+
