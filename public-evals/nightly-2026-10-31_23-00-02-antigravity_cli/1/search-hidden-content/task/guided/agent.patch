+  <script>
+    const couponBtn = document.getElementById('reveal-coupon-btn');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function markCouponRevealed() {
+      couponBtn.setAttribute('aria-expanded', 'true');
+      couponBtn.setAttribute('aria-disabled', 'true');
+      couponBtn.disabled = true;
+      couponBtn.textContent = 'Coupon Revealed';
+    }
+
+    // Reveal coupon panel permanently when button is clicked
+    couponBtn.addEventListener('click', () => {
+      if (couponPanel.hasAttribute('hidden')) {
+        couponPanel.removeAttribute('hidden');
+      }
+      markCouponRevealed();
+    });
+
+    // Synchronize button state when browser Find-in-Page reveals the coupon panel
+    couponPanel.addEventListener('beforematch', () => {
+      markCouponRevealed();
+    });
+
+    // Fallback for browsers that do not support hidden="until-found"
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      document.querySelectorAll('[hidden="until-found"]').forEach((el) => {
+        el.removeAttribute('hidden');
+        if (el.id === 'coupon-panel') {
+          markCouponRevealed();
+        }
+      });
+    }
+  </script>
