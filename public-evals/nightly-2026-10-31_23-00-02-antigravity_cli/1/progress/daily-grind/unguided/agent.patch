+  <script>
+    (function () {
+      const buttons = document.querySelectorAll('.progress-btn');
+      const track = document.getElementById('interactive-progress-track');
+      const fill = document.getElementById('interactive-progress-fill');
+      const nativeProgress = document.getElementById('interactive-native-progress');
+      const label = document.getElementById('reward-progress-label');
+      const badge = document.getElementById('reward-progress-badge');
+
+      buttons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          buttons.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+
+          const state = btn.getAttribute('data-state');
+          if (state === 'indeterminate') {
+            track.classList.remove('determinate');
+            track.classList.add('indeterminate');
+            track.removeAttribute('aria-valuenow');
+            track.setAttribute('aria-busy', 'true');
+            nativeProgress.removeAttribute('value');
+            label.textContent = 'Reward & Order Sync: Calculating Bean Rewards & Brewing Status...';
+            badge.textContent = 'Processing (Indeterminate)';
+            badge.className = 'progress-badge indeterminate-badge';
+          } else {
+            const val = parseInt(btn.getAttribute('data-value') || '75', 10);
+            const beans = Math.round((val / 100) * 200);
+            track.classList.remove('indeterminate');
+            track.classList.add('determinate');
+            track.setAttribute('aria-valuenow', String(val));
+            track.removeAttribute('aria-busy');
+            fill.style.width = val + '%';
+            nativeProgress.setAttribute('value', String(val));
+            label.textContent =
+              val === 100
+                ? 'Reward Process Complete: 200 / 200 Beans — Free Artisanal Drink Unlocked!'
+                : 'Reward Process Completion: ' + beans + ' / 200 Beans to Next Free Drink';
+            badge.textContent = val + '% Complete (Determinate)';
+            badge.className = 'progress-badge determinate-badge';
+          }
+        });
+      });
+    })();
+  </script>
+
