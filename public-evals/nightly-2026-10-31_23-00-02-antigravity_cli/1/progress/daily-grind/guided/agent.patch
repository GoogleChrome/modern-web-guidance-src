+  <script>
+    const orderProgress = document.getElementById('order-progress');
+    const orderProgressText = document.getElementById('order-progress-text');
+    const rewardSyncProgress = document.getElementById('reward-sync-progress');
+    const rewardSyncText = document.getElementById('reward-sync-text');
+    const completionStatus = document.getElementById('completion-status');
+
+    document.querySelectorAll('.progress-controls button').forEach((button) => {
+      button.addEventListener('click', () => {
+        if (button.dataset.progressState === 'indeterminate') {
+          orderProgress.removeAttribute('value');
+          orderProgressText.textContent = 'Connecting to barista station...';
+          completionStatus.textContent = '';
+          return;
+        }
+
+        const nextValue = Number(button.dataset.progressValue);
+        orderProgress.value = nextValue;
+        orderProgressText.textContent = button.dataset.progressLabel;
+
+        if (nextValue === 100) {
+          rewardSyncProgress.value = 100;
+          rewardSyncText.textContent = '100 / 100 Beans — Free Drink Reward Unlocked!';
+          completionStatus.textContent = 'Your order is ready for pickup and your free drink reward is now available.';
+        } else {
+          rewardSyncProgress.removeAttribute('value');
+          rewardSyncText.textContent = 'Verifying bonus beans from latest order';
+          completionStatus.textContent = '';
+        }
+      });
+    });
