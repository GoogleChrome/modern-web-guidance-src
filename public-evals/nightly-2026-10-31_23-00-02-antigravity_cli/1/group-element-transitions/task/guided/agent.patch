+      {
+        id: 'bean-colombia-supremo',
+        name: 'Colombian Supremo',
+        origin: 'Colombia',
+        roast: 'Medium Roast',
+        notes: 'Rich caramel sweetness, toasted walnut, and balanced citrus.',
+        price: '$17.00',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-sumatra-mandheling',
+        name: 'Sumatra Mandheling',
+        origin: 'Indonesia',
+        roast: 'Dark Roast',
+        notes: 'Full-bodied dark chocolate, cedar spice, and velvety earthiness.',
+        price: '$18.50',
+        image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-guatemala-antigua',
+        name: 'Guatemala Antigua',
+        origin: 'Guatemala',
+        roast: 'Medium Roast',
+        notes: 'Velvety cocoa, brown sugar, and subtle green apple acidity.',
+        price: '$18.00',
+        image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-kenya-aa',
+        name: 'Kenya AA Nyeri',
+        origin: 'Kenya',
+        roast: 'Light-Med',
+        notes: 'Juicy blackcurrant, ruby grapefruit, and crisp wine-like body.',
+        price: '$21.00',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-brazil-cerrado',
+        name: 'Brazil Cerrado',
+        origin: 'Brazil',
+        roast: 'Medium-Dark',
+        notes: 'Creamy roasted hazelnut, milk chocolate, and low acidity.',
+        price: '$16.50',
+        image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80'
+      }
+    ];
+
+    const DEFAULT_SELECTED_IDS = [
+      'bean-ethiopia-yirgacheffe',
+      'bean-colombia-supremo',
+      'bean-sumatra-mandheling',
+      'bean-guatemala-antigua'
+    ];
+
+    let selectedIds = [...DEFAULT_SELECTED_IDS];
+
+    const beanListEl = document.getElementById('bean-list');
+    const beanPickerEl = document.getElementById('bean-picker');
+    const addBeanBtn = document.getElementById('add-bean-btn');
+    const resetBeansBtn = document.getElementById('reset-beans-btn');
+    const beanCountEl = document.getElementById('bean-count');
+    const beanEmptyEl = document.getElementById('bean-empty');
+
+    function renderBeans() {
+      const selectedBeans = selectedIds
+        .map((id) => ALL_BEANS.find((bean) => bean.id === id))
+        .filter(Boolean);
+
+      const availableBeans = ALL_BEANS.filter((bean) => !selectedIds.includes(bean.id));
+
+      beanListEl.innerHTML = '';
+      selectedBeans.forEach((bean) => {
+        const li = document.createElement('li');
+        li.className = 'bean-card';
+        li.style.viewTransitionName = bean.id;
+        li.dataset.beanId = bean.id;
+
+        li.innerHTML = `
+          <img src="${bean.image}" alt="${bean.name} coffee beans" loading="lazy">
+          <div class="bean-card-body">
+            <div class="bean-meta">
+              <span>${bean.origin}</span>
+              <span class="bean-roast">${bean.roast}</span>
+            </div>
+            <h3>${bean.name}</h3>
+            <p class="bean-notes">${bean.notes}</p>
+            <div class="bean-card-footer">
+              <span class="bean-price">${bean.price}</span>
+              <button type="button" class="btn-remove" data-remove-id="${bean.id}" aria-label="Remove ${bean.name}">
+                Remove
+              </button>
+            </div>
+          </div>
+        `;
+        beanListEl.appendChild(li);
+      });
+
+      beanEmptyEl.hidden = selectedBeans.length > 0;
+      beanCountEl.textContent = `${selectedBeans.length} of ${ALL_BEANS.length} roasts selected`;
+
+      beanPickerEl.innerHTML = '';
+      if (availableBeans.length === 0) {
+        const option = document.createElement('option');
+        option.value = '';
+        option.textContent = 'All roasts added';
+        beanPickerEl.appendChild(option);
+        beanPickerEl.disabled = true;
+        addBeanBtn.disabled = true;
+      } else {
+        availableBeans.forEach((bean) => {
+          const option = document.createElement('option');
+          option.value = bean.id;
+          option.textContent = `${bean.name} (${bean.roast}) — ${bean.price}`;
+          beanPickerEl.appendChild(option);
+        });
+        beanPickerEl.disabled = false;
+        addBeanBtn.disabled = false;
+      }
+    }
+
+    function updateBeanSelection(mutateState) {
+      if (document.startViewTransition) {
+        document.startViewTransition(() => {
+          mutateState();
+          renderBeans();
+        });
+      } else {
+        mutateState();
+        renderBeans();
+      }
+    }
+
+    addBeanBtn.addEventListener('click', () => {
+      const idToAdd = beanPickerEl.value;
+      if (!idToAdd || selectedIds.includes(idToAdd)) return;
+      updateBeanSelection(() => {
+        selectedIds.push(idToAdd);
+      });
+    });
+
+    resetBeansBtn.addEventListener('click', () => {
+      updateBeanSelection(() => {
+        selectedIds = [...DEFAULT_SELECTED_IDS];
+      });
+    });
+
+    beanListEl.addEventListener('click', (event) => {
+      const removeBtn = event.target.closest('[data-remove-id]');
+      if (!removeBtn) return;
+      const idToRemove = removeBtn.getAttribute('data-remove-id');
+      updateBeanSelection(() => {
+        selectedIds = selectedIds.filter((id) => id !== idToRemove);
+      });
+    });
+
+    renderBeans();
+  </script>
+
