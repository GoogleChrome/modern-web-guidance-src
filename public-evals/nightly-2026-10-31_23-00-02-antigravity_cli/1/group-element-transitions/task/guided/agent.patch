+  <script>
+    const ALL_BEANS = [
+      {
+        id: 'bean-ethiopia-yirgacheffe',
+        name: 'Ethiopian Yirgacheffe',
+        origin: 'Ethiopia',
+        roast: 'Light Roast',
+        notes: 'Bright bergamot, jasmine blossom, and sweet peach finish.',
