+  <script>
+    const BEAN_CATALOG = {
+      'ethiopian-yirgacheffe': {
+        name: 'Ethiopian Yirgacheffe',
+        roast: 'Light Roast',
+        notes: 'Floral jasmine, bright bergamot, and sweet peach.',
+        price: '$19.50',
+        image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+      },
+      'colombian-supremo': {
+        name: 'Colombian Supremo',
+        roast: 'Medium Roast',
+        notes: 'Rich caramel, toasted walnut, and balanced citrus.',
+        price: '$17.00',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+      },
+      'sumatra-mandheling': {
+        name: 'Sumatra Mandheling',
+        roast: 'Dark Roast',
+        notes: 'Full-bodied dark chocolate, cedar spice, and earthy finish.',
+        price: '$18.50',
+        image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80'
+      },
+      'guatemala-antigua': {
+        name: 'Guatemala Antigua',
+        roast: 'Medium-Dark',
+        notes: 'Velvety cocoa, brown sugar, and subtle warm spice.',
+        price: '$18.00',
+        image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80'
+      },
+      'kenya-aa': {
+        name: 'Kenya AA',
+        roast: 'Light Roast',
+        notes: 'Juicy blackcurrant, ruby grapefruit, and crisp acidity.',
+        price: '$21.00',
+        image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+      },
+      'costa-rica-tarrazu': {
+        name: 'Costa Rica Tarrazú',
+        roast: 'Honey Process',
+        notes: 'Golden honey, crisp green apple, and silky almond.',
+        price: '$19.00',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+      }
+    };
+
+    let nextBeanId = 1;
+    let selectedBeans = [
+      { id: nextBeanId++, key: 'ethiopian-yirgacheffe' },
+      { id: nextBeanId++, key: 'colombian-supremo' },
+      { id: nextBeanId++, key: 'sumatra-mandheling' },
+      { id: nextBeanId++, key: 'guatemala-antigua' }
+    ];
+
+    const beansGrid = document.getElementById('beans-grid');
+    const catalogSelect = document.getElementById('bean-catalog-select');
+    const addBeanBtn = document.getElementById('add-bean-btn');
+    const addRandomBtn = document.getElementById('add-random-bean-btn');
+
+    function updateWithViewTransition(mutateDom) {
+      if (document.startViewTransition) {
+        document.startViewTransition(() => {
+          mutateDom();
+        });
+      } else {
+        mutateDom();
+      }
+    }
+
+    function createBeanCardElement(item) {
+      const data = BEAN_CATALOG[item.key];
+      const card = document.createElement('article');
+      card.className = 'bean-card';
+      card.dataset.beanId = String(item.id);
+      card.style.viewTransitionName = `bean-card-${item.id}`;
+      card.style.viewTransitionClass = 'bean-item';
+
+      card.innerHTML = `
+        <img src="${data.image}" alt="${data.name}" loading="lazy">
+        <div class="bean-card-body">
+          <div>
+            <span class="bean-badge">${data.roast}</span>
+            <h3>${data.name}</h3>
+            <p>${data.notes}</p>
+          </div>
+          <div class="bean-card-footer">
+            <span class="bean-price">${data.price}</span>
+            <button type="button" class="btn-remove" data-remove-id="${item.id}" aria-label="Remove ${data.name}">Remove</button>
+          </div>
+        </div>
+      `;
+      return card;
+    }
+
+    function renderBeans() {
+      beansGrid.innerHTML = '';
+      if (selectedBeans.length === 0) {
+        const empty = document.createElement('div');
+        empty.className = 'empty-state';
+        empty.textContent = 'Your tasting box is empty. Select a coffee bean above to get started!';
+        beansGrid.appendChild(empty);
+        return;
+      }
+
+      for (const item of selectedBeans) {
+        beansGrid.appendChild(createBeanCardElement(item));
+      }
+    }
+
+    function addBean(key) {
+      const newItem = { id: nextBeanId++, key };
+      updateWithViewTransition(() => {
+        selectedBeans.push(newItem);
+        const emptyEl = beansGrid.querySelector('.empty-state');
+        if (emptyEl) {
+          emptyEl.remove();
+        }
+        beansGrid.appendChild(createBeanCardElement(newItem));
+      });
+    }
+
+    function removeBean(id) {
+      updateWithViewTransition(() => {
+        selectedBeans = selectedBeans.filter(item => item.id !== id);
+        const cardEl = beansGrid.querySelector(`[data-bean-id="${id}"]`);
+        if (cardEl) {
+          cardEl.remove();
+        }
+        if (selectedBeans.length === 0) {
+          renderBeans();
+        }
+      });
+    }
+
+    addBeanBtn.addEventListener('click', () => {
+      addBean(catalogSelect.value);
+    });
+
+    addRandomBtn.addEventListener('click', () => {
+      const keys = Object.keys(BEAN_CATALOG);
+      const randomKey = keys[Math.floor(Math.random() * keys.length)];
+      catalogSelect.value = randomKey;
+      addBean(randomKey);
+    });
+
+    beansGrid.addEventListener('click', (event) => {
+      const removeBtn = event.target.closest('[data-remove-id]');
+      if (removeBtn) {
+        const id = Number(removeBtn.dataset.removeId);
+        removeBean(id);
+      }
+    });
+
+    renderBeans();
+  </script>
