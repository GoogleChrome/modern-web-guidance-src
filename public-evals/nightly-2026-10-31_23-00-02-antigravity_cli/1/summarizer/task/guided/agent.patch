+  <script>
+    (async () => {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const statusEl = document.getElementById('summarize-status');
+      const summaryContainer = document.getElementById('journal-summary');
+      const summaryList = document.getElementById('summary-list');
+      const articleEl = document.getElementById('journal-article');
+
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'medium',
+      };
+
+      function showStatus(message) {
+        statusEl.textContent = message;
+        statusEl.hidden = false;
+      }
+
+      function disableWithFallback(message) {
+        summarizeBtn.disabled = true;
+        showStatus(message);
+      }
+
+      if (!('Summarizer' in self)) {
+        disableWithFallback('Local summarization is currently unsupported in this browser.');
+        return;
+      }
+
+      let availability;
+      try {
+        availability = await Summarizer.availability(options);
+      } catch (err) {
+        disableWithFallback('Local summarization is currently unavailable in this browser.');
+        return;
+      }
+
+      if (availability === 'unavailable') {
+        disableWithFallback('Local summarization is currently unavailable on this device.');
+        return;
+      }
+
+      let summarizerInstance = null;
+
+      summarizeBtn.addEventListener('click', async () => {
+        summarizeBtn.disabled = true;
+
+        try {
+          const currentAvailability = await Summarizer.availability(options);
+          if (currentAvailability === 'unavailable') {
+            disableWithFallback('Local summarization is currently unavailable on this device.');
+            return;
+          }
+
+          if (!summarizerInstance) {
+            if (currentAvailability === 'downloadable' || currentAvailability === 'downloading') {
+              showStatus('Downloading on-device AI model (0%)...');
+            } else {
+              showStatus('Initializing on-device AI summarizer...');
+            }
+
+            summarizerInstance = await Summarizer.create({
+              ...options,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const percent = e.total
+                    ? Math.round((e.loaded / e.total) * 100)
+                    : Math.round(e.loaded * 100);
+                  console.log(`Downloaded ${percent}%`);
+                  showStatus(`Downloading on-device AI model (${percent}%)...`);
+                });
+              },
+            });
+          }
+
+          showStatus('Summarizing article...');
+
+          const longText = articleEl.innerText;
+          const summary = await summarizerInstance.summarize(longText, {
+            context: 'This article from a specialty coffee roaster explains their ethical direct-trade bean sourcing, harvesting, processing, and quality control process.',
+          });
+
+          const points = summary
+            .split(/\r?\n/)
+            .map((line) => line.replace(/^[\s*\-•\d.)]+/, '').trim())
+            .filter(Boolean);
+
+          summaryList.replaceChildren();
+          for (const point of points) {
+            const li = document.createElement('li');
+            li.textContent = point;
+            summaryList.appendChild(li);
+          }
+
+          summaryContainer.hidden = false;
+          statusEl.hidden = true;
+          summarizeBtn.textContent = 'Summarize Again';
+          summarizeBtn.disabled = false;
+        } catch (error) {
+          console.error('Summarization failed:', error);
+          showStatus('Unable to generate summary using the browser AI model.');
+          summarizeBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
