+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const journalTextEl = document.getElementById('journal-text');
+    const summaryContainer = document.getElementById('journal-summary');
+    const summaryOutput = document.getElementById('summary-output');
+
+    function renderBulletPoints(rawText) {
+      summaryOutput.innerHTML = '';
+      const lines = rawText
+        .split(/\r?\n/)
+        .map(line => line.replace(/^[\s*\-•+\d.)]+/, '').trim())
+        .filter(Boolean);
+
+      const ul = document.createElement('ul');
+      for (const item of lines) {
+        const li = document.createElement('li');
+        li.textContent = item;
+        ul.appendChild(li);
+      }
+      summaryOutput.appendChild(ul);
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      const sourceText = journalTextEl.innerText.trim();
+      summarizeBtn.disabled = true;
+      const originalLabel = summarizeBtn.textContent;
+      summarizeBtn.textContent = 'Summarizing...';
+      summaryContainer.classList.add('visible');
+      summaryOutput.textContent = 'Generating summary with browser AI...';
+
+      let summarizer;
+      try {
+        const SummarizerFactory =
+          window.Summarizer ||
+          (window.ai && window.ai.summarizer);
+
+        if (!SummarizerFactory) {
+          throw new Error('Built-in Summarizer API is not available in this browser.');
+        }
+
+        if (typeof SummarizerFactory.availability === 'function') {
+          const availability = await SummarizerFactory.availability();
+          if (availability === 'unavailable') {
+            throw new Error('Summarizer API is unavailable on this device.');
+          }
+        } else if (typeof SummarizerFactory.capabilities === 'function') {
+          const capabilities = await SummarizerFactory.capabilities();
+          if (capabilities && capabilities.available === 'no') {
+            throw new Error('Summarizer API is not supported on this device.');
+          }
+        }
+
+        const options = {
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'An article from a coffee roaster journal explaining their ethical bean sourcing, harvesting, processing, and roasting process.'
+        };
+
+        summarizer = await SummarizerFactory.create(options);
+        const result = await summarizer.summarize(sourceText);
+        renderBulletPoints(result);
+      } catch (error) {
+        summaryOutput.textContent = error.message || 'Unable to generate summary using browser AI.';
+      } finally {
+        if (summarizer && typeof summarizer.destroy === 'function') {
+          summarizer.destroy();
+        }
+        summarizeBtn.disabled = false;
+        summarizeBtn.textContent = originalLabel;
+      }
+    });
+  </script>
+
 </body>
 
