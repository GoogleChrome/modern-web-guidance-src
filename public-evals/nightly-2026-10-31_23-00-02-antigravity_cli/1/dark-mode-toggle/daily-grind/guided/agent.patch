+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggleBtn = document.getElementById('theme-toggle');
+
+      function getSystemScheme() {
+        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+      }
+
+      function getStoredScheme() {
+        try {
+          return localStorage.getItem('color-scheme');
+        } catch {
+          return meta.content === 'light' || meta.content === 'dark' ? meta.content : null;
+        }
+      }
+
+      toggleBtn.addEventListener('click', () => {
+        const systemScheme = getSystemScheme();
+        const currentScheme = getStoredScheme() ?? systemScheme;
+        const targetScheme = currentScheme === 'dark' ? 'light' : 'dark';
+
+        if (targetScheme !== systemScheme) {
+          try {
+            localStorage.setItem('color-scheme', targetScheme);
+          } catch {}
+          meta.content = targetScheme;
+        } else {
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch {}
+          meta.content = 'light dark';
+        }
+      });
+
+      window.addEventListener('storage', (event) => {
+        if (event.key === 'color-scheme') {
+          meta.content = event.newValue ?? 'light dark';
+        }
+      });
+    })();
+  </script>
