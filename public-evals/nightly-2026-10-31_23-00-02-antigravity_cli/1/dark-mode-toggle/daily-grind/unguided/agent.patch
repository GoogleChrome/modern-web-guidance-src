+  <script>
+    (function () {
+      const root = document.documentElement;
+      const body = document.body;
+      const toggleBtn = document.getElementById('theme-toggle');
+      const iconEl = toggleBtn.querySelector('.theme-icon');
+      const textEl = toggleBtn.querySelector('.theme-text');
+      const darkMediaQuery = window.matchMedia ? window.matchMedia('(prefers-color-scheme: dark)') : null;
+
+      function getSavedTheme() {
+        try {
+          const saved = localStorage.getItem('theme');
+          return saved === 'dark' || saved === 'light' ? saved : null;
+        } catch (e) {
+          return null;
+        }
+      }
+
+      function saveTheme(theme) {
+        try {
+          localStorage.setItem('theme', theme);
+        } catch (e) {
+          // Ignore storage errors
+        }
+      }
+
+      function getSystemTheme() {
+        return darkMediaQuery && darkMediaQuery.matches ? 'dark' : 'light';
+      }
+
+      function getActiveTheme() {
+        const explicit = root.getAttribute('data-theme') || body.getAttribute('data-theme');
+        if (explicit === 'dark' || explicit === 'light') {
+          return explicit;
+        }
+        return getSavedTheme() || getSystemTheme();
+      }
+
+      function updateButtonUI(theme) {
+        const isDark = theme === 'dark';
+        toggleBtn.setAttribute('aria-pressed', String(isDark));
+        toggleBtn.setAttribute(
+          'aria-label',
+          isDark ? 'Switch to light mode' : 'Switch to dark mode'
+        );
+        iconEl.textContent = isDark ? '☀️' : '🌙';
+        textEl.textContent = isDark ? 'Light Mode' : 'Dark Mode';
+      }
+
+      function setExplicitTheme(theme) {
+        const isDark = theme === 'dark';
+        root.setAttribute('data-theme', theme);
+        body.setAttribute('data-theme', theme);
+
+        root.classList.toggle('dark-mode', isDark);
+        root.classList.toggle('dark', isDark);
+        root.classList.toggle('light-mode', !isDark);
+        root.classList.toggle('light', !isDark);
+
+        body.classList.toggle('dark-mode', isDark);
+        body.classList.toggle('dark', isDark);
+        body.classList.toggle('light-mode', !isDark);
+        body.classList.toggle('light', !isDark);
+
+        updateButtonUI(theme);
+      }
+
+      const savedTheme = getSavedTheme();
+      if (savedTheme) {
+        setExplicitTheme(savedTheme);
+      } else {
+        updateButtonUI(getSystemTheme());
+      }
+
+      if (darkMediaQuery && typeof darkMediaQuery.addEventListener === 'function') {
+        darkMediaQuery.addEventListener('change', function (e) {
+          if (!root.hasAttribute('data-theme') && !getSavedTheme()) {
+            updateButtonUI(e.matches ? 'dark' : 'light');
+          }
+        });
+      }
+
+      toggleBtn.addEventListener('click', function () {
+        const currentTheme = getActiveTheme();
+        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
+        setExplicitTheme(nextTheme);
+        saveTheme(nextTheme);
+      });
+    })();
+  </script>
