+  <script>
+    const seasonalPanel = document.querySelector('.seasonal-panel');
+    const tocLinks = document.querySelectorAll('.toc-sidebar a');
+    const drinkHeaders = document.querySelectorAll('.drink-section h3');
+
+    function setSelectedDrink(id) {
+      if (!id) return;
+      tocLinks.forEach((link) => {
+        const isActive = link.getAttribute('href') === `#${id}`;
+        link.classList.toggle('target-current', isActive);
+        link.classList.toggle('active', isActive);
+        if (isActive) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    // Smoothly scroll the panel when clicking any TOC link
+    tocLinks.forEach((link) => {
+      link.addEventListener('click', (event) => {
+        const href = link.getAttribute('href');
+        if (!href || !href.startsWith('#')) return;
+        const targetId = href.slice(1);
+        const targetHeader = document.getElementById(targetId);
+        if (targetHeader && seasonalPanel) {
+          event.preventDefault();
+          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          const scrollMarginTop = parseFloat(getComputedStyle(targetHeader).scrollMarginTop) || 0;
+          const targetTop =
+            seasonalPanel.scrollTop +
+            (targetHeader.getBoundingClientRect().top - seasonalPanel.getBoundingClientRect().top) -
+            scrollMarginTop;
+          seasonalPanel.scrollTo({
+            top: targetTop,
+            behavior: reduceMotion ? 'auto' : 'smooth',
+          });
+          setSelectedDrink(targetId);
+        }
+      });
+    });
+
+    // Synchronize active TOC link when a section header snaps into view
+    seasonalPanel.addEventListener('scrollsnapchange', (event) => {
+      const snappedHeader = event.snapTargetBlock;
+      if (snappedHeader) {
+        const id = snappedHeader.id || snappedHeader.querySelector('[id]')?.id || snappedHeader.closest('[id]')?.id;
+        setSelectedDrink(id);
+      }
+    });
+
+    // Fallback for browsers without scrollsnapchange support
+    if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+      const observer = new IntersectionObserver(
+        () => {
+          const panelTop = seasonalPanel.getBoundingClientRect().top;
+          const topEntry = [...drinkHeaders].reduce((currentTop, header) => {
+            const { bottom } = header.getBoundingClientRect();
+            if (bottom < panelTop) return currentTop;
+            if (!currentTop) return header;
+            return bottom < currentTop.getBoundingClientRect().bottom
+              ? header
+              : currentTop;
+          }, undefined);
+          if (topEntry) {
+            setSelectedDrink(topEntry.id);
+          }
+        },
+        { root: seasonalPanel, threshold: 0.9 }
+      );
+
+      drinkHeaders.forEach((header) => observer.observe(header));
+    }
+  </script>
