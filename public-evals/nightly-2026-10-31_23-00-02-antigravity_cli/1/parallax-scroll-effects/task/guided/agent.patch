+    /* Parallax Section */
+    .wrapper {
+      position: relative;
+      overflow: clip;
+      height: 100vh;
+      display: grid;
+      grid-template-areas: "stack";
+      place-items: center;
+      background-color: #261714;
+      color: var(--light);
+    }
+
+    .layer {
+      grid-area: stack;
+      width: 100%;
+      height: 100%;
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      padding: 20px;
+    }
+
+    .layer-bg {
+      padding: 0;
+    }
+
+    .layer-bg img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      opacity: 0.45;
+    }
+
+    .layer-mid {
+      justify-content: space-around;
+      max-width: 1100px;
+      pointer-events: none;
+    }
+
+    .parallax-photo {
+      width: 260px;
+      height: 340px;
+      object-fit: cover;
+      border-radius: 12px;
+      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
+      border: 2px solid rgba(255, 171, 64, 0.35);
+    }
+
+    .parallax-content {
+      max-width: 540px;
+      background: rgba(62, 39, 35, 0.88);
+      border: 1px solid rgba(255, 171, 64, 0.4);
+      border-radius: 12px;
+      padding: 40px 32px;
+      text-align: center;
+      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
+    }
+
+    .parallax-content h2 {
+      font-size: 2.25rem;
+      margin-bottom: 1rem;
+      color: var(--accent);
+    }
+
+    .parallax-content p {
+      font-size: 1.05rem;
+      color: var(--secondary);
+    }
+
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @keyframes parallax {
+        from {
+          transform: translateY(700px);
+        }
+      }
+
+      .wrapper {
+        view-timeline: --wrapper;
+      }
+
+      .layer {
+        animation: parallax linear both;
+        animation-timeline: --wrapper;
+        animation-range: entry 25% exit calc(100% / sibling-count() * sibling-index());
+      }
+
+      @media (prefers-reduced-motion: reduce) {
+        .layer {
+          animation: none;
+        }
+      }
+    }
+
