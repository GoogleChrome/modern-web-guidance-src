+  <script nonce="__CSP_NONCE__">
+    const form = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    const submitBtn = document.getElementById('newsletter-submit');
+    const statusEl = document.getElementById('newsletter-status');
+
+    function setStatus(message, type) {
+      if (!statusEl) return;
+      if (!message) {
+        statusEl.textContent = '';
+        statusEl.removeAttribute('data-status');
+        return;
+      }
+      statusEl.dataset.status = type;
+      statusEl.textContent = message;
+    }
+
+    // Client-side helper that catches blocked outbound requests gracefully without unhandled rejections.
+    async function submitWithPolicyHandling(url, { statusElement, ...fetchOptions } = {}) {
+      try {
+        const response = await fetch(url, fetchOptions);
+        const contentType = response.headers.get('content-type') || '';
+        const payload = contentType.includes('application/json')
+          ? await response.json()
+          : { message: await response.text() };
+
+        if (!response.ok) {
+          throw new Error(payload.message || `HTTP ${response.status}`);
+        }
+
+        const successMessage =
+          payload.message || 'Success: Your email has been added to The Daily Grind newsletter.';
+        if (statusElement) {
+          statusElement.dataset.status = 'success';
+          statusElement.textContent = successMessage;
+        }
+        return { ok: true, payload, error: null };
+      } catch (error) {
+        const message = error instanceof Error ? error.message : String(error);
+        if (statusElement) {
+          statusElement.dataset.status = 'error';
+          statusElement.textContent = `Could not complete your request to ${url}: the request could not go through or was blocked by the outbound connection policy (${message}).`;
+        }
+        return { ok: false, payload: null, error };
+      }
+    }
+
+    window.submitWithPolicyHandling = submitWithPolicyHandling;
+
+    if (emailInput) {
+      emailInput.addEventListener('invalid', () => {
+        emailInput.setCustomValidity('Please enter a valid email address (for example, coffee@dailygrind.com).');
+      });
+
+      emailInput.addEventListener('input', () => {
+        emailInput.setCustomValidity('');
+        if (statusEl?.dataset.status === 'error') {
+          setStatus('', '');
+        }
+      });
+
+      emailInput.addEventListener('blur', () => {
+        if (emailInput.value && !emailInput.checkValidity()) {
+          setStatus(emailInput.validationMessage || 'Please enter a valid email address.', 'error');
+        }
+      });
+    }
+
+    if (form && emailInput && submitBtn) {
+      form.addEventListener('submit', async (event) => {
+        event.preventDefault();
+
+        emailInput.setCustomValidity('');
+        if (!form.checkValidity()) {
+          setStatus(emailInput.validationMessage || 'Please enter a valid email address.', 'error');
+          emailInput.focus();
+          return;
+        }
+
+        const actionUrl = form.getAttribute('action') || '/api/newsletter';
+        const email = emailInput.value.trim();
+
+        submitBtn.disabled = true;
+        try {
+          const result = await submitWithPolicyHandling(actionUrl, {
+            statusElement: statusEl,
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+              Accept: 'application/json',
+            },
+            body: JSON.stringify({ email }),
+          });
+
+          if (result.ok) {
+            form.reset();
+          }
+        } finally {
+          submitBtn.disabled = false;
+        }
+      });
+    }
+
+    // Listen for Content Security Policy violations (e.g., if an injected script attempts an unauthorized request)
+    document.addEventListener('securitypolicyviolation', (event) => {
+      const blockedTarget = event.blockedURI || event.violatedDirective;
+      setStatus(
+        `Blocked: A request to ${blockedTarget} could not go through because it violates the page's outbound security policy.`,
+        'error',
+      );
+    });
+  </script>
+
