@@ -0,0 +1,191 @@
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+
+const CSP_HEADER =
+  "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://images.unsplash.com; connect-src 'self'; form-action 'self'";
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.jpeg': 'image/jpeg',
+  '.svg': 'image/svg+xml',
+  '.ico': 'image/x-icon',
+};
+
+const subscribers = [];
+
+function getPort() {
+  const args = process.argv.slice(2);
+  for (let i = 0; i < args.length; i++) {
+    if ((args[i] === '--port' || args[i] === '-p') && args[i + 1]) {
+      const parsed = Number(args[i + 1]);
+      if (!Number.isNaN(parsed) && parsed > 0) return parsed;
+    }
+    if (args[i].startsWith('--port=')) {
+      const parsed = Number(args[i].split('=')[1]);
+      if (!Number.isNaN(parsed) && parsed > 0) return parsed;
+    }
+  }
+  return Number(process.env.PORT) || 11222;
+}
+
+function sendJson(res, statusCode, payload) {
+  const body = JSON.stringify(payload);
+  res.writeHead(statusCode, {
+    'Content-Type': 'application/json; charset=utf-8',
+    'Content-Security-Policy': CSP_HEADER,
+    'Content-Length': Buffer.byteLength(body),
+  });
+  res.end(body);
+}
+
+function parseEmailFromBody(rawBody, contentType) {
+  const trimmed = (rawBody || '').trim();
+  if (!trimmed) return '';
+
+  if (contentType.includes('application/json') || trimmed.startsWith('{')) {
+    try {
+      const parsed = JSON.parse(trimmed);
+      if (parsed && typeof parsed.email === 'string') {
+        return parsed.email.trim();
+      }
+    } catch {
+      // fall through
+    }
+  }
+
+  if (
+    contentType.includes('application/x-www-form-urlencoded') ||
+    trimmed.includes('=')
+  ) {
+    const params = new URLSearchParams(trimmed);
+    const email = params.get('email');
+    if (email) return email.trim();
+  }
+
+  return trimmed;
+}
+
+const NEWSLETTER_PATHS = new Set([
+  '/newsletter',
+  '/api/newsletter',
+  '/subscribe',
+  '/api/subscribe',
+  '/signup',
+  '/api/signup',
+]);
+
+const server = http.createServer((req, res) => {
+  res.setHeader('Content-Security-Policy', CSP_HEADER);
+
+  const reqUrl = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+  const pathname = reqUrl.pathname;
+
+  if (req.method === 'POST' && (NEWSLETTER_PATHS.has(pathname) || pathname === '/')) {
+    let body = '';
+    req.on('data', (chunk) => {
+      body += chunk.toString();
+    });
+    req.on('end', () => {
+      const contentType = (req.headers['content-type'] || '').toLowerCase();
+      const email = parseEmailFromBody(body, contentType);
+
+      if (!email || !email.includes('@')) {
+        sendJson(res, 400, {
+          ok: false,
+          error: "Error: Invalid email address; your request can't go through.",
+        });
+        return;
+      }
+
+      subscribers.push(email);
+      sendJson(res, 200, {
+        ok: true,
+        email,
+        subscribers,
+        message: 'Success! Thank you for subscribing to our newsletter.',
+      });
+    });
+    return;
+  }
+
+  if (
+    req.method === 'GET' &&
+    (NEWSLETTER_PATHS.has(pathname) || pathname === '/subscribers')
+  ) {
+    sendJson(res, 200, { ok: true, subscribers });
+    return;
+  }
+
+  if (req.method === 'GET' || req.method === 'HEAD') {
+    const relativePath = pathname === '/' ? 'index.html' : pathname.replace(/^\/+/, '');
+    const safePath = path.normalize(relativePath).replace(/^(\.\.(\/|\\|$))+/, '');
+    const filePath = path.join(__dirname, safePath);
+
+    if (!filePath.startsWith(__dirname)) {
+      res.writeHead(403, {
+        'Content-Type': 'text/plain; charset=utf-8',
+        'Content-Security-Policy': CSP_HEADER,
+      });
+      res.end('Forbidden');
+      return;
+    }
+
+    fs.stat(filePath, (statErr, stats) => {
+      if (statErr || !stats.isFile()) {
+        res.writeHead(404, {
+          'Content-Type': 'text/plain; charset=utf-8',
+          'Content-Security-Policy': CSP_HEADER,
+        });
+        res.end('Not Found');
+        return;
+      }
+
+      const ext = path.extname(filePath).toLowerCase();
+      const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+
+      fs.readFile(filePath, (readErr, data) => {
+        if (readErr) {
+          res.writeHead(500, {
+            'Content-Type': 'text/plain; charset=utf-8',
+            'Content-Security-Policy': CSP_HEADER,
+          });
+          res.end('Internal Server Error');
+          return;
+        }
+
+        res.writeHead(200, {
+          'Content-Type': contentType,
+          'Content-Security-Policy': CSP_HEADER,
+          'Content-Length': data.length,
+        });
+        if (req.method === 'HEAD') {
+          res.end();
+        } else {
+          res.end(data);
+        }
+      });
+    });
+    return;
+  }
+
+  res.writeHead(405, {
+    'Content-Type': 'text/plain; charset=utf-8',
+    'Content-Security-Policy': CSP_HEADER,
+  });
+  res.end('Method Not Allowed');
+});
+
+if (require.main === module) {
+  const port = getPort();
+  server.listen(port, () => {
+    console.log(`Server listening on http://localhost:${port}`);
+  });
+}
+
+module.exports = { server, subscribers, CSP_HEADER };
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..0b5e4e9
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,225 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  list-style: none;
+}
+
+nav ul li {
+  margin-left: 20px;
+}
+
+nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+nav a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  border: none;
+  cursor: pointer;
+  font-size: 1rem;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+/* Newsletter Section */
+.newsletter-section {
+  background: white;
+  padding: 32px 24px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  margin-top: 40px;
+  text-align: center;
+}
+
+.newsletter-section h2 {
+  color: var(--primary);
+  margin-bottom: 8px;
+}
+
+.newsletter-section p {
+  margin-bottom: 20px;
+}
+
+.newsletter-form {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  align-items: center;
+  gap: 12px;
+  max-width: 520px;
+  margin: 0 auto;
+}
+
+.newsletter-form label {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  border: 0;
+}
+
+.newsletter-form input[type="email"] {
+  flex: 1 1 260px;
+  padding: 10px 14px;
+  border: 1px solid var(--secondary);
+  border-radius: 5px;
+  font-size: 1rem;
+  color: var(--text);
+}
+
+.newsletter-form .btn {
+  margin-top: 0;
+}
+
+.newsletter-message {
+  margin-top: 16px;
+  padding: 10px 16px;
+  border-radius: 5px;
+  font-weight: 500;
+}
+
+.newsletter-message.success {
+  background-color: #e8f5e9;
+  color: #1b5e20;
+  border: 1px solid #a5d6a7;
+}
+
+.newsletter-message.error {
+  background-color: #ffebee;
+  color: #b71c1c;
+  border: 1px solid #ef9a9a;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
