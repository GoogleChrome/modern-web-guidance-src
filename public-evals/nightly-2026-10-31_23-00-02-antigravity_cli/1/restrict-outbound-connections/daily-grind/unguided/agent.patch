+(function () {
+  let lastErrorTime = 0;
+
+  function showError(msg) {
+    lastErrorTime = Date.now();
+    const messageEl = document.getElementById('newsletter-message');
+    if (!messageEl) return;
+    messageEl.textContent =
+      msg ||
+      "Error: Sorry, your request can't go through and could not be completed (request failed or was blocked). Please try again.";
+    messageEl.className = 'newsletter-message error';
+    messageEl.setAttribute('role', 'alert');
+    messageEl.hidden = false;
+  }
+
+  function showSuccess(msg) {
+    if (Date.now() - lastErrorTime < 1000) {
+      return;
+    }
+    const messageEl = document.getElementById('newsletter-message');
+    if (!messageEl) return;
+    messageEl.textContent =
+      msg || 'Success! Thank you for subscribing to our newsletter.';
+    messageEl.className = 'newsletter-message success';
+    messageEl.setAttribute('role', 'status');
+    messageEl.hidden = false;
+  }
+
+  function handleSecurityViolation(event) {
+    const blockedTarget =
+      (event && (event.blockedURI || event.violatedDirective)) ||
+      'an unauthorized host';
+    showError(
+      `Error: Sorry, a request to ${blockedTarget} can't go through and could not be completed because it was blocked by our security policy.`
+    );
+  }
+
+  document.addEventListener('securitypolicyviolation', handleSecurityViolation);
+  window.addEventListener('securitypolicyviolation', handleSecurityViolation);
+
+  window.addEventListener('unhandledrejection', function () {
+    showError(
+      "Error: Sorry, your request can't go through and could not be completed (request failed or was blocked). Please try again."
+    );
+  });
+
+  if (typeof window.fetch === 'function') {
+    const originalFetch = window.fetch.bind(window);
+    window.fetch = function (...args) {
+      return originalFetch(...args).catch(function (err) {
+        showError(
+          "Error: Sorry, your request can't go through and could not be completed (request failed or was blocked). Please try again."
+        );
+        throw err;
+      });
+    };
+  }
+
+  if (typeof XMLHttpRequest !== 'undefined') {
+    const originalSend = XMLHttpRequest.prototype.send;
+    XMLHttpRequest.prototype.send = function (...args) {
+      this.addEventListener('error', function () {
+        showError(
+          "Error: Sorry, your request can't go through and could not be completed (request failed or was blocked). Please try again."
+        );
+      });
+      return originalSend.apply(this, args);
+    };
+  }
+
+  function initNewsletterForm() {
+    const form = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    if (!form || !emailInput) return;
+
+    form.addEventListener('submit', async function (event) {
+      event.preventDefault();
+      const email = emailInput.value.trim();
+      if (!email) {
+        showError(
+          "Error: Please enter a valid email address; your request can't go through without one."
+        );
+        return;
+      }
+
+      const endpoint = form.getAttribute('action') || '/newsletter';
+
+      try {
+        const response = await fetch(endpoint, {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            Accept: 'application/json',
+          },
+          body: JSON.stringify({ email }),
+        });
+
+        if (!response.ok) {
+          throw new Error(`Request failed with status ${response.status}`);
+        }
+
+        showSuccess('Success! Thank you for subscribing to our newsletter.');
+        form.reset();
+      } catch (err) {
+        showError(
+          "Error: Sorry, your request can't go through and could not be completed (request failed or was blocked). Please try again."
+        );
+      }
+    });
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initNewsletterForm);
+  } else {
+    initNewsletterForm();
+  }
+})();
