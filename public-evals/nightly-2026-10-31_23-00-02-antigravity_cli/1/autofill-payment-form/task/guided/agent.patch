+      border-radius: 5px;
+      color: var(--text);
+      background-color: #fff;
+    }
+
+    @media (pointer: coarse) {
+      .form-group input {
+        min-height: 52px;
+      }
+    }
+
+    .form-group input:focus-visible {
+      outline: 3px solid var(--primary);
