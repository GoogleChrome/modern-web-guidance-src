+  <div id="info-popover" popover="auto" role="status">
+    <div class="popover-content">
+      <p>online ordering is currently offline</p>
+      <button type="button" id="close-popover-btn" class="popover-close" commandfor="info-popover" command="hide-popover" popovertarget="info-popover" popovertargetaction="hide" aria-label="Dismiss notification">Dismiss</button>
+    </div>
