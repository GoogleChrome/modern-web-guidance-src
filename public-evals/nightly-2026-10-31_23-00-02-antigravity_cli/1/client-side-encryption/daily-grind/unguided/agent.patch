+      els.decryptVerifyBtn.addEventListener('click', async () => {
+        await verifyCurrentEnvelope();
+      });
+
+      els.tamperTestBtn.addEventListener('click', async () => {
+        if (!state.currentEnvelope) return;
+        const ctBytes = base64ToBytes(state.currentEnvelope.ciphertextBase64);
+        if (ctBytes.length > 0) {
+          ctBytes[0] ^= 0xff; // Flip bits in ciphertext
+        }
+        state.currentEnvelope.ciphertextBase64 = bytesToBase64(ctBytes);
+        state.currentEnvelope.ciphertextHex = bytesToHex(ctBytes);
+        els.restoreEnvelopeBtn.hidden = false;
+
+        renderEnvelopeOutput(state.currentEnvelope, true);
+        await verifyCurrentEnvelope();
+      });
+
+      els.restoreEnvelopeBtn.addEventListener('click', async () => {
+        if (!state.originalEnvelopeBackup) return;
+        state.currentEnvelope = JSON.parse(JSON.stringify(state.originalEnvelopeBackup));
+        els.restoreEnvelopeBtn.hidden = true;
+        renderEnvelopeOutput(state.currentEnvelope, false);
+        await verifyCurrentEnvelope();
+      });
+
+      els.copyEnvelopeBtn.addEventListener('click', async () => {
+        if (!state.currentEnvelope) return;
+        const jsonStr = JSON.stringify(state.currentEnvelope, null, 2);
+        try {
+          if (navigator.clipboard && navigator.clipboard.writeText) {
+            await navigator.clipboard.writeText(jsonStr);
+          }
+          els.copyEnvelopeBtn.textContent = 'Copied Encrypted JSON!';
+          setTimeout(() => {
+            els.copyEnvelopeBtn.textContent = 'Copy Encrypted Envelope JSON';
+          }, 1800);
+        } catch (_) {}
+      });
+
+      // =========================================================================
+      // Expose Programmatic API on window.DailyGrindCrypto
+      // =========================================================================
+      const readyPromise = (async function initializeCryptoFeature() {
+        state.recipientKeys = await generateRecipientKeys();
+        const session = await establishSharedSecret('hybrid', state.recipientKeys);
+        state.activeSession = session;
+        updateAadPreview();
+        renderSessionTelemetry(session);
+
+        // Encrypt an initial demonstration envelope so the inspector & verifier are immediately active
+        const initialDemo = await encryptDeliveryNote({
+          note: 'Gate code #4821*, take elevator to 4th floor, leave Maple Oat Latte on mat by Apt 4B.',
+          orderId: 'DG-2026-8492',
+          accessType: 'gate-code',
+          accessCode: '#4821*',
+          mode: 'hybrid',
+          ttl: 'burn-after-delivery'
+        });
+        state.currentEnvelope = JSON.parse(JSON.stringify(initialDemo.envelope));
+        state.originalEnvelopeBackup = JSON.parse(JSON.stringify(initialDemo.envelope));
+        state.savedEnvelopes.push(initialDemo.envelope);
+
+        renderEnvelopeOutput(state.currentEnvelope, false);
+        await verifyCurrentEnvelope();
+        renderSavedQueue();
+        return state;
+      })();
+
+      window.DailyGrindCrypto = {
+        ready: readyPromise,
+        getState: () => state,
+        mlKem768: {
+          keygen: mlKemKeygen,
+          encapsulate: mlKemEncapsulate,
+          decapsulate: mlKemDecapsulate
+        },
+        generateRecipientKeys,
+        establishSharedSecret,
+        decapsulateSharedSecret,
+        encryptDeliveryNote,
+        decryptDeliveryNote,
+        setProtectionMode
+      };
+    })();
+  </script>
 </body>
 
