+          const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey(format, publicKey));
+          return {
+            suite: pqSupported ? 'MLKEM768-X25519+ChaCha20-Poly1305' : 'X25519+HKDF+AES-GCM',
+            keyPair: { publicKey, privateKey: storedPair.privateKey },
+            publicKeyBytes,
+            persisted: true,
+          };
+        }
+      }
