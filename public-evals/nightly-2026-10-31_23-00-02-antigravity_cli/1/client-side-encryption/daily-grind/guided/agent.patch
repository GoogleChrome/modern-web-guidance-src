+    const DB_NAME = 'daily-grind-crypto-store';
+    const STORE_NAME = 'kem-keys';
+    const KEY_RECORD_ID = 'recipient-kem-key';
+    const HKDF_INFO = new TextEncoder().encode('daily-grind-delivery-note-envelope-v1');
