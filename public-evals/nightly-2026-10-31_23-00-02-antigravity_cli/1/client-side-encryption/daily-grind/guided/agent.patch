+
+        capsuleIvSizeEl.textContent = `Capsule: ${capsuleBytes.byteLength} bytes | IV: ${iv.byteLength} bytes | Ciphertext+Tag: ${ciphertext.byteLength} bytes`;
+        envelopeDisplayEl.textContent = JSON.stringify(
+          {
+            suite: activeEnvelope.suite,
+            mode: activeEnvelope.mode,
+            orderId: activeEnvelope.orderId,
+            capsule: activeEnvelope.capsuleBase64,
+            iv: activeEnvelope.ivBase64,
+            ciphertext: activeEnvelope.ciphertextBase64,
+          },
+          null,
+          2,
+        );
+
+        decryptBtn.disabled = false;
+        tamperBtn.disabled = false;
+        decryptedContainer.hidden = true;
+        setBanner(
+          senderStatus,
+          'success',
+          `Encrypted with ${sharedKey.algorithm.name} (12-byte IV) and encapsulated via ${recipientState.keyPair.privateKey.algorithm.name}.`,
+        );
+        recipientStatus.className = 'status-banner';
+      } catch (err) {
+        setBanner(senderStatus, 'error', `Encryption error: ${err.message}`);
+      }
+    }
+
+    async function handleDecryptNote() {
+      if (!recipientState || !activeEnvelope) return;
+
+      try {
+        const capsuleBytes = fromBase64(activeEnvelope.capsuleBase64);
+        const ivBytes = fromBase64(activeEnvelope.ivBase64);
+        const ciphertextBytes = fromBase64(activeEnvelope.ciphertextBase64);
+        const aadBytes = fromBase64(activeEnvelope.aadBase64);
+
+        const recipientKey = await decapsulateEnvelopeKey(
+          recipientState.keyPair.privateKey,
+          capsuleBytes,
+          HKDF_INFO,
+          activeEnvelope.mode,
+        );
+
+        const plaintext = await decryptMessage(
+          recipientKey,
+          ivBytes,
+          ciphertextBytes,
+          aadBytes,
+        );
+
+        decryptedTextEl.textContent = plaintext;
+        decryptedContainer.hidden = false;
+        setBanner(
+          recipientStatus,
+          'success',
+          `Decapsulated shared key and verified AEAD authentication tag for Order ${activeEnvelope.orderId}.`,
+        );
+      } catch (err) {
+        decryptedContainer.hidden = true;
+        setBanner(
+          recipientStatus,
+          'error',
+          `Decryption rejected (${err.name || 'OperationError'}): Authentication tag or associated data verification failed.`,
+        );
+      }
+    }
+
+    function handleTamperEnvelope() {
+      if (!activeEnvelope) return;
+      const ct = fromBase64(activeEnvelope.ciphertextBase64);
+      ct[ct.byteLength - 1] ^= 0xff;
+      activeEnvelope.ciphertextBase64 = toBase64(ct);
+      activeEnvelope.tampered = true;
+      envelopeDisplayEl.textContent = JSON.stringify(
+        {
+          suite: activeEnvelope.suite,
+          mode: activeEnvelope.mode,
+          orderId: activeEnvelope.orderId,
+          capsule: activeEnvelope.capsuleBase64,
+          iv: activeEnvelope.ivBase64,
+          ciphertext: activeEnvelope.ciphertextBase64,
+          tampered: true,
+        },
+        null,
+        2,
+      );
+      decryptedContainer.hidden = true;
+      setBanner(
+        recipientStatus,
+        'error',
+        'Simulated tampering on the ciphertext/Poly1305-GCM tag. Click "Decapsulate & Authenticate Note" to verify rejection.',
+      );
+    }
+
+    encryptForm.addEventListener('submit', handleEncryptNote);
+    decryptBtn.addEventListener('click', handleDecryptNote);
+    tamperBtn.addEventListener('click', handleTamperEnvelope);
+    rotateKeysBtn.addEventListener('click', async () => {
+      await initRecipient(true);
+      await handleEncryptNote();
+    });
+
+    // Initialize on load and encrypt default delivery note
+    await initRecipient(false);
+    await handleEncryptNote();
+  </script>
 </body>
 
