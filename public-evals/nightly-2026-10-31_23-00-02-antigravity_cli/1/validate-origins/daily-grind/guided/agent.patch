+    }
+
+    // Expose helpers on window for programmatic inspection if needed
+    Object.assign(window, {
+      isTrustedOrderingOrigin,
+      isAllowedSameSiteUrl,
+      classifyAndHardenLinks,
+      getValidatedRedirectUrl,
+      createSandboxedWidgetVerifier,
+      handleSandboxedWidgetMessage,
+    });
+  </script>
