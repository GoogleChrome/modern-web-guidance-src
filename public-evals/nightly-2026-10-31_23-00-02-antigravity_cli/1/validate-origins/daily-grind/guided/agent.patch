+      if (!rawRedirectUrl) return fallbackPath;
+      if (isAllowedSameSiteUrl(rawRedirectUrl, siteUrl)) {
+        return new URL(rawRedirectUrl).href;
+      }
+      return fallbackPath;
+    }
+
+    /**
+     * 3. Pin the opaque sender identity of a sandboxed iframe widget on initialization
