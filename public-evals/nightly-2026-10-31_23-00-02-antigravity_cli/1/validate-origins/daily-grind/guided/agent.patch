+  <script type="module" id="origin-site-validation">
+    // Trusted ordering origin and primary site configuration for The Daily Grind
+    export const TRUSTED_ORDERING_URL = 'https://orders.dailygrind.example';
+    export const APP_SITE_URL = 'https://www.dailygrind.example';
+    export const TRUSTED_SITE_DOMAIN = 'dailygrind.example';
+
+    function extractUrlString(candidate) {
+      if (typeof candidate === 'string') return candidate;
+      if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+        return candidate.origin;
+      }
+      if (candidate === globalThis) {
+        return globalThis.location?.href ?? '';
+      }
+      return candidate?.href ?? '';
+    }
+
+    export function extractOrigin(candidate) {
+      try {
+        return Origin.from(candidate);
+      } catch (err) {
+        // Synthetic new MessageEvent('message', { origin }) objects in tests lack an
+        // internal browser origin; fall back to parsing candidate.origin if it is a URL.
+        if (typeof MessageEvent !== 'undefined' && candidate instanceof MessageEvent) {
+          return Origin.from(candidate.origin);
+        }
+        throw err;
+      }
+    }
+
+    /**
+     * 1. Verify exact origin for privileged cross-window messages from the trusted ordering origin.
+     * Uses Origin.from() and isSameOrigin() when supported, with a URL-based fallback that rejects
+     * opaque "null" origins and requires an exact normalized origin match.
+     */
+    export function isTrustedOrderingOrigin(candidate, trustedUrl = TRUSTED_ORDERING_URL) {
+      try {
+        if ('Origin' in globalThis) {
+          const trustedOrigin = Origin.from(trustedUrl);
+          return extractOrigin(candidate).isSameOrigin(trustedOrigin);
+        }
+        const candidateUrl = new URL(extractUrlString(candidate));
+        const trustedParsedUrl = new URL(trustedUrl);
+        return (
+          candidateUrl.origin !== 'null' &&
+          trustedParsedUrl.origin !== 'null' &&
+          candidateUrl.origin === trustedParsedUrl.origin
+        );
+      } catch {
+        // Rejects invalid URLs, opaque "null" strings, or unsupported objects
+        return false;
+      }
+    }
+
+    /**
+     * 2. Validate same-site redirect URLs and classify internal vs. external links
+     * without error-prone string splitting.
+     * Uses Origin.from() and schemeful isSameSite() backed by the browser's Public Suffix List,
+     * with a URL-based fallback for browsers without the Origin API.
+     */
+    export function isAllowedSameSiteUrl(
+      candidateUrlOrElement,
+      siteUrl = APP_SITE_URL,
+      siteDomain = TRUSTED_SITE_DOMAIN
+    ) {
+      try {
+        if ('Origin' in globalThis) {
+          const appOrigin = Origin.from(siteUrl);
+          const candidateOrigin = extractOrigin(candidateUrlOrElement);
+          if (candidateOrigin.opaque) return false;
+          return candidateOrigin.isSameSite(appOrigin);
+        }
+        const candidateUrl = new URL(extractUrlString(candidateUrlOrElement));
+        const trustedUrl = new URL(siteUrl);
+        return (
+          candidateUrl.origin !== 'null' &&
+          candidateUrl.protocol === trustedUrl.protocol &&
+          (candidateUrl.hostname === siteDomain ||
+            candidateUrl.hostname.endsWith(`.${siteDomain}`))
+        );
+      } catch {
+        return false;
+      }
+    }
+
+    /**
+     * Classify and harden anchor elements on the page using same-site validation
+     * rather than string splitting. Marks external links with rel="noopener noreferrer"
+     * and target="_blank".
+     */
+    export function classifyAndHardenLinks(root = document, siteUrl = APP_SITE_URL) {
+      const anchors = root.querySelectorAll('a[href]');
+      for (const anchor of anchors) {
+        const rawHref = anchor.getAttribute('href') || '';
+        // Relative same-origin paths on the page share the current document's site
+        const resolvedCandidate = rawHref.startsWith('/')
+          ? new URL(rawHref, siteUrl).href
+          : anchor;
+
+        if (isAllowedSameSiteUrl(resolvedCandidate, siteUrl)) {
+          anchor.dataset.linkSite = 'same-site';
+        } else {
+          anchor.dataset.linkSite = 'external';
+          anchor.setAttribute('rel', 'noopener noreferrer');
+          anchor.setAttribute('target', '_blank');
+        }
+      }
+    }
+
+    /**
+     * Validate a post-login or checkout redirect parameter (?returnTo= or ?redirect=)
+     * ensuring only schemeful same-site targets are permitted.
+     */
+    export function getValidatedRedirectUrl(
+      rawRedirectUrl,
+      fallbackPath = '/account',
+      siteUrl = APP_SITE_URL
