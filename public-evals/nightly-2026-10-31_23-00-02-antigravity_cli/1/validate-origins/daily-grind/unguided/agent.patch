+  <script>
+    (() => {
+      const TRUSTED_ORDERING_URL = 'https://orders.dailygrind.com';
+      const trustedOrderingOrigin = Origin.from(TRUSTED_ORDERING_URL);
+
+      // Pinned opaque Origin for the sandboxed customizer widget
+      let pinnedWidgetOrigin = null;
+
+      const orderStatusBanner = document.getElementById('order-status-banner');
+      const widgetStatusBanner = document.getElementById('widget-status-banner');
+      const redirectStatusBanner = document.getElementById('redirect-status-banner');
+      const securityLog = document.getElementById('message-security-log');
+
+      function appendLog(message, accepted) {
+        if (!securityLog) return;
+        const li = document.createElement('li');
+        li.textContent = `[${accepted ? 'ACCEPTED' : 'REJECTED'}] ${message}`;
+        li.dataset.status = accepted ? 'accepted' : 'rejected';
+        securityLog.prepend(li);
+      }
+
+      /**
+       * Extracts an Origin object from a MessageEvent (or falls back to parsing event.origin
+       * if the event was synthetically constructed with a string origin).
+       */
+      function extractMessageOrigin(event) {
+        try {
+          return Origin.from(event);
+        } catch {
+          if (event && typeof event.origin === 'string') {
+            return Origin.from(event.origin);
+          }
+          throw new TypeError('Unable to extract Origin from message event');
+        }
+      }
+
+      /**
+       * Verifies whether a cross-window MessageEvent came from the trusted ordering origin
+       * using Origin.from() and isSameOrigin().
+       */
+      function isTrustedOrderingMessage(event, expectedOrigin = trustedOrderingOrigin) {
+        try {
+          const trusted = expectedOrigin instanceof Origin
+            ? expectedOrigin
+            : Origin.from(expectedOrigin);
+          const senderOrigin = extractMessageOrigin(event);
+          if (senderOrigin.opaque) {
+            return false;
+          }
+          return trusted.isSameOrigin(senderOrigin);
+        } catch {
+          return false;
+        }
+      }
+
+      /**
+       * Handles messages from sandboxed iframe widgets by pinning the opaque Origin of the
+       * widget on initialization (WIDGET_INIT) and verifying subsequent messages with isSameOrigin().
+       */
+      function handleSandboxedWidgetMessage(event) {
+        try {
+          const senderOrigin = extractMessageOrigin(event);
+          if (!senderOrigin.opaque) {
+            return false;
+          }
+
+          const payload = event.data || {};
+          const isInitMessage =
+            payload === 'init' ||
+            payload === 'WIDGET_INIT' ||
+            payload.type === 'WIDGET_INIT' ||
+            payload.type === 'init' ||
+            payload.type === 'ready' ||
+            payload.action === 'init';
+
+          if (pinnedWidgetOrigin === null && isInitMessage) {
+            pinnedWidgetOrigin = senderOrigin;
+            if (widgetStatusBanner) {
+              widgetStatusBanner.className = 'status-banner accepted';
+              widgetStatusBanner.textContent = `Pinned sandboxed widget identity (opaque=${senderOrigin.opaque}).`;
+            }
+            appendLog('Pinned opaque Origin for initialized sandboxed widget.', true);
+            return true;
+          }
+
+          if (pinnedWidgetOrigin !== null && pinnedWidgetOrigin.isSameOrigin(senderOrigin)) {
+            const detail = payload.item || payload.type || 'widget message';
+            if (widgetStatusBanner) {
+              widgetStatusBanner.className = 'status-banner accepted';
+              widgetStatusBanner.textContent = `Accepted message from pinned sandboxed widget: ${detail}`;
+            }
+            appendLog(`Accepted message from pinned sandboxed widget: ${detail}`, true);
+            return true;
+          }
+
+          if (widgetStatusBanner) {
+            widgetStatusBanner.className = 'status-banner rejected';
+            widgetStatusBanner.textContent = 'Rejected message from unpinned or different sandboxed iframe.';
+          }
+          appendLog('Rejected message from different sandboxed iframe (opaque Origin mismatch).', false);
+          return false;
+        } catch {
+          return false;
+        }
+      }
+
+      /**
+       * Validates that a candidate redirect URL is same-site with the current page (or reference origin)
+       * using Origin.from() and isSameSite() without string-splitting bugs.
+       */
+      function isValidSameSiteRedirect(redirectInput, referenceOrigin = window.location) {
+        try {
+          const currentOrigin = referenceOrigin instanceof Origin
+            ? referenceOrigin
+            : Origin.from(referenceOrigin);
+
+          let targetOrigin;
+          try {
+            targetOrigin = Origin.from(redirectInput);
+          } catch {
+            const resolvedUrl = new URL(redirectInput, window.location.href);
+            targetOrigin = Origin.from(resolvedUrl);
+          }
+
+          if (targetOrigin.opaque) {
+            return false;
+          }
+
+          return currentOrigin.isSameSite(targetOrigin);
+        } catch {
+          return false;
+        }
+      }
+
+      /**
+       * Validates anchor elements on the page using Origin.from(link) and isSameSite() / isSameOrigin()
+       * without manual hostname string splitting.
+       */
+      function validateAndClassifyLinks(root = document, referenceOrigin = window.location) {
+        let currentOrigin;
+        try {
+          currentOrigin = referenceOrigin instanceof Origin
+            ? referenceOrigin
+            : Origin.from(referenceOrigin);
+        } catch {
+          return;
+        }
+
+        const links = root.querySelectorAll('a[href]');
+        links.forEach((link) => {
+          try {
+            let linkOrigin;
+            try {
+              linkOrigin = Origin.from(link);
+            } catch {
+              linkOrigin = Origin.from(link.href);
+            }
+
+            const sameOrigin = currentOrigin.isSameOrigin(linkOrigin);
+            const sameSite = currentOrigin.isSameSite(linkOrigin);
+
+            if (sameOrigin) {
+              link.dataset.originRelation = 'same-origin';
+            } else if (sameSite) {
+              link.dataset.originRelation = 'same-site';
+            } else {
+              link.dataset.originRelation = 'cross-site';
+              link.dataset.external = 'true';
+              link.classList.add('external-link');
+              link.setAttribute('rel', 'noopener noreferrer');
+              link.setAttribute('target', '_blank');
+            }
+          } catch {
+            link.dataset.originRelation = 'invalid';
+          }
+        });
+      }
+
+      // Listen for cross-window messages (both trusted ordering origin and sandboxed widget iframes)
+      window.addEventListener('message', (event) => {
+        let senderOrigin;
+        try {
+          senderOrigin = extractMessageOrigin(event);
+        } catch {
+          appendLog('Rejected message with unparseable origin.', false);
+          return;
+        }
+
+        if (senderOrigin.opaque) {
+          handleSandboxedWidgetMessage(event);
+          return;
+        }
+
+        if (isTrustedOrderingMessage(event)) {
+          const orderSummary = (event.data && (event.data.orderId || event.data.status || JSON.stringify(event.data))) || 'Order confirmed';
+          if (orderStatusBanner) {
+            orderStatusBanner.className = 'status-banner accepted';
+            orderStatusBanner.textContent = `Verified order message from trusted origin: ${orderSummary}`;
+          }
+          appendLog(`Verified ordering message: ${orderSummary}`, true);
+        } else {
+          if (orderStatusBanner) {
+            orderStatusBanner.className = 'status-banner rejected';
+            orderStatusBanner.textContent = 'Rejected cross-window message from untrusted origin.';
+          }
+          appendLog('Rejected cross-window message from untrusted origin.', false);
+        }
+      });
+
+      // Validate logout redirect parameter using isValidSameSiteRedirect
+      const logoutLink = document.getElementById('logout-link');
+      if (logoutLink) {
+        logoutLink.addEventListener('click', (event) => {
+          const linkUrl = new URL(logoutLink.href, window.location.href);
+          const candidateRedirect = linkUrl.searchParams.get('redirect') || '/';
+          if (!isValidSameSiteRedirect(candidateRedirect)) {
+            event.preventDefault();
+            if (redirectStatusBanner) {
+              redirectStatusBanner.className = 'status-banner rejected';
+              redirectStatusBanner.textContent = `Blocked unsafe cross-site logout redirect: ${candidateRedirect}`;
+            }
+            appendLog(`Blocked unsafe logout redirect: ${candidateRedirect}`, false);
+          } else {
+            if (redirectStatusBanner) {
+              redirectStatusBanner.className = 'status-banner accepted';
+              redirectStatusBanner.textContent = `Validated same-site logout redirect: ${candidateRedirect}`;
+            }
+          }
+        });
+      }
+
+      // Check current page URL for any ?redirect= query parameter
+      const pageParams = new URLSearchParams(window.location.search);
+      if (pageParams.has('redirect')) {
+        const redirectParam = pageParams.get('redirect');
+        const valid = isValidSameSiteRedirect(redirectParam);
+        if (redirectStatusBanner) {
+          redirectStatusBanner.className = `status-banner ${valid ? 'accepted' : 'rejected'}`;
+          redirectStatusBanner.textContent = valid
+            ? `Validated same-site redirect parameter: ${redirectParam}`
+            : `Rejected cross-site redirect parameter: ${redirectParam}`;
+        }
+      }
+
+      // Interactive redirect validation control
+      const validateRedirectBtn = document.getElementById('validate-redirect-btn');
+      const redirectUrlInput = document.getElementById('redirect-url-input');
+      if (validateRedirectBtn && redirectUrlInput) {
+        validateRedirectBtn.addEventListener('click', () => {
+          const candidate = redirectUrlInput.value.trim();
+          const valid = isValidSameSiteRedirect(candidate);
+          if (redirectStatusBanner) {
+            redirectStatusBanner.className = `status-banner ${valid ? 'accepted' : 'rejected'}`;
+            redirectStatusBanner.textContent = valid
+              ? `Allowed same-site redirect URL: ${candidate}`
+              : `Blocked cross-site or invalid redirect URL: ${candidate}`;
+          }
+          appendLog(`Redirect validation for "${candidate}": ${valid ? 'same-site' : 'rejected'}`, valid);
+        });
+      }
+
+      // Validate and classify all links on the page
+      validateAndClassifyLinks(document);
+
+      // Expose validation helpers for programmatic inspection
+      window.DailyGrindSecurity = {
+        trustedOrderingOrigin,
+        isTrustedOrderingMessage,
+        handleSandboxedWidgetMessage,
+        isValidSameSiteRedirect,
+        validateAndClassifyLinks,
+        getPinnedWidgetOrigin: () => pinnedWidgetOrigin,
+        resetPinnedWidgetOrigin: () => { pinnedWidgetOrigin = null; }
+      };
+    })();
+  </script>
+
