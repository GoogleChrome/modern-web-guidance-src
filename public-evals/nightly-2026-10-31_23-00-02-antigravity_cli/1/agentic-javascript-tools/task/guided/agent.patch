diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,84 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const menuItems = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal",
+        price: "$5.50",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        url: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Espresso",
+        price: "$3.75",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        url: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        category: "Cold Brew",
+        price: "$4.50",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        url: "/menu/cold-brew",
+      },
+    ];
+
+    if ("modelContext" in document) {
+      const controller = new AbortController();
+
+      window.addEventListener("pagehide", () => controller.abort());
+      window.addEventListener("unload", () => controller.abort());
+
+      await document.modelContext.registerTool(
+        {
+          name: "get_menu_item_details",
+          description:
+            "Retrieves details for a menu item from The Daily Grind catalog. Use when the user asks about a drink or menu offering.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              itemName: {
+                type: "string",
+                description: "Name of the menu item to look up.",
+              },
+            },
+            required: ["itemName"],
+          },
+          execute({ itemName } = {}) {
+            if (typeof itemName !== "string" || !itemName.trim()) {
+              return {
+                error: "Pass a non-empty menu item name.",
+                availableItems: menuItems.map((entry) => entry.name),
+              };
+            }
+
+            const normalizedName = itemName.trim().toLowerCase();
+            const item = menuItems.find(
+              (entry) => entry.name.toLowerCase() === normalizedName
+            );
+
+            if (!item) {
+              return {
+                error: `Menu item "${itemName}" not found.`,
+                availableItems: menuItems.map((entry) => entry.name),
+              };
+            }
+
+            return item;
+          },
+          annotations: {
+            readOnlyHint: true,
+          },
+        },
+        { signal: controller.signal }
+      );
+    }
+  </script>
+
 </body>
 
 </html>
