@@ -0,0 +1,572 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import { formatToolResult, registerWebMCPTools } from '../utils/webmcp';
+
+export interface ArticleMetadata {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  tags?: string[];
+}
+
+interface Props {
+  article: ArticleMetadata;
+  initialIsBookmarked: boolean;
+}
+
+type FontSizeOption = 'sm' | 'base' | 'lg' | 'xl';
+type CitationFormat = 'apa' | 'mla' | 'chicago' | 'markdown' | 'bibtex';
+
+const FONT_SIZE_CLASSES: Record<FontSizeOption, string> = {
+  sm: 'prose-sm',
+  base: 'prose-base',
+  lg: 'prose-lg',
+  xl: 'prose-xl',
+};
+
+export default function ArticleUtilities({ article, initialIsBookmarked }: Props) {
+  const [fontSize, setFontSize] = useState<FontSizeOption>('base');
+  const [highContrast, setHighContrast] = useState<boolean>(false);
+  const [isBookmarked, setIsBookmarked] = useState<boolean>(initialIsBookmarked);
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+  const [highlights, setHighlights] = useState<string[]>([]);
+
+  useEffect(() => {
+    const handleUpdate = (e: Event) => {
+      const customEvent = e as CustomEvent<{ readingList?: string[] }>;
+      if (customEvent.detail?.readingList) {
+        setIsBookmarked(customEvent.detail.readingList.includes(article.slug));
+      }
+    };
+    window.addEventListener('reading-list-updated', handleUpdate);
+    return () => window.removeEventListener('reading-list-updated', handleUpdate);
+  }, [article.slug]);
+
+  const getArticleBodyElement = useCallback((): HTMLElement | null => {
+    return (
+      document.getElementById('article-body-content') ||
+      document.querySelector('article .prose')
+    );
+  }, []);
+
+  const applyReadingPreferences = useCallback(
+    (nextFontSize: FontSizeOption, nextHighContrast: boolean) => {
+      const bodyEl = getArticleBodyElement();
+      if (bodyEl) {
+        Object.values(FONT_SIZE_CLASSES).forEach(cls => bodyEl.classList.remove(cls));
+        bodyEl.classList.add(FONT_SIZE_CLASSES[nextFontSize]);
+        if (nextHighContrast) {
+          bodyEl.classList.add('bg-gray-900', 'text-gray-100', 'p-6', 'rounded-lg', 'prose-invert');
+        } else {
+          bodyEl.classList.remove('bg-gray-900', 'text-gray-100', 'p-6', 'rounded-lg', 'prose-invert');
+        }
+      }
+      setFontSize(nextFontSize);
+      setHighContrast(nextHighContrast);
+    },
+    [getArticleBodyElement]
+  );
+
+  const extractArticleContent = useCallback(
+    (includeBody = true) => {
+      const bodyEl = getArticleBodyElement();
+      const bodyText = bodyEl ? (bodyEl.innerText || bodyEl.textContent || '').trim() : '';
+      const words = bodyText ? bodyText.split(/\s+/).filter(Boolean) : [];
+      const wordCount = words.length;
+      const estimatedReadingTimeMinutes = Math.max(
+        1,
+        article.readingTime || Math.ceil(wordCount / 200)
+      );
+      const headings = bodyEl
+        ? Array.from(bodyEl.querySelectorAll('h1, h2, h3, h4')).map(h =>
+            (h.textContent || '').trim()
+          )
+        : [];
+
+      const payload = {
+        slug: article.slug,
+        title: article.title,
+        summary: article.summary,
+        author: article.author,
+        date: article.date,
+        category: article.category,
+        tags: article.tags || [],
+        wordCount,
+        estimatedReadingTimeMinutes,
+        headings,
+        bookmarked: isBookmarked,
+        url: typeof window !== 'undefined' ? window.location.href : `/articles/${article.slug}`,
+        ...(includeBody ? { content: bodyText } : {}),
+      };
+
+      return formatToolResult(
+        payload,
+        `Article "${article.title}" by ${article.author} (${wordCount} words, ~${estimatedReadingTimeMinutes} min read).\nSummary: ${article.summary}`
+      );
+    },
+    [article, getArticleBodyElement, isBookmarked]
+  );
+
+  const generateCitation = useCallback(
+    (format: CitationFormat = 'apa') => {
+      const url = typeof window !== 'undefined' ? window.location.href : '';
+      const pubDate = new Date(article.date);
+      const year = isNaN(pubDate.getFullYear()) ? new Date().getFullYear() : pubDate.getFullYear();
+      const formattedDate = isNaN(pubDate.getTime())
+        ? article.date
+        : pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
+
+      let citation = '';
+      switch (format.toLowerCase()) {
+        case 'mla':
+          citation = `${article.author}. "${article.title}." The DevTools Times, ${formattedDate}, ${url}.`;
+          break;
+        case 'chicago':
+          citation = `${article.author}. "${article.title}." The DevTools Times, ${formattedDate}. ${url}.`;
+          break;
+        case 'markdown':
+          citation = `[${article.title}](${url}) by ${article.author} — *The DevTools Times* (${formattedDate})`;
+          break;
+        case 'bibtex':
+          citation = `@article{${article.slug.replace(/[^a-zA-Z0-9]/g, '_')}_${year},\n  author = {${article.author}},\n  title = {${article.title}},\n  journal = {The DevTools Times},\n  year = {${year}},\n  url = {${url}}\n}`;
+          break;
+        case 'apa':
+        default:
+          citation = `${article.author}. (${year}, ${formattedDate}). ${article.title}. The DevTools Times. ${url}`;
+          break;
+      }
+
+      setStatusMessage(`Citation (${format.toUpperCase()}): ${citation}`);
+      return formatToolResult(
+        {
+          slug: article.slug,
+          format,
+          citation,
+          url,
+        },
+        citation
+      );
+    },
+    [article]
+  );
+
+  const shareOrCopyArticle = useCallback(
+    async (channel: 'copy' | 'twitter' | 'facebook' | 'email' | 'citation' = 'copy') => {
+      const url = typeof window !== 'undefined' ? window.location.href : `/articles/${article.slug}`;
+      const shareText = `${article.title} — ${article.summary}`;
+
+      if (channel === 'citation') {
+        const res = generateCitation('apa');
+        if (typeof navigator !== 'undefined' && navigator.clipboard?.writeText) {
+          try {
+            await navigator.clipboard.writeText(res.citation);
+          } catch {
+            // Clipboard permission may not be granted in headless contexts
+          }
+        }
+        return res;
+      }
+
+      let shareUrl = url;
+      if (channel === 'twitter') {
+        shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(url)}`;
+      } else if (channel === 'facebook') {
+        shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
+      } else if (channel === 'email') {
+        shareUrl = `mailto:?subject=${encodeURIComponent(article.title)}&body=${encodeURIComponent(`${shareText}\n\n${url}`)}`;
+      } else if (typeof navigator !== 'undefined' && navigator.clipboard?.writeText) {
+        try {
+          await navigator.clipboard.writeText(url);
+        } catch {
+          // Ignore clipboard write errors in restricted contexts
+        }
+      }
+
+      setStatusMessage(`Shared article via ${channel}: ${shareUrl}`);
+      return formatToolResult(
+        {
+          slug: article.slug,
+          title: article.title,
+          channel,
+          url,
+          shareUrl,
+        },
+        `Prepared ${channel} share link for "${article.title}": ${shareUrl}`
+      );
+    },
+    [article, generateCitation]
+  );
+
+  const highlightTextInArticle = useCallback(
+    (query: string, clearExisting = false) => {
+      const bodyEl = getArticleBodyElement();
+      if (!bodyEl) {
+        return formatToolResult(
+          { query, matchCount: 0, error: 'Article body not found' },
+          'Article body element not found on page.'
+        );
+      }
+
+      if (clearExisting) {
+        const existingMarks = bodyEl.querySelectorAll('mark[data-webmcp-highlight="true"]');
+        existingMarks.forEach(mark => {
+          const parent = mark.parentNode;
+          if (parent) {
+            parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
+            parent.normalize();
+          }
+        });
+        setHighlights([]);
+      }
+
+      const trimmed = (query || '').trim();
+      if (!trimmed) {
+        return formatToolResult(
+          { query: '', matchCount: 0, cleared: clearExisting },
+          clearExisting ? 'Cleared article highlights.' : 'No search phrase provided to highlight.'
+        );
+      }
+
+      let matchCount = 0;
+      const walker = document.createTreeWalker(bodyEl, NodeFilter.SHOW_TEXT);
+      const textNodes: Text[] = [];
+      let currentNode = walker.nextNode();
+      while (currentNode) {
+        if (
+          currentNode.parentElement &&
+          !['SCRIPT', 'STYLE', 'MARK'].includes(currentNode.parentElement.tagName)
+        ) {
+          textNodes.push(currentNode as Text);
+        }
+        currentNode = walker.nextNode();
+      }
+
+      const escaped = trimmed.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+      const regex = new RegExp(`(${escaped})`, 'gi');
+
+      textNodes.forEach(node => {
+        const text = node.nodeValue || '';
+        if (!regex.test(text)) return;
+        regex.lastIndex = 0;
+
+        const fragment = document.createDocumentFragment();
+        let lastIdx = 0;
+        let match: RegExpExecArray | null;
+        while ((match = regex.exec(text)) !== null) {
+          if (match.index > lastIdx) {
+            fragment.appendChild(document.createTextNode(text.slice(lastIdx, match.index)));
+          }
+          const mark = document.createElement('mark');
+          mark.setAttribute('data-webmcp-highlight', 'true');
+          mark.className = 'bg-amber-200 text-gray-900 px-0.5 rounded';
+          mark.textContent = match[0];
+          fragment.appendChild(mark);
+          matchCount++;
+          lastIdx = regex.lastIndex;
+        }
+        if (lastIdx < text.length) {
+          fragment.appendChild(document.createTextNode(text.slice(lastIdx)));
+        }
+        node.parentNode?.replaceChild(fragment, node);
+      });
+
+      if (matchCount > 0) {
+        setHighlights(prev => (prev.includes(trimmed) ? prev : [...prev, trimmed]));
+      }
+      setStatusMessage(`Highlighted ${matchCount} occurrence(s) of "${trimmed}".`);
+
+      return formatToolResult(
+        {
+          slug: article.slug,
+          query: trimmed,
+          matchCount,
+        },
+        `Highlighted ${matchCount} occurrence(s) of "${trimmed}" in "${article.title}".`
+      );
+    },
+    [article, getArticleBodyElement]
+  );
+
+  const toggleArticleBookmark = useCallback(
+    async (action?: 'add' | 'remove' | 'toggle') => {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ slug: article.slug, action }),
+      });
+      const data = await response.json();
+      const readingList: string[] = data.readingList || [];
+      const bookmarked = readingList.includes(article.slug);
+      setIsBookmarked(bookmarked);
+      window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: { readingList } }));
+      setStatusMessage(
+        bookmarked ? 'Added article to reading list.' : 'Removed article from reading list.'
+      );
+      return formatToolResult(
+        {
+          slug: article.slug,
+          bookmarked,
+          readingList,
+        },
+        bookmarked
+          ? `Added "${article.title}" (${article.slug}) to reading list.`
+          : `Removed "${article.title}" (${article.slug}) from reading list.`
+      );
+    },
+    [article]
+  );
+
+  useEffect(() => {
+    return registerWebMCPTools([
+      {
+        name: 'get_article_content',
+        title: 'Get Article Content & Metadata',
+        description:
+          'Extract the full text, summary, metadata, word count, headings, and estimated reading time of the current article.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            includeBody: {
+              type: 'boolean',
+              description: 'Whether to include the full plain-text article body (defaults to true).',
+            },
+          },
+        },
+        annotations: {
+          readOnlyHint: true,
+        },
+        execute: async ({ includeBody = true }: { includeBody?: boolean } = {}) => {
+          return extractArticleContent(includeBody);
+        },
+      },
+      {
+        name: 'adjust_article_display',
+        title: 'Adjust Article Display Preferences',
+        description:
+          'Change client-side reading preferences for the current article, including font size and high-contrast reading mode.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            fontSize: {
+              type: 'string',
+              enum: ['sm', 'base', 'lg', 'xl'],
+              description: 'Desired article body font size: sm, base, lg, or xl.',
+            },
+            highContrast: {
+              type: 'boolean',
+              description: 'Enable or disable high-contrast dark reading mode for the article body.',
+            },
+          },
+        },
+        execute: async ({
+          fontSize: nextSize,
+          highContrast: nextContrast,
+        }: {
+          fontSize?: FontSizeOption;
+          highContrast?: boolean;
+        } = {}) => {
+          const resolvedSize: FontSizeOption =
+            nextSize && nextSize in FONT_SIZE_CLASSES ? nextSize : fontSize;
+          const resolvedContrast =
+            typeof nextContrast === 'boolean' ? nextContrast : highContrast;
+          applyReadingPreferences(resolvedSize, resolvedContrast);
+          setStatusMessage(
+            `Updated display: font size "${resolvedSize}", high contrast ${resolvedContrast ? 'ON' : 'OFF'}.`
+          );
+          return formatToolResult(
+            {
+              slug: article.slug,
+              fontSize: resolvedSize,
+              highContrast: resolvedContrast,
+            },
+            `Adjusted article display to fontSize="${resolvedSize}", highContrast=${resolvedContrast}.`
+          );
+        },
+      },
+      {
+        name: 'highlight_article_text',
+        title: 'Highlight Text in Article',
+        description:
+          'Find and visually highlight occurrences of a keyword or phrase inside the current article body.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            query: {
+              type: 'string',
+              description: 'The keyword or phrase to highlight in the article text.',
+            },
+            clearExisting: {
+              type: 'boolean',
+              description: 'Whether to clear previously highlighted phrases before highlighting.',
+            },
+          },
+          required: ['query'],
+        },
+        execute: async ({
+          query,
+          clearExisting = false,
+        }: {
+          query: string;
+          clearExisting?: boolean;
+        }) => {
+          return highlightTextInArticle(query, clearExisting);
+        },
+      },
+      {
+        name: 'cite_article',
+        title: 'Generate Article Citation',
+        description:
+          'Generate a formatted citation for the current article in APA, MLA, Chicago, Markdown, or BibTeX format.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            format: {
+              type: 'string',
+              enum: ['apa', 'mla', 'chicago', 'markdown', 'bibtex'],
+              description: 'Citation style format to generate (apa, mla, chicago, markdown, bibtex).',
+            },
+          },
+        },
+        annotations: {
+          readOnlyHint: true,
+        },
+        execute: async ({ format = 'apa' }: { format?: CitationFormat } = {}) => {
+          return generateCitation(format);
+        },
+      },
+      {
+        name: 'share_article',
+        title: 'Share or Copy Article Link',
+        description:
+          'Copy the current article URL to the clipboard or generate a social/email share link.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            channel: {
+              type: 'string',
+              enum: ['copy', 'twitter', 'facebook', 'email', 'citation'],
+              description: 'Channel to share or copy the article with.',
+            },
+          },
+        },
+        execute: async ({
+          channel = 'copy',
+        }: {
+          channel?: 'copy' | 'twitter' | 'facebook' | 'email' | 'citation';
+        } = {}) => {
+          return await shareOrCopyArticle(channel);
+        },
+      },
+      {
+        name: 'toggle_current_article_bookmark',
+        title: 'Bookmark Current Article',
+        description:
+          'Add, remove, or toggle the current article in the user\'s reading list.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            action: {
+              type: 'string',
+              enum: ['add', 'remove', 'toggle'],
+              description: 'Whether to add, remove, or toggle the bookmark status.',
+            },
+          },
+        },
+        execute: async ({ action = 'toggle' }: { action?: 'add' | 'remove' | 'toggle' } = {}) => {
+          return await toggleArticleBookmark(action);
+        },
+      },
+    ]);
+  }, [
+    article,
+    fontSize,
+    highContrast,
+    applyReadingPreferences,
+    extractArticleContent,
+    generateCitation,
+    highlightTextInArticle,
+    shareOrCopyArticle,
+    toggleArticleBookmark,
+  ]);
+
+  return (
+    <div
+      className="flex flex-wrap items-center gap-2 text-xs text-gray-600"
+      aria-label="Article utilities"
+    >
+      <div className="flex items-center border border-gray-200 rounded-md overflow-hidden">
+        <button
+          type="button"
+          onClick={() => {
+            const order: FontSizeOption[] = ['sm', 'base', 'lg', 'xl'];
+            const idx = Math.max(0, order.indexOf(fontSize) - 1);
+            applyReadingPreferences(order[idx], highContrast);
+          }}
+          className="px-2 py-1 hover:bg-gray-100 font-semibold"
+          title="Decrease font size"
+        >
+          A-
+        </button>
+        <button
+          type="button"
+          onClick={() => {
+            const order: FontSizeOption[] = ['sm', 'base', 'lg', 'xl'];
+            const idx = Math.min(order.length - 1, order.indexOf(fontSize) + 1);
+            applyReadingPreferences(order[idx], highContrast);
+          }}
+          className="px-2 py-1 hover:bg-gray-100 font-semibold border-l border-gray-200"
+          title="Increase font size"
+        >
+          A+
+        </button>
+      </div>
+
+      <button
+        type="button"
+        onClick={() => applyReadingPreferences(fontSize, !highContrast)}
+        className={`px-2.5 py-1 rounded-md border transition ${
+          highContrast
+            ? 'bg-gray-900 text-white border-gray-900'
+            : 'border-gray-200 hover:bg-gray-100 text-gray-700'
+        }`}
+      >
+        {highContrast ? 'Standard View' : 'High Contrast'}
+      </button>
+
+      <button
+        type="button"
+        onClick={() => generateCitation('apa')}
+        className="px-2.5 py-1 rounded-md border border-gray-200 hover:bg-gray-100 text-gray-700 transition"
+      >
+        Cite
+      </button>
+
+      <button
+        type="button"
+        onClick={() => shareOrCopyArticle('copy')}
+        className="px-2.5 py-1 rounded-md border border-gray-200 hover:bg-gray-100 text-gray-700 transition"
+      >
+        Copy Link
+      </button>
+
+      {highlights.length > 0 && (
+        <button
+          type="button"
+          onClick={() => highlightTextInArticle('', true)}
+          className="px-2.5 py-1 rounded-md border border-amber-300 bg-amber-50 hover:bg-amber-100 text-amber-900 transition"
+        >
+          Clear Highlights ({highlights.length})
+        </button>
+      )}
+
+      {statusMessage && (
+        <span className="w-full text-xs text-gray-500 mt-1" role="status">
+          {statusMessage}
+        </span>
+      )}
+    </div>
+  );
+}
