diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..77f664d
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,56 @@
+import type { WebMCPTool, ModelContext } from '../global';
+
+export function getModelContext(): ModelContext | undefined {
+  if (typeof window === 'undefined') return undefined;
+  return navigator.modelContext || document.modelContext;
+}
+
+export function formatToolResult(data: any, summaryText?: string) {
+  const text = summaryText || (typeof data === 'string' ? data : JSON.stringify(data, null, 2));
+  if (data && typeof data === 'object' && !Array.isArray(data)) {
+    return {
+      ...data,
+      content: [{ type: 'text', text }],
+    };
+  }
+  return {
+    result: data,
+    content: [{ type: 'text', text }],
+  };
+}
+
+export function registerWebMCPTool(tool: WebMCPTool): () => void {
+  const mc = getModelContext();
+  if (!mc) return () => {};
+
+  try {
+    if (typeof mc.unregisterTool === 'function') {
+      try {
+        mc.unregisterTool(tool.name);
+      } catch {
+        // Ignore if tool was not previously registered
+      }
+    }
+    mc.registerTool(tool, tool.execute);
+  } catch (err) {
+    console.warn(`Failed to register WebMCP tool "${tool.name}":`, err);
+  }
+
+  return () => {
+    try {
+      const currentMc = getModelContext();
+      if (currentMc && typeof currentMc.unregisterTool === 'function') {
+        currentMc.unregisterTool(tool.name);
+      }
+    } catch {
+      // Ignore cleanup errors
+    }
+  };
+}
+
+export function registerWebMCPTools(tools: WebMCPTool[]): () => void {
+  const cleanups = tools.map(tool => registerWebMCPTool(tool));
+  return () => {
+    cleanups.forEach(cleanup => cleanup());
+  };
+}
