@@ -0,0 +1,357 @@
+import React from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+export interface ArticleUtilityItem {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  image?: string;
+}
+
+export interface CurrentArticleData extends ArticleUtilityItem {
+  bodyText?: string;
+  relatedSlugs?: string[];
+}
+
+interface Props {
+  articles: ArticleUtilityItem[];
+  categories: string[];
+  currentArticle?: CurrentArticleData;
+}
+
+export default function ArticleUtilitiesTools({ articles, categories, currentArticle }: Props) {
+  useWebMCP<{ category?: string; sort?: 'newest' | 'oldest' | 'reading_time_asc' | 'reading_time_desc'; limit?: number }, unknown>({
+    name: 'list_articles',
+    description: 'List or filter articles from The DevTools Times catalog by category and sort order. Use when the user wants to browse stories or filter by section.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        category: {
+          type: 'string',
+          description: 'Category name to filter articles by.',
+        },
+        sort: {
+          type: 'string',
+          enum: ['newest', 'oldest', 'reading_time_asc', 'reading_time_desc'],
+          default: 'newest',
+          description: 'Ordering applied to the returned articles.',
+        },
+        limit: {
+          type: 'number',
+          minimum: 1,
+          maximum: 50,
+          default: 10,
+          description: 'Maximum number of articles to return.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute(input) {
+      const sortOrder = input?.sort ?? 'newest';
+      const validSorts = ['newest', 'oldest', 'reading_time_asc', 'reading_time_desc'];
+      if (!validSorts.includes(sortOrder)) {
+        return {
+          error: `Unsupported sort order "${sortOrder}".`,
+          supportedSortOrders: validSorts,
+        };
+      }
+
+      const rawLimit = typeof input?.limit === 'number' ? input.limit : 10;
+      const limit = Math.max(1, Math.min(50, Math.floor(rawLimit)));
+
+      let filtered = [...articles];
+      if (typeof input?.category === 'string' && input.category.trim() !== '') {
+        const targetCategory = input.category.trim().toLowerCase();
+        filtered = filtered.filter((a) => a.category.toLowerCase() === targetCategory);
+        if (filtered.length === 0) {
+          return {
+            error: `No articles found in category "${input.category}".`,
+            availableCategories: categories,
+          };
+        }
+      }
+
+      filtered.sort((a, b) => {
+        if (sortOrder === 'oldest') {
+          return new Date(a.date).valueOf() - new Date(b.date).valueOf();
+        }
+        if (sortOrder === 'reading_time_asc') {
+          return (a.readingTime ?? 0) - (b.readingTime ?? 0);
+        }
+        if (sortOrder === 'reading_time_desc') {
+          return (b.readingTime ?? 0) - (a.readingTime ?? 0);
+        }
+        return new Date(b.date).valueOf() - new Date(a.date).valueOf();
+      });
+
+      const sliced = filtered.slice(0, limit);
+      return {
+        totalMatching: filtered.length,
+        returned: sliced.length,
+        articles: sliced.map((a) => ({
+          ...a,
+          url: `${import.meta.env.BASE_URL}articles/${a.slug}`,
+        })),
+      };
+    },
+  });
+
+  useWebMCP<{ slug?: string }, unknown>({
+    name: 'get_article_details',
+    description: 'Get metadata, summary, and reading time for a specific article by its slug, or for the currently viewed article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'Slug identifier of the article to inspect. Omit to inspect the current article page.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute(input) {
+      const targetSlug =
+        typeof input?.slug === 'string' && input.slug.trim() !== ''
+          ? input.slug.trim()
+          : currentArticle?.slug;
+
+      if (!targetSlug) {
+        return {
+          error: 'No article slug provided and not currently on an article page.',
+          availableSlugs: articles.map((a) => a.slug),
+        };
+      }
+
+      if (currentArticle && currentArticle.slug === targetSlug) {
+        const domBody =
+          typeof document !== 'undefined'
+            ? document.querySelector('article .prose')?.textContent?.trim()
+            : undefined;
+        const text = domBody || currentArticle.bodyText || currentArticle.summary;
+        const wordCount = text ? text.split(/\s+/).filter(Boolean).length : 0;
+
+        return {
+          ...currentArticle,
+          wordCount,
+          estimatedReadingMinutes: currentArticle.readingTime ?? Math.max(1, Math.ceil(wordCount / 200)),
+          contentText: text,
+          url: `${import.meta.env.BASE_URL}articles/${currentArticle.slug}`,
+        };
+      }
+
+      const found = articles.find((a) => a.slug.toLowerCase() === targetSlug.toLowerCase());
+      if (!found) {
+        return {
+          error: `Article "${targetSlug}" not found.`,
+          availableSlugs: articles.map((a) => a.slug),
+        };
+      }
+
+      return {
+        ...found,
+        url: `${import.meta.env.BASE_URL}articles/${found.slug}`,
+      };
+    },
+  });
+
+  useWebMCP<{ slug?: string; wordsPerMinute?: number }, unknown>({
+    name: 'calculate_article_reading_stats',
+    description: 'Calculate word count, character count, and customized reading time for an article or the current article page.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'Slug identifier of the article to analyze. Defaults to the current article page if omitted.',
+        },
+        wordsPerMinute: {
+          type: 'number',
+          minimum: 50,
+          maximum: 1000,
+          default: 200,
+          description: 'Reading speed in words per minute used to estimate reading duration.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute(input) {
+      const wpm =
+        typeof input?.wordsPerMinute === 'number' && input.wordsPerMinute >= 50 && input.wordsPerMinute <= 1000
+          ? input.wordsPerMinute
+          : 200;
+
+      const targetSlug =
+        typeof input?.slug === 'string' && input.slug.trim() !== ''
+          ? input.slug.trim()
+          : currentArticle?.slug;
+
+      if (!targetSlug) {
+        return {
+          error: 'Pass an article slug or invoke this tool while viewing an article page.',
+          availableSlugs: articles.map((a) => a.slug),
+        };
+      }
+
+      if (currentArticle && currentArticle.slug === targetSlug) {
+        const domBody =
+          typeof document !== 'undefined'
+            ? document.querySelector('article .prose')?.textContent?.trim()
+            : undefined;
+        const text = domBody || currentArticle.bodyText || currentArticle.summary;
+        const words = text ? text.split(/\s+/).filter(Boolean) : [];
+        const wordCount = words.length;
+        const characterCount = text ? text.length : 0;
+        const estimatedMinutes = Math.max(1, Math.ceil(wordCount / wpm));
+
+        return {
+          slug: currentArticle.slug,
+          title: currentArticle.title,
+          wordCount,
+          characterCount,
+          wordsPerMinute: wpm,
+          estimatedReadingMinutes: estimatedMinutes,
+          listedReadingMinutes: currentArticle.readingTime ?? estimatedMinutes,
+        };
+      }
+
+      const found = articles.find((a) => a.slug.toLowerCase() === targetSlug.toLowerCase());
+      if (!found) {
+        return {
+          error: `Article "${targetSlug}" not found.`,
+          availableSlugs: articles.map((a) => a.slug),
+        };
+      }
+
+      const summaryWords = found.summary.split(/\s+/).filter(Boolean).length;
+      const estimatedTotalWords = (found.readingTime ?? 3) * 200;
+      return {
+        slug: found.slug,
+        title: found.title,
+        summaryWordCount: summaryWords,
+        estimatedWordCount: estimatedTotalWords,
+        wordsPerMinute: wpm,
+        estimatedReadingMinutes: Math.max(1, Math.ceil(estimatedTotalWords / wpm)),
+        listedReadingMinutes: found.readingTime ?? 3,
+      };
+    },
+  });
+
+  useWebMCP<{ slug?: string }, unknown>({
+    name: 'get_article_popularity',
+    description: 'Fetch live popularity metrics and trending status for an article from the telemetry service.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'Slug identifier of the article to query. Defaults to the current article if on an article page.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    async execute(input, { signal }) {
+      const targetSlug =
+        typeof input?.slug === 'string' && input.slug.trim() !== ''
+          ? input.slug.trim()
+          : currentArticle?.slug;
+
+      if (!targetSlug) {
+        return {
+          error: 'Article slug is required when not on an article page.',
+          availableSlugs: articles.map((a) => a.slug),
+        };
+      }
+
+      try {
+        const response = await fetch(
+          `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(targetSlug)}`,
+          { signal }
+        );
+        if (!response.ok) {
+          const errData = await response.json().catch(() => null);
+          return {
+            error: errData?.message || `Popularity request failed with status ${response.status}`,
+          };
+        }
+        return await response.json();
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  useWebMCP<{ format?: 'markdown' | 'url' | 'citation' }, unknown>({
+    name: 'share_current_article',
+    description: 'Generate a shareable link, markdown snippet, or formatted citation for the currently viewed article and copy it to the clipboard if available.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        format: {
+          type: 'string',
+          enum: ['markdown', 'url', 'citation'],
+          default: 'markdown',
+          description: 'Output format for sharing the article.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    enabled: Boolean(currentArticle),
+    async execute(input, { signal }) {
+      if (!currentArticle) {
+        return { error: 'No active article on the current page.' };
+      }
+      const format = input?.format ?? 'markdown';
+      const url =
+        typeof window !== 'undefined'
+          ? window.location.href
+          : `${import.meta.env.BASE_URL}articles/${currentArticle.slug}`;
+
+      let formattedText = url;
+      if (format === 'markdown') {
+        formattedText = `[${currentArticle.title}](${url}) — ${currentArticle.summary}`;
+      } else if (format === 'citation') {
+        const year = new Date(currentArticle.date).getFullYear();
+        formattedText = `${currentArticle.author} (${year}). "${currentArticle.title}." The DevTools Times. Retrieved from ${url}`;
+      }
+
+      let copiedToClipboard = false;
+      if (typeof navigator !== 'undefined' && navigator.clipboard?.writeText) {
+        try {
+          await navigator.clipboard.writeText(formattedText);
+          copiedToClipboard = true;
+        } catch {
+          copiedToClipboard = false;
+        }
+      }
+
+      signal.throwIfAborted();
+
+      return {
+        slug: currentArticle.slug,
+        title: currentArticle.title,
+        format,
+        shareText: formattedText,
+        copiedToClipboard,
+      };
+    },
+  });
+
+  return null;
+}
