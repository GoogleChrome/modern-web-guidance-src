@@ -0,0 +1,197 @@
+import React, { useState } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+export interface ArticlePageContext {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  bodyText?: string;
+  relatedArticles: Array<{
+    slug: string;
+    title: string;
+    summary: string;
+    category: string;
+  }>;
+}
+
+interface Props {
+  article: ArticlePageContext;
+}
+
+const FONT_SIZES = ['sm', 'base', 'lg', 'xl'] as const;
+type FontSizeOption = (typeof FONT_SIZES)[number];
+
+export default function ArticlePageTools({ article }: Props) {
+  const [fontSize, setFontSize] = useState<FontSizeOption>('base');
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+
+  const applyFontSizeToArticle = (size: FontSizeOption) => {
+    setFontSize(size);
+    if (typeof document !== 'undefined') {
+      const proseEl = document.querySelector('article .prose');
+      if (proseEl) {
+        proseEl.classList.remove('prose-sm', 'prose-base', 'prose-lg', 'prose-xl');
+        proseEl.classList.add(`prose-${size}`);
+      }
+    }
+  };
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'extract_current_article_outline',
+    description: 'Extract the full text, headings outline, and related articles from the currently open article page.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute() {
+      const proseEl = typeof document !== 'undefined' ? document.querySelector('article .prose') : null;
+      const headings = proseEl
+        ? Array.from(proseEl.querySelectorAll('h1, h2, h3, h4')).map((el) => ({
+            level: el.tagName.toLowerCase(),
+            text: el.textContent?.trim() ?? '',
+          }))
+        : [];
+      const bodyText = proseEl?.textContent?.trim() || article.bodyText || article.summary;
+      const wordCount = bodyText.split(/\s+/).filter(Boolean).length;
+
+      return {
+        slug: article.slug,
+        title: article.title,
+        author: article.author,
+        date: article.date,
+        category: article.category,
+        summary: article.summary,
+        wordCount,
+        estimatedReadingMinutes: article.readingTime ?? Math.max(1, Math.ceil(wordCount / 200)),
+        headings,
+        bodyText,
+        relatedArticles: article.relatedArticles,
+      };
+    },
+  });
+
+  useWebMCP<{ size: FontSizeOption }, unknown>({
+    name: 'set_article_font_size',
+    description: 'Adjust the typography text size of the current article body to improve readability.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        size: {
+          type: 'string',
+          enum: FONT_SIZES,
+          default: 'base',
+          description: 'Typography scale for the article body.',
+        },
+      },
+      required: ['size'],
+    },
+    annotations: {
+      readOnlyHint: false,
+    },
+    execute(input) {
+      const requested = (input?.size ?? 'base') as FontSizeOption;
+      if (!FONT_SIZES.includes(requested)) {
+        return {
+          error: `Unsupported font size "${String(input?.size)}".`,
+          supportedSizes: FONT_SIZES,
+        };
+      }
+      applyFontSizeToArticle(requested);
+      setStatusMessage(`Font size set to ${requested.toUpperCase()}`);
+      return {
+        slug: article.slug,
+        fontSize: requested,
+      };
+    },
+  });
+
+  useWebMCP<{ format?: 'markdown' | 'url' | 'citation' }, unknown>({
+    name: 'copy_article_citation',
+    description: 'Format a citation, markdown link, or URL for the current article and copy it to the clipboard.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        format: {
+          type: 'string',
+          enum: ['markdown', 'url', 'citation'],
+          default: 'citation',
+          description: 'Desired citation or link format.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    async execute(input, { signal }) {
+      const format = input?.format ?? 'citation';
+      const validFormats = ['markdown', 'url', 'citation'];
+      if (!validFormats.includes(format)) {
+        return {
+          error: `Unsupported format "${String(format)}".`,
+          supportedFormats: validFormats,
+        };
+      }
+
+      const url =
+        typeof window !== 'undefined'
+          ? window.location.href
+          : `${import.meta.env.BASE_URL}articles/${article.slug}`;
+
+      let text = url;
+      if (format === 'markdown') {
+        text = `[${article.title}](${url}) — ${article.summary}`;
+      } else if (format === 'citation') {
+        const year = new Date(article.date).getFullYear();
+        text = `${article.author} (${year}). "${article.title}." The DevTools Times. ${url}`;
+      }
+
+      let copied = false;
+      if (typeof navigator !== 'undefined' && navigator.clipboard?.writeText) {
+        try {
+          await navigator.clipboard.writeText(text);
+          copied = true;
+        } catch {
+          copied = false;
+        }
+      }
+
+      signal.throwIfAborted();
+      setStatusMessage(`Prepared ${format} snippet`);
+
+      return {
+        slug: article.slug,
+        format,
+        text,
+        copiedToClipboard: copied,
+      };
+    },
+  });
+
+  return (
+    <div className="flex items-center gap-2 text-xs text-gray-600">
+      <span className="font-semibold text-gray-700">Text size:</span>
+      {FONT_SIZES.map((size) => (
+        <button
+          key={size}
+          type="button"
+          onClick={() => applyFontSizeToArticle(size)}
+          className={`px-2 py-1 rounded border transition ${
+            fontSize === size
+              ? 'bg-gray-900 text-white border-gray-900'
+              : 'bg-white text-gray-700 border-gray-300 hover:border-amber-400'
+          }`}
+        >
+          {size.toUpperCase()}
+        </button>
+      ))}
+      {statusMessage && <span className="text-amber-700 ml-2">{statusMessage}</span>}
+    </div>
+  );
+}
diff --git a/src/components/ArticleUtilitiesTools.tsx b/src/components/ArticleUtilitiesTools.tsx
