+      <button type="submit" className="p-1" aria-label={isBookmarked ? 'Remove from reading list' : 'Add to reading list'}>
+        <BookmarkIcon className={`h-5 w-5 ${isBookmarked ? 'text-amber-400 fill-current' : 'text-gray-400'}`} />
+      </button>
+    </form>
   );
 }
