+    };
+  }, [slug]);
 
   return (
-    <button onClick={handleClick} className="p-1">
-      <BookmarkIcon className={`h-5 w-5 ${isBookmarked ? 'text-amber-400 fill-current' : 'text-gray-400'}`}></BookmarkIcon>
