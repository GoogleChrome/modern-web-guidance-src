+  <script>
+    const SEASONAL_MENU = [
+      {
+        id: 'maple-oat-latte',
+        name: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+        category: 'latte',
+        price: 5.75,
+        caffeineMg: 150,
+        defaultMilk: 'oat',
+        availableSizes: ['small', 'medium', 'large'],
+        detailsUrl: '/menu/seasonal'
+      },
+      {
+        id: 'dark-roast-espresso',
+        name: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost.',
+        category: 'espresso',
+        price: 3.50,
+        caffeineMg: 210,
+        defaultMilk: 'none',
+        availableSizes: ['small', 'medium', 'large'],
+        detailsUrl: '/menu/espresso'
+      },
+      {
+        id: 'cold-brew',
+        name: 'Cold Brew',
+        description: 'Steeped for 18 hours for maximum smoothness.',
+        category: 'cold-brew',
+        price: 4.50,
+        caffeineMg: 185,
+        defaultMilk: 'none',
+        availableSizes: ['small', 'medium', 'large'],
+        detailsUrl: '/menu/cold-brew'
+      }
+    ];
+
+    const VALID_SIZES = ['small', 'medium', 'large'];
+    const VALID_MILKS = ['oat', 'whole', 'almond', 'none'];
+    const activeOrders = [];
+
+    function findDrink(identifier) {
+      if (typeof identifier !== 'string' || !identifier.trim()) return null;
+      const normalized = identifier.trim().toLowerCase();
+      return SEASONAL_MENU.find(
+        (item) =>
+          item.id.toLowerCase() === normalized ||
+          item.name.toLowerCase() === normalized ||
+          item.name.toLowerCase().includes(normalized)
+      ) || null;
+    }
+
+    function updateStatusBanner(message) {
+      const banner = document.getElementById('agent-status-banner');
+      if (banner) {
+        banner.textContent = message;
+      }
+    }
+
+    function highlightDrinkCard(drinkId) {
+      const cards = document.querySelectorAll('#seasonal-menu-grid .card');
+      let matchedCard = null;
+      cards.forEach((card) => {
+        if (card.dataset.drinkId === drinkId) {
+          card.classList.add('highlighted');
+          matchedCard = card;
+        } else {
+          card.classList.remove('highlighted');
+        }
+      });
+      return matchedCard;
+    }
+
+    function renderOrdersUI() {
+      const listEl = document.getElementById('order-list');
+      const countEl = document.getElementById('order-count');
+      if (!listEl || !countEl) return;
+
+      const totalCups = activeOrders.reduce((sum, item) => sum + item.quantity, 0);
+      countEl.textContent = String(totalCups);
+      listEl.innerHTML = '';
+
+      if (activeOrders.length === 0) {
+        const emptyLi = document.createElement('li');
+        emptyLi.className = 'order-item';
+        emptyLi.id = 'empty-order-msg';
+        emptyLi.textContent = 'No drinks ordered yet. Select a seasonal favorite to begin!';
+        listEl.appendChild(emptyLi);
+        return;
+      }
+
+      activeOrders.forEach((order) => {
+        const li = document.createElement('li');
+        li.className = 'order-item';
+        const titleSpan = document.createElement('span');
+        titleSpan.textContent = `${order.quantity}x ${order.drinkName} (${order.size}, ${order.milk} milk)`;
+        const priceSpan = document.createElement('strong');
+        priceSpan.textContent = `$${order.totalPrice.toFixed(2)}`;
+        li.append(titleSpan, priceSpan);
+        listEl.appendChild(li);
+      });
+    }
+
+    function addOrderToState({ drinkInput, size = 'medium', milk, quantity = 1 }) {
+      const drink = findDrink(drinkInput);
+      if (!drink) {
+        return {
+          error: `Seasonal drink "${drinkInput}" not found.`,
+          availableDrinks: SEASONAL_MENU.map((d) => ({ id: d.id, name: d.name }))
+        };
+      }
+
+      const normalizedSize = typeof size === 'string' ? size.toLowerCase() : 'medium';
+      if (!VALID_SIZES.includes(normalizedSize)) {
+        return {
+          error: `Unsupported cup size "${size}".`,
+          supportedSizes: VALID_SIZES
+        };
+      }
+
+      const selectedMilk = milk ? String(milk).toLowerCase() : drink.defaultMilk;
+      if (!VALID_MILKS.includes(selectedMilk)) {
+        return {
+          error: `Unsupported milk option "${milk}".`,
+          supportedMilks: VALID_MILKS
+        };
+      }
+
+      const parsedQty = Number(quantity);
+      if (!Number.isInteger(parsedQty) || parsedQty < 1 || parsedQty > 10) {
+        return {
+          error: 'Quantity must be a whole number between 1 and 10.'
+        };
+      }
+
+      const sizeUpcharge = normalizedSize === 'large' ? 0.75 : normalizedSize === 'small' ? -0.5 : 0;
+      const unitPrice = Number((drink.price + sizeUpcharge).toFixed(2));
+      const totalPrice = Number((unitPrice * parsedQty).toFixed(2));
+
+      const orderRecord = {
+        orderId: `ORD-${Date.now()}-${activeOrders.length + 1}`,
+        drinkId: drink.id,
+        drinkName: drink.name,
+        size: normalizedSize,
+        milk: selectedMilk,
+        quantity: parsedQty,
+        unitPrice,
+        totalPrice
+      };
+
+      activeOrders.push(orderRecord);
+      highlightDrinkCard(drink.id);
+      renderOrdersUI();
+      updateStatusBanner(`Added ${parsedQty}x ${ normalizedSize } ${drink.name} ($${totalPrice.toFixed(2)}) to your order.`);
+
+      // Sync the quick order form controls with the latest selection
+      const drinkSelect = document.getElementById('order-drink');
+      const sizeSelect = document.getElementById('order-size');
+      const milkSelect = document.getElementById('order-milk');
+      const qtyInput = document.getElementById('order-quantity');
+      if (drinkSelect) drinkSelect.value = drink.id;
+      if (sizeSelect) sizeSelect.value = normalizedSize;
+      if (milkSelect) milkSelect.value = selectedMilk;
+      if (qtyInput) qtyInput.value = String(parsedQty);
+
+      return {
+        status: 'confirmed',
+        order: orderRecord,
+        activeOrderCount: activeOrders.length
+      };
+    }
+
+    // Handle Declarative WebMCP Form submissions
+    const orderForm = document.getElementById('drink-order-form');
+    if (orderForm) {
+      orderForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(orderForm);
+        const result = addOrderToState({
+          drinkInput: formData.get('drinkId'),
+          size: formData.get('size') || 'medium',
+          milk: formData.get('milk') || 'oat',
+          quantity: Number(formData.get('quantity') || 1)
+        });
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(result));
+        }
+      });
+    }
+
+    // Register Imperative WebMCP tools with feature detection and AbortController lifecycle
+    const webMcpController = new AbortController();
+
+    async function registerDailyGrindWebMCPTools() {
+      if (!('modelContext' in document) || !document.modelContext) {
+        return;
+      }
+
+      const targetFor = (type, listener, options) =>
+        (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+          .addEventListener(type, listener, options);
+
+      targetFor('toolactivated', ({ toolName }) => {
+        updateStatusBanner(`AI agent is running tool "${toolName}"...`);
+      }, { signal: webMcpController.signal });
+
+      targetFor('toolcancel', ({ toolName }) => {
+        updateStatusBanner(`AI agent cancelled tool "${toolName}".`);
+      }, { signal: webMcpController.signal });
+
+      // 1. Query Tool: Read-only access to the Seasonal Favorites coffee menu
+      await document.modelContext.registerTool({
+        name: 'query_seasonal_menu',
+        description: 'Queries the Seasonal Favorites coffee menu on the Daily Grind homepage. Use when the user asks about available seasonal drinks, descriptions, caffeine content, or prices.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            search: {
+              type: 'string',
+              description: 'Keyword to filter seasonal drinks by name or flavor description.'
+            },
+            maxPrice: {
+              type: 'number',
+              minimum: 0,
+              description: 'Upper price limit in USD for filtering drinks.'
+            }
+          }
+        },
+        execute(input = {}) {
+          const { search, maxPrice } = input;
+          if (maxPrice !== undefined && (typeof maxPrice !== 'number' || Number.isNaN(maxPrice) || maxPrice < 0)) {
+            return { error: 'Pass a non-negative number for maxPrice.' };
+          }
+
+          let results = [...SEASONAL_MENU];
+          if (typeof search === 'string' && search.trim() !== '') {
+            const q = search.trim().toLowerCase();
+            results = results.filter(
+              (item) =>
+                item.name.toLowerCase().includes(q) ||
+                item.description.toLowerCase().includes(q) ||
+                item.category.toLowerCase().includes(q)
+            );
+          }
+
+          if (typeof maxPrice === 'number') {
+            results = results.filter((item) => item.price <= maxPrice);
+          }
+
+          return {
+            totalMatches: results.length,
+            drinks: results
+          };
+        },
+        annotations: { readOnlyHint: true }
+      }, { signal: webMcpController.signal });
+
+      // 2. Interactive Order Tool: Places a customized drink order and updates the page UI
+      await document.modelContext.registerTool({
+        name: 'order_seasonal_drink',
+        description: 'Places an interactive order for a Seasonal Favorites coffee drink and updates the active order tray on the page. Use when the user wants to order a drink.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            drink: {
+              type: 'string',
+              description: 'Name or identifier of the seasonal coffee drink to order.'
+            },
+            size: {
+              type: 'string',
+              enum: VALID_SIZES,
+              default: 'medium',
+              description: 'Cup size for the beverage.'
+            },
+            milk: {
+              type: 'string',
+              enum: VALID_MILKS,
+              description: 'Milk option to prepare the drink with.'
+            },
+            quantity: {
+              type: 'number',
+              minimum: 1,
+              maximum: 10,
+              default: 1,
+              description: 'Number of cups to order.'
+            }
+          },
+          required: ['drink']
+        },
+        execute(input = {}) {
+          const { drink, size = 'medium', milk, quantity = 1 } = input;
+          if (typeof drink !== 'string' || !drink.trim()) {
+            return {
+              error: 'Provide a drink name or identifier to place an order.',
+              availableDrinks: SEASONAL_MENU.map((d) => ({ id: d.id, name: d.name }))
+            };
+          }
+          return addOrderToState({ drinkInput: drink, size, milk, quantity });
+        },
+        annotations: {
+          readOnlyHint: false,
+          consequentialHint: true,
+          untrustedContentHint: false
+        }
+      }, { signal: webMcpController.signal });
+
+      // 3. UI Update Tool: Highlights a seasonal drink card on the page
+      await document.modelContext.registerTool({
+        name: 'highlight_seasonal_drink',
+        description: 'Highlights a Seasonal Favorites coffee card on the homepage and updates the status banner. Use when the user wants to visually spotlight or focus on a specific drink on the page.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            drink: {
+              type: 'string',
+              description: 'Name or identifier of the seasonal drink to spotlight on the page.'
+            }
+          },
+          required: ['drink']
+        },
+        execute(input = {}) {
+          const matchedDrink = findDrink(input.drink);
+          if (!matchedDrink) {
+            return {
+              error: `Seasonal drink "${input.drink}" not found.`,
+              availableDrinks: SEASONAL_MENU.map((d) => ({ id: d.id, name: d.name }))
+            };
+          }
+
+          const card = highlightDrinkCard(matchedDrink.id);
+          if (card) {
+            card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+          }
+          updateStatusBanner(`Spotlighting "${matchedDrink.name}" — ${matchedDrink.description}`);
+
+          return {
+            highlightedDrink: matchedDrink,
+            uiUpdated: Boolean(card)
+          };
+        },
+        annotations: {
+          readOnlyHint: false,
+          consequentialHint: false,
+          untrustedContentHint: false
+        }
+      }, { signal: webMcpController.signal });
+    }
+
+    registerDailyGrindWebMCPTools();
+    window.addEventListener('pagehide', () => webMcpController.abort(), { once: true });
+  </script>
 </body>
 
