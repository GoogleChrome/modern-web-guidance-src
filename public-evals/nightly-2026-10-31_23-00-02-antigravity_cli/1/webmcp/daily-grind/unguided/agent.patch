+  <script>
+    (function () {
+      const SEASONAL_MENU = [
+        {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          category: 'seasonal',
+          price: 5.50,
+          calories: 210,
+          defaultMilk: 'Oat',
+          sizes: ['Small', 'Medium', 'Large'],
+          available: true,
+          url: '/menu/seasonal'
+        },
+        {
+          id: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          category: 'espresso',
+          price: 3.75,
+          calories: 15,
+          defaultMilk: 'None',
+          sizes: ['Small', 'Medium', 'Large'],
+          available: true,
+          url: '/menu/espresso'
+        },
+        {
+          id: 'cold-brew',
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          category: 'cold-brew',
+          price: 4.50,
+          calories: 25,
+          defaultMilk: 'None',
+          sizes: ['Small', 'Medium', 'Large'],
+          available: true,
+          url: '/menu/cold-brew'
+        }
+      ];
+
+      const state = {
+        menu: SEASONAL_MENU,
+        orders: [],
+        lastOrderConfirmation: null
+      };
+
+      function showStatusBanner(message) {
+        const banner = document.getElementById('agent-status-banner');
+        if (!banner) return;
+        banner.textContent = message;
+        banner.classList.add('visible');
+      }
+
+      function findDrink(query) {
+        if (!query) return null;
+        const normalized = String(query).trim().toLowerCase();
+        return (
+          state.menu.find(
+            (item) =>
+              item.id.toLowerCase() === normalized ||
+              item.name.toLowerCase() === normalized ||
+              item.category.toLowerCase() === normalized
+          ) ||
+          state.menu.find(
+            (item) =>
+              item.name.toLowerCase().includes(normalized) ||
+              item.description.toLowerCase().includes(normalized)
+          ) ||
+          null
+        );
+      }
+
+      function renderCart() {
+        const listEl = document.getElementById('cart-items');
+        const totalEl = document.getElementById('cart-total');
+        const badgeEl = document.getElementById('nav-cart-count');
+
+        if (!listEl || !totalEl || !badgeEl) return;
+
+        const totalCups = state.orders.reduce((sum, item) => sum + item.quantity, 0);
+        badgeEl.textContent = String(totalCups);
+
+        if (state.orders.length === 0) {
+          listEl.innerHTML = '<li class="cart-empty" style="color: #777; font-style: italic;">No drinks ordered yet.</li>';
+          totalEl.textContent = 'Total: $0.00';
+          return;
+        }
+
+        listEl.innerHTML = state.orders
+          .map(
+            (order) => `
+            <li class="cart-item" data-order-id="${order.orderId}">
+              <div>
+                <strong>${order.quantity}x ${order.drinkName}</strong> (${order.size}, ${order.milk} Milk)
+                ${order.customerName ? `<div style="font-size: 0.8rem; color: #666;">Note: ${order.customerName}</div>` : ''}
+              </div>
+              <span>$${order.subtotal.toFixed(2)}</span>
+            </li>
+          `
+          )
+          .join('');
+
+        const totalCost = state.orders.reduce((sum, item) => sum + item.subtotal, 0);
+        totalEl.textContent = `Total: $${totalCost.toFixed(2)}`;
+      }
+
+      function highlightDrinkCard(drinkIdOrName, statusMessage) {
+        const drink = findDrink(drinkIdOrName);
+        const cards = document.querySelectorAll('.card[data-drink-id]');
+        cards.forEach((card) => card.classList.remove('highlighted'));
+
+        if (drink) {
+          const targetCard = document.querySelector(`.card[data-drink-id="${drink.id}"]`);
+          if (targetCard) {
+            targetCard.classList.add('highlighted');
+          }
+          const drinkSelect = document.getElementById('order-drink');
+          if (drinkSelect) {
+            drinkSelect.value = drink.name;
+          }
+        }
+
+        if (statusMessage) {
+          showStatusBanner(statusMessage);
+        } else if (drink) {
+          showStatusBanner(`Selected "${drink.name}" — ${drink.description} ($${drink.price.toFixed(2)})`);
+        }
+
+        return drink;
+      }
+
+      function placeDrinkOrder({ drinkName, size = 'Medium', milk, quantity = 1, customerName = '' }) {
+        const drink = findDrink(drinkName);
+        if (!drink) {
+          const availableNames = state.menu.map((d) => d.name).join(', ');
+          throw new Error(`Drink "${drinkName}" not found on the Seasonal Favorites menu. Available drinks: ${availableNames}`);
+        }
+
+        const normalizedSize = ['Small', 'Medium', 'Large'].find(
+          (s) => s.toLowerCase() === String(size || 'Medium').toLowerCase()
+        ) || 'Medium';
+
+        const resolvedMilk = milk || drink.defaultMilk || 'Oat';
+        const qty = Math.max(1, parseInt(quantity, 10) || 1);
+        const sizeUpcharge = normalizedSize === 'Large' ? 0.75 : 0;
+        const unitPrice = drink.price + sizeUpcharge;
+        const subtotal = Number((unitPrice * qty).toFixed(2));
+
+        const orderItem = {
+          orderId: `ORD-${Date.now()}-${Math.floor(Math.random() * 1000)}`,
+          drinkId: drink.id,
+          drinkName: drink.name,
+          size: normalizedSize,
+          milk: resolvedMilk,
+          quantity: qty,
+          customerName: customerName ? String(customerName).trim() : '',
+          unitPrice,
+          subtotal,
+          timestamp: new Date().toISOString()
+        };
+
+        state.orders.push(orderItem);
+
+        // Sync form inputs & UI
+        const drinkSelect = document.getElementById('order-drink');
+        const sizeSelect = document.getElementById('order-size');
+        const milkSelect = document.getElementById('order-milk');
+        const qtyInput = document.getElementById('order-quantity');
+        const customerInput = document.getElementById('order-customer');
+
+        if (drinkSelect) drinkSelect.value = drink.name;
+        if (sizeSelect) sizeSelect.value = normalizedSize;
+        if (milkSelect && ['Oat', 'Whole', 'Almond', 'Skim', 'None'].includes(resolvedMilk)) {
+          milkSelect.value = resolvedMilk;
+        }
+        if (qtyInput) qtyInput.value = String(qty);
+        if (customerInput && customerName !== undefined) customerInput.value = String(customerName);
+
+        highlightDrinkCard(drink.id, `Added ${qty}x ${normalizedSize} ${drink.name} (${resolvedMilk}) to your order ($${subtotal.toFixed(2)}).`);
+        renderCart();
+
+        return orderItem;
+      }
+
+      function checkoutOrder(customerName) {
+        if (state.orders.length === 0) {
+          showStatusBanner('Your cart is empty! Add a seasonal favorite drink before checking out.');
+          return {
+            success: false,
+            message: 'Cart is empty. Please add a drink order first.'
+          };
+        }
+
+        const totalAmount = Number(
+          state.orders.reduce((sum, item) => sum + item.subtotal, 0).toFixed(2)
+        );
+        const totalCups = state.orders.reduce((sum, item) => sum + item.quantity, 0);
+        const confirmationId = `DG-${Math.floor(100000 + Math.random() * 900000)}`;
+
+        const confirmation = {
+          success: true,
+          confirmationId,
+          customerName: customerName || state.orders[0]?.customerName || 'Guest',
+          items: [...state.orders],
+          totalCups,
+          totalAmount,
+          status: 'Preparing',
+          message: `Order ${confirmationId} confirmed! Preparing ${totalCups} drink(s) — Total: $${totalAmount.toFixed(2)}.`
+        };
+
+        state.lastOrderConfirmation = confirmation;
+        state.orders = [];
+        renderCart();
+        showStatusBanner(confirmation.message);
+
+        return confirmation;
+      }
+
+      function clearOrders() {
+        state.orders = [];
+        renderCart();
+        showStatusBanner('Order cart has been cleared.');
+        return { success: true, message: 'Order cart cleared.', orders: [] };
+      }
+
+      function quickOrder(drinkName) {
+        return placeDrinkOrder({ drinkName, size: 'Medium', quantity: 1 });
+      }
+
+      // Wire up interactive form submission
+      const orderForm = document.getElementById('drink-order-form');
+      if (orderForm) {
+        orderForm.addEventListener('submit', function (event) {
+          event.preventDefault();
+          const formData = new FormData(orderForm);
+          placeDrinkOrder({
+            drinkName: formData.get('drinkName'),
+            size: formData.get('size'),
+            milk: formData.get('milk'),
+            quantity: Number(formData.get('quantity') || 1),
+            customerName: formData.get('customerName') || ''
+          });
+        });
+      }
+
+      // Define WebMCP Tools
+      const webMcpTools = [
+        {
+          name: 'get_seasonal_favorites_menu',
+          description: 'Query The Daily Grind "Seasonal Favorites" coffee menu. Returns drink names, descriptions, prices, calories, categories, and available options.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              search: {
+                type: 'string',
+                description: 'Optional keyword or drink name filter (e.g., "maple", "espresso", "cold brew").'
+              },
+              category: {
+                type: 'string',
+                enum: ['all', 'seasonal', 'espresso', 'cold-brew'],
+                description: 'Optional category filter.'
+              },
+              maxPrice: {
+                type: 'number',
+                description: 'Optional maximum price filter in USD.'
+              }
+            }
+          },
+          execute: async (args = {}) => {
+            const { search, category, maxPrice } = args || {};
+            let items = [...state.menu];
+
+            if (category && category !== 'all') {
+              items = items.filter((item) => item.category.toLowerCase() === String(category).toLowerCase());
+            }
+
+            if (search) {
+              const q = String(search).trim().toLowerCase();
+              items = items.filter(
+                (item) =>
+                  item.name.toLowerCase().includes(q) ||
+                  item.description.toLowerCase().includes(q) ||
+                  item.id.toLowerCase().includes(q)
+              );
+            }
+
+            if (typeof maxPrice === 'number' && !Number.isNaN(maxPrice)) {
+              items = items.filter((item) => item.price <= maxPrice);
+            }
+
+            const payload = {
+              success: true,
+              count: items.length,
+              items
+            };
+
+            return {
+              ...payload,
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify(payload, null, 2)
+                }
+              ]
+            };
+          }
+        },
+        {
+          name: 'order_drink',
+          description: 'Trigger an interactive drink order on the page from the Seasonal Favorites coffee menu, updating the order form and cart UI.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drinkName: {
+                type: 'string',
+                description: 'Name or ID of the drink to order (e.g., "Maple Oat Latte", "Dark Roast Espresso", "Cold Brew").'
+              },
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Cup size (Small, Medium, or Large). Defaults to Medium.'
+              },
+              milk: {
+                type: 'string',
+                enum: ['Oat', 'Whole', 'Almond', 'Skim', 'None'],
+                description: 'Milk choice for the drink.'
+              },
+              quantity: {
+                type: 'number',
+                description: 'Number of drinks to order (defaults to 1).'
+              },
+              customerName: {
+                type: 'string',
+                description: 'Optional customer name or special order note.'
+              },
+              autoCheckout: {
+                type: 'boolean',
+                description: 'If true, immediately completes checkout after adding the drink to the cart.'
+              }
+            },
+            required: ['drinkName']
+          },
+          execute: async (args = {}) => {
+            try {
+              const orderItem = placeDrinkOrder({
+                drinkName: args.drinkName,
+                size: args.size || 'Medium',
+                milk: args.milk,
+                quantity: args.quantity || 1,
+                customerName: args.customerName || ''
+              });
+
+              let checkoutResult = null;
+              if (args.autoCheckout) {
+                checkoutResult = checkoutOrder(args.customerName);
+              }
+
+              const totalAmount = Number(
+                state.orders.reduce((sum, item) => sum + item.subtotal, 0).toFixed(2)
+              );
+
+              const payload = {
+                success: true,
+                order: orderItem,
+                checkout: checkoutResult,
+                cartOrders: [...state.orders],
+                cartTotal: totalAmount,
+                message: checkoutResult
+                  ? checkoutResult.message
+                  : `Ordered ${orderItem.quantity}x ${orderItem.size} ${orderItem.drinkName} ($${orderItem.subtotal.toFixed(2)}).`
+              };
+
+              return {
+                ...payload,
+                content: [
+                  {
+                    type: 'text',
+                    text: JSON.stringify(payload, null, 2)
+                  }
+                ]
+              };
+            } catch (err) {
+              const errorPayload = {
+                success: false,
+                error: err.message
+              };
+              return {
+                ...errorPayload,
+                content: [
+                  {
+                    type: 'text',
+                    text: JSON.stringify(errorPayload, null, 2)
+                  }
+                ]
+              };
+            }
+          }
+        },
+        {
+          name: 'update_page_ui',
+          description: 'Trigger interactive UI updates on The Daily Grind homepage, such as highlighting a specific seasonal drink card, filtering visible menu cards, displaying a status banner message, or completing/clearing the order cart.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              action: {
+                type: 'string',
+                enum: ['highlight_drink', 'filter_menu', 'show_banner', 'checkout', 'clear_cart', 'reset_ui'],
+                description: 'The UI update action to perform on the page.'
+              },
+              drinkName: {
+                type: 'string',
+                description: 'Drink name or ID to highlight or select (used with highlight_drink).'
+              },
+              category: {
+                type: 'string',
+                enum: ['all', 'seasonal', 'espresso', 'cold-brew'],
+                description: 'Category of menu cards to display (used with filter_menu).'
+              },
+              message: {
+                type: 'string',
+                description: 'Custom status message to display in the page banner.'
+              }
+            },
+            required: ['action']
+          },
+          execute: async (args = {}) => {
+            const { action, drinkName, category, message } = args || {};
+            let result = { success: true, action };
+
+            if (action === 'highlight_drink') {
+              const drink = highlightDrinkCard(drinkName, message);
+              if (!drink) {
+                result = {
+                  success: false,
+                  action,
+                  error: `Could not find drink matching "${drinkName}" to highlight.`
+                };
+              } else {
+                result.highlightedDrink = drink;
+                result.message = message || `Highlighted ${drink.name} on the page.`;
+              }
+            } else if (action === 'filter_menu') {
+              const targetCategory = (category || 'all').toLowerCase();
+              const cards = document.querySelectorAll('.card[data-drink-id]');
+              let visibleCount = 0;
+              cards.forEach((card) => {
+                const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
+                const show = targetCategory === 'all' || cardCat === targetCategory;
+                card.style.display = show ? '' : 'none';
+                if (show) visibleCount++;
+              });
+              const statusMsg = message || `Filtered Seasonal Favorites menu to "${targetCategory}" (${visibleCount} item(s) shown).`;
+              showStatusBanner(statusMsg);
+              result.category = targetCategory;
+              result.visibleCount = visibleCount;
+              result.message = statusMsg;
+            } else if (action === 'show_banner') {
+              const bannerText = message || 'Welcome to The Daily Grind!';
+              showStatusBanner(bannerText);
+              result.message = bannerText;
+            } else if (action === 'checkout') {
+              result = { ...result, ...checkoutOrder(message) };
+            } else if (action === 'clear_cart') {
+              result = { ...result, ...clearOrders() };
+            } else if (action === 'reset_ui') {
+              const cards = document.querySelectorAll('.card[data-drink-id]');
+              cards.forEach((card) => {
+                card.classList.remove('highlighted');
+                card.style.display = '';
+              });
+              const banner = document.getElementById('agent-status-banner');
+              if (banner) {
+                banner.textContent = '';
+                banner.classList.remove('visible');
+              }
+              result.message = 'Page UI reset to default state.';
+            } else {
+              result = {
+                success: false,
+                error: `Unsupported UI action: ${action}`
+              };
+            }
+
+            return {
+              ...result,
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify(result, null, 2)
+                }
+              ]
+            };
+          }
+        },
+        {
+          name: 'get_order_status',
+          description: 'Get the current drink order cart items, total price, and most recent order confirmation on the page.',
+          inputSchema: {
+            type: 'object',
+            properties: {}
+          },
+          execute: async () => {
+            const totalAmount = Number(
+              state.orders.reduce((sum, item) => sum + item.subtotal, 0).toFixed(2)
+            );
+            const payload = {
+              success: true,
+              orders: [...state.orders],
+              totalCups: state.orders.reduce((sum, item) => sum + item.quantity, 0),
+              totalAmount,
+              lastOrderConfirmation: state.lastOrderConfirmation
+            };
+            return {
+              ...payload,
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify(payload, null, 2)
+                }
+              ]
+            };
+          }
+        }
+      ];
+
+      // Expose application state & helpers globally
+      window.DailyGrindApp = {
+        state,
+        getMenu: () => [...state.menu],
+        quickOrder,
+        placeDrinkOrder,
+        highlightDrinkCard,
+        checkoutOrder,
+        clearOrders,
+        tools: webMcpTools
+      };
+
+      // Register WebMCP tools on navigator.modelContext (with fallback polyfill if not natively present)
+      function initWebMCP() {
+        const toolRegistry = new Map();
+
+        if (!('modelContext' in navigator) || !navigator.modelContext) {
+          const fallbackModelContext = {
+            get tools() {
+              return Array.from(toolRegistry.values());
+            },
+            registerTool(tool) {
+              if (tool && tool.name) {
+                toolRegistry.set(tool.name, tool);
+              }
+            },
+            unregisterTool(name) {
+              toolRegistry.delete(name);
+            },
+            provideContext(context) {
+              toolRegistry.clear();
+              if (context && Array.isArray(context.tools)) {
+                context.tools.forEach((tool) => {
+                  if (tool && tool.name) {
+                    toolRegistry.set(tool.name, tool);
+                  }
+                });
+              }
+            },
+            clearContext() {
+              toolRegistry.clear();
+            },
+            executeTool: async (name, args) => {
+              const tool = toolRegistry.get(name);
+              if (!tool || typeof tool.execute !== 'function') {
+                throw new Error(`WebMCP tool "${name}" is not registered.`);
+              }
+              return await tool.execute(args);
+            }
+          };
+
+          try {
+            Object.defineProperty(navigator, 'modelContext', {
+              value: fallbackModelContext,
+              configurable: true,
+              writable: true
+            });
+          } catch (e) {
+            navigator.modelContext = fallbackModelContext;
+          }
+        }
+
+        const mc = navigator.modelContext;
+        if (mc) {
+          if (typeof mc.provideContext === 'function') {
+            try {
+              mc.provideContext({ tools: webMcpTools });
+            } catch (e) {
+              // If provideContext fails or has different signature, fall back to registerTool
+            }
+          }
+          if (typeof mc.registerTool === 'function') {
+            webMcpTools.forEach((tool) => {
+              try {
+                mc.registerTool(tool);
+              } catch (e) {
+                // Ignore duplicate registration errors if provideContext already registered the tool
+              }
+            });
+          }
+        }
+      }
+
+      initWebMCP();
+    })();
+  </script>
 </body>
 
