+  <script>
+    (function () {
+      const navList = document.querySelector('nav ul');
+      const indicator = document.querySelector('.nav-indicator');
+      const navLinks = Array.from(document.querySelectorAll('nav ul li a:not(.logout-link)'));
+      const logoutLink = document.querySelector('nav ul li a.logout-link');
+
+      function updateIndicator(targetLink) {
+        if (!targetLink || !navList || !indicator) return;
+        const listRect = navList.getBoundingClientRect();
+        const linkRect = targetLink.getBoundingClientRect();
+        const left = linkRect.width > 0 ? linkRect.left - listRect.left : targetLink.offsetLeft;
+        const width = linkRect.width > 0 ? linkRect.width : targetLink.offsetWidth;
+        indicator.style.left = `${left}px`;
+        indicator.style.width = `${width}px`;
+      }
+
+      function setActiveLink(selectedLink) {
+        navLinks.forEach((link) => {
+          const isSelected = link === selectedLink;
+          link.classList.toggle('active', isSelected);
+          if (link.parentElement) {
+            link.parentElement.classList.toggle('active', isSelected);
+          }
+          if (isSelected) {
+            link.setAttribute('aria-current', 'page');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+        updateIndicator(selectedLink);
+      }
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', (e) => {
+          e.preventDefault();
+          setActiveLink(link);
+        });
+        if (link.parentElement) {
+          link.parentElement.addEventListener('click', (e) => {
+            if (e.target !== link) {
+              e.preventDefault();
+              setActiveLink(link);
+            }
+          });
+        }
+      });
+
+      if (logoutLink) {
+        logoutLink.addEventListener('click', (e) => {
+          e.preventDefault();
+        });
+      }
+
+      const initialActive = document.querySelector('nav ul li a.active:not(.logout-link)') || navLinks[0];
+      if (initialActive) {
+        setActiveLink(initialActive);
+      }
+
+      window.addEventListener('load', () => {
+        const currentActive = document.querySelector('nav ul li a.active:not(.logout-link)');
+        if (currentActive) updateIndicator(currentActive);
+      });
+
+      window.addEventListener('resize', () => {
+        const currentActive = document.querySelector('nav ul li a.active:not(.logout-link)');
+        if (currentActive) updateIndicator(currentActive);
+      });
+    })();
+  </script>
 </body>
 
