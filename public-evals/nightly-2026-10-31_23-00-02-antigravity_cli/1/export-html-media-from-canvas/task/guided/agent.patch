+  <script src="https://cdn.jsdelivr.net/npm/three-html-render/dist/polyfill.js"></script>
+  <script>
+    (function () {
+      const canvas = document.getElementById('gift-card-canvas');
+      const exportElement = document.getElementById('export_element');
+      const downloadBtn = document.getElementById('download-card-btn');
+      const messageControl = document.getElementById('card-message-control');
+      const nameControl = document.getElementById('card-name-control');
+      const inlineMessage = document.getElementById('inline-card-message');
+      const inlineRecipient = document.getElementById('inline-card-recipient');
+      const bgColorInput = document.getElementById('card-bg-color');
+      const swatchBtns = document.querySelectorAll('.swatch-btn');
+      const supportWarning = document.getElementById('canvas-support-warning');
+
+      // 1. Check browser support for the HTML-in-Canvas API before using it
+      let supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+      if (!supportsHtmlInCanvas && typeof window.installHtmlInCanvasPolyfill === 'function') {
+        window.installHtmlInCanvasPolyfill();
+        supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+      }
+
+      const ctx = canvas.getContext('2d');
+
+      function requestCanvasPaint() {
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+      }
+
+      if (supportsHtmlInCanvas) {
+        // 2. Render the HTML content to the canvas inside a canvas.onpaint event handler
+        canvas.onpaint = (event) => {
+          ctx.reset();
+          // Draw #export_element into the 2D context at (0, 0).
+          // In 2D context, drawElementImage automatically synchronizes the DOM element geometry.
+          ctx.drawElementImage(exportElement, 0, 0);
+        };
+
+        // 3. Use ResizeObserver to observe the canvas size and update backing store to match device pixels
+        const observer = new ResizeObserver(([entry]) => {
+          const dpc = entry.devicePixelContentBoxSize;
+          canvas.width = dpc
+            ? dpc[0].inlineSize
+            : Math.round(entry.contentRect.width * window.devicePixelRatio);
+          canvas.height = dpc
+            ? dpc[0].blockSize
+            : Math.round(entry.contentRect.height * window.devicePixelRatio);
+          requestCanvasPaint();
+        });
+
+        const supportsDevicePixelContentBox =
+          typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        const options = supportsDevicePixelContentBox
+          ? { box: 'device-pixel-content-box' }
+          : {};
+        observer.observe(canvas, options);
+      } else {
+        // Fallback when HTML-in-Canvas is not supported in the browser
+        supportWarning.style.display = 'block';
+        supportWarning.textContent =
+          'Your browser does not natively support the HTML-in-Canvas API (Chrome 157+); using fallback preview and canvas export.';
+        canvas.parentNode.insertBefore(exportElement, canvas);
+        canvas.style.display = 'none';
+      }
+
+      // Synchronize external controls and inline card inputs
+      function updateMessage(value) {
+        messageControl.value = value;
+        inlineMessage.value = value;
+        inlineMessage.setAttribute('value', value);
+        requestCanvasPaint();
+      }
+
+      function updateRecipient(value) {
+        nameControl.value = value;
+        inlineRecipient.value = value;
+        inlineRecipient.setAttribute('value', value);
+        requestCanvasPaint();
+      }
+
+      function updateBackgroundColor(color) {
+        exportElement.style.backgroundColor = color;
+        bgColorInput.value = color;
+        swatchBtns.forEach((btn) => {
+          btn.classList.toggle('active', btn.dataset.color.toLowerCase() === color.toLowerCase());
+        });
+        requestCanvasPaint();
+      }
+
+      messageControl.addEventListener('input', (e) => updateMessage(e.target.value));
+      inlineMessage.addEventListener('input', (e) => updateMessage(e.target.value));
+
+      nameControl.addEventListener('input', (e) => updateRecipient(e.target.value));
+      inlineRecipient.addEventListener('input', (e) => updateRecipient(e.target.value));
+
+      bgColorInput.addEventListener('input', (e) => updateBackgroundColor(e.target.value));
+      swatchBtns.forEach((btn) => {
+        btn.addEventListener('click', () => updateBackgroundColor(btn.dataset.color));
+      });
+
+      // Export & Download button handler
+      downloadBtn.addEventListener('click', () => {
+        if (supportsHtmlInCanvas && typeof ctx.drawElementImage === 'function') {
+          ctx.reset();
+          ctx.drawElementImage(exportElement, 0, 0);
+        }
+        const dataURL = canvas.toDataURL('image/png');
+        const link = document.createElement('a');
+        link.download = 'daily-grind-gift-card.png';
+        link.href = dataURL;
+        link.click();
+      });
+    })();
+  </script>
