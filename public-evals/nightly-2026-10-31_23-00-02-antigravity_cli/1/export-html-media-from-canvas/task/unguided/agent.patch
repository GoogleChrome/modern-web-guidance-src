+  <script>
+    (function () {
+      const canvas = document.getElementById('gift-card-canvas');
+      const exportElement = document.getElementById('export_element');
+      const messageInput = document.getElementById('card-message-input');
+      const bgColorInput = document.getElementById('card-bg-color');
+      const colorSwatches = document.querySelectorAll('.color-swatch');
+      const exportBtn = document.getElementById('export-card-btn');
+      const messageDisplay = document.getElementById('card-message-display');
+
+      if (!canvas || !exportElement) return;
+      const ctx = canvas.getContext('2d');
+
+      // Cross-version drawable attribute initialization
+      if (!canvas.hasAttribute('content') && !canvas.hasAttribute('layoutsubtree')) {
+        if ('content' in HTMLCanvasElement.prototype) {
+          canvas.setAttribute('content', 'drawable');
+        } else {
+          canvas.setAttribute('layoutsubtree', '');
+        }
+      } else if ('content' in HTMLCanvasElement.prototype) {
+        canvas.setAttribute('content', 'drawable');
+      }
+      if (!exportElement.hasAttribute('drawable')) {
+        exportElement.setAttribute('drawable', '');
+      }
+
+      // Feature detection for HTML-in-Canvas API
+      function supportsHtmlInCanvas() {
+        return Boolean(
+          ctx &&
+          ('drawElementImage' in CanvasRenderingContext2D.prototype || typeof ctx.drawElementImage === 'function') &&
+          ('onpaint' in HTMLCanvasElement.prototype || 'onpaint' in canvas || typeof canvas.requestPaint === 'function')
+        );
+      }
+
+      // Render #export_element into the 2D canvas context
+      function drawCardElement() {
+        if (!ctx) return;
+
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        if (typeof ctx.drawElementImage === 'function') {
+          const result = ctx.drawElementImage(exportElement, 0, 0);
+          // Cross-version compatibility: Chrome < 155 returns a DOMMatrix for transform sync;
+          // Chrome 155+ returns void and synchronizes hit-testing/a11y bounds automatically.
+          if (result !== undefined && typeof result?.toString === 'function') {
+            exportElement.style.transform = result.toString();
+          }
+        } else {
+          // Graceful 2D fallback when experimental HTML-in-Canvas flag is disabled
+          const dpr = window.devicePixelRatio || 1;
+          const w = canvas.width / dpr;
+          const h = canvas.height / dpr;
+          ctx.save();
+          ctx.scale(dpr, dpr);
+          ctx.fillStyle = exportElement.style.backgroundColor || '#4e342e';
+          ctx.beginPath();
+          if (typeof ctx.roundRect === 'function') {
+            ctx.roundRect(0, 0, w, h, 16);
+          } else {
+            ctx.rect(0, 0, w, h);
+          }
+          ctx.fill();
+          ctx.strokeStyle = 'rgba(255, 171, 64, 0.4)';
+          ctx.lineWidth = 4;
+          ctx.stroke();
+
+          ctx.fillStyle = '#ffab40';
+          ctx.font = 'bold 18px "Segoe UI", sans-serif';
+          ctx.fillText('THE DAILY GRIND', 32, 48);
+
+          ctx.fillStyle = '#ffffff';
+          ctx.font = 'bold 15px "Segoe UI", sans-serif';
+          ctx.fillText('$25 GIFT CARD', w - 150, 48);
+
+          ctx.font = '600 23px "Segoe UI", sans-serif';
+          ctx.fillText(messageDisplay.textContent || 'Enjoy a warm cup on me!', 32, h / 2);
+
+          ctx.fillStyle = '#d7ccc8';
+          ctx.font = 'italic 16px "Segoe UI", sans-serif';
+          ctx.fillText('Handcrafted Coffee & Espresso', 32, h / 2 + 32);
+
+          ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
+          ctx.font = '12px "Segoe UI", sans-serif';
+          ctx.fillText('ARTISANAL COFFEE CO. • REDEEMABLE IN-STORE & ONLINE', 32, h - 28);
+          ctx.restore();
+        }
+      }
+
+      // Synchronize rendering with the canvas paint event
+      canvas.onpaint = () => {
+        drawCardElement();
+      };
+
+      function requestCardPaint() {
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          drawCardElement();
+        }
+      }
+
+      // Keep canvas pixel dimensions aligned with devicePixelRatio
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(([entry]) => {
+          const dpc = entry.devicePixelContentBoxSize;
+          const dpr = window.devicePixelRatio || 1;
+          const width = dpc
+            ? dpc[0].inlineSize
+            : Math.round((entry.contentRect.width || 500) * dpr);
+          const height = dpc
+            ? dpc[0].blockSize
+            : Math.round((entry.contentRect.height || 300) * dpr);
+          if (width > 0 && height > 0) {
+            canvas.width = width;
+            canvas.height = height;
+          }
+          requestCardPaint();
+        });
+        const supportsDPC =
+          typeof ResizeObserverEntry !== 'undefined' &&
+          'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        observer.observe(canvas, supportsDPC ? { box: 'device-pixel-content-box' } : {});
+      }
+
+      // Live updates when user types a custom message or name
+      const handleMessageUpdate = (event) => {
+        messageDisplay.textContent = event.target.value || 'Enjoy a warm cup on me!';
+        requestCardPaint();
+      };
+      messageInput.addEventListener('input', handleMessageUpdate);
+      messageInput.addEventListener('change', handleMessageUpdate);
+
+      // Live updates when user selects a background color
+      function updateCardBackground(color) {
+        exportElement.style.backgroundColor = color;
+        bgColorInput.value = color;
+        colorSwatches.forEach((swatch) => {
+          swatch.classList.toggle('active', swatch.dataset.color.toLowerCase() === color.toLowerCase());
+        });
+        requestCardPaint();
+      }
+
+      bgColorInput.addEventListener('input', (event) => {
+        updateCardBackground(event.target.value);
+      });
+      bgColorInput.addEventListener('change', (event) => {
+        updateCardBackground(event.target.value);
+      });
+
+      colorSwatches.forEach((swatch) => {
+        swatch.addEventListener('click', () => {
+          updateCardBackground(swatch.dataset.color);
+        });
+        swatch.addEventListener('keydown', (event) => {
+          if (event.key === 'Enter' || event.key === ' ') {
+            event.preventDefault();
+            updateCardBackground(swatch.dataset.color);
+          }
+        });
+      });
+
+      // Trigger browser download from the rendered canvas
+      function downloadCanvasImage() {
+        const triggerDownload = (href) => {
+          const link = document.createElement('a');
+          link.download = 'daily-grind-gift-card.png';
+          link.href = href;
+          document.body.appendChild(link);
+          link.click();
+          document.body.removeChild(link);
+        };
+
+        if (typeof canvas.toBlob === 'function') {
+          canvas.toBlob((blob) => {
+            if (!blob) {
+              triggerDownload(canvas.toDataURL('image/png'));
+              return;
+            }
+            const blobUrl = URL.createObjectURL(blob);
+            triggerDownload(blobUrl);
+            setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
+          }, 'image/png');
+        } else {
+          triggerDownload(canvas.toDataURL('image/png'));
+        }
+      }
+
+      // Export button handler synchronized with paint event
+      exportBtn.addEventListener('click', () => {
+        if (supportsHtmlInCanvas() && typeof canvas.requestPaint === 'function') {
+          canvas.addEventListener(
+            'paint',
+            () => {
+              drawCardElement();
+              downloadCanvasImage();
+            },
+            { once: true }
+          );
+          canvas.requestPaint();
+        } else {
+          drawCardElement();
+          downloadCanvasImage();
+        }
+      });
+
+      // Initial paint request
+      requestCardPaint();
+    })();
+  </script>
