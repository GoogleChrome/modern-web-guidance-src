+    /* Roast Picker in Hero */
+    .roast-picker-group {
+      display: flex;
+      flex-direction: column;
+      align-items: flex-start;
+      width: 100%;
+      max-width: 320px;
+      margin-top: 1.25rem;
+      margin-bottom: 0.25rem;
+      text-align: left;
+    }
+
+    .roast-picker-group label {
+      font-size: 0.95rem;
+      font-weight: 600;
+      color: var(--light);
+      margin-bottom: 0.4rem;
+      cursor: pointer;
+    }
+
+    select.custom-select,
+    select.custom-select::picker(select) {
+      appearance: base-select;
+    }
+
+    select.custom-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      min-height: 48px;
+      padding: 10px 14px;
+      font-family: inherit;
+      font-size: 1rem;
+      background-color: rgba(62, 39, 35, 0.92);
+      color: var(--light);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      cursor: pointer;
+      transition: border-color 0.2s, background-color 0.2s;
+    }
+
+    @media (pointer: coarse) {
+      select.custom-select {
+        min-height: 52px;
+      }
+    }
+
+    select.custom-select:hover {
+      border-color: var(--accent);
+    }
+
+    select.custom-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    select.custom-select::picker-icon {
+      color: var(--accent);
+    }
+
+    select.custom-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+    }
+
+    select.custom-select selectedcontent .option-desc {
+      display: none;
+    }
+
+    select.custom-select::picker(select) {
+      background-color: #2b1b17;
+      color: var(--light);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 8px;
+      margin-top: 6px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
+      width: anchor-size(width);
+    }
+
+    select.custom-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 12px;
+      border-radius: 6px;
+      color: var(--light);
+      cursor: pointer;
+    }
+
+    select.custom-select option + option {
+      margin-top: 4px;
+    }
+
+    select.custom-select option:hover {
+      background-color: rgba(255, 255, 255, 0.1);
+    }
+
+    select.custom-select option::before,
+    select.custom-select option::checkmark {
+      display: none;
+    }
+
+    select.custom-select option:checked {
+      background-color: var(--accent);
+      color: #2b1b17;
+    }
+
+    select.custom-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    select.custom-select option:checked .option-desc {
+      color: #3e2723;
+    }
+
+    .option-icon {
+      flex-shrink: 0;
+      width: 24px;
+      height: 24px;
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .option-title {
+      font-weight: 600;
+      font-size: 0.95rem;
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      color: var(--secondary);
+    }
+
