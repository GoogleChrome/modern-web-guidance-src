+  <script>
+    (function () {
+      const viewport = document.getElementById('cafe-map-viewport');
+      const surface = document.getElementById('cafe-map-surface');
+      const readout = document.getElementById('map-coords-readout');
+      const resetBtn = document.getElementById('reset-map-view');
+      const chips = document.querySelectorAll('.map-chip[data-cafe-id]');
+      const markers = document.querySelectorAll('.cafe-marker');
+      const selectedName = document.getElementById('selected-cafe-name');
+      const selectedAddress = document.getElementById('selected-cafe-address');
+      const selectedFeature = document.getElementById('selected-cafe-feature');
+
+      if (!viewport || !surface) return;
+
+      let isDragging = false;
+      let hasMoved = false;
+      let lastX = 0;
+      let lastY = 0;
+      let panX = 0;
+      let panY = 0;
+
+      function clampScroll(x, y) {
+        const maxX = Math.max(0, viewport.scrollWidth - viewport.clientWidth);
+        const maxY = Math.max(0, viewport.scrollHeight - viewport.clientHeight);
+        return {
+          x: Math.max(0, Math.min(maxX, x)),
+          y: Math.max(0, Math.min(maxY, y))
+        };
+      }
+
+      function updateReadout() {
+        const x = Math.round(viewport.scrollLeft);
+        const y = Math.round(viewport.scrollTop);
+        viewport.setAttribute('data-scroll-x', String(x));
+        viewport.setAttribute('data-scroll-y', String(y));
+        surface.setAttribute('data-pan-x', String(-x));
+        surface.setAttribute('data-pan-y', String(-y));
+        if (readout) {
+          readout.textContent = 'Pan: X ' + x + ', Y ' + y;
+        }
+      }
+
+      function setMapPosition(x, y) {
+        const clamped = clampScroll(x, y);
+        panX = clamped.x;
+        panY = clamped.y;
+        viewport.scrollLeft = panX;
+        viewport.scrollTop = panY;
+        updateReadout();
+      }
+
+      function centerOnPoint(pointX, pointY) {
+        const targetX = pointX - viewport.clientWidth / 2;
+        const targetY = pointY - viewport.clientHeight / 2;
+        setMapPosition(targetX, targetY);
+      }
+
+      function selectCafe(cafeId, shouldCenter) {
+        markers.forEach(function (marker) {
+          const isMatch = marker.getAttribute('data-cafe-id') === cafeId;
+          marker.classList.toggle('active', isMatch);
+          if (isMatch) {
+            if (selectedName) selectedName.textContent = marker.getAttribute('data-name') || '';
+            if (selectedAddress) selectedAddress.textContent = marker.getAttribute('data-address') || '';
+            if (selectedFeature) selectedFeature.textContent = marker.getAttribute('data-feature') || '';
+            if (shouldCenter) {
+              const x = parseFloat(marker.style.left) || 1200;
+              const y = parseFloat(marker.style.top) || 800;
+              centerOnPoint(x, y);
+            }
+          }
+        });
+
+        chips.forEach(function (chip) {
+          chip.classList.toggle('active', chip.getAttribute('data-cafe-id') === cafeId);
+        });
+      }
+
+      // Initialize map centered around Downtown Roastery (1180, 780) so all 2D directions can be panned immediately
+      centerOnPoint(1180, 780);
+
+      function startDrag(clientX, clientY) {
+        if (!isDragging) {
+          isDragging = true;
+          hasMoved = false;
+          panX = viewport.scrollLeft;
+          panY = viewport.scrollTop;
+          viewport.classList.add('is-panning');
+        }
+        lastX = clientX;
+        lastY = clientY;
+      }
+
+      function moveDrag(clientX, clientY) {
+        if (!isDragging) return;
+        const dx = clientX - lastX;
+        const dy = clientY - lastY;
+        if (dx === 0 && dy === 0) return;
+
+        if (Math.abs(dx) > 2 || Math.abs(dy) > 2) {
+          hasMoved = true;
+        }
+
+        lastX = clientX;
+        lastY = clientY;
+
+        // Update both horizontal and vertical axes simultaneously without locking to a single axis
+        setMapPosition(panX - dx, panY - dy);
+      }
+
+      function endDrag() {
+        if (!isDragging) return;
+        isDragging = false;
+        viewport.classList.remove('is-panning');
+      }
+
+      // Pointer Events
+      viewport.addEventListener('pointerdown', function (e) {
+        if (e.button !== undefined && e.button !== 0) return;
+        startDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointermove', function (e) {
+        if (!isDragging) return;
+        moveDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointerup', endDrag);
+      window.addEventListener('pointercancel', endDrag);
+
+      // Mouse Events (supports both native and synthetic MouseEvent dispatches)
+      viewport.addEventListener('mousedown', function (e) {
+        if (e.button !== 0) return;
+        startDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (!isDragging) return;
+        moveDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', endDrag);
+
+      // Touch Events (supports simultaneous 2D touch panning & mid-gesture direction changes)
+      viewport.addEventListener('touchstart', function (e) {
+        if (e.touches.length === 1) {
+          startDrag(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+
+      window.addEventListener('touchmove', function (e) {
+        if (!isDragging || e.touches.length !== 1) return;
+        if (e.cancelable) {
+          e.preventDefault();
+        }
+        moveDrag(e.touches[0].clientX, e.touches[0].clientY);
+      }, { passive: false });
+
+      window.addEventListener('touchend', endDrag);
+      window.addEventListener('touchcancel', endDrag);
+
+      // Wheel / Trackpad 2D scrolling (supports horizontal, vertical, and diagonal deltaX/deltaY simultaneously)
+      viewport.addEventListener('wheel', function (e) {
+        if (e.cancelable) {
+          e.preventDefault();
+        }
+        setMapPosition(viewport.scrollLeft + e.deltaX, viewport.scrollTop + e.deltaY);
+      }, { passive: false });
+
+      // Sync state on native scroll
+      viewport.addEventListener('scroll', function () {
+        if (!isDragging) {
+          panX = viewport.scrollLeft;
+          panY = viewport.scrollTop;
+        }
+        updateReadout();
+      }, { passive: true });
+
+      // Keyboard 2D navigation when map viewport is focused
+      viewport.addEventListener('keydown', function (e) {
+        const step = 60;
+        let dx = 0;
+        let dy = 0;
+        if (e.key === 'ArrowLeft') dx = -step;
+        else if (e.key === 'ArrowRight') dx = step;
+        else if (e.key === 'ArrowUp') dy = -step;
+        else if (e.key === 'ArrowDown') dy = step;
+        if (dx !== 0 || dy !== 0) {
+          e.preventDefault();
+          setMapPosition(viewport.scrollLeft + dx, viewport.scrollTop + dy);
+        }
+      });
+
+      // Marker clicks
+      markers.forEach(function (marker) {
+        marker.addEventListener('click', function () {
+          if (hasMoved) return;
+          const id = marker.getAttribute('data-cafe-id');
+          if (id) selectCafe(id, false);
+        });
+      });
+
+      // Quick-jump toolbar chips
+      chips.forEach(function (chip) {
+        chip.addEventListener('click', function () {
+          const id = chip.getAttribute('data-cafe-id');
+          if (id) selectCafe(id, true);
+        });
+      });
+
+      if (resetBtn) {
+        resetBtn.addEventListener('click', function () {
+          selectCafe('downtown', true);
+        });
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
