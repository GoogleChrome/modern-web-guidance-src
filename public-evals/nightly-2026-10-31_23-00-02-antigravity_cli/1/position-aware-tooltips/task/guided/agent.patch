+      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
+    }
+
+    .tooltip-content::before {
+      position: absolute;
+      inset-block-end: 0;
+      inset-inline-start: 1rem;
+      color: var(--accent);
+      line-height: 1;
+    }
+
+    @supports (container-type: anchored) {
+      .tooltip-content::before {
+        content: "▼";
