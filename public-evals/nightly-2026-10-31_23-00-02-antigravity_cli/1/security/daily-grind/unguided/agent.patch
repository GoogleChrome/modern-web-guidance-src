+(function () {
+  'use strict';
+
+  // 1. Trusted Types policy to prevent DOM-based XSS
+  if (window.trustedTypes && typeof window.trustedTypes.createPolicy === 'function') {
+    try {
+      if (!window.trustedTypes.defaultPolicy) {
+        window.trustedTypes.createPolicy('default', {
+          createHTML: function (input) {
+            return String(input)
+              .replace(/&/g, '&amp;')
+              .replace(/</g, '&lt;')
+              .replace(/>/g, '&gt;')
+              .replace(/"/g, '&quot;')
+              .replace(/'/g, '&#39;');
+          },
+          createScriptURL: function (input) {
+            const url = new URL(input, window.location.origin);
+            if (url.origin !== window.location.origin) {
+              throw new TypeError('Blocked cross-origin script URL: ' + url.href);
+            }
+            return url.href;
+          },
+          createScript: function () {
+            throw new TypeError('Dynamic script evaluation is disabled by security policy.');
+          }
+        });
+      }
+    } catch (_) {
+      // Default policy already registered or restricted
+    }
+  }
+
+  // 2. Client-side CSP violation monitoring & reporting
+  document.addEventListener('securitypolicyviolation', function (event) {
+    const report = {
+      'csp-report': {
+        'document-uri': event.documentURI,
+        'referrer': event.referrer,
+        'violated-directive': event.violatedDirective,
+        'effective-directive': event.effectiveDirective,
+        'original-policy': event.originalPolicy,
+        'disposition': event.disposition,
+        'blocked-uri': event.blockedURI,
+        'line-number': event.lineNumber,
+        'column-number': event.columnNumber,
+        'source-file': event.sourceFile,
+        'status-code': event.statusCode,
+        'sample': event.sample || ''
+      }
+    };
+
+    const payload = JSON.stringify(report);
+    if (navigator.sendBeacon) {
+      const blob = new Blob([payload], { type: 'application/csp-report' });
+      navigator.sendBeacon('/csp-report', blob);
+    } else if (window.fetch) {
+      window.fetch('/csp-report', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/csp-report' },
+        body: payload,
+        keepalive: true,
+        credentials: 'same-origin'
+      }).catch(function () {});
+    }
+  });
+
+  // 3. DOM hardening & state-changing route protection
+  function initClientSecurity() {
+    // Harden all anchor elements against unsafe protocols and tabnabbing
+    const links = document.querySelectorAll('a[href]');
+    links.forEach(function (link) {
+      const rawHref = link.getAttribute('href') || '';
+      if (/^\s*(javascript|data|vbscript):/i.test(rawHref)) {
+        link.removeAttribute('href');
+        return;
+      }
+
+      try {
+        const parsed = new URL(link.href, window.location.origin);
+        if (parsed.origin !== window.location.origin) {
+          link.setAttribute('rel', 'noopener noreferrer');
+        }
+      } catch (_) {
+        // Ignore invalid URLs
+      }
+    });
+
+    // Protect state-changing logout links against accidental GET / prefetch / CSRF
+    const logoutLinks = document.querySelectorAll('a.logout-link, a[href="/logout"], a[href="/logout/"]');
+    logoutLinks.forEach(function (logoutLink) {
+      logoutLink.setAttribute('rel', 'nofollow noopener noreferrer');
+      logoutLink.addEventListener('click', function (event) {
+        event.preventDefault();
+        fetch('/logout', {
+          method: 'POST',
+          headers: {
+            'X-Requested-With': 'XMLHttpRequest',
+            'Content-Type': 'application/x-www-form-urlencoded'
+          },
+          credentials: 'same-origin'
+        })
+          .then(function (response) {
+            return response.text();
+          })
+          .then(function (text) {
+            if (window.history && window.history.replaceState) {
+              window.history.replaceState(null, '', '/logout');
+            }
+            document.title = 'Logged Out | The Daily Grind';
+            document.body.textContent = text || 'Logged out';
+          })
+          .catch(function () {
+            window.location.assign('/logout');
+          });
+      });
+    });
+  }
+
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', initClientSecurity);
+  } else {
+    initClientSecurity();
+  }
+})();
