+
+    const escapeHtml = (input) =>
+      String(input)
+        .replaceAll('&', '&amp;')
+        .replaceAll('<', '&lt;')
+        .replaceAll('>', '&gt;')
+        .replaceAll('"', '&quot;')
+        .replaceAll("'", '&#39;');
+
+    const htmlPolicy = window.trustedTypes?.createPolicy('escape-html', {
+      createHTML: escapeHtml,
+    });
+
+    window.dailyGrindSecurity = {
+      htmlPolicy,
+      setSafeText(element, text) {
+        if (element) {
+          element.textContent = String(text ?? '');
+        }
+      },
+    };
