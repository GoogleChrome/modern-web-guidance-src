+  <script>
+    function updateMapleOatLatteTimer() {
+      const countdownEl = document.getElementById('maple-countdown');
+      const elapsedEl = document.getElementById('maple-elapsed');
+      if (!countdownEl || !elapsedEl) return;
+
+      const userTimeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(userTimeZone);
+
+      const promotionStart = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 2,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone,
+      });
+
+      const offerEnd = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 3,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone,
+      });
+
+      const remainingDuration = now.until(offerEnd, {
+        largestUnit: 'days',
+        smallestUnit: 'hours',
+      });
+
+      const elapsedDuration = now.since(promotionStart, {
+        largestUnit: 'days',
+        smallestUnit: 'hours',
+      });
+
+      if (Temporal.ZonedDateTime.compare(now, offerEnd) < 0) {
+        countdownEl.textContent = `Offer ends in: ${remainingDuration.days} days, ${remainingDuration.hours} hours`;
+      } else {
+        countdownEl.textContent = `Offer ended (0 days, 0 hours left)`;
+      }
+
+      elapsedEl.textContent = `Time elapsed since promotion start: ${elapsedDuration.days} days, ${elapsedDuration.hours} hours`;
+    }
+
+    window.addEventListener('DOMContentLoaded', updateMapleOatLatteTimer);
+  </script>
+
