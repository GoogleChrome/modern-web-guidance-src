+  <script>
+    function initializeApp() {
+      const remainingEl = document.getElementById('maple-oat-remaining');
+      const elapsedEl = document.getElementById('maple-oat-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      // 1. Get the current time in the user's local system IANA time zone
+      const now = Temporal.Now.zonedDateTimeISO();
+      const tz = now.timeZoneId;
+
+      // 2. Combine separate date and time strings via Temporal methods
+      // Promotion start (Feb 1, 2026 at midnight) and end (March 1, 2026 at midnight)
+      const startDateStr = '2026-02-01';
+      const startTimeStr = '00:00:00';
+      const endDateStr = '2026-03-01';
+      const endTimeStr = '00:00:00';
+
+      const start = Temporal.PlainDate.from(startDateStr).toPlainDateTime(startTimeStr).toZonedDateTime(tz);
+      const end = Temporal.PlainDate.from(endDateStr).toPlainDateTime(endTimeStr).toZonedDateTime(tz);
+
+      // 3. Calculate differentials using .since() and .until() balanced to days and hours
+      const timeActive = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      // 4. Check status via .sign and format durations using .toLocaleString() (Intl.DurationFormat)
+      const isExpired = timeRemaining.sign <= 0;
+      const isNotStarted = timeActive.sign < 0;
+
+      if (isExpired) {
+        remainingEl.textContent = `Offer ended (${timeRemaining.abs().toLocaleString(undefined, { style: 'long' })} ago)`;
+        remainingEl.setAttribute('datetime', timeRemaining.toString());
+      } else {
+        remainingEl.textContent = timeRemaining.toLocaleString(undefined, { style: 'long' });
+        remainingEl.setAttribute('datetime', timeRemaining.toString());
+      }
+
+      if (isNotStarted) {
+        elapsedEl.textContent = `Starts in ${timeActive.abs().toLocaleString(undefined, { style: 'long' })}`;
+        elapsedEl.setAttribute('datetime', timeActive.toString());
+      } else {
+        elapsedEl.textContent = timeActive.toLocaleString(undefined, { style: 'long' });
+        elapsedEl.setAttribute('datetime', timeActive.toString());
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initializeApp);
+      } else {
+        initializeApp();
+      }
+    })();
+  </script>
