+  <script type="module">
+    const STORAGE_KEY = 'daily_grind_location_agnostic_prefs';
+
+    function initializeApp() {
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const displayPickupTime = document.getElementById('display-pickup-time');
+      const displayAnniversaryDate = document.getElementById('display-anniversary-date');
+      const displayAnnualMonthDay = document.getElementById('display-annual-monthday');
+      const displayCombinedDateTime = document.getElementById('display-combined-datetime');
+      const scheduleStatus = document.getElementById('schedule-status');
+
+      // Load saved Plain ISO strings if previously stored
+      try {
+        const savedRaw = localStorage.getItem(STORAGE_KEY);
+        if (savedRaw) {
+          const saved = JSON.parse(savedRaw);
+          if (saved.pickupTime) timeInput.value = saved.pickupTime;
+          if (saved.anniversaryDate) dateInput.value = saved.anniversaryDate;
+        }
+      } catch {
+        // Ignore storage read errors in restricted environments
+      }
+
+      function validateTimeField() {
+        if (!timeInput.value) {
+          timeInput.setCustomValidity('Please select a daily pickup reminder wall-clock time.');
+          return false;
+        }
+        try {
+          Temporal.PlainTime.from(timeInput.value);
+          timeInput.setCustomValidity('');
+          return true;
+        } catch {
+          timeInput.setCustomValidity('Please enter a valid wall-clock time (HH:MM).');
+          return false;
+        }
+      }
+
+      function validateDateField() {
+        if (!dateInput.value) {
+          dateInput.setCustomValidity('Please select your coffee anniversary calendar date.');
+          return false;
+        }
+        try {
+          Temporal.PlainDate.from(dateInput.value);
+          dateInput.setCustomValidity('');
+          return true;
+        } catch {
+          dateInput.setCustomValidity('Please enter a valid calendar date (YYYY-MM-DD).');
+          return false;
+        }
+      }
+
+      // Clear existing errors on active typing/input; validate when exiting field (blur)
+      timeInput.addEventListener('input', () => {
+        timeInput.setCustomValidity('');
+      });
+      timeInput.addEventListener('blur', validateTimeField);
+
+      dateInput.addEventListener('input', () => {
+        dateInput.setCustomValidity('');
+      });
+      dateInput.addEventListener('blur', validateDateField);
+
+      function renderLocationAgnosticSchedule(announceSave = false) {
+        if (!validateTimeField() || !validateDateField()) {
+          return;
+        }
+
+        // 1. Parse wall-clock time and calendar date using Temporal Plain types (no time zone offset)
+        const reminderTime = Temporal.PlainTime.from(timeInput.value);
+        const anniversaryDate = Temporal.PlainDate.from(dateInput.value);
+
+        // 2. Combine into a location-agnostic PlainDateTime without string interpolation
+        const anniversaryAppointment = anniversaryDate.toPlainDateTime(reminderTime);
+
+        // 3. Model the recurring annual coffee anniversary as a PlainMonthDay with explicit calendar
+        const { year, month, day } = anniversaryDate;
+        const annualAnniversary = Temporal.PlainMonthDay.from({
+          month,
+          day,
+          calendar: 'iso8601',
+        });
+
+        // Check whether today is the user's recurring coffee anniversary
+        const today = Temporal.Now.plainDateISO();
+        const isAnniversaryToday = annualAnniversary.equals(today.toPlainMonthDay());
+        const occurrenceThisYear = annualAnniversary.toPlainDate({ year: today.year });
+
+        // Format and display without time zone conversion so values never shift during travel
+        displayPickupTime.textContent = `${reminderTime.toLocaleString([], { hour: '2-digit', minute: '2-digit' })} (${reminderTime.toString().slice(0, 5)})`;
+        displayAnniversaryDate.textContent = `${anniversaryDate.toLocaleString()} (${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')})`;
+        displayAnnualMonthDay.textContent = isAnniversaryToday
+          ? `${annualAnniversary.toString()} — Happy Coffee Anniversary Today!`
+          : `${annualAnniversary.toString()} (This year: ${occurrenceThisYear.toString()})`;
+        displayCombinedDateTime.textContent = anniversaryAppointment.toString();
+
+        if (announceSave) {
+          scheduleStatus.textContent = `Saved! Reminder set for ${reminderTime.toString().slice(0, 5)} daily and anniversary locked to ${anniversaryDate.toString()} across all time zones.`;
+          try {
+            localStorage.setItem(
+              STORAGE_KEY,
+              JSON.stringify({
+                pickupTime: reminderTime.toString().slice(0, 5),
+                anniversaryDate: anniversaryDate.toString(),
+              })
+            );
+          } catch {
+            // Ignore storage write errors
+          }
+        }
+      }
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const timeValid = validateTimeField();
+        const dateValid = validateDateField();
+        if (!timeValid || !dateValid) {
+          form.reportValidity();
+          return;
+        }
+        renderLocationAgnosticSchedule(true);
+      });
+
+      renderLocationAgnosticSchedule(false);
+    }
+
+    // Check if Temporal is supported natively; load temporal-polyfill conditionally
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
