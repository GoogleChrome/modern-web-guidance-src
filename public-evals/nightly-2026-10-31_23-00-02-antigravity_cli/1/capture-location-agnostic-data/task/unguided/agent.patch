+  <script>
+    (function () {
+      const STORAGE_KEYS = {
+        pickupTime: 'dailyGrind.pickupReminderPlainTime',
+        anniversaryDate: 'dailyGrind.coffeeAnniversaryPlainDate'
+      };
+
+      const MONTH_NAMES = [
+        'January', 'February', 'March', 'April', 'May', 'June',
+        'July', 'August', 'September', 'October', 'November', 'December'
+      ];
+
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const timeDisplay = document.getElementById('pickup-reminder-display');
+      const dateDisplay = document.getElementById('coffee-anniversary-display');
+      const form = document.getElementById('coffee-preferences-form');
+
+      /**
+       * Parses and normalizes a location-agnostic wall-clock time (HH:MM)
+       * using Temporal.PlainTime when available, falling back to direct string
+       * component parsing without ever using Date or time zone conversions.
+       */
+      function normalizePlainTime(rawTime) {
+        if (!rawTime || typeof rawTime !== 'string') return null;
+        const trimmed = rawTime.trim();
+        if (typeof Temporal !== 'undefined' && Temporal.PlainTime) {
+          try {
+            const plainTime = Temporal.PlainTime.from(trimmed);
+            const hh = String(plainTime.hour).padStart(2, '0');
+            const mm = String(plainTime.minute).padStart(2, '0');
+            return { iso: `${hh}:${mm}`, hour: plainTime.hour, minute: plainTime.minute };
+          } catch (_) {
+            // Fall through to manual parsing
+          }
+        }
+        const match = /^(\d{2}):(\d{2})(?::\d{2})?$/.exec(trimmed);
+        if (!match) return null;
+        const hour = Number(match[1]);
+        const minute = Number(match[2]);
+        if (hour < 0 || hour > 23 || minute < 0 || minute > 59) return null;
+        return {
+          iso: `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`,
+          hour,
+          minute
+        };
+      }
+
+      /**
+       * Parses and normalizes a location-agnostic calendar date (YYYY-MM-DD)
+       * using Temporal.PlainDate when available, falling back to direct string
+       * component parsing without ever using Date or UTC/local offset conversions.
+       */
+      function normalizePlainDate(rawDate) {
+        if (!rawDate || typeof rawDate !== 'string') return null;
+        const trimmed = rawDate.trim();
+        if (typeof Temporal !== 'undefined' && Temporal.PlainDate) {
+          try {
+            const plainDate = Temporal.PlainDate.from(trimmed);
+            return {
+              iso: plainDate.toString(),
+              year: plainDate.year,
+              month: plainDate.month,
+              day: plainDate.day
+            };
+          } catch (_) {
+            // Fall through to manual parsing
+          }
+        }
+        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(trimmed);
+        if (!match) return null;
+        const year = Number(match[1]);
+        const month = Number(match[2]);
+        const day = Number(match[3]);
+        if (month < 1 || month > 12 || day < 1 || day > 31) return null;
+        return {
+          iso: `${String(year).padStart(4, '0')}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`,
+          year,
+          month,
+          day
+        };
+      }
+
+      function formatPlainTimeDisplay(parsedTime) {
+        if (!parsedTime) return 'Not set';
+        const period = parsedTime.hour >= 12 ? 'PM' : 'AM';
+        const hour12 = parsedTime.hour % 12 || 12;
+        const minutePadded = String(parsedTime.minute).padStart(2, '0');
+        return `${parsedTime.iso} (${hour12}:${minutePadded} ${period})`;
+      }
+
+      function formatPlainDateDisplay(parsedDate) {
+        if (!parsedDate) return 'Not set';
+        const monthName = MONTH_NAMES[parsedDate.month - 1];
+        return `${parsedDate.iso} (${monthName} ${parsedDate.day}, ${parsedDate.year})`;
+      }
+
+      function syncPreferences(persist) {
+        const parsedTime = normalizePlainTime(timeInput.value);
+        const parsedDate = normalizePlainDate(dateInput.value);
+
+        if (parsedTime) {
+          timeInput.value = parsedTime.iso;
+          timeDisplay.textContent = formatPlainTimeDisplay(parsedTime);
+          if (persist) {
+            try {
+              localStorage.setItem(STORAGE_KEYS.pickupTime, parsedTime.iso);
+            } catch (_) {}
+          }
+        }
+
+        if (parsedDate) {
+          dateInput.value = parsedDate.iso;
+          dateDisplay.textContent = formatPlainDateDisplay(parsedDate);
+          if (persist) {
+            try {
+              localStorage.setItem(STORAGE_KEYS.anniversaryDate, parsedDate.iso);
+            } catch (_) {}
+          }
+        }
+      }
+
+      // Restore saved location-agnostic plain values on load
+      try {
+        const savedTime = localStorage.getItem(STORAGE_KEYS.pickupTime);
+        const savedDate = localStorage.getItem(STORAGE_KEYS.anniversaryDate);
+        if (savedTime && normalizePlainTime(savedTime)) {
+          timeInput.value = normalizePlainTime(savedTime).iso;
+        }
+        if (savedDate && normalizePlainDate(savedDate)) {
+          dateInput.value = normalizePlainDate(savedDate).iso;
+        }
+      } catch (_) {}
+
+      syncPreferences(false);
+
+      timeInput.addEventListener('input', function () {
+        syncPreferences(true);
+      });
+      timeInput.addEventListener('change', function () {
+        syncPreferences(true);
+      });
+      dateInput.addEventListener('input', function () {
+        syncPreferences(true);
+      });
+      dateInput.addEventListener('change', function () {
+        syncPreferences(true);
+      });
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        syncPreferences(true);
+      });
+    })();
+  </script>
 </body>
 
