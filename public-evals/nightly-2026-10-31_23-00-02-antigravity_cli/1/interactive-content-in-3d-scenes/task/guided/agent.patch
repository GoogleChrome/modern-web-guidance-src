+        -hw,  hh, -hd,  0, 0,  0.48, 0.31, 0.22,
+
+        // Bottom base face
+        -hw, -hh, -hd,  0, 1,  0.18, 0.11, 0.09,
+         hw, -hh, -hd,  1, 1,  0.18, 0.11, 0.09,
+         hw, -hh,  hd,  1, 0,  0.18, 0.11, 0.09,
+        -hw, -hh, -hd,  0, 1,  0.18, 0.11, 0.09,
+         hw, -hh,  hd,  1, 0,  0.18, 0.11, 0.09,
+        -hw, -hh,  hd,  0, 0,  0.18, 0.11, 0.09,
+      ]);
+
+      const boxVao = gl.createVertexArray();
+      gl.bindVertexArray(boxVao);
+      const boxVbo = gl.createBuffer();
+      gl.bindBuffer(gl.ARRAY_BUFFER, boxVbo);
+      gl.bufferData(gl.ARRAY_BUFFER, boxBodyVertices, gl.STATIC_DRAW);
+      gl.enableVertexAttribArray(0);
+      gl.vertexAttribPointer(0, 3, gl.FLOAT, false, stride, 0);
+      gl.enableVertexAttribArray(1);
+      gl.vertexAttribPointer(1, 2, gl.FLOAT, false, stride, 3 * Float32Array.BYTES_PER_ELEMENT);
+      gl.enableVertexAttribArray(2);
+      gl.vertexAttribPointer(2, 3, gl.FLOAT, false, stride, 5 * Float32Array.BYTES_PER_ELEMENT);
+
+      // Setup WebGL texture for the interactive HTML form
+      const texture = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      const textureState = { width: 0, height: 0 };
+
+      let rotationTime = 0;
+      let lastFrameTime = performance.now();
+      let isSpinning = true;
+      let spinDirection = 1;
+
+      toggleSpinBtn.addEventListener("click", () => {
+        isSpinning = !isSpinning;
+        toggleSpinBtn.textContent = isSpinning ? "Pause Rotation" : "Resume Rotation";
+      });
+
+      reverseSpinBtn.addEventListener("click", () => {
+        spinDirection *= -1;
+      });
+
+      function drawSceneAndComputeMVP() {
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.enable(gl.DEPTH_TEST);
+        gl.clearColor(0.0, 0.0, 0.0, 0.0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+        const aspect = (canvas.width || 1) / (canvas.height || 1);
+        const proj = mat4Perspective((40 * Math.PI) / 180, aspect, 0.1, 100.0);
+        const view = mat4Translate(0, 0, -3.4);
+
+        // Smoothly spin the 3D coffee box while keeping the interactive form face readable and clickable
+        const rotY = Math.sin(rotationTime * 0.85) * 0.52;
+        const rotX = Math.cos(rotationTime * 0.55) * 0.14;
+        const boxModel = mat4Multiply(mat4RotateY(rotY), mat4RotateX(rotX));
+        const boxMVP = mat4Multiply(proj, mat4Multiply(view, boxModel));
+
+        gl.useProgram(program);
+
+        // Draw the 5 coffee box body faces
+        gl.bindVertexArray(boxVao);
+        gl.uniformMatrix4fv(uMvpLoc, false, boxMVP);
+        gl.uniform1i(uUseTextureLoc, 0);
+        gl.drawArrays(gl.TRIANGLES, 0, 30);
+
+        // Compute the MVP matrix for the front face unit quad (-0.5..0.5)
+        const frontFaceLocal = mat4Multiply(
+          mat4Translate(0, 0, hd + 0.001),
+          mat4Scale(boxW, boxH, 1)
+        );
+        const htmlElementMVP = mat4Multiply(boxMVP, frontFaceLocal);
+
+        // Draw the front face with the uploaded HTML form texture (or warm cream fallback)
+        gl.bindVertexArray(frontVao);
+        gl.uniformMatrix4fv(uMvpLoc, false, htmlElementMVP);
+        if (supportsHtmlInCanvas && textureState.width > 0) {
+          gl.activeTexture(gl.TEXTURE0);
+          gl.bindTexture(gl.TEXTURE_2D, texture);
+          gl.uniform1i(uTextureLoc, 0);
+          gl.uniform1i(uUseTextureLoc, 1);
+        } else {
+          gl.uniform1i(uUseTextureLoc, 0);
+        }
+        gl.drawArrays(gl.TRIANGLES, 0, 6);
+
+        return htmlElementMVP;
+      }
+
+      if (supportsHtmlInCanvas) {
+        canvas.onpaint = (event) => {
+          // 1. Update texture with HTML content when changed or on initial upload
+          const hasChangedElements =
+            !event ||
+            !event.changedElements ||
+            event.changedElements.length > 0 ||
+            textureState.width === 0;
+          if (hasChangedElements) {
+            try {
+              uploadElementWebGL(gl, canvas, texture, uiElement, textureState);
+            } catch (err) {
+              console.error("texElementSubImage2D copy failed:", err);
+            }
+          }
+
+          // 2. Render 3D spinning coffee box scene and compute htmlElementMVP matrix
+          const htmlElementMVP = drawSceneAndComputeMVP();
+
+          // 3. Sync DOM position, hit testing, and accessibility bounds with 3D scene
+          canvas.updateElementGeometry(uiElement, {
+            canvasTransform: computeCanvasTransform(canvas, uiElement, htmlElementMVP),
+          });
+        };
+      }
+
+      function render(now) {
+        const dt = Math.min((now - lastFrameTime) / 1000, 0.1);
+        lastFrameTime = now;
+        if (isSpinning) {
+          rotationTime += dt * spinDirection;
+        }
+
+        if (supportsHtmlInCanvas && typeof canvas.requestPaint === "function") {
+          // Request to update the canvas via onpaint
+          canvas.requestPaint();
+        } else {
+          drawSceneAndComputeMVP();
+        }
+        requestAnimationFrame(render);
+      }
+
+      requestAnimationFrame(render);
+    }
+  </script>
 </body>
 
