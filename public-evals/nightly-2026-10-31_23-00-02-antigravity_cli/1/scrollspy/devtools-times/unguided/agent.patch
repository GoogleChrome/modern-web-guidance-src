diff --git a/src/components/SectionNavigation.tsx b/src/components/SectionNavigation.tsx
new file mode 100644
index 0000000..f4cd0d3
--- /dev/null
+++ b/src/components/SectionNavigation.tsx
@@ -0,0 +1,338 @@
+import React, { useState, useEffect, useCallback } from 'react';
+
+export interface SectionItem {
+    id: string;
+    label: string;
+    level?: number;
+}
+
+interface SectionNavigationProps {
+    sections?: SectionItem[];
+    containerSelector?: string;
+    variant?: 'bar' | 'sidebar' | 'auto';
+    title?: string;
+}
+
+const slugify = (text: string): string => {
+    return text
+        .toLowerCase()
+        .trim()
+        .replace(/[^\w\s-]/g, '')
+        .replace(/[\s_-]+/g, '-')
+        .replace(/^-+|-+$/g, '');
+};
+
+const SectionNavigation: React.FC<SectionNavigationProps> = ({
+    sections: initialSections,
+    containerSelector,
+    variant = 'auto',
+    title = 'On this page',
+}) => {
+    const [sections, setSections] = useState<SectionItem[]>(initialSections || []);
+    const [activeSectionId, setActiveSectionId] = useState<string>('');
+
+    // Discover sections from DOM if not explicitly provided or merge with dynamic headings
+    const discoverSections = useCallback(() => {
+        const root = containerSelector
+            ? document.querySelector(containerSelector)
+            : document.querySelector('main') || document.body;
+
+        if (!root) {
+            setSections(initialSections || []);
+            return initialSections || [];
+        }
+
+        if (initialSections && initialSections.length > 0) {
+            // Check if there are additional headings inside #overview (e.g. article body headings)
+            const articleBody = root.querySelector('.prose');
+            if (articleBody) {
+                const subHeadings = articleBody.querySelectorAll<HTMLElement>('h2, h3');
+                if (subHeadings.length > 0) {
+                    const combined: SectionItem[] = [initialSections[0]];
+                    const usedIds = new Set<string>(initialSections.map((s) => s.id));
+                    subHeadings.forEach((heading) => {
+                        const text = heading.textContent?.trim();
+                        if (!text) return;
+                        let id = heading.id || slugify(text);
+                        if (!id) return;
+                        let uniqueId = id;
+                        let counter = 1;
+                        while (usedIds.has(uniqueId)) {
+                            uniqueId = `${id}-${counter++}`;
+                        }
+                        usedIds.add(uniqueId);
+                        if (!heading.id) {
+                            heading.id = uniqueId;
+                        }
+                        combined.push({
+                            id: uniqueId,
+                            label: text,
+                            level: heading.tagName.toLowerCase() === 'h3' ? 3 : 2,
+                        });
+                    });
+                    combined.push(...initialSections.slice(1));
+                    setSections(combined);
+                    return combined;
+                }
+            }
+            setSections(initialSections);
+            return initialSections;
+        }
+
+        // Check for explicit data-section-title elements first
+        const explicitElements = root.querySelectorAll<HTMLElement>('[data-section-title], section[id]');
+        if (explicitElements.length > 0) {
+            const discovered: SectionItem[] = [];
+            explicitElements.forEach((el) => {
+                const label =
+                    el.getAttribute('data-section-title') ||
+                    el.querySelector('h2, h3')?.textContent?.trim() ||
+                    el.id;
+                if (!label) return;
+                if (!el.id) {
+                    el.id = slugify(label);
+                }
+                discovered.push({
+                    id: el.id,
+                    label,
+                    level: 2,
+                });
+            });
+            if (discovered.length > 0) {
+                setSections(discovered);
+                return discovered;
+            }
+        }
+
+        // Otherwise discover headings (h2, h3) inside the container
+        const headings = root.querySelectorAll<HTMLElement>('h2, h3');
+        const discovered: SectionItem[] = [];
+        const usedIds = new Set<string>();
+
+        headings.forEach((heading) => {
+            const text = heading.textContent?.trim();
+            if (!text) return;
+
+            let id = heading.id || slugify(text);
+            if (!id) return;
+
+            // Ensure unique ID
+            let uniqueId = id;
+            let counter = 1;
+            while (usedIds.has(uniqueId)) {
+                uniqueId = `${id}-${counter++}`;
+            }
+            usedIds.add(uniqueId);
+
+            if (!heading.id) {
+                heading.id = uniqueId;
+            }
+
+            // If parent is a <section> without an id, or we want to observe the section/heading
+            discovered.push({
+                id: uniqueId,
+                label: text,
+                level: heading.tagName.toLowerCase() === 'h3' ? 3 : 2,
+            });
+        });
+
+        setSections(discovered);
+        return discovered;
+    }, [initialSections, containerSelector]);
+
+    useEffect(() => {
+        const currentSections = discoverSections();
+        if (currentSections.length === 0) return;
+
+        // Default to the first section if none is active yet
+        setActiveSectionId((prev) => prev || currentSections[0].id);
+
+        const visibleRatios = new Map<string, number>();
+
+        const computeActiveSection = () => {
+            const scrollY = window.scrollY;
+            const viewportHeight = window.innerHeight;
+            const docHeight = document.documentElement.scrollHeight;
+
+            // If scrolled to the very bottom of the page, highlight the last section
+            if (scrollY + viewportHeight >= docHeight - 20 && currentSections.length > 0) {
+                setActiveSectionId(currentSections[currentSections.length - 1].id);
+                return;
+            }
+
+            // Find the section whose top is closest to the upper reading zone (e.g. 25% from top of viewport)
+            const targetLine = viewportHeight * 0.25;
+            let bestId = currentSections[0].id;
+            let bestDistance = Infinity;
+            let foundAboveTarget = false;
+
+            for (const sec of currentSections) {
+                const el = document.getElementById(sec.id);
+                if (!el) continue;
+
+                const rect = el.getBoundingClientRect();
+
+                // Check if element or its section is in view
+                if (rect.top <= targetLine) {
+                    const distance = targetLine - rect.top;
+                    if (!foundAboveTarget || distance < bestDistance) {
+                        foundAboveTarget = true;
+                        bestDistance = distance;
+                        bestId = sec.id;
+                    }
+                } else if (!foundAboveTarget) {
+                    const distance = rect.top - targetLine;
+                    if (distance < bestDistance) {
+                        bestDistance = distance;
+                        bestId = sec.id;
+                    }
+                }
+            }
+
+            setActiveSectionId(bestId);
+        };
+
+        const observer = new IntersectionObserver(
+            (entries) => {
+                entries.forEach((entry) => {
+                    visibleRatios.set(entry.target.id, entry.intersectionRatio);
+                });
+                computeActiveSection();
+            },
+            {
+                rootMargin: '-10% 0px -65% 0px',
+                threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
+            }
+        );
+
+        currentSections.forEach((sec) => {
+            const el = document.getElementById(sec.id);
+            if (el) {
+                observer.observe(el);
+            }
+        });
+
+        window.addEventListener('scroll', computeActiveSection, { passive: true });
+        computeActiveSection();
+
+        return () => {
+            observer.disconnect();
+            window.removeEventListener('scroll', computeActiveSection);
+        };
+    }, [discoverSections]);
+
+    const handleScrollToSection = (e: React.MouseEvent<HTMLAnchorElement>, id: string) => {
+        e.preventDefault();
+        const el = document.getElementById(id);
+        if (el) {
+            setActiveSectionId(id);
+            const yOffset = -72; // Offset for sticky nav bar
+            const y = el.getBoundingClientRect().top + window.scrollY + yOffset;
+            window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
+            window.history.replaceState(null, '', `#${id}`);
+        }
+    };
+
+    if (sections.length === 0) {
+        return null;
+    }
+
+    const resolvedVariant = variant === 'auto' ? 'bar' : variant;
+
+    if (resolvedVariant === 'sidebar') {
+        return (
+            <nav
+                aria-label="Page sections"
+                data-section-nav="sidebar"
+                className="bg-gray-50 border border-gray-200 rounded-md p-4 mb-6"
+            >
+                <div className="flex items-center justify-between mb-3 pb-2 border-b border-gray-200">
+                    <span className="text-xs font-bold uppercase tracking-wider text-gray-500">
+                        {title}
+                    </span>
+                    <span className="text-xs text-amber-700 font-semibold">
+                        {sections.find((s) => s.id === activeSectionId)?.label}
+                    </span>
+                </div>
+                <ul className="space-y-1.5 text-sm">
+                    {sections.map((section) => {
+                        const isActive = activeSectionId === section.id;
+                        return (
+                            <li
+                                key={section.id}
+                                className={section.level === 3 ? 'pl-4' : ''}
+                            >
+                                <a
+                                    href={`#${section.id}`}
+                                    onClick={(e) => handleScrollToSection(e, section.id)}
+                                    aria-current={isActive ? 'location' : undefined}
+                                    data-active={isActive ? 'true' : 'false'}
+                                    className={`flex items-center py-1 px-2.5 rounded transition-colors border-l-2 ${
+                                        isActive
+                                            ? 'border-amber-500 bg-amber-50 text-amber-900 font-semibold'
+                                            : 'border-transparent text-gray-600 hover:text-gray-900 hover:bg-gray-100'
+                                    }`}
+                                >
+                                    <span
+                                        className={`w-1.5 h-1.5 rounded-full mr-2 flex-shrink-0 transition-transform ${
+                                            isActive ? 'bg-amber-500 scale-125' : 'bg-gray-300'
+                                        }`}
+                                    />
+                                    <span className="truncate">{section.label}</span>
+                                </a>
+                            </li>
+                        );
+                    })}
+                </ul>
+            </nav>
+        );
+    }
+
+    return (
+        <div
+            data-section-nav="bar"
+            className="sticky top-0 z-30 bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-xs transition-all"
+        >
+            <nav
+                aria-label="Page sections"
+                className="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-11 overflow-x-auto"
+            >
+                <div className="flex items-center space-x-1 sm:space-x-2">
+                    <span className="text-[11px] font-bold uppercase tracking-wider text-gray-400 mr-2 hidden sm:inline-block whitespace-nowrap">
+                        {title}:
+                    </span>
+                    <ul className="flex items-center space-x-1 sm:space-x-2">
+                        {sections.map((section) => {
+                            const isActive = activeSectionId === section.id;
+                            return (
+                                <li key={section.id}>
+                                    <a
+                                        href={`#${section.id}`}
+                                        onClick={(e) => handleScrollToSection(e, section.id)}
+                                        aria-current={isActive ? 'location' : undefined}
+                                        data-active={isActive ? 'true' : 'false'}
+                                        className={`inline-flex items-center px-3 py-1.5 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition-all duration-150 ${
+                                            isActive
+                                                ? 'bg-amber-400 text-gray-900 font-semibold shadow-2xs'
+                                                : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
+                                        }`}
+                                    >
+                                        {isActive && (
+                                            <span
+                                                className="w-1.5 h-1.5 rounded-full bg-gray-900 mr-1.5 animate-pulse"
+                                                aria-hidden="true"
+                                            />
+                                        )}
+                                        {section.label}
+                                    </a>
+                                </li>
+                            );
+                        })}
+                    </ul>
+                </div>
+            </nav>
+        </div>
+    );
+};
+
+export default SectionNavigation;
