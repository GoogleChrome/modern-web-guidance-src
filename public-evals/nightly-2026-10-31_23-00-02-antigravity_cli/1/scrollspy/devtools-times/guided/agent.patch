diff --git a/src/components/ScrollspyNav.astro b/src/components/ScrollspyNav.astro
new file mode 100644
index 0000000..4e40692
--- /dev/null
+++ b/src/components/ScrollspyNav.astro
@@ -0,0 +1,87 @@
+---
+export interface SectionLink {
+  id: string;
+  label: string;
+}
+
+export interface Props {
+  sections: SectionLink[];
+  ariaLabel?: string;
+}
+
+const { sections, ariaLabel = "Page sections" } = Astro.props;
+---
+
+{sections.length > 0 && (
+  <nav
+    aria-label={ariaLabel}
+    data-scrollspy
+    class="scrollspy-nav sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-gray-200 shadow-xs"
+  >
+    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center gap-3 overflow-x-auto py-2">
+      <span class="text-xs font-bold uppercase tracking-wider text-gray-500 whitespace-nowrap select-none">
+        Sections
+      </span>
+      <ul class="flex items-center gap-2 sm:gap-4 text-sm font-medium m-0 p-0 list-none">
+        {sections.map((section) => (
+          <li>
+            <a
+              href={`#${section.id}`}
+              class="scrollspy-link inline-flex items-center min-h-8 px-3 py-1 rounded-t text-gray-700 hover:text-gray-900 border-b-2 border-transparent transition-colors whitespace-nowrap"
+            >
+              {section.label}
+            </a>
+          </li>
+        ))}
+      </ul>
+    </div>
+  </nav>
+)}
+
+<script>
+  const initScrollspy = () => {
+    const navs = document.querySelectorAll<HTMLElement>('nav[data-scrollspy]');
+    if (!navs.length) return;
+
+    const supportsScrollTargetGroup = CSS.supports('scroll-target-group: auto');
+
+    if (supportsScrollTargetGroup) {
+      const syncAriaCurrent = () => {
+        navs.forEach((nav) => {
+          const currentLink = nav.querySelector('a:target-current');
+          nav.querySelectorAll('a').forEach((link) => {
+            link.setAttribute('aria-current', link === currentLink ? 'true' : 'false');
+          });
+        });
+      };
+
+      syncAriaCurrent();
+      document.addEventListener('scrollend', syncAriaCurrent);
+    } else {
+      const navLinks = document.querySelectorAll<HTMLAnchorElement>('nav[data-scrollspy] a');
+      const sections = document.querySelectorAll<HTMLElement>('main section[id]');
+
+      const observer = new IntersectionObserver(
+        (entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              const id = entry.target.getAttribute('id');
+              if (!id) return;
+              navLinks.forEach((link) => {
+                const isActive = link.getAttribute('href') === `#${id}`;
+                link.classList.toggle('target-current', isActive);
+                link.setAttribute('aria-current', String(isActive));
+              });
+            }
+          });
+        },
+        { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
+      );
+
+      sections.forEach((section) => observer.observe(section));
+    }
+  };
+
+  initScrollspy();
+  document.addEventListener('astro:page-load', initScrollspy);
+</script>
