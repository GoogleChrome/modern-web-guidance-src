@@ -1,7 +1,40 @@
 @import "tailwindcss";
 
+:root {
+  --accent: #b45309;
+}
+
+html {
+  scroll-behavior: smooth;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html {
+    scroll-behavior: auto;
+  }
+}
+
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+/* MANDATORY: The container of markers must have scroll-target-group: auto */
+nav.scrollspy-nav {
+  scroll-target-group: auto;
+}
+
+/* Fallback style if :target-current is not supported.
+   Use :is() to combine the native pseudo-class with a fallback class for older browsers. */
+nav.scrollspy-nav a:is(:target-current, .target-current) {
+  color: var(--accent, #b45309);
+  border-bottom-color: var(--accent, #b45309);
+  background-color: #fffbeb;
+  font-weight: 700;
+}
+
+nav.scrollspy-nav a:focus-visible {
+  outline: 2px solid var(--accent, #b45309);
+  outline-offset: 2px;
+}
