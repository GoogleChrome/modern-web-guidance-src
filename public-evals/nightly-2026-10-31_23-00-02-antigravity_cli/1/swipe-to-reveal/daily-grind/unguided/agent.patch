+  <script>
+    (function () {
+      const ACTIONS_WIDTH = 180;
+      const SWIPE_THRESHOLD = 25;
+      const DRAG_START_THRESHOLD = 5;
+
+      const cards = document.querySelectorAll('.grid .card');
+      const cardOffsets = new WeakMap();
+      let activeSwipe = null;
+
+      function getCoords(e) {
+        if (e.touches && e.touches.length > 0) {
+          const t = e.touches[0];
+          const x = t.clientX !== undefined ? t.clientX : t.pageX;
+          const y = t.clientY !== undefined ? t.clientY : t.pageY;
+          if (typeof x === 'number') return { x, y: typeof y === 'number' ? y : 0 };
+        }
+        if (e.changedTouches && e.changedTouches.length > 0) {
+          const t = e.changedTouches[0];
+          const x = t.clientX !== undefined ? t.clientX : t.pageX;
+          const y = t.clientY !== undefined ? t.clientY : t.pageY;
+          if (typeof x === 'number') return { x, y: typeof y === 'number' ? y : 0 };
+        }
+        if (typeof e.clientX === 'number') {
+          return { x: e.clientX, y: typeof e.clientY === 'number' ? e.clientY : 0 };
+        }
+        if (typeof e.pageX === 'number') {
+          return { x: e.pageX, y: typeof e.pageY === 'number' ? e.pageY : 0 };
+        }
+        return null;
+      }
+
+      function setCardState(card, offset, isSwiping) {
+        const content = card.querySelector('.card-content');
+        const actions = card.querySelector('.card-actions');
+        cardOffsets.set(card, offset);
+
+        if (content) {
+          content.style.transform = `translateX(${offset}px)`;
+        }
+
+        if (offset > 0) {
+          card.classList.add('swipe-right');
+        } else if (offset < 0) {
+          card.classList.remove('swipe-right');
+        }
+
+        const isRevealed = Math.abs(offset) >= SWIPE_THRESHOLD;
+
+        if (isSwiping) {
+          card.classList.add('swiping');
+          if (isRevealed) {
+            card.classList.add('swiped');
+            card.dataset.swiped = 'true';
+            if (actions) actions.setAttribute('aria-hidden', 'false');
+          }
+        } else {
+          card.classList.remove('swiping');
+          if (offset !== 0) {
+            card.classList.add('swiped');
+            card.dataset.swiped = 'true';
+            if (actions) actions.setAttribute('aria-hidden', 'false');
+          } else {
+            card.classList.remove('swiped', 'swipe-right');
+            card.dataset.swiped = 'false';
+            if (actions) actions.setAttribute('aria-hidden', 'true');
+          }
+        }
+      }
+
+      function startGesture(card, e) {
+        if (activeSwipe) return;
+        if (e.type === 'mousedown' && typeof e.button === 'number' && e.button !== 0) return;
+
+        const coords = getCoords(e);
+        if (!coords) return;
+
+        const baseOffset = cardOffsets.get(card) || 0;
+        activeSwipe = {
+          card,
+          startX: coords.x,
+          startY: coords.y,
+          lastX: coords.x,
+          lastY: coords.y,
+          baseOffset,
+          hasMoved: false,
+          isHorizontal: false,
+          startedOnAction: Boolean(e.target && e.target.closest && e.target.closest('.action-btn'))
+        };
+      }
+
+      function moveGesture(e) {
+        if (!activeSwipe) return;
+        const coords = getCoords(e);
+        if (!coords) return;
+
+        const dx = coords.x - activeSwipe.startX;
+        const dy = coords.y - activeSwipe.startY;
+
+        if (!activeSwipe.hasMoved) {
+          if (Math.abs(dx) < DRAG_START_THRESHOLD && Math.abs(dy) < DRAG_START_THRESHOLD) {
+            return;
+          }
+          if (Math.abs(dy) > Math.abs(dx) * 1.5) {
+            activeSwipe = null;
+            return;
+          }
+          activeSwipe.isHorizontal = true;
+        }
+
+        activeSwipe.hasMoved = true;
+        activeSwipe.lastX = coords.x;
+        activeSwipe.lastY = coords.y;
+
+        if (e.cancelable) {
+          e.preventDefault();
+        }
+
+        const { card, baseOffset } = activeSwipe;
+        let nextOffset = baseOffset + dx;
+
+        if (baseOffset === 0) {
+          nextOffset = Math.max(-ACTIONS_WIDTH, Math.min(ACTIONS_WIDTH, nextOffset));
+        } else if (baseOffset < 0) {
+          nextOffset = Math.max(-ACTIONS_WIDTH, Math.min(0, nextOffset));
+        } else {
+          nextOffset = Math.max(0, Math.min(ACTIONS_WIDTH, nextOffset));
+        }
+
+        setCardState(card, nextOffset, true);
+      }
+
+      function endGesture(e) {
+        if (!activeSwipe) return;
+        const swipe = activeSwipe;
+        activeSwipe = null;
+
+        if (!swipe.hasMoved && e) {
+          const endCoords = getCoords(e);
+          if (endCoords && (endCoords.x !== 0 || endCoords.y !== 0)) {
+            const dx = endCoords.x - swipe.startX;
+            const dy = endCoords.y - swipe.startY;
+            if (Math.abs(dx) >= SWIPE_THRESHOLD && Math.abs(dx) >= Math.abs(dy)) {
+              swipe.hasMoved = true;
+              swipe.lastX = endCoords.x;
+            }
+          }
+        }
+
+        if (!swipe.hasMoved) {
+          return;
+        }
+
+        const totalDx = swipe.lastX - swipe.startX;
+        const { card, baseOffset } = swipe;
+        let finalOffset = baseOffset;
+
+        if (baseOffset === 0) {
+          if (totalDx <= -SWIPE_THRESHOLD) {
+            finalOffset = -ACTIONS_WIDTH;
+          } else if (totalDx >= SWIPE_THRESHOLD) {
+            finalOffset = ACTIONS_WIDTH;
+          } else {
+            finalOffset = 0;
+          }
+        } else if (baseOffset < 0) {
+          if (totalDx >= SWIPE_THRESHOLD) {
+            finalOffset = 0;
+          } else {
+            finalOffset = -ACTIONS_WIDTH;
+          }
+        } else if (baseOffset > 0) {
+          if (totalDx <= -SWIPE_THRESHOLD) {
+            finalOffset = 0;
+          } else {
+            finalOffset = ACTIONS_WIDTH;
+          }
+        }
+
+        setCardState(card, finalOffset, false);
+
+        card._suppressContentClickUntil = Date.now() + 300;
+        if (swipe.startedOnAction) {
+          card._suppressActionClickUntil = Date.now() + 300;
+        }
+      }
+
+      cards.forEach((card) => {
+        cardOffsets.set(card, 0);
+
+        card.addEventListener('pointerdown', (e) => startGesture(card, e));
+        card.addEventListener('mousedown', (e) => startGesture(card, e));
+        card.addEventListener('touchstart', (e) => startGesture(card, e), { passive: true });
+
+        card.addEventListener('pointermove', moveGesture);
+        card.addEventListener('mousemove', moveGesture);
+        card.addEventListener('touchmove', moveGesture, { passive: false });
+
+        card.addEventListener('pointerup', endGesture);
+        card.addEventListener('mouseup', endGesture);
+        card.addEventListener('touchend', endGesture);
+        card.addEventListener('pointercancel', endGesture);
+        card.addEventListener('touchcancel', endGesture);
+
+        card.addEventListener('wheel', (e) => {
+          if (Math.abs(e.deltaX) > Math.abs(e.deltaY) && Math.abs(e.deltaX) >= SWIPE_THRESHOLD) {
+            e.preventDefault();
+            const current = cardOffsets.get(card) || 0;
+            if (e.deltaX > 0) {
+              setCardState(card, current > 0 ? 0 : -ACTIONS_WIDTH, false);
+            } else {
+              setCardState(card, current < 0 ? 0 : ACTIONS_WIDTH, false);
+            }
+          }
+        }, { passive: false });
+
+        const content = card.querySelector('.card-content');
+        if (content) {
+          content.addEventListener('click', (e) => {
+            if (card._suppressContentClickUntil && Date.now() < card._suppressContentClickUntil) {
+              e.preventDefault();
+              e.stopPropagation();
+            }
+          }, true);
+        }
+
+        const actionButtons = card.querySelectorAll('.action-btn');
+        actionButtons.forEach((btn) => {
+          btn.addEventListener('click', (e) => {
+            if (card._suppressActionClickUntil && Date.now() < card._suppressActionClickUntil) {
+              e.preventDefault();
+              e.stopPropagation();
+              return;
+            }
+
+            const action = btn.dataset.action;
+            const drink = card.dataset.drink || 'Drink';
+            const statusEl = card.querySelector('.action-status');
+            card.dataset.lastAction = action;
+
+            if (action === 'favorite') {
+              const isFav = btn.getAttribute('aria-pressed') === 'true';
+              const nextFav = !isFav;
+              btn.setAttribute('aria-pressed', String(nextFav));
+              btn.classList.toggle('active', nextFav);
+              const icon = btn.querySelector('.action-icon');
+              const label = btn.querySelector('.action-label');
+              if (icon) icon.textContent = nextFav ? '♥' : '♡';
+              if (label) label.textContent = nextFav ? 'Saved' : 'Favorite';
+              if (statusEl) {
+                statusEl.hidden = false;
+                statusEl.textContent = nextFav ? `Saved ${drink} to favorites` : `Removed ${drink} from favorites`;
+              }
+            } else if (action === 'order') {
+              if (statusEl) {
+                statusEl.hidden = false;
+                statusEl.textContent = `Added ${drink} to order`;
+              }
+            } else if (action === 'customize') {
+              if (statusEl) {
+                statusEl.hidden = false;
+                statusEl.textContent = `Customizing ${drink}`;
+              }
+            }
+          });
+        });
+      });
+
+      window.addEventListener('pointermove', moveGesture, { capture: true });
+      window.addEventListener('mousemove', moveGesture, { capture: true });
+      window.addEventListener('touchmove', moveGesture, { capture: true, passive: false });
+
+      window.addEventListener('pointerup', endGesture, { capture: true });
+      window.addEventListener('mouseup', endGesture, { capture: true });
+      window.addEventListener('touchend', endGesture, { capture: true });
+      window.addEventListener('pointercancel', endGesture, { capture: true });
+      window.addEventListener('touchcancel', endGesture, { capture: true });
+    })();
+  </script>
 </body>
 
