+    .SwipeReveal {
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+      overscroll-behavior: auto;
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      background: white;
+      padding: 20px;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+      background: var(--secondary);
+
+      &:first-child {
+        scroll-snap-align: start;
+      }
+    }
+
+    .SwipeReveal-panel button {
+      border: none;
+      padding: 0 16px;
+      min-inline-size: 48px;
+      min-block-size: 48px;
+      font-family: inherit;
+      font-size: 0.85rem;
+      font-weight: 600;
+      cursor: pointer;
+      color: white;
+      background: var(--primary);
+      transition: filter 0.2s;
+    }
+
+    .SwipeReveal-panel button:not(:last-child) {
+      border-inline-end: 1px solid rgba(255, 255, 255, 0.2);
+    }
+
+    .SwipeReveal-panel button:hover:not(:disabled) {
+      filter: brightness(1.15);
+    }
+
+    :where(a:any-link, button):focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .SwipeReveal-panel button:focus-visible {
+      outline-offset: -3px;
+    }
+
