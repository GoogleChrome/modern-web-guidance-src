+  <script>
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const updateGroup = (parent) => {
+        const children = Array.from(parent.children);
+        children.forEach((child, index) => {
+          child.style.setProperty('--sibling-index', index + 1);
+          child.style.setProperty('--sibling-count', children.length);
+        });
+      };
+
+      const containers = document.querySelectorAll('.grid, .fan-container, .circle-container');
+      const observer = new MutationObserver((mutations) => {
+        mutations.forEach((mutation) => {
+          if (mutation.type === 'childList') {
+            updateGroup(mutation.target);
+          }
+        });
+      });
+
+      containers.forEach((container) => {
+        updateGroup(container);
+        observer.observe(container, { childList: true });
+      });
+    }
+  </script>
