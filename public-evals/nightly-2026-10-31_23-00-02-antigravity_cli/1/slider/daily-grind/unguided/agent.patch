+  <script>
+    (function () {
+      const slider = document.getElementById('brew-strength');
+      const output = document.getElementById('brew-strength-output');
+      const profileTitle = document.getElementById('brew-profile-title');
+      const profileNotes = document.getElementById('brew-profile-notes');
+      const metricRatio = document.getElementById('brew-metric-ratio');
+      const metricCaffeine = document.getElementById('brew-metric-caffeine');
+      const scaleLabels = document.querySelectorAll('#brew-scale-labels span');
+
+      const brewProfiles = {
+        1: {
+          short: 'Mild',
+          title: 'Delicate Light Roast',
+          notes: 'Bright citrus and floral jasmine notes with a crisp, tea-like body.',
+          ratio: '1:18',
+          caffeine: '~95 mg'
+        },
+        2: {
+          short: 'Smooth',
+          title: 'Smooth Morning Blend',
+          notes: 'Mellow honey sweetness balanced with soft stone-fruit acidity.',
+          ratio: '1:17',
+          caffeine: '~120 mg'
+        },
+        3: {
+          short: 'Medium',
+          title: 'Balanced Medium Roast',
+          notes: 'Rich caramel sweetness with toasted hazelnut undertones and a velvety finish.',
+          ratio: '1:16',
+          caffeine: '~145 mg'
+        },
+        4: {
+          short: 'Bold',
+          title: 'Full-Bodied Dark Roast',
+          notes: 'Deep baker\u2019s chocolate and roasted walnut flavor with low acidity.',
+          ratio: '1:14',
+          caffeine: '~175 mg'
+        },
+        5: {
+          short: 'Extra Bold',
+          title: 'Intense Espresso Roast',
+          notes: 'Syrupy crema, smoky dark cocoa, and bold molasses richness.',
+          ratio: '1:12',
+          caffeine: '~210 mg'
+        }
+      };
+
+      function updateBrewStrength() {
+        if (!slider) return;
+        const min = parseFloat(slider.min) || 1;
+        const max = parseFloat(slider.max) || 5;
+        const val = parseFloat(slider.value);
+        const span = max > min ? max - min : 1;
+        const clampedPercent = Math.min(100, Math.max(0, ((val - min) / span) * 100));
+        const roundedPercent = Math.round(clampedPercent);
+
+        slider.style.setProperty('--fill-percent', clampedPercent + '%');
+        slider.setAttribute('aria-valuemin', String(min));
+        slider.setAttribute('aria-valuemax', String(max));
+        slider.setAttribute('aria-valuenow', String(val));
+
+        // Map to nearest 1..5 profile level
+        const normalizedLevel = Math.min(5, Math.max(1, Math.round(1 + (clampedPercent / 100) * 4)));
+        const profile = brewProfiles[normalizedLevel] || brewProfiles[3];
+
+        const valueText = 'Level ' + val + ': ' + profile.short + ' (' + roundedPercent + '%)';
+        slider.setAttribute('aria-valuetext', valueText);
+
+        if (output) {
+          output.textContent = 'Level ' + val + ' \u00b7 ' + profile.short + ' (' + roundedPercent + '%)';
+        }
+        if (profileTitle) profileTitle.textContent = profile.title;
+        if (profileNotes) profileNotes.textContent = profile.notes;
+        if (metricRatio) metricRatio.textContent = profile.ratio;
+        if (metricCaffeine) metricCaffeine.textContent = profile.caffeine;
+
+        scaleLabels.forEach(function (labelEl) {
+          const level = parseInt(labelEl.getAttribute('data-level'), 10);
+          if (level === normalizedLevel) {
+            labelEl.classList.add('active-scale');
+          } else {
+            labelEl.classList.remove('active-scale');
+          }
+        });
+      }
+
+      if (slider) {
+        slider.addEventListener('input', updateBrewStrength);
+        slider.addEventListener('change', updateBrewStrength);
+        updateBrewStrength();
+      }
+    })();
+  </script>
 </body>
 
