+  <script>
+    const brewSlider = document.querySelector('#brew-strength');
+    const brewOutput = document.querySelector('#brew-strength-output');
+
+    const strengthLabels = {
+      1: '1 — Mild (Light & Floral)',
+      2: '2 — Smooth (Mellow)',
+      3: '3 — Medium (Balanced)',
+      4: '4 — Bold (Rich & Full)',
+      5: '5 — Extra Bold (Intense Espresso)'
+    };
+
+    function syncSliderValue() {
+      brewSlider.style.setProperty('--attr-min', brewSlider.min || 0);
+      brewSlider.style.setProperty('--attr-max', brewSlider.max || 100);
+      brewSlider.style.setProperty('--control-value', brewSlider.value);
+
+      const formatted = strengthLabels[brewSlider.value] || `Level ${brewSlider.value}`;
+      brewOutput.textContent = formatted;
+      brewSlider.setAttribute('aria-valuetext', formatted);
+    }
+
+    syncSliderValue();
+    brewSlider.addEventListener('input', syncSliderValue);
+  </script>
+
