diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,16 +11,109 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --scrollbar-track: #e0d6d2;
+      --scrollbar-thumb: #3e2723;
+      --scrollbar-thumb-hover: #1b0f0d;
+      --scrollbar-border: #fafafa;
     }
 
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
+      scrollbar-width: auto;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
     }
 
+    /* High-visibility custom scrollbars (WebKit / Blink) */
+    ::-webkit-scrollbar {
+      width: 16px;
+      height: 16px;
+    }
+
+    ::-webkit-scrollbar-track {
+      background: var(--scrollbar-track);
+      border-left: 1px solid #bcaaa4;
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background-color: var(--scrollbar-thumb);
+      border-radius: 8px;
+      border: 3px solid var(--scrollbar-border);
+      min-height: 40px;
+    }
+
+    ::-webkit-scrollbar-thumb:hover {
+      background-color: var(--scrollbar-thumb-hover);
+      border-color: var(--accent);
+    }
+
+    ::-webkit-scrollbar-thumb:active {
+      background-color: #000000;
+      border-color: var(--accent);
+    }
+
+    ::-webkit-scrollbar-corner {
+      background: var(--scrollbar-track);
+    }
+
+    /* Enhanced visibility for users requesting high contrast */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-track: #ffffff;
+        --scrollbar-thumb: #000000;
+        --scrollbar-thumb-hover: #000000;
+        --scrollbar-border: #ffffff;
+      }
+
+      ::-webkit-scrollbar {
+        width: 18px;
+        height: 18px;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: #ffffff;
+        border: 2px solid #000000;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background-color: #000000;
+        border: 2px solid #ffffff;
+        border-radius: 0;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background-color: #000000;
+        border-color: var(--accent);
+        outline: 2px solid #000000;
+      }
+    }
+
+    @media (forced-colors: active) {
+      * {
+        scrollbar-color: CanvasText Canvas;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: Canvas;
+        border: 1px solid CanvasText;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background-color: CanvasText;
+        border: 2px solid Canvas;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background-color: Highlight;
+        border-color: Canvas;
+      }
+    }
+
