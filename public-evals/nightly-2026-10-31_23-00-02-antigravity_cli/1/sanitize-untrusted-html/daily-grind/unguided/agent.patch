+  <script>
+    (function () {
+      const ALLOWED_ELEMENTS = new Set([
+        'a', 'abbr', 'b', 'blockquote', 'br', 'caption', 'cite', 'code',
+        'col', 'colgroup', 'dd', 'del', 'details', 'dfn', 'div', 'dl',
+        'dt', 'em', 'figcaption', 'figure', 'h1', 'h2', 'h3', 'h4', 'h5',
+        'h6', 'hr', 'i', 'img', 'ins', 'kbd', 'li', 'mark', 'ol', 'p',
+        'pre', 'q', 's', 'samp', 'small', 'span', 'strike', 'strong',
+        'sub', 'summary', 'sup', 'table', 'tbody', 'td', 'tfoot', 'th',
+        'thead', 'time', 'tr', 'u', 'ul', 'var'
+      ]);
+
+      const ALLOWED_ATTRIBUTES = new Set([
+        'alt', 'cite', 'class', 'colspan', 'datetime', 'dir', 'height',
+        'href', 'lang', 'loading', 'rel', 'rowspan', 'src', 'target',
+        'title', 'width'
+      ]);
+
+      function isSafeUrl(urlValue, attrName) {
+        const normalized = String(urlValue ?? '')
+          .replace(/[\u0000-\u0020]+/g, '')
+          .toLowerCase();
+        if (!normalized) return false;
+        const schemeMatch = normalized.match(/^([a-z0-9+.-]+):/);
+        if (schemeMatch) {
+          const scheme = schemeMatch[1];
+          if (attrName === 'href') {
+            return scheme === 'http' || scheme === 'https' || scheme === 'mailto';
+          }
+          return scheme === 'http' || scheme === 'https';
+        }
+        if (normalized.startsWith('//')) {
+          return false;
+        }
+        return true;
+      }
+
+      function cleanDOMSubtree(root) {
+        const children = Array.from(root.childNodes);
+        for (const node of children) {
+          if (node.nodeType === Node.ELEMENT_NODE) {
+            const tagName = node.tagName.toLowerCase();
+            const isHtmlNamespace =
+              !node.namespaceURI || node.namespaceURI === 'http://www.w3.org/1999/xhtml';
+
+            if (!isHtmlNamespace || !ALLOWED_ELEMENTS.has(tagName)) {
+              node.remove();
+              continue;
+            }
+
+            const attrs = Array.from(node.attributes);
+            for (const attr of attrs) {
+              const attrName = attr.name.toLowerCase();
+              if (attrName.startsWith('on') || !ALLOWED_ATTRIBUTES.has(attrName)) {
+                node.removeAttribute(attr.name);
+                continue;
+              }
+              if (attrName === 'href' || attrName === 'src' || attrName === 'cite') {
+                if (!isSafeUrl(attr.value, attrName)) {
+                  node.removeAttribute(attr.name);
+                }
+              }
+            }
+
+            if (tagName === 'a' && node.getAttribute('target') === '_blank') {
+              node.setAttribute('rel', 'noopener noreferrer');
+            }
+
+            cleanDOMSubtree(node);
+          } else if (node.nodeType !== Node.TEXT_NODE) {
+            node.remove();
+          }
+        }
+      }
+
+      function sanitizeAndRenderHTML(container, untrustedHTML) {
+        const markup = String(untrustedHTML ?? '');
+
+        if (typeof container.setHTML === 'function') {
+          try {
+            container.setHTML(markup);
+            cleanDOMSubtree(container);
+            return;
+          } catch (_err) {
+            // Fall through to Document.parseHTML / DOMParser sanitization
+          }
+        }
+
+        let parsedDoc = null;
+        if (typeof Document !== 'undefined' && typeof Document.parseHTML === 'function') {
+          try {
+            parsedDoc = Document.parseHTML(markup);
+          } catch (_err) {
+            parsedDoc = null;
+          }
+        }
+
+        if (!parsedDoc) {
+          const parser = new DOMParser();
+          parsedDoc = parser.parseFromString(markup, 'text/html');
+        }
+
+        cleanDOMSubtree(parsedDoc.body);
+
+        const fragment = document.createDocumentFragment();
+        while (parsedDoc.body.firstChild) {
+          fragment.appendChild(document.adoptNode(parsedDoc.body.firstChild));
+        }
+        container.replaceChildren(fragment);
+      }
+
+      const reviewForm = document.getElementById('review-form');
+      const drinkSelect = document.getElementById('review-drink');
+      const reviewInput = document.getElementById('review-input');
+      const reviewsList = document.getElementById('reviews-list');
+
+      if (reviewForm && drinkSelect && reviewInput && reviewsList) {
+        reviewForm.addEventListener('submit', function (event) {
+          event.preventDefault();
+
+          const rawFeedback = reviewInput.value;
+          if (!rawFeedback || !rawFeedback.trim()) {
+            return;
+          }
+
+          const noReviewsMsg = document.getElementById('no-reviews-msg');
+          if (noReviewsMsg) {
+            noReviewsMsg.remove();
+          }
+
+          const reviewItem = document.createElement('article');
+          reviewItem.className = 'review-item';
+
+          const header = document.createElement('div');
+          header.className = 'review-header';
+
+          const drinkBadge = document.createElement('span');
+          drinkBadge.className = 'review-drink-badge';
+          drinkBadge.textContent = drinkSelect.value || 'Maple Oat Latte';
+
+          header.appendChild(drinkBadge);
+
+          const contentDiv = document.createElement('div');
+          contentDiv.className = 'review-content';
+          sanitizeAndRenderHTML(contentDiv, rawFeedback);
+
+          reviewItem.appendChild(header);
+          reviewItem.appendChild(contentDiv);
+          reviewsList.appendChild(reviewItem);
+
+          reviewInput.value = '';
+        });
+      }
+    })();
+  </script>
