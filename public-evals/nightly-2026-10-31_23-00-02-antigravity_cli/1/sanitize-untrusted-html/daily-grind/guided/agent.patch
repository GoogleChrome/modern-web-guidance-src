+  <script type="module">
+    const ALLOWED_ELEMENTS = ['p', 'b', 'i', 'strong', 'em', 'ul', 'ol', 'li', 'blockquote', 'code', 'br'];
+    const ALLOWED_ATTRIBUTES = ['class'];
+
+    let domPurifyPromise;
+
+    function loadDOMPurify() {
+      domPurifyPromise ??= import('https://cdn.jsdelivr.net/npm/dompurify@3.2.4/+esm').then((mod) => mod.default ?? mod);
+      return domPurifyPromise;
+    }
+
+    async function safeSetHTML(el, html) {
+      if ('setHTML' in Element.prototype) {
+        const sanitizer = typeof Sanitizer === 'function'
+          ? new Sanitizer({ elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES })
+          : { elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES };
+        el.setHTML(html, { sanitizer });
+      } else {
+        const DOMPurify = await loadDOMPurify();
+        el.innerHTML = DOMPurify.sanitize(html, {
+          ALLOWED_TAGS: [...ALLOWED_ELEMENTS, '#text'],
+          ALLOWED_ATTR: ALLOWED_ATTRIBUTES,
+          ALLOW_ARIA_ATTR: false,
+          ALLOW_DATA_ATTR: false,
+          KEEP_CONTENT: false
+        });
+      }
+    }
+
+    async function safePreviewHTML(previewEl, rawHTML) {
+      if (!rawHTML.trim()) {
+        previewEl.textContent = 'Start typing your feedback above to preview how your sanitized HTML will appear.';
+        return;
+      }
+
+      if (typeof Document !== 'undefined' && 'parseHTML' in Document) {
+        const sanitizer = typeof Sanitizer === 'function'
+          ? new Sanitizer({ elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES })
+          : { elements: ALLOWED_ELEMENTS, attributes: ALLOWED_ATTRIBUTES };
+        const doc = Document.parseHTML(rawHTML, { sanitizer });
+        previewEl.replaceChildren(...doc.body.childNodes);
+      } else {
+        await safeSetHTML(previewEl, rawHTML);
+      }
+    }
+
+    const reviewsFeed = document.getElementById('reviews-feed');
+    const reviewForm = document.getElementById('review-form');
+    const reviewerNameInput = document.getElementById('reviewer-name');
+    const reviewHtmlInput = document.getElementById('review-html');
+    const reviewPreview = document.getElementById('review-preview');
+    const submitBtn = document.getElementById('submit-review-btn');
+
+    async function renderReviewItem({ author, drink, html }, prepend = false) {
+      const article = document.createElement('article');
+      article.className = 'review-item';
+
+      const meta = document.createElement('div');
+      meta.className = 'review-meta';
+
+      const authorEl = document.createElement('span');
+      authorEl.className = 'review-author';
+      authorEl.textContent = author;
+
+      const drinkBadge = document.createElement('span');
+      drinkBadge.className = 'review-drink-badge';
+      drinkBadge.textContent = drink;
+
+      meta.append(authorEl, drinkBadge);
+
+      const body = document.createElement('div');
+      body.className = 'review-body';
+      await safeSetHTML(body, html);
+
+      article.append(meta, body);
+
+      if (prepend && reviewsFeed.firstChild) {
+        reviewsFeed.prepend(article);
+      } else {
+        reviewsFeed.append(article);
+      }
+    }
+
+    const initialReviews = [
+      {
+        author: 'Elena R.',
+        drink: 'Maple Oat Latte',
+        html: '<p>The <strong>Maple Oat Latte</strong> has the most balanced sweetness! <em>Highly recommend</em> asking for an extra dash of cinnamon.</p>'
+      },
+      {
+        author: 'Marcus T.',
+        drink: 'Dark Roast Espresso',
+        html: '<p>Bold and velvety crema with zero bitterness.</p><blockquote>Best morning espresso shot in the neighborhood!</blockquote>'
+      },
+      {
+        author: 'Priya K.',
+        drink: 'Cold Brew',
+        html: '<p>Incredibly smooth 18-hour steep:</p><ul><li>Rich chocolate notes</li><li>Refreshing over ice</li></ul>'
+      }
+    ];
+
+    for (const review of initialReviews) {
+      await renderReviewItem(review);
+    }
+
+    await safePreviewHTML(reviewPreview, reviewHtmlInput.value);
+
+    reviewHtmlInput.addEventListener('input', () => {
+      reviewHtmlInput.setCustomValidity('');
+      safePreviewHTML(reviewPreview, reviewHtmlInput.value);
+    });
+
+    reviewerNameInput.addEventListener('input', () => {
+      reviewerNameInput.setCustomValidity('');
+    });
+
+    reviewForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      if (!reviewForm.checkValidity()) {
+        reviewForm.reportValidity();
+        return;
+      }
+
+      submitBtn.disabled = true;
+      try {
+        const formData = new FormData(reviewForm);
+        const author = String(formData.get('reviewer_name') || '').trim();
+        const drink = String(formData.get('drink') || 'Maple Oat Latte');
+        const html = String(formData.get('review_html') || '');
+
+        await renderReviewItem({ author, drink, html }, true);
+        reviewForm.reset();
+        await safePreviewHTML(reviewPreview, '');
+      } finally {
+        submitBtn.disabled = false;
+      }
+    });
+  </script>
 </body>
 
