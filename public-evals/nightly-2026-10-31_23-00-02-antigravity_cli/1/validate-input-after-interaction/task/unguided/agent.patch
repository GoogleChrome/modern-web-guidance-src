+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const feedback = document.getElementById('newsletter-feedback');
+      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+      function isValidEmail(value) {
+        return emailPattern.test(value);
+      }
+
+      function clearError() {
+        emailInput.setCustomValidity('');
+        emailInput.classList.remove('invalid');
+        emailInput.removeAttribute('aria-invalid');
+        if (feedback.classList.contains('error')) {
+          feedback.textContent = '';
+          feedback.className = 'newsletter-feedback';
+        }
+      }
+
+      function showError(message) {
+        emailInput.setCustomValidity(message);
+        emailInput.classList.add('invalid');
+        emailInput.setAttribute('aria-invalid', 'true');
+        feedback.textContent = message;
+        feedback.className = 'newsletter-feedback error';
+      }
+
+      // Do not show error while the user is actively typing or focusing the field
+      emailInput.addEventListener('input', clearError);
+      emailInput.addEventListener('focus', clearError);
+
+      // Validate only after the user clicks away (blurs)
+      emailInput.addEventListener('blur', function () {
+        const value = emailInput.value.trim();
+        emailInput.setCustomValidity('');
+        if (value.length > 0 && (!emailInput.checkValidity() || !isValidEmail(value))) {
+          showError('Please enter a valid email address.');
+        } else {
+          clearError();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const value = emailInput.value.trim();
+        emailInput.setCustomValidity('');
+        if (!value || !emailInput.checkValidity() || !isValidEmail(value)) {
+          showError('Please enter a valid email address.');
+          return;
+        }
+        clearError();
+        emailInput.value = '';
+        feedback.textContent = 'Thanks for subscribing!';
+        feedback.className = 'newsletter-feedback success';
+      });
+    })();
+  </script>
+
 </body>
 
