+  <script type="module">
+    // Conditionally polyfill Invoker Commands in browsers without native support
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+    }
+
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const moveDialogBtn = document.getElementById('move-dialog-btn');
+    const parentIndicator = document.getElementById('dialog-parent-indicator');
+    const moveStatusText = document.getElementById('move-status-text');
+    const feedbackToast = document.getElementById('feedback-toast');
+
+    const hostContainers = [
+      document.getElementById('feedback-host-main'),
+      document.getElementById('feedback-host-sidebar'),
+      document.getElementById('feedback-host-footer'),
+    ];
+
+    // Ensure open/close buttons also work immediately before module polyfill resolves or offline
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.querySelectorAll('[commandfor="feedback-dialog"]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const cmd = btn.getAttribute('command');
+          if (cmd === 'show-modal' && !feedbackDialog.open) {
+            feedbackDialog.showModal();
+          } else if (cmd === 'close' && feedbackDialog.open) {
+            feedbackDialog.close('cancel');
+          }
+        });
+      });
+    }
+
+    // Light-dismiss fallback for browsers without native dialog closedby="any"
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dialog) => {
+        const r = dialog.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      for (const dialog of document.querySelectorAll('dialog[closedby="any"]')) {
+        let pressedOutside = false;
+        dialog.addEventListener('pointerdown', (e) => {
+          pressedOutside = outside(e, dialog);
+        });
+        dialog.addEventListener('pointerup', (e) => {
+          if (pressedOutside && outside(e, dialog)) dialog.close();
+        });
+      }
+    }
+
+    /**
+     * Relocates the open modal dialog to a new parent container using the native
+     * state-preserving moveBefore() API, with a fallback for unsupported browsers
+     * that manually re-opens the modal and restores focus/selection state.
+     */
+    function relocateFeedbackDialog(targetParent) {
+      if (!targetParent || !feedbackDialog) return;
+
+      const wasOpen =
+        feedbackDialog.hasAttribute('open') ||
+        (typeof feedbackDialog.matches === 'function' && feedbackDialog.matches(':popover-open'));
+      const previouslyFocused =
+        feedbackDialog.contains(document.activeElement) ? document.activeElement : moveDialogBtn;
+      const selectionStart =
+        previouslyFocused && typeof previouslyFocused.selectionStart === 'number'
+          ? previouslyFocused.selectionStart
+          : null;
+      const selectionEnd =
+        previouslyFocused && typeof previouslyFocused.selectionEnd === 'number'
+          ? previouslyFocused.selectionEnd
+          : null;
+
+      if ('moveBefore' in Element.prototype) {
+        // Native atomic move preserves top-layer modal openness and active focus state
+        targetParent.moveBefore(feedbackDialog, null);
+        moveStatusText.textContent = `Relocated via native moveBefore() to #${targetParent.id}`;
+      } else {
+        // Fallback: traditional DOM move closes top-layer elements and resets focus
+        targetParent.insertBefore(feedbackDialog, null);
+
+        // Manually restore modal / popover open state
+        if (wasOpen && typeof feedbackDialog.showModal === 'function') {
+          feedbackDialog.showModal();
+        } else if (wasOpen && typeof feedbackDialog.showPopover === 'function') {
+          feedbackDialog.showPopover();
+        }
+
+        // Restore focus and text selection state inside the reparented dialog
+        if (previouslyFocused && typeof previouslyFocused.focus === 'function') {
+          previouslyFocused.focus();
+          if (
+            selectionStart !== null &&
+            selectionEnd !== null &&
+            typeof previouslyFocused.setSelectionRange === 'function'
+          ) {
+            previouslyFocused.setSelectionRange(selectionStart, selectionEnd);
+          }
+        }
+        moveStatusText.textContent = `Relocated via fallback insertBefore() + showModal() to #${targetParent.id}`;
+      }
+
+      // Update host indicators
+      hostContainers.forEach((host) => {
+        host.dataset.hasDialog = String(host === targetParent);
+      });
+      parentIndicator.textContent = `Current DOM Parent: #${targetParent.id}`;
+    }
+
+    moveDialogBtn.addEventListener('click', () => {
+      const currentParent = feedbackDialog.parentElement;
+      const currentIndex = hostContainers.indexOf(currentParent);
+      const nextParent = hostContainers[(currentIndex + 1) % hostContainers.length];
+      relocateFeedbackDialog(nextParent);
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      const action = feedbackDialog.returnValue;
+      feedbackDialog.returnValue = '';
+      if (action === 'submit') {
+        feedbackToast.textContent = 'Thank you for sharing your coffee feedback!';
+      }
+    });
+  </script>
