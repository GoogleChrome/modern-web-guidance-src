+  <button type="button" id="open-feedback-btn" class="feedback-trigger-btn" aria-haspopup="dialog" aria-controls="feedback-dialog">
+    <span>&#9749; Feedback Overlay</span>
+  </button>
+
+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-dialog');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const closeBtn = document.getElementById('close-feedback-btn');
+      const moveBtn = document.getElementById('move-feedback-btn');
+      const feedbackForm = document.getElementById('feedback-form');
+      const commentInput = document.getElementById('feedback-comment');
+      const parentStatusEl = document.getElementById('feedback-current-parent');
+      const methodStatusEl = document.getElementById('feedback-move-method');
+      const moveCountEl = document.getElementById('feedback-move-count');
+      const apiBadgeEl = document.getElementById('feedback-api-badge');
+      const submitMsgEl = document.getElementById('feedback-submit-msg');
+
+      const hosts = [
+        document.getElementById('feedback-host-main'),
+        document.getElementById('feedback-host-footer'),
+        document.getElementById('feedback-host-overlay')
+      ];
+
+      let moveCount = 0;
+      let lastOpenMode = 'modal'; // 'modal' | 'non-modal' | 'popover'
+
+      function isDialogOpen(el) {
+        if (!el) return false;
+        if (el.open) return true;
+        try {
+          if (el.matches(':popover-open') || el.matches(':modal')) return true;
+        } catch (_) {}
+        return false;
+      }
+
+      function detectOpenMode(el) {
+        try {
+          if (el.matches(':modal')) return 'modal';
+        } catch (_) {}
+        try {
+          if (el.matches(':popover-open')) return 'popover';
+        } catch (_) {}
+        if (el.open) return 'non-modal';
+        return lastOpenMode;
+      }
+
+      function openFeedbackModal(preferredMode = 'modal', restoreFocusEl = null) {
+        lastOpenMode = preferredMode;
+        if (!isDialogOpen(dialog)) {
+          try {
+            if (preferredMode === 'popover' && typeof dialog.showPopover === 'function') {
+              dialog.showPopover();
+            } else if (preferredMode === 'non-modal' && typeof dialog.show === 'function') {
+              dialog.show();
+            } else if (typeof dialog.showModal === 'function') {
+              dialog.showModal();
+            } else if (typeof dialog.show === 'function') {
+              dialog.show();
+            } else {
+              dialog.setAttribute('open', '');
+            }
+          } catch (_) {
+            // If dialog had a popover or state conflict, fall back to show() / open attribute
+            try {
+              dialog.removeAttribute('popover');
+              if (typeof dialog.showModal === 'function') {
+                dialog.showModal();
+              } else {
+                dialog.setAttribute('open', '');
+              }
+            } catch (_err) {
+              dialog.setAttribute('open', '');
+            }
+          }
+        }
+
+        const targetFocus = restoreFocusEl && dialog.contains(restoreFocusEl)
+          ? restoreFocusEl
+          : commentInput;
+        if (targetFocus && typeof targetFocus.focus === 'function') {
+          targetFocus.focus({ preventScroll: true });
+        }
+      }
+
+      function closeFeedbackModal() {
+        try {
+          if (dialog.matches && dialog.matches(':popover-open') && typeof dialog.hidePopover === 'function') {
+            dialog.hidePopover();
+          }
+        } catch (_) {}
+        if (typeof dialog.close === 'function' && dialog.open) {
+          dialog.close();
+        } else {
+          dialog.removeAttribute('open');
+        }
+      }
+
+      function updateHostUI(activeHost, methodLabel) {
+        hosts.forEach((host) => {
+          const isCurrent = host === activeHost;
+          host.classList.toggle('active-parent', isCurrent);
+          const indicator = host.querySelector('[id$="-indicator"]');
+          if (indicator) {
+            indicator.textContent = isCurrent ? 'Active Parent' : 'Standby';
+          }
+        });
+        parentStatusEl.textContent = `#${activeHost.id}`;
+        if (methodLabel) {
+          methodStatusEl.textContent = methodLabel;
+        }
+        moveCountEl.textContent = String(moveCount);
+      }
+
+      /**
+       * Relocates the open feedback dialog to targetContainer using the native
+       * state-preserving `moveBefore` API when supported, or falls back to
+       * standard DOM insertion + manual modal state and focus restoration.
+       */
+      function relocateFeedbackModal(targetContainer, referenceNode = null) {
+        if (!targetContainer || dialog.parentElement === targetContainer) {
+          return { moved: false, usedMoveBefore: false };
+        }
+
+        const wasOpen = isDialogOpen(dialog);
+        const activeMode = detectOpenMode(dialog);
+
+        // Snapshot form and focus/selection state in case fallback or focus restore is needed
+        const prevActive = document.activeElement;
+        const hadFocusInside = dialog.contains(prevActive);
+        const focusTarget = hadFocusInside ? prevActive : moveBtn;
+        let selectionSnapshot = null;
+        if (
+          focusTarget &&
+          (focusTarget.tagName === 'TEXTAREA' || focusTarget.tagName === 'INPUT') &&
+          typeof focusTarget.selectionStart === 'number'
+        ) {
+          try {
+            selectionSnapshot = {
+              start: focusTarget.selectionStart,
+              end: focusTarget.selectionEnd,
+              direction: focusTarget.selectionDirection
+            };
+          } catch (_) {}
+        }
+
+        const formSnapshot = {
+          drink: document.getElementById('feedback-drink').value,
+          rating: document.getElementById('feedback-rating').value,
+          comment: commentInput.value,
+          scrollTop: dialog.scrollTop
+        };
+
+        let usedMoveBefore = false;
+
+        if (typeof targetContainer.moveBefore === 'function') {
+          try {
+            targetContainer.moveBefore(dialog, referenceNode);
+            usedMoveBefore = true;
+          } catch (_) {
+            usedMoveBefore = false;
+          }
+        }
+
+        if (!usedMoveBefore) {
+          // Fallback for browsers without native moveBefore support
+          targetContainer.insertBefore(dialog, referenceNode);
+        }
+
+        // Restore form values if any browser reset occurred
+        document.getElementById('feedback-drink').value = formSnapshot.drink;
+        document.getElementById('feedback-rating').value = formSnapshot.rating;
+        commentInput.value = formSnapshot.comment;
+
+        // Ensure the modal remains open after reparenting (fallback re-opens it)
+        if (wasOpen && !isDialogOpen(dialog)) {
+          openFeedbackModal(activeMode, focusTarget);
+        }
+
+        dialog.scrollTop = formSnapshot.scrollTop;
+
+        // Ensure focus and text selection remain active inside the modal
+        if (focusTarget && typeof focusTarget.focus === 'function') {
+          if (document.activeElement !== focusTarget) {
+            focusTarget.focus({ preventScroll: true });
+          }
+          if (selectionSnapshot && typeof focusTarget.setSelectionRange === 'function') {
+            try {
+              focusTarget.setSelectionRange(
+                selectionSnapshot.start,
+                selectionSnapshot.end,
+                selectionSnapshot.direction || 'none'
+              );
+            } catch (_) {}
+          }
+        }
+
+        moveCount += 1;
+        const methodDesc = usedMoveBefore
+          ? 'Element.prototype.moveBefore (State-Preserving)'
+          : 'insertBefore + Manual Re-open & State Restore (Fallback)';
+        apiBadgeEl.textContent = usedMoveBefore ? 'moveBefore API' : 'Fallback Mode';
+        updateHostUI(targetContainer, methodDesc);
+
+        return { moved: true, usedMoveBefore };
+      }
+
+      moveBtn.addEventListener('click', () => {
+        const currentParent = dialog.parentElement;
+        const currentIndex = hosts.indexOf(currentParent);
+        const nextHost = hosts[(currentIndex + 1) % hosts.length];
+        relocateFeedbackModal(nextHost, null);
+      });
+
+      openBtn.addEventListener('click', () => {
+        openFeedbackModal('modal', commentInput);
+      });
+
+      closeBtn.addEventListener('click', () => {
+        closeFeedbackModal();
+      });
+
+      feedbackForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        submitMsgEl.style.display = 'block';
+      });
+
+      // Expose helper for programmatic testing if needed
+      window.relocateFeedbackModal = relocateFeedbackModal;
+
+      // Open the persistent feedback overlay modal on initial load
+      openFeedbackModal('modal', commentInput);
+    })();
+  </script>
 </body>
 
