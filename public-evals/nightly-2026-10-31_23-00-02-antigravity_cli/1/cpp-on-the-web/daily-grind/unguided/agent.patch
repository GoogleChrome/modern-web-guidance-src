+  <script>
+    const WIDTH = 256;
+    const HEIGHT = 192;
+    const TARGET_PASSES = 12; // 12 passes * 4 subpixels = 48 samples/pixel progressive refinement
+
+    const SPHERE_LABELS = [
+      { index: 0, name: 'Left Sphere (Wall)' },
+      { index: 1, name: 'Right Sphere (Wall)' },
+      { index: 2, name: 'Back Sphere (Wall)' },
+      { index: 4, name: 'Bottom Sphere (Floor)' },
+      { index: 5, name: 'Top Sphere (Ceiling)' },
+      { index: 6, name: 'Mirror Sphere' },
+      { index: 7, name: 'Glass Sphere' }
+    ];
+
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const imageData = ctx.createImageData(WIDTH, HEIGHT);
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const statusText = document.getElementById('status-text');
+    const statsText = document.getElementById('stats-text');
+    const swatchesContainer = document.getElementById('swatches');
+
+    let wasmReady = false;
+    let currentPass = 0;
+    let rafId = null;
+    let seedCounter = 1;
+    let renderStartTime = 0;
+
+    function toSrgbCss(r, g, b) {
+      const gamma = (v) => Math.min(255, Math.max(0, Math.round(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255)));
+      return `rgb(${gamma(r)}, ${gamma(g)}, ${gamma(b)})`;
+    }
+
+    function updateSwatches() {
+      if (!wasmReady) return;
+      swatchesContainer.innerHTML = '';
+      for (const item of SPHERE_LABELS) {
+        const r = Module._get_sphere_color_r(item.index);
+        const g = Module._get_sphere_color_g(item.index);
+        const b = Module._get_sphere_color_b(item.index);
+
+        const el = document.createElement('div');
+        el.className = 'swatch-item';
+
+        const dot = document.createElement('span');
+        dot.className = 'swatch-color';
+        dot.style.backgroundColor = toSrgbCss(r, g, b);
+
+        const label = document.createElement('span');
+        label.className = 'swatch-label';
+        label.textContent = item.name;
+
+        el.appendChild(dot);
+        el.appendChild(label);
+        swatchesContainer.appendChild(el);
+      }
+    }
+
+    function blitWasmBuffer(ptr) {
+      const wasmBytes = new Uint8ClampedArray(Module.HEAPU8.buffer, ptr, WIDTH * HEIGHT * 4);
+      imageData.data.set(wasmBytes);
+      ctx.putImageData(imageData, 0, 0);
+    }
+
+    function runPass(reset) {
+      const seedOffset = seedCounter * 97 + currentPass * 31;
+      const ptr = Module._render_samples(WIDTH, HEIGHT, 1, reset ? 1 : 0, seedOffset);
+      blitWasmBuffer(ptr);
+      currentPass++;
+      const totalSpp = Module._get_total_samples();
+      const elapsedSec = ((performance.now() - renderStartTime) / 1000).toFixed(2);
+      if (currentPass < TARGET_PASSES) {
+        statusText.textContent = `Path tracing... (${totalSpp} spp)`;
+      } else {
+        statusText.textContent = `Render complete (${totalSpp} spp)`;
+      }
+      statsText.textContent = `${WIDTH} × ${HEIGHT} • ${totalSpp} samples/px • ${elapsedSec}s`;
+    }
+
+    function scheduleProgressivePasses() {
+      if (rafId !== null) {
+        cancelAnimationFrame(rafId);
+        rafId = null;
+      }
+      function step() {
+        if (currentPass >= TARGET_PASSES) {
+          rafId = null;
+          return;
+        }
+        runPass(false);
+        if (currentPass < TARGET_PASSES) {
+          rafId = requestAnimationFrame(step);
+        }
+      }
+      rafId = requestAnimationFrame(step);
+    }
+
+    function startRender(randomizeColors) {
+      if (!wasmReady) return;
+      if (rafId !== null) {
+        cancelAnimationFrame(rafId);
+        rafId = null;
+      }
+      seedCounter++;
+      if (randomizeColors) {
+        const randomSeed = ((Date.now() & 0xffffffff) ^ (seedCounter * 2654435761)) >>> 0;
+        Module._randomize_sphere_colors(randomSeed || seedCounter);
+      }
+      updateSwatches();
+      currentPass = 0;
+      renderStartTime = performance.now();
+      // Run the first pass immediately so the canvas updates synchronously on load and button click
+      runPass(true);
+      // Refine progressively across subsequent animation frames
+      scheduleProgressivePasses();
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      startRender(true);
+    });
 
+    var Module = {
+      onRuntimeInitialized: function () {
+        wasmReady = true;
+        randomizeBtn.disabled = false;
+        startRender(false);
+      }
+    };
+  </script>
+  <script src="smallpt.js"></script>
