+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+extern "C" {
+
+void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) {
+    spheres[index].c = Vec(r, g, b);
+  }
+}
+
+void reset_sphere_colors() {
+  spheres[0].c = Vec(.75, .25, .25);
+  spheres[1].c = Vec(.25, .25, .75);
+  spheres[2].c = Vec(.75, .75, .75);
+  spheres[3].c = Vec(0, 0, 0);
+  spheres[4].c = Vec(.75, .75, .75);
+  spheres[5].c = Vec(.75, .75, .75);
+  spheres[6].c = Vec(1, 1, 1) * .999;
+  spheres[7].c = Vec(1, 1, 1) * .999;
+  spheres[8].c = Vec(0, 0, 0);
+}
+
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)((seed * 31337u) & 0xFFFF)
+  };
+  // Randomize Left, Right, Back, Bottom, Top, Mirror, and Glass spheres
+  const int indices[] = {0, 1, 2, 4, 5, 6, 7};
+  for (int idx : indices) {
+    double r = 0.15 + 0.80 * erand48(Xi);
+    double g = 0.15 + 0.80 * erand48(Xi);
+    double b = 0.15 + 0.80 * erand48(Xi);
+    if (idx == 6 || idx == 7) {
+      // Keep specular and refractive spheres bright & vivid
+      r = 0.45 + 0.549 * erand48(Xi);
+      g = 0.45 + 0.549 * erand48(Xi);
+      b = 0.45 + 0.549 * erand48(Xi);
+    }
+    spheres[idx].c = Vec(r, g, b);
+  }
+}
+
+void render_frame(uint8_t *out_rgba, int w, int h, int samps) {
+  if (samps < 1) samps = 1;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+  Vec *c = (Vec *)calloc(w * h, sizeof(Vec));
+
+  for (int y=0; y<h; y++){                       // Loop over image rows
+    for (unsigned short x=0, Xi[3]={0,0,(unsigned short)(y*y*y)}; x<w; x++)   // Loop cols
+      for (int sy=0, i=(h-y-1)*w+x; sy<2; sy++)     // 2x2 subpixel rows
+        for (int sx=0; sx<2; sx++, r=Vec()){        // 2x2 subpixel cols
+          for (int s=0; s<samps; s++){
+            double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+            double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+            Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                    cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+          } // Camera rays are pushed ^^^^^ forward to start in interior
+          c[i] = c[i] + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+        }
+  }
+
+  for (int i=0; i<w*h; i++) {
+    out_rgba[i*4 + 0] = (uint8_t)toInt(c[i].x);
+    out_rgba[i*4 + 1] = (uint8_t)toInt(c[i].y);
+    out_rgba[i*4 + 2] = (uint8_t)toInt(c[i].z);
+    out_rgba[i*4 + 3] = 255;
+  }
+
+  free(c);
+}
+
+}
