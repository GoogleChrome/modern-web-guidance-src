@@ -0,0 +1,77 @@
+import initSmallpt from './smallpt.js';
+
+let wasmPromise = null;
+
+function getWasm() {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt();
+  }
+  return wasmPromise;
+}
+
+self.addEventListener('message', async (event) => {
+  const {
+    width = 320,
+    height = 240,
+    samples = 2,
+    randomize = false,
+    colors = null,
+    seed = Date.now(),
+    requestId = 0,
+  } = event.data || {};
+
+  try {
+    const wasm = await getWasm();
+
+    if (Array.isArray(colors)) {
+      wasm._reset_sphere_colors();
+      for (const item of colors) {
+        if (item && typeof item.index === 'number') {
+          wasm._set_sphere_color(item.index, item.r, item.g, item.b);
+        }
+      }
+    } else if (randomize) {
+      wasm._randomize_sphere_colors(seed >>> 0);
+    } else {
+      wasm._reset_sphere_colors();
+    }
+
+    const byteLength = width * height * 4;
+    const ptr = wasm._malloc(byteLength);
+    if (!ptr) {
+      throw new Error('Failed to allocate WebAssembly linear memory buffer.');
+    }
+
+    const startTime = performance.now();
+    try {
+      wasm._render_frame(ptr, width, height, samples);
+      const elapsedMs = performance.now() - startTime;
+      const pixels = new Uint8ClampedArray(
+        wasm.HEAPU8.buffer,
+        ptr,
+        byteLength,
+      ).slice();
+
+      self.postMessage(
+        {
+          type: 'rendered',
+          requestId,
+          width,
+          height,
+          samples: samples * 4,
+          elapsedMs,
+          pixels,
+        },
+        [pixels.buffer],
+      );
+    } finally {
+      wasm._free(ptr);
+    }
+  } catch (error) {
+    self.postMessage({
+      type: 'error',
+      requestId,
+      message: error instanceof Error ? error.message : String(error),
+    });
+  }
+});
