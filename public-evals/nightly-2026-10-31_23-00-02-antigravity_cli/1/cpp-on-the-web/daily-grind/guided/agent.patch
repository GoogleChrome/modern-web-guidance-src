new file mode 100644
index 0000000..9382426
--- /dev/null
+++ b/app.js
@@ -0,0 +1,149 @@
+const DEFAULT_SPHERES = [
+  { index: 0, name: 'Left Wall', r: 0.75, g: 0.25, b: 0.25 },
+  { index: 1, name: 'Right Wall', r: 0.25, g: 0.25, b: 0.75 },
+  { index: 2, name: 'Back Wall', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 4, name: 'Floor', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 5, name: 'Ceiling', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 6, name: 'Mirror Sphere', r: 0.999, g: 0.999, b: 0.999 },
+  { index: 7, name: 'Glass Sphere', r: 0.999, g: 0.999, b: 0.999 },
+];
+
+const canvas = document.getElementById('smallpt-canvas');
+const ctx = canvas.getContext('2d');
+const statusEl = document.getElementById('render-status');
+const randomizeBtn = document.getElementById('randomize-btn');
+const resetBtn = document.getElementById('reset-btn');
+const resolutionSelect = document.getElementById('resolution-select');
+const samplesSelect = document.getElementById('samples-select');
+const swatchListEl = document.getElementById('swatch-list');
+const metricTimeEl = document.getElementById('metric-time');
+const metricSppEl = document.getElementById('metric-spp');
+
+let currentSpheres = DEFAULT_SPHERES.map((s) => ({ ...s }));
+let requestIdCounter = 0;
+let activeRequestId = 0;
+
+function toCssRgb(r, g, b) {
+  const toByte = (v) => Math.round(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255);
+  return `rgb(${toByte(r)} ${toByte(g)} ${toByte(b)})`;
+}
+
+function renderSwatches() {
+  swatchListEl.replaceChildren();
+  for (const sphere of currentSpheres) {
+    const li = document.createElement('li');
+    li.className = 'swatch-item';
+
+    const dot = document.createElement('span');
+    dot.className = 'swatch-dot';
+    dot.setAttribute('aria-hidden', 'true');
+    dot.style.setProperty('--swatch-color', toCssRgb(sphere.r, sphere.g, sphere.b));
+
+    const label = document.createElement('span');
+    label.textContent = sphere.name;
+
+    li.append(dot, label);
+    swatchListEl.append(li);
+  }
+}
+
+function generateRandomSpherePalette() {
+  return DEFAULT_SPHERES.map((sphere) => {
+    const isSpecOrRefr = sphere.index === 6 || sphere.index === 7;
+    const minVal = isSpecOrRefr ? 0.45 : 0.15;
+    const range = isSpecOrRefr ? 0.549 : 0.8;
+    return {
+      ...sphere,
+      r: Number((minVal + Math.random() * range).toFixed(3)),
+      g: Number((minVal + Math.random() * range).toFixed(3)),
+      b: Number((minVal + Math.random() * range).toFixed(3)),
+    };
+  });
+}
+
+function parseResolution() {
+  const [wStr, hStr] = resolutionSelect.value.split('x');
+  return {
+    width: parseInt(wStr, 10) || 320,
+    height: parseInt(hStr, 10) || 240,
+  };
+}
+
+function setBusyState(isBusy, message) {
+  randomizeBtn.disabled = isBusy;
+  resetBtn.disabled = isBusy;
+  resolutionSelect.disabled = isBusy;
+  samplesSelect.disabled = isBusy;
+  statusEl.textContent = message;
+}
+
+const worker = new Worker(new URL('./worker.js', import.meta.url), {
+  type: 'module',
+});
+
+worker.addEventListener('message', (event) => {
+  const data = event.data;
+  if (!data || data.requestId !== activeRequestId) {
+    return;
+  }
+
+  if (data.type === 'rendered') {
+    const { width, height, samples, elapsedMs, pixels } = data;
+    if (canvas.width !== width || canvas.height !== height) {
+      canvas.width = width;
+      canvas.height = height;
+    }
+    const imageData = new ImageData(pixels, width, height);
+    ctx.putImageData(imageData, 0, 0);
+
+    const formattedTime = `${Math.round(elapsedMs)} ms`;
+    metricTimeEl.textContent = formattedTime;
+    metricSppEl.textContent = `${samples} spp`;
+    setBusyState(false, `Rendered ${width}\u00d7${height} (${samples} spp) in ${formattedTime}`);
+  } else if (data.type === 'error') {
+    setBusyState(false, `Render error: ${data.message}`);
+  }
+});
+
+worker.addEventListener('error', (err) => {
+  setBusyState(false, `Worker error: ${err.message || 'Unknown error'}`);
+});
+
+function triggerRender() {
+  const { width, height } = parseResolution();
+  const samples = parseInt(samplesSelect.value, 10) || 2;
+  activeRequestId = ++requestIdCounter;
+
+  renderSwatches();
+  metricSppEl.textContent = `${samples * 4} spp`;
+  setBusyState(true, `Rendering ${width}\u00d7${height} at ${samples * 4} spp in WebAssembly...`);
+
+  worker.postMessage({
+    requestId: activeRequestId,
+    width,
+    height,
+    samples,
+    colors: currentSpheres,
+  });
+}
+
+randomizeBtn.addEventListener('click', () => {
+  currentSpheres = generateRandomSpherePalette();
+  triggerRender();
+});
+
+resetBtn.addEventListener('click', () => {
+  currentSpheres = DEFAULT_SPHERES.map((s) => ({ ...s }));
+  triggerRender();
+});
+
+resolutionSelect.addEventListener('change', () => {
+  triggerRender();
+});
+
+samplesSelect.addEventListener('change', () => {
+  triggerRender();
+});
+
+// Initial render on load
+triggerRender();
