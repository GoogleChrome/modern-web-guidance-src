+import initSmallpt from './smallpt.js';
+
+let wasmPromise = null;
+
+function getWasm() {
+  if (!wasmPromise) {
+    wasmPromise = initSmallpt();
+  }
+  return wasmPromise;
+}
+
+self.addEventListener('message', async (event) => {
+  const {
+    type,
+    width = 320,
+    height = 240,
+    samples = 4,
+    randomize = false,
+    seed = Date.now(),
+    colors = null,
+    requestId = 0,
+  } = event.data || {};
+
+  if (type !== 'render') return;
+
+  try {
+    const startTime = performance.now();
+    const wasm = await getWasm();
+
+    if (Array.isArray(colors)) {
+      for (const c of colors) {
+        wasm._set_sphere_color(c.index, c.r, c.g, c.b);
+      }
+    } else if (randomize) {
+      wasm._randomize_sphere_colors(seed >>> 0);
+    } else {
+      wasm._reset_default_colors();
+    }
+
+    const byteLength = width * height * 4;
+    const ptr = wasm._malloc(byteLength);
+
+    try {
+      const samplesPerSubpixel = Math.max(1, Math.floor(samples / 4));
+      wasm._render_frame(ptr, width, height, samplesPerSubpixel);
+
+      // Re-read HEAPU8 after Wasm execution in case memory grew
+      const pixels = new Uint8ClampedArray(
+        wasm.HEAPU8.buffer,
+        ptr,
+        byteLength,
+      ).slice();
+
+      const elapsedMs = Math.round(performance.now() - startTime);
+      self.postMessage(
+        {
+          type: 'rendered',
+          requestId,
+          width,
+          height,
+          samples: samplesPerSubpixel * 4,
+          elapsedMs,
+          pixels,
+        },
+        [pixels.buffer],
+      );
+    } finally {
+      wasm._free(ptr);
+    }
+  } catch (err) {
+    self.postMessage({
+      type: 'error',
+      requestId,
+      error: err instanceof Error ? err.message : String(err),
+    });
+  }
+});
