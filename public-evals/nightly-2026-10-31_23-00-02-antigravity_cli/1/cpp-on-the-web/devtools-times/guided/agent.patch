diff --git a/src/components/SmallptPathTracer.tsx b/src/components/SmallptPathTracer.tsx
new file mode 100644
index 0000000..3735458
--- /dev/null
+++ b/src/components/SmallptPathTracer.tsx
@@ -0,0 +1,245 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColor {
+  index: number;
+  name: string;
+  r: number;
+  g: number;
+  b: number;
+}
+
+const DEFAULT_PALETTE: SphereColor[] = [
+  { index: 0, name: 'Left Wall', r: 0.75, g: 0.25, b: 0.25 },
+  { index: 1, name: 'Right Wall', r: 0.25, g: 0.25, b: 0.75 },
+  { index: 2, name: 'Back Wall', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 4, name: 'Floor', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 5, name: 'Ceiling', r: 0.75, g: 0.75, b: 0.75 },
+  { index: 6, name: 'Mirror Sphere', r: 0.999, g: 0.999, b: 0.999 },
+  { index: 7, name: 'Glass Sphere', r: 0.999, g: 0.999, b: 0.999 },
+];
+
+const WIDTH = 320;
+const HEIGHT = 240;
+const SAMPLES = 8; // 8 spp (2 samples per 2x2 subpixel)
+
+function toCssRgb(c: SphereColor): string {
+  // Apply gamma 2.2 approximation to match rendered appearance
+  const toByte = (v: number) => Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255);
+  return `rgb(${toByte(c.r)}, ${toByte(c.g)}, ${toByte(c.b)})`;
+}
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const requestIdRef = useRef<number>(0);
+
+  const [isRendering, setIsRendering] = useState<boolean>(true);
+  const [elapsedMs, setElapsedMs] = useState<number | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [palette, setPalette] = useState<SphereColor[]>(DEFAULT_PALETTE);
+  const [samplesPerPixel, setSamplesPerPixel] = useState<number>(SAMPLES);
+
+  const triggerRender = useCallback(
+    (colorsToUse: SphereColor[], spp: number) => {
+      if (!workerRef.current) return;
+      requestIdRef.current += 1;
+      setIsRendering(true);
+      setError(null);
+
+      workerRef.current.postMessage({
+        type: 'render',
+        requestId: requestIdRef.current,
+        width: WIDTH,
+        height: HEIGHT,
+        samples: spp,
+        colors: colorsToUse.map(({ index, r, g, b }) => ({ index, r, g, b })),
+      });
+    },
+    [],
+  );
+
+  useEffect(() => {
+    const worker = new Worker(
+      new URL('../wasm/smallpt.worker.js', import.meta.url),
+      { type: 'module' },
+    );
+    workerRef.current = worker;
+
+    worker.onmessage = (event: MessageEvent) => {
+      const data = event.data;
+      if (!data || data.requestId !== requestIdRef.current) return;
+
+      if (data.type === 'rendered') {
+        const canvas = canvasRef.current;
+        if (canvas) {
+          const ctx = canvas.getContext('2d');
+          if (ctx) {
+            const imageData = new ImageData(
+              data.pixels,
+              data.width,
+              data.height,
+            );
+            ctx.putImageData(imageData, 0, 0);
+          }
+        }
+        setElapsedMs(data.elapsedMs);
+        setIsRendering(false);
+      } else if (data.type === 'error') {
+        setError(data.error || 'WebAssembly path tracer failed.');
+        setIsRendering(false);
+      }
+    };
+
+    worker.onerror = (err) => {
+      setError(err.message || 'Worker initialization failed.');
+      setIsRendering(false);
+    };
+
+    triggerRender(DEFAULT_PALETTE, SAMPLES);
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, [triggerRender]);
+
+  const handleRandomize = () => {
+    const randomized: SphereColor[] = DEFAULT_PALETTE.map((item) => ({
+      ...item,
+      r: Number((0.15 + Math.random() * 0.8).toFixed(3)),
+      g: Number((0.15 + Math.random() * 0.8).toFixed(3)),
+      b: Number((0.15 + Math.random() * 0.8).toFixed(3)),
+    }));
+    setPalette(randomized);
+    triggerRender(randomized, samplesPerPixel);
+  };
+
+  const handleReset = () => {
+    setPalette(DEFAULT_PALETTE);
+    triggerRender(DEFAULT_PALETTE, samplesPerPixel);
+  };
+
+  return (
+    <section
+      aria-labelledby="smallpt-heading"
+      className="bg-white p-6 md:p-8 shadow-sm border border-gray-200 my-6"
+    >
+      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
+        <div className="lg:col-span-1 flex flex-col justify-between h-full">
+          <div>
+            <span className="text-amber-800 text-sm font-brand tracking-widest uppercase">
+              Interactive Graphics Lab
+            </span>
+            <h2
+              id="smallpt-heading"
+              className="mt-2 text-2xl md:text-3xl font-brand text-gray-900 leading-tight"
+            >
+              smallpt C++ WebAssembly Path Tracer
+            </h2>
+            <p className="mt-3 text-sm md:text-base text-gray-700">
+              Kevin Beason&apos;s 99-line C++ Monte Carlo global illumination
+              renderer compiled to WebAssembly with Emscripten and running
+              client-side in a background Web Worker.
+            </p>
+
+            <div className="mt-4 flex flex-wrap gap-2">
+              {palette.map((sphere) => (
+                <span
+                  key={sphere.index}
+                  className="inline-flex items-center gap-1.5 text-xs bg-gray-100 text-gray-800 px-2 py-1 rounded border border-gray-200"
+                  title={`${sphere.name}: (${sphere.r}, ${sphere.g}, ${sphere.b})`}
+                >
+                  <span
+                    className="w-3 h-3 rounded-full border border-gray-400 inline-block"
+                    style={{ backgroundColor: toCssRgb(sphere) }}
+                  />
+                  {sphere.name}
+                </span>
+              ))}
+            </div>
+          </div>
+
+          <div className="mt-6 pt-4 border-t border-gray-200 flex flex-col gap-3">
+            <div className="flex items-center justify-between text-xs text-gray-600">
+              <label htmlFor="smallpt-spp" className="font-semibold">
+                Samples per pixel (SPP):
+              </label>
+              <select
+                id="smallpt-spp"
+                value={samplesPerPixel}
+                onChange={(e) => {
+                  const nextSpp = Number(e.target.value);
+                  setSamplesPerPixel(nextSpp);
+                  triggerRender(palette, nextSpp);
+                }}
+                disabled={isRendering}
+                className="border border-gray-300 rounded px-2 py-1 bg-white text-gray-900"
+              >
+                <option value={4}>4 SPP (Fast)</option>
+                <option value={8}>8 SPP (Balanced)</option>
+                <option value={16}>16 SPP (High Quality)</option>
+                <option value={32}>32 SPP (Ultra)</option>
+              </select>
+            </div>
+
+            <div className="flex flex-wrap gap-3">
+              <button
+                type="button"
+                id="randomize-spheres-btn"
+                onClick={handleRandomize}
+                disabled={isRendering}
+                className="flex-1 bg-amber-700 hover:bg-amber-800 disabled:bg-amber-400 text-white font-semibold py-2.5 px-4 rounded transition-colors cursor-pointer disabled:cursor-wait text-sm shadow-xs"
+              >
+                {isRendering
+                  ? 'Rendering in WebAssembly...'
+                  : 'Run Again with Randomized Sphere Colors'}
+              </button>
+
+              <button
+                type="button"
+                onClick={handleReset}
+                disabled={isRendering}
+                className="bg-gray-200 hover:bg-gray-300 disabled:opacity-50 text-gray-800 font-semibold py-2.5 px-3 rounded transition-colors cursor-pointer text-sm"
+              >
+                Reset
+              </button>
+            </div>
+
+            <div
+              className="text-xs text-gray-500 flex justify-between items-center min-h-[1.25rem]"
+              aria-live="polite"
+            >
+              {error ? (
+                <span className="text-red-600 font-medium">{error}</span>
+              ) : isRendering ? (
+                <span>Tracing rays ({WIDTH}&times;{HEIGHT}, {samplesPerPixel} SPP)...</span>
+              ) : (
+                <span>
+                  Rendered {WIDTH}&times;{HEIGHT} ({samplesPerPixel} SPP) in{' '}
+                  <strong>{elapsedMs} ms</strong> via Wasm
+                </span>
+              )}
+            </div>
+          </div>
+        </div>
+
+        <div className="lg:col-span-2 flex flex-col items-center justify-center bg-gray-950 rounded-md overflow-hidden relative aspect-[4/3] w-full">
+          <canvas
+            ref={canvasRef}
+            id="smallpt-canvas"
+            width={WIDTH}
+            height={HEIGHT}
+            className="w-full h-full object-contain"
+          />
+          {isRendering && (
+            <div className="absolute inset-4 pointer-events-none flex items-end justify-end">
+              <span className="bg-black/75 text-amber-300 text-xs font-mono px-2.5 py-1 rounded border border-amber-500/40">
+                WASM PATH TRACING...
+              </span>
+            </div>
+          )}
+        </div>
+      </div>
+    </section>
+  );
+}
