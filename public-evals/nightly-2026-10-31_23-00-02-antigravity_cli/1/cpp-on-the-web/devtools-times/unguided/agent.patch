+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColorInfo {
+  name: string;
+  index: number;
+  material: string;
+  rgb: [number, number, number];
+}
+
+declare global {
+  interface Window {
+    createSmallptModule?: (options?: Record<string, unknown>) => Promise<any>;
+  }
+}
+
+const SPHERE_METADATA: { index: number; name: string; material: string }[] = [
+  { index: 0, name: 'Left Wall', material: 'Diffuse' },
+  { index: 1, name: 'Right Wall', material: 'Diffuse' },
+  { index: 2, name: 'Back Wall', material: 'Diffuse' },
+  { index: 4, name: 'Floor', material: 'Diffuse' },
+  { index: 5, name: 'Ceiling', material: 'Diffuse' },
+  { index: 6, name: 'Left Sphere', material: 'Mirror (SPEC)' },
+  { index: 7, name: 'Right Sphere', material: 'Glass (REFR)' },
+];
+
+const WIDTH = 320;
+const HEIGHT = 240;
+const TARGET_PASSES = 6; // 6 passes * 4 subpixels = 24 spp total progressive
+
+export const SmallptViewer: React.FC<{ baseUrl?: string }> = ({ baseUrl = '/devtools-times/' }) => {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const wasmModuleRef = useRef<any>(null);
+  const animFrameRef = useRef<number | null>(null);
+  const renderJobIdRef = useRef<number>(0);
+
+  const [status, setStatus] = useState<'loading' | 'rendering' | 'ready' | 'error'>('loading');
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [currentSpp, setCurrentSpp] = useState<number>(0);
+  const [renderTimeMs, setRenderTimeMs] = useState<number>(0);
+  const [sphereColors, setSphereColors] = useState<SphereColorInfo[]>([]);
+  const [renderCount, setRenderCount] = useState<number>(0);
+
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const readSphereColorsFromWasm = useCallback((mod: any): SphereColorInfo[] => {
+    return SPHERE_METADATA.map((meta) => {
+      const r = Math.round(Math.pow(Math.max(0, Math.min(1, mod._get_sphere_color_r(meta.index))), 1 / 2.2) * 255);
+      const g = Math.round(Math.pow(Math.max(0, Math.min(1, mod._get_sphere_color_g(meta.index))), 1 / 2.2) * 255);
+      const b = Math.round(Math.pow(Math.max(0, Math.min(1, mod._get_sphere_color_b(meta.index))), 1 / 2.2) * 255);
+      return {
+        ...meta,
+        rgb: [r, g, b],
+      };
+    });
+  }, []);
+
+  const runProgressiveRender = useCallback(
+    (mod: any, randomize: boolean) => {
+      if (animFrameRef.current !== null) {
+        cancelAnimationFrame(animFrameRef.current);
+        animFrameRef.current = null;
+      }
+
+      const jobId = ++renderJobIdRef.current;
+
+      if (randomize) {
+        const seed = Math.floor(Math.random() * 0x7fffffff) + Date.now();
+        mod._randomize_sphere_colors(seed >>> 0);
+      }
+
+      setSphereColors(readSphereColorsFromWasm(mod));
+      mod._init_progressive_render(WIDTH, HEIGHT);
+
+      setStatus('rendering');
+      setCurrentSpp(0);
+      const startTime = performance.now();
+      let pass = 0;
+
+      const step = () => {
+        if (renderJobIdRef.current !== jobId) return;
+
+        const passSeed = (jobId * 1000 + pass + 1) >>> 0;
+        const ptr = mod._step_progressive_render(1, passSeed);
+        pass++;
+
+        const canvas = canvasRef.current;
+        if (canvas) {
+          const ctx = canvas.getContext('2d');
+          if (ctx) {
+            const byteLength = WIDTH * HEIGHT * 4;
+            const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, byteLength);
+            const imageData = ctx.createImageData(WIDTH, HEIGHT);
+            imageData.data.set(pixels);
+            ctx.putImageData(imageData, 0, 0);
+          }
+        }
+
+        const elapsed = Math.round(performance.now() - startTime);
+        setCurrentSpp(pass * 4);
+        setRenderTimeMs(elapsed);
+
+        if (pass < TARGET_PASSES) {
+          animFrameRef.current = requestAnimationFrame(step);
+        } else {
+          setStatus('ready');
+          setRenderCount((c) => c + 1);
+          animFrameRef.current = null;
+        }
+      };
+
+      // Run first pass immediately so output appears right away on the canvas
+      step();
+    },
+    [readSphereColorsFromWasm]
+  );
+
+  useEffect(() => {
+    let cancelled = false;
+
+    async function loadWasm() {
+      try {
+        setStatus('loading');
+        if (!window.createSmallptModule) {
+          await new Promise<void>((resolve, reject) => {
+            const existingScript = document.querySelector('script[data-smallpt-wasm="true"]') as HTMLScriptElement | null;
+            if (existingScript && window.createSmallptModule) {
+              resolve();
+              return;
+            }
+            const script = document.createElement('script');
+            script.src = `${normalizedBase}smallpt.js`;
+            script.async = true;
+            script.dataset.smallptWasm = 'true';
+            script.onload = () => resolve();
+            script.onerror = () => reject(new Error(`Failed to load ${normalizedBase}smallpt.js`));
+            document.head.appendChild(script);
+          });
+        }
+
+        if (cancelled) return;
+        if (!window.createSmallptModule) {
+          throw new Error('createSmallptModule global not found after loading script');
+        }
+
+        const mod = await window.createSmallptModule({
+          locateFile: (path: string) => `${normalizedBase}${path}`,
+        });
+
+        if (cancelled) return;
+        wasmModuleRef.current = mod;
+        runProgressiveRender(mod, false);
+      } catch (err: any) {
+        if (!cancelled) {
+          console.error('Error initializing smallpt WebAssembly:', err);
+          setErrorMessage(err?.message || 'Failed to initialize WebAssembly path tracer.');
+          setStatus('error');
+        }
+      }
+    }
+
+    loadWasm();
+
+    return () => {
+      cancelled = true;
+      if (animFrameRef.current !== null) {
+        cancelAnimationFrame(animFrameRef.current);
+      }
+    };
+  }, [normalizedBase, runProgressiveRender]);
+
+  const handleRandomizeColors = () => {
+    if (!wasmModuleRef.current) return;
+    runProgressiveRender(wasmModuleRef.current, true);
+  };
+
+  const handleResetColors = () => {
+    if (!wasmModuleRef.current) return;
+    wasmModuleRef.current._reset_scene_colors();
+    runProgressiveRender(wasmModuleRef.current, false);
+  };
+
+  return (
+    <section
+      id="smallpt-wasm-section"
+      className="bg-white border border-gray-200 shadow-sm rounded-lg p-6 md:p-8 my-6"
+    >
+      <div className="flex flex-col lg:flex-row gap-8 items-start">
+        {/* Left column: Canvas output */}
+        <div className="w-full lg:w-1/2 flex flex-col items-center">
+          <div className="relative w-full max-w-[480px] aspect-[4/3] bg-gray-950 rounded-md overflow-hidden border border-gray-800 shadow-inner flex items-center justify-center">
+            <canvas
+              ref={canvasRef}
+              id="smallpt-canvas"
+              width={WIDTH}
+              height={HEIGHT}
+              className="w-full h-full object-contain"
+              style={{ imageRendering: 'auto' }}
+            />
+            {status === 'loading' && (
+              <div className="absolute inset-0 flex flex-col items-center justify-center bg-gray-950/80 text-white text-sm">
+                <div className="w-6 h-6 border-2 border-amber-400 border-t-transparent rounded-full animate-spin mb-2" />
+                <span>Compiling &amp; initializing smallpt.wasm...</span>
+              </div>
+            )}
+            {status === 'error' && (
+              <div className="absolute inset-0 flex flex-col items-center justify-center bg-red-950/90 text-red-200 p-4 text-center text-sm">
+                <p className="font-semibold mb-1">WebAssembly Error</p>
+                <p>{errorMessage}</p>
+              </div>
+            )}
+          </div>
+
+          <div className="w-full max-w-[480px] flex flex-wrap justify-between items-center mt-3 text-xs text-gray-600 font-mono">
+            <span>
+              Resolution: {WIDTH}&times;{HEIGHT} ({currentSpp} SPP)
+            </span>
+            <span>
+              Status:{' '}
+              <strong
+                className={
+                  status === 'ready'
+                    ? 'text-emerald-700'
+                    : status === 'rendering'
+                    ? 'text-amber-600'
+                    : 'text-gray-700'
+                }
+              >
+                {status === 'rendering'
+                  ? `Tracing rays (${currentSpp}/${TARGET_PASSES * 4} SPP)...`
+                  : status === 'ready'
+                  ? `Completed in ${renderTimeMs} ms`
+                  : status}
+              </strong>
+            </span>
+          </div>
+        </div>
+
+        {/* Right column: Controls and Scene Info */}
+        <div className="w-full lg:w-1/2 flex flex-col justify-between">
+          <div>
+            <div className="text-amber-800 text-xs font-brand tracking-widest uppercase mb-1">
+              Interactive WebAssembly Graphics Lab
+            </div>
+            <h2 className="text-2xl md:text-3xl font-brand text-gray-900 leading-tight">
+              smallpt: Global Illumination Path Tracer in WebAssembly
+            </h2>
+            <p className="mt-3 text-gray-700 text-sm md:text-base leading-relaxed">
+              Kevin Beason&apos;s 99-line C++ Monte Carlo path tracer (<code className="text-xs bg-gray-100 px-1.5 py-0.5 rounded">smallpt.cpp</code>) compiled directly to WebAssembly with Emscripten. Featuring full global illumination, soft shadows, specular reflection, and dielectric glass refraction—running client-side in your browser.
+            </p>
+          </div>
+
+          {/* Action buttons */}
+          <div className="mt-6 flex flex-wrap items-center gap-3">
+            <button
+              type="button"
+              id="randomize-spheres-btn"
+              onClick={handleRandomizeColors}
+              disabled={status === 'loading'}
+              className="bg-amber-500 hover:bg-amber-600 active:bg-amber-700 disabled:bg-gray-300 text-gray-950 font-semibold px-5 py-2.5 rounded-md shadow-sm transition-colors cursor-pointer text-sm flex items-center gap-2"
+            >
+              <svg
+                xmlns="http://www.w3.org/2000/svg"
+                fill="none"
+                viewBox="0 0 24 24"
+                strokeWidth={2}
+                stroke="currentColor"
+                className="w-4 h-4"
+              >
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"
+                />
+              </svg>
+              Run Again with Randomized Sphere Colors
+            </button>
+
+            <button
+              type="button"
+              id="reset-spheres-btn"
+              onClick={handleResetColors}
+              disabled={status === 'loading'}
+              className="bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium px-4 py-2.5 rounded-md border border-gray-300 transition-colors cursor-pointer text-sm"
+            >
+              Reset Classic Cornell Box
+            </button>
+          </div>
+
+          {/* Active Sphere Palette */}
+          {sphereColors.length > 0 && (
+            <div className="mt-6 pt-5 border-t border-gray-200">
+              <div className="flex items-center justify-between mb-2.5">
+                <h3 className="text-xs font-semibold uppercase tracking-wider text-gray-500">
+                  Current Scene Sphere Colors
+                </h3>
+                <span className="text-xs text-gray-400" data-render-count={renderCount}>
+                  9 Spheres (Cornell Box + Mirror &amp; Glass)
+                </span>
+              </div>
+              <div className="grid grid-cols-2 sm:grid-cols-4 gap-2">
+                {sphereColors.map((sphere) => {
+                  const [r, g, b] = sphere.rgb;
+                  const hex = `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`;
+                  return (
+                    <div
+                      key={sphere.index}
+                      className="flex items-center gap-2 p-1.5 rounded border border-gray-200 bg-gray-50 text-xs"
+                    >
+                      <span
+                        className="w-4 h-4 rounded-full border border-gray-300 flex-shrink-0 shadow-xs"
+                        style={{ backgroundColor: `rgb(${r}, ${g}, ${b})` }}
+                      />
+                      <div className="truncate">
+                        <div className="font-medium text-gray-800 truncate">{sphere.name}</div>
+                        <div className="text-[10px] text-gray-500 font-mono">{hex}</div>
+                      </div>
+                    </div>
+                  );
+                })}
+              </div>
+            </div>
+          )}
+        </div>
+      </div>
+    </section>
+  );
+};
+
+export default SmallptViewer;
