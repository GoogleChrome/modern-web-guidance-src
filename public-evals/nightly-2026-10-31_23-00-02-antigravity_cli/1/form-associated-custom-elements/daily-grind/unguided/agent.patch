+  <script>
+    class StarRating extends HTMLElement {
+      static formAssociated = true;
+
+      static get observedAttributes() {
+        return ['value', 'required', 'disabled', 'max', 'name'];
+      }
+
+      constructor() {
+        super();
+        this._internals = this.attachInternals();
+        this.internals = this._internals;
+        this._value = '';
+        this._defaultValue = undefined;
+        this._fieldsetDisabled = false;
+        this._hoverValue = 0;
+        this._customValidationMessage = '';
+        this._syncingAttr = false;
+
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this._render();
+        this._updateFormValue();
+        this._updateValidity();
+      }
+
+      connectedCallback() {
+        if (this._defaultValue === undefined) {
+          this._defaultValue = this.getAttribute('value') || '';
+        }
+        if (this.hasAttribute('value') && !this._value) {
+          this._value = this._normalizeValue(this.getAttribute('value'));
+        }
+        if (!this.hasAttribute('role')) {
+          this.setAttribute('role', 'radiogroup');
+        }
+        this._updateDisabledUI();
+        this._updateStarsUI();
+        this._updateFormValue();
+        this._updateValidity();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+
+        switch (name) {
+          case 'value':
+            if (!this._syncingAttr) {
+              this._setValueInternal(newValue, { reflectAttribute: false });
+            }
+            break;
+          case 'required':
+            this._updateValidity();
+            this._updateAriaRequired();
+            break;
+          case 'disabled':
+            this._updateDisabledUI();
+            this._updateValidity();
+            break;
+          case 'max':
+            this._render();
+            this._updateDisabledUI();
+            this._updateStarsUI();
+            this._updateValidity();
+            break;
+          case 'name':
+            this._updateFormValue();
+            break;
+        }
+      }
+
+      formAssociatedCallback(form) {
+        this._updateFormValue();
+        this._updateValidity();
+      }
+
+      formDisabledCallback(disabled) {
+        this._fieldsetDisabled = Boolean(disabled);
+        this._updateDisabledUI();
+        this._updateValidity();
+      }
+
+      formResetCallback() {
+        this._customValidationMessage = '';
+        this._hoverValue = 0;
+        const resetVal = this._defaultValue !== undefined ? this._defaultValue : '';
+        this._setValueInternal(resetVal, { reflectAttribute: true });
+      }
+
+      formStateRestoreCallback(state, mode) {
+        if (state instanceof FormData) {
+          const restored = this.name ? state.get(this.name) : '';
+          this.value = restored !== null && restored !== undefined ? String(restored) : '';
+        } else {
+          this.value = state !== null && state !== undefined ? String(state) : '';
+        }
+      }
+
+      get form() {
+        return this._internals.form;
+      }
+
+      get name() {
+        return this.getAttribute('name') || '';
+      }
+
+      set name(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('name');
+        } else {
+          this.setAttribute('name', String(val));
+        }
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get max() {
+        const parsed = parseInt(this.getAttribute('max') || '5', 10);
+        return Number.isFinite(parsed) && parsed > 0 ? parsed : 5;
+      }
+
+      set max(val) {
+        this.setAttribute('max', String(val));
+      }
+
+      get value() {
+        return this._value;
+      }
+
+      set value(val) {
+        this._setValueInternal(val, { reflectAttribute: true });
+      }
+
+      get required() {
+        return this.hasAttribute('required');
+      }
+
+      set required(val) {
+        if (val) {
+          this.setAttribute('required', '');
+        } else {
+          this.removeAttribute('required');
+        }
+      }
+
+      get disabled() {
+        return Boolean(this._fieldsetDisabled || this.hasAttribute('disabled'));
+      }
+
+      set disabled(val) {
+        if (val) {
+          this.setAttribute('disabled', '');
+        } else {
+          this.removeAttribute('disabled');
+        }
+      }
+
+      get validity() {
+        return this._internals.validity;
+      }
+
+      get validationMessage() {
+        return this._internals.validationMessage;
+      }
+
+      get willValidate() {
+        return this._internals.willValidate;
+      }
+
+      checkValidity() {
+        return this._internals.checkValidity();
+      }
+
+      reportValidity() {
+        return this._internals.reportValidity();
+      }
+
+      setCustomValidity(message = '') {
+        this._customValidationMessage = String(message || '');
+        this._updateValidity();
+      }
+
+      _normalizeValue(val) {
+        if (val === null || val === undefined || val === '') {
+          return '';
+        }
+        const num = Number(val);
+        if (!Number.isFinite(num) || num < 1) {
+          return '';
+        }
+        const clamped = Math.min(Math.floor(num), this.max);
+        return String(clamped);
+      }
+
+      _setValueInternal(val, { reflectAttribute = true } = {}) {
+        const normalized = this._normalizeValue(val);
+        this._value = normalized;
+
+        if (reflectAttribute) {
+          this._syncingAttr = true;
+          if (normalized) {
+            this.setAttribute('value', normalized);
+          } else {
+            this.removeAttribute('value');
+          }
+          this._syncingAttr = false;
+        }
+
+        this._updateFormValue();
+        this._updateValidity();
+        this._updateStarsUI();
+      }
+
+      _updateFormValue() {
+        if (this._value) {
+          this._internals.setFormValue(this._value, this._value);
+        } else {
+          this._internals.setFormValue(null, '');
+        }
+      }
+
+      _updateValidity() {
+        const firstStar = this.shadowRoot ? this.shadowRoot.querySelector('button.star') : undefined;
+        if (this._customValidationMessage) {
+          this._internals.setValidity(
+            { customError: true },
+            this._customValidationMessage,
+            firstStar || undefined
+          );
+        } else if (this.required && !this._value) {
+          this._internals.setValidity(
+            { valueMissing: true },
+            'Please select a star rating.',
+            firstStar || undefined
+          );
+        } else {
+          this._internals.setValidity({});
+        }
+      }
+
+      _updateAriaRequired() {
+        const group = this.shadowRoot && this.shadowRoot.querySelector('.stars');
+        if (group) {
+          group.setAttribute('aria-required', this.required ? 'true' : 'false');
+        }
+        this.setAttribute('aria-required', this.required ? 'true' : 'false');
+      }
+
+      _updateDisabledUI() {
+        const isDisabled = this.disabled;
+        const group = this.shadowRoot && this.shadowRoot.querySelector('.stars');
+        if (group) {
+          group.classList.toggle('disabled', isDisabled);
+          group.setAttribute('aria-disabled', isDisabled ? 'true' : 'false');
+        }
+        this.setAttribute('aria-disabled', isDisabled ? 'true' : 'false');
+
+        const buttons = this.shadowRoot ? this.shadowRoot.querySelectorAll('button.star') : [];
+        buttons.forEach((btn) => {
+          btn.disabled = isDisabled;
+        });
+      }
+
+      _updateStarsUI() {
+        const selectedNum = Number(this._value) || 0;
+        const displayNum = this._hoverValue || selectedNum;
+        const buttons = this.shadowRoot ? this.shadowRoot.querySelectorAll('button.star') : [];
+
+        buttons.forEach((btn) => {
+          const starVal = Number(btn.dataset.value);
+          const isSelected = starVal <= selectedNum;
+          const isHighlighted = starVal <= displayNum;
+          const isExact = starVal === selectedNum;
+
+          btn.classList.toggle('selected', isSelected);
+          btn.classList.toggle('active', isSelected);
+          btn.classList.toggle('filled', isHighlighted);
+          btn.dataset.selected = isSelected ? 'true' : 'false';
+          btn.setAttribute('aria-checked', isExact ? 'true' : 'false');
+        });
+
+        const statusText = this.shadowRoot && this.shadowRoot.querySelector('.rating-text');
+        if (statusText) {
+          statusText.textContent = selectedNum
+            ? `${selectedNum} of ${this.max} stars`
+            : 'No rating selected';
+        }
+      }
+
+      _selectByUser(val) {
+        if (this.disabled) return;
+        const prev = this._value;
+        this.value = val;
+        if (this._value !== prev) {
+          this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+          this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+        }
+      }
+
+      _render() {
+        const maxStars = this.max;
+        let buttonsHtml = '';
+        for (let i = 1; i <= maxStars; i++) {
+          const label = i === 1 ? '1 star' : `${i} stars`;
+          buttonsHtml += `
+            <button
+              type="button"
+              class="star"
+              part="star"
+              role="radio"
+              data-value="${i}"
+              data-rating="${i}"
+              value="${i}"
+              aria-checked="false"
+              aria-label="${label}"
+              title="${label}"
+            >★</button>
+          `;
+        }
+
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-flex;
+              align-items: center;
+              user-select: none;
+            }
+            .stars {
+              display: inline-flex;
+              align-items: center;
+              gap: 6px;
+            }
+            .stars.disabled {
+              opacity: 0.55;
+              cursor: not-allowed;
+            }
+            button.star {
+              appearance: none;
+              background: transparent;
+              border: none;
+              font-size: 2rem;
+              line-height: 1;
+              padding: 2px 4px;
+              cursor: pointer;
+              color: #d7ccc8;
+              transition: color 0.15s ease, transform 0.1s ease;
+              border-radius: 4px;
+            }
+            button.star:hover:not(:disabled),
+            button.star:focus-visible:not(:disabled) {
+              transform: scale(1.12);
+            }
+            button.star:focus-visible {
+              outline: 2px solid #4e342e;
+              outline-offset: 2px;
+            }
+            button.star.filled,
+            button.star.selected,
+            button.star.active {
+              color: #ffab40;
+            }
+            button.star:disabled {
+              cursor: not-allowed;
+              transform: none;
+            }
+            .rating-text {
+              margin-left: 10px;
+              font-size: 0.9rem;
+              color: #5d4037;
+            }
+          </style>
+          <div class="stars" role="radiogroup" aria-label="Star rating">
+            ${buttonsHtml}
+            <span class="rating-text" part="label">No rating selected</span>
+          </div>
+        `;
+
+        const group = this.shadowRoot.querySelector('.stars');
+        const buttons = this.shadowRoot.querySelectorAll('button.star');
+
+        buttons.forEach((btn) => {
+          btn.addEventListener('click', () => {
+            if (this.disabled) return;
+            this._selectByUser(btn.dataset.value);
+          });
+
+          btn.addEventListener('mouseenter', () => {
+            if (this.disabled) return;
+            this._hoverValue = Number(btn.dataset.value) || 0;
+            this._updateStarsUI();
+          });
+        });
+
+        group.addEventListener('mouseleave', () => {
+          if (this._hoverValue !== 0) {
+            this._hoverValue = 0;
+            this._updateStarsUI();
+          }
+        });
+
+        group.addEventListener('keydown', (e) => {
+          if (this.disabled) return;
+          const current = Number(this._value) || 0;
+          let next = null;
+
+          if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
+            next = Math.min(this.max, current + 1);
+          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
+            next = Math.max(1, current > 1 ? current - 1 : 1);
+          } else if (e.key === 'Home') {
+            next = 1;
+          } else if (e.key === 'End') {
+            next = this.max;
+          } else if (/^[1-9]$/.test(e.key)) {
+            const num = Number(e.key);
+            if (num <= this.max) {
+              next = num;
+            }
+          }
+
+          if (next !== null) {
+            e.preventDefault();
+            this._selectByUser(String(next));
+            const targetBtn = this.shadowRoot.querySelector(`button.star[data-value="${next}"]`);
+            if (targetBtn) {
+              targetBtn.focus();
+            }
+          }
+        });
+      }
+    }
+
+    if (!customElements.get('star-rating')) {
+      customElements.define('star-rating', StarRating);
+    }
+    window.StarRating = StarRating;
+
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    if (feedbackForm && feedbackStatus) {
+      feedbackForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!feedbackForm.checkValidity()) {
+          feedbackForm.reportValidity();
+          return;
+        }
+        const formData = new FormData(feedbackForm);
+        const rating = formData.get('rating');
+        const coffee = formData.get('coffee') || 'coffee';
+        feedbackStatus.textContent = `Thank you for rating our ${coffee} ${rating} out of 5 stars!`;
+        feedbackStatus.classList.add('visible');
+      });
+
+      feedbackForm.addEventListener('reset', () => {
+        feedbackStatus.textContent = '';
+        feedbackStatus.classList.remove('visible');
+      });
+    }
+  </script>
+
 </body>
 
