+  <script>
+    const supportsFACE =
+      'attachInternals' in HTMLElement.prototype &&
+      'setFormValue' in ElementInternals.prototype;
+
+    class StarRating extends HTMLElement {
+      static formAssociated = true;
+      static observedAttributes = ['value', 'required'];
+
+      #internals = null;
+      #value = '';
+      #fallbackInput = null;
+
+      constructor() {
+        super();
+        if (supportsFACE) {
+          this.#internals = this.attachInternals();
+        }
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-block;
+              --_star-active: var(--star-active, #ffab40);
+              --_star-inactive: var(--star-inactive, #d7ccc8);
+              --_star-stroke: var(--star-stroke, #4e342e);
+              --_star-focus: var(--star-focus, #4e342e);
+            }
+
+            :host(:disabled) {
+              opacity: 0.5;
+              pointer-events: none;
+            }
+
+            .rating-wrapper {
+              display: inline-flex;
+              align-items: center;
+              flex-wrap: wrap;
+              gap: 0.75rem;
+            }
+
+            .stars {
+              display: inline-flex;
+              align-items: center;
+              gap: 0.25rem;
+            }
+
+            button {
+              font: inherit;
+              color: inherit;
+              background: transparent;
+              border: 2px solid transparent;
+              border-radius: 6px;
+              min-width: 48px;
+              min-height: 48px;
+              padding: 0.35rem;
+              cursor: pointer;
+              display: inline-flex;
+              align-items: center;
+              justify-content: center;
+              transition: transform 0.15s ease, border-color 0.15s ease;
+            }
+
+            @media (pointer: coarse) {
+              button {
+                min-width: 52px;
+                min-height: 52px;
+              }
+            }
+
+            button:hover:not(:disabled) {
+              transform: scale(1.1);
+            }
+
+            button:focus-visible {
+              outline: 3px solid var(--_star-focus);
+              outline-offset: 2px;
+            }
+
+            button:disabled {
+              cursor: not-allowed;
+            }
+
+            .star-icon {
+              width: 1.85rem;
+              height: 1.85rem;
+              fill: var(--_star-inactive);
+              stroke: var(--_star-stroke);
+              stroke-width: 1.5;
+              transition: fill 0.15s ease;
+            }
+
+            button[ data-active="true" ] .star-icon {
+              fill: var(--_star-active);
+            }
+
+            .rating-summary {
+              font-size: 0.95rem;
+              color: #4e342e;
+            }
+
+            :host(:state(rated)) .rating-summary {
+              font-weight: 600;
+            }
+          </style>
+          <div class="rating-wrapper" part="wrapper">
+            <div class="stars" part="stars" role="radiogroup" aria-label="Coffee star rating">
+              ${[1, 2, 3, 4, 5]
+                .map(
+                  (num) => `
+                <button
+                  type="button"
+                  part="star"
+                  role="radio"
+                  data-value="${num}"
+                  data-active="false"
+                  tabindex="${num === 1 ? '0' : '-1'}"
+                  aria-label="${num} ${num === 1 ? 'star' : 'stars'}"
+                  aria-checked="false"
+                >
+                  <svg class="star-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
+                    <path d="M12 2.5l2.93 5.94 6.56.95-4.74 4.62 1.12 6.53L12 17.46l-5.87 3.08 1.12-6.53L2.51 9.39l6.56-.95L12 2.5z" />
+                  </svg>
+                </button>
+              `,
+                )
+                .join('')}
+            </div>
+            <span class="rating-summary" part="summary" aria-live="polite">No rating selected</span>
+          </div>
+        `;
+
+        const starsContainer = this.shadowRoot.querySelector('.stars');
+        starsContainer.addEventListener('click', (event) => {
+          const btn = event.target.closest('button[data-value]');
+          if (!btn || btn.disabled) return;
+          this.#commitUserValue(btn.dataset.value, btn);
+        });
+
+        starsContainer.addEventListener('keydown', (event) => {
+          const buttons = Array.from(this.shadowRoot.querySelectorAll('button[data-value]'));
+          if (buttons.some((b) => b.disabled)) return;
+
+          const currentNumber = Number(this.#value) || 0;
+          let nextRating = null;
+
+          if (event.key === 'ArrowRight' || event.key === 'ArrowUp') {
+            event.preventDefault();
+            nextRating = Math.min(5, (currentNumber || 0) + 1);
+          } else if (event.key === 'ArrowLeft' || event.key === 'ArrowDown') {
+            event.preventDefault();
+            nextRating = Math.max(1, (currentNumber || 2) - 1);
+          } else if (event.key === 'Home') {
+            event.preventDefault();
+            nextRating = 1;
+          } else if (event.key === 'End') {
+            event.preventDefault();
+            nextRating = 5;
+          }
+
+          if (nextRating !== null) {
+            const targetBtn = buttons[nextRating - 1];
+            this.#commitUserValue(String(nextRating), targetBtn);
+            targetBtn?.focus();
+          }
+        });
+      }
+
+      connectedCallback() {
+        if (!supportsFACE && !this.#fallbackInput) {
+          this.#fallbackInput = document.createElement('input');
+          this.#fallbackInput.type = 'text';
+          this.#fallbackInput.tabIndex = -1;
+          this.#fallbackInput.setAttribute('aria-hidden', 'true');
+          this.#fallbackInput.style.cssText =
+            'position:absolute;clip-path:inset(50%);overflow:hidden;width:1px;height:1px;margin:-1px;padding:0;border:0;white-space:nowrap;';
+          this.appendChild(this.#fallbackInput);
+        }
+
+        if (this.hasAttribute('value') && !this.#value) {
+          this.#value = this.getAttribute('value') ?? '';
+        }
+
+        this.#syncFormState();
+        this.#render();
+        this.#validate();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'value') {
+          this.value = newVal ?? '';
+        } else if (name === 'required') {
+          this.#validate();
+        }
+      }
+
+      get value() {
+        return this.#value;
+      }
+
+      set value(v) {
+        const normalized = v == null ? '' : String(v);
+        this.#value = normalized;
+        this.#syncFormState();
+        this.#render();
+        this.#validate();
+      }
+
+      get form() {
+        return this.#internals ? this.#internals.form : this.closest('form');
+      }
+
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get validity() {
+        return this.#internals?.validity;
+      }
+
+      get validationMessage() {
+        return this.#internals?.validationMessage ?? '';
+      }
+
+      get willValidate() {
+        return this.#internals ? this.#internals.willValidate : true;
+      }
+
+      checkValidity() {
+        return this.#internals ? this.#internals.checkValidity() : true;
+      }
+
+      reportValidity() {
+        return this.#internals ? this.#internals.reportValidity() : true;
+      }
+
+      #commitUserValue(nextValue, targetBtn) {
+        this.value = nextValue;
+        if (targetBtn) {
+          targetBtn.focus();
+        }
+        this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true }));
+      }
+
+      #syncFormState() {
+        if (this.#internals) {
+          this.#internals.setFormValue(this.#value);
+          if (this.#internals.states) {
+            if (this.#value) {
+              this.#internals.states.add('rated');
+            } else {
+              this.#internals.states.delete('rated');
+            }
+          }
+        } else if (this.#fallbackInput) {
+          this.#fallbackInput.name = this.name;
+          this.#fallbackInput.value = this.#value;
+          this.#fallbackInput.required = this.hasAttribute('required');
+        }
+      }
+
+      #validate() {
+        if (!this.#internals) return;
+        if (this.hasAttribute('required') && !this.#value) {
+          this.#internals.setValidity(
+            { valueMissing: true },
+            'Please choose a rating.',
+            this.shadowRoot.querySelector('[tabindex]'),
+          );
+        } else {
+          this.#internals.setValidity({});
+        }
+      }
+
+      #render() {
+        const numericValue = Number(this.#value) || 0;
+        const buttons = this.shadowRoot.querySelectorAll('button[data-value]');
+        buttons.forEach((btn) => {
+          const starNum = Number(btn.dataset.value);
+          const isFilled = numericValue > 0 && starNum <= numericValue;
+          const isSelected = numericValue === starNum;
+          btn.dataset.active = String(isFilled);
+          btn.setAttribute('aria-checked', String(isSelected));
+          btn.setAttribute(
+            'tabindex',
+            isSelected || (numericValue === 0 && starNum === 1) ? '0' : '-1',
+          );
+        });
+
+        const summary = this.shadowRoot.querySelector('.rating-summary');
+        if (summary) {
+          summary.textContent =
+            numericValue > 0
+              ? `${numericValue} out of 5 ${numericValue === 1 ? 'star' : 'stars'}`
+              : 'No rating selected';
+        }
+      }
+
+      // FACE lifecycle hooks
+      formResetCallback() {
+        this.value = this.getAttribute('value') ?? '';
+      }
+
+      formDisabledCallback(disabled) {
+        for (const el of this.shadowRoot.querySelectorAll('button')) {
+          el.disabled = disabled;
+        }
+      }
+
+      formStateRestoreCallback(state) {
+        this.value = state ?? '';
+      }
+    }
+
+    customElements.define('star-rating', StarRating);
+
+    // Feedback form interactions
+    const feedbackForm = document.getElementById('coffee-feedback-form');
+    const feedbackFieldset = document.getElementById('feedback-fieldset');
+    const toggleFieldsetBtn = document.getElementById('toggle-fieldset-btn');
+    const feedbackStatus = document.getElementById('feedback-status');
+
+    toggleFieldsetBtn.addEventListener('click', () => {
+      const nextDisabled = !feedbackFieldset.disabled;
+      feedbackFieldset.disabled = nextDisabled;
+      toggleFieldsetBtn.setAttribute('aria-pressed', String(nextDisabled));
+      toggleFieldsetBtn.textContent = nextDisabled ? 'Enable Fieldset' : 'Disable Fieldset';
+    });
+
+    feedbackForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!feedbackForm.reportValidity()) {
+        return;
+      }
+
+      const data = new FormData(feedbackForm);
+      const name = data.get('customer_name') || 'Coffee Lover';
+      const drink = data.get('drink') || 'Coffee';
+      const rating = data.get('rating') || '';
+
+      feedbackStatus.hidden = false;
+      feedbackStatus.textContent = `Thank you, ${name}! Your ${rating}-star review for ${drink} has been recorded.`;
+    });
+
+    feedbackForm.addEventListener('reset', () => {
+      feedbackStatus.hidden = true;
+      feedbackStatus.textContent = '';
+    });
+  </script>
