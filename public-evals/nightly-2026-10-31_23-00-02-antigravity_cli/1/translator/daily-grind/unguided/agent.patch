+  <script>
+    (function () {
+      const langSelect = document.getElementById('language-select');
+      const statusBanner = document.getElementById('translate-status');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Store original English strings
+      translatableElements.forEach((el) => {
+        el.dataset.originalText = el.textContent.trim();
+      });
+
+      let currentLanguage = 'en';
+      const translatorCache = new Map();
+
+      function setStatus(message) {
+        if (!message) {
+          statusBanner.textContent = '';
+          statusBanner.classList.remove('visible');
+        } else {
+          statusBanner.textContent = message;
+          statusBanner.classList.add('visible');
+        }
+      }
+
+      async function getTranslator(sourceLanguage, targetLanguage) {
+        const pairKey = `${sourceLanguage}-${targetLanguage}`;
+        if (translatorCache.has(pairKey)) {
+          return translatorCache.get(pairKey);
+        }
+
+        // Support the standard Built-in AI Translator API as well as legacy self.ai.translator
+        const TranslatorAPI = window.Translator || (window.ai && window.ai.translator);
+        if (!TranslatorAPI || typeof TranslatorAPI.create !== 'function') {
+          throw new Error('On-device Translator API is not supported in this browser.');
+        }
+
+        if (typeof TranslatorAPI.availability === 'function') {
+          const availability = await TranslatorAPI.availability({
+            sourceLanguage,
+            targetLanguage,
+          });
+          if (availability === 'unavailable') {
+            throw new Error(`Translation from ${sourceLanguage} to ${targetLanguage} is unavailable on this device.`);
+          }
+          if (availability === 'downloadable' || availability === 'downloading') {
+            setStatus(`Downloading on-device language model (${targetLanguage.toUpperCase()})...`);
+          }
+        } else if (typeof TranslatorAPI.capabilities === 'function') {
+          const capabilities = await TranslatorAPI.capabilities();
+          const avail = capabilities.languagePairAvailable(sourceLanguage, targetLanguage);
+          if (avail === 'no') {
+            throw new Error(`Translation from ${sourceLanguage} to ${targetLanguage} is unavailable on this device.`);
+          }
+        }
+
+        const translator = await TranslatorAPI.create({
+          sourceLanguage,
+          targetLanguage,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const total = e.total || 1;
+              const percent = Math.round((e.loaded / total) * 100);
+              setStatus(`Downloading on-device language model (${targetLanguage.toUpperCase()}): ${percent}%`);
+            });
+          },
+        });
+
+        if (translator.ready) {
+          await translator.ready;
+        }
+
+        translatorCache.set(pairKey, translator);
+        return translator;
+      }
+
+      async function translatePage(targetLanguage) {
+        if (targetLanguage === currentLanguage) return;
+
+        if (targetLanguage === 'en') {
+          translatableElements.forEach((el) => {
+            el.textContent = el.dataset.originalText;
+          });
+          currentLanguage = 'en';
+          document.documentElement.lang = 'en';
+          setStatus('');
+          return;
+        }
+
+        langSelect.disabled = true;
+        setStatus(`Translating content to ${targetLanguage.toUpperCase()} on-device...`);
+
+        try {
+          const translator = await getTranslator('en', targetLanguage);
+
+          for (const el of translatableElements) {
+            const sourceText = el.dataset.originalText;
+            if (sourceText) {
+              const translated = await translator.translate(sourceText);
+              el.textContent = translated;
+            }
+          }
+
+          currentLanguage = targetLanguage;
+          document.documentElement.lang = targetLanguage;
+          setStatus('');
+        } catch (err) {
+          console.error('Translation error:', err);
+          setStatus(err.message || 'Unable to translate page content with on-device Translator API.');
+        } finally {
+          langSelect.disabled = false;
+        }
+      }
+
+      langSelect.addEventListener('change', (e) => {
+        translatePage(e.target.value);
+      });
+    })();
+  </script>
