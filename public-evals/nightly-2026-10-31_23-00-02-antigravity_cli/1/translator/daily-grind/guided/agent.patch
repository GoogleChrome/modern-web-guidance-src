+  <script>
+    (function () {
+      const SOURCE_LANGUAGE = 'en';
+      const form = document.getElementById('translation-form');
+      const targetSelect = document.getElementById('target-language');
+      const translateBtn = document.getElementById('start-translation-btn');
+      const resetBtn = document.getElementById('reset-translation-btn');
+      const statusBadge = document.getElementById('translation-status');
+      const progressContainer = document.getElementById('download-progress-container');
+      const progressBar = document.getElementById('model-download-progress');
+      const progressPercent = document.getElementById('download-progress-percent');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Store original English strings and caches for translated pairs
+      const originalTexts = new Map();
+      translatableElements.forEach((el) => {
+        originalTexts.set(el, el.textContent.trim());
+      });
+
+      const translatorCache = new Map();
+      let currentLanguage = SOURCE_LANGUAGE;
+
+      function setStatus(message, state = 'default') {
+        statusBadge.textContent = message;
+        statusBadge.dataset.state = state;
+      }
+
+      function restoreOriginalContent() {
+        translatableElements.forEach((el) => {
+          const original = originalTexts.get(el);
+          if (typeof original === 'string') {
+            el.textContent = original;
+          }
+          el.removeAttribute('lang');
+          el.removeAttribute('dir');
+        });
+        currentLanguage = SOURCE_LANGUAGE;
+        resetBtn.hidden = true;
+      }
+
+      function isTranslatorSupported() {
+        // Access the Translator API exclusively via the global Translator interface
+        return 'Translator' in self && typeof self.Translator?.availability === 'function';
+      }
+
+      async function checkPairAvailability(targetLanguage) {
+        if (!isTranslatorSupported()) {
+          setStatus('Client-side translation is currently unsupported in this browser.', 'unavailable');
+          translateBtn.disabled = true;
+          targetSelect.disabled = true;
+          return 'unavailable';
+        }
+
+        if (targetLanguage === SOURCE_LANGUAGE) {
+          setStatus('Showing original English text.', 'ready');
+          translateBtn.disabled = false;
+          translateBtn.textContent = 'Show Original';
+          return 'available';
+        }
+
+        const options = {
+          sourceLanguage: SOURCE_LANGUAGE,
+          targetLanguage,
+        };
+
+        try {
+          const availability = await self.Translator.availability(options);
+
+          if (availability === 'available') {
+            setStatus(`Model ready on device (${targetLanguage.toUpperCase()}).`, 'ready');
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Translate on Device';
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            setStatus(`Language pack (${targetLanguage.toUpperCase()}) requires download — click button to start.`, 'default');
+            translateBtn.disabled = false;
+            translateBtn.textContent = 'Download & Translate';
+          } else {
+            setStatus(`Translation for ${targetLanguage.toUpperCase()} is unavailable on this device.`, 'unavailable');
+            translateBtn.disabled = true;
+          }
+          return availability;
+        } catch (err) {
+          setStatus('Unable to check language model availability on this device.', 'unavailable');
+          translateBtn.disabled = true;
+          return 'unavailable';
+        }
+      }
+
+      async function translatePageContent(targetLanguage) {
+        if (targetLanguage === SOURCE_LANGUAGE) {
+          restoreOriginalContent();
+          setStatus('Restored original English text.', 'ready');
+          translateBtn.textContent = 'Translate on Device';
+          return;
+        }
+
+        if (!isTranslatorSupported()) {
+          setStatus('Client-side translation is currently unsupported in this browser.', 'unavailable');
+          translateBtn.disabled = true;
+          return;
+        }
+
+        // Identical configuration options object passed to both availability() and create()
+        const options = {
+          sourceLanguage: SOURCE_LANGUAGE,
+          targetLanguage,
+        };
+
+        translateBtn.disabled = true;
+        targetSelect.disabled = true;
+
+        try {
+          const availability = await self.Translator.availability(options);
+          if (availability === 'unavailable') {
+            setStatus(`Translation model for ${targetLanguage.toUpperCase()} is unavailable on this device.`, 'unavailable');
+            return;
+          }
+
+          let translator = translatorCache.get(targetLanguage);
+          if (!translator) {
+            if (availability === 'downloadable' || availability === 'downloading') {
+              progressContainer.hidden = false;
+              progressBar.value = 0;
+              progressPercent.textContent = '0%';
+              setStatus(`Downloading ${targetLanguage.toUpperCase()} model on device...`, 'default');
+            } else {
+              setStatus(`Initializing ${targetLanguage.toUpperCase()} translator...`, 'default');
+            }
+
+            translator = await self.Translator.create({
+              ...options,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const pct = Math.round((e.loaded || 0) * 100);
+                  progressContainer.hidden = false;
+                  progressBar.value = pct;
+                  progressPercent.textContent = `${pct}%`;
+                });
+              },
+            });
+
+            translatorCache.set(targetLanguage, translator);
+          }
+
+          progressContainer.hidden = true;
+          setStatus(`Translating coffee menu and story to ${targetLanguage.toUpperCase()}...`, 'default');
+
+          const isRtl = targetLanguage === 'ar' || targetLanguage === 'he';
+
+          for (const el of translatableElements) {
+            const sourceText = originalTexts.get(el);
+            if (!sourceText) continue;
+
+            // Use streaming translation for longer story paragraphs and standard translate() for concise phrases
+            if (sourceText.length > 140 && typeof translator.translateStreaming === 'function') {
+              const stream = translator.translateStreaming(sourceText);
+              let accumulated = '';
+              el.textContent = '';
+              el.setAttribute('lang', targetLanguage);
+              el.setAttribute('dir', isRtl ? 'rtl' : 'ltr');
+              for await (const chunk of stream) {
+                accumulated += chunk;
+                el.textContent = accumulated;
+              }
+            } else {
+              const translated = await translator.translate(sourceText);
+              el.textContent = translated;
+              el.setAttribute('lang', targetLanguage);
+              el.setAttribute('dir', isRtl ? 'rtl' : 'ltr');
+            }
+          }
+
+          currentLanguage = targetLanguage;
+          resetBtn.hidden = false;
+          translateBtn.textContent = 'Translate on Device';
+          setStatus(`Translated on device (${targetLanguage.toUpperCase()}).`, 'ready');
+        } catch (error) {
+          progressContainer.hidden = true;
+          const errorMessage = error && error.name === 'NotAllowedError'
+            ? 'Please click the translate button directly to allow downloading the language pack.'
+            : 'On-device translation failed or is unsupported in this browser.';
+          setStatus(errorMessage, 'unavailable');
+        } finally {
+          targetSelect.disabled = false;
+          translateBtn.disabled = false;
+        }
+      }
+
+      // Check availability when the user changes the target language dropdown
+      targetSelect.addEventListener('change', async () => {
+        const selectedLang = targetSelect.value;
+        if (selectedLang === SOURCE_LANGUAGE && currentLanguage !== SOURCE_LANGUAGE) {
+          restoreOriginalContent();
+          setStatus('Restored original English text.', 'ready');
+          translateBtn.textContent = 'Translate on Device';
+          return;
+        }
+        await checkPairAvailability(selectedLang);
+      });
+
+      // Form submit (button click) guarantees a user gesture for Translator.create() when downloadable
+      form.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        await translatePageContent(targetSelect.value);
+      });
+
+      resetBtn.addEventListener('click', async () => {
+        targetSelect.value = SOURCE_LANGUAGE;
+        restoreOriginalContent();
+        await checkPairAvailability(SOURCE_LANGUAGE);
+      });
+
+      // Initial check on load for a default target language pair (e.g., 'es') to detect browser support
+      (async function initAvailabilityCheck() {
+        if (!isTranslatorSupported()) {
+          setStatus('Client-side translation is currently unsupported in this browser.', 'unavailable');
+          translateBtn.disabled = true;
+          targetSelect.disabled = true;
+          return;
+        }
+        setStatus('On-device Translator API ready. Choose a language to translate.', 'ready');
+      })();
+    })();
+  </script>
+
 </body>
 
