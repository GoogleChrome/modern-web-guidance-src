+/**
+ * On-Device Translation Engine for The DevTools Times
+ *
+ * Uses the Browser Built-in AI Translator API (`window.Translator` / `window.ai.translator`)
+ * and Language Detector API (`window.LanguageDetector` / `window.ai.languageDetector`)
+ * with a comprehensive offline local fallback dictionary and phrase engine so that
+ * on-device translation works reliably across all browsers and hardware configurations.
+ */
+
+export interface LanguageOption {
+  code: string;
+  name: string;
+  nativeName: string;
+  flag: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'en', name: 'English', nativeName: 'English', flag: '🇺🇸' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español', flag: '🇪🇸' },
+  { code: 'fr', name: 'French', nativeName: 'Français', flag: '🇫🇷' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch', flag: '🇩🇪' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語', flag: '🇯🇵' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português', flag: '🇧🇷' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano', flag: '🇮🇹' },
+];
+
+export type EngineAvailability =
+  | 'available'
+  | 'downloadable'
+  | 'downloading'
+  | 'fallback'
+  | 'checking';
+
+export interface TranslationProgress {
+  status: 'idle' | 'downloading' | 'translating' | 'translated' | 'error';
+  sourceLanguage: string;
+  targetLanguage: string;
+  engineType: 'builtin-ai' | 'local-engine';
+  downloadProgress?: number; // 0 to 100
+  translatedElementsCount?: number;
+  totalElementsCount?: number;
+  detectedLanguage?: string;
+  detectedConfidence?: number;
+  errorMessage?: string;
+}
+
+// Pre-computed exact translations for all articles, categories, and key phrases
+// so offline fallback produces natural, accurate multi-language translations on-device.
