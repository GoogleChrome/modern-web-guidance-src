+/**
+ * Detects the language of a text snippet using the browser's built-in LanguageDetector API
+ * or a lightweight on-device character/word heuristic fallback.
+ */
+export async function detectLanguageOnDevice(
+  text: string
+): Promise<{ detectedLanguage: string; confidence: number; engine: 'builtin-ai' | 'local-engine' }> {
+  const sample = text.trim().slice(0, 600);
+  if (!sample) {
+    return { detectedLanguage: 'en', confidence: 1, engine: 'local-engine' };
+  }
+
+  const detectorAPI = getBrowserLanguageDetectorAPI();
+  if (detectorAPI) {
+    try {
+      const createFn = detectorAPI.create || detectorAPI.createDetector;
+      if (typeof createFn === 'function') {
+        const detector = await createFn.call(detectorAPI);
+        if (detector.ready) await detector.ready;
+        const results = await detector.detect(sample);
+        if (Array.isArray(results) && results.length > 0 && results[0].detectedLanguage) {
+          return {
+            detectedLanguage: results[0].detectedLanguage,
+            confidence: typeof results[0].confidence === 'number' ? results[0].confidence : 0.95,
+            engine: 'builtin-ai',
+          };
+        }
+      }
+    } catch {
+      // Fall back to heuristic detection
+    }
+  }
+
+  // Heuristic fallback detection
+  if (/[\u3040-\u30ff\u4e00-\u9faf]/.test(sample)) {
+    return { detectedLanguage: 'ja', confidence: 0.98, engine: 'local-engine' };
+  }
+  if (/\b(el|la|los|las|una|para|con|por|del|está|son)\b/i.test(sample)) {
+    return { detectedLanguage: 'es', confidence: 0.92, engine: 'local-engine' };
+  }
+  if (/\b(le|la|les|des|une|dans|pour|avec|est|sont)\b/i.test(sample)) {
+    return { detectedLanguage: 'fr', confidence: 0.92, engine: 'local-engine' };
+  }
+  if (/\b(der|die|das|und|in|den|von|mit|auf|für|nicht)\b/i.test(sample)) {
+    return { detectedLanguage: 'de', confidence: 0.92, engine: 'local-engine' };
+  }
+  if (/\b(o|a|os|as|um|uma|para|com|não|está|são)\b/i.test(sample)) {
+    return { detectedLanguage: 'pt', confidence: 0.9, engine: 'local-engine' };
+  }
+  return { detectedLanguage: 'en', confidence: 0.96, engine: 'local-engine' };
+}
+
+/**
+ * Local fallback translation when `window.Translator` is unavailable or unsupported.
+ */
+function translateWithLocalFallback(
+  text: string,
+  sourceLanguage: string,
+  targetLanguage: string
+): string {
+  if (sourceLanguage === targetLanguage || targetLanguage === 'en') {
+    return text;
+  }
+
+  const trimmed = text.trim();
+  if (!trimmed) return text;
+
+  // 1. Check exact match in pre-computed translations
+  const exactEntry = EXACT_TRANSLATIONS[trimmed];
+  if (exactEntry && exactEntry[targetLanguage]) {
+    // Preserve leading/trailing whitespace
+    const leadingSpace = text.match(/^\s*/)?.[0] ?? '';
+    const trailingSpace = text.match(/\s*$/)?.[0] ?? '';
+    return `${leadingSpace}${exactEntry[targetLanguage]}${trailingSpace}`;
+  }
+
+  // Normalize curly quotes to straight quotes for lookup
+  const normalizedQuotes = trimmed.replace(/[’‘]/g, "'").replace(/[“”]/g, '"');
+  const normalizedEntry = EXACT_TRANSLATIONS[normalizedQuotes];
+  if (normalizedEntry && normalizedEntry[targetLanguage]) {
+    const leadingSpace = text.match(/^\s*/)?.[0] ?? '';
+    const trailingSpace = text.match(/\s*$/)?.[0] ?? '';
+    return `${leadingSpace}${normalizedEntry[targetLanguage]}${trailingSpace}`;
+  }
+
+  // 2. Apply phrase and word replacements for body content
+  const rules = PHRASE_DICTIONARY[targetLanguage];
+  if (!rules) return text;
+
+  let result = text;
+  for (const [pattern, replacement] of rules) {
+    result = result.replace(pattern, replacement);
+  }
+  return result;
+}
+
+/**
+ * Obtains or creates a browser built-in `Translator` session for a language pair.
+ */
+async function getOrCreateBrowserTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onDownloadProgress?: (percent: number) => void
+): Promise<any | null> {
+  const pairKey = `${sourceLanguage}->${targetLanguage}`;
+  if (translatorInstanceCache.has(pairKey)) {
+    return translatorInstanceCache.get(pairKey);
+  }
+
+  const api = getBrowserTranslatorAPI();
+  if (!api) return null;
+
+  try {
+    const createFn = api.create || api.createTranslator;
+    if (typeof createFn !== 'function') return null;
+
+    const translator = await createFn.call(api, {
+      sourceLanguage,
+      targetLanguage,
+      monitor(m: any) {
+        if (m && typeof m.addEventListener === 'function') {
+          m.addEventListener('downloadprogress', (e: any) => {
+            const loaded = typeof e.loaded === 'number' ? e.loaded : 0;
+            const total = typeof e.total === 'number' && e.total > 0 ? e.total : 1;
+            const ratio = loaded <= 1 && total === 1 ? loaded : loaded / total;
+            const percent = Math.min(100, Math.max(0, Math.round(ratio * 100)));
+            onDownloadProgress?.(percent);
+          });
+        }
+      },
+    });
+
+    if (translator?.ready) {
+      await translator.ready;
+    }
+
+    translatorInstanceCache.set(pairKey, translator);
+    return translator;
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Translates a single text string on-device using `window.Translator` if available,
+ * falling back to the local on-device translation dictionary.
+ */
+export async function translateTextOnDevice(
+  text: string,
+  sourceLanguage: string,
+  targetLanguage: string,
+  onDownloadProgress?: (percent: number) => void
+): Promise<{ translatedText: string; engine: 'builtin-ai' | 'local-engine' }> {
+  const trimmed = text.trim();
+  if (!trimmed || sourceLanguage === targetLanguage || targetLanguage === 'en') {
+    return { translatedText: text, engine: 'local-engine' };
+  }
+
+  const cacheKey = `${sourceLanguage}:${targetLanguage}:${trimmed}`;
+  const cached = translationMemoryCache.get(cacheKey);
+  if (cached) {
+    const leadingSpace = text.match(/^\s*/)?.[0] ?? '';
+    const trailingSpace = text.match(/\s*$/)?.[0] ?? '';
+    return {
+      translatedText: `${leadingSpace}${cached}${trailingSpace}`,
+      engine: translatorInstanceCache.has(`${sourceLanguage}->${targetLanguage}`)
+        ? 'builtin-ai'
+        : 'local-engine',
+    };
+  }
+
+  const translator = await getOrCreateBrowserTranslator(
+    sourceLanguage,
+    targetLanguage,
+    onDownloadProgress
+  );
+
+  if (translator && typeof translator.translate === 'function') {
+    try {
+      const translated = await translator.translate(trimmed);
+      if (translated && typeof translated === 'string') {
+        translationMemoryCache.set(cacheKey, translated);
+        const leadingSpace = text.match(/^\s*/)?.[0] ?? '';
+        const trailingSpace = text.match(/\s*$/)?.[0] ?? '';
+        return {
+          translatedText: `${leadingSpace}${translated}${trailingSpace}`,
+          engine: 'builtin-ai',
+        };
+      }
+    } catch {
+      // Fall back to local engine on error
+    }
+  }
+
+  const fallbackResult = translateWithLocalFallback(trimmed, sourceLanguage, targetLanguage);
+  translationMemoryCache.set(cacheKey, fallbackResult);
+  const leadingSpace = text.match(/^\s*/)?.[0] ?? '';
+  const trailingSpace = text.match(/\s*$/)?.[0] ?? '';
+  return {
+    translatedText: `${leadingSpace}${fallbackResult}${trailingSpace}`,
+    engine: 'local-engine',
+  };
+}
+
+// Store original text for DOM elements so users can switch languages or revert to Original ('en')
+const originalElementTextMap = new WeakMap<HTMLElement, string>();
+
+const TRANSLATABLE_SELECTORS = [
+  '[data-translatable]',
+  'article .prose p',
+  'article .prose h2',
+  'article .prose h3',
+  'article .prose h4',
+  'article .prose li',
+  'article .prose blockquote',
+  'article figcaption',
+].join(', ');
+
+/**
+ * Collects all translatable elements within a root container (or the entire document).
+ */
+export function getTranslatableElements(root: ParentNode = document): HTMLElement[] {
+  const nodeList = root.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTORS);
+  const elements: HTMLElement[] = [];
+  const seen = new Set<HTMLElement>();
+
+  nodeList.forEach((el) => {
+    if (seen.has(el)) return;
+    // Skip elements that contain nested translatable elements unless explicitly marked
+    if (el.closest('[data-no-translate]')) return;
+    const text = el.textContent?.trim();
+    if (!text) return;
+    seen.add(el);
+    elements.push(el);
+  });
+
+  return elements;
+}
+
+/**
+ * Translates all translatable elements within the given container (or whole page).
+ * Preserves original English text so switching back to 'en' or another language is instant and clean.
+ */
+export async function translateContainerElements(
+  targetLanguage: string,
+  options?: {
+    root?: ParentNode;
+    sourceLanguage?: string;
+    onProgress?: (progress: TranslationProgress) => void;
+  }
+): Promise<TranslationProgress> {
+  const root = options?.root ?? document;
+  const sourceLanguage = options?.sourceLanguage ?? 'en';
+  const elements = getTranslatableElements(root);
+
+  // Save original text on first encounter
+  for (const el of elements) {
+    if (!originalElementTextMap.has(el)) {
+      originalElementTextMap.set(el, el.textContent ?? '');
+    }
+  }
+
+  // If reverting to source language (English), restore original text immediately
+  if (targetLanguage === 'en' || targetLanguage === sourceLanguage) {
+    for (const el of elements) {
+      const original = originalElementTextMap.get(el);
+      if (original !== undefined) {
+        el.textContent = original;
+        el.removeAttribute('data-translated-lang');
+      }
+    }
+    if (root === document && typeof document !== 'undefined') {
+      document.documentElement.lang = 'en';
+    }
+    const doneState: TranslationProgress = {
+      status: 'idle',
+      sourceLanguage,
+      targetLanguage: 'en',
+      engineType: 'local-engine',
+      translatedElementsCount: elements.length,
+      totalElementsCount: elements.length,
+    };
+    options?.onProgress?.(doneState);
+    return doneState;
+  }
+
+  let activeEngine: 'builtin-ai' | 'local-engine' = 'local-engine';
+  const availability = await checkTranslationAvailability(sourceLanguage, targetLanguage);
+  if (availability === 'available' || availability === 'downloadable' || availability === 'downloading') {
+    activeEngine = 'builtin-ai';
+  }
+
+  const initialProgress: TranslationProgress = {
+    status: availability === 'downloadable' || availability === 'downloading' ? 'downloading' : 'translating',
+    sourceLanguage,
+    targetLanguage,
+    engineType: activeEngine,
+    downloadProgress: availability === 'available' ? 100 : 0,
+    translatedElementsCount: 0,
+    totalElementsCount: elements.length,
+  };
+  options?.onProgress?.(initialProgress);
+
+  let completed = 0;
+  for (const el of elements) {
+    const sourceText = originalElementTextMap.get(el) ?? el.textContent ?? '';
+    if (!sourceText.trim()) {
+      completed++;
+      continue;
+    }
+
+    const { translatedText, engine } = await translateTextOnDevice(
+      sourceText,
+      sourceLanguage,
+      targetLanguage,
+      (percent) => {
+        options?.onProgress?.({
+          status: 'downloading',
+          sourceLanguage,
+          targetLanguage,
+          engineType: 'builtin-ai',
+          downloadProgress: percent,
+          translatedElementsCount: completed,
+          totalElementsCount: elements.length,
+        });
+      }
+    );
+
+    activeEngine = engine;
+    el.textContent = translatedText;
+    el.setAttribute('data-translated-lang', targetLanguage);
+    completed++;
+
+    options?.onProgress?.({
+      status: 'translating',
+      sourceLanguage,
+      targetLanguage,
+      engineType: activeEngine,
+      downloadProgress: 100,
+      translatedElementsCount: completed,
+      totalElementsCount: elements.length,
+    });
+  }
+
+  if (root === document && typeof document !== 'undefined') {
+    document.documentElement.lang = targetLanguage;
+  }
+
+  const finalState: TranslationProgress = {
+    status: 'translated',
+    sourceLanguage,
+    targetLanguage,
+    engineType: activeEngine,
+    downloadProgress: 100,
+    translatedElementsCount: completed,
+    totalElementsCount: elements.length,
+  };
+  options?.onProgress?.(finalState);
+  return finalState;
+}
+
+const STORAGE_KEY = 'devtools_times_preferred_lang';
+
+export function getSavedLanguagePreference(): string {
+  if (typeof window === 'undefined') return 'en';
+  try {
+    return window.localStorage.getItem(STORAGE_KEY) || 'en';
+  } catch {
+    return 'en';
+  }
+}
+
+export function setSavedLanguagePreference(lang: string): void {
+  if (typeof window === 'undefined') return;
+  try {
+    window.localStorage.setItem(STORAGE_KEY, lang);
+    window.dispatchEvent(
+      new CustomEvent('devtools-times:language-change', { detail: { language: lang } })
+    );
+  } catch {
+    // Ignore storage errors
+  }
+}
