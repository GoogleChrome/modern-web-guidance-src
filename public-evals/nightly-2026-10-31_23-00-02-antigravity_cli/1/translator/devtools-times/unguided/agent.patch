+
+// Cache for active translator instances and translated strings
+const translatorInstanceCache = new Map<string, any>();
+const translationMemoryCache = new Map<string, string>();
+
+/**
+ * Resolves the browser's built-in Translator API constructor if present.
+ */
+function getBrowserTranslatorAPI(): any | null {
+  if (typeof window === 'undefined') return null;
+  const win = window as any;
+  if (win.Translator) return win.Translator;
+  if (win.ai?.translator) return win.ai.translator;
+  if (win.translation?.createTranslator) return win.translation;
+  return null;
+}
+
+/**
+ * Resolves the browser's built-in LanguageDetector API constructor if present.
+ */
+function getBrowserLanguageDetectorAPI(): any | null {
+  if (typeof window === 'undefined') return null;
+  const win = window as any;
+  if (win.LanguageDetector) return win.LanguageDetector;
+  if (win.ai?.languageDetector) return win.ai.languageDetector;
+  if (win.translation?.createDetector) return win.translation;
+  return null;
+}
+
+/**
+ * Checks whether the browser's native on-device Translator API is available
+ * for the given language pair.
+ */
+export async function checkTranslationAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<EngineAvailability> {
+  if (sourceLanguage === targetLanguage) return 'available';
+
+  const api = getBrowserTranslatorAPI();
+  if (!api) return 'fallback';
+
+  try {
+    if (typeof api.availability === 'function') {
+      const status = await api.availability({ sourceLanguage, targetLanguage });
+      if (status === 'available' || status === 'readily') return 'available';
+      if (status === 'downloadable' || status === 'after-download') return 'downloadable';
+      if (status === 'downloading') return 'downloading';
+      return 'fallback';
+    }
+    if (typeof api.capabilities === 'function') {
+      const caps = await api.capabilities();
+      const status = caps?.languagePairAvailable
+        ? caps.languagePairAvailable(sourceLanguage, targetLanguage)
+        : caps?.available;
+      if (status === 'readily' || status === 'available') return 'available';
+      if (status === 'after-download' || status === 'downloadable') return 'downloadable';
+    }
+    if (typeof api.canTranslate === 'function') {
+      const status = await api.canTranslate({ sourceLanguage, targetLanguage });
+      if (status === 'readily' || status === 'available') return 'available';
+      if (status === 'after-download' || status === 'downloadable') return 'downloadable';
+    }
+  } catch {
+    // Fall back to local engine if the browser API throws
+  }
+
+  return 'fallback';
+}
