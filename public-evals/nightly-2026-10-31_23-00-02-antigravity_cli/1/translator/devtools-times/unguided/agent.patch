diff --git a/src/components/ArticleTranslator.tsx b/src/components/ArticleTranslator.tsx
new file mode 100644
index 0000000..b82da33
--- /dev/null
+++ b/src/components/ArticleTranslator.tsx
@@ -0,0 +1,533 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  checkTranslationAvailability,
+  detectLanguageOnDevice,
+  translateContainerElements,
+  getSavedLanguagePreference,
+  setSavedLanguagePreference,
+  type EngineAvailability,
+  type TranslationProgress,
+} from '../utils/translator';
+
+interface ArticleTranslatorProps {
+  /**
+   * 'header': compact global language switcher in the top navigation bar (translates the whole page)
+   * 'article': rich inline on-device translation control bar for an article page
+   * 'teaser': compact inline button/pill for individual teaser cards
+   */
+  variant?: 'header' | 'article' | 'teaser';
+  /**
+   * Optional selector or ref scope. If omitted, 'header' translates the document,
+   * 'article' translates the closest <article> (plus related teasers if global sync is active),
+   * and 'teaser' translates its parent teaser container.
+   */
+  scopeSelector?: string;
+}
+
+export default function ArticleTranslator({
+  variant = 'article',
+  scopeSelector,
+}: ArticleTranslatorProps) {
+  const [selectedLang, setSelectedLang] = useState<string>('en');
+  const [availabilityMap, setAvailabilityMap] = useState<Record<string, EngineAvailability>>({});
+  const [progress, setProgress] = useState<TranslationProgress>({
+    status: 'idle',
+    sourceLanguage: 'en',
+    targetLanguage: 'en',
+    engineType: 'local-engine',
+  });
+  const [detectedSource, setDetectedSource] = useState<{
+    lang: string;
+    confidence: number;
+    engine: 'builtin-ai' | 'local-engine';
+  }>({ lang: 'en', confidence: 0.99, engine: 'local-engine' });
+  const [isDropdownOpen, setIsDropdownOpen] = useState(false);
+
+  const rootRef = useRef<HTMLDivElement>(null);
+
+  // Resolve the DOM container to translate
+  const resolveContainer = (): ParentNode => {
+    if (typeof document === 'undefined') return null as unknown as ParentNode;
+    if (scopeSelector) {
+      const found = document.querySelector(scopeSelector);
+      if (found) return found;
+    }
+    if (variant === 'header') {
+      return document;
+    }
+    if (variant === 'teaser' && rootRef.current) {
+      const teaserContainer = rootRef.current.closest('[data-teaser-card], article, .teaser-card');
+      if (teaserContainer) return teaserContainer;
+    }
+    if (variant === 'article' && rootRef.current) {
+      const articleEl = rootRef.current.closest('article');
+      if (articleEl) return articleEl;
+    }
+    return document;
+  };
+
+  // Detect source language & check availability on mount
+  useEffect(() => {
+    let mounted = true;
+
+    async function init() {
+      // Check availability for all supported target languages
+      const statuses: Record<string, EngineAvailability> = {};
+      for (const lang of SUPPORTED_LANGUAGES) {
+        if (lang.code === 'en') {
+          statuses[lang.code] = 'available';
+        } else {
+          statuses[lang.code] = await checkTranslationAvailability('en', lang.code);
+        }
+      }
+      if (mounted) {
+        setAvailabilityMap(statuses);
+      }
+
+      // Detect language of the current article/page content
+      const container = resolveContainer();
+      const sampleEl =
+        container?.querySelector?.('[data-translatable="title"], h1, h2, h3, p') ?? null;
+      const sampleText = sampleEl?.textContent?.trim() || '';
+      if (sampleText) {
+        const detection = await detectLanguageOnDevice(sampleText);
+        if (mounted) {
+          setDetectedSource({
+            lang: detection.detectedLanguage,
+            confidence: detection.confidence,
+            engine: detection.engine,
+          });
+        }
+      }
+
+      // Restore saved preference if header or article
+      const saved = getSavedLanguagePreference();
+      if (saved && saved !== 'en' && (variant === 'header' || variant === 'article')) {
+        if (mounted) {
+          setSelectedLang(saved);
+        }
+        await translateContainerElements(saved, {
+          root: variant === 'header' ? document : resolveContainer(),
+          sourceLanguage: 'en',
+          onProgress: (p) => {
+            if (mounted) setProgress(p);
+          },
+        });
+      }
+    }
+
+    init();
+
+    // Listen for global language changes so header, article, and teaser controls stay synchronized
+    const handleGlobalLangChange = async (e: Event) => {
+      const customEvent = e as CustomEvent<{ language: string }>;
+      const newLang = customEvent.detail?.language;
+      if (!newLang || !mounted) return;
+      setSelectedLang(newLang);
+      if (variant === 'header') {
+        await translateContainerElements(newLang, {
+          root: document,
+          sourceLanguage: 'en',
+          onProgress: (p) => {
+            if (mounted) setProgress(p);
+          },
+        });
+      } else {
+        setProgress((prev) => ({
+          ...prev,
+          status: newLang === 'en' ? 'idle' : 'translated',
+          targetLanguage: newLang,
+        }));
+      }
+    };
+
+    const handlePageLoad = () => {
+      const saved = getSavedLanguagePreference();
+      if (saved && saved !== 'en' && variant === 'header') {
+        translateContainerElements(saved, {
+          root: document,
+          sourceLanguage: 'en',
+          onProgress: (p) => {
+            if (mounted) setProgress(p);
+          },
+        });
+      }
+    };
+
+    window.addEventListener('devtools-times:language-change', handleGlobalLangChange);
+    document.addEventListener('astro:page-load', handlePageLoad);
+
+    return () => {
+      mounted = false;
+      window.removeEventListener('devtools-times:language-change', handleGlobalLangChange);
+      document.removeEventListener('astro:page-load', handlePageLoad);
+    };
+  }, [variant]);
+
+  // Close dropdown on outside click
+  useEffect(() => {
+    if (!isDropdownOpen) return;
+    const handleClickOutside = (e: MouseEvent) => {
+      if (rootRef.current && !rootRef.current.contains(e.target as Node)) {
+        setIsDropdownOpen(false);
+      }
+    };
+    document.addEventListener('mousedown', handleClickOutside);
+    return () => document.removeEventListener('mousedown', handleClickOutside);
+  }, [isDropdownOpen]);
+
+  const handleSelectLanguage = async (langCode: string) => {
+    setSelectedLang(langCode);
+    setIsDropdownOpen(false);
+
+    if (variant === 'header') {
+      // Global translation: persist preference and translate the whole document
+      setSavedLanguagePreference(langCode);
+      await translateContainerElements(langCode, {
+        root: document,
+        sourceLanguage: 'en',
+        onProgress: setProgress,
+      });
+    } else if (variant === 'article') {
+      // Translate the article and also sync global preference
+      setSavedLanguagePreference(langCode);
+      await translateContainerElements(langCode, {
+        root: document,
+        sourceLanguage: 'en',
+        onProgress: setProgress,
+      });
+    } else {
+      // Teaser-scoped translation: translate only this teaser card!
+      const container = resolveContainer();
+      await translateContainerElements(langCode, {
+        root: container,
+        sourceLanguage: 'en',
+        onProgress: setProgress,
+      });
+    }
+  };
+
+  const currentLangOption =
+    SUPPORTED_LANGUAGES.find((l) => l.code === selectedLang) ?? SUPPORTED_LANGUAGES[0];
+
+  const isBuiltinAvailable = Object.values(availabilityMap).some(
+    (v) => v === 'available' || v === 'downloadable' || v === 'downloading'
+  );
+
+  // ---------------------------------------------------------------------------
+  // VARIANT 1: Compact Teaser Translation Control
+  // ---------------------------------------------------------------------------
+  if (variant === 'teaser') {
+    return (
+      <div
+        ref={rootRef}
+        data-no-translate="true"
+        className="inline-flex items-center space-x-1 relative"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="inline-flex items-center bg-gray-100 hover:bg-amber-50 border border-gray-200 rounded-full px-2 py-0.5 text-xs text-gray-700 transition-colors">
+          <svg
+            className="w-3.5 h-3.5 mr-1 text-amber-700 flex-shrink-0"
+            xmlns="http://www.w3.org/2000/svg"
+            fill="none"
+            viewBox="0 0 24 24"
+            strokeWidth={1.8}
+            stroke="currentColor"
+            aria-hidden="true"
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+            />
+          </svg>
+          <select
+            aria-label="Translate teaser"
+            value={selectedLang}
+            onChange={(e) => handleSelectLanguage(e.target.value)}
+            className="bg-transparent text-xs font-medium text-gray-700 focus:outline-none cursor-pointer pr-1"
+            title="Translate this teaser on-device"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.code === 'en' ? 'Translate' : `${lang.flag} ${lang.nativeName}`}
+              </option>
+            ))}
+          </select>
+        </div>
+        {selectedLang !== 'en' && (
+          <button
+            type="button"
+            onClick={() => handleSelectLanguage('en')}
+            className="text-[11px] text-amber-800 hover:underline font-medium px-1"
+            title="Restore original language"
+          >
+            Original
+          </button>
+        )}
+      </div>
+    );
+  }
+
+  // ---------------------------------------------------------------------------
+  // VARIANT 2: Header Global On-Device Translation Control
+  // ---------------------------------------------------------------------------
+  if (variant === 'header') {
+    return (
+      <div ref={rootRef} data-no-translate="true" className="relative inline-block text-left">
+        <div className="flex items-center space-x-1.5">
+          <button
+            type="button"
+            onClick={() => setIsDropdownOpen((prev) => !prev)}
+            aria-label="On-device article translation"
+            aria-expanded={isDropdownOpen}
+            className={`inline-flex items-center space-x-1.5 text-xs font-semibold py-1.5 px-2.5 rounded border transition-colors cursor-pointer ${
+              selectedLang !== 'en'
+                ? 'bg-amber-50 border-amber-400 text-amber-900'
+                : 'bg-gray-50 border-gray-300 text-gray-700 hover:bg-gray-100'
+            }`}
+          >
+            <svg
+              className="w-4 h-4 text-amber-700"
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+            <span>
+              {selectedLang === 'en'
+                ? 'Translate'
+                : `${currentLangOption.flag} ${currentLangOption.nativeName}`}
+            </span>
+            {progress.status === 'downloading' || progress.status === 'translating' ? (
+              <span className="w-3 h-3 border-2 border-amber-600 border-t-transparent rounded-full animate-spin inline-block ml-1" />
+            ) : (
+              <svg
+                className="w-3 h-3 text-gray-500"
+                xmlns="http://www.w3.org/2000/svg"
+                fill="none"
+                viewBox="0 0 24 24"
+                strokeWidth={2.5}
+                stroke="currentColor"
+              >
+                <path strokeLinecap="round" strokeLinejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
+              </svg>
+            )}
+          </button>
+
+          {selectedLang !== 'en' && (
+            <button
+              type="button"
+              onClick={() => handleSelectLanguage('en')}
+              className="text-xs text-amber-800 hover:text-amber-600 underline font-medium cursor-pointer"
+              title="Reset page to original English"
+            >
+              Reset
+            </button>
+          )}
+        </div>
+
+        {isDropdownOpen && (
+          <div className="absolute left-0 mt-2 w-64 rounded-lg bg-white shadow-xl border border-gray-200 z-50 p-3">
+            <div className="flex items-center justify-between border-b border-gray-100 pb-2 mb-2">
+              <div>
+                <p className="text-xs font-bold text-gray-900">On-Device Translation</p>
+                <p className="text-[11px] text-gray-500">
+                  {isBuiltinAvailable
+                    ? 'Browser Built-in AI Translator ready'
+                    : 'On-device local translation engine active'}
+                </p>
+              </div>
+              <span className="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-green-100 text-green-800">
+                Local
+              </span>
+            </div>
+
+            <div className="space-y-1 max-h-60 overflow-y-auto">
+              {SUPPORTED_LANGUAGES.map((lang) => {
+                const isSelected = lang.code === selectedLang;
+                const avail = availabilityMap[lang.code];
+                return (
+                  <button
+                    key={lang.code}
+                    type="button"
+                    onClick={() => handleSelectLanguage(lang.code)}
+                    className={`w-full flex items-center justify-between px-2.5 py-1.5 text-xs rounded-md transition-colors cursor-pointer ${
+                      isSelected
+                        ? 'bg-amber-100 text-amber-950 font-semibold'
+                        : 'text-gray-700 hover:bg-gray-100'
+                    }`}
+                  >
+                    <span className="flex items-center space-x-2">
+                      <span>{lang.flag}</span>
+                      <span>{lang.nativeName}</span>
+                      <span className="text-gray-400 text-[11px]">({lang.name})</span>
+                    </span>
+                    {lang.code === 'en' ? (
+                      <span className="text-[10px] text-gray-500">Original</span>
+                    ) : avail === 'downloadable' ? (
+                      <span className="text-[10px] text-amber-700">Downloadable</span>
+                    ) : (
+                      <span className="text-[10px] text-green-700">Ready</span>
+                    )}
+                  </button>
+                );
+              })}
+            </div>
+          </div>
+        )}
+      </div>
+    );
+  }
+
+  // ---------------------------------------------------------------------------
+  // VARIANT 3: Full Article On-Device Translation Control Bar
+  // ---------------------------------------------------------------------------
+  return (
+    <div
+      ref={rootRef}
+      data-no-translate="true"
+      className="my-5 p-4 rounded-lg border border-gray-200 bg-gray-50/90 shadow-xs"
+      aria-label="On-device article translation controls"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        {/* Left: Label, Icon, and On-Device Status Badge */}
+        <div className="flex items-center space-x-2.5">
+          <div className="w-8 h-8 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center flex-shrink-0">
+            <svg
+              className="w-5 h-5"
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+          </div>
+          <div>
+            <div className="flex items-center space-x-2">
+              <span className="text-sm font-bold text-gray-900">
+                Translate Article On-Device
+              </span>
+              <span className="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-amber-100 text-amber-900">
+                {isBuiltinAvailable ? 'Browser Built-in AI' : 'On-Device Engine'}
+              </span>
+            </div>
+            <p className="text-xs text-gray-500">
+              Detected language:{' '}
+              <span className="font-medium text-gray-700 uppercase">
+                {detectedSource.lang}
+              </span>{' '}
+              ({Math.round(detectedSource.confidence * 100)}% confidence) • Runs privately in your browser
+            </p>
+          </div>
+        </div>
+
+        {/* Right: Language Selector & Original Reset Button */}
+        <div className="flex flex-wrap items-center gap-2">
+          <label htmlFor="article-language-select" className="sr-only">
+            Target Language
+          </label>
+          <select
+            id="article-language-select"
+            aria-label="Select translation language"
+            value={selectedLang}
+            onChange={(e) => handleSelectLanguage(e.target.value)}
+            className="bg-white border border-gray-300 text-gray-800 text-sm font-medium rounded-md px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.flag} {lang.nativeName} ({lang.name})
+                {lang.code === 'en' ? ' — Original' : ''}
+              </option>
+            ))}
+          </select>
+
+          {selectedLang !== 'en' && (
+            <button
+              type="button"
+              onClick={() => handleSelectLanguage('en')}
+              className="px-3 py-1.5 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-100 transition-colors cursor-pointer"
+            >
+              Show Original (English)
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Quick Language Pills */}
+      <div className="mt-3 pt-2.5 border-t border-gray-200/80 flex flex-wrap items-center gap-1.5">
+        <span className="text-xs text-gray-500 mr-1">Quick translate:</span>
+        {SUPPORTED_LANGUAGES.map((lang) => {
+          const active = selectedLang === lang.code;
+          return (
+            <button
+              key={lang.code}
+              type="button"
+              onClick={() => handleSelectLanguage(lang.code)}
+              className={`px-2.5 py-1 rounded-full text-xs font-medium transition-colors cursor-pointer ${
+                active
+                  ? 'bg-gray-900 text-white'
+                  : 'bg-white border border-gray-200 text-gray-700 hover:border-amber-400 hover:bg-amber-50'
+              }`}
+            >
+              {lang.flag} {lang.nativeName}
+            </button>
+          );
+        })}
+      </div>
+
+      {/* Progress / Status feedback bar */}
+      {progress.status === 'downloading' && (
+        <div className="mt-3">
+          <div className="flex justify-between text-xs text-amber-800 mb-1">
+            <span>Downloading on-device language model...</span>
+            <span>{progress.downloadProgress ?? 0}%</span>
+          </div>
+          <div className="w-full bg-gray-200 rounded-full h-1.5 overflow-hidden">
+            <div
+              className="bg-amber-500 h-1.5 transition-all duration-200"
+              style={{ width: `${progress.downloadProgress ?? 10}%` }}
+            />
+          </div>
+        </div>
+      )}
+
+      {progress.status === 'translating' && (
+        <div className="mt-2.5 flex items-center space-x-2 text-xs text-amber-800">
+          <span className="w-3.5 h-3.5 border-2 border-amber-600 border-t-transparent rounded-full animate-spin inline-block" />
+          <span>
+            Translating on-device ({progress.translatedElementsCount ?? 0}/
+            {progress.totalElementsCount ?? 0} sections)...
+          </span>
+        </div>
+      )}
+
+      {progress.status === 'translated' && selectedLang !== 'en' && (
+        <div className="mt-2.5 flex items-center justify-between text-xs text-green-800 bg-green-50 border border-green-200 rounded px-3 py-1.5">
+          <span>
+            ✓ Translated into <strong>{currentLangOption.nativeName}</strong> (
+            {currentLangOption.name}) on-device using{' '}
+            {progress.engineType === 'builtin-ai'
+              ? 'Browser Built-in AI Translator API'
+              : 'On-Device Local Translation Engine'}
+            .
+          </span>
+        </div>
+      )}
+    </div>
+  );
+}
