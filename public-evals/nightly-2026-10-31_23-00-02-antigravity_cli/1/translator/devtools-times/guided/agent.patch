+  { code: 'no', name: 'Norwegian', nativeName: 'Norsk' },
+  { code: 'ro', name: 'Romanian', nativeName: 'Română' },
+  { code: 'sk', name: 'Slovak', nativeName: 'Slovenčina' },
+  { code: 'sl', name: 'Slovenian', nativeName: 'Slovenščina' },
+  { code: 'sv', name: 'Swedish', nativeName: 'Svenska' },
+  { code: 'bg', name: 'Bulgarian', nativeName: 'Български' },
+  { code: 'bn', name: 'Bengali', nativeName: 'বাংলা' },
+  { code: 'kn', name: 'Kannada', nativeName: 'ಕನ್ನಡ' },
+  { code: 'lt', name: 'Lithuanian', nativeName: 'Lietuvių' },
+  { code: 'mr', name: 'Marathi', nativeName: 'मराठी' },
+  { code: 'ta', name: 'Tamil', nativeName: 'தமிழ್' },
+  { code: 'te', name: 'Telugu', nativeName: 'తెలుగు' },
+];
+
+export function getLanguageName(code: string): string {
+  const normalized = code.trim();
+  const exact = SUPPORTED_LANGUAGES.find(
+    (lang) => lang.code.toLowerCase() === normalized.toLowerCase(),
+  );
+  if (exact) return exact.name;
+  const baseCode = normalized.split('-')[0].toLowerCase();
+  const baseMatch = SUPPORTED_LANGUAGES.find(
+    (lang) => lang.code.toLowerCase() === baseCode,
+  );
+  return baseMatch ? baseMatch.name : code;
+}
+
+export function normalizeSupportedLanguageCode(code: string): string | null {
+  const normalized = code.trim();
+  const exact = SUPPORTED_LANGUAGES.find(
+    (lang) => lang.code.toLowerCase() === normalized.toLowerCase(),
+  );
+  if (exact) return exact.code;
+  const baseCode = normalized.split('-')[0].toLowerCase();
+  const baseMatch = SUPPORTED_LANGUAGES.find(
+    (lang) => lang.code.toLowerCase() === baseCode,
+  );
+  return baseMatch ? baseMatch.code : null;
+}
+
+export function isRtlLanguage(code: string): boolean {
+  const base = code.split('-')[0].toLowerCase();
+  return base === 'ar' || base === 'he';
+}
+
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self && Boolean(self.Translator);
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  return (
+    typeof self !== 'undefined' &&
+    'LanguageDetector' in self &&
+    Boolean(self.LanguageDetector)
+  );
+}
+
+/**
+ * Checks availability of a source/target language pair using the global Translator API.
+ */
+export async function checkTranslatorAvailability(
+  options: TranslatorLanguagePairOptions,
+): Promise<AICapabilityAvailability> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    return 'unavailable';
+  }
+  if (options.sourceLanguage === options.targetLanguage) {
+    return 'unavailable';
+  }
+  try {
+    return await self.Translator.availability(options);
+  } catch {
+    return 'unavailable';
+  }
+}
+
+/**
+ * Checks availability of the global LanguageDetector API.
+ */
+export async function checkLanguageDetectorAvailability(): Promise<AICapabilityAvailability> {
+  if (!isLanguageDetectorSupported() || !self.LanguageDetector) {
+    return 'unavailable';
+  }
+  try {
+    return await self.LanguageDetector.availability();
+  } catch {
+    return 'unavailable';
+  }
+}
+
+/**
+ * Collects all translatable leaf elements inside a root (or the entire document).
+ */
+export function getTranslatableElements(
+  root: ParentNode = document,
+): HTMLElement[] {
+  const elements: HTMLElement[] = [];
+  const seen = new Set<HTMLElement>();
+
+  const addElement = (el: HTMLElement) => {
+    if (seen.has(el)) return;
+    const text = (el.dataset.originalText ?? el.textContent ?? '').trim();
+    if (!text) return;
+    seen.add(el);
+    elements.push(el);
+  };
+
+  // If root itself is a translatable element or container
+  if (root instanceof HTMLElement && root.hasAttribute('data-translate')) {
+    if (root.getAttribute('data-translate') === 'body') {
+      const bodyBlocks = root.querySelectorAll<HTMLElement>(
+        'p, h2, h3, h4, h5, h6, li, figcaption',
+      );
+      bodyBlocks.forEach(addElement);
+    } else {
+      addElement(root);
+    }
+  }
+
+  const marked = root.querySelectorAll<HTMLElement>('[data-translate]');
+  marked.forEach((node) => {
+    const kind = node.getAttribute('data-translate');
+    if (kind === 'body') {
+      const bodyBlocks = node.querySelectorAll<HTMLElement>(
+        'p, h2, h3, h4, h5, h6, li, figcaption',
+      );
+      if (bodyBlocks.length > 0) {
+        bodyBlocks.forEach(addElement);
+      } else {
+        addElement(node);
+      }
+    } else {
+      addElement(node);
+    }
+  });
+
+  return elements;
+}
+
+/**
+ * Collects a representative multi-sentence sample of article/teaser text on the page
+ * for accurate on-device language detection.
+ */
+export function getSampleTextForDetection(root: ParentNode = document): string {
+  const elements = getTranslatableElements(root);
+  const chunks: string[] = [];
+  let totalLength = 0;
+
+  for (const el of elements) {
+    const text = (el.textContent ?? '').trim();
+    if (text.length > 15) {
+      chunks.push(text);
+      totalLength += text.length;
+      if (totalLength >= 500) break;
+    }
+  }
+
+  return chunks.join(' ');
+}
+
+/**
+ * Translates a single text string using streaming when available for longer passages,
+ * or standard translate() for shorter headlines/teasers.
+ */
+export async function translateElementText(
+  translator: TranslatorInstance,
+  element: HTMLElement,
+  sourceText: string,
+  signal?: AbortSignal,
+): Promise<string> {
+  const trimmed = sourceText.trim();
+  if (!trimmed) return sourceText;
+
+  const isLongPassage =
+    trimmed.length > 160 && typeof translator.translateStreaming === 'function';
+
+  if (isLongPassage && translator.translateStreaming) {
+    const stream = translator.translateStreaming(trimmed, signal ? { signal } : undefined);
+    let accumulated = '';
+    for await (const chunk of stream) {
+      if (signal?.aborted) {
+        throw new DOMException('Translation aborted', 'AbortError');
+      }
+      // Handle both cumulative and delta chunk implementations across Chromium builds
+      if (accumulated && chunk.startsWith(accumulated)) {
+        accumulated = chunk;
+      } else {
+        accumulated += chunk;
+      }
+      element.textContent = accumulated;
+    }
+    return accumulated;
+  }
+
+  const translated = await translator.translate(
+    trimmed,
+    signal ? { signal } : undefined,
+  );
+  element.textContent = translated;
+  return translated;
+}
+
+/**
+ * Updates `lang` and `dir` attributes on translatable containers to match the active language.
+ */
+export function applyContainerLanguageAttributes(
+  targetLanguage: string,
+  root: ParentNode = document,
+): void {
+  const containers: HTMLElement[] = [];
+  if (
+    root instanceof HTMLElement &&
+    root.hasAttribute('data-translatable-container')
+  ) {
+    containers.push(root);
+  }
+  root
+    .querySelectorAll<HTMLElement>('[data-translatable-container]')
+    .forEach((c) => containers.push(c));
+
+  const dir = isRtlLanguage(targetLanguage) ? 'rtl' : 'ltr';
+
+  containers.forEach((container) => {
+    if (!container.hasAttribute('data-original-lang')) {
+      container.setAttribute(
+        'data-original-lang',
+        container.getAttribute('lang') || 'en',
+      );
+    }
+    if (!container.hasAttribute('data-original-dir')) {
+      container.setAttribute(
+        'data-original-dir',
+        container.getAttribute('dir') || 'ltr',
+      );
+    }
+    container.setAttribute('lang', targetLanguage);
+    container.setAttribute('dir', dir);
+    container.setAttribute('data-translated-lang', targetLanguage);
+  });
+}
+
+/**
+ * Restores all translated elements and containers within `root` back to their original text and language metadata.
+ */
+export function restoreOriginalContent(root: ParentNode = document): number {
+  let restoredCount = 0;
+
+  const elements: HTMLElement[] = [];
+  if (root instanceof HTMLElement && root.hasAttribute('data-original-text')) {
+    elements.push(root);
+  }
+  root
+    .querySelectorAll<HTMLElement>('[data-original-text]')
+    .forEach((el) => elements.push(el));
+
+  elements.forEach((el) => {
+    const original = el.getAttribute('data-original-text');
+    if (original !== null) {
+      el.textContent = original;
+      el.removeAttribute('data-current-lang');
+      restoredCount += 1;
+    }
+  });
+
+  const containers: HTMLElement[] = [];
+  if (
+    root instanceof HTMLElement &&
+    root.hasAttribute('data-translatable-container')
+  ) {
+    containers.push(root);
+  }
+  root
+    .querySelectorAll<HTMLElement>('[data-translatable-container]')
+    .forEach((c) => containers.push(c));
+
+  containers.forEach((container) => {
+    const origLang = container.getAttribute('data-original-lang') || 'en';
+    const origDir = container.getAttribute('data-original-dir') || 'ltr';
+    container.setAttribute('lang', origLang);
+    container.setAttribute('dir', origDir);
+    container.removeAttribute('data-translated-lang');
+  });
+
+  return restoredCount;
+}
