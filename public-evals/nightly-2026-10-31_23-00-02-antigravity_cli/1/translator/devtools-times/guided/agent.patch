new file mode 100644
index 0000000..387788c
--- /dev/null
+++ b/src/components/ArticleTranslationControl.tsx
@@ -0,0 +1,626 @@
+import React, { useState, useEffect, useId, useRef, useCallback } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  getLanguageName,
+  normalizeSupportedLanguageCode,
+  isTranslatorSupported,
+  isLanguageDetectorSupported,
+  checkTranslatorAvailability,
+  checkLanguageDetectorAvailability,
+  getTranslatableElements,
+  getSampleTextForDetection,
+  translateElementText,
+  applyContainerLanguageAttributes,
+  restoreOriginalContent,
+} from '../utils/translator';
+import type {
+  AICapabilityAvailability,
+  TranslatorLanguagePairOptions,
+} from '../../global';
+
+interface ArticleTranslationControlProps {
+  scopeSelector?: string;
+}
+
+export default function ArticleTranslationControl({
+  scopeSelector,
+}: ArticleTranslationControlProps) {
+  const instanceId = useId();
+  const sourceSelectId = `${instanceId}-source-lang`;
+  const targetSelectId = `${instanceId}-target-lang`;
+  const progressId = `${instanceId}-progress`;
+
+  const [sourceLanguage, setSourceLanguage] = useState<string>('en');
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [activeLanguage, setActiveLanguage] = useState<string | null>(null);
+
+  const [apiSupported, setApiSupported] = useState<boolean>(true);
+  const [detectorSupported, setDetectorSupported] = useState<boolean>(true);
+  const [availability, setAvailability] =
+    useState<AICapabilityAvailability>('available');
+  const [detectorAvailability, setDetectorAvailability] =
+    useState<AICapabilityAvailability>('available');
+
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [isDetecting, setIsDetecting] = useState<boolean>(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [translationProgress, setTranslationProgress] = useState<number | null>(
+    null,
+  );
+  const [statusMessage, setStatusMessage] = useState<string>('');
+  const [errorMessage, setErrorMessage] = useState<string>('');
+  const [detectedInfo, setDetectedInfo] = useState<string>('');
+
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  const getScopeRoot = useCallback((): ParentNode => {
+    if (typeof document === 'undefined') return null as unknown as ParentNode;
+    if (scopeSelector) {
+      const found = document.querySelector(scopeSelector);
+      if (found) return found;
+    }
+    return document;
+  }, [scopeSelector]);
+
+  // Check API support and language pair availability
+  useEffect(() => {
+    let cancelled = false;
+
+    const verifySupport = async () => {
+      const hasTranslator = isTranslatorSupported();
+      const hasDetector = isLanguageDetectorSupported();
+      if (cancelled) return;
+
+      setApiSupported(hasTranslator);
+      setDetectorSupported(hasDetector);
+
+      if (hasDetector) {
+        const detAvail = await checkLanguageDetectorAvailability();
+        if (!cancelled) setDetectorAvailability(detAvail);
+      } else {
+        setDetectorAvailability('unavailable');
+      }
+
+      if (!hasTranslator) {
+        setAvailability('unavailable');
+        return;
+      }
+
+      if (sourceLanguage === targetLanguage) {
+        setAvailability('unavailable');
+        return;
+      }
+
+      const options: TranslatorLanguagePairOptions = {
+        sourceLanguage,
+        targetLanguage,
+      };
+      const avail = await checkTranslatorAvailability(options);
+      if (!cancelled) {
+        setAvailability(avail);
+      }
+    };
+
+    verifySupport();
+
+    return () => {
+      cancelled = true;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  // Reset translation state on Astro page navigation
+  useEffect(() => {
+    const handlePageLoad = () => {
+      abortControllerRef.current?.abort();
+      setActiveLanguage(null);
+      setStatusMessage('');
+      setErrorMessage('');
+      setDetectedInfo('');
+    };
+
+    document.addEventListener('astro:page-load', handlePageLoad);
+    return () => {
+      document.removeEventListener('astro:page-load', handlePageLoad);
+    };
+  }, []);
+
+  const handleSwapLanguages = () => {
+    if (isTranslating || isDetecting) return;
+    const nextSource = targetLanguage;
+    const nextTarget = sourceLanguage;
+    setSourceLanguage(nextSource);
+    setTargetLanguage(nextTarget);
+    setErrorMessage('');
+  };
+
+  /**
+   * Detects the language of the current article/teaser content on-device.
+   * Strictly invoked from a button click (user gesture) to satisfy LanguageDetector.create() requirements.
+   */
+  const handleDetectLanguage = async () => {
+    setErrorMessage('');
+    setDetectedInfo('');
+
+    if (!('LanguageDetector' in self) || !self.LanguageDetector) {
+      setErrorMessage(
+        'Client-side language detection is currently unsupported in this browser.',
+      );
+      return;
+    }
+
+    const root = getScopeRoot();
+    const sampleText = getSampleTextForDetection(root);
+    if (!sampleText || sampleText.length < 10) {
+      setErrorMessage('Not enough article text found on the page to detect language.');
+      return;
+    }
+
+    setIsDetecting(true);
+    setDownloadProgress(null);
+    setStatusMessage('Detecting article language on-device…');
+
+    try {
+      const currentAvailability = await self.LanguageDetector.availability();
+      if (currentAvailability === 'unavailable') {
+        setDetectorAvailability('unavailable');
+        setErrorMessage(
+          'On-device language detection model is unavailable on this device.',
+        );
+        setStatusMessage('');
+        return;
+      }
+
+      const detector = await self.LanguageDetector.create({
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            if (typeof e.loaded === 'number') {
+              setDownloadProgress(Math.round(e.loaded * 100));
+            }
+          });
+        },
+      });
+
+      const results = await detector.detect(sampleText);
+      if (results && results.length > 0) {
+        const top = results[0];
+        const matchedCode =
+          normalizeSupportedLanguageCode(top.detectedLanguage) ||
+          top.detectedLanguage;
+        const confidencePct = Math.round((top.confidence ?? 0) * 100);
+        const langName = getLanguageName(matchedCode);
+
+        if (SUPPORTED_LANGUAGES.some((l) => l.code === matchedCode)) {
+          const nextTarget =
+            matchedCode === targetLanguage
+              ? matchedCode === 'en'
+                ? 'es'
+                : 'en'
+              : targetLanguage;
+          setSourceLanguage(matchedCode);
+          setTargetLanguage(nextTarget);
+          setDetectedInfo(`${langName} (${confidencePct}%)`);
+          setStatusMessage(
+            `Detected source language: ${langName} (${confidencePct}% confidence).`,
+          );
+        } else {
+          setDetectedInfo(`${langName} (${confidencePct}%)`);
+          setStatusMessage(
+            `Detected ${langName} (${confidencePct}% confidence).`,
+          );
+        }
+      } else {
+        setErrorMessage('Could not confidently detect the article language.');
+      }
+    } catch (err: any) {
+      setErrorMessage(
+        err?.message || 'Unable to detect language using on-device AI.',
+      );
+      setStatusMessage('');
+    } finally {
+      setIsDetecting(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  /**
+   * Translates all news article and teaser elements on the page using the on-device Translator API.
+   * Strictly invoked from a button click (user gesture) to satisfy Translator.create() requirements.
+   */
+  const handleTranslate = async () => {
+    setErrorMessage('');
+
+    if (!('Translator' in self) || !self.Translator) {
+      setErrorMessage(
+        'Client-side translation is currently unsupported in this browser.',
+      );
+      return;
+    }
+
+    if (sourceLanguage === targetLanguage) {
+      setErrorMessage('Please select different source and target languages.');
+      return;
+    }
+
+    // Identical options object passed to both availability() and create()
+    const options: TranslatorLanguagePairOptions = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    setIsTranslating(true);
+    setDownloadProgress(null);
+    setTranslationProgress(null);
+    setStatusMessage(
+      `Preparing on-device translation from ${getLanguageName(sourceLanguage)} to ${getLanguageName(targetLanguage)}…`,
+    );
+
+    abortControllerRef.current?.abort();
+    const abortController = new AbortController();
+    abortControllerRef.current = abortController;
+
+    try {
+      const currentAvailability = await self.Translator.availability(options);
+      setAvailability(currentAvailability);
+
+      if (currentAvailability === 'unavailable') {
+        setErrorMessage(
+          `On-device translation between ${getLanguageName(sourceLanguage)} and ${getLanguageName(targetLanguage)} is unavailable on this device.`,
+        );
+        setStatusMessage('');
+        return;
+      }
+
+      const translator = await self.Translator.create({
+        ...options,
+        signal: abortController.signal,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            if (typeof e.loaded === 'number') {
+              const pct = Math.round(e.loaded * 100);
+              setDownloadProgress(pct);
+              setStatusMessage(`Downloading language pack (${pct}%)…`);
+            }
+          });
+        },
+      });
+
+      setDownloadProgress(null);
+
+      const root = getScopeRoot();
+      const elements = getTranslatableElements(root);
+
+      if (elements.length === 0) {
+        setErrorMessage('No translatable articles or teasers found on this page.');
+        setStatusMessage('');
+        return;
+      }
+
+      let completed = 0;
+      setTranslationProgress(0);
+
+      for (const el of elements) {
+        if (abortController.signal.aborted) break;
+
+        if (!el.hasAttribute('data-original-text')) {
+          el.setAttribute('data-original-text', el.textContent ?? '');
+        }
+
+        const currentElemLang = el.getAttribute('data-current-lang') || 'en';
+        const textToTranslate =
+          sourceLanguage === 'en' && el.hasAttribute('data-original-text')
+            ? el.getAttribute('data-original-text') || ''
+            : currentElemLang === sourceLanguage
+              ? el.textContent || ''
+              : el.getAttribute('data-original-text') || el.textContent || '';
+
+        if (textToTranslate.trim()) {
+          await translateElementText(
+            translator,
+            el,
+            textToTranslate,
+            abortController.signal,
+          );
+          el.setAttribute('data-current-lang', targetLanguage);
+        }
+
+        completed += 1;
+        setTranslationProgress(Math.round((completed / elements.length) * 100));
+      }
+
+      if (!abortController.signal.aborted) {
+        applyContainerLanguageAttributes(targetLanguage, root);
+        setActiveLanguage(targetLanguage);
+        setStatusMessage(
+          `Translated ${completed} article and teaser sections to ${getLanguageName(targetLanguage)}.`,
+        );
+      }
+    } catch (err: any) {
+      if (err?.name === 'AbortError') {
+        setStatusMessage('Translation cancelled.');
+      } else {
+        setErrorMessage(
+          err?.message ||
+            'An error occurred during on-device translation. Please try again.',
+        );
+        setStatusMessage('');
+      }
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+      setTranslationProgress(null);
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    abortControllerRef.current?.abort();
+    const root = getScopeRoot();
+    restoreOriginalContent(root);
+    setActiveLanguage(null);
+    setErrorMessage('');
+    setStatusMessage('Restored original article and teaser language.');
+  };
+
+  const isBusy = isTranslating || isDetecting;
+  const isPairInvalid = sourceLanguage === targetLanguage;
+  const isTranslateDisabled =
+    !apiSupported || availability === 'unavailable' || isBusy || isPairInvalid;
+
+  const progressValue =
+    downloadProgress !== null
+      ? downloadProgress
+      : translationProgress !== null
+        ? translationProgress
+        : undefined;
+
+  const progressLabel =
+    downloadProgress !== null
+      ? `Downloading language model (${downloadProgress}%)`
+      : translationProgress !== null
+        ? `Translating articles and teasers (${translationProgress}%)`
+        : 'Preparing on-device AI model…';
+
+  return (
+    <div className="translation-control bg-amber-50/60 border-b border-amber-200/80 py-2.5 px-4">
+      <div className="container mx-auto flex flex-wrap items-center justify-between gap-3 text-xs sm:text-sm">
+        {/* Left: Label & Availability Status */}
+        <div className="flex flex-wrap items-center gap-2">
+          <span className="inline-flex items-center gap-1.5 font-semibold text-gray-900">
+            <svg
+              aria-hidden="true"
+              className="w-4 h-4 text-amber-800 shrink-0"
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+            <span>On-Device Article Translator</span>
+          </span>
+
+          {apiSupported ? (
+            <span
+              className={`inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium ${
+                availability === 'available'
+                  ? 'bg-emerald-100 text-emerald-800'
+                  : availability === 'downloadable' ||
+                      availability === 'downloading'
+                    ? 'bg-amber-100 text-amber-800'
+                    : 'bg-gray-200 text-gray-700'
+              }`}
+            >
+              {availability === 'available' && 'On-device model ready'}
+              {availability === 'downloadable' && 'Model downloadable'}
+              {availability === 'downloading' && 'Downloading model…'}
+              {availability === 'unavailable' &&
+                (isPairInvalid ? 'Select distinct languages' : 'Pair unavailable')}
+            </span>
+          ) : (
+            <span className="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-gray-200 text-gray-700">
+              Browser unsupported
+            </span>
+          )}
+
+          {detectedInfo && (
+            <span className="text-xs text-amber-900 bg-amber-100 px-2 py-0.5 rounded font-medium">
+              Detected: {detectedInfo}
+            </span>
+          )}
+        </div>
+
+        {/* Right: Source/Target Language Controls & Actions */}
+        <div className="flex flex-wrap items-center gap-2">
+          {/* Source Language */}
+          <div className="flex items-center gap-1.5">
+            <label
+              htmlFor={sourceSelectId}
+              className="font-medium text-gray-800 whitespace-nowrap"
+            >
+              From:
+            </label>
+            <select
+              id={sourceSelectId}
+              name="sourceLanguage"
+              value={sourceLanguage}
+              disabled={isBusy}
+              onChange={(e) => {
+                setSourceLanguage(e.target.value);
+                setErrorMessage('');
+              }}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-gray-900 min-h-7 focus:border-amber-700 disabled:opacity-60"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`src-${lang.code}`} value={lang.code}>
+                  {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+
+          {/* Detect Source Language Button */}
+          <button
+            type="button"
+            onClick={handleDetectLanguage}
+            disabled={
+              isBusy ||
+              !detectorSupported ||
+              detectorAvailability === 'unavailable'
+            }
+            className="inline-flex items-center gap-1 px-2.5 py-1 min-h-7 rounded border border-gray-300 bg-white text-gray-800 hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed font-medium transition-colors"
+          >
+            <svg
+              aria-hidden="true"
+              className="w-3.5 h-3.5 text-amber-800"
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={2}
+              stroke="currentColor"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
+              />
+            </svg>
+            <span>{isDetecting ? 'Detecting…' : 'Detect language'}</span>
+          </button>
+
+          {/* Swap Languages Button */}
+          <button
+            type="button"
+            onClick={handleSwapLanguages}
+            disabled={isBusy}
+            aria-label="Swap source and target languages"
+            className="inline-flex items-center justify-center min-w-7 min-h-7 px-1.5 py-1 rounded border border-gray-300 bg-white text-gray-700 hover:bg-gray-100 disabled:opacity-50 transition-colors"
+          >
+            <svg
+              aria-hidden="true"
+              className="w-4 h-4"
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={2}
+              stroke="currentColor"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
+              />
+            </svg>
+          </button>
+
+          {/* Target Language */}
+          <div className="flex items-center gap-1.5">
+            <label
+              htmlFor={targetSelectId}
+              className="font-medium text-gray-800 whitespace-nowrap"
+            >
+              To:
+            </label>
+            <select
+              id={targetSelectId}
+              name="targetLanguage"
+              value={targetLanguage}
+              disabled={isBusy}
+              onChange={(e) => {
+                setTargetLanguage(e.target.value);
+                setErrorMessage('');
+              }}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-gray-900 min-h-7 focus:border-amber-700 disabled:opacity-60"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`tgt-${lang.code}`} value={lang.code}>
+                  {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+
+          {/* Primary Translate Button */}
+          <button
+            type="button"
+            onClick={handleTranslate}
+            disabled={isTranslateDisabled}
+            className="inline-flex items-center gap-1.5 px-3 py-1 min-h-7 rounded bg-amber-800 text-white font-semibold hover:bg-amber-900 disabled:bg-gray-300 disabled:text-gray-600 disabled:cursor-not-allowed transition-colors cursor-pointer"
+          >
+            <span>
+              {isTranslating
+                ? 'Translating…'
+                : activeLanguage === targetLanguage
+                  ? 'Re-translate'
+                  : 'Translate'}
+            </span>
+          </button>
+
+          {/* Restore Original Language Button */}
+          {activeLanguage && (
+            <button
+              type="button"
+              onClick={handleRestoreOriginal}
+              className="inline-flex items-center px-2.5 py-1 min-h-7 rounded border border-gray-400 bg-white text-gray-800 hover:bg-gray-100 font-medium transition-colors"
+            >
+              Show original
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Progress Bar (visible while downloading model or translating) */}
+      {isBusy && (
+        <div className="container mx-auto mt-2">
+          <div className="flex items-center justify-between text-xs text-gray-700 mb-1">
+            <label htmlFor={progressId} className="font-medium">
+              {progressLabel}
+            </label>
+            {progressValue !== undefined && <span>{progressValue}%</span>}
+          </div>
+          <progress
+            id={progressId}
+            className="translation-progress"
+            max={100}
+            {...(progressValue !== undefined ? { value: progressValue } : {})}
+          />
+        </div>
+      )}
+
+      {/* Fallback notice when browser does not support the built-in Translator API */}
+      {!apiSupported && (
+        <p className="container mx-auto mt-1.5 text-xs text-gray-700">
+          Client-side translation is currently unsupported in this browser. Use Chrome 138+ or Edge 148+ on desktop to translate articles and teasers on-device.
+        </p>
+      )}
+
+      {/* Single centralized polite live region for status announcements */}
+      <div
+        role="status"
+        aria-live="polite"
+        aria-atomic="true"
+        className={`container mx-auto ${
+          statusMessage && !isBusy
+            ? 'mt-1.5 text-xs text-emerald-800 font-medium'
+            : 'visually-hidden'
+        }`}
+      >
+        {statusMessage}
+      </div>
+
+      {/* Single centralized assertive alert region for errors */}
+      <div
+        role="alert"
+        aria-atomic="true"
+        className={`container mx-auto ${
+          errorMessage ? 'mt-1.5 text-xs text-red-700 font-medium' : 'visually-hidden'
+        }`}
+      >
+        {errorMessage}
+      </div>
+    </div>
+  );
+}
