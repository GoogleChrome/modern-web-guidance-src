+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Freshly pulled shot of Dark Roast Espresso',
+          orderUrl: '/order-online?item=dark-roast-espresso'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          category: 'Barista Favorite',
+          summary: 'Steeped for 18 hours for maximum smoothness.',
+          description:
+            'Coarse-ground Ethiopian and Guatemalan beans steeped in filtered cold water for 18 hours. Naturally sweet with low acidity and served over crystal-clear artisan ice.',
+          price: '$4.75',
+          calories: '15 kcal',
+          sizes: '12 oz, 16 oz, 24 oz',
+          notes: 'Smooth cocoa, sweet citrus, crisp clean finish. Unsweetened and dairy-free.',
+          image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Iced Cold Brew coffee in a tall glass',
+          orderUrl: '/order-online?item=cold-brew'
+        }
+      };
+
+      const modal = document.getElementById('coffee-details-modal');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const modalTitle = document.getElementById('modal-title');
+      const modalCategory = document.getElementById('modal-category');
+      const modalSummary = document.getElementById('modal-summary');
+      const modalDescription = document.getElementById('modal-description');
+      const modalPrice = document.getElementById('modal-price');
+      const modalCalories = document.getElementById('modal-calories');
+      const modalSizes = document.getElementById('modal-sizes');
+      const modalNotes = document.getElementById('modal-notes-text');
+      const modalImage = document.getElementById('modal-image');
+      const modalOrderLink = document.getElementById('modal-order-link');
+      const detailButtons = document.querySelectorAll('.details-btn');
+
+      let activeTrigger = null;
+      let closeWatcher = null;
+
+      function cleanupCloseWatcher() {
+        if (closeWatcher) {
+          const watcher = closeWatcher;
+          closeWatcher = null;
+          try {
+            watcher.destroy();
+          } catch (_) {
+            // Ignore if already destroyed
+          }
+        }
+      }
+
+      function closeModal() {
+        if (modal.open) {
+          modal.close();
+        }
+      }
+
+      function openCoffeeModal(coffeeKey, triggerEl) {
+        const data = coffeeDetails[coffeeKey];
+        if (!data) return;
+
+        activeTrigger = triggerEl || document.activeElement;
+
+        modalTitle.textContent = data.title;
+        modalCategory.textContent = data.category;
+        modalSummary.textContent = data.summary;
+        modalDescription.textContent = data.description;
+        modalPrice.textContent = data.price;
+        modalCalories.textContent = data.calories;
+        modalSizes.textContent = data.sizes;
+        modalNotes.textContent = data.notes;
+        modalImage.src = data.image;
+        modalImage.alt = data.imageAlt;
+        modalOrderLink.href = data.orderUrl;
+
+        cleanupCloseWatcher();
+
+        if (!modal.open) {
+          if (typeof modal.showModal === 'function') {
+            modal.showModal();
+          } else {
+            modal.setAttribute('open', '');
+          }
+        }
+
+        if (typeof window.CloseWatcher === 'function') {
+          try {
+            closeWatcher = new window.CloseWatcher();
+            closeWatcher.onclose = function () {
+              closeWatcher = null;
+              closeModal();
+            };
+          } catch (_) {
+            closeWatcher = null;
+          }
+        }
+      }
+
+      detailButtons.forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          event.preventDefault();
+          const coffeeKey = btn.getAttribute('data-coffee');
+          openCoffeeModal(coffeeKey, btn);
+        });
+      });
+
+      closeBtn.addEventListener('click', function () {
+        closeModal();
+      });
+
+      modal.addEventListener('click', function (event) {
+        if (event.target === modal) {
+          closeModal();
+        }
+      });
+
+      modal.addEventListener('close', function () {
+        cleanupCloseWatcher();
+        if (activeTrigger && typeof activeTrigger.focus === 'function') {
+          activeTrigger.focus();
+          activeTrigger = null;
+        }
+      });
+
+      document.addEventListener('keydown', function (event) {
+        if (event.key === 'Escape' && modal.open) {
+          closeModal();
+        }
+      });
+
+      window.addEventListener('popstate', function () {
+        if (modal.open) {
+          closeModal();
+        }
+      });
+    })();
+  </script>
