+          title: 'Dark Roast Espresso',
+          category: 'House Classic',
+          summary: 'Bold, smokey, and perfect for a morning boost.',
+          description:
+            'Slow-roasted in small batches using 100% Arabica beans from Sumatra and Colombia. Pulled at peak pressure for a rich, full-bodied shot crowned with velvety golden crema.',
+          price: '$3.75',
+          calories: '10 kcal',
+          sizes: 'Single (1 oz), Double (2 oz)',
