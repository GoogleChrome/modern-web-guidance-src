+  <script>
+    (function () {
+      const board = document.getElementById('kanban-board');
+      const form = document.getElementById('new-order-form');
+      const columns = Array.from(board.querySelectorAll('.board-column'));
+      const countBadges = new Map();
+
+      columns.forEach((col) => {
+        const status = col.dataset.status;
+        const badge = col.querySelector('.column-count');
+        if (status && badge) {
+          countBadges.set(status, badge);
+        }
+      });
+
+      let draggedCard = null;
+      let activeDropColumn = null;
+      let rafId = null;
+      let nextOrderId = 105;
+
+      function updateCounts(affectedColumns) {
+        const colsToUpdate = affectedColumns || columns;
+        for (let i = 0; i < colsToUpdate.length; i++) {
+          const col = colsToUpdate[i];
+          const status = col.dataset.status;
+          const badge = countBadges.get(status);
+          if (badge) {
+            const count = col.getElementsByClassName('card').length;
+            badge.textContent = String(count);
+          }
+        }
+      }
+
+      function clearDragOverState() {
+        if (activeDropColumn) {
+          activeDropColumn.classList.remove('drag-over');
+          activeDropColumn = null;
+        }
+      }
+
+      // Event delegation on the board container to avoid per-card listener overhead
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card) return;
+        draggedCard = card;
+        card.classList.add('dragging');
+
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', card.id || card.dataset.orderId || '');
+        }
+      });
+
+      board.addEventListener('dragend', (e) => {
+        const card = e.target.closest('.card') || draggedCard;
+        if (rafId) {
+          cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        if (card) {
+          card.classList.remove('dragging');
+        }
+        clearDragOverState();
+        draggedCard = null;
+      });
+
+      board.addEventListener('dragover', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+        if (e.dataTransfer) {
+          e.dataTransfer.dropEffect = 'move';
+        }
+
+        if (activeDropColumn !== column && !rafId) {
+          rafId = requestAnimationFrame(() => {
+            rafId = null;
+            if (activeDropColumn && activeDropColumn !== column) {
+              activeDropColumn.classList.remove('drag-over');
+            }
+            column.classList.add('drag-over');
+            activeDropColumn = column;
+          });
+        }
+      });
+
+      board.addEventListener('dragleave', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        const related = e.relatedTarget;
+        if (!related || !column.contains(related)) {
+          if (activeDropColumn === column) {
+            column.classList.remove('drag-over');
+            activeDropColumn = null;
+          }
+        }
+      });
+
+      board.addEventListener('drop', (e) => {
+        const targetColumn = e.target.closest('.board-column');
+        if (!targetColumn) return;
+        e.preventDefault();
+
+        let card = draggedCard;
+        if (!card && e.dataTransfer) {
+          const id = e.dataTransfer.getData('text/plain');
+          if (id) {
+            card = document.getElementById(id) || board.querySelector(`[data-order-id="${CSS.escape(id)}"]`);
+          }
+        }
+        if (!card) return;
+
+        const sourceColumn = card.closest('.board-column');
+        const targetCard = e.target.closest('.card');
+
+        card.classList.remove('dragging');
+        card.dataset.status = targetColumn.dataset.status || '';
+
+        if (targetCard && targetCard !== card && targetCard.parentElement === targetColumn) {
+          targetColumn.insertBefore(card, targetCard);
+        } else {
+          targetColumn.appendChild(card);
+        }
+
+        clearDragOverState();
+        const cols = sourceColumn && sourceColumn !== targetColumn
+          ? [sourceColumn, targetColumn]
+          : [targetColumn];
+        updateCounts(cols);
+        draggedCard = null;
+      });
+
+      if (form) {
+        form.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const drinkInput = document.getElementById('drink-name');
+          const customerInput = document.getElementById('customer-name');
+          const notesSelect = document.getElementById('drink-notes');
+          const drinkName = drinkInput.value.trim();
+          if (!drinkName) return;
+
+          const customerName = customerInput.value.trim() || 'Guest';
+          const notes = notesSelect.value;
+          const orderNum = nextOrderId++;
+
+          const card = document.createElement('div');
+          card.className = 'card';
+          card.id = `order-${orderNum}`;
+          card.draggable = true;
+          card.dataset.orderId = String(orderNum);
+          card.dataset.status = 'queued';
+
+          const meta = document.createElement('div');
+          meta.className = 'card-meta';
+          const leftSpan = document.createElement('span');
+          leftSpan.textContent = `#${orderNum} • ${customerName}`;
+          const rightSpan = document.createElement('span');
+          rightSpan.textContent = 'Just now';
+          meta.append(leftSpan, rightSpan);
+
+          const title = document.createElement('h3');
+          title.textContent = drinkName;
+
+          const desc = document.createElement('p');
+          desc.textContent = notes;
+
+          card.append(meta, title, desc);
+
+          const queuedCol = document.getElementById('queued');
+          if (queuedCol) {
+            queuedCol.appendChild(card);
+            updateCounts([queuedCol]);
+          }
+
+          drinkInput.value = '';
+          customerInput.value = '';
+        });
+      }
+    })();
+  </script>
 </body>
 
 </html>
