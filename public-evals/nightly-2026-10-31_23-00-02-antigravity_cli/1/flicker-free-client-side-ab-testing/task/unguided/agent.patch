+      overflow-x: hidden;
+    }
+
+    /*
+     * Anti-flicker rule:
+     * Preserves layout geometry (opacity: 0; visibility: hidden instead of display: none)
+     * so the user never sees original experiment content flash before the variant is applied,
+     * while preventing any Cumulative Layout Shift (CLS = 0).
+     */
+    html.ab-pending [data-experiment-cloak] {
+      opacity: 0 !important;
+      visibility: hidden !important;
+      pointer-events: none !important;
+    }
+
+    [data-experiment-cloak] {
+      opacity: 1;
+      visibility: visible;
+      transition: opacity 0.12s ease-out;
+    }
+
+    /* Header / Navigation */
