+          <path d="M10 105 C70 95, 110 80, 160 68 C210 56, 260 52, 310 30 C350 15, 385 12, 410 8 L410 120 L10 120 Z" fill="url(#chartGrad)" />
+          <path d="M10 105 C70 95, 110 80, 160 68 C210 56, 260 52, 310 30 C350 15, 385 12, 410 8" stroke="#818cf8" stroke-width="3" stroke-linecap="round" />
+          <path d="M10 112 C75 108, 130 102, 190 96 C250 90, 320 86, 410 78" stroke="#64748b" stroke-width="2" stroke-dasharray="5 5" stroke-linecap="round" />
