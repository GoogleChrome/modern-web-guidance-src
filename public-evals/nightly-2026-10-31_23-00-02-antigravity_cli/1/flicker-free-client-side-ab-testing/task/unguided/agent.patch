+  </style>
+
+  <!--
+    Anti-flicker controller & non-blocking A/B experiment loader:
+    1. Keeps [data-experiment-cloak] hidden (with layout space reserved) until the SDK
+       applies its variant or finishes loading.
+    2. Reveals immediately on SDK load, error, DOM mutation, or a tight 250ms fail-safe
+       timeout so unreachable/slow CDNs never degrade FCP or LCP.
+  -->
+  <script>
+    (function () {
+      var revealed = false;
+      function revealExperiment() {
+        if (revealed) return;
+        revealed = true;
+        document.documentElement.classList.remove('ab-pending');
+        document.documentElement.classList.add('ab-ready');
+        document.documentElement.setAttribute('data-experiment-state', 'ready');
+      }
+
+      window.__revealExperiment = revealExperiment;
+      window.onExperimentApplied = revealExperiment;
+
+      // Bounded fail-safe timeout so a slow or offline CDN never blocks visibility
+      var failSafeTimer = setTimeout(revealExperiment, 250);
+
+      window.addEventListener('experiment:ready', function () {
+        clearTimeout(failSafeTimer);
+        revealExperiment();
+      }, { once: true });
+    })();
+  </script>
+
+  <!-- Load A/B testing SDK with defer so it fetches in parallel and runs after DOM parsing before reveal -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    defer
+    onload="window.__revealExperiment && window.__revealExperiment()"
+    onerror="window.__revealExperiment && window.__revealExperiment()"
+  ></script>
+</head>
+<body>
