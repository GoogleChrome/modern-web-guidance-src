+
+  <script>
+    (function () {
+      var heroContainer = document.getElementById('hero-variant-container');
+      if (heroContainer && typeof MutationObserver !== 'undefined') {
+        var observer = new MutationObserver(function () {
+          if (window.__revealExperiment) {
+            window.__revealExperiment();
+          }
+          observer.disconnect();
+        });
+        observer.observe(heroContainer, {
+          childList: true,
+          subtree: true,
+          characterData: true
+        });
+      }
+
+      var ctaButton = document.getElementById('cta-button');
+      var ctaFeedback = document.getElementById('cta-feedback');
+      if (ctaButton && ctaFeedback) {
