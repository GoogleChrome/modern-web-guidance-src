   </style>
+  <link rel="expect" href="#main-content" blocking="render">
+  <script blocking="render">
+    function getTransitionType(fromEntry, toEntry) {
+      if (fromEntry?.url && toEntry?.url) {
+        const fromUrl = new URL(fromEntry.url);
+        const toUrl = new URL(toEntry.url);
+        const fromPage = Number(fromUrl.searchParams.get("page") ?? 1);
+        const toPage = Number(toUrl.searchParams.get("page") ?? 1);
+        if (toPage > fromPage) return "next";
+        if (toPage < fromPage) return "previous";
+
+        const direction = toUrl.searchParams.get("direction");
+        if (direction === "next" || direction === "previous") {
+          return direction;
+        }
+        if (toUrl.href.includes("previous")) return "previous";
+        if (toUrl.href.includes("next")) return "next";
+      }
+      const stored = sessionStorage.getItem("transitionType");
+      if (stored === "next" || stored === "previous") {
+        return stored;
+      }
+      return "next";
+    }
+
+    if ("onpagereveal" in window) {
+      window.addEventListener("pagereveal", async (e) => {
+        if (!e.viewTransition) return;
+        if (window.navigation?.activation) {
+          const transitionType = getTransitionType(
+            window.navigation.activation.from,
+            window.navigation.activation.entry
+          );
+          e.viewTransition.types.add(transitionType);
+        } else {
+          const fallbackType =
+            new URLSearchParams(window.location.search).get("direction") ||
+            sessionStorage.getItem("transitionType") ||
+            "next";
+          e.viewTransition.types.add(fallbackType);
+        }
+      });
+    }
+  </script>
 </head>
 
