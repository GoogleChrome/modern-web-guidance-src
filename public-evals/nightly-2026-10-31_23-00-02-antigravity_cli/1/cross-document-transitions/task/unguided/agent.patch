+  <script>
+    const previousLink = document.getElementById('previous');
+    const nextLink = document.getElementById('next');
+
+    if (previousLink) {
+      previousLink.addEventListener('click', () => {
+        sessionStorage.setItem('transitionType', 'previous');
+      });
+    }
+
+    if (nextLink) {
+      nextLink.addEventListener('click', () => {
+        sessionStorage.setItem('transitionType', 'next');
+      });
+    }
+
+    const resolveTransitionType = (fromEntry, toEntry) => {
+      const savedType = sessionStorage.getItem('transitionType');
+      if (savedType === 'next' || savedType === 'previous') {
+        return savedType;
+      }
+
+      const targetUrl = toEntry?.url || window.location.href;
+      if (nextLink && targetUrl === nextLink.href) {
+        return 'next';
+      }
+      if (previousLink && targetUrl === previousLink.href) {
+        return 'previous';
+      }
+
+      if (fromEntry?.url && toEntry?.url) {
+        const fromUrl = new URL(fromEntry.url, window.location.origin);
+        const toUrl = new URL(toEntry.url, window.location.origin);
+        const fromPage = Number(fromUrl.searchParams.get('page') || 1);
+        const toPage = Number(toUrl.searchParams.get('page') || 1);
+        if (toPage > fromPage) return 'next';
+        if (toPage < fromPage) return 'previous';
+      }
+
+      return 'next';
+    };
+
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pageswap', (event) => {
+        if (!event.viewTransition) return;
+        const activation = event.activation || window.navigation?.activation;
+        const transitionType = resolveTransitionType(activation?.from, activation?.entry);
+        event.viewTransition.types.add(transitionType);
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition) return;
+        const activation = window.navigation?.activation;
+        const transitionType = resolveTransitionType(activation?.from, activation?.entry);
+        event.viewTransition.types.add(transitionType);
+        sessionStorage.removeItem('transitionType');
+      });
+    }
+  </script>
