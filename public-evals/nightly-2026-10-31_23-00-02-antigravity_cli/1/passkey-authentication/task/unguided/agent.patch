+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+      const authForm = document.getElementById('auth-form');
+
+      let conditionalAbortController = null;
+      let conditionalPending = false;
+      let conditionalAvailable = true;
+
+      if (
+        window.PublicKeyCredential &&
+        typeof PublicKeyCredential.isConditionalMediationAvailable === 'function'
+      ) {
+        PublicKeyCredential.isConditionalMediationAvailable()
+          .then((available) => {
+            conditionalAvailable = Boolean(available);
+          })
+          .catch(() => {
+            conditionalAvailable = true;
+          });
+      }
+
+      function generateChallenge() {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && window.crypto.getRandomValues) {
+          window.crypto.getRandomValues(challenge);
+        } else {
+          for (let i = 0; i < challenge.length; i++) {
+            challenge[i] = i + 1;
+          }
+        }
+        return challenge;
+      }
+
+      function bufferToBase64url(buffer) {
+        if (!buffer) return null;
+        if (typeof buffer === 'string') return buffer;
+        const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serializeCredential(credential) {
+        if (!credential) return null;
+        if (typeof credential.toJSON === 'function') {
+          try {
+            return credential.toJSON();
+          } catch (_) {
+            // Fall through to manual serialization
+          }
+        }
+        const response = credential.response || {};
+        return {
+          id: credential.id,
+          rawId: bufferToBase64url(credential.rawId) || credential.id,
+          type: credential.type || 'public-key',
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          response: {
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: bufferToBase64url(response.userHandle)
+          },
+          clientExtensionResults:
+            typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : credential.clientExtensionResults || {}
+        };
+      }
+
+      async function verifyCredential(credential) {
+        if (!credential) return;
+        const payload = serializeCredential(credential);
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json'
+          },
+          body: JSON.stringify(payload)
+        });
+
+        let data = null;
+        try {
+          data = await response.json();
+        } catch (_) {
+          // Response may not be JSON
+        }
+
+        if (!response.ok || (data && data.verified === false)) {
+          const errorMessage = (data && (data.error || data.message)) || 'Authentication failed.';
+          authStatus.textContent = errorMessage;
+          authStatus.className = 'auth-status error';
+          return;
+        }
+
+        const customMessage = data && data.message ? ` ${data.message}` : '';
+        authStatus.textContent = `Authentication successful! Verified and signed in.${customMessage}`;
+        authStatus.className = 'auth-status success';
+      }
+
+      function abortConditionalAuth() {
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+        }
+        conditionalPending = false;
+      }
+
+      let lastGetFn = null;
+
+      async function startConditionalAuth() {
+        if (!conditionalAvailable || !navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+
+        abortConditionalAuth();
+        conditionalAbortController = new AbortController();
+        conditionalPending = true;
+        lastGetFn = navigator.credentials.get;
+
+        const rpId = window.location.hostname || 'localhost';
+        try {
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey: {
+              challenge: generateChallenge(),
+              rpId,
+              userVerification: 'preferred',
+              allowCredentials: []
+            },
+            signal: conditionalAbortController.signal
+          });
+
+          conditionalPending = false;
+          conditionalAbortController = null;
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          conditionalPending = false;
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+        }
+      }
+
+      async function handleDirectPasskeyAuth(event) {
+        if (event) {
+          event.preventDefault();
+        }
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          authStatus.textContent = 'WebAuthn passkeys are not supported in this browser.';
+          authStatus.className = 'auth-status error';
+          return;
+        }
+
+        abortConditionalAuth();
+
+        const rpId = window.location.hostname || 'localhost';
+        try {
+          let credential;
+          try {
+            credential = await navigator.credentials.get({
+              publicKey: {
+                challenge: generateChallenge(),
+                rpId,
+                userVerification: 'required',
+                allowCredentials: []
+              }
+            });
+          } catch (innerErr) {
+            if (innerErr && (innerErr.name === 'NotAllowedError' || innerErr.name === 'ConstraintError')) {
+              credential = await navigator.credentials.get({
+                publicKey: {
+                  challenge: generateChallenge(),
+                  rpId,
+                  userVerification: 'preferred',
+                  allowCredentials: []
+                }
+              });
+            } else {
+              throw innerErr;
+            }
+          }
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (err && err.name === 'AbortError') {
+            return;
+          }
+          authStatus.textContent = (err && err.message) || 'Passkey authentication cancelled or failed.';
+          authStatus.className = 'auth-status error';
+        }
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', () => {
+          if (
+            !conditionalPending ||
+            (navigator.credentials && navigator.credentials.get !== lastGetFn)
+          ) {
+            startConditionalAuth();
+          }
+        });
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', handleDirectPasskeyAuth);
+      }
+
+      if (authForm) {
+        authForm.addEventListener('submit', handleDirectPasskeyAuth);
+      }
+    })();
+  </script>
 </body>
 
