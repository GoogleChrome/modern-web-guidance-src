+  <script type="module">
+    import "webauthn-polyfills";
+
+    const statusEl = document.querySelector('[data-testid="auth-status"]');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    let autofillAbortController = new AbortController();
+
+    function updateStatus(message) {
+      if (statusEl) {
+        statusEl.textContent = message;
+      }
+    }
+
+    async function optionsFetch() {
+      const response = await fetch("/api/login/options", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+      });
+      if (!response.ok) {
+        throw new Error(`Failed to fetch login options: ${response.status}`);
+      }
+      return response.json();
+    }
+
+    async function loginVerifyFetch(encodedCredential) {
+      return fetch("/api/login/verify", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(encodedCredential),
+      });
+    }
+
+    async function verifyCredentialWithServer(credential, rpId) {
+      const encoded = credential.toJSON();
+      try {
+        const response = await loginVerifyFetch(encoded);
+        if (!response.ok && response.status === 404) {
+          updateStatus("Passkey not recognized. Please sign in with another method.");
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encoded.id,
+            });
+          }
+          return;
+        }
+        if (!response.ok) {
+          updateStatus("Authentication failed. Please try again.");
+          return;
+        }
+        let resultMessage = "Signed in with passkey successfully!";
+        try {
+          const data = await response.json();
+          if (data && (data.message || data.status)) {
+            resultMessage = data.message || data.status;
+          }
+        } catch {
+          // Non-JSON response body is fine
+        }
+        updateStatus(resultMessage);
+      } catch (serverErr) {
+        console.error("Verification request error:", serverErr);
+        updateStatus("Unable to verify credential. Please check your connection and try again.");
+      }
+    }
+
+    async function initializeConditionalAutofill() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+        return;
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (capabilities.conditionalGet === true) {
+        let loginOptionsJSON;
+        try {
+          loginOptionsJSON = await optionsFetch();
+        } catch (err) {
+          console.error("Failed to load conditional passkey options:", err);
+          return;
+        }
+
+        const publicKey =
+          PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+        const rpId = publicKey.rpId || loginOptionsJSON.rpId || window.location.hostname;
+
+        let credential;
+        try {
+          credential = await navigator.credentials.get({
+            publicKey,
+            signal: autofillAbortController.signal,
+            mediation: "conditional",
+          });
+        } catch (err) {
+          if (["NotAllowedError", "AbortError"].includes(err.name)) {
+            return;
+          }
+          console.error("Unexpected conditional get error:", err);
+          return;
+        }
+
+        if (!credential) {
+          return;
+        }
+
+        await verifyCredentialWithServer(credential, rpId);
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      if (!window.PublicKeyCredential) {
+        updateStatus("Passkeys are not supported in this browser.");
+        return;
+      }
+
+      // Abort any pending Conditional Get call to prevent passkey prompt collisions
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      let loginOptionsJSON;
+      try {
+        loginOptionsJSON = await optionsFetch();
+      } catch (err) {
+        console.error("Failed to fetch passkey login options:", err);
+        updateStatus("Unable to start passkey sign-in. Please try again.");
+        initializeConditionalAutofill();
+        return;
+      }
+
+      const publicKey =
+        PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+      const rpId = publicKey.rpId || loginOptionsJSON.rpId || window.location.hostname;
+
+      let credential;
+      try {
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === "NotAllowedError") {
+          console.log("User cancelled passkey login.");
+          updateStatus("Passkey sign-in was cancelled.");
+        } else if (err.name === "AbortError") {
+          console.log("The authentication operation was aborted.");
+        } else {
+          console.error("Passkey authentication error:", err);
+          updateStatus("Could not authenticate with passkey.");
+        }
+        // Re-arm Conditional autofill suggestions after cancelled explicit button prompts
+        initializeConditionalAutofill();
+        return;
+      }
+
+      if (!credential) {
+        initializeConditionalAutofill();
+        return;
+      }
+
+      await verifyCredentialWithServer(credential, rpId);
+    }
+
+    if (authButton) {
+      authButton.addEventListener("click", triggerButtonAuthentication);
+    }
+
+    if (document.readyState === "loading") {
+      window.addEventListener("DOMContentLoaded", initializeConditionalAutofill);
+    } else {
+      initializeConditionalAutofill();
+    }
+  </script>
 </body>
 
