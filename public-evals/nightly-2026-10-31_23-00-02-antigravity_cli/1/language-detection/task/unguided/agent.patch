+  <script>
+    const detectBtn = document.getElementById('detect-btn');
+    const feedbackInput = document.getElementById('feedback-message');
+    const resultEl = document.getElementById('detection-result');
+
+    let detectorInstance = null;
+
+    detectBtn.addEventListener('click', async () => {
+      const text = feedbackInput.value.trim();
+      if (!text) {
+        resultEl.textContent = 'Please enter a message to detect its language.';
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        resultEl.textContent = 'Language detection is not supported in this browser.';
+        return;
+      }
+
+      try {
+        detectBtn.disabled = true;
+
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          resultEl.textContent = 'Language detection is unavailable on this device.';
+          return;
+        }
+
+        if (!detectorInstance) {
+          if (availability === 'downloadable' || availability === 'downloading') {
+            resultEl.textContent = 'Downloading language model: 0%';
+          }
+
+          detectorInstance = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const ratio = e.total ? e.loaded / e.total : e.loaded;
+                const percent = Math.round(ratio * 100);
+                resultEl.textContent = `Downloading language model: ${percent}%`;
+              });
+            }
+          });
+        }
+
+        const results = await detectorInstance.detect(text);
+        if (!results || results.length === 0) {
+          resultEl.textContent = 'Could not determine the language.';
+          return;
+        }
+
+        const { detectedLanguage, confidence } = results[0];
+        const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+        const languageName = displayNames.of(detectedLanguage) || detectedLanguage;
+        const confidencePercent = (confidence * 100).toFixed(1);
+
+        resultEl.textContent = `Detected language: ${languageName} (${confidencePercent}% confidence)`;
+      } catch (error) {
+        resultEl.textContent = `Error detecting language: ${error.message}`;
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
