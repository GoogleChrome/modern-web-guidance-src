+  <script>
+    const feedbackInput = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const progressContainer = document.getElementById('download-progress-container');
+    const progressBar = document.getElementById('download-progress-bar');
+    const progressLabel = document.getElementById('download-progress-label');
+    const detectionResult = document.getElementById('detection-result');
+
+    const languageNames = new Intl.DisplayNames(['en'], { type: 'language' });
+    let detectorInstance = null;
+
+    function showStatus(message) {
+      detectionResult.textContent = message;
+      detectionResult.hidden = false;
+    }
+
+    function formatLanguageName(code) {
+      if (!code || code === 'und') return 'Undetermined';
+      try {
+        return languageNames.of(code) || code;
+      } catch {
+        return code;
+      }
+    }
+
+    async function checkFeatureAvailability() {
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        showStatus('Client-side language detection is not supported in this browser.');
+        return 'unavailable';
+      }
+
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          detectBtn.disabled = true;
+          showStatus('Language detection model is unavailable on this device.');
+        }
+        return availability;
+      } catch (err) {
+        detectBtn.disabled = true;
+        showStatus('Unable to check language detection availability.');
+        return 'unavailable';
+      }
+    }
+
+    checkFeatureAvailability();
+
+    detectBtn.addEventListener('click', async () => {
+      const text = feedbackInput.value.trim();
+      if (!text) {
+        showStatus('Please enter a message before detecting the language.');
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        showStatus('Client-side language detection is not supported in this browser.');
+        return;
+      }
+
+      detectBtn.disabled = true;
+
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          showStatus('Language detection is unavailable on this device.');
+          return;
+        }
+
+        if (!detectorInstance) {
+          const needsDownload = availability === 'downloadable' || availability === 'downloading';
+          if (needsDownload) {
+            progressBar.value = 0;
+            progressLabel.textContent = 'Downloading model: 0%';
+            progressContainer.hidden = false;
+          }
+
+          detectorInstance = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = Math.round((e.loaded || 0) * 100);
+                progressContainer.hidden = false;
+                progressBar.value = percent;
+                progressLabel.textContent = `Downloading model: ${percent}%`;
+              });
+            },
+          });
+
+          progressContainer.hidden = true;
+        }
+
+        const results = await detectorInstance.detect(text);
+        if (results && results.length > 0) {
+          const topResult = results[0];
+          const languageName = formatLanguageName(topResult.detectedLanguage);
+          const confidencePercent = (topResult.confidence * 100).toFixed(1);
+          showStatus(`Detected language: ${languageName} (${confidencePercent}% confidence)`);
+        } else {
+          showStatus('Could not detect the language of the provided message.');
+        }
+      } catch (error) {
+        progressContainer.hidden = true;
+        showStatus(`Language detection failed: ${error.message || 'Unknown error'}`);
+      } finally {
+        if ('LanguageDetector' in self) {
+          detectBtn.disabled = false;
+        }
+      }
+    });
+  </script>
