@@ -206,7 +206,57 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    let totalForegroundTime = 0;
+    let foregroundStartTime =
+      document.visibilityState === 'visible' && !document.hidden ? Date.now() : null;
+
+    function isPageVisible() {
+      return document.visibilityState !== 'hidden' && !document.hidden;
+    }
+
+    function startForegroundTimer() {
+      if (foregroundStartTime === null && isPageVisible()) {
+        foregroundStartTime = Date.now();
+      }
+    }
+
+    function stopForegroundTimer() {
+      if (foregroundStartTime !== null) {
+        totalForegroundTime += Date.now() - foregroundStartTime;
+        foregroundStartTime = null;
+      }
+    }
+
+    function calculateTotalForegroundTime() {
+      if (foregroundStartTime !== null && isPageVisible()) {
+        const now = Date.now();
+        totalForegroundTime += now - foregroundStartTime;
+        foregroundStartTime = now;
+      }
+      return totalForegroundTime;
+    }
+
+    window.calculateTotalForegroundTime = calculateTotalForegroundTime;
+    window.getTotalForegroundTime = calculateTotalForegroundTime;
+    window.getForegroundTime = calculateTotalForegroundTime;
+
+    document.addEventListener('visibilitychange', () => {
+      if (isPageVisible()) {
+        startForegroundTimer();
+      } else {
+        stopForegroundTimer();
+      }
+    });
+
+    window.addEventListener('blur', stopForegroundTimer);
+    window.addEventListener('focus', startForegroundTimer);
+    window.addEventListener('pagehide', stopForegroundTimer);
+    window.addEventListener('pageshow', startForegroundTimer);
+    window.addEventListener('beforeunload', stopForegroundTimer);
+  </script>
+
 </body>
 
 </html>
