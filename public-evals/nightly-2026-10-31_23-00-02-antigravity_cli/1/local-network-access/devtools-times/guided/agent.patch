@@ -0,0 +1,217 @@
+/**
+ * Local Network Access (LNA) utilities for connecting from a public or local web application
+ * to resources on the user's private local network (`local-network`) or loopback interface (`loopback-network`).
+ *
+ * MANDATORY: Serve any web application that initiates local or loopback network requests
+ * from a Secure Context (`https://`). Local Network Access permissions are denied automatically
+ * in insecure (`http://`) top-level contexts.
+ *
+ * DO NOT rely on deprecated Private Network Access (PNA) preflight headers
+ * (`Access-Control-Request-Private-Network` / `Access-Control-Allow-Private-Network`).
+ */
+
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+export type TargetAddressSpace = 'local' | 'loopback';
+
+/**
+ * Cross-browser permission check for the granular LNA permissions (`'local-network'` or `'loopback-network'`).
+ * Never falls back to querying `'local-network-access'`, which crashes older Chrome versions.
+ *
+ * @param {'local-network' | 'loopback-network'} permissionName
+ * @returns {Promise<PermissionState>}
+ */
+export async function queryLnaPermissionSafe(permissionName: LnaPermissionName): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+    return status.state;
+  } catch {
+    // Unrecognized permission name in browsers without LNA support; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Queries the granular Local Network Access permission for the target space and
+ * synchronizes permission status UI and remediation instructions when state changes.
+ *
+ * @param {'local-network' | 'loopback-network'} permissionName
+ * @param {(state: PermissionState) => void} [onStateChange]
+ * @returns {Promise<PermissionState>}
+ */
+export async function checkNetworkPermission(
+  permissionName: LnaPermissionName,
+  onStateChange?: (state: PermissionState) => void
+): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    updatePermissionUI(permissionName, 'prompt');
+    onStateChange?.('prompt');
+    return 'prompt';
+  }
+
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+
+    // Keep UI synchronized if the user changes permission in browser site settings
+    status.addEventListener('change', () => {
+      updatePermissionUI(permissionName, status.state);
+      onStateChange?.(status.state);
+    });
+
+    updatePermissionUI(permissionName, status.state);
+    onStateChange?.(status.state);
+    return status.state;
+  } catch {
+    // Unrecognized permission name; treat as 'prompt' so the request runs on explicit user gesture
+    updatePermissionUI(permissionName, 'prompt');
+    onStateChange?.('prompt');
+    return 'prompt';
+  }
+}
+
+/**
+ * Updates DOM elements annotated with `data-permission-status` and `data-remediation`
+ * for the given LNA permission.
+ */
+export function updatePermissionUI(permissionName: LnaPermissionName, state: PermissionState): void {
+  if (typeof document === 'undefined') return;
+
+  const statusBadge = document.querySelector<HTMLElement>(`[data-permission-status="${permissionName}"]`);
+  const remediationBox = document.querySelector<HTMLElement>(`[data-remediation="${permissionName}"]`);
+  if (statusBadge) {
+    statusBadge.textContent = state;
+  }
+  if (remediationBox) {
+    // Show remediation instructions whenever permission is explicitly denied
+    remediationBox.hidden = state !== 'denied';
+  }
+}
+
+/**
+ * Connects to a local network device (e.g., LAN printer, newsroom press printer, or IoT hub) over HTTP.
+ * Explicitly declares `targetAddressSpace: 'local'` for Mixed Content exemption and IP address space verification.
+ *
+ * @param {string} deviceUrl
+ * @param {RequestInit} [init]
+ */
+export async function fetchLocalDeviceStatus<T = unknown>(
+  deviceUrl = 'http://192.168.1.100:8080/api/status',
+  init?: RequestInit
+): Promise<T> {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+  } as RequestInit);
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Device responded with HTTP ${response.status}`);
+  }
+  return response.json() as Promise<T>;
+}
+
+/**
+ * Connects to a local companion daemon running on the user's loopback interface (`127.0.0.1`, `[::1]`, or `localhost`).
+ * Explicitly declares `targetAddressSpace: 'loopback'` for Mixed Content exemption and IP address space verification.
+ *
+ * @param {string} daemonUrl
+ * @param {RequestInit} [init]
+ */
+export async function fetchLoopbackDaemon<T = unknown>(
+  daemonUrl = 'http://127.0.0.1:45678/health',
+  init?: RequestInit
+): Promise<T> {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+  } as RequestInit);
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion app responded with HTTP ${response.status}`);
+  }
+  return response.json() as Promise<T>;
+}
+
+/**
+ * Generic helper to fetch any local or loopback resource with explicit `targetAddressSpace`.
+ */
+export async function fetchWithAddressSpace<T = unknown>(
+  url: string,
+  targetAddressSpace: TargetAddressSpace,
+  init?: RequestInit
+): Promise<T> {
+  const request = new Request(url, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    targetAddressSpace,
+  } as RequestInit);
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Endpoint (${targetAddressSpace}) responded with HTTP ${response.status}`);
+  }
+  return response.json() as Promise<T>;
+}
+
+/**
+ * Opens a WebSocket connection to a local network or loopback device (IP literal, `.local`, or `localhost`).
+ * Note: The `WebSocket(url, protocols)` constructor only accepts a subprotocol string or array as its second argument;
+ * never pass a `{ targetAddressSpace }` options object (which throws a `SyntaxError`).
+ *
+ * @param {string} wsUrl
+ * @param {string | string[]} [protocols]
+ */
+export function openLocalWebSocket(
+  wsUrl = 'ws://192.168.1.100:8080/stream',
+  protocols: string | string[] = ['v1.telemetry']
+): WebSocket {
+  // Pass only subprotocol string(s) as the second argument (never an options object).
+  // Browsers exempt ws:// from Mixed Content when the host is a local/loopback IP literal,
+  // .local, or localhost, and gate the connection on 'local-network' or 'loopback-network'.
+  const socket = new WebSocket(wsUrl, protocols);
+  return socket;
+}
+
+/**
+ * Opens a WebTransport session to a local network or loopback endpoint using a pinned self-signed certificate hash.
+ * `WebTransport` requires `https://` and gates `transport.ready` on `'local-network'` or `'loopback-network'`.
+ *
+ * @param {string} wtUrl
+ * @param {BufferSource} [certSha256Bytes]
+ */
+export async function openLocalWebTransport(
+  wtUrl = 'https://192.168.1.100:4433/wt',
+  certSha256Bytes?: BufferSource
+): Promise<WebTransport> {
+  const options: WebTransportOptions = certSha256Bytes
+    ? {
+        serverCertificateHashes: [
+          {
+            algorithm: 'sha-256',
+            value: certSha256Bytes,
+          },
+        ],
+      }
+    : {};
+
+  const transport = new WebTransport(wtUrl, options);
+
+  // transport.ready resolves only after the user grants the 'local-network' or 'loopback-network' permission
+  // and rejects with WebTransportError if the permission is denied.
+  await transport.ready;
+  return transport;
+}
