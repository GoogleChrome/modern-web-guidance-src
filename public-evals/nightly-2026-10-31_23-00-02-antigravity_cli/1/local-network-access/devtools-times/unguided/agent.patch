diff --git a/src/utils/localNetworkAccess.ts b/src/utils/localNetworkAccess.ts
new file mode 100644
index 0000000..3a808e9
--- /dev/null
+++ b/src/utils/localNetworkAccess.ts
@@ -0,0 +1,172 @@
+import type { LocalNetworkPermissionName, TargetAddressSpace } from '../../global';
+
+export const LNA_ALLOW_DIRECTIVES =
+  'local-network-access; local-network; loopback-network';
+
+/**
+ * Queries the browser Permissions API for a Local Network Access permission:
+ * - 'local-network-access'
+ * - 'local-network'
+ * - 'loopback-network'
+ */
+export async function queryLocalNetworkPermission(
+  name: LocalNetworkPermissionName = 'local-network-access'
+): Promise<PermissionState | 'unsupported'> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'unsupported';
+  }
+
+  try {
+    const status = await navigator.permissions.query({ name });
+    return status.state;
+  } catch {
+    return 'unsupported';
+  }
+}
+
+/**
+ * Queries all three Local Network Access permissions:
+ * `local-network-access`, `local-network`, and `loopback-network`.
+ */
+export async function checkLocalNetworkPermissions(): Promise<
+  Record<LocalNetworkPermissionName, PermissionState | 'unsupported'>
+> {
+  const [localNetworkAccess, localNetwork, loopbackNetwork] = await Promise.all([
+    queryLocalNetworkPermission('local-network-access'),
+    queryLocalNetworkPermission('local-network'),
+    queryLocalNetworkPermission('loopback-network'),
+  ]);
+
+  return {
+    'local-network-access': localNetworkAccess,
+    'local-network': localNetwork,
+    'loopback-network': loopbackNetwork,
+  };
+}
+
+/**
+ * Creates a Request configured with `targetAddressSpace` ('local' or 'loopback').
+ */
+export function createLocalNetworkRequest(
+  input: RequestInfo | URL,
+  targetAddressSpace: 'local' | 'loopback',
+  init?: RequestInit
+): Request {
+  return new Request(input, {
+    ...init,
+    targetAddressSpace,
+  });
+}
+
+/**
+ * Returns the `targetAddressSpace` property of a Request instance.
+ */
+export function getRequestTargetAddressSpace(
+  request: Request
+): TargetAddressSpace {
+  return request.targetAddressSpace ?? 'unknown';
+}
+
+/**
+ * Fetches a resource on the user's local network or loopback interface
+ * by specifying `targetAddressSpace` in the fetch options.
+ */
+export async function fetchFromAddressSpace(
+  input: RequestInfo | URL,
+  targetAddressSpace: 'local' | 'loopback',
+  init?: RequestInit
+): Promise<Response> {
+  const request = createLocalNetworkRequest(input, targetAddressSpace, init);
+  return fetch(request, {
+    ...init,
+    targetAddressSpace,
+  });
+}
+
+/**
+ * Fetches a resource on the user's local network (`targetAddressSpace: 'local'`).
+ */
+export async function fetchLocalNetwork(
+  input: RequestInfo | URL,
+  init?: RequestInit
+): Promise<Response> {
+  return fetch(input, {
+    ...init,
+    targetAddressSpace: 'local',
+  });
+}
+
+/**
+ * Fetches a resource on the user's loopback interface (`targetAddressSpace: 'loopback'`).
+ */
+export async function fetchLoopback(
+  input: RequestInfo | URL,
+  init?: RequestInit
+): Promise<Response> {
+  return fetch(input, {
+    ...init,
+    targetAddressSpace: 'loopback',
+  });
+}
+
+/**
+ * Ensures an iframe has the `allow` attribute configured with
+ * `local-network-access`, `local-network`, and `loopback-network` directives.
+ */
+export function enableIframeLocalNetworkAccess(iframe: HTMLIFrameElement): void {
+  const existingAllow = iframe.getAttribute('allow') || '';
+  const directives = new Set(
+    existingAllow
+      .split(';')
+      .map((d) => d.trim())
+      .filter(Boolean)
+  );
+  directives.add('local-network-access');
+  directives.add('local-network');
+  directives.add('loopback-network');
+  iframe.setAttribute('allow', Array.from(directives).join('; '));
+}
+
+/**
+ * Initializes Local Network Access client utilities on `window.localNetworkAccess`
+ * and configures embedded iframes to delegate local network / loopback permissions.
+ */
+export function initLocalNetworkAccess(): void {
+  if (typeof window === 'undefined') return;
+
+  window.localNetworkAccess = {
+    queryPermission: queryLocalNetworkPermission,
+    checkPermissions: checkLocalNetworkPermissions,
+    createRequest: createLocalNetworkRequest,
+    fetchResource: fetchFromAddressSpace,
+    fetchLocalNetwork,
+    fetchLoopback,
+  };
+
+  // Query permissions on startup so the browser registers permission state readiness
+  void checkLocalNetworkPermissions();
+
+  if (typeof document !== 'undefined') {
+    document
+      .querySelectorAll<HTMLIFrameElement>('iframe')
+      .forEach(enableIframeLocalNetworkAccess);
+
+    const observer = new MutationObserver((mutations) => {
+      for (const mutation of mutations) {
+        for (const node of mutation.addedNodes) {
+          if (node instanceof HTMLIFrameElement) {
+            enableIframeLocalNetworkAccess(node);
+          } else if (node instanceof HTMLElement) {
+            node
+              .querySelectorAll<HTMLIFrameElement>('iframe')
+              .forEach(enableIframeLocalNetworkAccess);
+          }
+        }
+      }
+    });
+
+    if (document.body) {
+      observer.observe(document.body, { childList: true, subtree: true });
+    }
+  }
+}
