+
+        socket.addEventListener('open', () => {
+          setStatusFeedback(brewerStatusBox, 'connected', `Live telemetry stream connected via WebSocket (${wsUrl}).`);
+        });
+
+        socket.addEventListener('message', (event) => {
+          setStatusFeedback(brewerStatusBox, 'connected', `Brewer telemetry update: ${String(event.data)}`);
+        });
+
+        socket.addEventListener('error', async () => {
+          const currentState = await queryLnaPermissionSafe('local-network');
+          updatePermissionUI('local-network', currentState);
+          showRemediation('local-network');
+          setStatusFeedback(
+            brewerStatusBox,
+            'error',
+            `WebSocket telemetry connection to ${wsUrl} failed. Verify the brewer is online on your LAN and Local network access is permitted.`
+          );
+        });
+      } catch (err) {
+        showRemediation('local-network');
+        const detail = err instanceof Error ? err.message : String(err);
+        setStatusFeedback(brewerStatusBox, 'error', `Failed to initialize WebSocket (${detail}).`);
+      }
+    }
+
+    function handleStreamCompanionWebSocket() {
+      const wsUrl = companionWsInput.value.trim();
+      if (!wsUrl) {
+        setStatusFeedback(companionStatusBox, 'error', 'Please enter a valid loopback WebSocket URL.');
+        return;
+      }
+
+      if (activeCompanionSocket) {
+        activeCompanionSocket.close();
+        activeCompanionSocket = null;
+      }
+
+      setStatusFeedback(companionStatusBox, 'connecting', `Opening scale stream WebSocket to ${wsUrl}...`);
+
+      try {
+        const socket = openLocalWebSocket(wsUrl);
+        activeCompanionSocket = socket;
+
+        socket.addEventListener('open', () => {
+          setStatusFeedback(companionStatusBox, 'connected', `Companion scale stream connected via WebSocket (${wsUrl}).`);
+        });
+
+        socket.addEventListener('message', (event) => {
+          setStatusFeedback(companionStatusBox, 'connected', `Scale readout: ${String(event.data)}`);
+        });
+
+        socket.addEventListener('error', async () => {
+          const currentState = await queryLnaPermissionSafe('loopback-network');
+          updatePermissionUI('loopback-network', currentState);
+          showRemediation('loopback-network');
+          setStatusFeedback(
+            companionStatusBox,
+            'error',
+            `Loopback WebSocket connection to ${wsUrl} failed. Verify the companion daemon is running locally and Loopback network access is permitted.`
+          );
+        });
+      } catch (err) {
+        showRemediation('loopback-network');
+        const detail = err instanceof Error ? err.message : String(err);
+        setStatusFeedback(companionStatusBox, 'error', `Failed to initialize loopback WebSocket (${detail}).`);
+      }
+    }
+
+    // Event listeners (explicit user gesture gating when state is 'prompt')
+    brewerForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      handleConnectBrewer();
+    });
+
+    companionForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      handleConnectCompanion();
+    });
+
+    brewerWsBtn.addEventListener('click', () => {
+      handleStreamBrewerWebSocket();
+    });
+
+    companionWsBtn.addEventListener('click', () => {
+      handleStreamCompanionWebSocket();
+    });
+
+    // Pre-check granular permissions on initialization; only auto-connect if already 'granted'
+    async function initEquipmentConnections() {
+      const localState = await checkNetworkPermission('local-network', () => {
+        handleConnectBrewer();
+      });
+      if (localState === 'granted') {
+        handleConnectBrewer();
+      } else if (localState === 'denied') {
+        setStatusFeedback(
+          brewerStatusBox,
+          'error',
+          'Local network access permission is denied. Follow the instructions below to re-enable it in your browser site settings.'
+        );
+      }
+
+      const loopbackState = await checkNetworkPermission('loopback-network', () => {
+        handleConnectCompanion();
+      });
+      if (loopbackState === 'granted') {
+        handleConnectCompanion();
+      } else if (loopbackState === 'denied') {
+        setStatusFeedback(
+          companionStatusBox,
+          'error',
+          'Loopback network access permission is denied. Follow the instructions below to re-enable it in your browser site settings.'
+        );
+      }
+    }
+
+    initEquipmentConnections();
+  </script>
 </body>
 
