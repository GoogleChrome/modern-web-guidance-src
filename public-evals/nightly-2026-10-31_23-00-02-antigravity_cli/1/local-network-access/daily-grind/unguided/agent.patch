+        } else {
+          securityBannerEl.classList.remove('insecure');
+          securityTextEl.textContent =
+            'Secure context verified. Ready to query Local Network Access permissions and connect to local & loopback equipment.';
+        }
+      }
+
+      function getPermissionDescription(device, state, errorDetail) {
