+          device.permBadgeEl.textContent = 'Unsupported';
+        } else {
+          device.permBadgeEl.classList.add('perm-unknown');
+          device.permBadgeEl.textContent = state || 'Unknown';
+        }
+
+        device.permHintEl.textContent = getPermissionDescription(device, state, errorDetail);
+      }
+
+      async function queryDevicePermission(device) {
+        if (!navigator.permissions || typeof navigator.permissions.query !== 'function') {
+          renderPermissionState(device, 'unsupported', 'Permissions API unavailable');
+          appendLog(device.label + ': navigator.permissions.query is not available.', 'error');
+          return { state: 'unsupported', name: device.primaryPermission };
+        }
+
+        const candidateNames = [device.primaryPermission, device.fallbackPermission];
+        let lastError = null;
+
+        for (const permName of candidateNames) {
+          try {
+            const status = await navigator.permissions.query({ name: permName });
+            device.resolvedPermissionName = permName;
+
+            if (device.permissionStatusObj !== status) {
+              device.permissionStatusObj = status;
+              const onStateChange = function () {
+                renderPermissionState(device, status.state);
+                appendLog(
+                  device.label + ': Permission "' + permName + '" changed to "' + status.state + '".',
+                  status.state === 'denied' ? 'error' : status.state === 'granted' ? 'success' : ''
+                );
+                if (status.state === 'denied') {
+                  showFeedback(device, 'error', 'Permission Denied (' + permName + ')',
+                    'Browser permission for "' + permName + '" was changed to denied. Allow access in your browser address bar or site settings to connect.',
+                    'permission=' + permName + ' | state=denied | targetAddressSpace=' + device.targetAddressSpace
+                  );
+                }
+              };
+              if (typeof status.addEventListener === 'function') {
+                status.addEventListener('change', onStateChange);
+              } else {
+                status.onchange = onStateChange;
+              }
+            }
+
+            renderPermissionState(device, status.state);
+            appendLog(device.label + ': Permission "' + permName + '" state is "' + status.state + '".');
+            if (status.state === 'denied') {
+              setConnectionBadge(device, 'error', 'Permission Denied');
+              showFeedback(
+                device,
+                'error',
+                'Local Network Access Permission Denied (' + permName + ')',
+                'Browser permission "' + permName + '" is currently denied for this site. Allow access in your browser site settings to connect to ' + device.label + '.',
+                'permission=' + permName + ' | state=denied | targetAddressSpace=' + device.targetAddressSpace
+              );
+            }
+            return { state: status.state, name: permName };
+          } catch (err) {
+            lastError = err;
+          }
+        }
+
+        const errMsg = lastError && lastError.message ? lastError.message : 'Unsupported permission descriptor';
+        device.resolvedPermissionName = device.primaryPermission;
+        renderPermissionState(device, 'unsupported', errMsg);
+        appendLog(device.label + ': Permission query for "' + device.primaryPermission + '" unsupported (' + errMsg + ').');
+        return { state: 'unsupported', name: device.primaryPermission, error: errMsg };
+      }
+
+      function setConnectionBadge(device, statusType, labelText) {
+        device.connBadge.className = 'status-pill status-' + statusType;
+        device.connBadge.textContent = labelText;
+        device.connBadge.setAttribute('data-connection-status', statusType);
+      }
+
+      function showFeedback(device, kind, title, message, metaText) {
+        const el = device.feedbackEl;
+        el.className = 'feedback-panel visible feedback-' + kind;
+        el.innerHTML = '';
+
+        const titleDiv = document.createElement('div');
+        titleDiv.className = 'feedback-title';
+        titleDiv.textContent = title;
+        el.appendChild(titleDiv);
+
+        const bodyP = document.createElement('p');
+        bodyP.textContent = message;
+        el.appendChild(bodyP);
+
+        if (metaText) {
+          const metaDiv = document.createElement('div');
+          metaDiv.className = 'feedback-meta';
+          metaDiv.textContent = metaText;
+          el.appendChild(metaDiv);
+        }
+      }
+
+      async function connectToDevice(device) {
+        const rawUrl = (device.inputEl.value || '').trim();
+        let parsedUrl;
+        try {
+          parsedUrl = new URL(rawUrl);
+          if (parsedUrl.protocol !== 'http:' && parsedUrl.protocol !== 'https:') {
+            throw new Error('Protocol must be http: or https:');
+          }
+        } catch (urlErr) {
+          setConnectionBadge(device, 'error', 'Invalid Endpoint');
+          const msg = 'Please enter a valid HTTP or HTTPS endpoint URL (for example, ' +
+            (device.targetAddressSpace === 'local' ? 'http://192.168.1.120:8080/api/status' : 'http://127.0.0.1:4580/api/status') + ').';
+          showFeedback(device, 'error', 'Invalid Endpoint URL', msg, 'input="' + rawUrl + '"');
+          appendLog(device.label + ': Connection aborted due to invalid URL "' + rawUrl + '".', 'error');
+          return;
+        }
+
+        const prePerm = await queryDevicePermission(device);
+
+        if (!window.isSecureContext) {
+          setConnectionBadge(device, 'error', 'Insecure Context');
+          showFeedback(
+            device,
+            'error',
+            'Secure Context Required for Local Network Access',
+            'Browsers block requests to ' + device.targetAddressSpace + ' endpoints from non-HTTPS pages. Load The Daily Grind over HTTPS or localhost and try again.',
+            'url=' + parsedUrl.href + ' | targetAddressSpace=' + device.targetAddressSpace + ' | isSecureContext=false'
+          );
+          appendLog(device.label + ': Warning — window.isSecureContext is false.', 'error');
+        } else if (prePerm.state === 'denied') {
+          setConnectionBadge(device, 'error', 'Permission Denied');
+          showFeedback(
+            device,
+            'error',
+            'Local Network Access Permission Denied (' + prePerm.name + ')',
+            'Your browser has blocked access to ' +
+              (device.targetAddressSpace === 'local'
+                ? 'devices on your local Wi-Fi network'
+                : 'services on your local loopback interface') +
+              '. Open your browser site permissions for this page, set "' + prePerm.name + '" to Allow, and reconnect.',
+            'url=' + parsedUrl.href + ' | targetAddressSpace=' + device.targetAddressSpace + ' | permission=' + prePerm.name + '=denied'
+          );
+        } else {
+          setConnectionBadge(device, 'connecting', 'Connecting...');
+          showFeedback(
+            device,
+            'info',
+            'Connecting to ' + device.label + '...',
+            prePerm.state === 'prompt'
+              ? 'Waiting for browser "' + prePerm.name + '" permission prompt and equipment response...'
+              : 'Sending fetch request with targetAddressSpace: "' + device.targetAddressSpace + '"...',
+            'GET ' + parsedUrl.href + ' | targetAddressSpace=' + device.targetAddressSpace + ' | permission=' + prePerm.state
+          );
+        }
+
+        device.connectBtn.disabled = true;
+        appendLog(device.label + ': Fetching ' + parsedUrl.href + ' (targetAddressSpace: "' + device.targetAddressSpace + '")...');
+
+        const controller = new AbortController();
+        const timeoutId = setTimeout(function () {
+          controller.abort();
+        }, 1500);
+
+        try {
+          const response = await fetch(parsedUrl.href, {
+            method: 'GET',
+            mode: 'cors',
+            targetAddressSpace: device.targetAddressSpace,
+            headers: {
+              'Accept': 'application/json, text/plain, */*'
+            },
+            signal: controller.signal
+          });
+          clearTimeout(timeoutId);
+
+          const postPerm = await queryDevicePermission(device);
+
+          if (!response.ok) {
+            setConnectionBadge(device, 'error', 'HTTP ' + response.status);
+            showFeedback(
+              device,
+              'error',
+              'Equipment Returned HTTP Error (' + response.status + ')',
+              'Reached ' + parsedUrl.host + ', but the endpoint returned status ' + response.status + ' (' + (response.statusText || 'Error') + '). Verify the API path and equipment firmware status.',
+              'url=' + parsedUrl.href + ' | status=' + response.status + ' | targetAddressSpace=' + device.targetAddressSpace + ' | permission=' + postPerm.state
+            );
+            appendLog(device.label + ': HTTP error ' + response.status + ' from ' + parsedUrl.href, 'error');
+            return;
+          }
+
+          let payloadPreview = '';
+          try {
+            const text = await response.text();
+            payloadPreview = text ? text.slice(0, 160) : 'OK (empty body)';
+          } catch (readErr) {
+            payloadPreview = 'OK';
+          }
+
+          setConnectionBadge(device, 'connected', 'Connected');
+          showFeedback(
+            device,
+            'success',
+            'Connected to ' + device.label,
+            'Successfully established connection over the ' + device.targetAddressSpace + ' address space. Equipment is online and ready for barista & customer commands.',
+            'url=' + parsedUrl.href + ' | targetAddressSpace=' + device.targetAddressSpace + ' | permission=' + postPerm.state + ' | response=' + payloadPreview
+          );
+          appendLog(device.label + ': Connected to ' + parsedUrl.href + ' (' + payloadPreview + ').', 'success');
+        } catch (err) {
+          clearTimeout(timeoutId);
+          const postPerm = await queryDevicePermission(device);
+          const isTimeout = err && err.name === 'AbortError';
+          const rawErrMessage = err && err.message ? err.message : String(err);
+
+          if (postPerm.state === 'denied') {
+            setConnectionBadge(device, 'error', 'Permission Denied');
+            showFeedback(
+              device,
+              'error',
+              'Local Network Access Permission Denied (' + postPerm.name + ')',
+              'The connection failed because the "' + postPerm.name + '" browser permission was denied. To connect, click the tune/lock icon in your browser address bar, allow "' + postPerm.name + '", and try again.',
+              'url=' + parsedUrl.href + ' | targetAddressSpace=' + device.targetAddressSpace + ' | permission=' + postPerm.name + '=denied | error=' + rawErrMessage
+            );
+            appendLog(device.label + ': Fetch blocked — permission "' + postPerm.name + '" was denied (' + rawErrMessage + ').', 'error');
+          } else if (isTimeout) {
+            setConnectionBadge(device, 'error', 'Connection Timed Out');
+            showFeedback(
+              device,
+              'error',
+              'Connection Timed Out',
+              'No response received from ' + parsedUrl.host + ' within 5 seconds. Ensure the ' +
+                (device.targetAddressSpace === 'local'
+                  ? 'Wi-Fi coffee brewer is powered on and connected to the same local network'
+                  : 'Companion Brewing Utility is running on your computer\'s loopback interface') + '.',
+              'url=' + parsedUrl.href + ' | targetAddressSpace=' + device.targetAddressSpace + ' | permission=' + postPerm.state + ' | error=Timeout (5000ms)'
+            );
+            appendLog(device.label + ': Connection to ' + parsedUrl.href + ' timed out after 5s.', 'error');
+          } else {
+            setConnectionBadge(device, 'error', 'Connection Error');
+            showFeedback(
+              device,
+              'error',
+              'Unable to Reach ' + device.label,
+              'The browser could not complete the request (' + rawErrMessage + '). Verify that ' +
+                (device.targetAddressSpace === 'local'
+                  ? 'the Wi-Fi brewer is reachable at ' + parsedUrl.host + ', Local Network Access ("' + postPerm.name + '") is allowed, and the brewer includes CORS headers.'
+                  : 'the companion utility is listening on ' + parsedUrl.host + ', Loopback Access ("' + postPerm.name + '") is allowed, and CORS is enabled.'),
+              'url=' + parsedUrl.href + ' | targetAddressSpace=' + device.targetAddressSpace + ' | permission=' + postPerm.name + ':' + postPerm.state + ' | error=' + rawErrMessage
+            );
+            appendLog(device.label + ': Connection error for ' + parsedUrl.href + ' — ' + rawErrMessage, 'error');
+          }
+        } finally {
+          device.connectBtn.disabled = false;
+        }
+      }
+
+      // Wire up event listeners
+      Object.values(DEVICES).forEach(function (device) {
+        device.connectBtn.addEventListener('click', function () {
+          connectToDevice(device);
+        });
+        device.checkPermBtn.addEventListener('click', function () {
+          queryDevicePermission(device);
+        });
+      });
+
+      document.querySelectorAll('.preset-btn[data-target]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const targetId = btn.getAttribute('data-target');
+          const url = btn.getAttribute('data-url');
+          const input = document.getElementById(targetId);
+          if (input && url) {
+            input.value = url;
+            appendLog('Selected preset endpoint: ' + url);
+          }
+        });
+      });
+
+      const refreshAllBtn = document.getElementById('refresh-permissions-btn');
+      if (refreshAllBtn) {
+        refreshAllBtn.addEventListener('click', function () {
+          updateSecurityContextBanner();
+          queryDevicePermission(DEVICES.brewer);
+          queryDevicePermission(DEVICES.loopback);
+        });
+      }
+
+      const connectAllBtn = document.getElementById('connect-all-btn');
+      if (connectAllBtn) {
+        connectAllBtn.addEventListener('click', function () {
+          connectToDevice(DEVICES.brewer);
+          connectToDevice(DEVICES.loopback);
+        });
+      }
+
+      const clearLogBtn = document.getElementById('clear-log-btn');
+      if (clearLogBtn) {
+        clearLogBtn.addEventListener('click', function () {
+          if (logListEl) {
+            logListEl.innerHTML = '';
+          }
+          appendLog('Activity log cleared.');
+        });
+      }
+
+      // Initial check on load
+      updateSecurityContextBanner();
+      queryDevicePermission(DEVICES.brewer);
+      queryDevicePermission(DEVICES.loopback);
+    })();
+  </script>
 </body>
 
 </html>
