+
+      function updateSecurityContextBanner() {
+        const isSecure = Boolean(window.isSecureContext);
+        const hasPermissionsApi = Boolean(navigator.permissions && typeof navigator.permissions.query === 'function');
+        if (!isSecure) {
+          securityBannerEl.classList.add('insecure');
+          securityTextEl.textContent =
+            'Warning: Insecure context detected. Browser Local Network Access (local-network & loopback-network) requires HTTPS or a secure context.';
+          appendLog('Insecure browsing context detected (window.isSecureContext = false). LNA requests may be blocked.', 'error');
+        } else if (!hasPermissionsApi) {
