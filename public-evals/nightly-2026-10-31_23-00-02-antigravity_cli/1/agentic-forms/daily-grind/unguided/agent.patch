+  <script>
+    (function () {
+      const form = document.getElementById('quick-order-form');
+      const resultContainer = document.getElementById('order-result');
+      const agentBanner = document.getElementById('agent-banner');
+
+      const basePrices = {
+        'Maple Oat Latte': 5.50,
+        'Dark Roast Espresso': 3.75,
+        'Cold Brew': 4.50,
+        'Cappuccino': 4.75,
+        'Vanilla Bean Matcha': 5.25
+      };
+
+      const sizeModifiers = {
+        'Small': -0.50,
+        'Medium': 0.00,
+        'Large': 0.75
+      };
+
+      window.addEventListener('toolactivated', (event) => {
+        if (event.toolName === 'quick_order_coffee' && agentBanner) {
+          agentBanner.style.display = 'block';
+        }
+      });
+
+      window.addEventListener('toolcancel', (event) => {
+        if (event.toolName === 'quick_order_coffee' && agentBanner) {
+          agentBanner.style.display = 'none';
+        }
+      });
+
+      if (form) {
+        form.addEventListener('submit', (event) => {
+          event.preventDefault();
+
+          if (agentBanner) {
+            agentBanner.style.display = 'none';
+          }
+
+          const formData = new FormData(form);
+          const drink = formData.get('drink') || 'Maple Oat Latte';
+          const size = formData.get('size') || 'Medium';
+          const temperature = formData.get('temperature') || 'Hot';
+          const milk = formData.get('milk') || 'Oat Milk';
+          const customerName = formData.get('customer_name') || 'Guest';
+          const extraShots = parseInt(formData.get('extra_shots') || '0', 10) || 0;
+          const notes = (formData.get('notes') || '').trim();
+
+          const basePrice = basePrices[drink] || 4.75;
+          const sizeAddon = sizeModifiers[size] || 0;
+          const shotsAddon = extraShots * 1.00;
+          const total = (basePrice + sizeAddon + shotsAddon).toFixed(2);
+          const orderId = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+
+          const orderSummary = {
+            status: 'confirmed',
+            orderId: orderId,
+            customerName: customerName,
+            item: {
+              drink: drink,
+              size: size,
+              temperature: temperature,
+              milk: milk,
+              extraShots: extraShots,
+              notes: notes || null
+            },
+            totalPrice: '$' + total,
+            estimatedPickupMinutes: 5,
+            message: `Order ${orderId} confirmed for ${customerName}: ${size} ${temperature} ${drink} (${milk}${extraShots > 0 ? ', +' + extraShots + ' shot(s)' : ''}) - $${total}. Ready in ~5 mins.`
+          };
+
+          if (resultContainer) {
+            resultContainer.innerHTML = '';
+            const heading = document.createElement('h3');
+            heading.textContent = `Order Confirmed (${orderId})`;
+
+            const details = document.createElement('p');
+            details.textContent = `Thanks, ${customerName}! Your ${size} ${temperature} ${drink} with ${milk}${extraShots > 0 ? ` (+${extraShots} extra espresso shot${extraShots > 1 ? 's' : ''})` : ''} is being prepared.`;
+
+            const meta = document.createElement('p');
+            meta.style.marginTop = '6px';
+            meta.innerHTML = `<strong>Total:</strong> $${total} &bull; <strong>Estimated Pickup:</strong> 5 minutes`;
+
+            resultContainer.appendChild(heading);
+            resultContainer.appendChild(details);
+            if (notes) {
+              const noteEl = document.createElement('p');
+              noteEl.style.fontSize = '0.9rem';
+              noteEl.style.marginTop = '4px';
+              noteEl.textContent = `Notes: "${notes}"`;
+              resultContainer.appendChild(noteEl);
+            }
+            resultContainer.appendChild(meta);
+            resultContainer.style.display = 'block';
+          }
+
+          if (event.agentInvoked && typeof event.respondWith === 'function') {
+            event.respondWith(Promise.resolve(orderSummary));
+          }
+        });
+      }
+    })();
+  </script>
 </body>
 
