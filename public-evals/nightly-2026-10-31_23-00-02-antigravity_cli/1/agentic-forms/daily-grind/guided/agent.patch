+  <script>
+    const COFFEE_CATALOG = [
+      {
+        name: 'Maple Oat Latte',
+        roast: 'medium',
+        temperature: ['hot', 'iced'],
+        milk: ['oat'],
+        decafAvailable: true,
+        unsweetened: false,
+        notes: 'maple, oat, creamy, sweet, autumn, cinnamon, smooth',
+        price: '$5.50'
+      },
+      {
+        name: 'Dark Roast Espresso',
+        roast: 'dark',
+        temperature: ['hot', 'iced'],
+        milk: ['none', 'whole', 'skim', 'oat', 'almond', 'coconut'],
+        decafAvailable: true,
+        unsweetened: true,
+        notes: 'bold, smokey, dark chocolate, intense, rich, espresso',
+        price: '$3.75'
+      },
+      {
+        name: '18-Hour Artisanal Cold Brew',
+        roast: 'medium',
+        temperature: ['iced'],
+        milk: ['none', 'whole', 'skim', 'oat', 'almond', 'coconut'],
+        decafAvailable: false,
+        unsweetened: true,
+        notes: 'smooth, chocolatey, low acid, cold brew, refreshing, nutty',
+        price: '$4.75'
+      },
+      {
+        name: 'Ethiopian Yirgacheffe Pour-Over',
+        roast: 'light',
+        temperature: ['hot', 'iced'],
+        milk: ['none'],
+        decafAvailable: false,
+        unsweetened: true,
+        notes: 'floral, jasmine, citrus, bergamot, bright, fruity, tea-like',
+        price: '$5.25'
+      },
+      {
+        name: 'Honey Almond Flat White',
+        roast: 'medium',
+        temperature: ['hot', 'iced'],
+        milk: ['almond', 'whole', 'oat'],
+        decafAvailable: true,
+        unsweetened: false,
+        notes: 'honey, nutty, almond, velvety, caramel, sweet',
+        price: '$5.25'
+      },
+      {
+        name: 'Toasted Coconut Mocha',
+        roast: 'dark',
+        temperature: ['hot', 'iced'],
+        milk: ['coconut', 'whole', 'oat'],
+        decafAvailable: true,
+        unsweetened: false,
+        notes: 'coconut, chocolatey, cocoa, dark, rich, sweet, mocha',
+        price: '$5.75'
+      }
+    ];
+
+    const finderForm = document.getElementById('coffee-finder-form');
+    const queryInput = document.getElementById('flavor-query');
+    const queryError = document.getElementById('query-error');
+    const resultsContainer = document.getElementById('finder-results');
+
+    function validateFinderForm() {
+      const errors = [];
+      const queryValue = queryInput.value.trim();
+
+      if (!queryValue) {
+        const msg = 'Please enter a flavor note or keyword to search.';
+        queryInput.setCustomValidity(msg);
+        queryError.textContent = msg;
+        errors.push({ field: 'query', message: msg });
+      } else if (queryValue.length < 2) {
+        const msg = 'Flavor keyword must be at least 2 characters long.';
+        queryInput.setCustomValidity(msg);
+        queryError.textContent = msg;
+        errors.push({ field: 'query', message: msg });
+      } else {
+        queryInput.setCustomValidity('');
+        queryError.textContent = '';
+      }
+
+      return errors;
+    }
+
+    // Validate on blur to avoid premature warnings while typing, reset on input
+    queryInput.addEventListener('blur', () => {
+      validateFinderForm();
+    });
+
+    queryInput.addEventListener('input', () => {
+      queryInput.setCustomValidity('');
+      queryError.textContent = '';
+    });
+
+    function searchCoffees(formData) {
+      const query = (formData.get('query') || '').toString().trim().toLowerCase();
+      const roast = (formData.get('roast') || 'any').toString();
+      const temperature = (formData.get('temperature') || 'any').toString();
+      const milk = (formData.get('milk') || 'any').toString();
+      const decafOnly = formData.get('decaf') === 'true';
+      const unsweetenedOnly = formData.get('unsweetened') === 'true';
+
+      const matches = COFFEE_CATALOG.filter((item) => {
+        const matchesQuery =
+          !query ||
+          query === 'any' ||
+          item.name.toLowerCase().includes(query) ||
+          item.notes.toLowerCase().includes(query) ||
+          item.roast.toLowerCase().includes(query);
+        const matchesRoast = roast === 'any' || item.roast === roast;
+        const matchesTemp = temperature === 'any' || item.temperature.includes(temperature);
+        const matchesMilk = milk === 'any' || item.milk.includes(milk);
+        const matchesDecaf = !decafOnly || item.decafAvailable;
+        const matchesUnsweetened = !unsweetenedOnly || item.unsweetened;
+
+        return (
+          matchesQuery &&
+          matchesRoast &&
+          matchesTemp &&
+          matchesMilk &&
+          matchesDecaf &&
+          matchesUnsweetened
+        );
+      });
+
+      return matches;
+    }
+
+    function renderResults(matches, query) {
+      resultsContainer.replaceChildren();
+
+      const heading = document.createElement('h3');
+      if (matches.length === 0) {
+        heading.textContent = 'No exact matches found';
+        const fallbackMsg = document.createElement('p');
+        fallbackMsg.textContent = `We couldn't find a drink matching "${query}" with those exact filters. Try broadening your roast or milk preference!`;
+        resultsContainer.append(heading, fallbackMsg);
+        return `No exact matches found for "${query}" with the selected filters.`;
+      }
+
+      heading.textContent = `Recommended Drinks (${matches.length})`;
+      const list = document.createElement('ul');
+
+      const summaryLines = matches.map((drink) => {
+        const li = document.createElement('li');
+        const title = document.createElement('strong');
+        title.textContent = `${drink.name} (${drink.price})`;
+        const details = document.createElement('span');
+        details.textContent = ` — ${drink.roast} roast, notes of ${drink.notes}`;
+        li.append(title, details);
+        list.appendChild(li);
+
+        return `${drink.name} (${drink.price}): ${drink.roast} roast, notes of ${drink.notes}`;
+      });
+
+      resultsContainer.append(heading, list);
+      return `Found ${matches.length} matching coffee(s): ${summaryLines.join('; ')}`;
+    }
+
+    finderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const formValidationErrors = validateFinderForm();
+
+      if (formValidationErrors.length > 0) {
+        if (event.agentInvoked) {
+          const errorString =
+            'Validation failed: ' +
+            formValidationErrors
+              .map((err) => `${err.field} (${err.message})`)
+              .join(', ');
+          event.respondWith(Promise.resolve(errorString));
+        } else {
+          queryInput.focus();
+        }
+        return;
+      }
+
+      const formData = new FormData(event.target);
+      const matches = searchCoffees(formData);
+      const summaryText = renderResults(matches, formData.get('query'));
+
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve(summaryText));
+      }
+    });
+
+    // WebMCP Lifecycle Events with backward-compatible target detection
+    const targetFor = (type, listener, options) =>
+      (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+        .addEventListener(type, listener, options);
+
+    targetFor('toolactivated', ({ toolName }) => {
+      console.log(`Tool "${toolName}" started execution.`);
+    });
+
+    targetFor('toolcancel', ({ toolName }) => {
+      console.log(`Tool "${toolName}" execution is cancelled.`);
+    });
+  </script>
+
 </body>
 
