+  <script>
+    let currentScrollId = 0;
+    const highlightTargets = document.querySelectorAll('.section-block, .card');
+
+    function scrollIntoViewAsync(element, options, scroller = window) {
+      const result = element.scrollIntoView(options);
+
+      // Feature detect: in supporting browsers, scrollIntoView() returns a Promise
+      if (result instanceof Promise) {
+        return result;
+      }
+
+      // Fallback for browsers where scrollIntoView() returns undefined
+      return new Promise((resolve) => {
+        let timeoutId;
+
+        const finish = () => {
+          clearTimeout(timeoutId);
+          scroller.removeEventListener('scrollend', finish);
+          scroller.removeEventListener('scroll', onScroll);
+          resolve();
+        };
+
+        const onScroll = () => {
+          // Restart the idle timer on every scroll event. If scrollend never fires
+          // (browsers without scrollend support), this resolves once scrolling goes idle.
+          clearTimeout(timeoutId);
+          timeoutId = setTimeout(finish, 100);
+        };
+
+        scroller.addEventListener('scrollend', finish, { once: true });
+        scroller.addEventListener('scroll', onScroll, { passive: true });
+
+        // If no scroll event fires within the idle window (e.g., already in view), resolve.
+        timeoutId = setTimeout(finish, 100);
+      });
+    }
+
+    async function scrollToAndHighlight(targetElement) {
+      const scrollId = ++currentScrollId;
+      highlightTargets.forEach((el) => el.classList.remove('highlight'));
+
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+      const scrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';
+
+      await scrollIntoViewAsync(targetElement, {
+        behavior: scrollBehavior,
+        block: 'center'
+      });
+
+      // Abort follow-up effect if another scroll was triggered while awaiting
+      if (scrollId !== currentScrollId) return;
+
+      targetElement.classList.add('highlight');
+
+      const focusTarget =
+        targetElement.querySelector('h1[tabindex="-1"], h2[tabindex="-1"], h3[tabindex="-1"]') ||
+        targetElement;
+      if (!focusTarget.hasAttribute('tabindex')) {
+        focusTarget.setAttribute('tabindex', '-1');
+      }
+      focusTarget.focus({ preventScroll: true });
+    }
+
+    // Map both hash links (#menu) and legacy path links (/menu) to in-page section IDs
+    function resolveTargetElement(link) {
+      const rawHref = link.getAttribute('href');
+      if (!rawHref) return null;
+
+      if (rawHref.startsWith('#')) {
+        const id = rawHref.slice(1);
+        return document.getElementById(id);
+      }
+
+      if (rawHref.startsWith('/')) {
+        const normalizedId = rawHref.slice(1).replace(/\//g, '-');
+        return document.getElementById(normalizedId);
+      }
+
+      return null;
+    }
+
+    document.addEventListener('click', async (event) => {
+      const link = event.target.closest('a[href]');
+      if (!link) return;
+
+      const targetElement = resolveTargetElement(link);
+      if (!targetElement) return;
+
+      event.preventDefault();
+      history.pushState(null, '', `#${targetElement.id}`);
+      await scrollToAndHighlight(targetElement);
+    });
+  </script>
