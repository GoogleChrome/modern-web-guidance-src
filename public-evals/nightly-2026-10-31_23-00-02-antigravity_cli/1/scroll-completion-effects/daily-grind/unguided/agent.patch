+  <script>
+    (function () {
+      let cleanupActiveScroll = null;
+
+      function clearPreviousTargetEffects() {
+        document.querySelectorAll('.scroll-target-active, .scroll-animating').forEach((el) => {
+          el.classList.remove('scroll-target-active', 'scroll-animating');
+          el.removeAttribute('data-scroll-arrived');
+        });
+      }
+
+      function applyPostScrollEffects(target, hash) {
+        if (hash) {
+          history.replaceState(null, '', hash);
+        }
+
+        clearPreviousTargetEffects();
+
+        // Force reflow so re-selecting the same target replays the animation cleanly
+        void target.offsetWidth;
+
+        target.classList.add('scroll-target-active', 'scroll-animating');
+        target.setAttribute('data-scroll-arrived', 'true');
+
+        if (!target.hasAttribute('tabindex')) {
+          target.setAttribute('tabindex', '-1');
+        }
+        target.focus({ preventScroll: true });
+
+        target.addEventListener(
+          'animationend',
+          (event) => {
+            if (event.target === target) {
+              target.classList.remove('scroll-animating');
+            }
+          },
+          { once: true }
+        );
+      }
+
+      function smoothScrollAndActivate(target, triggerLink, hash) {
+        if (cleanupActiveScroll) {
+          cleanupActiveScroll();
+          cleanupActiveScroll = null;
+        }
+
+        // Remove active target classes prior to scrolling so effects only trigger after scroll completion
+        clearPreviousTargetEffects();
+
+        if (triggerLink && triggerLink.closest('nav')) {
+          document.querySelectorAll('nav a.active').forEach((link) => link.classList.remove('active'));
+          if (!triggerLink.classList.contains('logo')) {
+            triggerLink.classList.add('active');
+          }
+        }
+
+        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+        let completed = false;
+        let hasScrolled = false;
+        let debounceTimer = null;
+        let noScrollTimer = null;
+        let maxWaitTimer = null;
+
+        const finish = () => {
+          if (completed) return;
+          completed = true;
+          if (cleanupActiveScroll) {
+            cleanupActiveScroll();
+            cleanupActiveScroll = null;
+          }
+          applyPostScrollEffects(target, hash);
+        };
+
+        const onScroll = () => {
+          hasScrolled = true;
+          if (noScrollTimer) {
+            clearTimeout(noScrollTimer);
+            noScrollTimer = null;
+          }
+          if (debounceTimer) {
+            clearTimeout(debounceTimer);
+          }
+          // Fallback completion detector when scroll events stop firing
+          debounceTimer = setTimeout(finish, 120);
+        };
+
+        const onScrollEnd = () => {
+          finish();
+        };
+
+        cleanupActiveScroll = () => {
+          window.removeEventListener('scroll', onScroll, { passive: true });
+          window.removeEventListener('scrollend', onScrollEnd);
+          document.removeEventListener('scrollend', onScrollEnd);
+          if (debounceTimer) clearTimeout(debounceTimer);
+          if (noScrollTimer) clearTimeout(noScrollTimer);
+          if (maxWaitTimer) clearTimeout(maxWaitTimer);
+        };
+
+        if (prefersReducedMotion) {
+          target.scrollIntoView({ behavior: 'auto', block: 'start' });
+          requestAnimationFrame(finish);
+          return;
+        }
+
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('scrollend', onScrollEnd, { once: true });
+        document.addEventListener('scrollend', onScrollEnd, { once: true });
+
+        // If the target is already in position and no scroll event fires, activate shortly after
+        noScrollTimer = setTimeout(() => {
+          if (!hasScrolled) {
+            finish();
+          }
+        }, 100);
+
+        // Safety upper bound in case scroll is interrupted by environment constraints
+        maxWaitTimer = setTimeout(finish, 2000);
+
+        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      }
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[href^="#"]');
+        if (!link) return;
+
+        const hash = link.getAttribute('href');
+        if (!hash || hash === '#') return;
+
+        const targetId = decodeURIComponent(hash.slice(1));
+        const target = document.getElementById(targetId);
+        if (!target) return;
+
+        event.preventDefault();
+        smoothScrollAndActivate(target, link, hash);
+      });
+    })();
+  </script>
 </body>
 
