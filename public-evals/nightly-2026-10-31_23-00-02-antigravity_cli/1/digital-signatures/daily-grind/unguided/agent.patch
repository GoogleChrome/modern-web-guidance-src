+          ? `Gift Voucher ${p.voucherCode} ($${p.amountUSD})`
+          : `Order Receipt ${p.orderId} ($${p.totalUSD})`;
+        const person = isVoucher ? `To: ${p.recipientName}` : `Customer: ${p.customerName}`;
+
+        itemEl.innerHTML = `
+          <div>
+            <div class="ledger-item-top">
+              <strong>${title}</strong>
+              <span class="badge ${badgeCls}">${bundle.algorithm}</span>
+            </div>
+            <div style="font-size: 0.82rem; color: var(--text-muted); margin-top: 4px;">
+              ${person}
+            </div>
+            <div class="mono" style="font-size: 0.74rem; color: var(--primary); margin-top: 4px;">
+              Sig: ${bundle.signature.slice(0, 32)}...
+            </div>
+          </div>
+          <button type="button" class="btn btn-sm btn-secondary" data-ledger-idx="${idx}">
+            Inspect &amp; Verify
+          </button>
+        `;
+        itemEl.querySelector('button').addEventListener('click', async () => {
+          const jsonStr = JSON.stringify(bundle, null, 2);
+          lastValidBundleJson = jsonStr;
+          verifierInput.value = jsonStr;
+          renderSignedPreview(bundle);
+          await runVerificationFromInput();
+        });
+        ledgerListEl.appendChild(itemEl);
+      });
+    }
+
+    async function runVerificationFromInput() {
+      const rawText = verifierInput.value.trim();
+      let parsed;
+      try {
+        parsed = JSON.parse(rawText);
+      } catch (e) {
+        verifyBanner.className = 'verify-banner invalid';
+        verifyIcon.innerHTML = '&#10008;';
+        verifyTitle.textContent = 'Invalid JSON Format';
+        verifyDesc.textContent = 'The bundle could not be parsed as valid JSON: ' + e.message;
+        verifyMeta.textContent = '';
+        return;
+      }
+
+      const result = await verifySignedBundle(parsed);
+      if (result.valid) {
+        verifyBanner.className = 'verify-banner valid';
+        verifyIcon.innerHTML = '&#10004;';
+        const docLabel = parsed.documentType === 'GIFT_VOUCHER' ? 'Gift Voucher' : 'Coffee Order Receipt';
+        verifyTitle.textContent = `Authentic & Intact — ${docLabel} Verified`;
+        verifyDesc.textContent = result.reason;
+        verifyMeta.textContent = `SHA-256: ${result.computedHash.slice(0, 32)}... | Key FP: ${result.computedFp} | Sig Size: ${result.sigByteLength} B`;
+      } else {
+        verifyBanner.className = 'verify-banner invalid';
+        verifyIcon.innerHTML = '&#10008;';
+        verifyTitle.textContent = 'Verification Failed — Tampering or Forgery Detected';
+        verifyDesc.textContent = result.reason;
+        verifyMeta.textContent = result.computedHash
+          ? `Computed SHA-256: ${result.computedHash.slice(0, 32)}...`
+          : '';
+      }
+    }
+
+    // Event Listeners
+    algoSelect.addEventListener('change', async () => {
+      currentAlgorithm = algoSelect.value;
+      await updateKeyWorkbenchUI(currentAlgorithm, false);
+    });
+
+    generateKeyBtn.addEventListener('click', async () => {
+      await updateKeyWorkbenchUI(currentAlgorithm, true);
+      await signCurrentFormAndVerify();
+    });
+
+    tabReceipt.addEventListener('click', () => {
+      currentDocType = 'receipt';
+      tabReceipt.classList.add('active');
+      tabReceipt.setAttribute('aria-selected', 'true');
+      tabVoucher.classList.remove('active');
+      tabVoucher.setAttribute('aria-selected', 'false');
+      formReceipt.style.display = '';
+      formVoucher.style.display = 'none';
+      signDocBtn.textContent = 'Digitally Sign Coffee Order Receipt';
+    });
+
+    tabVoucher.addEventListener('click', () => {
+      currentDocType = 'voucher';
+      tabVoucher.classList.add('active');
+      tabVoucher.setAttribute('aria-selected', 'true');
+      tabReceipt.classList.remove('active');
+      tabReceipt.setAttribute('aria-selected', 'false');
+      formVoucher.style.display = '';
+      formReceipt.style.display = 'none';
+      signDocBtn.textContent = 'Digitally Sign Gift Voucher';
+    });
+
+    async function signCurrentFormAndVerify() {
+      const payload = buildCurrentPayload();
+      const signedBundle = await signPayload(currentAlgorithm, payload);
+      const jsonStr = JSON.stringify(signedBundle, null, 2);
+      lastValidBundleJson = jsonStr;
+      verifierInput.value = jsonStr;
+      renderSignedPreview(signedBundle);
+
+      // Prepend to ledger (keep max 6)
+      signedLedger.unshift(signedBundle);
+      if (signedLedger.length > 6) signedLedger.pop();
+      renderLedger();
+
+      await runVerificationFromInput();
+    }
+
+    signDocBtn.addEventListener('click', signCurrentFormAndVerify);
+
+    sendToVerifierBtn.addEventListener('click', async () => {
+      if (lastValidBundleJson) {
+        verifierInput.value = lastValidBundleJson;
+        await runVerificationFromInput();
+      }
+    });
+
+    copyBundleBtn.addEventListener('click', async () => {
+      try {
+        await navigator.clipboard.writeText(verifierInput.value);
+        const orig = copyBundleBtn.textContent;
+        copyBundleBtn.textContent = 'Copied!';
+        setTimeout(() => { copyBundleBtn.textContent = orig; }, 1200);
+      } catch (_) {}
+    });
+
+    verifyBtn.addEventListener('click', runVerificationFromInput);
+    verifierInput.addEventListener('input', runVerificationFromInput);
+
+    tamperPayloadBtn.addEventListener('click', async () => {
+      try {
+        const bundle = JSON.parse(verifierInput.value);
+        if (bundle.payload) {
+          if (bundle.payload.type === 'GIFT_VOUCHER') {
+            bundle.payload.amountUSD = '9999.00';
+          } else {
+            bundle.payload.totalUSD = '0.01';
+          }
+          verifierInput.value = JSON.stringify(bundle, null, 2);
+          await runVerificationFromInput();
+        }
+      } catch (_) {}
+    });
+
+    tamperSigBtn.addEventListener('click', async () => {
+      try {
+        const bundle = JSON.parse(verifierInput.value);
+        if (bundle.signature && bundle.signature.length > 10) {
+          const sigBytes = base64ToBytes(bundle.signature);
+          sigBytes[0] ^= 0xff;
+          sigBytes[Math.floor(sigBytes.length / 2)] ^= 0x55;
+          bundle.signature = bytesToBase64(sigBytes);
+          verifierInput.value = JSON.stringify(bundle, null, 2);
+          await runVerificationFromInput();
+        }
+      } catch (_) {}
+    });
+
+    restoreValidBtn.addEventListener('click', async () => {
+      if (lastValidBundleJson) {
+        verifierInput.value = lastValidBundleJson;
+        await runVerificationFromInput();
+      }
+    });
+
+    // Initialize default signed gift voucher (Classical ECDSA) and coffee receipt (Quantum-Resistant ML-DSA-65)
+    (async function initTrustCenter() {
+      calculateReceiptTotal();
+      await updateKeyWorkbenchUI('ECDSA-P256', false);
+      const sampleVoucherPayload = {
+        type: 'GIFT_VOUCHER',
+        issuer: 'The Daily Grind Coffee Co.',
+        voucherCode: 'GIFT-DG-2026-9941',
+        amountUSD: '50.00',
+        recipientName: 'Marcus Sterling',
+        senderName: 'Sofia Chen',
+        expiresOn: '2027-12-31',
+        personalMessage: 'Enjoy a month of artisanal espressos!',
+        redeemableAt: 'All Daily Grind Locations & Online',
+        issuedAt: new Date().toISOString()
+      };
+      const signedVoucher = await signPayload('ECDSA-P256', sampleVoucherPayload);
+      signedLedger.push(signedVoucher);
+
+      // Now switch to default Quantum-Resistant ML-DSA-65 and sign the initial Coffee Order Receipt
+      currentAlgorithm = 'ML-DSA-65';
+      algoSelect.value = 'ML-DSA-65';
+      await updateKeyWorkbenchUI('ML-DSA-65', false);
+      await signCurrentFormAndVerify();
+    })();
+  </script>
+
 </body>
 
 </html>
