+ * Uses 'raw-public' for ML-DSA keys (1312, 1952, or 2592 bytes) and 'raw' for Ed25519,
+ * with key usage ['verify'] only.
+ */
+export async function resolveVerifierPublicKey(publicKeyOrBytes) {
+  if (publicKeyOrBytes instanceof CryptoKey) {
+    return publicKeyOrBytes;
+  }
+  const bytes =
+    publicKeyOrBytes instanceof Uint8Array
+      ? publicKeyOrBytes
+      : typeof publicKeyOrBytes === 'string'
+        ? fromBase64(publicKeyOrBytes)
+        : new Uint8Array(publicKeyOrBytes);
