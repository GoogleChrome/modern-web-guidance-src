+  if (ctx.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+
+  const publicKey = await resolveVerifierPublicKey(publicKeyOrBytes);
+
+  if (publicKey.algorithm.name.startsWith('ML-DSA')) {
+    return crypto.subtle.verify(
+      { name: publicKey.algorithm.name, context: ctx },
+      publicKey,
+      sig,
+      data,
+    );
+  }
+
+  const framed = frameFallbackInput(data, ctx);
+  return crypto.subtle.verify('Ed25519', publicKey, sig, framed);
+}
