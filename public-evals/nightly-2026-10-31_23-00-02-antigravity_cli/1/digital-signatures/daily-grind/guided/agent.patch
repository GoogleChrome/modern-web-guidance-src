index 0000000..2baba08
--- /dev/null
+++ b/crypto-signing.js
@@ -0,0 +1,243 @@
+/**
+ * Cryptographic signing and verification module for The Daily Grind
+ * Supports Post-Quantum ML-DSA ('ML-DSA-44', 'ML-DSA-65', 'ML-DSA-87')
+ * with automatic detection via SubtleCrypto.supports() and classical Ed25519 fallback.
+ */
+
+export const ML_DSA_PUBLIC_KEY_ALGORITHMS = {
+  1312: 'ML-DSA-44',
+  1952: 'ML-DSA-65',
+  2592: 'ML-DSA-87',
+};
+
+export const DOMAIN_CONTEXTS = {
+  receipt: 'daily-grind-order-receipt-v1',
+  voucher: 'daily-grind-gift-voucher-v1',
+};
+
+/**
+ * Detect whether the current browser supports post-quantum ML-DSA signatures
+ * using the static SubtleCrypto.supports() method.
+ */
+export function supportsPostQuantumSignatures(algorithm = 'ML-DSA-65') {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('sign', algorithm)
+  );
+}
+
+/**
+ * Encode a string into a UTF-8 Uint8Array.
+ */
+export function encodeText(text) {
+  return new TextEncoder().encode(text);
+}
+
+/**
+ * Convert a Uint8Array or ArrayBuffer to Base64 string.
+ */
+export function toBase64(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toBase64 === 'function') {
+    return u8.toBase64();
+  }
+  let binary = '';
+  for (let i = 0; i < u8.byteLength; i++) {
+    binary += String.fromCharCode(u8[i]);
+  }
+  return btoa(binary);
+}
+
+/**
+ * Convert a Base64 string to Uint8Array.
+ */
+export function fromBase64(base64Str) {
+  const cleaned = base64Str.trim();
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(cleaned);
+  }
+  const binary = atob(cleaned);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+/**
+ * Convert a Uint8Array or ArrayBuffer to a hexadecimal string.
+ */
+export function toHex(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toHex === 'function') {
+    return u8.toHex();
+  }
+  return Array.from(u8, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+/**
+ * Generate a signing and verification key pair.
+ * Defaults to 'ML-DSA-65' if supported, otherwise falls back to 'Ed25519'.
+ * If a specific suite ('ML-DSA-44', 'ML-DSA-65', 'ML-DSA-87', 'Ed25519') is requested
+ * and supported, uses that suite; if an ML-DSA suite is requested on an unsupported browser,
+ * gracefully falls back to 'Ed25519'.
+ */
+export async function generateSigningKeyPair(preferredAlgorithm = 'ML-DSA-65') {
+  const wantsMlDsa = preferredAlgorithm.startsWith('ML-DSA');
+  if (wantsMlDsa && supportsPostQuantumSignatures(preferredAlgorithm)) {
+    const keyPair = await crypto.subtle.generateKey(
+      preferredAlgorithm,
+      false,
+      ['sign', 'verify'],
+    );
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    return {
+      suite: preferredAlgorithm,
+      keyFormat: 'raw-public',
+      isPostQuantum: true,
+      keyPair,
+      publicKeyBytes,
+    };
+  }
+
+  // Classical fallback or explicit Ed25519 selection
+  const keyPair = await crypto.subtle.generateKey(
+    'Ed25519',
+    false,
+    ['sign', 'verify'],
+  );
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', keyPair.publicKey),
+  );
+  return {
+    suite: 'Ed25519',
+    keyFormat: 'raw',
+    isPostQuantum: false,
+    keyPair,
+    publicKeyBytes,
+  };
+}
+
+/**
+ * Derive a public verification CryptoKey from a private signing CryptoKey
+ * when supported by SubtleCrypto.getPublicKey().
+ */
+export async function derivePublicKeyFromPrivate(privateKey) {
+  if (typeof crypto.subtle.getPublicKey === 'function') {
+    return crypto.subtle.getPublicKey(privateKey, ['verify']);
+  }
+  return null;
+}
+
+/**
+ * Prepend a length-prefixed context header for classical fallback algorithms
+ * ('Ed25519' and 'ECDSA'), which do not read a `context` property from the
+ * algorithm dictionary.
+ */
+export function frameFallbackInput(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+/**
+ * Sign a payload with domain separation using ML-DSA ContextParams or
+ * length-prefixed framing for classical Ed25519 fallback.
+ */
+export async function signPayload(
+  privateKey,
+  payloadBytes,
+  contextBytes = new Uint8Array(0),
+) {
+  const ctx =
+    typeof contextBytes === 'string' ? encodeText(contextBytes) : contextBytes;
+  const data =
+    typeof payloadBytes === 'string' ? encodeText(payloadBytes) : payloadBytes;
+
+  if (ctx.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
