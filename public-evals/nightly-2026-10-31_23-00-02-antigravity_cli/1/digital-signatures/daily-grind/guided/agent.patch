+++ b/app.js
@@ -0,0 +1,506 @@
+import {
+  DOMAIN_CONTEXTS,
+  supportsPostQuantumSignatures,
+  encodeText,
+  toBase64,
+  fromBase64,
+  toHex,
+  generateSigningKeyPair,
+  signPayload,
+  verifyPayload,
+} from './crypto-signing.js';
+
+const ITEM_CATALOG = {
+  'maple-oat-latte': {
+    id: 'maple-oat-latte',
+    name: 'Maple Oat Latte',
+    price: 5.75,
+  },
+  'dark-roast-espresso': {
+    id: 'dark-roast-espresso',
+    name: 'Dark Roast Espresso',
+    price: 3.5,
+  },
+  'cold-brew': {
+    id: 'cold-brew',
+    name: 'Cold Brew',
+    price: 4.5,
+  },
+};
+
+const state = {
+  activeKeyRecord: null,
+  preferredSuite: 'ML-DSA-65',
+  latestEnvelope: null,
+};
+
+function announceStatus(message) {
+  const announcer = document.getElementById('status-announcer');
+  if (announcer) {
+    announcer.textContent = message;
+  }
+}
+
+function updateKeyDashboard() {
+  if (!state.activeKeyRecord) return;
+  const { suite, keyFormat, isPostQuantum, publicKeyBytes } = state.activeKeyRecord;
+
+  const badgeEl = document.getElementById('active-suite-badge');
+  const formatEl = document.getElementById('active-key-format');
+  const sizeEl = document.getElementById('active-key-size');
+  const pubKeyEl = document.getElementById('active-public-key');
+  const pqSupportEl = document.getElementById('pq-support-indicator');
+
+  const pqSupported = supportsPostQuantumSignatures('ML-DSA-65');
+  if (pqSupportEl) {
+    pqSupportEl.textContent = pqSupported
+      ? 'Quantum-Resistant ML-DSA Supported (NIST FIPS 204)'
+      : 'Classical WebCrypto Active (Ed25519 Fallback)';
+    pqSupportEl.className = pqSupported ? 'support-pill pq-ready' : 'support-pill classical-fallback';
+  }
+
+  if (badgeEl) {
+    badgeEl.textContent = `${suite} (${isPostQuantum ? 'Post-Quantum' : 'Classical'})`;
+  }
+  if (formatEl) {
+    formatEl.textContent = keyFormat;
+  }
+  if (sizeEl) {
+    sizeEl.textContent = `${publicKeyBytes.byteLength} bytes`;
+  }
+  if (pubKeyEl) {
+    pubKeyEl.value = toBase64(publicKeyBytes);
+  }
+}
+
+async function initOrRotateKeys(preferredSuite = state.preferredSuite) {
+  state.preferredSuite = preferredSuite;
+  const record = await generateSigningKeyPair(preferredSuite);
+  state.activeKeyRecord = record;
+  updateKeyDashboard();
+
+  // Also pre-fill the verifier public key field if it is empty or matches previous active key
+  const verifyPubKeyInput = document.getElementById('verify-public-key');
+  if (verifyPubKeyInput) {
+    verifyPubKeyInput.value = toBase64(record.publicKeyBytes);
+  }
+  announceStatus(`Generated new ${record.suite} signing key pair (${record.publicKeyBytes.byteLength} byte public key).`);
+  return record;
+}
+
+function renderSignedArtifact(envelope, artifactLabel) {
+  state.latestEnvelope = envelope;
+
+  const outputSection = document.getElementById('signed-artifact-panel');
+  if (outputSection) {
+    outputSection.hidden = false;
+  }
+
+  const titleEl = document.getElementById('signed-artifact-title');
+  const suiteMetaEl = document.getElementById('signed-suite-meta');
+  const contextMetaEl = document.getElementById('signed-context-meta');
+  const sigSizeMetaEl = document.getElementById('signed-sig-size-meta');
+  const envelopeTextarea = document.getElementById('signed-envelope-json');
+
+  const sigBytes = fromBase64(envelope.signature);
+
+  if (titleEl) {
+    titleEl.textContent = `Signed ${artifactLabel}`;
+  }
+  if (suiteMetaEl) {
+    suiteMetaEl.textContent = envelope.suite;
+  }
+  if (contextMetaEl) {
+    contextMetaEl.textContent = envelope.context;
+  }
+  if (sigSizeMetaEl) {
+    sigSizeMetaEl.textContent = `${sigBytes.byteLength} bytes (${toHex(sigBytes.slice(0, 8))}…)`;
+  }
+  if (envelopeTextarea) {
+    envelopeTextarea.value = JSON.stringify(envelope, null, 2);
+  }
+
+  // Populate the verification form right away so the user can inspect or tamper-test it
+  populateVerifierFromEnvelope(envelope);
+}
+
+function populateVerifierFromEnvelope(envelope) {
+  const typeRadios = document.querySelectorAll('input[name="verifyArtifactType"]');
+  typeRadios.forEach((radio) => {
+    radio.checked = radio.value === envelope.type;
+  });
+
+  const contextInput = document.getElementById('verify-context');
+  const payloadInput = document.getElementById('verify-payload');
+  const signatureInput = document.getElementById('verify-signature');
+  const pubKeyInput = document.getElementById('verify-public-key');
+
+  if (contextInput) contextInput.value = envelope.context;
+  if (payloadInput) payloadInput.value = envelope.payload;
+  if (signatureInput) signatureInput.value = envelope.signature;
+  if (pubKeyInput) pubKeyInput.value = envelope.publicKey;
+}
+
+async function handleSignReceipt(event) {
+  event.preventDefault();
+  const form = event.currentTarget;
+  if (!form.checkValidity()) {
+    form.reportValidity();
+    return;
+  }
+
+  if (!state.activeKeyRecord) {
+    await initOrRotateKeys();
+  }
+
+  const formData = new FormData(form);
+  const customerName = String(formData.get('customerName') || '').trim();
+  const orderId = String(formData.get('orderId') || '').trim();
+  const itemKey = String(formData.get('drinkItem') || 'maple-oat-latte');
+  const quantity = Math.max(1, parseInt(String(formData.get('quantity') || '1'), 10) || 1);
+  const roastNote = String(formData.get('roastNote') || '').trim();
+
+  const item = ITEM_CATALOG[itemKey] || ITEM_CATALOG['maple-oat-latte'];
+  const unitPrice = item.price;
+  const totalUsd = Number((unitPrice * quantity).toFixed(2));
+
+  const receiptData = {
+    documentType: 'COFFEE_ORDER_RECEIPT',
+    merchant: 'The Daily Grind Coffee Co.',
+    orderId,
+    customerName,
+    item: {
+      id: item.id,
+      name: item.name,
+      quantity,
+      unitPriceUsd: unitPrice,
+    },
+    totalUsd,
+    roastNote: roastNote || 'Standard Barista Prep',
+    issuedAt: new Date().toISOString(),
+  };
+
+  const payloadString = JSON.stringify(receiptData);
+  const contextString = DOMAIN_CONTEXTS.receipt;
+  const signatureBytes = await signPayload(
+    state.activeKeyRecord.keyPair.privateKey,
+    encodeText(payloadString),
+    encodeText(contextString),
+  );
+
+  const envelope = {
+    type: 'receipt',
+    suite: state.activeKeyRecord.suite,
+    keyFormat: state.activeKeyRecord.keyFormat,
+    context: contextString,
+    payload: payloadString,
+    signature: toBase64(signatureBytes),
+    publicKey: toBase64(state.activeKeyRecord.publicKeyBytes),
+  };
+
+  renderSignedArtifact(envelope, `Coffee Order Receipt (#${orderId})`);
+  await runVerification(envelope.publicKey, envelope.signature, envelope.payload, envelope.context);
+  announceStatus(`Signed coffee order receipt #${orderId} using ${envelope.suite}.`);
+}
+
+async function handleSignVoucher(event) {
+  event.preventDefault();
+  const form = event.currentTarget;
+  if (!form.checkValidity()) {
+    form.reportValidity();
+    return;
+  }
+
+  if (!state.activeKeyRecord) {
+    await initOrRotateKeys();
+  }
+
+  const formData = new FormData(form);
+  const recipientName = String(formData.get('recipientName') || '').trim();
+  const senderName = String(formData.get('senderName') || '').trim();
+  const voucherCode = String(formData.get('voucherCode') || '').trim();
+  const amountUsd = Number(parseFloat(String(formData.get('voucherAmount') || '25')).toFixed(2));
+  const message = String(formData.get('giftMessage') || '').trim();
+
+  const voucherData = {
+    documentType: 'GIFT_VOUCHER',
+    merchant: 'The Daily Grind Coffee Co.',
+    voucherCode,
+    recipientName,
+    senderName,
+    amountUsd,
+    currency: 'USD',
+    message: message || 'Enjoy a warm cup on me!',
+    issuedAt: new Date().toISOString(),
+  };
+
+  const payloadString = JSON.stringify(voucherData);
+  const contextString = DOMAIN_CONTEXTS.voucher;
+  const signatureBytes = await signPayload(
+    state.activeKeyRecord.keyPair.privateKey,
+    encodeText(payloadString),
+    encodeText(contextString),
+  );
+
+  const envelope = {
+    type: 'voucher',
+    suite: state.activeKeyRecord.suite,
+    keyFormat: state.activeKeyRecord.keyFormat,
+    context: contextString,
+    payload: payloadString,
+    signature: toBase64(signatureBytes),
+    publicKey: toBase64(state.activeKeyRecord.publicKeyBytes),
+  };
+
+  renderSignedArtifact(envelope, `Gift Voucher (${voucherCode})`);
+  await runVerification(envelope.publicKey, envelope.signature, envelope.payload, envelope.context);
+  announceStatus(`Signed gift voucher ${voucherCode} for $${amountUsd.toFixed(2)} using ${envelope.suite}.`);
+}
+
+async function runVerification(publicKeyB64, signatureB64, payloadStr, contextStr) {
+  const resultBanner = document.getElementById('verification-result');
+  const resultTitle = document.getElementById('verification-result-title');
+  const resultDetail = document.getElementById('verification-result-detail');
+
+  if (!resultBanner || !resultTitle || !resultDetail) return false;
+  resultBanner.hidden = false;
+
+  try {
+    const publicKeyBytes = fromBase64(publicKeyB64);
+    const signatureBytes = fromBase64(signatureB64);
+    const payloadBytes = encodeText(payloadStr);
+    const contextBytes = encodeText(contextStr);
+
+    const isValid = await verifyPayload(
+      publicKeyBytes,
+      signatureBytes,
+      payloadBytes,
+      contextBytes,
+    );
+
+    if (isValid) {
+      let parsedSummary = '';
+      try {
+        const parsed = JSON.parse(payloadStr);
+        if (parsed.documentType === 'COFFEE_ORDER_RECEIPT') {
+          parsedSummary = `Authentic Order #${parsed.orderId} for ${parsed.customerName} ($${Number(parsed.totalUsd).toFixed(2)})`;
+        } else if (parsed.documentType === 'GIFT_VOUCHER') {
+          parsedSummary = `Authentic Gift Voucher ${parsed.voucherCode} for ${parsed.recipientName} ($${Number(parsed.amountUsd).toFixed(2)})`;
+        }
+      } catch {
+        parsedSummary = 'Payload integrity confirmed.';
+      }
+
+      resultBanner.className = 'verification-banner valid';
+      resultTitle.textContent = 'Signature Verified — Authentic & Untampered';
+      resultDetail.textContent = `${parsedSummary} — Verified with context "${contextStr}" (${publicKeyBytes.byteLength}-byte public key, ${signatureBytes.byteLength}-byte signature).`;
+      announceStatus(`Verification succeeded: ${resultTitle.textContent}`);
+      return true;
+    } else {
+      resultBanner.className = 'verification-banner invalid';
+      resultTitle.textContent = 'Verification Failed — Invalid Signature or Tampered Artifact';
+      resultDetail.textContent =
+        'The cryptographic signature does not match the payload, public key, or domain-separation context. Reject this receipt or voucher.';
+      announceStatus(`Verification failed: ${resultTitle.textContent}`);
+      return false;
+    }
+  } catch (err) {
+    resultBanner.className = 'verification-banner invalid';
+    resultTitle.textContent = 'Verification Error — Malformed Key, Signature, or Context';
+    resultDetail.textContent = err instanceof Error ? err.message : String(err);
+    announceStatus(`Verification error: ${resultTitle.textContent}`);
+    return false;
+  }
+}
+
+async function handleVerifyForm(event) {
+  event.preventDefault();
+  const form = event.currentTarget;
+  if (!form.checkValidity()) {
+    form.reportValidity();
+    return;
+  }
+
+  const contextStr = document.getElementById('verify-context').value.trim();
+  const payloadStr = document.getElementById('verify-payload').value;
+  const signatureB64 = document.getElementById('verify-signature').value.trim();
+  const publicKeyB64 = document.getElementById('verify-public-key').value.trim();
+
+  await runVerification(publicKeyB64, signatureB64, payloadStr, contextStr);
+}
+
+function setupQuickOrderButtons() {
+  const buttons = document.querySelectorAll('[data-order-item]');
+  buttons.forEach((btn) => {
+    btn.addEventListener('click', () => {
+      const itemId = btn.getAttribute('data-order-item');
+      const select = document.getElementById('receipt-drink-item');
+      if (select && itemId) {
+        select.value = itemId;
+      }
+      const section = document.getElementById('crypto-portal');
+      if (section) {
+        section.scrollIntoView({ behavior: 'smooth' });
+      }
+      const customerInput = document.getElementById('receipt-customer-name');
+      if (customerInput) {
+        customerInput.focus();
+      }
+    });
+  });
+}
+
+function setupTamperAndReplayDemos() {
+  const tamperPayloadBtn = document.getElementById('btn-tamper-payload');
+  if (tamperPayloadBtn) {
+    tamperPayloadBtn.addEventListener('click', async () => {
+      const payloadInput = document.getElementById('verify-payload');
+      if (!payloadInput || !payloadInput.value) return;
+      try {
+        const obj = JSON.parse(payloadInput.value);
+        if (typeof obj.totalUsd === 'number') {
+          obj.totalUsd = 0.01;
+        } else if (typeof obj.amountUsd === 'number') {
+          obj.amountUsd = 999.99;
+        } else {
+          obj.tampered = true;
+        }
+        payloadInput.value = JSON.stringify(obj);
+      } catch {
+        payloadInput.value = payloadInput.value + ' [TAMPERED]';
+      }
+      await runVerification(
+        document.getElementById('verify-public-key').value.trim(),
+        document.getElementById('verify-signature').value.trim(),
+        payloadInput.value,
+        document.getElementById('verify-context').value.trim(),
+      );
+    });
+  }
+
+  const swapContextBtn = document.getElementById('btn-swap-context');
+  if (swapContextBtn) {
+    swapContextBtn.addEventListener('click', async () => {
+      const contextInput = document.getElementById('verify-context');
+      if (!contextInput) return;
+      const current = contextInput.value.trim();
+      contextInput.value =
+        current === DOMAIN_CONTEXTS.receipt
+          ? DOMAIN_CONTEXTS.voucher
+          : DOMAIN_CONTEXTS.receipt;
+      await runVerification(
+        document.getElementById('verify-public-key').value.trim(),
+        document.getElementById('verify-signature').value.trim(),
+        document.getElementById('verify-payload').value,
+        contextInput.value,
+      );
+    });
+  }
+
+  const restoreValidBtn = document.getElementById('btn-restore-valid');
+  if (restoreValidBtn) {
+    restoreValidBtn.addEventListener('click', async () => {
+      if (!state.latestEnvelope) return;
+      populateVerifierFromEnvelope(state.latestEnvelope);
+      await runVerification(
+        state.latestEnvelope.publicKey,
+        state.latestEnvelope.signature,
+        state.latestEnvelope.payload,
+        state.latestEnvelope.context,
+      );
+    });
+  }
+}
+
+function setupVerifierTypeSync() {
+  const typeRadios = document.querySelectorAll('input[name="verifyArtifactType"]');
+  typeRadios.forEach((radio) => {
+    radio.addEventListener('change', () => {
+      const contextInput = document.getElementById('verify-context');
+      if (contextInput && radio.checked) {
+        contextInput.value =
+          radio.value === 'voucher'
+            ? DOMAIN_CONTEXTS.voucher
+            : DOMAIN_CONTEXTS.receipt;
+      }
+    });
+  });
+
+  const loadEnvelopeBtn = document.getElementById('btn-load-envelope');
+  if (loadEnvelopeBtn) {
+    loadEnvelopeBtn.addEventListener('click', async () => {
+      const envelopeTextarea = document.getElementById('signed-envelope-json');
+      if (!envelopeTextarea || !envelopeTextarea.value.trim()) return;
+      try {
+        const parsed = JSON.parse(envelopeTextarea.value);
+        if (parsed.payload && parsed.signature && parsed.publicKey && parsed.context) {
+          populateVerifierFromEnvelope(parsed);
+          await runVerification(
+            parsed.publicKey,
+            parsed.signature,
+            parsed.payload,
+            parsed.context,
+          );
+        }
+      } catch (err) {
+        announceStatus('Invalid JSON in signed envelope box.');
+      }
+    });
+  }
+
+  const copyEnvelopeBtn = document.getElementById('btn-copy-envelope');
+  if (copyEnvelopeBtn) {
+    copyEnvelopeBtn.addEventListener('click', async () => {
+      const envelopeTextarea = document.getElementById('signed-envelope-json');
+      if (!envelopeTextarea || !envelopeTextarea.value) return;
+      if (navigator.clipboard?.writeText) {
+        await navigator.clipboard.writeText(envelopeTextarea.value);
+        announceStatus('Copied signed artifact JSON envelope to clipboard.');
+      }
+    });
+  }
+}
+
+document.addEventListener('DOMContentLoaded', async () => {
+  setupQuickOrderButtons();
+  setupTamperAndReplayDemos();
+  setupVerifierTypeSync();
+
+  const suiteRadios = document.querySelectorAll('input[name="cryptoSuite"]');
+  suiteRadios.forEach((radio) => {
+    radio.addEventListener('change', async () => {
+      if (radio.checked) {
+        await initOrRotateKeys(radio.value);
+      }
+    });
+  });
+
+  const rotateBtn = document.getElementById('btn-rotate-keys');
+  if (rotateBtn) {
+    rotateBtn.addEventListener('click', async () => {
+      const selected = document.querySelector('input[name="cryptoSuite"]:checked');
+      await initOrRotateKeys(selected ? selected.value : 'ML-DSA-65');
+    });
+  }
+
+  const receiptForm = document.getElementById('receipt-sign-form');
+  if (receiptForm) {
+    receiptForm.addEventListener('submit', handleSignReceipt);
+  }
+
+  const voucherForm = document.getElementById('voucher-sign-form');
+  if (voucherForm) {
+    voucherForm.addEventListener('submit', handleSignVoucher);
+  }
+
+  const verifyForm = document.getElementById('artifact-verify-form');
+  if (verifyForm) {
+    verifyForm.addEventListener('submit', handleVerifyForm);
+  }
+
+  // Initialize default key pair and create an initial signed receipt so the page is immediately interactive
+  await initOrRotateKeys('ML-DSA-65');
+  if (receiptForm) {
+    receiptForm.requestSubmit();
+  }
+});
diff --git a/crypto-signing.js b/crypto-signing.js
