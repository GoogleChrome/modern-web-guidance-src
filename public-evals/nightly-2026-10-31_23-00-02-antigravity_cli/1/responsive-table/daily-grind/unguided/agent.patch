+    /* Nutritional & Pricing Table */
+    .table-wrapper {
+      margin-top: 40px;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      padding: 24px;
+    }
+
+    .table-scroll {
+      overflow-x: auto;
+      -webkit-overflow-scrolling: touch;
+    }
+
+    .table-scroll:focus {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .nutrition-table {
+      width: 100%;
+      border-collapse: collapse;
+      text-align: left;
+      min-width: 560px;
+      border: 1px solid var(--secondary);
+    }
+
+    .nutrition-table caption {
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      margin-bottom: 14px;
+      text-align: left;
+      caption-side: top;
+    }
+
+    .nutrition-table th,
+    .nutrition-table td {
+      padding: 12px 16px;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .nutrition-table thead th {
+      background-color: var(--primary);
+      color: white;
+      font-weight: 600;
+      white-space: nowrap;
+    }
+
+    .nutrition-table thead th:first-child {
+      position: sticky;
+      left: 0;
+      z-index: 2;
+    }
+
+    .nutrition-table tbody th[scope="row"] {
+      background-color: #f5f0ee;
+      color: var(--primary);
+      font-weight: 600;
+      position: sticky;
+      left: 0;
+      z-index: 1;
+      border-right: 1px solid var(--secondary);
+      white-space: nowrap;
+    }
+
+    .nutrition-table tbody tr:nth-child(even) td {
+      background-color: #fcfaf9;
+    }
+
+    .nutrition-table tbody tr:hover td,
+    .nutrition-table tbody tr:hover th[scope="row"] {
+      background-color: #efebe9;
+    }
+
+    .nutrition-table tbody tr:last-child th,
+    .nutrition-table tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    .table-note {
+      font-size: 0.85rem;
+      color: var(--text);
+      margin-top: 10px;
+    }
+
+    @media (max-width: 600px) {
+      .table-wrapper {
+        padding: 16px;
+      }
+
+      .nutrition-table caption {
+        font-size: 1.1rem;
+      }
+
+      .nutrition-table th,
+      .nutrition-table td {
+        padding: 10px 12px;
+        font-size: 0.9rem;
+      }
+    }
+
