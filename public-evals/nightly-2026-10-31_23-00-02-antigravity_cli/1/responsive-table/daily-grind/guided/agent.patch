+    /* Nutritional & Pricing Table */
+    .table-wrapper {
+      overflow: auto;
+      max-inline-size: 100%;
+      max-block-size: min(500px, 80vh);
+      container-type: inline-size;
+      margin-top: 2rem;
+      background: white;
+      border-radius: 8px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+    }
+
+    .table-wrapper:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    table {
+      width: 100%;
+      border-collapse: separate;
+      border-spacing: 0;
+      text-align: left;
+    }
+
+    caption {
+      font-size: 1.25rem;
+      font-weight: bold;
+      color: var(--primary);
+      padding: 1rem;
+      text-align: left;
+      background: white;
+      border-bottom: 2px solid var(--secondary);
+    }
+
+    th,
+    td {
+      padding: 0.85rem 1rem;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    thead {
+      position: sticky;
+      inset-block-start: 0;
+      z-index: 1;
+    }
+
+    thead th {
+      background: var(--primary);
+      color: white;
+      font-weight: 600;
+      white-space: nowrap;
+    }
+
+    tbody th {
+      position: sticky;
+      inset-inline-start: 0;
+      background: white;
+      color: var(--primary);
+      font-weight: 600;
+      white-space: nowrap;
+      border-right: 1px solid var(--secondary);
+    }
+
+    tbody tr:last-child th,
+    tbody tr:last-child td {
+      border-bottom: none;
+    }
+
+    @container (width < 600px) {
+      table,
+      thead,
+      tbody,
+      tr,
+      th,
+      td {
+        display: block;
+      }
+
+      thead {
+        /* Hide column header from layout and screen readers in stacked mode */
+        display: none;
+      }
+
+      tr {
+        margin-block-end: 1.5rem;
+        border: 1px solid var(--secondary);
+        border-radius: 6px;
+        overflow: hidden;
+      }
+
+      tbody tr:last-child {
+        margin-block-end: 0;
+      }
+
+      tbody th {
+        position: sticky;
+        inset-block-start: 0;
+        z-index: 2;
+        background: var(--secondary);
+        color: var(--text);
+        border-right: none;
+      }
+
+      table {
+        --label-1: "Drink";
+        --label-2: "Serving Size";
+        --label-3: "Price";
+        --label-4: "Calories";
+        --label-5: "Caffeine";
+        --label-6: "Sugar";
+      }
+
+      td {
+        display: flex;
+        justify-content: space-between;
+        align-items: center;
+        gap: 1rem;
+      }
+
+      td::before {
+        font-weight: 600;
+        color: var(--primary);
+      }
+
+      td:nth-child(2)::before {
+        content: var(--label-2) ": ";
+      }
+
+      td:nth-child(3)::before {
+        content: var(--label-3) ": ";
+      }
+
+      td:nth-child(4)::before {
+        content: var(--label-4) ": ";
+      }
+
+      td:nth-child(5)::before {
+        content: var(--label-5) ": ";
+      }
+
+      td:nth-child(6)::before {
+        content: var(--label-6) ": ";
+      }
+    }
