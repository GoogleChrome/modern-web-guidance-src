+  <script type="module">
+    const favoriteToggleTemplate = document.createElement('template');
+    favoriteToggleTemplate.innerHTML = `
+      <span class="control" part="control">
+        <svg class="icon" part="icon" viewBox="0 0 24 24" aria-hidden="true">
+          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
+        </svg>
+        <span class="label" part="label"><slot>Favorite</slot></span>
+      </span>
+    `;
+
+    const favoriteToggleSheet = new CSSStyleSheet();
+    favoriteToggleSheet.replaceSync(`
+      @layer base, state;
+
+      @layer base {
+        :host {
+          --_active-color: var(--favorite-active-color, #ffab40);
+          --_inactive-color: var(--favorite-inactive-color, #8d6e63);
+          --_bg: var(--favorite-bg, #ffffff);
+          --_active-bg: var(--favorite-active-bg, #fff8e1);
+          --_border-color: var(--favorite-border-color, #d7ccc8);
+          --_text-color: var(--favorite-text-color, #4e342e);
+          display: inline-block;
+          cursor: pointer;
+          user-select: none;
+          vertical-align: middle;
+          border-radius: 999px;
+        }
+
+        :host([disabled]) {
+          opacity: 0.5;
+          pointer-events: none;
+          cursor: not-allowed;
+        }
+
+        :host(:focus-visible) {
+          outline: 2px solid var(--_active-color);
+          outline-offset: 2px;
+        }
+
+        .control {
+          display: inline-flex;
+          align-items: center;
+          gap: 6px;
+          padding: 5px 12px;
+          border-radius: 999px;
+          border: 1.5px solid var(--_border-color);
+          background: var(--_bg);
+          color: var(--_text-color);
+          font: inherit;
+          font-size: 0.85rem;
+          font-weight: 600;
+          line-height: 1.2;
+          transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
+        }
+
+        :host(:hover) .control {
+          border-color: var(--_active-color);
+        }
+
+        :host(:active) .control {
+          transform: scale(0.96);
+        }
+
+        .icon {
+          width: 16px;
+          height: 16px;
+          fill: transparent;
+          stroke: var(--_inactive-color);
+          stroke-width: 2;
+          transition: fill 0.2s ease, stroke 0.2s ease, transform 0.2s ease;
+          flex-shrink: 0;
+        }
+      }
+
+      @layer state {
+        :host(:state(favorited)) .control,
+        :host([checked]) .control {
+          background: var(--_active-bg);
+          border-color: var(--_active-color);
+        }
+
+        :host(:state(favorited)) .icon,
+        :host([checked]) .icon {
+          fill: var(--_active-color);
+          stroke: var(--_active-color);
+          transform: scale(1.1);
+        }
+      }
+    `);
+
+    class FavoriteToggle extends HTMLElement {
+      static observedAttributes = ['checked', 'disabled', 'label'];
+
+      #internals;
+      #checked = false;
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [favoriteToggleSheet];
+        this.shadowRoot.append(favoriteToggleTemplate.content.cloneNode(true));
+
+        this.#internals = this.attachInternals();
+        if ('role' in this.#internals) {
+          this.#internals.role = 'switch';
+          this.#internals.ariaChecked = 'false';
+        } else {
+          this.setAttribute('role', 'switch');
+          this.setAttribute('aria-checked', 'false');
+        }
+
+        this.addEventListener('click', this.#onClick);
+        this.addEventListener('keydown', this.#onKeyDown);
+      }
+
+      connectedCallback() {
+        if (!this.hasAttribute('tabindex')) {
+          this.tabIndex = 0;
+        }
+        this.#syncState(this.hasAttribute('checked'));
+        this.#syncLabel();
+        this.#syncDisabled();
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'checked') {
+          this.#syncState(newVal !== null);
+        } else if (name === 'label') {
+          this.#syncLabel();
+        } else if (name === 'disabled') {
+          this.#syncDisabled();
+        }
+      }
+
+      get checked() {
+        return this.#checked;
+      }
+
+      set checked(value) {
+        const isChecked = Boolean(value);
+        if (this.#checked === isChecked && this.hasAttribute('checked') === isChecked) return;
+        this.toggleAttribute('checked', isChecked);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(value) {
+        this.toggleAttribute('disabled', Boolean(value));
+      }
+
+      get label() {
+        return this.getAttribute('label') ?? '';
+      }
+
+      set label(value) {
+        if (value) {
+          this.setAttribute('label', String(value));
+        } else {
+          this.removeAttribute('label');
+        }
+      }
+
+      toggle(force) {
+        if (this.disabled) return this.#checked;
+        const next = force !== undefined ? Boolean(force) : !this.#checked;
+        this.checked = next;
+        this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+        return this.#checked;
+      }
+
+      #syncState(isChecked) {
+        this.#checked = isChecked;
+        const checkedStr = String(isChecked);
+        if ('ariaChecked' in this.#internals) {
+          this.#internals.ariaChecked = checkedStr;
+        } else {
+          this.setAttribute('aria-checked', checkedStr);
+        }
+
+        if (this.#internals.states) {
+          if (isChecked) {
+            this.#internals.states.add('favorited');
+          } else {
+            this.#internals.states.delete('favorited');
+          }
+        }
+      }
+
+      #syncLabel() {
+        const lbl = this.label;
+        if ('ariaLabel' in this.#internals) {
+          this.#internals.ariaLabel = lbl || 'Mark as favorite';
+        } else if (lbl && !this.hasAttribute('aria-label')) {
+          this.setAttribute('aria-label', lbl);
+        }
+      }
+
+      #syncDisabled() {
+        const isDisabled = String(this.disabled);
+        if ('ariaDisabled' in this.#internals) {
+          this.#internals.ariaDisabled = isDisabled;
+        } else {
+          this.setAttribute('aria-disabled', isDisabled);
+        }
+      }
+
+      #onClick = () => {
+        this.toggle();
+      };
+
+      #onKeyDown = (e) => {
+        if (e.key === ' ' || e.key === 'Enter') {
+          e.preventDefault();
+          this.toggle();
+        }
+      };
+    }
+
+    customElements.define('favorite-toggle', FavoriteToggle);
+  </script>
