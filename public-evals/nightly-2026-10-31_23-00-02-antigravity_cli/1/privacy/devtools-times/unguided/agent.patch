+            >
+              Customize
+            </button>
+            <button
+              type="button"
+              id="privacy-accept-optional-btn"
+              data-skip-tracking="true"
+              class="px-3 py-2 text-xs font-semibold text-gray-900 bg-gray-100 border border-gray-300 rounded hover:bg-gray-200 cursor-pointer"
+            >
+              Allow Analytics
+            </button>
+          </div>
+        </div>
+
+        <div id="privacy-custom-controls" class="hidden border-t border-gray-200 pt-4 text-xs text-gray-700 space-y-3">
+          <div class="flex items-start space-x-2">
+            <input
+              type="checkbox"
+              id="consent-essential"
+              checked
+              disabled
+              data-skip-tracking="true"
+              class="mt-0.5 h-4 w-4 border-gray-300 rounded"
+            />
+            <label htmlFor="consent-essential">
+              <span class="font-semibold text-gray-900">Strictly Necessary (Always Active):</span> Required for core site navigation, security headers, and saving articles to your reading list when requested.
+            </label>
+          </div>
+
+          <div class="flex items-start space-x-2">
+            <input
+              type="checkbox"
+              id="consent-analytics"
+              data-skip-tracking="true"
+              class="mt-0.5 h-4 w-4 border-gray-300 rounded"
+            />
+            <label htmlFor="consent-analytics">
+              <span class="font-semibold text-gray-900">Third-Party Interaction Analytics (Opt-In):</span> Loads <code>analytics-client.js</code> from <code>cloudfunctions.net</code> to measure link and button interactions (excluding authentication and privacy controls).
+            </label>
+          </div>
+
+          <div class="flex items-start space-x-2">
+            <input
+              type="checkbox"
+              id="consent-ads"
+              data-skip-tracking="true"
+              class="mt-0.5 h-4 w-4 border-gray-300 rounded"
+            />
+            <label htmlFor="consent-ads">
+              <span class="font-semibold text-gray-900">Third-Party Ad Slots (Opt-In):</span> Allows page ad slot placeholders to register with <code>window.adNetwork</code>.
+            </label>
+          </div>
+
+          <div class="flex justify-end pt-2">
+            <button
+              type="button"
+              id="privacy-save-custom-btn"
+              data-skip-tracking="true"
+              class="px-3 py-1.5 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800 cursor-pointer"
+            >
+              Save Preferences
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+
+    <script is:inline>
+      (function () {
+        var STORAGE_KEY = 'devtools-times-privacy-consent';
+        var ANALYTICS_SRC = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+        function isPrivacySignalActive() {
+          return Boolean(
+            navigator.globalPrivacyControl === true ||
+            navigator.doNotTrack === '1' ||
+            window.doNotTrack === '1'
+          );
+        }
+
+        function getStoredConsent() {
+          try {
+            var raw = window.localStorage.getItem(STORAGE_KEY);
+            if (!raw) return null;
+            return JSON.parse(raw);
+          } catch (e) {
+            return null;
+          }
+        }
+
+        function saveConsent(prefs) {
+          var payload = {
+            essential: true,
+            analytics: Boolean(prefs.analytics) && !isPrivacySignalActive(),
+            ads: Boolean(prefs.ads) && !isPrivacySignalActive(),
+            updatedAt: new Date().toISOString()
+          };
+          try {
+            window.localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
+          } catch (e) {}
+          applyConsent(payload);
+          window.dispatchEvent(new CustomEvent('privacy-consent-updated', { detail: payload }));
+        }
+
+        function applyConsent(consent) {
+          if (!consent || !consent.analytics || isPrivacySignalActive()) {
+            return;
+          }
+          if (document.querySelector('script[data-privacy-script="analytics"]')) {
+            return;
+          }
+          var script = document.createElement('script');
+          script.src = ANALYTICS_SRC;
+          script.defer = true;
+          script.crossOrigin = 'anonymous';
+          script.referrerPolicy = 'no-referrer';
+          script.setAttribute('data-privacy-script', 'analytics');
+          document.head.appendChild(script);
+        }
+
+        function setupPrivacyUI() {
+          var banner = document.getElementById('privacy-consent-banner');
+          var customControls = document.getElementById('privacy-custom-controls');
+          var gpcNotice = document.getElementById('privacy-gpc-notice');
+          var analyticsCheckbox = document.getElementById('consent-analytics');
+          var adsCheckbox = document.getElementById('consent-ads');
+          var essentialBtn = document.getElementById('privacy-essential-only-btn');
+          var customizeBtn = document.getElementById('privacy-customize-btn');
+          var acceptBtn = document.getElementById('privacy-accept-optional-btn');
+          var saveCustomBtn = document.getElementById('privacy-save-custom-btn');
+
+          if (!banner) return;
+
+          var gpcActive = isPrivacySignalActive();
+          if (gpcActive && gpcNotice) {
+            gpcNotice.classList.remove('hidden');
+          }
+
+          var stored = getStoredConsent();
+          if (stored) {
+            applyConsent(stored);
+            banner.classList.add('hidden');
+          } else if (gpcActive) {
+            saveConsent({ analytics: false, ads: false });
+            banner.classList.add('hidden');
+          } else {
+            banner.classList.remove('hidden');
+          }
+
+          function syncCheckboxes() {
+            var current = getStoredConsent() || { analytics: false, ads: false };
+            if (analyticsCheckbox) {
+              analyticsCheckbox.checked = Boolean(current.analytics) && !gpcActive;
+              analyticsCheckbox.disabled = gpcActive;
+            }
+            if (adsCheckbox) {
+              adsCheckbox.checked = Boolean(current.ads) && !gpcActive;
+              adsCheckbox.disabled = gpcActive;
+            }
+          }
+
+          syncCheckboxes();
+
+          if (essentialBtn && !essentialBtn.dataset.bound) {
+            essentialBtn.dataset.bound = 'true';
+            essentialBtn.addEventListener('click', function () {
+              saveConsent({ analytics: false, ads: false });
+              banner.classList.add('hidden');
+            });
+          }
+
+          if (customizeBtn && !customizeBtn.dataset.bound) {
+            customizeBtn.dataset.bound = 'true';
+            customizeBtn.addEventListener('click', function () {
+              syncCheckboxes();
+              if (customControls) {
+                customControls.classList.toggle('hidden');
+              }
+            });
+          }
+
+          if (acceptBtn && !acceptBtn.dataset.bound) {
+            acceptBtn.dataset.bound = 'true';
+            acceptBtn.addEventListener('click', function () {
+              saveConsent({ analytics: true, ads: false });
+              banner.classList.add('hidden');
+            });
+          }
+
+          if (saveCustomBtn && !saveCustomBtn.dataset.bound) {
+            saveCustomBtn.dataset.bound = 'true';
+            saveCustomBtn.addEventListener('click', function () {
+              saveConsent({
+                analytics: analyticsCheckbox ? analyticsCheckbox.checked : false,
+                ads: adsCheckbox ? adsCheckbox.checked : false
+              });
+              banner.classList.add('hidden');
+            });
+          }
+
+          var openTriggers = document.querySelectorAll('[data-open-privacy-preferences]');
+          openTriggers.forEach(function (btn) {
+            if (btn.dataset.bound) return;
+            btn.dataset.bound = 'true';
+            btn.addEventListener('click', function (e) {
+              e.preventDefault();
+              syncCheckboxes();
+              banner.classList.remove('hidden');
+              if (customControls) {
+                customControls.classList.remove('hidden');
+              }
+            });
+          });
+        }
+
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', setupPrivacyUI);
+        } else {
+          setupPrivacyUI();
+        }
+        document.addEventListener('astro:page-load', setupPrivacyUI);
+      })();
+    </script>
   </body>
 </html>
