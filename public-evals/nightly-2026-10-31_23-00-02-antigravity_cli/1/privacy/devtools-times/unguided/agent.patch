 import { defineMiddleware } from 'astro:middleware';
 
+const PRIVACY_AND_SECURITY_HEADERS: Record<string, string> = {
+  // Minimize referrer leakage across origins
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  // Opt out of ad-tech tracking APIs (Topics API / FLoC) and disable unused device sensors/APIs
+  'Permissions-Policy':
+    'accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()',
+  // Restrict resource loading and data exfiltration vectors
+  'Content-Security-Policy': [
+    "default-src 'self'",
+    "script-src 'self' 'unsafe-inline' https://us-central1-web-devrel-apps.cloudfunctions.net",
+    "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
+    "font-src 'self' https://fonts.gstatic.com",
+    "img-src 'self' data: https:",
+    "connect-src 'self' https://us-central1-web-devrel-apps.cloudfunctions.net",
+    "frame-ancestors 'none'",
+    "base-uri 'self'",
+    "form-action 'self'",
+  ].join('; '),
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Strict-Transport-Security': 'max-age=31536000; includeSubDomains',
+  'X-DNS-Prefetch-Control': 'off',
+};
+
 export const onRequest = defineMiddleware(async (context, next) => {
-  if (context.session) {
-    // Initialize the reading list if it doesn't exist
-    const readingList = await context.session.get('readingList');
-    if (readingList === undefined) {
-      await context.session.set('readingList', []);
+  // Data Minimization & Privacy by Design:
+  // Do NOT eagerly initialize `context.session.set('readingList', [])` on every request.
+  // Sessions are only created lazily when a user explicitly saves an article to their reading list.
+  const response = await next();
+
+  const headers = new Headers(response.headers);
+  for (const [headerName, headerValue] of Object.entries(PRIVACY_AND_SECURITY_HEADERS)) {
+    if (!headers.has(headerName)) {
+      headers.set(headerName, headerValue);
     }
   }
-  return next();
+
+  // Remove server fingerprinting headers if present
+  headers.delete('X-Powered-By');
+
+  // Prevent caching of authentication pages and user-specific reading list responses
+  const pathname = context.url.pathname;
+  if (
+    pathname.endsWith('/signin') ||
+    pathname.endsWith('/signin/') ||
+    pathname.endsWith('/signup') ||
+    pathname.endsWith('/signup/') ||
+    pathname.includes('/api/reading-list')
+  ) {
+    headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, private');
+    headers.set('Pragma', 'no-cache');
+  }
+
+  return new Response(response.body, {
+    status: response.status,
+    statusText: response.statusText,
+    headers,
+  });
 });
