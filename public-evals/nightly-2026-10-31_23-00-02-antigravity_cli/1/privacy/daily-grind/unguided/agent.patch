+        const orderForm = document.getElementById('minimized-order-form');
+        if (orderForm) {
+          orderForm.addEventListener('submit', function (event) {
+            event.preventDefault();
+            const rawAlias = aliasInput ? aliasInput.value : '';
+            const sanitizedAlias = redactPII(rawAlias) || 'Guest-' + Math.floor(100 + Math.random() * 900);
+            if (aliasInput) aliasInput.value = sanitizedAlias;
+
+            const chosenStore = storeSelect && ALLOWED_STORES.indexOf(storeSelect.value) !== -1
+              ? storeSelect.value
+              : 'downtown';
+            const chosenDrink = drinkSelect && ALLOWED_DRINKS.indexOf(drinkSelect.value) !== -1
+              ? drinkSelect.value
+              : 'Maple Oat Latte';
+
+            const token = generateAnonymousToken();
+            const keepInSession = Boolean(
+              document.getElementById('ephemeral-receipt-consent') &&
+              document.getElementById('ephemeral-receipt-consent').checked
+            );
+
+            const orderPayload = {
+              token: token,
+              alias: sanitizedAlias,
+              store: chosenStore,
+              drink: chosenDrink
+            };
+
+            if (keepInSession) {
+              writeEnvelope(window.sessionStorage, SESSION_ORDER_KEY, orderPayload, ORDER_TTL_MS);
+              renderOrderStatus();
+            } else {
+              try { window.sessionStorage.removeItem(SESSION_ORDER_KEY); } catch (_) {}
+              const statusBox = document.getElementById('order-status-box');
+              if (statusBox) {
+                statusBox.textContent =
+                  'One-Time Pickup Token: ' + token +
+                  ' | Alias: ' + sanitizedAlias +
+                  ' | Beverage: ' + chosenDrink +
+                  ' (Not saved to browser storage)';
+              }
+            }
+
+            if (consentState.functionalStorage) {
+              writeEnvelope(window.localStorage, STORE_PREF_KEY, chosenStore, PREF_TTL_MS);
+            }
+            updateInspectorView();
+          });
+        }
+
+        // Purge Order Memory Button
+        const clearOrderBtn = document.getElementById('clear-order-btn');
+        if (clearOrderBtn) {
+          clearOrderBtn.addEventListener('click', function () {
+            try { window.sessionStorage.removeItem(SESSION_ORDER_KEY); } catch (_) {}
+            renderOrderStatus();
+            updateInspectorView();
+          });
+        }
+
+        // Inspect, Export, and Erase Buttons
+        const inspectBtn = document.getElementById('inspect-data-btn');
+        if (inspectBtn) {
+          inspectBtn.addEventListener('click', updateInspectorView);
+        }
+
+        const exportBtn = document.getElementById('export-data-btn');
+        if (exportBtn) {
+          exportBtn.addEventListener('click', function () {
+            const snapshot = getStorageSnapshot();
+            const blob = new Blob([JSON.stringify(snapshot, null, 2)], { type: 'application/json' });
+            const blobUrl = URL.createObjectURL(blob);
+            const a = document.createElement('a');
+            a.href = blobUrl;
+            a.download = 'daily-grind-privacy-export.json';
+            document.body.appendChild(a);
+            a.click();
+            document.body.removeChild(a);
+            setTimeout(function () { URL.revokeObjectURL(blobUrl); }, 1000);
+          });
+        }
+
+        const eraseBtn = document.getElementById('erase-all-data-btn');
+        if (eraseBtn) {
+          eraseBtn.addEventListener('click', function () {
+            eraseAllUserData('All local and session data has been cryptographically purged.');
+          });
+        }
+
+        // POST Logout Form Handler (prevents GET prefetch logout & clears session state)
+        const logoutForm = document.getElementById('logout-form');
+        if (logoutForm) {
+          logoutForm.addEventListener('submit', function (event) {
+            event.preventDefault();
+            eraseAllUserData('Session terminated via POST logout. All volatile and local storage cleared.');
+          });
+        }
+
+        // Audit Controls
+        const runAuditBtn = document.getElementById('run-audit-btn');
+        if (runAuditBtn) {
+          runAuditBtn.addEventListener('click', function () {
+            sweepExpiredAndForeignStorage();
+            renderAuditTable();
+            updateInspectorView();
+          });
+        }
+
+        const testEgressBtn = document.getElementById('test-egress-guard-btn');
+        if (testEgressBtn) {
+          testEgressBtn.addEventListener('click', function () {
+            // Simulate an unauthorized third-party analytics script attempting to phone home
+            window.fetch('https://tracker.example.com/collect?user=test').catch(function () {
+              updateInspectorView();
+            });
+          });
+        }
+
+        // Periodic TTL Sweep every 15 seconds & cleanup on pagehide
+        setInterval(function () {
+          sweepExpiredAndForeignStorage();
+          renderOrderStatus();
+        }, 15000);
+
+        window.addEventListener('pagehide', function () {
+          sweepExpiredAndForeignStorage();
+        });
+
+        applyMediaConsentUI();
+        renderOrderStatus();
+        renderAuditTable();
+        updateInspectorView();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+      } else {
+        init();
+      }
+    })();
+  </script>
 </body>
 
