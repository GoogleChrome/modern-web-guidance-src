+// Privacy by Design & Security Headers configuration for The Daily Grind
+// Applies defensive HTTP headers, Connection-Allowlist, Fetch Metadata isolation,
+// secure cookie helpers (__Host- and CHIPS Partitioned), and Clear-Site-Data on /logout.
+
+export const SECURITY_HEADERS = {
+  'Referrer-Policy': 'strict-origin-when-cross-origin',
+  'Permissions-Policy':
+    'geolocation=(), camera=(), microphone=(), accelerometer=(), focus-without-user-activation=()',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Strict-Transport-Security': 'max-age=31536000; includeSubDomains; preload',
+  'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Reporting-Endpoints': 'main-endpoint="https://reports.dailygrind.example/main"',
+  'Connection-Allowlist':
+    '(response-origin "https://images.unsplash.com/*" "https://www.youtube-nocookie.com/*" "https://x.com/intent/*" "https://bsky.app/intent/*"); report-to=main-endpoint'
+};
+
+export function buildContentSecurityPolicy(nonce) {
+  const scriptSource = nonce ? `'nonce-${nonce}' 'strict-dynamic'` : `'self'`;
+  return [
+    "default-src 'self'",
+    `script-src ${scriptSource} 'report-sample'`,
+    "style-src 'self' 'unsafe-inline'",
+    "img-src 'self' https://images.unsplash.com https://img.youtube.com data:",
+    'frame-src https://www.youtube-nocookie.com',
+    "connect-src 'self'",
+    "form-action 'self'",
+    "worker-src 'self'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'none'",
+    "require-trusted-types-for 'script'",
+    'report-to main-endpoint'
+  ].join('; ');
+}
+
+export function createSecureSessionCookie(sessionId) {
+  return `__Host-session_id=${encodeURIComponent(sessionId)}; SameSite=Lax; HttpOnly; Secure; Path=/`;
+}
+
+export function createPartitionedEmbedCookie(name, value) {
+  return `${encodeURIComponent(name)}=${encodeURIComponent(value)}; SameSite=None; Secure; Path=/; Partitioned; HttpOnly`;
+}
+
+export function applyPrivacyAndSecurityHeaders(req, res, next) {
+  const setHeader = (name, value) =>
+    typeof res.setHeader === 'function' ? res.setHeader(name, value) : res.headers?.set(name, value);
+
+  // Vary on Fetch Metadata headers to prevent cache poisoning
+  setHeader('Vary', 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site');
+
