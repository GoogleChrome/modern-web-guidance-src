+  <script>
+    document.querySelectorAll('.hovercard-wrapper').forEach((wrapper) => {
+      const trigger = wrapper.querySelector('.hovercard-trigger');
+      const card = wrapper.querySelector('.hovercard');
+      let hideTimeout;
+
+      const openCard = () => {
+        clearTimeout(hideTimeout);
+        card.classList.add('is-active');
+        if (trigger) trigger.setAttribute('aria-expanded', 'true');
+      };
+
+      const closeCard = () => {
+        hideTimeout = setTimeout(() => {
+          card.classList.remove('is-active');
+          if (trigger) trigger.setAttribute('aria-expanded', 'false');
+        }, 120);
+      };
+
+      wrapper.addEventListener('mouseenter', openCard);
+      wrapper.addEventListener('mouseleave', closeCard);
+      wrapper.addEventListener('focusin', openCard);
+      wrapper.addEventListener('focusout', (e) => {
+        if (!wrapper.contains(e.relatedTarget)) {
+          closeCard();
+        }
+      });
+
+      wrapper.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape') {
+          card.classList.remove('is-active');
+          if (trigger) {
+            trigger.setAttribute('aria-expanded', 'false');
+            trigger.focus();
+          }
+        }
+      });
+
+      const priceEl = card.querySelector('[data-price]');
+      const caloriesEl = card.querySelector('[data-calories]');
+      const caffeineEl = card.querySelector('[data-caffeine]');
+      const sizeBtns = card.querySelectorAll('.size-btn');
+
+      sizeBtns.forEach((btn) => {
+        btn.addEventListener('click', (e) => {
+          e.preventDefault();
+          sizeBtns.forEach((b) => b.classList.remove('active'));
+          btn.classList.add('active');
+          if (priceEl && btn.dataset.price) priceEl.textContent = btn.dataset.price;
+          if (caloriesEl && btn.dataset.calories) caloriesEl.textContent = btn.dataset.calories;
+          if (caffeineEl && btn.dataset.caffeine) caffeineEl.textContent = btn.dataset.caffeine;
+        });
+      });
+    });
+  </script>
