+  <script>
+    class DrinkCard extends HTMLElement {
+      static get observedAttributes() {
+        return ['favorited', 'expanded'];
+      }
+
+      constructor() {
+        super();
+        this._onFavClick = this._onFavClick.bind(this);
+        this._onDetailsClick = this._onDetailsClick.bind(this);
+      }
+
+      connectedCallback() {
+        if (!this.shadowRoot) {
+          const tpl = this.querySelector('template[shadowrootmode]');
+          if (tpl) {
+            const root = this.attachShadow({ mode: 'open' });
+            root.appendChild(tpl.content.cloneNode(true));
+            tpl.remove();
+          }
+        }
+
+        if (!this.shadowRoot) return;
+
+        this._favBtn = this.shadowRoot.querySelector('[data-action="favorite"]');
+        this._detailsBtn = this.shadowRoot.querySelector('[data-action="details"]');
+        this._detailsPanel = this.shadowRoot.getElementById('details');
+
+        if (this._favBtn) {
+          this._favBtn.addEventListener('click', this._onFavClick);
+        }
+        if (this._detailsBtn) {
+          this._detailsBtn.addEventListener('click', this._onDetailsClick);
+        }
+
+        this._syncState();
+        this.setAttribute('hydrated', '');
+      }
+
+      disconnectedCallback() {
+        if (this._favBtn) {
+          this._favBtn.removeEventListener('click', this._onFavClick);
+        }
+        if (this._detailsBtn) {
+          this._detailsBtn.removeEventListener('click', this._onDetailsClick);
+        }
+      }
+
+      attributeChangedCallback() {
+        if (this.shadowRoot) {
+          this._syncState();
+        }
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(val) {
+        if (val) {
+          this.setAttribute('favorited', '');
+        } else {
+          this.removeAttribute('favorited');
+        }
+      }
+
+      get expanded() {
+        return this.hasAttribute('expanded');
+      }
+
+      set expanded(val) {
+        if (val) {
+          this.setAttribute('expanded', '');
+        } else {
+          this.removeAttribute('expanded');
+        }
+      }
+
+      _onFavClick() {
+        this.favorited = !this.favorited;
+        this.dispatchEvent(new CustomEvent('favorite-toggle', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            name: this.getAttribute('name'),
+            favorited: this.favorited
+          }
+        }));
+      }
+
+      _onDetailsClick() {
+        this.expanded = !this.expanded;
+        this.dispatchEvent(new CustomEvent('details-toggle', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            name: this.getAttribute('name'),
+            expanded: this.expanded
+          }
+        }));
+      }
+
+      _syncState() {
+        if (this._favBtn) {
+          const isFav = this.favorited;
+          this._favBtn.setAttribute('aria-pressed', String(isFav));
+          this._favBtn.textContent = isFav ? '\u2665' : '\u2661';
+        }
+        if (this._detailsBtn && this._detailsPanel) {
+          const isExp = this.expanded;
+          this._detailsBtn.setAttribute('aria-expanded', String(isExp));
+          this._detailsBtn.textContent = isExp ? 'Hide Details' : 'View Details';
+          this._detailsPanel.hidden = !isExp;
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
+
 </body>
 
