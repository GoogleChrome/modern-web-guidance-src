+  <script>
+    const drinkLabels = {
+      'maple-oat-latte': 'Maple Oat Latte',
+      'dark-roast-espresso': 'Dark Roast Espresso',
+      'cold-brew': 'Cold Brew'
+    };
+
+    document.querySelectorAll('.order-form').forEach((form) => {
+      const statusOutput = form.querySelector('.order-status');
+      const submitBtn = form.querySelector('.order-btn');
+
+      form.addEventListener('change', () => {
+        if (statusOutput) {
+          statusOutput.textContent = '';
+        }
+        if (submitBtn) {
+          submitBtn.disabled = false;
+          submitBtn.textContent = 'Add to Order';
+        }
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const data = new FormData(form);
+        const drinkKey = data.get('drink');
+        const size = data.get('size');
+        const drinkName = drinkLabels[drinkKey] || drinkKey;
+        const formattedSize = size ? size.charAt(0).toUpperCase() + size.slice(1) : 'Medium';
+
+        if (statusOutput) {
+          statusOutput.textContent = `Added ${formattedSize} ${drinkName} to your order.`;
+        }
+        if (submitBtn) {
+          submitBtn.disabled = true;
+          submitBtn.textContent = 'Added to Order';
+        }
+      });
+    });
+
+    /* Fallback JavaScript for browsers without :has() support */
+    if (!CSS.supports('selector(:has(*))')) {
+      const cards = document.querySelectorAll('.card');
+
+      cards.forEach((card) => {
+        if (card.querySelector('img')) {
+          card.classList.add('has-image');
+        }
+
+        const syncSelectionClasses = () => {
+          card.querySelectorAll('.size-option').forEach((option) => {
+            const radio = option.querySelector('input[type="radio"]');
+            option.classList.toggle('is-selected', Boolean(radio && radio.checked));
+          });
+          const largeRadio = card.querySelector('input[value="large"]');
+          card.classList.toggle('is-large-selected', Boolean(largeRadio && largeRadio.checked));
+        };
+
+        syncSelectionClasses();
+        card.addEventListener('change', syncSelectionClasses);
+      });
+    }
+  </script>
