+  <script>
+    (function () {
+      let totalItems = 0;
+      let totalAmount = 0;
+      const orderStatusEl = document.getElementById('order-status');
+
+      document.querySelectorAll('.card').forEach((card) => {
+        const priceEl = card.querySelector('.drink-price');
+        const form = card.querySelector('.order-controls');
+        const feedbackEl = card.querySelector('.order-feedback');
+        const addBtn = card.querySelector('.add-to-order-btn');
+        const radios = card.querySelectorAll('input[type="radio"]');
+
+        function getPriceForSize(size) {
+          const raw = card.getAttribute(`data-price-${size}`);
+          return raw ? parseFloat(raw) : 0;
+        }
+
+        radios.forEach((radio) => {
+          radio.addEventListener('change', () => {
+            if (radio.checked && priceEl) {
+              const price = getPriceForSize(radio.value);
+              priceEl.textContent = `$${price.toFixed(2)}`;
+            }
+          });
+        });
+
+        if (form) {
+          form.addEventListener('submit', (event) => {
+            event.preventDefault();
+            const selected = card.querySelector('input[type="radio"]:checked');
+            const size = selected ? selected.value : 'medium';
+            const drinkName = card.getAttribute('data-drink') || card.querySelector('h3').textContent;
+            const price = getPriceForSize(size);
+
+            totalItems += 1;
+            totalAmount += price;
+
+            if (orderStatusEl) {
+              const itemLabel = totalItems === 1 ? 'item' : 'items';
+              orderStatusEl.textContent = `Order: ${totalItems} ${itemLabel} ($${totalAmount.toFixed(2)})`;
+            }
+
+            if (addBtn) {
+              addBtn.setAttribute('data-added', 'true');
+            }
+
+            if (feedbackEl) {
+              const sizeLabel = size.charAt(0).toUpperCase() + size.slice(1);
+              feedbackEl.textContent = `Added ${sizeLabel} ${drinkName} to your order!`;
+            }
+          });
+        }
+      });
+    })();
+  </script>
+
 </body>
 
