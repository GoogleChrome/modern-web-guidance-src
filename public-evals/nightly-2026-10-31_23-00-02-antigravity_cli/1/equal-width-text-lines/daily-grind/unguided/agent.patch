+  <script>
+    (function () {
+      const heading = document.querySelector('.hero h1');
+      if (!heading) return;
+      const lines = Array.from(heading.querySelectorAll('.poster-line'));
+
+      function fitPosterLines() {
+        const targetWidth = heading.clientWidth;
+        if (!targetWidth) return;
+
+        lines.forEach((line) => {
+          const baseSize = 100;
+          line.style.fontSize = baseSize + 'px';
+          const measuredWidth = line.getBoundingClientRect().width;
+          if (measuredWidth > 0) {
+            const firstPassSize = (targetWidth / measuredWidth) * baseSize;
+            line.style.fontSize = firstPassSize + 'px';
+            const refinedWidth = line.getBoundingClientRect().width;
+            if (refinedWidth > 0) {
+              line.style.fontSize = ((targetWidth / refinedWidth) * firstPassSize).toFixed(2) + 'px';
+            }
+          }
+        });
+      }
+
+      fitPosterLines();
+      window.addEventListener('resize', fitPosterLines);
+      if ('ResizeObserver' in window) {
+        new ResizeObserver(fitPosterLines).observe(heading);
+      }
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(fitPosterLines);
+      }
+    })();
+  </script>
+
