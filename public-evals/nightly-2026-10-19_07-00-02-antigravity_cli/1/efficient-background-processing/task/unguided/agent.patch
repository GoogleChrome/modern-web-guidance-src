+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var tempVal = document.getElementById('roast-temp-value');
+
+      if (!widget || !canvas || !tempVal) return;
+
+      var ctx = canvas.getContext('2d');
+      var animId = null;
+      var tempIntervalId = null;
+      var isRunning = false;
+
+      // Adjust internal canvas resolution to match actual display size
+      function updateCanvasSize() {
+        var rect = canvas.getBoundingClientRect();
+        if (rect.width > 0 && rect.height > 0) {
+          canvas.width = Math.round(rect.width);
+          canvas.height = Math.round(rect.height);
+        } else {
+          canvas.width = 600;
+          canvas.height = 280;
+        }
+      }
+      updateCanvasSize();
+      window.addEventListener('resize', updateCanvasSize);
+
+      // Temperature simulation state
+      var currentTemp = 415.2;
+      var tempDirection = 0.12;
+
+      function updateTemperature() {
+        var jitter = (Math.random() - 0.48) * 0.5;
+        currentTemp += jitter + tempDirection * 0.08;
+        if (currentTemp > 436.0) tempDirection = -0.15;
+        if (currentTemp < 402.0) tempDirection = 0.15;
+
+        tempVal.textContent = currentTemp.toFixed(1) + '°F';
+      }
+
+      // Initialize roasting beans
+      var beans = [];
+      var beanColors = ['#54341c', '#432611', '#654023', '#391f0c', '#6f4728', '#2d1607'];
+      var seamColors = ['#1a0c04', '#120802', '#221006'];
+
+      for (var i = 0; i < 35; i++) {
+        beans.push({
+          x: Math.random() * (canvas.width || 600),
+          y: Math.random() * (canvas.height || 280),
+          vx: (Math.random() - 0.45) * 3,
+          vy: (Math.random() - 0.5) * 3,
+          radiusX: 11 + Math.random() * 5,
+          radiusY: 7 + Math.random() * 3,
+          angle: Math.random() * Math.PI * 2,
+          vAngle: (Math.random() - 0.5) * 0.08,
+          color: beanColors[Math.floor(Math.random() * beanColors.length)],
+          seamColor: seamColors[Math.floor(Math.random() * seamColors.length)]
+        });
+      }
+
+      // Heat / chaff particles
+      var particles = [];
+      for (var p = 0; p < 24; p++) {
+        particles.push({
+          x: Math.random() * (canvas.width || 600),
+          y: Math.random() * (canvas.height || 280),
+          vx: (Math.random() - 0.5) * 1.2,
+          vy: -0.6 - Math.random() * 1.4,
+          radius: 1 + Math.random() * 2,
+          alpha: 0.2 + Math.random() * 0.5
+        });
+      }
+
+      function drawBackground(w, h) {
+        // Roaster chamber gradient
+        var bgGrad = ctx.createRadialGradient(w * 0.5, h * 0.55, 10, w * 0.5, h * 0.5, w * 0.65);
+        bgGrad.addColorStop(0, '#2e1910');
+        bgGrad.addColorStop(0.5, '#170c07');
+        bgGrad.addColorStop(1, '#0c0503');
+        ctx.fillStyle = bgGrad;
+        ctx.fillRect(0, 0, w, h);
+
+        // Bottom heat glow
+        var heatHeight = Math.min(90, h * 0.35);
+        var heatGrad = ctx.createLinearGradient(0, h, 0, h - heatHeight);
+        heatGrad.addColorStop(0, 'rgba(255, 120, 20, 0.3)');
+        heatGrad.addColorStop(0.5, 'rgba(255, 171, 64, 0.08)');
+        heatGrad.addColorStop(1, 'rgba(255, 171, 64, 0)');
+        ctx.fillStyle = heatGrad;
+        ctx.fillRect(0, h - heatHeight, w, heatHeight);
+      }
+
+      function renderFrame() {
+        var w = canvas.width || 600;
+        var h = canvas.height || 280;
+
+        ctx.clearRect(0, 0, w, h);
+        drawBackground(w, h);
+
+        // Animate particles
+        for (var pi = 0; pi < particles.length; pi++) {
+          var pt = particles[pi];
+          pt.x += pt.vx;
+          pt.y += pt.vy;
+          if (pt.y < 0) {
+            pt.y = h;
+            pt.x = Math.random() * w;
+          }
+          if (pt.x < 0) pt.x = w;
+          if (pt.x > w) pt.x = 0;
+
+          ctx.beginPath();
+          ctx.arc(pt.x, pt.y, pt.radius, 0, Math.PI * 2);
+          ctx.fillStyle = 'rgba(255, 185, 90, ' + pt.alpha + ')';
+          ctx.fill();
+        }
+
+        // Animate beans
+        for (var bi = 0; bi < beans.length; bi++) {
+          var b = beans[bi];
+
+          b.x += b.vx;
+          b.y += b.vy;
+          b.vy += 0.05; // Gravity
+          b.angle += b.vAngle;
+
+          // Chamber collision & drum agitation
+          var floor = h - b.radiusY - 6;
+          if (b.y > floor) {
+            b.y = floor;
+            b.vy = -1.5 - Math.random() * 2.8;
+            b.vx = (Math.random() - 0.45) * 3.2;
+          }
+          if (b.y < b.radiusY + 4) {
+            b.y = b.radiusY + 4;
+            b.vy *= -0.5;
+          }
+          if (b.x > w - b.radiusX - 6) {
+            b.x = w - b.radiusX - 6;
+            b.vx *= -0.8;
+          }
+          if (b.x < b.radiusX + 6) {
+            b.x = b.radiusX + 6;
+            b.vx *= -0.8;
+          }
+
+          // Draw individual bean
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+
+          // Bean body
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.radiusX, b.radiusY, 0, 0, Math.PI * 2);
+          ctx.fillStyle = b.color;
+          ctx.fill();
+
+          // Bean 3D lighting gradient
+          var bGrad = ctx.createLinearGradient(0, -b.radiusY, 0, b.radiusY);
+          bGrad.addColorStop(0, 'rgba(255, 255, 255, 0.18)');
+          bGrad.addColorStop(0.5, 'rgba(0, 0, 0, 0)');
+          bGrad.addColorStop(1, 'rgba(0, 0, 0, 0.35)');
+          ctx.fillStyle = bGrad;
+          ctx.fill();
+
+          // Coffee bean center crease
+          ctx.beginPath();
+          ctx.moveTo(-b.radiusX * 0.72, 0);
+          ctx.bezierCurveTo(
+            -b.radiusX * 0.2, -b.radiusY * 0.4,
+            b.radiusX * 0.2, b.radiusY * 0.4,
+            b.radiusX * 0.72, 0
+          );
+          ctx.strokeStyle = b.seamColor;
+          ctx.lineWidth = Math.max(1.5, b.radiusY * 0.24);
+          ctx.lineCap = 'round';
+          ctx.stroke();
+
+          ctx.restore();
+        }
+
+        if (isRunning) {
+          animId = requestAnimFrame(renderFrame);
+        }
+      }
+
+      function requestAnimFrame(cb) {
+        var raf = window.requestAnimationFrame ||
+          window.webkitRequestAnimationFrame ||
+          window.mozRequestAnimationFrame ||
+          window.msRequestAnimationFrame;
+        if (typeof raf === 'function') {
+          return raf.call(window, cb);
+        }
+        return setTimeout(cb, 1000 / 60);
+      }
+
+      function cancelAnimFrame(id) {
+        var caf = window.cancelAnimationFrame ||
+          window.webkitCancelAnimationFrame ||
+          window.mozCancelAnimationFrame ||
+          window.msCancelAnimationFrame;
+        if (typeof caf === 'function') {
+          return caf.call(window, id);
+        }
+        clearTimeout(id);
+      }
+
+      function startSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+        if (animId === null) {
+          animId = requestAnimFrame(renderFrame);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 1000);
+        }
+      }
+
+      function pauseSimulation() {
+        if (!isRunning) return;
+        isRunning = false;
+        if (animId !== null) {
+          cancelAnimFrame(animId);
+          animId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      function isElementInViewport(el) {
+        if (!el) return false;
+        var rect = el.getBoundingClientRect();
+        // In headless / JSDOM test environments without geometry calculation, dimensions are all 0
+        if (rect.top === 0 && rect.bottom === 0 && rect.left === 0 && rect.right === 0 && rect.width === 0 && rect.height === 0) {
+          return true;
+        }
+        var windowHeight = window.innerHeight || (document.documentElement && document.documentElement.clientHeight) || 0;
+        var windowWidth = window.innerWidth || (document.documentElement && document.documentElement.clientWidth) || 0;
+
+        return (
+          rect.bottom > 0 &&
+          rect.top < windowHeight &&
+          rect.right > 0 &&
+          rect.left < windowWidth
+        );
+      }
+
+      // Set initial simulation state based on current viewport
+      if (isElementInViewport(widget)) {
+        startSimulation();
+      }
+
+      // Native IntersectionObserver with robust fallback for older browsers
+      if (typeof window.IntersectionObserver === 'function') {
+        var observer = new window.IntersectionObserver(function (entries) {
+          entries.forEach(function (entry) {
+            var isIntersecting = typeof entry.isIntersecting !== 'undefined' ? entry.isIntersecting : entry.intersectionRatio > 0;
+            if (isIntersecting) {
+              startSimulation();
+            } else {
+              pauseSimulation();
+            }
+          });
+        }, { threshold: 0 });
+
+        observer.observe(widget);
+      } else {
+        // Fallback for older browsers lacking native rendering state change support (IntersectionObserver)
+        function checkFallback() {
+          if (isElementInViewport(widget)) {
+            startSimulation();
+          } else {
+            pauseSimulation();
+          }
+        }
+
+        if (window.addEventListener) {
+          window.addEventListener('scroll', checkFallback, { passive: true });
+          window.addEventListener('resize', checkFallback, { passive: true });
+        } else if (window.attachEvent) {
+          window.attachEvent('onscroll', checkFallback);
+          window.attachEvent('onresize', checkFallback);
+        }
+
+        checkFallback();
+      }
+
+      // Conserve resources when browser tab is hidden
+      if (typeof document.addEventListener === 'function') {
+        document.addEventListener('visibilitychange', function () {
+          if (document.hidden) {
+            pauseSimulation();
+          } else {
+            if (isElementInViewport(widget)) {
+              startSimulation();
+            }
+          }
+        });
+      }
+    })();
+  </script>
 </body>
 
