+  <!-- Theme Switching and Late Night Filter JavaScript -->
+  <script>
+    (function () {
+      const themeSelect = document.getElementById('theme-select');
+      const root = document.documentElement;
+
+      function applyTheme(theme) {
+        if (theme === 'light') {
+          root.setAttribute('data-theme', 'light');
+          root.style.colorScheme = 'light';
+        } else if (theme === 'dark') {
+          root.setAttribute('data-theme', 'dark');
+          root.style.colorScheme = 'dark';
+        } else {
+          // System default
+          root.removeAttribute('data-theme');
+          root.style.colorScheme = '';
+        }
+      }
+
+      if (themeSelect) {
+        themeSelect.addEventListener('change', function () {
+          applyTheme(this.value);
+          try {
+            localStorage.setItem('daily-grind-theme-choice', this.value);
+          } catch (e) {
+            /* ignore storage restrictions */
+          }
+        });
+
+        // Initialize theme from localStorage or system default
+        try {
+          const savedTheme = localStorage.getItem('daily-grind-theme-choice');
+          if (savedTheme && ['system', 'light', 'dark'].includes(savedTheme)) {
+            themeSelect.value = savedTheme;
+            applyTheme(savedTheme);
+          } else {
+            themeSelect.value = 'system';
+            applyTheme('system');
+          }
+        } catch (e) {
+          themeSelect.value = 'system';
+          applyTheme('system');
+        }
+      }
+
+      // Late night menu category filtering
+      const lateNightSelect = document.getElementById('late-night-select');
+      const lateNightCards = document.querySelectorAll('.late-night-card');
+
+      if (lateNightSelect) {
+        lateNightSelect.addEventListener('change', function () {
+          const category = this.value;
+          lateNightCards.forEach(function (card) {
+            if (category === 'all' || card.getAttribute('data-category') === category) {
+              card.style.display = '';
+            } else {
+              card.style.display = 'none';
+            }
+          });
+        });
+      }
+    })();
+  </script>
