+  <!-- Theme Switching and Specials Filter Logic -->
+  <script>
+    (function () {
+      const themeSelect = document.getElementById('theme-select');
+      const metaColorScheme = document.querySelector('meta[name="color-scheme"]');
+
+      function applyTheme(theme) {
+        if (theme === 'dark') {
+          document.documentElement.setAttribute('data-theme', 'dark');
+          document.documentElement.style.colorScheme = 'dark';
+          if (metaColorScheme) metaColorScheme.content = 'dark';
+          try {
+            localStorage.setItem('theme-preference', 'dark');
+          } catch (e) { }
+        } else if (theme === 'light') {
+          document.documentElement.setAttribute('data-theme', 'light');
+          document.documentElement.style.colorScheme = 'light';
+          if (metaColorScheme) metaColorScheme.content = 'light';
+          try {
+            localStorage.setItem('theme-preference', 'light');
+          } catch (e) { }
+        } else {
+          document.documentElement.removeAttribute('data-theme');
+          document.documentElement.style.colorScheme = '';
+          if (metaColorScheme) metaColorScheme.content = 'light dark';
+          try {
+            localStorage.removeItem('theme-preference');
+          } catch (e) { }
+        }
+
+        if (themeSelect) {
+          themeSelect.value = theme || 'system';
+        }
+      }
+
+      // Initialize theme dropdown
+      try {
+        const storedTheme = localStorage.getItem('theme-preference');
+        if (storedTheme === 'light' || storedTheme === 'dark') {
+          applyTheme(storedTheme);
+        } else {
+          applyTheme('system');
+        }
+      } catch (e) {
+        applyTheme('system');
+      }
+
+      // Handle user manual selection
+      if (themeSelect) {
+        themeSelect.addEventListener('change', (e) => {
+          applyTheme(e.target.value);
+        });
+      }
+
+      // Sync across browser tabs
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'theme-preference') {
+          applyTheme(e.newValue || 'system');
+        }
+      });
+
+      // Filter Late Night Specials
+      const specialsCategory = document.getElementById('specials-category');
+      const specialCards = document.querySelectorAll('.special-card');
+
+      if (specialsCategory) {
+        specialsCategory.addEventListener('change', (e) => {
+          const selected = e.target.value;
+          specialCards.forEach((card) => {
+            if (selected === 'all' || card.dataset.category === selected) {
+              card.style.display = 'flex';
+            } else {
+              card.style.display = 'none';
+            }
+          });
+        });
+      }
+    })();
+  </script>
