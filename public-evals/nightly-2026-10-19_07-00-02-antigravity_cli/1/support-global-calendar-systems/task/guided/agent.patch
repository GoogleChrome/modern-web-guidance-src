+  <script type="module">
+    // Helper to check environment calendar support
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    // Progressive feature detection and polyfill loader
+    async function getTemporal() {
+      if (typeof Temporal !== 'undefined') {
+        return Temporal;
+      }
+      if (typeof globalThis.temporal !== 'undefined' && globalThis.temporal.Temporal) {
+        globalThis.Temporal = globalThis.temporal.Temporal;
+        return globalThis.Temporal;
+      }
+      try {
+        await new Promise((resolve, reject) => {
+          const script = document.createElement('script');
+          script.src = './vendor/temporal-polyfill.js';
+          script.onload = () => {
+            if (globalThis.temporal && globalThis.temporal.Temporal) {
+              globalThis.Temporal = globalThis.temporal.Temporal;
+              resolve(globalThis.Temporal);
+            } else if (globalThis.Temporal) {
+              resolve(globalThis.Temporal);
+            } else {
+              reject(new Error('Polyfill loaded without Temporal object'));
+            }
+          };
+          script.onerror = reject;
+          document.head.appendChild(script);
+        });
+        return globalThis.Temporal;
+      } catch (localErr) {
+        try {
+          const module = await import('https://esm.sh/@js-temporal/polyfill');
+          globalThis.Temporal = module.Temporal;
+          return module.Temporal;
+        } catch (cdnErr) {
+          console.error('Failed to load Temporal polyfill:', cdnErr);
+          throw cdnErr;
+        }
+      }
+    }
+
+    const CALENDARS = [
+      {
+        id: 'islamic-umalqura',
+        name: 'Islamic (Umm al-Qura)',
+        dateElementId: 'islamic-date',
+        formatFn: (targetDate) => {
+          return targetDate.toLocaleString('en-u-ca-islamic-umalqura', {
+            dateStyle: 'full'
+          });
+        },
+        subFormatFn: (targetDate) => {
+          try {
+            return targetDate.toLocaleString('ar-SA-u-ca-islamic-umalqura', {
+              dateStyle: 'full'
+            });
+          } catch {
+            return '';
+          }
+        }
+      },
+      {
+        id: 'hebrew',
+        name: 'Hebrew',
+        dateElementId: 'hebrew-date',
+        formatFn: (targetDate) => {
+          return targetDate.toLocaleString('en-u-ca-hebrew', {
+            dateStyle: 'full'
+          });
+        },
+        subFormatFn: (targetDate) => {
+          try {
+            return targetDate.toLocaleString('he-IL-u-ca-hebrew', {
+              dateStyle: 'full'
+            });
+          } catch {
+            return '';
+          }
+        }
+      },
+      {
+        id: 'japanese',
+        name: 'Japanese',
+        dateElementId: 'japanese-date',
+        formatFn: (targetDate) => {
+          return targetDate.toLocaleString('en-u-ca-japanese', {
+            era: 'long',
+            year: 'numeric',
+            month: 'long',
+            day: 'numeric'
+          });
+        },
+        subFormatFn: (targetDate) => {
+          try {
+            const jaStr = targetDate.toLocaleString('ja-u-ca-japanese', {
+              era: 'long',
+              year: 'numeric',
+              month: 'long',
+              day: 'numeric'
+            });
+            const eraName = targetDate.era ? (targetDate.era.charAt(0).toUpperCase() + targetDate.era.slice(1)) : '';
+            return `${jaStr} (${eraName} Era)`;
+          } catch {
+            return '';
+          }
+        }
+      }
+    ];
+
+    async function initCalendarTool() {
+      const Temporal = await getTemporal();
+      const dateInput = document.getElementById('calendar-date-input');
+
+      function updateCalendars(isoDateString) {
+        if (!isoDateString) return;
+        let isoDate;
+        try {
+          isoDate = Temporal.PlainDate.from(isoDateString);
+        } catch (err) {
+          console.error('Invalid date string:', isoDateString, err);
+          return;
+        }
+
+        const nowIso = Temporal.Now.plainDateISO();
+
+        CALENDARS.forEach((cal) => {
+          const supported = isCalendarSupported(cal.id);
+          const targetDate = supported ? isoDate.withCalendar(cal.id) : isoDate;
+          const calToday = supported ? nowIso.withCalendar(cal.id) : nowIso;
+
+          // 1. Formatted localized date
+          const formattedMain = cal.formatFn(targetDate);
+          const formattedSub = cal.subFormatFn ? cal.subFormatFn(targetDate) : '';
+
+          const mainDateEl = document.getElementById(cal.dateElementId);
+          if (mainDateEl) {
+            mainDateEl.textContent = formattedMain;
+          }
+          const subDateEl = document.getElementById(`${cal.id}-subdate`);
+          if (subDateEl) {
+            subDateEl.textContent = formattedSub;
+          }
+
+          // 2. Converted year, numeric month, unique stable month code
+          const yearEl = document.getElementById(`${cal.id}-year`);
+          if (yearEl) {
+            if (cal.id === 'japanese' && targetDate.era) {
+              const eraCap = targetDate.era.charAt(0).toUpperCase() + targetDate.era.slice(1);
+              yearEl.textContent = `${targetDate.year} (${eraCap} Year ${targetDate.eraYear})`;
+            } else {
+              yearEl.textContent = `${targetDate.year}`;
+            }
+          }
+
+          const monthEl = document.getElementById(`${cal.id}-month`);
+          if (monthEl) {
+            monthEl.textContent = `${targetDate.month}`;
+          }
+
+          const monthCodeEl = document.getElementById(`${cal.id}-monthcode`);
+          if (monthCodeEl) {
+            monthCodeEl.textContent = targetDate.monthCode;
+          }
+
+          // 3. Total number of months in that specific calendar year
+          const monthsInYearEl = document.getElementById(`${cal.id}-months-in-year`);
+          if (monthsInYearEl) {
+            const isLunisolarLeap = targetDate.monthsInYear > 12;
+            monthsInYearEl.textContent = `${targetDate.monthsInYear} months${isLunisolarLeap ? ' (Lunisolar Leap Year)' : ''}`;
+          }
+
+          // 4. Timeline label comparing against current date ('Past', 'Future', or 'Today')
+          const comparison = Temporal.PlainDate.compare(targetDate, calToday);
+          const timelineLabel = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+          const timelineEl = document.getElementById(`${cal.id}-timeline`);
+          if (timelineEl) {
+            timelineEl.textContent = timelineLabel;
+            timelineEl.className = `timeline-badge val-timeline timeline-${timelineLabel.toLowerCase()}`;
+          }
+
+          // 5. Month breakdown showing each month's code and days in that month for that year
+          const breakdownContainer = document.getElementById(`${cal.id}-breakdown`);
+          if (breakdownContainer) {
+            breakdownContainer.innerHTML = '';
+            for (let m = 1; m <= targetDate.monthsInYear; m++) {
+              // Safety invariant: always use day: 1 so date is valid across varying month lengths
+              const monthDate = targetDate.with({ month: m, day: 1 });
+              const isSelectedMonth = (m === targetDate.month);
+              let monthName = '';
+              try {
+                monthName = monthDate.toLocaleString('en-u-ca-' + cal.id, { month: 'short' });
+              } catch {
+                monthName = `M${m}`;
+              }
+
+              const cell = document.createElement('div');
+              cell.className = `month-cell ${isSelectedMonth ? 'is-selected' : ''}`;
+              cell.innerHTML = `
+                <div>
+                  <span class="m-code">${monthDate.monthCode}</span>
+                  <span style="margin-left: 4px; color: #5d4037;">${monthName}</span>
+                </div>
+                <span class="m-days">${monthDate.daysInMonth} days</span>
+              `;
+              breakdownContainer.appendChild(cell);
+            }
+          }
+        });
+      }
+
+      // Initialize with today's date
+      const todayIso = Temporal.Now.plainDateISO().toString();
+      dateInput.value = todayIso;
+      updateCalendars(todayIso);
+
+      dateInput.addEventListener('input', (e) => {
+        if (e.target.value) {
+          updateCalendars(e.target.value);
+        }
+      });
+
+      document.getElementById('btn-today')?.addEventListener('click', () => {
+        const todayStr = Temporal.Now.plainDateISO().toString();
+        dateInput.value = todayStr;
+        updateCalendars(todayStr);
+      });
+
+      document.getElementById('btn-hebrew-leap')?.addEventListener('click', () => {
+        const leapDateStr = '2024-03-15'; // Hebrew leap year 5784 (13 months with M05L Adar I)
+        dateInput.value = leapDateStr;
+        updateCalendars(leapDateStr);
+      });
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initCalendarTool);
+    } else {
+      initCalendarTool();
+    }
+  </script>
