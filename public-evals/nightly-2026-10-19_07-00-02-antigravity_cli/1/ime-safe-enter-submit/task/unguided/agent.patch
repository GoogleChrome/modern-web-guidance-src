+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackTextarea = document.getElementById('feedback');
+    const sendButton = document.getElementById('feedback-submit');
+
+    let isSubmitting = false;
+
+    function handleEnter(e) {
+      if ((e.key === 'Enter' || e.keyCode === 13 || e.which === 13) && !e.shiftKey) {
+        e.preventDefault();
+        if (isSubmitting) return;
+        isSubmitting = true;
+        setTimeout(() => { isSubmitting = false; }, 100);
+
+        if (typeof feedbackForm.requestSubmit === 'function') {
+          feedbackForm.requestSubmit();
+        } else if (sendButton) {
+          sendButton.click();
+        } else {
+          feedbackForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
+        }
+      }
+    }
+
+    feedbackTextarea.addEventListener('keydown', handleEnter);
+    feedbackTextarea.addEventListener('keypress', handleEnter);
+
+    feedbackForm.addEventListener('submit', function (e) {
+      e.preventDefault();
+    });
+  </script>
+
