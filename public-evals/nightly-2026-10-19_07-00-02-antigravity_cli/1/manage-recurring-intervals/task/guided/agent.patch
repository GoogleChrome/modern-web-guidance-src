+  <script type="module">
+    // Progressive polyfill feature detection for Temporal API
+    async function loadTemporal() {
+      if (typeof Temporal !== 'undefined') {
+        return;
+      }
+
+      // Try loading polyfill from standard CDN
+      try {
+        const module = await import("https://esm.sh/@js-temporal/polyfill");
+        globalThis.Temporal = module.Temporal;
+        if (module.toTemporalInstant) {
+          Date.prototype.toTemporalInstant = module.toTemporalInstant;
+        }
+        return;
+      } catch (err) {
+        console.warn("CDN polyfill import failed, trying local package:", err);
+      }
+
+      // Try loading polyfill from local node_modules
+      try {
+        const localModule = await import("./node_modules/@js-temporal/polyfill/dist/index.esm.js");
+        globalThis.Temporal = localModule.Temporal;
+        if (localModule.toTemporalInstant) {
+          Date.prototype.toTemporalInstant = localModule.toTemporalInstant;
+        }
+        return;
+      } catch (err) {
+        console.warn("Local polyfill import failed, using embedded PlainDate implementation:", err);
+      }
+
+      // Lightweight fallback for offline/sandboxed environments
+      globalThis.Temporal = {
+        PlainDate: {
+          from(item) {
+            const iso = typeof item === 'string' ? item : item.toString();
+            const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso.trim());
+            if (!match) {
+              throw new RangeError(`Invalid ISO date format: ${iso}`);
+            }
+            const year = Number(match[1]);
+            const month = Number(match[2]);
+            const day = Number(match[3]);
+            if (month < 1 || month > 12) {
+              throw new RangeError(`Month out of range: ${month}`);
+            }
+            const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
+            if (day < 1 || day > daysInMonth) {
+              throw new RangeError(`Day out of range: 1 <= ${day} <= ${daysInMonth}`);
+            }
+            return {
+              year,
+              month,
+              day,
+              toString() {
+                return `${String(year).padStart(4, '0')}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
+              },
+              add(duration, options = { overflow: 'constrain' }) {
+                const addYears = duration.years || 0;
+                const addMonths = duration.months || 0;
+                const overflow = options.overflow || 'constrain';
+
+                const totalMonths = (this.month - 1) + addMonths;
+                const targetYear = this.year + addYears + Math.floor(totalMonths / 12);
+                const targetMonth = ((totalMonths % 12) + 12) % 12 + 1;
+
+                const targetDaysInMonth = new Date(Date.UTC(targetYear, targetMonth, 0)).getUTCDate();
+                let targetDay = this.day;
+
+                if (targetDay > targetDaysInMonth) {
+                  if (overflow === 'reject') {
+                    throw new RangeError(`value out of range: 1 <= ${targetDay} <= ${targetDaysInMonth}`);
+                  }
+                  targetDay = targetDaysInMonth;
+                }
+
+                return Temporal.PlainDate.from(
+                  `${String(targetYear).padStart(4, '0')}-${String(targetMonth).padStart(2, '0')}-${String(targetDay).padStart(2, '0')}`
+                );
+              }
+            };
+          }
+        }
+      };
+    }
+
+    function calculateNextDelivery() {
+      const resultEl = document.getElementById('resultDate');
+      const containerEl = document.getElementById('resultContainer');
+      const startDateInput = document.getElementById('startDateInput');
+      const yearsInput = document.getElementById('yearsInput');
+      const monthsInput = document.getElementById('monthsInput');
+      const overflowSelect = document.getElementById('overflowSelect');
+
+      if (!resultEl || !startDateInput || !yearsInput || !monthsInput || !overflowSelect) {
+        return;
+      }
+
+      if (typeof Temporal === 'undefined') {
+        resultEl.textContent = 'Loading calculation engine...';
+        return;
+      }
+
+      const startDateVal = startDateInput.value.trim();
+      if (!startDateVal) {
+        resultEl.textContent = 'Error: Please enter a valid start date.';
+        resultEl.classList.add('error');
+        if (containerEl) containerEl.classList.add('has-error');
+        return;
+      }
+
+      const yearsStr = yearsInput.value.trim();
+      const monthsStr = monthsInput.value.trim();
+
+      if (yearsStr === '' || isNaN(yearsStr) || Number(yearsStr) < 0 || !Number.isInteger(Number(yearsStr))) {
+        resultEl.textContent = 'Error: Please enter a valid non-negative number of years.';
+        resultEl.classList.add('error');
+        if (containerEl) containerEl.classList.add('has-error');
+        return;
+      }
+
+      if (monthsStr === '' || isNaN(monthsStr) || Number(monthsStr) < 0 || !Number.isInteger(Number(monthsStr))) {
+        resultEl.textContent = 'Error: Please enter a valid non-negative number of months.';
+        resultEl.classList.add('error');
+        if (containerEl) containerEl.classList.add('has-error');
+        return;
+      }
+
+      const years = Number(yearsStr);
+      const months = Number(monthsStr);
+      const overflow = overflowSelect.value;
+
+      try {
+        const startDate = Temporal.PlainDate.from(startDateVal);
+        const nextDeliveryDate = startDate.add({ years, months }, { overflow });
+        resultEl.textContent = nextDeliveryDate.toString();
+        resultEl.classList.remove('error');
+        if (containerEl) containerEl.classList.remove('has-error');
+      } catch (err) {
+        resultEl.textContent = `Error: Calculation failed (${err.message}). Cannot resolve month-end overflow with '${overflow}' strategy.`;
+        resultEl.classList.add('error');
+        if (containerEl) containerEl.classList.add('has-error');
+      }
+    }
+
+    async function init() {
+      const inputs = [
+        document.getElementById('startDateInput'),
+        document.getElementById('yearsInput'),
+        document.getElementById('monthsInput'),
+        document.getElementById('overflowSelect')
+      ];
+
+      inputs.forEach(input => {
+        if (input) {
+          input.addEventListener('input', calculateNextDelivery);
+          input.addEventListener('change', calculateNextDelivery);
+        }
+      });
+
+      await loadTemporal();
+      calculateNextDelivery();
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', init);
+    } else {
+      init();
+    }
+  </script>
