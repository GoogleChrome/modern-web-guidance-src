+      const views = Array.from(stack.querySelectorAll('.Stack-view'));
+
+      if (settledIndex >= views.length) return;
+
+      const currentView = views[settledIndex];
+      const currentViewId = currentView.dataset.viewId;
+
+      // Views we swipe past get removed from the DOM to save memory
+      let removedViewId = null;
+      let removedAny = false;
+      for (let i = views.length - 1; i > settledIndex; i--) {
+        removedViewId = views[i].dataset.viewId;
+        views[i].remove();
+        removedAny = true;
+      }
+
+      // Sync browser history and focus when swiping back to root
+      if (settledIndex === 0) {
+        if (window.location.hash && window.location.hash !== '' && window.location.hash !== '#') {
+          history.replaceState({ viewId: 'root' }, '', window.location.pathname + window.location.search);
+        }
+
+        if (removedAny && removedViewId) {
+          const originLink = lastTriggerMap.get(removedViewId) || root.querySelector(`a.item[href="#/view/${removedViewId}"]`);
+          if (originLink) {
+            originLink.focus({ preventScroll: true });
+          }
+        }
+      } else {
+        // We are on a drill-down view
+        const expectedHash = `#/view/${currentViewId}`;
+        if (window.location.hash !== expectedHash) {
+          history.replaceState({ viewId: currentViewId }, '', expectedHash);
+        }
+
+        const backBtn = currentView.querySelector('.back');
+        if (backBtn && document.activeElement !== backBtn) {
+          backBtn.focus({ preventScroll: true });
+        }
+      }
+    }
+
+    // Fallback parallax and dimming for browsers without native scroll-driven animations (e.g. Firefox)
+    function setupScrollParallaxFallback() {
+      if (CSS.supports('(animation-timeline: view()) and (animation-range: entry)')) {
+        return; // Handled natively by compositor thread via CSS
+      }
+
+      const updateParallax = () => {
+        if (prefersReducedMotion()) return;
+        const width = stack.clientWidth;
+        if (!width) return;
+
+        const scrollLeft = stack.scrollLeft;
+        const views = stack.querySelectorAll('.Stack-view');
+        views.forEach((view, index) => {
+          const content = view.querySelector('.Stack-viewContent');
+          if (!content) return;
+
+          const viewLeft = index * width;
+          const progress = (scrollLeft - viewLeft) / width;
+
+          // Parallax and dimming when this view is underneath the next view being swiped/viewed
+          if (progress > 0 && progress <= 1) {
+            content.style.transform = `translateX(${progress * 25}%)`;
+            content.style.filter = `brightness(${1 - progress * 0.32})`;
+          } else if (progress > 1) {
+            content.style.transform = 'translateX(25%)';
+            content.style.filter = 'brightness(0.68)';
+          } else {
+            content.style.transform = '';
+            content.style.filter = '';
+          }
+        });
+      };
+
+      stack.addEventListener('scroll', updateParallax, { passive: true });
+    }
+
+    // Click handler preserving modifier & middle clicks on details links
+    document.addEventListener('click', (e) => {
+      // Check if back button was clicked
+      const backBtn = e.target.closest('button.back');
+      if (backBtn) {
+        e.preventDefault();
+        navigateBack();
+        return;
+      }
+
+      // Check if details item link was clicked
+      const itemLink = e.target.closest('a.item');
+      if (!itemLink) return;
+
+      // Preserve modifier keys and middle clicks so users can still open in new tabs
+      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) {
+        return;
+      }
+
+      e.preventDefault();
+      const href = itemLink.getAttribute('href');
+      navigateTo(href, itemLink);
+    });
+
+    // Browser history sync (Back/Forward buttons)
+    window.addEventListener('popstate', () => {
+      const viewId = parseViewId(window.location.hash);
+      const smooth = !prefersReducedMotion();
+
+      if (!viewId) {
+        // Return to root
+        stack.scrollTo({
+          left: 0,
+          behavior: smooth ? 'smooth' : 'auto'
+        });
+      } else {
+        // Forward or back to a drill-down view
+        let targetView = stack.querySelector(`.Stack-view[data-view-id="${viewId}"]`);
+        if (!targetView) {
+          targetView = createViewElement(viewId);
+          stack.appendChild(targetView);
+        }
+        stack.scrollTo({
+          left: targetView.offsetLeft,
+          behavior: smooth ? 'smooth' : 'auto'
+        });
+        const backBtn = targetView.querySelector('.back');
+        if (backBtn) {
+          backBtn.focus({ preventScroll: true });
+        }
+      }
+    });
+
+    // Native scrollend and debounced scroll listeners for gesture completion
+    if ('onscrollend' in window) {
+      stack.addEventListener('scrollend', onScrollSettled);
+    }
+    stack.addEventListener('scroll', () => {
+      clearTimeout(scrollEndTimer);
+      scrollEndTimer = setTimeout(onScrollSettled, 120);
+    }, { passive: true });
+
+    // Window resize handler to maintain snap alignment
+    window.addEventListener('resize', () => {
+      const width = stack.clientWidth;
+      const viewId = parseViewId(window.location.hash);
+      if (!viewId) {
+        stack.scrollLeft = 0;
+      } else {
+        const targetView = stack.querySelector(`.Stack-view[data-view-id="${viewId}"]`);
+        if (targetView) {
+          stack.scrollLeft = targetView.offsetLeft;
+        }
+      }
+    });
+
+    // Deep-linking initialization on page load
+    function initApp() {
+      setupScrollParallaxFallback();
+
+      const initialViewId = parseViewId(window.location.hash);
+      if (initialViewId) {
+        // Synthesize homepage behind it: root is already in DOM at index 0!
+        const originLink = root.querySelector(`a.item[href="#/view/${initialViewId}"]`);
+        if (originLink) {
+          lastTriggerMap.set(initialViewId, originLink);
+        }
+
+        const drillDownView = createViewElement(initialViewId);
+        stack.appendChild(drillDownView);
+
+        // Immediate initial scroll to the deep-linked view without animation
+        stack.scrollLeft = stack.clientWidth;
+
+        // Set history stack: root as base, deep-link as current
+        history.replaceState({ viewId: 'root' }, '', window.location.pathname + window.location.search);
+        history.pushState({ viewId: initialViewId }, '', window.location.hash);
+
+        // Focus back button on initial view without scrolling
+        const backBtn = drillDownView.querySelector('.back');
+        if (backBtn) {
+          backBtn.focus({ preventScroll: true });
+        }
+      } else {
+        history.replaceState({ viewId: 'root' }, '', window.location.pathname + window.location.search);
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initApp);
+    } else {
+      initApp();
+    }
+  </script>
 </body>
 
 </html>
