+      return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    }
+
+    // Template for creating drill-down views
+    function createViewElement(item) {
+      const view = document.createElement('div');
+      view.className = 'Stack-view';
+      view.dataset.viewId = item.id;
+      view.id = `view-${item.id}`;
+
+      view.innerHTML = `
+        <div class="Stack-viewContent">
+          <header class="drill-header">
+            <button type="button" class="back" aria-label="Back to seasonal menu">
+              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+                <polyline points="15 18 9 12 15 6"></polyline>
+              </svg>
+              <span>Back</span>
+            </button>
+            <h2>${item.title}</h2>
+            <div class="drill-header-spacer" aria-hidden="true"></div>
+          </header>
+
+          <div class="drill-body">
+            <div class="drill-hero-container">
+              <img src="${item.image}" alt="${item.title}" class="drill-img" loading="eager" />
+              <div class="drill-price-badge">${item.price}</div>
+            </div>
+
+            <div class="drill-content-inner">
+              <div class="drill-meta-pills">
+                <span class="drill-pill">${item.roast}</span>
+                <span class="drill-pill">${item.temp}</span>
+                <span class="drill-pill">${item.calories}</span>
+              </div>
+
+              <p class="drill-tagline">${item.tagline}</p>
+              <p class="drill-description">${item.description}</p>
+
+              <div class="drill-section">
+                <h3>Tasting Notes</h3>
+                <div class="tasting-tags">
+                  ${item.notes.map(note => `<span class="tasting-tag">${note}</span>`).join('')}
+                </div>
+              </div>
+
+              <div class="drill-section">
+                <h3>Coffee Profile</h3>
+                <div class="specs-grid">
+                  <div class="spec-item">
+                    <span class="spec-label">Origin</span>
+                    <span class="spec-val">${item.origin}</span>
+                  </div>
+                  <div class="spec-item">
+                    <span class="spec-label">Caffeine</span>
+                    <span class="spec-val">${item.caffeine}</span>
+                  </div>
+                  <div class="spec-item">
+                    <span class="spec-label">Serving Style</span>
+                    <span class="spec-val">${item.temp}</span>
+                  </div>
+                </div>
+              </div>
+
+              <div class="drill-section">
+                <h3>Ingredients & Sourcing</h3>
+                <p style="color: var(--text-muted); font-size: 0.95rem;">${item.ingredients}</p>
+              </div>
+
+              <div class="drill-cta-wrap">
+                <button type="button" class="order-action-btn" onclick="alert('Added ${item.title} to order!')">Order Now • ${item.price}</button>
+              </div>
+            </div>
+          </div>
+        </div>
+      `;
+
+      return view;
+    }
+
+    // Scroll-linked visual transforms: parallax, dimming, and edge shadow.
+    // NOTE: Transforms are strictly applied to .Stack-viewContent only, preserving .Stack-view snap layout!
+    let isTicking = false;
+    function renderVisualTransforms() {
+      const stackWidth = stack.clientWidth;
+      if (!stackWidth) return;
+      const scrollLeft = stack.scrollLeft;
+      const views = stack.children;
+      const count = views.length;
+      const prefersReduced = getPrefersReducedMotion();
+
+      for (let i = 0; i < count; i++) {
+        const view = views[i];
+        const content = view.querySelector('.Stack-viewContent');
+        if (!content) continue;
+
+        if (prefersReduced) {
+          content.style.transform = 'none';
+          content.style.filter = 'none';
+          content.style.boxShadow = i > 0 ? '-14px 0 28px rgba(0, 0, 0, 0.25)' : 'none';
+          continue;
+        }
+
+        // Relative progress:
+        // progress === 0 -> view i is currently active/centered
+        // progress > 0   -> view i is to the left (being covered by the view to its right)
+        // progress < 0   -> view i is incoming from the right over previous card
+        const progress = (scrollLeft - (i * stackWidth)) / stackWidth;
+
+        if (progress >= 0 && progress <= 1) {
+          // Bottom card being covered: parallax offset shifts rightwards
+          const parallaxX = progress * (stackWidth * 0.28);
+          content.style.transform = `translate3d(${parallaxX}px, 0, 0)`;
+
+          // Dimming effect as card is covered
+          const dim = progress * 0.45;
+          content.style.filter = dim > 0.005 ? `brightness(${(1 - dim).toFixed(3)})` : 'none';
+
+          // Edge shadow is only on top card
+          content.style.boxShadow = i > 0 ? '-14px 0 28px rgba(0, 0, 0, 0.25)' : 'none';
+        } else if (progress < 0 && progress >= -1) {
+          // Top card sliding over card beneath it
+          content.style.transform = 'translate3d(0, 0, 0)';
+          content.style.filter = 'none';
+
+          // Premium left-edge shadow
+          const shadowAlpha = 0.18 + (1 + progress) * 0.16;
+          content.style.boxShadow = `-16px 0 32px rgba(0, 0, 0, ${shadowAlpha.toFixed(2)})`;
+        } else if (progress > 1) {
+          // Completely off-screen to the left
+          content.style.transform = `translate3d(${stackWidth * 0.28}px, 0, 0)`;
+          content.style.filter = 'brightness(0.55)';
+          content.style.boxShadow = i > 0 ? '-14px 0 28px rgba(0, 0, 0, 0.25)' : 'none';
+        } else {
+          // Completely off-screen to the right
+          content.style.transform = 'translate3d(0, 0, 0)';
+          content.style.filter = 'none';
+          content.style.boxShadow = i > 0 ? '-14px 0 28px rgba(0, 0, 0, 0.25)' : 'none';
+        }
+      }
+    }
+
+    function onStackScroll() {
+      if (!isTicking) {
+        window.requestAnimationFrame(() => {
+          renderVisualTransforms();
+          isTicking = false;
+        });
+        isTicking = true;
+      }
+    }
+
+    // DOM cleanup when user swipes past views
+    function handleScrollSettled() {
+      const stackWidth = stack.clientWidth;
+      if (!stackWidth) return;
+      const currentIndex = Math.round(stack.scrollLeft / stackWidth);
+      const totalViews = stack.children.length;
+
+      // If user swiped back to an earlier index, remove views past currentIndex to save memory
+      if (currentIndex < totalViews - 1) {
+        const viewsToRemove = [];
+        for (let i = totalViews - 1; i > currentIndex; i--) {
+          viewsToRemove.push(stack.children[i]);
+        }
+
+        viewsToRemove.forEach(view => {
+          const triggerEl = viewTriggerMap.get(view);
+          viewTriggerMap.delete(view);
+          view.remove();
+
+          // Focus management: focus the original link when swiping back, without triggering weird scrolls!
+          if (triggerEl && typeof triggerEl.focus === 'function') {
+            triggerEl.focus({ preventScroll: true });
+          }
+        });
+
+        // Sync browser history if URL hash points to a removed view
+        const currentHash = window.location.hash;
+        if (currentIndex === 0 && currentHash && currentHash !== '#' && currentHash !== '#/') {
+          if (window.history.replaceState) {
+            window.history.replaceState(null, '', window.location.pathname + window.location.search);
+          } else {
+            window.location.hash = '';
+          }
+        }
+      } else if (currentIndex === totalViews - 1) {
+        // Settled on current top view: ensure back button has focus if not inside
+        const currentView = stack.children[currentIndex];
+        if (currentView && currentView.dataset.viewId !== 'root') {
+          if (!currentView.contains(document.activeElement)) {
+            const backBtn = currentView.querySelector('.back');
+            backBtn?.focus({ preventScroll: true });
+          }
+        }
+      }
+
+      // Re-render visual state clean
+      renderVisualTransforms();
+    }
+
+    // Scroll listeners: scroll for continuous transform updates + debounce and scrollend for settle
+    let scrollSettleTimer = null;
+    stack.addEventListener('scroll', () => {
+      onStackScroll();
+      clearTimeout(scrollSettleTimer);
+      scrollSettleTimer = setTimeout(handleScrollSettled, 120);
+    }, { passive: true });
+
+    if ('onscrollend' in window) {
+      stack.addEventListener('scrollend', () => {
+        clearTimeout(scrollSettleTimer);
+        handleScrollSettled();
+      });
+    }
+
+    // Navigation: Push a new drill-down view onto the stack
+    function pushView(identifier, triggerEl = null, updateHistory = true, isInstant = false) {
+      const item = findItem(identifier);
+      if (!item) return;
+
+      // Check if view already exists as current top view
+      const lastView = stack.lastElementChild;
+      if (lastView && lastView.dataset.viewId === item.id) {
+        return;
+      }
+
+      // Find or assign trigger element for focus management
+      let sourceTrigger = triggerEl;
+      if (!sourceTrigger) {
+        sourceTrigger = document.querySelector(`a.item[data-item-id="${item.id}"]`) ||
+                        document.querySelector(`a.item[href*="${item.id}"]`);
+      }
+
+      const view = createViewElement(item);
+      if (sourceTrigger) {
+        viewTriggerMap.set(view, sourceTrigger);
+      }
+
+      stack.appendChild(view);
+
+      if (updateHistory) {
+        history.pushState({ viewId: item.id, inStack: true }, '', `#/view/${item.id}`);
+      }
+
+      const targetIndex = stack.children.length - 1;
+      const targetLeft = targetIndex * stack.clientWidth;
+      const backBtn = view.querySelector('.back');
+      const prefersReduced = getPrefersReducedMotion();
+
+      if (isInstant || prefersReduced) {
+        stack.scrollTo({ left: targetLeft, behavior: 'instant' });
+        renderVisualTransforms();
+        backBtn?.focus({ preventScroll: true });
+      } else {
+        stack.scrollTo({ left: targetLeft, behavior: 'smooth' });
+        setTimeout(() => {
+          backBtn?.focus({ preventScroll: true });
+        }, 320);
+      }
+    }
+
+    // Explicit Back Button Handler
+    function handleBackAction() {
+      const currentIndex = Math.round(stack.scrollLeft / stack.clientWidth);
+      if (currentIndex > 0) {
+        const prefersReduced = getPrefersReducedMotion();
+
+        // If history was pushed in this session, use history.back() to keep history stack clean
+        if (window.history.state && window.history.state.inStack) {
+          window.history.back();
+        } else {
+          // If direct deep link or no history state, scroll back to root
+          const targetLeft = (currentIndex - 1) * stack.clientWidth;
+          if (prefersReduced) {
+            stack.scrollTo({ left: targetLeft, behavior: 'instant' });
+            handleScrollSettled();
+          } else {
+            stack.scrollTo({ left: targetLeft, behavior: 'smooth' });
+          }
+
+          if (window.history.replaceState) {
+            window.history.replaceState(null, '', window.location.pathname + window.location.search);
+          } else {
+            window.location.hash = '';
+          }
+        }
+      }
+    }
+
+    // Intercept clicks on links
+    document.addEventListener('click', (e) => {
+      // 1. Back button click
+      const backBtn = e.target.closest('.back');
+      if (backBtn) {
+        e.preventDefault();
+        handleBackAction();
+        return;
+      }
+
+      // 2. Seasonal details links click
+      const itemLink = e.target.closest('a.item');
+      if (!itemLink) return;
+
+      // Preserve modifier clicks (Cmd, Ctrl, Shift, Alt) so users can open in new tabs/windows
+      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
+        return;
+      }
+
+      // Preserve non-primary mouse clicks (e.g. right click)
+      if (e.button !== 0) {
+        return;
+      }
+
+      // Primary click without modifiers: handle via smooth card navigation
+      e.preventDefault();
+      const href = itemLink.getAttribute('href') || '';
+      const match = href.match(/^#\/view\/([^\/?#]+)/);
+      const viewId = match ? match[1] : (itemLink.dataset.itemId || '1');
+
+      pushView(viewId, itemLink, true);
+    });
+
+    // Middle-click (auxclick with button 1) should natively open in new tab
+    document.addEventListener('auxclick', (e) => {
+      const itemLink = e.target.closest('a.item');
+      if (itemLink && e.button === 1) {
+        // Allow native browser middle-click to proceed without calling preventDefault
+      }
+    });
+
+    // Keyboard accessibility: Escape key to go back
+    window.addEventListener('keydown', (e) => {
+      if (e.key === 'Escape' && stack.children.length > 1) {
+        handleBackAction();
+      }
+    });
+
+    // History popstate listener for back/forward buttons & deep linking transitions
+    window.addEventListener('popstate', (e) => {
+      const hash = window.location.hash;
+      const match = hash.match(/^#\/view\/([^\/?#]+)/);
+      const targetViewId = match ? match[1] : null;
+
+      const currentView = stack.children[stack.children.length - 1];
+      const currentViewId = currentView ? currentView.dataset.viewId : 'root';
+
+      if (targetViewId) {
+        const item = findItem(targetViewId);
+        if (item && currentViewId !== item.id) {
+          pushView(item.id, null, false);
+        }
+      } else {
+        // Going back to root view
+        if (stack.children.length > 1) {
+          const prefersReduced = getPrefersReducedMotion();
+          stack.scrollTo({ left: 0, behavior: prefersReduced ? 'instant' : 'smooth' });
+          if (prefersReduced) {
+            handleScrollSettled();
+          }
+        }
+      }
+    });
+
+    // Deep linking on initial load:
+    // If opening e.g. #/view/1 directly, root view is at index 0 and view 1 is synthesized at index 1!
+    function handleInitialRoute() {
+      const hash = window.location.hash;
+      const match = hash.match(/^#\/view\/([^\/?#]+)/);
+      if (match) {
+        const item = findItem(match[1]);
+        if (item) {
+          pushView(item.id, null, false, true);
+        }
+      }
+    }
+
+    // Window resize / orientation change handling
+    let lastWidth = window.innerWidth;
+    window.addEventListener('resize', () => {
+      const currentIdx = Math.round(stack.scrollLeft / lastWidth);
+      lastWidth = stack.clientWidth;
+      stack.scrollTo({ left: currentIdx * stack.clientWidth, behavior: 'instant' });
+      renderVisualTransforms();
+    });
+
+    // Initialize
+    handleInitialRoute();
+    renderVisualTransforms();
+  </script>
 </body>
 
 </html>
