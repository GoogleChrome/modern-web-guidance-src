+  <script>
+    (function () {
+      function initRoastSelector() {
+        const customDropdown = document.getElementById('roast-selector');
+        const trigger = document.getElementById('roast-trigger');
+        const selectedText = document.getElementById('selected-roast');
+        const dropdownList = document.getElementById('dropdown-list');
+        if (!customDropdown || !trigger || !dropdownList) return;
+
+        const items = Array.from(dropdownList.querySelectorAll('.dropdown-item'));
+        const nativeSelect = document.getElementById('roast-select');
+
+        function openDropdown() {
+          customDropdown.classList.add('open');
+          trigger.setAttribute('aria-expanded', 'true');
+          const selectedItem = dropdownList.querySelector('.dropdown-item.selected');
+          if (selectedItem) {
+            selectedItem.focus();
+          }
+        }
+
+        function closeDropdown() {
+          customDropdown.classList.remove('open');
+          trigger.setAttribute('aria-expanded', 'false');
+        }
+
+        function toggleDropdown() {
+          if (customDropdown.classList.contains('open')) {
+            closeDropdown();
+          } else {
+            openDropdown();
+          }
+        }
+
+        function selectRoast(value) {
+          items.forEach(item => {
+            const isMatch = item.getAttribute('data-value') === value || item.getAttribute('data-roast') === value;
+            if (isMatch) {
+              item.classList.add('selected');
+              item.setAttribute('aria-selected', 'true');
+              const nameEl = item.querySelector('.roast-name');
+              selectedText.textContent = nameEl ? nameEl.textContent : item.textContent.trim();
+            } else {
+              item.classList.remove('selected');
+              item.setAttribute('aria-selected', 'false');
+            }
+          });
+
+          if (nativeSelect && nativeSelect.value !== value) {
+            nativeSelect.value = value;
+            nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
+          }
+        }
+
+        trigger.addEventListener('click', (e) => {
+          e.stopPropagation();
+          toggleDropdown();
+        });
+
+        trigger.addEventListener('keydown', (e) => {
+          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
+            e.preventDefault();
+            openDropdown();
+          }
+        });
+
+        items.forEach((item, index) => {
+          item.addEventListener('click', (e) => {
+            e.stopPropagation();
+            const val = item.getAttribute('data-value') || item.getAttribute('data-roast');
+            selectRoast(val);
+            closeDropdown();
+            trigger.focus();
+          });
+
+          item.addEventListener('keydown', (e) => {
+            if (e.key === 'ArrowDown') {
+              e.preventDefault();
+              const next = items[(index + 1) % items.length];
+              next.focus();
+            } else if (e.key === 'ArrowUp') {
+              e.preventDefault();
+              const prev = items[(index - 1 + items.length) % items.length];
+              prev.focus();
+            } else if (e.key === 'Enter' || e.key === ' ') {
+              e.preventDefault();
+              const val = item.getAttribute('data-value') || item.getAttribute('data-roast');
+              selectRoast(val);
+              closeDropdown();
+              trigger.focus();
+            } else if (e.key === 'Escape') {
+              e.preventDefault();
+              closeDropdown();
+              trigger.focus();
+            }
+          });
+        });
+
+        document.addEventListener('click', (e) => {
+          if (!customDropdown.contains(e.target)) {
+            closeDropdown();
+          }
+        });
+
+        document.addEventListener('keydown', (e) => {
+          if (e.key === 'Escape' && customDropdown.classList.contains('open')) {
+            closeDropdown();
+            trigger.focus();
+          }
+        });
+
+        if (nativeSelect) {
+          nativeSelect.addEventListener('change', (e) => {
+            selectRoast(e.target.value);
+          });
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initRoastSelector);
+      } else {
+        initRoastSelector();
+      }
+    })();
+  </script>
 </body>
 
