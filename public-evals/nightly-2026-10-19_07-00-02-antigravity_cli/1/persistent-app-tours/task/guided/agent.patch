+  <script>
+    const tourStep = document.getElementById('tour-step');
+    const rewardsLink = document.getElementById('feature');
+    let isTourActive = true;
+
+    if (tourStep) {
+      if (typeof tourStep.showPopover === 'function') {
+        tourStep.showPopover();
+        const closeBtn = tourStep.querySelector('button');
+        if (closeBtn) {
+          closeBtn.focus();
+        }
+      }
+
+      tourStep.addEventListener('toggle', (event) => {
+        if (event.newState === 'closed') {
+          isTourActive = false;
+        }
+      });
+
+      const closeBtn = tourStep.querySelector('button');
+      if (closeBtn) {
+        closeBtn.addEventListener('click', () => {
+          isTourActive = false;
+        });
+      }
+    }
+
+    if (rewardsLink) {
+      rewardsLink.addEventListener('click', (event) => {
+        const isPopoverOpen = tourStep && (
+          (typeof tourStep.matches === 'function' && tourStep.matches(':popover-open')) ||
+          isTourActive
+        );
+        if (isPopoverOpen) {
+          event.preventDefault();
+        }
+      });
+    }
+  </script>
