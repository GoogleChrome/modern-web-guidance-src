+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+  </script>
+
+  <script>
+    let toastSequence = 0;
+
+    function createToast(message = 'added to cart!') {
+      const id = `toast-${++toastSequence}`;
+      const toast = document.createElement('div');
+      toast.id = id;
+      toast.className = 'toast';
+      toast.setAttribute('popover', 'manual');
+      toast.setAttribute('role', 'status');
+      toast.setAttribute('aria-live', 'polite');
+
+      const messageSpan = document.createElement('span');
+      messageSpan.className = 'toast-message';
+      messageSpan.textContent = message;
+
+      const closeButton = document.createElement('button');
+      closeButton.type = 'button';
+      closeButton.className = 'toast-close';
+      closeButton.setAttribute('aria-label', 'Close notification');
+      closeButton.setAttribute('popovertarget', id);
+      closeButton.setAttribute('popovertargetaction', 'hide');
+      closeButton.innerHTML = '&times;';
+
+      toast.appendChild(messageSpan);
+      toast.appendChild(closeButton);
+      document.body.appendChild(toast);
+
+      // Promote to browser top layer
+      if (typeof toast.showPopover === 'function') {
+        toast.showPopover();
+      } else {
+        toast.classList.add(':popover-open');
+      }
+
+      // Automatically disappear after 3 seconds
+      const autoDismissTimer = setTimeout(() => {
+        dismissToast(toast);
+      }, 3000);
+
+      closeButton.addEventListener('click', () => {
+        clearTimeout(autoDismissTimer);
+        dismissToast(toast);
+      });
+
+      // Cleanup element once closed and exit transition completes
+      toast.addEventListener('toggle', (event) => {
+        if (event.newState === 'closed') {
+          clearTimeout(autoDismissTimer);
+          scheduleCleanup(toast);
+        }
+      });
+
+      return toast;
+    }
+
+    function dismissToast(toast) {
+      if (!toast || !toast.isConnected) return;
+      if (typeof toast.hidePopover === 'function') {
+        try {
+          toast.hidePopover();
+        } catch (err) {
+          scheduleCleanup(toast);
+        }
+      } else {
+        toast.classList.remove(':popover-open');
+        scheduleCleanup(toast);
+      }
+    }
+
+    function scheduleCleanup(toast) {
+      let cleaned = false;
+      const cleanup = () => {
+        if (!cleaned) {
+          cleaned = true;
+          if (toast.parentNode) {
+            toast.remove();
+          }
+        }
+      };
+      toast.addEventListener('transitionend', cleanup, { once: true });
+      setTimeout(cleanup, 350);
+    }
+
+    document.addEventListener('DOMContentLoaded', () => {
+      document.addEventListener('click', (event) => {
+        const trigger = event.target.closest('.toast-trigger');
+        if (trigger) {
+          event.preventDefault();
+          createToast('added to cart!');
+        }
+      });
+    });
+  </script>
