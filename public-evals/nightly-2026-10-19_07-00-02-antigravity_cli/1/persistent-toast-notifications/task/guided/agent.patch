+        transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
+        bottom 0.3s cubic-bezier(0.16, 1, 0.3, 1),
+        display 0.3s allow-discrete,
+        overlay 0.3s allow-discrete;
+    }
+
+    /* Allow interaction with rest of page by disabling popover backdrop pointer interception */
+    .toast::backdrop {
+      pointer-events: none;
+      background: transparent;
+    }
+
+    /* Open state combining native :popover-open and polyfill class */
+    .toast:is(:popover-open, .\:popover-open) {
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    /* Entry animation starting state */
+    @starting-style {
+      .toast:is(:popover-open, .\:popover-open) {
+        opacity: 0;
+        transform: translateX(120%);
+      }
+    }
+
+    /* CSS sibling-index() function support when grouped */
