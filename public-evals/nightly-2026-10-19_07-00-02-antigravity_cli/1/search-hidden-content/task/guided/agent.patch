+  <script>
+    // Reveal Coupon logic
+    const couponPanel = document.getElementById('coupon-panel');
+    const revealCouponBtn = document.getElementById('reveal-coupon-btn');
+
+    function revealCoupon() {
+      if (couponPanel && couponPanel.hasAttribute('hidden')) {
+        couponPanel.removeAttribute('hidden');
+      }
+      if (revealCouponBtn) {
+        revealCouponBtn.setAttribute('aria-expanded', 'true');
+        revealCouponBtn.disabled = true;
+        revealCouponBtn.textContent = 'Coupon Revealed';
+      }
+    }
+
+    if (revealCouponBtn) {
+      revealCouponBtn.addEventListener('click', revealCoupon);
+    }
+
+    // Synchronize UI state when content inside coupon panel is found via browser native find-in-page
+    if (couponPanel) {
+      couponPanel.addEventListener('beforematch', revealCoupon);
+    }
+
+    // Fallback for browsers without hidden="until-found" / beforematch support
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      document.querySelectorAll('[hidden="until-found"]').forEach((el) => {
+        el.removeAttribute('hidden');
+        if (el.id === 'coupon-panel' && revealCouponBtn) {
+          revealCouponBtn.setAttribute('aria-expanded', 'true');
+          revealCouponBtn.disabled = true;
+          revealCouponBtn.textContent = 'Coupon Revealed';
+        }
+      });
+    }
+
+    // Mutual exclusivity handler for details.wholesale-tab to support browsers without native details name attribute
+    const wholesaleTabs = document.querySelectorAll('details.wholesale-tab');
+    wholesaleTabs.forEach((tab) => {
+      tab.addEventListener('toggle', () => {
+        if (tab.open) {
+          wholesaleTabs.forEach((otherTab) => {
+            if (otherTab !== tab && otherTab.open) {
+              otherTab.removeAttribute('open');
+            }
+          });
+        }
+      });
+    });
+  </script>
+
