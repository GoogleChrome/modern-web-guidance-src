+      function updateCardStatus(card, status) {
+        if (!card || !status) return;
+        card.dataset.status = status;
+
+        const badge = card.querySelector('.status-badge');
+        if (badge) {
+          badge.className = `status-badge badge-${status}`;
+          badge.textContent = status.charAt(0).toUpperCase() + status.slice(1);
+        }
+
+        const advanceBtn = card.querySelector('.quick-move-btn');
+        if (advanceBtn) {
+          if (status === 'queued') {
+            advanceBtn.textContent = '→';
+            advanceBtn.title = 'Advance to Brewing';
+          } else if (status === 'brewing') {
+            advanceBtn.textContent = '→';
+            advanceBtn.title = 'Advance to Ready';
+          } else if (status === 'ready') {
+            advanceBtn.textContent = '✓';
+            advanceBtn.title = 'Complete order';
+          }
+        }
+      }
+
+      /**
+       * Lightweight count updater: only modifies textContent when value changes
+       * to eliminate unnecessary DOM recalculations
+       */
+      function updateAllColumnCounts() {
+        const columns = document.querySelectorAll('.board-column');
+        for (let i = 0; i < columns.length; i++) {
+          const col = columns[i];
+          const badge = col.querySelector('.order-count-badge');
+          const count = col.querySelectorAll('.card').length;
+          if (badge && badge.textContent !== String(count)) {
+            badge.textContent = count;
+          }
+        }
+      }
+
+      /**
+       * Clears visual drop hints
+       */
+      function clearDropIndicators() {
+        const columns = document.querySelectorAll('.board-column.drag-over');
+        for (let i = 0; i < columns.length; i++) {
+          columns[i].classList.remove('drag-over');
+        }
+
+        const indicators = document.querySelectorAll('.drag-target-before, .drag-target-after');
+        for (let i = 0; i < indicators.length; i++) {
+          indicators[i].classList.remove('drag-target-before', 'drag-target-after');
+        }
+
+        activeDropTarget = null;
+      }
+
+      // Drag event handlers on cards
+      function onCardDragStart(e) {
+        draggedCard = this;
+        window._draggedCard = this;
+
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          const cardId = this.id || this.dataset.orderId || 'card';
+          e.dataTransfer.setData('text/plain', cardId);
+          e.dataTransfer.setData('text/card-id', cardId);
+        }
+
+        // Delay class addition by one frame so browser captures crisp drag preview
+        requestAnimationFrame(() => {
+          if (draggedCard === this) {
+            this.classList.add('dragging');
+          }
+        });
+      }
+
+      function onCardDragEnd(e) {
+        this.classList.remove('dragging');
+        clearDropIndicators();
+        draggedCard = null;
+        window._draggedCard = null;
+      }
+
+      /**
+       * High-performance dragover:
+       * - NEVER loops through all cards in the column (O(1) hit testing via e.target.closest)
+       * - ZERO synchronous forced reflows or DOM mutations on mousemove
+       * - RequestAnimationFrame used for debounced visual indicator updates
+       */
+      function onColumnDragOver(e) {
+        e.preventDefault();
+        if (e.dataTransfer) {
+          e.dataTransfer.dropEffect = 'move';
+        }
+
+        const column = e.currentTarget;
+        if (!column.classList.contains('drag-over')) {
+          column.classList.add('drag-over');
+        }
+
+        // Find target card directly under cursor without querying entire column
+        const targetCard = e.target.closest('.card');
+        if (targetCard && targetCard !== draggedCard && targetCard.parentNode === column) {
+          if (!rafIndicatorId) {
+            rafIndicatorId = requestAnimationFrame(() => {
+              rafIndicatorId = null;
+              if (!draggedCard) return;
+
+              // Read relative position on only the hovered card
+              const rect = targetCard.getBoundingClientRect();
+              const isBefore = (e.clientY - rect.top) < (rect.height / 2);
+
+              if (activeDropTarget !== targetCard || dropPosition !== (isBefore ? 'before' : 'after')) {
+                if (activeDropTarget) {
+                  activeDropTarget.classList.remove('drag-target-before', 'drag-target-after');
+                }
+                activeDropTarget = targetCard;
+                dropPosition = isBefore ? 'before' : 'after';
+                targetCard.classList.add(isBefore ? 'drag-target-before' : 'drag-target-after');
+              }
+            });
+          }
+        } else if (!targetCard && activeDropTarget) {
+          activeDropTarget.classList.remove('drag-target-before', 'drag-target-after');
+          activeDropTarget = null;
+        }
+      }
+
+      function onColumnDragEnter(e) {
+        e.preventDefault();
+        e.currentTarget.classList.add('drag-over');
+      }
+
+      function onColumnDragLeave(e) {
+        const column = e.currentTarget;
+        if (!column.contains(e.relatedTarget)) {
+          column.classList.remove('drag-over');
+        }
+      }
+
+      /**
+       * Drop handler: single contained DOM move, status update, and count sync
+       */
+      function onColumnDrop(e) {
+        e.preventDefault();
+        const column = e.currentTarget || e.target.closest('.board-column');
+        if (!column) return;
+
+        clearDropIndicators();
+
+        let card = draggedCard || window._draggedCard;
+        if (!card && e.dataTransfer) {
+          const id = e.dataTransfer.getData('text/card-id') || e.dataTransfer.getData('text/plain');
+          if (id) {
+            card = document.getElementById(id) || document.querySelector(`[data-order-id="${id}"]`);
+          }
+        }
+
+        if (!card) return;
+
+        const targetCard = e.target.closest('.card');
+        if (targetCard && targetCard !== card && targetCard.parentNode === column) {
+          const rect = targetCard.getBoundingClientRect();
+          const isBefore = (e.clientY - rect.top) < (rect.height / 2);
+          if (isBefore) {
+            column.insertBefore(card, targetCard);
+          } else {
+            column.insertBefore(card, targetCard.nextSibling);
+          }
+        } else {
+          // Append to end of column
+          column.appendChild(card);
+        }
+
+        updateCardStatus(card, column.dataset.status);
+        updateAllColumnCounts();
+      }
+
+      /**
+       * Attach listeners to an order card
+       */
+      function setupCard(card) {
+        card.setAttribute('draggable', 'true');
+        card.addEventListener('dragstart', onCardDragStart);
+        card.addEventListener('dragend', onCardDragEnd);
+      }
+
+      /**
+       * Factory for creating order card DOM elements
+       */
+      function createOrderCard(data) {
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.id = data.id || `order-${Date.now()}-${Math.floor(Math.random() * 1000)}`;
+        card.dataset.orderId = data.orderId || data.id || '';
+        card.dataset.status = data.status || 'queued';
+        card.draggable = true;
+
+        const statusName = (data.status || 'queued').charAt(0).toUpperCase() + (data.status || 'queued').slice(1);
+        const orderNum = data.orderNumber || data.id || String(Math.floor(Math.random() * 800) + 100);
+        const timeStr = data.time || 'Just now';
+
+        card.innerHTML = `
+          <div class="card-top">
+            <span class="order-id">#${orderNum}</span>
+            <span class="order-time">${timeStr}</span>
+          </div>
+          <h3 class="card-title">${data.name}</h3>
+          <p class="card-details">${data.details || ''}</p>
+          <div class="card-footer">
+            <span class="customer-tag">👤 ${data.customer || 'Guest'}</span>
+            <span class="status-badge badge-${data.status || 'queued'}">${statusName}</span>
+            <button class="quick-move-btn" type="button" title="Advance order" onclick="window.baristaBoard.advanceCard(this.closest('.card'))">→</button>
+          </div>
+        `;
+
+        setupCard(card);
+        return card;
+      }
+
+      /**
+       * Optimized batch addition using DocumentFragment
+       * This ensures 1,000 orders can be rendered in a single reflow!
+       */
+      function batchAddOrders(ordersArray, defaultStatus = 'queued') {
+        const grouped = {};
+        for (let i = 0; i < ordersArray.length; i++) {
+          const item = ordersArray[i];
+          const st = item.status || defaultStatus;
+          if (!grouped[st]) grouped[st] = [];
+          grouped[st].push(item);
+        }
+
+        for (const st in grouped) {
+          const col = document.querySelector(`.board-column.${st}`) || document.getElementById(st);
+          if (!col) continue;
+
+          const fragment = document.createDocumentFragment();
+          const items = grouped[st];
+          for (let j = 0; j < items.length; j++) {
+            fragment.appendChild(createOrderCard(items[j]));
+          }
+          col.appendChild(fragment);
+        }
+
+        updateAllColumnCounts();
+      }
+
+      // Initialize columns
+      const columns = document.querySelectorAll('.board-column');
+      columns.forEach(col => {
+        col.addEventListener('dragover', onColumnDragOver);
+        col.addEventListener('dragenter', onColumnDragEnter);
+        col.addEventListener('dragleave', onColumnDragLeave);
+        col.addEventListener('drop', onColumnDrop);
+      });
+
+      // Initialize initial cards
+      document.querySelectorAll('.card').forEach(setupCard);
+      updateAllColumnCounts();
+
+      // Delegated capture fallback for dynamically created cards
+      document.addEventListener('dragstart', function (e) {
+        const card = e.target.closest('.card');
+        if (card) {
+          draggedCard = card;
+          window._draggedCard = card;
+          if (e.dataTransfer) {
+            e.dataTransfer.effectAllowed = 'move';
+            const cardId = card.id || card.dataset.orderId || 'card';
+            e.dataTransfer.setData('text/plain', cardId);
+            e.dataTransfer.setData('text/card-id', cardId);
+          }
+          requestAnimationFrame(() => {
+            if (draggedCard === card) {
+              card.classList.add('dragging');
+            }
+          });
+        }
+      }, true);
+
+      document.addEventListener('dragend', function (e) {
+        const card = e.target.closest('.card');
+        if (card) {
+          card.classList.remove('dragging');
+          clearDropIndicators();
+          draggedCard = null;
+          window._draggedCard = null;
+        }
+      }, true);
+
+      // Stress test benchmark
+      function runStressTest(count = 100) {
+        const drinks = [
+          { name: 'Maple Oat Latte', details: 'Creamy oat milk with a hint of Vermont maple syrup.' },
+          { name: 'Dark Roast Espresso', details: 'Bold, smokey, and perfect for a morning boost.' },
+          { name: 'Cold Brew', details: 'Steeped for 18 hours for maximum smoothness.' },
+          { name: 'Caramel Macchiato', details: 'Vanilla syrup, steamed milk, espresso and caramel drizzle.' },
+          { name: 'Vanilla Flat White', details: 'Micro-foamed whole milk over double ristretto espresso.' },
+          { name: 'Iced Matcha Latte', details: 'Ceremonial grade Japanese green tea over oat milk and ice.' }
+        ];
+        const customers = ['Alex M.', 'Jordan T.', 'Sam R.', 'Morgan P.', 'Taylor K.', 'Riley C.', 'Jamie W.', 'Casey D.'];
+        const statuses = ['queued', 'brewing', 'ready'];
+
+        const orders = [];
+        const baseNum = Math.floor(Math.random() * 800) + 120;
+        for (let i = 0; i < count; i++) {
+          const d = drinks[i % drinks.length];
+          const cust = customers[i % customers.length];
+          const st = statuses[i % 3];
+          orders.push({
+            id: `order-stress-${Date.now()}-${i}`,
+            orderNumber: baseNum + i,
+            name: d.name,
+            details: d.details,
+            customer: cust,
+            status: st,
+            time: `${Math.floor(Math.random() * 15) + 1}m ago`
+          });
+        }
+
+        const t0 = performance.now();
+        batchAddOrders(orders);
+        const t1 = performance.now();
+
+        const badge = document.getElementById('perf-stats');
+        if (badge) {
+          const totalOrders = document.querySelectorAll('.board-column .card').length;
+          badge.textContent = `⚡ Rendered ${count} orders in ${(t1 - t0).toFixed(1)}ms (${totalOrders} total)`;
+        }
+      }
+
+      // Modal management
+      const modalOverlay = document.getElementById('order-modal-overlay');
+      const addOrderBtn = document.getElementById('add-order-btn');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const cancelBtn = document.getElementById('modal-cancel-btn');
+      const orderForm = document.getElementById('order-form');
+
+      function openModal() {
+        modalOverlay.classList.add('open');
+        document.getElementById('order-customer').focus();
+      }
+
+      function closeModal() {
+        modalOverlay.classList.remove('open');
+        orderForm.reset();
+      }
+
+      if (addOrderBtn) addOrderBtn.addEventListener('click', openModal);
+      if (closeBtn) closeBtn.addEventListener('click', closeModal);
+      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
+      if (modalOverlay) {
+        modalOverlay.addEventListener('click', (e) => {
+          if (e.target === modalOverlay) closeModal();
+        });
+      }
+
+      if (orderForm) {
+        orderForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const drink = document.getElementById('order-drink').value;
+          const customer = document.getElementById('order-customer').value;
+          const details = document.getElementById('order-details').value;
+          const targetStatus = document.getElementById('order-target-column').value;
+
+          batchAddOrders([{
+            name: drink,
+            customer: customer,
+            details: details || 'Standard preparation',
+            status: targetStatus,
+            orderNumber: Math.floor(Math.random() * 800) + 110,
+            time: 'Just now'
+          }], targetStatus);
+
+          closeModal();
+        });
+      }
+
+      // Benchmark button
+      const stressTestBtn = document.getElementById('stress-test-btn');
+      if (stressTestBtn) {
+        stressTestBtn.addEventListener('click', () => runStressTest(100));
+      }
+
+      // Clear ready button
+      const clearReadyBtn = document.getElementById('clear-ready-btn');
+      if (clearReadyBtn) {
+        clearReadyBtn.addEventListener('click', () => {
+          const readyCol = document.querySelector('.board-column.ready') || document.getElementById('ready');
+          if (readyCol) {
+            const readyCards = readyCol.querySelectorAll('.card');
+            readyCards.forEach(c => c.remove());
+            updateAllColumnCounts();
+          }
+        });
+      }
+
+      // Public API on window for programmatic verification and testing
+      window.baristaBoard = {
+        addOrder: function (order) {
+          batchAddOrders([order], order.status || 'queued');
+        },
+        batchAddOrders: batchAddOrders,
+        moveCard: function (cardOrId, targetStatus) {
+          const card = typeof cardOrId === 'string' ?
+            (document.getElementById(cardOrId) || document.querySelector(`[data-order-id="${cardOrId}"]`)) :
+            cardOrId;
+          const targetCol = document.querySelector(`.board-column.${targetStatus}`) || document.getElementById(targetStatus);
+          if (card && targetCol) {
+            targetCol.appendChild(card);
+            updateCardStatus(card, targetStatus);
+            updateAllColumnCounts();
+          }
+        },
+        advanceCard: function (card) {
+          if (!card) return;
+          const currentStatus = card.dataset.status || 'queued';
+          const nextStatus = NEXT_STATUS[currentStatus] || 'queued';
+          if (currentStatus === 'ready') {
+            card.remove();
+            updateAllColumnCounts();
+          } else {
+            this.moveCard(card, nextStatus);
+          }
+        },
+        updateCounts: updateAllColumnCounts,
+        runStressTest: runStressTest
+      };
+
+    })();
+  </script>
 </body>
 
 </html>
