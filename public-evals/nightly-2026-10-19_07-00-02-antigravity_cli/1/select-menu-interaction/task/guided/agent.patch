+  <script>
+    (function () {
+      const orderForm = document.getElementById('order-form');
+      const shopSelect = document.getElementById('local-shop');
+      const orderSuccess = document.getElementById('order-success');
+
+      if (!orderForm || !shopSelect) return;
+
+      let hasInteracted = false;
+
+      const updateValidationState = () => {
+        const isValid = shopSelect.checkValidity();
+        if (!isValid) {
+          shopSelect.setAttribute('aria-invalid', 'true');
+          shopSelect.classList.add('user-invalid-fallback');
+          shopSelect.classList.remove('user-valid-fallback');
+        } else {
+          shopSelect.removeAttribute('aria-invalid');
+          shopSelect.classList.remove('user-invalid-fallback');
+          shopSelect.classList.add('user-valid-fallback');
+        }
+      };
+
+      // Mark interacted on selection change or input
+      shopSelect.addEventListener('change', () => {
+        hasInteracted = true;
+        updateValidationState();
+      });
+
+      shopSelect.addEventListener('input', () => {
+        hasInteracted = true;
+        updateValidationState();
+      });
+
+      shopSelect.addEventListener('pointerdown', () => {
+        hasInteracted = true;
+      });
+
+      shopSelect.addEventListener('keydown', (e) => {
+        if (e.key !== 'Tab') {
+          hasInteracted = true;
+        }
+      });
+
+      // Show validation feedback if user interacted and blurs
+      shopSelect.addEventListener('blur', () => {
+        if (hasInteracted) {
+          updateValidationState();
+        }
+      });
+
+      // Show validation feedback on submit attempt
+      orderForm.addEventListener('submit', (e) => {
+        hasInteracted = true;
+        if (!orderForm.checkValidity()) {
+          e.preventDefault();
+          updateValidationState();
+          shopSelect.focus();
+          return;
+        }
+        e.preventDefault();
+        updateValidationState();
+        if (orderSuccess) {
+          const selectedOption = shopSelect.options[shopSelect.selectedIndex];
+          orderSuccess.textContent = `Shop selected: ${selectedOption.text}. Ready to customize your order!`;
+          orderSuccess.hidden = false;
+          orderSuccess.style.display = 'block';
+        }
+      });
+
+      // Handle standard constraint validation invalid event during submission attempts
+      orderForm.addEventListener('invalid', (e) => {
+        hasInteracted = true;
+        updateValidationState();
+      }, true);
+
+      // Reset state if form is reset
+      orderForm.addEventListener('reset', () => {
+        hasInteracted = false;
+        shopSelect.removeAttribute('aria-invalid');
+        shopSelect.classList.remove('user-invalid-fallback', 'user-valid-fallback');
+        if (orderSuccess) {
+          orderSuccess.hidden = true;
+          orderSuccess.style.display = 'none';
+        }
+      });
+    })();
+  </script>
