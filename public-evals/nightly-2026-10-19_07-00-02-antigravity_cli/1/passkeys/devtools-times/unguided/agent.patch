+import type { APIRoute } from 'astro';
+import { getUserByUsername, createUser, saveChallenge } from '../../../utils/auth-db';
+import { getRpConfig, createRegistrationOptions } from '../../../utils/passkeys';
+
+export const ALL: APIRoute = async ({ request, session }) => {
+  try {
+    let username = '';
+    let displayName = '';
+
+    if (request.method === 'POST') {
+      try {
+        const body = await request.json();
+        username = body.username || '';
+        displayName = body.displayName || body.username || '';
+      } catch {
+        // empty body
+      }
+    } else {
+      const url = new URL(request.url);
+      username = url.searchParams.get('username') || '';
+      displayName = url.searchParams.get('displayName') || username;
+    }
+
+    if (!username.trim()) {
+      return new Response(JSON.stringify({ error: 'Username is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    username = username.trim();
+    let user = await getUserByUsername(username);
+    if (!user) {
+      user = await createUser(username, displayName);
+    }
+
+    const rpConfig = getRpConfig(request);
+    const options = await createRegistrationOptions(user, rpConfig, user.credentials);
+
+    // Save challenge in session and in challenge store
+    await session?.set('currentChallenge', options.challenge);
+    await session?.set('challengeType', 'registration');
+    await session?.set('challengeUserId', user.id);
+    saveChallenge(options.challenge, options.challenge, {
+      userId: user.id,
+      username: user.username,
+      type: 'registration',
+    });
+
+    return new Response(JSON.stringify({ options, userId: user.id }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Error generating registration options:', error);
+    return new Response(JSON.stringify({ error: error.message || 'Server error' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
