diff --git a/src/components/HeaderAuth.tsx b/src/components/HeaderAuth.tsx
new file mode 100644
index 0000000..cd4bffc
--- /dev/null
+++ b/src/components/HeaderAuth.tsx
@@ -0,0 +1,94 @@
+import React, { useState, useEffect } from 'react';
+
+interface User {
+  id: string;
+  username: string;
+  displayName?: string;
+}
+
+interface HeaderAuthProps {
+  initialUser?: User | null;
+  baseUrl: string;
+}
+
+export default function HeaderAuth({ initialUser = null, baseUrl }: HeaderAuthProps) {
+  const [user, setUser] = useState<User | null>(initialUser);
+  const [loading, setLoading] = useState(false);
+
+  // Sync auth state if needed
+  useEffect(() => {
+    const fetchUser = async () => {
+      try {
+        const res = await fetch(`${baseUrl}api/auth/me`);
+        if (res.ok) {
+          const data = await res.json();
+          setUser(data.user);
+        }
+      } catch (err) {
+        // ignore
+      }
+    };
+
+    fetchUser();
+  }, [baseUrl]);
+
+  const handleSignOut = async () => {
+    setLoading(true);
+    try {
+      await fetch(`${baseUrl}api/auth/signout`, { method: 'POST' });
+      setUser(null);
+      window.location.href = baseUrl;
+    } catch (err) {
+      console.error('Sign out error:', err);
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  if (user) {
+    return (
+      <div className="flex items-center space-x-3">
+        <span className="text-xs font-medium text-gray-700 hidden sm:inline">
+          Hi, <span className="font-semibold text-gray-900">{user.displayName || user.username}</span>
+        </span>
+        <a
+          href={`${baseUrl}account`}
+          data-skip-tracking="true"
+          className="bg-gray-900 text-white text-xs font-semibold py-1.5 px-3 rounded whitespace-nowrap hover:bg-gray-800 transition flex items-center gap-1.5"
+        >
+          <svg xmlns="http://www.w3.org/2000/svg" className="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
+            <path fillRule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clipRule="evenodd" />
+          </svg>
+          Passkeys
+        </a>
+        <button
+          onClick={handleSignOut}
+          disabled={loading}
+          data-skip-tracking="true"
+          className="bg-gray-200 text-gray-700 text-xs font-semibold py-1.5 px-3 rounded whitespace-nowrap hover:bg-gray-300 transition disabled:opacity-50"
+        >
+          {loading ? 'Signing out...' : 'Sign out'}
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex items-center space-x-3">
+      <a
+        href={`${baseUrl}signup`}
+        data-skip-tracking="true"
+        className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700 transition"
+      >
+        Sign up
+      </a>
+      <a
+        href={`${baseUrl}signin`}
+        data-skip-tracking="true"
+        className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400 transition"
+      >
+        Sign in
+      </a>
+    </div>
+  );
+}
