+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const sessionUser = await session?.get('user');
+    if (!sessionUser) {
+      return new Response(JSON.stringify({ error: 'Authentication required' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const body = await request.json();
+    const { response, name } = body;
+
+    if (!response) {
+      return new Response(JSON.stringify({ error: 'Missing registration response' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const user = await getUserById(sessionUser.id);
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'User not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const sessionChallenge = await session?.get('currentChallenge');
+    let expectedChallenge = sessionChallenge;
+
+    if (!expectedChallenge) {
+      try {
+        const clientDataJSON = JSON.parse(
+          Buffer.from(response.response.clientDataJSON, 'base64url').toString('utf-8')
+        );
+        const challengeEntry = getChallenge(clientDataJSON.challenge);
+        if (challengeEntry) {
+          expectedChallenge = challengeEntry.challenge;
+        }
+      } catch (e) {
+        // parsing failed
+      }
+    }
+
+    if (!expectedChallenge) {
+      return new Response(JSON.stringify({ error: 'Challenge expired or not found. Please try again.' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const rpConfig = getRpConfig(request);
+    const verification = await verifyRegistration(response, expectedChallenge, rpConfig);
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(JSON.stringify({ error: 'Registration verification failed' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Clean up challenge
+    await session?.set('currentChallenge', undefined);
+    consumeChallenge(expectedChallenge);
+
+    const { credential, credentialDeviceType, credentialBackedUp } = verification.registrationInfo;
+
+    const newCredential = {
+      id: credential.id,
+      publicKey: isoBase64URL.fromBuffer(credential.publicKey),
+      counter: credential.counter,
+      transports: response.response.transports || ['internal'],
+      deviceType: credentialDeviceType,
+      backedUp: credentialBackedUp,
+      name: name?.trim() || `Passkey ${user.credentials.length + 1}`,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+    };
+
+    await addCredential(user.id, newCredential);
+    await session?.set('reauthenticatedAt', Date.now());
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        credential: {
+          id: newCredential.id,
+          name: newCredential.name,
+          deviceType: newCredential.deviceType,
+          backedUp: newCredential.backedUp,
+          transports: newCredential.transports,
+          createdAt: newCredential.createdAt,
+          lastUsedAt: newCredential.lastUsedAt,
