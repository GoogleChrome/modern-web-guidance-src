--- /dev/null
+++ b/src/pages/api/auth/login-options.ts
@@ -0,0 +1,52 @@
+import type { APIRoute } from 'astro';
+import { getUserByUsername, saveChallenge } from '../../../utils/auth-db';
+import { getRpConfig, createAuthenticationOptions } from '../../../utils/passkeys';
+
+export const ALL: APIRoute = async ({ request, session }) => {
+  try {
+    let username = '';
+
+    if (request.method === 'POST') {
+      try {
+        const body = await request.json();
+        username = body.username || '';
+      } catch {
+        // empty body
+      }
+    } else {
+      const url = new URL(request.url);
+      username = url.searchParams.get('username') || '';
+    }
+
+    const rpConfig = getRpConfig(request);
+
+    let allowCredentials = undefined;
+    if (username.trim()) {
+      const user = await getUserByUsername(username.trim());
+      if (user && user.credentials.length > 0) {
+        allowCredentials = user.credentials;
+      }
+    }
+
+    const options = await createAuthenticationOptions(rpConfig, allowCredentials);
+
+    // Save challenge in session and challenge store
+    await session?.set('currentChallenge', options.challenge);
+    await session?.set('challengeType', 'authentication');
+    saveChallenge(options.challenge, options.challenge, {
+      type: 'authentication',
+      username: username.trim() || undefined,
+    });
+
+    return new Response(JSON.stringify({ options }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Error generating login options:', error);
+    return new Response(JSON.stringify({ error: error.message || 'Server error' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
diff --git a/src/pages/api/auth/login-verify.ts b/src/pages/api/auth/login-verify.ts
new file mode 100644
index 0000000..0cf3817
--- /dev/null
+++ b/src/pages/api/auth/login-verify.ts
@@ -0,0 +1,108 @@
+import type { APIRoute } from 'astro';
+import {
+  getUserByCredentialId,
+  updateCredentialCounter,
+  consumeChallenge,
+  getChallenge,
+} from '../../../utils/auth-db';
+import { getRpConfig, verifyAuthentication } from '../../../utils/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { response } = body;
+
+    if (!response || !response.id) {
+      return new Response(JSON.stringify({ error: 'Missing authentication response' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const found = await getUserByCredentialId(response.id);
+    if (!found) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey not found or not registered to any account' }),
+        {
+          status: 401,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const { user, credential } = found;
+
+    // Retrieve expected challenge
+    const sessionChallenge = await session?.get('currentChallenge');
+    let expectedChallenge = sessionChallenge;
+
+    if (!expectedChallenge) {
+      try {
+        const clientDataJSON = JSON.parse(
+          Buffer.from(response.response.clientDataJSON, 'base64url').toString('utf-8')
+        );
+        const challengeEntry = getChallenge(clientDataJSON.challenge);
+        if (challengeEntry) {
+          expectedChallenge = challengeEntry.challenge;
+        }
+      } catch (e) {
+        // parsing failed
+      }
+    }
+
+    if (!expectedChallenge) {
+      return new Response(JSON.stringify({ error: 'Challenge expired or not found. Please try again.' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const rpConfig = getRpConfig(request);
+    const verification = await verifyAuthentication(
+      response,
+      expectedChallenge,
+      credential,
+      rpConfig
+    );
+
+    if (!verification.verified) {
+      return new Response(JSON.stringify({ error: 'Passkey authentication failed' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Clean up challenge
+    await session?.set('currentChallenge', undefined);
+    consumeChallenge(expectedChallenge);
+
+    // Update credential counter
+    await updateCredentialCounter(credential.id, verification.authenticationInfo.newCounter);
+
+    // Establish session
+    const sessionUser = {
+      id: user.id,
+      username: user.username,
+      displayName: user.displayName,
+    };
+    await session?.set('user', sessionUser);
+    await session?.set('reauthenticatedAt', Date.now());
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        user: sessionUser,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (error: any) {
+    console.error('Error in login-verify:', error);
+    return new Response(JSON.stringify({ error: error.message || 'Authentication error' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
