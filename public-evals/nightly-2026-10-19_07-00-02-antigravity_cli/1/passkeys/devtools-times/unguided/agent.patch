+import type { APIRoute } from 'astro';
+import {
+  getUserById,
+  updateCredentialCounter,
+  consumeChallenge,
+  getChallenge,
+} from '../../../../utils/auth-db';
+import { getRpConfig, verifyAuthentication } from '../../../../utils/passkeys';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const sessionUser = await session?.get('user');
+    if (!sessionUser) {
+      return new Response(JSON.stringify({ error: 'Authentication required' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const body = await request.json();
+    const { response } = body;
+
+    if (!response || !response.id) {
+      return new Response(JSON.stringify({ error: 'Missing authentication response' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const user = await getUserById(sessionUser.id);
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'User not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const credential = user.credentials.find(c => c.id === response.id);
+    if (!credential) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey does not belong to the current authenticated account' }),
+        {
+          status: 403,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    // Retrieve expected challenge
+    const sessionChallenge = await session?.get('currentChallenge');
+    let expectedChallenge = sessionChallenge;
+
+    if (!expectedChallenge) {
+      try {
+        const clientDataJSON = JSON.parse(
+          Buffer.from(response.response.clientDataJSON, 'base64url').toString('utf-8')
+        );
+        const challengeEntry = getChallenge(clientDataJSON.challenge);
+        if (challengeEntry) {
+          expectedChallenge = challengeEntry.challenge;
+        }
+      } catch (e) {
+        // parsing failed
+      }
+    }
+
+    if (!expectedChallenge) {
+      return new Response(JSON.stringify({ error: 'Challenge expired or not found. Please try again.' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const rpConfig = getRpConfig(request);
+    const verification = await verifyAuthentication(
+      response,
+      expectedChallenge,
+      credential,
+      rpConfig
+    );
+
+    if (!verification.verified) {
+      return new Response(JSON.stringify({ error: 'Passkey reauthentication failed' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    // Clean up challenge
+    await session?.set('currentChallenge', undefined);
+    consumeChallenge(expectedChallenge);
+
+    // Update credential counter
+    await updateCredentialCounter(credential.id, verification.authenticationInfo.newCounter);
+
+    const reauthTime = Date.now();
+    await session?.set('reauthenticatedAt', reauthTime);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        reauthenticated: true,
+        reauthenticatedAt: reauthTime,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (error: any) {
+    console.error('Error in reauth-verify:', error);
+    return new Response(JSON.stringify({ error: error.message || 'Reauthentication error' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
