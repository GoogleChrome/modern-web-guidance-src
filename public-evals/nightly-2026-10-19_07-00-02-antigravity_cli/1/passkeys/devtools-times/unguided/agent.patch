diff --git a/src/utils/auth-db.ts b/src/utils/auth-db.ts
new file mode 100644
index 0000000..859e312
--- /dev/null
+++ b/src/utils/auth-db.ts
@@ -0,0 +1,234 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+
+export interface StoredCredential {
+  id: string; // base64url credential id
+  publicKey: string; // base64url public key
+  counter: number;
+  transports?: string[];
+  deviceType?: string;
+  backedUp?: boolean;
+  name: string;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+export interface StoredUser {
+  id: string;
+  username: string;
+  displayName: string;
+  passwordHash?: string;
+  salt?: string;
+  credentials: StoredCredential[];
+  createdAt: string;
+}
+
+interface DatabaseSchema {
+  users: StoredUser[];
+}
+
+const DATA_DIR = path.resolve(process.cwd(), 'data');
+const DB_PATH = path.join(DATA_DIR, 'users.json');
+
+// Challenge store with expiration (10 minutes)
+interface ChallengeEntry {
+  challenge: string;
+  metadata?: Record<string, any>;
+  createdAt: number;
+}
+const challengeMap = new Map<string, ChallengeEntry>();
+
+export function saveChallenge(key: string, challenge: string, metadata?: Record<string, any>): void {
+  // Prune expired entries
+  const now = Date.now();
+  for (const [k, entry] of challengeMap.entries()) {
+    if (now - entry.createdAt > 10 * 60 * 1000) {
+      challengeMap.delete(k);
+    }
+  }
+  challengeMap.set(key, { challenge, metadata, createdAt: now });
+}
+
+export function getChallenge(key: string): ChallengeEntry | null {
+  const entry = challengeMap.get(key);
+  if (!entry) return null;
+  if (Date.now() - entry.createdAt > 10 * 60 * 1000) {
+    challengeMap.delete(key);
+    return null;
+  }
+  return entry;
+}
+
+export function consumeChallenge(key: string): ChallengeEntry | null {
+  const entry = getChallenge(key);
+  if (entry) {
+    challengeMap.delete(key);
+  }
+  return entry;
+}
+
+// In-memory cache for fast reads and synchrony
+let memoryDb: DatabaseSchema | null = null;
+
+function ensureDbLoaded(): DatabaseSchema {
+  if (memoryDb) return memoryDb;
+
+  try {
+    if (!fs.existsSync(DATA_DIR)) {
+      fs.mkdirSync(DATA_DIR, { recursive: true });
+    }
+    if (fs.existsSync(DB_PATH)) {
+      const content = fs.readFileSync(DB_PATH, 'utf-8');
+      memoryDb = JSON.parse(content);
+    } else {
+      memoryDb = { users: [] };
+      saveDb(memoryDb);
+    }
+  } catch (err) {
+    console.error('Error loading database:', err);
+    memoryDb = { users: [] };
+  }
+
+  return memoryDb!;
+}
+
+function saveDb(db: DatabaseSchema): void {
+  memoryDb = db;
+  try {
+    if (!fs.existsSync(DATA_DIR)) {
+      fs.mkdirSync(DATA_DIR, { recursive: true });
+    }
+    const tempPath = `${DB_PATH}.tmp.${crypto.randomBytes(4).toString('hex')}`;
+    fs.writeFileSync(tempPath, JSON.stringify(db, null, 2), 'utf-8');
+    fs.renameSync(tempPath, DB_PATH);
+  } catch (err) {
+    console.error('Error writing database:', err);
+  }
+}
+
+function hashPassword(password: string, salt: string): string {
+  return crypto.pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');
+}
+
+export async function getUsers(): Promise<StoredUser[]> {
+  const db = ensureDbLoaded();
+  return db.users;
+}
+
+export async function getUserById(id: string): Promise<StoredUser | null> {
+  const db = ensureDbLoaded();
+  return db.users.find(u => u.id === id) || null;
+}
+
+export async function getUserByUsername(username: string): Promise<StoredUser | null> {
+  const db = ensureDbLoaded();
+  const normalized = username.trim().toLowerCase();
+  return db.users.find(u => u.username.toLowerCase() === normalized) || null;
+}
+
+export async function getUserByCredentialId(credentialId: string): Promise<{ user: StoredUser; credential: StoredCredential } | null> {
+  const db = ensureDbLoaded();
+  for (const user of db.users) {
+    const credential = user.credentials.find(c => c.id === credentialId);
+    if (credential) {
+      return { user, credential };
+    }
+  }
+  return null;
+}
+
+export async function createUser(username: string, displayName?: string, password?: string): Promise<StoredUser> {
+  const db = ensureDbLoaded();
+  const normalized = username.trim().toLowerCase();
+  const existing = db.users.find(u => u.username.toLowerCase() === normalized);
+  if (existing) {
+    return existing;
+  }
+
+  let passwordHash: string | undefined;
+  let salt: string | undefined;
+  if (password) {
+    salt = crypto.randomBytes(16).toString('hex');
+    passwordHash = hashPassword(password, salt);
+  }
+
+  const user: StoredUser = {
+    id: crypto.randomUUID(),
+    username: username.trim(),
+    displayName: displayName?.trim() || username.trim(),
+    passwordHash,
+    salt,
+    credentials: [],
+    createdAt: new Date().toISOString(),
+  };
+
+  db.users.push(user);
+  saveDb(db);
+  return user;
+}
+
+export async function verifyUserPassword(username: string, password: string): Promise<StoredUser | null> {
+  const user = await getUserByUsername(username);
+  if (!user || !user.passwordHash || !user.salt) return null;
+  const hash = hashPassword(password, user.salt);
+  if (crypto.timingSafeEqual(Buffer.from(user.passwordHash, 'hex'), Buffer.from(hash, 'hex'))) {
+    return user;
+  }
+  return null;
+}
+
+export async function addCredential(userId: string, credential: StoredCredential): Promise<StoredCredential> {
+  const db = ensureDbLoaded();
+  const user = db.users.find(u => u.id === userId);
+  if (!user) {
+    throw new Error('User not found');
+  }
+
+  // Remove duplicate if credential ID already exists
+  user.credentials = user.credentials.filter(c => c.id !== credential.id);
+  user.credentials.push(credential);
+  saveDb(db);
+  return credential;
+}
+
+export async function updateCredentialName(userId: string, credentialId: string, name: string): Promise<boolean> {
+  const db = ensureDbLoaded();
+  const user = db.users.find(u => u.id === userId);
+  if (!user) return false;
+
+  const cred = user.credentials.find(c => c.id === credentialId);
+  if (!cred) return false;
+
+  cred.name = name.trim();
+  saveDb(db);
+  return true;
+}
+
+export async function updateCredentialCounter(credentialId: string, newCounter: number): Promise<boolean> {
+  const db = ensureDbLoaded();
+  for (const user of db.users) {
+    const cred = user.credentials.find(c => c.id === credentialId);
+    if (cred) {
+      cred.counter = newCounter;
+      cred.lastUsedAt = new Date().toISOString();
+      saveDb(db);
+      return true;
+    }
+  }
+  return false;
+}
+
+export async function deleteCredential(userId: string, credentialId: string): Promise<boolean> {
+  const db = ensureDbLoaded();
+  const user = db.users.find(u => u.id === userId);
+  if (!user) return false;
+
+  const originalLength = user.credentials.length;
+  user.credentials = user.credentials.filter(c => c.id !== credentialId);
+  if (user.credentials.length !== originalLength) {
+    saveDb(db);
+    return true;
+  }
+  return false;
+}
