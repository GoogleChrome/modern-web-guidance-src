+import type { APIRoute } from 'astro';
+import { createUser, getUserByUsername } from '../../../utils/auth-db';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const { username, password } = await request.json();
+
+    if (!username || !password) {
+      return new Response(
+        JSON.stringify({ error: 'APP_ERR_1001', message: 'Missing credentials' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (password.length < 8 || !/\d/.test(password)) {
+      return new Response(
+        JSON.stringify({
+          error: 'APP_ERR_1002',
+          message: 'Password must be at least 8 characters and contain a number',
+        }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const existing = await getUserByUsername(username);
+    if (existing && (existing.passwordHash || existing.credentials.length > 0)) {
+      return new Response(
+        JSON.stringify({ error: 'APP_ERR_1003', message: 'Username is already taken' }),
+        { status: 409, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const user = await createUser(username, username, password);
+
+    const sessionUser = {
+      id: user.id,
+      username: user.username,
+      displayName: user.displayName,
+    };
+    await session?.set('user', sessionUser);
+    await session?.set('reauthenticatedAt', Date.now());
+
+    return new Response(
+      JSON.stringify({
+        message: 'User registered successfully',
+        user: sessionUser,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    console.error('Error in register:', error);
+    return new Response(JSON.stringify({ error: error.message || 'Server error' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
