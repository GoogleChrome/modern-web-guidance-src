diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..49e540b
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,532 @@
+import React, { useState, useEffect } from 'react';
+import {
+  startRegistration,
+  startAuthentication,
+  browserSupportsWebAuthn,
+} from '@simplewebauthn/browser';
+import PasskeyIcon from './PasskeyIcon';
+
+interface PasskeyItem {
+  id: string;
+  name: string;
+  deviceType: string;
+  backedUp: boolean;
+  transports: string[];
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+interface UserProfile {
+  id: string;
+  username: string;
+  displayName: string;
+  createdAt: string;
+  passkeyCount: number;
+}
+
+export default function PasskeyManagement({ baseUrl }: { baseUrl: string }) {
+  const [user, setUser] = useState<UserProfile | null>(null);
+  const [passkeys, setPasskeys] = useState<PasskeyItem[]>([]);
+  const [reauthenticated, setReauthenticated] = useState(false);
+  const [reauthenticatedAt, setReauthenticatedAt] = useState<number | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [actionLoading, setActionLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+
+  // Add passkey dialog state
+  const [showAddModal, setShowAddModal] = useState(false);
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+
+  // Rename passkey dialog state
+  const [editingPasskey, setEditingPasskey] = useState<PasskeyItem | null>(null);
+  const [editName, setEditName] = useState('');
+
+  // Delete passkey target
+  const [deletingPasskey, setDeletingPasskey] = useState<PasskeyItem | null>(null);
+
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const fetchStatus = async () => {
+    try {
+      setLoading(true);
+      const [meRes, passkeysRes] = await Promise.all([
+        fetch(`${normalizedBase}api/auth/me`),
+        fetch(`${normalizedBase}api/auth/passkeys`),
+      ]);
+
+      if (meRes.ok) {
+        const meData = await meRes.json();
+        if (!meData.user) {
+          window.location.href = `${normalizedBase}signin`;
+          return;
+        }
+        setUser(meData.user);
+        setReauthenticated(Boolean(meData.reauthenticated));
+        setReauthenticatedAt(meData.reauthenticatedAt);
+      }
+
+      if (passkeysRes.ok) {
+        const passkeysData = await passkeysRes.json();
+        setPasskeys(passkeysData.passkeys || []);
+      }
+    } catch (err: any) {
+      setError('Failed to load passkey management data');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  useEffect(() => {
+    fetchStatus();
+  }, [normalizedBase]);
+
+  // Handle Reauthentication
+  const handleReauthenticate = async (): Promise<boolean> => {
+    setError(null);
+    setSuccess(null);
+    setActionLoading(true);
+
+    try {
+      // 1. Get reauth options
+      const optRes = await fetch(`${normalizedBase}api/auth/reauth/options`, {
+        method: 'POST',
+      });
+      const optData = await optRes.json();
+      if (!optRes.ok || !optData.options) {
+        throw new Error(optData.error || 'Failed to initialize reauthentication');
+      }
+
+      // 2. Perform WebAuthn assertion
+      const authResp = await startAuthentication({
+        optionsJSON: optData.options,
+      });
+
+      // 3. Verify reauth assertion
+      const verifyRes = await fetch(`${normalizedBase}api/auth/reauth/verify`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ response: authResp }),
+      });
+
+      const verifyData = await verifyRes.json();
+      if (!verifyRes.ok || !verifyData.verified) {
+        throw new Error(verifyData.error || 'Reauthentication failed');
+      }
+
+      setReauthenticated(true);
+      setReauthenticatedAt(verifyData.reauthenticatedAt || Date.now());
+      setSuccess('Identity verified successfully! Reauthentication active.');
+      return true;
+    } catch (err: any) {
+      if (err.name === 'NotAllowedError') {
+        setError('Reauthentication cancelled or timed out.');
+      } else {
+        setError(err.message || 'Reauthentication failed');
+      }
+      return false;
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Handle Adding New Passkey
+  const handleAddPasskey = async (e?: React.FormEvent) => {
+    if (e) e.preventDefault();
+    setError(null);
+    setSuccess(null);
+    setActionLoading(true);
+
+    try {
+      // 1. Get register options for existing user
+      const optRes = await fetch(`${normalizedBase}api/auth/passkeys/register-options`, {
+        method: 'POST',
+      });
+      const optData = await optRes.json();
+      if (!optRes.ok || !optData.options) {
+        throw new Error(optData.error || 'Failed to initialize passkey creation');
+      }
+
+      // 2. Invoke WebAuthn registration
+      const attResp = await startRegistration({
+        optionsJSON: optData.options,
+      });
+
+      // 3. Verify on server
+      const verifyRes = await fetch(`${normalizedBase}api/auth/passkeys/register-verify`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          response: attResp,
+          name: newPasskeyName.trim() || undefined,
+        }),
+      });
+
+      const verifyData = await verifyRes.json();
+      if (!verifyRes.ok || !verifyData.verified) {
+        throw new Error(verifyData.error || 'Failed to register passkey');
+      }
+
+      setShowAddModal(false);
+      setNewPasskeyName('');
+      setSuccess('New passkey added successfully!');
+      setReauthenticated(true);
+      setReauthenticatedAt(Date.now());
+      await fetchStatus();
+    } catch (err: any) {
+      if (err.name === 'NotAllowedError') {
+        setError('Passkey registration cancelled or timed out.');
+      } else {
+        setError(err.message || 'Failed to add passkey');
+      }
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Handle Renaming Passkey
+  const handleRenamePasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!editingPasskey || !editName.trim()) return;
+
+    setError(null);
+    setSuccess(null);
+    setActionLoading(true);
+
+    try {
+      const res = await fetch(`${normalizedBase}api/auth/passkeys/${editingPasskey.id}`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ name: editName.trim() }),
+      });
+
+      const data = await res.json();
+      if (!res.ok) {
+        throw new Error(data.error || 'Failed to rename passkey');
+      }
+
+      setPasskeys(prev =>
+        prev.map(p => (p.id === editingPasskey.id ? { ...p, name: editName.trim() } : p))
+      );
+      setEditingPasskey(null);
+      setEditName('');
+      setSuccess('Passkey renamed successfully!');
+    } catch (err: any) {
+      setError(err.message || 'Failed to rename passkey');
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  // Handle Deleting Passkey with Reauthentication check
+  const handleDeletePasskey = async (passkey: PasskeyItem) => {
+    setError(null);
+    setSuccess(null);
+
+    // If reauthentication is needed, prompt user to reauthenticate first
+    let isFresh = reauthenticated && reauthenticatedAt && Date.now() - reauthenticatedAt < 5 * 60 * 1000;
+    if (!isFresh) {
+      const confirmed = window.confirm(
+        `Deleting a passkey is a sensitive security action. Please confirm to verify your identity with your passkey first.`
+      );
+      if (!confirmed) return;
+
+      const reauthSuccess = await handleReauthenticate();
+      if (!reauthSuccess) {
+        setError('Reauthentication is required to delete a passkey.');
+        return;
+      }
+    }
+
+    setActionLoading(true);
+    try {
+      const res = await fetch(`${normalizedBase}api/auth/passkeys/${passkey.id}`, {
+        method: 'DELETE',
+      });
+
+      const data = await res.json();
+      if (!res.ok) {
+        if (data.requireReauth) {
+          setError('Reauthentication required: please verify your passkey first.');
+          setReauthenticated(false);
+        } else {
+          throw new Error(data.error || 'Failed to delete passkey');
+        }
+        return;
+      }
+
+      setPasskeys(prev => prev.filter(p => p.id !== passkey.id));
+      setDeletingPasskey(null);
+      setSuccess(`Passkey "${passkey.name}" has been removed.`);
+    } catch (err: any) {
+      setError(err.message || 'Failed to delete passkey');
+    } finally {
+      setActionLoading(false);
+    }
+  };
+
+  if (loading) {
+    return (
+      <div className="max-w-4xl mx-auto my-12 p-8 text-center text-gray-500">
+        <div className="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900 mb-4"></div>
+        <p>Loading passkey settings...</p>
+      </div>
+    );
+  }
+
+  const isReauthFresh =
+    reauthenticated && reauthenticatedAt && Date.now() - reauthenticatedAt < 5 * 60 * 1000;
+
+  return (
+    <div className="max-w-4xl mx-auto my-8 px-4 sm:px-6">
+      {/* Page Header */}
+      <div className="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-gray-200 gap-4">
+        <div>
+          <h1 className="text-3xl font-bold text-gray-900 tracking-tight">Security & Passkeys</h1>
+          <p className="text-sm text-gray-500 mt-1">
+            Manage your biometric passkeys and reauthenticate for sensitive operations.
+          </p>
+        </div>
+        <button
+          onClick={() => {
+            setNewPasskeyName('');
+            setShowAddModal(true);
+          }}
+          disabled={actionLoading}
+          className="inline-flex items-center justify-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg shadow-sm transition"
+        >
+          <PasskeyIcon className="w-4 h-4" />
+          Add New Passkey
+        </button>
+      </div>
+
+      {/* Notifications */}
+      {error && (
+        <div className="mt-4 p-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg flex items-center justify-between">
+          <span>{error}</span>
+          <button onClick={() => setError(null)} className="text-red-500 hover:text-red-700 font-bold ml-2">×</button>
+        </div>
+      )}
+
+      {success && (
+        <div className="mt-4 p-4 text-sm text-green-800 bg-green-50 border border-green-200 rounded-lg flex items-center justify-between">
+          <span>{success}</span>
+          <button onClick={() => setSuccess(null)} className="text-green-600 hover:text-green-800 font-bold ml-2">×</button>
+        </div>
+      )}
+
+      {/* Reauthentication / Step-Up Security Status */}
+      <div className="mt-6 bg-gray-50 border border-gray-200 rounded-xl p-5">
+        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
+          <div className="flex items-start sm:items-center gap-3">
+            <div className={`p-2.5 rounded-full ${isReauthFresh ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700'}`}>
+              <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
+                <path fillRule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clipRule="evenodd" />
+              </svg>
+            </div>
+            <div>
+              <div className="flex items-center gap-2">
+                <h3 className="font-semibold text-gray-900 text-sm">Step-Up Authentication Status</h3>
+                <span className={`text-xs px-2 py-0.5 rounded-full font-medium ${isReauthFresh ? 'bg-green-100 text-green-800' : 'bg-amber-100 text-amber-800'}`}>
+                  {isReauthFresh ? 'Identity Verified' : 'Reauthentication Required'}
+                </span>
+              </div>
+              <p className="text-xs text-gray-500 mt-0.5">
+                {isReauthFresh
+                  ? `Reauthenticated at ${new Date(reauthenticatedAt!).toLocaleTimeString()} (Active session valid for sensitive modifications)`
+                  : 'Verify your passkey to authorize sensitive actions like credential removal.'}
+              </p>
+            </div>
+          </div>
+          <button
+            onClick={() => handleReauthenticate()}
+            disabled={actionLoading}
+            className="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 border border-gray-300 shadow-sm text-xs font-medium rounded-lg text-gray-700 bg-white hover:bg-gray-50 transition whitespace-nowrap disabled:opacity-50"
+          >
+            <PasskeyIcon className="w-3.5 h-3.5 text-blue-600" />
+            {actionLoading ? 'Verifying...' : 'Reauthenticate with Passkey'}
+          </button>
+        </div>
+      </div>
+
+      {/* Passkeys List */}
+      <div className="mt-8">
+        <h2 className="text-lg font-bold text-gray-900 mb-3">Registered Passkeys ({passkeys.length})</h2>
+
+        {passkeys.length === 0 ? (
+          <div className="border border-dashed border-gray-300 rounded-xl p-8 text-center bg-white">
+            <div className="mx-auto w-12 h-12 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mb-3">
+              <PasskeyIcon className="w-6 h-6" />
+            </div>
+            <h3 className="text-sm font-semibold text-gray-900">No passkeys registered yet</h3>
+            <p className="text-xs text-gray-500 mt-1 max-w-sm mx-auto">
+              Add a passkey to sign in faster and more securely with your fingerprint, face, or security key.
+            </p>
+            <button
+              onClick={() => {
+                setNewPasskeyName('');
+                setShowAddModal(true);
+              }}
+              className="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-xs font-semibold rounded-lg hover:bg-blue-700 transition"
+            >
+              <PasskeyIcon className="w-3.5 h-3.5" />
+              Register Passkey
+            </button>
+          </div>
+        ) : (
+          <div className="space-y-3">
+            {passkeys.map(passkey => (
+              <div
+                key={passkey.id}
+                className="bg-white border border-gray-200 rounded-xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-sm hover:border-gray-300 transition"
+              >
+                <div className="flex items-start gap-4">
+                  <div className="p-3 bg-blue-50 text-blue-600 rounded-xl flex-shrink-0">
+                    <PasskeyIcon className="w-6 h-6" />
+                  </div>
+                  <div>
+                    <div className="flex items-center gap-2 flex-wrap">
+                      <h4 className="font-semibold text-gray-900 text-sm">{passkey.name}</h4>
+                      {passkey.backedUp && (
+                        <span className="text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded font-medium">
+                          Synced Passkey
+                        </span>
+                      )}
+                      <span className="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded font-medium">
+                        {passkey.deviceType === 'multiDevice' ? 'Multi-device' : 'Single-device'}
+                      </span>
+                    </div>
+
+                    <div className="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
+                      <span>Created: {new Date(passkey.createdAt).toLocaleDateString()}</span>
+                      {passkey.lastUsedAt && (
+                        <span>Last used: {new Date(passkey.lastUsedAt).toLocaleDateString()}</span>
