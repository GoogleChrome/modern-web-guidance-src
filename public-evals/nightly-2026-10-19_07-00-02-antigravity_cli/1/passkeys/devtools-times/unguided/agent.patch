+import type { APIRoute } from 'astro';
+import { getUserById } from '../../../utils/auth-db';
+
+export const GET: APIRoute = async ({ session }) => {
+  try {
+    const sessionUser = await session?.get('user');
+    if (!sessionUser) {
+      return new Response(JSON.stringify({ user: null }), {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const user = await getUserById(sessionUser.id);
+    if (!user) {
+      await session?.set('user', undefined);
+      return new Response(JSON.stringify({ user: null }), {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const reauthAt = await session?.get('reauthenticatedAt');
+    const isReauthenticated =
+      typeof reauthAt === 'number' && Date.now() - reauthAt < 5 * 60 * 1000;
+
+    return new Response(
+      JSON.stringify({
+        user: {
+          id: user.id,
+          username: user.username,
+          displayName: user.displayName,
+          createdAt: user.createdAt,
+          passkeyCount: user.credentials.length,
+        },
+        reauthenticated: Boolean(isReauthenticated),
+        reauthenticatedAt: reauthAt || null,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (error: any) {
+    console.error('Error in /api/auth/me:', error);
+    return new Response(JSON.stringify({ error: error.message || 'Server error' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
