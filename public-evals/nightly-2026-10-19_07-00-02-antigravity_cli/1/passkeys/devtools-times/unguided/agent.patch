+import type { APIRoute } from 'astro';
+import { getUserById, saveChallenge } from '../../../../utils/auth-db';
+import { getRpConfig, createRegistrationOptions } from '../../../../utils/passkeys';
+
+export const ALL: APIRoute = async ({ request, session }) => {
+  try {
+    const sessionUser = await session?.get('user');
+    if (!sessionUser) {
+      return new Response(JSON.stringify({ error: 'Authentication required' }), {
+        status: 401,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const user = await getUserById(sessionUser.id);
+    if (!user) {
+      return new Response(JSON.stringify({ error: 'User not found' }), {
+        status: 404,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const rpConfig = getRpConfig(request);
+    // Exclude existing credentials so user doesn't register the same key twice
+    const options = await createRegistrationOptions(user, rpConfig, user.credentials);
+
+    await session?.set('currentChallenge', options.challenge);
+    await session?.set('challengeType', 'registration');
+    await session?.set('challengeUserId', user.id);
+    saveChallenge(options.challenge, options.challenge, {
+      userId: user.id,
+      username: user.username,
+      type: 'registration',
+    });
+
+    return new Response(JSON.stringify({ options }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error: any) {
+    console.error('Error generating register options for existing user:', error);
