@@ -0,0 +1,53 @@
+import type { APIRoute } from 'astro';
+import { verifyUserPassword, getUserByUsername } from '../../../utils/auth-db';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const { username, password } = await request.json();
+
+    if (!username || !password) {
+      return new Response(
+        JSON.stringify({ error: 'APP_ERR_1001', message: 'Missing credentials' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const user = await verifyUserPassword(username, password);
+    if (!user) {
+      // Check if user exists without password or invalid credentials
+      const exists = await getUserByUsername(username);
+      if (!exists) {
+        return new Response(
+          JSON.stringify({ error: 'APP_ERR_2001', message: 'User not found' }),
+          { status: 401, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      return new Response(
+        JSON.stringify({ error: 'APP_ERR_2002', message: 'Invalid credentials' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const sessionUser = {
+      id: user.id,
+      username: user.username,
+      displayName: user.displayName,
+    };
+    await session?.set('user', sessionUser);
+    await session?.set('reauthenticatedAt', Date.now());
+
+    return new Response(
+      JSON.stringify({
+        message: 'Login successful',
+        user: sessionUser,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error: any) {
+    console.error('Error in login:', error);
+    return new Response(JSON.stringify({ error: error.message || 'Server error' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
