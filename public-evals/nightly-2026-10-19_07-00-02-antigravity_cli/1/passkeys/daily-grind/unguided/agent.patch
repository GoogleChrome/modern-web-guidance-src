+  text-align: left;
+  border-bottom: 1px solid var(--border);
+}
+
+.passkeys-table th {
+  background: #f5f5f5;
+  color: var(--primary);
+  font-weight: 600;
+  font-size: 0.9rem;
+}
+
+.passkeys-table tr:hover {
+  background: #fdfbf7;
+}
+
+.passkey-icon {
+  display: inline-block;
+  margin-right: 6px;
+}
+
+.passkey-id {
+  font-family: monospace;
+  font-size: 0.8rem;
+  color: #777;
+}
+
+.badge {
+  display: inline-block;
+  padding: 3px 8px;
+  border-radius: 12px;
+  font-size: 0.75rem;
+  font-weight: 600;
+  text-transform: uppercase;
+}
+
+.badge-success {
+  background: var(--success-bg);
+  color: var(--success);
+}
+
+.badge-warning {
