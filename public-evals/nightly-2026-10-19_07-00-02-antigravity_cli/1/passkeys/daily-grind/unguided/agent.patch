+  border: 1px solid #ffcdd2;
+}
+
+.alert-warning {
+  background-color: var(--warning-bg);
+  color: var(--warning);
+  border: 1px solid #ffe0b2;
+}
+
+/* Passkeys List / Table */
+.passkeys-table {
+  width: 100%;
+  border-collapse: collapse;
+  margin-top: 15px;
+}
+
+.passkeys-table th,
+.passkeys-table td {
