+  padding: 5px 12px;
+  border-radius: 4px;
+  color: var(--accent);
+}
+
+.logout-link:hover {
+  background: var(--accent);
+  color: var(--primary-dark) !important;
+}
+
+.nav-user {
+  font-weight: 500;
+  color: var(--secondary);
+  font-size: 0.9rem;
+}
+
+/* Hero Section */
+.hero {
+  min-height: 48vh;
+  background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)),
+    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+  background-size: cover;
+  background-position: center;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 40px 20px;
+}
+
+.hero h1 {
+  font-size: 2.8rem;
+  margin-bottom: 0.8rem;
+}
+
+.hero p {
+  font-size: 1.2rem;
+  max-width: 650px;
+  margin-bottom: 1.5rem;
+  opacity: 0.95;
+}
+
+.hero-actions {
+  display: flex;
+  gap: 15px;
+  flex-wrap: wrap;
+  justify-content: center;
+}
+
+/* Layout & Containers */
+.container {
+  max-width: 1000px;
+  margin: 30px auto;
+  padding: 0 20px;
+  flex: 1;
+}
+
+.card {
+  background: white;
+  padding: 25px;
+  border-radius: 8px;
