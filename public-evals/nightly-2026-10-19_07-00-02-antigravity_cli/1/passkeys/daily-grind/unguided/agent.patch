+++ b/db.js
@@ -0,0 +1,118 @@
+const fs = require('fs');
+const path = require('path');
+
+const DB_FILE = path.join(__dirname, 'data', 'db.json');
+
+class Database {
+  constructor() {
+    this.data = {
+      users: {} // userId -> user object
+    };
+    this.init();
+  }
+
+  init() {
+    const dir = path.dirname(DB_FILE);
+    if (!fs.existsSync(dir)) {
+      fs.mkdirSync(dir, { recursive: true });
+    }
+    if (fs.existsSync(DB_FILE)) {
+      try {
+        const raw = fs.readFileSync(DB_FILE, 'utf8');
+        this.data = JSON.parse(raw);
+        if (!this.data.users) this.data.users = {};
+      } catch (err) {
+        console.error('Error reading db file, initializing empty db:', err);
+        this.data = { users: {} };
+      }
+    } else {
+      this.save();
+    }
+  }
+
+  save() {
+    try {
+      fs.writeFileSync(DB_FILE, JSON.stringify(this.data, null, 2), 'utf8');
+    } catch (err) {
+      console.error('Error saving db:', err);
+    }
+  }
+
+  getAllUsers() {
+    return Object.values(this.data.users);
+  }
+
+  getUserById(id) {
+    return this.data.users[id] || null;
+  }
+
+  getUserByUsername(username) {
+    if (!username) return null;
+    const lower = username.trim().toLowerCase();
+    for (const user of Object.values(this.data.users)) {
+      if (user.username.toLowerCase() === lower) {
+        return user;
+      }
+    }
+    return null;
+  }
+
+  getUserByCredentialId(credentialId) {
+    for (const user of Object.values(this.data.users)) {
+      if (user.credentials && user.credentials.some(c => c.id === credentialId)) {
+        return user;
+      }
+    }
+    return null;
+  }
+
+  createUser({ username, displayName, id }) {
+    const userId = id || `usr_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
+    const user = {
+      id: userId,
+      username: username.trim(),
+      displayName: (displayName && displayName.trim()) || username.trim(),
+      createdAt: new Date().toISOString(),
+      credentials: []
+    };
+    this.data.users[userId] = user;
+    this.save();
+    return user;
+  }
+
+  addCredential(userId, credential) {
+    const user = this.getUserById(userId);
+    if (!user) throw new Error('User not found');
+    if (!user.credentials) user.credentials = [];
+    user.credentials.push(credential);
+    this.save();
+    return credential;
+  }
+
+  updateCredential(userId, credentialId, updates) {
+    const user = this.getUserById(userId);
+    if (!user) throw new Error('User not found');
+    const cred = user.credentials.find(c => c.id === credentialId);
+    if (!cred) throw new Error('Credential not found');
+    Object.assign(cred, updates);
+    this.save();
+    return cred;
+  }
+
+  deleteCredential(userId, credentialId) {
+    const user = this.getUserById(userId);
+    if (!user) throw new Error('User not found');
+    const index = user.credentials.findIndex(c => c.id === credentialId);
+    if (index === -1) throw new Error('Credential not found');
+    user.credentials.splice(index, 1);
+    this.save();
+    return true;
+  }
+
+  getCredentials(userId) {
+    const user = this.getUserById(userId);
+    return user ? (user.credentials || []) : [];
+  }
+}
+
+module.exports = new Database();
