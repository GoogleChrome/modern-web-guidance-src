@@ -0,0 +1,305 @@
+/**
+ * The Daily Grind - Passkey Client Library
+ * Handles Registration, Authentication, Management, and Reauthentication
+ */
+
+const PasskeyApp = {
+  // Check WebAuthn support
+  isSupported() {
+    return window.SimpleWebAuthnBrowser && window.SimpleWebAuthnBrowser.browserSupportsWebAuthn();
+  },
+
+  // Show status / alert message
+  showMessage(elemId, message, type = 'info') {
+    const elem = document.getElementById(elemId);
+    if (!elem) return;
+    elem.textContent = message;
+    elem.className = `alert alert-${type}`;
+    elem.style.display = 'block';
+  },
+
+  clearMessage(elemId) {
+    const elem = document.getElementById(elemId);
+    if (!elem) return;
+    elem.textContent = '';
+    elem.style.display = 'none';
+  },
+
+  // ----------------------------------------------------
+  // 1. REGISTRATION
+  // ----------------------------------------------------
+  async register({ username, displayName, passkeyName }) {
+    if (!this.isSupported()) {
+      throw new Error('WebAuthn / Passkeys are not supported in this browser.');
+    }
+
+    // Step 1: Request registration options from server
+    const optionsRes = await fetch('/api/auth/register-options', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, displayName }),
+    });
+
+    if (!optionsRes.ok) {
+      const err = await optionsRes.json().catch(() => ({}));
+      throw new Error(err.error || 'Failed to get registration options');
+    }
+
+    const options = await optionsRes.json();
+
+    // Step 2: Invoke authenticator via SimpleWebAuthnBrowser
+    let attResp;
+    try {
+      attResp = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: options });
+    } catch (err) {
+      if (err.name === 'InvalidStateError') {
+        throw new Error('A passkey for this device is already registered.');
+      }
+      throw err;
+    }
+
+    // Step 3: Send verification back to server
+    const verifyRes = await fetch('/api/auth/register-verify', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ response: attResp, passkeyName }),
+    });
+
+    if (!verifyRes.ok) {
+      const err = await verifyRes.json().catch(() => ({}));
+      throw new Error(err.error || 'Registration verification failed');
+    }
+
+    return await verifyRes.json();
+  },
+
+  // ----------------------------------------------------
+  // 2. AUTHENTICATION
+  // ----------------------------------------------------
+  async login({ username } = {}) {
+    if (!this.isSupported()) {
+      throw new Error('WebAuthn / Passkeys are not supported in this browser.');
+    }
+
+    // Step 1: Request authentication options from server
+    const optionsRes = await fetch('/api/auth/login-options', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: username || undefined }),
+    });
+
+    if (!optionsRes.ok) {
+      const err = await optionsRes.json().catch(() => ({}));
+      throw new Error(err.error || 'Failed to get login options');
+    }
+
+    const options = await optionsRes.json();
+
+    // Step 2: Invoke authenticator via SimpleWebAuthnBrowser
+    const asseResp = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON: options });
+
+    // Step 3: Send verification back to server
+    const verifyRes = await fetch('/api/auth/login-verify', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ response: asseResp }),
+    });
+
+    if (!verifyRes.ok) {
+      const err = await verifyRes.json().catch(() => ({}));
+      throw new Error(err.error || 'Login verification failed');
+    }
+
+    return await verifyRes.json();
+  },
+
+  // Conditional UI / Autofill Login
+  async initAutofill(onSuccess, onError) {
+    if (!this.isSupported()) return;
+    try {
+      const available = await SimpleWebAuthnBrowser.browserSupportsWebAuthnAutofill();
+      if (!available) return;
+
+      const optionsRes = await fetch('/api/auth/login-options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({}),
+      });
+      if (!optionsRes.ok) return;
+      const options = await optionsRes.json();
+
+      const asseResp = await SimpleWebAuthnBrowser.startAuthentication({
+        optionsJSON: options,
+        useBrowserAutofill: true,
+      });
+
+      const verifyRes = await fetch('/api/auth/login-verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ response: asseResp }),
+      });
+
+      if (verifyRes.ok) {
+        const data = await verifyRes.json();
+        if (onSuccess) onSuccess(data);
+      } else {
+        const err = await verifyRes.json().catch(() => ({}));
+        if (onError) onError(new Error(err.error || 'Autofill login failed'));
+      }
+    } catch (err) {
+      // Don't report abort errors from autofill
+      if (err.name !== 'AbortError' && onError) {
+        console.debug('Passkey autofill not completed:', err.message);
+      }
+    }
+  },
+
+  // ----------------------------------------------------
+  // 3. MANAGEMENT
+  // ----------------------------------------------------
+  async listPasskeys() {
+    const res = await fetch('/api/passkeys');
+    if (!res.ok) {
+      const err = await res.json().catch(() => ({}));
+      throw new Error(err.error || 'Failed to fetch passkeys');
+    }
+    const data = await res.json();
+    return data.passkeys || [];
+  },
+
+  async addPasskey({ passkeyName } = {}) {
+    if (!this.isSupported()) {
+      throw new Error('WebAuthn / Passkeys are not supported in this browser.');
+    }
+
+    const optionsRes = await fetch('/api/passkeys/add-options', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+    });
+
+    if (!optionsRes.ok) {
+      const err = await optionsRes.json().catch(() => ({}));
+      throw new Error(err.error || 'Failed to get registration options');
+    }
+
+    const options = await optionsRes.json();
+    const attResp = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON: options });
+
+    const verifyRes = await fetch('/api/passkeys/add-verify', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ response: attResp, passkeyName }),
+    });
+
+    if (!verifyRes.ok) {
+      const err = await verifyRes.json().catch(() => ({}));
+      throw new Error(err.error || 'Failed to add passkey');
+    }
+
+    return await verifyRes.json();
+  },
+
+  async renamePasskey(id, name) {
+    const res = await fetch(`/api/passkeys/${encodeURIComponent(id)}`, {
+      method: 'PATCH',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ name }),
+    });
+
+    if (!res.ok) {
+      const err = await res.json().catch(() => ({}));
+      throw new Error(err.error || 'Failed to rename passkey');
+    }
+
+    return await res.json();
+  },
+
+  async deletePasskey(id) {
+    const res = await fetch(`/api/passkeys/${encodeURIComponent(id)}`, {
+      method: 'DELETE',
+    });
+
+    if (!res.ok) {
+      const err = await res.json().catch(() => ({}));
+      throw new Error(err.error || 'Failed to delete passkey');
+    }
+
+    return await res.json();
+  },
+
+  // ----------------------------------------------------
+  // 4. REAUTHENTICATION
+  // ----------------------------------------------------
+  async reauthenticate() {
+    if (!this.isSupported()) {
+      throw new Error('WebAuthn / Passkeys are not supported in this browser.');
+    }
+
+    const optionsRes = await fetch('/api/auth/reauth-options', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+    });
+
+    if (!optionsRes.ok) {
+      const err = await optionsRes.json().catch(() => ({}));
+      throw new Error(err.error || 'Failed to get reauthentication options');
+    }
+
+    const options = await optionsRes.json();
+    const asseResp = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON: options });
+
+    const verifyRes = await fetch('/api/auth/reauth-verify', {
+      method: 'POST',
