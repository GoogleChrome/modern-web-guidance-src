+  <script>
+    (function () {
+      const floatingElement = document.getElementById('floating-element');
+      if (!floatingElement) return;
+
+      let isDragging = false;
+      let hasBeenMoved = false;
+      let startX = 0;
+      let startY = 0;
+      let initialLeft = 0;
+      let initialTop = 0;
+
+      // Initialize position in style attributes
+      function initPosition() {
+        if (hasBeenMoved) return;
+        const rect = floatingElement.getBoundingClientRect();
+        if (rect.width > 0 || rect.height > 0) {
+          initialLeft = rect.left;
+          initialTop = rect.top;
+          floatingElement.style.left = initialLeft + 'px';
+          floatingElement.style.top = initialTop + 'px';
+          floatingElement.style.right = 'auto';
+          floatingElement.style.bottom = 'auto';
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initPosition);
+      } else {
+        initPosition();
+      }
+      window.addEventListener('load', initPosition);
+      window.addEventListener('resize', function () {
+        if (!hasBeenMoved && !isDragging) {
+          floatingElement.style.left = '';
+          floatingElement.style.top = '120px';
+          floatingElement.style.right = '24px';
+          floatingElement.style.bottom = 'auto';
+          initPosition();
+        }
+      });
+
+      function shouldIgnoreTarget(target) {
+        return !!(target && target.closest && target.closest('button, a, input, textarea, select'));
+      }
+
+      function startDrag(clientX, clientY, target) {
+        if (shouldIgnoreTarget(target)) return false;
+
+        isDragging = true;
+        hasBeenMoved = true;
+        startX = clientX;
+        startY = clientY;
+
+        const rect = floatingElement.getBoundingClientRect();
+        initialLeft = parseFloat(floatingElement.style.left) || rect.left;
+        initialTop = parseFloat(floatingElement.style.top) || rect.top;
+
+        floatingElement.style.position = 'fixed';
+        floatingElement.style.left = initialLeft + 'px';
+        floatingElement.style.top = initialTop + 'px';
+        floatingElement.style.right = 'auto';
+        floatingElement.style.bottom = 'auto';
+        floatingElement.classList.add('is-dragging');
+        return true;
+      }
+
+      function moveDrag(clientX, clientY) {
+        if (!isDragging) return;
+
+        const deltaX = clientX - startX;
+        const deltaY = clientY - startY;
+
+        let newLeft = initialLeft + deltaX;
+        let newTop = initialTop + deltaY;
+
+        const winWidth = window.innerWidth || document.documentElement.clientWidth || 0;
+        const winHeight = window.innerHeight || document.documentElement.clientHeight || 0;
+        const elWidth = floatingElement.offsetWidth || 0;
+        const elHeight = floatingElement.offsetHeight || 0;
+
+        if (winWidth > 0 && elWidth > 0) {
+          const maxLeft = Math.max(0, winWidth - elWidth);
+          newLeft = Math.max(0, Math.min(newLeft, maxLeft));
+        }
+        if (winHeight > 0 && elHeight > 0) {
+          const maxTop = Math.max(0, winHeight - elHeight);
+          newTop = Math.max(0, Math.min(newTop, maxTop));
+        }
+
+        floatingElement.style.left = newLeft + 'px';
+        floatingElement.style.top = newTop + 'px';
+      }
+
+      function endDrag() {
+        if (!isDragging) return;
+        isDragging = false;
+        floatingElement.classList.remove('is-dragging');
+      }
+
+      // Pointer Events
+      floatingElement.addEventListener('pointerdown', function (e) {
+        if (e.button !== undefined && e.button !== 0) return;
+        if (startDrag(e.clientX, e.clientY, e.target)) {
+          try {
+            floatingElement.setPointerCapture(e.pointerId);
+          } catch (_) {}
+          if (e.cancelable) e.preventDefault();
+        }
+      });
+
+      floatingElement.addEventListener('pointermove', function (e) {
+        if (isDragging) {
+          moveDrag(e.clientX, e.clientY);
+          if (e.cancelable) e.preventDefault();
+        }
+      });
+
+      floatingElement.addEventListener('pointerup', function (e) {
+        if (isDragging) {
+          try {
+            floatingElement.releasePointerCapture(e.pointerId);
+          } catch (_) {}
+          endDrag();
+        }
+      });
+
+      floatingElement.addEventListener('pointercancel', function (e) {
+        if (isDragging) {
+          try {
+            floatingElement.releasePointerCapture(e.pointerId);
+          } catch (_) {}
+          endDrag();
+        }
+      });
+
+      // Mouse Events fallback
+      floatingElement.addEventListener('mousedown', function (e) {
+        if (isDragging) return;
+        if (e.button !== undefined && e.button !== 0) return;
+        if (startDrag(e.clientX, e.clientY, e.target)) {
+          if (e.cancelable) e.preventDefault();
+        }
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (isDragging) {
+          moveDrag(e.clientX, e.clientY);
+        }
+      });
+
+      window.addEventListener('mouseup', function () {
+        if (isDragging) {
+          endDrag();
+        }
+      });
+
+      // Touch Events fallback
+      floatingElement.addEventListener('touchstart', function (e) {
+        if (isDragging) return;
+        if (e.touches && e.touches[0]) {
+          if (startDrag(e.touches[0].clientX, e.touches[0].clientY, e.target)) {
+            if (e.cancelable) e.preventDefault();
+          }
+        }
+      }, { passive: false });
+
+      window.addEventListener('touchmove', function (e) {
+        if (isDragging && e.touches && e.touches[0]) {
+          moveDrag(e.touches[0].clientX, e.touches[0].clientY);
+          if (e.cancelable) e.preventDefault();
+        }
+      }, { passive: false });
+
+      window.addEventListener('touchend', function () {
+        if (isDragging) {
+          endDrag();
+        }
+      });
+
+      // Drag and drop events fallback
+      floatingElement.addEventListener('dragstart', function (e) {
+        if (shouldIgnoreTarget(e.target)) {
+          e.preventDefault();
+          return;
+        }
+        startDrag(e.clientX, e.clientY, e.target);
+        if (e.dataTransfer) {
+          e.dataTransfer.setData('text/plain', 'floating-element');
+          e.dataTransfer.effectAllowed = 'move';
+        }
+      });
+
+      floatingElement.addEventListener('drag', function (e) {
+        if (e.clientX || e.clientY) {
+          moveDrag(e.clientX, e.clientY);
+        }
+      });
+
+      floatingElement.addEventListener('dragend', function (e) {
+        if (e.clientX || e.clientY) {
+          moveDrag(e.clientX, e.clientY);
+        }
+        endDrag();
+      });
+
+      // Button interaction
+      const actionBtn = document.getElementById('floating-action-btn');
+      if (actionBtn) {
+        actionBtn.addEventListener('click', function (e) {
+          e.stopPropagation();
+          actionBtn.textContent = '✓ 20% Discount Applied!';
+          actionBtn.style.backgroundColor = '#66bb6a';
+          actionBtn.style.color = '#ffffff';
+        });
+      }
+    })();
+  </script>
