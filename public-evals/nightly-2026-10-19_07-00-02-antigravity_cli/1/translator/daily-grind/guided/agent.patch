+/**
+ * Translate using offline dictionary and word replacement fallback
+ */
+function translateOfflineFallback(text, sourceLang, targetLang) {
+  const trimmed = text.trim();
+
+  // If source and target are the same, return as is
+  if (sourceLang === targetLang) return text;
+
+  // If target is English and we have an exact match reverse-lookup
+  if (targetLang === 'en') {
+    for (const [enKey, transObj] of Object.entries(OFFLINE_DICTIONARY)) {
+      for (const [lang, val] of Object.entries(transObj)) {
+        if (val.toLowerCase() === trimmed.toLowerCase()) {
+          return enKey;
+        }
+      }
+    }
+  }
+
+  // Direct exact phrase lookup
+  if (OFFLINE_DICTIONARY[trimmed] && OFFLINE_DICTIONARY[trimmed][targetLang]) {
+    return OFFLINE_DICTIONARY[trimmed][targetLang];
+  }
+
+  // Case-insensitive lookup
+  for (const [enKey, transObj] of Object.entries(OFFLINE_DICTIONARY)) {
+    if (enKey.toLowerCase() === trimmed.toLowerCase() && transObj[targetLang]) {
+      return transObj[targetLang];
+    }
+  }
+
+  // Reverse lookup: if source is not English, look for source language match then translate to target
+  for (const [enKey, transObj] of Object.entries(OFFLINE_DICTIONARY)) {
+    if (transObj[sourceLang] && transObj[sourceLang].toLowerCase() === trimmed.toLowerCase()) {
+      if (targetLang === 'en') return enKey;
+      if (transObj[targetLang]) return transObj[targetLang];
+    }
+  }
+
+  // Word-by-word replacement fallback for simple phrases
+  const words = text.split(/(\s+|[.,!?;:])/);
+  let translatedAny = false;
+  const translatedWords = words.map((w) => {
+    const cleanWord = w.toLowerCase().trim();
+    if (!cleanWord) return w;
+
+    // Check word dictionary from English to target
+    if (WORD_DICTIONARY[cleanWord] && WORD_DICTIONARY[cleanWord][targetLang]) {
+      translatedAny = true;
+      const trans = WORD_DICTIONARY[cleanWord][targetLang];
+      // Preserve capitalization
+      if (w[0] === w[0].toUpperCase() && trans.length > 0) {
+        return trans.charAt(0).toUpperCase() + trans.slice(1);
+      }
+      return trans;
+    }
+
+    // Check word dictionary reverse
+    for (const [enWord, transMap] of Object.entries(WORD_DICTIONARY)) {
+      if (transMap[sourceLang] && transMap[sourceLang].toLowerCase() === cleanWord) {
+        translatedAny = true;
+        const targetVal = targetLang === 'en' ? enWord : (transMap[targetLang] || enWord);
+        if (w[0] === w[0].toUpperCase() && targetVal.length > 0) {
+          return targetVal.charAt(0).toUpperCase() + targetVal.slice(1);
+        }
+        return targetVal;
+      }
+    }
+
+    return w;
+  });
+
+  if (translatedAny) {
+    return translatedWords.join('');
+  }
+
+  // Final fallback
+  return text;
+}
