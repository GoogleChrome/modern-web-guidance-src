+ * @param {string} targetLang - BCP 47 language code
+ * @param {function} onProgress - Optional callback for download progress (percentage)
+ * @returns {Promise<{ translatedText: string, detectedLanguage: string, engine: string }>}
+ */
+async function translateText(text, sourceLang = 'auto', targetLang = 'es', onProgress = null) {
+  if (!text || !text.trim()) {
+    return { translatedText: '', detectedLanguage: sourceLang, engine: 'none' };
+  }
+
+  // Resolve source language if 'auto'
+  let resolvedSource = sourceLang;
+  if (!resolvedSource || resolvedSource === 'auto') {
+    resolvedSource = await detectLanguage(text);
+  }
+
+  // If source and target are the same language
+  if (resolvedSource === targetLang) {
+    return { translatedText: text, detectedLanguage: resolvedSource, engine: 'identity' };
+  }
+
+  // Normalize language codes (e.g., 'zh-Hant' vs 'zh')
+  const baseSource = resolvedSource.split('-')[0];
+  const baseTarget = targetLang.split('-')[0];
+
+  // 1. Try On-Device Translator API (Modern Web Guidance compliance)
+  if ('Translator' in self) {
+    const options = {
+      sourceLanguage: resolvedSource,
+      targetLanguage: targetLang
+    };
+
+    try {
+      const availability = await Translator.availability(options);
+
+      if (availability === 'available') {
+        const translator = await Translator.create(options);
+        const result = await translator.translate(text);
+        return {
+          translatedText: result,
+          detectedLanguage: resolvedSource,
+          engine: 'on-device-ai'
+        };
+      } else if (availability === 'downloadable' || availability === 'downloading') {
+        const translator = await Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (onProgress) {
+                const pct = e.total ? Math.round((e.loaded / e.total) * 100) : Math.round(e.loaded * 100);
+                onProgress(pct);
+              }
+            });
+          }
+        });
+        const result = await translator.translate(text);
+        return {
+          translatedText: result,
+          detectedLanguage: resolvedSource,
+          engine: 'on-device-ai'
+        };
+      } else if (availability === 'unavailable') {
+        console.warn(`Translator API unavailable for pair: ${resolvedSource}->${targetLang}. Falling back.`);
+      }
+    } catch (err) {
+      console.warn('Translator API error, executing fallback strategy:', err);
+    }
+  }
+
+  // 2. Try Remote API Fallback (Public Translation API)
+  try {
+    const langPair = `${baseSource}|${baseTarget}`;
+    const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=${encodeURIComponent(langPair)}`;
+
+    const controller = new AbortController();
+    const timeoutId = setTimeout(() => controller.abort(), 4500);
+
+    const response = await fetch(url, { signal: controller.signal });
+    clearTimeout(timeoutId);
+
+    if (response.ok) {
+      const data = await response.json();
+      if (data && data.responseData && data.responseData.translatedText) {
+        const cleanTranslation = decodeHTMLEntities(data.responseData.translatedText);
+        // Ensure response is not a warning message or quota error
+        if (cleanTranslation && !cleanTranslation.includes('MYMEMORY WARNING') && cleanTranslation !== text) {
+          return {
+            translatedText: cleanTranslation,
+            detectedLanguage: resolvedSource,
+            engine: 'cloud-api'
+          };
+        }
+      }
+    }
+  } catch (err) {
+    console.warn('Cloud translation fallback encountered an error:', err);
+  }
+
+  // 3. Offline Dictionary Fallback
+  const fallbackResult = translateOfflineFallback(text, resolvedSource, targetLang);
+  return {
+    translatedText: fallbackResult,
+    detectedLanguage: resolvedSource,
+    engine: 'offline-dictionary'
+  };
+}
+
+/**
+ * Website Page Localization
+ * Translates page text elements to chosen target language.
+ */
+const originalSiteTexts = new Map();
+
+async function translateWebsite(targetLang) {
+  // Select all translatable content elements
+  const elements = document.querySelectorAll('[data-i18n], .logo, nav a, .hero h1, .hero p, .hero .btn, main h2, .card h3, .card p, .card .btn, .footer-links a, footer p');
+
+  // Cache originals on first translation
+  if (originalSiteTexts.size === 0) {
+    elements.forEach((el, index) => {
+      originalSiteTexts.set(el, el.textContent.trim());
+    });
+  }
+
+  // If switching back to English, restore original texts
+  if (targetLang === 'en') {
+    elements.forEach((el) => {
+      if (originalSiteTexts.has(el)) {
+        el.textContent = originalSiteTexts.get(el);
+      }
+    });
+    document.documentElement.lang = 'en';
+    return;
+  }
+
+  document.documentElement.lang = targetLang;
+
+  // Translate all elements
+  for (const el of elements) {
+    const orig = originalSiteTexts.get(el);
+    if (!orig) continue;
+
+    // Fast check in offline dictionary first for seamless UI transitions
+    if (OFFLINE_DICTIONARY[orig] && OFFLINE_DICTIONARY[orig][targetLang]) {
+      el.textContent = OFFLINE_DICTIONARY[orig][targetLang];
+      continue;
+    }
+
+    // Otherwise use async translator
+    translateText(orig, 'en', targetLang).then((res) => {
+      if (res && res.translatedText) {
+        el.textContent = res.translatedText;
+      }
+    });
+  }
+}
+
+// Expose on global window object for automated testing and integrations
+window.translateText = translateText;
+window.detectLanguage = detectLanguage;
+window.translateWebsite = translateWebsite;
+window.SUPPORTED_LANGUAGES = SUPPORTED_LANGUAGES;
+
+/**
+ * Initialize Translation UI controls once DOM is ready
+ */
+document.addEventListener('DOMContentLoaded', () => {
+  const sourceLangSelect = document.getElementById('source-lang-select');
+  const targetLangSelect = document.getElementById('target-lang-select');
+  const sourceText = document.getElementById('source-text');
+  const targetText = document.getElementById('target-text');
+  const translateBtn = document.getElementById('translate-btn');
+  const swapBtn = document.getElementById('swap-languages-btn');
+  const clearBtn = document.getElementById('clear-text-btn');
+  const copyBtn = document.getElementById('copy-text-btn');
+  const charCount = document.getElementById('char-count');
+  const statusMsg = document.getElementById('translation-status');
+  const progressContainer = document.getElementById('model-progress-container');
+  const progressBar = document.getElementById('model-progress-bar');
+  const engineBadge = document.getElementById('engine-badge');
+  const siteLangSelect = document.getElementById('site-language-select');
+  const sampleChips = document.querySelectorAll('.sample-chip');
+
+  // Populate language dropdowns if elements exist
+  if (sourceLangSelect && targetLangSelect) {
+    // Keep 'auto' in source
+    SUPPORTED_LANGUAGES.forEach((lang) => {
+      const optSrc = document.createElement('option');
+      optSrc.value = lang.code;
+      optSrc.textContent = `${lang.name} (${lang.native})`;
+      if (lang.code === 'en') optSrc.selected = true;
+      sourceLangSelect.appendChild(optSrc);
+
+      const optTgt = document.createElement('option');
+      optTgt.value = lang.code;
+      optTgt.textContent = `${lang.name} (${lang.native})`;
+      if (lang.code === 'es') optTgt.selected = true;
+      targetLangSelect.appendChild(optTgt);
+    });
+  }
+
+  // Populate site language selector in nav if present
+  if (siteLangSelect) {
+    const popularCodes = ['en', 'es', 'fr', 'de', 'it', 'ja', 'zh', 'ko', 'ru', 'ar'];
+    popularCodes.forEach((code) => {
+      const lang = SUPPORTED_LANGUAGES.find((l) => l.code === code);
+      if (lang) {
+        const opt = document.createElement('option');
+        opt.value = lang.code;
+        opt.textContent = `${lang.native} (${lang.name})`;
+        if (code === 'en') opt.selected = true;
+        siteLangSelect.appendChild(opt);
+      }
+    });
+
+    siteLangSelect.addEventListener('change', (e) => {
+      translateWebsite(e.target.value);
+    });
+  }
+
+  // Character counter
+  if (sourceText && charCount) {
+    sourceText.addEventListener('input', () => {
+      charCount.textContent = `${sourceText.value.length} / 5000`;
+    });
+  }
+
+  // Swap languages button
+  if (swapBtn && sourceLangSelect && targetLangSelect) {
+    swapBtn.addEventListener('click', () => {
+      const currentSource = sourceLangSelect.value;
+      const currentTarget = targetLangSelect.value;
+
+      if (currentSource !== 'auto') {
+        sourceLangSelect.value = currentTarget;
+        targetLangSelect.value = currentSource;
+
+        // Swap texts if target has content
+        if (targetText && sourceText && targetText.value) {
+          const temp = sourceText.value;
+          sourceText.value = targetText.value;
+          targetText.value = temp;
+          if (charCount) charCount.textContent = `${sourceText.value.length} / 5000`;
+        }
+      }
+    });
+  }
+
+  // Clear button
+  if (clearBtn && sourceText) {
+    clearBtn.addEventListener('click', () => {
+      sourceText.value = '';
+      if (targetText) targetText.value = '';
+      if (charCount) charCount.textContent = '0 / 5000';
+      if (statusMsg) statusMsg.textContent = '';
+      if (engineBadge) engineBadge.style.display = 'none';
+      if (progressContainer) progressContainer.style.display = 'none';
+      sourceText.focus();
+    });
+  }
+
+  // Copy button
+  if (copyBtn && targetText) {
+    copyBtn.addEventListener('click', async () => {
+      if (!targetText.value) return;
+      try {
+        await navigator.clipboard.writeText(targetText.value);
+        const originalText = copyBtn.textContent;
+        copyBtn.textContent = 'Copied!';
+        copyBtn.classList.add('copied');
+        setTimeout(() => {
+          copyBtn.textContent = originalText;
+          copyBtn.classList.remove('copied');
+        }, 2000);
+      } catch (err) {
+        // Fallback copy using textarea selection
+        targetText.select();
+        document.execCommand('copy');
+        copyBtn.textContent = 'Copied!';
+        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 2000);
+      }
+    });
+  }
+
+  // Sample chips
+  if (sampleChips) {
+    sampleChips.forEach((chip) => {
+      chip.addEventListener('click', () => {
+        const text = chip.getAttribute('data-text') || chip.textContent;
+        if (sourceText) {
+          sourceText.value = text;
+          if (charCount) charCount.textContent = `${text.length} / 5000`;
+          if (translateBtn) translateBtn.click();
+        }
+      });
+    });
+  }
+
+  // Translation execution handler
+  async function handleTranslate() {
+    if (!sourceText || !targetText) return;
+    const text = sourceText.value.trim();
+    if (!text) {
+      if (statusMsg) {
+        statusMsg.textContent = 'Please enter some text to translate.';
+        statusMsg.className = 'status-msg status-warning';
+      }
+      return;
+    }
+
+    const srcLang = sourceLangSelect ? sourceLangSelect.value : 'auto';
+    const tgtLang = targetLangSelect ? targetLangSelect.value : 'es';
+
+    if (statusMsg) {
+      statusMsg.textContent = 'Translating...';
+      statusMsg.className = 'status-msg status-loading';
+    }
+    if (translateBtn) translateBtn.disabled = true;
+
+    try {
+      const res = await translateText(text, srcLang, tgtLang, (progressPct) => {
+        if (progressContainer && progressBar) {
+          progressContainer.style.display = 'block';
+          progressBar.style.width = `${progressPct}%`;
+          if (statusMsg) {
+            statusMsg.textContent = `Downloading AI language pack: ${progressPct}%...`;
+          }
+        }
+      });
+
+      targetText.value = res.translatedText;
+
+      if (progressContainer) {
+        progressContainer.style.display = 'none';
+      }
+
+      if (statusMsg) {
+        statusMsg.textContent = 'Translation complete';
+        statusMsg.className = 'status-msg status-success';
+        setTimeout(() => {
+          if (statusMsg.textContent === 'Translation complete') {
+            statusMsg.textContent = '';
+          }
+        }, 3000);
+      }
+
+      if (engineBadge) {
+        engineBadge.style.display = 'inline-flex';
+        let badgeText = '⚡ On-Device AI';
+        let badgeTitle = 'Translated using Chrome/Edge on-device Translator API';
+        if (res.engine === 'cloud-api') {
+          badgeText = '🌐 Cloud API';
+          badgeTitle = 'Translated using cloud translation API';
+        } else if (res.engine === 'offline-dictionary') {
+          badgeText = '📚 Local Dictionary';
+          badgeTitle = 'Translated using local dictionary fallback';
+        }
+
+        const srcName = SUPPORTED_LANGUAGES.find((l) => l.code === res.detectedLanguage)?.name || res.detectedLanguage;
+        const tgtName = SUPPORTED_LANGUAGES.find((l) => l.code === tgtLang)?.name || tgtLang;
+        engineBadge.textContent = `${badgeText} (${srcName} → ${tgtName})`;
+        engineBadge.title = badgeTitle;
+      }
+    } catch (err) {
+      console.error('Translation failed:', err);
+      if (statusMsg) {
+        statusMsg.textContent = `Translation failed: ${err.message || 'Unknown error'}`;
+        statusMsg.className = 'status-msg status-error';
+      }
+    } finally {
+      if (translateBtn) translateBtn.disabled = false;
+    }
+  }
+
+  if (translateBtn) {
+    translateBtn.addEventListener('click', handleTranslate);
+  }
+
+  // Support Ctrl+Enter / Cmd+Enter in source textarea
+  if (sourceText) {
+    sourceText.addEventListener('keydown', (e) => {
+      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
+        e.preventDefault();
+        handleTranslate();
+      }
+    });
+  }
+});
