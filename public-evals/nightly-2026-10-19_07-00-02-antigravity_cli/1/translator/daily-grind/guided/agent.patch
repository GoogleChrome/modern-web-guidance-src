+/**
+ * Detect language of given text
+ */
+async function detectLanguage(text) {
+  if (!text || !text.trim()) return 'en';
+
+  // 1. Check native LanguageDetector API (Chrome 138+)
+  if ('LanguageDetector' in self) {
+    try {
+      const availability = await LanguageDetector.availability();
+      if (availability !== 'unavailable') {
+        const detector = await LanguageDetector.create();
+        const results = await detector.detect(text);
+        if (results && results.length > 0 && results[0].confidence > 0.3) {
+          return results[0].detectedLanguage;
+        }
+      }
+    } catch (e) {
+      console.warn('LanguageDetector error, using fallback heuristics:', e);
+    }
+  }
+
+  // 2. Character & Script Heuristics fallback
+  if (/[\u0600-\u06FF]/.test(text)) return 'ar';
+  if (/[\u0400-\u04FF]/.test(text)) return 'ru';
+  if (/[\u3040-\u309F\u30A0-\u30FF]/.test(text)) return 'ja';
+  if (/[\uAC00-\uD7AF]/.test(text)) return 'ko';
+  if (/[\u4E00-\u9FFF]/.test(text)) return 'zh';
+  if (/[\u0900-\u097F]/.test(text)) return 'hi';
+  if (/[\u0370-\u03FF]/.test(text)) return 'el';
+
+  // Check common Spanish words
+  if (/\b(el|la|los|las|un|una|es|por|favor|gracias|hola|buenos|días)\b/i.test(text)) return 'es';
+  // Check common French words
+  if (/\b(le|la|les|un|une|est|merci|bonjour|s'il|vous|plaît)\b/i.test(text)) return 'fr';
+  // Check common German words
+  if (/\b(der|die|das|ein|eine|ist|und|danke|hallo|guten|morgen)\b/i.test(text)) return 'de';
+  // Check common Italian words
+  if (/\b(il|lo|la|i|gli|le|un|una|è|grazie|ciao|buongiorno)\b/i.test(text)) return 'it';
+
+  return 'en';
+}
