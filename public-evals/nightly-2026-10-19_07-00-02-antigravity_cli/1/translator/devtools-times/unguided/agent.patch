+import React, { useState, useEffect } from 'react';
+import { SUPPORTED_LANGUAGES, getLanguageName } from '../utils/languages';
+import { translateText, translateBatch, type TranslationResult } from '../utils/translator';
+import {
+  LanguageIcon,
+  ArrowPathIcon,
+  SparklesIcon,
+  ArrowUturnLeftIcon,
+  SpeakerWaveIcon,
+  StopIcon
+} from '@heroicons/react/24/outline';
+
+interface Props {
+  originalTitle: string;
+  originalSummary: string;
+  articleSlug: string;
+}
+
+export default function ArticleTranslator({
+  originalTitle,
+  originalSummary,
+  articleSlug
+}: Props) {
+  const [targetLang, setTargetLang] = useState<string>('es');
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [isLoading, setIsLoading] = useState<boolean>(false);
+  const [engineUsed, setEngineUsed] = useState<string>('');
+  const [translatedLanguageName, setTranslatedLanguageName] = useState<string>('');
+  const [isSpeaking, setIsSpeaking] = useState<boolean>(false);
+
+  // Cached original HTML
+  const originalProseHtmlRef = React.useRef<string | null>(null);
+  const originalTitleHtmlRef = React.useRef<string | null>(null);
+  const originalSummaryHtmlRef = React.useRef<string | null>(null);
+
+  const baseUrl = import.meta.env.BASE_URL || '/';
+
+  // Reset when slug changes
+  useEffect(() => {
+    setIsTranslated(false);
+    setIsLoading(false);
+    setEngineUsed('');
+    originalProseHtmlRef.current = null;
+  }, [articleSlug]);
+
+  const handleTranslateArticle = async () => {
+    if (isLoading) return;
+    setIsLoading(true);
+
+    try {
+      const proseEl = document.querySelector('.prose');
+      const headlineEl = document.querySelector('article h1');
+      const leadEl = document.querySelector('article p.font-light');
+
+      // Cache originals
+      if (proseEl && !originalProseHtmlRef.current) {
+        originalProseHtmlRef.current = proseEl.innerHTML;
+      }
+      if (headlineEl && !originalTitleHtmlRef.current) {
+        originalTitleHtmlRef.current = headlineEl.textContent || originalTitle;
+      }
+      if (leadEl && !originalSummaryHtmlRef.current) {
+        originalSummaryHtmlRef.current = leadEl.textContent || originalSummary;
+      }
+
+      // Collect paragraphs and headings to translate
+      const textNodes: { el: Element; text: string }[] = [];
+
+      if (proseEl) {
+        const elements = proseEl.querySelectorAll('p, h2, h3, h4, li, blockquote');
+        elements.forEach((el) => {
+          const text = el.textContent?.trim();
+          if (text) {
+            textNodes.push({ el, text });
+          }
+        });
+      }
+
+      const textsToTranslate = [
+        originalTitle,
+        originalSummary,
+        ...textNodes.map((n) => n.text)
+      ];
+
+      // Translate headline, summary, and article body
+      const batchResult = await translateBatch(textsToTranslate, 'en', targetLang, baseUrl);
+
+      if (batchResult.translatedTexts && batchResult.translatedTexts.length > 0) {
+        const [translatedHeadline, translatedLead, ...translatedBody] = batchResult.translatedTexts;
+
+        if (headlineEl && translatedHeadline) {
+          headlineEl.textContent = translatedHeadline;
+        }
+        if (leadEl && translatedLead) {
+          leadEl.textContent = translatedLead;
+        }
+
+        translatedBody.forEach((translatedText, i) => {
+          if (textNodes[i] && translatedText) {
+            textNodes[i].el.textContent = translatedText;
+          }
+        });
+
+        setEngineUsed(batchResult.engine);
+        setTranslatedLanguageName(getLanguageName(targetLang));
+        setIsTranslated(true);
+      }
+    } catch (err) {
+      console.error('Failed to translate article:', err);
+    } finally {
+      setIsLoading(false);
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    const proseEl = document.querySelector('.prose');
+    const headlineEl = document.querySelector('article h1');
+    const leadEl = document.querySelector('article p.font-light');
+
+    if (proseEl && originalProseHtmlRef.current) {
+      proseEl.innerHTML = originalProseHtmlRef.current;
+    }
+    if (headlineEl && originalTitleHtmlRef.current) {
+      headlineEl.textContent = originalTitleHtmlRef.current;
+    }
+    if (leadEl && originalSummaryHtmlRef.current) {
+      leadEl.textContent = originalSummaryHtmlRef.current;
+    }
+
+    if (isSpeaking && typeof window !== 'undefined' && 'speechSynthesis' in window) {
+      window.speechSynthesis.cancel();
+      setIsSpeaking(false);
+    }
+
+    setIsTranslated(false);
+  };
+
+  const handleSpeakArticle = () => {
+    if (typeof window === 'undefined' || !('speechSynthesis' in window)) return;
+    if (isSpeaking) {
+      window.speechSynthesis.cancel();
+      setIsSpeaking(false);
+      return;
+    }
+
+    const headline = document.querySelector('article h1')?.textContent || '';
+    const lead = document.querySelector('article p.font-light')?.textContent || '';
+    const fullText = `${headline}. ${lead}`;
+
+    const utterance = new SpeechSynthesisUtterance(fullText);
+    utterance.lang = isTranslated ? targetLang : 'en';
+    utterance.onend = () => setIsSpeaking(false);
+    utterance.onerror = () => setIsSpeaking(false);
+    setIsSpeaking(true);
+    window.speechSynthesis.speak(utterance);
+  };
+
+  return (
+    <div className="my-5 p-3 sm:p-4 bg-gray-50 border border-gray-200 rounded-lg">
+      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
+        {/* Left Side: Language Selection / Status */}
+        <div className="flex items-center space-x-2 flex-wrap">
+          <LanguageIcon className="w-5 h-5 text-amber-500 shrink-0" />
+          <span className="text-xs sm:text-sm font-semibold text-gray-800">
+            {isTranslated ? `Translated to ${translatedLanguageName}` : 'Translate Article:'}
+          </span>
+
+          {!isTranslated ? (
+            <select
+              value={targetLang}
+              onChange={(e) => setTargetLang(e.target.value)}
+              disabled={isLoading}
+              className="text-xs sm:text-sm bg-white border border-gray-300 rounded px-2 py-1 font-medium text-gray-700 focus:ring-2 focus:ring-amber-400 focus:outline-none"
+            >
+              {SUPPORTED_LANGUAGES.filter((l) => l.code !== 'en').map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          ) : (
+            <div className="flex items-center space-x-1.5 ml-1">
+              {engineUsed === 'chrome-builtin-ai' && (
+                <span className="text-[11px] bg-green-100 text-green-800 font-semibold px-2 py-0.5 rounded-full">
+                  ⚡ Chrome Built-in AI
+                </span>
+              )}
+              {engineUsed === 'cloud' && (
+                <span className="text-[11px] bg-blue-100 text-blue-800 font-semibold px-2 py-0.5 rounded-full">
+                  🌐 Cloud
+                </span>
+              )}
+              {engineUsed === 'fallback' && (
+                <span className="text-[11px] bg-amber-100 text-amber-800 font-semibold px-2 py-0.5 rounded-full">
+                  📖 Dictionary
+                </span>
+              )}
+            </div>
+          )}
+        </div>
+
+        {/* Right Side: Action Buttons */}
+        <div className="flex items-center space-x-2">
+          {/* Read Aloud button */}
+          <button
+            onClick={handleSpeakArticle}
+            title={isSpeaking ? 'Stop audio' : 'Listen to headline & summary'}
+            className="text-xs text-gray-700 hover:text-amber-600 bg-white border border-gray-200 hover:bg-gray-100 px-2.5 py-1.5 rounded flex items-center space-x-1 transition"
+          >
+            {isSpeaking ? (
+              <>
+                <StopIcon className="w-3.5 h-3.5 text-red-500" />
+                <span>Stop</span>
+              </>
+            ) : (
+              <>
+                <SpeakerWaveIcon className="w-3.5 h-3.5 text-gray-600" />
+                <span>Listen</span>
+              </>
+            )}
+          </button>
+
+          {!isTranslated ? (
+            <button
+              onClick={handleTranslateArticle}
+              disabled={isLoading}
+              className="bg-gray-900 hover:bg-gray-800 disabled:opacity-50 text-white text-xs sm:text-sm font-semibold px-3 py-1.5 rounded flex items-center space-x-1.5 transition shadow-xs"
+            >
+              {isLoading ? (
+                <>
+                  <ArrowPathIcon className="w-4 h-4 animate-spin text-amber-400" />
+                  <span>Translating...</span>
+                </>
+              ) : (
+                <>
+                  <SparklesIcon className="w-4 h-4 text-amber-400" />
+                  <span>Translate</span>
+                </>
+              )}
+            </button>
+          ) : (
+            <button
+              onClick={handleRestoreOriginal}
+              className="bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs sm:text-sm font-medium px-3 py-1.5 rounded flex items-center space-x-1 transition"
+            >
+              <ArrowUturnLeftIcon className="w-3.5 h-3.5" />
+              <span>Show Original</span>
+            </button>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
