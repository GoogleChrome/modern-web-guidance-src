@@ -0,0 +1,33 @@
+import React, { useState } from 'react';
+import TranslateFlyout from './TranslateFlyout';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+
+interface Props {
+  initialText?: string;
+  initialTarget?: string;
+}
+
+export default function TranslateButton({ initialText, initialTarget }: Props) {
+  const [isOpen, setIsOpen] = useState(false);
+
+  return (
+    <>
+      <button
+        onClick={() => setIsOpen(true)}
+        className="text-gray-700 hover:text-amber-500 w-6 h-6 flex items-center justify-center transition-colors"
+        aria-label="Translate text between languages"
+        title="Translate text"
+      >
+        <LanguageIcon className="w-5 h-5" />
+      </button>
+
+      {isOpen && (
+        <TranslateFlyout
+          onClose={() => setIsOpen(false)}
+          initialText={initialText}
+          initialTarget={initialTarget}
+        />
+      )}
+    </>
+  );
+}
diff --git a/src/components/TranslateFlyout.tsx b/src/components/TranslateFlyout.tsx
new file mode 100644
index 0000000..f108486
--- /dev/null
+++ b/src/components/TranslateFlyout.tsx
@@ -0,0 +1,441 @@
+import React, { useState, useEffect, useRef } from 'react';
+import { SUPPORTED_LANGUAGES, getLanguageName } from '../utils/languages';
+import {
+  translateText,
+  getTranslationHistory,
+  clearTranslationHistory,
+  type TranslationResult,
+  type TranslationHistoryItem
+} from '../utils/translator';
+import {
+  LanguageIcon,
+  ArrowsRightLeftIcon,
+  ClipboardIcon,
+  ClipboardDocumentCheckIcon,
+  XMarkIcon,
+  ArrowPathIcon,
+  SparklesIcon
+} from '@heroicons/react/24/outline';
+
+interface Props {
+  onClose: () => void;
+  initialText?: string;
+  initialSource?: string;
+  initialTarget?: string;
+}
+
+const SAMPLE_TEXTS = [
+  'Breaking: Technology breakthrough enables ultra-fast real-time translation.',
+  'The city council approved major investments in public transit infrastructure.',
+  'Global economic summit addresses sustainable manufacturing and clean energy.'
+];
+
+export default function TranslateFlyout({
+  onClose,
+  initialText = '',
+  initialSource = 'auto',
+  initialTarget = 'es'
+}: Props) {
+  const [sourceLang, setSourceLang] = useState<string>(initialSource);
+  const [targetLang, setTargetLang] = useState<string>(initialTarget);
+  const [inputText, setInputText] = useState<string>(initialText);
+  const [translatedText, setTranslatedText] = useState<string>('');
+  const [isLoading, setIsLoading] = useState<boolean>(false);
+  const [detectedLang, setDetectedLang] = useState<string>('');
+  const [engineUsed, setEngineUsed] = useState<string>('');
+  const [copied, setCopied] = useState<boolean>(false);
+  const [isSpeaking, setIsSpeaking] = useState<boolean>(false);
+  const [history, setHistory] = useState<TranslationHistoryItem[]>([]);
+  const [showHistory, setShowHistory] = useState<boolean>(false);
+
+  const baseUrl = import.meta.env.BASE_URL || '/';
+  const textareaRef = useRef<HTMLTextAreaElement>(null);
+
+  useEffect(() => {
+    // If text was selected on page, prefill it!
+    if (!initialText && typeof window !== 'undefined') {
+      const selected = window.getSelection()?.toString().trim();
+      if (selected) {
+        setInputText(selected);
+      }
+    }
+    setHistory(getTranslationHistory());
+
+    const handleKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') {
+        onClose();
+      }
+    };
+    window.addEventListener('keydown', handleKeyDown);
+    return () => window.removeEventListener('keydown', handleKeyDown);
+  }, [onClose, initialText]);
+
+  const handleTranslate = async (overrideText?: string) => {
+    const textToTranslate = overrideText !== undefined ? overrideText : inputText;
+    if (!textToTranslate.trim()) return;
+
+    setIsLoading(true);
+    setCopied(false);
+
+    try {
+      const result: TranslationResult = await translateText(
+        textToTranslate,
+        sourceLang,
+        targetLang,
+        baseUrl
+      );
+      setTranslatedText(result.translatedText);
+      setDetectedLang(result.source);
+      setEngineUsed(result.engine);
+      setHistory(getTranslationHistory());
+    } catch (err) {
+      console.error('Translation error:', err);
+    } finally {
+      setIsLoading(false);
+    }
+  };
+
+  const handleSwapLanguages = () => {
+    if (sourceLang === 'auto') return;
+    const oldSource = sourceLang;
+    const oldTarget = targetLang;
+    setSourceLang(oldTarget);
+    setTargetLang(oldSource);
+    if (translatedText) {
+      setInputText(translatedText);
+      setTranslatedText(inputText);
+    }
+  };
+
+  const handleCopy = async () => {
+    if (!translatedText) return;
+    try {
+      await navigator.clipboard.writeText(translatedText);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 2000);
+    } catch (err) {
+      console.error('Failed to copy:', err);
+    }
+  };
+
+  const handlePaste = async () => {
+    try {
+      const clipText = await navigator.clipboard.readText();
+      if (clipText) {
+        setInputText(clipText);
+        textareaRef.current?.focus();
+      }
+    } catch (err) {
+      console.error('Clipboard paste failed:', err);
+    }
+  };
+
+  const handleSpeak = (text: string, langCode: string) => {
+    if (typeof window === 'undefined' || !('speechSynthesis' in window)) return;
+    if (isSpeaking) {
+      window.speechSynthesis.cancel();
+      setIsSpeaking(false);
+      return;
+    }
+
+    const utterance = new SpeechSynthesisUtterance(text);
+    utterance.lang = langCode;
+    utterance.onend = () => setIsSpeaking(false);
+    utterance.onerror = () => setIsSpeaking(false);
+    setIsSpeaking(true);
+    window.speechSynthesis.speak(utterance);
+  };
+
+  const handleSelectHistoryItem = (item: TranslationHistoryItem) => {
+    setInputText(item.sourceText);
+    setTranslatedText(item.translatedText);
+    setSourceLang(item.sourceLang);
+    setTargetLang(item.targetLang);
+    setEngineUsed(item.engine);
+    setShowHistory(false);
+  };
+
+  const handleClearHistory = () => {
+    clearTranslationHistory();
+    setHistory([]);
+  };
+
+  return (
+    <div
+      className="fixed inset-0 bg-black/40 backdrop-blur-xs z-[99999] flex justify-center items-start p-4 pt-[6vh] overflow-y-auto"
+      onClick={onClose}
+    >
+      <div
+        className="bg-white rounded-lg shadow-2xl w-full max-w-2xl relative overflow-hidden border border-gray-200 my-auto"
+        onClick={(e) => e.stopPropagation()}
+      >
+        {/* Header */}
+        <div className="flex items-center justify-between px-6 py-4 border-b border-gray-200 bg-gray-50">
+          <div className="flex items-center space-x-2">
+            <LanguageIcon className="w-6 h-6 text-amber-500" />
+            <h2 className="text-lg font-bold text-gray-900">Translate</h2>
+            <span className="text-xs bg-amber-100 text-amber-800 font-medium px-2 py-0.5 rounded-full">
+              The DevTools Times
+            </span>
+          </div>
+
+          <div className="flex items-center space-x-3">
+            <a
+              href={`${baseUrl}translate`}
+              className="text-xs text-gray-600 hover:text-amber-600 hover:underline font-medium"
+            >
+              Open Full Page ↗
+            </a>
+            <button
+              onClick={onClose}
+              className="text-gray-400 hover:text-gray-700 p-1 rounded-full hover:bg-gray-200 transition-colors"
+              aria-label="Close"
+            >
+              <XMarkIcon className="w-5 h-5" />
+            </button>
+          </div>
+        </div>
+
+        {/* Language Controls */}
+        <div className="px-6 py-3 bg-white border-b border-gray-100 flex items-center justify-between gap-2">
+          {/* Source Language */}
+          <div className="flex-1">
+            <label className="block text-xs font-semibold text-gray-500 mb-1">From</label>
+            <select
+              value={sourceLang}
+              onChange={(e) => setSourceLang(e.target.value)}
+              className="w-full text-sm font-medium bg-gray-50 border border-gray-300 rounded px-2.5 py-1.5 focus:ring-2 focus:ring-amber-400 focus:outline-none"
+            >
+              <option value="auto">
+                Auto Detect {detectedLang ? `(${getLanguageName(detectedLang)})` : ''}
+              </option>
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`src-${lang.code}`} value={lang.code}>
+                  {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+
+          {/* Swap Button */}
+          <div className="pt-4">
+            <button
+              onClick={handleSwapLanguages}
+              disabled={sourceLang === 'auto'}
+              title={sourceLang === 'auto' ? 'Cannot swap with Auto Detect' : 'Swap languages'}
+              className={`p-2 rounded-full border border-gray-200 hover:bg-gray-100 transition-colors ${
+                sourceLang === 'auto' ? 'opacity-40 cursor-not-allowed' : 'text-gray-600 hover:text-gray-900'
+              }`}
+            >
+              <ArrowsRightLeftIcon className="w-4 h-4" />
+            </button>
+          </div>
+
+          {/* Target Language */}
+          <div className="flex-1">
+            <label className="block text-xs font-semibold text-gray-500 mb-1">To</label>
+            <select
+              value={targetLang}
+              onChange={(e) => setTargetLang(e.target.value)}
+              className="w-full text-sm font-medium bg-gray-50 border border-gray-300 rounded px-2.5 py-1.5 focus:ring-2 focus:ring-amber-400 focus:outline-none"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`tgt-${lang.code}`} value={lang.code}>
+                  {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+        </div>
+
+        {/* Translation Body */}
+        <div className="p-6 space-y-4">
+          {/* Source Input */}
+          <div className="relative">
+            <textarea
+              ref={textareaRef}
+              rows={4}
+              value={inputText}
+              onChange={(e) => setInputText(e.target.value)}
+              placeholder="Enter or paste text to translate..."
+              className="w-full p-3 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400 focus:border-transparent resize-y transition"
+            />
+            <div className="flex justify-between items-center text-xs text-gray-400 mt-1">
+              <div className="flex items-center space-x-2">
+                <span>{inputText.length} characters</span>
+                {inputText && (
+                  <button
+                    onClick={() => {
+                      setInputText('');
+                      setTranslatedText('');
+                    }}
+                    className="text-gray-400 hover:text-red-500 hover:underline"
+                  >
+                    Clear
+                  </button>
+                )}
+                {!inputText && (
+                  <button
+                    onClick={handlePaste}
+                    className="text-amber-600 hover:underline font-medium"
+                  >
+                    Paste
+                  </button>
+                )}
+              </div>
+              <div className="flex items-center space-x-1">
+                {sourceLang === 'auto' && detectedLang && (
+                  <span className="text-gray-500 bg-gray-100 px-1.5 py-0.5 rounded text-[11px]">
+                    Detected: {getLanguageName(detectedLang)}
+                  </span>
+                )}
+              </div>
+            </div>
+          </div>
+
+          {/* Quick Presets / Samples */}
+          {!inputText && (
+            <div>
+              <p className="text-xs text-gray-500 mb-1.5 font-medium">Try a sample headline:</p>
+              <div className="flex flex-wrap gap-1.5">
+                {SAMPLE_TEXTS.map((sample, idx) => (
+                  <button
+                    key={idx}
+                    onClick={() => {
+                      setInputText(sample);
+                      handleTranslate(sample);
+                    }}
+                    className="text-xs text-left bg-gray-100 hover:bg-amber-50 hover:text-amber-800 border border-gray-200 rounded px-2 py-1 text-gray-700 transition-colors truncate max-w-full"
+                  >
+                    "{sample.slice(0, 48)}..."
+                  </button>
+                ))}
+              </div>
+            </div>
+          )}
+
+          {/* Translate Button */}
+          <div className="flex justify-between items-center">
+            <button
+              onClick={() => handleTranslate()}
+              disabled={isLoading || !inputText.trim()}
+              className="flex items-center space-x-2 bg-gray-900 text-white hover:bg-gray-800 disabled:opacity-40 disabled:cursor-not-allowed px-5 py-2 rounded text-sm font-semibold transition shadow-xs"
+            >
+              {isLoading ? (
+                <>
+                  <ArrowPathIcon className="w-4 h-4 animate-spin text-amber-400" />
+                  <span>Translating...</span>
+                </>
+              ) : (
+                <>
+                  <SparklesIcon className="w-4 h-4 text-amber-400" />
+                  <span>Translate Text</span>
+                </>
+              )}
+            </button>
+
+            {history.length > 0 && (
+              <button
+                onClick={() => setShowHistory(!showHistory)}
+                className="text-xs text-gray-600 hover:text-gray-900 font-medium"
+              >
+                {showHistory ? 'Hide History' : `History (${history.length})`}
+              </button>
+            )}
+          </div>
+
+          {/* Translation Output */}
+          {translatedText && (
+            <div className="mt-4 p-4 bg-gray-50 border border-gray-200 rounded-md">
+              <div className="flex items-center justify-between pb-2 mb-2 border-b border-gray-200">
+                <div className="flex items-center space-x-2">
+                  <span className="text-xs font-bold uppercase tracking-wider text-gray-600">
+                    {getLanguageName(targetLang)} Translation
+                  </span>
+                  {engineUsed === 'chrome-builtin-ai' && (
+                    <span className="text-[10px] bg-green-100 text-green-800 font-semibold px-2 py-0.5 rounded-full flex items-center gap-1">
+                      ⚡ Chrome Built-in AI
+                    </span>
+                  )}
+                  {engineUsed === 'cloud' && (
+                    <span className="text-[10px] bg-blue-100 text-blue-800 font-semibold px-2 py-0.5 rounded-full">
+                      🌐 Cloud Engine
+                    </span>
+                  )}
+                  {engineUsed === 'fallback' && (
+                    <span className="text-[10px] bg-amber-100 text-amber-800 font-semibold px-2 py-0.5 rounded-full">
+                      📖 Built-in Dictionary
+                    </span>
+                  )}
+                </div>
+
+                <div className="flex items-center space-x-2">
+                  <button
+                    onClick={() => handleSpeak(translatedText, targetLang)}
+                    title={isSpeaking ? 'Stop speaking' : 'Listen to translation'}
+                    className="text-xs text-gray-600 hover:text-amber-600 flex items-center space-x-1 p-1 rounded hover:bg-gray-200"
+                  >
+                    <span>{isSpeaking ? '⏹ Stop' : '🔊 Listen'}</span>
+                  </button>
+
+                  <button
+                    onClick={handleCopy}
+                    className="text-xs text-gray-600 hover:text-amber-600 flex items-center space-x-1 p-1 rounded hover:bg-gray-200"
+                    title="Copy translated text"
+                  >
+                    {copied ? (
+                      <>
+                        <ClipboardDocumentCheckIcon className="w-4 h-4 text-green-600" />
+                        <span className="text-green-600 font-medium">Copied!</span>
+                      </>
+                    ) : (
+                      <>
+                        <ClipboardIcon className="w-4 h-4" />
+                        <span>Copy</span>
+                      </>
+                    )}
+                  </button>
+                </div>
+              </div>
+
+              <p className="text-sm text-gray-900 whitespace-pre-wrap leading-relaxed select-text font-normal">
+                {translatedText}
+              </p>
+            </div>
+          )}
+
+          {/* History Drawer */}
+          {showHistory && history.length > 0 && (
+            <div className="mt-4 pt-3 border-t border-gray-200">
+              <div className="flex justify-between items-center mb-2">
+                <span className="text-xs font-semibold text-gray-500 uppercase">Recent Translations</span>
+                <button
+                  onClick={handleClearHistory}
+                  className="text-xs text-red-500 hover:underline"
+                >
+                  Clear History
+                </button>
+              </div>
+              <ul className="space-y-2 max-h-40 overflow-y-auto pr-1">
+                {history.map((item) => (
+                  <li
+                    key={item.id}
+                    onClick={() => handleSelectHistoryItem(item)}
+                    className="text-xs p-2 bg-gray-50 hover:bg-amber-50 rounded border border-gray-100 cursor-pointer transition"
+                  >
+                    <div className="flex justify-between text-gray-400 text-[10px] mb-1">
+                      <span>{getLanguageName(item.sourceLang)} → {getLanguageName(item.targetLang)}</span>
+                      <span>{new Date(item.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
+                    </div>
+                    <p className="text-gray-800 font-medium truncate">{item.sourceText}</p>
+                    <p className="text-gray-500 truncate">{item.translatedText}</p>
+                  </li>
+                ))}
+              </ul>
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/src/pages/api/translate.ts b/src/pages/api/translate.ts
