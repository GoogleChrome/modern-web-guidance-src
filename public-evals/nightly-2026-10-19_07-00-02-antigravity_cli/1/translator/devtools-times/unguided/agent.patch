+export interface Language {
+  code: string;
+  name: string;
+  nativeName: string;
+  flag?: string;
+}
+
+export const SUPPORTED_LANGUAGES: Language[] = [
+  { code: 'en', name: 'English', nativeName: 'English' },
+  { code: 'es', name: 'Spanish', nativeName: 'Español' },
+  { code: 'fr', name: 'French', nativeName: 'Français' },
+  { code: 'de', name: 'German', nativeName: 'Deutsch' },
+  { code: 'it', name: 'Italian', nativeName: 'Italiano' },
+  { code: 'pt', name: 'Portuguese', nativeName: 'Português' },
+  { code: 'ja', name: 'Japanese', nativeName: '日本語' },
+  { code: 'zh', name: 'Chinese', nativeName: '中文' },
+  { code: 'ru', name: 'Russian', nativeName: 'Русский' },
+  { code: 'ar', name: 'Arabic', nativeName: 'العربية' },
+  { code: 'hi', name: 'Hindi', nativeName: 'हिन्दी' },
+  { code: 'ko', name: 'Korean', nativeName: '한국어' },
+  { code: 'nl', name: 'Dutch', nativeName: 'Nederlands' },
+  { code: 'tr', name: 'Turkish', nativeName: 'Türkçe' },
+  { code: 'pl', name: 'Polish', nativeName: 'Polski' },
+];
+
+export function getLanguageName(code: string): string {
+  const normalized = code.toLowerCase().split('-')[0];
+  const lang = SUPPORTED_LANGUAGES.find((l) => l.code === normalized);
+  return lang ? lang.name : code;
+}
+
+export function detectLanguage(text: string): string {
+  if (!text || !text.trim()) return 'en';
+
+  const trimmed = text.trim();
+
+  // Character set detections
+  if (/[\u0600-\u06FF]/.test(trimmed)) return 'ar';
+  if (/[\u3040-\u309F\u30A0-\u30FF]/.test(trimmed)) return 'ja';
+  if (/[\uAC00-\uD7AF]/.test(trimmed)) return 'ko';
+  if (/[\u4E00-\u9FFF]/.test(trimmed)) return 'zh';
+  if (/[\u0400-\u04FF]/.test(trimmed)) return 'ru';
+  if (/[\u0900-\u097F]/.test(trimmed)) return 'hi';
+
+  // Word-based heuristic detection for European languages
+  const words = trimmed.toLowerCase().match(/\b[a-z\u00C0-\u024F]+\b/g) || [];
+  if (words.length === 0) return 'en';
+
+  const markers: Record<string, string[]> = {
+    es: ['el', 'la', 'de', 'que', 'y', 'en', 'un', 'una', 'los', 'las', 'por', 'para', 'con', 'no', 'una', 'del', 'al', 'es', 'está', 'son'],
+    fr: ['le', 'la', 'les', 'de', 'des', 'un', 'une', 'et', 'en', 'est', 'que', 'qui', 'dans', 'pour', 'pas', 'sur', 'ce', 'cette'],
+    de: ['der', 'die', 'das', 'und', 'in', 'den', 'von', 'zu', 'mit', 'sich', 'des', 'auf', 'für', 'ist', 'nicht', 'im', 'dem', 'eine'],
+    it: ['il', 'lo', 'la', 'i', 'gli', 'le', 'di', 'a', 'da', 'in', 'con', 'su', 'per', 'tra', 'fra', 'che', 'non', 'sono', 'un', 'una'],
+    pt: ['o', 'a', 'os', 'as', 'de', 'do', 'da', 'dos', 'das', 'em', 'um', 'uma', 'com', 'não', 'para', 'por', 'que', 'no', 'na'],
+    nl: ['de', 'het', 'een', 'en', 'van', 'ik', 'te', 'dat', 'die', 'in', 'voor', 'op', 'met', 'ze', 'er', 'maar', 'om', 'is'],
+    pl: ['i', 'w', 'na', 'z', 'do', 'nie', 'to', 'się', 'że', 'o', 'jak', 'od', 'po', 'dla', 'jest'],
+    tr: ['ve', 'bir', 'bu', 'da', 'de', 'için', 'ile', 'ne', 'gibi', 'çok', 'daha', 'olarak', 'var'],
+    en: ['the', 'be', 'to', 'of', 'and', 'a', 'in', 'that', 'have', 'it', 'for', 'not', 'on', 'with', 'he', 'as', 'you', 'do', 'at', 'this', 'but', 'by', 'from', 'they', 'we', 'or', 'an', 'will', 'is', 'are', 'was', 'were']
+  };
+
+  const counts: Record<string, number> = {};
+  for (const lang of Object.keys(markers)) {
+    counts[lang] = 0;
+  }
+
+  for (const word of words) {
+    for (const [lang, list] of Object.entries(markers)) {
+      if (list.includes(word)) {
+        counts[lang] = (counts[lang] || 0) + 1;
+      }
+    }
+  }
+
+  let topLang = 'en';
+  let topCount = 0;
+  for (const [lang, count] of Object.entries(counts)) {
+    if (count > topCount) {
+      topCount = count;
+      topLang = lang;
+    }
+  }
+
+  return topCount > 0 ? topLang : 'en';
+}
