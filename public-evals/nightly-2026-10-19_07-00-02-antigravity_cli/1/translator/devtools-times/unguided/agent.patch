diff --git a/src/components/FullTranslatorWorkbench.tsx b/src/components/FullTranslatorWorkbench.tsx
new file mode 100644
index 0000000..8f42680
--- /dev/null
+++ b/src/components/FullTranslatorWorkbench.tsx
@@ -0,0 +1,455 @@
+import React, { useState, useEffect, useRef } from 'react';
+import { SUPPORTED_LANGUAGES, getLanguageName } from '../utils/languages';
+import {
+  translateText,
+  getTranslationHistory,
+  clearTranslationHistory,
+  type TranslationResult,
+  type TranslationHistoryItem
+} from '../utils/translator';
+import {
+  LanguageIcon,
+  ArrowsRightLeftIcon,
+  ClipboardIcon,
+  ClipboardDocumentCheckIcon,
+  ArrowPathIcon,
+  SparklesIcon,
+  SpeakerWaveIcon,
+  StopIcon,
+  TrashIcon
+} from '@heroicons/react/24/outline';
+
+interface ArticleSample {
+  slug: string;
+  title: string;
+  summary: string;
+}
+
+interface Props {
+  sampleArticles: ArticleSample[];
+}
+
+export default function FullTranslatorWorkbench({ sampleArticles }: Props) {
+  const [sourceLang, setSourceLang] = useState<string>('auto');
+  const [targetLang, setTargetLang] = useState<string>('es');
+  const [inputText, setInputText] = useState<string>('');
+  const [translatedText, setTranslatedText] = useState<string>('');
+  const [isLoading, setIsLoading] = useState<boolean>(false);
+  const [detectedLang, setDetectedLang] = useState<string>('');
+  const [engineUsed, setEngineUsed] = useState<string>('');
+  const [copied, setCopied] = useState<boolean>(false);
+  const [isSpeaking, setIsSpeaking] = useState<boolean>(false);
+  const [history, setHistory] = useState<TranslationHistoryItem[]>([]);
+
+  const baseUrl = import.meta.env.BASE_URL || '/';
+  const textareaRef = useRef<HTMLTextAreaElement>(null);
+
+  useEffect(() => {
+    setHistory(getTranslationHistory());
+  }, []);
+
+  const handleTranslate = async (overrideText?: string, overrideTarget?: string) => {
+    const textToTranslate = overrideText !== undefined ? overrideText : inputText;
+    const target = overrideTarget || targetLang;
+
+    if (!textToTranslate.trim()) return;
+
+    setIsLoading(true);
+    setCopied(false);
+
+    try {
+      const result: TranslationResult = await translateText(
+        textToTranslate,
+        sourceLang,
+        target,
+        baseUrl
+      );
+      setTranslatedText(result.translatedText);
+      setDetectedLang(result.source);
+      setEngineUsed(result.engine);
+      setHistory(getTranslationHistory());
+    } catch (err) {
+      console.error('Translation failed:', err);
+    } finally {
+      setIsLoading(false);
+    }
+  };
+
+  const handleSwapLanguages = () => {
+    if (sourceLang === 'auto') return;
+    const oldSource = sourceLang;
+    const oldTarget = targetLang;
+    setSourceLang(oldTarget);
+    setTargetLang(oldSource);
+    if (translatedText) {
+      setInputText(translatedText);
+      setTranslatedText(inputText);
+    }
+  };
+
+  const handleCopy = async () => {
+    if (!translatedText) return;
+    try {
+      await navigator.clipboard.writeText(translatedText);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 2000);
+    } catch (err) {
+      console.error('Failed to copy:', err);
+    }
+  };
+
+  const handlePaste = async () => {
+    try {
+      const clipText = await navigator.clipboard.readText();
+      if (clipText) {
+        setInputText(clipText);
+        textareaRef.current?.focus();
+      }
+    } catch (err) {
+      console.error('Failed to read clipboard:', err);
+    }
+  };
+
+  const handleSpeak = (text: string, langCode: string) => {
+    if (typeof window === 'undefined' || !('speechSynthesis' in window)) return;
+    if (isSpeaking) {
+      window.speechSynthesis.cancel();
+      setIsSpeaking(false);
+      return;
+    }
+
+    const utterance = new SpeechSynthesisUtterance(text);
+    utterance.lang = langCode;
+    utterance.onend = () => setIsSpeaking(false);
+    utterance.onerror = () => setIsSpeaking(false);
+    setIsSpeaking(true);
+    window.speechSynthesis.speak(utterance);
+  };
+
+  const handleLoadArticleSample = (article: ArticleSample) => {
+    const combined = `${article.title}\n\n${article.summary}`;
+    setInputText(combined);
+    handleTranslate(combined);
+  };
+
+  const handleClear = () => {
+    setInputText('');
+    setTranslatedText('');
+    setDetectedLang('');
+  };
+
+  const handleClearHistory = () => {
+    clearTranslationHistory();
+    setHistory([]);
+  };
+
+  return (
+    <div className="space-y-8">
+      {/* Workbench Card */}
+      <div className="bg-white border border-gray-200 rounded-xl shadow-xs overflow-hidden">
+        {/* Language Selection Header */}
+        <div className="px-6 py-4 bg-gray-50 border-b border-gray-200 flex flex-wrap items-center justify-between gap-4">
+          <div className="flex items-center space-x-3">
+            <LanguageIcon className="w-6 h-6 text-amber-500" />
+            <span className="font-bold text-gray-900 text-base">Language Pair</span>
+          </div>
+
+          <div className="flex items-center space-x-2 sm:space-x-4 flex-1 max-w-xl justify-end">
+            {/* Source selector */}
+            <div className="flex-1 min-w-[130px]">
+              <select
+                value={sourceLang}
+                onChange={(e) => setSourceLang(e.target.value)}
+                className="w-full text-sm font-medium bg-white border border-gray-300 rounded-md px-3 py-1.5 focus:ring-2 focus:ring-amber-400 focus:outline-none"
+              >
+                <option value="auto">
+                  Auto Detect {detectedLang ? `(${getLanguageName(detectedLang)})` : ''}
+                </option>
+                {SUPPORTED_LANGUAGES.map((lang) => (
+                  <option key={`src-${lang.code}`} value={lang.code}>
+                    {lang.name} ({lang.nativeName})
+                  </option>
+                ))}
+              </select>
+            </div>
+
+            {/* Swap button */}
+            <button
+              onClick={handleSwapLanguages}
+              disabled={sourceLang === 'auto'}
+              title={sourceLang === 'auto' ? 'Cannot swap with Auto Detect' : 'Swap languages'}
+              className={`p-2 rounded-full border border-gray-300 hover:bg-gray-100 transition shrink-0 ${
+                sourceLang === 'auto' ? 'opacity-40 cursor-not-allowed' : 'text-gray-700 hover:text-black'
+              }`}
+            >
+              <ArrowsRightLeftIcon className="w-4 h-4" />
+            </button>
+
+            {/* Target selector */}
+            <div className="flex-1 min-w-[130px]">
+              <select
+                value={targetLang}
+                onChange={(e) => setTargetLang(e.target.value)}
+                className="w-full text-sm font-medium bg-white border border-gray-300 rounded-md px-3 py-1.5 focus:ring-2 focus:ring-amber-400 focus:outline-none"
+              >
+                {SUPPORTED_LANGUAGES.map((lang) => (
+                  <option key={`tgt-${lang.code}`} value={lang.code}>
+                    {lang.name} ({lang.nativeName})
+                  </option>
+                ))}
+              </select>
+            </div>
+          </div>
+        </div>
+
+        {/* Translation Side-by-Side Grid */}
+        <div className="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-gray-200">
+          {/* Source Text Box */}
+          <div className="p-6 flex flex-col justify-between min-h-[300px]">
+            <div>
+              <div className="flex justify-between items-center mb-2">
+                <span className="text-xs font-semibold uppercase tracking-wider text-gray-500">
+                  {sourceLang === 'auto' ? 'Source Text (Auto Detect)' : getLanguageName(sourceLang)}
+                </span>
+                {sourceLang === 'auto' && detectedLang && (
+                  <span className="text-xs bg-amber-50 text-amber-800 font-medium px-2 py-0.5 rounded">
+                    Detected: {getLanguageName(detectedLang)}
+                  </span>
+                )}
+              </div>
+
+              <textarea
+                ref={textareaRef}
+                rows={9}
+                value={inputText}
+                onChange={(e) => setInputText(e.target.value)}
+                placeholder="Enter or paste text to translate..."
+                className="w-full p-3 text-base border-0 focus:ring-0 focus:outline-none resize-none placeholder-gray-400 font-normal"
+              />
+            </div>
+
+            <div className="flex justify-between items-center pt-4 border-t border-gray-100 mt-4 text-xs text-gray-500">
+              <div className="flex items-center space-x-3">
+                <span>{inputText.length} characters</span>
+                {inputText && (
+                  <button
+                    onClick={handleClear}
+                    className="text-gray-400 hover:text-red-500 transition"
+                  >
+                    Clear
+                  </button>
+                )}
+                {!inputText && (
+                  <button
+                    onClick={handlePaste}
+                    className="text-amber-600 hover:underline font-medium"
+                  >
+                    Paste from clipboard
+                  </button>
+                )}
+              </div>
+
+              <button
+                onClick={() => handleTranslate()}
+                disabled={isLoading || !inputText.trim()}
+                className="bg-gray-900 hover:bg-gray-800 disabled:opacity-40 disabled:cursor-not-allowed text-white text-xs sm:text-sm font-semibold px-4 py-2 rounded-md flex items-center space-x-2 transition shadow-xs"
+              >
+                {isLoading ? (
+                  <>
+                    <ArrowPathIcon className="w-4 h-4 animate-spin text-amber-400" />
+                    <span>Translating...</span>
+                  </>
+                ) : (
+                  <>
+                    <SparklesIcon className="w-4 h-4 text-amber-400" />
+                    <span>Translate</span>
+                  </>
+                )}
+              </button>
+            </div>
+          </div>
+
+          {/* Target Text Box */}
+          <div className="p-6 flex flex-col justify-between bg-gray-50/50 min-h-[300px]">
+            <div>
+              <div className="flex justify-between items-center mb-2">
+                <span className="text-xs font-semibold uppercase tracking-wider text-gray-500">
+                  {getLanguageName(targetLang)} Translation
+                </span>
+
+                <div className="flex items-center space-x-2">
+                  {engineUsed === 'chrome-builtin-ai' && (
+                    <span className="text-[11px] bg-green-100 text-green-800 font-semibold px-2 py-0.5 rounded-full">
+                      ⚡ Chrome Built-in AI
+                    </span>
+                  )}
+                  {engineUsed === 'cloud' && (
+                    <span className="text-[11px] bg-blue-100 text-blue-800 font-semibold px-2 py-0.5 rounded-full">
+                      🌐 Cloud Engine
+                    </span>
+                  )}
+                  {engineUsed === 'fallback' && (
+                    <span className="text-[11px] bg-amber-100 text-amber-800 font-semibold px-2 py-0.5 rounded-full">
+                      📖 Built-in Dictionary
+                    </span>
+                  )}
+                </div>
+              </div>
+
+              {isLoading ? (
+                <div className="py-12 flex flex-col items-center justify-center space-y-3 text-gray-400">
+                  <ArrowPathIcon className="w-8 h-8 animate-spin text-amber-500" />
+                  <p className="text-sm">Translating text...</p>
+                </div>
+              ) : translatedText ? (
+                <p className="text-base text-gray-900 leading-relaxed whitespace-pre-wrap select-text font-normal">
+                  {translatedText}
+                </p>
+              ) : (
+                <p className="text-sm text-gray-400 italic py-12 text-center">
+                  Translation will appear here after clicking "Translate".
+                </p>
+              )}
+            </div>
+
+            <div className="flex justify-between items-center pt-4 border-t border-gray-100 mt-4 text-xs text-gray-500">
+              <span>{translatedText ? `${translatedText.length} characters` : ''}</span>
+
+              {translatedText && (
+                <div className="flex items-center space-x-2">
+                  <button
+                    onClick={() => handleSpeak(translatedText, targetLang)}
+                    title={isSpeaking ? 'Stop listening' : 'Listen aloud'}
+                    className="flex items-center space-x-1 px-2.5 py-1.5 rounded hover:bg-gray-200 text-gray-700 transition"
+                  >
+                    {isSpeaking ? (
+                      <>
+                        <StopIcon className="w-4 h-4 text-red-500" />
+                        <span>Stop</span>
+                      </>
+                    ) : (
+                      <>
+                        <SpeakerWaveIcon className="w-4 h-4" />
+                        <span>Listen</span>
+                      </>
+                    )}
+                  </button>
+
+                  <button
+                    onClick={handleCopy}
+                    className="flex items-center space-x-1 px-2.5 py-1.5 rounded hover:bg-gray-200 text-gray-700 transition"
+                  >
+                    {copied ? (
+                      <>
+                        <ClipboardDocumentCheckIcon className="w-4 h-4 text-green-600" />
+                        <span className="text-green-600 font-medium">Copied!</span>
+                      </>
+                    ) : (
+                      <>
+                        <ClipboardIcon className="w-4 h-4" />
+                        <span>Copy</span>
+                      </>
+                    )}
+                  </button>
+                </div>
+              )}
+            </div>
+          </div>
+        </div>
+      </div>
+
+      {/* Preset News Articles to Translate */}
+      {sampleArticles && sampleArticles.length > 0 && (
+        <div className="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
+          <div className="flex items-center justify-between mb-4">
+            <h3 className="text-base font-bold text-gray-900">
+              Translate DevTools Times Headlines & Summaries
+            </h3>
+            <span className="text-xs text-gray-500">1-click translation test</span>
+          </div>
+
+          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
+            {sampleArticles.slice(0, 3).map((art) => (
+              <div
+                key={art.slug}
+                className="p-4 rounded-lg border border-gray-200 hover:border-amber-400 bg-gray-50 hover:bg-amber-50/30 transition flex flex-col justify-between"
+              >
+                <div>
+                  <h4 className="font-bold text-sm text-gray-900 mb-1 line-clamp-2">
+                    {art.title}
+                  </h4>
+                  <p className="text-xs text-gray-600 line-clamp-2 mb-3">
+                    {art.summary}
+                  </p>
+                </div>
+
+                <button
+                  onClick={() => handleLoadArticleSample(art)}
+                  className="text-xs font-semibold text-amber-700 hover:text-amber-800 flex items-center space-x-1 mt-auto"
+                >
+                  <SparklesIcon className="w-3.5 h-3.5" />
+                  <span>Load & Translate →</span>
+                </button>
+              </div>
+            ))}
+          </div>
+        </div>
+      )}
+
+      {/* Translation History */}
+      {history.length > 0 && (
+        <div className="bg-white border border-gray-200 rounded-xl p-6 shadow-xs">
+          <div className="flex items-center justify-between mb-4">
+            <h3 className="text-base font-bold text-gray-900">
+              Recent Translations ({history.length})
+            </h3>
+            <button
+              onClick={handleClearHistory}
+              className="text-xs text-red-600 hover:underline flex items-center space-x-1"
+            >
+              <TrashIcon className="w-3.5 h-3.5" />
+              <span>Clear History</span>
+            </button>
+          </div>
+
+          <div className="divide-y divide-gray-100 max-h-80 overflow-y-auto">
+            {history.map((item) => (
+              <div
+                key={item.id}
+                onClick={() => {
+                  setInputText(item.sourceText);
+                  setTranslatedText(item.translatedText);
+                  setSourceLang(item.sourceLang);
+                  setTargetLang(item.targetLang);
+                  setEngineUsed(item.engine);
+                }}
+                className="py-3 px-2 hover:bg-gray-50 rounded cursor-pointer transition flex flex-col sm:flex-row sm:items-center justify-between gap-2"
+              >
+                <div className="flex-1 min-w-0">
+                  <div className="flex items-center space-x-2 text-xs text-gray-400 mb-1">
+                    <span className="font-medium text-gray-600">
+                      {getLanguageName(item.sourceLang)} → {getLanguageName(item.targetLang)}
+                    </span>
+                    <span>•</span>
+                    <span>
+                      {new Date(item.timestamp).toLocaleTimeString([], {
+                        hour: '2-digit',
+                        minute: '2-digit'
+                      })}
+                    </span>
+                  </div>
+                  <p className="text-sm font-medium text-gray-900 truncate">{item.sourceText}</p>
+                  <p className="text-xs text-gray-600 truncate">{item.translatedText}</p>
+                </div>
+
+                <span className="text-[11px] text-amber-600 font-medium self-end sm:self-center shrink-0">
+                  Click to reload
+                </span>
+              </div>
+            ))}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
