@@ -0,0 +1,254 @@
+import type { APIRoute } from 'astro';
+import { detectLanguage } from '../../utils/languages';
+
+// Simple HTML entity decoder
+function decodeHtmlEntities(str: string): string {
+  return str
+    .replace(/&amp;/g, '&')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&#x27;/g, "'")
+    .replace(/&nbsp;/g, ' ');
+}
+
+// Fallback dictionary for basic news and common terms when offline / rate-limited
+const DICTIONARY: Record<string, Record<string, string>> = {
+  es: {
+    'the': 'el', 'a': 'un', 'an': 'un', 'in': 'en', 'on': 'en', 'at': 'en',
+    'to': 'a', 'for': 'para', 'with': 'con', 'and': 'y', 'or': 'o', 'but': 'pero',
+    'is': 'es', 'are': 'son', 'was': 'fue', 'were': 'fueron', 'will': 'será',
+    'news': 'noticias', 'report': 'informe', 'article': 'artículo', 'journalism': 'periodismo',
+    'world': 'mundo', 'city': 'ciudad', 'government': 'gobierno', 'public': 'público',
+    'technology': 'tecnología', 'science': 'ciencia', 'culture': 'cultura', 'sports': 'deportes',
+    'economy': 'economía', 'market': 'mercado', 'future': 'futuro', 'history': 'historia',
+    'new': 'nuevo', 'today': 'hoy', 'yesterday': 'ayer', 'tomorrow': 'mañana',
+    'hello': 'hola', 'goodbye': 'adiós', 'welcome': 'bienvenido', 'read': 'leer',
+    'breaking': 'de última hora', 'press': 'prensa', 'times': 'tiempos'
+  },
+  fr: {
+    'the': 'le', 'a': 'un', 'an': 'un', 'in': 'dans', 'on': 'sur', 'at': 'à',
+    'to': 'à', 'for': 'pour', 'with': 'avec', 'and': 'et', 'or': 'ou', 'but': 'mais',
