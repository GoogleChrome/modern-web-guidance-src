+import { detectLanguage } from './languages';
+
+export interface TranslationResult {
+  translatedText: string;
+  source: string;
+  target: string;
+  engine: 'chrome-builtin-ai' | 'cloud' | 'fallback' | 'identity';
+}
+
+export interface BatchTranslationResult {
+  translatedTexts: string[];
+  source: string;
+  target: string;
+  engine: 'chrome-builtin-ai' | 'cloud' | 'fallback' | 'identity';
+}
+
+export interface TranslationHistoryItem {
+  id: string;
+  sourceText: string;
+  translatedText: string;
+  sourceLang: string;
+  targetLang: string;
+  timestamp: number;
+  engine: string;
+}
+
+// Check Chrome Built-in AI Translator
+async function tryChromeBuiltInAI(text: string, source: string, target: string): Promise<string | null> {
+  if (typeof window === 'undefined') return null;
+
+  try {
+    const win = window as any;
+
+    // 1. W3C Translation API proposal (window.translation)
+    if (win.translation?.createTranslator) {
+      if (typeof win.translation.canTranslate === 'function') {
+        const can = await win.translation.canTranslate({
+          sourceLanguage: source,
+          targetLanguage: target
+        });
+        if (can === 'no') return null;
+      }
+      const translator = await win.translation.createTranslator({
+        sourceLanguage: source,
+        targetLanguage: target
+      });
+      return await translator.translate(text);
+    }
+
+    // 2. Global Translator interface (window.Translator)
+    if (win.Translator?.create) {
+      if (typeof win.Translator.availability === 'function') {
+        const avail = await win.Translator.availability({
+          sourceLanguage: source,
+          targetLanguage: target
+        });
+        if (avail === 'unavailable') return null;
+      }
+      const translator = await win.Translator.create({
+        sourceLanguage: source,
+        targetLanguage: target
+      });
+      return await translator.translate(text);
+    }
+
+    // 3. Early Chrome Built-in AI proposal (window.ai.translator)
+    if (win.ai?.translator?.create) {
+      if (typeof win.ai.translator.capabilities === 'function') {
+        const caps = await win.ai.translator.capabilities();
+        const available = caps?.available?.({
+          sourceLanguage: source,
+          targetLanguage: target
+        });
+        if (available === 'no') return null;
+      }
+      const translator = await win.ai.translator.create({
+        sourceLanguage: source,
+        targetLanguage: target
+      });
+      return await translator.translate(text);
+    }
+  } catch (err) {
+    console.warn('Chrome Built-in AI translation unavailable or failed:', err);
+  }
+
+  return null;
+}
+
+export async function translateText(
+  text: string,
+  sourceLang: string = 'auto',
+  targetLang: string = 'es',
+  baseUrl: string = '/'
+): Promise<TranslationResult> {
+  if (!text || !text.trim()) {
+    return {
+      translatedText: '',
+      source: sourceLang,
+      target: targetLang,
+      engine: 'identity'
+    };
+  }
+
+  const effectiveSource = sourceLang === 'auto' ? detectLanguage(text) : sourceLang.toLowerCase();
+  const effectiveTarget = targetLang.toLowerCase();
+
+  if (effectiveSource === effectiveTarget) {
+    return {
+      translatedText: text,
+      source: effectiveSource,
+      target: effectiveTarget,
+      engine: 'identity'
+    };
+  }
+
+  // 1. Try Chrome Built-in AI on-device translator first
+  const chromeResult = await tryChromeBuiltInAI(text, effectiveSource, effectiveTarget);
+  if (chromeResult) {
+    const result: TranslationResult = {
+      translatedText: chromeResult,
+      source: effectiveSource,
+      target: effectiveTarget,
+      engine: 'chrome-builtin-ai'
+    };
+    saveToHistory(text, chromeResult, effectiveSource, effectiveTarget, 'chrome-builtin-ai');
+    return result;
+  }
+
+  // 2. Fall back to backend /api/translate
+  const cleanBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+  const endpoint = `${cleanBase}api/translate`;
+
+  try {
+    const response = await fetch(endpoint, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        text,
+        source: effectiveSource,
+        target: effectiveTarget
+      })
+    });
+
+    if (response.ok) {
+      const data = await response.json();
+      const result: TranslationResult = {
+        translatedText: data.translatedText || text,
+        source: data.source || effectiveSource,
+        target: data.target || effectiveTarget,
+        engine: data.engine || 'cloud'
+      };
+      saveToHistory(text, result.translatedText, result.source, result.target, result.engine);
+      return result;
+    }
+  } catch (err) {
+    console.error('Translation network request failed:', err);
+  }
+
+  return {
+    translatedText: text,
+    source: effectiveSource,
+    target: effectiveTarget,
+    engine: 'fallback'
+  };
+}
+
+export async function translateBatch(
+  texts: string[],
+  sourceLang: string = 'auto',
+  targetLang: string = 'es',
+  baseUrl: string = '/'
+): Promise<BatchTranslationResult> {
+  if (!texts || texts.length === 0) {
+    return {
+      translatedTexts: [],
+      source: sourceLang,
+      target: targetLang,
+      engine: 'identity'
+    };
+  }
+
+  const sample = texts.find(t => t.trim().length > 0) || '';
+  const effectiveSource = sourceLang === 'auto' ? detectLanguage(sample) : sourceLang.toLowerCase();
+  const effectiveTarget = targetLang.toLowerCase();
+
+  if (effectiveSource === effectiveTarget) {
+    return {
+      translatedTexts: texts,
+      source: effectiveSource,
+      target: effectiveTarget,
+      engine: 'identity'
+    };
+  }
+
+  const cleanBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+  const endpoint = `${cleanBase}api/translate`;
+
+  try {
+    const response = await fetch(endpoint, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        texts,
+        source: effectiveSource,
+        target: effectiveTarget
+      })
+    });
+
+    if (response.ok) {
+      const data = await response.json();
+      return {
+        translatedTexts: data.translatedTexts || texts,
+        source: data.source || effectiveSource,
+        target: data.target || effectiveTarget,
+        engine: data.engine || 'cloud'
+      };
+    }
+  } catch (err) {
+    console.error('Batch translation request failed:', err);
+  }
+
+  return {
+    translatedTexts: texts,
+    source: effectiveSource,
+    target: effectiveTarget,
+    engine: 'fallback'
+  };
+}
+
+// Local Storage History Management
+const HISTORY_KEY = 'devtools_times_translation_history';
+
+export function getTranslationHistory(): TranslationHistoryItem[] {
+  if (typeof window === 'undefined') return [];
+  try {
+    const raw = localStorage.getItem(HISTORY_KEY);
+    return raw ? JSON.parse(raw) : [];
+  } catch {
+    return [];
+  }
+}
+
+export function saveToHistory(
+  sourceText: string,
+  translatedText: string,
+  sourceLang: string,
+  targetLang: string,
+  engine: string
+): void {
+  if (typeof window === 'undefined' || !sourceText.trim() || !translatedText.trim()) return;
+  try {
+    const current = getTranslationHistory();
+    const newItem: TranslationHistoryItem = {
+      id: `${Date.now()}-${Math.random().toString(36).substr(2, 6)}`,
+      sourceText: sourceText.trim(),
+      translatedText: translatedText.trim(),
+      sourceLang,
+      targetLang,
+      timestamp: Date.now(),
+      engine
+    };
+
+    // Filter out duplicates and limit to last 20
+    const filtered = current.filter(
+      item => !(item.sourceText === newItem.sourceText && item.targetLang === newItem.targetLang)
+    );
+    const updated = [newItem, ...filtered].slice(0, 20);
+    localStorage.setItem(HISTORY_KEY, JSON.stringify(updated));
+  } catch {
+    // Ignore localStorage errors
+  }
+}
+
+export function clearTranslationHistory(): void {
+  if (typeof window === 'undefined') return;
+  try {
+    localStorage.removeItem(HISTORY_KEY);
+  } catch {}
+}
