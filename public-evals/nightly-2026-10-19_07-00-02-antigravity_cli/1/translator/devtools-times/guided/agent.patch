+++ b/src/components/TranslateFlyout.tsx
@@ -0,0 +1,473 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  translateText,
+  isTranslatorSupported,
+  isLanguageDetectorSupported,
+  getLanguageName,
+} from '../utils/translator';
+
+interface Props {
+  initialText?: string;
+  initialTargetLanguage?: string;
+  onClose: () => void;
+}
+
+const SAMPLE_TEXTS = [
+  {
+    title: 'Breaking Tech News',
+    text: 'Researchers have unveiled a breakthrough in renewable battery technology that charges in seconds and lasts for weeks.',
+  },
+  {
+    title: 'City Architecture',
+    text: 'The historic district is undergoing an urban revitalisation project, combining modern sustainable materials with classical facades.',
+  },
+  {
+    title: 'Greetings & Welcome',
+    text: 'Welcome to The DevTools Times, your daily source for technology, culture, and investigative journalism.',
+  },
+];
+
+export default function TranslateFlyout({
+  initialText = '',
+  initialTargetLanguage = 'es',
+  onClose,
+}: Props) {
+  const [sourceText, setSourceText] = useState(initialText);
+  const [translatedText, setTranslatedText] = useState('');
+  const [sourceLanguage, setSourceLanguage] = useState('auto');
+  const [targetLanguage, setTargetLanguage] = useState(initialTargetLanguage);
+  const [isLoading, setIsLoading] = useState(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [activeEngine, setActiveEngine] = useState<'built-in-ai' | 'cloud-fallback' | 'identity' | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [copied, setCopied] = useState(false);
+  const [detectedLang, setDetectedLang] = useState<string | null>(null);
+
+  const textareaRef = useRef<HTMLTextAreaElement>(null);
+  const hasOnDeviceAI = isTranslatorSupported();
+  const hasLanguageDetector = isLanguageDetectorSupported();
+
+  useEffect(() => {
+    const handleKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') {
+        onClose();
+      } else if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
+        handleTranslate();
+      }
+    };
+    window.addEventListener('keydown', handleKeyDown);
+
+    // Focus input on mount
+    if (textareaRef.current) {
+      textareaRef.current.focus();
+    }
+
+    return () => {
+      window.removeEventListener('keydown', handleKeyDown);
+    };
+  }, [sourceText, sourceLanguage, targetLanguage]);
+
+  const handleTranslate = async () => {
+    if (!sourceText.trim()) {
+      setErrorMessage('Please enter some text to translate.');
+      return;
+    }
+
+    setIsLoading(true);
+    setErrorMessage(null);
+    setDownloadProgress(null);
+    setCopied(false);
+
+    try {
+      const result = await translateText({
+        text: sourceText,
+        sourceLanguage,
+        targetLanguage,
+        onProgress: (pct) => {
+          setDownloadProgress(pct);
+        },
+        onStreamChunk: (chunk) => {
+          setTranslatedText(chunk);
+        },
+      });
+
+      setTranslatedText(result.translatedText);
+      setActiveEngine(result.engine);
+      if (sourceLanguage === 'auto' && result.sourceLanguage) {
+        setDetectedLang(result.sourceLanguage);
+      }
+    } catch (err: any) {
+      console.error('Translation error:', err);
+      setErrorMessage(err.message || 'Failed to translate. Please try again.');
+    } finally {
+      setIsLoading(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  const handleSwap = () => {
+    if (sourceLanguage === 'auto') {
+      // If auto, swap target into source and default target to 'en'
+      setSourceLanguage(targetLanguage);
+      setTargetLanguage('en');
+    } else {
+      const tempLang = sourceLanguage;
+      setSourceLanguage(targetLanguage);
+      setTargetLanguage(tempLang);
+    }
+
+    if (translatedText) {
+      setSourceText(translatedText);
+      setTranslatedText(sourceText);
+    }
+  };
+
+  const handleCopy = async () => {
+    if (!translatedText) return;
+    try {
+      await navigator.clipboard.writeText(translatedText);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 2000);
+    } catch {
+      // Fallback copy
+      const ta = document.createElement('textarea');
+      ta.value = translatedText;
+      document.body.appendChild(ta);
+      ta.select();
+      document.execCommand('copy');
+      document.body.removeChild(ta);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 2000);
+    }
+  };
+
+  const handlePaste = async () => {
+    try {
+      const clipText = await navigator.clipboard.readText();
+      if (clipText) {
+        setSourceText(clipText);
+      }
+    } catch (e) {
+      console.warn('Clipboard read failed:', e);
+    }
+  };
+
+  const handleClear = () => {
+    setSourceText('');
+    setTranslatedText('');
+    setErrorMessage(null);
+    setActiveEngine(null);
+    setDetectedLang(null);
+    if (textareaRef.current) {
+      textareaRef.current.focus();
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 bg-black/40 backdrop-blur-xs z-[99999] flex justify-center items-start p-4 pt-[10vh] overflow-y-auto"
+      onClick={onClose}
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="translator-title"
+    >
+      <div
+        className="bg-white shadow-2xl w-full max-w-3xl rounded-lg border border-gray-200 overflow-hidden relative"
+        onClick={(e) => e.stopPropagation()}
+      >
+        {/* Header Bar */}
+        <div className="bg-gray-900 text-white px-6 py-4 flex items-center justify-between">
+          <div className="flex items-center space-x-3">
+            <div className="w-8 h-8 rounded-full bg-amber-400 text-gray-900 flex items-center justify-center font-bold text-sm">
+              文A
+            </div>
+            <div>
+              <h2 id="translator-title" className="text-lg font-bold font-brand tracking-wide">
+                The DevTools Times Translator
+              </h2>
+              <p className="text-xs text-gray-400">
+                On-device & multi-lingual text translation
+              </p>
+            </div>
+          </div>
+
+          <div className="flex items-center space-x-2">
+            {hasOnDeviceAI ? (
+              <span className="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-900/80 text-emerald-200 border border-emerald-700">
+                ● Built-in AI Ready
+              </span>
+            ) : (
+              <span className="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-gray-800 text-gray-300 border border-gray-700">
+                ☁ Cloud Service Active
+              </span>
+            )}
+            <button
+              onClick={onClose}
+              className="p-1 rounded-full text-gray-400 hover:text-white hover:bg-gray-800 transition"
+              aria-label="Close translator"
+            >
+              <svg className="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
+                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12" />
+              </svg>
+            </button>
+          </div>
+        </div>
+
+        {/* Content Body */}
+        <div className="p-6 space-y-4">
+          {/* Language Selector Controls */}
+          <div className="flex items-center justify-between gap-2 bg-gray-50 p-2.5 rounded-md border border-gray-200">
+            {/* Source Language */}
+            <div className="flex-1">
+              <label htmlFor="source-language" className="block text-[11px] font-semibold text-gray-500 uppercase tracking-wider mb-1">
+                From
+              </label>
+              <select
+                id="source-language"
+                value={sourceLanguage}
