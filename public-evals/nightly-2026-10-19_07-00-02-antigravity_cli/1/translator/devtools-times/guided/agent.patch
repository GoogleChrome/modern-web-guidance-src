@@ -0,0 +1,69 @@
+import React, { useState, useEffect } from 'react';
+import TranslateFlyout from './TranslateFlyout';
+
+export default function TranslateButton() {
+  const [isOpen, setIsOpen] = useState(false);
+  const [initialText, setInitialText] = useState('');
+  const [initialTargetLanguage, setInitialTargetLanguage] = useState('es');
+
+  useEffect(() => {
+    const handleOpenTranslator = (event: Event) => {
+      const customEvent = event as CustomEvent<{ text?: string; targetLanguage?: string }>;
+      if (customEvent.detail?.text) {
+        setInitialText(customEvent.detail.text);
+      }
+      if (customEvent.detail?.targetLanguage) {
+        setInitialTargetLanguage(customEvent.detail.targetLanguage);
+      }
+      setIsOpen(true);
+    };
+
+    window.addEventListener('open-translator', handleOpenTranslator);
+    return () => {
+      window.removeEventListener('open-translator', handleOpenTranslator);
+    };
+  }, []);
+
+  const handleOpen = () => {
+    setInitialText('');
+    setIsOpen(true);
+  };
+
+  const handleClose = () => {
+    setIsOpen(false);
+  };
+
+  return (
+    <>
+      <button
+        onClick={handleOpen}
+        className="text-gray-700 hover:text-amber-500 w-6 h-6 flex items-center justify-center transition"
+        title="Translate text"
+        aria-label="Open text translator"
+      >
+        <svg
+          xmlns="http://www.w3.org/2000/svg"
+          className="w-5 h-5"
+          fill="none"
+          viewBox="0 0 24 24"
+          strokeWidth="1.75"
+          stroke="currentColor"
+        >
+          <path
+            strokeLinecap="round"
+            strokeLinejoin="round"
+            d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+          />
+        </svg>
+      </button>
+
+      {isOpen && (
+        <TranslateFlyout
+          initialText={initialText}
+          initialTargetLanguage={initialTargetLanguage}
+          onClose={handleClose}
+        />
+      )}
+    </>
+  );
+}
