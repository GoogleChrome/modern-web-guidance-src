--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,295 @@
+/**
+ * Utility for on-device and fallback text translation.
+ * Uses Chrome/Edge Built-in AI Translator and LanguageDetector APIs when available,
+ * with graceful fallback to server-side translation.
+ */
+
+export interface LanguageOption {
+  code: string;
+  name: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'en', name: 'English' },
+  { code: 'es', name: 'Spanish' },
+  { code: 'fr', name: 'French' },
+  { code: 'de', name: 'German' },
+  { code: 'zh', name: 'Chinese (Simplified)' },
+  { code: 'zh-Hant', name: 'Chinese (Traditional)' },
+  { code: 'ja', name: 'Japanese' },
+  { code: 'ko', name: 'Korean' },
+  { code: 'it', name: 'Italian' },
+  { code: 'pt', name: 'Portuguese' },
+  { code: 'ru', name: 'Russian' },
+  { code: 'ar', name: 'Arabic' },
+  { code: 'hi', name: 'Hindi' },
+  { code: 'bn', name: 'Bengali' },
+  { code: 'bg', name: 'Bulgarian' },
+  { code: 'cs', name: 'Czech' },
+  { code: 'da', name: 'Danish' },
+  { code: 'el', name: 'Greek' },
+  { code: 'fi', name: 'Finnish' },
+  { code: 'he', name: 'Hebrew' },
+  { code: 'hr', name: 'Croatian' },
+  { code: 'hu', name: 'Hungarian' },
+  { code: 'id', name: 'Indonesian' },
+  { code: 'kn', name: 'Kannada' },
+  { code: 'lt', name: 'Lithuanian' },
+  { code: 'mr', name: 'Marathi' },
+  { code: 'nl', name: 'Dutch' },
+  { code: 'no', name: 'Norwegian' },
+  { code: 'pl', name: 'Polish' },
+  { code: 'ro', name: 'Romanian' },
+  { code: 'sk', name: 'Slovak' },
+  { code: 'sl', name: 'Slovenian' },
+  { code: 'sv', name: 'Swedish' },
+  { code: 'ta', name: 'Tamil' },
+  { code: 'te', name: 'Telugu' },
+  { code: 'th', name: 'Thai' },
+  { code: 'tr', name: 'Turkish' },
+  { code: 'uk', name: 'Ukrainian' },
+  { code: 'vi', name: 'Vietnamese' },
+];
+
+export function getLanguageName(code: string): string {
+  if (code === 'auto') return 'Auto-detect';
+  const found = SUPPORTED_LANGUAGES.find(l => l.code.toLowerCase() === code.toLowerCase());
+  return found ? found.name : code.toUpperCase();
+}
+
+/**
+ * Checks if the global Translator API is supported in the current environment.
+ * Note: Never checks window.ai.translator per modern web standards.
+ */
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self && typeof (self as any).Translator?.create === 'function';
+}
+
+/**
+ * Checks if the LanguageDetector API is supported in the current environment.
+ */
+export function isLanguageDetectorSupported(): boolean {
+  return typeof self !== 'undefined' && 'LanguageDetector' in self && typeof (self as any).LanguageDetector?.create === 'function';
+}
+
+export type ModelAvailability = 'available' | 'downloadable' | 'downloading' | 'unavailable' | 'unsupported';
+
+/**
+ * Check availability for a specific language pair using on-device Translator.
+ * Mandatory: Uses identical options structure for availability() and create().
+ */
+export async function checkTranslatorAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<ModelAvailability> {
+  if (!isTranslatorSupported()) {
+    return 'unsupported';
+  }
+
+  try {
+    const options = { sourceLanguage, targetLanguage };
+    const status = await (self as any).Translator.availability(options);
+    if (status === 'available' || status === 'readily') return 'available';
+    if (status === 'downloadable' || status === 'after-download') return 'downloadable';
+    if (status === 'downloading') return 'downloading';
+    return 'unavailable';
+  } catch (err) {
+    console.warn('Translator.availability check failed:', err);
+    return 'unavailable';
+  }
+}
+
+/**
+ * Detects the language of a text string using on-device LanguageDetector API.
+ */
+export async function detectLanguage(
+  text: string,
+  onProgress?: (percent: number) => void
+): Promise<{ language: string; confidence: number } | null> {
+  if (!text || text.trim().length === 0) return null;
+
+  if (isLanguageDetectorSupported()) {
+    try {
+      const avail = await (self as any).LanguageDetector.availability();
+      if (avail !== 'unavailable' && avail !== 'no') {
+        const detector = await (self as any).LanguageDetector.create({
+          monitor(m: any) {
+            m.addEventListener('downloadprogress', (e: any) => {
+              if (onProgress && e.total > 0) {
+                onProgress(Math.round((e.loaded / e.total) * 100));
+              } else if (onProgress && typeof e.loaded === 'number') {
+                onProgress(Math.round(e.loaded * 100));
+              }
+            });
+          },
+        });
+
+        const results = await detector.detect(text);
+        if (detector.destroy) detector.destroy();
+
+        if (results && results.length > 0) {
+          const top = results[0];
+          return {
+            language: top.detectedLanguage,
+            confidence: Math.round(top.confidence * 100),
+          };
+        }
+      }
+    } catch (e) {
+      console.warn('LanguageDetector failed, falling back:', e);
+    }
+  }
+
+  return null;
+}
+
+export interface TranslationResult {
+  translatedText: string;
+  sourceLanguage: string;
+  targetLanguage: string;
+  engine: 'built-in-ai' | 'cloud-fallback' | 'identity';
+}
+
+export interface TranslateOptions {
+  text: string;
+  sourceLanguage: string;
+  targetLanguage: string;
+  onProgress?: (percent: number) => void;
+  onStreamChunk?: (accumulatedText: string) => void;
+}
+
+/**
+ * Translates text between languages.
+ * Prioritizes on-device Translator API with streaming and download progress monitoring,
+ * falling back gracefully to remote translation endpoint if unsupported or unavailable.
+ */
+export async function translateText({
+  text,
+  sourceLanguage,
+  targetLanguage,
+  onProgress,
+  onStreamChunk,
+}: TranslateOptions): Promise<TranslationResult> {
+  if (!text || !text.trim()) {
+    return {
+      translatedText: '',
+      sourceLanguage,
+      targetLanguage,
+      engine: 'identity',
+    };
+  }
+
+  let effectiveSource = sourceLanguage;
+
+  // Resolve auto-detect if needed
+  if (effectiveSource === 'auto') {
+    const detected = await detectLanguage(text, onProgress);
+    if (detected && detected.language) {
+      effectiveSource = detected.language;
+    } else {
+      effectiveSource = 'en';
+    }
+  }
+
+  // Same language: no-op
+  if (effectiveSource.toLowerCase() === targetLanguage.toLowerCase()) {
+    return {
+      translatedText: text,
+      sourceLanguage: effectiveSource,
+      targetLanguage,
+      engine: 'identity',
+    };
+  }
+
+  // Check on-device Translator API support
+  if (isTranslatorSupported()) {
+    try {
+      const options = {
+        sourceLanguage: effectiveSource,
+        targetLanguage,
+      };
+
+      const availability = await (self as any).Translator.availability(options);
+
+      if (availability !== 'unavailable' && availability !== 'no') {
+        // Instantiate translator with download progress monitoring
+        const translator = await (self as any).Translator.create({
+          ...options,
+          monitor(m: any) {
+            m.addEventListener('downloadprogress', (e: any) => {
+              if (onProgress) {
+                const pct = e.total > 0 ? Math.round((e.loaded / e.total) * 100) : Math.round(e.loaded * 100);
+                onProgress(pct);
+              }
+            });
+          },
+        });
+
+        try {
+          // If streaming callback provided and supported, use translateStreaming
+          if (onStreamChunk && typeof translator.translateStreaming === 'function') {
+            const stream = translator.translateStreaming(text);
+            let fullResult = '';
+            for await (const chunk of stream) {
+              // translateStreaming may yield cumulative chunks or incremental deltas
+              fullResult = chunk;
+              onStreamChunk(fullResult);
+            }
+            if (translator.destroy) translator.destroy();
+            return {
+              translatedText: fullResult,
+              sourceLanguage: effectiveSource,
+              targetLanguage,
+              engine: 'built-in-ai',
+            };
+          }
+
+          // Standard translation
+          const result = await translator.translate(text);
+          if (translator.destroy) translator.destroy();
+          return {
+            translatedText: result,
+            sourceLanguage: effectiveSource,
+            targetLanguage,
+            engine: 'built-in-ai',
+          };
+        } catch (execError) {
+          console.warn('Translator execution error, falling back to server:', execError);
+          if (translator.destroy) translator.destroy();
+        }
+      }
+    } catch (createError) {
+      console.warn('Translator creation error, falling back to server:', createError);
+    }
+  }
+
+  // Fallback: Remote server endpoint
+  try {
+    const rawBase = import.meta.env.BASE_URL || '/';
+    const cleanBase = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
+    const response = await fetch(`${cleanBase}api/translate`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        text,
+        sourceLanguage: effectiveSource,
+        targetLanguage,
+      }),
+    });
+
+    if (!response.ok) {
+      throw new Error(`Server translation failed with status: ${response.status}`);
+    }
+
+    const data = await response.json();
+    return {
+      translatedText: data.translatedText || text,
+      sourceLanguage: data.detectedSourceLanguage || effectiveSource,
+      targetLanguage,
+      engine: 'cloud-fallback',
+    };
+  } catch (fallbackError: any) {
+    console.error('All translation options failed:', fallbackError);
+    throw new Error(`Translation failed: ${fallbackError.message || 'Network error'}`);
+  }
+}
