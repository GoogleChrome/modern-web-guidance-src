index 0000000..59187cf
--- /dev/null
+++ b/src/pages/api/translate.ts
@@ -0,0 +1,163 @@
+import type { APIRoute } from 'astro';
+
+function decodeHtmlEntities(str: string): string {
+  return str
+    .replace(/&amp;/g, '&')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&#x2F;/g, '/');
+}
+
+async function translateChunk(chunk: string, sourceLang: string, targetLang: string): Promise<string> {
+  const pair = `${sourceLang === 'auto' ? 'autodetect' : sourceLang}|${targetLang}`;
+  const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(chunk)}&langpair=${encodeURIComponent(pair)}`;
+  
+  const res = await fetch(url, {
+    headers: { 'Accept': 'application/json' },
+    signal: AbortSignal.timeout(6000),
+  });
+
+  if (!res.ok) {
+    throw new Error(`Translation API responded with ${res.status}`);
+  }
+
+  const data = await res.json();
+  if (data?.responseData?.translatedText) {
+    return decodeHtmlEntities(data.responseData.translatedText);
+  }
+  throw new Error('Invalid response data from translation API');
+}
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const { text, sourceLanguage = 'en', targetLanguage = 'es' } = body;
+
+    if (!text || typeof text !== 'string') {
+      return new Response(JSON.stringify({ error: 'Text is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const trimmed = text.trim();
+    if (!trimmed) {
+      return new Response(JSON.stringify({ translatedText: '' }), {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (sourceLanguage !== 'auto' && sourceLanguage === targetLanguage) {
+      return new Response(JSON.stringify({ translatedText: text, provider: 'identity' }), {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const effectiveSource = sourceLanguage === 'auto' ? 'en' : sourceLanguage;
+
+    // If text is short, translate directly
+    if (trimmed.length <= 450) {
+      try {
+        const translated = await translateChunk(trimmed, effectiveSource, targetLanguage);
+        return new Response(
+          JSON.stringify({
+            translatedText: translated,
+            provider: 'cloud-api',
+          }),
+          {
+            status: 200,
+            headers: { 'Content-Type': 'application/json' },
+          }
+        );
+      } catch (err: any) {
+        console.warn('Translate chunk error:', err.message);
+      }
+    } else {
+      // Split into paragraphs or chunks
+      const paragraphs = trimmed.split(/\n\s*\n/);
+      const translatedParagraphs: string[] = [];
+
+      for (const p of paragraphs) {
+        const pTrimmed = p.trim();
+        if (!pTrimmed) {
+          translatedParagraphs.push('');
+          continue;
+        }
+
+        if (pTrimmed.length <= 450) {
+          try {
+            const tr = await translateChunk(pTrimmed, effectiveSource, targetLanguage);
+            translatedParagraphs.push(tr);
+          } catch {
+            translatedParagraphs.push(pTrimmed);
+          }
+        } else {
+          // Split paragraph by sentences
+          const sentences = pTrimmed.match(/[^.!?]+[.!?]+(\s|$)|[^.!?]+$/g) || [pTrimmed];
+          let currentChunk = '';
+          const chunkResults: string[] = [];
+
+          for (const s of sentences) {
+            if ((currentChunk + s).length > 400 && currentChunk) {
+              try {
+                const tr = await translateChunk(currentChunk.trim(), effectiveSource, targetLanguage);
+                chunkResults.push(tr);
+              } catch {
+                chunkResults.push(currentChunk.trim());
+              }
+              currentChunk = s;
+            } else {
+              currentChunk += s;
+            }
+          }
+
+          if (currentChunk.trim()) {
+            try {
+              const tr = await translateChunk(currentChunk.trim(), effectiveSource, targetLanguage);
+              chunkResults.push(tr);
+            } catch {
+              chunkResults.push(currentChunk.trim());
+            }
+          }
+
+          translatedParagraphs.push(chunkResults.join(' '));
+        }
+      }
+
+      return new Response(
+        JSON.stringify({
+          translatedText: translatedParagraphs.join('\n\n'),
+          provider: 'cloud-api',
+        }),
+        {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    // Fallback if network was unavailable
+    return new Response(
+      JSON.stringify({
+        translatedText: `[${targetLanguage.toUpperCase()}] ${text}`,
+        provider: 'fallback-echo',
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (error: any) {
+    return new Response(
+      JSON.stringify({ error: error.message || 'Internal translation error' }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
