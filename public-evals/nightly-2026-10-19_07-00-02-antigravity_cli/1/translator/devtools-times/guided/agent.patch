+import React, { useState, useEffect } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  translateText,
+  getLanguageName,
+  isTranslatorSupported,
+} from '../utils/translator';
+
+interface Props {
+  articleTitle: string;
+  articleSummary: string;
+}
+
+export default function ArticleTranslator({ articleTitle, articleSummary }: Props) {
+  const [selectedLanguage, setSelectedLanguage] = useState('es');
+  const [isTranslating, setIsTranslating] = useState(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [translatedData, setTranslatedData] = useState<{
+    title: string;
+    summary: string;
+    language: string;
+    engine: string;
+  } | null>(null);
+  const [showTranslated, setShowTranslated] = useState(false);
+  const [selectedPageText, setSelectedPageText] = useState('');
+
+  const hasOnDeviceAI = isTranslatorSupported();
+
+  // Listen for user text selection on the page
+  useEffect(() => {
+    const handleSelectionChange = () => {
+      const selection = window.getSelection();
+      const text = selection ? selection.toString().trim() : '';
+      if (text.length > 3 && text.length < 500) {
+        setSelectedPageText(text);
+      } else {
+        setSelectedPageText('');
+      }
+    };
+
+    document.addEventListener('selectionchange', handleSelectionChange);
+    return () => {
+      document.removeEventListener('selectionchange', handleSelectionChange);
+    };
+  }, []);
+
+  const handleTranslateArticle = async () => {
+    setIsTranslating(true);
+    setDownloadProgress(null);
+
+    try {
+      // Translate title and summary
+      const [titleRes, summaryRes] = await Promise.all([
+        translateText({
+          text: articleTitle,
+          sourceLanguage: 'en',
+          targetLanguage: selectedLanguage,
+          onProgress: (pct) => setDownloadProgress(pct),
+        }),
+        translateText({
+          text: articleSummary,
+          sourceLanguage: 'en',
+          targetLanguage: selectedLanguage,
+        }),
+      ]);
+
+      setTranslatedData({
+        title: titleRes.translatedText,
+        summary: summaryRes.translatedText,
+        language: selectedLanguage,
+        engine: titleRes.engine,
+      });
+      setShowTranslated(true);
+
+      // Also translate article body paragraphs in DOM if present
+      const articleBody = document.querySelector('.article-body-content');
+      if (articleBody) {
+        const paragraphs = Array.from(articleBody.querySelectorAll('p'));
+        for (const p of paragraphs) {
+          const original = p.getAttribute('data-original-text') || p.innerText;
+          if (!p.hasAttribute('data-original-text')) {
+            p.setAttribute('data-original-text', original);
+          }
+          translateText({
+            text: original,
+            sourceLanguage: 'en',
+            targetLanguage: selectedLanguage,
+          }).then((res) => {
+            p.innerText = res.translatedText;
+          }).catch(console.warn);
+        }
+      }
+
+      // Update main title and summary in DOM for immersive reading
+      const domTitle = document.querySelector('.article-main-title');
+      const domSummary = document.querySelector('.article-main-summary');
+      if (domTitle) {
+        if (!domTitle.getAttribute('data-original-title')) {
+          domTitle.setAttribute('data-original-title', domTitle.textContent || '');
+        }
+        domTitle.textContent = titleRes.translatedText;
+      }
+      if (domSummary) {
+        if (!domSummary.getAttribute('data-original-summary')) {
+          domSummary.setAttribute('data-original-summary', domSummary.textContent || '');
+        }
+        domSummary.textContent = summaryRes.translatedText;
+      }
+    } catch (err) {
+      console.error('Failed to translate article:', err);
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  const handleToggleView = (viewTranslated: boolean) => {
+    setShowTranslated(viewTranslated);
+    const domTitle = document.querySelector('.article-main-title');
+    const domSummary = document.querySelector('.article-main-summary');
+    const articleBody = document.querySelector('.article-body-content');
+
+    if (viewTranslated && translatedData) {
+      if (domTitle) domTitle.textContent = translatedData.title;
+      if (domSummary) domSummary.textContent = translatedData.summary;
+      if (articleBody) {
+        const paragraphs = Array.from(articleBody.querySelectorAll('p'));
+        paragraphs.forEach((p) => {
+          const translated = p.getAttribute('data-translated-text');
+          if (translated) p.innerText = translated;
+        });
+      }
+    } else {
+      if (domTitle && domTitle.getAttribute('data-original-title')) {
+        domTitle.textContent = domTitle.getAttribute('data-original-title');
+      }
+      if (domSummary && domSummary.getAttribute('data-original-summary')) {
+        domSummary.textContent = domSummary.getAttribute('data-original-summary');
+      }
+      if (articleBody) {
+        const paragraphs = Array.from(articleBody.querySelectorAll('p'));
+        paragraphs.forEach((p) => {
+          const original = p.getAttribute('data-original-text');
+          if (original) p.innerText = original;
+        });
+      }
+    }
+  };
+
+  const openInTranslatorTool = (textToOpen?: string) => {
+    const text = textToOpen || `${articleTitle}\n\n${articleSummary}`;
+    window.dispatchEvent(
+      new CustomEvent('open-translator', {
+        detail: {
+          text,
+          targetLanguage: selectedLanguage,
+        },
+      })
+    );
+  };
+
+  return (
+    <div className="my-4 p-3 bg-gray-50 border border-gray-200 rounded-lg text-sm">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        {/* Left: Language Selection and Action */}
+        <div className="flex flex-wrap items-center gap-2">
+          <span className="flex items-center text-gray-700 font-semibold text-xs">
+            <svg
+              className="w-4 h-4 mr-1 text-amber-500"
+              fill="none"
+              viewBox="0 0 24 24"
+              stroke="currentColor"
+              strokeWidth="2"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+            Translate Article:
+          </span>
+
+          <select
+            value={selectedLanguage}
+            onChange={(e) => setSelectedLanguage(e.target.value)}
+            disabled={isTranslating}
+            className="bg-white border border-gray-300 rounded px-2 py-1 text-xs font-medium text-gray-700 focus:ring-1 focus:ring-amber-400 focus:outline-none"
+          >
+            {SUPPORTED_LANGUAGES.filter((l) => l.code !== 'en').map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.name}
+              </option>
+            ))}
+          </select>
+
+          <button
+            type="button"
+            onClick={handleTranslateArticle}
+            disabled={isTranslating}
+            className="px-3 py-1 bg-amber-400 hover:bg-amber-500 disabled:opacity-50 text-gray-900 rounded text-xs font-bold transition flex items-center space-x-1"
+          >
+            {isTranslating ? (
+              <>
+                <div className="w-3 h-3 border-2 border-gray-900 border-t-transparent rounded-full animate-spin mr-1" />
+                <span>Translating...</span>
+              </>
+            ) : (
+              <span>Translate</span>
+            )}
+          </button>
+
+          {/* Switch toggle if translated */}
+          {translatedData && (
+            <div className="inline-flex rounded-md shadow-xs bg-white border border-gray-300 p-0.5 text-xs">
+              <button
+                type="button"
+                onClick={() => handleToggleView(false)}
+                className={`px-2 py-0.5 rounded transition ${
+                  !showTranslated
+                    ? 'bg-gray-800 text-white font-bold'
+                    : 'text-gray-600 hover:text-gray-900'
+                }`}
+              >
+                English
+              </button>
+              <button
+                type="button"
+                onClick={() => handleToggleView(true)}
+                className={`px-2 py-0.5 rounded transition ${
+                  showTranslated
+                    ? 'bg-amber-400 text-gray-900 font-bold'
+                    : 'text-gray-600 hover:text-gray-900'
+                }`}
+              >
+                {getLanguageName(translatedData.language)}
+              </button>
+            </div>
+          )}
+        </div>
+
+        {/* Right: Tools & Status */}
+        <div className="flex items-center space-x-2">
+          {selectedPageText && (
+            <button
+              type="button"
+              onClick={() => openInTranslatorTool(selectedPageText)}
+              className="text-xs bg-amber-100 hover:bg-amber-200 text-amber-900 px-2.5 py-1 rounded border border-amber-300 font-medium transition flex items-center space-x-1"
+            >
+              <span>Translate Selection</span>
+            </button>
+          )}
+
+          <button
+            type="button"
+            onClick={() => openInTranslatorTool()}
+            className="text-xs text-gray-600 hover:text-gray-900 underline font-medium"
+          >
+            Open Translator Tool
+          </button>
+
+          {hasOnDeviceAI ? (
+            <span
+              className="text-[10px] text-emerald-700 font-medium bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded"
+              title="Using on-device Gemini Nano/Chrome Built-in AI"
+            >
+              ⚡ On-Device AI
+            </span>
+          ) : (
+            <span
+              className="text-[10px] text-gray-500 font-medium bg-gray-100 border border-gray-200 px-1.5 py-0.5 rounded"
+              title="Using fallback translation service"
+            >
+              ☁ Cloud Service
+            </span>
+          )}
+        </div>
+      </div>
+
+      {/* Download progress bar */}
+      {downloadProgress !== null && (
+        <div className="mt-2 pt-2 border-t border-gray-200">
+          <div className="flex justify-between text-xs text-amber-800 mb-1">
+            <span>Downloading on-device translation model...</span>
+            <span className="font-bold">{downloadProgress}%</span>
+          </div>
+          <div className="w-full bg-amber-200 rounded-full h-1.5 overflow-hidden">
+            <div
+              className="bg-amber-500 h-1.5 rounded-full transition-all duration-200"
+              style={{ width: `${downloadProgress}%` }}
+            />
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
