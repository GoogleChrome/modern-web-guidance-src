+      // Compute exact UI placement coordinates in CSS pixels
+      function getUIGeometry() {
+        const cssWidth = canvas.clientWidth || 800;
+        const cssHeight = canvas.clientHeight || 520;
+        let uiX, uiY, uiWidth;
+
+        if (cssWidth >= 740) {
+          uiWidth = 370;
+          uiX = cssWidth - uiWidth - 32;
+          uiY = Math.max(24, Math.round((cssHeight - 440) / 2));
+        } else {
+          uiWidth = Math.max(280, cssWidth - 32);
+          uiX = Math.round((cssWidth - uiWidth) / 2);
+          uiY = 220;
+        }
+
+        return { uiX, uiY, uiWidth, cssWidth, cssHeight };
+      }
+
+      // Sync fallback DOM position so interactive controls align exactly with canvas
+      function syncFallbackLayout() {
+        if (!isHtmlInCanvasSupported) {
+          const { uiX, uiY, uiWidth } = getUIGeometry();
+          uiElement.style.left = uiX + 'px';
+          uiElement.style.top = uiY + 'px';
+          uiElement.style.width = uiWidth + 'px';
+        }
+      }
+
+      // High-DPI canvas scaling via ResizeObserver (device-pixel-content-box with DPR fallback)
+      const supportsDevicePixelContentBox =
