+            }
+            ctx.fill();
+            ctx.stroke();
+          });
+        } else {
+          // Artisan warm paper cup body
+          const cupGrad = ctx.createLinearGradient(cupX - cupTopW / 2, topY, cupX + cupTopW / 2, topY);
+          cupGrad.addColorStop(0, '#f9f6f0');
+          cupGrad.addColorStop(0.35, '#ffffff');
+          cupGrad.addColorStop(0.85, '#eee4d8');
