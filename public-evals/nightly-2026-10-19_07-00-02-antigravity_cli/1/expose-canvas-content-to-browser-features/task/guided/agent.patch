+
+        const sleeveGrad = ctx.createLinearGradient(cupX - sleeveTopW / 2, sleeveY, cupX + sleeveTopW / 2, sleeveY);
+        sleeveGrad.addColorStop(0, '#be946c');
+        sleeveGrad.addColorStop(0.3, '#d8b087');
+        sleeveGrad.addColorStop(0.85, '#be946c');
