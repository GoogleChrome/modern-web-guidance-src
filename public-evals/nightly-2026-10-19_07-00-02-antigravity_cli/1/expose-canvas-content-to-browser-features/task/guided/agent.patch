+
+      // Draw coffee cup on 2D canvas context
+      function drawCoffeeCup(cssWidth, cssHeight, uiX) {
+        let cupX, cupY, cupScale;
+
+        if (cssWidth >= 740) {
+          cupX = Math.round(uiX / 2);
+          cupY = Math.round(cssHeight * 0.53);
+          cupScale = 1.0;
+        } else {
+          cupX = Math.round(cssWidth / 2);
+          cupY = 110;
+          cupScale = 0.65;
+        }
+
+        const size = sizeSelect.value;
+        if (size === 'small') cupScale *= 0.88;
+        else if (size === 'large') cupScale *= 1.12;
+
+        const customerName = (nameInput.value || '').trim() || 'Your Name';
+        const milk = milkSelect.value;
+        const syrup = syrupSelect.value;
+        const isIced = tempSelect.value === 'iced';
+
+        const milkData = milkColors[milk] || milkColors.oat;
+        const syrupData = syrupColors[syrup] || syrupColors.maple;
+
+        // Soft shadow underneath cup
+        ctx.save();
+        ctx.beginPath();
+        const shadowY = cupY + 98 * cupScale;
+        ctx.ellipse(cupX, shadowY, 68 * cupScale, 12 * cupScale, 0, 0, Math.PI * 2);
+        ctx.fillStyle = 'rgba(62, 39, 35, 0.16)';
+        ctx.fill();
