+          icedGrad.addColorStop(1, milkData.liquid);
+          ctx.fillStyle = icedGrad;
+          ctx.fill();
+
+          // Ice cubes
+          ctx.fillStyle = 'rgba(255, 255, 255, 0.42)';
+          ctx.strokeStyle = 'rgba(255, 255, 255, 0.7)';
+          ctx.lineWidth = 1.5;
+          const cubes = [
+            { x: cupX - 30 * cupScale, y: topY + 25 * cupScale, s: 22 * cupScale },
+            { x: cupX + 8 * cupScale, y: topY + 30 * cupScale, s: 24 * cupScale },
+            { x: cupX - 10 * cupScale, y: topY + 52 * cupScale, s: 20 * cupScale }
+          ];
+          cubes.forEach(c => {
+            ctx.beginPath();
+            if (typeof ctx.roundRect === 'function') {
+              ctx.roundRect(c.x, c.y, c.s, c.s, 4 * cupScale);
+            } else {
