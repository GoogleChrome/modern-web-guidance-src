+        oat: { liquid: '#be9670', tint: '#dcbe9d', label: 'Oat Milk' },
+        almond: { liquid: '#caa37e', tint: '#e4c9ad', label: 'Almond Milk' },
+        skim: { liquid: '#dec1a5', tint: '#f2e0ce', label: 'Skim Milk' },
