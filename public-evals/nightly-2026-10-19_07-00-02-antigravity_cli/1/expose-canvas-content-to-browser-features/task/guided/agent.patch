+
+      const syrupColors = {
+        none: { tag: '#8d6e63', label: 'No Syrup' },
+        maple: { tag: '#d97706', label: 'Maple' },
+        vanilla: { tag: '#ca8a04', label: 'Vanilla' },
+        caramel: { tag: '#b45309', label: 'Caramel' },
+        hazelnut: { tag: '#92400e', label: 'Hazelnut' },
