+    }
+
+    .store-select:hover {
+      border-color: var(--accent);
+    }
+
+    .store-select:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    /* Arrow icon rotation transition */
+    select::picker-icon,
+    .store-select::picker-icon,
+    ::picker-icon {
+      color: var(--primary);
+      margin-left: 12px;
+      transition: transform 0.3s ease, rotate 0.3s ease;
+    }
+
+    select:open::picker-icon,
+    .store-select:open::picker-icon,
+    :open::picker-icon {
+      transform: rotate(180deg);
+      rotate: 180deg;
+    }
+
+    /* Native picker menu smooth fade in / fade out */
+    ::picker(select) {
+      background-color: #ffffff;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
+      opacity: 0;
+      transition: opacity 0.3s ease, display 0.3s ease allow-discrete, overlay 0.3s ease allow-discrete;
+      transition-behavior: allow-discrete;
+    }
+
+    :open::picker(select),
+    select:open::picker(select) {
+      opacity: 1;
+    }
+
+    @starting-style {
+      :open::picker(select),
+      select:open::picker(select) {
+        opacity: 0;
+      }
+    }
+
+    ::picker(select) option {
+      padding: 10px 14px;
+      border-radius: 4px;
+      cursor: pointer;
+      transition: background-color 0.15s ease, color 0.15s ease;
+    }
+
+    ::picker(select) option:hover,
+    ::picker(select) option:focus {
+      background-color: var(--secondary);
+      color: var(--primary);
+    }
+
+    ::picker(select) option:checked {
+      background-color: var(--primary);
+      color: white;
+    }
