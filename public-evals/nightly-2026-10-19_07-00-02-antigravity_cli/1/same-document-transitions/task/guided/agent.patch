+
+    let activeThumbnail = null;
+
+    function populateDetail(item) {
+      const detailImg = document.getElementById('detail-image');
+      const detailTitle = document.getElementById('title');
+      const detailPrice = document.getElementById('detail-price');
+      const detailDesc = document.getElementById('detail-description');
+      const detailNotes = document.getElementById('detail-notes');
+
+      detailImg.src = item.image;
+      detailImg.alt = item.title;
+      detailTitle.textContent = item.title;
+      detailPrice.textContent = item.price;
+      detailDesc.textContent = item.description;
+      detailNotes.textContent = item.notes;
+    }
+
+    function cleanUpTransitionClasses() {
+      document.querySelectorAll('.thumbnail').forEach((el) => {
+        el.classList.remove('selected');
+        el.style.viewTransitionName = '';
+        const t = el.querySelector('.title');
+        if (t) t.style.viewTransitionName = '';
+      });
+    }
+
+    function goFromListToDetail(thumbnail, item) {
+      activeThumbnail = thumbnail;
+
+      // Populate detail view before transition
+      populateDetail(item);
+
+      // Assign temporary selected class to clicked thumbnail
+      thumbnail.classList.add('selected');
+
+      const updateDOM = () => {
+        document.getElementById('list-page').hidden = true;
+        document.getElementById('detail-page').hidden = false;
+      };
+
+      if (!document.startViewTransition) {
+        updateDOM();
+        cleanUpTransitionClasses();
+        document.getElementById('title')?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        updateDOM();
+      });
+
+      transition.finished.finally(() => {
+        cleanUpTransitionClasses();
+        document.getElementById('title')?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      const listPage = document.getElementById('list-page');
+      const detailPage = document.getElementById('detail-page');
+
+      // Re-apply selected class to target thumbnail for morph-back animation
+      if (activeThumbnail) {
+        activeThumbnail.classList.add('selected');
+      }
+
+      const updateDOM = () => {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+      };
+
+      if (!document.startViewTransition) {
+        updateDOM();
+        cleanUpTransitionClasses();
+        document.getElementById('list-heading')?.focus();
+        activeThumbnail = null;
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        updateDOM();
+      });
+
+      transition.finished.finally(() => {
+        cleanUpTransitionClasses();
+        document.getElementById('list-heading')?.focus();
+        activeThumbnail = null;
+      });
+    }
+
+    // Event Listeners for thumbnails
+    document.querySelectorAll('.thumbnail').forEach((card) => {
+      card.addEventListener('click', (e) => {
+        e.preventDefault();
+        const id = card.getAttribute('data-id');
+        const item = seasonalData[id];
+        if (item) {
+          goFromListToDetail(card, item);
+        }
+      });
+
+      card.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
