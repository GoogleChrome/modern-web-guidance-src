+  <script>
+    (() => {
+      // Progressive enhancement fallback for browsers without scroll-initial-target support
+      const initTargetScroll = () => {
+        if (!CSS.supports || !CSS.supports('scroll-initial-target', 'nearest')) {
+          const target = document.querySelector('.target');
+          if (target) {
+            target.scrollIntoView({ behavior: 'instant', block: 'nearest' });
+          }
+        }
+      };
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initTargetScroll);
+      } else {
+        initTargetScroll();
+      }
+    })();
+  </script>
