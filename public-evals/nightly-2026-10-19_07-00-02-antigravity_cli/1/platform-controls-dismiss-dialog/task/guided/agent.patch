+  <script>
+    const modal = document.getElementById('coffee-modal');
+    const modalTitle = document.getElementById('modal-title');
+    const modalDescription = document.getElementById('modal-description');
+    const modalImage = document.getElementById('modal-image');
+    const modalNotes = document.getElementById('modal-notes');
+    const modalPrice = document.getElementById('modal-price');
+    const closeBtn = document.getElementById('modal-close-btn');
+    const showDetailsButtons = document.querySelectorAll('.show-details-btn');
+
+    showDetailsButtons.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const card = btn.closest('.card');
+        const title = btn.dataset.title || card?.querySelector('h3')?.textContent || '';
+        const description = btn.dataset.description || card?.querySelector('p')?.textContent || '';
+        const image = btn.dataset.image || '';
+        const notes = btn.dataset.notes || '';
+        const price = btn.dataset.price || '';
+
+        modalTitle.textContent = title;
+        modalDescription.textContent = description;
+        if (modalImage && image) {
+          modalImage.src = image;
+          modalImage.alt = title;
+        }
+        if (modalNotes && notes) {
+          modalNotes.textContent = notes;
+        }
+        if (modalPrice && price) {
+          modalPrice.textContent = price;
+        }
+
+        modal.showModal();
+      });
+    });
+
+    closeBtn.addEventListener('click', () => {
+      modal.close();
+    });
+
+    // Light-dismiss click outside modal content box fallback
+    modal.addEventListener('click', (event) => {
+      if (event.target !== modal) return;
+
+      const rect = modal.getBoundingClientRect();
+      const isDialogContent = (
+        rect.width > 0 &&
+        rect.height > 0 &&
+        rect.top <= event.clientY &&
+        event.clientY <= rect.top + rect.height &&
+        rect.left <= event.clientX &&
+        event.clientX <= rect.left + rect.width
+      );
+
+      if (isDialogContent) return;
+
+      modal.close();
+    });
+
+    // Escape key handling
+    modal.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') {
+        modal.close();
+      }
+    });
+
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && modal.open) {
+        modal.close();
+      }
+    });
+  </script>
+
