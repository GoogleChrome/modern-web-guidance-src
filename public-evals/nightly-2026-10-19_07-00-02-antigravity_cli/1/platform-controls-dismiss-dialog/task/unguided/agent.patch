+        <button type="button" class="btn close-btn" id="modal-close-btn" aria-label="Close">Close</button>
+      </div>
+      <div class="modal-body">
+        <img id="modal-img" class="modal-img" src="" alt="" />
+        <p id="modal-description" class="modal-desc"></p>
+        <p id="modal-details" class="modal-details"></p>
