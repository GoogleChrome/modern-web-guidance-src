+  <!-- Coffee Details Modal -->
+  <dialog id="coffee-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-describedby="modal-description">
+    <div class="modal-box" id="modal-box">
+      <div class="modal-header">
