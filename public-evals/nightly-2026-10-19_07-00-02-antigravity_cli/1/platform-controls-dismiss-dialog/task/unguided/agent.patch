+
+  <script>
+    (function () {
+      const coffeeData = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          details: 'Crafted with our signature espresso, lightly steamed artisan oat milk, and 100% pure organic Vermont maple syrup. Finished with a delicate dusting of cinnamon.',
+          price: '$5.75',
+          roast: 'Medium Roast',
+          calories: '190 kcal',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Maple Oat Latte'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          details: 'A rich, full-bodied espresso pulled from carefully selected high-altitude Arabica beans. Featuring notes of dark chocolate, toasted walnut, and a velvety crema.',
+          price: '$3.75',
+          roast: 'Dark Roast',
+          calories: '5 kcal',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Dark Roast Espresso'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          details: 'Slow-steeped in cold filtered water for 18 hours to extract natural sweetness and deep cacao notes with zero bitterness and exceptionally low acidity.',
+          price: '$4.50',
+          roast: 'Medium-Dark',
+          calories: '5 kcal',
+          image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Cold Brew'
+        }
+      };
+
+      const modal = document.getElementById('coffee-modal');
+      const modalBox = document.getElementById('modal-box');
+      const modalTitle = document.getElementById('modal-title');
+      const modalDescription = document.getElementById('modal-description');
+      const modalDetails = document.getElementById('modal-details');
+      const modalImg = document.getElementById('modal-img');
+      const modalPrice = document.getElementById('modal-price');
+      const modalRoast = document.getElementById('modal-roast');
+      const modalCalories = document.getElementById('modal-calories');
+      const closeBtn = document.getElementById('modal-close-btn');
+      let lastFocusedElement = null;
+
+      function isModalOpen() {
+        return modal.hasAttribute('open');
+      }
+
+      function openModal(coffee) {
+        modalTitle.textContent = coffee.title;
+        modalDescription.textContent = coffee.description;
+        modalDetails.textContent = coffee.details;
+        modalImg.src = coffee.image;
+        modalImg.alt = coffee.imageAlt;
+        modalPrice.textContent = coffee.price;
+        modalRoast.textContent = coffee.roast;
+        modalCalories.textContent = coffee.calories;
+
+        lastFocusedElement = document.activeElement;
+
+        if (typeof modal.showModal === 'function') {
+          if (!modal.open) {
+            modal.showModal();
+          }
+        } else {
+          modal.setAttribute('open', '');
+        }
+        modal.setAttribute('aria-hidden', 'false');
+        closeBtn.focus();
+      }
+
+      function closeModal() {
+        if (!isModalOpen() && modal.getAttribute('aria-hidden') === 'true') {
+          return;
+        }
+        if (typeof modal.close === 'function' && modal.open) {
+          modal.close();
+        }
+        modal.removeAttribute('open');
+        modal.setAttribute('aria-hidden', 'true');
+        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
+          lastFocusedElement.focus();
+        }
+      }
+
+      // Open modal on clicking Show Details
+      document.querySelectorAll('.show-details-btn').forEach(btn => {
+        btn.addEventListener('click', (e) => {
+          e.stopPropagation();
+          const key = btn.dataset.coffee;
+          const card = btn.closest('.card');
+          const cardTitle = card ? card.querySelector('h3')?.textContent.trim() : '';
+          const cardDesc = card ? card.querySelector('p')?.textContent.trim() : '';
+
+          const coffee = coffeeData[key] || {
+            title: cardTitle || 'Coffee Details',
+            description: cardDesc || '',
+            details: 'Freshly brewed and handcrafted with ethically sourced beans.',
+            price: '$4.50',
+            roast: 'Artisanal Roast',
+            calories: 'Varies',
+            image: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=800&q=80',
+            imageAlt: cardTitle || 'Coffee'
+          };
+
+          openModal(coffee);
+        });
+      });
+
+      // Close button handler
+      closeBtn.addEventListener('click', (e) => {
+        e.stopPropagation();
+        closeModal();
+      });
+
+      // Escape key to dismiss
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' || e.key === 'Esc') {
+          if (isModalOpen()) {
+            closeModal();
+          }
+        }
+      });
+
+      // Native dialog cancel event
+      modal.addEventListener('cancel', (e) => {
+        e.preventDefault();
+        closeModal();
+      });
+
+      // Light-dismiss: click outside the modal box
+      modal.addEventListener('click', (e) => {
+        if (!isModalOpen()) return;
+        const rect = modalBox.getBoundingClientRect();
+        const clickedInBox = (
+          e.clientX >= rect.left &&
+          e.clientX <= rect.right &&
+          e.clientY >= rect.top &&
+          e.clientY <= rect.bottom
+        );
+        if (!clickedInBox || !modalBox.contains(e.target)) {
+          closeModal();
+        }
+      });
+
+      // Also listen on document for light dismiss in non-modal / backdrop cases
+      document.addEventListener('click', (e) => {
+        if (!isModalOpen()) return;
+        if (e.target.closest('.show-details-btn')) return;
+        const rect = modalBox.getBoundingClientRect();
+        const clickedInBox = (
+          e.clientX >= rect.left &&
+          e.clientX <= rect.right &&
+          e.clientY >= rect.top &&
+          e.clientY <= rect.bottom
+        );
+        if (!clickedInBox && !modalBox.contains(e.target)) {
+          closeModal();
+        }
+      });
+    })();
+  </script>
