+  <script>
+    (function () {
+      function initGallery() {
+        const gallery = document.getElementById('gallery');
+        if (!gallery) return;
+
+        const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+        const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+        function getClosestIndex() {
+          const scrollLeft = gallery.scrollLeft;
+          let closestIndex = 0;
+          let minDistance = Infinity;
+
+          items.forEach((item, index) => {
+            const itemLeft = (item.offsetParent === gallery)
+              ? item.offsetLeft
+              : (item.getBoundingClientRect().left - gallery.getBoundingClientRect().left + gallery.scrollLeft);
+            const distance = Math.abs(itemLeft - scrollLeft);
+            if (distance < minDistance) {
+              minDistance = distance;
+              closestIndex = index;
+            }
+          });
+
+          return closestIndex;
+        }
+
+        function resolveItemIndex(event) {
+          let target = event?.snapTargetInline ?? event?.snapTargetBlock;
+          if (!target && event?.detail) {
+            target = event.detail.snapTargetInline ?? event.detail.snapTargetBlock ?? event.detail.target;
+          }
+          if (!target && event?.target && event.target !== gallery) {
+            target = event.target;
+          }
+
+          if (typeof target === 'number' && target >= 0 && target < items.length) {
+            return target;
+          }
+          if (typeof target === 'string') {
+            const el = document.querySelector(target);
+            if (el) target = el;
+          }
+          if (target && target instanceof Node) {
+            const itemEl = target.classList?.contains('gallery-item') ? target : target.closest?.('.gallery-item');
+            if (itemEl) {
+              const idx = items.indexOf(itemEl);
+              if (idx !== -1) return idx;
+            }
+          }
+
+          return getClosestIndex();
+        }
+
+        function setPendingThumbnail(index) {
+          thumbnails.forEach((thumb, i) => {
+            if (i === index) {
+              thumb.classList.add('pending');
+            } else {
+              thumb.classList.remove('pending');
+            }
+          });
+        }
+
+        function setActiveThumbnail(index) {
+          thumbnails.forEach((thumb, i) => {
+            thumb.classList.remove('pending');
+            if (i === index) {
+              thumb.classList.add('active');
+              thumb.setAttribute('aria-current', 'true');
+            } else {
+              thumb.classList.remove('active');
+              thumb.removeAttribute('aria-current');
+            }
+          });
+        }
+
+        // Real-time visual feedback while user is mid-scroll
+        gallery.addEventListener('scrollsnapchanging', (event) => {
+          const index = resolveItemIndex(event);
+          if (index !== -1) {
+            setPendingThumbnail(index);
+          }
+        });
+
+        // Finalized snap target once scroll finishes
+        gallery.addEventListener('scrollsnapchange', (event) => {
+          const index = resolveItemIndex(event);
+          if (index !== -1) {
+            setActiveThumbnail(index);
+          }
+        });
+
+        // Clean up and confirm selection on scroll completion
+        gallery.addEventListener('scrollend', (event) => {
+          const index = resolveItemIndex(event);
+          if (index !== -1) {
+            setActiveThumbnail(index);
+          }
+        });
+
+        // Fallback for browsers/environments without native scrollsnapchanging support
+        if (!('onscrollsnapchanging' in window)) {
+          let scrollTimeout;
+          gallery.addEventListener('scroll', () => {
+            const index = getClosestIndex();
+            setPendingThumbnail(index);
+
+            clearTimeout(scrollTimeout);
+            scrollTimeout = setTimeout(() => {
+              const finalIndex = getClosestIndex();
+              setActiveThumbnail(finalIndex);
+            }, 120);
+          }, { passive: true });
+        }
+
+        // Thumbnail button click navigation
+        thumbnails.forEach((thumb, index) => {
+          thumb.addEventListener('click', () => {
+            const itemLeft = (items[index].offsetParent === gallery)
+              ? items[index].offsetLeft
+              : (items[index].getBoundingClientRect().left - gallery.getBoundingClientRect().left + gallery.scrollLeft);
+
+            gallery.scrollTo({
+              left: itemLeft,
+              behavior: 'smooth'
+            });
+          });
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initGallery);
+      } else {
+        initGallery();
+      }
+    })();
+  </script>
