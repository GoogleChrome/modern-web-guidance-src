new file mode 100644
index 0000000..c772d3a
--- /dev/null
+++ b/test/crypto.test.js
@@ -0,0 +1,229 @@
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  detectCapabilities,
+  supportsPostQuantumEnvelope,
+  generateRecipientKeys,
+  encapsulateEnvelopeKey,
+  decapsulateEnvelopeKey,
+  encryptMessage,
+  decryptMessage,
+  encryptEnvelope,
+  decryptEnvelope,
+  toBase64,
+  fromBase64,
+  toHex,
+  fromHex,
+} from '../crypto-envelope.js';
+
+describe('WebCrypto Capabilities and Diagnostics', () => {
+  test('detectCapabilities returns expected shape and boolean flags', () => {
+    const caps = detectCapabilities();
+    assert.equal(typeof caps.supportsStaticCheck, 'boolean');
+    assert.equal(typeof caps.postQuantumSupported, 'boolean');
+    assert.equal(typeof caps.aesGcm, 'boolean');
+    assert.equal(caps.aesGcm, true, 'AES-GCM must be supported');
+  });
+
+  test('SubtleCrypto.supports detects algorithm capabilities statically', () => {
+    const supported = supportsPostQuantumEnvelope();
+    // In Node 24, ML-KEM-768 is supported
+    assert.equal(typeof supported, 'boolean');
+  });
+});
+
+describe('Encoding Utilities', () => {
+  test('toBase64 and fromBase64 round-trip', () => {
+    const input = new Uint8Array([0, 1, 2, 127, 128, 254, 255, 42, 99]);
+    const b64 = toBase64(input);
+    const output = fromBase64(b64);
+    assert.deepEqual(output, input);
+  });
+
+  test('toHex and fromHex round-trip', () => {
+    const input = new Uint8Array([0xde, 0xad, 0xbe, 0xef, 0x01, 0x02]);
+    const hex = toHex(input);
+    assert.equal(hex.toLowerCase(), 'deadbeef0102');
+    const output = fromHex(hex);
+    assert.deepEqual(output, input);
+  });
+});
+
+describe('Authenticated Encryption with Associated Data (AEAD)', () => {
+  test('encryptMessage and decryptMessage with AES-GCM and fresh 12-byte IV', async () => {
+    const key = await crypto.subtle.generateKey(
+      { name: 'AES-GCM', length: 256 },
+      false,
+      ['encrypt', 'decrypt']
+    );
+
+    const plaintext = 'Artisanal Single-Origin Espresso #49281';
+    const aad = new TextEncoder().encode('orderId:991');
+
+    const res1 = await encryptMessage(key, plaintext, aad);
+    const res2 = await encryptMessage(key, plaintext, aad);
+
+    // Verify IV freshness: each message must have a unique random 12-byte IV
+    assert.equal(res1.iv.byteLength, 12);
+    assert.equal(res2.iv.byteLength, 12);
+    assert.notDeepEqual(res1.iv, res2.iv, 'Each encryption must use a distinct 12-byte IV');
+
+    const decrypted = await decryptMessage(key, res1.iv, res1.ciphertext, aad);
+    assert.equal(decrypted, plaintext);
+  });
+
+  test('encryptMessage and decryptMessage with ChaCha20-Poly1305 if supported', async () => {
+    const caps = detectCapabilities();
+    if (!caps.chaCha20Poly1305) {
+      return;
+    }
+
+    const key = await crypto.subtle.generateKey(
+      'ChaCha20-Poly1305',
+      false,
+      ['encrypt', 'decrypt']
+    );
+
+    const plaintext = 'Cold brew steeped for 24 hours at 4C';
+    const aad = new TextEncoder().encode('batch:2026-10-19');
+
+    const { iv, ciphertext } = await encryptMessage(key, plaintext, aad);
+    assert.equal(iv.byteLength, 12);
+
+    const decrypted = await decryptMessage(key, iv, ciphertext, aad);
+    assert.equal(decrypted, plaintext);
+  });
+
+  test('Tampering with ciphertext causes OperationError rejection', async () => {
+    const key = await crypto.subtle.generateKey(
+      { name: 'AES-GCM', length: 256 },
+      false,
+      ['encrypt', 'decrypt']
+    );
+
+    const plaintext = 'Confidential roasting formula';
+    const aad = new TextEncoder().encode('meta');
+    const { iv, ciphertext } = await encryptMessage(key, plaintext, aad);
+
+    const tamperedCiphertext = new Uint8Array(ciphertext);
+    tamperedCiphertext[tamperedCiphertext.length - 1] ^= 0x01; // flip 1 bit
+
+    await assert.rejects(
+      async () => {
+        await decryptMessage(key, iv, tamperedCiphertext, aad);
+      },
+      (err) => err.name === 'OperationError',
+      'Tampered ciphertext must be rejected with OperationError'
+    );
+  });
+
+  test('Tampering with Associated Data (AAD) causes OperationError rejection', async () => {
+    const key = await crypto.subtle.generateKey(
+      { name: 'AES-GCM', length: 256 },
+      false,
+      ['encrypt', 'decrypt']
+    );
+
+    const plaintext = 'Secret Customer Notes';
+    const originalAad = new TextEncoder().encode('userId:123');
+    const tamperedAad = new TextEncoder().encode('userId:999'); // modified metadata
+    const { iv, ciphertext } = await encryptMessage(key, plaintext, originalAad);
+
+    await assert.rejects(
+      async () => {
+        await decryptMessage(key, iv, ciphertext, tamperedAad);
+      },
+      (err) => err.name === 'OperationError',
+      'Tampered AAD metadata must be rejected with OperationError'
+    );
+  });
+});
+
+describe('Classical Key Agreement Fallback (X25519 + HKDF + AES-GCM)', () => {
+  test('Full roundtrip encapsulation and decapsulation with X25519', async () => {
+    const recipient = await generateRecipientKeys({ preferredSuite: 'X25519' });
+    assert.equal(recipient.algorithm, 'X25519');
+    assert.equal(recipient.publicKeyBytes.byteLength, 32);
+
+    // Sender encapsulates shared key using recipient public key bytes
+    const enc = await encapsulateEnvelopeKey(recipient.publicKeyBytes);
+    assert.equal(enc.capsuleBytes.byteLength, 32);
+    assert.equal(enc.algorithm, 'X25519');
+
+    // Recipient recovers shared key using private key and capsule bytes
+    const decKey = await decapsulateEnvelopeKey(recipient.keyPair.privateKey, enc.capsuleBytes);
+
+    // Verify both derived keys encrypt/decrypt identically
+    const plaintext = 'Classical fallback payload';
+    const aad = new TextEncoder().encode('order:classic-1');
+    const { iv, ciphertext } = await encryptMessage(enc.sharedKey, plaintext, aad);
+    const decrypted = await decryptMessage(decKey, iv, ciphertext, aad);
+    assert.equal(decrypted, plaintext);
+  });
+});
+
+describe('Post-Quantum Key Encapsulation (ML-KEM / MLKEM768-X25519)', () => {
+  test('Full roundtrip encapsulation and decapsulation with ML-KEM-768', async () => {
+    const caps = detectCapabilities();
+    if (!caps.mlKem768) {
+      return;
+    }
+
+    const recipient = await generateRecipientKeys({ preferredSuite: 'ML-KEM-768' });
+    assert.equal(recipient.algorithm, 'ML-KEM-768');
+    assert.equal(recipient.publicKeyBytes.byteLength, 1184);
+
+    // Sender encapsulates shared key
+    const enc = await encapsulateEnvelopeKey(recipient.publicKeyBytes);
+    assert.equal(enc.algorithm, 'ML-KEM-768');
+    assert.equal(enc.capsuleBytes.byteLength, 1088);
+
+    // Recipient decapsulates
+    const decKey = await decapsulateEnvelopeKey(
+      recipient.keyPair.privateKey,
+      enc.capsuleBytes,
+      { sharedKeyAlgorithm: enc.aeadAlgorithm }
+    );
+
+    const plaintext = 'Quantum-safe artisanal blend secret';
+    const aad = new TextEncoder().encode('aad:pq-demo');
+    const { iv, ciphertext } = await encryptMessage(enc.sharedKey, plaintext, aad);
+    const decrypted = await decryptMessage(decKey, iv, ciphertext, aad);
+    assert.equal(decrypted, plaintext);
+  });
+
+  test('High-level encryptEnvelope and decryptEnvelope end-to-end', async () => {
+    const recipient = await generateRecipientKeys();
+
+    const sensitiveOrder = JSON.stringify({
+      item: 'Maple Oat Latte Reserve',
+      quantity: 2,
+      grindSize: 'Coarse',
+      cardToken: 'tok_pq_coffee_9874',
+    });
+
+    const envelope = await encryptEnvelope(recipient.publicKeyBytes, sensitiveOrder, {
+      additionalData: 'daily-grind:order:2026-10-19',
+    });
+
+    assert.ok(envelope.capsule);
+    assert.ok(envelope.iv);
+    assert.ok(envelope.ciphertext);
+    assert.ok(envelope.additionalData);
+
+    const decrypted = await decryptEnvelope(recipient.keyPair.privateKey, envelope);
+    assert.equal(decrypted, sensitiveOrder);
+
+    // Tampering test on envelope
+    const tamperedEnvelope = {
+      ...envelope,
+      ciphertext: toBase64(new Uint8Array([1, 2, 3, 4, 5])),
+    };
+    await assert.rejects(
+      async () => {
+        await decryptEnvelope(recipient.keyPair.privateKey, tamperedEnvelope);
+      },
+      (err) => err.name === 'OperationError'
+    );
+  });
+});
