+/**
+ * Client-Side Encryption with Post-Quantum & Hybrid Key Encapsulation (KEM),
+ * Classical Key Agreement Fallback, and Authenticated Encryption (AEAD).
+ *
+ * Implements modern Web Cryptography API standards:
+ * - Hybrid Post-Quantum: MLKEM768-X25519 + ChaCha20-Poly1305 / AES-GCM
+ * - Post-Quantum: ML-KEM-768, ML-KEM-1024
+ * - Classical Fallback: X25519 + HKDF-SHA256 + AES-GCM
+ * - Authenticated Encryption with Associated Data (AEAD)
+ * - Structured Clone persistence in IndexedDB for non-extractable keys
+ */
+
+export const KEM_PUBLIC_KEY_ALGORITHMS = {
+  1184: 'ML-KEM-768',
+  1216: 'MLKEM768-X25519',
+  1568: 'ML-KEM-1024',
+};
+
+export const KEM_CIPHERTEXT_LENGTHS = {
+  'MLKEM768-X25519': 1120,
+  'ML-KEM-768': 1088,
+  'ML-KEM-1024': 1568,
+  'X25519': 32,
+};
+
+/**
+ * Safe helper to check SubtleCrypto.supports static method.
+ * Note: Must be called on SubtleCrypto constructor, NOT crypto.subtle.
+ * @param {string} op
+ * @param  {...any} args
+ * @returns {boolean}
+ */
+export function checkSubtleSupport(op, ...args) {
+  try {
+    if (typeof globalThis.SubtleCrypto?.supports === 'function') {
+      return SubtleCrypto.supports(op, ...args);
+    }
+  } catch (err) {
+    // Unsupported parameters or algorithm
+  }
+  return false;
+}
+
+/**
+ * Detect available cryptographic capabilities in the current browser/runtime.
+ */
+export function detectCapabilities() {
+  const dummyIv = new Uint8Array(12);
+
+  const hasHybrid = checkSubtleSupport('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305') ||
+                    checkSubtleSupport('encapsulateKey', 'MLKEM768-X25519', 'AES-GCM');
+  const hasMlkem768 = checkSubtleSupport('encapsulateKey', 'ML-KEM-768', 'ChaCha20-Poly1305') ||
+                      checkSubtleSupport('encapsulateKey', 'ML-KEM-768', 'AES-GCM');
+  const hasMlkem1024 = checkSubtleSupport('encapsulateKey', 'ML-KEM-1024', 'ChaCha20-Poly1305') ||
+                       checkSubtleSupport('encapsulateKey', 'ML-KEM-1024', 'AES-GCM');
+  const hasChaCha = checkSubtleSupport('encrypt', { name: 'ChaCha20-Poly1305', iv: dummyIv }) ||
+                    checkSubtleSupport('generateKey', 'ChaCha20-Poly1305');
+  const hasAesGcm = checkSubtleSupport('encrypt', { name: 'AES-GCM', iv: dummyIv }) ||
+                    checkSubtleSupport('generateKey', { name: 'AES-GCM', length: 256 }) ||
+                    true; // AES-GCM is Baseline widely available since 2017
+  const hasX25519 = checkSubtleSupport('generateKey', 'X25519') ||
+                    typeof crypto?.subtle?.deriveBits === 'function';
+
+  return {
+    supportsStaticCheck: typeof globalThis.SubtleCrypto?.supports === 'function',
+    hybridMLKEM768X25519: hasHybrid,
+    mlKem768: hasMlkem768,
+    mlKem1024: hasMlkem1024,
+    chaCha20Poly1305: hasChaCha,
+    aesGcm: hasAesGcm,
+    x25519: hasX25519,
+    postQuantumSupported: hasHybrid || hasMlkem768 || hasMlkem1024,
+  };
+}
+
+/**
+ * Checks if post-quantum envelope encryption is natively supported.
+ */
+export function supportsPostQuantumEnvelope() {
+  return (
+    checkSubtleSupport('encapsulateKey', 'MLKEM768-X25519', 'ChaCha20-Poly1305') ||
+    checkSubtleSupport('encapsulateKey', 'MLKEM768-X25519', 'AES-GCM') ||
+    checkSubtleSupport('encapsulateKey', 'ML-KEM-768', 'ChaCha20-Poly1305') ||
+    checkSubtleSupport('encapsulateKey', 'ML-KEM-768', 'AES-GCM')
+  );
+}
+
+/**
+ * Determines the best supported post-quantum or classical suite.
+ * @param {string} [preferredSuite] Optional preference ('MLKEM768-X25519', 'ML-KEM-768', 'ML-KEM-1024', 'X25519')
+ */
+export function selectBestSuite(preferredSuite) {
+  const caps = detectCapabilities();
+
+  if (preferredSuite === 'MLKEM768-X25519' && caps.hybridMLKEM768X25519) {
+    return {
+      kem: 'MLKEM768-X25519',
+      aead: caps.chaCha20Poly1305 ? 'ChaCha20-Poly1305' : 'AES-GCM',
+      type: 'hybrid-pq',
+    };
+  }
+  if (preferredSuite === 'ML-KEM-768' && caps.mlKem768) {
+    return {
+      kem: 'ML-KEM-768',
+      aead: caps.chaCha20Poly1305 ? 'ChaCha20-Poly1305' : 'AES-GCM',
+      type: 'pure-pq',
+    };
+  }
+  if (preferredSuite === 'ML-KEM-1024' && caps.mlKem1024) {
+    return {
+      kem: 'ML-KEM-1024',
+      aead: 'AES-GCM',
+      type: 'pure-pq-high',
+    };
+  }
+  if (preferredSuite === 'X25519') {
+    return {
+      kem: 'X25519',
+      aead: 'AES-GCM',
+      type: 'classical-fallback',
+    };
+  }
+
+  // Auto-selection based on capabilities:
+  if (caps.hybridMLKEM768X25519) {
+    return {
+      kem: 'MLKEM768-X25519',
+      aead: caps.chaCha20Poly1305 ? 'ChaCha20-Poly1305' : 'AES-GCM',
+      type: 'hybrid-pq',
+    };
+  }
+  if (caps.mlKem768) {
+    return {
+      kem: 'ML-KEM-768',
+      aead: caps.chaCha20Poly1305 ? 'ChaCha20-Poly1305' : 'AES-GCM',
+      type: 'pure-pq',
+    };
+  }
+  if (caps.mlKem1024) {
+    return {
+      kem: 'ML-KEM-1024',
+      aead: 'AES-GCM',
+      type: 'pure-pq-high',
+    };
+  }
+
+  // Classical fallback
+  return {
+    kem: 'X25519',
+    aead: 'AES-GCM',
+    type: 'classical-fallback',
+  };
+}
+
+/**
+ * Generate recipient key pair.
+ * Uses post-quantum KEM if supported or preferred; falls back to classical X25519.
+ *
+ * @param {Object} [options]
+ * @param {string} [options.preferredSuite] - e.g. 'MLKEM768-X25519', 'ML-KEM-768', 'ML-KEM-1024', 'X25519'
+ * @param {boolean} [options.extractable=false] - Non-extractable keys can be stored safely in IndexedDB
+ * @returns {Promise<{suite: string, keyPair: CryptoKeyPair, publicKeyBytes: Uint8Array}>}
+ */
+export async function generateRecipientKeys(options = {}) {
+  const { preferredSuite, extractable = false } = options;
+  const suite = selectBestSuite(preferredSuite);
+
+  if (suite.kem !== 'X25519') {
+    // Generate KEM key pair
+    const keyPair = await crypto.subtle.generateKey(
+      suite.kem,
+      extractable,
+      ['encapsulateKey', 'decapsulateKey']
+    );
+    // KEM public keys must be exported with 'raw-public'
+    const publicKeyBuffer = await crypto.subtle.exportKey('raw-public', keyPair.publicKey);
+    const publicKeyBytes = new Uint8Array(publicKeyBuffer);
+    return {
+      suite: `${suite.kem}+${suite.aead}`,
+      algorithm: suite.kem,
+      aeadAlgorithm: suite.aead,
+      keyPair,
+      publicKeyBytes,
+    };
+  }
+
+  // Classical fallback: X25519 key agreement + HKDF + AES-GCM
+  const keyPair = await crypto.subtle.generateKey('X25519', extractable, ['deriveBits', 'deriveKey']);
+  // Classical X25519 public key exported as 'raw'
+  const publicKeyBuffer = await crypto.subtle.exportKey('raw', keyPair.publicKey);
+  const publicKeyBytes = new Uint8Array(publicKeyBuffer);
+  return {
+    suite: 'X25519+HKDF+AES-GCM',
+    algorithm: 'X25519',
+    aeadAlgorithm: 'AES-GCM',
+    keyPair,
+    publicKeyBytes,
+  };
+}
+
+/**
+ * Derives a symmetric AEAD key from X25519 shared secret using HKDF.
+ * Used for classical fallback.
+ */
+async function deriveFallbackAesKey(privateKey, peerPublicKey, infoBytes = new Uint8Array(0)) {
+  const sharedSecret = await crypto.subtle.deriveBits(
+    { name: 'X25519', public: peerPublicKey },
+    privateKey,
+    256
+  );
+  const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt: new Uint8Array(32),
+      info: infoBytes,
+    },
+    hkdfKey,
+    { name: 'AES-GCM', length: 256 },
+    false,
+    ['encrypt', 'decrypt']
+  );
+}
+
+/**
+ * Encapsulate a shared AEAD key using recipient's public key.
+ *
+ * @param {CryptoKey|Uint8Array|ArrayBuffer} recipientPublicKeyOrBytes
+ * @param {Object} [options]
+ * @param {string} [options.sharedKeyAlgorithm] - 'ChaCha20-Poly1305' or 'AES-GCM'
+ * @param {Uint8Array} [options.infoBytes] - Context/domain separation info
+ * @returns {Promise<{sharedKey: CryptoKey, capsuleBytes: Uint8Array, algorithm: string, aeadAlgorithm: string}>}
+ */
+export async function encapsulateEnvelopeKey(recipientPublicKeyOrBytes, options = {}) {
+  const { infoBytes = new Uint8Array(0) } = options;
+
+  let pubKey;
+  if (recipientPublicKeyOrBytes instanceof CryptoKey) {
+    pubKey = recipientPublicKeyOrBytes;
+  } else {
+    const bytes = recipientPublicKeyOrBytes instanceof Uint8Array
+      ? recipientPublicKeyOrBytes
+      : new Uint8Array(recipientPublicKeyOrBytes);
+
+    const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+    if (kemName) {
+      pubKey = await crypto.subtle.importKey(
+        'raw-public',
+        bytes,
+        kemName,
+        true,
+        ['encapsulateKey']
+      );
+    } else {
+      // 32-byte classical X25519
+      pubKey = await crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+    }
+  }
+
+  const kemName = pubKey.algorithm.name;
+
+  if (kemName !== 'X25519') {
+    // Choose AEAD algorithm
+    let sharedKeyAlg = options.sharedKeyAlgorithm;
+    if (!sharedKeyAlg) {
+      const caps = detectCapabilities();
+      sharedKeyAlg = caps.chaCha20Poly1305 ? 'ChaCha20-Poly1305' : 'AES-GCM';
+    }
+
+    // Try direct encapsulation with AEAD key
+    try {
+      const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+        kemName,
+        pubKey,
+        sharedKeyAlg,
+        false,
+        ['encrypt', 'decrypt']
+      );
+      return {
+        sharedKey,
+        capsuleBytes: new Uint8Array(ciphertext),
+        algorithm: kemName,
+        aeadAlgorithm: sharedKeyAlg,
+      };
+    } catch (err) {
+      // If direct AEAD encapsulation throws, encapsulate with HKDF for domain separation
+      const { sharedKey: hkdfBaseKey, ciphertext } = await crypto.subtle.encapsulateKey(
+        kemName,
+        pubKey,
+        'HKDF',
+        false,
+        ['deriveKey']
+      );
+      const derivedKey = await crypto.subtle.deriveKey(
+        {
+          name: 'HKDF',
+          hash: 'SHA-256',
+          salt: new Uint8Array(32),
+          info: infoBytes,
+        },
+        hkdfBaseKey,
+        { name: 'AES-GCM', length: 256 },
+        false,
+        ['encrypt', 'decrypt']
+      );
+      return {
+        sharedKey: derivedKey,
+        capsuleBytes: new Uint8Array(ciphertext),
+        algorithm: kemName,
+        aeadAlgorithm: 'AES-GCM',
+      };
+    }
+  }
+
+  // Classical fallback: generate ephemeral X25519 key pair and send ephemeral public key as capsule
+  const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits', 'deriveKey']);
+  const capsuleBytes = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+  const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+  return {
+    sharedKey,
+    capsuleBytes,
+    algorithm: 'X25519',
+    aeadAlgorithm: 'AES-GCM',
+  };
+}
+
+/**
+ * Decapsulate shared AEAD key from capsule using recipient's private key.
+ *
+ * @param {CryptoKey} recipientPrivateKey
+ * @param {Uint8Array|ArrayBuffer} capsuleBytes
+ * @param {Object} [options]
+ * @param {string} [options.sharedKeyAlgorithm] - 'ChaCha20-Poly1305' or 'AES-GCM'
+ * @param {Uint8Array} [options.infoBytes]
+ * @returns {Promise<CryptoKey>}
+ */
+export async function decapsulateEnvelopeKey(recipientPrivateKey, capsuleBytes, options = {}) {
+  const { infoBytes = new Uint8Array(0) } = options;
+  const capsule = capsuleBytes instanceof Uint8Array ? capsuleBytes : new Uint8Array(capsuleBytes);
+  const kemName = recipientPrivateKey.algorithm.name;
+
+  if (kemName !== 'X25519') {
+    let sharedKeyAlg = options.sharedKeyAlgorithm;
+    if (!sharedKeyAlg) {
+      const caps = detectCapabilities();
+      sharedKeyAlg = caps.chaCha20Poly1305 ? 'ChaCha20-Poly1305' : 'AES-GCM';
+    }
+
+    try {
+      return await crypto.subtle.decapsulateKey(
+        kemName,
+        recipientPrivateKey,
+        capsule,
+        sharedKeyAlg,
+        false,
+        ['encrypt', 'decrypt']
+      );
+    } catch (err) {
+      // Try HKDF decapsulation
+      const recBaseKey = await crypto.subtle.decapsulateKey(
+        kemName,
+        recipientPrivateKey,
+        capsule,
+        'HKDF',
+        false,
+        ['deriveKey']
+      );
+      return crypto.subtle.deriveKey(
+        {
+          name: 'HKDF',
+          hash: 'SHA-256',
+          salt: new Uint8Array(32),
+          info: infoBytes,
+        },
+        recBaseKey,
+        { name: 'AES-GCM', length: 256 },
+        false,
+        ['encrypt', 'decrypt']
+      );
+    }
+  }
+
+  // Classical fallback: import ephemeral public key from capsule
+  const ephemeralPubKey = await crypto.subtle.importKey('raw', capsule, 'X25519', true, []);
+  return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+}
+
+/**
+ * Encrypts UTF-8 text with an AEAD CryptoKey ('ChaCha20-Poly1305' or 'AES-GCM').
+ * Uses a fresh 12-byte (96-bit) IV for every message.
+ *
+ * @param {CryptoKey} key
+ * @param {string|Uint8Array} plaintext
+ * @param {Uint8Array} [additionalData]
+ * @returns {Promise<{iv: Uint8Array, ciphertext: Uint8Array}>}
+ */
+export async function encryptMessage(key, plaintext, additionalData = new Uint8Array(0)) {
+  // Always generate a fresh 12-byte (96-bit) IV per message
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const encoded = typeof plaintext === 'string'
+    ? new TextEncoder().encode(plaintext)
+    : plaintext;
+
+  const ciphertextBuffer = await crypto.subtle.encrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    encoded
+  );
+
+  return { iv, ciphertext: new Uint8Array(ciphertextBuffer) };
+}
+
+/**
+ * Decrypts and authenticates an AEAD payload.
+ * Throws OperationError if ciphertext or additionalData was tampered with.
+ *
+ * @param {CryptoKey} key
+ * @param {Uint8Array} iv
+ * @param {Uint8Array} ciphertext
+ * @param {Uint8Array} [additionalData]
+ * @returns {Promise<string>}
+ */
+export async function decryptMessage(key, iv, ciphertext, additionalData = new Uint8Array(0)) {
+  const plaintextBuffer = await crypto.subtle.decrypt(
+    {
+      name: key.algorithm.name,
+      iv,
+      additionalData,
+    },
+    key,
+    ciphertext
+  );
+
+  return new TextDecoder().decode(plaintextBuffer);
+}
+
+/**
+ * High-level envelope encryption:
+ * 1. Encapsulates shared AEAD key
+ * 2. Encrypts sensitive plaintext with fresh 12-byte IV and bound AAD
+ * 3. Packages into serializable JSON structure
+ *
+ * @param {CryptoKey|Uint8Array} recipientPublicKeyOrBytes
+ * @param {string} plaintext
+ * @param {Object} [options]
+ * @param {Uint8Array|string} [options.additionalData]
+ * @param {string} [options.sharedKeyAlgorithm]
+ * @returns {Promise<Object>}
+ */
+export async function encryptEnvelope(recipientPublicKeyOrBytes, plaintext, options = {}) {
+  const aadBytes = options.additionalData
+    ? (typeof options.additionalData === 'string' ? new TextEncoder().encode(options.additionalData) : options.additionalData)
+    : new Uint8Array(0);
+
+  const { sharedKey, capsuleBytes, algorithm, aeadAlgorithm } = await encapsulateEnvelopeKey(
+    recipientPublicKeyOrBytes,
+    { sharedKeyAlgorithm: options.sharedKeyAlgorithm }
+  );
+
+  const { iv, ciphertext } = await encryptMessage(sharedKey, plaintext, aadBytes);
+
+  return {
+    version: 1,
+    suite: `${algorithm}+${aeadAlgorithm}`,
+    algorithm,
+    aeadAlgorithm,
+    capsule: toBase64(capsuleBytes),
+    iv: toBase64(iv),
+    ciphertext: toBase64(ciphertext),
+    additionalData: aadBytes.length > 0 ? toBase64(aadBytes) : undefined,
+    timestamp: new Date().toISOString(),
+  };
+}
+
+/**
+ * High-level envelope decryption:
+ * 1. Decapsulates shared AEAD key from capsule
+ * 2. Authenticates and decrypts ciphertext with IV and bound AAD
+ *
+ * @param {CryptoKey} recipientPrivateKey
+ * @param {Object} envelope
+ * @param {Object} [options]
+ * @param {Uint8Array|string} [options.overrideAdditionalData]
+ * @returns {Promise<string>} Plaintext string
+ */
+export async function decryptEnvelope(recipientPrivateKey, envelope, options = {}) {
+  const capsuleBytes = fromBase64(envelope.capsule);
+  const iv = fromBase64(envelope.iv);
+  const ciphertext = fromBase64(envelope.ciphertext);
+
+  let aadBytes;
+  if (options.overrideAdditionalData !== undefined) {
+    aadBytes = typeof options.overrideAdditionalData === 'string'
+      ? new TextEncoder().encode(options.overrideAdditionalData)
+      : options.overrideAdditionalData;
+  } else if (envelope.additionalData) {
+    aadBytes = fromBase64(envelope.additionalData);
+  } else {
+    aadBytes = new Uint8Array(0);
+  }
+
+  const sharedKey = await decapsulateEnvelopeKey(
+    recipientPrivateKey,
+    capsuleBytes,
+    { sharedKeyAlgorithm: envelope.aeadAlgorithm }
+  );
+
+  return decryptMessage(sharedKey, iv, ciphertext, aadBytes);
+}
+
+// ---------------------------------------------------------
+// IndexedDB Key Vault for Non-Extractable CryptoKeyPair Storage
+// ---------------------------------------------------------
+
+const DB_NAME = 'DailyGrindCryptoVault';
+const DB_VERSION = 1;
+const STORE_NAME = 'recipientKeys';
+
+function openDatabase() {
+  return new Promise((resolve, reject) => {
+    if (typeof indexedDB === 'undefined') {
+      reject(new Error('IndexedDB is not available in this environment'));
+      return;
+    }
+    const req = indexedDB.open(DB_NAME, DB_VERSION);
+    req.onupgradeneeded = (e) => {
+      const db = e.target.result;
+      if (!db.objectStoreNames.contains(STORE_NAME)) {
+        db.createObjectStore(STORE_NAME, { keyPath: 'id' });
+      }
+    };
+    req.onsuccess = () => resolve(req.result);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+/**
+ * Persists a recipient CryptoKeyPair in IndexedDB via structured cloning.
+ * Safe for non-extractable keys!
+ */
+export async function saveRecipientKeyPair(id, keyPair, metadata = {}) {
+  const db = await openDatabase();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readwrite');
+    const store = tx.objectStore(STORE_NAME);
+    const record = {
+      id,
+      keyPair, // Stored directly via structured cloning
+      metadata,
+      createdAt: new Date().toISOString(),
+    };
+    const req = store.put(record);
+    req.onsuccess = () => resolve(record);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+/**
+ * Loads a recipient CryptoKeyPair from IndexedDB.
+ */
+export async function loadRecipientKeyPair(id) {
+  const db = await openDatabase();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readonly');
+    const store = tx.objectStore(STORE_NAME);
+    const req = store.get(id);
+    req.onsuccess = () => resolve(req.result || null);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+/**
+ * Lists all stored recipient keys.
+ */
+export async function listRecipientKeyPairs() {
+  const db = await openDatabase();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readonly');
+    const store = tx.objectStore(STORE_NAME);
+    const req = store.getAll();
+    req.onsuccess = () => {
+      const records = req.result.map(r => ({
+        id: r.id,
+        metadata: r.metadata,
+        createdAt: r.createdAt,
+      }));
+      resolve(records);
+    };
+    req.onerror = () => reject(req.error);
+  });
+}
+
+/**
+ * Deletes a stored key pair.
+ */
+export async function deleteRecipientKeyPair(id) {
+  const db = await openDatabase();
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction(STORE_NAME, 'readwrite');
+    const store = tx.objectStore(STORE_NAME);
+    const req = store.delete(id);
+    req.onsuccess = () => resolve(true);
+    req.onerror = () => reject(req.error);
+  });
+}
+
+// ---------------------------------------------------------
+// Binary / Base64 / Hex Encoding Utilities
+// ---------------------------------------------------------
+
+export function toBase64(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toBase64 === 'function') {
+    return u8.toBase64();
+  }
+  if (typeof Buffer !== 'undefined') {
+    return Buffer.from(u8).toString('base64');
+  }
+  let binary = '';
+  const len = u8.byteLength;
+  for (let i = 0; i < len; i++) {
+    binary += String.fromCharCode(u8[i]);
+  }
+  return btoa(binary);
+}
+
+export function fromBase64(base64) {
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(base64);
+  }
+  if (typeof Buffer !== 'undefined') {
+    return new Uint8Array(Buffer.from(base64, 'base64'));
+  }
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+export function toHex(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  return Array.from(u8)
+    .map(b => b.toString(16).padStart(2, '0'))
+    .join('');
+}
+
+export function fromHex(hex) {
+  const cleanHex = hex.replace(/[^0-9a-fA-F]/g, '');
+  const bytes = new Uint8Array(cleanHex.length / 2);
+  for (let i = 0; i < bytes.length; i++) {
+    bytes[i] = parseInt(cleanHex.substr(i * 2, 2), 16);
+  }
+  return bytes;
+}
