+  <script src="https://www.youtube.com/iframe_api"></script>
+  <script>
+    (function () {
+      const theaterBtn = document.getElementById('theater-mode-btn');
+      const iframe = document.getElementById('coffee-roasting-video');
+      const heroSection = document.querySelector('.hero');
+      const originalContainer = iframe ? iframe.parentElement : null;
+      const originalNextSibling = iframe ? iframe.nextSibling : null;
+
+      if (!theaterBtn || !iframe || !heroSection || !originalContainer) {
+        return;
+      }
+
+      let isTheaterMode = false;
+      let currentPlaybackTime = 0;
+      let isVideoPlaying = false;
+      let ytPlayer = null;
+
+      // Track playback time and state via YouTube postMessage API
+      window.addEventListener('message', function (event) {
+        try {
+          const data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
+          if (!data) return;
+
+          if (data.event === 'infoDelivery' && data.info) {
+            if (typeof data.info.currentTime === 'number') {
+              currentPlaybackTime = data.info.currentTime;
+            }
+            if (typeof data.info.playerState === 'number') {
+              isVideoPlaying = (data.info.playerState === 1);
+            }
+          } else if (data.event === 'onStateChange') {
+            isVideoPlaying = (data.info === 1);
+          }
+        } catch (e) {}
+      });
+
+      // Track time periodically while playing
+      setInterval(function () {
+        if (isVideoPlaying) {
+          currentPlaybackTime += 0.5;
+        }
+      }, 500);
+
+      // YouTube IFrame API Ready Callback
+      window.onYouTubeIframeAPIReady = function () {
+        try {
+          ytPlayer = new YT.Player('coffee-roasting-video', {
+            events: {
+              'onStateChange': function (event) {
+                isVideoPlaying = (event.data === YT.PlayerState.PLAYING);
+              }
+            }
+          });
+        } catch (e) {}
+      };
+
+      // Helper to query latest playback state from player if available
+      function getLatestPlaybackState() {
+        let time = currentPlaybackTime;
+        let playing = isVideoPlaying;
+
+        if (ytPlayer) {
+          try {
+            if (typeof ytPlayer.getCurrentTime === 'function') {
+              const t = ytPlayer.getCurrentTime();
+              if (typeof t === 'number' && !isNaN(t) && t > 0) {
+                time = t;
+              }
+            }
+            if (typeof ytPlayer.getPlayerState === 'function') {
+              playing = (ytPlayer.getPlayerState() === 1);
+            }
+          } catch (e) {}
+        }
+        return { time, playing };
+      }
+
+      // Reparent function using moveBefore when supported, with fallback for older browsers
+      function reparentIframe(node, newParent, refNode) {
+        // Feature check: DOM moveBefore API preserves iframe context without reload or losing state
+        if (typeof newParent.moveBefore === 'function') {
+          try {
+            // Note: moveBefore requires 2 arguments (use null to append at end)
+            newParent.moveBefore(node, refNode || null);
+            return;
+          } catch (err) {
+            console.warn('moveBefore failed, applying fallback:', err);
+          }
+        }
+
+        // Fallback for older browsers:
+        // Older browsers reload the iframe upon insertion.
+        // We preserve playback state across the reload by saving the current time and playing state.
+        const { time, playing } = getLatestPlaybackState();
+        const savedTime = Math.floor(time);
+        const wasPlaying = playing;
+
+        // Perform DOM relocation
+        if (refNode && refNode.parentNode === newParent) {
+          newParent.insertBefore(node, refNode);
+        } else {
+          newParent.appendChild(node);
+        }
+
+        // Restore playback state after the reload
+        if (savedTime > 0 || wasPlaying) {
+          // 1. Update src query parameters
+          try {
+            const url = new URL(node.src);
+            if (savedTime > 0) {
+              url.searchParams.set('start', savedTime);
+            }
+            if (wasPlaying) {
+              url.searchParams.set('autoplay', '1');
+            }
+            node.src = url.toString();
+          } catch (e) {}
+
+          // 2. Send postMessage seek/play commands upon reload
+          const restore = function () {
+            try {
+              if (savedTime > 0) {
+                node.contentWindow && node.contentWindow.postMessage(JSON.stringify({
+                  event: 'command',
+                  func: 'seekTo',
+                  args: [savedTime, true]
+                }), '*');
+              }
+              if (wasPlaying) {
+                node.contentWindow && node.contentWindow.postMessage(JSON.stringify({
+                  event: 'command',
+                  func: 'playVideo',
+                  args: []
+                }), '*');
+              }
+            } catch (e) {}
+          };
+
+          node.addEventListener('load', restore, { once: true });
+          setTimeout(restore, 1000);
+        }
+      }
+
+      function toggleTheaterMode() {
+        isTheaterMode = !isTheaterMode;
+
+        if (isTheaterMode) {
+          // Reparent into hero section
+          reparentIframe(iframe, heroSection, null);
+          document.body.classList.add('theater-active');
+          heroSection.classList.add('theater-mode');
+          theaterBtn.textContent = 'Exit Theater Mode';
+          theaterBtn.setAttribute('aria-pressed', 'true');
+        } else {
+          // Reparent back into original container in main
+          const refNode = (originalNextSibling && originalNextSibling.parentNode === originalContainer)
+            ? originalNextSibling
+            : null;
+          reparentIframe(iframe, originalContainer, refNode);
+          document.body.classList.remove('theater-active');
+          heroSection.classList.remove('theater-mode');
+          theaterBtn.textContent = 'Theater Mode';
+          theaterBtn.setAttribute('aria-pressed', 'false');
+        }
+      }
+
+      theaterBtn.addEventListener('click', toggleTheaterMode);
+
+      // Escape key shortcut
+      document.addEventListener('keydown', function (e) {
+        if (e.key === 'Escape' && isTheaterMode) {
+          toggleTheaterMode();
+        }
+      });
+
+      // Expose for testing if needed
+      window.__theaterMode = {
+        toggle: toggleTheaterMode,
+        reparent: reparentIframe,
+        isTheaterMode: function () { return isTheaterMode; },
+        iframe: iframe,
+        hero: heroSection,
+        originalContainer: originalContainer
+      };
+    })();
+  </script>
