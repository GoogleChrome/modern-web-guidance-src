+  <script>
+    (function () {
+      function initTheaterMode() {
+        const theaterBtn = document.getElementById('theater-mode-btn');
+        const heroSection = document.getElementById('hero') || document.querySelector('.hero');
+        const videoContainer = document.getElementById('video-container');
+        const iframe = document.getElementById('roasting-video') || document.querySelector('iframe');
+
+        if (!theaterBtn || !heroSection || !videoContainer || !iframe) return;
+
+        const originalParent = videoContainer;
+        const originalNextSibling = iframe.nextSibling;
+        let isTheaterMode = false;
+
+        function moveElement(targetParent, element, referenceNode = null) {
+          // Feature detection: use moveBefore() if supported to avoid reloading or resetting playback
+          if (('moveBefore' in Element.prototype || typeof targetParent.moveBefore === 'function') && typeof targetParent.moveBefore === 'function') {
+            targetParent.moveBefore(element, referenceNode);
+          } else {
+            // Fallback for older browsers: traditional move
+            targetParent.insertBefore(element, referenceNode);
+          }
+        }
+
+        theaterBtn.addEventListener('click', () => {
+          isTheaterMode = !isTheaterMode;
+
+          if (isTheaterMode) {
+            moveElement(heroSection, iframe, null);
+            heroSection.classList.add('theater-mode');
+            videoContainer.classList.add('theater-active');
+            theaterBtn.textContent = 'Exit Theater Mode';
+            theaterBtn.setAttribute('aria-pressed', 'true');
+          } else {
+            moveElement(originalParent, iframe, originalNextSibling);
+            heroSection.classList.remove('theater-mode');
+            videoContainer.classList.remove('theater-active');
+            theaterBtn.textContent = 'Theater Mode';
+            theaterBtn.setAttribute('aria-pressed', 'false');
+          }
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initTheaterMode);
+      } else {
+        initTheaterMode();
+      }
+    })();
+  </script>
+
