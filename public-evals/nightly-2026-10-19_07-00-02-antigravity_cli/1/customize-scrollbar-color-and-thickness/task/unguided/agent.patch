+      scrollbar-width: thin;
+      scrollbar-color: #ffab40 #4e342e;
+    }
+
+    .feedback-container::-webkit-scrollbar,
+    .customer-feedback-log::-webkit-scrollbar {
+      width: 8px;
+    }
+
+    .feedback-container::-webkit-scrollbar-track,
+    .customer-feedback-log::-webkit-scrollbar-track {
+      background: #4e342e;
+      border-radius: 4px;
+    }
+
+    .feedback-container::-webkit-scrollbar-thumb,
+    .customer-feedback-log::-webkit-scrollbar-thumb {
+      background: #ffab40;
+      border-radius: 4px;
+    }
+
+    .feedback-container::-webkit-scrollbar-thumb:hover,
+    .customer-feedback-log::-webkit-scrollbar-thumb:hover {
+      background: #ffa000;
+    }
+
+    .feedback-item {
+      padding: 16px 0;
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .feedback-item:last-child {
+      border-bottom: none;
+    }
+
+    .feedback-user {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      margin-bottom: 8px;
+    }
+
+    .feedback-avatar {
+      width: 44px;
+      height: 44px;
+      border-radius: 50%;
+      object-fit: cover;
+    }
+
+    .feedback-rating {
+      color: var(--accent);
+      font-size: 0.9rem;
+    }
+
+    .feedback-text {
+      font-style: italic;
+      color: var(--text);
+      font-size: 0.95rem;
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
