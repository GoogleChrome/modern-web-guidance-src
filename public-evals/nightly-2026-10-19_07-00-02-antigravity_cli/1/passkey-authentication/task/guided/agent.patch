+  <script>
+    (async function () {
+      try {
+        await import('./node_modules/webauthn-polyfills/esm/index.js');
+      } catch (e) {
+        // WebAuthn polyfill optional if native support is present
+      }
+    })();
+  </script>
+  <script>
+    let autofillAbortController = new AbortController();
+    let isAutofillActive = false;
+
+    // Base64URL to ArrayBuffer fallback helper
+    function base64UrlToBuffer(base64url) {
+      if (base64url instanceof ArrayBuffer) return base64url;
+      if (ArrayBuffer.isView(base64url)) return base64url.buffer;
+      const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+      const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+      const rawData = atob(base64);
+      const outputArray = new Uint8Array(rawData.length);
+      for (let i = 0; i < rawData.length; ++i) {
+        outputArray[i] = rawData.charCodeAt(i);
+      }
+      return outputArray.buffer;
+    }
+
+    // ArrayBuffer to Base64URL helper
+    function bufferToBase64Url(buf) {
+      if (!buf) return '';
+      const bytes = new Uint8Array(buf);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function parseRequestOptions(loginOptionsJSON) {
+      if (window.PublicKeyCredential && typeof PublicKeyCredential.parseRequestOptionsFromJSON === 'function') {
+        try {
+          return PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+        } catch (e) {
+          console.warn('parseRequestOptionsFromJSON fallback:', e);
+        }
+      }
+      const parsed = { ...loginOptionsJSON };
+      if (typeof parsed.challenge === 'string') {
+        parsed.challenge = base64UrlToBuffer(parsed.challenge);
+      }
+      if (Array.isArray(parsed.allowCredentials)) {
+        parsed.allowCredentials = parsed.allowCredentials.map((cred) => ({
+          ...cred,
+          id: typeof cred.id === 'string' ? base64UrlToBuffer(cred.id) : cred.id,
+        }));
+      }
+      return parsed;
+    }
+
+    function credentialToJSON(credential) {
+      if (typeof credential.toJSON === 'function') {
+        return credential.toJSON();
+      }
+      return {
+        id: credential.id,
+        rawId: bufferToBase64Url(credential.rawId),
+        response: {
+          clientDataJSON: bufferToBase64Url(credential.response?.clientDataJSON),
+          authenticatorData: bufferToBase64Url(credential.response?.authenticatorData),
+          signature: bufferToBase64Url(credential.response?.signature),
+          userHandle: credential.response?.userHandle ? bufferToBase64Url(credential.response.userHandle) : null,
+        },
+        type: credential.type,
+        clientExtensionResults: credential.getClientExtensionResults ? credential.getClientExtensionResults() : {},
+        authenticatorAttachment: credential.authenticatorAttachment || undefined,
+      };
+    }
+
+    async function optionsFetch() {
+      try {
+        let res = await fetch('/api/login/options');
+        if (!res.ok && res.status === 405) {
+          res = await fetch('/api/login/options', { method: 'POST' });
+        }
+        if (res.ok) {
+          return await res.json();
+        }
+      } catch (err) {
+        // Server options endpoint unavailable, proceed to client fallback
+      }
+
+      const randomBytes = new Uint8Array(32);
+      window.crypto.getRandomValues(randomBytes);
+      return {
+        challenge: bufferToBase64Url(randomBytes.buffer),
+        timeout: 60000,
+        rpId: window.location.hostname || 'localhost',
+        userVerification: 'preferred',
+        allowCredentials: [],
+      };
+    }
+
+    async function loginVerifyFetch(encodedCredential) {
+      return await fetch('/api/login/verify', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify(encodedCredential),
+      });
+    }
+
+    async function handleAuthSuccess(response) {
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+      if (!statusEl) return;
+
+      let message = 'Success: Signed in successfully';
+      try {
+        const cloned = response.clone();
+        const contentType = cloned.headers?.get('content-type') || '';
+        if (contentType.includes('application/json')) {
+          const data = await cloned.json();
+          if (data) {
+            if (typeof data === 'string') {
+              message = data;
+            } else if (data.message) {
+              message = data.message;
+            } else if (data.username) {
+              message = `Success: Signed in as ${data.username}`;
+            } else if (data.status) {
+              message = data.status;
+            }
+          }
+        } else {
+          const text = await cloned.text();
+          if (text && text.trim()) {
+            message = text.trim();
+          }
+        }
+      } catch (e) {
+        // Response parsing error
+      }
+
+      statusEl.textContent = message;
+      statusEl.setAttribute('data-status', 'success');
+      statusEl.classList.remove('error');
+      statusEl.classList.add('success');
+    }
+
+    function handleAuthFailure(response) {
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+      if (!statusEl) return;
+      statusEl.textContent = 'Authentication failed';
+      statusEl.setAttribute('data-status', 'error');
+      statusEl.classList.remove('success');
+      statusEl.classList.add('error');
+    }
+
+    function handleAuthError(err) {
+      const statusEl = document.querySelector('[data-testid="auth-status"]');
+      if (!statusEl) return;
+      statusEl.textContent = 'Authentication error';
+      statusEl.setAttribute('data-status', 'error');
+      statusEl.classList.remove('success');
+      statusEl.classList.add('error');
+    }
+
+    async function verifyAndHandleCredential(credential) {
+      const encoded = credentialToJSON(credential);
+      try {
+        const response = await loginVerifyFetch(encoded);
+        if (!response.ok && response.status === 404) {
+          // Trigger WebAuthn Signal API when credential is unknown
+          if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: window.location.hostname || 'localhost',
+                credentialId: encoded.id,
+              });
+            } catch (signalErr) {
+              console.warn('Signal API error:', signalErr);
+            }
+          }
+        }
+
+        if (response.ok) {
+          await handleAuthSuccess(response);
+        } else {
+          handleAuthFailure(response);
+        }
+      } catch (serverErr) {
+        console.error('Verification request error:', serverErr);
+        handleAuthError(serverErr);
+      }
+    }
+
+    async function initializeConditionalAutofill() {
+      if (isAutofillActive) {
+        return;
+      }
+
+      // Feature detect Conditional Get autofill support
+      let conditionalGetAvailable = false;
+      if (window.PublicKeyCredential) {
+        if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+          try {
+            const capabilities = await PublicKeyCredential.getClientCapabilities();
+            if (capabilities && capabilities.conditionalGet !== undefined) {
+              conditionalGetAvailable = capabilities.conditionalGet === true;
+            }
+          } catch (e) {
+            console.warn('getClientCapabilities error:', e);
+          }
+        }
+        if (!conditionalGetAvailable && typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+          try {
+            conditionalGetAvailable = await PublicKeyCredential.isConditionalMediationAvailable();
+          } catch (e) {
+            console.warn('isConditionalMediationAvailable error:', e);
+          }
+        }
+      }
+
+      if (!conditionalGetAvailable) {
+        return;
+      }
+
+      try {
+        const loginOptionsJSON = await optionsFetch();
+        const publicKey = parseRequestOptions(loginOptionsJSON);
+
+        isAutofillActive = true;
+        // Initiate Conditional UI form autofill suggestions
+        const credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+          mediation: 'conditional',
+        });
+
+        isAutofillActive = false;
+        if (credential) {
+          await verifyAndHandleCredential(credential);
+        }
+      } catch (err) {
+        isAutofillActive = false;
+        // Silently swallow expected client WebAuthn cancellations/aborts
+        if (err.name === 'NotAllowedError' || err.name === 'AbortError') {
+          return;
+        }
+        console.error('Unexpected conditional get error:', err);
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      // Abort any pending Conditional Get call to prevent passkey prompt collisions
+      if (isAutofillActive) {
+        autofillAbortController.abort();
+        autofillAbortController = new AbortController();
+        isAutofillActive = false;
+      } else {
+        autofillAbortController = new AbortController();
+      }
+
+      let credential;
+      try {
+        const loginOptionsJSON = await optionsFetch();
+        const publicKey = parseRequestOptions(loginOptionsJSON);
+
+        // Passkey explicit prompt trigger (prompts user directly for biometrics)
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === 'NotAllowedError') {
+          console.log('User cancelled passkey login.');
+        } else if (err.name === 'AbortError') {
+          console.log('The authentication operation was aborted.');
+        }
+        // Re-arm Conditional autofill Suggestions after cancelled explicit button prompts
+        initializeConditionalAutofill();
+        return;
+      }
+
+      if (credential) {
+        await verifyAndHandleCredential(credential);
+      }
+    }
+
+    // Attach event listeners
+    function setupAuthListeners() {
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      if (authButton) {
+        authButton.addEventListener('click', triggerButtonAuthentication);
+      }
+
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      if (usernameField) {
+        usernameField.addEventListener('focus', () => {
+          if (!isAutofillActive) {
+            initializeConditionalAutofill();
+          }
+        });
+        usernameField.addEventListener('keydown', (e) => {
+          if (e.key === 'Enter') {
+            e.preventDefault();
+            triggerButtonAuthentication();
+          }
+        });
+      }
+
+      const signinForm = document.getElementById('signin-form');
+      if (signinForm) {
+        signinForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          triggerButtonAuthentication();
+        });
+      }
+
+      // Initialize Conditional UI on page load
+      initializeConditionalAutofill();
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', setupAuthListeners);
+    } else {
+      setupAuthListeners();
+    }
+  </script>
 </body>
 
