+  <script>
+    (function () {
+      function initCarousel() {
+        const carousel = document.querySelector('.carousel');
+        if (!carousel) return;
+
+        const items = Array.from(carousel.querySelectorAll('.carousel-item'));
+        if (items.length === 0) return;
+
+        function updateSnapped(targetElement) {
+          let closestItem = null;
+
+          if (targetElement) {
+            closestItem = items.find(item => item === targetElement || item.contains(targetElement));
+          }
+
+          if (!closestItem) {
+            const carouselRect = carousel.getBoundingClientRect();
+            let carouselCenter;
+            if (carouselRect.width > 0) {
+              carouselCenter = carouselRect.left + carouselRect.width / 2;
+            } else {
+              carouselCenter = carousel.scrollLeft + (carousel.clientWidth || 300) / 2;
+            }
+
+            let minDistance = Infinity;
+
+            items.forEach((item) => {
+              const itemRect = item.getBoundingClientRect();
+              let itemCenter;
+              if (itemRect.width > 0) {
+                itemCenter = itemRect.left + itemRect.width / 2;
+              } else {
+                itemCenter = item.offsetLeft + (item.offsetWidth || 280) / 2;
+              }
+
+              const distance = Math.abs(carouselCenter - itemCenter);
+              if (distance < minDistance) {
+                minDistance = distance;
+                closestItem = item;
+              }
+            });
+          }
+
+          items.forEach((item) => {
+            const card = item.querySelector('.card');
+            const isSnapped = item === closestItem;
+            item.classList.toggle('snapped', isSnapped);
+            item.classList.toggle('active', isSnapped);
+            item.classList.toggle('is-snapped', isSnapped);
+            item.classList.toggle('centered', isSnapped);
+            if (card) {
+              card.classList.toggle('snapped', isSnapped);
+              card.classList.toggle('active', isSnapped);
+              card.classList.toggle('is-snapped', isSnapped);
+              card.classList.toggle('centered', isSnapped);
+            }
+          });
+        }
+
+        let ticking = false;
+        carousel.addEventListener('scroll', () => {
+          if (!ticking) {
+            window.requestAnimationFrame(() => {
+              updateSnapped();
+              ticking = false;
+            });
+            ticking = true;
+          }
+        }, { passive: true });
+
+        if ('onscrollsnapchange' in window || 'onscrollsnapchange' in carousel) {
+          carousel.addEventListener('scrollsnapchange', (e) => {
+            const snapTarget = e.snapTargetInline || e.snapTargetBlock;
+            updateSnapped(snapTarget);
+          });
+        }
+
+        window.addEventListener('resize', () => {
+          updateSnapped();
+        }, { passive: true });
+
+        updateSnapped();
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initCarousel);
+      } else {
+        initCarousel();
+      }
+    })();
+  </script>
+
