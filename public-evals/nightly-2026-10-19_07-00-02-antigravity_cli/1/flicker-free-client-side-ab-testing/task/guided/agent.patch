+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Apex Cloud - High Performance Cloud Infrastructure</title>
+
+  <!--
+    MANDATORY: Load the experimentation script with async and blocking="render".
+    - async: Prevents parser-blocking so HTML parsing continues in parallel.
+    - blocking="render": Blocks rendering until the script executes, preventing
+      content flash/flicker of the original variant.
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+  ></script>
+
+  <!--
+    Fallback anti-flicker snippet for browsers that do not support blocking="render".
+    Feature-detects support and hides the page with opacity: 0 until the experiment
+    script runs, loads, errors, or a safety timeout expires.
+  -->
+  <script>
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      document.documentElement.classList.add('ab-loading');
+      const revealPage = () => {
+        document.documentElement.classList.remove('ab-loading');
+      };
+      // Timeout fallback to ensure content is visible even on slow connections or failure
+      const safetyTimeout = setTimeout(revealPage, 4000);
+
+      // Listen for experiment script load/error events if available
+      window.addEventListener('DOMContentLoaded', () => {
+        const expScript = document.querySelector('script[src*="experiment-sdk.js"]');
+        if (expScript) {
+          expScript.addEventListener('load', () => {
+            clearTimeout(safetyTimeout);
+            revealPage();
+          });
+          expScript.addEventListener('error', () => {
+            clearTimeout(safetyTimeout);
+            revealPage();
+          });
+        }
+      });
+    }
+  </script>
+
+  <style>
