+            debugPanel.classList.remove('visible');
+          }
+          if (toggleDebugBtn && !isVisible) {
+            toggleDebugBtn.classList.add('off');
+            toggleDebugBtn.textContent = 'Toggle Debug';
+          }
+        }
+      });
