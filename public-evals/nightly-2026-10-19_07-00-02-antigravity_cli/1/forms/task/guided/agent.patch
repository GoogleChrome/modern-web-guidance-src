+       * Follows modern-web-guidance for accessible error announcements
+       */
+      function updateFieldAria(input) {
+        if (!input || !input.checkValidity) return;
+
+        // Check native constraint validity
+        const isValid = input.checkValidity();
+        const errorSpan = document.getElementById(input.getAttribute('aria-errormessage'));
+
+        if (!isValid) {
+          input.setAttribute('aria-invalid', 'true');
+          input.classList.add('is-user-invalid');
+          if (errorSpan) {
+            errorSpan.style.display = 'block';
+          }
+        } else {
+          input.removeAttribute('aria-invalid');
+          input.classList.remove('is-user-invalid');
+          if (errorSpan) {
+            errorSpan.style.display = 'none';
+          }
+        }
+      }
