+  <script>
+    // Sync aria-invalid with the CSS :user-invalid state
+    const syncAria = (el) => {
+      if (!el || !el.matches || !el.matches('input, select, textarea')) return;
+      try {
+        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+      } catch {
+        el.setAttribute('aria-invalid', el.checkValidity() ? 'false' : 'true');
+      }
+    };
+
+    // Update on blur (to show error) and input (to clear it)
+    document.addEventListener('blur', (e) => syncAria(e.target), true);
+    document.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+    });
+    document.addEventListener('invalid', (e) => syncAria(e.target), true);
+
+    const newsletterForm = document.getElementById('newsletter-form');
+    if (newsletterForm) {
+      newsletterForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const emailInput = document.getElementById('newsletter-email');
+        if (emailInput) syncAria(emailInput);
+
+        if (newsletterForm.checkValidity()) {
+          const status = document.getElementById('newsletter-status');
+          if (status) {
+            status.textContent = '🎉 Thank you for subscribing!';
+            status.style.display = 'block';
+          }
+          newsletterForm.reset();
+          if (emailInput) {
+            emailInput.removeAttribute('aria-invalid');
+          }
+        }
+      });
+    }
+  </script>
+
