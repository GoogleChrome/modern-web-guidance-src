+  <script>
+    (function () {
+      // Theme Toggle Logic
+      const themeToggleBtn = document.getElementById('theme-toggle');
+
+      function updateThemeBtnText(theme) {
+        if (!themeToggleBtn) return;
+        themeToggleBtn.textContent = theme === 'dark' ? '☀️ Light Mode' : '🌙 Dark Mode';
+        themeToggleBtn.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`);
+      }
+
+      function setTheme(theme) {
+        document.documentElement.setAttribute('data-theme', theme);
+        try {
+          localStorage.setItem('daily-grind-theme', theme);
+        } catch (e) {}
+        updateThemeBtnText(theme);
+      }
+
+      try {
+        const savedTheme = localStorage.getItem('daily-grind-theme');
+        if (savedTheme) {
+          setTheme(savedTheme);
+        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
+          updateThemeBtnText('dark');
+        }
+      } catch (e) {}
+
+      if (themeToggleBtn) {
+        themeToggleBtn.addEventListener('click', function () {
+          const currentTheme = document.documentElement.getAttribute('data-theme') ||
+            (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
+          const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
+          setTheme(nextTheme);
+        });
+      }
+
+      // Subscription Form Logic
+      const form = document.getElementById('coffee-subscription-form');
