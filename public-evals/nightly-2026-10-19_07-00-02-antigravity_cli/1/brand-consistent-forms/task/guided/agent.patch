+        const hasEmail = emailInput.value.trim().length > 0 && emailInput.checkValidity();
+
+        if (hasName) score += 20;
+        if (hasEmail) score += 30;
+
+        progressBar.value = score;
+        progressBar.textContent = score + '%';
+        progressPercent.textContent = score + '% Completed';
+      }
+
+      roastInput.addEventListener('input', () => {
+        updateRoastDisplay();
+        updateProgress();
+      });
+
+      nameInput.addEventListener('input', updateProgress);
+      emailInput.addEventListener('input', updateProgress);
+
+      const frequencyRadios = document.querySelectorAll('input[name="delivery_frequency"]');
+      frequencyRadios.forEach(radio => {
+        radio.addEventListener('change', updateProgress);
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!form.checkValidity()) {
+          form.reportValidity();
+          return;
+        }
+
+        const selectedFreq = document.querySelector('input[name="delivery_frequency"]:checked').value;
+        const roastVal = roastInput.value;
+        const emailsChecked = document.getElementById('sub-email-optin').checked;
+        const emailVal = emailInput.value.trim();
+
+        feedback.style.display = 'block';
+        feedback.textContent = `🎉 Welcome aboard! Your ${selectedFreq} coffee subscription (Roast Level ${roastVal}) has been confirmed for ${emailVal}. ${emailsChecked ? 'Tasting notes on the way!' : ''}`;
+
+        progressBar.value = 100;
+        progressBar.textContent = '100%';
+        progressPercent.textContent = '100% Completed';
+      });
+
+      // Initial run
+      updateRoastDisplay();
+      updateProgress();
+    })();
+  </script>
+
 </body>
 
 </html>
