+  <script>
+    (async function initCoordinatorApp() {
+      // 1. Ensure Temporal API is available (native or polyfilled)
+      if (typeof Temporal === 'undefined') {
+        if (typeof window.temporal !== 'undefined' && window.temporal.Temporal) {
+          window.Temporal = window.temporal.Temporal;
+        } else {
+          try {
+            const module = await import("https://esm.sh/@js-temporal/polyfill");
+            window.Temporal = module.Temporal;
+          } catch (err) {
+            console.error("Could not load Temporal polyfill dynamically:", err);
+          }
+        }
+      }
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const presetSpringGap = document.getElementById('presetSpringGap');
+      const presetFallOverlap = document.getElementById('presetFallOverlap');
+      const presetLondonGap = document.getElementById('presetLondonGap');
+
+      const TARGET_TIMEZONES = [
+        { id: 'America/New_York', city: 'New York' },
+        { id: 'Europe/London', city: 'London' },
+        { id: 'Asia/Tokyo', city: 'Tokyo' },
+        { id: 'UTC', city: 'UTC' }
+      ];
+
+      function formatTime12(h, m) {
+        const ampm = h >= 12 ? 'PM' : 'AM';
+        const hour = h % 12 || 12;
+        const minute = String(m).padStart(2, '0');
+        return `${hour}:${minute} ${ampm}`;
+      }
+
+      function updateSchedule() {
+        const dateStr = dateInput.value;
+        const timeStr = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateStr || !timeStr || !hostTz) {
+          return;
+        }
+
+        if (typeof Temporal === 'undefined' || !Temporal.ZonedDateTime) {
+          console.warn("Temporal API is not yet loaded.");
+          return;
+        }
+
+        // Format ISO 8601 string with time zone annotation: YYYY-MM-DDTHH:mm:ss[TimeZone]
+        const normalizedTime = timeStr.length === 5 ? `${timeStr}:00` : timeStr;
+        const isoString = `${dateStr}T${normalizedTime}[${hostTz}]`;
+
+        // 1. Detect conflicts (gap or overlap) using 'reject' disambiguation
+        let hasConflict = false;
+        try {
+          // 'reject' throws a RangeError if the time is ambiguous or does not exist
+          Temporal.ZonedDateTime.from(isoString, { disambiguation: 'reject' });
+        } catch (err) {
+          if (err && (err.name === 'RangeError' || err instanceof RangeError)) {
+            hasConflict = true;
+          } else {
+            console.error("Unexpected error constructing ZonedDateTime:", err);
+            return;
+          }
+        }
+
+        // 2. Resolve the time safely using 'compatible' disambiguation
+        // The resulting Temporal.ZonedDateTime is immutable
+        const hostZdt = Temporal.ZonedDateTime.from(isoString, { disambiguation: 'compatible' });
+
+        // 3. Explain resolution if conflict was detected
+        if (hasConflict) {
+          // Create immutable reference instances for earlier and later disambiguation
+          const earlierZdt = Temporal.ZonedDateTime.from(isoString, { disambiguation: 'earlier' });
+          const laterZdt = Temporal.ZonedDateTime.from(isoString, { disambiguation: 'later' });
+
+          const [reqH, reqM] = timeStr.split(':').map(Number);
+          const requestedFormatted = formatTime12(reqH, reqM);
+
+          // A gap occurs when the clock jumped forward; neither earlier nor later match the requested clock time
+          const isGap = (earlierZdt.hour !== reqH || earlierZdt.minute !== reqM) &&
+                        (laterZdt.hour !== reqH || laterZdt.minute !== reqM);
+
+          const resolvedTimeStr = hostZdt.toLocaleString('en-US', {
+            hour: 'numeric',
+            minute: '2-digit',
+            hour12: true
+          });
+
+          if (isGap) {
+            hostWarning.innerHTML = `
+              <div class="warning-title">⚠️ Daylight Saving Time Transition Gap Detected</div>
+              <p>The time <strong>${requestedFormatted}</strong> does not exist in <code>${hostTz}</code> on ${dateStr} because clocks spring forward by 1 hour during this transition. To safely schedule the event without error, the immutable date-time was resolved forward to <strong>${resolvedTimeStr}</strong> (UTC offset: ${hostZdt.offset}) using standard compatible disambiguation.</p>
+            `;
+          } else {
+            const earlierStr = earlierZdt.toLocaleString('en-US', {
+              hour: 'numeric',
+              minute: '2-digit',
+              hour12: true,
+              timeZoneName: 'short'
+            });
+            const laterStr = laterZdt.toLocaleString('en-US', {
+              hour: 'numeric',
+              minute: '2-digit',
+              hour12: true,
+              timeZoneName: 'short'
+            });
+
+            hostWarning.innerHTML = `
+              <div class="warning-title">⚠️ Daylight Saving Time Ambiguity (Overlap) Detected</div>
+              <p>The time <strong>${requestedFormatted}</strong> is ambiguous in <code>${hostTz}</code> on ${dateStr} because clocks fall back 1 hour, repeating this clock interval. Both <strong>${earlierStr}</strong> and <strong>${laterStr}</strong> exist. The immutable date-time was resolved to the earlier daylight saving instance (<strong>${resolvedTimeStr}</strong>, UTC offset: ${hostZdt.offset}) using standard compatible disambiguation.</p>
+            `;
+          }
+          hostWarning.style.display = 'block';
+        } else {
+          hostWarning.innerHTML = '';
+          hostWarning.style.display = 'none';
+        }
+
+        // 4. Calculate equivalent times using immutable .withTimeZone() conversion method
+        grid.innerHTML = '';
+        for (const target of TARGET_TIMEZONES) {
+          // Calling .withTimeZone() returns a new immutable Temporal.ZonedDateTime object
+          const targetZdt = hostZdt.withTimeZone(target.id);
+          const isHost = target.id === hostTz;
+
+          const formattedTime = targetZdt.toLocaleString('en-US', {
+            hour: 'numeric',
+            minute: '2-digit',
+            hour12: true
+          });
+
+          const formattedDate = targetZdt.toLocaleString('en-US', {
+            weekday: 'short',
+            month: 'short',
+            day: 'numeric',
+            year: 'numeric'
+          });
+
+          const card = document.createElement('div');
+          card.className = `card tz-card${isHost ? ' is-host' : ''}`;
+          card.innerHTML = `
+            ${isHost ? '<span class="host-badge">Host Timezone</span>' : ''}
+            <h3>${target.city}</h3>
+            <div class="tz-sub">${target.id}</div>
+            <div class="tz-time">${formattedTime}</div>
+            <div class="tz-date">${formattedDate}</div>
+            <div class="tz-offset">UTC ${targetZdt.offset}</div>
+          `;
+          grid.appendChild(card);
+        }
+      }
+
+      // Event listeners for inputs
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+
+      // Preset handlers for quick testing of DST edge cases
+      if (presetSpringGap) {
+        presetSpringGap.addEventListener('click', () => {
+          dateInput.value = '2025-03-09';
+          timeInput.value = '02:30';
+          hostTzSelect.value = 'America/New_York';
+          updateSchedule();
+        });
+      }
+
+      if (presetFallOverlap) {
+        presetFallOverlap.addEventListener('click', () => {
+          dateInput.value = '2024-11-03';
+          timeInput.value = '01:30';
+          hostTzSelect.value = 'America/New_York';
+          updateSchedule();
+        });
+      }
+
+      if (presetLondonGap) {
+        presetLondonGap.addEventListener('click', () => {
+          dateInput.value = '2025-03-30';
+          timeInput.value = '01:30';
+          hostTzSelect.value = 'Europe/London';
+          updateSchedule();
+        });
+      }
+
+      // Run initial schedule calculation
+      updateSchedule();
+    })();
+  </script>
