+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox ? { box: 'device-pixel-content-box' } : {};
+      observer.observe(canvas, options);
+
+      // Interactive controls listeners
+      nameInput.addEventListener('input', syncAndPaint);
+      messageInput.addEventListener('input', syncAndPaint);
+
+      bgInput.addEventListener('input', (e) => {
+        currentBgColor = e.target.value;
+        swatches.forEach(swatch => swatch.classList.remove('active'));
+        syncAndPaint();
+      });
+
+      swatches.forEach(swatch => {
+        swatch.addEventListener('click', () => {
+          swatches.forEach(s => s.classList.remove('active'));
+          swatch.classList.add('active');
+          currentBgColor = swatch.dataset.color;
+          bgInput.value = currentBgColor;
+          syncAndPaint();
+        });
+      });
+
+      amountButtons.forEach(btn => {
+        btn.addEventListener('click', () => {
+          amountButtons.forEach(b => b.classList.remove('active'));
+          btn.classList.add('active');
+          currentAmount = btn.dataset.amount;
+          syncAndPaint();
+        });
+      });
+
+      // Step 6: Export / Download canvas content as image
+      exportBtn.addEventListener('click', () => {
+        syncAndPaint();
+        const dataURL = canvas.toDataURL('image/png');
+        const link = document.createElement('a');
+        link.download = 'the-daily-grind-gift-card.png';
+        link.href = dataURL;
+        document.body.appendChild(link);
+        link.click();
+        document.body.removeChild(link);
+      });
+
+      syncAndPaint();
+    })();
+  </script>
