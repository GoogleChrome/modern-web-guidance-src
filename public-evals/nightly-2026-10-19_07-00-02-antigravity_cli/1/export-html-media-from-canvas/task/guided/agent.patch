+          }
+          if (typeof ctx.drawElementImage === 'function') {
+            ctx.drawElementImage(exportElement, 0, 0);
+          }
+        };
+      }
+
+      // Synchronize DOM elements and trigger paint
+      function syncAndPaint() {
+        const name = nameInput.value.trim() || 'Aidan & Taylor';
+        const msg = messageInput.value.trim() || 'Wishing you warmth and joy in every cup! Treat yourself to your favorite brew.';
+
+        recipientDisplay.textContent = name;
+        messageDisplay.textContent = `"${msg}"`;
+        amountDisplay.textContent = currentAmount;
+        exportElement.style.backgroundColor = currentBgColor;
+
+        if (isHtmlInCanvasSupported && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          renderFallbackCanvas();
+        }
+      }
+
+      // Step 3: ResizeObserver for responsive high-DPI canvas resolution
+      const observer = new ResizeObserver(([entry]) => {
