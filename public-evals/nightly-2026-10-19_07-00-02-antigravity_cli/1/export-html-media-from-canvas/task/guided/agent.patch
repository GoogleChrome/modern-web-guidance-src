+  <script>
+    (function () {
+      // Step 1: Check browser support for the HTML-in-Canvas API
+      const isHtmlInCanvasSupported = ('content' in HTMLCanvasElement.prototype);
+
+      const canvas = document.getElementById('gift-card-canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const nameInput = document.getElementById('card-name-input');
+      const messageInput = document.getElementById('card-message-input');
+      const bgInput = document.getElementById('card-bg-input');
+      const recipientDisplay = document.getElementById('card-recipient-display');
+      const messageDisplay = document.getElementById('card-message-display');
+      const amountDisplay = document.getElementById('card-amount-display');
+      const exportBtn = document.getElementById('export-card-btn');
+      const swatches = document.querySelectorAll('.color-swatch');
+      const amountButtons = document.querySelectorAll('.amount-btn');
+
+      let currentBgColor = bgInput.value || '#4e342e';
+      let currentAmount = '$25.00';
+
+      // Fallback 2D renderer for browsers without native HTML-in-Canvas support
+      function renderFallbackCanvas() {
+        const w = canvas.width;
+        const h = canvas.height;
+        if (!w || !h) return;
+
+        const baseW = 500;
+        const baseH = 300;
+        const scale = w / baseW;
+
+        ctx.save();
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.clearRect(0, 0, w, h);
+        }
+        ctx.scale(scale, scale);
+
+        // Card Background with rounded corners
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(0, 0, baseW, baseH, 14);
+        } else {
+          ctx.rect(0, 0, baseW, baseH);
+        }
+        ctx.fillStyle = currentBgColor;
+        ctx.fill();
+
+        // Decorative subtle radial glow in top right
+        const glow = ctx.createRadialGradient(baseW, 0, 10, baseW, 0, 180);
+        glow.addColorStop(0, 'rgba(255, 171, 64, 0.3)');
+        glow.addColorStop(1, 'rgba(255, 255, 255, 0)');
+        ctx.fillStyle = glow;
+        ctx.fill();
+
+        // Subtle inner border
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';
+        ctx.lineWidth = 1;
+        ctx.stroke();
+
+        // Brand Header
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 18px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        ctx.fillText('☕ THE DAILY GRIND', 24, 42);
+
+        // Badge pill
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.16)';
+        if (typeof ctx.roundRect === 'function') {
+          ctx.beginPath();
+          ctx.roundRect(baseW - 176, 26, 152, 22, 11);
+          ctx.fill();
+        }
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 10px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        ctx.fillText('ARTISANAL GIFT CARD', baseW - 163, 41);
+
+        // Recipient Name
+        const recipientName = nameInput.value.trim() || 'Aidan & Taylor';
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 20px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        ctx.fillText(`For: ${recipientName}`, 24, 115);
+
+        // Custom Message wrapped across lines
+        const rawMessage = messageInput.value.trim() || 'Wishing you warmth and joy in every cup! Treat yourself to your favorite brew.';
+        ctx.fillStyle = '#f0e6e2';
+        ctx.font = 'italic 15px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+
+        const words = `"${rawMessage}"`.split(' ');
+        let line = '';
+        let lineY = 148;
+        const maxLineWidth = baseW - 48;
+        const lineHeight = 22;
+        let lineCount = 0;
+
+        for (let i = 0; i < words.length; i++) {
+          const testLine = line + words[i] + ' ';
+          const metrics = ctx.measureText(testLine);
+          if (metrics.width > maxLineWidth && i > 0) {
+            ctx.fillText(line, 24, lineY);
+            line = words[i] + ' ';
+            lineY += lineHeight;
+            lineCount++;
+            if (lineCount >= 2) {
+              const remaining = words.slice(i).join(' ');
+              ctx.fillText(remaining.length > 36 ? remaining.slice(0, 33) + '...' : remaining, 24, lineY);
+              line = '';
+              break;
+            }
+          } else {
+            line = testLine;
+          }
+        }
+        if (line) {
+          ctx.fillText(line, 24, lineY);
+        }
+
+        // Horizontal divider line
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';
+        ctx.beginPath();
+        ctx.moveTo(24, 235);
+        ctx.lineTo(baseW - 24, 235);
+        ctx.stroke();
+
+        // Card Amount
+        ctx.fillStyle = '#ffab40';
+        ctx.font = 'bold 26px "Segoe UI", Tahoma, Geneva, Verdana, sans-serif';
+        ctx.fillText(currentAmount, 24, 275);
+
+        // Card Code
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+        ctx.font = '13px monospace';
+        ctx.fillText('CARD #GRIND-2026-ART', baseW - 180, 272);
+
+        ctx.restore();
+      }
+
+      // Step 4: Render HTML content inside canvas onpaint event handler
+      if (isHtmlInCanvasSupported) {
+        canvas.onpaint = () => {
+          if (typeof ctx.reset === 'function') {
+            ctx.reset();
+          } else {
