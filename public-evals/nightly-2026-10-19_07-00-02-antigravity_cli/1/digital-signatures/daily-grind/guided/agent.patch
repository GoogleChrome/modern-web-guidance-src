+describe('Payload Signing and Verification with Context', () => {
+  test('signs and verifies payload with ML-DSA-65 and exact context', async () => {
+    if (!supportsPostQuantumSignatures()) return;
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair({ algorithm: 'ML-DSA-65' });
+    const payload = new TextEncoder().encode('Specialty Roast Batch #104');
+    const context = new TextEncoder().encode('daily-grind:batch-v1');
+
+    const signature = await signPayload(keyPair.privateKey, payload, context);
+    assert.strictEqual(signature.byteLength, 3309);
+
+    // Verify with CryptoKey
+    const validWithKey = await verifyPayload(keyPair.publicKey, signature, payload, context);
+    assert.strictEqual(validWithKey, true);
+
+    // Verify with raw public key bytes
+    const validWithBytes = await verifyPayload(publicKeyBytes, signature, payload, context);
+    assert.strictEqual(validWithBytes, true);
+  });
+
+  test('fails verification when payload is modified (integrity check)', async () => {
+    if (!supportsPostQuantumSignatures()) return;
+    const { keyPair } = await generateSigningKeyPair({ algorithm: 'ML-DSA-65' });
+    const payload = new TextEncoder().encode('Original Authentic Order');
+    const tampered = new TextEncoder().encode('Tampered Malicious Order');
+    const context = new TextEncoder().encode('order-v1');
+
+    const signature = await signPayload(keyPair.privateKey, payload, context);
+    const valid = await verifyPayload(keyPair.publicKey, signature, tampered, context);
+    assert.strictEqual(valid, false);
+  });
+
+  test('fails verification when domain context differs (domain separation)', async () => {
+    if (!supportsPostQuantumSignatures()) return;
+    const { keyPair } = await generateSigningKeyPair({ algorithm: 'ML-DSA-65' });
+    const payload = new TextEncoder().encode('Same payload across contexts');
+    const ctxA = new TextEncoder().encode('context-admin-action');
+    const ctxB = new TextEncoder().encode('context-user-action');
+
+    const signature = await signPayload(keyPair.privateKey, payload, ctxA);
+    const valid = await verifyPayload(keyPair.publicKey, signature, payload, ctxB);
+    assert.strictEqual(valid, false);
+  });
+
+  test('rejects context greater than 255 bytes', async () => {
+    if (!supportsPostQuantumSignatures()) return;
+    const { keyPair } = await generateSigningKeyPair({ algorithm: 'ML-DSA-65' });
+    const payload = new TextEncoder().encode('payload');
+    const longContext = new Uint8Array(256); // 256 bytes exceeds 255-byte limit
+
+    await assert.rejects(
+      async () => {
+        await signPayload(keyPair.privateKey, payload, longContext);
+      },
+      (err) => err.name === 'OperationError'
+    );
+  });
+
+  test('signs and verifies payload with Ed25519 classical fallback and framed context', async () => {
+    if (!supportsEd25519()) return;
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair({ algorithm: 'Ed25519' });
+    const payload = new TextEncoder().encode('Classical fallback payload');
+    const context = new TextEncoder().encode('classical-context');
