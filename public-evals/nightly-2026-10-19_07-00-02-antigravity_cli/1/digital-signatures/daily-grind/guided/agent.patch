+describe('High-Level Artifact Signing and Verification', () => {
+  test('signs and verifies binary artifacts and detects tampering', async () => {
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair();
+
+    // Create simulated binary artifact (e.g. coffee batch provenance document or image)
+    const artifactBytes = new Uint8Array(2048);
+    for (let i = 0; i < artifactBytes.length; i++) {
+      artifactBytes[i] = (i * 37) % 256;
+    }
+
+    const artifactSigned = await signArtifact(keyPair.privateKey, artifactBytes, {
+      artifactName: 'yirgacheffe-origin-cert.bin',
+      context: 'provenance-v1',
