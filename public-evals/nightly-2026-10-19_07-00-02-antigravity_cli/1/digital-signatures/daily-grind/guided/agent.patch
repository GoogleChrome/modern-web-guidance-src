+/**
+ * Cryptographic Signing and Verification Module
+ * 
+ * Supports both Post-Quantum Lattice-Based Digital Signatures (ML-DSA / FIPS 204)
+ * and Classical Asymmetric Signatures (Ed25519, ECDSA) in the browser and modern runtimes.
+ */
+
+export const ML_DSA_PUBLIC_KEY_ALGORITHMS = {
+  1312: 'ML-DSA-44',
+  1952: 'ML-DSA-65',
+  2592: 'ML-DSA-87',
+};
+
+export const ALGORITHM_INFO = {
+  'ML-DSA-65': {
+    name: 'ML-DSA-65',
+    type: 'post-quantum',
+    standard: 'NIST FIPS 204 (Module-Lattice-Based Digital Signature Algorithm)',
+    securityLevel: 'NIST Category 3 (~192-bit security)',
+    recommended: true,
+    publicKeyBytes: 1952,
+    signatureBytes: 3309,
+    privateSeedBytes: 32,
+    publicKeyFormat: 'raw-public',
+    privateKeyFormat: 'raw-seed',
+  },
+  'ML-DSA-44': {
+    name: 'ML-DSA-44',
+    type: 'post-quantum',
+    standard: 'NIST FIPS 204',
+    securityLevel: 'NIST Category 2 (~128-bit security)',
+    recommended: false,
+    publicKeyBytes: 1312,
+    signatureBytes: 2420,
+    privateSeedBytes: 32,
+    publicKeyFormat: 'raw-public',
+    privateKeyFormat: 'raw-seed',
+  },
+  'ML-DSA-87': {
+    name: 'ML-DSA-87',
+    type: 'post-quantum',
+    standard: 'NIST FIPS 204',
+    securityLevel: 'NIST Category 5 (~256-bit security, CNSA 2.0)',
+    recommended: false,
+    publicKeyBytes: 2592,
+    signatureBytes: 4627,
+    privateSeedBytes: 32,
+    publicKeyFormat: 'raw-public',
+    privateKeyFormat: 'raw-seed',
+  },
+  'Ed25519': {
+    name: 'Ed25519',
+    type: 'classical',
+    standard: 'RFC 8032 / Edwards-curve Digital Signature Algorithm',
+    securityLevel: '~128-bit classical security',
+    recommended: false,
+    publicKeyBytes: 32,
+    signatureBytes: 64,
+    privateSeedBytes: 32,
+    publicKeyFormat: 'raw',
+    privateKeyFormat: 'pkcs8',
+  },
+};
+
+/**
+ * Byte and string conversion utilities
+ */
+
+export function toUint8Array(input) {
+  if (input instanceof Uint8Array) {
+    return input;
+  }
+  if (input instanceof ArrayBuffer) {
+    return new Uint8Array(input);
+  }
+  if (ArrayBuffer.isView(input)) {
+    return new Uint8Array(input.buffer, input.byteOffset, input.byteLength);
+  }
+  if (typeof input === 'string') {
+    return new TextEncoder().encode(input);
+  }
+  throw new TypeError('Expected Uint8Array, ArrayBuffer, ArrayBufferView, or string');
+}
+
+export function bytesToBase64Url(buffer) {
+  const bytes = toUint8Array(buffer);
+  let binary = '';
+  const chunkSize = 0x8000;
+  for (let i = 0; i < bytes.length; i += chunkSize) {
+    binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize));
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function base64UrlToBytes(str) {
+  let base64 = str.replace(/-/g, '+').replace(/_/g, '/');
+  while (base64.length % 4) {
+    base64 += '=';
+  }
+  const binary = atob(base64);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+export function bytesToHex(buffer) {
+  const bytes = toUint8Array(buffer);
+  return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+export function hexToBytes(hex) {
+  const cleanHex = hex.replace(/\s+/g, '');
+  if (cleanHex.length % 2 !== 0) {
+    throw new Error('Hex string must have an even length');
+  }
+  const bytes = new Uint8Array(cleanHex.length / 2);
+  for (let i = 0; i < cleanHex.length; i += 2) {
+    bytes[i / 2] = parseInt(cleanHex.substring(i, i + 2), 16);
+  }
+  return bytes;
+}
+
+/**
+ * Compute SHA-256 digest of input
+ */
+export async function hashSha256(data) {
+  const bytes = toUint8Array(data);
+  const digestBuffer = await crypto.subtle.digest('SHA-256', bytes);
+  return new Uint8Array(digestBuffer);
+}
+
+/**
+ * Feature detection using static SubtleCrypto.supports()
+ * Call SubtleCrypto.supports() on the SubtleCrypto constructor, not on crypto.subtle.
+ */
+export function supportsAlgorithm(operation, algorithm) {
+  try {
+    if (typeof globalThis.SubtleCrypto?.supports === 'function') {
+      return SubtleCrypto.supports(operation, algorithm);
+    }
+  } catch {
+    return false;
+  }
+  return false;
+}
+
+export function supportsPostQuantumSignatures() {
+  return supportsAlgorithm('sign', 'ML-DSA-65');
+}
+
+export function supportsEd25519() {
+  return supportsAlgorithm('sign', 'Ed25519');
+}
+
+/**
+ * Get report of available signature algorithms in current runtime
+ */
+export function getAvailableSignatureSuites() {
+  const suites = [];
+  for (const [algName, info] of Object.entries(ALGORITHM_INFO)) {
+    const supported = supportsAlgorithm('sign', algName);
+    suites.push({
+      ...info,
+      supported,
+    });
+  }
+  return suites;
+}
+
+/**
+ * Generate a signing key pair.
+ * Defaults to ML-DSA-65 if supported, falling back to Ed25519.
+ */
+export async function generateSigningKeyPair(options = {}) {
+  const {
+    algorithm = 'auto',
+    extractable = true,
+  } = options;
+
+  let suite = algorithm;
+  if (suite === 'auto') {
+    if (supportsPostQuantumSignatures()) {
+      suite = 'ML-DSA-65';
+    } else if (supportsEd25519()) {
+      suite = 'Ed25519';
+    } else {
+      suite = 'ML-DSA-65'; // Attempt ML-DSA or fail gracefully
+    }
+  }
+
+  if (suite.startsWith('ML-DSA')) {
+    const keyPair = await crypto.subtle.generateKey(suite, extractable, ['sign', 'verify']);
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey)
+    );
+    return {
+      suite,
+      type: 'post-quantum',
+      keyFormat: 'raw-public',
+      keyPair,
+      publicKeyBytes,
+      publicKeyBase64: bytesToBase64Url(publicKeyBytes),
+      publicKeyHex: bytesToHex(publicKeyBytes),
+    };
+  }
+
+  if (suite === 'Ed25519') {
+    const keyPair = await crypto.subtle.generateKey('Ed25519', extractable, ['sign', 'verify']);
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw', keyPair.publicKey)
+    );
+    return {
+      suite: 'Ed25519',
+      type: 'classical',
+      keyFormat: 'raw',
+      keyPair,
+      publicKeyBytes,
+      publicKeyBase64: bytesToBase64Url(publicKeyBytes),
+      publicKeyHex: bytesToHex(publicKeyBytes),
+    };
+  }
+
+  throw new Error(`Unsupported algorithm suite: ${suite}`);
+}
+
+/**
+ * Export a public key.
+ * For ML-DSA, 'raw-public' is required ('raw' throws NotSupportedError).
+ * For Ed25519, 'raw' is used.
+ */
+export async function exportPublicKey(publicKey, format) {
+  const algName = publicKey.algorithm?.name || '';
+  let exportFormat = format;
+  if (!exportFormat) {
+    exportFormat = algName.startsWith('ML-DSA') ? 'raw-public' : 'raw';
+  } else if (algName.startsWith('ML-DSA') && exportFormat === 'raw') {
+    exportFormat = 'raw-public';
+  }
+
+  const exported = await crypto.subtle.exportKey(exportFormat, publicKey);
+  if (exportFormat === 'jwk') {
+    return exported;
+  }
+  return new Uint8Array(exported);
+}
+
+/**
+ * Export a private key.
+ * For ML-DSA, private keys are exported as 'raw-seed' (32 bytes), 'pkcs8', or 'jwk'.
+ */
+export async function exportPrivateKey(privateKey, format) {
+  const algName = privateKey.algorithm?.name || '';
+  let exportFormat = format;
+  if (!exportFormat) {
+    exportFormat = algName.startsWith('ML-DSA') ? 'raw-seed' : 'pkcs8';
+  } else if (algName.startsWith('ML-DSA') && (exportFormat === 'raw' || exportFormat === 'raw-private')) {
+    exportFormat = 'raw-seed';
+  }
+
+  const exported = await crypto.subtle.exportKey(exportFormat, privateKey);
+  if (exportFormat === 'jwk') {
+    return exported;
+  }
+  return new Uint8Array(exported);
+}
+
+/**
+ * Retrieve public key corresponding to a private key if supported
+ */
+export async function getPublicKeyFromPrivateKey(privateKey) {
+  if (typeof crypto.subtle.getPublicKey === 'function') {
+    return crypto.subtle.getPublicKey(privateKey, ['verify']);
+  }
+  throw new Error('crypto.subtle.getPublicKey is not supported in this environment');
+}
+
+/**
+ * Import a public key from bytes, JWK, or SPKI.
+ * Usages must be ['verify'] only.
+ */
+export async function importPublicKey(keyInput, algorithm, format) {
+  if (keyInput instanceof CryptoKey) {
+    return keyInput;
+  }
+
+  // JWK object
+  if (typeof keyInput === 'object' && keyInput !== null && !(keyInput instanceof Uint8Array) && !(keyInput instanceof ArrayBuffer)) {
+    const alg = algorithm || (keyInput.alg || 'ML-DSA-65');
+    return crypto.subtle.importKey('jwk', keyInput, alg, true, ['verify']);
+  }
+
+  const bytes = toUint8Array(keyInput);
+  let resolvedAlg = algorithm;
+  let resolvedFormat = format;
+
+  if (!resolvedAlg) {
+    resolvedAlg = ML_DSA_PUBLIC_KEY_ALGORITHMS[bytes.byteLength] || (bytes.byteLength === 32 ? 'Ed25519' : null);
+    if (!resolvedAlg) {
+      throw new Error(`Unable to deduce algorithm for public key of length ${bytes.byteLength} bytes`);
+    }
+  }
+
+  if (!resolvedFormat) {
+    resolvedFormat = resolvedAlg.startsWith('ML-DSA') ? 'raw-public' : 'raw';
+  }
+
+  return crypto.subtle.importKey(resolvedFormat, bytes, resolvedAlg, true, ['verify']);
+}
+
+/**
+ * Import a private key.
+ * Usages must be ['sign'] only (passing ['sign', 'verify'] throws SyntaxError).
+ */
+export async function importPrivateKey(keyInput, algorithm = 'ML-DSA-65', format = 'raw-seed') {
+  if (keyInput instanceof CryptoKey) {
+    return keyInput;
+  }
+
+  if (typeof keyInput === 'object' && keyInput !== null && !(keyInput instanceof Uint8Array) && !(keyInput instanceof ArrayBuffer)) {
+    return crypto.subtle.importKey('jwk', keyInput, algorithm, true, ['sign']);
+  }
+
+  const bytes = toUint8Array(keyInput);
+  let resolvedFormat = format;
+  if (algorithm.startsWith('ML-DSA') && (resolvedFormat === 'raw' || resolvedFormat === 'raw-private')) {
+    resolvedFormat = 'raw-seed';
+  }
+
+  return crypto.subtle.importKey(resolvedFormat, bytes, algorithm, true, ['sign']);
+}
+
+/**
+ * Frame fallback input for classical algorithms (Ed25519/ECDSA) to provide
+ * consistent domain separation matching ML-DSA ContextParams behavior.
+ */
+export function frameFallbackInput(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+/**
+ * Validate domain separation context bytes. Accepts 0 to 255 bytes.
+ */
+function normalizeContext(context) {
+  if (!context) {
+    return new Uint8Array(0);
+  }
+  const ctxBytes = toUint8Array(context);
+  if (ctxBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  return ctxBytes;
+}
+
+/**
+ * Sign payload bytes with private key and optional domain separation context.
+ */
+export async function signPayload(privateKey, payload, context = new Uint8Array(0)) {
+  const payloadBytes = toUint8Array(payload);
+  const contextBytes = normalizeContext(context);
+  const algName = privateKey.algorithm?.name || '';
+
+  if (algName.startsWith('ML-DSA')) {
+    const sig = await crypto.subtle.sign(
+      { name: algName, context: contextBytes },
+      privateKey,
+      payloadBytes
+    );
+    return new Uint8Array(sig);
+  }
+
+  // Classical fallback
+  const framed = frameFallbackInput(payloadBytes, contextBytes);
+  const sig = await crypto.subtle.sign('Ed25519', privateKey, framed);
+  return new Uint8Array(sig);
+}
+
+/**
+ * Verify signature over payload bytes with public key and optional domain separation context.
+ */
+export async function verifyPayload(publicKeyOrBytes, signature, payload, context = new Uint8Array(0)) {
+  const payloadBytes = toUint8Array(payload);
+  const signatureBytes = toUint8Array(signature);
+  const contextBytes = normalizeContext(context);
+
+  const publicKey = await importPublicKey(publicKeyOrBytes);
+  const algName = publicKey.algorithm?.name || '';
+
+  if (algName.startsWith('ML-DSA')) {
+    return crypto.subtle.verify(
+      { name: algName, context: contextBytes },
+      publicKey,
+      signatureBytes,
+      payloadBytes
+    );
+  }
+
+  const framed = frameFallbackInput(payloadBytes, contextBytes);
+  return crypto.subtle.verify('Ed25519', publicKey, signatureBytes, framed);
+}
+
+/**
+ * High-level API: Sign a text message
+ */
+export async function signMessage(privateKey, messageText, context = '') {
+  const payloadBytes = new TextEncoder().encode(messageText);
+  const contextBytes = typeof context === 'string' ? new TextEncoder().encode(context) : toUint8Array(context);
+  const signatureBytes = await signPayload(privateKey, payloadBytes, contextBytes);
+
+  return {
+    algorithm: privateKey.algorithm?.name || '',
+    message: messageText,
+    context: typeof context === 'string' ? context : bytesToBase64Url(contextBytes),
+    signatureBytes,
+    signatureBase64: bytesToBase64Url(signatureBytes),
+    signatureHex: bytesToHex(signatureBytes),
+  };
+}
+
+/**
+ * High-level API: Verify a text message
+ */
+export async function verifyMessage(publicKeyOrBytes, signatureInput, messageText, context = '') {
+  const signatureBytes = typeof signatureInput === 'string' ? base64UrlToBytes(signatureInput) : toUint8Array(signatureInput);
+  const payloadBytes = new TextEncoder().encode(messageText);
+  const contextBytes = typeof context === 'string' ? new TextEncoder().encode(context) : toUint8Array(context);
+
+  return verifyPayload(publicKeyOrBytes, signatureBytes, payloadBytes, contextBytes);
+}
+
+/**
+ * High-level API: Create a cryptographically signed token (e.g. coffee order, loyalty voucher)
+ * Structure: <header_b64>.<payload_b64>.<signature_b64>
+ */
+export async function createSignedToken(privateKey, payload, options = {}) {
+  const {
+    context = 'dg-token-v1',
+    tokenType = 'DG-AUTH-TOKEN+JSON',
+    publicKeyBytes = null,
+  } = options;
+
+  const algName = privateKey.algorithm?.name || '';
+  const header = {
+    alg: algName,
+    typ: tokenType,
+    ctx: context,
+    iat: Math.floor(Date.now() / 1000),
+  };
+
+  if (publicKeyBytes) {
+    header.pk = bytesToBase64Url(publicKeyBytes);
+  }
+
+  const headerB64 = bytesToBase64Url(new TextEncoder().encode(JSON.stringify(header)));
+  const payloadB64 = bytesToBase64Url(new TextEncoder().encode(JSON.stringify(payload)));
+  const signingInput = `${headerB64}.${payloadB64}`;
+
+  const contextBytes = new TextEncoder().encode(context);
+  const signatureBytes = await signPayload(
+    privateKey,
+    new TextEncoder().encode(signingInput),
+    contextBytes
+  );
+  const signatureB64 = bytesToBase64Url(signatureBytes);
+
+  const tokenString = `${signingInput}.${signatureB64}`;
+
+  return {
+    token: tokenString,
+    header,
+    payload,
+    signatureBase64: signatureB64,
+    algorithm: algName,
+  };
+}
+
+/**
+ * High-level API: Verify a signed token
+ */
+export async function verifySignedToken(tokenString, publicKeyOrBytes = null, options = {}) {
+  try {
+    const parts = tokenString.trim().split('.');
+    if (parts.length !== 3) {
+      return { valid: false, error: 'Malformed token: expected header.payload.signature' };
+    }
+
+    const [headerB64, payloadB64, signatureB64] = parts;
+    const header = JSON.parse(new TextDecoder().decode(base64UrlToBytes(headerB64)));
+    const payload = JSON.parse(new TextDecoder().decode(base64UrlToBytes(payloadB64)));
+    const signatureBytes = base64UrlToBytes(signatureB64);
+
+    let pubKey = publicKeyOrBytes;
+    if (!pubKey && header.pk) {
+      pubKey = base64UrlToBytes(header.pk);
+    }
+    if (!pubKey) {
+      return { valid: false, error: 'No public key provided or embedded in token' };
+    }
+
+    const context = options.expectedContext !== undefined ? options.expectedContext : (header.ctx || '');
+    const contextBytes = new TextEncoder().encode(context);
+    const signingInput = `${headerB64}.${payloadB64}`;
+
+    const isValid = await verifyPayload(
+      pubKey,
+      signatureBytes,
+      new TextEncoder().encode(signingInput),
+      contextBytes
+    );
+
+    return {
+      valid: isValid,
+      header,
+      payload,
+      algorithm: header.alg,
+      context,
+      error: isValid ? null : 'Cryptographic signature verification failed (tampered or invalid key)',
+    };
+  } catch (err) {
+    return {
+      valid: false,
+      error: err.message || 'Verification exception',
+    };
+  }
+}
+
+/**
+ * High-level API: Sign an artifact (file, image, document, binary buffer)
+ */
+export async function signArtifact(privateKey, artifactData, options = {}) {
+  const {
+    artifactName = 'unnamed-artifact',
+    mimeType = 'application/octet-stream',
+    context = 'artifact-verification-v1',
+  } = options;
+
+  const artifactBytes = toUint8Array(artifactData);
+  const sha256Digest = await hashSha256(artifactBytes);
+  const sha256Hex = bytesToHex(sha256Digest);
+
+  const contextBytes = new TextEncoder().encode(context);
+  const signatureBytes = await signPayload(privateKey, artifactBytes, contextBytes);
+
+  return {
+    artifactName,
+    mimeType,
+    byteLength: artifactBytes.byteLength,
+    sha256Hex,
+    context,
+    algorithm: privateKey.algorithm?.name || '',
+    signatureBytes,
+    signatureBase64: bytesToBase64Url(signatureBytes),
+    signatureHex: bytesToHex(signatureBytes),
+  };
+}
+
+/**
+ * High-level API: Verify an artifact
+ */
+export async function verifyArtifact(publicKeyOrBytes, signatureInput, artifactData, options = {}) {
+  const {
+    context = 'artifact-verification-v1',
+    expectedSha256Hex = null,
+  } = options;
+
+  const artifactBytes = toUint8Array(artifactData);
+  const currentDigest = await hashSha256(artifactBytes);
+  const currentSha256Hex = bytesToHex(currentDigest);
+
+  if (expectedSha256Hex && expectedSha256Hex.toLowerCase() !== currentSha256Hex.toLowerCase()) {
+    return {
+      valid: false,
+      sha256Hex: currentSha256Hex,
+      error: `SHA-256 hash mismatch: expected ${expectedSha256Hex}, got ${currentSha256Hex}`,
+    };
+  }
+
+  const signatureBytes = typeof signatureInput === 'string' ? base64UrlToBytes(signatureInput) : toUint8Array(signatureInput);
+  const contextBytes = new TextEncoder().encode(context);
+
+  const isValid = await verifyPayload(publicKeyOrBytes, signatureBytes, artifactBytes, contextBytes);
+
+  return {
+    valid: isValid,
+    sha256Hex: currentSha256Hex,
+    byteLength: artifactBytes.byteLength,
+    error: isValid ? null : 'Signature verification failed (artifact data tampered or wrong key/context)',
+  };
+}
