+    const signature = await signPayload(keyPair.privateKey, payload, context);
+    assert.strictEqual(signature.byteLength, 64);
+
+    const valid = await verifyPayload(publicKeyBytes, signature, payload, context);
+    assert.strictEqual(valid, true);
+
+    // Different context fails on Ed25519 through frameFallbackInput
+    const differentContext = new TextEncoder().encode('wrong-context');
+    const invalidCtx = await verifyPayload(publicKeyBytes, signature, payload, differentContext);
+    assert.strictEqual(invalidCtx, false);
+  });
+});
