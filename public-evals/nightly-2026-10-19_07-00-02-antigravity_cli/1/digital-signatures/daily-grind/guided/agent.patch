+import {
+  supportsAlgorithm,
+  supportsPostQuantumSignatures,
+  supportsEd25519,
+  getAvailableSignatureSuites,
+  generateSigningKeyPair,
+  exportPublicKey,
+  exportPrivateKey,
+  importPublicKey,
+  importPrivateKey,
+  signMessage,
+  verifyMessage,
+  createSignedToken,
+  verifySignedToken,
+  signArtifact,
+  verifyArtifact,
+  bytesToBase64Url,
+  base64UrlToBytes,
+  bytesToHex,
+  hexToBytes,
+  hashSha256,
+} from './crypto-signatures.js';
+
+// Application state
+const state = {
+  activeAlgorithm: 'ML-DSA-65',
+  currentKeyPair: null,
+  currentPublicKeyBytes: null,
+  currentPublicKeyB64: '',
+  currentPublicKeyHex: '',
+  // Message tab state
+  lastMessageSignature: null,
+  // Token tab state
+  lastSignedToken: null,
+  // Artifact tab state
+  currentArtifactBytes: null,
+  currentArtifactName: 'coffee-batch-sample.jpg',
+  currentArtifactMime: 'image/jpeg',
+  lastArtifactSignature: null,
+  lastArtifactHash: null,
+};
+
+// UI helper to log activities
+function logActivity(action, details, isSuccess = true) {
+  const logContainer = document.getElementById('crypto-activity-log');
+  if (!logContainer) return;
+
+  const entry = document.createElement('div');
+  entry.className = `log-entry ${isSuccess ? 'log-success' : 'log-error'}`;
+  const timestamp = new Date().toLocaleTimeString();
+  entry.innerHTML = `
+    <span class="log-time">[${timestamp}]</span>
+    <span class="log-action"><strong>${action}</strong>:</span>
+    <span class="log-details">${details}</span>
+  `;
+  logContainer.prepend(entry);
+}
+
+// Show feedback message in a banner
+function setStatusFeedback(elementId, isValid, message) {
+  const el = document.getElementById(elementId);
+  if (!el) return;
+
+  el.className = `status-banner ${isValid ? 'status-valid' : 'status-invalid'}`;
+  el.innerHTML = `
+    <span class="status-icon">${isValid ? '✓' : '✗'}</span>
+    <span class="status-text">${message}</span>
+  `;
+  el.style.display = 'flex';
+}
+
+// Tab navigation handler
+function setupTabs() {
+  const tabButtons = document.querySelectorAll('.tab-btn');
+  const tabPanes = document.querySelectorAll('.tab-pane');
+
+  tabButtons.forEach((btn) => {
+    btn.addEventListener('click', () => {
+      tabButtons.forEach((b) => b.classList.remove('active'));
+      tabPanes.forEach((p) => p.classList.remove('active'));
+
+      btn.classList.add('active');
+      const targetPane = document.getElementById(btn.dataset.target);
+      if (targetPane) {
+        targetPane.classList.add('active');
+      }
+    });
+  });
+}
+
+// Initialize system engine status
+async function initEngineStatus() {
+  const pqSupported = supportsPostQuantumSignatures();
+  const edSupported = supportsEd25519();
+  const staticSupportsAvailable = typeof globalThis.SubtleCrypto?.supports === 'function';
+
+  const badgePq = document.getElementById('badge-pq-status');
+  const badgeEd = document.getElementById('badge-ed-status');
+  const badgeSubtle = document.getElementById('badge-subtle-status');
+
+  if (badgePq) {
+    badgePq.textContent = pqSupported ? 'ML-DSA Post-Quantum Active' : 'ML-DSA Not Available';
+    badgePq.className = `badge ${pqSupported ? 'badge-active' : 'badge-fallback'}`;
+  }
+
+  if (badgeEd) {
+    badgeEd.textContent = edSupported ? 'Ed25519 Classical Supported' : 'Ed25519 Unsupported';
+    badgeEd.className = `badge ${edSupported ? 'badge-active' : 'badge-fallback'}`;
+  }
+
+  if (badgeSubtle) {
+    badgeSubtle.textContent = staticSupportsAvailable ? 'SubtleCrypto.supports() Present' : 'SubtleCrypto.supports() Missing';
+    badgeSubtle.className = `badge ${staticSupportsAvailable ? 'badge-active' : 'badge-fallback'}`;
+  }
+
+  // Populate algorithm select
+  const algSelect = document.getElementById('select-algorithm');
+  if (algSelect) {
+    algSelect.innerHTML = '';
+    const suites = getAvailableSignatureSuites();
+    suites.forEach((suite) => {
+      const option = document.createElement('option');
+      option.value = suite.name;
+      option.textContent = `${suite.name} (${suite.type.toUpperCase()} - ${suite.securityLevel})`;
+      if (suite.recommended && suite.supported) {
+        option.selected = true;
+      }
+      algSelect.appendChild(option);
+    });
+
+    if (!pqSupported && edSupported) {
+      algSelect.value = 'Ed25519';
+    }
+  }
+}
+
+// Generate new key pair
+async function handleGenerateKeyPair() {
+  const algSelect = document.getElementById('select-algorithm');
+  const chosenAlg = algSelect ? algSelect.value : 'ML-DSA-65';
+
+  try {
+    const res = await generateSigningKeyPair({ algorithm: chosenAlg });
+    state.activeAlgorithm = res.suite;
+    state.currentKeyPair = res.keyPair;
+    state.currentPublicKeyBytes = res.publicKeyBytes;
+    state.currentPublicKeyB64 = res.publicKeyBase64;
+    state.currentPublicKeyHex = res.publicKeyHex;
+
+    // Update UI
+    document.getElementById('display-active-suite').textContent = res.suite;
+    document.getElementById('display-key-type').textContent = res.type === 'post-quantum' ? 'Quantum-Resistant Lattice (NIST FIPS 204)' : 'Classical Edwards Curve (RFC 8032)';
+    document.getElementById('display-pubkey-size').textContent = `${res.publicKeyBytes.byteLength} bytes`;
+    document.getElementById('display-pubkey-b64').value = res.publicKeyBase64;
+    document.getElementById('display-pubkey-hex').value = res.publicKeyHex;
+
+    logActivity('Key Pair Generated', `Created new ${res.suite} asymmetric key pair (${res.publicKeyBytes.byteLength} bytes public key)`, true);
+    setStatusFeedback('key-status-banner', true, `Successfully generated ${res.suite} key pair. Ready for signing & verification.`);
+  } catch (err) {
+    console.error('Key generation error:', err);
+    logActivity('Key Generation Error', err.message, false);
+    setStatusFeedback('key-status-banner', false, `Failed to generate key pair: ${err.message}`);
+  }
+}
+
+// Copy helper
+function setupCopyButtons() {
+  document.querySelectorAll('.copy-btn').forEach((btn) => {
+    btn.addEventListener('click', async () => {
+      const targetId = btn.dataset.copyTarget;
+      const input = document.getElementById(targetId);
+      if (input && input.value) {
+        try {
+          await navigator.clipboard.writeText(input.value);
+          const originalText = btn.textContent;
+          btn.textContent = 'Copied!';
+          setTimeout(() => {
+            btn.textContent = originalText;
+          }, 1500);
+        } catch {
+          input.select();
+          document.execCommand('copy');
+        }
+      }
+    });
+  });
+}
+
+// Message signing & verification
+function setupMessageTab() {
+  const msgInput = document.getElementById('input-message-text');
+  const contextInput = document.getElementById('input-message-context');
+  const signBtn = document.getElementById('btn-sign-message');
+  const verifyBtn = document.getElementById('btn-verify-message');
+  const tamperBtn = document.getElementById('btn-tamper-message');
+  const sigOutput = document.getElementById('output-message-signature');
+
+  // Preset buttons
+  document.querySelectorAll('.preset-btn').forEach((btn) => {
+    btn.addEventListener('click', () => {
+      if (msgInput) {
+        msgInput.value = btn.dataset.preset;
+      }
+    });
+  });
+
+  if (signBtn) {
+    signBtn.addEventListener('click', async () => {
+      if (!state.currentKeyPair) {
+        alert('Please generate a key pair first.');
+        return;
+      }
+      const message = msgInput.value.trim();
+      const context = contextInput.value.trim();
+
+      try {
+        const result = await signMessage(state.currentKeyPair.privateKey, message, context);
+        state.lastMessageSignature = result.signatureBase64;
+        sigOutput.value = result.signatureBase64;
+        logActivity('Message Signed', `Signed "${message.substring(0, 30)}..." using ${result.algorithm} with context "${context}"`, true);
+        setStatusFeedback('message-status-banner', true, `Message signed with ${result.algorithm}. Signature size: ${result.signatureBytes.byteLength} bytes.`);
+      } catch (err) {
+        console.error('Sign message error:', err);
+        logActivity('Sign Message Failed', err.message, false);
+        setStatusFeedback('message-status-banner', false, `Signing failed: ${err.message}`);
+      }
+    });
+  }
+
+  if (verifyBtn) {
+    verifyBtn.addEventListener('click', async () => {
+      if (!state.currentPublicKeyBytes) {
+        alert('No public key available. Please generate or import a key pair.');
+        return;
+      }
+      const message = msgInput.value.trim();
+      const context = contextInput.value.trim();
+      const signatureB64 = sigOutput.value.trim();
+
+      if (!signatureB64) {
+        alert('Please sign the message or provide a signature to verify.');
+        return;
+      }
+
+      try {
+        const isValid = await verifyMessage(state.currentPublicKeyBytes, signatureB64, message, context);
+        if (isValid) {
+          logActivity('Message Verified', `Signature valid! Integrity and authenticity confirmed for message.`, true);
+          setStatusFeedback('message-status-banner', true, `AUTHENTIC & INTACT: Signature mathematically verified. Message has not been altered.`);
+        } else {
+          logActivity('Verification Failed', `Signature invalid! Message or context does not match signature.`, false);
+          setStatusFeedback('message-status-banner', false, `INTEGRITY VIOLATION: Signature invalid! Data has been modified, context mismatch, or wrong key.`);
+        }
+      } catch (err) {
+        console.error('Verify error:', err);
+        logActivity('Verification Error', err.message, false);
+        setStatusFeedback('message-status-banner', false, `Verification failed: ${err.message}`);
+      }
+    });
+  }
+
+  if (tamperBtn) {
+    tamperBtn.addEventListener('click', async () => {
+      if (!msgInput.value) return;
+      msgInput.value += ' [TAMPERED: +10 Free Espresso Shots]';
+      logActivity('Tampering Simulated', 'Appended unauthorized content to message. Click "Verify Message" to test cryptographic detection.', false);
+      setStatusFeedback('message-status-banner', false, 'Message content was altered! Click "Verify Message" to observe cryptographic rejection.');
+    });
+  }
+}
+
+// Token signing & verification
+function setupTokenTab() {
+  const tokenPayloadInput = document.getElementById('input-token-payload');
+  const tokenContextInput = document.getElementById('input-token-context');
+  const signTokenBtn = document.getElementById('btn-sign-token');
+  const verifyTokenBtn = document.getElementById('btn-verify-token');
+  const tamperTokenBtn = document.getElementById('btn-tamper-token');
+  const tokenOutput = document.getElementById('output-signed-token');
+  const tokenInspector = document.getElementById('token-breakdown-display');
+
+  if (signTokenBtn) {
+    signTokenBtn.addEventListener('click', async () => {
+      if (!state.currentKeyPair) {
+        alert('Please generate a key pair first.');
+        return;
+      }
+      try {
+        const payload = JSON.parse(tokenPayloadInput.value);
+        const context = tokenContextInput.value.trim();
+
+        const result = await createSignedToken(state.currentKeyPair.privateKey, payload, {
+          context,
+          publicKeyBytes: state.currentPublicKeyBytes,
+        });
+
+        state.lastSignedToken = result.token;
+        tokenOutput.value = result.token;
+
+        // Render breakdown
+        const [hB64, pB64, sB64] = result.token.split('.');
+        tokenInspector.innerHTML = `
+          <div class="token-part token-header">
+            <strong>Header:</strong>
+            <pre>${JSON.stringify(result.header, null, 2)}</pre>
+          </div>
+          <div class="token-part token-payload">
+            <strong>Payload (Claims):</strong>
+            <pre>${JSON.stringify(result.payload, null, 2)}</pre>
+          </div>
+          <div class="token-part token-signature">
+            <strong>Signature (${result.algorithm}):</strong>
+            <code>${sB64.substring(0, 48)}... (${sB64.length} chars)</code>
+          </div>
+        `;
+
+        logActivity('Token Issued', `Signed authentic token for ${payload.customer || 'Customer'} with ${result.algorithm}`, true);
+        setStatusFeedback('token-status-banner', true, `Token issued successfully using ${result.algorithm}. Complete compact format ready.`);
+      } catch (err) {
+        console.error('Sign token error:', err);
+        logActivity('Token Issue Failed', err.message, false);
+        setStatusFeedback('token-status-banner', false, `Token issue failed: ${err.message}`);
+      }
+    });
+  }
+
+  if (verifyTokenBtn) {
+    verifyTokenBtn.addEventListener('click', async () => {
+      const tokenStr = tokenOutput.value.trim();
+      const context = tokenContextInput.value.trim();
+
+      if (!tokenStr) {
+        alert('Please issue a token or paste a token to verify.');
+        return;
+      }
+
+      try {
+        const verifyResult = await verifySignedToken(tokenStr, state.currentPublicKeyBytes, {
+          expectedContext: context,
+        });
+
+        if (verifyResult.valid) {
+          logActivity('Token Verified', `Cryptographic token authentic! Customer: ${verifyResult.payload.customer || 'N/A'}`, true);
+          setStatusFeedback('token-status-banner', true, `TOKEN VALID: Authenticity confirmed by ${verifyResult.algorithm} signature. Zero tampering detected.`);
+        } else {
+          logActivity('Token Rejected', verifyResult.error || 'Invalid signature', false);
+          setStatusFeedback('token-status-banner', false, `TOKEN REJECTED: ${verifyResult.error || 'Signature check failed. Token is forged or modified.'}`);
+        }
+      } catch (err) {
+        console.error('Verify token error:', err);
+        logActivity('Token Verify Error', err.message, false);
+        setStatusFeedback('token-status-banner', false, `Verification error: ${err.message}`);
+      }
+    });
+  }
+
+  if (tamperTokenBtn) {
+    tamperTokenBtn.addEventListener('click', () => {
+      const tokenStr = tokenOutput.value.trim();
+      if (!tokenStr) return;
+      const parts = tokenStr.split('.');
+      if (parts.length !== 3) return;
+
+      try {
+        const payloadJson = JSON.parse(new TextDecoder().decode(base64UrlToBytes(parts[1])));
+        // Maliciously forge extra points
+        payloadJson.rewardPoints = (payloadJson.rewardPoints || 100) + 99900;
+        payloadJson.unauthorizedBenefit = 'Free Unlimited Coffee for Life';
+
+        const forgedPayloadB64 = bytesToBase64Url(new TextEncoder().encode(JSON.stringify(payloadJson)));
+        const tamperedToken = `${parts[0]}.${forgedPayloadB64}.${parts[2]}`;
+        tokenOutput.value = tamperedToken;
+
+        tokenInspector.innerHTML = `
+          <div class="token-part token-header">
+            <strong>Header:</strong>
+            <pre>${new TextDecoder().decode(base64UrlToBytes(parts[0]))}</pre>
+          </div>
+          <div class="token-part token-payload token-tampered">
+            <strong>TAMPERED Payload:</strong>
+            <pre>${JSON.stringify(payloadJson, null, 2)}</pre>
+          </div>
+          <div class="token-part token-signature">
+            <strong>Original Signature (Now invalid for this payload):</strong>
+            <code>${parts[2].substring(0, 48)}...</code>
+          </div>
+        `;
+
+        logActivity('Token Tampered', 'Modified claims in token payload without valid private key. Click "Verify Token" to verify defense.', false);
+        setStatusFeedback('token-status-banner', false, 'Token claims modified! Click "Verify Token" to observe cryptographic defense in action.');
+      } catch (err) {
+        console.error('Tamper token error:', err);
+      }
+    });
+  }
+}
+
+// Artifact signing & verification
+async function loadSampleArtifact() {
+  try {
+    const response = await fetch('./coffee-batch-sample.jpg');
+    if (!response.ok) {
+      throw new Error(`HTTP ${response.status}`);
+    }
+    const blob = await response.blob();
+    const arrayBuffer = await blob.arrayBuffer();
+    state.currentArtifactBytes = new Uint8Array(arrayBuffer);
+    state.currentArtifactName = 'coffee-batch-sample.jpg';
+    state.currentArtifactMime = 'image/jpeg';
+
+    const hash = await hashSha256(state.currentArtifactBytes);
+    const hashHex = bytesToHex(hash);
+    state.lastArtifactHash = hashHex;
+
+    document.getElementById('artifact-file-name').textContent = 'coffee-batch-sample.jpg (Artisanal Coffee Batch #982)';
+    document.getElementById('artifact-file-size').textContent = `${state.currentArtifactBytes.byteLength} bytes`;
+    document.getElementById('artifact-file-hash').textContent = hashHex;
+  } catch (err) {
+    console.warn('Could not load local sample image, generating synthetic batch bytes:', err);
+    // Generate fallback simulated batch artifact
+    const simulated = new TextEncoder().encode('THE DAILY GRIND - ETHIOPIAN YIRGACHEFFE ORGANIC LOT 982 CERTIFICATE');
+    state.currentArtifactBytes = simulated;
+    state.currentArtifactName = 'batch-provenance.cert';
+    state.currentArtifactMime = 'text/plain';
+    const hash = await hashSha256(simulated);
+    state.lastArtifactHash = bytesToHex(hash);
+  }
+}
+
+function setupArtifactTab() {
+  const signArtifactBtn = document.getElementById('btn-sign-artifact');
+  const verifyArtifactBtn = document.getElementById('btn-verify-artifact');
+  const tamperArtifactBtn = document.getElementById('btn-tamper-artifact');
+  const fileInput = document.getElementById('input-artifact-file');
+  const contextInput = document.getElementById('input-artifact-context');
+  const sigOutput = document.getElementById('output-artifact-signature');
+
+  if (fileInput) {
+    fileInput.addEventListener('change', async (e) => {
+      const file = e.target.files[0];
+      if (!file) return;
+
+      const buffer = await file.arrayBuffer();
+      state.currentArtifactBytes = new Uint8Array(buffer);
+      state.currentArtifactName = file.name;
+      state.currentArtifactMime = file.type || 'application/octet-stream';
+
+      const hash = await hashSha256(state.currentArtifactBytes);
+      const hashHex = bytesToHex(hash);
+      state.lastArtifactHash = hashHex;
+
+      document.getElementById('artifact-file-name').textContent = `${file.name} (${state.currentArtifactMime})`;
+      document.getElementById('artifact-file-size').textContent = `${state.currentArtifactBytes.byteLength} bytes`;
+      document.getElementById('artifact-file-hash').textContent = hashHex;
+
+      // If it's an image, update preview
+      if (file.type.startsWith('image/')) {
+        const previewImg = document.getElementById('artifact-preview-img');
+        if (previewImg) {
+          previewImg.src = URL.createObjectURL(file);
+        }
+      }
+
+      logActivity('Artifact Loaded', `Loaded ${file.name} (${state.currentArtifactBytes.byteLength} bytes, SHA-256: ${hashHex.substring(0, 16)}...)`, true);
+    });
+  }
+
+  if (signArtifactBtn) {
+    signArtifactBtn.addEventListener('click', async () => {
+      if (!state.currentKeyPair) {
+        alert('Please generate a key pair first.');
+        return;
+      }
+      if (!state.currentArtifactBytes) {
+        alert('No artifact data loaded.');
+        return;
+      }
+
+      const context = contextInput.value.trim();
+      try {
+        const result = await signArtifact(state.currentKeyPair.privateKey, state.currentArtifactBytes, {
+          artifactName: state.currentArtifactName,
+          mimeType: state.currentArtifactMime,
+          context,
+        });
+
+        state.lastArtifactSignature = result.signatureBase64;
+        sigOutput.value = result.signatureBase64;
+
+        logActivity('Artifact Signed', `Signed ${result.artifactName} with ${result.algorithm} (SHA-256: ${result.sha256Hex.substring(0, 16)}...)`, true);
+        setStatusFeedback('artifact-status-banner', true, `Artifact signed successfully! SHA-256 digest & asymmetric signature generated.`);
+      } catch (err) {
+        console.error('Sign artifact error:', err);
+        logActivity('Sign Artifact Failed', err.message, false);
+        setStatusFeedback('artifact-status-banner', false, `Artifact signing failed: ${err.message}`);
+      }
+    });
+  }
+
+  if (verifyArtifactBtn) {
+    verifyArtifactBtn.addEventListener('click', async () => {
+      if (!state.currentPublicKeyBytes) {
+        alert('No public key available.');
+        return;
+      }
+      if (!state.currentArtifactBytes) {
+        alert('No artifact data loaded.');
+        return;
+      }
+      const signatureB64 = sigOutput.value.trim();
+      if (!signatureB64) {
+        alert('Please sign the artifact or enter a signature.');
+        return;
+      }
+
+      const context = contextInput.value.trim();
+      try {
+        const verifyResult = await verifyArtifact(
+          state.currentPublicKeyBytes,
+          signatureB64,
+          state.currentArtifactBytes,
+          {
+            context,
+            expectedSha256Hex: state.lastArtifactHash,
+          }
+        );
+
+        if (verifyResult.valid) {
+          logActivity('Artifact Verified', `Authenticity of ${state.currentArtifactName} verified. File is genuine and unaltered.`, true);
+          setStatusFeedback('artifact-status-banner', true, `ARTIFACT AUTHENTIC: Signature and hash verified. Data provenance and integrity guaranteed.`);
+        } else {
+          logActivity('Artifact Rejected', verifyResult.error || 'Verification failed', false);
+          setStatusFeedback('artifact-status-banner', false, `ARTIFACT REJECTED: ${verifyResult.error || 'Cryptographic signature mismatch.'}`);
+        }
+      } catch (err) {
+        console.error('Verify artifact error:', err);
+        logActivity('Verify Artifact Error', err.message, false);
+        setStatusFeedback('artifact-status-banner', false, `Artifact verification error: ${err.message}`);
+      }
+    });
+  }
+
+  if (tamperArtifactBtn) {
+    tamperArtifactBtn.addEventListener('click', async () => {
+      if (!state.currentArtifactBytes || state.currentArtifactBytes.byteLength === 0) return;
+
+      // Corrupt 1 byte in the artifact buffer
+      const corrupted = new Uint8Array(state.currentArtifactBytes);
+      corrupted[Math.floor(corrupted.length / 2)] ^= 0xff;
+      state.currentArtifactBytes = corrupted;
+
+      const newHash = await hashSha256(state.currentArtifactBytes);
+      const newHashHex = bytesToHex(newHash);
+      document.getElementById('artifact-file-hash').textContent = `${newHashHex} (TAMPERED)`;
+
+      logActivity('Artifact Tampered', `Mutated 1 byte in artifact buffer. Hash changed. Click "Verify Artifact" to test cryptographic rejection.`, false);
+      setStatusFeedback('artifact-status-banner', false, 'Artifact bytes mutated! Click "Verify Artifact" to verify integrity check fails.');
+    });
+  }
+}
+
+// Global initialization
+window.addEventListener('DOMContentLoaded', async () => {
+  setupTabs();
+  setupCopyButtons();
+  await initEngineStatus();
+
+  // Attach key pair generation listener
+  const genBtn = document.getElementById('btn-generate-key');
+  if (genBtn) {
+    genBtn.addEventListener('click', handleGenerateKeyPair);
+  }
+
+  // Generate initial key pair automatically
+  await handleGenerateKeyPair();
+
+  // Setup functional tabs
+  setupMessageTab();
+  setupTokenTab();
+  setupArtifactTab();
+
+  // Load sample artifact image
+  await loadSampleArtifact();
+});
