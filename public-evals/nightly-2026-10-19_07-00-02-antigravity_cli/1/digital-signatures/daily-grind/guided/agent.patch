+describe('Utility Functions', () => {
+  test('base64url and hex conversions round-trip accurately', () => {
+    const original = new Uint8Array([0, 1, 2, 253, 254, 255, 128, 64, 32]);
+    const b64 = bytesToBase64Url(original);
+    const fromB64 = base64UrlToBytes(b64);
+    assert.deepStrictEqual(fromB64, original);
+
+    const hex = bytesToHex(original);
+    const fromHex = hexToBytes(hex);
+    assert.deepStrictEqual(fromHex, original);
+  });
+
+  test('hashSha256 produces valid 32-byte hash', async () => {
+    const text = 'The Daily Grind Artisanal Coffee';
+    const hash = await hashSha256(text);
+    assert.strictEqual(hash.byteLength, 32);
+    const hex = bytesToHex(hash);
+    assert.strictEqual(hex.length, 64);
+  });
+
+  test('frameFallbackInput prefixes length byte and context', () => {
+    const payload = new Uint8Array([10, 20]);
+    const ctx = new Uint8Array([1, 2, 3]);
+    const framed = frameFallbackInput(payload, ctx);
+    assert.strictEqual(framed[0], 3); // context length
+    assert.strictEqual(framed[1], 1);
+    assert.strictEqual(framed[2], 2);
+    assert.strictEqual(framed[3], 3);
+    assert.strictEqual(framed[4], 10);
+    assert.strictEqual(framed[5], 20);
+  });
