+    // Verify untampered artifact
+    const verifyResult = await verifyArtifact(
+      publicKeyBytes,
+      artifactSigned.signatureBase64,
+      artifactBytes,
+      {
+        context: 'provenance-v1',
+        expectedSha256Hex: artifactSigned.sha256Hex,
+      }
+    );
+    assert.strictEqual(verifyResult.valid, true);
+    assert.strictEqual(verifyResult.sha256Hex, artifactSigned.sha256Hex);
+
+    // Mutate 1 byte of the artifact
+    const tamperedBytes = new Uint8Array(artifactBytes);
+    tamperedBytes[100] ^= 0x01;
+
+    // Fails on hash mismatch if expected hash supplied
+    const tamperedHashResult = await verifyArtifact(
+      publicKeyBytes,
+      artifactSigned.signatureBase64,
+      tamperedBytes,
+      {
+        context: 'provenance-v1',
+        expectedSha256Hex: artifactSigned.sha256Hex,
+      }
+    );
+    assert.strictEqual(tamperedHashResult.valid, false);
+
+    // Fails on signature verification if expected hash omitted
+    const tamperedSigResult = await verifyArtifact(
+      publicKeyBytes,
+      artifactSigned.signatureBase64,
+      tamperedBytes,
+      {
+        context: 'provenance-v1',
+      }
+    );
+    assert.strictEqual(tamperedSigResult.valid, false);
+  });
+});
