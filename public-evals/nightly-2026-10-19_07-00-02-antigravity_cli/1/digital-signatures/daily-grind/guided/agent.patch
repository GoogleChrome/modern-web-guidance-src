+describe('Key Generation & Export/Import', () => {
+  test('generates ML-DSA-65 key pair by default in auto mode when supported', async () => {
+    const result = await generateSigningKeyPair({ algorithm: 'auto' });
+    if (supportsPostQuantumSignatures()) {
+      assert.strictEqual(result.suite, 'ML-DSA-65');
+      assert.strictEqual(result.type, 'post-quantum');
+      assert.strictEqual(result.keyFormat, 'raw-public');
+      assert.strictEqual(result.publicKeyBytes.byteLength, 1952);
+    } else {
+      assert.strictEqual(result.suite, 'Ed25519');
+      assert.strictEqual(result.type, 'classical');
+      assert.strictEqual(result.publicKeyBytes.byteLength, 32);
+    }
+  });
+
+  test('generates ML-DSA-44 key pair when requested', async () => {
+    if (!supportsAlgorithm('sign', 'ML-DSA-44')) return;
+    const result = await generateSigningKeyPair({ algorithm: 'ML-DSA-44' });
+    assert.strictEqual(result.suite, 'ML-DSA-44');
+    assert.strictEqual(result.publicKeyBytes.byteLength, 1312);
+  });
+
+  test('generates ML-DSA-87 key pair when requested', async () => {
+    if (!supportsAlgorithm('sign', 'ML-DSA-87')) return;
+    const result = await generateSigningKeyPair({ algorithm: 'ML-DSA-87' });
+    assert.strictEqual(result.suite, 'ML-DSA-87');
+    assert.strictEqual(result.publicKeyBytes.byteLength, 2592);
+  });
+
+  test('generates Ed25519 key pair when requested', async () => {
+    if (!supportsEd25519()) return;
+    const result = await generateSigningKeyPair({ algorithm: 'Ed25519' });
+    assert.strictEqual(result.suite, 'Ed25519');
+    assert.strictEqual(result.type, 'classical');
+    assert.strictEqual(result.publicKeyBytes.byteLength, 32);
+  });
+
+  test('exports and re-imports ML-DSA-65 public key (raw-public) and private key (raw-seed)', async () => {
+    if (!supportsPostQuantumSignatures()) return;
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair({ algorithm: 'ML-DSA-65' });
+
+    // Public key export with raw-public
+    const pubExport = await exportPublicKey(keyPair.publicKey);
+    assert.strictEqual(pubExport.byteLength, 1952);
+    assert.deepStrictEqual(pubExport, publicKeyBytes);
+
+    // Private key export with raw-seed (32 bytes)
+    const privExport = await exportPrivateKey(keyPair.privateKey);
+    assert.strictEqual(privExport.byteLength, 32);
+
+    // Re-import public key
+    const importedPub = await importPublicKey(pubExport, 'ML-DSA-65');
+    assert.strictEqual(importedPub.type, 'public');
+    assert.strictEqual(importedPub.algorithm.name, 'ML-DSA-65');
+    assert.deepStrictEqual(importedPub.usages, ['verify']);
+
+    // Re-import private key
+    const importedPriv = await importPrivateKey(privExport, 'ML-DSA-65');
+    assert.strictEqual(importedPriv.type, 'private');
+    assert.strictEqual(importedPriv.algorithm.name, 'ML-DSA-65');
+    assert.deepStrictEqual(importedPriv.usages, ['sign']);
+
+    // Verify key works after round-trip
+    const payload = new TextEncoder().encode('Test roundtrip');
+    const sig = await signPayload(importedPriv, payload);
+    const valid = await verifyPayload(importedPub, sig, payload);
+    assert.strictEqual(valid, true);
+  });
+
+  test('auto-detects algorithm from public key length', async () => {
+    if (supportsPostQuantumSignatures()) {
+      const { publicKeyBytes } = await generateSigningKeyPair({ algorithm: 'ML-DSA-65' });
+      const imported = await importPublicKey(publicKeyBytes);
+      assert.strictEqual(imported.algorithm.name, 'ML-DSA-65');
+    }
+
+    if (supportsEd25519()) {
+      const { publicKeyBytes } = await generateSigningKeyPair({ algorithm: 'Ed25519' });
+      const imported = await importPublicKey(publicKeyBytes);
+      assert.strictEqual(imported.algorithm.name, 'Ed25519');
+    }
+  });
+
+  test('derives public key from private key using getPublicKey', async () => {
+    if (typeof crypto.subtle.getPublicKey !== 'function') return;
+    const { keyPair, publicKeyBytes } = await generateSigningKeyPair({ algorithm: 'ML-DSA-65' });
+    const derivedPub = await getPublicKeyFromPrivateKey(keyPair.privateKey);
+    assert.strictEqual(derivedPub.type, 'public');
+    assert.deepStrictEqual(derivedPub.usages, ['verify']);
+    const derivedBytes = await exportPublicKey(derivedPub);
+    assert.deepStrictEqual(derivedBytes, publicKeyBytes);
+  });
+});
