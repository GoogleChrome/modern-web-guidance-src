+describe('Cryptographic Capability Detection', () => {
+  test('static SubtleCrypto.supports checks algorithms without throwing', () => {
+    const mlDsa65 = supportsAlgorithm('sign', 'ML-DSA-65');
+    const ed25519 = supportsAlgorithm('sign', 'Ed25519');
+    assert.strictEqual(typeof mlDsa65, 'boolean');
+    assert.strictEqual(typeof ed25519, 'boolean');
+  });
+
+  test('reports available signature suites', () => {
+    const suites = getAvailableSignatureSuites();
+    assert.ok(Array.isArray(suites));
+    assert.ok(suites.length >= 4);
+
+    const mlDsa65Suite = suites.find((s) => s.name === 'ML-DSA-65');
+    assert.ok(mlDsa65Suite);
+    assert.strictEqual(mlDsa65Suite.type, 'post-quantum');
+    assert.strictEqual(mlDsa65Suite.publicKeyBytes, 1952);
+    assert.strictEqual(mlDsa65Suite.signatureBytes, 3309);
+    assert.strictEqual(mlDsa65Suite.recommended, true);
+
+    const edSuite = suites.find((s) => s.name === 'Ed25519');
+    assert.ok(edSuite);
+    assert.strictEqual(edSuite.type, 'classical');
+    assert.strictEqual(edSuite.publicKeyBytes, 32);
+  });
+});
