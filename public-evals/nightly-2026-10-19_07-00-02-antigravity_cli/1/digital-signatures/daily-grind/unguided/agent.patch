+import { AlgorithmId, AlgorithmMetadata } from './types.js';
+
+export const ALGORITHMS: Record<AlgorithmId, AlgorithmMetadata> = {
+  'ML-DSA-44': {
+    id: 'ML-DSA-44',
+    name: 'ML-DSA-44 (Dilithium2)',
+    category: 'post-quantum',
+    standard: 'NIST FIPS 204',
+    securityLevel: 'NIST Category 2 (~128-bit quantum security)',
+    quantumResistant: true,
+    publicKeySize: 1312,
+    signatureSize: 2420,
+    description:
+      'Module-Lattice-Based Digital Signature Standard (FIPS 204). Highly efficient, immune to Shor\'s quantum algorithm, recommended by NIST for general post-quantum digital signatures.',
+  },
+  'ML-DSA-65': {
+    id: 'ML-DSA-65',
+    name: 'ML-DSA-65 (Dilithium3)',
+    category: 'post-quantum',
+    standard: 'NIST FIPS 204',
+    securityLevel: 'NIST Category 3 (~192-bit quantum security)',
+    quantumResistant: true,
+    publicKeySize: 1952,
+    signatureSize: 3309,
+    description:
+      'Intermediate security level for Module-Lattice-Based signatures, equivalent to AES-192. Standard post-quantum choice for high-assurance applications.',
+  },
+  'ML-DSA-87': {
+    id: 'ML-DSA-87',
+    name: 'ML-DSA-87 (Dilithium5)',
+    category: 'post-quantum',
+    standard: 'NIST FIPS 204',
+    securityLevel: 'NIST Category 5 (~256-bit quantum security)',
+    quantumResistant: true,
+    publicKeySize: 2592,
+    signatureSize: 4627,
+    description:
+      'Maximum NIST security level for Module-Lattice-Based signatures, equivalent to AES-256 against quantum attacks.',
+  },
+  'SLH-DSA-SHA2-128s': {
+    id: 'SLH-DSA-SHA2-128s',
+    name: 'SLH-DSA-SHA2-128s (SPHINCS+)',
+    category: 'post-quantum',
+    standard: 'NIST FIPS 205',
+    securityLevel: 'NIST Category 1 (~128-bit quantum security)',
+    quantumResistant: true,
+    publicKeySize: 32,
+    signatureSize: 7856,
+    description:
+      'Stateless Hash-Based Digital Signature Standard (FIPS 205). Based solely on cryptographic hash functions without lattice hardness assumptions; ultra-compact 32-byte public key.',
+  },
+  'Ed25519': {
+    id: 'Ed25519',
+    name: 'Ed25519 (EdDSA)',
+    category: 'classical',
+    standard: 'RFC 8032 / FIPS 186-5',
+    securityLevel: '128-bit classical security (Vulnerable to Shor\'s Quantum Algorithm)',
+    quantumResistant: false,
+    publicKeySize: 32,
+    signatureSize: 64,
+    description:
+      'Widely used high-speed classical elliptic curve signature algorithm over Edwards25519. Minimal signature and key size, but vulnerable to future cryptanalytically relevant quantum computers (CRQCs).',
+  },
+  'ECDSA-P256': {
+    id: 'ECDSA-P256',
+    name: 'ECDSA (NIST P-256 + SHA-256)',
+    category: 'classical',
+    standard: 'ANSI X9.62 / FIPS 186-4',
+    securityLevel: '128-bit classical security (Vulnerable to Shor\'s Quantum Algorithm)',
+    quantumResistant: false,
+    publicKeySize: 65,
+    signatureSize: 64,
+    description:
+      'Standard NIST prime curve classical signature implemented natively in all browsers via Web Crypto API (SubtleCrypto).',
+  },
+  'RSA-PSS-2048': {
+    id: 'RSA-PSS-2048',
+    name: 'RSA-PSS 2048-bit (SHA-256)',
+    category: 'classical',
+    standard: 'PKCS #1 v2.2 / RFC 8017',
+    securityLevel: '112-bit classical security (Vulnerable to Shor\'s Quantum Algorithm)',
+    quantumResistant: false,
+    publicKeySize: 270,
+    signatureSize: 256,
+    description:
+      'Classical probabilistic signature scheme with RSA 2048-bit modulus. Standard legacy PKI algorithm, susceptible to polynomial-time quantum factorisation.',
+  },
+};
+
+export function getAlgorithmList(): AlgorithmMetadata[] {
+  return Object.values(ALGORITHMS);
+}
+
+export function getPostQuantumAlgorithms(): AlgorithmMetadata[] {
+  return getAlgorithmList().filter((a) => a.quantumResistant);
+}
+
+export function getClassicalAlgorithms(): AlgorithmMetadata[] {
+  return getAlgorithmList().filter((a) => !a.quantumResistant);
+}
diff --git a/src/crypto/artifact.ts b/src/crypto/artifact.ts
new file mode 100644
index 0000000..08db366
--- /dev/null
+++ b/src/crypto/artifact.ts
@@ -0,0 +1,205 @@
+import {
+  AlgorithmId,
+  ArtifactManifest,
+  SerializableKeyPair,
+  SignedArtifactEnvelope,
+  VerificationResult,
+} from './types.js';
+import {
+  base64ToBytes,
+  bytesToBase64,
+  canonicalJsonStringify,
+  computeSha256Hex,
+  stringToBytes,
+} from './utils.js';
+import { isPostQuantumAlgorithm, signPqc, verifyPqc } from './post-quantum.js';
+import { isClassicalAlgorithm, signClassical, verifyClassical } from './classical.js';
+
+/**
+ * Sign an artifact (file, image, document, binary data) by hashing its content
+ * and signing the manifest.
+ */
+export async function signArtifact(
+  algorithm: AlgorithmId,
+  fileBytes: Uint8Array,
+  fileName: string,
+  mimeType: string,
+  keyPair: SerializableKeyPair,
+  metadata?: Record<string, any>
+): Promise<SignedArtifactEnvelope> {
+  const sha256DigestHex = computeSha256Hex(fileBytes);
+
+  const manifest: ArtifactManifest = {
+    fileName,
+    fileSize: fileBytes.byteLength,
+    mimeType: mimeType || 'application/octet-stream',
+    sha256DigestHex,
+    timestamp: new Date().toISOString(),
+    metadata,
+  };
+
+  const canonicalManifest = canonicalJsonStringify(manifest);
+  const manifestBytes = stringToBytes(canonicalManifest);
+
+  let signatureBytes: Uint8Array;
+  if (isPostQuantumAlgorithm(algorithm)) {
+    const privBytes =
+      keyPair.rawPrivateKey ||
+      (keyPair.privateKeyBase64 ? base64ToBytes(keyPair.privateKeyBase64) : undefined);
+    if (!privBytes) {
+      throw new Error(`Private key missing for post-quantum algorithm ${algorithm}`);
+    }
+    signatureBytes = await signPqc(algorithm, manifestBytes, privBytes);
+  } else if (isClassicalAlgorithm(algorithm)) {
+    signatureBytes = await signClassical(algorithm, manifestBytes, keyPair);
+  } else {
+    throw new Error(`Unsupported algorithm ${algorithm}`);
+  }
+
+  const category = isPostQuantumAlgorithm(algorithm) ? 'post-quantum' : 'classical';
+
+  return {
+    version: '1.0',
+    algorithm,
+    category,
+    manifest,
+    signatureBase64: bytesToBase64(signatureBytes),
+    publicKeyBase64: keyPair.publicKeyBase64,
+    signerFingerprint: keyPair.fingerprint,
+  };
+}
+
+/**
+ * Verify an artifact against a signed manifest envelope
+ */
+export async function verifyArtifact(
+  fileBytes: Uint8Array,
+  envelope: SignedArtifactEnvelope,
+  keyPairOrPubKey?: SerializableKeyPair | Uint8Array
+): Promise<VerificationResult> {
+  const verifiedAt = new Date().toISOString();
+  const { algorithm, manifest, signatureBase64 } = envelope;
+  const isPqc = isPostQuantumAlgorithm(algorithm);
+  const isClass = isClassicalAlgorithm(algorithm);
+
+  if (!isPqc && !isClass) {
+    return {
+      valid: false,
+      algorithm,
+      category: 'classical',
+      error: `Unsupported algorithm: ${algorithm}`,
+      verifiedAt,
+    };
+  }
+
+  // 1. Check file content digest integrity
+  const actualSha256Hex = computeSha256Hex(fileBytes);
+  if (actualSha256Hex.toLowerCase() !== manifest.sha256DigestHex.toLowerCase()) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      signerFingerprint: envelope.signerFingerprint,
+      error: `Artifact content digest mismatch! Expected SHA-256 ${manifest.sha256DigestHex.substring(0, 16)}..., but received ${actualSha256Hex.substring(0, 16)}... The file has been modified or corrupted.`,
+      details: {
+        expectedDigest: manifest.sha256DigestHex,
+        actualDigest: actualSha256Hex,
+        expectedSize: manifest.fileSize,
+        actualSize: fileBytes.byteLength,
+      },
+      verifiedAt,
+    };
+  }
+
+  // 2. Check file size
+  if (fileBytes.byteLength !== manifest.fileSize) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      signerFingerprint: envelope.signerFingerprint,
+      error: `Artifact size mismatch! Expected ${manifest.fileSize} bytes, but received ${fileBytes.byteLength} bytes.`,
+      verifiedAt,
+    };
+  }
+
+  // 3. Verify cryptographic signature on manifest
+  const canonicalManifest = canonicalJsonStringify(manifest);
+  const manifestBytes = stringToBytes(canonicalManifest);
+
+  let signatureBytes: Uint8Array;
+  try {
+    signatureBytes = base64ToBytes(signatureBase64);
+  } catch (err) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      error: 'Invalid base64 signature encoding in envelope',
+      verifiedAt,
+    };
+  }
+
+  // Determine public key: either passed directly or retrieved from envelope
+  let pubKey: SerializableKeyPair | Uint8Array;
+  if (keyPairOrPubKey) {
+    pubKey = keyPairOrPubKey;
+  } else if (envelope.publicKeyBase64) {
+    pubKey = base64ToBytes(envelope.publicKeyBase64);
+  } else {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      error: 'No public key provided for verification',
+      verifiedAt,
+    };
+  }
+
+  let sigValid = false;
+  try {
+    if (isPqc) {
+      const pubBytes =
+        pubKey instanceof Uint8Array
+          ? pubKey
+          : pubKey.rawPublicKey || base64ToBytes(pubKey.publicKeyBase64);
+      sigValid = await verifyPqc(algorithm, signatureBytes, manifestBytes, pubBytes);
+    } else {
+      sigValid = await verifyClassical(algorithm, signatureBytes, manifestBytes, pubKey);
+    }
+  } catch (err: any) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      error: `Cryptographic verification error: ${err?.message || err}`,
+      verifiedAt,
+    };
+  }
+
+  if (!sigValid) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      signerFingerprint: envelope.signerFingerprint,
+      error: 'Manifest signature verification failed! The manifest was altered or the public key does not match the signer.',
+      details: { manifest },
+      verifiedAt,
+    };
+  }
+
+  return {
+    valid: true,
+    algorithm,
+    category: isPqc ? 'post-quantum' : 'classical',
+    signerFingerprint: envelope.signerFingerprint,
+    details: {
+      fileName: manifest.fileName,
+      fileSize: manifest.fileSize,
+      sha256DigestHex: actualSha256Hex,
+      manifestTimestamp: manifest.timestamp,
+    },
+    verifiedAt,
+  };
+}
diff --git a/src/crypto/classical.ts b/src/crypto/classical.ts
new file mode 100644
index 0000000..7c2dcc4
--- /dev/null
+++ b/src/crypto/classical.ts
@@ -0,0 +1,304 @@
+import { ed25519 } from '@noble/curves/ed25519.js';
+import { AlgorithmId, SerializableKeyPair } from './types.js';
+import {
+  bytesToBase64,
+  base64ToBytes,
+  bytesToHex,
+  hexToBytes,
+  computeFingerprint,
+} from './utils.js';
+
+export function isClassicalAlgorithm(algorithm: AlgorithmId): boolean {
+  return (
+    algorithm === 'Ed25519' ||
+    algorithm === 'ECDSA-P256' ||
+    algorithm === 'RSA-PSS-2048'
+  );
+}
+
+function getSubtleCrypto(): SubtleCrypto {
+  if (typeof window !== 'undefined' && window.crypto && window.crypto.subtle) {
+    return window.crypto.subtle;
+  }
+  if (typeof globalThis !== 'undefined' && globalThis.crypto && globalThis.crypto.subtle) {
+    return globalThis.crypto.subtle;
+  }
+  throw new Error('Web Crypto API (SubtleCrypto) is not available in this environment');
+}
+
+/**
+ * Generate a new classical keypair (Ed25519, ECDSA-P256, or RSA-PSS-2048)
+ */
+export async function generateClassicalKeyPair(
+  algorithm: AlgorithmId
+): Promise<SerializableKeyPair> {
+  const subtle = getSubtleCrypto();
+
+  if (algorithm === 'Ed25519') {
+    const privBytes = crypto.getRandomValues(new Uint8Array(32));
+    const pubBytes = ed25519.getPublicKey(privBytes);
+    const fingerprint = computeFingerprint(pubBytes);
+
+    return {
+      algorithm,
+      category: 'classical',
+      createdAt: new Date().toISOString(),
+      fingerprint,
+      publicKeyBase64: bytesToBase64(pubBytes),
+      publicKeyHex: bytesToHex(pubBytes),
+      privateKeyBase64: bytesToBase64(privBytes),
+      privateKeyHex: bytesToHex(privBytes),
+      rawPublicKey: pubBytes,
+      rawPrivateKey: privBytes,
+    };
+  }
+
+  if (algorithm === 'ECDSA-P256') {
+    const keyPair = await subtle.generateKey(
+      { name: 'ECDSA', namedCurve: 'P-256' },
+      true,
+      ['sign', 'verify']
+    );
+
+    const spki = new Uint8Array(await subtle.exportKey('spki', keyPair.publicKey));
+    const pkcs8 = new Uint8Array(await subtle.exportKey('pkcs8', keyPair.privateKey));
+    const fingerprint = computeFingerprint(spki);
+
+    return {
+      algorithm,
+      category: 'classical',
+      createdAt: new Date().toISOString(),
+      fingerprint,
+      publicKeyBase64: bytesToBase64(spki),
+      publicKeyHex: bytesToHex(spki),
+      privateKeyBase64: bytesToBase64(pkcs8),
+      privateKeyHex: bytesToHex(pkcs8),
+      rawPublicKey: spki,
+      rawPrivateKey: pkcs8,
+      nativePublicKey: keyPair.publicKey,
+      nativePrivateKey: keyPair.privateKey,
+    };
+  }
+
+  if (algorithm === 'RSA-PSS-2048') {
+    const keyPair = await subtle.generateKey(
+      {
+        name: 'RSA-PSS',
+        modulusLength: 2048,
+        publicExponent: new Uint8Array([1, 0, 1]),
+        hash: 'SHA-256',
+      },
+      true,
+      ['sign', 'verify']
+    );
+
+    const spki = new Uint8Array(await subtle.exportKey('spki', keyPair.publicKey));
+    const pkcs8 = new Uint8Array(await subtle.exportKey('pkcs8', keyPair.privateKey));
+    const fingerprint = computeFingerprint(spki);
+
+    return {
+      algorithm,
+      category: 'classical',
+      createdAt: new Date().toISOString(),
+      fingerprint,
+      publicKeyBase64: bytesToBase64(spki),
+      publicKeyHex: bytesToHex(spki),
+      privateKeyBase64: bytesToBase64(pkcs8),
+      privateKeyHex: bytesToHex(pkcs8),
+      rawPublicKey: spki,
+      rawPrivateKey: pkcs8,
+      nativePublicKey: keyPair.publicKey,
+      nativePrivateKey: keyPair.privateKey,
+    };
+  }
+
+  throw new Error(`Unsupported classical algorithm: ${algorithm}`);
+}
+
+/**
+ * Sign data using classical private key
+ */
+export async function signClassical(
+  algorithm: AlgorithmId,
+  messageBytes: Uint8Array,
+  keyPairOrPrivKey: SerializableKeyPair | Uint8Array
+): Promise<Uint8Array> {
+  const subtle = getSubtleCrypto();
+
+  if (algorithm === 'Ed25519') {
+    const privBytes =
+      keyPairOrPrivKey instanceof Uint8Array
+        ? keyPairOrPrivKey
+        : keyPairOrPrivKey.rawPrivateKey || base64ToBytes(keyPairOrPrivKey.privateKeyBase64!);
+    return ed25519.sign(messageBytes, privBytes);
+  }
+
+  if (algorithm === 'ECDSA-P256') {
+    let privKey: CryptoKey;
+    if (!(keyPairOrPrivKey instanceof Uint8Array) && keyPairOrPrivKey.nativePrivateKey) {
+      privKey = keyPairOrPrivKey.nativePrivateKey;
+    } else {
+      const pkcs8Bytes =
+        keyPairOrPrivKey instanceof Uint8Array
+          ? keyPairOrPrivKey
+          : keyPairOrPrivKey.rawPrivateKey || base64ToBytes(keyPairOrPrivKey.privateKeyBase64!);
+      privKey = await subtle.importKey(
+        'pkcs8',
+        pkcs8Bytes as BufferSource,
+        { name: 'ECDSA', namedCurve: 'P-256' },
+        false,
+        ['sign']
+      );
+    }
+
+    const sig = await subtle.sign(
+      { name: 'ECDSA', hash: 'SHA-256' },
+      privKey,
+      messageBytes as BufferSource
+    );
+    return new Uint8Array(sig);
+  }
+
+  if (algorithm === 'RSA-PSS-2048') {
+    let privKey: CryptoKey;
+    if (!(keyPairOrPrivKey instanceof Uint8Array) && keyPairOrPrivKey.nativePrivateKey) {
+      privKey = keyPairOrPrivKey.nativePrivateKey;
+    } else {
+      const pkcs8Bytes =
+        keyPairOrPrivKey instanceof Uint8Array
+          ? keyPairOrPrivKey
+          : keyPairOrPrivKey.rawPrivateKey || base64ToBytes(keyPairOrPrivKey.privateKeyBase64!);
+      privKey = await subtle.importKey(
+        'pkcs8',
+        pkcs8Bytes as BufferSource,
+        { name: 'RSA-PSS', hash: 'SHA-256' },
+        false,
+        ['sign']
+      );
+    }
+
+    const sig = await subtle.sign(
+      { name: 'RSA-PSS', saltLength: 32 },
+      privKey,
+      messageBytes as BufferSource
+    );
+    return new Uint8Array(sig);
+  }
+
+  throw new Error(`Unsupported classical algorithm: ${algorithm}`);
+}
+
+/**
+ * Verify signature using classical public key
+ */
+export async function verifyClassical(
+  algorithm: AlgorithmId,
+  signatureBytes: Uint8Array,
+  messageBytes: Uint8Array,
+  keyPairOrPubKey: SerializableKeyPair | Uint8Array
+): Promise<boolean> {
+  const subtle = getSubtleCrypto();
+
+  try {
+    if (algorithm === 'Ed25519') {
+      const pubBytes =
+        keyPairOrPubKey instanceof Uint8Array
+          ? keyPairOrPubKey
+          : keyPairOrPubKey.rawPublicKey || base64ToBytes(keyPairOrPubKey.publicKeyBase64);
+      return ed25519.verify(signatureBytes, messageBytes, pubBytes);
+    }
+
+    if (algorithm === 'ECDSA-P256') {
+      let pubKey: CryptoKey;
+      if (!(keyPairOrPubKey instanceof Uint8Array) && keyPairOrPubKey.nativePublicKey) {
+        pubKey = keyPairOrPubKey.nativePublicKey;
+      } else {
+        const spkiBytes =
+          keyPairOrPubKey instanceof Uint8Array
+            ? keyPairOrPubKey
+            : keyPairOrPubKey.rawPublicKey || base64ToBytes(keyPairOrPubKey.publicKeyBase64);
+        pubKey = await subtle.importKey(
+          'spki',
+          spkiBytes as BufferSource,
+          { name: 'ECDSA', namedCurve: 'P-256' },
+          false,
+          ['verify']
+        );
+      }
+
+      return await subtle.verify(
+        { name: 'ECDSA', hash: 'SHA-256' },
+        pubKey,
+        signatureBytes as BufferSource,
+        messageBytes as BufferSource
+      );
+    }
+
+    if (algorithm === 'RSA-PSS-2048') {
+      let pubKey: CryptoKey;
+      if (!(keyPairOrPubKey instanceof Uint8Array) && keyPairOrPubKey.nativePublicKey) {
+        pubKey = keyPairOrPubKey.nativePublicKey;
+      } else {
+        const spkiBytes =
+          keyPairOrPubKey instanceof Uint8Array
+            ? keyPairOrPubKey
+            : keyPairOrPubKey.rawPublicKey || base64ToBytes(keyPairOrPubKey.publicKeyBase64);
+        pubKey = await subtle.importKey(
+          'spki',
+          spkiBytes as BufferSource,
+          { name: 'RSA-PSS', hash: 'SHA-256' },
+          false,
+          ['verify']
+        );
+      }
+
+      return await subtle.verify(
+        { name: 'RSA-PSS', saltLength: 32 },
+        pubKey,
+        signatureBytes as BufferSource,
+        messageBytes as BufferSource
+      );
+    }
+  } catch (err) {
+    return false;
+  }
+
+  return false;
+}
+
+/**
+ * Import classical keypair from base64 or hex
+ */
+export async function importClassicalKeyPair(
+  algorithm: AlgorithmId,
+  publicKeyStr: string,
+  privateKeyStr?: string
+): Promise<SerializableKeyPair> {
+  if (!isClassicalAlgorithm(algorithm)) {
+    throw new Error(`Algorithm ${algorithm} is not a classical algorithm`);
+  }
+
+  const isHex = /^[0-9a-fA-F]+$/.test(publicKeyStr.trim()) && publicKeyStr.trim().length % 2 === 0;
+  const pubBytes = isHex ? hexToBytes(publicKeyStr.trim()) : base64ToBytes(publicKeyStr.trim());
+
+  let privBytes: Uint8Array | undefined;
+  if (privateKeyStr && privateKeyStr.trim()) {
+    const privHex = /^[0-9a-fA-F]+$/.test(privateKeyStr.trim()) && privateKeyStr.trim().length % 2 === 0;
+    privBytes = privHex ? hexToBytes(privateKeyStr.trim()) : base64ToBytes(privateKeyStr.trim());
+  }
+
+  const fingerprint = computeFingerprint(pubBytes);
+
+  return {
+    algorithm,
+    category: 'classical',
+    createdAt: new Date().toISOString(),
+    fingerprint,
+    publicKeyBase64: bytesToBase64(pubBytes),
+    publicKeyHex: bytesToHex(pubBytes),
+    privateKeyBase64: privBytes ? bytesToBase64(privBytes) : undefined,
+    privateKeyHex: privBytes ? bytesToHex(privBytes) : undefined,
+    rawPublicKey: pubBytes,
+    rawPrivateKey: privBytes,
+  };
+}
diff --git a/src/crypto/engine.ts b/src/crypto/engine.ts
new file mode 100644
index 0000000..23b4ab2
--- /dev/null
+++ b/src/crypto/engine.ts
@@ -0,0 +1,168 @@
+import {
+  AlgorithmId,
+  AlgorithmMetadata,
+  ArtifactManifest,
+  SerializableKeyPair,
+  SignedArtifactEnvelope,
+  SignedMessageEnvelope,
+  SignedToken,
+  TokenClaims,
+  VerificationResult,
+} from './types.js';
+import { ALGORITHMS, getAlgorithmList } from './algorithms.js';
+import {
+  generatePqcKeyPair,
+  importPqcKeyPair,
+  isPostQuantumAlgorithm,
+  signPqc,
+  verifyPqc,
+} from './post-quantum.js';
+import {
+  generateClassicalKeyPair,
+  importClassicalKeyPair,
+  isClassicalAlgorithm,
+  signClassical,
+  verifyClassical,
+} from './classical.js';
+import { signMessage, verifyMessageEnvelope, verifyDetachedMessage } from './message.js';
+import { signToken, verifyToken, VerifyTokenOptions } from './token.js';
+import { signArtifact, verifyArtifact } from './artifact.js';
+import { computeSha256Hex } from './utils.js';
+
+export class CryptoEngine {
+  /**
+   * Get all supported algorithms metadata
+   */
+  public static getSupportedAlgorithms(): AlgorithmMetadata[] {
+    return getAlgorithmList();
+  }
+
+  /**
+   * Get metadata for a specific algorithm
+   */
+  public static getAlgorithmMetadata(algorithm: AlgorithmId): AlgorithmMetadata {
+    const meta = ALGORITHMS[algorithm];
+    if (!meta) {
+      throw new Error(`Unknown algorithm: ${algorithm}`);
+    }
+    return meta;
+  }
+
+  /**
+   * Generate a fresh keypair for any supported algorithm (Classical or Post-Quantum)
+   */
+  public static async generateKeyPair(algorithm: AlgorithmId): Promise<SerializableKeyPair> {
+    if (isPostQuantumAlgorithm(algorithm)) {
+      return generatePqcKeyPair(algorithm);
+    }
+    if (isClassicalAlgorithm(algorithm)) {
+      return generateClassicalKeyPair(algorithm);
+    }
+    throw new Error(`Unsupported algorithm: ${algorithm}`);
+  }
+
+  /**
+   * Import keypair from public (and optional private) key string (base64 or hex)
+   */
+  public static async importKeyPair(
+    algorithm: AlgorithmId,
+    publicKeyStr: string,
+    privateKeyStr?: string
+  ): Promise<SerializableKeyPair> {
+    if (isPostQuantumAlgorithm(algorithm)) {
+      return importPqcKeyPair(algorithm, publicKeyStr, privateKeyStr);
+    }
+    if (isClassicalAlgorithm(algorithm)) {
+      return importClassicalKeyPair(algorithm, publicKeyStr, privateKeyStr);
+    }
+    throw new Error(`Unsupported algorithm: ${algorithm}`);
+  }
+
+  /**
+   * Sign arbitrary message
+   */
+  public static async signMessage(
+    algorithm: AlgorithmId,
+    message: string,
+    keyPair: SerializableKeyPair,
+    metadata?: Record<string, any>
+  ): Promise<SignedMessageEnvelope> {
+    return signMessage(algorithm, message, keyPair, metadata);
+  }
+
+  /**
+   * Verify signed message envelope
+   */
+  public static async verifyMessage(
+    envelope: SignedMessageEnvelope,
+    keyPairOrPubKey?: SerializableKeyPair | Uint8Array
+  ): Promise<VerificationResult> {
+    return verifyMessageEnvelope(envelope, keyPairOrPubKey);
+  }
+
+  /**
+   * Verify detached message
+   */
+  public static async verifyDetachedMessage(
+    algorithm: AlgorithmId,
+    message: string,
+    signatureBase64: string,
+    keyPairOrPubKey: SerializableKeyPair | Uint8Array
+  ): Promise<boolean> {
+    return verifyDetachedMessage(algorithm, message, signatureBase64, keyPairOrPubKey);
+  }
+
+  /**
+   * Sign structured token / JWT claims
+   */
+  public static async signToken(
+    algorithm: AlgorithmId,
+    claims: TokenClaims,
+    keyPair: SerializableKeyPair
+  ): Promise<SignedToken> {
+    return signToken(algorithm, claims, keyPair);
+  }
+
+  /**
+   * Verify structured token
+   */
+  public static async verifyToken(
+    tokenString: string,
+    keyPairOrPubKey: SerializableKeyPair | Uint8Array,
+    options?: VerifyTokenOptions
+  ): Promise<VerificationResult> {
+    return verifyToken(tokenString, keyPairOrPubKey, options);
+  }
+
+  /**
+   * Sign binary artifact / file
+   */
+  public static async signArtifact(
+    algorithm: AlgorithmId,
+    fileBytes: Uint8Array,
+    fileName: string,
+    mimeType: string,
+    keyPair: SerializableKeyPair,
+    metadata?: Record<string, any>
+  ): Promise<SignedArtifactEnvelope> {
+    return signArtifact(algorithm, fileBytes, fileName, mimeType, keyPair, metadata);
+  }
+
+  /**
+   * Verify binary artifact / file
+   */
+  public static async verifyArtifact(
+    fileBytes: Uint8Array,
+    envelope: SignedArtifactEnvelope,
+    keyPairOrPubKey?: SerializableKeyPair | Uint8Array
+  ): Promise<VerificationResult> {
+    return verifyArtifact(fileBytes, envelope, keyPairOrPubKey);
+  }
+
+  /**
+   * Compute SHA-256 hash
+   */
+  public static hash(data: Uint8Array | string): string {
+    return computeSha256Hex(data);
+  }
+}
