new file mode 100644
index 0000000..189343e
--- /dev/null
+++ b/src/crypto/token.ts
@@ -0,0 +1,281 @@
+import {
+  AlgorithmId,
+  SerializableKeyPair,
+  SignedToken,
+  TokenClaims,
+  TokenHeader,
+  VerificationResult,
+} from './types.js';
+import {
+  base64UrlToBytes,
+  bytesToBase64Url,
+  bytesToString,
+  stringToBytes,
+  canonicalJsonStringify,
+} from './utils.js';
+import { isPostQuantumAlgorithm, signPqc, verifyPqc } from './post-quantum.js';
+import { isClassicalAlgorithm, signClassical, verifyClassical } from './classical.js';
+
+export function createTokenHeader(
+  algorithm: AlgorithmId,
+  keyPair?: SerializableKeyPair
+): TokenHeader {
+  return {
+    alg: algorithm,
+    typ: isPostQuantumAlgorithm(algorithm) ? 'JWT+PQC' : 'JWT+CLASSICAL',
+    kid: keyPair?.fingerprint,
+  };
+}
+
+export function encodeJwtPart(obj: any): string {
+  const json = canonicalJsonStringify(obj);
+  return bytesToBase64Url(stringToBytes(json));
+}
+
+export function decodeJwtPart<T = any>(part: string): T {
+  const bytes = base64UrlToBytes(part);
+  const json = bytesToString(bytes);
+  return JSON.parse(json);
+}
+
+/**
+ * Sign a token (payload claims) using a classical or post-quantum key
+ */
+export async function signToken(
+  algorithm: AlgorithmId,
+  payload: TokenClaims,
+  keyPair: SerializableKeyPair,
+  customHeader?: Partial<TokenHeader>
+): Promise<SignedToken> {
+  const now = Math.floor(Date.now() / 1000);
+
+  const finalPayload: TokenClaims = {
+    iat: payload.iat ?? now,
+    exp: payload.exp ?? now + 3600, // default 1 hour
+    ...payload,
+  };
+
+  const header: TokenHeader = {
+    ...createTokenHeader(algorithm, keyPair),
+    ...customHeader,
+  };
+
+  const encodedHeader = encodeJwtPart(header);
+  const encodedPayload = encodeJwtPart(finalPayload);
+  const signingInput = `${encodedHeader}.${encodedPayload}`;
+  const signingInputBytes = stringToBytes(signingInput);
+
+  let signatureBytes: Uint8Array;
+  if (isPostQuantumAlgorithm(algorithm)) {
+    const privBytes =
+      keyPair.rawPrivateKey ||
+      (keyPair.privateKeyBase64 ? base64UrlToBytes(keyPair.privateKeyBase64) : undefined);
+    if (!privBytes) {
+      throw new Error(`Private key missing for post-quantum algorithm ${algorithm}`);
+    }
+    signatureBytes = await signPqc(algorithm, signingInputBytes, privBytes);
+  } else if (isClassicalAlgorithm(algorithm)) {
+    signatureBytes = await signClassical(algorithm, signingInputBytes, keyPair);
+  } else {
+    throw new Error(`Unsupported algorithm ${algorithm}`);
+  }
+
+  const encodedSignature = bytesToBase64Url(signatureBytes);
+  const compact = `${signingInput}.${encodedSignature}`;
+
+  return {
+    compact,
+    header,
+    payload: finalPayload,
+    signatureBase64: encodedSignature,
+  };
+}
+
+export interface VerifyTokenOptions {
+  expectedIssuer?: string;
+  expectedAudience?: string;
+  expectedSubject?: string;
+  clockToleranceSeconds?: number;
+  checkExpiration?: boolean;
+}
+
+/**
+ * Verify a compact token using a public key
+ */
+export async function verifyToken(
+  tokenString: string,
+  keyPairOrPubKey: SerializableKeyPair | Uint8Array,
+  options: VerifyTokenOptions = {}
+): Promise<VerificationResult> {
+  const verifiedAt = new Date().toISOString();
+  const parts = tokenString.trim().split('.');
+
+  if (parts.length !== 3) {
+    return {
+      valid: false,
+      algorithm: 'ML-DSA-44', // placeholder
+      category: 'post-quantum',
+      error: 'Invalid token format. Token must contain header.payload.signature parts.',
+      verifiedAt,
+    };
+  }
+
+  const [headerPart, payloadPart, signaturePart] = parts;
+
+  let header: TokenHeader;
+  let payload: TokenClaims;
+
+  try {
+    header = decodeJwtPart<TokenHeader>(headerPart);
+    payload = decodeJwtPart<TokenClaims>(payloadPart);
+  } catch (err: any) {
+    return {
+      valid: false,
+      algorithm: 'ML-DSA-44',
+      category: 'post-quantum',
+      error: `Failed to parse token JSON: ${err?.message || err}`,
+      verifiedAt,
+    };
+  }
+
+  const algorithm = header.alg;
+  const isPqc = isPostQuantumAlgorithm(algorithm);
+  const isClass = isClassicalAlgorithm(algorithm);
+
+  if (!isPqc && !isClass) {
+    return {
+      valid: false,
+      algorithm,
+      category: 'classical',
+      error: `Unsupported algorithm in token header: ${algorithm}`,
+      verifiedAt,
+    };
+  }
+
+  const signingInput = `${headerPart}.${payloadPart}`;
+  const signingInputBytes = stringToBytes(signingInput);
+
+  let signatureBytes: Uint8Array;
+  try {
+    signatureBytes = base64UrlToBytes(signaturePart);
+  } catch (err) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      error: 'Invalid base64 signature encoding',
+      verifiedAt,
+    };
+  }
+
+  // Cryptographic signature check
+  let sigValid = false;
+  try {
+    if (isPqc) {
+      const pubBytes =
+        keyPairOrPubKey instanceof Uint8Array
+          ? keyPairOrPubKey
+          : keyPairOrPubKey.rawPublicKey || base64UrlToBytes(keyPairOrPubKey.publicKeyBase64);
+      sigValid = await verifyPqc(algorithm, signatureBytes, signingInputBytes, pubBytes);
+    } else {
+      sigValid = await verifyClassical(algorithm, signatureBytes, signingInputBytes, keyPairOrPubKey);
+    }
+  } catch (err: any) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      error: `Verification error: ${err?.message || err}`,
+      verifiedAt,
+    };
+  }
+
+  if (!sigValid) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      signerFingerprint: header.kid,
+      error: 'Cryptographic signature mismatch! The token was tampered with, altered, or signed by a different key.',
+      verifiedAt,
+      details: { header, payload },
+    };
+  }
+
+  // Signature is valid! Now validate token claims (exp, nbf, iss, aud)
+  const now = Math.floor(Date.now() / 1000);
+  const tolerance = options.clockToleranceSeconds ?? 0;
+  const warnings: string[] = [];
+
+  if (options.checkExpiration !== false && typeof payload.exp === 'number') {
+    if (now > payload.exp + tolerance) {
+      return {
+        valid: false,
+        algorithm,
+        category: isPqc ? 'post-quantum' : 'classical',
+        signerFingerprint: header.kid,
+        error: `Token expired at ${new Date(payload.exp * 1000).toISOString()} (current time: ${new Date(now * 1000).toISOString()})`,
+        verifiedAt,
+        details: { header, payload },
+      };
+    }
+  }
+
+  if (typeof payload.nbf === 'number' && now < payload.nbf - tolerance) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      signerFingerprint: header.kid,
+      error: `Token not valid before ${new Date(payload.nbf * 1000).toISOString()}`,
+      verifiedAt,
+      details: { header, payload },
+    };
+  }
+
+  if (options.expectedIssuer && payload.iss !== options.expectedIssuer) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      signerFingerprint: header.kid,
+      error: `Issuer mismatch: expected "${options.expectedIssuer}", got "${payload.iss}"`,
+      verifiedAt,
+      details: { header, payload },
+    };
+  }
+
+  if (options.expectedAudience && payload.aud !== options.expectedAudience) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      signerFingerprint: header.kid,
+      error: `Audience mismatch: expected "${options.expectedAudience}", got "${payload.aud}"`,
+      verifiedAt,
+      details: { header, payload },
+    };
+  }
+
+  if (options.expectedSubject && payload.sub !== options.expectedSubject) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      signerFingerprint: header.kid,
+      error: `Subject mismatch: expected "${options.expectedSubject}", got "${payload.sub}"`,
+      verifiedAt,
+      details: { header, payload },
+    };
+  }
+
+  return {
+    valid: true,
+    algorithm,
+    category: isPqc ? 'post-quantum' : 'classical',
+    signerFingerprint: header.kid,
+    warnings: warnings.length > 0 ? warnings : undefined,
+    details: { header, payload },
+    verifiedAt,
+  };
+}
diff --git a/src/crypto/types.ts b/src/crypto/types.ts
new file mode 100644
index 0000000..2b12318
--- /dev/null
+++ b/src/crypto/types.ts
@@ -0,0 +1,110 @@
+/**
+ * Core cryptographic types for Classical and Post-Quantum Signing and Verification.
+ */
+
+export type AlgorithmCategory = 'classical' | 'post-quantum';
+
+export type AlgorithmId =
+  // Post-Quantum (Quantum-Resistant)
+  | 'ML-DSA-44'
+  | 'ML-DSA-65'
+  | 'ML-DSA-87'
+  | 'SLH-DSA-SHA2-128s'
+  // Classical
+  | 'Ed25519'
+  | 'ECDSA-P256'
+  | 'RSA-PSS-2048';
+
+export interface AlgorithmMetadata {
+  id: AlgorithmId;
+  name: string;
+  category: AlgorithmCategory;
+  standard: string; // e.g., "NIST FIPS 204", "RFC 8032", "NIST FIPS 186-5"
+  securityLevel: string; // e.g., "NIST Category 2 (128-bit quantum)", "128-bit classical"
+  quantumResistant: boolean;
+  publicKeySize: number; // approximate or exact bytes
+  signatureSize: number; // approximate or exact bytes
+  description: string;
+}
+
+export interface SerializableKeyPair {
+  algorithm: AlgorithmId;
+  category: AlgorithmCategory;
+  createdAt: string;
+  fingerprint: string;
+  publicKeyBase64: string;
+  publicKeyHex: string;
+  privateKeyBase64?: string;
+  privateKeyHex?: string;
+  jwk?: JsonWebKey;
+  nativePrivateKey?: any; // internal handle if WebCrypto
+  nativePublicKey?: any;
+  rawPublicKey?: Uint8Array;
+  rawPrivateKey?: Uint8Array;
+}
+
+export interface SignedMessageEnvelope {
+  version: '1.0';
+  algorithm: AlgorithmId;
+  category: AlgorithmCategory;
+  timestamp: string;
+  signerFingerprint: string;
+  message: string;
+  signatureBase64: string;
+  publicKeyBase64: string;
+  metadata?: Record<string, any>;
+}
+
+export interface TokenClaims {
+  iss?: string; // Issuer
+  sub?: string; // Subject
+  aud?: string; // Audience
+  exp?: number; // Expiration (unix epoch seconds)
+  nbf?: number; // Not before (unix epoch seconds)
+  iat?: number; // Issued at (unix epoch seconds)
+  jti?: string; // JWT ID
+  [key: string]: any;
+}
+
+export interface TokenHeader {
+  alg: AlgorithmId;
+  typ: 'JWT+PQC' | 'JWT+CLASSICAL';
+  kid?: string;
+}
+
+export interface SignedToken {
+  compact: string; // header_b64.payload_b64.sig_b64
+  header: TokenHeader;
+  payload: TokenClaims;
+  signatureBase64: string;
+}
+
+export interface ArtifactManifest {
+  fileName: string;
+  fileSize: number;
+  mimeType: string;
+  sha256DigestHex: string;
+  timestamp: string;
+  metadata?: Record<string, any>;
+}
+
+export interface SignedArtifactEnvelope {
+  version: '1.0';
+  algorithm: AlgorithmId;
+  category: AlgorithmCategory;
+  manifest: ArtifactManifest;
+  signatureBase64: string;
+  publicKeyBase64: string;
+  signerFingerprint: string;
+}
+
+export interface VerificationResult {
+  valid: boolean;
+  algorithm: AlgorithmId;
+  category: AlgorithmCategory;
+  signerFingerprint?: string;
+  error?: string;
+  warnings?: string[];
+  details?: Record<string, any>;
+  verifiedAt: string;
+}
