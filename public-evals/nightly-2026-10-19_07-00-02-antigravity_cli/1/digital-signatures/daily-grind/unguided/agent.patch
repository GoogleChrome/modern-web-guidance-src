new file mode 100644
index 0000000..eb48e31
--- /dev/null
+++ b/src/crypto/message.ts
@@ -0,0 +1,194 @@
+import {
+  AlgorithmId,
+  SerializableKeyPair,
+  SignedMessageEnvelope,
+  VerificationResult,
+} from './types.js';
+import {
+  base64ToBytes,
+  bytesToBase64,
+  canonicalJsonStringify,
+  stringToBytes,
+} from './utils.js';
+import { isPostQuantumAlgorithm, signPqc, verifyPqc } from './post-quantum.js';
+import { isClassicalAlgorithm, signClassical, verifyClassical } from './classical.js';
+
+export function constructMessageSigningPayload(
+  algorithm: AlgorithmId,
+  message: string,
+  timestamp: string
+): Uint8Array {
+  const normalized = canonicalJsonStringify({
+    alg: algorithm,
+    msg: message,
+    ts: timestamp,
+  });
+  return stringToBytes(normalized);
+}
+
+/**
+ * Sign an arbitrary text or JSON message
+ */
+export async function signMessage(
+  algorithm: AlgorithmId,
+  message: string,
+  keyPair: SerializableKeyPair,
+  metadata?: Record<string, any>
+): Promise<SignedMessageEnvelope> {
+  const timestamp = new Date().toISOString();
+  const signingBytes = constructMessageSigningPayload(algorithm, message, timestamp);
+
+  let signatureBytes: Uint8Array;
+  if (isPostQuantumAlgorithm(algorithm)) {
+    const privBytes =
+      keyPair.rawPrivateKey ||
+      (keyPair.privateKeyBase64 ? base64ToBytes(keyPair.privateKeyBase64) : undefined);
+    if (!privBytes) {
+      throw new Error(`Private key missing for post-quantum algorithm ${algorithm}`);
+    }
+    signatureBytes = await signPqc(algorithm, signingBytes, privBytes);
+  } else if (isClassicalAlgorithm(algorithm)) {
+    signatureBytes = await signClassical(algorithm, signingBytes, keyPair);
+  } else {
+    throw new Error(`Unsupported algorithm ${algorithm}`);
+  }
+
+  const category = isPostQuantumAlgorithm(algorithm) ? 'post-quantum' : 'classical';
+
+  return {
+    version: '1.0',
+    algorithm,
+    category,
+    timestamp,
+    signerFingerprint: keyPair.fingerprint,
+    message,
+    signatureBase64: bytesToBase64(signatureBytes),
+    publicKeyBase64: keyPair.publicKeyBase64,
+    metadata,
+  };
+}
+
+/**
+ * Verify a signed message envelope
+ */
+export async function verifyMessageEnvelope(
+  envelope: SignedMessageEnvelope,
+  keyPairOrPubKey?: SerializableKeyPair | Uint8Array
+): Promise<VerificationResult> {
+  const verifiedAt = new Date().toISOString();
+  const { algorithm, message, timestamp, signatureBase64 } = envelope;
+
+  const isPqc = isPostQuantumAlgorithm(algorithm);
+  const isClass = isClassicalAlgorithm(algorithm);
+
+  if (!isPqc && !isClass) {
+    return {
+      valid: false,
+      algorithm,
+      category: 'classical',
+      error: `Unsupported algorithm: ${algorithm}`,
+      verifiedAt,
+    };
+  }
+
+  let signatureBytes: Uint8Array;
+  try {
+    signatureBytes = base64ToBytes(signatureBase64);
+  } catch (err) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      error: 'Invalid base64 signature encoding in envelope',
+      verifiedAt,
+    };
+  }
+
+  let pubKey: SerializableKeyPair | Uint8Array;
+  if (keyPairOrPubKey) {
+    pubKey = keyPairOrPubKey;
+  } else if (envelope.publicKeyBase64) {
+    pubKey = base64ToBytes(envelope.publicKeyBase64);
+  } else {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      error: 'No public key provided for verification',
+      verifiedAt,
+    };
+  }
+
+  const signingBytes = constructMessageSigningPayload(algorithm, message, timestamp);
+
+  let sigValid = false;
+  try {
+    if (isPqc) {
+      const pubBytes =
+        pubKey instanceof Uint8Array
+          ? pubKey
+          : pubKey.rawPublicKey || base64ToBytes(pubKey.publicKeyBase64);
+      sigValid = await verifyPqc(algorithm, signatureBytes, signingBytes, pubBytes);
+    } else {
+      sigValid = await verifyClassical(algorithm, signatureBytes, signingBytes, pubKey);
+    }
+  } catch (err: any) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      error: `Cryptographic verification error: ${err?.message || err}`,
+      verifiedAt,
+    };
+  }
+
+  if (!sigValid) {
+    return {
+      valid: false,
+      algorithm,
+      category: isPqc ? 'post-quantum' : 'classical',
+      signerFingerprint: envelope.signerFingerprint,
+      error: 'Cryptographic signature mismatch! The message was tampered with, altered, or signed by a different key.',
+      verifiedAt,
+      details: { timestamp, messageSnippet: message.substring(0, 100) },
+    };
+  }
+
+  return {
+    valid: true,
+    algorithm,
+    category: isPqc ? 'post-quantum' : 'classical',
+    signerFingerprint: envelope.signerFingerprint,
+    details: { timestamp, messageLength: message.length },
+    verifiedAt,
+  };
+}
+
+/**
+ * Verify detached raw message and signature
+ */
+export async function verifyDetachedMessage(
+  algorithm: AlgorithmId,
+  message: string,
+  signatureBase64: string,
+  keyPairOrPubKey: SerializableKeyPair | Uint8Array
+): Promise<boolean> {
+  const messageBytes = stringToBytes(message);
+  let signatureBytes: Uint8Array;
+  try {
+    signatureBytes = base64ToBytes(signatureBase64);
+  } catch (err) {
+    return false;
+  }
+
+  if (isPostQuantumAlgorithm(algorithm)) {
+    const pubBytes =
+      keyPairOrPubKey instanceof Uint8Array
+        ? keyPairOrPubKey
+        : keyPairOrPubKey.rawPublicKey || base64ToBytes(keyPairOrPubKey.publicKeyBase64);
+    return verifyPqc(algorithm, signatureBytes, messageBytes, pubBytes);
+  } else if (isClassicalAlgorithm(algorithm)) {
+    return verifyClassical(algorithm, signatureBytes, messageBytes, keyPairOrPubKey);
+  }
+  return false;
+}
diff --git a/src/crypto/post-quantum.ts b/src/crypto/post-quantum.ts
new file mode 100644
index 0000000..5869524
--- /dev/null
+++ b/src/crypto/post-quantum.ts
@@ -0,0 +1,130 @@
+import { ml_dsa44, ml_dsa65, ml_dsa87 } from '@noble/post-quantum/ml-dsa.js';
+import { slh_dsa_sha2_128s } from '@noble/post-quantum/slh-dsa.js';
+import { AlgorithmId, SerializableKeyPair } from './types.js';
+import {
+  bytesToBase64,
+  base64ToBytes,
+  bytesToHex,
+  hexToBytes,
+  computeFingerprint,
+} from './utils.js';
+
+export function isPostQuantumAlgorithm(algorithm: AlgorithmId): boolean {
+  return (
+    algorithm === 'ML-DSA-44' ||
+    algorithm === 'ML-DSA-65' ||
+    algorithm === 'ML-DSA-87' ||
+    algorithm === 'SLH-DSA-SHA2-128s'
+  );
+}
+
+function getPqcEngine(algorithm: AlgorithmId) {
+  switch (algorithm) {
+    case 'ML-DSA-44':
+      return ml_dsa44;
+    case 'ML-DSA-65':
+      return ml_dsa65;
+    case 'ML-DSA-87':
+      return ml_dsa87;
+    case 'SLH-DSA-SHA2-128s':
+      return slh_dsa_sha2_128s;
+    default:
+      throw new Error(`Unsupported Post-Quantum algorithm: ${algorithm}`);
+  }
+}
+
+/**
+ * Generate a new Post-Quantum keypair (FIPS 204 ML-DSA or FIPS 205 SLH-DSA)
+ */
+export async function generatePqcKeyPair(
+  algorithm: AlgorithmId
+): Promise<SerializableKeyPair> {
+  const engine = getPqcEngine(algorithm);
+  const keys = engine.keygen();
+
+  const pubBytes = keys.publicKey;
+  const privBytes = keys.secretKey;
+
+  const fingerprint = computeFingerprint(pubBytes);
+
+  return {
+    algorithm,
+    category: 'post-quantum',
+    createdAt: new Date().toISOString(),
+    fingerprint,
+    publicKeyBase64: bytesToBase64(pubBytes),
+    publicKeyHex: bytesToHex(pubBytes),
+    privateKeyBase64: bytesToBase64(privBytes),
+    privateKeyHex: bytesToHex(privBytes),
+    rawPublicKey: pubBytes,
+    rawPrivateKey: privBytes,
+  };
+}
+
+/**
+ * Sign data using Post-Quantum private key
+ */
+export async function signPqc(
+  algorithm: AlgorithmId,
+  messageBytes: Uint8Array,
+  secretKeyBytes: Uint8Array
+): Promise<Uint8Array> {
+  const engine = getPqcEngine(algorithm);
+  return engine.sign(messageBytes, secretKeyBytes);
+}
+
+/**
+ * Verify signature using Post-Quantum public key
+ */
+export async function verifyPqc(
+  algorithm: AlgorithmId,
+  signatureBytes: Uint8Array,
+  messageBytes: Uint8Array,
+  publicKeyBytes: Uint8Array
+): Promise<boolean> {
+  try {
+    const engine = getPqcEngine(algorithm);
+    return engine.verify(signatureBytes, messageBytes, publicKeyBytes);
+  } catch (err) {
+    // If invalid key length or format, verify returns false instead of throwing
+    return false;
+  }
+}
+
+/**
+ * Import PQC keypair from base64 or hex
+ */
+export function importPqcKeyPair(
+  algorithm: AlgorithmId,
+  publicKeyStr: string,
+  privateKeyStr?: string
+): SerializableKeyPair {
+  if (!isPostQuantumAlgorithm(algorithm)) {
+    throw new Error(`Algorithm ${algorithm} is not a post-quantum algorithm`);
+  }
+
+  // Detect hex or base64
+  const isHex = /^[0-9a-fA-F]+$/.test(publicKeyStr.trim()) && publicKeyStr.trim().length % 2 === 0;
+  const pubBytes = isHex ? hexToBytes(publicKeyStr.trim()) : base64ToBytes(publicKeyStr.trim());
+
+  let privBytes: Uint8Array | undefined;
+  if (privateKeyStr && privateKeyStr.trim()) {
+    const privHex = /^[0-9a-fA-F]+$/.test(privateKeyStr.trim()) && privateKeyStr.trim().length % 2 === 0;
+    privBytes = privHex ? hexToBytes(privateKeyStr.trim()) : base64ToBytes(privateKeyStr.trim());
+  }
+
+  const fingerprint = computeFingerprint(pubBytes);
+
+  return {
+    algorithm,
+    category: 'post-quantum',
+    createdAt: new Date().toISOString(),
+    fingerprint,
+    publicKeyBase64: bytesToBase64(pubBytes),
+    publicKeyHex: bytesToHex(pubBytes),
+    privateKeyBase64: privBytes ? bytesToBase64(privBytes) : undefined,
+    privateKeyHex: privBytes ? bytesToHex(privBytes) : undefined,
+    rawPublicKey: pubBytes,
+    rawPrivateKey: privBytes,
+  };
+}
