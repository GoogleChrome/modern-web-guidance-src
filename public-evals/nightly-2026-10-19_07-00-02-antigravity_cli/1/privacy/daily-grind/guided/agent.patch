+  <!-- Privacy-Preserving Client Script: Façade Pattern & Feature Detection -->
+  <script>
+    // 1. Façade Pattern Implementation for Third-Party Media
+    const videoContainer = document.getElementById('video-container');
+    if (videoContainer) {
+      function loadVideo() {
+        const videoId = videoContainer.dataset.videoId;
+        videoContainer.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/' + 
+          encodeURIComponent(videoId) + '?autoplay=1" title="Coffee Roasting Tour" ' +
+          'style="width:100%; height:100%; border:0;" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
+      }
+      videoContainer.addEventListener('click', loadVideo);
+      videoContainer.addEventListener('keydown', function(e) {
+        if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          loadVideo();
+        }
+      });
+    }
+
+    // 2. Anti-Fingerprinting Principle: Use Feature Detection rather than User-Agent Sniffing
+    if ('IntersectionObserver' in window) {
+      // Good: Standard feature detection without fingerprinting device configuration
+      const observer = new IntersectionObserver(function(entries) {
+        entries.forEach(function(entry) {
+          if (entry.isIntersecting) {
+            entry.target.classList.add('visible');
+          }
+        });
+      }, { threshold: 0.1 });
+      document.querySelectorAll('.card').forEach(function(el) { observer.observe(el); });
+    }
+
+    // 3. User-Agent Client Hints (UA-CH) if available, avoiding high-entropy fingerprinting
+    if (navigator.userAgentData) {
+      navigator.userAgentData.getHighEntropyValues(['platform', 'mobile'])
+        .then(function(hints) {
+          // Process privacy-preserving client hints cleanly
+        })
+        .catch(function() {});
+    }
+
+    // 4. Secure Data Handling: Ensure no PII or sensitive tokens are stored in localStorage
+    try {
+      const keys = Object.keys(localStorage);
+      for (const key of keys) {
+        if (/token|password|email|phone|card/i.test(key)) {
+          localStorage.removeItem(key);
+        }
+      }
+    } catch(e) {}
+  </script>
