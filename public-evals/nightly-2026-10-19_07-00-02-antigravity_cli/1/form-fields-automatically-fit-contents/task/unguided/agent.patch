+  <script>
+    // Progressive enhancement fallback for browsers without native field-sizing support
+    (function () {
+      const supportsFieldSizing = window.CSS && CSS.supports && CSS.supports('field-sizing', 'content');
+      if (supportsFieldSizing) return;
+
+      const canvas = document.createElement('canvas');
+      const ctx = canvas.getContext('2d');
+
+      function getTextWidth(text, font) {
+        ctx.font = font;
+        return ctx.measureText(text).width;
+      }
+
+      const textInput = document.getElementById('customer-name');
+      const select = document.getElementById('coffee-choice');
+      const textarea = document.getElementById('special-instructions');
+
+      if (textInput) {
+        const resizeInput = () => {
+          const style = window.getComputedStyle(textInput);
+          const font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
+          const text = textInput.value || textInput.placeholder || '';
+          const textWidth = getTextWidth(text, font);
+          textInput.style.width = Math.max(180, Math.ceil(textWidth + 32)) + 'px';
+        };
+        textInput.addEventListener('input', resizeInput);
+        resizeInput();
+      }
+
+      if (select) {
+        const resizeSelect = () => {
+          const selectedOption = select.options[select.selectedIndex];
+          const style = window.getComputedStyle(select);
+          const font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
+          const text = selectedOption ? selectedOption.text : '';
+          const textWidth = getTextWidth(text, font);
+          select.style.width = Math.ceil(textWidth + 45) + 'px';
+        };
+        select.addEventListener('change', resizeSelect);
+        resizeSelect();
+      }
+
+      if (textarea) {
+        const resizeTextarea = () => {
+          textarea.style.height = 'auto';
+          textarea.style.height = (textarea.scrollHeight + 4) + 'px';
+        };
+        textarea.addEventListener('input', resizeTextarea);
+        resizeTextarea();
+      }
+    })();
+  </script>
