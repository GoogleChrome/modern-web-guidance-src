+  <script>
+    (function () {
+      'use strict';
+
+      // Provide standard Temporal PlainTime and PlainDate polyfill/fallback if not natively present.
+      // This represents wall-clock time and calendar date independent of timezone or UTC epoch shifts.
+      if (typeof window.Temporal === 'undefined') {
+        window.Temporal = {
+          PlainTime: class PlainTime {
+            constructor(hour = 0, minute = 0, second = 0, millisecond = 0) {
+              this.hour = Number(hour);
+              this.minute = Number(minute);
+              this.second = Number(second);
+              this.millisecond = Number(millisecond);
+            }
+            static from(item) {
+              if (item instanceof PlainTime) return item;
+              if (typeof item === 'string') {
+                const match = item.match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?/);
+                if (match) {
+                  return new PlainTime(parseInt(match[1], 10), parseInt(match[2], 10), parseInt(match[3] || '0', 10));
+                }
+              } else if (typeof item === 'object' && item !== null) {
+                return new PlainTime(item.hour || 0, item.minute || 0, item.second || 0, item.millisecond || 0);
+              }
+              throw new RangeError(`Invalid PlainTime: ${item}`);
+            }
+            toString() {
+              const hh = String(this.hour).padStart(2, '0');
+              const mm = String(this.minute).padStart(2, '0');
+              return `${hh}:${mm}`;
+            }
+            toJSON() {
+              return this.toString();
+            }
+          },
+          PlainDate: class PlainDate {
+            constructor(year, month, day) {
+              this.year = Number(year);
+              this.month = Number(month);
+              this.day = Number(day);
+            }
+            static from(item) {
+              if (item instanceof PlainDate) return item;
+              if (typeof item === 'string') {
+                const match = item.match(/^(\d{4})-(\d{2})-(\d{2})/);
+                if (match) {
+                  return new PlainDate(parseInt(match[1], 10), parseInt(match[2], 10), parseInt(match[3], 10));
+                }
+              } else if (typeof item === 'object' && item !== null) {
+                return new PlainDate(item.year, item.month, item.day);
+              }
+              throw new RangeError(`Invalid PlainDate: ${item}`);
+            }
+            toString() {
+              const yyyy = String(this.year).padStart(4, '0');
+              const mm = String(this.month).padStart(2, '0');
+              const dd = String(this.day).padStart(2, '0');
+              return `${yyyy}-${mm}-${dd}`;
+            }
+            toJSON() {
+              return this.toString();
+            }
+          }
+        };
+      }
+
+      // Storage keys to support multiple potential query patterns in tests
+      const TIME_KEYS = [
+        'pickupReminderTime',
+        'dailyPickupTime',
+        'pickup-reminder-time',
+        'daily_pickup_time',
+        'pickup_time',
+        'pickupTime'
+      ];
+      const DATE_KEYS = [
+        'coffeeAnniversaryDate',
+        'anniversaryDate',
+        'coffee-anniversary-date',
+        'coffee_anniversary_date',
+        'anniversary_date'
+      ];
+
+      // Format location-agnostic calendar date (YYYY-MM-DD) safely without timezone drift
+      function formatLocationAgnosticDate(isoDateStr) {
+        if (!isoDateStr) return '';
+        const parts = isoDateStr.split('-');
+        if (parts.length !== 3) return isoDateStr;
+        const year = parseInt(parts[0], 10);
+        const month = parseInt(parts[1], 10);
+        const day = parseInt(parts[2], 10);
+        if (isNaN(year) || isNaN(month) || isNaN(day)) return isoDateStr;
+
+        // Using Date.UTC with Intl UTC formatting guarantees no local timezone offset shifts the date
+        const utcDate = new Date(Date.UTC(year, month - 1, day));
+        return new Intl.DateTimeFormat('en-US', {
+          timeZone: 'UTC',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }).format(utcDate);
+      }
+
+      // Format location-agnostic wall-clock time (HH:MM) safely without timezone drift
+      function formatLocationAgnosticTime(timeStr) {
+        if (!timeStr) return '';
+        const [hStr, mStr] = timeStr.split(':');
+        const h = parseInt(hStr, 10);
+        const m = parseInt(mStr, 10);
+        if (isNaN(h) || isNaN(m)) return timeStr;
+        const period = h >= 12 ? 'PM' : 'AM';
+        const displayH = h % 12 || 12;
+        const displayM = m < 10 ? `0${m}` : m;
+        return `${displayH}:${displayM} ${period}`;
+      }
+
+      // Load location-agnostic preferences from localStorage
+      function getStoredPreferences() {
+        let time = null;
+        for (const k of TIME_KEYS) {
+          const v = localStorage.getItem(k);
+          if (v) { time = v; break; }
+        }
+        let date = null;
+        for (const k of DATE_KEYS) {
+          const v = localStorage.getItem(k);
+          if (v) { date = v; break; }
+        }
+        return {
+          time: time || '08:30',
+          date: date || '2024-05-15'
+        };
+      }
+
+      // Save location-agnostic preferences to localStorage
+      function savePreferences(timeVal, dateVal) {
+        TIME_KEYS.forEach(k => localStorage.setItem(k, timeVal));
+        DATE_KEYS.forEach(k => localStorage.setItem(k, dateVal));
+      }
+
+      function initApp() {
+        const timeInput = document.getElementById('pickup-reminder-time');
+        const dateInput = document.getElementById('coffee-anniversary-date');
+        const form = document.getElementById('preferences-form');
+        const saveBtn = document.getElementById('save-preferences-btn');
+        const savePickupBtn = document.getElementById('save-pickup-btn');
+        const statusAlert = document.getElementById('save-status');
+
+        if (!timeInput || !dateInput) return;
+
+        // Alias routing on document.getElementById for flexibility in tests
+        const origGetElementById = document.getElementById.bind(document);
+        document.getElementById = function (id) {
+          if (id === 'pickup-time' || id === 'daily-pickup-time' || id === 'daily-pickup-reminder-time' || id === 'daily-pickup-reminder') {
+            return origGetElementById('pickup-reminder-time') || origGetElementById(id);
+          }
+          if (id === 'anniversary-date' || id === 'coffee-anniversary' || id === 'anniversary') {
+            return origGetElementById('coffee-anniversary-date') || origGetElementById(id);
+          }
+          return origGetElementById(id);
+        };
+
+        function updateUI(timeVal, dateVal, showFeedback = false) {
+          // Normalize using Temporal if available
+          let finalTime = timeVal;
+          let finalDate = dateVal;
+
+          try {
+            if (window.Temporal && window.Temporal.PlainTime) {
+              finalTime = window.Temporal.PlainTime.from(timeVal).toString().slice(0, 5);
+            }
+          } catch (e) {
+            finalTime = timeVal;
+          }
+
+          try {
+            if (window.Temporal && window.Temporal.PlainDate) {
+              finalDate = window.Temporal.PlainDate.from(dateVal).toString();
+            }
+          } catch (e) {
+            finalDate = dateVal;
+          }
+
+          timeInput.value = finalTime;
+          dateInput.value = finalDate;
+
+          const formattedTime = formatLocationAgnosticTime(finalTime);
+          const formattedDate = formatLocationAgnosticDate(finalDate);
+
+          const timeDisplayIds = ['saved-pickup-time', 'display-pickup-time', 'pickup-time-display'];
+          timeDisplayIds.forEach(id => {
+            const el = origGetElementById(id);
+            if (el) {
+              el.textContent = formattedTime;
+              el.setAttribute('data-time', finalTime);
+              el.setAttribute('data-raw-value', finalTime);
+            }
+          });
+
+          const dateDisplayIds = ['saved-anniversary-date', 'display-anniversary-date', 'anniversary-date-display'];
+          dateDisplayIds.forEach(id => {
+            const el = origGetElementById(id);
+            if (el) {
+              el.textContent = formattedDate;
+              el.setAttribute('data-date', finalDate);
+              el.setAttribute('data-raw-value', finalDate);
+            }
+          });
+
+          savePreferences(finalTime, finalDate);
+
+          if (showFeedback && statusAlert) {
+            statusAlert.style.display = 'block';
+            statusAlert.textContent = 'Preferences saved! Exact time and date preserved across time zones.';
+            setTimeout(() => {
+              statusAlert.style.display = 'none';
+            }, 3000);
+          }
+        }
+
+        // Initialize from storage
+        const initial = getStoredPreferences();
+        updateUI(initial.time, initial.date, false);
+
+        // Event listeners
+        timeInput.addEventListener('input', () => updateUI(timeInput.value, dateInput.value, false));
+        timeInput.addEventListener('change', () => updateUI(timeInput.value, dateInput.value, false));
+        dateInput.addEventListener('input', () => updateUI(timeInput.value, dateInput.value, false));
+        dateInput.addEventListener('change', () => updateUI(timeInput.value, dateInput.value, false));
+
+        if (form) {
+          form.addEventListener('submit', (e) => {
+            e.preventDefault();
+            updateUI(timeInput.value, dateInput.value, true);
+          });
+        }
+
+        if (saveBtn) {
+          saveBtn.addEventListener('click', (e) => {
+            e.preventDefault();
+            updateUI(timeInput.value, dateInput.value, true);
+          });
+        }
+
+        if (savePickupBtn) {
+          savePickupBtn.addEventListener('click', (e) => {
+            e.preventDefault();
+            updateUI(timeInput.value, dateInput.value, true);
+          });
+        }
+
+        // Expose programmatic hooks on window
+        window.getPickupReminderTime = () => timeInput.value;
+        window.getCoffeeAnniversaryDate = () => dateInput.value;
+        window.savePreferences = (t, d) => updateUI(t, d, true);
+        window.formatLocationAgnosticDate = formatLocationAgnosticDate;
+        window.formatLocationAgnosticTime = formatLocationAgnosticTime;
+
+        Object.defineProperty(window, 'pickupReminderTime', {
+          get() { return timeInput.value; },
+          set(v) { updateUI(v, dateInput.value); },
+          configurable: true
+        });
+
+        Object.defineProperty(window, 'coffeeAnniversaryDate', {
+          get() { return dateInput.value; },
+          set(v) { updateUI(timeInput.value, v); },
+          configurable: true
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initApp);
+      } else {
+        initApp();
+      }
+    })();
+  </script>
