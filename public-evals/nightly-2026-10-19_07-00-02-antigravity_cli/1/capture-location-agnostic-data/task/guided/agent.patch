+  <script type="module">
+    // Ensure Temporal API is available (natively or via standard polyfill / fallback)
+    async function initTemporal() {
+      if (typeof Temporal === 'undefined') {
+        try {
+          const module = await import('https://esm.sh/@js-temporal/polyfill');
+          globalThis.Temporal = module.Temporal;
+          if (module.toTemporalInstant) {
+            Date.prototype.toTemporalInstant = module.toTemporalInstant;
+          }
+        } catch (e) {
+          console.warn('Could not load Temporal polyfill from CDN, initializing fallback.', e);
+          initFallbackTemporal();
+        }
+      }
+    }
+
+    function initFallbackTemporal() {
+      if (typeof Temporal !== 'undefined') return;
+
+      class PlainDate {
+        constructor(year, month, day) {
+          this.year = Number(year);
+          this.month = Number(month);
+          this.day = Number(day);
+        }
+        static from(item) {
+          if (item instanceof PlainDate) return item;
+          if (typeof item === 'string') {
+            const datePart = item.split('T')[0];
+            const [y, m, d] = datePart.split('-').map(Number);
+            return new PlainDate(y, m, d);
+          }
+          if (typeof item === 'object' && item !== null) {
+            return new PlainDate(item.year, item.month, item.day);
+          }
+          throw new TypeError('Invalid PlainDate input');
+        }
+        toString() {
+          const y = String(this.year).padStart(4, '0');
+          const m = String(this.month).padStart(2, '0');
+          const d = String(this.day).padStart(2, '0');
+          return `${y}-${m}-${d}`;
+        }
+        toLocaleString(locales, options) {
+          const d = new Date(this.year, this.month - 1, this.day);
+          return d.toLocaleDateString(locales, options);
+        }
+        equals(other) {
+          const o = PlainDate.from(other);
+          return this.year === o.year && this.month === o.month && this.day === o.day;
+        }
+      }
+
+      class PlainTime {
+        constructor(hour = 0, minute = 0, second = 0, millisecond = 0) {
+          this.hour = Number(hour);
+          this.minute = Number(minute);
+          this.second = Number(second);
+          this.millisecond = Number(millisecond);
+        }
+        static from(item) {
+          if (item instanceof PlainTime) return item;
+          if (typeof item === 'string') {
+            const match = item.match(/(\d{1,2}):(\d{2})(?::(\d{2}))?/);
+            if (match) {
+              return new PlainTime(Number(match[1]), Number(match[2]), match[3] ? Number(match[3]) : 0);
+            }
+          }
+          if (typeof item === 'object' && item !== null) {
+            return new PlainTime(item.hour || 0, item.minute || 0, item.second || 0, item.millisecond || 0);
+          }
+          throw new TypeError('Invalid PlainTime input');
+        }
+        toString() {
+          const h = String(this.hour).padStart(2, '0');
+          const m = String(this.minute).padStart(2, '0');
+          return `${h}:${m}`;
+        }
+        toLocaleString(locales, options) {
+          const d = new Date(2000, 0, 1, this.hour, this.minute, this.second);
+          return d.toLocaleTimeString(locales, options || { hour: 'numeric', minute: '2-digit' });
+        }
+        equals(other) {
+          const o = PlainTime.from(other);
+          return this.hour === o.hour && this.minute === o.minute && this.second === o.second;
+        }
+      }
+
+      globalThis.Temporal = {
+        PlainDate,
+        PlainTime
+      };
+    }
+
+    const STORAGE_KEY_TIME = 'dailyPickupReminderTime';
+    const STORAGE_KEY_DATE = 'coffeeAnniversaryDate';
+
+    const form = document.getElementById('preferences-form');
+    const pickupTimeInput = document.getElementById('pickup-time');
+    const anniversaryDateInput = document.getElementById('anniversary-date');
+    const pickupTimeDisplay = document.getElementById('pickup-time-display');
+    const anniversaryDateDisplay = document.getElementById('anniversary-date-display');
+    const saveStatus = document.getElementById('save-status');
+
+    function updateDisplay(plainTime, plainDate) {
+      const timeIso = `${String(plainTime.hour).padStart(2, '0')}:${String(plainTime.minute).padStart(2, '0')}`;
+      const timeFormatted = plainTime.toLocaleString(undefined, { hour: 'numeric', minute: '2-digit' });
+      pickupTimeDisplay.textContent = `${timeIso} (${timeFormatted})`;
+      pickupTimeDisplay.dataset.time = timeIso;
+
+      const dateIso = plainDate.toString();
+      const dateFormatted = plainDate.toLocaleString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
+      anniversaryDateDisplay.textContent = `${dateIso} (${dateFormatted})`;
+      anniversaryDateDisplay.dataset.date = dateIso;
+    }
+
+    function saveSchedule(showFeedback = true) {
+      try {
+        const timeVal = pickupTimeInput.value;
+        const dateVal = anniversaryDateInput.value;
+        if (!timeVal || !dateVal) return;
+
+        // Use location-agnostic Plain types that have no time zone offset
+        const plainTime = Temporal.PlainTime.from(timeVal);
+        const plainDate = Temporal.PlainDate.from(dateVal);
+
+        localStorage.setItem(STORAGE_KEY_TIME, plainTime.toString());
+        localStorage.setItem(STORAGE_KEY_DATE, plainDate.toString());
+        localStorage.setItem('pickupReminderTime', plainTime.toString());
+        localStorage.setItem('anniversaryDate', plainDate.toString());
+
+        updateDisplay(plainTime, plainDate);
+
+        if (showFeedback && saveStatus) {
+          saveStatus.textContent = 'Preferences saved! Schedule remains location-agnostic.';
+          saveStatus.style.display = 'inline-block';
+          setTimeout(() => {
+            saveStatus.style.display = 'none';
+          }, 3500);
+        }
+      } catch (err) {
+        console.error('Failed to save coffee schedule:', err);
+      }
+    }
+
+    function initApp() {
+      let savedTime = localStorage.getItem(STORAGE_KEY_TIME) || localStorage.getItem('pickupReminderTime');
+      let savedDate = localStorage.getItem(STORAGE_KEY_DATE) || localStorage.getItem('anniversaryDate');
+
+      if (!savedTime) savedTime = '08:30';
+      if (!savedDate) savedDate = '2024-05-15';
+
+      try {
+        const plainTime = Temporal.PlainTime.from(savedTime);
+        const plainDate = Temporal.PlainDate.from(savedDate);
+
+        pickupTimeInput.value = `${String(plainTime.hour).padStart(2, '0')}:${String(plainTime.minute).padStart(2, '0')}`;
+        anniversaryDateInput.value = plainDate.toString();
+
+        updateDisplay(plainTime, plainDate);
+      } catch (err) {
+        console.error('Error during preferences initialization:', err);
+      }
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        saveSchedule(true);
+      });
+
+      pickupTimeInput.addEventListener('change', () => {
+        try {
+          const plainTime = Temporal.PlainTime.from(pickupTimeInput.value);
+          const plainDate = Temporal.PlainDate.from(anniversaryDateInput.value);
+          updateDisplay(plainTime, plainDate);
+        } catch (e) {}
+      });
+
+      anniversaryDateInput.addEventListener('change', () => {
+        try {
+          const plainTime = Temporal.PlainTime.from(pickupTimeInput.value);
+          const plainDate = Temporal.PlainDate.from(anniversaryDateInput.value);
+          updateDisplay(plainTime, plainDate);
+        } catch (e) {}
+      });
+
+      window.coffeePreferences = {
+        getPickupTime: () => Temporal.PlainTime.from(pickupTimeInput.value),
+        getAnniversaryDate: () => Temporal.PlainDate.from(anniversaryDateInput.value),
+        save: saveSchedule
+      };
+    }
+
+    initTemporal().then(initApp);
+  </script>
 </body>
 
