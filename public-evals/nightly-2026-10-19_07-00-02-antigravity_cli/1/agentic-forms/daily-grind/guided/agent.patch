+      const finalTotal = Math.max(0, subtotal - discountVal) * 1.08;
+
+      const orderId = 'ORD-' + Math.floor(100000 + Math.random() * 900000);
+      const orderConfirmation = {
+        orderId,
+        customerName,
+        customerPhone,
+        customerEmail,
+        pickupLocation,
+        pickupTime,
+        paymentMethod,
+        items: [...cart],
+        subtotal: `$${subtotal.toFixed(2)}`,
+        discountApplied: currentDiscount.code ? `$${discountVal.toFixed(2)}` : '$0.00',
+        totalPaid: `$${finalTotal.toFixed(2)}`,
+        status: 'Confirmed - Preparing at Roastery',
+        timestamp: new Date().toISOString()
+      };
+
+      // Reset cart upon successful checkout
+      cart = [];
+      currentDiscount = { code: null, amount: 0, description: '' };
+      updateCartUI();
+      checkoutForm.reset();
+
+      const feedback = document.getElementById('checkout-feedback');
+      feedback.innerHTML = `<strong>Order Confirmed!</strong> (#${orderId})<br>Ready for pickup at <em>${pickupLocation}</em> around <em>${pickupTime}</em>. Total: <strong>${orderConfirmation.totalPaid}</strong>.`;
+      feedback.classList.add('visible');
+
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve(JSON.stringify(orderConfirmation, null, 2)));
+      }
+    });
+
+    // --- 4. Rewards Lookup Form Submission ---
+    const rewardsForm = document.getElementById('rewards-lookup-form');
+    rewardsForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!validateForm(rewardsForm, event)) return;
+
+      const formData = new FormData(rewardsForm);
+      const memberId = (formData.get('memberId') || '').toString().trim();
+      const member = REWARDS_DB[memberId] || {
+        name: 'Coffee Lover',
+        points: 50,
+        tier: 'Bronze Bean',
+        perks: ['Free regular drip coffee refill on same visit']
+      };
+
+      const feedback = document.getElementById('rewards-feedback');
+      feedback.innerHTML = `<strong>Welcome back, ${member.name}!</strong><br>Tier: <strong>${member.tier}</strong> | Points Balance: <strong>${member.points} pts</strong><br>Eligible Perks: ${member.perks.join(', ')}`;
+      feedback.classList.add('visible');
+
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve(JSON.stringify({
+          memberId,
+          ...member
+        }, null, 2)));
+      }
+    });
+
+    // --- 5. Apply Promo / Reward Coupon Form Submission ---
+    const promoForm = document.getElementById('apply-promo-form');
+    promoForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!validateForm(promoForm, event)) return;
+
+      const formData = new FormData(promoForm);
+      const code = (formData.get('promoCode') || '').toString().trim().toUpperCase();
+      const feedback = document.getElementById('promo-feedback');
+
+      if (PROMO_CODES[code]) {
+        currentDiscount = {
+          code,
+          type: PROMO_CODES[code].type,
+          value: PROMO_CODES[code].value,
+          description: PROMO_CODES[code].description
+        };
+        updateCartUI();
+
+        feedback.className = 'alert-box alert-success visible';
+        feedback.innerHTML = `Promo code <strong>${code}</strong> applied! (${currentDiscount.description})`;
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(JSON.stringify({
+            success: true,
+            code,
+            appliedDescription: currentDiscount.description
+          })));
+        }
+      } else {
+        feedback.className = 'alert-box alert-info visible';
+        feedback.innerHTML = `Promo code <strong>${code}</strong> is invalid or expired. Try FREECOFFEE, STARS100, or SAVE10.`;
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(`Validation failed: Promo code "${code}" is invalid or expired.`));
+        }
+      }
+    });
+
+    // --- 6. Locations Search Form Submission ---
+    const locationsForm = document.getElementById('locations-search-form');
+    locationsForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!validateForm(locationsForm, event)) return;
+
+      const formData = new FormData(locationsForm);
+      const query = (formData.get('searchQuery') || '').toString().toLowerCase().trim();
+      const amenity = formData.get('amenity') || 'all';
+
+      const results = LOCATIONS.filter(loc => {
+        const matchesQuery = !query || 
+          loc.city.includes(query) || 
+          loc.zip.includes(query) || 
+          loc.name.toLowerCase().includes(query) ||
+          loc.address.toLowerCase().includes(query);
+        const matchesAmenity = amenity === 'all' || loc.amenities.includes(amenity);
+        return matchesQuery && matchesAmenity;
+      });
+
+      renderLocations(results);
+
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve(JSON.stringify({
+          count: results.length,
+          locations: results
+        }, null, 2)));
+      }
+    });
+
+    // --- 7. Contact Support Form Submission ---
+    const contactForm = document.getElementById('contact-form');
+    contactForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!validateForm(contactForm, event)) return;
+
+      const formData = new FormData(contactForm);
+      const ticketId = 'TICK-' + Math.floor(10000 + Math.random() * 90000);
+      const inquiry = {
+        ticketId,
+        name: formData.get('name'),
+        email: formData.get('email'),
+        subject: formData.get('subject'),
+        message: formData.get('message'),
+        status: 'Received by Customer Care',
+        receivedAt: new Date().toISOString()
+      };
+
+      contactForm.reset();
+      const feedback = document.getElementById('contact-feedback');
+      feedback.innerHTML = `Thank you, <strong>${inquiry.name}</strong>! Your inquiry (#${ticketId}) has been received. Our team will get back to you at <em>${inquiry.email}</em> within 24 hours.`;
+      feedback.classList.add('visible');
+
+      if (event.agentInvoked && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve(JSON.stringify(inquiry, null, 2)));
+      }
+    });
+
+    // Initial render on page load
+    document.addEventListener('DOMContentLoaded', () => {
+      renderMenu(MENU_ITEMS);
+      renderLocations(LOCATIONS);
+      updateCartUI();
+    });
+  </script>
+
