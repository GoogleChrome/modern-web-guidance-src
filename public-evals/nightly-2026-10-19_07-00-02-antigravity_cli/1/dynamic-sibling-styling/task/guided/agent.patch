+  <script>
+    /* Fallback strategy for browsers without native sibling-index() and sibling-count() */
+    /* MANDATORY: Check for native support before applying fallback */
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      function updateDynamicSiblings() {
+        const selectors = ['.spectrum-card', '.fan-card', '.circle-orb'];
+        selectors.forEach(selector => {
+          const elements = document.querySelectorAll(selector);
+          const parents = new Set(Array.from(elements, el => el.parentElement).filter(Boolean));
+          parents.forEach(parent => {
+            const items = parent.querySelectorAll(`:scope > ${selector}`);
+            items.forEach((item, index) => {
+              /* MANDATORY: Injected index must be 1-based to match native function */
+              item.style.setProperty('--sibling-index', index + 1);
+              item.style.setProperty('--sibling-count', items.length);
+            });
+          });
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', updateDynamicSiblings);
+      } else {
+        updateDynamicSiblings();
+      }
+
+      /* Dynamically adapt if items are added or removed in the future */
+      const observer = new MutationObserver(updateDynamicSiblings);
+      observer.observe(document.body, { childList: true, subtree: true });
+    }
+  </script>
