+  <script>
+    (function () {
+      const textarea = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-btn');
+      const apiStatusHint = document.getElementById('api-status-hint');
+      const progressContainer = document.getElementById('progress-container');
+      const progressText = document.getElementById('progress-text');
+      const progressPercent = document.getElementById('progress-percent');
+      const progressBarFill = document.getElementById('progress-bar-fill');
+      const resultBox = document.getElementById('detection-result');
+
+      let cachedDetector = null;
+
+      function updateProgress(loaded, total) {
+        progressContainer.style.display = 'block';
+        let percent = 0;
+        if (total && total > 0) {
+          percent = Math.round((loaded / total) * 100);
+        } else if (loaded !== undefined && loaded !== null) {
+          if (loaded <= 1) {
+            percent = Math.round(loaded * 100);
+          } else {
+            percent = Math.round(loaded);
+          }
+        }
+        percent = Math.max(0, Math.min(100, percent));
+        progressPercent.textContent = `${percent}%`;
+        progressText.textContent = `Downloading AI language model (${percent}%)...`;
+        progressBarFill.style.width = `${percent}%`;
+      }
+
+      function showMessage(type, title, htmlContent) {
+        resultBox.className = `result-box ${type}`;
+        resultBox.style.display = 'block';
+        resultBox.innerHTML = title ? `<h4>${title}</h4>${htmlContent}` : htmlContent;
+      }
+
+      function clearMessage() {
+        resultBox.style.display = 'none';
+        resultBox.innerHTML = '';
+      }
+
+      function getLanguageName(langCode) {
+        if (!langCode || langCode === 'und') {
+          return 'Undetermined';
+        }
+        try {
+          const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+          const name = displayNames.of(langCode);
+          if (name && name.toLowerCase() !== 'root') {
+            return name;
+          }
+        } catch (e) {
+          // fallback to language code
+        }
+        return langCode;
+      }
+
+      // Check if browser's built-in language detection is available
+      async function checkFeatureAvailability() {
+        // Standard LanguageDetector API (Chrome 138+ / W3C draft)
+        if (typeof LanguageDetector !== 'undefined') {
+          if (typeof LanguageDetector.availability === 'function') {
+            try {
+              const status = await LanguageDetector.availability();
+              return {
+                available: status !== 'no' && status !== 'unavailable',
+                status: status,
+                provider: 'LanguageDetector'
+              };
+            } catch (e) {
+              console.warn('Error checking LanguageDetector availability:', e);
+            }
+          }
+          if (typeof LanguageDetector.capabilities === 'function') {
+            try {
+              const cap = await LanguageDetector.capabilities();
+              return {
+                available: cap && cap.available !== 'no',
+                status: cap ? cap.available : 'readily',
+                provider: 'LanguageDetector'
+              };
+            } catch (e) {
+              console.warn('Error checking LanguageDetector capabilities:', e);
+            }
+          }
+          return { available: true, status: 'readily', provider: 'LanguageDetector' };
+        }
+
+        // ai.languageDetector (Chrome early Built-in AI)
+        const aiScope = (typeof window !== 'undefined' && window.ai) || (typeof self !== 'undefined' && self.ai);
+        if (aiScope && aiScope.languageDetector) {
+          if (typeof aiScope.languageDetector.availability === 'function') {
+            try {
+              const status = await aiScope.languageDetector.availability();
+              return {
+                available: status !== 'no' && status !== 'unavailable',
+                status: status,
+                provider: 'ai.languageDetector'
+              };
+            } catch (e) {
+              console.warn('Error checking ai.languageDetector availability:', e);
+            }
+          }
+          if (typeof aiScope.languageDetector.capabilities === 'function') {
+            try {
+              const cap = await aiScope.languageDetector.capabilities();
+              return {
+                available: cap && cap.available !== 'no',
+                status: cap ? cap.available : 'readily',
+                provider: 'ai.languageDetector'
+              };
+            } catch (e) {
+              console.warn('Error checking ai.languageDetector capabilities:', e);
+            }
+          }
+          return { available: true, status: 'readily', provider: 'ai.languageDetector' };
+        }
+
+        // translation API (Chrome Translation origin trial)
+        const transScope = (typeof window !== 'undefined' && window.translation) || (typeof self !== 'undefined' && self.translation);
+        if (transScope && (transScope.canDetect || transScope.createDetector)) {
+          if (typeof transScope.canDetect === 'function') {
+            try {
+              const status = await transScope.canDetect();
+              return {
+                available: status !== 'no' && status !== 'unavailable',
+                status: status,
+                provider: 'translation'
+              };
+            } catch (e) {
+              console.warn('Error checking translation.canDetect:', e);
+            }
+          }
+          return { available: true, status: 'readily', provider: 'translation' };
+        }
+
+        return { available: false, status: 'no', provider: null };
+      }
+
+      async function createDetectorInstance(provider, status) {
+        if (cachedDetector) {
+          return cachedDetector;
+        }
+
+        const monitorOptions = {
+          monitor(m) {
+            if (m && typeof m.addEventListener === 'function') {
+              m.addEventListener('downloadprogress', (e) => {
+                updateProgress(e.loaded, e.total);
+              });
+            }
+          }
+        };
+
+        if (status === 'after-download' || status === 'downloadable' || status === 'downloading') {
+          updateProgress(0, 100);
+        }
+
+        let detectorInstance = null;
+
+        try {
+          if (provider === 'LanguageDetector') {
+            detectorInstance = await LanguageDetector.create(monitorOptions);
+          } else if (provider === 'ai.languageDetector') {
+            const aiScope = window.ai || self.ai;
+            detectorInstance = await aiScope.languageDetector.create(monitorOptions);
+          } else if (provider === 'translation') {
+            const transScope = window.translation || self.translation;
+            detectorInstance = await transScope.createDetector(monitorOptions);
+          }
+        } catch (createErr) {
+          // Retry without monitor options in case API version does not accept options
+          console.warn('Failed creating detector with monitor options, retrying without options:', createErr);
+          if (provider === 'LanguageDetector') {
+            detectorInstance = await LanguageDetector.create();
+          } else if (provider === 'ai.languageDetector') {
+            const aiScope = window.ai || self.ai;
+            detectorInstance = await aiScope.languageDetector.create();
+          } else if (provider === 'translation') {
+            const transScope = window.translation || self.translation;
+            detectorInstance = await transScope.createDetector();
+          }
+        }
+
+        progressContainer.style.display = 'none';
+        cachedDetector = detectorInstance;
+        return detectorInstance;
+      }
+
+      // Initialize status hint on page load
+      checkFeatureAvailability().then((feature) => {
+        if (!feature.available) {
+          apiStatusHint.textContent = 'Built-in Language Detection is not supported in this browser.';
+        } else if (feature.status === 'after-download') {
+          apiStatusHint.textContent = 'AI model will download on first detection.';
+        } else {
+          apiStatusHint.textContent = 'Built-in AI language detector is ready.';
+        }
+      }).catch(() => {
+        apiStatusHint.textContent = '';
+      });
+
+      detectBtn.addEventListener('click', async () => {
+        const text = textarea.value.trim();
+        if (!text) {
+          showMessage('warning', 'Notice', 'Please type a feedback message before clicking Detect.');
+          return;
+        }
+
+        detectBtn.disabled = true;
+        clearMessage();
+
+        try {
+          // 1. Check feature availability first
+          const feature = await checkFeatureAvailability();
+
+          if (!feature.available) {
+            showMessage(
+              'error',
+              'Feature Not Available',
+              'The browser\'s built-in language detection is not supported or not enabled in your current browser. Please use a compatible browser (e.g. Chrome 138+ with built-in AI enabled).'
+            );
+            return;
+          }
+
+          // 2. Create detector (and show download progress percentage if model download needed)
+          const detector = await createDetectorInstance(feature.provider, feature.status);
+
+          if (!detector || typeof detector.detect !== 'function') {
+            throw new Error('Language detector could not be initialized.');
+          }
+
+          // 3. Detect language
+          const results = await detector.detect(text);
+
+          if (!results || results.length === 0) {
+            showMessage('warning', 'No Language Detected', 'Could not determine the language for this message.');
+            return;
+          }
+
+          const top = results[0];
+          const langCode = top.detectedLanguage;
+          const langName = getLanguageName(langCode);
+
+          let confidencePercent;
+          if (typeof top.confidence === 'number') {
+            confidencePercent = top.confidence <= 1 ? (top.confidence * 100).toFixed(1) : Number(top.confidence).toFixed(1);
+          } else {
+            confidencePercent = '100.0';
+          }
+
+          let resultHtml = `
+            <div class="result-stat">
+              <span><strong>Detected Language:</strong></span>
+              <span><span class="result-badge">${langName}</span> <small style="color: #6d4c41;">(${langCode})</small></span>
+            </div>
+            <div class="result-stat">
+              <span><strong>AI Confidence:</strong></span>
+              <span><strong>${confidencePercent}%</strong></span>
+            </div>
+          `;
+
+          if (results.length > 1 && results[1].confidence > 0.05) {
+            const others = results.slice(1, 3).map(r => {
+              const name = getLanguageName(r.detectedLanguage);
+              const conf = r.confidence <= 1 ? (r.confidence * 100).toFixed(1) : Number(r.confidence).toFixed(1);
+              return `${name} (${conf}%)`;
+            }).join(', ');
+            resultHtml += `
+              <div style="margin-top: 10px; font-size: 0.85rem; color: #5d4037;">
+                <em>Other candidates: ${others}</em>
+              </div>
+            `;
+          }
+
+          showMessage('success', 'Language Detection Result', resultHtml);
+        } catch (err) {
+          console.error('Language detection error:', err);
+          progressContainer.style.display = 'none';
+          showMessage(
+            'error',
+            'Detection Failed',
+            `An error occurred while detecting the language: ${err.message || err}`
+          );
+        } finally {
+          detectBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
 </body>
 
