+  <script>
+    (function () {
+      const detectBtn = document.getElementById('detect-btn');
+      const feedbackMessage = document.getElementById('feedback-message');
+      const detectionStatus = document.getElementById('detection-status');
+      const downloadProgressContainer = document.getElementById('download-progress-container');
+      const downloadProgress = document.getElementById('download-progress');
+      const downloadPercentage = document.getElementById('download-percentage');
+      const detectionResult = document.getElementById('detection-result');
+      const detectedLanguage = document.getElementById('detected-language');
+      const detectedConfidence = document.getElementById('detected-confidence');
+
+      let cachedDetector = null;
+
+      function getLanguageDetectorApi() {
+        if (typeof LanguageDetector !== 'undefined') {
+          return LanguageDetector;
+        }
+        if (typeof self !== 'undefined' && self.LanguageDetector) {
+          return self.LanguageDetector;
+        }
+        if (typeof self !== 'undefined' && self.ai && self.ai.languageDetector) {
+          return self.ai.languageDetector;
+        }
+        return null;
+      }
+
+      async function checkAvailability(api) {
+        if (!api) return 'unavailable';
+        try {
+          if (typeof api.availability === 'function') {
+            const res = await api.availability();
+            return typeof res === 'string' ? res : (res?.available || 'unavailable');
+          } else if (typeof api.capabilities === 'function') {
+            const caps = await api.capabilities();
+            return caps.available;
+          }
+        } catch (err) {
+          console.warn('Availability check failed:', err);
+        }
+        return 'unavailable';
+      }
+
+      function getLanguageName(langCode) {
+        try {
+          const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+          const name = displayNames.of(langCode);
+          return name ? `${name} (${langCode})` : langCode;
+        } catch (e) {
+          return langCode;
+        }
+      }
+
+      async function checkFeatureSupport() {
+        const api = getLanguageDetectorApi();
+        if (!api) {
+          detectBtn.disabled = true;
+          detectionStatus.textContent = 'Language detection is not supported in this browser.';
+          return;
+        }
+
+        try {
+          const availability = await checkAvailability(api);
+          if (availability === 'unavailable' || availability === 'no') {
+            detectBtn.disabled = true;
+            detectionStatus.textContent = 'Language detection is unavailable on this device.';
+          } else if (availability === 'downloadable' || availability === 'after-download') {
+            detectionStatus.textContent = 'Model download required on first use.';
+          }
+        } catch (err) {
+          console.warn('Initial availability check failed:', err);
+        }
+      }
+
+      detectBtn.addEventListener('click', async () => {
+        const message = feedbackMessage.value.trim();
+        if (!message) {
+          detectionStatus.textContent = 'Please enter a message before detecting.';
+          feedbackMessage.focus();
+          return;
+        }
+
+        const api = getLanguageDetectorApi();
+        if (!api) {
+          detectBtn.disabled = true;
+          detectionStatus.textContent = 'Language detection is not supported in this browser.';
+          return;
+        }
+
+        try {
+          detectBtn.disabled = true;
+          detectionStatus.textContent = 'Checking availability...';
+
+          const availability = await checkAvailability(api);
+          if (availability === 'unavailable' || availability === 'no') {
+            detectBtn.disabled = true;
+            detectionStatus.textContent = 'Language detection is unavailable on this device.';
+            return;
+          }
+
+          if (!cachedDetector) {
+            const needsDownload = availability === 'downloadable' || availability === 'after-download' || availability === 'downloading';
+            if (needsDownload) {
+              downloadProgressContainer.style.display = 'block';
+              downloadProgress.value = 0;
+              downloadPercentage.textContent = '0%';
+              detectionStatus.textContent = 'Downloading model...';
+            } else {
+              detectionStatus.textContent = 'Preparing detector...';
+            }
+
+            const options = {
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  let percent = 0;
+                  if (e.total && e.total > 0) {
+                    percent = Math.round((e.loaded / e.total) * 100);
+                  } else if (e.loaded <= 1) {
+                    percent = Math.round(e.loaded * 100);
+                  } else {
+                    percent = Math.round(e.loaded);
+                  }
+                  percent = Math.min(Math.max(percent, 0), 100);
+                  downloadProgress.value = percent;
+                  downloadPercentage.textContent = `${percent}%`;
+                  detectionStatus.textContent = `Downloading model: ${percent}%`;
+                });
+              }
+            };
+
+            cachedDetector = await api.create(options);
+            downloadProgressContainer.style.display = 'none';
+          }
+
+          detectionStatus.textContent = 'Detecting language...';
+          const results = await cachedDetector.detect(message);
+
+          if (results && results.length > 0) {
+            const topResult = results[0];
+            const languageName = getLanguageName(topResult.detectedLanguage);
+            const confidencePercent = (topResult.confidence * 100).toFixed(1) + '%';
+
+            detectedLanguage.textContent = languageName;
+            detectedConfidence.textContent = `${confidencePercent} (${topResult.confidence})`;
+            detectionResult.style.display = 'block';
+            detectionStatus.textContent = '';
+          } else {
+            detectionResult.style.display = 'none';
+            detectionStatus.textContent = 'No language detected.';
+          }
+        } catch (error) {
+          console.error('Detection error:', error);
+          downloadProgressContainer.style.display = 'none';
+          detectionStatus.textContent = `Detection failed: ${error.message || 'Unknown error'}`;
+        } finally {
+          detectBtn.disabled = false;
+        }
+      });
+
+      checkFeatureSupport();
+    })();
+  </script>
 </body>
 
