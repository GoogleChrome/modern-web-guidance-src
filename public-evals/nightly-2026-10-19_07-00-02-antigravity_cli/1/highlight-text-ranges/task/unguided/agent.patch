+  <script>
+    (function () {
+      const searchInput = document.getElementById('search-input');
+      if (!searchInput) return;
+
+      function escapeRegExp(string) {
+        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+      }
+
+      function clearHighlights() {
+        const highlights = document.querySelectorAll('.card mark, .card .highlight');
+        const parents = new Set();
+        highlights.forEach(el => {
+          const parent = el.parentNode;
+          if (parent) {
+            parents.add(parent);
+            parent.replaceChild(document.createTextNode(el.textContent), el);
+          }
+        });
+        parents.forEach(parent => parent.normalize());
+      }
+
+      function highlightTextInNode(node, regex) {
+        if (node.nodeType === Node.TEXT_NODE) {
+          const text = node.nodeValue;
+          regex.lastIndex = 0;
+          if (!regex.test(text)) return;
+          regex.lastIndex = 0;
+
+          const fragment = document.createDocumentFragment();
+          let lastIndex = 0;
+          let match;
+
+          while ((match = regex.exec(text)) !== null) {
+            if (match[0].length === 0) {
+              regex.lastIndex++;
+              continue;
+            }
+            if (match.index > lastIndex) {
+              fragment.appendChild(document.createTextNode(text.substring(lastIndex, match.index)));
+            }
+            const mark = document.createElement('mark');
+            mark.className = 'highlight';
+            mark.style.backgroundColor = 'gold';
+            mark.textContent = match[0];
+            fragment.appendChild(mark);
+
+            lastIndex = regex.lastIndex;
+          }
+
+          if (lastIndex < text.length) {
+            fragment.appendChild(document.createTextNode(text.substring(lastIndex)));
+          }
+
+          node.parentNode.replaceChild(fragment, node);
+        } else if (node.nodeType === Node.ELEMENT_NODE) {
+          if (
+            node.tagName === 'SCRIPT' ||
+            node.tagName === 'STYLE' ||
+            node.tagName === 'MARK' ||
+            node.classList.contains('highlight')
+          ) {
+            return;
+          }
+          const children = Array.from(node.childNodes);
+          for (const child of children) {
+            highlightTextInNode(child, regex);
+          }
+        }
+      }
+
+      function handleSearch() {
+        clearHighlights();
+        const query = searchInput.value.trim();
+        if (!query) return;
+
+        const escaped = query.split(/\s+/).map(escapeRegExp).join('\\s+');
+        const regex = new RegExp(escaped, 'gi');
+
+        const cards = document.querySelectorAll('.card');
+        cards.forEach(card => highlightTextInNode(card, regex));
+      }
+
+      searchInput.addEventListener('input', handleSearch);
+      searchInput.addEventListener('keyup', handleSearch);
+      searchInput.addEventListener('change', handleSearch);
+    })();
+  </script>
