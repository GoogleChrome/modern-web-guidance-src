+  <script>
+    (function () {
+      const customBeans = [
+        {
+          name: "Guatemala Antigua",
+          desc: "Velvety cocoa with hints of baking spice and subtle smoky sweetness.",
+          roast: "Medium Roast &bull; Volcanic Valley"
+        },
+        {
+          name: "Costa Rica Tarrazú",
+          desc: "Crisp green apple acidity with a clean honeyed finish and citrus florals.",
+          roast: "Light Roast &bull; Honey Process"
+        },
+        {
+          name: "Kenya AA Highlands",
+          desc: "Complex berry sweetness, black currant, and bright wine-like acidity.",
+          roast: "Medium Roast &bull; High Altitude"
+        },
+        {
+          name: "Panama Boquete Geisha",
+          desc: "Exquisite floral aroma with bergamot, peach nectar, and delicate jasmine.",
+          roast: "Light Roast &bull; Reserve Selection"
+        },
+        {
+          name: "Rwanda Bourbon",
+          desc: "Silky body with sweet mandarin orange, red currant, and warm clove.",
+          roast: "Medium-Dark Roast &bull; Fair Trade"
+        },
+        {
+          name: "Java Estate Blawan",
+          desc: "Syrupy sweetness with heavy body and subtle herbal spiciness.",
+          roast: "Dark Roast &bull; Washed Arabica"
+        },
+        {
+          name: "Brazil Cerrado Natural",
+          desc: "Creamy peanut butter, milk chocolate fudge, and low citric acidity.",
+          roast: "Medium Roast &bull; Solar Dried"
+        }
+      ];
+
+      let beanCounter = 3;
+      const beanList = document.getElementById('bean-list');
+      const addItemBtn = document.getElementById('add-item-btn');
+
+      function addItem() {
+        beanCounter++;
+        const beanData = customBeans[(beanCounter - 4) % customBeans.length] || {
+          name: 'Custom Artisanal Roast #' + beanCounter,
+          desc: 'Specialty single-batch coffee beans roasted to perfection.',
+          roast: 'Custom Roast &bull; Small Batch'
+        };
+
+        const newItem = document.createElement('li');
+        newItem.className = 'item';
+        newItem.style.viewTransitionName = 'item-' + beanCounter;
+        newItem.innerHTML = `
+          <div class="item-content">
+            <h3>${beanData.name}</h3>
+            <p>${beanData.desc}</p>
+            <span class="bean-badge">${beanData.roast}</span>
+          </div>
+          <button class="btn-remove" type="button" aria-label="Remove item" onclick="removeBean(this)">Remove</button>
+        `;
+
+        if (document.startViewTransition) {
+          document.startViewTransition(() => {
+            beanList.appendChild(newItem);
+          });
+        } else {
+          beanList.appendChild(newItem);
+        }
+      }
+
+      function removeBean(target) {
+        const item = target && target.closest ? target.closest('.item') : target;
+        if (!item) return;
+
+        if (document.startViewTransition) {
+          document.startViewTransition(() => {
+            item.remove();
+          });
+        } else {
+          item.remove();
+        }
+      }
+
+      if (addItemBtn) {
+        addItemBtn.addEventListener('click', addItem);
+      }
+
+      if (beanList) {
+        beanList.addEventListener('click', (e) => {
+          const removeBtn = e.target.closest('.btn-remove');
+          if (removeBtn) {
+            removeBean(removeBtn);
+          }
+        });
+      }
+
+      window.addItem = addItem;
+      window.removeBean = removeBean;
+    })();
+  </script>
 </body>
 
