+  <script>
+    let loginAbortController = null;
+
+    async function triggerConditionalCreate() {
+      // Feature-detect conditional creation capabilities using PublicKeyCredential.getClientCapabilities()
+      if (typeof PublicKeyCredential === 'undefined' || typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+        return;
+      }
+
+      let capabilities;
+      try {
+        capabilities = await PublicKeyCredential.getClientCapabilities();
+      } catch (err) {
+        return;
+      }
+
+      if (!capabilities || !capabilities.conditionalCreate) {
+        return;
+      }
+
+      // 1. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+      if (loginAbortController) {
+        try {
+          loginAbortController.abort();
+        } catch (_) {}
+        loginAbortController = null;
+      }
+
+      // 2. Fetch creation options signaling the backend that this is a conditional request
+      let creationOptionsJSON;
+      try {
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json'
+          },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsResponse.ok) {
+          return;
+        }
+        creationOptionsJSON = await optionsResponse.json();
+      } catch (err) {
+        console.error('Failed to fetch registration options:', err);
+        return;
+      }
+
+      // 3. Parse options using PublicKeyCredential.parseCreationOptionsFromJSON
+      let publicKey;
+      if (typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+        try {
+          publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+        } catch (_) {
+          if (creationOptionsJSON && creationOptionsJSON.publicKey) {
+            publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON.publicKey);
+          } else {
+            publicKey = creationOptionsJSON;
+          }
+        }
+      } else {
+        publicKey = (creationOptionsJSON && creationOptionsJSON.publicKey) ? creationOptionsJSON.publicKey : creationOptionsJSON;
+      }
+
+      // 4. Invoke silent credentials creation prompt with mediation: "conditional"
+      let credential;
+      try {
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+      } catch (e) {
+        // Silently swallow common WebAuthn browser exceptions without showing dialog, prompt, or error UI
+        if (['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e && e.name)) {
+          return;
+        }
+        console.error('Unexpected conditional create error:', e);
+        return;
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      // 5. Server verification step
+      const encodedResponse = (typeof credential.toJSON === 'function') ? credential.toJSON() : credential;
+      const rpId = (publicKey && publicKey.rp && publicKey.rp.id) ? publicKey.rp.id : window.location.hostname;
+      const credentialId = encodedResponse.id || credential.id;
+
+      try {
+        const verifyResponse = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json'
+          },
+          body: JSON.stringify(encodedResponse)
+        });
+
+        if (!verifyResponse.ok) {
+          // If server verification fails, clean up using Signal API
+          if (typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId,
+                credentialId
+              });
+            } catch (_) {}
+          }
+        }
+      } catch (serverErr) {
+        console.error('Verification network failure:', serverErr);
+        if (typeof PublicKeyCredential !== 'undefined' && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId
+            });
+          } catch (_) {}
+        }
+      }
+    }
+
+    const signinForm = document.getElementById('signin-form');
+    const signinButton = document.querySelector('[data-testid="signin-button"]');
+
+    let isSigningIn = false;
+
+    async function handleSignIn(e) {
+      if (e) {
+        e.preventDefault();
+      }
+      if (isSigningIn) return;
+      isSigningIn = true;
+
+      try {
+        await triggerConditionalCreate();
+      } finally {
+        isSigningIn = false;
+      }
+    }
+
+    if (signinForm) {
+      signinForm.addEventListener('submit', handleSignIn);
+    }
+    if (signinButton) {
+      signinButton.addEventListener('click', handleSignIn);
+    }
+
+    window.triggerConditionalCreate = triggerConditionalCreate;
+  </script>
