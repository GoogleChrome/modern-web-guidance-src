+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-dialog');
+      const slot1 = document.getElementById('feedback-slot-1');
+      const slot2 = document.getElementById('feedback-slot-2');
+      const slotIndicator = document.getElementById('slot-indicator');
+      const methodIndicator = document.getElementById('method-indicator');
+
+      function updateSlotIndicator(method) {
+        if (!dialog) return;
+        const currentParent = dialog.parentElement;
+        const parentId = currentParent ? (currentParent.id || currentParent.tagName.toLowerCase()) : 'none';
+        if (slotIndicator) {
+          slotIndicator.innerHTML = 'Parent: <strong>#' + parentId + '</strong>';
+        }
+        if (methodIndicator && method) {
+          methodIndicator.innerHTML = 'API: <strong>' + method + '</strong>';
+        }
+      }
+
+      function openModal() {
+        if (!dialog) return;
+        if (!dialog.open) {
+          if (typeof dialog.showModal === 'function') {
+            try {
+              dialog.showModal();
+              dialog.dataset.isModal = 'true';
+            } catch (e) {
+              dialog.setAttribute('open', '');
+            }
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+        updateSlotIndicator();
+      }
+
+      function closeModal() {
+        if (!dialog) return;
+        if (dialog.open) {
+          if (typeof dialog.close === 'function') {
+            dialog.close();
+          } else {
+            dialog.removeAttribute('open');
+          }
+          dialog.dataset.isModal = 'false';
+        }
+      }
+
+      function relocateFeedbackDialog(targetParent) {
+        if (!dialog) return;
+
+        // Determine destination slot
+        let destination = targetParent;
+        if (!destination) {
+          destination = (dialog.parentElement === slot1) ? slot2 : slot1;
+        }
+
+        // Check whether dialog was open and modal
+        const wasOpen = dialog.hasAttribute('open') ||
+          (dialog.matches && dialog.matches(':popover-open')) ||
+          dialog.open;
+        const isModal = (dialog.matches && dialog.matches(':modal')) ||
+          dialog.dataset.isModal === 'true' ||
+          wasOpen;
+
+        // Ensure modal is open before moving
+        if (!wasOpen) {
+          if (typeof dialog.showModal === 'function') {
+            try {
+              dialog.showModal();
+              dialog.dataset.isModal = 'true';
+            } catch (e) {
+              dialog.setAttribute('open', '');
+            }
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+
+        // Capture active element and focus/selection state inside the dialog
+        const activeEl = document.activeElement;
+        const isFocusInside = activeEl && dialog.contains(activeEl);
+        const activeId = activeEl ? activeEl.id : null;
+        const activeName = activeEl ? activeEl.name : null;
+        const activeSelector = activeId
+          ? '#' + CSS.escape(activeId)
+          : (activeName ? '[name="' + CSS.escape(activeName) + '"]' : null);
+
+        const selStart = (activeEl instanceof HTMLInputElement || activeEl instanceof HTMLTextAreaElement)
+          ? activeEl.selectionStart
+          : null;
+        const selEnd = (activeEl instanceof HTMLInputElement || activeEl instanceof HTMLTextAreaElement)
+          ? activeEl.selectionEnd
+          : null;
+
+        // Feature detection for native moveBefore API
+        const supportsMoveBefore = typeof Element.prototype.moveBefore === 'function' ||
+          typeof destination.moveBefore === 'function';
+
+        if (supportsMoveBefore) {
+          // MANDATORY: Use native state-preserving moveBefore API.
+          // Passing null appends it to the end of destination.
+          destination.moveBefore(dialog, null);
+          dialog.dataset.lastMoveMethod = 'moveBefore';
+
+          // Ensure focus remains active after reparenting
+          if (isFocusInside && activeEl && typeof activeEl.focus === 'function') {
+            if (document.activeElement !== activeEl) {
+              activeEl.focus();
+              if (selStart !== null && selEnd !== null && typeof activeEl.setSelectionRange === 'function') {
+                try {
+                  activeEl.setSelectionRange(selStart, selEnd);
+                } catch (e) { }
+              }
+            }
+          } else if (!isFocusInside) {
+            const moveBtn = dialog.querySelector('#move-dialog-btn, .move-btn');
+            if (moveBtn && typeof moveBtn.focus === 'function') {
+              moveBtn.focus();
+            }
+          }
+          updateSlotIndicator('moveBefore()');
+        } else {
+          // Fallback: traditional reparenting for unsupported browsers.
+          // Disconnecting from the DOM implicitly closes <dialog> and loses top-layer and focus state.
+          destination.insertBefore(dialog, null);
+          dialog.dataset.lastMoveMethod = 'fallback';
+
+          // Manually re-open the dialog to restore the modal state
+          if (wasOpen || isModal) {
+            if (isModal && typeof dialog.showModal === 'function') {
+              try {
+                dialog.showModal();
+                dialog.dataset.isModal = 'true';
+              } catch (e) {
+                if (typeof dialog.show === 'function') dialog.show();
+              }
+            } else if (typeof dialog.showPopover === 'function' && dialog.hasAttribute('popover')) {
+              dialog.showPopover();
+            } else if (typeof dialog.show === 'function') {
+              dialog.show();
+            } else {
+              dialog.setAttribute('open', '');
+            }
+          }
+
+          // Restore focus-active state
+          let targetFocus = activeEl;
+          if (!targetFocus || !dialog.contains(targetFocus)) {
+            if (activeSelector) {
+              targetFocus = dialog.querySelector(activeSelector);
+            }
+          }
+          if (isFocusInside && targetFocus && typeof targetFocus.focus === 'function') {
+            targetFocus.focus();
+            if (selStart !== null && selEnd !== null && typeof targetFocus.setSelectionRange === 'function') {
+              try {
+                targetFocus.setSelectionRange(selStart, selEnd);
+              } catch (e) { }
+            }
+          } else {
+            const moveBtn = dialog.querySelector('#move-dialog-btn, .move-btn');
+            if (moveBtn && typeof moveBtn.focus === 'function') {
+              moveBtn.focus();
+            }
+          }
+          updateSlotIndicator('fallback (insertBefore)');
+        }
+      }
+
+      // Expose globally for testing or programmatic relocation
+      window.relocateFeedbackDialog = relocateFeedbackDialog;
+      window.moveFeedbackDialog = relocateFeedbackDialog;
+      window.openFeedbackModal = openModal;
+      window.closeFeedbackModal = closeModal;
+
+      // Track modal state changes
+      if (dialog) {
+        dialog.addEventListener('close', function () {
+          dialog.dataset.isModal = 'false';
+        });
+      }
+
+      // Bind all move buttons
+      document.querySelectorAll('#move-dialog-btn, #move-btn, .move-btn, [data-action="move"]').forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          e.preventDefault();
+          relocateFeedbackDialog();
+        });
+      });
+
+      // Bind open buttons
+      document.querySelectorAll('#open-feedback-btn, #nav-feedback-btn, .open-feedback-btn').forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          e.preventDefault();
+          openModal();
+        });
+      });
+
+      // Bind close buttons
+      document.querySelectorAll('#close-feedback-btn, .close-feedback-btn').forEach(function (btn) {
+        btn.addEventListener('click', function (e) {
+          e.preventDefault();
+          closeModal();
+        });
+      });
+
+      // Form submission
+      const form = document.getElementById('feedback-form');
+      if (form) {
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          const successMsg = document.getElementById('feedback-success-msg');
+          if (successMsg) {
+            successMsg.style.display = 'block';
+            setTimeout(function () {
+              successMsg.style.display = 'none';
+              closeModal();
+            }, 1200);
+          } else {
+            closeModal();
+          }
+        });
+      }
+
+      // Initial indicator setup
+      updateSlotIndicator();
+
+      // Open modal initially as persistent feedback overlay
+      try {
+        openModal();
+      } catch (e) {
+        console.warn('Initial modal open:', e);
+      }
+    })();
+  </script>
