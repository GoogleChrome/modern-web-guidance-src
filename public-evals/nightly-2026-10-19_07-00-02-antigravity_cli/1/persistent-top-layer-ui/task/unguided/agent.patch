+          if (!clickedInside) {
+            closeFeedbackModal();
+          }
+        }
+      });
+
+      if (openFeedbackBtn) {
+        openFeedbackBtn.addEventListener('click', function () {
+          openFeedbackModal();
+        });
+      }
+
+      if (navFeedbackBtn) {
+        navFeedbackBtn.addEventListener('click', function () {
+          openFeedbackModal();
+        });
+      }
+
+      if (closeDialogBtn) {
+        closeDialogBtn.addEventListener('click', function () {
+          closeFeedbackModal();
+        });
+      }
+
+      if (closeModalFooterBtn) {
+        closeModalFooterBtn.addEventListener('click', function () {
+          closeFeedbackModal();
+        });
+      }
+
+      if (feedbackForm) {
+        feedbackForm.addEventListener('submit', function (e) {
+          e.preventDefault();
+          const formBody = document.getElementById('feedback-form-content');
+          const successBanner = document.getElementById('feedback-success-content');
+          if (formBody && successBanner) {
+            formBody.style.display = 'none';
+            successBanner.style.display = 'block';
+          }
+        });
+      }
+
+      if (resetFeedbackBtn) {
+        resetFeedbackBtn.addEventListener('click', function () {
+          feedbackForm?.reset();
+          const formBody = document.getElementById('feedback-form-content');
+          const successBanner = document.getElementById('feedback-success-content');
+          if (formBody && successBanner) {
+            formBody.style.display = 'block';
+            successBanner.style.display = 'none';
+          }
+        });
+      }
+
+      // Update active element status badge on focus changes
+      document.addEventListener('focusin', function () {
+        updateUIStatus();
+      });
+
+      // Expose globally for API / test harness access
+      window.feedbackDialog = feedbackDialog;
+      feedbackDialog.relocate = relocateFeedbackDialog;
+      window.relocateFeedbackDialog = relocateFeedbackDialog;
+      window.openFeedbackModal = openFeedbackModal;
+      window.closeFeedbackModal = closeFeedbackModal;
+
+      // Automatically open the persistent feedback overlay modal on initialization
+      openFeedbackModal();
+    })();
+  </script>
 </body>
 
