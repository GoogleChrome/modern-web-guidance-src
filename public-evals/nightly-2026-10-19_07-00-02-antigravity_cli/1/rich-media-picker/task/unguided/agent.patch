+  <script>
+    const roastSelect = document.getElementById('roast-select');
+    if (roastSelect) {
+      const syncSelected = () => {
+        const selectedOption = roastSelect.options[roastSelect.selectedIndex];
+        const selectedContent = roastSelect.querySelector('selectedcontent');
+        if (selectedContent && selectedOption) {
+          selectedContent.innerHTML = selectedOption.innerHTML;
+        }
+      };
+      roastSelect.addEventListener('change', syncSelected);
+      // Run once on load to ensure initial state is mirrored
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', syncSelected);
+      } else {
+        syncSelected();
+      }
+    }
+  </script>
