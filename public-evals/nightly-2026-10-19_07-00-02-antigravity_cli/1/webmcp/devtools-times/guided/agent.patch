+import type { WebMCP } from 'webmcp-types';
+
+export interface WebMCPContext {
+  baseUrl: string;
+  document: Document;
+  window: Window;
+}
+
+export interface ArticleItem {
+  slug: string;
+  title: string;
+  summary: string;
+  category: string;
+  author: string;
+  date: string;
+  image: string;
+}
+
+export function createWebMCPTools(ctx: WebMCPContext): WebMCP.ModelContextTool[] {
+  const { baseUrl, document, window } = ctx;
+
+  const normalizeUrl = (path: string): string => {
+    const cleanBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+    const cleanPath = path.startsWith('/') ? path.slice(1) : path;
+    return `${cleanBase}${cleanPath}`;
+  };
+
+  // 1. search_articles
+  const searchArticlesTool: WebMCP.ModelContextTool = {
+    name: 'search_articles',
+    description:
+      'Searches published news articles by keyword and optional category filter. Use when looking for articles on a specific topic or theme.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        query: {
+          type: 'string',
+          description: 'Search keyword or phrase to match against article titles and summaries.'
+        },
+        category: {
+          type: 'string',
+          enum: [
+            'all',
+            'Business',
+            'Culture',
+            'Economy',
+            'Labor',
+            'Media',
+            'National',
+            'Pets',
+            'Politics',
+            'Urban Development',
+            'Web Development',
+            'lifestyle',
+            'news',
+            'science',
+            'sports'
+          ],
+          default: 'all',
+          description: 'Optional category filter to narrow the search results.'
+        }
+      },
+      required: ['query']
+    },
+    async execute(input: any, { signal } = {}) {
+      if (!input || typeof input.query !== 'string' || !input.query.trim()) {
+        return {
+          error: 'Missing or invalid "query" parameter. Please provide a search string.'
+        };
+      }
+
+      const query = input.query.trim().toLowerCase();
+      const category =
+        typeof input.category === 'string' && input.category.trim()
+          ? input.category.trim()
+          : 'all';
+
+      try {
+        const url = normalizeUrl('api/articles.json');
+        const res = await fetch(url, { signal });
+        if (!res.ok) {
+          return { error: `Failed to fetch articles (status ${res.status}).` };
+        }
+        const articles: ArticleItem[] = await res.json();
+
+        const filtered = articles.filter((article) => {
+          const matchesQuery =
+            (article.title && article.title.toLowerCase().includes(query)) ||
+            (article.summary && article.summary.toLowerCase().includes(query));
+
+          const matchesCategory =
+            category === 'all' ||
+            (article.category && article.category.toLowerCase() === category.toLowerCase());
+
+          return matchesQuery && matchesCategory;
+        });
+
+        return {
+          query: input.query,
+          category,
+          count: filtered.length,
+          results: filtered.map((a) => ({
+            slug: a.slug,
+            title: a.title,
+            summary: a.summary,
+            category: a.category,
+            author: a.author,
+            date: a.date,
+            url: normalizeUrl(`articles/${a.slug}`)
+          }))
+        };
+      } catch (err) {
+        if (signal?.aborted) {
+          throw err;
+        }
+        return {
+          error: err instanceof Error ? err.message : String(err)
+        };
+      }
+    },
+    annotations: {
+      readOnlyHint: true
+    }
+  };
+
+  // 2. list_categories
+  const listCategoriesTool: WebMCP.ModelContextTool = {
+    name: 'list_categories',
+    description: 'Retrieves all available article categories in the DevTools Times publication.',
+    inputSchema: {
+      type: 'object',
+      properties: {}
+    },
+    async execute(_input: any, { signal } = {}) {
+      try {
+        const res = await fetch(normalizeUrl('api/articles.json'), { signal });
+        if (!res.ok) {
+          return { error: `Failed to load categories (status ${res.status}).` };
+        }
+        const articles: ArticleItem[] = await res.json();
+        const categories = Array.from(
+          new Set(articles.map((a) => a.category).filter(Boolean))
+        ).sort();
+
+        return {
+          count: categories.length,
+          categories
+        };
+      } catch (err) {
+        if (signal?.aborted) {
+          throw err;
+        }
+        return {
+          error: err instanceof Error ? err.message : String(err)
+        };
+      }
+    },
+    annotations: {
+      readOnlyHint: true
+    }
+  };
+
+  // 3. get_article
+  const getArticleTool: WebMCP.ModelContextTool = {
+    name: 'get_article',
+    description:
+      'Retrieves metadata, summary, and details for a specific article. Use to view the contents of an article story.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'Unique slug identifier of the article (e.g., "silent-architects").'
+        }
+      },
+      required: ['slug']
+    },
+    async execute(input: any, { signal } = {}) {
+      if (!input || typeof input.slug !== 'string' || !input.slug.trim()) {
+        return {
+          error: 'Missing or invalid "slug" parameter. Please specify the article slug.'
+        };
+      }
+
+      const slug = input.slug.trim();
+
+      try {
+        const res = await fetch(
+          normalizeUrl(`api/articles.json?slug=${encodeURIComponent(slug)}`),
+          { signal }
+        );
+        if (!res.ok) {
+          return { error: `Failed to fetch article details (status ${res.status}).` };
+        }
+        const articles: ArticleItem[] = await res.json();
+        const article = articles.find((a) => a.slug === slug);
+
+        if (!article) {
+          return {
+            error: `Article with slug "${slug}" not found.`,
+            suggestion: 'Use search_articles or list_categories to discover available stories.'
+          };
+        }
+
+        return {
+          slug: article.slug,
+          title: article.title,
+          summary: article.summary,
+          category: article.category,
+          author: article.author,
+          date: article.date,
+          url: normalizeUrl(`articles/${article.slug}`),
+          image: article.image ? normalizeUrl(article.image.replace(/^\//, '')) : undefined
+        };
+      } catch (err) {
+        if (signal?.aborted) {
+          throw err;
+        }
+        return {
+          error: err instanceof Error ? err.message : String(err)
+        };
+      }
+    },
+    annotations: {
+      readOnlyHint: true
+    }
+  };
+
+  // 4. get_reading_list
+  const getReadingListTool: WebMCP.ModelContextTool = {
+    name: 'get_reading_list',
+    description:
+      "Retrieves articles saved in the user's reading list. Use to inspect bookmarked stories.",
+    inputSchema: {
+      type: 'object',
+      properties: {}
+    },
+    async execute(_input: any, { signal } = {}) {
+      try {
+        const readingListRes = await fetch(normalizeUrl('api/reading-list.json'), { signal });
+        if (!readingListRes.ok) {
+          return { error: `Failed to fetch reading list (status ${readingListRes.status}).` };
+        }
+        const { readingList }: { readingList: string[] } = await readingListRes.json();
+
+        // Also fetch articles to enrich the response with titles
+        const articlesRes = await fetch(normalizeUrl('api/articles.json'), { signal });
+        const articles: ArticleItem[] = articlesRes.ok ? await articlesRes.json() : [];
+        const articleMap = new Map(articles.map((a) => [a.slug, a]));
+
+        const savedArticles = (readingList || []).map((slug) => {
+          const item = articleMap.get(slug);
+          return {
+            slug,
+            title: item?.title ?? slug,
+            summary: item?.summary ?? '',
+            category: item?.category ?? '',
+            url: normalizeUrl(`articles/${slug}`)
+          };
+        });
+
+        return {
+          count: savedArticles.length,
+          readingList: savedArticles
+        };
+      } catch (err) {
+        if (signal?.aborted) {
+          throw err;
+        }
+        return {
+          error: err instanceof Error ? err.message : String(err)
+        };
+      }
+    },
+    annotations: {
+      readOnlyHint: true
+    }
+  };
+
+  // 5. add_to_reading_list
+  const addToReadingListTool: WebMCP.ModelContextTool = {
+    name: 'add_to_reading_list',
+    description: "Saves a news article to the user's reading list bookmark collection.",
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'Unique slug identifier of the article to add.'
+        }
+      },
+      required: ['slug']
+    },
+    async execute(input: any, { signal } = {}) {
+      if (!input || typeof input.slug !== 'string' || !input.slug.trim()) {
+        return {
+          error: 'Missing or invalid "slug" parameter. Please specify the article slug.'
+        };
+      }
+
+      const slug = input.slug.trim();
+
+      try {
+        const res = await fetch(normalizeUrl('api/reading-list.json'), {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug, action: 'add' }),
+          signal
+        });
+
+        if (!res.ok) {
+          return { error: `Failed to update reading list (status ${res.status}).` };
+        }
+
+        const data = await res.json();
+
+        if (typeof window !== 'undefined') {
+          window.dispatchEvent(
+            new CustomEvent('reading-list-updated', { detail: { readingList: data.readingList } })
+          );
+        }
+
+        return {
+          success: true,
+          action: 'added',
+          slug,
+          totalSaved: data.readingList?.length ?? 0
+        };
+      } catch (err) {
+        if (signal?.aborted) {
+          throw err;
+        }
+        return {
+          error: err instanceof Error ? err.message : String(err)
+        };
+      }
+    },
+    annotations: {
+      readOnlyHint: false
+    }
+  };
+
+  // 6. remove_from_reading_list
+  const removeFromReadingListTool: WebMCP.ModelContextTool = {
+    name: 'remove_from_reading_list',
+    description: "Removes an article from the user's reading list bookmark collection.",
+    inputSchema: {
+      type: 'object',
+      properties: {
+        slug: {
+          type: 'string',
+          description: 'Unique slug identifier of the article to remove.'
+        }
+      },
+      required: ['slug']
+    },
+    async execute(input: any, { signal } = {}) {
+      if (!input || typeof input.slug !== 'string' || !input.slug.trim()) {
+        return {
+          error: 'Missing or invalid "slug" parameter. Please specify the article slug.'
+        };
+      }
+
+      const slug = input.slug.trim();
+
+      try {
+        const res = await fetch(normalizeUrl('api/reading-list.json'), {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug, action: 'remove' }),
+          signal
+        });
+
+        if (!res.ok) {
+          return { error: `Failed to update reading list (status ${res.status}).` };
+        }
+
+        const data = await res.json();
+
+        if (typeof window !== 'undefined') {
+          window.dispatchEvent(
+            new CustomEvent('reading-list-updated', { detail: { readingList: data.readingList } })
+          );
+        }
+
+        return {
+          success: true,
+          action: 'removed',
+          slug,
+          totalSaved: data.readingList?.length ?? 0
+        };
+      } catch (err) {
+        if (signal?.aborted) {
+          throw err;
+        }
+        return {
+          error: err instanceof Error ? err.message : String(err)
+        };
+      }
+    },
+    annotations: {
+      readOnlyHint: false
+    }
+  };
+
+  // 7. navigate_to_page
+  const navigateToPageTool: WebMCP.ModelContextTool = {
+    name: 'navigate_to_page',
+    description:
+      'Navigates the browser window to an article, category page, or top-level section.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        path: {
+          type: 'string',
+          description:
+            'Target relative path in the publication (e.g., "articles/silent-architects", "category/politics", "reports", "multimedia").'
+        }
+      },
+      required: ['path']
+    },
+    execute(input: any) {
+      if (!input || typeof input.path !== 'string' || !input.path.trim()) {
+        return {
+          error: 'Missing or invalid "path" parameter. Please specify the target path.'
+        };
+      }
+
+      const rawPath = input.path.trim().replace(/^\/+/, '');
+      const targetUrl = normalizeUrl(rawPath);
+
+      if (typeof window !== 'undefined') {
+        window.location.assign(targetUrl);
+        return {
+          success: true,
+          navigatedTo: targetUrl
+        };
+      }
+
+      return {
+        success: false,
+        error: 'Window object unavailable for navigation.'
+      };
+    },
+    annotations: {
+      readOnlyHint: false
+    }
+  };
+
+  // 8. get_current_article
+  const getCurrentArticleTool: WebMCP.ModelContextTool = {
+    name: 'get_current_article',
+    description: 'Retrieves details of the news article currently displayed on the active page.',
+    inputSchema: {
+      type: 'object',
+      properties: {}
+    },
+    execute() {
+      if (typeof document === 'undefined') {
+        return { error: 'Document context unavailable.' };
+      }
+
+      const articleEl = document.querySelector('article');
+      if (!articleEl) {
+        return {
+          error: 'Not currently viewing an article page.',
+          currentPath: typeof window !== 'undefined' ? window.location.pathname : ''
+        };
+      }
+
+      const title = articleEl.querySelector('h1')?.textContent?.trim() || '';
+      const summary = articleEl.querySelector('p.text-lg')?.textContent?.trim() || '';
+      const authorText =
+        articleEl.querySelector('.text-sm.text-gray-500')?.textContent?.trim() || '';
+      const bodyText = articleEl.querySelector('.prose')?.textContent?.trim() || '';
+
+      return {
+        title,
+        summary,
+        meta: authorText,
+        contentExcerpt: bodyText.slice(0, 1000)
+      };
+    },
+    annotations: {
+      readOnlyHint: true
+    }
+  };
+
+  return [
+    searchArticlesTool,
+    listCategoriesTool,
+    getArticleTool,
+    getReadingListTool,
+    addToReadingListTool,
+    removeFromReadingListTool,
+    navigateToPageTool,
+    getCurrentArticleTool
+  ];
+}
