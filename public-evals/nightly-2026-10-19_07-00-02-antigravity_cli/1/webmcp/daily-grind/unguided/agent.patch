+    assert.equal(addRes1.addedItem.name, 'Nitro Cold Brew');
+    assert.equal(addRes1.cartSummary.itemCount, 2);
+
+    // Add second item with extra espresso shot
+    const addRes2 = await context.executeTool('add_to_cart', {
