+/**
+ * The Daily Grind Coffee Co. - Product & Store Data Catalog
+ */
+
+(function (global) {
+  'use strict';
+
+  const MENU_ITEMS = [
+    {
+      id: 'maple-oat-latte',
+      name: 'Maple Oat Latte',
+      category: 'seasonal',
+      price: 5.75,
+      description: 'Creamy oat milk with a hint of Vermont maple syrup and double espresso.',
+      calories: 220,
+      caffeineMg: 150,
+      tags: ['vegan', 'dairy_free', 'seasonal'],
+      image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=80',
+      customizable: true,
+      customizations: {
+        sizes: [
+          { id: 'small', label: '12 oz (Small)', modifier: 0 },
+          { id: 'medium', label: '16 oz (Medium)', modifier: 0.50 },
+          { id: 'large', label: '20 oz (Large)', modifier: 0.90 }
+        ],
+        milks: ['oat', 'almond', 'whole', 'skim'],
+        syrups: ['maple', 'vanilla', 'caramel', 'cinnamon'],
+        extraShotsMax: 3
+      }
+    },
+    {
+      id: 'pumpkin-cold-foam',
+      name: 'Spiced Pumpkin Cold Foam Brew',
+      category: 'seasonal',
+      price: 5.95,
+      description: 'Slow-steeped cold brew topped with velvety pumpkin spice cold foam.',
+      calories: 190,
+      caffeineMg: 200,
+      tags: ['seasonal', 'vegetarian'],
+      image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=600&q=80',
+      customizable: true,
+      customizations: {
+        sizes: [
+          { id: 'small', label: '12 oz', modifier: 0 },
+          { id: 'medium', label: '16 oz', modifier: 0.50 },
