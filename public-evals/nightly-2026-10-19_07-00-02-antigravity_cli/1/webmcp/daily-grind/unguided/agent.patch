+    assert.equal(item.id, 'maple-oat-latte');
+    assert.equal(item.name, 'Maple Oat Latte');
+    assert.ok(item.price > 0);
+    assert.ok(Array.isArray(item.tags));
+    assert.ok(Array.isArray(item.customizationOptions?.milks));
+
+    await assert.rejects(
+      () => context.executeTool('get_item_details', { itemId: 'non-existent-beverage' }),
+      /not found/
+    );
+  });
+
+  test('tool: filter_menu_in_ui updates store UI state', async () => {
+    const filterResult = await context.executeTool('filter_menu_in_ui', {
+      category: 'cold_brew',
