+const { test, describe, beforeEach } = require('node:test');
+const assert = require('node:assert/strict');
+
+const { ModelContext, ToolActivatedEvent, ToolCancelEvent } = require('../js/webmcp.js');
+const { MENU_ITEMS, LOCATIONS, REWARDS_PROFILE } = require('../js/coffee-data.js');
+const { CoffeeStore, registerCoffeeTools } = require('../js/app.js');
+
+describe('WebMCP Core Specification Tests', () => {
+  let context;
+
+  beforeEach(() => {
+    context = new ModelContext();
+  });
+
+  test('registers tool and discovers it via getTools()', async () => {
+    await context.registerTool({
+      name: 'echo_message',
+      title: 'Echo Message',
+      description: 'Echo back an input text string.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          message: { type: 'string' },
+        },
+        required: ['message'],
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async ({ message }) => ({ echo: message }),
+    });
+
+    const tools = await context.getTools();
+    assert.equal(tools.length, 1);
+    assert.equal(tools[0].name, 'echo_message');
+    assert.equal(tools[0].title, 'Echo Message');
+    assert.equal(tools[0].description, 'Echo back an input text string.');
+    assert.deepEqual(tools[0].annotations, { readOnlyHint: true });
+  });
+
+  test('validates tool registration parameters', async () => {
+    // Non-object
+    await assert.rejects(
+      () => context.registerTool(null),
+      { name: 'TypeError' }
+    );
+
+    // Invalid tool names
+    await assert.rejects(
+      () => context.registerTool({ name: '', execute: () => {} }),
+      /Tool name must be a non-empty string/
+    );
+    await assert.rejects(
+      () => context.registerTool({ name: 'invalid tool name with spaces', execute: () => {} }),
+      /must only contain/
+    );
+    await assert.rejects(
+      () => context.registerTool({ name: 'a'.repeat(129), execute: () => {} }),
+      /must not exceed 128 characters/
+    );
+
+    // Invalid description
+    await assert.rejects(
+      () => context.registerTool({ name: 'test_tool', description: 123, execute: () => {} }),
+      /must be a string/
+    );
+    await assert.rejects(
+      () => context.registerTool({ name: 'test_tool', description: 'a'.repeat(1025), execute: () => {} }),
+      /must not exceed 1024 characters/
+    );
+
+    // Missing execute function
+    await assert.rejects(
+      () => context.registerTool({ name: 'no_execute', description: 'desc' }),
+      /must provide an execute function/
+    );
+
+    // Duplicate registration without overwrite
+    await context.registerTool({
+      name: 'dup_tool',
+      description: 'First definition',
+      execute: () => 'ok',
+    });
+    await assert.rejects(
+      () => context.registerTool({
+        name: 'dup_tool',
+        description: 'Second definition',
+        execute: () => 'fail',
+      }),
+      /already registered/
+    );
+  });
+
+  test('supports tool unregistration directly and via AbortSignal', async () => {
+    const controller = new AbortController();
+
+    await context.registerTool({
+      name: 'temp_tool',
+      description: 'Temporary tool',
+      execute: () => 'done',
+    }, { signal: controller.signal });
+
+    let tools = await context.getTools();
+    assert.equal(tools.length, 1);
+
+    // Abort signal triggers unregister
+    controller.abort();
+    tools = await context.getTools();
+    assert.equal(tools.length, 0);
+
+    // Direct unregisterTool
+    await context.registerTool({
+      name: 'temp_tool_2',
+      description: 'Temporary tool 2',
+      execute: () => 'done',
+    });
+    assert.equal(context.hasTool('temp_tool_2'), true);
+    context.unregisterTool('temp_tool_2');
+    assert.equal(context.hasTool('temp_tool_2'), false);
+  });
+
+  test('executes tool with arguments and dispatches toolactivated event', async () => {
+    let activatedEventReceived = null;
+    context.addEventListener('toolactivated', (e) => {
+      activatedEventReceived = e;
+    });
+
+    await context.registerTool({
+      name: 'calculate_tax',
+      description: 'Calculate sales tax for an amount',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          subtotal: { type: 'number' },
+          rate: { type: 'number' },
+        },
+        required: ['subtotal'],
+      },
+      execute: async ({ subtotal, rate = 0.0825 }) => {
+        return { tax: Number((subtotal * rate).toFixed(2)) };
+      },
+    });
+
+    const result = await context.executeTool('calculate_tax', { subtotal: 100, rate: 0.1 });
+    assert.deepEqual(result, { tax: 10.0 });
+    assert.ok(activatedEventReceived instanceof ToolActivatedEvent);
+    assert.equal(activatedEventReceived.toolName, 'calculate_tax');
+  });
+
+  test('handles tool execution cancellation with AbortSignal and fires toolcancel event', async () => {
+    let cancelEventReceived = null;
+    context.addEventListener('toolcancel', (e) => {
+      cancelEventReceived = e;
+    });
+
+    await context.registerTool({
+      name: 'slow_task',
+      description: 'Simulates a slow async task',
+      execute: async (args, { signal }) => {
+        return new Promise((resolve, reject) => {
+          const timer = setTimeout(() => resolve('done'), 500);
+          if (signal) {
+            signal.addEventListener('abort', () => {
+              clearTimeout(timer);
+              const err = new Error('Task was cancelled');
+              err.name = 'AbortError';
+              reject(err);
+            });
+          }
+        });
+      },
+    });
+
+    const abortController = new AbortController();
+    const executePromise = context.executeTool('slow_task', {}, { signal: abortController.signal });
+
+    // Cancel after 10ms
+    setTimeout(() => abortController.abort(), 10);
+
+    await assert.rejects(executePromise, { name: 'AbortError' });
+    assert.ok(cancelEventReceived instanceof ToolCancelEvent);
+    assert.equal(cancelEventReceived.toolName, 'slow_task');
+  });
+
+  test('dispatches toolchange event on register and unregister', async () => {
+    let changeCount = 0;
+    context.addEventListener('toolchange', () => {
+      changeCount++;
+    });
+
+    await context.registerTool({
+      name: 'test_a',
+      description: 'tool A',
+      execute: () => 'A',
+    });
+
+    // toolchange is dispatched on microtask
+    await new Promise((resolve) => setTimeout(resolve, 10));
+    assert.equal(changeCount, 1);
+
+    context.unregisterTool('test_a');
+    await new Promise((resolve) => setTimeout(resolve, 10));
+    assert.equal(changeCount, 2);
+  });
+});
+
+describe('Coffee Store WebMCP Application Integration', () => {
+  let context;
+  let store;
+
+  beforeEach(async () => {
+    context = new ModelContext();
+    store = new CoffeeStore({ MENU_ITEMS, LOCATIONS, REWARDS_PROFILE });
+    await registerCoffeeTools(context, store);
+  });
+
+  test('registers all 12 core coffee shop WebMCP tools', async () => {
+    const tools = await context.getTools();
+    const toolNames = tools.map((t) => t.name);
+
+    const expectedTools = [
+      'get_menu',
+      'search_menu',
+      'get_item_details',
+      'filter_menu_in_ui',
+      'add_to_cart',
+      'get_cart',
+      'update_cart_item',
+      'clear_cart',
+      'get_rewards_balance',
+      'apply_reward',
