+    assert.ok(queryResult.items[0].name.toLowerCase().includes('maple'));
+
+    const priceResult = await context.executeTool('search_menu', { maxPrice: 5.0 });
+    assert.ok(priceResult.items.every((i) => i.price <= 5.0));
+
+    const veganResult = await context.executeTool('search_menu', { dietary: 'vegan' });
