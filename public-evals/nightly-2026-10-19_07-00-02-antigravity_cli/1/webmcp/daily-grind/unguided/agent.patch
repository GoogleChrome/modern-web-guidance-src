+    assert.equal(tools.length, 12);
+  });
+
+  test('tool: get_menu retrieves all or filtered menu items', async () => {
+    const allResult = await context.executeTool('get_menu', {});
+    assert.ok(allResult.count > 0);
+    assert.equal(allResult.category, 'all');
+
+    const espressoResult = await context.executeTool('get_menu', { category: 'espresso' });
+    assert.ok(espressoResult.count > 0);
+    assert.ok(espressoResult.items.every((i) => i.category === 'espresso'));
+  });
+
+  test('tool: search_menu filters by query, maxPrice, and dietary tag', async () => {
+    const queryResult = await context.executeTool('search_menu', { query: 'maple' });
