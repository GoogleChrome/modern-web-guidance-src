+    assert.equal(filterResult.searchQuery, 'nitro');
+    assert.equal(store.activeCategory, 'cold_brew');
+  });
+
+  test('tool: add_to_cart, get_cart, update_cart_item, and clear_cart', async () => {
+    // Add first item
