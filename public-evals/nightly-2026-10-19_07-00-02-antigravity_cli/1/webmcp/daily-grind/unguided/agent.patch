+/**
+ * The Daily Grind Coffee Co. - Application Logic & WebMCP Integration
+ */
+
+(function (global) {
+  'use strict';
+
+  // Coffee Store State
+  class CoffeeStore {
+    constructor(data) {
+      this.menuItems = [...(data?.MENU_ITEMS || [])];
+      this.locations = [...(data?.LOCATIONS || [])];
+      this.rewards = JSON.parse(JSON.stringify(data?.REWARDS_PROFILE || { stars: 0, availableRewards: [] }));
+      this.cart = [];
+      this.appliedReward = null;
+      this.activeCategory = 'all';
+      this.searchQuery = '';
+      this.lastOrder = null;
+      this.eventLogs = [];
+    }
+
+    // --- Menu Methods ---
+    getMenu(category = 'all') {
+      if (!category || category === 'all') {
+        return [...this.menuItems];
+      }
+      return this.menuItems.filter((item) => item.category === category);
+    }
+
+    searchMenu({ query = '', maxPrice = null, dietary = null } = {}) {
+      const q = (query || '').toLowerCase().trim();
+      return this.menuItems.filter((item) => {
+        const matchesQuery =
+          !q ||
+          item.name.toLowerCase().includes(q) ||
+          item.description.toLowerCase().includes(q) ||
+          item.category.toLowerCase().includes(q);
+
+        const matchesPrice = maxPrice === null || maxPrice === undefined || item.price <= maxPrice;
+
+        const matchesDietary =
+          !dietary ||
+          (item.tags && item.tags.includes(dietary.toLowerCase().replace('-', '_')));
+
+        return matchesQuery && matchesPrice && matchesDietary;
+      });
+    }
+
+    getItemDetails(itemId) {
+      const item = this.menuItems.find((i) => i.id === itemId);
+      if (!item) return null;
+      return JSON.parse(JSON.stringify(item));
+    }
+
+    filterMenuInUI(category = 'all', query = '') {
+      this.activeCategory = category || 'all';
+      this.searchQuery = query || '';
+      if (typeof window !== 'undefined' && window.updateMenuUI) {
+        window.updateMenuUI();
+      }
+      const filtered = this.searchMenu({
+        query: this.searchQuery,
+        dietary: this.activeCategory !== 'all' ? this.activeCategory : null,
+      });
+      return {
+        activeCategory: this.activeCategory,
+        searchQuery: this.searchQuery,
+        resultCount: filtered.length,
+        items: filtered.map((i) => ({ id: i.id, name: i.name, price: i.price })),
+      };
+    }
+
+    // --- Cart Methods ---
+    addToCart(itemId, quantity = 1, customizations = {}) {
+      const item = this.getItemDetails(itemId);
+      if (!item) {
+        throw new Error(`Menu item '${itemId}' not found.`);
+      }
+      if (quantity <= 0) {
+        throw new Error('Quantity must be greater than zero.');
+      }
+
+      let unitPrice = item.price;
+      if (customizations?.size === 'medium') unitPrice += 0.50;
+      if (customizations?.size === 'large') unitPrice += 0.90;
+      if (customizations?.extraShots) unitPrice += Number(customizations.extraShots) * 0.85;
+
+      const cartItemId = `cart_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`;
+      const cartEntry = {
+        cartItemId,
+        itemId: item.id,
+        name: item.name,
+        unitPrice: Number(unitPrice.toFixed(2)),
+        quantity: Number(quantity),
+        customizations: { ...customizations },
+        totalPrice: Number((unitPrice * quantity).toFixed(2)),
+      };
+
+      this.cart.push(cartEntry);
+      if (typeof window !== 'undefined' && window.updateCartUI) {
+        window.updateCartUI();
+      }
+
+      return {
+        success: true,
+        addedItem: cartEntry,
+        cartSummary: this.getCart(),
+      };
+    }
+
+    getCart() {
+      const subtotal = this.cart.reduce((sum, item) => sum + item.totalPrice, 0);
+      let discount = 0;
+
+      if (this.appliedReward) {
+        if (this.appliedReward.discountAmount) {
+          discount = Math.min(this.appliedReward.discountAmount, subtotal);
+        } else if (this.appliedReward.discountPercent) {
+          discount = subtotal * (this.appliedReward.discountPercent / 100);
+        }
+      }
+
+      const taxableAmount = Math.max(0, subtotal - discount);
+      const estimatedTax = Number((taxableAmount * 0.085).toFixed(2));
+      const total = Number((taxableAmount + estimatedTax).toFixed(2));
+
+      return {
+        items: [...this.cart],
+        itemCount: this.cart.reduce((sum, item) => sum + item.quantity, 0),
+        subtotal: Number(subtotal.toFixed(2)),
+        appliedReward: this.appliedReward ? { ...this.appliedReward } : null,
+        discount: Number(discount.toFixed(2)),
+        estimatedTax,
+        total,
+      };
+    }
+
+    updateCartItem(cartItemId, quantity) {
+      const index = this.cart.findIndex((i) => i.cartItemId === cartItemId);
+      if (index === -1) {
+        throw new Error(`Cart item '${cartItemId}' not found.`);
+      }
+
+      if (quantity <= 0) {
+        const removed = this.cart.splice(index, 1)[0];
+        if (typeof window !== 'undefined' && window.updateCartUI) window.updateCartUI();
+        return { success: true, removedItem: removed, cartSummary: this.getCart() };
+      }
+
+      this.cart[index].quantity = quantity;
+      this.cart[index].totalPrice = Number((this.cart[index].unitPrice * quantity).toFixed(2));
+      if (typeof window !== 'undefined' && window.updateCartUI) window.updateCartUI();
+
+      return { success: true, updatedItem: this.cart[index], cartSummary: this.getCart() };
+    }
+
+    clearCart() {
+      this.cart = [];
+      this.appliedReward = null;
+      if (typeof window !== 'undefined' && window.updateCartUI) window.updateCartUI();
+      return { success: true, message: 'Cart cleared successfully.' };
+    }
+
+    // --- Rewards Methods ---
+    getRewardsBalance() {
+      return {
+        customerName: this.rewards.customerName,
+        tier: this.rewards.tier,
+        stars: this.rewards.stars,
+        availableRewards: [...this.rewards.availableRewards],
+        appliedReward: this.appliedReward,
+      };
+    }
+
+    applyReward(rewardId) {
+      const reward = this.rewards.availableRewards.find((r) => r.id === rewardId);
+      if (!reward) {
+        throw new Error(`Reward with ID '${rewardId}' not found.`);
+      }
+      if (this.rewards.stars < reward.starCost) {
+        throw new Error(`Insufficient stars. You have ${this.rewards.stars} stars, but ${reward.starCost} are required.`);
+      }
+
+      this.appliedReward = { ...reward };
+      if (typeof window !== 'undefined' && window.updateCartUI) window.updateCartUI();
+
+      return {
+        success: true,
+        message: `Applied reward: ${reward.name}`,
+        reward,
+        cartSummary: this.getCart(),
+      };
+    }
+
+    // --- Order & Checkout Methods ---
+    checkout({
+      customerName = 'Jordan Miller',
+      orderType = 'pickup',
+      locationId = 'loc-downtown',
+      deliveryAddress = '',
+      specialInstructions = '',
+    } = {}) {
+      if (this.cart.length === 0) {
+        throw new Error('Cannot checkout with an empty cart.');
+      }
+      if (orderType === 'delivery' && !deliveryAddress.trim()) {
+        throw new Error('A delivery address is required for delivery orders.');
+      }
+
+      const cartSummary = this.getCart();
+      const orderId = `ORD-${Date.now().toString().slice(-6)}`;
+      const orderDate = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
+
+      // Deduct reward stars if used
+      if (this.appliedReward) {
+        this.rewards.stars = Math.max(0, this.rewards.stars - this.appliedReward.starCost);
+      }
+      // Earn 2 stars per dollar spent
+      const earnedStars = Math.floor(cartSummary.total * 2);
+      this.rewards.stars += earnedStars;
+
+      const order = {
+        orderId,
+        orderDate,
+        customerName,
+        orderType,
+        locationId,
+        deliveryAddress: orderType === 'delivery' ? deliveryAddress : null,
+        specialInstructions,
+        items: [...this.cart],
+        subtotal: cartSummary.subtotal,
+        discount: cartSummary.discount,
+        tax: cartSummary.estimatedTax,
+        total: cartSummary.total,
+        earnedStars,
+        estimatedTimeMinutes: orderType === 'pickup' ? 10 : 25,
+      };
+
+      this.lastOrder = order;
+      this.cart = [];
+      this.appliedReward = null;
+
+      if (typeof window !== 'undefined') {
+        if (window.updateCartUI) window.updateCartUI();
+        if (window.showOrderConfirmationUI) window.showOrderConfirmationUI(order);
+      }
+
+      return {
+        success: true,
+        message: `Order #${order.orderId} placed successfully!`,
+        order,
+      };
+    }
+
+    // --- Store Locations ---
+    getLocations(zipCode = '') {
+      if (!zipCode) return [...this.locations];
+      const match = this.locations.filter((loc) => loc.zipCode === zipCode);
+      return match.length > 0 ? match : [...this.locations];
+    }
+
+    logEvent(name, detail) {
+      this.eventLogs.unshift({
+        time: new Date().toLocaleTimeString(),
+        name,
+        detail,
+      });
+      if (this.eventLogs.length > 20) this.eventLogs.pop();
+      if (typeof window !== 'undefined' && window.updateEventLogsUI) {
+        window.updateEventLogsUI();
+      }
+    }
+  }
+
+  // Register WebMCP Tools
+  async function registerCoffeeTools(modelContext, store) {
+    if (!modelContext || typeof modelContext.registerTool !== 'function') {
+      console.warn('[WebMCP] ModelContext not available for registering tools.');
+      return;
+    }
+
+    // Tool 1: get_menu
+    await modelContext.registerTool({
+      name: 'get_menu',
+      title: 'Get Menu Catalog',
+      description: 'Retrieve the coffee shop menu items, with optional category filtering (all, seasonal, espresso, cold_brew, tea, bakery).',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          category: {
+            type: 'string',
+            enum: ['all', 'seasonal', 'espresso', 'cold_brew', 'tea', 'bakery'],
+            description: 'Filter items by menu category',
+          },
+        },
+      },
+      annotations: {
+        readOnlyHint: true,
+        consequentialHint: false,
+      },
+      execute: async ({ category = 'all' } = {}) => {
+        store.logEvent('tool_call:get_menu', { category });
+        const items = store.getMenu(category);
+        return {
+          category,
+          count: items.length,
+          items: items.map((i) => ({
+            id: i.id,
+            name: i.name,
+            category: i.category,
+            price: i.price,
+            description: i.description,
+            caffeineMg: i.caffeineMg,
+            tags: i.tags,
+            image: i.image,
+          })),
+        };
+      },
+    });
+
+    // Tool 2: search_menu
+    await modelContext.registerTool({
+      name: 'search_menu',
+      title: 'Search Menu',
+      description: 'Search for drinks and pastries by keyword (e.g. "oat", "latte", "croissant"), max price, or dietary preferences (vegan, gluten_free, dairy_free).',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: {
+            type: 'string',
+            description: 'Search keyword or ingredient',
+          },
+          maxPrice: {
+            type: 'number',
+            description: 'Maximum price in USD',
+          },
+          dietary: {
+            type: 'string',
+            enum: ['vegan', 'gluten_free', 'dairy_free', 'vegetarian'],
+            description: 'Dietary restriction tag',
+          },
+        },
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async (params = {}) => {
+        store.logEvent('tool_call:search_menu', params);
+        const results = store.searchMenu(params);
+        return {
+          query: params.query || '',
+          count: results.length,
+          results: results.map((i) => ({
+            id: i.id,
+            name: i.name,
+            category: i.category,
+            price: i.price,
+            description: i.description,
+            tags: i.tags,
+          })),
+        };
+      },
+    });
+
+    // Tool 3: get_item_details
+    await modelContext.registerTool({
+      name: 'get_item_details',
+      title: 'Get Item Details',
+      description: 'Get complete recipe details and customization options (sizes, milks, syrups, extra shots) for a specific item.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          itemId: {
+            type: 'string',
+            description: 'The unique ID of the menu item (e.g. "maple-oat-latte")',
+          },
+        },
+        required: ['itemId'],
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async ({ itemId }) => {
+        store.logEvent('tool_call:get_item_details', { itemId });
+        const item = store.getItemDetails(itemId);
+        if (!item) {
+          throw new Error(`Menu item '${itemId}' was not found.`);
+        }
+        return item;
+      },
+    });
+
+    // Tool 4: filter_menu_in_ui
+    await modelContext.registerTool({
+      name: 'filter_menu_in_ui',
+      title: 'Filter Menu in UI',
+      description: 'Controls the live webpage menu grid, filtering items by category or keyword so the customer sees the matching items highlighted on screen.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          category: {
+            type: 'string',
+            enum: ['all', 'seasonal', 'espresso', 'cold_brew', 'tea', 'bakery'],
+            description: 'Category tab to activate',
+          },
+          query: {
+            type: 'string',
+            description: 'Search string to filter visually in the UI',
+          },
+        },
+      },
+      annotations: {
+        readOnlyHint: false,
+      },
+      execute: async ({ category = 'all', query = '' } = {}) => {
+        store.logEvent('tool_call:filter_menu_in_ui', { category, query });
+        return store.filterMenuInUI(category, query);
+      },
+    });
+
+    // Tool 5: add_to_cart
+    await modelContext.registerTool({
+      name: 'add_to_cart',
+      title: 'Add to Cart',
+      description: 'Add a coffee, drink, or bakery item to the customer cart with optional customizations, updating the cart UI in real-time.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          itemId: {
+            type: 'string',
+            description: 'Item ID (e.g. "maple-oat-latte", "dark-roast-espresso")',
+          },
+          quantity: {
+            type: 'integer',
+            minimum: 1,
+            default: 1,
+            description: 'Number of items to add',
+          },
+          customizations: {
+            type: 'object',
+            properties: {
+              size: { type: 'string', enum: ['small', 'medium', 'large'] },
+              milk: { type: 'string', enum: ['oat', 'almond', 'whole', 'skim', 'none'] },
+              extraShots: { type: 'integer', minimum: 0, maximum: 4 },
+              syrup: { type: 'string', enum: ['maple', 'vanilla', 'caramel', 'cinnamon'] },
+              ice: { type: 'string', enum: ['none', 'light', 'regular', 'extra'] },
+            },
+            description: 'Drink preparation preferences',
+          },
+        },
+        required: ['itemId'],
+      },
+      annotations: {
+        consequentialHint: false,
+      },
+      execute: async ({ itemId, quantity = 1, customizations = {} }) => {
+        store.logEvent('tool_call:add_to_cart', { itemId, quantity, customizations });
+        return store.addToCart(itemId, quantity, customizations);
+      },
+    });
+
+    // Tool 6: get_cart
+    await modelContext.registerTool({
+      name: 'get_cart',
+      title: 'Get Current Cart',
+      description: 'Inspect the current contents of the customer cart, including items, quantities, subtotal, discounts, tax, and final total.',
+      inputSchema: {
+        type: 'object',
+        properties: {},
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async () => {
+        store.logEvent('tool_call:get_cart', {});
+        return store.getCart();
+      },
+    });
+
+    // Tool 7: update_cart_item
+    await modelContext.registerTool({
+      name: 'update_cart_item',
+      title: 'Update Cart Item',
+      description: 'Update the quantity of an item in the cart, or remove it by setting quantity to 0.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          cartItemId: {
+            type: 'string',
+            description: 'The cart item ID to update',
+          },
+          quantity: {
+            type: 'integer',
+            minimum: 0,
+            description: 'The updated quantity (set to 0 to remove)',
+          },
+        },
+        required: ['cartItemId', 'quantity'],
+      },
+      execute: async ({ cartItemId, quantity }) => {
+        store.logEvent('tool_call:update_cart_item', { cartItemId, quantity });
+        return store.updateCartItem(cartItemId, quantity);
+      },
+    });
+
+    // Tool 8: clear_cart
+    await modelContext.registerTool({
+      name: 'clear_cart',
+      title: 'Clear Cart',
+      description: 'Remove all items from the customer cart.',
+      inputSchema: {
+        type: 'object',
+        properties: {},
+      },
+      execute: async () => {
+        store.logEvent('tool_call:clear_cart', {});
+        return store.clearCart();
+      },
+    });
+
+    // Tool 9: get_rewards_balance
+    await modelContext.registerTool({
+      name: 'get_rewards_balance',
+      title: 'Get Loyalty Rewards',
+      description: 'Retrieve the customer loyalty rewards status, star balance, and list of available redeemable rewards.',
+      inputSchema: {
+        type: 'object',
+        properties: {},
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async () => {
+        store.logEvent('tool_call:get_rewards_balance', {});
+        return store.getRewardsBalance();
+      },
+    });
+
+    // Tool 10: apply_reward
+    await modelContext.registerTool({
+      name: 'apply_reward',
+      title: 'Apply Loyalty Reward',
+      description: 'Apply an eligible loyalty reward coupon to the cart for a discount.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          rewardId: {
+            type: 'string',
+            description: 'The reward ID (e.g. "rew_pastry", "rew_free_shot", "rew_discount_20")',
+          },
+        },
+        required: ['rewardId'],
+      },
+      execute: async ({ rewardId }) => {
+        store.logEvent('tool_call:apply_reward', { rewardId });
+        return store.applyReward(rewardId);
+      },
+    });
+
+    // Tool 11: checkout
+    await modelContext.registerTool({
+      name: 'checkout',
+      title: 'Place Order / Checkout',
+      description: 'Finalize and place the order for items currently in the cart, specifying pickup or delivery. Updates the UI with order confirmation.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          customerName: {
+            type: 'string',
+            description: 'Name for the order pickup/delivery',
+          },
+          orderType: {
+            type: 'string',
+            enum: ['pickup', 'delivery'],
+            description: 'Pickup in store or local courier delivery',
+          },
+          locationId: {
+            type: 'string',
+            description: 'Store location ID (e.g. "loc-downtown")',
+          },
+          deliveryAddress: {
+            type: 'string',
+            description: 'Delivery street address (required if orderType is delivery)',
+          },
+          specialInstructions: {
+            type: 'string',
+            description: 'Barista notes or delivery directions',
+          },
+        },
+        required: ['customerName', 'orderType'],
+      },
+      annotations: {
+        consequentialHint: true,
+      },
+      execute: async (checkoutDetails) => {
+        store.logEvent('tool_call:checkout', checkoutDetails);
+        return store.checkout(checkoutDetails);
+      },
+    });
+
+    // Tool 12: get_locations
+    await modelContext.registerTool({
+      name: 'get_locations',
+      title: 'Get Store Locations',
+      description: 'List coffee shop store locations, operating hours, addresses, phone numbers, and amenities.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          zipCode: {
+            type: 'string',
+            description: 'Optional 5-digit zip code to filter locations',
+          },
+        },
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async ({ zipCode = '' } = {}) => {
+        store.logEvent('tool_call:get_locations', { zipCode });
+        const locs = store.getLocations(zipCode);
+        return {
+          count: locs.length,
+          locations: locs,
+        };
+      },
+    });
+
+    // Listen to WebMCP tool execution events for observability
+    modelContext.addEventListener('toolactivated', (e) => {
+      store.logEvent('event:toolactivated', { toolName: e.toolName });
+    });
+
+    modelContext.addEventListener('toolcancel', (e) => {
+      store.logEvent('event:toolcancel', { toolName: e.toolName });
+    });
+
+    modelContext.addEventListener('toolchange', () => {
+      store.logEvent('event:toolchange', { totalRegistered: 'updated' });
+      if (typeof window !== 'undefined' && window.updateInspectorUI) {
+        window.updateInspectorUI();
+      }
+    });
+  }
+
+  // Exports for Node / Test environments
+  if (typeof module !== 'undefined' && module.exports) {
+    module.exports = {
+      CoffeeStore,
+      registerCoffeeTools,
+    };
+  } else {
+    global.CoffeeStore = CoffeeStore;
+    global.registerCoffeeTools = registerCoffeeTools;
+  }
+})(typeof globalThis !== 'undefined' ? globalThis : this);
