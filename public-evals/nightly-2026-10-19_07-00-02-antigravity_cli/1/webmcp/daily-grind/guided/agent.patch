+        appliedPromo: null,
+        subtotal: 0,
+        discount: 0,
+        tax: 0,
+        total: 0,
+        itemCount: 0
+      };
+      this.rewards = {
+        accountName: 'Valued Coffee Lover',
+        tier: 'Gold Bean',
+        points: 340,
+        pointsToNextFreeDrink: 60,
+        activePerks: ['Free size upgrade on espresso drinks', '10% off beans every Tuesday']
