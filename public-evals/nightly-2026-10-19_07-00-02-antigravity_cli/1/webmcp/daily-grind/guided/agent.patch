+        appliedPromo: this.cart.appliedPromo,
+        subtotal: this.cart.subtotal,
+        discount: this.cart.discount,
+        tax: this.cart.tax,
+        total: this.cart.total,
+        itemCount: this.cart.itemCount
+      };
+    }
+
+    addToCart({ itemId, quantity = 1, size = 'medium', milk = 'none' }) {
