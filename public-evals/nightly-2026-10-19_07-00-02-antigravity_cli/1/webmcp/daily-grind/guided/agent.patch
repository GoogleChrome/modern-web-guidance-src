+
+    _recalculateCart() {
+      let subtotal = 0;
+      let itemCount = 0;
+
+      for (const item of this.cart.items) {
+        subtotal += item.price * item.quantity;
+        itemCount += item.quantity;
+      }
+
+      let discount = 0;
+      if (this.cart.appliedPromo) {
+        const promo = PROMO_CODES[this.cart.appliedPromo];
+        if (promo) {
+          if (promo.discountPercent) {
+            discount = subtotal * (promo.discountPercent / 100);
+          } else if (promo.fixedDiscount) {
+            discount = Math.min(subtotal, promo.fixedDiscount);
+          }
+        }
+      }
+
+      const taxableAmount = Math.max(0, subtotal - discount);
+      const tax = Math.round(taxableAmount * 0.0875 * 100) / 100;
+      const total = Math.round((taxableAmount + tax) * 100) / 100;
+
+      this.cart.subtotal = Math.round(subtotal * 100) / 100;
+      this.cart.discount = Math.round(discount * 100) / 100;
+      this.cart.tax = tax;
+      this.cart.total = total;
+      this.cart.itemCount = itemCount;
