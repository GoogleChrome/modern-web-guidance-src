+        if (signal?.aborted) {
+          const err = new Error('Execution aborted');
+          err.name = 'AbortError';
+          throw err;
+        }
+        return store.getCart();
+      },
+      annotations: {
+        readOnlyHint: true
+      }
+    }, { signal: registrationSignal });
+
