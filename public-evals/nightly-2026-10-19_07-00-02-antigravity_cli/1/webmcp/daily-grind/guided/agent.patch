+      const qty = Math.max(1, parseInt(quantity, 10) || 1);
+      const resolvedSize = item.sizes.includes(size) ? size : (item.sizes[0] || 'standard');
+      const resolvedMilk = item.milks.includes(milk) ? milk : (item.milks[0] || 'none');
+
+      // Price adjustment for size
+      let unitPrice = item.price;
+      if (resolvedSize === 'large') unitPrice += 0.75;
+      if (resolvedSize === 'small') unitPrice = Math.max(1.0, unitPrice - 0.50);
+      if (resolvedMilk === 'oat' || resolvedMilk === 'almond') unitPrice += 0.50;
+
+      unitPrice = Math.round(unitPrice * 100) / 100;
+
+      // Check if matching item configuration already exists in cart
+      const existing = this.cart.items.find(cartItem =>
+        cartItem.itemId === item.id &&
+        cartItem.size === resolvedSize &&
+        cartItem.milk === resolvedMilk
+      );
+
+      if (existing) {
+        existing.quantity += qty;
+        existing.itemTotal = Math.round(existing.quantity * unitPrice * 100) / 100;
+      } else {
+        const cartItemId = `cart-item-${this._cartCounter++}`;
+        this.cart.items.push({
+          cartItemId,
+          itemId: item.id,
+          name: item.name,
+          category: item.category,
+          size: resolvedSize,
+          milk: resolvedMilk,
+          price: unitPrice,
+          quantity: qty,
+          itemTotal: Math.round(unitPrice * qty * 100) / 100
+        });
+      }
+
+      this._recalculateCart();
+
+      return {
+        success: true,
+        message: `Added ${qty}x ${item.name} (${resolvedSize}) to cart.`,
+        cart: this.getCart()
+      };
+    }
+
+    removeFromCart(cartItemId) {
+      const index = this.cart.items.findIndex(item => item.cartItemId === cartItemId);
+      if (index === -1) {
