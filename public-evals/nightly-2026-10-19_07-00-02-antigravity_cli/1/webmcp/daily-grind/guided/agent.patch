+/**
+ * The Daily Grind - Client-side UI Application & Declarative Form Handlers
+ */
+(function () {
+  'use strict';
+
+  const store = window.DailyGrind?.store;
+  if (!store) {
+    console.error('Store not found');
+    return;
+  }
+
+  // Register Imperative WebMCP Tools
+  if (window.WebMCPTools?.registerDailyGrindTools) {
+    window.WebMCPTools.registerDailyGrindTools(store);
+  }
+
+  // DOM Elements
+  const menuGrid = document.getElementById('menu-grid');
+  const categoryFilters = document.getElementById('category-filters');
+  const cartBadge = document.getElementById('cart-badge');
+  const cartDrawer = document.getElementById('cart-drawer');
+  const cartDrawerOverlay = document.getElementById('cart-drawer-overlay');
+  const cartItemsContainer = document.getElementById('cart-items-container');
+  const cartSubtotalEl = document.getElementById('cart-subtotal');
+  const cartDiscountEl = document.getElementById('cart-discount');
+  const cartTaxEl = document.getElementById('cart-tax');
+  const cartTotalEl = document.getElementById('cart-total');
+  const cartItemCountEl = document.getElementById('cart-item-count');
+  const promoCodeInput = document.getElementById('promo-code-input');
+  const applyPromoBtn = document.getElementById('apply-promo-btn');
+  const promoStatusEl = document.getElementById('promo-status');
+  const clearCartBtn = document.getElementById('clear-cart-btn');
+  const agentActivityBanner = document.getElementById('agent-activity-banner');
+  const agentActivityText = document.getElementById('agent-activity-text');
+  const locationsList = document.getElementById('locations-list');
+  const rewardsPointsEl = document.getElementById('rewards-points');
+  const rewardsTierEl = document.getElementById('rewards-tier');
+  const rewardsPerksList = document.getElementById('rewards-perks-list');
+  const orderSuccessModal = document.getElementById('order-success-modal');
+  const orderSuccessDetails = document.getElementById('order-success-details');
+  const quickAddItemSelect = document.getElementById('quick-add-item-select');
+
+  // Forms
+  const menuSearchForm = document.getElementById('menu-search-form');
+  const quickOrderForm = document.getElementById('quick-order-form');
+  const rewardsSignupForm = document.getElementById('rewards-signup-form');
+  const checkoutForm = document.getElementById('checkout-form');
+
+  // Agent activity feedback
+  let activityTimer = null;
+  function notifyAgentActivity(message, status = 'active') {
+    if (!agentActivityBanner || !agentActivityText) return;
+    agentActivityText.textContent = message;
+    agentActivityBanner.className = `agent-banner show ${status}`;
+    clearTimeout(activityTimer);
+    activityTimer = setTimeout(() => {
+      agentActivityBanner.classList.remove('show');
+    }, 4500);
+  }
+
+  // Setup Lifecycle Event Listeners (WebMCP early preview standard)
+  const targetFor = (type, listener, options) =>
+    (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+      .addEventListener(type, listener, options);
+
+  targetFor('toolactivated', (ev) => {
+    const toolName = ev?.toolName || ev?.detail?.toolName || 'agent_action';
+    console.log(`[WebMCP] Tool activated: ${toolName}`);
+    notifyAgentActivity(`AI Agent activated: ${toolName}`, 'active');
+  });
+
+  targetFor('toolcancel', (ev) => {
+    const toolName = ev?.toolName || ev?.detail?.toolName || 'agent_action';
+    console.log(`[WebMCP] Tool cancelled: ${toolName}`);
+    notifyAgentActivity(`AI Agent cancelled: ${toolName}`, 'cancelled');
+  });
+
+  // Render Menu
+  function renderMenu() {
+    if (!menuGrid) return;
+    const items = store.getMenu(store.activeFilter);
+
+    if (items.length === 0) {
+      menuGrid.innerHTML = `
+        <div class="empty-menu-msg">
+          <p>No coffee or food items matched your search.</p>
+          <button class="btn btn-outline" id="reset-filter-btn">Reset Filters</button>
+        </div>
+      `;
+      const resetBtn = document.getElementById('reset-filter-btn');
+      if (resetBtn) {
+        resetBtn.addEventListener('click', () => {
+          store.setFilter({ query: '', category: 'all' });
+          if (menuSearchForm) {
+            menuSearchForm.reset();
+          }
+        });
+      }
+      return;
+    }
+
+    menuGrid.innerHTML = items.map(item => `
+      <div class="card menu-card" data-id="${item.id}">
+        <div class="card-img-container">
+          <img src="${item.image}" alt="${item.name}" class="card-img" loading="lazy">
+          <span class="category-badge ${item.category}">${item.category.toUpperCase()}</span>
+        </div>
+        <div class="card-body">
+          <div class="card-header-row">
+            <h3 class="card-title">${item.name}</h3>
+            <span class="card-price">$${item.price.toFixed(2)}</span>
+          </div>
+          <p class="card-desc">${item.description}</p>
+          <div class="card-meta">
+            <span>🔥 ${item.calories} cal</span>
+            <span>⭐ Artisanal</span>
+          </div>
+
+          <div class="card-actions">
+            <div class="card-options-row">
+              <label class="sr-only" for="size-${item.id}">Size</label>
+              <select id="size-${item.id}" class="card-select size-select" data-id="${item.id}">
+                ${item.sizes.map(s => `<option value="${s}" ${s === 'medium' ? 'selected' : ''}>${s.charAt(0).toUpperCase() + s.slice(1)}</option>`).join('')}
+              </select>
+
+              ${item.milks.length > 1 ? `
+                <label class="sr-only" for="milk-${item.id}">Milk</label>
+                <select id="milk-${item.id}" class="card-select milk-select" data-id="${item.id}">
+                  ${item.milks.map(m => `<option value="${m}" ${m === 'oat' ? 'selected' : ''}>${m.charAt(0).toUpperCase() + m.slice(1)}</option>`).join('')}
+                </select>
+              ` : ''}
+            </div>
+
+            <button class="btn btn-primary add-to-cart-btn" data-id="${item.id}">
+              Add to Cart
+            </button>
+          </div>
+        </div>
+      </div>
+    `).join('');
+
+    // Attach card add-to-cart listeners
+    menuGrid.querySelectorAll('.add-to-cart-btn').forEach(btn => {
+      btn.addEventListener('click', (e) => {
+        const id = e.currentTarget.getAttribute('data-id');
+        const sizeSelect = menuGrid.querySelector(`.size-select[data-id="${id}"]`);
+        const milkSelect = menuGrid.querySelector(`.milk-select[data-id="${id}"]`);
+
+        const size = sizeSelect ? sizeSelect.value : 'medium';
+        const milk = milkSelect ? milkSelect.value : 'none';
+
+        store.addToCart({ itemId: id, size, milk, quantity: 1 });
+        notifyAgentActivity(`Added ${id} to cart`, 'active');
+      });
+    });
+  }
+
+  // Populate quick add select
+  function populateQuickAddSelect() {
+    if (!quickAddItemSelect) return;
+    quickAddItemSelect.innerHTML = store.menu.map(item => `
+      <option value="${item.id}">${item.name} ($${item.price.toFixed(2)})</option>
+    `).join('');
+  }
+
+  // Render Cart
+  function renderCart() {
+    const cart = store.getCart();
+
+    if (cartBadge) {
+      cartBadge.textContent = String(cart.itemCount);
+      cartBadge.style.display = cart.itemCount > 0 ? 'inline-block' : 'none';
+    }
+
+    if (cartItemCountEl) {
+      cartItemCountEl.textContent = `${cart.itemCount} item${cart.itemCount === 1 ? '' : 's'}`;
+    }
+
+    if (cartSubtotalEl) cartSubtotalEl.textContent = `$${cart.subtotal.toFixed(2)}`;
+    if (cartDiscountEl) cartDiscountEl.textContent = `-$${cart.discount.toFixed(2)}`;
+    if (cartTaxEl) cartTaxEl.textContent = `$${cart.tax.toFixed(2)}`;
+    if (cartTotalEl) cartTotalEl.textContent = `$${cart.total.toFixed(2)}`;
+
+    const checkoutTotalBtn = document.getElementById('checkout-total-btn');
+    if (checkoutTotalBtn) {
+      checkoutTotalBtn.textContent = `$${cart.total.toFixed(2)}`;
+    }
+
+    if (!cartItemsContainer) return;
+
+    if (cart.items.length === 0) {
+      cartItemsContainer.innerHTML = `
+        <div class="empty-cart-view">
+          <p>Your shopping cart is empty.</p>
+          <p class="empty-cart-sub">Select your favorite coffee or breakfast treat to get started!</p>
+        </div>
+      `;
+      return;
+    }
+
+    cartItemsContainer.innerHTML = cart.items.map(item => `
+      <div class="cart-item-row" data-cart-id="${item.cartItemId}">
+        <div class="cart-item-info">
+          <h4>${item.name}</h4>
+          <p class="cart-item-specs">
+            Size: ${item.size.toUpperCase()}${item.milk !== 'none' ? ` | Milk: ${item.milk}` : ''}
+          </p>
+          <span class="cart-item-price">$${item.price.toFixed(2)} ea</span>
+        </div>
+        <div class="cart-item-controls">
+          <span class="cart-qty-badge">x${item.quantity}</span>
+          <span class="cart-item-subtotal">$${item.itemTotal.toFixed(2)}</span>
+          <button class="cart-remove-btn" data-cart-id="${item.cartItemId}" title="Remove item">
+            &times;
+          </button>
+        </div>
+      </div>
+    `).join('');
+
+    // Attach remove buttons
+    cartItemsContainer.querySelectorAll('.cart-remove-btn').forEach(btn => {
+      btn.addEventListener('click', (e) => {
+        const cartId = e.currentTarget.getAttribute('data-cart-id');
+        store.removeFromCart(cartId);
+      });
+    });
+  }
+
+  // Render Locations
+  function renderLocations() {
+    if (!locationsList) return;
+    const locations = store.getLocations();
+    locationsList.innerHTML = locations.map(loc => `
+      <div class="location-card card">
+        <h3>${loc.name}</h3>
+        <p class="loc-address">📍 ${loc.address}, ${loc.city}</p>
+        <p class="loc-hours">⏰ ${loc.hours}</p>
+        <p class="loc-phone">📞 ${loc.phone}</p>
+        <div class="loc-amenities">
+          ${loc.amenities.map(a => `<span class="amenity-pill">${a}</span>`).join('')}
+        </div>
+      </div>
+    `).join('');
+  }
+
+  // Render Rewards
+  function renderRewards() {
+    const rewards = store.getRewards();
+    if (rewardsPointsEl) rewardsPointsEl.textContent = String(rewards.points);
+    if (rewardsTierEl) rewardsTierEl.textContent = rewards.tier;
+    if (rewardsPerksList) {
+      rewardsPerksList.innerHTML = rewards.activePerks.map(p => `<li>✨ ${p}</li>`).join('');
+    }
+  }
+
+  // Category Filter clicks
+  if (categoryFilters) {
+    categoryFilters.querySelectorAll('.filter-btn').forEach(btn => {
+      btn.addEventListener('click', (e) => {
+        categoryFilters.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
+        e.currentTarget.classList.add('active');
+        const category = e.currentTarget.getAttribute('data-category');
+        store.setFilter({ category });
+      });
+    });
+  }
+
+  // Store Event Listeners
+  store.addEventListener('cartchange', () => {
+    renderCart();
+  });
+
+  store.addEventListener('filterchange', (e) => {
+    const { category, query } = e.detail.filter;
+    if (categoryFilters) {
+      categoryFilters.querySelectorAll('.filter-btn').forEach(b => {
+        if (b.getAttribute('data-category') === category) {
+          b.classList.add('active');
+        } else {
+          b.classList.remove('active');
+        }
+      });
+    }
+    renderMenu();
+  });
+
+  store.addEventListener('orderplaced', (e) => {
+    const order = e.detail.order;
+    if (orderSuccessModal && orderSuccessDetails) {
+      orderSuccessDetails.innerHTML = `
+        <p><strong>Order ID:</strong> ${order.orderId}</p>
+        <p><strong>Customer:</strong> ${order.customerName}</p>
+        <p><strong>Pickup Timing:</strong> ${order.pickupTime}</p>
+        <p><strong>Total Paid:</strong> $${order.total.toFixed(2)}</p>
+        <p><strong>Items:</strong></p>
+        <ul>
+          ${order.items.map(i => `<li>${i.quantity}x ${i.name} (${i.size})</li>`).join('')}
+        </ul>
+      `;
+      orderSuccessModal.classList.add('show');
+    }
+  });
+
+  // Promo code button
+  if (applyPromoBtn && promoCodeInput) {
+    applyPromoBtn.addEventListener('click', () => {
+      const code = promoCodeInput.value.trim();
+      const res = store.applyPromoCode(code);
+      if (promoStatusEl) {
+        if (res.error) {
+          promoStatusEl.textContent = res.error;
+          promoStatusEl.className = 'promo-status error';
+        } else {
+          promoStatusEl.textContent = res.message;
+          promoStatusEl.className = 'promo-status success';
+        }
+      }
+    });
+  }
+
+  // Clear cart button
+  if (clearCartBtn) {
+    clearCartBtn.addEventListener('click', () => {
+      store.clearCart();
+    });
+  }
+
+  // Cart Drawer toggling
+  const openCartBtn = document.getElementById('open-cart-btn');
+  const closeCartBtn = document.getElementById('close-cart-btn');
+
+  function openCart() {
+    if (cartDrawer && cartDrawerOverlay) {
+      cartDrawer.classList.add('open');
+      cartDrawerOverlay.classList.add('open');
+    }
+  }
+
+  function closeCart() {
+    if (cartDrawer && cartDrawerOverlay) {
+      cartDrawer.classList.remove('open');
+      cartDrawerOverlay.classList.remove('open');
+    }
+  }
+
+  if (openCartBtn) openCartBtn.addEventListener('click', (e) => { e.preventDefault(); openCart(); });
+  if (closeCartBtn) closeCartBtn.addEventListener('click', closeCart);
+  if (cartDrawerOverlay) cartDrawerOverlay.addEventListener('click', closeCart);
+
+  // Close order success modal
+  const closeOrderModalBtn = document.getElementById('close-order-modal-btn');
+  if (closeOrderModalBtn && orderSuccessModal) {
+    closeOrderModalBtn.addEventListener('click', () => {
+      orderSuccessModal.classList.remove('show');
+    });
+  }
+
+  // ==========================================
+  // Declarative WebMCP Form Handlers
+  // Compliant with agentic-forms specification
+  // ==========================================
+
+  // 1. Menu Search Form (Declarative Tool: search_menu)
+  if (menuSearchForm) {
+    menuSearchForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const formData = new FormData(menuSearchForm);
+      const query = (formData.get('query') || '').toString().trim();
+      const category = (formData.get('category') || 'all').toString();
+
+      store.setFilter({ query, category });
+      const results = store.getMenu({ query, category });
+
+      notifyAgentActivity(`Executed search_menu: "${query || category}"`, 'active');
+
+      if (event.agentInvoked) {
+        const responseData = {
+          count: results.length,
+          matches: results.map(r => ({
+            id: r.id,
+            name: r.name,
+            price: r.price,
+            category: r.category
+          }))
+        };
+        event.respondWith(Promise.resolve(responseData));
+      }
+    });
+  }
+
+  // 2. Quick Add To Cart Form (Declarative Tool: quick_add_to_cart)
+  if (quickOrderForm) {
+    quickOrderForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const formData = new FormData(quickOrderForm);
+      const itemId = formData.get('itemId')?.toString();
+      const size = formData.get('size')?.toString() || 'medium';
+      const milk = formData.get('milk')?.toString() || 'none';
+      const quantity = parseInt(formData.get('quantity')?.toString() || '1', 10);
+
+      const result = store.addToCart({ itemId, size, milk, quantity });
+
+      if (result.error) {
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(`Validation failed: ${result.error}`));
+        }
+        return;
+      }
+
+      notifyAgentActivity(`Added ${quantity}x ${itemId} to cart`, 'active');
+
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve(result));
+      }
+    });
+  }
+
+  // 3. Member Rewards Club Form (Declarative Tool: join_rewards_club)
+  if (rewardsSignupForm) {
+    rewardsSignupForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const formData = new FormData(rewardsSignupForm);
+      const name = formData.get('name')?.toString().trim();
+      const email = formData.get('email')?.toString().trim();
+
+      if (!name || !email) {
+        const err = 'Validation failed: Name and email are required.';
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(err));
+        }
+        return;
+      }
+
+      store.rewards.accountName = name;
+      store.rewards.points += 50;
+      renderRewards();
+
+      const signupMsgEl = document.getElementById('rewards-signup-message');
+      if (signupMsgEl) {
+        signupMsgEl.textContent = `Welcome ${name}! You've joined The Daily Grind club with 50 bonus points.`;
+        signupMsgEl.className = 'success-message';
+      }
+
+      notifyAgentActivity(`Enrolled member: ${name}`, 'active');
+
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve({
+          success: true,
+          message: `Welcome ${name}! Successfully registered with 50 bonus points.`
+        }));
+      }
+    });
+  }
+
+  // 4. Checkout Order Form (Declarative Tool: place_order_form)
+  // Note: toolautosubmit is omitted as required for financial/transactional actions!
+  if (checkoutForm) {
+    checkoutForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+
+      const formData = new FormData(checkoutForm);
+      const customerName = formData.get('customerName')?.toString().trim();
+      const pickupTime = formData.get('pickupTime')?.toString() || 'asap';
+      const paymentMethod = formData.get('paymentMethod')?.toString() || 'credit_card';
+
+      if (store.cart.items.length === 0) {
+        const err = 'Validation failed: Shopping cart is empty. Please add items before placing order.';
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(err));
+        }
+        alert(err);
+        return;
+      }
+
+      if (!customerName) {
+        const err = 'Validation failed: Customer name is required.';
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(err));
+        }
+        alert(err);
+        return;
+      }
+
+      const checkoutResult = store.checkout({ customerName, pickupTime, paymentMethod });
+      closeCart();
+
+      notifyAgentActivity(`Order placed by ${customerName}`, 'active');
+
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve(checkoutResult));
+      }
+    });
+  }
+
+  // Initial renders
+  renderMenu();
+  populateQuickAddSelect();
+  renderCart();
+  renderLocations();
+  renderRewards();
+})();
