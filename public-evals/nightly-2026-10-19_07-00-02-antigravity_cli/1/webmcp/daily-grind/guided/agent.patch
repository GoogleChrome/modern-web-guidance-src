+        success: true,
+        message: 'Shopping cart cleared.',
+        cart: this.getCart()
+      };
+    }
+
+    applyPromoCode(code) {
+      if (!code) {
+        return {
+          error: 'Please provide a promo code.',
+          validCodesHint: Object.keys(PROMO_CODES)
+        };
+      }
+
+      const normalized = String(code).toUpperCase().trim();
+      if (!PROMO_CODES[normalized]) {
+        return {
+          error: `Promo code "${code}" is invalid or expired.`,
+          validCodesHint: Object.keys(PROMO_CODES)
+        };
+      }
+
+      this.cart.appliedPromo = normalized;
+      this._recalculateCart();
+
+      return {
+        success: true,
+        message: `Promo code "${normalized}" applied successfully!`,
+        promo: PROMO_CODES[normalized],
+        cart: this.getCart()
+      };
+    }
+
+    checkout({ customerName, pickupTime = 'asap', paymentMethod = 'credit_card' }) {
