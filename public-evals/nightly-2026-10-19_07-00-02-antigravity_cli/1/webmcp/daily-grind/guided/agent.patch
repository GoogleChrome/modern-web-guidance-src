+      annotations: {
+        readOnlyHint: false
+      }
+    }, { signal: registrationSignal });
+
+    // 8. checkout_order
+    document.modelContext.registerTool({
+      name: 'checkout_order',
+      description: 'Places and confirms the order for all items currently in the shopping cart.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          customerName: {
+            type: 'string',
+            description: 'Name for order pickup.'
