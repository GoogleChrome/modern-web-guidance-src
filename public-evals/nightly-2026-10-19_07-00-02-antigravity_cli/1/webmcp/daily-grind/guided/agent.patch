+          pickupTime: {
+            type: 'string',
+            enum: PICKUP_TIMES,
+            default: 'asap',
+            description: 'Desired pickup timing.'
+          },
+          paymentMethod: {
+            type: 'string',
+            enum: PAYMENT_METHODS,
