+:root {
+  --primary: #4e342e;
+  --primary-dark: #3e2723;
+  --secondary: #d7ccc8;
+  --secondary-light: #efebe9;
+  --accent: #ffab40;
+  --accent-hover: #ff9100;
+  --text: #2d1e18;
+  --text-muted: #6d4c41;
+  --light: #faf8f5;
+  --white: #ffffff;
+  --border: #e0d7d2;
+  --success: #2e7d32;
+  --error: #c62828;
+  --shadow-sm: 0 2px 5px rgba(0, 0, 0, 0.08);
+  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.12);
+  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.18);
+  --radius: 8px;
+  --radius-lg: 12px;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+  min-height: 100vh;
+  display: flex;
+  flex-direction: column;
+}
+
+/* =========================================
+   WebMCP Pseudo-classes & Feedback
+   (agentic-forms guidance)
+   ========================================= */
+form:tool-form-active {
+  outline: 2px dashed var(--accent);
+  background-color: rgba(255, 171, 64, 0.08) !important;
+  transition: all 0.2s ease-in-out;
+}
+
+button:tool-submit-active {
+  outline: 2px dashed var(--primary);
+  animation: toolPulse 2s infinite;
+}
+
+@keyframes toolPulse {
+  0% { transform: scale(1); }
+  50% { transform: scale(1.04); }
+  100% { transform: scale(1); }
+}
+
+/* Agent Activity Banner */
+.agent-banner {
+  display: none;
+  background: #263238;
+  color: #eceff1;
+  padding: 8px 16px;
+  font-size: 0.85rem;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  position: sticky;
+  top: 0;
+  z-index: 2000;
+  border-bottom: 2px solid var(--accent);
+}
+
+.agent-banner.show {
+  display: flex;
+}
+
+.agent-banner.active {
+  border-bottom-color: var(--accent);
+}
+
+.agent-banner.cancelled {
+  border-bottom-color: var(--error);
+}
+
+.agent-indicator-dot {
+  width: 10px;
+  height: 10px;
+  background-color: #00e676;
+  border-radius: 50%;
+  animation: pulseDot 1.5s infinite;
+}
+
+@keyframes pulseDot {
+  0% { transform: scale(0.9); opacity: 0.8; }
+  50% { transform: scale(1.3); opacity: 1; }
+  100% { transform: scale(0.9); opacity: 0.8; }
+}
+
+/* Navigation */
+nav {
+  background: var(--primary);
+  color: white;
+  padding: 0.8rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  box-shadow: var(--shadow-sm);
+}
+
+.logo {
+  font-size: 1.4rem;
+  font-weight: 800;
+  letter-spacing: 1.5px;
+  color: white;
+  text-decoration: none;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.nav-links {
