+  color: var(--text-muted);
+  margin-bottom: 2px;
+}
+
+.loc-amenities {
+  display: flex;
+  gap: 6px;
+  flex-wrap: wrap;
+  margin-top: 6px;
+}
+
+.amenity-pill {
+  background: white;
+  border: 1px solid var(--border);
+  font-size: 0.72rem;
+  padding: 2px 7px;
+  border-radius: 10px;
+}
+
+/* Cart Drawer */
+.cart-drawer-overlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(0, 0, 0, 0.5);
+  z-index: 3000;
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity 0.3s;
+}
+
+.cart-drawer-overlay.open {
+  opacity: 1;
+  visibility: visible;
+}
+
+.cart-drawer {
+  position: fixed;
+  top: 0;
+  right: 0;
+  width: 420px;
+  max-width: 90vw;
+  height: 100vh;
+  background: white;
+  z-index: 3001;
+  box-shadow: var(--shadow-lg);
+  display: flex;
+  flex-direction: column;
+  transform: translateX(100%);
+  transition: transform 0.3s ease-in-out;
+}
+
+.cart-drawer.open {
+  transform: translateX(0);
+}
+
+.cart-drawer-header {
+  padding: 18px 20px;
+  background: var(--primary);
+  color: white;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.cart-drawer-header h3 {
+  font-size: 1.2rem;
+}
+
+.cart-close-btn {
+  background: none;
+  border: none;
+  color: white;
+  font-size: 1.5rem;
+  cursor: pointer;
+  line-height: 1;
+}
+
+.cart-items-container {
+  flex: 1;
+  overflow-y: auto;
+  padding: 16px 20px;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.empty-cart-view {
+  text-align: center;
+  padding: 40px 10px;
+  color: var(--text-muted);
+}
+
+.cart-item-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 10px;
+  background: var(--light);
+  border-radius: var(--radius);
+  border: 1px solid var(--border);
+}
+
+.cart-item-info h4 {
+  font-size: 0.95rem;
+  color: var(--primary);
+}
+
+.cart-item-specs {
+  font-size: 0.8rem;
+  color: var(--text-muted);
+}
+
+.cart-item-price {
+  font-size: 0.85rem;
+  font-weight: 600;
+}
+
+.cart-item-controls {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.cart-qty-badge {
+  background: white;
+  border: 1px solid var(--border);
+  padding: 2px 6px;
+  border-radius: 4px;
+  font-size: 0.85rem;
+  font-weight: 600;
+}
+
+.cart-item-subtotal {
+  font-weight: 700;
+  font-size: 0.95rem;
+  color: var(--primary-dark);
+}
+
+.cart-remove-btn {
+  background: none;
+  border: none;
+  color: var(--error);
+  font-size: 1.2rem;
+  cursor: pointer;
+  padding: 0 4px;
+  line-height: 1;
+}
+
+.cart-drawer-footer {
+  border-top: 1px solid var(--border);
+  padding: 16px 20px;
+  background: var(--light);
+}
+
+.promo-row {
+  display: flex;
+  gap: 8px;
+  margin-bottom: 8px;
+}
+
+.promo-status {
+  font-size: 0.8rem;
+  margin-bottom: 10px;
+}
+
+.promo-status.success { color: var(--success); font-weight: 600; }
+.promo-status.error { color: var(--error); }
+
+.cart-totals-breakdown {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin-bottom: 14px;
+  font-size: 0.9rem;
+}
+
+.total-row {
+  display: flex;
+  justify-content: space-between;
+}
+
+.total-row.final {
+  font-size: 1.15rem;
+  font-weight: 800;
+  color: var(--primary);
+  border-top: 1px solid var(--border);
+  padding-top: 6px;
+  margin-top: 4px;
+}
+
+.cart-checkout-form {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+/* Modals */
+.modal-overlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(0, 0, 0, 0.6);
+  z-index: 4000;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 20px;
+  opacity: 0;
+  visibility: hidden;
+  transition: opacity 0.2s;
+}
+
+.modal-overlay.show {
+  opacity: 1;
+  visibility: visible;
+}
+
+.modal-card {
+  background: white;
+  border-radius: var(--radius-lg);
+  padding: 28px;
+  max-width: 480px;
+  width: 100%;
+  box-shadow: var(--shadow-lg);
+  text-align: center;
+}
+
+.modal-icon {
+  font-size: 3rem;
+  margin-bottom: 10px;
+}
+
+.modal-card h3 {
+  font-size: 1.5rem;
+  color: var(--primary);
+  margin-bottom: 10px;
+}
+
+.order-details-box {
+  background: var(--light);
+  border: 1px solid var(--border);
+  border-radius: var(--radius);
+  padding: 14px;
+  text-align: left;
+  font-size: 0.9rem;
+  margin: 15px 0 20px 0;
+}
+
+.order-details-box p {
+  margin-bottom: 4px;
+}
+
+.order-details-box ul {
+  padding-left: 20px;
+  margin-top: 4px;
+}
+
+/* Footer */
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 35px 20px;
+  margin-top: auto;
+  border-top: 1px solid var(--border);
+}
+
+.footer-links {
+  margin-bottom: 15px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.88rem;
+}
+
+.footer-links a:hover {
+  text-decoration: underline;
+}
+
+.success-message {
+  color: var(--success);
+  font-size: 0.85rem;
+  font-weight: 600;
+}
diff --git a/test/webmcp.test.js b/test/webmcp.test.js
new file mode 100644
index 0000000..68d37cc
--- /dev/null
+++ b/test/webmcp.test.js
@@ -0,0 +1,222 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { JSDOM } from 'jsdom';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const html = fs.readFileSync(path.join(__dirname, '../index.html'), 'utf-8');
+const polyfillCode = fs.readFileSync(path.join(__dirname, '../webmcp-polyfill.js'), 'utf-8');
+const dataCode = fs.readFileSync(path.join(__dirname, '../data.js'), 'utf-8');
+const toolsCode = fs.readFileSync(path.join(__dirname, '../webmcp-tools.js'), 'utf-8');
+const appCode = fs.readFileSync(path.join(__dirname, '../app.js'), 'utf-8');
+
+function setupEnvironment() {
+  const dom = new JSDOM(html, {
+    url: 'https://example.com/daily-grind',
+    runScripts: 'dangerously'
+  });
+
+  const { window } = dom;
+
+  // Execute scripts in proper order
+  window.eval(polyfillCode);
+  window.eval(dataCode);
+  window.eval(toolsCode);
+  window.eval(appCode);
+
+  return { dom, window, document: window.document };
+}
+
+test('WebMCP: document.modelContext exists and registers tools', async () => {
+  const { document } = setupEnvironment();
+  assert.ok(document.modelContext, 'document.modelContext should exist');
+  assert.equal(typeof document.modelContext.registerTool, 'function');
+  assert.equal(typeof document.modelContext.getTools, 'function');
+  assert.equal(typeof document.modelContext.executeTool, 'function');
+});
+
+test('WebMCP: getTools() returns registered tools and declarative forms', async () => {
+  const { document } = setupEnvironment();
+  const tools = await document.modelContext.getTools();
+  assert.ok(Array.isArray(tools));
+  assert.ok(tools.length > 0, 'Tools list should not be empty');
+
+  const toolNames = tools.map(t => t.name);
+
+  // Check imperative tools
+  assert.ok(toolNames.includes('get_menu'), 'Should include get_menu');
+  assert.ok(toolNames.includes('get_menu_item'), 'Should include get_menu_item');
+  assert.ok(toolNames.includes('get_cart'), 'Should include get_cart');
+  assert.ok(toolNames.includes('add_to_cart'), 'Should include add_to_cart');
+  assert.ok(toolNames.includes('remove_from_cart'), 'Should include remove_from_cart');
+  assert.ok(toolNames.includes('clear_cart'), 'Should include clear_cart');
+  assert.ok(toolNames.includes('apply_promo_code'), 'Should include apply_promo_code');
+  assert.ok(toolNames.includes('checkout_order'), 'Should include checkout_order');
+  assert.ok(toolNames.includes('get_store_locations'), 'Should include get_store_locations');
+  assert.ok(toolNames.includes('get_reward_status'), 'Should include get_reward_status');
+  assert.ok(toolNames.includes('dump_app_state'), 'Should include dump_app_state');
+
+  // Check declarative tools
+  assert.ok(toolNames.includes('search_menu'), 'Should include declarative search_menu');
+  assert.ok(toolNames.includes('quick_add_to_cart'), 'Should include declarative quick_add_to_cart');
+  assert.ok(toolNames.includes('join_rewards_club'), 'Should include declarative join_rewards_club');
+  assert.ok(toolNames.includes('place_order_form'), 'Should include declarative place_order_form');
+});
+
+test('WebMCP: annotations compliance (readOnlyHint, consequentialHint, debugging)', async () => {
+  const { document } = setupEnvironment();
+  const tools = await document.modelContext.getTools();
+
+  const getMenuTool = tools.find(t => t.name === 'get_menu');
+  assert.equal(getMenuTool.annotations.readOnlyHint, true, 'get_menu should have readOnlyHint: true');
+
+  const checkoutTool = tools.find(t => t.name === 'checkout_order');
+  assert.equal(checkoutTool.annotations.consequentialHint, true, 'checkout_order should have consequentialHint: true');
+  assert.equal(checkoutTool.annotations.readOnlyHint, false, 'checkout_order should have readOnlyHint: false');
+
+  const dumpTool = tools.find(t => t.name === 'dump_app_state');
+  assert.equal(dumpTool.annotations.debugging, true, 'dump_app_state should have debugging: true');
+});
+
+test('WebMCP: executeTool() invokes get_menu and returns filtered results', async () => {
+  const { document } = setupEnvironment();
+  const raw = await document.modelContext.executeTool('get_menu', { category: 'seasonal' });
+  const result = typeof raw === 'string' ? JSON.parse(raw) : raw;
+  assert.ok(result.items.length > 0);
+  assert.ok(result.items.every(i => i.category === 'seasonal'));
+});
+
+test('WebMCP: executeTool() handles shopping cart flow (add, view, remove)', async () => {
+  const { document } = setupEnvironment();
+
+  // Add item
+  const addRaw = await document.modelContext.executeTool('add_to_cart', {
+    itemId: 'maple-oat-latte',
+    quantity: 2,
+    size: 'large',
+    milk: 'oat'
+  });
+  const addRes = typeof addRaw === 'string' ? JSON.parse(addRaw) : addRaw;
+  assert.equal(addRes.success, true);
+  assert.equal(addRes.cart.itemCount, 2);
+
+  // View cart
+  const cartRaw = await document.modelContext.executeTool('get_cart');
+  const cart = typeof cartRaw === 'string' ? JSON.parse(cartRaw) : cartRaw;
+  assert.equal(cart.items.length, 1);
+  assert.equal(cart.items[0].name, 'Maple Oat Latte');
+  const cartItemId = cart.items[0].cartItemId;
+
+  // Remove item
+  const remRaw = await document.modelContext.executeTool('remove_from_cart', { cartItemId });
+  const remRes = typeof remRaw === 'string' ? JSON.parse(remRaw) : remRaw;
+  assert.equal(remRes.success, true);
+  assert.equal(remRes.cart.itemCount, 0);
+});
+
+test('WebMCP: structured errors returned instead of generic thrown exceptions', async () => {
+  const { document } = setupEnvironment();
+
+  // Invalid item
+  const raw = await document.modelContext.executeTool('add_to_cart', { itemId: 'non-existent-beverage' });
+  const res = typeof raw === 'string' ? JSON.parse(raw) : raw;
+  assert.ok(res.error, 'Should return structured error');
+  assert.ok(Array.isArray(res.availableItemIds), 'Should provide helpful recovery hints');
+
+  // Checkout with empty cart
+  const checkRaw = await document.modelContext.executeTool('checkout_order', { customerName: 'Sam' });
+  const checkRes = typeof checkRaw === 'string' ? JSON.parse(checkRaw) : checkRaw;
+  assert.ok(checkRes.error, 'Should return error when checking out empty cart');
+});
+
+test('WebMCP: checkout_order completes successfully with items in cart', async () => {
+  const { document } = setupEnvironment();
+
+  // Add item
+  await document.modelContext.executeTool('add_to_cart', {
+    itemId: 'dark-roast-espresso',
+    quantity: 1
+  });
+
+  // Apply promo
+  const promoRaw = await document.modelContext.executeTool('apply_promo_code', { code: 'BEANS10' });
+  const promoRes = typeof promoRaw === 'string' ? JSON.parse(promoRaw) : promoRaw;
+  assert.equal(promoRes.success, true);
+
+  // Checkout
+  const orderRaw = await document.modelContext.executeTool('checkout_order', {
+    customerName: 'Morgan Barista',
+    pickupTime: '15_minutes',
+    paymentMethod: 'apple_pay'
+  });
+  const orderRes = typeof orderRaw === 'string' ? JSON.parse(orderRaw) : orderRaw;
+  assert.equal(orderRes.success, true);
+  assert.ok(orderRes.order.orderId.startsWith('ORD-'));
+  assert.equal(orderRes.order.customerName, 'Morgan Barista');
+
+  // Verify cart emptied after checkout
+  const cartRaw = await document.modelContext.executeTool('get_cart');
+  const cart = typeof cartRaw === 'string' ? JSON.parse(cartRaw) : cartRaw;
+  assert.equal(cart.itemCount, 0);
+});
+
+test('WebMCP: tool unregistration via registration AbortSignal', async () => {
+  const { document } = setupEnvironment();
+  const controller = new AbortController();
+
+  let toolChangeDispatched = false;
+  document.modelContext.addEventListener('toolchange', () => {
+    toolChangeDispatched = true;
+  });
+
+  await document.modelContext.registerTool({
+    name: 'temp_tool',
+    description: 'Temporary tool for lifecycle test',
+    inputSchema: { type: 'object', properties: {} },
+    execute() { return 'ok'; }
+  }, { signal: controller.signal });
+
+  let tools = await document.modelContext.getTools();
+  assert.ok(tools.some(t => t.name === 'temp_tool'));
+
+  // Abort registration signal
+  controller.abort();
+
+  tools = await document.modelContext.getTools();
+  assert.ok(!tools.some(t => t.name === 'temp_tool'), 'temp_tool should be unregistered');
+  assert.equal(toolChangeDispatched, true, 'toolchange event should have been dispatched');
+});
+
+test('WebMCP: execution cancellation with AbortSignal', async () => {
+  const { document } = setupEnvironment();
+  const controller = new AbortController();
+
+  let cancelEventFired = false;
+  document.modelContext.addEventListener('toolcancel', (e) => {
+    cancelEventFired = true;
+  });
+
+  controller.abort();
+
+  await assert.rejects(
+    async () => {
+      await document.modelContext.executeTool('get_menu', {}, { signal: controller.signal });
+    },
+    { name: 'AbortError' }
+  );
+});
+
+test('WebMCP: declarative form submission with agentInvoked and respondWith', async () => {
+  const { document } = setupEnvironment();
+
+  // Execute declarative search_menu tool
+  const raw = await document.modelContext.executeTool('search_menu', {
+    query: 'latte',
+    category: 'all'
+  });
+  const res = typeof raw === 'string' ? JSON.parse(raw) : raw;
+  assert.ok(res.count > 0, 'Should find latte in menu search');
+  assert.ok(res.matches.some(m => m.name.toLowerCase().includes('latte')));
+});
diff --git a/webmcp-polyfill.js b/webmcp-polyfill.js
new file mode 100644
index 0000000..a3d37b3
--- /dev/null
+++ b/webmcp-polyfill.js
@@ -0,0 +1,309 @@
+/**
+ * WebMCP Polyfill for browser environments that do not yet support
+ * document.modelContext natively.
+ * Conforms to Chromium WebMCP (Web Model Context Protocol) Specification.
+ */
+(function () {
+  'use strict';
+
+  if (typeof document !== 'undefined' && 'modelContext' in document && document.modelContext) {
+    return;
+  }
+
+  class ToolActivatedEvent extends Event {
+    constructor(type, eventInitDict = {}) {
+      super(type, eventInitDict);
+      this.toolName = eventInitDict.toolName || '';
+    }
+  }
+
+  class ToolCancelEvent extends Event {
+    constructor(type, eventInitDict = {}) {
+      super(type, eventInitDict);
+      this.toolName = eventInitDict.toolName || '';
+    }
+  }
+
+  if (typeof window !== 'undefined') {
+    window.ToolActivatedEvent = ToolActivatedEvent;
+    window.ToolCancelEvent = ToolCancelEvent;
+  } else if (typeof globalThis !== 'undefined') {
+    globalThis.ToolActivatedEvent = ToolActivatedEvent;
+    globalThis.ToolCancelEvent = ToolCancelEvent;
+  }
+
+  class ModelContext extends EventTarget {
+    constructor() {
+      super();
+      /** @type {Map<string, { tool: any, options: any }>} */
+      this._registeredTools = new Map();
+      this.ontoolchange = null;
+      this.ontoolactivated = null;
+      this.ontoolcancel = null;
+    }
+
+    async registerTool(tool, options = {}) {
+      if (!tool || typeof tool !== 'object') {
+        throw new TypeError('Tool definition must be an object');
+      }
+      if (typeof tool.name !== 'string' || !tool.name) {
+        throw new TypeError('Tool name must be a non-empty string');
+      }
+      if (typeof tool.description !== 'string') {
+        throw new TypeError('Tool description must be a string');
+      }
+      if (typeof tool.execute !== 'function') {
+        throw new TypeError('Tool execute must be a function');
+      }
+
+      if (options?.signal?.aborted) {
+        return;
+      }
+
+      const toolEntry = {
+        tool: {
+          name: tool.name,
+          title: tool.title || tool.name,
+          description: tool.description,
+          inputSchema: tool.inputSchema ? JSON.parse(JSON.stringify(tool.inputSchema)) : { type: 'object', properties: {} },
+          execute: tool.execute,
+          annotations: tool.annotations ? { ...tool.annotations } : {}
+        },
+        options: { ...options }
+      };
+
+      this._registeredTools.set(tool.name, toolEntry);
+
+      if (options?.signal) {
+        options.signal.addEventListener('abort', () => {
+          if (this._registeredTools.get(tool.name) === toolEntry) {
+            this._registeredTools.delete(tool.name);
+            this._dispatchToolChange();
+          }
+        }, { once: true });
+      }
+
+      this._dispatchToolChange();
+    }
+
+    _dispatchToolChange() {
+      const ev = new Event('toolchange');
+      this.dispatchEvent(ev);
+      if (typeof this.ontoolchange === 'function') {
+        this.ontoolchange.call(this, ev);
+      }
+    }
+
+    async getTools(options = {}) {
+      const tools = [];
+
+      // 1. Imperative tools
+      for (const entry of this._registeredTools.values()) {
+        const t = entry.tool;
+        tools.push({
+          name: t.name,
+          title: t.title,
+          description: t.description,
+          inputSchema: JSON.parse(JSON.stringify(t.inputSchema)),
+          window: typeof window !== 'undefined' ? window : null,
+          origin: typeof window !== 'undefined' ? window.location.origin : '',
+          annotations: { ...t.annotations }
+        });
+      }
+
+      // 2. Declarative forms with toolname
+      if (typeof document !== 'undefined') {
+        const declarativeForms = document.querySelectorAll('form[toolname]');
+        for (const form of declarativeForms) {
+          const formToolName = form.getAttribute('toolname');
+          if (!formToolName || this._registeredTools.has(formToolName)) {
+            continue;
+          }
+
+          const formDescription = form.getAttribute('tooldescription') || '';
+          const schema = this._synthesizeFormSchema(form);
+
+          tools.push({
+            name: formToolName,
+            title: formToolName,
+            description: formDescription,
+            inputSchema: schema,
+            window: typeof window !== 'undefined' ? window : null,
+            origin: typeof window !== 'undefined' ? window.location.origin : '',
+            annotations: {
+              readOnlyHint: form.getAttribute('toolautosubmit') !== null,
+              consequentialHint: !form.hasAttribute('toolautosubmit')
+            }
+          });
+        }
+      }
+
+      return tools;
+    }
+
+    _synthesizeFormSchema(form) {
+      const properties = {};
+      const required = [];
+
+      const elements = form.elements || [];
+      for (let i = 0; i < elements.length; i++) {
+        const el = elements[i];
+        if (!el.name || el.type === 'submit' || el.type === 'button') continue;
+
+        let description = el.getAttribute('toolparamdescription');
+        if (!description && el.id) {
+          const label = form.querySelector(`label[for="${el.id}"]`);
+          if (label) description = label.textContent?.trim();
+        }
+        if (!description) {
+          description = el.getAttribute('aria-description') || el.placeholder || el.name;
+        }
+
+        const propDef = {
+          type: el.type === 'number' ? 'number' : 'string',
+          description: description || ''
+        };
+
+        if (el.tagName === 'SELECT') {
+          const options = Array.from(el.options || []).map(o => o.value).filter(Boolean);
+          if (options.length > 0) propDef.enum = options;
+        }
+
+        if (el.required) {
+          required.push(el.name);
+        }
+
+        properties[el.name] = propDef;
+      }
+
+      return {
+        type: 'object',
+        properties,
+        ...(required.length > 0 ? { required } : {})
+      };
+    }
+
+    async executeTool(toolRef, inputObject = {}, options = {}) {
+      const toolName = typeof toolRef === 'string' ? toolRef : toolRef?.name;
+      if (!toolName) {
+        throw new TypeError('Invalid tool reference passed to executeTool');
+      }
+
+      if (options?.signal?.aborted) {
+        const abortErr = new Error('Tool execution aborted');
+        abortErr.name = 'AbortError';
+        throw abortErr;
+      }
+
+      // Check registered tools first
+      const registered = this._registeredTools.get(toolName);
+      let executeFn = registered?.tool.execute;
+
+      // Check declarative forms
+      if (!executeFn && typeof document !== 'undefined') {
+        const form = document.querySelector(`form[toolname="${toolName}"]`);
+        if (form) {
+          executeFn = async (input, execOpts) => {
+            return this._executeDeclarativeForm(form, input, execOpts);
+          };
+        }
+      }
+
+      if (!executeFn) {
+        throw new Error(`Tool "${toolName}" was not found or was unregistered`);
+      }
+
+      // Dispatch toolactivated
+      const actEv = new ToolActivatedEvent('toolactivated', { toolName });
+      this.dispatchEvent(actEv);
+      if (typeof this.ontoolactivated === 'function') {
