+          err.name = 'AbortError';
+          throw err;
+        }
+
+        if (!itemId || typeof itemId !== 'string') {
+          return {
+            error: 'Missing required parameter "itemId".',
+            availableItemIds: store.menu.map(m => m.id)
+          };
+        }
+
+        const item = store.getMenuItem(itemId);
+        if (!item) {
+          return {
+            error: `Menu item "${itemId}" not found.`,
+            availableItemIds: store.menu.map(m => m.id)
