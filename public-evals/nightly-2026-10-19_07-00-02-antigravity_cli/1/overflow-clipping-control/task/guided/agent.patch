+    /* Showcase Section */
+    .showcase-section {
+      margin-bottom: 50px;
+    }
+
+    .showcase-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+      gap: 30px;
+      margin-top: 20px;
+    }
+
+    /* Nested Curve Parent */
+    .nested-curve-parent {
+      background: white;
+      padding: 16px;
+      border-radius: 32px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      /* Level 1 Fallback: clips child roughly at padding box */
+      overflow: hidden;
+      overflow: clip;
+      overflow-clip-margin: content-box;
+    }
+
+    .nested-curve-parent img {
+      width: 100%;
+      height: 200px;
+      object-fit: cover;
+      display: block;
+    }
+
+    .nested-curve-body {
+      padding: 16px 8px 8px;
+    }
+
+    .nested-curve-body h3 {
+      margin-bottom: 8px;
+      color: var(--primary);
+    }
+
+    .nested-curve-footer,
+    .nested-curve-parent footer {
+      background: var(--primary);
+      color: white;
+      padding: 12px 16px;
+      text-align: center;
+      font-weight: 600;
+      font-size: 0.9rem;
+      margin-top: 12px;
+    }
+
+    @supports (overflow-clip-margin: content-box) {
+      .nested-curve-parent {
+        overflow: clip;
+        overflow-clip-margin: content-box;
+      }
+    }
+
+    /* Safety Zone Parent */
+    .safety-zone-parent {
+      background: white;
+      padding: 28px;
+      border-radius: 20px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      /* Level 1 Fallback */
+      overflow: hidden;
+      overflow: clip;
+      overflow-clip-margin: 15px;
+    }
+
+    .safety-zone-parent h3 {
+      margin-bottom: 12px;
+      color: var(--primary);
+    }
+
+    .safety-zone-parent .glowing-btn,
+    .safety-zone-parent button {
+      display: inline-block;
+      background: var(--accent);
+      color: var(--primary);
+      padding: 12px 24px;
+      border: none;
+      border-radius: 5px;
+      font-size: 1rem;
+      font-weight: bold;
+      cursor: pointer;
+      margin-top: 15px;
+      box-shadow: 0 0 15px rgba(255, 171, 64, 0.9), 0 0 25px rgba(255, 171, 64, 0.5);
+      transition: background 0.3s, box-shadow 0.3s;
+    }
+
+    .safety-zone-parent .glowing-btn:hover,
+    .safety-zone-parent button:hover {
+      box-shadow: 0 0 20px rgba(255, 171, 64, 1), 0 0 35px rgba(255, 171, 64, 0.7);
+    }
+
+    @supports (overflow-clip-margin: 15px) {
+      .safety-zone-parent {
+        overflow: clip;
+        overflow-clip-margin: 15px;
+      }
+    }
+
