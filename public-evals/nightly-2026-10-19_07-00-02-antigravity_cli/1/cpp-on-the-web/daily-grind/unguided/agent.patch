+#include <stdint.h>
+#include <math.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <vector>
+
+// smallpt: Global Illumination in 99 lines of C++ by Kevin Beason, 2008
+// http://www.kevinbeason.com/smallpt/
+// Ported to WebAssembly / HTML5 Canvas by compiling with Emscripten.
+
+struct Vec {
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; }
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+
+struct Ray {
+  Vec o, d;
+  Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+
+// Original Cornell Box spheres
+static const Sphere default_spheres[] = {
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF), // 0: Left wall
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF), // 1: Right wall
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF), // 2: Back wall
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF), // 3: Front wall
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF), // 4: Bottom / floor
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF), // 5: Top / ceiling
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC), // 6: Mirror sphere
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR), // 7: Glass sphere
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF)  // 8: Light source
+};
+
+static Sphere spheres[] = {
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF)
+};
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) {
+    if (erand48(Xi)<p) f=f*(1/p);
+    else return obj.e; // Russian roulette termination
+  }
+  if (depth > 64) return obj.e; // Stack safety guard
+
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC) {          // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  }
+
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+static std::vector<uint8_t> rgba_buf;
+static std::vector<Vec> c_buf;
+static int cur_w = 0, cur_h = 0;
+static uint32_t render_seed = 1337;
+
+static double rnd01() {
+  return (double)rand() / (double)RAND_MAX;
+}
+
+extern "C" {
+
+void init_buffer(int w, int h) {
+  cur_w = w;
+  cur_h = h;
+  rgba_buf.assign(w * h * 4, 0);
+  c_buf.assign(w * h, Vec());
+}
+
+void set_seed(uint32_t seed) {
+  render_seed = seed;
+  srand(seed);
+}
+
+void render_row_range(int row_start, int row_end, int samps) {
+  int w = cur_w, h = cur_h;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+
+  for (int row = row_start; row < row_end && row < h; row++) {
+    int y = h - 1 - row; // Map canvas row to smallpt y
+    unsigned short Xi[3] = {
+      (unsigned short)(render_seed & 0xffff),
+      (unsigned short)((render_seed >> 16) ^ row),
+      (unsigned short)(y * y * y + row)
+    };
+    for (int x = 0; x < w; x++) {
+      int i = row * w + x;
+      Vec accum;
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++) {
+          r = Vec();
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          }
+          accum = accum + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      c_buf[i] = accum;
+      rgba_buf[i * 4 + 0] = toInt(c_buf[i].x);
+      rgba_buf[i * 4 + 1] = toInt(c_buf[i].y);
+      rgba_buf[i * 4 + 2] = toInt(c_buf[i].z);
+      rgba_buf[i * 4 + 3] = 255;
+    }
+  }
+}
+
+void render_all(int samps) {
+  render_row_range(0, cur_h, samps);
+}
+
+uint8_t* get_framebuffer() {
+  return rgba_buf.data();
+}
+
+void randomize_spheres_only() {
+  // Mirror sphere (6)
+  spheres[6].c = Vec(0.2 + 0.79 * rnd01(), 0.2 + 0.79 * rnd01(), 0.2 + 0.79 * rnd01());
+  // Glass sphere (7)
+  spheres[7].c = Vec(0.2 + 0.79 * rnd01(), 0.2 + 0.79 * rnd01(), 0.2 + 0.79 * rnd01());
+}
+
+void randomize_colors() {
+  // Randomize all spheres in scene (both interior spheres and walls)
+  spheres[0].c = Vec(0.1 + 0.75 * rnd01(), 0.1 + 0.75 * rnd01(), 0.1 + 0.75 * rnd01()); // Left wall
+  spheres[1].c = Vec(0.1 + 0.75 * rnd01(), 0.1 + 0.75 * rnd01(), 0.1 + 0.75 * rnd01()); // Right wall
+  spheres[2].c = Vec(0.2 + 0.65 * rnd01(), 0.2 + 0.65 * rnd01(), 0.2 + 0.65 * rnd01()); // Back wall
+  spheres[4].c = Vec(0.2 + 0.65 * rnd01(), 0.2 + 0.65 * rnd01(), 0.2 + 0.65 * rnd01()); // Floor
+  spheres[5].c = Vec(0.2 + 0.65 * rnd01(), 0.2 + 0.65 * rnd01(), 0.2 + 0.65 * rnd01()); // Ceiling
+  spheres[6].c = Vec(0.2 + 0.79 * rnd01(), 0.2 + 0.79 * rnd01(), 0.2 + 0.79 * rnd01()); // Mirror sphere
+  spheres[7].c = Vec(0.2 + 0.79 * rnd01(), 0.2 + 0.79 * rnd01(), 0.2 + 0.79 * rnd01()); // Glass sphere
+}
+
+void reset_default_colors() {
+  for (int i = 0; i < 9; i++) {
+    spheres[i] = default_spheres[i];
+  }
+}
+
+void set_sphere_color(int id, double r, double g, double b) {
+  if (id >= 0 && id < 9) {
+    spheres[id].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+double get_sphere_r(int id) {
+  return (id >= 0 && id < 9) ? spheres[id].c.x : 0;
+}
+
+double get_sphere_g(int id) {
+  return (id >= 0 && id < 9) ? spheres[id].c.y : 0;
+}
+
+double get_sphere_b(int id) {
+  return (id >= 0 && id < 9) ? spheres[id].c.z : 0;
+}
+
+}
