+
+        if (currentRow < height) {
+          requestAnimationFrame(renderChunk);
+        } else {
+          const t1 = performance.now();
+          const ms = Math.round(t1 - t0);
+          const sec = (ms / 1000).toFixed(2);
+          progressBar.style.width = '100%';
+          statusText.textContent = `Completed in ${sec}s (${ms} ms) • ${spp} spp • ${width}×${height}`;
+        }
+      }
+
+      requestAnimationFrame(renderChunk);
+    }
+
+    function randomizeColorsAndRender() {
+      if (!Module) return;
+      const mode = selectRandomizeMode.value;
+      if (mode === 'spheres_only') {
+        Module._randomize_spheres_only();
+      } else {
+        Module._randomize_colors();
+      }
+      updateSwatches();
+      startRender();
+    }
+
+    function resetColorsAndRender() {
+      if (!Module) return;
+      Module._reset_default_colors();
+      updateSwatches();
+      startRender();
+    }
+
+    // Event listeners
+    btnRandomize.addEventListener('click', randomizeColorsAndRender);
+    btnRender.addEventListener('click', startRender);
+    btnReset.addEventListener('click', resetColorsAndRender);
+
+    selectRes.addEventListener('change', () => startRender());
+    selectSpp.addEventListener('change', () => startRender());
+
+    btnSave.addEventListener('click', () => {
+      const link = document.createElement('a');
+      link.download = `smallpt-${Date.now()}.png`;
+      link.href = canvas.toDataURL('image/png');
+      link.click();
+    });
+
+    // Initialize WebAssembly module
+    createSmallptModule().then(loadedModule => {
+      Module = loadedModule;
+      updateSwatches();
+      statusText.textContent = 'WebAssembly loaded! Starting initial render...';
+      startRender();
+    }).catch(err => {
+      console.error('Failed to load smallpt WebAssembly module:', err);
+      statusText.textContent = 'Error loading WebAssembly: ' + err.message;
+    });
+  </script>
+</body>
 </html>
