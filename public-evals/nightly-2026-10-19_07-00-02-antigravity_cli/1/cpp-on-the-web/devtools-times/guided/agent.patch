+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;
+  int id=0;
+  if (!intersect(r, t, id)) return Vec();
+  const Sphere &obj = spheres[id];
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z;
+  if (++depth>5) {
+    if (erand48(Xi)<p) f=f*(1/p);
+    else return obj.e;
+  }
+  if (obj.refl == DIFF){
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC) {
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  }
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));
+  bool into = n.dot(nl)>0;
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+static std::vector<uint8_t> g_rgba_buffer;
+static std::vector<Vec> g_accum_buffer;
+static int g_current_w = 0;
+static int g_current_h = 0;
+
+static double rand_uniform() {
+  return (double)rand() / (double)RAND_MAX;
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+int get_num_spheres() {
+  return sizeof(spheres) / sizeof(Sphere);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int id, double r, double g, double b) {
+  if (id >= 0 && id < (int)(sizeof(spheres) / sizeof(Sphere))) {
+    spheres[id].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_r(int id) {
+  if (id >= 0 && id < (int)(sizeof(spheres) / sizeof(Sphere))) return spheres[id].c.x;
+  return 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_g(int id) {
+  if (id >= 0 && id < (int)(sizeof(spheres) / sizeof(Sphere))) return spheres[id].c.y;
+  return 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_b(int id) {
+  if (id >= 0 && id < (int)(sizeof(spheres) / sizeof(Sphere))) return spheres[id].c.z;
+  return 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors() {
+  // Randomize colors for the Cornell box spheres (index 6: mirror, index 7: glass)
+  // Reflectances are chosen between 0.15 and 0.95 for lively colors and proper energy conservation
+  spheres[6].c = Vec(0.15 + 0.80 * rand_uniform(),
+                     0.15 + 0.80 * rand_uniform(),
+                     0.15 + 0.80 * rand_uniform());
+  spheres[7].c = Vec(0.15 + 0.80 * rand_uniform(),
+                     0.15 + 0.80 * rand_uniform(),
+                     0.15 + 0.80 * rand_uniform());
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_wall_colors() {
+  // Left wall (0) and right wall (1)
+  spheres[0].c = Vec(0.15 + 0.80 * rand_uniform(),
+                     0.15 + 0.80 * rand_uniform(),
+                     0.15 + 0.80 * rand_uniform());
+  spheres[1].c = Vec(0.15 + 0.80 * rand_uniform(),
+                     0.15 + 0.80 * rand_uniform(),
+                     0.15 + 0.80 * rand_uniform());
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_all_colors() {
+  randomize_wall_colors();
+  randomize_sphere_colors();
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_default_colors() {
+  spheres[0].c = Vec(.75,.25,.25); // Left
+  spheres[1].c = Vec(.25,.25,.75); // Right
+  spheres[2].c = Vec(.75,.75,.75); // Back
+  spheres[3].c = Vec();            // Front
+  spheres[4].c = Vec(.75,.75,.75); // Bottom
+  spheres[5].c = Vec(.75,.75,.75); // Top
+  spheres[6].c = Vec(1,1,1)*.999;  // Mirror
+  spheres[7].c = Vec(1,1,1)*.999;  // Glass
+  spheres[8].c = Vec();            // Light
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* init_buffer(int w, int h) {
+  g_current_w = w;
+  g_current_h = h;
+  g_rgba_buffer.assign(w * h * 4, 255);
+  g_accum_buffer.assign(w * h, Vec());
+  return g_rgba_buffer.data();
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_buffer_ptr() {
+  return g_rgba_buffer.data();
+}
+
+// Render a single scanline row (0 <= row < h, where 0 is top)
+EMSCRIPTEN_KEEPALIVE
+void render_row(int row, int w, int h, int samps) {
+  if (w != g_current_w || h != g_current_h) {
+    init_buffer(w, h);
+  }
+  if (row < 0 || row >= h) return;
+
+  int y = h - row - 1; // map image row (0 at top) to smallpt y (0 at bottom)
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135;
+
+  for (unsigned short x=0, Xi[3]={0,0,(unsigned short)(y*y*y)}; x<w; x++) {
+    int idx = row * w + x;
+    g_accum_buffer[idx] = Vec(0, 0, 0);
+
+    for (int sy=0; sy<2; sy++) {
+      for (int sx=0; sx<2; sx++) {
+        Vec r(0, 0, 0);
+        for (int s=0; s<samps; s++) {
+          double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+          double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+          Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                  cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+          r = r + radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+        }
+        g_accum_buffer[idx] = g_accum_buffer[idx] + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+      }
+    }
+
+    int pixel_idx = idx * 4;
+    Vec col = g_accum_buffer[idx];
+    g_rgba_buffer[pixel_idx + 0] = toInt(col.x);
+    g_rgba_buffer[pixel_idx + 1] = toInt(col.y);
+    g_rgba_buffer[pixel_idx + 2] = toInt(col.z);
+    g_rgba_buffer[pixel_idx + 3] = 255;
+  }
+}
+
+// Render a contiguous range of scanlines [start_row, end_row)
+EMSCRIPTEN_KEEPALIVE
+void render_chunk(int start_row, int end_row, int w, int h, int samps) {
+  if (w != g_current_w || h != g_current_h) {
+    init_buffer(w, h);
+  }
+  if (start_row < 0) start_row = 0;
+  if (end_row > h) end_row = h;
+  for (int row = start_row; row < end_row; row++) {
+    render_row(row, w, h, samps);
+  }
+}
+
+// Render the entire image synchronously
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render(int w, int h, int samps) {
+  init_buffer(w, h);
+  for (int row = 0; row < h; row++) {
+    render_row(row, w, h, samps);
+  }
+  return g_rgba_buffer.data();
+}
+
+}
