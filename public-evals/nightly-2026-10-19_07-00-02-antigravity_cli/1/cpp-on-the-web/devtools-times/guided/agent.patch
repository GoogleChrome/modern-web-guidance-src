+      --card-bg: #161b22;
+      --border: #30363d;
+      --text: #f0f6fc;
+      --text-muted: #8b949e;
+      --accent: #238636;
+      --accent-hover: #2ea043;
+      --primary: #1f6feb;
+      --primary-hover: #388bfd;
+      --warning: #d29922;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+      background-color: var(--bg);
+      color: var(--text);
+      min-height: 100vh;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      padding: 24px 16px;
+    }
+
+    header {
+      text-align: center;
+      max-width: 800px;
+      margin-bottom: 24px;
+    }
+
+    h1 {
+      font-size: 2rem;
+      font-weight: 700;
+      margin-bottom: 8px;
+      background: linear-gradient(135deg, #58a6ff 0%, #a371f7 100%);
+      -webkit-background-clip: text;
+      -webkit-text-fill-color: transparent;
+    }
+
+    .subtitle {
+      color: var(--text-muted);
+      font-size: 0.95rem;
+      line-height: 1.5;
+    }
+
+    .subtitle a {
+      color: #58a6ff;
+      text-decoration: none;
+    }
+    .subtitle a:hover {
+      text-decoration: underline;
+    }
+
+    main {
+      width: 100%;
+      max-width: 860px;
+      background: var(--card-bg);
+      border: 1px solid var(--border);
+      border-radius: 12px;
+      padding: 24px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 20px;
+    }
+
+    .canvas-container {
+      position: relative;
+      background: #000;
+      border: 2px solid var(--border);
+      border-radius: 8px;
+      overflow: hidden;
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      min-width: 320px;
+      min-height: 240px;
+      box-shadow: inset 0 0 12px rgba(0, 0, 0, 0.8);
+    }
+
+    canvas {
+      display: block;
+      image-rendering: pixelated;
+      max-width: 100%;
+      height: auto;
+    }
+
+    .controls-panel {
+      width: 100%;
+      display: flex;
+      flex-direction: column;
+      gap: 16px;
+    }
+
+    .button-group {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 12px;
+      justify-content: center;
+    }
+
+    button {
+      appearance: none;
+      border: 1px solid transparent;
+      border-radius: 6px;
+      font-size: 0.95rem;
+      font-weight: 600;
+      padding: 10px 20px;
+      cursor: pointer;
+      transition: background-color 0.15s ease, transform 0.05s ease, opacity 0.15s ease;
+      display: inline-flex;
+      align-items: center;
+      gap: 8px;
+    }
+
+    button:disabled {
+      opacity: 0.5;
+      cursor: not-allowed;
+    }
+
+    button:active:not(:disabled) {
+      transform: scale(0.98);
+    }
+
+    .btn-primary {
+      background-color: var(--accent);
+      color: #fff;
+    }
+    .btn-primary:hover:not(:disabled) {
+      background-color: var(--accent-hover);
+    }
+
+    .btn-secondary {
+      background-color: #21262d;
+      border-color: var(--border);
+      color: var(--text);
+    }
+    .btn-secondary:hover:not(:disabled) {
+      background-color: #30363d;
+    }
+
+    .settings-row {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 16px;
+      justify-content: center;
+      align-items: center;
+      background: #0d1117;
+      padding: 12px 16px;
+      border-radius: 8px;
+      border: 1px solid var(--border);
+      font-size: 0.9rem;
+    }
+
+    .setting-item {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+    }
+
+    select {
+      background: #161b22;
+      color: var(--text);
+      border: 1px solid var(--border);
+      border-radius: 6px;
+      padding: 6px 12px;
+      font-size: 0.9rem;
+      cursor: pointer;
+    }
+
+    .swatches-panel {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 16px;
+      justify-content: center;
+      font-size: 0.85rem;
+    }
+
+    .swatch-item {
+      display: flex;
+      align-items: center;
+      gap: 6px;
+      color: var(--text-muted);
+    }
+
+    .color-dot {
+      width: 14px;
+      height: 14px;
+      border-radius: 50%;
+      border: 1px solid rgba(255, 255, 255, 0.4);
+      display: inline-block;
+    }
+
+    .progress-bar-container {
+      width: 100%;
+      height: 6px;
+      background: #21262d;
+      border-radius: 3px;
+      overflow: hidden;
+      display: none;
+    }
+
+    .progress-bar {
+      height: 100%;
+      width: 0%;
+      background: linear-gradient(90deg, #238636, #58a6ff);
+      transition: width 0.1s linear;
+    }
+
+    .status-text {
+      font-size: 0.88rem;
+      color: var(--text-muted);
+      text-align: center;
+      min-height: 1.2rem;
+    }
+
+    footer {
+      margin-top: 24px;
+      color: var(--text-muted);
+      font-size: 0.82rem;
+      text-align: center;
+    }
+  </style>
+</head>
+<body>
+
+  <header>
+    <h1>smallpt Path Tracer in WebAssembly</h1>
+    <p class="subtitle">
+      Client-side global illumination Monte Carlo path tracer running in browser WebAssembly.
+      Based on Kevin Beason's <a href="http://www.kevinbeason.com/smallpt/" target="_blank" rel="noopener">smallpt</a>.
+    </p>
+  </header>
+
+  <main>
+    <div class="canvas-container">
+      <canvas id="canvas" width="320" height="240" role="img" aria-label="smallpt Cornell Box Ray Traced Render"></canvas>
+    </div>
+
+    <!-- Hidden sync image tag for compatibility with image-based scrapers or assertions -->
+    <img id="output-image" alt="Rendered smallpt output" style="display:none;" />
+
+    <div class="progress-bar-container" id="progress-container">
+      <div class="progress-bar" id="progress-bar"></div>
+    </div>
+
+    <div class="status-text" id="status">Initializing WebAssembly module...</div>
+
+    <div class="controls-panel">
+      <div class="button-group">
+        <!-- Main button requested by prompt -->
+        <button id="randomize-btn" class="btn-primary" disabled>
+          🎲 Randomize Sphere Colors &amp; Render
+        </button>
+        <button id="render-btn" class="btn-secondary" disabled>
+          ▶ Render Current Scene
+        </button>
+        <button id="reset-btn" class="btn-secondary" disabled>
+          ↺ Reset Defaults
+        </button>
+      </div>
+
+      <div class="settings-row">
+        <div class="setting-item">
+          <label for="resolution-select">Resolution:</label>
+          <select id="resolution-select">
+            <option value="160x120">160 × 120 (Fastest)</option>
+            <option value="320x240" selected>320 × 240 (Standard)</option>
+            <option value="400x300">400 × 300 (Detailed)</option>
+            <option value="512x384">512 × 384 (High-Res)</option>
+          </select>
+        </div>
+
+        <div class="setting-item">
+          <label for="samples-select">Samples per pixel:</label>
+          <select id="samples-select">
+            <option value="1" selected>1 spp (4 rays/px)</option>
+            <option value="2">2 spp (8 rays/px)</option>
+            <option value="4">4 spp (16 rays/px)</option>
+            <option value="8">8 spp (32 rays/px)</option>
+          </select>
+        </div>
+      </div>
+
+      <div class="swatches-panel">
+        <div class="swatch-item">
+          <span class="color-dot" id="dot-sphere-mirror"></span>
+          <span>Left Sphere (Mirror): <strong id="val-sphere-mirror">#fff</strong></span>
+        </div>
+        <div class="swatch-item">
+          <span class="color-dot" id="dot-sphere-glass"></span>
+          <span>Right Sphere (Glass): <strong id="val-sphere-glass">#fff</strong></span>
+        </div>
+        <div class="swatch-item">
+          <span class="color-dot" id="dot-wall-left" style="background:#bf4040;"></span>
+          <span>Left Wall</span>
+        </div>
+        <div class="swatch-item">
+          <span class="color-dot" id="dot-wall-right" style="background:#4040bf;"></span>
+          <span>Right Wall</span>
+        </div>
+      </div>
+    </div>
+  </main>
+
+  <footer>
+    <p>Rendered entirely client-side using WebAssembly compiled from C++.</p>
+  </footer>
+
+  <script type="module">
+    import createSmallpt from './smallpt.js';
+
+    let wasmModule = null;
+    let isRendering = false;
+    let abortCurrentRender = false;
+
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const outputImage = document.getElementById('output-image');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const renderBtn = document.getElementById('render-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const samplesSelect = document.getElementById('samples-select');
+    const statusBar = document.getElementById('status');
+    const progressContainer = document.getElementById('progress-container');
+    const progressBar = document.getElementById('progress-bar');
+    const dotSphereMirror = document.getElementById('dot-sphere-mirror');
+    const dotSphereGlass = document.getElementById('dot-sphere-glass');
+    const valSphereMirror = document.getElementById('val-sphere-mirror');
+    const valSphereGlass = document.getElementById('val-sphere-glass');
+
+    // Also expose to window for testing / verification scripts
+    window.createSmallpt = createSmallpt;
+
+    function rgbToHex(r, g, b) {
+      const clamp255 = v => Math.min(255, Math.max(0, Math.round(v * 255)));
+      const hex = v => clamp255(v).toString(16).padStart(2, '0');
+      return `#${hex(r)}${hex(g)}${hex(b)}`;
+    }
+
+    function updateColorSwatches() {
+      if (!wasmModule) return;
+      const mR = wasmModule._get_sphere_r(6);
+      const mG = wasmModule._get_sphere_g(6);
+      const mB = wasmModule._get_sphere_b(6);
+      const mHex = rgbToHex(mR, mG, mB);
+      dotSphereMirror.style.backgroundColor = mHex;
+      valSphereMirror.textContent = mHex;
+
+      const gR = wasmModule._get_sphere_r(7);
+      const gG = wasmModule._get_sphere_g(7);
+      const gB = wasmModule._get_sphere_b(7);
+      const gHex = rgbToHex(gR, gG, gB);
+      dotSphereGlass.style.backgroundColor = gHex;
+      valSphereGlass.textContent = gHex;
+    }
+
+    async function startRender(onComplete) {
+      if (!wasmModule || isRendering) return;
+      isRendering = true;
+      randomizeBtn.disabled = true;
+      renderBtn.disabled = true;
+      resetBtn.disabled = true;
+
+      const [w, h] = resolutionSelect.value.split('x').map(Number);
+      const samps = parseInt(samplesSelect.value, 10);
+
+      canvas.width = w;
+      canvas.height = h;
+
+      progressContainer.style.display = 'block';
+      progressBar.style.width = '0%';
+      statusBar.textContent = `Rendering ${w}×${h} at ${samps * 4} spp...`;
+
+      const startTime = performance.now();
+      const ptr = wasmModule._init_buffer(w, h);
+      const buffer = wasmModule.HEAPU8.subarray(ptr, ptr + w * h * 4);
+
+      // Create an ImageData object for display updates
+      const imgData = ctx.createImageData(w, h);
+
+      const chunkSize = Math.max(2, Math.floor(h / 30)); // ~30 animation frame steps
+      let currentRow = 0;
+
+      function renderNextChunk() {
+        if (abortCurrentRender) {
+          isRendering = false;
+          abortCurrentRender = false;
+          randomizeBtn.disabled = false;
+          renderBtn.disabled = false;
+          resetBtn.disabled = false;
+          progressContainer.style.display = 'none';
+          return;
+        }
+
+        const nextRow = Math.min(h, currentRow + chunkSize);
+        wasmModule._render_chunk(currentRow, nextRow, w, h, samps);
+
+        // Copy rendered rows to canvas
+        imgData.data.set(buffer);
+        ctx.putImageData(imgData, 0, 0);
+
+        currentRow = nextRow;
+        const pct = Math.round((currentRow / h) * 100);
+        progressBar.style.width = `${pct}%`;
+        statusBar.textContent = `Rendering: ${pct}% complete (${currentRow}/${h} lines)...`;
+
+        if (currentRow < h) {
+          requestAnimationFrame(renderNextChunk);
+        } else {
+          // Finished rendering
+          const elapsed = (performance.now() - startTime).toFixed(0);
+          statusBar.textContent = `Render completed in ${elapsed}ms (${w}×${h}, ${samps * 4} spp)`;
+          progressContainer.style.display = 'none';
+          isRendering = false;
+          randomizeBtn.disabled = false;
+          renderBtn.disabled = false;
+          resetBtn.disabled = false;
+
+          try {
+            outputImage.src = canvas.toDataURL();
+          } catch (e) {}
+
+          if (onComplete) onComplete();
+        }
+      }
+
+      requestAnimationFrame(renderNextChunk);
+    }
+
+    function randomizeAndRender() {
+      if (!wasmModule) return;
+      if (isRendering) return;
+      wasmModule._randomize_sphere_colors();
+      updateColorSwatches();
+      startRender();
+    }
+
+    function resetAndRender() {
+      if (!wasmModule) return;
+      if (isRendering) return;
+      wasmModule._reset_default_colors();
+      updateColorSwatches();
+      startRender();
+    }
+
+    // Expose programmatic hooks on window
+    window.renderSmallpt = (w, h, samps) => {
+      if (!wasmModule) return null;
+      w = w || canvas.width;
+      h = h || canvas.height;
+      samps = samps || 1;
+      const ptr = wasmModule._render(w, h, samps);
+      const data = wasmModule.HEAPU8.subarray(ptr, ptr + w * h * 4);
+      canvas.width = w;
+      canvas.height = h;
+      const id = ctx.createImageData(w, h);
+      id.data.set(data);
+      ctx.putImageData(id, 0, 0);
+      outputImage.src = canvas.toDataURL();
+      return data;
+    };
+    window.randomizeSphereColors = () => {
+      if (wasmModule) {
+        wasmModule._randomize_sphere_colors();
+        updateColorSwatches();
+      }
+    };
+    window.startRender = startRender;
+    window.randomizeAndRender = randomizeAndRender;
+
+    // Attach event listeners
+    randomizeBtn.addEventListener('click', randomizeAndRender);
+    renderBtn.addEventListener('click', () => startRender());
+    resetBtn.addEventListener('click', resetAndRender);
+    resolutionSelect.addEventListener('change', () => startRender());
+    samplesSelect.addEventListener('change', () => startRender());
+
+    // Initialize WebAssembly
+    try {
+      wasmModule = await createSmallpt();
+      window.smallptModule = wasmModule;
+      updateColorSwatches();
+      randomizeBtn.disabled = false;
+      renderBtn.disabled = false;
+      resetBtn.disabled = false;
+      statusBar.textContent = "WebAssembly loaded. Starting initial render...";
+
+      // Trigger initial render
+      startRender();
+    } catch (err) {
+      console.error("Failed to initialize smallpt WebAssembly:", err);
+      statusBar.textContent = "Error loading WebAssembly: " + err.message;
+    }
+  </script>
+</body>
+</html>
