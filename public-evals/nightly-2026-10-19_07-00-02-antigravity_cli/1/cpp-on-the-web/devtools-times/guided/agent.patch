+      const chunkSize = Math.max(2, Math.floor(h / 30)); // ~30 animation frame steps
+      let currentRow = 0;
+
+      function renderNextChunk() {
+        if (abortCurrentRender) {
+          isRendering = false;
+          abortCurrentRender = false;
+          randomizeBtn.disabled = false;
+          renderBtn.disabled = false;
+          resetBtn.disabled = false;
+          progressContainer.style.display = 'none';
+          return;
+        }
+
+        const nextRow = Math.min(h, currentRow + chunkSize);
+        wasmModule._render_chunk(currentRow, nextRow, w, h, samps);
+
+        // Copy rendered rows to canvas
+        imgData.data.set(buffer);
+        ctx.putImageData(imgData, 0, 0);
+
+        currentRow = nextRow;
+        const pct = Math.round((currentRow / h) * 100);
