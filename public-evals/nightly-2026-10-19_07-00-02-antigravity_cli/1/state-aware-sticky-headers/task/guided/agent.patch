+      color: var(--primary);
+      border-radius: 6px;
+      transition: background-color 0.3s, box-shadow 0.3s, padding 0.3s, color 0.3s;
+    }
+
+    /* Stuck state styles via named container queries */
+    @container section-header scroll-state(stuck: top) {
+      .sticky-header {
