+  <script>
+    (function () {
+      const registerButton = document.querySelector('[data-testid="register-button"]');
+      const statusElement = document.getElementById('passkey-status');
+      let currentAbortController = null;
+
+      function setStatus(message, type = 'info') {
+        if (!statusElement) return;
+        statusElement.textContent = message;
+        statusElement.className = `passkey-status ${type}`;
+      }
+
+      function base64URLToBuffer(base64URL) {
+        if (typeof base64URL !== 'string') return base64URL;
+        let base64 = base64URL.trim().replace(/-/g, '+').replace(/_/g, '/');
+        while (base64.length % 4 !== 0) {
+          base64 += '=';
+        }
+        const binary = atob(base64);
+        const bytes = new Uint8Array(binary.length);
+        for (let i = 0; i < binary.length; i++) {
+          bytes[i] = binary.charCodeAt(i);
+        }
+        return bytes.buffer;
+      }
+
+      function bufferToBase64URL(buffer) {
+        if (!buffer) return '';
+        const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
+      }
+
+      function toBuffer(val) {
+        if (!val) return val;
+        if (val instanceof ArrayBuffer) return val;
+        if (ArrayBuffer.isView(val)) {
+          return val.buffer.slice(val.byteOffset, val.byteOffset + val.byteLength);
+        }
+        if (typeof val === 'string') {
+          return base64URLToBuffer(val);
+        }
+        return val;
+      }
+
+      function parseCreationOptions(optionsData) {
+        const opts = optionsData.publicKey || optionsData.options || optionsData;
+
+        if (
+          typeof PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function'
+        ) {
+          try {
+            return PublicKeyCredential.parseCreationOptionsFromJSON(opts);
+          } catch (e) {
+            console.warn('parseCreationOptionsFromJSON failed, using fallback:', e);
+          }
+        }
+
+        const creationOptions = { ...opts };
+        if (creationOptions.challenge) {
+          creationOptions.challenge = toBuffer(creationOptions.challenge);
+        }
+        if (creationOptions.user && creationOptions.user.id) {
+          creationOptions.user = {
+            ...creationOptions.user,
+            id: toBuffer(creationOptions.user.id),
+          };
+        }
+        if (Array.isArray(creationOptions.excludeCredentials)) {
+          creationOptions.excludeCredentials = creationOptions.excludeCredentials.map((cred) => ({
+            ...cred,
+            id: toBuffer(cred.id),
+          }));
+        }
+        return creationOptions;
+      }
+
+      function serializeCredential(credential) {
+        if (typeof credential.toJSON === 'function') {
+          const json = credential.toJSON();
+          if (
+            credential.response &&
+            typeof credential.response.getTransports === 'function' &&
+            json.response &&
+            !json.response.transports
+          ) {
+            json.response.transports = credential.response.getTransports();
+          }
+          return json;
+        }
+
+        const resp = credential.response || {};
+        const responsePayload = {
+          clientDataJSON: resp.clientDataJSON ? bufferToBase64URL(resp.clientDataJSON) : undefined,
+          attestationObject: resp.attestationObject ? bufferToBase64URL(resp.attestationObject) : undefined,
+        };
+
+        if (typeof resp.getTransports === 'function') {
+          responsePayload.transports = resp.getTransports();
+        } else if (resp.transports) {
+          responsePayload.transports = resp.transports;
+        }
+
+        if (typeof resp.getPublicKeyAlgorithm === 'function') {
+          try {
+            responsePayload.publicKeyAlgorithm = resp.getPublicKeyAlgorithm();
+          } catch (e) {}
+        } else if (resp.publicKeyAlgorithm !== undefined) {
+          responsePayload.publicKeyAlgorithm = resp.publicKeyAlgorithm;
+        }
+
+        if (typeof resp.getPublicKey === 'function') {
+          try {
+            const pk = resp.getPublicKey();
+            if (pk) responsePayload.publicKey = bufferToBase64URL(pk);
+          } catch (e) {}
+        } else if (resp.publicKey) {
+          responsePayload.publicKey = bufferToBase64URL(resp.publicKey);
+        }
+
+        if (typeof resp.getAuthenticatorData === 'function') {
+          try {
+            const ad = resp.getAuthenticatorData();
+            if (ad) responsePayload.authenticatorData = bufferToBase64URL(ad);
+          } catch (e) {}
+        } else if (resp.authenticatorData) {
+          responsePayload.authenticatorData = bufferToBase64URL(resp.authenticatorData);
+        }
+
+        return {
+          id: credential.id,
+          rawId: credential.rawId ? bufferToBase64URL(credential.rawId) : credential.id,
+          type: credential.type || 'public-key',
+          response: responsePayload,
+          clientExtensionResults:
+            typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : credential.clientExtensionResults || {},
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+        };
+      }
+
+      async function handlePasskeyRegistration() {
+        if (!window.PublicKeyCredential || !navigator.credentials || typeof navigator.credentials.create !== 'function') {
+          setStatus('WebAuthn / Passkeys are not supported by this browser.', 'error');
+          return;
+        }
+
+        if (currentAbortController) {
+          currentAbortController.abort();
+        }
+        currentAbortController = new AbortController();
+
+        registerButton.disabled = true;
+        const initialButtonText = registerButton.textContent;
+        registerButton.textContent = 'Creating passkey...';
+        setStatus('Fetching passkey options...', 'info');
+
+        try {
+          const optionsResponse = await fetch('/api/register/options', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            body: JSON.stringify({ promotion: true }),
+          });
+
+          if (!optionsResponse.ok) {
+            throw new Error(`Failed to fetch passkey options (${optionsResponse.status})`);
+          }
+
+          const optionsJSON = await optionsResponse.json();
+
+          setStatus('Follow your browser/device instructions to create your passkey...', 'info');
+          let credentialPayload;
+
+          if (window.SimpleWebAuthnBrowser && typeof window.SimpleWebAuthnBrowser.startRegistration === 'function') {
+            const rawOpts = optionsJSON.publicKey || optionsJSON.options || optionsJSON;
+            credentialPayload = await window.SimpleWebAuthnBrowser.startRegistration({ optionsJSON: rawOpts });
+          } else {
+            const creationOptions = parseCreationOptions(optionsJSON);
+            const credential = await navigator.credentials.create({
+              publicKey: creationOptions,
+              signal: currentAbortController.signal,
+            });
+
+            if (!credential) {
+              throw new Error('Registration ceremony did not return a credential.');
+            }
+
+            credentialPayload = serializeCredential(credential);
+          }
+
+          setStatus('Verifying passkey registration...', 'info');
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            body: JSON.stringify(credentialPayload),
+          });
+
+          if (!verifyResponse.ok) {
+            throw new Error(`Registration verification failed (${verifyResponse.status})`);
+          }
+
+          const verifyResult = await verifyResponse.json().catch(() => ({}));
+          if (verifyResult && verifyResult.verified === false) {
+            throw new Error(verifyResult.error || 'Verification was rejected by server.');
+          }
+
+          setStatus('Passkey successfully registered!', 'success');
+          registerButton.textContent = 'Passkey Created';
+          registerButton.disabled = true;
+        } catch (err) {
+          if (err.name === 'AbortError') {
+            console.info('Passkey registration aborted.');
+            return;
+          }
+
+          console.error('Passkey registration error:', err);
+          let message = err.message || 'An error occurred during passkey creation.';
+          if (err.name === 'NotAllowedError') {
+            message = 'Passkey registration was cancelled or timed out.';
+          } else if (err.name === 'InvalidStateError') {
+            message = 'This passkey is already registered for this account.';
+          } else if (err.name === 'NotSupportedError') {
+            message = 'The specified configuration or authenticator is not supported.';
+          } else if (err.name === 'SecurityError') {
+            message = 'Security error: The Relying Party ID is not valid for this origin.';
+          }
+
+          setStatus(message, 'error');
+          registerButton.disabled = false;
+          registerButton.textContent = initialButtonText;
+        } finally {
+          currentAbortController = null;
+        }
+      }
+
+      if (registerButton) {
+        registerButton.addEventListener('click', handlePasskeyRegistration);
+      }
+    })();
+  </script>
