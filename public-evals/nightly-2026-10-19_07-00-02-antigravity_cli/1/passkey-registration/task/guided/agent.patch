+  <script>
+    // Fallback converters for Base64URL and ArrayBuffer
+    function base64UrlToBuffer(base64url) {
+      if (!base64url) return new ArrayBuffer(0);
+      const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
+      const pad = base64.length % 4 === 0 ? '' : '='.repeat(4 - (base64.length % 4));
+      const binary = atob(base64 + pad);
+      const bytes = new Uint8Array(binary.length);
+      for (let i = 0; i < binary.length; i++) {
+        bytes[i] = binary.charCodeAt(i);
+      }
+      return bytes.buffer;
+    }
+
+    function bufferToBase64Url(buffer) {
+      if (!buffer) return '';
+      const bytes = new Uint8Array(buffer);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
+    }
+
+    function parseCreationOptionsFallback(options) {
+      const copy = { ...options };
+      if (typeof copy.challenge === 'string') {
+        copy.challenge = base64UrlToBuffer(copy.challenge);
+      }
+      if (copy.user && typeof copy.user.id === 'string') {
+        copy.user = {
+          ...copy.user,
+          id: base64UrlToBuffer(copy.user.id),
+        };
+      }
+      if (Array.isArray(copy.excludeCredentials)) {
+        copy.excludeCredentials = copy.excludeCredentials.map((cred) => {
+          if (typeof cred.id === 'string') {
+            return {
+              ...cred,
+              id: base64UrlToBuffer(cred.id),
+            };
+          }
+          return cred;
+        });
+      }
+      return copy;
+    }
+
+    function credentialToJSONFallback(cred) {
+      if (!cred) return null;
+      const res = {
+        id: cred.id,
+        rawId: cred.rawId ? bufferToBase64Url(cred.rawId) : cred.id,
+        type: cred.type,
+        response: {},
+      };
+      if (cred.response) {
+        if (cred.response.clientDataJSON) {
+          res.response.clientDataJSON = bufferToBase64Url(cred.response.clientDataJSON);
+        }
+        if (cred.response.attestationObject) {
+          res.response.attestationObject = bufferToBase64Url(cred.response.attestationObject);
+        }
+        if (cred.response.getTransports) {
+          res.response.transports = cred.response.getTransports();
+        }
+        if (cred.response.getPublicKeyAlgorithm) {
+          res.response.publicKeyAlgorithm = cred.response.getPublicKeyAlgorithm();
+        }
+        if (cred.response.getPublicKey) {
+          const pk = cred.response.getPublicKey();
+          if (pk) res.response.publicKey = bufferToBase64Url(pk);
+        }
+        if (cred.response.getAuthenticatorData) {
+          const ad = cred.response.getAuthenticatorData();
+          if (ad) res.response.authenticatorData = bufferToBase64Url(ad);
+        }
+      }
+      if (cred.authenticatorAttachment) {
+        res.authenticatorAttachment = cred.authenticatorAttachment;
+      }
+      if (cred.getClientExtensionResults) {
+        res.clientExtensionResults = cred.getClientExtensionResults();
+      }
+      return res;
+    }
+
+    async function optionsFetch(payload) {
+      const response = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify(payload),
+      });
+      if (!response.ok) {
+        throw new Error(`Options fetch failed with status ${response.status}`);
+      }
+      return await response.json();
+    }
+
+    async function registerVerifyFetch(encodedResponse) {
+      return await fetch('/api/register/verify', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify(encodedResponse),
+      });
+    }
+
+    async function registerPasskey(isPromotion = true) {
+      const promotion = typeof isPromotion === 'boolean' ? isPromotion : true;
+      const registerButton = document.querySelector('[data-testid="register-button"]');
+      const statusElement = document.getElementById('passkey-status');
+
+      // Verify passkey capability and conditional UI are available
+      if (window.PublicKeyCredential && typeof PublicKeyCredential.getClientCapabilities === 'function') {
+        try {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (
+            !capabilities?.passkeyPlatformAuthenticator ||
+            !capabilities?.conditionalGet
+          ) {
+            if (registerButton) registerButton.disabled = true;
+            if (statusElement) statusElement.textContent = 'Passkeys are not supported on this device.';
+            return;
+          }
+        } catch (err) {
+          console.warn('Error verifying capabilities:', err);
+        }
+      }
+
+      let creationOptionsJSON;
+      try {
+        creationOptionsJSON = await optionsFetch({ promotion });
+      } catch (err) {
+        console.error('Failed to fetch passkey creation options:', err);
+        if (statusElement) statusElement.textContent = 'Failed to fetch registration options.';
+        return;
+      }
+
+      const rawOptions = creationOptionsJSON.publicKey || creationOptionsJSON;
+      const publicKey = typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function'
+        ? PublicKeyCredential.parseCreationOptionsFromJSON(rawOptions)
+        : parseCreationOptionsFallback(rawOptions);
+
+      let credential;
+      try {
+        // passkey prompt execution
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        if (err.name === 'InvalidStateError') {
+          console.log('A passkey already exists for this account.');
+          alert('A passkey already exists for this account.');
+        } else if (err.name === 'SecurityError') {
+          console.error('Configuration RP ID or Secure Context error.');
+          alert('Configuration RP ID or Secure Context error.');
+        } else if (err.name === 'NotAllowedError') {
+          console.log('User cancelled the passkey dialog.');
+        } else if (err.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+        } else {
+          console.error('Passkey creation error:', err);
+        }
+        return; // Safe API exit, do not signal unknown for standard WebAuthn cancels
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      // Server Verification phase (Segregated Try/Catch)
+      const encodedResponse = typeof credential.toJSON === 'function'
+        ? credential.toJSON()
+        : credentialToJSONFallback(credential);
+
+      const rpId = (creationOptionsJSON.rp && creationOptionsJSON.rp.id) ||
+                   (rawOptions.rp && rawOptions.rp.id) ||
+                   window.location.hostname;
+
+      try {
+        const response = await registerVerifyFetch(encodedResponse);
+        if (!response.ok) {
+          if (statusElement) statusElement.textContent = 'Server verification failed.';
+          // Server verification failed to verify/authenticate the credential (orphaned)
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encodedResponse.id,
+            });
+          }
+          return;
+        }
+
+        if (statusElement) {
+          statusElement.textContent = 'Passkey registered successfully!';
+        }
+      } catch (serverErr) {
+        console.error('Server verification network failure:', serverErr);
+        if (statusElement) statusElement.textContent = 'Server verification network failure.';
+        if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId,
+            credentialId: encodedResponse.id,
+          });
+        }
+      }
+    }
+
+    // Gate UI on page load
+    async function initPasskeyUI() {
+      const registerButton = document.querySelector('[data-testid="register-button"]');
+      if (!registerButton) return;
+
+      registerButton.addEventListener('click', () => registerPasskey(true));
+
+      if (!window.PublicKeyCredential) {
+        registerButton.disabled = true;
+        return;
+      }
+
+      if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+        try {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (
+            !capabilities?.passkeyPlatformAuthenticator ||
+            !capabilities?.conditionalGet
+          ) {
+            registerButton.disabled = true;
+          }
+        } catch (err) {
+          console.warn('Error checking client capabilities:', err);
+        }
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initPasskeyUI);
+    } else {
+      initPasskeyUI();
+    }
+
+    window.registerPasskey = registerPasskey;
+  </script>
 </body>
 
