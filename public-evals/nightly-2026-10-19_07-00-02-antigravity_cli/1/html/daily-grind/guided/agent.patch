+  <!-- Focus Management, Invoker Commands, and Overlay Fallbacks Script -->
+  <script type="module">
+    // 1. Invoker Commands Fallback for browsers lacking 'commandForElement'
+    const hasInvokerSupport = 'commandForElement' in HTMLButtonElement.prototype;
+    if (!hasInvokerSupport) {
+      document.addEventListener('click', (event) => {
+        const button = event.composedPath().find(el => el.matches?.('button[commandfor]'));
+        if (!button) return;
+
+        const targetId = button.getAttribute('commandfor');
+        const command = button.getAttribute('command');
+        const target = document.getElementById(targetId);
+        if (!target) return;
+
+        if (command === 'show-modal' && typeof target.showModal === 'function') {
+          target.showModal();
+        } else if (command === 'close' && typeof target.close === 'function') {
+          target.close();
+        }
+      });
+    }
+
+    // 2. Light Dismiss Fallback for browsers lacking 'closedBy' support on <dialog>
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      document.querySelectorAll('dialog[closedby]').forEach(dialog => {
+        dialog.addEventListener('click', (event) => {
+          if (event.target !== dialog) return;
+          const rect = dialog.getBoundingClientRect();
+          const isDialogContent = (
+            rect.top <= event.clientY &&
+            event.clientY <= rect.top + rect.height &&
+            rect.left <= event.clientX &&
+            event.clientX <= rect.left + rect.width
+          );
+          if (isDialogContent) return;
+          dialog.close();
+        });
+      });
+    }
+
+    // 3. Focus Management: Restore focus to invoker button upon modal close
+    let lastActiveTrigger = null;
+    document.addEventListener('click', (event) => {
+      const invokerBtn = event.composedPath().find(el => el.matches?.('button[commandfor], .btn-details'));
+      if (invokerBtn) {
+        lastActiveTrigger = invokerBtn;
+      }
+    });
+
+    document.querySelectorAll('dialog').forEach(dialog => {
+      dialog.addEventListener('close', () => {
+        if (lastActiveTrigger && typeof lastActiveTrigger.focus === 'function') {
+          lastActiveTrigger.focus();
+        }
+      });
+    });
+
+    // 4. Populate dynamic details dialog when "View Details" is activated
+    const detailsDialog = document.getElementById('details-dialog');
+    const detailsTitle = document.getElementById('details-dialog-title');
+    const detailsDesc = document.getElementById('details-modal-desc');
+    const detailsPrice = document.getElementById('details-modal-price');
+    const detailsImg = document.getElementById('details-modal-img');
+    const detailsOrderAction = document.getElementById('details-order-action');
+    const orderDialog = document.getElementById('order-dialog');
+    const orderBeverage = document.getElementById('order-beverage');
+
+    document.querySelectorAll('.btn-details').forEach(button => {
+      button.addEventListener('click', () => {
+        const name = button.getAttribute('data-name');
+        const desc = button.getAttribute('data-desc');
+        const price = button.getAttribute('data-price');
+        const img = button.getAttribute('data-img');
+
+        if (detailsTitle) detailsTitle.textContent = name || 'Beverage Details';
+        if (detailsDesc) detailsDesc.textContent = desc || '';
+        if (detailsPrice) detailsPrice.textContent = price || '';
+        if (detailsImg) {
+          detailsImg.src = img || '';
+          detailsImg.alt = name || 'Coffee image';
+        }
+
+        // Pre-select this item in the order form if user proceeds
+        if (detailsOrderAction) {
+          detailsOrderAction.onclick = () => {
+            detailsDialog.close();
+            if (orderBeverage) {
+              const matchedOption = Array.from(orderBeverage.options).find(opt => opt.text.includes(name));
+              if (matchedOption) orderBeverage.value = matchedOption.value;
+            }
+            orderDialog.showModal();
+          };
+        }
+      });
+    });
+  </script>
