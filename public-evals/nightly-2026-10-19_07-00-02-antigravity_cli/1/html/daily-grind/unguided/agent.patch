+/**
+ * The Daily Grind - Interactive Overlays & Focus Management
+ */
+
+// Product catalog data for the details modal
+const PRODUCT_DATA = {
+  latte: {
+    title: 'Maple Oat Latte',
+    desc: 'Crafted with our signature medium espresso, steamed creamy oat milk, and infused with grade-A dark amber Vermont maple syrup. Lightly dusted with organic cinnamon.',
+    origin: 'Vermont (Syrup) / Colombia Huila (Beans)',
+    roast: 'Medium Roast',
+    notes: 'Sweet Maple, Caramelized Brown Sugar, Toasted Oats',
+    price: '$5.75',
+    imgSrc: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=600&q=80',
+    imgAlt: 'Creamy maple oat latte topped with delicate foam art'
+  },
+  espresso: {
+    title: 'Dark Roast Espresso',
+    desc: 'An intense, velvety double shot brewed under 9 bars of pressure. Characterized by a thick, golden crema and a deep, smokey profile that stands up well on its own or with a dash of milk.',
+    origin: 'Sumatra Mandheling & Brazilian Cerrado',
+    roast: 'Dark Roast',
+    notes: 'Dark Cocoa, Roasted Walnut, Molasses, Subtle Smoke',
+    price: '$3.95',
+    imgSrc: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=600&q=80',
+    imgAlt: 'Double shot of dark roast espresso with rich crema'
+  },
+  coldbrew: {
+    title: 'Cold Brew',
+    desc: 'Coarsely ground specialty beans steeped in cold, filtered mountain water for a full 18 hours. This slow-extraction process yields ultra-low acidity and maximum sweetness.',
+    origin: 'Ethiopia Yirgacheffe & Guatemala Antigua',
+    roast: 'Medium-Light Roast',
+    notes: 'Berry Jam, Milk Chocolate, Jasmine Blossom',
+    price: '$4.50',
+    imgSrc: 'https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=600&q=80',
+    imgAlt: 'Glass of iced cold brew coffee with condensation'
+  }
+};
+
+document.addEventListener('DOMContentLoaded', () => {
+  // Track last focused element to restore focus upon dialog closure
+  let lastFocusedTrigger = null;
+
+  // Dialog Elements
+  const detailsDialog = document.getElementById('details-dialog');
+  const orderDialog = document.getElementById('order-dialog');
+  const logoutDialog = document.getElementById('logout-dialog');
+  const allDialogs = [detailsDialog, orderDialog, logoutDialog].filter(Boolean);
+
+  // Helper to open a modal dialog with focus management
+  function openModal(dialog, triggerEl) {
+    if (!dialog) return;
+    lastFocusedTrigger = triggerEl || document.activeElement;
+    dialog.showModal();
+  }
+
+  // Setup close events & focus restoration for all native dialogs
+  allDialogs.forEach((dialog) => {
+    // Restore focus to opener when dialog closes
+    dialog.addEventListener('close', () => {
+      if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
+        lastFocusedTrigger.focus();
+        lastFocusedTrigger = null;
+      }
+    });
+
+    // Light dismiss on backdrop click
+    dialog.addEventListener('click', (event) => {
+      const rect = dialog.getBoundingClientRect();
+      const isInDialog = (
+        rect.top <= event.clientY &&
+        event.clientY <= rect.top + rect.height &&
+        rect.left <= event.clientX &&
+        event.clientX <= rect.left + rect.width
+      );
+      if (!isInDialog) {
+        dialog.close();
+      }
+    });
+  });
+
+  // Product Details Modal
+  const detailsImg = document.getElementById('details-img');
+  const detailsTitle = document.getElementById('details-title');
+  const detailsDesc = document.getElementById('details-desc');
+  const detailsOrigin = document.getElementById('details-origin');
+  const detailsRoast = document.getElementById('details-roast');
+  const detailsNotes = document.getElementById('details-notes');
+  const detailsPrice = document.getElementById('details-price');
+  const detailsOrderBtn = document.getElementById('details-order-btn');
+  let currentProductKey = 'latte';
+
+  document.querySelectorAll('[data-action="details"]').forEach((btn) => {
+    btn.addEventListener('click', (e) => {
+      const itemKey = btn.dataset.item;
+      const product = PRODUCT_DATA[itemKey];
+      if (!product) return;
+
+      currentProductKey = itemKey;
+      detailsImg.src = product.imgSrc;
+      detailsImg.alt = product.imgAlt;
+      detailsTitle.textContent = product.title;
+      detailsDesc.textContent = product.desc;
+      detailsOrigin.textContent = product.origin;
+      detailsRoast.textContent = product.roast;
+      detailsNotes.textContent = product.notes;
+      detailsPrice.textContent = product.price;
+
+      openModal(detailsDialog, btn);
+    });
+  });
+
+  // Switch from Details to Order Dialog
+  if (detailsOrderBtn && orderDialog) {
+    detailsOrderBtn.addEventListener('click', () => {
+      const savedTrigger = lastFocusedTrigger;
+      detailsDialog.close();
+      const beverageSelect = document.getElementById('beverage-select');
+      if (beverageSelect) {
+        beverageSelect.value = currentProductKey;
+      }
+      openModal(orderDialog, savedTrigger);
+    });
+  }
+
+  // Hero Order Button
+  const heroOrderBtn = document.getElementById('open-order-btn');
+  if (heroOrderBtn && orderDialog) {
+    heroOrderBtn.addEventListener('click', () => {
+      openModal(orderDialog, heroOrderBtn);
+    });
+  }
+
+  // Close buttons inside dialogs (manual close triggers)
+  const closeDetailsBtn = document.getElementById('close-details-btn');
+  if (closeDetailsBtn && detailsDialog) {
+    closeDetailsBtn.addEventListener('click', () => detailsDialog.close());
+  }
+
+  const closeOrderBtn = document.getElementById('close-order-btn');
+  if (closeOrderBtn && orderDialog) {
+    closeOrderBtn.addEventListener('click', () => orderDialog.close());
+  }
+
+  // Order Form Submission Handling
+  const confirmOrderBtn = document.getElementById('confirm-order-btn');
+  const toastNotification = document.getElementById('order-toast');
+
+  if (confirmOrderBtn && orderDialog) {
+    confirmOrderBtn.addEventListener('click', () => {
+      const beverageSelect = document.getElementById('beverage-select');
+      const selectedDrink = beverageSelect ? beverageSelect.options[beverageSelect.selectedIndex].text : 'Coffee';
+      
+      orderDialog.close();
+      showToast(`Order placed for ${selectedDrink}! It will be ready in 10 minutes.`);
+    });
+  }
+
+  // Logout Confirmation Dialog
+  const logoutBtn = document.getElementById('logout-btn');
+  const confirmLogoutBtn = document.getElementById('confirm-logout-btn');
+
+  if (logoutBtn && logoutDialog) {
+    logoutBtn.addEventListener('click', () => {
+      openModal(logoutDialog, logoutBtn);
+    });
+  }
+
+  if (confirmLogoutBtn && logoutDialog) {
+    confirmLogoutBtn.addEventListener('click', () => {
+      logoutDialog.close();
+      showToast('You have been securely signed out. See you soon!');
+    });
+  }
+
+  // Toast feedback helper
+  function showToast(message) {
+    if (!toastNotification) return;
+    toastNotification.textContent = message;
+    toastNotification.classList.add('visible');
+    setTimeout(() => {
+      toastNotification.classList.remove('visible');
+    }, 4500);
+  }
+});
