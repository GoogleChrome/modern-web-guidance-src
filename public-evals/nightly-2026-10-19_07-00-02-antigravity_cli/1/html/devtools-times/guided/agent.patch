   font-style: normal;
+}
+
+/* Native dialog backdrop styling */
+dialog::backdrop {
+  background-color: rgba(0, 0, 0, 0.4);
+  backdrop-filter: blur(4px);
+}
+
+/* Native popover styles & fallback */
+[popover]:is(:popover-open, .\:popover-open) {
+  display: block;
+}
+
+/* Focus visibility improvements */
+:focus-visible {
+  outline: 2px solid #f59e0b;
+  outline-offset: 2px;
+}
+
+/* Global inert styling */
+[inert], [inert] * {
+  opacity: 0.5;
+  cursor: default;
+  user-select: none;
