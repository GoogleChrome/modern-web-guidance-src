+        for (let i = 0; i < ripples.length && i < MAX_RIPPLES; i++) {
+          const idx = i * 4;
+          rippleData[idx] = ripples[i].x;
+          rippleData[idx + 1] = ripples[i].y;
+          rippleData[idx + 2] = ripples[i].age;
+          rippleData[idx + 3] = ripples[i].intensity;
+        }
+
+        // Pass uniforms
+        gl.uniform2f(uResLoc, canvas.width, canvas.height);
+        gl.uniform1f(uTimeLoc, elapsed);
+        gl.uniform2f(uMouseLoc, mouseX, mouseY);
+        gl.uniform1f(uMouseSpeedLoc, mouseSpeed);
+        gl.uniform1f(uHoverBtnLoc, hoverValue);
+        gl.uniform2f(uBtnCenterLoc, btnCenterX, btnCenterY);
+        gl.uniform4fv(uRipplesLoc, rippleData);
+        gl.uniform1i(uTextureLoc, 0);
+
+        // Draw quad
+        gl.drawArrays(gl.TRIANGLES, 0, 6);
+      }
+
+      requestAnimationFrame(animate);
+    })();
+  </script>
