+@layer reset, base, theme, components, utilities;
+
+/* ==========================================================================
+   Cascade Layer: Reset
+   - Avoid global reset on '*'
+   - Apply resets to specific element types
+   - Wrap in :where() to preserve zero specificity
+   - Prefer logical properties for directional resets
+   ========================================================================== */
+@layer reset {
+  :where(html, body, div, header, nav, main, section, footer, ul, ol, li, h1, h2, h3, p, a, button, img) {
+    box-sizing: border-box;
+  }
+
+  :where(body, h1, h2, h3, p, ul, ol, figure) {
+    margin-block: 0;
+    margin-inline: 0;
+    padding-block: 0;
+    padding-inline: 0;
+  }
+
+  :where(ul, ol) {
+    list-style: none;
+  }
+
+  :where(a) {
+    color: inherit;
+    text-decoration: none;
+  }
+
+  :where(button) {
+    font: inherit;
+    border: none;
+    background: transparent;
+  }
+
+  :where(img) {
+    max-inline-size: 100%;
+    display: block;
+  }
+}
+
+/* ==========================================================================
+   Cascade Layer: Theme (Design Tokens)
+   - Organized into hierarchical tiers:
+     Tier 1: Literal design tokens (raw palette, spacing scale, font stacks)
+     Tier 2: Semantic design tokens (roles, intent, semantic palettes)
+     Tier 3: General UI design tokens (shared UI patterns, radiuses, shadows)
+     Tier 4: Component-specific tokens (scoped component parameters)
+   ========================================================================== */
+@layer theme {
+  :root {
+    /* --- Tier 1: Literal design tokens --- */
+    --color-amber-400: #ffab40;
+    --color-amber-500: #ff9100;
+    --color-brown-900: #3e2723;
+    --color-brown-800: #4e342e;
+    --color-brown-700: #5d4037;
+    --color-brown-100: #d7ccc8;
+    --color-neutral-50: #fafafa;
+    --color-neutral-0: #ffffff;
+    --color-black-alpha-10: rgba(0, 0, 0, 0.1);
+    --color-black-alpha-15: rgba(0, 0, 0, 0.15);
+    --color-black-alpha-50: rgba(0, 0, 0, 0.5);
+
+    --font-family-system: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-sm: 0.85rem;
+    --font-size-base: 0.9rem;
+    --font-size-body: 1rem;
+    --font-size-lg: 1.125rem;
+    --font-size-xl: 1.5rem;
+    --font-size-2xl: 2rem;
+    --font-size-3xl: 3rem;
+
+    --font-weight-regular: 400;
+    --font-weight-medium: 500;
+    --font-weight-bold: 700;
+
+    --line-height-tight: 1.2;
+    --line-height-normal: 1.6;
+
+    --space-1: 4px;
+    --space-2: 5px;
+    --space-3: 10px;
+    --space-4: 12px;
+    --space-5: 15px;
+    --space-6: 20px;
+    --space-8: 30px;
+    --space-10: 40px;
+
+    --radius-sm: 4px;
+    --radius-md: 5px;
+    --radius-lg: 8px;
+
+    --shadow-sm: 0 2px 5px var(--color-black-alpha-10);
+    --shadow-md: 0 4px 12px var(--color-black-alpha-15);
+
+    --transition-fast: 0.2s ease;
+    --transition-normal: 0.3s ease;
+
+    --size-hero-block: 60vh;
+    --size-container-max: 1100px;
+    --size-grid-min-col: 250px;
+
+    /* --- Tier 2: Semantic design tokens --- */
+    --color-primary: var(--color-brown-800);
+    --color-primary-dark: var(--color-brown-900);
+    --color-secondary: var(--color-brown-100);
+    --color-accent: var(--color-amber-400);
+    --color-accent-hover: var(--color-amber-500);
+    --color-text: var(--color-brown-900);
+    --color-text-inverted: var(--color-neutral-0);
+    --color-text-muted: var(--color-brown-700);
+    --color-background: var(--color-neutral-50);
+    --color-surface: var(--color-neutral-0);
+    --font-body: var(--font-family-system);
+    --font-heading: var(--font-family-system);
+
+    /* --- Tier 3: General UI design tokens --- */
+    --ui-border-radius: var(--radius-lg);
+    --ui-control-radius: var(--radius-md);
+    --ui-shadow-card: var(--shadow-sm);
+    --ui-shadow-card-hover: var(--shadow-md);
+    --ui-page-inline-padding: 5%;
+    --ui-transition: var(--transition-normal);
+    --ui-focus-outline-color: var(--color-accent);
+
+    /* --- Tier 4: Component-specific design tokens --- */
+    --nav-bg: var(--color-primary);
+    --nav-color: var(--color-text-inverted);
+    --nav-padding-block: var(--space-4);
+    --nav-padding-inline: var(--ui-page-inline-padding);
+    --nav-link-color: inherit;
+    --nav-link-hover-color: var(--color-accent);
+
+    --hero-bg-overlay: var(--color-black-alpha-50);
+    --hero-color: var(--color-text-inverted);
+    --hero-block-size: var(--size-hero-block);
+
+    --card-bg: var(--color-surface);
+    --card-padding: var(--space-6);
+    --card-radius: var(--ui-border-radius);
+    --card-shadow: var(--ui-shadow-card);
+    --card-title-color: var(--color-primary);
+    --card-body-color: var(--color-text);
+
+    --btn-bg: var(--color-primary);
+    --btn-bg-hover: var(--color-primary-dark);
+    --btn-color: var(--color-text-inverted);
+    --btn-padding-block: var(--space-3);
+    --btn-padding-inline: var(--space-6);
+    --btn-radius: var(--ui-control-radius);
+    --btn-transition: background-color var(--ui-transition);
+
+    --footer-bg: var(--color-secondary);
+    --footer-color: var(--color-text);
+    --footer-padding-block: var(--space-10);
+    --footer-padding-inline: var(--space-6);
+  }
+}
+
+/* ==========================================================================
+   Cascade Layer: Base
+   - Base typography, root page surface, and logical defaults
+   ========================================================================== */
+@layer base {
+  body {
+    font-family: var(--font-body);
+    font-size: var(--font-size-body);
+    line-height: var(--line-height-normal);
+    color: var(--color-text);
+    background-color: var(--color-background);
+  }
+
+  h1, h2, h3 {
+    font-family: var(--font-heading);
+    line-height: var(--line-height-tight);
+    color: currentColor;
+  }
+}
+
+/* ==========================================================================
+   Cascade Layer: Components
+   - Scoped styling using native @scope
+   - Native CSS nesting
+   - Expressive selectors (:not, :has, :nth-child of <selector>)
+   - Logical properties throughout
+   ========================================================================== */
+@layer components {
+  /* Navigation Component Scoping */
+  @scope (nav) {
+    :scope {
+      background-color: var(--nav-bg);
+      color: var(--nav-color);
+      padding-block: var(--nav-padding-block);
+      padding-inline: var(--nav-padding-inline);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      position: sticky;
+      inset-block-start: 0;
+      z-index: 1000;
+    }
+
+    .logo {
+      font-size: var(--font-size-xl);
+      font-weight: var(--font-weight-bold);
+      letter-spacing: 1px;
+    }
+
+    ul {
+      display: flex;
+      align-items: center;
+      gap: var(--space-6);
+
+      & a {
+        color: var(--nav-link-color);
+        font-size: var(--font-size-base);
+        transition: color var(--ui-transition);
+
+        &:hover {
+          color: var(--nav-link-hover-color);
+        }
+
+        &:focus-visible {
+          outline: 2px solid var(--ui-focus-outline-color);
+          outline-offset: 2px;
+        }
+      }
+    }
+
+    .logout-link {
+      border: 1px solid var(--color-accent);
+      padding-block: var(--space-2);
+      padding-inline: var(--space-4);
+      border-radius: var(--radius-sm);
+      corner-shape: squircle;
+    }
+  }
+
+  /* Hero Component Scoping */
+  @scope (.hero) {
+    :scope {
+      block-size: var(--hero-block-size);
+      background-image:
+        linear-gradient(var(--hero-bg-overlay), var(--hero-bg-overlay)),
+        url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: var(--hero-color);
+      text-align: center;
+      padding-inline: var(--space-6);
+    }
+
+    h1 {
+      font-size: var(--font-size-3xl);
+      margin-block-end: var(--space-4);
+    }
+
+    p {
+      margin-block-end: var(--space-5);
+    }
+  }
+
+  /* Button Component */
+  .btn {
+    display: inline-block;
+    background-color: var(--btn-bg);
+    color: var(--btn-color);
+    padding-block: var(--btn-padding-block);
+    padding-inline: var(--btn-padding-inline);
+    border-radius: var(--btn-radius);
+    corner-shape: squircle;
+    text-decoration: none;
+    font-family: inherit;
+    font-size: inherit;
+    text-align: center;
+    transition: var(--btn-transition);
+
+    /* Use :not() to avoid overmatching disabled state */
+    &:hover:not(:disabled) {
+      background-color: var(--btn-bg-hover);
+    }
+
+    &:focus-visible {
+      outline: 2px solid var(--ui-focus-outline-color);
+      outline-offset: 2px;
+    }
+  }
+
+  /* Container and Section Scoping */
+  @scope (.container) {
+    :scope {
+      max-inline-size: var(--size-container-max);
+      margin-block: var(--space-10);
+      margin-inline: auto;
+      padding-inline: var(--space-6);
+    }
+
+    h2 {
+      text-align: center;
+      font-size: var(--font-size-2xl);
+      color: var(--color-primary);
+      margin-block-end: var(--space-6);
+    }
+
+    .grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--size-grid-min-col)), 1fr));
+      gap: var(--space-6);
+      margin-block-start: var(--space-6);
+    }
+  }
+
+  /* Card Component Scoping */
+  @scope (.card) {
+    :scope {
+      background-color: var(--card-bg);
+      padding-block: var(--card-padding);
+      padding-inline: var(--card-padding);
+      border-radius: var(--card-radius);
+      corner-shape: squircle;
+      box-shadow: var(--card-shadow);
+      text-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      align-items: center;
+      transition: box-shadow var(--ui-transition), transform var(--ui-transition);
+
+      /* Style parent card based on child interactive state using :has() */
+      &:has(.btn:hover) {
+        box-shadow: var(--ui-shadow-card-hover);
+      }
+    }
+
+    h3 {
+      margin-block-end: var(--space-3);
+      color: var(--card-title-color);
+      font-size: var(--font-size-lg);
+    }
+
+    p {
+      color: var(--card-body-color);
+      margin-block-end: var(--space-5);
+    }
+
+    .btn {
+      margin-block-start: auto;
+    }
+  }
+
+  /* Complex Element Targeting with :nth-child of selector */
+  .grid > :nth-child(1 of .card) {
+    position: relative;
+    border-top: 3px solid var(--color-accent);
+  }
+
+  /* Footer Component Scoping */
+  @scope (footer) {
+    :scope {
+      background-color: var(--footer-bg);
+      color: var(--footer-color);
+      text-align: center;
+      padding-block: var(--footer-padding-block);
+      padding-inline: var(--footer-padding-inline);
+      margin-block-start: var(--space-10);
+    }
+
+    .footer-links {
+      margin-block-end: var(--space-6);
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: var(--space-2) var(--space-4);
+
+      & a {
+        color: inherit;
+        font-size: var(--font-size-sm);
+        transition: color var(--ui-transition);
+
+        &:hover {
+          color: var(--color-accent);
+        }
+
+        &:focus-visible {
+          outline: 2px solid var(--ui-focus-outline-color);
+          outline-offset: 2px;
+        }
+
+        /* Use :not() to separate links without trailing delimiter */
+        &:not(:last-child)::after {
+          content: "|";
+          margin-inline-start: var(--space-4);
+          opacity: 0.5;
+          color: currentColor;
+        }
+      }
+    }
+
+    p {
+      font-size: var(--font-size-sm);
+    }
+  }
+}
+
+/* ==========================================================================
+   Cascade Layer: Utilities
+   ========================================================================== */
+@layer utilities {
+  .text-center {
+    text-align: center;
+  }
+}
