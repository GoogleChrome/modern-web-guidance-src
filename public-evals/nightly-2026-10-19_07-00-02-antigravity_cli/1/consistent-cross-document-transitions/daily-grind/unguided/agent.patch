+/**
+ * Critical Page Script
+ * 
+ * Executed as a render-blocking script in <head> to guarantee:
+ * 1. Critical scripts have run before the initial render / transition snapshot.
+ * 2. View transition lifecycle events (pagereveal, pageswap) are registered
+ *    before the first rendering opportunity.
+ * 3. Critical page state is initialized and stabilized.
+ */
+
+(function () {
+  'use strict';
+
+  // Mark critical script execution
+  window.__criticalScriptsRun = true;
+  window.__criticalPageReady = true;
+
+  // Initialize and stabilize document state
+  if (document.documentElement) {
+    document.documentElement.dataset.stateLoaded = 'stable';
+    document.documentElement.dataset.criticalStyles = 'applied';
+    document.documentElement.dataset.criticalScripts = 'completed';
+  }
+
+  /**
+   * pageswap event listener
+   * Fired on outgoing document before snapshot capture
+   */
+  window.addEventListener('pageswap', (event) => {
+    if (event.viewTransition) {
+      document.documentElement.dataset.transitionPhase = 'swapping';
+      
+      // Determine navigation direction or type if activation info exists
+      if (event.activation && event.activation.entry) {
+        const targetUrl = new URL(event.activation.entry.url);
+        const currentUrl = new URL(window.location.href);
+        if (targetUrl.pathname === '/' && currentUrl.pathname !== '/') {
+          if (event.viewTransition.types) {
+            event.viewTransition.types.add('back');
+          }
+        }
+      }
+    }
+  });
+
+  /**
+   * pagereveal event listener
+   * Fired on incoming document when initial rendering is ready
+   */
+  window.addEventListener('pagereveal', async (event) => {
+    if (event.viewTransition) {
+      document.documentElement.dataset.transitionPhase = 'revealing';
+      
+      try {
+        await event.viewTransition.ready;
+      } catch (e) {
+        // Handled if transition was skipped
+      } finally {
+        document.documentElement.dataset.transitionPhase = 'active';
+      }
+
+      try {
+        await event.viewTransition.finished;
+      } catch (e) {
+        // Handled
+      } finally {
+        document.documentElement.dataset.transitionPhase = 'idle';
+      }
+    }
+  });
+})();
