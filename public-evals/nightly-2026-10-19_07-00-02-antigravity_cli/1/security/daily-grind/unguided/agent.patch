+function handleCspReport(req, res) {
+  if (req.method === 'OPTIONS') {
+    res.writeHead(204, {
+      ...BASE_SECURITY_HEADERS,
+      'Allow': 'POST, OPTIONS'
+    });
+    res.end();
+    return;
+  }
+
+  if (req.method !== 'POST') {
+    res.writeHead(405, {
+      ...BASE_SECURITY_HEADERS,
+      'Allow': 'POST, OPTIONS',
+      'Content-Type': 'text/plain; charset=utf-8'
+    });
+    res.end('Method Not Allowed');
+    return;
+  }
+
+  let body = '';
+  let bodySize = 0;
+
+  req.on('data', (chunk) => {
+    bodySize += chunk.length;
+    if (bodySize > MAX_REPORT_BODY_SIZE) {
+      res.writeHead(413, {
+        ...BASE_SECURITY_HEADERS,
+        'Content-Type': 'text/plain; charset=utf-8'
+      });
+      res.end('Payload Too Large');
+      req.destroy();
+      return;
+    }
+    body += chunk;
+  });
+
+  req.on('end', () => {
+    if (res.writableEnded) return;
+
+    try {
+      if (body) {
+        const report = JSON.parse(body);
+        console.log('[CSP-REPORT]', JSON.stringify(report));
+      }
+    } catch {
+      // Accept report even if payload format varies
+      console.log('[CSP-REPORT-RAW]', body);
+    }
+
+    res.writeHead(204, BASE_SECURITY_HEADERS);
+    res.end();
+  });
+}
 
