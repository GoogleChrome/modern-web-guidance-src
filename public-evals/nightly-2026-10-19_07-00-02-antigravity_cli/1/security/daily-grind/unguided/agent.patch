diff --git a/test/security.test.js b/test/security.test.js
new file mode 100644
index 0000000..5261c5f
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,137 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { server } = require('../server.js');
+
+let port;
+let baseUrl;
+
+test.before((t, done) => {
+  server.listen(0, () => {
+    port = server.address().port;
+    baseUrl = `http://127.0.0.1:${port}`;
+    done();
+  });
+});
+
+test.after((t, done) => {
+  server.close(done);
+});
+
+function request(options, body) {
+  return new Promise((resolve, reject) => {
+    const req = http.request(options, (res) => {
+      let data = '';
+      res.on('data', (chunk) => { data += chunk; });
+      res.on('end', () => {
+        resolve({
+          statusCode: res.statusCode,
+          headers: res.headers,
+          body: data
+        });
+      });
+    });
+    req.on('error', reject);
+    if (body) req.write(body);
+    req.end();
+  });
+}
+
+test('GET / responds with 200 and all required security headers', async () => {
+  const res = await request(`${baseUrl}/`);
+  assert.equal(res.statusCode, 200);
+  assert.match(res.headers['content-type'], /^text\/html/);
+
+  // Content Security Policy & Report-Only
+  assert.ok(res.headers['content-security-policy'], 'Missing Content-Security-Policy header');
+  assert.ok(res.headers['content-security-policy-report-only'], 'Missing Content-Security-Policy-Report-Only header');
+  assert.equal(res.headers['reporting-endpoints'], 'csp-endpoint="/csp-report"');
+
+  // Verify CSP Directives
+  const csp = res.headers['content-security-policy'];
+  assert.match(csp, /default-src 'self'/);
+  assert.match(csp, /script-src 'self'/);
+  assert.match(csp, /style-src 'self'/);
+  assert.match(csp, /img-src 'self' https:\/\/images\.unsplash\.com/);
+  assert.match(csp, /frame-ancestors 'self'/);
+  assert.match(csp, /report-uri \/csp-report/);
+  assert.match(csp, /report-to csp-endpoint/);
+
+  // Preventative security headers
+  assert.equal(res.headers['x-content-type-options'], 'nosniff');
+  assert.equal(res.headers['x-frame-options'], 'SAMEORIGIN');
+  assert.match(res.headers['strict-transport-security'], /max-age=31536000/);
+  assert.equal(res.headers['referrer-policy'], 'strict-origin-when-cross-origin');
+  assert.ok(res.headers['permissions-policy'], 'Missing Permissions-Policy');
+  assert.equal(res.headers['cross-origin-opener-policy'], 'same-origin');
+  assert.equal(res.headers['cross-origin-resource-policy'], 'same-origin');
+});
+
+test('GET /logout sets Clear-Site-Data header to purge sensitive client state', async () => {
+  const res = await request(`${baseUrl}/logout`);
+  assert.equal(res.statusCode, 200);
+  assert.equal(res.headers['clear-site-data'], '"cache", "cookies", "storage"');
+  assert.equal(res.body, 'Logged out');
+  assert.ok(res.headers['content-security-policy']);
+});
+
+test('POST /csp-report accepts CSP violation reports and returns 204', async () => {
+  const payload = JSON.stringify({
+    'csp-report': {
+      'document-uri': 'http://127.0.0.1/index.html',
+      'violated-directive': 'style-src',
+      'blocked-uri': 'inline'
+    }
+  });
+
+  const res = await request({
+    hostname: '127.0.0.1',
+    port,
+    path: '/csp-report',
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/csp-report',
+      'Content-Length': Buffer.byteLength(payload)
+    }
+  }, payload);
+
+  assert.equal(res.statusCode, 204);
+});
+
+test('OPTIONS /csp-report responds with 204 and Allow header', async () => {
+  const res = await request({
+    hostname: '127.0.0.1',
+    port,
+    path: '/csp-report',
+    method: 'OPTIONS'
+  });
+
+  assert.equal(res.statusCode, 204);
+  assert.equal(res.headers['allow'], 'POST, OPTIONS');
+});
+
+test('HEAD / responds with 200 and security headers without body', async () => {
+  const res = await request({
+    hostname: '127.0.0.1',
+    port,
+    path: '/',
+    method: 'HEAD'
+  });
+
+  assert.equal(res.statusCode, 200);
+  assert.equal(res.body, '');
+  assert.ok(res.headers['content-security-policy']);
+  assert.equal(res.headers['x-content-type-options'], 'nosniff');
+});
+
+test('Disallowed HTTP methods return 405 Method Not Allowed', async () => {
+  const res = await request({
+    hostname: '127.0.0.1',
+    port,
+    path: '/',
+    method: 'TRACE'
+  });
+
+  assert.equal(res.statusCode, 405);
+  assert.ok(res.headers['content-security-policy']);
+});
