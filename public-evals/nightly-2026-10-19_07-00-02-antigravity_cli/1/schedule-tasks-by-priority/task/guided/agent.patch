+          steps: [
+            'Fetching active seasonal recipe updates',
+            'Recalculating oat & almond milk upcharges',
+            'Recalculating sales tax across jurisdictions',
+            'Refreshing localized item descriptions',
+            'Rebuilding client search index cache',
+            'Updating digital display board feeds'
+          ]
+        };
+      }
+
+      function createTelemetryLoggingTask() {
+        return {
+          id: taskIdCounter++,
+          type: 'telemetry',
+          priority: 'background',
+          name: `Telemetry & Machine Diagnostics`,
+          desc: `Compress pump pressure logs & sync barista telemetry to cloud`,
+          totalSteps: 48,
+          workload: 250000,
+          steps: [
+            'Reading grouphead temperature sensor arrays',
+            'Sampling 9-bar rotary vane pump pressure curves',
+            'Calculating steam wand pressure variance',
+            'Compressing grinder burr RPM telemetry payload',
+            'Encrypting operational metrics packet',
+            'Uploading diagnostics stream to cloud analytics'
+          ]
+        };
+      }
+
+      // Priority Queue Management
+      function enqueue(task) {
+        taskQueue.push(task);
+        sortQueue();
+        renderQueue();
+        triggerQueueProcessing();
+      }
+
+      function enqueueBatch(tasks) {
+        for (const t of tasks) {
+          taskQueue.push(t);
+        }
+        sortQueue();
+        renderQueue();
+        addLogMessage('System', 'BATCH', `Queued ${tasks.length} mixed operations. Sorted strictly by priority order.`, null);
+        triggerQueueProcessing();
+      }
+
+      function sortQueue() {
+        taskQueue.sort((a, b) => {
+          const diff = PRIORITY_CONFIG[a.priority].weight - PRIORITY_CONFIG[b.priority].weight;
+          if (diff !== 0) return diff;
+          return a.id - b.id; // FIFO among equal priorities
+        });
+      }
+
+      function renderQueue() {
+        queueLengthBadge.textContent = `${taskQueue.length} PENDING`;
+        queueLengthBadge.className = taskQueue.length > 0 ? 'badge badge-user-visible' : 'badge badge-idle';
+
+        if (taskQueue.length === 0) {
+          queueList.innerHTML = '<div class="empty-queue">Queue is empty. Dispatch tasks above to see priority sorting in action.</div>';
+          return;
+        }
+
+        queueList.innerHTML = taskQueue.map((task, idx) => {
+          const cfg = PRIORITY_CONFIG[task.priority];
+          return `
+            <div class="queue-item">
+              <div class="queue-item-left">
+                <span class="queue-pos">#${idx + 1}</span>
+                <span class="badge ${cfg.badgeClass}">${cfg.label}</span>
+                <strong>${task.name}</strong>
+              </div>
+              <small style="color: #795548;">${task.desc.split(',')[0]}</small>
+            </div>
+          `;
+        }).join('');
+      }
+
+      function updateActiveUI(task, pct, stepText) {
+        if (!task) {
+          activeBadge.textContent = 'IDLE';
+          activeBadge.className = 'badge badge-idle';
+          activeName.textContent = 'No task active';
+          activeDesc.textContent = 'Queue is waiting for tasks...';
+          activeProgress.style.width = '0%';
+          activeStep.textContent = 'Standby';
+          activePct.textContent = '0%';
+          return;
+        }
+
+        const cfg = PRIORITY_CONFIG[task.priority];
+        activeBadge.textContent = cfg.label;
+        activeBadge.className = `badge ${cfg.badgeClass}`;
+        activeName.textContent = task.name;
+        activeDesc.textContent = task.desc;
+        activeProgress.style.width = `${pct}%`;
+        activeStep.textContent = stepText;
+        activePct.textContent = `${pct}%`;
+      }
+
+      function addLogMessage(timestamp, badgeLabel, message, durationMs, badgeClass = 'badge-idle') {
+        const line = document.createElement('div');
+        line.className = 'log-line';
+
+        const timeSpan = document.createElement('span');
+        timeSpan.className = 'log-timestamp';
+        timeSpan.textContent = typeof timestamp === 'string' ? timestamp : `[${new Date().toLocaleTimeString()}]`;
+
+        const badgeSpan = document.createElement('span');
+        badgeSpan.className = `log-badge badge ${badgeClass}`;
+        badgeSpan.textContent = badgeLabel;
+
+        const msgSpan = document.createElement('span');
+        msgSpan.className = 'log-message';
+        msgSpan.textContent = message;
+
+        line.appendChild(timeSpan);
+        line.appendChild(badgeSpan);
+        line.appendChild(msgSpan);
+
+        if (durationMs !== null && durationMs !== undefined) {
+          const durSpan = document.createElement('span');
+          durSpan.className = 'log-duration';
+          durSpan.textContent = `${durationMs} ms`;
+          line.appendChild(durSpan);
+        }
+
+        logStream.insertBefore(line, logStream.firstChild);
+
+        // Keep maximum 50 log items
+        while (logStream.children.length > 50) {
+          logStream.removeChild(logStream.lastChild);
+        }
+      }
+
+      // Task execution with 50ms deadline yielding (break-up-long-tasks pattern)
+      async function runTask(task) {
+        const startTime = performance.now();
+        const totalSteps = task.totalSteps;
+        
+        // DO: Set a time-based deadline 50 milliseconds into the future.
+        // 50 milliseconds is the boundary for when a task becomes a long task.
+        let deadline = performance.now() + 50;
+
+        for (let i = 1; i <= totalSteps; i++) {
+          // Synthetic computational workload
+          let dummy = 0;
+          for (let j = 0; j < task.workload; j++) {
+            dummy += Math.sqrt((j % 1000) + 1);
+          }
+
+          const pct = Math.round((i / totalSteps) * 100);
+          const currentDetail = task.steps[(i - 1) % task.steps.length];
+          updateActiveUI(task, pct, `Step ${i}/${totalSteps}: ${currentDetail}`);
+
+          // MANDATORY: Yield to the main thread periodically to keep the UI responsive.
+          // This can be done by checking if the deadline set earlier has been exceeded.
+          // When it has been, yield, then reset the deadline another 50 milliseconds into the future.
+          if (performance.now() >= deadline) {
+            await yieldToMainThread();
+            deadline = performance.now() + 50;
+          }
+        }
+
+        const duration = (performance.now() - startTime).toFixed(1);
+        const cfg = PRIORITY_CONFIG[task.priority];
+        addLogMessage(
+          new Date(),
+          cfg.label,
+          `Completed ${task.name} (${task.desc})`,
+          duration,
+          cfg.badgeClass
+        );
+      }
+
+      async function triggerQueueProcessing() {
+        if (isProcessing) return;
+        isProcessing = true;
+
+        while (taskQueue.length > 0) {
+          // Queue is already kept sorted by priority, so shift() retrieves the highest priority task
+          const task = taskQueue.shift();
+          renderQueue();
+
+          // Use scheduler.postTask with task priority
+          await scheduleWithPriority(() => runTask(task), task.priority);
+        }
+
+        isProcessing = false;
+        updateActiveUI(null);
+        renderQueue();
+      }
+
+      // Button event listeners
+      btnUrgentCheckout.addEventListener('click', () => {
+        const task = createUrgentCheckoutTask();
+        enqueue(task);
+      });
+
+      btnMenuUpdate.addEventListener('click', () => {
+        const task = createMenuUpdateTask();
+        enqueue(task);
+      });
+
+      btnTelemetry.addEventListener('click', () => {
+        const task = createTelemetryLoggingTask();
+        enqueue(task);
+      });
+
+      btnBatchMixed.addEventListener('click', () => {
+        // Create mixed set of tasks added in random / non-priority order
+        // The queue will automatically prioritize: user-blocking first, user-visible second, background third
+        const mixed = [
+          createTelemetryLoggingTask(),
+          createMenuUpdateTask(),
+          createUrgentCheckoutTask(),
+          createTelemetryLoggingTask(),
+          createMenuUpdateTask(),
+          createUrgentCheckoutTask()
+        ];
+        enqueueBatch(mixed);
+      });
+
+      btnClearLog.addEventListener('click', () => {
+        logStream.innerHTML = '';
+        addLogMessage('System', 'CLEAR', 'Log history cleared.', null, 'badge-idle');
+      });
+    })();
+  </script>
 </body>
 
 </html>
