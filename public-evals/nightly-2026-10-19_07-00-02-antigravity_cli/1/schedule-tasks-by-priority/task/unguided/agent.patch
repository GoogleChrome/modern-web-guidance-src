+      let pendingQueue = [];
+      let activeTask = null;
+      let isWorkerRunning = false;
+      let completedCount = 0;
+      let executionHistory = [];
+      let clickCount = 0;
+
+      // Sample task descriptions
+      const taskSamples = {
+        checkout: [
+          { title: 'Urgent Checkout: ApplePay Transaction', desc: 'Authorizing biometric charge & generating crypto token' },
+          { title: 'Urgent Checkout: Drive-Thru Point-of-Sale', desc: 'Validating EMV chip and issuing live receipt' },
+          { title: 'Urgent Checkout: Mobile Express Order #', desc: 'Deducting rewards balance & notifying espresso bar' },
+          { title: 'Urgent Checkout: Split-Tender Payment', desc: 'Multi-party card verification & settle authorization' }
+        ],
+        menu: [
+          { title: 'Standard Menu Update: Cold Brew Stock Sync', desc: 'Recalculating batch steep volume against warehouse inventory' },
+          { title: 'Standard Menu Update: Oat Milk Pricing Adjustment', desc: 'Parsing distributor price matrix & syncing POS terminals' },
+          { title: 'Standard Menu Update: Seasonal Syrup Catalog Refresh', desc: 'Re-indexing autumn flavor availability across regional caches' },
+          { title: 'Standard Menu Update: Daily Bean Roast Batch Sync', desc: 'Updating origin certifications and tasting note metadata' }
+        ],
+        telemetry: [
+          { title: 'Background Telemetry: Session Metrics Compression', desc: 'Compressing 10,000 client interaction telemetry payloads' },
+          { title: 'Background Telemetry: Terminal Heartbeat & Health Check', desc: 'Aggregating system memory, network pings, and thread statistics' },
+          { title: 'Background Telemetry: Diagnostic Crash Log Upload', desc: 'Deduplicating client error stack traces & uploading dump' },
+          { title: 'Background Telemetry: Analytics Event Stream Export', desc: 'Batching customer browsing pathways to cloud analytics warehouse' }
+        ]
+      };
+
+      function getSample(type) {
+        const pool = taskSamples[type];
+        const item = pool[Math.floor(Math.random() * pool.length)];
+        return {
+          title: item.title + (item.title.endsWith('#') ? (++taskCounter) : ''),
+          desc: item.desc
+        };
+      }
+
+      function createTask(type) {
+        const id = 'OP-' + (++taskCounter);
+        const sample = getSample(type);
+        let priorityConfig;
+
+        if (type === 'checkout') {
+          priorityConfig = PRIORITY.URGENT;
+        } else if (type === 'menu') {
+          priorityConfig = PRIORITY.STANDARD;
+        } else {
+          priorityConfig = PRIORITY.TELEMETRY;
+        }
+
+        return {
+          id: id,
+          type: type,
+          priority: priorityConfig,
+          title: sample.title,
+          desc: sample.desc,
+          duration: priorityConfig.defaultDuration,
+          progress: 0,
+          createdAt: performance.now(),
+          createdAtFormatted: new Date().toLocaleTimeString()
+        };
+      }
+
+      // Priority Queue Insertion & Sorting
+      function enqueue(task) {
+        pendingQueue.push(task);
+        sortQueue();
+        renderQueue();
+        updateMetrics();
+        if (!isWorkerRunning) {
+          startWorkerLoop();
+        }
+      }
+
+      function sortQueue() {
+        // Strict prioritization: Priority 1 (Urgent) before Priority 2 (Standard) before Priority 3 (Telemetry)
+        // Within the same priority level, tasks maintain FIFO (first-in, first-out) ordering
+        pendingQueue.sort((a, b) => {
+          if (a.priority.level !== b.priority.level) {
+            return a.priority.level - b.priority.level;
+          }
+          return a.createdAt - b.createdAt;
+        });
+      }
+
+      // Responsive Worker Loop with Cooperative Time-Slicing
+      async function startWorkerLoop() {
+        if (isWorkerRunning) return;
+        isWorkerRunning = true;
+
+        while (pendingQueue.length > 0) {
+          // Dequeue highest priority item
+          activeTask = pendingQueue.shift();
+          renderQueue();
+          renderActiveTask(activeTask);
+          updateMetrics();
+
+          const startTime = performance.now();
+          const totalChunks = 50;
+          const chunkInterval = Math.max(16, Math.floor(activeTask.duration / totalChunks));
+
+          for (let step = 1; step <= totalChunks; step++) {
+            // Cooperative chunk: perform simulated computation
+            runCooperativeChunk(step, activeTask.type);
+
+            activeTask.progress = Math.round((step / totalChunks) * 100);
+            updateTaskProgress(activeTask, step, totalChunks);
+
+            // Yield control back to browser event loop
+            // This is key: allowing paint, input events, and animation frames to proceed smoothly
+            await new Promise(resolve => setTimeout(resolve, chunkInterval));
+          }
+
+          const actualDuration = Math.round(performance.now() - startTime);
+
+          // Add to log
+          const logEntry = {
+            id: activeTask.id,
+            title: activeTask.title,
+            priority: activeTask.priority,
+            duration: actualDuration,
+            timestamp: new Date().toLocaleTimeString(),
+            status: 'Completed'
+          };
+          executionHistory.unshift(logEntry);
+          if (executionHistory.length > 30) executionHistory.pop();
+          completedCount++;
+
+          renderExecutionHistory();
+          activeTask = null;
+          renderActiveTask(null);
+          updateMetrics();
+
+          // Small yield between tasks
+          await new Promise(resolve => setTimeout(resolve, 60));
+        }
+
+        isWorkerRunning = false;
+        renderActiveTask(null);
+        updateMetrics();
+      }
+
+      function runCooperativeChunk(step, type) {
+        // Intensive calculations to simulate real operational payload processing
+        let acc = 0;
+        const iterations = 6000;
+        for (let i = 0; i < iterations; i++) {
+          acc += Math.sin(i * 0.05 + step) * Math.cos(i * 0.02);
+        }
+        return acc;
+      }
+
+      // UI Rendering
+      function renderActiveTask(task) {
+        const emptyEl = document.getElementById('active-task-empty');
+        const detailsEl = document.getElementById('running-task-details');
+        const badgeEl = document.getElementById('active-task-badge');
+
+        if (!task) {
+          emptyEl.style.display = 'block';
+          detailsEl.style.display = 'none';
+          badgeEl.className = 'badge badge-idle';
+          badgeEl.textContent = 'Idle';
+          return;
+        }
+
+        emptyEl.style.display = 'none';
+        detailsEl.style.display = 'block';
+
+        badgeEl.className = `badge ${task.priority.badgeClass}`;
+        badgeEl.textContent = task.priority.pillText;
+
+        document.getElementById('active-task-title').textContent = task.title;
+        document.getElementById('active-task-id').textContent = task.id;
+        document.getElementById('active-task-desc').textContent = task.desc;
+
+        const fillEl = document.getElementById('active-task-progress-fill');
+        fillEl.className = `progress-bar-fill ${task.priority.barClass}`;
+        fillEl.style.width = '0%';
+        document.getElementById('active-task-pct').textContent = '0%';
+        document.getElementById('active-task-subtext').textContent = 'Initializing execution...';
+      }
+
+      function updateTaskProgress(task, step, total) {
+        const fillEl = document.getElementById('active-task-progress-fill');
+        const pctEl = document.getElementById('active-task-pct');
+        const subtextEl = document.getElementById('active-task-subtext');
+
+        if (fillEl && pctEl && subtextEl) {
+          fillEl.style.width = `${task.progress}%`;
+          pctEl.textContent = `${task.progress}%`;
+          subtextEl.textContent = `Processing chunk ${step}/${total} (${Math.round((step / total) * task.duration)}ms elapsed)...`;
+        }
+      }
+
+      function renderQueue() {
+        const listEl = document.getElementById('pending-queue-list');
+        const countEl = document.getElementById('pending-queue-count');
+
+        countEl.textContent = pendingQueue.length;
+
+        if (pendingQueue.length === 0) {
+          listEl.innerHTML = '';
+          const emptyDiv = document.createElement('div');
+          emptyDiv.className = 'empty-state';
+          emptyDiv.id = 'pending-queue-empty';
+          emptyDiv.innerHTML = '<p>Pending queue is empty. Tasks queued will be prioritized here.</p>';
+          listEl.appendChild(emptyDiv);
+          return;
+        }
+
+        listEl.innerHTML = '';
+        pendingQueue.forEach((task, index) => {
+          const item = document.createElement('div');
+          item.className = `queue-item ${task.priority.itemClass}`;
+          item.innerHTML = `
+            <div class="queue-item-left">
+              <span class="queue-order-badge">#${index + 1}</span>
+              <div>
+                <div class="queue-item-title">${escapeHtml(task.title)}</div>
+                <div class="queue-item-desc">${escapeHtml(task.desc)} &bull; <small>Queued at ${task.createdAtFormatted}</small></div>
+              </div>
+            </div>
+            <div>
+              <span class="badge ${task.priority.badgeClass}">${task.priority.pillText}</span>
+            </div>
+          `;
+          listEl.appendChild(item);
+        });
+      }
+
+      function renderExecutionHistory() {
+        const tbody = document.getElementById('log-table-body');
+        if (executionHistory.length === 0) {
+          tbody.innerHTML = `
+            <tr id="log-empty-row">
+              <td colspan="5" class="text-center">No operations completed yet.</td>
+            </tr>
+          `;
+          return;
+        }
+
+        tbody.innerHTML = '';
+        executionHistory.forEach(entry => {
+          const tr = document.createElement('tr');
+          tr.innerHTML = `
+            <td><code>${entry.timestamp}</code></td>
+            <td><strong>${escapeHtml(entry.title)}</strong> <br><small style="color:#8d6e63;">${entry.id}</small></td>
+            <td><span class="badge ${entry.priority.badgeClass}">${entry.priority.pillText}</span></td>
+            <td>${entry.duration} ms</td>
+            <td><span style="color:#2e7d32; font-weight:600;">&#10003; ${entry.status}</span></td>
+          `;
+          tbody.appendChild(tr);
+        });
+      }
+
+      function updateMetrics() {
+        const statusEl = document.getElementById('queue-status-val');
+        const queuedCountEl = document.getElementById('queued-count-val');
+        const completedCountEl = document.getElementById('completed-count-val');
+
+        if (statusEl) {
+          if (isWorkerRunning) {
+            statusEl.textContent = `Processing (${activeTask ? activeTask.priority.name : 'Running'})`;
+            statusEl.style.color = '#e65100';
+          } else {
+            statusEl.textContent = 'Idle';
+            statusEl.style.color = '#2e7d32';
+          }
+        }
+        if (queuedCountEl) queuedCountEl.textContent = `${pendingQueue.length} task${pendingQueue.length === 1 ? '' : 's'}`;
+        if (completedCountEl) completedCountEl.textContent = completedCount;
+      }
+
+      function escapeHtml(str) {
+        if (!str) return '';
+        return str.replace(/[&<>'"]/g, tag => ({
+          '&': '&amp;',
+          '<': '&lt;',
+          '>': '&gt;',
+          "'": '&#39;',
+          '"': '&quot;'
+        }[tag] || tag));
+      }
+
+      // Event Listeners for Simulator Buttons
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        const task = createTask('checkout');
+        enqueue(task);
+      });
+
+      document.getElementById('btn-menu-update').addEventListener('click', () => {
+        const task = createTask('menu');
+        enqueue(task);
+      });
+
+      document.getElementById('btn-telemetry').addEventListener('click', () => {
+        const task = createTask('telemetry');
+        enqueue(task);
+      });
+
+      document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+        // Enqueue mixed tasks (2 Telemetry, 2 Menu Updates, 2 Urgent Checkouts)
+        // Inserted in interleaved/scrambled order to prove automatic prioritization!
+        const batchTemplates = ['telemetry', 'menu', 'checkout', 'telemetry', 'menu', 'checkout'];
+        
+        batchTemplates.forEach(type => {
+          const task = createTask(type);
+          pendingQueue.push(task);
+        });
+
+        // Immediately sort pending queue by priority
+        sortQueue();
+        renderQueue();
+        updateMetrics();
+
+        if (!isWorkerRunning) {
+          startWorkerLoop();
+        }
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', () => {
+        pendingQueue = [];
+        renderQueue();
+        updateMetrics();
+      });
+
+      document.getElementById('btn-clear-log').addEventListener('click', () => {
+        executionHistory = [];
+        completedCount = 0;
+        renderExecutionHistory();
+        updateMetrics();
+      });
+
+      // Interactive Responsiveness Tester Button
+      const testBtn = document.getElementById('btn-test-click');
+      const testCountSpan = document.getElementById('test-click-count');
+      testBtn.addEventListener('click', () => {
+        clickCount++;
+        testCountSpan.textContent = clickCount;
+        testBtn.classList.add('clicked');
+        setTimeout(() => testBtn.classList.remove('clicked'), 120);
+      });
+
+      // FPS Monitoring loop verifying UI thread responsiveness
+      let frameCount = 0;
+      let lastFpsCheck = performance.now();
+      function checkFps(now) {
+        frameCount++;
+        if (now - lastFpsCheck >= 1000) {
+          const fps = Math.round((frameCount * 1000) / (now - lastFpsCheck));
+          frameCount = 0;
+          lastFpsCheck = now;
+          const statusText = document.getElementById('responsiveness-status');
+          if (statusText) {
+            statusText.textContent = `UI Thread: ${fps} FPS (Fluid)`;
+          }
+        }
+        requestAnimationFrame(checkFps);
+      }
+      requestAnimationFrame(checkFps);
+
+    })();
+  </script>
 </body>
 
