+  <script>
+    const form = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    const errorMsg = document.getElementById('newsletter-email-error');
+    const errorText = document.getElementById('newsletter-error-text');
+    const successMsg = document.getElementById('newsletter-success');
+
+    let hasInteracted = false;
+
+    const updateValidationUI = (isSubmitting = false) => {
+      if (!hasInteracted && !isSubmitting) return;
+
+      const isValid = emailInput.checkValidity();
+      emailInput.classList.toggle('user-invalid-fallback', !isValid);
+      emailInput.classList.toggle('user-valid-fallback', isValid);
+
+      if (!isValid) {
+        emailInput.setAttribute('aria-invalid', 'true');
+        if (errorText) {
+          if (emailInput.validity.valueMissing) {
+            errorText.textContent = 'Please enter an email address.';
+          } else if (emailInput.validity.typeMismatch) {
+            errorText.textContent = 'Please enter a valid email address.';
+          } else {
+            errorText.textContent = 'Please enter a valid email address.';
+          }
+        }
+        if (errorMsg) errorMsg.style.display = 'flex';
+      } else {
+        emailInput.removeAttribute('aria-invalid');
+        if (errorMsg) errorMsg.style.display = 'none';
+      }
+    };
+
+    emailInput.addEventListener('focus', () => {
+      hasInteracted = true;
+    });
+
+    emailInput.addEventListener('input', () => {
+      hasInteracted = true;
+      if (emailInput.checkValidity()) {
+        updateValidationUI();
+      }
+    });
+
+    emailInput.addEventListener('blur', () => {
+      if (hasInteracted) {
+        updateValidationUI();
+      }
+    });
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      hasInteracted = true;
+      updateValidationUI(true);
+
+      if (!emailInput.checkValidity()) {
+        emailInput.focus();
+        return;
+      }
+
+      form.style.display = 'none';
+      if (successMsg) {
+        successMsg.style.display = 'block';
+      }
+    });
+  </script>
+
 </body>
 
