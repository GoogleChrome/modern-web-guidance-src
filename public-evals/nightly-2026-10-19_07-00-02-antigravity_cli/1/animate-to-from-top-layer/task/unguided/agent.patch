+  <!-- Logout Confirmation Modal Backdrop -->
+  <div id="modal-backdrop" class="modal-backdrop backdrop" aria-hidden="true"></div>
+
+  <!-- Logout Confirmation Modal Dialog -->
+  <dialog id="logout-dialog" class="modal logout-modal" role="dialog" aria-modal="true" aria-labelledby="logout-dialog-title" aria-describedby="logout-dialog-desc">
+    <div class="modal-dialog-content">
+      <div class="modal-header">
+        <h3 id="logout-dialog-title" class="modal-title">Confirm Logout</h3>
+        <button type="button" id="close-dialog-btn" class="modal-close-btn" aria-label="Close dialog">&times;</button>
+      </div>
+      <div class="modal-body">
+        <p id="logout-dialog-desc">Are you sure you want to log out of your account?</p>
+      </div>
+      <div class="modal-footer">
+        <button type="button" class="btn modal-cancel-btn">Cancel</button>
+        <a href="/logout" class="btn modal-confirm-btn">Log Out</a>
+      </div>
+    </div>
+  </dialog>
+
+  <!-- Dismissible Informational Floating Overlay -->
+  <div id="offline-overlay" class="floating-overlay" role="status" aria-live="polite">
+    <div class="floating-overlay-content">
+      <div class="floating-overlay-body">
+        <span class="floating-overlay-icon" aria-hidden="true">&#9432;</span>
+        <span class="floating-overlay-text">online ordering is currently offline</span>
+      </div>
+      <button type="button" id="close-overlay-btn" class="floating-overlay-close-btn" aria-label="Dismiss">&times;</button>
+    </div>
+  </div>
+
+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      // --- Logout Confirmation Modal ---
+      const openDialogBtn = document.getElementById('open-dialog-btn');
+      const closeDialogBtn = document.getElementById('close-dialog-btn');
+      const logoutDialog = document.getElementById('logout-dialog');
+      const modalBackdrop = document.getElementById('modal-backdrop');
+      const modalCancelBtn = document.querySelector('.modal-cancel-btn');
+      let isModalClosing = false;
+
+      function openModal() {
+        if (!logoutDialog) return;
+        if (isModalClosing) {
+          logoutDialog.classList.remove('is-closing');
+          modalBackdrop?.classList.remove('is-closing');
+          isModalClosing = false;
+        }
+        if (!logoutDialog.open) {
+          if (typeof logoutDialog.showModal === 'function') {
+            logoutDialog.showModal();
+          } else {
+            logoutDialog.setAttribute('open', '');
+            logoutDialog.style.display = 'block';
+          }
+          if (modalBackdrop) {
+            modalBackdrop.classList.remove('is-closing');
+            modalBackdrop.classList.add('is-open');
+          }
+        }
+      }
+
+      function closeModal() {
+        if (!logoutDialog || !logoutDialog.open || isModalClosing) return;
+        isModalClosing = true;
+        logoutDialog.classList.add('is-closing');
+        if (modalBackdrop) {
+          modalBackdrop.classList.remove('is-open');
+          modalBackdrop.classList.add('is-closing');
+        }
+
+        const handleAnimationEnd = () => {
+          logoutDialog.removeEventListener('animationend', handleAnimationEnd);
+          if (typeof logoutDialog.close === 'function') {
+            logoutDialog.close();
+          } else {
+            logoutDialog.removeAttribute('open');
+            logoutDialog.style.display = 'none';
+          }
+          logoutDialog.classList.remove('is-closing');
+          if (modalBackdrop) {
+            modalBackdrop.classList.remove('is-closing');
+          }
+          isModalClosing = false;
+        };
+
+        logoutDialog.addEventListener('animationend', handleAnimationEnd, { once: true });
+        // Fallback safety timeout
+        setTimeout(() => {
+          if (isModalClosing) handleAnimationEnd();
+        }, 300);
+      }
+
+      if (openDialogBtn) {
+        openDialogBtn.addEventListener('click', (e) => {
+          e.preventDefault();
+          openModal();
+        });
+      }
+
+      if (closeDialogBtn) {
+        closeDialogBtn.addEventListener('click', (e) => {
+          e.preventDefault();
+          closeModal();
+        });
+      }
+
+      if (modalCancelBtn) {
+        modalCancelBtn.addEventListener('click', (e) => {
+          e.preventDefault();
+          closeModal();
+        });
+      }
+
+      if (logoutDialog) {
+        // Handle native cancel event (Escape key)
+        logoutDialog.addEventListener('cancel', (e) => {
+          e.preventDefault();
+          closeModal();
+        });
+
+        // Handle backdrop click on the dialog itself
+        logoutDialog.addEventListener('click', (e) => {
+          const content = logoutDialog.querySelector('.modal-dialog-content');
+          if (content) {
+            const rect = content.getBoundingClientRect();
+            const isInDialog = (
+              rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
+              rect.left <= e.clientX && e.clientX <= rect.left + rect.width
+            );
+            if (!isInDialog) {
+              closeModal();
+            }
+          }
+        });
+      }
+
+      if (modalBackdrop) {
+        modalBackdrop.addEventListener('click', () => {
+          closeModal();
+        });
+      }
+
+      // --- Floating Overlay ---
+      const foobarBtn = document.getElementById('foobar');
+      const offlineOverlay = document.getElementById('offline-overlay');
+      const closeOverlayBtn = document.getElementById('close-overlay-btn');
+      let isOverlayClosing = false;
+
+      function openOverlay() {
+        if (!offlineOverlay) return;
+        if (isOverlayClosing) {
+          offlineOverlay.classList.remove('is-closing');
+          isOverlayClosing = false;
+        }
+        offlineOverlay.classList.remove('is-closing');
+        offlineOverlay.classList.remove('is-open');
+        // Force reflow to re-trigger CSS animation
+        void offlineOverlay.offsetWidth;
+        offlineOverlay.classList.add('is-open');
+      }
+
+      function closeOverlay() {
+        if (!offlineOverlay || !offlineOverlay.classList.contains('is-open') || isOverlayClosing) return;
+        isOverlayClosing = true;
+        offlineOverlay.classList.add('is-closing');
+
+        const handleOverlayEnd = () => {
+          offlineOverlay.removeEventListener('animationend', handleOverlayEnd);
+          offlineOverlay.classList.remove('is-open', 'is-closing');
+          isOverlayClosing = false;
+        };
+
+        offlineOverlay.addEventListener('animationend', handleOverlayEnd, { once: true });
+        // Fallback safety timeout
+        setTimeout(() => {
+          if (isOverlayClosing) handleOverlayEnd();
+        }, 300);
+      }
+
+      if (foobarBtn) {
+        foobarBtn.addEventListener('click', (e) => {
+          e.preventDefault();
+          openOverlay();
+        });
+      }
+
+      if (closeOverlayBtn) {
+        closeOverlayBtn.addEventListener('click', (e) => {
+          e.preventDefault();
+          closeOverlay();
+        });
+      }
+    });
+  </script>
 </body>
 
