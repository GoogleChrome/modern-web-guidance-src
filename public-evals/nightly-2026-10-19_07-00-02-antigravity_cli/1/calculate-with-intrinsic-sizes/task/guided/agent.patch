+  <script>
+    const accordionToggle = document.getElementById('accordion-toggle');
+    const accordionContent = document.getElementById('accordion-content') || document.querySelector('.accordion-content');
+
+    if (accordionToggle && accordionContent) {
+      accordionToggle.addEventListener('click', () => {
+        const isExpanded = accordionToggle.getAttribute('aria-expanded') === 'true';
+        accordionToggle.setAttribute('aria-expanded', String(!isExpanded));
+        accordionContent.classList.toggle('is-expanded');
+      });
+    }
+  </script>
