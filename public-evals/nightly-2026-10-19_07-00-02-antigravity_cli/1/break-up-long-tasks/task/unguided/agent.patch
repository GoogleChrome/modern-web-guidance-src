+  <script>
+    function yieldToMain() {
+      if (typeof globalThis.scheduler !== 'undefined' && typeof globalThis.scheduler.yield === 'function') {
+        return globalThis.scheduler.yield();
+      }
+      return new Promise(resolve => setTimeout(resolve, 0));
+    }
+
+    function processBlend(blendIndex) {
+      // Simulate ~2ms of processing per recipe blend
+      const start = performance.now();
+      while (performance.now() - start < 2) {
+        // Busy wait to simulate synchronous processing
+      }
+    }
+
+    const startBtn = document.getElementById('start-btn');
+    const output = document.getElementById('output');
+
+    let isRunning = false;
+
+    startBtn.addEventListener('click', async () => {
+      if (isRunning) return;
+      isRunning = true;
+
+      output.textContent = 'Processing...';
+      await yieldToMain();
+
+      const TOTAL_BLENDS = 1000;
+      let lastYield = performance.now();
+
+      for (let i = 1; i <= TOTAL_BLENDS; i++) {
+        processBlend(i);
+
+        if (performance.now() - lastYield >= 50 && i < TOTAL_BLENDS) {
+          output.textContent = `Processed ${i} of ${TOTAL_BLENDS}...`;
+          await yieldToMain();
+          lastYield = performance.now();
+        }
+      }
+
+      output.textContent = 'Done! All items processed.';
+      isRunning = false;
