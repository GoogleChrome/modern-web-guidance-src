+  <script>
+    (function () {
+      const indicator = document.getElementById('scroll-indicator');
+      if (!indicator) return;
+
+      const supportsScrollTimeline =
+        typeof CSS !== 'undefined' &&
+        typeof CSS.supports === 'function' &&
+        (function () {
+          try {
+            return (
+              CSS.supports('animation-timeline', 'scroll()') ||
+              CSS.supports('animation-timeline: scroll()')
+            );
+          } catch (e) {
+            return false;
+          }
+        })();
+
+      function updateProgress() {
+        const scrollTop = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
+        const scrollHeight = (document.documentElement.scrollHeight || document.body.scrollHeight) - document.documentElement.clientHeight;
+        const progress = scrollHeight > 0 ? Math.min(Math.max(scrollTop / scrollHeight, 0), 1) : 0;
+
+        indicator.setAttribute('aria-valuenow', Math.round(progress * 100));
+
+        if (!supportsScrollTimeline) {
+          indicator.style.setProperty('--scroll-progress', progress);
+          indicator.style.transform = `scaleX(${progress})`;
+        }
+      }
+
+      let ticking = false;
+      function requestUpdate() {
+        if (!ticking) {
+          window.requestAnimationFrame(function () {
+            updateProgress();
+            ticking = false;
+          });
+          ticking = true;
+        }
+      }
+
+      window.addEventListener('scroll', requestUpdate, { passive: true });
+      window.addEventListener('resize', requestUpdate, { passive: true });
+
+      updateProgress();
+    })();
+  </script>
+
