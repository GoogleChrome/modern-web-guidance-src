+  <script>
+    const roastSlider = document.querySelector('#roast-slider');
+    const roastOutput = document.querySelector('#roast-output');
+    const roastDetails = document.querySelector('#roast-details');
+
+    const roastProfiles = {
+      1: {
+        title: 'Light Roast (Cinnamon / New England)',
+        shortName: 'Light Roast',
+        notes: 'Floral, crisp citrus acidity, subtle tea-like body. Highlights the authentic terroir and origin notes of the bean.',
+        pairing: 'Ethiopian Yirgacheffe'
+      },
+      2: {
+        title: 'Medium-Light Roast (American)',
+        shortName: 'Medium-Light Roast',
+        notes: 'Bright berry notes, honey sweetness, and gentle caramel aroma with lively, pleasant acidity.',
+        pairing: 'Costa Rican Tarrazú'
+      },
+      3: {
+        title: 'Medium Roast (City / Breakfast)',
+        shortName: 'Medium Roast',
+        notes: 'Well-rounded chocolate and roasted almond flavors, velvety body, and balanced natural sweetness.',
+        pairing: 'Colombian Supremo'
+      },
+      4: {
+        title: 'Medium-Dark Roast (Full City / Vienna)',
+        shortName: 'Medium-Dark Roast',
+        notes: 'Rich baker’s cocoa, toasted walnut, subtle spicy undertones, and a lingering bittersweet finish.',
+        pairing: 'Sumatra Mandheling'
+      },
+      5: {
+        title: 'Dark Roast (French / Italian)',
+        shortName: 'Dark Roast',
+        notes: 'Smoky, decadent dark chocolate, low acidity, full-bodied intensity with caramelized sugars.',
+        pairing: 'Midnight Espresso Blend'
+      }
+    };
+
+    function syncSlider(slider) {
+      const min = Number(slider.min) || 1;
+      const max = Number(slider.max) || 5;
+      const val = Number(slider.value);
+
+      // Synchronize CSS custom properties for WebKit dynamic fill and fallback progress
+      slider.style.setProperty('--attr-min', min);
+      slider.style.setProperty('--attr-max', max);
+      slider.style.setProperty('--control-value', val);
+
+      const profile = roastProfiles[val];
+      if (profile) {
+        slider.setAttribute('aria-valuenow', val);
+        slider.setAttribute('aria-valuetext', profile.shortName);
+
+        if (roastOutput) {
+          roastOutput.textContent = `Level ${val}: ${profile.shortName}`;
+        }
+
+        if (roastDetails) {
+          roastDetails.innerHTML = `
+            <div class="profile-header">
+              <span class="profile-title">${profile.title}</span>
+              <span class="recommendation-tag">Pairing: ${profile.pairing}</span>
+            </div>
+            <p class="profile-notes">${profile.notes}</p>
+          `;
+        }
+      }
+    }
+
+    if (roastSlider) {
+      syncSlider(roastSlider);
+      roastSlider.addEventListener('input', () => syncSlider(roastSlider));
+    }
+  </script>
