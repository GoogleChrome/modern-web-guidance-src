+            '4': 'Pour Over / Aeropress (Medium-Fine)',
+            '5': 'Espresso (Fine)'
+          };
+          const text = grindLabels[slider.value] || `Step ${slider.value}`;
+          if (output) output.textContent = text;
+          slider.setAttribute('aria-valuenow', slider.value);
+          slider.setAttribute('aria-valuetext', text);
+          updateRecipe();
+        } else if (slider.id === 'roast-slider') {
+          let roastText = '';
+          if (val <= 3) roastText = `Light Roast (${val}/10) · Bright & Floral`;
+          else if (val <= 6) roastText = `Medium Roast (${val}/10) · Balanced & Caramel`;
+          else if (val <= 8) roastText = `Medium-Dark (${val}/10) · Rich Cocoa & Nutty`;
+          else roastText = `Dark Roast (${val}/10) · Bold, Smokey & Intense`;
+          
+          if (output) output.textContent = roastText;
+          slider.setAttribute('aria-valuenow', slider.value);
+          slider.setAttribute('aria-valuetext', roastText);
+          updateRecipe();
+        } else if (slider.id === 'cups-slider') {
+          const ml = val * 150;
+          const text = `${val} ${val === 1 ? 'Cup' : 'Cups'} (${ml}ml)`;
+          if (output) output.textContent = text;
+          slider.setAttribute('aria-valuenow', slider.value);
+          slider.setAttribute('aria-valuetext', text);
+          updateRecipe();
+        } else if (slider.id === 'sample-disabled-slider') {
+          const text = slider.disabled ? `Locked (${slider.value}%)` : `Active (${slider.value}%)`;
+          if (output) output.textContent = text;
+          slider.setAttribute('aria-valuenow', slider.value);
+          slider.setAttribute('aria-valuetext', text);
+        } else if (output) {
+          output.textContent = slider.value;
+          slider.setAttribute('aria-valuenow', slider.value);
+        }
+      }
+
+      function updateRecipe() {
+        const grind = document.getElementById('grind-slider')?.value || '3';
+        const roast = parseFloat(document.getElementById('roast-slider')?.value || '6');
+        const cups = parseInt(document.getElementById('cups-slider')?.value || '4', 10);
+        
+        const grindNames = ['Extra Coarse', 'Coarse', 'Medium-Coarse', 'Medium-Fine', 'Fine'];
+        const grindMethods = ['Cold Brew Maker', 'French Press', 'Chemex / Drip', 'Pour Over (V60)', 'Espresso Machine'];
+        const grindIndex = Math.max(0, Math.min(4, parseInt(grind, 10) - 1));
+        
+        const waterGrams = cups * 150;
+        const coffeeGrams = Math.round(waterGrams / 15);
+        
+        let temp = '200°F (93°C)';
+        if (grindIndex === 0) temp = 'Chilled / Room Temp (Cold Brew)';
+        else if (roast <= 3) temp = '205°F (96°C) for light roast';
+        else if (roast >= 8) temp = '195°F (90°C) for dark roast';
+        
+        const summaryGrind = document.getElementById('recipe-grind');
+        const summaryMethod = document.getElementById('recipe-method');
+        const summaryRatio = document.getElementById('recipe-ratio');
+        const summaryTemp = document.getElementById('recipe-temp');
+        
+        if (summaryGrind) summaryGrind.textContent = grindNames[grindIndex];
+        if (summaryMethod) summaryMethod.textContent = grindMethods[grindIndex];
+        if (summaryRatio) summaryRatio.textContent = `${coffeeGrams}g coffee / ${waterGrams}ml water`;
+        if (summaryTemp) summaryTemp.textContent = temp;
+      }
+
+      // Initialize all sliders
+      sliders.forEach(slider => {
+        updateSlider(slider);
+        slider.addEventListener('input', () => updateSlider(slider));
+        slider.addEventListener('change', () => updateSlider(slider));
+      });
+
+      // Interactive tick markers support
+      document.querySelectorAll('.slider-ticks span').forEach(tick => {
+        tick.addEventListener('click', () => {
+          const targetId = tick.getAttribute('data-for');
+          const val = tick.getAttribute('data-value');
+          const target = document.getElementById(targetId);
+          if (target && !target.disabled) {
+            target.value = val;
+            updateSlider(target);
+            target.focus();
+          }
+        });
+      });
+
+      // Interactive disabled showcase toggle
+      if (toggleDisabledCheckbox && sampleDisabledSlider) {
+        toggleDisabledCheckbox.addEventListener('change', (e) => {
+          sampleDisabledSlider.disabled = e.target.checked;
+          sampleDisabledSlider.setAttribute('aria-disabled', String(e.target.checked));
+          updateSlider(sampleDisabledSlider);
+        });
+      }
+    });
+  </script>
 </body>
 
 </html>
