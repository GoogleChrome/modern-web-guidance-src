+  <script>
+    function initPromoArea() {
+      const domContainer = document.getElementById('domContainer');
+      const addBtn = document.getElementById('addBtn');
+      const removeBtn = document.getElementById('removeBtn');
+      const toggleBtn = document.getElementById('toggleBtn');
+
+      const promoData = [
+        {
+          title: 'BOGO Espresso Shots',
+          desc: 'Double your energy! Buy one double espresso, get the second free until noon.',
+          img: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80',
+          action: 'Get Deal'
+        },
+        {
+          title: 'Free Artisan Pastry',
+          desc: 'Enjoy a free fresh bakery treat with any pour-over or signature roast.',
+          img: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=600&q=80',
+          action: 'View Bakery'
+        },
+        {
+          title: 'Cold Brew Happy Hour',
+          desc: '$3 Nitro Cold Brew every afternoon between 2 PM and 5 PM.',
+          img: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=600&q=80',
+          action: 'Order Ahead'
+        },
+        {
+          title: 'Vanilla Bean Frappé',
+          desc: 'Cool down with our house-made organic vanilla bean iced blend at 15% off.',
+          img: 'https://images.unsplash.com/photo-1485808191679-5f86510681a2?auto=format&fit=crop&w=600&q=80',
+          action: 'Try Now'
+        },
+        {
+          title: 'Roaster Subscription',
+          desc: 'Get freshly roasted single-origin beans delivered to your door with free shipping.',
+          img: 'https://images.unsplash.com/photo-1497636577773-f1231844b336?auto=format&fit=crop&w=600&q=80',
+          action: 'Subscribe'
+        }
+      ];
+
+      let promoIndex = 0;
+
+      if (addBtn && domContainer) {
+        addBtn.addEventListener('click', () => {
+          const promo = promoData[promoIndex % promoData.length];
+          promoIndex++;
+
+          const card = document.createElement('div');
+          card.className = 'card';
+          card.innerHTML = `
+            <img src="${promo.img}" alt="${promo.title}" style="width: 100%; height: 160px; object-fit: cover; border-radius: 6px; margin-bottom: 12px;">
+            <h3>${promo.title}</h3>
+            <p>${promo.desc}</p>
+            <a href="/menu" class="btn">${promo.action}</a>
+          `;
+          domContainer.appendChild(card);
+        });
+      }
+
+      if (removeBtn && domContainer) {
+        removeBtn.addEventListener('click', () => {
+          const cards = domContainer.querySelectorAll('.card:not(.removing)');
+          if (cards.length > 0) {
+            const lastCard = cards[cards.length - 1];
+            lastCard.classList.add('removing');
+            let removed = false;
+            const finishRemoval = () => {
+              if (!removed) {
+                removed = true;
+                lastCard.remove();
+              }
+            };
+            lastCard.addEventListener('animationend', finishRemoval, { once: true });
+            lastCard.addEventListener('transitionend', finishRemoval, { once: true });
+            setTimeout(finishRemoval, 300);
+          }
+        });
+      }
+
+      if (toggleBtn) {
+        toggleBtn.addEventListener('click', () => {
+          const card = document.getElementById('toggleCard');
+          if (card) {
+            if (card.hasAttribute('hidden')) {
+              card.removeAttribute('hidden');
+            } else {
+              card.setAttribute('hidden', '');
+            }
+          }
+        });
+      }
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initPromoArea);
+    } else {
+      initPromoArea();
+    }
+  </script>
+
 </body>
 
