diff --git a/src/pages/api/send-otp.ts b/src/pages/api/send-otp.ts
new file mode 100644
index 0000000..6cd1a14
--- /dev/null
+++ b/src/pages/api/send-otp.ts
@@ -0,0 +1,52 @@
+import type { APIRoute } from 'astro';
+import { generateAndStoreOtp, normalizePhone } from '../../utils/otpStore';
+
+export const POST: APIRoute = async ({ request, url }) => {
+  try {
+    const body = await request.json();
+    const phone = body?.phone;
+
+    if (!phone || typeof phone !== 'string' || normalizePhone(phone).length < 7) {
+      return new Response(
+        JSON.stringify({
+          success: false,
+          error: 'Please enter a valid phone number.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    // Determine host strictly conforming to origin-bound SMS specs (only host domain)
+    const hostHeader = request.headers.get('x-forwarded-host') || request.headers.get('host') || url.hostname;
+    const { code, formattedSms, expiresAt } = generateAndStoreOtp(phone, hostHeader);
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        message: 'Verification code sent successfully.',
+        phone,
+        formattedSms,
+        code,
+        expiresAt,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({
+        success: false,
+        error: 'Failed to process send-otp request: ' + (err?.message || 'Unknown error'),
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
