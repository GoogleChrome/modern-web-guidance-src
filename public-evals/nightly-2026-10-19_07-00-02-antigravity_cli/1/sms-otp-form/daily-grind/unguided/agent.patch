@@ -0,0 +1,473 @@
+/**
+ * Accessible Phone Number & SMS One-Time Passcode (OTP) Verification
+ * Implements WebOTP API, origin-bound SMS format, autocomplete="one-time-code",
+ * and comprehensive accessibility (WCAG AA).
+ */
+
+(function () {
+  'use strict';
+
+  // DOM Elements
+  const stepPhone = document.getElementById('step-phone');
+  const stepOtp = document.getElementById('step-otp');
+  const stepSuccess = document.getElementById('step-success');
+
+  const phoneForm = document.getElementById('phone-form');
+  const phoneInput = document.getElementById('phone-input');
+  const phoneError = document.getElementById('phone-error');
+  const sendCodeBtn = document.getElementById('send-code-btn');
+
+  const otpForm = document.getElementById('otp-form');
+  const otpInput = document.getElementById('otp-input');
+  const otpError = document.getElementById('otp-error');
+  const verifyCodeBtn = document.getElementById('verify-code-btn');
+
+  const phoneDisplayValue = document.getElementById('phone-display-value');
+  const editPhoneBtn = document.getElementById('edit-phone-btn');
+  const resendCodeBtn = document.getElementById('resend-code-btn');
+  const resendTimerSpan = document.getElementById('resend-timer');
+
+  const autoExtractTrigger = document.getElementById('auto-extract-trigger');
+  const smsTextPreview = document.getElementById('sms-text-preview');
+  const smsOriginPreview = document.getElementById('sms-origin-preview');
+
+  const stepNav1 = document.getElementById('step-nav-1');
+  const stepNav2 = document.getElementById('step-nav-2');
+  const stepNav3 = document.getElementById('step-nav-3');
+
+  const successHeading = document.getElementById('step-3-title');
+  const successPhoneDisplay = document.getElementById('success-phone-display');
+  const verifyAnotherBtn = document.getElementById('verify-another-btn');
+
+  const a11yAnnouncer = document.getElementById('a11y-announcer');
+
+  // State Management
+  const state = {
