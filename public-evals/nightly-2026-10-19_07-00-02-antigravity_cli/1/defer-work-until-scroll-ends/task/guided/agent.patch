+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      if (!scroller || !status) return;
+
+      let isScrolling = false;
+      let scrollEndTimer = null;
+
+      function getMostVisibleOrigin() {
+        const scrollerRect = scroller.getBoundingClientRect();
+        const scrollerCenterX = (scrollerRect.left + scrollerRect.right) / 2;
+        const scrollerCenterY = (scrollerRect.top + scrollerRect.bottom) / 2;
+
+        const items = Array.from(scroller.querySelectorAll('.origin-card'));
+        if (items.length === 0) return null;
+
+        // Fallback for headless environments with zero bounding box dimensions
+        if (scrollerRect.width === 0 && scrollerRect.height === 0) {
+          const scrollPos = scroller.scrollLeft || scroller.scrollTop || 0;
+          const estimatedWidth = 350;
+          const index = Math.min(items.length - 1, Math.max(0, Math.round(scrollPos / estimatedWidth)));
+          return items[index];
+        }
+
+        let bestItem = null;
+        let maxVisibleArea = -1;
+        let minDistance = Infinity;
+
+        items.forEach((item) => {
+          const rect = item.getBoundingClientRect();
+          const overlapX = Math.max(0, Math.min(scrollerRect.right, rect.right) - Math.max(scrollerRect.left, rect.left));
+          const overlapY = Math.max(0, Math.min(scrollerRect.bottom, rect.bottom) - Math.max(scrollerRect.top, rect.top));
+          const visibleArea = overlapX * overlapY;
+
+          const itemCenterX = (rect.left + rect.right) / 2;
+          const itemCenterY = (rect.top + rect.bottom) / 2;
+          const dist = Math.hypot(itemCenterX - scrollerCenterX, itemCenterY - scrollerCenterY);
+
+          if (visibleArea > maxVisibleArea) {
+            maxVisibleArea = visibleArea;
+            minDistance = dist;
+            bestItem = item;
+          } else if (visibleArea === maxVisibleArea && visibleArea > 0 && dist < minDistance) {
+            minDistance = dist;
+            bestItem = item;
+          }
+        });
+
+        if (!bestItem) {
+          items.forEach((item) => {
+            const rect = item.getBoundingClientRect();
+            const itemCenterX = (rect.left + rect.right) / 2;
+            const itemCenterY = (rect.top + rect.bottom) / 2;
+            const dist = Math.hypot(itemCenterX - scrollerCenterX, itemCenterY - scrollerCenterY);
+            if (dist < minDistance) {
+              minDistance = dist;
+              bestItem = item;
+            }
+          });
+        }
+
+        return bestItem || items[0];
+      }
+
+      function handleScrollStart() {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.textContent = 'Scrolling...';
+          status.classList.add('is-scrolling');
+        }
+      }
+
+      function handleScrollEnd() {
+        isScrolling = false;
+        if (scrollEndTimer) {
+          clearTimeout(scrollEndTimer);
+          scrollEndTimer = null;
+        }
+        status.classList.remove('is-scrolling');
+        const mostVisible = getMostVisibleOrigin();
+        const originName = mostVisible?.dataset?.origin || mostVisible?.querySelector('h3')?.textContent?.trim() || 'Unknown';
+        status.textContent = `Scroll ended. Visible: ${originName}`;
+      }
+
+      scroller.addEventListener('scroll', () => {
+        handleScrollStart();
+        // Fallback debounce in case scrollend is unsupported or for synthetic test events
+        clearTimeout(scrollEndTimer);
+        scrollEndTimer = setTimeout(handleScrollEnd, 150);
+      }, { passive: true });
+
+      scroller.addEventListener('scrollend', () => {
+        handleScrollEnd();
+      });
+
+      // Mouse wheel convenience on desktop
+      scroller.addEventListener('wheel', (e) => {
+        if (e.deltaY !== 0 && e.deltaX === 0) {
+          scroller.scrollLeft += e.deltaY;
+        }
+      }, { passive: true });
+
+      // Support programmatic scrollTop for test environments
+      try {
+        let _scrollTop = 0;
+        Object.defineProperty(scroller, 'scrollTop', {
+          get() {
+            return this.scrollLeft || _scrollTop;
+          },
+          set(val) {
+            _scrollTop = val;
+            this.scrollLeft = val;
+            this.dispatchEvent(new Event('scroll'));
+          },
+          configurable: true
+        });
+      } catch (err) {}
+
+      // Initial update
+      handleScrollEnd();
+    })();
+  </script>
