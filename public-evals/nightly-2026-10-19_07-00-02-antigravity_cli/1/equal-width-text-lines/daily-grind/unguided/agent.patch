+  <script>
+    function fitLockup() {
+      const lockup = document.querySelector('.poster-lockup');
+      if (!lockup) return;
+      const targetWidth = lockup.clientWidth;
+      if (!targetWidth) return;
+
+      const texts = lockup.querySelectorAll('.poster-text');
+      texts.forEach(el => {
+        el.style.fontSize = '100px';
+        const initialWidth = el.getBoundingClientRect().width;
+        if (!initialWidth) return;
+
+        let fontSize = 100 * (targetWidth / initialWidth);
+        el.style.fontSize = fontSize + 'px';
+
+        const measured = el.getBoundingClientRect().width;
+        if (Math.abs(measured - targetWidth) > 0.2) {
+          fontSize = fontSize * (targetWidth / measured);
+          el.style.fontSize = fontSize + 'px';
+        }
+      });
+    }
+
+    fitLockup();
+
+    if (document.fonts && document.fonts.ready) {
+      document.fonts.ready.then(fitLockup);
+    }
+
+    if ('ResizeObserver' in window) {
+      const observer = new ResizeObserver(() => fitLockup());
+      const lockup = document.querySelector('.poster-lockup');
+      if (lockup) observer.observe(lockup);
+    } else {
+      window.addEventListener('resize', fitLockup);
+    }
+
+    window.addEventListener('load', fitLockup);
+  </script>
+
