+  <script type="module">
+    function formatDuration(hours, minutes, largestUnit) {
+      const locale = (typeof navigator !== 'undefined' && navigator.language) ? navigator.language : 'en';
+
+      if (typeof Temporal !== 'undefined' && Temporal.Duration) {
+        try {
+          const duration = Temporal.Duration.from({ hours, minutes });
+          const balanced = duration.round({ largestUnit });
+          if (typeof Intl !== 'undefined' && Intl.DurationFormat) {
+            const formatter = new Intl.DurationFormat(locale, { style: 'long' });
+            const res = formatter.format(balanced);
+            if (res) return res;
+            const zeroFormatter = new Intl.DurationFormat(locale, {
+              style: 'long',
+              [largestUnit + 'Display']: 'always'
+            });
+            return zeroFormatter.format({ [largestUnit]: 0 });
+          } else {
+            const h = balanced.hours;
+            const m = balanced.minutes;
+            if (largestUnit === 'minutes') {
+              return `${m} minute${m === 1 ? '' : 's'}`;
+            }
+            if (h > 0 && m > 0) {
+              return `${h} hour${h === 1 ? '' : 's'} and ${m} minute${m === 1 ? '' : 's'}`;
+            } else if (h > 0) {
+              return `${h} hour${h === 1 ? '' : 's'}`;
+            } else {
+              return `${m} minute${m === 1 ? '' : 's'}`;
+            }
+          }
+        } catch (e) {
+          console.warn('Temporal duration formatting error:', e);
+        }
+      }
+
+      // Fallback balancing when Temporal is not yet loaded
+      let h = hours;
+      let m = minutes;
+      if (largestUnit === 'minutes') {
+        m = hours * 60 + minutes;
+        h = 0;
+      } else {
+        h = hours + Math.floor(minutes / 60);
+        m = minutes % 60;
+      }
+
+      if (typeof Intl !== 'undefined' && Intl.DurationFormat) {
+        try {
+          const formatter = new Intl.DurationFormat(locale, { style: 'long' });
+          const durationObj = largestUnit === 'minutes' ? { minutes: m } : { hours: h, minutes: m };
+          const res = formatter.format(durationObj);
+          if (res) return res;
+          const zeroFormatter = new Intl.DurationFormat(locale, {
+            style: 'long',
+            [largestUnit + 'Display']: 'always'
+          });
+          return zeroFormatter.format({ [largestUnit]: 0 });
+        } catch (e) {
+          console.warn('Intl.DurationFormat error:', e);
+        }
+      }
+
+      // Fallback manual formatting
+      if (largestUnit === 'minutes') {
+        return `${m} minute${m === 1 ? '' : 's'}`;
+      }
+      if (h > 0 && m > 0) {
+        return `${h} hour${h === 1 ? '' : 's'} and ${m} minute${m === 1 ? '' : 's'}`;
+      } else if (h > 0) {
+        return `${h} hour${h === 1 ? '' : 's'}`;
+      } else {
+        return `${m} minute${m === 1 ? '' : 's'}`;
+      }
+    }
+
+    function updateDuration() {
+      const hoursInput = document.getElementById('hoursInput');
+      const minutesInput = document.getElementById('minutesInput');
+      const humanValue = document.getElementById('humanValue');
+      const selectedRadio = document.querySelector('input[name="largestUnit"]:checked');
+      const largestUnit = selectedRadio ? selectedRadio.value : 'hours';
+
+      const hours = Math.max(0, parseInt(hoursInput?.value, 10) || 0);
+      const minutes = Math.max(0, parseInt(minutesInput?.value, 10) || 0);
+
+      const formatted = formatDuration(hours, minutes, largestUnit);
+      if (humanValue) {
+        humanValue.textContent = formatted;
+      }
+    }
+
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const radioInputs = document.querySelectorAll('input[name="largestUnit"]');
+
+    if (hoursInput) {
+      hoursInput.addEventListener('input', updateDuration);
+      hoursInput.addEventListener('change', updateDuration);
+    }
+    if (minutesInput) {
+      minutesInput.addEventListener('input', updateDuration);
+      minutesInput.addEventListener('change', updateDuration);
+    }
+    radioInputs.forEach(radio => {
+      radio.addEventListener('change', updateDuration);
+      radio.addEventListener('input', updateDuration);
+    });
+
+    updateDuration();
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        try {
+          const module = await import("https://esm.sh/@js-temporal/polyfill");
+          globalThis.Temporal = module.Temporal;
+          updateDuration();
+        } catch (err) {
+          // Fallback already in place
+        }
+      }
+    })();
+  </script>
+
