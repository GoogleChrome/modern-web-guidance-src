+  <script>
+    (function () {
+      function initToggle() {
+        const toggleBtn = document.getElementById('toggle-spacious');
+        const targetContainer = document.getElementById('target-container');
+
+        if (toggleBtn && targetContainer) {
+          toggleBtn.addEventListener('click', function () {
+            const isSpacious = targetContainer.style.getPropertyValue('--layout-density') === 'spacious' ||
+                               targetContainer.style.getPropertyValue('--density') === 'spacious';
+            if (isSpacious) {
+              targetContainer.style.removeProperty('--layout-density');
+              targetContainer.style.removeProperty('--density');
+            } else {
+              targetContainer.style.setProperty('--layout-density', 'spacious');
+              targetContainer.style.setProperty('--density', 'spacious');
+            }
+          });
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initToggle);
+      } else {
+        initToggle();
+      }
+    })();
+  </script>
