+  <dialog id="logout-dialog" class="logout-dialog" closedby="any">
+    <p class="dialog-message">are you sure?</p>
+    <div class="dialog-actions">
+      <a href="/logout" class="btn btn-confirm">Logout</a>
+      <button type="button" class="btn btn-cancel" id="cancel-logout">Cancel</button>
+    </div>
+  </dialog>
+
+  <script>
+    const logoutDialog = document.getElementById('logout-dialog');
+    const logoutTrigger = document.querySelector('.test-dialog-trigger');
+    const cancelBtn = document.getElementById('cancel-logout');
+
+    if (logoutTrigger && logoutDialog) {
+      logoutTrigger.addEventListener('click', (e) => {
+        e.preventDefault();
+        logoutDialog.showModal();
+      });
+    }
+
+    if (cancelBtn && logoutDialog) {
+      cancelBtn.addEventListener('click', () => {
+        logoutDialog.close();
+      });
+    }
+
+    // Close modal when clicking outside on the backdrop
+    logoutDialog.addEventListener('click', (event) => {
+      if (event.target === logoutDialog) {
+        const rect = logoutDialog.getBoundingClientRect();
+        const isInDialog = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.bottom &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.right
+        );
+        if (!isInDialog && logoutDialog.open) {
+          logoutDialog.close();
+        }
+      }
+    });
+
+    // Fallback for click events on document/body
+    document.addEventListener('click', (event) => {
+      if (!logoutDialog.open) return;
+      if (event.target.closest && event.target.closest('.test-dialog-trigger')) return;
+      if (!logoutDialog.contains(event.target)) {
+        logoutDialog.close();
+      }
+    });
+  </script>
+
 </body>
 
