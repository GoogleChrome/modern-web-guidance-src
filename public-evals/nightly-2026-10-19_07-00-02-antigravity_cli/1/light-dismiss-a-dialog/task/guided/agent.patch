+  <dialog id="logout-dialog" closedby="any" aria-labelledby="logout-dialog-title">
+    <form method="dialog" class="dialog-content">
+      <h2 id="logout-dialog-title">Are you sure?</h2>
+      <p>Are you sure you want to log out?</p>
+      <div class="dialog-actions">
+        <button type="submit" value="cancel" class="btn btn-secondary cancel-btn">Cancel</button>
+        <a href="/logout" class="btn">Logout</a>
+      </div>
+    </form>
+  </dialog>
+
+  <script>
+    const logoutTrigger = document.querySelector('.test-dialog-trigger');
+    const logoutDialog = document.getElementById('logout-dialog');
+
+    if (logoutTrigger && logoutDialog) {
+      logoutTrigger.addEventListener('click', (event) => {
+        event.preventDefault();
+        logoutDialog.showModal();
+      });
+
+      // Light-dismiss: close when clicking anywhere outside of the dialog on the backdrop
+      logoutDialog.addEventListener('click', (event) => {
+        if (event.target !== logoutDialog) return;
+
+        const rect = logoutDialog.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+
+        if (!isDialogContent) {
+          logoutDialog.close();
+        }
+      });
+    }
+  </script>
+
