+  <script>
+    // Browser Native AI Summarizer Logic
+    document.addEventListener('DOMContentLoaded', () => {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const summarizeBtnText = summarizeBtn.querySelector('span');
+      const aiStatus = document.getElementById('ai-status');
+      const summaryContainer = document.getElementById('summary-container');
+      const summaryBulletList = document.getElementById('summary-bullet-list');
+      const aiBadge = document.getElementById('ai-provider-badge');
+      const articleEl = document.getElementById('journal-text');
+
+      function parseBullets(text) {
+        const lines = text
+          .split('\n')
+          .map(line => line.trim())
+          .filter(line => line.length > 0);
+
+        const bullets = [];
+        for (const line of lines) {
+          // Strip leading bullet markers (*, -, •, 1., etc.)
+          const cleaned = line.replace(/^[\*\-\•\d+\.]\s*/, '').trim();
+          if (cleaned.length > 0) {
+            bullets.push(cleaned);
+          }
+        }
+        return bullets.length > 0 ? bullets : [text.trim()];
+      }
+
+      function renderBullets(text) {
+        summaryBulletList.innerHTML = '';
+        const bullets = parseBullets(text);
+
+        bullets.forEach(bullet => {
+          const li = document.createElement('li');
+          // Escape HTML and convert **bold** markdown to <strong>
+          const tempDiv = document.createElement('div');
+          tempDiv.textContent = bullet;
+          li.innerHTML = tempDiv.innerHTML.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
+          summaryBulletList.appendChild(li);
+        });
+      }
+
+      summarizeBtn.addEventListener('click', async () => {
+        const textToSummarize = articleEl.innerText.trim();
+
+        // Update button state to loading
+        summarizeBtn.disabled = true;
+        summarizeBtnText.textContent = 'Summarizing...';
+        aiStatus.textContent = 'Contacting browser native AI...';
+
+        let summaryResult = null;
+        let sourceEngine = 'Browser Native AI';
+
+        try {
+          // Method 1: Chrome 138+ standard Summarizer API (window.Summarizer)
+          if (typeof Summarizer !== 'undefined') {
+            let available = true;
+            if (typeof Summarizer.availability === 'function') {
+              const status = await Summarizer.availability();
+              if (status === 'no') available = false;
+            }
+            if (available) {
+              const summarizer = await Summarizer.create({
+                type: 'key-points',
+                format: 'markdown',
+                length: 'short'
+              });
+              summaryResult = await summarizer.summarize(textToSummarize);
+              sourceEngine = 'Browser Native AI (Summarizer API)';
+            }
+          }
+
+          // Method 2: Origin trial / window.ai.summarizer
+          if (!summaryResult && window.ai?.summarizer) {
+            let available = true;
+            if (typeof window.ai.summarizer.availability === 'function') {
+              const status = await window.ai.summarizer.availability();
+              if (status === 'no') available = false;
+            } else if (typeof window.ai.summarizer.capabilities === 'function') {
+              const caps = await window.ai.summarizer.capabilities();
+              if (caps.available === 'no') available = false;
+            }
+            if (available) {
+              const summarizer = await window.ai.summarizer.create({
+                type: 'key-points',
+                format: 'markdown',
+                length: 'short'
+              });
+              summaryResult = await summarizer.summarize(textToSummarize);
+              sourceEngine = 'Browser Native AI (ai.summarizer)';
+            }
+          }
+
+          // Method 3: Prompt API (window.LanguageModel or window.ai.languageModel)
+          if (!summaryResult) {
+            const LM = typeof LanguageModel !== 'undefined' ? LanguageModel : window.ai?.languageModel;
+            if (LM) {
+              let available = true;
+              if (typeof LM.availability === 'function') {
+                const status = await LM.availability();
+                if (status === 'no') available = false;
+              } else if (typeof LM.capabilities === 'function') {
+                const caps = await LM.capabilities();
+                if (caps.available === 'no') available = false;
+              }
+              if (available) {
+                const session = await LM.create({
+                  systemPrompt: 'You summarize coffee sourcing text into 3 to 4 concise, impactful bullet points.'
+                });
+                summaryResult = await session.prompt(
+                  `Summarize the following bean sourcing article into 3-4 concise bullet points:\n\n${textToSummarize}`
+                );
+                sourceEngine = 'Browser Native AI (Prompt API)';
+              }
+            }
+          }
+
+          // Fallback if browser native AI is unsupported or model is unavailable
+          if (!summaryResult) {
+            summaryResult = [
+              '* **High-Altitude Terroir:** Sourced strictly between 1,800m and 2,200m in Colombia, Ethiopia, and Guatemala for peak sugar concentration and complex acidity.',
+              '* **Selective Hand-Harvesting:** Multiple hand-picking passes harvest only peak-brix crimson cherries, processed via mountain spring wash or raised-bed natural drying.',
+              '* **Strict 86+ SCA Standard:** Only the top 3% of sampled micro-lots pass blind cupping tests for clean cup, aroma, and flavor balance.',
+              '* **Direct-Trade Partnerships:** Direct purchasing pays 40% above fair-trade baselines, funding local clean water, agroforestry, and regenerative farming.'
+            ].join('\n');
+            sourceEngine = 'Simulated Native AI (Browser AI not active)';
+          }
+
+          renderBullets(summaryResult);
+          aiBadge.textContent = sourceEngine;
+          summaryContainer.style.display = 'block';
+          aiStatus.textContent = '';
+          summarizeBtnText.textContent = '✨ Re-summarize';
+          summaryContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+        } catch (error) {
+          console.warn('Native AI summarization encountered an issue:', error);
+          // Graceful fallback display
+          const fallback = [
+            '* **High-Altitude Terroir:** Sourced strictly between 1,800m and 2,200m in Colombia, Ethiopia, and Guatemala for peak sugar concentration and complex acidity.',
+            '* **Selective Hand-Harvesting:** Multiple hand-picking passes harvest only peak-brix crimson cherries, processed via mountain spring wash or raised-bed natural drying.',
+            '* **Strict 86+ SCA Standard:** Only the top 3% of sampled micro-lots pass blind cupping tests for clean cup, aroma, and flavor balance.',
+            '* **Direct-Trade Partnerships:** Direct purchasing pays 40% above fair-trade baselines, funding local clean water, agroforestry, and regenerative farming.'
+          ].join('\n');
+          renderBullets(fallback);
+          aiBadge.textContent = 'Fallback Mode';
+          summaryContainer.style.display = 'block';
+          aiStatus.textContent = '';
+          summarizeBtnText.textContent = '✨ Re-summarize';
+        } finally {
+          summarizeBtn.disabled = false;
+        }
+      });
+    });
+  </script>
