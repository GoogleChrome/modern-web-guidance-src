   </main>
 
+  <script>
+    (function () {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const summarizeBtnLabel = document.getElementById('summarize-btn-label');
+      const aiStatus = document.getElementById('ai-status');
+      const summarySection = document.getElementById('summary-section');
+      const summaryBullets = document.getElementById('summary-bullets');
+      const aiBadge = document.getElementById('ai-badge');
+      const journalArticle = document.getElementById('journal-article');
+
+      // Configuration options must be identical for Summarizer.availability() and Summarizer.create()
+      const summarizerOptions = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'medium'
+      };
+
+      function parseBullets(text) {
+        const lines = text
+          .split(/\r?\n/)
+          .map(function (line) { return line.trim(); })
+          .filter(function (line) { return line.length > 0; });
+
+        const bullets = [];
+        for (var i = 0; i < lines.length; i++) {
+          // Strip leading bullet markers (*, -, •, 1., etc.)
+          var cleaned = lines[i].replace(/^([*•\-–—]|\d+[.)])\s*/, '').trim();
+          if (cleaned.length > 0) {
+            bullets.push(cleaned);
+          }
+        }
+
+        if (bullets.length > 0) {
+          return bullets;
+        }
+
+        // Fallback: split on sentence boundaries if model output plain prose
+        return text
+          .split(/(?<=[.!?])\s+/)
+          .map(function (s) { return s.trim(); })
+          .filter(function (s) { return s.length > 0; });
+      }
+
+      function renderBullets(bulletsList) {
+        summaryBullets.innerHTML = '';
+        for (var i = 0; i < bulletsList.length; i++) {
+          var li = document.createElement('li');
+          li.textContent = bulletsList[i];
+          summaryBullets.appendChild(li);
+        }
+        summarySection.hidden = false;
+        summarySection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+      }
+
+      var staticFallbackBullets = [
+        "Ethical sourcing above 1,700m in Colombia, Ethiopia, and Guatemala cultivates complex acidity and sugars through slow cherry maturation.",
+        "Direct-trade relationships pay 40% above fair-trade minimums to support farm soil health, shade biodiversity, and living wages.",
+        "Selective hand-harvesting and controlled processing (anaerobic & African drying beds) maintain precise 10.5% bean moisture.",
+        "Strict SCA cupping and climate-monitored shipping ensure peak freshness before small-batch roasting in cast-iron drums."
+      ];
+
+      summarizeBtn.addEventListener('click', async function () {
+        summarizeBtn.disabled = true;
+        summarizeBtnLabel.textContent = 'Summarizing...';
+        aiStatus.textContent = 'Analyzing journal text with AI...';
+
+        var textToSummarize = journalArticle.innerText;
+
+        try {
+          if ('Summarizer' in self) {
+            var availability = await Summarizer.availability(summarizerOptions);
+
+            if (availability === 'available' || availability === 'downloadable' || availability === 'downloading') {
+              if (availability === 'downloadable' || availability === 'downloading') {
+                aiStatus.textContent = 'Preparing native AI model download...';
+              }
+
+              var summarizer = await Summarizer.create({
+                ...summarizerOptions,
+                monitor: function (m) {
+                  m.addEventListener('downloadprogress', function (e) {
+                    var pct = Math.round((e.loaded / e.total) * 100);
+                    aiStatus.textContent = 'Downloading on-device AI model: ' + pct + '%...';
+                  });
+                }
+              });
+
+              aiStatus.textContent = 'Distilling key takeaways with on-device AI...';
+              var rawSummary = await summarizer.summarize(textToSummarize);
+
+              if (typeof summarizer.destroy === 'function') {
+                summarizer.destroy();
+              }
+
+              var bullets = parseBullets(rawSummary);
+              aiBadge.textContent = 'Browser Native AI';
+              aiBadge.className = 'badge';
+              renderBullets(bullets);
+              aiStatus.textContent = 'Summarized successfully using browser native AI.';
+              summarizeBtn.disabled = false;
+              summarizeBtnLabel.textContent = 'Re-Summarize Journal';
+              return;
+            } else {
+              console.warn('Summarizer availability state:', availability);
+            }
+          } else if (typeof self.ai !== 'undefined' && typeof self.ai.summarizer !== 'undefined') {
+            // Compatibility for earlier experimental window.ai
+            var summarizer = await self.ai.summarizer.create(summarizerOptions);
+            var rawSummary = await summarizer.summarize(textToSummarize);
+            if (typeof summarizer.destroy === 'function') {
+              summarizer.destroy();
+            }
+            var bullets = parseBullets(rawSummary);
+            aiBadge.textContent = 'Browser Native AI';
+            aiBadge.className = 'badge';
+            renderBullets(bullets);
+            aiStatus.textContent = 'Summarized successfully using browser native AI.';
+            summarizeBtn.disabled = false;
+            summarizeBtnLabel.textContent = 'Re-Summarize Journal';
+            return;
+          }
+        } catch (err) {
+          console.warn('Native Summarizer API error, using fallback:', err);
+        }
+
+        // Fallback for browsers without native Summarizer API support
+        aiBadge.textContent = 'Standard Summary (Native AI Unsupported)';
+        aiBadge.className = 'badge fallback-badge';
+        renderBullets(staticFallbackBullets);
+        aiStatus.textContent = 'Browser Built-in AI Summarizer API is unavailable in this browser; displayed standard key takeaways.';
+        summarizeBtn.disabled = false;
+        summarizeBtnLabel.textContent = 'Re-Summarize Journal';
+      });
+    })();
+  </script>
+
