+  <script>
+    (function () {
+      function initSeasonalTOC() {
+        const panel = document.querySelector('.seasonal-panel');
+        const tocLinks = document.querySelectorAll('.toc-sidebar a');
+        if (!panel || !tocLinks.length) return;
+
+        function setActiveLink(targetId) {
+          if (!targetId) return;
+          tocLinks.forEach(link => {
+            const href = link.getAttribute('href');
+            const id = href ? href.replace('#', '') : '';
+            if (id === targetId) {
+              link.setAttribute('aria-current', 'true');
+              link.classList.add('active');
+            } else {
+              link.removeAttribute('aria-current');
+              link.classList.remove('active');
+            }
+          });
+        }
+
+        // Clicking any TOC link smoothly scrolls the panel to that section
+        tocLinks.forEach(link => {
+          link.addEventListener('click', (event) => {
+            event.preventDefault();
+            const targetId = link.getAttribute('href').replace('#', '');
+            const targetSection = document.getElementById(targetId);
+            if (targetSection) {
+              const header = targetSection.querySelector('header') || targetSection;
+              const panelRect = panel.getBoundingClientRect();
+              const headerRect = header.getBoundingClientRect();
+              const targetTop = panel.scrollTop + (headerRect.top - panelRect.top);
+
+              panel.scrollTo({
+                top: targetTop,
+                behavior: 'smooth'
+              });
+
+              setActiveLink(targetId);
+            }
+          });
+        });
+
+        function getSectionIdFromElement(el) {
+          if (!el) return null;
+          const section = el.closest('.drink-section') || (el.classList.contains('drink-section') ? el : null);
+          return section ? section.id : (el.id || null);
+        }
+
+        // Scroll snap state sync: highlight corresponding sidebar link when snapped
+        if ('onscrollsnapchange' in HTMLElement.prototype || 'onscrollsnapchange' in window) {
+          panel.addEventListener('scrollsnapchange', (event) => {
+            const snappedElement = event.snapTargetBlock;
+            if (snappedElement) {
+              const id = getSectionIdFromElement(snappedElement);
+              if (id) setActiveLink(id);
+            }
+          });
+        } else if ('IntersectionObserver' in window) {
+          // IntersectionObserver fallback
+          const headers = panel.querySelectorAll('.drink-section header');
+          const observer = new IntersectionObserver(
+            () => {
+              const panelRect = panel.getBoundingClientRect();
+              let closestHeader = null;
+              let minDiff = Infinity;
+
+              headers.forEach(header => {
+                const rect = header.getBoundingClientRect();
+                if (rect.bottom >= panelRect.top && rect.top <= panelRect.bottom) {
+                  const diff = Math.abs(rect.top - panelRect.top);
+                  if (diff < minDiff) {
+                    minDiff = diff;
+                    closestHeader = header;
+                  }
+                }
+              });
+
+              if (closestHeader) {
+                const id = getSectionIdFromElement(closestHeader);
+                if (id) setActiveLink(id);
+              }
+            },
+            { root: panel, threshold: [0, 0.25, 0.5, 0.75, 1.0] }
+          );
+
+          headers.forEach(h => observer.observe(h));
+        }
+
+        // Fallback for scroll events
+        let scrollTimeout;
+        panel.addEventListener('scroll', () => {
+          if (!('onscrollsnapchange' in HTMLElement.prototype || 'onscrollsnapchange' in window)) {
+            clearTimeout(scrollTimeout);
+            scrollTimeout = setTimeout(() => {
+              const headers = panel.querySelectorAll('.drink-section header');
+              const panelRect = panel.getBoundingClientRect();
+              let closestHeader = null;
+              let minDiff = Infinity;
+
+              headers.forEach(header => {
+                const rect = header.getBoundingClientRect();
+                const diff = Math.abs(rect.top - panelRect.top);
+                if (diff < minDiff) {
+                  minDiff = diff;
+                  closestHeader = header;
+                }
+              });
+
+              if (closestHeader) {
+                const id = getSectionIdFromElement(closestHeader);
+                if (id) setActiveLink(id);
+              }
+            }, 50);
+          }
+        }, { passive: true });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initSeasonalTOC);
+      } else {
+        initSeasonalTOC();
+      }
+    })();
+  </script>
