+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocSidebar = document.querySelector('.toc-sidebar');
+      if (!panel || !tocSidebar) return;
+
+      const tocLinks = Array.from(tocSidebar.querySelectorAll('a'));
+      const drinkSections = Array.from(panel.querySelectorAll('.drink-section'));
+
+      function setActiveDrink(activeId) {
+        tocLinks.forEach(link => {
+          const href = link.getAttribute('href') || '';
+          const targetId = href.replace(/^#/, '');
+          if (targetId === activeId) {
+            link.setAttribute('aria-current', 'true');
+            link.classList.add('active');
+          } else {
+            link.removeAttribute('aria-current');
+            link.classList.remove('active');
+          }
+        });
+      }
+
+      // Smooth scrolling on TOC link click
+      tocLinks.forEach(link => {
+        link.addEventListener('click', function (e) {
+          e.preventDefault();
+          const href = this.getAttribute('href') || '';
+          const targetId = href.replace(/^#/, '');
+          const targetSection = document.getElementById(targetId);
+
+          if (!targetSection) return;
+
+          setActiveDrink(targetId);
+
+          const panelRect = panel.getBoundingClientRect();
+          const targetRect = targetSection.getBoundingClientRect();
+          const scrollTarget = targetRect.top - panelRect.top + panel.scrollTop;
+
+          panel.scrollTo({
+            top: scrollTarget,
+            behavior: 'smooth'
+          });
+
+          if (typeof targetSection.scrollIntoView === 'function') {
+            targetSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+          }
+
+          if (history.pushState) {
+            history.pushState(null, '', '#' + targetId);
+          }
+        });
+      });
+
+      // Update active link based on scroll position / snapping
+      function updateActiveOnScroll() {
+        if (!drinkSections.length) return;
+
+        const panelRect = panel.getBoundingClientRect();
+        const panelCenter = panelRect.top + panelRect.height / 2;
+
+        let closestId = drinkSections[0].id;
+        let minDistance = Infinity;
+
+        drinkSections.forEach(section => {
+          const rect = section.getBoundingClientRect();
+          const sectionCenter = rect.top + rect.height / 2;
+          const dist = Math.abs(sectionCenter - panelCenter);
+          if (dist < minDistance) {
+            minDistance = dist;
+            closestId = section.id;
+          }
+        });
+
+        if (closestId) {
+          setActiveDrink(closestId);
+        }
+      }
+
+      // IntersectionObserver to detect snapped section in view
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          let mostVisibleId = null;
+          let maxRatio = 0;
+
+          drinkSections.forEach(section => {
+            const panelRect = panel.getBoundingClientRect();
+            const sectionRect = section.getBoundingClientRect();
+
+            const visibleTop = Math.max(panelRect.top, sectionRect.top);
+            const visibleBottom = Math.min(panelRect.bottom, sectionRect.bottom);
+            const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+            const ratio = sectionRect.height > 0 ? visibleHeight / sectionRect.height : 0;
+
+            if (ratio > maxRatio) {
+              maxRatio = ratio;
+              mostVisibleId = section.id;
+            }
+          });
+
+          if (mostVisibleId && maxRatio > 0.3) {
+            setActiveDrink(mostVisibleId);
+          }
+        }, {
+          root: panel,
+          threshold: [0.1, 0.3, 0.5, 0.7, 0.9, 1.0]
+        });
+
+        drinkSections.forEach(section => observer.observe(section));
+      }
+
+      let ticking = false;
+      panel.addEventListener('scroll', function () {
+        if (!ticking) {
+          window.requestAnimationFrame(function () {
+            updateActiveOnScroll();
+            ticking = false;
+          });
+          ticking = true;
+        }
+      }, { passive: true });
+
+      panel.addEventListener('scrollend', updateActiveOnScroll, { passive: true });
+
+      // Initialize on load
+      updateActiveOnScroll();
+    })();
+  </script>
