+  <script>
+    (function () {
+      const preview = document.getElementById('seasonal-preview');
+      const defaultText = 'Select a drink to preview';
+
+      function getDrinkName(source) {
+        if (!source) return '';
+        if (source.dataset && source.dataset.drink) {
+          return source.dataset.drink;
+        }
+        const card = source.closest('.card');
+        if (card) {
+          const heading = card.querySelector('h3');
+          if (heading) return heading.textContent.trim();
+        }
+        return '';
+      }
+
+      function handleInterest(source) {
+        const drinkName = getDrinkName(source);
+        if (drinkName) {
+          preview.textContent = drinkName;
+          preview.style.color = 'var(--primary)';
+          preview.classList.add('active');
+        }
+      }
+
+      function handleLoseInterest() {
+        preview.textContent = defaultText;
+        preview.style.color = '';
+        preview.classList.remove('active');
+      }
+
+      // Declarative Web Platform feature: Interest Invokers (InterestEvent)
+      preview.addEventListener('interest', (event) => {
+        handleInterest(event.source);
+      });
+
+      preview.addEventListener('loseinterest', () => {
+        handleLoseInterest();
+      });
+
+      // Delegation fallback for environments/browsers lacking native Interest Invoker event dispatch
+      document.addEventListener('focusin', (e) => {
+        const invoker = e.target.closest?.('[interestfor="seasonal-preview"], [interesttarget="seasonal-preview"]');
+        if (invoker) {
+          handleInterest(invoker);
+        }
+      });
+
+      document.addEventListener('focusout', (e) => {
+        const invoker = e.target.closest?.('[interestfor="seasonal-preview"], [interesttarget="seasonal-preview"]');
+        if (invoker) {
+          handleLoseInterest();
+        }
+      });
+
+      document.addEventListener('mouseover', (e) => {
+        const invoker = e.target.closest?.('[interestfor="seasonal-preview"], [interesttarget="seasonal-preview"]');
+        if (invoker && !invoker.contains(e.relatedTarget)) {
+          handleInterest(invoker);
+        }
+      });
+
+      document.addEventListener('mouseout', (e) => {
+        const invoker = e.target.closest?.('[interestfor="seasonal-preview"], [interesttarget="seasonal-preview"]');
+        if (invoker && !invoker.contains(e.relatedTarget)) {
+          handleLoseInterest();
+        }
+      });
+    })();
+  </script>
