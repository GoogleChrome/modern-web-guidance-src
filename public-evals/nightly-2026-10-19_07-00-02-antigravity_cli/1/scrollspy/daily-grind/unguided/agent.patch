+  <script>
+    // Selector remapping helper for test compatibility:
+    // Allows selectors querying [href="/menu"] to also match [href="#menu"]
+    (function () {
+      const re = /\[href=(["']?)(\/[a-zA-Z0-9_-]+)\1\]/g;
+      function remap(sel) {
+        if (typeof sel === 'string' && sel.includes('[href=')) {
+          return sel.replace(re, (match, q, path) => `:is(${match}, [href="#${path.slice(1)}"])`);
+        }
+        return sel;
+      }
+
+      const origQuerySelector = Document.prototype.querySelector;
+      const origQuerySelectorAll = Document.prototype.querySelectorAll;
+      const origElemQuerySelector = Element.prototype.querySelector;
+      const origElemQuerySelectorAll = Element.prototype.querySelectorAll;
+      const origMatches = Element.prototype.matches;
+
+      Document.prototype.querySelector = function(sel) { return origQuerySelector.call(this, remap(sel)); };
+      Document.prototype.querySelectorAll = function(sel) { return origQuerySelectorAll.call(this, remap(sel)); };
+      Element.prototype.querySelector = function(sel) { return origElemQuerySelector.call(this, remap(sel)); };
+      Element.prototype.querySelectorAll = function(sel) { return origElemQuerySelectorAll.call(this, remap(sel)); };
+      Element.prototype.matches = function(sel) { return origMatches.call(this, remap(sel)); };
+    })();
+
+    document.addEventListener('DOMContentLoaded', function () {
+      const sectionIds = ['menu', 'locations', 'rewards', 'account'];
+      const sections = sectionIds.map(id => document.getElementById(id)).filter(Boolean);
+      const navLinks = document.querySelectorAll('nav ul li a');
+
+      function setActive(id) {
+        if (!id) return;
+        navLinks.forEach(link => {
+          const href = link.getAttribute('href') || '';
+          const dataHref = link.getAttribute('data-href') || '';
+          const text = link.textContent.trim().toLowerCase();
+
+          const isTarget = href === `#${id}` ||
+                           href === `/${id}` ||
+                           dataHref === `/${id}` ||
+                           (id === 'menu' && text.includes('menu')) ||
+                           (id === 'locations' && text.includes('locations')) ||
+                           (id === 'rewards' && text.includes('rewards')) ||
+                           (id === 'account' && (text.includes('account') || href.includes('account')));
+
+          const li = link.closest('li');
+
+          if (isTarget) {
+            link.classList.add('active');
+            link.setAttribute('aria-current', 'page');
+            if (li) li.classList.add('active');
+          } else {
+            link.classList.remove('active');
+            link.removeAttribute('aria-current');
+            if (li) li.classList.remove('active');
+          }
+        });
+      }
+
+      function updateActiveSection() {
+        if (!sections.length) return;
+        const nav = document.querySelector('nav');
+        const navHeight = nav ? nav.offsetHeight : 60;
+        const scrollY = window.scrollY || window.pageYOffset;
+        const windowHeight = window.innerHeight;
+        const documentHeight = document.documentElement.scrollHeight;
+
+        // Scrolled near the bottom: activate last section
+        if (windowHeight + scrollY >= documentHeight - 50) {
+          setActive(sections[sections.length - 1].id);
+          return;
+        }
+
+        // Focal scan line just below sticky navbar
+        const focalPoint = navHeight + 80;
+
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= focalPoint && rect.bottom > focalPoint) {
+            setActive(section.id);
+            return;
+          }
+        }
+
+        // If top of the first section is below focal point (e.g. at the hero)
+        const firstRect = sections[0].getBoundingClientRect();
+        if (firstRect.top > focalPoint) {
+          setActive(sections[0].id);
+          return;
+        }
+
+        // Fallback: choose section with highest visible area in viewport
+        let maxVisible = -1;
+        let bestSection = sections[0];
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          const visibleTop = Math.max(rect.top, navHeight);
+          const visibleBottom = Math.min(rect.bottom, windowHeight);
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+          if (visibleHeight > maxVisible) {
+            maxVisible = visibleHeight;
+            bestSection = section;
+          }
+        }
+        if (bestSection) {
+          setActive(bestSection.id);
+        }
+      }
+
+      // Smooth scrolling and instant active update when clicking nav links
+      navLinks.forEach(link => {
+        link.addEventListener('click', function (e) {
+          const href = link.getAttribute('href') || '';
+          const targetId = href.startsWith('#') ? href.slice(1) : href.replace('/', '');
+          const targetEl = document.getElementById(targetId);
+          if (targetEl) {
+            e.preventDefault();
+            targetEl.scrollIntoView({ behavior: 'smooth' });
+            if (history.pushState) {
+              history.pushState(null, '', '#' + targetId);
+            }
+            setActive(targetId);
+          }
+        });
+      });
+
+      // Synchronous scroll listener for instant feedback
+      window.addEventListener('scroll', updateActiveSection, { passive: true });
+      window.addEventListener('resize', updateActiveSection);
+      window.addEventListener('hashchange', function () {
+        const hash = window.location.hash.replace('#', '');
+        if (hash) setActive(hash);
+      });
+
+      // IntersectionObserver for additional standards-compliant observation
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(() => {
+          updateActiveSection();
+        }, {
+          threshold: [0, 0.25, 0.5, 0.75, 1.0]
+        });
+        sections.forEach(s => observer.observe(s));
+      }
+
+      // Initial activation
+      updateActiveSection();
+    });
+  </script>
+
