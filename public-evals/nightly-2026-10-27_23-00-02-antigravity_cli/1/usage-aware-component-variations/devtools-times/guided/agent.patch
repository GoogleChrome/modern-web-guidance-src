 @import "tailwindcss";
 
+:root {
+  --brand-accent: #f59e0b;
+  --brand-accent-dark: #92400e;
+  --surface-bg: #ffffff;
+  --surface-featured-bg: #fffbeb;
+  --border-subtle: #f3f4f6;
+}
+
 .font-brand {
   font-family: "Grenze", serif;
   font-weight: 500;
   font-style: normal;
-}
\ No newline at end of file
+}
+
+/* 1. Semantic Context Containers */
+.surface-lead,
+[data-surface="lead"] {
+  --surface: lead;
+}
+
+.surface-featured,
+[data-surface="featured"] {
+  --surface: featured;
+}
+
+.surface-spotlight,
+[data-surface="spotlight"] {
+  --surface: spotlight;
+}
+
+.surface-compact,
+[data-surface="compact"] {
+  --surface: compact;
+}
+
+.surface-related,
+[data-surface="related"] {
+  --surface: related;
+}
+
+/* 2. Default Component Styles (Work everywhere) */
+.article-teaser {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  background: var(--surface-bg);
+}
+
+.article-teaser__layout {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  gap: 0.75rem;
+}
+
+.article-teaser__media {
+  display: block;
+  overflow: clip;
+  border-radius: 0.375rem;
+  flex-shrink: 0;
+}
+
+.article-teaser__image {
+  width: 100%;
+  height: auto;
+  object-fit: cover;
+  aspect-ratio: 16 / 9;
+}
+
+.article-teaser__body {
+  display: flex;
+  flex-direction: column;
+  flex-grow: 1;
+}
+
+.article-teaser__badge {
+  display: none;
+  align-self: flex-start;
+  font-size: 0.75rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  padding: 0.125rem 0.5rem;
+  border-radius: 9999px;
+  background: var(--brand-accent);
+  color: #111827;
+  margin-block-end: 0.5rem;
+}
+
+.article-teaser__category {
+  color: var(--brand-accent-dark);
+  font-size: 0.875rem;
+  letter-spacing: 0.1em;
+}
+
+.article-teaser__title {
+  font-size: 1.25rem;
+  line-height: 1.35;
+  color: #1f2937;
+  margin-block-start: 0.25rem;
+}
+
+.article-teaser__summary {
+  color: #4b5563;
+  margin-block-start: 0.25rem;
+  flex-grow: 1;
+}
+
+.article-teaser__footer {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  color: #6b7280;
+  margin-block-start: 0.75rem;
+  padding-block-start: 0.5rem;
+  border-block-start: 1px solid var(--border-subtle);
+}
+
+.article-teaser__cta {
+  /* Default: Outlined informational style */
+  display: inline-flex;
+  align-items: center;
+  gap: 0.25rem;
+  padding: 0.25rem 0.625rem;
+  font-size: 0.75rem;
+  font-weight: 600;
+  border-radius: 0.25rem;
+  background: transparent;
+  color: #374151;
+  border: 1px solid currentColor;
+  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
+}
+
+.article-teaser__cta:hover {
+  color: #111827;
+}
+
+.bookmark-button {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.25rem;
+  padding: 0.25rem;
+  border-radius: 0.25rem;
+  background: transparent;
+  border: 1px solid transparent;
+  color: #9ca3af;
+  transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
+}
+
+.bookmark-button__label {
+  display: none;
+  font-size: 0.75rem;
+  font-weight: 600;
+}
+
+/* 3. Selector-based Contextual Fallbacks (:where() keeps specificity matching style queries) */
+
+/* Lead surface fallback */
+:where(.surface-lead, [data-surface="lead"]) .article-teaser {
+  padding: 1.5rem;
+  box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
+}
+
+@media (min-width: 1024px) {
+  :where(.surface-lead, [data-surface="lead"]) .article-teaser__layout {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 2rem;
+    align-items: stretch;
+  }
+
+  :where(.surface-lead, [data-surface="lead"]) .article-teaser__body {
+    grid-column: span 1 / span 1;
+    order: -1;
+  }
+
+  :where(.surface-lead, [data-surface="lead"]) .article-teaser__media {
+    grid-column: span 2 / span 2;
+    border-radius: 0;
+  }
+}
+
+:where(.surface-lead, [data-surface="lead"]) .article-teaser__badge {
+  display: inline-block;
+}
+
+:where(.surface-lead, [data-surface="lead"]) .article-teaser__title {
+  font-size: 2.25rem;
+  line-height: 1.15;
+  color: #111827;
+  margin-block-start: 0.5rem;
+}
+
+:where(.surface-lead, [data-surface="lead"]) .article-teaser__summary {
+  font-size: 1.125rem;
+  color: #374151;
+  margin-block-start: 1rem;
+}
+
+:where(.surface-lead, [data-surface="lead"]) .article-teaser__cta {
+  background: var(--brand-accent);
+  color: #111827;
+  border-color: transparent;
+}
+
+:where(.surface-lead, [data-surface="lead"]) .bookmark-button {
+  padding: 0.25rem 0.5rem;
+  border-color: #e5e7eb;
+  color: #4b5563;
+}
+
+:where(.surface-lead, [data-surface="lead"]) .bookmark-button__label {
+  display: inline;
+}
+
+/* Featured surface fallback */
+:where(.surface-featured, [data-surface="featured"]) .article-teaser {
+  box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
+  overflow: clip;
+}
+
