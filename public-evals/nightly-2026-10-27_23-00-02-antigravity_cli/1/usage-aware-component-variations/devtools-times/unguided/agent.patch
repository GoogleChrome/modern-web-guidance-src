@@ -0,0 +1,242 @@
+import React, { useState } from 'react';
+import { useSemanticContext } from '../context/SemanticContext';
+import type {
+  ContentKind,
+  SemanticDomain,
+  SemanticIntent,
+  SemanticPlacement,
+} from '../utils/semanticContext';
+
+export interface SemanticCalloutProps {
+  title: string;
+  summary: string;
+  category: string;
+  author?: string;
+  tags?: string[];
+  readingTime?: number;
+  contentKind?: ContentKind;
+  placement?: SemanticPlacement;
+  overrideDomain?: SemanticDomain;
+  overrideIntent?: SemanticIntent;
+  interactiveLens?: boolean;
+}
+
+export const SemanticCallout: React.FC<SemanticCalloutProps> = ({
+  title,
+  summary,
+  category,
+  author,
+  tags = [],
+  readingTime = 4,
+  contentKind = 'article',
+  placement = 'inline',
+  overrideDomain,
+  overrideIntent,
+  interactiveLens = true,
+}) => {
+  const [localDomainOverride, setLocalDomainOverride] = useState<
+    SemanticDomain | undefined
+  >(overrideDomain);
+
+  const { tokens } = useSemanticContext({
+    title,
+    summary,
+    category,
+    tags,
+    readingTime,
+    contentKind,
+    placement,
+    overrideDomain: localDomainOverride,
+    overrideIntent,
+  });
+
+  const displayTags =
+    tags.length > 0
+      ? tags
+      : [category.toLowerCase(), tokens.domain, tokens.intent];
+
+  return (
+    <aside
+      className={`my-6 p-5 rounded-md shadow-xs transition-all duration-200 ${tokens.calloutBorderClass} ${tokens.calloutBgClass}`}
+      data-semantic-domain={tokens.domain}
+      data-semantic-intent={tokens.intent}
+      aria-label={tokens.calloutTitle}
+    >
+      <div className="flex flex-wrap items-center justify-between gap-2 pb-3 mb-3 border-b border-black/10">
+        <div className="flex items-center gap-2">
+          <span
+            className={`px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider rounded-xs ${tokens.badgeBgClass}`}
+          >
+            {tokens.domainLabel}
+          </span>
+          <span
+            className={`px-2 py-0.5 text-[11px] font-medium rounded-xs ${tokens.intentBadgeClass}`}
+          >
+            {tokens.intentLabel}
+          </span>
+        </div>
+
+        {interactiveLens && (
+          <div className="flex items-center gap-1 text-xs">
+            <span className="text-gray-500 mr-1 font-medium">Context Lens:</span>
+            {(['auto', 'civic', 'discovery', 'culture', 'vitality'] as const).map(
+              (lens) => {
+                const isSelected =
+                  (lens === 'auto' && !localDomainOverride) ||
+                  localDomainOverride === lens;
+                return (
+                  <button
+                    key={lens}
+                    type="button"
+                    onClick={() =>
+                      setLocalDomainOverride(lens === 'auto' ? undefined : lens)
+                    }
+                    className={`px-2 py-0.5 rounded text-[11px] capitalize transition-colors cursor-pointer ${
+                      isSelected
+                        ? 'bg-gray-900 text-white font-semibold'
+                        : 'bg-white/80 text-gray-700 hover:bg-gray-200 border border-gray-300'
+                    }`}
+                  >
+                    {lens}
+                  </button>
+                );
+              }
+            )}
+          </div>
+        )}
+      </div>
+
+      {/* Domain-Adaptive Visual Body */}
+      {tokens.domain === 'civic' && (
+        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
+          <div className="md:col-span-2">
+            <h4 className="font-brand text-xl text-rose-950 mb-1">
+              {tokens.calloutTitle}
+            </h4>
+            <p className="text-sm text-stone-700 font-serif leading-relaxed">
+              {summary}
+            </p>
+          </div>
+          <div className="bg-white/90 border border-rose-200 p-3 rounded-xs">
+            <div className="text-[11px] font-bold uppercase tracking-widest text-rose-900 mb-1">
+              {tokens.metricLabel}
+            </div>
+            <div className="text-sm font-semibold text-stone-900 mb-2">
+              {tokens.metricValue}
+            </div>
+            <div className="flex items-center gap-1" title={`Urgency Score: ${tokens.urgencyScore}/5`}>
+              {[1, 2, 3, 4, 5].map((lvl) => (
+                <span
+                  key={lvl}
+                  className={`h-2 flex-1 rounded-xs ${
+                    lvl <= tokens.urgencyScore ? 'bg-rose-700' : 'bg-rose-200'
+                  }`}
+                />
+              ))}
+            </div>
+            <div className="mt-2 text-[11px] text-stone-500 flex justify-between">
+              <span>Accountability Scope</span>
+              <span>{readingTime} min dossier</span>
+            </div>
+          </div>
+        </div>
+      )}
+
+      {tokens.domain === 'discovery' && (
+        <div className="font-mono text-xs space-y-3">
+          <div className="flex flex-wrap items-center justify-between gap-2 bg-slate-900 text-teal-300 px-3 py-2 rounded-xs">
+            <span>SYS_CONTEXT // {tokens.domainLabel.toUpperCase()}</span>
+            <span>
+              DEPTH: {tokens.readingDepth.toUpperCase()} ({readingTime}M) | RIGOR:{' '}
+              {tokens.metricValue.toUpperCase()}
+            </span>
+          </div>
+          <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
+            <div className="md:col-span-2 bg-white/90 p-3 border border-teal-200">
+              <div className="text-[10px] uppercase tracking-wider text-teal-800 font-bold mb-1">
+                Abstract & Empirical Scope
+              </div>
+              <p className="font-sans text-sm text-slate-700 leading-relaxed">
+                {summary}
+              </p>
+            </div>
+            <div className="bg-white/90 p-3 border border-teal-200 flex flex-col justify-between">
+              <div>
+                <div className="text-[10px] uppercase tracking-wider text-teal-800 font-bold mb-1">
+                  Research Vectors
+                </div>
+                <div className="flex flex-wrap gap-1 mt-1">
+                  {displayTags.map((t) => (
+                    <span
+                      key={t}
+                      className="px-1.5 py-0.5 bg-teal-50 text-teal-900 border border-teal-300 text-[10px]"
+                    >
+                      #{t}
+                    </span>
+                  ))}
+                </div>
+              </div>
+              {author && (
+                <div className="mt-2 pt-2 border-t border-slate-200 text-[11px] text-slate-500">
+                  LEAD: {author}
+                </div>
+              )}
+            </div>
+          </div>
+        </div>
+      )}
+
+      {tokens.domain === 'culture' && (
+        <div className="relative px-2 py-1">
+          <div className="font-serif italic text-purple-900 text-xs uppercase tracking-widest mb-1">
+            {tokens.calloutTitle} — {tokens.metricValue}
+          </div>
+          <blockquote className="font-brand italic text-xl md:text-2xl text-gray-900 leading-snug border-l-2 border-purple-400 pl-4 my-2">
+            “{summary}”
+          </blockquote>
+          <div className="flex flex-wrap items-center justify-between gap-2 mt-3 text-xs text-purple-950/75 font-serif">
+            <span>
+              Curated in <strong>{category}</strong>
+              {author ? ` • Critique by ${author}` : ''}
+            </span>
+            <div className="flex flex-wrap gap-1.5">
+              {displayTags.map((t) => (
+                <span
+                  key={t}
+                  className="px-2 py-0.5 rounded-full bg-purple-100/80 text-purple-900 italic"
+                >
+                  {t}
+                </span>
+              ))}
+            </div>
+          </div>
+        </div>
+      )}
+
+      {tokens.domain === 'vitality' && (
+        <div className="grid grid-cols-1 md:grid-cols-4 gap-3 items-center">
+          <div className="md:col-span-3">
+            <div className="text-xs font-extrabold uppercase tracking-wider text-emerald-800 mb-1 flex items-center gap-1.5">
