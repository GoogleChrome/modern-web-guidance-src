--- /dev/null
+++ b/src/utils/semanticContext.ts
@@ -0,0 +1,349 @@
+export type SemanticDomain = 'civic' | 'discovery' | 'culture' | 'vitality';
+
+export type SemanticIntent =
+  | 'urgent'
+  | 'investigative'
+  | 'analytical'
+  | 'narrative'
+  | 'dispatch';
+
+export type SemanticPlacement =
+  | 'lead'
+  | 'featured'
+  | 'grid'
+  | 'compact'
+  | 'inline';
+
+export type ContentKind = 'article' | 'report' | 'multimedia';
+
+export interface SemanticVisualTokens {
+  domain: SemanticDomain;
+  domainLabel: string;
+  intent: SemanticIntent;
+  intentLabel: string;
+  placement: SemanticPlacement;
+  contentKind: ContentKind;
+  readingDepth: 'quick' | 'standard' | 'deep';
+  readingDepthLabel: string;
+  urgencyScore: number; // 1 - 5
+  // Tailored visual styling tokens
+  containerBorderClass: string;
+  accentBarClass: string;
+  surfaceBgClass: string;
+  badgeBgClass: string;
+  badgeTextClass: string;
+  intentBadgeClass: string;
+  kickerTextClass: string;
+  headlineFontClass: string;
+  headlineHoverClass: string;
+  summaryTextClass: string;
+  metaTextClass: string;
+  calloutBorderClass: string;
+  calloutBgClass: string;
+  calloutTitle: string;
+  calloutDescription: string;
+  metricLabel: string;
+  metricValue: string;
+}
+
+export interface SemanticInput {
+  title?: string;
+  summary?: string;
+  description?: string;
+  category?: string;
+  tags?: string[];
+  readingTime?: number;
+  contentKind?: ContentKind;
+  placement?: SemanticPlacement;
+  overrideDomain?: SemanticDomain;
+  overrideIntent?: SemanticIntent;
+}
+
+const DOMAIN_CATEGORY_MAP: Record<string, SemanticDomain> = {
+  // Civic & Policy
+  politics: 'civic',
+  national: 'civic',
+  economy: 'civic',
+  labor: 'civic',
+  business: 'civic',
+  news: 'civic',
+  'news & politics': 'civic',
+  world: 'civic',
+  'top news': 'civic',
+
+  // Science, Tech & Discovery
+  science: 'discovery',
+  'web development': 'discovery',
+  'science & tech': 'discovery',
+  technology: 'discovery',
+  tech: 'discovery',
+
+  // Arts, Media & Culture
+  culture: 'culture',
+  media: 'culture',
+  'arts & culture': 'culture',
+  arts: 'culture',
+
+  // Sports, Lifestyle & Vitality
+  sports: 'vitality',
+  lifestyle: 'vitality',
+  'urban development': 'vitality',
+  pets: 'vitality',
+  'lifestyle & sports': 'vitality',
+};
+
+const URGENT_KEYWORDS = [
+  'crisis',
+  'strike',
+  'strikes',
+  'ticking time bomb',
+  'decay',
+  'unrest',
+  'existential',
+  'criminal',
+  'killer',
+  'emergency',
+  'breaking',
+];
+
+const ANALYTICAL_KEYWORDS = [
+  'research',
+  'science',
+  'outlook',
+  'analysis',
+  'trends',
+  'review',
+  'data',
+  'alchemy',
+  'architects',
+  'devtools',
+  'forensic',
+  'profiling',
+  'overhaul',
+];
+
+const NARRATIVE_KEYWORDS = [
+  'swan lake',
+  'improv',
+  'indie fest',
+  'charlie',
+  'coastal',
+  'open water',
+  'cyclist',
+  'dreams',
+  'behind the scenes',
+];
+
+export function inferSemanticDomain(category = '', tags: string[] = []): SemanticDomain {
+  const normalized = category.trim().toLowerCase();
+  if (DOMAIN_CATEGORY_MAP[normalized]) {
+    return DOMAIN_CATEGORY_MAP[normalized];
+  }
+
+  for (const tag of tags) {
+    const t = tag.trim().toLowerCase();
+    if (DOMAIN_CATEGORY_MAP[t]) {
+      return DOMAIN_CATEGORY_MAP[t];
+    }
+  }
+
+  if (normalized.includes('politic') || normalized.includes('econ') || normalized.includes('news')) {
+    return 'civic';
+  }
+  if (normalized.includes('sci') || normalized.includes('tech') || normalized.includes('dev')) {
+    return 'discovery';
+  }
+  if (normalized.includes('art') || normalized.includes('cult') || normalized.includes('media')) {
+    return 'culture';
+  }
+  return 'vitality';
+}
+
+export function inferSemanticIntent(input: SemanticInput): SemanticIntent {
+  if (input.overrideIntent) return input.overrideIntent;
+
+  const text = `${input.title || ''} ${input.summary || ''} ${input.description || ''} ${(input.tags || []).join(' ')}`.toLowerCase();
+  const readingTime = input.readingTime ?? 4;
+
+  if (input.contentKind === 'report') {
+    return 'analytical';
+  }
+
+  if (URGENT_KEYWORDS.some((kw) => text.includes(kw))) {
+    if (readingTime >= 6) {
+      return 'investigative';
+    }
+    return 'urgent';
+  }
+
+  if (readingTime >= 6) {
+    return 'investigative';
+  }
+
+  if (ANALYTICAL_KEYWORDS.some((kw) => text.includes(kw))) {
+    return 'analytical';
+  }
+
+  if (NARRATIVE_KEYWORDS.some((kw) => text.includes(kw))) {
+    return 'narrative';
+  }
+
+  return 'dispatch';
+}
+
+export function resolveSemanticProfile(input: SemanticInput): SemanticVisualTokens {
+  const domain = input.overrideDomain ?? inferSemanticDomain(input.category, input.tags);
+  const intent = inferSemanticIntent(input);
+  const placement = input.placement ?? 'grid';
+  const contentKind = input.contentKind ?? 'article';
+  const readingTime = input.readingTime ?? (contentKind === 'report' ? 8 : 4);
+
+  const readingDepth: 'quick' | 'standard' | 'deep' =
+    readingTime <= 3 ? 'quick' : readingTime >= 6 ? 'deep' : 'standard';
+
+  const readingDepthLabel =
+    readingDepth === 'quick'
+      ? 'Quick Read'
+      : readingDepth === 'deep'
+        ? 'Deep Dive'
+        : 'Standard Read';
+
+  const urgencyScore =
+    intent === 'urgent'
+      ? 5
+      : intent === 'investigative'
+        ? 4
+        : intent === 'analytical'
+          ? 3
+          : intent === 'dispatch'
+            ? 3
+            : 2;
+
+  const intentLabels: Record<SemanticIntent, string> = {
+    urgent: 'High-Impact Alert',
+    investigative: 'In-Depth Dossier',
+    analytical: 'Analytical Brief',
+    narrative: 'Feature Essay',
+    dispatch: 'Field Dispatch',
+  };
+
+  const domainProfiles: Record<
+    SemanticDomain,
+    Omit<
+      SemanticVisualTokens,
+      | 'domain'
+      | 'intent'
+      | 'intentLabel'
+      | 'placement'
+      | 'contentKind'
+      | 'readingDepth'
+      | 'readingDepthLabel'
+      | 'urgencyScore'
+      | 'intentBadgeClass'
+    >
+  > = {
+    civic: {
+      domainLabel: 'Civic & Policy',
+      containerBorderClass: 'border-t-4 border-t-rose-800 border-x border-b border-stone-200',
+      accentBarClass: 'bg-rose-800',
+      surfaceBgClass: 'bg-stone-50/70',
+      badgeBgClass: 'bg-rose-900 text-white',
+      badgeTextClass: 'text-rose-900',
+      kickerTextClass: 'text-rose-800 font-serif uppercase tracking-widest',
+      headlineFontClass: 'font-brand tracking-tight text-stone-950',
+      headlineHoverClass: 'group-hover:text-rose-800',
+      summaryTextClass: 'text-stone-700 font-serif leading-relaxed',
+      metaTextClass: 'text-stone-500 font-sans',
+      calloutBorderClass: 'border-l-4 border-rose-800',
+      calloutBgClass: 'bg-rose-50/70 text-stone-900',
+      calloutTitle: 'Civic Impact & Policy Context',
+      calloutDescription:
+        'Visual hierarchy adapts to emphasize public accountability, systemic stakes, and institutional timeline.',
+      metricLabel: 'Public Impact Index',
+      metricValue: intent === 'urgent' ? 'Critical Stakes' : 'Systemic Policy',
+    },
+    discovery: {
+      domainLabel: 'Science & Systems',
+      containerBorderClass: 'border-t-4 border-t-teal-700 border-x border-b border-slate-200',
+      accentBarClass: 'bg-teal-700',
+      surfaceBgClass: 'bg-slate-50/80',
+      badgeBgClass: 'bg-teal-900 text-teal-50',
+      badgeTextClass: 'text-teal-800',
+      kickerTextClass: 'text-teal-700 font-mono uppercase tracking-wider text-xs',
+      headlineFontClass: 'font-sans font-bold tracking-tight text-slate-900',
+      headlineHoverClass: 'group-hover:text-teal-700',
+      summaryTextClass: 'text-slate-600 font-sans leading-relaxed',
+      metaTextClass: 'text-slate-500 font-mono text-xs',
+      calloutBorderClass: 'border-l-4 border-teal-700',
+      calloutBgClass: 'bg-teal-50/60 text-slate-900',
+      calloutTitle: 'Technical & Empirical Synthesis',
+      calloutDescription:
+        'Visual logic switches to structured specification density, monospace telemetry, and empirical methodology cues.',
+      metricLabel: 'Empirical Rigor',
+      metricValue: readingDepth === 'deep' ? 'Peer-Reviewed Depth' : 'Technical Brief',
+    },
+    culture: {
+      domainLabel: 'Arts & Criticism',
+      containerBorderClass: 'border-t-4 border-t-purple-800 border-x border-b border-amber-200/80',
+      accentBarClass: 'bg-purple-800',
+      surfaceBgClass: 'bg-amber-50/35',
+      badgeBgClass: 'bg-purple-900 text-amber-50',
+      badgeTextClass: 'text-purple-900',
+      kickerTextClass: 'text-purple-800 italic font-serif tracking-wide',
+      headlineFontClass: 'font-brand italic text-gray-900',
+      headlineHoverClass: 'group-hover:text-purple-800',
+      summaryTextClass: 'text-gray-700 font-serif leading-relaxed',
+      metaTextClass: 'text-purple-900/60 font-serif italic',
+      calloutBorderClass: 'border-l-4 border-purple-800',
+      calloutBgClass: 'bg-purple-50/50 text-gray-900',
+      calloutTitle: 'Critical Lens & Cultural Curations',
+      calloutDescription:
+        'Editorial presentation shifts toward expressive serif typography, gallery framing, and critical commentary.',
+      metricLabel: 'Editorial Mode',
+      metricValue: 'Curated Critique',
+    },
+    vitality: {
+      domainLabel: 'Pulse & Action',
+      containerBorderClass: 'border-t-4 border-t-emerald-700 border-x border-b border-emerald-100',
+      accentBarClass: 'bg-emerald-700',
+      surfaceBgClass: 'bg-emerald-50/25',
+      badgeBgClass: 'bg-emerald-800 text-white',
+      badgeTextClass: 'text-emerald-800',
+      kickerTextClass: 'text-emerald-700 font-sans font-extrabold uppercase tracking-wider',
+      headlineFontClass: 'font-brand text-gray-900 tracking-normal',
+      headlineHoverClass: 'group-hover:text-emerald-700',
+      summaryTextClass: 'text-gray-600 font-sans leading-snug',
+      metaTextClass: 'text-emerald-800/70 font-semibold',
+      calloutBorderClass: 'border-l-4 border-emerald-600',
+      calloutBgClass: 'bg-emerald-50/60 text-gray-900',
+      calloutTitle: 'Field Tempo & Lifestyle Pulse',
+      calloutDescription:
+        'Component layout prioritizes kinetic momentum, real-time field conditions, and high-scannability indicators.',
+      metricLabel: 'Tempo & Pace',
+      metricValue: readingTime <= 4 ? 'Fast-Paced Dispatch' : 'Endurance Feature',
+    },
+  };
+
+  const intentBadgeMap: Record<SemanticIntent, string> = {
+    urgent: 'bg-red-100 text-red-900 border border-red-300',
+    investigative: 'bg-amber-100 text-amber-900 border border-amber-300',
+    analytical: 'bg-cyan-100 text-cyan-900 border border-cyan-300',
+    narrative: 'bg-purple-100 text-purple-900 border border-purple-300',
+    dispatch: 'bg-emerald-100 text-emerald-900 border border-emerald-300',
+  };
+
+  const baseProfile = domainProfiles[domain];
+
+  return {
+    domain,
+    intent,
+    intentLabel: intentLabels[intent],
+    placement,
+    contentKind,
+    readingDepth,
+    readingDepthLabel,
+    urgencyScore,
+    intentBadgeClass: intentBadgeMap[intent],
+    ...baseProfile,
+  };
+}
