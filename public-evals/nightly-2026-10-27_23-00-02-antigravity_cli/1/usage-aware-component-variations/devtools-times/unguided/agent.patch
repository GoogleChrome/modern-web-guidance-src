@@ -0,0 +1,131 @@
+import React from 'react';
+import {
+  useSemanticContext,
+} from '../context/SemanticContext';
+import type {
+  ContentKind,
+  SemanticDomain,
+  SemanticIntent,
+  SemanticPlacement,
+} from '../utils/semanticContext';
+
+export interface SemanticBadgeProps {
+  category?: string;
+  title?: string;
+  summary?: string;
+  tags?: string[];
+  readingTime?: number;
+  contentKind?: ContentKind;
+  placement?: SemanticPlacement;
+  overrideDomain?: SemanticDomain;
+  overrideIntent?: SemanticIntent;
+  showIntent?: boolean;
+  showDepth?: boolean;
+  href?: string;
+  className?: string;
+}
+
+const DOMAIN_ICONS: Record<SemanticDomain, React.ReactNode> = {
+  civic: (
+    <svg className="w-3.5 h-3.5 mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+      <path strokeLinecap="round" strokeLinejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
+    </svg>
+  ),
+  discovery: (
+    <svg className="w-3.5 h-3.5 mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+      <path strokeLinecap="round" strokeLinejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
+    </svg>
+  ),
+  culture: (
+    <svg className="w-3.5 h-3.5 mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+      <path strokeLinecap="round" strokeLinejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
+    </svg>
+  ),
+  vitality: (
+    <svg className="w-3.5 h-3.5 mr-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+      <path strokeLinecap="round" strokeLinejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
+    </svg>
+  ),
+};
+
+export const SemanticBadge: React.FC<SemanticBadgeProps> = ({
+  category = 'General',
+  title,
+  summary,
+  tags,
+  readingTime,
+  contentKind = 'article',
+  placement = 'grid',
+  overrideDomain,
+  overrideIntent,
+  showIntent = true,
+  showDepth = false,
+  href,
+  className = '',
+}) => {
+  const { context, tokens } = useSemanticContext({
+    category,
+    title,
+    summary,
+    tags,
+    readingTime,
+    contentKind,
+    placement,
+    overrideDomain,
+    overrideIntent,
+  });
+
+  const displayCategory =
+    category.charAt(0).toUpperCase() + category.slice(1);
+
+  const badgeShapeClass =
+    tokens.domain === 'discovery'
+      ? 'rounded-none font-mono tracking-wider uppercase text-[11px] px-2 py-0.5'
+      : tokens.domain === 'culture'
+        ? 'rounded-full font-serif italic text-xs px-2.5 py-0.5'
+        : tokens.domain === 'civic'
+          ? 'rounded-sm font-serif uppercase tracking-widest text-[11px] px-2 py-0.5'
+          : 'rounded-md font-sans font-bold uppercase tracking-wide text-[11px] px-2 py-0.5';
+
+  const categoryNode = (
+    <span
+      className={`inline-flex items-center ${tokens.badgeBgClass} ${badgeShapeClass} transition-opacity hover:opacity-90`}
+    >
+      {DOMAIN_ICONS[tokens.domain]}
+      <span>{displayCategory}</span>
+    </span>
+  );
+
+  return (
+    <div
+      className={`inline-flex flex-wrap items-center gap-1.5 ${className}`}
+      data-semantic-domain={tokens.domain}
+      data-semantic-intent={tokens.intent}
+    >
+      {href ? <a href={href}>{categoryNode}</a> : categoryNode}
+
+      {showIntent && context.showSemanticAnnotations && (
+        <span
+          className={`inline-flex items-center px-2 py-0.5 text-[11px] font-medium ${
+            tokens.domain === 'discovery'
+              ? 'font-mono rounded-none'
+              : 'rounded'
+          } ${tokens.intentBadgeClass}`}
+        >
+          {tokens.intent === 'urgent' && (
+            <span className="w-1.5 h-1.5 rounded-full bg-red-600 mr-1.5 animate-pulse" />
+          )}
+          {tokens.intentLabel}
+        </span>
+      )}
+
+      {showDepth && context.showSemanticAnnotations && (
+        <span className="inline-flex items-center px-1.5 py-0.5 text-[10px] font-medium bg-gray-100 text-gray-700 rounded border border-gray-200">
+          {tokens.readingDepthLabel}
+        </span>
+      )}
+    </div>
+  );
+};
+
+export default SemanticBadge;
