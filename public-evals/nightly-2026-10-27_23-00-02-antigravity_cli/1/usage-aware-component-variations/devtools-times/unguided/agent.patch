@@ -0,0 +1,333 @@
+import React from 'react';
+import { BookOpenIcon } from '@heroicons/react/24/outline';
+import { useSemanticContext } from '../context/SemanticContext';
+import SemanticBadge from './SemanticBadge';
+import BookmarkButton from './BookmarkButton';
+import type {
+  ContentKind,
+  SemanticDomain,
+  SemanticIntent,
+  SemanticPlacement,
+} from '../utils/semanticContext';
+
+export interface SemanticCardItem {
+  id: string;
+  slug?: string;
+  title: string;
+  summary: string;
+  category: string;
+  author?: string;
+  date?: string;
+  imageUrl?: string;
+  readingTime?: number;
+  tags?: string[];
+  href: string;
+  categoryHref?: string;
+  contentKind?: ContentKind;
+  isBookmarked?: boolean;
+}
+
+export interface SemanticCardProps {
+  item: SemanticCardItem;
+  placement?: SemanticPlacement;
+  overrideDomain?: SemanticDomain;
+  overrideIntent?: SemanticIntent;
+  showBookmark?: boolean;
+}
+
+export const SemanticCard: React.FC<SemanticCardProps> = ({
+  item,
+  placement,
+  overrideDomain,
+  overrideIntent,
+  showBookmark = true,
+}) => {
+  const { context, tokens } = useSemanticContext({
+    title: item.title,
+    summary: item.summary,
+    category: item.category,
+    tags: item.tags,
+    readingTime: item.readingTime,
+    contentKind: item.contentKind ?? 'article',
+    placement,
+    overrideDomain,
+    overrideIntent,
+  });
+
+  const effectivePlacement = tokens.placement;
+  const readingTime = item.readingTime ?? (item.contentKind === 'report' ? 8 : 4);
+
+  // 1. COMPACT / WIRE PLACEMENT: High-density ticker/rail layout
+  if (effectivePlacement === 'compact') {
+    return (
+      <article
+        className={`group relative flex items-start justify-between gap-4 p-3.5 transition-colors rounded-xs ${tokens.containerBorderClass} ${tokens.surfaceBgClass} hover:bg-white`}
+        data-semantic-domain={tokens.domain}
+        data-semantic-intent={tokens.intent}
+        data-semantic-placement="compact"
+      >
+        <div className="flex-1 min-w-0">
+          <div className="flex flex-wrap items-center gap-2 mb-1">
+            <SemanticBadge
+              category={item.category}
+              title={item.title}
+              summary={item.summary}
+              tags={item.tags}
+              readingTime={readingTime}
+              contentKind={item.contentKind}
+              placement="compact"
+              overrideDomain={overrideDomain}
+              overrideIntent={overrideIntent}
+              href={item.categoryHref}
+              showIntent={true}
+              showDepth={false}
+            />
+            {item.date && (
+              <span className={`text-[11px] ${tokens.metaTextClass}`}>
+                {item.date}
+              </span>
+            )}
+          </div>
+          <a href={item.href} className="block">
+            <h3
+              className={`text-base font-semibold leading-snug transition-colors ${tokens.headlineFontClass} ${tokens.headlineHoverClass}`}
+            >
+              {item.title}
+            </h3>
+          </a>
+        </div>
+        <div className="flex items-center gap-2 flex-shrink-0 self-center">
+          <span
+            className={`text-xs px-2 py-0.5 rounded border border-black/10 bg-white/80 ${tokens.metaTextClass}`}
+          >
+            {readingTime}m
+          </span>
+          {showBookmark && item.contentKind !== 'report' && item.contentKind !== 'multimedia' && (
+            <BookmarkButton
+              slug={item.id}
+              initialIsBookmarked={Boolean(item.isBookmarked)}
+            />
+          )}
+        </div>
+      </article>
+    );
+  }
+
+  // 2. LEAD / HERO PLACEMENT: Expansive focal layout with contextual telemetry panel
+  if (effectivePlacement === 'lead') {
+    return (
+      <article
+        className={`group relative overflow-hidden rounded-sm shadow-xs transition-all ${tokens.containerBorderClass} ${tokens.surfaceBgClass}`}
+        data-semantic-domain={tokens.domain}
+        data-semantic-intent={tokens.intent}
+        data-semantic-placement="lead"
+      >
+        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 p-5 md:p-7 items-center">
+          <div className="lg:col-span-5 flex flex-col justify-between h-full space-y-4">
+            <div>
+              <SemanticBadge
+                category={item.category}
+                title={item.title}
+                summary={item.summary}
+                tags={item.tags}
+                readingTime={readingTime}
+                contentKind={item.contentKind}
+                placement="lead"
+                overrideDomain={overrideDomain}
+                overrideIntent={overrideIntent}
+                href={item.categoryHref}
+                showIntent={true}
+                showDepth={true}
+                className="mb-3"
+              />
+
+              <a href={item.href} className="block">
+                <h2
+                  className={`text-2xl md:text-4xl leading-tight transition-colors ${tokens.headlineFontClass} ${tokens.headlineHoverClass}`}
+                >
+                  {item.title}
+                </h2>
+                <p className={`mt-3 text-base md:text-lg ${tokens.summaryTextClass}`}>
+                  {item.summary}
+                </p>
+              </a>
+            </div>
+
+            {/* Domain-specific semantic context footer inside lead card */}
+            {context.showSemanticAnnotations && (
+              <div
+                className={`p-3 rounded-xs text-xs ${tokens.calloutBorderClass} bg-white/90`}
+              >
+                <div className="flex items-center justify-between font-semibold text-gray-900">
+                  <span>{tokens.metricLabel}</span>
+                  <span className={tokens.badgeTextClass}>{tokens.metricValue}</span>
+                </div>
+                <p className="text-gray-600 mt-1 text-[11px]">
+                  {tokens.calloutDescription}
+                </p>
+              </div>
+            )}
+
+            <div className="flex items-center justify-between pt-3 border-t border-black/10">
+              <div className={`flex items-center gap-3 text-xs ${tokens.metaTextClass}`}>
+                <span className="inline-flex items-center">
+                  <BookOpenIcon className="w-4 h-4 mr-1" />
+                  {readingTime} Min.
+                </span>
+                {item.author && <span>By {item.author}</span>}
+              </div>
+              {showBookmark && item.contentKind !== 'report' && item.contentKind !== 'multimedia' && (
+                <BookmarkButton
+                  slug={item.id}
+                  initialIsBookmarked={Boolean(item.isBookmarked)}
+                />
+              )}
+            </div>
+          </div>
+
+          <div className="lg:col-span-7">
+            {item.imageUrl ? (
+              <a href={item.href} className="block overflow-hidden rounded-xs relative">
+                <img
+                  src={item.imageUrl}
+                  alt={item.title}
+                  className="w-full h-auto aspect-[16/9] object-cover group-hover:scale-[1.01] transition-transform duration-300"
+                />
+                <div className="absolute bottom-2 right-2 bg-black/75 text-white text-[10px] font-mono uppercase px-2 py-0.5 rounded-xs">
+                  {tokens.domainLabel} • {tokens.intentLabel}
+                </div>
+              </a>
+            ) : (
+              <a
+                href={item.href}
+                className={`flex flex-col justify-center items-center p-8 aspect-[16/9] rounded-xs border border-black/10 ${tokens.calloutBgClass}`}
+              >
+                <span className={`text-xs uppercase tracking-widest ${tokens.kickerTextClass}`}>
+                  {tokens.domainLabel}
+                </span>
+                <span className={`text-2xl mt-2 text-center ${tokens.headlineFontClass}`}>
+                  {item.title}
+                </span>
+              </a>
+            )}
+          </div>
+        </div>
+      </article>
+    );
+  }
+
+  // 3. STANDARD / GRID OR FEATURED PLACEMENT: Domain-specialized card logic
+  return (
+    <article
+      className={`group flex flex-col h-full rounded-sm shadow-xs overflow-hidden transition-all duration-200 hover:shadow-md ${tokens.containerBorderClass} ${tokens.surfaceBgClass}`}
+      data-semantic-domain={tokens.domain}
+      data-semantic-intent={tokens.intent}
+      data-semantic-placement={effectivePlacement}
+    >
+      {/* Discovery domain renders a top technical telemetry bar */}
+      {tokens.domain === 'discovery' && context.showSemanticAnnotations && (
+        <div className="bg-slate-900 text-teal-300 font-mono text-[10px] px-3 py-1 flex items-center justify-between">
+          <span>SPEC // {item.category.toUpperCase()}</span>
+          <span>{tokens.readingDepthLabel.toUpperCase()}</span>
+        </div>
+      )}
+
+      {/* Civic urgent/investigative renders an impact header bar */}
+      {tokens.domain === 'civic' &&
+        (tokens.intent === 'urgent' || tokens.intent === 'investigative') &&
+        context.showSemanticAnnotations && (
+          <div className="bg-rose-900 text-rose-50 text-[10px] font-bold uppercase tracking-widest px-3 py-1 flex items-center justify-between">
+            <span className="flex items-center gap-1.5">
+              <span className="w-1.5 h-1.5 rounded-full bg-rose-300 animate-pulse" />
+              {tokens.intentLabel}
+            </span>
+            <span>Impact {tokens.urgencyScore}/5</span>
+          </div>
+        )}
+
+      {item.imageUrl && (
+        <a href={item.href} className="block relative overflow-hidden">
+          <img
+            src={item.imageUrl}
+            alt={item.title}
+            className="w-full object-cover aspect-[16/9] group-hover:scale-[1.02] transition-transform duration-300"
+          />
+          {tokens.domain === 'vitality' && context.showSemanticAnnotations && (
+            <span className="absolute top-2 right-2 bg-emerald-900/90 text-white text-[10px] font-bold uppercase px-2 py-0.5 rounded">
+              {tokens.metricValue}
+            </span>
+          )}
+        </a>
+      )}
+
+      <div className="p-4 flex flex-col flex-grow">
+        <SemanticBadge
+          category={item.category}
+          title={item.title}
+          summary={item.summary}
+          tags={item.tags}
+          readingTime={readingTime}
+          contentKind={item.contentKind}
+          placement={effectivePlacement}
+          overrideDomain={overrideDomain}
+          overrideIntent={overrideIntent}
+          href={item.categoryHref}
+          showIntent={true}
+          showDepth={effectivePlacement === 'featured'}
+          className="mb-2.5"
+        />
+
+        <a href={item.href} className="flex flex-col flex-grow">
+          <h3
+            className={`text-lg md:text-xl leading-snug transition-colors ${tokens.headlineFontClass} ${tokens.headlineHoverClass}`}
+          >
+            {item.title}
+          </h3>
+
+          {/* Culture domain frames summary as an editorial note */}
+          {tokens.domain === 'culture' ? (
+            <p
+              className={`mt-2 text-sm border-l-2 border-purple-300 pl-3 italic flex-grow ${tokens.summaryTextClass}`}
+            >
+              {item.summary}
+            </p>
+          ) : (
+            <p className={`mt-2 text-sm flex-grow ${tokens.summaryTextClass}`}>
+              {item.summary}
+            </p>
+          )}
+        </a>
+
+        {/* Semantic Context Signal Row */}
+        {context.showSemanticAnnotations && (
+          <div className="mt-3 pt-2 border-t border-black/5 flex items-center justify-between text-[11px]">
+            <span className="text-gray-500">{tokens.metricLabel}:</span>
+            <span className={`font-semibold ${tokens.badgeTextClass}`}>
+              {tokens.metricValue}
+            </span>
+          </div>
+        )}
+
+        <div className="flex justify-between items-center mt-2 pt-2 border-t border-black/10">
+          <span className={`text-xs flex items-center ${tokens.metaTextClass}`}>
+            <BookOpenIcon className="w-4 h-4 inline-block mr-1 -mt-px" />
+            {readingTime} Min.
+            {item.contentKind && item.contentKind !== 'article' && (
+              <span className="ml-2 uppercase text-[10px] px-1.5 py-0.5 rounded bg-black/5">
+                {item.contentKind}
+              </span>
+            )}
+          </span>
+          {showBookmark && item.contentKind !== 'report' && item.contentKind !== 'multimedia' && (
+            <BookmarkButton
+              slug={item.id}
+              initialIsBookmarked={Boolean(item.isBookmarked)}
+            />
+          )}
+        </div>
+      </div>
+    </article>
+  );
+};
+
+export default SemanticCard;
diff --git a/src/components/SemanticSectionExplorer.tsx b/src/components/SemanticSectionExplorer.tsx
new file mode 100644
index 0000000..76b57c9
--- /dev/null
+++ b/src/components/SemanticSectionExplorer.tsx
@@ -0,0 +1,178 @@
+import React from 'react';
+import {
+  SemanticContextProvider,
+  useSemanticContext,
+  type SemanticLensMode,
+} from '../context/SemanticContext';
+import SemanticCard, { type SemanticCardItem } from './SemanticCard';
+import type { ContentKind, SemanticPlacement } from '../utils/semanticContext';
+
+export interface SemanticSectionExplorerProps {
+  title: string;
+  subtitle?: string;
+  items: SemanticCardItem[];
+  defaultLensMode?: SemanticLensMode;
+  defaultPlacement?: SemanticPlacement;
+  defaultContentKind?: ContentKind;
+  showControls?: boolean;
+}
+
+const LENS_OPTIONS: { id: SemanticLensMode; label: string; badgeClass: string }[] = [
+  { id: 'auto', label: 'Auto Semantic Context', badgeClass: 'bg-gray-900 text-white' },
+  { id: 'civic', label: 'Civic & Policy', badgeClass: 'bg-rose-800 text-white' },
+  { id: 'discovery', label: 'Science & Systems', badgeClass: 'bg-teal-800 text-white' },
+  { id: 'culture', label: 'Arts & Criticism', badgeClass: 'bg-purple-800 text-white' },
+  { id: 'vitality', label: 'Pulse & Action', badgeClass: 'bg-emerald-800 text-white' },
+];
+
+const PLACEMENT_OPTIONS: { id: SemanticPlacement; label: string }[] = [
+  { id: 'grid', label: 'Editorial Grid' },
+  { id: 'lead', label: 'Focal Lead + Grid' },
+  { id: 'compact', label: 'High-Density Wire' },
+];
+
+const SemanticSectionInner: React.FC<{
+  title: string;
+  subtitle?: string;
+  items: SemanticCardItem[];
+  showControls: boolean;
+}> = ({ title, subtitle, items, showControls }) => {
+  const { context } = useSemanticContext();
+
+  if (items.length === 0) return null;
+
+  const isLeadMode = context.defaultPlacement === 'lead';
+  const isCompactMode = context.defaultPlacement === 'compact';
+
+  const leadItem = isLeadMode ? items[0] : null;
+  const remainingItems = isLeadMode ? items.slice(1) : items;
+
+  return (
+    <section
+      className="p-4 md:p-6"
+      data-semantic-lens={context.lensMode}
+      data-semantic-placement={context.defaultPlacement}
+    >
+      <div className="border-b-2 border-gray-900 pb-3 mb-6 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
+        <div>
+          <div className="flex items-center gap-2">
+            <h2 className="text-2xl md:text-3xl font-bold text-gray-900">
+              {title}
+            </h2>
+            <span className="text-[11px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-gray-100 text-gray-700 border border-gray-300">
+              Context-Adaptive
+            </span>
+          </div>
+          {subtitle && (
+            <p className="text-sm text-gray-600 mt-1">{subtitle}</p>
+          )}
+        </div>
+
+        {showControls && (
+          <div className="flex flex-wrap items-center gap-3 bg-gray-50 p-2 rounded border border-gray-200 text-xs">
+            <div className="flex flex-wrap items-center gap-1">
+              <span className="text-gray-500 font-semibold mr-1">
+                Semantic Lens:
+              </span>
+              {LENS_OPTIONS.map((opt) => {
+                const active = context.lensMode === opt.id;
+                return (
+                  <button
+                    key={opt.id}
+                    type="button"
+                    onClick={() => context.setLensMode(opt.id)}
+                    className={`px-2 py-1 rounded text-[11px] font-medium transition-colors cursor-pointer ${
+                      active
+                        ? opt.badgeClass
+                        : 'bg-white text-gray-700 hover:bg-gray-200 border border-gray-300'
+                    }`}
+                  >
+                    {opt.label}
+                  </button>
+                );
+              })}
+            </div>
+
+            <div className="h-4 w-px bg-gray-300 hidden sm:block" />
+
+            <div className="flex items-center gap-1">
+              <span className="text-gray-500 font-semibold mr-1">
+                Placement:
+              </span>
+              {PLACEMENT_OPTIONS.map((opt) => {
+                const active = context.defaultPlacement === opt.id;
+                return (
+                  <button
+                    key={opt.id}
+                    type="button"
+                    onClick={() => context.setDefaultPlacement(opt.id)}
+                    className={`px-2 py-1 rounded text-[11px] font-medium transition-colors cursor-pointer ${
+                      active
+                        ? 'bg-amber-500 text-gray-950 font-semibold'
+                        : 'bg-white text-gray-700 hover:bg-gray-200 border border-gray-300'
+                    }`}
+                  >
+                    {opt.label}
+                  </button>
+                );
+              })}
+            </div>
+          </div>
+        )}
+      </div>
+
+      {/* Lead Card when in 'lead' placement context */}
+      {leadItem && (
+        <div className="mb-6">
+          <SemanticCard item={leadItem} placement="lead" />
+        </div>
+      )}
+
+      {/* Remaining items rendered in either compact wire or responsive grid */}
+      {remainingItems.length > 0 && (
+        <div
+          className={
+            isCompactMode
+              ? 'grid grid-cols-1 md:grid-cols-2 gap-3'
+              : 'grid grid-cols-1 md:grid-cols-3 gap-6'
+          }
+        >
+          {remainingItems.map((item) => (
+            <SemanticCard
+              key={item.id}
+              item={item}
+              placement={isCompactMode ? 'compact' : 'grid'}
+            />
+          ))}
+        </div>
+      )}
+    </section>
+  );
+};
+
+export const SemanticSectionExplorer: React.FC<SemanticSectionExplorerProps> = ({
+  title,
+  subtitle,
+  items,
+  defaultLensMode = 'auto',
+  defaultPlacement = 'grid',
+  defaultContentKind = 'article',
+  showControls = true,
+}) => {
+  return (
+    <SemanticContextProvider
+      initialLensMode={defaultLensMode}
+      initialPlacement={defaultPlacement}
+      initialContentKind={defaultContentKind}
+    >
+      <SemanticSectionInner
+        title={title}
+        subtitle={subtitle}
+        items={items}
+        showControls={showControls}
+      />
+    </SemanticContextProvider>
+  );
+};
+
+export default SemanticSectionExplorer;
