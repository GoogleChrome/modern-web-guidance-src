diff --git a/src/context/SemanticContext.tsx b/src/context/SemanticContext.tsx
new file mode 100644
index 0000000..79efb62
--- /dev/null
+++ b/src/context/SemanticContext.tsx
@@ -0,0 +1,134 @@
+import React, { createContext, useContext, useMemo, useState } from 'react';
+import {
+  resolveSemanticProfile,
+  type ContentKind,
+  type SemanticDomain,
+  type SemanticInput,
+  type SemanticIntent,
+  type SemanticPlacement,
+  type SemanticVisualTokens,
+} from '../utils/semanticContext';
+
+export type SemanticLensMode =
+  | 'auto'
+  | 'civic'
+  | 'discovery'
+  | 'culture'
+  | 'vitality';
+
+export interface SemanticContextState {
+  lensMode: SemanticLensMode;
+  setLensMode: (mode: SemanticLensMode) => void;
+  defaultPlacement: SemanticPlacement;
+  setDefaultPlacement: (placement: SemanticPlacement) => void;
+  defaultContentKind: ContentKind;
+  overrideIntent?: SemanticIntent;
+  setOverrideIntent: (intent: SemanticIntent | undefined) => void;
+  showSemanticAnnotations: boolean;
+  setShowSemanticAnnotations: (show: boolean) => void;
+  resolveForItem: (input: SemanticInput) => SemanticVisualTokens;
+}
+
+const SemanticContext = createContext<SemanticContextState | null>(null);
+
+export interface SemanticProviderProps {
+  children: React.ReactNode;
+  initialLensMode?: SemanticLensMode;
+  initialPlacement?: SemanticPlacement;
+  initialContentKind?: ContentKind;
+  initialIntent?: SemanticIntent;
+  initialAnnotations?: boolean;
+}
+
+export const SemanticContextProvider: React.FC<SemanticProviderProps> = ({
+  children,
+  initialLensMode = 'auto',
+  initialPlacement = 'grid',
+  initialContentKind = 'article',
+  initialIntent,
+  initialAnnotations = true,
+}) => {
+  const [lensMode, setLensMode] = useState<SemanticLensMode>(initialLensMode);
+  const [defaultPlacement, setDefaultPlacement] =
+    useState<SemanticPlacement>(initialPlacement);
+  const [overrideIntent, setOverrideIntent] = useState<
+    SemanticIntent | undefined
+  >(initialIntent);
+  const [showSemanticAnnotations, setShowSemanticAnnotations] =
+    useState<boolean>(initialAnnotations);
+
+  const value = useMemo<SemanticContextState>(() => {
+    const resolveForItem = (input: SemanticInput): SemanticVisualTokens => {
+      const effectiveDomain: SemanticDomain | undefined =
+        input.overrideDomain ??
+        (lensMode !== 'auto' ? lensMode : undefined);
+
+      return resolveSemanticProfile({
+        ...input,
+        contentKind: input.contentKind ?? initialContentKind,
+        placement: input.placement ?? defaultPlacement,
+        overrideDomain: effectiveDomain,
+        overrideIntent: input.overrideIntent ?? overrideIntent,
+      });
+    };
+
+    return {
+      lensMode,
+      setLensMode,
+      defaultPlacement,
+      setDefaultPlacement,
+      defaultContentKind: initialContentKind,
+      overrideIntent,
+      setOverrideIntent,
+      showSemanticAnnotations,
+      setShowSemanticAnnotations,
+      resolveForItem,
+    };
+  }, [
+    lensMode,
+    defaultPlacement,
+    initialContentKind,
+    overrideIntent,
+    showSemanticAnnotations,
+  ]);
+
+  return (
+    <SemanticContext.Provider value={value}>
+      {children}
+    </SemanticContext.Provider>
+  );
+};
+
+export function useSemanticContext(itemInput?: SemanticInput): {
+  context: SemanticContextState;
+  tokens: SemanticVisualTokens;
+} {
+  const ctx = useContext(SemanticContext);
+
+  const fallbackContext = useMemo<SemanticContextState>(() => {
+    return {
+      lensMode: 'auto',
+      setLensMode: () => {},
+      defaultPlacement: itemInput?.placement ?? 'grid',
+      setDefaultPlacement: () => {},
+      defaultContentKind: itemInput?.contentKind ?? 'article',
+      overrideIntent: itemInput?.overrideIntent,
+      setOverrideIntent: () => {},
+      showSemanticAnnotations: true,
+      setShowSemanticAnnotations: () => {},
+      resolveForItem: (input: SemanticInput) => resolveSemanticProfile(input),
+    };
+  }, [
+    itemInput?.placement,
+    itemInput?.contentKind,
+    itemInput?.overrideIntent,
+  ]);
+
+  const activeContext = ctx ?? fallbackContext;
+  const tokens = activeContext.resolveForItem(itemInput ?? {});
+
+  return {
+    context: activeContext,
+    tokens,
+  };
+}
