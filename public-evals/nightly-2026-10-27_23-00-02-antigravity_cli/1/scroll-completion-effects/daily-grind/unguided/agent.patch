+  <script>
+    (function () {
+      let activeCleanup = null;
+      let clearEffectTimer = null;
+
+      function clearPreviousEffects() {
+        if (clearEffectTimer) {
+          clearTimeout(clearEffectTimer);
+          clearEffectTimer = null;
+        }
+        document.querySelectorAll('.scroll-target-active').forEach((el) => {
+          el.classList.remove('scroll-target-active');
+          el.removeAttribute('data-scroll-arrived');
+        });
+      }
+
+      function applyPostScrollEffects(target, triggerLink) {
+        clearPreviousEffects();
+
+        // Update active state on navigation links
+        document.querySelectorAll('nav a').forEach((link) => {
+          const isMatch = link === triggerLink || link.getAttribute('href') === '#' + target.id;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        // Ensure target can receive focus without causing an extra scroll jump
+        if (!target.hasAttribute('tabindex')) {
+          target.setAttribute('tabindex', '-1');
+        }
+        target.focus({ preventScroll: true });
+
+        // Trigger visual highlight and CSS animation only after scroll has finished
+        void target.offsetWidth; // Force reflow so repeated clicks re-trigger animation
+        target.classList.add('scroll-target-active');
+        target.setAttribute('data-scroll-arrived', 'true');
+
+        // Update URL hash cleanly after arrival
+        if (target.id && history.replaceState) {
+          history.replaceState(null, '', '#' + target.id);
+        }
+
+        clearEffectTimer = setTimeout(() => {
+          target.classList.remove('scroll-target-active');
+        }, 2500);
+      }
+
+      function scrollToTarget(target, triggerLink) {
+        if (activeCleanup) {
+          activeCleanup();
+          activeCleanup = null;
+        }
+
+        // Remove any existing visual effects before starting the smooth scroll
+        clearPreviousEffects();
+        document.body.setAttribute('data-scrolling', 'true');
+
+        const nav = document.querySelector('nav');
+        const navOffset = (nav ? nav.offsetHeight : 72) + 20;
+        const targetRect = target.getBoundingClientRect();
+        const desiredTop = Math.max(
+          0,
+          Math.min(
+            window.scrollY + targetRect.top - navOffset,
+            document.documentElement.scrollHeight - window.innerHeight
+          )
+        );
+
+        const distance = Math.abs(window.scrollY - desiredTop);
+        const prefersReducedMotion =
+          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+        // If already at the target scroll position (or reduced motion is enabled), finish immediately
+        if (distance < 2 || prefersReducedMotion) {
+          if (distance >= 2) {
+            window.scrollTo({ top: desiredTop, behavior: 'auto' });
+          }
+          document.body.removeAttribute('data-scrolling');
+          applyPostScrollEffects(target, triggerLink);
+          return;
+        }
+
+        let finished = false;
+        let idleTimer = null;
+        let maxSafetyTimer = null;
+
+        function finishScroll() {
+          if (finished) return;
+          finished = true;
+          cleanupListeners();
+          document.body.removeAttribute('data-scrolling');
+          applyPostScrollEffects(target, triggerLink);
+        }
+
+        function onScroll() {
+          if (idleTimer) clearTimeout(idleTimer);
+          const remaining = Math.abs(window.scrollY - desiredTop);
+          // When close to the destination or when scroll events settle, complete
+          const debounceMs = remaining <= 4 ? 50 : 140;
+          idleTimer = setTimeout(finishScroll, debounceMs);
+        }
+
+        function onScrollEnd() {
+          finishScroll();
+        }
+
+        function cleanupListeners() {
+          window.removeEventListener('scroll', onScroll, { passive: true });
+          window.removeEventListener('scrollend', onScrollEnd);
+          document.removeEventListener('scrollend', onScrollEnd);
+          if (idleTimer) clearTimeout(idleTimer);
+          if (maxSafetyTimer) clearTimeout(maxSafetyTimer);
+          activeCleanup = null;
+        }
+
+        activeCleanup = cleanupListeners;
+
+        window.addEventListener('scroll', onScroll, { passive: true });
+        window.addEventListener('scrollend', onScrollEnd, { once: true });
+        document.addEventListener('scrollend', onScrollEnd, { once: true });
+
+        // Safety fallback in case scroll events don't fire in a restricted environment
+        maxSafetyTimer = setTimeout(finishScroll, 1200);
+
+        window.scrollTo({
+          top: desiredTop,
+          behavior: 'smooth'
+        });
+      }
+
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[href^="#"]');
+        if (!link) return;
+
+        const hash = link.getAttribute('href');
+        if (!hash || hash === '#') return;
+
+        const targetId = decodeURIComponent(hash.slice(1));
+        const target = document.getElementById(targetId);
+        if (!target) return;
+
+        event.preventDefault();
+        scrollToTarget(target, link);
+      });
+    })();
+  </script>
