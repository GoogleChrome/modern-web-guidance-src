+    <section class="journal-section" id="roasters-journal" aria-labelledby="journal-heading">
+      <div class="journal-header">
+        <div>
+          <h2 id="journal-heading">Roaster's Journal</h2>
+          <p class="journal-subtitle">From High-Altitude Harvests to Your Morning Cup: How We Source Our Beans</p>
+        </div>
+        <button type="button" id="summarize-btn" class="btn summarize-btn">
+          ✨ Summarize
