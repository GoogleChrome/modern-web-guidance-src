+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const journalContent = document.getElementById('journal-content');
+    const summaryBox = document.getElementById('journal-summary-box');
+    const summaryStatus = document.getElementById('journal-summary-status');
+    const summaryList = document.getElementById('journal-summary-list');
+
+    function renderBulletPoints(summaryText) {
+      summaryList.innerHTML = '';
+      const lines = summaryText
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^[\s*\-•\d.)]+/, '').trim())
+        .filter(Boolean);
+
+      const items = lines.length > 0 ? lines : [summaryText.trim()].filter(Boolean);
+      for (const item of items) {
+        const li = document.createElement('li');
+        li.textContent = item;
+        summaryList.appendChild(li);
+      }
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      const textToSummarize = journalContent.innerText.trim();
+      summaryBox.classList.add('visible');
+      summaryList.innerHTML = '';
+      summaryStatus.style.display = 'block';
+      summaryStatus.textContent = 'Checking browser AI availability...';
+      summarizeBtn.disabled = true;
+
+      let summarizer;
+      try {
+        const options = {
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          sharedContext: 'An article from a specialty coffee roaster explaining their ethical bean sourcing and processing practices.',
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (typeof e.loaded === 'number') {
+                const pct = Math.round(e.loaded * 100);
+                summaryStatus.textContent = `Downloading browser AI model (${pct}%)...`;
+              }
+            });
+          }
+        };
+
+        if ('Summarizer' in self) {
+          const availability = await self.Summarizer.availability();
+          if (availability === 'unavailable') {
+            throw new Error('The Built-in AI Summarizer API is unavailable on this device or browser.');
+          }
+          summaryStatus.textContent = availability === 'available'
+            ? 'Summarizing with browser AI...'
+            : 'Preparing browser AI model...';
+          summarizer = await self.Summarizer.create(options);
+        } else if (self.ai && self.ai.summarizer) {
+          const capabilities = await self.ai.summarizer.capabilities();
+          if (!capabilities || capabilities.available === 'no') {
+            throw new Error('The Built-in AI Summarizer API is unavailable on this device or browser.');
+          }
+          summaryStatus.textContent = 'Summarizing with browser AI...';
+          summarizer = await self.ai.summarizer.create(options);
+        } else {
+          throw new Error('Your browser does not support the native AI Summarizer API.');
+        }
+
+        summaryStatus.textContent = 'Generating bullet points...';
+        const result = await summarizer.summarize(textToSummarize);
+
+        summaryStatus.style.display = 'none';
+        renderBulletPoints(result);
+      } catch (err) {
+        summaryStatus.style.display = 'block';
+        summaryStatus.textContent = err.message || 'Unable to generate summary with browser AI.';
+      } finally {
+        if (summarizer && typeof summarizer.destroy === 'function') {
+          summarizer.destroy();
+        }
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
+
 </body>
 
