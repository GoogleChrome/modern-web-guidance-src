+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryStatus = document.getElementById('summary-status');
+    const summaryContainer = document.getElementById('summary-container');
+    const summaryList = document.getElementById('summary-list');
+    const journalArticle = document.getElementById('journal-article');
+
+    const summarizerOptions = {
+      sharedContext: 'An article from a specialty coffee roaster explaining their ethical bean sourcing, harvesting, and processing practices.',
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+    };
+
+    function renderBullets(summaryText) {
+      summaryList.replaceChildren();
+      const lines = summaryText
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, '').trim())
+        .filter(Boolean);
+
+      for (const line of lines) {
+        const li = document.createElement('li');
+        li.textContent = line;
+        summaryList.appendChild(li);
+      }
+
+      summaryContainer.hidden = lines.length === 0;
+    }
+
+    async function checkSummarizerSupport() {
+      if (!('Summarizer' in self)) {
+        summarizeBtn.disabled = true;
+        summaryStatus.textContent = 'Local summarization is currently unsupported in this browser.';
+        return;
+      }
+
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          summarizeBtn.disabled = true;
+          summaryStatus.textContent = 'Local summarization is currently unavailable on this device.';
+        }
+      } catch (err) {
+        summarizeBtn.disabled = true;
+        summaryStatus.textContent = 'Local summarization is currently unavailable in this browser.';
+      }
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      if (!('Summarizer' in self)) {
+        summarizeBtn.disabled = true;
+        summaryStatus.textContent = 'Local summarization is currently unsupported in this browser.';
+        return;
+      }
+
+      summarizeBtn.disabled = true;
+      summaryStatus.textContent = 'Checking AI model availability...';
+
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          summaryStatus.textContent = 'Local summarization is currently unavailable on this device.';
+          return;
+        }
+
+        const summarizer = await Summarizer.create({
+          ...summarizerOptions,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (e.total) {
+                const pct = Math.round((e.loaded / e.total) * 100);
+                summaryStatus.textContent = `Downloading on-device AI model (${pct}%)...`;
+              } else {
+                summaryStatus.textContent = 'Downloading on-device AI model...';
+              }
+            });
+          },
+        });
+
+        summaryStatus.textContent = 'Generating summary...';
+        const summary = await summarizer.summarize(journalArticle.innerText, {
+          context: 'Summarize the coffee bean sourcing process into concise bullet points for customers.',
+        });
+
+        renderBullets(summary);
+        summaryStatus.textContent = '';
+        summarizeBtn.textContent = 'Summarized';
+      } catch (error) {
+        summaryStatus.textContent = `Unable to generate summary: ${error.message || 'Unknown error'}`;
+        summarizeBtn.disabled = false;
+      }
+    });
+
+    checkSummarizerSupport();
+  </script>
+
