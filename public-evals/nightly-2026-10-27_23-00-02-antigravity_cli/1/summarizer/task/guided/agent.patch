+    <section class="journal-section" aria-labelledby="journal-heading">
+      <div class="journal-header">
+        <div>
+          <h2 id="journal-heading">Roaster's Journal: From High-Altitude Farms to Your Cup</h2>
+          <p class="journal-meta">Field notes on our direct-trade bean sourcing process</p>
+        </div>
+        <div class="journal-actions">
+          <button type="button" id="summarize-btn" class="btn">Summarize</button>
