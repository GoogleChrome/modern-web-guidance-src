+  <script>
+    const BEAN_CATALOG = [
+      {
+        id: 'ethiopian-yirgacheffe',
+        name: 'Ethiopian Yirgacheffe',
+        roast: 'Light Roast',
+        notes: 'Bright bergamot, jasmine blossom, and sweet Meyer lemon.',
+        image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80',
+        alt: 'Light roasted Ethiopian Yirgacheffe coffee beans in a burlap sack'
+      },
+      {
+        id: 'colombian-supremo',
+        name: 'Colombian Supremo',
+        roast: 'Medium Roast',
+        notes: 'Rich caramel sweetness, toasted walnut, and a balanced citrus finish.',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80',
+        alt: 'Freshly roasted Colombian Supremo coffee beans close up'
+      },
+      {
+        id: 'sumatra-mandheling',
+        name: 'Sumatra Mandheling',
+        roast: 'Dark Roast',
+        notes: 'Full-bodied and earthy with notes of dark chocolate and cedar spice.',
+        image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80',
+        alt: 'Dark glossy Sumatra Mandheling coffee beans'
+      },
+      {
+        id: 'guatemala-antigua',
+        name: 'Guatemala Antigua',
+        roast: 'Medium Roast',
+        notes: 'Velvety cocoa, warm baking spices, and subtle brown sugar.',
+        image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80',
+        alt: 'Roasted Guatemala Antigua coffee beans scattered on a wooden table'
+      },
+      {
+        id: 'kenya-aa',
+        name: 'Kenya AA',
+        roast: 'Medium-Light',
+        notes: 'Vibrant blackcurrant, ruby grapefruit, and a crisp wine-like acidity.',
+        image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80',
+        alt: 'Aromatic Kenya AA coffee beans ready for grinding'
+      },
+      {
+        id: 'brazil-santos',
+        name: 'Brazil Cerrado Santos',
+        roast: 'Medium-Dark',
+        notes: 'Creamy hazelnut, milk chocolate, and low acidity for smooth espresso.',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80',
+        alt: 'Dark roasted Brazil Cerrado Santos beans alongside a cup of coffee'
+      }
+    ];
+
+    const INITIAL_IDS = [
+      'ethiopian-yirgacheffe',
+      'colombian-supremo',
+      'sumatra-mandheling',
+      'guatemala-antigua'
+    ];
+
+    let selectedBeans = BEAN_CATALOG.filter((bean) => INITIAL_IDS.includes(bean.id));
+
+    const beanListEl = document.getElementById('bean-list');
+    const emptyStateEl = document.getElementById('bean-empty-state');
+    const catalogSelectEl = document.getElementById('bean-catalog-select');
+    const addBeanBtn = document.getElementById('add-bean-btn');
+    const addRandomBtn = document.getElementById('add-random-btn');
+    const resetBeansBtn = document.getElementById('reset-beans-btn');
+    const liveStatusEl = document.getElementById('bean-live-status');
+    const sectionHeadingEl = document.getElementById('bean-selection-heading');
+
+    function announceStatus(message) {
+      if (liveStatusEl) {
+        liveStatusEl.textContent = message;
+      }
+    }
+
+    function updateControls() {
+      const selectedIds = new Set(selectedBeans.map((b) => b.id));
+      const availableBeans = BEAN_CATALOG.filter((b) => !selectedIds.has(b.id));
+
+      const previousValue = catalogSelectEl.value;
+      catalogSelectEl.replaceChildren();
+
+      if (availableBeans.length === 0) {
+        const option = document.createElement('option');
+        option.value = '';
+        option.textContent = 'All roasts added to your box';
+        catalogSelectEl.appendChild(option);
+        catalogSelectEl.disabled = true;
+        addBeanBtn.disabled = true;
+        addRandomBtn.disabled = true;
+      } else {
+        availableBeans.forEach((bean) => {
+          const option = document.createElement('option');
+          option.value = bean.id;
+          option.textContent = `${bean.name} (${bean.roast})`;
+          catalogSelectEl.appendChild(option);
+        });
+        if (availableBeans.some((b) => b.id === previousValue)) {
+          catalogSelectEl.value = previousValue;
+        }
+        catalogSelectEl.disabled = false;
+        addBeanBtn.disabled = false;
+        addRandomBtn.disabled = false;
+      }
+    }
+
+    function createBeanElement(bean) {
+      const li = document.createElement('li');
+      li.className = 'bean-item';
+      li.dataset.beanId = bean.id;
+      // Mandatory: Each element must have a unique view-transition-name
+      li.style.viewTransitionName = `bean-${bean.id}`;
+
+      const img = document.createElement('img');
+      img.src = bean.image;
+      img.alt = bean.alt;
+      img.width = 400;
+      img.height = 260;
+      img.loading = 'lazy';
+
+      const body = document.createElement('div');
+      body.className = 'bean-item-body';
+
+      const badge = document.createElement('span');
+      badge.className = 'bean-badge';
+      badge.textContent = bean.roast;
+
+      const title = document.createElement('h3');
+      title.textContent = bean.name;
+
+      const notes = document.createElement('p');
+      notes.className = 'bean-notes';
+      notes.textContent = bean.notes;
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.className = 'bean-btn remove-btn';
+      removeBtn.dataset.action = 'remove';
+      removeBtn.dataset.beanId = bean.id;
+      removeBtn.setAttribute('aria-label', `Remove ${bean.name} from box`);
+      removeBtn.textContent = 'Remove';
+
+      body.append(badge, title, notes, removeBtn);
+      li.append(img, body);
+      return li;
+    }
+
+    function renderBeanList() {
+      beanListEl.replaceChildren(...selectedBeans.map(createBeanElement));
+      emptyStateEl.hidden = selectedBeans.length > 0;
+      updateControls();
+    }
+
+    function performTransitionUpdate(updateFn, focusTargetCallback) {
+      if (document.startViewTransition) {
+        const transition = document.startViewTransition(() => {
+          updateFn();
+          renderBeanList();
+        });
+        if (focusTargetCallback) {
+          transition.finished.finally(() => {
+            focusTargetCallback();
+          });
+        }
+      } else {
+        // Fallback: Perform the update without animation
+        updateFn();
+        renderBeanList();
+        if (focusTargetCallback) {
+          focusTargetCallback();
+        }
+      }
+    }
+
+    function addBeanById(beanId) {
+      const beanToAdd = BEAN_CATALOG.find((b) => b.id === beanId);
+      if (!beanToAdd || selectedBeans.some((b) => b.id === beanId)) return;
+
+      performTransitionUpdate(() => {
+        selectedBeans.push(beanToAdd);
+      });
+      announceStatus(`Added ${beanToAdd.name} to your custom roast box.`);
+    }
+
+    function removeBeanById(beanId, removedIndex) {
+      const beanToRemove = selectedBeans.find((b) => b.id === beanId);
+      if (!beanToRemove) return;
+
+      performTransitionUpdate(
+        () => {
+          selectedBeans = selectedBeans.filter((b) => b.id !== beanId);
+        },
+        () => {
+          // Route focus to the next available remove button or the section heading if empty
+          const remainingRemoveButtons = beanListEl.querySelectorAll('button[data-action="remove"]');
+          if (remainingRemoveButtons.length > 0) {
+            const nextFocusIndex = Math.min(removedIndex, remainingRemoveButtons.length - 1);
+            remainingRemoveButtons[nextFocusIndex]?.focus();
+          } else {
+            sectionHeadingEl?.focus();
+          }
+        }
+      );
+      announceStatus(`Removed ${beanToRemove.name} from your custom roast box.`);
+    }
+
+    addBeanBtn.addEventListener('click', () => {
+      const selectedId = catalogSelectEl.value;
+      if (selectedId) {
+        addBeanById(selectedId);
+      }
+    });
+
+    addRandomBtn.addEventListener('click', () => {
+      const selectedIds = new Set(selectedBeans.map((b) => b.id));
+      const availableBeans = BEAN_CATALOG.filter((b) => !selectedIds.has(b.id));
+      if (availableBeans.length > 0) {
+        const randomBean = availableBeans[Math.floor(Math.random() * availableBeans.length)];
+        addBeanById(randomBean.id);
+      }
+    });
+
+    resetBeansBtn.addEventListener('click', () => {
+      performTransitionUpdate(() => {
+        selectedBeans = BEAN_CATALOG.filter((bean) => INITIAL_IDS.includes(bean.id));
+      });
+      announceStatus('Reset custom roast box to default selection.');
+    });
+
+    beanListEl.addEventListener('click', (event) => {
+      const removeButton = event.target.closest('button[data-action="remove"]');
+      if (!removeButton) return;
+      const beanId = removeButton.dataset.beanId;
+      const currentItems = Array.from(beanListEl.querySelectorAll('.bean-item'));
+      const removedIndex = currentItems.findIndex((item) => item.dataset.beanId === beanId);
+      removeBeanById(beanId, Math.max(0, removedIndex));
+    });
+
+    renderBeanList();
+  </script>
+
