+  <script>
+    (function () {
+      const BEAN_CATALOG = [
+        {
+          id: 'ethiopian-yirgacheffe',
+          name: 'Ethiopian Yirgacheffe',
+          roast: 'Light Roast',
+          origin: 'Ethiopia',
+          description: 'Bright floral aroma with vibrant notes of bergamot, jasmine, and Meyer lemon.',
+          image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'colombian-supremo',
+          name: 'Colombian Supremo',
+          roast: 'Medium Roast',
+          origin: 'Colombia',
+          description: 'Velvety body balanced with rich caramel sweetness and a toasted walnut finish.',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'sumatra-mandheling',
+          name: 'Sumatra Mandheling',
+          roast: 'Dark Roast',
+          origin: 'Indonesia',
+          description: 'Full-bodied and earthy with dark chocolate depth, cedar spice, and low acidity.',
+          image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'kenyan-aa',
+          name: 'Kenyan AA',
+          roast: 'Medium-Light',
+          origin: 'Kenya',
+          description: 'Juicy blackcurrant and grapefruit notes paired with a crisp, wine-like finish.',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'guatemalan-antigua',
+          name: 'Guatemalan Antigua',
+          roast: 'Medium Roast',
+          origin: 'Guatemala',
+          description: 'Velvety cocoa notes layered with warm baking spices and subtle orange zest.',
+          image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'costa-rican-tarrazu',
+          name: 'Costa Rican Tarrazu',
+          roast: 'Light-Medium',
+          origin: 'Costa Rica',
+          description: 'Clean honeyed sweetness with crisp green apple acidity and brown sugar.',
+          image: 'https://images.unsplash.com/photo-1498804103079-a6351b050096?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'brazilian-santos',
+          name: 'Brazilian Santos',
+          roast: 'Medium-Dark',
+          origin: 'Brazil',
+          description: 'Smooth nutty profile featuring roasted hazelnut, milk chocolate, and mild crema.',
+          image: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'jamaican-blue',
+          name: 'Jamaican Blue Mountain',
+          roast: 'Medium Roast',
+          origin: 'Jamaica',
+          description: 'Silky, sweet, and remarkably smooth with delicate herbal and floral undertones.',
+          image: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=600&q=80'
+        }
+      ];
+
+      const grid = document.getElementById('bean-selection-grid');
+      const select = document.getElementById('bean-variety-select');
+      const addBtn = document.getElementById('add-bean-btn');
+      let customCounter = 1;
+
+      function runWithViewTransition(updateFn) {
+        if (typeof document.startViewTransition === 'function') {
+          document.startViewTransition(() => {
+            updateFn();
+          });
+        } else {
+          updateFn();
+        }
+      }
+
+      function getActiveIds() {
+        return Array.from(grid.querySelectorAll('.bean-card')).map(
+          (card) => card.getAttribute('data-bean-id')
+        );
+      }
+
+      function syncSelectOptions() {
+        const activeIds = new Set(getActiveIds());
+        const available = BEAN_CATALOG.filter((bean) => !activeIds.has(bean.id));
+        select.innerHTML = '';
+
+        if (available.length > 0) {
+          available.forEach((bean) => {
+            const opt = document.createElement('option');
+            opt.value = bean.id;
+            opt.textContent = `${bean.name} (${bean.roast})`;
+            select.appendChild(opt);
+          });
+        } else {
+          BEAN_CATALOG.forEach((bean) => {
+            const opt = document.createElement('option');
+            opt.value = bean.id;
+            opt.textContent = `${bean.name} (${bean.roast})`;
+            select.appendChild(opt);
+          });
+        }
+
+        const emptyMsg = grid.querySelector('.bean-empty-state');
+        if (activeIds.size === 0 && !emptyMsg) {
+          const empty = document.createElement('div');
+          empty.className = 'bean-empty-state';
+          empty.textContent = 'No coffee beans selected yet. Use "+ Add Bean" to build your lineup.';
+          grid.appendChild(empty);
+        } else if (activeIds.size > 0 && emptyMsg) {
+          emptyMsg.remove();
+        }
+      }
+
+      function createBeanCard(bean, uniqueId) {
+        const article = document.createElement('article');
+        article.className = 'bean-card';
+        article.setAttribute('data-bean-id', uniqueId);
+        article.style.viewTransitionName = `bean-${uniqueId}`;
+
+        article.innerHTML = `
+          <img class="bean-card-img" src="${bean.image}" alt="${bean.name} coffee beans">
+          <div class="bean-card-body">
+            <span class="bean-roast-badge">${bean.roast}</span>
+            <h3>${bean.name}</h3>
+            <p>${bean.description}</p>
+            <div class="bean-card-footer">
+              <span class="bean-origin">Origin: ${bean.origin}</span>
+              <button type="button" class="btn-remove-bean" data-remove-bean="${uniqueId}" aria-label="Remove ${bean.name}">Remove</button>
+            </div>
+          </div>
+        `;
+        return article;
+      }
+
+      addBtn.addEventListener('click', () => {
+        const selectedId = select.value;
+        const activeIds = new Set(getActiveIds());
+        let baseBean = BEAN_CATALOG.find((b) => b.id === selectedId) || BEAN_CATALOG[0];
+        let uniqueId = baseBean.id;
+
+        if (activeIds.has(uniqueId)) {
+          const nextAvailable = BEAN_CATALOG.find((b) => !activeIds.has(b.id));
+          if (nextAvailable) {
+            baseBean = nextAvailable;
+            uniqueId = nextAvailable.id;
+          } else {
+            customCounter += 1;
+            uniqueId = `${baseBean.id}-${customCounter}`;
+          }
+        }
+
+        runWithViewTransition(() => {
+          const emptyMsg = grid.querySelector('.bean-empty-state');
+          if (emptyMsg) {
+            emptyMsg.remove();
+          }
+          const card = createBeanCard(baseBean, uniqueId);
+          grid.appendChild(card);
+          syncSelectOptions();
+        });
+      });
+
+      grid.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.btn-remove-bean');
+        if (!removeBtn) return;
+
+        const card = removeBtn.closest('.bean-card');
+        if (!card) return;
+
+        runWithViewTransition(() => {
+          card.remove();
+          syncSelectOptions();
+        });
+      });
+    })();
+  </script>
 </body>
 
