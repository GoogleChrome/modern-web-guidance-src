+  <script>
+    (function () {
+      const form = document.getElementById('order-form');
+      const shopSelect = document.getElementById('local-shop');
+      const shopError = document.getElementById('local-shop-error');
+      const orderSuccess = document.getElementById('order-success');
+
+      if (!form || !shopSelect || !shopError) return;
+
+      let hasInteracted = false;
+
+      function updateValidationState() {
+        if (!hasInteracted && !form.classList.contains('submitted')) {
+          shopSelect.removeAttribute('aria-invalid');
+          shopError.classList.remove('visible');
+          return true;
+        }
+
+        const isValid = shopSelect.checkValidity();
+        if (!isValid) {
+          shopSelect.setAttribute('aria-invalid', 'true');
+          shopError.classList.add('visible');
+        } else {
+          shopSelect.setAttribute('aria-invalid', 'false');
+          shopError.classList.remove('visible');
+        }
+        return isValid;
+      }
+
+      // Mark as interacted when user changes the value or leaves the select menu after focusing
+      shopSelect.addEventListener('change', function () {
+        hasInteracted = true;
+        shopSelect.classList.add('touched');
+        if (orderSuccess) {
+          orderSuccess.classList.remove('visible');
+        }
+        updateValidationState();
+      });
+
+      shopSelect.addEventListener('blur', function () {
+        hasInteracted = true;
+        shopSelect.classList.add('touched');
+        updateValidationState();
+      });
+
+      // Also listen for native invalid event (e.g., if checkValidity/reportValidity is triggered)
+      shopSelect.addEventListener('invalid', function (e) {
+        e.preventDefault();
+        hasInteracted = true;
+        shopSelect.classList.add('touched');
+        updateValidationState();
+      });
+
+      form.addEventListener('submit', function (e) {
+        hasInteracted = true;
+        form.classList.add('submitted');
+        shopSelect.classList.add('touched');
+
+        const isValid = updateValidationState();
+        if (!isValid) {
+          e.preventDefault();
+          shopSelect.focus();
+          return;
+        }
+
+        e.preventDefault();
+        if (orderSuccess) {
+          const selectedOption = shopSelect.options[shopSelect.selectedIndex];
+          orderSuccess.textContent = 'Order started for ' + selectedOption.text + '!';
+          orderSuccess.classList.add('visible');
+        }
+      });
+    })();
+  </script>
