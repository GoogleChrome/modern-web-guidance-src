+  <script>
+    (function () {
+      const STORAGE_TIME_KEY = 'dailyPickupReminderTime';
+      const STORAGE_DATE_KEY = 'coffeeAnniversaryDate';
+
+      const form = document.getElementById('preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const displayTime = document.getElementById('display-reminder-time');
+      const displayDate = document.getElementById('display-anniversary-date');
+
+      // Store and format as timezone-agnostic plain strings (HH:mm and YYYY-MM-DD)
+      // or via Temporal.PlainTime / Temporal.PlainDate without UTC Date conversion
+      function normalizePlainTime(rawTime) {
+        if (!rawTime) return '';
+        const match = String(rawTime).trim().match(/^(\d{2}):(\d{2})/);
+        if (!match) return String(rawTime).trim();
+        return `${match[1]}:${match[2]}`;
+      }
+
+      function normalizePlainDate(rawDate) {
+        if (!rawDate) return '';
+        const match = String(rawDate).trim().match(/^(\d{4})-(\d{2})-(\d{2})$/);
+        if (!match) return String(rawDate).trim();
+        return `${match[1]}-${match[2]}-${match[3]}`;
+      }
+
+      function renderPreferences(plainTime, plainDate) {
+        if (plainTime) {
+          timeInput.value = plainTime;
+          displayTime.textContent = plainTime;
+        }
+        if (plainDate) {
+          dateInput.value = plainDate;
+          displayDate.textContent = plainDate;
+        }
+      }
+
+      const savedTime = localStorage.getItem(STORAGE_TIME_KEY);
+      const savedDate = localStorage.getItem(STORAGE_DATE_KEY);
+
+      renderPreferences(
+        savedTime ? normalizePlainTime(savedTime) : normalizePlainTime(timeInput.value),
+        savedDate ? normalizePlainDate(savedDate) : normalizePlainDate(dateInput.value)
+      );
+
+      function saveCurrentPreferences() {
+        const plainTime = normalizePlainTime(timeInput.value);
+        const plainDate = normalizePlainDate(dateInput.value);
+        localStorage.setItem(STORAGE_TIME_KEY, plainTime);
+        localStorage.setItem(STORAGE_DATE_KEY, plainDate);
+        renderPreferences(plainTime, plainDate);
+      }
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        saveCurrentPreferences();
+      });
+
+      timeInput.addEventListener('change', saveCurrentPreferences);
+      dateInput.addEventListener('change', saveCurrentPreferences);
+    })();
+  </script>
+
