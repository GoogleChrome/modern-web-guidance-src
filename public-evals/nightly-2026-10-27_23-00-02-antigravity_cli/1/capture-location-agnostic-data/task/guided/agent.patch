+  <script>
+    const STORAGE_KEYS = {
+      reminderTime: 'dailyGrind_pickupReminderTime',
+      anniversaryDate: 'dailyGrind_coffeeAnniversaryDate',
+    };
+
+    function initializePreferencesApp() {
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const displayTime = document.getElementById('display-pickup-time');
+      const displayDate = document.getElementById('display-anniversary-date');
+      const displayAnnual = document.getElementById('display-annual-anniversary');
+      const displayCombined = document.getElementById('display-combined-schedule');
+      const statusBanner = document.getElementById('preferences-status');
+
+      try {
+        const savedTime = localStorage.getItem(STORAGE_KEYS.reminderTime);
+        const savedDate = localStorage.getItem(STORAGE_KEYS.anniversaryDate);
+        if (savedTime) timeInput.value = savedTime;
+        if (savedDate) dateInput.value = savedDate;
+      } catch {
+        // Ignore storage read restrictions
+      }
+
+      function renderSchedule(showSavedNotice = false) {
+        if (!timeInput.value || !dateInput.value) return;
+
+        // Parse wall-clock time and calendar date with Temporal Plain types (no time zone offset)
+        const reminderTime = Temporal.PlainTime.from(timeInput.value);
+        const anniversaryDate = Temporal.PlainDate.from(dateInput.value);
+
+        // Combine calendar date and wall-clock time into a location-agnostic PlainDateTime
+        const combinedSchedule = anniversaryDate.toPlainDateTime(reminderTime);
+
+        // Construct annual recurring month-day with explicit iso8601 calendar
+        const annualAnniversary = Temporal.PlainMonthDay.from({
+          month: anniversaryDate.month,
+          day: anniversaryDate.day,
+          calendar: 'iso8601',
+        });
+
+        const today = Temporal.Now.plainDateISO();
+        const isAnniversaryToday = annualAnniversary.equals(today.toPlainMonthDay());
+        const occurrenceThisYear = annualAnniversary.toPlainDate({ year: today.year });
+
+        // Format and read calendar fields directly from Plain types without time zone conversion
+        const formattedTime = reminderTime.toLocaleString(undefined, {
+          hour: '2-digit',
+          minute: '2-digit',
+        });
+        const formattedDate = anniversaryDate.toLocaleString(undefined, {
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric',
+        });
+
+        displayTime.textContent = `${formattedTime} (${reminderTime.toString()})`;
+        displayDate.textContent = `${formattedDate} (${anniversaryDate.toString()})`;
+        displayAnnual.textContent = `${annualAnniversary.toString()} (This year: ${occurrenceThisYear.toString()})`;
+        displayCombined.textContent = combinedSchedule.toString();
+
+        if (isAnniversaryToday) {
+          statusBanner.textContent = showSavedNotice
+            ? `Preferences saved! Happy Coffee Anniversary (${anniversaryDate.month}/${anniversaryDate.day})!`
+            : `Happy Coffee Anniversary! Your daily pickup reminder is set for ${reminderTime.toString()}.`;
+        } else if (showSavedNotice) {
+          statusBanner.textContent = `Preferences saved! Locked to ${anniversaryDate.toString()} and ${reminderTime.toString()} across all time zones.`;
+        }
+      }
+
+      timeInput.addEventListener('input', () => {
+        timeInput.setCustomValidity('');
+        renderSchedule(false);
+      });
+
+      dateInput.addEventListener('input', () => {
+        dateInput.setCustomValidity('');
+        renderSchedule(false);
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (!form.checkValidity()) return;
+
+        const reminderTime = Temporal.PlainTime.from(timeInput.value);
+        const anniversaryDate = Temporal.PlainDate.from(dateInput.value);
+
+        try {
+          localStorage.setItem(STORAGE_KEYS.reminderTime, reminderTime.toString());
+          localStorage.setItem(STORAGE_KEYS.anniversaryDate, anniversaryDate.toString());
+        } catch {
+          // Ignore storage write restrictions
+        }
+
+        renderSchedule(true);
+      });
+
+      renderSchedule(false);
+    }
+
+    // Check if Temporal is supported natively; load temporal-polyfill conditionally
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializePreferencesApp();
+    })();
+  </script>
+
 </body>
 
