     .btn:hover {
       background: #3e2723;
     }
 
+    /* Horizontal Carousel */
+    .carousel-section {
+      margin-top: 60px;
+    }
+
+    .carousel-section h2 {
+      text-align: center;
+      margin-bottom: 10px;
+    }
+
+    .carousel-section .subtitle {
+      text-align: center;
+      color: #6d4c41;
+      margin-bottom: 20px;
+    }
+
+    .scroller {
+      display: flex;
+      gap: 24px;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scroll-behavior: smooth;
+      padding: 40px calc(50% - 140px);
+      list-style: none;
+      scrollbar-width: thin;
+      scrollbar-color: var(--primary) var(--secondary);
+      -webkit-overflow-scrolling: touch;
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+      border-radius: 8px;
+    }
+
+    .scroller .card {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      transition: box-shadow 0.3s ease;
+      view-timeline-name: --card-timeline;
+      view-timeline-axis: x;
+      animation: scale-up-center linear both;
+      animation-timeline: --card-timeline;
+      animation-range: entry 0% exit 100%;
+    }
+
+    .scroller .card img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-bottom: 15px;
+    }
+
+    .scroller .card .price {
+      font-weight: bold;
+      color: var(--primary);
+      font-size: 1.1rem;
+      margin: 10px 0;
+    }
+
+    @keyframes scale-up-center {
+      0%, 100% {
+        scale: 0.85;
+        opacity: 0.75;
+      }
+      50% {
+        scale: 1.1;
+        opacity: 1;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .scroller {
+        scroll-behavior: auto;
+      }
+      .scroller .card {
+        animation: none;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
