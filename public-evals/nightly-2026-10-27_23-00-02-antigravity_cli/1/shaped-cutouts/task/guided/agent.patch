+    }
+
+    .barista-spotlight {
+      background: white;
+      padding: 32px 24px;
+      border-radius: 16px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      text-align: center;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 16px;
+    }
+
+    .shaped-avatar {
+      width: 200px;
+      height: 200px;
+      object-fit: cover;
+      -webkit-mask-image: url(#splat-mask);
+      mask-image: url(#splat-mask);
+    }
+
+    .promo-stack {
+      display: flex;
+      flex-direction: column;
+      gap: 24px;
+    }
+
+    .unified-card {
+      display: flex;
+      width: 100%;
+      max-width: 500px;
+      filter: drop-shadow(0 8px 16px rgba(62, 39, 35, 0.25));
+    }
+
+    .card-body {
+      flex: 1;
+      background-color: var(--primary);
+      color: var(--light);
+      padding: 24px;
+      border-top-left-radius: 16px;
+      border-bottom-left-radius: 16px;
+    }
+
+    .card-body h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    .card-accent {
+      width: 60px;
+      background-color: var(--primary);
+      border-top-right-radius: 16px;
+      border-bottom-right-radius: 16px;
+      -webkit-mask-image: url(#card-accent-mask);
+      mask-image: url(#card-accent-mask);
+    }
+
+    .gradient-masked-card {
+      background: linear-gradient(135deg, var(--primary), var(--text));
+      color: white;
+      padding: 40px 24px 24px 24px;
+      border-radius: 16px;
+      text-align: center;
+      max-width: 500px;
+      -webkit-mask-image: radial-gradient(circle at 50% 0%, transparent 20px, black 21px);
+      mask-image: radial-gradient(circle at 50% 0%, transparent 20px, black 21px);
+    }
+
+    .gradient-masked-card h3 {
+      color: var(--accent);
+      margin-bottom: 8px;
+    }
+
+    @supports (not (mask-image: url(x))) and (not (-webkit-mask-image: url(x))) {
+      .shaped-avatar {
+        clip-path: inset(5% round 15px);
+      }
+    }
+
