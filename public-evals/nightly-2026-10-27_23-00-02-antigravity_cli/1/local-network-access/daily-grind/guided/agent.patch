+  <script type="module">
+    const insecureWarning = document.getElementById('insecure-context-warning');
+    if (typeof window !== 'undefined' && window.isSecureContext === false) {
+      insecureWarning.hidden = false;
+    }
+
+    /**
+     * Cross-browser permission check and listener registration for granular Local Network Access permissions.
+     * Never queries the legacy 'local-network-access' permission name, which crashes older Chrome renderer processes.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     */
+    async function checkNetworkPermission(permissionName) {
+      if (!navigator.permissions?.query) {
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+      try {
+        const status = await navigator.permissions.query({ name: permissionName });
+        status.addEventListener('change', () => {
+          updatePermissionUI(permissionName, status.state);
+        });
+        updatePermissionUI(permissionName, status.state);
+        return status.state;
+      } catch {
+        // Unrecognized permission name in browsers without LNA support; fall back to 'prompt' and require user gesture
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+    }
+
+    function updatePermissionUI(permissionName, state) {
+      const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+      const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+      if (statusBadge) {
+        statusBadge.textContent = state;
+        statusBadge.dataset.state = state;
+      }
+      if (remediationBox) {
+        remediationBox.hidden = state !== 'denied';
+      }
+    }
+
+    function setDeviceStatus(elementId, state, message) {
+      const box = document.getElementById(elementId);
+      if (!box) return;
+      box.dataset.status = state;
+      box.textContent = message;
+    }
+
+    /**
+     * Connects to the Wi-Fi coffee brewer on the user's local network ('local' address space).
+     */
+    async function connectLocalBrewer(deviceUrl) {
+      const statusId = 'local-brewer-status';
+      const remediationBox = document.querySelector('[data-remediation="local-network"]');
+      setDeviceStatus(statusId, 'connecting', `Connecting to Wi-Fi brewer at ${deviceUrl} (targetAddressSpace: "local")...`);
+
+      try {
+        const request = new Request(deviceUrl, {
+          method: 'GET',
+          mode: 'cors',
+          targetAddressSpace: 'local',
+        });
+
+        const response = await fetch(request);
+        if (!response.ok) {
+          throw new Error(`Brewer responded with HTTP ${response.status}`);
+        }
+        const data = await response.json();
+        setDeviceStatus(
+          statusId,
+          'connected',
+          `Connected to Wi-Fi Brewer! Status: ${JSON.stringify(data)}`
+        );
+      } catch (err) {
+        const permState = await checkNetworkPermission('local-network');
+        setDeviceStatus(
+          statusId,
+          'error',
+          `Unable to reach Wi-Fi brewer (${err?.message || 'Network or permission error'}). Verify the brewer is powered on, on the same LAN, and allowed in Local Network Access site settings.`
+        );
+        if (remediationBox) {
+          remediationBox.hidden = false;
+        }
+        if (permState === 'denied') {
+          updatePermissionUI('local-network', 'denied');
+        }
+      }
+    }
+
+    /**
+     * Connects to the companion brewing utility on the loopback interface ('loopback' address space).
+     */
+    async function connectLoopbackUtility(daemonUrl) {
+      const statusId = 'loopback-utility-status';
+      const remediationBox = document.querySelector('[data-remediation="loopback-network"]');
+      setDeviceStatus(statusId, 'connecting', `Connecting to companion utility at ${daemonUrl} (targetAddressSpace: "loopback")...`);
+
+      try {
+        const request = new Request(daemonUrl, {
+          method: 'GET',
+          mode: 'cors',
+          targetAddressSpace: 'loopback',
+        });
+
+        const response = await fetch(request);
+        if (!response.ok) {
+          throw new Error(`Companion utility responded with HTTP ${response.status}`);
+        }
+        const data = await response.json();
+        setDeviceStatus(
+          statusId,
+          'connected',
+          `Connected to Companion Utility! Health: ${JSON.stringify(data)}`
+        );
+      } catch (err) {
+        const permState = await checkNetworkPermission('loopback-network');
+        setDeviceStatus(
+          statusId,
+          'error',
+          `Unable to reach companion utility (${err?.message || 'Network or permission error'}). Verify the daemon is running on 127.0.0.1 / localhost and allowed in Loopback Network site settings.`
+        );
+        if (remediationBox) {
+          remediationBox.hidden = false;
+        }
+        if (permState === 'denied') {
+          updatePermissionUI('loopback-network', 'denied');
+        }
+      }
+    }
+
+    let activeSockets = { local: null, loopback: null };
+
+    /**
+     * Opens a WebSocket stream to a local or loopback endpoint.
+     * Passes only the subprotocol array as the second argument (never a targetAddressSpace options object).
+     */
+    function openTelemetryStream(kind, wsUrl, statusId, permissionName) {
+      const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+      if (activeSockets[kind]) {
+        activeSockets[kind].close();
+        activeSockets[kind] = null;
+      }
+
+      setDeviceStatus(statusId, 'connecting', `Opening WebSocket stream to ${wsUrl}...`);
+      try {
+        const socket = new WebSocket(wsUrl, ['v1.telemetry']);
+        activeSockets[kind] = socket;
+
+        socket.addEventListener('open', () => {
+          setDeviceStatus(statusId, 'connected', `Live telemetry stream connected (${wsUrl}).`);
+        });
+
+        socket.addEventListener('message', (event) => {
+          setDeviceStatus(statusId, 'connected', `Telemetry update: ${event.data}`);
+        });
+
+        socket.addEventListener('error', async () => {
+          await checkNetworkPermission(permissionName);
+          setDeviceStatus(
+            statusId,
+            'error',
+            `WebSocket stream failed for ${wsUrl}. Check device power, local address, and ${permissionName} permission in Site settings.`
+          );
+          if (remediationBox) {
+            remediationBox.hidden = false;
+          }
+        });
+      } catch (err) {
+        setDeviceStatus(statusId, 'error', `Invalid WebSocket URL or syntax error: ${err?.message || err}`);
+        if (remediationBox) {
+          remediationBox.hidden = false;
+        }
+      }
+    }
+
+    // Wire up explicit user gesture buttons
+    document.getElementById('connect-local-brewer-btn')?.addEventListener('click', () => {
+      const url = document.getElementById('local-brewer-url').value.trim();
+      connectLocalBrewer(url);
+    });
+
+    document.getElementById('stream-local-brewer-btn')?.addEventListener('click', () => {
+      const wsUrl = document.getElementById('local-brewer-ws').value.trim();
+      openTelemetryStream('local', wsUrl, 'local-brewer-status', 'local-network');
+    });
+
+    document.getElementById('connect-loopback-utility-btn')?.addEventListener('click', () => {
+      const url = document.getElementById('loopback-utility-url').value.trim();
+      connectLoopbackUtility(url);
+    });
+
+    document.getElementById('stream-loopback-utility-btn')?.addEventListener('click', () => {
+      const wsUrl = document.getElementById('loopback-utility-ws').value.trim();
+      openTelemetryStream('loopback', wsUrl, 'loopback-utility-status', 'loopback-network');
+    });
+
+    // Pre-check granular permissions on load: only auto-connect if permission is already 'granted'
+    async function initEquipmentConnections() {
+      const localState = await checkNetworkPermission('local-network');
+      if (localState === 'granted') {
+        const localUrl = document.getElementById('local-brewer-url').value.trim();
+        connectLocalBrewer(localUrl);
+      }
+
+      const loopbackState = await checkNetworkPermission('loopback-network');
+      if (loopbackState === 'granted') {
+        const loopbackUrl = document.getElementById('loopback-utility-url').value.trim();
+        connectLoopbackUtility(loopbackUrl);
+      }
+    }
+
+    initEquipmentConnections();
+  </script>
 </body>
 
