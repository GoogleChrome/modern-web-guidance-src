+  <script>
+    (function () {
+      const DEVICE_CONFIG = {
+        local: {
+          label: 'Wi-Fi Coffee Brewer',
+          permissionName: 'local-network',
+          legacyPermissionName: 'local-network-access',
+          targetAddressSpace: 'local',
+          badgeEl: document.getElementById('local-perm-badge'),
+          inputEl: document.getElementById('local-endpoint-input'),
+          buttonEl: document.getElementById('connect-local-btn'),
+          feedbackEl: document.getElementById('local-feedback'),
+          permissionState: 'unknown'
+        },
+        loopback: {
+          label: 'Companion Brewing Utility',
+          permissionName: 'loopback-network',
+          legacyPermissionName: 'local-network-access',
+          targetAddressSpace: 'loopback',
+          badgeEl: document.getElementById('loopback-perm-badge'),
+          inputEl: document.getElementById('loopback-endpoint-input'),
+          buttonEl: document.getElementById('connect-loopback-btn'),
+          feedbackEl: document.getElementById('loopback-feedback'),
+          permissionState: 'unknown'
+        }
+      };
+
+      const contextBanner = document.getElementById('security-context-banner');
+      const contextStatus = document.getElementById('secure-context-status');
+      const refreshBtn = document.getElementById('refresh-permissions-btn');
+
+      function checkSecureContext() {
+        if (window.isSecureContext) {
+          contextBanner.classList.remove('insecure');
+          contextStatus.textContent = 'Secure Context (HTTPS / localhost) — Local Network Access permissions active.';
+        } else {
+          contextBanner.classList.add('insecure');
+          contextStatus.textContent = 'Non-Secure Context (HTTP) — Browsers require HTTPS to grant local-network and loopback-network permissions.';
+        }
+      }
+
+      function renderPermissionBadge(badgeEl, state, note) {
+        badgeEl.className = 'perm-badge';
+        const normalized = (state || 'unsupported').toLowerCase();
+        if (normalized === 'granted') {
+          badgeEl.classList.add('perm-granted');
+          badgeEl.textContent = 'Granted';
+        } else if (normalized === 'prompt') {
+          badgeEl.classList.add('perm-prompt');
+          badgeEl.textContent = 'Prompt Required';
+        } else if (normalized === 'denied') {
+          badgeEl.classList.add('perm-denied');
+          badgeEl.textContent = 'Denied';
+        } else {
+          badgeEl.classList.add('perm-unsupported');
+          badgeEl.textContent = note || 'Unsupported';
+        }
+      }
+
+      async function queryDevicePermission(deviceKey) {
+        const cfg = DEVICE_CONFIG[deviceKey];
+        if (!navigator.permissions || typeof navigator.permissions.query !== 'function') {
+          cfg.permissionState = 'unsupported';
+          renderPermissionBadge(cfg.badgeEl, 'unsupported', 'Permissions API Unavailable');
+          return 'unsupported';
+        }
+
+        try {
+          const status = await navigator.permissions.query({ name: cfg.permissionName });
+          cfg.permissionState = status.state;
+          renderPermissionBadge(cfg.badgeEl, status.state);
+          status.onchange = function () {
+            cfg.permissionState = status.state;
+            renderPermissionBadge(cfg.badgeEl, status.state);
+          };
+          return status.state;
+        } catch (primaryErr) {
+          try {
+            const fallbackStatus = await navigator.permissions.query({ name: cfg.legacyPermissionName });
+            cfg.permissionState = fallbackStatus.state;
+            renderPermissionBadge(cfg.badgeEl, fallbackStatus.state);
+            fallbackStatus.onchange = function () {
+              cfg.permissionState = fallbackStatus.state;
+              renderPermissionBadge(cfg.badgeEl, fallbackStatus.state);
+            };
+            return fallbackStatus.state;
+          } catch (fallbackErr) {
+            cfg.permissionState = 'unsupported';
+            renderPermissionBadge(cfg.badgeEl, 'unsupported', 'API Unsupported');
+            return 'unsupported';
+          }
+        }
+      }
+
+      async function refreshAllPermissions() {
+        checkSecureContext();
+        await Promise.all([
+          queryDevicePermission('local'),
+          queryDevicePermission('loopback')
+        ]);
+      }
+
+      function setFeedback(cfg, statusType, headline, detail) {
+        cfg.feedbackEl.className = 'feedback-box status-' + statusType;
+        cfg.feedbackEl.innerHTML = '';
+
+        const strong = document.createElement('strong');
+        strong.textContent = headline;
+        cfg.feedbackEl.appendChild(strong);
+
+        if (detail) {
+          const meta = document.createElement('div');
+          meta.className = 'feedback-meta';
+          meta.textContent = detail;
+          cfg.feedbackEl.appendChild(meta);
+        }
+      }
+
+      function validateEndpointUrl(rawUrl, deviceKey) {
+        let parsed;
+        try {
+          parsed = new URL(rawUrl);
+        } catch (e) {
+          return { valid: false, reason: 'Invalid URL format. Please enter a full http:// or https:// endpoint URL.' };
+        }
+
+        if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
+          return { valid: false, reason: 'Unsupported protocol "' + parsed.protocol + '". Only HTTP/HTTPS endpoints are supported.' };
+        }
+
+        return { valid: true, url: parsed.toString(), hostname: parsed.hostname };
+      }
+
+      async function connectToDevice(deviceKey) {
+        const cfg = DEVICE_CONFIG[deviceKey];
+        const rawUrl = cfg.inputEl.value.trim();
+
+        const validation = validateEndpointUrl(rawUrl, deviceKey);
+        if (!validation.valid) {
+          setFeedback(cfg, 'error', 'Invalid Endpoint Configuration', validation.reason);
+          return;
+        }
+
+        const currentPerm = await queryDevicePermission(deviceKey);
+
+        if (!window.isSecureContext) {
+          setFeedback(
+            cfg,
+            'error',
+            'Insecure Context Blocked',
+            'Local Network Access requests require a Secure Context (HTTPS). Please load The Daily Grind over HTTPS before connecting to ' + cfg.label + '.'
+          );
+          return;
+        }
+
+        if (currentPerm === 'denied') {
+          setFeedback(
+            cfg,
+            'error',
+            'Permission Denied (' + cfg.permissionName + ')',
+            'Browser permission for "' + cfg.permissionName + '" is blocked. Please allow Local Network / Loopback access in your browser site settings and retry.'
+          );
+          return;
+        }
+
+        cfg.buttonEl.disabled = true;
+        setFeedback(
+          cfg,
+          'connecting',
+          'Connecting to ' + cfg.label + '...',
+          'Requesting ' + validation.url + ' with targetAddressSpace: "' + cfg.targetAddressSpace + '" (permission state: ' + currentPerm + ').'
+        );
+
+        const controller = new AbortController();
+        const timeoutId = setTimeout(function () {
+          controller.abort();
+        }, 4500);
+
+        try {
+          const response = await fetch(validation.url, {
+            method: 'GET',
+            mode: 'cors',
+            targetAddressSpace: cfg.targetAddressSpace,
+            signal: controller.signal
+          });
+          clearTimeout(timeoutId);
+
+          await queryDevicePermission(deviceKey);
+
+          if (!response.ok) {
+            setFeedback(
+              cfg,
+              'error',
+              'Equipment Returned HTTP ' + response.status,
+              cfg.label + ' responded with status ' + response.status + ' (' + (response.statusText || 'Error') + ') at ' + validation.url + '.'
+            );
+            return;
+          }
+
+          let summary = 'Connected to ' + cfg.label + ' at ' + validation.url + '.';
+          try {
+            const data = await response.json();
+            if (data && (data.status || data.model || data.temperature)) {
+              summary += ' Device report: ' + JSON.stringify(data);
+            }
+          } catch (_) {
+            // Non-JSON response is still a valid connection
+          }
+
+          setFeedback(cfg, 'success', 'Connected (' + cfg.targetAddressSpace + ')', summary);
+        } catch (err) {
+          clearTimeout(timeoutId);
+          const updatedPerm = await queryDevicePermission(deviceKey);
+
+          if (err && err.name === 'AbortError') {
+            setFeedback(
+              cfg,
+              'error',
+              'Connection Timed Out',
+              cfg.label + ' at ' + validation.url + ' did not respond within 4.5s. Verify the device is powered on and reachable on the ' + cfg.targetAddressSpace + ' interface.'
+            );
+          } else if (updatedPerm === 'denied') {
+            setFeedback(
+              cfg,
+              'error',
+              'Permission Denied (' + cfg.permissionName + ')',
+              'The browser blocked access to the ' + cfg.targetAddressSpace + ' address space (' + cfg.permissionName + ' permission denied). Update site permissions in your browser address bar to connect.'
+            );
+          } else {
+            const errMsg = err && err.message ? err.message : String(err);
+            setFeedback(
+              cfg,
+              'error',
+              'Connection Failed (' + cfg.targetAddressSpace + ' network error)',
+              'Could not reach ' + cfg.label + ' at ' + validation.url + ' (' + errMsg + '). Check that "' + cfg.permissionName + '" permission is granted, CORS/Private Network headers are enabled on the device, and the endpoint is active.'
+            );
+          }
+        } finally {
+          cfg.buttonEl.disabled = false;
+        }
+      }
+
+      DEVICE_CONFIG.local.buttonEl.addEventListener('click', function () {
+        connectToDevice('local');
+      });
+
+      DEVICE_CONFIG.loopback.buttonEl.addEventListener('click', function () {
+        connectToDevice('loopback');
+      });
+
+      refreshBtn.addEventListener('click', function () {
+        refreshAllPermissions();
+      });
+
+      refreshAllPermissions();
+    })();
+  </script>
 </body>
 
 </html>
