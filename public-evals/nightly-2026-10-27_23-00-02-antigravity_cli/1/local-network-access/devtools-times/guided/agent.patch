diff --git a/src/utils/localNetworkAccess.ts b/src/utils/localNetworkAccess.ts
new file mode 100644
index 0000000..c56a327
--- /dev/null
+++ b/src/utils/localNetworkAccess.ts
@@ -0,0 +1,186 @@
+/**
+ * Local Network Access (LNA) utility module.
+ * Implements granular permission checks ('local-network' and 'loopback-network'),
+ * targetAddressSpace fetch/Request declarations, WebSocket/WebTransport helpers,
+ * and cross-browser progressive fallback strategies.
+ */
+
+export type LnaAddressSpace = 'local' | 'loopback';
+export type LnaPermissionName = 'local-network' | 'loopback-network';
+
+/**
+ * Maps a targetAddressSpace ('local' | 'loopback') to its corresponding
+ * granular PermissionName ('local-network' | 'loopback-network').
+ */
+export function getPermissionNameForSpace(space: LnaAddressSpace): LnaPermissionName {
+  return space === 'loopback' ? 'loopback-network' : 'local-network';
+}
+
+/**
+ * Cross-browser permission check for the granular LNA permissions.
+ * Never falls back to querying 'local-network-access', which crashes older Chrome versions.
+ * @param permissionName 'local-network' | 'loopback-network'
+ * @param onChange Optional callback invoked when the permission state changes in site settings
+ */
+export async function queryLnaPermissionSafe(
+  permissionName: LnaPermissionName,
+  onChange?: (state: PermissionState) => void
+): Promise<PermissionState> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return 'prompt';
+  }
+  try {
+    const status = await navigator.permissions.query({
+      name: permissionName as PermissionName,
+    });
+    if (onChange) {
+      status.addEventListener('change', () => {
+        onChange(status.state);
+      });
+    }
+    return status.state;
+  } catch {
+    // Unrecognized permission name; proceed on user gesture
+    return 'prompt';
+  }
+}
+
+/**
+ * Queries the granular Local Network Access permission for the target space
+ * and synchronizes any matching DOM status badges / remediation containers.
+ * @param permissionName 'local-network' | 'loopback-network'
+ */
+export async function checkNetworkPermission(
+  permissionName: LnaPermissionName
+): Promise<PermissionState> {
+  const state = await queryLnaPermissionSafe(permissionName, (newState) => {
+    updatePermissionUI(permissionName, newState);
+  });
+  updatePermissionUI(permissionName, state);
+  return state;
+}
+
+export function updatePermissionUI(
+  permissionName: LnaPermissionName,
+  state: PermissionState
+): void {
+  if (typeof document === 'undefined') return;
+  const statusBadge = document.querySelector<HTMLElement>(
+    `[data-permission-status="${permissionName}"]`
+  );
+  const remediationBox = document.querySelector<HTMLElement>(
+    `[data-remediation="${permissionName}"]`
+  );
+  if (statusBadge) {
+    statusBadge.textContent = state;
+  }
+  if (remediationBox) {
+    // Show remediation instructions whenever permission is explicitly denied
+    remediationBox.hidden = state !== 'denied';
+  }
+}
+
+/**
+ * Connects to a local network device (e.g., LAN printer, newsroom print server, or IoT hub) over HTTP.
+ * Explicitly declares `targetAddressSpace: 'local'` for Mixed Content exemption and IP verification.
+ */
+export async function fetchLocalDeviceStatus(
+  deviceUrl = 'http://192.168.1.100:8080/api/status',
+  init?: RequestInit
+): Promise<unknown> {
+  const request = new Request(deviceUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+    targetAddressSpace: 'local',
+  } as RequestInit);
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Device responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Connects to a local companion daemon running on the user's loopback interface.
+ * Explicitly declares `targetAddressSpace: 'loopback'` for Mixed Content exemption and IP verification.
+ */
+export async function fetchLoopbackDaemon(
+  daemonUrl = 'http://127.0.0.1:45678/health',
+  init?: RequestInit
+): Promise<unknown> {
+  const request = new Request(daemonUrl, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+    targetAddressSpace: 'loopback',
+  } as RequestInit);
+
+  const response = await fetch(request);
+  if (!response.ok) {
+    throw new Error(`Companion app responded with HTTP ${response.status}`);
+  }
+  return response.json();
+}
+
+/**
+ * Generic helper to fetch a resource in either the 'local' or 'loopback' address space.
+ */
+export async function fetchWithAddressSpace(
+  url: string,
+  targetAddressSpace: LnaAddressSpace,
+  init?: RequestInit
+): Promise<Response> {
+  const request = new Request(url, {
+    method: 'GET',
+    mode: 'cors',
+    ...init,
+    targetAddressSpace,
+  } as RequestInit);
+
+  return fetch(request);
+}
+
+/**
+ * Opens a WebSocket connection to a local network or loopback device (IP literal, .local, or localhost).
+ * Pass only subprotocol string(s) as the second argument (never an options object).
+ */
+export function openLocalWebSocket(
+  wsUrl = 'ws://192.168.1.100:8080/stream',
+  protocols: string | string[] = ['v1.telemetry']
+): WebSocket {
+  // Pass only subprotocol string(s) as the second argument (never an options object).
+  // Browsers exempt ws:// from Mixed Content when the host is a local/loopback IP literal,
+  // .local, or localhost, and gate the connection on 'local-network' or 'loopback-network'.
+  const socket = new WebSocket(wsUrl, protocols);
+  return socket;
+}
+
+/**
+ * Opens a WebTransport session to a local network endpoint using a pinned self-signed certificate hash.
+ */
+export async function openLocalWebTransport(
+  wtUrl = 'https://192.168.1.100:4433/wt',
+  certSha256Bytes?: BufferSource
+): Promise<WebTransport> {
+  const options: WebTransportOptions = certSha256Bytes
+    ? {
+        serverCertificateHashes: [
+          {
+            algorithm: 'sha-256',
+            value: certSha256Bytes,
+          },
+        ],
+      }
+    : {};
+
+  const transport = new WebTransport(wtUrl, options);
+
+  // transport.ready resolves only after the user grants the 'local-network' or 'loopback-network' permission
+  // and rejects with WebTransportError if the permission is denied.
+  await transport.ready;
+  return transport;
+}
