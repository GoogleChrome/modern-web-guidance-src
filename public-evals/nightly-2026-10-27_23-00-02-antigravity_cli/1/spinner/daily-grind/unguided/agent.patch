+  <script>
+    (function () {
+      function setLoadingState(btn) {
+        if (!btn || btn.getAttribute('aria-busy') === 'true') {
+          return;
+        }
+
+        btn.setAttribute('aria-busy', 'true');
+        btn.setAttribute('aria-disabled', 'true');
+        btn.setAttribute('disabled', '');
+        btn.disabled = true;
+        btn.classList.add('loading', 'is-loading');
+
+        var spinner = btn.querySelector('.spinner');
+        if (spinner) {
+          spinner.classList.add('active');
+        }
+
+        var srText = btn.querySelector('.sr-only');
+        var loadingMessage = btn.getAttribute('data-loading-text') || 'Loading, please wait...';
+        if (srText) {
+          srText.textContent = loadingMessage;
+        }
+
+        var card = btn.closest('.card');
+        if (card) {
+          card.setAttribute('aria-busy', 'true');
+          card.classList.add('loading', 'is-loading');
+        }
+
+        var section = btn.closest('section, header');
+        if (section) {
+          section.setAttribute('aria-busy', 'true');
+          section.classList.add('loading', 'is-loading');
+        }
+      }
+
+      var actionButtons = document.querySelectorAll('.hero .btn, #seasonal-favorites .btn');
+      actionButtons.forEach(function (btn) {
+        btn.addEventListener('click', function (event) {
+          event.preventDefault();
+          setLoadingState(btn);
+        });
+      });
+    })();
+  </script>
