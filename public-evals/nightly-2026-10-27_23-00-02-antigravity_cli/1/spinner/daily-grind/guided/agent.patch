+  <script>
+    function setButtonLoading(btn, isLoading, loadingText) {
+      let spinner = btn.querySelector('progress.loading-spinner');
+      const label = btn.querySelector('.btn-label');
+
+      if (isLoading) {
+        btn.setAttribute('aria-busy', 'true');
+        if (!spinner) {
+          spinner = document.createElement('progress');
+          spinner.className = 'loading-spinner';
+          spinner.setAttribute('aria-label', loadingText || 'Loading');
+          btn.prepend(spinner);
+        } else {
+          spinner.setAttribute('aria-label', loadingText || 'Loading');
+          spinner.hidden = false;
+        }
+        if (label && loadingText) {
+          if (!btn.dataset.originalLabel) {
+            btn.dataset.originalLabel = label.textContent;
+          }
+          label.textContent = loadingText;
+        }
+      } else {
+        btn.removeAttribute('aria-busy');
+        if (spinner) {
+          spinner.hidden = true;
+        }
+        if (label && btn.dataset.originalLabel) {
+          label.textContent = btn.dataset.originalLabel;
+        }
+      }
+    }
+
+    const orderNowBtn = document.getElementById('order-now-btn');
+    if (orderNowBtn) {
+      orderNowBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        if (orderNowBtn.getAttribute('aria-busy') === 'true') return;
+        setButtonLoading(orderNowBtn, true, 'Starting Order...');
+        setTimeout(() => {
+          window.location.href = orderNowBtn.getAttribute('href');
+        }, 800);
+      });
+    }
+
+    document.querySelectorAll('.drink-details-btn').forEach((btn) => {
+      btn.addEventListener('click', (event) => {
+        event.preventDefault();
+        if (btn.getAttribute('aria-busy') === 'true') return;
+
+        const card = btn.closest('.card');
+        if (card) {
+          card.setAttribute('aria-busy', 'true');
+        }
+        setButtonLoading(btn, true, 'Loading Details...');
+
+        setTimeout(() => {
+          setButtonLoading(btn, false);
+          if (card) {
+            card.removeAttribute('aria-busy');
+            const details = card.querySelector('.drink-details');
+            const label = btn.querySelector('.btn-label');
+            if (details) {
+              const isHidden = details.hidden;
+              details.hidden = !isHidden;
+              if (label) {
+                label.textContent = isHidden ? 'Hide Details' : 'View Details';
+                btn.dataset.originalLabel = label.textContent;
+              }
+            }
+          }
+        }, 600);
+      });
+    });
+  </script>
