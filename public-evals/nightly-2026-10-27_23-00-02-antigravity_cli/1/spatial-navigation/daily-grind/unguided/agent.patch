+
+          if (rowCandidates.length > 0) {
+            rowCandidates.sort((a, b) => {
+              // Primary: closest horizontal edge/center distance
+              const distA = isRight
+                ? Math.max(0, a.left - current.right) || Math.abs(a.centerX - current.centerX)
+                : Math.max(0, current.left - a.right) || Math.abs(current.centerX - a.centerX);
+              const distB = isRight
+                ? Math.max(0, b.left - current.right) || Math.abs(b.centerX - current.centerX)
+                : Math.max(0, current.left - b.right) || Math.abs(current.centerX - b.centerX);
+
+              if (Math.abs(distA - distB) > EPSILON) return distA - distB;
+
+              // Tie-breaker: closest top edge / vertical alignment
+              return Math.abs(a.top - current.top) - Math.abs(b.top - current.top);
+            });
+
+            return rowCandidates[0].card;
+          }
+
+          // If at the end/start of a row in a multi-row grid, wrap in reading order to next/previous row
+          const rows = groupIntoRows(items);
+          let currentRowIdx = -1;
+          let currentColIdx = -1;
+          for (let r = 0; r < rows.length; r++) {
+            const c = rows[r].findIndex((it) => it.card === currentCard);
+            if (c !== -1) {
+              currentRowIdx = r;
+              currentColIdx = c;
+              break;
+            }
+          }
+
+          if (currentRowIdx !== -1 && rows.length > 1) {
+            if (isRight && currentColIdx === rows[currentRowIdx].length - 1 && currentRowIdx < rows.length - 1) {
+              return rows[currentRowIdx + 1][0].card;
+            }
+            if (!isRight && currentColIdx === 0 && currentRowIdx > 0) {
+              const prevRow = rows[currentRowIdx - 1];
+              return prevRow[prevRow.length - 1].card;
+            }
+          }
+
+          return null;
+        }
+
+        if (direction === 'ArrowDown' || direction === 'ArrowUp') {
+          const isDown = direction === 'ArrowDown';
+
+          // Filter candidates strictly below or above current card
+          const verticalCandidates = others.filter((cand) => {
+            if (isDown) {
+              // Must start below current top and have centerY noticeably below current centerY
+              // Also exclude cards that are primarily side-by-side in the same row
+              const vOverlap = getOverlap(current.top, current.bottom, cand.top, cand.bottom);
+              const minH = Math.min(current.height, cand.height) || 1;
+              const isSameRowNeighbor = vOverlap / minH > 0.6 && Math.abs(cand.top - current.top) < 15;
+              return !isSameRowNeighbor && cand.centerY > current.centerY + EPSILON && cand.top >= current.top + EPSILON;
+            } else {
+              const vOverlap = getOverlap(current.top, current.bottom, cand.top, cand.bottom);
+              const minH = Math.min(current.height, cand.height) || 1;
+              const isSameRowNeighbor = vOverlap / minH > 0.6 && Math.abs(cand.top - current.top) < 15;
+              return !isSameRowNeighbor && cand.centerY < current.centerY - EPSILON && cand.bottom <= current.bottom - EPSILON;
+            }
+          });
+
+          if (verticalCandidates.length === 0) return null;
+
+          // Prefer candidates that horizontally overlap with the current card's column span
+          const columnAligned = verticalCandidates.filter((cand) => {
+            const hOverlap = getOverlap(current.left, current.right, cand.left, cand.right);
+            return hOverlap > 5 || Math.abs(cand.centerX - current.centerX) <= 20;
+          });
+
+          const pool = columnAligned.length > 0 ? columnAligned : verticalCandidates;
+
+          pool.sort((a, b) => {
+            // Primary distance along the vertical axis (edge-to-edge or center-to-center)
+            const vDistA = isDown
+              ? Math.max(0, a.top - current.bottom)
+              : Math.max(0, current.top - a.bottom);
+            const vDistB = isDown
+              ? Math.max(0, b.top - current.bottom)
+              : Math.max(0, current.top - b.bottom);
+
+            // If one candidate is in the immediately adjacent row and the other is a row further away
+            if (Math.abs(vDistA - vDistB) > 25) {
+              return vDistA - vDistB;
+            }
+
+            // Within the same target row: prefer greatest horizontal overlap or closest horizontal alignment
+            const hOverlapA = getOverlap(current.left, current.right, a.left, a.right);
+            const hOverlapB = getOverlap(current.left, current.right, b.left, b.right);
+
+            if (Math.abs(hOverlapA - hOverlapB) > 10) {
+              return hOverlapB - hOverlapA;
+            }
+
+            const hDistA = Math.abs(a.left - current.left) + Math.abs(a.centerX - current.centerX);
+            const hDistB = Math.abs(b.left - current.left) + Math.abs(b.centerX - current.centerX);
+            if (Math.abs(hDistA - hDistB) > EPSILON) {
+              return hDistA - hDistB;
+            }
+
+            return Math.abs(a.centerY - current.centerY) - Math.abs(b.centerY - current.centerY);
+          });
+
+          return pool[0].card;
+        }
+
+        return null;
+      }
+
+      /**
+       * Update roving tabindex and focus the selected card.
+       */
+      function activateCardFocus(targetCard, shouldFocus = true) {
+        const cards = getVisibleCards();
+        if (!targetCard || !cards.includes(targetCard)) return;
+
+        cards.forEach((card) => {
+          const isTarget = card === targetCard;
+          card.setAttribute('tabindex', isTarget ? '0' : '-1');
+        });
+
+        if (shouldFocus) {
+          targetCard.focus();
+        }
+
+        const idx = cards.indexOf(targetCard);
+        const titleEl = targetCard.querySelector('h3');
+        const title = titleEl ? titleEl.textContent.trim() : `Card ${idx + 1}`;
+        const layoutMode = grid.getAttribute('data-layout') || 'grid';
+
+        if (coordsIndicator) {
+          coordsIndicator.textContent = `Active card: ${idx + 1} of ${cards.length} (${title})`;
+        }
+        if (statusRegion && shouldFocus) {
+          statusRegion.textContent = `${title}, card ${idx + 1} of ${cards.length} (${layoutMode} layout)`;
+        }
+      }
+
+      /**
+       * Resolve which card owns a DOM event target (either the card itself or an element inside it).
+       */
+      function getOwningCard(element) {
+        if (!element || !grid.contains(element)) return null;
+        return element.closest('.card');
+      }
+
+      // Keyboard navigation handler on the grid container
+      grid.addEventListener('keydown', (event) => {
+        const cards = getVisibleCards();
+        if (cards.length === 0) return;
+
+        const currentCard = getOwningCard(document.activeElement) ||
+          cards.find((c) => c.getAttribute('tabindex') === '0') ||
+          cards[0];
+
+        const { key } = event;
+
+        if (['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp'].includes(key)) {
+          event.preventDefault();
+          const nextCard = findSpatialTarget(cards, currentCard, key);
+          if (nextCard) {
+            activateCardFocus(nextCard, true);
+          }
+          return;
+        }
+
+        if (key === 'Home') {
+          event.preventDefault();
+          activateCardFocus(cards[0], true);
+          return;
+        }
+
+        if (key === 'End') {
+          event.preventDefault();
+          activateCardFocus(cards[cards.length - 1], true);
+          return;
+        }
+
+        if ((key === 'Enter' || key === ' ') && document.activeElement === currentCard) {
+          const primaryLink = currentCard.querySelector('a.btn, button, a[href]');
+          if (primaryLink) {
+            event.preventDefault();
+            primaryLink.click();
+          }
+        }
+      });
+
+      // Keep roving tabindex synchronized when a user clicks or focuses a card directly
+      grid.addEventListener('focusin', (event) => {
+        const card = getOwningCard(event.target);
+        if (card) {
+          activateCardFocus(card, false);
+        }
+      });
+
+      grid.addEventListener('click', (event) => {
+        const card = getOwningCard(event.target);
+        if (!card) return;
+        activateCardFocus(card, false);
+      });
+
+      /**
+       * Switch layout mode while preserving the active card's roving tabindex and focus.
+       */
+      function setLayoutMode(mode) {
+        const validModes = ['grid', 'list', 'compact', 'featured'];
+        const normalizedMode = validModes.includes(mode) ? mode : 'grid';
+
+        const cards = getVisibleCards();
+        const activeCard = getOwningCard(document.activeElement) ||
+          cards.find((c) => c.getAttribute('tabindex') === '0') ||
+          cards[0];
+
+        grid.setAttribute('data-layout', normalizedMode);
+        validModes.forEach((m) => grid.classList.remove(`layout-${m}`));
+        grid.classList.add(`layout-${normalizedMode}`);
+
+        layoutButtons.forEach((btn) => {
+          const isMatch = btn.getAttribute('data-layout-mode') === normalizedMode;
+          btn.classList.toggle('active', isMatch);
+          btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
+        });
+
+        if (activeCard) {
+          activateCardFocus(activeCard, false);
+        }
+
+        if (statusRegion) {
+          const label = normalizedMode.charAt(0).toUpperCase() + normalizedMode.slice(1);
+          statusRegion.textContent = `Layout changed to ${label} view.`;
+        }
+      }
+
+      layoutButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const mode = btn.getAttribute('data-layout-mode');
+          setLayoutMode(mode);
+        });
+      });
+
+      // Expose helper API for programmatic layout updates or external inspection
+      window.CardGridSpatialNav = {
+        setLayoutMode,
+        findSpatialTarget: (currentCard, direction) => findSpatialTarget(getVisibleCards(), currentCard, direction),
+        getActiveCard: () => getVisibleCards().find((c) => c.getAttribute('tabindex') === '0') || null,
+      };
+    })();
+  </script>
 </body>
 
 </html>
