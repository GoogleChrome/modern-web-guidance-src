+  <script>
+    (() => {
+      const FOCUSABLE_SELECTOR = [
+        'a[href]',
+        'button:not(:disabled)',
+        'input:not(:disabled):not([type="hidden"])',
+        'select:not(:disabled)',
+        'textarea:not(:disabled)',
+        '[tabindex]:not([disabled])'
+      ].join(', ');
+
+      const ARROW_KEYS = new Set(['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight']);
+      const TOLERANCE = 1;
+      const FALLBACK_WEIGHT = 2;
+      const initializedContainers = new WeakSet();
+
+      function getAllFocusable(container) {
+        return Array.from(container.querySelectorAll(FOCUSABLE_SELECTOR));
+      }
+
+      function isVisibleCandidate(el) {
+        if (!(el instanceof HTMLElement)) return false;
+        if (el.hasAttribute('disabled')) return false;
+        if (el.closest('[inert], [aria-hidden="true"]')) return false;
+        if (typeof el.checkVisibility === 'function') {
+          if (!el.checkVisibility({ checkVisibilityCSS: true })) return false;
+        }
+        const style = window.getComputedStyle(el);
+        if (style.display === 'none' || style.visibility === 'hidden') return false;
+        const rect = el.getBoundingClientRect();
+        return rect.width > 0 && rect.height > 0;
+      }
+
+      function getCandidates(container) {
+        return getAllFocusable(container).filter(isVisibleCandidate);
+      }
+
+      function syncRovingTabindex(container, preferredActive = null) {
+        const allFocusable = getAllFocusable(container);
+        const candidates = allFocusable.filter(isVisibleCandidate);
+        if (candidates.length === 0) return;
+
+        let active = null;
+        if (preferredActive && candidates.includes(preferredActive)) {
+          active = preferredActive;
+        } else if (
+          document.activeElement instanceof HTMLElement &&
+          candidates.includes(document.activeElement)
+        ) {
+          active = document.activeElement;
+        } else {
+          active =
+            candidates.find((el) => el.getAttribute('tabindex') === '0') ||
+            candidates[0];
+        }
+
+        for (const el of allFocusable) {
+          const targetTabIndex = el === active ? '0' : '-1';
+          if (el.getAttribute('tabindex') !== targetTabIndex) {
+            el.setAttribute('tabindex', targetTabIndex);
+          }
+        }
+      }
+
+      function findNextCandidate(current, candidates, key) {
+        const currentRect = current.getBoundingClientRect();
+        const currentCenterX = (currentRect.left + currentRect.right) / 2;
+        const currentCenterY = (currentRect.top + currentRect.bottom) / 2;
+        const isHorizontal = key === 'ArrowLeft' || key === 'ArrowRight';
+
+        const aligned = [];
+        const fallback = [];
+
+        for (const candidate of candidates) {
+          if (candidate === current) continue;
+          const rect = candidate.getBoundingClientRect();
+
+          let gap = 0;
+          if (key === 'ArrowRight') {
+            if (rect.left < currentRect.right - TOLERANCE) continue;
+            gap = Math.max(0, rect.left - currentRect.right);
+          } else if (key === 'ArrowLeft') {
+            if (rect.right > currentRect.left + TOLERANCE) continue;
+            gap = Math.max(0, currentRect.left - rect.right);
+          } else if (key === 'ArrowDown') {
+            if (rect.top < currentRect.bottom - TOLERANCE) continue;
+            gap = Math.max(0, rect.top - currentRect.bottom);
+          } else if (key === 'ArrowUp') {
+            if (rect.bottom > currentRect.top + TOLERANCE) continue;
+            gap = Math.max(0, currentRect.top - rect.bottom);
+          }
+
+          const candidateCenterX = (rect.left + rect.right) / 2;
+          const candidateCenterY = (rect.top + rect.bottom) / 2;
+
+          let overlap = 0;
+          let perpCenterOffset = 0;
+
+          if (isHorizontal) {
+            overlap =
+              Math.min(currentRect.bottom, rect.bottom) -
+              Math.max(currentRect.top, rect.top);
+            perpCenterOffset = Math.abs(candidateCenterY - currentCenterY);
+          } else {
+            overlap =
+              Math.min(currentRect.right, rect.right) -
+              Math.max(currentRect.left, rect.left);
+            perpCenterOffset = Math.abs(candidateCenterX - currentCenterX);
+          }
+
+          if (overlap > 0) {
+            aligned.push({ element: candidate, gap, perpCenterOffset });
+          } else {
+            const score = gap + FALLBACK_WEIGHT * perpCenterOffset;
+            fallback.push({ element: candidate, score, gap, perpCenterOffset });
+          }
+        }
+
+        if (aligned.length > 0) {
+          aligned.sort((a, b) => {
+            if (Math.abs(a.gap - b.gap) > TOLERANCE) {
+              return a.gap - b.gap;
+            }
+            return a.perpCenterOffset - b.perpCenterOffset;
+          });
+          return aligned[0].element;
+        }
+
+        if (fallback.length > 0) {
+          fallback.sort((a, b) => {
+            if (Math.abs(a.score - b.score) > TOLERANCE) {
+              return a.score - b.score;
+            }
+            if (Math.abs(a.gap - b.gap) > TOLERANCE) {
+              return a.gap - b.gap;
+            }
+            return a.perpCenterOffset - b.perpCenterOffset;
+          });
+          return fallback[0].element;
+        }
+
+        return null;
+      }
+
+      function initSpatialContainer(container) {
+        if (!(container instanceof HTMLElement) || initializedContainers.has(container)) {
+          return;
+        }
+        initializedContainers.add(container);
+
+        syncRovingTabindex(container);
+
+        container.addEventListener('focusin', (e) => {
+          const target = e.target;
+          if (!(target instanceof HTMLElement)) return;
+          const candidates = getCandidates(container);
+          if (candidates.includes(target)) {
+            syncRovingTabindex(container, target);
+          }
+        });
+
+        container.addEventListener('keydown', (e) => {
+          if (!ARROW_KEYS.has(e.key)) return;
+          if (e.defaultPrevented) return;
+          if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
+
+          const composedTarget = e.composedPath()[0] || e.target;
+          if (
+            composedTarget instanceof Element &&
+            composedTarget.matches(':read-write, select, input[type="range"], [role="slider"]')
+          ) {
+            return;
+          }
+
+          const candidates = getCandidates(container);
+          const current =
+            document.activeElement && document.activeElement !== document.body
+              ? document.activeElement
+              : e.target;
+          if (!(current instanceof HTMLElement) || !candidates.includes(current)) {
+            return;
+          }
+
+          const nextCandidate = findNextCandidate(current, candidates, e.key);
+          if (!nextCandidate) {
+            return;
+          }
+
+          e.preventDefault();
+          syncRovingTabindex(container, nextCandidate);
+          nextCandidate.focus();
+          nextCandidate.scrollIntoView({ block: 'nearest', inline: 'nearest' });
+        });
+
+        const mutationObserver = new MutationObserver(() => {
+          syncRovingTabindex(container);
+        });
+        mutationObserver.observe(container, {
+          childList: true,
+          subtree: true,
+          attributes: true,
+          attributeFilter: ['hidden', 'style', 'class', 'disabled', 'inert', 'aria-hidden']
+        });
+      }
+
+      function initAllGrids() {
+        document.querySelectorAll('.grid').forEach(initSpatialContainer);
+      }
+
+      document.addEventListener(
+        'keydown',
+        (e) => {
+          if (e.key === 'Tab') {
+            document.querySelectorAll('.grid').forEach((grid) => syncRovingTabindex(grid));
+          }
+        },
+        true
+      );
+
+      initAllGrids();
+
+      const bodyObserver = new MutationObserver(() => {
+        initAllGrids();
+      });
+      bodyObserver.observe(document.body, { childList: true, subtree: true });
+    })();
+  </script>
