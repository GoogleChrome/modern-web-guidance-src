+  <script>
+    const PRICING = {
+      'Maple Oat Latte': 5.50,
+      'Dark Roast Espresso': 3.75,
+      'Cold Brew': 4.75,
+      'Cappuccino': 4.50,
+      'Caramel Macchiato': 5.25
+    };
+
+    const SIZE_UPCHARGE = {
+      'Small': -0.50,
+      'Medium': 0.00,
+      'Large': 0.75
+    };
+
+    const orderForm = document.getElementById('coffee-order-form');
+    const orderResult = document.getElementById('order-result');
+    const orderResultTitle = document.getElementById('order-result-title');
+    const orderResultDetails = document.getElementById('order-result-details');
+
+    orderForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+
+      const formData = new FormData(orderForm);
+      const drink = formData.get('drink') || 'Maple Oat Latte';
+      const size = formData.get('size') || 'Medium';
+      const temperature = formData.get('temperature') || 'Hot';
+      const milk = formData.get('milk') || 'Oat Milk';
+      const customerName = (formData.get('customerName') || 'Guest').trim();
+      const notes = (formData.get('notes') || '').trim();
+
+      const basePrice = PRICING[drink] ?? 4.75;
+      const sizeDelta = SIZE_UPCHARGE[size] ?? 0;
+      const total = (basePrice + sizeDelta).toFixed(2);
+      const orderId = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+
+      const summaryText = `Order ${orderId} for ${customerName}: ${size} ${temperature} ${drink} with ${milk}${notes ? ` (${notes})` : ''} — Total: $${total}. Ready for pickup in ~5 minutes!`;
+
+      orderResultTitle.textContent = `Order Confirmed (${orderId})`;
+      orderResultDetails.textContent = summaryText;
+      orderResult.classList.add('visible');
+
+      const responsePayload = {
+        status: 'confirmed',
+        orderId,
+        customerName,
+        drink,
+        size,
+        temperature,
+        milk,
+        notes: notes || null,
+        totalPrice: `$${total}`,
+        estimatedPickupMinutes: 5,
+        message: summaryText
+      };
+
+      if (typeof e.respondWith === 'function') {
+        e.respondWith(Promise.resolve(responsePayload));
+      }
+    });
+  </script>
+
