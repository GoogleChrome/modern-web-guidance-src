+  <script>
+    (function () {
+      const MENU_CATALOG = [
+        {
+          name: 'Maple Oat Latte',
+          temperature: 'hot',
+          roast: 'medium',
+          defaultMilk: 'oat',
+          tags: ['maple', 'oat', 'sweet', 'creamy', 'autumn', 'seasonal'],
+          description: 'Creamy oat milk with a hint of Vermont maple syrup over balanced espresso.',
+          price: '$5.75'
+        },
+        {
+          name: 'Dark Roast Espresso',
+          temperature: 'hot',
+          roast: 'dark',
+          defaultMilk: 'none',
+          tags: ['smokey', 'bold', 'strong', 'rich', 'espresso', 'intense'],
+          description: 'Bold, smokey double shot crafted for a serious morning boost.',
+          price: '$3.50'
+        },
+        {
+          name: '18-Hour Cold Brew',
+          temperature: 'iced',
+          roast: 'dark',
+          defaultMilk: 'none',
+          tags: ['smooth', 'cold', 'chocolate', 'bold', 'refreshing'],
+          description: 'Steeped for 18 hours for maximum smoothness and low acidity.',
+          price: '$4.75'
+        },
+        {
+          name: 'Iced Caramel Cloud Macchiato',
+          temperature: 'iced',
+          roast: 'medium',
+          defaultMilk: 'whole',
+          tags: ['caramel', 'vanilla', 'sweet', 'creamy', 'iced'],
+          description: 'Chilled espresso layered with velvety milk, vanilla bean, and caramel drizzle.',
+          price: '$5.95'
+        },
+        {
+          name: 'Honey Almond Cortado',
+          temperature: 'hot',
+          roast: 'light',
+          defaultMilk: 'almond',
+          tags: ['honey', 'nutty', 'almond', 'floral', 'bright', 'citrus'],
+          description: 'Bright single-origin light roast cut with steamed toasted almond milk and wildflower honey.',
+          price: '$5.25'
+        },
+        {
+          name: 'Iced Coconut Mocha',
+          temperature: 'iced',
+          roast: 'medium',
+          defaultMilk: 'coconut',
+          tags: ['chocolate', 'cocoa', 'mocha', 'coconut', 'tropical', 'sweet'],
+          description: 'Rich dark cocoa and espresso shaken over ice with tropical coconut milk.',
+          price: '$5.85'
+        }
+      ];
+
+      const form = document.getElementById('coffee-finder-form');
+      const resultsBox = document.getElementById('finder-results');
+      const flavorInput = document.getElementById('flavor-query');
+
+      flavorInput.addEventListener('blur', () => {
+        if (flavorInput.value.length > 60) {
+          flavorInput.setCustomValidity('Flavor note must be 60 characters or fewer.');
+        }
+      });
+
+      flavorInput.addEventListener('input', () => {
+        flavorInput.setCustomValidity('');
+      });
+
+      function validateForm(formData) {
+        const errors = [];
+        const temp = formData.get('temperature');
+        const roast = formData.get('roast');
+        const flavor = (formData.get('flavor') || '').toString().trim();
+
+        if (!['hot', 'iced'].includes(temp)) {
+          errors.push({ field: 'temperature', message: 'Please choose hot or iced.' });
+        }
+        if (!['light', 'medium', 'dark'].includes(roast)) {
+          errors.push({ field: 'roast', message: 'Please choose light, medium, or dark roast.' });
+        }
+        if (flavor.length > 60) {
+          errors.push({ field: 'flavor', message: 'Flavor note must be 60 characters or fewer.' });
+        }
+        return errors;
+      }
+
+      function findRecommendations(formData) {
+        const temperature = formData.get('temperature');
+        const roast = formData.get('roast');
+        const milk = formData.get('milk') || 'oat';
+        const flavor = (formData.get('flavor') || '').toString().trim().toLowerCase();
+
+        const scored = MENU_CATALOG.map((item) => {
+          let score = 0;
+          if (item.temperature === temperature) score += 3;
+          if (item.roast === roast) score += 3;
+          if (item.defaultMilk === milk) score += 2;
+          if (flavor && (item.tags.some((t) => t.includes(flavor) || flavor.includes(t)) ||
+              item.name.toLowerCase().includes(flavor) ||
+              item.description.toLowerCase().includes(flavor))) {
+            score += 4;
+          }
+          return { item, score };
+        }).sort((a, b) => b.score - a.score);
+
+        const top = scored[0].item;
+        const runnerUp = scored[1].item;
+        const milkNote = milk === 'none' ? 'served black' : `prepared with ${milk} milk`;
+
+        return {
+          top,
+          runnerUp,
+          milkNote,
+          summaryText: `Recommended: ${top.name} (${top.price}, ${milkNote}) — ${top.description} Alternative: ${runnerUp.name} (${runnerUp.price}).`
+        };
+      }
+
+      function renderResult({ top, runnerUp, milkNote }) {
+        resultsBox.classList.remove('finder-error');
+        resultsBox.replaceChildren();
+
+        const heading = document.createElement('h3');
+        heading.textContent = `Top Match: ${top.name} (${top.price})`;
+
+        const desc = document.createElement('p');
+        desc.textContent = `${top.description} Customized for you: ${milkNote}.`;
+
+        const alt = document.createElement('p');
+        alt.style.marginTop = '0.5rem';
+        alt.style.fontSize = '0.9rem';
+        alt.textContent = `Also consider: ${runnerUp.name} (${runnerUp.price}) — ${runnerUp.description}`;
+
+        resultsBox.append(heading, desc, alt);
+        resultsBox.hidden = false;
+      }
+
+      function renderError(errorText) {
+        resultsBox.classList.add('finder-error');
+        resultsBox.replaceChildren();
+        const p = document.createElement('p');
+        p.textContent = errorText;
+        resultsBox.append(p);
+        resultsBox.hidden = false;
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+
+        const formData = new FormData(event.target);
+        const validationErrors = validateForm(formData);
+
+        if (validationErrors.length > 0) {
+          const errorString =
+            'Validation failed: ' +
+            validationErrors.map((err) => `${err.field} (${err.message})`).join(', ');
+          renderError(errorString);
+          if (event.agentInvoked && typeof event.respondWith === 'function') {
+            event.respondWith(Promise.resolve(errorString));
+          }
+          return;
+        }
+
+        const recommendation = findRecommendations(formData);
+        renderResult(recommendation);
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve(recommendation.summaryText));
+        }
+      });
+
+      const targetFor = (type, listener, options) =>
+        (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+          .addEventListener(type, listener, options);
+
+      targetFor('toolactivated', ({ toolName }) => {
+        console.log(`Tool "${toolName}" started execution.`);
+      });
+
+      targetFor('toolcancel', ({ toolName }) => {
+        console.log(`Tool "${toolName}" execution is cancelled.`);
+      });
+    })();
+  </script>
 </body>
 
 </html>
