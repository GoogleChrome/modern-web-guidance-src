+  <script>
+    const productCards = document.querySelectorAll('.product-card');
+
+    productCards.forEach((card) => {
+      let rect = card.getBoundingClientRect();
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const resizeObserver = new ResizeObserver(() => {
+          rect = card.getBoundingClientRect();
+        });
+        resizeObserver.observe(card);
+      }
+
+      const updatePointerPosition = (e) => {
+        const currentRect = rect.width > 0 && rect.height > 0 ? rect : card.getBoundingClientRect();
+        const x = currentRect.width > 0
+          ? `${((e.clientX - currentRect.left) / currentRect.width) * 100}%`
+          : `${e.clientX - currentRect.left}px`;
+        const y = currentRect.height > 0
+          ? `${((e.clientY - currentRect.top) / currentRect.height) * 100}%`
+          : `${e.clientY - currentRect.top}px`;
+
+        card.style.setProperty('--mouse-x', x);
+        card.style.setProperty('--mouse-y', y);
+      };
+
+      card.addEventListener('pointerenter', () => {
+        rect = card.getBoundingClientRect();
+      });
+      card.addEventListener('pointermove', updatePointerPosition);
+      card.addEventListener('mousemove', updatePointerPosition);
+    });
+  </script>
+
