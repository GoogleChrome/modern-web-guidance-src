+  <script>
+    (function () {
+      const lazyMediaElements = document.querySelectorAll('.lazy-media');
+
+      function hydrateMedia(mediaEl) {
+        if (mediaEl.dataset.loaded === 'true') return;
+        mediaEl.dataset.loaded = 'true';
+
+        if (mediaEl.dataset.poster) {
+          mediaEl.setAttribute('poster', mediaEl.dataset.poster);
+          mediaEl.removeAttribute('data-poster');
+        }
+
+        if (mediaEl.dataset.src) {
+          mediaEl.setAttribute('src', mediaEl.dataset.src);
+          mediaEl.removeAttribute('data-src');
+        }
+
+        const sources = mediaEl.querySelectorAll('source[data-src]');
+        sources.forEach(function (source) {
+          source.setAttribute('src', source.dataset.src);
+          source.removeAttribute('data-src');
+        });
+
+        if (mediaEl.dataset.preload) {
+          mediaEl.setAttribute('preload', mediaEl.dataset.preload);
+        }
+
+        mediaEl.load();
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          function (entries, obs) {
+            entries.forEach(function (entry) {
+              if (entry.isIntersecting) {
+                hydrateMedia(entry.target);
+                obs.unobserve(entry.target);
+              }
+            });
+          },
+          {
+            rootMargin: '200px 0px'
+          }
+        );
+
+        lazyMediaElements.forEach(function (el) {
+          observer.observe(el);
+        });
+      } else {
+        lazyMediaElements.forEach(hydrateMedia);
+      }
+    })();
+  </script>
