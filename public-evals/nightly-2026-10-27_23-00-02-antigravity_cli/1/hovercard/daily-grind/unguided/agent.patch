+  <script>
+    document.querySelectorAll('.hovercard-wrapper').forEach(wrapper => {
+      const card = wrapper.querySelector('.hovercard');
+      const priceEl = card.querySelector('.hovercard-price');
+      const calEl = card.querySelector('[data-calories]');
+      const cafEl = card.querySelector('[data-caffeine]');
+      const sizeButtons = card.querySelectorAll('.hovercard-size-btn');
+      let hideTimeout;
+
+      const showCard = () => {
+        clearTimeout(hideTimeout);
+        card.classList.add('is-visible');
+      };
+
+      const hideCard = () => {
+        hideTimeout = setTimeout(() => {
+          card.classList.remove('is-visible');
+        }, 120);
+      };
+
+      wrapper.addEventListener('mouseenter', showCard);
+      wrapper.addEventListener('mouseleave', hideCard);
+      wrapper.addEventListener('focusin', showCard);
+      wrapper.addEventListener('focusout', (e) => {
+        if (!wrapper.contains(e.relatedTarget)) {
+          hideCard();
+        }
+      });
+
+      sizeButtons.forEach(btn => {
+        btn.addEventListener('click', (e) => {
+          e.preventDefault();
+          e.stopPropagation();
+          sizeButtons.forEach(b => b.classList.remove('active'));
+          btn.classList.add('active');
+          if (priceEl && btn.dataset.price) {
+            priceEl.textContent = `$${btn.dataset.price}`;
+          }
+          if (calEl && btn.dataset.cal) {
+            calEl.textContent = btn.dataset.cal;
+          }
+          if (cafEl && btn.dataset.caf) {
+            cafEl.textContent = btn.dataset.caf;
+          }
+        });
+      });
+    });
+  </script>
+
