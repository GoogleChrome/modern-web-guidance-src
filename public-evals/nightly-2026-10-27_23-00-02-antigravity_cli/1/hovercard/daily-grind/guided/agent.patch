+    /* Hovercard & Interest Invokers */
+    [interestfor] {
+      --interest-delay-start: 0.2s;
+      interest-delay-start: var(--interest-delay-start);
+      --interest-delay-end: 0.1s;
+      interest-delay-end: var(--interest-delay-end);
+      interest-delay: 0.2s 0.1s;
+    }
+
+    :root:has(:is(:interest-source, .interest-source)) [interestfor] {
+      --interest-delay-start: 0s;
+      interest-delay-start: 0s;
+    }
+
+    [popover].hovercard {
+      position-area: block-end span-inline-end;
+      position-try-fallbacks: flip-block, flip-inline;
+      margin: 8px 0 0 0;
+      width: min(320px, 90vw);
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 10px;
+      padding: 16px;
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
+      text-align: left;
+      opacity: 0;
+      transform-origin: top;
+    }
+
+    [popover].hovercard:is(:popover-open, .\:popover-open) {
+      opacity: 1;
+      transform: translateY(0) scale(1);
+    }
+
+    @starting-style {
+      [popover].hovercard:is(:popover-open, .\:popover-open) {
+        opacity: 0;
+        transform: translateY(-10px) scale(0.95);
+      }
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      [popover].hovercard {
+        transition:
+          opacity,
+          transform,
+          display,
+          overlay;
+        transition-duration: 0.4s;
+        transition-behavior: allow-discrete;
+      }
+    }
+
+    .hovercard h4 {
+      color: var(--primary);
+      font-size: 1.15rem;
+      margin-bottom: 2px;
+    }
+
+    .hovercard .byline {
+      font-size: 0.85rem;
+      color: #6d4c41;
+      font-weight: 600;
+      margin-bottom: 10px;
+    }
+
+    .hovercard-body {
+      display: flex;
+      gap: 12px;
+      align-items: flex-start;
+    }
+
+    .hovercard-body img {
+      width: 84px;
+      height: 84px;
+      object-fit: cover;
+      border-radius: 6px;
+      flex-shrink: 0;
+    }
+
+    .hovercard-body p {
+      font-size: 0.88rem;
+      line-height: 1.45;
+    }
+
