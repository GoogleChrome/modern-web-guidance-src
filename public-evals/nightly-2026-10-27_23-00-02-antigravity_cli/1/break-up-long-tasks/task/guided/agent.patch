+
+    // Yield control to the main thread using scheduler.yield() with a setTimeout fallback
+    async function yieldToMain() {
+      if ('scheduler' in window && 'yield' in window.scheduler) {
+        await window.scheduler.yield();
+      } else {
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+    }
+
+    // Generate a large batch of coffee recipe blends
+    function generateRecipeBatch(count, roastLevel, brewMethod) {
+      const recipes = new Array(count);
+      for (let i = 0; i < count; i++) {
+        const primary = ORIGINS[i % ORIGINS.length];
+        const secondary = ORIGINS[(i * 7 + 3) % ORIGINS.length];
+        const tertiary = ORIGINS[(i * 13 + 5) % ORIGINS.length];
+        const primaryRatio = 0.45 + ((i * 17) % 35) / 100;
+        const secondaryRatio = (1 - primaryRatio) * 0.65;
+        const tertiaryRatio = 1 - primaryRatio - secondaryRatio;
+
+        recipes[i] = {
+          id: i + 1,
+          name: `Blend #${1000 + i}: ${primary.name.split(' ')[0]} & ${secondary.name.split(' ')[0]} Reserve`,
+          components: [
+            { bean: primary, ratio: primaryRatio },
+            { bean: secondary, ratio: secondaryRatio },
+            { bean: tertiary, ratio: tertiaryRatio }
+          ],
+          roastTempC: 196 + ((i * 23) % 28),
+          brewTimeSec: 25 + ((i * 31) % 215),
+          roastLevel,
+          brewMethod
+        };
+      }
+      return recipes;
+    }
+
+    // Perform intensive flavor compound extraction simulation for a single blend
+    function simulateBlendExtraction(recipe) {
+      const target = ROAST_PROFILES[recipe.roastLevel] || ROAST_PROFILES.medium;
+      const mod = BREW_MODIFIERS[recipe.brewMethod] || BREW_MODIFIERS.pourover;
+
+      let acidity = 0;
+      let body = 0;
+      let sweetness = 0;
+      let bitterness = 0;
+      let aroma = 0;
+
+      for (const comp of recipe.components) {
+        acidity += comp.bean.acidity * comp.ratio;
+        body += comp.bean.body * comp.ratio;
+        sweetness += comp.bean.sweetness * comp.ratio;
+        bitterness += comp.bean.bitterness * comp.ratio;
+        aroma += comp.bean.aroma * comp.ratio;
+      }
+
+      // Multi-step thermodynamic extraction curve modeling (non-trivial CPU work per blend)
+      let thermalFactor = 0;
+      for (let step = 1; step <= 450; step++) {
+        const tempRatio = (recipe.roastTempC + (step * 0.02)) / 210;
+        const extractionCurve = Math.sin(step * 0.045) * Math.cos(tempRatio * Math.PI * 0.5);
+        thermalFactor += Math.abs(extractionCurve) * 0.0022;
+      }
+
+      const normThermal = Math.min(1.15, Math.max(0.85, thermalFactor));
+      acidity = Math.min(100, Math.round(acidity * mod.acidity * (2 - normThermal * 0.85)));
+      body = Math.min(100, Math.round(body * mod.body * normThermal));
+      sweetness = Math.min(100, Math.round(sweetness * mod.sweetness * (1.02 - Math.abs(1 - normThermal))));
+      bitterness = Math.min(100, Math.round(bitterness * mod.bitterness * normThermal));
+      aroma = Math.min(100, Math.round(aroma * mod.aroma * (0.95 + (normThermal * 0.08))));
+
+      // Harmony score against target profile
+      const diff =
+        Math.abs(acidity - target.acidity) * 0.22 +
+        Math.abs(body - target.body) * 0.22 +
+        Math.abs(sweetness - target.sweetness) * 0.24 +
+        Math.abs(bitterness - target.bitterness) * 0.14 +
+        Math.abs(aroma - target.aroma) * 0.18;
+
+      const score = Math.max(0, Math.min(99.9, +(100 - diff).toFixed(1)));
+      const primaryBean = recipe.components[0].bean;
+      const secondaryBean = recipe.components[1].bean;
+
+      return {
+        id: recipe.id,
+        name: recipe.name,
+        notes: `${primaryBean.notes} • ${secondaryBean.notes.split(',')[0]}`,
+        ratios: `${Math.round(recipe.components[0].ratio * 100)}% / ${Math.round(recipe.components[1].ratio * 100)}% / ${Math.round(recipe.components[2].ratio * 100)}%`,
+        acidity,
+        body,
+        sweetness,
+        bitterness,
+        aroma,
+        score
+      };
+    }
