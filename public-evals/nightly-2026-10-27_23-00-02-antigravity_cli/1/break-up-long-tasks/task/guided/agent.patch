+    const BREW_MODIFIERS = {
+      espresso: { acidity: 0.95, body: 1.25, sweetness: 1.05, bitterness: 1.15, aroma: 1.1 },
+      pourover: { acidity: 1.15, body: 0.9, sweetness: 1.1, bitterness: 0.85, aroma: 1.2 },
