+        statusText.textContent = `Completed ${summary.total.toLocaleString()} blends with ${summary.yields} main-thread yields.`;
+      }
+    });
+
+    cancelBtn.addEventListener('click', () => {
+      isCancelled = true;
+    });
+  </script>
