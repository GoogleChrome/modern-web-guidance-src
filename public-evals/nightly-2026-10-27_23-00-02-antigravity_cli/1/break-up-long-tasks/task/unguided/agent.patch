+  <script>
+    (function () {
+      const ORIGINS = [
+        { name: 'Ethiopian Yirgacheffe', acidity: 88, body: 52, sweetness: 84, bitterness: 28, aroma: 92, notes: 'Jasmine, Bergamot, Peach' },
+        { name: 'Colombian Supremo', acidity: 68, body: 74, sweetness: 78, bitterness: 42, aroma: 76, notes: 'Caramel, Red Apple, Milk Chocolate' },
+        { name: 'Sumatra Mandheling', acidity: 38, body: 94, sweetness: 60, bitterness: 68, aroma: 72, notes: 'Dark Cocoa, Cedar, Earthy Spice' },
+        { name: 'Guatemalan Antigua', acidity: 72, body: 78, sweetness: 75, bitterness: 48, aroma: 82, notes: 'Toffee, Orange Zest, Roasted Hazelnut' },
+        { name: 'Brazilian Cerrado', acidity: 46, body: 82, sweetness: 80, bitterness: 54, aroma: 68, notes: 'Praline, Sweet Malt, Bittersweet Chocolate' },
+        { name: 'Kenyan AA', acidity: 92, body: 66, sweetness: 76, bitterness: 34, aroma: 89, notes: 'Blackcurrant, Grapefruit, Winey Berry' }
+      ];
+
+      const ROAST_MODIFIERS = {
+        light: { acidity: 1.15, body: 0.90, sweetness: 1.05, bitterness: 0.78, aroma: 1.12 },
+        medium: { acidity: 1.00, body: 1.02, sweetness: 1.08, bitterness: 0.96, aroma: 1.04 },
+        dark: { acidity: 0.76, body: 1.18, sweetness: 0.88, bitterness: 1.28, aroma: 0.92 }
+      };
+
+      const BREW_MODIFIERS = {
+        espresso: { acidity: 1.06, body: 1.22, sweetness: 1.04, bitterness: 1.12, aroma: 1.15 },
+        pourover: { acidity: 1.12, body: 0.88, sweetness: 1.08, bitterness: 0.85, aroma: 1.14 },
+        frenchpress: { acidity: 0.92, body: 1.16, sweetness: 0.98, bitterness: 1.06, aroma: 0.96 },
+        coldbrew: { acidity: 0.68, body: 1.08, sweetness: 1.14, bitterness: 0.72, aroma: 0.88 }
+      };
+
+      /**
+       * Yields control back to the browser main thread so rendering, input events,
+       * and animations remain responsive while processing large batches.
+       */
+      function yieldToMainThread() {
+        if (typeof globalThis.scheduler !== 'undefined' && typeof globalThis.scheduler.yield === 'function') {
+          return globalThis.scheduler.yield();
+        }
+        return new Promise((resolve) => {
+          setTimeout(resolve, 0);
+        });
+      }
+
+      function clamp(val, min, max) {
+        return Math.max(min, Math.min(max, val));
+      }
+
+      // Deterministic pseudo-random generator per recipe index so batches are rich and reproducible
+      function evaluateRecipeBlend(index, config) {
+        const o1 = index % ORIGINS.length;
+        const o2 = (index * 7 + 1) % ORIGINS.length;
+        const o3 = (index * 13 + 3) % ORIGINS.length;
+
+        const w1Raw = ((index * 37 + 17) % 60) + 20;
+        const w2Raw = ((index * 53 + 29) % 50) + 15;
+        const w3Raw = ((index * 71 + 11) % 40) + 10;
+        const totalW = w1Raw + w2Raw + w3Raw;
+
+        const r1 = w1Raw / totalW;
+        const r2 = w2Raw / totalW;
+        const r3 = w3Raw / totalW;
+
+        const b1 = ORIGINS[o1];
+        const b2 = ORIGINS[o2];
+        const b3 = ORIGINS[o3];
+
+        const roastMod = ROAST_MODIFIERS[config.roastLevel] || ROAST_MODIFIERS.medium;
+        const brewMod = BREW_MODIFIERS[config.brewMethod] || BREW_MODIFIERS.pourover;
+
+        // Multi-step thermodynamic extraction curve simulation per recipe
+        let extractionHarmony = 0;
+        for (let step = 1; step <= 18; step++) {
+          const tempFactor = Math.sin((index + step) * 0.17) * 2.4;
+          const solubility = Math.cos((w1Raw * step) * 0.09) * 1.8;
+          extractionHarmony += (tempFactor + solubility) / 18;
+        }
+
+        const acidity = clamp(
+          (b1.acidity * r1 + b2.acidity * r2 + b3.acidity * r3) * roastMod.acidity * brewMod.acidity + extractionHarmony,
+          5, 99
+        );
+        const body = clamp(
+          (b1.body * r1 + b2.body * r2 + b3.body * r3) * roastMod.body * brewMod.body - extractionHarmony * 0.5,
+          5, 99
+        );
+        const sweetness = clamp(
+          (b1.sweetness * r1 + b2.sweetness * r2 + b3.sweetness * r3) * roastMod.sweetness * brewMod.sweetness + extractionHarmony * 0.8,
+          5, 99
+        );
+        const bitterness = clamp(
+          (b1.bitterness * r1 + b2.bitterness * r2 + b3.bitterness * r3) * roastMod.bitterness * brewMod.bitterness,
+          5, 99
+        );
+        const aroma = clamp(
+          (b1.aroma * r1 + b2.aroma * r2 + b3.aroma * r3) * roastMod.aroma * brewMod.aroma,
+          5, 99
+        );
+
+        const diffAcidity = acidity - config.targetAcidity;
+        const diffBody = body - config.targetBody;
+        const diffSweetness = sweetness - config.targetSweetness;
+        const distance = Math.sqrt(
+          diffAcidity * diffAcidity * 0.35 +
+          diffBody * diffBody * 0.35 +
+          diffSweetness * diffSweetness * 0.30
+        );
+
+        const matchScore = clamp(100 - distance * 1.15 + (aroma - bitterness * 0.25) * 0.08, 1, 99.9);
+
+        const pct1 = Math.round(r1 * 100);
+        const pct2 = Math.round(r2 * 100);
+        const pct3 = Math.max(0, 100 - pct1 - pct2);
+
+        return {
+          id: index + 1,
+          name: `Blend #${index + 101} (${b1.name.split(' ')[0]} / ${b2.name.split(' ')[0]})`,
+          composition: `${pct1}% ${b1.name}, ${pct2}% ${b2.name}, ${pct3}% ${b3.name}`,
+          notes: `${b1.notes.split(',')[0]}, ${b2.notes.split(',')[1]?.trim() || b2.notes.split(',')[0]}`,
+          acidity: Math.round(acidity),
+          body: Math.round(body),
+          sweetness: Math.round(sweetness),
+          bitterness: Math.round(bitterness),
+          aroma: Math.round(aroma),
+          score: Number(matchScore.toFixed(1))
+        };
+      }
+
+      const batchSizeEl = document.getElementById('batch-size');
+      const roastLevelEl = document.getElementById('roast-level');
+      const brewMethodEl = document.getElementById('brew-method');
+      const targetAcidityEl = document.getElementById('target-acidity');
+      const targetBodyEl = document.getElementById('target-body');
+      const targetSweetnessEl = document.getElementById('target-sweetness');
+
+      const valAcidityEl = document.getElementById('val-acidity');
+      const valBodyEl = document.getElementById('val-body');
+      const valSweetnessEl = document.getElementById('val-sweetness');
+
+      const btnRunSim = document.getElementById('btn-run-sim');
+      const btnCancelSim = document.getElementById('btn-cancel-sim');
+      const statusTextEl = document.getElementById('sim-status-text');
+      const progressPctEl = document.getElementById('sim-progress-pct');
+      const progressBarEl = document.getElementById('sim-progress-bar');
+
+      const metricProcessedEl = document.getElementById('metric-processed');
+      const metricYieldsEl = document.getElementById('metric-yields');
+      const metricBestScoreEl = document.getElementById('metric-best-score');
+      const metricElapsedEl = document.getElementById('metric-elapsed');
+      const resultsGridEl = document.getElementById('blend-results-grid');
+
+      [
+        [targetAcidityEl, valAcidityEl],
+        [targetBodyEl, valBodyEl],
+        [targetSweetnessEl, valSweetnessEl]
+      ].forEach(([input, label]) => {
+        input.addEventListener('input', () => {
+          label.textContent = input.value;
+        });
+      });
+
+      let activeRunId = 0;
+
+      function renderTopBlends(topBlends) {
+        if (!topBlends || topBlends.length === 0) {
+          resultsGridEl.innerHTML = '';
+          return;
+        }
+
+        resultsGridEl.innerHTML = topBlends.map((blend, idx) => `
+          <article class="blend-card">
+            <span class="blend-rank">#${idx + 1} &bull; ${blend.score}% Match</span>
+            <h4>${blend.name}</h4>
+            <p class="blend-composition">${blend.composition}<br><em>Tasting Notes: ${blend.notes}</em></p>
+            <div class="flavor-bars">
+              <div class="flavor-row">
+                <span>Acidity</span>
+                <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.acidity}%"></div></div>
+                <span>${blend.acidity}</span>
+              </div>
+              <div class="flavor-row">
+                <span>Body</span>
+                <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.body}%"></div></div>
+                <span>${blend.body}</span>
+              </div>
+              <div class="flavor-row">
+                <span>Sweetness</span>
+                <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.sweetness}%"></div></div>
+                <span>${blend.sweetness}</span>
+              </div>
+              <div class="flavor-row">
+                <span>Aroma</span>
+                <div class="flavor-bar-bg"><div class="flavor-bar-fill" style="width: ${blend.aroma}%"></div></div>
+                <span>${blend.aroma}</span>
+              </div>
+            </div>
+          </article>
+        `).join('');
+      }
+
+      async function runBatchSimulation() {
+        const runId = ++activeRunId;
+        const totalRecipes = parseInt(batchSizeEl.value, 10) || 10000;
+        const config = {
+          roastLevel: roastLevelEl.value,
+          brewMethod: brewMethodEl.value,
+          targetAcidity: parseInt(targetAcidityEl.value, 10) || 65,
+          targetBody: parseInt(targetBodyEl.value, 10) || 75,
+          targetSweetness: parseInt(targetSweetnessEl.value, 10) || 85
+        };
+
+        btnRunSim.disabled = true;
+        btnCancelSim.disabled = false;
+        statusTextEl.textContent = `Simulating ${totalRecipes.toLocaleString()} recipe blends...`;
+
+        const startTime = performance.now();
+        let processed = 0;
+        let yieldCount = 0;
+        const topBlends = [];
+        const TOP_K = 6;
+
+        // Time budget per task chunk (< 12ms) and max items per chunk (250) to avoid long tasks (>50ms)
+        const TIME_BUDGET_MS = 10;
+        const MAX_ITEMS_PER_CHUNK = 250;
+
+        let sliceStart = performance.now();
+
+        while (processed < totalRecipes) {
+          if (runId !== activeRunId) {
+            return;
+          }
+
+          let itemsInChunk = 0;
+          while (
+            processed < totalRecipes &&
+            itemsInChunk < MAX_ITEMS_PER_CHUNK &&
+            (performance.now() - sliceStart) < TIME_BUDGET_MS
+          ) {
+            const candidate = evaluateRecipeBlend(processed, config);
+            processed++;
+            itemsInChunk++;
+
+            if (topBlends.length < TOP_K || candidate.score > topBlends[topBlends.length - 1].score) {
+              topBlends.push(candidate);
+              topBlends.sort((a, b) => b.score - a.score);
+              if (topBlends.length > TOP_K) {
+                topBlends.pop();
+              }
+            }
+          }
+
+          const pct = Math.round((processed / totalRecipes) * 100);
+          const elapsed = Math.round(performance.now() - startTime);
+
+          progressPctEl.textContent = `${pct}%`;
+          progressBarEl.style.width = `${pct}%`;
+          metricProcessedEl.textContent = processed.toLocaleString();
+          metricYieldsEl.textContent = yieldCount.toLocaleString();
+          metricBestScoreEl.textContent = topBlends.length > 0 ? `${topBlends[0].score}%` : '--';
+          metricElapsedEl.textContent = `${elapsed} ms`;
+
+          if (processed < totalRecipes) {
+            yieldCount++;
+            metricYieldsEl.textContent = yieldCount.toLocaleString();
+            await yieldToMainThread();
+            sliceStart = performance.now();
+          }
+        }
+
+        if (runId !== activeRunId) {
+          return;
+        }
+
+        renderTopBlends(topBlends);
+        statusTextEl.textContent = `Completed ${totalRecipes.toLocaleString()} recipe blends across ${yieldCount} main-thread yields.`;
+        btnRunSim.disabled = false;
+        btnCancelSim.disabled = true;
+      }
+
+      btnRunSim.addEventListener('click', () => {
+        runBatchSimulation();
+      });
+
+      btnCancelSim.addEventListener('click', () => {
+        activeRunId++;
+        btnRunSim.disabled = false;
+        btnCancelSim.disabled = true;
+        statusTextEl.textContent = 'Simulation cancelled.';
+      });
+
+      // Run an initial batch on load so top blends are immediately populated
+      runBatchSimulation();
+    })();
+  </script>
