+
+      function closeDrinkModal() {
+        if (modal.open) {
+          if (typeof modal.close === 'function') {
+            modal.close();
+          } else {
+            modal.removeAttribute('open');
+          }
+        }
+        document.body.classList.remove('modal-open');
+        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
+          lastFocusedElement.focus();
+        }
+      }
+
+      triggerButtons.forEach((btn) => {
+        btn.addEventListener('click', (event) => {
+          event.preventDefault();
+          const drinkKey = btn.getAttribute('data-drink') || 'maple-oat-latte';
+          openDrinkModal(drinkKey, btn);
+        });
+      });
+
+      drinkSelect.addEventListener('change', () => {
+        populateModal(drinkSelect.value, false);
+      });
+
+      orderForm.addEventListener('change', updateTotalPrice);
+      quantityInput.addEventListener('input', updateTotalPrice);
+
+      closeBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        closeDrinkModal();
+      });
+
+      cancelBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        closeDrinkModal();
+      });
+
+      // Light dismiss when clicking on the dialog backdrop
+      modal.addEventListener('click', (event) => {
+        if (event.target === modal) {
+          closeDrinkModal();
+        }
+      });
+
+      // Focus trap and keyboard dismissal fallback
+      modal.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape') {
+          event.preventDefault();
+          closeDrinkModal();
+          return;
+        }
+
+        if (event.key === 'Tab' && modal.open) {
+          const focusable = Array.from(
+            modal.querySelectorAll(
+              'button:not([disabled]), select:not([disabled]), input:not([disabled]), textarea:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'
+            )
+          ).filter((el) => {
+            if (el.type === 'radio' && el.name) {
+              const checked = modal.querySelector(`input[type="radio"][name="${el.name}"]:checked`);
+              return !checked || checked === el;
+            }
+            return el.offsetParent !== null;
+          });
+
+          if (focusable.length === 0) return;
+
+          const first = focusable[0];
+          const last = focusable[focusable.length - 1];
+
+          if (event.shiftKey && document.activeElement === first) {
+            event.preventDefault();
+            last.focus();
+          } else if (!event.shiftKey && document.activeElement === last) {
+            event.preventDefault();
+            first.focus();
+          }
+        }
+      });
+
+      // Restore focus whenever the dialog closes (including native Escape / closedby="any" / command="close")
+      modal.addEventListener('close', () => {
+        document.body.classList.remove('modal-open');
+        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
+          lastFocusedElement.focus();
