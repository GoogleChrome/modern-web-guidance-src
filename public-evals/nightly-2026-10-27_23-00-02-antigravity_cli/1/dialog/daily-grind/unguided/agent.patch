+      const triggerButtons = document.querySelectorAll('[data-drink]');
+
+      let lastFocusedElement = null;
+      let statusTimer = null;
+
+      function getSelectedSizeMod() {
+        const checkedSize = orderForm.querySelector('input[name="size"]:checked');
+        return checkedSize ? parseFloat(checkedSize.dataset.priceMod || '0') : 0;
+      }
+
+      function updateTotalPrice() {
+        const drinkKey = drinkSelect.value;
+        const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+        const sizeMod = getSelectedSizeMod();
+        const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
+        const unitPrice = Math.max(0, drink.price + sizeMod);
+        const total = (unitPrice * qty).toFixed(2);
+        submitBtn.textContent = `Add to Order \u2014 $${total}`;
+      }
+
+      function populateModal(drinkKey, resetOptions = true) {
+        const key = DRINKS[drinkKey] ? drinkKey : 'maple-oat-latte';
+        const drink = DRINKS[key];
+
+        drinkSelect.value = key;
+        modalTitle.textContent = drink.name;
+        modalBadge.textContent = drink.badge;
+        modalDescription.textContent = drink.description;
+        modalBasePrice.textContent = `$${drink.price.toFixed(2)}`;
+        modalNotes.textContent = drink.notes;
+        modalCaffeine.textContent = drink.caffeine;
+        modalImage.src = drink.image;
+        modalImage.alt = drink.imageAlt;
+
+        if (resetOptions) {
+          milkSelect.value = drink.defaultMilk;
+          tempSelect.value = drink.defaultTemp;
+          quantityInput.value = '1';
+          const mediumRadio = orderForm.querySelector('input[name="size"][value="Medium"]');
+          if (mediumRadio) mediumRadio.checked = true;
+        }
+
+        updateTotalPrice();
+      }
+
+      function openDrinkModal(drinkKey, triggerEl) {
+        lastFocusedElement = triggerEl || document.activeElement;
