+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+    }
+
+    const DRINKS = {
+      'maple-oat-latte': {
+        name: 'Maple Oat Latte',
+        description: 'Velvety steamed oat milk paired with our signature double-shot espresso and pure grade-A Vermont maple syrup, finished with a dash of cinnamon.',
+        price: '$5.75',
+        calories: '210 kcal',
+        notes: 'Toasted oats, caramelized maple, warm spice.',
+        defaultMilk: 'Oat Milk'
+      },
+      'dark-roast-espresso': {
+        name: 'Dark Roast Espresso',
+        description: 'A rich, full-bodied double shot pulled from slow-roasted Sumatra and Colombian beans for a bold, smokey crema and lingering dark-chocolate finish.',
+        price: '$3.75',
+        calories: '15 kcal',
+        notes: 'Dark cacao, roasted walnut, smokey cedar.',
+        defaultMilk: 'None (Black)'
+      },
+      'cold-brew': {
+        name: 'Cold Brew',
+        description: 'Coarse-ground single-origin Ethiopian beans steeped in filtered cold water for 18 hours, yielding an ultra-smooth, low-acidity brew served over ice.',
+        price: '$4.75',
+        calories: '10 kcal',
+        notes: 'Sweet molasses, cocoa nibs, crisp finish.',
+        defaultMilk: 'None (Black)'
+      }
+    };
+
+    const dialog = document.getElementById('drink-order-dialog');
+    const titleEl = document.getElementById('drink-dialog-title');
+    const descEl = document.getElementById('drink-dialog-desc');
+    const priceEl = document.getElementById('drink-dialog-price');
+    const caloriesEl = document.getElementById('drink-dialog-calories');
+    const notesEl = document.getElementById('drink-dialog-notes');
+    const drinkSelect = document.getElementById('drink-select');
+    const milkSelect = document.getElementById('milk-select');
+    const qtyInput = document.getElementById('drink-qty');
+    const statusEl = document.getElementById('order-status');
+
+    function populateDrinkDetails(drinkKey) {
+      const drink = DRINKS[drinkKey] || DRINKS['maple-oat-latte'];
+      titleEl.textContent = drink.name;
+      descEl.textContent = drink.description;
+      priceEl.textContent = drink.price;
+      caloriesEl.textContent = drink.calories;
+      notesEl.innerHTML = `<strong>Tasting Notes:</strong> ${drink.notes}`;
+      drinkSelect.value = drinkKey in DRINKS ? drinkKey : 'maple-oat-latte';
+      milkSelect.value = drink.defaultMilk;
+    }
+
+    drinkSelect.addEventListener('change', (e) => {
+      populateDrinkDetails(e.target.value);
+    });
+
+    document.querySelectorAll('button[commandfor="drink-order-dialog"]').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const action = btn.getAttribute('command');
+        if (action === 'show-modal') {
+          const drinkKey = btn.dataset.drink || 'maple-oat-latte';
+          populateDrinkDetails(drinkKey);
+          qtyInput.value = '1';
+          if (!('commandForElement' in HTMLButtonElement.prototype) && !dialog.open) {
+            dialog.showModal();
+          }
+        } else if (action === 'close' && !('commandForElement' in HTMLButtonElement.prototype) && dialog.open) {
+          dialog.close();
+        }
+      });
+    });
+
+    dialog.addEventListener('close', () => {
+      const choice = dialog.returnValue;
+      dialog.returnValue = '';
+      if (choice === 'order') {
+        const drink = DRINKS[drinkSelect.value] || DRINKS['maple-oat-latte'];
+        const sizeEl = dialog.querySelector('input[name="size"]:checked');
+        const size = sizeEl ? sizeEl.value : 'Medium (16 oz)';
+        const qty = qtyInput.value || '1';
+        statusEl.textContent = `Added ${qty} × ${size} ${drink.name} (${milkSelect.value}) to your order.`;
+      }
+    });
+
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      const outside = (e, dlg) => {
+        const r = dlg.getBoundingClientRect();
+        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
+      };
+      let pressedOutside = false;
+      dialog.addEventListener('pointerdown', (e) => {
+        if (e.target === dialog) {
+          pressedOutside = outside(e, dialog);
+        } else {
+          pressedOutside = false;
+        }
+      });
+      dialog.addEventListener('pointerup', (e) => {
+        if (pressedOutside && e.target === dialog && outside(e, dialog)) {
+          dialog.close();
+        }
+        pressedOutside = false;
+      });
+    }
+  </script>
+
