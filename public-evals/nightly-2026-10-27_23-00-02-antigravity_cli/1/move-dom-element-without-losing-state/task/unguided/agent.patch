+  <script>
+    const theaterBtn = document.getElementById('theater-mode-btn');
+    const iframe = document.getElementById('roasting-video');
+    const heroSection = document.querySelector('.hero');
+    const videoWrapper = document.getElementById('video-wrapper');
+    let isTheaterMode = false;
+
+    function reparentElement(parent, element) {
+      if (typeof parent.moveBefore === 'function') {
+        parent.moveBefore(element, null);
+      } else {
+        parent.appendChild(element);
+      }
+    }
+
+    theaterBtn.addEventListener('click', () => {
+      isTheaterMode = !isTheaterMode;
+      const targetParent = isTheaterMode ? heroSection : videoWrapper;
+
+      reparentElement(targetParent, iframe);
+
+      theaterBtn.setAttribute('aria-pressed', String(isTheaterMode));
+      theaterBtn.textContent = isTheaterMode ? 'Exit Theater Mode' : 'Theater Mode';
+    });
+  </script>
