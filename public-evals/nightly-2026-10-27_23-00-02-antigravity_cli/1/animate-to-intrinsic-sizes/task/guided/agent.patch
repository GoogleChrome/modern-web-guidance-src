+  <script type="module">
+    // Conditionally load the invokers-polyfill only in browsers lacking native support
+    const hasNativeSupport = 'commandForElement' in HTMLButtonElement.prototype;
+    if (!hasNativeSupport) {
+      (async () => {
+        try {
+          await import('https://esm.run/invokers-polyfill');
+        } catch (err) {
+          console.error('Error loading fallback:', err);
+        }
+      })();
+    }
+
+    const promoAlert = document.getElementById('promo-alert');
+    const alertDismiss = document.getElementById('alert-dismiss');
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+
+    // Dismiss promo alert via Invoker Commands or click fallback
+    const dismissAlert = () => {
+      if (!promoAlert || promoAlert.classList.contains('is-dismissed')) return;
+      promoAlert.classList.add('is-dismissed');
+    };
+
+    promoAlert?.addEventListener('command', (event) => {
+      if (event.command === '--dismiss') {
+        dismissAlert();
+      }
+    });
+
+    alertDismiss?.addEventListener('click', dismissAlert);
+
+    // MANDATORY Accessibility Synchronization: Ensure elements collapsed to zero dimensions are removed from the assistive technology tree
+    promoAlert?.addEventListener('transitionend', (e) => {
+      if (e.propertyName === 'block-size' && promoAlert.classList.contains('is-dismissed')) {
+        promoAlert.hidden = true;
+      }
+    });
+
+    // Sync aria-expanded and optional custom command on #faq-trigger / #faq-content
+    const parentDetails = faqTrigger?.closest('details');
+    if (parentDetails) {
+      parentDetails.addEventListener('toggle', () => {
+        const isOpen = parentDetails.open;
+        faqTrigger.setAttribute('aria-expanded', String(isOpen));
+        faqContent?.classList.toggle('is-expanded', isOpen);
+      });
+    } else if (faqTrigger && faqContent) {
+      faqContent.addEventListener('command', (event) => {
+        if (event.command === '--toggle') {
+          const isExpanded = faqContent.classList.toggle('is-expanded');
+          faqTrigger.setAttribute('aria-expanded', String(isExpanded));
+        }
+      });
+    }
+  </script>
