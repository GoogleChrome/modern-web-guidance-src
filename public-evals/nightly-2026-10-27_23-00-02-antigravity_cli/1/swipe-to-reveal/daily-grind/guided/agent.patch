+    .SwipeReveal {
+      /* Column 1: full-width content. Column 2: auto-sized actions or side menu. */
+      display: grid;
+      grid-template-columns: 100% max-content;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      scrollbar-width: none;
+
+      /* Prevent the swipe wrapper and revealed panel from bouncing locally while
+         still chaining excess scroll into the parent scroller (the document). */
+      overscroll-behavior: auto;
+      overscroll-behavior: chain;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .SwipeReveal {
+        scroll-behavior: smooth;
+      }
+    }
+
+    .SwipeReveal-content {
+      scroll-snap-align: start;
+      scroll-initial-target: nearest;
+      background: Canvas;
+      background-color: white;
+      padding: 20px;
+    }
+
+    .SwipeReveal-content:focus-visible {
+      outline: auto;
+      outline-offset: -2px;
+    }
+
+    .SwipeReveal-panel {
+      scroll-snap-align: end;
+      display: flex;
+
+      &:first-child {
+        scroll-snap-align: start;
+      }
+    }
+
+    .SwipeReveal-panel button {
+      border: none;
+      padding: 0 18px;
+      font-family: inherit;
+      font-size: 0.9rem;
+      font-weight: 600;
+      cursor: pointer;
+      color: white;
+      background: var(--primary);
+      transition: filter 0.2s, background-color 0.2s;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      white-space: nowrap;
+    }
+
+    .SwipeReveal-panel button + button {
+      border-left: 1px solid rgba(255, 255, 255, 0.2);
+    }
+
+    .SwipeReveal-panel button.action-customize {
+      background: #6d4c41;
+    }
+
+    .SwipeReveal-panel button.action-favorite {
+      background: var(--accent);
+      color: var(--text);
+    }
+
+    .SwipeReveal-panel button:hover,
+    .SwipeReveal-panel button:focus-visible {
+      filter: brightness(0.92);
+    }
+
+    .SwipeReveal-panel button:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: -2px;
+    }
+
