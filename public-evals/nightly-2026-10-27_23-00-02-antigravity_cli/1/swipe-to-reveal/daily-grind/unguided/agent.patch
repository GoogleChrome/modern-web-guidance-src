+  <script>
+    (function () {
+      const ACTION_WIDTH = 170;
+      const SWIPE_THRESHOLD = 45;
+      const cards = document.querySelectorAll('.card[data-drink]');
+      const feedbackEl = document.getElementById('action-feedback');
+      let feedbackTimeout = null;
+
+      function showFeedback(message) {
+        if (!feedbackEl) return;
+        feedbackEl.textContent = message;
+        feedbackEl.classList.add('visible');
+        clearTimeout(feedbackTimeout);
+        feedbackTimeout = setTimeout(() => {
+          feedbackEl.classList.remove('visible');
+        }, 2500);
+      }
+
+      function closeCard(card) {
+        const content = card.querySelector('.card-content');
+        if (!content) return;
+        card.dataset.open = 'false';
+        content.style.transform = 'translateX(0px)';
+      }
+
+      function openCard(card) {
+        cards.forEach((other) => {
+          if (other !== card) closeCard(other);
+        });
+        const content = card.querySelector('.card-content');
+        if (!content) return;
+        card.dataset.open = 'true';
+        content.style.transform = `translateX(-${ACTION_WIDTH}px)`;
+      }
+
+      cards.forEach((card) => {
+        const content = card.querySelector('.card-content');
+        const drinkName = card.dataset.drink;
+        let startX = 0;
+        let startY = 0;
+        let currentOffset = 0;
+        let baseOffset = 0;
+        let isDragging = false;
+        let isHorizontalSwipe = null;
+
+        function onStart(clientX, clientY) {
+          startX = clientX;
+          startY = clientY;
+          baseOffset = card.dataset.open === 'true' ? -ACTION_WIDTH : 0;
+          currentOffset = baseOffset;
+          isDragging = true;
+          isHorizontalSwipe = null;
+          content.classList.add('dragging');
+        }
+
+        function onMove(clientX, clientY, event) {
+          if (!isDragging) return;
+          const deltaX = clientX - startX;
+          const deltaY = clientY - startY;
+
+          if (isHorizontalSwipe === null) {
+            if (Math.abs(deltaX) > 6 || Math.abs(deltaY) > 6) {
+              isHorizontalSwipe = Math.abs(deltaX) > Math.abs(deltaY);
+            }
+          }
+
+          if (isHorizontalSwipe === false) {
+            isDragging = false;
+            content.classList.remove('dragging');
+            return;
+          }
+
+          if (isHorizontalSwipe && event && event.cancelable) {
+            event.preventDefault();
+          }
+
+          const nextOffset = Math.min(0, Math.max(-ACTION_WIDTH, baseOffset + deltaX));
+          currentOffset = nextOffset;
+          content.style.transform = `translateX(${currentOffset}px)`;
+        }
+
+        function onEnd() {
+          if (!isDragging) return;
+          isDragging = false;
+          content.classList.remove('dragging');
+
+          const deltaFromBase = currentOffset - baseOffset;
+          if (baseOffset === 0 && deltaFromBase < -SWIPE_THRESHOLD) {
+            openCard(card);
+          } else if (baseOffset < 0 && deltaFromBase > SWIPE_THRESHOLD) {
+            closeCard(card);
+          } else if (currentOffset <= -ACTION_WIDTH / 2) {
+            openCard(card);
+          } else {
+            closeCard(card);
+          }
+        }
+
+        // Touch events
+        content.addEventListener('touchstart', (e) => {
+          if (e.touches.length !== 1) return;
+          onStart(e.touches[0].clientX, e.touches[0].clientY);
+        }, { passive: true });
+
+        content.addEventListener('touchmove', (e) => {
+          if (!isDragging || e.touches.length !== 1) return;
+          onMove(e.touches[0].clientX, e.touches[0].clientY, e);
+        }, { passive: false });
+
+        content.addEventListener('touchend', onEnd);
+        content.addEventListener('touchcancel', onEnd);
+
+        // Mouse / Pointer events for desktop drag support
+        content.addEventListener('mousedown', (e) => {
+          if (e.button !== 0) return;
+          onStart(e.clientX, e.clientY);
+        });
+
+        window.addEventListener('mousemove', (e) => {
+          if (!isDragging) return;
+          onMove(e.clientX, e.clientY, e);
+        });
+
+        window.addEventListener('mouseup', () => {
+          if (!isDragging) return;
+          onEnd();
+        });
+
+        // Prevent accidental link click right after dragging horizontally
+        content.addEventListener('click', (e) => {
+          if (isHorizontalSwipe) {
+            e.preventDefault();
+            e.stopPropagation();
+            isHorizontalSwipe = null;
+          }
+        }, true);
+
+        // Contextual action button handlers (only executed when explicitly clicked)
+        const actionButtons = card.querySelectorAll('.action-btn');
+        actionButtons.forEach((btn) => {
+          btn.addEventListener('click', () => {
+            const action = btn.dataset.action;
+            if (action === 'add') {
+              showFeedback(`Added ${drinkName} to your order.`);
+              closeCard(card);
+            } else if (action === 'favorite') {
+              const isFav = btn.classList.toggle('is-favorited');
+              btn.setAttribute('aria-pressed', String(isFav));
+              const icon = btn.querySelector('.action-icon');
+              const label = btn.querySelector('.action-label');
+              if (icon) icon.innerHTML = isFav ? '&#9733;' : '&#9734;';
+              if (label) label.textContent = isFav ? 'Saved' : 'Favorite';
+              showFeedback(isFav ? `Saved ${drinkName} to favorites.` : `Removed ${drinkName} from favorites.`);
+            }
+          });
+        });
+      });
+
+      // Close open swipe actions when clicking outside the cards
+      document.addEventListener('click', (e) => {
+        if (!e.target.closest('.card[data-drink]')) {
+          cards.forEach(closeCard);
+        }
+      });
+    })();
+  </script>
 </body>
 
