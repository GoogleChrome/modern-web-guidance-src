+        if (!target || target.tagName === 'TEXTAREA' || target.tagName === 'BUTTON') return;
+
+        if (currentStepIndex < steps.length - 1) {
+          e.preventDefault();
+          if (validateStep(currentStepIndex)) {
+            goToStep(currentStepIndex + 1, true);
+          }
+        }
+      });
+
+      // 6. Final Form Submission with Double-Post Protection & Safe DOM Updates
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+
+        // Check honeypot spam protection
+        const honeypot = document.getElementById('bot-honeypot');
+        if (honeypot && honeypot.value.trim() !== '') {
+          return;
+        }
+
+        // Validate all steps in order
+        for (let idx = 0; idx < steps.length; idx++) {
+          steps[idx].disabled = false;
+          if (!validateStep(idx)) {
+            if (idx !== currentStepIndex) {
+              goToStep(idx, false);
+            }
+            return;
+          }
+        }
+
+        // Disable submit and navigation buttons after valid submission to prevent double-posts
+        submitBtn.disabled = true;
+        prevBtn.disabled = true;
+        submitBtn.textContent = 'Creating Rewards Account...';
+
+        const formData = new FormData(form);
+        const rawName = String(formData.get('full_name') || '').trim();
+        const rawEmail = String(formData.get('email') || '').trim();
+
+        // Update page title and status safely via textContent (never innerHTML) to prevent XSS
+        document.title = 'Welcome to Rewards | The Daily Grind';
+        showLiveBanner(
+          `Welcome to The Daily Grind Rewards, ${rawName}! A confirmation email has been sent to ${rawEmail}.`,
+          'success'
+        );
+
+        indicators.forEach((indEl) => {
+          indEl.classList.remove('step-active');
+          indEl.classList.add('step-done');
+          indEl.removeAttribute('aria-current');
+        });
+
+        submitBtn.textContent = 'Rewards Account Created';
+        liveStatus.focus?.();
+      });
+    })();
+  </script>
