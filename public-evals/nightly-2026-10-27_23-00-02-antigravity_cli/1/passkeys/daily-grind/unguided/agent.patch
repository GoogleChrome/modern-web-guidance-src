+          li.dataset.credentialId = pk.credentialId;
+
+          const meta = document.createElement('div');
+          meta.className = 'passkey-meta';
+          const title = document.createElement('strong');
+          title.textContent = pk.name;
+          const details = document.createElement('span');
+          const shortId = pk.credentialId.slice(0, 10) + '...';
+          const createdDate = new Date(pk.createdAt).toLocaleDateString();
+          const lastUsed = pk.lastUsedAt ? new Date(pk.lastUsedAt).toLocaleString() : 'Never';
+          details.textContent = `ID: ${shortId} • Created: ${createdDate} • Last used: ${lastUsed}`;
+          meta.appendChild(title);
+          meta.appendChild(details);
+
+          const actions = document.createElement('div');
+          actions.className = 'btn-row';
+          actions.style.marginTop = '0';
+
+          const renameBtn = document.createElement('button');
+          renameBtn.type = 'button';
+          renameBtn.className = 'btn secondary small';
+          renameBtn.textContent = 'Rename';
+          renameBtn.addEventListener('click', () => handleRenamePasskey(pk.credentialId));
+
+          const deleteBtn = document.createElement('button');
+          deleteBtn.type = 'button';
+          deleteBtn.className = 'btn danger small';
+          deleteBtn.textContent = 'Remove';
+          deleteBtn.addEventListener('click', () => handleRemovePasskey(pk.credentialId));
+
+          actions.appendChild(renameBtn);
+          actions.appendChild(deleteBtn);
+
+          li.appendChild(meta);
+          li.appendChild(actions);
+          passkeyListEl.appendChild(li);
+        });
+      }
+
+      function renderAccountUI() {
+        const user = getCurrentUser();
+        const session = loadSession();
+
+        if (user && session) {
+          unauthView.classList.add('hidden');
+          authView.classList.remove('hidden');
+          sessionBadge.textContent = `Signed in as ${user.name}`;
+          sessionBadge.className = 'badge success';
+          navLogoutLink.textContent = 'Logout';
+
+          document.getElementById('profile-name').value = user.name || '';
+          document.getElementById('profile-email').value = user.email || '';
+          document.getElementById('profile-phone').value = user.phone || '';
+          document.getElementById('profile-drink').value = user.favoriteDrink || 'Maple Oat Latte';
+
+          if (session.lastReauthAt) {
+            const ageSec = Math.round((Date.now() - session.lastReauthAt) / 1000);
+            reauthTimestampEl.textContent = `Last passkey verification: ${ new Date(session.lastReauthAt).toLocaleTimeString() } (${ageSec}s ago)`;
+          } else {
+            reauthTimestampEl.textContent = 'Passkey verification required for sensitive changes.';
+          }
+
+          renderPasskeyList(user);
+        } else {
+          unauthView.classList.remove('hidden');
+          authView.classList.add('hidden');
+          sessionBadge.textContent = 'Signed Out';
+          sessionBadge.className = 'badge';
+          navLogoutLink.textContent = 'Sign In';
+        }
+      }
+
+      // Require step-up reauthentication before executing callback
+      function requireReauthentication(reasonText, onVerifiedCallback) {
+        reauthModalDesc.textContent = reasonText || 'Please verify your identity with your passkey to continue.';
+        pendingReauthAction = onVerifiedCallback;
+        reauthModal.classList.remove('hidden');
+      }
+
+      async function executeReauthentication() {
+        const user = getCurrentUser();
+        if (!user) return;
+        try {
+          const usedCredId = await verifyPasskeyAssertion(user);
+          const users = loadUsers();
+          const idx = users.findIndex(u => u.id === user.id);
+          if (idx !== -1) {
+            const pk = users[idx].passkeys.find(p => p.credentialId === usedCredId) || users[idx].passkeys[0];
+            if (pk) pk.lastUsedAt = new Date().toISOString();
+            saveUsers(users);
+          }
+
+          const session = loadSession() || { userId: user.id };
+          session.lastReauthAt = Date.now();
+          saveSession(session);
+
+          reauthModal.classList.add('hidden');
+          const action = pendingReauthAction;
+          pendingReauthAction = null;
+
+          if (typeof action === 'function') {
+            action();
+          } else {
+            showStatus('Passkey reauthentication successful. Session security elevated.', 'success');
+          }
+          renderAccountUI();
+        } catch (err) {
+          showStatus(err.message || 'Passkey reauthentication failed.', 'error');
+        }
+      }
+
+      btnConfirmReauth.addEventListener('click', executeReauthentication);
+      btnCancelReauth.addEventListener('click', () => {
+        pendingReauthAction = null;
+        reauthModal.classList.add('hidden');
+        showStatus('Reauthentication cancelled.', 'info');
+      });
+
+      // 1. Customer Registration with Passkey
+      registerForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const name = document.getElementById('reg-name').value.trim();
+        const email = document.getElementById('reg-email').value.trim().toLowerCase();
+        const favoriteDrink = document.getElementById('reg-drink').value;
+        const passkeyLabel = document.getElementById('reg-passkey-label').value.trim();
+
+        if (!name || !email) {
+          showStatus('Please provide both your name and email address.', 'error');
+          return;
+        }
+
+        const users = loadUsers();
+        if (users.some(u => u.email.toLowerCase() === email)) {
+          showStatus('An account with that email already exists. Please sign in with your passkey.', 'error');
+          return;
+        }
+
+        const newUser = {
+          id: bufferToBase64Url(randomBytes(16)),
+          name,
+          email,
+          phone: '',
+          favoriteDrink,
+          passkeys: []
+        };
+
+        try {
+          const passkey = await createPasskeyCredential(newUser, passkeyLabel || `${name}'s Passkey`);
+          newUser.passkeys.push(passkey);
+          users.push(newUser);
+          saveUsers(users);
+
+          saveSession({
+            userId: newUser.id,
+            authenticatedAt: Date.now(),
+            lastReauthAt: Date.now()
+          });
+
+          registerForm.reset();
+          renderAccountUI();
+          showStatus(`Welcome to The Daily Grind, ${name}! Your passkey "${passkey.name}" has been registered.`, 'success');
+        } catch (err) {
+          showStatus(err.message || 'Could not register passkey.', 'error');
+        }
+      });
+
+      // 2. Customer Sign-In Authentication with Passkey
+      signinForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const emailInput = document.getElementById('signin-email').value.trim().toLowerCase();
+        const users = loadUsers();
+
+        let targetUser = null;
+        if (emailInput) {
+          targetUser = users.find(u => u.email.toLowerCase() === emailInput);
+          if (!targetUser) {
+            showStatus('No customer account found for that email address.', 'error');
+            return;
+          }
+        } else {
+          targetUser = users[0] || null;
+          if (!targetUser) {
+            showStatus('No registered accounts found. Please register a new account first.', 'error');
+            return;
+          }
+        }
+
+        if (!targetUser.passkeys || targetUser.passkeys.length === 0) {
+          showStatus('This account has no active passkeys.', 'error');
+          return;
+        }
+
+        try {
+          const assertedId = await verifyPasskeyAssertion(targetUser);
+          if (assertedId) {
+            const matchedUser = users.find(u => u.passkeys.some(p => p.credentialId === assertedId));
+            if (matchedUser) targetUser = matchedUser;
+          }
+
+          const pk = targetUser.passkeys.find(p => p.credentialId === assertedId) || targetUser.passkeys[0];
+          if (pk) pk.lastUsedAt = new Date().toISOString();
+          saveUsers(users);
+
+          saveSession({
+            userId: targetUser.id,
+            authenticatedAt: Date.now(),
+            lastReauthAt: Date.now()
+          });
+
+          signinForm.reset();
+          renderAccountUI();
+          showStatus(`Signed in with passkey as ${targetUser.name}.`, 'success');
+        } catch (err) {
+          showStatus(err.message || 'Passkey sign-in failed.', 'error');
+        }
+      });
+
+      // 3. Profile Updates (with step-up passkey reauthentication for email changes or stale sessions)
+      profileForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const user = getCurrentUser();
+        if (!user) return;
+
+        const updatedName = document.getElementById('profile-name').value.trim();
+        const updatedEmail = document.getElementById('profile-email').value.trim().toLowerCase();
+        const updatedPhone = document.getElementById('profile-phone').value.trim();
+        const updatedDrink = document.getElementById('profile-drink').value;
+
+        const session = loadSession();
+        const isEmailChanging = updatedEmail !== user.email.toLowerCase();
+        const isSessionStale = !session || !session.lastReauthAt || (Date.now() - session.lastReauthAt > REAUTH_TTL_MS);
+
+        const performUpdate = () => {
+          const users = loadUsers();
+          const idx = users.findIndex(u => u.id === user.id);
+          if (idx === -1) return;
+
+          users[idx].name = updatedName;
+          users[idx].email = updatedEmail;
+          users[idx].phone = updatedPhone;
+          users[idx].favoriteDrink = updatedDrink;
+          saveUsers(users);
+          renderAccountUI();
+          showStatus('Customer profile updated and verified with passkey.', 'success');
+        };
+
+        if (isEmailChanging || isSessionStale) {
+          requireReauthentication(
+            'Updating your account profile requires passkey reauthentication to confirm your identity.',
+            performUpdate
+          );
+        } else {
+          performUpdate();
+        }
+      });
+
+      // 4. Explicit Reauthentication Button
+      btnReauthenticate.addEventListener('click', () => {
+        requireReauthentication(
+          'Reauthenticate with your passkey to refresh your elevated security session.',
+          () => {
+            showStatus('Passkey reauthentication verified.', 'success');
+          }
+        );
+      });
+
+      // 5. Saved Passkey Management: Add, Rename, Remove
+      addPasskeyForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const user = getCurrentUser();
+        if (!user) return;
+        const newLabel = document.getElementById('new-passkey-name').value.trim();
+        if (!newLabel) return;
+
+        requireReauthentication(
+          `Verify your existing passkey before registering "${newLabel}".`,
+          async () => {
+            try {
+              const currentUser = getCurrentUser();
+              const newPk = await createPasskeyCredential(currentUser, newLabel);
+              const users = loadUsers();
+              const idx = users.findIndex(u => u.id === currentUser.id);
+              if (idx !== -1) {
+                users[idx].passkeys.push(newPk);
+                saveUsers(users);
+              }
+              addPasskeyForm.reset();
+              renderAccountUI();
+              showStatus(`Added new passkey "${newPk.name}" to your account.`, 'success');
+            } catch (err) {
+              showStatus(err.message || 'Failed to add new passkey.', 'error');
+            }
+          }
+        );
+      });
+
+      function handleRenamePasskey(credentialId) {
+        const user = getCurrentUser();
+        if (!user) return;
+        const target = user.passkeys.find(p => p.credentialId === credentialId);
+        if (!target) return;
+
+        const nextName = window.prompt('Enter a new name for this passkey:', target.name);
+        if (!nextName || !nextName.trim()) return;
+
+        const users = loadUsers();
+        const idx = users.findIndex(u => u.id === user.id);
+        if (idx !== -1) {
+          const pk = users[idx].passkeys.find(p => p.credentialId === credentialId);
+          if (pk) pk.name = nextName.trim();
+          saveUsers(users);
+          renderAccountUI();
+          showStatus(`Passkey renamed to "${nextName.trim()}".`, 'success');
+        }
+      }
+
+      function handleRemovePasskey(credentialId) {
+        const user = getCurrentUser();
+        if (!user) return;
+        if (user.passkeys.length <= 1) {
+          showStatus('You must keep at least one active passkey on your passwordless account.', 'error');
+          return;
+        }
+
+        requireReauthentication(
+          'Please reauthenticate with a passkey to remove this saved credential.',
+          () => {
+            const users = loadUsers();
+            const idx = users.findIndex(u => u.id === user.id);
+            if (idx !== -1) {
+              users[idx].passkeys = users[idx].passkeys.filter(p => p.credentialId !== credentialId);
+              saveUsers(users);
+              renderAccountUI();
+              showStatus('Saved passkey removed from your account.', 'info');
+            }
+          }
+        );
+      }
+
+      // Sign Out
+      function handleSignOut(e) {
+        if (e) e.preventDefault();
+        const user = getCurrentUser();
+        if (!user) {
+          document.getElementById('my-account').scrollIntoView({ behavior: 'smooth' });
+          return;
+        }
+        saveSession(null);
+        renderAccountUI();
+        showStatus('You have been signed out.', 'info');
+      }
+
+      btnSignout.addEventListener('click', handleSignOut);
+      navLogoutLink.addEventListener('click', handleSignOut);
+      navAccountLink.addEventListener('click', (e) => {
+        e.preventDefault();
+        document.getElementById('my-account').scrollIntoView({ behavior: 'smooth' });
+      });
+
+      // Initialize
+      checkWebAuthnSupport();
+      loadUsers();
+      renderAccountUI();
+    })();
+  </script>
+
 </body>
 
 </html>
