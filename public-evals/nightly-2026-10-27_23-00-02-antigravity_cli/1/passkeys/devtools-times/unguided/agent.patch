+import type { APIRoute } from 'astro';
+import {
+  createChallenge,
+  getOrCreateUser,
+  getCredentialsForUser,
+} from '../../../utils/passkey-store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const sessionUser = await session?.get('user');
+    const username = (body.username || sessionUser?.username || '').trim();
+    const displayName = (body.displayName || sessionUser?.displayName || username).trim();
+
+    if (!username) {
+      return new Response(
+        JSON.stringify({ error: 'Username is required to register a passkey.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const user = getOrCreateUser(username, displayName);
+    const existingCredentials = getCredentialsForUser(user.username);
+    const pendingChallenge = createChallenge('registration', user.username, user.id);
+
+    await session?.set('passkeyChallenge', pendingChallenge);
+
+    const rpId = body.rpId || url.hostname || 'localhost';
+
+    const publicKeyOptions = {
+      challenge: pendingChallenge.challenge,
+      rp: {
+        name: 'The DevTools Times',
+        id: rpId,
+      },
+      user: {
+        id: Buffer.from(user.id, 'utf-8').toString('base64url'),
+        name: user.username,
+        displayName: user.displayName || user.username,
+      },
+      pubKeyCredParams: [
+        { alg: -7, type: 'public-key' },   // ES256
+        { alg: -257, type: 'public-key' }, // RS256
+        { alg: -8, type: 'public-key' },   // EdDSA
+      ],
+      timeout: 60000,
+      attestation: 'none',
+      excludeCredentials: existingCredentials.map((cred) => ({
+        id: cred.id,
+        type: 'public-key',
+        transports: cred.transports || ['internal', 'hybrid'],
+      })),
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'required',
+        ...(body.authenticatorAttachment
+          ? { authenticatorAttachment: body.authenticatorAttachment }
+          : {}),
+      },
+    };
+
+    return new Response(JSON.stringify(publicKeyOptions), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to generate passkey registration options.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..58ab404
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,88 @@
+import type { APIRoute } from 'astro';
+import {
+  buildUserProfile,
+  consumeChallenge,
+  decodeClientDataJSON,
+  getOrCreateUser,
+  saveCredential,
+} from '../../../utils/passkey-store';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const {
+      username: bodyUsername,
+      displayName: bodyDisplayName,
+      passkeyName,
+      credential,
+    } = body || {};
+
+    if (!credential || !credential.id) {
+      return new Response(
+        JSON.stringify({ error: 'Invalid passkey credential payload.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const sessionChallenge = await session?.get('passkeyChallenge');
+    const clientData = decodeClientDataJSON(credential.response?.clientDataJSON);
+    const challengeFromClient = clientData?.challenge || sessionChallenge?.challenge;
+    const storedChallenge = consumeChallenge(challengeFromClient) || sessionChallenge;
+
+    if (clientData?.type && clientData.type !== 'webauthn.create') {
+      return new Response(
+        JSON.stringify({ error: 'Unexpected WebAuthn ceremony type.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const sessionUser = await session?.get('user');
+    const username = (
+      bodyUsername ||
+      storedChallenge?.username ||
+      sessionUser?.username ||
+      'reader'
+    ).trim();
+
+    const user = getOrCreateUser(username, bodyDisplayName || sessionUser?.displayName);
+    const now = new Date().toISOString();
+
+    const saved = saveCredential({
+      id: credential.id,
+      userId: user.id,
+      username: user.username,
+      name: (passkeyName || '').trim() || 'Passkey',
+      createdAt: now,
+      lastUsedAt: now,
+      transports: credential.response?.transports || ['internal', 'hybrid'],
+      deviceType: credential.authenticatorAttachment === 'cross-platform' ? 'singleDevice' : 'multiDevice',
+      backedUp: credential.authenticatorAttachment !== 'cross-platform',
+      publicKey: credential.response?.publicKey || null,
+      algorithm: credential.response?.publicKeyAlgorithm || -7,
+      signCount: 1,
+    });
+
+    user.lastReauthAt = now;
+    const profile = buildUserProfile(user);
+
+    await session?.set('user', profile);
+    await session?.set('passkeyChallenge', null);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        credential: saved,
+        user: profile,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (error) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to verify passkey registration.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
