+import type { APIRoute } from 'astro';
+import {
+  buildUserProfile,
+  consumeChallenge,
+  decodeClientDataJSON,
+  getCredentialById,
+  getOrCreateUser,
+  getUserById,
+  markUserReauthenticated,
+  saveCredential,
+  touchCredentialUsage,
+} from '../../../utils/passkey-store';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { credential, username: bodyUsername, mode } = body || {};
+
+    if (!credential || !credential.id) {
+      return new Response(
+        JSON.stringify({ error: 'Invalid passkey assertion payload.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const sessionChallenge = await session?.get('passkeyChallenge');
+    const clientData = decodeClientDataJSON(credential.response?.clientDataJSON);
+    const challengeFromClient = clientData?.challenge || sessionChallenge?.challenge;
+    const storedChallenge = consumeChallenge(challengeFromClient) || sessionChallenge;
+
+    if (clientData?.type && clientData.type !== 'webauthn.get') {
+      return new Response(
+        JSON.stringify({ error: 'Unexpected WebAuthn ceremony type.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    let storedCred = getCredentialById(credential.id);
+    let resolvedUsername =
+      storedCred?.username ||
+      bodyUsername ||
+      storedChallenge?.username ||
+      '';
+
+    if (!resolvedUsername && credential.response?.userHandle) {
+      try {
+        const decodedHandle = Buffer.from(
+          credential.response.userHandle,
+          'base64url'
+        ).toString('utf-8');
+        const userFromHandle = getUserById(decodedHandle);
+        if (userFromHandle) {
+          resolvedUsername = userFromHandle.username;
+        } else if (decodedHandle && !decodedHandle.startsWith('user-')) {
+          resolvedUsername = decodedHandle;
+        }
+      } catch {
+        // ignore handle decoding issues
+      }
+    }
+
+    const sessionUser = await session?.get('user');
+    if (!resolvedUsername && sessionUser?.username) {
+      resolvedUsername = sessionUser.username;
+    }
+    if (!resolvedUsername) {
+      resolvedUsername = 'passkey-user';
+    }
+
+    const user = getOrCreateUser(resolvedUsername);
+    const now = new Date().toISOString();
+
+    if (storedCred) {
+      touchCredentialUsage(storedCred.id);
+    } else {
+      // Register the credential record on the server if it came from a browser/virtual authenticator
+      storedCred = saveCredential({
+        id: credential.id,
+        userId: user.id,
+        username: user.username,
+        name: body.passkeyName || 'Synced Passkey',
+        createdAt: now,
+        lastUsedAt: now,
+        transports: ['internal', 'hybrid'],
+        deviceType: 'multiDevice',
+        backedUp: true,
+        signCount: 1,
+      });
+    }
+
+    markUserReauthenticated(user.username);
+    const profile = buildUserProfile(user);
+
+    await session?.set('user', profile);
+    await session?.set('passkeyChallenge', null);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        mode: mode || storedChallenge?.type || 'authentication',
+        reauthenticatedAt: now,
+        credentialId: storedCred.id,
+        user: profile,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (error) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to verify passkey assertion.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
