+/**
+ * WebAuthn / Passkey utility helpers and client/server shared types
+ */
+
+export interface PasskeyCredentialInfo {
+  id: string; // Base64URL encoded credential ID
+  name: string;
+  createdAt: string;
+  lastUsedAt?: string | null;
+  transports?: AuthenticatorTransport[];
+  deviceType?: 'singleDevice' | 'multiDevice';
+  backedUp?: boolean;
+  aaguid?: string;
+}
+
+export interface UserProfile {
+  id: string;
+  username: string;
+  displayName: string;
+  email?: string;
+  createdAt: string;
+  lastReauthAt?: string | null;
+  passkeys: PasskeyCredentialInfo[];
+}
+
+export function bufferToBase64Url(buffer: ArrayBuffer | Uint8Array): string {
+  const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/g, '');
+}
+
+export function base64UrlToBuffer(base64Url: string): ArrayBuffer {
+  const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
+  const padLen = (4 - (base64.length % 4)) % 4;
+  const padded = base64 + '='.repeat(padLen);
+  const binary = atob(padded);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes.buffer;
+}
+
+export function isWebAuthnSupported(): boolean {
+  return (
+    typeof window !== 'undefined' &&
+    typeof window.PublicKeyCredential !== 'undefined' &&
+    typeof navigator.credentials !== 'undefined'
+  );
+}
+
+export async function isConditionalMediationAvailable(): Promise<boolean> {
+  if (!isWebAuthnSupported()) return false;
+  if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+    try {
+      return await PublicKeyCredential.isConditionalMediationAvailable();
+    } catch {
+      return false;
+    }
+  }
+  return false;
+}
+
+export async function isPlatformAuthenticatorAvailable(): Promise<boolean> {
+  if (!isWebAuthnSupported()) return false;
+  if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+    try {
+      return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    } catch {
+      return false;
+    }
+  }
+  return false;
+}
+
+export function detectDefaultPasskeyName(): string {
+  if (typeof navigator === 'undefined') return 'Passkey';
+  const ua = navigator.userAgent || '';
+  if (/Macintosh|Mac OS X/i.test(ua)) return 'iCloud Keychain / Mac Passkey';
+  if (/iPhone|iPad|iPod/i.test(ua)) return 'iCloud Keychain';
+  if (/Android/i.test(ua)) return 'Google Password Manager';
+  if (/Windows/i.test(ua)) return 'Windows Hello';
+  if (/Linux/i.test(ua)) return 'Chrome Profile Passkey';
+  return 'Passkey on this device';
+}
+
+export function serializeRegistrationCredential(credential: PublicKeyCredential) {
+  const response = credential.response as AuthenticatorAttestationResponse;
+  const transports =
+    typeof response.getTransports === 'function'
+      ? (response.getTransports() as AuthenticatorTransport[])
+      : (['internal', 'hybrid'] as AuthenticatorTransport[]);
+
+  const publicKeyBuffer =
+    typeof response.getPublicKey === 'function' ? response.getPublicKey() : null;
+  const publicKeyAlgorithm =
+    typeof response.getPublicKeyAlgorithm === 'function'
+      ? response.getPublicKeyAlgorithm()
+      : -7;
+
+  return {
+    id: credential.id,
+    rawId: bufferToBase64Url(credential.rawId),
+    type: credential.type,
+    authenticatorAttachment: (credential as any).authenticatorAttachment || 'platform',
+    response: {
+      clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+      attestationObject: bufferToBase64Url(response.attestationObject),
+      transports,
+      publicKey: publicKeyBuffer ? bufferToBase64Url(publicKeyBuffer) : null,
+      publicKeyAlgorithm,
+    },
+    clientExtensionResults: credential.getClientExtensionResults?.() || {},
+  };
+}
+
+export function serializeAuthenticationCredential(credential: PublicKeyCredential) {
+  const response = credential.response as AuthenticatorAssertionResponse;
+  return {
+    id: credential.id,
+    rawId: bufferToBase64Url(credential.rawId),
+    type: credential.type,
+    authenticatorAttachment: (credential as any).authenticatorAttachment || 'platform',
+    response: {
+      clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+      authenticatorData: bufferToBase64Url(response.authenticatorData),
+      signature: bufferToBase64Url(response.signature),
+      userHandle: response.userHandle ? bufferToBase64Url(response.userHandle) : null,
+    },
+    clientExtensionResults: credential.getClientExtensionResults?.() || {},
+  };
+}
+
+export function formatPasskeyError(err: unknown, fallback = 'Passkey operation failed.'): string {
+  if (!err) return fallback;
+  if (err instanceof DOMException || (typeof err === 'object' && err !== null && 'name' in err)) {
+    const name = (err as { name: string; message?: string }).name;
+    const message = (err as { name: string; message?: string }).message;
+    switch (name) {
+      case 'NotAllowedError':
+        return 'The passkey request was cancelled or timed out.';
+      case 'InvalidStateError':
+        return 'A passkey for this authenticator is already registered for this account.';
+      case 'NotSupportedError':
+        return 'Passkeys (WebAuthn) are not supported by this browser or authenticator.';
+      case 'SecurityError':
+        return 'Security error: The relying party ID is invalid for this domain.';
+      case 'AbortError':
+        return 'The passkey operation was aborted.';
+      default:
+        return message || fallback;
+    }
+  }
+  if (err instanceof Error) return err.message;
+  return String(err);
+}
+
+const LOCAL_STORAGE_USER_KEY = 'devtools_times_user';
+const LOCAL_STORAGE_PASSKEYS_KEY = 'devtools_times_passkeys';
+
+export function getLocalPasskeys(username?: string): PasskeyCredentialInfo[] {
+  if (typeof window === 'undefined') return [];
+  try {
+    const raw = localStorage.getItem(LOCAL_STORAGE_PASSKEYS_KEY);
+    if (!raw) return [];
+    const map = JSON.parse(raw) as Record<string, PasskeyCredentialInfo[]>;
+    if (username) {
+      return map[username.toLowerCase()] || [];
+    }
+    return Object.values(map).flat();
+  } catch {
+    return [];
+  }
+}
+
+export function saveLocalPasskeys(username: string, passkeys: PasskeyCredentialInfo[]) {
+  if (typeof window === 'undefined' || !username) return;
+  try {
+    const raw = localStorage.getItem(LOCAL_STORAGE_PASSKEYS_KEY);
+    const map = raw ? (JSON.parse(raw) as Record<string, PasskeyCredentialInfo[]>) : {};
+    map[username.toLowerCase()] = passkeys;
+    localStorage.setItem(LOCAL_STORAGE_PASSKEYS_KEY, JSON.stringify(map));
+  } catch {
+    // ignore storage errors
+  }
+}
+
+export function saveLocalUserSession(user: UserProfile | null) {
+  if (typeof window === 'undefined') return;
+  try {
+    if (user) {
+      localStorage.setItem(LOCAL_STORAGE_USER_KEY, JSON.stringify(user));
+      saveLocalPasskeys(user.username, user.passkeys || []);
+    } else {
+      localStorage.removeItem(LOCAL_STORAGE_USER_KEY);
+    }
+    window.dispatchEvent(new CustomEvent('devtools-auth-changed', { detail: { user } }));
+  } catch {
+    // ignore storage errors
+  }
+}
+
+export function getLocalUserSession(): UserProfile | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = localStorage.getItem(LOCAL_STORAGE_USER_KEY);
+    return raw ? (JSON.parse(raw) as UserProfile) : null;
+  } catch {
+    return null;
+  }
+}
