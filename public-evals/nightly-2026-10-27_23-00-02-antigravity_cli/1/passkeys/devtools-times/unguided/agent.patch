@@ -0,0 +1,65 @@
+import type { APIRoute } from 'astro';
+import {
+  createChallenge,
+  getCredentialsForUser,
+} from '../../../utils/passkey-store';
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const sessionUser = await session?.get('user');
+    const mode = body.mode === 'reauthentication' ? 'reauthentication' : 'authentication';
+    const username = (
+      body.username ||
+      (mode === 'reauthentication' ? sessionUser?.username : '') ||
+      ''
+    ).trim();
+
+    const pendingChallenge = createChallenge(mode, username || undefined);
+    await session?.set('passkeyChallenge', pendingChallenge);
+
+    const rpId = body.rpId || url.hostname || 'localhost';
+
+    const userCredentials = username ? getCredentialsForUser(username) : [];
+    const clientCredentialIds: string[] = Array.isArray(body.credentialIds)
+      ? body.credentialIds
+      : [];
+
+    const combinedIds = Array.from(
+      new Set([...userCredentials.map((c) => c.id), ...clientCredentialIds])
+    );
+
+    // For discoverable (autofill / conditional or passwordless) login without a specific username,
+    // allowCredentials is empty so the browser shows all discoverable passkeys for this RP.
+    // For reauthentication or username-scoped authentication, scope to known credentials if available.
+    const allowCredentials =
+      username && combinedIds.length > 0
+        ? combinedIds.map((id) => {
+            const match = userCredentials.find((c) => c.id === id);
+            return {
+              id,
+              type: 'public-key' as const,
+              transports: match?.transports || (['internal', 'hybrid'] as AuthenticatorTransport[]),
+            };
+          })
+        : [];
+
+    const publicKeyOptions = {
+      challenge: pendingChallenge.challenge,
+      rpId,
+      timeout: 60000,
+      userVerification: 'required',
+      allowCredentials,
+    };
+
+    return new Response(JSON.stringify(publicKeyOptions), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (error) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to generate passkey authentication options.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
