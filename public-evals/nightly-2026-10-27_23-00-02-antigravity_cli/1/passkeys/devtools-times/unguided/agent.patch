+import type { APIRoute } from 'astro';
+import {
+  buildUserProfile,
+  deleteCredential,
+  getOrCreateUser,
+  renameCredential,
+  saveCredential,
+} from '../../../utils/passkey-store';
+
+export const GET: APIRoute = async ({ url, session }) => {
+  const sessionUser = await session?.get('user');
+  const username = (url.searchParams.get('username') || sessionUser?.username || '').trim();
+
+  if (!username) {
+    return new Response(
+      JSON.stringify({ authenticated: false, user: null, passkeys: [] }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  const user = getOrCreateUser(username, sessionUser?.displayName);
+  const profile = buildUserProfile(user);
+
+  return new Response(
+    JSON.stringify({
+      authenticated: Boolean(sessionUser),
+      user: profile,
+      passkeys: profile.passkeys,
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { action } = body || {};
+    const sessionUser = await session?.get('user');
+    const username = (body.username || sessionUser?.username || '').trim();
+
+    if (action === 'logout') {
+      await session?.set('user', null);
+      return new Response(JSON.stringify({ ok: true, user: null }), {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (!username) {
+      return new Response(
+        JSON.stringify({ error: 'Username is required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const user = getOrCreateUser(username, body.displayName || sessionUser?.displayName);
+
+    if (action === 'session-sync') {
+      if (body.email) user.email = body.email;
+      if (body.displayName) user.displayName = body.displayName;
+      if (Array.isArray(body.passkeys)) {
+        for (const pk of body.passkeys) {
+          if (pk && pk.id) {
+            saveCredential({
+              id: pk.id,
+              userId: user.id,
+              username: user.username,
+              name: pk.name || 'Passkey',
+              createdAt: pk.createdAt || new Date().toISOString(),
+              lastUsedAt: pk.lastUsedAt || null,
+              transports: pk.transports || ['internal', 'hybrid'],
+              deviceType: pk.deviceType || 'multiDevice',
+              backedUp: pk.backedUp ?? true,
+              signCount: 1,
+            });
+          }
+        }
+      }
+      const profile = buildUserProfile(user);
+      await session?.set('user', profile);
+      return new Response(JSON.stringify({ ok: true, user: profile }), {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (action === 'rename') {
+      const { credentialId, name } = body;
+      if (!credentialId || !name) {
+        return new Response(
+          JSON.stringify({ error: 'Credential ID and new name are required.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      const updated = renameCredential(user.username, credentialId, name);
+      if (!updated) {
+        return new Response(
+          JSON.stringify({ error: 'Passkey not found.' }),
+          { status: 404, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      const profile = buildUserProfile(user);
+      await session?.set('user', profile);
+      return new Response(
+        JSON.stringify({ ok: true, credential: updated, user: profile }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'delete') {
+      const { credentialId } = body;
+      if (!credentialId) {
+        return new Response(
+          JSON.stringify({ error: 'Credential ID is required.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      deleteCredential(user.username, credentialId);
+      const profile = buildUserProfile(user);
+      await session?.set('user', profile);
+      return new Response(
+        JSON.stringify({ ok: true, deletedId: credentialId, user: profile }),
+        { status: 200, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'update-profile') {
+      if (body.displayName) user.displayName = body.displayName.trim();
+      if (body.email) user.email = body.email.trim();
+      const profile = buildUserProfile(user);
+      await session?.set('user', profile);
+      return new Response(JSON.stringify({ ok: true, user: profile }), {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    return new Response(
+      JSON.stringify({ error: 'Unsupported action.' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (error) {
+    return new Response(
+      JSON.stringify({ error: 'Failed to process passkey management request.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
