diff --git a/src/utils/passkey-client.ts b/src/utils/passkey-client.ts
new file mode 100644
index 0000000..8f90ffa
--- /dev/null
+++ b/src/utils/passkey-client.ts
@@ -0,0 +1,307 @@
+import {
+  base64UrlToBuffer,
+  detectDefaultPasskeyName,
+  getLocalPasskeys,
+  getLocalUserSession,
+  isWebAuthnSupported,
+  saveLocalPasskeys,
+  saveLocalUserSession,
+  serializeAuthenticationCredential,
+  serializeRegistrationCredential,
+  type PasskeyCredentialInfo,
+  type UserProfile,
+} from './passkeys';
+
+function getApiBase(): string {
+  const base = import.meta.env.BASE_URL || '/';
+  return base.endsWith('/') ? base : `${base}/`;
+}
+
+export async function registerPasskeyCeremony(options: {
+  username: string;
+  displayName?: string;
+  passkeyName?: string;
+  authenticatorAttachment?: AuthenticatorAttachment;
+}): Promise<{ user: UserProfile; credential: PasskeyCredentialInfo }> {
+  if (!isWebAuthnSupported()) {
+    throw new Error('Passkeys (WebAuthn) are not supported by this browser.');
+  }
+
+  const username = options.username.trim();
+  if (!username) {
+    throw new Error('Please enter a username first.');
+  }
+
+  const apiBase = getApiBase();
+  const optionsRes = await fetch(`${apiBase}api/passkeys/register-options`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      username,
+      displayName: options.displayName || username,
+      rpId: window.location.hostname,
+      authenticatorAttachment: options.authenticatorAttachment,
+    }),
+  });
+
+  const optionsData = await optionsRes.json();
+  if (!optionsRes.ok) {
+    throw new Error(optionsData.error || 'Could not start passkey registration.');
+  }
+
+  const publicKey: PublicKeyCredentialCreationOptions = {
+    challenge: base64UrlToBuffer(optionsData.challenge),
+    rp: optionsData.rp,
+    user: {
+      id: base64UrlToBuffer(optionsData.user.id),
+      name: optionsData.user.name,
+      displayName: optionsData.user.displayName,
+    },
+    pubKeyCredParams: optionsData.pubKeyCredParams,
+    timeout: optionsData.timeout || 60000,
+    attestation: optionsData.attestation || 'none',
+    excludeCredentials: (optionsData.excludeCredentials || []).map((cred: any) => ({
+      id: base64UrlToBuffer(cred.id),
+      type: 'public-key' as const,
+      transports: cred.transports,
+    })),
+    authenticatorSelection: optionsData.authenticatorSelection,
+  };
+
+  const created = (await navigator.credentials.create({
+    publicKey,
+  })) as PublicKeyCredential | null;
+
+  if (!created) {
+    throw new Error('Passkey creation was cancelled or returned no credential.');
+  }
+
+  const serialized = serializeRegistrationCredential(created);
+  const passkeyName = (options.passkeyName || '').trim() || detectDefaultPasskeyName();
+
+  const verifyRes = await fetch(`${apiBase}api/passkeys/register-verify`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      username,
+      displayName: options.displayName || username,
+      passkeyName,
+      credential: serialized,
+    }),
+  });
+
+  const verifyData = await verifyRes.json();
+  if (!verifyRes.ok) {
+    throw new Error(verifyData.error || 'Failed to verify newly created passkey.');
+  }
+
+  const userProfile: UserProfile = verifyData.user;
+  saveLocalUserSession(userProfile);
+
+  return {
+    user: userProfile,
+    credential: verifyData.credential,
+  };
+}
+
+export async function authenticateWithPasskeyCeremony(options?: {
+  username?: string;
+  mode?: 'authentication' | 'reauthentication';
+  mediation?: CredentialMediationRequirement;
+  signal?: AbortSignal;
+}): Promise<{
+  user: UserProfile;
+  reauthenticatedAt: string;
+  credentialId: string;
+}> {
+  if (!isWebAuthnSupported()) {
+    throw new Error('Passkeys (WebAuthn) are not supported by this browser.');
+  }
+
+  const username = options?.username?.trim() || '';
+  const mode = options?.mode || 'authentication';
+  const localPasskeys = getLocalPasskeys(username || undefined);
+  const apiBase = getApiBase();
+
+  const optionsRes = await fetch(`${apiBase}api/passkeys/auth-options`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      username: username || undefined,
+      mode,
+      rpId: window.location.hostname,
+      credentialIds: localPasskeys.map((c) => c.id),
+    }),
+  });
+
+  const optionsData = await optionsRes.json();
+  if (!optionsRes.ok) {
+    throw new Error(optionsData.error || 'Could not start passkey authentication.');
+  }
+
+  const publicKey: PublicKeyCredentialRequestOptions = {
+    challenge: base64UrlToBuffer(optionsData.challenge),
+    rpId: optionsData.rpId || window.location.hostname,
+    timeout: optionsData.timeout || 60000,
+    userVerification: optionsData.userVerification || 'required',
+    allowCredentials: (optionsData.allowCredentials || []).map((cred: any) => ({
+      id: base64UrlToBuffer(cred.id),
+      type: 'public-key' as const,
+      transports: cred.transports,
+    })),
+  };
+
+  const assertion = (await navigator.credentials.get({
+    publicKey,
+    mediation: options?.mediation,
+    signal: options?.signal,
+  })) as PublicKeyCredential | null;
+
+  if (!assertion) {
+    throw new Error('No passkey assertion was returned.');
+  }
+
+  const serialized = serializeAuthenticationCredential(assertion);
+
+  const verifyRes = await fetch(`${apiBase}api/passkeys/auth-verify`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      username: username || undefined,
+      mode,
+      passkeyName: detectDefaultPasskeyName(),
+      credential: serialized,
+    }),
+  });
+
+  const verifyData = await verifyRes.json();
+  if (!verifyRes.ok) {
+    throw new Error(verifyData.error || 'Passkey verification failed.');
+  }
+
+  const userProfile: UserProfile = verifyData.user;
+  saveLocalUserSession(userProfile);
+
+  return {
+    user: userProfile,
+    reauthenticatedAt: verifyData.reauthenticatedAt,
+    credentialId: verifyData.credentialId,
+  };
+}
+
+export async function syncSessionWithServer(
+  username: string,
+  displayName?: string
+): Promise<UserProfile | null> {
+  const apiBase = getApiBase();
+  const localPasskeys = getLocalPasskeys(username);
+  try {
+    const res = await fetch(`${apiBase}api/passkeys`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        action: 'session-sync',
+        username,
+        displayName,
+        passkeys: localPasskeys,
+      }),
+    });
+    if (!res.ok) return null;
+    const data = await res.json();
+    if (data.user) {
+      saveLocalUserSession(data.user);
+      return data.user;
+    }
+    return null;
+  } catch {
+    return getLocalUserSession();
+  }
+}
+
+export async function fetchUserPasskeySession(username?: string): Promise<UserProfile | null> {
+  const apiBase = getApiBase();
+  const localUser = getLocalUserSession();
+  const targetUsername = username || localUser?.username || '';
+  try {
+    const query = targetUsername ? `?username=${encodeURIComponent(targetUsername)}` : '';
+    const res = await fetch(`${apiBase}api/passkeys${query}`);
+    if (!res.ok) return localUser;
+    const data = await res.json();
+    if (data.user) {
+      // Merge any local passkeys that might have been created before server restart
+      const localCreds = getLocalPasskeys(data.user.username);
+      const serverIds = new Set((data.user.passkeys || []).map((c: PasskeyCredentialInfo) => c.id));
+      const missingLocal = localCreds.filter((c) => !serverIds.has(c.id));
+      if (missingLocal.length > 0) {
+        return await syncSessionWithServer(data.user.username, data.user.displayName);
+      }
+      saveLocalUserSession(data.user);
+      return data.user;
+    }
+    return localUser;
+  } catch {
+    return localUser;
+  }
+}
+
+export async function renamePasskeyRequest(
+  username: string,
+  credentialId: string,
+  name: string
+): Promise<UserProfile> {
+  const apiBase = getApiBase();
+  const res = await fetch(`${apiBase}api/passkeys`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      action: 'rename',
+      username,
+      credentialId,
+      name,
+    }),
+  });
+  const data = await res.json();
+  if (!res.ok) {
+    throw new Error(data.error || 'Failed to rename passkey.');
+  }
+  saveLocalUserSession(data.user);
+  return data.user;
+}
+
+export async function deletePasskeyRequest(
+  username: string,
+  credentialId: string
+): Promise<UserProfile> {
+  const apiBase = getApiBase();
+  const res = await fetch(`${apiBase}api/passkeys`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      action: 'delete',
+      username,
+      credentialId,
+    }),
+  });
+  const data = await res.json();
+  if (!res.ok) {
+    throw new Error(data.error || 'Failed to delete passkey.');
+  }
+  // Also update local storage passkey list
+  saveLocalPasskeys(username, data.user.passkeys || []);
+  saveLocalUserSession(data.user);
+  return data.user;
+}
+
+export async function signOutPasskeySession(): Promise<void> {
+  const apiBase = getApiBase();
+  try {
+    await fetch(`${apiBase}api/passkeys`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ action: 'logout' }),
+    });
+  } catch {
+    // ignore network errors on logout
+  }
+  saveLocalUserSession(null);
+}
diff --git a/src/utils/passkey-store.ts b/src/utils/passkey-store.ts
new file mode 100644
index 0000000..23d81c3
--- /dev/null
+++ b/src/utils/passkey-store.ts
@@ -0,0 +1,241 @@
+import crypto from 'node:crypto';
+import type { PasskeyCredentialInfo, UserProfile } from './passkeys';
+
+export interface StoredCredential extends PasskeyCredentialInfo {
+  userId: string;
+  username: string;
+  publicKey?: string | null;
+  algorithm?: number;
+  signCount: number;
+}
+
+export interface StoredUser {
+  id: string;
+  username: string;
+  displayName: string;
+  email: string;
+  passwordHash?: string;
+  createdAt: string;
+  lastReauthAt?: string | null;
+}
+
+export interface PendingChallenge {
+  challenge: string;
+  type: 'registration' | 'authentication' | 'reauthentication';
+  username?: string;
+  userId?: string;
+  createdAt: number;
+}
+
+interface PasskeyStoreState {
+  users: Map<string, StoredUser>; // keyed by lowercase username
+  usersById: Map<string, StoredUser>; // keyed by userId
+  credentials: Map<string, StoredCredential>; // keyed by credentialId (base64url)
+  challenges: Map<string, PendingChallenge>; // keyed by challenge string
+}
+
+const globalStoreKey = '__DEVTOOLS_TIMES_PASSKEY_STORE__';
+
+function getStore(): PasskeyStoreState {
+  const g = globalThis as unknown as Record<string, PasskeyStoreState>;
+  if (!g[globalStoreKey]) {
+    const store: PasskeyStoreState = {
+      users: new Map(),
+      usersById: new Map(),
+      credentials: new Map(),
+      challenges: new Map(),
+    };
+    // Seed a default demo user so Account Settings / Sign-In work out of the box if needed
+    const demoUser: StoredUser = {
+      id: 'user-devtools-editor',
+      username: 'editor',
+      displayName: 'DevTools Editor',
+      email: 'editor@devtoolstimes.dev',
+      createdAt: new Date(Date.now() - 86400000 * 14).toISOString(),
+      lastReauthAt: null,
+    };
+    store.users.set(demoUser.username.toLowerCase(), demoUser);
+    store.usersById.set(demoUser.id, demoUser);
+    g[globalStoreKey] = store;
+  }
+  return g[globalStoreKey];
+}
+
+export function generateChallengeBytes(): string {
+  return crypto.randomBytes(32).toString('base64url');
+}
+
+export function createChallenge(
+  type: PendingChallenge['type'],
+  username?: string,
+  userId?: string
+): PendingChallenge {
+  const store = getStore();
+  // Clean up expired challenges (> 10 minutes)
+  const now = Date.now();
+  for (const [key, value] of store.challenges.entries()) {
+    if (now - value.createdAt > 10 * 60 * 1000) {
+      store.challenges.delete(key);
+    }
+  }
+
+  const challenge = generateChallengeBytes();
+  const entry: PendingChallenge = {
+    challenge,
+    type,
+    username,
+    userId,
+    createdAt: now,
+  };
+  store.challenges.set(challenge, entry);
+  return entry;
+}
+
+export function consumeChallenge(challenge?: string): PendingChallenge | null {
+  if (!challenge) return null;
+  const store = getStore();
+  const entry = store.challenges.get(challenge);
+  if (entry) {
+    store.challenges.delete(challenge);
+    return entry;
+  }
+  return null;
+}
+
+export function getOrCreateUser(username: string, displayName?: string): StoredUser {
+  const store = getStore();
+  const normalized = username.trim().toLowerCase();
+  const existing = store.users.get(normalized);
+  if (existing) {
+    if (displayName && displayName.trim()) {
+      existing.displayName = displayName.trim();
+    }
+    return existing;
+  }
+
+  const userId = `user-${crypto.randomBytes(8).toString('hex')}`;
+  const cleanUsername = username.trim();
+  const newUser: StoredUser = {
+    id: userId,
+    username: cleanUsername,
+    displayName: displayName?.trim() || cleanUsername,
+    email: cleanUsername.includes('@') ? cleanUsername : `${cleanUsername}@devtoolstimes.dev`,
+    createdAt: new Date().toISOString(),
+    lastReauthAt: new Date().toISOString(),
+  };
+
+  store.users.set(normalized, newUser);
+  store.usersById.set(userId, newUser);
+  return newUser;
+}
+
+export function getUserByUsername(username: string): StoredUser | null {
+  const store = getStore();
+  return store.users.get(username.trim().toLowerCase()) || null;
+}
+
+export function getUserById(userId: string): StoredUser | null {
+  const store = getStore();
+  return store.usersById.get(userId) || null;
+}
+
+export function getCredentialsForUser(usernameOrId: string): StoredCredential[] {
+  const store = getStore();
+  const normalized = usernameOrId.trim().toLowerCase();
+  const results: StoredCredential[] = [];
+  for (const cred of store.credentials.values()) {
+    if (cred.username.toLowerCase() === normalized || cred.userId === usernameOrId) {
+      results.push(cred);
+    }
+  }
+  return results;
+}
+
+export function getCredentialById(credentialId: string): StoredCredential | null {
+  const store = getStore();
+  return store.credentials.get(credentialId) || null;
+}
+
+export function saveCredential(credential: StoredCredential): StoredCredential {
+  const store = getStore();
+  store.credentials.set(credential.id, credential);
+  return credential;
+}
+
+export function renameCredential(
+  username: string,
+  credentialId: string,
+  newName: string
+): StoredCredential | null {
+  const store = getStore();
+  const cred = store.credentials.get(credentialId);
+  if (!cred || cred.username.toLowerCase() !== username.toLowerCase()) {
+    return null;
+  }
+  cred.name = newName.trim() || cred.name;
+  store.credentials.set(credentialId, cred);
+  return cred;
+}
+
+export function deleteCredential(username: string, credentialId: string): boolean {
+  const store = getStore();
+  const cred = store.credentials.get(credentialId);
+  if (!cred || cred.username.toLowerCase() !== username.toLowerCase()) {
+    return false;
+  }
+  return store.credentials.delete(credentialId);
+}
+
+export function touchCredentialUsage(credentialId: string): StoredCredential | null {
+  const store = getStore();
+  const cred = store.credentials.get(credentialId);
+  if (!cred) return null;
+  cred.lastUsedAt = new Date().toISOString();
+  cred.signCount = (cred.signCount || 0) + 1;
+  store.credentials.set(credentialId, cred);
+  return cred;
+}
+
+export function markUserReauthenticated(username: string): StoredUser | null {
+  const user = getUserByUsername(username);
+  if (!user) return null;
+  user.lastReauthAt = new Date().toISOString();
+  return user;
+}
+
+export function buildUserProfile(user: StoredUser): UserProfile {
+  const passkeys = getCredentialsForUser(user.username).map((c) => ({
+    id: c.id,
+    name: c.name,
+    createdAt: c.createdAt,
+    lastUsedAt: c.lastUsedAt,
+    transports: c.transports,
+    deviceType: c.deviceType,
+    backedUp: c.backedUp,
+    aaguid: c.aaguid,
+  }));
+
+  return {
+    id: user.id,
+    username: user.username,
+    displayName: user.displayName,
+    email: user.email,
+    createdAt: user.createdAt,
+    lastReauthAt: user.lastReauthAt,
+    passkeys,
+  };
+}
+
+export function decodeClientDataJSON(base64Url?: string): {
+  type?: string;
+  challenge?: string;
+  origin?: string;
+} | null {
+  if (!base64Url) return null;
+  try {
+    const json = Buffer.from(base64Url, 'base64url').toString('utf-8');
+    return JSON.parse(json);
+  } catch {
+    return null;
+  }
+}
