+  <script>
+    (function () {
+      const track = document.getElementById('seasonal-carousel');
+      const cards = Array.from(track.querySelectorAll('.card'));
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      const statusEl = document.getElementById('carousel-status');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      let currentIndex = 0;
+      let cleanupTimer = null;
+
+      const animClasses = [
+        'enter-from-right',
+        'exit-to-left',
+        'enter-from-left',
+        'exit-to-right'
+      ];
+
+      function resetAllCards(activeIndex) {
+        if (cleanupTimer) {
+          clearTimeout(cleanupTimer);
+          cleanupTimer = null;
+        }
+        cards.forEach((card, idx) => {
+          card.classList.remove(...animClasses);
+          if (idx === activeIndex) {
+            card.classList.add('active');
+            card.hidden = false;
+            card.setAttribute('aria-hidden', 'false');
+          } else {
+            card.classList.remove('active');
+            card.hidden = true;
+            card.setAttribute('aria-hidden', 'true');
+          }
+        });
+      }
+
+      function stepCarousel(direction) {
+        const nextIndex = (currentIndex + direction + cards.length) % cards.length;
+        if (nextIndex === currentIndex) return;
+
+        const outgoingCard = cards[currentIndex];
+        const incomingCard = cards[nextIndex];
+        currentIndex = nextIndex;
+        statusEl.textContent = `${currentIndex + 1} / ${cards.length}`;
+
+        // Clean up any in-flight animations first
+        if (cleanupTimer) {
+          clearTimeout(cleanupTimer);
+          cleanupTimer = null;
+        }
+        cards.forEach((card) => {
+          card.classList.remove(...animClasses);
+          if (card !== outgoingCard && card !== incomingCard) {
+            card.classList.remove('active');
+            card.hidden = true;
+            card.setAttribute('aria-hidden', 'true');
+          }
+        });
+
+        const prefersReducedMotion = reducedMotionQuery.matches;
+
+        if (prefersReducedMotion) {
+          resetAllCards(currentIndex);
+          return;
+        }
+
+        // Prepare both cards for directional transition
+        outgoingCard.classList.remove('active');
+        outgoingCard.hidden = false;
+        outgoingCard.setAttribute('aria-hidden', 'true');
+
+        incomingCard.classList.add('active');
+        incomingCard.hidden = false;
+        incomingCard.setAttribute('aria-hidden', 'false');
+
+        // Force reflow so rapid clicks restart the animation cleanly
+        void incomingCard.offsetWidth;
+
+        if (direction > 0) {
+          // Going Next: new item comes in from the right, old exits to the left
+          incomingCard.classList.add('enter-from-right');
+          outgoingCard.classList.add('exit-to-left');
+        } else {
+          // Going Previous: new item comes in from the left, old exits to the right
+          incomingCard.classList.add('enter-from-left');
+          outgoingCard.classList.add('exit-to-right');
+        }
+
+        const finishTransition = () => {
+          resetAllCards(currentIndex);
+        };
+
+        incomingCard.addEventListener('animationend', finishTransition, { once: true });
+        cleanupTimer = setTimeout(finishTransition, 400);
+      }
+
+      nextBtn.addEventListener('click', () => stepCarousel(1));
+      prevBtn.addEventListener('click', () => stepCarousel(-1));
+    })();
+  </script>
