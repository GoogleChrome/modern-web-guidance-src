@@ -51,9 +66,76 @@ politicsArticles[2] = {
                     </div>
                 ))}
             </div>
+            <button
+                type="button"
+                data-top-stories-next
+                aria-label="Next story"
+                class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded transition-colors cursor-pointer shrink-0"
+            >
+                Next
+            </button>
         </div>
     </div>
 
+    <script>
+        function initTopStoriesSlider() {
+            const slider = document.querySelector<HTMLElement>('[data-top-stories-slider]');
+            if (!slider || slider.dataset.initialized === 'true') return;
+            slider.dataset.initialized = 'true';
+
+            const viewport = slider.querySelector<HTMLElement>('[data-top-stories-viewport]');
+            const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-top-story-slide]'));
+            const prevBtn = slider.querySelector<HTMLButtonElement>('[data-top-stories-prev]');
+            const nextBtn = slider.querySelector<HTMLButtonElement>('[data-top-stories-next]');
+
+            if (!viewport || slides.length === 0 || !prevBtn || !nextBtn) return;
+
+            let currentIndex = 0;
+
+            const showSlide = (nextIndex: number) => {
+                slides.forEach((slide, idx) => {
+                    slide.classList.toggle('hidden', idx !== nextIndex);
+                    slide.classList.toggle('block', idx === nextIndex);
+                });
+                currentIndex = nextIndex;
+            };
+
+            const navigate = (direction: 'forward' | 'backward') => {
+                const nextIndex =
+                    direction === 'forward'
+                        ? (currentIndex + 1) % slides.length
+                        : (currentIndex - 1 + slides.length) % slides.length;
+
+                const updateDOM = () => {
+                    showSlide(nextIndex);
+                };
+
+                const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+                if (prefersReducedMotion) {
+                    updateDOM();
+                    return;
+                }
+
+                if (!document.startViewTransition) {
+                    updateDOM();
+                    return;
+                }
+
+                const transition = document.startViewTransition({
+                    update: updateDOM,
+                    types: [direction],
+                });
+                transition.ready.catch(() => {});
+            };
+
+            prevBtn.addEventListener('click', () => navigate('backward'));
+            nextBtn.addEventListener('click', () => navigate('forward'));
+        }
+
+        initTopStoriesSlider();
+        document.addEventListener('astro:page-load', initTopStoriesSlider);
+    </script>
