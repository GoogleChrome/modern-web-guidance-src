+import React, { useState, useRef } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStoryItem {
+  id: string;
+  title: string;
+  dateFormatted: string;
+  href: string;
+}
+
+interface TopStoriesSliderProps {
+  stories: TopStoryItem[];
+}
+
+export default function TopStoriesSlider({ stories }: TopStoriesSliderProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [prevIndex, setPrevIndex] = useState<number | null>(null);
+  const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+  const [animKey, setAnimKey] = useState(0);
+  const timeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const total = stories.length;
+
+  const navigate = (dir: 'next' | 'prev') => {
+    if (total <= 1) return;
+
+    const prefersReducedMotion =
+      typeof window !== 'undefined' &&
+      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+    const nextIdx =
+      dir === 'next'
+        ? (currentIndex + 1) % total
+        : (currentIndex - 1 + total) % total;
+
+    if (timeoutRef.current) {
+      clearTimeout(timeoutRef.current);
+      timeoutRef.current = null;
+    }
+
+    if (prefersReducedMotion) {
+      setPrevIndex(null);
+      setDirection(null);
+      setCurrentIndex(nextIdx);
+      return;
+    }
+
+    setPrevIndex(currentIndex);
+    setDirection(dir);
+    setCurrentIndex(nextIdx);
+    setAnimKey((k) => k + 1);
+
+    timeoutRef.current = setTimeout(() => {
+      setPrevIndex(null);
+      setDirection(null);
+      timeoutRef.current = null;
+    }, 350);
+  };
+
+  const handlePrev = () => navigate('prev');
+  const handleNext = () => navigate('next');
+
+  return (
+    <section
+      aria-label="Top Stories"
+      aria-roledescription="carousel"
+      className="flex items-center justify-between gap-4"
+    >
+      <button
+        type="button"
+        onClick={handlePrev}
+        aria-label="Previous story"
+        className="flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 hover:text-gray-900 rounded border border-gray-300 transition-colors cursor-pointer shrink-0 focus:outline-none focus:ring-2 focus:ring-amber-400"
+      >
+        <ChevronLeftIcon className="w-4 h-4" aria-hidden="true" />
+        <span>Previous</span>
+      </button>
+
+      <div
+        className="relative flex-1 overflow-hidden"
+        aria-live="polite"
+        aria-atomic="true"
+      >
+        <div className="grid grid-cols-1">
+          {stories.map((story, idx) => {
+            const isCurrent = idx === currentIndex;
+            const isExiting = idx === prevIndex && direction !== null;
+
+            let animClass = '';
+            if (isCurrent && direction === 'next') {
+              animClass = 'top-story-slide-in-right';
+            } else if (isCurrent && direction === 'prev') {
+              animClass = 'top-story-slide-in-left';
+            } else if (isExiting && direction === 'next') {
+              animClass = 'top-story-slide-out-left';
+            } else if (isExiting && direction === 'prev') {
+              animClass = 'top-story-slide-out-right';
+            }
+
+            const isVisible = isCurrent || isExiting;
+
+            return (
+              <div
+                key={`${story.id}-${isCurrent || isExiting ? animKey : 0}`}
+                role="group"
+                aria-roledescription="slide"
+                aria-label={`${idx + 1} of ${total}`}
+                aria-hidden={!isCurrent}
+                inert={!isCurrent ? true : undefined}
+                className={`col-start-1 row-start-1 flex flex-col justify-center text-center px-2 ${animClass} ${
+                  isVisible ? '' : ' invisible pointer-events-none'
+                }`}
+              >
+                <a
+                  href={story.href}
+                  tabIndex={isCurrent ? 0 : -1}
+                  className="inline-block"
+                >
+                  <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">
+                    {story.title}
+                  </h3>
+                </a>
+                <span className="text-xs text-gray-500 mt-0.5">
+                  {story.dateFormatted}
+                </span>
+              </div>
+            );
+          })}
+        </div>
+      </div>
+
+      <button
+        type="button"
+        onClick={handleNext}
+        aria-label="Next story"
+        className="flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 hover:text-gray-900 rounded border border-gray-300 transition-colors cursor-pointer shrink-0 focus:outline-none focus:ring-2 focus:ring-amber-400"
+      >
+        <span>Next</span>
+        <ChevronRightIcon className="w-4 h-4" aria-hidden="true" />
+      </button>
+    </section>
+  );
+}
