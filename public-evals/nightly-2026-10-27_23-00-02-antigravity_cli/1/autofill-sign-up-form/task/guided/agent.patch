+  <script>
+    const signupForm = document.getElementById('signup-form');
+    const togglePasswordBtn = document.getElementById('toggle-password');
+    const passwordInput = document.getElementById('new-password');
+    const submitBtn = document.getElementById('sign-up');
+    const statusMessage = document.getElementById('signup-status');
+
+    togglePasswordBtn.addEventListener('click', () => {
+      const isPassword = passwordInput.type === 'password';
+      passwordInput.type = isPassword ? 'text' : 'password';
+      togglePasswordBtn.setAttribute('aria-pressed', String(isPassword));
+      togglePasswordBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
+      togglePasswordBtn.textContent = isPassword ? 'Hide password' : 'Show password';
+    });
+
+    const fields = [
+      {
+        input: document.getElementById('name'),
+        errorEl: document.getElementById('name-error'),
+        getMessage(el) {
+          if (el.validity.valueMissing) return 'Please enter your full name.';
+          if (el.validity.patternMismatch) return 'Please enter a valid name.';
+          return '';
+        }
+      },
+      {
+        input: document.getElementById('email'),
+        errorEl: document.getElementById('email-error'),
+        getMessage(el) {
+          if (el.validity.valueMissing) return 'Please enter your email address.';
+          if (el.validity.typeMismatch) return 'Please enter a valid email address.';
+          return '';
+        }
+      },
+      {
+        input: passwordInput,
+        errorEl: document.getElementById('password-error'),
+        getMessage(el) {
+          if (el.validity.valueMissing) return 'Please enter a password.';
+          if (el.validity.tooShort) return 'Password must be at least 8 characters.';
+          return '';
+        }
+      }
+    ];
+
+    fields.forEach(({ input, errorEl, getMessage }) => {
+      input.addEventListener('blur', () => {
+        if (!input.validity.valid) {
+          errorEl.textContent = getMessage(input);
+        }
+      });
+
+      input.addEventListener('input', () => {
+        input.setCustomValidity('');
+        errorEl.textContent = '';
+      });
+    });
+
+    signupForm.addEventListener('submit', (e) => {
+      let firstInvalid = null;
+      fields.forEach(({ input, errorEl, getMessage }) => {
+        if (!input.validity.valid) {
+          errorEl.textContent = getMessage(input);
+          if (!firstInvalid) firstInvalid = input;
+        }
+      });
+
+      if (firstInvalid) {
+        e.preventDefault();
+        firstInvalid.focus();
+        return;
+      }
+
+      e.preventDefault();
+      submitBtn.disabled = true;
+      submitBtn.textContent = 'Creating account...';
+      statusMessage.textContent = 'Welcome to The Daily Grind! Your account has been created.';
+    });
+  </script>
 </body>
 
