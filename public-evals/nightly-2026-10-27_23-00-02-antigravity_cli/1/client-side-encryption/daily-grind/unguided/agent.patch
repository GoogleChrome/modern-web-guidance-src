+        );
+        return new Uint8Array(bits);
+      }
+
+      // Post-Quantum KEM Encapsulation (ML-KEM-768 WebCrypto or Lattice Fallback)
+      async function performPostQuantumKem(recipientBundle) {
+        if (recipientBundle.nativePqc && !recipientBundle.mlKem768.isSimulatedPqc) {
+          const { sharedKey, ciphertext } = await crypto.subtle.encapsulateBits(
+            { name: 'ML-KEM-768' },
+            recipientBundle.mlKem768.publicKey
+          );
+          return {
+            algorithm: 'ML-KEM-768',
+            engine: 'WebCrypto-FIPS-203',
+            sharedSecret: new Uint8Array(sharedKey),
+            ciphertext: new Uint8Array(ciphertext)
+          };
+        }
+
+        const { sharedSecret, ciphertext } = await LatticeKemFallback.encapsulate(
+          recipientBundle.mlKem768.publicKey
+        );
+        return {
+          algorithm: 'ML-KEM-768',
+          engine: 'Lattice-KEM-Fallback',
+          sharedSecret,
+          ciphertext
+        };
+      }
+
+      async function decapsulatePostQuantumKem(pqcHeader, recipientBundle) {
+        const ciphertextBytes = fromBase64(pqcHeader.kemCiphertextB64);
+        if (recipientBundle.nativePqc && !recipientBundle.mlKem768.isSimulatedPqc) {
+          const sharedBits = await crypto.subtle.decapsulateBits(
+            { name: 'ML-KEM-768' },
+            recipientBundle.mlKem768.privateKey,
+            ciphertextBytes
+          );
+          return new Uint8Array(sharedBits);
+        }
+        return LatticeKemFallback.decapsulate(
+          recipientBundle.mlKem768.privateKey,
+          ciphertextBytes
+        );
+      }
+
+      // Derive 256-bit AES-GCM key via HKDF-SHA-256 over combined classical + post-quantum shared secrets
+      async function deriveAeadKeyFromSharedSecret(combinedSecretBytes, saltBytes, infoBytes) {
+        const hkdfBaseKey = await crypto.subtle.importKey(
+          'raw',
+          combinedSecretBytes,
+          'HKDF',
+          false,
+          ['deriveKey', 'deriveBits']
+        );
+        const aesGcmKey = await crypto.subtle.deriveKey(
+          {
+            name: 'HKDF',
+            hash: 'SHA-256',
+            salt: saltBytes,
+            info: infoBytes
+          },
+          hkdfBaseKey,
+          { name: 'AES-GCM', length: 256 },
+          false,
+          ['encrypt', 'decrypt']
+        );
+        const fingerprintBits = await crypto.subtle.deriveBits(
+          {
+            name: 'HKDF',
+            hash: 'SHA-256',
+            salt: saltBytes,
+            info: textEncoder.encode('daily-grind:key-commitment:v1')
+          },
+          hkdfBaseKey,
+          128
+        );
+        return {
+          aesGcmKey,
+          secretFingerprint: toHex(new Uint8Array(fingerprintBits))
+        };
+      }
+
+      // Establish shared secret & encrypt delivery note with AES-256-GCM authenticated encryption
+      async function encryptDeliveryNote({ orderReference, dropoffZone, kemMode, plaintextNote }) {
+        const recipientBundle = CourierKeyStore.activeKeyBundle;
+        const secretComponents = [];
+        const encapsulationData = {};
+
+        if (kemMode === 'X25519-ML-KEM-768') {
+          const classical = await performClassicalKeyAgreement('X25519', recipientBundle);
+          const pqc = await performPostQuantumKem(recipientBundle);
+          secretComponents.push(classical.sharedSecret, pqc.sharedSecret);
+          encapsulationData.mode = 'HYBRID_KEM';
+          encapsulationData.classical = {
+            algorithm: classical.algorithm,
+            ephemeralPublicKeyB64: toBase64(classical.ephemeralPublicKeyBytes)
+          };
+          encapsulationData.postQuantum = {
+            algorithm: pqc.algorithm,
+            engine: pqc.engine,
+            kemCiphertextB64: toBase64(pqc.ciphertext),
+            kemCiphertextBytes: pqc.ciphertext.byteLength
+          };
+        } else if (kemMode === 'ECDH-P256-ML-KEM-768') {
+          const classical = await performClassicalKeyAgreement('ECDH-P256', recipientBundle);
+          const pqc = await performPostQuantumKem(recipientBundle);
+          secretComponents.push(classical.sharedSecret, pqc.sharedSecret);
+          encapsulationData.mode = 'HYBRID_KEM';
+          encapsulationData.classical = {
+            algorithm: classical.algorithm,
+            ephemeralPublicKeyB64: toBase64(classical.ephemeralPublicKeyBytes)
+          };
+          encapsulationData.postQuantum = {
+            algorithm: pqc.algorithm,
+            engine: pqc.engine,
+            kemCiphertextB64: toBase64(pqc.ciphertext),
+            kemCiphertextBytes: pqc.ciphertext.byteLength
+          };
+        } else if (kemMode === 'ML-KEM-768') {
+          const pqc = await performPostQuantumKem(recipientBundle);
+          secretComponents.push(pqc.sharedSecret);
+          encapsulationData.mode = 'PQC_KEM';
+          encapsulationData.postQuantum = {
+            algorithm: pqc.algorithm,
+            engine: pqc.engine,
+            kemCiphertextB64: toBase64(pqc.ciphertext),
+            kemCiphertextBytes: pqc.ciphertext.byteLength
+          };
+        } else if (kemMode === 'X25519') {
+          const classical = await performClassicalKeyAgreement('X25519', recipientBundle);
+          secretComponents.push(classical.sharedSecret);
+          encapsulationData.mode = 'CLASSICAL_ECDH';
+          encapsulationData.classical = {
+            algorithm: classical.algorithm,
+            ephemeralPublicKeyB64: toBase64(classical.ephemeralPublicKeyBytes)
+          };
+        } else {
+          const classical = await performClassicalKeyAgreement('ECDH-P256', recipientBundle);
+          secretComponents.push(classical.sharedSecret);
+          encapsulationData.mode = 'CLASSICAL_ECDH';
+          encapsulationData.classical = {
+            algorithm: classical.algorithm,
+            ephemeralPublicKeyB64: toBase64(classical.ephemeralPublicKeyBytes)
+          };
+        }
+
+        const combinedSharedSecret = concatBytes(...secretComponents);
+        const hkdfSalt = crypto.getRandomValues(new Uint8Array(16));
+        const iv = crypto.getRandomValues(new Uint8Array(12));
+        const timestamp = new Date().toISOString();
+
+        // Associated Authenticated Data (AAD) binds order metadata & key suite to ciphertext integrity
+        const aadObject = {
+          app: 'daily-grind-delivery-notes',
+          version: 1,
+          orderReference,
+          dropoffZone,
+          recipientKid: recipientBundle.kid,
+          kemSuite: kemMode,
+          timestamp
+        };
+        const aadString = JSON.stringify(aadObject);
+        const aadBytes = textEncoder.encode(aadString);
+        const hkdfInfo = textEncoder.encode(`daily-grind:delivery-note-aead:${kemMode}:${recipientBundle.kid}`);
+
+        const { aesGcmKey, secretFingerprint } = await deriveAeadKeyFromSharedSecret(
+          combinedSharedSecret,
+          hkdfSalt,
+          hkdfInfo
+        );
+
+        const plaintextBytes = textEncoder.encode(plaintextNote);
+        const encryptedBuffer = await crypto.subtle.encrypt(
+          {
+            name: 'AES-GCM',
+            iv,
+            additionalData: aadBytes,
+            tagLength: 128
+          },
+          aesGcmKey,
+          plaintextBytes
+        );
+
+        const encryptedBytes = new Uint8Array(encryptedBuffer);
+        const ciphertextBody = encryptedBytes.slice(0, encryptedBytes.byteLength - 16);
+        const authTag = encryptedBytes.slice(encryptedBytes.byteLength - 16);
+
+        return {
+          envelopeVersion: '1.0-pqc-hybrid',
+          recipientKid: recipientBundle.kid,
+          kemSuite: kemMode,
+          kdf: {
+            algorithm: 'HKDF-SHA-256',
+            saltB64: toBase64(hkdfSalt),
+            info: `daily-grind:delivery-note-aead:${kemMode}:${recipientBundle.kid}`,
+            keyCommitmentFingerprint: secretFingerprint
+          },
+          encapsulation: encapsulationData,
+          aead: {
+            cipher: 'AES-256-GCM',
+            ivB64: toBase64(iv),
+            aad: aadObject,
+            ciphertextB64: toBase64(ciphertextBody),
+            authTagB64: toBase64(authTag),
+            sealedPayloadB64: toBase64(encryptedBytes)
+          }
+        };
+      }
+
+      // Decapsulate shared secret & verify/decrypt AES-256-GCM payload
+      async function decryptDeliveryNoteEnvelope(envelope) {
+        const recipientBundle = CourierKeyStore.byKid.get(envelope.recipientKid);
+        if (!recipientBundle) {
+          throw new Error(`Unknown courier recipient key ID: ${envelope.recipientKid}`);
+        }
+
+        const secretComponents = [];
+        if (envelope.encapsulation.classical) {
+          const classicalSecret = await decapsulateClassicalKeyAgreement(
+            envelope.encapsulation.classical,
+            recipientBundle
+          );
+          secretComponents.push(classicalSecret);
+        }
+        if (envelope.encapsulation.postQuantum) {
+          const pqSecret = await decapsulatePostQuantumKem(
+            envelope.encapsulation.postQuantum,
+            recipientBundle
+          );
+          secretComponents.push(pqSecret);
+        }
+
+        const combinedSharedSecret = concatBytes(...secretComponents);
+        const hkdfSalt = fromBase64(envelope.kdf.saltB64);
+        const hkdfInfo = textEncoder.encode(envelope.kdf.info);
+
+        const { aesGcmKey, secretFingerprint } = await deriveAeadKeyFromSharedSecret(
+          combinedSharedSecret,
+          hkdfSalt,
+          hkdfInfo
+        );
+
+        if (secretFingerprint !== envelope.kdf.keyCommitmentFingerprint) {
+          throw new Error('Key commitment verification failed: decapsulated shared secret mismatch.');
+        }
+
+        const iv = fromBase64(envelope.aead.ivB64);
+        const aadBytes = textEncoder.encode(JSON.stringify(envelope.aead.aad));
+        const sealedPayload = fromBase64(envelope.aead.sealedPayloadB64);
+
+        const decryptedBuffer = await crypto.subtle.decrypt(
+          {
+            name: 'AES-GCM',
+            iv,
+            additionalData: aadBytes,
+            tagLength: 128
+          },
+          aesGcmKey,
+          sealedPayload
+        );
+
+        return {
+          plaintext: textDecoder.decode(decryptedBuffer),
+          aad: envelope.aead.aad,
+          secretFingerprint
+        };
+      }
+
+      // UI State & Wiring
+      const state = {
+        activeEnvelope: null,
+        queue: []
+      };
+
+      const formEl = document.getElementById('delivery-notes-form');
+      const orderRefInput = document.getElementById('order-reference');
+      const dropoffZoneSelect = document.getElementById('dropoff-zone');
+      const kemModeSelect = document.getElementById('kem-mode');
+      const customerNoteInput = document.getElementById('customer-note');
+      const rotateKeysBtn = document.getElementById('rotate-keys-btn');
+      const verifyDecryptBtn = document.getElementById('verify-decrypt-btn');
+
+      const statKemSuite = document.getElementById('stat-kem-suite');
+      const statRecipientKid = document.getElementById('stat-recipient-kid');
+      const statSecretFp = document.getElementById('stat-secret-fp');
+      const statusBanner = document.getElementById('crypto-status-banner');
+      const envelopeOutput = document.getElementById('encrypted-envelope-output');
+      const decryptedBox = document.getElementById('decrypted-output-box');
+      const decryptedNoteText = document.getElementById('decrypted-note-text');
+      const decryptedAadText = document.getElementById('decrypted-aad-text');
+      const savedNotesContainer = document.getElementById('saved-notes-container');
+      const queueCountEl = document.getElementById('queue-count');
+      const pqcBadgeText = document.getElementById('pqc-badge-text');
+
+      function showStatus(message, type) {
+        statusBanner.textContent = message;
+        statusBanner.className = 'status-banner ' + (type === 'error' ? 'error' : 'success');
+      }
+
+      function renderQueue() {
+        queueCountEl.textContent = String(state.queue.length);
+        savedNotesContainer.innerHTML = '';
+
+        state.queue.forEach((envelope, idx) => {
+          const item = document.createElement('div');
+          item.className = 'saved-note-item';
+
+          const meta = document.createElement('div');
+          meta.className = 'saved-note-meta';
+          const aad = envelope.aead.aad;
+
+          const titleStrong = document.createElement('strong');
+          titleStrong.textContent = aad.orderReference;
+          meta.appendChild(titleStrong);
+
+          const suitePill = document.createElement('span');
+          suitePill.className = 'pill';
+          suitePill.textContent = envelope.kemSuite;
+          meta.appendChild(suitePill);
+
+          const detailsDiv = document.createElement('div');
+          detailsDiv.style.marginTop = '4px';
+          detailsDiv.style.color = '#5d4037';
+          detailsDiv.textContent = `Access: ${aad.dropoffZone} • Key: ${envelope.recipientKid} • Tag: ${envelope.aead.authTagB64}`;
+          meta.appendChild(detailsDiv);
+
+          const actions = document.createElement('div');
+          actions.style.display = 'flex';
+          actions.style.gap = '8px';
+
+          const inspectBtn = document.createElement('button');
+          inspectBtn.type = 'button';
+          inspectBtn.className = 'btn btn-secondary';
+          inspectBtn.style.padding = '6px 12px';
+          inspectBtn.style.fontSize = '0.8rem';
+          inspectBtn.textContent = 'Inspect & Decrypt';
+          inspectBtn.addEventListener('click', async () => {
+            state.activeEnvelope = envelope;
+            updateInspectorDisplay(envelope);
+            await handleDecryptActive();
+          });
+
+          const tamperBtn = document.createElement('button');
+          tamperBtn.type = 'button';
+          tamperBtn.className = 'btn btn-secondary';
+          tamperBtn.style.padding = '6px 12px';
+          tamperBtn.style.fontSize = '0.8rem';
+          tamperBtn.textContent = 'Test Tamper Rejection';
+          tamperBtn.addEventListener('click', async () => {
+            const cloned = JSON.parse(JSON.stringify(envelope));
+            const rawSealed = fromBase64(cloned.aead.sealedPayloadB64);
+            rawSealed[0] ^= 0xff;
+            cloned.aead.sealedPayloadB64 = toBase64(rawSealed);
+            state.activeEnvelope = cloned;
+            updateInspectorDisplay(cloned);
+            await handleDecryptActive();
+          });
+
+          actions.appendChild(inspectBtn);
+          actions.appendChild(tamperBtn);
+
+          item.appendChild(meta);
+          item.appendChild(actions);
+          savedNotesContainer.appendChild(item);
+        });
+      }
+
+      function updateInspectorDisplay(envelope) {
+        statKemSuite.textContent = envelope.kemSuite;
+        statRecipientKid.textContent = envelope.recipientKid;
+        statSecretFp.textContent = envelope.kdf.keyCommitmentFingerprint;
+        envelopeOutput.textContent = JSON.stringify(envelope, null, 2);
+      }
+
+      async function handleEncryptSubmit() {
+        try {
+          const orderReference = orderRefInput.value.trim() || 'ORD-2026-0001';
+          const dropoffZone = dropoffZoneSelect.value;
+          const kemMode = kemModeSelect.value;
+          const plaintextNote = customerNoteInput.value.trim();
+
+          if (!plaintextNote) {
+            showStatus('Please enter a delivery note to encrypt.', 'error');
+            return;
+          }
+
+          const envelope = await encryptDeliveryNote({
+            orderReference,
+            dropoffZone,
+            kemMode,
+            plaintextNote
+          });
+
+          state.activeEnvelope = envelope;
+          state.queue.unshift(envelope);
+          updateInspectorDisplay(envelope);
+          renderQueue();
+          decryptedBox.classList.remove('active');
+
+          showStatus(
+            `Shared secret established via ${kemMode} and note encrypted with AES-256-GCM (128-bit auth tag).`,
+            'success'
+          );
+        } catch (err) {
+          showStatus(`Encryption error: ${err.message || err}`, 'error');
+        }
+      }
+
+      async function handleDecryptActive() {
+        if (!state.activeEnvelope) {
+          showStatus('No encrypted delivery note payload selected.', 'error');
+          return;
+        }
+        try {
+          const result = await decryptDeliveryNoteEnvelope(state.activeEnvelope);
+          decryptedNoteText.textContent = result.plaintext;
+          decryptedAadText.textContent = `Verified AAD: Order ${result.aad.orderReference} (${result.aad.dropoffZone}) • Key Commitment ${result.secretFingerprint}`;
+          decryptedBox.classList.add('active');
+          showStatus(
+            'Authenticated decryption succeeded: shared secret decapsulated and GCM authentication tag + AAD verified.',
+            'success'
+          );
+        } catch (err) {
+          decryptedBox.classList.remove('active');
+          showStatus(
+            `AEAD Verification Failed (Tampered Ciphertext, AAD, or Key Mismatch): ${err.message || 'OperationError'}`,
+            'error'
+          );
+        }
+      }
+
+      document.querySelectorAll('.preset-chip').forEach((chip) => {
+        chip.addEventListener('click', () => {
+          customerNoteInput.value = chip.getAttribute('data-preset') || '';
+        });
+      });
+
+      formEl.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        await handleEncryptSubmit();
+      });
+
+      rotateKeysBtn.addEventListener('click', async () => {
+        const bundle = await CourierKeyStore.rotateKeys();
+        statRecipientKid.textContent = bundle.kid;
+        showStatus(`Rotated courier public keypair (${bundle.kid}). Subsequent notes will encapsulate to this key.`, 'success');
+      });
+
+      verifyDecryptBtn.addEventListener('click', async () => {
+        await handleDecryptActive();
+      });
+
+      kemModeSelect.addEventListener('change', () => {
+        statKemSuite.textContent = kemModeSelect.value;
+      });
+
+      // Initialize capabilities, generate initial hybrid post-quantum courier keypair, and seal initial note
+      (async function init() {
+        await detectCapabilities();
+        const bundle = await CourierKeyStore.rotateKeys();
+        statRecipientKid.textContent = bundle.kid;
+        pqcBadgeText.textContent = Capabilities.mlKem768
+          ? 'Native WebCrypto ML-KEM-768 + X25519 + AES-256-GCM'
+          : 'Hybrid PQC (X25519/P-256 + ML-KEM-768) + AES-256-GCM';
+        await handleEncryptSubmit();
+      })();
+    })();
+  </script>
 </body>
 
 </html>
