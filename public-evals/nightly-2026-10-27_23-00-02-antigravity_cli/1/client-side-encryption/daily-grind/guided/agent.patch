+        decryptedBanner.className = 'status-banner success';
+        decryptedBanner.textContent =
+          `Verified AAD (${orderRefInput.value.trim()}) & Decrypted: "${recoveredText}"`;
+      } catch (err) {
+        decryptedBanner.className = 'status-banner error';
+        decryptedBanner.textContent =
+          `AEAD Authentication Rejected (${err.name || 'OperationError'}): Ciphertext or Order Reference (AAD) was tampered with.`;
+      }
+    }
+
+    kemSuiteSelect.addEventListener('change', async () => {
+      await setupCourierKeys(false);
+      await handleEncryptNote();
+    });
+
+    rotateKeysBtn.addEventListener('click', async () => {
+      await setupCourierKeys(true);
+      await handleEncryptNote();
