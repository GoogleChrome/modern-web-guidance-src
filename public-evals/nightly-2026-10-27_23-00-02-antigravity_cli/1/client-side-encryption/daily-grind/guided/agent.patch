+  <script type="module">
+    const KEM_PUBLIC_KEY_ALGORITHMS = {
+      1184: 'ML-KEM-768',
+      1216: 'MLKEM768-X25519',
+      1568: 'ML-KEM-1024',
+    };
+
+    const IDB_NAME = 'daily-grind-crypto-store';
+    const IDB_STORE = 'courier-keys';
+
+    export function supportsPostQuantumEnvelope(kemAlgorithm = 'MLKEM768-X25519') {
+      return (
+        typeof globalThis.SubtleCrypto?.supports === 'function' &&
+        SubtleCrypto.supports('encapsulateKey', kemAlgorithm, 'ChaCha20-Poly1305')
+      );
+    }
+
+    function bytesToBase64(bytes) {
+      const uint8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+      if (typeof uint8.toBase64 === 'function') {
+        return uint8.toBase64();
+      }
+      let binary = '';
+      for (let i = 0; i < uint8.byteLength; i++) {
+        binary += String.fromCharCode(uint8[i]);
+      }
+      return btoa(binary);
+    }
+
+    function openKeyDatabase() {
+      return new Promise((resolve, reject) => {
+        if (!('indexedDB' in globalThis)) {
+          resolve(null);
+          return;
+        }
+        const request = indexedDB.open(IDB_NAME, 1);
+        request.onupgradeneeded = () => {
+          const db = request.result;
+          if (!db.objectStoreNames.contains(IDB_STORE)) {
+            db.createObjectStore(IDB_STORE);
+          }
+        };
+        request.onsuccess = () => resolve(request.result);
+        request.onerror = () => resolve(null);
+      });
+    }
+
+    async function loadPersistedKeyPair(storageKey) {
+      const db = await openKeyDatabase();
+      if (!db) return null;
+      return new Promise((resolve) => {
+        const tx = db.transaction(IDB_STORE, 'readonly');
+        const req = tx.objectStore(IDB_STORE).get(storageKey);
+        req.onsuccess = () => resolve(req.result || null);
+        req.onerror = () => resolve(null);
+      });
+    }
+
+    async function persistKeyPair(storageKey, keyPair) {
+      const db = await openKeyDatabase();
+      if (!db) return;
+      return new Promise((resolve) => {
+        const tx = db.transaction(IDB_STORE, 'readwrite');
+        tx.objectStore(IDB_STORE).put(keyPair, storageKey);
+        tx.oncomplete = () => resolve();
+        tx.onerror = () => resolve();
+      });
+    }
+
+    export async function generateRecipientKeys(preferredAlgorithm = 'MLKEM768-X25519', forceRotate = false) {
+      const usePQ =
+        preferredAlgorithm !== 'X25519' && supportsPostQuantumEnvelope(preferredAlgorithm);
+      const effectiveAlgo = usePQ ? preferredAlgorithm : 'X25519';
+      const storageKey = `recipient-kem-key:${effectiveAlgo}`;
+
+      if (!forceRotate) {
+        const cachedKeyPair = await loadPersistedKeyPair(storageKey);
+        if (cachedKeyPair?.publicKey && cachedKeyPair?.privateKey) {
+          try {
+            const format = usePQ ? 'raw-public' : 'raw';
+            const publicKeyBytes = new Uint8Array(
+              await crypto.subtle.exportKey(format, cachedKeyPair.publicKey),
+            );
+            return {
+              suite: usePQ ? `${effectiveAlgo}+ChaCha20-Poly1305` : 'X25519+HKDF+AES-GCM',
+              keyPair: cachedKeyPair,
+              publicKeyBytes,
+              keyFormat: format,
+            };
+          } catch {
+            // Fall through to generate a fresh key pair if cached key export fails
+          }
+        }
+      }
+
+      if (usePQ) {
+        const keyPair = await crypto.subtle.generateKey(
+          effectiveAlgo,
+          false,
+          ['encapsulateKey', 'decapsulateKey'],
+        );
+        await persistKeyPair(storageKey, keyPair);
+        const publicKeyBytes = new Uint8Array(
+          await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+        );
+        return {
+          suite: `${effectiveAlgo}+ChaCha20-Poly1305`,
+          keyPair,
+          publicKeyBytes,
+          keyFormat: 'raw-public',
+        };
+      }
+
+      // Classical fallback: X25519 key agreement + HKDF + AES-GCM
+      const keyPair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+      await persistKeyPair(storageKey, keyPair);
+      const publicKeyBytes = new Uint8Array(
+        await crypto.subtle.exportKey('raw', keyPair.publicKey),
+      );
+      return {
+        suite: 'X25519+HKDF+AES-GCM',
+        keyPair,
+        publicKeyBytes,
+        keyFormat: 'raw',
+      };
+    }
+
+    async function deriveFallbackAesKey(privateKey, peerPublicKey, infoBytes = new Uint8Array(0)) {
+      const sharedSecret = await crypto.subtle.deriveBits(
+        { name: 'X25519', public: peerPublicKey },
+        privateKey,
+        256,
+      );
+      const hkdfKey = await crypto.subtle.importKey('raw', sharedSecret, 'HKDF', false, ['deriveKey']);
+      return crypto.subtle.deriveKey(
+        {
+          name: 'HKDF',
+          hash: 'SHA-256',
+          salt: new Uint8Array(32),
+          info: infoBytes,
+        },
+        hkdfKey,
+        { name: 'AES-GCM', length: 256 },
+        false,
+        ['encrypt', 'decrypt'],
+      );
+    }
+
+    export async function encapsulateEnvelopeKey(
+      recipientPublicKeyOrBytes,
+      infoBytes = new Uint8Array(0),
+    ) {
+      const pubKey =
+        recipientPublicKeyOrBytes instanceof CryptoKey
+          ? recipientPublicKeyOrBytes
+          : await (() => {
+              const bytes =
+                recipientPublicKeyOrBytes instanceof Uint8Array
+                  ? recipientPublicKeyOrBytes
+                  : new Uint8Array(recipientPublicKeyOrBytes);
+              const kemName = KEM_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+              return kemName
+                ? crypto.subtle.importKey('raw-public', bytes, kemName, true, ['encapsulateKey'])
+                : crypto.subtle.importKey('raw', bytes, 'X25519', true, []);
+            })();
+
+      if (pubKey.algorithm.name !== 'X25519') {
+        const { sharedKey, ciphertext } = await crypto.subtle.encapsulateKey(
+          pubKey.algorithm.name,
+          pubKey,
+          'ChaCha20-Poly1305',
+          false,
+          ['encrypt', 'decrypt'],
+        );
+        return { sharedKey, capsuleBytes: new Uint8Array(ciphertext) };
+      }
+
+      // Classical fallback: generate ephemeral X25519 key pair and send ephemeral public key as capsule
+      const ephemeral = await crypto.subtle.generateKey('X25519', false, ['deriveBits']);
+      const capsuleBytes = new Uint8Array(await crypto.subtle.exportKey('raw', ephemeral.publicKey));
+      const sharedKey = await deriveFallbackAesKey(ephemeral.privateKey, pubKey, infoBytes);
+      return { sharedKey, capsuleBytes };
+    }
+
+    export async function decapsulateEnvelopeKey(
+      recipientPrivateKey,
+      capsuleBytes,
+      infoBytes = new Uint8Array(0),
+    ) {
+      if (recipientPrivateKey.algorithm.name !== 'X25519') {
+        return crypto.subtle.decapsulateKey(
+          recipientPrivateKey.algorithm.name,
+          recipientPrivateKey,
+          capsuleBytes,
+          'ChaCha20-Poly1305',
+          false,
+          ['encrypt', 'decrypt'],
+        );
+      }
+
+      const ephemeralPubKey = await crypto.subtle.importKey('raw', capsuleBytes, 'X25519', true, []);
+      return deriveFallbackAesKey(recipientPrivateKey, ephemeralPubKey, infoBytes);
+    }
+
+    export async function encryptMessage(key, plaintext, additionalData = new Uint8Array(0)) {
+      // Always generate a fresh 12-byte (96-bit) IV per message
+      const iv = crypto.getRandomValues(new Uint8Array(12));
+      const encoded = new TextEncoder().encode(plaintext);
+
+      const ciphertextBuffer = await crypto.subtle.encrypt(
+        {
+          name: key.algorithm.name,
+          iv,
+          additionalData,
+        },
+        key,
+        encoded,
+      );
+
+      return { iv, ciphertext: new Uint8Array(ciphertextBuffer) };
+    }
+
+    export async function decryptMessage(key, iv, ciphertext, additionalData = new Uint8Array(0)) {
+      const plaintextBuffer = await crypto.subtle.decrypt(
+        {
+          name: key.algorithm.name,
+          iv,
+          additionalData,
+        },
+        key,
+        ciphertext,
+      );
+
+      return new TextDecoder().decode(plaintextBuffer);
+    }
+
+    // UI State & Wiring
+    const suiteBadge = document.getElementById('active-suite-badge');
+    const kemSuiteSelect = document.getElementById('kem-suite-select');
+    const orderRefInput = document.getElementById('order-reference');
+    const noteInput = document.getElementById('delivery-note-input');
+    const encryptForm = document.getElementById('encrypt-note-form');
+    const rotateKeysBtn = document.getElementById('rotate-courier-keys-btn');
+    const decryptBtn = document.getElementById('decrypt-note-btn');
+    const tamperBtn = document.getElementById('tamper-aad-btn');
+    const senderStatus = document.getElementById('sender-status');
+    const decryptedBanner = document.getElementById('decrypted-output-banner');
+    const pubKeyFormatLabel = document.getElementById('public-key-format-label');
+    const pubKeyDisplay = document.getElementById('courier-public-key-display');
+    const capsuleSizeLabel = document.getElementById('capsule-size-label');
+    const capsuleDisplay = document.getElementById('capsule-display');
+    const aeadAlgoLabel = document.getElementById('aead-algo-label');
+    const ciphertextDisplay = document.getElementById('ciphertext-display');
+
+    let currentRecipient = null;
+    let currentEnvelope = null;
+
+    const domainInfoBytes = new TextEncoder().encode('daily-grind-delivery-note-v1');
+
+    async function setupCourierKeys(forceRotate = false) {
+      try {
+        const preferred = kemSuiteSelect.value;
+        currentRecipient = await generateRecipientKeys(preferred, forceRotate);
+        const pqSupported = supportsPostQuantumEnvelope(preferred);
+
+        suiteBadge.textContent = `Active Suite: ${currentRecipient.suite}`;
+        pubKeyFormatLabel.textContent = `${currentRecipient.keyFormat} • ${currentRecipient.publicKeyBytes.byteLength} bytes`;
+        pubKeyDisplay.textContent = bytesToBase64(currentRecipient.publicKeyBytes);
+
+        if (preferred !== 'X25519' && !pqSupported) {
+          senderStatus.className = 'status-banner';
+          senderStatus.textContent =
+            `Browser does not yet support ${preferred} via SubtleCrypto.supports(); transparently using X25519+HKDF+AES-GCM fallback.`;
+        } else {
+          senderStatus.className = 'status-banner';
+          senderStatus.textContent =
+            `Courier key pair ready (${currentRecipient.suite}). Non-extractable CryptoKeyPair persisted in IndexedDB.`;
+        }
+      } catch (err) {
+        senderStatus.className = 'status-banner error';
+        senderStatus.textContent = `Key setup error: ${err.message}`;
+      }
+    }
+
+    async function handleEncryptNote(event) {
+      if (event) event.preventDefault();
+      if (!currentRecipient) {
+        await setupCourierKeys(false);
+      }
+
+      try {
+        const plaintext = noteInput.value.trim();
+        const orderRef = orderRefInput.value.trim();
+        const aadBytes = new TextEncoder().encode(orderRef);
+
+        // Sender imports courier's public key bytes and encapsulates a one-time shared secret
+        const { sharedKey, capsuleBytes } = await encapsulateEnvelopeKey(
+          currentRecipient.publicKeyBytes,
+          domainInfoBytes,
+        );
+
+        const { iv, ciphertext } = await encryptMessage(sharedKey, plaintext, aadBytes);
+
+        currentEnvelope = {
+          capsuleBytes,
+          iv,
+          ciphertext,
+          aadBytes,
+          orderRef,
+          aeadName: sharedKey.algorithm.name,
+        };
+
+        capsuleSizeLabel.textContent = `${capsuleBytes.byteLength} bytes`;
+        capsuleDisplay.textContent = bytesToBase64(capsuleBytes);
+        aeadAlgoLabel.textContent = `${sharedKey.algorithm.name} • 12B IV + ${ciphertext.byteLength}B Ciphertext`;
+        ciphertextDisplay.textContent = `${bytesToBase64(iv)}.${bytesToBase64(ciphertext)}`;
+
+        decryptBtn.disabled = false;
+        tamperBtn.disabled = false;
+
+        senderStatus.className = 'status-banner success';
+        senderStatus.textContent =
+          `Sealed delivery note for ${orderRef} with a fresh 12-byte IV and ${capsuleBytes.byteLength}-byte key capsule.`;
+
+        decryptedBanner.className = 'status-banner';
+        decryptedBanner.textContent =
+          'Envelope received by courier. Click "Decapsulate & Decrypt Note" to verify AAD and recover plaintext.';
+      } catch (err) {
+        senderStatus.className = 'status-banner error';
+        senderStatus.textContent = `Encryption failed: ${err.message}`;
+      }
+    }
+
+    async function handleDecryptNote(tamperAad = false) {
+      if (!currentEnvelope || !currentRecipient) return;
+
+      try {
+        const recipientSharedKey = await decapsulateEnvelopeKey(
+          currentRecipient.keyPair.privateKey,
+          currentEnvelope.capsuleBytes,
+          domainInfoBytes,
+        );
+
+        const verificationAad = tamperAad
+          ? new TextEncoder().encode(`${currentEnvelope.orderRef}-TAMPERED`)
