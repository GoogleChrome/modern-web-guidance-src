+  <!-- Logout Confirmation Modal -->
+  <dialog id="logout-modal" aria-labelledby="logout-modal-title" aria-describedby="logout-modal-desc">
+    <h2 id="logout-modal-title">Confirm Logout</h2>
+    <p id="logout-modal-desc">Are you sure you want to log out of your Daily Grind account?</p>
+    <div class="modal-actions">
+      <button type="button" id="close-dialog-btn" class="btn btn-secondary">Cancel</button>
+      <a href="/logout" id="confirm-logout-btn" class="btn btn-accent">Log Out</a>
+    </div>
+  </dialog>
+
+  <!-- Dismissible Informational Floating Overlay -->
+  <div id="info-popover" popover="auto" role="status" aria-live="polite">
+    <span>online ordering is currently offline</span>
+    <button type="button" popovertarget="info-popover" popovertargetaction="hide" class="popover-dismiss-btn" aria-label="Dismiss notification">Dismiss</button>
+  </div>
+
+  <script>
+    const openDialogBtn = document.getElementById('open-dialog-btn');
+    const closeDialogBtn = document.getElementById('close-dialog-btn');
+    const logoutModal = document.getElementById('logout-modal');
+
+    if (openDialogBtn && logoutModal) {
+      openDialogBtn.addEventListener('click', (event) => {
+        event.preventDefault();
+        logoutModal.showModal();
+      });
+    }
+
+    if (closeDialogBtn && logoutModal) {
+      closeDialogBtn.addEventListener('click', () => {
+        logoutModal.close();
+      });
+    }
+
+    if (logoutModal) {
+      logoutModal.addEventListener('click', (event) => {
+        if (event.target === logoutModal) {
+          logoutModal.close();
+        }
+      });
+    }
+  </script>
