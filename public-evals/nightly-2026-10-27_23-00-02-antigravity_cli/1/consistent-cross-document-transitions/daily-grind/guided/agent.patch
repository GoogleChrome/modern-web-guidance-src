index 0000000..d1bce0e
--- /dev/null
+++ b/theme-layout.js
@@ -0,0 +1,58 @@
+// Apply initial theme and layout state before cross-document view transitions render
+(function initThemeAndLayout() {
+  try {
+    const savedTheme = localStorage.getItem('theme') || 'light';
+    const savedLayout = localStorage.getItem('layout') || 'grid';
+    document.documentElement.dataset.theme = savedTheme;
+    document.documentElement.dataset.layout = savedLayout;
+  } catch {
+    document.documentElement.dataset.theme = 'light';
+    document.documentElement.dataset.layout = 'grid';
+  }
+})();
+
+// Register pagereveal listener early while render-blocked so context-dependent
+// transitions are configured before the new page snapshot is taken
+window.addEventListener('pagereveal', async (event) => {
+  if (!event.viewTransition) return;
+
+  const from = window.navigation?.activation?.from;
+  if (!from) return;
+
+  const fromUrl = new URL(from.url);
+  const toUrl = new URL(window.location.href);
+
+  // Dynamically pair seasonal favorite card titles with detail page heading
+  const cardTransitionMap = {
+    '/menu/seasonal': 'seasonal-card-title',
+    '/menu/espresso': 'espresso-card-title',
+    '/menu/cold-brew': 'cold-brew-card-title',
+  };
+
+  const normalizePath = (pathname) => pathname.replace(/\/index\.html$/, '').replace(/\.html$/, '') || '/';
+  const fromPath = normalizePath(fromUrl.pathname);
+  const toPath = normalizePath(toUrl.pathname);
+
+  let targetElement = null;
+  const matchedDetailPath = cardTransitionMap[toPath] ? toPath : (cardTransitionMap[fromPath] ? fromPath : null);
+
+  if (matchedDetailPath && toPath === matchedDetailPath) {
+    targetElement = document.querySelector('#hero h1');
+    if (targetElement) {
+      targetElement.style.viewTransitionName = cardTransitionMap[matchedDetailPath];
+    }
+  }
+
+  if (!targetElement) return;
+
+  try {
+    await event.viewTransition.ready;
+  } catch (error) {
+    if (error.name !== 'InvalidStateError') {
+      throw error;
+    }
+  } finally {
+    await event.viewTransition.finished;
+    targetElement.style.viewTransitionName = '';
+  }
+});
