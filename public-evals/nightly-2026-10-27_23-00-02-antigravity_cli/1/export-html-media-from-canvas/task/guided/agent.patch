+  <script>
+    const canvas = document.getElementById('gift-card-canvas');
+    const ctx = canvas.getContext('2d');
+    const export_element = document.getElementById('export_element');
+    const previewWrapper = document.querySelector('.canvas-preview-wrapper');
+    const messageInput = document.getElementById('card-message-input');
+    const recipientInput = document.getElementById('card-recipient-input');
+    const colorInput = document.getElementById('card-color-input');
+    const colorSwatches = document.querySelectorAll('.color-swatch');
+    const messageText = document.getElementById('card-message-text');
+    const recipientText = document.getElementById('card-recipient-text');
+    const exportBtn = document.getElementById('export-card-btn');
+    const supportNotice = document.getElementById('canvas-support-notice');
+
+    const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+    function requestCanvasPaint() {
+      if (typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      }
+    }
+
+    if (supportsHtmlInCanvas) {
+      canvas.onpaint = (event) => {
+        ctx.reset();
+        ctx.drawElementImage(export_element, 0, 0);
+      };
+    } else {
+      previewWrapper.classList.add('fallback-mode');
+      previewWrapper.appendChild(export_element);
+      supportNotice.textContent = 'Note: HTML-in-Canvas is not natively supported in this browser; using canvas fallback for export.';
+      supportNotice.style.display = 'block';
+    }
+
+    // Scale canvas grid to match the device scale factor to prevent blurriness
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      requestCanvasPaint();
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: 'device-pixel-content-box' }
+      : {};
+    observer.observe(canvas, options);
+
+    // Synchronize inputs with #export_element and trigger paint update
+    messageInput.addEventListener('input', (e) => {
+      messageText.textContent = e.target.value || 'Enjoy a freshly brewed cup!';
+      requestCanvasPaint();
+    });
+
+    recipientInput.addEventListener('input', (e) => {
+      recipientText.textContent = e.target.value || 'For a Coffee Lover';
+      requestCanvasPaint();
+    });
+
+    function setCardBackgroundColor(color) {
+      export_element.style.backgroundColor = color;
+      colorInput.value = color;
+      colorSwatches.forEach((swatch) => {
+        swatch.classList.toggle('active', swatch.dataset.color.toLowerCase() === color.toLowerCase());
+      });
+      requestCanvasPaint();
+    }
+
+    colorSwatches.forEach((swatch) => {
+      swatch.addEventListener('click', () => {
+        setCardBackgroundColor(swatch.dataset.color);
+      });
+    });
+
+    colorInput.addEventListener('input', (e) => {
+      setCardBackgroundColor(e.target.value);
+    });
+
+    function drawFallbackCard() {
+      const dpr = window.devicePixelRatio || 1;
+      const w = canvas.width / dpr;
+      const h = canvas.height / dpr;
+      ctx.save();
+      ctx.clearRect(0, 0, canvas.width, canvas.height);
+      ctx.scale(dpr, dpr);
+
+      ctx.fillStyle = export_element.style.backgroundColor || '#4e342e';
+      ctx.beginPath();
+      if (ctx.roundRect) {
+        ctx.roundRect(0, 0, w, h, 16);
+      } else {
+        ctx.rect(0, 0, w, h);
+      }
+      ctx.fill();
+
+      ctx.fillStyle = '#ffffff';
+      ctx.font = 'bold 15px "Segoe UI", sans-serif';
+      ctx.fillText('THE DAILY GRIND', 28, 42);
+      ctx.fillText('$25', w - 60, 42);
+
+      ctx.font = '600 21px "Segoe UI", sans-serif';
+      ctx.fillText(messageText.textContent, 28, 125, w - 56);
+
+      ctx.font = '15px "Segoe UI", sans-serif';
+      ctx.fillText(recipientText.textContent, 28, 158, w - 56);
+
+      ctx.font = '12px "Segoe UI", sans-serif';
+      ctx.fillText('GIFT CARD', 28, h - 24);
+      ctx.fillText('TDG-2026-COFFEE', w - 145, h - 24);
+      ctx.restore();
+    }
+
+    exportBtn.addEventListener('click', () => {
+      if (!supportsHtmlInCanvas) {
+        drawFallbackCard();
+      }
+      const dataURL = canvas.toDataURL('image/png');
+      const link = document.createElement('a');
+      link.download = 'daily-grind-gift-card.png';
+      link.href = dataURL;
+      link.click();
+    });
+  </script>
 </body>
 
