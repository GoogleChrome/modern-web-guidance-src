+  <script>
+    (function () {
+      const canvas = document.getElementById('gift-card-canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const recipientInput = document.getElementById('gc-recipient-input');
+      const messageInput = document.getElementById('gc-message-input');
+      const colorInput = document.getElementById('gc-bg-color');
+      const swatches = document.querySelectorAll('.color-swatch');
+      const recipientDisplay = document.getElementById('gc-recipient-display');
+      const messageDisplay = document.getElementById('gc-message-display');
+      const exportBtn = document.getElementById('export-card-btn');
+
+      // Feature detection for HTML-in-Canvas APIs
+      function supportsHtmlInCanvas() {
+        return (
+          typeof CanvasRenderingContext2D !== 'undefined' &&
+          ('drawElementImage' in CanvasRenderingContext2D.prototype ||
+            'drawElement' in CanvasRenderingContext2D.prototype) &&
+          'layoutsubtree' in HTMLCanvasElement.prototype
+        );
+      }
+
+      // Render #export_element into the canvas
+      function renderCardToCanvas() {
+        if (!ctx || !exportElement) return;
+
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        if (typeof ctx.drawElementImage === 'function') {
+          const transform = ctx.drawElementImage(exportElement, 0, 0);
+          if (transform) {
+            exportElement.style.transform = transform.toString();
+          }
+          return;
+        }
+
+        if (typeof ctx.drawElement === 'function') {
+          const transform = ctx.drawElement(exportElement, 0, 0);
+          if (transform) {
+            exportElement.style.transform = transform.toString();
+          }
+          return;
+        }
+
+        // Fallback canvas rendering when HTML-in-Canvas is not enabled in the browser
+        const bgColor = exportElement.style.backgroundColor || colorInput.value || '#4e342e';
+        ctx.fillStyle = bgColor;
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(0, 0, canvas.width, canvas.height, 14);
+        } else {
+          ctx.rect(0, 0, canvas.width, canvas.height);
+        }
+        ctx.fill();
+
+        // Header
+        ctx.fillStyle = '#ffab40';
+        ctx.font = 'bold 18px "Segoe UI", sans-serif';
+        ctx.fillText('THE DAILY GRIND', 28, 46);
+
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.2)';
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(290, 26, 122, 28, 14);
+        } else {
+          ctx.rect(290, 26, 122, 28);
+        }
+        ctx.fill();
+
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'bold 13px "Segoe UI", sans-serif';
+        ctx.fillText('$25 GIFT CARD', 302, 45);
+
+        // Body message
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '600 21px "Segoe UI", sans-serif';
+        ctx.fillText(messageDisplay.textContent || '', 28, 135, 384);
+
+        // Footer divider
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(28, 205);
+        ctx.lineTo(412, 205);
+        ctx.stroke();
+
+        // Footer text
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
+        ctx.font = '14px "Segoe UI", sans-serif';
+        ctx.fillText('For: ' + (recipientDisplay.textContent || ''), 28, 230);
+        ctx.fillText('Redeemable in-store & online', 230, 230);
+      }
+
+      // Synchronize rendering via the HTML-in-Canvas paint event
+      canvas.addEventListener('paint', () => {
+        renderCardToCanvas();
+      });
+
+      function requestCanvasUpdate() {
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+        renderCardToCanvas();
+      }
+
+      // Update live card DOM and synchronize canvas
+      recipientInput.addEventListener('input', (e) => {
+        recipientDisplay.textContent = e.target.value || 'Coffee Lover';
+        requestCanvasUpdate();
+      });
+
+      messageInput.addEventListener('input', (e) => {
+        messageDisplay.textContent = e.target.value || 'Enjoy a warm cup on me!';
+        requestCanvasUpdate();
+      });
+
+      function updateBackgroundColor(color) {
+        exportElement.style.backgroundColor = color;
+        colorInput.value = color;
+        swatches.forEach((swatch) => {
+          swatch.classList.toggle('active', swatch.dataset.color.toLowerCase() === color.toLowerCase());
+        });
+        requestCanvasUpdate();
+      }
+
+      colorInput.addEventListener('input', (e) => {
+        updateBackgroundColor(e.target.value);
+      });
+
+      swatches.forEach((swatch) => {
+        swatch.addEventListener('click', () => {
+          updateBackgroundColor(swatch.dataset.color);
+        });
+      });
+
+      // Export / download the canvas design as a PNG image
+      exportBtn.addEventListener('click', () => {
+        requestCanvasUpdate();
+        if (typeof canvas.toBlob === 'function') {
+          canvas.toBlob((blob) => {
+            if (!blob) return;
+            const url = URL.createObjectURL(blob);
+            const link = document.createElement('a');
+            link.download = 'daily-grind-gift-card.png';
+            link.href = url;
+            document.body.appendChild(link);
+            link.click();
+            document.body.removeChild(link);
+            URL.revokeObjectURL(url);
+          }, 'image/png');
+        } else {
+          const dataUrl = canvas.toDataURL('image/png');
+          const link = document.createElement('a');
+          link.download = 'daily-grind-gift-card.png';
+          link.href = dataUrl;
+          document.body.appendChild(link);
+          link.click();
+          document.body.removeChild(link);
+        }
+      });
+
+      // Initial render
+      if (supportsHtmlInCanvas() && typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      }
+      renderCardToCanvas();
+    })();
+  </script>
 </body>
 
