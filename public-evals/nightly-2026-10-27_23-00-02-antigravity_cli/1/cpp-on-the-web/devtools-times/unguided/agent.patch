@@ -0,0 +1,318 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColor {
+  name: string;
+  r: number;
+  g: number;
+  b: number;
+}
+
+interface SmallptModule {
+  _render_smallpt: (w: number, h: number, samps: number, accumulate: number) => number;
+  _randomize_sphere_colors: (seed: number) => void;
+  _reset_scene_colors: () => void;
+  _get_sphere_color_channel: (index: number, channel: number) => number;
+  _get_total_passes: () => number;
+  HEAPU8: Uint8Array;
+}
+
+declare global {
+  interface Window {
+    createSmallptModule?: (options?: Record<string, unknown>) => Promise<SmallptModule>;
+  }
+}
+
+const SPHERE_LABELS: { index: number; name: string }[] = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 4, name: 'Floor' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+function toDisplayHex(r: number, g: number, b: number): string {
+  const gamma = (c: number) => Math.min(255, Math.max(0, Math.round(Math.pow(Math.max(0, Math.min(1, c)), 1 / 2.2) * 255)));
+  const hex = (n: number) => n.toString(16).padStart(2, '0');
+  return `#${hex(gamma(r))}${hex(gamma(g))}${hex(gamma(b))}`;
+}
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const wasmModuleRef = useRef<SmallptModule | null>(null);
+  const renderJobRef = useRef<number>(0);
+
+  const [status, setStatus] = useState<'loading' | 'rendering' | 'ready' | 'error'>('loading');
+  const [samplesPerPixel, setSamplesPerPixel] = useState<number>(0);
+  const [renderTimeMs, setRenderTimeMs] = useState<number>(0);
+  const [resolution] = useState<{ w: number; h: number }>({ w: 240, h: 180 });
+  const [targetPasses, setTargetPasses] = useState<number>(4);
+  const [sphereColors, setSphereColors] = useState<SphereColor[]>([]);
+
+  const readSphereColors = useCallback((mod: SmallptModule) => {
+    const colors: SphereColor[] = SPHERE_LABELS.map(({ index, name }) => ({
+      name,
+      r: mod._get_sphere_color_channel(index, 0),
+      g: mod._get_sphere_color_channel(index, 1),
+      b: mod._get_sphere_color_channel(index, 2),
+    }));
+    setSphereColors(colors);
+  }, []);
+
+  const runProgressiveRender = useCallback(
+    (mod: SmallptModule, passesToRun: number) => {
+      const jobId = ++renderJobRef.current;
+      setStatus('rendering');
+      const { w, h } = resolution;
+      let currentPass = 0;
+      let accumulatedTime = 0;
+
+      const step = () => {
+        if (renderJobRef.current !== jobId) return;
+
+        const t0 = performance.now();
+        const accumulateFlag = currentPass === 0 ? 0 : 1;
+        const ptr = mod._render_smallpt(w, h, 1, accumulateFlag);
+        const dt = performance.now() - t0;
+        accumulatedTime += dt;
+
+        const canvas = canvasRef.current;
+        if (canvas) {
+          const ctx = canvas.getContext('2d');
+          if (ctx) {
+            const pixelView = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, w * h * 4);
+            const copy = new Uint8ClampedArray(pixelView);
+            const imgData = new ImageData(copy, w, h);
+            ctx.putImageData(imgData, 0, 0);
+          }
+        }
+
+        currentPass++;
+        const totalSubpixelPasses = mod._get_total_passes();
+        setSamplesPerPixel(totalSubpixelPasses * 4);
+        setRenderTimeMs(Math.round(accumulatedTime));
+
+        if (currentPass < passesToRun) {
+          requestAnimationFrame(step);
+        } else {
+          setStatus('ready');
+        }
+      };
+
+      requestAnimationFrame(step);
+    },
+    [resolution]
+  );
+
+  useEffect(() => {
+    let cancelled = false;
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+    const scriptUrl = `${normalizedBase}smallpt.js`;
+    const wasmUrl = `${normalizedBase}smallpt.wasm`;
+
+    const initWasm = async () => {
+      try {
+        if (!window.createSmallptModule) {
+          await new Promise<void>((resolve, reject) => {
+            const existing = document.querySelector(`script[data-smallpt-wasm="true"]`) as HTMLScriptElement | null;
+            if (existing && window.createSmallptModule) {
+              resolve();
+              return;
+            }
+            const script = document.createElement('script');
+            script.src = scriptUrl;
+            script.async = true;
+            script.dataset.smallptWasm = 'true';
+            script.onload = () => resolve();
+            script.onerror = () => {
+              // Fallback to root path if served without base prefix
+              const fallbackScript = document.createElement('script');
+              fallbackScript.src = '/smallpt.js';
+              fallbackScript.async = true;
+              fallbackScript.onload = () => resolve();
+              fallbackScript.onerror = () => reject(new Error('Failed to load smallpt.js'));
+              document.head.appendChild(fallbackScript);
+            };
+            document.head.appendChild(script);
+          });
+        }
+
+        if (cancelled || !window.createSmallptModule) return;
+
+        const mod = await window.createSmallptModule({
+          locateFile: (path: string) => {
+            if (path.endsWith('.wasm')) {
+              return wasmUrl;
+            }
+            return path;
+          },
+        });
+
+        if (cancelled) return;
+        wasmModuleRef.current = mod;
+        readSphereColors(mod);
+        runProgressiveRender(mod, targetPasses);
+      } catch (err) {
+        console.error('Error initializing smallpt WebAssembly module:', err);
+        if (!cancelled) setStatus('error');
+      }
+    };
+
+    initWasm();
+
+    return () => {
+      cancelled = true;
+      renderJobRef.current++;
+    };
+  }, [readSphereColors, runProgressiveRender, targetPasses]);
+
+  const handleRandomizeAndRender = () => {
+    const mod = wasmModuleRef.current;
+    if (!mod) return;
+    const seed = Math.floor(Math.random() * 0xffffffff) >>> 0;
+    mod._randomize_sphere_colors(seed);
+    readSphereColors(mod);
+    runProgressiveRender(mod, targetPasses);
+  };
+
+  const handleResetScene = () => {
+    const mod = wasmModuleRef.current;
+    if (!mod) return;
+    mod._reset_scene_colors();
+    readSphereColors(mod);
+    runProgressiveRender(mod, targetPasses);
+  };
+
+  return (
+    <section
+      id="smallpt-wasm-showcase"
+      className="my-6 bg-gray-900 text-white rounded-xl shadow-lg border border-gray-800 overflow-hidden"
+    >
+      <div className="p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
+        <div className="lg:col-span-7 flex flex-col items-center">
+          <div className="relative w-full max-w-[480px] aspect-[4/3] bg-black rounded-lg overflow-hidden border border-gray-700 shadow-inner flex items-center justify-center">
+            <canvas
+              ref={canvasRef}
+              width={resolution.w}
+              height={resolution.h}
+              id="smallpt-canvas"
+              className="w-full h-full object-contain"
+              style={{ imageRendering: 'auto' }}
+            />
+            {status === 'loading' && (
+              <div className="absolute inset-0 flex flex-col items-center justify-center bg-black/80 text-sm text-gray-300">
+                <span>Loading WebAssembly Path Tracer...</span>
+              </div>
+            )}
+            {status === 'error' && (
+              <div className="absolute inset-0 flex flex-col items-center justify-center bg-red-950/90 text-sm text-red-200 p-4 text-center">
+                <span>Failed to initialize WebAssembly module.</span>
+              </div>
+            )}
+          </div>
+
+          <div className="mt-3 flex flex-wrap items-center justify-between w-full max-w-[480px] text-xs text-gray-400 gap-2">
+            <span>
+              Resolution: <strong className="text-gray-200">{resolution.w}×{resolution.h}</strong>
+            </span>
+            <span>
+              Samples: <strong className="text-amber-400">{samplesPerPixel} spp</strong>
+            </span>
+            <span>
+              Render Time: <strong className="text-gray-200">{renderTimeMs} ms</strong>
+            </span>
+            <span className="uppercase tracking-wider font-semibold text-emerald-400">
+              {status === 'rendering' ? 'Tracing Rays (WASM)...' : status === 'ready' ? 'Complete' : status}
+            </span>
+          </div>
+        </div>
+
+        <div className="lg:col-span-5 flex flex-col justify-between space-y-5">
+          <div>
+            <div className="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30 mb-3">
+              Interactive WebAssembly Demo
+            </div>
+            <h2 className="text-2xl font-bold tracking-tight text-white">
+              smallpt C++ Path Tracer in WebAssembly
+            </h2>
+            <p className="mt-2 text-sm text-gray-300 leading-relaxed">
+              Kevin Beason&apos;s classic 99-line C++ Monte Carlo global illumination path tracer (
+              <a
+                href="http://www.kevinbeason.com/smallpt/"
+                target="_blank"
+                rel="noopener noreferrer"
+                className="text-amber-400 underline hover:text-amber-300"
+              >
+                smallpt
+              </a>
+              ) compiled to WebAssembly with Emscripten and running client-side directly in your browser.
+            </p>
+          </div>
+
+          {sphereColors.length > 0 && (
+            <div>
+              <h3 className="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">
+                Current Scene Sphere Colors
+              </h3>
+              <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
+                {sphereColors.map((sphere) => {
+                  const hex = toDisplayHex(sphere.r, sphere.g, sphere.b);
+                  return (
+                    <div
+                      key={sphere.name}
+                      className="flex items-center gap-2 bg-gray-800/80 border border-gray-700/70 rounded px-2.5 py-1.5 text-xs"
+                    >
+                      <span
+                        className="w-3.5 h-3.5 rounded-full border border-white/20 shrink-0"
+                        style={{ backgroundColor: hex }}
+                      />
+                      <span className="truncate text-gray-200">{sphere.name}</span>
+                    </div>
+                  );
+                })}
+              </div>
+            </div>
+          )}
+
+          <div className="flex flex-wrap items-center gap-3 pt-2">
+            <button
+              type="button"
+              id="randomize-spheres-btn"
+              onClick={handleRandomizeAndRender}
+              className="px-4 py-2.5 bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-gray-950 font-semibold text-sm rounded-lg shadow transition cursor-pointer"
+            >
+              Run Again with Randomized Sphere Colors
+            </button>
+
+            <button
+              type="button"
+              id="reset-spheres-btn"
+              onClick={handleResetScene}
+              className="px-3.5 py-2.5 bg-gray-800 hover:bg-gray-700 text-gray-200 font-medium text-sm rounded-lg border border-gray-700 transition cursor-pointer"
+            >
+              Reset Classic Cornell Box
+            </button>
+          </div>
+
+          <div className="flex items-center gap-3 text-xs text-gray-400 pt-1">
+            <label htmlFor="smallpt-passes-select" className="font-medium">
+              Quality Passes:
+            </label>
+            <select
+              id="smallpt-passes-select"
+              value={targetPasses}
+              onChange={(e) => setTargetPasses(Number(e.target.value))}
+              className="bg-gray-800 border border-gray-700 text-gray-200 rounded px-2 py-1 text-xs"
+            >
+              <option value={1}>Fast (4 spp)</option>
+              <option value={4}>Balanced (16 spp)</option>
+              <option value={8}>High (32 spp)</option>
+              <option value={16}>Ultra (64 spp)</option>
+            </select>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
