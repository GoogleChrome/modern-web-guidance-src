+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+static Vec *accum_buffer = nullptr;
+static uint8_t *rgba_buffer = nullptr;
+static int current_w = 0;
+static int current_h = 0;
+static int total_spp = 0;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) {
+    spheres[index].c = Vec(r, g, b);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_r(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.x : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_g(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.y : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_b(int index) {
+  return (index >= 0 && index < 9) ? spheres[index].c.z : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_default_colors() {
+  spheres[0].c = Vec(.75, .25, .25);
+  spheres[1].c = Vec(.25, .25, .75);
+  spheres[2].c = Vec(.75, .75, .75);
+  spheres[3].c = Vec(0, 0, 0);
+  spheres[4].c = Vec(.75, .75, .75);
+  spheres[5].c = Vec(.75, .75, .75);
+  spheres[6].c = Vec(1, 1, 1) * .999;
+  spheres[7].c = Vec(1, 1, 1) * .999;
+  spheres[8].c = Vec(0, 0, 0);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)((seed * 31337) & 0xFFFF)
+  };
+  // Randomize Left (0), Right (1), Back (2), Bottom (4), Top (5), Mirror (6), Glass (7)
+  // Keep Front wall (3) black so camera isn't blocked, and Light (8) emissive
+  int indices[] = {0, 1, 2, 4, 5, 6, 7};
+  for (int i = 0; i < 7; i++) {
+    int idx = indices[i];
+    if (idx == 6 || idx == 7) {
+      // For mirror and glass, give vibrant tinted colors (high brightness so reflections/refractions stay bright)
+      double r = 0.45 + 0.549 * erand48(Xi);
+      double g = 0.45 + 0.549 * erand48(Xi);
+      double b = 0.45 + 0.549 * erand48(Xi);
+      spheres[idx].c = Vec(r, g, b);
+    } else {
+      // Diffuse walls: rich colors between 0.15 and 0.85
+      double r = 0.15 + 0.70 * erand48(Xi);
+      double g = 0.15 + 0.70 * erand48(Xi);
+      double b = 0.15 + 0.70 * erand48(Xi);
+      spheres[idx].c = Vec(r, g, b);
+    }
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void init_renderer(int w, int h) {
+  if (current_w != w || current_h != h) {
+    if (accum_buffer) delete[] accum_buffer;
+    if (rgba_buffer) delete[] rgba_buffer;
+    accum_buffer = new Vec[w * h];
+    rgba_buffer = new uint8_t[w * h * 4];
+    current_w = w;
+    current_h = h;
+  }
+  for (int i = 0; i < w * h; i++) {
+    accum_buffer[i] = Vec(0, 0, 0);
+  }
+  total_spp = 0;
+}
+
+// Renders `samples_per_subpixel` samples for each of the 2x2 subpixels (total 4 * samples_per_subpixel spp added)
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_samples(int samples_per_subpixel, unsigned int pass_seed) {
+  int w = current_w;
+  int h = current_h;
+  if (!accum_buffer || !rgba_buffer || w <= 0 || h <= 0) return nullptr;
+
+  int samps = samples_per_subpixel < 1 ? 1 : samples_per_subpixel;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx = Vec(w*.5135/h), cy = (cx%cam.d).norm()*.5135, r;
+
+  for (int y=0; y<h; y++){                       // Loop over image rows
+    unsigned short Xi[3] = {
+      (unsigned short)(y ^ (pass_seed & 0xFFFF)),
+      (unsigned short)((y * y) ^ ((pass_seed >> 16) & 0xFFFF)),
+      (unsigned short)((y * 997 + pass_seed * 131) & 0xFFFF)
+    };
+    for (unsigned short x=0; x<w; x++)   // Loop cols
+      for (int sy=0, i=(h-y-1)*w+x; sy<2; sy++)     // 2x2 subpixel rows
+        for (int sx=0; sx<2; sx++, r=Vec()){        // 2x2 subpixel cols
+          for (int s=0; s<samps; s++){
+            double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+            double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+            Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                    cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+          } // Camera rays are pushed ^^^^^ forward to start in interior
+          accum_buffer[i] = accum_buffer[i] + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+        }
+  }
+
+  total_spp += samps * 4;
+  double num_passes = (double)(total_spp) / 4.0;
+  double inv_passes = 1.0 / num_passes;
+
+  for (int i = 0; i < w * h; i++) {
+    rgba_buffer[i * 4 + 0] = toInt(accum_buffer[i].x * inv_passes);
+    rgba_buffer[i * 4 + 1] = toInt(accum_buffer[i].y * inv_passes);
+    rgba_buffer[i * 4 + 2] = toInt(accum_buffer[i].z * inv_passes);
+    rgba_buffer[i * 4 + 3] = 255;
+  }
+
+  return rgba_buffer;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_total_spp() {
+  return total_spp;
+}
+
+// One-shot full render for convenience
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render(int w, int h, int spp, unsigned int seed) {
+  init_renderer(w, h);
+  int samps = (spp / 4) < 1 ? 1 : (spp / 4);
+  return render_samples(samps, seed);
+}
+
+}
