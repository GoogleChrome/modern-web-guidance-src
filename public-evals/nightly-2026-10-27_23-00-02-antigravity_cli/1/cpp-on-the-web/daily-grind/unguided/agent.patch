+  <script>
+    const SPHERE_DEFINITIONS = [
+      { index: 0, name: 'Left Wall (DIFF)' },
+      { index: 1, name: 'Right Wall (DIFF)' },
+      { index: 2, name: 'Back Wall (DIFF)' },
+      { index: 4, name: 'Floor (DIFF)' },
+      { index: 5, name: 'Ceiling (DIFF)' },
+      { index: 6, name: 'Mirror Sphere (SPEC)' },
+      { index: 7, name: 'Glass Sphere (REFR)' }
+    ];
+
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const sppSelect = document.getElementById('spp-select');
+    const sppValueEl = document.getElementById('spp-value');
+    const targetSppLabelEl = document.getElementById('target-spp-label');
+    const resValueEl = document.getElementById('res-value');
+    const timeValueEl = document.getElementById('time-value');
+    const renderStateEl = document.getElementById('render-state');
+    const statusPillEl = document.getElementById('status-pill');
+    const progressFillEl = document.getElementById('progress-fill');
+    const swatchesContainer = document.getElementById('sphere-swatches');
+
+    let wasmReady = false;
+    let currentJobId = 0;
+    let renderStartTime = 0;
+    let totalElapsedMs = 0;
+    let seedCounter = 101;
+
+    function toDisplayRgb(val) {
+      const clamped = Math.max(0, Math.min(1, val));
+      return Math.round(Math.pow(clamped, 1 / 2.2) * 255);
+    }
+
+    function updateSphereSwatches() {
+      if (!wasmReady) return;
+      swatchesContainer.innerHTML = '';
+      for (const item of SPHERE_DEFINITIONS) {
+        const r = Module._get_sphere_color_r(item.index);
+        const g = Module._get_sphere_color_g(item.index);
+        const b = Module._get_sphere_color_b(item.index);
+        const dr = toDisplayRgb(r);
+        const dg = toDisplayRgb(g);
+        const db = toDisplayRgb(b);
+
+        const chip = document.createElement('div');
+        chip.className = 'sphere-chip';
+        chip.innerHTML = `
+          <span class="swatch" style="background: rgb(${dr}, ${dg}, ${db});"></span>
+          <div class="sphere-meta">
+            <div class="sphere-name">${item.name}</div>
+            <div class="sphere-rgb">(${r.toFixed(2)}, ${g.toFixed(2)}, ${b.toFixed(2)})</div>
+          </div>
+        `;
+        swatchesContainer.appendChild(chip);
+      }
+    }
+
+    function parseResolution() {
+      const [w, h] = resolutionSelect.value.split('x').map(Number);
+      return { w, h };
+    }
+
+    function startProgressiveRender() {
+      if (!wasmReady) return;
+
+      currentJobId++;
+      const jobId = currentJobId;
+
+      const { w, h } = parseResolution();
+      const targetSpp = parseInt(sppSelect.value, 10) || 32;
+
+      if (canvas.width !== w || canvas.height !== h) {
+        canvas.width = w;
+        canvas.height = h;
+      }
+
+      resValueEl.textContent = `${w}×${h}`;
+      targetSppLabelEl.textContent = targetSpp;
+      sppValueEl.textContent = '0';
+      progressFillEl.style.width = '0%';
+      totalElapsedMs = 0;
+      renderStartTime = performance.now();
+
+      Module._init_renderer(w, h);
+      updateSphereSwatches();
+
+      renderStateEl.textContent = 'Path tracing in progress...';
+      statusPillEl.textContent = 'Rendering (WASM)';
+
+      function runPass() {
+        if (jobId !== currentJobId) return;
+
+        const t0 = performance.now();
+        seedCounter = (seedCounter * 1664525 + 1013904223) >>> 0;
+        // 1 sample per subpixel = 4 SPP per progressive pass
+        const ptr = Module._render_samples(1, seedCounter);
+        const t1 = performance.now();
+        totalElapsedMs += (t1 - t0);
+
+        const currentSpp = Module._get_total_spp();
+        const byteLength = w * h * 4;
+        const pixels = new Uint8ClampedArray(Module.HEAPU8.buffer, ptr, byteLength);
+        const imageData = new ImageData(new Uint8ClampedArray(pixels), w, h);
+        ctx.putImageData(imageData, 0, 0);
+
+        sppValueEl.textContent = currentSpp;
+        timeValueEl.textContent = `${Math.round(totalElapsedMs)} ms`;
+        const pct = Math.min(100, Math.round((currentSpp / targetSpp) * 100));
+        progressFillEl.style.width = `${pct}%`;
+
+        if (currentSpp < targetSpp) {
+          requestAnimationFrame(runPass);
+        } else {
+          renderStateEl.textContent = `Completed ${currentSpp} SPP`;
+          statusPillEl.textContent = 'Ready (WASM)';
+        }
+      }
+
+      // Run the first pass immediately so the canvas has rendered output right away
+      runPass();
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      if (!wasmReady) return;
+      seedCounter = ((Date.now() & 0xFFFFFFFF) ^ (seedCounter + 7919)) >>> 0;
+      if (seedCounter === 0) seedCounter = 42;
+      Module._randomize_sphere_colors(seedCounter);
+      startProgressiveRender();
+    });
+
+    resetBtn.addEventListener('click', () => {
+      if (!wasmReady) return;
+      Module._reset_default_colors();
+      startProgressiveRender();
+    });
+
+    resolutionSelect.addEventListener('change', () => {
+      startProgressiveRender();
+    });
+
+    sppSelect.addEventListener('change', () => {
+      startProgressiveRender();
+    });
+
+    var Module = {
+      onRuntimeInitialized: function () {
+        wasmReady = true;
+        randomizeBtn.disabled = false;
+        resetBtn.disabled = false;
+        statusPillEl.textContent = 'Ready (WASM)';
+        startProgressiveRender();
+      }
+    };
+  </script>
+  <script src="smallpt.js"></script>
