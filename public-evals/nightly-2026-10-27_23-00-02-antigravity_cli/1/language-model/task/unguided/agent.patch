+  <script>
+    // Menu knowledge base for system prompt
+    const BARISTA_SYSTEM_PROMPT = `You are a friendly and knowledgeable barista at "The Daily Grind" artisanal coffee shop.
+You specialize in answering questions about our two signature drinks:
+1. Maple Oat Latte: Made with creamy oat milk, rich espresso, and a hint of authentic Vermont maple syrup. Smooth, comforting, dairy-free, and lightly sweet.
+2. Cold Brew: Coarse-ground ethically sourced beans steeped in cold water for 18 hours for maximum smoothness and low acidity.
+Keep your answers helpful, concise, and focused on the Maple Oat Latte and Cold Brew.`;
+
+    let activeSession = null;
+    let currentAbortController = null;
+    const clonedSessions = [];
+    const MAX_CLONED_SESSIONS = 2;
+
+    // UI Elements
+    const modelStatusEl = document.getElementById('model-status');
+    const downloadStatusEl = document.getElementById('download-status');
+    const progressContainerEl = document.getElementById('download-progress-container');
+    const progressBarEl = document.getElementById('download-progress-bar');
+    const baristaQuestionEl = document.getElementById('barista-question');
+    const askBaristaBtn = document.getElementById('ask-the-barista');
+    const baristaAnswerEl = document.getElementById('barista-answer');
+
+    const feedbackInputEl = document.getElementById('feedback-input');
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const sentimentOutputEl = document.getElementById('sentiment-output');
+
+    const cloneBtn = document.getElementById('clone-btn');
+    const cleanupBtn = document.getElementById('cleanup-btn');
+    const contextUsageEl = document.getElementById('context-usage');
+    const activeSessionsCountEl = document.getElementById('active-sessions-count');
+    const branchOutputEl = document.getElementById('branch-output');
+
+    /**
+     * Resolve the built-in LanguageModel provider across modern Chrome Prompt API namespaces.
+     */
+    function getLanguageModelNamespace() {
+      if (typeof LanguageModel !== 'undefined') {
+        return LanguageModel;
+      }
+      if (typeof window !== 'undefined' && window.ai && window.ai.languageModel) {
+        return window.ai.languageModel;
+      }
+      return null;
+    }
+
+    /**
+     * Check if the built-in AI model is available before starting.
+     */
+    async function checkModelAvailability() {
+      const lm = getLanguageModelNamespace();
+      if (!lm) {
+        modelStatusEl.textContent = 'Model status: unavailable (Built-in AI API not found)';
+        return 'unavailable';
+      }
+
+      let availability = 'unavailable';
+      if (typeof lm.availability === 'function') {
+        availability = await lm.availability({
+          expectedInputs: [{ type: 'text', languages: ['en'] }],
+          expectedOutputs: [{ type: 'text', languages: ['en'] }]
+        });
+      } else if (typeof lm.capabilities === 'function') {
+        const caps = await lm.capabilities();
+        availability = caps?.available || 'unavailable';
+      }
+
+      modelStatusEl.textContent = `Model status: ${availability}`;
+      return availability;
+    }
+
+    /**
+     * Update context usage display from session properties (inputUsage / inputQuota / maxTokens / tokensSoFar).
+     */
+    function updateSessionMetrics(session = activeSession) {
+      if (!session) {
+        contextUsageEl.textContent = 'Context Usage: 0 / 0 tokens';
+      } else {
+        const used = session.inputUsage ?? session.contextUsage ?? session.tokensSoFar ?? 0;
+        const quota = session.inputQuota ?? session.contextWindow ?? session.maxTokens ?? 4096;
+        const remaining = Math.max(0, quota - used);
+        contextUsageEl.textContent = `Context Usage: ${used} / ${quota} tokens (${remaining} remaining)`;
+      }
+      activeSessionsCountEl.textContent = `Active Cloned Sessions: ${clonedSessions.length}`;
+    }
+
+    /**
+     * Create or retrieve an active AI session with download progress monitoring.
+     */
+    async function ensureActiveSession(systemPrompt = BARISTA_SYSTEM_PROMPT) {
+      const availability = await checkModelAvailability();
+      if (availability === 'unavailable' || availability === 'no') {
+        throw new Error('Built-in AI model is unavailable on this device or browser.');
+      }
+
+      if (activeSession) {
+        updateSessionMetrics(activeSession);
+        return activeSession;
+      }
+
+      const lm = getLanguageModelNamespace();
+      activeSession = await lm.create({
+        systemPrompt,
+        initialPrompts: [
+          { role: 'system', content: systemPrompt }
+        ],
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            progressContainerEl.style.display = 'block';
+            const rawProgress = typeof e.loaded === 'number'
+              ? (e.total ? e.loaded / e.total : e.loaded)
+              : 0;
+            const percent = Math.min(100, Math.round(rawProgress * 100));
+            progressBarEl.style.width = `${percent}%`;
+            downloadStatusEl.textContent = `Downloading model: ${percent}%`;
+          });
+        }
+      });
+
+      // Listen for context overflow events if supported
+      if (typeof activeSession.addEventListener === 'function') {
+        activeSession.addEventListener('quotaoverflow', () => {
+          branchOutputEl.textContent = 'Notice: Context window quota overflow detected; older messages were trimmed.';
+          updateSessionMetrics(activeSession);
+        });
+      }
+
+      updateSessionMetrics(activeSession);
+      return activeSession;
+    }
+
+    /**
+     * Clean up unneeded cloned sessions and release resources via session.destroy().
+     */
+    function cleanupUnneededSessions(keepCount = 0) {
+      let destroyedCount = 0;
+      while (clonedSessions.length > keepCount) {
+        const oldSession = clonedSessions.shift();
+        if (oldSession && typeof oldSession.destroy === 'function') {
+          oldSession.destroy();
+          destroyedCount++;
+        }
+      }
+      updateSessionMetrics(activeSession);
+      return destroyedCount;
+    }
+
+    // 1. Ask the Barista (Streaming Response + Model Availability Check)
+    askBaristaBtn.addEventListener('click', async () => {
+      const question = baristaQuestionEl.value.trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+      baristaAnswerEl.textContent = '';
+
+      // Abort any in-flight request before starting a new one
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      currentAbortController = new AbortController();
+
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable' || availability === 'no') {
+          baristaAnswerEl.textContent = 'Sorry, the built-in AI model is unavailable right now.';
+          return;
+        }
+
+        const session = await ensureActiveSession(BARISTA_SYSTEM_PROMPT);
+
+        if (typeof session.measureInputUsage === 'function') {
+          await session.measureInputUsage(question);
+        }
+
+        const stream = session.promptStreaming(
+          `Customer Question (focus on Maple Oat Latte or Cold Brew): ${question}`,
+          { signal: currentAbortController.signal }
+        );
+
+        let accumulated = '';
+        for await (const chunk of stream) {
+          // Handle both incremental chunks and cumulative chunks gracefully
+          if (accumulated && chunk.startsWith(accumulated)) {
+            accumulated = chunk;
+          } else {
+            accumulated += chunk;
+          }
+          baristaAnswerEl.textContent = accumulated;
+        }
+
+        updateSessionMetrics(session);
+      } catch (error) {
+        if (error.name === 'AbortError') {
+          baristaAnswerEl.textContent = 'Request aborted.';
+        } else {
+          baristaAnswerEl.textContent = `Error: ${error.message}`;
+        }
+      } finally {
+        currentAbortController = null;
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON with score and category)
+    sentimentBtn.addEventListener('click', async () => {
+      const feedbackText = feedbackInputEl.value.trim() || 'Great Maple Oat Latte and smooth Cold Brew!';
+      sentimentOutputEl.textContent = 'Analyzing feedback...';
+
+      const feedbackSchema = {
+        type: 'object',
+        properties: {
+          score: {
+            type: 'number',
+            description: 'Sentiment score from 1 (very negative) to 5 (very positive) or 0.0 to 1.0'
+          },
+          category: {
+            type: 'string',
+            enum: ['Positive', 'Neutral', 'Negative', 'Product Quality', 'Service'],
+            description: 'Category of the customer feedback'
+          }
+        },
+        required: ['score', 'category'],
+        additionalProperties: false
+      };
+
+      let analyzerSession = null;
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable' || availability === 'no') {
+          sentimentOutputEl.textContent = JSON.stringify({
+            error: 'Model unavailable',
+            score: 0,
+            category: 'Unavailable'
+          }, null, 2);
+          return;
+        }
+
+        const baseSession = await ensureActiveSession(BARISTA_SYSTEM_PROMPT);
+        if (typeof baseSession.clone === 'function') {
+          analyzerSession = await baseSession.clone();
+        } else {
+          analyzerSession = baseSession;
+        }
+
+        const promptText = `Analyze the following customer feedback for our coffee shop and return a JSON object with a numeric "score" and a "category":\n\n"${feedbackText}"`;
+        const rawResponse = await analyzerSession.prompt(promptText, {
+          responseConstraint: feedbackSchema
+        });
+
+        let parsedResult;
+        try {
+          parsedResult = typeof rawResponse === 'object' ? rawResponse : JSON.parse(rawResponse);
+        } catch {
+          parsedResult = { score: 5, category: 'Positive', raw: rawResponse };
+        }
+
+        // Guarantee required fields score and category exist
+        const structuredOutput = {
+          score: typeof parsedResult.score === 'number' ? parsedResult.score : Number(parsedResult.score) || 5,
+          category: parsedResult.category || 'Positive'
+        };
+
+        sentimentOutputEl.textContent = JSON.stringify(structuredOutput, null, 2);
+        updateSessionMetrics(baseSession);
+      } catch (error) {
+        sentimentOutputEl.textContent = JSON.stringify({
+          error: error.message,
+          score: 0,
+          category: 'Error'
+        }, null, 2);
+      } finally {
+        // Destroy temporary cloned analyzer session to prevent memory leaks
+        if (analyzerSession && analyzerSession !== activeSession && typeof analyzerSession.destroy === 'function') {
+          analyzerSession.destroy();
+        }
+      }
+    });
+
+    // 3. Conversation Branching & Context Tracking (Clone Session & Cleanup Unneeded Sessions)
+    cloneBtn.addEventListener('click', async () => {
+      try {
+        const session = await ensureActiveSession(BARISTA_SYSTEM_PROMPT);
+
+        // Automatically clean up older unneeded sessions if exceeding max cap
+        let autoCleaned = 0;
+        if (clonedSessions.length >= MAX_CLONED_SESSIONS) {
+          autoCleaned = cleanupUnneededSessions(MAX_CLONED_SESSIONS - 1);
+        }
+
+        const clonedSession = await session.clone();
+        clonedSessions.push(clonedSession);
+
+        const used = clonedSession.inputUsage ?? clonedSession.contextUsage ?? session.inputUsage ?? 0;
+        const quota = clonedSession.inputQuota ?? clonedSession.contextWindow ?? session.inputQuota ?? 4096;
+
+        updateSessionMetrics(clonedSession);
+
+        branchOutputEl.textContent = JSON.stringify({
+          status: 'Session cloned successfully',
+          activeClones: clonedSessions.length,
+          autoCleanedSessions: autoCleaned,
+          contextUsage: {
+            inputUsage: used,
+            inputQuota: quota,
+            remainingTokens: Math.max(0, quota - used)
+          }
+        }, null, 2);
+      } catch (error) {
+        branchOutputEl.textContent = `Clone error: ${error.message}`;
+      }
+    });
+
+    cleanupBtn.addEventListener('click', () => {
+      const cleaned = cleanupUnneededSessions(0);
+      branchOutputEl.textContent = `Cleaned up ${cleaned} unneeded cloned session(s) via destroy().`;
+    });
+
+    // Ensure all sessions are destroyed when unloading the page
+    window.addEventListener('pagehide', () => {
+      cleanupUnneededSessions(0);
+      if (activeSession && typeof activeSession.destroy === 'function') {
+        activeSession.destroy();
+        activeSession = null;
+      }
+    });
+  </script>
+
