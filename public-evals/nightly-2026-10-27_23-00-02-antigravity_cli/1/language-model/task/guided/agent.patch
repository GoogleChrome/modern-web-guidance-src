+        <button id="cleanup-sessions-btn" class="btn btn-secondary" type="button">Clean Up Unneeded Sessions</button>
+      </div>
+      <div id="context-usage" class="status-text" aria-live="polite">Context Usage: 0 / 0 tokens (Active Clones: 0)</div>
