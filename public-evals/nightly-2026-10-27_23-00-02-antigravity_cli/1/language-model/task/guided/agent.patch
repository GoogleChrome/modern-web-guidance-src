+  <script>
+    (() => {
+      const baristaTextarea = document.getElementById('barista-question');
+      const askBaristaBtn = document.getElementById('ask-the-barista');
+      const stopBaristaBtn = document.getElementById('stop-barista-btn');
+      const downloadStatusEl = document.getElementById('model-download-status');
+      const baristaAnswerEl = document.getElementById('barista-answer');
+
+      const feedbackInput = document.getElementById('feedback-input');
+      const sentimentBtn = document.getElementById('sentiment-btn');
+      const sentimentOutputEl = document.getElementById('sentiment-output');
+
+      const cloneBtn = document.getElementById('clone-btn');
+      const cleanupSessionsBtn = document.getElementById('cleanup-sessions-btn');
+      const contextUsageEl = document.getElementById('context-usage');
+      const branchContainerEl = document.getElementById('branch-container');
+
+      const BARISTA_SYSTEM_PROMPT =
+        'You are the expert barista at The Daily Grind. Answer customer questions strictly about our two featured drinks: ' +
+        '1) Maple Oat Latte: Creamy oat milk combined with rich espresso and a hint of pure Vermont maple syrup. ' +
+        '2) Cold Brew: Artisanal coffee steeped cold for 18 hours for maximum smoothness and low acidity.';
+
+      // Structured JSON Schema for Customer Feedback Analyzer (score and category)
+      // Pass the schema as a plain object — do not JSON.stringify() it first.
+      const feedbackSchema = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: 1, maximum: 5 },
+          category: {
+            type: 'string',
+            enum: ['positive', 'neutral', 'negative', 'product_quality', 'service']
+          }
+        },
+        required: ['score', 'category'],
+        additionalProperties: false
+      };
+
+      let baseSession = null;
+      let activeSession = null;
+      let activeAbortController = null;
+      const clonedSessions = [];
+      const responseCache = new Map();
+
+      // Update context usage display from active session and track cloned sessions
+      function updateContextUsageDisplay(sessionToInspect = activeSession || baseSession) {
+        const usage = sessionToInspect?.contextUsage ?? sessionToInspect?.tokensSoFar ?? 0;
+        const maxWindow = sessionToInspect?.contextWindow ?? sessionToInspect?.maxTokens ?? 0;
+        contextUsageEl.textContent = `Context Usage: ${usage} / ${maxWindow} tokens (Active Clones: ${clonedSessions.length})`;
+      }
+
+      // Check model availability before starting or triggering download
+      async function checkModelAvailability() {
+        if (!('LanguageModel' in self)) {
+          downloadStatusEl.textContent = 'Built-in AI (LanguageModel API) is not supported in this browser.';
+          return 'unavailable';
+        }
+        try {
+          const availability = await LanguageModel.availability();
+          if (availability === 'unavailable') {
+            downloadStatusEl.textContent = 'Built-in AI model is unavailable on this device.';
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            downloadStatusEl.textContent = `Model status: ${availability}. Will monitor download progress when initialized.`;
+          } else {
+            downloadStatusEl.textContent = 'Built-in AI model is ready.';
+          }
+          return availability;
+        } catch (err) {
+          downloadStatusEl.textContent = `Error checking availability: ${err.message}`;
+          return 'unavailable';
+        }
+      }
+
+      // Create or retrieve the baseline session with download progress monitoring & initialPrompts
+      async function ensureBaseSession() {
+        if (baseSession) return baseSession;
+
+        const availability = await checkModelAvailability();
+        // Do not call create() when unavailable — the model cannot run on this device.
+        if (availability === 'unavailable') {
+          return null;
+        }
+
+        baseSession = await LanguageModel.create({
+          initialPrompts: [
+            { role: 'system', content: BARISTA_SYSTEM_PROMPT }
+          ],
+          expectedInputs: [{ type: 'text' }],
+          expectedOutputs: [{ type: 'text' }],
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round((e.loaded || 0) * 100);
+              downloadStatusEl.textContent = `Downloaded ${percent}%`;
+            });
+          }
+        });
+
+        if (!activeSession) {
+          activeSession = await baseSession.clone();
+        }
+        updateContextUsageDisplay(activeSession);
+        return baseSession;
+      }
+
+      // Pre-warm session when user interacts with surrounding inputs
+      baristaTextarea.addEventListener('focus', () => {
+        ensureBaseSession().catch(() => {});
+      }, { once: true });
+
+      feedbackInput.addEventListener('focus', () => {
+        ensureBaseSession().catch(() => {});
+      }, { once: true });
+
+      // 1. Ask the Barista (Streaming response into #barista-answer)
+      askBaristaBtn.addEventListener('click', async () => {
+        const question = (baristaTextarea.value || '').trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+        const normalizedKey = question.toLowerCase();
+
+        baristaAnswerEl.textContent = '';
+
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          baristaAnswerEl.textContent =
+            'Fallback Response: Our Maple Oat Latte pairs velvety oat milk with rich espresso and Vermont maple syrup, while our Cold Brew is steeped for 18 hours for ultra-smooth flavor.';
+          return;
+        }
+
+        if (responseCache.has(normalizedKey)) {
+          baristaAnswerEl.textContent = responseCache.get(normalizedKey);
+          updateContextUsageDisplay(activeSession);
+          return;
+        }
+
+        try {
+          if (activeAbortController) {
+            activeAbortController.abort();
+          }
+          activeAbortController = new AbortController();
+          stopBaristaBtn.hidden = false;
+          askBaristaBtn.disabled = true;
+
+          await ensureBaseSession();
+          if (!activeSession) {
+            activeSession = await baseSession.clone();
+          }
+
+          const stream = activeSession.promptStreaming(
+            `Answer the customer question about the Maple Oat Latte or Cold Brew: ${question}`,
+            { signal: activeAbortController.signal }
+          );
+
+          let completeResult = '';
+          for await (const chunk of stream) {
+            completeResult += chunk;
+            // MANDATORY: Never assign model output to innerHTML. Use textContent / append.
+            baristaAnswerEl.append(chunk);
+          }
+
+          responseCache.set(normalizedKey, completeResult);
+          updateContextUsageDisplay(activeSession);
+        } catch (err) {
+          if (err.name === 'AbortError') {
+            baristaAnswerEl.append('\n[Generation stopped by user]');
+          } else {
+            baristaAnswerEl.textContent = `Unable to generate response: ${err.message}`;
+          }
+        } finally {
+          stopBaristaBtn.hidden = true;
+          askBaristaBtn.disabled = false;
+          activeAbortController = null;
+        }
+      });
+
+      stopBaristaBtn.addEventListener('click', () => {
+        if (activeAbortController) {
+          activeAbortController.abort();
+        }
+      });
+
+      // 2. Customer Feedback Analyzer (Structured JSON output with score and category)
+      sentimentBtn.addEventListener('click', async () => {
+        const feedback = (feedbackInput.value || '').trim() || 'The Maple Oat Latte and Cold Brew were delicious!';
+        sentimentOutputEl.textContent = 'Analyzing feedback...';
+
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          const fallbackJson = {
+            score: 5,
+            category: 'positive'
+          };
+          sentimentOutputEl.textContent = JSON.stringify(fallbackJson, null, 2);
+          return;
+        }
+
+        let analyzerSession = null;
+        try {
+          sentimentBtn.disabled = true;
+          await ensureBaseSession();
+          // Clone the base session for isolated task execution and destroy after use
+          analyzerSession = await baseSession.clone();
+
+          const result = await analyzerSession.prompt(
+            `Rate and categorize the following customer feedback: '${feedback}'`,
+            { responseConstraint: feedbackSchema }
+          );
+
+          const parsed = JSON.parse(result);
+          const validated = {
+            score: parsed.score,
+            category: parsed.category
+          };
+          // Always render untrusted model output via textContent
+          sentimentOutputEl.textContent = JSON.stringify(validated, null, 2);
+          updateContextUsageDisplay(analyzerSession);
+        } catch (err) {
+          sentimentOutputEl.textContent = `Error analyzing feedback: ${err.message}`;
+        } finally {
+          if (analyzerSession) {
+            analyzerSession.destroy();
+          }
+          sentimentBtn.disabled = false;
+        }
+      });
+
+      // 3. Conversation Branching (Clone active sessions, track context usage, clean up unneeded sessions)
+      function renderBranches() {
+        branchContainerEl.textContent = '';
+        clonedSessions.forEach((branch, index) => {
+          const card = document.createElement('div');
+          card.className = 'branch-card';
+
+          const usage = branch.session?.contextUsage ?? branch.session?.tokensSoFar ?? 0;
+          const windowSize = branch.session?.contextWindow ?? branch.session?.maxTokens ?? 0;
+
+          const title = document.createElement('strong');
+          title.textContent = `Branch #${branch.id} — Context: ${usage} / ${windowSize} tokens`;
+
+          const replyP = document.createElement('p');
+          replyP.style.marginTop = '6px';
+          replyP.textContent = branch.lastReply || 'Cloned from active session. Ready for branched conversation.';
+
+          const destroyBranchBtn = document.createElement('button');
+          destroyBranchBtn.type = 'button';
+          destroyBranchBtn.className = 'btn btn-secondary';
+          destroyBranchBtn.style.marginTop = '8px';
+          destroyBranchBtn.textContent = 'Destroy Branch';
+          destroyBranchBtn.addEventListener('click', () => {
+            if (branch.session && typeof branch.session.destroy === 'function') {
+              branch.session.destroy();
+            }
+            clonedSessions.splice(index, 1);
+            renderBranches();
+            updateContextUsageDisplay();
+          });
+
+          card.append(title, replyP, destroyBranchBtn);
+          branchContainerEl.append(card);
+        });
+      }
+
+      let branchCounter = 0;
+
+      cloneBtn.addEventListener('click', async () => {
+        const availability = await checkModelAvailability();
+        if (availability === 'unavailable') {
+          contextUsageEl.textContent = 'Cannot clone session: Built-in AI model is unavailable.';
+          return;
+        }
+
+        try {
+          cloneBtn.disabled = true;
+          await ensureBaseSession();
+          const sourceSession = activeSession || baseSession;
+          const clonedSession = await sourceSession.clone();
+
+          // Clean up older excess clones automatically if more than 3 branches exist to prevent memory bloat
+          while (clonedSessions.length >= 3) {
+            const oldest = clonedSessions.shift();
+            if (oldest?.session && typeof oldest.session.destroy === 'function') {
+              oldest.session.destroy();
+            }
+          }
+
+          branchCounter += 1;
+          const branchEntry = {
+            id: branchCounter,
+            session: clonedSession,
+            lastReply: 'Cloned session active (inherited initial context).'
+          };
+          clonedSessions.push(branchEntry);
+
+          updateContextUsageDisplay(clonedSession);
+          renderBranches();
+        } catch (err) {
+          contextUsageEl.textContent = `Error cloning session: ${err.message}`;
+        } finally {
+          cloneBtn.disabled = false;
+        }
+      });
+
+      function cleanupAllUnneededSessions() {
+        while (clonedSessions.length > 0) {
+          const item = clonedSessions.pop();
+          if (item?.session && typeof item.session.destroy === 'function') {
+            item.session.destroy();
+          }
+        }
+        if (activeSession && typeof activeSession.destroy === 'function') {
+          activeSession.destroy();
+          activeSession = null;
+        }
+        renderBranches();
+        updateContextUsageDisplay(baseSession);
+      }
+
+      cleanupSessionsBtn.addEventListener('click', () => {
+        cleanupAllUnneededSessions();
+      });
+
+      // Destroy all sessions when page unloads to free device memory
+      window.addEventListener('pagehide', () => {
+        cleanupAllUnneededSessions();
+        if (baseSession && typeof baseSession.destroy === 'function') {
+          baseSession.destroy();
+          baseSession = null;
+        }
+      });
+    })();
+  </script>
 </body>
 
