+  <script>
+    (function () {
+      const list = document.getElementById('cart-list');
+      const totalEl = document.getElementById('cart-total');
+      const emptyEl = document.getElementById('cart-empty');
+      const summaryEl = document.getElementById('cart-summary');
+
+      function updateCartSummary() {
+        const remainingItems = list.querySelectorAll('.SwipeableList-item:not(.is-removing)');
+        let total = 0;
+        remainingItems.forEach((item) => {
+          total += parseFloat(item.getAttribute('data-price') || '0');
+        });
+        if (totalEl) {
+          totalEl.textContent = '$' + total.toFixed(2);
+        }
+        if (remainingItems.length === 0) {
+          if (emptyEl) emptyEl.classList.add('is-visible');
+          if (summaryEl) summaryEl.style.display = 'none';
+        }
+      }
+
+      function removeItem(item, direction = -1) {
+        if (item.classList.contains('is-removing')) return;
+
+        const content = item.querySelector('.SwipeableList-content');
+        const track = item.querySelector('.SwipeableList-track');
+        const width = item.offsetWidth || 300;
+
+        // Lock current explicit height before collapsing for a smooth transition
+        item.style.maxHeight = item.offsetHeight + 'px';
+        item.classList.remove('is-dragging');
+        item.classList.add('is-past-threshold');
+        if (track) track.classList.add('is-active');
+
+        if (content) {
+          content.style.transform = `translateX(${direction * width}px)`;
+        }
+
+        // Force reflow so max-height transition triggers smoothly
+        void item.offsetHeight;
+        item.classList.add('is-removing');
+        updateCartSummary();
+
+        const cleanup = () => {
+          if (item.parentNode) {
+            item.parentNode.removeChild(item);
+          }
+        };
+
+        item.addEventListener('transitionend', (e) => {
+          if (e.propertyName === 'max-height') {
+            cleanup();
+          }
+        });
+        setTimeout(cleanup, 400);
+      }
+
+      function initSwipeableItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        const removeBtn = item.querySelector('.cart-remove-btn');
+
+        if (removeBtn) {
+          removeBtn.addEventListener('click', (e) => {
+            e.stopPropagation();
+            removeItem(item, -1);
+          });
+        }
+
+        let startX = 0;
+        let currentX = 0;
+        let isDragging = false;
+
+        function getThreshold() {
+          return Math.min(120, Math.max(60, (item.offsetWidth || 300) * 0.3));
+        }
+
+        function onStart(clientX) {
+          if (item.classList.contains('is-removing')) return;
+          isDragging = true;
+          startX = clientX;
+          currentX = 0;
+          item.classList.add('is-dragging');
+        }
+
+        function onMove(clientX) {
+          if (!isDragging) return;
+          currentX = clientX - startX;
+          content.style.transform = `translateX(${currentX}px)`;
+
+          const pastThreshold = Math.abs(currentX) >= getThreshold();
+          item.classList.toggle('is-past-threshold', pastThreshold);
+          if (track) {
+            track.classList.toggle('is-active', pastThreshold);
+          }
+        }
+
+        function onEnd() {
+          if (!isDragging) return;
+          isDragging = false;
+          item.classList.remove('is-dragging');
+
+          const threshold = getThreshold();
+          if (Math.abs(currentX) >= threshold) {
+            const direction = currentX >= 0 ? 1 : -1;
+            removeItem(item, direction);
+          } else {
+            content.style.transform = 'translateX(0)';
+            item.classList.remove('is-past-threshold');
+            if (track) track.classList.remove('is-active');
+          }
+          currentX = 0;
+        }
+
+        // Pointer events (handles mouse & touch in modern browsers)
+        content.addEventListener('pointerdown', (e) => {
+          if (e.target.closest('button')) return;
+          if (e.button !== undefined && e.button !== 0) return;
+          onStart(e.clientX);
+          if (content.setPointerCapture && e.pointerId !== undefined) {
+            try {
+              content.setPointerCapture(e.pointerId);
+            } catch (_) {}
+          }
+        });
+
+        content.addEventListener('pointermove', (e) => {
+          if (!isDragging) return;
+          onMove(e.clientX);
+        });
+
+        content.addEventListener('pointerup', () => onEnd());
+        content.addEventListener('pointercancel', () => onEnd());
+
+        // Fallback mouse & touch listeners for synthetic event dispatch in tests
+        content.addEventListener('mousedown', (e) => {
+          if (isDragging || e.target.closest('button') || (e.button !== undefined && e.button !== 0)) return;
+          onStart(e.clientX);
+        });
+        window.addEventListener('mousemove', (e) => {
+          if (!isDragging) return;
+          onMove(e.clientX);
+        });
+        window.addEventListener('mouseup', () => {
+          if (!isDragging) return;
+          onEnd();
+        });
+
+        content.addEventListener('touchstart', (e) => {
+          if (isDragging || e.target.closest('button')) return;
+          if (e.touches && e.touches.length > 0) {
+            onStart(e.touches[0].clientX);
+          }
+        }, { passive: true });
+
+        content.addEventListener('touchmove', (e) => {
+          if (!isDragging) return;
+          if (e.touches && e.touches.length > 0) {
+            onMove(e.touches[0].clientX);
+          }
+        }, { passive: true });
+
+        content.addEventListener('touchend', () => {
+          if (!isDragging) return;
+          onEnd();
+        });
+      }
+
+      document.querySelectorAll('.SwipeableList-item').forEach(initSwipeableItem);
+    })();
+  </script>
 </body>
 
