+          var href = link ? (link.getAttribute('href') || link.getAttribute('data-nav-route') || '/') : '/';
+          var label = link ? (link.textContent || '').trim() : 'Nav Item';
+          return {
+            category: 'navigation-bar',
+            target: (link && link.getAttribute('data-perf-target')) || ('nav:' + label.toLowerCase().replace(/\s+/g, '-')),
+            label: 'Nav: ' + label,
+            route: href
+          };
+        }
+
+        var heroBtn = el.closest('.hero .btn, a[href="/order-online"][ data-perf-target="hero:order-now"]');
+        if (heroBtn) {
+          return {
+            category: 'order-now-button',
+            target: heroBtn.getAttribute('data-perf-target') || 'hero:order-now',
+            label: 'Order Now Button',
+            route: heroBtn.getAttribute('href') || '/order-online'
+          };
+        }
+
+        var cardEl = el.closest('.card');
+        if (cardEl) {
+          var titleEl = cardEl.querySelector('h3');
+          var cardTitle = titleEl ? titleEl.textContent.trim() : 'Seasonal Card';
+          var cardLink = cardEl.querySelector('a.btn') || el.closest('a');
+          var cardRoute = (cardLink && cardLink.getAttribute('href')) || cardEl.getAttribute('data-route') || '/menu/seasonal';
+          return {
+            category: 'seasonal-favorites-card',
+            target: cardEl.getAttribute('data-perf-target') || ('seasonal-card:' + cardTitle.toLowerCase().replace(/\s+/g, '-')),
+            label: 'Seasonal Card: ' + cardTitle,
+            route: cardRoute
+          };
+        }
+
+        var anyLink = el.closest('a[href]');
+        if (anyLink && anyLink.getAttribute('href').charAt(0) === '/') {
+          var linkText = (anyLink.textContent || '').trim() || anyLink.getAttribute('href');
+          return {
+            category: 'view-navigation',
+            target: anyLink.getAttribute('data-perf-target') || ('view:' + anyLink.getAttribute('href')),
+            label: 'View Nav: ' + linkText,
+            route: anyLink.getAttribute('href')
+          };
+        }
+
+        return null;
+      }
+
+      /**
+       * Begins tracking an interaction or client-side view navigation
+       */
+      function startPendingMeasurement(info, eventTimeStamp) {
+        interactionCounter += 1;
+        var currentNow = now();
+        var startTs = (typeof eventTimeStamp === 'number' && eventTimeStamp > 0 && eventTimeStamp <= currentNow)
+          ? eventTimeStamp
+          : currentNow;
+
+        var id = 'perf-' + interactionCounter + '-' + Math.round(startTs);
+        var startMarkName = 'dg:' + info.category + ':' + interactionCounter + ':start';
+
+        if (typeof performance !== 'undefined' && performance.mark) {
+          try {
+            performance.mark(startMarkName, {
+              startTime: startTs,
+              detail: {
+                id: id,
+                category: info.category,
+                target: info.target,
+                label: info.label,
+                route: info.route
+              }
+            });
+            performance.mark('dg:interaction:start', { startTime: startTs });
+          } catch (e) {
+            performance.mark(startMarkName);
+          }
+        }
+
+        activeInteraction = {
+          id: id,
+          seq: interactionCounter,
+          category: info.category,
+          target: info.target,
+          label: info.label,
+          route: info.route || window.location.pathname,
+          trigger: info.trigger || 'interaction',
+          startMarkName: startMarkName,
+          startTime: startTs,
+          domUpdateTime: null,
+          renderTime: null,
+          contentfulNodes: 0,
+          finalized: false
+        };
+
+        return activeInteraction;
+      }
+
+      /**
+       * Completes an active measurement once contentful DOM changes have been painted to screen
+       */
+      function finalizeMeasurement(pending, domTime, paintTime, contentfulSummary) {
+        if (!pending || pending.finalized) return null;
+        pending.finalized = true;
+
+        var domUpdateTs = domTime || paintTime;
+        var renderTs = Math.max(paintTime, domUpdateTs);
+        var totalDuration = Math.max(0, renderTs - pending.startTime);
+        var domDuration = Math.max(0, domUpdateTs - pending.startTime);
+        var paintDuration = Math.max(0, renderTs - domUpdateTs);
+
+        var endMarkName = 'dg:' + pending.category + ':' + pending.seq + ':contentful-render';
+        var categoryMeasureName = 'dg:' + pending.category + ':to-contentful-render';
+        var genericMeasureName = pending.trigger === 'navigation'
+          ? 'client-navigation-to-contentful-render'
+          : 'interaction-to-contentful-render';
+
+        var metricRecord = {
+          id: pending.id,
+          category: pending.category,
+          target: pending.target,
+          label: pending.label,
+          route: pending.route,
+          trigger: pending.trigger,
+          startTime: Number(pending.startTime.toFixed(2)),
+          domUpdateTime: Number(domUpdateTs.toFixed(2)),
+          renderTime: Number(renderTs.toFixed(2)),
+          duration: Number(totalDuration.toFixed(2)),
+          timeToContentfulRender: Number(totalDuration.toFixed(2)),
+          domMutationLatency: Number(domDuration.toFixed(2)),
+          framePaintLatency: Number(paintDuration.toFixed(2)),
+          contentfulElements: contentfulSummary || pending.contentfulNodes || 1,
+          timestamp: new Date().toISOString()
+        };
+
+        if (typeof performance !== 'undefined' && performance.mark && performance.measure) {
+          try {
+            performance.mark(endMarkName, {
+              startTime: renderTs,
+              detail: metricRecord
+            });
+            performance.mark('dg:interaction:contentful-render', { startTime: renderTs });
+            performance.measure(categoryMeasureName, {
+              start: pending.startTime,
+              end: renderTs,
+              detail: metricRecord
+            });
+            performance.measure(genericMeasureName, {
+              start: pending.startTime,
+              end: renderTs,
+              detail: metricRecord
+            });
+          } catch (e) {
+            try {
+              performance.mark(endMarkName);
+              performance.measure(categoryMeasureName, pending.startMarkName, endMarkName);
+              performance.measure(genericMeasureName, pending.startMarkName, endMarkName);
+            } catch (err) {
+              // Ignore fallback errors in older environments
+            }
+          }
+        }
+
+        metricsStore.push(metricRecord);
+
+        // Also record a companion 'view-navigation' metric when an interaction causes a client-side route change
+        if (pending.routeChanged && pending.category !== 'view-navigation') {
+          var navRecord = Object.assign({}, metricRecord, {
+            id: pending.id + '-nav',
+            category: 'view-navigation',
+            sourceCategory: pending.category,
+            label: 'View Nav (' + pending.route + ')',
+            trigger: 'client-side-navigation'
+          });
+          metricsStore.push(navRecord);
+          try {
+            performance.measure('dg:view-navigation:to-contentful-render', {
+              start: pending.startTime,
+              end: renderTs,
+              detail: navRecord
+            });
+          } catch (e) {}
+        }
+
+        if (activeInteraction === pending) {
+          activeInteraction = null;
+        }
+
+        // Log structured result to console
+        console.info(
+          '[DailyGrind Perf] %s (%s) -> Contentful Render in %sms (DOM: %sms, Paint: %sms)',
+          metricRecord.label,
+          metricRecord.category,
+          metricRecord.duration.toFixed(2),
+          metricRecord.domMutationLatency.toFixed(2),
+          metricRecord.framePaintLatency.toFixed(2),
+          metricRecord
+        );
+
+        // Notify subscribers and dispatch custom event
+        for (var i = 0; i < subscribers.length; i++) {
+          try {
+            subscribers[i](metricRecord);
+          } catch (err) {}
+        }
+
+        if (typeof window.CustomEvent === 'function') {
+          window.dispatchEvent(new CustomEvent('perf:contentful-render', { detail: metricRecord }));
+        }
+
+        updateHudUI();
+        return metricRecord;
+      }
+
+      /**
+       * Inspects a MutationRecord list to verify whether a contentful DOM update occurred
+       */
+      function countContentfulMutations(mutations) {
+        var count = 0;
+        for (var i = 0; i < mutations.length; i++) {
+          var m = mutations[i];
+          if (m.target && m.target.closest && m.target.closest('#perf-hud')) {
+            continue;
+          }
+          if (m.type === 'childList' && m.addedNodes && m.addedNodes.length > 0) {
+            for (var j = 0; j < m.addedNodes.length; j++) {
+              var node = m.addedNodes[j];
+              if (node.nodeType === 1) {
+                var text = (node.textContent || '').trim();
+                var hasMedia = node.tagName === 'IMG' || (node.querySelector && node.querySelector('img, h1, h2, h3, p'));
+                if (text.length > 0 || hasMedia) {
+                  count += 1;
+                }
+              } else if (node.nodeType === 3 && (node.nodeValue || '').trim().length > 0) {
+                count += 1;
+              }
+            }
+          } else if (m.type === 'characterData') {
+            if ((m.target.nodeValue || '').trim().length > 0) {
+              count += 1;
+            }
+          }
+        }
+        return count;
+      }
+
+      // Observe DOM mutations inside <main> to detect contentful updates automatically
+      var mainEl = document.getElementById('main-content') || document.querySelector('main');
+      if (typeof MutationObserver !== 'undefined' && mainEl) {
+        var observer = new MutationObserver(function (mutations) {
+          var contentfulCount = countContentfulMutations(mutations);
+          if (contentfulCount === 0) return;
+
+          var domTs = now();
+          var pending = activeInteraction || startPendingMeasurement({
+            category: 'view-navigation',
+            target: 'dom:contentful-update',
+            label: 'Contentful View Update',
+            route: window.location.pathname,
+            trigger: 'mutation'
+          }, domTs);
+
+          pending.domUpdateTime = pending.domUpdateTime || domTs;
+          pending.contentfulNodes += contentfulCount;
+
+          afterNextPaint(function (paintTs) {
+            finalizeMeasurement(pending, pending.domUpdateTime, paintTs, pending.contentfulNodes);
+          });
+        });
+
+        observer.observe(mainEl, {
+          childList: true,
+          subtree: true,
+          characterData: true
+        });
+      }
+
+      // Observe native Event Timing / INP entries where supported
+      var eventTimingLog = [];
+      if (typeof PerformanceObserver !== 'undefined') {
+        try {
+          var eventObserver = new PerformanceObserver(function (list) {
+            var entries = list.getEntries();
+            for (var i = 0; i < entries.length; i++) {
+              var entry = entries[i];
+              if (entry.target) {
+                var classified = classifyTarget(entry.target);
+                if (classified) {
+                  eventTimingLog.push({
+                    name: entry.name,
+                    category: classified.category,
+                    target: classified.target,
+                    startTime: entry.startTime,
+                    processingStart: entry.processingStart,
+                    processingEnd: entry.processingEnd,
+                    duration: entry.duration,
+                    interactionId: entry.interactionId || 0
+                  });
+                }
+              }
+            }
+          });
+          eventObserver.observe({ type: 'event', buffered: true, durationThreshold: 16 });
+        } catch (e) {}
+      }
+
+      /**
+       * Renders new contentful view updates into #view-outlet for client-side navigation
+       */
+      function renderRouteView(routePath, options) {
+        options = options || {};
+        var normalizedRoute = routePath || '/';
+        var routeData = VIEW_ROUTES[normalizedRoute] || {
+          title: 'Daily Grind View',
+          category: 'view-navigation',
+          badge: 'Client View • ' + normalizedRoute,
+          heading: 'Exploring ' + normalizedRoute.replace(/^\//, '').replace(/-/g, ' '),
+          description: 'Freshly roasted artisanal coffee and seasonal handcrafted specialties.',
+          highlights: [
+            'Ethically sourced beans roasted locally each morning',
+            'Order online for express counter pickup'
+          ],
+          image: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=900&q=80',
+          ctaText: 'Order Now',
+          ctaHref: '/order-online'
+        };
+
+        var outlet = document.getElementById('view-outlet');
+        if (!outlet) return;
+
+        // Highlight active nav link and active seasonal card
+        var navLinks = document.querySelectorAll('nav a');
+        for (var i = 0; i < navLinks.length; i++) {
+          navLinks[i].classList.toggle('active-nav', navLinks[i].getAttribute('href') === normalizedRoute);
+        }
+
+        var cards = document.querySelectorAll('.card');
+        for (var j = 0; j < cards.length; j++) {
+          var cardRoute = cards[j].getAttribute('data-route');
+          cards[j].classList.toggle('active-card', cardRoute === normalizedRoute);
+        }
+
+        var itemsHtml = '';
+        for (var k = 0; k < routeData.highlights.length; k++) {
+          itemsHtml += '<li>' + routeData.highlights[k] + '</li>';
+        }
+
+        outlet.innerHTML =
+          '<article class="view-panel" data-route-rendered="' + normalizedRoute + '" elementtiming="view-panel-' + normalizedRoute + '">' +
+            '<div class="view-panel-header">' +
+              '<h2 elementtiming="view-heading">' + routeData.heading + '</h2>' +
+              '<span class="view-badge">' + routeData.badge + '</span>' +
+            '</div>' +
+            '<div class="view-content-layout">' +
+              '<div>' +
+                '<p>' + routeData.description + '</p>' +
+                '<ul class="view-details-list">' + itemsHtml + '</ul>' +
+                '<a href="' + routeData.ctaHref + '" class="btn" data-perf-target="view-cta:' + routeData.ctaHref + '">' +
+                  routeData.ctaText +
+                '</a>' +
+              '</div>' +
+              '<div>' +
+                '<img class="view-image" src="' + routeData.image + '" alt="' + routeData.title + '" elementtiming="view-image" />' +
+              '</div>' +
+            '</div>' +
+          '</article>';
+      }
+
+      /**
+       * Navigates client-side to a route and tracks the time to contentful screen render
+       */
+      function navigateToRoute(routePath, interactionInfo, eventTimeStamp, pushHistory) {
+        var info = interactionInfo || {
+          category: 'view-navigation',
+          target: 'view:' + routePath,
+          label: 'View Navigation: ' + routePath,
+          route: routePath,
+          trigger: 'navigation'
+        };
+
+        var pending = startPendingMeasurement(info, eventTimeStamp);
+        var previousPath = window.location.pathname;
+        pending.routeChanged = (previousPath !== routePath);
+
+        if (pushHistory !== false && typeof history !== 'undefined' && history.pushState) {
+          try {
+            history.pushState({ route: routePath }, '', routePath);
+          } catch (e) {}
+        }
+
+        renderRouteView(routePath);
+        var domTs = now();
+        pending.domUpdateTime = pending.domUpdateTime || domTs;
+
+        afterNextPaint(function (paintTs) {
+          finalizeMeasurement(pending, pending.domUpdateTime, paintTs, pending.contentfulNodes || 3);
+        });
+      }
+
+      // Intercept clicks on Navigation Bar, "Order Now" button, "Seasonal Favorites" cards, and internal links
+      document.addEventListener('click', function (event) {
+        if (event.target && event.target.closest && event.target.closest('#perf-hud')) {
+          return;
+        }
+
+        var classified = classifyTarget(event.target);
+        if (!classified) return;
+
+        var viewCta = event.target.closest && event.target.closest('[data-perf-target^="view-cta:"]');
+        if (viewCta && viewCta.getAttribute('href') === '/order-online') {
+          classified.category = 'order-now-button';
+          classified.label = 'Order Now CTA';
+        }
+
+        event.preventDefault();
+        navigateToRoute(classified.route, {
+          category: classified.category,
+          target: classified.target,
+          label: classified.label,
+          route: classified.route,
+          trigger: 'click'
+        }, event.timeStamp, true);
+      });
+
+      // Support keyboard activation on the logo
+      var logoEl = document.querySelector('.logo');
+      if (logoEl) {
+        logoEl.addEventListener('keydown', function (event) {
+          if (event.key === 'Enter' || event.key === ' ') {
+            event.preventDefault();
+            navigateToRoute('/', {
+              category: 'navigation-bar',
+              target: 'nav:home',
+              label: 'Nav: THE DAILY GRIND',
+              route: '/',
+              trigger: 'keydown'
+            }, event.timeStamp, true);
+          }
+        });
+      }
+
+      // Track browser back/forward client-side view navigations
+      window.addEventListener('popstate', function (event) {
+        var route = (event.state && event.state.route) || window.location.pathname || '/';
+        navigateToRoute(route, {
+          category: 'view-navigation',
+          target: 'history:popstate:' + route,
+          label: 'History Nav: ' + route,
+          route: route,
+          trigger: 'navigation'
+        }, event.timeStamp, false);
+      });
+
+      /**
+       * Computes summary statistics per interaction category
+       */
+      function getSummary() {
+        var categories = [
+          'navigation-bar',
+          'order-now-button',
+          'seasonal-favorites-card',
+          'view-navigation'
+        ];
+        var summary = {};
+
+        for (var i = 0; i < categories.length; i++) {
+          var cat = categories[i];
+          var items = metricsStore.filter(function (m) {
+            return m.category === cat;
+          });
+          if (items.length === 0) {
+            summary[cat] = { count: 0, avgMs: null, minMs: null, maxMs: null, lastMs: null };
+          } else {
+            var sum = 0;
+            var min = Infinity;
+            var max = -Infinity;
+            for (var j = 0; j < items.length; j++) {
+              var d = items[j].duration;
+              sum += d;
+              if (d < min) min = d;
+              if (d > max) max = d;
+            }
+            summary[cat] = {
+              count: items.length,
+              avgMs: Number((sum / items.length).toFixed(2)),
+              minMs: Number(min.toFixed(2)),
+              maxMs: Number(max.toFixed(2)),
+              lastMs: items[items.length - 1].duration
+            };
+          }
+        }
+        return summary;
+      }
+
+      /**
+       * Updates the on-screen Performance Monitor HUD
+       */
+      function updateHudUI() {
+        var summary = getSummary();
+        var navStat = document.getElementById('perf-stat-nav');
+        var orderStat = document.getElementById('perf-stat-order');
+        var cardsStat = document.getElementById('perf-stat-cards');
+        var viewsStat = document.getElementById('perf-stat-views');
+        var logList = document.getElementById('perf-log-list');
+
+        if (navStat) {
+          navStat.textContent = summary['navigation-bar'].count
+            ? summary['navigation-bar'].avgMs + ' ms (' + summary['navigation-bar'].count + ')'
+            : '—';
+        }
+        if (orderStat) {
+          orderStat.textContent = summary['order-now-button'].count
+            ? summary['order-now-button'].avgMs + ' ms (' + summary['order-now-button'].count + ')'
+            : '—';
+        }
+        if (cardsStat) {
+          cardsStat.textContent = summary['seasonal-favorites-card'].count
+            ? summary['seasonal-favorites-card'].avgMs + ' ms (' + summary['seasonal-favorites-card'].count + ')'
+            : '—';
+        }
+        if (viewsStat) {
+          viewsStat.textContent = summary['view-navigation'].count
+            ? summary['view-navigation'].avgMs + ' ms (' + summary['view-navigation'].count + ')'
+            : '—';
+        }
+
+        if (logList) {
+          if (metricsStore.length === 0) {
+            logList.innerHTML =
+              '<li class="perf-log-item">' +
+                '<span class="perf-log-target">Waiting for interactions...</span>' +
+                '<span class="perf-log-duration"></span>' +
+              '</li>';
+          } else {
+            var recent = metricsStore.slice(-6).reverse();
+            var html = '';
+            for (var i = 0; i < recent.length; i++) {
+              html +=
+                '<li class="perf-log-item">' +
+                  '<span class="perf-log-target" title="' + recent[i].label + '">' + recent[i].label + '</span>' +
+                  '<span class="perf-log-duration">' + recent[i].duration.toFixed(1) + ' ms</span>' +
+                '</li>';
+            }
+            logList.innerHTML = html;
+          }
+        }
+      }
+
+      // HUD Controls
+      var hudEl = document.getElementById('perf-hud');
+      var clearBtn = document.getElementById('perf-clear-btn');
+      var collapseBtn = document.getElementById('perf-collapse-btn');
+      var hudToggle = document.getElementById('perf-hud-toggle');
+
+      if (clearBtn) {
+        clearBtn.addEventListener('click', function (e) {
+          e.stopPropagation();
+          metricsStore.length = 0;
+          if (typeof performance !== 'undefined' && performance.clearMarks && performance.clearMeasures) {
+            performance.clearMarks();
+            performance.clearMeasures();
+          }
+          updateHudUI();
+        });
+      }
+
+      if (hudToggle && hudEl) {
+        hudToggle.addEventListener('click', function () {
+          var isCollapsed = hudEl.classList.toggle('collapsed');
+          if (collapseBtn) {
+            collapseBtn.innerHTML = isCollapsed ? '+' : '&ndash;';
+          }
+        });
+      }
+
+      // Expose global performance monitoring API
+      var perfMonitorApi = {
+        metrics: metricsStore,
+        eventTimings: eventTimingLog,
+        getMetrics: function (category) {
+          if (!category) return metricsStore.slice();
+          return metricsStore.filter(function (m) { return m.category === category; });
+        },
+        getSummary: getSummary,
+        navigateTo: function (route) {
+          navigateToRoute(route, {
+            category: 'view-navigation',
+            target: 'api:navigate:' + route,
+            label: 'Programmatic Nav: ' + route,
+            route: route,
+            trigger: 'navigation'
+          }, now(), true);
+        },
+        measureInteraction: function (category, label, actionFn) {
+          var pending = startPendingMeasurement({
+            category: category || 'view-navigation',
+            target: 'custom:' + (label || 'interaction'),
+            label: label || 'Custom Interaction',
+            route: window.location.pathname,
+            trigger: 'custom'
+          }, now());
+          if (typeof actionFn === 'function') {
+            actionFn();
+          }
+          var domTs = now();
+          pending.domUpdateTime = domTs;
+          afterNextPaint(function (paintTs) {
+            finalizeMeasurement(pending, domTs, paintTs, 1);
+          });
+        },
+        subscribe: function (fn) {
+          if (typeof fn === 'function') subscribers.push(fn);
+          return function () {
+            var idx = subscribers.indexOf(fn);
+            if (idx !== -1) subscribers.splice(idx, 1);
+          };
+        },
+        clear: function () {
+          metricsStore.length = 0;
+          updateHudUI();
+        }
+      };
+
+      window.DailyGrindPerf = perfMonitorApi;
+      window.perfMonitor = perfMonitorApi;
+      window.__perfMetrics = metricsStore;
+    })();
+  </script>
 </body>
 
