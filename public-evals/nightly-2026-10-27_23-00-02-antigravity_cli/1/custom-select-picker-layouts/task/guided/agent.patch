+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      const picker = document.getElementById("roast-select");
+      if (!picker || !CSS.supports("appearance", "base-select")) return;
+
+      picker.addEventListener("keydown", (event) => {
+        if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) return;
+        const options = Array.from(picker.querySelectorAll("option"));
+        const active = document.activeElement;
+        const currentIndex = options.indexOf(active);
+        if (currentIndex === -1) return;
+
+        const currentRect = active.getBoundingClientRect();
+        if (currentRect.width === 0 && currentRect.height === 0) return;
+
+        let bestOption = null;
+        let bestDistance = Infinity;
+
+        for (const option of options) {
+          if (option === active) continue;
+          const rect = option.getBoundingClientRect();
+          const dx = (rect.left + rect.width / 2) - (currentRect.left + currentRect.width / 2);
+          const dy = (rect.top + rect.height / 2) - (currentRect.top + currentRect.height / 2);
+
+          const isMatch =
+            (event.key === "ArrowRight" && dx > 4) ||
+            (event.key === "ArrowLeft" && dx < -4) ||
+            (event.key === "ArrowDown" && dy > 4) ||
+            (event.key === "ArrowUp" && dy < -4);
+
+          if (isMatch) {
+            const distance = Math.hypot(dx, dy);
+            if (distance < bestDistance) {
+              bestDistance = distance;
+              bestOption = option;
+            }
+          }
+        }
+
+        if (bestOption) {
+          event.preventDefault();
+          bestOption.focus();
+        }
+      });
+    });
+  </script>
