+  <script>
+    (function () {
+      const tocSidebar = document.querySelector('.toc-sidebar');
+      const seasonalPanel = document.querySelector('.seasonal-panel');
+      if (!tocSidebar || !seasonalPanel) return;
+
+      const tocLinks = Array.from(tocSidebar.querySelectorAll('a[href^="#"]'));
+      const drinkSections = Array.from(seasonalPanel.querySelectorAll('.drink-section'));
+      if (!tocLinks.length || !drinkSections.length) return;
+
+      let activeSectionId = drinkSections[0].id;
+      let programmaticTarget = null;
+      let lastTargetDistance = Infinity;
+
+      function setActiveLink(sectionId) {
+        if (!sectionId) return;
+        activeSectionId = sectionId;
+
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === `#${sectionId}`;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        drinkSections.forEach((section) => {
+          section.classList.toggle('active', section.id === sectionId);
+        });
+      }
+
+      function updateActiveFromScroll() {
+        if (programmaticTarget) {
+          const currentDistance = Math.abs(programmaticTarget.offsetTop - seasonalPanel.scrollTop);
+          if (currentDistance <= 2) {
+            setActiveLink(programmaticTarget.id);
+            programmaticTarget = null;
+            lastTargetDistance = Infinity;
+            return;
+          } else if (currentDistance <= lastTargetDistance + 1) {
+            lastTargetDistance = currentDistance;
+            return;
+          } else {
+            programmaticTarget = null;
+            lastTargetDistance = Infinity;
+          }
+        }
+
+        const panelRect = seasonalPanel.getBoundingClientRect();
+        let closestSection = drinkSections[0];
+        let minDistance = Infinity;
+
+        for (const section of drinkSections) {
+          const rect = section.getBoundingClientRect();
+          const distance = Math.abs(rect.top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        }
+
+        if (closestSection && closestSection.id !== activeSectionId) {
+          setActiveLink(closestSection.id);
+        }
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            if (programmaticTarget) return;
+            let bestEntry = null;
+            for (const entry of entries) {
+              if (entry.isIntersecting) {
+                if (!bestEntry || entry.intersectionRatio > bestEntry.intersectionRatio) {
+                  bestEntry = entry;
+                }
+              }
+            }
+            if (bestEntry && bestEntry.target.id) {
+              setActiveLink(bestEntry.target.id);
+            }
+          },
+          {
+            root: seasonalPanel,
+            threshold: [0.55, 0.75, 0.9]
+          }
+        );
+
+        drinkSections.forEach((section) => observer.observe(section));
+      }
+
+      seasonalPanel.addEventListener('scroll', updateActiveFromScroll, { passive: true });
+      seasonalPanel.addEventListener('scrollend', () => {
+        programmaticTarget = null;
+        lastTargetDistance = Infinity;
+        updateActiveFromScroll();
+      }, { passive: true });
+
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+          const targetId = href.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+          setActiveLink(targetId);
+
+          const distance = Math.abs(targetSection.offsetTop - seasonalPanel.scrollTop);
+          if (distance > 2) {
+            programmaticTarget = targetSection;
+            lastTargetDistance = distance;
+          } else {
+            programmaticTarget = null;
+            lastTargetDistance = Infinity;
+          }
+
+          seasonalPanel.scrollTo({
+            top: targetSection.offsetTop,
+            behavior: 'smooth'
+          });
+        });
+      });
+
+      setActiveLink(drinkSections[0].id);
+    })();
+  </script>
