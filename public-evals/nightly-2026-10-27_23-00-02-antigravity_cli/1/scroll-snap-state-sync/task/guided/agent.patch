+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = document.querySelectorAll('.toc-sidebar a');
+    const drinkSections = document.querySelectorAll('.drink-section');
+    const snapHeaders = document.querySelectorAll('.drink-section header');
+
+    function setActiveDrink(targetId) {
+      if (!targetId) return;
+      const cleanId = targetId.replace(/-header$/, '');
+      tocLinks.forEach((link) => {
+        const isMatch = link.getAttribute('href') === `#${cleanId}`;
+        link.classList.toggle('active', isMatch);
+        link.classList.toggle(':target-current', isMatch);
+        if (isMatch) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    // Smoothly scroll the panel to the targeted section when clicking any TOC link
+    tocLinks.forEach((link) => {
+      link.addEventListener('click', (event) => {
+        const href = link.getAttribute('href');
+        if (!href || !href.startsWith('#')) return;
+        const targetId = href.slice(1);
+        const targetSection = document.getElementById(targetId);
+        if (targetSection && panel) {
+          event.preventDefault();
+          setActiveDrink(targetId);
+          const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+          const targetHeader = targetSection.querySelector('header, h3') || targetSection;
+          targetHeader.scrollIntoView({
+            behavior: prefersReducedMotion ? 'auto' : 'smooth',
+            block: 'start',
+          });
+          history.replaceState(null, '', href);
+        }
+      });
+    });
+
+    // Listen for native scrollsnapchange event when a section snaps into view
+    if (panel) {
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const snappedEl = event.snapTargetBlock;
+        if (snappedEl) {
+          const section = snappedEl.closest('.drink-section') || snappedEl;
+          setActiveDrink(section.id || snappedEl.dataset.drinkId || snappedEl.id);
+        }
+      });
+
+      // Fallback for browsers without scrollsnapchange support
+      if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+        const observer = new IntersectionObserver(
+          () => {
+            const panelRect = panel.getBoundingClientRect();
+            const topEntry = [...snapHeaders].reduce((currentTop, header) => {
+              const { bottom } = header.getBoundingClientRect();
+              if (bottom < panelRect.top) return currentTop;
+              if (!currentTop) return header;
+              return bottom < currentTop.getBoundingClientRect().bottom
+                ? header
+                : currentTop;
+            }, undefined);
+
+            if (topEntry) {
+              const section = topEntry.closest('.drink-section');
+              setActiveDrink(section ? section.id : topEntry.dataset.drinkId || topEntry.id);
+            }
+          },
+          { root: panel, threshold: 0.9 }
+        );
+
+        snapHeaders.forEach((header) => observer.observe(header));
+      }
+    }
+  </script>
