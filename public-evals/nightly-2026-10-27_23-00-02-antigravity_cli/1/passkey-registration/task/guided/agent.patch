+  <script type="module">
+    import 'webauthn-polyfills';
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+
+    async function checkPasskeySupport() {
+      if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+        if (registerButton) {
+          registerButton.disabled = true;
+        }
+        return false;
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (
+        !capabilities.passkeyPlatformAuthenticator ||
+        !capabilities.conditionalGet
+      ) {
+        if (registerButton) {
+          registerButton.disabled = true;
+        }
+        return false;
+      }
+
+      return true;
+    }
+
+    async function optionsFetch(body) {
+      const response = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify(body),
+      });
+      return response.json();
+    }
+
+    async function registerVerifyFetch(encodedResponse) {
+      return fetch('/api/register/verify', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify(encodedResponse),
+      });
+    }
+
+    async function registerPasskey(isPromotion = true) {
+      const isSupported = await checkPasskeySupport();
+      if (!isSupported) {
+        return;
+      }
+
+      const creationOptionsJSON = await optionsFetch({ promotion: isPromotion });
+      const rpId = creationOptionsJSON?.rp?.id || window.location.hostname;
+      const publicKey =
+        PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        if (err.name === 'InvalidStateError') {
+          console.log('A passkey already exists for this account.');
+          alert('A passkey already exists for this account.');
+        } else if (err.name === 'SecurityError') {
+          console.error('Configuration RP ID or Secure Context error.');
+          alert('Configuration RP ID or Secure Context error.');
+        } else if (err.name === 'NotAllowedError') {
+          console.log('User cancelled the passkey dialog.');
+        } else if (err.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+        }
+        return;
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      const encodedResponse = credential.toJSON();
+      try {
+        const response = await registerVerifyFetch(encodedResponse);
+        if (!response.ok) {
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encodedResponse.id,
+            });
+          }
+        }
+      } catch (serverErr) {
+        console.error('Server verification network failure:', serverErr);
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId,
+            credentialId: encodedResponse.id,
+          });
+        }
+      }
+    }
+
+    checkPasskeySupport();
+
+    if (registerButton) {
+      registerButton.addEventListener('click', () => {
+        registerPasskey(true);
+      });
+    }
+  </script>
