+  <script>
+    (function () {
+      function base64urlToUint8Array(base64url) {
+        if (base64url instanceof Uint8Array) return base64url;
+        if (base64url instanceof ArrayBuffer) return new Uint8Array(base64url);
+        if (ArrayBuffer.isView(base64url)) {
+          return new Uint8Array(base64url.buffer, base64url.byteOffset, base64url.byteLength);
+        }
+        if (Array.isArray(base64url)) return new Uint8Array(base64url);
+        if (typeof base64url !== 'string') return new Uint8Array(0);
+        const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+        const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+        const rawData = window.atob(base64);
+        const outputArray = new Uint8Array(rawData.length);
+        for (let i = 0; i < rawData.length; ++i) {
+          outputArray[i] = rawData.charCodeAt(i);
+        }
+        return outputArray;
+      }
+
+      function bufferToBase64url(buffer) {
+        if (!buffer) return null;
+        if (typeof buffer === 'string') return buffer;
+        const bytes = buffer instanceof Uint8Array
+          ? buffer
+          : ArrayBuffer.isView(buffer)
+            ? new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength)
+            : new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return window.btoa(binary)
+          .replace(/\+/g, '-')
+          .replace(/\//g, '_')
+          .replace(/=+$/, '');
+      }
+
+      function preparePublicKeyRequestOptions(rawOptions) {
+        const opts = rawOptions && rawOptions.publicKey ? rawOptions.publicKey : (rawOptions || {});
+        const publicKey = Object.assign({}, opts);
+        if (publicKey.challenge !== undefined) {
+          publicKey.challenge = base64urlToUint8Array(publicKey.challenge);
+        }
+        if (Array.isArray(publicKey.allowCredentials)) {
+          publicKey.allowCredentials = publicKey.allowCredentials.map(function (cred) {
+            return Object.assign({}, cred, {
+              id: base64urlToUint8Array(cred.id),
+              type: cred.type || 'public-key'
+            });
+          });
+        }
+        if (!publicKey.userVerification) {
+          publicKey.userVerification = 'required';
+        }
+        return publicKey;
+      }
+
+      function serializeAssertionCredential(credential) {
+        const response = credential.response || {};
+        return {
+          id: credential.id,
+          rawId: bufferToBase64url(credential.rawId),
+          type: credential.type || 'public-key',
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          response: {
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64url(response.userHandle) : null
+          },
+          clientExtensionResults: typeof credential.getClientExtensionResults === 'function'
+            ? credential.getClientExtensionResults()
+            : {}
+        };
+      }
+
+      async function handleReauth() {
+        const statusEl = document.getElementById('reauth-status');
+        try {
+          if (statusEl) statusEl.textContent = 'Requesting verification challenge...';
+
+          const optionsRes = await fetch('/api/reauth/options', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            credentials: 'same-origin'
+          });
+
+          if (!optionsRes.ok) {
+            throw new Error('Failed to fetch re-authentication options');
+          }
+
+          const optionsData = await optionsRes.json();
+          const publicKey = preparePublicKeyRequestOptions(optionsData);
+
+          const credential = await navigator.credentials.get({
+            publicKey: publicKey
+          });
+
+          if (!credential) {
+            throw new Error('No credential returned from authenticator');
+          }
+
+          const payload = serializeAssertionCredential(credential);
+
+          const verifyRes = await fetch('/api/reauth/verify', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            credentials: 'same-origin',
+            body: JSON.stringify(payload)
+          });
+
+          if (!verifyRes.ok) {
+            throw new Error('Re-authentication verification failed');
+          }
+
+          if (statusEl) statusEl.textContent = 'Identity verified.';
+        } catch (err) {
+          if (statusEl) statusEl.textContent = err && err.message ? err.message : 'Verification failed.';
+        }
+      }
+
+      const reauthBtn = document.querySelector('[data-testid="reauth-button"]');
+      if (reauthBtn) {
+        reauthBtn.addEventListener('click', handleReauth);
+      }
+    })();
+  </script>
 </body>
 
