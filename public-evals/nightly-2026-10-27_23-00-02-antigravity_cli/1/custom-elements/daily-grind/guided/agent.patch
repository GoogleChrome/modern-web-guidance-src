+  <script type="module">
+    const cardSheet = new CSSStyleSheet();
+    cardSheet.replaceSync(`
+      :host {
+        display: block;
+        container-type: inline-size;
+        --_card-bg: var(--card-bg, white);
+        --_card-text: var(--card-text, var(--text, #3e2723));
+        --_card-primary: var(--card-primary, var(--primary, #4e342e));
+        --_card-accent: var(--card-accent, var(--accent, #ffab40));
+      }
+
+      :host([disabled]) {
+        opacity: 0.5;
+        pointer-events: none;
+      }
+
+      .card {
+        background: var(--_card-bg);
+        color: var(--_card-text);
+        padding: 20px;
+        border-radius: 8px;
+        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+        text-align: center;
+        height: 100%;
+        display: flex;
+        flex-direction: column;
+        justify-content: space-between;
+        align-items: center;
+        border: 2px solid transparent;
+        transition: border-color 0.2s, box-shadow 0.2s;
+      }
+
+      :host([featured]) .card {
+        border-color: var(--_card-accent);
+      }
+
+      .badge {
+        display: inline-block;
+        background: var(--_card-accent);
+        color: var(--_card-text);
+        font-size: 0.75rem;
+        font-weight: 700;
+        text-transform: uppercase;
+        letter-spacing: 0.05em;
+        padding: 2px 8px;
+        border-radius: 999px;
+        margin-bottom: 8px;
+      }
+
+      .badge[hidden] {
+        display: none;
+      }
+
+      h3 {
+        margin: 0 0 8px;
+        color: var(--_card-primary);
+      }
+
+      .price {
+        font-weight: 600;
+        color: var(--_card-primary);
+        margin: 0 0 8px;
+      }
+
+      .price[hidden] {
+        display: none;
+      }
+
+      .description {
+        margin: 0;
+      }
+
+      .btn {
+        display: inline-block;
+        background: var(--_card-primary);
+        color: white;
+        padding: 10px 20px;
+        text-decoration: none;
+        border-radius: 5px;
+        margin-top: 15px;
+        transition: background 0.3s;
+      }
+
+      .btn:hover {
+        background: #3e2723;
+      }
+
+      .btn[aria-disabled="true"] {
+        cursor: not-allowed;
+      }
+    `);
+
+    const cardTemplate = document.createElement('template');
+    cardTemplate.innerHTML = `
+      <article class="card" part="card">
+        <div class="card-body">
+          <span class="badge" part="badge" hidden>Featured</span>
+          <h3 part="heading"></h3>
+          <p class="price" part="price" hidden></p>
+          <p class="description" part="description"></p>
+          <slot></slot>
+        </div>
+        <a class="btn" part="cta" href="#">View Details</a>
+      </article>
+    `;
+
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = [
+        'name',
+        'description',
+        'href',
+        'price',
+        'featured',
+        'disabled',
+      ];
+
+      #badgeEl;
+      #headingEl;
+      #priceEl;
+      #descriptionEl;
+      #ctaEl;
+      #slotEl;
+      #abortController = null;
+
+      constructor() {
+        super();
+        this.attachShadow({ mode: 'open' });
+        this.shadowRoot.adoptedStyleSheets = [cardSheet];
+        this.shadowRoot.append(cardTemplate.content.cloneNode(true));
+
+        this.#badgeEl = this.shadowRoot.querySelector('.badge');
+        this.#headingEl = this.shadowRoot.querySelector('h3');
+        this.#priceEl = this.shadowRoot.querySelector('.price');
+        this.#descriptionEl = this.shadowRoot.querySelector('.description');
+        this.#ctaEl = this.shadowRoot.querySelector('.btn');
+        this.#slotEl = this.shadowRoot.querySelector('slot');
+      }
+
+      // String attributes reflected via getter/setter
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+
+      set name(value) {
+        value ? this.setAttribute('name', String(value)) : this.removeAttribute('name');
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+
+      set description(value) {
+        value
+          ? this.setAttribute('description', String(value))
+          : this.removeAttribute('description');
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '';
+      }
+
+      set href(value) {
+        value ? this.setAttribute('href', String(value)) : this.removeAttribute('href');
+      }
+
+      // Numeric attribute: coerce from string on read, serialize on write
+      get price() {
+        return Number(this.getAttribute('price')) || 0;
+      }
+
+      set price(value) {
+        this.setAttribute('price', String(value));
+      }
+
+      // Boolean attributes: present = true, absent = false (never set to "false")
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+
+      set featured(on) {
+        this.toggleAttribute('featured', !!on);
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(on) {
+        this.toggleAttribute('disabled', !!on);
+      }
+
+      connectedCallback() {
+        // Sync any properties set on the instance before custom element upgrade
+        for (const prop of CoffeeCard.observedAttributes) {
+          if (Object.prototype.hasOwnProperty.call(this, prop)) {
+            const value = this[prop];
+            delete this[prop];
+            this[prop] = value;
+          }
+        }
+
+        // Idempotent listener setup across multiple connects
+        this.#abortController?.abort();
+        this.#abortController = new AbortController();
+        const { signal } = this.#abortController;
+
+        this.#slotEl.addEventListener(
+          'slotchange',
+          () => {
+            this.render();
+          },
+          { signal }
+        );
+
+        this.#ctaEl.addEventListener(
+          'click',
+          (event) => {
+            if (this.disabled) {
+              event.preventDefault();
+            }
+          },
+          { signal }
+        );
+
+        this.render();
+      }
+
+      disconnectedCallback() {
+        this.#abortController?.abort();
+        this.#abortController = null;
+      }
+
+      connectedMoveCallback() {
+        // Preserve active state and listeners when relocated via Node.moveBefore()
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal !== newVal) {
+          this.render();
+        }
+      }
+
+      render() {
+        this.#headingEl.textContent = this.name;
+        this.#descriptionEl.textContent = this.description;
+
+        const priceVal = this.price;
+        if (priceVal > 0) {
+          this.#priceEl.textContent = `$${priceVal.toFixed(2)}`;
+          this.#priceEl.hidden = false;
+        } else {
+          this.#priceEl.textContent = '';
+          this.#priceEl.hidden = true;
+        }
+
+        this.#badgeEl.hidden = !this.featured;
+
+        const targetHref = this.href || '#';
+        if (this.disabled) {
+          this.#ctaEl.removeAttribute('href');
+          this.#ctaEl.setAttribute('aria-disabled', 'true');
+          this.#ctaEl.tabIndex = -1;
+        } else {
+          this.#ctaEl.setAttribute('href', targetHref);
+          this.#ctaEl.removeAttribute('aria-disabled');
+          this.#ctaEl.removeAttribute('tabindex');
+        }
+      }
+    }
+
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
+
 </body>
 
