+  <script>
+    class CoffeeCard extends HTMLElement {
+      static get observedAttributes() {
+        return [
+          'name',
+          'description',
+          'href',
+          'cta-text',
+          'price',
+          'roast-level',
+          'calories',
+          'featured',
+          'iced',
+          'sold-out'
+        ];
+      }
+
+      constructor() {
+        super();
+        this._isConnected = false;
+        this._handleActionClick = this._handleActionClick.bind(this);
+      }
+
+      connectedCallback() {
+        this._isConnected = true;
+        this._upgradeProperties();
+        if (!this.hasAttribute('role')) {
+          this.setAttribute('role', 'article');
+        }
+        this.render();
+        this.addEventListener('click', this._handleActionClick);
+      }
+
+      disconnectedCallback() {
+        this._isConnected = false;
+        this.removeEventListener('click', this._handleActionClick);
+      }
+
+      adoptedCallback() {
+        if (this._isConnected) {
+          this.render();
+        }
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+        if (this._isConnected) {
+          this.render();
+        }
+      }
+
+      _upgradeProperties() {
+        const props = [
+          'name',
+          'description',
+          'href',
+          'ctaText',
+          'price',
+          'roastLevel',
+          'calories',
+          'featured',
+          'iced',
+          'soldOut'
+        ];
+        for (const prop of props) {
+          if (Object.prototype.hasOwnProperty.call(this, prop)) {
+            const value = this[prop];
+            delete this[prop];
+            this[prop] = value;
+          }
+        }
+      }
+
+      // --- String attribute/property reflections ---
+      get name() {
+        return this.getAttribute('name') ?? '';
+      }
+
+      set name(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('name');
+        } else {
+          this.setAttribute('name', String(value));
+        }
+      }
+
+      get description() {
+        return this.getAttribute('description') ?? '';
+      }
+
+      set description(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('description');
+        } else {
+          this.setAttribute('description', String(value));
+        }
+      }
+
+      get href() {
+        return this.getAttribute('href') ?? '#';
+      }
+
+      set href(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('href');
+        } else {
+          this.setAttribute('href', String(value));
+        }
+      }
+
+      get ctaText() {
+        return this.getAttribute('cta-text') ?? 'View Details';
+      }
+
+      set ctaText(value) {
+        if (value === null || value === undefined) {
+          this.removeAttribute('cta-text');
+        } else {
+          this.setAttribute('cta-text', String(value));
+        }
+      }
+
+      // --- Numeric attribute/property reflections ---
+      get price() {
+        const val = Number(this.getAttribute('price'));
+        return this.hasAttribute('price') && Number.isFinite(val) ? val : 0;
+      }
+
+      set price(value) {
+        const num = Number(value);
+        if (value === null || value === undefined || value === '' || !Number.isFinite(num)) {
+          this.removeAttribute('price');
+        } else {
+          this.setAttribute('price', String(num));
+        }
+      }
+
+      get roastLevel() {
+        const val = Number(this.getAttribute('roast-level'));
+        return this.hasAttribute('roast-level') && Number.isFinite(val) ? val : 0;
+      }
+
+      set roastLevel(value) {
+        const num = Number(value);
+        if (value === null || value === undefined || value === '' || !Number.isFinite(num)) {
+          this.removeAttribute('roast-level');
+        } else {
+          this.setAttribute('roast-level', String(num));
+        }
+      }
+
+      get calories() {
+        const val = Number(this.getAttribute('calories'));
+        return this.hasAttribute('calories') && Number.isFinite(val) ? val : 0;
+      }
+
+      set calories(value) {
+        const num = Number(value);
+        if (value === null || value === undefined || value === '' || !Number.isFinite(num)) {
+          this.removeAttribute('calories');
+        } else {
+          this.setAttribute('calories', String(num));
+        }
+      }
+
+      // --- Boolean attribute/property reflections ---
+      get featured() {
+        return this.hasAttribute('featured');
+      }
+
+      set featured(value) {
+        this.toggleAttribute('featured', Boolean(value));
+      }
+
+      get iced() {
+        return this.hasAttribute('iced');
+      }
+
+      set iced(value) {
+        this.toggleAttribute('iced', Boolean(value));
+      }
+
+      get soldOut() {
+        return this.hasAttribute('sold-out');
+      }
+
+      set soldOut(value) {
+        this.toggleAttribute('sold-out', Boolean(value));
+      }
+
+      _handleActionClick(event) {
+        const link = event.target.closest('.btn');
+        if (!link) return;
+        if (this.soldOut) {
+          event.preventDefault();
+          return;
+        }
+        this.dispatchEvent(
+          new CustomEvent('coffee-select', {
+            bubbles: true,
+            composed: true,
+            detail: {
+              name: this.name,
+              price: this.price,
+              roastLevel: this.roastLevel,
+              calories: this.calories,
+              featured: this.featured,
+              iced: this.iced,
+              soldOut: this.soldOut,
+              href: this.href
+            }
+          })
+        );
+      }
+
+      _escapeHtml(str) {
+        const div = document.createElement('div');
+        div.textContent = str;
+        return div.innerHTML;
+      }
+
+      render() {
+        this.classList.add('card');
+
+        const badges = [];
+        if (this.featured) {
+          badges.push('<span class="badge badge-featured">Seasonal Favorite</span>');
+        }
+        if (this.iced) {
+          badges.push('<span class="badge badge-iced">Iced</span>');
+        }
+        if (this.soldOut) {
+          badges.push('<span class="badge badge-sold-out">Sold Out</span>');
+        }
+
+        const metaParts = [];
+        if (this.hasAttribute('price') && this.price > 0) {
+          metaParts.push(`<span class="card-price">$${this.price.toFixed(2)}</span>`);
+        }
+        if (this.roastLevel > 0) {
+          const level = Math.min(5, Math.max(1, Math.round(this.roastLevel)));
+          const beans = '●'.repeat(level) + '○'.repeat(5 - level);
+          metaParts.push(`<span class="card-roast" title="Roast Level ${level}/5">Roast: ${beans}</span>`);
+        }
+        if (this.hasAttribute('calories') && this.calories >= 0) {
+          metaParts.push(`<span class="card-calories">${this.calories} cal</span>`);
+        }
+
+        const nameHtml = this._escapeHtml(this.name);
+        const descHtml = this._escapeHtml(this.description);
+        const hrefAttr = this._escapeHtml(this.href);
+        const ctaLabel = this.soldOut ? 'Unavailable' : this._escapeHtml(this.ctaText);
+        const disabledClass = this.soldOut ? ' disabled' : '';
+        const ariaDisabled = this.soldOut ? ' aria-disabled="true" tabindex="-1"' : '';
+
+        this.innerHTML = `
+          ${badges.length ? `<div class="card-badges">${badges.join('')}</div>` : ''}
+          <h3>${nameHtml}</h3>
+          <p>${descHtml}</p>
+          ${metaParts.length ? `<div class="card-meta">${metaParts.join('<span>•</span>')}</div>` : ''}
+          <a href="${hrefAttr}" class="btn${disabledClass}"${ariaDisabled}>${ctaLabel}</a>
+        `;
+      }
+    }
+
+    if (!customElements.get('coffee-card')) {
+      customElements.define('coffee-card', CoffeeCard);
+    }
+  </script>
 </body>
 
 </html>
