+  <script>
+    // Sync aria-invalid with the CSS :user-invalid state for accessibility
+    const contactForm = document.getElementById('contact-form');
+    const syncAria = (el) => {
+      if (el.matches && el.matches('input, textarea')) {
+        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+      }
+    };
+
+    contactForm.addEventListener('blur', (e) => syncAria(e.target), true);
+    contactForm.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+    });
+    contactForm.addEventListener('submit', () => {
+      contactForm.querySelectorAll('input, textarea').forEach(syncAria);
+    });
+  </script>
+
