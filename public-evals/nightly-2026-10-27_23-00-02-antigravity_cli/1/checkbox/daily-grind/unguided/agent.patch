+    .card > p {
+      margin-bottom: 16px;
+      color: #5d4037;
+    }
+
+    /* Customization Checkboxes */
+    .custom-options {
+      border: none;
+      border-top: 1px solid var(--secondary);
+      padding-top: 14px;
+      margin-top: auto;
+      margin-bottom: 6px;
+      text-align: left;
+    }
+
+    .custom-options legend {
+      font-size: 0.78rem;
+      font-weight: 700;
+      text-transform: uppercase;
+      letter-spacing: 0.08em;
+      color: var(--primary);
+      padding: 0 6px;
+      margin-left: -6px;
+      margin-bottom: 8px;
+    }
+
+    .checkbox-group {
+      display: flex;
+      flex-direction: column;
+      gap: 8px;
+    }
+
+    .custom-checkbox {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      padding: 8px 10px;
+      border-radius: 6px;
+      border: 1px solid #efebe9;
+      background-color: var(--light);
+      cursor: pointer;
+      user-select: none;
+      position: relative;
+      transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.15s ease, box-shadow 0.25s ease;
+    }
+
+    .custom-checkbox:hover {
+      background-color: #f3ecea;
+      border-color: var(--secondary);
+    }
+
+    .custom-checkbox:active {
+      transform: scale(0.99);
+    }
+
+    /* Accessible visually-hidden native checkbox input */
+    .custom-checkbox input[type="checkbox"] {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      margin: -1px;
+      overflow: hidden;
+      clip: rect(0, 0, 0, 0);
+      white-space: nowrap;
+      border: 0;
+    }
+
+    .checkbox-control {
+      width: 20px;
+      height: 20px;
+      border: 2px solid var(--primary);
+      border-radius: 5px;
+      background-color: white;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      flex-shrink: 0;
+      transition: background-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+        border-color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+        transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
+        box-shadow 0.2s ease;
+    }
+
+    .checkbox-icon {
+      width: 13px;
+      height: 13px;
+      fill: none;
+      stroke: white;
+      stroke-width: 2.5;
+      stroke-linecap: round;
+      stroke-linejoin: round;
+      stroke-dasharray: 22;
+      stroke-dashoffset: 22;
+      opacity: 0;
+      transform: scale(0.6);
+      transition: stroke-dashoffset 0.25s cubic-bezier(0.4, 0, 0.2, 1),
+        opacity 0.2s ease,
+        transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .option-icon {
+      width: 16px;
+      height: 16px;
+      color: #8d6e63;
+      flex-shrink: 0;
+      transition: color 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .checkbox-label {
+      font-size: 0.88rem;
+      font-weight: 500;
+      color: var(--text);
+      flex-grow: 1;
+      transition: color 0.2s ease;
+    }
+
+    .checkbox-price {
+      font-size: 0.75rem;
+      font-weight: 600;
+      color: var(--primary);
+      background: var(--secondary);
+      padding: 2px 7px;
+      border-radius: 999px;
+      transition: background-color 0.25s ease, color 0.25s ease;
+    }
+
+    /* Checked states & animations */
+    .custom-checkbox input[type="checkbox"]:checked + .checkbox-control {
+      background-color: var(--primary);
+      border-color: var(--primary);
+      transform: scale(1.06);
+      animation: checkBounce 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
+    }
+
+    .custom-checkbox input[type="checkbox"]:not(:checked) + .checkbox-control {
+      animation: uncheckPulse 0.2s ease-out;
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked + .checkbox-control .checkbox-icon {
+      stroke-dashoffset: 0;
+      opacity: 1;
+      transform: scale(1);
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .option-icon {
+      color: var(--accent);
+      transform: scale(1.15) rotate(-6deg);
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-label {
+      color: var(--primary);
+      font-weight: 600;
+    }
+
+    .custom-checkbox input[type="checkbox"]:checked ~ .checkbox-price {
+      background-color: var(--accent);
+      color: var(--text);
+    }
+
+    .custom-checkbox:has(input[type="checkbox"]:checked) {
+      background-color: #fbf7f5;
+      border-color: var(--primary);
+      box-shadow: 0 1px 4px rgba(78, 52, 46, 0.12);
+    }
+
+    /* Keyboard focus accessibility */
+    .custom-checkbox input[type="checkbox"]:focus-visible + .checkbox-control {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+      box-shadow: 0 0 0 4px rgba(255, 171, 64, 0.25);
+    }
+
+    .custom-checkbox:has(input[type="checkbox"]:focus-visible) {
+      border-color: var(--accent);
+    }
+
+    /* Disabled state support */
+    .custom-checkbox input[type="checkbox"]:disabled ~ * {
+      opacity: 0.55;
+      cursor: not-allowed;
+    }
+
+    @keyframes checkBounce {
+      0% {
+        transform: scale(0.85);
+      }
+      55% {
+        transform: scale(1.14);
+      }
+      100% {
+        transform: scale(1.06);
+      }
+    }
+
+    @keyframes uncheckPulse {
+      0% {
+        transform: scale(1.06);
+      }
+      50% {
+        transform: scale(0.92);
+      }
+      100% {
+        transform: scale(1);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .custom-checkbox,
+      .checkbox-control,
+      .checkbox-icon,
+      .option-icon,
+      .checkbox-label,
+      .checkbox-price {
+        transition: none;
+        animation: none !important;
+      }
+    }
+
