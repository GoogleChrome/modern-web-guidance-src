+      z-index: 1001;
+    }
+
+    @supports (position-area: right) {
+      .drink-tooltip[popover] {
+        top: auto;
+        left: auto;
+        position-area: right;
+        position-try-fallbacks: flip-inline, flip-block;
+      }
+    }
+
+    .drink-tooltip[popover]:is(:popover-open, .\:popover-open) {
+      display: block;
+    }
+
+    .drink-tooltip h4 {
+      color: var(--accent);
+      margin-bottom: 6px;
+      font-size: 0.95rem;
+      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
+      padding-bottom: 4px;
+    }
+
+    .drink-tooltip ul {
+      list-style: none;
+      margin: 0;
+      padding: 0;
+    }
+
+    .drink-tooltip li {
+      display: flex;
+      justify-content: space-between;
+      gap: 12px;
+      margin-bottom: 3px;
+    }
+
+    .drink-tooltip li:last-child {
+      margin-bottom: 0;
+    }
+
+    .drink-tooltip .label {
+      color: var(--secondary);
+    }
+
+    .drink-tooltip .val {
+      font-weight: 600;
+    }
+
+    :is(:interest-source, .interest-source) {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
