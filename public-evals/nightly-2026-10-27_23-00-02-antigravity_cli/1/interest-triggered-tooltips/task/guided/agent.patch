+    .drink-tooltip[popover] {
+      position: fixed;
+      inset: auto;
+      top: anchor(top);
+      left: anchor(right);
+      margin: 0 0 0 10px;
+      background: var(--primary);
+      color: var(--light);
+      border: 1px solid var(--accent);
+      border-radius: 8px;
+      padding: 12px 16px;
+      width: max-content;
+      max-width: 240px;
+      text-align: left;
