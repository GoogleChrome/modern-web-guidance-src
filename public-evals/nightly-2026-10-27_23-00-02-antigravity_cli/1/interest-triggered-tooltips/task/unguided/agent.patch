+  <script>
+    document.querySelectorAll('.tooltip-wrapper').forEach(wrapper => {
+      const popover = wrapper.querySelector('.tooltip-popover');
+      const adjustPosition = () => {
+        if (!popover) return;
+        popover.classList.remove('flip-left');
+        const rect = popover.getBoundingClientRect();
+        if (rect.right > window.innerWidth - 12) {
+          popover.classList.add('flip-left');
+        }
+      };
+      wrapper.addEventListener('mouseenter', adjustPosition);
+      wrapper.addEventListener('focusin', adjustPosition);
+    });
+  </script>
