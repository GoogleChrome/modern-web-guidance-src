+    /* Tooltip / Popover Styles */
+    .card {
+      position: relative;
+    }
+
+    .tooltip-wrapper {
+      position: relative;
+      display: inline-block;
+      margin-top: 15px;
+    }
+
+    .tooltip-wrapper .btn {
+      margin-top: 0;
+    }
+
+    .tooltip-popover {
+      visibility: hidden;
+      opacity: 0;
+      position: absolute;
+      left: calc(100% + 12px);
+      top: 50%;
+      transform: translateY(-50%) translateX(-6px);
+      width: 220px;
+      background: #ffffff;
+      color: var(--text);
+      text-align: left;
+      padding: 12px 14px;
+      border-radius: 8px;
+      border: 1px solid var(--secondary);
+      box-shadow: 0 8px 24px rgba(62, 39, 35, 0.18);
+      font-size: 0.82rem;
+      line-height: 1.45;
+      z-index: 200;
+      pointer-events: none;
+      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
+    }
+
+    .tooltip-popover::before {
+      content: '';
+      position: absolute;
+      right: 100%;
+      top: 50%;
+      transform: translateY(-50%);
+      border-width: 7px;
+      border-style: solid;
+      border-color: transparent var(--secondary) transparent transparent;
+    }
+
+    .tooltip-popover::after {
+      content: '';
+      position: absolute;
+      right: 100%;
+      top: 50%;
+      transform: translateY(-50%);
+      border-width: 6px;
+      border-style: solid;
+      border-color: transparent #ffffff transparent transparent;
+    }
+
+    .tooltip-popover.flip-left {
+      left: auto;
+      right: calc(100% + 12px);
+      transform: translateY(-50%) translateX(6px);
+    }
+
+    .tooltip-popover.flip-left::before {
+      right: auto;
+      left: 100%;
+      border-color: transparent transparent transparent var(--secondary);
+    }
+
+    .tooltip-popover.flip-left::after {
+      right: auto;
+      left: 100%;
+      border-color: transparent transparent transparent #ffffff;
+    }
+
+    .tooltip-wrapper:hover .tooltip-popover,
+    .tooltip-wrapper:focus-within .tooltip-popover {
+      visibility: visible;
+      opacity: 1;
+      transform: translateY(-50%) translateX(0);
+    }
+
+    .tooltip-title {
+      font-weight: 700;
+      color: var(--primary);
+      font-size: 0.88rem;
+      margin-bottom: 6px;
+      padding-bottom: 4px;
+      border-bottom: 1px solid var(--secondary);
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    .calorie-badge {
+      background: var(--accent);
+      color: var(--text);
+      font-weight: 700;
+      font-size: 0.75rem;
+      padding: 2px 6px;
+      border-radius: 999px;
+    }
+
+    .tooltip-meta {
+      list-style: none;
+      margin: 0;
+      padding: 0;
+    }
+
+    .tooltip-meta li {
+      display: flex;
+      justify-content: space-between;
+      margin-top: 4px;
+      color: #5d4037;
+    }
+
+    .tooltip-meta li span:last-child {
+      font-weight: 600;
+      color: var(--text);
+    }
+
+    .tooltip-note {
+      margin-top: 6px;
+      font-size: 0.75rem;
+      color: #6d4c41;
+      font-style: italic;
+    }
+
     footer {
