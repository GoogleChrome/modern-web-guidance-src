+  <script>
+    const shippingForm = document.getElementById('shipping-address-form');
+    const shippingSubmitBtn = document.getElementById('shipping-submit');
+    const shippingStatus = document.getElementById('shipping-status');
+
+    if (shippingForm) {
+      shippingForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!shippingForm.checkValidity()) {
+          shippingForm.reportValidity();
+          return;
+        }
+        shippingSubmitBtn.disabled = true;
+        shippingStatus.textContent = '✓ Shipping address saved for coffee bean delivery. Proceeding to payment...';
+        shippingStatus.classList.add('success');
+        shippingStatus.hidden = false;
+      });
+
+      shippingForm.addEventListener('input', () => {
+        if (shippingSubmitBtn.disabled) {
+          shippingSubmitBtn.disabled = false;
+          shippingStatus.hidden = true;
+        }
+      });
+    }
+  </script>
