+  <script>
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const detailTitle = document.getElementById('title');
+    const detailDesc = document.getElementById('detail-description');
+    const detailNotes = document.getElementById('detail-notes');
+    const hero = document.getElementById('hero');
+    const backBtn = document.getElementById('back-btn');
+    const thumbnails = document.querySelectorAll('.thumbnail');
+
+    function applyDetailState(card) {
+      const title = card.dataset.title;
+      const desc = card.dataset.desc;
+      const notes = card.dataset.notes;
+      const image = card.dataset.image;
+      const bgColor = card.dataset.bg || getComputedStyle(card).backgroundColor;
+
+      detailTitle.textContent = title;
+      detailDesc.textContent = desc;
+      detailNotes.textContent = notes;
+      hero.style.backgroundColor = bgColor;
+      hero.style.backgroundImage = image ? `url('${image}')` : 'none';
+      hero.setAttribute('aria-label', title);
+
+      document.body.classList.add('detail');
+      listPage.hidden = true;
+      detailPage.hidden = false;
+      document.title = `${title} | The Daily Grind`;
+    }
+
+    function applyListState() {
+      document.body.classList.remove('detail');
+      detailPage.hidden = true;
+      listPage.hidden = false;
+      document.title = 'The Daily Grind | Artisanal Coffee';
+    }
+
+    function goFromListToDetail(e) {
+      const card = e.currentTarget;
+
+      // Ensure any previous selected classes are cleared before starting
+      document.querySelectorAll('.selected').forEach((el) => el.classList.remove('selected'));
+      card.classList.add('selected');
+
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      if (!document.startViewTransition || prefersReducedMotion) {
+        applyDetailState(card);
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        applyDetailState(card);
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+      if (!document.startViewTransition || prefersReducedMotion) {
+        applyListState();
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        applyListState();
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+      });
+    }
+
+    thumbnails.forEach((thumbnail) => {
+      thumbnail.addEventListener('click', (e) => {
+        e.preventDefault();
+        goFromListToDetail(e);
+      });
+
+      thumbnail.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter') {
+          e.preventDefault();
+          goFromListToDetail(e);
+        } else if (e.key === ' ') {
+          e.preventDefault();
+        }
+      });
+
+      thumbnail.addEventListener('keyup', (e) => {
+        if (e.key === ' ') {
+          e.preventDefault();
+          goFromListToDetail(e);
+        }
+      });
+    });
+
+    backBtn.addEventListener('click', () => {
+      goFromDetailToList();
+    });
+  </script>
+
 </body>
 
