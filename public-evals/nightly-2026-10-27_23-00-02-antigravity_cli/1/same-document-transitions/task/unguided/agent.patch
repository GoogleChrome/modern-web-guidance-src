+  <script>
+    const favoritesData = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1200&q=80',
+        alt: 'Maple Oat Latte',
+        price: '$5.50',
+        calories: '180 cal',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup. Crafted with our signature double-shot espresso and steamed velvety oat milk, finished with pure grade-A dark amber maple syrup and a light dusting of cinnamon.',
+        notes: 'Toasted oats, rich maple, warm spice finish.'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1200&q=80',
+        alt: 'Dark Roast Espresso',
+        price: '$3.75',
+        calories: '15 cal',
+        description: 'Bold, smokey, and perfect for a morning boost. Roasted in small batches to bring out deep caramelized sugars and dark cocoa undertones with a rich, golden crema.',
+        notes: 'Dark chocolate, roasted walnut, smoky caramel.'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=1200&q=80',
+        alt: 'Cold Brew',
+        price: '$4.75',
+        calories: '5 cal',
+        description: 'Steeped for 18 hours for maximum smoothness. Coarse-ground single-origin Colombian beans slowly extracted in cold filtered water for a naturally sweet, low-acid profile.',
+        notes: 'Smooth molasses, sweet almond, crisp cocoa finish.'
+      }
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const heroEl = document.getElementById('hero');
+    const titleEl = document.getElementById('title');
+    const detailPrice = document.getElementById('detail-price');
+    const detailCalories = document.getElementById('detail-calories');
+    const detailDescription = document.getElementById('detail-description');
+    const detailNotes = document.getElementById('detail-notes');
+    const backButton = document.getElementById('back-button');
+    const thumbnails = document.querySelectorAll('.thumbnail');
+
+    let activeCard = null;
+
+    function prefersReducedMotion() {
+      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    }
+
+    function clearTransitionState() {
+      const elementsWithClass = document.querySelectorAll('.vt-hero, .vt-title');
+      elementsWithClass.forEach(el => {
+        el.classList.remove('vt-hero', 'vt-title');
+      });
+
+      const allElements = [
+        ...thumbnails,
+        ...document.querySelectorAll('.thumbnail .card-img, .thumbnail .title'),
+        heroEl,
+        titleEl
+      ];
+      allElements.forEach(el => {
+        if (el && el.style) {
+          el.style.removeProperty('view-transition-name');
+          if (el.getAttribute('style') === '') {
+            el.removeAttribute('style');
+          }
+        }
+      });
+    }
+
+    function applyDetailContent(id, card) {
+      const item = favoritesData[id];
+      if (!item) return;
+
+      const cardImg = card.querySelector('.card-img');
+      heroEl.src = cardImg ? cardImg.src : item.image;
+      heroEl.alt = item.alt;
+      titleEl.textContent = item.title;
+      detailPrice.textContent = item.price;
+      detailCalories.textContent = item.calories;
+      detailDescription.textContent = item.description;
+      detailNotes.innerHTML = `<strong>Tasting Notes:</strong> ${item.notes}`;
+    }
+
+    function showDetailView(card, pushHistory = true) {
+      const id = card.getAttribute('data-id');
+      activeCard = card;
+
+      const cardTitle = card.querySelector('.title');
+
+      const updateDOM = () => {
+        applyDetailContent(id, card);
+        listPage.hidden = true;
+        detailPage.hidden = false;
+      };
+
+      if (pushHistory) {
+        history.pushState({ view: 'detail', id }, '', `#${id}`);
+      }
+
+      if (!document.startViewTransition || prefersReducedMotion()) {
+        clearTransitionState();
+        updateDOM();
+        titleEl.focus();
+        return;
+      }
+
+      clearTransitionState();
+
+      // Tag source thumbnail & title before capturing old state
+      card.classList.add('vt-hero');
+      card.style.viewTransitionName = 'hero-morph';
+      if (cardTitle) {
+        cardTitle.classList.add('vt-title');
+        cardTitle.style.viewTransitionName = 'title-morph';
+      }
+
+      const transition = document.startViewTransition(() => {
+        // Remove transition names from old elements and assign to detail targets
+        card.classList.remove('vt-hero');
+        card.style.removeProperty('view-transition-name');
+        if (card.getAttribute('style') === '') card.removeAttribute('style');
+
+        if (cardTitle) {
+          cardTitle.classList.remove('vt-title');
+          cardTitle.style.removeProperty('view-transition-name');
+          if (cardTitle.getAttribute('style') === '') cardTitle.removeAttribute('style');
+        }
+
+        heroEl.classList.add('vt-hero');
+        heroEl.style.viewTransitionName = 'hero-morph';
+        titleEl.classList.add('vt-title');
+        titleEl.style.viewTransitionName = 'title-morph';
+
+        updateDOM();
+      });
+
+      transition.finished.finally(() => {
+        clearTransitionState();
+        titleEl.focus();
+      });
+    }
+
+    function showListView(pushHistory = true) {
+      const targetCard = activeCard || document.querySelector('.thumbnail');
+      const cardTitle = targetCard ? targetCard.querySelector('.title') : null;
+
+      const updateDOM = () => {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+      };
+
+      if (pushHistory) {
+        history.pushState({ view: 'list' }, '', window.location.pathname);
+      }
+
+      if (!document.startViewTransition || prefersReducedMotion() || !targetCard) {
+        clearTransitionState();
+        updateDOM();
+        listHeading.focus();
+        return;
+      }
+
+      clearTransitionState();
+
+      // Tag detail hero & title before capturing old state
+      heroEl.classList.add('vt-hero');
+      heroEl.style.viewTransitionName = 'hero-morph';
+      titleEl.classList.add('vt-title');
+      titleEl.style.viewTransitionName = 'title-morph';
+
+      const transition = document.startViewTransition(() => {
+        heroEl.classList.remove('vt-hero');
+        heroEl.style.removeProperty('view-transition-name');
+        if (heroEl.getAttribute('style') === '') heroEl.removeAttribute('style');
+
+        titleEl.classList.remove('vt-title');
+        titleEl.style.removeProperty('view-transition-name');
+        if (titleEl.getAttribute('style') === '') titleEl.removeAttribute('style');
+
+        targetCard.classList.add('vt-hero');
+        targetCard.style.viewTransitionName = 'hero-morph';
+        if (cardTitle) {
+          cardTitle.classList.add('vt-title');
+          cardTitle.style.viewTransitionName = 'title-morph';
+        }
+
+        updateDOM();
+      });
+
+      transition.finished.finally(() => {
+        clearTransitionState();
+        listHeading.focus();
+      });
+    }
+
+    thumbnails.forEach(card => {
+      card.addEventListener('click', (e) => {
+        e.preventDefault();
+        showDetailView(card);
+      });
+
+      card.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          showDetailView(card);
+        }
+      });
+    });
+
+    backButton.addEventListener('click', (e) => {
+      e.preventDefault();
+      showListView();
+    });
+
+    window.addEventListener('popstate', (e) => {
+      if (e.state && e.state.view === 'detail' && e.state.id) {
+        const card = document.querySelector(`.thumbnail[data-id="${e.state.id}"]`);
+        if (card) {
+          showDetailView(card, false);
+          return;
+        }
+      }
+      if (!detailPage.hidden) {
+        showListView(false);
+      }
+    });
+  </script>
