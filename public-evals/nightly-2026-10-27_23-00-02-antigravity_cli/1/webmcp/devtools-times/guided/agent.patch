diff --git a/src/components/ArticleTools.tsx b/src/components/ArticleTools.tsx
new file mode 100644
index 0000000..3e9792d
--- /dev/null
+++ b/src/components/ArticleTools.tsx
@@ -0,0 +1,304 @@
+import React from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+export interface ArticleMetadata {
+    slug: string;
+    title: string;
+    summary: string;
+    author: string;
+    date: string;
+    category: string;
+    readingTime?: number;
+    tags?: string[];
+}
+
+interface Props {
+    article: ArticleMetadata;
+    initialIsBookmarked: boolean;
+}
+
+const GET_ARTICLE_DETAILS_SCHEMA = {
+    type: 'object',
+    properties: {
+        includeBodyText: {
+            type: 'boolean',
+            default: true,
+            description: 'Whether to include the full plain-text body and section headings of the article.',
+        },
+    },
+} as const;
+
+const READ_ONLY_ANNOTATIONS = {
+    readOnlyHint: true,
+} as const;
+
+const READING_SPEED_SCHEMA = {
+    type: 'object',
+    properties: {
+        wordsPerMinute: {
+            type: 'number',
+            default: 200,
+            minimum: 50,
+            maximum: 1000,
+            description: 'Reader speed in words per minute used to compute estimated reading duration.',
+        },
+    },
+} as const;
+
+const BOOKMARK_ACTIONS = ['toggle', 'add', 'remove'] as const;
+
+const BOOKMARK_CURRENT_SCHEMA = {
+    type: 'object',
+    properties: {
+        action: {
+            type: 'string',
+            enum: BOOKMARK_ACTIONS,
+            default: 'toggle',
+            description: 'Bookmark action to perform on the current article.',
+        },
+    },
+} as const;
+
+const MUTATION_ANNOTATIONS = {
+    readOnlyHint: false,
+} as const;
+
+const SHARE_CHANNELS = ['copy-link', 'x', 'facebook', 'email'] as const;
+
+const SHARE_ARTICLE_SCHEMA = {
+    type: 'object',
+    properties: {
+        channel: {
+            type: 'string',
+            enum: SHARE_CHANNELS,
+            default: 'copy-link',
+            description: 'Target sharing method or social platform for the article.',
+        },
+    },
+} as const;
+
+const POPULARITY_SCHEMA = {
+    type: 'object',
+    properties: {},
+} as const;
+
+export default function ArticleTools({ article, initialIsBookmarked }: Props) {
+    const [isBookmarked, setIsBookmarked] = React.useState(initialIsBookmarked);
+    const [statusMessage, setStatusMessage] = React.useState<string | null>(null);
+
+    React.useEffect(() => {
+        const handleReadingListChange = (event: Event) => {
+            const customEvent = event as CustomEvent<{ readingList?: string[] }>;
+            if (Array.isArray(customEvent.detail?.readingList)) {
+                setIsBookmarked(customEvent.detail.readingList.includes(article.slug));
+            }
+        };
+        window.addEventListener('reading-list-updated', handleReadingListChange);
+        return () => {
+            window.removeEventListener('reading-list-updated', handleReadingListChange);
+        };
+    }, [article.slug]);
+
+    useWebMCP({
+        name: 'get_current_article',
+        description: 'Extract metadata, section headings, and full text content of the article currently open on the page. Use when the user asks questions about, summarizes, or inspects the current article.',
+        inputSchema: GET_ARTICLE_DETAILS_SCHEMA,
+        annotations: READ_ONLY_ANNOTATIONS,
+        execute({ includeBodyText = true }: { includeBodyText?: boolean } = {}) {
+            if (typeof includeBodyText !== 'boolean') {
+                return { error: 'includeBodyText must be a boolean.' };
+            }
+            const proseEl = document.querySelector('article .prose');
+            const bodyText = includeBodyText && proseEl ? (proseEl.textContent || '').trim() : undefined;
+            const headings = proseEl
+                ? Array.from(proseEl.querySelectorAll('h1, h2, h3, h4')).map(h => (h.textContent || '').trim())
+                : [];
+
+            return {
+                ...article,
+                isBookmarked,
+                url: window.location.href,
+                headings,
+                ...(includeBodyText ? { bodyText } : {}),
+            };
+        },
+    });
+
+    useWebMCP({
+        name: 'analyze_article_reading_stats',
+        description: 'Calculate word count, character count, paragraph count, and custom reading time for the current article based on reading speed. Use when the user asks how long the article takes to read or wants text statistics.',
+        inputSchema: READING_SPEED_SCHEMA,
+        annotations: READ_ONLY_ANNOTATIONS,
+        execute({ wordsPerMinute = 200 }: { wordsPerMinute?: number } = {}) {
+            if (typeof wordsPerMinute !== 'number' || Number.isNaN(wordsPerMinute) || wordsPerMinute < 50 || wordsPerMinute > 1000) {
+                return {
+                    error: 'Provide a valid wordsPerMinute number between 50 and 1000.',
+                };
+            }
+            const proseEl = document.querySelector('article .prose');
+            const rawText = (proseEl?.textContent || '').trim();
+            const words = rawText ? rawText.split(/\s+/).filter(Boolean) : [];
+            const paragraphs = proseEl ? proseEl.querySelectorAll('p').length : 0;
+            const estimatedMinutes = Math.max(1, Math.ceil(words.length / wordsPerMinute));
+
+            return {
+                slug: article.slug,
+                title: article.title,
+                wordCount: words.length,
+                characterCount: rawText.length,
+                paragraphCount: paragraphs,
+                wordsPerMinute,
+                estimatedReadingTimeMinutes: estimatedMinutes,
+                publishedReadingTimeMinutes: article.readingTime ?? estimatedMinutes,
+            };
+        },
+    });
+
+    useWebMCP({
+        name: 'bookmark_current_article',
+        description: 'Bookmark or unbookmark the currently viewed article in the user reading list. Use when the user asks to save or remove the current article.',
+        inputSchema: BOOKMARK_CURRENT_SCHEMA,
+        annotations: MUTATION_ANNOTATIONS,
+        async execute(
+            { action = 'toggle' }: { action?: (typeof BOOKMARK_ACTIONS)[number] } = {},
+            { signal }
+        ) {
+            if (!BOOKMARK_ACTIONS.includes(action)) {
+                return {
+                    error: 'Unsupported bookmark action.',
+                    supportedActions: BOOKMARK_ACTIONS,
+                };
+            }
+            try {
+                const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({ slug: article.slug, action }),
+                    signal,
+                });
+                if (!response.ok) {
+                    return { error: `Failed to update reading list (status ${response.status})` };
+                }
+                const data = await response.json();
+                const updatedList: string[] = data.readingList || [];
+                const nowBookmarked = updatedList.includes(article.slug);
+                signal.throwIfAborted();
+                setIsBookmarked(nowBookmarked);
+                setStatusMessage(
+                    nowBookmarked ? 'Saved to reading list' : 'Removed from reading list'
+                );
+                window.dispatchEvent(
+                    new CustomEvent('reading-list-updated', { detail: { readingList: updatedList } })
+                );
+                return {
+                    slug: article.slug,
+                    title: article.title,
+                    isBookmarked: nowBookmarked,
+                    readingList: updatedList,
+                };
+            } catch (err) {
+                if (signal.aborted) {
+                    throw err;
+                }
+                return { error: err instanceof Error ? err.message : String(err) };
+            }
+        },
+    });
+
+    useWebMCP({
+        name: 'get_article_popularity',
+        description: 'Fetch live view count and trending status for the current article. Use when the user asks how popular the article is or whether it is trending.',
+        inputSchema: POPULARITY_SCHEMA,
+        annotations: READ_ONLY_ANNOTATIONS,
+        async execute(_input, { signal }) {
+            try {
+                const response = await fetch(
+                    `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(article.slug)}`,
+                    { signal }
+                );
+                if (!response.ok) {
+                    return { error: `Popularity request failed with status ${response.status}` };
+                }
+                const data = await response.json();
+                signal.throwIfAborted();
+                return {
+                    slug: article.slug,
+                    title: article.title,
+                    views: data.views,
+                    trending: data.trending,
+                };
+            } catch (err) {
+                if (signal.aborted) {
+                    throw err;
+                }
+                return { error: err instanceof Error ? err.message : String(err) };
+            }
+        },
+    });
+
+    useWebMCP({
+        name: 'share_current_article',
+        description: 'Generate a shareable link or copy the current article URL to the clipboard. Use when the user wants to share the current article.',
+        inputSchema: SHARE_ARTICLE_SCHEMA,
+        annotations: READ_ONLY_ANNOTATIONS,
+        async execute({ channel = 'copy-link' }: { channel?: (typeof SHARE_CHANNELS)[number] } = {}) {
+            if (!SHARE_CHANNELS.includes(channel)) {
+                return {
+                    error: 'Unsupported share channel.',
+                    supportedChannels: SHARE_CHANNELS,
+                };
+            }
+            const shareUrl = window.location.href;
+            const encodedUrl = encodeURIComponent(shareUrl);
+            const encodedTitle = encodeURIComponent(article.title);
+
+            if (channel === 'copy-link') {
+                let copied = false;
+                try {
+                    if (navigator.clipboard?.writeText) {
+                        await navigator.clipboard.writeText(shareUrl);
+                        copied = true;
+                    }
+                } catch {
+                    copied = false;
+                }
+                setStatusMessage(copied ? 'Article link copied to clipboard' : `Share link: ${shareUrl}`);
+                return {
+                    channel,
+                    copiedToClipboard: copied,
+                    url: shareUrl,
+                    title: article.title,
+                };
+            }
+
+            const shareLinks: Record<Exclude<(typeof SHARE_CHANNELS)[number], 'copy-link'>, string> = {
+                x: `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`,
+                facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
+                email: `mailto:?subject=${encodedTitle}&body=${encodedUrl}`,
+            };
+
+            const targetShareUrl = shareLinks[channel];
+            setStatusMessage(`Prepared ${channel} share link`);
+            return {
+                channel,
+                url: shareUrl,
+                shareIntentUrl: targetShareUrl,
+                title: article.title,
+            };
+        },
+    });
+
+    if (!statusMessage) {
+        return null;
+    }
+
+    return (
+        <div
+            role="status"
+            aria-live="polite"
+            className="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded px-3 py-1.5 my-2 inline-block"
+        >
+            {statusMessage}
+        </div>
+    );
+}
