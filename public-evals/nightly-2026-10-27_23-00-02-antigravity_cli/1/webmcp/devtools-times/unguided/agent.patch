diff --git a/src/components/ArticleWebMCPTools.tsx b/src/components/ArticleWebMCPTools.tsx
new file mode 100644
index 0000000..be3ac75
--- /dev/null
+++ b/src/components/ArticleWebMCPTools.tsx
@@ -0,0 +1,208 @@
+import React, { useEffect, useState } from 'react';
+import {
+  registerWebMCPTools,
+  type ArticleContextData,
+} from '../utils/webmcp';
+
+interface Props {
+  article?: ArticleContextData;
+  showUtilityBar?: boolean;
+}
+
+export default function ArticleWebMCPTools({
+  article,
+  showUtilityBar = false,
+}: Props) {
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+  const [highlightTerm, setHighlightTerm] = useState('');
+  const [readingSpeedWpm, setReadingSpeedWpm] = useState(200);
+  const [statsSummary, setStatsSummary] = useState<{
+    wordCount: number;
+    estimatedMinutes: number;
+  } | null>(null);
+
+  useEffect(() => {
+    const cleanup = registerWebMCPTools(import.meta.env.BASE_URL, article);
+    return cleanup;
+  }, [article]);
+
+  const handleCalculateStats = () => {
+    const bodyEl =
+      document.querySelector('article [data-article-body]') ||
+      document.querySelector('article .prose');
+    const text = bodyEl ? (bodyEl as HTMLElement).innerText.trim() : '';
+    const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
+    const wpm = readingSpeedWpm > 0 ? readingSpeedWpm : 200;
+    const minutes = words > 0 ? Math.max(1, Math.ceil(words / wpm)) : 0;
+    setStatsSummary({ wordCount: words, estimatedMinutes: minutes });
+    setStatusMessage(`${words} words (~${minutes} min read at ${wpm} WPM)`);
+  };
+
+  const handleHighlight = (e: React.FormEvent) => {
+    e.preventDefault();
+    const bodyEl =
+      document.querySelector('article [data-article-body]') ||
+      document.querySelector('article .prose');
+    if (!bodyEl) return;
+
+    const existingMarks = bodyEl.querySelectorAll('mark[data-webmcp-highlight]');
+    existingMarks.forEach((mark) => {
+      const parent = mark.parentNode;
+      if (parent) {
+        parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
+        parent.normalize();
+      }
+    });
+
+    const phrase = highlightTerm.trim();
+    if (!phrase) {
+      setStatusMessage('Cleared highlights.');
+      return;
+    }
+
+    const walker = document.createTreeWalker(bodyEl, NodeFilter.SHOW_TEXT);
+    const textNodes: Text[] = [];
+    let currentNode = walker.nextNode();
+    while (currentNode) {
+      if (
+        currentNode.parentElement &&
+        !['SCRIPT', 'STYLE', 'MARK'].includes(currentNode.parentElement.tagName)
+      ) {
+        textNodes.push(currentNode as Text);
+      }
+      currentNode = walker.nextNode();
+    }
+
+    let matchCount = 0;
+    let firstMark: HTMLElement | null = null;
+    const escaped = phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+    const regex = new RegExp(`(${escaped})`, 'gi');
+
+    for (const node of textNodes) {
+      const value = node.nodeValue || '';
+      if (!regex.test(value)) continue;
+      regex.lastIndex = 0;
+
+      const fragment = document.createDocumentFragment();
+      let lastIdx = 0;
+      let match: RegExpExecArray | null;
+      while ((match = regex.exec(value)) !== null) {
+        if (match.index > lastIdx) {
+          fragment.appendChild(
+            document.createTextNode(value.slice(lastIdx, match.index))
+          );
+        }
+        const mark = document.createElement('mark');
+        mark.setAttribute('data-webmcp-highlight', 'true');
+        mark.className = 'bg-amber-200 text-gray-900 px-0.5 rounded';
+        mark.textContent = match[0];
+        if (!firstMark) firstMark = mark;
+        fragment.appendChild(mark);
+        matchCount++;
+        lastIdx = regex.lastIndex;
+      }
+      if (lastIdx < value.length) {
+        fragment.appendChild(document.createTextNode(value.slice(lastIdx)));
+      }
+      node.parentNode?.replaceChild(fragment, node);
+    }
+
+    if (firstMark) {
+      firstMark.scrollIntoView({ behavior: 'smooth', block: 'center' });
+    }
+    setStatusMessage(`Highlighted ${matchCount} occurrence(s) of "${phrase}".`);
+  };
+
+  const handleCopyCitation = async () => {
+    const shareUrl = window.location.href;
+    const shareTitle = article?.title || document.title;
+    const citation = `${shareTitle} — The DevTools Times (${shareUrl})`;
+    if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
+      try {
+        await navigator.clipboard.writeText(citation);
+        setStatusMessage('Article citation copied to clipboard.');
+        return;
+      } catch {
+        // Fallback below
+      }
+    }
+    setStatusMessage(citation);
+  };
+
+  if (!showUtilityBar) {
+    return null;
+  }
+
+  return (
+    <div
+      className="my-4 p-3 bg-gray-50 border border-gray-200 rounded-md text-xs text-gray-700"
+      data-article-utilities
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex flex-wrap items-center gap-2">
+          <span className="font-semibold text-gray-800 uppercase tracking-wider">
+            Article Utilities:
+          </span>
+          <button
+            type="button"
+            onClick={handleCalculateStats}
+            className="px-2.5 py-1 bg-white border border-gray-300 rounded hover:bg-gray-100 font-medium transition"
+          >
+            Reading Stats
+          </button>
+          <button
+            type="button"
+            onClick={handleCopyCitation}
+            className="px-2.5 py-1 bg-white border border-gray-300 rounded hover:bg-gray-100 font-medium transition"
+          >
+            Copy Citation
+          </button>
+          <label className="inline-flex items-center gap-1 text-gray-600">
+            <span>WPM:</span>
+            <input
+              type="number"
+              min={50}
+              max={1000}
+              step={25}
+              value={readingSpeedWpm}
+              onChange={(e) => setReadingSpeedWpm(Number(e.target.value) || 200)}
+              className="w-16 px-1.5 py-0.5 bg-white border border-gray-300 rounded text-xs"
+            />
+          </label>
+        </div>
+
+        <form onSubmit={handleHighlight} className="flex items-center gap-1.5">
+          <input
+            type="text"
+            placeholder="Find & highlight in article..."
+            value={highlightTerm}
+            onChange={(e) => setHighlightTerm(e.target.value)}
+            className="px-2 py-1 bg-white border border-gray-300 rounded text-xs focus:ring-1 focus:ring-amber-400 focus:outline-none"
+          />
+          <button
+            type="submit"
+            className="px-2.5 py-1 bg-gray-800 text-white rounded hover:bg-gray-700 font-medium transition"
+          >
+            Highlight
+          </button>
+        </form>
+      </div>
+
+      {(statusMessage || statsSummary) && (
+        <div className="mt-2 pt-2 border-t border-gray-200 text-gray-600 flex items-center justify-between">
+          <span>{statusMessage}</span>
+          <button
+            type="button"
+            onClick={() => {
+              setStatusMessage(null);
+              setStatsSummary(null);
+            }}
+            className="text-gray-400 hover:text-gray-600"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
