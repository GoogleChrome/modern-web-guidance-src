+import type { ModelContextTool, ModelContextToolResult } from '../../global';
+
+export interface ArticleContextData {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  tags?: string[];
+  isBookmarked?: boolean;
+  relatedArticles?: {
+    slug: string;
+    title: string;
+    summary: string;
+    category: string;
+  }[];
+}
+
+function toToolResult(data: unknown): ModelContextToolResult & Record<string, any> {
+  const text = typeof data === 'string' ? data : JSON.stringify(data, null, 2);
+  const obj = typeof data === 'object' && data !== null ? data : { result: data };
+  return {
+    ...obj,
+    content: [{ type: 'text', text }],
+  };
+}
+
+function extractCurrentArticleFromDOM(fallback?: ArticleContextData | null) {
+  const articleEl = document.querySelector('article[data-article-slug], main article');
+  const headlineEl = articleEl?.querySelector('h1') || document.querySelector('article h1');
+  const bodyEl =
+    articleEl?.querySelector('[data-article-body]') ||
+    articleEl?.querySelector('.prose') ||
+    document.querySelector('article .prose');
+
+  const bodyText = bodyEl ? (bodyEl as HTMLElement).innerText.trim() : '';
+  const wordCount = bodyText ? bodyText.split(/\s+/).filter(Boolean).length : 0;
+  const estimatedMinutes = Math.max(1, Math.ceil(wordCount / 200));
+
+  const headings = bodyEl
+    ? Array.from(bodyEl.querySelectorAll('h1, h2, h3, h4')).map((h) => ({
+        level: h.tagName.toLowerCase(),
+        text: (h as HTMLElement).innerText.trim(),
+      }))
+    : [];
+
+  const slug =
+    articleEl?.getAttribute('data-article-slug') ||
+    fallback?.slug ||
+    window.location.pathname.split('/articles/')[1]?.replace(/\/$/, '') ||
+    '';
+
+  const title =
+    articleEl?.getAttribute('data-article-title') ||
+    fallback?.title ||
+    (headlineEl as HTMLElement | null)?.innerText?.trim() ||
+    document.title;
+
+  const summary =
+    articleEl?.getAttribute('data-article-summary') ||
+    fallback?.summary ||
+    '';
+
+  const author =
+    articleEl?.getAttribute('data-article-author') ||
+    fallback?.author ||
+    '';
+
+  const category =
+    articleEl?.getAttribute('data-article-category') ||
+    fallback?.category ||
+    '';
+
+  const date =
+    articleEl?.getAttribute('data-article-date') ||
+    fallback?.date ||
+    '';
+
+  const readingTimeAttr = articleEl?.getAttribute('data-article-reading-time');
+  const readingTime = readingTimeAttr
+    ? Number(readingTimeAttr)
+    : fallback?.readingTime ?? estimatedMinutes;
+
+  return {
+    isOnArticlePage: Boolean(slug && (articleEl || fallback)),
+    slug,
+    title,
+    summary,
+    author,
+    category,
+    date,
+    readingTimeMinutes: readingTime,
+    wordCount,
+    estimatedReadingTimeMinutes: estimatedMinutes,
+    headings,
+    content: bodyText,
+    url: window.location.href,
+    relatedArticles: fallback?.relatedArticles || [],
+  };
+}
+
+export function buildWebMCPTools(
+  baseUrl: string,
+  articleData?: ArticleContextData | null
+): ModelContextTool[] {
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const tools: ModelContextTool[] = [
+    {
+      name: 'get_articles',
+      description:
+        'List or filter articles from The DevTools Times by optional search query or category.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: {
+            type: 'string',
+            description: 'Optional keyword to match in article title or summary.',
+          },
+          category: {
+            type: 'string',
+            description: 'Optional category name to filter articles by (e.g., lifestyle, sports, science).',
+          },
+        },
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async (params: { query?: string; category?: string } = {}) => {
+        const res = await fetch(`${normalizedBase}api/articles.json`);
+        const articles: any[] = await res.json();
+        const q = (params.query || '').trim().toLowerCase();
+        const cat = (params.category || '').trim().toLowerCase();
+
+        const filtered = articles.filter((a) => {
+          const matchesQuery =
+            !q ||
+            a.title?.toLowerCase().includes(q) ||
+            a.summary?.toLowerCase().includes(q) ||
+            a.slug?.toLowerCase().includes(q);
+          const matchesCategory =
+            !cat || (a.category && a.category.toLowerCase() === cat);
+          return matchesQuery && matchesCategory;
+        });
+
+        return toToolResult({
+          count: filtered.length,
+          articles: filtered.map((a) => ({
+            ...a,
+            url: `${normalizedBase}articles/${a.slug}`,
+          })),
+        });
+      },
+    },
+    {
+      name: 'get_reading_list',
+      description:
+        "Retrieve the user's current reading list of bookmarked articles, including full article metadata.",
+      inputSchema: {
+        type: 'object',
+        properties: {},
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async () => {
+        const [readingListRes, articlesRes] = await Promise.all([
+          fetch(`${normalizedBase}api/reading-list.json`),
+          fetch(`${normalizedBase}api/articles.json`),
+        ]);
+        const readingListData = await readingListRes.json();
+        const allArticles: any[] = await articlesRes.json();
+        const slugs: string[] = readingListData.readingList || [];
+        const bookmarkedArticles = allArticles
+          .filter((a) => slugs.includes(a.slug))
+          .map((a) => ({
+            ...a,
+            url: `${normalizedBase}articles/${a.slug}`,
+          }));
+
+        return toToolResult({
+          count: bookmarkedArticles.length,
+          readingList: slugs,
+          articles: bookmarkedArticles,
+        });
+      },
+    },
+    {
+      name: 'toggle_article_bookmark',
+      description:
+        "Add, remove, or toggle an article in the user's reading list. Defaults to the currently viewed article if no slug is provided.",
+      inputSchema: {
+        type: 'object',
+        properties: {
+          slug: {
+            type: 'string',
+            description:
+              'Article slug to bookmark or unbookmark. Omit to target the current article on an article page.',
+          },
+          action: {
+            type: 'string',
+            enum: ['toggle', 'add', 'remove'],
+            description: "Operation to perform: 'toggle' (default), 'add', or 'remove'.",
+          },
+        },
+      },
+      execute: async (
+        params: { slug?: string; action?: 'toggle' | 'add' | 'remove' } = {}
+      ) => {
+        const current = extractCurrentArticleFromDOM(articleData);
+        const targetSlug = (params.slug || current.slug || '').trim();
+        const action = params.action || 'toggle';
+
+        if (!targetSlug) {
+          return toToolResult({
+            error:
+              'No article slug provided and not currently viewing an article page.',
+          });
+        }
+
+        const res = await fetch(`${normalizedBase}api/reading-list.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug: targetSlug, action }),
+        });
+        const data = await res.json();
+        const updatedList: string[] = data.readingList || [];
+        const isBookmarked = updatedList.includes(targetSlug);
+
+        window.dispatchEvent(
+          new CustomEvent('reading-list-updated', {
+            detail: { readingList: updatedList },
+          })
+        );
+
+        return toToolResult({
+          slug: targetSlug,
+          action,
+          bookmarked: isBookmarked,
+          readingList: updatedList,
+        });
+      },
+    },
+    {
+      name: 'get_current_article_details',
+      description:
+        'Extract metadata, full text content, headings, word count, and reading time for the currently open article.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          includeFullText: {
+            type: 'boolean',
+            description: 'Whether to include the full article body text (default: true).',
+          },
+        },
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async (params: { includeFullText?: boolean } = {}) => {
+        const details = extractCurrentArticleFromDOM(articleData);
+        if (!details.isOnArticlePage) {
+          return toToolResult({
+            isOnArticlePage: false,
+            message:
+              'Not currently on an individual article page. Use get_articles to list articles or navigate_to_article to open one.',
+            currentUrl: window.location.href,
+          });
+        }
+
+        const includeFullText = params.includeFullText !== false;
+        return toToolResult({
+          ...details,
+          content: includeFullText ? details.content : undefined,
+        });
+      },
+    },
+    {
+      name: 'calculate_article_reading_stats',
+      description:
+        'Calculate client-side reading statistics (word count, character count, paragraph count, and estimated reading time at a configurable words-per-minute speed) for the current article or provided text.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          wordsPerMinute: {
+            type: 'number',
+            description: 'Reading speed in words per minute (default: 200).',
+          },
+          text: {
+            type: 'string',
+            description:
+              'Optional text to analyze. If omitted, analyzes the current article body on the page.',
+          },
+        },
+      },
+      annotations: {
+        readOnlyHint: true,
+      },
+      execute: async (params: { wordsPerMinute?: number; text?: string } = {}) => {
+        const wpm =
+          params.wordsPerMinute && params.wordsPerMinute > 0
+            ? params.wordsPerMinute
+            : 200;
+        const details = extractCurrentArticleFromDOM(articleData);
+        const targetText = (params.text ?? details.content ?? '').trim();
+
+        const words = targetText ? targetText.split(/\s+/).filter(Boolean) : [];
+        const wordCount = words.length;
+        const characterCount = targetText.length;
+        const paragraphCount = targetText
+          ? targetText.split(/\n\s*\n/).filter(Boolean).length
+          : 0;
+        const estimatedMinutes = wordCount > 0 ? Math.max(1, Math.ceil(wordCount / wpm)) : 0;
+        const estimatedSeconds = Math.round((wordCount / wpm) * 60);
+
+        return toToolResult({
+          slug: details.slug || null,
+          title: details.title || null,
+          wordsPerMinute: wpm,
+          wordCount,
+          characterCount,
+          paragraphCount,
+          estimatedMinutes,
+          estimatedSeconds,
+        });
+      },
+    },
+    {
+      name: 'highlight_article_text',
+      description:
+        'Highlight or clear highlighted occurrences of a keyword or phrase inside the current article body and scroll to the first match.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          phrase: {
+            type: 'string',
+            description:
+              'The keyword or phrase to highlight in the article body. Pass an empty string to clear existing highlights.',
+          },
+        },
+        required: ['phrase'],
+      },
+      execute: async (params: { phrase: string }) => {
+        const bodyEl =
+          document.querySelector('article [data-article-body]') ||
+          document.querySelector('article .prose');
+
+        if (!bodyEl) {
+          return toToolResult({
+            highlightedCount: 0,
+            error: 'No article body found on the current page.',
+          });
+        }
+
+        // Remove existing highlights first
+        const existingMarks = bodyEl.querySelectorAll('mark[data-webmcp-highlight]');
+        existingMarks.forEach((mark) => {
+          const parent = mark.parentNode;
+          if (parent) {
+            parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
+            parent.normalize();
+          }
+        });
+
+        const phrase = (params?.phrase || '').trim();
+        if (!phrase) {
+          return toToolResult({
+            phrase: '',
+            highlightedCount: 0,
+            message: 'Cleared all article highlights.',
+          });
+        }
+
+        const walker = document.createTreeWalker(bodyEl, NodeFilter.SHOW_TEXT);
+        const textNodes: Text[] = [];
+        let currentNode = walker.nextNode();
+        while (currentNode) {
+          if (
+            currentNode.parentElement &&
+            !['SCRIPT', 'STYLE', 'MARK'].includes(currentNode.parentElement.tagName)
+          ) {
+            textNodes.push(currentNode as Text);
+          }
+          currentNode = walker.nextNode();
+        }
+
+        let matchCount = 0;
+        let firstMark: HTMLElement | null = null;
+        const escaped = phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+        const regex = new RegExp(`(${escaped})`, 'gi');
+
+        for (const node of textNodes) {
+          const value = node.nodeValue || '';
+          if (!regex.test(value)) continue;
+          regex.lastIndex = 0;
+
+          const fragment = document.createDocumentFragment();
+          let lastIdx = 0;
+          let match: RegExpExecArray | null;
+          while ((match = regex.exec(value)) !== null) {
+            if (match.index > lastIdx) {
+              fragment.appendChild(
+                document.createTextNode(value.slice(lastIdx, match.index))
+              );
+            }
+            const mark = document.createElement('mark');
+            mark.setAttribute('data-webmcp-highlight', 'true');
+            mark.className = 'bg-amber-200 text-gray-900 px-0.5 rounded';
+            mark.textContent = match[0];
+            if (!firstMark) firstMark = mark;
+            fragment.appendChild(mark);
+            matchCount++;
+            lastIdx = regex.lastIndex;
+          }
+          if (lastIdx < value.length) {
+            fragment.appendChild(document.createTextNode(value.slice(lastIdx)));
+          }
+          node.parentNode?.replaceChild(fragment, node);
+        }
+
+        if (firstMark) {
+          firstMark.scrollIntoView({ behavior: 'smooth', block: 'center' });
+        }
+
+        return toToolResult({
+          phrase,
+          highlightedCount: matchCount,
+        });
+      },
+    },
+    {
+      name: 'share_article',
+      description:
+        'Generate a shareable link or copy the current article URL and citation summary to the clipboard.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          platform: {
+            type: 'string',
+            enum: ['copy', 'x', 'facebook', 'email'],
+            description: "Target share channel: 'copy' (default), 'x', 'facebook', or 'email'.",
+          },
+        },
+      },
+      execute: async (params: { platform?: 'copy' | 'x' | 'facebook' | 'email' } = {}) => {
+        const details = extractCurrentArticleFromDOM(articleData);
+        const platform = params.platform || 'copy';
+        const shareUrl = details.url || window.location.href;
+        const shareTitle = details.title || document.title;
+        const citation = `${shareTitle} — The DevTools Times (${shareUrl})`;
+
+        let copiedToClipboard = false;
+        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
+          try {
+            await navigator.clipboard.writeText(citation);
+            copiedToClipboard = true;
+          } catch {
+            copiedToClipboard = false;
+          }
+        }
+
+        const shareTargets: Record<string, string> = {
+          copy: shareUrl,
+          x: `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(shareUrl)}`,
+          facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`,
+          email: `mailto:?subject=${encodeURIComponent(shareTitle)}&body=${encodeURIComponent(citation)}`,
+        };
+
+        return toToolResult({
+          platform,
+          title: shareTitle,
+          url: shareUrl,
+          citation,
+          shareActionUrl: shareTargets[platform] || shareUrl,
+          copiedToClipboard,
+        });
+      },
+    },
+    {
+      name: 'navigate_to_article',
+      description: 'Navigate the browser to a specific article page by its slug.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          slug: {
+            type: 'string',
+            description: "The slug of the article to open (e.g., 'coffee-alchemy', 'coastal-pulse').",
+          },
+        },
+        required: ['slug'],
+      },
+      execute: async (params: { slug: string }) => {
+        const slug = (params?.slug || '').trim().replace(/^\/+|\/+$/g, '');
+        if (!slug) {
+          return toToolResult({ error: 'Article slug is required.' });
+        }
+        const targetUrl = `${normalizedBase}articles/${slug}`;
+        window.location.assign(targetUrl);
+        return toToolResult({
+          navigatingTo: targetUrl,
+          slug,
+        });
+      },
+    },
+  ];
+
+  return tools;
+}
+
+const registeredToolNames = new Set<string>();
+
+export function registerWebMCPTools(
+  baseUrl: string,
+  articleData?: ArticleContextData | null
+): () => void {
+  if (typeof window === 'undefined' || typeof navigator === 'undefined') {
+    return () => {};
+  }
+
+  const modelContext = navigator.modelContext;
+  if (!modelContext) {
+    return () => {};
+  }
+
+  const tools = buildWebMCPTools(baseUrl, articleData);
+
+  if (typeof modelContext.registerTool === 'function') {
+    for (const tool of tools) {
+      try {
+        if (
+          registeredToolNames.has(tool.name) &&
+          typeof modelContext.unregisterTool === 'function'
+        ) {
+          modelContext.unregisterTool(tool.name);
+        }
+        modelContext.registerTool(tool);
+        registeredToolNames.add(tool.name);
+      } catch (err) {
+        console.warn(`Failed to register WebMCP tool "${tool.name}":`, err);
+      }
+    }
+  } else if (typeof modelContext.provideContext === 'function') {
+    try {
+      modelContext.provideContext({ tools });
+      tools.forEach((t) => registeredToolNames.add(t.name));
+    } catch (err) {
+      console.warn('Failed to provide WebMCP context:', err);
+    }
+  }
+
+  return () => {
+    if (typeof modelContext.unregisterTool === 'function') {
+      for (const tool of tools) {
+        try {
+          modelContext.unregisterTool(tool.name);
+          registeredToolNames.delete(tool.name);
+        } catch {
+          // Ignore errors during cleanup
+        }
+      }
+    }
+  };
+}
