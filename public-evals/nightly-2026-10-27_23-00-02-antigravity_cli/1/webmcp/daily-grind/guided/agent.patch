+  <script>
+    (() => {
+      const DRINK_SIZES = ["Small", "Medium", "Large"];
+      const MILK_OPTIONS = ["Oat", "Whole", "Almond", "None"];
+      const SIZE_UPCHARGE = { Small: -0.5, Medium: 0, Large: 0.75 };
+
+      const orderCart = [];
+
+      function getSeasonalMenuFromDOM() {
+        const cards = Array.from(document.querySelectorAll("#menu-grid .card"));
+        return cards.map((card) => ({
+          id: card.dataset.drinkId || "",
+          name: card.dataset.name || card.querySelector("h3")?.textContent?.trim() || "",
+          category: card.dataset.category || "seasonal",
+          description: card.querySelector("p:not(.price)")?.textContent?.trim() || "",
+          price: Number.parseFloat(card.dataset.price || "0"),
+          calories: Number.parseInt(card.dataset.calories || "0", 10),
+          detailsUrl: card.querySelector("a.btn")?.getAttribute("href") || "",
+          highlighted: card.classList.contains("highlighted"),
+        }));
+      }
+
+      function highlightDrinkOnPage(drinkNameOrId) {
+        const cards = Array.from(document.querySelectorAll("#menu-grid .card"));
+        const target = String(drinkNameOrId || "").trim().toLowerCase();
+        let matchedCard = null;
+
+        for (const card of cards) {
+          const name = (card.dataset.name || "").toLowerCase();
+          const id = (card.dataset.drinkId || "").toLowerCase();
+          const isMatch = Boolean(target) && (name === target || id === target || name.includes(target));
+          card.classList.toggle("highlighted", isMatch);
+          if (isMatch && !matchedCard) {
+            matchedCard = card;
+          }
+        }
+
+        if (matchedCard) {
+          const statusEl = document.getElementById("order-status");
+          if (statusEl) {
+            statusEl.textContent = `Highlighted "${matchedCard.dataset.name}" on the Seasonal Favorites menu.`;
+          }
+        }
+        return matchedCard;
+      }
+
+      function renderCartUI(statusMessage) {
+        const listEl = document.getElementById("cart-list");
+        const countEl = document.getElementById("cart-count");
+        const totalEl = document.getElementById("cart-total");
+        const statusEl = document.getElementById("order-status");
+
+        const totalQuantity = orderCart.reduce((sum, item) => sum + item.quantity, 0);
+        const totalPrice = orderCart.reduce((sum, item) => sum + item.lineTotal, 0);
+
+        if (countEl) countEl.textContent = String(totalQuantity);
+        if (totalEl) totalEl.textContent = totalPrice.toFixed(2);
+
+        if (listEl) {
+          listEl.replaceChildren();
+          if (orderCart.length === 0) {
+            const emptyLi = document.createElement("li");
+            emptyLi.id = "empty-cart-msg";
+            emptyLi.textContent = "No drinks ordered yet.";
+            listEl.appendChild(emptyLi);
+          } else {
+            for (const item of orderCart) {
+              const li = document.createElement("li");
+              const labelSpan = document.createElement("span");
+              labelSpan.textContent = `${item.quantity}x ${item.size} ${item.drink} (${item.milk} milk)`;
+              const priceSpan = document.createElement("span");
+              priceSpan.textContent = `$${item.lineTotal.toFixed(2)}`;
+              li.append(labelSpan, priceSpan);
+              listEl.appendChild(li);
+            }
+          }
+        }
+
+        if (statusEl && statusMessage) {
+          statusEl.textContent = statusMessage;
+        }
+      }
+
+      function addDrinkOrder({ drink, size = "Medium", milk = "Oat", quantity = 1 }) {
+        const menu = getSeasonalMenuFromDOM();
+        const normalizedDrink = String(drink || "").trim().toLowerCase();
+        const menuItem = menu.find(
+          (item) =>
+            item.name.toLowerCase() === normalizedDrink ||
+            item.id.toLowerCase() === normalizedDrink
+        );
+
+        if (!menuItem) {
+          return {
+            error: `Drink "${drink}" is not on the Seasonal Favorites menu.`,
+            availableDrinks: menu.map((item) => item.name),
+          };
+        }
+
+        if (!DRINK_SIZES.includes(size)) {
+          return {
+            error: `Unsupported cup size "${size}".`,
+            supportedSizes: DRINK_SIZES,
+          };
+        }
+
+        if (!MILK_OPTIONS.includes(milk)) {
+          return {
+            error: `Unsupported milk option "${milk}".`,
+            supportedMilkOptions: MILK_OPTIONS,
+          };
+        }
+
+        const parsedQty = Number(quantity);
+        if (!Number.isInteger(parsedQty) || parsedQty < 1 || parsedQty > 10) {
+          return {
+            error: "Quantity must be a whole number between 1 and 10.",
+          };
+        }
+
+        const unitPrice = Number((menuItem.price + (SIZE_UPCHARGE[size] || 0)).toFixed(2));
+        const lineTotal = Number((unitPrice * parsedQty).toFixed(2));
+
+        const orderEntry = {
+          id: menuItem.id,
+          drink: menuItem.name,
+          size,
+          milk,
+          quantity: parsedQty,
+          unitPrice,
+          lineTotal,
+        };
+
+        orderCart.push(orderEntry);
+
+        // Sync form controls and UI highlight before returning
+        const form = document.getElementById("quick-order-form");
+        if (form) {
+          form.elements.namedItem("drink").value = menuItem.name;
+          form.elements.namedItem("size").value = size;
+          form.elements.namedItem("milk").value = milk;
+          form.elements.namedItem("quantity").value = String(parsedQty);
+        }
+
+        highlightDrinkOnPage(menuItem.name);
+        const statusMsg = `Added ${parsedQty}x ${size} ${menuItem.name} (${milk} milk) to your order.`;
+        renderCartUI(statusMsg);
+
+        return {
+          status: "ordered",
+          message: statusMsg,
+          addedItem: orderEntry,
+          cartSummary: {
+            totalItems: orderCart.reduce((sum, item) => sum + item.quantity, 0),
+            totalPrice: Number(orderCart.reduce((sum, item) => sum + item.lineTotal, 0).toFixed(2)),
+            items: [...orderCart],
+          },
+        };
+      }
+
+      // Handle Declarative WebMCP Form submissions & user form submissions
+      const orderForm = document.getElementById("quick-order-form");
+      if (orderForm) {
+        orderForm.addEventListener("submit", (event) => {
+          event.preventDefault();
+          const formData = new FormData(orderForm);
+          const result = addDrinkOrder({
+            drink: formData.get("drink"),
+            size: formData.get("size") || "Medium",
+            milk: formData.get("milk") || "Oat",
+            quantity: Number(formData.get("quantity") || 1),
+          });
+
+          if (event.agentInvoked && typeof event.respondWith === "function") {
+            if (result.error) {
+              event.respondWith(Promise.resolve(`Validation failed: ${result.error}`));
+            } else {
+              event.respondWith(Promise.resolve(result));
+            }
+          }
+        });
+      }
+
+      // Register Imperative WebMCP tools with feature detection and AbortSignal cleanup
+      if ("modelContext" in document && document.modelContext) {
+        const toolRegistrationController = new AbortController();
+        const { signal } = toolRegistrationController;
+
+        window.addEventListener("pagehide", () => {
+          toolRegistrationController.abort();
+        });
+
+        // 1. Read-only tool to query the Seasonal Favorites coffee menu
+        document.modelContext.registerTool(
+          {
+            name: "query_seasonal_favorites_menu",
+            description:
+              "Queries the Seasonal Favorites coffee menu on the Daily Grind homepage. Use when the user asks about available drinks, flavors, prices, calories, or dietary options.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                query: {
+                  type: "string",
+                  description: "Keyword to match against drink name or description.",
+                },
+                category: {
+                  type: "string",
+                  enum: ["all", "seasonal", "espresso", "cold-brew"],
+                  default: "all",
+                  description: "Menu category to filter by.",
+                },
+                maxPrice: {
+                  type: "number",
+                  minimum: 0,
+                  description: "Maximum base price in USD.",
+                },
+              },
+            },
+            execute(input = {}) {
+              const { query = "", category = "all", maxPrice } = input || {};
+              const validCategories = ["all", "seasonal", "espresso", "cold-brew"];
+              if (category && !validCategories.includes(category)) {
+                return {
+                  error: `Invalid category "${category}".`,
+                  supportedCategories: validCategories,
+                };
+              }
+              if (maxPrice !== undefined && (typeof maxPrice !== "number" || Number.isNaN(maxPrice) || maxPrice < 0)) {
+                return {
+                  error: "maxPrice must be a non-negative number.",
+                };
+              }
+
+              const allItems = getSeasonalMenuFromDOM();
+              const normalizedQuery = String(query || "").trim().toLowerCase();
+
+              const matches = allItems.filter((item) => {
+                const matchesCategory = category === "all" || item.category === category;
+                const matchesQuery =
+                  !normalizedQuery ||
+                  item.name.toLowerCase().includes(normalizedQuery) ||
+                  item.description.toLowerCase().includes(normalizedQuery);
+                const matchesPrice = maxPrice === undefined || item.price <= maxPrice;
+                return matchesCategory && matchesQuery && matchesPrice;
+              });
+
+              return {
+                menuSection: "Seasonal Favorites",
+                totalMatches: matches.length,
+                drinks: matches,
+                customizationOptions: {
+                  sizes: DRINK_SIZES,
+                  milkOptions: MILK_OPTIONS,
+                },
+              };
+            },
+            annotations: {
+              readOnlyHint: true,
+            },
+          },
+          { signal }
+        );
+
+        // 2. Interactive drink order tool (imperative counterpart that updates cart and UI)
+        document.modelContext.registerTool(
+          {
+            name: "place_drink_order",
+            description:
+              "Places an interactive drink order from the Seasonal Favorites menu and updates the live order summary and UI on the page.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                drink: {
+                  type: "string",
+                  enum: ["Maple Oat Latte", "Dark Roast Espresso", "Cold Brew"],
+                  description: "Name of the Seasonal Favorites coffee drink to order.",
+                },
+                size: {
+                  type: "string",
+                  enum: DRINK_SIZES,
+                  default: "Medium",
+                  description: "Cup size for the drink.",
+                },
+                milk: {
+                  type: "string",
+                  enum: MILK_OPTIONS,
+                  default: "Oat",
+                  description: "Milk or dairy-free choice.",
+                },
+                quantity: {
+                  type: "integer",
+                  minimum: 1,
+                  maximum: 10,
+                  default: 1,
+                  description: "Number of cups to order.",
+                },
+              },
+              required: ["drink"],
+            },
+            execute(input = {}) {
+              const { drink, size = "Medium", milk = "Oat", quantity = 1 } = input || {};
+              return addDrinkOrder({ drink, size, milk, quantity });
+            },
+            annotations: {
+              readOnlyHint: false,
+            },
+          },
+          { signal }
+        );
+
+        // 3. UI update tool to highlight a featured drink card or clear the current order on the page
+        document.modelContext.registerTool(
+          {
+            name: "update_seasonal_menu_ui",
+            description:
+              "Triggers interactive UI updates on the Daily Grind homepage, such as highlighting a recommended drink card in Seasonal Favorites or clearing the active drink order.",
+            inputSchema: {
+              type: "object",
+              properties: {
+                action: {
+                  type: "string",
+                  enum: ["highlight_drink", "clear_highlights", "clear_order"],
+                  description: "The UI update action to perform on the page.",
+                },
+                drink: {
+                  type: "string",
+                  description: "Drink name or ID to highlight when action is highlight_drink.",
+                },
+              },
+              required: ["action"],
+            },
+            execute(input = {}) {
+              const { action, drink } = input || {};
+              if (action === "highlight_drink") {
+                if (!drink || typeof drink !== "string") {
+                  return {
+                    error: "Provide a drink name to highlight on the Seasonal Favorites menu.",
+                    availableDrinks: getSeasonalMenuFromDOM().map((d) => d.name),
+                  };
+                }
+                const matched = highlightDrinkOnPage(drink);
+                if (!matched) {
+                  return {
+                    error: `Drink "${drink}" was not found on the Seasonal Favorites menu.`,
+                    availableDrinks: getSeasonalMenuFromDOM().map((d) => d.name),
+                  };
+                }
+                return {
+                  status: "highlighted",
+                  highlightedDrink: matched.dataset.name,
+                };
+              }
+
+              if (action === "clear_highlights") {
+                highlightDrinkOnPage("");
+                const statusEl = document.getElementById("order-status");
+                if (statusEl) {
+                  statusEl.textContent = "Cleared drink highlights.";
+                }
+                return { status: "highlights_cleared" };
+              }
+
+              if (action === "clear_order") {
+                orderCart.length = 0;
+                highlightDrinkOnPage("");
+                renderCartUI("Order cleared. Ready to take your coffee order.");
+                return {
+                  status: "order_cleared",
+                  totalItems: 0,
+                  totalPrice: 0,
+                };
+              }
+
+              return {
+                error: `Unsupported UI action "${action}".`,
+                supportedActions: ["highlight_drink", "clear_highlights", "clear_order"],
+              };
+            },
+            annotations: {
+              readOnlyHint: false,
+            },
+          },
+          { signal }
+        );
+
+        // Listen for WebMCP tool lifecycle events with Chrome <156 window fallback
+        const targetFor = (type, listener, options) =>
+          (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+            .addEventListener(type, listener, options);
+
+        targetFor("toolactivated", ({ toolName }) => {
+          const statusEl = document.getElementById("order-status");
+          if (statusEl) {
+            statusEl.textContent = `AI agent is running "${toolName}"…`;
+          }
+        });
+
+        targetFor("toolcancel", ({ toolName }) => {
+          const statusEl = document.getElementById("order-status");
+          if (statusEl) {
+            statusEl.textContent = `AI agent cancelled "${toolName}".`;
+          }
+        });
+      }
+    })();
+  </script>
