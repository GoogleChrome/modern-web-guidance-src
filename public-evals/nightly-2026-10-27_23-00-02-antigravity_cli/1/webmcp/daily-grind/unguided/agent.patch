+  <script>
+    (function () {
+      const SEASONAL_MENU = [
+        {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          price: 5.50,
+          calories: 210,
+          category: 'seasonal',
+          defaultMilk: 'Oat Milk',
+          availableSizes: ['Small', 'Medium', 'Large'],
+          tags: ['sweet', 'oat-milk', 'latte', 'hot', 'iced', 'vegan']
+        },
+        {
+          id: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          price: 3.75,
+          calories: 15,
+          category: 'espresso',
+          defaultMilk: 'None',
+          availableSizes: ['Small', 'Medium', 'Large'],
+          tags: ['bold', 'smokey', 'espresso', 'hot', 'strong', 'vegan']
+        },
+        {
+          id: 'cold-brew',
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          price: 4.50,
+          calories: 5,
+          category: 'cold-brew',
+          defaultMilk: 'None',
+          availableSizes: ['Small', 'Medium', 'Large'],
+          tags: ['smooth', 'cold', 'iced', 'cold-brew', 'refreshing', 'vegan']
+        }
+      ];
+
+      const orders = [];
+
+      function findDrink(query) {
+        if (!query) return null;
+        const normalized = String(query).trim().toLowerCase();
+        return (
+          SEASONAL_MENU.find(
+            (item) =>
+              item.id.toLowerCase() === normalized ||
+              item.name.toLowerCase() === normalized
+          ) ||
+          SEASONAL_MENU.find(
+            (item) =>
+              item.name.toLowerCase().includes(normalized) ||
+              item.id.toLowerCase().includes(normalized) ||
+              item.category.toLowerCase().includes(normalized)
+          ) ||
+          null
+        );
+      }
+
+      function renderOrderSummary(latestMessage) {
+        const listEl = document.getElementById('cart-items');
+        const countEl = document.getElementById('cart-count');
+        const totalEl = document.getElementById('cart-total');
+        const bannerEl = document.getElementById('order-status-banner');
+
+        const totalCount = orders.reduce((sum, item) => sum + item.quantity, 0);
+        const totalPrice = orders.reduce((sum, item) => sum + item.itemTotal, 0);
+
+        if (countEl) countEl.textContent = String(totalCount);
+        if (totalEl) totalEl.textContent = `$${totalPrice.toFixed(2)}`;
+
+        if (listEl) {
+          listEl.innerHTML = '';
+          if (orders.length === 0) {
+            const emptyLi = document.createElement('li');
+            emptyLi.style.color = '#777';
+            emptyLi.style.borderBottom = 'none';
+            emptyLi.textContent = 'No drinks ordered yet.';
+            listEl.appendChild(emptyLi);
+          } else {
+            orders.forEach((order) => {
+              const li = document.createElement('li');
+              const details = `${order.quantity}x ${order.size} ${order.drink}${order.milk && order.milk !== 'None' ? ' (' + order.milk + ')' : ''}${order.customerName ? ' — ' + order.customerName : ''}`;
+              const spanName = document.createElement('span');
+              spanName.textContent = details;
+              const spanPrice = document.createElement('span');
+              spanPrice.textContent = `$${order.itemTotal.toFixed(2)}`;
+              li.appendChild(spanName);
+              li.appendChild(spanPrice);
+              listEl.appendChild(li);
+            });
+          }
+        }
+
+        if (bannerEl && latestMessage) {
+          bannerEl.textContent = latestMessage;
+          bannerEl.classList.add('active');
+        } else if (bannerEl && orders.length === 0 && !latestMessage) {
+          bannerEl.textContent = '';
+          bannerEl.classList.remove('active');
+        }
+      }
+
+      function highlightCard(drinkIdOrName, scroll = true) {
+        const matched = findDrink(drinkIdOrName);
+        const cards = document.querySelectorAll('#menu-grid .card');
+        let highlightedElement = null;
+
+        cards.forEach((card) => {
+          const cardId = card.getAttribute('data-drink-id');
+          if (matched && cardId === matched.id) {
+            card.classList.add('highlighted');
+            highlightedElement = card;
+          } else {
+            card.classList.remove('highlighted');
+          }
+        });
+
+        if (highlightedElement && scroll && typeof highlightedElement.scrollIntoView === 'function') {
+          highlightedElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
+        }
+        return matched;
+      }
+
+      function placeOrder({ drink, size = 'Medium', milk, quantity = 1, customerName = '' }) {
+        const matched = findDrink(drink);
+        if (!matched) {
+          throw new Error(`Drink "${drink}" not found in Seasonal Favorites menu. Available drinks: ${SEASONAL_MENU.map((d) => d.name).join(', ')}.`);
+        }
+
+        const normalizedQty = Math.max(1, parseInt(quantity, 10) || 1);
+        const normalizedSize = ['Small', 'Medium', 'Large'].includes(size) ? size : 'Medium';
+        const resolvedMilk = milk || matched.defaultMilk || 'None';
+        const sizeUpcharge = normalizedSize === 'Large' ? 0.75 : 0;
+        const unitPrice = matched.price + sizeUpcharge;
+        const itemTotal = Number((unitPrice * normalizedQty).toFixed(2));
+
+        const orderRecord = {
+          orderId: `ORD-${Date.now()}-${orders.length + 1}`,
+          drinkId: matched.id,
+          drink: matched.name,
+          size: normalizedSize,
+          milk: resolvedMilk,
+          quantity: normalizedQty,
+          unitPrice,
+          itemTotal,
+          customerName: customerName ? String(customerName).trim() : ''
+        };
+
+        orders.push(orderRecord);
+
+        // Sync form inputs in the UI
+        const drinkSelect = document.getElementById('order-drink');
+        const sizeSelect = document.getElementById('order-size');
+        const milkSelect = document.getElementById('order-milk');
+        const qtyInput = document.getElementById('order-quantity');
+        const customerInput = document.getElementById('order-customer');
+
+        if (drinkSelect) drinkSelect.value = matched.name;
+        if (sizeSelect) sizeSelect.value = normalizedSize;
+        if (milkSelect) milkSelect.value = resolvedMilk;
+        if (qtyInput) qtyInput.value = String(normalizedQty);
+        if (customerInput && customerName !== undefined) customerInput.value = orderRecord.customerName;
+
+        highlightCard(matched.id, false);
+        const statusMsg = `Order confirmed: ${normalizedQty}x ${normalizedSize} ${matched.name} ($${itemTotal.toFixed(2)})`;
+        renderOrderSummary(statusMsg);
+
+        return {
+          status: 'confirmed',
+          message: statusMsg,
+          order: orderRecord,
+          cartTotalItems: orders.reduce((s, o) => s + o.quantity, 0),
+          cartTotalPrice: Number(orders.reduce((s, o) => s + o.itemTotal, 0).toFixed(2))
+        };
+      }
+
+      // Form submission handler
+      const orderForm = document.getElementById('drink-order-form');
+      if (orderForm) {
+        orderForm.addEventListener('submit', function (event) {
+          event.preventDefault();
+          const formData = new FormData(orderForm);
+          placeOrder({
+            drink: formData.get('drink'),
+            size: formData.get('size'),
+            milk: formData.get('milk'),
+            quantity: Number(formData.get('quantity') || 1),
+            customerName: formData.get('customerName') || ''
+          });
+        });
+      }
+
+      window.dailyGrindApp = {
+        getMenu: () => SEASONAL_MENU.map((item) => ({ ...item })),
+        getOrders: () => orders.map((o) => ({ ...o })),
+        quickOrder: (drinkName) => placeOrder({ drink: drinkName, size: 'Medium', quantity: 1 }),
+        placeOrder,
+        highlightCard
+      };
+
+      // Define WebMCP client-side tools
+      const webMcpTools = [
+        {
+          name: 'get_seasonal_favorites_menu',
+          description: 'Query the "Seasonal Favorites" coffee menu on The Daily Grind homepage. Optionally filter by search query, category, or maximum price.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              search: {
+                type: 'string',
+                description: 'Optional keyword to filter drinks by name, description, or tag (e.g., "maple", "espresso", "cold", "oat").'
+              },
+              category: {
+                type: 'string',
+                enum: ['all', 'seasonal', 'espresso', 'cold-brew'],
+                description: 'Optional category filter.'
+              },
+              maxPrice: {
+                type: 'number',
+                description: 'Optional maximum price filter in USD.'
+              }
+            }
+          },
+          annotations: {
+            readOnlyHint: true
+          },
+          execute: async (params = {}) => {
+            const { search, category, maxPrice } = params || {};
+            let results = SEASONAL_MENU.map((item) => ({ ...item }));
+
+            if (category && category !== 'all') {
+              results = results.filter((item) => item.category === category);
+            }
+            if (typeof maxPrice === 'number' && !Number.isNaN(maxPrice)) {
+              results = results.filter((item) => item.price <= maxPrice);
+            }
+            if (search && String(search).trim() !== '') {
+              const q = String(search).trim().toLowerCase();
+              results = results.filter(
+                (item) =>
+                  item.name.toLowerCase().includes(q) ||
+                  item.description.toLowerCase().includes(q) ||
+                  item.category.toLowerCase().includes(q) ||
+                  item.tags.some((t) => t.toLowerCase().includes(q))
+              );
+            }
+
+            const payload = {
+              section: 'Seasonal Favorites',
+              count: results.length,
+              items: results
+            };
+
+            return {
+              content: [{ type: 'text', text: JSON.stringify(payload, null, 2) }],
+              ...payload
+            };
+          }
+        },
+        {
+          name: 'order_seasonal_drink',
+          description: 'Trigger an interactive drink order from the "Seasonal Favorites" menu and update the order cart and UI on the page.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drink: {
+                type: 'string',
+                description: 'Name or ID of the drink to order (e.g., "Maple Oat Latte", "Dark Roast Espresso", "Cold Brew").'
+              },
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large'],
+                description: 'Cup size (Small, Medium, or Large). Defaults to Medium.'
+              },
+              milk: {
+                type: 'string',
+                enum: ['Oat Milk', 'Whole Milk', 'Almond Milk', 'None'],
+                description: 'Milk choice for the drink.'
+              },
+              quantity: {
+                type: 'number',
+                description: 'Number of drinks to order (defaults to 1).'
+              },
+              customerName: {
+                type: 'string',
+                description: 'Optional customer name or special instructions.'
+              }
+            },
+            required: ['drink']
+          },
+          annotations: {
+            readOnlyHint: false
+          },
+          execute: async (params = {}) => {
+            const result = placeOrder(params);
+            return {
+              content: [{ type: 'text', text: JSON.stringify(result, null, 2) }],
+              ...result
+            };
+          }
+        },
+        {
+          name: 'update_menu_ui',
+          description: 'Trigger interactive UI updates on the Daily Grind homepage, such as highlighting a specific Seasonal Favorites drink card, filtering visible menu cards, updating the status banner, or clearing the current order.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              action: {
+                type: 'string',
+                enum: ['highlight_drink', 'filter_cards', 'set_banner', 'clear_orders', 'reset_ui'],
+                description: 'The UI update action to perform on the page.'
+              },
+              drink: {
+                type: 'string',
+                description: 'Drink name or ID to highlight when action is "highlight_drink", or filter keyword when action is "filter_cards".'
+              },
+              message: {
+                type: 'string',
+                description: 'Custom message to display in the status banner when action is "set_banner".'
+              }
+            },
+            required: ['action']
+          },
+          annotations: {
+            readOnlyHint: false
+          },
+          execute: async (params = {}) => {
+            const { action, drink, message } = params || {};
+            let summary = '';
+
+            if (action === 'highlight_drink') {
+              const matched = highlightCard(drink, true);
+              if (!matched) {
+                throw new Error(`Could not find drink matching "${drink}" to highlight.`);
+              }
+              summary = `Highlighted "${matched.name}" on the Seasonal Favorites menu.`;
+            } else if (action === 'filter_cards') {
+              const q = (drink || '').trim().toLowerCase();
+              const cards = document.querySelectorAll('#menu-grid .card');
+              let visibleCount = 0;
