+                if (show) visibleCount++;
+              });
+              summary = `Filtered menu cards by "${q || 'all'}" (${visibleCount} visible).`;
+            } else if (action === 'set_banner') {
+              renderOrderSummary(message || 'Welcome to The Daily Grind!');
+              summary = `Updated status banner to: "${message || 'Welcome to The Daily Grind!'}"`;
+            } else if (action === 'clear_orders') {
+              orders.length = 0;
+              highlightCard(null, false);
+              renderOrderSummary('Order cart cleared.');
+              summary = 'Cleared all items from the current order.';
+            } else if (action === 'reset_ui') {
+              const cards = document.querySelectorAll('#menu-grid .card');
+              cards.forEach((card) => {
+                card.style.display = '';
+                card.classList.remove('highlighted');
+              });
+              renderOrderSummary('');
+              summary = 'Reset menu cards and UI state.';
+            } else {
+              throw new Error(`Unsupported UI action: ${action}`);
+            }
+
+            const responseData = {
+              success: true,
+              action,
+              message: summary
+            };
+
+            return {
+              content: [{ type: 'text', text: JSON.stringify(responseData, null, 2) }],
+              ...responseData
+            };
+          }
+        }
+      ];
+
+      // Register tools via WebMCP API (navigator.modelContext) with safe fallback shim
+      function initWebMCP() {
+        const registeredToolsMap = new Map();
+
+        if (!('modelContext' in navigator) || !navigator.modelContext) {
+          navigator.modelContext = {
+            registerTool(toolDef, handlerFn) {
+              const normalized = typeof handlerFn === 'function'
+                ? { ...toolDef, execute: handlerFn }
+                : toolDef;
+              registeredToolsMap.set(normalized.name, normalized);
+              return normalized;
+            },
+            unregisterTool(name) {
+              registeredToolsMap.delete(name);
+            },
+            provideContext(contextObj) {
+              registeredToolsMap.clear();
+              if (contextObj && Array.isArray(contextObj.tools)) {
+                contextObj.tools.forEach((t) => registeredToolsMap.set(t.name, t));
+              }
+            },
+            clearContext() {
+              registeredToolsMap.clear();
+            },
+            getTools() {
+              return Array.from(registeredToolsMap.values());
+            }
+          };
+        }
+
+        const mc = navigator.modelContext;
+
+        if (typeof mc.registerTool === 'function') {
+          webMcpTools.forEach((tool) => {
+            mc.registerTool(tool);
+          });
+        } else if (typeof mc.provideContext === 'function') {
+          mc.provideContext({ tools: webMcpTools });
+        }
+      }
+
+      initWebMCP();
+    })();
+  </script>
