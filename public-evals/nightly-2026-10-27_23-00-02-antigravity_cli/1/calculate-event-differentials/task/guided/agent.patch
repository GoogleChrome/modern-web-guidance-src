+  <script type="module">
+    function initializePromoTimer() {
+      const countdownEl = document.getElementById('maple-countdown');
+      const elapsedEl = document.getElementById('maple-elapsed');
+      if (!countdownEl || !elapsedEl) return;
+
+      // Get the current time in the user's local system time zone
+      const now = Temporal.Now.zonedDateTimeISO();
+      const tz = now.timeZoneId;
+
+      // Combine separate date and time strings via Temporal Plain types and bind to the user's local time zone
+      const startDateStr = '2026-01-01';
+      const startTimeStr = '00:00:00';
+      const endDateStr = '2026-03-01';
+      const endTimeStr = '00:00:00';
+
+      const start = Temporal.PlainDate.from(startDateStr).toPlainDateTime(startTimeStr).toZonedDateTime(tz);
+      const end = Temporal.PlainDate.from(endDateStr).toPlainDateTime(endTimeStr).toZonedDateTime(tz);
+
+      // Calculate elapsed time since the start of the promotion and time remaining until the offer ends
+      const timeElapsed = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      // Format durations using Intl.DurationFormat via .toLocaleString()
+      const isExpired = timeRemaining.sign < 0;
+      if (isExpired) {
+        countdownEl.textContent = `Offer ended (${timeRemaining.abs().toLocaleString( undefined, { style: 'long' } )} ago)`;
+        countdownEl.setAttribute('datetime', timeRemaining.abs().toString());
+      } else {
+        countdownEl.textContent = timeRemaining.toLocaleString(undefined, { style: 'long' });
+        countdownEl.setAttribute('datetime', timeRemaining.toString());
+      }
+
+      if (timeElapsed.sign < 0) {
+        elapsedEl.textContent = '0 hours';
+        elapsedEl.setAttribute('datetime', 'PT0H');
+      } else {
+        elapsedEl.textContent = timeElapsed.toLocaleString(undefined, { style: 'long' });
+        elapsedEl.setAttribute('datetime', timeElapsed.toString());
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializePromoTimer();
+    })();
+  </script>
