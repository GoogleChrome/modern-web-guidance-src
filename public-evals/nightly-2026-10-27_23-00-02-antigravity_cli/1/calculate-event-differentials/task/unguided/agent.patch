+  <script>
+    function updateMapleOatTimer() {
+      const countdownEl = document.getElementById('maple-oat-countdown');
+      const elapsedEl = document.getElementById('maple-oat-elapsed');
+      if (!countdownEl || !elapsedEl) return;
+
+      const timeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(timeZone);
+
+      const promoStart = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 1,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone
+      });
+
+      const promoEnd = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 3,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone
+      });
+
+      const remaining = now.until(promoEnd, {
+        largestUnit: 'days',
+        smallestUnit: 'hours',
+        roundingMode: 'trunc'
+      });
+
+      const elapsed = now.since(promoStart, {
+        largestUnit: 'days',
+        smallestUnit: 'hours',
+        roundingMode: 'trunc'
+      });
+
+      if (Temporal.ZonedDateTime.compare(now, promoEnd) >= 0) {
+        countdownEl.innerHTML = '<strong>Offer status:</strong> Ended (0 days, 0 hours remaining)';
+      } else {
+        countdownEl.innerHTML = `<strong>Ends in:</strong> ${remaining.days} days, ${remaining.hours} hours`;
+      }
+
+      elapsedEl.innerHTML = `<strong>Time elapsed:</strong> ${elapsed.days} days, ${elapsed.hours} hours since promotion start`;
+    }
+
+    document.addEventListener('DOMContentLoaded', updateMapleOatTimer);
+  </script>
+
