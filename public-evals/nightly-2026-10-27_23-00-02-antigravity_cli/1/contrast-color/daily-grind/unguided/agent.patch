+  <script>
+    (function () {
+      function parseColor(colorStr) {
+        if (!colorStr) return null;
+        const ctx = document.createElement('canvas').getContext('2d');
+        if (!ctx) return null;
+        ctx.fillStyle = colorStr.trim();
+        const computed = ctx.fillStyle;
+        if (computed.startsWith('#')) {
+          let hex = computed.slice(1);
+          if (hex.length === 3) {
+            hex = hex.split('').map(c => c + c).join('');
+          }
+          const num = parseInt(hex, 16);
+          return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
+        }
+        const match = computed.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
+        if (match) {
+          return [parseInt(match[1], 10), parseInt(match[2], 10), parseInt(match[3], 10)];
+        }
+        return null;
+      }
+
+      function getLuminance([r, g, b]) {
+        const a = [r, g, b].map(v => {
+          v /= 255;
+          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
+        });
+        return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722;
+      }
+
+      function getContrastTextColor(bgColorStr) {
+        const rgb = parseColor(bgColorStr);
+        if (!rgb) return null;
+        const lum = getLuminance(rgb);
+        return lum > 0.179 ? 'rgb(0, 0, 0)' : 'rgb(255, 255, 255)';
+      }
+
+      function updateContrastColors() {
+        const nav = document.querySelector('nav');
+        const footer = document.querySelector('footer');
+        const buttons = document.querySelectorAll('.btn');
+
+        if (nav) {
+          const navStyle = getComputedStyle(nav);
+          const expected = getContrastTextColor(navStyle.backgroundColor);
+          if (expected && navStyle.color !== expected) {
+            nav.style.color = expected;
+          }
+        }
+
+        if (footer) {
+          const footerStyle = getComputedStyle(footer);
+          const expected = getContrastTextColor(footerStyle.backgroundColor);
+          if (expected && footerStyle.color !== expected) {
+            footer.style.color = expected;
+          }
+        }
+
+        buttons.forEach(btn => {
+          const btnStyle = getComputedStyle(btn);
+          const expected = getContrastTextColor(btnStyle.backgroundColor);
+          if (expected && btnStyle.color !== expected) {
+            btn.style.color = expected;
+          }
+        });
+      }
+
+      updateContrastColors();
+
+      const observer = new MutationObserver(() => {
+        updateContrastColors();
+      });
+
+      observer.observe(document.documentElement, {
+        attributes: true,
+        childList: true,
+        subtree: true,
+        characterData: true
+      });
+    })();
+  </script>
+
