+        return Number(this.getAttribute('price')) || 0;
+      }
+
+      set price(val) {
+        this.setAttribute('price', String(Number(val) || 0));
+      }
+
+      get roast() {
+        return this.getAttribute('roast') ?? '';
+      }
+
+      set roast(val) {
+        val ? this.setAttribute('roast', String(val)) : this.removeAttribute('roast');
+      }
+
+      get caffeine() {
+        return this.getAttribute('caffeine') ?? '';
+      }
+
+      set caffeine(val) {
+        val ? this.setAttribute('caffeine', String(val)) : this.removeAttribute('caffeine');
+      }
+
+      get notes() {
+        return this.getAttribute('notes') ?? '';
+      }
+
+      set notes(val) {
+        val ? this.setAttribute('notes', String(val)) : this.removeAttribute('notes');
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(val) {
+        this.toggleAttribute('favorited', Boolean(val));
+      }
+
+      get disabled() {
+        return this.hasAttribute('disabled');
+      }
+
+      set disabled(val) {
+        this.toggleAttribute('disabled', Boolean(val));
+      }
+
+      get itemTitle() {
+        const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+        const assigned = titleSlot?.assignedElements?.() ?? [];
+        return assigned[0]?.textContent?.trim() || 'Coffee item';
+      }
+
+      toggleDetails(force) {
+        if (!this.#tastingPanel || !this.#detailsBtn) return;
+        const isExpanded =
+          typeof force === 'boolean' ? force : this.#tastingPanel.hasAttribute('hidden');
+        this.#tastingPanel.toggleAttribute('hidden', !isExpanded);
+        this.#detailsBtn.setAttribute('aria-expanded', String(isExpanded));
+        if (isExpanded) {
+          this.#internals.states.add('expanded');
+        } else {
+          this.#internals.states.delete('expanded');
+        }
+      }
+
+      async quickAdd() {
+        if (this.#internals.states.has('busy') || this.disabled) return;
+        this.#internals.states.add('busy');
+        this.#internals.states.delete('added');
+        if (this.#quickAddBtn) this.#quickAddBtn.textContent = 'Adding…';
+
+        try {
+          await new Promise((resolve) => setTimeout(resolve, 180));
+          this.#internals.states.add('added');
+          if (this.#quickAddBtn) this.#quickAddBtn.textContent = 'Added ✓';
+          this.dispatchEvent(
+            new CustomEvent('order-add', {
+              bubbles: true,
+              composed: true,
+              detail: {
+                title: this.itemTitle,
+                price: this.price,
+                category: this.category,
+              },
+            })
+          );
+        } finally {
+          this.#internals.states.delete('busy');
+        }
+      }
+
+      #syncFavoriteState() {
+        const isFav = this.favorited;
+        if (this.#favoriteToggle) {
+          this.#favoriteToggle.pressed = isFav;
+        }
+        if (isFav) {
+          this.#internals.states.add('favorited');
+        } else {
+          this.#internals.states.delete('favorited');
+        }
+      }
+
+      #renderDetails() {
+        if (this.#roastPill) {
+          this.#roastPill.textContent = this.roast || 'House Blend';
+        }
+        if (this.#priceTag) {
+          this.#priceTag.textContent = this.price > 0 ? `$${this.price.toFixed(2)}` : '';
+        }
+        if (this.#specRoast) {
+          this.#specRoast.textContent = this.roast || 'Standard';
+        }
+        if (this.#specCaffeine) {
+          this.#specCaffeine.textContent = this.caffeine || '150mg';
+        }
+        if (this.#specNotes) {
+          this.#specNotes.textContent = this.notes || 'Balanced artisanal roast.';
+        }
+      }
+
+      #syncAccessibleLabels() {
+        const titleSlot = this.shadowRoot.querySelector('slot[name="title"]');
+        const titleEl = titleSlot?.assignedElements?.()[0] ?? null;
+        const titleText = titleEl?.textContent?.trim() || 'Coffee';
+
+        if (this.#favoriteToggle) {
+          this.#favoriteToggle.label = `Save ${titleText} to favorites`;
+        }
+
+        // Cross-boundary outward ARIA element association with fallback to aria-label text
+        if (this.#quickAddBtn) {
+          if (titleEl && 'ariaDescribedByElements' in this.#quickAddBtn) {
+            this.#quickAddBtn.ariaDescribedByElements = [titleEl];
+          } else {
+            this.#quickAddBtn.setAttribute('aria-label', `Quick add ${titleText}`);
+          }
+        }
+
+        if (this.#detailsBtn) {
+          if (titleEl && 'ariaDescribedByElements' in this.#detailsBtn) {
+            this.#detailsBtn.ariaDescribedByElements = [titleEl];
+          } else {
+            this.#detailsBtn.setAttribute('aria-label', `Tasting notes for ${titleText}`);
+          }
+        }
+      }
+    }
+
+    customElements.define('coffee-card', CoffeeCard);
+
+    /* ==========================================================================
+     * 3. <coffee-filter>
+     * Interactive filter & order toolbar wrapping focusable controls with delegatesFocus.
+     * ========================================================================== */
+    const coffeeFilterTemplate = document.createElement('template');
+    coffeeFilterTemplate.innerHTML = `
+      <div class="filter-bar" part="toolbar" role="region" aria-label="Filter seasonal coffees">
+        <div class="category-group" role="group" aria-label="Coffee category">
+          <button type="button" class="filter-pill" part="filter-button" data-category="all" aria-pressed="true">
+            All
+          </button>
+          <button type="button" class="filter-pill" part="filter-button" data-category="seasonal" aria-pressed="false">
+            Seasonal
+          </button>
+          <button type="button" class="filter-pill" part="filter-button" data-category="espresso" aria-pressed="false">
+            Espresso
+          </button>
+          <button type="button" class="filter-pill" part="filter-button" data-category="cold-brew" aria-pressed="false">
+            Cold Brew
+          </button>
+        </div>
+
+        <div class="controls-right">
+          <button type="button" class="favorites-filter-btn" part="favorites-filter" aria-pressed="false">
+            Saved Favorites (<span class="fav-count">0</span>)
+          </button>
+          <span class="status-pill" part="status" role="status" aria-live="polite">
+            Showing all 3 coffees
+          </span>
+        </div>
+      </div>
+    `;
+
+    const coffeeFilterSheet = new CSSStyleSheet();
+    coffeeFilterSheet.replaceSync(`
+      @layer base, state;
+
+      @layer base {
+        :host {
+          display: block;
+          container-type: inline-size;
+          --_bar-bg: var(--filter-bar-bg, #ffffff);
+          --_bar-primary: var(--filter-bar-primary, var(--primary, #4e342e));
+          --_bar-secondary: var(--filter-bar-secondary, var(--secondary, #d7ccc8));
+          --_bar-accent: var(--filter-bar-accent, var(--accent, #ffab40));
+          margin-bottom: 16px;
+        }
+
+        button {
+          font: inherit;
+          color: inherit;
+        }
+
+        .filter-bar {
+          display: flex;
+          flex-wrap: wrap;
+          align-items: center;
+          justify-content: space-between;
+          gap: 12px;
+          padding: 12px 16px;
+          background: var(--_bar-bg);
+          border-radius: 8px;
+          box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
+        }
+
+        .category-group,
+        .controls-right {
+          display: flex;
+          flex-wrap: wrap;
+          align-items: center;
+          gap: 8px;
+        }
+
+        .filter-pill,
+        .favorites-filter-btn {
+          padding: 6px 14px;
+          border-radius: 999px;
+          border: 1px solid var(--_bar-secondary);
+          background: transparent;
+          color: var(--_bar-primary);
+          font-size: 0.85rem;
+          font-weight: 600;
+          cursor: pointer;
+          transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
+        }
+
+        .filter-pill[aria-pressed="true"],
+        .favorites-filter-btn[aria-pressed="true"] {
+          background: var(--_bar-primary);
+          color: #ffffff;
+          border-color: var(--_bar-primary);
+        }
+
+        .filter-pill:focus-visible,
+        .favorites-filter-btn:focus-visible {
+          outline: 2px solid var(--_bar-accent);
+          outline-offset: 2px;
+        }
+
+        .status-pill {
+          font-size: 0.85rem;
+          color: #5d4037;
+          padding-left: 4px;
+        }
+      }
+
+      @layer state {
+        :host(:state(filtering)) .filter-bar {
+          border-left: 4px solid var(--_bar-accent);
+        }
+      }
+    `);
+
+    class CoffeeFilter extends HTMLElement {
+      static observedAttributes = ['category', 'favorites-only', 'target-grid'];
+
+      #internals;
+      #categoryButtons = [];
+      #favFilterBtn;
+      #favCountEl;
+      #statusEl;
+      #docListenerAttached = false;
+
+      constructor() {
+        super();
+        this.#internals = this.attachInternals();
+        // Wrapper component delegates focus to its first internal focusable control
+        ensureShadowRoot(
+          this,
+          { mode: 'open', delegatesFocus: true },
+          coffeeFilterTemplate,
+          coffeeFilterSheet
+        );
+
+        this.#categoryButtons = Array.from(this.shadowRoot.querySelectorAll('.filter-pill'));
+        this.#favFilterBtn = this.shadowRoot.querySelector('.favorites-filter-btn');
+        this.#favCountEl = this.shadowRoot.querySelector('.fav-count');
+        this.#statusEl = this.shadowRoot.querySelector('.status-pill');
+
+        this.#categoryButtons.forEach((btn) => {
+          btn.addEventListener('click', () => {
+            this.category = btn.dataset.category || 'all';
+          });
+        });
+
+        this.#favFilterBtn?.addEventListener('click', () => {
+          this.favoritesOnly = !this.favoritesOnly;
+        });
+      }
+
+      connectedCallback() {
+        if (!this.#docListenerAttached) {
+          document.addEventListener('favorite-change', this.#onExternalUpdate);
+          document.addEventListener('order-add', this.#onOrderAdd);
+          this.#docListenerAttached = true;
+        }
+        this.#applyFilters();
+      }
+
+      connectedMoveCallback() {
+        // Keep listeners intact when relocated via Node.moveBefore()
+      }
+
+      disconnectedCallback() {
+        if (this.#docListenerAttached) {
+          document.removeEventListener('favorite-change', this.#onExternalUpdate);
+          document.removeEventListener('order-add', this.#onOrderAdd);
+          this.#docListenerAttached = false;
+        }
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        this.#applyFilters();
+      }
+
+      get category() {
+        return this.getAttribute('category') || 'all';
+      }
+
+      set category(val) {
+        const next = val ? String(val) : 'all';
+        this.setAttribute('category', next);
+      }
+
+      get favoritesOnly() {
+        return this.hasAttribute('favorites-only');
+      }
+
+      set favoritesOnly(val) {
+        this.toggleAttribute('favorites-only', Boolean(val));
+      }
+
+      get targetGrid() {
+        return this.getAttribute('target-grid') || '';
+      }
+
+      set targetGrid(val) {
+        val ? this.setAttribute('target-grid', String(val)) : this.removeAttribute('target-grid');
+      }
+
+      #onExternalUpdate = () => {
+        this.#applyFilters();
+      };
+
+      #onOrderAdd = (event) => {
+        const itemTitle = event.detail?.title || 'Coffee';
+        if (this.#statusEl) {
+          this.#statusEl.textContent = `Added ${itemTitle} to order`;
+        }
+      };
+
+      #getCards() {
+        const grid = this.targetGrid ? document.getElementById(this.targetGrid) : document;
+        return Array.from((grid || document).querySelectorAll('coffee-card'));
+      }
+
+      #applyFilters() {
+        const activeCategory = this.category;
+        const favOnly = this.favoritesOnly;
+
+        this.#categoryButtons.forEach((btn) => {
+          const isMatch = (btn.dataset.category || 'all') === activeCategory;
+          btn.setAttribute('aria-pressed', String(isMatch));
+        });
+
+        if (this.#favFilterBtn) {
+          this.#favFilterBtn.setAttribute('aria-pressed', String(favOnly));
+        }
+
+        const isFiltering = activeCategory !== 'all' || favOnly;
+        if (isFiltering) {
+          this.#internals.states.add('filtering');
+        } else {
+          this.#internals.states.delete('filtering');
+        }
+
+        const cards = this.#getCards();
+        let visibleCount = 0;
+        let favCount = 0;
+
+        cards.forEach((card) => {
+          const isFav = card.hasAttribute('favorited');
+          if (isFav) favCount += 1;
+
+          const cardCat = card.getAttribute('category') || '';
+          const matchesCat = activeCategory === 'all' || cardCat === activeCategory;
+          const matchesFav = !favOnly || isFav;
+          const show = matchesCat && matchesFav;
+
+          card.toggleAttribute('hidden', !show);
+          if (show) visibleCount += 1;
+        });
+
+        if (this.#favCountEl) {
+          this.#favCountEl.textContent = String(favCount);
+        }
+
+        if (this.#statusEl) {
+          this.#statusEl.textContent = `Showing ${visibleCount} of ${cards.length} coffees`;
+        }
+      }
+    }
+
+    customElements.define('coffee-filter', CoffeeFilter);
+  </script>
+
 </body>
 
