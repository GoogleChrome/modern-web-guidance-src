+          </button>
+          <ul id="primary-nav-list" class="nav-links" part="nav-list">
+            <li><a href="#seasonal-menu">Menu</a></li>
+            <li><a href="#brew-guide">Brew Guide</a></li>
+            <li><a href="/locations">Locations</a></li>
