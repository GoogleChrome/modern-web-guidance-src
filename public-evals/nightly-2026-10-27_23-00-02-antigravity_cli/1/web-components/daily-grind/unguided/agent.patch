+          font-size: 0.72rem;
+          font-weight: 700;
+          text-transform: uppercase;
+          letter-spacing: 0.6px;
+          padding: 4px 10px;
+          border-radius: 999px;
+          backdrop-filter: blur(4px);
+        }
+
+        .badge.highlight {
+          background: var(--dg-accent);
+          color: var(--dg-primary-dark);
+        }
+
+        .fav-btn {
+          position: absolute;
+          top: 12px;
+          right: 12px;
+          z-index: 2;
+          width: 36px;
+          height: 36px;
+          border-radius: 50%;
+          border: none;
+          background: rgba(255, 255, 255, 0.9);
+          color: ${isFav ? '#d32f2f' : 'var(--dg-primary)'};
+          cursor: pointer;
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          font-size: 1.1rem;
+          box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
+          transition: transform 0.2s, background 0.2s;
+        }
+
+        .fav-btn:hover {
+          transform: scale(1.1);
+          background: #ffffff;
+        }
+
+        .card-body {
+          padding: 20px;
+          display: flex;
+          flex-direction: column;
+          flex: 1;
+          text-align: left;
+        }
+
+        .header-row {
+          display: flex;
+          justify-content: space-between;
+          align-items: flex-start;
+          gap: 10px;
+          margin-bottom: 8px;
+        }
+
+        h3 {
+          margin: 0;
+          font-size: 1.22rem;
+          color: var(--dg-primary);
+          line-height: 1.3;
+        }
+
+        .price-value {
+          font-size: 1.15rem;
+          font-weight: 800;
+          color: var(--dg-primary-dark);
+          background: rgba(215, 204, 200, 0.45);
+          padding: 3px 9px;
+          border-radius: 6px;
+          white-space: nowrap;
+        }
+
+        .description {
+          margin: 0 0 14px;
+          color: var(--dg-text-muted);
+          font-size: 0.93rem;
+          line-height: 1.5;
+          flex-grow: 1;
