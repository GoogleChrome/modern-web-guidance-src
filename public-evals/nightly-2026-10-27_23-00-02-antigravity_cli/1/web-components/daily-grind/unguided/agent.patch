+/**
+ * 8. <coffee-footer>
+ * Accessible footer Web Component with interactive newsletter signup validation and links.
+ */
+class CoffeeFooter extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+  }
+
+  connectedCallback() {
+    this.render();
+    this._setupForm();
+  }
+
+  _setupForm() {
+    const form = this.shadowRoot.querySelector('form');
+    const feedback = this.shadowRoot.querySelector('.newsletter-feedback');
+    if (form && feedback) {
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const emailInput = form.querySelector('input[type="email"]');
+        const email = emailInput ? emailInput.value.trim() : '';
+        if (!email || !email.includes('@')) {
+          feedback.textContent = 'Please enter a valid email address.';
+          feedback.className = 'newsletter-feedback error';
+          return;
+        }
+        feedback.textContent = `Thanks for joining the Roast Club! Check ${email} for 15% off your next cup.`;
+        feedback.className = 'newsletter-feedback success';
+        form.reset();
+      });
+    }
