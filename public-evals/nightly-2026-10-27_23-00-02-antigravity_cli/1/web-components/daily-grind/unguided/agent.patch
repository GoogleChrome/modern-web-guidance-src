+            <li><a href="/logout" class="logout-link">Logout</a></li>
+          </ul>
+          <button type="button" class="cart-trigger" part="cart-button" aria-label="Open coffee order bag, ${cartCount} ${cartCount === 1 ? 'item' : 'items'}">
+            <span aria-hidden="true">🛍️</span>
+            <span>Bag</span>
+            <span class="cart-badge" aria-live="polite">${cartCount}</span>
+          </button>
+        </div>
+      </nav>
+    `;
+  }
+}
