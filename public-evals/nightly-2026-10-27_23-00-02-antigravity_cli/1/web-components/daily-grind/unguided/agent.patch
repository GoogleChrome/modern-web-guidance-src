+// Register all Custom Elements safely
+const componentRegistry = [
+  ['coffee-navbar', CoffeeNavbar],
+  ['coffee-hero', CoffeeHero],
+  ['coffee-card', CoffeeCard],
+  ['coffee-menu-section', CoffeeMenuSection],
+  ['coffee-brew-guide', CoffeeBrewGuide],
+  ['coffee-details-modal', CoffeeDetailsModal],
+  ['coffee-cart-drawer', CoffeeCartDrawer],
+  ['coffee-footer', CoffeeFooter]
+];
+
+componentRegistry.forEach(([tagName, clazz]) => {
+  if (!customElements.get(tagName)) {
+    customElements.define(tagName, clazz);
+  }
+});
+
+// Wire up page-level cross-component interactions once DOM is ready
+function initDailyGrindPage() {
+  const navbar = document.querySelector('coffee-navbar');
+  const modal = document.querySelector('coffee-details-modal');
+  const cartDrawer = document.querySelector('coffee-cart-drawer');
+  const menuSection = document.querySelector('coffee-menu-section');
+
+  document.addEventListener('coffee-view-details', (e) => {
+    if (modal && e.detail) {
+      e.preventDefault();
+      modal.open(e.detail);
+    }
+  });
+
+  document.addEventListener('coffee-add-to-cart', (e) => {
+    if (cartDrawer && e.detail) {
+      cartDrawer.addItem(e.detail);
+    }
+  });
+
+  document.addEventListener('cart-updated', (e) => {
+    if (navbar && e.detail) {
+      navbar.setAttribute('cart-count', String(e.detail.count));
+    }
+  });
+
+  document.addEventListener('cart-toggle', () => {
+    if (cartDrawer) {
+      cartDrawer.toggle();
+    }
+  });
+
+  document.addEventListener('hero-explore', () => {
+    if (menuSection) {
+      menuSection.scrollIntoView({ behavior: 'smooth' });
+    }
+  });
+}
+
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', initDailyGrindPage);
+} else {
+  initDailyGrindPage();
+}
