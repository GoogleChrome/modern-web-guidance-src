+          transition: background 0.25s, transform 0.2s;
+        }
+
+        .cart-trigger:hover {
+          background: rgba(255, 171, 64, 0.22);
+          transform: translateY(-1px);
+        }
+
+        .cart-badge {
+          background: var(--dg-accent);
+          color: var(--dg-primary-dark);
+          font-size: 0.78rem;
+          font-weight: 800;
+          min-width: 22px;
