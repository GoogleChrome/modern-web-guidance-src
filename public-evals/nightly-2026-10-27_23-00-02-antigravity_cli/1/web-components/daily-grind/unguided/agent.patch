+      </style>
+      <nav part="navbar" aria-label="Primary Navigation">
+        <a href="/" class="brand-wrap" part="brand">
+          <span class="logo-icon" aria-hidden="true">☕</span>
+          <span class="logo">${brand}</span>
+        </a>
+        <div class="nav-right">
+          <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="primary-nav-list" aria-label="Toggle navigation menu">
