+// Shared base theme variables and reset helper for Shadow DOM
+const sharedStyles = `
+  :host {
+    --dg-primary: var(--primary, #4e342e);
+    --dg-primary-dark: var(--primary-dark, #3e2723);
+    --dg-secondary: var(--secondary, #d7ccc8);
+    --dg-accent: var(--accent, #ffab40);
+    --dg-accent-dark: var(--accent-dark, #e65100);
+    --dg-text: var(--text, #3e2723);
+    --dg-text-muted: var(--text-muted, #5d4037);
+    --dg-light: var(--light, #fafafa);
+    --dg-surface: var(--surface, #ffffff);
+    --dg-radius: var(--radius, 12px);
+    --dg-shadow: var(--shadow, 0 4px 12px rgba(62, 39, 35, 0.08));
+    --dg-shadow-hover: var(--shadow-hover, 0 10px 24px rgba(62, 39, 35, 0.16));
+    --dg-focus-ring: 0 0 0 3px rgba(255, 171, 64, 0.55);
+    box-sizing: border-box;
+    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    color: var(--dg-text);
+  }
+
+  *, *::before, *::after {
+    box-sizing: border-box;
+  }
+
+  :focus-visible {
+    outline: 2px solid var(--dg-accent);
+    outline-offset: 2px;
+    box-shadow: var(--dg-focus-ring);
+  }
+`;
