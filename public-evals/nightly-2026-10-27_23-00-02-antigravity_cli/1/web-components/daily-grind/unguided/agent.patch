+
+        .footer-links a {
+          color: var(--dg-text);
+          text-decoration: none;
+          font-size: 0.9rem;
+          font-weight: 600;
+        }
+
+        .footer-links a:hover {
+          text-decoration: underline;
+          color: var(--dg-primary);
+        }
+
+        .copyright {
+          font-size: 0.88rem;
+          color: var(--dg-text-muted);
+          margin: 0;
+        }
+      </style>
+
+      <footer part="footer" role="contentinfo">
+        <div class="newsletter-box" part="newsletter">
+          <h3>Join the Daily Grind Roast Club</h3>
+          <p>Get early access to single-origin micro-lots and seasonal tasting notes.</p>
+          <form novalidate aria-label="Newsletter subscription">
