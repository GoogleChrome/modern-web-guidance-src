+/**
+ * 3. <coffee-card>
+ * Reusable, accessible Web Component for individual coffee items.
+ * Encapsulates card layout, stock photography, roast/category badges, tasting note tags,
+ * interactive size & milk customization, favorite toggle, details trigger, and Add-to-Bag action.
+ */
+class CoffeeCard extends HTMLElement {
+  static get observedAttributes() {
+    return [
+      'coffee-id',
+      'name',
+      'description',
+      'price',
+      'category',
+      'roast',
+      'image',
+      'href',
+      'badge',
+      'calories',
+      'caffeine',
+      'origin',
+      'notes',
+      'favorited'
+    ];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this._selectedSize = '12oz';
+    this._sizeModifiers = {
+      '8oz': -0.5,
+      '12oz': 0,
+      '16oz': 0.75
+    };
+  }
+
+  connectedCallback() {
+    this.render();
+    this._attachEvents();
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue && this.isConnected) {
+      this.render();
+      this._attachEvents();
+    }
+  }
+
+  get basePrice() {
+    return parseFloat(this.getAttribute('price') || '4.50');
+  }
+
+  get currentPrice() {
+    const mod = this._sizeModifiers[this._selectedSize] || 0;
+    return (this.basePrice + mod).toFixed(2);
+  }
+
+  get coffeeData() {
+    return {
+      id: this.getAttribute('coffee-id') || this.getAttribute('name')?.toLowerCase().replace(/\s+/g, '-') || 'coffee-item',
+      name: this.getAttribute('name') || 'Artisanal Coffee',
+      description: this.getAttribute('description') || '',
+      basePrice: this.basePrice,
+      price: parseFloat(this.currentPrice),
+      size: this._selectedSize,
+      category: this.getAttribute('category') || 'seasonal',
+      roast: this.getAttribute('roast') || 'Medium Roast',
+      image: this.getAttribute('image') || 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80',
+      href: this.getAttribute('href') || '/menu',
+      badge: this.getAttribute('badge') || '',
+      calories: this.getAttribute('calories') || '120 kcal',
+      caffeine: this.getAttribute('caffeine') || '150mg',
+      origin: this.getAttribute('origin') || 'Single Origin Latin America',
+      notes: (this.getAttribute('notes') || '').split(',').map(s => s.trim()).filter(Boolean)
+    };
+  }
+
+  _attachEvents() {
+    // Size selector buttons
+    const sizeBtns = this.shadowRoot.querySelectorAll('.size-btn');
+    sizeBtns.forEach(btn => {
+      btn.addEventListener('click', () => {
+        this._selectedSize = btn.dataset.size;
+        sizeBtns.forEach(b => {
+          const active = b.dataset.size === this._selectedSize;
+          b.classList.toggle('active', active);
+          b.setAttribute('aria-checked', String(active));
+        });
+        const priceEl = this.shadowRoot.querySelector('.price-value');
+        if (priceEl) {
+          priceEl.textContent = `$${this.currentPrice}`;
+        }
+      });
+    });
+
+    // Favorite toggle button
+    const favBtn = this.shadowRoot.querySelector('.fav-btn');
+    if (favBtn) {
+      favBtn.addEventListener('click', () => {
+        const isFav = this.hasAttribute('favorited');
+        if (isFav) {
+          this.removeAttribute('favorited');
+        } else {
+          this.setAttribute('favorited', '');
+        }
+        this.dispatchEvent(new CustomEvent('coffee-favorite', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            ...this.coffeeData,
+            favorited: !isFav
+          }
+        }));
+      });
+    }
+
+    // Add to Order button
+    const addBtn = this.shadowRoot.querySelector('.add-btn');
+    if (addBtn) {
+      addBtn.addEventListener('click', () => {
+        addBtn.classList.add('added');
+        const labelEl = addBtn.querySelector('.add-label');
+        const originalText = labelEl ? labelEl.textContent : 'Add to Order';
+        if (labelEl) labelEl.textContent = 'Added ✓';
+        setTimeout(() => {
+          addBtn.classList.remove('added');
+          if (labelEl) labelEl.textContent = originalText;
+        }, 900);
+
+        this.dispatchEvent(new CustomEvent('coffee-add-to-cart', {
+          bubbles: true,
+          composed: true,
+          detail: this.coffeeData
+        }));
+      });
+    }
+
+    // View Details trigger (opens accessible modal if handled, or navigates)
+    const detailsLink = this.shadowRoot.querySelector('.details-trigger');
+    if (detailsLink) {
+      detailsLink.addEventListener('click', (e) => {
+        const event = new CustomEvent('coffee-view-details', {
+          bubbles: true,
+          composed: true,
+          cancelable: true,
+          detail: this.coffeeData
+        });
+        const notCancelled = this.dispatchEvent(event);
+        if (!notCancelled) {
+          e.preventDefault();
+        }
+      });
+    }
+  }
+
+  render() {
+    const data = this.coffeeData;
+    const isFav = this.hasAttribute('favorited');
+
+    this.shadowRoot.innerHTML = `
