+  <script>
+    (function () {
+      const searchInput = document.getElementById('search-input');
+      const cards = document.querySelectorAll('.grid .card');
+
+      function escapeRegExp(str) {
+        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+      }
+
+      function clearHighlights(card) {
+        const highlights = card.querySelectorAll('mark.highlight');
+        highlights.forEach((mark) => {
+          mark.replaceWith(document.createTextNode(mark.textContent));
+        });
+        card.normalize();
+      }
+
+      function highlightCardText(card, regex) {
+        const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT, null);
+        const textNodes = [];
+        let currentNode = walker.nextNode();
+        while (currentNode) {
+          if (currentNode.nodeValue && currentNode.nodeValue.trim().length > 0) {
+            textNodes.push(currentNode);
+          }
+          currentNode = walker.nextNode();
+        }
+
+        textNodes.forEach((node) => {
+          const text = node.nodeValue;
+          regex.lastIndex = 0;
+          if (!regex.test(text)) {
+            return;
+          }
+
+          regex.lastIndex = 0;
+          const fragment = document.createDocumentFragment();
+          let lastIdx = 0;
+          let match;
+
+          while ((match = regex.exec(text)) !== null) {
+            if (match.index > lastIdx) {
+              fragment.appendChild(document.createTextNode(text.slice(lastIdx, match.index)));
+            }
+            const mark = document.createElement('mark');
+            mark.className = 'highlight';
+            mark.style.backgroundColor = 'gold';
+            mark.textContent = match[0];
+            fragment.appendChild(mark);
+            lastIdx = regex.lastIndex;
+            if (match[0].length === 0) {
+              regex.lastIndex++;
+            }
+          }
+
+          if (lastIdx < text.length) {
+            fragment.appendChild(document.createTextNode(text.slice(lastIdx)));
+          }
+
+          node.parentNode.replaceChild(fragment, node);
+        });
+      }
+
+      function handleSearch() {
+        const query = searchInput.value;
+        cards.forEach((card) => {
+          clearHighlights(card);
+        });
+
+        if (!query || query.trim().length === 0) {
+          return;
+        }
+
+        const regex = new RegExp(escapeRegExp(query), 'gi');
+        cards.forEach((card) => {
+          highlightCardText(card, regex);
+        });
+      }
+
+      if (searchInput) {
+        searchInput.addEventListener('input', handleSearch);
+        searchInput.addEventListener('keyup', handleSearch);
+      }
+    })();
+  </script>
