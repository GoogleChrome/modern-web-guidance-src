+  <script>
+    const searchInput = document.getElementById('search-input');
+    const menuGrid = document.getElementById('menu-grid');
+    const cards = menuGrid.querySelectorAll('.card');
+
+    // Cache text nodes inside the menu cards using TreeWalker
+    const cachedTextNodes = [];
+    cards.forEach((card) => {
+      const treeWalker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+      let currentNode = treeWalker.nextNode();
+      while (currentNode) {
+        if (currentNode.textContent.trim().length > 0) {
+          cachedTextNodes.push(currentNode);
+        }
+        currentNode = treeWalker.nextNode();
+      }
+    });
+
+    function clearFallbackMarks() {
+      const marks = menuGrid.querySelectorAll('mark.search-highlight');
+      marks.forEach((mark) => {
+        const parent = mark.parentNode;
+        mark.replaceWith(document.createTextNode(mark.textContent));
+        parent.normalize();
+      });
+    }
+
+    searchInput.addEventListener('input', () => {
+      const query = searchInput.value.trim().toLowerCase();
+
+      if (CSS.highlights) {
+        // Clear previous highlights before registering new ones
+        CSS.highlights.clear();
+
+        if (!query) return;
+
+        const matchingRanges = [];
+        for (const textNode of cachedTextNodes) {
+          const text = textNode.textContent.toLowerCase();
+          let startPos = 0;
+          while (startPos < text.length) {
+            const index = text.indexOf(query, startPos);
+            if (index === -1) break;
+
+            const range = new Range();
+            range.setStart(textNode, index);
+            range.setEnd(textNode, index + query.length);
+            matchingRanges.push(range);
+
+            startPos = index + query.length;
+          }
+        }
+
+        if (matchingRanges.length > 0) {
+          const searchHighlight = new Highlight(...matchingRanges);
+          CSS.highlights.set('search-results', searchHighlight);
+        }
+      } else {
+        // Fallback for browsers without CSS Custom Highlight API support
+        clearFallbackMarks();
+
+        if (!query) return;
+
+        cards.forEach((card) => {
+          const walker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+          const nodes = [];
+          for (let n = walker.nextNode(); n; n = walker.nextNode()) {
+            if (n.textContent.trim().length > 0) nodes.push(n);
+          }
+
+          for (const textNode of nodes) {
+            const text = textNode.textContent;
+            let pos = text.toLowerCase().indexOf(query);
+            if (pos === -1) continue;
+
+            const frag = document.createDocumentFragment();
+            let last = 0;
+            while (pos !== -1) {
+              frag.append(text.slice(last, pos));
+              const mark = document.createElement('mark');
+              mark.className = 'search-highlight';
+              mark.textContent = text.slice(pos, pos + query.length);
+              frag.append(mark);
+              last = pos + query.length;
+              pos = text.toLowerCase().indexOf(query, last);
+            }
+            frag.append(text.slice(last));
+            textNode.replaceWith(frag);
+          }
+        });
+      }
+    });
+  </script>
+
