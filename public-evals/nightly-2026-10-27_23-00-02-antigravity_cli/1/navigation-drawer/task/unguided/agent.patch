+  <script>
+    (() => {
+      const drawer = document.getElementById('nav-drawer');
+      const toggleBtn = document.querySelector('.menu-toggle');
+      const dismissZone = drawer.querySelector('.drawer-DismissZone');
+      const panel = drawer.querySelector('.drawer-panel');
+
+      let isOpening = false;
+      let scrollEndTimeout = null;
+
+      // Sync state and scroll position when the popover opens/closes
+      drawer.addEventListener('toggle', (event) => {
+        const isOpen = event.newState === 'open';
+        toggleBtn.setAttribute('aria-expanded', String(isOpen));
+
+        if (isOpen) {
+          isOpening = true;
+          // Snap immediately to the open drawer panel on the right
+          drawer.scrollLeft = drawer.scrollWidth;
+          requestAnimationFrame(() => {
+            drawer.scrollLeft = drawer.scrollWidth;
+            isOpening = false;
+          });
+        }
+      });
+
+      // Close when tapping the backdrop / dismiss zone
+      drawer.addEventListener('click', (event) => {
+        if (event.target === drawer || event.target === dismissZone) {
+          drawer.hidePopover();
+        }
+      });
+
+      // Close when a navigation link inside the drawer is clicked
+      panel.addEventListener('click', (event) => {
+        if (event.target.closest('a')) {
+          drawer.hidePopover();
+        }
+      });
+
+      // Handle native swipe-to-close via CSS scroll-snap + scrollend event
+      const checkSwipeDismiss = () => {
+        if (isOpening || !drawer.matches(':popover-open')) return;
+        if (drawer.scrollLeft <= 10) {
+          drawer.hidePopover();
+        }
+      };
+
+      if ('onscrollend' in window) {
+        drawer.addEventListener('scrollend', checkSwipeDismiss);
+      } else {
+        drawer.addEventListener('scroll', () => {
+          clearTimeout(scrollEndTimeout);
+          scrollEndTimeout = setTimeout(checkSwipeDismiss, 100);
+        }, { passive: true });
+      }
+
+      // Pointer drag support for desktop/touch drag directly on the drawer panel
+      let startX = 0;
+      let startY = 0;
+      let currentX = 0;
+      let isDragging = false;
+      let activePointerId = null;
+
+      panel.addEventListener('pointerdown', (event) => {
+        if (event.pointerType === 'mouse' && event.button !== 0) return;
+        if (event.target.closest('button, a')) return;
+        startX = event.clientX;
+        startY = event.clientY;
+        currentX = startX;
+        isDragging = false;
+        activePointerId = event.pointerId;
+      });
+
+      panel.addEventListener('pointermove', (event) => {
+        if (activePointerId !== event.pointerId) return;
+        const deltaX = event.clientX - startX;
+        const deltaY = Math.abs(event.clientY - startY);
+
+        if (!isDragging) {
+          // Begin horizontal swipe-out if dragging rightward towards the edge
+          if (deltaX > 10 && deltaX > deltaY) {
+            isDragging = true;
+            panel.setPointerCapture(event.pointerId);
+            panel.style.transition = 'none';
+          } else if (deltaY > 10) {
+            activePointerId = null;
+            return;
+          }
+        }
+
+        if (isDragging) {
+          currentX = event.clientX;
+          const translate = Math.max(0, deltaX);
+          panel.style.transform = `translateX(${translate}px)`;
+        }
+      });
+
+      const finishPointerDrag = (event) => {
+        if (activePointerId !== event.pointerId) return;
+        activePointerId = null;
+        if (!isDragging) return;
+        isDragging = false;
+
+        const deltaX = currentX - startX;
+        const threshold = panel.offsetWidth * 0.25;
+        panel.style.transition = 'transform 0.2s ease-out';
+
+        if (deltaX > threshold) {
+          panel.style.transform = 'translateX(100%)';
+          setTimeout(() => {
+            drawer.hidePopover();
+            panel.style.transition = '';
+            panel.style.transform = '';
+          }, 180);
+        } else {
+          panel.style.transform = '';
+          setTimeout(() => {
+            panel.style.transition = '';
+          }, 200);
+        }
+      };
+
+      panel.addEventListener('pointerup', finishPointerDrag);
+      panel.addEventListener('pointercancel', finishPointerDrag);
+    })();
+  </script>
