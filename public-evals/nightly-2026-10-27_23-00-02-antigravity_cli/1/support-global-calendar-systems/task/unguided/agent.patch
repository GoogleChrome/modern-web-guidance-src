+  <script type="module">
+    let Temporal = globalThis.Temporal;
+    if (!Temporal) {
+      const polyfill = await import('https://esm.sh/@js-temporal/polyfill');
+      Temporal = polyfill.Temporal;
+      globalThis.Temporal = Temporal;
+    }
+
+    const CALENDARS = [
+      {
+        id: 'islamic-umalqura',
+        cardId: 'card-islamic-umalqura',
+        dateElId: 'islamic-date',
+        formatOptions: {
+          calendar: 'islamic-umalqura',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      },
+      {
+        id: 'hebrew',
+        cardId: 'card-hebrew',
+        dateElId: 'hebrew-date',
+        formatOptions: {
+          calendar: 'hebrew',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      },
+      {
+        id: 'japanese',
+        cardId: 'card-japanese',
+        dateElId: 'japanese-date',
+        formatOptions: {
+          calendar: 'japanese',
+          era: 'long',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      }
+    ];
+
+    const dateInput = document.getElementById('calendar-date-input');
+
+    function getTimelineLabel(selectedIsoDate, todayIsoDate) {
+      const cmp = Temporal.PlainDate.compare(selectedIsoDate, todayIsoDate);
+      if (cmp < 0) return 'Past';
+      if (cmp > 0) return 'Future';
+      return 'Today';
+    }
+
+    function buildMonthBreakdown(convertedDate) {
+      const totalMonths = convertedDate.monthsInYear;
+      const months = [];
+      for (let m = 1; m <= totalMonths; m++) {
+        const monthStart = convertedDate.with({ month: m, day: 1 });
+        months.push({
+          month: m,
+          monthCode: monthStart.monthCode,
+          daysInMonth: monthStart.daysInMonth
+        });
+      }
+      return months;
+    }
+
+    function updateCalendars(isoDateString) {
+      if (!isoDateString) return;
+      let selectedIsoDate;
+      try {
+        selectedIsoDate = Temporal.PlainDate.from(isoDateString);
+      } catch {
+        return;
+      }
+
+      const todayIsoDate = Temporal.Now.plainDateISO();
+      const timelineLabel = getTimelineLabel(selectedIsoDate, todayIsoDate);
+
+      for (const calConfig of CALENDARS) {
+        const card = document.getElementById(calConfig.cardId);
+        if (!card) continue;
+
+        const convertedDate = selectedIsoDate.withCalendar(calConfig.id);
+        const formattedDate = convertedDate.toLocaleString('en-US', calConfig.formatOptions);
+
+        const dateEl = document.getElementById(calConfig.dateElId);
+        if (dateEl) {
+          dateEl.textContent = formattedDate;
+        }
+
+        const timelineEl = card.querySelector('[data-field="timeline"]');
+        if (timelineEl) {
+          timelineEl.textContent = timelineLabel;
+          timelineEl.dataset.timeline = timelineLabel;
+        }
+
+        const yearEl = card.querySelector('[data-field="year"]');
+        if (yearEl) {
+          yearEl.textContent = String(convertedDate.year);
+        }
+
+        const monthEl = card.querySelector('[data-field="month"]');
+        if (monthEl) {
+          monthEl.textContent = String(convertedDate.month);
+        }
+
+        const monthCodeEl = card.querySelector('[data-field="monthCode"]');
+        if (monthCodeEl) {
+          monthCodeEl.textContent = convertedDate.monthCode;
+        }
+
+        const monthsInYearEl = card.querySelector('[data-field="monthsInYear"]');
+        if (monthsInYearEl) {
+          monthsInYearEl.textContent = String(convertedDate.monthsInYear);
+        }
+
+        const breakdownEl = card.querySelector('[data-field="monthBreakdown"]');
+        if (breakdownEl) {
+          const breakdown = buildMonthBreakdown(convertedDate);
+          breakdownEl.replaceChildren(
+            ...breakdown.map((item) => {
+              const li = document.createElement('li');
+              li.className = 'month-breakdown-item' +
+                (item.monthCode === convertedDate.monthCode ? ' current-month' : '');
+              li.dataset.monthCode = item.monthCode;
+              li.dataset.daysInMonth = String(item.daysInMonth);
+
+              const codeSpan = document.createElement('span');
+              codeSpan.className = 'breakdown-code';
+              codeSpan.textContent = item.monthCode;
+
+              const daysSpan = document.createElement('span');
+              daysSpan.className = 'breakdown-days';
+              daysSpan.textContent = `${item.daysInMonth} days`;
+
+              li.append(codeSpan, daysSpan);
+              return li;
+            })
+          );
+        }
+      }
+    }
+
+    if (!dateInput.value) {
+      dateInput.value = Temporal.Now.plainDateISO().toString();
+    }
+    updateCalendars(dateInput.value);
+
+    dateInput.addEventListener('input', (e) => {
+      updateCalendars(e.target.value);
+    });
+    dateInput.addEventListener('change', (e) => {
+      updateCalendars(e.target.value);
+    });
+  </script>
 </body>
 
