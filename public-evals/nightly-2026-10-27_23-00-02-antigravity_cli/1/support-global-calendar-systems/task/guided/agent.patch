+  <script type="module">
+    const CALENDAR_CONFIGS = [
+      {
+        key: 'islamic',
+        calendarId: 'islamic-umalqura',
+        locale: 'en-u-ca-islamic-umalqura',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric'
+        }
+      },
+      {
+        key: 'hebrew',
+        calendarId: 'hebrew',
+        locale: 'en-u-ca-hebrew',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric'
+        }
+      },
+      {
+        key: 'japanese',
+        calendarId: 'japanese',
+        locale: 'en-u-ca-japanese',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric',
+          era: 'long'
+        }
+      }
+    ];
+
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    function renderCalendars(isoDateString) {
+      let baseIsoDate;
+      try {
+        baseIsoDate = isoDateString
+          ? Temporal.PlainDate.from(isoDateString)
+          : Temporal.Now.plainDateISO();
+      } catch {
+        baseIsoDate = Temporal.Now.plainDateISO();
+      }
+
+      const todayIso = Temporal.Now.plainDateISO();
+
+      for (const config of CALENDAR_CONFIGS) {
+        const supported = isCalendarSupported(config.calendarId);
+        const targetDate = supported
+          ? baseIsoDate.withCalendar(config.calendarId)
+          : baseIsoDate;
+        const todayInCalendar = supported
+          ? todayIso.withCalendar(config.calendarId)
+          : todayIso;
+
+        // 1. Formatted localized date (with era names for Japanese)
+        const formattedDisplay = targetDate.toLocaleString(
+          config.locale,
+          config.formatOptions
+        );
+        const dateEl = document.getElementById(`${config.key}-date`);
+        if (dateEl) {
+          dateEl.textContent = formattedDisplay;
+        }
+
+        // 2. Converted year, numeric month, and unique stable month code
+        const yearEl = document.getElementById(`${config.key}-year`);
+        if (yearEl) {
+          yearEl.textContent = String(targetDate.year);
+        }
+
+        const monthEl = document.getElementById(`${config.key}-month`);
+        if (monthEl) {
+          monthEl.textContent = String(targetDate.month);
+        }
+
+        const monthCodeEl = document.getElementById(`${config.key}-month-code`);
+        if (monthCodeEl) {
+          monthCodeEl.textContent = targetDate.monthCode;
+        }
+
+        // 3. Total number of months in that specific calendar year
+        const monthsInYearEl = document.getElementById(`${config.key}-months-in-year`);
+        if (monthsInYearEl) {
+          monthsInYearEl.textContent = String(targetDate.monthsInYear);
+        }
+
+        // 4. Timeline label comparing selected date against current date
+        const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+        const timelineStatus = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+        const timelineEl = document.getElementById(`${config.key}-timeline`);
+        if (timelineEl) {
+          timelineEl.textContent = timelineStatus;
+          timelineEl.dataset.status = timelineStatus;
+        }
+
+        // 5. Month breakdown showing each month's code and days in that month
+        const breakdownEl = document.getElementById(`${config.key}-month-breakdown`);
+        if (breakdownEl) {
+          breakdownEl.replaceChildren();
+          for (let m = 1; m <= targetDate.monthsInYear; m++) {
+            const monthDate = targetDate.with({ month: m, day: 1 });
+            const li = document.createElement('li');
+            li.className = 'month-chip' + (m === targetDate.month ? ' active-month' : '');
+            li.dataset.monthCode = monthDate.monthCode;
+            li.dataset.daysInMonth = String(monthDate.daysInMonth);
+
+            const codeSpan = document.createElement('span');
+            codeSpan.textContent = monthDate.monthCode;
+
+            const daysSpan = document.createElement('span');
+            daysSpan.textContent = `${monthDate.daysInMonth} days`;
+
+            li.append(codeSpan, daysSpan);
+            breakdownEl.appendChild(li);
+          }
+        }
+      }
+    }
+
+    function initializeApp() {
+      const datePicker = document.getElementById('calendar-date-picker');
+      const todayIso = Temporal.Now.plainDateISO();
+
+      if (datePicker) {
+        if (!datePicker.value) {
+          datePicker.value = todayIso.toString();
+        }
+        datePicker.addEventListener('input', (event) => {
+          renderCalendars(event.target.value);
+        });
+        datePicker.addEventListener('change', (event) => {
+          renderCalendars(event.target.value);
+        });
+        renderCalendars(datePicker.value);
+      } else {
+        renderCalendars(todayIso.toString());
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
 </html>
