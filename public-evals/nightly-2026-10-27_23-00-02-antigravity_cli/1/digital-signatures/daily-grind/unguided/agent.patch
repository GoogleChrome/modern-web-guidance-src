+  }
+
+  async function loadDocumentIntoVerifier(docObj, scrollNow = true) {
+    activeVerifierDoc = docObj;
+    const jsonInput = document.getElementById('verifier-json-input');
+    const pubKeyInput = document.getElementById('verifier-pubkey-input');
+    if (jsonInput) {
+      jsonInput.value = JSON.stringify(docObj, null, 2);
+    }
+    if (pubKeyInput && docObj && docObj.cryptoProof && docObj.cryptoProof.publicKey) {
+      pubKeyInput.value = formatPem(docObj.cryptoProof.publicKey, 'PUBLIC KEY');
+    }
+    await runVerificationFromUI();
+    if (scrollNow) {
+      document.getElementById('verification-inspector')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+    }
+  }
+
+  async function runVerificationFromUI() {
+    const jsonInput = document.getElementById('verifier-json-input');
+    const pubKeyInput = document.getElementById('verifier-pubkey-input');
+    const statusBox = document.getElementById('verification-result-banner');
+
+    if (!jsonInput || !statusBox) return;
+
+    let parsed;
+    try {
+      parsed = JSON.parse(jsonInput.value);
+    } catch (e) {
+      statusBox.className = 'verification-banner status-invalid';
+      statusBox.innerHTML = `
+        <div class="ver-title">❌ MALFORMED JSON DOCUMENT</div>
+        <p>Could not parse the signed receipt or gift voucher JSON payload: ${escapeHtml(e.message)}</p>
+      `;
+      return;
+    }
+
+    const overridePub = pubKeyInput && pubKeyInput.value.trim() ? pubKeyInput.value.trim() : undefined;
+    const result = await verifySignedDocument(parsed, overridePub);
+
+    const docTypeLabel =
+      parsed.payload?.documentType === 'COFFEE_GIFT_VOUCHER'
+        ? `Gift Voucher (${parsed.payload.voucherCode || 'N/A'})`
+        : parsed.payload?.documentType === 'COFFEE_ORDER_RECEIPT'
+        ? `Coffee Order Receipt (#${parsed.payload.orderId || 'N/A'})`
+        : 'Signed Document';
+
+    if (result.valid) {
+      statusBox.className = 'verification-banner status-valid';
+      statusBox.innerHTML = `
+        <div class="ver-header-row">
+          <div class="ver-title">✅ VERIFIED AUTHENTIC &amp; UNMODIFIED</div>
+          <span class="ver-pill valid-pill">${result.quantumResistant ? 'Quantum-Resistant Proof' : 'Classical Proof'}</span>
+        </div>
+        <p class="ver-reason"><strong>${escapeHtml(docTypeLabel)}:</strong> ${escapeHtml(result.reason)}</p>
+        <div class="ver-metrics-grid">
+          <div><strong>Algorithm:</strong> <code>${escapeHtml(result.algorithmName || result.algorithm)}</code></div>
+          <div><strong>Signer Key ID:</strong> <code>${escapeHtml(result.keyFingerprint)}</code></div>
+          <div><strong>Computed SHA-256:</strong> <code>${escapeHtml(result.computedDigestHex)}</code></div>
+          <div><strong>Verification Engine:</strong> ${escapeHtml(result.details)}</div>
+        </div>
+      `;
+    } else {
+      statusBox.className = 'verification-banner status-invalid';
+      statusBox.innerHTML = `
+        <div class="ver-header-row">
+          <div class="ver-title">🚨 VERIFICATION FAILED — TAMPERED OR INVALID SIGNATURE</div>
+          <span class="ver-pill invalid-pill">Rejected</span>
+        </div>
+        <p class="ver-reason"><strong>${escapeHtml(docTypeLabel)}:</strong> ${escapeHtml(result.reason)}</p>
+        <div class="ver-metrics-grid">
+          <div><strong>Algorithm:</strong> <code>${escapeHtml(result.algorithm || 'Unknown')}</code></div>
+          <div><strong>Computed SHA-256:</strong> <code>${escapeHtml(result.computedDigestHex || 'N/A')}</code></div>
+          <div><strong>Recorded SHA-256:</strong> <code>${escapeHtml(result.recordedDigestHex || 'N/A')}</code></div>
+          <div><strong>Diagnostic:</strong> ${escapeHtml(result.details || 'Cryptographic signature verification rejected payload.')}</div>
+        </div>
+      `;
+    }
+  }
+
+  function addToSignedLedger(signedDoc) {
+    signedHistory.unshift(signedDoc);
+    if (signedHistory.length > 8) signedHistory.pop();
+    renderLedgerList();
+  }
+
+  function renderLedgerList() {
+    const tbody = document.getElementById('signed-ledger-tbody');
+    if (!tbody) return;
+
+    if (signedHistory.length === 0) {
+      tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding: 14px;">No signed documents yet.</td></tr>`;
+      return;
+    }
+
+    tbody.innerHTML = signedHistory
+      .map((doc, idx) => {
+        const isVoucher = doc.payload.documentType === 'COFFEE_GIFT_VOUCHER';
+        const refId = isVoucher ? doc.payload.voucherCode : doc.payload.orderId;
+        const holder = isVoucher ? doc.payload.recipientName : doc.payload.customerName;
+        const amount = isVoucher ? doc.payload.valueUSD : doc.payload.totalUSD;
+        const algoBadge = doc.cryptoProof.quantumResistant ? '🛡️ PQC' : '🔒 Classical';
+
+        return `
+          <tr>
+            <td><span class="ledger-type-pill ${isVoucher ? 'pill-voucher' : 'pill-receipt'}">${isVoucher ? 'Gift Voucher' : 'Order Receipt'}</span></td>
+            <td><code>${escapeHtml(refId)}</code></td>
+            <td>${escapeHtml(holder)}</td>
+            <td><strong>${formatCurrency(amount)}</strong></td>
+            <td><span title="${escapeHtml(doc.cryptoProof.algorithmName)}">${algoBadge} · ${escapeHtml(doc.cryptoProof.algorithm)}</span></td>
+            <td>
+              <button type="button" class="btn-table-action" data-ledger-idx="${idx}" data-action="verify">Inspect &amp; Verify</button>
+              <button type="button" class="btn-table-action btn-table-danger" data-ledger-idx="${idx}" data-action="tamper">Tamper Test</button>
+            </td>
+          </tr>
+        `;
+      })
+      .join('');
+
+    tbody.querySelectorAll('button[data-ledger-idx]').forEach(btn => {
+      btn.addEventListener('click', () => {
+        const idx = parseInt(btn.getAttribute('data-ledger-idx'), 10);
+        const action = btn.getAttribute('data-action');
+        const targetDoc = signedHistory[idx];
+        if (!targetDoc) return;
+        if (action === 'verify') {
+          loadDocumentIntoVerifier(targetDoc, true);
+        } else if (action === 'tamper') {
+          const clone = JSON.parse(JSON.stringify(targetDoc));
+          if (clone.payload.documentType === 'COFFEE_GIFT_VOUCHER') {
+            clone.payload.valueUSD = 999.99;
+          } else {
+            clone.payload.totalUSD = 0.01;
+          }
+          loadDocumentIntoVerifier(clone, true);
+        }
+      });
+    });
