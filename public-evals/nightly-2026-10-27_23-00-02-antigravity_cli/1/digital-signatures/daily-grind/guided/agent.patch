new file mode 100644
index 0000000..5a19586
--- /dev/null
+++ b/app.js
@@ -0,0 +1,362 @@
+import {
+  supportsPostQuantumSignatures,
+  generateSigningKeyPair,
+  signPayload,
+  verifyPayload,
+  getContextBytes,
+  bytesToBase64,
+  base64ToBytes,
+  bytesToHex,
+} from './crypto-signing.js';
+
+let activeSigner = null;
+let currentEnvelope = null;
+
+const PRESETS = {
+  receipt: {
+    artifactType: 'receipt',
+    orderId: 'DG-2026-8492',
+    customer: 'Elena Vance',
+    items: '2x Maple Oat Latte, 1x Dark Roast Espresso',
+    amount: 16.5,
+  },
+  voucher: {
+    artifactType: 'voucher',
+    orderId: 'GIFT-2026-5501',
+    customer: 'Marcus Sterling',
+    items: '$25.00 Artisanal Roaster Gift Voucher',
+    amount: 25.0,
+  },
+};
+
+function buildCanonicalPayload({
+  artifactType,
+  orderId,
+  customer,
+  items,
+  amount,
+  issuedAt,
+}) {
+  return JSON.stringify({
+    issuer: 'The Daily Grind Coffee Co.',
+    type: artifactType,
+    id: orderId.trim(),
+    recipient: customer.trim(),
+    description: items.trim(),
+    amountUSD: Number(amount).toFixed(2),
+    issuedAt: issuedAt || new Date().toISOString(),
+  });
+}
+
+function updateKeyBanner() {
+  const suiteBadge = document.getElementById('active-suite-badge');
+  const keyFormatBadge = document.getElementById('active-key-format');
+  const pubKeySizeBadge = document.getElementById('active-pubkey-size');
+  const pubKeyPreview = document.getElementById('active-pubkey-preview');
+  const pqStatusText = document.getElementById('pq-support-status');
+
+  const pqSupported = supportsPostQuantumSignatures('ML-DSA-65');
+  if (pqStatusText) {
+    pqStatusText.textContent = pqSupported
+      ? 'Browser supports NIST FIPS 204 post-quantum ML-DSA via SubtleCrypto.supports("sign", "ML-DSA-65").'
+      : 'ML-DSA not detected in this runtime; falling back to classical Ed25519 signatures with length-prefixed context framing.';
+  }
+
+  if (!activeSigner) return;
+
+  if (suiteBadge) {
+    suiteBadge.textContent = activeSigner.suite;
+    suiteBadge.dataset.quantum = activeSigner.suite.startsWith('ML-DSA') ? 'true' : 'false';
+  }
+  if (keyFormatBadge) {
+    keyFormatBadge.textContent = activeSigner.keyFormat;
+  }
+  if (pubKeySizeBadge) {
+    pubKeySizeBadge.textContent = `${activeSigner.publicKeyBytes.byteLength} bytes`;
+  }
+  if (pubKeyPreview) {
+    const hex = bytesToHex(activeSigner.publicKeyBytes);
+    pubKeyPreview.textContent = `${hex.slice(0, 32)}…${hex.slice(-16)}`;
+    pubKeyPreview.title = hex;
+  }
+}
+
+async function initKeys(preferredAlgorithm = 'auto') {
+  const statusBanner = document.getElementById('key-generation-status');
+  try {
+    if (statusBanner) {
+      statusBanner.textContent = 'Generating asymmetric signing key pair...';
+    }
+    activeSigner = await generateSigningKeyPair(preferredAlgorithm);
+    updateKeyBanner();
+    if (statusBanner) {
+      statusBanner.textContent = `Active key pair ready (${activeSigner.suite}, exported as '${activeSigner.keyFormat}').`;
+    }
+    await signCurrentForm();
+  } catch (err) {
+    if (statusBanner) {
+      statusBanner.textContent = `Key generation error: ${err.message}`;
+    }
+  }
+}
+
+function populateVerifyFormFromEnvelope(envelope) {
+  const payloadInput = document.getElementById('verify-payload');
+  const contextSelect = document.getElementById('verify-context');
+  const customContextInput = document.getElementById('verify-context-custom');
+  const signatureInput = document.getElementById('verify-signature');
+  const pubKeyInput = document.getElementById('verify-pubkey');
+  const suiteSelect = document.getElementById('verify-suite');
+
+  if (payloadInput) payloadInput.value = envelope.payload;
+  if (contextSelect) {
+    if (
+      envelope.context === 'daily-grind-receipt-v1' ||
+      envelope.context === 'daily-grind-voucher-v1'
+    ) {
+      contextSelect.value = envelope.context;
+      if (customContextInput) customContextInput.value = envelope.context;
+    } else {
+      contextSelect.value = 'custom';
+      if (customContextInput) customContextInput.value = envelope.context;
+    }
+  }
+  if (signatureInput) signatureInput.value = envelope.signatureBase64;
+  if (pubKeyInput) pubKeyInput.value = envelope.publicKeyBase64;
+  if (suiteSelect) suiteSelect.value = envelope.suite;
+}
+
+async function signCurrentForm() {
+  if (!activeSigner) return;
+
+  const artifactType = document.getElementById('artifact-type').value;
+  const orderId = document.getElementById('artifact-id').value;
+  const customer = document.getElementById('artifact-customer').value;
+  const items = document.getElementById('artifact-items').value;
+  const amount = document.getElementById('artifact-amount').value;
+
+  const payload = buildCanonicalPayload({
+    artifactType,
+    orderId,
+    customer,
+    items,
+    amount,
+    issuedAt: '2026-10-27T23:36:52Z',
+  });
+
+  const contextBytes = getContextBytes(artifactType);
+  const contextString = new TextDecoder().decode(contextBytes);
+  const payloadBytes = new TextEncoder().encode(payload);
+
+  const signatureBytes = await signPayload(
+    activeSigner.keyPair.privateKey,
+    payloadBytes,
+    contextBytes,
+  );
+
+  const signatureBase64 = bytesToBase64(signatureBytes);
+  const publicKeyBase64 = bytesToBase64(activeSigner.publicKeyBytes);
+
+  currentEnvelope = {
+    suite: activeSigner.suite,
+    keyFormat: activeSigner.keyFormat,
+    context: contextString,
+    payload,
+    signatureBase64,
+    publicKeyBase64,
+    signatureByteLength: signatureBytes.byteLength,
+    publicKeyByteLength: activeSigner.publicKeyBytes.byteLength,
+  };
+
+  // Update receipt/voucher preview UI
+  const previewType = document.getElementById('signed-preview-type');
+  const previewContext = document.getElementById('signed-preview-context');
+  const previewSuite = document.getElementById('signed-preview-suite');
+  const previewSigSize = document.getElementById('signed-preview-sig-size');
+  const previewPayload = document.getElementById('signed-preview-payload');
+  const previewSignature = document.getElementById('signed-preview-signature');
+
+  if (previewType) {
+    previewType.textContent =
+      artifactType === 'voucher' ? 'Signed Gift Voucher' : 'Signed Order Receipt';
+  }
+  if (previewContext) previewContext.textContent = contextString;
+  if (previewSuite) previewSuite.textContent = activeSigner.suite;
+  if (previewSigSize) previewSigSize.textContent = `${signatureBytes.byteLength} bytes`;
+  if (previewPayload) previewPayload.textContent = payload;
+  if (previewSignature) previewSignature.textContent = signatureBase64;
+
+  populateVerifyFormFromEnvelope(currentEnvelope);
+  await runVerification();
+}
+
+async function runVerification() {
+  const payloadText = document.getElementById('verify-payload').value;
+  const contextSelectVal = document.getElementById('verify-context').value;
+  const customContextVal = document.getElementById('verify-context-custom').value;
+  const contextStr =
+    contextSelectVal === 'custom' ? customContextVal : contextSelectVal;
+  const signatureB64 = document.getElementById('verify-signature').value;
+  const pubKeyB64 = document.getElementById('verify-pubkey').value;
+  const explicitSuite = document.getElementById('verify-suite').value;
+
+  const resultBox = document.getElementById('verification-result');
+  const resultTitle = document.getElementById('verification-result-title');
+  const resultDetail = document.getElementById('verification-result-detail');
+
+  try {
+    const pubKeyBytes = base64ToBytes(pubKeyB64);
+    const sigBytes = base64ToBytes(signatureB64);
+    const payloadBytes = new TextEncoder().encode(payloadText);
+    const contextBytes = new TextEncoder().encode(contextStr);
+
+    const isValid = await verifyPayload(
+      pubKeyBytes,
+      sigBytes,
+      payloadBytes,
+      contextBytes,
+      explicitSuite === 'auto' ? undefined : explicitSuite,
+    );
+
+    resultBox.hidden = false;
+    if (isValid) {
+      resultBox.dataset.state = 'valid';
+      resultTitle.textContent = 'Authentic & Intact Signature Verified';
+      resultDetail.textContent = `Cryptographic verification succeeded under domain context "${contextStr}" (${pubKeyBytes.byteLength}-byte public key, ${sigBytes.byteLength}-byte signature).`;
+    } else {
+      resultBox.dataset.state = 'invalid';
+      resultTitle.textContent = 'Verification Failed — Tampered Payload, Wrong Key, or Context Mismatch';
+      resultDetail.textContent = `crypto.subtle.verify() returned false. Any modification to the receipt/voucher fields, signature bytes, or domain-separation context invalidates authenticity.`;
+    }
+  } catch (err) {
+    resultBox.hidden = false;
+    resultBox.dataset.state = 'invalid';
+    resultTitle.textContent = `Verification Error (${err.name || 'Error'})`;
+    resultDetail.textContent = err.message;
+  }
+}
+
+function applyPreset(type) {
+  const preset = PRESETS[type] || PRESETS.receipt;
+  document.getElementById('artifact-type').value = preset.artifactType;
+  document.getElementById('artifact-id').value = preset.orderId;
+  document.getElementById('artifact-customer').value = preset.customer;
+  document.getElementById('artifact-items').value = preset.items;
+  document.getElementById('artifact-amount').value = preset.amount.toFixed(2);
+}
+
+function setupEventListeners() {
+  const algorithmSelect = document.getElementById('algorithm-select');
+  const regenerateBtn = document.getElementById('regenerate-key-btn');
+  const artifactTypeSelect = document.getElementById('artifact-type');
+  const signForm = document.getElementById('sign-artifact-form');
+  const verifyForm = document.getElementById('verify-artifact-form');
+  const verifyContextSelect = document.getElementById('verify-context');
+  const customContextInput = document.getElementById('verify-context-custom');
+
+  if (regenerateBtn) {
+    regenerateBtn.addEventListener('click', () => {
+      const selected = algorithmSelect ? algorithmSelect.value : 'auto';
+      initKeys(selected);
+    });
+  }
+
+  if (algorithmSelect) {
+    algorithmSelect.addEventListener('change', () => {
+      initKeys(algorithmSelect.value);
+    });
+  }
+
+  if (artifactTypeSelect) {
+    artifactTypeSelect.addEventListener('change', () => {
+      applyPreset(artifactTypeSelect.value);
+      signCurrentForm();
+    });
+  }
+
+  document.querySelectorAll('[data-order-item]').forEach((btn) => {
+    btn.addEventListener('click', (e) => {
+      e.preventDefault();
+      const itemTitle = btn.getAttribute('data-order-item');
+      const itemPrice = btn.getAttribute('data-order-price') || '6.50';
+      const itemType = btn.getAttribute('data-order-type') || 'receipt';
+      document.getElementById('artifact-type').value = itemType;
+      document.getElementById('artifact-id').value =
+        itemType === 'voucher' ? 'GIFT-2026-9012' : 'DG-2026-9012';
+      document.getElementById('artifact-items').value = itemTitle;
+      document.getElementById('artifact-amount').value = Number(itemPrice).toFixed(2);
+      signCurrentForm();
+      document
+        .getElementById('cryptographic-verification')
+        ?.scrollIntoView({ behavior: 'smooth' });
+    });
+  });
+
+  if (signForm) {
+    signForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      signCurrentForm();
+    });
+  }
+
+  if (verifyForm) {
+    verifyForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      runVerification();
+    });
+  }
+
+  if (verifyContextSelect && customContextInput) {
+    verifyContextSelect.addEventListener('change', () => {
+      if (verifyContextSelect.value !== 'custom') {
+        customContextInput.value = verifyContextSelect.value;
+      }
+      runVerification();
+    });
+  }
+
+  // Interactive tamper test buttons
+  const tamperAmountBtn = document.getElementById('tamper-amount-btn');
+  if (tamperAmountBtn) {
+    tamperAmountBtn.addEventListener('click', () => {
+      const payloadInput = document.getElementById('verify-payload');
+      try {
+        const parsed = JSON.parse(payloadInput.value);
+        parsed.amountUSD = '999.00';
+        payloadInput.value = JSON.stringify(parsed);
+      } catch {
+        payloadInput.value += ' ';
+      }
+      runVerification();
+    });
+  }
+
+  const swapContextBtn = document.getElementById('swap-context-btn');
+  if (swapContextBtn) {
+    swapContextBtn.addEventListener('click', () => {
+      const contextSelect = document.getElementById('verify-context');
+      const nextContext =
+        contextSelect.value === 'daily-grind-receipt-v1'
+          ? 'daily-grind-voucher-v1'
+          : 'daily-grind-receipt-v1';
+      contextSelect.value = nextContext;
+      if (customContextInput) customContextInput.value = nextContext;
+      runVerification();
+    });
+  }
+
+  const restoreEnvelopeBtn = document.getElementById('restore-envelope-btn');
+  if (restoreEnvelopeBtn) {
+    restoreEnvelopeBtn.addEventListener('click', () => {
+      if (currentEnvelope) {
+        populateVerifyFormFromEnvelope(currentEnvelope);
+        runVerification();
+      }
+    });
+  }
+}
+
+document.addEventListener('DOMContentLoaded', () => {
+  setupEventListeners();
+  initKeys('auto');
+});
diff --git a/crypto-signing.js b/crypto-signing.js
new file mode 100644
index 0000000..3934b77
--- /dev/null
+++ b/crypto-signing.js
@@ -0,0 +1,229 @@
+const ML_DSA_PUBLIC_KEY_ALGORITHMS = {
+  1312: 'ML-DSA-44',
+  1952: 'ML-DSA-65',
+  2592: 'ML-DSA-87',
+};
+
+const CONTEXT_LABELS = {
+  receipt: 'daily-grind-receipt-v1',
+  voucher: 'daily-grind-voucher-v1',
+};
+
+export function getContextBytes(artifactType) {
+  const label = CONTEXT_LABELS[artifactType] || String(artifactType || 'daily-grind-receipt-v1');
+  return new TextEncoder().encode(label);
+}
+
+export function supportsPostQuantumSignatures(algorithm = 'ML-DSA-65') {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('sign', algorithm)
+  );
+}
+
+export function bytesToBase64(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toBase64 === 'function') {
+    return u8.toBase64();
+  }
+  let binary = '';
+  for (let i = 0; i < u8.byteLength; i++) {
+    binary += String.fromCharCode(u8[i]);
+  }
+  return btoa(binary);
+}
+
+export function base64ToBytes(b64) {
+  const clean = String(b64).trim();
+  if (typeof Uint8Array.fromBase64 === 'function') {
+    return Uint8Array.fromBase64(clean);
+  }
+  const binary = atob(clean);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+export function bytesToHex(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  if (typeof u8.toHex === 'function') {
+    return u8.toHex();
+  }
+  let hex = '';
+  for (let i = 0; i < u8.byteLength; i++) {
+    hex += u8[i].toString(16).padStart(2, '0');
+  }
+  return hex;
+}
+
+export async function generateSigningKeyPair(preferredAlgorithm = 'ML-DSA-65') {
+  const wantsPostQuantum =
+    preferredAlgorithm === 'auto' || preferredAlgorithm.startsWith('ML-DSA');
+  const mlDsaAlgo = preferredAlgorithm.startsWith('ML-DSA')
+    ? preferredAlgorithm
+    : 'ML-DSA-65';
+
+  if (wantsPostQuantum && supportsPostQuantumSignatures(mlDsaAlgo)) {
+    const keyPair = await crypto.subtle.generateKey(
+      mlDsaAlgo,
+      false,
+      ['sign', 'verify'],
+    );
+    const derivedPublicKey =
+      typeof crypto.subtle.getPublicKey === 'function'
+        ? await crypto.subtle.getPublicKey(keyPair.privateKey, ['verify'])
+        : keyPair.publicKey;
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', derivedPublicKey),
+    );
+    return {
+      suite: mlDsaAlgo,
+      keyFormat: 'raw-public',
+      keyPair,
+      publicKeyBytes,
+    };
+  }
+
+  // Classical fallback: Ed25519
+  const keyPair = await crypto.subtle.generateKey(
+    'Ed25519',
+    false,
+    ['sign', 'verify'],
+  );
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', keyPair.publicKey),
+  );
+  return {
+    suite: 'Ed25519',
+    keyFormat: 'raw',
+    keyPair,
+    publicKeyBytes,
+  };
+}
+
+export function frameFallbackInput(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const framed = new Uint8Array(
+    1 + contextBytes.byteLength + payloadBytes.byteLength,
+  );
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+export async function signPayload(
+  privateKey,
+  payloadBytes,
+  contextBytes = new Uint8Array(0),
+) {
+  const dataBytes =
+    typeof payloadBytes === 'string'
+      ? new TextEncoder().encode(payloadBytes)
+      : payloadBytes instanceof Uint8Array
+        ? payloadBytes
+        : new Uint8Array(payloadBytes);
+
+  const ctxBytes =
+    typeof contextBytes === 'string'
+      ? new TextEncoder().encode(contextBytes)
+      : contextBytes instanceof Uint8Array
+        ? contextBytes
+        : new Uint8Array(contextBytes);
+
+  if (ctxBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+
+  if (privateKey.algorithm.name.startsWith('ML-DSA')) {
+    const sig = await crypto.subtle.sign(
+      {
+        name: privateKey.algorithm.name,
+        context: ctxBytes,
+      },
+      privateKey,
+      dataBytes,
+    );
+    return new Uint8Array(sig);
+  }
+
+  const framed = frameFallbackInput(dataBytes, ctxBytes);
+  const sig = await crypto.subtle.sign('Ed25519', privateKey, framed);
+  return new Uint8Array(sig);
+}
+
+export async function importVerifierPublicKey(publicKeyOrBytes, explicitSuite) {
+  if (publicKeyOrBytes instanceof CryptoKey) {
+    return publicKeyOrBytes;
+  }
+  const bytes =
+    publicKeyOrBytes instanceof Uint8Array
+      ? publicKeyOrBytes
+      : new Uint8Array(publicKeyOrBytes);
+  const mlDsaName =
+    (explicitSuite && explicitSuite.startsWith('ML-DSA') && explicitSuite) ||
+    ML_DSA_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+
+  if (mlDsaName) {
+    return crypto.subtle.importKey(
+      'raw-public',
+      bytes,
+      mlDsaName,
+      true,
+      ['verify'],
+    );
+  }
+  return crypto.subtle.importKey('raw', bytes, 'Ed25519', true, ['verify']);
+}
+
+export async function verifyPayload(
+  publicKeyOrBytes,
+  signatureBytes,
+  payloadBytes,
+  contextBytes = new Uint8Array(0),
+  explicitSuite = undefined,
+) {
+  const sigBytes =
+    signatureBytes instanceof Uint8Array
+      ? signatureBytes
+      : new Uint8Array(signatureBytes);
+
+  const dataBytes =
+    typeof payloadBytes === 'string'
+      ? new TextEncoder().encode(payloadBytes)
+      : payloadBytes instanceof Uint8Array
+        ? payloadBytes
+        : new Uint8Array(payloadBytes);
+
+  const ctxBytes =
+    typeof contextBytes === 'string'
+      ? new TextEncoder().encode(contextBytes)
+      : contextBytes instanceof Uint8Array
+        ? contextBytes
+        : new Uint8Array(contextBytes);
+
+  if (ctxBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+
+  const publicKey = await importVerifierPublicKey(publicKeyOrBytes, explicitSuite);
+
+  if (publicKey.algorithm.name.startsWith('ML-DSA')) {
+    return crypto.subtle.verify(
+      {
+        name: publicKey.algorithm.name,
+        context: ctxBytes,
+      },
+      publicKey,
+      sigBytes,
+      dataBytes,
+    );
+  }
+
+  const framed = frameFallbackInput(dataBytes, ctxBytes);
+  return crypto.subtle.verify('Ed25519', publicKey, sigBytes, framed);
+}
