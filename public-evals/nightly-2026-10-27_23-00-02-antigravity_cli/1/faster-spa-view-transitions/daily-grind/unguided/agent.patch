+      /**
+       * Returns the cached DOM root for a given route key, creating and mounting it
+       * only on first visit so subsequent navigations reuse the exact DOM tree and state.
+       */
+      function getOrCreateView(routeKey) {
+        if (viewCache.has(routeKey)) {
+          return viewCache.get(routeKey);
+        }
+        const builder = VIEW_BUILDERS[routeKey];
+        if (!builder) {
+          return viewCache.get('home');
+        }
+        const viewEl = builder();
+        viewEl.hidden = true;
+        outlet.appendChild(viewEl);
+        viewCache.set(routeKey, viewEl);
+        return viewEl;
+      }
+
+      function resolveRouteKey(pathname) {
+        if (!pathname) return 'home';
+        const clean = pathname.length > 1 ? pathname.replace(/\/+$/, '') : pathname;
+        if (ROUTES[clean]) {
+          return ROUTES[clean];
+        }
+        if (clean.startsWith('/menu')) return 'menu';
+        if (clean.startsWith('/locations')) return 'locations';
+        if (clean.startsWith('/rewards')) return 'rewards';
+        if (clean.startsWith('/account')) return 'account';
+        return 'home';
+      }
+
+      let activeRouteKey = 'home';
+
+      function activateView(routeKey, options = {}) {
+        const targetKey = VIEW_BUILDERS[routeKey] || routeKey === 'home' ? routeKey : 'home';
+        const targetView = getOrCreateView(targetKey);
+
+        // Hide all cached views without detaching/destroying them from the DOM
+        viewCache.forEach((el, key) => {
+          const isMatch = key === targetKey;
+          el.hidden = !isMatch;
+          el.setAttribute('aria-hidden', isMatch ? 'false' : 'true');
+        });
+
+        activeRouteKey = targetKey;
+
+        // Update nav active link styling
+        document.querySelectorAll('nav a[data-route]').forEach(link => {
+          const isCurrent = link.dataset.route === targetKey;
+          link.classList.toggle('active', isCurrent);
+          if (isCurrent) {
+            link.setAttribute('aria-current', 'page');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        // Update document title
+        if (ROUTE_TITLES[targetKey]) {
+          document.title = ROUTE_TITLES[targetKey];
+        }
+
+        // Update browser URL history if requested
+        if (options.pushState) {
+          const targetPath = targetKey === 'home' ? '/' : `/${targetKey}`;
+          if (window.location.pathname !== targetPath) {
+            window.history.pushState({ route: targetKey }, '', targetPath);
+          }
+        }
+
+        return targetView;
+      }
+
+      // Intercept clicks on SPA navigation links
+      document.addEventListener('click', (event) => {
+        const anchor = event.target.closest('a[data-spa-link], nav a');
+        if (!anchor) return;
+
+        // Respect modifier keys / middle-click / external links
+        if (
+          event.defaultPrevented ||
+          event.button !== 0 ||
+          event.metaKey ||
+          event.ctrlKey ||
+          event.shiftKey ||
+          event.altKey ||
+          anchor.target === '_blank'
+        ) {
+          return;
+        }
+
+        const href = anchor.getAttribute('href');
+        if (!href || href === '/logout') {
+          return;
+        }
+
+        const routeKey = anchor.dataset.route || resolveRouteKey(href);
+        if (routeKey && (routeKey === 'home' || VIEW_BUILDERS[routeKey])) {
+          event.preventDefault();
+          activateView(routeKey, { pushState: true });
+        }
+      });
+
+      // Handle browser Back / Forward navigation
+      window.addEventListener('popstate', (event) => {
+        const stateRoute = event.state && event.state.route;
+        const routeKey = stateRoute || resolveRouteKey(window.location.pathname);
+        activateView(routeKey, { pushState: false });
+      });
+
+      // Initialize view based on current URL path or hash
+      const initialPath = window.location.hash
+        ? '/' + window.location.hash.replace(/^#\/?/, '')
+        : window.location.pathname;
+      const initialRoute = resolveRouteKey(initialPath);
+      activateView(initialRoute, { pushState: false });
+
+      // Expose SPA controller for programmatic access if needed
+      window.DailyGrindSPA = {
+        navigate: (routeKey) => activateView(routeKey, { pushState: true }),
+        getCachedViews: () => Array.from(viewCache.keys()),
+        getViewElement: (routeKey) => viewCache.get(routeKey) || null
+      };
+    })();
+  </script>
