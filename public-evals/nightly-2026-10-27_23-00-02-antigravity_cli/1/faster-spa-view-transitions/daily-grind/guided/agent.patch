+  <script>
+    const ROUTE_TO_VIEW = {
+      '/': 'view-home',
+      '/menu': 'view-menu',
+      '/locations': 'view-locations',
+      '/rewards': 'view-rewards',
+      '/account': 'view-account'
+    };
+
+    const VIEW_TO_ROUTE = {
+      'view-home': '/',
+      'view-menu': '/menu',
+      'view-locations': '/locations',
+      'view-rewards': '/rewards',
+      'view-account': '/account'
+    };
+
+    function switchToView(viewId, options = { pushHistory: true, manageFocus: true }) {
+      const targetView = document.getElementById(viewId);
+      if (!targetView) return;
+
+      // Hide all views while preserving their DOM & rendering state
+      document.querySelectorAll('.spa-view').forEach(view => {
+        view.classList.add('inactive');
+        view.setAttribute('aria-hidden', 'true');
+      });
+
+      // Show the target view
+      targetView.classList.remove('inactive');
+      targetView.setAttribute('aria-hidden', 'false');
+
+      // Update active navigation link styling
+      document.querySelectorAll('nav a[data-spa-link]').forEach(link => {
+        if (link.getAttribute('data-spa-link') === viewId && !link.classList.contains('logo')) {
+          link.setAttribute('aria-current', 'page');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+
+      // Sync URL in browser history if applicable
+      const route = VIEW_TO_ROUTE[viewId];
+      if (options.pushHistory && route && window.location.pathname !== route) {
+        try {
+          window.history.pushState({ viewId }, '', route);
+        } catch (err) {
+          // Ignore pushState restrictions in sandboxed/file contexts
+        }
+      }
+
+      // MANDATORY: Move focus to the new view to ensure a logical tab-order
+      if (options.manageFocus) {
+        targetView.focus();
+      }
+    }
+
+    // Intercept SPA navigation clicks
+    document.addEventListener('click', (event) => {
+      const link = event.target.closest('a[data-spa-link]');
+      if (!link) return;
+
+      // Allow modified clicks (new tab, etc.) to behave normally
+      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
+        return;
+      }
+
+      event.preventDefault();
+      const viewId = link.getAttribute('data-spa-link');
+      switchToView(viewId, { pushHistory: true, manageFocus: true });
+    });
+
+    // Support browser Back/Forward navigation
+    window.addEventListener('popstate', (event) => {
+      const stateViewId = event.state && event.state.viewId;
+      const routeViewId = ROUTE_TO_VIEW[window.location.pathname] || 'view-home';
+      switchToView(stateViewId || routeViewId, { pushHistory: false, manageFocus: true });
+    });
+
+    // Initialize view based on current pathname if deep-linked
+    const initialViewId = ROUTE_TO_VIEW[window.location.pathname] || 'view-home';
+    if (initialViewId !== 'view-home') {
+      switchToView(initialViewId, { pushHistory: false, manageFocus: false });
+    }
+
+    // Interactive state within views (preserved across navigations without re-rendering)
+    // 1. Menu Category Filtering & Add to Order
+    document.querySelectorAll('.filter-bar button[data-category]').forEach(btn => {
+      btn.addEventListener('click', () => {
+        const category = btn.getAttribute('data-category');
+        document.querySelectorAll('.filter-bar button[data-category]').forEach(b => {
+          b.classList.toggle('active', b === btn);
+        });
+        document.querySelectorAll('#menu-grid .card').forEach(card => {
+          const match = category === 'all' || card.getAttribute('data-category') === category;
+          card.style.display = match ? '' : 'none';
+        });
+      });
+    });
+
+    document.querySelectorAll('.add-to-order').forEach(btn => {
+      btn.addEventListener('click', () => {
+        const currentCount = Number(btn.getAttribute('data-count') || 0) + 1;
+        btn.setAttribute('data-count', String(currentCount));
+        btn.textContent = `Added (${currentCount})`;
+      });
+    });
+
+    // 2. Locations Search & Preferred Store Selection
+    const locationSearch = document.getElementById('location-search');
+    if (locationSearch) {
+      locationSearch.addEventListener('input', () => {
+        const query = locationSearch.value.trim().toLowerCase();
+        document.querySelectorAll('#locations-grid .card').forEach(card => {
+          const text = (card.textContent + ' ' + (card.getAttribute('data-location') || '')).toLowerCase();
+          card.style.display = text.includes(query) ? '' : 'none';
+        });
+      });
+    }
+
+    document.querySelectorAll('.select-store-btn').forEach(btn => {
+      btn.addEventListener('click', () => {
+        document.querySelectorAll('.select-store-btn').forEach(b => {
+          b.textContent = b === btn ? 'Preferred Store ✓' : 'Set as Preferred Store';
+        });
+      });
+    });
+
+    // 3. Rewards Redemption
+    let currentBeans = 360;
+    const pointsEl = document.getElementById('rewards-points');
+    const progressEl = document.getElementById('rewards-progress');
+    const statusTextEl = document.getElementById('rewards-status-text');
+
+    document.querySelectorAll('.redeem-btn').forEach(btn => {
+      btn.addEventListener('click', () => {
+        const cost = Number(btn.getAttribute('data-cost') || 0);
+        if (currentBeans >= cost) {
+          currentBeans -= cost;
+          pointsEl.textContent = String(currentBeans);
+          const pct = Math.min(100, Math.round((currentBeans / 500) * 100));
+          progressEl.style.width = `${pct}%`;
+          statusTextEl.textContent = `Redeemed ${cost} Beans! ${Math.max(0, 500 - currentBeans)} Beans until your next 500-Bean reward.`;
+        } else {
+          statusTextEl.textContent = `Need ${cost - currentBeans} more Beans to redeem that reward.`;
+        }
+      });
+    });
+
+    // 4. My Account Form State
+    const accountForm = document.getElementById('account-form');
+    const accountStatus = document.getElementById('account-status');
+    if (accountForm) {
+      accountForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const name = document.getElementById('account-name').value;
+        accountStatus.textContent = `Preferences saved for ${name}.`;
+      });
+    }
+  </script>
+
 </body>
 
 </html>
