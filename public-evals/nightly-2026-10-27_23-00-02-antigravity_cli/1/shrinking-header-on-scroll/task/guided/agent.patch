@@ -206,7 +249,44 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    // Fallback for browsers that don't support scroll-driven animations
+    if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)')) {
+      const nav = document.querySelector('nav');
+      const logo = document.querySelector('.logo');
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const initialHeight = 96;
+      const finalHeight = 48;
+      const scrollDistance = initialHeight - finalHeight;
+
+      const updateNav = () => {
+        if (prefersReducedMotion.matches) {
+          nav.style.height = `${finalHeight}px`;
+          logo.style.transform = 'scale(0.85)';
+          return;
+        }
+
+        const scrollY = window.scrollY;
+        const scrollPercent = Math.min(1, Math.max(0, scrollY / scrollDistance));
+        const newHeight = initialHeight - (initialHeight - finalHeight) * scrollPercent;
+        const logoScale = 1 - (1 - 0.85) * scrollPercent;
+
+        nav.style.height = `${newHeight}px`;
+        nav.style.boxShadow = scrollPercent > 0
+          ? `0 2px 10px rgba(0, 0, 0, ${0.25 * scrollPercent})`
+          : 'none';
+        logo.style.transformOrigin = 'left center';
+        logo.style.transform = `scale(${logoScale})`;
+      };
+
+      window.addEventListener('scroll', updateNav, { passive: true });
+      prefersReducedMotion.addEventListener('change', updateNav);
+      updateNav();
+    }
+  </script>
+
 </body>
 
