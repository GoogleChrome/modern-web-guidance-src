+  <script>
+    (function () {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const TARGET_TIMEZONES = [
+        { label: 'New York', tz: 'America/New_York' },
+        { label: 'London', tz: 'Europe/London' },
+        { label: 'Tokyo', tz: 'Asia/Tokyo' },
+        { label: 'UTC', tz: 'UTC' }
+      ];
+
+      function formatTime12Hour(zdt) {
+        const hour24 = zdt.hour;
+        const minute = String(zdt.minute).padStart(2, '0');
+        const period = hour24 >= 12 ? 'PM' : 'AM';
+        const hour12 = hour24 % 12 || 12;
+        return `${hour12}:${minute} ${period}`;
+      }
+
+      function formatDateReadable(zdt) {
+        return zdt.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+      }
+
+      function updateSchedule() {
+        const dateVal = dateInput.value;
+        const timeVal = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateVal || !timeVal || !hostTz) {
+          return;
+        }
+
+        if (typeof Temporal === 'undefined') {
+          hostWarning.textContent = 'Notice: Native Temporal API is required to calculate timezone-aware schedules.';
+          hostWarning.classList.add('visible');
+          return;
+        }
+
+        try {
+          const plainDate = Temporal.PlainDate.from(dateVal);
+          const plainTime = Temporal.PlainTime.from(timeVal);
+          const plainDateTime = plainDate.toPlainDateTime(plainTime);
+
+          // Probe with 'earlier' and 'later' disambiguation to detect DST gaps or overlaps immutably
+          const earlierZdt = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'earlier' });
+          const laterZdt = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'later' });
+          // Resolve using standard 'compatible' disambiguation ('later' for gaps, 'earlier' for overlaps)
+          const resolvedHostZdt = plainDateTime.toZonedDateTime(hostTz, { disambiguation: 'compatible' });
+
+          if (!earlierZdt.equals(laterZdt)) {
+            const resolvedPlain = resolvedHostZdt.toPlainDateTime();
+            const isGap = !resolvedPlain.equals(plainDateTime);
+
+            if (isGap) {
+              hostWarning.textContent =
+                `Daylight Saving Time Gap Detected: The selected local time (${timeVal}) does not exist in ${hostTz} because clocks spring forward during a DST transition. Using immutable Temporal disambiguation ('compatible'), the time was resolved forward to ${formatTime12Hour(resolvedHostZdt)} (${resolvedHostZdt.offset}).`;
+            } else {
+              hostWarning.textContent =
+                `Daylight Saving Time Overlap Detected: The selected local time (${timeVal}) occurs twice in ${hostTz} because clocks fall back during a DST transition (ambiguous between ${earlierZdt.offset} and ${laterZdt.offset}). Using immutable Temporal disambiguation ('compatible'), the time was resolved to the first occurrence at ${formatTime12Hour(resolvedHostZdt)} (offset ${resolvedHostZdt.offset}).`;
+            }
+            hostWarning.classList.add('visible');
+          } else {
+            hostWarning.textContent = '';
+            hostWarning.classList.remove('visible');
+          }
+
+          grid.innerHTML = '';
+
+          TARGET_TIMEZONES.forEach((target) => {
+            // Convert immutably to target timezone using built-in withTimeZone method
+            const targetZdt = resolvedHostZdt.withTimeZone(target.tz);
+            const formattedTime = formatTime12Hour(targetZdt);
+            const formattedDate = formatDateReadable(targetZdt);
+
+            const card = document.createElement('div');
+            card.className = 'card tz-card' + (target.tz === hostTz ? ' is-host' : '');
+            card.dataset.timezone = target.tz;
+
+            const regionEl = document.createElement('h3');
+            regionEl.className = 'tz-region';
+            regionEl.textContent = target.label;
+
+            const idEl = document.createElement('div');
+            idEl.className = 'tz-id';
+            idEl.textContent = target.tz + (target.tz === hostTz ? ' (Host)' : '');
+
+            const timeEl = document.createElement('div');
+            timeEl.className = 'tz-time';
+            timeEl.textContent = formattedTime;
+
+            const dateEl = document.createElement('div');
+            dateEl.className = 'tz-date';
+            dateEl.textContent = formattedDate;
+
+            const offsetEl = document.createElement('span');
+            offsetEl.className = 'tz-offset';
+            offsetEl.textContent = `UTC${targetZdt.offset === '+00:00' ? '' : targetZdt.offset}`;
+
+            card.appendChild(regionEl);
+            card.appendChild(idEl);
+            card.appendChild(timeEl);
+            card.appendChild(dateEl);
+            card.appendChild(offsetEl);
+
+            grid.appendChild(card);
+          });
+        } catch (err) {
+          hostWarning.textContent = `Unable to compute schedule: ${err.message}`;
+          hostWarning.classList.add('visible');
+        }
+      }
+
+      dateInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+
+      updateSchedule();
+    })();
+  </script>
 </body>
 
