+  <script>
+    const TARGET_ZONES = [
+      { label: 'New York', timeZone: 'America/New_York' },
+      { label: 'London', timeZone: 'Europe/London' },
+      { label: 'Tokyo', timeZone: 'Asia/Tokyo' },
+      { label: 'UTC', timeZone: 'UTC' }
+    ];
+
+    function updateSchedule() {
+      if (typeof Temporal === 'undefined') return;
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const dateVal = dateInput.value;
+      const timeVal = timeInput.value;
+      const hostTz = hostTzSelect.value;
+
+      if (!dateVal || !timeVal || !hostTz) return;
+
+      const inputStr = `${dateVal}T${timeVal}[${hostTz}]`;
+
+      // Detect DST transition gap or overlap using disambiguation: 'reject'
+      let hasConflict = false;
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (err) {
+        if (err instanceof RangeError) {
+          hasConflict = true;
+        }
+      }
+
+      // Resolve the host time safely as an immutable ZonedDateTime using 'compatible'
+      const hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+
+      if (hasConflict) {
+        const earlierTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'earlier' });
+        const laterTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'later' });
+        const resolvedFormatted = hostTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+        const requestedWallTime = `${dateVal}T${timeVal}`;
+        const resolvedWallTime = `${hostTime.toPlainDate().toString()}T${hostTime.toPlainTime().toString().slice(0, 5)}`;
+
+        if (requestedWallTime !== resolvedWallTime) {
+          hostWarning.textContent = `Daylight Saving Time gap detected: ${timeVal} on ${dateVal} does not exist in ${hostTz} because clocks spring forward. Using compatible disambiguation, the time was automatically adjusted forward to ${resolvedFormatted} (${hostTime.offset}).`;
+        } else if (!earlierTime.equals(laterTime)) {
+          hostWarning.textContent = `Daylight Saving Time overlap detected: ${timeVal} on ${dateVal} occurs twice in ${hostTz} as clocks fall back. Using compatible disambiguation, the earlier occurrence at ${resolvedFormatted} (${hostTime.offset}) was selected.`;
+        } else {
+          hostWarning.textContent = `Daylight Saving Time transition conflict detected in ${hostTz}: resolved to ${resolvedFormatted} (${hostTime.offset}) using compatible disambiguation.`;
+        }
+        hostWarning.classList.add('visible');
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.classList.remove('visible');
+      }
+
+      // Render timezone cards using immutable .withTimeZone() conversions
+      grid.innerHTML = '';
+      for (const target of TARGET_ZONES) {
+        const targetZoned = hostTime.withTimeZone(target.timeZone);
+        const formattedTime = targetZoned.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+        const formattedDate = targetZoned.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+
+        const card = document.createElement('div');
+        card.className = 'card tz-card' + (target.timeZone === hostTz ? ' host-active' : '');
+        card.dataset.timezone = target.timeZone;
+
+        const cityEl = document.createElement('h3');
+        cityEl.className = 'tz-city';
+        cityEl.textContent = target.label;
+
+        const ianaEl = document.createElement('div');
+        ianaEl.className = 'tz-iana';
+        ianaEl.textContent = `${target.timeZone} (${targetZoned.offset})`;
+
+        const timeEl = document.createElement('div');
+        timeEl.className = 'tz-time';
+        timeEl.textContent = formattedTime;
+
+        const dateEl = document.createElement('div');
+        dateEl.className = 'tz-date';
+        dateEl.textContent = formattedDate;
+
+        card.append(cityEl, ianaEl, timeEl, dateEl);
+        grid.appendChild(card);
+      }
+    }
+
+    function initializeCoordinator() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+
+      for (const el of [dateInput, timeInput, hostTzSelect]) {
+        el.addEventListener('change', updateSchedule);
+        el.addEventListener('input', updateSchedule);
+      }
+
+      updateSchedule();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeCoordinator();
+    })();
+  </script>
