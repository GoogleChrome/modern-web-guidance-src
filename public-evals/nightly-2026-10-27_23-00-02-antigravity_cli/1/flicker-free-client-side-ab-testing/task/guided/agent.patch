diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,372 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>PulseFlow — Workflow Automation Built for Speed</title>
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+
+  <!--
+    Load the A/B testing SDK with both `async` and `blocking="render"`.
+    - `async`: Prevents parser-blocking so the DOM is built in parallel.
+    - `blocking="render"`: Holds rendering until the script executes,
+      ensuring experiment changes are applied before first paint.
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+  ></script>
+
+  <script>
+    // Feature-detect support for `blocking="render"` and apply a lightweight
+    // anti-flicker fallback only in browsers that do not support it (e.g., Firefox).
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      document.documentElement.classList.add('ab-loading');
+
+      // Reveal the page if the experiment script takes too long or fails to load.
+      setTimeout(() => {
+        document.documentElement.classList.remove('ab-loading');
+      }, 4000);
+    }
+
+    // Callback for the experiment SDK (or fallback listener) to reveal the page
+    // once the experiment variant has been applied.
+    window.onExperimentReady = function onExperimentReady() {
+      document.documentElement.classList.remove('ab-loading');
+    };
+  </script>
+
+  <style>
+    @layer base, theme, components, utilities;
+
+    @layer theme {
+      :root {
+        color-scheme: light dark;
+        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
+        --surface-bg: light-dark(#f8fafc, #090d16);
+        --surface-card: light-dark(#ffffff, #111827);
+        --surface-border: light-dark(#e2e8f0, #1f2937);
+        --text-primary: light-dark(#0f172a, #f8fafc);
+        --text-secondary: light-dark(#475569, #94a3b8);
+        --accent-primary: light-dark(#2563eb, #3b82f6);
+        --accent-hover: light-dark(#1d4ed8, #60a5fa);
+        --accent-contrast: #ffffff;
+        --badge-bg: light-dark(#dbeafe, #1e3a8a);
+        --badge-text: light-dark(#1e40af, #bfdbfe);
+        --radius-md: 0.75rem;
+        --radius-pill: 9999px;
+        --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
+      }
+
+      /* Variant B theme overrides when `[data-variant="b"]` is set on <html> by the SDK */
+      :root[data-variant="b"] {
+        --accent-primary: light-dark(#059669, #10b981);
+        --accent-hover: light-dark(#047857, #34d399);
+        --badge-bg: light-dark(#d1fae5, #064e3b);
+        --badge-text: light-dark(#065f46, #a7f3d0);
+      }
+    }
+
+    @layer base {
+      body {
+        margin: 0;
+        font-family: var(--font-sans);
+        background-color: var(--surface-bg);
+        color: var(--text-primary);
+        line-height: 1.6;
+        -webkit-font-smoothing: antialiased;
+      }
+
+      h1, h2, h3, p {
+        margin-block: 0;
+      }
+
+      img {
+        max-inline-size: 100%;
+        block-size: auto;
+        display: block;
+      }
+    }
+
+    @layer components {
+      .site-header {
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        max-inline-size: 75rem;
+        margin-inline: auto;
+        padding-block: 1.25rem;
+        padding-inline: clamp(1.25rem, 4vw, 2.5rem);
+      }
+
+      .brand-logo {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.625rem;
+        font-weight: 700;
+        font-size: 1.25rem;
+        color: var(--text-primary);
+        text-decoration: none;
+        letter-spacing: -0.02em;
+      }
+
+      .brand-icon {
+        inline-size: 2rem;
+        block-size: 2rem;
+        border-radius: 0.5rem;
+        background: var(--accent-primary);
+        color: var(--accent-contrast);
+        display: grid;
+        place-items: center;
+      }
+
+      .nav-list {
+        display: flex;
+        align-items: center;
+        gap: 2rem;
+        list-style: none;
+        margin: 0;
+        padding: 0;
+      }
+
+      .nav-link {
+        color: var(--text-secondary);
+        text-decoration: none;
+        font-size: 0.9375rem;
+        font-weight: 500;
+        transition: color 0.15s ease;
+
+        &:hover {
+          color: var(--text-primary);
+        }
+      }
+
+      .hero {
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
+        align-items: center;
+        gap: clamp(2rem, 5vw, 4rem);
+        max-inline-size: 75rem;
+        margin-inline: auto;
+        padding-block: clamp(3rem, 8vh, 6rem);
+        padding-inline: clamp(1.25rem, 4vw, 2.5rem);
+      }
+
+      .hero-content {
+        display: flex;
+        flex-direction: column;
+        align-items: flex-start;
+        gap: 1.5rem;
+      }
+
+      .eyebrow-badge {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        padding-block: 0.375rem;
+        padding-inline: 0.875rem;
+        border-radius: var(--radius-pill);
+        background-color: var(--badge-bg);
+        color: var(--badge-text);
+        font-size: 0.875rem;
+        font-weight: 600;
+      }
+
+      .hero-title {
+        font-size: clamp(2.25rem, 4.5vw + 1rem, 3.75rem);
+        font-weight: 800;
+        line-height: 1.1;
+        letter-spacing: -0.03em;
+        text-wrap: balance;
+      }
+
+      .hero-subtitle {
+        font-size: clamp(1.0625rem, 1.2vw + 0.75rem, 1.25rem);
+        color: var(--text-secondary);
+        max-inline-size: 54ch;
+        text-wrap: pretty;
+      }
+
+      .hero-actions {
+        display: flex;
+        flex-wrap: wrap;
+        align-items: center;
+        gap: 1rem;
+        margin-block-start: 0.5rem;
+      }
+
+      .cta-button {
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        gap: 0.625rem;
+        padding-block: 0.875rem;
+        padding-inline: 1.75rem;
+        border: none;
+        border-radius: var(--radius-md);
+        background-color: var(--accent-primary);
+        color: var(--accent-contrast);
+        font-family: inherit;
+        font-size: 1rem;
+        font-weight: 600;
+        cursor: pointer;
+        box-shadow: var(--shadow-lg);
+        transition: background-color 0.15s ease, transform 0.15s ease;
+
+        &:hover:not(:disabled) {
+          background-color: var(--accent-hover);
+          transform: translateY(-1px);
+        }
+
+        &:focus-visible {
+          outline: 3px solid var(--accent-primary);
+          outline-offset: 3px;
+        }
+      }
+
+      .secondary-link {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        padding-block: 0.875rem;
+        padding-inline: 1.25rem;
+        border-radius: var(--radius-md);
+        border: 1px solid var(--surface-border);
+        background-color: var(--surface-card);
+        color: var(--text-primary);
+        font-size: 1rem;
+        font-weight: 600;
+        text-decoration: none;
+        transition: border-color 0.15s ease;
+
+        &:hover {
+          border-color: var(--text-secondary);
+        }
+      }
+
+      .hero-trust {
+        display: flex;
+        align-items: center;
+        gap: 0.75rem;
+        font-size: 0.875rem;
+        color: var(--text-secondary);
+        margin-block-start: 0.5rem;
+      }
+
+      .hero-media {
+        position: relative;
+        border-radius: 1rem;
+        overflow: hidden;
+        border: 1px solid var(--surface-border);
+        background-color: var(--surface-card);
+        box-shadow: var(--shadow-lg);
+      }
+
+      .hero-image {
+        inline-size: 100%;
+        aspect-ratio: 4 / 3;
+        object-fit: cover;
+      }
+
+      .cta-feedback {
+        font-size: 0.9375rem;
+        font-weight: 500;
+        color: var(--accent-primary);
+        min-block-size: 1.5rem;
+      }
+    }
+
+    @layer utilities {
+      /*
+        Anti-flicker fallback class applied only when `blocking="render"`
+        is unsupported by the browser.
+      */
+      .ab-loading {
+        opacity: 0 !important;
+      }
+    }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <a href="/" class="brand-logo">
+      <span class="brand-icon" aria-hidden="true">
+        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
+        </svg>
+      </span>
+      <span>PulseFlow</span>
+    </a>
+    <nav aria-label="Primary">
+      <ul class="nav-list">
+        <li><a href="#features" class="nav-link">Features</a></li>
+        <li><a href="#benchmarks" class="nav-link">Benchmarks</a></li>
+        <li><a href="#pricing" class="nav-link">Pricing</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" data-experiment-target="hero">
+      <div class="hero-content">
+        <span class="eyebrow-badge" data-experiment-slot="badge">
+          New: Real-Time Edge Orchestration 2.0
+        </span>
+        <h1 class="hero-title" data-experiment-slot="headline">
+          Ship resilient workflows at the speed of thought
+        </h1>
+        <p class="hero-subtitle" data-experiment-slot="subheadline">
+          Automate complex CI/CD pipelines, background jobs, and multi-region data syncs with zero infrastructure overhead and sub-millisecond cold starts.
+        </p>
+        <div class="hero-actions">
+          <button
+            type="button"
+            id="hero-cta"
+            class="cta-button"
+            data-experiment-slot="cta"
+          >
+            <span>Start Building Free</span>
+            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+              <line x1="5" y1="12" x2="19" y2="12"></line>
+              <polyline points="12 5 19 12 12 19"></polyline>
+            </svg>
+          </button>
+          <a href="#demo" class="secondary-link">
+            View Live Architecture
+          </a>
+        </div>
+        <p id="cta-status" class="cta-feedback" role="status" aria-live="polite"></p>
+        <div class="hero-trust">
+          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
+          </svg>
+          <span>SOC2 Type II Certified · No credit card required</span>
+        </div>
+      </div>
+
+      <div class="hero-media">
+        <img
+          src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80"
+          alt="Analytics dashboard displaying real-time workflow metrics and throughput charts"
+          width="1200"
+          height="900"
+          fetchpriority="high"
+          class="hero-image"
+          data-experiment-slot="hero-image"
+        >
+      </div>
+    </section>
+  </main>
+
+  <script type="module">
+    const ctaButton = document.getElementById('hero-cta');
+    const ctaStatus = document.getElementById('cta-status');
+
+    ctaButton?.addEventListener('click', () => {
+      const variant = document.documentElement.dataset.variant || 'control';
+      ctaStatus.textContent = `Workspace provisioning started (Variant: ${variant}).`;
+    });
+  </script>
+</body>
+</html>
