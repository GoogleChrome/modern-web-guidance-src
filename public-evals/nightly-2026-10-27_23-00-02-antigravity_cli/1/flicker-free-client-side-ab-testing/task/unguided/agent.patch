+
+  <!-- Anti-flicker snippet: hides experiment-targeted content until the A/B variant is applied or timeout elapses -->
+  <style id="ab-anti-flicker-style">
+    html.async-hide .ab-experiment-ready,
+    html.ab-loading body {
+      opacity: 0 !important;
+      pointer-events: none !important;
+    }
+    body {
+      transition: opacity 0.15s ease-in-out;
+    }
+  </style>
+  <script>
+    (function (doc, timeoutMs) {
+      var root = doc.documentElement;
+      root.classList.add('ab-loading', 'async-hide');
+
+      var revealed = false;
+      function revealPage() {
+        if (revealed) return;
+        revealed = true;
+        root.classList.remove('ab-loading', 'async-hide');
+      }
+
+      // Expose global callback hook for the experiment SDK
+      window.onExperimentReady = revealPage;
+      window.revealExperimentContent = revealPage;
+      window.addEventListener('experiment:ready', revealPage);
+
+      // Fail-safe timeout so the page never stays blank if the CDN is unreachable
+      var timer = setTimeout(revealPage, timeoutMs);
+
+      window.__abRevealWithCleanup = function () {
+        clearTimeout(timer);
+        revealPage();
+      };
+    })(document, 2500);
+  </script>
+
+  <!-- Synchronous A/B testing SDK in <head> so variants are applied before first paint -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    onload="window.__abRevealWithCleanup && window.__abRevealWithCleanup()"
+    onerror="window.__abRevealWithCleanup && window.__abRevealWithCleanup()"
+  ></script>
+
+  <link rel="stylesheet" href="styles.css" />
