+  <script>
+    (function () {
+      const statusTextEl = document.getElementById('scheduler-status-text');
+      const pendingEl = document.getElementById('stat-pending');
+      const completedEl = document.getElementById('stat-completed');
+      const yieldsEl = document.getElementById('stat-yields');
+      const uiStatusEl = document.getElementById('stat-ui-status');
+      const logContainer = document.getElementById('queue-log');
+      const emptyLogEl = document.getElementById('queue-log-empty');
+
+      let pendingCount = 0;
+      let completedCount = 0;
+      let yieldCount = 0;
+      let taskSequence = 0;
+
+      // Feature detect the scheduler API and load polyfill if needed
+      let schedulerReadyPromise;
+      if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+        statusTextEl.textContent = 'Loading Scheduler Polyfill...';
+        schedulerReadyPromise = new Promise((resolve) => {
+          const script = document.createElement('script');
+          script.src = 'https://unpkg.com/scheduler-polyfill';
+          script.onload = () => {
+            statusTextEl.textContent = 'Scheduler Polyfill Active';
+            resolve();
+          };
+          script.onerror = () => {
+            statusTextEl.textContent = 'Fallback Queue Active';
+            resolve();
+          };
+          document.head.appendChild(script);
+        });
+      } else {
+        statusTextEl.textContent = 'Native Scheduler API Ready';
+        schedulerReadyPromise = Promise.resolve();
+      }
+
+      function updateStats() {
+        pendingEl.textContent = String(pendingCount);
+        completedEl.textContent = String(completedCount);
+        yieldsEl.textContent = String(yieldCount);
+        uiStatusEl.textContent = pendingCount > 0 ? 'Processing (Yielding)' : 'Responsive';
+      }
+
+      function appendLog(priority, message, metaText) {
+        if (emptyLogEl && emptyLogEl.parentNode === logContainer) {
+          logContainer.removeChild(emptyLogEl);
+        }
+        const entry = document.createElement('div');
+        entry.className = 'log-entry';
+
+        const pill = document.createElement('span');
+        pill.className = 'priority-pill priority-' + priority;
+        pill.textContent = priority;
+
+        const msg = document.createElement('span');
+        msg.className = 'log-message';
+        msg.textContent = message;
+
+        const meta = document.createElement('span');
+        meta.className = 'log-meta';
+        meta.textContent = metaText;
+
+        entry.appendChild(pill);
+        entry.appendChild(msg);
+        entry.appendChild(meta);
+        logContainer.prepend(entry);
+      }
+
+      async function yieldToMain() {
+        yieldCount++;
+        updateStats();
+        if ('scheduler' in window && 'yield' in window.scheduler) {
+          await window.scheduler.yield();
+        } else {
+          await new Promise((resolve) => setTimeout(resolve, 0));
+        }
+      }
+
+      // Break up heavy synchronous work using a 50ms deadline budget
+      async function processOperationItems(items, workPerItemMs) {
+        let deadline = performance.now() + 50;
+
+        for (const item of items) {
+          const itemEnd = performance.now() + workPerItemMs;
+          while (performance.now() < itemEnd) {
+            // Simulate CPU-bound item processing
+          }
+
+          if (performance.now() >= deadline) {
+            await yieldToMain();
+            deadline = performance.now() + 50;
+          }
+        }
+      }
+
+      function scheduleByPriority(callback, priority) {
+        if ('scheduler' in window && 'postTask' in window.scheduler) {
+          if (priority === 'user-visible') {
+            // Defaults to 'user-visible'
+            return window.scheduler.postTask(callback);
+          }
+          return window.scheduler.postTask(callback, { priority });
+        }
+        // Fallback timeout tiered by priority if offline and polyfill failed to load
+        const delay = priority === 'user-blocking' ? 0 : priority === 'user-visible' ? 15 : 40;
+        return new Promise((resolve) => {
+          setTimeout(() => resolve(callback()), delay);
+        });
+      }
+
+      async function enqueueTask({ label, priority, itemCount, workPerItemMs }) {
+        const taskId = ++taskSequence;
+        pendingCount++;
+        updateStats();
+
+        const queuedAt = performance.now();
+        appendLog(priority, `[#${taskId}] Queued: ${label}`, 'Waiting...');
+
+        await schedulerReadyPromise;
+
+        return scheduleByPriority(async () => {
+          const startedAt = performance.now();
+          const waitTime = Math.round(startedAt - queuedAt);
+          const items = Array.from({ length: itemCount }, (_, i) => i + 1);
+
+          await processOperationItems(items, workPerItemMs);
+
+          const duration = Math.round(performance.now() - startedAt);
+          pendingCount = Math.max(0, pendingCount - 1);
+          completedCount++;
+          updateStats();
+
+          appendLog(
+            priority,
+            `[#${taskId}] Completed: ${label} (${itemCount} steps)`,
+            `wait ${waitTime}ms · run ${duration}ms`
+          );
+        }, priority);
+      }
+
+      // 1. Urgent Checkout Task (user-blocking)
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        enqueueTask({
+          label: 'Urgent Checkout Payment & Cart Lock',
+          priority: 'user-blocking',
+          itemCount: 8,
+          workPerItemMs: 4
+        });
+      });
+
+      // 2. Standard Menu Update (user-visible default)
+      document.getElementById('btn-standard-menu').addEventListener('click', () => {
+        enqueueTask({
+          label: 'Standard Seasonal Menu & Inventory Sync',
+          priority: 'user-visible',
+          itemCount: 16,
+          workPerItemMs: 5
+        });
+      });
+
+      // 3. Background Telemetry Logging (background)
+      document.getElementById('btn-background-telemetry').addEventListener('click', () => {
+        enqueueTask({
+          label: 'Background Telemetry & Analytics Flush',
+          priority: 'background',
+          itemCount: 30,
+          workPerItemMs: 5
+        });
+      });
+
+      // 4. Batch button: queue mixed tasks in reverse/mixed order so scheduler executes them in priority order
+      document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+        enqueueTask({
+          label: 'Batch: Background Telemetry Digest #1',
+          priority: 'background',
+          itemCount: 28,
+          workPerItemMs: 4
+        });
+        enqueueTask({
+          label: 'Batch: Standard Menu Price Refresh',
+          priority: 'user-visible',
+          itemCount: 15,
+          workPerItemMs: 4
+        });
+        enqueueTask({
+          label: 'Batch: Urgent Express Checkout Validation',
+          priority: 'user-blocking',
+          itemCount: 8,
+          workPerItemMs: 4
+        });
+        enqueueTask({
+          label: 'Batch: Background Store Foot-Traffic Log',
+          priority: 'background',
+          itemCount: 24,
+          workPerItemMs: 4
+        });
+        enqueueTask({
+          label: 'Batch: Standard Barista Queue Display Update',
+          priority: 'user-visible',
+          itemCount: 12,
+          workPerItemMs: 4
+        });
+        enqueueTask({
+          label: 'Batch: Urgent Loyalty Points Redemption',
+          priority: 'user-blocking',
+          itemCount: 6,
+          workPerItemMs: 4
+        });
+      });
+
+      // Clear log button
+      document.getElementById('btn-clear-log').addEventListener('click', () => {
+        logContainer.innerHTML = '';
+        logContainer.appendChild(emptyLogEl);
+      });
+    })();
+  </script>
