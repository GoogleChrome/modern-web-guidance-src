+  <script>
+    (function () {
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 1,
+        'user-visible': 2,
+        'background': 3
+      };
+
+      let taskCounter = 0;
+      let queuedCount = 0;
+      let runningCount = 0;
+      let completedCount = 0;
+      const completedOrder = [];
+
+      const metricQueuedEl = document.getElementById('metric-queued');
+      const metricRunningEl = document.getElementById('metric-running');
+      const metricCompletedEl = document.getElementById('metric-completed');
+      const schedulerStatusEl = document.getElementById('scheduler-status');
+      const executionOrderEl = document.getElementById('execution-order');
+      const taskQueueListEl = document.getElementById('task-queue-list');
+      const executionLogListEl = document.getElementById('execution-log-list');
+
+      // Fallback queue if scheduler.postTask is unavailable
+      const fallbackQueue = [];
+      let fallbackProcessing = false;
+
+      function yieldToMain() {
+        if (typeof globalThis.scheduler !== 'undefined' && typeof globalThis.scheduler.yield === 'function') {
+          return globalThis.scheduler.yield();
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      function schedulePrioritizedTask(callback, priority) {
+        if (typeof globalThis.scheduler !== 'undefined' && typeof globalThis.scheduler.postTask === 'function') {
+          const options = { priority };
+          if (typeof globalThis.TaskController === 'function') {
+            const controller = new globalThis.TaskController({ priority });
+            options.signal = controller.signal;
+          }
+          return globalThis.scheduler.postTask(callback, options);
+        }
+
+        return new Promise((resolve, reject) => {
+          fallbackQueue.push({
+            callback,
+            priority,
+            weight: PRIORITY_WEIGHTS[priority] || 2,
+            seq: taskCounter,
+            resolve,
+            reject
+          });
+          fallbackQueue.sort((a, b) => a.weight - b.weight || a.seq - b.seq);
+          processFallbackQueue();
+        });
+      }
+
+      async function processFallbackQueue() {
+        if (fallbackProcessing) return;
+        fallbackProcessing = true;
+        await new Promise((r) => setTimeout(r, 0));
+        while (fallbackQueue.length > 0) {
+          const nextTask = fallbackQueue.shift();
+          try {
+            const result = await nextTask.callback();
+            nextTask.resolve(result);
+          } catch (err) {
+            nextTask.reject(err);
+          }
+        }
+        fallbackProcessing = false;
+      }
+
+      function updateMetrics() {
+        metricQueuedEl.textContent = String(queuedCount);
+        metricRunningEl.textContent = String(runningCount);
+        metricCompletedEl.textContent = String(completedCount);
+        schedulerStatusEl.textContent = runningCount > 0 ? 'Processing' : (queuedCount > 0 ? 'Pending' : 'Idle');
+        executionOrderEl.textContent = completedOrder.length > 0 ? completedOrder.join(' → ') : 'None';
+      }
+
+      function appendLog(message, priority) {
+        const emptyLog = document.getElementById('empty-log-msg');
+        if (emptyLog) {
+          emptyLog.remove();
+        }
+        const li = document.createElement('li');
+        li.className = `log-entry log-${priority}`;
+        li.dataset.priority = priority;
+        li.textContent = message;
+        executionLogListEl.appendChild(li);
+        executionLogListEl.scrollTop = executionLogListEl.scrollHeight;
+      }
+
+      function createTaskElement(task) {
+        const emptyQueue = document.getElementById('empty-queue-msg');
+        if (emptyQueue) {
+          emptyQueue.remove();
+        }
+        const li = document.createElement('li');
+        li.className = 'task-item';
+        li.id = `task-item-${task.id}`;
+        li.dataset.priority = task.priority;
+        li.dataset.status = 'queued';
+        li.innerHTML = `
+          <div class="task-meta">
+            <strong>#${task.id} ${task.name}</strong>
+            <span class="priority-badge priority-${task.priority}">${task.priority}</span>
+          </div>
+          <span class="task-state state-queued" id="task-state-${task.id}">Queued</span>
+        `;
+        taskQueueListEl.appendChild(li);
+        return li;
+      }
+
+      function updateTaskState(task, statusText, stateClass) {
+        const li = document.getElementById(`task-item-${task.id}`);
+        const stateEl = document.getElementById(`task-state-${task.id}`);
+        if (li) {
+          li.dataset.status = stateClass;
+        }
+        if (stateEl) {
+          stateEl.className = `task-state state-${stateClass}`;
+          stateEl.textContent = statusText;
+        }
+      }
+
+      async function runSimulatedWork(task) {
+        const totalChunks = 3;
+        for (let chunk = 1; chunk <= totalChunks; chunk++) {
+          const chunkStart = performance.now();
+          // Perform small non-blocking slice of work (~6ms per chunk)
+          while (performance.now() - chunkStart < 6) {
+            Math.sqrt(chunkStart * chunk);
+          }
+          if (chunk < totalChunks) {
+            updateTaskState(task, `Running (${chunk}/${totalChunks})`, 'running');
+            await yieldToMain();
+          }
+        }
+      }
+
+      function enqueueOperation(name, priority) {
+        const id = ++taskCounter;
+        const task = { id, name, priority };
+
+        queuedCount++;
+        createTaskElement(task);
+        appendLog(`[Queued] #${id} ${name} (${priority})`, priority);
+        updateMetrics();
+
+        return schedulePrioritizedTask(async () => {
+          queuedCount = Math.max(0, queuedCount - 1);
+          runningCount++;
+          updateTaskState(task, 'Running', 'running');
+          appendLog(`[Started] #${id} ${name} (${priority})`, priority);
+          updateMetrics();
+
+          await runSimulatedWork(task);
+
+          runningCount = Math.max(0, runningCount - 1);
+          completedCount++;
+          completedOrder.push(`${name} (${priority})`);
+          updateTaskState(task, 'Completed', 'completed');
+          appendLog(`[Completed] #${id} ${name} (${priority})`, priority);
+          updateMetrics();
+          return task;
+        }, priority);
+      }
+
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        enqueueOperation('Urgent Checkout', 'user-blocking');
+      });
+
+      document.getElementById('btn-menu-update').addEventListener('click', () => {
+        enqueueOperation('Standard Menu Update', 'user-visible');
+      });
+
+      document.getElementById('btn-telemetry').addEventListener('click', () => {
+        enqueueOperation('Background Telemetry', 'background');
+      });
+
+      document.getElementById('btn-batch').addEventListener('click', () => {
+        // Enqueue mixed tasks in reverse/mixed order to demonstrate priority scheduling:
+        // Background and Standard are queued before Urgent, yet execute in priority order:
+        // 1. user-blocking (Urgent Checkout)
+        // 2. user-visible (Standard Menu Update)
+        // 3. background (Background Telemetry)
+        enqueueOperation('Background Telemetry', 'background');
+        enqueueOperation('Standard Menu Update', 'user-visible');
+        enqueueOperation('Urgent Checkout', 'user-blocking');
+      });
+
+      document.getElementById('btn-clear-log').addEventListener('click', () => {
+        completedCount = 0;
+        completedOrder.length = 0;
+        taskQueueListEl.innerHTML = '<li class="empty-placeholder" id="empty-queue-msg">No tasks queued yet.</li>';
+        executionLogListEl.innerHTML = '<li class="empty-placeholder" id="empty-log-msg">Waiting for operations...</li>';
+        updateMetrics();
+      });
+    })();
+  </script>
+
 </body>
 
