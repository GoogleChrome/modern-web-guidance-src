+  <script>
+    (() => {
+      const meta = document.querySelector('meta[name="color-scheme"]');
+      const toggleBtn = document.getElementById('theme-toggle');
+      const systemDarkQuery = window.matchMedia('(prefers-color-scheme: dark)');
+
+      const getStoredScheme = () => {
+        try {
+          const val = localStorage.getItem('color-scheme');
+          return val === 'light' || val === 'dark' ? val : null;
+        } catch {
+          return null;
+        }
+      };
+
+      const getSystemScheme = () => (systemDarkQuery.matches ? 'dark' : 'light');
+
+      const getRenderedScheme = () => {
+        const stored = getStoredScheme();
+        if (stored) return stored;
+        if (meta.content === 'light' || meta.content === 'dark') return meta.content;
+        return getSystemScheme();
+      };
+
+      toggleBtn.addEventListener('click', () => {
+        const current = getRenderedScheme();
+        const target = current === 'dark' ? 'light' : 'dark';
+        const system = getSystemScheme();
+
+        if (target !== system) {
+          try {
+            localStorage.setItem('color-scheme', target);
+          } catch {}
+          meta.content = target;
+        } else {
+          try {
+            localStorage.removeItem('color-scheme');
+          } catch {}
+          meta.content = 'light dark';
+        }
+      });
+
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          meta.content = (e.newValue === 'light' || e.newValue === 'dark') ? e.newValue : 'light dark';
+        }
+      });
+    })();
+  </script>
+
 </body>
 
