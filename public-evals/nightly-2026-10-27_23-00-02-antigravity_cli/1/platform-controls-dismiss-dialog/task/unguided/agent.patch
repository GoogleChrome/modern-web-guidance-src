+  <script>
+    (function () {
+      const COFFEE_DATA = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          price: '$5.75',
+          image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Warm Maple Oat Latte with latte art in a ceramic cup',
+          description: 'Velvety steamed barista-grade oat milk blended with our signature double-shot espresso and pure Grade-A Vermont amber maple syrup, finished with a light dusting of cinnamon.',
