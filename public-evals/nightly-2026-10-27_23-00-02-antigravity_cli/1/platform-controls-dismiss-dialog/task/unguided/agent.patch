+          dietary: '100% Plant-Based / Dairy-Free (190 kcal, 12oz)',
+          orderUrl: '/order-online?item=maple-oat-latte'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          price: '$3.50',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Rich Dark Roast Espresso shot with thick golden crema',
+          description: 'Full-bodied and intensely aromatic, our signature dark roast espresso is slow-roasted in small batches to bring out deep caramelized sugars and a lingering, velvety crema.',
+          notes: 'Bittersweet dark chocolate, roasted walnut, smoky cedar',
+          roast: 'Dark Roast Single-Origin (Sumatra Mandheling)',
+          dietary: 'Vegan / Gluten-Free (5 kcal, double shot)',
+          orderUrl: '/order-online?item=dark-roast-espresso'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          price: '$4.75',
+          image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Chilled glass of artisanal Cold Brew coffee poured over ice',
+          description: 'Coarsely ground specialty beans steeped in filtered cold water for 18 hours, yielding an ultra-smooth, naturally sweet coffee concentrate with low acidity served over crystal-clear ice.',
+          notes: 'Molasses, smooth cocoa nibs, crisp caramel finish',
+          roast: 'Medium Roast Artisanal Blend (Guatemala & Brazil)',
+          dietary: 'Unsweetened / Dairy-Free (10 kcal, 16oz)',
+          orderUrl: '/order-online?item=cold-brew'
+        }
+      };
+
+      const modal = document.getElementById('coffee-details-modal');
+      const modalTitle = document.getElementById('modal-title');
+      const modalPrice = document.getElementById('modal-price');
+      const modalImage = document.getElementById('modal-image');
+      const modalDescription = document.getElementById('modal-description');
+      const modalNotes = document.getElementById('modal-notes');
+      const modalRoast = document.getElementById('modal-roast');
+      const modalDietary = document.getElementById('modal-dietary');
+      const modalOrderLink = document.getElementById('modal-order-link');
+      const triggers = document.querySelectorAll('.details-trigger');
+
+      let lastFocusedTrigger = null;
+      let closeWatcher = null;
+      let pushedHistoryState = false;
+
+      function cleanupCloseWatcher() {
+        if (closeWatcher) {
+          const watcher = closeWatcher;
+          closeWatcher = null;
+          watcher.destroy();
+        }
+      }
+
+      function populateModal(coffeeKey) {
+        const item = COFFEE_DATA[coffeeKey];
+        if (!item) return;
+
+        modalTitle.textContent = item.title;
+        modalPrice.textContent = item.price;
+        modalImage.src = item.image;
+        modalImage.alt = item.imageAlt;
+        modalDescription.textContent = item.description;
+        modalNotes.textContent = item.notes;
+        modalRoast.textContent = item.roast;
+        modalDietary.textContent = item.dietary;
+        modalOrderLink.href = item.orderUrl;
+      }
+
+      function openModal(coffeeKey, triggerElement) {
+        populateModal(coffeeKey);
+        lastFocusedTrigger = triggerElement || document.activeElement;
+
+        if (!modal.open) {
+          if (typeof modal.showModal === 'function') {
+            modal.showModal();
+          } else {
+            modal.setAttribute('open', '');
+          }
+        }
+
+        cleanupCloseWatcher();
+        if ('CloseWatcher' in window) {
+          closeWatcher = new window.CloseWatcher();
+          closeWatcher.onclose = function () {
+            closeWatcher = null;
+            if (modal.open) {
+              modal.close();
+            }
+          };
+        } else if (window.history && typeof window.history.pushState === 'function') {
+          window.history.pushState({ coffeeModalOpen: true, coffeeKey: coffeeKey }, '');
+          pushedHistoryState = true;
+        }
+      }
+
+      triggers.forEach(function (button) {
+        button.addEventListener('click', function () {
+          openModal(button.getAttribute('data-coffee'), button);
+        });
+      });
+
+      // Fallback light-dismiss when clicking the dialog backdrop directly
+      modal.addEventListener('click', function (event) {
+        if (event.target === modal) {
+          modal.close();
+        }
+      });
+
+      modal.addEventListener('close', function () {
+        cleanupCloseWatcher();
+        if (pushedHistoryState) {
+          pushedHistoryState = false;
+          if (window.history.state && window.history.state.coffeeModalOpen) {
+            window.history.back();
+          }
+        }
+        if (lastFocusedTrigger && typeof lastFocusedTrigger.focus === 'function') {
+          lastFocusedTrigger.focus();
+        }
+      });
+
+      window.addEventListener('popstate', function () {
+        if (pushedHistoryState) {
+          pushedHistoryState = false;
+          if (modal.open) {
+            modal.close();
+          }
+        }
+      });
+    })();
+  </script>
