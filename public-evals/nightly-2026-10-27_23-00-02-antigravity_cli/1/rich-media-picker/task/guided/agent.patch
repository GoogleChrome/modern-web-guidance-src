+    select.roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 10px 14px;
+      background-color: rgba(62, 39, 35, 0.9);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      color: var(--light);
+      font-family: inherit;
+      font-size: 1rem;
+      cursor: pointer;
+      transition: border-color 0.2s, background-color 0.2s;
+    }
+
+    select.roast-select:hover,
+    select.roast-select:focus-visible {
+      border-color: var(--accent);
+      background-color: var(--primary);
+      outline: none;
+    }
+
+    select.roast-select::picker-icon {
+      color: var(--accent);
+    }
+
+    select.roast-select button {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+      background: none;
+      border: none;
+      color: inherit;
+      font: inherit;
+      padding: 0;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    select.roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 10px;
+    }
+
+    select.roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
+    select.roast-select::picker(select) {
+      background-color: #2b1b17;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      margin-top: 6px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6);
+      width: anchor-size(width);
+      color: var(--light);
+    }
+
+    select.roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 12px;
+      border-radius: 6px;
+      color: var(--light);
+      cursor: pointer;
+      transition: background-color 0.15s;
+    }
+
+    select.roast-select option:hover {
+      background-color: var(--primary);
+    }
+
+    select.roast-select option::before,
+    select.roast-select option::checkmark {
+      display: none;
+    }
+
+    select.roast-select option:checked {
+      background-color: var(--accent);
+      color: var(--text);
+    }
+
+    select.roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    select.roast-select option:checked .option-desc {
+      color: #4e342e;
+    }
+
+    .option-icon {
+      flex-shrink: 0;
+      width: 24px;
+      height: 24px;
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      text-align: left;
+      line-height: 1.3;
+    }
+
+    .option-title {
+      font-size: 0.95rem;
+      font-weight: 600;
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      color: var(--secondary);
