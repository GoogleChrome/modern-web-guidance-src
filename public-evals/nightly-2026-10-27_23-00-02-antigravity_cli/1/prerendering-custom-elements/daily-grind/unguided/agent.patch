+  <script type="module">
+    class DrinkCard extends HTMLElement {
+      static observedAttributes = ['favorited', 'expanded'];
+
+      constructor() {
+        super();
+        // Hydrate existing Declarative Shadow DOM in place without re-creating or re-rendering DOM nodes
+        if (!this.shadowRoot) {
+          const template = this.querySelector('template[shadowrootmode]');
+          if (template) {
+            const mode = template.getAttribute('shadowrootmode') || 'open';
+            const shadow = this.attachShadow({ mode });
+            shadow.appendChild(template.content);
+            template.remove();
+          }
+        }
+
+        this._onFavClick = this._onFavClick.bind(this);
+        this._onDetailsClick = this._onDetailsClick.bind(this);
+      }
+
+      connectedCallback() {
+        if (!this.shadowRoot) return;
+
+        this._favBtn = this.shadowRoot.querySelector('[data-action="favorite"]');
+        this._favIcon = this.shadowRoot.querySelector('.fav-icon');
+        this._detailsBtn = this.shadowRoot.querySelector('[data-action="toggle-details"]');
+        this._detailsPanel = this.shadowRoot.querySelector('#details');
+
+        if (this._favBtn) {
+          this._favBtn.addEventListener('click', this._onFavClick);
+        }
+        if (this._detailsBtn) {
+          this._detailsBtn.addEventListener('click', this._onDetailsClick);
+        }
+
+        // Sync initial attribute state in place without replacing nodes
+        this._syncFavoriteState();
+        this._syncDetailsState();
+        this.setAttribute('hydrated', '');
+      }
+
+      disconnectedCallback() {
+        if (this._favBtn) {
+          this._favBtn.removeEventListener('click', this._onFavClick);
+        }
+        if (this._detailsBtn) {
+          this._detailsBtn.removeEventListener('click', this._onDetailsClick);
+        }
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue || !this.shadowRoot) return;
+        if (name === 'favorited') {
+          this._syncFavoriteState();
+        } else if (name === 'expanded') {
+          this._syncDetailsState();
+        }
+      }
+
+      get favorited() {
+        const val = this.getAttribute('favorited');
+        return val !== null && val !== 'false';
+      }
+
+      set favorited(value) {
+        this.setAttribute('favorited', value ? 'true' : 'false');
+      }
+
+      get expanded() {
+        const val = this.getAttribute('expanded');
+        return val !== null && val !== 'false';
+      }
+
+      set expanded(value) {
+        if (value) {
+          this.setAttribute('expanded', 'true');
+        } else {
+          this.removeAttribute('expanded');
+        }
+      }
+
+      _onFavClick() {
+        this.favorited = !this.favorited;
+        this.dispatchEvent(new CustomEvent('drink-favorite-change', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            id: this.id,
+            name: this.getAttribute('drink-name'),
+            favorited: this.favorited
+          }
+        }));
+      }
+
+      _onDetailsClick() {
+        this.expanded = !this.expanded;
+        this.dispatchEvent(new CustomEvent('drink-details-toggle', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            id: this.id,
+            name: this.getAttribute('drink-name'),
+            expanded: this.expanded
+          }
+        }));
+      }
+
+      _syncFavoriteState() {
+        if (!this._favBtn) return;
+        const isFav = this.favorited;
+        this._favBtn.setAttribute('aria-pressed', isFav ? 'true' : 'false');
+        if (this._favIcon) {
+          this._favIcon.textContent = isFav ? '♥' : '♡';
+        }
+      }
+
+      _syncDetailsState() {
+        if (!this._detailsBtn || !this._detailsPanel) return;
+        const isExpanded = this.expanded;
+        this._detailsBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
+        this._detailsBtn.textContent = isExpanded ? 'Hide Details' : 'Show Details';
+        if (isExpanded) {
+          this._detailsPanel.removeAttribute('hidden');
+        } else {
+          this._detailsPanel.setAttribute('hidden', '');
+        }
+      }
+    }
+
+    if (!customElements.get('drink-card')) {
+      customElements.define('drink-card', DrinkCard);
+    }
+  </script>
 </body>
 
