+        // only attach and clone a shadow root if absent (client-created or non-DSD engine).
+        if (!this.shadowRoot) {
+          this.attachShadow({ mode: 'open' });
+          const dsdTemplate = !Object.hasOwn(HTMLTemplateElement.prototype, 'shadowRootMode')
+            ? this.querySelector('template[shadowrootmode]')
+            : null;
+          if (dsdTemplate) {
+            this.shadowRoot.append(dsdTemplate.content.cloneNode(true));
+            dsdTemplate.remove();
+          } else {
+            this.shadowRoot.append(fallbackTemplate.content.cloneNode(true));
+          }
+        }
+
+        // Hydrate in place: bind listeners once to the existing server-rendered nodes
+        // in the constructor without re-rendering or replacing DOM nodes.
+        this.#detailsBtn = this.shadowRoot.getElementById('details-toggle');
+        this.#favoriteBtn = this.shadowRoot.getElementById('favorite-toggle');
+
+        this.#detailsBtn?.addEventListener('click', () => {
+          this.open = !this.open;
+          this.dispatchEvent(new CustomEvent('details-toggle', {
+            detail: { open: this.open },
+            bubbles: true,
+            composed: true
+          }));
+        });
+
+        this.#favoriteBtn?.addEventListener('click', () => {
+          this.favorited = !this.favorited;
+          this.dispatchEvent(new CustomEvent('favorite-change', {
+            detail: { favorited: this.favorited },
+            bubbles: true,
+            composed: true
+          }));
+        });
+      }
+
+      connectedCallback() {
+        this.#syncOpenState();
+        this.#syncFavoriteState();
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+
+      set open(val) {
+        this.toggleAttribute('open', Boolean(val));
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+
+      set favorited(val) {
+        this.toggleAttribute('favorited', Boolean(val));
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal) return;
+        if (name === 'open') {
+          this.#syncOpenState();
+        } else if (name === 'favorited') {
+          this.#syncFavoriteState();
+        }
+      }
+
+      #syncOpenState() {
+        const isOpen = this.open;
+        if (this.#internals?.states) {
+          if (isOpen) {
+            this.#internals.states.add('expanded');
+          } else {
+            this.#internals.states.delete('expanded');
+          }
+        }
+        if (this.#detailsBtn) {
+          this.#detailsBtn.setAttribute('aria-expanded', String(isOpen));
+          this.#detailsBtn.textContent = isOpen ? 'Hide Notes' : 'Tasting Notes';
+        }
+      }
+
+      #syncFavoriteState() {
+        const isFav = this.favorited;
+        if (this.#internals?.states) {
+          if (isFav) {
+            this.#internals.states.add('favorited');
+          } else {
+            this.#internals.states.delete('favorited');
+          }
+        }
+        if (this.#favoriteBtn) {
+          this.#favoriteBtn.setAttribute('aria-pressed', String(isFav));
+          const label = isFav ? 'Remove from favorites' : 'Save to favorites';
+          this.#favoriteBtn.setAttribute('aria-label', label);
+          this.#favoriteBtn.setAttribute('title', label);
+          const icon = this.#favoriteBtn.querySelector('span');
+          if (icon) {
+            icon.textContent = isFav ? '\u2665' : '\u2661';
+          }
+        }
+      }
+    }
+
+    customElements.define('drink-card', DrinkCard);
+  </script>
