+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const statusEl = document.getElementById('status');
+      if (!scroller || !statusEl) return;
+
+      const originItems = Array.from(scroller.querySelectorAll('.origin-card'));
+      let isScrolling = false;
+      let scrollEndTimer = null;
+
+      function getMostVisibleOrigin() {
+        const scrollerRect = scroller.getBoundingClientRect();
+        const scrollerCenterY = scrollerRect.top + scrollerRect.height / 2;
+        const scrollerCenterX = scrollerRect.left + scrollerRect.width / 2;
+
+        let bestItem = null;
+        let maxVisibleArea = -1;
+        let minCenterDistance = Infinity;
+
+        for (let i = 0; i < originItems.length; i++) {
+          const item = originItems[i];
+          const rect = item.getBoundingClientRect();
+
+          const visibleTop = Math.max(rect.top, scrollerRect.top);
+          const visibleBottom = Math.min(rect.bottom, scrollerRect.bottom);
+          const visibleLeft = Math.max(rect.left, scrollerRect.left);
+          const visibleRight = Math.min(rect.right, scrollerRect.right);
+
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+          const visibleWidth = Math.max(0, visibleRight - visibleLeft);
+          const visibleArea = visibleWidth * visibleHeight;
+
+          const itemCenterY = rect.top + rect.height / 2;
+          const itemCenterX = rect.left + rect.width / 2;
+          const centerDistance = Math.hypot(
+            itemCenterX - scrollerCenterX,
+            itemCenterY - scrollerCenterY
+          );
+
+          if (
+            visibleArea > maxVisibleArea ||
+            (visibleArea === maxVisibleArea && centerDistance < minCenterDistance)
+          ) {
+            maxVisibleArea = visibleArea;
+            minCenterDistance = centerDistance;
+            bestItem = item;
+          }
+        }
+
+        if (!bestItem && originItems.length > 0) {
+          bestItem = originItems[0];
+        }
+
+        if (!bestItem) return '';
+        return (
+          bestItem.dataset.origin ||
+          (bestItem.querySelector('h3') && bestItem.querySelector('h3').textContent.trim()) ||
+          bestItem.textContent.trim()
+        );
+      }
+
+      function handleScrollEnd() {
+        if (scrollEndTimer !== null) {
+          clearTimeout(scrollEndTimer);
+          scrollEndTimer = null;
+        }
+        isScrolling = false;
+        statusEl.classList.remove('is-scrolling');
+        const visibleOrigin = getMostVisibleOrigin();
+        statusEl.textContent = 'Scroll ended. Visible: ' + visibleOrigin;
+      }
+
+      function handleScroll() {
+        // Guard active-scroll DOM writes so we only update once per scroll gesture
+        // and never read layout metrics while scrolling is active.
+        if (!isScrolling) {
+          isScrolling = true;
+          statusEl.classList.add('is-scrolling');
+          statusEl.textContent = 'Scrolling...';
+        }
+
+        if (scrollEndTimer !== null) {
+          clearTimeout(scrollEndTimer);
+        }
+        scrollEndTimer = setTimeout(handleScrollEnd, 150);
+      }
+
+      scroller.addEventListener('scroll', handleScroll, { passive: true });
+      scroller.addEventListener('scrollend', handleScrollEnd, { passive: true });
+    })();
+  </script>
