+  <script>
+    function fitHeroLockup() {
+      const heading = document.querySelector('.hero h1');
+      if (!heading) return;
+      const targetWidth = heading.clientWidth;
+      if (!targetWidth) return;
+
+      const lines = heading.querySelectorAll('.lockup-line');
+      lines.forEach((line) => {
+        const baseSize = 100;
+        line.style.fontSize = baseSize + 'px';
+        const initialWidth = line.getBoundingClientRect().width;
+        if (initialWidth > 0) {
+          let fittedSize = (baseSize * targetWidth) / initialWidth;
+          line.style.fontSize = fittedSize + 'px';
+          const refinedWidth = line.getBoundingClientRect().width;
+          if (refinedWidth > 0 && Math.abs(refinedWidth - targetWidth) > 0.1) {
+            fittedSize = (fittedSize * targetWidth) / refinedWidth;
+            line.style.fontSize = fittedSize + 'px';
+          }
+        }
+      });
+    }
+
+    fitHeroLockup();
+    window.addEventListener('DOMContentLoaded', fitHeroLockup);
+    window.addEventListener('load', fitHeroLockup);
+    window.addEventListener('resize', fitHeroLockup);
+    if (document.fonts && document.fonts.ready) {
+      document.fonts.ready.then(fitHeroLockup);
+    }
+  </script>
