--- /dev/null
+++ b/src/pages/api/verify-otp.ts
@@ -0,0 +1,95 @@
+import type { APIRoute } from 'astro';
+import { isValidOtpCode } from '../../utils/sms-otp';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    let otp = '';
+    let phone = '';
+    let username = '';
+
+    const contentType = request.headers.get('content-type') || '';
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      otp = (body.otp || '').toString().trim();
+      phone = (body.phone || '').toString().trim();
+      username = (body.username || '').toString().trim();
+    } else {
+      const formData = await request.formData();
+      otp = (formData.get('otp') || '').toString().trim();
+      phone = (formData.get('phone') || '').toString().trim();
+      username = (formData.get('username') || '').toString().trim();
+    }
+
+    if (!isValidOtpCode(otp)) {
+      return new Response(
+        JSON.stringify({
+          error: 'INVALID_OTP_FORMAT',
+          message: 'Please enter a valid 6-digit verification code.',
+        }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const pendingOtp = (await session?.get('pendingOtp')) as
+      | { code: string; phone: string; username: string; expiresAt: number }
+      | undefined;
+
+    if (pendingOtp) {
+      if (Date.now() > pendingOtp.expiresAt) {
+        return new Response(
+          JSON.stringify({
+            error: 'OTP_EXPIRED',
+            message: 'Your verification code has expired. Please request a new code.',
+          }),
+          {
+            status: 400,
+            headers: { 'Content-Type': 'application/json' },
+          }
+        );
+      }
+
+      if (pendingOtp.code !== otp) {
+        return new Response(
+          JSON.stringify({
+            error: 'OTP_MISMATCH',
+            message: 'The verification code you entered does not match. Please try again.',
+          }),
+          {
+            status: 400,
+            headers: { 'Content-Type': 'application/json' },
+          }
+        );
+      }
+
+      await session?.set('pendingOtp', undefined);
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        verified: true,
+        phone: phone || pendingOtp?.phone || '',
+        username: username || pendingOtp?.username || '',
+        message: 'Phone number verified successfully.',
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'SERVER_ERROR',
+        message: 'An unexpected error occurred during code verification.',
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
