index 0000000..2c2ac57
--- /dev/null
+++ b/src/utils/sms-otp.ts
@@ -0,0 +1,54 @@
+/**
+ * Extracts only the host domain from an origin or URL string,
+ * stripping any URL scheme (https:// or http://), port (:8080), or path (/verify).
+ */
+export function extractHostDomain(originOrUrl: string | URL): string {
+  try {
+    const parsed = typeof originOrUrl === 'string' ? new URL(originOrUrl) : originOrUrl;
+    return parsed.hostname.trim();
+  } catch {
+    return String(originOrUrl)
+      .trim()
+      .replace(/^https?:\/\//i, '')
+      .split('/')[0]
+      .split('?')[0]
+      .split('#')[0]
+      .split(':')[0]
+      .trim();
+  }
+}
+
+/**
+ * Formats an origin-bound SMS verification message for WebOTP and autocomplete="one-time-code".
+ *
+ * Formatting rules enforced:
+ * 1. Human-readable sentence containing the code comes first.
+ * 2. `@<domain> #<otp>` is placed on the very last line with `@` as the first character and no trailing text.
+ * 3. Only the host domain is used (no scheme, port, or path).
+ * 4. Exactly one space separates `@<domain>` and `#<otp>`, with no whitespace inside either token.
+ */
+export function formatOriginBoundSms(
+  originOrUrl: string | URL,
+  otpCode: string,
+  embeddedIframeOrigin?: string | URL
+): string {
+  const host = extractHostDomain(originOrUrl) || 'localhost';
+  const cleanCode = otpCode.replace(/\s+/g, '');
+
+  let bindingLine = `@${host} #${cleanCode}`;
+  if (embeddedIframeOrigin) {
+    const iframeHost = extractHostDomain(embeddedIframeOrigin);
+    if (iframeHost) {
+      bindingLine = `${bindingLine} @${iframeHost}`;
+    }
+  }
+
+  return `Your verification code is ${cleanCode}.\n\n${bindingLine}`;
+}
+
+/**
+ * Validates that a one-time passcode is an exact 6-digit numeric string (including leading zeros).
+ */
+export function isValidOtpCode(code: string): boolean {
+  return /^\d{6}$/.test(code);
+}
