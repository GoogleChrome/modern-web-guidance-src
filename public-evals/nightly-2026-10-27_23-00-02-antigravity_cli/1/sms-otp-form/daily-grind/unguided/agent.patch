+  <script>
+    (function () {
+      const form = document.getElementById('otp-form');
+      const input = document.getElementById('otp-code');
+      const resendBtn = document.getElementById('resend-otp-btn');
+      const statusEl = document.getElementById('otp-status');
+
+      function setStatus(message, type) {
+        if (!statusEl) return;
+        statusEl.textContent = message;
+        statusEl.className = 'otp-status visible ' + (type || '');
+      }
+
+      function extractOtpFromText(text) {
+        if (!text) return '';
+        const match = String(text).match(/\b(\d{6})\b/);
+        return match ? match[1] : String(text).replace(/\D/g, '').slice(0, 6);
+      }
+
+      if (input) {
+        input.addEventListener('input', function () {
+          const digits = extractOtpFromText(input.value);
+          if (input.value !== digits) {
+            input.value = digits;
+          }
+          if (digits.length === 6) {
+            input.setAttribute('aria-invalid', 'false');
+          }
+        });
+
+        input.addEventListener('paste', function (e) {
+          const clipboardData = e.clipboardData || window.clipboardData;
+          if (!clipboardData) return;
+          const pastedText = clipboardData.getData('text');
+          const extracted = extractOtpFromText(pastedText);
+          if (extracted) {
+            e.preventDefault();
+            input.value = extracted;
+            input.setAttribute('aria-invalid', 'false');
+          }
+        });
+      }
+
+      let otpAbortController = null;
+
+      function startWebOtpListener() {
+        if (!('OTPCredential' in window) || !navigator.credentials || !navigator.credentials.get) {
+          return;
+        }
+        if (otpAbortController) {
+          otpAbortController.abort();
+        }
+        otpAbortController = new AbortController();
+        navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: otpAbortController.signal
+        }).then(function (otp) {
+          if (otp && otp.code && input) {
+            input.value = extractOtpFromText(otp.code) || otp.code;
+            input.setAttribute('aria-invalid', 'false');
+            setStatus('Passcode automatically extracted from SMS and verified!', 'success');
+          }
+        }).catch(function () {
+          // Ignore abort or unsupported WebOTP errors
+        });
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', startWebOtpListener);
+      } else {
+        startWebOtpListener();
+      }
+
+      if (form && input) {
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          if (otpAbortController) {
+            otpAbortController.abort();
+          }
+          const code = input.value.trim();
+          if (/^\d{6}$/.test(code)) {
+            input.setAttribute('aria-invalid', 'false');
+            setStatus('Passcode verified! You are now signed in for Rewards and online ordering.', 'success');
+          } else {
+            input.setAttribute('aria-invalid', 'true');
+            setStatus('Please enter a valid 6-digit numeric passcode.', 'error');
+            input.focus();
+          }
+        });
+      }
+
+      if (resendBtn) {
+        resendBtn.addEventListener('click', function () {
+          setStatus('A new 6-digit SMS passcode has been sent to your phone.', 'success');
+          startWebOtpListener();
+          if (input) {
+            input.focus();
+          }
+        });
+      }
+    })();
+  </script>
