+  <script>
+    class StarRating extends HTMLElement {
+      static formAssociated = true;
+
+      static get observedAttributes() {
+        return ['value', 'required', 'disabled', 'name', 'max'];
+      }
+
+      constructor() {
+        super();
+        this._internals = this.attachInternals();
+        this._value = '';
+        this._defaultValue = '';
+        this._disabled = false;
+        this._touched = false;
+        this._hoverValue = 0;
+
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this._render();
+      }
+
+      connectedCallback() {
+        if (!this.hasAttribute('role')) {
+          this._internals.role = 'slider';
+        }
+        if (this.hasAttribute('value') && !this._touched) {
+          this._defaultValue = this.getAttribute('value') || '';
+          this._value = this._defaultValue;
+        }
+        this._disabled = this.hasAttribute('disabled') || this.matches(':disabled');
+        this._syncState();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+
+        if (name === 'value') {
+          this._defaultValue = newValue !== null ? String(newValue) : '';
+          if (!this._touched) {
+            this._value = this._defaultValue;
+          }
+          this._syncState();
+        } else if (name === 'required') {
+          this._updateValidity();
+        } else if (name === 'disabled') {
+          this._disabled = newValue !== null || this.matches(':disabled');
+          this._updateStarUI();
+        } else if (name === 'max') {
+          this._render();
+          this._syncState();
+        } else if (name === 'name') {
+          this._syncState();
+        }
+      }
+
+      formAssociatedCallback(form) {
+        this._updateValidity();
+      }
+
+      formDisabledCallback(disabled) {
+        this._disabled = disabled;
+        this._updateStarUI();
+      }
+
+      formResetCallback() {
+        this._touched = false;
+        this._hoverValue = 0;
+        this._value = this.getAttribute('value') || '';
+        this._syncState();
+      }
+
+      formStateRestoreCallback(state, mode) {
+        this._touched = true;
+        this._value = state !== null && state !== undefined ? String(state) : '';
+        this._syncState();
+      }
+
+      get value() {
+        return this._value;
+      }
+
+      set value(val) {
+        this._touched = true;
+        const parsed = val !== null && val !== undefined && val !== '' ? String(val) : '';
+        this._value = parsed === '0' ? '' : parsed;
+        this._syncState();
+      }
+
+      get name() {
+        return this.getAttribute('name') || '';
+      }
+
+      set name(val) {
+        if (val === null || val === undefined) {
+          this.removeAttribute('name');
+        } else {
+          this.setAttribute('name', val);
+        }
+      }
+
+      get required() {
+        return this.hasAttribute('required');
+      }
+
+      set required(val) {
+        if (val) {
+          this.setAttribute('required', '');
+        } else {
+          this.removeAttribute('required');
+        }
+      }
+
+      get disabled() {
+        return this._disabled;
+      }
+
+      set disabled(val) {
+        if (val) {
+          this.setAttribute('disabled', '');
+        } else {
+          this.removeAttribute('disabled');
+        }
+      }
+
+      get max() {
+        const m = parseInt(this.getAttribute('max') || '5', 10);
+        return Number.isNaN(m) || m < 1 ? 5 : m;
+      }
+
+      set max(val) {
+        this.setAttribute('max', String(val));
+      }
+
+      get form() {
+        return this._internals.form;
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get validity() {
+        return this._internals.validity;
+      }
+
+      get validationMessage() {
+        return this._internals.validationMessage;
+      }
+
+      get willValidate() {
+        return this._internals.willValidate;
+      }
+
+      checkValidity() {
+        return this._internals.checkValidity();
+      }
+
+      reportValidity() {
+        return this._internals.reportValidity();
+      }
+
+      _syncState() {
+        const formVal = this._value ? this._value : null;
+        this._internals.setFormValue(formVal, formVal);
+        this._internals.ariaValueMin = '1';
+        this._internals.ariaValueMax = String(this.max);
+        this._internals.ariaValueNow = this._value || '0';
+        this._updateValidity();
+        this._updateStarUI();
+      }
+
+      _updateValidity() {
+        if (!this.shadowRoot) return;
+        const firstStar = this.shadowRoot.querySelector('.star');
+        const isMissing = this.required && (!this._value || Number(this._value) < 1);
+        if (isMissing) {
+          this._internals.setValidity(
+            { valueMissing: true },
+            'Please select a star rating.',
+            firstStar || undefined
+          );
+        } else {
+          this._internals.setValidity({});
+        }
+      }
+
+      _selectRating(rating) {
+        if (this._disabled) return;
+        this.value = String(rating);
+        this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+        this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+      }
+
+      _render() {
+        const maxStars = this.max;
+        const starsHtml = Array.from({ length: maxStars }, (_, idx) => {
+          const val = idx + 1;
+          return `<button type="button" class="star" data-value="${val}" aria-label="${val} of ${maxStars} stars" part="star">★</button>`;
+        }).join('');
+
+        this.shadowRoot.innerHTML = `
+          <style>
+            :host {
+              display: inline-block;
+              user-select: none;
+              vertical-align: middle;
+            }
+            :host([ hidden ]) {
+              display: none;
+            }
+            .stars-wrapper {
+              display: inline-flex;
+              align-items: center;
+              gap: 6px;
+              padding: 4px 0;
+            }
+            .star {
+              appearance: none;
+              background: transparent;
+              border: none;
+              font-size: 2rem;
+              line-height: 1;
+              cursor: pointer;
+              color: #d7ccc8;
+              padding: 2px 4px;
+              border-radius: 4px;
+              transition: color 0.15s ease, transform 0.1s ease;
+            }
+            .star:focus-visible {
+              outline: 2px solid #ffab40;
+              outline-offset: 2px;
+            }
+            .star.active {
+              color: #ffab40;
+            }
+            .star.preview {
+              color: #ffd180;
+            }
+            .star:hover:not(:disabled) {
+              transform: scale(1.12);
+            }
+            .star:disabled,
+            :host(:disabled) .star {
+              cursor: not-allowed;
+              opacity: 0.55;
+              transform: none;
+            }
+            .rating-status {
+              margin-left: 8px;
+              font-size: 0.9rem;
+              color: #6d4c41;
+              min-width: 70px;
+            }
+          </style>
+          <div class="stars-wrapper" role="radiogroup" aria-label="Star rating">
+            ${starsHtml}
+            <span class="rating-status" aria-live="polite"></span>
+          </div>
+        `;
+
+        const wrapper = this.shadowRoot.querySelector('.stars-wrapper');
+        const stars = Array.from(this.shadowRoot.querySelectorAll('.star'));
+
+        stars.forEach((star) => {
+          star.addEventListener('click', () => {
+            const val = Number(star.dataset.value);
+            this._selectRating(val);
+          });
+
+          star.addEventListener('mouseenter', () => {
+            if (this._disabled) return;
+            this._hoverValue = Number(star.dataset.value);
+            this._updateStarUI();
+          });
+
+          star.addEventListener('keydown', (e) => {
+            if (this._disabled) return;
+            const current = Number(this._value) || 0;
+            let next = current;
+
+            if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
+              e.preventDefault();
+              next = Math.min(this.max, current + 1);
+            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
+              e.preventDefault();
+              next = Math.max(1, current - 1);
+            } else if (e.key === 'Home') {
+              e.preventDefault();
+              next = 1;
+            } else if (e.key === 'End') {
+              e.preventDefault();
+              next = this.max;
+            } else {
+              return;
+            }
+
+            this._selectRating(next);
+            const targetBtn = stars[next - 1];
+            if (targetBtn) targetBtn.focus();
+          });
+        });
+
+        wrapper.addEventListener('mouseleave', () => {
+          this._hoverValue = 0;
+          this._updateStarUI();
+        });
+      }
+
+      _updateStarUI() {
+        if (!this.shadowRoot) return;
+        const stars = this.shadowRoot.querySelectorAll('.star');
+        const statusEl = this.shadowRoot.querySelector('.rating-status');
+        const currentVal = Number(this._value) || 0;
+        const previewVal = this._hoverValue || currentVal;
+
+        stars.forEach((star, index) => {
+          const starVal = Number(star.dataset.value);
+          star.disabled = this._disabled;
+          star.classList.toggle('active', starVal <= currentVal);
+          star.classList.toggle('preview', this._hoverValue > 0 && starVal <= previewVal && starVal > currentVal);
+          star.setAttribute('aria-checked', String(starVal === currentVal));
+
+          if (this._disabled) {
+            star.tabIndex = -1;
+          } else if (currentVal > 0) {
+            star.tabIndex = starVal === currentVal ? 0 : -1;
+          } else {
+            star.tabIndex = index === 0 ? 0 : -1;
+          }
+        });
+
+        if (statusEl) {
+          statusEl.textContent = currentVal > 0 ? `${currentVal} / ${this.max} stars` : 'Unrated';
+        }
+      }
+    }
+
+    if (!customElements.get('star-rating')) {
+      customElements.define('star-rating', StarRating);
+    }
+
+    const feedbackForm = document.getElementById('coffee-feedback-form');
+    const feedbackResult = document.getElementById('feedback-result');
+
+    if (feedbackForm && feedbackResult) {
+      feedbackForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(feedbackForm);
+        const name = formData.get('customerName');
+        const drink = formData.get('drink');
+        const rating = formData.get('rating');
+        feedbackResult.textContent = `Thank you, ${name}! Your ${rating}-star review for ${drink} has been received.`;
+        feedbackResult.classList.add('visible');
+      });
+
+      feedbackForm.addEventListener('reset', () => {
+        feedbackResult.textContent = '';
+        feedbackResult.classList.remove('visible');
+      });
+    }
+  </script>
+
