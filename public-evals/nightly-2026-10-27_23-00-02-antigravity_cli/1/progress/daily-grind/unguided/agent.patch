+  <script>
+    function setProgressMode(mode, percent = 75) {
+      const customTrack = document.getElementById('custom-progress-bar');
+      const customFill = document.getElementById('custom-progress-fill');
+      const nativeProgress = document.getElementById('native-progress-bar');
+      const labelEl = document.getElementById('order-progress-label');
+      const valueEl = document.getElementById('order-progress-value');
+      const steps = document.querySelectorAll('#progress-steps-list .progress-step');
+
+      const btnDet = document.getElementById('btn-determinate');
+      const btnIndet = document.getElementById('btn-indeterminate');
+      const btnComp = document.getElementById('btn-complete');
+
+      btnDet.classList.remove('active');
+      btnIndet.classList.remove('active');
+      btnComp.classList.remove('active');
+
+      if (mode === 'indeterminate') {
+        btnIndet.classList.add('active');
+
+        // Update ARIA progressbar to indeterminate state (no aria-valuenow)
+        customTrack.classList.add('indeterminate');
+        customFill.classList.add('indeterminate');
+        customTrack.removeAttribute('aria-valuenow');
+        customTrack.setAttribute('aria-busy', 'true');
+
+        // Update native <progress> to indeterminate state (no value attribute)
+        nativeProgress.removeAttribute('value');
+        nativeProgress.textContent = 'Processing...';
+
+        labelEl.textContent = 'Syncing order with local roastery & calculating reward beans...';
+        valueEl.textContent = 'In Progress...';
+
+        steps.forEach((step) => step.classList.remove('completed'));
+      } else {
+        if (percent >= 100) {
+          btnComp.classList.add('active');
+        } else {
+          btnDet.classList.add('active');
+        }
+
+        // Update ARIA progressbar to determinate state
+        customTrack.classList.remove('indeterminate');
+        customFill.classList.remove('indeterminate');
+        customTrack.setAttribute('aria-valuenow', String(percent));
+        customTrack.setAttribute('aria-busy', 'false');
+        customFill.style.width = percent + '%';
+
+        // Update native <progress> to determinate state
+        nativeProgress.setAttribute('value', String(percent));
+        nativeProgress.textContent = percent + '%';
+
+        if (percent >= 100) {
+          labelEl.textContent = 'Order Complete! Free Drink Reward Unlocked (1,000 / 1,000 Beans)';
+        } else {
+          labelEl.textContent = 'Brewing your Maple Oat Latte \u2014 750 / 1,000 Beans toward Next Free Drink';
+        }
+        valueEl.textContent = percent + '%';
+
+        steps.forEach((step) => {
+          const threshold = Number(step.getAttribute('data-step'));
+          if (percent >= threshold) {
+            step.classList.add('completed');
+          } else {
+            step.classList.remove('completed');
+          }
+        });
+      }
+    }
+  </script>
+
