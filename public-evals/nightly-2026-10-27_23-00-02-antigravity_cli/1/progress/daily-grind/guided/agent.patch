+  <script>
+    document.querySelectorAll('.progress-controls button').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const progressEl = document.getElementById(btn.dataset.target);
+        const statusEl = document.getElementById(btn.dataset.status);
+        const group = btn.closest('.progress-controls');
+
+        group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', 'false'));
+        btn.setAttribute('aria-pressed', 'true');
+
+        if (btn.dataset.mode === 'indeterminate') {
+          progressEl.removeAttribute('value');
+          statusEl.textContent = btn.dataset.target === 'reward-progress'
+            ? 'Syncing reward balance…'
+            : 'Assigning barista…';
+        } else {
+          const val = Number(btn.dataset.value);
+          progressEl.value = val;
+          if (btn.dataset.target === 'reward-progress') {
+            statusEl.textContent = val >= 100
+              ? '100 / 100 Beans — Free Drink Ready!'
+              : `${val} / 100 Beans (${val}%)`;
+          } else {
+            statusEl.textContent = val >= 100
+              ? 'Order Complete — Ready for Pickup!'
+              : `Brewing your order (${val}%)`;
+          }
+        }
+      });
+    });
+  </script>
