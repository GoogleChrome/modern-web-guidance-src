+  <script>
+    /**
+     * Background Tab Load & Visibility Timestamp Detector
+     *
+     * Accurately detects whether the page was initially loaded in a background tab
+     * and records the exact timestamp (in milliseconds) of when it was backgrounded.
+     *
+     * Primary Method (Accurate, even for async/deferred scripts):
+     * Uses the Performance Timeline `VisibilityStateEntry` API
+     * (`performance.getEntriesByType('visibility-state')` / `PerformanceObserver`).
+     * The browser records an initial entry at `startTime: 0` with `name: 'hidden'`
+     * or `name: 'visible'`, plus high-resolution timestamps for every subsequent
+     * visibility transition regardless of when this script executes.
+     *
+     * Legacy Fallback Method (WARNING: Inaccurate / Unreliable for async scripts):
+     * Falls back to querying `document.visibilityState` / `document.hidden` and
+     * listening to `visibilitychange` events when `visibility-state` performance
+     * entries are unsupported.
+     * NOTE: Legacy fallback queries are highly inaccurate for async or late-loading
+     * scripts because they only inspect the visibility state at the moment the script
+     * executes, missing any visibility transitions that occurred between navigation
+     * start (`startTime: 0`) and script evaluation.
+     */
+    (function detectBackgroundTabLoad() {
+      const supportsVisibilityStateEntries =
+        typeof performance !== 'undefined' &&
+        typeof performance.getEntriesByType === 'function' &&
+        typeof PerformanceObserver !== 'undefined' &&
+        Array.isArray(PerformanceObserver.supportedEntryTypes) &&
+        PerformanceObserver.supportedEntryTypes.includes('visibility-state');
+
+      let visibilityEntries = [];
+      if (typeof performance !== 'undefined' && typeof performance.getEntriesByType === 'function') {
+        visibilityEntries = performance.getEntriesByType('visibility-state');
+      }
+
+      const useModernApi = supportsVisibilityStateEntries || visibilityEntries.length > 0;
+
+      if (useModernApi && visibilityEntries.length > 0) {
+        const initialEntry = visibilityEntries[0];
+        const firstHiddenEntry = visibilityEntries.find((entry) => entry.name === 'hidden');
+
+        // True if the initial visibility state at navigation start (startTime === 0) was 'hidden'
+        const initiallyLoadedInBackground =
+          Boolean(initialEntry && initialEntry.name === 'hidden' && initialEntry.startTime === 0);
+        const backgroundStatus = Boolean(firstHiddenEntry);
+        const backgroundTime = firstHiddenEntry ? firstHiddenEntry.startTime : null;
+
+        const detectionInfo = {
+          backgroundStatus,
+          loadedInBackground: initiallyLoadedInBackground,
+          wasBackgrounded: backgroundStatus,
+          backgroundTime,
+          firstHiddenTime: firstHiddenEntry ? firstHiddenEntry.startTime : Infinity,
+          fallbackActive: false,
+          unreliableForAsync: false,
+          detectionMethod: 'visibility-state (Performance API)'
+        };
+
+        console.log('Background Tab Detection:', detectionInfo);
+
+        // Observe future visibility transitions if the tab has not yet been backgrounded
+        if (!firstHiddenEntry && typeof PerformanceObserver !== 'undefined') {
+          try {
+            const observer = new PerformanceObserver((list) => {
+              const hiddenEntry = list.getEntries().find((entry) => entry.name === 'hidden');
+              if (hiddenEntry) {
+                console.log('Background Tab Detection:', {
+                  backgroundStatus: true,
+                  loadedInBackground: initiallyLoadedInBackground,
+                  wasBackgrounded: true,
+                  backgroundTime: hiddenEntry.startTime,
+                  firstHiddenTime: hiddenEntry.startTime,
+                  fallbackActive: false,
+                  unreliableForAsync: false,
+                  detectionMethod: 'visibility-state (PerformanceObserver)'
+                });
+                observer.disconnect();
+              }
+            });
+            observer.observe({ type: 'visibility-state', buffered: true });
+          } catch (err) {
+            // Ignore observer registration errors if unsupported
+          }
+        }
+      } else {
+        // =========================================================================
+        // WARNING: LEGACY FALLBACK DETECTION ACTIVE (POTENTIALLY UNRELIABLE)
+        // =========================================================================
+        // Direct queries to `document.visibilityState` / `document.hidden` and
+        // `visibilitychange` listeners are highly inaccurate for async or deferred
+        // scripts:
+        // 1. If the page loaded in a background tab at t=0ms, but the user brought
+        //    it to the foreground before this script ran, `document.visibilityState`
+        //    will report 'visible' (false negative).
+        // 2. If the page loaded in the foreground at t=0ms, but the user switched
+        //    tabs before this script ran, `document.visibilityState` will report
+        //    'hidden' without the true transition timestamp (false positive for
+        //    initial background load and inaccurate timestamp).
+        const isCurrentlyHidden =
+          document.visibilityState === 'hidden' || Boolean(document.hidden);
+        const fallbackTimestamp = isCurrentlyHidden
+          ? (typeof performance !== 'undefined' && typeof performance.now === 'function'
+              ? performance.now()
+              : Date.now())
+          : null;
+
+        const fallbackDetectionInfo = {
+          backgroundStatus: isCurrentlyHidden,
+          loadedInBackground: isCurrentlyHidden,
+          wasBackgrounded: isCurrentlyHidden,
+          backgroundTime: fallbackTimestamp,
+          firstHiddenTime: isCurrentlyHidden ? 0 : Infinity,
+          fallbackActive: true,
+          unreliableForAsync: true,
+          detectionMethod: 'Legacy Page Visibility API Fallback (UNRELIABLE FOR ASYNC SCRIPTS)',
+          warning:
+            'Fallback detection is active. Legacy document.visibilityState queries are inaccurate for async scripts because visibility changes prior to script execution cannot be accurately timestamped or distinguished from initial state.'
+        };
+
+        console.warn(
+          '[Unreliable Fallback Active] visibility-state PerformanceEntry API is unavailable; using legacy Page Visibility fallback which is inaccurate for async scripts.'
+        );
+        console.log('Background Tab Detection:', fallbackDetectionInfo);
+
+        if (!isCurrentlyHidden) {
+          document.addEventListener(
+            'visibilitychange',
+            function onFirstHidden(event) {
+              if (document.visibilityState === 'hidden' || document.hidden) {
+                const hiddenTime =
+                  typeof event.timeStamp === 'number'
+                    ? event.timeStamp
+                    : typeof performance !== 'undefined' && typeof performance.now === 'function'
+                    ? performance.now()
+                    : Date.now();
+
+                console.log('Background Tab Detection:', {
+                  backgroundStatus: true,
+                  loadedInBackground: false,
+                  wasBackgrounded: true,
+                  backgroundTime: hiddenTime,
+                  firstHiddenTime: hiddenTime,
+                  fallbackActive: true,
+                  unreliableForAsync: true,
+                  detectionMethod: 'Legacy Page Visibility API Fallback (UNRELIABLE FOR ASYNC SCRIPTS)',
+                  warning:
+                    'Fallback detection is active. Legacy visibilitychange listeners are potentially unreliable for async scripts.'
+                });
+
+                document.removeEventListener('visibilitychange', onFirstHidden);
+              }
+            }
+          );
+        }
+      }
+    })();
+  </script>
+
