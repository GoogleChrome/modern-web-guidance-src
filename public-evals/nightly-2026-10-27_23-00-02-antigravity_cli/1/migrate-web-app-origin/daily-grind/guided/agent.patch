+  <script>
+    (function () {
+      const OLD_ORIGIN = 'https://old-app.dailygrind.com';
+      const NEW_ORIGIN = 'https://new-app.dailygrind.com';
+      const STORAGE_KEY = 'daily_grind_user_config';
+
+      const banner = document.getElementById('migration-banner');
+      const migrateLink = document.getElementById('migrate-link');
+      const exportLink = document.getElementById('export-migration-link');
+      const dismissBtn = document.getElementById('dismiss-migration');
+      const favDrinkSelect = document.getElementById('fav-drink');
+      const savePrefsBtn = document.getElementById('save-prefs-btn');
+      const prefsStatus = document.getElementById('prefs-status');
+
+      function loadConfig() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          return raw ? JSON.parse(raw) : { favoriteDrink: 'maple-oat-latte' };
+        } catch {
+          return { favoriteDrink: 'maple-oat-latte' };
+        }
+      }
+
+      function saveConfig(config) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(config));
+        } catch {
+          // Ignore storage quota/privacy errors
+        }
+      }
+
+      function updateMigrationLinks(config) {
+        const targetUrl = new URL('/index.html', NEW_ORIGIN);
+        targetUrl.searchParams.set('migrated_config', JSON.stringify(config));
+        if (migrateLink) migrateLink.href = targetUrl.toString();
+        if (exportLink) exportLink.href = targetUrl.toString();
+      }
+
+      // 1. Import user configuration if arriving from predecessor origin handover
+      const params = new URLSearchParams(window.location.search);
+      const incomingConfigRaw = params.get('migrated_config');
+      if (incomingConfigRaw) {
+        try {
+          const incomingConfig = JSON.parse(incomingConfigRaw);
+          saveConfig(incomingConfig);
+          if (prefsStatus) {
+            prefsStatus.textContent = 'User configuration successfully restored on the new origin.';
+          }
+          const cleanUrl = new URL(window.location.href);
+          cleanUrl.searchParams.delete('migrated_config');
+          window.history.replaceState({}, '', cleanUrl.toString());
+        } catch {
+          // Ignore malformed config parameter
+        }
+      }
+
+      // 2. Listen for cross-origin configuration sync between same-site origins
+      window.addEventListener('message', (event) => {
+        if (event.origin !== OLD_ORIGIN && event.origin !== NEW_ORIGIN) return;
+        if (event.data && event.data.type === 'REQUEST_USER_CONFIG') {
+          event.source?.postMessage(
+            { type: 'USER_CONFIG_PAYLOAD', config: loadConfig() },
+            event.origin
+          );
+        } else if (event.data && event.data.type === 'USER_CONFIG_PAYLOAD' && event.data.config) {
+          saveConfig(event.data.config);
+          if (favDrinkSelect && event.data.config.favoriteDrink) {
+            favDrinkSelect.value = event.data.config.favoriteDrink;
+          }
+        }
+      });
+
+      const currentConfig = loadConfig();
+      if (favDrinkSelect && currentConfig.favoriteDrink) {
+        favDrinkSelect.value = currentConfig.favoriteDrink;
+      }
+      updateMigrationLinks(currentConfig);
+
+      if (savePrefsBtn && favDrinkSelect) {
+        savePrefsBtn.addEventListener('click', () => {
+          const updated = {
+            ...loadConfig(),
+            favoriteDrink: favDrinkSelect.value,
+            updatedAt: new Date().toISOString()
+          };
+          saveConfig(updated);
+          updateMigrationLinks(updated);
+          if (prefsStatus) {
+            prefsStatus.textContent = 'Preferences saved and ready for origin migration.';
+          }
+        });
+      }
+
+      // 3. Fallback UI prompt for browsers that do not support automatic Web App Origin Migration
+      // Show the manual migration banner when on the old origin or when testing locally
+      if (banner && window.location.origin !== NEW_ORIGIN) {
+        banner.hidden = false;
+      }
+
+      if (dismissBtn && banner) {
+        dismissBtn.addEventListener('click', () => {
+          banner.hidden = true;
+        });
+      }
+    })();
+  </script>
+
 </body>
 
