+  <script type="module">
+    const previewEl = document.getElementById("seasonal-preview");
+    const defaultText = "Select a drink to preview";
+
+    previewEl.addEventListener("interest", (event) => {
+      const drink = event.source?.dataset.drink || event.source?.closest(".card")?.querySelector("h3")?.textContent;
+      if (drink) {
+        previewEl.textContent = drink;
+        previewEl.dataset.preview = drink;
+      }
+    });
+
+    previewEl.addEventListener("loseinterest", () => {
+      previewEl.textContent = defaultText;
+      delete previewEl.dataset.preview;
+    });
+
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+  </script>
