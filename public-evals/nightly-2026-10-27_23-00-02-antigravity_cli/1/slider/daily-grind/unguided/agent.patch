+  <script>
+    (function () {
+      const slider = document.getElementById('brew-strength-slider');
+      const output = document.getElementById('brew-strength-value');
+      const description = document.getElementById('brew-strength-description');
+      const scaleTicks = document.querySelectorAll('.brew-scale-labels span');
+
+      const profiles = {
+        1: {
+          name: 'Mild',
+          title: 'Mild & Delicate Profile',
+          notes: 'Light, floral notes with a clean, tea-like finish and subtle sweetness.'
+        },
+        2: {
+          name: 'Light-Medium',
+          title: 'Light-Medium Profile',
+          notes: 'Crisp citrus brightness paired with toasted grain and honeyed undertones.'
+        },
+        3: {
+          name: 'Medium',
+          title: 'Medium Roast Profile',
+          notes: 'Balanced body with caramel sweetness and smooth acidity.'
+        },
+        4: {
+          name: 'Bold',
+          title: 'Bold & Rich Profile',
+          notes: 'Full-bodied extraction with dark chocolate depth and roasted hazelnut warmth.'
+        },
+        5: {
+          name: 'Extra Strong',
+          title: 'Extra Strong Espresso Profile',
+          notes: 'Intense, velvety crema with smoky molasses notes and maximum caffeine kick.'
+        }
+      };
+
+      function updateBrewStrength() {
+        const min = Number(slider.min) || 1;
+        const max = Number(slider.max) || 5;
+        const val = Number(slider.value) || 3;
+        const percentage = Math.round(((val - min) / (max - min)) * 100);
+
+        slider.style.setProperty('--slider-progress', percentage + '%');
+
+        const profile = profiles[val] || profiles[3];
+        output.textContent = `${val} — ${profile.name} (${percentage}%)`;
+        description.innerHTML = `<strong>${profile.title}:</strong> ${profile.notes}`;
+
+        slider.setAttribute('aria-valuenow', String(val));
+        slider.setAttribute('aria-valuetext', `Level ${val} of ${max}: ${profile.name} — ${profile.notes}`);
+
+        scaleTicks.forEach((tick) => {
+          const tickLevel = Number(tick.getAttribute('data-level'));
+          tick.classList.toggle('active', tickLevel === val);
+        });
+      }
+
+      if (slider) {
+        slider.addEventListener('input', updateBrewStrength);
+        slider.addEventListener('change', updateBrewStrength);
+
+        scaleTicks.forEach((tick) => {
+          tick.addEventListener('click', () => {
+            const level = tick.getAttribute('data-level');
+            if (level) {
+              slider.value = level;
+              updateBrewStrength();
+              slider.focus();
+            }
+          });
+        });
+
+        updateBrewStrength();
+      }
+    })();
+  </script>
