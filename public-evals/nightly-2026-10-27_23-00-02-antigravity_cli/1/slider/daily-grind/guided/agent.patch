+  <script>
+    const slider = document.querySelector('#brew-strength');
+    const output = document.querySelector('#brew-strength-output');
+
+    function getBrewStrengthLabel(val) {
+      const num = Number(val);
+      if (num < 25) return 'Light';
+      if (num < 50) return 'Medium';
+      if (num < 75) return 'Medium-Bold';
+      if (num < 90) return 'Bold';
+      return 'Extra Bold';
+    }
+
+    function syncSliderValue() {
+      slider.style.setProperty('--attr-min', slider.min || 0);
+      slider.style.setProperty('--attr-max', slider.max || 100);
+      slider.style.setProperty('--control-value', slider.value);
+
+      const formatted = `${getBrewStrengthLabel(slider.value)} (${slider.value}%)`;
+      output.textContent = formatted;
+      slider.setAttribute('aria-valuetext', formatted);
+    }
+
+    syncSliderValue();
+    slider.addEventListener('input', syncSliderValue);
+  </script>
 </body>
 
