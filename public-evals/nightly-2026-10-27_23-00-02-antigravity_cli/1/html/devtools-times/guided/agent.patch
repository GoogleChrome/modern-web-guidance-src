+
+/* Visually hidden utility for screen-reader-only content */
+.visually-hidden:not(:focus):not(:active) {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+
+/* Skip link for keyboard navigation */
+.skip-link {
+  position: absolute;
+  top: 0.5rem;
+  left: 0.5rem;
+  z-index: 100000;
+  padding: 0.5rem 1rem;
+  background-color: #111827;
+  color: #ffffff;
+  font-weight: 600;
+  border-radius: 0.25rem;
+  text-decoration: none;
+}
+
+.skip-link:not(:focus):not(:active) {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+
+/* Focus visibility */
+:focus-visible {
+  outline: 2px solid #f59e0b;
+  outline-offset: 2px;
+}
+
+main:focus {
+  outline: none;
+}
+
+/* Prevent page scroll under modal dialogs */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  overflow: hidden;
+  overscroll-behavior: contain;
+}
+
+/* Popover styling with @oddbird/popover-polyfill class support */
+[popover] {
+  margin: 0;
+  padding: 0;
+  border: none;
+  background: transparent;
+}
+
+[popover]:is(:popover-open, .\:popover-open) {
+  display: block;
+}
+
+/* Inert subtree indicator */
+[inert] {
+  pointer-events: none;
+  user-select: none;
+}
