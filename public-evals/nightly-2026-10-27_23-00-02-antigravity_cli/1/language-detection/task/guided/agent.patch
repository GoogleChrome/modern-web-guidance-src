+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackTextarea = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const progressContainer = document.getElementById('download-progress-container');
+    const progressBar = document.getElementById('model-download-progress');
+    const progressText = document.getElementById('download-progress-text');
+    const resultOutput = document.getElementById('detection-result');
+
+    const languageNames = typeof Intl !== 'undefined' && Intl.DisplayNames
+      ? new Intl.DisplayNames(['en'], { type: 'language' })
+      : null;
+
+    function getLanguageName(code) {
+      if (!code || code === 'und') return 'Undetermined';
+      if (languageNames) {
+        try {
+          return languageNames.of(code) || code;
+        } catch {
+          return code;
+        }
+      }
+      return code;
+    }
+
+    function showMessage(text) {
+      resultOutput.textContent = text;
+      resultOutput.hidden = false;
+    }
+
+    let detectorInstance = null;
+
+    async function checkFeatureAvailability() {
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        showMessage('Built-in language detection is not supported in this browser.');
+        return 'unavailable';
+      }
+
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          detectBtn.disabled = true;
+          showMessage('Built-in language detection is currently unavailable on this device.');
+        }
+        return availability;
+      } catch {
+        detectBtn.disabled = true;
+        showMessage('Unable to check language detection availability.');
+        return 'unavailable';
+      }
+    }
+
+    checkFeatureAvailability();
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+
+      const text = feedbackTextarea.value.trim();
+      if (!text) {
+        showMessage('Please enter a feedback message to detect its language.');
+        feedbackTextarea.focus();
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        showMessage('Built-in language detection is not supported in this browser.');
+        return;
+      }
+
+      try {
+        detectBtn.disabled = true;
+        const availability = await LanguageDetector.availability();
+
+        if (availability === 'unavailable') {
+          showMessage('Built-in language detection is currently unavailable on this device.');
+          return;
+        }
+
+        if (!detectorInstance) {
+          if (availability === 'downloadable' || availability === 'downloading') {
+            progressContainer.hidden = false;
+            progressBar.value = 0;
+            progressText.textContent = '0%';
+          }
+
+          detectorInstance = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = Math.round((e.loaded || 0) * 100);
+                console.log(`Downloaded ${e.loaded * 100}%`);
+                progressContainer.hidden = false;
+                progressBar.value = percent;
+                progressText.textContent = `${percent}%`;
+              });
+            },
+          });
+
+          progressContainer.hidden = true;
+        }
+
+        const results = await detectorInstance.detect(text);
+        if (results && results.length > 0) {
+          const topResult = results[0];
+          const languageName = getLanguageName(topResult.detectedLanguage);
+          const confidencePercent = (topResult.confidence * 100).toFixed(1);
+          showMessage(`Detected Language: ${languageName} (${topResult.detectedLanguage}) — Confidence: ${confidencePercent}%`);
+        } else {
+          showMessage('Could not determine the language of the provided message.');
+        }
+      } catch (error) {
+        progressContainer.hidden = true;
+        showMessage(`Language detection failed: ${error.message || 'Unknown error'}`);
+      } finally {
+        if ('LanguageDetector' in self) {
+          detectBtn.disabled = false;
+        }
+      }
+    });
+  </script>
