+  <script>
+    const feedbackInput = document.getElementById('feedback-message');
+    const detectBtn = document.getElementById('detect-btn');
+    const progressContainer = document.getElementById('download-progress-container');
+    const progressText = document.getElementById('download-progress-text');
+    const progressBar = document.getElementById('download-progress-bar');
+    const detectionResult = document.getElementById('detection-result');
+
+    let detectorInstance = null;
+
+    function getLanguageName(langTag) {
+      if (!langTag) return 'Unknown';
+      try {
+        const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+        return displayNames.of(langTag) || langTag;
+      } catch {
+        return langTag;
+      }
+    }
+
+    function updateProgress(percent) {
+      const clamped = Math.max(0, Math.min(100, Math.round(percent)));
+      progressContainer.hidden = false;
+      progressText.textContent = `Downloading language model: ${clamped}%`;
+      progressBar.value = clamped;
+    }
+
+    function showResult(htmlContent) {
+      detectionResult.innerHTML = htmlContent;
+      detectionResult.hidden = false;
+    }
+
+    async function getOrCreateDetector() {
+      if (detectorInstance) {
+        return detectorInstance;
+      }
+
+      const DetectorAPI = self.LanguageDetector || self.ai?.languageDetector;
+      const legacyTranslation = !DetectorAPI && self.translation;
+
+      if (!DetectorAPI && !legacyTranslation) {
+        throw new Error('Built-in language detection API is not supported in this browser.');
+      }
+
+      let availability = 'available';
+      if (DetectorAPI) {
+        if (typeof DetectorAPI.availability === 'function') {
+          availability = await DetectorAPI.availability();
+        } else if (typeof DetectorAPI.capabilities === 'function') {
+          const caps = await DetectorAPI.capabilities();
+          availability = caps?.available || caps?.capabilities || 'unavailable';
+        }
+      } else if (legacyTranslation && typeof legacyTranslation.canDetect === 'function') {
+        availability = await legacyTranslation.canDetect();
+      }
+
+      if (availability === 'unavailable' || availability === 'no') {
+        throw new Error('Language detection is currently unavailable on this device.');
+      }
+
+      const needsDownload =
+        availability === 'downloadable' ||
+        availability === 'downloading' ||
+        availability === 'after-download';
+
+      if (needsDownload) {
+        updateProgress(0);
+      }
+
+      const createOptions = {
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            let percent = 0;
+            if (typeof e.loaded === 'number') {
+              if (e.total && e.total > 1) {
+                percent = (e.loaded / e.total) * 100;
+              } else if (e.loaded > 1) {
+                percent = e.loaded;
+              } else {
+                percent = e.loaded * 100;
+              }
+            }
+            updateProgress(percent);
+          });
+        }
+      };
+
+      if (DetectorAPI) {
+        detectorInstance = await DetectorAPI.create(createOptions);
+      } else {
+        detectorInstance = await legacyTranslation.createDetector(createOptions);
+      }
+
+      if (detectorInstance.ready) {
+        await detectorInstance.ready;
+      }
+
+      return detectorInstance;
+    }
+
+    detectBtn.addEventListener('click', async () => {
+      const text = feedbackInput.value.trim();
+      if (!text) {
+        showResult('Please enter a message to detect its language.');
+        return;
+      }
+
+      detectBtn.disabled = true;
+      showResult('Detecting language...');
+
+      try {
+        const detector = await getOrCreateDetector();
+        const results = await detector.detect(text);
+
+        if (!results || results.length === 0) {
+          showResult('Could not detect the language of the message.');
+          return;
+        }
+
+        const topResult = results[0];
+        const languageName = getLanguageName(topResult.detectedLanguage);
+        const confidencePercent = Math.round(topResult.confidence * 100);
+
+        showResult(
+          `<strong>Language:</strong> ${languageName} (${topResult.detectedLanguage})<br>` +
+          `<strong>Confidence:</strong> ${confidencePercent}%`
+        );
+      } catch (err) {
+        showResult(err.message || 'An error occurred during language detection.');
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
