+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const roastSlider = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-output');
+      const progressBar = document.getElementById('setup-progress');
+      const progressOutput = document.getElementById('progress-output');
+      const statusMsg = document.getElementById('subscription-status');
+      const emailCheckbox = document.getElementById('receive-emails');
+      const frequencyRadios = form.querySelectorAll('input[name="delivery_frequency"]');
+
+      const roastLabels = {
+        1: 'Light Roast (1 / 5)',
+        2: 'Medium-Light (2 / 5)',
+        3: 'Medium (3 / 5)',
+        4: 'Medium-Dark (4 / 5)',
+        5: 'Dark Espresso (5 / 5)'
+      };
+
+      function updateRangeVisuals() {
+        const val = Number(roastSlider.value);
+        const min = Number(roastSlider.min) || 1;
+        const max = Number(roastSlider.max) || 5;
+        const pct = ((val - min) / (max - min)) * 100;
+        roastOutput.textContent = roastLabels[val] || `${val} / 5`;
+        if (!CSS.supports('accent-color', '#4e342e')) {
+          roastSlider.style.setProperty('--progress', `${pct}%`);
+        }
+      }
+
+      function updateProgress() {
+        let completedSteps = 0;
+        const totalSteps = 3;
+
+        const hasFrequency = Array.from(frequencyRadios).some((r) => r.checked);
+        if (hasFrequency) completedSteps += 1;
+        if (roastSlider.value) completedSteps += 1;
+        if (emailCheckbox.checked) completedSteps += 1;
+
+        const pct = Math.round((completedSteps / totalSteps) * 100);
+        progressBar.value = pct;
+        progressBar.textContent = `${pct}%`;
+        progressOutput.textContent = `${pct}%`;
+      }
+
+      roastSlider.addEventListener('input', () => {
+        updateRangeVisuals();
+        updateProgress();
+      });
+
+      emailCheckbox.addEventListener('change', updateProgress);
+      frequencyRadios.forEach((radio) => {
+        radio.addEventListener('change', updateProgress);
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        progressBar.value = 100;
+        progressBar.textContent = '100%';
+        progressOutput.textContent = '100%';
+        const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+        const freqText = selectedFreq ? selectedFreq.value : 'weekly';
+        statusMsg.textContent = `✓ Subscription saved! Delivering ${roastLabels[roastSlider.value]} on a ${freqText} schedule.`;
+      });
+
+      updateRangeVisuals();
+      updateProgress();
+    })();
+  </script>
+
