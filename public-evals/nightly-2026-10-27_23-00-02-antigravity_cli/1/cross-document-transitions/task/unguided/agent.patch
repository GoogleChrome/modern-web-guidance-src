+  <script>
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pageswap', (event) => {
+        if (!event.viewTransition) return;
+        const targetUrl = event.activation?.entry?.url || '';
+        const nextLink = document.getElementById('next');
+        const prevLink = document.getElementById('previous');
+
+        if (nextLink && targetUrl === nextLink.href) {
+          event.viewTransition.types.add('next');
+        } else if (prevLink && targetUrl === prevLink.href) {
+          event.viewTransition.types.add('previous');
+        }
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition) return;
+        const fromEntry = navigation?.activation?.from;
+        const toEntry = navigation?.activation?.entry;
+        const currentUrl = toEntry?.url || window.location.href;
+        const nextLink = document.getElementById('next');
+        const prevLink = document.getElementById('previous');
+
+        if (nextLink && currentUrl === nextLink.href) {
+          event.viewTransition.types.add('next');
+        } else if (prevLink && currentUrl === prevLink.href) {
+          event.viewTransition.types.add('previous');
+        } else if (fromEntry && toEntry && typeof fromEntry.index === 'number' && typeof toEntry.index === 'number') {
+          if (toEntry.index > fromEntry.index) {
+            event.viewTransition.types.add('next');
+          } else if (toEntry.index < fromEntry.index) {
+            event.viewTransition.types.add('previous');
+          }
+        }
+      });
+    }
+  </script>
