+  <script>
+    (function () {
+      const viewport = document.getElementById('cafe-map-viewport');
+      const surface = document.getElementById('cafe-map-surface');
+      const readout = document.getElementById('map-coords-readout');
+      const resetBtn = document.getElementById('map-reset-btn');
+      const pills = document.querySelectorAll('.map-pill[data-target]');
+      const markers = document.querySelectorAll('.cafe-marker');
+
+      if (!viewport || !surface) return;
+
+      let isDragging = false;
+      let lastX = 0;
+      let lastY = 0;
+      let panX = 0;
+      let panY = 0;
+
+      function updateReadout() {
+        const x = Math.round(viewport.scrollLeft);
+        const y = Math.round(viewport.scrollTop);
+        viewport.setAttribute('data-scroll-x', String(x));
+        viewport.setAttribute('data-scroll-y', String(y));
+        if (readout) {
+          readout.textContent = 'Pan: X ' + x + 'px, Y ' + y + 'px';
+        }
+      }
+
+      function centerOnPoint(targetX, targetY) {
+        const maxScrollX = Math.max(0, surface.offsetWidth - viewport.clientWidth);
+        const maxScrollY = Math.max(0, surface.offsetHeight - viewport.clientHeight);
+        panX = Math.max(0, Math.min(maxScrollX, targetX - viewport.clientWidth / 2));
+        panY = Math.max(0, Math.min(maxScrollY, targetY - viewport.clientHeight / 2));
+        viewport.scrollLeft = panX;
+        viewport.scrollTop = panY;
+        updateReadout();
+      }
+
+      // Initialize centered on the flagship Roastery HQ (1200, 900) so the user can immediately pan in any direction
+      centerOnPoint(1200, 900);
+
+      function startDrag(clientX, clientY) {
+        isDragging = true;
+        lastX = clientX;
+        lastY = clientY;
+        panX = viewport.scrollLeft;
+        panY = viewport.scrollTop;
+        viewport.classList.add('is-panning');
+      }
+
+      function moveDrag(clientX, clientY) {
+        if (!isDragging) return;
+        const dx = clientX - lastX;
+        const dy = clientY - lastY;
+        if (dx === 0 && dy === 0) return;
+        lastX = clientX;
+        lastY = clientY;
+
+        // Apply both horizontal and vertical deltas simultaneously on every frame without locking to a single axis
+        const maxScrollX = Math.max(0, surface.offsetWidth - viewport.clientWidth);
+        const maxScrollY = Math.max(0, surface.offsetHeight - viewport.clientHeight);
+        panX = Math.max(0, Math.min(maxScrollX, panX - dx));
+        panY = Math.max(0, Math.min(maxScrollY, panY - dy));
+        viewport.scrollLeft = panX;
+        viewport.scrollTop = panY;
+        updateReadout();
+      }
+
+      function endDrag() {
+        if (!isDragging) return;
+        isDragging = false;
+        viewport.classList.remove('is-panning');
+      }
+
+      viewport.addEventListener('pointerdown', function (e) {
+        if (e.button !== undefined && e.button !== 0) return;
+        startDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointermove', function (e) {
+        if (!isDragging) return;
+        moveDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointerup', endDrag);
+      window.addEventListener('pointercancel', endDrag);
+
+      viewport.addEventListener('mousedown', function (e) {
+        if (e.button !== 0) return;
+        startDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (!isDragging) return;
+        moveDrag(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', endDrag);
+
+      viewport.addEventListener('touchstart', function (e) {
+        if (e.touches.length === 1) {
+          startDrag(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+
+      viewport.addEventListener('touchmove', function (e) {
+        if (!isDragging || e.touches.length !== 1) return;
+        moveDrag(e.touches[0].clientX, e.touches[0].clientY);
+      }, { passive: true });
+
+      viewport.addEventListener('touchend', endDrag);
+      viewport.addEventListener('touchcancel', endDrag);
+
+      viewport.addEventListener('scroll', function () {
+        if (!isDragging) {
+          panX = viewport.scrollLeft;
+          panY = viewport.scrollTop;
+        }
+        updateReadout();
+      }, { passive: true });
+
+      function selectLocation(cafeId, shouldPan) {
+        pills.forEach(function (pill) {
+          pill.classList.toggle('active', pill.getAttribute('data-target') === cafeId);
+        });
+        markers.forEach(function (marker) {
+          const isMatch = marker.getAttribute('data-cafe-id') === cafeId;
+          marker.classList.toggle('active', isMatch);
+          if (isMatch && shouldPan) {
+            const x = parseFloat(marker.style.left) || 1200;
+            const y = parseFloat(marker.style.top) || 900;
+            centerOnPoint(x, y);
+          }
+        });
+      }
+
+      pills.forEach(function (pill) {
+        pill.addEventListener('click', function () {
+          selectLocation(pill.getAttribute('data-target'), true);
+        });
+      });
+
+      markers.forEach(function (marker) {
+        marker.addEventListener('click', function () {
+          selectLocation(marker.getAttribute('data-cafe-id'), false);
+        });
+      });
+
+      if (resetBtn) {
+        resetBtn.addEventListener('click', function () {
+          selectLocation('roastery-hq', true);
+        });
+      }
+    })();
+  </script>
