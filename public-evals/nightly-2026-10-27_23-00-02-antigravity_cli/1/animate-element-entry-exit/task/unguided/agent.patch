+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promoDeals = [
+      {
+        badge: 'Member Exclusive',
+        title: 'Double Bean Points',
+        description: 'Earn 2x rewards points on all whole-bean coffee bag purchases all week.'
+      },
+      {
+        badge: 'Happy Hour',
+        title: '50% Off Cold Brews',
+        description: 'Cool down every afternoon from 2 PM to 4 PM with half-price cold brews.'
+      },
+      {
+        badge: 'Weekend Special',
+        title: 'Artisan Flight Tasting',
+        description: 'Sample three single-origin espresso pours paired with dark chocolate.'
+      }
+    ];
+    let promoIndex = 0;
+
+    addBtn.addEventListener('click', () => {
+      const deal = promoDeals[promoIndex % promoDeals.length];
+      promoIndex++;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <span class="promo-badge">${deal.badge}</span>
+        <h3>${deal.title}</h3>
+        <p>${deal.description}</p>
+        <a href="/rewards" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.classList.add('removing');
+      let cleanedUp = false;
+      const removeNode = () => {
+        if (!cleanedUp) {
+          cleanedUp = true;
+          lastCard.remove();
+        }
+      };
+      lastCard.addEventListener('transitionend', removeNode, { once: true });
+      setTimeout(removeNode, 360);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+    });
+  </script>
