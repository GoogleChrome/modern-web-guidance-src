+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      if (!gallery) return;
+
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+      let activeIndex = 0;
+      let lastSnapChangingTarget = -1;
+
+      function getItemOffset(item) {
+        const baseOffset = items[0] ? items[0].offsetLeft : 0;
+        return item.offsetLeft - baseOffset;
+      }
+
+      function getClosestItemIndex() {
+        const scrollLeft = gallery.scrollLeft;
+        let closestIdx = 0;
+        let minDistance = Infinity;
+        items.forEach((item, index) => {
+          const distance = Math.abs(getItemOffset(item) - scrollLeft);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIdx = index;
+          }
+        });
+        return closestIdx;
+      }
+
+      function setPending(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        thumbnails.forEach((thumb, i) => {
+          thumb.classList.toggle('pending', i === index);
+        });
+      }
+
+      function setActive(index) {
+        if (index < 0 || index >= thumbnails.length) return;
+        activeIndex = index;
+        lastSnapChangingTarget = -1;
+        thumbnails.forEach((thumb, i) => {
+          thumb.classList.remove('pending');
+          if (i === index) {
+            thumb.classList.add('active');
+            thumb.setAttribute('aria-current', 'true');
+          } else {
+            thumb.classList.remove('active');
+            thumb.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        const target = event.snapTargetInline || event.snapTargetBlock;
+        const index = items.indexOf(target);
+        if (index !== -1) {
+          lastSnapChangingTarget = index;
+          setPending(index);
+        }
+      });
+
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const target = event.snapTargetInline || event.snapTargetBlock;
+        let index = items.indexOf(target);
+        if (index === -1) {
+          index = lastSnapChangingTarget !== -1 ? lastSnapChangingTarget : getClosestItemIndex();
+        }
+        setActive(index);
+      });
+
+      gallery.addEventListener('scroll', () => {
+        if (lastSnapChangingTarget !== -1 && lastSnapChangingTarget !== activeIndex) {
+          return;
+        }
+        const scrollLeft = gallery.scrollLeft;
+        const activeOffset = items[activeIndex] ? getItemOffset(items[activeIndex]) : 0;
+        const delta = scrollLeft - activeOffset;
+        const closestIdx = getClosestItemIndex();
+
+        if (closestIdx !== activeIndex) {
+          setPending(closestIdx);
+        } else if (delta > 5 && activeIndex < items.length - 1) {
+          setPending(activeIndex + 1);
+        } else if (delta < -5 && activeIndex > 0) {
+          setPending(activeIndex - 1);
+        }
+      });
+
+      gallery.addEventListener('scrollend', () => {
+        const hasPending = thumbnails.some((thumb) => thumb.classList.contains('pending'));
+        const closestIdx = getClosestItemIndex();
+        if (hasPending || closestIdx !== activeIndex) {
+          const targetIdx = lastSnapChangingTarget !== -1 ? lastSnapChangingTarget : closestIdx;
+          setActive(targetIdx);
+        }
+      });
+
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          if (items[index]) {
+            lastSnapChangingTarget = index;
+            setPending(index);
+            gallery.scrollTo({
+              left: getItemOffset(items[index]),
+              behavior: 'smooth'
+            });
+          }
+        });
+      });
+    })();
+  </script>
+
