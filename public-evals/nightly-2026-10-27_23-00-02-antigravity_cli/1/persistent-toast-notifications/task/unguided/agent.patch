+    /* Toast Notifications (Top Layer via Popover API, pure CSS stacking) */
+    .toast {
+      --toast-offset: 0;
+      position: fixed;
+      inset: auto 24px calc(24px + (var(--toast-offset) * 72px)) auto;
+      margin: 0;
+      border: 1px solid rgba(255, 171, 64, 0.35);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
