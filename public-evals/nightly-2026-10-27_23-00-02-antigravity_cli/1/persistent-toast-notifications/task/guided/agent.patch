+  <script type="module">
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    let toastIdCounter = 0;
+    let supportsDisplayTransition;
+
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.("transition-behavior", "allow-discrete") || !document.body) {
+        return false;
+      }
+      const probe = document.createElement("div");
+      probe.style.cssText = "transition: display 1s allow-discrete !important; display: block;";
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = "none";
+      supportsDisplayTransition = getComputedStyle(probe).display === "block";
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.("overlay", "auto") && canTransitionDisplay();
+    }
+
+    function syncSiblingIndexFallback() {
+      if (!window.CSS?.supports?.("top: calc(sibling-index() * 1px)")) {
+        const toasts = document.querySelectorAll(".toast");
+        toasts.forEach((item, index) => {
+          item.style.setProperty("--sibling-index", index + 1);
+          item.style.setProperty("--sibling-count", toasts.length);
+        });
+      }
+    }
+
+    async function closeToast(toast) {
+      if (!toast.isConnected || toast.dataset.dismissing === "true") return;
+      toast.dataset.dismissing = "true";
+
+      if (!supportsTopLayerExit()) {
+        toast.setAttribute("data-closing", "");
+        const animations = toast.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!toast.hasAttribute("data-closing")) return;
+        toast.removeAttribute("data-closing");
+      }
+
+      if (typeof toast.hidePopover === "function") {
+        try {
+          toast.hidePopover();
+        } catch {}
+      }
+
+      if (supportsTopLayerExit()) {
+        const animations = toast.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+      }
+
+      toast.remove();
+      syncSiblingIndexFallback();
+    }
+
+    function showToast(message = "added to cart!") {
+      const id = `toast-${++toastIdCounter}`;
+      const toast = document.createElement("div");
+      toast.id = id;
+      toast.className = "toast";
+      toast.setAttribute("popover", "manual");
+      toast.setAttribute("role", "status");
+      toast.setAttribute("aria-live", "polite");
+
+      const textSpan = document.createElement("span");
+      textSpan.className = "toast-message";
+      textSpan.textContent = message;
+
+      const closeBtn = document.createElement("button");
+      closeBtn.type = "button";
+      closeBtn.className = "toast-close";
+      closeBtn.setAttribute("popovertarget", id);
+      closeBtn.setAttribute("popovertargetaction", "hide");
+      closeBtn.setAttribute("aria-label", "Close notification");
+      closeBtn.innerHTML = "&times;";
+
+      toast.append(textSpan, closeBtn);
+      document.body.appendChild(toast);
+      syncSiblingIndexFallback();
+
+      if (typeof toast.showPopover === "function") {
+        toast.showPopover();
+      }
+
+      const timer = setTimeout(() => {
+        closeToast(toast);
+      }, 3000);
+
+      closeBtn.addEventListener("click", (event) => {
+        event.preventDefault();
+        clearTimeout(timer);
+        closeToast(toast);
+      });
+    }
+
+    document.querySelectorAll(".toast-trigger").forEach((trigger) => {
+      trigger.addEventListener("click", () => {
+        showToast("added to cart!");
+      });
+    });
+  </script>
