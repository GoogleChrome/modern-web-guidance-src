+    }
+    if (normalized.endsWith('/legal/terms')) {
+        return [
+            { id: 'terms', title: '1. Terms' },
+            { id: 'use-license', title: '2. Use License' },
+            { id: 'disclaimer', title: '3. Disclaimer' },
+        ];
+    }
+    if (normalized.endsWith('/legal/privacy')) {
+        return [
+            { id: 'overview-of-data-protection', title: '1. Overview' },
+            { id: 'general-information', title: '2. General Information' },
+            { id: 'recording-of-data', title: '3. Recording of Data' },
+        ];
+    }
+    if (normalized.includes('/category/')) {
+        return [
+            { id: 'featured-story', title: 'Featured Story' },
+            { id: 'more-articles', title: 'More Articles' },
+        ];
+    }
+    if (normalized.includes('/articles/')) {
+        return [
+            { id: 'article-overview', title: 'Article' },
+            { id: 'related-articles', title: 'Related Articles' },
+        ];
+    }
+    return [];
+}
