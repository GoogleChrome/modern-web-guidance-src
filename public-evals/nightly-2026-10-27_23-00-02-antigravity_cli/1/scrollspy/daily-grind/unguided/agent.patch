+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      const navLinks = Array.from(document.querySelectorAll('nav a[href^="#"]'));
+      const sections = navLinks
+        .map(link => document.querySelector(link.getAttribute('href')))
+        .filter(Boolean);
+
+      function setActiveLink(sectionId) {
+        navLinks.forEach(link => {
+          const isMatch = link.getAttribute('href') === '#' + sectionId;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function updateActiveSection() {
+        if (!sections.length) return;
+
+        const navHeight = nav ? nav.offsetHeight : 64;
+        const viewportHeight = window.innerHeight;
+        const refLine = navHeight + (viewportHeight - navHeight) * 0.3;
+
+        // Check if scrolled to the bottom of the page
+        const atPageBottom =
+          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 10;
+        if (atPageBottom) {
+          setActiveLink(sections[sections.length - 1].id);
+          return;
+        }
+
+        // First priority: section spanning the primary reference line below the sticky nav
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= refLine && rect.bottom >= refLine) {
+            setActiveLink(section.id);
+            return;
+          }
+        }
+
+        // Fallback: section with the greatest visible height in the viewport
+        let bestSectionId = null;
+        let maxVisibleHeight = 0;
+
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          const visibleTop = Math.max(rect.top, navHeight);
+          const visibleBottom = Math.min(rect.bottom, viewportHeight);
+          const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+          if (visibleHeight > maxVisibleHeight) {
+            maxVisibleHeight = visibleHeight;
+            bestSectionId = section.id;
+          }
+        }
+
+        setActiveLink(bestSectionId);
+      }
+
+      navLinks.forEach(link => {
+        link.addEventListener('click', () => {
+          const targetId = link.getAttribute('href').slice(1);
+          setActiveLink(targetId);
+        });
+      });
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          () => {
+            updateActiveSection();
+          },
+          {
+            threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]
+          }
+        );
+        sections.forEach(section => observer.observe(section));
+      }
+
+      window.addEventListener('scroll', updateActiveSection, { passive: true });
+      window.addEventListener('resize', updateActiveSection);
+      window.addEventListener('hashchange', updateActiveSection);
+      window.addEventListener('DOMContentLoaded', updateActiveSection);
+      updateActiveSection();
+    })();
+  </script>
