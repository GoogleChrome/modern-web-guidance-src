+
+    /* Dynamic Sibling Styling Base & Native Support */
+    .spectrum-card,
+    .fan-card,
+    .circle-orb {
+      --index: var(--sibling-index);
+      --count: var(--sibling-count);
+    }
+
+    @supports (top: calc(sibling-index() * 1px)) {
+      .spectrum-card,
+      .fan-card,
+      .circle-orb {
+        --index: sibling-index();
+        --count: sibling-count();
+      }
+    }
+
+    /* 1. Dynamic Color Spectrum Cards */
+    .spectrum-card {
+      background-color: hsl(
+        calc(360deg / var(--count) * var(--index)),
+        70%,
+        82%
+      );
+    }
+
+    /* 2. Symmetrical Fan Loyalty Cards */
+    .fan-container {
+      display: grid;
+      place-items: center;
+      min-height: 280px;
+      margin-top: 20px;
+      position: relative;
+    }
+
+    .fan-card {
+      --center: calc((var(--count) + 1) / 2);
+      grid-area: 1 / 1;
+      width: 180px;
+      height: 220px;
+      padding: 20px;
+      border-radius: 12px;
+      background: var(--primary);
+      color: var(--light);
