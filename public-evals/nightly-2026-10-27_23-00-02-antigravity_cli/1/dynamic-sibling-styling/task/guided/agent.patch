+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      text-align: center;
+      transform-origin: bottom center;
+      transform: rotate(calc(10deg * (var(--index) - var(--center))));
+      transition: transform 0.3s ease;
+    }
+
+    .fan-card h3 {
+      color: var(--accent);
+      font-size: 1.1rem;
+    }
+
+    /* 3. Circular Coffee Origin Orbs */
+    .circle-container {
+      position: relative;
