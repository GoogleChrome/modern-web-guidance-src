+      width: 420px;
+      height: 420px;
+      margin: 20px auto;
+    }
+
+    .circle-orb {
+      --angle: calc(360deg / var(--count) * var(--index));
+      --radius: 150px;
+      position: absolute;
+      place-self: center;
+      width: 100px;
+      height: 100px;
+      border-radius: 50%;
+      background: var(--secondary);
+      color: var(--text);
+      border: 2px solid var(--primary);
+      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      text-align: center;
+      padding: 10px;
+      font-weight: bold;
+      font-size: 0.85rem;
+      transform: translate(
+        calc(cos(var(--angle)) * var(--radius)),
+        calc(sin(var(--angle)) * var(--radius))
+      );
+    }
