+    @layer transitions {
+      /* Wrap each scoped component so an outer grid transition can animate card positions
+         even while an inner component transition is running concurrently */
+      .card-wrapper {
+        view-transition-name: match-element;
+      }
+
+      /* Isolate internal view-transition-names from leaking into outer transitions */
+      .card {
+        view-transition-scope: all;
+      }
+
+      /* Nested View Transition Group for scrollable list inside the card */
+      .card .addon-list {
+        view-transition-name: match-element;
+        view-transition-group: contain;
+        view-transition-class: list;
+      }
+
+      ::view-transition-group-children(.list) {
+        overflow: clip;
+      }
+
+      /* Participating child items inside the scoped transition */
+      .card .addon-list li,
+      .card .card-header,
+      .card .tasting-details,
+      .card .card-footer {
+        view-transition-name: match-element;
+      }
+
+      /* Customize transition timing */
+      ::view-transition-group(*) {
+        animation-duration: 320ms;
+        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+      }
+
+      /* Respect user preference for reduced motion */
+      @media (prefers-reduced-motion: reduce) {
+        ::view-transition-group(*),
+        ::view-transition-old(*),
+        ::view-transition-new(*) {
+          animation: none !important;
+        }
+      }
     }
