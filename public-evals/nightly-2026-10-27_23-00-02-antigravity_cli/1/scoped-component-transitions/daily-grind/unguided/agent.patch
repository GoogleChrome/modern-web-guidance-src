+          tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
+        });
+
+        const panels = card.querySelectorAll('.card-panel');
+        panels.forEach((panel) => {
+          panel.hidden = panel.dataset.panel !== targetState;
+        });
+
+        const nextBtn = card.querySelector('.next-state-btn');
+        if (nextBtn && NEXT_LABELS[targetState]) {
+          nextBtn.textContent = NEXT_LABELS[targetState];
+        }
+      }
+
+      /**
+       * Animate a state change scoped to a single component (`card`) using
+       * `element.startViewTransition()` so other cards and the rest of the page
+       * remain interactive and can run concurrent transitions independently.
