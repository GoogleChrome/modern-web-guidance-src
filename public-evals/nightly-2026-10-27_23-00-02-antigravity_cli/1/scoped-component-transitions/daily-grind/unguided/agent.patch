+      function transitionCardState(card, targetState, mutateFn) {
+        const statusText = card.querySelector('.card-state-text');
+        const performUpdate = () => {
+          if (typeof mutateFn === 'function') {
+            mutateFn();
+          } else if (targetState) {
+            applyCardStateDOM(card, targetState);
+          }
+        };
+
+        card.dataset.transitioning = 'true';
+        if (statusText) statusText.textContent = 'Animating...';
+        updateGlobalStatus(1);
+
+        const cleanup = () => {
+          delete card.dataset.transitioning;
+          if (statusText) statusText.textContent = 'Ready';
