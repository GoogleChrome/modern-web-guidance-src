+
+      function updateGlobalStatus(delta) {
+        activeTransitionCount = Math.max(0, activeTransitionCount + delta);
+        if (activeTransitionsLabel) {
+          activeTransitionsLabel.textContent =
+            activeTransitionCount === 1
+              ? '1 active transition'
+              : `${activeTransitionCount} active transitions`;
+        }
+        if (globalDot) {
+          globalDot.style.background = activeTransitionCount > 0 ? 'var(--accent)' : '#bdbdbd';
+        }
+      }
+
+      /**
+       * Mutate the DOM inside a single card subtree to reflect `targetState`.
