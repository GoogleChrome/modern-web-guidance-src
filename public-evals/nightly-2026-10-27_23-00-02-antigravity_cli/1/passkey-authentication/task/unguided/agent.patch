+  <script>
+    (function () {
+      let abortController = null;
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+
+      function bufferToBase64Url(buffer) {
+        if (!buffer) return null;
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary)
+          .replace(/\+/g, '-')
+          .replace(/\//g, '_')
+          .replace(/=+$/, '');
+      }
+
+      function serializeCredential(credential) {
+        if (typeof credential.toJSON === 'function') {
+          return credential.toJSON();
+        }
+        return {
+          id: credential.id,
+          rawId: bufferToBase64Url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || null,
+          response: {
+            clientDataJSON: bufferToBase64Url(credential.response.clientDataJSON),
+            authenticatorData: bufferToBase64Url(credential.response.authenticatorData),
+            signature: bufferToBase64Url(credential.response.signature),
+            userHandle: credential.response.userHandle
+              ? bufferToBase64Url(credential.response.userHandle)
+              : null,
+          },
+          clientExtensionResults: credential.getClientExtensionResults
+            ? credential.getClientExtensionResults()
+            : {},
+        };
+      }
+
+      async function verifyCredential(credential) {
+        const payload = serializeCredential(credential);
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(payload),
+        });
+
+        if (!response.ok) {
+          throw new Error('Verification failed');
+        }
+
+        let data = {};
+        try {
+          data = await response.json();
+        } catch (e) {
+          // Response may not be JSON
+        }
+
+        authStatus.textContent = data.message || 'Successfully signed in with passkey!';
+      }
+
+      function getChallenge() {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && window.crypto.getRandomValues) {
+          window.crypto.getRandomValues(challenge);
+        }
+        return challenge;
+      }
+
+      async function initConditionalAuth() {
+        if (
+          !window.PublicKeyCredential ||
+          !PublicKeyCredential.isConditionalMediationAvailable
+        ) {
+          return;
+        }
+
+        try {
+          const available = await PublicKeyCredential.isConditionalMediationAvailable();
+          if (!available) return;
+
+          abortController = new AbortController();
+
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey: {
+              challenge: getChallenge(),
+              userVerification: 'preferred',
+            },
+            signal: abortController.signal,
+          });
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (err.name !== 'AbortError') {
+            console.error('Conditional passkey authentication error:', err);
+          }
+        }
+      }
+
+      async function handleExplicitAuth() {
+        if (abortController) {
+          abortController.abort();
+          abortController = null;
+        }
+
+        try {
+          const credential = await navigator.credentials.get({
+            publicKey: {
+              challenge: getChallenge(),
+              userVerification: 'required',
+            },
+          });
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          console.error('Passkey authentication error:', err);
+          authStatus.textContent = 'Authentication failed or cancelled.';
+        }
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', handleExplicitAuth);
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initConditionalAuth);
+      } else {
+        initConditionalAuth();
+      }
+    })();
+  </script>
 </body>
 
