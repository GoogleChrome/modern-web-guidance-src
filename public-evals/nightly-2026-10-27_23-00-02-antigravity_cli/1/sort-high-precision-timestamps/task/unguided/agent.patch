+    function formatNanosecondInterval(deltaNsBigInt) {
+      const ns = BigInt(deltaNsBigInt);
+      if (ns === 0n) {
+        return '0 ns (Baseline)';
+      }
+      const absNs = ns < 0n ? -ns : ns;
+      const formattedNs = absNs.toLocaleString('en-US') + ' ns';
