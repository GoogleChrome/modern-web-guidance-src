+        return `+${formattedNs} (${wholeUs}.${remNs} μs)`;
+      }
+      const wholeMs = absNs / 1000000n;
+      const remSubMs = (absNs % 1000000n).toString().padStart(6, '0');
+      return `+${formattedNs} (${wholeMs}.${remSubMs} ms)`;
