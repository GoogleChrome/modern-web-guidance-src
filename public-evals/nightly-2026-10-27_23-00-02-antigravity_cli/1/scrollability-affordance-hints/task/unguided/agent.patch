+  <script>
+    (function () {
+      const scrollContainer = document.getElementById('reviews-list');
+      const indicatorTop = document.querySelector('.indicator-top');
+      const indicatorBottom = document.querySelector('.indicator-bottom');
+
+      function updateScrollIndicators() {
+        if (!scrollContainer || !indicatorTop || !indicatorBottom) return;
+
+        const scrollTop = scrollContainer.scrollTop;
+        const scrollHeight = scrollContainer.scrollHeight;
+        const clientHeight = scrollContainer.clientHeight;
+        const canScrollDown = Math.ceil(scrollTop + clientHeight) < scrollHeight - 1;
+        const hasScrolledDown = scrollTop > 0;
+
+        if (hasScrolledDown) {
+          indicatorTop.classList.add('visible');
+          indicatorTop.classList.remove('hidden');
+          indicatorTop.style.opacity = '1';
+          indicatorTop.style.visibility = 'visible';
+          indicatorTop.style.display = 'block';
+        } else {
+          indicatorTop.classList.remove('visible');
+          indicatorTop.classList.add('hidden');
+          indicatorTop.style.opacity = '0';
+          indicatorTop.style.visibility = 'hidden';
+          indicatorTop.style.display = 'none';
+        }
+
+        if (canScrollDown) {
+          indicatorBottom.classList.add('visible');
+          indicatorBottom.classList.remove('hidden');
+          indicatorBottom.style.opacity = '1';
+          indicatorBottom.style.visibility = 'visible';
+          indicatorBottom.style.display = 'block';
+        } else {
+          indicatorBottom.classList.remove('visible');
+          indicatorBottom.classList.add('hidden');
+          indicatorBottom.style.opacity = '0';
+          indicatorBottom.style.visibility = 'hidden';
+          indicatorBottom.style.display = 'none';
+        }
+      }
+
+      if (scrollContainer) {
+        scrollContainer.addEventListener('scroll', updateScrollIndicators, { passive: true });
+        window.addEventListener('resize', updateScrollIndicators);
+        window.addEventListener('load', updateScrollIndicators);
+        updateScrollIndicators();
+      }
+    })();
+  </script>
+
