+    return;
+  }
+
+  if (pathname === '/csp-reports' && req.method === 'POST') {
+    res.writeHead(204, baseHeaders);
+    res.end();
+    return;
+  }
+
   if (pathname === '/logout' || pathname === '/logout/') {
