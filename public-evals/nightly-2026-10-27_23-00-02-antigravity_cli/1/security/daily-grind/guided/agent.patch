 const http = require('node:http');
 const fs = require('node:fs');
 const path = require('node:path');
+const crypto = require('node:crypto');
 
 const PORT = parseInt(process.env.PORT || '11222', 10);
 const WORK_DIR = __dirname;
+const ALLOWLIST_DESTS = new Set(['document', 'iframe', 'worker', 'sharedworker', 'serviceworker']);
+
+function generateNonce() {
+  const bytes = new Uint8Array(16);
+  crypto.getRandomValues(bytes);
+  return btoa(String.fromCharCode(...bytes));
+}
+
+function isAllowedFetchMetadata(req) {
+  const site = req.headers['sec-fetch-site'];
+  const mode = req.headers['sec-fetch-mode'];
+  const dest = req.headers['sec-fetch-dest'];
+
+  if (!site) return true; // Fallback for legacy browsers
+  if (['same-origin', 'same-site', 'none'].includes(site)) return true;
+
+  // Allow standard navigate GET requests (link clicks)
+  if (
+    site === 'cross-site' &&
+    mode === 'navigate' &&
+    (req.method === 'GET' || req.method === 'HEAD') &&
+    !['object', 'embed'].includes(dest)
+  ) {
+    return true;
+  }
+
+  return false;
+}
+
+function getSecurityHeaders(req, nonce) {
+  const csp = [
+    "default-src 'self'",
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    `style-src 'self' 'nonce-${nonce}'`,
+    "img-src 'self' https://images.unsplash.com data:",
+    "connect-src 'self'",
+    "font-src 'self'",
+    "form-action 'self'",
+    "worker-src 'self'",
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'self'",
+    "require-trusted-types-for 'script'",
+    'trusted-types escape-html sanitize-html dompurify',
+    'report-to main-endpoint',
+  ].join('; ');
+
+  const headers = {
+    'Vary': 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+    'Reporting-Endpoints': 'default="/csp-reports", main-endpoint="/csp-reports"',
+    'Content-Security-Policy': csp,
+    'Strict-Transport-Security': 'max-age=31536000; includeSubDomains; preload',
+    'X-Frame-Options': 'SAMEORIGIN',
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy': 'camera=(), geolocation=(), microphone=(), accelerometer=(), focus-without-user-activation=()',
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+  };
+
+  const secFetchDest = req.headers['sec-fetch-dest'];
+  if (!secFetchDest || ALLOWLIST_DESTS.has(String(secFetchDest).toLowerCase())) {
+    headers['Connection-Allowlist'] = '(response-origin "https://images.unsplash.com/*"); report-to=main-endpoint';
+  }
+
+  return headers;
+}
 
 const server = http.createServer((req, res) => {
   const parsedUrl = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
   const pathname = parsedUrl.pathname;
 
+  const nonce = generateNonce();
+  const baseHeaders = getSecurityHeaders(req, nonce);
+
+  if (!isAllowedFetchMetadata(req)) {
+    res.writeHead(403, {
