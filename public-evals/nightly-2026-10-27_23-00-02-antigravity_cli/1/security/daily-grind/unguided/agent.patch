+'use strict';
+
+(function () {
+  // Trusted Types policy for DOM XSS prevention
+  if (window.trustedTypes && window.trustedTypes.createPolicy) {
+    try {
+      window.trustedTypes.createPolicy('default', {
+        createHTML: (string) => {
+          const temp = document.createElement('div');
+          temp.textContent = string;
+          return temp.innerHTML;
+        },
+        createScriptURL: (url) => {
+          const parsed = new URL(url, window.location.origin);
+          if (parsed.origin === window.location.origin) {
+            return parsed.href;
+          }
+          throw new TypeError('Blocked untrusted script URL: ' + url);
+        },
+        createScript: () => {
+          throw new TypeError('Dynamic script evaluation is blocked by policy.');
+        }
+      });
+    } catch (_) {
+      // Policy already registered
+    }
+  }
+
+  // Client-side CSP violation telemetry listener for safe policy rollout
+  document.addEventListener('securitypolicyviolation', (event) => {
+    const report = {
+      blockedURI: event.blockedURI,
+      violatedDirective: event.violatedDirective,
+      effectiveDirective: event.effectiveDirective,
+      originalPolicy: event.originalPolicy,
+      disposition: event.disposition,
+      documentURI: event.documentURI,
+      lineNumber: event.lineNumber,
+      columnNumber: event.columnNumber,
+      sourceFile: event.sourceFile,
+      statusCode: event.statusCode
+    };
+
+    if (navigator.sendBeacon) {
+      const blob = new Blob([JSON.stringify(report)], { type: 'application/json' });
+      navigator.sendBeacon('/csp-report', blob);
+    } else if (window.fetch) {
+      window.fetch('/csp-report', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(report),
+        keepalive: true
+      }).catch(() => {});
+    }
+  });
+
+  // Secure Logout Handler & Client-Side Prefetch/Navigation Guards
+  document.addEventListener('DOMContentLoaded', () => {
+    // 1. Ensure any external links opened in a new tab have rel="noopener noreferrer" to prevent Reverse Tabnabbing
+    const anchors = document.querySelectorAll('a[href]');
+    anchors.forEach((anchor) => {
+      const href = anchor.getAttribute('href') || '';
+      if (href.startsWith('http://') || href.startsWith('https://')) {
+        try {
+          const url = new URL(href, window.location.origin);
+          if (url.origin !== window.location.origin) {
+            anchor.setAttribute('rel', 'noopener noreferrer');
+            anchor.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
+          }
+        } catch (_) {
+          // Ignore invalid URLs
+        }
+      }
+    });
+
+    // 2. Prevent accidental prefetching or premature state-changing GET requests on sensitive endpoints (/logout)
+    const logoutForm = document.getElementById('logout-form');
+    const logoutLink = document.getElementById('logout-btn') || document.querySelector('.logout-link');
+
+    const performSecureLogout = (event) => {
+      event.preventDefault();
+      // Clear client-side storage before navigating to logout
+      try {
+        window.sessionStorage.clear();
+        window.localStorage.clear();
+      } catch (_) {
+        // Storage access may be restricted
+      }
+
+      if (window.fetch) {
+        window.fetch('/logout', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: {
+            'X-Requested-With': 'XMLHttpRequest'
+          }
+        }).then(() => {
+          window.location.href = '/logout';
+        }).catch(() => {
+          if (logoutForm) {
+            logoutForm.submit();
+          } else {
+            window.location.href = '/logout';
+          }
+        });
+      } else if (logoutForm) {
+        logoutForm.submit();
+      } else {
+        window.location.href = '/logout';
+      }
+    };
+
+    if (logoutForm) {
+      logoutForm.addEventListener('submit', performSecureLogout);
+    }
+    if (logoutLink) {
+      logoutLink.addEventListener('click', performSecureLogout);
+    }
+  });
+})();
