+    // Handle Logout click in place
+    logoutLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      document.body.dataset.signedIn = 'false';
+      userGreetingItem.hidden = true;
+      userGreeting.textContent = '';
+      signinNavItem.hidden = false;
+      logoutNavItem.hidden = true;
+      banner.hidden = true;
+      for (const button of document.querySelectorAll('.favorite-btn')) {
+        button.setAttribute('aria-pressed', 'false');
+        button.textContent = 'Save Favorite';
+      }
+    });
+  </script>
+
 </body>
 
 </html>
