+  <script type="module">
+    const supportsPopover =
+      'popover' in HTMLElement.prototype &&
+      typeof HTMLElement.prototype.showPopover === 'function' &&
+      typeof HTMLElement.prototype.hidePopover === 'function' &&
+      typeof HTMLElement.prototype.togglePopover === 'function';
+
+    if (!supportsPopover) {
+      const { apply } = await import('./popover-polyfill.js');
+      apply();
+    }
+
+    const rewardsBtn = document.getElementById('rewards-btn');
+    const rewardsPopover = document.getElementById('rewards-popover');
+    const redeemBtn = document.getElementById('redeem-reward-btn');
+    const pointsDisplay = document.getElementById('rewards-points-display');
+    const statusText = document.getElementById('rewards-status-text');
+    const progressFill = document.getElementById('rewards-progress-fill');
+
+    if (rewardsPopover && !rewardsPopover.popover) {
+      rewardsPopover.popover = 'auto';
+    }
+
+    if (rewardsPopover && rewardsBtn) {
+      rewardsPopover.addEventListener('toggle', (event) => {
+        const isOpen =
+          event.newState === 'open' ||
+          (!event.newState && rewardsPopover.matches(':popover-open'));
+        rewardsPopover.classList.toggle('popover-open', isOpen);
+        if (isOpen) {
+          rewardsPopover.setAttribute('data-popover-open', 'true');
+        } else {
+          rewardsPopover.removeAttribute('data-popover-open');
+        }
+        rewardsBtn.setAttribute('aria-expanded', String(isOpen));
+      });
+    }
+
+    if (redeemBtn && pointsDisplay && statusText && progressFill) {
+      redeemBtn.addEventListener('click', () => {
+        pointsDisplay.textContent = '200 / 200 Beans';
+        statusText.textContent = 'Reward unlocked! Enjoy a free handcrafted drink on your next order.';
+        progressFill.style.width = '100%';
+        redeemBtn.textContent = 'Reward Claimed!';
+        redeemBtn.disabled = true;
+      });
+    }
+  </script>
+
 </body>
 
