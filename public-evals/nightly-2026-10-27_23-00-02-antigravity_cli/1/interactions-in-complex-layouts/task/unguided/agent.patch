+  <script>
+    (function () {
+      const board = document.getElementById('kanban-board');
+      if (!board) return;
+
+      const columns = {
+        queued: document.getElementById('col-queued'),
+        brewing: document.getElementById('col-brewing'),
+        ready: document.getElementById('col-ready')
+      };
+
+      const cardLists = {
+        queued: columns.queued.querySelector('.column-cards'),
+        brewing: columns.brewing.querySelector('.column-cards'),
+        ready: columns.ready.querySelector('.column-cards')
+      };
+
+      const countBadges = {
+        queued: columns.queued.querySelector('.column-count'),
+        brewing: columns.brewing.querySelector('.column-count'),
+        ready: columns.ready.querySelector('.column-count')
+      };
+
+      // Cache column counts in memory to avoid reading DOM layout / children length repeatedly
+      const columnCounts = {
+        queued: cardLists.queued.children.length,
+        brewing: cardLists.brewing.children.length,
+        ready: cardLists.ready.children.length
+      };
+
+      let nextOrderId = 104;
+
+      function updateCounts(sourceStatus, targetStatus, delta) {
+        if (sourceStatus && columnCounts[sourceStatus] !== undefined) {
+          columnCounts[sourceStatus] -= delta;
+          countBadges[sourceStatus].textContent = String(columnCounts[sourceStatus]);
+        }
+        if (targetStatus && columnCounts[targetStatus] !== undefined) {
+          columnCounts[targetStatus] += delta;
+          countBadges[targetStatus].textContent = String(columnCounts[targetStatus]);
+        }
+      }
+
+      function moveCardToColumn(card, targetColumnEl) {
+        if (!card || !targetColumnEl) return;
+        const targetStatus = targetColumnEl.dataset.status || targetColumnEl.dataset.column;
+        const sourceColumnEl = card.closest('.board-column');
+        const sourceStatus = sourceColumnEl
+          ? (sourceColumnEl.dataset.status || sourceColumnEl.dataset.column)
+          : card.dataset.status;
+
+        const targetList = cardLists[targetStatus] || targetColumnEl;
+        if (card.parentElement !== targetList) {
+          card.dataset.status = targetStatus;
+          targetList.appendChild(card);
+          if (sourceStatus !== targetStatus) {
+            updateCounts(sourceStatus, targetStatus, 1);
+          }
+        }
+      }
+
+      // --- 1. Native HTML5 Drag and Drop (Event Delegation) ---
+      let draggedCard = null;
+      let activeDropColumn = null;
+
+      board.addEventListener('dragstart', function (e) {
+        const card = e.target.closest('.card');
+        if (!card) return;
+        draggedCard = card;
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', card.dataset.orderId || '');
+        }
+        requestAnimationFrame(function () {
+          if (draggedCard) draggedCard.classList.add('is-dragging');
+        });
+      });
+
+      board.addEventListener('dragover', function (e) {
+        if (!draggedCard) return;
+        e.preventDefault();
+        if (e.dataTransfer) {
+          e.dataTransfer.dropEffect = 'move';
+        }
+        const col = e.target.closest('.board-column');
+        if (col !== activeDropColumn) {
+          if (activeDropColumn) activeDropColumn.classList.remove('drag-over');
+          activeDropColumn = col;
+          if (activeDropColumn) activeDropColumn.classList.add('drag-over');
+        }
+      });
+
+      board.addEventListener('dragleave', function (e) {
+        const col = e.target.closest('.board-column');
+        if (col && !col.contains(e.relatedTarget)) {
+          col.classList.remove('drag-over');
+          if (activeDropColumn === col) activeDropColumn = null;
+        }
+      });
+
+      board.addEventListener('drop', function (e) {
+        e.preventDefault();
+        const col = e.target.closest('.board-column');
+        if (activeDropColumn) {
+          activeDropColumn.classList.remove('drag-over');
+          activeDropColumn = null;
+        }
+        if (col && draggedCard) {
+          moveCardToColumn(draggedCard, col);
+        }
+        if (draggedCard) {
+          draggedCard.classList.remove('is-dragging');
+          draggedCard = null;
+        }
+      });
+
+      board.addEventListener('dragend', function () {
+        if (activeDropColumn) {
+          activeDropColumn.classList.remove('drag-over');
+          activeDropColumn = null;
+        }
+        if (draggedCard) {
+          draggedCard.classList.remove('is-dragging');
+          draggedCard = null;
+        }
+      });
+
+      // --- 2. High-Performance Composited Pointer Drag (Zero Reflows During Move) ---
+      // Caches column bounding boxes once on pointerdown and updates ghost via GPU translate3d in rAF
+      let pointerDragState = null;
+
+      board.addEventListener('pointerdown', function (e) {
+        // Only handle primary button for touch/pen or when native drag isn't triggered
+        if (e.button !== 0 || e.pointerType === 'mouse') return;
+        const card = e.target.closest('.card');
+        if (!card) return;
+
+        const rect = card.getBoundingClientRect();
+        const colRects = Object.keys(columns).map(function (key) {
+          const el = columns[key];
+          const r = el.getBoundingClientRect();
+          return { key: key, el: el, left: r.left, right: r.right, top: r.top, bottom: r.bottom };
+        });
+
+        const ghost = card.cloneNode(true);
+        ghost.classList.add('drag-ghost');
+        ghost.style.width = rect.width + 'px';
+        ghost.style.height = rect.height + 'px';
+        ghost.style.transform = 'translate3d(' + rect.left + 'px, ' + rect.top + 'px, 0) scale(1.02)';
+        document.body.appendChild(ghost);
+
+        card.classList.add('is-dragging');
+        card.setPointerCapture(e.pointerId);
+
+        pointerDragState = {
+          card: card,
+          ghost: ghost,
+          pointerId: e.pointerId,
+          offsetX: e.clientX - rect.left,
+          offsetY: e.clientY - rect.top,
+          currentX: rect.left,
+          currentY: rect.top,
+          colRects: colRects,
+          hoveredCol: null,
+          rafId: 0
+        };
+      });
+
+      board.addEventListener('pointermove', function (e) {
+        if (!pointerDragState || e.pointerId !== pointerDragState.pointerId) return;
+        pointerDragState.currentX = e.clientX - pointerDragState.offsetX;
+        pointerDragState.currentY = e.clientY - pointerDragState.offsetY;
+
+        const clientX = e.clientX;
+        const clientY = e.clientY;
+
+        if (!pointerDragState.rafId) {
+          pointerDragState.rafId = requestAnimationFrame(function () {
+            if (!pointerDragState) return;
+            pointerDragState.rafId = 0;
+            pointerDragState.ghost.style.transform =
+              'translate3d(' + pointerDragState.currentX + 'px, ' + pointerDragState.currentY + 'px, 0) scale(1.02)';
+
+            let matchedCol = null;
+            for (let i = 0; i < pointerDragState.colRects.length; i++) {
+              const c = pointerDragState.colRects[i];
+              if (clientX >= c.left && clientX <= c.right && clientY >= c.top && clientY <= c.bottom) {
+                matchedCol = c.el;
+                break;
+              }
+            }
+            if (matchedCol !== pointerDragState.hoveredCol) {
+              if (pointerDragState.hoveredCol) pointerDragState.hoveredCol.classList.remove('drag-over');
+              pointerDragState.hoveredCol = matchedCol;
+              if (pointerDragState.hoveredCol) pointerDragState.hoveredCol.classList.add('drag-over');
+            }
+          });
+        }
+      });
+
+      function finishPointerDrag(e) {
+        if (!pointerDragState || e.pointerId !== pointerDragState.pointerId) return;
+        if (pointerDragState.rafId) cancelAnimationFrame(pointerDragState.rafId);
+        if (pointerDragState.hoveredCol) {
+          pointerDragState.hoveredCol.classList.remove('drag-over');
+          moveCardToColumn(pointerDragState.card, pointerDragState.hoveredCol);
+        }
+        pointerDragState.card.classList.remove('is-dragging');
+        pointerDragState.ghost.remove();
+        pointerDragState = null;
+      }
+
+      board.addEventListener('pointerup', finishPointerDrag);
+      board.addEventListener('pointercancel', finishPointerDrag);
+
+      // --- 3. Batched Order Creation via DocumentFragment ---
+      const drinkNotes = {
+        'Maple Oat Latte': ['Oat milk, extra Vermont maple drizzle', '12oz Hot'],
+        'Dark Roast Espresso': ['Bold, smokey, double shot', 'Double Shot'],
+        'Cold Brew': ['18-hour steep, light ice', '16oz Iced'],
+        'Caramel Macchiato': ['Vanilla syrup, caramel crosshatch', '16oz Hot'],
+        'Matcha Green Tea Latte': ['Ceremonial grade matcha, oat milk', '12oz Iced']
+      };
+      const sampleCustomers = ['Alex', 'Sam', 'Taylor', 'Jordan', 'Morgan', 'Casey', 'Riley', 'Quinn', 'Avery', 'Parker'];
+
+      function createOrderCardElement(orderId, drinkName, customerName, status) {
+        const info = drinkNotes[drinkName] || ['Custom barista preparation', '12oz'];
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.draggable = true;
+        card.dataset.orderId = String(orderId);
+        card.dataset.status = status;
+
+        const meta = document.createElement('div');
+        meta.className = 'card-meta';
+
+        const idSpan = document.createElement('span');
+        idSpan.textContent = '#' + orderId + ' \u2022 ' + customerName;
+
+        const badgeSpan = document.createElement('span');
+        badgeSpan.className = 'card-badge';
+        badgeSpan.textContent = info[1];
+
+        meta.appendChild(idSpan);
+        meta.appendChild(badgeSpan);
+
+        const title = document.createElement('h3');
+        title.textContent = drinkName;
+
+        const desc = document.createElement('p');
+        desc.textContent = info[0];
+
+        card.appendChild(meta);
+        card.appendChild(title);
+        card.appendChild(desc);
+        return card;
+      }
+
+      const addOrderBtn = document.getElementById('add-order-btn');
+      const bulkOrderBtn = document.getElementById('bulk-order-btn');
+      const drinkSelect = document.getElementById('new-drink-select');
+      const customerInput = document.getElementById('new-customer-input');
+
+      if (addOrderBtn) {
+        addOrderBtn.addEventListener('click', function () {
+          const drink = drinkSelect ? drinkSelect.value : 'Maple Oat Latte';
+          const customer = (customerInput && customerInput.value.trim()) ||
+            sampleCustomers[nextOrderId % sampleCustomers.length];
+          const card = createOrderCardElement(nextOrderId++, drink, customer, 'queued');
+          cardLists.queued.appendChild(card);
+          updateCounts(null, 'queued', 1);
+          if (customerInput) customerInput.value = '';
+        });
+      }
+
+      if (bulkOrderBtn) {
+        bulkOrderBtn.addEventListener('click', function () {
+          const drinks = ['Maple Oat Latte', 'Dark Roast Espresso', 'Cold Brew'];
+          const fragment = document.createDocumentFragment();
+          const batchSize = 50;
+          for (let i = 0; i < batchSize; i++) {
+            const drink = drinks[i % drinks.length];
+            const customer = sampleCustomers[(nextOrderId + i) % sampleCustomers.length];
+            fragment.appendChild(createOrderCardElement(nextOrderId++, drink, customer, 'queued'));
+          }
+          requestAnimationFrame(function () {
+            cardLists.queued.appendChild(fragment);
+            updateCounts(null, 'queued', batchSize);
+          });
+        });
+      }
+    })();
+  </script>
 </body>
 
