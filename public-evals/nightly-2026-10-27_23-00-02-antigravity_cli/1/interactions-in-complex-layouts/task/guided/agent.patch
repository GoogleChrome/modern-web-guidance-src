+  <script>
+    (function () {
+      const board = document.getElementById('order-board');
+      const columns = Array.from(board.querySelectorAll('.board-column'));
+      let draggedCard = null;
+      let nextOrderNumber = 106;
+
+      const sampleDrinks = [
+        { name: 'Maple Oat Latte', desc: 'Creamy oat milk with a hint of Vermont maple syrup.', note: 'Extra cinnamon' },
+        { name: 'Dark Roast Espresso', desc: 'Bold, smokey, and perfect for a morning boost.', note: 'Double shot' },
+        { name: 'Cold Brew', desc: 'Steeped for 18 hours for maximum smoothness.', note: 'Light ice' },
+        { name: 'Matcha Oat Latte', desc: 'Ceremonial grade matcha whisked with steamed oat milk.', note: 'Unsweetened' },
+        { name: 'Caramel Macchiato', desc: 'Vanilla-flavored milk marked with espresso and caramel drizzle.', note: 'Extra drizzle' }
+      ];
+      const sampleNames = ['Alex', 'Taylor', 'Morgan', 'Casey', 'Riley', 'Jamie', 'Avery', 'Quinn'];
+
+      function updateColumnCounts() {
+        for (const col of columns) {
+          const status = col.dataset.status || col.id;
+          const badge = document.getElementById(`count-${status}`);
+          if (badge) {
+            badge.textContent = String(col.querySelectorAll('.card').length);
+          }
+        }
+      }
+
+      function renderActionButtons(status) {
+        if (status === 'queued') {
+          return '<button type="button" class="move-btn" data-move-to="brewing">Brew &rarr;</button>';
+        }
+        if (status === 'brewing') {
+          return '<button type="button" class="move-btn" data-move-to="queued">&larr; Queue</button> ' +
+                 '<button type="button" class="move-btn" data-move-to="ready">Ready &rarr;</button>';
+        }
+        return '<button type="button" class="move-btn" data-move-to="brewing">&larr; Brew</button>';
+      }
+
+      function moveItemToColumn(cardEl, targetColumn, referenceCard = null) {
+        if (!cardEl || !targetColumn) return;
+
+        // Atomic move via moveBefore when supported to preserve element state,
+        // falling back to insertBefore/appendChild.
+        if ('moveBefore' in Element.prototype) {
+          targetColumn.moveBefore(cardEl, referenceCard);
+        } else if (referenceCard) {
+          targetColumn.insertBefore(cardEl, referenceCard);
+        } else {
+          targetColumn.appendChild(cardEl);
+        }
+
+        const newStatus = targetColumn.dataset.status || targetColumn.id;
+        const actionsContainer = cardEl.querySelector('.card-actions div');
+        if (actionsContainer) {
+          actionsContainer.innerHTML = renderActionButtons(newStatus);
+        }
+
+        updateColumnCounts();
+      }
+
+      function getDragAfterElement(column, y) {
+        const cards = column.querySelectorAll('.card:not(.dragging)');
+        let closest = null;
+        let closestOffset = Number.NEGATIVE_INFINITY;
+
+        for (const child of cards) {
+          const box = child.getBoundingClientRect();
+          const offset = y - box.top - box.height / 2;
+          if (offset < 0 && offset > closestOffset) {
+            closestOffset = offset;
+            closest = child;
+          }
+        }
+        return closest;
+      }
+
+      board.addEventListener('dragstart', (event) => {
+        const card = event.target.closest('.card');
+        if (!card) return;
+        draggedCard = card;
+        card.classList.add('dragging');
+        if (event.dataTransfer) {
+          event.dataTransfer.effectAllowed = 'move';
+          event.dataTransfer.setData('text/plain', card.id);
+        }
+      });
+
+      board.addEventListener('dragend', () => {
+        if (draggedCard) {
+          draggedCard.classList.remove('dragging');
+          draggedCard = null;
+        }
+        for (const col of columns) {
+          col.classList.remove('drag-over');
+        }
+      });
+
+      for (const column of columns) {
+        column.addEventListener('dragover', (event) => {
+          event.preventDefault();
+          if (event.dataTransfer) {
+            event.dataTransfer.dropEffect = 'move';
+          }
+          column.classList.add('drag-over');
+        });
+
+        column.addEventListener('dragleave', (event) => {
+          if (!column.contains(event.relatedTarget)) {
+            column.classList.remove('drag-over');
+          }
+        });
+
+        column.addEventListener('drop', (event) => {
+          event.preventDefault();
+          column.classList.remove('drag-over');
+
+          const cardId = event.dataTransfer ? event.dataTransfer.getData('text/plain') : '';
+          const card = draggedCard || (cardId ? document.getElementById(cardId) : null);
+          if (!card) return;
+
+          const afterElement = getDragAfterElement(column, event.clientY);
+          moveItemToColumn(card, column, afterElement);
+        });
+      }
+
+      board.addEventListener('click', (event) => {
+        const moveBtn = event.target.closest('.move-btn');
+        if (!moveBtn) return;
+
+        const targetStatus = moveBtn.dataset.moveTo;
+        const card = moveBtn.closest('.card');
+        const targetColumn = document.getElementById(targetStatus);
+        if (card && targetColumn) {
+          moveItemToColumn(card, targetColumn, null);
+        }
+      });
+
+      function createOrderCard(orderNum, status = 'queued') {
+        const drink = sampleDrinks[orderNum % sampleDrinks.length];
+        const customer = sampleNames[orderNum % sampleNames.length];
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.id = `order-${orderNum}`;
+        card.draggable = true;
+        card.dataset.orderId = String(orderNum);
+        card.innerHTML = `
+          <div class="card-meta">
+            <span class="order-id">#${orderNum}</span>
+            <span>For: ${customer} &bull; 12oz</span>
+          </div>
+          <h3>${drink.name}</h3>
+          <p>${drink.desc}</p>
+          <div class="card-actions">
+            <span>${drink.note}</span>
+            <div>${renderActionButtons(status)}</div>
+          </div>
+        `;
+        return card;
+      }
+
+      async function yieldToMain() {
+        if ('scheduler' in window && 'yield' in scheduler) {
+          return await scheduler.yield();
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      document.getElementById('add-order-btn').addEventListener('click', () => {
+        const queuedCol = document.getElementById('queued');
+        const card = createOrderCard(nextOrderNumber++, 'queued');
+        queuedCol.appendChild(card);
+        updateColumnCounts();
+      });
+
+      document.getElementById('rush-hour-btn').addEventListener('click', async () => {
+        const queuedCol = document.getElementById('queued');
+        const total = 50;
+        const batchSize = 25;
+        for (let i = 0; i < total; i += batchSize) {
+          const fragment = document.createDocumentFragment();
+          const end = Math.min(i + batchSize, total);
+          for (let j = i; j < end; j++) {
+            fragment.appendChild(createOrderCard(nextOrderNumber++, 'queued'));
+          }
+          queuedCol.appendChild(fragment);
+          updateColumnCounts();
+          if (end < total) {
+            await yieldToMain();
+          }
+        }
+      });
+    })();
+  </script>
 </body>
 
