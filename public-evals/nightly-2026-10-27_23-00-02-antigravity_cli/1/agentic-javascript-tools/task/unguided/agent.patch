diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,159 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      const MENU_ITEMS = [
+        {
+          name: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          url: '/menu/seasonal',
+          category: 'Seasonal Favorites',
+          price: '$5.50'
+        },
+        {
+          name: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          url: '/menu/espresso',
+          category: 'Espresso',
+          price: '$3.50'
+        },
+        {
+          name: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          url: '/menu/cold-brew',
+          category: 'Cold Brew',
+          price: '$4.75'
+        }
+      ];
+
+      function getMenuItems() {
+        const cards = Array.from(document.querySelectorAll('.card'));
+        if (cards.length > 0) {
+          return cards.map((card) => {
+            const name = card.querySelector('h3')?.textContent?.trim() || '';
+            const description = card.querySelector('p')?.textContent?.trim() || '';
+            const url = card.querySelector('a')?.getAttribute('href') || '';
+            const fallback = MENU_ITEMS.find(
+              (item) => item.name.toLowerCase() === name.toLowerCase()
+            );
+            return {
+              ...fallback,
+              name,
+              description,
+              url
+            };
+          });
+        }
+        return MENU_ITEMS;
+      }
+
+      function findMenuItem(input) {
+        const rawQuery =
+          typeof input === 'string'
+            ? input
+            : input?.name || input?.itemName || input?.item || input?.query || '';
+        const query = String(rawQuery).trim().toLowerCase();
+        const items = getMenuItems();
+
+        if (!query) {
+          return {
+            found: false,
+            error: 'Please provide a menu item name to look up.',
+            availableItems: items.map((i) => i.name)
+          };
+        }
+
+        const match =
+          items.find((item) => item.name.toLowerCase() === query) ||
+          items.find(
+            (item) =>
+              item.name.toLowerCase().includes(query) ||
+              query.includes(item.name.toLowerCase())
+          );
+
+        if (!match) {
+          return {
+            found: false,
+            error: `Menu item "${rawQuery}" not found.`,
+            availableItems: items.map((i) => i.name)
+          };
+        }
+
+        return {
+          found: true,
+          ...match,
+          content: [
+            {
+              type: 'text',
+              text: `${match.name}: ${match.description} (Details: ${match.url})`
+            }
+          ]
+        };
+      }
+
+      const TOOL_NAME = 'getMenuItemDetails';
+      const controller = new AbortController();
+
+      const toolDefinition = {
+        name: TOOL_NAME,
+        description:
+          'Look up details for a menu item (such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew) by its name.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              description:
+                'The name of the menu item to look up (e.g., "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew").'
+            }
+          },
+          required: ['name']
+        },
+        annotations: {
+          readOnlyHint: true
+        },
+        async execute(args) {
+          return findMenuItem(args);
+        }
+      };
+
+      const contexts = [navigator.modelContext, document.modelContext].filter(Boolean);
+      for (const ctx of contexts) {
+        if (typeof ctx.registerTool === 'function') {
+          try {
+            ctx.registerTool(toolDefinition, { signal: controller.signal });
+          } catch (err) {
+            console.warn('Failed to register tool with options, retrying without options:', err);
+            try {
+              ctx.registerTool(toolDefinition);
+            } catch (innerErr) {
+              console.error('Failed to register tool:', innerErr);
+            }
+          }
+        }
+      }
+
+      function cleanupToolRegistration() {
+        controller.abort();
+        const activeContexts = [navigator.modelContext, document.modelContext].filter(Boolean);
+        for (const ctx of activeContexts) {
+          if (typeof ctx.unregisterTool === 'function') {
+            try {
+              ctx.unregisterTool(TOOL_NAME);
+            } catch (err) {
+              // Ignore errors during unload cleanup
+            }
+          }
+        }
+      }
+
+      window.addEventListener('pagehide', cleanupToolRegistration);
+      window.addEventListener('beforeunload', cleanupToolRegistration);
+      window.addEventListener('unload', cleanupToolRegistration);
+    })();
+  </script>
 </body>
 
 </html>
