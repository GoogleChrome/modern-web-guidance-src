+          });
+        }
+
+        // Intercept clicks on links to enforce redirect and external link validation
+        document.addEventListener('click', function (event) {
+          const anchor = event.target && event.target.closest ? event.target.closest('a[href]') : null;
+          if (!anchor) return;
+
+          const rawHref = anchor.getAttribute('href') || '';
+          if (rawHref === '#blocked-unsafe-link') {
+            event.preventDefault();
+            appendAuditLog('REJECT', 'LINK-CLICK', 'Blocked navigation to unsafe link');
+            return;
+          }
+
+          // Validate redirect query param on logout/account links if present
+          try {
+            const parsed = new URL(rawHref, window.location.origin);
+            const redirectTarget =
+              parsed.searchParams.get('redirect') ||
+              parsed.searchParams.get('returnTo') ||
+              parsed.searchParams.get('next');
+            if (redirectTarget) {
+              const check = validateRedirectUrl(redirectTarget);
+              if (!check.valid) {
+                event.preventDefault();
+                appendAuditLog('REJECT', 'LOGOUT-REDIRECT', 'Blocked unsafe redirect on link click: ' + check.reason);
+                return;
+              }
+            }
+          } catch (err) {
+            event.preventDefault();
+            return;
+          }
+        });
+
+        // Wire up Redirect Validator form
+        const redirectForm = document.getElementById('redirect-validator-form');
+        const redirectInput = document.getElementById('redirect-url-input');
+        if (redirectForm && redirectInput) {
+          redirectForm.addEventListener('submit', function (event) {
+            event.preventDefault();
+            updateRedirectValidatorUI(redirectInput.value);
+          });
+        }
+
+        // Wire up Redirect preset buttons
+        const presetButtons = document.querySelectorAll('[data-test-redirect]');
+        presetButtons.forEach(function (btn) {
+          btn.addEventListener('click', function () {
+            const testUrl = btn.getAttribute('data-test-redirect') || '';
+            const testBase = btn.getAttribute('data-test-base') || undefined;
+            if (redirectInput) {
+              redirectInput.value = testUrl;
+            }
+            updateRedirectValidatorUI(testUrl, testBase);
+          });
+        });
+
+        // Wire up Order simulation buttons
+        const trustedOrderBtn = document.getElementById('simulate-trusted-order-btn');
+        if (trustedOrderBtn) {
+          trustedOrderBtn.addEventListener('click', function () {
+            const syntheticTrustedEvent = new MessageEvent('message', {
+              origin: TRUSTED_ORDER_ORIGIN,
+              data: {
+                type: 'ORDER_STATUS',
+                orderId: 'DG-2026-841',
+                item: 'Maple Oat Latte (Large)',
+                status: 'In Preparation - Ready in 4 mins'
+              }
+            });
+            window.dispatchEvent(syntheticTrustedEvent);
+          });
+        }
+
+        const untrustedOrderBtn = document.getElementById('simulate-untrusted-order-btn');
+        if (untrustedOrderBtn) {
+          untrustedOrderBtn.addEventListener('click', function () {
+            const syntheticUntrustedEvent = new MessageEvent('message', {
+              origin: 'https://orders.dailygrind.com.evil.example',
+              data: {
+                type: 'ORDER_STATUS',
+                orderId: 'SPOOF-999',
+                item: 'Phishing Redirect Payload',
+                status: 'Click here to claim prize'
+              }
+            });
+            window.dispatchEvent(syntheticUntrustedEvent);
+          });
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initPageSecurity);
+      } else {
+        initPageSecurity();
+      }
+    })();
+  </script>
