+  <script>
+    (() => {
+      const form = document.getElementById('mailing-list-form');
+      if (!form) return;
+
+      const syncValidationState = (input) => {
+        if (!input || !input.matches?.('input[required]')) return;
+        input.classList.add('is-touched');
+
+        if (!input.checkValidity()) {
+          input.setAttribute('aria-invalid', 'true');
+        } else {
+          input.removeAttribute('aria-invalid');
+        }
+      };
+
+      // Sync on blur when a user finishes interacting with the field
+      form.addEventListener('blur', (event) => {
+        if (event.target.matches?.('input[required]')) {
+          syncValidationState(event.target);
+        }
+      }, true);
+
+      // Remove error state immediately upon correction while typing
+      form.addEventListener('input', (event) => {
+        const input = event.target;
+        if (input.matches?.('input[required]') && input.checkValidity()) {
+          input.removeAttribute('aria-invalid');
+        }
+      });
+
+      // Sync all required fields when submission is attempted
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        form.querySelectorAll('input[required]').forEach(syncValidationState);
+
+        if (form.checkValidity()) {
+          const submitBtn = form.querySelector('button[type="submit"]');
+          const successMsg = document.getElementById('mailing-list-success');
+          if (submitBtn) submitBtn.disabled = true;
+          if (successMsg) successMsg.style.display = 'block';
+        }
+      });
+    })();
+  </script>
+
 </body>
 
