+# Privacy & Security Headers Configuration
+
+Referrer-Policy: strict-origin-when-cross-origin
+Permissions-Policy: geolocation=(), camera=(), microphone=(), accelerometer=(), focus-without-user-activation=()
+Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
+X-Content-Type-Options: nosniff
+X-Frame-Options: SAMEORIGIN
+Cross-Origin-Opener-Policy: same-origin-allow-popups
+Cross-Origin-Resource-Policy: same-origin
+Connection-Allowlist: (response-origin "https://images.unsplash.com/*" "https://img.youtube.com/*" "https://www.youtube-nocookie.com/*"); report-to=main-endpoint
+Reporting-Endpoints: default="https://reports.dailygrind.example/default", main-endpoint="https://reports.dailygrind.example/main"
+Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'report-sample'; style-src 'self' 'unsafe-inline'; img-src 'self' https://images.unsplash.com https://img.youtube.com data:; frame-src https://www.youtube-nocookie.com; connect-src 'self'; form-action 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; report-to main-endpoint;
+
+/*
+  Referrer-Policy: strict-origin-when-cross-origin
+  Permissions-Policy: geolocation=(), camera=(), microphone=(), accelerometer=(), focus-without-user-activation=()
+  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
+  X-Content-Type-Options: nosniff
+  X-Frame-Options: SAMEORIGIN
+  Cross-Origin-Opener-Policy: same-origin-allow-popups
+  Cross-Origin-Resource-Policy: same-origin
+  Connection-Allowlist: (response-origin "https://images.unsplash.com/*" "https://img.youtube.com/*" "https://www.youtube-nocookie.com/*"); report-to=main-endpoint
+  Reporting-Endpoints: default="https://reports.dailygrind.example/default", main-endpoint="https://reports.dailygrind.example/main"
+  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'report-sample'; style-src 'self' 'unsafe-inline'; img-src 'self' https://images.unsplash.com https://img.youtube.com data:; frame-src https://www.youtube-nocookie.com; connect-src 'self'; form-action 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'; report-to main-endpoint;
+
+/logout
+  Clear-Site-Data: "*"
+  Set-Cookie: __Host-session_id=; Max-Age=0; Secure; HttpOnly; SameSite=Lax; Path=/
