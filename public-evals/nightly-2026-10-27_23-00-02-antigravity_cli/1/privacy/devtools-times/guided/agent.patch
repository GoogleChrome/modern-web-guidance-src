diff --git a/src/pages/api/logout.ts b/src/pages/api/logout.ts
new file mode 100644
index 0000000..fccddd3
--- /dev/null
+++ b/src/pages/api/logout.ts
@@ -0,0 +1,16 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ session }) => {
+  if (session) {
+    await session.destroy();
+  }
+
+  return new Response(JSON.stringify({ message: 'Signed out and site data cleared.' }), {
+    status: 200,
+    headers: {
+      'Content-Type': 'application/json',
+      'Clear-Site-Data': '"cookies", "storage"',
+      'Cache-Control': 'no-store',
+    },
+  });
+};
