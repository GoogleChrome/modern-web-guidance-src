diff --git a/src/components/PrivacyPreferences.tsx b/src/components/PrivacyPreferences.tsx
new file mode 100644
index 0000000..bc0fbc5
--- /dev/null
+++ b/src/components/PrivacyPreferences.tsx
@@ -0,0 +1,305 @@
+import React, { useState, useEffect } from 'react';
+
+export interface PrivacyConsent {
+  analytics: boolean;
+  ads: boolean;
+  updatedAt: string | null;
+}
+
+const STORAGE_KEY = 'devtools_times_privacy_consent';
+const ANALYTICS_SCRIPT_ID = 'dtt-analytics-script';
+const AD_SCRIPT_ID = 'dtt-ad-script';
+const ANALYTICS_SRC = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+const AD_SRC = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/ad-client.js';
+
+const DEFAULT_CONSENT: PrivacyConsent = {
+  analytics: false,
+  ads: false,
+  updatedAt: null,
+};
+
+function isPrivacySignalActive(): boolean {
+  if (typeof navigator === 'undefined') return false;
+  const gpc = (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true;
+  const dnt = navigator.doNotTrack === '1' || (window as Window & { doNotTrack?: string }).doNotTrack === '1';
+  return gpc || dnt;
+}
+
+function isSensitiveAuthPath(): boolean {
+  if (typeof window === 'undefined') return false;
+  const path = window.location.pathname;
+  return path.endsWith('/signin') || path.endsWith('/signup') || path.endsWith('/signin/') || path.endsWith('/signup/');
+}
+
+export function getStoredConsent(): PrivacyConsent {
+  if (typeof window === 'undefined') return DEFAULT_CONSENT;
+  if (isPrivacySignalActive()) {
+    return { analytics: false, ads: false, updatedAt: 'browser-signal' };
+  }
+  try {
+    const raw = window.localStorage.getItem(STORAGE_KEY);
+    if (!raw) return DEFAULT_CONSENT;
+    const parsed = JSON.parse(raw);
+    return {
+      analytics: Boolean(parsed.analytics),
+      ads: Boolean(parsed.ads),
+      updatedAt: typeof parsed.updatedAt === 'string' ? parsed.updatedAt : null,
+    };
+  } catch {
+    return DEFAULT_CONSENT;
+  }
+}
+
+function applyThirdPartyScripts(consent: PrivacyConsent) {
+  if (typeof document === 'undefined') return;
+
+  // Never load third-party tracking scripts on authentication pages
+  const allowAnalytics = consent.analytics && !isSensitiveAuthPath() && !isPrivacySignalActive();
+  const allowAds = consent.ads && !isSensitiveAuthPath() && !isPrivacySignalActive();
+
+  const existingAnalytics = document.getElementById(ANALYTICS_SCRIPT_ID);
+  if (allowAnalytics && !existingAnalytics) {
+    const script = document.createElement('script');
+    script.id = ANALYTICS_SCRIPT_ID;
+    script.src = ANALYTICS_SRC;
+    script.defer = true;
+    script.crossOrigin = 'anonymous';
+    script.referrerPolicy = 'no-referrer';
+    document.head.appendChild(script);
+  } else if (!allowAnalytics && existingAnalytics) {
+    existingAnalytics.remove();
+  }
+
+  const existingAd = document.getElementById(AD_SCRIPT_ID);
+  if (allowAds && !existingAd) {
+    const script = document.createElement('script');
+    script.id = AD_SCRIPT_ID;
+    script.src = AD_SRC;
+    script.defer = true;
+    script.crossOrigin = 'anonymous';
+    script.referrerPolicy = 'no-referrer';
+    document.head.appendChild(script);
+  } else if (!allowAds && existingAd) {
+    existingAd.remove();
+  }
+
+  window.dispatchEvent(new CustomEvent('privacy-consent-changed', { detail: consent }));
+}
+
+export default function PrivacyPreferences({ baseUrl = '/' }: { baseUrl?: string }) {
+  const [consent, setConsent] = useState<PrivacyConsent>(DEFAULT_CONSENT);
+  const [showBanner, setShowBanner] = useState(false);
+  const [isModalOpen, setIsModalOpen] = useState(false);
+  const [privacySignalDetected, setPrivacySignalDetected] = useState(false);
+
+  useEffect(() => {
+    const signalActive = isPrivacySignalActive();
+    setPrivacySignalDetected(signalActive);
+
+    const stored = getStoredConsent();
+    setConsent(stored);
+    applyThirdPartyScripts(stored);
+
+    if (!stored.updatedAt && !signalActive) {
+      setShowBanner(true);
+    }
+
+    const handleOpenPreferences = () => {
+      setIsModalOpen(true);
+    };
+
+    window.addEventListener('open-privacy-preferences', handleOpenPreferences);
+    return () => {
+      window.removeEventListener('open-privacy-preferences', handleOpenPreferences);
+    };
+  }, []);
+
+  const saveConsent = (next: PrivacyConsent) => {
+    const updated: PrivacyConsent = {
+      ...next,
+      updatedAt: new Date().toISOString(),
+    };
+    setConsent(updated);
+    setShowBanner(false);
+    setIsModalOpen(false);
+    try {
+      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(updated));
+    } catch {
+      // Ignore storage errors in private browsing modes
+    }
+    applyThirdPartyScripts(updated);
+  };
+
+  const handleRejectAll = () => {
+    saveConsent({ analytics: false, ads: false, updatedAt: new Date().toISOString() });
+  };
+
+  const handleSaveCustom = (e: React.FormEvent) => {
+    e.preventDefault();
+    saveConsent(consent);
+  };
+
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  return (
+    <>
+      {showBanner && !isModalOpen && (
+        <aside
+          aria-label="Privacy & Data Transparency Notice"
+          className="fixed bottom-0 inset-x-0 z-50 bg-white border-t border-gray-300 shadow-lg p-4"
+        >
+          <div className="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
+            <div className="text-xs text-gray-700 max-w-3xl">
+              <p className="font-semibold text-gray-900 mb-1">
+                Privacy by Default: Third-Party Scripts Are Disabled
+              </p>
+              <p>
+                We practice data minimization. Optional third-party analytics and advertising scripts are{' '}
+                <strong>off by default</strong> and never run unless you explicitly opt in. Read our{' '}
+                <a href={`${normalizedBase}legal/privacy`} className="underline hover:text-gray-900">
+                  Privacy Policy
+                </a>{' '}
+                to learn how we protect your data.
+              </p>
+            </div>
+            <div className="flex flex-wrap items-center gap-2 shrink-0">
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={handleRejectAll}
+                className="px-3 py-1.5 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800"
+              >
+                Keep Optional Scripts Off
+              </button>
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={() => setIsModalOpen(true)}
+                className="px-3 py-1.5 text-xs font-semibold text-gray-800 bg-gray-100 border border-gray-300 rounded hover:bg-gray-200"
+              >
+                Manage Preferences
+              </button>
+            </div>
+          </div>
+        </aside>
+      )}
+
+      {isModalOpen && (
+        <div
+          role="dialog"
+          aria-modal="true"
+          aria-labelledby="privacy-modal-title"
+          className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4"
+        >
+          <div className="bg-white border border-gray-200 rounded-lg shadow-xl max-w-lg w-full p-6">
+            <div className="flex items-center justify-between border-b border-gray-200 pb-3 mb-4">
+              <h2 id="privacy-modal-title" className="text-lg font-bold text-gray-900">
+                Privacy &amp; Third-Party Script Preferences
+              </h2>
+              <button
+                type="button"
+                data-skip-tracking="true"
+                onClick={() => setIsModalOpen(false)}
+                className="text-gray-500 hover:text-gray-800 text-sm font-semibold"
+                aria-label="Close privacy preferences"
+              >
+                ✕
+              </button>
+            </div>
+
+            {privacySignalDetected && (
+              <div className="mb-4 p-3 bg-blue-50 border border-blue-200 rounded text-xs text-blue-900">
+                <strong>Browser Privacy Signal Active:</strong> We detected Global Privacy Control (GPC) or Do Not
+                Track (DNT) from your browser and automatically disabled all third-party scripts.
+              </div>
+            )}
+
+            <form onSubmit={handleSaveCustom} className="space-y-4 text-sm">
+              <div className="p-3 bg-gray-50 rounded border border-gray-200">
+                <div className="flex items-center justify-between">
+                  <span className="font-semibold text-gray-900">Strictly Necessary (First-Party)</span>
+                  <span className="text-xs font-medium text-gray-600 bg-gray-200 px-2 py-0.5 rounded">
+                    Always Active
+                  </span>
+                </div>
+                <p className="text-xs text-gray-600 mt-1">
+                  Used only when you actively save articles to your Reading List or authenticate. No session cookies
+                  are created for passive reading, and no data is shared with third parties.
+                </p>
+              </div>
+
+              <div className="p-3 bg-white rounded border border-gray-200">
+                <label className="flex items-start justify-between gap-3 cursor-pointer">
+                  <div>
+                    <span className="font-semibold text-gray-900 block">
+                      Third-Party Interaction Analytics (Opt-In)
+                    </span>
+                    <span className="text-xs text-gray-600 block mt-1">
+                      If enabled, loads <code>analytics-client.js</code> from{' '}
+                      <code>cloudfunctions.net/times_cdn</code> to record link and button clicks. Never loaded on Sign
+                      In or Sign Up pages. Disabled by default.
+                    </span>
+                  </div>
+                  <input
+                    type="checkbox"
+                    checked={consent.analytics && !privacySignalDetected}
+                    disabled={privacySignalDetected}
+                    onChange={(e) => setConsent({ ...consent, analytics: e.target.checked })}
+                    className="mt-1 h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+                  />
+                </label>
+              </div>
+
+              <div className="p-3 bg-white rounded border border-gray-200">
+                <label className="flex items-start justify-between gap-3 cursor-pointer">
+                  <div>
+                    <span className="font-semibold text-gray-900 block">
+                      Third-Party Contextual Ads (Opt-In)
+                    </span>
+                    <span className="text-xs text-gray-600 block mt-1">
+                      If enabled, loads <code>ad-client.js</code> from <code>cloudfunctions.net/times_cdn</code> to
+                      display banner and fireplace ad slots. Disabled by default.
+                    </span>
+                  </div>
+                  <input
+                    type="checkbox"
+                    checked={consent.ads && !privacySignalDetected}
+                    disabled={privacySignalDetected}
+                    onChange={(e) => setConsent({ ...consent, ads: e.target.checked })}
+                    className="mt-1 h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+                  />
+                </label>
+              </div>
+
+              <div className="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-gray-200">
+                <a
+                  href={`${normalizedBase}legal/privacy`}
+                  className="text-xs text-gray-600 underline hover:text-gray-900"
+                >
+                  View Full Privacy Policy
+                </a>
+                <div className="flex items-center gap-2">
+                  <button
+                    type="button"
+                    data-skip-tracking="true"
+                    onClick={handleRejectAll}
+                    className="px-3 py-1.5 text-xs font-semibold text-gray-800 bg-gray-100 border border-gray-300 rounded hover:bg-gray-200"
+                  >
+                    Disable All Optional
+                  </button>
+                  <button
+                    type="submit"
+                    data-skip-tracking="true"
+                    className="px-3 py-1.5 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800"
+                  >
+                    Save Preferences
+                  </button>
+                </div>
+              </div>
+            </form>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}
