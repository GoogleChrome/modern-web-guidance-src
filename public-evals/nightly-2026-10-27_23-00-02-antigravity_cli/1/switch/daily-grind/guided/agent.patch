+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const preferencesForm = document.getElementById('preferences-form');
+    const statusRegion = document.getElementById('preferences-status');
+
+    document.querySelectorAll('input[type="checkbox"][switch]').forEach((switchInput) => {
+      switchInput.addEventListener('change', (event) => {
+        const isChecked = event.currentTarget.checked;
+        const label = document.querySelector(`label[for="${event.currentTarget.id}"]`);
+        const labelText = label ? label.textContent.trim() : event.currentTarget.name;
+        statusRegion.textContent = `${labelText}: ${isChecked ? 'On' : 'Off'}.`;
+      });
+    });
+
+    preferencesForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      statusRegion.textContent = 'Preferences saved.';
+    });
+  </script>
