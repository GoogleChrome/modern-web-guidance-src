+  <script>
+    (function () {
+      const liveRegion = document.getElementById('switch-live-region');
+
+      function updateSwitchUI(switchEl, isChecked, announce = false) {
+        switchEl.setAttribute('aria-checked', String(isChecked));
+
+        const stateText = document.querySelector(`[data-state-for="${switchEl.id}"]`);
+        if (stateText) {
+          stateText.textContent = isChecked ? 'On' : 'Off';
+        }
+
+        const target = switchEl.getAttribute('data-switch-target');
+        if (target === 'theme') {
+          document.documentElement.setAttribute('data-theme', isChecked ? 'dark' : 'light');
+          try {
+            localStorage.setItem('daily-grind-theme', isChecked ? 'dark' : 'light');
+          } catch (_) {}
+        } else if (target === 'decaf-filter' || target === 'dairy-free-filter') {
+          applyMenuFilters();
+        } else if (target === 'cup-discount') {
+          applyCupDiscount(isChecked);
+        }
+
+        if (announce && liveRegion) {
+          const labelId = switchEl.getAttribute('aria-labelledby');
+          const labelEl = labelId ? document.getElementById(labelId) : null;
+          const name = labelEl ? labelEl.textContent.trim() : 'Switch';
+          liveRegion.textContent = `${name} ${isChecked ? 'enabled' : 'disabled'}.`;
+        }
+      }
+
+      function applyMenuFilters() {
+        const decafOnly = document.getElementById('decaf-switch')?.getAttribute('aria-checked') === 'true';
+        const dairyFreeOnly = document.getElementById('dairy-free-switch')?.getAttribute('aria-checked') === 'true';
+        const cards = document.querySelectorAll('#menu-grid .card');
+
+        cards.forEach((card) => {
+          const matchesDecaf = !decafOnly || card.getAttribute('data-decaf') === 'true';
+          const matchesDairyFree = !dairyFreeOnly || card.getAttribute('data-dairy-free') === 'true';
+          card.hidden = !(matchesDecaf && matchesDairyFree);
+        });
+      }
+
+      function applyCupDiscount(discountActive) {
+        const prices = document.querySelectorAll('.card .price[data-base-price]');
+        prices.forEach((priceEl) => {
+          const base = parseFloat(priceEl.getAttribute('data-base-price'));
+          if (!Number.isNaN(base)) {
+            const finalPrice = discountActive ? Math.max(0, base - 0.5) : base;
+            priceEl.textContent = `$${finalPrice.toFixed(2)}${discountActive ? ' (Cup Discount)' : ''}`;
+          }
+        });
+      }
+
+      function toggleSwitch(switchEl) {
+        if (switchEl.disabled || switchEl.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+        const current = switchEl.getAttribute('aria-checked') === 'true';
+        updateSwitchUI(switchEl, !current, true);
+      }
+
+      // Initialize all accessible switches
+      const switches = document.querySelectorAll('button[role="switch"]');
+      switches.forEach((switchEl) => {
+        switchEl.addEventListener('click', () => {
+          toggleSwitch(switchEl);
+        });
+      });
+
+      // Allow clicking associated labels to toggle and focus the switch
+      const labels = document.querySelectorAll('[data-switch-for]');
+      labels.forEach((labelEl) => {
+        labelEl.addEventListener('click', () => {
+          const targetId = labelEl.getAttribute('data-switch-for');
+          const switchEl = targetId ? document.getElementById(targetId) : null;
+          if (switchEl) {
+            switchEl.focus();
+            toggleSwitch(switchEl);
+          }
+        });
+      });
+
+      // Restore saved theme preference if available
+      try {
+        const savedTheme = localStorage.getItem('daily-grind-theme');
+        const darkModeSwitch = document.getElementById('dark-mode-switch');
+        if (savedTheme === 'dark' && darkModeSwitch) {
+          updateSwitchUI(darkModeSwitch, true, false);
+        }
