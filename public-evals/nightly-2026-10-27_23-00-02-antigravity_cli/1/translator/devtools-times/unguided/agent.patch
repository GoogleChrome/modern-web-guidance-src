+export function useOnDeviceTranslation() {
+  const [targetLanguage, setTargetLanguage] = useState<string>('en');
+  const [status, setStatus] = useState<TranslationStatus>({
+    state: 'idle',
+    sourceLanguage: 'en',
+    targetLanguage: 'en',
+    engine: 'none',
+    progress: 0,
+    translatedCount: 0,
+    totalCount: 0,
+  });
+  const [hasBrowserAI, setHasBrowserAI] = useState<boolean>(false);
+
+  useEffect(() => {
+    setHasBrowserAI(isBrowserTranslatorSupported());
+    const saved = getSavedLanguage();
+    if (saved && saved !== 'en') {
+      setTargetLanguage(saved);
+      translatePageContent(saved, 'en', setStatus);
+    }
+
+    const handleExternalChange = (e: Event) => {
+      const customEvent = e as CustomEvent<TranslationStatus>;
+      if (customEvent.detail) {
+        setStatus(customEvent.detail);
+        setTargetLanguage(customEvent.detail.targetLanguage);
+      }
+    };
+
+    const handlePageLoad = () => {
+      const currentSaved = getSavedLanguage();
+      if (currentSaved && currentSaved !== 'en') {
+        setTargetLanguage(currentSaved);
+        translatePageContent(currentSaved, 'en', setStatus);
+      }
+    };
+
+    window.addEventListener('devtools-times:language-changed', handleExternalChange);
+    document.addEventListener('astro:page-load', handlePageLoad);
+
+    return () => {
+      window.removeEventListener('devtools-times:language-changed', handleExternalChange);
+      document.removeEventListener('astro:page-load', handlePageLoad);
+    };
+  }, []);
+
+  const selectLanguage = useCallback(async (langCode: string) => {
+    setTargetLanguage(langCode);
+    await translatePageContent(langCode, 'en', setStatus);
+  }, []);
+
+  const resetToOriginal = useCallback(async () => {
+    setTargetLanguage('en');
+    await translatePageContent('en', 'en', setStatus);
+  }, []);
+
+  return {
+    targetLanguage,
+    status,
+    hasBrowserAI,
+    selectLanguage,
+    resetToOriginal,
+    languages: SUPPORTED_LANGUAGES,
+  };
+}
