+// Cache of translated strings: key = `${sourceLang}:${targetLang}:${text}`
+const translationCache = new Map<string, string>();
+const STORAGE_KEY = 'devtools_times_preferred_lang';
+
+// Store original text on DOM elements using WeakMap & data attribute
+const originalTextMap = new WeakMap<Element, string>();
+
+function getTranslatorAPI(): any {
+  if (typeof window === 'undefined') return null;
+  const w = window as any;
+  if ('Translator' in w && w.Translator) return w.Translator;
+  if (w.ai?.translator) return w.ai.translator;
+  if (w.translation?.createTranslator) return w.translation;
+  return null;
+}
+
+function getLanguageDetectorAPI(): any {
+  if (typeof window === 'undefined') return null;
+  const w = window as any;
+  if ('LanguageDetector' in w && w.LanguageDetector) return w.LanguageDetector;
+  if (w.ai?.languageDetector) return w.ai.languageDetector;
+  if (w.translation?.createDetector) return w.translation;
+  return null;
+}
+
+export function isBrowserTranslatorSupported(): boolean {
+  return getTranslatorAPI() !== null;
+}
+
+export async function detectLanguageOnDevice(sampleText: string): Promise<string> {
+  const detectorAPI = getLanguageDetectorAPI();
+  if (!detectorAPI || !sampleText.trim()) {
+    return 'en';
+  }
+
+  try {
+    if (typeof detectorAPI.availability === 'function') {
+      const avail = await detectorAPI.availability();
+      if (avail === 'no' || avail === 'unavailable') return 'en';
+    }
+    const detector = detectorAPI.create
+      ? await detectorAPI.create()
+      : await detectorAPI.createDetector();
+    const results = await detector.detect(sampleText.slice(0, 500));
+    if (Array.isArray(results) && results.length > 0 && results[0].detectedLanguage) {
+      return results[0].detectedLanguage;
+    }
+  } catch (err) {
+    console.warn('[On-Device Translation] LanguageDetector fallback to en:', err);
+  }
+  return 'en';
+}
+
+async function createBrowserTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onProgress?: (progress: number) => void
+): Promise<any | null> {
+  const api = getTranslatorAPI();
+  if (!api) return null;
+
+  const pair = { sourceLanguage, targetLanguage };
+
+  try {
+    if (typeof api.availability === 'function') {
+      const availability = await api.availability(pair);
+      if (availability === 'no' || availability === 'unavailable') {
+        return null;
+      }
+    } else if (typeof api.canTranslate === 'function') {
+      const can = await api.canTranslate(pair);
+      if (can === 'no') return null;
+    }
+
+    const createFn = api.create ? api.create.bind(api) : api.createTranslator.bind(api);
+    const translator = await createFn({
+      ...pair,
+      monitor(m: any) {
+        if (m && typeof m.addEventListener === 'function') {
+          m.addEventListener('downloadprogress', (e: any) => {
+            const raw = typeof e.loaded === 'number'
+              ? e.total ? e.loaded / e.total : e.loaded
+              : 0;
+            const pct = Math.min(100, Math.max(0, Math.round(raw * 100)));
+            onProgress?.(pct);
+          });
+        }
+      },
+    });
+
+    if (translator?.ready) {
+      await translator.ready;
+    }
+
+    return translator;
+  } catch (err) {
+    console.warn('[On-Device Translation] Browser Translator API failed or unavailable, using local fallback:', err);
+    return null;
+  }
+}
+
+function translateWithLocalDictionary(text: string, targetLang: string): string {
+  const trimmed = text.trim();
+  if (!trimmed) return text;
+
+  const dict = LOCAL_TRANSLATIONS[targetLang];
+  if (dict && dict[trimmed]) {
+    return text.replace(trimmed, dict[trimmed]);
+  }
+
+  let result = text;
+  if (dict) {
+    for (const [enText, translated] of Object.entries(dict)) {
+      if (enText.length > 12 && result.includes(enText)) {
+        result = result.replace(enText, translated);
+      }
+    }
+  }
+
+  const rules = WORD_FALLBACKS[targetLang];
+  if (rules) {
+    for (const [pattern, replacement] of rules) {
+      result = result.replace(pattern, replacement);
+    }
+  }
+
+  return result;
+}
+
+export async function translateTextString(
+  text: string,
+  targetLanguage: string,
+  sourceLanguage = 'en',
+  translatorInstance?: any
+): Promise<string> {
+  const trimmed = text.trim();
+  if (!trimmed || sourceLanguage === targetLanguage) return text;
+
+  const cacheKey = `${sourceLanguage}:${targetLanguage}:${trimmed}`;
+  if (translationCache.has(cacheKey)) {
+    return translationCache.get(cacheKey)!;
+  }
+
+  if (translatorInstance && typeof translatorInstance.translate === 'function') {
+    try {
+      const translated = await translatorInstance.translate(trimmed);
+      if (translated) {
+        translationCache.set(cacheKey, translated);
+        return translated;
+      }
+    } catch (err) {
+      console.warn('[On-Device Translation] Failed to translate segment via browser AI:', err);
+    }
+  }
+
+  const fallback = translateWithLocalDictionary(trimmed, targetLanguage);
+  translationCache.set(cacheKey, fallback);
+  return fallback;
+}
+
+/**
+ * Collects all translatable DOM elements on the current page (articles, teasers, headings, summaries, body paragraphs).
+ */
+export function getTranslatableElements(root: ParentNode = document): HTMLElement[] {
+  const selectors = [
+    '[data-translatable]',
+    // Article page headline, summary, body paragraphs, headings, list items, figcaptions
+    'article h1',
+    'article h2',
+    'article h3',
+    'article > p',
+    'article figcaption',
+    'article .prose p',
+    'article .prose h2',
+    'article .prose h3',
+    'article .prose h4',
+    'article .prose li',
+    'article .prose blockquote',
+    // Teaser grids and cards across homepage, category pages, and related articles
+    'main h1',
+    'main h2',
+    'main h3',
+    'main p',
+    'section h2',
+    'section h3',
+    'section p',
+  ];
+
+  const nodeList = root.querySelectorAll<HTMLElement>(selectors.join(', '));
+  const uniqueElements: HTMLElement[] = [];
+  const seen = new Set<HTMLElement>();
+
+  nodeList.forEach((el) => {
+    if (seen.has(el)) return;
+    // Skip elements inside the translation control UI itself or script/style tags
+    if (el.closest('[data-no-translate]')) return;
+    // Skip elements that contain other block-level translatable elements unless they only have inline formatting
+    const hasBlockChildren = el.querySelector('p, h1, h2, h3, h4, ul, ol, div, article, section');
+    if (hasBlockChildren) return;
+
+    const text = (originalTextMap.get(el) ?? el.textContent ?? '').trim();
+    if (!text || text.length < 2) return;
+
+    seen.add(el);
+    uniqueElements.push(el);
+  });
+
+  return uniqueElements;
+}
+
+export function restoreOriginalContent(root: ParentNode = document): void {
+  const elements = getTranslatableElements(root);
+  elements.forEach((el) => {
+    const original = originalTextMap.get(el) ?? el.getAttribute('data-original-text');
+    if (original !== null && original !== undefined) {
+      el.textContent = original;
+      el.removeAttribute('data-translated-lang');
+    }
+  });
+  if (root === document && typeof document !== 'undefined') {
+    document.documentElement.lang = 'en';
+  }
+}
+
+export async function translatePageContent(
+  targetLanguage: string,
+  sourceLanguage = 'en',
+  onStatusUpdate?: (status: TranslationStatus) => void,
+  root: ParentNode = document
+): Promise<TranslationStatus> {
+  if (typeof window !== 'undefined') {
+    try {
+      localStorage.setItem(STORAGE_KEY, targetLanguage);
+    } catch {}
+  }
+
+  if (targetLanguage === 'en' || targetLanguage === sourceLanguage) {
+    restoreOriginalContent(root);
+    const idleStatus: TranslationStatus = {
+      state: 'idle',
+      sourceLanguage: 'en',
+      targetLanguage: 'en',
+      engine: 'none',
+      progress: 100,
+      translatedCount: 0,
+      totalCount: 0,
+    };
+    onStatusUpdate?.(idleStatus);
+    window.dispatchEvent(new CustomEvent('devtools-times:language-changed', { detail: idleStatus }));
+    return idleStatus;
+  }
+
+  const elements = getTranslatableElements(root);
+  const totalCount = elements.length;
+
+  // Save original text before mutating
+  elements.forEach((el) => {
+    if (!originalTextMap.has(el)) {
+      const currentText = el.getAttribute('data-original-text') ?? el.textContent ?? '';
+      originalTextMap.set(el, currentText);
+      el.setAttribute('data-original-text', currentText);
+    }
+  });
+
+  onStatusUpdate?.({
+    state: 'checking',
+    sourceLanguage,
+    targetLanguage,
+    engine: 'none',
+    progress: 0,
+    translatedCount: 0,
+    totalCount,
+  });
+
+  // Optionally detect source language from first substantial element
+  const sampleEl = elements.find((el) => (originalTextMap.get(el)?.length ?? 0) > 30);
+  const sampleText = sampleEl ? originalTextMap.get(sampleEl)! : '';
+  const detectedLanguage = sampleText ? await detectLanguageOnDevice(sampleText) : sourceLanguage;
+  const effectiveSource = detectedLanguage && detectedLanguage !== 'und' ? detectedLanguage : sourceLanguage;
+
+  let engine: 'browser-ai' | 'local-dictionary' = 'local-dictionary';
+  const translator = await createBrowserTranslator(effectiveSource, targetLanguage, (downloadPct) => {
+    onStatusUpdate?.({
+      state: 'downloading',
+      sourceLanguage: effectiveSource,
+      targetLanguage,
+      detectedLanguage,
+      engine: 'browser-ai',
+      progress: downloadPct,
+      translatedCount: 0,
+      totalCount,
+    });
+  });
+
+  if (translator) {
+    engine = 'browser-ai';
+  }
+
+  let translatedCount = 0;
+
+  for (const el of elements) {
+    const sourceText = originalTextMap.get(el) ?? el.textContent ?? '';
+    if (!sourceText.trim()) continue;
+
+    const translated = await translateTextString(
+      sourceText,
+      targetLanguage,
+      effectiveSource,
+      translator
+    );
+
+    el.textContent = translated;
+    el.setAttribute('data-translated-lang', targetLanguage);
+    translatedCount++;
+
+    const progress = totalCount > 0 ? Math.round((translatedCount / totalCount) * 100) : 100;
+    onStatusUpdate?.({
+      state: 'translating',
+      sourceLanguage: effectiveSource,
+      targetLanguage,
+      detectedLanguage,
+      engine,
+      progress,
+      translatedCount,
+      totalCount,
+    });
+  }
+
+  if (root === document && typeof document !== 'undefined') {
+    document.documentElement.lang = targetLanguage;
+  }
+
+  const finalStatus: TranslationStatus = {
+    state: 'translated',
+    sourceLanguage: effectiveSource,
+    targetLanguage,
+    detectedLanguage,
+    engine,
+    progress: 100,
+    translatedCount,
+    totalCount,
+  };
+
+  onStatusUpdate?.(finalStatus);
+  window.dispatchEvent(new CustomEvent('devtools-times:language-changed', { detail: finalStatus }));
+
+  if (translator && typeof translator.destroy === 'function') {
+    try {
+      translator.destroy();
+    } catch {}
+  }
+
+  return finalStatus;
+}
+
+export function getSavedLanguage(): string {
+  if (typeof window === 'undefined') return 'en';
+  try {
+    return localStorage.getItem(STORAGE_KEY) || 'en';
+  } catch {
+    return 'en';
+  }
+}
