diff --git a/src/components/TranslationControl.tsx b/src/components/TranslationControl.tsx
new file mode 100644
index 0000000..ddd3e5d
--- /dev/null
+++ b/src/components/TranslationControl.tsx
@@ -0,0 +1,321 @@
+import React, { useState, useRef, useEffect } from 'react';
+import { LanguageIcon, ArrowPathIcon, CheckIcon, SparklesIcon } from '@heroicons/react/24/outline';
+import {
+  useOnDeviceTranslation,
+  translatePageContent,
+  restoreOriginalContent,
+  SUPPORTED_LANGUAGES,
+  type TranslationStatus,
+} from '../utils/translator';
+
+interface TranslationControlProps {
+  variant?: 'header' | 'article' | 'teaser';
+  scopeSelector?: string;
+}
+
+export default function TranslationControl({
+  variant = 'header',
+  scopeSelector,
+}: TranslationControlProps) {
+  const {
+    targetLanguage,
+    status,
+    hasBrowserAI,
+    selectLanguage,
+    resetToOriginal,
+    languages,
+  } = useOnDeviceTranslation();
+
+  const [isOpen, setIsOpen] = useState(false);
+  const [localLang, setLocalLang] = useState('en');
+  const [localStatus, setLocalStatus] = useState<TranslationStatus | null>(null);
+  const containerRef = useRef<HTMLDivElement>(null);
+
+  const activeLang = scopeSelector ? localLang : targetLanguage;
+  const activeStatus = scopeSelector && localStatus ? localStatus : status;
+  const currentLangObj =
+    languages.find((l) => l.code === activeLang) || SUPPORTED_LANGUAGES[0];
+
+  useEffect(() => {
+    const handleClickOutside = (e: MouseEvent) => {
+      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {
+        setIsOpen(false);
+      }
+    };
+    document.addEventListener('mousedown', handleClickOutside);
+    return () => document.removeEventListener('mousedown', handleClickOutside);
+  }, []);
+
+  const handleLanguageChange = async (langCode: string) => {
+    setIsOpen(false);
+    if (scopeSelector) {
+      const rootEl =
+        containerRef.current?.closest(scopeSelector) ||
+        document.querySelector(scopeSelector) ||
+        document;
+      setLocalLang(langCode);
+      if (langCode === 'en') {
+        restoreOriginalContent(rootEl);
+        setLocalStatus(null);
+      } else {
+        await translatePageContent(langCode, 'en', setLocalStatus, rootEl);
+      }
+    } else {
+      await selectLanguage(langCode);
+    }
+  };
+
+  const handleReset = async () => {
+    setIsOpen(false);
+    if (scopeSelector) {
+      const rootEl =
+        containerRef.current?.closest(scopeSelector) ||
+        document.querySelector(scopeSelector) ||
+        document;
+      setLocalLang('en');
+      restoreOriginalContent(rootEl);
+      setLocalStatus(null);
+    } else {
+      await resetToOriginal();
+    }
+  };
+
+  const isBusy =
+    activeStatus.state === 'checking' ||
+    activeStatus.state === 'downloading' ||
+    activeStatus.state === 'translating';
+
+  if (variant === 'teaser') {
+    return (
+      <div
+        ref={containerRef}
+        data-no-translate="true"
+        className="relative inline-flex items-center"
+      >
+        <button
+          type="button"
+          onClick={(e) => {
+            e.preventDefault();
+            e.stopPropagation();
+            setIsOpen((prev) => !prev);
+          }}
+          title="Translate teaser on-device"
+          aria-label="Translate teaser on-device"
+          className={`inline-flex items-center space-x-1 text-xs px-2 py-1 rounded transition-colors ${
+            activeLang !== 'en'
+              ? 'bg-amber-100 text-amber-900 font-semibold'
+              : 'text-gray-500 hover:text-amber-600 hover:bg-gray-100'
+          }`}
+        >
+          {isBusy ? (
+            <ArrowPathIcon className="w-3.5 h-3.5 animate-spin text-amber-600" />
+          ) : (
+            <LanguageIcon className="w-4 h-4" />
+          )}
+          <span>{activeLang === 'en' ? 'Translate' : currentLangObj.code.toUpperCase()}</span>
+        </button>
+
+        {isOpen && (
+          <div
+            onClick={(e) => {
+              e.preventDefault();
+              e.stopPropagation();
+            }}
+            className="absolute bottom-full right-0 mb-1 w-44 bg-white border border-gray-200 rounded-md shadow-lg py-1 z-30 text-xs"
+          >
+            <div className="px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-gray-400 border-b border-gray-100 flex items-center justify-between">
+              <span>On-Device Translate</span>
+              <SparklesIcon className="w-3 h-3 text-amber-500" />
+            </div>
+            {languages.map((lang) => (
+              <button
+                key={lang.code}
+                type="button"
+                onClick={() => handleLanguageChange(lang.code)}
+                className={`w-full text-left px-3 py-1.5 flex items-center justify-between hover:bg-amber-50 transition-colors ${
+                  activeLang === lang.code ? 'bg-amber-50/70 font-semibold text-amber-900' : 'text-gray-700'
+                }`}
+              >
+                <span className="flex items-center space-x-1.5">
+                  <span>{lang.flag}</span>
+                  <span>{lang.nativeName}</span>
+                </span>
+                {activeLang === lang.code && <CheckIcon className="w-3.5 h-3.5 text-amber-600" />}
+              </button>
+            ))}
+          </div>
+        )}
+      </div>
+    );
+  }
+
+  if (variant === 'article') {
+    return (
+      <div
+        ref={containerRef}
+        data-no-translate="true"
+        className="bg-gray-50 border border-gray-200 rounded-lg p-3 sm:px-4 sm:py-3 my-4 flex flex-wrap items-center justify-between gap-3"
+      >
+        <div className="flex items-center space-x-2.5">
+          <div className="p-1.5 bg-amber-100 text-amber-800 rounded-md">
+            <LanguageIcon className="w-5 h-5" />
+          </div>
+          <div>
+            <div className="flex items-center space-x-2">
+              <span className="text-sm font-semibold text-gray-900">
+                On-Device Article Translation
+              </span>
+              <span className="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-amber-100 text-amber-800">
+                <SparklesIcon className="w-3 h-3 mr-1" />
+                {hasBrowserAI ? 'Chrome Built-in AI' : 'Browser Local Engine'}
+              </span>
+            </div>
+            <p className="text-xs text-gray-500">
+              {activeStatus.state === 'downloading'
+                ? `Downloading language model (${activeStatus.progress}%)...`
+                : activeStatus.state === 'translating'
+                ? `Translating article on-device (${activeStatus.translatedCount}/${activeStatus.totalCount})...`
+                : activeLang !== 'en'
+                ? `Translated to ${currentLangObj.name} (${currentLangObj.nativeName}) directly in your browser.`
+                : 'Translate this article and its teasers privately on your device.'}
+            </p>
+          </div>
+        </div>
+
+        <div className="flex items-center space-x-2">
+          <label htmlFor="article-language-select" className="sr-only">
+            Select translation language
+          </label>
+          <select
+            id="article-language-select"
+            aria-label="Translate article to language"
+            value={activeLang}
+            disabled={isBusy}
+            onChange={(e) => handleLanguageChange(e.target.value)}
+            className="text-xs sm:text-sm font-medium bg-white border border-gray-300 text-gray-800 rounded-md px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer disabled:opacity-60"
+          >
+            {languages.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.flag} {lang.nativeName} ({lang.name})
+              </option>
+            ))}
+          </select>
+
+          {activeLang !== 'en' && (
+            <button
+              type="button"
+              onClick={handleReset}
+              disabled={isBusy}
+              className="text-xs font-semibold text-amber-800 hover:text-amber-900 bg-amber-100 hover:bg-amber-200 px-2.5 py-1.5 rounded-md transition-colors cursor-pointer"
+            >
+              Show Original
+            </button>
+          )}
+        </div>
+      </div>
+    );
+  }
+
+  // Default: 'header' variant
+  return (
+    <div
+      ref={containerRef}
+      data-no-translate="true"
+      className="relative inline-flex items-center"
+    >
+      <button
+        type="button"
+        onClick={() => setIsOpen((prev) => !prev)}
+        aria-expanded={isOpen}
+        aria-haspopup="listbox"
+        aria-label="Translate articles and teasers on-device"
+        title="On-Device Translation (Translate articles & teasers)"
+        className={`inline-flex items-center space-x-1.5 text-xs font-semibold py-1.5 px-2.5 rounded border transition-colors cursor-pointer ${
+          activeLang !== 'en'
+            ? 'bg-amber-50 border-amber-400 text-amber-900'
+            : 'bg-white border-gray-300 text-gray-700 hover:border-amber-400 hover:text-gray-900'
+        }`}
+      >
+        {isBusy ? (
+          <ArrowPathIcon className="w-4 h-4 animate-spin text-amber-600" />
+        ) : (
+          <LanguageIcon className="w-4 h-4 text-amber-700" />
+        )}
+        <span className="hidden sm:inline">
+          {activeLang === 'en' ? 'Translate' : `${currentLangObj.flag} ${currentLangObj.nativeName}`}
+        </span>
+        <span className="sm:hidden">{currentLangObj.code.toUpperCase()}</span>
+        {isBusy && (
+          <span className="text-[10px] text-amber-700 font-normal">
+            {activeStatus.progress}%
+          </span>
+        )}
+      </button>
+
+      {isOpen && (
+        <div
+          role="listbox"
+          aria-label="Language selection"
+          className="absolute left-0 top-full mt-1.5 w-64 bg-white border border-gray-200 rounded-lg shadow-xl py-2 z-50"
+        >
+          <div className="px-3 pb-2 mb-1 border-b border-gray-100">
+            <div className="flex items-center justify-between">
+              <span className="text-xs font-bold text-gray-800 flex items-center gap-1">
+                <SparklesIcon className="w-3.5 h-3.5 text-amber-500" />
+                On-Device Translation
+              </span>
+              <span className="text-[10px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-600 font-medium">
+                {hasBrowserAI ? 'Translator API' : 'Local Mode'}
+              </span>
+            </div>
+            <p className="text-[11px] text-gray-500 mt-0.5">
+              Translate articles & teasers directly in your browser.
+            </p>
+          </div>
+
+          <div className="max-h-60 overflow-y-auto py-1">
+            {languages.map((lang) => {
+              const isSelected = activeLang === lang.code;
+              return (
+                <button
+                  key={lang.code}
+                  type="button"
+                  role="option"
+                  aria-selected={isSelected}
+                  onClick={() => handleLanguageChange(lang.code)}
+                  className={`w-full text-left px-3 py-2 text-xs flex items-center justify-between hover:bg-amber-50 transition-colors cursor-pointer ${
+                    isSelected ? 'bg-amber-50/80 font-semibold text-amber-900' : 'text-gray-700'
+                  }`}
+                >
+                  <span className="flex items-center space-x-2">
+                    <span className="text-sm">{lang.flag}</span>
+                    <span>
+                      {lang.nativeName}{' '}
+                      <span className="text-gray-400 font-normal">({lang.name})</span>
+                    </span>
+                  </span>
+                  {isSelected && <CheckIcon className="w-4 h-4 text-amber-600" />}
+                </button>
+              );
+            })}
+          </div>
+
+          {activeLang !== 'en' && (
+            <div className="pt-1.5 mt-1 px-3 border-t border-gray-100 flex justify-between items-center">
+              <span className="text-[11px] text-gray-500">
+                Active: {currentLangObj.name}
+              </span>
+              <button
+                type="button"
+                onClick={handleReset}
+                className="text-xs font-semibold text-amber-700 hover:text-amber-900 hover:underline cursor-pointer"
+              >
+                Reset to English
+              </button>
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
