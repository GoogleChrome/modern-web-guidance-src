diff --git a/src/components/TranslationControl.tsx b/src/components/TranslationControl.tsx
new file mode 100644
index 0000000..1af2d2e
--- /dev/null
+++ b/src/components/TranslationControl.tsx
@@ -0,0 +1,394 @@
+import React, { useState, useEffect, useId, useRef } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  isTranslatorSupported,
+  isLanguageDetectorSupported,
+  checkLanguagePairAvailability,
+  detectSampleLanguage,
+  translateElements,
+  restoreOriginalContent,
+  collectTranslatableElements,
+  getOriginalText,
+} from '../utils/translator';
+
+interface TranslationControlProps {
+  /** Optional CSS selector to scope translation (defaults to the whole document) */
+  scopeSelector?: string;
+  /** Compact layout for header bar vs full card layout for article pages */
+  variant?: 'header' | 'article';
+}
+
+export default function TranslationControl({
+  scopeSelector,
+  variant = 'article',
+}: TranslationControlProps) {
+  const idPrefix = useId();
+  const [supported, setSupported] = useState<boolean | null>(null);
+  const [detectorSupported, setDetectorSupported] = useState<boolean>(false);
+  const [sourceLanguage, setSourceLanguage] = useState<string>('en');
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [availability, setAvailability] = useState<AvailabilityStatus | 'checking'>('checking');
+  const [status, setStatus] = useState<'idle' | 'downloading' | 'translating' | 'translated' | 'error'>('idle');
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [translationProgress, setTranslationProgress] = useState<{ completed: number; total: number } | null>(null);
+  const [statusMessage, setStatusMessage] = useState<string>('');
+  const [detectedInfo, setDetectedInfo] = useState<string | null>(null);
+  const [isExpanded, setIsExpanded] = useState<boolean>(variant === 'article');
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  const getRootNode = (): ParentNode => {
+    if (typeof document === 'undefined') return null as unknown as ParentNode;
+    if (scopeSelector) {
+      return document.querySelector(scopeSelector) ?? document;
+    }
+    return document;
+  };
+
+  useEffect(() => {
+    const hasTranslator = isTranslatorSupported();
+    setSupported(hasTranslator);
+    setDetectorSupported(isLanguageDetectorSupported());
+  }, []);
+
+  useEffect(() => {
+    if (!supported) {
+      setAvailability('unavailable');
+      return;
+    }
+    let cancelled = false;
+    setAvailability('checking');
+    checkLanguagePairAvailability(sourceLanguage, targetLanguage).then((res) => {
+      if (!cancelled) {
+        setAvailability(res);
+      }
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [supported, sourceLanguage, targetLanguage]);
+
+  const handleSwapLanguages = () => {
+    setSourceLanguage(targetLanguage);
+    setTargetLanguage(sourceLanguage);
+    setDetectedInfo(null);
+  };
+
+  const handleDetectLanguage = async () => {
+    const root = getRootNode();
+    if (!root) return;
+    const elements = collectTranslatableElements(root);
+    const sample = elements
+      .slice(0, 4)
+      .map((el) => getOriginalText(el))
+      .join(' ')
+      .slice(0, 500);
+
+    if (!sample) {
+      setStatusMessage('No translatable text found on this page.');
+      return;
+    }
+
+    setStatusMessage('Detecting language on-device...');
+    const detected = await detectSampleLanguage(sample, (loaded) => {
+      setDownloadProgress(Math.round(loaded * 100));
+    });
+    setDownloadProgress(null);
+
+    if (detected) {
+      const matched = SUPPORTED_LANGUAGES.find(
+        (l) => l.code === detected.detectedLanguage || detected.detectedLanguage.startsWith(l.code)
+      );
+      if (matched) {
+        setSourceLanguage(matched.code);
+        const pct = Math.round(detected.confidence * 100);
+        setDetectedInfo(`Detected ${matched.label} (${pct}%)`);
+        setStatusMessage(`Detected source language: ${matched.label}`);
+        if (matched.code === targetLanguage) {
+          setTargetLanguage(matched.code === 'en' ? 'es' : 'en');
+        }
+      } else {
+        setStatusMessage(`Detected language "${detected.detectedLanguage}" is not in the supported list.`);
+      }
+    } else {
+      setStatusMessage('Could not automatically detect the source language.');
+    }
+  };
+
+  const handleTranslate = async () => {
+    const root = getRootNode();
+    if (!root) return;
+
+    if (abortControllerRef.current) {
+      abortControllerRef.current.abort();
+    }
+    const controller = new AbortController();
+    abortControllerRef.current = controller;
+
+    if (sourceLanguage === targetLanguage) {
+      restoreOriginalContent(root);
+      setStatus('idle');
+      setStatusMessage('Restored original language.');
+      return;
+    }
+
+    try {
+      setStatus(availability === 'downloadable' || availability === 'downloading' ? 'downloading' : 'translating');
+      setDownloadProgress(null);
+      setTranslationProgress(null);
+      setStatusMessage('Preparing on-device translation...');
+
+      const { translatedCount } = await translateElements({
+        sourceLanguage,
+        targetLanguage,
+        root,
+        signal: controller.signal,
+        onDownloadProgress: (loadedFraction) => {
+          setStatus('downloading');
+          const pct = Math.round(loadedFraction * 100);
+          setDownloadProgress(pct);
+          setStatusMessage(`Downloading on-device language model (${pct}%)...`);
+        },
+        onTranslationProgress: (completed, total) => {
+          setStatus('translating');
+          setDownloadProgress(null);
+          setTranslationProgress({ completed, total });
+          setStatusMessage(`Translating on-device (${completed}/${total} sections)...`);
+        },
+      });
+
+      if (!controller.signal.aborted) {
+        setStatus('translated');
+        setDownloadProgress(null);
+        setTranslationProgress(null);
+        setAvailability('available');
+        const targetLabel = SUPPORTED_LANGUAGES.find((l) => l.code === targetLanguage)?.label ?? targetLanguage;
+        setStatusMessage(`Translated ${translatedCount} sections into ${targetLabel} on-device.`);
+      }
+    } catch (err: any) {
+      if (controller.signal.aborted) return;
+      setStatus('error');
+      setDownloadProgress(null);
+      setTranslationProgress(null);
+      setStatusMessage(err?.message || 'On-device translation failed.');
+    }
+  };
+
+  const handleRestore = () => {
+    if (abortControllerRef.current) {
+      abortControllerRef.current.abort();
+    }
+    const root = getRootNode();
+    if (root) {
+      restoreOriginalContent(root);
+    }
+    setStatus('idle');
+    setDownloadProgress(null);
+    setTranslationProgress(null);
+    setStatusMessage('Showing original text.');
+  };
+
+  const isBusy = status === 'downloading' || status === 'translating';
+  const progressLabelId = `${idPrefix}-progress-label`;
+  const sourceSelectId = `${idPrefix}-source-lang`;
+  const targetSelectId = `${idPrefix}-target-lang`;
+
+  if (variant === 'header' && !isExpanded) {
+    return (
+      <div className="relative inline-flex items-center" data-no-translate>
+        <button
+          type="button"
+          onClick={() => setIsExpanded(true)}
+          className="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-700 hover:text-amber-700 bg-gray-100 hover:bg-amber-50 border border-gray-300 rounded px-2.5 py-1.5 transition-colors"
+          aria-expanded={isExpanded}
+          title="Translate articles and teasers on-device"
+        >
+          <svg className="w-4 h-4 text-amber-700" fill="none" viewBox="0 0 24 24" strokeWidth={1.75} stroke="currentColor" aria-hidden="true">
+            <path strokeLinecap="round" strokeLinejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
+          </svg>
+          <span>Translate Page</span>
+          {status === 'translated' && (
+            <span className="inline-block w-2 h-2 rounded-full bg-amber-600" aria-hidden="true" />
+          )}
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <section
+      aria-label="On-device article translation"
+      data-no-translate
+      className={
+        variant === 'header'
+          ? 'bg-amber-50/70 border border-amber-200 rounded-md p-3 my-2 text-xs shadow-xs'
+          : 'bg-gray-50 border border-gray-200 rounded-lg p-3.5 my-4 text-sm'
+      }
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        {/* Title & Badge */}
+        <div className="flex items-center gap-2">
+          <svg className="w-5 h-5 text-amber-700 shrink-0" fill="none" viewBox="0 0 24 24" strokeWidth={1.75} stroke="currentColor" aria-hidden="true">
+            <path strokeLinecap="round" strokeLinejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
+          </svg>
+          <div>
+            <span className="font-semibold text-gray-900">On-Device Translation</span>
+            <span className="ml-2 inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-medium bg-amber-100 text-amber-900">
+              Built-in AI
+            </span>
+          </div>
+          {availability === 'downloadable' && supported && (
+            <span className="text-xs text-amber-800 bg-amber-100/70 px-2 py-0.5 rounded">
+              Model download required
+            </span>
+          )}
+          {availability === 'available' && supported && (
+            <span className="text-xs text-green-800 bg-green-100 px-2 py-0.5 rounded">
+              Ready offline
+            </span>
+          )}
+        </div>
+
+        {/* Language Controls */}
+        <div className="flex flex-wrap items-center gap-2">
+          <div className="flex items-center gap-1.5">
+            <label htmlFor={sourceSelectId} className="text-xs font-medium text-gray-600">
+              From
+            </label>
+            <select
+              id={sourceSelectId}
+              value={sourceLanguage}
+              onChange={(e) => setSourceLanguage(e.target.value)}
+              disabled={!supported || isBusy}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-500 disabled:opacity-60"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.label}
+                </option>
+              ))}
+            </select>
+          </div>
+
+          <button
+            type="button"
+            onClick={handleSwapLanguages}
+            disabled={!supported || isBusy}
+            title="Swap source and target languages"
+            aria-label="Swap source and target languages"
+            className="p-1 text-gray-600 hover:text-amber-700 hover:bg-gray-200/60 rounded disabled:opacity-50 transition-colors"
+          >
+            <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" strokeWidth={2} stroke="currentColor" aria-hidden="true">
+              <path strokeLinecap="round" strokeLinejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
+            </svg>
+          </button>
+
+          <div className="flex items-center gap-1.5">
+            <label htmlFor={targetSelectId} className="text-xs font-medium text-gray-600">
+              To
+            </label>
+            <select
+              id={targetSelectId}
+              value={targetLanguage}
+              onChange={(e) => setTargetLanguage(e.target.value)}
+              disabled={!supported || isBusy}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-500 disabled:opacity-60"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.label}
+                </option>
+              ))}
+            </select>
+          </div>
+
+          {detectorSupported && (
+            <button
+              type="button"
+              onClick={handleDetectLanguage}
+              disabled={isBusy}
+              className="text-xs font-medium text-gray-700 hover:text-amber-800 bg-white hover:bg-gray-100 border border-gray-300 rounded px-2 py-1 disabled:opacity-50 transition-colors"
+              title="Auto-detect source language using on-device LanguageDetector API"
+            >
+              Auto-detect
+            </button>
+          )}
+
+          <button
+            type="button"
+            onClick={handleTranslate}
+            disabled={!supported || availability === 'unavailable' || isBusy || sourceLanguage === targetLanguage}
+            className="bg-gray-900 hover:bg-amber-700 text-white font-semibold text-xs px-3 py-1.5 rounded disabled:opacity-50 disabled:pointer-events-none transition-colors cursor-pointer"
+          >
+            {isBusy
+              ? status === 'downloading'
+                ? 'Downloading...'
+                : 'Translating...'
+              : availability === 'downloadable'
+                ? 'Download & Translate'
+                : 'Translate'}
+          </button>
+
+          {(status === 'translated' || isBusy) && (
+            <button
+              type="button"
+              onClick={handleRestore}
+              className="text-xs font-medium text-gray-700 hover:text-gray-900 bg-white hover:bg-gray-100 border border-gray-300 rounded px-2.5 py-1.5 transition-colors"
+            >
+              {isBusy ? 'Cancel' : 'Show Original'}
+            </button>
+          )}
+
+          {variant === 'header' && (
+            <button
+              type="button"
+              onClick={() => setIsExpanded(false)}
+              aria-label="Close translation bar"
+              className="p-1 text-gray-500 hover:text-gray-800 rounded"
+            >
+              <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" strokeWidth={2} stroke="currentColor" aria-hidden="true">
+                <path strokeLinecap="round" strokeLinejoin="round" d="M6 18 18 6M6 6l12 12" />
+              </svg>
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Progress Bar for model download or active section translation */}
+      {isBusy && (
+        <div className="mt-2.5 flex items-center gap-3">
+          <progress
+            aria-labelledby={progressLabelId}
+            max={
+              status === 'downloading'
+                ? 100
+                : translationProgress && translationProgress.total > 0
+                  ? translationProgress.total
+                  : undefined
+            }
+            value={
+              status === 'downloading'
+                ? downloadProgress !== null
+                  ? downloadProgress
+                  : undefined
+                : translationProgress && translationProgress.total > 0
+                  ? translationProgress.completed
+                  : undefined
+            }
+            className="w-full h-2"
+          />
+        </div>
+      )}
+
+      {/* Polite live region & graceful fallback messaging */}
+      <div role="status" aria-live="polite" className="mt-1.5 text-xs text-gray-600 flex flex-wrap items-center justify-between gap-2">
+        <span id={progressLabelId}>
+          {supported === false
+            ? 'Client-side translation is currently unsupported in this browser (requires Chrome 138+ or Edge 148+ with Built-in AI).'
+            : availability === 'unavailable' && sourceLanguage !== targetLanguage
+              ? `Translation for ${sourceLanguage.toUpperCase()} → ${targetLanguage.toUpperCase()} is unavailable on this device.`
+              : statusMessage || (detectedInfo ? detectedInfo : 'Translate headlines, teasers, and full articles privately in your browser.')}
+        </span>
+      </div>
+    </section>
+  );
+}
