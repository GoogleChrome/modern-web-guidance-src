diff --git a/src/utils/translator.ts b/src/utils/translator.ts
new file mode 100644
index 0000000..4b09801
--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,245 @@
+export interface LanguageOption {
+  code: string;
+  label: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'ar', label: 'Arabic (العربية)' },
+  { code: 'bg', label: 'Bulgarian (Български)' },
+  { code: 'bn', label: 'Bengali (বাংলা)' },
+  { code: 'cs', label: 'Czech (Čeština)' },
+  { code: 'da', label: 'Danish (Dansk)' },
+  { code: 'de', label: 'German (Deutsch)' },
+  { code: 'el', label: 'Greek (Ελληνικά)' },
+  { code: 'en', label: 'English' },
+  { code: 'es', label: 'Spanish (Español)' },
+  { code: 'fi', label: 'Finnish (Suomi)' },
+  { code: 'fr', label: 'French (Français)' },
+  { code: 'he', label: 'Hebrew (עברית)' },
+  { code: 'hi', label: 'Hindi (हिन्दी)' },
+  { code: 'hr', label: 'Croatian (Hrvatski)' },
+  { code: 'hu', label: 'Hungarian (Magyar)' },
+  { code: 'id', label: 'Indonesian (Bahasa Indonesia)' },
+  { code: 'it', label: 'Italian (Italiano)' },
+  { code: 'ja', label: 'Japanese (日本語)' },
+  { code: 'kn', label: 'Kannada (ಕನ್ನಡ)' },
+  { code: 'ko', label: 'Korean (한국어)' },
+  { code: 'lt', label: 'Lithuanian (Lietuvių)' },
+  { code: 'mr', label: 'Marathi (मराठी)' },
+  { code: 'nl', label: 'Dutch (Nederlands)' },
+  { code: 'no', label: 'Norwegian (Norsk)' },
+  { code: 'pl', label: 'Polish (Polski)' },
+  { code: 'pt', label: 'Portuguese (Português)' },
+  { code: 'ro', label: 'Romanian (Română)' },
+  { code: 'ru', label: 'Russian (Русский)' },
+  { code: 'sk', label: 'Slovak (Slovenčina)' },
+  { code: 'sl', label: 'Slovenian (Slovenščina)' },
+  { code: 'sv', label: 'Swedish (Svenska)' },
+  { code: 'ta', label: 'Tamil (தமிழ்)' },
+  { code: 'te', label: 'Telugu (తెలుగు)' },
+  { code: 'th', label: 'Thai (ไทย)' },
+  { code: 'tr', label: 'Turkish (Türkçe)' },
+  { code: 'uk', label: 'Ukrainian (Українська)' },
+  { code: 'vi', label: 'Vietnamese (Tiếng Việt)' },
+  { code: 'zh', label: 'Chinese Simplified (简体中文)' },
+  { code: 'zh-Hant', label: 'Chinese Traditional (繁體中文)' },
+];
+
+export const RTL_LANGUAGES = new Set(['ar', 'he']);
+
+const originalTextMap = new WeakMap<Element, string>();
+
+const TRANSLATABLE_SELECTORS = [
+  '[data-translatable]',
+  '[data-translatable-scope] p',
+  '[data-translatable-scope] h1',
+  '[data-translatable-scope] h2',
+  '[data-translatable-scope] h3',
+  '[data-translatable-scope] h4',
+  '[data-translatable-scope] li',
+  '[data-translatable-scope] blockquote',
+  '[data-translatable-scope] figcaption',
+].join(', ');
+
+export function collectTranslatableElements(root: ParentNode = document): HTMLElement[] {
+  const nodes = Array.from(root.querySelectorAll<HTMLElement>(TRANSLATABLE_SELECTORS));
+  return nodes.filter((el) => {
+    if (el.closest('[data-no-translate]')) return false;
+    // Avoid translating a parent element that wraps other translatable block elements
+    const hasNestedTranslatable = nodes.some((other) => other !== el && el.contains(other));
+    if (hasNestedTranslatable) return false;
+    const text = originalTextMap.get(el) ?? el.textContent?.trim() ?? '';
+    return text.length > 0;
+  });
+}
+
+export function getOriginalText(el: HTMLElement): string {
+  let orig = originalTextMap.get(el);
+  if (orig === undefined) {
+    orig = el.textContent?.trim() ?? '';
+    originalTextMap.set(el, orig);
+  }
+  return orig;
+}
+
+export function restoreOriginalContent(root: ParentNode = document): void {
+  const elements = collectTranslatableElements(root);
+  for (const el of elements) {
+    const orig = originalTextMap.get(el);
+    if (orig !== undefined) {
+      el.textContent = orig;
+    }
+    el.removeAttribute('lang');
+    el.removeAttribute('dir');
+    el.removeAttribute('data-translated-lang');
+  }
+}
+
+export function isTranslatorSupported(): boolean {
+  return typeof self !== 'undefined' && 'Translator' in self && Boolean(self.Translator);
+}
+
+export function isLanguageDetectorSupported(): boolean {
+  return typeof self !== 'undefined' && 'LanguageDetector' in self && Boolean(self.LanguageDetector);
+}
+
+export async function checkLanguagePairAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<AvailabilityStatus> {
+  if (!isTranslatorSupported() || !self.Translator) {
+    return 'unavailable';
+  }
+  if (sourceLanguage === targetLanguage) {
+    return 'available';
+  }
+  try {
+    const options = { sourceLanguage, targetLanguage };
+    return await self.Translator.availability(options);
+  } catch {
+    return 'unavailable';
+  }
+}
+
+export async function detectSampleLanguage(
+  sampleText: string,
+  onProgress?: (loaded: number) => void
+): Promise<{ detectedLanguage: string; confidence: number } | null> {
+  if (!isLanguageDetectorSupported() || !self.LanguageDetector) {
+    return null;
+  }
+  const cleanSample = sampleText.trim();
+  if (cleanSample.length < 10) {
+    return null;
+  }
+  try {
+    const availability = await self.LanguageDetector.availability();
+    if (availability === 'unavailable') {
+      return null;
+    }
+    const detector = await self.LanguageDetector.create({
+      monitor(m) {
+        m.addEventListener('downloadprogress', (e) => {
+          onProgress?.(e.loaded);
+        });
+      },
+    });
+    const results = await detector.detect(cleanSample);
+    if (results && results.length > 0 && results[0].detectedLanguage) {
+      return {
+        detectedLanguage: results[0].detectedLanguage,
+        confidence: results[0].confidence,
+      };
+    }
+  } catch {
+    // Ignore detector errors and fall back to manual source language
+  }
+  return null;
+}
+
+export interface TranslateElementsOptions {
+  sourceLanguage: string;
+  targetLanguage: string;
+  root?: ParentNode;
+  useStreamingForLongText?: boolean;
+  signal?: AbortSignal;
+  onDownloadProgress?: (loadedFraction: number) => void;
+  onTranslationProgress?: (completed: number, total: number) => void;
+}
+
+export async function translateElements({
+  sourceLanguage,
+  targetLanguage,
+  root = document,
+  useStreamingForLongText = true,
+  signal,
+  onDownloadProgress,
+  onTranslationProgress,
+}: TranslateElementsOptions): Promise<{ translatedCount: number }> {
+  if (sourceLanguage === targetLanguage) {
+    restoreOriginalContent(root);
+    return { translatedCount: 0 };
+  }
+
+  if (!isTranslatorSupported() || !self.Translator) {
+    throw new Error('Client-side Translator API is unsupported in this browser.');
+  }
+
+  const pairOptions = { sourceLanguage, targetLanguage };
+  const availability = await self.Translator.availability(pairOptions);
+  if (availability === 'unavailable') {
+    throw new Error(
+      `Translation model for ${sourceLanguage.toUpperCase()} → ${targetLanguage.toUpperCase()} is unavailable on this device.`
+    );
+  }
+
+  const translator = await self.Translator.create({
+    ...pairOptions,
+    monitor(m) {
+      m.addEventListener('downloadprogress', (e) => {
+        onDownloadProgress?.(e.loaded);
+      });
+    },
+  });
+
+  const elements = collectTranslatableElements(root);
+  const total = elements.length;
+  let completed = 0;
+
+  onTranslationProgress?.(0, total);
+
+  for (const el of elements) {
+    if (signal?.aborted) {
+      break;
+    }
+    const sourceText = getOriginalText(el);
+    if (!sourceText) {
+      completed += 1;
+      onTranslationProgress?.(completed, total);
+      continue;
+    }
+
+    el.setAttribute('lang', targetLanguage);
+    el.setAttribute('dir', RTL_LANGUAGES.has(targetLanguage) ? 'rtl' : 'ltr');
+
+    if (useStreamingForLongText && sourceText.length > 160 && typeof translator.translateStreaming === 'function') {
+      const stream = translator.translateStreaming(sourceText);
+      let accumulated = '';
+      for await (const chunk of stream) {
+        if (signal?.aborted) break;
+        accumulated += chunk;
+        el.textContent = accumulated;
+      }
+    } else {
+      const translated = await translator.translate(sourceText);
+      if (signal?.aborted) break;
+      el.textContent = translated;
+    }
+
+    el.setAttribute('data-translated-lang', targetLanguage);
+    completed += 1;
+    onTranslationProgress?.(completed, total);
+  }
+
+  return { translatedCount: completed };
+}
