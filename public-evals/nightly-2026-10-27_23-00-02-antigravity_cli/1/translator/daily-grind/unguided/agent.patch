+      async function getBrowserTranslator(targetLang) {
+        if (targetLang === 'en') return null;
+        if (translatorCache.has(targetLang)) {
+          return translatorCache.get(targetLang);
+        }
+
+        const factory = getTranslatorFactory();
+        if (!factory) return null;
+
+        try {
+          if (typeof factory.availability === 'function') {
+            const status = await factory.availability({
+              sourceLanguage: 'en',
+              targetLanguage: targetLang
+            });
+            if (status === 'unavailable' || status === 'no') {
+              return null;
+            }
+          }
+
+          const translator = await factory.create({
+            sourceLanguage: 'en',
+            targetLanguage: targetLang
+          });
+          translatorCache.set(targetLang, translator);
+          return translator;
+        } catch (err) {
+          return null;
+        }
+      }
+
+      let activeTranslationRequest = 0;
+
+      async function translatePage(targetLang) {
+        const requestId = ++activeTranslationRequest;
+        document.documentElement.lang = targetLang;
+
+        try {
+          localStorage.setItem('daily_grind_lang', targetLang);
+        } catch (_) {}
+
+        if (targetLang === 'en') {
+          banner.classList.remove('active');
+          badge.textContent = 'On-Device';
+          translatableElements.forEach((el) => {
+            el.textContent = sourceTextMap.get(el);
+            el.classList.remove('translating');
+          });
+          return;
+        }
+
+        translatableElements.forEach((el) => el.classList.add('translating'));
+        bannerText.textContent = `Translating coffee menu & story to ${targetLang.toUpperCase()} on-device...`;
+        banner.classList.add('active');
+
+        const browserTranslator = await getBrowserTranslator(targetLang);
+        if (requestId !== activeTranslationRequest) return;
+
+        if (browserTranslator && typeof browserTranslator.translate === 'function') {
+          badge.textContent = 'On-Device AI';
+          for (const el of translatableElements) {
+            const key = el.getAttribute('data-i18n');
+            const sourceText = sourceTextMap.get(el);
+            try {
+              const translated = await browserTranslator.translate(sourceText);
+              if (requestId !== activeTranslationRequest) return;
+              el.textContent = translated || (DICTIONARY[targetLang] && DICTIONARY[targetLang][key]) || sourceText;
+            } catch (_) {
+              if (DICTIONARY[targetLang] && DICTIONARY[targetLang][key]) {
+                el.textContent = DICTIONARY[targetLang][key];
+              }
+            }
+            el.classList.remove('translating');
+          }
+        } else {
+          badge.textContent = 'On-Device';
+          const dict = DICTIONARY[targetLang] || DICTIONARY.en;
+          translatableElements.forEach((el) => {
+            const key = el.getAttribute('data-i18n');
+            if (dict[key]) {
+              el.textContent = dict[key];
+            }
+            el.classList.remove('translating');
+          });
+        }
+
+        if (requestId === activeTranslationRequest) {
+          banner.classList.remove('active');
+        }
+      }
+
+      selector.addEventListener('change', (e) => {
+        translatePage(e.target.value);
+      });
+
+      // Initialize from saved language preference if available
+      try {
+        const savedLang = localStorage.getItem('daily_grind_lang');
+        if (savedLang && DICTIONARY[savedLang]) {
+          selector.value = savedLang;
+          if (savedLang !== 'en') {
+            translatePage(savedLang);
+          }
+        }
+      } catch (_) {}
+    })();
+  </script>
 </body>
 
