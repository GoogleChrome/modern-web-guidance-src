+  <script>
+    (() => {
+      const sourceSelect = document.getElementById('source-language');
+      const targetSelect = document.getElementById('target-language');
+      const translateBtn = document.getElementById('translate-btn');
+      const resetBtn = document.getElementById('reset-translation-btn');
+      const progressBar = document.getElementById('download-progress');
+      const statusEl = document.getElementById('translation-status');
+      const translatableElements = Array.from(
+        document.querySelectorAll('[data-translatable]')
+      );
+
+      // Preserve original English text for each translatable element
+      for (const el of translatableElements) {
+        el.dataset.originalText = el.textContent.trim();
+        el.dataset.currentLang = 'en';
+      }
+
+      let currentPageLang = 'en';
+
+      function setStatus(message, state = 'info') {
+        statusEl.textContent = message;
+        statusEl.dataset.state = state;
+      }
+
+      function restoreOriginalContent() {
+        for (const el of translatableElements) {
+          el.textContent = el.dataset.originalText;
+          el.dataset.currentLang = 'en';
+          el.lang = 'en';
+        }
+        currentPageLang = 'en';
+        sourceSelect.value = 'en';
+        resetBtn.hidden = true;
+        progressBar.hidden = true;
+        setStatus('Restored original English text.', 'info');
+      }
+
+      if (!('Translator' in self)) {
+        sourceSelect.disabled = true;
+        targetSelect.disabled = true;
+        translateBtn.disabled = true;
+        setStatus(
+          'Client-side translation is currently unsupported in this browser.',
+          'unavailable'
+        );
+        return;
+      }
+
+      async function checkPairAvailability() {
+        const sourceLanguage = sourceSelect.value;
+        const targetLanguage = targetSelect.value;
+
+        if (sourceLanguage === targetLanguage) {
+          translateBtn.disabled = false;
+          setStatus('Source and target languages are identical.', 'info');
+          return 'same';
+        }
+
+        const options = {
+          sourceLanguage,
+          targetLanguage,
+        };
+
+        try {
+          const availability = await Translator.availability(options);
+
+          if (availability === 'unavailable') {
+            translateBtn.disabled = true;
+            setStatus(
+              `Translation from ${sourceLanguage.toUpperCase()} to ${targetLanguage.toUpperCase()} is unavailable on this device.`,
+              'unavailable'
+            );
+          } else if (
+            availability === 'downloadable' ||
+            availability === 'downloading'
+          ) {
+            translateBtn.disabled = false;
+            setStatus(
+              `Language pack (${sourceLanguage.toUpperCase()} → ${targetLanguage.toUpperCase()}) is ${availability}. Click "Translate on Device" to download and translate.`,
+              'info'
+            );
+          } else if (availability === 'available') {
+            translateBtn.disabled = false;
+            setStatus(
+              `On-device model ready (${sourceLanguage.toUpperCase()} → ${targetLanguage.toUpperCase()}).`,
+              'info'
+            );
+          }
+
+          return availability;
+        } catch (err) {
+          translateBtn.disabled = true;
+          setStatus(
+            'Unable to check translation model availability on this device.',
+            'error'
+          );
+          return 'unavailable';
+        }
+      }
+
+      async function runTranslation() {
+        const sourceLanguage = sourceSelect.value;
+        const targetLanguage = targetSelect.value;
+
+        if (sourceLanguage === targetLanguage) {
+          if (targetLanguage === 'en') {
+            restoreOriginalContent();
+          } else {
+            setStatus('Source and target languages are the same.', 'info');
+          }
+          return;
+        }
+
+        const options = {
+          sourceLanguage,
+          targetLanguage,
+        };
+
+        translateBtn.disabled = true;
+
+        try {
+          const availability = await Translator.availability(options);
+
+          if (availability === 'unavailable') {
+            setStatus(
+              'Translation model is unavailable on this device.',
+              'unavailable'
+            );
+            return;
+          }
+
+          if (
+            availability === 'downloadable' ||
+            availability === 'downloading'
+          ) {
+            progressBar.value = 0;
+            progressBar.hidden = false;
+            setStatus('Downloading on-device language model (0%)...', 'info');
+          } else {
+            setStatus('Translating menu descriptions and story...', 'info');
+          }
+
+          const translator = await Translator.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = Math.round(e.loaded * 100);
+                progressBar.hidden = false;
+                progressBar.value = percent;
+                setStatus(
+                  `Downloaded ${percent}% of translation model...`,
+                  'info'
+                );
+              });
+            },
+          });
+
+          progressBar.hidden = true;
+          setStatus('Translating menu descriptions and story...', 'info');
+
+          for (const el of translatableElements) {
+            // Use original English text when sourceLanguage is 'en', otherwise translate current text
+            const sourceText =
+              sourceLanguage === 'en'
+                ? el.dataset.originalText
+                : el.textContent.trim();
+            const translated = await translator.translate(sourceText);
+            el.textContent = translated;
+            el.dataset.currentLang = targetLanguage;
+            el.lang = targetLanguage;
+          }
+
+          currentPageLang = targetLanguage;
+          resetBtn.hidden = targetLanguage === 'en';
+          setStatus(
+            `Translated menu descriptions and story from ${sourceLanguage.toUpperCase()} to ${targetLanguage.toUpperCase()} on device.`,
+            'info'
+          );
+        } catch (err) {
+          progressBar.hidden = true;
+          setStatus(
+            err instanceof DOMException && err.name === 'NotAllowedError'
+              ? 'Please click "Translate on Device" to allow downloading the language pack.'
+              : 'Translation could not be completed on this device.',
+            'error'
+          );
+        } finally {
+          translateBtn.disabled = false;
+        }
+      }
+
+      translateBtn.addEventListener('click', () => {
+        runTranslation();
+      });
+
+      resetBtn.addEventListener('click', () => {
+        restoreOriginalContent();
+      });
+
+      sourceSelect.addEventListener('change', () => {
+        checkPairAvailability();
+      });
+
+      targetSelect.addEventListener('change', async () => {
+        // If page was already translated and user switches target language, align source with currentPageLang if appropriate
+        const availability = await checkPairAvailability();
+        if (availability === 'available') {
+          await runTranslation();
+        }
+      });
+
+      // Initial availability check on load
+      checkPairAvailability();
+    })();
+  </script>
 </body>
 
