+          return;
+        }
+
+        if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+          try {
+            const caps = await PublicKeyCredential.getClientCapabilities();
+            const hasSignals =
+              caps.signalAllAcceptedCredentials ||
+              caps.signalUnknownCredential ||
+              caps.signalCurrentUserDetails;
+            if (hasSignals) {
+              syncCapabilityPill.textContent = 'Authenticator Sync Active';
+              return;
+            }
+          } catch (err) {
+            console.warn('getClientCapabilities check failed:', err);
+          }
+        }
+
+        if (
+          typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function' ||
+          typeof PublicKeyCredential.signalUnknownCredential === 'function'
+        ) {
+          syncCapabilityPill.textContent = 'Signal API Supported';
+        } else {
+          syncCapabilityPill.textContent = 'Local Sync Mode';
+        }
+      }
+
+      function renderProfile() {
+        headerDisplayName.textContent = appState.user.displayName;
+        inputDisplayName.value = appState.user.displayName;
+        inputUserName.value = appState.user.name;
+        inputUserId.value = appState.user.userId;
+      }
+
+      function renderPasskeys() {
+        passkeyListEl.innerHTML = '';
+
+        if (appState.passkeys.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'empty-passkeys';
+          emptyLi.innerHTML =
+            '<strong>No passkeys registered.</strong><p style="font-size: 0.85rem; margin-top: 4px;">Register a new passkey to sign in faster and more securely.</p>';
+          passkeyListEl.appendChild(emptyLi);
+          return;
+        }
+
+        appState.passkeys.forEach((pk) => {
+          const li = document.createElement('li');
+          li.className = 'passkey-item';
+          li.dataset.credentialId = pk.id;
+
+          const infoDiv = document.createElement('div');
+          infoDiv.className = 'passkey-info';
+
+          const titleRow = document.createElement('div');
+          titleRow.className = 'passkey-title-row';
+
+          const nameSpan = document.createElement('span');
+          nameSpan.className = 'passkey-name';
+          nameSpan.textContent = pk.name;
+
+          const tagSpan = document.createElement('span');
+          tagSpan.className = 'passkey-tag';
+          tagSpan.textContent = pk.authenticatorType || 'Passkey';
+
+          titleRow.appendChild(nameSpan);
+          titleRow.appendChild(tagSpan);
+
+          const metaDiv = document.createElement('div');
+          metaDiv.className = 'passkey-meta';
+          metaDiv.innerHTML = `Credential ID: <code class="passkey-id-code">${pk.id}</code> &bull; Added: ${pk.createdAt} &bull; Last used: ${pk.lastUsedAt}`;
+
+          infoDiv.appendChild(titleRow);
+          infoDiv.appendChild(metaDiv);
+
+          // Inline rename form when editing this passkey
+          if (editingCredentialId === pk.id) {
+            const renameForm = document.createElement('form');
+            renameForm.className = 'rename-inline-form';
+
+            const input = document.createElement('input');
+            input.type = 'text';
+            input.className = 'form-input';
+            input.value = pk.name;
+            input.setAttribute('aria-label', 'New passkey name');
+            input.required = true;
+
+            const saveBtn = document.createElement('button');
+            saveBtn.type = 'submit';
+            saveBtn.className = 'btn btn-sm';
+            saveBtn.textContent = 'Save';
+
+            const cancelBtn = document.createElement('button');
+            cancelBtn.type = 'button';
+            cancelBtn.className = 'btn btn-secondary btn-sm';
+            cancelBtn.textContent = 'Cancel';
+            cancelBtn.addEventListener('click', () => {
+              editingCredentialId = null;
+              renderPasskeys();
+            });
+
+            renameForm.addEventListener('submit', async (e) => {
+              e.preventDefault();
+              const newName = input.value.trim();
+              if (!newName) return;
+              const oldName = pk.name;
+              pk.name = newName;
+              editingCredentialId = null;
+              saveState(appState);
+              renderPasskeys();
+              await syncAllAcceptedCredentials(
+                `Renamed passkey "${oldName}" to "${newName}" and synced with browser authenticator.`
+              );
+            });
+
+            renameForm.appendChild(input);
+            renameForm.appendChild(saveBtn);
+            renameForm.appendChild(cancelBtn);
+            infoDiv.appendChild(renameForm);
+          }
+
+          const controlsDiv = document.createElement('div');
+          controlsDiv.className = 'passkey-controls';
+
+          const renameBtn = document.createElement('button');
+          renameBtn.type = 'button';
+          renameBtn.className = 'btn btn-secondary btn-sm';
+          renameBtn.textContent = 'Rename';
+          renameBtn.setAttribute('aria-label', `Rename ${pk.name}`);
+          renameBtn.addEventListener('click', () => {
+            editingCredentialId = pk.id;
+            renderPasskeys();
+          });
+
+          const deleteBtn = document.createElement('button');
+          deleteBtn.type = 'button';
+          deleteBtn.className = 'btn btn-danger btn-sm';
+          deleteBtn.textContent = 'Delete';
+          deleteBtn.setAttribute('aria-label', `Delete ${pk.name}`);
+          deleteBtn.addEventListener('click', async () => {
+            const deletedId = pk.id;
+            const deletedName = pk.name;
+            appState.passkeys = appState.passkeys.filter((item) => item.id !== deletedId);
+            if (editingCredentialId === deletedId) {
+              editingCredentialId = null;
+            }
+            saveState(appState);
+            renderPasskeys();
+            await signalDeletedPasskeyToAuthenticator(deletedId, deletedName);
+          });
+
+          controlsDiv.appendChild(renameBtn);
+          controlsDiv.appendChild(deleteBtn);
+
+          li.appendChild(infoDiv);
+          li.appendChild(controlsDiv);
+          passkeyListEl.appendChild(li);
+        });
+      }
+
+      // Handle profile updates and signalCurrentUserDetails
+      profileForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const newDisplayName = inputDisplayName.value.trim();
+        const newUserName = inputUserName.value.trim();
+        if (!newDisplayName || !newUserName) return;
+
+        appState.user.displayName = newDisplayName;
+        appState.user.name = newUserName;
+        saveState(appState);
+        renderProfile();
+        await signalUserDetailsToAuthenticator();
+      });
+
+      // Handle registering a new passkey via WebAuthn (with graceful fallback)
+      registerBtn.addEventListener('click', async () => {
+        const rpId = getRpId();
+        let newCredId = null;
+        let authenticatorLabel = 'Platform Authenticator';
+
+        if (
+          window.PublicKeyCredential &&
+          navigator.credentials &&
+          typeof navigator.credentials.create === 'function'
+        ) {
+          try {
+            const challenge = new Uint8Array(32);
+            window.crypto.getRandomValues(challenge);
+
+            const credential = await navigator.credentials.create({
+              publicKey: {
+                challenge: challenge,
+                rp: {
+                  name: 'The Daily Grind',
+                  id: rpId
+                },
+                user: {
+                  id: base64UrlToBuffer(appState.user.userId),
+                  name: appState.user.name,
+                  displayName: appState.user.displayName
+                },
+                pubKeyCredParams: [
+                  { type: 'public-key', alg: -7 },
+                  { type: 'public-key', alg: -257 }
+                ],
+                authenticatorSelection: {
+                  residentKey: 'required',
+                  userVerification: 'preferred'
+                },
+                excludeCredentials: appState.passkeys.map((pk) => ({
+                  id: base64UrlToBuffer(pk.id),
+                  type: 'public-key'
+                }))
+              }
+            });
+
+            if (credential && credential.rawId) {
+              newCredId = bufferToBase64Url(credential.rawId);
+              if (credential.authenticatorAttachment === 'cross-platform') {
+                authenticatorLabel = 'Roaming Security Key';
+              }
+            }
+          } catch (err) {
+            console.warn('WebAuthn navigator.credentials.create fallback triggered:', err);
+          }
+        }
+
+        if (!newCredId) {
+          const randomBytes = new Uint8Array(24);
+          window.crypto.getRandomValues(randomBytes);
+          newCredId = bufferToBase64Url(randomBytes);
+        }
+
+        const today = new Date().toISOString().slice(0, 10);
+        const passkeyNumber = appState.passkeys.length + 1;
+        const newPasskey = {
+          id: newCredId,
+          name: `Passkey #${passkeyNumber} (${today})`,
+          authenticatorType: authenticatorLabel,
+          createdAt: today,
+          lastUsedAt: 'Just now',
+          BackedUp: true
+        };
+
+        appState.passkeys.push(newPasskey);
+        saveState(appState);
+        renderPasskeys();
+        await syncAllAcceptedCredentials(
+          `Registered "${newPasskey.name}" and synchronized accepted credentials with browser authenticator.`
+        );
+      });
+
+      // Manual Sync Button
+      syncBtn.addEventListener('click', async () => {
+        await signalUserDetailsToAuthenticator();
+        await syncAllAcceptedCredentials(
+          `Synchronized ${appState.passkeys.length} accepted passkey(s) and user details with browser authenticator.`
+        );
+      });
+
+      // Initialize UI and perform initial authenticator synchronization
+      renderProfile();
+      renderPasskeys();
+      detectCapabilities();
+      syncAllAcceptedCredentials();
+    })();
+  </script>
 </body>
 
 </html>
