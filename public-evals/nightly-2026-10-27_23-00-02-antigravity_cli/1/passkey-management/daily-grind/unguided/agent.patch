+
+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_account_state_v1';
+
+      function bufferToBase64Url(buffer) {
+        const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary)
+          .replace(/\+/g, '-')
+          .replace(/\//g, '_')
+          .replace(/=+$/, '');
+      }
+
+      function base64UrlToBuffer(base64url) {
+        const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+        const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+        const rawData = atob(base64);
+        const outputArray = new Uint8Array(rawData.length);
+        for (let i = 0; i < rawData.length; ++i) {
+          outputArray[i] = rawData.charCodeAt(i);
+        }
+        return outputArray;
+      }
+
+      function getRpId() {
+        return window.location.hostname || 'localhost';
+      }
+
+      const DEFAULT_STATE = {
+        user: {
+          userId: 'YWxleC1yaXZlcmEtZGdjLTIwMjY',
+          name: 'alex.rivera@dailygrind.coffee',
+          displayName: 'Alex Rivera'
+        },
+        passkeys: [
+          {
+            id: 'cGFzc2tleS1tYWNib29rLXByby10b3VjaGlkLTAx',
+            name: 'MacBook Pro Touch ID',
+            authenticatorType: 'Platform / iCloud Keychain',
+            createdAt: '2026-08-14',
+            lastUsedAt: '2026-10-27',
+            BackedUp: true
+          },
+          {
+            id: 'cGFzc2tleS1pcGhvbmUtMTYtcHJvLWZhY2VpZC0wMg',
+            name: 'iPhone 16 Pro Face ID',
+            authenticatorType: 'Synced Passkey',
+            createdAt: '2026-09-03',
+            lastUsedAt: '2026-10-25',
+            BackedUp: true
+          },
+          {
+            id: 'cGFzc2tleS15dWJpa2V5LTVjLW5mYy1iYWNrdXAtMDM',
+            name: 'YubiKey 5C NFC Backup',
+            authenticatorType: 'Roaming Security Key',
+            createdAt: '2026-06-19',
+            lastUsedAt: '2026-09-12',
+            BackedUp: false
+          }
+        ]
+      };
+
+      function loadState() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          if (raw) {
+            const parsed = JSON.parse(raw);
+            if (parsed && parsed.user && Array.isArray(parsed.passkeys)) {
+              return parsed;
+            }
+          }
+        } catch (err) {
+          console.warn('Could not read saved passkey state:', err);
+        }
+        return JSON.parse(JSON.stringify(DEFAULT_STATE));
+      }
+
+      function saveState(state) {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
+        } catch (err) {
+          console.warn('Could not persist passkey state:', err);
+        }
+      }
+
+      let appState = loadState();
+      let editingCredentialId = null;
+
+      const passkeyListEl = document.getElementById('passkey-list');
+      const syncStatusBox = document.getElementById('sync-status');
+      const syncStatusText = document.getElementById('sync-status-text');
+      const syncCapabilityPill = document.getElementById('sync-capability-pill');
+      const headerDisplayName = document.getElementById('header-display-name');
+      const inputDisplayName = document.getElementById('user-display-name');
+      const inputUserName = document.getElementById('user-name');
+      const inputUserId = document.getElementById('user-id-display');
+      const profileForm = document.getElementById('profile-form');
+      const registerBtn = document.getElementById('register-passkey-btn');
+      const syncBtn = document.getElementById('sync-authenticator-btn');
+
+      function updateStatusMessage(message, variant = 'info') {
+        syncStatusText.textContent = message;
+        syncStatusBox.className = 'sync-status-box';
+        if (variant === 'success') {
+          syncStatusBox.classList.add('success');
+        } else if (variant === 'warning') {
+          syncStatusBox.classList.add('warning');
+        }
+      }
+
+      async function syncAllAcceptedCredentials(reasonText) {
+        const rpId = getRpId();
+        const allAcceptedCredentialIds = appState.passkeys.map((pk) => pk.id);
+
+        if (
+          typeof window.PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalAllAcceptedCredentials({
+              rpId: rpId,
+              userId: appState.user.userId,
+              allAcceptedCredentialIds: allAcceptedCredentialIds
+            });
+            updateStatusMessage(
+              reasonText ||
+                `Synchronized ${allAcceptedCredentialIds.length} accepted passkey(s) with browser authenticator (rpId: ${rpId}).`,
+              'success'
+            );
+            return true;
+          } catch (err) {
+            console.warn('signalAllAcceptedCredentials error:', err);
+            updateStatusMessage(
+              `${reasonText || 'Updated passkeys locally.'} (Authenticator signal rejected: ${err.message})`,
+              'warning'
+            );
+            return false;
+          }
+        } else {
+          updateStatusMessage(
+            `${reasonText || 'Passkeys updated.'} (Browser does not support PublicKeyCredential.signalAllAcceptedCredentials; state saved locally.)`,
+            'info'
+          );
+          return false;
+        }
+      }
+
+      async function signalDeletedPasskeyToAuthenticator(deletedCredentialId, deletedName) {
+        const rpId = getRpId();
+        let signaledUnknown = false;
+
+        if (
+          typeof window.PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalUnknownCredential === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: rpId,
+              credentialId: deletedCredentialId
+            });
+            signaledUnknown = true;
+          } catch (err) {
+            console.warn('signalUnknownCredential error:', err);
+          }
+        }
+
+        const syncedAccepted = await syncAllAcceptedCredentials(
+          `Deleted "${deletedName}" and notified browser authenticator to remove credential ${deletedCredentialId.slice(0, 12)}...`
+        );
+
+        if (signaledUnknown && !syncedAccepted) {
+          updateStatusMessage(
+            `Deleted "${deletedName}" and signaled unknown credential to browser authenticator.`,
+            'success'
+          );
+        }
+      }
+
+      async function signalUserDetailsToAuthenticator() {
+        const rpId = getRpId();
+        if (
+          typeof window.PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+        ) {
+          try {
+            await PublicKeyCredential.signalCurrentUserDetails({
+              rpId: rpId,
+              userId: appState.user.userId,
+              name: appState.user.name,
+              displayName: appState.user.displayName
+            });
+            updateStatusMessage(
+              `Saved profile & synced user details (${appState.user.name}) with browser authenticator.`,
+              'success'
+            );
+            return;
+          } catch (err) {
+            console.warn('signalCurrentUserDetails error:', err);
+          }
+        }
+        updateStatusMessage(
+          `Saved profile details for ${appState.user.displayName} (${appState.user.name}).`,
+          'success'
+        );
+      }
+
+      async function detectCapabilities() {
+        if (typeof window.PublicKeyCredential === 'undefined') {
+          syncCapabilityPill.textContent = 'WebAuthn Unavailable';
+          return;
+        }
+
+        if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+          try {
+            const caps = await PublicKeyCredential.getClientCapabilities();
+            const hasSignals =
+              caps.signalAllAcceptedCredentials ||
+              caps.signalUnknownCredential ||
+              caps.signalCurrentUserDetails;
+            if (hasSignals) {
+              syncCapabilityPill.textContent = 'Authenticator Sync Active';
+              return;
+            }
+          } catch (err) {
+            console.warn('getClientCapabilities check failed:', err);
+          }
+        }
+
+        if (
+          typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function' ||
+          typeof PublicKeyCredential.signalUnknownCredential === 'function'
+        ) {
+          syncCapabilityPill.textContent = 'Signal API Supported';
+        } else {
+          syncCapabilityPill.textContent = 'Local Sync Mode';
+        }
+      }
+
+      function renderProfile() {
+        headerDisplayName.textContent = appState.user.displayName;
+        inputDisplayName.value = appState.user.displayName;
+        inputUserName.value = appState.user.name;
+        inputUserId.value = appState.user.userId;
+      }
+
+      function renderPasskeys() {
+        passkeyListEl.innerHTML = '';
+
+        if (appState.passkeys.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'empty-passkeys';
+          emptyLi.innerHTML =
+            '<strong>No passkeys registered.</strong><p style="font-size: 0.85rem; margin-top: 4px;">Register a new passkey to sign in faster and more securely.</p>';
+          passkeyListEl.appendChild(emptyLi);
+          return;
+        }
+
+        appState.passkeys.forEach((pk) => {
+          const li = document.createElement('li');
+          li.className = 'passkey-item';
+          li.dataset.credentialId = pk.id;
+
+          const infoDiv = document.createElement('div');
+          infoDiv.className = 'passkey-info';
+
+          const titleRow = document.createElement('div');
+          titleRow.className = 'passkey-title-row';
+
+          const nameSpan = document.createElement('span');
+          nameSpan.className = 'passkey-name';
+          nameSpan.textContent = pk.name;
+
+          const tagSpan = document.createElement('span');
+          tagSpan.className = 'passkey-tag';
+          tagSpan.textContent = pk.authenticatorType || 'Passkey';
+
+          titleRow.appendChild(nameSpan);
+          titleRow.appendChild(tagSpan);
+
+          const metaDiv = document.createElement('div');
+          metaDiv.className = 'passkey-meta';
+          metaDiv.innerHTML = `Credential ID: <code class="passkey-id-code">${pk.id}</code> &bull; Added: ${pk.createdAt} &bull; Last used: ${pk.lastUsedAt}`;
+
+          infoDiv.appendChild(titleRow);
+          infoDiv.appendChild(metaDiv);
+
+          if (editingCredentialId === pk.id) {
+            const renameForm = document.createElement('form');
+            renameForm.className = 'rename-inline-form';
+
+            const input = document.createElement('input');
+            input.type = 'text';
+            input.className = 'form-input';
+            input.value = pk.name;
+            input.setAttribute('aria-label', 'New passkey name');
+            input.required = true;
+
+            const saveBtn = document.createElement('button');
+            saveBtn.type = 'submit';
+            saveBtn.className = 'btn btn-sm';
+            saveBtn.textContent = 'Save';
+
