+
+export const db = {
+  async findCredentialsByUserId(userId) {
+    return Array.from(credentials.values()).filter(c => c.passkeyUserId === userId);
+  },
+  async findCredentialById(id) {
+    return credentials.get(id) || null;
+  },
+  async saveCredential(cred) {
+    credentials.set(cred.id, cred);
+    return cred;
+  },
+  async deleteCredential(id) {
+    return credentials.delete(id);
+  },
+  async findUserById(userId) {
+    return users.get(userId) || null;
+  },
+  async updateUser(userId, { name, displayName }) {
+    const user = users.get(userId);
+    if (!user) return null;
+    if (name) user.name = name;
+    if (displayName) user.displayName = displayName;
+    users.set(userId, user);
+    return user;
+  }
+};
+
+export function registerPasskeyRoutes(router, checkUserAuthenticated) {
+  // 1. List all user credentials
+  router.get('/api/credentials', checkUserAuthenticated, async (req, res) => {
+    const list = await db.findCredentialsByUserId(req.user.id);
+    return res.json(list);
+  });
+
+  // 2. Update credential names
+  router.put('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+    const { id } = req.params;
+    const { name } = req.body;
+    const cred = await db.findCredentialById(id);
+    if (!cred || cred.passkeyUserId !== req.user.id) {
+      return res.status(404).json({ error: 'Credential not found.' });
+    }
+    cred.name = name;
+    await db.saveCredential(cred);
+    return res.json(cred);
+  });
+
+  // 3. Delete credentials
+  router.delete('/api/credential/:id', checkUserAuthenticated, async (req, res) => {
+    const { id } = req.params;
+    const cred = await db.findCredentialById(id);
+    if (!cred || cred.passkeyUserId !== req.user.id) {
+      return res.status(404).json({ error: 'Credential not found.' });
+    }
+    await db.deleteCredential(id);
+    return res.json({ success: true });
+  });
+
+  // 4. Update user account details
+  router.put('/api/user', checkUserAuthenticated, async (req, res) => {
+    const { name, displayName } = req.body;
+    const updatedUser = await db.updateUser(req.user.id, { name, displayName });
+    return res.json(updatedUser);
+  });
+
+  // 5. Generate Registration Options
+  router.post('/api/register/options', checkUserAuthenticated, async (req, res) => {
+    const isPromotionFlow = Boolean(req.body?.promotion);
+    const user = await db.findUserById(req.user.id);
+    const userExistingCredentials = await db.findCredentialsByUserId(req.user.id);
+
+    const options = await generateRegistrationOptions({
+      rpName: RP_NAME,
+      rpID: RP_ID,
+      userID: Buffer.from(user.id, 'base64url'),
+      userName: user.name,
+      userDisplayName: user.displayName,
+      excludeCredentials: userExistingCredentials.map(cred => ({
+        id: cred.id,
+        type: 'public-key',
+        transports: cred.transports
+      })),
+      authenticatorSelection: {
+        residentKey: 'required',
+        requireResidentKey: true,
+        userVerification: 'preferred',
+        ...(isPromotionFlow && { authenticatorAttachment: 'platform' })
+      }
+    });
+
+    user.currentChallenge = options.challenge;
+    return res.json(options);
+  });
+
+  // 6. Verify Registration Response
+  router.post('/api/register/verify', checkUserAuthenticated, async (req, res) => {
+    const user = await db.findUserById(req.user.id);
+    const expectedChallenge = user?.currentChallenge;
+    if (!expectedChallenge) {
+      return res.status(400).json({ error: 'Missing challenge in session.' });
+    }
+
+    const verification = await verifyRegistrationResponse({
+      response: req.body,
+      expectedChallenge,
+      expectedOrigin: EXPECTED_ORIGIN,
+      expectedRPID: RP_ID,
+      requireUserVerification: false
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return res.status(400).json({ error: 'Verification failed.' });
+    }
+
+    const { registrationInfo } = verification;
+    const { aaguid, credential, credentialDeviceType, credentialBackedUp } = registrationInfo;
+
+    let name = 'Unknown passkey provider';
+    let providerIcon = undefined;
+
+    if (aaguid === '00000000-0000-0000-0000-000000000000') {
+      name = 'Unknown passkey provider';
+      providerIcon = undefined;
+    } else {
+      const provider = aaguids[aaguid];
+      name = provider?.name || 'Unknown passkey provider';
+      providerIcon = provider?.icon_light;
+    }
+
+    const storedCredential = {
+      id: credential.id,
+      passkeyUserId: user.id,
+      credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      credentialType: 'public-key',
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+      providerIcon,
+      name,
+      transports: credential.transports || ['internal'],
+      registeredAt: Date.now(),
+      counter: credential.counter
+    };
+
+    await db.saveCredential(storedCredential);
+    user.currentChallenge = null;
+    return res.json(storedCredential);
+  });
+}
