+// Client-side Passkey Management & Signal API Synchronization ES module
+import 'webauthn-polyfills';
+import aaguids from './aaguids.json' with { type: 'json' };
+import {
+  RP_ID,
+  getUserFetch,
+  updateUserFetch,
+  listFetch,
+  renameCredentialFetch,
+  deleteFetch,
+  optionsFetch,
+  registerVerifyFetch,
+  resolveAaguidMetadata
+} from './api.js';
+
+const rpId = RP_ID;
+// Base64URL-encoded User ID string
+let base64UrlUserId = 'M2YPl-KGnA8';
+
+const FALLBACK_KEY_ICON =
+  'data:image/svg+xml;utf8,' +
+  encodeURIComponent(
+    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#4e342e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>'
+  );
+
+function formatEpochDate(epochMs) {
+  if (!epochMs) return 'Never used';
+  try {
+    return new Intl.DateTimeFormat('en-US', {
+      year: 'numeric',
+      month: 'short',
+      day: 'numeric'
+    }).format(new Date(epochMs));
+  } catch {
+    return new Date(epochMs).toLocaleDateString();
+  }
+}
+
+function showStatusBanner(message, type = 'info') {
+  const banner = document.getElementById('passkey-status-banner');
+  if (!banner) return;
+  banner.textContent = message;
+  banner.className = `status-banner status-${type}`;
+  banner.hidden = false;
+}
+
+// Synchronize accepted credential IDs with the browser's passkey provider via the Signal API
+export async function syncAcceptedCredentials(currentCredentialsList) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) return;
+  try {
+    const credentialIds = currentCredentialsList.map(c => c.id); // Array of Base64URL credential ID strings
+
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId, // RP ID must match the one defined on the server
+      userId: base64UrlUserId, // User ID Base64URL-encoded string
+      allAcceptedCredentialIds: credentialIds
+    });
+  } catch (e) {
+    console.error('SignalAllAcceptedCredentials sync failure:', e);
+  }
+}
+
+// Check client capabilities to conditionally display or disable the "Create passkey" button
+export async function gateCreatePasskeyUI() {
+  const createBtn = document.getElementById('create-passkey-btn');
+  const fallbackNotice = document.getElementById('mfa-fallback-notice');
+  if (!createBtn) return;
+
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    createBtn.hidden = true;
+    createBtn.disabled = true;
+    if (fallbackNotice) fallbackNotice.hidden = false;
+    return;
+  }
+
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+      createBtn.hidden = true;
+      createBtn.disabled = true;
+      if (fallbackNotice) fallbackNotice.hidden = false;
+    } else {
+      createBtn.hidden = false;
+      createBtn.disabled = false;
+      if (fallbackNotice) fallbackNotice.hidden = true;
+    }
+  } catch (e) {
+    console.warn('Error checking PublicKeyCredential client capabilities:', e);
+  }
+}
+
+// Render user profile form and header summary
+function renderUserProfile(user) {
+  if (!user) return;
+  base64UrlUserId = user.id || base64UrlUserId;
+
+  const displayEl = document.getElementById('account-user-display-name');
+  const emailEl = document.getElementById('account-user-email');
+  const nameInput = document.getElementById('user-name-input');
+  const displayNameInput = document.getElementById('user-display-name-input');
+
+  if (displayEl) displayEl.textContent = user.displayName;
+  if (emailEl) emailEl.textContent = user.name;
+  if (nameInput) nameInput.value = user.name;
+  if (displayNameInput) displayNameInput.value = user.displayName;
+}
+
+// Render registered passkeys list
+export function renderUI(list) {
+  const listContainer = document.getElementById('passkey-list');
+  const countBadge = document.getElementById('passkey-count-badge');
+  if (!listContainer) return;
+
+  if (countBadge) {
+    countBadge.textContent = `${list.length} ${list.length === 1 ? 'passkey' : 'passkeys'}`;
+  }
+
+  listContainer.innerHTML = '';
+
+  if (!list || list.length === 0) {
+    const emptyState = document.createElement('div');
+    emptyState.className = 'passkey-empty-state';
+    emptyState.innerHTML = `
+      <p class="empty-title">No passkeys found</p>
+      <p class="empty-subtitle">Add a passkey for faster, phishing-resistant sign-in to your Daily Grind account.</p>
+    `;
+    listContainer.appendChild(emptyState);
+    return;
+  }
+
+  for (const cred of list) {
+    const isZeroAaguid = !cred.aaguid || cred.aaguid === '00000000-0000-0000-0000-000000000000';
+    const providerEntry = !isZeroAaguid ? aaguids[cred.aaguid] : undefined;
+    const providerDefaultName = isZeroAaguid
+      ? 'Unknown passkey provider'
+      : providerEntry?.name || 'Unknown passkey provider';
+    const displayName = cred.name || providerDefaultName;
+    const iconSrc =
+      cred.providerIcon ||
+      (!isZeroAaguid ? providerEntry?.icon_light : undefined) ||
+      FALLBACK_KEY_ICON;
+
+    const registeredDateStr = formatEpochDate(cred.registeredAt);
+    const lastUsedDateStr = cred.lastUsedAt ? formatEpochDate(cred.lastUsedAt) : 'Never used';
+    const syncBadgeText =
+      cred.credentialDeviceType === 'multiDevice' && cred.credentialBackedUp
+        ? 'Synced'
+        : 'Device-bound';
+
+    const row = document.createElement('div');
+    row.className = 'passkey-item';
+    row.dataset.credentialId = cred.id;
+
+    row.innerHTML = `
+      <div class="passkey-item-main">
+        <div class="passkey-icon-wrapper">
+          <img
+            src="${iconSrc}"
+            alt="${providerDefaultName} icon"
+            class="passkey-provider-icon"
+            width="36"
+            height="36"
+          />
+        </div>
+        <div class="passkey-details">
+          <div class="passkey-title-row">
+            <span class="passkey-name">${escapeHtml(displayName)}</span>
+            <span class="passkey-badge">${syncBadgeText}</span>
+          </div>
+          <div class="passkey-meta">
+            <span class="passkey-provider-label">Provider: <strong>${escapeHtml(providerDefaultName)}</strong></span>
+            <span class="meta-sep" aria-hidden="true">&bull;</span>
+            <span class="passkey-registered-date">Created: <time datetime="${new Date(cred.registeredAt).toISOString()}">${registeredDateStr}</time></span>
+            <span class="meta-sep" aria-hidden="true">&bull;</span>
+            <span class="passkey-last-used-date">Last used: ${
+              cred.lastUsedAt
+                ? `<time datetime="${new Date(cred.lastUsedAt).toISOString()}">${lastUsedDateStr}</time>`
+                : 'Never'
+            }</span>
+          </div>
+          <form class="passkey-rename-form" hidden>
+            <label class="sr-only" for="rename-input-${escapeHtml(cred.id)}">Passkey nickname</label>
+            <input
+              id="rename-input-${escapeHtml(cred.id)}"
+              type="text"
+              class="passkey-rename-input"
+              value="${escapeHtml(displayName)}"
+              maxlength="64"
+              required
+            />
+            <button type="submit" class="btn btn-sm btn-primary">Save</button>
+            <button type="button" class="btn btn-sm btn-outline cancel-rename-btn">Cancel</button>
+          </form>
+        </div>
+      </div>
+      <div class="passkey-actions">
+        <button
+          type="button"
+          class="btn btn-sm btn-outline rename-passkey-btn"
+          data-id="${escapeHtml(cred.id)}"
+          aria-label="Rename passkey ${escapeHtml(displayName)}"
+        >
+          Rename
+        </button>
+        <button
+          type="button"
+          class="btn btn-sm btn-danger delete-passkey-btn"
+          data-id="${escapeHtml(cred.id)}"
+          aria-label="Delete passkey ${escapeHtml(displayName)}"
+        >
+          Delete
+        </button>
+      </div>
+    `;
+
+    const renameBtn = row.querySelector('.rename-passkey-btn');
+    const deleteBtn = row.querySelector('.delete-passkey-btn');
+    const renameForm = row.querySelector('.passkey-rename-form');
+    const renameInput = row.querySelector('.passkey-rename-input');
+    const cancelRenameBtn = row.querySelector('.cancel-rename-btn');
+
+    renameBtn.addEventListener('click', () => {
+      renameForm.hidden = false;
+      renameBtn.hidden = true;
+      renameInput.focus();
+      renameInput.select();
+    });
+
+    cancelRenameBtn.addEventListener('click', () => {
+      renameForm.hidden = true;
+      renameBtn.hidden = false;
+      renameInput.value = displayName;
+    });
+
+    renameForm.addEventListener('submit', async e => {
+      e.preventDefault();
+      const newName = renameInput.value.trim();
+      if (!newName) return;
+      await performCredentialRename(cred.id, newName);
+    });
+
+    deleteBtn.addEventListener('click', async () => {
+      await performDelete(cred.id);
+    });
+
+    listContainer.appendChild(row);
+  }
+}
+
+function escapeHtml(str) {
+  return String(str ?? '')
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+}
+
+// Initial load: fetch user + credentials, render UI, and sync accepted credentials via Signal API
+export async function loadManagementPanel() {
+  await gateCreatePasskeyUI();
+
+  const userRes = await getUserFetch();
+  const user = await userRes.json();
+  renderUserProfile(user);
+
+  const response = await listFetch();
+  const list = await response.json();
+
+  renderUI(list);
+  // Sync accepted credentials on initial load
+  await syncAcceptedCredentials(list);
+}
+
+// Delete a passkey and synchronize the remaining accepted credential IDs via Signal API
+export async function performDelete(credentialId) {
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+
+    renderUI(updatedList);
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(updatedList);
+    showStatusBanner(
+      'Passkey removed from your account and synchronized with your browser authenticator.',
+      'success'
+    );
+  } else {
+    showStatusBanner('Could not delete passkey. Please try again.', 'error');
+  }
+}
+
+// Renaming a passkey's nickname updates the server record only (does NOT invoke signalCurrentUserDetails)
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const response = await renameCredentialFetch(credentialId, { name: newCredentialName });
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    renderUI(await updatedResponse.json());
+    showStatusBanner(`Passkey renamed to "${newCredentialName}".`, 'success');
+  } else {
+    showStatusBanner('Could not rename passkey. Please try again.', 'error');
+  }
+}
+
+// Renaming the user's account username or displayName triggers PublicKeyCredential.signalCurrentUserDetails
+export async function performUserRename(rpIdParam, userId, updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({
+    name: updatedName,
+    displayName: updatedDisplayName
+  });
+  if (response.ok) {
+    const updatedUser = await response.json();
+    renderUserProfile(updatedUser);
+
+    if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId: rpIdParam, // RP ID must match the one defined on the server
+          userId, // Base64URL-encoded user ID
+          name: updatedName, // Updated username
+          displayName: updatedDisplayName // Updated display name
+        });
+      } catch (e) {
+        console.error('SignalCurrentUserDetails sync failure:', e);
+      }
+    }
+    showStatusBanner(
+      'Account profile updated and synchronized with your passkey authenticator.',
+      'success'
+    );
+  } else {
+    showStatusBanner('Failed to update account profile.', 'error');
+  }
+}
+
+// Register a new passkey (supports both platform authenticators and security keys by omitting authenticatorAttachment)
+export async function registerPasskey(isPromotion = false) {
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    showStatusBanner('Passkeys are not supported in this browser.', 'error');
+    return;
+  }
+
+  const capabilities = await PublicKeyCredential.getClientCapabilities();
+  if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+    const fallbackNotice = document.getElementById('mfa-fallback-notice');
+    if (fallbackNotice) fallbackNotice.hidden = false;
+    return;
+  }
+
+  const creationOptionsJSON = await optionsFetch({ promotion: isPromotion });
+  const publicKey =
+    PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      console.log('A passkey already exists for this account.');
+      showStatusBanner('A passkey already exists on this authenticator for your account.', 'error');
+    } else if (err.name === 'SecurityError') {
+      console.error('Configuration RP ID or Secure Context error.');
+      showStatusBanner('Configuration RP ID or Secure Context error.', 'error');
+    } else if (err.name === 'NotAllowedError') {
+      console.log('User cancelled the passkey dialog.');
+      showStatusBanner('Passkey creation was cancelled.', 'info');
+    } else if (err.name === 'AbortError') {
+      console.log('The creation operation has been aborted.');
+    }
+    return; // Safe API exit, do not signal unknown for standard WebAuthn cancels
+  }
+
+  if (!credential) return;
+
+  // Server Verification phase (Segregated Try/Catch for Signal API)
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok) {
+      if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId,
+          credentialId: encodedResponse.id
+        });
+      }
+      showStatusBanner('Server could not verify the new passkey.', 'error');
+      return;
+    }
+
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+    renderUI(updatedList);
+    await syncAcceptedCredentials(updatedList);
+    showStatusBanner('New passkey registered and synced with your account.', 'success');
+  } catch (serverErr) {
+    console.error('Server verification network failure:', serverErr);
+    if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId,
+        credentialId: encodedResponse.id
+      });
+    }
+    showStatusBanner('Network error while verifying passkey.', 'error');
+  }
+}
+
+function bindEvents() {
+  const userProfileForm = document.getElementById('user-profile-form');
+  if (userProfileForm) {
+    userProfileForm.addEventListener('submit', async e => {
+      e.preventDefault();
+      const nameInput = document.getElementById('user-name-input');
+      const displayNameInput = document.getElementById('user-display-name-input');
+      const updatedName = nameInput ? nameInput.value.trim() : '';
+      const updatedDisplayName = displayNameInput ? displayNameInput.value.trim() : '';
+      if (!updatedName || !updatedDisplayName) return;
+      await performUserRename(rpId, base64UrlUserId, updatedName, updatedDisplayName);
+    });
+  }
+
+  const createPasskeyBtn = document.getElementById('create-passkey-btn');
+  if (createPasskeyBtn) {
+    createPasskeyBtn.addEventListener('click', async () => {
+      await registerPasskey(false);
+    });
+  }
+}
+
+window.addEventListener('DOMContentLoaded', () => {
+  bindEvents();
+  loadManagementPanel();
+});
