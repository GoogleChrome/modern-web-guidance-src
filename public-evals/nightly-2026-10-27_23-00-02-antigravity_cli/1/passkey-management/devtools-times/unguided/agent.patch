diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
new file mode 100644
index 0000000..bf400c0
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,160 @@
+import type { APIRoute } from 'astro';
+
+export interface PasskeyItem {
+  id: string;
+  name: string;
+  device: string;
+  createdAt: string;
+  lastUsedAt: string;
+  synced: boolean;
+}
+
+export interface UserProfile {
+  userId: string;
+  username: string;
+  displayName: string;
+  email: string;
+}
+
+const DEFAULT_USER: UserProfile = {
+  userId: 'dXNlci1kZXZ0b29scy1yZWFkZXItMDE',
+  username: 'alex.rivera@devtoolstimes.dev',
+  displayName: 'Alex Rivera',
+  email: 'alex.rivera@devtoolstimes.dev',
+};
+
+const DEFAULT_PASSKEYS: PasskeyItem[] = [
+  {
+    id: 'cred_macbook_pro_touchid_9f8a7b6c5d4e',
+    name: 'MacBook Pro Touch ID',
+    device: 'macOS · Chrome Profile',
+    createdAt: '2025-02-14',
+    lastUsedAt: 'Today, 09:41 AM',
+    synced: true,
+  },
+  {
+    id: 'cred_pixel_9_pro_biometrics_3e2d1c0b9a8f',
+    name: 'Pixel 9 Pro (Google Password Manager)',
+    device: 'Android 15 · Synced Passkey',
+    createdAt: '2025-05-03',
+    lastUsedAt: 'Oct 24, 2025',
+    synced: true,
+  },
+  {
+    id: 'cred_yubikey_5c_nfc_backup_7a6b5c4d3e2f',
+    name: 'YubiKey 5C NFC (Backup)',
+    device: 'Hardware Security Key',
+    createdAt: '2024-11-19',
+    lastUsedAt: 'Aug 12, 2025',
+    synced: false,
+  },
+];
+
+async function getState(session: any) {
+  let user: UserProfile | undefined = await session?.get('accountUser');
+  if (!user) {
+    user = { ...DEFAULT_USER };
+    await session?.set('accountUser', user);
+  }
+
+  let passkeys: PasskeyItem[] | undefined = await session?.get('accountPasskeys');
+  if (!passkeys) {
+    passkeys = DEFAULT_PASSKEYS.map((k) => ({ ...k }));
+    await session?.set('accountPasskeys', passkeys);
+  }
+
+  return { user, passkeys };
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const { user, passkeys } = await getState(session);
+  return new Response(
+    JSON.stringify({
+      user,
+      passkeys,
+      allAcceptedCredentialIds: passkeys.map((k) => k.id),
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const body = await request.json();
+  const { action } = body;
+  let { user, passkeys } = await getState(session);
+
+  if (action === 'rename-passkey') {
+    const { credentialId, name, displayName } = body;
+    const newName = (name ?? displayName ?? '').trim();
+    if (!credentialId || !newName) {
+      return new Response(JSON.stringify({ error: 'Credential ID and display name are required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+    passkeys = passkeys.map((pk) => (pk.id === credentialId ? { ...pk, name: newName } : pk));
+    await session?.set('accountPasskeys', passkeys);
+  } else if (action === 'update-user-details') {
+    const newDisplayName = (body.displayName ?? '').trim();
+    const newUsername = (body.username ?? user.username).trim();
+    if (!newDisplayName) {
+      return new Response(JSON.stringify({ error: 'Display name is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+    user = {
+      ...user,
+      displayName: newDisplayName,
+      username: newUsername || user.username,
+    };
+    await session?.set('accountUser', user);
+  } else if (action === 'remove-passkey') {
+    const { credentialId } = body;
+    if (!credentialId) {
+      return new Response(JSON.stringify({ error: 'Credential ID is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+    passkeys = passkeys.filter((pk) => pk.id !== credentialId);
+    await session?.set('accountPasskeys', passkeys);
+  } else if (action === 'register-passkey') {
+    const { credentialId, name, device, synced } = body;
+    const newPasskey: PasskeyItem = {
+      id: credentialId || `cred_${Math.random().toString(36).slice(2, 12)}`,
+      name: (name || 'New Passkey').trim(),
+      device: device || 'Platform Authenticator',
+      createdAt: new Date().toISOString().split('T')[0],
+      lastUsedAt: 'Just now',
+      synced: synced ?? true,
+    };
+    passkeys = [newPasskey, ...passkeys];
+    await session?.set('accountPasskeys', passkeys);
+  } else if (action === 'reset-demo') {
+    user = { ...DEFAULT_USER };
+    passkeys = DEFAULT_PASSKEYS.map((k) => ({ ...k }));
+    await session?.set('accountUser', user);
+    await session?.set('accountPasskeys', passkeys);
+  } else {
+    return new Response(JSON.stringify({ error: 'Invalid action' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  return new Response(
+    JSON.stringify({
+      user,
+      passkeys,
+      allAcceptedCredentialIds: passkeys.map((k) => k.id),
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
