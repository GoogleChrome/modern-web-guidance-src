@@ -0,0 +1,994 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import type { PasskeyItem, UserProfile } from '../pages/api/passkeys.json';
+
+interface SignalLogEntry {
+  id: string;
+  timestamp: string;
+  method: string;
+  payload: Record<string, unknown>;
+  status: 'delivered' | 'simulated' | 'error';
+  message: string;
+}
+
+const DEFAULT_USER: UserProfile = {
+  userId: 'dXNlci1kZXZ0b29scy1yZWFkZXItMDE',
+  username: 'alex.rivera@devtoolstimes.dev',
+  displayName: 'Alex Rivera',
+  email: 'alex.rivera@devtoolstimes.dev',
+};
+
+const DEFAULT_PASSKEYS: PasskeyItem[] = [
+  {
+    id: 'cred_macbook_pro_touchid_9f8a7b6c5d4e',
+    name: 'MacBook Pro Touch ID',
+    device: 'macOS · Chrome Profile',
+    createdAt: '2025-02-14',
+    lastUsedAt: 'Today, 09:41 AM',
+    synced: true,
+  },
+  {
+    id: 'cred_pixel_9_pro_biometrics_3e2d1c0b9a8f',
+    name: 'Pixel 9 Pro (Google Password Manager)',
+    device: 'Android 15 · Synced Passkey',
+    createdAt: '2025-05-03',
+    lastUsedAt: 'Oct 24, 2025',
+    synced: true,
+  },
+  {
+    id: 'cred_yubikey_5c_nfc_backup_7a6b5c4d3e2f',
+    name: 'YubiKey 5C NFC (Backup)',
+    device: 'Hardware Security Key',
+    createdAt: '2024-11-19',
+    lastUsedAt: 'Aug 12, 2025',
+    synced: false,
+  },
+];
+
+export default function PasskeyManagement() {
+  const [user, setUser] = useState<UserProfile>(DEFAULT_USER);
+  const [passkeys, setPasskeys] = useState<PasskeyItem[]>(DEFAULT_PASSKEYS);
+  const [loading, setLoading] = useState<boolean>(false);
+
+  // Editing state for individual passkey display names
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingPasskeyName, setEditingPasskeyName] = useState<string>('');
+
+  // Editing state for reader account display name & username
+  const [accountDisplayName, setAccountDisplayName] = useState<string>(DEFAULT_USER.displayName);
+  const [accountUsername, setAccountUsername] = useState<string>(DEFAULT_USER.username);
+  const [isEditingProfile, setIsEditingProfile] = useState<boolean>(false);
+
+  // Add new passkey form state
+  const [newKeyName, setNewKeyName] = useState<string>('');
+  const [showAddForm, setShowAddForm] = useState<boolean>(false);
+
+  // Feedback banner & WebAuthn Signal log
+  const [statusMessage, setStatusMessage] = useState<{ type: 'success' | 'info' | 'error'; text: string } | null>(null);
+  const [signalLogs, setSignalLogs] = useState<SignalLogEntry[]>([]);
+  const [capabilities, setCapabilities] = useState<{
+    signalAllAcceptedCredentials: boolean;
+    signalCurrentUserDetails: boolean;
+    signalUnknownCredential: boolean;
+  }>({
+    signalAllAcceptedCredentials: false,
+    signalCurrentUserDetails: false,
+    signalUnknownCredential: false,
+  });
+
+  const getRpId = () => {
+    if (typeof window !== 'undefined' && window.location.hostname) {
+      return window.location.hostname;
+    }
+    return 'localhost';
+  };
+
+  const appendSignalLog = useCallback(
+    (
+      method: string,
+      payload: Record<string, unknown>,
+      status: 'delivered' | 'simulated' | 'error',
+      message: string
+    ) => {
+      setSignalLogs((prev) => [
+        {
+          id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
+          timestamp: new Date().toLocaleTimeString(),
+          method,
+          payload,
+          status,
+          message,
+        },
+        ...prev.slice(0, 9),
+      ]);
+    },
+    []
+  );
+
+  // Synchronize all accepted credentials with the browser authenticator
+  const syncAllAcceptedCredentials = useCallback(
+    async (userId: string, acceptedIds: string[]) => {
+      const rpId = getRpId();
+      const payload = {
+        rpId,
+        userId,
+        allAcceptedCredentialIds: acceptedIds,
+      };
+
+      try {
+        if (
+          typeof window !== 'undefined' &&
+          'PublicKeyCredential' in window &&
+          typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+        ) {
+          await PublicKeyCredential.signalAllAcceptedCredentials(payload);
+          appendSignalLog(
+            'PublicKeyCredential.signalAllAcceptedCredentials',
+            payload,
+            'delivered',
+            'Synchronized accepted passkey list with browser authenticator.'
+          );
+          return true;
+        } else {
+          appendSignalLog(
+            'PublicKeyCredential.signalAllAcceptedCredentials',
+            payload,
+            'simulated',
+            'Signal API unavailable in this browser; recorded accepted credential IDs payload.'
+          );
+          return false;
+        }
+      } catch (err: any) {
+        appendSignalLog(
+          'PublicKeyCredential.signalAllAcceptedCredentials',
+          payload,
+          'error',
+          err?.message || 'Authenticator signal call failed.'
+        );
+        return false;
+      }
+    },
+    [appendSignalLog]
+  );
+
+  // Signal an unknown/removed credential to the browser authenticator
+  const syncUnknownCredential = useCallback(
+    async (credentialId: string) => {
+      const rpId = getRpId();
+      const payload = {
+        rpId,
+        credentialId,
+      };
+
+      try {
+        if (
+          typeof window !== 'undefined' &&
+          'PublicKeyCredential' in window &&
+          typeof PublicKeyCredential.signalUnknownCredential === 'function'
+        ) {
+          await PublicKeyCredential.signalUnknownCredential(payload);
+          appendSignalLog(
+            'PublicKeyCredential.signalUnknownCredential',
+            payload,
+            'delivered',
+            'Signaled removed credential to browser authenticator.'
+          );
+          return true;
+        } else {
+          appendSignalLog(
+            'PublicKeyCredential.signalUnknownCredential',
+            payload,
+            'simulated',
+            'Signal API unavailable in this browser; recorded unknown credential signal.'
+          );
+          return false;
+        }
+      } catch (err: any) {
+        appendSignalLog(
+          'PublicKeyCredential.signalUnknownCredential',
+          payload,
+          'error',
+          err?.message || 'Authenticator unknown credential signal failed.'
+        );
+        return false;
+      }
+    },
+    [appendSignalLog]
+  );
+
+  // Synchronize updated user display name / username with the browser authenticator
+  const syncCurrentUserDetails = useCallback(
+    async (userId: string, name: string, displayName: string) => {
+      const rpId = getRpId();
+      const payload = {
+        rpId,
+        userId,
+        name,
+        displayName,
+      };
+
+      try {
+        if (
+          typeof window !== 'undefined' &&
+          'PublicKeyCredential' in window &&
+          typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+        ) {
+          await PublicKeyCredential.signalCurrentUserDetails(payload);
+          appendSignalLog(
+            'PublicKeyCredential.signalCurrentUserDetails',
+            payload,
+            'delivered',
+            'Synchronized display name and user details with browser authenticator.'
+          );
+          return true;
+        } else {
+          appendSignalLog(
+            'PublicKeyCredential.signalCurrentUserDetails',
+            payload,
+            'simulated',
+            'Signal API unavailable in this browser; recorded updated user details signal.'
+          );
+          return false;
+        }
+      } catch (err: any) {
+        appendSignalLog(
+          'PublicKeyCredential.signalCurrentUserDetails',
+          payload,
+          'error',
+          err?.message || 'Authenticator user details signal failed.'
+        );
+        return false;
+      }
+    },
+    [appendSignalLog]
+  );
+
+  // Detect WebAuthn Signal API support and load initial passkeys from server
+  useEffect(() => {
+    const checkCapabilities = async () => {
+      if (typeof window !== 'undefined' && 'PublicKeyCredential' in window) {
+        let caps = {
+          signalAllAcceptedCredentials: typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function',
+          signalCurrentUserDetails: typeof PublicKeyCredential.signalCurrentUserDetails === 'function',
+          signalUnknownCredential: typeof PublicKeyCredential.signalUnknownCredential === 'function',
+        };
+
+        if (typeof PublicKeyCredential.getClientCapabilities === 'function') {
+          try {
+            const clientCaps = await PublicKeyCredential.getClientCapabilities();
+            caps = {
+              signalAllAcceptedCredentials:
+                Boolean(clientCaps?.signalAllAcceptedCredentials) || caps.signalAllAcceptedCredentials,
+              signalCurrentUserDetails:
+                Boolean(clientCaps?.signalCurrentUserDetails) || caps.signalCurrentUserDetails,
+              signalUnknownCredential:
+                Boolean(clientCaps?.signalUnknownCredential) || caps.signalUnknownCredential,
+            };
+          } catch {
+            // Fallback to method presence
+          }
+        }
+        setCapabilities(caps);
+      }
+    };
+
+    const fetchPasskeys = async () => {
+      try {
+        const res = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`);
+        if (res.ok) {
+          const data = await res.json();
+          if (data.user) {
+            setUser(data.user);
+            setAccountDisplayName(data.user.displayName);
+            setAccountUsername(data.user.username);
+          }
+          if (Array.isArray(data.passkeys)) {
+            setPasskeys(data.passkeys);
+            await syncAllAcceptedCredentials(
+              data.user?.userId || DEFAULT_USER.userId,
+              data.passkeys.map((k: PasskeyItem) => k.id)
+            );
+          }
+        }
+      } catch {
+        // Fallback to local state if offline
+      }
+    };
+
+    checkCapabilities();
+    fetchPasskeys();
+  }, [syncAllAcceptedCredentials]);
+
+  const startEditingPasskey = (passkey: PasskeyItem) => {
+    setEditingPasskeyId(passkey.id);
+    setEditingPasskeyName(passkey.name);
+    setStatusMessage(null);
+  };
+
+  const cancelEditingPasskey = () => {
+    setEditingPasskeyId(null);
+    setEditingPasskeyName('');
+  };
+
+  const handleUpdatePasskeyName = async (e: React.FormEvent, credentialId: string) => {
+    e.preventDefault();
+    const trimmedName = editingPasskeyName.trim();
+    if (!trimmedName) {
+      setStatusMessage({ type: 'error', text: 'Passkey display name cannot be empty.' });
+      return;
+    }
+
+    setLoading(true);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'rename-passkey',
+          credentialId,
+          name: trimmedName,
+          displayName: trimmedName,
+        }),
+      });
+
+      let updatedPasskeys = passkeys.map((pk) =>
+        pk.id === credentialId ? { ...pk, name: trimmedName } : pk
+      );
+      let currentUser = user;
+
+      if (response.ok) {
+        const data = await response.json();
+        updatedPasskeys = data.passkeys;
+        currentUser = data.user || user;
+      }
+
+      setPasskeys(updatedPasskeys);
+      setEditingPasskeyId(null);
+      setEditingPasskeyName('');
+
+      // Sync display name / user details with browser authenticator
+      await syncCurrentUserDetails(currentUser.userId, currentUser.username, trimmedName);
+
+      setStatusMessage({
+        type: 'success',
+        text: `Updated display name to "${trimmedName}" and synchronized with your browser authenticator.`,
+      });
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'Failed to update passkey display name. Please try again.',
+      });
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handleUpdateProfileDetails = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplay = accountDisplayName.trim();
+    const trimmedUsername = accountUsername.trim();
+    if (!trimmedDisplay || !trimmedUsername) {
+      setStatusMessage({ type: 'error', text: 'Display name and username are required.' });
+      return;
+    }
+
+    setLoading(true);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'update-user-details',
+          displayName: trimmedDisplay,
+          username: trimmedUsername,
+        }),
+      });
+
+      let updatedUser: UserProfile = {
+        ...user,
+        displayName: trimmedDisplay,
+        username: trimmedUsername,
+      };
+
+      if (response.ok) {
+        const data = await response.json();
+        if (data.user) {
+          updatedUser = data.user;
+        }
+      }
+
+      setUser(updatedUser);
+      setIsEditingProfile(false);
+
+      // Keep browser authenticator in sync via PublicKeyCredential.signalCurrentUserDetails
+      await syncCurrentUserDetails(
+        updatedUser.userId,
+        updatedUser.username,
+        updatedUser.displayName
+      );
+
+      setStatusMessage({
+        type: 'success',
+        text: `Reader display name updated to "${updatedUser.displayName}" and synced with browser authenticator.`,
+      });
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'Could not update reader profile details.',
+      });
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handleRemovePasskey = async (passkey: PasskeyItem) => {
+    setLoading(true);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'remove-passkey',
+          credentialId: passkey.id,
+        }),
+      });
+
+      let remainingPasskeys = passkeys.filter((pk) => pk.id !== passkey.id);
+      if (response.ok) {
+        const data = await response.json();
+        remainingPasskeys = data.passkeys;
+      }
+
+      setPasskeys(remainingPasskeys);
+
+      // Signal removal and accepted credential list to browser authenticator
+      await syncUnknownCredential(passkey.id);
+      await syncAllAcceptedCredentials(
+        user.userId,
+        remainingPasskeys.map((pk) => pk.id)
+      );
+
+      setStatusMessage({
+        type: 'info',
+        text: `Removed "${passkey.name}" and notified your browser authenticator to prune stale credentials.`,
+      });
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'Failed to remove passkey. Please try again.',
+      });
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handleRegisterPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const label = newKeyName.trim() || 'This Browser Passkey';
+    setLoading(true);
+    setStatusMessage(null);
+
+    let createdCredentialId = `cred_${Math.random().toString(36).slice(2, 12)}`;
+
+    // Attempt WebAuthn creation if available and user requests it, falling back gracefully
+    if (
+      typeof window !== 'undefined' &&
+      window.navigator?.credentials &&
+      typeof window.navigator.credentials.create === 'function' &&
+      'PublicKeyCredential' in window
+    ) {
+      try {
+        const challenge = new Uint8Array(32);
+        window.crypto.getRandomValues(challenge);
+        const userIdBytes = new TextEncoder().encode(user.userId);
+
+        const credential = (await window.navigator.credentials.create({
+          publicKey: {
+            challenge,
+            rp: {
+              name: 'The DevTools Times',
+              id: getRpId(),
+            },
+            user: {
+              id: userIdBytes,
+              name: user.username,
+              displayName: user.displayName,
+            },
+            pubKeyCredParams: [
+              { type: 'public-key', alg: -7 },
+              { type: 'public-key', alg: -257 },
+            ],
+            timeout: 15000,
+            authenticatorSelection: {
+              residentKey: 'preferred',
+              userVerification: 'preferred',
+            },
+          },
+        })) as PublicKeyCredential | null;
+
+        if (credential?.id) {
+          createdCredentialId = credential.id;
+        }
+      } catch {
+        // If user cancels native dialog or headless environment blocks prompt, proceed with generated credential ID
+      }
+    }
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'register-passkey',
+          credentialId: createdCredentialId,
+          name: label,
+          device: 'Current Browser · Platform Authenticator',
+          synced: true,
+        }),
+      });
+
+      let updatedPasskeys = passkeys;
+      if (response.ok) {
+        const data = await response.json();
+        updatedPasskeys = data.passkeys;
+      } else {
+        updatedPasskeys = [
+          {
+            id: createdCredentialId,
+            name: label,
+            device: 'Current Browser · Platform Authenticator',
+            createdAt: new Date().toISOString().split('T')[0],
+            lastUsedAt: 'Just now',
+            synced: true,
+          },
+          ...passkeys,
+        ];
+      }
+
+      setPasskeys(updatedPasskeys);
+      setNewKeyName('');
+      setShowAddForm(false);
+
+      await syncAllAcceptedCredentials(
+        user.userId,
+        updatedPasskeys.map((pk) => pk.id)
+      );
+
+      setStatusMessage({
+        type: 'success',
+        text: `Registered passkey "${label}" and synchronized accepted credentials with your authenticator.`,
+      });
+    } catch {
+      setStatusMessage({
+        type: 'error',
+        text: 'Failed to register new passkey.',
+      });
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handleManualSync = async () => {
+    setLoading(true);
+    setStatusMessage(null);
+    await syncCurrentUserDetails(user.userId, user.username, user.displayName);
+    await syncAllAcceptedCredentials(
+      user.userId,
+      passkeys.map((pk) => pk.id)
+    );
+    setStatusMessage({
+      type: 'success',
+      text: 'Synchronized all active passkeys and reader details with your browser authenticator.',
+    });
+    setLoading(false);
+  };
+
+  const handleResetDemo = async () => {
+    setLoading(true);
+    setStatusMessage(null);
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ action: 'reset-demo' }),
+      });
+      if (response.ok) {
+        const data = await response.json();
+        setUser(data.user);
+        setAccountDisplayName(data.user.displayName);
+        setAccountUsername(data.user.username);
+        setPasskeys(data.passkeys);
+        await syncAllAcceptedCredentials(
+          data.user.userId,
+          data.passkeys.map((pk: PasskeyItem) => pk.id)
+        );
+        setStatusMessage({
+          type: 'info',
+          text: 'Restored default passkeys and synchronized with your browser authenticator.',
+        });
+      }
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div className="space-y-8">
+      {/* Signed-in Reader Profile & Passkey Display Name Card */}
+      <section
+        aria-labelledby="reader-profile-heading"
+        className="bg-white border border-gray-200 rounded-lg shadow-sm p-6"
+      >
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-gray-200">
+          <div>
+            <div className="flex items-center gap-2">
+              <span className="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
+                Signed In
+              </span>
+              <span className="text-xs text-gray-500 font-mono">ID: {user.userId}</span>
+            </div>
+            <h2 id="reader-profile-heading" className="text-xl font-bold text-gray-900 mt-1">
+              Reader Account Identity
