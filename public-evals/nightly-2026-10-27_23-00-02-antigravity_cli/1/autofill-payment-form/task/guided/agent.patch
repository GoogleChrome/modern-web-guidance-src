+  <script>
+    const paymentForm = document.getElementById('payment-form');
+    const paySubmitBtn = document.getElementById('pay-submit-btn');
+    const paymentStatus = document.getElementById('payment-status');
+
+    const errorMessages = {
+      'cc-number': 'Please enter a valid 13 to 19 digit card number.',
+      'cc-name': 'Please enter the cardholder name as shown on the card.',
+      'cc-exp': 'Please enter a valid expiry date in MM/YY format.',
+      'cc-csc': 'Please enter a valid 3 or 4 digit security code.'
+    };
+
+    Object.keys(errorMessages).forEach((id) => {
+      const input = document.getElementById(id);
+      const errorEl = document.getElementById(`${id}-error`);
+
+      input.addEventListener('input', () => {
+        input.setCustomValidity('');
+        errorEl.textContent = '';
+      });
+
+      input.addEventListener('blur', () => {
+        if (!input.value) return;
+        if (!input.checkValidity()) {
+          errorEl.textContent = errorMessages[id];
+        }
+      });
+
+      input.addEventListener('invalid', () => {
+        const msg = errorMessages[id];
+        input.setCustomValidity(msg);
+        errorEl.textContent = msg;
+      });
+    });
+
+    paymentForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!paymentForm.checkValidity()) {
+        paymentForm.reportValidity();
+        return;
+      }
+      paySubmitBtn.disabled = true;
+      paymentStatus.textContent = 'Processing payment...';
+    });
+  </script>
+
