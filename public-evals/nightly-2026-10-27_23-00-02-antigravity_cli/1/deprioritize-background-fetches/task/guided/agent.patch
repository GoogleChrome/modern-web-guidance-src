diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,33 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Fetch Priority Demo</title>
+</head>
+<body>
+  <main>
+    <h1>Mission-Critical Data Loader</h1>
+    <button type="button" id="load-btn">Load Data</button>
+  </main>
+
+  <script type="module">
+    const loadBtn = document.getElementById('load-btn');
+
+    loadBtn.addEventListener('click', () => {
+      // High priority (default for fetch) for mission-critical data
+      fetch('/api/data');
+
+      // Explicitly deprioritize background analytics to prevent network contention
+      fetch('/api/analytics', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low',
+      });
+    });
+  </script>
+</body>
+</html>
