+  <script>
+    (function () {
+      const panel = document.getElementById('floating-cart-panel');
+      const dragHandle = document.getElementById('cart-drag-handle');
+      const minimizeBtn = document.getElementById('cart-minimize-btn');
+      const drinkSelect = document.getElementById('quick-drink-select');
+      const sizePills = document.querySelectorAll('.size-pill');
+      const milkPills = document.querySelectorAll('.milk-pill');
+      const builderAddBtn = document.getElementById('builder-add-btn');
+      const cartItemsList = document.getElementById('cart-items-list');
+      const cartCountBadge = document.getElementById('cart-count-badge');
+      const cartTotalPrice = document.getElementById('cart-total-price');
+      const clearCartBtn = document.getElementById('clear-cart-btn');
+      const checkoutBtn = document.getElementById('checkout-btn');
+      const orderStatusBanner = document.getElementById('order-status-banner');
+      const cardQuickAddBtns = document.querySelectorAll('.quick-add-card-btn');
+
+      let selectedSize = 'Medium';
+      let selectedSizeUpcharge = 0.50;
+      let selectedMilk = 'Oat Milk';
+
+      let cart = [
+        {
+          id: 'maple-oat-latte-medium-oat',
+          name: 'Maple Oat Latte',
+          size: 'Medium',
+          milk: 'Oat Milk',
+          unitPrice: 6.00,
+          qty: 1
+        },
+        {
+          id: 'cold-brew-medium-none',
+          name: 'Cold Brew',
+          size: 'Medium',
+          milk: 'Black / None',
+          unitPrice: 5.00,
+          qty: 1
+        }
+      ];
+
+      function renderCart() {
+        cartItemsList.innerHTML = '';
+        let totalQty = 0;
+        let totalPrice = 0;
+
+        if (cart.length === 0) {
+          const emptyLi = document.createElement('li');
+          emptyLi.className = 'cart-empty-msg';
+          emptyLi.textContent = 'Your coffee cart is empty. Add a drink above!';
+          cartItemsList.appendChild(emptyLi);
+        } else {
+          cart.forEach((item, index) => {
+            totalQty += item.qty;
+            totalPrice += item.unitPrice * item.qty;
+
+            const li = document.createElement('li');
+            li.className = 'cart-item';
+            li.innerHTML = `
+              <div class="cart-item-info">
+                <div class="cart-item-name">${item.name}</div>
+                <div class="cart-item-meta">${item.size} &bull; ${item.milk} &bull; $${(item.unitPrice * item.qty).toFixed(2)}</div>
+              </div>
+              <div class="cart-item-controls">
+                <button type="button" class="qty-btn" data-action="dec" data-index="${index}" aria-label="Decrease quantity">&minus;</button>
+                <span class="item-qty">${item.qty}</span>
+                <button type="button" class="qty-btn" data-action="inc" data-index="${index}" aria-label="Increase quantity">+</button>
+              </div>
+            `;
+            cartItemsList.appendChild(li);
+          });
+        }
+
+        cartCountBadge.textContent = totalQty;
+        cartTotalPrice.textContent = `$${totalPrice.toFixed(2)}`;
+        checkoutBtn.disabled = cart.length === 0;
+      }
+
+      function addToCart(name, basePrice, size, upcharge, milk) {
+        const unitPrice = parseFloat(basePrice) + parseFloat(upcharge);
+        const id = `${name}-${size}-${milk}`.toLowerCase().replace(/\s+/g, '-');
+        const existing = cart.find(item => item.id === id);
+
+        if (existing) {
+          existing.qty += 1;
+        } else {
+          cart.push({
+            id,
+            name,
+            size,
+            milk,
+            unitPrice,
+            qty: 1
+          });
+        }
+        orderStatusBanner.classList.remove('visible');
+        renderCart();
+      }
+
+      // Pill selection handlers
+      sizePills.forEach(btn => {
+        btn.addEventListener('click', () => {
+          sizePills.forEach(b => b.classList.remove('active'));
+          btn.classList.add('active');
+          selectedSize = btn.getAttribute('data-size');
+          selectedSizeUpcharge = parseFloat(btn.getAttribute('data-upcharge') || '0');
+        });
+      });
+
+      milkPills.forEach(btn => {
+        btn.addEventListener('click', () => {
+          milkPills.forEach(b => b.classList.remove('active'));
+          btn.classList.add('active');
+          selectedMilk = btn.getAttribute('data-milk');
+        });
+      });
+
+      // Add from builder
+      builderAddBtn.addEventListener('click', () => {
+        const option = drinkSelect.options[drinkSelect.selectedIndex];
+        const name = option.value;
+        const basePrice = parseFloat(option.getAttribute('data-price') || '4.50');
+        addToCart(name, basePrice, selectedSize, selectedSizeUpcharge, selectedMilk);
+      });
+
+      // Quick add from homepage cards
+      cardQuickAddBtns.forEach(btn => {
+        btn.addEventListener('click', () => {
+          const name = btn.getAttribute('data-name');
+          const price = parseFloat(btn.getAttribute('data-price') || '4.50');
+          addToCart(name, price, 'Medium', 0, 'Standard');
+          if (panel.classList.contains('minimized')) {
+            panel.classList.remove('minimized');
+            minimizeBtn.innerHTML = '&minus;';
+          }
+        });
+      });
+
+      // Quantity +/- controls
+      cartItemsList.addEventListener('click', (e) => {
+        const btn = e.target.closest('.qty-btn');
+        if (!btn) return;
+        const index = parseInt(btn.getAttribute('data-index'), 10);
+        const action = btn.getAttribute('data-action');
+        if (isNaN(index) || !cart[index]) return;
+
+        if (action === 'inc') {
+          cart[index].qty += 1;
+        } else if (action === 'dec') {
+          cart[index].qty -= 1;
+          if (cart[index].qty <= 0) {
+            cart.splice(index, 1);
+          }
+        }
+        orderStatusBanner.classList.remove('visible');
+        renderCart();
+      });
+
+      // Clear cart
+      clearCartBtn.addEventListener('click', () => {
+        cart = [];
+        orderStatusBanner.classList.remove('visible');
+        renderCart();
+      });
+
+      // Checkout action
+      checkoutBtn.addEventListener('click', () => {
+        if (cart.length === 0) return;
+        const count = cart.reduce((sum, item) => sum + item.qty, 0);
+        orderStatusBanner.textContent = `Order placed for ${count} item${count > 1 ? 's' : ''}! Ready in ~10 mins.`;
+        orderStatusBanner.classList.add('visible');
+        cart = [];
+        renderCart();
+      });
+
+      // Minimize / Expand toggle
+      minimizeBtn.addEventListener('click', (e) => {
+        e.stopPropagation();
+        const isMin = panel.classList.toggle('minimized');
+        minimizeBtn.innerHTML = isMin ? '&#43;' : '&minus;';
+      });
+
+      // Draggable header handle implementation (Mouse + Touch / Pointer events)
+      let isDragging = false;
+      let dragStartX = 0;
+      let dragStartY = 0;
+      let initialLeft = 0;
+      let initialTop = 0;
+
+      function startDrag(clientX, clientY, target) {
+        if (target.closest('button')) return;
+        isDragging = true;
+        const rect = panel.getBoundingClientRect();
+        initialLeft = rect.left;
+        initialTop = rect.top;
+        dragStartX = clientX;
+        dragStartY = clientY;
+
+        panel.style.left = `${initialLeft}px`;
+        panel.style.top = `${initialTop}px`;
+        panel.style.right = 'auto';
+        panel.style.bottom = 'auto';
+        panel.classList.add('dragging');
+      }
+
+      function onDragMove(clientX, clientY) {
+        if (!isDragging) return;
+        const dx = clientX - dragStartX;
+        const dy = clientY - dragStartY;
+
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - dragHandle.offsetHeight);
+
+        const nextLeft = Math.min(Math.max(0, initialLeft + dx), maxLeft);
+        const nextTop = Math.min(Math.max(0, initialTop + dy), maxTop);
+
+        panel.style.left = `${nextLeft}px`;
+        panel.style.top = `${nextTop}px`;
+      }
+
+      function stopDrag() {
+        if (!isDragging) return;
+        isDragging = false;
+        panel.classList.remove('dragging');
+      }
+
+      dragHandle.addEventListener('mousedown', (e) => {
+        startDrag(e.clientX, e.clientY, e.target);
+      });
+
+      window.addEventListener('mousemove', (e) => {
+        onDragMove(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', stopDrag);
+
+      dragHandle.addEventListener('touchstart', (e) => {
+        if (e.touches.length === 1) {
+          startDrag(e.touches[0].clientX, e.touches[0].clientY, e.target);
+        }
+      }, { passive: true });
+
+      window.addEventListener('touchmove', (e) => {
+        if (isDragging && e.touches.length === 1) {
+          onDragMove(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+
+      window.addEventListener('touchend', stopDrag);
+
+      // Initial render
+      renderCart();
+    })();
+  </script>
 </body>
 
