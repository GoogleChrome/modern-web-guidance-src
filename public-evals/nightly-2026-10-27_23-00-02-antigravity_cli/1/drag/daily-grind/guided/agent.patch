+  <script>
+    (function () {
+      const panel = document.getElementById('quick-order-panel');
+      const handle = document.getElementById('quick-order-handle');
+      const minimizeBtn = document.getElementById('minimize-cart-btn');
+      const countBadge = document.getElementById('cart-count-badge');
+      const totalPriceEl = document.getElementById('cart-total-price');
+      const sizeSelect = document.getElementById('cup-size-select');
+      const milkSelect = document.getElementById('milk-option-select');
+      const clearBtn = document.getElementById('clear-cart-btn');
+      const placeOrderBtn = document.getElementById('place-order-btn');
+      const statusMsg = document.getElementById('order-status-msg');
+      const itemRows = Array.from(panel.querySelectorAll('.cart-item'));
+
+      // Progressive enhancement: attach drag affordances and keyboard accessibility when JS initializes
+      handle.classList.add('drag-enabled');
+      handle.tabIndex = 0;
+      handle.setAttribute(
+        'aria-label',
+        'Quick Order Cart header handle. Drag or use arrow keys to move panel.'
+      );
+
+      let offsetX = 0;
+      let offsetY = 0;
+      let startX = 0;
+      let startY = 0;
+      let isDragging = false;
+      let hasCustomPosition = false;
+
+      function ensureExplicitPosition() {
+        if (!hasCustomPosition) {
+          const rect = panel.getBoundingClientRect();
+          panel.style.right = 'auto';
+          panel.style.bottom = 'auto';
+          panel.style.left = `${rect.left}px`;
+          panel.style.top = `${rect.top}px`;
+          hasCustomPosition = true;
+        }
+      }
+
+      function moveTo(left, top) {
+        ensureExplicitPosition();
+        const maxLeft = Math.max(0, window.innerWidth - panel.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - panel.offsetHeight);
+
+        panel.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        panel.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (
+          event.button !== 0 ||
+          event.target.closest('button, input, select, textarea, a')
+        ) {
+          return;
+        }
+
+        const rect = panel.getBoundingClientRect();
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        startX = event.clientX;
+        startY = event.clientY;
+        isDragging = false;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+
+        if (!isDragging) {
+          if (Math.hypot(event.clientX - startX, event.clientY - startY) < 4) {
+            return;
+          }
+          isDragging = true;
+          handle.classList.add('dragging');
+        }
+
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        isDragging = false;
+        handle.classList.remove('dragging');
+      });
+
+      handle.addEventListener('keydown', (event) => {
+        if (event.target !== handle) return;
+        const step = 15;
+        const rect = panel.getBoundingClientRect();
+
+        switch (event.key) {
+          case 'ArrowLeft':
+            event.preventDefault();
+            moveTo(rect.left - step, rect.top);
+            break;
+          case 'ArrowRight':
+            event.preventDefault();
+            moveTo(rect.left + step, rect.top);
+            break;
+          case 'ArrowUp':
+            event.preventDefault();
+            moveTo(rect.left, rect.top - step);
+            break;
+          case 'ArrowDown':
+            event.preventDefault();
+            moveTo(rect.left, rect.top + step);
+            break;
+        }
+      });
+
+      function reclampIfNeeded() {
+        if (!hasCustomPosition) return;
+        const currentLeft = parseFloat(panel.style.left) || 0;
+        const currentTop = parseFloat(panel.style.top) || 0;
+        moveTo(currentLeft, currentTop);
+      }
+
+      window.addEventListener('resize', reclampIfNeeded);
+      if (typeof ResizeObserver !== 'undefined') {
+        new ResizeObserver(reclampIfNeeded).observe(panel);
+      }
+
+      // Interactive Cart Logic
+      const quantities = {
+        'maple-oat-latte': 1,
+        'dark-roast-espresso': 0,
+        'cold-brew': 1,
+      };
+
+      function updateCartUI() {
+        let totalItems = 0;
+        let baseSum = 0;
+
+        itemRows.forEach((row) => {
+          const id = row.getAttribute('data-item-id');
+          const price = parseFloat(row.getAttribute('data-price')) || 0;
+          const qty = quantities[id] || 0;
+          const qtyEl = row.querySelector('[data-qty]');
+          if (qtyEl) qtyEl.textContent = String(qty);
+
+          totalItems += qty;
+          baseSum += qty * price;
+        });
+
+        const sizeAddon = parseFloat(sizeSelect.value) || 0;
+        const milkAddon = parseFloat(milkSelect.value) || 0;
+        const total = totalItems > 0 ? baseSum + totalItems * (sizeAddon + milkAddon) : 0;
+
+        countBadge.textContent = `${totalItems} ${totalItems === 1 ? 'item' : 'items'}`;
+        totalPriceEl.textContent = `$${total.toFixed(2)}`;
+        placeOrderBtn.disabled = totalItems === 0;
+      }
+
+      itemRows.forEach((row) => {
+        const id = row.getAttribute('data-item-id');
+        row.addEventListener('click', (event) => {
+          const btn = event.target.closest('button[data-action]');
+          if (!btn) return;
+          const action = btn.getAttribute('data-action');
+          if (action === 'increase') {
+            quantities[id] = (quantities[id] || 0) + 1;
+          } else if (action === 'decrease') {
+            quantities[id] = Math.max(0, (quantities[id] || 0) - 1);
+          }
+          statusMsg.textContent = '';
+          updateCartUI();
+        });
+      });
+
+      document.querySelectorAll('[data-add-item]').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const id = btn.getAttribute('data-add-item');
+          if (id in quantities) {
+            quantities[id] += 1;
+            if (panel.classList.contains('minimized')) {
+              panel.classList.remove('minimized');
+              minimizeBtn.setAttribute('aria-expanded', 'true');
+              minimizeBtn.textContent = '−';
+            }
+            statusMsg.textContent = 'Added to your cart!';
+            updateCartUI();
+          }
+        });
+      });
+
+      sizeSelect.addEventListener('change', () => {
+        statusMsg.textContent = '';
+        updateCartUI();
+      });
+
+      milkSelect.addEventListener('change', () => {
+        statusMsg.textContent = '';
+        updateCartUI();
+      });
+
+      clearBtn.addEventListener('click', () => {
+        Object.keys(quantities).forEach((key) => {
+          quantities[key] = 0;
+        });
+        statusMsg.textContent = 'Cart cleared.';
+        updateCartUI();
+      });
+
+      placeOrderBtn.addEventListener('click', () => {
+        const totalText = totalPriceEl.textContent;
+        statusMsg.textContent = `Order placed (${totalText})! Ready in ~5 mins.`;
+      });
+
+      minimizeBtn.addEventListener('click', () => {
+        const isMinimized = panel.classList.toggle('minimized');
+        minimizeBtn.setAttribute('aria-expanded', String(!isMinimized));
+        minimizeBtn.textContent = isMinimized ? '+' : '−';
+      });
+
+      updateCartUI();
+    })();
+  </script>
+
 </body>
 
 </html>
