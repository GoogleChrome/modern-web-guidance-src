+  <!-- Dedicated Root Slot for Persistent Feedback Overlay Modal -->
+  <div id="feedback-slot-root" class="feedback-slot" data-slot-name="Overlay Root">
+    <dialog id="feedback-dialog" class="feedback-modal" aria-labelledby="feedback-dialog-title">
+      <div class="feedback-modal-header">
+        <h3 id="feedback-dialog-title">Share Your Feedback</h3>
+        <div class="feedback-header-actions">
+          <button type="button" id="move-feedback-btn" class="feedback-move-btn" data-action="move-dialog" title="Relocate dialog in DOM using moveBefore">
+            Move Modal
+          </button>
+          <button type="button" id="close-feedback-btn" class="feedback-close-btn" aria-label="Close feedback modal">
+            &times; Close
+          </button>
+        </div>
+      </div>
+      <div class="feedback-modal-body">
+        <div class="feedback-status-bar">
+          <span>DOM Host: <strong id="feedback-host-label">Overlay Root</strong></span>
+          <span class="feedback-badge" id="feedback-api-badge">Ready</span>
+        </div>
+        <form id="feedback-form" method="dialog">
+          <div class="feedback-field">
+            <label for="feedback-name">Your Name</label>
+            <input type="text" id="feedback-name" name="name" placeholder="Alex Rivera" autocomplete="off">
+          </div>
+          <div class="feedback-field">
+            <label for="feedback-drink">Favorite Drink</label>
+            <select id="feedback-drink" name="drink">
+              <option value="maple-oat-latte">Maple Oat Latte</option>
+              <option value="dark-roast-espresso">Dark Roast Espresso</option>
+              <option value="cold-brew">Cold Brew</option>
+            </select>
+          </div>
+          <div class="feedback-field">
+            <label for="feedback-message">Your Thoughts</label>
+            <textarea id="feedback-message" name="message" rows="3" placeholder="Tell us how your coffee was today..."></textarea>
+          </div>
+          <div class="feedback-modal-footer">
+            <button type="button" id="move-feedback-footer-btn" class="feedback-move-btn" style="background: var(--secondary); color: var(--primary); border-color: var(--primary);">
+              Move to Next Container
+            </button>
+            <button type="submit" id="submit-feedback-btn" class="feedback-submit-btn">Send Feedback</button>
+          </div>
+          <div id="feedback-toast" class="feedback-toast" role="status" aria-live="polite">
+            Thank you! Your feedback has been saved while keeping the overlay active.
+          </div>
+        </form>
+      </div>
+    </dialog>
+  </div>
+
+  <button type="button" id="open-feedback-btn" class="feedback-trigger-btn" aria-haspopup="dialog" aria-controls="feedback-dialog">
+    Feedback
+  </button>
+
+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-dialog');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const closeBtn = document.getElementById('close-feedback-btn');
+      const moveHeaderBtn = document.getElementById('move-feedback-btn');
+      const moveFooterBtn = document.getElementById('move-feedback-footer-btn');
+      const hostLabel = document.getElementById('feedback-host-label');
+      const apiBadge = document.getElementById('feedback-api-badge');
+      const feedbackForm = document.getElementById('feedback-form');
+      const feedbackToast = document.getElementById('feedback-toast');
+      const feedbackMessage = document.getElementById('feedback-message');
+
+      const containers = [
+        document.getElementById('feedback-slot-root'),
+        document.getElementById('feedback-slot-main'),
+        document.getElementById('feedback-slot-hero'),
+        document.getElementById('feedback-slot-footer')
+      ].filter(Boolean);
+
+      function openFeedbackModal() {
+        if (!dialog.open) {
+          if (typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+      }
+
+      function closeFeedbackModal() {
+        if (dialog.open) {
+          if (typeof dialog.close === 'function') {
+            dialog.close();
+          } else {
+            dialog.removeAttribute('open');
+          }
+        }
+      }
+
+      /**
+       * Relocates the open <dialog> in the DOM to targetContainer before referenceNode.
+       * Uses the native state-preserving Element.prototype.moveBefore API when supported,
+       * and falls back to insertBefore while manually restoring modal open state,
+       * active focus, and text selection in unsupported browsers.
+       */
+      function relocateFeedbackModal(targetContainer, referenceNode = null) {
+        if (!dialog || !targetContainer) return;
+
+        const wasOpen = dialog.open;
+        const activeEl = document.activeElement;
+        const focusWasInside = dialog.contains(activeEl);
+
+        // Capture selection/cursor state if an input or textarea inside the dialog was focused
+        let selectionState = null;
+        if (focusWasInside && activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA')) {
+          try {
+            selectionState = {
+              selectionStart: activeEl.selectionStart,
+              selectionEnd: activeEl.selectionEnd,
+              selectionDirection: activeEl.selectionDirection
+            };
+          } catch (_) {
+            selectionState = null;
+          }
+        }
+
+        let usedNativeMoveBefore = false;
+
+        if (typeof targetContainer.moveBefore === 'function') {
+          try {
+            targetContainer.moveBefore(dialog, referenceNode);
+            usedNativeMoveBefore = true;
+          } catch (_) {
+            usedNativeMoveBefore = false;
+          }
+        }
+
+        if (!usedNativeMoveBefore) {
+          // Fallback for browsers that do not support state-preserving moveBefore:
+          // insertBefore removes & re-inserts the <dialog>, which closes it and drops focus.
+          targetContainer.insertBefore(dialog, referenceNode);
+
+          if (wasOpen && !dialog.open) {
+            if (typeof dialog.showModal === 'function') {
+              dialog.showModal();
+            } else {
+              dialog.setAttribute('open', '');
+            }
+          }
+        }
+
+        // Ensure modal remains open and focus-active after reparenting
+        if (wasOpen && !dialog.open) {
+          if (typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+
+        if (focusWasInside && activeEl && document.activeElement !== activeEl) {
+          activeEl.focus({ preventScroll: true });
+          if (selectionState && typeof activeEl.setSelectionRange === 'function') {
+            try {
+              activeEl.setSelectionRange(
+                selectionState.selectionStart,
+                selectionState.selectionEnd,
+                selectionState.selectionDirection
+              );
+            } catch (_) {}
+          }
+        }
+
+        const slotName = targetContainer.getAttribute('data-slot-name') || targetContainer.id || targetContainer.tagName.toLowerCase();
+        if (hostLabel) {
+          hostLabel.textContent = slotName;
+        }
+        if (apiBadge) {
+          apiBadge.textContent = usedNativeMoveBefore ? 'moveBefore (Native)' : 'Fallback (Restored)';
+        }
+
+        return {
+          usedNativeMoveBefore,
+          container: targetContainer,
+          open: dialog.open,
+          activeElement: document.activeElement
+        };
+      }
+
+      function cycleFeedbackContainer() {
+        if (!dialog.open) {
+          openFeedbackModal();
+        }
+        const currentParent = dialog.parentElement;
+        const currentIndex = containers.indexOf(currentParent);
+        const nextIndex = (currentIndex + 1) % containers.length;
+        const nextContainer = containers[nextIndex];
+        return relocateFeedbackModal(nextContainer, null);
+      }
+
+      moveHeaderBtn.addEventListener('click', cycleFeedbackContainer);
+      moveFooterBtn.addEventListener('click', cycleFeedbackContainer);
+      openBtn.addEventListener('click', () => {
+        openFeedbackModal();
+        if (feedbackMessage) {
+          feedbackMessage.focus();
+        }
+      });
+      closeBtn.addEventListener('click', closeFeedbackModal);
+
+      feedbackForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (feedbackToast) {
+          feedbackToast.classList.add('visible');
+        }
+      });
+
+      // Open the persistent feedback modal initially so it is immediately ready
+      openFeedbackModal();
+
+      // Expose helper for programmatic inspection if needed
+      window.relocateFeedbackModal = relocateFeedbackModal;
+      window.cycleFeedbackContainer = cycleFeedbackContainer;
+    })();
+  </script>
