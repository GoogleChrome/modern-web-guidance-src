+  <button type="button" id="open-feedback-btn" class="feedback-fab" commandfor="feedback-dialog" command="show-modal">
+    Give Feedback
+  </button>
+
+  <script type="module">
+    // Conditionally polyfill Invoker Commands when native support is missing
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+    }
+
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const openFeedbackBtn = document.getElementById('open-feedback-btn');
+    const closeFeedbackBtn = document.getElementById('close-feedback-btn');
+    const moveDialogBtn = document.getElementById('move-dialog-btn');
+    const parentIndicator = document.getElementById('feedback-parent-indicator');
+    const moveStatus = document.getElementById('feedback-move-status');
+
+    const hostContainers = [
+      document.getElementById('feedback-host-main'),
+      document.getElementById('feedback-host-footer'),
+      document.getElementById('feedback-host-header'),
+    ];
+
+    // Ensure button click also opens/closes modal if Invoker Commands polyfill is offline or still loading
+    openFeedbackBtn.addEventListener('click', () => {
+      if (!feedbackDialog.open && typeof feedbackDialog.showModal === 'function') {
+        feedbackDialog.showModal();
+      }
+    });
+
+    closeFeedbackBtn.addEventListener('click', () => {
+      if (feedbackDialog.open && typeof feedbackDialog.close === 'function') {
+        feedbackDialog.close('cancel');
+      }
+    });
+
+    feedbackDialog.addEventListener('close', () => {
+      feedbackDialog.returnValue = '';
+    });
+
+    function relocateDialogInDOM(targetParent) {
+      if (!targetParent || !feedbackDialog) return;
+
+      // Capture active focus and text selection state before fallback reparenting
+      const previouslyFocused = document.activeElement;
+      const focusWasInside = feedbackDialog.contains(previouslyFocused);
+      const selectionStart =
+        previouslyFocused && typeof previouslyFocused.selectionStart === 'number'
+          ? previouslyFocused.selectionStart
+          : null;
+      const selectionEnd =
+        previouslyFocused && typeof previouslyFocused.selectionEnd === 'number'
+          ? previouslyFocused.selectionEnd
+          : null;
+
+      // Check if native state-preserving moveBefore is supported on Element.prototype
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(feedbackDialog, null);
+        moveStatus.textContent = `Relocated to #${targetParent.id} via native moveBefore() (state & focus preserved).`;
+      } else {
+        // Fallback: traditional DOM move (closes <dialog>, popover, and resets focus state)
+        const wasOpen =
+          feedbackDialog.hasAttribute('open') ||
+          (typeof feedbackDialog.matches === 'function' && feedbackDialog.matches(':popover-open'));
+
+        targetParent.insertBefore(feedbackDialog, null);
+
+        // Manually restore modal / popover state
+        if (wasOpen && typeof feedbackDialog.showModal === 'function') {
+          feedbackDialog.showModal();
+        } else if (wasOpen && typeof feedbackDialog.showPopover === 'function') {
+          feedbackDialog.showPopover();
+        }
+
+        // Restore focus and caret selection inside the reparented modal
+        if (focusWasInside && previouslyFocused && typeof previouslyFocused.focus === 'function') {
+          previouslyFocused.focus();
+          if (
+            selectionStart !== null &&
+            selectionEnd !== null &&
+            typeof previouslyFocused.setSelectionRange === 'function'
+          ) {
+            previouslyFocused.setSelectionRange(selectionStart, selectionEnd);
+          }
+        }
+
+        moveStatus.textContent = `Relocated to #${targetParent.id} via insertBefore() fallback (modal re-opened & focus restored).`;
+      }
+
+      parentIndicator.textContent = `Parent: #${targetParent.id}`;
+    }
+
+    moveDialogBtn.addEventListener('click', () => {
+      const currentParent = feedbackDialog.parentElement;
+      const currentIndex = hostContainers.indexOf(currentParent);
+      const nextParent = hostContainers[(currentIndex + 1) % hostContainers.length];
+      relocateDialogInDOM(nextParent);
+    });
+  </script>
