+          announceAction(active.dataset.action || active.textContent.trim());
+        }
+      });
+
+      // Command and checkable item activation
+      group.addEventListener("click", event => {
+        const item = event.target.closest("button");
+        if (!item || item.closest("[focusgroup]") !== group) return;
+        if (item.hasAttribute("commandfor")) return; // Submenu trigger handled by invoker
+
+        const fromPointer = event.detail > 0;
+        const role = item.getAttribute("role");
+        const root = rootMenuOf(menu);
+
+        if (role === "menuitemcheckbox") {
+          const checked = item.getAttribute("aria-checked") === "true";
+          item.setAttribute("aria-checked", String(!checked));
+          announceAction(item.dataset.action || item.textContent.trim());
+          setTimeout(() => closeAndRestore(root, { fromPointer }), 300);
+          return;
+        }
+
+        if (role === "menuitemradio") {
+          const radioGroup = item.closest('[role="group"]') || group;
+          radioGroup.querySelectorAll('[role="menuitemradio"]').forEach(radio => {
+            radio.setAttribute("aria-checked", String(radio === item));
+          });
+          announceAction(item.dataset.action || item.textContent.trim());
+          setTimeout(() => closeAndRestore(root, { fromPointer }), 300);
+          return;
+        }
+
+        // Regular command button
+        announceAction(item.dataset.action || item.textContent.trim());
+        closeAndRestore(root, { fromPointer });
+      });
+    });
+
+    // 8. Close open menus when focus moves completely outside the menu system
+    document.addEventListener("focusin", event => {
+      if (windowBlurred) return;
+      document.querySelectorAll("[popover]").forEach(menu => {
+        if (!isOpen(menu) || isSubmenu(menu)) return;
+        const trigger = triggerFor(menu);
+        if (!menu.contains(event.target) && event.target !== trigger && !trigger?.contains(event.target)) {
+          menu.hidePopover();
+        }
+      });
+    });
+  </script>
