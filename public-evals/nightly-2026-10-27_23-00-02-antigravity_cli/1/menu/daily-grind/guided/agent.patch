+      /* Menu Popover & Submenu Component */
+      [popover] {
+        border: 1px solid var(--border);
+        border-radius: 8px;
+        background: var(--surface);
+        color: var(--text);
+        box-shadow: var(--shadow-lg);
+        padding: 6px;
