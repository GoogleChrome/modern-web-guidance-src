+  <script>
+    function base64UrlToUint8Array(base64Url) {
+      if (typeof base64Url !== 'string') {
+        return base64Url;
+      }
+      const padding = '='.repeat((4 - (base64Url.length % 4)) % 4);
+      const base64 = (base64Url + padding).replace(/-/g, '+').replace(/_/g, '/');
+      const rawData = atob(base64);
+      const outputArray = new Uint8Array(rawData.length);
+      for (let i = 0; i < rawData.length; ++i) {
+        outputArray[i] = rawData.charCodeAt(i);
+      }
+      return outputArray;
+    }
+
+    function bufferToBase64Url(buffer) {
+      if (!buffer) return null;
+      if (typeof buffer === 'string') return buffer;
+      const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+      let binary = '';
+      for (let i = 0; i < bytes.byteLength; i++) {
+        binary += String.fromCharCode(bytes[i]);
+      }
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function parsePublicKeyCreationOptions(rawOptions) {
+      const optionsJSON = rawOptions && rawOptions.publicKey ? rawOptions.publicKey : rawOptions;
+      if (
+        typeof window.PublicKeyCredential !== 'undefined' &&
+        typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function'
+      ) {
+        try {
+          return PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+        } catch (_) {
+          // Fall back to manual conversion if minimal options object was provided
+        }
+      }
+
+      const publicKey = { ...optionsJSON };
+      if (typeof publicKey.challenge === 'string') {
+        publicKey.challenge = base64UrlToUint8Array(publicKey.challenge);
+      }
+      if (publicKey.user && typeof publicKey.user.id === 'string') {
+        publicKey.user = {
+          ...publicKey.user,
+          id: base64UrlToUint8Array(publicKey.user.id),
+        };
+      }
+      if (Array.isArray(publicKey.excludeCredentials)) {
+        publicKey.excludeCredentials = publicKey.excludeCredentials.map((cred) => ({
+          ...cred,
+          id: typeof cred.id === 'string' ? base64UrlToUint8Array(cred.id) : cred.id,
+        }));
+      }
+      return publicKey;
+    }
+
+    function serializeCredential(credential) {
+      if (credential && typeof credential.toJSON === 'function') {
+        try {
+          return credential.toJSON();
+        } catch (_) {
+          // Fall back to manual serialization
+        }
+      }
+      const response = credential.response || {};
+      return {
+        id: credential.id,
+        rawId: bufferToBase64Url(credential.rawId) || credential.id,
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment || null,
+        clientExtensionResults:
+          typeof credential.getClientExtensionResults === 'function'
+            ? credential.getClientExtensionResults()
+            : {},
+        response: {
+          clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+          attestationObject: bufferToBase64Url(response.attestationObject),
+          transports:
+            typeof response.getTransports === 'function' ? response.getTransports() : undefined,
+        },
+      };
+    }
+
+    async function silentlyPromotePasskey(username) {
+      try {
+        if (
+          typeof window.PublicKeyCredential === 'undefined' ||
+          typeof PublicKeyCredential.getClientCapabilities !== 'function'
+        ) {
+          return;
+        }
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities || !capabilities.conditionalCreate) {
+          return;
+        }
+
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username }),
+        });
+
+        if (!optionsResponse.ok) {
+          return;
+        }
+
+        const rawOptions = await optionsResponse.json();
+        const publicKey = parsePublicKeyCreationOptions(rawOptions);
+
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional',
+        });
+
+        if (!credential) {
+          return;
+        }
+
+        const payload = serializeCredential(credential);
+
+        await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(payload),
+        });
+      } catch (_) {
+        // Silently ignore any errors in background conditional passkey creation
+      }
+    }
+
+    const signinForm = document.getElementById('signin-form');
+    if (signinForm) {
+      signinForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const usernameInput = document.getElementById('username');
+        const username = (usernameInput && usernameInput.value.trim()) || 'user';
+        silentlyPromotePasskey(username);
+      });
+    }
+  </script>
+
