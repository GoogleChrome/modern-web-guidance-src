+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorEl = document.getElementById('newsletter-error');
+      const successEl = document.getElementById('newsletter-success');
+
+      const ERROR_MESSAGE = 'Please enter a valid email address.';
+      let hasInteracted = false;
+
+      function isEmailValid() {
+        const val = emailInput.value.trim();
+        if (!val) return false;
+        return emailInput.validity.valid && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
+      }
+
+      function showError() {
+        emailInput.classList.add('is-invalid');
+        emailInput.setAttribute('aria-invalid', 'true');
+        if (errorEl.textContent !== ERROR_MESSAGE) {
+          errorEl.textContent = ERROR_MESSAGE;
+        }
+        errorEl.hidden = false;
+        if (successEl) {
+          successEl.textContent = '';
+          successEl.hidden = true;
+        }
+      }
+
+      function clearError() {
+        emailInput.classList.remove('is-invalid');
+        emailInput.setAttribute('aria-invalid', 'false');
+        errorEl.textContent = '';
+        errorEl.hidden = true;
+      }
+
+      function syncErrorState() {
+        if (!hasInteracted) {
+          clearError();
+          return;
+        }
+        if (isEmailValid()) {
+          clearError();
+        } else {
+          showError();
+        }
+      }
+
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('change', function () {
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('input', function () {
+        if (successEl && !successEl.hidden) {
+          successEl.textContent = '';
+          successEl.hidden = true;
+        }
+        if (hasInteracted) {
+          if (isEmailValid()) {
+            clearError();
+          } else {
+            showError();
+          }
+        }
+      });
+
+      emailInput.addEventListener('invalid', function (e) {
+        e.preventDefault();
+        hasInteracted = true;
+        showError();
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        hasInteracted = true;
+        if (!isEmailValid()) {
+          showError();
+          emailInput.focus();
+          return;
+        }
+        clearError();
+        if (successEl) {
+          successEl.textContent = 'Thank you for subscribing to The Daily Grind newsletter!';
+          successEl.hidden = false;
+        }
+        form.reset();
+        hasInteracted = false;
+      });
+    })();
+  </script>
+
