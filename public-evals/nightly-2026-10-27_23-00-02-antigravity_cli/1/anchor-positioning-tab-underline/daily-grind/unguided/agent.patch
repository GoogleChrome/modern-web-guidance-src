+  <script>
+    (function () {
+      const navList = document.querySelector('nav ul');
+      const indicator = document.querySelector('.nav-indicator');
+      const navLinks = Array.from(document.querySelectorAll('nav ul a:not(.logout-link)'));
+
+      function updateIndicator(targetLink) {
+        if (!targetLink || !indicator || !navList) return;
+        const listRect = navList.getBoundingClientRect();
+        const linkRect = targetLink.getBoundingClientRect();
+        const left = linkRect.width ? (linkRect.left - listRect.left) : targetLink.offsetLeft;
+        const width = linkRect.width || targetLink.offsetWidth;
+        indicator.style.left = `${left}px`;
+        indicator.style.width = `${width}px`;
+      }
+
+      function setActiveLink(selectedLink) {
+        navLinks.forEach((link) => {
+          const isSelected = link === selectedLink;
+          link.classList.toggle('active', isSelected);
+          if (link.parentElement) {
+            link.parentElement.classList.toggle('active', isSelected);
+          }
+          if (isSelected) {
+            link.setAttribute('aria-current', 'page');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+        updateIndicator(selectedLink);
+      }
+
+      navLinks.forEach((link) => {
+        const handleSelect = (event) => {
+          event.preventDefault();
+          setActiveLink(link);
+        };
+        link.addEventListener('click', handleSelect);
+        if (link.parentElement) {
+          link.parentElement.addEventListener('click', (event) => {
+            if (event.target === link.parentElement) {
+              handleSelect(event);
+            }
+          });
+        }
+      });
+
+      const initialActive = document.querySelector('nav ul a.active:not(.logout-link)') || navLinks[0];
+      updateIndicator(initialActive);
+
+      window.addEventListener('resize', () => {
+        const currentActive = document.querySelector('nav ul a.active:not(.logout-link)') || navLinks[0];
+        updateIndicator(currentActive);
+      });
+    })();
+  </script>
+
 </body>
 
