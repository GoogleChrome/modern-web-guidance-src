+  <script type="module">
+    const startDateInput = document.getElementById('startDateInput');
+    const yearsInput = document.getElementById('yearsInput');
+    const monthsInput = document.getElementById('monthsInput');
+    const overflowSelect = document.getElementById('overflowSelect');
+    const resultDate = document.getElementById('resultDate');
+    const plannerForm = document.getElementById('deliveryPlannerForm');
+
+    function updateDeliveryDate() {
+      if (typeof Temporal === 'undefined') {
+        return;
+      }
+
+      const startValue = startDateInput.value.trim();
+      const yearsValue = Number.parseInt(yearsInput.value, 10);
+      const monthsValue = Number.parseInt(monthsInput.value, 10);
+      const overflowStrategy = overflowSelect.value;
+
+      if (!startValue) {
+        resultDate.textContent = 'Error: Please enter a valid start date.';
+        resultDate.classList.add('error');
+        return;
+      }
+
+      const years = Number.isNaN(yearsValue) ? 0 : yearsValue;
+      const months = Number.isNaN(monthsValue) ? 0 : monthsValue;
+
+      try {
+        const startDate = Temporal.PlainDate.from(startValue, { overflow: 'reject' });
+        const nextDeliveryDate = startDate.add(
+          { years, months },
+          { overflow: overflowStrategy }
+        );
+        resultDate.textContent = nextDeliveryDate.toString();
+        resultDate.classList.remove('error');
+      } catch (err) {
+        resultDate.textContent = `Error: Invalid delivery date calculation (${err.message || 'date out of range for selected overflow strategy'}).`;
+        resultDate.classList.add('error');
+      }
+    }
+
+    function initializeApp() {
+      plannerForm.addEventListener('submit', (e) => e.preventDefault());
+      [startDateInput, yearsInput, monthsInput, overflowSelect].forEach((control) => {
+        control.addEventListener('input', updateDeliveryDate);
+        control.addEventListener('change', updateDeliveryDate);
+      });
+      updateDeliveryDate();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        try {
+          const module = await import('https://esm.sh/@js-temporal/polyfill');
+          globalThis.Temporal = module.Temporal;
+          Date.prototype.toTemporalInstant = module.toTemporalInstant;
+        } catch (err) {
+          resultDate.textContent = `Error: Failed to load Temporal polyfill (${err.message}).`;
+          resultDate.classList.add('error');
+          return;
+        }
+      }
+      initializeApp();
+    })();
+  </script>
