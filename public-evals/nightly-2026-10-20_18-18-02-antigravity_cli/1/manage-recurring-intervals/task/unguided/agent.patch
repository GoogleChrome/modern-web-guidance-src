+  <script type="module">
+    async function getTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') {
+        return globalThis.Temporal;
+      }
+      const { Temporal } = await import('https://esm.sh/@js-temporal/polyfill');
+      return Temporal;
+    }
+
+    async function initDeliveryPlanner() {
+      const startDateInput = document.getElementById('startDateInput');
+      const yearsInput = document.getElementById('yearsInput');
+      const monthsInput = document.getElementById('monthsInput');
+      const overflowSelect = document.getElementById('overflowSelect');
+      const resultDate = document.getElementById('resultDate');
+
+      let Temporal;
+      try {
+        Temporal = await getTemporal();
+      } catch (err) {
+        resultDate.textContent = `Error loading date library: ${err.message}`;
+        resultDate.classList.add('error');
+        return;
+      }
+
+      function updateCalculation() {
+        try {
+          const startDateValue = startDateInput.value.trim();
+          if (!startDateValue) {
+            throw new Error('Please enter a valid start date.');
+          }
+
+          const years = Number(yearsInput.value || 0);
+          const months = Number(monthsInput.value || 0);
+          const overflow = overflowSelect.value;
+
+          const startDate = Temporal.PlainDate.from(startDateValue, { overflow });
+          const duration = Temporal.Duration.from({ years, months });
+          const nextDeliveryDate = startDate.add(duration, { overflow });
+
+          resultDate.textContent = nextDeliveryDate.toString();
+          resultDate.classList.remove('error');
+        } catch (error) {
+          resultDate.textContent = `Error: ${error.message || 'Invalid date calculation for the selected overflow strategy.'}`;
+          resultDate.classList.add('error');
+        }
+      }
+
+      const controls = [startDateInput, yearsInput, monthsInput, overflowSelect];
+      controls.forEach((control) => {
+        control.addEventListener('input', updateCalculation);
+        control.addEventListener('change', updateCalculation);
+      });
+
+      updateCalculation();
+    }
+
+    initDeliveryPlanner();
+  </script>
