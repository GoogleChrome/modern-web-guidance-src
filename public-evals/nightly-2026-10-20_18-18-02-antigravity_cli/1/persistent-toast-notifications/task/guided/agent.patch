+    /* Toast Notifications */
+    .toast[popover] {
+      inset: auto 24px 24px auto;
+      margin: 0;
+      padding: 14px 18px;
+      background: var(--primary);
+      color: var(--light);
+      border: 1px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      align-items: center;
+      gap: 14px;
+      font-size: 0.95rem;
+      font-weight: 500;
+      pointer-events: auto;
+
+      /* Dynamic vertical stacking offset via sibling-index() */
+      --toast-step: 64px;
+      --toast-offset: calc((sibling-index() - 1) * var(--toast-step));
+
+      /* Base (closed / exit) state & top-layer discrete transitions */
+      opacity: 0;
+      transform: translateY(16px) scale(0.95);
+      transition-property: opacity, transform, margin-bottom, bottom, display, overlay;
+      transition-duration: 0.3s;
+      transition-timing-function: ease-out;
+      transition-behavior: allow-discrete;
+    }
+
+    /* Fallback spacing if sibling-index() is unsupported */
+    .toast[popover] + .toast[popover] {
+      margin-bottom: 64px;
+    }
+
+    @supports (bottom: calc(sibling-index() * 1px)) {
+      .toast[popover],
+      .toast[popover] + .toast[popover] {
+        margin-bottom: var(--toast-offset);
+      }
+    }
+
+    /* Visible (open) state with polyfill compatibility and exit fallback */
+    .toast[popover]:is(:popover-open, .\:popover-open):where(:not([data-closing])) {
+      display: flex;
+      opacity: 1;
+      transform: translateY(0) scale(1);
+
+      @starting-style {
+        opacity: 0;
+        transform: translateY(16px) scale(0.95);
+      }
+    }
+
+    .toast-close {
+      background: transparent;
+      border: none;
