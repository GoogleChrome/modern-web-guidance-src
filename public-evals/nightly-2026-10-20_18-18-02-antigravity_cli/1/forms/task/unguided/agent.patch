+        document.getElementById('summary-dob').textContent = birthDate;
+        document.getElementById('summary-mfa').textContent = mfaSelected ? mfaSelected.value : 'SMS Text Message';
+        document.getElementById('summary-store').textContent = homeStore || '-';
+        document.getElementById('summary-drink').textContent = drinkSelected ? drinkSelected.value : '-';
+        document.getElementById('summary-dietary').textContent = dietaryChecked.length > 0 ? dietaryChecked.join(', ') : 'None selected';
+      }
+
+      function goToStep(targetStep) {
+        currentStep = targetStep;
+
+        // Ensure password fields are masked when navigating away from step 2
+        if (currentStep !== 2) {
+          passwordInput.setAttribute('type', 'password');
+          confirmPasswordInput.setAttribute('type', 'password');
+        }
+
+        if (currentStep === 4) {
+          populateReviewSummary();
+        }
+
+        steps.forEach((stepEl, index) => {
+          const stepNum = index + 1;
+          const isActive = stepNum === currentStep;
+          stepEl.classList.toggle('active', isActive);
+          stepEl.hidden = !isActive;
+        });
+
+        stepIndicators.forEach((indicator, index) => {
+          const stepNum = index + 1;
+          const srPrefix = indicator.querySelector('.sr-only');
+          indicator.classList.remove('completed');
+          indicator.removeAttribute('aria-current');
+
+          if (stepNum < currentStep) {
+            indicator.classList.add('completed');
+            if (srPrefix) srPrefix.textContent = 'Completed step: ';
+          } else if (stepNum === currentStep) {
+            indicator.setAttribute('aria-current', 'step');
+            if (srPrefix) srPrefix.textContent = 'Current step: ';
+          } else {
+            if (srPrefix) srPrefix.textContent = 'Upcoming step: ';
+          }
+        });
+
+        prevBtn.hidden = currentStep === 1;
+        nextBtn.hidden = currentStep === totalSteps;
+        submitBtn.hidden = currentStep !== totalSteps;
+
+        const activeHeading = document.getElementById('step-' + currentStep + '-heading');
+        if (activeHeading) {
+          liveAnnouncer.textContent = activeHeading.textContent;
+          activeHeading.focus();
+        }
+      }
+
+      nextBtn.addEventListener('click', function () {
+        if (validateStep(currentStep) && currentStep < totalSteps) {
+          goToStep(currentStep + 1);
+        }
+      });
+
+      prevBtn.addEventListener('click', function () {
+        clearAlertBanner();
+        if (currentStep > 1) {
+          goToStep(currentStep - 1);
+        }
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+
+        // Security check: Honeypot bot trap
+        const honeypot = document.getElementById('website_url');
+        if (honeypot && honeypot.value.trim() !== '') {
+          return;
+        }
+
+        // Validate all steps before final submission
+        for (let s = 1; s <= totalSteps; s++) {
+          if (!validateStep(s)) {
+            if (currentStep !== s) {
+              goToStep(s);
+            }
+            return;
+          }
+        }
+
+        const firstName = document.getElementById('firstName').value.trim();
+
+        // Clear sensitive password fields immediately upon submission
+        passwordInput.value = '';
+        confirmPasswordInput.value = '';
+        updatePasswordChecklist();
+
+        // Disable form controls after successful registration
+        submitBtn.disabled = true;
+        prevBtn.hidden = true;
+
+        showAlertBanner(
+          'success',
+          'Welcome to The Daily Grind Rewards, ' + firstName + '! Your account has been securely created. Please check your email to verify your account.'
+        );
+      });
+    })();
+  </script>
