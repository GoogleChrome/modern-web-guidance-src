+  <script type="module">
+    // Sample coffee order trace events as received out of order from the central order-tracking backend.
+    // All timestamps are recorded by the server clock with nanosecond precision.
+    const rawOrderEvents = [
+      { orderId: 'ord-8492', service: 'payment-svc', eventType: 'payment.authorized', ts: '2026-04-01T12:00:00.000123890Z', detail: 'Card authorized for Maple Oat Latte' },
+      { orderId: 'ord-8492', service: 'api-gateway', eventType: 'order.received', ts: '2026-04-01T12:00:00.000123456Z', detail: 'Order submitted at counter kiosk' },
+      { orderId: 'ord-8492', service: 'barista-queue', eventType: 'drink.completed', ts: '2026-04-01T12:02:15.450000120Z', detail: 'Maple Oat Latte ready for pickup' },
+      { orderId: 'ord-8492', service: 'inventory-svc', eventType: 'beans.reserved', ts: '2026-04-01T12:00:00.000123512Z', detail: 'Reserved 18g espresso & oat milk' },
+      { orderId: 'ord-8492', service: 'barista-queue', eventType: 'ticket.dispatched', ts: '2026-04-01T12:00:00.004500000Z', detail: 'Sent to espresso bar station #2' },
+      { orderId: 'ord-8492', service: 'barista-queue', eventType: 'espresso.shot.pulled', ts: '2026-04-01T12:00:28.120000000Z', detail: 'Double shot extracted (28s pull)' },
+    ];
+
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+    }
+
+    function formatInterval(duration) {
+      const balanced = duration.round({ largestUnit: 'hours' });
+
+      if (typeof duration.toLocaleString === 'function' && typeof Intl !== 'undefined' && typeof Intl.DurationFormat !== 'undefined') {
+        return balanced.toLocaleString('en-US', { style: 'narrow' });
+      }
+
+      if (typeof Intl !== 'undefined' && typeof Intl.DurationFormat !== 'undefined') {
+        const formatter = new Intl.DurationFormat('en-US', { style: 'narrow' });
+        return formatter.format({
+          hours: balanced.hours,
+          minutes: balanced.minutes,
+          seconds: balanced.seconds,
+          milliseconds: balanced.milliseconds,
+          microseconds: balanced.microseconds,
+          nanoseconds: balanced.nanoseconds,
+        });
+      }
+
+      // Manual fallback extracting balanced Temporal.Duration unit properties
+      const units = [
+        ['hours', 'h'],
+        ['minutes', 'm'],
+        ['seconds', 's'],
+        ['milliseconds', 'ms'],
+        ['microseconds', 'μs'],
+        ['nanoseconds', 'ns'],
+      ];
+      const parts = [];
+      for (const [prop, label] of units) {
+        const val = balanced[prop];
+        if (val > 0) {
+          parts.push(`${val}${label}`);
+        }
+      }
+      return parts.length > 0 ? parts.join(' ') : '0s';
+    }
+
+    function sequenceEvents(events) {
+      return [...events].sort((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+    }
+
+    async function loadAndAnalyzeSampleTrace() {
+      const btn = document.getElementById('load-trace-btn');
+      const outputContainer = document.getElementById('trace-output');
+      const traceList = document.getElementById('trace-list');
+
+      btn.disabled = true;
+      try {
+        await ensureTemporal();
+
+        // 1. Parse recorded timestamps as Temporal.Instant (preserves full nanosecond precision)
+        const parsedEvents = rawOrderEvents.map((evt) => ({
+          ...evt,
+          timestamp: Temporal.Instant.from(evt.ts),
+        }));
+
+        // 2. Sort chronologically using Temporal.Instant.compare() to preserve sub-millisecond ordering
+        const sortedEvents = sequenceEvents(parsedEvents);
+
+        traceList.replaceChildren();
+
+        // 3. Log events in chronological order and log the time between consecutive events
+        for (let i = 0; i < sortedEvents.length; i++) {
+          const curr = sortedEvents[i];
+          const isoTimestamp = curr.timestamp.toString();
+          const li = document.createElement('li');
+          li.className = 'trace-item';
+
+          console.log(`[${isoTimestamp}] (${curr.service}) ${curr.eventType} — ${curr.detail}`);
+
+          if (i > 0) {
+            const prev = sortedEvents[i - 1];
+            const isSimultaneous = curr.timestamp.equals(prev.timestamp);
+            const gap = curr.timestamp.since(prev.timestamp);
+            const humanReadableGap = isSimultaneous ? '0s (simultaneous)' : formatInterval(gap);
+
+            console.log(`${prev.eventType} → ${curr.eventType}: ${humanReadableGap}`);
+
+            const intervalDiv = document.createElement('div');
+            intervalDiv.className = 'trace-interval';
+            intervalDiv.textContent = `↳ +${humanReadableGap} (${prev.eventType} → ${curr.eventType})`;
+            li.appendChild(intervalDiv);
+          }
+
+          const eventDiv = document.createElement('div');
+          eventDiv.textContent = `[${isoTimestamp}] (${curr.service}) ${curr.eventType} — ${curr.detail}`;
+          li.appendChild(eventDiv);
+          traceList.appendChild(li);
+        }
+
+        outputContainer.hidden = false;
+      } finally {
+        btn.disabled = false;
+      }
+    }
+
+    document.getElementById('load-trace-btn').addEventListener('click', loadAndAnalyzeSampleTrace);
+  </script>
 </body>
 
