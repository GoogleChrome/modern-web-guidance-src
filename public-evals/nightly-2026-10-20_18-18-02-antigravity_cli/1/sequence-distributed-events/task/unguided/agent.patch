+  <script>
+    // Sample out-of-order trace of coffee order events with nanosecond-precision ISO 8601 timestamps
+    const SAMPLE_ORDER_TRACE = [
+      {
+        orderId: "ORD-2026-0401",
+        event: "Espresso extraction started",
+        timestamp: "2026-04-01T12:00:12.340500100Z"
+      },
+      {
+        orderId: "ORD-2026-0401",
+        event: "Payment authorization verified",
+        timestamp: "2026-04-01T12:00:00.000450120Z"
+      },
+      {
+        orderId: "ORD-2026-0401",
+        event: "Order ready for pickup",
+        timestamp: "2026-04-01T12:01:45.890123456Z"
+      },
+      {
+        orderId: "ORD-2026-0401",
+        event: "Barista queue event published",
+        timestamp: "2026-04-01T12:00:00.015230485Z"
+      },
+      {
+        orderId: "ORD-2026-0401",
+        event: "Order payload validated",
+        timestamp: "2026-04-01T12:00:00.000123890Z"
+      },
+      {
+        orderId: "ORD-2026-0401",
+        event: "Order received by gateway",
+        timestamp: "2026-04-01T12:00:00.000123456Z"
+      },
+      {
+        orderId: "ORD-2026-0401",
+        event: "Order persisted to ledger",
+        timestamp: "2026-04-01T12:00:00.015230400Z"
+      }
+    ];
+
+    const durationFormatter = new Intl.DurationFormat("en", { style: "long" });
+
+    function loadAndLogSampleTrace() {
+      // Parse each timestamp into a Temporal.Instant to preserve full nanosecond precision
+      const sortedEvents = SAMPLE_ORDER_TRACE
+        .map((entry) => ({
+          ...entry,
+          instant: Temporal.Instant.from(entry.timestamp)
+        }))
+        .sort((a, b) => Temporal.Instant.compare(a.instant, b.instant));
+
+      const traceLogEl = document.getElementById("trace-log");
+      traceLogEl.innerHTML = "";
+      traceLogEl.hidden = false;
+
+      sortedEvents.forEach((entry, index) => {
+        let elapsedText = "Initial event";
+
+        if (index > 0) {
+          const previousInstant = sortedEvents[index - 1].instant;
+          const elapsedDuration = entry.instant.since(previousInstant, {
+            largestUnit: "hour"
+          });
+          elapsedText = durationFormatter.format(elapsedDuration);
+          console.log(
+            `[${index + 1}] ${entry.timestamp} - ${entry.event} (+${elapsedText} since previous event)`
+          );
+        } else {
+          console.log(`[${index + 1}] ${entry.timestamp} - ${entry.event} (${elapsedText})`);
+        }
+
+        const li = document.createElement("li");
+        li.className = "trace-item";
+        li.innerHTML = `
+          <div class="trace-meta">${entry.timestamp}</div>
+          <div><strong>${entry.event}</strong> (${entry.orderId})</div>
+          <div class="trace-delta">${index > 0 ? `+${elapsedText} since previous event` : elapsedText}</div>
+        `;
+        traceLogEl.appendChild(li);
+      });
+
+      return sortedEvents;
+    }
+
+    document
+      .getElementById("load-trace-btn")
+      .addEventListener("click", loadAndLogSampleTrace);
+  </script>
 </body>
 
