+  <script>
+    (function initHeroWebGLRipple() {
+      const hero = document.getElementById('hero');
+      const canvas = document.getElementById('hero-webgl-canvas');
+      const titleEl = document.getElementById('hero-title');
+      const ctaEl = document.getElementById('hero-cta');
+
+      if (!hero || !canvas || !titleEl || !ctaEl) return;
+
+      const gl = canvas.getContext('webgl', { alpha: true, antialias: true, premultipliedAlpha: false });
+      if (!gl) return;
+
+      const vertexShaderSource = `
+        attribute vec2 a_position;
+        attribute vec2 a_texCoord;
+        varying vec2 v_texCoord;
+        void main() {
+          gl_Position = vec4(a_position, 0.0, 1.0);
+          v_texCoord = a_texCoord;
+        }
+      `;
+
+      const fragmentShaderSource = `
+        precision highp float;
+        varying vec2 v_texCoord;
+        uniform sampler2D u_texture;
+        uniform vec2 u_resolution;
+        uniform float u_time;
+        uniform vec2 u_mouse;
+        uniform float u_hoverStrength;
+        uniform vec3 u_ripples[8];
+
+        void main() {
+          vec2 uv = v_texCoord;
+          float aspect = u_resolution.x / max(u_resolution.y, 1.0);
+          vec2 aspectScale = vec2(aspect, 1.0);
+
+          // Subtle ambient wave across the HTML content
+          vec2 offset = vec2(
+            sin(uv.y * 18.0 + u_time * 2.4) * 0.0025,
+            cos(uv.x * 18.0 + u_time * 2.0) * 0.0025
+          );
+
+          // Interactive cursor ripple distortion
+          vec2 toMouse = (uv - u_mouse) * aspectScale;
+          float mouseDist = length(toMouse);
+          float mouseInfluence = smoothstep(0.38, 0.0, mouseDist) * u_hoverStrength;
+          vec2 mouseDir = mouseDist > 0.0001 ? normalize(toMouse) : vec2(0.0);
+          float mouseWave = sin(mouseDist * 45.0 - u_time * 9.0) * 0.014 * mouseInfluence;
+          offset += mouseDir * mouseWave / aspectScale;
+
+          // Expanding click / pointer ripples
+          for (int i = 0; i < 8; i++) {
+            vec3 r = u_ripples[i];
+            if (r.z > 0.0) {
+              float age = u_time - r.z;
+              if (age > 0.0 && age < 2.2) {
+                vec2 toRipple = (uv - r.xy) * aspectScale;
+                float dist = length(toRipple);
+                float waveRadius = age * 0.45;
+                float ring = exp(-pow((dist - waveRadius) * 18.0, 2.0));
+                float decay = exp(-age * 2.2);
+                vec2 dir = dist > 0.0001 ? normalize(toRipple) : vec2(0.0);
+                float wave = sin((dist - waveRadius) * 65.0) * ring * decay * 0.022;
+                offset += dir * wave / aspectScale;
+              }
+            }
+          }
+
+          // Subtle chromatic dispersion along the ripple vector
+          float chroma = length(offset) * 0.28;
+          vec4 colR = texture2D(u_texture, clamp(uv + offset * (1.0 + chroma), 0.0, 1.0));
+          vec4 colG = texture2D(u_texture, clamp(uv + offset, 0.0, 1.0));
+          vec4 colB = texture2D(u_texture, clamp(uv + offset * (1.0 - chroma), 0.0, 1.0));
+
+          float alpha = max(max(colR.a, colG.a), colB.a);
+          gl_FragColor = vec4(colR.r, colG.g, colB.b, alpha);
+        }
+      `;
+
+      function compileShader(type, source) {
+        const shader = gl.createShader(type);
+        gl.shaderSource(shader, source);
+        gl.compileShader(shader);
+        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
+          console.error('Shader compile error:', gl.getShaderInfoLog(shader));
+          gl.deleteShader(shader);
+          return null;
+        }
+        return shader;
+      }
+
+      const vs = compileShader(gl.VERTEX_SHADER, vertexShaderSource);
+      const fs = compileShader(gl.FRAGMENT_SHADER, fragmentShaderSource);
+      if (!vs || !fs) return;
+
+      const program = gl.createProgram();
+      gl.attachShader(program, vs);
+      gl.attachShader(program, fs);
+      gl.linkProgram(program);
+      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
+        console.error('Program link error:', gl.getProgramInfoLog(program));
+        return;
+      }
+      gl.useProgram(program);
+
+      // Full-screen quad with UV coordinates (top-left = 0,0)
+      const quadVertices = new Float32Array([
+        -1.0,  1.0,  0.0, 0.0,
+         1.0,  1.0,  1.0, 0.0,
+        -1.0, -1.0,  0.0, 1.0,
+        -1.0, -1.0,  0.0, 1.0,
+         1.0,  1.0,  1.0, 0.0,
+         1.0, -1.0,  1.0, 1.0
+      ]);
+
+      const buffer = gl.createBuffer();
+      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
+      gl.bufferData(gl.ARRAY_BUFFER, quadVertices, gl.STATIC_DRAW);
+
+      const aPosition = gl.getAttribLocation(program, 'a_position');
+      const aTexCoord = gl.getAttribLocation(program, 'a_texCoord');
+      gl.enableVertexAttribArray(aPosition);
+      gl.vertexAttribPointer(aPosition, 2, gl.FLOAT, false, 16, 0);
+      gl.enableVertexAttribArray(aTexCoord);
+      gl.vertexAttribPointer(aTexCoord, 2, gl.FLOAT, false, 16, 8);
+
+      const uTexture = gl.getUniformLocation(program, 'u_texture');
+      const uResolution = gl.getUniformLocation(program, 'u_resolution');
+      const uTime = gl.getUniformLocation(program, 'u_time');
+      const uMouse = gl.getUniformLocation(program, 'u_mouse');
+      const uHoverStrength = gl.getUniformLocation(program, 'u_hoverStrength');
+      const uRipples = gl.getUniformLocation(program, 'u_ripples');
+
+      const texture = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+
+      // Offscreen 2D canvas that rasterizes the exact DOM layout for 'Wake Up Your Senses' and 'Order Now'
+      const domCanvas = document.createElement('canvas');
+      const domCtx = domCanvas.getContext('2d');
+
+      let isButtonHovered = false;
+      ctaEl.addEventListener('mouseenter', () => {
+        isButtonHovered = true;
+        updateDOMTexture();
+      });
+      ctaEl.addEventListener('mouseleave', () => {
+        isButtonHovered = false;
+        updateDOMTexture();
+      });
+
+      function drawRoundedRect(ctx, x, y, w, h, r) {
+        const radius = Math.min(r, w / 2, h / 2);
+        ctx.beginPath();
+        ctx.moveTo(x + radius, y);
+        ctx.arcTo(x + w, y, x + w, y + h, radius);
+        ctx.arcTo(x + w, y + h, x, y + h, radius);
+        ctx.arcTo(x, y + h, x, y, radius);
+        ctx.arcTo(x, y, x + w, y, radius);
+        ctx.closePath();
+      }
+
+      function updateDOMTexture() {
+        const dpr = Math.min(window.devicePixelRatio || 1, 2);
+        const heroRect = hero.getBoundingClientRect();
+        const width = Math.max(1, Math.round(heroRect.width));
+        const height = Math.max(1, Math.round(heroRect.height));
+
+        canvas.width = Math.round(width * dpr);
+        canvas.height = Math.round(height * dpr);
+        gl.viewport(0, 0, canvas.width, canvas.height);
+
+        domCanvas.width = canvas.width;
+        domCanvas.height = canvas.height;
+
+        domCtx.save();
+        domCtx.scale(dpr, dpr);
+        domCtx.clearRect(0, 0, width, height);
+
+        // Render 'Wake Up Your Senses' heading matching its live DOM coordinates & typography
+        const titleRect = titleEl.getBoundingClientRect();
+        const titleStyle = window.getComputedStyle(titleEl);
+        const titleX = (titleRect.left - heroRect.left) + titleRect.width / 2;
+        const titleY = (titleRect.top - heroRect.top) + titleRect.height / 2;
+
+        domCtx.font = `${titleStyle.fontWeight} ${titleStyle.fontSize} ${titleStyle.fontFamily}`;
+        domCtx.fillStyle = '#ffffff';
+        domCtx.textAlign = 'center';
+        domCtx.textBaseline = 'middle';
+        domCtx.fillText(titleEl.textContent.trim(), titleX, titleY);
+
+        // Render 'Order Now' button matching its live DOM box & typography
+        const ctaRect = ctaEl.getBoundingClientRect();
+        const ctaStyle = window.getComputedStyle(ctaEl);
+        const btnX = ctaRect.left - heroRect.left;
+        const btnY = ctaRect.top - heroRect.top;
+        const btnRadius = parseFloat(ctaStyle.borderRadius) || 5;
+
+        drawRoundedRect(domCtx, btnX, btnY, ctaRect.width, ctaRect.height, btnRadius);
+        domCtx.fillStyle = isButtonHovered ? '#3e2723' : '#4e342e';
+        domCtx.fill();
+
+        domCtx.font = `${ctaStyle.fontWeight} ${ctaStyle.fontSize} ${ctaStyle.fontFamily}`;
+        domCtx.fillStyle = '#ffffff';
+        domCtx.textAlign = 'center';
+        domCtx.textBaseline = 'middle';
+        domCtx.fillText(
+          ctaEl.textContent.trim(),
+          btnX + ctaRect.width / 2,
+          btnY + ctaRect.height / 2
+        );
+
+        domCtx.restore();
+
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, domCanvas);
+      }
+
+      // Activate WebGL overlay mode so the underlying DOM text/button stay selectable & clickable
+      hero.classList.add('webgl-active');
+      updateDOMTexture();
+
+      window.addEventListener('resize', updateDOMTexture);
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(updateDOMTexture);
+      }
+
+      // Pointer & ripple state
+      let mouseX = 0.5;
+      let mouseY = 0.5;
+      let targetMouseX = 0.5;
+      let targetMouseY = 0.5;
+      let hoverStrength = 0.0;
+      let targetHoverStrength = 0.0;
+
+      const MAX_RIPPLES = 8;
+      const ripples = new Float32Array(MAX_RIPPLES * 3);
+      let rippleIndex = 0;
+      const startTime = performance.now();
+
+      function getCurrentTimeSeconds() {
+        return (performance.now() - startTime) * 0.001;
+      }
+
+      function spawnRipple(uvX, uvY) {
+        const base = rippleIndex * 3;
+        ripples[base] = uvX;
+        ripples[base + 1] = uvY;
+        ripples[base + 2] = getCurrentTimeSeconds();
+        rippleIndex = (rippleIndex + 1) % MAX_RIPPLES;
+      }
+
+      let lastMoveRippleTime = 0;
+      hero.addEventListener('pointermove', (e) => {
+        const rect = hero.getBoundingClientRect();
+        targetMouseX = (e.clientX - rect.left) / Math.max(rect.width, 1);
+        targetMouseY = (e.clientY - rect.top) / Math.max(rect.height, 1);
+        targetHoverStrength = 1.0;
+
+        const now = performance.now();
+        if (now - lastMoveRippleTime > 120) {
+          spawnRipple(targetMouseX, targetMouseY);
+          lastMoveRippleTime = now;
+        }
+      });
+
+      hero.addEventListener('pointerleave', () => {
+        targetHoverStrength = 0.0;
+      });
+
+      hero.addEventListener('pointerdown', (e) => {
+        const rect = hero.getBoundingClientRect();
+        const x = (e.clientX - rect.left) / Math.max(rect.width, 1);
+        const y = (e.clientY - rect.top) / Math.max(rect.height, 1);
+        spawnRipple(x, y);
+      });
+
+      // Seed an initial gentle ripple on load
+      spawnRipple(0.5, 0.45);
+
+      gl.enable(gl.BLEND);
+      gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
+
+      function render() {
+        const elapsed = getCurrentTimeSeconds();
+
+        mouseX += (targetMouseX - mouseX) * 0.12;
+        mouseY += (targetMouseY - mouseY) * 0.12;
+        hoverStrength += (targetHoverStrength - hoverStrength) * 0.08;
+
+        gl.clearColor(0.0, 0.0, 0.0, 0.0);
+        gl.clear(gl.COLOR_BUFFER_BIT);
+
+        gl.useProgram(program);
+        gl.uniform1i(uTexture, 0);
+        gl.uniform2f(uResolution, canvas.width, canvas.height);
+        gl.uniform1f(uTime, elapsed);
+        gl.uniform2f(uMouse, mouseX, mouseY);
+        gl.uniform1f(uHoverStrength, hoverStrength);
+        gl.uniform3fv(uRipples, ripples);
+
+        gl.drawArrays(gl.TRIANGLES, 0, 6);
+        requestAnimationFrame(render);
+      }
+
+      requestAnimationFrame(render);
+    })();
+  </script>
 </body>
 
