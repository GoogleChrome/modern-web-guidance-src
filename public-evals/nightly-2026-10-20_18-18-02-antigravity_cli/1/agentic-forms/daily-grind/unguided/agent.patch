+        address: '412 E Pike St, Seattle, WA 98102',
+        hours: '6:00 AM - 7:00 PM',
+        amenities: ['wifi', 'patio', 'roastery']
+      },
+      {
+        name: 'Downtown Pike Place Express',
+        city: 'Seattle',
+        zip: '98101',
+        address: '1024 1st Ave, Seattle, WA 98101',
+        hours: '5:30 AM - 6:00 PM',
+        amenities: ['wifi', 'drive-thru']
+      },
+      {
+        name: 'Pearl District Coffee House',
+        city: 'Portland',
+        zip: '97209',
+        address: '850 NW 13th Ave, Portland, OR 97209',
+        hours: '6:30 AM - 6:30 PM',
+        amenities: ['wifi', 'patio']
+      },
+      {
+        name: 'Bellevue Way Drive-Thru',
+        city: 'Bellevue',
+        zip: '98004',
+        address: '520 Bellevue Way NE, Bellevue, WA 98004',
