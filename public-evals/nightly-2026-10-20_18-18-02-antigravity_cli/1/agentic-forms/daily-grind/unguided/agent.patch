+
+    function showResult(elementId, htmlContent) {
+      const el = document.getElementById(elementId);
+      if (el) {
+        el.innerHTML = htmlContent;
+        el.classList.add('visible');
+      }
+    }
+
+    function replyToAgent(event, payload) {
+      if (event && typeof event.respondWith === 'function') {
+        event.respondWith(Promise.resolve(payload));
+      }
+    }
+
+    // 1. Search Menu Handler
+    document.getElementById('search-menu-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(event.target);
+      const query = (data.get('query') || '').toString().trim().toLowerCase();
+      const category = (data.get('category') || 'all').toString();
+      const dietary = (data.get('dietary') || 'any').toString();
+
+      const matches = MENU_CATALOG.filter((item) => {
+        const matchesQuery = !query ||
+          item.name.toLowerCase().includes(query) ||
+          item.description.toLowerCase().includes(query);
+        const matchesCategory = category === 'all' || item.category === category;
+        const matchesDietary = dietary === 'any' || item.dietary.includes(dietary);
+        return matchesQuery && matchesCategory && matchesDietary;
+      });
+
+      const listHtml = matches.length
+        ? '<strong>Matching Menu Items (' + matches.length + '):</strong><ul style="margin-top:6px;padding-left:18px;">' +
+          matches.map(m => '<li><strong>' + m.name + '</strong> ($' + m.price.toFixed(2) + ') &mdash; ' + m.description + '</li>').join('') +
+          '</ul>'
+        : '<em>No menu items matched your filters.</em>';
+
+      showResult('search-menu-result', listHtml);
+      replyToAgent(event, {
+        status: 'success',
+        tool: 'search_menu',
+        count: matches.length,
+        items: matches
+      });
+    });
+
+    // 2. Order Coffee Handler
+    document.getElementById('order-coffee-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(event.target);
+      const drink = data.get('drink') || 'Maple Oat Latte';
+      const size = data.get('size') || 'Medium';
+      const milk = data.get('milk') || 'Oat Milk';
+      const temperature = data.get('temperature') || 'Hot';
+      const quantity = Math.max(1, parseInt(data.get('quantity') || '1', 10));
+      const customerName = data.get('customer_name') || appState.user.full_name;
+      const instructions = data.get('special_instructions') || '';
+
+      const menuEntry = MENU_CATALOG.find(i => i.name === drink) || { price: 5.00 };
+      const sizeAdjustment = size === 'Large' ? 0.75 : (size === 'Small' ? -0.50 : 0);
+      const unitPrice = menuEntry.price + sizeAdjustment;
+      const total = +(unitPrice * quantity).toFixed(2);
+      const orderId = 'DG-' + Math.floor(1000 + Math.random() * 9000);
+
+      const orderRecord = {
+        orderId,
+        drink,
+        size,
+        milk,
+        temperature,
+        quantity,
+        customerName,
+        instructions,
+        total,
+        estimatedPickupMinutes: 10
+      };
+      appState.orders.push(orderRecord);
+
+      showResult(
+        'order-coffee-result',
+        '<strong>Order Confirmed (' + orderId + ')!</strong><br>' +
+        quantity + 'x ' + size + ' ' + temperature + ' ' + drink + ' (' + milk + ') for <strong>' + customerName + '</strong>.<br>' +
+        (instructions ? 'Notes: ' + instructions + '<br>' : '') +
+        'Total: <strong>$' + total.toFixed(2) + '</strong> &bull; Ready in ~10 mins.'
+      );
+
+      replyToAgent(event, {
+        status: 'success',
+        tool: 'order_coffee',
+        order: orderRecord
+      });
+    });
+
+    // 3. Find Locations Handler
+    document.getElementById('find-locations-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(event.target);
+      const query = (data.get('location_query') || '').toString().trim().toLowerCase();
+      const amenity = (data.get('amenity') || 'any').toString();
+
+      let matches = STORE_LOCATIONS.filter((loc) => {
+        const matchesLoc = !query ||
+          loc.city.toLowerCase().includes(query) ||
+          loc.zip.includes(query) ||
+          loc.name.toLowerCase().includes(query) ||
+          loc.address.toLowerCase().includes(query);
+        const matchesAmenity = amenity === 'any' || loc.amenities.includes(amenity);
+        return matchesLoc && matchesAmenity;
+      });
+
+      if (matches.length === 0 && amenity === 'any') {
+        matches = STORE_LOCATIONS;
+      }
+
+      const html = matches.length
+        ? '<strong>Found ' + matches.length + ' location(s):</strong><ul style="margin-top:6px;padding-left:18px;">' +
+          matches.map(l => '<li><strong>' + l.name + '</strong> &mdash; ' + l.address + ' (' + l.hours + ')</li>').join('') +
+          '</ul>'
+        : '<em>No locations found matching those criteria.</em>';
+
+      showResult('find-locations-result', html);
+      replyToAgent(event, {
+        status: 'success',
+        tool: 'find_locations',
+        count: matches.length,
+        locations: matches
+      });
+    });
+
+    // 4. Rewards Handler
+    document.getElementById('rewards-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(event.target);
+      const email = (data.get('email') || appState.user.email).toString();
+      const action = (data.get('action') || 'check_balance').toString();
+
+      let message = '';
+      let rewardStatus = 'success';
+
+      if (action === 'redeem_free_drink') {
+        if (appState.user.points >= 100) {
+          appState.user.points -= 100;
+          message = 'Redeemed 100 points for a Free Handcrafted Drink! Remaining balance: ' + appState.user.points + ' pts.';
+        } else {
+          rewardStatus = 'insufficient_points';
+          message = 'Not enough points to redeem a free drink (need 100 pts, have ' + appState.user.points + ' pts).';
+        }
+      } else if (action === 'redeem_pastry') {
+        if (appState.user.points >= 50) {
+          appState.user.points -= 50;
+          message = 'Redeemed 50 points for an Artisanal Pastry! Remaining balance: ' + appState.user.points + ' pts.';
+        } else {
+          rewardStatus = 'insufficient_points';
+          message = 'Not enough points to redeem a pastry (need 50 pts, have ' + appState.user.points + ' pts).';
+        }
+      } else {
+        message = 'Rewards Member <strong>' + email + '</strong> has <strong>' + appState.user.points + ' points</strong> available.';
+      }
+
+      showResult('rewards-result', message);
+      replyToAgent(event, {
+        status: rewardStatus,
+        tool: 'manage_rewards',
+        email,
+        action,
+        pointsBalance: appState.user.points,
+        message
+      });
+    });
+
+    // 5. Account Settings Handler
+    document.getElementById('account-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(event.target);
+      appState.user.full_name = (data.get('full_name') || appState.user.full_name).toString();
+      appState.user.email = (data.get('email') || appState.user.email).toString();
+      appState.user.favorite_drink = (data.get('favorite_drink') || appState.user.favorite_drink).toString();
+      appState.user.notifications = (data.get('notifications') || appState.user.notifications).toString();
+
+      showResult(
+        'account-result',
+        '<strong>Account Updated!</strong><br>Name: ' + appState.user.full_name +
+        ' &bull; Favorite: ' + appState.user.favorite_drink +
+        ' &bull; Alerts: ' + appState.user.notifications
+      );
+
+      replyToAgent(event, {
+        status: 'success',
+        tool: 'update_account',
+        user: { ...appState.user }
+      });
+    });
+
+    // 6. Contact Us Handler
+    document.getElementById('contact-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(event.target);
+      const senderName = data.get('sender_name') || '';
+      const senderEmail = data.get('sender_email') || '';
+      const topic = data.get('topic') || 'feedback';
+      const message = data.get('message') || '';
+      const ticketId = 'TKT-' + Math.floor(10000 + Math.random() * 90000);
+
+      showResult(
+        'contact-result',
+        '<strong>Message Sent (Ticket ' + ticketId + ')!</strong><br>Thanks, ' + senderName +
+        '. Our team will reply to <em>' + senderEmail + '</em> regarding <strong>' + topic + '</strong> shortly.'
+      );
+
+      replyToAgent(event, {
+        status: 'success',
+        tool: 'contact_support',
+        ticketId,
+        senderName,
+        senderEmail,
+        topic,
+        message
+      });
+    });
+
+    // 7. Logout Handler
+    document.getElementById('nav-logout-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      appState.loggedIn = false;
+      const btn = event.target.querySelector('button[type="submit"]');
+      if (btn) {
+        btn.textContent = 'Logged Out';
+      }
+      replyToAgent(event, {
+        status: 'success',
+        tool: 'logout_user',
+        loggedIn: false,
+        message: 'User has been logged out.'
+      });
+    });
+
+    // 8. Quick Order / View Details Card Handlers
+    document.querySelectorAll('.quick-order-form').forEach((form) => {
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const data = new FormData(event.target);
+        const drinkName = (data.get('drink') || 'Maple Oat Latte').toString();
+        const drinkSelect = document.getElementById('order-drink');
+        if (drinkSelect) {
+          drinkSelect.value = drinkName;
+          drinkSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
