+        id: 'vanilla-bean-cortado',
+        name: 'Vanilla Bean Cortado',
+        category: 'espresso',
+        price: 4.50,
+        dietary: [],
+        description: 'Equal parts rich espresso and steamed milk infused with Madagascar vanilla.'
+      },
+      {
+        id: 'matcha-green-tea-latte',
+        name: 'Matcha Green Tea Latte',
+        category: 'seasonal',
+        price: 5.25,
+        dietary: ['vegan', 'dairy-free'],
