+  <script>
+    const drawer = document.getElementById('nav-drawer');
+    const menuToggle = document.querySelector('.menu-toggle');
+    const dismissZone = drawer.querySelector('.drawer-dismiss-zone');
+
+    // Sync scroll position and ARIA state when the popover toggles
+    drawer.addEventListener('toggle', (event) => {
+      const isOpen = event.newState === 'open';
+      menuToggle.setAttribute('aria-expanded', String(isOpen));
+      if (isOpen) {
+        // Snap immediately to the drawer panel on open so the user can swipe it away
+        drawer.scrollLeft = drawer.scrollWidth;
+      }
+    });
+
+    // Tapping the exposed backdrop area closes the drawer
+    dismissZone.addEventListener('click', () => {
+      drawer.hidePopover();
+    });
+
+    // Close the popover once the user natively swipes the drawer away to the dismiss snap point
+    const finishSwipeCheck = () => {
+      if (drawer.matches(':popover-open') && drawer.scrollLeft <= 10) {
+        drawer.hidePopover();
+      }
+    };
+
+    if ('onscrollend' in window) {
+      drawer.addEventListener('scrollend', finishSwipeCheck);
+    } else {
+      let scrollTimer;
+      drawer.addEventListener('scroll', () => {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(finishSwipeCheck, 100);
+      }, { passive: true });
+    }
+  </script>
