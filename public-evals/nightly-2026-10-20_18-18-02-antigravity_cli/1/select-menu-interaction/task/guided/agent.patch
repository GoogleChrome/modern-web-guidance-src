+  <script>
+    const orderForm = document.getElementById('order-form');
+
+    // Sync aria-invalid with the CSS :user-invalid state or validity state
+    const syncAria = (el) => {
+      if (!el || typeof el.matches !== 'function') return;
+      if (CSS.supports('selector(:user-invalid)')) {
+        if (el.matches(':user-invalid')) {
+          el.setAttribute('aria-invalid', 'true');
+        } else {
+          el.removeAttribute('aria-invalid');
+        }
+      } else if (el.checkValidity) {
+        if (!el.checkValidity()) {
+          el.setAttribute('aria-invalid', 'true');
+        } else {
+          el.removeAttribute('aria-invalid');
+        }
+      }
+    };
+
+    // Update ARIA state on blur, input/change, invalid, and submit
+    orderForm.addEventListener('blur', (e) => {
+      if (e.target.matches('[required]')) {
+        syncAria(e.target);
+      }
+    }, true);
+
+    orderForm.addEventListener('input', (e) => {
+      if (e.target.matches('[required]')) {
+        syncAria(e.target);
+      }
+    });
+
+    orderForm.addEventListener('change', (e) => {
+      if (e.target.matches('[required]')) {
+        syncAria(e.target);
+      }
+    });
+
+    orderForm.addEventListener('invalid', (e) => {
+      e.target.setAttribute('aria-invalid', 'true');
+    }, true);
+
+    orderForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const submitBtn = orderForm.querySelector('button[type="submit"]');
+      if (submitBtn) {
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Starting Order...';
+      }
+    });
+  </script>
+
