+      color: var(--primary);
+      font-size: 1.5rem;
+      margin-bottom: 12px;
+    }
+
+    #animated {
+      position: sticky;
+      top: 15vh;
+      height: 70vh;
+      display: grid;
+      place-items: center;
+      perspective: 1000px;
+      overflow: hidden;
+      border-radius: 12px;
+      background: var(--secondary);
+      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
+    }
+
+    #animated section {
+      grid-area: 1 / 1;
+      width: 85%;
+      height: 85%;
+      background: white;
+      border-radius: 10px;
+      overflow: hidden;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
+      display: flex;
+      flex-direction: column;
+      backface-visibility: hidden;
+    }
+
+    #animated section img {
+      width: 100%;
+      height: 75%;
+      object-fit: cover;
+    }
+
+    #animated section .caption {
+      padding: 15px;
+      text-align: center;
+      font-weight: bold;
+      color: var(--primary);
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      flex: 1;
+    }
+
+    @keyframes animate-in {
+      from {
+        scale: 0.5;
+        opacity: 0;
+        transform: rotateY(-180deg);
+      }
+      to {
+        scale: 1;
+        opacity: 1;
+        transform: rotateY(0deg);
+      }
+    }
+
+    @keyframes animate-out {
+      to {
+        translate: 100% 0;
+        opacity: 0;
+      }
+    }
+
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      #tracked {
+        section:nth-child(1) { view-timeline: --tl-1 block; }
+        section:nth-child(2) { view-timeline: --tl-2 block; }
+        section:nth-child(3) { view-timeline: --tl-3 block; }
+        section:nth-child(4) { view-timeline: --tl-4 block; }
+        section:nth-child(5) { view-timeline: --tl-5 block; }
+      }
+
+      #animated {
+        section {
+          animation: animate-in auto linear both, animate-out auto linear forwards;
+          animation-range: entry 25% cover 50%, exit 50% exit 75%;
+          backface-visibility: hidden;
+        }
+
+        section:nth-child(1) { animation-timeline: --tl-1; }
+        section:nth-child(2) { animation-timeline: --tl-2; }
+        section:nth-child(3) { animation-timeline: --tl-3; }
+        section:nth-child(4) { animation-timeline: --tl-4; }
+        section:nth-child(5) { animation-timeline: --tl-5; }
+      }
+    }
+
+    /* MANDATORY Copy-Paste Safety: Disable continuous storytelling motion for sensitive users */
+    @media (prefers-reduced-motion: reduce) {
+      #animated {
+        position: static;
+        height: auto;
+        gap: 20px;
+        padding: 20px;
+      }
+
+      #animated section {
+        grid-area: auto;
+        width: 100%;
+        height: 300px;
+        animation: none !important;
+        opacity: 1 !important;
+        transform: none !important;
+        translate: 0 0 !important;
+      }
+    }
+
