+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      if (!CSS.supports("appearance", "base-select")) {
+        // Custom select overrides are not supported natively; degrades gracefully to native OS select.
+        return;
+      }
+
+      const roastSelect = document.getElementById("roast-picker");
+      if (!roastSelect) return;
+
+      // Support Left/Right spatial keyboard navigation across the 3-column grid picker
+      roastSelect.addEventListener("keydown", (e) => {
+        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
+        const options = Array.from(roastSelect.querySelectorAll("option"));
+        const active = document.activeElement;
+        const currentIndex = options.indexOf(active);
+        if (currentIndex === -1) return;
+
+        const activeRect = active.getBoundingClientRect();
+        if (activeRect.width === 0) return;
+
+        const dir = e.key === "ArrowRight" ? 1 : -1;
+        const candidates = options
+          .filter((opt) => opt !== active)
+          .map((opt) => ({ opt, rect: opt.getBoundingClientRect() }))
+          .filter(({ rect }) => (rect.left - activeRect.left) * dir > 0)
+          .sort((a, b) => Math.abs(a.rect.left - activeRect.left) - Math.abs(b.rect.left - activeRect.left));
+
+        if (candidates.length > 0) {
+          e.preventDefault();
+          candidates[0].opt.focus();
+        }
+      });
+    });
+  </script>
