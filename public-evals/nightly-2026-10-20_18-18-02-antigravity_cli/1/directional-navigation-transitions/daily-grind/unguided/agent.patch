+  <script>
+    (function () {
+      const cards = Array.from(document.querySelectorAll('.carousel-viewport .card'));
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      const statusEl = document.getElementById('carousel-status');
+      const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let currentIndex = 0;
+
+      function showItem(newIndex, direction) {
+        cards.forEach((card, index) => {
+          card.classList.remove('active', 'slide-in-right', 'slide-in-left');
+          card.setAttribute('aria-hidden', index === newIndex ? 'false' : 'true');
+        });
+
+        const nextCard = cards[newIndex];
+        // Force reflow so repeating animations in the same direction re-trigger cleanly
+        void nextCard.offsetWidth;
+
+        nextCard.classList.add('active');
+        if (!reducedMotionQuery.matches) {
+          if (direction === 'next') {
+            nextCard.classList.add('slide-in-right');
+          } else if (direction === 'prev') {
+            nextCard.classList.add('slide-in-left');
+          }
+        }
+
+        currentIndex = newIndex;
+        if (statusEl) {
+          statusEl.textContent = `${currentIndex + 1} / ${cards.length}`;
+        }
+      }
+
+      prevBtn.addEventListener('click', () => {
+        const newIndex = (currentIndex - 1 + cards.length) % cards.length;
+        showItem(newIndex, 'prev');
+      });
+
+      nextBtn.addEventListener('click', () => {
+        const newIndex = (currentIndex + 1) % cards.length;
+        showItem(newIndex, 'next');
+      });
+
+      // Initialize aria-hidden attributes
+      cards.forEach((card, index) => {
+        card.setAttribute('aria-hidden', index === currentIndex ? 'false' : 'true');
+      });
+    })();
+  </script>
