+  <script>
+    const viewport = document.getElementById('favorites-viewport');
+    const cards = Array.from(viewport.querySelectorAll('.card'));
+    const prevBtn = document.getElementById('prev-btn');
+    const nextBtn = document.getElementById('next-btn');
+    let currentIndex = 0;
+
+    function navigate(updateDOM, direction) {
+      if ('startViewTransition' in Element.prototype) {
+        const transition = viewport.startViewTransition({
+          update: updateDOM,
+          types: [direction]
+        });
+        transition.ready.catch(() => {});
+        return;
+      }
+
+      if (!document.startViewTransition) {
+        updateDOM();
+        return;
+      }
+
+      const transition = document.startViewTransition({
+        update: updateDOM,
+        types: [direction]
+      });
+      transition.ready.catch(() => {});
+    }
+
+    function showCard(newIndex, direction) {
+      navigate(() => {
+        cards[currentIndex].hidden = true;
+        currentIndex = newIndex;
+        cards[currentIndex].hidden = false;
+      }, direction);
+    }
+
+    nextBtn.addEventListener('click', () => {
+      const nextIndex = (currentIndex + 1) % cards.length;
+      showCard(nextIndex, 'forward');
+    });
+
+    prevBtn.addEventListener('click', () => {
+      const prevIndex = (currentIndex - 1 + cards.length) % cards.length;
+      showCard(prevIndex, 'backward');
+    });
+  </script>
+
