+import React, { useState, useEffect } from 'react';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStoryItem {
+  id: string;
+  title: string;
+  dateFormatted: string;
+  href: string;
+}
+
+interface TopStoriesSliderProps {
+  stories: TopStoryItem[];
+}
+
+export default function TopStoriesSlider({ stories }: TopStoriesSliderProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [prevIndex, setPrevIndex] = useState<number | null>(null);
+  const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+  const [prefersReducedMotion, setPrefersReducedMotion] = useState(false);
+
+  useEffect(() => {
+    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+    setPrefersReducedMotion(mediaQuery.matches);
+
+    const handleChange = (e: MediaQueryListEvent) => {
+      setPrefersReducedMotion(e.matches);
+    };
+
+    mediaQuery.addEventListener('change', handleChange);
+    return () => mediaQuery.removeEventListener('change', handleChange);
+  }, []);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const handleSlide = (dir: 'next' | 'prev') => {
+    if (stories.length <= 1) return;
+
+    const nextIdx =
+      dir === 'next'
+        ? (currentIndex + 1) % stories.length
+        : (currentIndex - 1 + stories.length) % stories.length;
+
+    if (prefersReducedMotion) {
+      setPrevIndex(null);
+      setDirection(null);
+      setCurrentIndex(nextIdx);
+    } else {
+      setPrevIndex(currentIndex);
+      setDirection(dir);
+      setCurrentIndex(nextIdx);
+    }
+  };
+
+  const handleAnimationEnd = () => {
+    setPrevIndex(null);
+    setDirection(null);
+  };
+
+  return (
+    <section
+      aria-label="Top Stories"
+      className="bg-white border-b border-gray-300"
+    >
+      <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
+        <div className="flex items-center justify-between gap-4">
+          <button
+            type="button"
+            onClick={() => handleSlide('prev')}
+            aria-label="Previous story"
+            className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded transition-colors cursor-pointer shrink-0"
+          >
+            <ChevronLeftIcon className="w-4 h-4" />
+            <span>Previous</span>
+          </button>
+
+          <div
+            className="relative flex-1 overflow-hidden"
+            aria-live="polite"
+            aria-atomic="true"
+          >
+            <div className="grid grid-cols-1">
+              {prevIndex !== null && !prefersReducedMotion && stories[prevIndex] && (
+                <div
+                  key={`prev-${stories[prevIndex].id}-${currentIndex}`}
+                  aria-hidden="true"
+                  className={`col-start-1 row-start-1 flex flex-col justify-center text-center px-2 pointer-events-none ${
+                    direction === 'next'
+                      ? 'top-story-slide-out-left'
+                      : 'top-story-slide-out-right'
+                  }`}
+                >
+                  <a
+                    href={stories[prevIndex].href}
+                    tabIndex={-1}
+                  >
+                    <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">
+                      {stories[prevIndex].title}
+                    </h3>
+                  </a>
+                  <span className="text-xs text-gray-500">
+                    {stories[prevIndex].dateFormatted}
+                  </span>
+                </div>
+              )}
+
+              <div
+                key={`curr-${stories[currentIndex].id}-${currentIndex}`}
+                onAnimationEnd={handleAnimationEnd}
+                className={`col-start-1 row-start-1 flex flex-col justify-center text-center px-2 ${
+                  !prefersReducedMotion && direction === 'next'
+                    ? 'top-story-slide-in-right'
+                    : !prefersReducedMotion && direction === 'prev'
+                    ? 'top-story-slide-in-left'
+                    : ''
+                }`}
+              >
+                <a href={stories[currentIndex].href}>
+                  <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">
+                    {stories[currentIndex].title}
+                  </h3>
+                </a>
+                <span className="text-xs text-gray-500">
+                  {stories[currentIndex].dateFormatted}
+                </span>
+              </div>
+            </div>
+          </div>
+
+          <button
+            type="button"
+            onClick={() => handleSlide('next')}
+            aria-label="Next story"
+            className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded transition-colors cursor-pointer shrink-0"
+          >
+            <span>Next</span>
+            <ChevronRightIcon className="w-4 h-4" />
+          </button>
+        </div>
+      </div>
+    </section>
+  );
+}
