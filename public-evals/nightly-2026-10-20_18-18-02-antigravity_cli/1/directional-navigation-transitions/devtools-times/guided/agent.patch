+import React, { useState, useRef } from 'react';
+import { flushSync } from 'react-dom';
+import { ChevronLeftIcon, ChevronRightIcon } from '@heroicons/react/24/outline';
+
+export interface TopStoryItem {
+  id: string;
+  title: string;
+  dateFormatted: string;
+  category?: string;
+}
+
+interface TopStoriesSliderProps {
+  stories: TopStoryItem[];
+  baseUrl?: string;
+}
+
+export default function TopStoriesSlider({ stories, baseUrl = '/' }: TopStoriesSliderProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [fallbackDir, setFallbackDir] = useState<'forward' | 'backward' | null>(null);
+  const scopeRef = useRef<HTMLDivElement>(null);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const navigate = (direction: 'forward' | 'backward') => {
+    const nextIndex =
+      direction === 'forward'
+        ? (currentIndex + 1) % stories.length
+        : (currentIndex - 1 + stories.length) % stories.length;
+
+    const updateDOM = () => {
+      flushSync(() => {
+        setCurrentIndex(nextIndex);
+      });
+    };
+
+    const scopeEl = scopeRef.current as (HTMLDivElement & {
+      startViewTransition?: (options: { update: () => void; types: string[] } | (() => void)) => { ready: Promise<void> };
+    }) | null;
+
+    // Prefer element-scoped view transitions so external fixed elements/popovers and concurrent transitions stay unaffected
+    if (scopeEl && 'startViewTransition' in Element.prototype && typeof scopeEl.startViewTransition === 'function') {
+      setFallbackDir(null);
+      const transition = scopeEl.startViewTransition({
+        update: updateDOM,
+        types: [direction],
+      });
+      transition.ready.catch(() => {});
+      return;
+    }
+
+    // Fallback: apply the DOM update immediately without animation
+    setFallbackDir(direction);
+    updateDOM();
+  };
+
+  const currentStory = stories[currentIndex];
+  const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const fallbackClass =
+    fallbackDir === 'forward'
+      ? 'slide-in-right'
+      : fallbackDir === 'backward'
+        ? 'slide-in-left'
+        : '';
+
+  return (
+    <section aria-label="Top Stories" className="bg-white border-b border-gray-300">
+      <div className="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
+        <div className="flex items-center justify-between gap-4">
+          <button
+            type="button"
+            onClick={() => navigate('backward')}
+            aria-label="Previous story"
+            className="flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 hover:text-gray-900 rounded transition-colors shrink-0 cursor-pointer"
+          >
+            <ChevronLeftIcon className="w-4 h-4" aria-hidden="true" />
+            <span>Previous</span>
+          </button>
+
+          <div
+            ref={scopeRef}
+            className="top-stories-viewport flex-1 overflow-hidden text-center px-2"
+            aria-live="polite"
+            aria-atomic="true"
+          >
+            <div key={currentStory.id} className={`py-1 ${fallbackClass}`}>
+              <a
+                href={`${normalizedBaseUrl}articles/${currentStory.id}`}
+                className="inline-block"
+              >
+                <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer text-base sm:text-lg">
+                  {currentStory.title}
+                </h3>
+              </a>
+              <div className="text-xs text-gray-500 mt-0.5">
+                <span>{currentStory.dateFormatted}</span>
+                <span className="mx-2" aria-hidden="true">•</span>
+                <span>
+                  {currentIndex + 1} / {stories.length}
+                </span>
+              </div>
+            </div>
+          </div>
+
+          <button
+            type="button"
+            onClick={() => navigate('forward')}
+            aria-label="Next story"
+            className="flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 hover:text-gray-900 rounded transition-colors shrink-0 cursor-pointer"
+          >
+            <span>Next</span>
+            <ChevronRightIcon className="w-4 h-4" aria-hidden="true" />
+          </button>
+        </div>
+      </div>
+    </section>
+  );
+}
