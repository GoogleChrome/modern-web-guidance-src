+  <script>
+    const detectBtn = document.getElementById('detect-btn');
+    const feedbackTextarea = document.getElementById('feedback-message');
+    const feedbackResult = document.getElementById('feedback-result');
+
+    let detectorInstance = null;
+
+    detectBtn.addEventListener('click', async () => {
+      const text = feedbackTextarea.value.trim();
+      if (!text) {
+        feedbackResult.textContent = 'Please enter a message to detect the language.';
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        feedbackResult.textContent = 'Language Detector API is not supported in this browser.';
+        return;
+      }
+
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable' || availability === 'no') {
+          feedbackResult.textContent = 'Language detection is currently unavailable.';
+          return;
+        }
+
+        if (!detectorInstance) {
+          if (availability === 'available' || availability === 'readily') {
+            detectorInstance = await LanguageDetector.create();
+          } else {
+            detectorInstance = await LanguageDetector.create({
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const percent = Math.round(e.loaded * 100);
+                  feedbackResult.textContent = `Downloading model: ${percent}%`;
+                });
+              }
+            });
+          }
+        }
+
+        const results = await detectorInstance.detect(text);
+        if (results && results.length > 0) {
+          const topResult = results[0];
+          const languageTag = topResult.detectedLanguage;
+          const confidence = Math.round(topResult.confidence * 100);
+
+          let languageName = languageTag;
+          try {
+            const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+            languageName = displayNames.of(languageTag) || languageTag;
+          } catch (err) {
+            // Fallback to the raw language tag if Intl.DisplayNames fails
+          }
+
+          feedbackResult.textContent = `Detected language: ${languageName} (${confidence}% confidence)`;
+        } else {
+          feedbackResult.textContent = 'Could not detect the language.';
+        }
+      } catch (error) {
+        feedbackResult.textContent = `Error: ${error.message}`;
+      }
+    });
+  </script>
