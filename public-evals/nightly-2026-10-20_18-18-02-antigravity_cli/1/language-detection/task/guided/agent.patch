+  <script>
+    (async () => {
+      const detectBtn = document.getElementById('detect-btn');
+      const feedbackInput = document.getElementById('feedback-message');
+      const resultOutput = document.getElementById('detection-result');
+
+      // Check if the LanguageDetector API is supported in the global scope
+      if (!('LanguageDetector' in self)) {
+        detectBtn.disabled = true;
+        resultOutput.textContent = 'Language detection is not supported in this browser.';
+        return;
+      }
+
+      // Check if the model is available or downloadable
+      let availability;
+      try {
+        availability = await LanguageDetector.availability();
+      } catch (error) {
+        detectBtn.disabled = true;
+        resultOutput.textContent = 'Unable to check language detection availability.';
+        return;
+      }
+
+      if (availability === 'unavailable') {
+        detectBtn.disabled = true;
+        resultOutput.textContent = 'Language detection model is unavailable on this device.';
+        return;
+      }
+
+      const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+      let detector = null;
+
+      detectBtn.addEventListener('click', async () => {
+        const text = feedbackInput.value.trim();
+        if (!text) {
+          resultOutput.textContent = 'Please enter a message to detect its language.';
+          return;
+        }
+
+        detectBtn.disabled = true;
+        try {
+          if (!detector) {
+            resultOutput.textContent = 'Preparing language detector...';
+            detector = await LanguageDetector.create({
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const percent = Math.round(e.loaded * 100);
+                  resultOutput.textContent = `Downloading language model: ${percent}%`;
+                });
+              },
+            });
+          }
+
+          resultOutput.textContent = 'Detecting language...';
+          const results = await detector.detect(text);
+
+          if (!results || results.length === 0) {
+            resultOutput.textContent = 'Could not determine the language.';
+            return;
+          }
+
+          const topResult = results[0];
+          const languageCode = topResult.detectedLanguage;
+          let languageName = languageCode;
+          try {
+            languageName = displayNames.of(languageCode) || languageCode;
+          } catch {
+            // Fall back to raw code if Intl.DisplayNames cannot format the tag
+          }
+
+          const confidencePercent = (topResult.confidence * 100).toFixed(1);
+          resultOutput.textContent = `Detected Language: ${languageName} (${confidencePercent}% confidence)`;
+        } catch (error) {
+          resultOutput.textContent = `Error detecting language: ${error.message || 'Unknown error'}`;
+        } finally {
+          detectBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
