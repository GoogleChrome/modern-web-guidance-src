+      // Client-side navigation handler instrumented with contentfulPerf
+      function navigateTo(toPath, triggerEvent = null) {
+        const fromPath = state.currentPath;
+        state.currentPath = toPath;
+
+        window.contentfulPerf.startOperation({
+          type: 'client-navigation',
+          name: `${fromPath} → ${toPath}`,
+          event: triggerEvent,
+          fromPath,
+          toPath,
+          targetDescriptor: `a[href="${toPath}"]`
+        });
+
+        try {
+          if (window.location.pathname !== toPath) {
+            window.history.pushState({ path: toPath }, '', toPath);
+          }
+        } catch (_) {}
+
+        renderRouteView(toPath);
+      }
+
+      // Intercept clicks on navigation links and interactive controls
+      document.addEventListener('click', (event) => {
+        if (event.target.closest && event.target.closest('[data-perf-ignore="true"]')) {
+          return;
+        }
+
+        // 1. Handle client-side route navigation links
+        const link = event.target.closest('a[href]');
+        if (link && link.getAttribute('href').startsWith('/')) {
+          event.preventDefault();
+          const targetPath = link.getAttribute('href');
+          navigateTo(targetPath, event);
+          return;
+        }
+
+        // 2. Handle Order Tray toggle button in nav
+        if (event.target.closest('#nav-cart-btn')) {
+          state.orderTrayOpen = !state.orderTrayOpen;
