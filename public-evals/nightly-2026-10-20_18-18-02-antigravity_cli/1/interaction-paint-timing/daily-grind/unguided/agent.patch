+  <script>
+    /**
+     * ============================================================================
+     * 1. CONTENTFUL RENDER TIMING MONITOR
+     * Measures the time it takes for user interactions and client-side navigations
+     * to render new contentful updates (DOM mutation + next frame paint + images)
+     * on screen.
+     * ============================================================================
+     */
+    (function initContentfulTimingSystem() {
+      const STORAGE_KEY = 'daily_grind_contentful_timings_v1';
+      const entries = [];
+      const listeners = new Set();
+      let activePendingOp = null;
+      let opCounter = 0;
+
+      // Helper: Compute percentile from numeric array
+      function percentile(values, p) {
+        if (!values.length) return 0;
+        const sorted = [...values].sort((a, b) => a - b);
+        const idx = Math.min(sorted.length - 1, Math.max(0, Math.ceil((p / 100) * sorted.length) - 1));
+        return Number(sorted[idx].toFixed(2));
+      }
+
+      // Helper: Determine whether a DOM node represents contentful UI outside the telemetry HUD
+      function isIgnoredNode(node) {
+        if (!node) return true;
+        const el = node.nodeType === Node.ELEMENT_NODE ? node : node.parentElement;
+        if (!el) return true;
+        return Boolean(el.closest && el.closest('[data-perf-ignore="true"]'));
+      }
+
+      function inspectContentfulMutations(mutationList) {
+        let addedElements = 0;
+        let textUpdates = 0;
+        const pendingImages = [];
+
+        for (const mutation of mutationList) {
+          if (isIgnoredNode(mutation.target)) continue;
+
+          if (mutation.type === 'childList') {
+            for (const node of mutation.addedNodes) {
+              if (isIgnoredNode(node)) continue;
+              if (node.nodeType === Node.ELEMENT_NODE) {
+                addedElements += 1 + node.querySelectorAll('*').length;
+                if ((node.textContent || '').trim().length > 0) {
+                  textUpdates += 1;
+                }
+                if (node.tagName === 'IMG') {
+                  pendingImages.push(node);
+                } else if (node.querySelectorAll) {
+                  node.querySelectorAll('img').forEach((img) => pendingImages.push(img));
+                }
+              } else if (node.nodeType === Node.TEXT_NODE && (node.textContent || '').trim().length > 0) {
+                textUpdates += 1;
+              }
+            }
+          } else if (mutation.type === 'characterData') {
+            if ((mutation.target.textContent || '').trim().length > 0) {
+              textUpdates += 1;
+            }
+          } else if (mutation.type === 'attributes') {
+            if (mutation.target.nodeType === Node.ELEMENT_NODE) {
+              addedElements += 1;
+              if (mutation.target.tagName === 'IMG' && mutation.attributeName === 'src') {
+                pendingImages.push(mutation.target);
+              }
+            }
+          }
+        }
+
+        const isContentful = addedElements > 0 || textUpdates > 0 || pendingImages.length > 0;
+        return { isContentful, addedElements, textUpdates, pendingImages };
+      }
+
+      // Wait until the browser has painted the next frame onto the screen
+      function waitForNextFramePaint(callback) {
+        requestAnimationFrame(() => {
+          const prePaintTime = performance.now();
+          // Scheduling via both rAF and macrotask captures the earliest post-paint moment
+          let settled = false;
+          const finish = () => {
+            if (settled) return;
+            settled = true;
+            callback({ prePaintTime, paintTime: performance.now() });
+          };
+          requestAnimationFrame(finish);
+          setTimeout(finish, 0);
+        });
+      }
+
+      // Wait for any newly inserted <img> elements in the contentful update to load
+      function waitForImagesToSettle(images, timeoutMs = 4000) {
+        const uniqueImgs = Array.from(new Set(images)).filter((img) => img && img.isConnected);
+        if (uniqueImgs.length === 0) {
+          return Promise.resolve({ imageCount: 0, loadedImages: 0 });
+        }
+
