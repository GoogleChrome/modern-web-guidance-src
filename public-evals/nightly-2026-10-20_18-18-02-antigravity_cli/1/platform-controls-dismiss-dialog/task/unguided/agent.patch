+  <script>
+    const coffeeData = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        description: 'Creamy oat milk with a hint of Vermont maple syrup, paired with our signature double-shot espresso and topped with a light dusting of cinnamon.',
+        extra: 'Tasting Notes: Warm maple, toasted oats, sweet spice • Calories: 180 • Price: $5.50'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        description: 'Bold, smokey, and perfect for a morning boost. Roasted in small batches from high-altitude Arabica beans for a rich crema and full-bodied finish.',
+        extra: 'Tasting Notes: Dark chocolate, roasted walnut, smoky caramel • Calories: 10 • Price: $3.75'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        description: 'Steeped in cool filtered water for 18 hours for maximum smoothness and naturally low acidity. Served over artisanal ice.',
+        extra: 'Tasting Notes: Cocoa nibs, molasses, velvety finish • Calories: 15 • Price: $4.50'
+      }
+    };
+
+    const modal = document.getElementById('coffee-modal');
+    const modalTitle = document.getElementById('coffee-modal-title');
+    const modalDescription = document.getElementById('coffee-modal-description');
+    const modalExtra = document.getElementById('coffee-modal-extra');
+    const closeBtn = document.getElementById('close-modal-btn');
+
+    document.querySelectorAll('.show-details-btn').forEach((button) => {
+      button.addEventListener('click', () => {
+        const key = button.getAttribute('data-coffee');
+        const details = coffeeData[key];
+        if (details) {
+          modalTitle.textContent = details.title;
+          modalDescription.textContent = details.description;
+          modalExtra.textContent = details.extra;
+          modal.showModal();
+        }
+      });
+    });
+
+    closeBtn.addEventListener('click', () => {
+      modal.close();
+    });
+
+    // Light-dismiss when clicking outside the modal box
+    modal.addEventListener('click', (event) => {
+      if (event.target === modal) {
+        modal.close();
+      }
+    });
+  </script>
+
