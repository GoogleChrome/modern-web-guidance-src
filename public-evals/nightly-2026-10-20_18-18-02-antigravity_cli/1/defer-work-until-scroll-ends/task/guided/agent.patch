+  <script>
+    const scroller = document.querySelector('#scroller');
+    const statusEl = document.querySelector('#status');
+    const originItems = scroller.querySelectorAll('.origin-item');
+    let isScrolling = false;
+
+    function findMostVisibleSection(container) {
+      const containerRect = container.getBoundingClientRect();
+      let mostVisibleOrigin = '';
+      let maxVisibleHeight = -1;
+
+      originItems.forEach((item) => {
+        const itemRect = item.getBoundingClientRect();
+        const visibleTop = Math.max(containerRect.top, itemRect.top);
+        const visibleBottom = Math.min(containerRect.bottom, itemRect.bottom);
+        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+        if (visibleHeight > maxVisibleHeight) {
+          maxVisibleHeight = visibleHeight;
+          mostVisibleOrigin = item.dataset.origin || item.querySelector('h3').textContent;
+        }
+      });
+
+      return mostVisibleOrigin;
+    }
+
+    function initializeScrollTracking() {
+      // 1. Lightweight informative feedback during scroll
+      scroller.addEventListener('scroll', () => {
+        if (!isScrolling) {
+          isScrolling = true;
+          statusEl.textContent = 'Scrolling...';
+        }
+      }, { passive: true });
+
+      // 2. Defer layout calculations until scrolling rests
+      scroller.addEventListener('scrollend', () => {
+        isScrolling = false;
+        const currentVisibleOrigin = findMostVisibleSection(scroller);
+        statusEl.textContent = `Scroll ended. Visible: ${currentVisibleOrigin}`;
+      });
+    }
+
+    if ('onscrollend' in window) {
+      initializeScrollTracking();
+    } else {
+      initializeScrollTracking();
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(window.scrollendtimer);
+        window.scrollendtimer = setTimeout(() => {
+          scroller.dispatchEvent(new CustomEvent('scrollend'));
+        }, 100);
+      }, { passive: true });
+    }
+  </script>
