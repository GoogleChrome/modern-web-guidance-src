+  <script>
+    const scroller = document.getElementById('scroller');
+    const statusEl = document.getElementById('status');
+    const originCards = Array.from(scroller.querySelectorAll('.origin-card'));
+
+    let isScrolling = false;
+
+    function getMostVisibleOrigin() {
+      const scrollerRect = scroller.getBoundingClientRect();
+      let bestOrigin = '';
+      let maxVisibleHeight = -1;
+
+      for (const card of originCards) {
+        const rect = card.getBoundingClientRect();
+        const visibleTop = Math.max(rect.top, scrollerRect.top);
+        const visibleBottom = Math.min(rect.bottom, scrollerRect.bottom);
+        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+        if (visibleHeight > maxVisibleHeight) {
+          maxVisibleHeight = visibleHeight;
+          bestOrigin = card.dataset.origin || card.querySelector('h3').textContent.trim();
+        }
+      }
+
+      return bestOrigin;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      if (!isScrolling) {
+        isScrolling = true;
+        statusEl.textContent = 'Scrolling...';
+      }
+    }, { passive: true });
+
+    scroller.addEventListener('scrollend', () => {
+      isScrolling = false;
+      const visibleOrigin = getMostVisibleOrigin();
+      statusEl.textContent = `Scroll ended. Visible: ${visibleOrigin}`;
+    }, { passive: true });
+  </script>
