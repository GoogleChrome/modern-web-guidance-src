+    /* Roast Selector (Customizable Select) */
+    .roast-selector {
+      margin-top: 1.5rem;
+      margin-bottom: 0.5rem;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 0.5rem;
+      text-align: left;
+    }
+
+    .roast-selector label {
+      font-size: 0.9rem;
+      font-weight: 600;
+      text-transform: uppercase;
+      letter-spacing: 1.5px;
+      color: var(--secondary);
+    }
+
+    select.roast-select,
+    select.roast-select::picker(select) {
+      appearance: base-select;
+    }
+
+    select.roast-select {
+      background: rgba(255, 255, 255, 0.95);
+      color: var(--text);
+      border: 2px solid var(--accent);
+      border-radius: 8px;
+      padding: 10px 16px;
+      min-width: 300px;
+      cursor: pointer;
+      font-family: inherit;
+      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
+      transition: border-color 0.2s, transform 0.2s, background-color 0.2s;
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 12px;
+    }
+
+    select.roast-select:hover {
+      background: #ffffff;
+      border-color: #ffd180;
+    }
+
+    select.roast-select:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    select.roast-select > button {
+      display: flex;
+      align-items: center;
+      width: 100%;
+      background: none;
+      border: none;
+      padding: 0;
+      font: inherit;
+      color: inherit;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    select.roast-select::picker(select) {
+      background: #ffffff;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+      padding: 6px;
+      margin-top: 6px;
+      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
+    }
+
+    select.roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 12px;
+      border-radius: 6px;
+      cursor: pointer;
+      transition: background-color 0.15s;
+    }
+
+    select.roast-select option:hover,
+    select.roast-select option:focus {
+      background-color: #f5ebe6;
+    }
+
+    select.roast-select option:checked {
+      background-color: var(--secondary);
+      font-weight: 500;
+    }
+
+    .roast-option-content,
+    select.roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+    }
+
+    .roast-icon {
+      width: 28px;
+      height: 28px;
+      flex-shrink: 0;
+      color: var(--primary);
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      background: #efebe9;
+      border-radius: 50%;
+      padding: 5px;
+    }
+
+    .roast-details {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+      text-align: left;
+    }
+
+    .roast-title {
+      font-weight: 700;
+      font-size: 0.95rem;
+      color: var(--primary);
+    }
+
+    .roast-desc {
+      font-size: 0.8rem;
+      color: #6d4c41;
+    }
+
