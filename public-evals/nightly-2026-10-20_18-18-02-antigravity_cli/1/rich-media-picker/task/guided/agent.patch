+      appearance: base-select;
+    }
+
+    select.roast-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      padding: 12px 16px;
+      background-color: rgba(62, 39, 35, 0.9);
+      border: 1px solid var(--accent);
+      border-radius: 8px;
+      color: var(--light);
+      font-family: inherit;
+      font-size: 1rem;
+      cursor: pointer;
+      text-align: left;
+    }
+
+    select.roast-select::picker-icon {
+      color: var(--accent);
+    }
+
+    select.roast-select selectedcontent {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+    }
+
+    select.roast-select selectedcontent .option-desc {
+      display: none;
+    }
+
+    select.roast-select::picker(select) {
+      background-color: #2d1b17;
+      border: 1px solid var(--accent);
+      border-radius: 8px;
+      padding: 8px;
+      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
+      width: anchor-size(width);
+      color: var(--light);
+    }
+
+    select.roast-select option {
+      display: flex;
+      align-items: center;
+      gap: 12px;
+      padding: 10px 12px;
+      border-radius: 6px;
+      cursor: pointer;
+      color: var(--light);
+      text-align: left;
+    }
+
+    select.roast-select option:hover {
+      background-color: var(--primary);
+    }
+
+    select.roast-select option::before,
+    select.roast-select option::checkmark {
+      display: none;
+    }
+
+    select.roast-select option:checked {
+      background-color: var(--accent);
+      color: var(--text);
+    }
+
+    select.roast-select option:checked .option-title {
+      font-weight: 700;
+    }
+
+    select.roast-select option:checked .option-desc {
+      color: var(--primary);
+    }
+
+    .option-text {
+      display: flex;
+      flex-direction: column;
+      line-height: 1.3;
+    }
+
+    .option-title {
+      font-size: 1rem;
+      font-weight: 500;
+    }
+
+    .option-desc {
+      font-size: 0.8rem;
+      color: var(--secondary);
+    }
+
