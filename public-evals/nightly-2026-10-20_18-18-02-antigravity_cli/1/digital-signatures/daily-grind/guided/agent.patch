+    const payloadInput = document.getElementById('payload-input');
+    const signBtn = document.getElementById('sign-btn');
+    const verifyBtn = document.getElementById('verify-btn');
+    const publicKeyOutput = document.getElementById('public-key-output');
+    const signatureOutput = document.getElementById('signature-output');
+    const verificationResult = document.getElementById('verification-result');
+
+    let currentSigningKey = null;
+
+    function showStatus(message, isValid) {
+      verificationResult.hidden = false;
+      verificationResult.textContent = message;
+      verificationResult.className = `status-badge ${isValid ? 'valid' : 'invalid'}`;
+    }
+
+    const pqSupported = supportsPostQuantumSignatures('ML-DSA-65');
+    activeSuiteStatus.textContent = pqSupported
+      ? 'Post-quantum ML-DSA supported natively via SubtleCrypto.supports()'
+      : 'ML-DSA unavailable in this runtime; using Ed25519 classical fallback';
+
+    generateKeyBtn.addEventListener('click', async () => {
+      try {
+        const preferred = suiteSelect.value;
+        const { suite, keyFormat, keyPair, publicKeyBytes } = await generateSigningKeyPair(preferred);
+        currentSigningKey = keyPair.privateKey;
+        publicKeyOutput.value = bytesToHex(publicKeyBytes);
+        signatureOutput.value = '';
+        verificationResult.hidden = true;
+        signBtn.disabled = false;
+        verifyBtn.disabled = false;
+        activeSuiteStatus.textContent = `Active suite: ${suite} (exported as '${keyFormat}', ${publicKeyBytes.byteLength} bytes)`;
+      } catch (err) {
+        showStatus(`Key generation failed: ${err.message}`, false);
+      }
+    });
+
+    signBtn.addEventListener('click', async () => {
+      try {
+        if (!currentSigningKey) {
+          throw new Error('Generate a signing key pair first.');
+        }
+        const sigBytes = await signPayload(
+          currentSigningKey,
+          payloadInput.value,
+          contextInput.value,
+        );
+        signatureOutput.value = bytesToHex(sigBytes);
+        showStatus(`Signed payload (${sigBytes.byteLength} byte signature).`, true);
+      } catch (err) {
+        showStatus(`Signing error: ${err.message}`, false);
+      }
+    });
+
+    verifyBtn.addEventListener('click', async () => {
+      try {
+        const pubKeyBytes = hexToBytes(publicKeyOutput.value);
+        const sigBytes = hexToBytes(signatureOutput.value);
+        const isValid = await verifyPayload(
+          pubKeyBytes,
+          sigBytes,
+          payloadInput.value,
+          contextInput.value,
+        );
+        if (isValid) {
+          showStatus('Signature Verified: Data integrity and signer authenticity confirmed.', true);
+        } else {
+          showStatus('Verification Failed: Payload, context, or signature does not match.', false);
+        }
+      } catch (err) {
+        showStatus(`Verification error: ${err.message}`, false);
+      }
+    });
