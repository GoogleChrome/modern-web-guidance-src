+  keySelect.innerHTML = state.keys.map(k => {
+    const qTag = k.meta.quantumResistant ? '🛡️ PQC' : '🔑 Classical';
+    return `<option value="${k.kid}" ${k.kid === state.activeKeyId ? 'selected' : ''}>
+      [${qTag}] ${k.meta.name} — (${k.kid})
+    </option>`;
+  }).join('');
+
+  if (activeKey) {
+    const qLabel = activeKey.meta.quantumResistant ? 'Quantum-Resistant (Post-Quantum)' : 'Classical Asymmetric';
+    keyBadge.textContent = `${qLabel} • ${activeKey.meta.standard}`;
+    keyBadge.style.backgroundColor = activeKey.meta.badgeColor;
