+function renderAuditLog() {
+  const container = document.getElementById('crypto-audit-log');
+  if (!container) return;
+  if (state.AuditLog.length === 0) {
+    container.innerHTML = '<div class="empty-log">No cryptographic operations recorded yet.</div>';
