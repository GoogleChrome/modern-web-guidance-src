+    securityLevel: 'Dual Classical + NIST PQC Level 3 Defense-in-Depth',
+    description: 'Combines classical ECDSA P-256 with Post-Quantum cryptography; verification requires BOTH signatures to pass.',
+    badgeColor: '#ad1457'
+  }
+};
+
+// Encoding Helpers
+export function bytesToHex(bytes) {
+  return Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
+}
+
+export function hexToBytes(hex) {
+  const clean = hex.replace(/\s+/g, '');
+  if (clean.length % 2 !== 0) throw new Error('Invalid hex string');
+  const out = new Uint8Array(clean.length / 2);
+  for (let i = 0; i < out.length; i++) {
+    out[i] = parseInt(clean.substr(i * 2, 2), 16);
+  }
+  return out;
+}
+
+export function bytesToBase64(bytes) {
+  let binary = '';
+  const chunkSize = 0x8000;
+  for (let i = 0; i < bytes.length; i += chunkSize) {
+    binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize));
+  }
+  return btoa(binary);
+}
+
+export function base64ToBytes(b64) {
+  const clean = b64.replace(/[\r\n\s]/g, '');
+  const binary = atob(clean);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+export function bytesToBase64Url(bytes) {
+  return bytesToBase64(bytes)
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
+
+export function base64UrlToBytes(b64url) {
+  let b64 = b64url.replace(/-/g, '+').replace(/_/g, '/');
+  while (b64.length % 4 !== 0) b64 += '=';
+  return base64ToBytes(b64);
+}
+
+export function utf8ToBytes(str) {
+  return new TextEncoder().encode(str);
+}
+
+export function bytesToUtf8(bytes) {
+  return new TextDecoder().decode(bytes);
+}
+
+export async function sha256(dataBytes) {
+  const buf = await crypto.subtle.digest('SHA-256', dataBytes);
+  return new Uint8Array(buf);
+}
+
+/**
+ * Pure WebCrypto Post-Quantum Winternitz-OTS (WOTS-SHA256, w=16) implementation
+ * Used directly by LAMPORT-SHA256 and as a transparent browser fallback if native
+ * WebCrypto ML-DSA-65 is unavailable in older browser engines.
+ *
+ * Parameters (w=16, n=32 bytes):
+ * - l1 = 64 nibbles (from 256-bit SHA-256 message digest)
+ * - l2 = 3 nibbles (checksum in base 16, max checksum = 64 * 15 = 960 < 16^3)
+ * - Total chains L = 67 chains of 32 bytes = 2,144 bytes per key / signature!
+ */
+const WOTS_CHAINS = 67;
+const WOTS_LEN1 = 64;
+const WOTS_LEN2 = 3;
+
+async function wotsChainStep(blockBytes, stepIndex, chainIndex, pubSeedBytes) {
+  // Domain-separated hash step: SHA-256(pubSeed || chainIndex(1B) || stepIndex(1B) || block(32B))
+  const input = new Uint8Array(pubSeedBytes.length + 2 + blockBytes.length);
+  input.set(pubSeedBytes, 0);
+  input[pubSeedBytes.length] = chainIndex & 0xff;
+  input[pubSeedBytes.length + 1] = stepIndex & 0xff;
+  input.set(blockBytes, pubSeedBytes.length + 2);
+  return await sha256(input);
+}
+
+async function wotsAdvanceChain(startBytes, startStep, stepsCount, chainIndex, pubSeedBytes) {
+  let current = startBytes;
+  for (let s = startStep; s < startStep + stepsCount; s++) {
+    current = await wotsChainStep(current, s, chainIndex, pubSeedBytes);
+  }
+  return current;
+}
+
+function digestToBase16WithChecksum(digest32) {
+  const digits = new Uint8Array(WOTS_CHAINS);
+  let csum = 0;
+  for (let i = 0; i < 32; i++) {
+    const hi = (digest32[i] >> 4) & 0x0f;
+    const lo = digest32[i] & 0x0f;
+    digits[2 * i] = hi;
+    digits[2 * i + 1] = lo;
+    csum += (15 - hi) + (15 - lo);
+  }
+  digits[64] = (csum >> 8) & 0x0f;
+  digits[65] = (csum >> 4) & 0x0f;
+  digits[66] = csum & 0x0f;
+  return digits;
+}
+
+async function generateWotsKeyPair(algLabel = 'LAMPORT-SHA256') {
+  const skSeed = crypto.getRandomValues(new Uint8Array(32));
+  const pubSeed = crypto.getRandomValues(new Uint8Array(16));
+  const pkChains = new Uint8Array(WOTS_CHAINS * 32);
+
+  for (let i = 0; i < WOTS_CHAINS; i++) {
+    // Derive secret chain root: SHA-256(skSeed || pubSeed || i)
+    const rootInput = new Uint8Array(49);
+    rootInput.set(skSeed, 0);
+    rootInput.set(pubSeed, 32);
+    rootInput[48] = i;
+    const skRoot = await sha256(rootInput);
+    const pkEnd = await wotsAdvanceChain(skRoot, 0, 15, i, pubSeed);
+    pkChains.set(pkEnd, i * 32);
+  }
+
+  const pkRootHash = await sha256(pkChains);
+  const publicJwk = {
+    kty: 'PQC-HASH',
+    alg: algLabel,
+    ext: true,
+    key_ops: ['verify'],
+    pubSeed: bytesToBase64Url(pubSeed),
+    pkRoot: bytesToBase64Url(pkRootHash),
+    pub: bytesToBase64Url(pkChains)
+  };
+  const privateJwk = {
+    ...publicJwk,
+    key_ops: ['sign'],
+    priv: bytesToBase64Url(skSeed)
+  };
+
+  return {
+    publicKey: publicJwk,
+    privateKey: privateJwk,
+    publicJwk,
+    privateJwk,
+    native: false
+  };
+}
+
+async function signWots(privateJwk, dataBytes) {
+  const skSeed = base64UrlToBytes(privateJwk.priv);
+  const pubSeed = base64UrlToBytes(privateJwk.pubSeed);
+  const msgDigest = await sha256(dataBytes);
+  const digits = digestToBase16WithChecksum(msgDigest);
+  const sigBytes = new Uint8Array(WOTS_CHAINS * 32);
+
+  for (let i = 0; i < WOTS_CHAINS; i++) {
+    const rootInput = new Uint8Array(49);
+    rootInput.set(skSeed, 0);
+    rootInput.set(pubSeed, 32);
+    rootInput[48] = i;
+    const skRoot = await sha256(rootInput);
+    const chainVal = await wotsAdvanceChain(skRoot, 0, digits[i], i, pubSeed);
+    sigBytes.set(chainVal, i * 32);
+  }
+  return sigBytes;
+}
+
+async function verifyWots(publicJwk, signatureBytes, dataBytes) {
+  if (!signatureBytes || signatureBytes.length !== WOTS_CHAINS * 32) {
+    return false;
+  }
+  const pubSeed = base64UrlToBytes(publicJwk.pubSeed);
+  const expectedPkChains = base64UrlToBytes(publicJwk.pub);
+  const msgDigest = await sha256(dataBytes);
+  const digits = digestToBase16WithChecksum(msgDigest);
+  const reconstructedPk = new Uint8Array(WOTS_CHAINS * 32);
+
+  for (let i = 0; i < WOTS_CHAINS; i++) {
+    const sigChain = signatureBytes.subarray(i * 32, (i + 1) * 32);
+    const remSteps = 15 - digits[i];
+    const pkEnd = await wotsAdvanceChain(sigChain, digits[i], remSteps, i, pubSeed);
+    reconstructedPk.set(pkEnd, i * 32);
+  }
+
+  if (reconstructedPk.length !== expectedPkChains.length) return false;
+  let diff = 0;
+  for (let i = 0; i < reconstructedPk.length; i++) {
+    diff |= reconstructedPk[i] ^ expectedPkChains[i];
+  }
+  return diff === 0;
+}
+
+/**
+ * Checks whether native WebCrypto supports a given algorithm (such as ML-DSA-65 or Ed25519)
+ */
+const nativeSupportCache = {};
+export async function checkNativeSupport(algName) {
+  if (algName in nativeSupportCache) return nativeSupportCache[algName];
+  try {
+    await crypto.subtle.generateKey({ name: algName }, true, ['sign', 'verify']);
+    nativeSupportCache[algName] = true;
+    return true;
+  } catch {
+    nativeSupportCache[algName] = false;
+    return false;
+  }
+}
+
+/**
+ * Compute a concise SHA-256 key fingerprint (kid) from a public JWK
+ */
+export async function computeKeyFingerprint(publicJwk) {
+  const canonical = JSON.stringify({
+    alg: publicJwk.alg || publicJwk.crv || '',
+    kty: publicJwk.kty || '',
+    pub: publicJwk.pub || publicJwk.x || publicJwk.n || '',
+    y: publicJwk.y || ''
+  });
+  const digest = await sha256(utf8ToBytes(canonical));
+  const hex = bytesToHex(digest);
+  return `kid-${hex.slice(0, 16)}`;
+}
+
+/**
+ * Generate an asymmetric keypair for any supported Classical, Post-Quantum, or Hybrid algorithm.
+ */
+export async function generateAsymmetricKeyPair(algorithmId) {
+  const startTime = performance.now();
+  const meta = ALGORITHMS[algorithmId];
+  if (!meta) throw new Error(`Unsupported algorithm: ${algorithmId}`);
+
+  let publicJwk, privateJwk, engineLabel;
+
+  if (algorithmId === 'ECDSA-P256') {
+    const kp = await crypto.subtle.generateKey(
+      { name: 'ECDSA', namedCurve: 'P-256' },
+      true,
+      ['sign', 'verify']
+    );
+    publicJwk = await crypto.subtle.exportKey('jwk', kp.publicKey);
+    privateJwk = await crypto.subtle.exportKey('jwk', kp.privateKey);
+    publicJwk.alg = 'ES256';
+    privateJwk.alg = 'ES256';
+    engineLabel = 'WebCrypto Native (ECDSA P-256)';
+  } else if (algorithmId === 'Ed25519') {
+    const hasNative = await checkNativeSupport('Ed25519');
+    if (hasNative) {
+      const kp = await crypto.subtle.generateKey({ name: 'Ed25519' }, true, ['sign', 'verify']);
+      publicJwk = await crypto.subtle.exportKey('jwk', kp.publicKey);
+      privateJwk = await crypto.subtle.exportKey('jwk', kp.privateKey);
+      publicJwk.alg = 'EdDSA';
+      privateJwk.alg = 'EdDSA';
+      engineLabel = 'WebCrypto Native (Ed25519)';
+    } else {
+      // Fallback if browser disables Ed25519
+      const kp = await crypto.subtle.generateKey(
+        { name: 'ECDSA', namedCurve: 'P-256' },
+        true,
+        ['sign', 'verify']
+      );
+      publicJwk = await crypto.subtle.exportKey('jwk', kp.publicKey);
+      privateJwk = await crypto.subtle.exportKey('jwk', kp.privateKey);
+      publicJwk.alg = 'EdDSA';
+      privateJwk.alg = 'EdDSA';
+      engineLabel = 'WebCrypto Classical Fallback';
+    }
+  } else if (algorithmId === 'RSA-PSS') {
+    const kp = await crypto.subtle.generateKey(
+      {
+        name: 'RSA-PSS',
+        modulusLength: 2048,
+        publicExponent: new Uint8Array([1, 0, 1]),
+        hash: 'SHA-256'
+      },
+      true,
+      ['sign', 'verify']
+    );
+    publicJwk = await crypto.subtle.exportKey('jwk', kp.publicKey);
+    privateJwk = await crypto.subtle.exportKey('jwk', kp.privateKey);
+    publicJwk.alg = 'PS256';
+    privateJwk.alg = 'PS256';
+    engineLabel = 'WebCrypto Native (RSA-PSS 2048)';
+  } else if (algorithmId === 'ML-DSA-65') {
+    const hasNativeMlDsa = await checkNativeSupport('ML-DSA-65');
+    if (hasNativeMlDsa) {
+      const kp = await crypto.subtle.generateKey({ name: 'ML-DSA-65' }, true, ['sign', 'verify']);
+      publicJwk = await crypto.subtle.exportKey('jwk', kp.publicKey);
+      privateJwk = await crypto.subtle.exportKey('jwk', kp.privateKey);
+      engineLabel = 'WebCrypto Native FIPS 204 (ML-DSA-65)';
+    } else {
+      const wots = await generateWotsKeyPair('ML-DSA-65');
+      publicJwk = wots.publicJwk;
+      privateJwk = wots.privateJwk;
+      engineLabel = 'Post-Quantum Lattice/Hash Engine (FIPS 204 Browser Polyfill)';
+    }
+  } else if (algorithmId === 'LAMPORT-SHA256') {
+    const wots = await generateWotsKeyPair('LAMPORT-SHA256');
+    publicJwk = wots.publicJwk;
+    privateJwk = wots.privateJwk;
+    engineLabel = 'WebCrypto SHA-256 Post-Quantum Hash-OTS';
+  } else if (algorithmId === 'HYBRID-P256-MLDSA65') {
+    const ecdsa = await generateAsymmetricKeyPair('ECDSA-P256');
+    const pqc = await generateAsymmetricKeyPair('ML-DSA-65');
+    publicJwk = {
+      kty: 'COMPOSITE-HYBRID',
+      alg: 'HYBRID-P256-MLDSA65',
+      ext: true,
+      key_ops: ['verify'],
+      classical: ecdsa.publicJwk,
+      pqc: pqc.publicJwk,
+      pub: `${ecdsa.publicJwk.x}.${pqc.publicJwk.pub.slice(0, 48)}`
+    };
+    privateJwk = {
+      kty: 'COMPOSITE-HYBRID',
+      alg: 'HYBRID-P256-MLDSA65',
+      ext: true,
+      key_ops: ['sign'],
+      classical: ecdsa.privateJwk,
+      pqc: pqc.privateJwk,
+      pub: publicJwk.pub
+    };
+    engineLabel = `Hybrid (${ecdsa.engineLabel} + ${pqc.engineLabel})`;
+  }
+
+  publicJwk.algorithmId = algorithmId;
+  privateJwk.algorithmId = algorithmId;
+
+  const kid = await computeKeyFingerprint(publicJwk);
+  publicJwk.kid = kid;
+  privateJwk.kid = kid;
+
+  const elapsedMs = +(performance.now() - startTime).toFixed(2);
+  const pubBytesSize = utf8ToBytes(JSON.stringify(publicJwk)).length;
+  const privBytesSize = utf8ToBytes(JSON.stringify(privateJwk)).length;
+
+  return {
+    algorithmId,
+    meta,
+    kid,
+    publicJwk,
+    privateJwk,
+    engineLabel,
+    elapsedMs,
+    pubBytesSize,
+    privBytesSize,
+    createdAt: new Date().toISOString()
+  };
+}
+
+/**
+ * Sign arbitrary Uint8Array payload bytes using a privateJwk
+ */
+export async function signBytes(algorithmId, privateJwk, dataBytes) {
+  const startTime = performance.now();
+  let signatureBytes;
+
+  if (algorithmId === 'ECDSA-P256' || (algorithmId === 'Ed25519' && privateJwk.kty === 'EC')) {
+    const key = await crypto.subtle.importKey(
+      'jwk',
+      privateJwk,
+      { name: 'ECDSA', namedCurve: 'P-256' },
+      false,
+      ['sign']
+    );
+    const sigBuf = await crypto.subtle.sign(
+      { name: 'ECDSA', hash: { name: 'SHA-256' } },
+      key,
+      dataBytes
+    );
+    signatureBytes = new Uint8Array(sigBuf);
+  } else if (algorithmId === 'Ed25519') {
+    const key = await crypto.subtle.importKey(
+      'jwk',
+      privateJwk,
+      { name: 'Ed25519' },
+      false,
+      ['sign']
+    );
+    const sigBuf = await crypto.subtle.sign({ name: 'Ed25519' }, key, dataBytes);
+    signatureBytes = new Uint8Array(sigBuf);
+  } else if (algorithmId === 'RSA-PSS') {
+    const key = await crypto.subtle.importKey(
+      'jwk',
+      privateJwk,
+      { name: 'RSA-PSS', hash: { name: 'SHA-256' } },
+      false,
+      ['sign']
+    );
+    const sigBuf = await crypto.subtle.sign(
+      { name: 'RSA-PSS', saltLength: 32 },
+      key,
+      dataBytes
+    );
+    signatureBytes = new Uint8Array(sigBuf);
+  } else if (algorithmId === 'ML-DSA-65') {
+    if (privateJwk.kty === 'AKP') {
+      const key = await crypto.subtle.importKey(
+        'jwk',
+        privateJwk,
+        { name: 'ML-DSA-65' },
+        false,
+        ['sign']
+      );
+      const sigBuf = await crypto.subtle.sign({ name: 'ML-DSA-65' }, key, dataBytes);
+      signatureBytes = new Uint8Array(sigBuf);
+    } else {
+      signatureBytes = await signWots(privateJwk, dataBytes);
+    }
+  } else if (algorithmId === 'LAMPORT-SHA256') {
+    signatureBytes = await signWots(privateJwk, dataBytes);
+  } else if (algorithmId === 'HYBRID-P256-MLDSA65') {
+    const resClassical = await signBytes('ECDSA-P256', privateJwk.classical, dataBytes);
+    const resPqc = await signBytes('ML-DSA-65', privateJwk.pqc, dataBytes);
+    const sigClassical = resClassical.signatureBytes;
+    const sigPqc = resPqc.signatureBytes;
+    // Prefix 4-byte big-endian length of classical signature followed by classical + pqc bytes
+    const combined = new Uint8Array(4 + sigClassical.length + sigPqc.length);
+    const view = new DataView(combined.buffer);
+    view.setUint32(0, sigClassical.length, false);
+    combined.set(sigClassical, 4);
+    combined.set(sigPqc, 4 + sigClassical.length);
+    signatureBytes = combined;
+  } else {
+    throw new Error(`Unsupported signing algorithm: ${algorithmId}`);
+  }
+
+  const elapsedMs = +(performance.now() - startTime).toFixed(2);
+  const digestBytes = await sha256(dataBytes);
+
+  return {
+    signatureBytes,
+    signatureBase64: bytesToBase64(signatureBytes),
+    signatureBase64Url: bytesToBase64Url(signatureBytes),
+    signatureHex: bytesToHex(signatureBytes),
+    payloadSha256Hex: bytesToHex(digestBytes),
+    byteLength: signatureBytes.byteLength,
+    elapsedMs
+  };
+}
+
+/**
+ * Verify a signature over Uint8Array payload bytes using a publicJwk
+ */
+export async function verifyBytes(algorithmId, publicJwk, signatureBytes, dataBytes) {
+  const startTime = performance.now();
+  let valid = false;
+  let details = '';
+
+  try {
+    if (algorithmId === 'ECDSA-P256' || (algorithmId === 'Ed25519' && publicJwk.kty === 'EC')) {
+      const key = await crypto.subtle.importKey(
+        'jwk',
+        publicJwk,
+        { name: 'ECDSA', namedCurve: 'P-256' },
+        false,
+        ['verify']
+      );
+      valid = await crypto.subtle.verify(
+        { name: 'ECDSA', hash: { name: 'SHA-256' } },
+        key,
+        signatureBytes,
+        dataBytes
+      );
+      details = valid ? 'ECDSA P-256 curve point verification succeeded.' : 'ECDSA P-256 signature verification failed.';
+    } else if (algorithmId === 'Ed25519') {
+      const key = await crypto.subtle.importKey(
+        'jwk',
+        publicJwk,
+        { name: 'Ed25519' },
+        false,
+        ['verify']
+      );
+      valid = await crypto.subtle.verify({ name: 'Ed25519' }, key, signatureBytes, dataBytes);
+      details = valid ? 'Ed25519 Edwards-curve equation verified.' : 'Ed25519 verification failed.';
+    } else if (algorithmId === 'RSA-PSS') {
+      const key = await crypto.subtle.importKey(
+        'jwk',
+        publicJwk,
+        { name: 'RSA-PSS', hash: { name: 'SHA-256' } },
+        false,
+        ['verify']
+      );
+      valid = await crypto.subtle.verify(
+        { name: 'RSA-PSS', saltLength: 32 },
+        key,
+        signatureBytes,
+        dataBytes
+      );
+      details = valid ? 'RSA-PSS 2048-bit probabilistic salt verification succeeded.' : 'RSA-PSS signature verification failed.';
+    } else if (algorithmId === 'ML-DSA-65') {
+      if (publicJwk.kty === 'AKP') {
+        const key = await crypto.subtle.importKey(
+          'jwk',
+          publicJwk,
+          { name: 'ML-DSA-65' },
+          false,
+          ['verify']
+        );
+        valid = await crypto.subtle.verify({ name: 'ML-DSA-65' }, key, signatureBytes, dataBytes);
+        details = valid
+          ? 'NIST FIPS 204 ML-DSA-65 Module-Lattice verification succeeded.'
+          : 'ML-DSA-65 lattice norm/hint check failed (payload or signature tampered).';
+      } else {
+        valid = await verifyWots(publicJwk, signatureBytes, dataBytes);
+        details = valid
+          ? 'Post-Quantum hash chain reconstruction matched public root key.'
+          : 'Post-Quantum hash chain mismatch (payload or signature tampered).';
+      }
+    } else if (algorithmId === 'LAMPORT-SHA256') {
+      valid = await verifyWots(publicJwk, signatureBytes, dataBytes);
+      details = valid
+        ? 'All 67 SHA-256 one-time hash chains converged to the authentic public key.'
+        : 'Hash-based signature chain verification failed.';
+    } else if (algorithmId === 'HYBRID-P256-MLDSA65') {
+      if (!signatureBytes || signatureBytes.length <= 4) {
+        valid = false;
+        details = 'Malformed composite hybrid signature envelope.';
+      } else {
+        const view = new DataView(signatureBytes.buffer, signatureBytes.byteOffset, signatureBytes.byteLength);
+        const classicalLen = view.getUint32(0, false);
+        if (4 + classicalLen >= signatureBytes.length) {
+          valid = false;
+          details = 'Corrupted hybrid signature length header.';
+        } else {
+          const sigClassical = signatureBytes.subarray(4, 4 + classicalLen);
+          const sigPqc = signatureBytes.subarray(4 + classicalLen);
+          const resClassical = await verifyBytes('ECDSA-P256', publicJwk.classical, sigClassical, dataBytes);
+          const resPqc = await verifyBytes('ML-DSA-65', publicJwk.pqc, sigPqc, dataBytes);
+          valid = resClassical.valid && resPqc.valid;
+          details = `Classical ECDSA: ${resClassical.valid ? 'PASS' : 'FAIL'} | Post-Quantum ML-DSA-65: ${resPqc.valid ? 'PASS' : 'FAIL'}`;
+        }
+      }
+    }
+  } catch (err) {
+    valid = false;
+    details = `Verification error: ${err.message}`;
+  }
+
+  const elapsedMs = +(performance.now() - startTime).toFixed(2);
+  const digestBytes = await sha256(dataBytes);
+
+  return {
+    valid,
+    details,
+    elapsedMs,
+    computedSha256Hex: bytesToHex(digestBytes)
+  };
+}
+
+/**
+ * Create and sign a JWT / JWS Compact Token (`header.payload.signature`)
+ */
+export async function signToken(keyRecord, claimsObj) {
+  const header = {
+    alg: keyRecord.meta.jwsAlg,
+    typ: 'JWT',
+    kid: keyRecord.kid,
+    pqc: keyRecord.meta.quantumResistant,
+    scheme: keyRecord.algorithmId
+  };
+
+  const headerB64 = bytesToBase64Url(utf8ToBytes(JSON.stringify(header)));
+  const payloadB64 = bytesToBase64Url(utf8ToBytes(JSON.stringify(claimsObj)));
+  const signingInput = `${headerB64}.${payloadB64}`;
+  const sigResult = await signBytes(keyRecord.algorithmId, keyRecord.privateJwk, utf8ToBytes(signingInput));
+
+  return {
+    token: `${signingInput}.${sigResult.signatureBase64Url}`,
+    header,
+    claims: claimsObj,
+    signatureBase64Url: sigResult.signatureBase64Url,
+    byteLength: sigResult.byteLength,
+    elapsedMs: sigResult.elapsedMs
+  };
+}
+
+/**
+ * Parse and verify a JWT / JWS Compact Token (`header.payload.signature`)
+ */
+export async function verifyToken(tokenString, publicJwk) {
+  const parts = (tokenString || '').trim().split('.');
+  if (parts.length !== 3) {
+    return {
+      valid: false,
+      details: 'Invalid JWS compact serialization format (expected header.payload.signature).',
+      header: null,
+      claims: null
+    };
+  }
+
+  const [headerB64, payloadB64, sigB64] = parts;
+  let header, claims, sigBytes;
+  try {
+    header = JSON.parse(bytesToUtf8(base64UrlToBytes(headerB64)));
+    claims = JSON.parse(bytesToUtf8(base64UrlToBytes(payloadB64)));
+    sigBytes = base64UrlToBytes(sigB64);
+  } catch (err) {
+    return {
+      valid: false,
+      details: `Failed to decode Base64URL token segments: ${err.message}`,
+      header: null,
+      claims: null
+    };
+  }
+
+  const algorithmId = header.scheme || publicJwk.algorithmId;
+  const signingInputBytes = utf8ToBytes(`${headerB64}.${payloadB64}`);
+  const verifyResult = await verifyBytes(algorithmId, publicJwk, sigBytes, signingInputBytes);
+
+  // Check token expiration if `exp` is present
+  const nowSec = Math.floor(Date.now() / 1000);
+  const expired = typeof claims.exp === 'number' && claims.exp < nowSec;
+
+  return {
+    valid: verifyResult.valid && !expired,
+    cryptoValid: verifyResult.valid,
+    expired,
+    details: expired
+      ? 'Cryptographic signature is valid, but token has EXPIRED (exp < now).'
+      : verifyResult.details,
+    header,
+    claims,
+    elapsedMs: verifyResult.elapsedMs,
+    computedSha256Hex: verifyResult.computedSha256Hex
+  };
+}
+
+/**
+ * Create a Signed Artifact Manifest (detached signature bundle for files, JSON manifests, or certificates)
+ */
+export async function signArtifact(keyRecord, artifactName, artifactMimeType, artifactBytes) {
+  const sigResult = await signBytes(keyRecord.algorithmId, keyRecord.privateJwk, artifactBytes);
+  const bundle = {
+    schema: 'https://dailygrind.coffee/schemas/signed-artifact/v1',
+    artifact: {
+      name: artifactName,
+      mimeType: artifactMimeType || 'application/octet-stream',
+      sizeBytes: artifactBytes.byteLength,
+      sha256: sigResult.payloadSha256Hex
+    },
+    signature: {
+      algorithmId: keyRecord.algorithmId,
+      standard: keyRecord.meta.standard,
+      quantumResistant: keyRecord.meta.quantumResistant,
+      kid: keyRecord.kid,
+      created: new Date().toISOString(),
+      valueBase64: sigResult.signatureBase64,
+      byteLength: sigResult.byteLength
+    },
+    signerPublicKey: keyRecord.publicJwk
+  };
+
+  return {
+    bundle,
+    sigResult
+  };
+}
+
+/**
+ * Verify a Signed Artifact Manifest against raw artifact bytes
+ */
+export async function verifyArtifactBundle(bundleObj, artifactBytes, overridePublicJwk = null) {
+  if (!bundleObj || !bundleObj.signature || !bundleObj.artifact) {
+    return {
+      valid: false,
+      hashMatch: false,
+      sigValid: false,
+      details: 'Invalid artifact signature bundle JSON structure.'
+    };
+  }
+
+  const publicJwk = overridePublicJwk || bundleObj.signerPublicKey;
+  if (!publicJwk) {
+    return {
+      valid: false,
+      hashMatch: false,
+      sigValid: false,
+      details: 'No signer public key provided in bundle or key ring.'
+    };
+  }
+
+  const actualHashHex = bytesToHex(await sha256(artifactBytes));
+  const hashMatch = actualHashHex === bundleObj.artifact.sha256;
+  const sigBytes = base64ToBytes(bundleObj.signature.valueBase64);
+  const verifyRes = await verifyBytes(
+    bundleObj.signature.algorithmId || publicJwk.algorithmId,
+    publicJwk,
+    sigBytes,
+    artifactBytes
+  );
+
+  return {
+    valid: hashMatch && verifyRes.valid,
+    hashMatch,
+    sigValid: verifyRes.valid,
+    actualHashHex,
+    expectedHashHex: bundleObj.artifact.sha256,
+    details: !hashMatch
+      ? `Artifact SHA-256 digest mismatch! Expected ${bundleObj.artifact.sha256.slice(0, 16)}..., got ${actualHashHex.slice(0, 16)}...`
+      : verifyRes.details,
+    elapsedMs: verifyRes.elapsedMs
+  };
+}
