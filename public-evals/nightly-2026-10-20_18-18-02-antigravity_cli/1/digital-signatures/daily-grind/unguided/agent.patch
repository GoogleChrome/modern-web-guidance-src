+  await handleSignMessage();
+  await handleSignToken();
+  await handleSignArtifact();
+  await handleRunBenchmarkMatrix();
+}
+
+if (typeof window !== 'undefined') {
+  window.addEventListener('DOMContentLoaded', () => {
+    initCryptoApp().catch(err => console.error('Failed to initialize crypto suite:', err));
+  });
+}
