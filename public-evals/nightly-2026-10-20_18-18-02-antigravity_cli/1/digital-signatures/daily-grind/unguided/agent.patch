+        <div><strong>Public Key JWK Size:</strong> ${activeKey.pubBytesSize.toLocaleString()} bytes</div>
+        <div><strong>Private Key Status:</strong> ${activeKey.privateJwk ? '<span class="tag-ok">Present (Can Sign & Verify)</span>' : '<span class="tag-warn">Public-Only (Verify Only)</span>'}</div>
+      </div>
+      <p class="alg-desc">${activeKey.meta.description}</p>
