+// ==========================================
+// 4. BENCHMARK & MATRIX COMPARISON HANDLER
+// ==========================================
+async function handleRunBenchmarkMatrix() {
+  const tbody = document.getElementById('benchmark-table-body');
+  const btn = document.getElementById('run-benchmark-btn');
+  if (!tbody || !btn) return;
+
+  btn.disabled = true;
+  btn.textContent = 'Running Cryptographic Suite Benchmark...';
+  tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;padding:18px;">Executing live key generation, signing, and verification across all Classical & Post-Quantum schemes...</td></tr>';
+
+  const samplePayload = utf8ToBytes('The Daily Grind Coffee Co. - Cryptographic Benchmark Vector #2026-PQC');
+  const rowsHtml = [];
+
+  for (const algId of Object.keys(ALGORITHMS)) {
+    const kp = await generateAsymmetricKeyPair(algId);
+    const sig = await signBytes(algId, kp.privateJwk, samplePayload);
+    const ver = await verifyBytes(algId, kp.publicJwk, sig.signatureBytes, samplePayload);
+
+    rowsHtml.push(`
+      <tr>
+        <td><strong>${kp.meta.name}</strong><br><small>${kp.meta.standard}</small></td>
+        <td><span class="q-badge ${kp.meta.quantumResistant ? 'q-pqc' : 'q-classical'}">${kp.meta.quantumResistant ? '🛡️ Post-Quantum' : '🔑 Classical'}</span></td>
+        <td>${kp.pubBytesSize.toLocaleString()} B</td>
+        <td><strong>${sig.byteLength.toLocaleString()} B</strong></td>
+        <td>${kp.elapsedMs} ms</td>
+        <td>${sig.elapsedMs} ms / ${ver.elapsedMs} ms</td>
+        <td>${ver.valid ? '<span class="tag-ok">✅ PASS</span>' : '<span class="tag-err">❌ FAIL</span>'}</td>
+      </tr>
+    `);
+  }
+
+  tbody.innerHTML = rowsHtml.join('');
+  btn.disabled = false;
+  btn.textContent = 'Re-Run Live Browser Crypto Benchmark';
+  logAudit('Suite Benchmark', 'PASS', 'Completed full Classical vs. Post-Quantum live comparison.');
+}
