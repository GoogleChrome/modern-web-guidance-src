+// ==========================================
+// 1. MESSAGE SIGNING & VERIFICATION HANDLERS
+// ==========================================
+async function handleSignMessage() {
+  const key = getActiveKey();
+  if (!key || !key.privateJwk) {
+    alert('Please select a keypair that contains a private key to sign.');
+    return;
+  }
+
+  const msgInput = document.getElementById('msg-payload-input');
+  const formatSelect = document.getElementById('msg-sig-format');
+  const sigOutput = document.getElementById('msg-signature-output');
+  const metaOutput = document.getElementById('msg-sign-meta');
+
+  const text = msgInput.value;
+  const bytes = utf8ToBytes(text);
+  const res = await signBytes(key.algorithmId, key.privateJwk, bytes);
+
+  state.lastMessageSignature = {
+    ...res,
+    algorithmId: key.algorithmId,
+    kid: key.kid,
+    messageText: text
+  };
+
+  const fmt = formatSelect.value;
+  sigOutput.value = fmt === 'hex' ? res.signatureHex : res.signatureBase64;
+  metaOutput.innerHTML = `
+    <span><strong>Algorithm:</strong> ${key.algorithmId} (${key.meta.quantumResistant ? 'Post-Quantum' : 'Classical'})</span>
+    <span><strong>Key ID:</strong> <code>${key.kid}</code></span>
+    <span><strong>Payload SHA-256:</strong> <code>${res.payloadSha256Hex.slice(0, 24)}...</code></span>
+    <span><strong>Signature Size:</strong> ${res.byteLength.toLocaleString()} bytes</span>
+    <span><strong>Sign Time:</strong> ${res.elapsedMs} ms</span>
+  `;
+
+  logAudit('Sign Message', 'INFO', `Signed ${bytes.length}B message with ${key.algorithmId} (${res.byteLength}B sig in ${res.elapsedMs}ms)`);
+  await handleVerifyMessage();
+}
+
+async function handleVerifyMessage() {
+  const key = getActiveKey();
+  if (!key) return;
+
+  const msgInput = document.getElementById('msg-payload-input');
+  const formatSelect = document.getElementById('msg-sig-format');
+  const sigOutput = document.getElementById('msg-signature-output');
+
+  const text = msgInput.value;
+  const sigRaw = sigOutput.value.trim();
+  if (!sigRaw) {
+    showVerificationBanner('msg-verify-result', false, 'Missing Signature', 'Generate or paste a signature first.');
+    return;
+  }
+
+  let sigBytes;
+  try {
+    sigBytes = formatSelect.value === 'hex' ? hexToBytes(sigRaw) : base64ToBytes(sigRaw);
+  } catch (err) {
+    showVerificationBanner('msg-verify-result', false, 'Malformed Signature Encoding', `Could not decode ${formatSelect.value.toUpperCase()} signature: ${err.message}`);
+    logAudit('Verify Message', 'FAIL', `Encoding error (${err.message})`);
+    return;
+  }
+
+  const res = await verifyBytes(key.algorithmId, key.publicJwk, sigBytes, utf8ToBytes(text));
+  showVerificationBanner(
+    'msg-verify-result',
+    res.valid,
+    res.valid
+      ? `Verified with ${key.meta.name}`
+      : `Signature Rejected by ${key.meta.name}`,
+    res.details,
+    `<span><strong>Key ID:</strong> <code>${key.kid}</code></span>
+     <span><strong>Computed SHA-256:</strong> <code>${res.computedSha256Hex.slice(0, 32)}...</code></span>
+     <span><strong>Verify Time:</strong> ${res.elapsedMs} ms</span>`
+  );
+
+  logAudit(
+    'Verify Message',
+    res.valid ? 'PASS' : 'FAIL',
+    `${key.algorithmId} verification ${res.valid ? 'succeeded' : 'failed'} (${res.elapsedMs}ms)`
+  );
+}
+
+// ==========================================
+// 2. TOKEN (JWT / JWS) SIGNING & VERIFICATION
+// ==========================================
+async function handleSignToken() {
+  const key = getActiveKey();
+  if (!key || !key.privateJwk) {
+    alert('Please select a keypair with a private key to mint tokens.');
+    return;
+  }
+
+  const sub = document.getElementById('token-sub').value.trim() || 'barista-roaster-01';
+  const role = document.getElementById('token-role').value;
+  const scope = document.getElementById('token-scope').value.trim() || 'orders:sign beans:certify rewards:issue';
+  const expMinutes = parseInt(document.getElementById('token-exp-min').value, 10) || 60;
+
+  const nowSec = Math.floor(Date.now() / 1000);
+  const claims = {
+    iss: 'https://auth.dailygrind.coffee',
+    sub,
+    role,
+    scope,
+    iat: nowSec,
+    exp: nowSec + expMinutes * 60,
+    jti: `dg-tok-${crypto.getRandomValues(new Uint32Array(1))[0].toString(16)}`
+  };
+
+  const res = await signToken(key, claims);
+  state.lastSignedToken = res;
+
+  document.getElementById('token-compact-output').value = res.token;
+  document.getElementById('token-decoded-header').textContent = JSON.stringify(res.header, null, 2);
+  document.getElementById('token-decoded-claims').textContent = JSON.stringify(res.claims, null, 2);
+
+  logAudit('Mint JWS Token', 'INFO', `Issued ${res.header.alg} token for ${sub} (${res.byteLength}B sig)`);
+  await handleVerifyToken();
+}
+
+async function handleVerifyToken() {
+  const key = getActiveKey();
+  if (!key) return;
+
+  const tokenStr = document.getElementById('token-compact-output').value.trim();
+  if (!tokenStr) {
+    showVerificationBanner('token-verify-result', false, 'Empty Token', 'Mint or paste a JWS compact token first.');
+    return;
+  }
+
+  const res = await verifyToken(tokenStr, key.publicJwk);
+  if (res.header) {
+    document.getElementById('token-decoded-header').textContent = JSON.stringify(res.header, null, 2);
+  }
+  if (res.claims) {
+    document.getElementById('token-decoded-claims').textContent = JSON.stringify(res.claims, null, 2);
+  }
+
+  showVerificationBanner(
+    'token-verify-result',
+    res.valid,
+    res.valid
+      ? `Authentic Token (${res.header?.alg || key.algorithmId})`
+      : `Token Verification Failed`,
+    res.details,
+    res.claims
+      ? `<span><strong>Subject:</strong> <code>${res.claims.sub}</code></span>
+         <span><strong>Role:</strong> <code>${res.claims.role}</code></span>
+         <span><strong>Quantum-Resistant:</strong> <code>${res.header?.pqc ? 'Yes (Post-Quantum)' : 'No (Classical)'}</code></span>
+         <span><strong>Verify Time:</strong> ${res.elapsedMs || 0} ms</span>`
+      : ''
+  );
+
+  logAudit(
+    'Verify JWS Token',
+    res.valid ? 'PASS' : 'FAIL',
+    `Token verification ${res.valid ? 'succeeded' : 'rejected'}: ${res.details}`
+  );
+}
+
+function handleTamperTokenClaims() {
+  const tokenEl = document.getElementById('token-compact-output');
+  const parts = tokenEl.value.trim().split('.');
+  if (parts.length !== 3) return;
+  try {
+    const claimsJson = bytesToUtf8(
+      base64ToBytes(parts[1].replace(/-/g, '+').replace(/_/g, '/'))
+    );
+    const claims = JSON.parse(claimsJson);
+    claims.role = 'unauthorized-root-admin';
+    claims.loyaltyPoints = 9999999;
+    const tamperedB64Url = btoa(JSON.stringify(claims))
+      .replace(/\+/g, '-')
+      .replace(/\//g, '_')
+      .replace(/=+$/, '');
+    tokenEl.value = `${parts[0]}.${tamperedB64Url}.${parts[2]}`;
+    handleVerifyToken();
+  } catch (e) {
+    console.error('Could not tamper token:', e);
+  }
+}
+
+// ==========================================
+// 3. ARTIFACT / MANIFEST SIGNING & VERIFYING
+// ==========================================
+async function handleSignArtifact() {
+  const key = getActiveKey();
+  if (!key || !key.privateJwk) {
+    alert('Please select a keypair with a private key to sign artifacts.');
+    return;
+  }
+
+  const nameInput = document.getElementById('artifact-name-input');
+  const contentInput = document.getElementById('artifact-content-input');
+  const bundleOutput = document.getElementById('artifact-bundle-output');
+
+  const artifactName = nameInput.value.trim() || 'artifact.json';
+  const rawBytes = state.uploadedVerifyBytes || utf8ToBytes(contentInput.value);
+  const res = await signArtifact(key, artifactName, 'application/json', rawBytes);
+
+  state.lastArtifactBundle = {
+    bundle: res.bundle,
+    rawBytes
+  };
+
+  bundleOutput.value = JSON.stringify(res.bundle, null, 2);
+  logAudit(
+    'Sign Artifact',
+    'INFO',
+    `Signed "${artifactName}" (${rawBytes.byteLength}B, SHA-256: ${res.sigResult.payloadSha256Hex.slice(0, 12)}...) with ${key.algorithmId}`
+  );
+
+  await handleVerifyArtifact();
+}
+
+async function handleVerifyArtifact() {
+  const key = getActiveKey();
+  const contentInput = document.getElementById('artifact-content-input');
+  const bundleOutput = document.getElementById('artifact-bundle-output');
+  const useEmbeddedKey = document.getElementById('artifact-use-embedded-key').checked;
+
+  let bundleObj;
+  try {
+    bundleObj = JSON.parse(bundleOutput.value);
+  } catch (err) {
+    showVerificationBanner('artifact-verify-result', false, 'Malformed Bundle JSON', `Cannot parse Signed Artifact Bundle: ${err.message}`);
+    return;
+  }
+
+  const rawBytes = state.uploadedVerifyBytes || utf8ToBytes(contentInput.value);
+  const overrideKey = useEmbeddedKey ? null : (key ? key.publicJwk : null);
+
+  const res = await verifyArtifactBundle(bundleObj, rawBytes, overrideKey);
+  showVerificationBanner(
+    'artifact-verify-result',
+    res.valid,
+    res.valid
+      ? `Artifact Authentic & Unmodified (${bundleObj.artifact?.name})`
+      : `Artifact Integrity or Authenticity Check Failed!`,
+    res.details,
+    `<span><strong>Expected SHA-256:</strong> <code>${(res.expectedHashHex || '').slice(0, 20)}...</code></span>
+     <span><strong>Actual SHA-256:</strong> <code>${(res.actualHashHex || '').slice(0, 20)}...</code></span>
+     <span><strong>Hash Match:</strong> ${res.hashMatch ? '✅ Yes' : '❌ No'}</span>
+     <span><strong>Crypto Signature:</strong> ${res.sigValid ? '✅ Valid' : '❌ Invalid'}</span>`
+  );
+
+  logAudit(
+    'Verify Artifact',
+    res.valid ? 'PASS' : 'FAIL',
+    `Artifact "${bundleObj.artifact?.name || 'unknown'}" check ${res.valid ? 'PASSED' : 'FAILED'}`
+  );
+}
