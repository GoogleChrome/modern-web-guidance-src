+// ==========================================
+// INITIALIZATION & EVENT BINDINGS
+// ==========================================
+export async function initCryptoApp() {
+  const loaded = loadKeyringFromStorage();
+  if (!loaded) {
+    // Generate default Classical (ECDSA P-256) and Post-Quantum (ML-DSA-65) keys out of the box
+    const pqcKey = await generateAsymmetricKeyPair('ML-DSA-65');
+    const classicalKey = await generateAsymmetricKeyPair('ECDSA-P256');
+    const hybridKey = await generateAsymmetricKeyPair('HYBRID-P256-MLDSA65');
+    state.keys = [pqcKey, classicalKey, hybridKey];
+    state.activeKeyId = pqcKey.kid;
+    saveKeyringToStorage();
+    logAudit('Keyring Initialized', 'INFO', `Provisioned default Post-Quantum (${pqcKey.kid}), Classical (${classicalKey.kid}), and Hybrid (${hybridKey.kid}) keys.`);
+  }
+
+  renderKeyRing();
+  renderAuditLog();
+
+  // Bind Key Management UI
+  document.getElementById('active-key-select')?.addEventListener('change', (e) => {
+    state.activeKeyId = e.target.value;
+    saveKeyringToStorage();
+    renderKeyRing();
+  });
+
+  document.getElementById('generate-key-btn')?.addEventListener('click', async () => {
+    const algSelect = document.getElementById('new-key-alg-select');
+    const algId = algSelect.value;
+    const btn = document.getElementById('generate-key-btn');
+    btn.disabled = true;
+    btn.textContent = 'Generating...';
+    try {
+      const newKey = await generateAsymmetricKeyPair(algId);
+      state.keys.unshift(newKey);
+      state.activeKeyId = newKey.kid;
+      saveKeyringToStorage();
+      renderKeyRing();
+      logAudit('Key Generation', 'INFO', `Generated ${newKey.meta.name} keypair (${newKey.kid}) in ${newKey.elapsedMs}ms`);
+    } finally {
+      btn.disabled = false;
+      btn.textContent = '+ Generate Keypair';
+    }
+  });
+
+  document.getElementById('import-pubkey-btn')?.addEventListener('click', async () => {
+    const raw = prompt('Paste an exported Public Key JWK JSON object to import into your keyring:');
+    if (!raw) return;
+    try {
+      const pubJwk = JSON.parse(raw);
+      const algId = pubJwk.algorithmId || (pubJwk.alg === 'ES256' ? 'ECDSA-P256' : pubJwk.alg === 'ML-DSA-65' ? 'ML-DSA-65' : 'ECDSA-P256');
+      const meta = ALGORITHMS[algId] || ALGORITHMS['ECDSA-P256'];
+      const kid = pubJwk.kid || await computeKeyFingerprint(pubJwk);
+      const importedRecord = {
+        algorithmId: algId,
+        meta,
+        kid,
+        publicJwk: pubJwk,
+        privateJwk: null,
+        engineLabel: 'Imported External Public JWK',
+        pubBytesSize: utf8ToBytes(JSON.stringify(pubJwk)).length,
+        createdAt: new Date().toISOString()
+      };
+      state.keys.unshift(importedRecord);
+      state.activeKeyId = kid;
+      saveKeyringToStorage();
+      renderKeyRing();
+      logAudit('Import Public Key', 'INFO', `Imported external public key ${kid} (${algId})`);
