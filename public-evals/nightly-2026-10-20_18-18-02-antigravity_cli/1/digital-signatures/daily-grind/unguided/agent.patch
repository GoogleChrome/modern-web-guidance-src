+      <span class="audit-time">${item.time}</span>
+      <span class="audit-badge">${item.status}</span>
+      <strong class="audit-action">${item.action}:</strong>
+      <span class="audit-summary">${item.summary}</span>
+    </div>
+  `).join('');
+}
+
+function showVerificationBanner(elementId, isValid, title, details, extraMetaHtml = '') {
+  const el = document.getElementById(elementId);
+  if (!el) return;
+  el.className = `verification-banner ${isValid ? 'banner-valid' : 'banner-invalid'}`;
+  el.innerHTML = `
+    <div class="banner-header">
+      <span class="banner-icon">${isValid ? '✅ AUTHENTIC & INTACT' : '🚨 VERIFICATION FAILED'}</span>
+      <span class="banner-title">${title}</span>
+    </div>
+    <div class="banner-details">${details}</div>
+    ${extraMetaHtml ? `<div class="banner-meta">${extraMetaHtml}</div>` : ''}
+  `;
+  el.style.display = 'block';
+}
