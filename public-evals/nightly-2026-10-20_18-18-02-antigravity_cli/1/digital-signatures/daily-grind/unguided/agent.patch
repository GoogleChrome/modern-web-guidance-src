+
+function logAudit(action, status, summary) {
+  const entry = {
+    time: new Date().toLocaleTimeString(),
+    action,
+    status,
+    summary
+  };
+  state.AuditLog.unshift(entry);
+  if (state.AuditLog.length > 25) state.AuditLog.pop();
+  renderAuditLog();
+}
+
+function saveKeyringToStorage() {
+  try {
+    localStorage.setItem(STORAGE_KEY, JSON.stringify({
+      keys: state.keys,
+      activeKeyId: state.activeKeyId
+    }));
+  } catch (e) {
+    console.warn('Could not persist keyring to localStorage:', e);
+  }
+}
+
+function loadKeyringFromStorage() {
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY);
+    if (!raw) return false;
+    const parsed = JSON.parse(raw);
+    if (Array.isArray(parsed.keys) && parsed.keys.length > 0) {
+      state.keys = parsed.keys.map(k => ({
+        ...k,
+        meta: ALGORITHMS[k.algorithmId] || ALGORITHMS['ECDSA-P256']
+      }));
+      state.activeKeyId = parsed.activeKeyId || state.keys[0].kid;
+      return true;
+    }
+  } catch (e) {
+    console.warn('Could not load keyring from localStorage:', e);
+  }
+  return false;
+}
+
+export function getActiveKey() {
+  return state.keys.find(k => k.kid === state.activeKeyId) || state.keys[0] || null;
+}
+
