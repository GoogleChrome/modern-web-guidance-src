+  <script type="module">
+    const fallbackTemplate = document.createElement('template');
+    fallbackTemplate.innerHTML = `
+      <style>
+        :host {
+          display: block;
+        }
+        .card {
+          background: white;
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+        }
+        ::slotted(h3) {
+          margin-bottom: 10px;
+          color: var(--primary, #4e342e);
+        }
+        .body {
+          margin-bottom: 10px;
+        }
+        .details {
+          display: none;
+          margin-top: 12px;
+          padding-top: 12px;
+          border-top: 1px solid var(--secondary, #d7ccc8);
+          font-size: 0.9rem;
+        }
+        :host([open]) .details {
+          display: block;
+        }
+        .actions {
+          display: flex;
+          justify-content: center;
+          align-items: center;
+          gap: 10px;
+          margin-top: 15px;
+          flex-wrap: wrap;
+        }
+        .toggle-btn {
+          display: inline-block;
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 10px 20px;
+          border: none;
+          border-radius: 5px;
+          font: inherit;
+          cursor: pointer;
+          transition: background 0.3s;
+        }
+        .toggle-btn:hover {
+          background: #3e2723;
+        }
+        ::slotted(a.btn) {
+          margin-top: 0 !important;
+        }
+      </style>
+      <article class="card">
+        <slot name="header"></slot>
+        <div class="body"><slot></slot></div>
+        <div class="details" id="details">
+          <slot name="details"></slot>
+        </div>
+        <div class="actions">
+          <button type="button" id="toggle" class="toggle-btn" aria-expanded="false" aria-controls="details">Toggle Notes</button>
+          <slot name="action"></slot>
+        </div>
+      </article>
+    `;
+
+    class CoffeeCard extends HTMLElement {
+      static observedAttributes = ['open'];
+
+      constructor() {
+        super();
+        // Reuse the server-rendered shadow root if present; only create one if absent.
+        if (!this.shadowRoot) {
+          this.attachShadow({ mode: 'open' });
+          const dsdTemplate = !Object.hasOwn(HTMLTemplateElement.prototype, 'shadowRootMode')
+            ? this.querySelector('template[shadowrootmode]')
+            : null;
+          if (dsdTemplate) {
+            this.shadowRoot.append(dsdTemplate.content.cloneNode(true));
+            dsdTemplate.remove();
+          } else {
+            this.shadowRoot.append(fallbackTemplate.content.cloneNode(true));
+          }
+        }
+
+        // Hydrate in place: attach listeners once against existing markup without re-rendering.
+        this.shadowRoot.getElementById('toggle')
+          ?.addEventListener('click', () => {
+            this.open = !this.open;
+            this.dispatchEvent(new CustomEvent('change', { detail: { open: this.open }, bubbles: true }));
+          });
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+
+      set open(val) {
+        this.toggleAttribute('open', !!val);
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (name === 'open' && oldVal !== newVal) {
+          this.shadowRoot?.getElementById('toggle')
+            ?.setAttribute('aria-expanded', String(this.open));
+        }
+      }
+    }
+
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
