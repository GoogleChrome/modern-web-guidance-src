index 0000000..f7fae68
--- /dev/null
+++ b/rating-input.js
@@ -0,0 +1,506 @@
+const SUPPORTS_FACE =
+  typeof HTMLElement !== 'undefined' &&
+  'attachInternals' in HTMLElement.prototype &&
+  typeof ElementInternals !== 'undefined' &&
+  'setFormValue' in ElementInternals.prototype;
+
+export class RatingInput extends HTMLElement {
+  // MANDATORY: opt in so ElementInternals form APIs and formXxxCallback hooks are enabled.
+  static formAssociated = true;
+  static observedAttributes = ['value', 'required', 'min', 'max'];
+
+  #internals = null;
+  #value = '';
+  #defaultValue = '';
+  #initialized = false;
+  #disabled = false;
+  #fallbackInput = null;
+
+  constructor() {
+    super();
+    if (SUPPORTS_FACE) {
+      this.#internals = this.attachInternals();
+    }
+    this.attachShadow({ mode: 'open', delegatesFocus: true });
+    this.#render();
+  }
+
+  connectedCallback() {
+    if (!this.#initialized) {
+      this.#defaultValue = this.getAttribute('value') ?? '';
+      if (this.#defaultValue && !this.#value) {
+        this.#value = this.#defaultValue;
+      }
+      this.#initialized = true;
+    }
+
+    if (!SUPPORTS_FACE) {
+      this.#ensureFallbackInput();
+    }
+
+    this.#syncFormValue();
+    this.#updateUI();
+    this.#validate();
+  }
+
+  disconnectedCallback() {
+    if (this.#fallbackInput) {
+      this.#fallbackInput.remove();
+    }
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+
+    if (name === 'value') {
+      const next = newVal ?? '';
+      if (this.#value !== next) {
+        this.#value = next;
+        this.#syncFormValue();
+        this.#updateUI();
+      }
+    }
+
+    if (name === 'min' || name === 'max') {
+      this.#renderButtons();
+      this.#updateUI();
+    }
+
+    this.#validate();
+  }
+
+  get value() {
+    return this.#value;
+  }
+
+  set value(v) {
+    const next = v == null ? '' : String(v);
+    if (this.#value === next) return;
+    this.#value = next;
+    this.#syncFormValue();
+    this.#updateUI();
+    this.#validate();
+  }
+
+  get required() {
+    return this.hasAttribute('required');
+  }
+
+  set required(on) {
+    this.toggleAttribute('required', Boolean(on));
+  }
+
+  get min() {
+    return Number(this.getAttribute('min')) || 1;
+  }
+
+  set min(v) {
+    this.setAttribute('min', String(v));
+  }
+
+  get max() {
+    return Number(this.getAttribute('max')) || 5;
+  }
+
+  set max(v) {
+    this.setAttribute('max', String(v));
+  }
+
+  get form() {
+    return this.#internals ? this.#internals.form : this.closest('form');
+  }
+
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+
+  set name(v) {
+    if (v) {
+      this.setAttribute('name', v);
+    } else {
+      this.removeAttribute('name');
+    }
+    if (this.#fallbackInput) {
+      this.#fallbackInput.name = this.name;
+    }
+  }
+
+  get type() {
+    return this.localName;
+  }
+
+  get validity() {
+    return this.#internals ? this.#internals.validity : this.#fallbackInput?.validity;
+  }
+
+  get validationMessage() {
+    return this.#internals ? this.#internals.validationMessage : (this.#fallbackInput?.validationMessage ?? '');
+  }
+
+  get willValidate() {
+    return this.#internals ? this.#internals.willValidate : (this.#fallbackInput?.willValidate ?? false);
+  }
+
+  checkValidity() {
+    return this.#internals ? this.#internals.checkValidity() : (this.#fallbackInput?.checkValidity() ?? true);
+  }
+
+  reportValidity() {
+    return this.#internals ? this.#internals.reportValidity() : (this.#fallbackInput?.reportValidity() ?? true);
+  }
+
+  setCustomValidity(message) {
+    if (!this.#internals) {
+      this.#fallbackInput?.setCustomValidity(message);
+      return;
+    }
+    if (message) {
+      this.#internals.setValidity(
+        { customError: true },
+        message,
+        this.#validationAnchor(),
+      );
+    } else {
+      this.#validate();
+    }
+  }
+
+  // FACE lifecycle hooks
+  formAssociatedCallback(_form) {
+    this.#syncFormValue();
+    this.#validate();
+  }
+
+  formResetCallback() {
+    this.value = this.#defaultValue;
+    if (this.#internals?.states) {
+      this.#internals.states.delete('invalid');
+    }
+  }
+
+  formDisabledCallback(disabled) {
+    this.#disabled = disabled;
+    // Disable internal controls so they leave the tab order and ignore clicks.
+    // Do NOT toggle `disabled` on `this`, or a `<fieldset disabled>` toggle will
+    // leave the host permanently stuck with its own `disabled` attribute.
+    for (const btn of this.shadowRoot.querySelectorAll('button')) {
+      btn.disabled = disabled;
+    }
+    if (this.#fallbackInput) {
+      this.#fallbackInput.disabled = disabled;
+    }
+  }
+
+  formStateRestoreCallback(state, _mode) {
+    this.value = typeof state === 'string' ? state : '';
+  }
+
+  #syncFormValue() {
+    if (this.#internals) {
+      this.#internals.setFormValue(this.#value || null, this.#value || null);
+    } else if (this.#fallbackInput) {
+      this.#fallbackInput.value = this.#value;
+    }
+  }
+
+  #validationAnchor() {
+    return (
+      this.shadowRoot.querySelector('button[tabindex="0"]') ||
+      this.shadowRoot.querySelector('button') ||
+      undefined
+    );
+  }
+
+  #validate() {
+    const anchor = this.#validationAnchor();
+    const numericVal = Number(this.#value);
+
+    if (this.hasAttribute('required') && !this.#value) {
+      if (this.#internals) {
+        this.#internals.setValidity(
+          { valueMissing: true },
+          'Please choose a rating.',
+          anchor,
+        );
+      } else if (this.#fallbackInput) {
+        this.#fallbackInput.required = true;
+        this.#fallbackInput.setCustomValidity('Please choose a rating.');
+      }
+      this.#internals?.states?.add('invalid');
+    } else if (this.#value && (Number.isNaN(numericVal) || numericVal < this.min)) {
+      if (this.#internals) {
+        this.#internals.setValidity(
+          { rangeUnderflow: true },
+          `Rating must be at least ${this.min}.`,
+          anchor,
+        );
+      }
+      this.#internals?.states?.add('invalid');
+    } else if (this.#value && numericVal > this.max) {
+      if (this.#internals) {
+        this.#internals.setValidity(
+          { rangeOverflow: true },
+          `Rating must be at most ${this.max}.`,
+          anchor,
+        );
+      }
+      this.#internals?.states?.add('invalid');
+    } else {
+      if (this.#internals) {
+        this.#internals.setValidity({});
+      } else if (this.#fallbackInput) {
+        this.#fallbackInput.setCustomValidity('');
+      }
+      this.#internals?.states?.delete('invalid');
+    }
+  }
+
+  #ensureFallbackInput() {
+    if (this.#fallbackInput) return;
+    const input = document.createElement('input');
+    input.type = 'text';
+    input.name = this.name;
+    input.value = this.#value;
+    input.required = this.required;
+    input.tabIndex = -1;
+    input.setAttribute('aria-hidden', 'true');
+    Object.assign(input.style, {
+      position: 'absolute',
+      clipPath: 'inset(50%)',
+      overflow: 'hidden',
+      width: '1px',
+      height: '1px',
+      margin: '-1px',
+      padding: '0',
+      border: '0',
+      whiteSpace: 'nowrap',
+    });
+    this.appendChild(input);
+    this.#fallbackInput = input;
+  }
+
+  #selectRating(newValue) {
+    if (this.#disabled) return;
+    const strVal = String(newValue);
+    const changed = this.#value !== strVal;
+    this.value = strVal;
+
+    // Platform conventions: dispatch built-in `input` (InputEvent) and `change` (Event).
+    this.dispatchEvent(
+      new InputEvent('input', { bubbles: true, composed: true, data: strVal }),
+    );
+    if (changed) {
+      this.dispatchEvent(new Event('change', { bubbles: true, composed: true }));
+    }
+  }
+
+  #handleKeyDown(event) {
+    if (this.#disabled) return;
+    const min = this.min;
+    const max = this.max;
+    const current = Number(this.#value) || 0;
+    let next = current;
+
+    switch (event.key) {
+      case 'ArrowRight':
+      case 'ArrowUp':
+        next = current < min ? min : Math.min(max, current + 1);
+        break;
+      case 'ArrowLeft':
+      case 'ArrowDown':
+        next = current <= min ? min : Math.max(min, current - 1);
+        break;
+      case 'Home':
+        next = min;
+        break;
+      case 'End':
+        next = max;
+        break;
+      default:
+        return;
+    }
+
+    event.preventDefault();
+    this.#selectRating(next);
+    const targetBtn = this.shadowRoot.querySelector(`button[data-value="${next}"]`);
+    targetBtn?.focus();
+  }
+
+  #render() {
+    this.shadowRoot.innerHTML = `
+      <style>
+        :host {
+          display: inline-block;
+          font-family: inherit;
+        }
+        :host(:disabled) .group {
+          opacity: 0.55;
+          cursor: not-allowed;
+        }
+        .group {
+          display: inline-flex;
+          align-items: center;
+          gap: 0.5rem;
+          padding: 0.35rem 0.5rem;
+          border-radius: 6px;
+          border: 1.5px solid #8d6e63;
+          background: #fff;
+          transition: border-color 0.2s, box-shadow 0.2s;
+        }
+        :host(:invalid) .group {
+          border-color: #c62828;
+        }
+        :host(:valid) .group {
+          border-color: #2e7d32;
+        }
+        button {
+          appearance: none;
+          background: transparent;
+          border: 2px solid transparent;
+          border-radius: 6px;
+          min-width: 48px;
+          min-height: 48px;
+          padding: 0.25rem;
+          font-size: 1.5rem;
+          line-height: 1;
+          cursor: pointer;
+          color: #d7ccc8;
+          display: inline-flex;
+          align-items: center;
+          justify-content: center;
+          transition: transform 0.15s, color 0.15s, border-color 0.15s;
+        }
+        button[aria-checked="true"],
+        button.filled {
+          color: #4e342e;
+        }
+        button:hover:not(:disabled) {
+          transform: scale(1.1);
+          color: #6d4c41;
+        }
+        button:focus-visible {
+          outline: 3px solid #4e342e;
+          outline-offset: 2px;
+        }
+        button:disabled {
+          cursor: not-allowed;
+        }
+        .status {
+          font-size: 0.9rem;
+          font-weight: 600;
+          color: #3e2723;
+          margin-inline-start: 0.5rem;
+          min-width: 4.5rem;
+        }
+      </style>
+      <div class="group" role="radiogroup" aria-label="Brew Rating">
+        <div class="buttons" style="display: contents;"></div>
+        <span class="status" aria-live="polite">Unrated</span>
+      </div>
+    `;
+
+    this.#renderButtons();
+
+    this.shadowRoot.querySelector('.group').addEventListener('keydown', (e) => {
+      this.#handleKeyDown(e);
+    });
+  }
+
+  #renderButtons() {
+    const container = this.shadowRoot?.querySelector('.buttons');
+    if (!container) return;
+    container.innerHTML = '';
+
+    const min = this.min;
+    const max = this.max;
+
+    for (let i = min; i <= max; i++) {
+      const btn = document.createElement('button');
+      btn.type = 'button';
+      btn.dataset.value = String(i);
+      btn.setAttribute('role', 'radio');
+      btn.setAttribute('aria-label', `${i} out of ${max} coffee beans`);
+      btn.setAttribute('aria-checked', 'false');
+      btn.tabIndex = i === min ? 0 : -1;
+      btn.disabled = this.#disabled;
+      btn.textContent = '☕';
+      btn.addEventListener('click', () => {
+        this.#selectRating(i);
+        btn.focus();
+      });
+      container.appendChild(btn);
+    }
+  }
+
+  #updateUI() {
+    const buttons = this.shadowRoot?.querySelectorAll('button');
+    if (!buttons || buttons.length === 0) return;
+
+    const current = Number(this.#value) || 0;
+    const min = this.min;
+    const max = this.max;
+
+    buttons.forEach((btn) => {
+      const btnVal = Number(btn.dataset.value);
+      const isSelected = current > 0 && btnVal === current;
+      const isFilled = current > 0 && btnVal <= current;
+
+      btn.classList.toggle('filled', isFilled);
+      btn.setAttribute('aria-checked', isSelected ? 'true' : 'false');
+      // Maintain roving tabindex so the selected button (or first button when empty) is focusable
+      btn.tabIndex = (current > 0 ? isSelected : btnVal === min) ? 0 : -1;
+    });
+
+    const status = this.shadowRoot.querySelector('.status');
+    if (status) {
+      status.textContent = current > 0 ? `${current} / ${max}` : 'Unrated';
+    }
+  }
+}
+
+if (!customElements.get('rating-input')) {
+  customElements.define('rating-input', RatingInput);
+}
+
+// Wire up the form and demonstration actions
+const form = document.getElementById('review-form');
+const fieldset = document.getElementById('review-fieldset');
+const ratingEl = document.getElementById('brew-rating');
+const outputEl = document.getElementById('submission-output');
+const toggleDisabledBtn = document.getElementById('toggle-disabled-btn');
+const restoreStateBtn = document.getElementById('restore-state-btn');
+
+if (form && outputEl) {
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    if (!form.reportValidity()) {
+      return;
+    }
+
+    const formData = new FormData(form);
+    const payload = Object.fromEntries(formData.entries());
+
+    outputEl.hidden = false;
+    outputEl.textContent = `Submitted FormData — Customer: ${payload.customer_name}, Drink: ${payload.favorite_drink}, Rating: ${payload.rating}/5${payload.notes ? `, Notes: "${payload.notes}"` : ''}`;
+  });
+
+  form.addEventListener('reset', () => {
+    outputEl.hidden = true;
+    outputEl.textContent = '';
+  });
+}
+
+if (toggleDisabledBtn && fieldset) {
+  toggleDisabledBtn.addEventListener('click', () => {
+    const nextDisabled = !fieldset.disabled;
+    fieldset.disabled = nextDisabled;
+    toggleDisabledBtn.setAttribute('aria-pressed', String(nextDisabled));
+    toggleDisabledBtn.textContent = nextDisabled ? 'Enable Fieldset' : 'Disable Fieldset';
+  });
+}
+
+if (restoreStateBtn && ratingEl) {
+  restoreStateBtn.addEventListener('click', () => {
+    ratingEl.formStateRestoreCallback('4', 'restore');
+  });
+}
