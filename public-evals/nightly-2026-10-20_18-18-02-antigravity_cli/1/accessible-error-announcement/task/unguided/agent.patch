+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    const errorMsg = document.getElementById('newsletter-error');
+    const successMsg = document.getElementById('newsletter-success');
+
+    function syncAriaInvalid() {
+      const isUserInvalid = emailInput.matches(':user-invalid');
+      emailInput.setAttribute('aria-invalid', String(isUserInvalid));
+      if (isUserInvalid && emailInput.validationMessage) {
+        errorMsg.textContent = emailInput.validationMessage;
+      } else {
+        errorMsg.textContent = 'Please enter a valid email address.';
+      }
+    }
+
+    emailInput.addEventListener('blur', syncAriaInvalid);
+    emailInput.addEventListener('input', () => {
+      successMsg.style.display = 'none';
+      syncAriaInvalid();
+    });
+    emailInput.addEventListener('invalid', syncAriaInvalid);
+
+    newsletterForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (! newsletterForm.checkValidity()) {
+        syncAriaInvalid();
+        emailInput.focus();
+        return;
+      }
+      emailInput.setAttribute('aria-invalid', 'false');
+      successMsg.style.display = 'block';
+      newsletterForm.reset();
+    });
+  </script>
+
 </body>
 
 </html>
