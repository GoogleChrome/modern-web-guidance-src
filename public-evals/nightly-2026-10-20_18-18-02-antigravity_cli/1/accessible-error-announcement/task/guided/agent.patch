+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+
+    // Sync aria-invalid with the CSS :user-invalid state
+    const syncAria = (el) => {
+      if (!el.matches?.('input')) return;
+      el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+    };
+
+    // Update on blur (to show error after interaction) and input (to clear it immediately)
+    newsletterForm.addEventListener('blur', (e) => syncAria(e.target), true);
+    newsletterForm.addEventListener('input', (e) => {
+      if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+    });
+    newsletterForm.addEventListener('invalid', (e) => syncAria(e.target), true);
+    newsletterForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      newsletterForm.querySelectorAll('input').forEach(syncAria);
+    });
+  </script>
+
 </body>
 
