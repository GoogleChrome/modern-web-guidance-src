+    /* Floating Draggable Order Tracker Panel */
+    .floating-panel {
+      position: fixed;
+      inset-inline-end: 24px;
+      inset-block-end: 24px;
+      width: min(320px, calc(100vw - 32px));
+      background: white;
+      border-radius: 10px;
