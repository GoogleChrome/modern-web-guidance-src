+  <aside id="order-tracker" class="floating-panel" aria-labelledby="order-tracker-title">
+    <div class="floating-panel-header">
+      <h2 id="order-tracker-title" class="floating-panel-title">Active Order #402</h2>
+      <button
+        type="button"
+        id="order-tracker-handle"
+        class="drag-handle"
+        aria-label="Move order tracker panel; use arrow keys to reposition"
+        hidden
+      >
+        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor">
+          <circle cx="5" cy="3" r="1.5" />
+          <circle cx="11" cy="3" r="1.5" />
+          <circle cx="5" cy="8" r="1.5" />
+          <circle cx="11" cy="8" r="1.5" />
+          <circle cx="5" cy="13" r="1.5" />
