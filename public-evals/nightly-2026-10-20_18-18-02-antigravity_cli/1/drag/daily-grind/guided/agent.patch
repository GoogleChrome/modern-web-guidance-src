+        </svg>
+        <span>Move</span>
+      </button>
+    </div>
+    <div class="floating-panel-body">
+      <span class="order-status-badge">Steaming milk • ~3 mins</span>
+      <p><strong>1x Maple Oat Latte</strong> (16 oz, Extra Hot)</p>
+      <p>Pickup counter: Downtown Roastery</p>
+      <div class="floating-panel-actions">
+        <a href="/order-status/402" class="btn">Track Order</a>
+      </div>
+    </div>
+  </aside>
+
+  <script>
+    (() => {
+      const draggable = document.getElementById('order-tracker');
+      const handle = document.getElementById('order-tracker-handle');
+      if (!draggable || !handle) return;
+
+      // Progressive enhancement: reveal the standalone drag handle once JS initializes
+      handle.hidden = false;
+
+      let startX = 0;
+      let startY = 0;
+      let offsetX = 0;
+      let offsetY = 0;
+      let isDragging = false;
+      let hasCustomPosition = false;
+      const DRAG_THRESHOLD_PX = 4;
+      const KEYBOARD_STEP_PX = 15;
+
+      function moveTo(left, top) {
+        const maxLeft = Math.max(0, window.innerWidth - draggable.offsetWidth);
+        const maxTop = Math.max(0, window.innerHeight - draggable.offsetHeight);
+
+        draggable.style.insetInlineEnd = 'auto';
+        draggable.style.insetBlockEnd = 'auto';
+        draggable.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+        draggable.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+        hasCustomPosition = true;
+      }
+
+      handle.addEventListener('pointerdown', (event) => {
+        if (event.button !== 0 || event.target.closest('input, select, textarea, a')) return;
+
+        const rect = draggable.getBoundingClientRect();
+        startX = event.clientX;
+        startY = event.clientY;
+        offsetX = event.clientX - rect.left;
+        offsetY = event.clientY - rect.top;
+        isDragging = false;
+        handle.setPointerCapture(event.pointerId);
+      });
+
+      handle.addEventListener('pointermove', (event) => {
+        if (!handle.hasPointerCapture(event.pointerId)) return;
+
+        if (!isDragging) {
+          const distance = Math.hypot(event.clientX - startX, event.clientY - startY);
+          if (distance < DRAG_THRESHOLD_PX) return;
+          isDragging = true;
+          handle.classList.add('dragging');
+        }
+
+        moveTo(event.clientX - offsetX, event.clientY - offsetY);
+      });
+
+      handle.addEventListener('lostpointercapture', () => {
+        isDragging = false;
+        handle.classList.remove('dragging');
+      });
+
+      handle.addEventListener('keydown', (event) => {
+        const deltas = {
+          ArrowLeft: [-KEYBOARD_STEP_PX, 0],
+          ArrowRight: [KEYBOARD_STEP_PX, 0],
+          ArrowUp: [0, -KEYBOARD_STEP_PX],
+          ArrowDown: [0, KEYBOARD_STEP_PX],
+        };
+
+        const delta = deltas[event.key];
+        if (!delta) return;
+
+        event.preventDefault();
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left + delta[0], rect.top + delta[1]);
+      });
+
+      function reclampPosition() {
+        if (!hasCustomPosition) return;
+        const rect = draggable.getBoundingClientRect();
+        moveTo(rect.left, rect.top);
+      }
+
+      window.addEventListener('resize', reclampPosition);
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const resizeObserver = new ResizeObserver(reclampPosition);
+        resizeObserver.observe(draggable);
+      }
+    })();
+  </script>
+
