+  <aside id="floating-widget" class="floating-widget" aria-label="Quick Order &amp; Rewards">
+    <div class="floating-widget-header">
+      <span class="drag-handle-icon">
+        <span class="drag-dots" aria-hidden="true">⋮⋮</span>
+        <span>☕ Daily Grind Perks</span>
+      </span>
+      <button type="button" class="floating-widget-close" id="toggle-widget" title="Minimize / Expand" aria-label="Minimize or Expand">−</button>
+    </div>
+    <div class="floating-widget-body">
+      <p>Get <strong>20% off</strong> your next Maple Oat Latte when you order ahead!</p>
+      <div class="floating-widget-actions">
+        <a href="/order-online" class="btn-sm" draggable="false">Claim Offer</a>
+        <span style="font-size: 0.75rem; opacity: 0.75;">Drag to move</span>
+      </div>
+    </div>
+  </aside>
+
+  <script>
+    (function () {
+      const widget = document.getElementById('floating-widget');
+      const toggleBtn = document.getElementById('toggle-widget');
+
+      let isDragging = false;
+      let startX = 0;
+      let startY = 0;
+      let initialLeft = 0;
+      let initialTop = 0;
+
+      function clampToViewport(left, top) {
+        const rect = widget.getBoundingClientRect();
+        const maxLeft = Math.max(0, window.innerWidth - rect.width);
+        const maxTop = Math.max(0, window.innerHeight - rect.height);
+        return {
+          left: Math.min(Math.max(0, left), maxLeft),
+          top: Math.min(Math.max(0, top), maxTop)
+        };
+      }
+
+      function setPosition(left, top) {
+        const clamped = clampToViewport(left, top);
+        widget.style.left = clamped.left + 'px';
+        widget.style.top = clamped.top + 'px';
+        widget.style.right = 'auto';
+        widget.style.bottom = 'auto';
+      }
+
+      function isInteractiveTarget(target) {
+        return Boolean(target.closest('a, button, input, textarea, select'));
+      }
+
+      function onDragStart(clientX, clientY, target) {
+        if (isInteractiveTarget(target)) return false;
+
+        const rect = widget.getBoundingClientRect();
+        isDragging = true;
+        startX = clientX;
+        startY = clientY;
+        initialLeft = rect.left;
+        initialTop = rect.top;
+
+        setPosition(initialLeft, initialTop);
+        widget.classList.add('dragging');
+        return true;
+      }
+
+      function onDragMove(clientX, clientY) {
+        if (!isDragging) return;
+        const dx = clientX - startX;
+        const dy = clientY - startY;
+        setPosition(initialLeft + dx, initialTop + dy);
+      }
+
+      function onDragEnd() {
+        if (!isDragging) return;
+        isDragging = false;
+        widget.classList.remove('dragging');
+      }
+
+      // Pointer Events
+      widget.addEventListener('pointerdown', function (e) {
+        if (e.button !== undefined && e.button !== 0) return;
+        if (onDragStart(e.clientX, e.clientY, e.target)) {
+          if (widget.setPointerCapture && e.pointerId !== undefined) {
+            try {
+              widget.setPointerCapture(e.pointerId);
+            } catch (_) {}
+          }
+          e.preventDefault();
+        }
+      });
+
+      window.addEventListener('pointermove', function (e) {
+        if (!isDragging) return;
+        onDragMove(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointerup', onDragEnd);
+      window.addEventListener('pointercancel', onDragEnd);
+
+      // Mouse Events fallback
+      widget.addEventListener('mousedown', function (e) {
+        if (e.button !== 0 || isDragging) return;
+        if (onDragStart(e.clientX, e.clientY, e.target)) {
+          e.preventDefault();
+        }
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (!isDragging) return;
+        onDragMove(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('mouseup', onDragEnd);
+
+      // Touch Events fallback
+      widget.addEventListener('touchstart', function (e) {
+        if (isDragging || e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        if (onDragStart(touch.clientX, touch.clientY, e.target)) {
+          e.preventDefault();
+        }
+      }, { passive: false });
+
+      window.addEventListener('touchmove', function (e) {
+        if (!isDragging || e.touches.length !== 1) return;
+        const touch = e.touches[0];
+        onDragMove(touch.clientX, touch.clientY);
+        e.preventDefault();
+      }, { passive: false });
+
+      window.addEventListener('touchend', onDragEnd);
+      window.addEventListener('touchcancel', onDragEnd);
+
+      // Keep within viewport on window resize if already positioned via left/top
+      window.addEventListener('resize', function () {
+        if (widget.style.left && widget.style.top) {
+          const currentLeft = parseFloat(widget.style.left);
+          const currentTop = parseFloat(widget.style.top);
+          if (!Number.isNaN(currentLeft) && !Number.isNaN(currentTop)) {
+            setPosition(currentLeft, currentTop);
+          }
+        }
+      });
+
+      // Minimize / Expand toggle
+      if (toggleBtn) {
+        toggleBtn.addEventListener('click', function () {
+          const minimized = widget.classList.toggle('minimized');
+          toggleBtn.textContent = minimized ? '+' : '−';
+          if (widget.style.left && widget.style.top) {
+            setPosition(parseFloat(widget.style.left), parseFloat(widget.style.top));
+          }
+        });
+      }
+    })();
+  </script>
+
 </body>
 
