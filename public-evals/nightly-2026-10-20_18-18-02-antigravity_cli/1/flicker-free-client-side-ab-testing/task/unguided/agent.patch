+
+  <!-- Anti-flicker snippet: hides page until A/B variant is applied or timeout elapses -->
+  <style>
+    .async-hide {
+      opacity: 0 !important;
+      visibility: hidden !important;
+      pointer-events: none !important;
+    }
+  </style>
+  <script>
+    (function(d, c, t) {
+      var h = d.documentElement;
+      h.classList.add(c);
+      var revealed = false;
+      function reveal() {
+        if (revealed) return;
+        revealed = true;
+        h.classList.remove(c);
+      }
+      window.revealExperimentContent = reveal;
+      var timer = setTimeout(reveal, t);
+      window.onExperimentReady = function() {
+        clearTimeout(timer);
+        reveal();
+      };
+      d.addEventListener('experiment:ready', window.onExperimentReady);
+      d.addEventListener('experiment:applied', window.onExperimentReady);
+    })(document, 'async-hide', 3000);
+  </script>
+
+  <!-- Synchronous A/B testing SDK in <head> to prevent Flash of Original Content (FOOC) -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    onload="window.onExperimentReady && window.onExperimentReady()"
+    onerror="window.onExperimentReady && window.onExperimentReady()"
+  ></script>
+
