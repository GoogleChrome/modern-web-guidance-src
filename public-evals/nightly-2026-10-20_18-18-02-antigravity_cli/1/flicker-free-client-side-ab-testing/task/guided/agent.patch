diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,318 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Nexus Cloud — Ship Faster with Confidence</title>
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+
+  <!--
+    Load the experimentation script in <head> with both `async` and `blocking="render"`:
+    - `async`: Prevents blocking the HTML parser so the DOM builds in parallel.
+    - `blocking="render"`: Holds first paint until the script executes, ensuring
+      experiment variants are applied before any content is rendered.
+  -->
+  <script
+    src="https://cdn.example.com/experiment-sdk.js"
+    async
+    blocking="render"
+  ></script>
+
+  <script>
+    // Feature-detect support for `blocking="render"` and apply a lightweight
+    // anti-flicker fallback only in browsers where `blocking` is unsupported.
+    if (!Object.hasOwn(HTMLScriptElement.prototype, 'blocking')) {
+      document.documentElement.classList.add('ab-loading');
+
+      setTimeout(() => {
+        document.documentElement.classList.remove('ab-loading');
+      }, 4000);
+    }
+
+    // Callback invoked by the experiment SDK once the variant is applied
+    // to reveal the page immediately in fallback browsers.
+    window.onExperimentReady = function onExperimentReady() {
+      document.documentElement.classList.remove('ab-loading');
+    };
+  </script>
+
+  <style>
+    @layer reset, base, theme, components;
+
+    /* Anti-flicker fallback only active when `blocking="render"` is unsupported */
+    .ab-loading {
+      opacity: 0 !important;
+    }
+
+    @layer theme {
+      :root {
+        color-scheme: light dark;
+        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
+        --surface-bg: light-dark(#f8fafc, #0b0f19);
+        --surface-card: light-dark(#ffffff, #111827);
+        --text-primary: light-dark(#0f172a, #f8fafc);
+        --text-secondary: light-dark(#475569, #94a3b8);
+        --border-subtle: light-dark(#e2e8f0, #1e293b);
+        --accent-bg: #2563eb;
+        --accent-bg-hover: #1d4ed8;
+        --accent-text: #ffffff;
+        --badge-bg: light-dark(#dbeafe, #1e3a8a);
+        --badge-text: light-dark(#1e40af, #bfdbfe);
+      }
+
+      /* Variant B overrides activated when experiment SDK sets data-variant="b" on <html> */
+      :root[data-variant="b"] {
+        --accent-bg: #059669;
+        --accent-bg-hover: #047857;
+        --badge-bg: light-dark(#d1fae5, #064e3b);
+        --badge-text: light-dark(#065f46, #a7f3d0);
+      }
+    }
+
+    @layer base {
+      body {
+        margin: 0;
+        font-family: var(--font-sans);
+        background-color: var(--surface-bg);
+        color: var(--text-primary);
+        line-height: 1.6;
+        -webkit-font-smoothing: antialiased;
+      }
+
+      h1, h2, h3, p {
+        margin-block: 0;
+      }
+
+      img {
+        max-inline-size: 100%;
+        block-size: auto;
+        display: block;
+      }
+    }
+
+    @layer components {
+      .site-header {
+        border-block-end: 1px solid var(--border-subtle);
+        background-color: var(--surface-card);
+      }
+
+      .nav-container {
+        max-inline-size: 75rem;
+        margin-inline: auto;
+        padding-block: 1rem;
+        padding-inline: 1.5rem;
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 1rem;
+      }
+
+      .brand {
+        font-weight: 700;
+        font-size: 1.25rem;
+        color: var(--text-primary);
+        text-decoration: none;
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+      }
+
+      .brand-mark {
+        inline-size: 1.75rem;
+        block-size: 1.75rem;
+        border-radius: 0.5rem;
+        background-color: var(--accent-bg);
+        display: inline-grid;
+        place-items: center;
+        color: var(--accent-text);
+        font-weight: 800;
+        font-size: 0.95rem;
+      }
+
+      .nav-links {
+        list-style: none;
+        margin: 0;
+        padding: 0;
+        display: flex;
+        align-items: center;
+        gap: 1.75rem;
+
+        & a {
+          color: var(--text-secondary);
+          text-decoration: none;
+          font-size: 0.95rem;
+          font-weight: 500;
+          transition: color 0.15s ease;
+
+          &:hover {
+            color: var(--text-primary);
+          }
+        }
+      }
+
+      .hero {
+        max-inline-size: 75rem;
+        margin-inline: auto;
+        padding-block: clamp(3rem, 7vw, 6rem);
+        padding-inline: 1.5rem;
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
+        align-items: center;
+        gap: clamp(2rem, 5vw, 4rem);
+      }
+
+      .hero-content {
+        display: flex;
+        flex-direction: column;
+        align-items: flex-start;
+        gap: 1.5rem;
+      }
+
+      .hero-badge {
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        padding-block: 0.35rem;
+        padding-inline: 0.85rem;
+        border-radius: 9999px;
+        background-color: var(--badge-bg);
+        color: var(--badge-text);
+        font-size: 0.85rem;
+        font-weight: 600;
+      }
+
+      .hero-title {
+        font-size: clamp(2.25rem, 4.5vw + 0.5rem, 3.75rem);
+        line-height: 1.1;
+        letter-spacing: -0.025em;
+        font-weight: 800;
+      }
+
+      .hero-subtitle {
+        font-size: clamp(1.05rem, 1.25vw, 1.25rem);
+        color: var(--text-secondary);
+        max-inline-size: 55ch;
+      }
+
+      .hero-actions {
+        display: flex;
+        flex-wrap: wrap;
+        align-items: center;
+        gap: 1rem;
+        margin-block-start: 0.5rem;
+      }
+
+      .cta-button {
+        appearance: none;
+        border: none;
+        border-radius: 0.625rem;
+        padding-block: 0.9rem;
+        padding-inline: 1.75rem;
+        font-family: inherit;
+        font-size: 1rem;
+        font-weight: 600;
+        background-color: var(--accent-bg);
+        color: var(--accent-text);
+        cursor: pointer;
+        display: inline-flex;
+        align-items: center;
+        gap: 0.5rem;
+        box-shadow: 0 4px 12px rgb(37 99 235 / 0.25);
+        transition: background-color 0.15s ease, transform 0.15s ease;
+
+        &:hover:not(:disabled) {
+          background-color: var(--accent-bg-hover);
+          transform: translateY(-1px);
+        }
+
+        &:focus-visible {
+          outline: 2px solid var(--accent-bg);
+          outline-offset: 3px;
+        }
+      }
+
+      .hero-meta {
+        font-size: 0.875rem;
+        color: var(--text-secondary);
+      }
+
+      .hero-media {
+        margin: 0;
+        border-radius: 1rem;
+        overflow: hidden;
+        border: 1px solid var(--border-subtle);
+        background-color: var(--surface-card);
+        box-shadow: 0 20px 40px -15px rgb(15 23 42 / 0.15);
+
+        & img {
+          inline-size: 100%;
+          aspect-ratio: 4 / 3;
+          object-fit: cover;
+        }
+      }
+    }
+  </style>
+</head>
+<body>
+  <header class="site-header">
+    <nav class="nav-container" aria-label="Main navigation">
+      <a href="/" class="brand">
+        <span class="brand-mark" aria-hidden="true">N</span>
+        <span>Nexus Cloud</span>
+      </a>
+      <ul class="nav-links">
+        <li><a href="#features">Features</a></li>
+        <li><a href="#solutions">Solutions</a></li>
+        <li><a href="#pricing">Pricing</a></li>
+        <li><a href="#docs">Documentation</a></li>
+      </ul>
+    </nav>
+  </header>
+
+  <main>
+    <section class="hero" aria-labelledby="hero-heading">
+      <div class="hero-content" data-experiment-container="hero">
+        <span class="hero-badge" data-experiment-target="hero-badge">
+          New: Edge Deployment Engine 2.0
+        </span>
+        <h1 id="hero-heading" class="hero-title" data-experiment-target="hero-title">
+          Deploy globally in seconds, scale effortlessly.
+        </h1>
+        <p class="hero-subtitle" data-experiment-target="hero-subtitle">
+          Automate your infrastructure workflow from commit to production with zero-config previews, instant rollbacks, and real-time edge telemetry.
+        </p>
+        <div class="hero-actions">
+          <button
+            type="button"
+            id="hero-cta"
+            class="cta-button"
+            data-experiment-target="hero-cta"
+          >
+            Start Free Trial
+            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+              <path d="M5 12h14"></path>
+              <path d="m12 5 7 7-7 7"></path>
+            </svg>
+          </button>
+        </div>
+        <p class="hero-meta">No credit card required · 14-day full-feature trial</p>
+      </div>
+
+      <figure class="hero-media">
+        <img
+          src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80"
+          srcset="
+            https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=600&q=80 600w,
+            https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=1200&q=80 1200w
+          "
+          sizes="(max-width: 768px) 100vw, 50vw"
+          alt="Analytics dashboard displaying real-time deployment metrics and throughput charts"
+          width="1200"
+          height="900"
+          fetchpriority="high"
+        >
+      </figure>
+    </section>
+  </main>
+</body>
+</html>
