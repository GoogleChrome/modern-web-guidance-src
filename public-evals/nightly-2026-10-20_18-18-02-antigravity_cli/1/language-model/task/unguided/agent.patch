+  <script>
+    // Modern Client-Side Built-in AI (Prompt API / LanguageModel) Implementation
+    let activeSession = null;
+    let clonedSessions = [];
+    let currentAbortController = null;
+
+    const SYSTEM_PROMPT =
+      "You are the friendly expert Barista at The Daily Grind artisanal coffee shop. " +
+      "Answer questions about our signature drinks: " +
+      "1) Maple Oat Latte: Espresso blended with creamy oat milk and real Vermont maple syrup. " +
+      "2) Cold Brew: Artisanal coffee steeped for 18 hours for maximum smoothness and low acidity. " +
+      "Keep answers concise, helpful, and welcoming.";
+
+    const FEEDBACK_SCHEMA = {
+      type: "object",
+      properties: {
+        score: {
+          type: "number",
+          description: "Sentiment score from 1 (very negative) to 5 (very positive)"
+        },
+        category: {
+          type: "string",
+          enum: ["positive", "neutral", "negative", "product_quality", "service"],
+          description: "Primary feedback category"
+        }
+      },
+      required: ["score", "category"],
+      additionalProperties: false
+    };
+
+    // Helper: Check model availability using standard LanguageModel.availability() (with window.ai fallback)
+    async function checkModelAvailability(options = {}) {
+      if (typeof LanguageModel !== "undefined" && typeof LanguageModel.availability === "function") {
+        return await LanguageModel.availability(options);
+      }
+      if (window.ai && window.ai.languageModel) {
+        if (typeof window.ai.languageModel.availability === "function") {
+          return await window.ai.languageModel.availability(options);
+        }
+        if (typeof window.ai.languageModel.capabilities === "function") {
+          const caps = await window.ai.languageModel.capabilities();
+          return caps.available;
+        }
+      }
+      return "unavailable";
+    }
+
+    // Helper: Monitor download progress and update UI
+    function attachDownloadMonitor(m) {
+      const container = document.getElementById("download-progress-container");
+      const progressBar = document.getElementById("model-download-progress");
+      const progressText = document.getElementById("download-progress-text");
+
+      m.addEventListener("downloadprogress", (e) => {
+        if (container) container.style.display = "block";
+        const total = e.total || 1;
+        const pct = Math.round((e.loaded / total) * 100);
+        if (progressBar) progressBar.value = pct;
+        if (progressText) progressText.textContent = `${pct}%`;
+      });
+    }
+
+    // Helper: Update token / context usage display
+    async function updateContextUsageUI(session, samplePrompt = "") {
+      const badge = document.getElementById("context-usage-display");
+      if (!badge || !session) return;
+
+      const used = session.inputUsage ?? session.contextUsage ?? session.tokensSoFar ?? 0;
+      const quota = session.inputQuota ?? session.contextWindow ?? session.maxTokens ?? 0;
+      const left = session.tokensLeft ?? Math.max(0, quota - used);
+      const pct = quota > 0 ? Math.round((used / quota) * 100) : 0;
+
+      let measuredTokens = null;
+      if (samplePrompt) {
+        if (typeof session.measureInputUsage === "function") {
+          measuredTokens = await session.measureInputUsage(samplePrompt).catch(() => null);
+        } else if (typeof session.measureContextUsage === "function") {
+          measuredTokens = await session.measureContextUsage(samplePrompt).catch(() => null);
+        }
+      }
+
+      const measuredInfo = measuredTokens !== null ? ` | Prompt cost: ${measuredTokens} tokens` : "";
+      badge.textContent = `Context Usage: ${used} / ${quota} tokens (${pct}% used, ${left} remaining)${measuredInfo}`;
+    }
+
+    // Helper: Create or reuse a LanguageModel session with progress monitoring and initialPrompts
+    async function getOrCreateSession(signal) {
+      if (activeSession) {
+        return activeSession;
+      }
+
+      const availability = await checkModelAvailability({
+        expectedInputs: [{ type: "text", languages: ["en"] }],
+        expectedOutputs: [{ type: "text", languages: ["en"] }]
+      });
+
+      if (availability === "unavailable" || availability === "no") {
+        throw new Error("Built-in AI model is unavailable on this device or browser.");
+      }
+
+      const createOptions = {
+        initialPrompts: [
+          { role: "system", content: SYSTEM_PROMPT }
+        ],
+        signal,
+        monitor(m) {
+          attachDownloadMonitor(m);
+        }
+      };
+
+      if (typeof LanguageModel !== "undefined" && typeof LanguageModel.create === "function") {
+        activeSession = await LanguageModel.create(createOptions);
+      } else if (window.ai && window.ai.languageModel && typeof window.ai.languageModel.create === "function") {
+        activeSession = await window.ai.languageModel.create(createOptions);
+      } else {
+        throw new Error("LanguageModel API is not supported in this browser.");
+      }
+
+      // Listen for context overflow if supported
+      if (typeof activeSession.addEventListener === "function") {
+        activeSession.addEventListener("quotaoverflow", () => {
+          updateContextUsageUI(activeSession);
+        });
+        activeSession.addEventListener("contextoverflow", () => {
+          updateContextUsageUI(activeSession);
+        });
+      }
+
+      await updateContextUsageUI(activeSession);
+      return activeSession;
+    }
+
+    // Helper: Clean up unneeded cloned sessions and release memory
+    function cleanupUnneededSessions(keepSession = null) {
+      let cleanedCount = 0;
+      clonedSessions = clonedSessions.filter((session) => {
+        if (session && session !== keepSession) {
+          if (typeof session.destroy === "function") {
+            session.destroy();
+          }
+          cleanedCount++;
+          return false;
+        }
+        return Boolean(session);
+      });
+      return cleanedCount;
+    }
+
+    // 1. Ask the Barista - Streaming Handler
+    document.getElementById("ask-the-barista").addEventListener("click", async () => {
+      const questionEl = document.getElementById("barista-question");
+      const answerEl = document.getElementById("barista-answer");
+      const userQuestion = (questionEl.value || "").trim() || "Tell me about the Maple Oat Latte and Cold Brew.";
+
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      currentAbortController = new AbortController();
+      const { signal } = currentAbortController;
+
+      answerEl.textContent = "Checking local AI model availability...";
+
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === "unavailable" || availability === "no") {
+          answerEl.textContent = "Sorry, the built-in AI model is unavailable on this browser/device.";
+          return;
+        }
+
+        const session = await getOrCreateSession(signal);
+        await updateContextUsageUI(session, userQuestion);
+
+        answerEl.textContent = "";
+        const stream = session.promptStreaming(userQuestion, { signal });
+
+        for await (const chunk of stream) {
+          answerEl.textContent += chunk;
+        }
+
+        await updateContextUsageUI(session);
+      } catch (err) {
+        if (err.name === "AbortError") {
+          answerEl.textContent += "\n[Generation cancelled]";
+        } else {
+          answerEl.textContent = `Error: ${err.message}`;
+        }
+      }
+    });
+
+    // Cancel active streaming request
+    document.getElementById("abort-barista-btn").addEventListener("click", () => {
+      if (currentAbortController) {
+        currentAbortController.abort();
+        currentAbortController = null;
+      }
+    });
+
+    // 2. Customer Feedback Analyzer - Structured JSON output via responseConstraint
+    document.getElementById("sentiment-btn").addEventListener("click", async () => {
+      const feedbackEl = document.getElementById("feedback-input");
+      const outputEl = document.getElementById("sentiment-output");
+      const feedbackText = (feedbackEl.value || "").trim() || "The Maple Oat Latte and Cold Brew were delicious!";
+
+      outputEl.textContent = "Analyzing customer feedback...";
+      let analysisSession = null;
+
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === "unavailable" || availability === "no") {
+          outputEl.textContent = JSON.stringify({
+            error: "Built-in AI model unavailable",
+            score: 0,
+            category: "neutral"
+          }, null, 2);
+          return;
+        }
+
+        const baseSession = await getOrCreateSession();
+        // Clone session or use a dedicated temporary session so feedback evaluation doesn't pollute barista chat context
+        if (typeof baseSession.clone === "function") {
+          analysisSession = await baseSession.clone();
+        } else {
+          analysisSession = baseSession;
+        }
+
+        const promptText = `Analyze the following customer coffee shop feedback and return a JSON object with 'score' (1-5) and 'category': "${feedbackText}"`;
+        const rawResult = await analysisSession.prompt(promptText, {
+          responseConstraint: FEEDBACK_SCHEMA
+        });
+
+        const parsed = typeof rawResult === "string" ? JSON.parse(rawResult) : rawResult;
+        outputEl.textContent = JSON.stringify(parsed, null, 2);
+        await updateContextUsageUI(baseSession);
+      } catch (err) {
+        outputEl.textContent = JSON.stringify({
+          error: err.message,
+          score: 0,
+          category: "neutral"
+        }, null, 2);
+      } finally {
+        // Resource cleanup: destroy temporary cloned analysis session
+        if (analysisSession && analysisSession !== activeSession && typeof analysisSession.destroy === "function") {
+          analysisSession.destroy();
+        }
+      }
+    });
+
+    // 3. Conversation Branching - Cloning Active Session, Tracking Context Usage & Cleaning up Unneeded Sessions
+    document.getElementById("clone-btn").addEventListener("click", async () => {
+      const branchInfoEl = document.getElementById("branch-session-info");
+
+      try {
+        const availability = await checkModelAvailability();
+        if (availability === "unavailable" || availability === "no") {
+          branchInfoEl.textContent = "Cannot clone session: Built-in AI model is unavailable.";
+          return;
+        }
+
+        const baseSession = await getOrCreateSession();
+        // Clean up older cloned sessions before creating a fresh branch to conserve memory
+        const cleaned = cleanupUnneededSessions();
+
+        const cloneController = new AbortController();
+        const clonedSession = await baseSession.clone({ signal: cloneController.signal });
+        clonedSessions.push(clonedSession);
+
+        await updateContextUsageUI(clonedSession);
+
+        const used = clonedSession.inputUsage ?? clonedSession.contextUsage ?? 0;
+        const quota = clonedSession.inputQuota ?? clonedSession.contextWindow ?? 0;
+        branchInfoEl.textContent =
+          `Cloned active session successfully! Active branches: ${clonedSessions.length} ` +
+          `(Cleaned up ${cleaned} previous unneeded session(s)). ` +
+          `Branch Context Usage: ${used} / ${quota} tokens.`;
+      } catch (err) {
+        branchInfoEl.textContent = `Error cloning session: ${err.message}`;
+      }
+    });
+
+    // Explicit Cleanup Button & Page Unload Cleanup
+    document.getElementById("cleanup-btn").addEventListener("click", () => {
+      const branchInfoEl = document.getElementById("branch-session-info");
+      const cleaned = cleanupUnneededSessions();
+      if (activeSession && typeof activeSession.destroy === "function") {
+        activeSession.destroy();
+        activeSession = null;
+      }
+      document.getElementById("context-usage-display").textContent = "Context Usage: 0 / 0 tokens (0%)";
+      branchInfoEl.textContent = `Cleaned up ${cleaned} branched session(s) and destroyed active session.`;
+    });
+
+    window.addEventListener("pagehide", () => {
+      cleanupUnneededSessions();
+      if (activeSession && typeof activeSession.destroy === "function") {
+        activeSession.destroy();
+        activeSession = null;
+      }
+    });
+  </script>
 </body>
 
