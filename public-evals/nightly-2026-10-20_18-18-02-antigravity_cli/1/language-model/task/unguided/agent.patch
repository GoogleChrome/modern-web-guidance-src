+        <div class="ai-controls">
+          <button id="clone-btn" class="btn">Clone Active Session</button>
+          <button id="cleanup-btn" class="btn btn-danger" type="button">Cleanup Unneeded Sessions</button>
+          <span id="context-usage-display" class="quota-badge">Context Usage: 0 / 0 tokens (0%)</span>
