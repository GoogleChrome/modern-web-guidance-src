+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const submitBtn = document.getElementById('shipping-submit-btn');
+    const formStatus = document.getElementById('shipping-form-status');
+    const controls = shippingForm.querySelectorAll('.form-control');
+
+    function getErrorElement(control) {
+      const describedBy = control.getAttribute('aria-describedby') || '';
+      const ids = describedBy.split(/\s+/);
+      for (const id of ids) {
+        const el = document.getElementById(id);
+        if (el && el.classList.contains('field-error')) {
+          return el;
+        }
+      }
+      return null;
+    }
+
+    controls.forEach((control) => {
+      const errorEl = getErrorElement(control);
+
+      control.addEventListener('blur', () => {
+        if (!control.checkValidity()) {
+          if (errorEl) errorEl.textContent = control.validationMessage;
+        }
+      });
+
+      control.addEventListener('input', () => {
+        control.setCustomValidity('');
+        if (errorEl && control.checkValidity()) {
+          errorEl.textContent = '';
+        }
+      });
+    });
+
+    shippingForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!shippingForm.checkValidity()) {
+        controls.forEach((control) => {
+          const errorEl = getErrorElement(control);
+          if (!control.checkValidity() && errorEl) {
+            errorEl.textContent = control.validationMessage;
+          }
+        });
+        const firstInvalid = shippingForm.querySelector(':invalid');
+        if (firstInvalid) firstInvalid.focus();
+        return;
+      }
+
+      submitBtn.disabled = true;
+      submitBtn.textContent = 'Saving shipping address...';
+      formStatus.className = 'form-status success';
+      formStatus.textContent = 'Shipping address saved! Redirecting to payment...';
+    });
+  </script>
+
