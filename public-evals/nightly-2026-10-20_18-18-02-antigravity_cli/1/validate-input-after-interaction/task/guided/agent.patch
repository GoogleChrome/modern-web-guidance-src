+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterStatus = document.getElementById('newsletter-status');
+
+    // Sync aria-invalid with the CSS :user-invalid state
+    const syncAria = (el) => {
+      if (!el || typeof el.matches !== 'function') return;
+      el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+    };
+
+    // Update on blur (to show error after leaving field) and input (to clear it immediately on correction)
+    newsletterForm.addEventListener('blur', (e) => {
+      if (e.target === newsletterEmail) syncAria(e.target);
+    }, true);
+
+    newsletterForm.addEventListener('input', (e) => {
+      if (e.target === newsletterEmail) {
+        newsletterStatus.style.display = 'none';
+        if (e.target.hasAttribute('aria-invalid')) syncAria(e.target);
+      }
+    });
+
+    newsletterForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      syncAria(newsletterEmail);
+      if (newsletterForm.checkValidity()) {
+        newsletterStatus.style.display = 'block';
+        newsletterForm.reset();
+        newsletterEmail.removeAttribute('aria-invalid');
+      }
+    });
+  </script>
 </body>
 
