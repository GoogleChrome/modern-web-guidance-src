+  <div id="order-offline-popover" popover="auto" role="status">
+    <p>online ordering is currently offline</p>
+    <div class="dialog-actions">
+      <button type="button" id="close-popover-btn" class="btn btn-secondary" popovertarget="order-offline-popover" popovertargetaction="hide" commandfor="order-offline-popover" command="hide-popover">Dismiss</button>
+    </div>
