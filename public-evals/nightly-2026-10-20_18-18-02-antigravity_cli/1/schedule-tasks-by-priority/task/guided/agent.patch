+  <script>
+    (function () {
+      const statusTextEl = document.getElementById('ops-status-text');
+      const queuedEl = document.getElementById('metric-queued');
+      const completedEl = document.getElementById('metric-completed');
+      const yieldsEl = document.getElementById('metric-yields');
+      const schedulerModeEl = document.getElementById('metric-scheduler-mode');
+      const logListEl = document.getElementById('ops-log-list');
+
+      let queuedCount = 0;
+      let completedCount = 0;
+      let yieldCount = 0;
+      let taskCounter = 0;
+
+      // Feature detect the scheduler API and load polyfill if needed
+      function ensureSchedulerReady(callback) {
+        if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+          schedulerModeEl.textContent = 'Loading Polyfill';
+          const script = document.createElement('script');
+          script.src = 'https://unpkg.com/scheduler-polyfill';
+          script.onload = () => {
+            schedulerModeEl.textContent = 'Polyfill Active';
+            callback();
+          };
+          script.onerror = () => {
+            schedulerModeEl.textContent = 'Fallback Queue';
+            callback();
+          };
+          document.head.appendChild(script);
+        } else {
+          schedulerModeEl.textContent = 'Native API';
+          callback();
+        }
+      }
+
+      // Yield to the main thread periodically to keep the UI responsive
+      async function yieldToMain() {
+        yieldCount++;
+        yieldsEl.textContent = String(yieldCount);
+        if ('scheduler' in window && 'yield' in window.scheduler) {
+          return await window.scheduler.yield();
+        } else {
+          return await new Promise(resolve => setTimeout(resolve, 0));
+        }
+      }
+
+      // Break up heavy synchronous work using a 50ms deadline budget
+      async function processHeavyOperation(iterations) {
+        let deadline = performance.now() + 50;
+        let accumulator = 0;
+
+        for (let i = 0; i < iterations; i++) {
+          // Simulate computational work (e.g., inventory pricing, telemetry aggregation)
+          accumulator += Math.sqrt((i * 17) % 97);
+
+          if (performance.now() >= deadline) {
+            await yieldToMain();
+            deadline = performance.now() + 50;
+          }
+        }
+        return accumulator;
+      }
+
+      function updateMetrics() {
+        queuedEl.textContent = String(queuedCount);
+        completedEl.textContent = String(completedCount);
+        statusTextEl.textContent =
+          queuedCount > 0 ? `Processing (${queuedCount} active)` : 'Main Thread Responsive';
+      }
+
+      function appendLog(message, priority, badgeText) {
+        if (
+          logListEl.children.length === 1 &&
+          logListEl.firstElementChild.textContent.includes('Ready to schedule')
+        ) {
+          logListEl.innerHTML = '';
+        }
+
+        const li = document.createElement('li');
+        li.className = 'ops-log-item';
+        if (priority) {
+          li.dataset.priority = priority;
+        }
+
+        const textSpan = document.createElement('span');
+        textSpan.textContent = message;
+
+        const badgeSpan = document.createElement('span');
+        badgeSpan.className = 'ops-badge';
+        badgeSpan.textContent = badgeText;
+
+        li.append(textSpan, badgeSpan);
+        logListEl.prepend(li);
+      }
+
+      function scheduleOperation(label, priority, workIterations) {
+        const taskId = ++taskCounter;
+        queuedCount++;
+        updateMetrics();
+
+        const runTask = async () => {
+          const startTime = performance.now();
+          appendLog(`#${taskId} Starting ${label}...`, priority, priority.toUpperCase());
+
+          await processHeavyOperation(workIterations);
+
+          const duration = Math.round(performance.now() - startTime);
+          queuedCount = Math.max(0, queuedCount - 1);
+          completedCount++;
+          updateMetrics();
+
+          appendLog(
+            `#${taskId} Completed ${label} (${duration}ms)`,
+            priority,
+            `DONE · ${priority}`
+          );
+        };
+
+        if ('scheduler' in window && 'postTask' in window.scheduler) {
+          window.scheduler.postTask(runTask, { priority });
+        } else {
+          // Fallback priority delay if polyfill could not be loaded offline
+          const delay =
+            priority === 'user-blocking' ? 0 : priority === 'user-visible' ? 15 : 40;
+          setTimeout(runTask, delay);
+        }
+      }
+
+      ensureSchedulerReady(() => {
+        document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+          scheduleOperation('Urgent Checkout Processing', 'user-blocking', 450000);
+        });
+
+        document.getElementById('btn-standard-menu').addEventListener('click', () => {
+          scheduleOperation('Standard Menu Sync & Pricing Update', 'user-visible', 900000);
+        });
+
+        document.getElementById('btn-bg-telemetry').addEventListener('click', () => {
+          scheduleOperation('Background Telemetry & Analytics Flush', 'background', 1800000);
+        });
+
+        document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+          // Queue in mixed order (background -> standard -> urgent) to demonstrate
+          // that scheduler.postTask executes them in priority order!
+          appendLog(
+            'Enqueuing mixed batch (Background → Standard → Urgent)...',
+            null,
+            'BATCH'
+          );
+          scheduleOperation('Batch: Telemetry Log #1', 'background', 1200000);
+          scheduleOperation('Batch: Seasonal Menu Refresh', 'user-visible', 750000);
+          scheduleOperation('Batch: Telemetry Log #2', 'background', 1200000);
+          scheduleOperation('Batch: Express POS Checkout #1', 'user-blocking', 400000);
+          scheduleOperation('Batch: Inventory Availability Update', 'user-visible', 750000);
+          scheduleOperation('Batch: Express POS Checkout #2', 'user-blocking', 400000);
+        });
+
+        document.getElementById('btn-clear-queue').addEventListener('click', () => {
+          logListEl.innerHTML = `
+            <li class="ops-log-item">
+              <span>Ready to schedule cafe operations...</span>
+              <span class="ops-badge">IDLE</span>
+            </li>
+          `;
+        });
+      });
+    })();
+  </script>
