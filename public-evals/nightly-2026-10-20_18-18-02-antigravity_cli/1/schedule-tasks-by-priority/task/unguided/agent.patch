+        let isFlushScheduled = false;
+
+        function scheduleFlush() {
+          if (isFlushScheduled) return;
+          isFlushScheduled = true;
+          const channel = new MessageChannel();
+          channel.port1.onmessage = flushNextTask;
+          channel.port2.postMessage(null);
+        }
+
+        function flushNextTask() {
+          isFlushScheduled = false;
+          const priorities = ['user-blocking', 'user-visible', 'background'];
+          for (const p of priorities) {
+            if (fallbackQueues[p].length > 0) {
+              const next = fallbackQueues[p].shift();
+              if (next.signal && next.signal.aborted) {
+                next.reject(new DOMException('Task aborted', 'AbortError'));
+                if (fallbackQueues['user-blocking'].length || fallbackQueues['user-visible'].length || fallbackQueues['background'].length) {
+                  scheduleFlush();
+                }
