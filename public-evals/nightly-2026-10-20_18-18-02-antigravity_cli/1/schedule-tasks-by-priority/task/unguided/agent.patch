+            stepEl.textContent = `Completed all ${task.chunks} chunks without blocking UI.`;
+          }
+
+          updateStats();
+          appendLog(`Completed #${task.id}: ${task.title} [${task.priority}]`, task.priority);
+          return task;
+        }, postTaskOptions);
+      }
+
+      function runBatchMixedTasks() {
+        appendLog('--- Batch Triggered: Scheduling mixed tasks (queued: background, user-visible, user-blocking) ---');
+        // Enqueue in reverse priority order to clearly demonstrate scheduler prioritization:
+        // 1. Background telemetry (low), 2. Standard menu update (medium), 3. Urgent checkout (high)
+        scheduleOperationTask('telemetry-logging');
+        scheduleOperationTask('menu-update');
+        scheduleOperationTask('urgent-checkout');
+      }
+
+      function clearQueueAndLog() {
+        executionOrder.length = 0;
+        completedTaskCount = 0;
+        queueListEl.innerHTML = '';
+        queueListEl.appendChild(emptyStateEl);
+        logEl.innerHTML = '<div class="log-entry">[System] Queue and execution log cleared.</div>';
+        updateStats();
+      }
+
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        scheduleOperationTask('urgent-checkout');
+      });
+
+      document.getElementById('btn-menu-update').addEventListener('click', () => {
+        scheduleOperationTask('menu-update');
+      });
+
+      document.getElementById('btn-telemetry-logging').addEventListener('click', () => {
+        scheduleOperationTask('telemetry-logging');
+      });
+
+      document.getElementById('btn-batch-tasks').addEventListener('click', () => {
+        runBatchMixedTasks();
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', () => {
+        clearQueueAndLog();
+      });
+    })();
+  </script>
