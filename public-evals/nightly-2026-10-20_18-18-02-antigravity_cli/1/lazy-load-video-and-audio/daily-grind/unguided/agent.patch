+  <script>
+    (function () {
+      function hydrateMediaElement(el) {
+        if (!el || el.dataset.loaded === 'true') return;
+        el.dataset.loaded = 'true';
+
+        if (el.dataset.poster) {
+          el.setAttribute('poster', el.dataset.poster);
+          el.removeAttribute('data-poster');
+        }
+
+        if (el.dataset.src) {
+          el.setAttribute('src', el.dataset.src);
+          el.removeAttribute('data-src');
+        }
+
+        var sources = el.querySelectorAll('source[data-src]');
+        sources.forEach(function (source) {
+          source.setAttribute('src', source.dataset.src);
+          source.removeAttribute('data-src');
+        });
+
+        if (el.dataset.preload) {
+          el.setAttribute('preload', el.dataset.preload);
+        }
+
+        if (typeof el.load === 'function') {
+          el.load();
+        }
+
+        var statusEl = document.getElementById(el.id + '-status');
+        if (statusEl) {
+          statusEl.textContent = 'Ready to play';
+        }
+      }
+
+      function hydrateImageElement(img) {
+        if (!img || img.dataset.loaded === 'true') return;
+        img.dataset.loaded = 'true';
+        if (img.dataset.src) {
+          img.setAttribute('src', img.dataset.src);
+          img.removeAttribute('data-src');
+        }
+      }
+
+      var lazyMedia = document.querySelectorAll('.lazy-media');
+      var lazyImages = document.querySelectorAll('.lazy-image');
+
+      if ('IntersectionObserver' in window) {
+        var mediaObserver = new IntersectionObserver(function (entries, observer) {
+          entries.forEach(function (entry) {
+            if (entry.isIntersecting) {
+              if (entry.target.classList.contains('lazy-media')) {
+                hydrateMediaElement(entry.target);
+              } else if (entry.target.classList.contains('lazy-image')) {
+                hydrateImageElement(entry.target);
+              }
+              observer.unobserve(entry.target);
+            }
+          });
+        }, {
+          rootMargin: '200px 0px'
+        });
+
+        lazyMedia.forEach(function (el) {
+          mediaObserver.observe(el);
+        });
+        lazyImages.forEach(function (img) {
+          mediaObserver.observe(img);
+        });
+      } else {
+        lazyMedia.forEach(hydrateMediaElement);
+        lazyImages.forEach(hydrateImageElement);
+      }
+
+      // Also hydrate immediately if the user interacts with a player before intersection triggers
+      lazyMedia.forEach(function (el) {
+        ['play', 'pointerdown', 'focus'].forEach(function (evt) {
+          el.addEventListener(evt, function () {
+            hydrateMediaElement(el);
+          }, { once: true });
+        });
+      });
+    })();
+  </script>
