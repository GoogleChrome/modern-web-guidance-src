+}
+
+/* Visually hidden utility for screen readers and skip links */
+.visually-hidden:where(:not(:focus-within, :active)) {
+  position: absolute !important;
+  clip-path: inset(50%) !important;
+  overflow: hidden !important;
+  width: 1px !important;
+  height: 1px !important;
+  margin: -1px !important;
+  padding: 0 !important;
+  border: 0 !important;
+  white-space: nowrap !important;
+}
+
+/* Focus indicators */
+:where(a:any-link, button, input, select, textarea, summary):focus-visible {
+  outline: 2px solid #d97706;
+  outline-offset: 2px;
+}
+
+/*Focus boundaries and inert styling*/
+[inert], [inert] * {
+  opacity: 0.5;
+  cursor: default;
+  user-select: none;
+}
+
+/* Native Modal Dialogs & Scroll Containment */
+dialog:modal {
+  overscroll-behavior: contain;
+}
+
+dialog::backdrop {
+  overflow: hidden;
+  overscroll-behavior: contain;
+  background-color: rgba(255, 255, 255, 0.4);
+  backdrop-filter: blur(4px);
+}
+
+/* Popover polyfill compatibility */
+[popover]:is(:popover-open, .\:popover-open) {
+  display: block;
+}
