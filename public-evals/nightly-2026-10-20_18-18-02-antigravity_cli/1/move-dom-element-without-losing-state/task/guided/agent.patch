+  <script>
+    const theaterToggleBtn = document.getElementById('theater-toggle');
+    const heroSection = document.getElementById('hero-section');
+    const videoHome = document.getElementById('video-home');
+    const roastingVideo = document.getElementById('roasting-video');
+
+    function reparentPreserveState(targetParent, nodeToMove) {
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(nodeToMove, null);
+      } else {
+        targetParent.insertBefore(nodeToMove, null);
+      }
+    }
+
+    theaterToggleBtn.addEventListener('click', () => {
+      const isInTheater = roastingVideo.parentElement === heroSection;
+      const targetParent = isInTheater ? videoHome : heroSection;
+
+      reparentPreserveState(targetParent, roastingVideo);
+
+      const nowInTheater = !isInTheater;
+      theaterToggleBtn.setAttribute('aria-pressed', String(nowInTheater));
+      theaterToggleBtn.textContent = nowInTheater ? 'Exit Theater Mode' : 'Theater Mode';
+    });
+  </script>
+
