+  <script>
+    (function () {
+      const list = document.querySelector('.SwipeableList');
+      const emptyState = document.getElementById('cart-empty');
+      const SWIPE_THRESHOLD = 100;
+
+      function setupSwipeItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        let startX = 0;
+        let currentX = 0;
+        let isDragging = false;
+
+        function onStart(clientX) {
+          if (item.classList.contains('is-removing')) return;
+          isDragging = true;
+          startX = clientX;
+          currentX = 0;
+          content.classList.add('is-dragging');
+        }
+
+        function onMove(clientX) {
+          if (!isDragging) return;
+          currentX = clientX - startX;
+          content.style.transform = `translateX(${currentX}px)`;
+
+          if (Math.abs(currentX) >= SWIPE_THRESHOLD) {
+            track.classList.add('is-active');
+          } else {
+            track.classList.remove('is-active');
+          }
+        }
+
+        function onEnd() {
+          if (!isDragging) return;
+          isDragging = false;
+          content.classList.remove('is-dragging');
+
+          if (Math.abs(currentX) >= SWIPE_THRESHOLD) {
+            const direction = currentX > 0 ? 1 : -1;
+            const itemWidth = item.offsetWidth || 400;
+            item.style.height = `${item.offsetHeight}px`;
+            content.style.transform = `translateX(${direction * itemWidth}px)`;
+
+            requestAnimationFrame(() => {
+              requestAnimationFrame(() => {
+                item.classList.add('is-removing');
+              });
+            });
+
+            item.addEventListener('transitionend', function handleTransitionEnd(e) {
+              if (e.propertyName === 'height') {
+                item.removeEventListener('transitionend', handleTransitionEnd);
+                item.remove();
+                if (list.querySelectorAll('.SwipeableList-item').length === 0 && emptyState) {
+                  emptyState.style.display = 'block';
+                }
+              }
+            });
+          } else {
+            content.style.transform = 'translateX(0px)';
+            track.classList.remove('is-active');
+          }
+        }
+
+        content.addEventListener('pointerdown', (e) => {
+          onStart(e.clientX);
+          content.setPointerCapture(e.pointerId);
+        });
+
+        content.addEventListener('pointermove', (e) => {
+          onMove(e.clientX);
+        });
+
+        content.addEventListener('pointerup', onEnd);
+        content.addEventListener('pointercancel', onEnd);
+      }
+
+      document.querySelectorAll('.SwipeableList-item').forEach(setupSwipeItem);
+    })();
+  </script>
