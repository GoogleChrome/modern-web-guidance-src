+  <script>
+    const canvas = document.getElementById('gift-card-canvas');
+    const ctx = canvas.getContext('2d');
+    const export_element = document.getElementById('export_element');
+    const messageInput = document.getElementById('card-message-input');
+    const recipientInput = document.getElementById('card-recipient-input');
+    const messageDisplay = document.getElementById('card-message-display');
+    const recipientDisplay = document.getElementById('card-recipient-display');
+    const bgColorPicker = document.getElementById('card-bg-color');
+    const colorSwatches = document.querySelectorAll('.color-swatch');
+    const exportBtn = document.getElementById('export-card-btn');
+    const supportStatus = document.getElementById('canvas-support-status');
+
+    const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+    function requestCanvasPaint() {
+      if (typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else if (!supportsHtmlInCanvas) {
+        drawFallbackPreview();
+      }
+    }
+
+    function drawFallbackPreview() {
+      const dpr = window.devicePixelRatio || 1;
+      const width = canvas.width / dpr;
+      const height = canvas.height / dpr;
+      ctx.save();
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      ctx.clearRect(0, 0, width, height);
+
+      // Rounded card background
+      const bg = export_element.style.backgroundColor || '#4e342e';
+      ctx.fillStyle = bg;
+      ctx.beginPath();
+      if (ctx.roundRect) {
+        ctx.roundRect(0, 0, width, height, 16);
+      } else {
+        ctx.rect(0, 0, width, height);
+      }
+      ctx.fill();
+
+      // Header text
+      ctx.fillStyle = '#ffffff';
+      ctx.font = 'bold 15px "Segoe UI", sans-serif';
+      ctx.fillText('THE DAILY GRIND', 28, 42);
+
+      ctx.fillStyle = '#ffe0b2';
+      ctx.font = 'bold 15px "Segoe UI", sans-serif';
+      ctx.textAlign = 'right';
+      ctx.fillText('$25.00', width - 28, 42);
+
+      // Body message
+      ctx.textAlign = 'left';
+      ctx.fillStyle = '#ffffff';
+      ctx.font = '600 20px "Segoe UI", sans-serif';
+      ctx.fillText(messageDisplay.textContent || 'Enjoy a warm cup on me!', 28, 130, width - 56);
+
+      // Footer recipient & code
+      ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
+      ctx.font = '11px "Segoe UI", sans-serif';
+      ctx.fillText('CRAFTED FOR', 28, height - 44);
+
+      ctx.fillStyle = '#ffffff';
+      ctx.font = 'bold 16px "Segoe UI", sans-serif';
+      ctx.fillText(recipientDisplay.textContent || 'Alex Rivera', 28, height - 24);
+
+      ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+      ctx.font = '13px monospace';
+      ctx.textAlign = 'right';
+      ctx.fillText('TDG-2026-COFFEE', width - 28, height - 24);
+      ctx.restore();
+    }
+
+    if (supportsHtmlInCanvas) {
+      // Render the HTML content to the canvas inside canvas.onpaint
+      canvas.onpaint = (event) => {
+        ctx.reset();
+        ctx.drawElementImage(export_element, 0, 0);
+      };
+    } else {
+      supportStatus.textContent = 'HTML-in-Canvas API is not natively supported in this browser; using 2D canvas fallback preview.';
+    }
+
+    // Scale canvas grid to match the device scale factor to prevent blurriness
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      requestCanvasPaint();
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: 'device-pixel-content-box' }
+      : {};
+    observer.observe(canvas, options);
+
+    // Update message and recipient
+    messageInput.addEventListener('input', (e) => {
+      messageDisplay.textContent = e.target.value || 'Enjoy a warm cup on me!';
+      requestCanvasPaint();
+    });
+
+    recipientInput.addEventListener('input', (e) => {
+      recipientDisplay.textContent = e.target.value || 'Coffee Lover';
+      requestCanvasPaint();
+    });
+
+    function setCardBackgroundColor(color) {
+      export_element.style.backgroundColor = color;
+      bgColorPicker.value = color;
+      colorSwatches.forEach((swatch) => {
+        swatch.classList.toggle('active', swatch.dataset.color.toLowerCase() === color.toLowerCase());
+      });
+      requestCanvasPaint();
+    }
+
+    colorSwatches.forEach((swatch) => {
+      swatch.addEventListener('click', () => {
+        setCardBackgroundColor(swatch.dataset.color);
+      });
+    });
+
+    bgColorPicker.addEventListener('input', (e) => {
+      setCardBackgroundColor(e.target.value);
+    });
+
+    // Export and download the canvas as an image file
+    exportBtn.addEventListener('click', () => {
+      const dataURL = canvas.toDataURL('image/png');
+      const link = document.createElement('a');
+      link.download = 'daily-grind-gift-card.png';
+      link.href = dataURL;
+      link.click();
+    });
+  </script>
 </body>
 
