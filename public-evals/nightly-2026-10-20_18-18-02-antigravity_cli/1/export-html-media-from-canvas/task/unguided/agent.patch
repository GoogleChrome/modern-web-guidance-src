+  <script>
+    (function () {
+      const canvas = document.getElementById('gift_card_canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const recipientInput = document.getElementById('recipient_input');
+      const messageInput = document.getElementById('message_input');
+      const bgColorInput = document.getElementById('bg_color_input');
+      const colorSwatches = document.querySelectorAll('.color-swatch');
+      const cardRecipientDisplay = document.getElementById('card_recipient_display');
+      const cardMessageDisplay = document.getElementById('card_message_display');
+      const exportBtn = document.getElementById('export_btn');
+      const statusNote = document.getElementById('canvas_status_note');
+
+      // Feature detection for the HTML-in-Canvas API (drawElementImage & requestPaint)
+      const supportsHtmlInCanvas = Boolean(
+        'drawElementImage' in CanvasRenderingContext2D.prototype &&
+        ctx &&
+        typeof ctx.drawElementImage === 'function' &&
+        typeof canvas.requestPaint === 'function'
+      );
+
+      // Fallback 2D renderer when browser native HTML-in-Canvas is not enabled
+      function drawFallbackCard() {
+        const width = canvas.width;
+        const height = canvas.height;
+        const bgColor = exportElement.style.backgroundColor || bgColorInput.value || '#4e342e';
+
+        ctx.clearRect(0, 0, width, height);
+
+        // Rounded card background
+        ctx.save();
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(0, 0, width, height, 16);
+        } else {
+          ctx.rect(0, 0, width, height);
+        }
+        ctx.clip();
+
+        ctx.fillStyle = bgColor;
+        ctx.fillRect(0, 0, width, height);
+
+        // Decorative accent circle
+        ctx.fillStyle = 'rgba(255, 171, 64, 0.15)';
+        ctx.beginPath();
+        ctx.arc(width - 50, 50, 90, 0, Math.PI * 2);
+        ctx.fill();
+
+        // Header divider
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(28, 64);
+        ctx.lineTo(width - 28, 64);
+        ctx.stroke();
+
+        // Brand title
+        ctx.fillStyle = '#ffab40';
+        ctx.font = 'bold 18px "Segoe UI", Tahoma, sans-serif';
+        ctx.textBaseline = 'middle';
+        ctx.fillText('THE DAILY GRIND', 28, 42);
+
+        // Amount pill
+        const amountText = '$25.00';
+        ctx.font = 'bold 18px "Segoe UI", Tahoma, sans-serif';
+        const amountWidth = ctx.measureText(amountText).width + 24;
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';
+        ctx.beginPath();
+        if (typeof ctx.roundRect === 'function') {
+          ctx.roundRect(width - 28 - amountWidth, 26, amountWidth, 30, 15);
+        } else {
+          ctx.rect(width - 28 - amountWidth, 26, amountWidth, 30);
+        }
+        ctx.fill();
+        ctx.fillStyle = '#ffffff';
+        ctx.fillText(amountText, width - 28 - amountWidth + 12, 42);
+
+        // Custom message (wrapped)
+        ctx.fillStyle = '#ffffff';
+        ctx.font = 'italic 21px "Segoe UI", Tahoma, sans-serif';
+        const rawMessage = messageInput.value.trim() || 'Enjoy your morning brew on me!';
+        const quotedMessage = `"${rawMessage}"`;
+        const words = quotedMessage.split(' ');
+        let line = '';
+        let y = 130;
+        const maxWidth = width - 56;
+        for (let i = 0; i < words.length; i++) {
+          const testLine = line + words[i] + ' ';
+          if (ctx.measureText(testLine).width > maxWidth && i > 0) {
+            ctx.fillText(line.trim(), 28, y);
+            line = words[i] + ' ';
+            y += 30;
+          } else {
+            line = testLine;
+          }
+        }
+        ctx.fillText(line.trim(), 28, y);
+
+        // Recipient
+        const recipient = (recipientInput.value.trim() || 'Alex Rivera').toUpperCase();
+        ctx.fillStyle = '#d7ccc8';
+        ctx.font = '600 15px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText(`FOR: ${recipient}`, 28, y + 42);
+
+        // Footer
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+        ctx.font = '12px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('REDEEMABLE AT ANY LOCATION', 28, height - 28);
+        const codeText = 'GIFT CARD #TDG-2026';
+        const codeWidth = ctx.measureText(codeText).width;
+        ctx.fillText(codeText, width - 28 - codeWidth, height - 28);
+
+        ctx.restore();
+      }
+
+      // Synchronized paint handler for HTML-in-Canvas
+      function renderCardToCanvas() {
+        if (supportsHtmlInCanvas) {
+          if (typeof ctx.reset === 'function') {
+            ctx.reset();
+          } else {
+            ctx.clearRect(0, 0, canvas.width, canvas.height);
+          }
+          const transform = ctx.drawElementImage(exportElement, 0, 0);
+          // Backward compatibility for earlier HTML-in-Canvas implementations returning DOMMatrix
+          if (transform && typeof transform.toString === 'function') {
+            exportElement.style.transform = transform.toString();
+          }
+        } else {
+          drawFallbackCard();
+        }
+      }
+
+      // Synchronize rendering with the canvas 'paint' event
+      canvas.addEventListener('paint', () => {
+        renderCardToCanvas();
+      });
+
+      function triggerCardUpdate() {
+        const recipient = recipientInput.value.trim() || 'Alex Rivera';
+        const message = messageInput.value.trim() || 'Enjoy your morning brew on me!';
+
+        cardRecipientDisplay.textContent = recipient;
+        cardMessageDisplay.textContent = `\u201C${message}\u201D`;
+        exportElement.style.backgroundColor = bgColorInput.value;
+
+        if (supportsHtmlInCanvas) {
+          canvas.requestPaint();
+        } else {
+          renderCardToCanvas();
+        }
+      }
+
+      recipientInput.addEventListener('input', triggerCardUpdate);
+      messageInput.addEventListener('input', triggerCardUpdate);
+
+      bgColorInput.addEventListener('input', () => {
+        colorSwatches.forEach(btn => {
+          btn.classList.toggle('active', btn.dataset.color.toLowerCase() === bgColorInput.value.toLowerCase());
+        });
+        triggerCardUpdate();
+      });
+
+      colorSwatches.forEach(swatch => {
+        swatch.addEventListener('click', () => {
+          const color = swatch.dataset.color;
+          bgColorInput.value = color;
+          colorSwatches.forEach(btn => btn.classList.remove('active'));
+          swatch.classList.add('active');
+          triggerCardUpdate();
+        });
+      });
+
+      // Export & Download button handler
+      exportBtn.addEventListener('click', () => {
+        // Ensure latest state is painted before exporting
+        if (supportsHtmlInCanvas) {
+          canvas.requestPaint();
+        } else {
+          renderCardToCanvas();
+        }
+
+        const exportFilename = 'daily-grind-gift-card.png';
+        if (typeof canvas.toBlob === 'function') {
+          canvas.toBlob((blob) => {
+            if (!blob) return;
+            const url = URL.createObjectURL(blob);
+            const link = document.createElement('a');
+            link.download = exportFilename;
+            link.href = url;
+            document.body.appendChild(link);
+            link.click();
+            document.body.removeChild(link);
+            URL.revokeObjectURL(url);
+          }, 'image/png');
+        } else {
+          const dataUrl = canvas.toDataURL('image/png');
+          const link = document.createElement('a');
+          link.download = exportFilename;
+          link.href = dataUrl;
+          document.body.appendChild(link);
+          link.click();
+          document.body.removeChild(link);
+        }
+      });
+
+      // Initial paint synchronization
+      if (supportsHtmlInCanvas) {
+        statusNote.textContent = 'Rendered live via HTML-in-Canvas (drawElementImage).';
+        canvas.requestPaint();
+      } else {
+        statusNote.textContent = 'HTML-in-Canvas preview active (using 2D canvas fallback in unsupported browsers).';
+        renderCardToCanvas();
+      }
+    })();
+  </script>
 </body>
 
