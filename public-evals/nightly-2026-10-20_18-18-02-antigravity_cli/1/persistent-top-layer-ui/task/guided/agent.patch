+  <button type="button" class="feedback-fab" id="open-feedback-fab" aria-haspopup="dialog" aria-controls="feedback-modal">
+    Feedback
+  </button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-modal');
+    const openFabBtn = document.getElementById('open-feedback-fab');
+    const openInlineBtn = document.getElementById('open-feedback-inline');
+    const closeBtn = document.getElementById('close-feedback-btn');
+    const moveModalBtn = document.getElementById('move-modal-btn');
+    const parentIndicator = document.getElementById('modal-parent-indicator');
+    const reparentStatus = document.getElementById('reparent-status');
+    const feedbackNotes = document.getElementById('feedback-notes');
+
+    const dockContainers = [
+      document.getElementById('feedback-host-main'),
+      document.getElementById('hero-dock-container'),
+      document.getElementById('footer-dock-container'),
+    ];
+    let currentDockIndex = 0;
+
+    function updateParentIndicator(methodUsed) {
+      const parent = feedbackDialog.parentElement;
+      const label = parent?.dataset.dockLabel || (parent ? `#${parent.id || parent.tagName.toLowerCase()}` : 'unknown');
+      parentIndicator.textContent = `Current DOM Parent: ${label}`;
+      if (methodUsed) {
+        reparentStatus.textContent = `Relocated to ${label} via ${methodUsed} (modal remained open).`;
+      }
+    }
+
+    function openFeedbackModal() {
+      if (!feedbackDialog.open) {
+        feedbackDialog.showModal();
+        feedbackNotes.focus();
+      }
+      updateParentIndicator();
+    }
+
+    function moveFeedbackModal(targetContainer) {
+      const activeEl = document.activeElement;
+      const hadFocusInside = feedbackDialog.contains(activeEl);
+      const selectionStart = activeEl && 'selectionStart' in activeEl ? activeEl.selectionStart : null;
+      const selectionEnd = activeEl && 'selectionEnd' in activeEl ? activeEl.selectionEnd : null;
+
+      // MANDATORY: Use moveBefore to ensure the <dialog> or popover stays open.
+      if ('moveBefore' in Element.prototype) {
+        targetContainer.moveBefore(feedbackDialog, null);
+        if (hadFocusInside && activeEl && document.activeElement !== activeEl) {
+          activeEl.focus();
+        }
+        updateParentIndicator('Element.prototype.moveBefore()');
+      } else {
+        // Fallback: traditional move.
+        // Note: This WILL close <dialog>, popover, and fullscreen elements.
+        const wasOpen = feedbackDialog.hasAttribute('open') || feedbackDialog.matches(':popover-open');
+        targetContainer.insertBefore(feedbackDialog, null);
+
+        // Manually restore state if possible
+        if (wasOpen && typeof feedbackDialog.showModal === 'function') {
+          feedbackDialog.showModal();
+        } else if (wasOpen && typeof feedbackDialog.showPopover === 'function') {
+          feedbackDialog.showPopover();
+        }
+
+        if (hadFocusInside && activeEl && typeof activeEl.focus === 'function') {
+          activeEl.focus();
+          if (selectionStart !== null && selectionEnd !== null && typeof activeEl.setSelectionRange === 'function') {
+            try {
+              activeEl.setSelectionRange(selectionStart, selectionEnd);
+            } catch {
+              // Ignore inputs that do not support selection ranges
+            }
+          }
+        }
+        updateParentIndicator('insertBefore() fallback + showModal()');
+      }
+    }
+
+    // Place dialog initially inside #feedback-host-main
+    moveFeedbackModal(dockContainers[0]);
+    reparentStatus.textContent = '';
+
+    openFabBtn.addEventListener('click', openFeedbackModal);
+    openInlineBtn.addEventListener('click', openFeedbackModal);
+
+    closeBtn.addEventListener('click', () => {
+      feedbackDialog.close('cancel');
+    });
+
+    moveModalBtn.addEventListener('click', () => {
+      currentDockIndex = (currentDockIndex + 1) % dockContainers.length;
+      const nextContainer = dockContainers[currentDockIndex];
+      moveFeedbackModal(nextContainer);
+    });
+  </script>
