+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-modal');
+      const moveBtn = document.getElementById('move-dialog-btn');
+      const secondaryMoveBtn = document.getElementById('secondary-move-btn');
+      const closeBtn = document.getElementById('close-dialog-btn');
+      const floatingTrigger = document.getElementById('floating-feedback-trigger');
+      const navTrigger = document.getElementById('nav-feedback-trigger');
+      const hostLabelCode = document.getElementById('dialog-current-host');
+      const moveCountSpan = document.getElementById('dialog-move-count');
+      const apiModeBadge = document.getElementById('dialog-api-mode');
+      const feedbackForm = document.getElementById('feedback-form');
+      const feedbackToast = document.getElementById('feedback-toast');
+
+      const hostIds = [
+        'feedback-host-root',
+        'feedback-host-aside',
+        'feedback-host-footer-slot',
+        'feedback-host-hero',
+        'feedback-host-footer'
+      ];
+
+      const hosts = hostIds
+        .map((id) => document.getElementById(id))
+        .filter(Boolean);
+
+      let moveCount = 0;
+
+      /**
+       * Captures transient UI and focus state inside the modal before fallback reparenting.
+       */
+      function captureModalState(modalEl) {
+        const activeEl = document.activeElement;
+        const isFocusInside = modalEl.contains(activeEl);
+        let selectionStart = null;
+        let selectionEnd = null;
+        let selectionDirection = null;
+
+        if (isFocusInside && activeEl && typeof activeEl.selectionStart === 'number') {
+          try {
+            selectionStart = activeEl.selectionStart;
+            selectionEnd = activeEl.selectionEnd;
+            selectionDirection = activeEl.selectionDirection;
+          } catch (_) {
+            // Some input types do not support selection ranges
+          }
+        }
+
+        const formControls = Array.from(modalEl.querySelectorAll('input, select, textarea')).map((el) => ({
+          el,
+          value: el.value,
+          checked: el.checked,
+          scrollTop: el.scrollTop,
+          scrollLeft: el.scrollLeft
+        }));
+
+        return {
+          wasOpen: modalEl.open,
+          wasModal: modalEl.matches(':modal'),
+          scrollTop: modalEl.scrollTop,
+          scrollLeft: modalEl.scrollLeft,
+          activeEl: isFocusInside ? activeEl : null,
+          selectionStart,
+          selectionEnd,
+          selectionDirection,
+          formControls
+        };
+      }
+
+      /**
+       * Restores modal open mode, form values, scroll positions, and active focus/selection
+       * when falling back to standard DOM insertion (or if a browser drops focus).
+       */
+      function restoreModalState(modalEl, snapshot, fallbackFocusEl) {
+        if (snapshot.wasOpen && !modalEl.open) {
+          if (snapshot.wasModal && typeof modalEl.showModal === 'function') {
+            try {
+              modalEl.showModal();
+            } catch (_) {
+              modalEl.setAttribute('open', '');
+            }
+          } else if (typeof modalEl.show === 'function') {
+            modalEl.show();
+          } else {
+            modalEl.setAttribute('open', '');
+          }
+        }
+
+        snapshot.formControls.forEach((item) => {
+          if (typeof item.value === 'string') {
+            item.el.value = item.value;
+          }
+          if (typeof item.checked === 'boolean') {
+            item.el.checked = item.checked;
+          }
+          item.el.scrollTop = item.scrollTop;
+          item.el.scrollLeft = item.scrollLeft;
+        });
+
+        modalEl.scrollTop = snapshot.scrollTop;
+        modalEl.scrollLeft = snapshot.scrollLeft;
+
+        const targetFocus = (snapshot.activeEl && modalEl.contains(snapshot.activeEl))
+          ? snapshot.activeEl
+          : fallbackFocusEl;
+
+        if (targetFocus && typeof targetFocus.focus === 'function') {
+          targetFocus.focus({ preventScroll: true });
+          if (
+            targetFocus === snapshot.activeEl &&
+            typeof snapshot.selectionStart === 'number' &&
+            typeof targetFocus.setSelectionRange === 'function'
+          ) {
+            try {
+              targetFocus.setSelectionRange(
+                snapshot.selectionStart,
+                snapshot.selectionEnd,
+                snapshot.selectionDirection || 'none'
+              );
+            } catch (_) {
+              // Ignore if element does not support setSelectionRange
+            }
+          }
+        }
+      }
+
+      /**
+       * Relocates the open <dialog> to the next host container in the DOM using the
+       * state-preserving Element.prototype.moveBefore API, with a seamless fallback
+       * for browsers without moveBefore support.
+       */
+      function relocateFeedbackDialog(triggerButton) {
+        if (!dialog || hosts.length === 0) return;
+
+        // Ensure the dialog is open in modal top-layer before/during move
+        if (!dialog.open) {
+          openFeedbackModal();
+        }
+
+        const currentParent = dialog.parentElement;
+        const currentIndex = hosts.indexOf(currentParent);
+        const nextIndex = (currentIndex + 1) % hosts.length;
+        const nextHost = hosts[nextIndex];
+
+        const snapshot = captureModalState(dialog);
+        const focusFallback = snapshot.activeEl || triggerButton || moveBtn;
+
+        let usedNativeMoveBefore = false;
+
+        if (typeof nextHost.moveBefore === 'function') {
+          try {
+            nextHost.moveBefore(dialog, null);
+            usedNativeMoveBefore = true;
+          } catch (_) {
+            usedNativeMoveBefore = false;
+          }
+        }
+
+        if (!usedNativeMoveBefore) {
+          // Fallback: insertBefore removes and re-inserts the element, which closes <dialog>
+          nextHost.insertBefore(dialog, null);
+          restoreModalState(dialog, snapshot, focusFallback);
+        } else {
+          // Ensure focus remains active inside the modal even if triggered externally
+          if (!dialog.contains(document.activeElement) && focusFallback) {
+            focusFallback.focus({ preventScroll: true });
+          }
+        }
+
+        moveCount += 1;
+        dialog.dataset.moveCount = String(moveCount);
+        dialog.dataset.lastMoveApi = usedNativeMoveBefore ? 'moveBefore' : 'fallback';
+
+        updateHostIndicators(nextHost, usedNativeMoveBefore);
+      }
+
+      function updateHostIndicators(activeHost, usedNativeMoveBefore) {
+        hosts.forEach((host) => {
+          host.classList.toggle('active-host', host === activeHost);
+        });
+
+        if (hostLabelCode && activeHost) {
+          hostLabelCode.textContent = '#' + activeHost.id;
+        }
+
+        if (moveCountSpan) {
+          moveCountSpan.textContent = String(moveCount);
+        }
+
+        if (apiModeBadge) {
+          if (moveCount === 0) {
+            const supported = typeof Element.prototype.moveBefore === 'function';
+            apiModeBadge.textContent = supported ? 'moveBefore() supported' : 'Fallback mode ready';
+            apiModeBadge.classList.toggle('fallback', !supported);
+          } else if (usedNativeMoveBefore) {
+            apiModeBadge.textContent = 'Moved via moveBefore()';
+            apiModeBadge.classList.remove('fallback');
+          } else {
+            apiModeBadge.textContent = 'Moved via Fallback (state restored)';
+            apiModeBadge.classList.add('fallback');
+          }
+        }
+      }
+
+      function openFeedbackModal() {
+        if (!dialog) return;
+        if (!dialog.open) {
+          if (typeof dialog.showModal === 'function') {
+            try {
+              dialog.showModal();
+            } catch (_) {
+              dialog.setAttribute('open', '');
+            }
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+      }
+
+      function closeFeedbackModal() {
+        if (!dialog) return;
+        if (dialog.open) {
+          if (typeof dialog.close === 'function') {
+            dialog.close();
+          } else {
+            dialog.removeAttribute('open');
+          }
+        }
+      }
+
+      // Prevent unintentional backdrop dismissal so the feedback overlay stays persistent
+      dialog.addEventListener('cancel', (event) => {
+        event.preventDefault();
+      });
+
+      moveBtn.addEventListener('click', () => relocateFeedbackDialog(moveBtn));
+      secondaryMoveBtn.addEventListener('click', () => relocateFeedbackDialog(secondaryMoveBtn));
+      closeBtn.addEventListener('click', closeFeedbackModal);
+      floatingTrigger.addEventListener('click', openFeedbackModal);
+      navTrigger.addEventListener('click', openFeedbackModal);
+
+      feedbackForm.addEventListener('submit', (event) => {
+        // Keep the persistent feedback overlay open on save unless explicitly closed
+        event.preventDefault();
+        const nameVal = document.getElementById('feedback-name').value.trim() || 'Guest';
+        const drinkSelect = document.getElementById('feedback-drink');
+        const drinkLabel = drinkSelect.options[drinkSelect.selectedIndex].text;
+        feedbackToast.textContent = 'Thanks, ' + nameVal + '! Your feedback on ' + drinkLabel + ' has been saved.';
+        feedbackToast.classList.add('visible');
+      });
+
+      // Open the persistent feedback modal initially so it is immediately interactive
+      updateHostIndicators(dialog.parentElement, typeof Element.prototype.moveBefore === 'function');
+      openFeedbackModal();
+    })();
+  </script>
 </body>
 
