+    <script>
+      import {
+        swapFunctions,
+        type TransitionBeforePreparationEvent,
+        type TransitionBeforeSwapEvent,
+      } from "astro:transitions/client";
+
+      interface CachedView {
+        title: string;
+        element: HTMLElement;
+      }
+
+      const viewCache = new Map<string, CachedView>();
+
+      function normalizePath(pathname: string): string {
+        return pathname.length > 1 && pathname.endsWith("/")
+          ? pathname.slice(0, -1)
+          : pathname;
+      }
+
+      function cacheCurrentView(rawPathname: string) {
+        const pathname = normalizePath(rawPathname);
+        const outlet = document.getElementById("view-outlet");
+        if (!outlet) return;
+        const activeView =
+          outlet.querySelector<HTMLElement>(
+            `[data-view-path="${CSS.escape(pathname)}"]`,
+          ) ||
+          outlet.querySelector<HTMLElement>(
+            `[data-view-path="${CSS.escape(rawPathname)}"]`,
+          );
+        if (activeView) {
+          activeView.setAttribute("data-view-path", pathname);
+          viewCache.set(pathname, {
+            title: document.title,
+            element: activeView,
+          });
+        }
+      }
+
+      cacheCurrentView(window.location.pathname);
+
+      document.addEventListener("astro:before-preparation", (event) => {
+        const prepEvent = event as TransitionBeforePreparationEvent;
+        const fromPath = normalizePath(prepEvent.from.pathname);
+        const toPath = normalizePath(prepEvent.to.pathname);
+
+        cacheCurrentView(fromPath);
+
+        if (!prepEvent.formData && viewCache.has(toPath)) {
+          const cached = viewCache.get(toPath)!;
+          const originalLoader = prepEvent.loader;
+          prepEvent.loader = async () => {
+            if (!document.contains(cached.element)) {
+              viewCache.delete(toPath);
+              return originalLoader();
+            }
+            const doc = document.implementation.createHTMLDocument(cached.title);
+            const meta = doc.createElement("meta");
+            meta.setAttribute("name", "astro-view-transitions-enabled");
+            meta.setAttribute("content", "true");
+            doc.head.appendChild(meta);
+            prepEvent.newDocument = doc;
+          };
+        }
+      });
+
+      document.addEventListener("astro:before-swap", (event) => {
+        const swapEvent = event as TransitionBeforeSwapEvent;
+        const toPath = normalizePath(swapEvent.to.pathname);
+        const outlet = document.getElementById("view-outlet");
+        if (!outlet) return;
+
+        const cached = viewCache.get(toPath);
+
+        if (cached && document.contains(cached.element)) {
+          swapEvent.swap = () => {
+            document.title = cached.title;
+            for (const child of Array.from(outlet.children)) {
+              if (child instanceof HTMLElement) {
+                const isTarget = child === cached.element;
+                child.hidden = !isTarget;
+                child.style.display = isTarget ? "" : "none";
+              }
+            }
+          };
+        } else {
+          const incomingMain = swapEvent.newDocument.querySelector<HTMLElement>(
+            "#view-outlet > main, main[data-view-path]",
+          );
+          if (!incomingMain) return;
+
+          incomingMain.setAttribute("data-view-path", toPath);
+
+          swapEvent.swap = () => {
+            swapFunctions.deselectScripts(swapEvent.newDocument);
+            swapFunctions.swapRootAttributes(swapEvent.newDocument);
+            swapFunctions.swapHeadElements(swapEvent.newDocument);
+            const restoreFocus = swapFunctions.saveFocus();
+
+            for (const child of Array.from(outlet.children)) {
+              if (child instanceof HTMLElement) {
+                child.hidden = true;
+                child.style.display = "none";
+              }
+            }
+
+            const existing = outlet.querySelector<HTMLElement>(
+              `[data-view-path="${CSS.escape(toPath)}"]`,
+            );
+            if (existing) {
+              existing.replaceWith(incomingMain);
+            } else {
+              outlet.appendChild(incomingMain);
+            }
+
+            incomingMain.hidden = false;
+            incomingMain.style.display = "";
+
+            viewCache.set(toPath, {
+              title: swapEvent.newDocument.title || document.title,
+              element: incomingMain,
+            });
+
+            restoreFocus();
+          };
+        }
+      });
+
+      document.addEventListener("astro:page-load", () => {
+        cacheCurrentView(window.location.pathname);
+      });
+    </script>
   </body>
