diff --git a/src/layouts/Layout.astro b/src/layouts/Layout.astro
index dcf9696..da7c63f 100644
--- a/src/layouts/Layout.astro
+++ b/src/layouts/Layout.astro
@@ -38,18 +38,115 @@ const baseUrl = import.meta.env.BASE_URL;
   </head>
   <body class="bg-gray-100">
     <div class="mx-auto">
-      <AdSlotFireplace client:load />
+      <AdSlotFireplace client:load transition:persist="fireplace-ads" />
       <div
         class="max-w-6xl w-full bg-white shadow-sm min-h-screen z-10 m-auto"
       >
-        <div>
+        <div transition:persist="site-header">
           <Header />
         </div>
-        <main class="bg-white relative">
-          <slot />
+        <main
+          id="spa-view-container"
+          class="bg-white relative"
+          transition:persist="spa-view-container"
+        >
+          <div
+            class="spa-view"
+            data-view-path={Astro.url.pathname}
+            aria-hidden="false"
+            tabindex="-1"
+          >
+            <slot />
+          </div>
         </main>
       </div>
     </div>
-    <Footer />
+    <Footer transition:persist="site-footer" />
+
+    <script>
+      import { swapFunctions } from "astro:transitions/client";
+
+      const MAX_CACHED_VIEWS = 5;
+      const viewCacheOrder: string[] = [];
+
+      function touchCachedView(path: string) {
+        const existingIdx = viewCacheOrder.indexOf(path);
+        if (existingIdx !== -1) {
+          viewCacheOrder.splice(existingIdx, 1);
+        }
+        viewCacheOrder.push(path);
+      }
+
+      function evictOldViews(container: HTMLElement, activePath: string) {
+        while (viewCacheOrder.length > MAX_CACHED_VIEWS) {
+          const oldestPath = viewCacheOrder.shift();
+          if (oldestPath && oldestPath !== activePath) {
+            const oldView = container.querySelector<HTMLElement>(
+              `.spa-view[data-view-path="${CSS.escape(oldestPath)}"]`
+            );
+            oldView?.remove();
+          }
+        }
+      }
+
+      function activateView(container: HTMLElement, targetView: HTMLElement) {
+        container.querySelectorAll<HTMLElement>(".spa-view").forEach((view) => {
+          if (view === targetView) {
+            view.classList.remove("inactive");
+            view.setAttribute("aria-hidden", "false");
+          } else {
+            view.classList.add("inactive");
+            view.setAttribute("aria-hidden", "true");
+          }
+        });
+        targetView.focus({ preventScroll: true });
+      }
+
+      // Record the initial server-rendered view in our LRU cache
+      const initialView = document.querySelector<HTMLElement>(
+        "#spa-view-container > .spa-view[data-view-path]"
+      );
+      if (initialView?.dataset.viewPath) {
+        touchCachedView(initialView.dataset.viewPath);
+      }
+
+      document.addEventListener("astro:before-swap", (event: any) => {
+        const currentContainer = document.getElementById("spa-view-container");
+        const incomingView = event.newDocument.querySelector(
+          "#spa-view-container > .spa-view"
+        ) as HTMLElement | null;
+
+        if (!currentContainer || !incomingView) {
+          return;
+        }
+
+        const targetPath =
+          incomingView.dataset.viewPath || window.location.pathname;
+
+        event.swap = () => {
+          swapFunctions.deselectScripts(event.newDocument);
+          swapFunctions.swapRootAttributes(event.newDocument);
+          swapFunctions.swapHeadElements(event.newDocument);
+          const restoreFocusFunction = swapFunctions.saveFocus();
+
+          let targetView = currentContainer.querySelector<HTMLElement>(
+            `.spa-view[data-view-path="${CSS.escape(targetPath)}"]`
+          );
+
+          if (!targetView) {
+            targetView = document.adoptNode(incomingView);
+            targetView.dataset.viewPath = targetPath;
+            currentContainer.appendChild(targetView);
+          }
+
+          touchCachedView(targetPath);
+          activateView(currentContainer, targetView);
+          evictOldViews(currentContainer, targetPath);
+
+          restoreFocusFunction();
+          targetView.focus({ preventScroll: true });
+        };
+      });
+    </script>
   </body>
 </html>
