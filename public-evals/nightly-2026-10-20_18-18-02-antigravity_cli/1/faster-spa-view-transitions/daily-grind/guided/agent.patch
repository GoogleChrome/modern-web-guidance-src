+        '/account': { viewId: 'view-account', routeKey: 'account' },
+        '/logout': { viewId: 'view-logout', routeKey: 'logout' },
+        '/order-online': { viewId: 'view-order-online', routeKey: 'order-online' },
+        '/about': { viewId: 'view-about', routeKey: 'about' },
+        '/careers': { viewId: 'view-careers', routeKey: 'careers' },
+        '/contact': { viewId: 'view-contact', routeKey: 'contact' },
+        '/privacy-policy': { viewId: 'view-privacy-policy', routeKey: 'privacy-policy' }
+      };
+
+      function applyMenuFilter(category) {
+        const filterButtons = document.querySelectorAll('.filter-btn');
+        filterButtons.forEach((btn) => {
+          btn.classList.toggle('active', btn.dataset.filter === category);
+        });
+        updateMenuItems();
+      }
+
+      function updateMenuItems() {
+        const activeFilterBtn = document.querySelector('.filter-btn.active');
+        const activeCategory = activeFilterBtn ? activeFilterBtn.dataset.filter : 'all';
+        const query = (document.getElementById('menu-search')?.value || '').trim().toLowerCase();
+
+        document.querySelectorAll('#menu-grid .card').forEach((card) => {
+          const matchesCategory = activeCategory === 'all' || card.dataset.itemCategory === activeCategory;
+          const matchesQuery = !query || card.textContent.toLowerCase().includes(query);
+          card.hidden = !(matchesCategory && matchesQuery);
+        });
+      }
+
+      function switchToView(viewId, options = {}) {
+        const targetView = document.getElementById(viewId);
+        if (!targetView) return;
+
+        // Hide all views while keeping their DOM structure & rendering state cached via content-visibility: hidden
+        document.querySelectorAll('.spa-view').forEach((view) => {
+          const isTarget = view === targetView;
+          view.classList.toggle('inactive', !isTarget);
+          view.setAttribute('aria-hidden', isTarget ? 'false' : 'true');
+        });
+
+        // Update active link indicator in navigation
+        const routeKey = targetView.dataset.view;
+        document.querySelectorAll('nav a[data-route]').forEach((navLink) => {
+          if (navLink.dataset.route === routeKey && !navLink.classList.contains('logo')) {
+            navLink.setAttribute('aria-current', 'page');
+          } else {
+            navLink.removeAttribute('aria-current');
+          }
+        });
+
+        if (options.category) {
+          applyMenuFilter(options.category);
+        }
+
+        if (options.item) {
+          const drinkSelect = document.getElementById('order-drink');
+          if (drinkSelect) {
+            drinkSelect.value = options.item;
+          }
+        }
+
+        if (options.moveFocus !== false) {
+          // MANDATORY: Move focus to the new view to ensure a logical tab-order
+          targetView.focus();
+        }
+      }
+
+      function resolvePath(pathname) {
+        const normalized = pathname.length > 1 && pathname.endsWith('/')
+          ? pathname.slice(0, -1)
+          : pathname;
+        return ROUTE_MAP[normalized] || ROUTE_MAP['/'];
+      }
+
+      function navigateTo(pathname, extraOptions = {}) {
+        const matched = resolvePath(pathname);
+        if (window.location.pathname !== pathname) {
+          window.history.pushState({ viewId: matched.viewId, pathname }, '', pathname);
+        }
+        switchToView(matched.viewId, {
+          category: extraOptions.category || matched.category,
+          item: extraOptions.item,
+          moveFocus: true
+        });
+      }
+
+      // Intercept internal SPA navigation clicks
+      document.addEventListener('click', (event) => {
+        const link = event.target.closest('a[href]');
+        if (!link) return;
+
+        const href = link.getAttribute('href');
+        if (!href || !href.startsWith('/') || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
+          return;
+        }
+
+        event.preventDefault();
+        navigateTo(href, {
+          category: link.dataset.category,
+          item: link.dataset.item
+        });
+      });
+
+      // Handle browser Back/Forward buttons
+      window.addEventListener('popstate', () => {
+        const matched = resolvePath(window.location.pathname);
+        switchToView(matched.viewId, {
+          category: matched.category,
+          moveFocus: true
+        });
+      });
+
+      // Menu interactive filtering & search
+      document.querySelectorAll('.filter-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          applyMenuFilter(btn.dataset.filter);
+        });
+      });
+
+      const menuSearch = document.getElementById('menu-search');
+      if (menuSearch) {
+        menuSearch.addEventListener('input', updateMenuItems);
+      }
+
+      // Rewards redemption interaction
+      document.querySelectorAll('.redeem-btn').forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const cost = Number(btn.dataset.cost || 0);
+          const pointsEl = document.getElementById('rewards-points');
+          const current = Number(pointsEl.textContent || 0);
+          if (current >= cost) {
+            pointsEl.textContent = String(current - cost);
+            btn.textContent = 'Redeemed!';
+          } else {
+            btn.textContent = 'Need More Beans';
+          }
+        });
+      });
+
+      // Preserve form state without full-page reloads
+      const accountForm = document.getElementById('account-form');
+      if (accountForm) {
+        accountForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          document.getElementById('account-saved-msg').textContent = 'Preferences saved!';
+        });
+      }
+
+      const orderForm = document.getElementById('order-form');
+      if (orderForm) {
+        orderForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          const drink = document.getElementById('order-drink').value;
+          const size = document.getElementById('order-size').value;
+          document.getElementById('order-status-msg').textContent = `Order queued: ${size} ${drink}`;
+        });
+      }
+
+      const contactForm = document.getElementById('contact-form');
+      if (contactForm) {
+        contactForm.addEventListener('submit', (e) => {
+          e.preventDefault();
+          document.getElementById('contact-status-msg').textContent = 'Message sent! We will reply shortly.';
+        });
+      }
+
+      // Initialize view based on initial URL path without stealing initial focus
+      const initialRoute = resolvePath(window.location.pathname);
+      switchToView(initialRoute.viewId, {
+        category: initialRoute.category,
+        moveFocus: false
+      });
+    })();
+  </script>
 </body>
 
