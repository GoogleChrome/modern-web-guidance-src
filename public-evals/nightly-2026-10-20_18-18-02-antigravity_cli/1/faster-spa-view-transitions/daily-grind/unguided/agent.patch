+      function normalizePath(rawPath) {
+        if (!rawPath) return '/';
+        try {
+          const url = new URL(rawPath, window.location.origin);
+          let p = url.pathname.replace(/\/+$/, '');
+          return p || '/';
+        } catch (e) {
+          let p = String(rawPath).split('?')[0].split('#')[0].replace(/\/+$/, '');
