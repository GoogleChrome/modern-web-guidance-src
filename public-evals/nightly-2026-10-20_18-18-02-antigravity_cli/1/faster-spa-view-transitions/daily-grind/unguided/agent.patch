+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function navigateTo(rawPath, options = { pushState: true }) {
+        const targetPath = normalizePath(rawPath);
+        const isAlreadyRendered = viewCache.has(targetPath);
+
+        // Save current scroll position for the active view before switching
+        scrollPositions.set(currentPath, window.scrollY);
