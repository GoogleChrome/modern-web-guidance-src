+  <script>
+    const revealBtn = document.getElementById('reveal-coupon-btn');
+    const couponPanel = document.getElementById('coupon-panel');
+
+    function syncCouponRevealedState() {
+      revealBtn.setAttribute('aria-expanded', 'true');
+      revealBtn.disabled = true;
+      revealBtn.textContent = 'Coupon Revealed';
+    }
+
+    revealBtn.addEventListener('click', () => {
+      couponPanel.removeAttribute('hidden');
+      syncCouponRevealedState();
+    });
+
+    couponPanel.addEventListener('beforematch', () => {
+      syncCouponRevealedState();
+    });
+
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      document.querySelectorAll('[hidden="until-found"]').forEach((el) => {
+        el.removeAttribute('hidden');
+        const controller = document.querySelector(`[aria-controls="${el.id}"]`);
+        if (controller) {
+          controller.setAttribute('aria-expanded', 'true');
+          if (controller === revealBtn) {
+            syncCouponRevealedState();
+          }
+        }
+      });
+    }
+  </script>
