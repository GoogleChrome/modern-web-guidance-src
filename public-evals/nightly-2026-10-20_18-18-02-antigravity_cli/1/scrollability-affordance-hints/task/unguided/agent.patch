+  <script>
+    (function () {
+      const scrollContainer = document.getElementById('reviews-scroll-container');
+      const topIndicator = document.querySelector('.indicator-top');
+      const bottomIndicator = document.querySelector('.indicator-bottom');
+
+      function updateScrollIndicators() {
+        if (!scrollContainer || !topIndicator || !bottomIndicator) return;
+
+        const { scrollTop, scrollHeight, clientHeight } = scrollContainer;
+        const canScrollUp = scrollTop > 0;
+        const canScrollDown = scrollHeight - scrollTop - clientHeight > 1;
+
+        topIndicator.classList.toggle('visible', canScrollUp);
+        bottomIndicator.classList.toggle('visible', canScrollDown);
+      }
+
+      if (scrollContainer) {
+        scrollContainer.addEventListener('scroll', updateScrollIndicators, { passive: true });
+        window.addEventListener('resize', updateScrollIndicators);
+        window.addEventListener('load', updateScrollIndicators);
+        updateScrollIndicators();
+      }
+    })();
+  </script>
