+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const preferencesForm = document.getElementById('preferences-form');
+    const statusBanner = document.getElementById('preferences-status');
+
+    preferencesForm.addEventListener('change', (event) => {
+      const target = event.target;
+      if (target instanceof HTMLInputElement && target.type === 'checkbox') {
+        const labelSpan = target.closest('label')?.querySelector('span');
+        const labelText = labelSpan ? labelSpan.textContent.trim() : target.name;
+        const stateText = target.checked ? 'enabled' : 'disabled';
+        statusBanner.textContent = `${labelText}: ${stateText}.`;
+      }
+    });
+
+    preferencesForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      statusBanner.textContent = 'Preferences saved.';
+    });
+  </script>
