+  <script>
+    (function () {
+      const switches = document.querySelectorAll('button[role="switch"]');
+      const liveRegion = document.getElementById('switch-live-region');
+
+      function setSwitchState(switchEl, isChecked, notify = true) {
+        if (switchEl.disabled || switchEl.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+
+        switchEl.setAttribute('aria-checked', String(isChecked));
+
+        const stateLabel = document.querySelector(`[data-state-for="${switchEl.id}"]`);
+        if (stateLabel) {
+          stateLabel.textContent = isChecked ? 'On' : 'Off';
+        }
+
+        if (switchEl.id === 'dark-mode-switch') {
+          document.documentElement.setAttribute('data-theme', isChecked ? 'dark' : 'light');
+          try {
+            localStorage.setItem('daily-grind-theme', isChecked ? 'dark' : 'light');
+          } catch (e) {}
+        }
+
+        if (switchEl.id === 'decaf-filter-switch') {
+          const cards = document.querySelectorAll('#menu-grid .card');
+          let visibleCount = 0;
+          cards.forEach((card) => {
+            const hasDecaf = card.getAttribute('data-decaf') === 'true';
+            const shouldHide = isChecked && !hasDecaf;
+            card.hidden = shouldHide;
+            if (!shouldHide) visibleCount++;
+          });
+          if (notify && liveRegion) {
+            liveRegion.textContent = isChecked
+              ? `Showing ${visibleCount} decaf-available drinks.`
+              : `Showing all ${cards.length} seasonal drinks.`;
+          }
+        }
+      }
+
+      function toggleSwitch(switchEl) {
+        const current = switchEl.getAttribute('aria-checked') === 'true';
+        setSwitchState(switchEl, !current, true);
+      }
+
+      switches.forEach((switchEl) => {
+        switchEl.addEventListener('click', () => {
+          toggleSwitch(switchEl);
+        });
+
+        // Associate clicking the referenced label element with toggling the switch
+        const labelId = switchEl.getAttribute('aria-labelledby');
+        if (labelId) {
+          const labelEl = document.getElementById(labelId);
+          if (labelEl) {
+            labelEl.addEventListener('click', () => {
+              switchEl.focus();
+              toggleSwitch(switchEl);
+            });
+          }
+        }
+      });
+
+      // Initialize theme from saved preference or OS color scheme
+      const darkModeSwitch = document.getElementById('dark-mode-switch');
+      if (darkModeSwitch) {
+        let initialDark = false;
+        try {
+          const saved = localStorage.getItem('daily-grind-theme');
+          if (saved === 'dark' || saved === 'light') {
+            initialDark = saved === 'dark';
+          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
+            initialDark = true;
+          }
+        } catch (e) {}
+        setSwitchState(darkModeSwitch, initialDark, false);
+      }
+    })();
+  </script>
