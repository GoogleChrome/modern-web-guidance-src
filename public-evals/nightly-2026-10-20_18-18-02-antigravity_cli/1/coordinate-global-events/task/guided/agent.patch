+  <script>
+    const TARGET_ZONES = [
+      { label: 'New York', timeZone: 'America/New_York' },
+      { label: 'London', timeZone: 'Europe/London' },
+      { label: 'Tokyo', timeZone: 'Asia/Tokyo' },
+      { label: 'UTC', timeZone: 'UTC' }
+    ];
+
+    function updateSchedule() {
+      if (typeof Temporal === 'undefined') return;
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const timeZone = hostTzSelect.value;
+
+      if (!date || !time || !timeZone) return;
+
+      const inputStr = `${date}T${time}[${timeZone}]`;
+
+      // Detect DST transition gaps or overlaps using disambiguation: 'reject'
+      let hasConflict = false;
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          hasConflict = true;
+        }
+      }
+
+      // Safely resolve the host time using 'compatible' (default)
+      let hostTime;
+      try {
+        hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+      } catch (e) {
+        return;
+      }
+
+      if (hasConflict) {
+        const earlierTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'earlier' });
+        const laterTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'later' });
+        const resolvedTimeFormatted = hostTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+        const resolvedDateFormatted = hostTime.toLocaleString('en-US', {
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+
+        let detailText;
+        if (earlierTime.hour !== Number(time.split(':')[0]) || earlierTime.minute !== Number(time.split(':')[1])) {
+          // Skipped time during a spring-forward gap
+          detailText = `The requested local time (${time}) does not exist in ${timeZone} due to a Daylight Saving Time spring-forward transition gap. Using compatible disambiguation, the time was automatically shifted forward and resolved to ${resolvedTimeFormatted} (${hostTime.offset}) on ${resolvedDateFormatted}.`;
+        } else if (!earlierTime.equals(laterTime)) {
+          // Repeated time during a fall-back overlap
+          detailText = `The requested local time (${time}) is ambiguous and occurs twice in ${timeZone} due to a Daylight Saving Time fall-back transition overlap. Using compatible disambiguation, it was resolved to the first (earlier) occurrence at ${resolvedTimeFormatted} (${hostTime.offset}) on ${resolvedDateFormatted}.`;
+        } else {
+          detailText = `This time falls in a Daylight Saving Time transition gap or overlap in ${timeZone}. Using compatible disambiguation, it was resolved to ${resolvedTimeFormatted} (${hostTime.offset}) on ${resolvedDateFormatted}.`;
+        }
+
+        hostWarning.innerHTML = '';
+        const strong = document.createElement('strong');
+        strong.textContent = 'Daylight Saving Time Conflict Detected';
+        const span = document.createElement('span');
+        span.textContent = detailText;
+        hostWarning.append(strong, span);
+        hostWarning.hidden = false;
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.hidden = true;
+      }
+
+      // Render timezone cards using immutable .withTimeZone() conversions
+      grid.innerHTML = '';
+      for (const target of TARGET_ZONES) {
+        const targetZdt = hostTime.withTimeZone(target.timeZone);
+        const formattedTime = targetZdt.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+        const formattedDate = targetZdt.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+
+        const card = document.createElement('div');
+        card.className = 'card tz-card';
+        card.dataset.timezone = target.timeZone;
+
+        const cityHeading = document.createElement('h3');
+        cityHeading.className = 'tz-city';
+        cityHeading.textContent = target.label;
+
+        const zoneBadge = document.createElement('div');
+        zoneBadge.className = 'tz-zone';
+        zoneBadge.textContent = `${target.timeZone} (${targetZdt.offset})`;
+
+        const timeDisplay = document.createElement('div');
+        timeDisplay.className = 'tz-time';
+        timeDisplay.textContent = formattedTime;
+
+        const dateDisplay = document.createElement('div');
+        dateDisplay.className = 'tz-date';
+        dateDisplay.textContent = formattedDate;
+
+        card.append(cityHeading, zoneBadge, timeDisplay, dateDisplay);
+        grid.appendChild(card);
+      }
+    }
+
+    function initializeApp() {
+      const form = document.getElementById('plannerForm');
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+
+      form.addEventListener('submit', (e) => e.preventDefault());
+
+      for (const control of [dateInput, timeInput, hostTzSelect]) {
+        control.addEventListener('change', updateSchedule);
+        control.addEventListener('input', updateSchedule);
+      }
+
+      updateSchedule();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import("https://esm.sh/@js-temporal/polyfill");
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+        initializeApp();
+      } else {
+        initializeApp();
+      }
+    })();
+  </script>
 </body>
 
