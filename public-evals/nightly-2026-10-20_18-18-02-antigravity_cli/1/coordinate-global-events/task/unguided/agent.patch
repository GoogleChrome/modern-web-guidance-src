+  <script>
+    (function () {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const TARGET_TIMEZONES = [
+        { label: 'New York', tz: 'America/New_York' },
+        { label: 'London', tz: 'Europe/London' },
+        { label: 'Tokyo', tz: 'Asia/Tokyo' },
+        { label: 'UTC', tz: 'UTC' }
+      ];
+
+      function formatLocalTime(zdt) {
+        const hour24 = zdt.hour;
+        const minute = String(zdt.minute).padStart(2, '0');
+        const period = hour24 >= 12 ? 'PM' : 'AM';
+        const hour12 = hour24 % 12 || 12;
+        return `${hour12}:${minute} ${period}`;
+      }
+
+      function formatLocalDate(zdt) {
+        return zdt.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+      }
+
+      function updateSchedule() {
+        const dateVal = dateInput.value;
+        const timeVal = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateVal || !timeVal || !hostTz) {
+          return;
+        }
+
+        const plainDate = Temporal.PlainDate.from(dateVal);
+        const plainTime = Temporal.PlainTime.from(timeVal);
+        const requestedPlainDateTime = plainDate.toPlainDateTime(plainTime);
+
+        // Compute immutable ZonedDateTime candidates across disambiguation modes
+        const earlierZdt = requestedPlainDateTime.toZonedDateTime(hostTz, { disambiguation: 'earlier' });
+        const laterZdt = requestedPlainDateTime.toZonedDateTime(hostTz, { disambiguation: 'later' });
+        const resolvedZdt = requestedPlainDateTime.toZonedDateTime(hostTz, { disambiguation: 'compatible' });
+
+        // Detect DST gap (non-existent time) or overlap (ambiguous time)
+        const resolvedPlain = resolvedZdt.toPlainDateTime();
+        const isGap = !resolvedPlain.equals(requestedPlainDateTime);
+        const isOverlap = !isGap && !earlierZdt.equals(laterZdt);
+
+        if (isGap) {
+          const requestedFormatted = `${formatLocalTime( requestedPlainDateTime )} (${timeVal})`;
+          const resolvedFormatted = `${formatLocalTime(resolvedZdt)} (${resolvedZdt.offset})`;
+          hostWarning.textContent = `Daylight Saving Time Gap Detected: The selected local time ${requestedFormatted} does not exist in ${hostTz} because clocks spring forward (transition from ${earlierZdt.offset} to ${laterZdt.offset}). Using immutable Temporal resolution ("compatible" disambiguation), the time was safely adjusted forward to ${resolvedFormatted}.`;
+          hostWarning.classList.add('visible');
+        } else if (isOverlap) {
+          const requestedFormatted = formatLocalTime(requestedPlainDateTime);
+          const resolvedFormatted = `${formatLocalTime(resolvedZdt)} (UTC${resolvedZdt.offset})`;
+          hostWarning.textContent = `Daylight Saving Time Overlap Detected: The selected local time ${requestedFormatted} is ambiguous in ${hostTz} because clocks fall back and the hour occurs twice (first at UTC${earlierZdt.offset}, then at UTC${laterZdt.offset}). Using immutable Temporal resolution ("compatible" disambiguation), the conflict was resolved to the first occurrence at ${resolvedFormatted}.`;
+          hostWarning.classList.add('visible');
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.classList.remove('visible');
+        }
+
+        // Render timezone cards using built-in immutable .withTimeZone() conversion
+        grid.innerHTML = '';
+        TARGET_TIMEZONES.forEach((target) => {
+          const targetZdt = resolvedZdt.withTimeZone(target.tz);
+          const isHost = target.tz === hostTz;
+
+          const card = document.createElement('div');
+          card.className = `card tz-card${isHost ? ' is-host' : ''}`;
+          card.dataset.timezone = target.tz;
+
+          const badgeHtml = isHost ? '<div class="tz-badge">Host Timezone</div>' : '';
+          const formattedTime = formatLocalTime(targetZdt);
+          const formattedDate = formatLocalDate(targetZdt);
+
+          card.innerHTML = `
+            ${badgeHtml}
+            <h3>${target.label}</h3>
+            <div class="tz-id">${target.tz}</div>
+            <div class="tz-time">${formattedTime}</div>
+            <div class="tz-date">${formattedDate}</div>
+            <div class="tz-offset">UTC${targetZdt.offset}</div>
+          `;
+
+          grid.appendChild(card);
+        });
+      }
+
+      dateInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+
+      updateSchedule();
+    })();
+  </script>
