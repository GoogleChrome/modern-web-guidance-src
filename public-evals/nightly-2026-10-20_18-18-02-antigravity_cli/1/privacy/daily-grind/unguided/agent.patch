+        <div class="order-meta">
+          <span>PII Collected: <strong>None</strong></span> |
+          <span>Expires: ${new Date(o.expiresAt).toLocaleTimeString()}</span>
+        </div>
+      </div>
+    `).join('');
+  }
+
+  function bindEvents() {
+    // 1. Minimalist Order Form submission
