+        if (feedbackEl) {
+          feedbackEl.hidden = false;
+          feedbackEl.className = 'feedback-banner success';
+          feedbackEl.textContent = 'All client-side storage, session vaults, and cryptographic keys have been permanently wiped.';
+        }
+      });
+    }
+
+    // 3. Privacy Preference Toggles (Strict opt-in; defaults to OFF)
+    const prefCheckboxes = document.querySelectorAll('.privacy-pref-toggle');
+    prefCheckboxes.forEach(cb => {
+      cb.addEventListener('change', async () => {
+        const prefs = {
+          saveDrinkCustomizationSessionOnly: document.getElementById('pref-session-custom')?.checked || false,
+          highContrastPrivacyBadges: document.getElementById('pref-high-contrast')?.checked || false
+        };
+        await encryptPayload({ preferences: prefs });
+        await updateVaultPreview();
+      });
+    });
+
+    // 4. Secure Logout Form Handler
+    const logoutForm = document.getElementById('secure-logout-form');
+    if (logoutForm) {
+      logoutForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+        purgeAllClientData();
+        fetch('/logout', { method: 'POST' }).finally(() => {
+          const banner = document.getElementById('session-status-banner');
+          if (banner) {
+            banner.hidden = false;
+            banner.textContent = 'Session securely terminated via POST /logout with Clear-Site-Data header & client cryptographic key destruction.';
+          }
+        });
+      });
+    }
+  }
+
+  async function init() {
+    installNetworkGuard();
+    initCsrfToken();
+    sweepBrowserStorage();
+    await initCryptoKey();
+    renderThirdPartyTable();
+    await renderHeadersTable();
+    await updateVaultPreview();
+    renderOrdersList();
+    bindEvents();
+
+    // Periodic TTL sweep every 30 seconds
+    setInterval(sweepBrowserStorage, 30000);
+  }
+
+  return {
+    init,
+    minimizeData,
+    encryptPayload,
+    decryptVault,
+    runThirdPartyAudit,
+    purgeAllClientData
+  };
+})();
+
+document.addEventListener('DOMContentLoaded', () => {
+  PrivacyEngine.init();
+});
