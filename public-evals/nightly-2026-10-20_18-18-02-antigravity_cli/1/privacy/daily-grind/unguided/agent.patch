+
+        // Encrypt in client-side Web Crypto vault
+        await encryptPayload(minimized);
+        await updateVaultPreview();
+
+        // Send minimal payload to server endpoint
+        try {
+          const res = await fetch('/api/order', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({
+              pickupAlias: minimized.pickupAlias,
+              item: minimized.item
+            })
+          });
+          const result = await res.json();
+          const orders = JSON.parse(sessionStorage.getItem('dg_ephemeral_orders') || '[]');
+          orders.unshift({
+            ...result,
+            expiresAt: Date.now() + 15 * 60 * 1000
+          });
+          sessionStorage.setItem('dg_ephemeral_orders', JSON.stringify(orders));
+          renderOrdersList();
+
+          if (feedbackEl) {
+            feedbackEl.hidden = false;
+            feedbackEl.className = 'feedback-banner success';
+            feedbackEl.innerHTML = `<strong>Order Confirmed (${result.ephemeralOrderToken})!</strong> Pickup under alias <em>"${result.pickupAlias}"</em>. Zero contact info, payment tokens, or location data stored.`;
+          }
+          orderForm.reset();
+        } catch (err) {
+          if (feedbackEl) {
+            feedbackEl.hidden = false;
+            feedbackEl.className = 'feedback-banner error';
+            feedbackEl.textContent = err.message;
+          }
+        }
+      });
+    }
+
+    // 2. Test PII Rejection & Tracker Blocking Buttons
+    const testPiiBtn = document.getElementById('btn-test-pii-rejection');
+    if (testPiiBtn) {
+      testPiiBtn.addEventListener('click', async () => {
+        const sampleExcessData = {
+          pickupAlias: 'Alex',
+          item: 'Cold Brew',
+          email: 'alex@example.com',
+          phone: '555-867-5309',
+          fullName: 'Alex Rivera',
+          gps: '37.7749,-122.4194'
+        };
+        const sanitized = minimizeData(sampleExcessData);
+        await encryptPayload(sanitized);
+        await updateVaultPreview();
+      });
+    }
+
+    const testTrackerBtn = document.getElementById('btn-test-tracker-block');
+    if (testTrackerBtn) {
+      testTrackerBtn.addEventListener('click', async () => {
+        try {
+          await window.fetch('https://www.google-analytics.com/collect?v=1&tid=UA-XXXXX-Y');
+        } catch (err) {
+          // Blocked as expected by PrivacyEngine network guard
+        }
+      });
+    }
+
+    const rerunAuditBtn = document.getElementById('btn-rerun-audit');
+    if (rerunAuditBtn) {
+      rerunAuditBtn.addEventListener('click', () => {
+        sweepBrowserStorage();
+        renderThirdPartyTable();
+        renderHeadersTable();
+      });
+    }
+
+    const purgeDataBtn = document.getElementById('btn-purge-all-data');
+    if (purgeDataBtn) {
