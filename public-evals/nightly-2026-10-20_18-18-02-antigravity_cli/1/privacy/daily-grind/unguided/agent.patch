+      'Cross-Origin-Opener-Policy': 'same-origin',
+      'Cross-Origin-Resource-Policy': 'same-origin',
+      'Cache-Control': 'no-store, max-age=0'
+    };
+
+    const entries = Object.keys(liveHeaders).length > 0 ? liveHeaders : fallbackHeaders;
+    tbody.innerHTML = Object.entries(entries).map(([key, val]) => `
+      <tr>
+        <td><code>${key}</code></td>
+        <td><code class="header-val">${val}</code></td>
+        <td><span class="badge badge-secure">ENFORCED</span></td>
+      </tr>
+    `).join('');
+  }
+
+  async function updateVaultPreview() {
+    const cipherEl = document.getElementById('vault-ciphertext-preview');
+    const plainEl = document.getElementById('vault-decrypted-preview');
+    if (!cipherEl || !plainEl) return;
+
+    const rawEnvelope = sessionStorage.getItem('dg_encrypted_vault');
+    if (!rawEnvelope) {
+      cipherEl.textContent = 'Vault empty (Zero data stored in sessionStorage)';
+      plainEl.textContent = 'No active session payload.';
+      return;
+    }
+
+    const envelope = JSON.parse(rawEnvelope);
+    cipherEl.textContent = `Algorithm: ${envelope.alg} | IV: ${envelope.iv}\nCiphertext: ${envelope.ciphertext}`;
+
+    const decrypted = await decryptVault();
+    if (decrypted) {
+      plainEl.textContent = JSON.stringify(decrypted.data, null, 2) +
+        `\n\n[Auto-Deletes at: ${new Date(decrypted.expiresAt).toLocaleTimeString()}]`;
+    } else {
+      plainEl.textContent = '[Key rotated or expired - unable to decrypt]';
+    }
+  }
+
+  function renderOrdersList() {
