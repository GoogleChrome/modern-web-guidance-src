+  const now = Date.now();
+  const key = `${ip}:${bucket}`;
+  const record = rateLimits.get(key);
+  if (!record || now - record.start > RATE_LIMIT_WINDOW_MS) {
+    rateLimits.set(key, { start: now, count: 1 });
