+export interface ClientPrivacyPreferences {
+  essential: true;
+  analytics: boolean;
+  advertising: boolean;
+  thirdPartyEmbeds: boolean;
+  updatedAt: string;
+  version: string;
+}
+
+export const PRIVACY_STORAGE_KEY = 'dtt_privacy_preferences_v2';
+export const PRIVACY_CHANGE_EVENT = 'dtt:privacy-preferences-changed';
+export const PRIVACY_OPEN_MODAL_EVENT = 'dtt:open-privacy-modal';
+
+export const DEFAULT_CLIENT_PRIVACY_PREFERENCES: ClientPrivacyPreferences = {
+  essential: true,
+  analytics: false,
+  advertising: false,
+  thirdPartyEmbeds: false,
+  updatedAt: '',
+  version: '2.0.0',
+};
+
+export function getPrivacyPreferences(): ClientPrivacyPreferences {
+  if (typeof window === 'undefined') {
+    return DEFAULT_CLIENT_PRIVACY_PREFERENCES;
+  }
+  try {
+    const raw = window.localStorage.getItem(PRIVACY_STORAGE_KEY);
+    if (!raw) return DEFAULT_CLIENT_PRIVACY_PREFERENCES;
+    const parsed = JSON.parse(raw);
+    return {
+      essential: true,
+      analytics: Boolean(parsed.analytics),
+      advertising: Boolean(parsed.advertising),
+      thirdPartyEmbeds: Boolean(parsed.thirdPartyEmbeds),
+      updatedAt: typeof parsed.updatedAt === 'string' ? parsed.updatedAt : '',
+      version: '2.0.0',
+    };
+  } catch {
+    return DEFAULT_CLIENT_PRIVACY_PREFERENCES;
+  }
+}
+
+export function savePrivacyPreferences(
+  prefs: Omit<ClientPrivacyPreferences, 'essential' | 'updatedAt' | 'version'>
+): ClientPrivacyPreferences {
+  const updated: ClientPrivacyPreferences = {
+    essential: true,
+    analytics: Boolean(prefs.analytics),
+    advertising: Boolean(prefs.advertising),
+    thirdPartyEmbeds: Boolean(prefs.thirdPartyEmbeds),
+    updatedAt: new Date().toISOString(),
+    version: '2.0.0',
+  };
+
+  if (typeof window !== 'undefined') {
+    try {
+      window.localStorage.setItem(PRIVACY_STORAGE_KEY, JSON.stringify(updated));
+    } catch {
+      // Ignore storage quota errors
+    }
+
+    // If advertising or analytics consent was revoked, purge any runtime state
+    if (!updated.advertising && Array.isArray((window as any).adNetwork)) {
+      (window as any).adNetwork = [];
+    }
+
+    window.dispatchEvent(
+      new CustomEvent(PRIVACY_CHANGE_EVENT, { detail: updated })
+    );
+  }
+
+  return updated;
+}
+
+export function clearAllClientData(): void {
+  if (typeof window === 'undefined') return;
+  try {
+    window.localStorage.clear();
+    window.sessionStorage.clear();
+  } catch {
+    // Ignore storage errors
+  }
+}
+
+export function openPrivacyModal(): void {
+  if (typeof window === 'undefined') return;
+  window.dispatchEvent(new CustomEvent(PRIVACY_OPEN_MODAL_EVENT));
+}
