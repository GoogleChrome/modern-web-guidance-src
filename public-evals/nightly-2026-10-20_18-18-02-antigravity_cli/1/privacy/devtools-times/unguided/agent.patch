diff --git a/src/pages/api/auth/login.ts b/src/pages/api/auth/login.ts
new file mode 100644
index 0000000..623d48a
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,171 @@
+import type { APIRoute } from 'astro';
+import {
+  authenticateUser,
+  getSessionUser,
+  revokeSession,
+  deleteUserAccount,
+  checkRateLimit,
+  sanitizeText,
+  DATA_MINIMIZATION_POLICY,
+} from '../../../utils/security';
+
+const SESSION_COOKIE_NAME = '__dtt_session';
+
+const SECURITY_JSON_HEADERS = {
+  'Content-Type': 'application/json; charset=utf-8',
+  'Cache-Control': 'no-store, no-cache, must-revalidate, private',
+  'Pragma': 'no-cache',
+};
+
+export const POST: APIRoute = async ({ request, cookies, clientAddress }) => {
+  try {
+    let rateKey = 'local';
+    try {
+      rateKey = clientAddress || 'local';
+    } catch {
+      rateKey = 'local';
+    }
+
+    const rate = checkRateLimit(`login:${rateKey}`);
+    if (!rate.allowed) {
+      return new Response(
+        JSON.stringify({
+          error: 'Too many sign-in attempts. Please wait before trying again.',
+          code: 'APP_ERR_RATE_LIMIT',
+        }),
+        {
+          status: 429,
+          headers: {
+            ...SECURITY_JSON_HEADERS,
+            'Retry-After': String(rate.retryAfterSeconds),
+          },
+        }
+      );
+    }
+
+    const body = await request.json().catch(() => null);
+    if (!body || typeof body !== 'object') {
+      return new Response(
+        JSON.stringify({
+          error: 'Invalid request body.',
+          code: 'APP_ERR_INVALID_PAYLOAD',
+        }),
+        { status: 400, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    // Data Minimization: reject unexpected fields
+    const allowedFields = new Set(['username', 'password']);
+    const unexpectedFields = Object.keys(body).filter((k) => !allowedFields.has(k));
+    if (unexpectedFields.length > 0) {
+      return new Response(
+        JSON.stringify({
+          error: 'Data minimization policy violation: unexpected fields submitted.',
+          code: 'APP_ERR_DATA_MINIMIZATION',
+        }),
+        { status: 400, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    const username = typeof body.username === 'string' ? sanitizeText(body.username, 32) : '';
+    const password = typeof body.password === 'string' ? body.password : '';
+
+    if (!username || !password) {
+      return new Response(
+        JSON.stringify({
+          error: 'Username and password are required.',
+          code: 'APP_ERR_2001',
+        }),
+        { status: 400, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    const authResult = authenticateUser(username, password);
+    if (!authResult.ok) {
+      return new Response(
+        JSON.stringify({
+          error: authResult.message,
+          code: authResult.code,
+        }),
+        { status: 401, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    // Set secure HttpOnly, SameSite=Strict cookie rather than exposing raw tokens to third-party scripts
+    cookies.set(SESSION_COOKIE_NAME, authResult.sessionToken, {
+      httpOnly: true,
+      secure: import.meta.env.PROD,
+      sameSite: 'strict',
+      path: '/',
+      maxAge: DATA_MINIMIZATION_POLICY.sessionTTLSeconds,
+    });
+
+    return new Response(
+      JSON.stringify({
+        message: 'Authenticated securely.',
+        user: {
+          id: authResult.user.id,
+          username: authResult.user.username,
+        },
+        sessionSecurity: {
+          cookieHttpOnly: true,
+          sameSite: 'Strict',
+          maxAgeSeconds: DATA_MINIMIZATION_POLICY.sessionTTLSeconds,
+        },
+      }),
+      { status: 200, headers: SECURITY_JSON_HEADERS }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'An unexpected error occurred during sign in.',
+        code: 'APP_ERR_INTERNAL',
+      }),
+      { status: 500, headers: SECURITY_JSON_HEADERS }
+    );
+  }
+};
+
+export const GET: APIRoute = async ({ cookies }) => {
+  const token = cookies.get(SESSION_COOKIE_NAME)?.value;
+  const user = getSessionUser(token);
+  if (!user) {
+    return new Response(JSON.stringify({ authenticated: false, user: null }), {
+      status: 200,
+      headers: SECURITY_JSON_HEADERS,
+    });
+  }
+  return new Response(
+    JSON.stringify({
+      authenticated: true,
+      user,
+    }),
+    { status: 200, headers: SECURITY_JSON_HEADERS }
+  );
+};
+
+export const DELETE: APIRoute = async ({ request, cookies, session }) => {
+  const token = cookies.get(SESSION_COOKIE_NAME)?.value;
+  const url = new URL(request.url);
+  const eraseAccount = url.searchParams.get('erase') === 'true';
+
+  if (eraseAccount) {
+    deleteUserAccount(token);
+  } else {
+    revokeSession(token);
+  }
+
+  cookies.delete(SESSION_COOKIE_NAME, { path: '/' });
+  if (session) {
+    await session.set('readingList', []);
+  }
+
+  return new Response(
+    JSON.stringify({
+      message: eraseAccount
+        ? 'Account and all associated session data permanently erased.'
+        : 'Signed out and session token revoked.',
+    }),
+    { status: 200, headers: SECURITY_JSON_HEADERS }
+  );
+};
