+/**
+ * Secure In-Memory User & Session Store (Data Minimization: no persistent PII database,
+ * salted scrypt password hashes, automatic expiration, right to erasure)
+ */
+interface StoredUser {
+  id: string;
+  username: string;
+  passwordHash: string;
+  salt: string;
+  createdAt: string;
+  privacyAcceptedAt: string;
+}
+
+interface ActiveSession {
+  tokenHash: string;
+  userId: string;
+  username: string;
+  createdAt: number;
+  expiresAt: number;
+}
+
+const userStore = new Map<string, StoredUser>();
+const sessionStore = new Map<string, ActiveSession>();
+const rateLimitStore = new Map<string, { count: number; resetAt: number }>();
+
+const SLUG_REGEX = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
+const USERNAME_REGEX = /^[a-zA-Z0-9_-]{3,32}$/;
+
+export function sanitizeText(input: unknown, maxLength = 100): string {
+  if (typeof input !== 'string') return '';
+  return input
+    .trim()
+    .slice(0, maxLength)
+    .replace(/[<>'"&]/g, (char) => {
+      switch (char) {
+        case '<':
+          return '&lt;';
+        case '>':
+          return '&gt;';
+        case "'":
+          return '&#39;';
+        case '"':
+          return '&quot;';
+        case '&':
+          return '&amp;';
+        default:
+          return char;
+      }
+    });
+}
+
+export function isValidSlug(slug: unknown): slug is string {
+  return (
+    typeof slug === 'string' &&
+    slug.length >= 1 &&
+    slug.length <= 120 &&
+    SLUG_REGEX.test(slug)
+  );
+}
+
+export function validateUsername(username: unknown): { valid: boolean; message?: string } {
+  if (typeof username !== 'string') {
+    return { valid: false, message: 'Username must be a string.' };
+  }
+  const trimmed = username.trim();
+  if (trimmed.length < DATA_MINIMIZATION_POLICY.minUsernameLength) {
+    return {
+      valid: false,
+      message: `Username must be at least ${DATA_MINIMIZATION_POLICY.minUsernameLength} characters.`,
+    };
+  }
+  if (trimmed.length > DATA_MINIMIZATION_POLICY.maxUsernameLength) {
+    return {
+      valid: false,
+      message: `Username cannot exceed ${DATA_MINIMIZATION_POLICY.maxUsernameLength} characters.`,
+    };
+  }
+  // Privacy by Design: discourage using an email address as a username to minimize PII
+  if (trimmed.includes('@')) {
+    return {
+      valid: false,
+      message:
+        'For your privacy (data minimization), please use a pseudonymous username rather than an email address.',
+    };
+  }
+  if (!USERNAME_REGEX.test(trimmed)) {
+    return {
+      valid: false,
+      message: 'Username may only contain letters, numbers, underscores, and hyphens.',
+    };
+  }
+  return { valid: true };
+}
+
+export function validatePassword(password: unknown): { valid: boolean; message?: string } {
+  if (typeof password !== 'string') {
+    return { valid: false, message: 'Password must be a string.' };
+  }
+  if (password.length < DATA_MINIMIZATION_POLICY.minPasswordLength) {
+    return {
+      valid: false,
+      message: `Password must be at least ${DATA_MINIMIZATION_POLICY.minPasswordLength} characters long.`,
+    };
+  }
+  if (password.length > DATA_MINIMIZATION_POLICY.maxPasswordLength) {
+    return {
+      valid: false,
+      message: `Password cannot exceed ${DATA_MINIMIZATION_POLICY.maxPasswordLength} characters.`,
+    };
+  }
+  if (!/\d/.test(password)) {
+    return {
+      valid: false,
+      message: 'Password must contain at least one number.',
+    };
+  }
+  return { valid: true };
+}
+
+export function hashPassword(password: string, salt?: string): { hash: string; salt: string } {
+  const actualSalt = salt || crypto.randomBytes(16).toString('hex');
+  const derivedKey = crypto.scryptSync(password, actualSalt, 64, {
+    N: 16384,
+    r: 8,
+    p: 1,
+  });
+  return {
+    hash: derivedKey.toString('hex'),
+    salt: actualSalt,
+  };
+}
+
+export function verifyPassword(password: string, storedHash: string, salt: string): boolean {
+  const { hash } = hashPassword(password, salt);
+  const hashBuffer = Buffer.from(hash, 'hex');
+  const storedBuffer = Buffer.from(storedHash, 'hex');
+  if (hashBuffer.length !== storedBuffer.length) {
+    return false;
+  }
+  return crypto.timingSafeEqual(hashBuffer, storedBuffer);
+}
+
+export function checkRateLimit(key: string, maxRequests = 10, windowMs = 60_000): {
+  allowed: boolean;
+  remaining: number;
+  retryAfterSeconds: number;
+} {
+  const now = Date.now();
+  const entry = rateLimitStore.get(key);
+  if (!entry || entry.resetAt <= now) {
+    rateLimitStore.set(key, { count: 1, resetAt: now + windowMs });
+    return { allowed: true, remaining: maxRequests - 1, retryAfterSeconds: 0 };
+  }
+  if (entry.count >= maxRequests) {
+    return {
+      allowed: false,
+      remaining: 0,
+      retryAfterSeconds: Math.ceil((entry.resetAt - now) / 1000),
+    };
+  }
+  entry.count += 1;
+  return {
+    allowed: true,
+    remaining: maxRequests - entry.count,
+    retryAfterSeconds: 0,
+  };
+}
+
+export function registerUser(
+  username: string,
+  password: string,
+  privacyConsent: boolean
+): { ok: true; userId: string } | { ok: false; code: string; message: string } {
+  if (!privacyConsent) {
+    return {
+      ok: false,
+      code: 'APP_ERR_CONSENT_REQUIRED',
+      message: 'You must acknowledge the Privacy Policy and Data Minimization Notice to register.',
+    };
+  }
+
+  const normalizedUsername = username.trim().toLowerCase();
+  if (userStore.has(normalizedUsername)) {
+    return {
+      ok: false,
+      code: 'APP_ERR_1001',
+      message: 'Username is already registered. Please choose a different pseudonymous username.',
+    };
+  }
+
+  const { hash, salt } = hashPassword(password);
+  const userId = crypto.randomUUID();
+  const now = new Date().toISOString();
+
+  userStore.set(normalizedUsername, {
+    id: userId,
+    username: normalizedUsername,
+    passwordHash: hash,
+    salt,
+    createdAt: now,
+    privacyAcceptedAt: now,
+  });
+
+  return { ok: true, userId };
+}
+
+export function authenticateUser(
+  username: string,
+  password: string
+):
+  | { ok: true; sessionToken: string; user: { id: string; username: string; createdAt: string } }
+  | { ok: false; code: string; message: string } {
+  const normalizedUsername = username.trim().toLowerCase();
+  const storedUser = userStore.get(normalizedUsername);
+
+  if (!storedUser) {
+    // Perform dummy scrypt work to prevent username enumeration via timing
+    hashPassword(password, '00000000000000000000000000000000');
+    return {
+      ok: false,
+      code: 'APP_ERR_2001',
+      message: 'Invalid username or password.',
+    };
+  }
+
+  const isValid = verifyPassword(password, storedUser.passwordHash, storedUser.salt);
+  if (!isValid) {
+    return {
+      ok: false,
+      code: 'APP_ERR_2002',
+      message: 'Invalid username or password.',
+    };
+  }
+
+  const rawToken = crypto.randomBytes(32).toString('hex');
+  const tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');
+  const now = Date.now();
+
+  sessionStore.set(tokenHash, {
+    tokenHash,
+    userId: storedUser.id,
+    username: storedUser.username,
+    createdAt: now,
+    expiresAt: now + DATA_MINIMIZATION_POLICY.sessionTTLSeconds * 1000,
+  });
+
+  return {
+    ok: true,
+    sessionToken: rawToken,
+    user: {
+      id: storedUser.id,
+      username: storedUser.username,
+      createdAt: storedUser.createdAt,
+    },
+  };
+}
+
+export function getSessionUser(
+  rawToken: string | undefined | null
+): { id: string; username: string; expiresAt: string } | null {
+  if (!rawToken || typeof rawToken !== 'string') return null;
+  const tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');
+  const session = sessionStore.get(tokenHash);
+  if (!session) return null;
+  if (Date.now() > session.expiresAt) {
+    sessionStore.delete(tokenHash);
+    return null;
+  }
+  return {
+    id: session.userId,
+    username: session.username,
+    expiresAt: new Date(session.expiresAt).toISOString(),
+  };
+}
+
+export function revokeSession(rawToken: string | undefined | null): void {
+  if (!rawToken || typeof rawToken !== 'string') return;
+  const tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');
+  sessionStore.delete(tokenHash);
+}
+
+export function deleteUserAccount(rawToken: string | undefined | null): boolean {
+  if (!rawToken || typeof rawToken !== 'string') return false;
+  const tokenHash = crypto.createHash('sha256').update(rawToken).digest('hex');
+  const session = sessionStore.get(tokenHash);
+  if (!session) return false;
+
+  userStore.delete(session.username);
+  // Purge all sessions for this user
+  for (const [key, value] of sessionStore.entries()) {
+    if (value.userId === session.userId) {
+      sessionStore.delete(key);
+    }
+  }
+  return true;
+}
