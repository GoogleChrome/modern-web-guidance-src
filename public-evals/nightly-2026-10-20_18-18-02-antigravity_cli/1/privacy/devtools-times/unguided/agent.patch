diff --git a/src/components/PrivacyPreferencesModal.tsx b/src/components/PrivacyPreferencesModal.tsx
new file mode 100644
index 0000000..cc9794b
--- /dev/null
+++ b/src/components/PrivacyPreferencesModal.tsx
@@ -0,0 +1,273 @@
+import React, { useState, useEffect } from 'react';
+import {
+  getPrivacyPreferences,
+  savePrivacyPreferences,
+  clearAllClientData,
+  PRIVACY_CHANGE_EVENT,
+  PRIVACY_OPEN_MODAL_EVENT,
+  type ClientPrivacyPreferences,
+} from '../utils/privacyClient';
+
+const ANALYTICS_SCRIPT_ID = 'dtt-third-party-analytics';
+const ANALYTICS_SCRIPT_SRC =
+  'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/lib/analytics-client.js';
+
+export default function PrivacyPreferencesModal() {
+  const [isOpen, setIsOpen] = useState(false);
+  const [prefs, setPrefs] = useState<ClientPrivacyPreferences>(() =>
+    getPrivacyPreferences()
+  );
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+
+  // Sync third-party script loading strictly based on explicit opt-in consent
+  useEffect(() => {
+    const syncThirdPartyIntegrations = (currentPrefs: ClientPrivacyPreferences) => {
+      const existingAnalytics = document.getElementById(ANALYTICS_SCRIPT_ID);
+      if (currentPrefs.analytics) {
+        if (!existingAnalytics) {
+          const script = document.createElement('script');
+          script.id = ANALYTICS_SCRIPT_ID;
+          script.src = ANALYTICS_SCRIPT_SRC;
+          script.defer = true;
+          script.crossOrigin = 'anonymous';
+          script.referrerPolicy = 'no-referrer';
+          script.dataset.consentVerified = 'true';
+          document.head.appendChild(script);
+        }
+      } else if (existingAnalytics) {
+        existingAnalytics.remove();
+      }
+    };
+
+    const initial = getPrivacyPreferences();
+    setPrefs(initial);
+    syncThirdPartyIntegrations(initial);
+
+    const handleOpen = () => {
+      setPrefs(getPrivacyPreferences());
+      setStatusMessage(null);
+      setIsOpen(true);
+    };
+
+    const handlePrefsChange = (e: Event) => {
+      const customEvent = e as CustomEvent<ClientPrivacyPreferences>;
+      if (customEvent.detail) {
+        setPrefs(customEvent.detail);
+        syncThirdPartyIntegrations(customEvent.detail);
+      }
+    };
+
+    // Intercept clicks on any [data-manage-privacy] element in Footer/Legal pages
+    const handleDocumentClick = (e: MouseEvent) => {
+      const target = (e.target as HTMLElement | null)?.closest('[data-manage-privacy]');
+      if (target) {
+        e.preventDefault();
+        handleOpen();
+      }
+    };
+
+    window.addEventListener(PRIVACY_OPEN_MODAL_EVENT, handleOpen);
+    window.addEventListener(PRIVACY_CHANGE_EVENT, handlePrefsChange);
+    document.addEventListener('click', handleDocumentClick);
+
+    return () => {
+      window.removeEventListener(PRIVACY_OPEN_MODAL_EVENT, handleOpen);
+      window.removeEventListener(PRIVACY_CHANGE_EVENT, handlePrefsChange);
+      document.removeEventListener('click', handleDocumentClick);
+    };
+  }, []);
+
+  const handleSave = (e: React.FormEvent) => {
+    e.preventDefault();
+    const saved = savePrivacyPreferences({
+      analytics: prefs.analytics,
+      advertising: prefs.advertising,
+      thirdPartyEmbeds: prefs.thirdPartyEmbeds,
+    });
+    setPrefs(saved);
+    setStatusMessage('Privacy preferences saved. Strict data minimization is active.');
+    setTimeout(() => {
+      setIsOpen(false);
+      setStatusMessage(null);
+    }, 900);
+  };
+
+  const handleRejectAllOptional = () => {
+    const saved = savePrivacyPreferences({
+      analytics: false,
+      advertising: false,
+      thirdPartyEmbeds: false,
+    });
+    setPrefs(saved);
+    setStatusMessage('All optional third-party integrations disabled.');
+  };
+
+  const handleEraseAllData = async () => {
+    try {
+      const baseUrl = import.meta.env.BASE_URL || '/';
+      await Promise.allSettled([
+        fetch(`${baseUrl}api/reading-list.json`, { method: 'DELETE' }),
+        fetch(`${baseUrl}api/auth/login?erase=true`, { method: 'DELETE' }),
+      ]);
+      clearAllClientData();
+      setPrefs(getPrivacyPreferences());
+      setStatusMessage('All session data, reading list items, and local preferences have been erased.');
+    } catch {
+      setStatusMessage('Local data cleared.');
+    }
+  };
+
+  if (!isOpen) return null;
+
+  return (
+    <div
+      className="fixed inset-0 bg-black/50 backdrop-blur-xs z-[99999] flex items-center justify-center p-4"
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="privacy-modal-title"
+      onClick={() => setIsOpen(false)}
+    >
+      <div
+        className="bg-white border border-gray-200 rounded-lg shadow-xl max-w-xl w-full p-6 max-h-[90vh] overflow-y-auto"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="flex items-start justify-between border-b border-gray-200 pb-4 mb-4">
+          <div>
+            <span className="inline-block text-xs font-semibold uppercase tracking-wider px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded mb-1">
+              Privacy by Design
+            </span>
+            <h2 id="privacy-modal-title" className="text-xl font-bold text-gray-900">
+              Privacy &amp; Data Minimization Controls
+            </h2>
+          </div>
+          <button
+            type="button"
+            onClick={() => setIsOpen(false)}
+            aria-label="Close privacy preferences"
+            className="text-gray-500 hover:text-gray-800 p-1"
+          >
+            ✕
+          </button>
+        </div>
+
+        <p className="text-sm text-gray-600 mb-4">
+          By default, <strong>The DevTools Times</strong> operates in strict{' '}
+          <strong>Zero-Tracking Mode</strong>. Third-party analytics and advertising scripts are
+          blocked unless you explicitly opt in below.
+        </p>
+
+        {statusMessage && (
+          <div
+            className="mb-4 p-3 text-sm bg-emerald-50 border border-emerald-200 text-emerald-800 rounded"
+            role="status"
+          >
+            {statusMessage}
+          </div>
+        )}
+
+        <form onSubmit={handleSave} className="space-y-4">
+          <div className="p-3 bg-gray-50 rounded border border-gray-200 flex items-start justify-between gap-4">
+            <div>
+              <p className="text-sm font-semibold text-gray-900">
+                Strictly Necessary &amp; Security (Always Active)
+              </p>
+              <p className="text-xs text-gray-600 mt-0.5">
+                Required for first-party session reading lists, CSRF protection, and strict HTTP
+                security headers. No personal data is shared with third parties.
+              </p>
+            </div>
+            <input
+              type="checkbox"
+              checked={true}
+              disabled
+              aria-label="Strictly Necessary"
+              className="mt-1 h-4 w-4 accent-gray-900"
+            />
+          </div>
+
+          <div className="p-3 bg-white rounded border border-gray-200 flex items-start justify-between gap-4">
+            <div>
+              <label htmlFor="consent-analytics" className="text-sm font-semibold text-gray-900 cursor-pointer">
+                Third-Party Analytics (Opt-In)
+              </label>
+              <p className="text-xs text-gray-600 mt-0.5">
+                Allows loading the audited Times CDN analytics client with stripped referrers and
+                anonymous credentials. Off by default.
+              </p>
+            </div>
+            <input
+              id="consent-analytics"
+              type="checkbox"
+              checked={prefs.analytics}
+              onChange={(e) => setPrefs({ ...prefs, analytics: e.target.checked })}
+              className="mt-1 h-4 w-4 accent-gray-900"
+            />
+          </div>
+
+          <div className="p-3 bg-white rounded border border-gray-200 flex items-start justify-between gap-4">
+            <div>
+              <label htmlFor="consent-advertising" className="text-sm font-semibold text-gray-900 cursor-pointer">
+                Contextual Ad Slots (Opt-In)
+              </label>
+              <p className="text-xs text-gray-600 mt-0.5">
+                Enables rendering of banner and fireplace ad slots. Topics API and interest-cohort
+                tracking remain blocked via Permissions-Policy. Off by default.
+              </p>
+            </div>
+            <input
+              id="consent-advertising"
+              type="checkbox"
+              checked={prefs.advertising}
+              onChange={(e) => setPrefs({ ...prefs, advertising: e.target.checked })}
+              className="mt-1 h-4 w-4 accent-gray-900"
+            />
+          </div>
+
+          <div className="p-3 bg-white rounded border border-gray-200 flex items-start justify-between gap-4">
+            <div>
+              <label htmlFor="consent-embeds" className="text-sm font-semibold text-gray-900 cursor-pointer">
+                External Media &amp; Embeds (Opt-In)
+              </label>
+              <p className="text-xs text-gray-600 mt-0.5">
+                Permits loading external media assets using anonymous CORS and no-referrer policies.
+              </p>
+            </div>
+            <input
+              id="consent-embeds"
+              type="checkbox"
+              checked={prefs.thirdPartyEmbeds}
+              onChange={(e) => setPrefs({ ...prefs, thirdPartyEmbeds: e.target.checked })}
+              className="mt-1 h-4 w-4 accent-gray-900"
+            />
+          </div>
+
+          <div className="border-t border-gray-200 pt-4 flex flex-wrap items-center justify-between gap-2">
+            <div className="flex flex-wrap gap-2">
+              <button
+                type="button"
+                onClick={handleRejectAllOptional}
+                className="px-3 py-2 text-xs font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 rounded"
+              >
+                Reject All Optional
+              </button>
+              <button
+                type="button"
+                onClick={handleEraseAllData}
+                className="px-3 py-2 text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 rounded"
+              >
+                Erase My Data &amp; Session
+              </button>
+            </div>
+
+            <button
+              type="submit"
+              className="px-4 py-2 text-xs font-semibold text-white bg-gray-900 hover:bg-gray-800 rounded"
+            >
+              Save Preferences
+            </button>
+          </div>
+        </form>
+      </div>
+    </div>
+  );
+}
