+++ b/src/pages/api/auth/register.ts
@@ -0,0 +1,138 @@
+import type { APIRoute } from 'astro';
+import {
+  registerUser,
+  validatePassword,
+  validateUsername,
+  checkRateLimit,
+  sanitizeText,
+} from '../../../utils/security';
+
+const SECURITY_JSON_HEADERS = {
+  'Content-Type': 'application/json; charset=utf-8',
+  'Cache-Control': 'no-store, no-cache, must-revalidate, private',
+  'Pragma': 'no-cache',
+};
+
+export const POST: APIRoute = async ({ request, clientAddress }) => {
+  try {
+    let rateKey = 'local';
+    try {
+      rateKey = clientAddress || 'local';
+    } catch {
+      rateKey = 'local';
+    }
+
+    const rate = checkRateLimit(`register:${rateKey}`);
+    if (!rate.allowed) {
+      return new Response(
+        JSON.stringify({
+          error: 'Too many registration attempts. Please try again later.',
+          code: 'APP_ERR_RATE_LIMIT',
+        }),
+        {
+          status: 429,
+          headers: {
+            ...SECURITY_JSON_HEADERS,
+            'Retry-After': String(rate.retryAfterSeconds),
+          },
+        }
+      );
+    }
+
+    const body = await request.json().catch(() => null);
+    if (!body || typeof body !== 'object') {
+      return new Response(
+        JSON.stringify({
+          error: 'Invalid request payload.',
+          code: 'APP_ERR_INVALID_PAYLOAD',
+        }),
+        { status: 400, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    // Data Minimization: reject unexpected PII fields if submitted
+    const allowedFields = new Set(['username', 'password', 'privacyConsent']);
+    const submittedFields = Object.keys(body);
+    const unexpectedFields = submittedFields.filter((f) => !allowedFields.has(f));
+    if (unexpectedFields.length > 0) {
+      return new Response(
+        JSON.stringify({
+          error: 'Data minimization policy violation: unexpected fields submitted.',
+          code: 'APP_ERR_DATA_MINIMIZATION',
+        }),
+        { status: 400, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    const rawUsername = typeof body.username === 'string' ? sanitizeText(body.username, 32) : '';
+    const rawPassword = typeof body.password === 'string' ? body.password : '';
+    const privacyConsent = Boolean(body.privacyConsent);
+
+    if (!privacyConsent) {
+      return new Response(
+        JSON.stringify({
+          error: 'Explicit consent to the Privacy Policy & Data Minimization terms is required.',
+          code: 'APP_ERR_CONSENT_REQUIRED',
+        }),
+        { status: 400, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    const usernameValidation = validateUsername(rawUsername);
+    if (!usernameValidation.valid) {
+      return new Response(
+        JSON.stringify({
+          error: usernameValidation.message,
+          code: 'APP_ERR_1001',
+        }),
+        { status: 400, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    const passwordValidation = validatePassword(rawPassword);
+    if (!passwordValidation.valid) {
+      return new Response(
+        JSON.stringify({
+          error: passwordValidation.message,
+          code: 'APP_ERR_1002',
+        }),
+        { status: 400, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    const result = registerUser(rawUsername, rawPassword, privacyConsent);
+    if (!result.ok) {
+      return new Response(
+        JSON.stringify({
+          error: result.message,
+          code: result.code,
+        }),
+        { status: 409, headers: SECURITY_JSON_HEADERS }
+      );
+    }
+
+    return new Response(
+      JSON.stringify({
+        message: 'Account created with minimal data footprint.',
+        user: {
+          id: result.userId,
+          username: rawUsername.toLowerCase(),
+        },
+        dataMinimization: {
+          storedFields: ['id', 'username', 'passwordHash', 'createdAt', 'privacyAcceptedAt'],
+          plaintextPasswordStored: false,
+          thirdPartyShared: false,
+        },
+      }),
+      { status: 201, headers: SECURITY_JSON_HEADERS }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({
+        error: 'An unexpected error occurred while processing your registration.',
+        code: 'APP_ERR_INTERNAL',
+      }),
+      { status: 500, headers: SECURITY_JSON_HEADERS }
+    );
+  }
+};
