+  <script>
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const unitRadios = document.querySelectorAll('input[name="largestUnit"]');
+    const humanValue = document.getElementById('humanValue');
+
+    function updateSteepingTime() {
+      const hours = Math.max(0, Math.trunc(Number(hoursInput.value) || 0));
+      const minutes = Math.max(0, Math.trunc(Number(minutesInput.value) || 0));
+      const selectedRadio = document.querySelector('input[name="largestUnit"]:checked');
+      const largestUnit = selectedRadio ? selectedRadio.value : 'hours';
+
+      if (typeof Temporal !== 'undefined' && Temporal.Duration) {
+        const duration = Temporal.Duration.from({ hours, minutes }).round({ largestUnit });
+        humanValue.textContent = duration.toLocaleString();
+      } else {
+        const totalMinutes = hours * 60 + minutes;
+        const durationObj = largestUnit === 'hours'
+          ? { hours: Math.floor(totalMinutes / 60), minutes: totalMinutes % 60 }
+          : { minutes: totalMinutes };
+        humanValue.textContent = new Intl.DurationFormat().format(durationObj);
+      }
+    }
+
+    hoursInput.addEventListener('input', updateSteepingTime);
+    hoursInput.addEventListener('change', updateSteepingTime);
+    minutesInput.addEventListener('input', updateSteepingTime);
+    minutesInput.addEventListener('change', updateSteepingTime);
+    unitRadios.forEach((radio) => {
+      radio.addEventListener('input', updateSteepingTime);
+      radio.addEventListener('change', updateSteepingTime);
+    });
+
+    updateSteepingTime();
+  </script>
+
