+      function loadActivities() {
+        try {
+          const raw = localStorage.getItem(ACTIVITY_KEY);
+          if (raw) {
+            const parsed = JSON.parse(raw);
+            if (Array.isArray(parsed)) return parsed;
+          }
+        } catch (err) {
+          console.warn('Could not read activity log:', err);
+        }
+        return DEFAULT_ACTIVITY.slice();
+      }
+
+      function addActivity(eventText) {
+        const entry = {
+          event: eventText,
+          timestamp: 'Just now'
+        };
+        activities.unshift(entry);
+        try {
+          localStorage.setItem(ACTIVITY_KEY, JSON.stringify(activities.slice(0, 20)));
+        } catch (err) {}
+        renderActivityLog();
+      }
+
+      function formatDate(isoStr) {
+        if (!isoStr) return 'Never used';
+        if (isoStr === 'Just now') return 'Just now';
+        const d = new Date(isoStr);
+        if (isNaN(d.getTime())) return isoStr;
+        return d.toLocaleDateString('en-US', {
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+      }
+
+      function escapeHtml(str) {
+        return String(str)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+      }
+
+      function getIconSvg(type) {
+        if (type === 'hardware') {
+          return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
+            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
+            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
+          </svg>`;
+        }
+        if (type === 'platform') {
+          return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
+            <rect x="2" y="3" width="20" height="14" rx="2"/>
+            <line x1="8" y1="21" x2="16" y2="21"/>
+            <line x1="12" y1="17" x2="12" y2="21"/>
+          </svg>`;
+        }
+        return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
+          <circle cx="7.5" cy="15.5" r="5.5"/>
+          <path d="m21 2-9.6 9.6"/>
+          <path d="m15.5 7.5 3 3L22 7l-3-3"/>
+        </svg>`;
+      }
+
+      function getTypeBadge(type) {
+        if (type === 'hardware') {
+          return `<span class="badge badge-hardware">Hardware Key</span>`;
+        }
+        if (type === 'platform') {
+          return `<span class="badge badge-platform">Device Bound</span>`;
+        }
+        return `<span class="badge badge-synced">Cloud Synced</span>`;
+      }
+
+      function updateHeaderStatus() {
+        const countEl = document.getElementById('sidebar-passkey-count');
+        const dotEl = document.getElementById('security-status-dot');
+        const titleEl = document.getElementById('security-status-title');
+        const subtitleEl = document.getElementById('security-status-subtitle');
+
+        countEl.textContent = String(passkeys.length);
+
+        if (passkeys.length === 0) {
+          dotEl.classList.add('warning');
+          titleEl.textContent = 'No Passkeys Registered';
+          subtitleEl.textContent = 'Register a passkey for faster, phishing-resistant login';
+        } else {
+          dotEl.classList.remove('warning');
+          titleEl.textContent = `Passkey Protection Active (${passkeys.length})`;
+          subtitleEl.textContent = 'Phishing-resistant sign-in enabled';
+        }
+      }
+
+      function renderPasskeys() {
+        const listEl = document.getElementById('passkeys-list');
+        const searchVal = document.getElementById('passkey-search').value.trim().toLowerCase();
+        const typeFilter = document.getElementById('passkey-filter-type').value;
+        const summaryEl = document.getElementById('passkey-showing-summary');
+
+        updateHeaderStatus();
+
+        const filtered = passkeys.filter(pk => {
+          const matchesType = typeFilter === 'all' || pk.type === typeFilter;
+          const matchesSearch =
+            !searchVal ||
+            pk.name.toLowerCase().includes(searchVal) ||
+            pk.provider.toLowerCase().includes(searchVal) ||
+            pk.credentialId.toLowerCase().includes(searchVal);
+          return matchesType && matchesSearch;
+        });
+
+        summaryEl.textContent = `Showing ${filtered.length} of ${passkeys.length} passkey${passkeys.length === 1 ? '' : 's'}`;
+
+        if (filtered.length === 0) {
+          listEl.innerHTML = `
+            <div class="empty-state">
+              <div class="empty-state-icon">
+                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
+                  <circle cx="7.5" cy="15.5" r="5.5"/>
+                  <path d="m21 2-9.6 9.6"/>
+                  <path d="m15.5 7.5 3 3L22 7l-3-3"/>
+                </svg>
+              </div>
+              <h3>${passkeys.length === 0 ? 'No passkeys registered yet' : 'No matching passkeys found'}</h3>
+              <p>
+                ${
+                  passkeys.length === 0
+                    ? 'Add a passkey to sign in to your Daily Grind account with Touch ID, Face ID, Windows Hello, or a hardware security key.'
+                    : 'Try clearing your search query or switching the authenticator type filter.'
+                }
+              </p>
+              ${
+                passkeys.length === 0
+                  ? '<button type="button" class="btn btn-accent" id="empty-add-passkey-btn">Register Your First Passkey</button>'
+                  : ''
+              }
+            </div>
+          `;
+          const emptyBtn = document.getElementById('empty-add-passkey-btn');
+          if (emptyBtn) {
+            emptyBtn.addEventListener('click', openRegisterModal);
+          }
+          return;
+        }
+
+        listEl.innerHTML = filtered
+          .map(pk => {
+            const isEditing = editingPasskeyId === pk.id;
+            return `
+              <div class="passkey-item ${pk.isCurrentDevice ? 'recently-used' : ''}" role="listitem" data-passkey-id="${escapeHtml(pk.id)}">
+                <div class="passkey-main">
+                  <div class="passkey-icon" aria-hidden="true">
+                    ${getIconSvg(pk.type)}
+                  </div>
+                  <div class="passkey-details">
+                    ${
+                      isEditing
+                        ? `
+                          <form class="inline-rename-form" data-rename-form="${escapeHtml(pk.id)}">
+                            <input
+                              type="text"
+                              class="form-input"
+                              name="newName"
+                              value="${escapeHtml(pk.name)}"
+                              aria-label="New passkey name"
+                              required
+                              maxlength="60"
+                            >
+                            <button type="submit" class="btn btn-sm">Save</button>
+                            <button type="button" class="btn btn-outline btn-sm" data-cancel-rename="${escapeHtml(pk.id)}">Cancel</button>
+                          </form>
+                        `
+                        : `
+                          <div class="passkey-title-row">
+                            <span class="passkey-name">${escapeHtml(pk.name)}</span>
+                            ${getTypeBadge(pk.type)}
+                            ${pk.isCurrentDevice ? '<span class="badge badge-current">Current Session</span>' : ''}
+                          </div>
+                        `
+                    }
+                    <div style="font-size: 0.86rem; color: var(--text-muted);">
+                      ${escapeHtml(pk.provider)} • <span class="credential-id-pill" title="WebAuthn Credential ID">${escapeHtml(pk.credentialId)}</span>
+                    </div>
+                    <div class="passkey-meta">
+                      <span>
+                        <strong>Added:</strong> ${escapeHtml(formatDate(pk.createdAt))}
+                      </span>
+                      <span>
+                        <strong>Last used:</strong> ${escapeHtml(formatDate(pk.lastUsedAt))}
+                      </span>
+                      ${
+                        pk.lastLocation
+                          ? `<span><strong>Device:</strong> ${escapeHtml(pk.lastLocation)}</span>`
+                          : ''
+                      }
+                    </div>
+                  </div>
+                </div>
+                <div class="passkey-actions">
+                  ${
+                    !isEditing
+                      ? `
+                        <button type="button" class="btn btn-outline btn-sm" data-edit-passkey="${escapeHtml(pk.id)}" aria-label="Rename ${escapeHtml(pk.name)}">
+                          Rename
+                        </button>
+                      `
+                      : ''
+                  }
+                  <button type="button" class="btn btn-danger-outline btn-sm" data-delete-passkey="${escapeHtml(pk.id)}" aria-label="Revoke ${escapeHtml(pk.name)}">
+                    Revoke
+                  </button>
+                </div>
+              </div>
+            `;
+          })
+          .join('');
+      }
+
+      function renderActivityLog() {
+        const listEl = document.getElementById('activity-log-list');
+        if (!listEl) return;
+        listEl.innerHTML = activities
+          .map(
+            item => `
+            <li class="activity-item">
+              <span>${escapeHtml(item.event)}</span>
+              <span class="activity-time">${escapeHtml(item.timestamp)}</span>
+            </li>
+          `
+          )
+          .join('');
+      }
+
+      function showToast(message) {
+        const container = document.getElementById('toast-container');
+        const toast = document.createElement('div');
+        toast.className = 'toast';
+        toast.innerHTML = `
+          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2">
+            <path d="M20 6L9 17l-5-5"/>
+          </svg>
+          <span>${escapeHtml(message)}</span>
+        `;
+        container.appendChild(toast);
+        setTimeout(() => {
+          toast.remove();
+        }, 3600);
+      }
+
+      // Modal Helpers
+      function openModal(id) {
+        const el = document.getElementById(id);
+        if (el) el.classList.add('open');
+      }
+
+      function closeModal(id) {
+        const el = document.getElementById(id);
+        if (el) el.classList.remove('open');
+      }
+
+      function openRegisterModal() {
+        const promptBox = document.getElementById('biometric-prompt-box');
+        const submitBtn = document.getElementById('confirm-register-btn');
+        promptBox.classList.add('hidden');
+        submitBtn.disabled = false;
+        submitBtn.textContent = 'Create Passkey';
+        openModal('register-modal');
+        const nameInput = document.getElementById('new-passkey-name');
+        if (nameInput) nameInput.focus();
+      }
+
+      // Event Delegation for Passkey List Actions
+      document.getElementById('passkeys-list').addEventListener('click', e => {
+        const editBtn = e.target.closest('[data-edit-passkey]');
+        if (editBtn) {
+          editingPasskeyId = editBtn.getAttribute('data-edit-passkey');
+          renderPasskeys();
+          const input = document.querySelector(`[data-rename-form="${editingPasskeyId}"] input[name="newName"]`);
+          if (input) {
+            input.focus();
+            input.select();
+          }
+          return;
+        }
+
+        const cancelBtn = e.target.closest('[data-cancel-rename]');
+        if (cancelBtn) {
+          editingPasskeyId = null;
+          renderPasskeys();
+          return;
+        }
+
+        const deleteBtn = e.target.closest('[data-delete-passkey]');
+        if (deleteBtn) {
+          const id = deleteBtn.getAttribute('data-delete-passkey');
+          const pk = passkeys.find(item => item.id === id);
+          if (!pk) return;
+          pendingDeletePasskeyId = id;
+          document.getElementById('delete-passkey-name-display').textContent = pk.name;
+          openModal('delete-modal');
+        }
+      });
+
+      document.getElementById('passkeys-list').addEventListener('submit', e => {
+        const form = e.target.closest('[data-rename-form]');
+        if (!form) return;
+        e.preventDefault();
+        const id = form.getAttribute('data-rename-form');
+        const input = form.querySelector('input[name="newName"]');
+        const newName = input ? input.value.trim() : '';
+        if (!newName) return;
+
+        const pk = passkeys.find(item => item.id === id);
+        if (pk) {
+          const oldName = pk.name;
+          pk.name = newName;
+          savePasskeys();
+          addActivity(`Renamed passkey "${oldName}" to "${newName}"`);
+          showToast(`Passkey renamed to "${newName}"`);
+        }
+        editingPasskeyId = null;
+        renderPasskeys();
+      });
+
+      // Confirm Delete
+      document.getElementById('confirm-delete-btn').addEventListener('click', () => {
+        if (!pendingDeletePasskeyId) return;
+        const pk = passkeys.find(item => item.id === pendingDeletePasskeyId);
+        passkeys = passkeys.filter(item => item.id !== pendingDeletePasskeyId);
+        savePasskeys();
+        closeModal('delete-modal');
+        if (pk) {
+          addActivity(`Revoked passkey "${pk.name}"`);
+          showToast(`Revoked passkey "${pk.name}"`);
+        }
+        pendingDeletePasskeyId = null;
+        renderPasskeys();
+      });
+
+      // Authenticator Card Selection
+      document.getElementById('authenticator-options').addEventListener('click', e => {
+        const card = e.target.closest('.auth-option-card');
+        if (!card) return;
+        document.querySelectorAll('.auth-option-card').forEach(c => c.classList.remove('selected'));
+        card.classList.add('selected');
+        selectedAuthType = card.getAttribute('data-auth-type') || 'synced';
+        document.getElementById('new-passkey-name').value = card.getAttribute('data-default-name') || '';
+        document.getElementById('new-passkey-provider').value = card.getAttribute('data-provider') || '';
+      });
+
+      // Register Passkey Form Submission
+      document.getElementById('register-passkey-form').addEventListener('submit', async e => {
+        e.preventDefault();
+        const nameInput = document.getElementById('new-passkey-name');
+        const providerInput = document.getElementById('new-passkey-provider');
+        const promptBox = document.getElementById('biometric-prompt-box');
+        const submitBtn = document.getElementById('confirm-register-btn');
+
+        const name = nameInput.value.trim();
+        const provider = providerInput.value.trim() || 'WebAuthn Passkey Authenticator';
+        if (!name) return;
+
+        promptBox.classList.remove('hidden');
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Verifying...';
+
+        // Brief realistic WebAuthn handshake simulation
+        await new Promise(resolve => setTimeout(resolve, 550));
+
+        const randomHex = () => Math.floor((1 + Math.random()) * 0x10000).toString(16).substring(1);
+        const newPasskey = {
+          id: 'pk_' + Date.now(),
+          credentialId: `cred_${randomHex()}...${randomHex()}`,
+          name,
+          type: selectedAuthType,
+          provider,
+          createdAt: new Date().toISOString(),
+          lastUsedAt: 'Just now',
+          lastLocation: 'Current Browser Session',
+          isCurrentDevice: true
+        };
+
+        passkeys.forEach(p => {
+          p.isCurrentDevice = false;
+        });
+        passkeys.unshift(newPasskey);
+        savePasskeys();
+        addActivity(`Registered new passkey "${name}"`);
+        closeModal('register-modal');
+        renderPasskeys();
+        showToast(`Passkey "${name}" registered to your account`);
+      });
+
+      // Verify / Test Passkey Button
+      document.getElementById('test-passkey-btn').addEventListener('click', () => {
+        if (passkeys.length === 0) {
+          showToast('Register a passkey first to test verification');
+          return;
+        }
+        const activePk = passkeys.find(p => p.isCurrentDevice) || passkeys[0];
+        activePk.lastUsedAt = 'Just now';
+        savePasskeys();
+        renderPasskeys();
+        addActivity(`Verified passkey "${activePk.name}" via WebAuthn assertion`);
+        showToast(`Verified "${activePk.name}" successfully!`);
+      });
+
+      // Open & Close Modals
+      document.getElementById('add-passkey-btn').addEventListener('click', openRegisterModal);
+
+      document.querySelectorAll('[data-close-modal]').forEach(btn => {
+        btn.addEventListener('click', () => {
+          closeModal(btn.getAttribute('data-close-modal'));
+        });
+      });
+
+      document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
+        backdrop.addEventListener('click', e => {
+          if (e.target === backdrop) {
+            backdrop.classList.remove('open');
+          }
+        });
+      });
+
+      // Search & Filter Listeners
+      document.getElementById('passkey-search').addEventListener('input', renderPasskeys);
+      document.getElementById('passkey-filter-type').addEventListener('change', renderPasskeys);
+
+      // Sidebar Tab Switching
+      document.querySelectorAll('.sidebar-nav button[data-tab]').forEach(btn => {
+        btn.addEventListener('click', () => {
+          const targetTab = btn.getAttribute('data-tab');
+          document.querySelectorAll('.sidebar-nav button[data-tab]').forEach(b => {
+            b.classList.toggle('active', b === btn);
+            b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
+          });
+          document.querySelectorAll('.tab-section').forEach(sec => {
+            sec.classList.toggle('hidden', sec.id !== `tab-${targetTab}`);
+          });
+        });
+      });
+
+      // Profile Form
+      document.getElementById('profile-form').addEventListener('submit', e => {
+        e.preventDefault();
+        const newName = document.getElementById('profile-name').value.trim();
+        const newEmail = document.getElementById('profile-email').value.trim();
+        if (newName) {
+          document.querySelector('.user-meta h1').textContent = newName;
+        }
+        if (newEmail) {
+          document.querySelector('.user-meta p span:first-child').textContent = newEmail;
+        }
+        showToast('Account profile updated');
+      });
+
+      // Preferences toggles toast
+      document.getElementById('pref-autofill').addEventListener('change', e => {
+        showToast(e.target.checked ? 'Passkey autofill enabled' : 'Passkey autofill disabled');
+      });
+      document.getElementById('pref-rewards-biometric').addEventListener('change', e => {
+        showToast(
+          e.target.checked
+            ? 'Biometric check enabled for reward redemptions'
+            : 'Biometric check disabled for reward redemptions'
+        );
+      });
+
+      // Initial render
+      renderPasskeys();
+      renderActivityLog();
+    })();
+  </script>
+</body>
+
+</html>
