@@ -0,0 +1,52 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import type { AuthenticatorTransport } from '@simplewebauthn/server';
+import { db, getRpId, RP_NAME } from '../../../utils/passkey-db';
+
+export const POST: APIRoute = async ({ request, url, session }) => {
+  const user = db.getUser();
+  const existingCredentials = db.findCredentialsByUserId(user.id);
+  const rpID = getRpId(url.hostname);
+
+  let isPromotionFlow = false;
+  try {
+    const body = await request.json();
+    isPromotionFlow = Boolean(body?.promotion);
+  } catch {
+    // Default to management flow (promotion = false)
+  }
+
+  // Decode the Base64URL user.id into Uint8Array so SimpleWebAuthn re-encodes it to the exact same Base64URL string
+  const userIDBytes = new Uint8Array(Buffer.from(user.id, 'base64url'));
+
+  // Note: For the Management Flow, we omit authenticatorAttachment on authenticatorSelection
+  // so users can register either a platform passkey or an external security key.
+  const options = await generateRegistrationOptions({
+    rpName: RP_NAME,
+    rpID,
+    userID: userIDBytes,
+    userName: user.name,
+    userDisplayName: user.displayName,
+    attestationType: 'none',
+    excludeCredentials: existingCredentials.map((cred) => ({
+      id: cred.id,
+      transports: cred.transports as AuthenticatorTransport[],
+    })),
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'preferred',
+      ...(isPromotionFlow ? { authenticatorAttachment: 'platform' } : {}),
+    },
+  });
+
+  db.setChallenge(options.challenge);
+  if (session) {
+    await session.set('passkeyChallenge', options.challenge);
+  }
+
+  return new Response(JSON.stringify(options), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
diff --git a/src/pages/api/passkeys/register-verify.ts b/src/pages/api/passkeys/register-verify.ts
new file mode 100644
index 0000000..fbf3159
--- /dev/null
+++ b/src/pages/api/passkeys/register-verify.ts
@@ -0,0 +1,88 @@
+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import type { RegistrationResponseJSON } from '@simplewebauthn/server';
+import { db, getRpId, resolveAaguidMetadata, type StoredPasskeyCredential } from '../../../utils/passkey-db';
+
+export const POST: APIRoute = async ({ request, url, session }) => {
+  const user = db.getUser();
+  const rpID = getRpId(url.hostname);
+  const expectedOrigin = url.origin;
+
+  let sessionChallenge: string | undefined;
+  if (session) {
+    sessionChallenge = await session.get('passkeyChallenge');
+  }
+  const expectedChallenge = sessionChallenge || db.getChallenge();
+
+  if (!expectedChallenge) {
+    return new Response(JSON.stringify({ error: 'No active registration challenge found.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  try {
+    const body = (await request.json()) as RegistrationResponseJSON;
+
+    // Since options specified userVerification: 'preferred', we MUST configure
+    // requireUserVerification: false so authenticators registering without UV do not fail.
+    const verification = await verifyRegistrationResponse({
+      response: body,
+      expectedChallenge,
+      expectedOrigin,
+      expectedRPID: rpID,
+      requireUserPresence: true,
+      requireUserVerification: false,
+    });
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(JSON.stringify({ error: 'Passkey verification failed.' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const { registrationInfo } = verification;
+    const {
+      aaguid,
+      credential,
+      credentialType,
+      credentialDeviceType,
+      credentialBackedUp,
+    } = registrationInfo;
+
+    const userAgent = request.headers.get('user-agent') || undefined;
+    const providerMeta = resolveAaguidMetadata(aaguid, userAgent);
+
+    const newCredential: StoredPasskeyCredential = {
+      id: credential.id,
+      passkeyUserId: user.id,
+      credentialPublicKey: Buffer.from(credential.publicKey).toString('base64url'),
+      credentialType,
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+      providerIcon: providerMeta.providerIcon,
+      name: providerMeta.name,
+      transports: credential.transports || body.response.transports || ['internal', 'hybrid'],
+      registeredAt: Date.now(),
+      lastUsedAt: undefined,
+      counter: credential.counter,
+    };
+
+    const saved = db.saveCredential(newCredential);
+
+    return new Response(JSON.stringify({ verified: true, credential: saved }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Verification error occurred.' }),
+      {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
