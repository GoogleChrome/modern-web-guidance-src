diff --git a/src/utils/passkey-db.ts b/src/utils/passkey-db.ts
new file mode 100644
index 0000000..3230dc2
--- /dev/null
+++ b/src/utils/passkey-db.ts
@@ -0,0 +1,196 @@
+import aaguidsData from '../data/aaguids.json';
+
+export interface StoredPasskeyCredential {
+  id: string; // Base64URL-encoded credential ID (unique lookup key)
+  passkeyUserId: string; // Associated application user ID (Base64URL-encoded)
+  credentialPublicKey: string; // Base64URL-encoded public key used to verify assertion signatures
+  credentialType: "public-key";
+  credentialDeviceType: "singleDevice" | "multiDevice"; // Helps distinguish device-bound vs cloud-synced passkeys
+  credentialBackedUp: boolean; // Boolean backup state reported by the authenticator
+  aaguid: string; // Authenticator Attestation GUID
+  providerIcon?: string; // Provider icon derived from the AAGUID registry (dark or light theme URLs)
+  name: string; // Provider name derived from AAGUID registry or user custom nickname
+  transports: string[]; // Array of transport names (e.g. 'internal', 'hybrid') necessary for exclusion options
+  lastUsedAt?: number; // Optional epoch timestamp of last sign-in
+  registeredAt: number; // Registration epoch timestamp
+  counter: number; // Authenticator sign-in signature counter used to prevent replay attacks
+}
+
+export interface UserAccount {
+  id: string; // Base64URL-encoded user ID
+  name: string; // Username / email
+  displayName: string; // Full display name
+}
+
+export interface AaguidEntry {
+  name: string;
+  icon_light?: string;
+  icon_dark?: string;
+}
+
+const aaguids: Record<string, AaguidEntry> = aaguidsData as Record<string, AaguidEntry>;
+
+export const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+export function resolveAaguidMetadata(aaguid: string, userAgent?: string): { name: string; providerIcon?: string } {
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    let fallbackName = 'Unknown passkey provider';
+    if (userAgent) {
+      if (/Macintosh|Mac OS X/i.test(userAgent)) fallbackName = 'macOS Passkey';
+      else if (/Windows/i.test(userAgent)) fallbackName = 'Windows Device Passkey';
+      else if (/Android/i.test(userAgent)) fallbackName = 'Android Device Passkey';
+      else if (/iPhone|iPad|iPod/i.test(userAgent)) fallbackName = 'iOS Device Passkey';
+      else if (/Linux/i.test(userAgent)) fallbackName = 'Linux Device Passkey';
+    }
+    return {
+      name: fallbackName,
+      providerIcon: undefined,
+    };
+  }
+
+  const provider = aaguids[aaguid];
+  return {
+    name: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
+
+export function getRpId(hostname: string): string {
+  if (!hostname || hostname === '127.0.0.1' || hostname === '::1') {
+    return 'localhost';
+  }
+  return hostname;
+}
+
+export const RP_NAME = 'The DevTools Times';
+
+// Default signed-in user (ID is Base64URL-encoded from 'user-alex-rivera-01')
+const DEFAULT_USER_ID = Buffer.from('user-alex-rivera-01', 'utf8').toString('base64url');
+
+const DEFAULT_USER: UserAccount = {
+  id: DEFAULT_USER_ID,
+  name: 'alex.rivera@devtoolstimes.com',
+  displayName: 'Alex Rivera',
+};
+
+const now = Date.now();
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+const INITIAL_CREDENTIALS: StoredPasskeyCredential[] = [
+  {
+    id: 'Y3JlZC1nb29nbGUtcGFzc3dvcmQtbWFuYWdlci0wMQ',
+    passkeyUserId: DEFAULT_USER_ID,
