diff --git a/src/components/PasskeyManagement.tsx b/src/components/PasskeyManagement.tsx
new file mode 100644
index 0000000..64809dc
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,802 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import 'webauthn-polyfills';
+import aaguidsData from '../data/aaguids.json';
+import type { StoredPasskeyCredential, UserAccount, AaguidEntry } from '../utils/passkey-db';
+
+const aaguids = aaguidsData as Record<string, AaguidEntry>;
+const ZERO_AAGUID = '00000000-0000-0000-0000-000000000000';
+
+// Extend PublicKeyCredential type for Signal API & WebAuthn JSON methods
+declare global {
+  interface PublicKeyCredentialConstructor {
+    getClientCapabilities?: () => Promise<Record<string, boolean>>;
+    parseCreationOptionsFromJSON?: (options: any) => PublicKeyCredentialCreationOptions;
+    parseRequestOptionsFromJSON?: (options: any) => PublicKeyCredentialRequestOptions;
+    signalAllAcceptedCredentials?: (options: {
+      rpId: string;
+      userId: string;
+      allAcceptedCredentialIds: string[];
+    }) => Promise<void>;
+    signalCurrentUserDetails?: (options: {
+      rpId: string;
+      userId: string;
+      name: string;
+      displayName: string;
+    }) => Promise<void>;
+    signalUnknownCredential?: (options: {
+      rpId: string;
+      credentialId: string;
+    }) => Promise<void>;
+  }
+}
+
+function getClientRpId(): string {
+  if (typeof window === 'undefined') return 'localhost';
+  const host = window.location.hostname;
+  if (!host || host === '127.0.0.1' || host === '::1') {
+    return 'localhost';
+  }
+  return host;
+}
+
+function lookupAaguid(aaguid: string): { providerName: string; providerIcon?: string } {
+  if (!aaguid || aaguid === ZERO_AAGUID) {
+    return {
+      providerName: 'Unknown passkey provider',
+      providerIcon: undefined,
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
+    providerName: provider?.name || 'Unknown passkey provider',
+    providerIcon: provider?.icon_light,
+  };
+}
+
+function formatEpochDate(epochMs?: number): string {
+  if (!epochMs) return 'Never used';
+  return new Date(epochMs).toLocaleDateString('en-US', {
+    year: 'numeric',
+    month: 'short',
+    day: 'numeric',
+    hour: '2-digit',
+    minute: '2-digit',
+  });
+}
+
+interface PasskeyManagementProps {
+  initialUser?: UserAccount;
+  initialCredentials?: StoredPasskeyCredential[];
+}
+
+export default function PasskeyManagement({
+  initialUser,
+  initialCredentials,
+}: PasskeyManagementProps) {
+  const baseUrl = import.meta.env.BASE_URL || '/';
+
+  const [user, setUser] = useState<UserAccount>(
+    initialUser || {
+      id: 'dXNlci1hbGV4LXJpdmVyYS0wMQ',
+      name: 'alex.rivera@devtoolstimes.com',
+      displayName: 'Alex Rivera',
+    }
+  );
+  const [userNameInput, setUserNameInput] = useState(user.name);
+  const [displayNameInput, setDisplayNameInput] = useState(user.displayName);
+
+  const [credentials, setCredentials] = useState<StoredPasskeyCredential[]>(
+    initialCredentials || []
+  );
+  const [loadingList, setLoadingList] = useState(!initialCredentials);
+
+  // Capability detection state for conditional "Create passkey" button
+  const [passkeysSupported, setPasskeysSupported] = useState<boolean>(true);
+  const [capabilitiesChecked, setCapabilitiesChecked] = useState<boolean>(false);
+
+  // Rename state per credential ID
+  const [editingId, setEditingId] = useState<string | null>(null);
+  const [editingName, setEditingName] = useState<string>('');
+  const [savingId, setSavingId] = useState<string | null>(null);
+  const [deletingId, setDeletingId] = useState<string | null>(null);
+
+  // Status feedback banners
+  const [statusMessage, setStatusMessage] = useState<{
+    type: 'success' | 'error' | 'info';
+    text: string;
+  } | null>(null);
+  const [isCreatingPasskey, setIsCreatingPasskey] = useState(false);
+  const [isSavingUser, setIsSavingUser] = useState(false);
+
+  const syncAcceptedCredentials = useCallback(
+    async (currentCredentialsList: StoredPasskeyCredential[], currentUserId?: string) => {
+      const PubKeyCred =
+        typeof window !== 'undefined'
+          ? (window.PublicKeyCredential as unknown as PublicKeyCredentialConstructor)
+          : undefined;
+      if (!PubKeyCred || !PubKeyCred.signalAllAcceptedCredentials) return;
+
+      try {
+        const rpId = getClientRpId();
+        const credentialIds = currentCredentialsList.map((c) => c.id);
+        await PubKeyCred.signalAllAcceptedCredentials({
+          rpId,
+          userId: currentUserId || user.id,
+          allAcceptedCredentialIds: credentialIds,
+        });
+      } catch (e) {
+        console.error('SignalAllAcceptedCredentials sync failure:', e);
+      }
+    },
+    [user.id]
+  );
+
+  const fetchCredentialsAndUser = useCallback(async () => {
+    try {
+      const [credRes, userRes] = await Promise.all([
+        fetch(`${baseUrl}api/credentials`),
+        fetch(`${baseUrl}api/user`),
+      ]);
+
+      let activeUserId = user.id;
+      if (userRes.ok) {
+        const userData: UserAccount = await userRes.json();
+        setUser(userData);
+        setUserNameInput(userData.name);
+        setDisplayNameInput(userData.displayName);
+        activeUserId = userData.id;
+      }
+
+      if (credRes.ok) {
+        const list: StoredPasskeyCredential[] = await credRes.json();
+        setCredentials(list);
+        await syncAcceptedCredentials(list, activeUserId);
+      }
+    } catch (err) {
+      console.error('Failed to load passkey management data:', err);
+    } finally {
+      setLoadingList(false);
+    }
+  }, [baseUrl, syncAcceptedCredentials, user.id]);
+
+  // Initial load: check client capabilities & load/sync credentials
+  useEffect(() => {
+    async function checkCapabilities() {
+      const PubKeyCred =
+        typeof window !== 'undefined'
+          ? (window.PublicKeyCredential as unknown as PublicKeyCredentialConstructor)
+          : undefined;
+
+      if (!PubKeyCred || !PubKeyCred.getClientCapabilities) {
+        setPasskeysSupported(false);
+        setCapabilitiesChecked(true);
+        return;
+      }
+
+      try {
+        const capabilities = await PubKeyCred.getClientCapabilities();
+        const isSupported = Boolean(
+          capabilities.passkeyPlatformAuthenticator && capabilities.conditionalGet
+        );
+        setPasskeysSupported(isSupported);
+      } catch {
+        setPasskeysSupported(false);
+      } finally {
+        setCapabilitiesChecked(true);
+      }
+    }
+
+    checkCapabilities();
+    fetchCredentialsAndUser();
+  }, [fetchCredentialsAndUser]);
+
+  // Create a new passkey (Management Flow: omits authenticatorAttachment on the server)
+  const handleCreatePasskey = async () => {
+    setStatusMessage(null);
+    const PubKeyCred = window.PublicKeyCredential as unknown as PublicKeyCredentialConstructor;
+
+    if (PubKeyCred?.getClientCapabilities) {
+      const capabilities = await PubKeyCred.getClientCapabilities();
+      if (!capabilities.passkeyPlatformAuthenticator || !capabilities.conditionalGet) {
+        setPasskeysSupported(false);
+        return;
+      }
+    }
+
+    setIsCreatingPasskey(true);
+    const rpId = getClientRpId();
+
+    let creationOptionsJSON: any;
+    try {
+      const optionsRes = await fetch(`${baseUrl}api/passkeys/register-options`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ promotion: false }),
+      });
+      if (!optionsRes.ok) {
+        setStatusMessage({
+          type: 'error',
+          text: 'Could not generate passkey registration options.',
+        });
+        setIsCreatingPasskey(false);
+        return;
+      }
+      creationOptionsJSON = await optionsRes.json();
+    } catch (err) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Network error while requesting passkey registration options.',
+      });
+      setIsCreatingPasskey(false);
+      return;
+    }
+
+    const publicKey = PubKeyCred.parseCreationOptionsFromJSON!(creationOptionsJSON);
+
+    let credential: PublicKeyCredential | null = null;
+    try {
+      credential = (await navigator.credentials.create({
+        publicKey,
+      })) as PublicKeyCredential | null;
+    } catch (err: any) {
+      if (err.name === 'InvalidStateError') {
+        setStatusMessage({
+          type: 'info',
+          text: 'A passkey already exists for this account on your authenticator.',
+        });
+      } else if (err.name === 'SecurityError') {
+        setStatusMessage({
+          type: 'error',
+          text: 'Configuration RP ID or Secure Context error.',
+        });
+      } else if (err.name === 'NotAllowedError') {
+        setStatusMessage({
+          type: 'info',
+          text: 'Passkey creation was cancelled.',
+        });
+      } else if (err.name === 'AbortError') {
+        setStatusMessage({
+          type: 'info',
+          text: 'The passkey creation operation was aborted.',
+        });
+      } else {
+        setStatusMessage({
+          type: 'error',
+          text: `Failed to create passkey: ${err.message || 'Unknown error'}`,
+        });
+      }
+      setIsCreatingPasskey(false);
+      return; // Safe API exit, do not signal unknown for standard WebAuthn cancels
+    }
+
+    if (!credential) {
+      setIsCreatingPasskey(false);
+      return;
+    }
+
+    // Server Verification phase (Segregated Try/Catch for signalUnknownCredential)
+    const encodedResponse = (credential as any).toJSON();
+    try {
+      const response = await fetch(`${baseUrl}api/passkeys/register-verify`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encodedResponse),
+      });
+
+      if (!response.ok) {
+        if (PubKeyCred.signalUnknownCredential) {
+          await PubKeyCred.signalUnknownCredential({
+            rpId,
+            credentialId: encodedResponse.id,
+          });
+        }
+        setStatusMessage({
+          type: 'error',
+          text: 'Server verification failed for the newly created passkey.',
+        });
+      } else {
+        const updatedRes = await fetch(`${baseUrl}api/credentials`);
+        const updatedList: StoredPasskeyCredential[] = await updatedRes.json();
+        setCredentials(updatedList);
+        await syncAcceptedCredentials(updatedList);
+        setStatusMessage({
+          type: 'success',
+          text: 'Passkey registered and synchronized with your account.',
+        });
+      }
+    } catch (serverErr) {
+      console.error('Server verification network failure:', serverErr);
+      if (PubKeyCred.signalUnknownCredential) {
+        try {
+          await PubKeyCred.signalUnknownCredential({
+            rpId,
+            credentialId: encodedResponse.id,
+          });
+        } catch (signalErr) {
+          console.error('SignalUnknownCredential error:', signalErr);
+        }
+      }
+      setStatusMessage({
+        type: 'error',
+        text: 'Network error during passkey verification.',
+      });
+    } finally {
+      setIsCreatingPasskey(false);
+    }
+  };
+
+  // Rename an individual passkey's custom nickname (server-side label update only; does NOT invoke signalCurrentUserDetails)
+  const handleStartRename = (cred: StoredPasskeyCredential) => {
+    setEditingId(cred.id);
+    setEditingName(cred.name);
+    setStatusMessage(null);
+  };
+
+  const handleCancelRename = () => {
+    setEditingId(null);
+    setEditingName('');
+  };
+
+  const handlePerformCredentialRename = async (credentialId: string, newNameOverride?: string) => {
+    const newCredentialName = (newNameOverride ?? editingName).trim();
+    if (!newCredentialName) return;
+
+    setSavingId(credentialId);
+    setStatusMessage(null);
+    try {
+      const response = await fetch(
+        `${baseUrl}api/credential/${encodeURIComponent(credentialId)}`,
+        {
+          method: 'PUT',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ name: newCredentialName }),
+        }
+      );
+
+      if (response.ok) {
+        const updatedResponse = await fetch(`${baseUrl}api/credentials`);
+        const updatedList: StoredPasskeyCredential[] = await updatedResponse.json();
+        setCredentials(updatedList);
+        setEditingId(null);
+        setEditingName('');
+        setStatusMessage({
+          type: 'success',
+          text: `Passkey renamed to "${newCredentialName}".`,
+        });
+      } else {
+        setStatusMessage({
+          type: 'error',
+          text: 'Could not rename passkey.',
+        });
+      }
+    } catch (err) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Network error while renaming passkey.',
+      });
+    } finally {
+      setSavingId(null);
+    }
+  };
+
+  // Delete a passkey and synchronize remaining accepted credential IDs via signalAllAcceptedCredentials()
+  const handlePerformDelete = async (credentialId: string) => {
+    setDeletingId(credentialId);
+    setStatusMessage(null);
+    try {
+      const response = await fetch(
+        `${baseUrl}api/credential/${encodeURIComponent(credentialId)}`,
+        {
+          method: 'DELETE',
+        }
+      );
+
+      if (response.ok) {
+        const updatedResponse = await fetch(`${baseUrl}api/credentials`);
+        const updatedList: StoredPasskeyCredential[] = await updatedResponse.json();
+        setCredentials(updatedList);
+        // Sync remaining accepted credentials immediately post-fetch
+        await syncAcceptedCredentials(updatedList);
+        setStatusMessage({
+          type: 'success',
+          text: 'Passkey removed from your account and synchronized with your password manager.',
+        });
+      } else {
+        setStatusMessage({
+          type: 'error',
+          text: 'Failed to delete passkey.',
+        });
+      }
+    } catch (err) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Network error while deleting passkey.',
+      });
+    } finally {
+      setDeletingId(null);
+    }
+  };
+
+  // Update the user's account username (name) or displayName and invoke signalCurrentUserDetails()
+  const handlePerformUserRename = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const updatedName = userNameInput.trim();
+    const updatedDisplayName = displayNameInput.trim();
+    if (!updatedName || !updatedDisplayName) return;
+
+    setIsSavingUser(true);
+    setStatusMessage(null);
+
+    try {
+      const response = await fetch(`${baseUrl}api/user`, {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          name: updatedName,
+          displayName: updatedDisplayName,
+        }),
+      });
+
+      if (response.ok) {
+        const updatedUser: UserAccount = await response.json();
+        setUser(updatedUser);
+
+        const PubKeyCred =
+          typeof window !== 'undefined'
+            ? (window.PublicKeyCredential as unknown as PublicKeyCredentialConstructor)
+            : undefined;
+
+        if (PubKeyCred && PubKeyCred.signalCurrentUserDetails) {
+          try {
+            await PubKeyCred.signalCurrentUserDetails({
+              rpId: getClientRpId(),
+              userId: updatedUser.id, // Base64URL-encoded user ID
+              name: updatedUser.name,
+              displayName: updatedUser.displayName,
+            });
+          } catch (signalErr) {
+            console.error('SignalCurrentUserDetails sync failure:', signalErr);
+          }
+        }
+
+        setStatusMessage({
+          type: 'success',
+          text: 'Account profile updated and synchronized with your passkey provider.',
+        });
+      } else {
+        setStatusMessage({
+          type: 'error',
+          text: 'Failed to update user profile details.',
+        });
+      }
+    } catch (err) {
+      setStatusMessage({
+        type: 'error',
+        text: 'Network error while updating user profile.',
+      });
+    } finally {
+      setIsSavingUser(false);
+    }
+  };
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
+      {/* Page Header */}
+      <div className="border-b border-gray-300 pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+        <div>
+          <p className="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1">
+            Subscriber Account &amp; Security
+          </p>
+          <h1 className="text-3xl font-bold text-gray-900">Passkeys &amp; Account Security</h1>
+          <p className="mt-1 text-sm text-gray-600">
+            View and manage the passkeys registered to your DevTools Times account.
+          </p>
+        </div>
+
+        {/* Conditional "Create Passkey" Button */}
+        <div>
+          {passkeysSupported ? (
+            <button
+              type="button"
+              onClick={handleCreatePasskey}
+              disabled={isCreatingPasskey}
+              className={`inline-flex items-center gap-2 bg-gray-900 text-white text-sm font-semibold py-2.5 px-4 rounded-md shadow-sm hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition ${
+                isCreatingPasskey ? 'opacity-70 cursor-not-allowed' : ''
+              }`}
+            >
+              <svg
+                className="w-4 h-4 text-amber-400"
+                fill="none"
+                stroke="currentColor"
+                viewBox="0 0 24 24"
+                aria-hidden="true"
+              >
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  strokeWidth={2}
+                  d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                />
+              </svg>
+              {isCreatingPasskey ? 'Creating passkey...' : 'Create passkey'}
+            </button>
+          ) : (
+            capabilitiesChecked && (
+              <div className="p-3 bg-amber-50 border border-amber-200 rounded-md text-xs text-amber-900 max-w-xs">
+                <p className="font-semibold">Passkeys unavailable on this device</p>
+                <p className="mt-0.5 text-amber-800">
+                  Your browser or device does not support platform passkeys. Please use standard
+                  password sign-in and multi-factor authentication (MFA) instead.
+                </p>
+              </div>
+            )
+          )}
+        </div>
+      </div>
+
+      {/* Feedback Banner */}
+      {statusMessage && (
+        <div
+          role="status"
+          aria-live="polite"
+          className={`p-4 rounded-md border text-sm flex items-center justify-between ${
+            statusMessage.type === 'success'
+              ? 'bg-green-50 border-green-200 text-green-800'
+              : statusMessage.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : 'bg-gray-50 border-gray-200 text-gray-800'
+          }`}
+        >
+          <span>{statusMessage.text}</span>
+          <button
+            type="button"
+            onClick={() => setStatusMessage(null)}
+            className="ml-4 text-xs font-semibold underline hover:no-underline"
+          >
+            Dismiss
+          </button>
+        </div>
+      )}
+
+      {/* Registered Passkeys Section */}
+      <section aria-labelledby="passkeys-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
+        <div className="px-6 py-4 border-b border-gray-200 bg-gray-50 flex items-center justify-between">
+          <div>
+            <h2 id="passkeys-heading" className="text-lg font-bold text-gray-900">
+              Registered Passkeys ({credentials.length})
+            </h2>
+            <p className="text-xs text-gray-600 mt-0.5">
+              Passkeys let you sign in securely with Touch ID, Face ID, Windows Hello, or a hardware security key.
+            </p>
+          </div>
+        </div>
+
+        {loadingList ? (
+          <div className="p-8 text-center text-sm text-gray-500">Loading your registered passkeys...</div>
+        ) : credentials.length === 0 ? (
+          <div className="p-10 text-center">
+            <svg
+              className="w-10 h-10 text-gray-400 mx-auto mb-3"
+              fill="none"
+              stroke="currentColor"
+              viewBox="0 0 24 24"
+              aria-hidden="true"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                strokeWidth={1.5}
+                d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+              />
+            </svg>
+            <p className="text-base font-semibold text-gray-800">No passkeys found</p>
+            <p className="text-sm text-gray-500 mt-1 max-w-md mx-auto">
+              You don&apos;t have any passkeys registered to your account yet. Add a passkey for faster, phishing-resistant sign-in.
+            </p>
+          </div>
+        ) : (
+          <ul className="divide-y divide-gray-200" data-testid="passkey-list">
+            {credentials.map((cred) => {
+              const aaguidMeta = lookupAaguid(cred.aaguid);
+              const iconSrc = cred.providerIcon || aaguidMeta.providerIcon;
+              const displayName = cred.name || aaguidMeta.providerName;
+              const isEditing = editingId === cred.id;
+              const isDeleting = deletingId === cred.id;
+              const isSaving = savingId === cred.id;
+
+              return (
+                <li
+                  key={cred.id}
+                  data-testid={`passkey-item-${cred.id}`}
+                  className="p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 hover:bg-gray-50/60 transition"
+                >
+                  <div className="flex items-start gap-4 flex-grow">
+                    {/* Provider Icon */}
+                    <div className="w-11 h-11 rounded-lg border border-gray-200 bg-white flex items-center justify-center flex-shrink-0 p-2 shadow-2xs">
+                      {iconSrc ? (
+                        <img
+                          src={iconSrc}
+                          alt={`${aaguidMeta.providerName} icon`}
+                          className="w-full h-full object-contain"
+                        />
+                      ) : (
+                        <svg
+                          className="w-6 h-6 text-gray-600"
+                          fill="none"
+                          stroke="currentColor"
+                          viewBox="0 0 24 24"
+                          aria-label="Passkey provider icon"
+                        >
+                          <path
+                            strokeLinecap="round"
+                            strokeLinejoin="round"
+                            strokeWidth={2}
+                            d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                          />
+                        </svg>
+                      )}
+                    </div>
+
+                    {/* Provider / Custom Name & Timestamps */}
+                    <div className="flex-grow min-w-0">
+                      {isEditing ? (
+                        <form
+                          onSubmit={(e) => {
+                            e.preventDefault();
+                            handlePerformCredentialRename(cred.id);
+                          }}
+                          className="flex flex-wrap items-center gap-2 mb-1.5"
+                        >
+                          <label htmlFor={`rename-${cred.id}`} className="sr-only">
+                            Passkey nickname
+                          </label>
+                          <input
+                            id={`rename-${cred.id}`}
+                            type="text"
+                            value={editingName}
+                            onChange={(e) => setEditingName(e.target.value)}
+                            className="px-3 py-1.5 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+                            placeholder="Enter passkey name"
+                            autoFocus
+                            required
+                          />
+                          <button
+                            type="submit"
+                            disabled={isSaving}
+                            className="px-3 py-1.5 text-xs font-semibold text-white bg-gray-900 rounded-md hover:bg-gray-800"
+                          >
+                            {isSaving ? 'Saving...' : 'Save'}
+                          </button>
+                          <button
+                            type="button"
+                            onClick={handleCancelRename}
+                            className="px-2.5 py-1.5 text-xs font-medium text-gray-600 hover:text-gray-900"
+                          >
+                            Cancel
+                          </button>
+                        </form>
+                      ) : (
+                        <div className="flex flex-wrap items-center gap-2">
+                          <h3 className="text-base font-bold text-gray-900">{displayName}</h3>
+                          {cred.name !== aaguidMeta.providerName &&
+                            aaguidMeta.providerName !== 'Unknown passkey provider' && (
+                              <span className="text-xs text-gray-500">
+                                ({aaguidMeta.providerName})
+                              </span>
+                            )}
+                          {cred.credentialBackedUp && (
+                            <span className="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
+                              Synced
+                            </span>
+                          )}
+                        </div>
+                      )}
+
+                      <div className="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500">
+                        <span>
+                          <strong className="font-medium text-gray-700">Created:</strong>{' '}
+                          <time dateTime={new Date(cred.registeredAt).toISOString()}>
+                            {formatEpochDate(cred.registeredAt)}
+                          </time>
+                        </span>
+                        <span>
+                          <strong className="font-medium text-gray-700">Last used:</strong>{' '}
+                          {cred.lastUsedAt ? (
+                            <time dateTime={new Date(cred.lastUsedAt).toISOString()}>
+                              {formatEpochDate(cred.lastUsedAt)}
+                            </time>
+                          ) : (
+                            'Never'
+                          )}
+                        </span>
+                      </div>
+                    </div>
+                  </div>
+
+                  {/* Per-Item Actions: Rename & Delete */}
+                  <div className="flex items-center gap-2 self-end sm:self-center flex-shrink-0">
+                    {!isEditing && (
+                      <button
+                        type="button"
+                        onClick={() => handleStartRename(cred)}
+                        className="px-3 py-1.5 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-400 transition"
+                      >
+                        Rename
+                      </button>
+                    )}
+                    <button
+                      type="button"
+                      onClick={() => handlePerformDelete(cred.id)}
+                      disabled={isDeleting}
+                      className="px-3 py-1.5 text-xs font-semibold text-red-700 bg-white border border-red-200 rounded-md hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-400 transition"
+                    >
+                      {isDeleting ? 'Deleting...' : 'Delete'}
+                    </button>
+                  </div>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+      </section>
+
+      {/* User Account Rename UI (synchronizes via PublicKeyCredential.signalCurrentUserDetails) */}
+      <section aria-labelledby="account-profile-heading" className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
+        <div className="px-6 py-4 border-b border-gray-200 bg-gray-50">
+          <h2 id="account-profile-heading" className="text-lg font-bold text-gray-900">
+            Account Profile Details
+          </h2>
+          <p className="text-xs text-gray-600 mt-0.5">
+            Updating your username or display name synchronizes these details with your password manager so your passkey autofill prompts stay accurate.
+          </p>
+        </div>
+
+        <form onSubmit={handlePerformUserRename} className="p-6 space-y-4">
+          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
+            <div>
+              <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">
+                Username / Email
+              </label>
+              <input
+                id="account-username"
+                name="name"
+                type="text"
+                value={userNameInput}
+                onChange={(e) => setUserNameInput(e.target.value)}
+                required
+                className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+              />
+            </div>
+
+            <div>
+              <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+                Display Name
+              </label>
+              <input
+                id="account-display-name"
+                name="displayName"
+                type="text"
+                value={displayNameInput}
+                onChange={(e) => setDisplayNameInput(e.target.value)}
+                required
+                className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+              />
+            </div>
+          </div>
+
+          <div className="flex justify-end">
+            <button
+              type="submit"
+              disabled={isSavingUser}
+              className={`px-4 py-2 text-sm font-semibold text-white bg-gray-900 rounded-md hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition ${
+                isSavingUser ? 'opacity-70 cursor-not-allowed' : ''
+              }`}
+            >
+              {isSavingUser ? 'Updating...' : 'Save Account Details'}
+            </button>
+          </div>
+        </form>
+      </section>
+    </div>
+  );
+}
