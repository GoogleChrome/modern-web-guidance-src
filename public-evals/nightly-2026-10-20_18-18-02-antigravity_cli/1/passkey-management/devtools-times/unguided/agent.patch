+                >
+                  <FingerPrintIcon className="w-4 h-4 mr-1.5" />
+                  {isRegistering ? 'Creating Passkey...' : 'Create Passkey'}
+                </button>
+              </div>
+            </form>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
