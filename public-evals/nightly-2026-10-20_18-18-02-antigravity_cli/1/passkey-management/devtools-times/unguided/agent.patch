+    credentialId: 'dGhlLWRldnRvb2xzLXRpbWVzLXl1YmlrZXktNWMtbmZj',
+    name: 'YubiKey 5C NFC (Backup)',
+    deviceType: 'cross-platform',
+    provider: 'Hardware Security Key',
+    createdAt: '2026-06-19T16:45:00.000Z',
+    lastUsedAt: null,
+    transports: ['usb', 'nfc'],
+    backedUp: false,
+    aaguid: '2fc0579f-8113-47ea-b116-bb5a8db9202a',
+    publicKeyAlgorithm: 'EdDSA (Ed25519)',
+    signCount: 1,
+  },
+];
+
+async function getSessionPasskeys(session: any): Promise<PasskeyRecord[]> {
+  if (!session) return [...DEFAULT_PASSKEYS];
+  let passkeys = await session.get('passkeys');
+  if (passkeys === undefined) {
+    passkeys = [...DEFAULT_PASSKEYS];
+    await session.set('passkeys', passkeys);
+  }
+  return passkeys;
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const passkeys = await getSessionPasskeys(session);
+  return new Response(JSON.stringify({ passkeys }), {
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { action } = body;
+    let passkeys = await getSessionPasskeys(session);
+
+    if (action === 'register') {
+      const {
+        name,
+        credentialId,
+        deviceType = 'platform',
+        provider = 'This Device (WebAuthn)',
+        transports = ['internal'],
+        backedUp = true,
+        aaguid = '00000000-0000-0000-0000-000000000000',
+        publicKeyAlgorithm = 'ES256 (ECDSA w/ SHA-256)',
+      } = body;
+
+      if (!name || !name.trim()) {
+        return new Response(JSON.stringify({ error: 'Passkey name is required.' }), {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        });
+      }
+
+      const newPasskey: PasskeyRecord = {
+        id: `pk_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`,
+        credentialId:
+          credentialId ||
+          btoa(`devtools-times-${Date.now()}-${Math.random().toString(36).substring(2)}`).replace(/=+$/, ''),
+        name: name.trim(),
+        deviceType,
+        provider,
+        createdAt: new Date().toISOString(),
+        lastUsedAt: null,
+        transports,
+        backedUp,
+        aaguid,
+        publicKeyAlgorithm,
+        signCount: 0,
+      };
+
+      passkeys = [newPasskey, ...passkeys];
+      await session?.set('passkeys', passkeys);
+
+      return new Response(JSON.stringify({ passkey: newPasskey, passkeys }), {
+        status: 201,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (action === 'rename') {
+      const { id, name } = body;
+      if (!id || !name || !name.trim()) {
+        return new Response(JSON.stringify({ error: 'Passkey ID and valid name are required.' }), {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        });
+      }
+
+      const index = passkeys.findIndex((pk) => pk.id === id);
+      if (index === -1) {
+        return new Response(JSON.stringify({ error: 'Passkey not found.' }), {
+          status: 404,
+          headers: { 'Content-Type': 'application/json' },
+        });
+      }
+
+      passkeys[index] = {
+        ...passkeys[index],
+        name: name.trim(),
+      };
+      await session?.set('passkeys', passkeys);
+
+      return new Response(JSON.stringify({ passkey: passkeys[index], passkeys }), {
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (action === 'delete') {
+      const { id } = body;
+      if (!id) {
+        return new Response(JSON.stringify({ error: 'Passkey ID is required.' }), {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        });
+      }
+
+      passkeys = passkeys.filter((pk) => pk.id !== id);
+      await session?.set('passkeys', passkeys);
+
+      return new Response(JSON.stringify({ passkeys }), {
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (action === 'use') {
+      const { id, credentialId } = body;
+      const index = passkeys.findIndex(
+        (pk) => (id && pk.id === id) || (credentialId && pk.credentialId === credentialId)
+      );
+
+      if (index !== -1) {
+        passkeys[index] = {
+          ...passkeys[index],
+          lastUsedAt: new Date().toISOString(),
+          signCount: (passkeys[index].signCount || 0) + 1,
+        };
+      } else if (passkeys.length > 0) {
+        passkeys[0] = {
+          ...passkeys[0],
+          lastUsedAt: new Date().toISOString(),
+          signCount: (passkeys[0].signCount || 0) + 1,
+        };
+      }
+
+      await session?.set('passkeys', passkeys);
+
+      return new Response(
+        JSON.stringify({
+          usedPasskey: index !== -1 ? passkeys[index] : passkeys[0] || null,
+          passkeys,
+        }),
+        {
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    if (action === 'reset') {
+      passkeys = [...DEFAULT_PASSKEYS];
+      await session?.set('passkeys', passkeys);
+      return new Response(JSON.stringify({ passkeys }), {
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    return new Response(JSON.stringify({ error: 'Invalid action.' }), {
+      status: 400,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err) {
+    return new Response(JSON.stringify({ error: 'Failed to process passkey request.' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
