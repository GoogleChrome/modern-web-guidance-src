+          gl.uniform3f(uFaceColor, 0.84, 0.75, 0.68);
+        }
+        gl.drawArrays(gl.TRIANGLES, 0, 6);
+
+        return htmlElementMVP;
+      }
+
+      // 5. Render HTML content inside canvas.onpaint and sync element geometry
+      if (supportsHtmlInCanvas) {
+        let initialUploadDone = false;
+
+        canvas.onpaint = (event) => {
+          const hasChanged =
+            !initialUploadDone ||
+            !event ||
+            !event.changedElements ||
+            event.changedElements.length > 0;
+
+          if (hasChanged) {
+            try {
+              if (uploadElementWebGL(gl, canvas, texture, uiElement, textureState)) {
+                initialUploadDone = true;
+              }
+            } catch (err) {
+              console.error('texElementSubImage2D copy failed:', err);
+            }
+          }
+
+          const htmlElementMVP = drawScene();
+
+          // Sync DOM position, hit testing, and accessibility bounds with 3D scene
+          canvas.updateElementGeometry(uiElement, {
+            canvasTransform: computeCanvasTransform(canvas, uiElement, htmlElementMVP),
+          });
+        };
+      }
+
+      // Animation loop calling canvas.requestPaint() when HTML-in-Canvas is supported
+      function renderLoop() {
+        if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          drawScene();
+        }
+        requestAnimationFrame(renderLoop);
+      }
+      requestAnimationFrame(renderLoop);
+    })();
+  </script>
