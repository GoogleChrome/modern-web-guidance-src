+          .multiply(cssToFrontFaceSpace);
+
+        // 4. Use HTML-in-Canvas getElementTransform(element, drawTransform) when supported
+        if (typeof canvas.getElementTransform === 'function') {
+          try {
+            const computedTransform = canvas.getElementTransform(formPanel, drawTransform);
+            if (computedTransform) {
+              formPanel.style.transformOrigin = '0 0';
+              formPanel.style.transform = computedTransform.toString();
+              return;
+            }
+          } catch (e) {
+            // Fall back to direct matrix application if needed
+          }
+        }
+
+        // Direct CSS 3D matrix fallback so the element stays aligned even without experimental flags
+        formPanel.style.transformOrigin = '0 0';
+        formPanel.style.transform = drawTransform.toString();
+      }
+
+      // Spin state and controls
+      let isSpinning = true;
+      let rotationY = -20; // degrees
+      let rotationX = 12;  // degrees
+      let lastTime = performance.now();
+
+      toggleSpinBtn.addEventListener('click', () => {
+        isSpinning = !isSpinning;
+        toggleSpinBtn.textContent = isSpinning ? 'Pause Rotation' : 'Resume Rotation';
+      });
+
+      resetViewBtn.addEventListener('click', () => {
+        rotationY = 0;
+        rotationX = 0;
+      });
+
+      function render(now) {
+        const dt = (now - lastTime) / 1000;
+        lastTime = now;
+
+        if (isSpinning) {
+          // Gentle continuous rotation so the box spins while keeping the form accessible
+          rotationY += dt * 28;
+          rotationX = Math.sin(now * 0.0012) * 12;
+        }
+
+        uploadFormElementToTexture();
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0.11, 0.06, 0.05, 1.0);
+        gl.clearDepth(1.0);
+        gl.enable(gl.DEPTH_TEST);
+        gl.depthFunc(gl.LEQUAL);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+        const aspect = canvas.width / canvas.height;
+        const projectionMatrix = createPerspectiveMatrix((45 * Math.PI) / 180, aspect, 0.1, 100.0);
+
+        const viewMatrix = new DOMMatrix().translate(0, 0, -4.2);
+        const modelMatrix = new DOMMatrix()
+          .rotate(rotationX, rotationY, 0);
+
+        const mvpMatrix = projectionMatrix.multiply(viewMatrix).multiply(modelMatrix);
+
+        gl.useProgram(programInfo.program);
+
+        // Bind position attribute
+        gl.bindBuffer(gl.ARRAY_BUFFER, posBuffer);
+        gl.vertexAttribPointer(programInfo.attribLocations.position, 3, gl.FLOAT, false, 0, 0);
+        gl.enableVertexAttribArray(programInfo.attribLocations.position);
+
+        // Bind texCoord attribute
+        gl.bindBuffer(gl.ARRAY_BUFFER, texCoordBuffer);
+        gl.vertexAttribPointer(programInfo.attribLocations.texCoord, 2, gl.FLOAT, false, 0, 0);
+        gl.enableVertexAttribArray(programInfo.attribLocations.texCoord);
+
+        // Bind normal attribute
+        gl.bindBuffer(gl.ARRAY_BUFFER, normalBuffer);
+        gl.vertexAttribPointer(programInfo.attribLocations.normal, 3, gl.FLOAT, false, 0, 0);
+        gl.enableVertexAttribArray(programInfo.attribLocations.normal);
+
+        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer);
+
+        gl.uniformMatrix4fv(programInfo.uniformLocations.mvpMatrix, false, mvpMatrix.toFloat32Array());
+        gl.uniformMatrix4fv(programInfo.uniformLocations.modelMatrix, false, modelMatrix.toFloat32Array());
+        gl.activeTexture(gl.TEXTURE0);
+        gl.uniform1i(programInfo.uniformLocations.uSampler, 0);
+
+        // Draw Front Face (indices 0..5) with the live HTML Form Texture
+        gl.bindTexture(gl.TEXTURE_2D, formTexture);
+        gl.uniform1f(programInfo.uniformLocations.uIsFormFace, 1.0);
+        gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
+
+        // Draw the remaining 5 faces of the Coffee Box (indices 6..35) with the coffee branding texture
+        gl.bindTexture(gl.TEXTURE_2D, boxSideTexture);
+        gl.uniform1f(programInfo.uniformLocations.uIsFormFace, 0.0);
+        gl.drawElements(gl.TRIANGLES, 30, gl.UNSIGNED_SHORT, 6 * 2);
+
+        // Synchronize the underlying HTML form's 3D projection transform so inputs & buttons remain clickable as it rotates
+        syncHTMLFormTransform(mvpMatrix);
+
+        requestAnimationFrame(render);
+      }
+
+      if (typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      }
+      requestAnimationFrame(render);
+    })();
+  </script>
 </body>
 
 </html>
