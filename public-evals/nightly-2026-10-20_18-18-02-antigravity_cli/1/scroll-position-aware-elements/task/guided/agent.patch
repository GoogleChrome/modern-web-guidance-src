+
+    /* When the container can be scrolled toward the top, it means the user has scrolled down */
+    @container scroll-state(scrollable: top) {
+      .back-to-top {
+        visibility: visible;
+        opacity: 1;
+        translate: 0 0;
+      }
+    }
+
+    /* Fallback state toggled via IntersectionObserver when container-type: scroll-state is unsupported */
+    .scrolled .back-to-top {
