+  <script>
+    const emailInput = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('email-error');
+    const mailingForm = document.getElementById('mailing-list-form');
+
+    function validateEmailField() {
+      if (!emailInput.classList.contains('touched')) return;
+
+      if (emailInput.validity.valueMissing) {
+        emailError.textContent = 'Please enter your email address.';
+        emailError.classList.add('visible');
+        emailInput.setAttribute('aria-invalid', 'true');
+      } else if (!emailInput.validity.valid) {
+        emailError.textContent = 'Please enter a valid email address.';
+        emailError.classList.add('visible');
+        emailInput.setAttribute('aria-invalid', 'true');
+      } else {
+        emailError.classList.remove('visible');
+        emailInput.removeAttribute('aria-invalid');
+      }
+    }
+
+    emailInput.addEventListener('blur', () => {
+      emailInput.classList.add('touched');
+      validateEmailField();
+    });
+
+    emailInput.addEventListener('input', () => {
+      if (emailInput.classList.contains('touched')) {
+        validateEmailField();
+      }
+    });
+
+    mailingForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      emailInput.classList.add('touched');
+      validateEmailField();
+
+      if (emailInput.validity.valid) {
+        emailInput.value = '';
+        emailInput.classList.remove('touched');
+        emailError.classList.remove('visible');
+        alert('Thanks for subscribing to our mailing list!');
+      }
+    });
+  </script>
+
 </body>
 
 </html>
