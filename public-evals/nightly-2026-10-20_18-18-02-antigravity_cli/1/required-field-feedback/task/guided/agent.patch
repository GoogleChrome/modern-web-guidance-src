+  <script>
+    const form = document.getElementById('mailing-list-form');
+    const emailInput = document.getElementById('mailing-email');
+
+    const syncAriaInvalid = (input) => {
+      if (input.matches(':user-invalid') || !input.checkValidity()) {
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+
+    // Sync on blur after the user interacts with the field
+    form.addEventListener('blur', (e) => {
+      if (e.target === emailInput && e.target.matches(':user-invalid')) {
+        syncAriaInvalid(e.target);
+      }
+    }, true);
+
+    // Clear error state immediately upon valid correction
+    form.addEventListener('input', (e) => {
+      if (e.target === emailInput && e.target.checkValidity()) {
+        e.target.removeAttribute('aria-invalid');
+      }
+    });
+
+    // Sync ARIA state when submission is attempted
+    emailInput.addEventListener('invalid', () => {
+      emailInput.setAttribute('aria-invalid', 'true');
+    });
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      syncAriaInvalid(emailInput);
+      if (form.checkValidity()) {
+        const submitBtn = form.querySelector('button[type="submit"]');
+        submitBtn.disabled = true;
+        submitBtn.textContent = 'Subscribed!';
+      }
+    });
+  </script>
+
 </body>
 
