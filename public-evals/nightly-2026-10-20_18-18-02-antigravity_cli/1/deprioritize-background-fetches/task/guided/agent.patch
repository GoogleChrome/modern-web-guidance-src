diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,31 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Minimal Fetch Demo</title>
+</head>
+<body>
+  <button id="load-btn" type="button">Load Data</button>
+
+  <script type="module">
+    const loadBtn = document.getElementById('load-btn');
+
+    loadBtn.addEventListener('click', async () => {
+      // Use high priority (default) for critical UI updates
+      const criticalDataPromise = fetch('/api/data');
+
+      // Explicitly deprioritize background analytics to prevent network contention
+      const analyticsPromise = fetch('/api/analytics', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ click: 1 }),
+        priority: 'low',
+      });
+
+      const response = await criticalDataPromise;
+      await analyticsPromise;
+    });
+  </script>
+</body>
+</html>
