+        createPolicy: (name, rules) => rules,
+      };
+    }
+
+    const htmlPolicy = window.trustedTypes.createPolicy('app-html', {
+      createHTML(input) {
+        return String(input)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#39;');
+      },
+    });
