diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,10 +11,90 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --scrollbar-track: #e0d6d2;
+      --scrollbar-thumb: #4e342e;
+      --scrollbar-thumb-hover: #271815;
+      --scrollbar-border: #fafafa;
+      --scrollbar-width: 16px;
     }
 
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-track: #ffffff;
+        --scrollbar-thumb: #000000;
+        --scrollbar-thumb-hover: #333333;
+        --scrollbar-border: #000000;
+        --scrollbar-width: 18px;
+      }
+    }
+
+    /* Custom Scrollbars for High Visibility & Accessibility */
+    html {
+      scrollbar-width: auto;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+    }
+
+    ::-webkit-scrollbar {
+      width: var(--scrollbar-width);
+      height: var(--scrollbar-width);
+    }
+
+    ::-webkit-scrollbar-track {
+      background: var(--scrollbar-track);
+      border-left: 1px solid rgba(62, 39, 35, 0.25);
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background-color: var(--scrollbar-thumb);
+      border-radius: 8px;
+      border: 3px solid var(--scrollbar-border);
+      min-height: 40px;
+    }
+
+    ::-webkit-scrollbar-thumb:hover {
+      background-color: var(--scrollbar-thumb-hover);
+    }
+
+    ::-webkit-scrollbar-thumb:active {
+      background-color: var(--accent);
+      border-color: var(--primary);
+    }
+
+    @media (prefers-contrast: more) {
+      ::-webkit-scrollbar-track {
+        border-left: 2px solid #000000;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        border-radius: 0;
+        border: 2px solid #ffffff;
+        outline: 1px solid #000000;
+      }
+    }
+
+    @media (forced-colors: active) {
+      html {
+        scrollbar-color: ButtonText Canvas;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: Canvas;
+        border-left: 1px solid ButtonText;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background-color: ButtonText;
+        border: 2px solid Canvas;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background-color: Highlight;
+      }
+    }
+
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
