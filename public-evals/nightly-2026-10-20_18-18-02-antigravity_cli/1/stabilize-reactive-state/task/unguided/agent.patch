+  <script>
+    (function () {
+      // Ensure Temporal API is available across environments with an immutable PlainDate implementation
+      if (typeof globalThis.Temporal === 'undefined') {
+        const pad2 = (n) => String(n).padStart(2, '0');
+        const pad4 = (n) => String(n).padStart(4, '0');
+
+        class PlainDate {
+          constructor(isoYear, isoMonth, isoDay) {
+            const d = new Date(Date.UTC(Number(isoYear), Number(isoMonth) - 1, Number(isoDay)));
+            this.year = d.getUTCFullYear();
+            this.month = d.getUTCMonth() + 1;
+            this.day = d.getUTCDate();
+            Object.freeze(this);
+          }
+
+          static from(item) {
+            if (item instanceof PlainDate) {
+              return new PlainDate(item.year, item.month, item.day);
+            }
+            if (typeof item === 'string') {
+              const match = /^(\d{4})-(\d{2})-(\d{2})/.exec(item.trim());
+              if (!match) {
+                throw new RangeError('Invalid ISO date string: ' + item);
+              }
+              return new PlainDate(Number(match[1]), Number(match[2]), Number(match[3]));
+            }
+            if (item && typeof item === 'object') {
+              return new PlainDate(item.year, item.month, item.day);
+            }
+            throw new TypeError('Invalid Temporal.PlainDate input');
+          }
+
+          add(durationLike = {}) {
+            const years = Number(durationLike.years || 0);
+            const months = Number(durationLike.months || 0);
+            const weeks = Number(durationLike.weeks || 0);
+            const days = Number(durationLike.days || 0) + weeks * 7;
+            const d = new Date(Date.UTC(this.year + years, this.month - 1 + months, this.day + days));
+            return new PlainDate(d.getUTCFullYear(), d.getUTCMonth() + 1, d.getUTCDate());
+          }
+
+          subtract(durationLike = {}) {
+            return this.add({
+              years: -(durationLike.years || 0),
+              months: -(durationLike.months || 0),
+              weeks: -(durationLike.weeks || 0),
+              days: -(durationLike.days || 0)
+            });
+          }
+
+          with(fields = {}) {
+            return new PlainDate(
+              fields.year !== undefined ? fields.year : this.year,
+              fields.month !== undefined ? fields.month : this.month,
+              fields.day !== undefined ? fields.day : this.day
+            );
+          }
+
+          equals(other) {
+            const o = PlainDate.from(other);
+            return this.year === o.year && this.month === o.month && this.day === o.day;
+          }
+
+          toString() {
+            return `${pad4(this.year)}-${pad2(this.month)}-${pad2(this.day)}`;
+          }
+
+          toJSON() {
+            return this.toString();
+          }
+        }
+
+        globalThis.Temporal = {
+          PlainDate,
+          Now: {
+            plainDateISO() {
+              const now = new Date();
+              return new PlainDate(now.getFullYear(), now.getMonth() + 1, now.getDate());
+            }
+          }
+        };
+      }
+
+      const valueEl = document.getElementById('temporal-value');
+      const refChangedEl = document.getElementById('temporal-ref-changed');
+      const renderCountEl = document.getElementById('temporal-render-count');
+      const extendBtn = document.getElementById('extend-temporal-btn');
+
+      // Reactive state store relying on immutable reference inequality
+      let state = Object.freeze({
+        deadline: Temporal.PlainDate.from('2026-11-15'),
+        renderCount: 1,
+        refChanged: 'Yes'
+      });
+
+      function render(currentState) {
+        valueEl.textContent = currentState.deadline.toString();
+        refChangedEl.textContent = currentState.refChanged;
+        renderCountEl.textContent = String(currentState.renderCount);
+      }
+
+      function setDeadline(nextDeadline) {
+        const prevDeadline = state.deadline;
+        const didRefChange = !Object.is(prevDeadline, nextDeadline);
+
+        if (didRefChange) {
+          state = Object.freeze({
+            ...state,
+            deadline: nextDeadline,
+            refChanged: 'Yes',
+            renderCount: state.renderCount + 1
+          });
+          render(state);
+        } else {
+          refChangedEl.textContent = 'No';
+        }
+      }
+
+      render(state);
+
+      extendBtn.addEventListener('click', () => {
+        // Temporal.PlainDate.prototype.add returns a new immutable instance without mutating in place
+        const updatedDeadline = state.deadline.add({ days: 1 });
+        setDeadline(updatedDeadline);
+      });
+    })();
+  </script>
