+  <script type="module">
+    if (typeof Temporal === "undefined") {
+      try {
+        const module = await import("https://esm.sh/@js-temporal/polyfill");
+        globalThis.Temporal = module.Temporal;
+      } catch (e) {
+        console.error("Failed to load Temporal polyfill:", e);
+      }
+    }
+
+    const temporalValueEl = document.getElementById("temporal-value");
+    const temporalRefChangedEl = document.getElementById("temporal-ref-changed");
+    const temporalRenderCountEl = document.getElementById("temporal-render-count");
+    const extendTemporalBtn = document.getElementById("extend-temporal-btn");
+
+    let temporalState = {
+      deadline: Temporal.Now.plainDateTimeISO()
+    };
+    let renderCount = 1;
+
+    temporalValueEl.textContent = temporalState.deadline.toString();
+    temporalRefChangedEl.textContent = "No";
+    temporalRenderCountEl.textContent = String(renderCount);
+
+    function updateState(nextState, prevDeadline) {
+      const refChanged = nextState.deadline !== prevDeadline;
+      temporalRefChangedEl.textContent = refChanged ? "Yes" : "No";
+
+      if (refChanged) {
+        renderCount += 1;
+        temporalValueEl.textContent = nextState.deadline.toString();
+        temporalRenderCountEl.textContent = String(renderCount);
+      }
+    }
+
+    function extendDeadline() {
+      const prevDeadline = temporalState.deadline;
+      // Returns a new object with a new reference without mutating state in place
+      const newDeadline = temporalState.deadline.add({ hours: 1 });
+
+      // Create a new state object with the new Temporal reference
+      temporalState = { deadline: newDeadline };
+
+      updateState(temporalState, prevDeadline);
+    }
+
+    extendTemporalBtn.addEventListener("click", extendDeadline);
+  </script>
