+import type { APIRoute } from 'astro';
+import { getUserById, verifyUserPassword } from '../../../utils/auth-store';
+import { REAUTH_WINDOW_MS } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const userId = (await session?.get('userId')) as string | undefined;
+  if (!userId) {
+    return new Response(
+      JSON.stringify({ error: 'Not authenticated.' }),
+      { status: 401, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  const user = getUserById(userId);
+  if (!user) {
+    return new Response(
+      JSON.stringify({ error: 'User not found.' }),
+      { status: 404, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  try {
+    const body = await request.json();
+    const { password } = body;
+
+    if (!password) {
+      return new Response(
+        JSON.stringify({ error: 'Password is required for password reauthentication.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (!verifyUserPassword(user, password)) {
+      return new Response(
+        JSON.stringify({ error: 'Incorrect password.' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const now = Date.now();
+    await session?.set('reauthenticatedAt', now);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        reauthenticatedAt: now,
+        expiresAt: now + REAUTH_WINDOW_MS,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Reauthentication failed.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
