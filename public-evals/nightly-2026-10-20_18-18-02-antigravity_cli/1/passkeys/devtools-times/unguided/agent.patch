+      <ReauthModal
+        isOpen={reauthModalOpen}
+        user={user}
+        actionDescription={reauthActionDesc}
+        onSuccess={(newReauth) => {
+          setReauth(newReauth);
+          setReauthModalOpen(false);
+          if (pendingAction) {
+            const actionToRun = pendingAction;
+            setPendingAction(null);
+            actionToRun();
+          }
+        }}
+        onClose={() => {
+          setReauthModalOpen(false);
+          setPendingAction(null);
+        }}
+      />
+    </div>
+  );
+}
diff --git a/src/components/ReauthModal.tsx b/src/components/ReauthModal.tsx
new file mode 100644
index 0000000..bd21e10
