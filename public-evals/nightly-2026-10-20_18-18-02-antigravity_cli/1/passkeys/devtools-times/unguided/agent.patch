+                >
+                  <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+                    <path strokeLinecap="round" strokeLinejoin="round" d="M12 4v16m8-8H4" />
+                  </svg>
+                  <span>{addingPasskey ? 'Registering...' : 'Add Passkey'}</span>
+                </button>
+              </div>
+            </div>
+          </form>
+        )}
+      </section>
+
+      {/* Protected Account & Security Settings (Requires Reauthentication) */}
+      <section className="bg-white border border-gray-200 rounded-xl shadow-xs p-6">
+        <div className="mb-4">
+          <h2 className="text-lg font-bold text-gray-900">Profile &amp; Fallback Security Settings</h2>
+          <p className="text-xs text-gray-500 mt-1">
+            Updating your profile details or setting a fallback password requires recent reauthentication with your passkey or password.
+          </p>
+        </div>
+
+        <form onSubmit={handleUpdateAccountSettings} className="space-y-4 max-w-lg">
+          <div>
+            <label htmlFor="account-display-name" className="block text-xs font-medium text-gray-700 mb-1">
+              Display Name
+            </label>
