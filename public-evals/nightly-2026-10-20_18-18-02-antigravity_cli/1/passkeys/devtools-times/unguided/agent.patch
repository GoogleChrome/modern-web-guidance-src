+              className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+            />
+          </div>
+
+          <button
+            type="submit"
+            disabled={updatingProfile}
+            className="py-2 px-4 bg-gray-900 text-white text-sm font-semibold rounded-md hover:bg-gray-800 disabled:opacity-60 cursor-pointer"
+          >
+            {updatingProfile ? 'Saving Changes...' : 'Save Security Settings'}
+          </button>
+        </form>
+      </section>
