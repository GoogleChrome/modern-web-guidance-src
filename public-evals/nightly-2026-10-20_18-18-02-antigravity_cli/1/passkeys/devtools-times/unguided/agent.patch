+import type { APIRoute } from 'astro';
+import { verifyRegistrationResponse } from '@simplewebauthn/server';
+import {
+  getUserById,
+  getUserByUsername,
+  createUser,
+  addPasskeyToUser,
+  bytesToBase64,
+  sanitizeUser,
+  type StoredPasskey,
+} from '../../../utils/auth-store';
+import {
+  getRpConfig,
+  getDefaultPasskeyName,
+  REAUTH_WINDOW_MS,
+} from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { response, name } = body;
+
+    if (!response) {
+      return new Response(
+        JSON.stringify({ error: 'Registration response is required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const expectedChallenge = (await session?.get('currentChallenge')) as string | undefined;
+    if (!expectedChallenge) {
+      return new Response(
+        JSON.stringify({ error: 'Registration challenge expired or not found. Please try again.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const { rpID, origin } = getRpConfig(request);
+
+    const verification = await verifyRegistrationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      requireUserVerification: false,
+    });
+
+    await session?.set('currentChallenge', undefined);
+
+    if (!verification.verified || !verification.registrationInfo) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey registration verification failed.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    let userId = (await session?.get('userId')) as string | undefined;
+    let user = userId ? getUserById(userId) : undefined;
+
+    if (!user) {
+      const pending = (await session?.get('pendingRegistrationUser')) as
+        | {
+            id: string;
+            username: string;
+            displayName?: string;
+            email?: string;
+            password?: string;
+          }
+        | undefined;
+
+      if (!pending) {
+        return new Response(
+          JSON.stringify({ error: 'No active user session or pending registration found.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      const existing = getUserByUsername(pending.username);
+      if (existing) {
+        return new Response(
+          JSON.stringify({ error: 'Username was already registered.' }),
+          { status: 409, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      user = createUser({
+        username: pending.username,
+        password: pending.password,
+        displayName: pending.displayName,
+        email: pending.email,
+      });
+      await session?.set('pendingRegistrationUser', undefined);
+    }
+
+    const {
+      credential,
+      credentialDeviceType,
+      credentialBackedUp,
+      aaguid,
+    } = verification.registrationInfo;
+
+    const defaultName = getDefaultPasskeyName(
+      request.headers.get('user-agent'),
+      credentialDeviceType,
+      credentialBackedUp
+    );
+
+    const passkeyName =
+      typeof name === 'string' && name.trim().length > 0
+        ? name.trim()
+        : `${defaultName} (${user.passkeys.length + 1})`;
+
+    const newPasskey: StoredPasskey = {
+      id: credential.id,
+      publicKey: bytesToBase64(credential.publicKey),
+      userId: user.id,
+      name: passkeyName,
+      counter: credential.counter,
+      deviceType: credentialDeviceType,
+      backedUp: credentialBackedUp,
+      transports: credential.transports || response.response?.transports || [],
+      aaguid,
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+    };
+
+    addPasskeyToUser(user.id, newPasskey);
+
+    const updatedUser = getUserById(user.id)!;
+    const now = Date.now();
+    await session?.set('userId', updatedUser.id);
+    await session?.set('reauthenticatedAt', now);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        passkey: {
+          id: newPasskey.id,
+          name: newPasskey.name,
+          deviceType: newPasskey.deviceType,
+          backedUp: newPasskey.backedUp,
+          transports: newPasskey.transports,
+          aaguid: newPasskey.aaguid,
+          createdAt: newPasskey.createdAt,
+          lastUsedAt: newPasskey.lastUsedAt,
+        },
+        user: sanitizeUser(updatedUser),
+        rpID,
+        reauth: {
+          verified: true,
+          reauthenticatedAt: now,
+          expiresAt: now + REAUTH_WINDOW_MS,
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to verify passkey registration.' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/utils/auth-store.ts b/src/utils/auth-store.ts
new file mode 100644
index 0000000..cbc7dd2
--- /dev/null
+++ b/src/utils/auth-store.ts
@@ -0,0 +1,278 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import type { CredentialDeviceType } from '@simplewebauthn/server';
+
+export interface StoredPasskey {
+  id: string; // Base64URLString credential ID
+  publicKey: string; // Base64 encoded public key bytes
+  userId: string;
+  name: string;
+  counter: number;
+  deviceType: CredentialDeviceType;
+  backedUp: boolean;
+  transports?: string[];
+  aaguid?: string;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+export interface StoredUser {
+  id: string; // Base64URLString user handle
+  username: string;
+  displayName: string;
+  email: string;
+  passwordHash: string;
+  createdAt: string;
+  passkeys: StoredPasskey[];
+}
+
+interface DatabaseSchema {
+  users: StoredUser[];
+}
+
+const DB_FILE = path.resolve(process.cwd(), '.auth-db.json');
+
+function createDefaultDb(): DatabaseSchema {
+  return {
+    users: [],
+  };
+}
+
+function readDb(): DatabaseSchema {
+  try {
+    if (fs.existsSync(DB_FILE)) {
+      const raw = fs.readFileSync(DB_FILE, 'utf-8');
+      const parsed = JSON.parse(raw);
+      if (parsed && Array.isArray(parsed.users)) {
+        return parsed;
+      }
+    }
+  } catch (err) {
+    console.error('Failed to read auth DB, falling back to default:', err);
+  }
+  return createDefaultDb();
+}
+
+function writeDb(db: DatabaseSchema): void {
+  try {
+    fs.writeFileSync(DB_FILE, JSON.stringify(db, null, 2), 'utf-8');
+  } catch (err) {
+    console.error('Failed to write auth DB:', err);
+  }
+}
+
+export function hashPassword(password: string): string {
+  return crypto.createHash('sha256').update(password).digest('hex');
+}
+
+export function generateUserId(): string {
+  return crypto.randomBytes(32).toString('base64url');
+}
+
+export function userIdToBytes(userId: string): Uint8Array<ArrayBuffer> {
+  const buf = Buffer.from(userId, 'base64url');
+  return new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength).slice();
+}
+
+export function publicKeyToBytes(base64PublicKey: string): Uint8Array<ArrayBuffer> {
+  const buf = Buffer.from(base64PublicKey, 'base64');
+  return new Uint8Array(buf.buffer, buf.byteOffset, buf.byteLength).slice();
+}
+
+export function bytesToBase64(bytes: Uint8Array): string {
+  return Buffer.from(bytes).toString('base64');
+}
+
+export function getUserByUsername(username: string): StoredUser | undefined {
+  const db = readDb();
+  const normalized = username.trim().toLowerCase();
+  return db.users.find((u) => u.username.toLowerCase() === normalized);
+}
+
+export function getUserById(userId: string): StoredUser | undefined {
+  const db = readDb();
+  return db.users.find((u) => u.id === userId);
+}
+
+export function getUserByCredentialId(credentialId: string): { user: StoredUser; passkey: StoredPasskey } | undefined {
+  const db = readDb();
+  for (const user of db.users) {
+    const passkey = user.passkeys.find((pk) => pk.id === credentialId);
+    if (passkey) {
+      return { user, passkey };
+    }
+  }
+  return undefined;
+}
+
+export function createUser(params: {
+  username: string;
+  password?: string;
+  displayName?: string;
+  email?: string;
+}): StoredUser {
+  const db = readDb();
+  const existing = db.users.find((u) => u.username.toLowerCase() === params.username.trim().toLowerCase());
+  if (existing) {
+    throw new Error('Username already exists');
+  }
+
+  const user: StoredUser = {
+    id: generateUserId(),
+    username: params.username.trim(),
+    displayName: params.displayName?.trim() || params.username.trim(),
+    email: params.email?.trim() || `${params.username.trim().toLowerCase()}@devtoolstimes.dev`,
+    passwordHash: params.password ? hashPassword(params.password) : '',
+    createdAt: new Date().toISOString(),
+    passkeys: [],
+  };
+
+  db.users.push(user);
+  writeDb(db);
+  return user;
+}
+
+export function ensureUserExists(username: string, password?: string): StoredUser {
+  const existing = getUserByUsername(username);
+  if (existing) {
+    if (password && !existing.passwordHash) {
+      const db = readDb();
+      const target = db.users.find((u) => u.id === existing.id);
+      if (target) {
+        target.passwordHash = hashPassword(password);
+        writeDb(db);
+        return target;
+      }
+    }
+    return existing;
+  }
+  return createUser({ username, password });
+}
+
+export function verifyUserPassword(user: StoredUser, password: string): boolean {
+  if (!user.passwordHash) return false;
+  return user.passwordHash === hashPassword(password);
+}
+
+export function updateUserPassword(userId: string, newPassword: string): StoredUser | undefined {
+  const db = readDb();
+  const user = db.users.find((u) => u.id === userId);
+  if (!user) return undefined;
+  user.passwordHash = hashPassword(newPassword);
+  writeDb(db);
+  return user;
+}
+
+export function updateUserDetails(
+  userId: string,
+  updates: { username?: string; displayName?: string; email?: string }
+): StoredUser | undefined {
+  const db = readDb();
+  const user = db.users.find((u) => u.id === userId);
+  if (!user) return undefined;
+
+  if (updates.username && updates.username.trim() !== user.username) {
+    const taken = db.users.some(
+      (u) => u.id !== userId && u.username.toLowerCase() === updates.username!.trim().toLowerCase()
+    );
+    if (taken) {
+      throw new Error('Username is already taken');
+    }
+    user.username = updates.username.trim();
+  }
+  if (updates.displayName !== undefined) {
+    user.displayName = updates.displayName.trim() || user.username;
+  }
+  if (updates.email !== undefined) {
+    user.email = updates.email.trim();
+  }
+
+  writeDb(db);
+  return user;
+}
+
+export function deleteUser(userId: string): boolean {
+  const db = readDb();
+  const initialLen = db.users.length;
+  db.users = db.users.filter((u) => u.id !== userId);
+  if (db.users.length !== initialLen) {
+    writeDb(db);
+    return true;
+  }
+  return false;
+}
+
+export function addPasskeyToUser(userId: string, passkey: StoredPasskey): StoredPasskey {
+  const db = readDb();
+  const user = db.users.find((u) => u.id === userId);
+  if (!user) {
+    throw new Error('User not found');
+  }
+
+  const existingIndex = user.passkeys.findIndex((p) => p.id === passkey.id);
+  if (existingIndex >= 0) {
+    user.passkeys[existingIndex] = passkey;
+  } else {
+    user.passkeys.push(passkey);
+  }
+
+  writeDb(db);
+  return passkey;
+}
+
+export function updatePasskeyUsage(userId: string, credentialId: string, newCounter: number): void {
+  const db = readDb();
+  const user = db.users.find((u) => u.id === userId);
+  if (!user) return;
+  const passkey = user.passkeys.find((p) => p.id === credentialId);
+  if (!passkey) return;
+  passkey.counter = newCounter;
+  passkey.lastUsedAt = new Date().toISOString();
+  writeDb(db);
+}
+
+export function renamePasskey(userId: string, credentialId: string, newName: string): StoredPasskey | undefined {
+  const db = readDb();
+  const user = db.users.find((u) => u.id === userId);
+  if (!user) return undefined;
+  const passkey = user.passkeys.find((p) => p.id === credentialId);
+  if (!passkey) return undefined;
+  passkey.name = newName.trim() || 'Passkey';
+  writeDb(db);
+  return passkey;
+}
+
+export function deletePasskey(userId: string, credentialId: string): boolean {
+  const db = readDb();
+  const user = db.users.find((u) => u.id === userId);
+  if (!user) return false;
+  const initialLen = user.passkeys.length;
+  user.passkeys = user.passkeys.filter((p) => p.id !== credentialId);
+  if (user.passkeys.length !== initialLen) {
+    writeDb(db);
+    return true;
+  }
+  return false;
+}
+
+export function sanitizeUser(user: StoredUser) {
+  return {
+    id: user.id,
+    username: user.username,
+    displayName: user.displayName,
+    email: user.email,
+    hasPassword: Boolean(user.passwordHash),
+    createdAt: user.createdAt,
+    passkeys: user.passkeys.map((pk) => ({
+      id: pk.id,
+      name: pk.name,
+      deviceType: pk.deviceType,
+      backedUp: pk.backedUp,
+      transports: pk.transports || [],
+      aaguid: pk.aaguid,
+      createdAt: pk.createdAt,
+      lastUsedAt: pk.lastUsedAt,
+    })),
+  };
+}
diff --git a/src/utils/passkey-client.ts b/src/utils/passkey-client.ts
new file mode 100644
index 0000000..ee3aa7c
--- /dev/null
+++ b/src/utils/passkey-client.ts
@@ -0,0 +1,217 @@
+import {
+  startRegistration,
+  startAuthentication,
+  sendSignal,
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  platformAuthenticatorIsAvailable,
+  WebAuthnAbortService,
+} from '@simplewebauthn/browser';
+
+export interface PasskeyItem {
+  id: string;
+  name: string;
+  deviceType: 'singleDevice' | 'multiDevice';
+  backedUp: boolean;
+  transports?: string[];
+  aaguid?: string;
+  createdAt: string;
+  lastUsedAt?: string;
+}
+
+export interface UserProfile {
+  id: string;
+  username: string;
+  displayName: string;
+  email: string;
+  hasPassword: boolean;
+  createdAt: string;
+  passkeys: PasskeyItem[];
+}
+
+export interface ReauthState {
+  verified: boolean;
+  reauthenticatedAt: number | null;
+  expiresAt: number | null;
+}
+
+const baseUrl = import.meta.env.BASE_URL || '/';
+
+export function apiUrl(path: string): string {
+  const cleanBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
+  return `${cleanBase}${cleanPath}`;
+}
+
+export async function syncPasskeySignals(user: UserProfile, rpID: string) {
+  try {
+    if (!browserSupportsWebAuthn()) return;
+    await sendSignal({
+      signalName: 'allAcceptedCredentials',
+      rpID,
+      userID: user.id,
+      allAcceptedCredentialIDs: user.passkeys.map((pk) => pk.id),
+    });
+    await sendSignal({
+      signalName: 'currentUserDetails',
+      rpID,
+      userID: user.id,
+      userName: user.username,
+      userDisplayName: user.displayName || user.username,
+    });
+  } catch {
+    // Signal API is best-effort and may not be supported in all browsers
+  }
+}
+
+export async function signalUnknownPasskey(rpID: string, credentialID: string) {
+  try {
+    if (!browserSupportsWebAuthn()) return;
+    await sendSignal({
+      signalName: 'unknownCredential',
+      rpID,
+      credentialID,
+    });
+  } catch {
+    // Best-effort
+  }
+}
+
+export async function registerPasskeyClient(params?: {
+  username?: string;
+  displayName?: string;
+  email?: string;
+  password?: string;
+  passkeyName?: string;
+  useAutoRegister?: boolean;
+  authenticatorAttachment?: 'platform' | 'cross-platform';
+}): Promise<{
+  verified: boolean;
+  user: UserProfile;
+  passkey: PasskeyItem;
+  rpID: string;
+  reauth: ReauthState;
+}> {
+  if (!browserSupportsWebAuthn()) {
+    throw new Error('WebAuthn / Passkeys are not supported in this browser.');
+  }
+
+  // Cancel any pending conditional UI ceremony before starting registration
+  WebAuthnAbortService.cancelCeremony();
+
+  const optionsRes = await fetch(apiUrl('api/passkeys/register-options'), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      username: params?.username,
+      displayName: params?.displayName,
+      email: params?.email,
+      password: params?.password,
+      authenticatorAttachment: params?.authenticatorAttachment,
+    }),
+  });
+
+  const optionsData = await optionsRes.json();
+  if (!optionsRes.ok) {
+    throw new Error(optionsData.error || 'Failed to get passkey registration options.');
+  }
+
+  const registrationResponse = await startRegistration({
+    optionsJSON: optionsData,
+    useAutoRegister: params?.useAutoRegister ?? false,
+  });
+
+  const verifyRes = await fetch(apiUrl('api/passkeys/register-verify'), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      response: registrationResponse,
+      name: params?.passkeyName,
+    }),
+  });
+
+  const verifyData = await verifyRes.json();
+  if (!verifyRes.ok) {
+    throw new Error(verifyData.error || 'Failed to verify passkey registration.');
+  }
+
+  if (verifyData.user && verifyData.rpID) {
+    await syncPasskeySignals(verifyData.user, verifyData.rpID);
+  }
+
+  window.dispatchEvent(new CustomEvent('auth-state-changed', { detail: verifyData.user }));
+
+  return verifyData;
+}
+
+export async function authenticateWithPasskeyClient(params?: {
+  username?: string;
+  mode?: 'login' | 'reauth';
+  useBrowserAutofill?: boolean;
+}): Promise<{
+  verified: boolean;
+  user: UserProfile;
+  passkeyUsed: { id: string; name: string };
+  rpID: string;
+  reauth: ReauthState;
+}> {
+  if (!browserSupportsWebAuthn()) {
+    throw new Error('WebAuthn / Passkeys are not supported in this browser.');
+  }
+
+  if (!params?.useBrowserAutofill) {
+    WebAuthnAbortService.cancelCeremony();
+  }
+
+  const optionsRes = await fetch(apiUrl('api/passkeys/authenticate-options'), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      username: params?.username,
+      mode: params?.mode || 'login',
+    }),
+  });
+
+  const optionsData = await optionsRes.json();
+  if (!optionsRes.ok) {
+    throw new Error(optionsData.error || 'Failed to get authentication options.');
+  }
+
+  const authResponse = await startAuthentication({
+    optionsJSON: optionsData,
+    useBrowserAutofill: params?.useBrowserAutofill ?? false,
+    verifyBrowserAutofillInput: false,
+  });
+
+  const verifyRes = await fetch(apiUrl('api/passkeys/authenticate-verify'), {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      response: authResponse,
+      mode: params?.mode || 'login',
+    }),
+  });
+
+  const verifyData = await verifyRes.json();
+  if (!verifyRes.ok) {
+    if (verifyData.code === 'UNKNOWN_CREDENTIAL' && verifyData.rpID && verifyData.credentialID) {
+      await signalUnknownPasskey(verifyData.rpID, verifyData.credentialID);
+    }
+    throw new Error(verifyData.error || 'Passkey authentication failed.');
+  }
+
+  if (verifyData.user && verifyData.rpID) {
+    await syncPasskeySignals(verifyData.user, verifyData.rpID);
+  }
+
+  window.dispatchEvent(new CustomEvent('auth-state-changed', { detail: verifyData.user }));
+
+  return verifyData;
+}
+
+export {
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  platformAuthenticatorIsAvailable,
+  WebAuthnAbortService,
+};
diff --git a/src/utils/webauthn.ts b/src/utils/webauthn.ts
new file mode 100644
index 0000000..3864771
--- /dev/null
+++ b/src/utils/webauthn.ts
@@ -0,0 +1,74 @@
+import type { AstroSession } from 'astro';
+
+export const RP_NAME = 'The DevTools Times';
+
+// Reauthentication window in milliseconds (5 minutes)
+export const REAUTH_WINDOW_MS = 5 * 60 * 1000;
+
+export function getRpConfig(request: Request): { rpID: string; origin: string } {
+  const url = new URL(request.url);
+  const forwardedHost = request.headers.get('x-forwarded-host');
+  const forwardedProto = request.headers.get('x-forwarded-proto');
+  const originHeader = request.headers.get('origin');
+
+  if (originHeader) {
+    try {
+      const parsedOrigin = new URL(originHeader);
+      return {
+        rpID: parsedOrigin.hostname,
+        origin: parsedOrigin.origin,
+      };
+    } catch {
+      // Fallback below
+    }
+  }
+
+  const host = forwardedHost || request.headers.get('host') || url.host;
+  const hostname = host.split(':')[0];
+  const protocol = forwardedProto || url.protocol.replace(':', '');
+
+  return {
+    rpID: hostname,
+    origin: `${protocol}://${host}`,
+  };
+}
+
+export async function isRecentlyReauthenticated(session?: AstroSession): Promise<{
+  verified: boolean;
+  reauthenticatedAt: number | null;
+  expiresAt: number | null;
+}> {
+  if (!session) {
+    return { verified: false, reauthenticatedAt: null, expiresAt: null };
+  }
+  const reauthenticatedAt = (await session.get('reauthenticatedAt')) as number | undefined;
+  if (!reauthenticatedAt) {
+    return { verified: false, reauthenticatedAt: null, expiresAt: null };
+  }
+  const expiresAt = reauthenticatedAt + REAUTH_WINDOW_MS;
+  const now = Date.now();
+  if (now <= expiresAt) {
+    return { verified: true, reauthenticatedAt, expiresAt };
+  }
+  return { verified: false, reauthenticatedAt, expiresAt };
+}
+
+export function getDefaultPasskeyName(userAgent: string | null, deviceType: string, backedUp: boolean): string {
+  if (!userAgent) {
+    return backedUp ? 'Synced Passkey' : 'Security Key';
+  }
+  const ua = userAgent.toLowerCase();
+  let platform = 'Device';
+  if (ua.includes('macintosh') || ua.includes('mac os')) platform = 'macOS / iCloud Keychain';
+  else if (ua.includes('iphone') || ua.includes('ipad')) platform = 'iOS / iCloud Keychain';
+  else if (ua.includes('android')) platform = 'Android / Google Password Manager';
+  else if (ua.includes('windows')) platform = 'Windows Hello';
+  else if (ua.includes('linux')) platform = 'Linux Authenticator';
+  else if (ua.includes('cros')) platform = 'ChromeOS Passkey';
+
+  if (ua.includes('chrome') && !ua.includes('edg')) {
+    if (platform === 'Linux Authenticator') platform = 'Chrome Profile Passkey';
+  }
+
+  return platform;
+}
