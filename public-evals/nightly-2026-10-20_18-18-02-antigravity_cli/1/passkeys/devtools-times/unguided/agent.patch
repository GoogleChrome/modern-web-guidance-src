@@ -0,0 +1,205 @@
+import React, { useState } from 'react';
+import {
+  authenticateWithPasskeyClient,
+  apiUrl,
+  type UserProfile,
+  type ReauthState,
+} from '../utils/passkey-client';
+
+interface ReauthModalProps {
+  isOpen: boolean;
+  user: UserProfile;
+  actionDescription?: string;
+  onSuccess: (reauth: ReauthState) => void;
+  onClose: () => void;
+}
+
+export default function ReauthModal({
+  isOpen,
+  user,
+  actionDescription = 'perform this sensitive action',
+  onSuccess,
+  onClose,
+}: ReauthModalProps) {
+  const [password, setPassword] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [usePasswordFallback, setUsePasswordFallback] = useState(user.passkeys.length === 0);
+
+  if (!isOpen) return null;
+
+  const handlePasskeyReauth = async () => {
+    setError(null);
+    setLoading(true);
+    try {
+      const result = await authenticateWithPasskeyClient({
+        username: user.username,
+        mode: 'reauth',
+      });
+      onSuccess(result.reauth);
+    } catch (err: any) {
+      if (err?.name === 'NotAllowedError') {
+        setError('Passkey verification was cancelled or timed out.');
+      } else {
+        setError(err?.message || 'Passkey verification failed.');
+      }
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const handlePasswordReauth = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setLoading(true);
+    try {
+      const res = await fetch(apiUrl('api/auth/reauthenticate-password'), {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ password }),
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        setError(data.error || 'Password verification failed.');
+      } else {
+        setPassword('');
+        onSuccess({
+          verified: true,
+          reauthenticatedAt: data.reauthenticatedAt,
+          expiresAt: data.expiresAt,
+        });
+      }
+    } catch {
+      setError('An unexpected error occurred during verification.');
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 backdrop-blur-xs"
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="reauth-modal-title"
+    >
+      <div className="bg-white border border-gray-200 rounded-xl shadow-xl max-w-md w-full p-6 relative">
+        <button
+          type="button"
+          onClick={onClose}
+          className="absolute top-4 right-4 text-gray-400 hover:text-gray-600"
+          aria-label="Close modal"
+        >
+          <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+            <path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" />
+          </svg>
+        </button>
+
+        <div className="flex items-center space-x-3 mb-4">
+          <div className="w-10 h-10 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center flex-shrink-0">
+            <svg className="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
+              />
+            </svg>
+          </div>
+          <div>
+            <h3 id="reauth-modal-title" className="text-lg font-bold text-gray-900">
+              Confirm your identity
+            </h3>
+            <p className="text-xs text-gray-500">
+              Signed in as <span className="font-semibold text-gray-700">{user.username}</span>
+            </p>
+          </div>
+        </div>
+
+        <p className="text-sm text-gray-600 mb-5">
+          For your security, please reauthenticate to {actionDescription}.
+        </p>
+
+        {error && (
+          <div className="mb-4 p-3 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg" role="alert">
+            {error}
+          </div>
+        )}
+
+        {!usePasswordFallback && user.passkeys.length > 0 ? (
+          <div className="space-y-4">
+            <button
+              type="button"
+              onClick={handlePasskeyReauth}
+              disabled={loading}
+              className="w-full flex items-center justify-center space-x-2 py-2.5 px-4 rounded-lg bg-gray-900 text-white text-sm font-semibold hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:opacity-60 cursor-pointer"
+            >
+              <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                />
+              </svg>
+              <span>{loading ? 'Verifying passkey...' : 'Verify with Passkey'}</span>
+            </button>
+
+            {user.hasPassword && (
+              <div className="text-center">
+                <button
+                  type="button"
+                  onClick={() => {
+                    setError(null);
+                    setUsePasswordFallback(true);
+                  }}
+                  className="text-xs text-gray-600 hover:text-gray-900 underline cursor-pointer"
+                >
+                  Use password instead
+                </button>
+              </div>
+            )}
+          </div>
+        ) : (
+          <form onSubmit={handlePasswordReauth} className="space-y-4">
+            <div>
+              <label htmlFor="reauth-password" className="block text-xs font-medium text-gray-700 mb-1">
+                Current Password
+              </label>
+              <input
+                id="reauth-password"
+                type="password"
+                autoComplete="current-password"
+                value={password}
+                onChange={(e) => setPassword(e.target.value)}
+                required
+                className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                placeholder="Enter your password"
+              />
+            </div>
+
+            <div className="flex items-center justify-between space-x-3">
+              {user.passkeys.length > 0 && (
+                <button
+                  type="button"
+                  onClick={() => {
+                    setError(null);
+                    setUsePasswordFallback(false);
+                  }}
+                  className="text-xs text-gray-600 hover:text-gray-900 underline cursor-pointer"
+                >
+                  Use passkey instead
+                </button>
+              )}
+              <button
+                type="submit"
+                disabled={loading}
+                className="ml-auto py-2 px-4 rounded-lg bg-gray-900 text-white text-sm font-semibold hover:bg-gray-800 disabled:opacity-60 cursor-pointer"
+              >
+                {loading ? 'Verifying...' : 'Confirm Password'}
+              </button>
+            </div>
+          </form>
+        )}
+      </div>
+    </div>
+  );
+}
