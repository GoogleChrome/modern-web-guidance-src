+            />
+          </div>
+
+          <div>
+            <label htmlFor="account-new-password" className="block text-xs font-medium text-gray-700 mb-1">
+              {user.hasPassword ? 'Change Fallback Password (optional)' : 'Set Fallback Password (optional)'}
