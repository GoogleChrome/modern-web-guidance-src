diff --git a/src/pages/api/auth/me.ts b/src/pages/api/auth/me.ts
new file mode 100644
index 0000000..3f1e7df
--- /dev/null
+++ b/src/pages/api/auth/me.ts
@@ -0,0 +1,139 @@
+import type { APIRoute } from 'astro';
+import {
+  getUserById,
+  sanitizeUser,
+  updateUserDetails,
+  updateUserPassword,
+  deleteUser,
+} from '../../../utils/auth-store';
+import { getRpConfig, isRecentlyReauthenticated } from '../../../utils/webauthn';
+
+export const GET: APIRoute = async ({ request, session }) => {
+  const userId = (await session?.get('userId')) as string | undefined;
+  const { rpID } = getRpConfig(request);
+
+  if (!userId) {
+    return new Response(
+      JSON.stringify({ user: null, rpID, reauth: { verified: false, reauthenticatedAt: null, expiresAt: null } }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  const user = getUserById(userId);
+  if (!user) {
+    await session?.set('userId', undefined);
+    return new Response(
+      JSON.stringify({ user: null, rpID, reauth: { verified: false, reauthenticatedAt: null, expiresAt: null } }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  const reauth = await isRecentlyReauthenticated(session);
+
+  return new Response(
+    JSON.stringify({
+      user: sanitizeUser(user),
+      rpID,
+      reauth,
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const userId = (await session?.get('userId')) as string | undefined;
+  if (!userId) {
+    return new Response(JSON.stringify({ error: 'Not authenticated' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = getUserById(userId);
+  if (!user) {
+    return new Response(JSON.stringify({ error: 'User not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const reauth = await isRecentlyReauthenticated(session);
+  if (!reauth.verified) {
+    return new Response(
+      JSON.stringify({
+        error: 'Reauthentication required to modify account settings.',
+        code: 'REAUTH_REQUIRED',
+      }),
+      { status: 403, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  try {
+    const body = await request.json();
+    const { username, displayName, email, newPassword } = body;
+
+    let updatedUser = user;
+
+    if (newPassword !== undefined && newPassword !== '') {
+      if (newPassword.length < 8 || !/\d/.test(newPassword)) {
+        return new Response(
+          JSON.stringify({ error: 'Password must be at least 8 characters and contain a number.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      const res = updateUserPassword(userId, newPassword);
+      if (res) updatedUser = res;
+    }
+
+    if (username !== undefined || displayName !== undefined || email !== undefined) {
+      const res = updateUserDetails(userId, { username, displayName, email });
+      if (res) updatedUser = res;
+    }
+
+    const { rpID } = getRpConfig(request);
+
+    return new Response(
+      JSON.stringify({
+        user: sanitizeUser(updatedUser),
+        rpID,
+        reauth,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to update account.' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
+
+export const DELETE: APIRoute = async ({ session }) => {
+  const userId = (await session?.get('userId')) as string | undefined;
+  if (!userId) {
+    return new Response(JSON.stringify({ error: 'Not authenticated' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const reauth = await isRecentlyReauthenticated(session);
+  if (!reauth.verified) {
+    return new Response(
+      JSON.stringify({
+        error: 'Reauthentication required to delete your account.',
+        code: 'REAUTH_REQUIRED',
+      }),
+      { status: 403, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  deleteUser(userId);
+  await session?.set('userId', undefined);
+  await session?.set('reauthenticatedAt', undefined);
+
+  return new Response(
+    JSON.stringify({ success: true }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
