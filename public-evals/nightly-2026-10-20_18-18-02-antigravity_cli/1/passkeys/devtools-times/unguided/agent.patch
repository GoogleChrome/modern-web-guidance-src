diff --git a/src/components/HeaderAuthNav.tsx b/src/components/HeaderAuthNav.tsx
new file mode 100644
index 0000000..8b8700d
--- /dev/null
+++ b/src/components/HeaderAuthNav.tsx
@@ -0,0 +1,104 @@
+import React, { useState, useEffect } from 'react';
+import { apiUrl, type UserProfile } from '../utils/passkey-client';
+
+interface HeaderAuthNavProps {
+  initialUser?: UserProfile | null;
+}
+
+export default function HeaderAuthNav({ initialUser = null }: HeaderAuthNavProps) {
+  const [user, setUser] = useState<UserProfile | null>(initialUser);
+  const baseUrl = import.meta.env.BASE_URL || '/';
+
+  useEffect(() => {
+    const fetchCurrent = async () => {
+      try {
+        const res = await fetch(apiUrl('api/auth/me'));
+        const data = await res.json();
+        if (data && 'user' in data) {
+          setUser(data.user);
+        }
+      } catch {
+        // Ignore error
+      }
+    };
+
+    if (!initialUser) {
+      fetchCurrent();
+    }
+
+    const handleAuthChange = (event: Event) => {
+      const customEvent = event as CustomEvent<UserProfile | null>;
+      if (customEvent.detail !== undefined) {
+        setUser(customEvent.detail);
+      } else {
+        fetchCurrent();
+      }
+    };
+
+    window.addEventListener('auth-state-changed', handleAuthChange);
+    return () => window.removeEventListener('auth-state-changed', handleAuthChange);
+  }, [initialUser]);
+
+  const handleSignOut = async () => {
+    await fetch(apiUrl('api/auth/logout'), { method: 'POST' });
+    setUser(null);
+    window.dispatchEvent(new CustomEvent('auth-state-changed', { detail: null }));
+    if (window.location.pathname.endsWith('/account')) {
+      window.location.href = `${baseUrl}signin`;
+    }
+  };
+
+  if (user) {
+    return (
+      <div className="flex items-center space-x-3">
+        <a
+          href={`${baseUrl}account`}
+          data-skip-tracking="true"
+          className="inline-flex items-center space-x-1.5 bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700"
+        >
+          <svg
+            className="w-3.5 h-3.5"
+            fill="none"
+            viewBox="0 0 24 24"
+            stroke="currentColor"
+            strokeWidth={2}
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+            />
+          </svg>
+          <span>{user.username} (Passkeys)</span>
+        </a>
+        <button
+          type="button"
+          onClick={handleSignOut}
+          data-skip-tracking="true"
+          className="bg-gray-200 text-gray-800 text-xs font-semibold py-2 px-3 rounded hover:bg-gray-300 cursor-pointer"
+        >
+          Sign out
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div className="flex items-center space-x-3">
+      <a
+        href={`${baseUrl}signup`}
+        data-skip-tracking="true"
+        className="bg-gray-800 text-white text-xs font-semibold py-2 px-3 rounded whitespace-nowrap hover:bg-gray-700"
+      >
+        Sign up
+      </a>
+      <a
+        href={`${baseUrl}signin`}
+        data-skip-tracking="true"
+        className="bg-gray-500 text-white text-xs font-semibold py-2 px-3 rounded hover:bg-gray-400"
+      >
+        Sign in
+      </a>
+    </div>
+  );
+}
diff --git a/src/components/PasskeyManager.tsx b/src/components/PasskeyManager.tsx
new file mode 100644
index 0000000..ef5528e
--- /dev/null
+++ b/src/components/PasskeyManager.tsx
@@ -0,0 +1,629 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  registerPasskeyClient,
+  syncPasskeySignals,
+  browserSupportsWebAuthn,
+  apiUrl,
+  type UserProfile,
+  type PasskeyItem,
+  type ReauthState,
+} from '../utils/passkey-client';
+import ReauthModal from './ReauthModal';
+
+export default function PasskeyManager() {
+  const [user, setUser] = useState<UserProfile | null>(null);
+  const [rpID, setRpID] = useState<string>('');
+  const [reauth, setReauth] = useState<ReauthState>({
+    verified: false,
+    reauthenticatedAt: null,
+    expiresAt: null,
+  });
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [supportsPasskeys, setSupportsPasskeys] = useState(false);
+
+  // Add passkey state
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+  const [attachmentFilter, setAttachmentFilter] = useState<'any' | 'platform' | 'cross-platform'>('any');
+  const [addingPasskey, setAddingPasskey] = useState(false);
+
+  // Rename passkey state
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingPasskeyName, setEditingPasskeyName] = useState('');
+  const [savingName, setSavingName] = useState(false);
+
+  // Profile & security update state
+  const [displayNameInput, setDisplayNameInput] = useState('');
+  const [emailInput, setEmailInput] = useState('');
+  const [newPasswordInput, setNewPasswordInput] = useState('');
+  const [updatingProfile, setUpdatingProfile] = useState(false);
+
+  // Reauthentication modal state & pending action queue
+  const [reauthModalOpen, setReauthModalOpen] = useState(false);
+  const [reauthActionDesc, setReauthActionDesc] = useState('continue');
+  const [pendingAction, setPendingAction] = useState<(() => Promise<void>) | null>(null);
+
+  // Remaining time ticker for reauth status
+  const [remainingSeconds, setRemainingSeconds] = useState<number>(0);
+
+  const baseUrl = import.meta.env.BASE_URL || '/';
+
+  const fetchAccount = useCallback(async () => {
+    try {
+      const res = await fetch(apiUrl('api/auth/me'));
+      const data = await res.json();
+      if (data.user) {
+        setUser(data.user);
+        setRpID(data.rpID || window.location.hostname);
+        setReauth(data.reauth || { verified: false, reauthenticatedAt: null, expiresAt: null });
+        setDisplayNameInput(data.user.displayName || data.user.username);
+        setEmailInput(data.user.email || '');
+      } else {
+        setUser(null);
+      }
+    } catch {
+      setError('Failed to load account details.');
+    } finally {
+      setLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    setSupportsPasskeys(browserSupportsWebAuthn());
+    fetchAccount();
+  }, [fetchAccount]);
+
+  useEffect(() => {
+    if (!reauth.verified || !reauth.expiresAt) {
+      setRemainingSeconds(0);
+      return;
+    }
+
+    const updateTimer = () => {
+      const diff = Math.max(0, Math.floor((reauth.expiresAt! - Date.now()) / 1000));
+      setRemainingSeconds(diff);
+      if (diff <= 0) {
+        setReauth((prev) => ({ ...prev, verified: false }));
+      }
+    };
+
+    updateTimer();
+    const interval = setInterval(updateTimer, 1000);
+    return () => clearInterval(interval);
+  }, [reauth]);
+
+  const requireRecentReauth = (description: string, action: () => Promise<void>) => {
+    const isStillValid =
+      reauth.verified && reauth.expiresAt && Date.now() < reauth.expiresAt;
+    if (isStillValid) {
+      action();
+    } else {
+      setReauthActionDesc(description);
+      setPendingAction(() => action);
+      setReauthModalOpen(true);
+    }
+  };
+
+  const handleAddPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!user) return;
+    setError(null);
+    setSuccess(null);
+
+    const performAdd = async () => {
+      setAddingPasskey(true);
+      try {
+        const result = await registerPasskeyClient({
+          passkeyName: newPasskeyName.trim() || undefined,
+          authenticatorAttachment:
+            attachmentFilter === 'any' ? undefined : attachmentFilter,
+        });
+        setUser(result.user);
+        setReauth(result.reauth);
+        setNewPasskeyName('');
+        setSuccess(`Added passkey "${result.passkey.name}".`);
+      } catch (err: any) {
+        if (err?.name === 'NotAllowedError') {
+          setError('Passkey registration was cancelled or timed out.');
+        } else {
+          setError(err?.message || 'Failed to register new passkey.');
+        }
+      } finally {
+        setAddingPasskey(false);
+      }
+    };
+
+    requireRecentReauth('register a new passkey on your account', performAdd);
+  };
+
+  const handleStartRename = (pk: PasskeyItem) => {
+    setEditingPasskeyId(pk.id);
+    setEditingPasskeyName(pk.name);
+    setError(null);
+    setSuccess(null);
+  };
+
+  const handleSaveRename = async (credentialId: string) => {
+    if (!editingPasskeyName.trim()) {
+      setError('Passkey name cannot be empty.');
+      return;
+    }
+    setSavingName(true);
+    setError(null);
+    setSuccess(null);
+
+    try {
+      const res = await fetch(apiUrl('api/passkeys'), {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          credentialId,
+          name: editingPasskeyName.trim(),
+        }),
+      });
+      const data = await res.json();
+      if (!res.ok) {
+        setError(data.error || 'Failed to rename passkey.');
+      } else {
+        setUser(data.user);
+        setEditingPasskeyId(null);
+        setSuccess(`Renamed passkey to "${data.passkey.name}".`);
+      }
+    } catch {
+      setError('Failed to rename passkey.');
+    } finally {
+      setSavingName(false);
+    }
+  };
+
+  const handleDeletePasskey = (pk: PasskeyItem) => {
+    setError(null);
+    setSuccess(null);
+
+    const performDelete = async () => {
+      try {
+        const res = await fetch(apiUrl('api/passkeys'), {
+          method: 'DELETE',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ credentialId: pk.id }),
+        });
+        const data = await res.json();
+        if (!res.ok) {
+          if (data.code === 'REAUTH_REQUIRED') {
+            setReauth({ verified: false, reauthenticatedAt: null, expiresAt: null });
+            setReauthActionDesc(`remove passkey "${pk.name}"`);
+            setPendingAction(() => performDelete);
+            setReauthModalOpen(true);
+            return;
+          }
+          setError(data.error || 'Failed to delete passkey.');
+        } else {
+          setUser(data.user);
+          if (data.user && (data.rpID || rpID)) {
+            await syncPasskeySignals(data.user, data.rpID || rpID);
+          }
+          window.dispatchEvent(new CustomEvent('auth-state-changed', { detail: data.user }));
+          setSuccess(`Removed passkey "${pk.name}" and notified your authenticator.`);
+        }
+      } catch {
+        setError('An error occurred while deleting the passkey.');
+      }
+    };
+
+    requireRecentReauth(`remove passkey "${pk.name}"`, performDelete);
+  };
+
+  const handleUpdateAccountSettings = (e: React.FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setSuccess(null);
+
+    const performUpdate = async () => {
+      setUpdatingProfile(true);
+      try {
+        const res = await fetch(apiUrl('api/auth/me'), {
+          method: 'PATCH',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            displayName: displayNameInput.trim(),
+            email: emailInput.trim(),
+            ...(newPasswordInput ? { newPassword: newPasswordInput } : {}),
+          }),
+        });
+        const data = await res.json();
+        if (!res.ok) {
+          if (data.code === 'REAUTH_REQUIRED') {
+            setReauth({ verified: false, reauthenticatedAt: null, expiresAt: null });
+            setReauthActionDesc('update your account security settings');
+            setPendingAction(() => performUpdate);
+            setReauthModalOpen(true);
+            return;
+          }
+          setError(data.error || 'Failed to update account settings.');
+        } else {
+          setUser(data.user);
+          setNewPasswordInput('');
+          if (data.user && (data.rpID || rpID)) {
+            await syncPasskeySignals(data.user, data.rpID || rpID);
+          }
+          window.dispatchEvent(new CustomEvent('auth-state-changed', { detail: data.user }));
+          setSuccess('Account settings updated successfully.');
+        }
+      } catch {
+        setError('Failed to update account settings.');
+      } finally {
+        setUpdatingProfile(false);
+      }
+    };
+
+    requireRecentReauth('update your account security settings', performUpdate);
+  };
+
+  const handleSignOut = async () => {
+    await fetch(apiUrl('api/auth/logout'), { method: 'POST' });
+    setUser(null);
+    window.dispatchEvent(new CustomEvent('auth-state-changed', { detail: null }));
+    window.location.href = `${baseUrl}signin`;
+  };
+
+  if (loading) {
+    return (
+      <div className="max-w-4xl mx-auto py-12 px-4 text-center text-gray-500">
+        Loading account security settings...
+      </div>
+    );
+  }
+
+  if (!user) {
+    return (
+      <div className="max-w-lg mx-auto my-12 p-8 bg-white border border-gray-200 rounded-xl shadow-xs text-center">
+        <div className="w-12 h-12 rounded-full bg-gray-100 text-gray-800 flex items-center justify-center mx-auto mb-4">
+          <svg className="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+            />
+          </svg>
+        </div>
+        <h2 className="text-xl font-bold text-gray-900 mb-2">Sign in to manage your passkeys</h2>
+        <p className="text-sm text-gray-600 mb-6">
+          You need to be signed in to register, rename, or remove passkeys and manage your security preferences.
+        </p>
+        <div className="flex justify-center space-x-3">
+          <a
+            href={`${baseUrl}signin`}
+            className="px-4 py-2 rounded-md bg-gray-900 text-white text-sm font-semibold hover:bg-gray-800"
+          >
+            Sign In
+          </a>
+          <a
+            href={`${baseUrl}signup`}
+            className="px-4 py-2 rounded-md border border-gray-300 text-gray-700 text-sm font-semibold hover:bg-gray-50"
+          >
+            Create Account
+          </a>
+        </div>
+      </div>
+    );
+  }
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
+      {/* Header Banner */}
+      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 border-b border-gray-200 gap-4">
+        <div>
+          <h1 className="text-2xl font-bold text-gray-900">Account &amp; Passkey Management</h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Signed in as <span className="font-semibold text-gray-900">{user.displayName}</span> (@{user.username})
+          </p>
+        </div>
+
+        <div className="flex items-center space-x-3">
+          {reauth.verified && remainingSeconds > 0 ? (
+            <span className="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-green-50 text-green-800 border border-green-200">
+              <span className="w-2 h-2 rounded-full bg-green-600" />
+              <span>
+                Verified session ({Math.floor(remainingSeconds / 60)}:
+                {String(remainingSeconds % 60).padStart(2, '0')})
+              </span>
+            </span>
+          ) : (
+            <button
+              type="button"
+              onClick={() => {
+                setReauthActionDesc('unlock sensitive security controls');
+                setPendingAction(null);
+                setReauthModalOpen(true);
+              }}
+              className="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-full text-xs font-medium bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100 cursor-pointer"
+            >
+              <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+                <path
+                  strokeLinecap="round"
+                  strokeLinejoin="round"
+                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
+                />
+              </svg>
+              <span>Reauthenticate Now</span>
+            </button>
+          )}
+
+          <button
+            type="button"
+            onClick={handleSignOut}
+            className="px-3 py-1.5 rounded-md border border-gray-300 text-xs font-semibold text-gray-700 hover:bg-gray-50 cursor-pointer"
+          >
+            Sign Out
+          </button>
+        </div>
+      </div>
+
+      {error && (
+        <div className="p-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-lg" role="alert">
+          {error}
+        </div>
+      )}
+
+      {success && (
+        <div className="p-4 text-sm text-green-800 bg-green-50 border border-green-200 rounded-lg" role="alert">
+          {success}
+        </div>
+      )}
+
+      {/* Passkeys Section */}
+      <section className="bg-white border border-gray-200 rounded-xl shadow-xs overflow-hidden">
+        <div className="p-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+          <div>
+            <div className="flex items-center space-x-2">
+              <h2 className="text-lg font-bold text-gray-900">Your Passkeys</h2>
+              <span className="px-2 py-0.5 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
+                {user.passkeys.length}
+              </span>
+            </div>
+            <p className="text-xs text-gray-500 mt-1">
+              Passkeys let you sign in securely using Touch ID, Face ID, Windows Hello, or a hardware security key.
+            </p>
+          </div>
+        </div>
+
+        {/* Registered Passkeys List */}
+        <div className="divide-y divide-gray-200">
+          {user.passkeys.length === 0 ? (
+            <div className="p-8 text-center text-sm text-gray-500">
+              No passkeys registered yet. Add your first passkey below for faster, phishing-resistant sign-in.
+            </div>
+          ) : (
+            user.passkeys.map((pk) => (
+              <div key={pk.id} className="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-gray-50/50">
+                <div className="flex items-start space-x-3.5">
+                  <div className="w-10 h-10 rounded-lg bg-gray-100 text-gray-700 flex items-center justify-center flex-shrink-0 mt-0.5">
+                    <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+                      <path
+                        strokeLinecap="round"
+                        strokeLinejoin="round"
+                        d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
+                      />
+                    </svg>
+                  </div>
+                  <div>
+                    {editingPasskeyId === pk.id ? (
+                      <div className="flex items-center space-x-2">
+                        <input
+                          type="text"
+                          value={editingPasskeyName}
+                          onChange={(e) => setEditingPasskeyName(e.target.value)}
+                          className="px-2.5 py-1 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-gray-900"
+                          aria-label="Passkey name"
+                        />
+                        <button
+                          type="button"
+                          onClick={() => handleSaveRename(pk.id)}
+                          disabled={savingName}
+                          className="px-2.5 py-1 bg-gray-900 text-white text-xs font-semibold rounded hover:bg-gray-800 cursor-pointer"
+                        >
+                          {savingName ? 'Saving...' : 'Save'}
+                        </button>
+                        <button
+                          type="button"
+                          onClick={() => setEditingPasskeyId(null)}
+                          className="px-2 py-1 text-xs text-gray-600 hover:text-gray-900 cursor-pointer"
+                        >
+                          Cancel
+                        </button>
+                      </div>
+                    ) : (
+                      <div className="flex items-center flex-wrap gap-2">
+                        <span className="font-semibold text-gray-900 text-sm">{pk.name}</span>
+                        {pk.backedUp ? (
