+import type { APIRoute } from 'astro';
+import {
+  createUser,
+  getUserByUsername,
+  sanitizeUser,
+} from '../../../utils/auth-store';
+import { getRpConfig } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { username, password, displayName, email } = body;
+
+    if (!username || typeof username !== 'string' || !username.trim()) {
+      return new Response(
+        JSON.stringify({ error: 'Username is required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const existing = getUserByUsername(username);
+    if (existing) {
+      return new Response(
+        JSON.stringify({ error: 'Username already exists. Please choose another or sign in.' }),
+        { status: 409, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (password !== undefined && password !== '') {
+      if (password.length < 8 || !/\d/.test(password)) {
+        return new Response(
+          JSON.stringify({ error: 'Password must be at least 8 characters and contain a number.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      // Also attempt remote registration if available (best effort)
+      try {
+        await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ username: username.trim(), password }),
+        });
+      } catch {
+        // Ignore network errors from remote demo endpoint
+      }
+    }
+
+    const user = createUser({
+      username: username.trim(),
+      password: password || undefined,
+      displayName,
+      email,
+    });
+
+    const now = Date.now();
+    await session?.set('userId', user.id);
+    await session?.set('reauthenticatedAt', now);
+
+    const { rpID } = getRpConfig(request);
+
+    return new Response(
+      JSON.stringify({
+        user: sanitizeUser(user),
+        rpID,
+        reauth: {
+          verified: true,
+          reauthenticatedAt: now,
+          expiresAt: now + 5 * 60 * 1000,
+        },
+      }),
+      { status: 201, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Registration failed.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/authenticate-options.ts b/src/pages/api/passkeys/authenticate-options.ts
