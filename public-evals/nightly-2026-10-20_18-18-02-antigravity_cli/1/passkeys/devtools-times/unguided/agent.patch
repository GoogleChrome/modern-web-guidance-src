new file mode 100644
index 0000000..d6aea20
--- /dev/null
+++ b/src/pages/api/auth/login.ts
@@ -0,0 +1,78 @@
+import type { APIRoute } from 'astro';
+import {
+  getUserByUsername,
+  verifyUserPassword,
+  ensureUserExists,
+  sanitizeUser,
+} from '../../../utils/auth-store';
+import { getRpConfig } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { username, password } = body;
+
+    if (!username || !password) {
+      return new Response(
+        JSON.stringify({ error: 'Username and password are required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    let user = getUserByUsername(username);
+    let authenticated = false;
+
+    if (user && verifyUserPassword(user, password)) {
+      authenticated = true;
+    } else if (!user) {
+      // Check against the remote demo API in case the account was registered there
+      try {
+        const remoteRes = await fetch(
+          'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login',
+          {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ username, password }),
+          }
+        );
+        if (remoteRes.ok) {
+          user = ensureUserExists(username, password);
+          authenticated = true;
+        }
+      } catch {
+        // Ignore remote error
+      }
+    }
+
+    if (!authenticated || !user) {
+      return new Response(
+        JSON.stringify({ error: 'Invalid username or password.' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const now = Date.now();
+    await session?.set('userId', user.id);
+    await session?.set('reauthenticatedAt', now);
+
+    const { rpID } = getRpConfig(request);
+
+    return new Response(
+      JSON.stringify({
+        user: sanitizeUser(user),
+        rpID,
+        reauth: {
+          verified: true,
+          reauthenticatedAt: now,
+          expiresAt: now + 5 * 60 * 1000,
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Login failed.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
