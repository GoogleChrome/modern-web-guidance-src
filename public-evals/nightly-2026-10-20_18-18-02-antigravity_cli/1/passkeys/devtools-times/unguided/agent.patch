+                    onClick={() => handleDeletePasskey(pk)}
+                    className="px-3 py-1.5 text-xs font-medium text-red-700 bg-red-50 border border-red-200 rounded-md hover:bg-red-100 cursor-pointer"
+                  >
+                    Remove
+                  </button>
+                </div>
+              </div>
+            ))
