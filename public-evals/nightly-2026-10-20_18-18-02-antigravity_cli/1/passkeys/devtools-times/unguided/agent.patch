@@ -0,0 +1,176 @@
+import type { APIRoute } from 'astro';
+import {
+  getUserById,
+  renamePasskey,
+  deletePasskey,
+  sanitizeUser,
+} from '../../../utils/auth-store';
+import { getRpConfig, isRecentlyReauthenticated } from '../../../utils/webauthn';
+
+export const GET: APIRoute = async ({ request, session }) => {
+  const userId = (await session?.get('userId')) as string | undefined;
+  if (!userId) {
+    return new Response(JSON.stringify({ error: 'Not authenticated' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const user = getUserById(userId);
+  if (!user) {
+    return new Response(JSON.stringify({ error: 'User not found' }), {
+      status: 404,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const { rpID } = getRpConfig(request);
+  const reauth = await isRecentlyReauthenticated(session);
+
+  return new Response(
+    JSON.stringify({
+      user: sanitizeUser(user),
+      passkeys: sanitizeUser(user).passkeys,
+      rpID,
+      reauth,
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  const userId = (await session?.get('userId')) as string | undefined;
+  if (!userId) {
+    return new Response(JSON.stringify({ error: 'Not authenticated' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  try {
+    const body = await request.json();
+    const { credentialId, name, requireReauth } = body;
+
+    if (!credentialId || typeof name !== 'string' || !name.trim()) {
+      return new Response(
+        JSON.stringify({ error: 'Credential ID and a non-empty name are required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (requireReauth) {
+      const reauth = await isRecentlyReauthenticated(session);
+      if (!reauth.verified) {
+        return new Response(
+          JSON.stringify({
+            error: 'Reauthentication is required to rename this passkey.',
+            code: 'REAUTH_REQUIRED',
+          }),
+          { status: 403, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+    }
+
+    const updated = renamePasskey(userId, credentialId, name.trim());
+    if (!updated) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey not found.' }),
+        { status: 404, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const user = getUserById(userId)!;
+    const { rpID } = getRpConfig(request);
+
+    return new Response(
+      JSON.stringify({
+        passkey: updated,
+        user: sanitizeUser(user),
+        rpID,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to rename passkey.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  const userId = (await session?.get('userId')) as string | undefined;
+  if (!userId) {
+    return new Response(JSON.stringify({ error: 'Not authenticated' }), {
+      status: 401,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+
+  const reauth = await isRecentlyReauthenticated(session);
+  if (!reauth.verified) {
+    return new Response(
+      JSON.stringify({
+        error: 'Reauthentication is required before deleting a passkey.',
+        code: 'REAUTH_REQUIRED',
+      }),
+      { status: 403, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  try {
+    const body = await request.json();
+    const { credentialId } = body;
+
+    if (!credentialId) {
+      return new Response(
+        JSON.stringify({ error: 'Credential ID is required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const userBefore = getUserById(userId);
+    if (!userBefore) {
+      return new Response(
+        JSON.stringify({ error: 'User not found.' }),
+        { status: 404, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Prevent lockout if user has no password and only 1 passkey left
+    if (!userBefore.passwordHash && userBefore.passkeys.length <= 1) {
+      return new Response(
+        JSON.stringify({
+          error:
+            'Cannot delete your only passkey without a password set on your account. Add another passkey or set a fallback password first.',
+        }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const deleted = deletePasskey(userId, credentialId);
+    if (!deleted) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey not found.' }),
+        { status: 404, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const user = getUserById(userId)!;
+    const { rpID } = getRpConfig(request);
+
+    return new Response(
+      JSON.stringify({
+        deletedCredentialId: credentialId,
+        user: sanitizeUser(user),
+        rpID,
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to delete passkey.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/register-options.ts b/src/pages/api/passkeys/register-options.ts
new file mode 100644
index 0000000..3c70d4c
--- /dev/null
+++ b/src/pages/api/passkeys/register-options.ts
@@ -0,0 +1,119 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions } from '@simplewebauthn/server';
+import {
+  getUserById,
+  getUserByUsername,
+  generateUserId,
+  userIdToBytes,
+} from '../../../utils/auth-store';
+import { getRpConfig, RP_NAME } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const {
+      username,
+      displayName,
+      email,
+      password,
+      authenticatorAttachment,
+      preferredAuthenticatorType,
+    } = body;
+
+    const { rpID } = getRpConfig(request);
+    const sessionUserId = (await session?.get('userId')) as string | undefined;
+
+    let targetUserId: string;
+    let targetUsername: string;
+    let targetDisplayName: string;
+    let existingPasskeys: { id: string; transports?: string[] }[] = [];
+
+    if (sessionUserId) {
+      const existingUser = getUserById(sessionUserId);
+      if (!existingUser) {
+        return new Response(
+          JSON.stringify({ error: 'Authenticated user not found.' }),
+          { status: 404, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      targetUserId = existingUser.id;
+      targetUsername = existingUser.username;
+      targetDisplayName = existingUser.displayName || existingUser.username;
+      existingPasskeys = existingUser.passkeys.map((pk) => ({
+        id: pk.id,
+        transports: pk.transports,
+      }));
+      await session?.set('pendingRegistrationUser', undefined);
+    } else {
+      if (!username || typeof username !== 'string' || !username.trim()) {
+        return new Response(
+          JSON.stringify({ error: 'Username is required to register a passkey.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      const trimmedUsername = username.trim();
+      const existing = getUserByUsername(trimmedUsername);
+      if (existing) {
+        return new Response(
+          JSON.stringify({
+            error: 'Username already exists. Please sign in first to add another passkey to your account.',
+          }),
+          { status: 409, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      if (password && (password.length < 8 || !/\d/.test(password))) {
+        return new Response(
+          JSON.stringify({
+            error: 'Password must be at least 8 characters and contain a number.',
+          }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+
+      targetUserId = generateUserId();
+      targetUsername = trimmedUsername;
+      targetDisplayName = displayName?.trim() || trimmedUsername;
+
+      await session?.set('pendingRegistrationUser', {
+        id: targetUserId,
+        username: targetUsername,
+        displayName: targetDisplayName,
+        email: email?.trim() || `${targetUsername.toLowerCase()}@devtoolstimes.dev`,
+        password: password || undefined,
+      });
+    }
+
+    const options = await generateRegistrationOptions({
+      rpName: RP_NAME,
+      rpID,
+      userID: userIdToBytes(targetUserId),
+      userName: targetUsername,
+      userDisplayName: targetDisplayName,
+      attestationType: 'none',
+      excludeCredentials: existingPasskeys.map((pk) => ({
+        id: pk.id,
+        transports: pk.transports as any,
+      })),
+      authenticatorSelection: {
+        residentKey: 'required',
+        userVerification: 'preferred',
+        ...(authenticatorAttachment ? { authenticatorAttachment } : {}),
+      },
+      ...(preferredAuthenticatorType ? { preferredAuthenticatorType } : {}),
+    });
+
+    await session?.set('currentChallenge', options.challenge);
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to generate registration options.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
