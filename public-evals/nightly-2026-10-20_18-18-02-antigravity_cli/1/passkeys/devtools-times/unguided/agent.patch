@@ -0,0 +1,68 @@
+import type { APIRoute } from 'astro';
+import { generateAuthenticationOptions } from '@simplewebauthn/server';
+import { getUserById, getUserByUsername } from '../../../utils/auth-store';
+import { getRpConfig } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const { username, mode } = body;
+
+    const { rpID } = getRpConfig(request);
+    let allowCredentials: { id: string; transports?: any[] }[] | undefined = undefined;
+
+    if (mode === 'reauth') {
+      const userId = (await session?.get('userId')) as string | undefined;
+      if (!userId) {
+        return new Response(
+          JSON.stringify({ error: 'You must be signed in to reauthenticate.' }),
+          { status: 401, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      const user = getUserById(userId);
+      if (!user) {
+        return new Response(
+          JSON.stringify({ error: 'User not found.' }),
+          { status: 404, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      if (user.passkeys.length === 0) {
+        return new Response(
+          JSON.stringify({ error: 'No passkeys registered on this account.' }),
+          { status: 400, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+      allowCredentials = user.passkeys.map((pk) => ({
+        id: pk.id,
+        transports: pk.transports as any,
+      }));
+    } else if (username && typeof username === 'string' && username.trim()) {
+      const user = getUserByUsername(username.trim());
+      if (user && user.passkeys.length > 0) {
+        allowCredentials = user.passkeys.map((pk) => ({
+          id: pk.id,
+          transports: pk.transports as any,
+        }));
+      }
+    }
+
+    const options = await generateAuthenticationOptions({
+      rpID,
+      allowCredentials,
+      userVerification: mode === 'reauth' ? 'required' : 'preferred',
+    });
+
+    await session?.set('currentChallenge', options.challenge);
+    await session?.set('authMode', mode || 'login');
+
+    return new Response(JSON.stringify(options), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to generate authentication options.' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
diff --git a/src/pages/api/passkeys/authenticate-verify.ts b/src/pages/api/passkeys/authenticate-verify.ts
new file mode 100644
index 0000000..6a5fa57
--- /dev/null
+++ b/src/pages/api/passkeys/authenticate-verify.ts
@@ -0,0 +1,116 @@
+import type { APIRoute } from 'astro';
+import { verifyAuthenticationResponse } from '@simplewebauthn/server';
+import {
+  getUserById,
+  getUserByCredentialId,
+  publicKeyToBytes,
+  updatePasskeyUsage,
+  sanitizeUser,
+} from '../../../utils/auth-store';
+import { getRpConfig, REAUTH_WINDOW_MS } from '../../../utils/webauthn';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { response, mode } = body;
+
+    if (!response || !response.id) {
+      return new Response(
+        JSON.stringify({ error: 'Invalid authentication response.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const expectedChallenge = (await session?.get('currentChallenge')) as string | undefined;
+    if (!expectedChallenge) {
+      return new Response(
+        JSON.stringify({ error: 'Authentication challenge expired or not found. Please try again.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const { rpID, origin } = getRpConfig(request);
+    const effectiveMode = mode || (await session?.get('authMode')) || 'login';
+
+    const match = getUserByCredentialId(response.id);
+    if (!match) {
+      return new Response(
+        JSON.stringify({
+          error: 'Passkey is no longer recognized by this server.',
+          code: 'UNKNOWN_CREDENTIAL',
+          rpID,
+          credentialID: response.id,
+        }),
+        { status: 404, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const { user, passkey } = match;
+
+    if (effectiveMode === 'reauth') {
+      const currentUserId = (await session?.get('userId')) as string | undefined;
+      if (!currentUserId || currentUserId !== user.id) {
+        return new Response(
+          JSON.stringify({
+            error: 'The passkey used does not belong to the currently signed-in account.',
+          }),
+          { status: 403, headers: { 'Content-Type': 'application/json' } }
+        );
+      }
+    }
+
+    const verification = await verifyAuthenticationResponse({
+      response,
+      expectedChallenge,
+      expectedOrigin: origin,
+      expectedRPID: rpID,
+      credential: {
+        id: passkey.id,
+        publicKey: publicKeyToBytes(passkey.publicKey),
+        counter: passkey.counter,
+        transports: passkey.transports as any,
+      },
+      requireUserVerification: false,
+    });
+
+    await session?.set('currentChallenge', undefined);
+    await session?.set('authMode', undefined);
+
+    if (!verification.verified) {
+      return new Response(
+        JSON.stringify({ error: 'Passkey signature verification failed.' }),
+        { status: 401, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    updatePasskeyUsage(user.id, passkey.id, verification.authenticationInfo.newCounter);
+
+    const updatedUser = getUserById(user.id)!;
+    const now = Date.now();
+    await session?.set('userId', updatedUser.id);
+    await session?.set('reauthenticatedAt', now);
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        user: sanitizeUser(updatedUser),
+        passkeyUsed: {
+          id: passkey.id,
+          name: passkey.name,
+        },
+        rpID,
+        reauth: {
+          verified: true,
+          reauthenticatedAt: now,
+          expiresAt: now + REAUTH_WINDOW_MS,
+        },
+      }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to verify passkey authentication.' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
