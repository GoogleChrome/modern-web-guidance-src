+const express = require('express');
+const session = require('express-session');
+const cookieParser = require('cookie-parser');
+const crypto = require('crypto');
+const fs = require('fs');
+const path = require('path');
+const {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} = require('@simplewebauthn/server');
+
+const app = express();
+const PORT = process.env.PORT || 11222;
+const RP_NAME = 'The Daily Grind Coffee Co.';
+
+// Middleware
+app.use(express.json());
+app.use(express.urlencoded({ extended: true }));
+app.use(cookieParser());
+app.use(
+  session({
+    secret: process.env.SESSION_SECRET || 'daily-grind-passkey-secret-2026',
+    resave: false,
+    saveUninitialized: true,
+    cookie: {
+      httpOnly: true,
+      sameSite: 'lax',
+      maxAge: 24 * 60 * 60 * 1000, // 24 hours
+    },
+  })
+);
+
+// Serve @simplewebauthn/browser UMD bundle
+app.use(
+  '/vendor/simplewebauthn',
+  express.static(path.join(__dirname, 'node_modules/@simplewebauthn/browser/dist/bundle'))
+);
+
+// Database Persistence Helper
+const DB_FILE = path.join(__dirname, 'data.json');
+
+function hashPassword(password) {
+  return crypto.createHash('sha256').update(password + '_daily_grind_salt').digest('hex');
+}
+
+function getInitialData() {
+  const defaultUserId = crypto.randomBytes(16).toString('base64url');
+  return {
+    users: [
+      {
+        id: defaultUserId,
+        username: 'alex@dailygrind.coffee',
+        displayName: 'Alex Rivera',
+        passwordHash: hashPassword('coffee123'),
+        phone: '(555) 234-5678',
+        favoriteDrink: 'Maple Oat Latte',
+        rewardsPoints: 1450,
+        tier: 'Gold Roaster',
+        walletBalance: 28.50,
+        paymentMethod: 'Visa ending in 4242',
+        autoReload: true,
+        createdAt: '2025-11-15T08:30:00.000Z',
+        passkeys: [],
+      },
+    ],
+  };
+}
+
+function loadDB() {
+  try {
+    if (fs.existsSync(DB_FILE)) {
+      const raw = fs.readFileSync(DB_FILE, 'utf8');
+      const parsed = JSON.parse(raw);
+      if (parsed && Array.isArray(parsed.users)) {
+        return parsed;
+      }
+    }
+  } catch (err) {
+    console.error('Error loading DB, initializing default data:', err);
+  }
+  const initial = getInitialData();
+  saveDB(initial);
+  return initial;
+}
+
+function saveDB(data) {
+  try {
+    fs.writeFileSync(DB_FILE, JSON.stringify(data, null, 2), 'utf8');
+  } catch (err) {
+    console.error('Error saving DB:', err);
+  }
+}
+
+const db = loadDB();
+
+// Helper to get RP_ID and expected Origin dynamically from request
+function getRPConfig(req) {
+  const hostHeader = req.get('x-forwarded-host') || req.get('host') || `localhost:${PORT}`;
+  const hostname = hostHeader.split(':')[0];
+  const rpID = process.env.RP_ID || hostname || 'localhost';
+  const proto = req.get('x-forwarded-proto') || req.protocol || 'http';
+  const origin = process.env.ORIGIN || req.get('origin') || `${proto}://${hostHeader}`;
+  const expectedOrigins = [
+    origin,
+    `http://${hostHeader}`,
+    `https://${hostHeader}`,
+    `http://localhost:${PORT}`,
+    `http://127.0.0.1:${PORT}`,
+  ];
+  return { rpID, expectedOrigins: [...new Set(expectedOrigins)] };
+}
+
+function sanitizeUser(user, req) {
+  if (!user) return null;
+  const reauthAt = req?.session?.lastReauthenticatedAt || 0;
+  const reauthValidUntil = reauthAt + 5 * 60 * 1000; // 5 minutes window
+  const isReauthenticated = Date.now() < reauthValidUntil;
+
+  return {
+    id: user.id,
+    username: user.username,
+    displayName: user.displayName,
+    phone: user.phone || '',
+    favoriteDrink: user.favoriteDrink || 'Maple Oat Latte',
+    rewardsPoints: user.rewardsPoints ?? 250,
+    tier: user.tier || 'Bean Sprout',
+    walletBalance: user.walletBalance ?? 15.0,
+    paymentMethod: user.paymentMethod || 'Visa ending in 4242',
+    autoReload: Boolean(user.autoReload),
+    hasPassword: Boolean(user.passwordHash),
+    createdAt: user.createdAt,
+    isReauthenticated,
+    reauthExpiresAt: isReauthenticated ? reauthValidUntil : null,
+    passkeys: (user.passkeys || []).map((pk) => ({
+      id: pk.id,
+      name: pk.name,
+      deviceType: pk.deviceType || 'multiDevice',
+      backedUp: Boolean(pk.backedUp),
+      transports: pk.transports || [],
+      createdAt: pk.createdAt,
+      lastUsedAt: pk.lastUsedAt,
+      counter: pk.counter || 0,
+      aaguid: pk.aaguid || '00000000-0000-0000-0000-000000000000',
+    })),
+  };
