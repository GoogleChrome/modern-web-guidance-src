+  return res.json({
+    message: 'Account settings updated securely.',
+    user: sanitizeUser(user, req),
+  });
+});
+
+// Reload Coffee Wallet or Redeem High-Value Rewards (Requires Reauthentication)
+app.post('/api/account/wallet/reload', requireReauth, (req, res) => {
+  const amount = Number(req.body.amount);
+  if (!amount || amount <= 0 || amount > 500) {
+    return res.status(400).json({ error: 'Please provide a valid reload amount between $1 and $500.' });
+  }
+  req.user.walletBalance = Number(((req.user.walletBalance || 0) + amount).toFixed(2));
+  req.user.rewardsPoints = (req.user.rewardsPoints || 0) + Math.round(amount * 10);
+  saveDB(db);
+
+  return res.json({
+    message: `Added $${amount.toFixed(2)} to your Daily Grind Wallet (+${Math.round(amount * 10)} Rewards Points)!`,
+    user: sanitizeUser(req.user, req),
+  });
+});
+
+// Change or set password (Requires Reauthentication)
+app.post('/api/account/password', requireReauth, (req, res) => {
+  const { newPassword } = req.body;
+  if (!newPassword || newPassword.length < 4) {
+    return res.status(400).json({ error: 'Password must be at least 4 characters.' });
+  }
+  req.user.passwordHash = hashPassword(newPassword);
+  saveDB(db);
+  return res.json({
+    message: 'Account password updated.',
+    user: sanitizeUser(req.user, req),
+  });
+});
+
+// Delete account (Requires Reauthentication)
+app.delete('/api/account', requireReauth, (req, res) => {
+  const userId = req.user.id;
+  const idx = db.users.findIndex((u) => u.id === userId);
+  if (idx !== -1) {
+    db.users.splice(idx, 1);
+    saveDB(db);
+  }
+  req.session.destroy(() => {
+    res.clearCookie('connect.sid');
+    res.json({ deleted: true, message: 'Your account has been permanently deleted.' });
+  });
+});
+
+// Static assets & SPA fallback
+app.use(express.static(__dirname));
+
+app.get('/{*splat}', (req, res) => {
+  res.sendFile(path.join(__dirname, 'index.html'));
+});
+
+if (require.main === module) {
+  app.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
+
+module.exports = { app, db };
