+function getCurrentUser(req) {
+  if (!req.session || !req.session.userId) return null;
+  return db.users.find((u) => u.id === req.session.userId) || null;
+}
+
+function requireAuth(req, res, next) {
+  const user = getCurrentUser(req);
+  if (!user) {
+    return res.status(401).json({ error: 'Authentication required' });
+  }
+  req.user = user;
+  next();
+}
+
+function requireReauth(req, res, next) {
+  const user = getCurrentUser(req);
+  if (!user) {
+    return res.status(401).json({ error: 'Authentication required' });
+  }
+  const reauthAt = req.session.lastReauthenticatedAt || 0;
+  const isFresh = Date.now() - reauthAt < 5 * 60 * 1000; // 5 minutes
+  if (!isFresh) {
+    return res.status(403).json({
+      error: 'Reauthentication required to perform this sensitive action.',
+      code: 'REAUTH_REQUIRED',
+      hasPasskeys: (user.passkeys || []).length > 0,
+    });
+  }
+  req.user = user;
+  next();
+}
+
+function detectPasskeyFriendlyName(req, customName) {
+  if (customName && customName.trim()) return customName.trim();
+  const ua = req.get('user-agent') || '';
+  if (ua.includes('Macintosh') || ua.includes('Mac OS X')) return 'iCloud Keychain / Mac Passkey';
+  if (ua.includes('iPhone') || ua.includes('iPad')) return 'iPhone / iPad Passkey';
+  if (ua.includes('Windows')) return 'Windows Hello Passkey';
+  if (ua.includes('Android')) return 'Google Password Manager (Android)';
+  if (ua.includes('Linux')) return 'Chrome / Linux Passkey';
+  return `Passkey (${new Date().toLocaleDateString()})`;
+}
