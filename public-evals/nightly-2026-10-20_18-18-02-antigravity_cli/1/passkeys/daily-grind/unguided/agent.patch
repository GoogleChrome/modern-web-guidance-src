+    let targetUser;
+    if (regContext.mode === 'new_user') {
+      const { pendingUser } = regContext;
+      // Check again for race condition
+      const existing = db.users.find((u) => u.username.toLowerCase() === pendingUser.username);
+      if (existing) {
+        return res.status(409).json({ error: 'Account already exists.' });
