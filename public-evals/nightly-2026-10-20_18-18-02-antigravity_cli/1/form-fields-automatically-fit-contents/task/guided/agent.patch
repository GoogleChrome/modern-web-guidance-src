+    /* Applies horizontal auto-sizing to text inputs */
+    .order-form input[type="text"] {
+      field-sizing: content;
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: 50ch;
+    }
+
+    /* Sizes the select element to fit the active option only */
+    .order-form select {
+      field-sizing: content;
+      width: auto;
+      max-inline-size: 50ch;
+    }
+
+    /* Applies vertical auto-sizing to textareas while keeping horizontal width stable */
+    .order-form textarea {
+      field-sizing: content;
+      height: auto;
+      width: 50ch;
+      max-inline-size: 100%;
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+    }
+
+    /* Progressive enhancement fallback for browsers without field-sizing support */
+    @supports not (field-sizing: content) {
+      .growable-textarea {
+        display: grid;
+        width: 50ch;
+        max-inline-size: 100%;
+      }
+
+      .growable-textarea::after,
+      .growable-textarea > textarea {
+        grid-area: 1 / 1 / 2 / 2;
+        font: inherit;
+        line-height: 1.5;
+        padding: 0.75rem;
+        border: 1px solid #8d6e63;
+        border-radius: 5px;
+        width: 100%;
+        min-block-size: 3lh;
+        max-block-size: 10lh;
+      }
+
+      .growable-textarea::after {
+        content: attr(data-replicated-value) " ";
