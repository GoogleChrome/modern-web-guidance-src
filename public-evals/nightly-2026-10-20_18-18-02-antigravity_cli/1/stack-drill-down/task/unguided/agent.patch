+              <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-top: 24px;">
+                <span class="swipe-hint">&#8592; Swipe right anywhere to go back</span>
+                <a href="#/view/${data.relatedId}" class="btn item" data-view-id="${data.relatedId}">
+                  Explore Pair: ${data.relatedTitle} &rarr;
+                </a>
+              </div>
+            </div>
+          </main>
+        `;
+
+        viewEl.appendChild(contentEl);
+        return viewEl;
+      }
+
+      function getViews() {
+        return Array.from(stackEl.querySelectorAll(':scope > .Stack-view'));
+      }
+
+      function focusSafely(el) {
+        if (!el || typeof el.focus !== 'function') return;
+        const savedScrollLeft = stackEl.scrollLeft;
+        try {
+          el.focus({ preventScroll: true });
+        } catch (err) {
+          el.focus();
+        }
+        if (stackEl.scrollLeft !== savedScrollLeft) {
+          stackEl.scrollLeft = savedScrollLeft;
+        }
+      }
+
+      // Apply scroll-linked parallax, dimming, and edge shadow transforms ONLY to .Stack-viewContent
+      function updateVisualTransforms() {
+        const views = getViews();
+        const width = stackEl.clientWidth || window.innerWidth || 1;
+        const scrollLeft = stackEl.scrollLeft;
+        const reduced = prefersReducedMotion();
+
+        for (let i = 0; i < views.length; i++) {
+          const content = views[i].querySelector('.Stack-viewContent');
+          if (!content) continue;
+
+          // progress relative to view i:
+          // when scrollLeft == i * width -> view i is active (offset = 0)
+          // when scrollLeft == (i + 1) * width -> view i is covered by view i+1 (underProgress = 1)
+          // when scrollLeft == (i - 1) * width -> view i is off to the right (enterProgress = 0)
+          const viewStart = i * width;
+          const delta = (scrollLeft - viewStart) / width;
+
+          if (reduced) {
+            content.style.transform = '';
+            content.style.filter = '';
+            content.style.setProperty('--stack-dim', '0');
+            content.style.setProperty('--stack-shadow-alpha', '0');
+            continue;
+          }
+
+          if (delta > 0) {
+            // View i is underneath view i+1 (being covered as user scrolls right, or uncovered as user swipes back)
+            const coverProgress = Math.min(1, Math.max(0, delta));
+            const parallaxPx = -coverProgress * (width * 0.26);
+            const brightness = 1 - coverProgress * 0.28;
+            const scale = 1 - coverProgress * 0.03;
+
+            content.style.transform = `translate3d(${parallaxPx.toFixed(2)}px, 0, 0) scale(${scale.toFixed(4)})`;
+            content.style.filter = `brightness(${brightness.toFixed(3)})`;
+            content.style.setProperty('--stack-dim', (coverProgress * 0.5).toFixed(3));
+            content.style.setProperty('--stack-shadow-alpha', '0');
+          } else if (delta < 0 && delta > -1) {
+            // View i is sliding over view i-1 from the right
+            const enterProgress = 1 + delta; // 0 when at right edge, 1 when fully snapped
+            const shadowAlpha = Math.sin(enterProgress * Math.PI * 0.85) * 0.38 + (1 - Math.abs(delta)) * 0.18;
+            content.style.transform = 'translate3d(0, 0, 0)';
+            content.style.filter = 'brightness(1)';
+            content.style.setProperty('--stack-dim', '0');
+            content.style.setProperty('--stack-shadow-alpha', Math.min(0.45, Math.max(0.05, shadowAlpha)).toFixed(3));
+          } else {
+            // Fully active top view or completely offscreen
+            const isTopSettled = i > 0 && Math.abs(delta) < 0.01;
+            content.style.transform = 'translate3d(0, 0, 0)';
+            content.style.filter = 'brightness(1)';
+            content.style.setProperty('--stack-dim', '0');
+            content.style.setProperty('--stack-shadow-alpha', isTopSettled ? '0.18' : '0');
+          }
+        }
+      }
+
+      // Prune views to the right of targetIndex and manage focus/history
+      function finalizeSettledIndex(newIndex, options = {}) {
+        const { syncHistory = true, manageFocus = true } = options;
+        const views = getViews();
+        const clampedIndex = Math.max(0, Math.min(newIndex, views.length - 1));
+        const previousIndex = activeIndex;
+
+        // Remove any views to the right of clampedIndex from the DOM
+        if (clampedIndex < views.length - 1) {
+          for (let i = views.length - 1; i > clampedIndex; i--) {
+            views[i].remove();
+          }
+        }
+
+        activeIndex = clampedIndex;
+        updateVisualTransforms();
+
+        if (manageFocus && clampedIndex !== previousIndex) {
+          if (clampedIndex > previousIndex) {
+            // Drilled down into a new view -> focus its .back button
+            const currentView = getViews()[clampedIndex];
+            const backBtn = currentView ? currentView.querySelector('.back') : null;
+            if (backBtn) {
+              focusSafely(backBtn);
+            }
+          } else if (clampedIndex < previousIndex) {
+            // Swiped or navigated back -> restore focus to trigger link (or back button of current view)
+            const restoredTrigger = triggerElementByDepth.get(clampedIndex + 1);
+            const currentView = getViews()[clampedIndex];
+            if (restoredTrigger && currentView && currentView.contains(restoredTrigger)) {
+              focusSafely(restoredTrigger);
+            } else if (currentView) {
+              const fallbackTarget = currentView.querySelector('.back') || currentView.querySelector('.item');
+              if (fallbackTarget) focusSafely(fallbackTarget);
+            }
+          }
+        }
+
+        if (syncHistory && !isHandlingPopState) {
+          const currentViews = getViews();
+          const activeView = currentViews[clampedIndex];
+          const viewId = activeView ? activeView.dataset.viewId : 'root';
+          const expectedHash = viewId === 'root' ? '#/' : `#/view/${viewId}`;
+
+          if (window.location.hash !== expectedHash && !(viewId === 'root' && !window.location.hash)) {
+            // If user physically swiped back one level and history state matches, prefer history.back()
+            // or update history cleanly so address bar stays in sync
+            if (clampedIndex < previousIndex && window.history.state && window.history.state.depth === previousIndex) {
+              isHandlingPopState = true;
+              window.history.back();
+              setTimeout(() => {
+                isHandlingPopState = false;
+              }, 60);
+            } else {
+              window.history.replaceState(
+                { depth: clampedIndex, viewId },
+                '',
+                viewId === 'root' ? window.location.pathname + window.location.search : expectedHash
+              );
+            }
+          }
+        }
+      }
+
+      function scrollToViewIndex(targetIndex, behavior, onSettled) {
+        const width = stackEl.clientWidth || window.innerWidth;
+        const targetLeft = targetIndex * width;
+        const actualBehavior = behavior || getScrollBehavior();
+
+        clearTimeout(programmaticScrollTimer);
+
+        if (actualBehavior === 'auto' || Math.abs(stackEl.scrollLeft - targetLeft) < 2) {
+          isProgrammaticScroll = false;
+          stackEl.scrollTo({ left: targetLeft, behavior: 'auto' });
+          updateVisualTransforms();
+          if (onSettled) onSettled();
+          return;
+        }
+
+        isProgrammaticScroll = true;
+        stackEl.scrollTo({ left: targetLeft, behavior: 'smooth' });
+
+        const checkArrival = () => {
+          if (Math.abs(stackEl.scrollLeft - targetLeft) <= 2) {
+            isProgrammaticScroll = false;
+            clearTimeout(programmaticScrollTimer);
+            updateVisualTransforms();
+            if (onSettled) onSettled();
+          }
+        };
+
+        programmaticScrollTimer = setTimeout(() => {
+          isProgrammaticScroll = false;
+          stackEl.scrollTo({ left: targetLeft, behavior: 'auto' });
+          updateVisualTransforms();
+          if (onSettled) onSettled();
+        }, 550);
+
+        stackEl.addEventListener('scrollend', function onScrollEnd() {
+          stackEl.removeEventListener('scrollend', onScrollEnd);
+          checkArrival();
+        }, { once: true });
+      }
+
+      function drillDown(viewId, triggerEl, options = {}) {
+        const { pushState = true, animate = true } = options;
+        const views = getViews();
+
+        // First prune any leftover views beyond activeIndex
+        for (let i = views.length - 1; i > activeIndex; i--) {
+          views[i].remove();
+        }
+
+        const nextDepth = activeIndex + 1;
+        if (triggerEl) {
+          triggerElementByDepth.set(nextDepth, triggerEl);
+        }
+
+        const newView = createDetailViewElement(viewId, nextDepth);
+        stackEl.appendChild(newView);
+        updateVisualTransforms();
+
+        if (pushState) {
+          const hash = `#/view/${viewId}`;
+          window.history.pushState({ depth: nextDepth, viewId: String(viewId), stack: getViews().slice(1).map(v => v.dataset.viewId) }, '', hash);
+        }
+
+        const behavior = animate ? getScrollBehavior() : 'auto';
+        scrollToViewIndex(nextDepth, behavior, () => {
+          finalizeSettledIndex(nextDepth, { syncHistory: false, manageFocus: true });
+        });
+      }
+
+      function navigateBack(options = {}) {
+        const { viaHistory = false } = options;
+        if (activeIndex <= 0) return;
+
+        if (!viaHistory && window.history.state && window.history.state.depth > 0) {
+          window.history.back();
+          return;
+        }
+
+        const targetIndex = Math.max(0, activeIndex - 1);
+        scrollToViewIndex(targetIndex, getScrollBehavior(), () => {
+          finalizeSettledIndex(targetIndex, { syncHistory: !viaHistory, manageFocus: true });
+        });
+      }
+
+      // Click handler for .item links and .back buttons
+      stackEl.addEventListener('click', (event) => {
+        const backBtn = event.target.closest('.back');
+        if (backBtn) {
+          event.preventDefault();
+          navigateBack({ viaHistory: false });
+          return;
+        }
+
+        const itemLink = event.target.closest('.item');
+        if (itemLink) {
+          // Preserve modifier clicks and non-primary clicks so users can open in a new tab/window
+          if (
+            event.defaultPrevented ||
+            event.button !== 0 ||
+            event.metaKey ||
+            event.ctrlKey ||
+            event.shiftKey ||
+            event.altKey
+          ) {
+            return;
+          }
+
+          event.preventDefault();
+          const viewId = itemLink.dataset.viewId || parseHash(itemLink.getAttribute('href'))[0] || '1';
+          drillDown(viewId, itemLink, { pushState: true, animate: true });
+        }
+      });
+
+      // Scroll listener for real-time parallax/dimming/shadow and swipe-to-back detection
+      stackEl.addEventListener('scroll', () => {
+        if (!rafPending) {
+          rafPending = true;
+          requestAnimationFrame(() => {
+            rafPending = false;
+            updateVisualTransforms();
+          });
+        }
+
+        if (isProgrammaticScroll) return;
+
+        clearTimeout(scrollIdleTimer);
+        scrollIdleTimer = setTimeout(() => {
+          if (isProgrammaticScroll) return;
+          const width = stackEl.clientWidth || window.innerWidth || 1;
+          const settledIndex = Math.round(stackEl.scrollLeft / width);
+          if (settledIndex !== activeIndex) {
+            finalizeSettledIndex(settledIndex, { syncHistory: true, manageFocus: true });
+          } else {
+            updateVisualTransforms();
+          }
+        }, 110);
+      }, { passive: true });
+
+      stackEl.addEventListener('scrollend', () => {
+        if (isProgrammaticScroll) return;
+        clearTimeout(scrollIdleTimer);
+        const width = stackEl.clientWidth || window.innerWidth || 1;
+        const settledIndex = Math.round(stackEl.scrollLeft / width);
+        if (settledIndex !== activeIndex) {
+          finalizeSettledIndex(settledIndex, { syncHistory: true, manageFocus: true });
+        } else {
+          updateVisualTransforms();
+        }
+      });
+
+      // Sync with browser back/forward buttons & hash changes
+      function syncStackWithLocation(animate = true) {
+        const targetViewIds = parseHash(window.location.hash);
+        const currentViews = getViews();
+        const currentViewIds = currentViews.slice(1).map(v => v.dataset.viewId);
+
+        // Case 1: Navigating back to a shallower depth that already exists in the DOM stack
+        if (
+          targetViewIds.length < currentViewIds.length &&
+          targetViewIds.every((id, idx) => currentViewIds[idx] === id)
+        ) {
+          const targetIndex = targetViewIds.length;
+          const behavior = animate ? getScrollBehavior() : 'auto';
+          scrollToViewIndex(targetIndex, behavior, () => {
+            finalizeSettledIndex(targetIndex, { syncHistory: false, manageFocus: true });
+          });
+          return;
+        }
+
+        // Case 2: Drilling forward one level via browser forward button
+        if (
+          targetViewIds.length === currentViewIds.length + 1 &&
+          currentViewIds.every((id, idx) => targetViewIds[idx] === id)
+        ) {
+          const nextViewId = targetViewIds[targetViewIds.length - 1];
+          const rootTrigger = currentViews[activeIndex]?.querySelector(`.item[data-view-id="${nextViewId}"]`);
+          drillDown(nextViewId, rootTrigger, { pushState: false, animate });
+          return;
+        }
+
+        // Case 3: Deep link or arbitrary history jump -> reconstruct stack with root behind it
+        for (let i = currentViews.length - 1; i >= 1; i--) {
+          currentViews[i].remove();
+        }
+
+        targetViewIds.forEach((id, idx) => {
+          const depth = idx + 1;
+          const prevView = getViews()[idx];
+          const trigger = prevView ? prevView.querySelector(`.item[data-view-id="${id}"]`) : null;
+          if (trigger) {
+            triggerElementByDepth.set(depth, trigger);
+          }
+          const viewEl = createDetailViewElement(id, depth);
+          stackEl.appendChild(viewEl);
+        });
+
+        const finalIndex = targetViewIds.length;
+        activeIndex = finalIndex;
+        scrollToViewIndex(finalIndex, 'auto', () => {
+          updateVisualTransforms();
+          if (finalIndex > 0) {
+            const topView = getViews()[finalIndex];
+            const backBtn = topView ? topView.querySelector('.back') : null;
+            if (backBtn) focusSafely(backBtn);
+          }
+        });
+      }
+
+      window.addEventListener('popstate', () => {
+        if (isHandlingPopState) return;
+        isHandlingPopState = true;
+        syncStackWithLocation(true);
+        setTimeout(() => {
+          isHandlingPopState = false;
+        }, 60);
+      });
+
+      window.addEventListener('resize', () => {
+        const width = stackEl.clientWidth || window.innerWidth;
+        stackEl.scrollTo({ left: activeIndex * width, behavior: 'auto' });
+        updateVisualTransforms();
+      });
+
+      // Initialize on page load: handle deep linking (e.g., opening #/view/1 directly)
+      // If opened at a deep link, synthesize root homepage in history behind the deep-linked view
+      // so clicking the Back button or browser back navigates to the synthesized homepage.
+      function initRouting() {
+        const initialViewIds = parseHash(window.location.hash);
+
+        if (initialViewIds.length === 0) {
+          window.history.replaceState({ depth: 0, viewId: 'root', stack: [] }, '', window.location.pathname + window.location.search + window.location.hash);
+          updateVisualTransforms();
+          return;
+        }
+
+        // Synthesize the root state first, then push each deep-linked view state
+        const baseUrl = window.location.pathname + window.location.search;
+        window.history.replaceState({ depth: 0, viewId: 'root', stack: [] }, '', baseUrl + '#/');
+
+        initialViewIds.forEach((id, idx) => {
+          const depth = idx + 1;
+          const prevView = getViews()[idx];
+          const trigger = prevView ? prevView.querySelector(`.item[data-view-id="${id}"]`) : null;
+          if (trigger) {
+            triggerElementByDepth.set(depth, trigger);
+          }
+          const viewEl = createDetailViewElement(id, depth);
+          stackEl.appendChild(viewEl);
+          window.history.pushState(
+            { depth, viewId: String(id), stack: initialViewIds.slice(0, depth) },
+            '',
+            `#/view/${id}`
+          );
+        });
+
+        activeIndex = initialViewIds.length;
+        // Immediately position scroll at the deep-linked view without transition
+        const width = stackEl.clientWidth || window.innerWidth;
+        stackEl.scrollTo({ left: activeIndex * width, behavior: 'auto' });
+        updateVisualTransforms();
+
+        const topView = getViews()[activeIndex];
+        const backBtn = topView ? topView.querySelector('.back') : null;
+        if (backBtn) {
+          focusSafely(backBtn);
+        }
+      }
+
+      initRouting();
+    })();
+  </script>
