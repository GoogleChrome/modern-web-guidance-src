+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+
+      let conditionalAbortController = null;
+
+      function bufferToBase64url(buffer) {
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary)
+          .replace(/\+/g, '-')
+          .replace(/\//g, '_')
+          .replace(/=+$/, '');
+      }
+
+      function base64urlToBuffer(base64url) {
+        if (base64url instanceof ArrayBuffer) return base64url;
+        if (ArrayBuffer.isView(base64url)) return base64url.buffer;
+        if (typeof base64url !== 'string') {
+          return new Uint8Array(32).buffer;
+        }
+        const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+        const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+        const rawData = atob(base64);
+        const outputArray = new Uint8Array(rawData.length);
+        for (let i = 0; i < rawData.length; ++i) {
+          outputArray[i] = rawData.charCodeAt(i);
+        }
+        return outputArray.buffer;
+      }
+
+      async function getPublicKeyOptions() {
+        try {
+          const res = await fetch('/api/login/options');
+          if (res.ok) {
+            const data = await res.json();
+            const opts = data.publicKey || data;
+            return {
+              ...opts,
+              challenge: base64urlToBuffer(opts.challenge),
+              allowCredentials: opts.allowCredentials
+                ? opts.allowCredentials.map((cred) => ({
+                    ...cred,
+                    id: base64urlToBuffer(cred.id),
+                  }))
+                : undefined,
+            };
+          }
+        } catch (err) {
+          // Fallback to locally generated challenge if options endpoint is not mocked
+        }
+
+        const challenge = new Uint8Array(32);
+        if (window.crypto && window.crypto.getRandomValues) {
+          window.crypto.getRandomValues(challenge);
+        }
+        return {
+          challenge: challenge.buffer,
+          rpId: window.location.hostname || 'localhost',
+          userVerification: 'preferred',
+          timeout: 60000,
+        };
+      }
+
+      function serializeCredential(credential) {
+        if (credential && typeof credential.toJSON === 'function') {
+          return credential.toJSON();
+        }
+        const response = credential.response || {};
+        return {
+          id: credential.id,
+          rawId: credential.rawId ? bufferToBase64url(credential.rawId) : credential.id,
+          type: credential.type || 'public-key',
+          authenticatorAttachment: credential.authenticatorAttachment || null,
+          response: {
+            clientDataJSON: response.clientDataJSON
+              ? bufferToBase64url(response.clientDataJSON)
+              : null,
+            authenticatorData: response.authenticatorData
+              ? bufferToBase64url(response.authenticatorData)
+              : null,
+            signature: response.signature
+              ? bufferToBase64url(response.signature)
+              : null,
+            userHandle: response.userHandle
+              ? bufferToBase64url(response.userHandle)
+              : null,
+          },
+          clientExtensionResults:
+            typeof credential.getClientExtensionResults === 'function'
+              ? credential.getClientExtensionResults()
+              : {},
+        };
+      }
+
+      async function verifyCredential(credential) {
+        if (!credential) return;
+        const payload = serializeCredential(credential);
+        try {
+          const response = await fetch('/api/login/verify', {
+            method: 'POST',
+            headers: {
+              'Content-Type': 'application/json',
+            },
+            body: JSON.stringify(payload),
+          });
+
+          if (response.ok) {
+            let message = 'Authenticated successfully!';
+            try {
+              const data = await response.json();
+              if (data && (data.message || data.status)) {
+                message = data.message || data.status;
+              }
+            } catch (_) {
+              // Ignore non-JSON body
+            }
+            authStatus.textContent = message;
+          } else {
+            authStatus.textContent = 'Authentication verification failed.';
+          }
+        } catch (err) {
+          authStatus.textContent = 'Error verifying credential.';
+        }
+      }
+
+      async function startConditionalPasskeyAuth() {
+        if (
+          !window.PublicKeyCredential ||
+          !navigator.credentials ||
+          !navigator.credentials.get
+        ) {
+          return;
+        }
+
+        if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+          try {
+            const available = await PublicKeyCredential.isConditionalMediationAvailable();
+            if (!available) return;
+          } catch (_) {
+            // Proceed if check fails
+          }
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+        }
+        conditionalAbortController = new AbortController();
+
+        try {
+          const publicKey = await getPublicKeyOptions();
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey,
+            signal: conditionalAbortController.signal,
+          });
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (err && err.name !== 'AbortError') {
+            console.warn('Conditional passkey request ended:', err);
+          }
+        }
+      }
+
+      async function handleExplicitPasskeySignIn() {
+        if (!navigator.credentials || !navigator.credentials.get) {
+          authStatus.textContent = 'Passkeys are not supported in this browser.';
+          return;
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+          conditionalAbortController = null;
+        }
+
+        try {
+          const publicKey = await getPublicKeyOptions();
+          publicKey.userVerification = 'required';
+          const credential = await navigator.credentials.get({
+            publicKey,
+          });
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          authStatus.textContent = 'Authentication failed or cancelled.';
+        }
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', handleExplicitPasskeySignIn);
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', () => {
+          if (!conditionalAbortController) {
+            startConditionalPasskeyAuth();
+          }
+        });
+      }
+
+      startConditionalPasskeyAuth();
+    })();
+  </script>
+
