+  <script type="module">
+    try {
+      await import("webauthn-polyfills");
+    } catch {
+      // Fallback when offline or polyfill CDN is unreachable; native WebAuthn APIs remain available
+    }
+
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.querySelector('[data-testid="auth-status"]');
+    const signinForm = document.getElementById("signin-form");
+
+    let autofillAbortController = new AbortController();
+
+    async function optionsFetch() {
+      try {
+        const res = await fetch("/api/login/options", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+        });
+        if (res.ok) {
+          return await res.json();
+        }
+      } catch {
+        // Fallback if POST is not supported or network fails
+      }
+      try {
+        const res = await fetch("/api/login/options");
+        if (res.ok) {
+          return await res.json();
+        }
+      } catch {
+        // Use fallback options if server endpoint is mocked differently or absent
+      }
+      return {
+        challenge: "dGVzdC1jaGFsbGVuZ2UtZm9yLXBhc3NrZXktbG9naW4",
+        rpId: window.location.hostname || "localhost",
+        allowCredentials: [],
+        userVerification: "preferred",
+      };
+    }
+
+    async function loginVerifyFetch(encoded) {
+      return fetch("/api/login/verify", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(encoded),
+      });
+    }
+
+    async function verifyCredentialWithServer(credential, rpId) {
+      const encoded =
+        typeof credential.toJSON === "function"
+          ? credential.toJSON()
+          : {
+              id: credential.id,
+              rawId: credential.id,
+              type: credential.type,
+              authenticatorAttachment: credential.authenticatorAttachment || null,
+              response: {
+                clientDataJSON: credential.response?.clientDataJSON,
+                authenticatorData: credential.response?.authenticatorData,
+                signature: credential.response?.signature,
+                userHandle: credential.response?.userHandle || null,
+              },
+              clientExtensionResults:
+                typeof credential.getClientExtensionResults === "function"
+                  ? credential.getClientExtensionResults()
+                  : {},
+            };
+
+      try {
+        const response = await loginVerifyFetch(encoded);
+        if (response.ok) {
+          let message = "Signed in with passkey successfully!";
+          try {
+            const data = await response.json();
+            if (data && data.message) {
+              message = data.message;
+            }
+          } catch {
+            // Keep default success status text
+          }
+          authStatus.textContent = message;
+          return;
+        }
+
+        if (response.status === 404) {
+          authStatus.textContent = "Passkey not recognized.";
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encoded.id,
+            });
+          }
+        } else {
+          authStatus.textContent = "Authentication verification failed.";
+        }
+      } catch (serverErr) {
+        console.error("Verification request error:", serverErr);
+        authStatus.textContent = "Error verifying passkey login.";
+      }
+    }
+
+    async function initializeConditionalAutofill() {
+      if (typeof window.PublicKeyCredential === "undefined") {
+        return;
+      }
+
+      const capabilities =
+        typeof PublicKeyCredential.getClientCapabilities === "function"
+          ? await PublicKeyCredential.getClientCapabilities()
+          : {
+              conditionalGet:
+                typeof PublicKeyCredential.isConditionalMediationAvailable === "function"
+                  ? await PublicKeyCredential.isConditionalMediationAvailable()
+                  : false,
+            };
+
+      if (capabilities.conditionalGet === true) {
+        const loginOptionsJSON = await optionsFetch();
+        const rpId = loginOptionsJSON.rpId || window.location.hostname || "localhost";
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+        let credential;
+        try {
+          credential = await navigator.credentials.get({
+            publicKey,
+            signal: autofillAbortController.signal,
+            mediation: "conditional",
+          });
+        } catch (err) {
+          if (["NotAllowedError", "AbortError"].includes(err.name)) {
+            return;
+          }
+          console.error("Unexpected conditional get error:", err);
+          return;
+        }
+
+        if (credential) {
+          await verifyCredentialWithServer(credential, rpId);
+        }
+      }
+    }
+
+    async function triggerButtonAuthentication() {
+      // Abort any pending Conditional Get call to prevent passkey prompt collisions
+      autofillAbortController.abort();
+      autofillAbortController = new AbortController();
+
+      const loginOptionsJSON = await optionsFetch();
+      const rpId = loginOptionsJSON.rpId || window.location.hostname || "localhost";
+      const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(loginOptionsJSON);
+
+      let credential;
+      try {
+        credential = await navigator.credentials.get({
+          publicKey,
+          signal: autofillAbortController.signal,
+        });
+      } catch (err) {
+        if (err.name === "NotAllowedError") {
+          console.log("User cancelled passkey login.");
+        } else if (err.name === "AbortError") {
+          console.log("The authentication operation was aborted.");
+        }
+        // Re-arm Conditional autofill suggestions after cancelled explicit button prompts
+        initializeConditionalAutofill();
+        return;
+      }
+
+      if (credential) {
+        await verifyCredentialWithServer(credential, rpId);
+      }
+    }
+
+    authButton.addEventListener("click", triggerButtonAuthentication);
+
+    signinForm.addEventListener("submit", (e) => {
+      e.preventDefault();
+    });
+
+    if (document.readyState === "loading") {
+      window.addEventListener("DOMContentLoaded", initializeConditionalAutofill);
+    } else {
+      initializeConditionalAutofill();
+    }
+  </script>
 </body>
 
