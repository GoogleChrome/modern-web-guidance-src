+  <script type="module">
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') {
+        return globalThis.Temporal;
+      }
+      const mod = await import('https://esm.sh/@js-temporal/polyfill');
+      const TemporalObj = mod.Temporal || (mod.default && mod.default.Temporal);
+      if (TemporalObj) {
+        globalThis.Temporal = TemporalObj;
+      }
+      return globalThis.Temporal;
+    }
+
+    const CALENDARS = [
+      {
+        id: 'islamic-umalqura',
+        prefix: 'islamic',
+        formatOptions: {
+          calendar: 'islamic-umalqura',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      },
+      {
+        id: 'hebrew',
+        prefix: 'hebrew',
+        formatOptions: {
+          calendar: 'hebrew',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      },
+      {
+        id: 'japanese',
+        prefix: 'japanese',
+        formatOptions: {
+          calendar: 'japanese',
+          era: 'long',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      }
+    ];
+
+    function getTimelineStatus(Temporal, selectedIsoDate, todayIsoDate) {
+      const cmp = Temporal.PlainDate.compare(selectedIsoDate, todayIsoDate);
+      if (cmp < 0) return 'Past';
+      if (cmp > 0) return 'Future';
+      return 'Today';
+    }
+
+    function renderCalendars(Temporal, isoDateString) {
+      if (!isoDateString) return;
+
+      let selectedIsoDate;
+      try {
+        selectedIsoDate = Temporal.PlainDate.from(isoDateString);
+      } catch (err) {
+        return;
+      }
+
+      const todayIsoDate = Temporal.Now.plainDateISO();
+      const timelineStatus = getTimelineStatus(Temporal, selectedIsoDate, todayIsoDate);
+
+      for (const calConfig of CALENDARS) {
+        const convertedDate = selectedIsoDate.withCalendar(calConfig.id);
+
+        // 1. Formatted localized date (with era names for Japanese)
+        const formattedDateStr = convertedDate.toLocaleString('en-US', calConfig.formatOptions);
+        const dateEl = document.getElementById(`${calConfig.prefix}-date`);
+        if (dateEl) {
+          dateEl.textContent = formattedDateStr;
+        }
+
+        // 2. Converted year, numeric month, and unique stable month code
+        const yearEl = document.getElementById(`${calConfig.prefix}-year`);
+        if (yearEl) {
+          yearEl.textContent = String(convertedDate.year);
+        }
+
+        const monthEl = document.getElementById(`${calConfig.prefix}-month`);
+        if (monthEl) {
+          monthEl.textContent = String(convertedDate.month);
+        }
+
+        const monthCodeEl = document.getElementById(`${calConfig.prefix}-month-code`);
+        if (monthCodeEl) {
+          monthCodeEl.textContent = convertedDate.monthCode;
+        }
+
+        // 3. Total number of months in that specific calendar year
+        const monthsInYearEl = document.getElementById(`${calConfig.prefix}-months-in-year`);
+        if (monthsInYearEl) {
+          monthsInYearEl.textContent = String(convertedDate.monthsInYear);
+        }
+
+        // 4. Timeline label comparing selected date against current date ('Past', 'Future', or 'Today')
+        const timelineEl = document.getElementById(`${calConfig.prefix}-timeline`);
+        if (timelineEl) {
+          timelineEl.textContent = timelineStatus;
+          timelineEl.className = `timeline-badge timeline-${timelineStatus}`;
+        }
+
+        // 5. Month breakdown showing each month's code and how many days are in that month for that specific year
+        const breakdownEl = document.getElementById(`${calConfig.prefix}-months-breakdown`);
+        if (breakdownEl) {
+          breakdownEl.innerHTML = '';
+          const totalMonths = convertedDate.monthsInYear;
+          for (let m = 1; m <= totalMonths; m++) {
+            const monthDate = convertedDate.with({ month: m, day: 1 });
+            const li = document.createElement('li');
+            const isCurrentMonth = monthDate.monthCode === convertedDate.monthCode;
+            li.className = `month-chip${isCurrentMonth ? ' active-month' : ''}`;
+            li.dataset.monthCode = monthDate.monthCode;
+            li.dataset.daysInMonth = String(monthDate.daysInMonth);
+            li.innerHTML = `<span class="m-code">${monthDate.monthCode}</span><span class="m-sep">: </span><span class="m-days">${monthDate.daysInMonth} days</span>`;
+            breakdownEl.appendChild(li);
+          }
+        }
+      }
+    }
+
+    async function initCalendarTool() {
+      const Temporal = await ensureTemporal();
+      const dateInput = document.getElementById('calendar-date-input');
+      if (!dateInput || !Temporal) return;
+
+      const todayIso = Temporal.Now.plainDateISO().toString();
+      if (!dateInput.value) {
+        dateInput.value = todayIso;
+      }
+
+      renderCalendars(Temporal, dateInput.value);
+
+      const handleUpdate = (e) => {
+        renderCalendars(Temporal, e.target.value);
+      };
+
+      dateInput.addEventListener('input', handleUpdate);
+      dateInput.addEventListener('change', handleUpdate);
+    }
+
+    initCalendarTool();
+  </script>
 </body>
 
