+  <script type="module">
+    /**
+     * Progressive Enhancement Fallback for Temporal API
+     */
+    async function getTemporal() {
+      if (typeof Temporal !== 'undefined') {
+        return Temporal;
+      }
+
+      try {
+        const module = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+        return module.Temporal;
+      } catch (e) {
+        console.error('Failed to load Temporal polyfill:', e);
+        throw e;
+      }
+    }
+
+    /**
+     * Helper to verify if the target calendar system is supported by the environment
+     */
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    const CALENDAR_CONFIGS = [
+      {
+        id: 'islamic-umalqura',
+        locale: 'en-u-ca-islamic-umalqura',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric'
+        }
+      },
+      {
+        id: 'hebrew',
+        locale: 'en-u-ca-hebrew',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric'
+        }
+      },
+      {
+        id: 'japanese',
+        locale: 'en-u-ca-japanese',
+        formatOptions: {
+          era: 'long',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      }
+    ];
+
+    async function initCalendarExplorer() {
+      const TemporalAPI = await getTemporal();
+      const dateInput = document.getElementById('calendar-date-input');
+      const todayIso = TemporalAPI.Now.plainDateISO();
+
+      if (!dateInput.value) {
+        dateInput.value = todayIso.toString();
+      }
+
+      function renderCalendars(isoString) {
+        if (!isoString) return;
+
+        let selectedIsoDate;
+        try {
+          selectedIsoDate = TemporalAPI.PlainDate.from(isoString);
+        } catch {
+          return;
+        }
+
+        const currentIsoDate = TemporalAPI.Now.plainDateISO();
+
+        for (const config of CALENDAR_CONFIGS) {
+          const card = document.querySelector(`.calendar-card[data-calendar="${config.id}"]`);
+          if (!card) continue;
+
+          const supported = isCalendarSupported(config.id);
+          const targetDate = supported
+            ? selectedIsoDate.withCalendar(config.id)
+            : selectedIsoDate;
+
+          const todayInCalendar = supported
+            ? currentIsoDate.withCalendar(config.id)
+            : currentIsoDate;
+
+          // 1. Formatted localized date (including era names for Japanese)
+          const formattedDateEl = card.querySelector('[data-field="formatted-date"]');
+          formattedDateEl.textContent = targetDate.toLocaleString(config.locale, config.formatOptions);
+
+          // 2. Converted year, numeric month, and unique stable monthCode
+          card.querySelector('[data-field="year"]').textContent = String(targetDate.year);
+          card.querySelector('[data-field="month"]').textContent = String(targetDate.month);
+          card.querySelector('[data-field="month-code"]').textContent = targetDate.monthCode;
+
+          // 3. Total number of months in that specific calendar year
+          card.querySelector('[data-field="months-in-year"]').textContent = String(targetDate.monthsInYear);
+
+          // 4. Timeline label comparing selected date against current date via Temporal.PlainDate.compare()
+          const comparison = TemporalAPI.PlainDate.compare(targetDate, todayInCalendar);
+          const relativeLabel = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+          const timelineEl = card.querySelector('[data-field="timeline"]');
+          timelineEl.textContent = relativeLabel;
+          timelineEl.dataset.timeline = relativeLabel;
+
+          // 5. Month breakdown iterating dynamically up to monthsInYear
+          const breakdownList = card.querySelector('[data-field="month-breakdown"]');
+          breakdownList.replaceChildren();
+
+          const baseYearDate = targetDate.with({ day: 1 });
+          for (let m = 1; m <= targetDate.monthsInYear; m++) {
+            const monthDate = baseYearDate.with({ month: m });
+            const li = document.createElement('li');
+            li.className = 'month-chip';
+            if (monthDate.monthCode === targetDate.monthCode) {
+              li.classList.add('current-month');
+            }
+
+            const codeSpan = document.createElement('span');
+            codeSpan.className = 'month-code';
+            codeSpan.textContent = monthDate.monthCode;
+
+            const daysSpan = document.createElement('span');
+            daysSpan.textContent = `${monthDate.daysInMonth}d`;
+
+            li.append(codeSpan, daysSpan);
+            breakdownList.appendChild(li);
+          }
+        }
+      }
+
+      dateInput.addEventListener('input', (event) => {
+        renderCalendars(event.target.value);
+      });
+      dateInput.addEventListener('change', (event) => {
+        renderCalendars(event.target.value);
+      });
+
+      renderCalendars(dateInput.value);
+    }
+
+    initCalendarExplorer();
+  </script>
 </body>
 
