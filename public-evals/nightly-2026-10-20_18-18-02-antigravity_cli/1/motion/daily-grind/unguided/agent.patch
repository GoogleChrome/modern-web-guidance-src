+  <script>
+    (function () {
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const nav = document.getElementById('main-nav');
+      const heroBg = document.getElementById('hero-bg');
+      const revealElements = document.querySelectorAll('.reveal');
+
+      // 1. Scroll-triggered Entrance Animations via IntersectionObserver
+      if ('IntersectionObserver' in window && !prefersReducedMotion.matches) {
+        const revealObserver = new IntersectionObserver((entries, observer) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              entry.target.classList.add('is-visible');
+              observer.unobserve(entry.target);
+            }
+          });
+        }, {
+          threshold: 0.14,
+          rootMargin: '0px 0px -40px 0px'
+        });
+
+        revealElements.forEach((el) => revealObserver.observe(el));
+      } else {
+        revealElements.forEach((el) => el.classList.add('is-visible'));
+      }
+
+      // Listen for runtime changes to prefers-reduced-motion
+      prefersReducedMotion.addEventListener('change', (event) => {
+        if (event.matches) {
+          revealElements.forEach((el) => el.classList.add('is-visible'));
+          if (heroBg) heroBg.style.transform = 'none';
+        }
+      });
+
+      // 2. Smooth rAF Scroll Handler for Sticky Navbar & Subtle Hero Parallax
+      let ticking = false;
+      function updateOnScroll() {
+        const scrollY = window.scrollY;
+        if (nav) {
+          nav.classList.toggle('scrolled', scrollY > 24);
+        }
+        if (heroBg && !prefersReducedMotion.matches && scrollY < 700) {
+          heroBg.style.transform = `translate3d(0, ${scrollY * 0.18}px, 0) scale3d(1, 1, 1)`;
+        }
+        ticking = false;
+      }
+
+      window.addEventListener('scroll', () => {
+        if (!ticking) {
+          window.requestAnimationFrame(updateOnScroll);
+          ticking = true;
+        }
+      }, { passive: true });
+
+      // 3. Interactive Category Filtering with Smooth Transitions
+      const filterTabs = document.querySelectorAll('.filter-tab');
+      const cards = document.querySelectorAll('#menu-grid .card');
+
+      filterTabs.forEach((tab) => {
+        tab.addEventListener('click', () => {
+          const filter = tab.getAttribute('data-filter');
+
+          filterTabs.forEach((t) => {
+            t.classList.toggle('active', t === tab);
+            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
+          });
+
+          const delay = prefersReducedMotion.matches ? 0 : 180;
+
+          cards.forEach((card) => {
+            const matches = filter === 'all' || card.getAttribute('data-category') === filter;
+            if (matches) {
+              card.classList.remove('is-hidden');
+              requestAnimationFrame(() => {
+                card.classList.remove('is-filtering-out');
+              });
+            } else {
+              card.classList.add('is-filtering-out');
+              setTimeout(() => {
+                if (card.classList.contains('is-filtering-out')) {
+                  card.classList.add('is-hidden');
+                }
+              }, delay);
+            }
+          });
+        });
+      });
+
+      // 4. Micro-interaction for Quick Add & Cart Badge Bounce
+      const quickAddButtons = document.querySelectorAll('.quick-add-btn');
+      const cartCountEl = document.getElementById('cart-count');
+      const toastEl = document.getElementById('toast');
+      const toastMessageEl = document.getElementById('toast-message');
+      let cartCount = 0;
+      let toastTimer = null;
+
+      quickAddButtons.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          const itemName = btn.getAttribute('data-item') || 'Coffee';
+          cartCount += 1;
+          if (cartCountEl) {
+            cartCountEl.textContent = String(cartCount);
+            if (!prefersReducedMotion.matches) {
+              cartCountEl.classList.remove('bump');
+              void cartCountEl.offsetWidth;
+              cartCountEl.classList.add('bump');
+              setTimeout(() => cartCountEl.classList.remove('bump'), 320);
+            }
+          }
+
+          if (toastEl && toastMessageEl) {
+            toastMessageEl.textContent = `Added ${itemName} to your bag`;
+            toastEl.classList.add('is-visible');
+            clearTimeout(toastTimer);
+            toastTimer = setTimeout(() => {
+              toastEl.classList.remove('is-visible');
+            }, 2600);
+          }
+        });
+      });
+    })();
+  </script>
