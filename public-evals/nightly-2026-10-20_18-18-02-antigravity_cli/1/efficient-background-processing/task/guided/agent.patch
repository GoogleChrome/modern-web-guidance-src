+  <script>
+    (() => {
+      const roastingWidget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const ctx = canvas.getContext('2d');
+      const tempValueEl = document.getElementById('roast-temp-value');
+
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let currentTemp = 385.0;
+
+      const beans = Array.from({ length: 36 }, () => ({
+        x: Math.random() * canvas.width,
+        y: Math.random() * canvas.height,
+        vx: (Math.random() - 0.5) * 3.5,
+        vy: (Math.random() - 0.5) * 3.5,
+        rx: 9 + Math.random() * 4,
+        ry: 6 + Math.random() * 2.5,
+        angle: Math.random() * Math.PI * 2,
+        vAngle: (Math.random() - 0.5) * 0.08,
+        roastShade: Math.floor(Math.random() * 30)
+      }));
+
+      function renderBeans() {
+        ctx.fillStyle = '#2b1b17';
+        ctx.fillRect(0, 0, canvas.width, canvas.height);
+
+        for (const bean of beans) {
+          bean.x += bean.vx;
+          bean.y += bean.vy;
+          bean.angle += bean.vAngle;
+
+          if (bean.x < bean.rx || bean.x > canvas.width - bean.rx) bean.vx *= -1;
+          if (bean.y < bean.ry || bean.y > canvas.height - bean.ry) bean.vy *= -1;
+
+          ctx.save();
+          ctx.translate(bean.x, bean.y);
+          ctx.rotate(bean.angle);
+
+          ctx.beginPath();
+          ctx.ellipse(0, 0, bean.rx, bean.ry, 0, 0, Math.PI * 2);
+          ctx.fillStyle = `rgb(${95 - bean.roastShade}, ${58 - bean.roastShade}, ${42 - bean.roastShade})`;
+          ctx.fill();
+          ctx.lineWidth = 1.5;
+          ctx.strokeStyle = '#3e2723';
+          ctx.stroke();
+
+          ctx.beginPath();
+          ctx.moveTo(-bean.rx * 0.65, 0);
+          ctx.quadraticCurveTo(0, bean.ry * 0.35, bean.rx * 0.65, 0);
+          ctx.strokeStyle = '#1b0f0d';
+          ctx.lineWidth = 1.5;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+
+        animationFrameId = requestAnimationFrame(renderBeans);
+      }
+
+      function updateTemperature() {
+        const delta = (Math.random() - 0.45) * 1.8;
+        currentTemp = Math.min(445, Math.max(370, currentTemp + delta));
+        tempValueEl.textContent = `${currentTemp.toFixed(1)}°F`;
+      }
+
+      function startSimulation() {
+        if (animationFrameId === null) {
+          animationFrameId = requestAnimationFrame(renderBeans);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 800);
+        }
+      }
+
+      function stopSimulation() {
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      roastingWidget.addEventListener('contentvisibilityautostatechange', (event) => {
+        if (event.skipped) {
+          stopSimulation();
+        } else {
+          startSimulation();
+        }
+      });
+
+      const isSupported = 'contentVisibility' in document.documentElement.style;
+
+      if (!isSupported) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              startSimulation();
+            } else {
+              stopSimulation();
+            }
+          });
+        }, {
+          rootMargin: '200px'
+        });
+
+        observer.observe(roastingWidget);
+      }
+    })();
+  </script>
 </body>
 
