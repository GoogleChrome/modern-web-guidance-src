+  <script>
+    // Fallback for browsers that don't support scroll-driven animations
+    if (!CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)')) {
+      const nav = document.querySelector('nav');
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+      const initialHeight = 120;
+      const finalHeight = 60;
+      const scrollDistance = 60;
+
+      const updateNav = () => {
+        if (prefersReducedMotion.matches) {
+          nav.style.height = '';
+          nav.style.boxShadow = '';
+          return;
+        }
+
+        const scrollY = window.scrollY;
+        const scrollPercent = Math.min(1, Math.max(0, scrollY / scrollDistance));
+        const newHeight = initialHeight - (initialHeight - finalHeight) * scrollPercent;
+
+        nav.style.height = `${newHeight}px`;
+        nav.style.boxShadow = scrollPercent > 0
+          ? `0 4px 10px rgba(0, 0, 0, ${0.25 * scrollPercent})`
+          : 'none';
+      };
+
+      window.addEventListener('scroll', updateNav, { passive: true });
+      updateNav();
+    }
+  </script>
+
