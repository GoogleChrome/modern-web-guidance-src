+  <script>
+    function fitPosterLockup() {
+      const heading = document.querySelector('.hero h1');
+      if (!heading) return;
+      const lines = heading.querySelectorAll('.poster-line');
+      const targetWidth = heading.getBoundingClientRect().width;
+      if (!targetWidth) return;
+
+      const canvas = fitPosterLockup.canvas || (fitPosterLockup.canvas = document.createElement('canvas'));
+      const ctx = canvas.getContext('2d');
+      const computed = window.getComputedStyle(heading);
+      const fontWeight = computed.fontWeight || '900';
+      const fontFamily = computed.fontFamily || 'sans-serif';
+
+      lines.forEach((line) => {
+        const text = (line.textContent || '').trim().toUpperCase();
+        if (!text) return;
+
+        // First pass: measure glyph advance width at 100px reference size
+        ctx.font = `${fontWeight} 100px ${fontFamily}`;
+        const metrics = ctx.measureText(text);
+        const measuredWidth = metrics.width || 1;
+        let fontSize = (targetWidth / measuredWidth) * 100;
+
+        // Second pass: refine using actual DOM inline layout measurement
+        line.style.display = 'inline-block';
+        line.style.width = 'auto';
+        line.style.fontSize = `${fontSize}px`;
+        const domWidth = line.getBoundingClientRect().width;
+        if (domWidth > 0) {
+          fontSize = fontSize * (targetWidth / domWidth);
+          line.style.fontSize = `${fontSize}px`;
+        }
+        line.style.display = 'block';
+        line.style.width = 'fit-content';
+      });
+    }
+
+    fitPosterLockup();
+    window.addEventListener('resize', fitPosterLockup);
+    if (window.ResizeObserver) {
+      const ro = new ResizeObserver(fitPosterLockup);
+      const heading = document.querySelector('.hero h1');
+      if (heading) ro.observe(heading);
+    }
+    if (document.fonts && document.fonts.ready) {
+      document.fonts.ready.then(fitPosterLockup);
+    }
+  </script>
+
