diff --git a/js/transition-setup.js b/js/transition-setup.js
new file mode 100644
index 0000000..46d24b6
--- /dev/null
+++ b/js/transition-setup.js
@@ -0,0 +1,156 @@
+// Critical layout & cross-document view transition setup script.
+// Loaded with blocking="render" in <head> so critical page state is applied
+// and the pagereveal listener is registered before the transition snapshot is taken.
+
+(function initCriticalPageState() {
+  // Apply stored theme/layout preferences before first render / transition snapshot
+  const savedTheme = localStorage.getItem('theme') || 'light';
+  document.documentElement.dataset.theme = savedTheme;
+})();
+
+const ROUTE_ORDER = [
+  '/',
+  '/menu',
+  '/menu/seasonal',
+  '/menu/espresso',
+  '/menu/cold-brew',
+  '/locations',
+  '/rewards',
+  '/account',
+  '/order-online',
+  '/about',
+  '/careers',
+  '/contact',
+  '/privacy-policy',
+  '/logout',
+];
+
+function normalizePath(pathname) {
+  const clean = pathname.replace(/\/index\.html$/, '').replace(/\/+$/, '');
+  return clean || '/';
+}
+
+function getProductSlug(pathname) {
+  const normalized = normalizePath(pathname);
+  if (normalized.startsWith('/menu/')) {
+    return normalized.slice('/menu/'.length);
+  }
+  return null;
+}
+
+window.addEventListener('pagereveal', async (event) => {
+  if (!event.viewTransition) return;
+
+  const fromEntry = window.navigation?.activation?.from;
+  const currentEntry = window.navigation?.activation?.entry;
+  if (!fromEntry) return;
+
+  const fromPath = normalizePath(new URL(fromEntry.url).pathname);
+  const toPath = normalizePath(
+    currentEntry ? new URL(currentEntry.url).pathname : window.location.pathname
+  );
+
+  // Set directional transition type when supported
+  const fromIdx = ROUTE_ORDER.indexOf(fromPath);
+  const toIdx = ROUTE_ORDER.indexOf(toPath);
+  if (event.viewTransition.types && fromIdx !== -1 && toIdx !== -1 && fromIdx !== toIdx) {
+    event.viewTransition.types.add(toIdx > fromIdx ? 'forwards' : 'backwards');
+  }
+
+  // Context-dependent morph between a menu/featured card and a product detail page
+  const fromSlug = getProductSlug(fromPath);
+  const toSlug = getProductSlug(toPath);
+  const activeSlug = toSlug || fromSlug;
+
+  const temporaryElements = [];
+
+  if (activeSlug) {
+    if (toSlug) {
+      // Navigating to a detail page: morph hero title and product image
+      const detailHeading = document.querySelector('#hero h1');
+      const detailImage = document.querySelector('[data-product-image]');
+      if (detailHeading) {
+        detailHeading.style.viewTransitionName = 'featured-product-title';
+        temporaryElements.push(detailHeading);
+      }
+      if (detailImage) {
+        detailImage.style.viewTransitionName = 'featured-product-image';
+        temporaryElements.push(detailImage);
+      }
+    } else if (fromSlug) {
+      // Navigating back from a detail page to a listing page: morph back to the matching card
+      const card = document.querySelector(`[data-product="${fromSlug}"]`);
+      if (card) {
+        const cardTitle = card.querySelector('h3');
+        const cardImage = card.querySelector('img');
+        if (cardTitle) {
+          cardTitle.style.viewTransitionName = 'featured-product-title';
+          temporaryElements.push(cardTitle);
+        }
+        if (cardImage) {
+          cardImage.style.viewTransitionName = 'featured-product-image';
+          temporaryElements.push(cardImage);
+        }
+      }
+    }
+  }
+
+  if (temporaryElements.length > 0) {
+    try {
+      await event.viewTransition.ready;
+    } catch (error) {
+      // Skipped view transitions reject `ready` with InvalidStateError.
+      if (error.name !== 'InvalidStateError') {
+        throw error;
+      }
+    } finally {
+      try {
+        await event.viewTransition.finished;
+      } catch {
+        // Ignore finished errors on skipped transitions
+      }
+      for (const el of temporaryElements) {
+        el.style.viewTransitionName = '';
+      }
+    }
+  }
+});
+
+// Outgoing page handler: when navigating from a listing page to a product detail page,
+// assign matching view-transition-names to the clicked product card before the old-state snapshot.
+window.addEventListener('pageswap', async (event) => {
+  if (!event.viewTransition) return;
+
+  const targetEntry = event.activation?.entry;
+  if (!targetEntry) return;
+
+  const targetPath = normalizePath(new URL(targetEntry.url).pathname);
+  const targetSlug = getProductSlug(targetPath);
+
+  if (targetSlug) {
+    const card = document.querySelector(`[data-product="${targetSlug}"]`);
+    if (card) {
+      const cardTitle = card.querySelector('h3');
+      const cardImage = card.querySelector('img');
+      const temporaryElements = [];
+      if (cardTitle) {
+        cardTitle.style.viewTransitionName = 'featured-product-title';
+        temporaryElements.push(cardTitle);
+      }
+      if (cardImage) {
+        cardImage.style.viewTransitionName = 'featured-product-image';
+        temporaryElements.push(cardImage);
+      }
+      try {
+        await event.viewTransition.finished;
+      } catch {
+        // Ignore errors on skipped transitions
+      } finally {
+        for (const el of temporaryElements) {
+          el.style.viewTransitionName = '';
+        }
+      }
+    }
+  }
+});
+
