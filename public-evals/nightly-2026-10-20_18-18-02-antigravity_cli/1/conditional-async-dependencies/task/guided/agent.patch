diff --git a/conditionally-load-polyfills.js b/conditionally-load-polyfills.js
new file mode 100644
--- a/conditionally-load-polyfills.js
+++ b/conditionally-load-polyfills.js
@@ -0,0 +1,11 @@
+// Feature detect 'popover' on HTMLElement.prototype and 'commandForElement' on HTMLButtonElement.prototype.
+// Use top-level await to pause downstream module execution only when a polyfill is needed.
+if (!('popover' in HTMLElement.prototype)) {
+  await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+}
+
+if (!('commandForElement' in HTMLButtonElement.prototype)) {
+  await import('https://esm.run/invokers-polyfill');
+}
+
+export const polyfillsLoaded = true;
