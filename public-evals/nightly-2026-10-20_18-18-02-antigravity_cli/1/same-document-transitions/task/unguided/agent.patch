+  <script>
+    const favoritesData = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        image: 'https://images.unsplash.com/photo-1541167760496-1628856ab772?auto=format&fit=crop&w=1200&q=80',
+        price: '$5.50',
+        calories: '180 kcal',
+        description: 'Creamy oat milk with a hint of pure Vermont maple syrup. Crafted with our signature double-shot espresso and topped with a delicate dusting of organic cinnamon.'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1200&q=80',
+        price: '$3.75',
+        calories: '15 kcal',
+        description: 'Bold, smokey, and perfect for a morning boost. Roasted in small batches to bring out deep dark chocolate notes and a rich, velvety crema.'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=1200&q=80',
+        price: '$4.75',
+        calories: '10 kcal',
+        description: 'Steeped in cool filtered water for 18 hours for maximum smoothness and naturally sweet flavor with zero bitterness. Served over artisan ice.'
+      }
+    };
+
+    const listPage = document.getElementById('list-page');
+    const detailPage = document.getElementById('detail-page');
+    const listHeading = document.getElementById('list-heading');
+    const heroEl = document.getElementById('hero');
+    const titleEl = document.getElementById('title');
+    const priceEl = document.getElementById('detail-price');
+    const caloriesEl = document.getElementById('detail-calories');
+    const descriptionEl = document.getElementById('detail-description');
+    const backButton = document.getElementById('back-button');
+    const thumbnails = document.querySelectorAll('.thumbnail');
+
+    let activeThumbnail = null;
+
+    function prefersReducedMotion() {
+      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    }
+
+    function cleanupTransitionProperties(elements) {
+      elements.forEach((el) => {
+        if (!el) return;
+        el.style.viewTransitionName = '';
+        el.classList.remove('transitioning-hero', 'transitioning-title');
+        if (el.getAttribute('style') === '') {
+          el.removeAttribute('style');
+        }
+      });
+    }
+
+    function populateDetail(itemId) {
+      const data = favoritesData[itemId];
+      if (!data) return;
+      heroEl.src = data.image;
+      heroEl.alt = data.title;
+      titleEl.textContent = data.title;
+      priceEl.textContent = data.price;
+      caloriesEl.textContent = data.calories;
+      descriptionEl.textContent = data.description;
+    }
+
+    async function showDetailView(thumbnail) {
+      const itemId = thumbnail.dataset.id;
+      activeThumbnail = thumbnail;
+
+      const thumbTitle = thumbnail.querySelector('.title');
+
+      const updateDOM = () => {
+        populateDetail(itemId);
+        listPage.hidden = true;
+        detailPage.hidden = false;
+      };
+
+      if (!document.startViewTransition || prefersReducedMotion()) {
+        updateDOM();
+        titleEl.focus();
+        return;
+      }
+
+      // Set temporary transition names/classes on clicked thumbnail elements
+      thumbnail.style.viewTransitionName = 'hero';
+      thumbnail.classList.add('transitioning-hero');
+      thumbTitle.style.viewTransitionName = 'title';
+      thumbTitle.classList.add('transitioning-title');
+
+      const transition = document.startViewTransition(() => {
+        // Move transition names/classes from thumbnail to detail view elements
+        cleanupTransitionProperties([thumbnail, thumbTitle]);
+
+        heroEl.style.viewTransitionName = 'hero';
+        heroEl.classList.add('transitioning-hero');
+        titleEl.style.viewTransitionName = 'title';
+        titleEl.classList.add('transitioning-title');
+
+        updateDOM();
+      });
+
+      try {
+        await transition.finished;
+      } finally {
+        cleanupTransitionProperties([thumbnail, thumbTitle, heroEl, titleEl]);
+        titleEl.focus();
+      }
+    }
+
+    async function showListView() {
+      const targetThumbnail = activeThumbnail || document.querySelector('.thumbnail');
+      const thumbTitle = targetThumbnail ? targetThumbnail.querySelector('.title') : null;
+
+      const updateDOM = () => {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+      };
+
+      if (!document.startViewTransition || prefersReducedMotion() || !targetThumbnail) {
+        updateDOM();
+        listHeading.focus();
+        return;
+      }
+
+      // Set temporary transition names/classes on detail elements before morphing back
+      heroEl.style.viewTransitionName = 'hero';
+      heroEl.classList.add('transitioning-hero');
+      titleEl.style.viewTransitionName = 'title';
+      titleEl.classList.add('transitioning-title');
+
+      const transition = document.startViewTransition(() => {
+        // Move transition names/classes from detail elements back to the active thumbnail
+        cleanupTransitionProperties([heroEl, titleEl]);
+
+        targetThumbnail.style.viewTransitionName = 'hero';
+        targetThumbnail.classList.add('transitioning-hero');
+        if (thumbTitle) {
+          thumbTitle.style.viewTransitionName = 'title';
+          thumbTitle.classList.add('transitioning-title');
+        }
+
+        updateDOM();
+      });
+
+      try {
+        await transition.finished;
+      } finally {
+        cleanupTransitionProperties([heroEl, titleEl, targetThumbnail, thumbTitle]);
+        listHeading.focus();
+      }
+    }
+
+    thumbnails.forEach((thumbnail) => {
+      thumbnail.addEventListener('click', (e) => {
+        e.preventDefault();
+        showDetailView(thumbnail);
+      });
+
+      thumbnail.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter' || e.key === ' ') {
+          e.preventDefault();
+          showDetailView(thumbnail);
+        }
+      });
+    });
+
+    backButton.addEventListener('click', (e) => {
+      e.preventDefault();
+      showListView();
+    });
+  </script>
+
 </body>
 
 </html>
