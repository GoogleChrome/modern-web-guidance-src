+      view-transition-name: title;
+    }
+
+    /* Prevent image stretching across different aspect ratios during morph */
+    ::view-transition-old(hero),
+    ::view-transition-new(hero) {
+      animation: none;
+      mix-blend-mode: normal;
+      height: 100%;
+      overflow: clip;
+      object-fit: cover;
+    }
+
+    /* Prevent title text from weirdly stretching by preserving natural aspect ratio */
+    ::view-transition-old(title),
+    ::view-transition-new(title) {
+      width: auto;
+      height: 100%;
+      object-fit: contain;
+      transform-origin: left center;
+    }
+
+    /* Disable all transition animations when reduced motion is preferred */
+    @media (prefers-reduced-motion: reduce) {
+      *,
+      *::before,
+      *::after,
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation-duration: 0.001ms !important;
+        animation-delay: 0s !important;
+        transition-duration: 0.001ms !important;
+        transition-delay: 0s !important;
+        animation: none !important;
+      }
+    }
