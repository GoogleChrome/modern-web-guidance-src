+  <script>
+    const thumbnails = document.querySelectorAll('.thumbnail');
+    const backBtn = document.getElementById('back-btn');
+    const navMenuLink = document.getElementById('nav-menu-link');
+    const hero = document.getElementById('hero');
+    const heroImg = document.getElementById('hero-img');
+    const detailTitle = document.getElementById('title');
+    const detailPrice = document.getElementById('detail-price');
+    const detailCalories = document.getElementById('detail-calories');
+    const detailDescription = document.getElementById('detail-description');
+    const listHeading = document.getElementById('list-heading');
+
+    function populateDetail(card) {
+      const titleText = card.querySelector('.title')?.textContent || card.dataset.title;
+      const imageSrc = card.dataset.image;
+      const bgColor = getComputedStyle(card).backgroundColor;
+
+      hero.style.backgroundColor = bgColor;
+      if (imageSrc) {
+        hero.style.backgroundImage = `url('${imageSrc}')`;
+        heroImg.src = imageSrc;
+        heroImg.alt = titleText;
+      }
+      detailTitle.textContent = titleText;
+      detailPrice.textContent = card.dataset.price || '';
+      detailCalories.textContent = card.dataset.calories || '';
+      detailDescription.textContent = card.dataset.description || '';
+      document.title = `${titleText} | The Daily Grind`;
+    }
+
+    function goFromListToDetail(e) {
+      const card = e.currentTarget;
+
+      // Clean up any leftover selected states before marking the active thumbnail
+      document.querySelectorAll('.selected').forEach((el) => el.classList.remove('selected'));
+      card.classList.add('selected');
+      populateDetail(card);
+
+      // Progressive enhancement fallback if View Transitions API is unsupported
+      if (!document.startViewTransition) {
+        document.body.classList.add('detail');
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.add('detail');
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList() {
+      if (!document.startViewTransition) {
+        document.body.classList.remove('detail');
+        document.title = 'The Daily Grind | Artisanal Coffee';
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+        listHeading?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.remove('detail');
+        document.title = 'The Daily Grind | Artisanal Coffee';
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+      });
+    }
+
+    thumbnails.forEach((card) => {
+      card.addEventListener('click', goFromListToDetail);
+      card.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter') {
+          goFromListToDetail(e);
+        }
+        if (e.key === ' ') {
+          e.preventDefault();
+        }
+      });
+      card.addEventListener('keyup', (e) => {
+        if (e.key === ' ') {
+          goFromListToDetail(e);
+        }
+      });
+    });
+
+    backBtn.addEventListener('click', goFromDetailToList);
+    navMenuLink.addEventListener('click', (e) => {
+      if (document.body.classList.contains('detail')) {
+        e.preventDefault();
+        goFromDetailToList();
+      }
+    });
+  </script>
 </body>
 
