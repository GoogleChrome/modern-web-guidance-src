+    for: 'pour', of: 'de', with: 'avec', by: 'par', from: 'de', as: 'comme', is: 'est', are: 'sont', was: 'était',
+    were: 'étaient', be: 'être', have: 'avoir', has: 'a', had: 'avait', not: 'ne pas', this: 'ce', that: 'cela',
+    they: 'ils', their: 'leur', we: 'nous', our: 'notre', new: 'nouveau', more: 'plus', all: 'tout',
