+import React, { useState, useRef } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import { TARGET_LANGUAGES, translateBatch, getLanguageName } from '../utils/translate';
+
+interface OriginalNodeState {
+  element: HTMLElement;
+  originalText: string;
+}
+
+export default function ArticleTranslator() {
+  const [targetLang, setTargetLang] = useState('es');
+  const [activeLang, setActiveLang] = useState<string | null>(null);
+  const [isTranslating, setIsTranslating] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const originalNodesRef = useRef<OriginalNodeState[] | null>(null);
+
+  const collectTranslatableElements = (): HTMLElement[] => {
+    const articleEl = document.querySelector('article');
+    if (!articleEl) return [];
+
+    const selectors = [
+      '[data-translatable="title"]',
+      '[data-translatable="summary"]',
+      '[data-translatable="caption"]',
+      '[data-translatable="body"] p',
+      '[data-translatable="body"] h2',
+      '[data-translatable="body"] h3',
+      '[data-translatable="body"] h4',
+      '[data-translatable="body"] li',
+      '[data-translatable="body"] blockquote',
+    ];
+
+    const elements = Array.from(
+      articleEl.querySelectorAll<HTMLElement>(selectors.join(', '))
+    );
+    return elements.filter((el) => (el.textContent || '').trim().length > 0);
+  };
+
+  const handleTranslateArticle = async (langToUse = targetLang) => {
+    if (langToUse === 'en' && activeLang === null) {
+      return;
+    }
+
+    if (langToUse === 'en') {
+      handleRestoreOriginal();
+      return;
+    }
+
+    setIsTranslating(true);
+    setError(null);
+
+    try {
+      if (!originalNodesRef.current) {
+        const elements = collectTranslatableElements();
+        originalNodesRef.current = elements.map((el) => ({
+          element: el,
+          originalText: el.textContent || '',
+        }));
+      }
+
+      const nodes = originalNodesRef.current;
+      if (!nodes || nodes.length === 0) {
+        setIsTranslating(false);
+        return;
+      }
+
+      const sourceTexts = nodes.map((n) => n.originalText);
+      const { translatedTexts } = await translateBatch(sourceTexts, 'en', langToUse);
+
+      nodes.forEach((node, idx) => {
+        if (translatedTexts[idx]) {
+          node.element.textContent = translatedTexts[idx];
+        }
+      });
+
+      setActiveLang(langToUse);
+    } catch (err) {
+      console.error('Failed to translate article:', err);
+      setError('Failed to translate article content.');
+    } finally {
+      setIsTranslating(false);
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    if (originalNodesRef.current) {
+      originalNodesRef.current.forEach(({ element, originalText }) => {
+        element.textContent = originalText;
+      });
+    }
+    setActiveLang(null);
+    setError(null);
+  };
+
+  return (
+    <div className="flex flex-wrap items-center gap-2 text-xs">
+      <div className="flex items-center space-x-1.5 bg-gray-50 border border-gray-200 rounded-md px-2.5 py-1.5">
+        <LanguageIcon className="h-4 w-4 text-gray-600 shrink-0" />
+        <label htmlFor="article-lang-select" className="font-semibold text-gray-700">
+          Translate article:
+        </label>
+        <select
+          id="article-lang-select"
+          value={targetLang}
+          onChange={(e) => {
+            const nextLang = e.target.value;
+            setTargetLang(nextLang);
+            if (activeLang) {
+              handleTranslateArticle(nextLang);
+            }
+          }}
+          disabled={isTranslating}
+          className="bg-white border border-gray-300 rounded px-2 py-1 text-xs text-gray-800 focus:ring-2 focus:ring-amber-400 focus:border-transparent"
+        >
+          {TARGET_LANGUAGES.map((lang) => (
+            <option key={lang.code} value={lang.code}>
+              {lang.name} ({lang.nativeName})
+            </option>
+          ))}
+        </select>
+
+        <button
+          type="button"
+          onClick={() => handleTranslateArticle(targetLang)}
+          disabled={isTranslating}
+          className="bg-gray-800 hover:bg-gray-700 disabled:bg-gray-400 text-white font-semibold px-2.5 py-1 rounded transition-colors cursor-pointer"
+        >
+          {isTranslating ? 'Translating...' : 'Translate'}
+        </button>
+
+        {activeLang && (
+          <button
+            type="button"
+            onClick={handleRestoreOriginal}
+            disabled={isTranslating}
+            className="text-gray-600 hover:text-amber-600 font-semibold px-1.5 py-1 underline cursor-pointer"
+          >
+            Show Original
+          </button>
+        )}
+      </div>
+
+      {activeLang && !isTranslating && (
+        <span className="text-xs text-amber-700 bg-amber-50 border border-amber-200 px-2 py-1 rounded">
+          Translated to {getLanguageName(activeLang)}
+        </span>
+      )}
+
+      {error && <span className="text-xs text-red-600">{error}</span>}
+    </div>
+  );
+}
