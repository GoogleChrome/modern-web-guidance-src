+import React, { useState } from 'react';
+import { LanguageIcon } from '@heroicons/react/24/outline';
+import TranslateFlyout from './TranslateFlyout';
+
+export default function TranslateButton() {
+  const [isOpen, setIsOpen] = useState(false);
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={() => setIsOpen(true)}
+        title="Translate text"
+        aria-label="Translate text"
+        className="text-gray-700 hover:text-amber-400 flex items-center space-x-1 p-1 transition-colors cursor-pointer"
+      >
+        <LanguageIcon className="h-6 w-6" />
+        <span className="hidden sm:inline text-xs font-semibold">Translate</span>
+      </button>
+      {isOpen && <TranslateFlyout onClose={() => setIsOpen(false)} />}
+    </>
+  );
+}
