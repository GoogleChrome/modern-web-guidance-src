+    modern: 'moderne', public: 'public', report: 'rapport', article: 'article', news: 'actualités',
+  },
+  de: {
+    the: 'die', a: 'ein', an: 'ein', and: 'und', or: 'oder', but: 'aber', in: 'in', on: 'auf', at: 'bei', to: 'zu',
+    for: 'für', of: 'von', with: 'mit', by: 'von', from: 'aus', as: 'als', is: 'ist', are: 'sind', was: 'war',
+    were: 'waren', be: 'sein', have: 'haben', has: 'hat', had: 'hatte', not: 'nicht', this: 'dies', that: 'das',
+    they: 'sie', their: 'ihr', we: 'wir', our: 'unser', new: 'neu', more: 'mehr', all: 'alle',
+    life: 'Leben', world: 'Welt', city: 'Stadt', people: 'Menschen', time: 'Zeit', year: 'Jahr',
