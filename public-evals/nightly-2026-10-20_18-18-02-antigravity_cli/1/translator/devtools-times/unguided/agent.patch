@@ -0,0 +1,328 @@
+import React, { useState, useEffect } from 'react';
+import {
+  LANGUAGES,
+  TARGET_LANGUAGES,
+  translateText,
+  getLanguageName,
+} from '../utils/translate';
+
+interface Props {
+  onClose: () => void;
+  initialText?: string;
+}
+
+const SAMPLE_PHRASES = [
+  'The Silent Architects of Earth',
+  'Breaking news from around the world',
+  'Good morning, how are you?',
+];
+
+export default function TranslateFlyout({ onClose, initialText = '' }: Props) {
+  const [sourceText, setSourceText] = useState(initialText);
+  const [translatedText, setTranslatedText] = useState('');
+  const [sourceLang, setSourceLang] = useState('auto');
+  const [targetLang, setTargetLang] = useState('es');
+  const [detectedLanguage, setDetectedLanguage] = useState<string | null>(null);
+  const [isLoading, setIsLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [copied, setCopied] = useState(false);
+
+  useEffect(() => {
+    const handleKeyDown = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') {
+        onClose();
+      }
+    };
+    window.addEventListener('keydown', handleKeyDown);
+
+    // Pre-populate with any currently selected text on the page if initialText wasn't passed
+    if (!initialText && typeof window !== 'undefined') {
+      const selected = window.getSelection()?.toString().trim();
+      if (selected) {
+        setSourceText(selected);
+      }
+    }
+
+    return () => {
+      window.removeEventListener('keydown', handleKeyDown);
+    };
+  }, [onClose, initialText]);
+
+  const handleTranslate = async (
+    textToTranslate = sourceText,
+    fromLang = sourceLang,
+    toLang = targetLang
+  ) => {
+    if (!textToTranslate.trim()) {
+      setTranslatedText('');
+      setDetectedLanguage(null);
+      return;
+    }
+
+    setIsLoading(true);
+    setError(null);
+    try {
+      const result = await translateText(textToTranslate, fromLang, toLang);
+      setTranslatedText(result.translatedText);
+      setDetectedLanguage(result.detectedLanguage || null);
+    } catch (err) {
+      console.error('Translation error:', err);
+      setError('Unable to translate text right now. Please try again.');
+    } finally {
+      setIsLoading(false);
+    }
+  };
+
+  const handleSwapLanguages = () => {
+    const effectiveSource =
+      sourceLang === 'auto' ? detectedLanguage || 'en' : sourceLang;
+    const nextSource = targetLang;
+    const nextTarget = effectiveSource === targetLang ? 'en' : effectiveSource;
+
+    setSourceLang(nextSource);
+    setTargetLang(nextTarget);
+
+    if (translatedText) {
+      setSourceText(translatedText);
+      setTranslatedText(sourceText);
+      handleTranslate(translatedText, nextSource, nextTarget);
+    }
+  };
+
+  const handleCopy = async () => {
+    if (!translatedText) return;
+    try {
+      await navigator.clipboard.writeText(translatedText);
+      setCopied(true);
+      setTimeout(() => setCopied(false), 2000);
+    } catch {
+      // Ignore clipboard failures
+    }
+  };
+
+  return (
+    <div
+      className="fixed inset-0 bg-white/30 backdrop-blur-sm z-[99999] flex justify-center items-start p-4 pt-[12vh]"
+      onClick={onClose}
+      role="dialog"
+      aria-modal="true"
+      aria-label="Text Translator"
+    >
+      <div
+        className="bg-white shadow-xl border border-gray-200 w-full max-w-3xl relative rounded-md"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <button
+          onClick={onClose}
+          aria-label="Close translator"
+          className="absolute -top-2 -right-2 bg-white rounded-full p-1 shadow-md text-gray-500 hover:text-amber-400 hover:scale-110 transition-transform z-10"
+        >
+          <svg
+            xmlns="http://www.w3.org/2000/svg"
+            className="h-6 w-6"
+            fill="none"
+            viewBox="0 0 24 24"
+            stroke="currentColor"
+            strokeWidth={2}
+          >
+            <path
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              d="M6 18L18 6M6 6l12 12"
+            />
+          </svg>
+        </button>
+
+        <div className="p-6">
+          <div className="flex items-center justify-between border-b border-gray-200 pb-4 mb-4">
+            <div>
+              <h3 className="text-lg font-bold text-gray-900">
+                Translate Text
+              </h3>
+              <p className="text-xs text-gray-500">
+                Translate phrases, headlines, or paragraphs between languages
+              </p>
+            </div>
+            <div className="flex flex-wrap gap-1.5">
+              {SAMPLE_PHRASES.map((phrase) => (
+                <button
+                  key={phrase}
+                  type="button"
+                  onClick={() => {
+                    setSourceText(phrase);
+                    handleTranslate(phrase, sourceLang, targetLang);
+                  }}
+                  className="text-xs bg-gray-100 hover:bg-amber-50 hover:text-amber-700 text-gray-600 px-2 py-1 rounded border border-gray-200 transition-colors"
+                >
+                  “{phrase.slice(0, 22)}…”
+                </button>
+              ))}
+            </div>
+          </div>
+
+          {/* Language Selector Bar */}
+          <div className="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] gap-3 items-center mb-4">
+            <div>
+              <label
+                htmlFor="translate-source-lang"
+                className="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1"
+              >
+                From
+              </label>
+              <select
+                id="translate-source-lang"
+                value={sourceLang}
+                onChange={(e) => {
+                  const next = e.target.value;
+                  setSourceLang(next);
+                  if (sourceText.trim()) {
+                    handleTranslate(sourceText, next, targetLang);
+                  }
+                }}
+                className="w-full p-2 text-sm border border-gray-300 rounded-md bg-white text-gray-800 focus:ring-2 focus:ring-amber-400 focus:border-transparent"
+              >
+                {LANGUAGES.map((lang) => (
+                  <option key={lang.code} value={lang.code}>
+                    {lang.name} ({lang.nativeName})
+                  </option>
+                ))}
+              </select>
+            </div>
+
+            <div className="flex justify-center sm:pt-5">
+              <button
+                type="button"
+                onClick={handleSwapLanguages}
+                title="Swap languages"
+                aria-label="Swap languages"
+                className="p-2 rounded-full border border-gray-300 text-gray-600 hover:text-amber-500 hover:border-amber-400 transition-colors"
+              >
+                <svg
+                  xmlns="http://www.w3.org/2000/svg"
+                  className="h-4 w-4"
+                  fill="none"
+                  viewBox="0 0 24 24"
+                  stroke="currentColor"
+                  strokeWidth={2}
+                >
+                  <path
+                    strokeLinecap="round"
+                    strokeLinejoin="round"
+                    d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"
+                  />
+                </svg>
+              </button>
+            </div>
+
+            <div>
+              <label
+                htmlFor="translate-target-lang"
+                className="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1"
+              >
+                To
+              </label>
+              <select
+                id="translate-target-lang"
+                value={targetLang}
+                onChange={(e) => {
+                  const next = e.target.value;
+                  setTargetLang(next);
+                  if (sourceText.trim()) {
+                    handleTranslate(sourceText, sourceLang, next);
+                  }
+                }}
+                className="w-full p-2 text-sm border border-gray-300 rounded-md bg-white text-gray-800 focus:ring-2 focus:ring-amber-400 focus:border-transparent"
+              >
+                {TARGET_LANGUAGES.map((lang) => (
+                  <option key={lang.code} value={lang.code}>
+                    {lang.name} ({lang.nativeName})
+                  </option>
+                ))}
+              </select>
+            </div>
+          </div>
+
+          {/* Text Areas */}
+          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
+            <div className="flex flex-col">
+              <div className="relative flex-grow">
+                <textarea
+                  rows={5}
+                  value={sourceText}
+                  onChange={(e) => setSourceText(e.target.value)}
+                  placeholder="Enter or paste text to translate..."
+                  className="w-full h-full p-3 text-sm border border-gray-300 rounded-md focus:ring-2 focus:ring-amber-400 focus:border-transparent resize-none"
+                  autoFocus
+                />
+                {sourceText && (
+                  <button
+                    type="button"
+                    onClick={() => {
+                      setSourceText('');
+                      setTranslatedText('');
+                      setDetectedLanguage(null);
+                    }}
+                    className="absolute top-2 right-2 text-xs text-gray-400 hover:text-gray-600 px-1.5 py-0.5 rounded bg-white/80"
+                  >
+                    Clear
+                  </button>
+                )}
+              </div>
+              <div className="flex justify-between items-center mt-1.5 text-xs text-gray-500">
+                <span>
+                  {sourceLang === 'auto' && detectedLanguage
+                    ? `Detected: ${getLanguageName(detectedLanguage)}`
+                    : `${sourceText.length} characters`}
+                </span>
+              </div>
+            </div>
+
+            <div className="flex flex-col">
+              <div className="relative flex-grow bg-gray-50 border border-gray-200 rounded-md p-3 min-h-[132px] text-sm text-gray-800 whitespace-pre-wrap">
+                {isLoading ? (
+                  <div className="flex items-center space-x-2 text-gray-500 h-full justify-center">
+                    <div className="w-4 h-4 border-2 border-amber-400 border-t-transparent rounded-full animate-spin" />
+                    <span>Translating...</span>
+                  </div>
+                ) : translatedText ? (
+                  translatedText
+                ) : (
+                  <span className="text-gray-400">
+                    Translation will appear here...
+                  </span>
+                )}
+              </div>
+              <div className="flex justify-between items-center mt-1.5 text-xs text-gray-500">
+                <span>{getLanguageName(targetLang)}</span>
+                {translatedText && (
+                  <button
+                    type="button"
+                    onClick={handleCopy}
+                    className="text-gray-600 hover:text-amber-600 font-semibold"
+                  >
+                    {copied ? 'Copied!' : 'Copy translation'}
+                  </button>
+                )}
+              </div>
+            </div>
+          </div>
+
+          {error && (
+            <p className="text-xs text-red-600 mt-3">{error}</p>
+          )}
+
+          <div className="mt-4 flex justify-end space-x-3">
+            <button
+              type="button"
+              onClick={() => handleTranslate()}
+              disabled={isLoading || !sourceText.trim()}
+              className="bg-gray-900 hover:bg-gray-700 disabled:bg-gray-300 text-white text-xs font-semibold py-2.5 px-5 rounded transition-colors cursor-pointer"
+            >
+              {isLoading ? 'Translating...' : 'Translate'}
+            </button>
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+}
