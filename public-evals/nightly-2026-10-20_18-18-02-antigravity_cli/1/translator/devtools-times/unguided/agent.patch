+
+function detectLanguage(text: string): string {
+  const sample = text.trim();
+  if (!sample) return 'en';
+  if (/[\u3040-\u30ff]/.test(sample)) return 'ja';
+  if (/[\uac00-\ud7af]/.test(sample)) return 'ko';
+  if (/[\u4e00-\u9fff]/.test(sample)) return 'zh';
+  if (/[\u0600-\u06ff]/.test(sample)) return 'ar';
+  if (/[\u0900-\u097f]/.test(sample)) return 'hi';
+
+  const lower = sample.toLowerCase();
+  if (/\b(el|la|los|las|una|para|con|por|qué|está|gracias|hola)\b/.test(lower)) return 'es';
+  if (/\b(le|la|les|des|une|pour|avec|dans|est|sont|merci|bonjour)\b/.test(lower)) return 'fr';
+  if (/\b(der|die|das|und|ist|sind|nicht|mit|für|auf|danke|hallo)\b/.test(lower)) return 'de';
+  if (/\b(il|lo|gli|sono|con|per|una|della|grazie|ciao)\b/.test(lower)) return 'it';
+  if (/\b(não|são|uma|para|com|pelo|obrigado|olá)\b/.test(lower)) return 'pt';
+  return 'en';
+}
+
+function preserveCase(original: string, translated: string): string {
+  if (!original || !translated) return translated;
+  if (original === original.toUpperCase() && original !== original.toLowerCase()) {
+    return translated.toUpperCase();
+  }
+  if (original[0] === original[0].toUpperCase() && original[0] !== original[0].toLowerCase()) {
+    return translated.charAt(0).toUpperCase() + translated.slice(1);
+  }
+  return translated;
+}
+
+function fallbackTranslateSegment(text: string, sourceLang: string, targetLang: string): string {
+  const trimmed = text.trim();
+  if (!trimmed) return text;
+  if (sourceLang === targetLang) return text;
+
+  const lower = trimmed.toLowerCase();
+
+  // Check direct phrase dictionary when translating to targetLang
+  const targetDict = PHRASE_DICTIONARY[targetLang];
+  if (targetDict && targetDict[lower]) {
+    return preserveCase(trimmed, targetDict[lower]);
+  }
+
+  // Reverse lookup if translating back to English
+  if (targetLang === 'en' && PHRASE_DICTIONARY[sourceLang]) {
+    for (const [enPhrase, foreignPhrase] of Object.entries(PHRASE_DICTIONARY[sourceLang])) {
+      if (foreignPhrase.toLowerCase() === lower) {
+        return preserveCase(trimmed, enPhrase);
+      }
+    }
+  }
+
+  // Replace known multi-word phrases and words if available
+  let result = text;
+  if (targetDict) {
+    const sortedPhrases = Object.keys(targetDict).sort((a, b) => b.length - a.length);
+    for (const phrase of sortedPhrases) {
+      const escaped = phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+      const regex = new RegExp(`\\b${escaped}\\b`, 'gi');
+      result = result.replace(regex, (match) => preserveCase(match, targetDict[phrase]));
+    }
+  }
+
+  const wordMap = WORD_MAP[targetLang];
+  if (wordMap) {
+    result = result.replace(/\b([A-Za-z]+)\b/g, (word) => {
+      const mapped = wordMap[word.toLowerCase()];
+      return mapped ? preserveCase(word, mapped) : word;
+    });
+  }
+
+  if (result !== text) {
+    return result;
+  }
+
+  const langInfo = SUPPORTED_LANGUAGES.find((l) => l.code === targetLang);
+  const tag = langInfo ? langInfo.nativeName : targetLang.toUpperCase();
+  return `[${tag}] ${text}`;
+}
+
+async function translateSingleText(
+  text: string,
+  sourceLang: string,
+  targetLang: string
+): Promise<{ translatedText: string; detectedLanguage: string; provider: string }> {
+  const trimmed = text.trim();
+  const detected = sourceLang === 'auto' ? detectLanguage(trimmed) : sourceLang;
+
+  if (!trimmed || detected === targetLang) {
+    return { translatedText: text, detectedLanguage: detected, provider: 'identity' };
+  }
+
+  // Check exact dictionary match first for instant response
+  const lower = trimmed.toLowerCase();
+  if (PHRASE_DICTIONARY[targetLang]?.[lower]) {
+    return {
+      translatedText: preserveCase(trimmed, PHRASE_DICTIONARY[targetLang][lower]),
+      detectedLanguage: detected,
+      provider: 'dictionary',
+    };
+  }
+
+  // Attempt online translation via Google Translate GTX free endpoint or MyMemory with short timeout
+  try {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 3500);
+    const sl = sourceLang === 'auto' ? 'auto' : sourceLang;
+    const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=${encodeURIComponent(sl)}&tl=${encodeURIComponent(targetLang)}&dt=t&q=${encodeURIComponent(text)}`;
+
+    const res = await fetch(url, {
+      signal: controller.signal,
+      headers: {
+        'User-Agent': 'Mozilla/5.0',
+      },
+    });
+    clearTimeout(timeout);
+
+    if (res.ok) {
+      const data = await res.json();
+      if (Array.isArray(data) && Array.isArray(data[0])) {
+        const translated = data[0]
+          .map((part: any) => (Array.isArray(part) && typeof part[0] === 'string' ? part[0] : ''))
+          .join('');
+        const detectedFromApi = typeof data[2] === 'string' ? data[2] : detected;
+        if (translated) {
+          return {
+            translatedText: translated,
+            detectedLanguage: detectedFromApi,
+            provider: 'neural',
+          };
+        }
+      }
+    }
+  } catch {
+    // Fall back to local translation engine if offline or blocked
+  }
+
+  return {
+    translatedText: fallbackTranslateSegment(text, detected, targetLang),
+    detectedLanguage: detected,
+    provider: 'local-fallback',
+  };
+}
+
+export const GET: APIRoute = async () => {
+  return new Response(
+    JSON.stringify({
+      languages: SUPPORTED_LANGUAGES,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const body = await request.json();
+    const sourceLang = typeof body.sourceLang === 'string' ? body.sourceLang : 'auto';
+    const targetLang = typeof body.targetLang === 'string' ? body.targetLang : 'es';
+
+    // Support both single `text` string and batch `texts` string[]
+    if (Array.isArray(body.texts)) {
+      const texts: string[] = body.texts.map((t: unknown) => (typeof t === 'string' ? t : ''));
+      // Join with a delimiter to minimize external calls when possible, or translate in parallel
+      const results = await Promise.all(
+        texts.map((segment) => translateSingleText(segment, sourceLang, targetLang))
+      );
+
+      return new Response(
+        JSON.stringify({
+          translatedTexts: results.map((r) => r.translatedText),
+          detectedLanguage: results[0]?.detectedLanguage || sourceLang,
+          sourceLang,
+          targetLang,
+          provider: results[0]?.provider || 'local-fallback',
+        }),
+        {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const text = typeof body.text === 'string' ? body.text : '';
+    if (!text.trim()) {
+      return new Response(
+        JSON.stringify({ error: 'Text to translate is required.' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const result = await translateSingleText(text, sourceLang, targetLang);
+
+    return new Response(
+      JSON.stringify({
+        translatedText: result.translatedText,
+        detectedLanguage: result.detectedLanguage,
+        sourceLang,
+        targetLang,
+        provider: result.provider,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (error) {
+    return new Response(
+      JSON.stringify({
+        error: 'Failed to process translation request.',
+      }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
