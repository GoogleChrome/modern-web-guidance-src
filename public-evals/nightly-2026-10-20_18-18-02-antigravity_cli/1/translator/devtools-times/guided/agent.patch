+++ b/src/components/ArticleTranslator.tsx
@@ -0,0 +1,275 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  isTranslatorSupported,
+  checkTranslatorAvailability,
+  createTranslatorWithProgress,
+  type AvailabilityStatus,
+} from '../utils/translator';
+
+interface Props {
+  titleSelector?: string;
+  summarySelector?: string;
+  bodySelector?: string;
+  defaultSourceLanguage?: string;
+}
+
+export default function ArticleTranslator({
+  titleSelector = '[data-translate-title]',
+  summarySelector = '[data-translate-summary]',
+  bodySelector = '[data-translate-body]',
+  defaultSourceLanguage = 'en',
+}: Props) {
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [availability, setAvailability] = useState<AvailabilityStatus>('available');
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [translatedLang, setTranslatedLang] = useState<string | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [apiSupported, setApiSupported] = useState<boolean>(true);
+
+  const originalsRef = useRef<{
+    title: string | null;
+    summary: string | null;
+    paragraphs: { element: HTMLElement; originalText: string }[];
+  } | null>(null);
+
+  useEffect(() => {
+    const supported = isTranslatorSupported();
+    setApiSupported(supported);
+    if (!supported) {
+      setAvailability('unsupported');
+      return;
+    }
+
+    let cancelled = false;
+    checkTranslatorAvailability(defaultSourceLanguage, targetLanguage).then((status) => {
+      if (!cancelled) {
+        setAvailability(status);
+      }
+    });
+
+    return () => {
+      cancelled = true;
+    };
+  }, [defaultSourceLanguage, targetLanguage]);
+
+  const captureOriginals = () => {
+    if (originalsRef.current) return originalsRef.current;
+
+    const titleEl = document.querySelector<HTMLElement>(titleSelector);
+    const summaryEl = document.querySelector<HTMLElement>(summarySelector);
+    const bodyEl = document.querySelector<HTMLElement>(bodySelector);
+
+    const paragraphs: { element: HTMLElement; originalText: string }[] = [];
+    if (bodyEl) {
+      const elements = bodyEl.querySelectorAll<HTMLElement>('p, h2, h3, h4, li, blockquote');
+      elements.forEach((el) => {
+        if (el.innerText.trim()) {
+          paragraphs.push({ element: el, originalText: el.innerText });
+        }
+      });
+    }
+
+    originalsRef.current = {
+      title: titleEl ? titleEl.innerText : null,
+      summary: summaryEl ? summaryEl.innerText : null,
+      paragraphs,
+    };
+
+    return originalsRef.current;
+  };
+
+  const restoreOriginals = () => {
+    if (!originalsRef.current) return;
+
+    const titleEl = document.querySelector<HTMLElement>(titleSelector);
+    const summaryEl = document.querySelector<HTMLElement>(summarySelector);
+    const bodyEl = document.querySelector<HTMLElement>(bodySelector);
+
+    if (titleEl && originalsRef.current.title !== null) {
+      titleEl.innerText = originalsRef.current.title;
+      titleEl.removeAttribute('lang');
+    }
+    if (summaryEl && originalsRef.current.summary !== null) {
+      summaryEl.innerText = originalsRef.current.summary;
+      summaryEl.removeAttribute('lang');
+    }
+    if (bodyEl) {
+      bodyEl.removeAttribute('lang');
+    }
+
+    originalsRef.current.paragraphs.forEach(({ element, originalText }) => {
+      element.innerText = originalText;
+    });
+
+    setIsTranslated(false);
+    setTranslatedLang(null);
+    setErrorMessage(null);
+  };
+
+  const handleTranslate = async () => {
+    setErrorMessage(null);
+
+    if (targetLanguage === defaultSourceLanguage) {
+      restoreOriginals();
+      return;
+    }
+
+    if (!isTranslatorSupported() || availability === 'unsupported' || availability === 'unavailable') {
+      setErrorMessage(
+        'Client-side translation is currently unsupported in this browser or for the selected language pair.'
+      );
+      return;
+    }
+
+    const originals = captureOriginals();
+    setIsTranslating(true);
+    setDownloadProgress(null);
+
+    try {
+      const translator = await createTranslatorWithProgress(
+        defaultSourceLanguage,
+        targetLanguage,
+        (pct) => {
+          setDownloadProgress(pct);
+        }
+      );
+
+      setDownloadProgress(null);
+
+      const titleEl = document.querySelector<HTMLElement>(titleSelector);
+      const summaryEl = document.querySelector<HTMLElement>(summarySelector);
+      const bodyEl = document.querySelector<HTMLElement>(bodySelector);
+
+      if (titleEl && originals.title) {
+        const translatedTitle = await translator.translate(originals.title);
+        titleEl.innerText = translatedTitle;
+        titleEl.setAttribute('lang', targetLanguage);
+      }
+
+      if (summaryEl && originals.summary) {
+        const translatedSummary = await translator.translate(originals.summary);
+        summaryEl.innerText = translatedSummary;
+        summaryEl.setAttribute('lang', targetLanguage);
+      }
+
+      if (bodyEl) {
+        bodyEl.setAttribute('lang', targetLanguage);
+      }
+
+      for (const item of originals.paragraphs) {
+        const translatedParagraph = await translator.translate(item.originalText);
+        item.element.innerText = translatedParagraph;
+      }
+
+      setIsTranslated(true);
+      setTranslatedLang(targetLanguage);
+      setAvailability('available');
+    } catch (err: any) {
+      console.error('Article translation error:', err);
+      setErrorMessage(
+        err?.message || 'Failed to translate article. Please ensure your browser supports the Built-in AI Translator API.'
+      );
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  const targetOptions = SUPPORTED_LANGUAGES.filter((l) => l.code !== defaultSourceLanguage);
+
+  return (
+    <div className="flex flex-col gap-2">
+      <div className="flex flex-wrap items-center gap-2 bg-gray-50 border border-gray-200 rounded-md px-3 py-1.5 text-sm">
+        <svg
+          xmlns="http://www.w3.org/2000/svg"
+          fill="none"
+          viewBox="0 0 24 24"
+          strokeWidth={1.5}
+          stroke="currentColor"
+          className="w-4 h-4 text-gray-600 shrink-0"
+          aria-hidden="true"
+        >
+          <path
+            strokeLinecap="round"
+            strokeLinejoin="round"
+            d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+          />
+        </svg>
+
+        <label htmlFor="article-target-lang" className="text-xs font-semibold text-gray-700">
+          Translate article:
+        </label>
+
+        <select
+          id="article-target-lang"
+          value={targetLanguage}
+          onChange={(e) => setTargetLanguage(e.target.value)}
+          disabled={isTranslating || !apiSupported}
+          className="text-xs bg-white border border-gray-300 rounded px-2 py-1 text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-50"
+        >
+          {targetOptions.map((lang) => (
+            <option key={lang.code} value={lang.code}>
+              {lang.name} ({lang.code})
+            </option>
+          ))}
+        </select>
+
+        <button
+          type="button"
+          onClick={handleTranslate}
+          disabled={isTranslating || !apiSupported || availability === 'unavailable'}
+          title={
+            !apiSupported
+              ? 'Client-side translation is currently unsupported in this browser'
+              : availability === 'unavailable'
+              ? 'Selected language pair is unavailable on this device'
+              : 'Translate article using on-device AI'
+          }
+          className="text-xs font-semibold bg-gray-900 text-white px-2.5 py-1 rounded hover:bg-amber-500 hover:text-gray-900 transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
+        >
+          {isTranslating
+            ? downloadProgress !== null
+              ? `Downloading (${downloadProgress}%)...`
+              : 'Translating...'
+            : isTranslated && translatedLang === targetLanguage
+            ? 'Re-translate'
+            : availability === 'downloadable'
+            ? 'Download & Translate'
+            : 'Translate'}
+        </button>
+
+        {isTranslated && (
+          <button
+            type="button"
+            onClick={restoreOriginals}
+            disabled={isTranslating}
+            className="text-xs font-medium text-gray-600 hover:text-gray-900 underline ml-1 cursor-pointer"
+          >
+            Show original
+          </button>
+        )}
+      </div>
+
+      {!apiSupported && (
+        <p className="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded px-2.5 py-1" role="status">
+          Client-side translation is currently unsupported in this browser (requires Chrome 138+ or Edge 148+ with Built-in AI Translator API).
+        </p>
+      )}
+
+      {apiSupported && availability === 'unavailable' && (
+        <p className="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded px-2.5 py-1" role="status">
+          Translation model for this language pair is unavailable on this device.
+        </p>
+      )}
+
+      {errorMessage && (
+        <p className="text-xs text-red-700 bg-red-50 border border-red-200 rounded px-2.5 py-1" role="alert">
+          {errorMessage}
+        </p>
+      )}
+    </div>
+  );
+}
