@@ -0,0 +1,36 @@
+import React, { useState } from 'react';
+import TranslatorFlyout from './TranslatorFlyout';
+
+export default function TranslatorButton() {
+  const [isOpen, setIsOpen] = useState(false);
+
+  return (
+    <>
+      <button
+        type="button"
+        onClick={() => setIsOpen(true)}
+        aria-label="Translate text"
+        title="Translate text"
+        className="text-gray-700 hover:text-amber-400 p-1 flex items-center space-x-1 cursor-pointer transition-colors"
+      >
+        <svg
+          xmlns="http://www.w3.org/2000/svg"
+          fill="none"
+          viewBox="0 0 24 24"
+          strokeWidth={2}
+          stroke="currentColor"
+          className="w-6 h-6"
+          aria-hidden="true"
+        >
+          <path
+            strokeLinecap="round"
+            strokeLinejoin="round"
+            d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+          />
+        </svg>
+        <span className="text-xs font-semibold hidden sm:inline">Translate</span>
+      </button>
+      {isOpen && <TranslatorFlyout onClose={() => setIsOpen(false)} />}
+    </>
+  );
+}
