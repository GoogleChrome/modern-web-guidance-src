+      const statusBanner = document.getElementById('translator-status');
+      const progressWrapper = document.getElementById('download-progress-wrapper');
+      const progressBar = document.getElementById('download-progress');
+      const progressText = document.getElementById('download-progress-text');
+
+      const pageTargetLangSelect = document.getElementById('page-target-lang');
+      const translatePageBtn = document.getElementById('translate-page-btn');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Store original English text for page-wide translation restoration
+      const originalPageTexts = new Map();
+      translatableElements.forEach((el) => {
+        originalPageTexts.set(el, el.textContent);
+      });
+
+      function showStatus(message, type = 'info') {
+        statusBanner.textContent = message;
+        statusBanner.className = `status-banner visible ${type}`;
+      }
+
+      function hideStatus() {
+        statusBanner.className = 'status-banner';
+        statusBanner.textContent = '';
+      }
+
+      function setProgress(percent, labelPrefix = 'Downloading language model') {
+        progressWrapper.classList.add('visible');
+        progressBar.value = percent;
+        progressText.textContent = `${labelPrefix}: ${percent}%`;
+      }
+
+      function hideProgress() {
+        progressWrapper.classList.remove('visible');
+      }
+
+      function disableTranslationControls(reason) {
+        showStatus(reason, 'warning');
+        startTranslationBtn.disabled = true;
+        translatePageBtn.disabled = true;
+        swapLangsBtn.disabled = true;
+        sourceLangSelect.disabled = true;
+        targetLangSelect.disabled = true;
+        pageTargetLangSelect.disabled = true;
+      }
+
+      // Check feature support in global scope (exclusively self.Translator & self.LanguageDetector)
+      const isTranslatorSupported = 'Translator' in self;
+      const isDetectorSupported = 'LanguageDetector' in self;
+
+      if (!isDetectorSupported) {
+        detectLangBtn.disabled = true;
+        detectLangBtn.title = 'Client-side language detection is currently unsupported in this browser';
+        const autoOpt = sourceLangSelect.querySelector('option[value="auto"]');
+        if (autoOpt) {
+          autoOpt.disabled = true;
+          autoOpt.textContent = 'Auto-detect (Unsupported in browser)';
+        }
+      }
+
+      if (!isTranslatorSupported) {
+        disableTranslationControls('Client-side translation is currently unsupported in this browser.');
+      } else {
+        checkPairAvailability();
+      }
+
+      // Check availability when language pair changes
+      async function checkPairAvailability() {
+        if (!('Translator' in self)) return;
+
+        const sourceLanguage = sourceLangSelect.value === 'auto' ? 'en' : sourceLangSelect.value;
+        const targetLanguage = targetLangSelect.value;
+
+        if (sourceLanguage === targetLanguage) {
+          hideStatus();
+          startTranslationBtn.disabled = false;
+          return;
+        }
+
+        const options = { sourceLanguage, targetLanguage };
+        try {
+          const availability = await Translator.availability(options);
+          if (availability === 'unavailable') {
+            showStatus(`Translation model for ${sourceLanguage} → ${targetLanguage} is unavailable on this device.`, 'warning');
+            startTranslationBtn.disabled = true;
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            showStatus(`Language pack (${sourceLanguage} → ${targetLanguage}) is ${availability}. Click "Translate Text" to download and translate.`, 'info');
+            startTranslationBtn.disabled = false;
+          } else if (availability === 'available') {
+            hideStatus();
+            startTranslationBtn.disabled = false;
+          }
+        } catch (err) {
+          showStatus('Unable to check translation model availability.', 'warning');
+        }
+      }
+
+      sourceLangSelect.addEventListener('change', checkPairAvailability);
+      targetLangSelect.addEventListener('change', checkPairAvailability);
+
+      swapLangsBtn.addEventListener('click', () => {
+        if (sourceLangSelect.value === 'auto') {
+          sourceLangSelect.value = 'en';
+        }
+        const temp = sourceLangSelect.value;
+        sourceLangSelect.value = targetLangSelect.value;
+        targetLangSelect.value = temp;
+        if (translatedTextEl.value.trim()) {
+          sourceTextEl.value = translatedTextEl.value;
+          translatedTextEl.value = '';
+        }
+        checkPairAvailability();
+      });
+
+      // Detect language helper (must be called within user gesture if model needs download)
+      async function detectSourceLanguage(text) {
+        if (!('LanguageDetector' in self)) {
+          throw new Error('Client-side language detection is currently unsupported in this browser.');
+        }
+
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          throw new Error('Language detection model is unavailable on this device.');
+        }
+
+        const detector = await LanguageDetector.create({
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = Math.round((e.loaded || 0) * 100);
+              setProgress(pct, 'Downloading language detector');
+            });
+          },
+        });
+
+        const results = await detector.detect(text);
+        hideProgress();
+        if (results && results.length > 0) {
+          const topResult = results[0];
+          const confidencePct = Math.round((topResult.confidence || 0) * 100);
+          detectedBadge.textContent = `Detected: ${topResult.detectedLanguage} (${confidencePct}%)`;
+          detectedBadge.hidden = false;
+          return topResult.detectedLanguage;
+        }
+        throw new Error('Could not confidently detect the source language.');
+      }
+
+      // Standalone Detect Language button (User Gesture)
+      detectLangBtn.addEventListener('click', async () => {
+        const text = sourceTextEl.value.trim();
+        if (!text) {
+          showStatus('Please enter some text to detect its language.', 'warning');
+          return;
+        }
+        try {
+          detectLangBtn.disabled = true;
+          hideStatus();
+          const detectedLang = await detectSourceLanguage(text);
+          // Select the detected language if present in the dropdown
+          const matchingOption = sourceLangSelect.querySelector(`option[value="${detectedLang}"]`);
+          if (matchingOption) {
+            sourceLangSelect.value = detectedLang;
+            await checkPairAvailability();
+          } else {
+            showStatus(`Detected language "${detectedLang}".`, 'info');
+          }
+        } catch (err) {
+          showStatus(err.message || 'Language detection failed.', 'warning');
+        } finally {
+          detectLangBtn.disabled = false;
+          hideProgress();
+        }
+      });
+
+      // Helper to create a Translator instance following mandatory options & monitor rules
+      async function getOrCreateTranslator(sourceLanguage, targetLanguage) {
+        if (!('Translator' in self)) {
+          throw new Error('Client-side translation is currently unsupported in this browser.');
+        }
+
+        // Identical options object passed to availability() and create()
+        const options = {
+          sourceLanguage,
+          targetLanguage,
+        };
+
+        const availability = await Translator.availability(options);
+
+        if (availability === 'unavailable') {
+          throw new Error(`Translation for ${sourceLanguage} → ${targetLanguage} is unavailable on this device.`);
+        }
+
+        // Instantiate translator with downloadprogress monitor
+        const translator = await Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = Math.round((e.loaded || 0) * 100);
+              setProgress(pct, `Downloading model (${sourceLanguage} → ${targetLanguage})`);
+            });
+          },
+        });
+
+        hideProgress();
+        return translator;
+      }
+
+      // Translate Text button click handler (User Gesture)
+      startTranslationBtn.addEventListener('click', async () => {
+        const text = sourceTextEl.value.trim();
+        if (!text) {
+          showStatus('Please enter text to translate.', 'warning');
+          return;
+        }
+
+        if (!('Translator' in self)) {
+          disableTranslationControls('Client-side translation is currently unsupported in this browser.');
+          return;
+        }
+
+        try {
+          startTranslationBtn.disabled = true;
+          hideStatus();
+
+          let sourceLanguage = sourceLangSelect.value;
+          if (sourceLanguage === 'auto') {
+            sourceLanguage = await detectSourceLanguage(text);
+          }
+
+          const targetLanguage = targetLangSelect.value;
+
+          if (sourceLanguage === targetLanguage) {
+            translatedTextEl.value = text;
+            return;
+          }
+
+          const translator = await getOrCreateTranslator(sourceLanguage, targetLanguage);
+
+          // Use streaming translation for longer texts, standard translate() for normal snippets
+          if (text.length > 300 && typeof translator.translateStreaming === 'function') {
