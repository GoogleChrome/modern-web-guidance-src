+              translatedTextEl.value += chunk;
+            }
+          } else {
+            const result = await translator.translate(text);
+            translatedTextEl.value = result;
+          }
+
+          showStatus(`Translated from ${sourceLanguage} to ${targetLanguage}.`, 'info');
+        } catch (err) {
+          showStatus(err.message || 'Translation failed.', 'warning');
+        } finally {
+          startTranslationBtn.disabled = false;
+          hideProgress();
+        }
+      });
+
+      // Translate entire page content click handler (User Gesture)
+      translatePageBtn.addEventListener('click', async () => {
+        const targetLanguage = pageTargetLangSelect.value;
+
+        if (targetLanguage === 'en') {
+          translatableElements.forEach((el) => {
+            if (originalPageTexts.has(el)) {
+              el.textContent = originalPageTexts.get(el);
+            }
+          });
+          document.documentElement.lang = 'en';
+          hideStatus();
+          return;
+        }
+
+        if (!('Translator' in self)) {
+          disableTranslationControls('Client-side translation is currently unsupported in this browser.');
+          return;
+        }
+
+        try {
+          translatePageBtn.disabled = true;
+          hideStatus();
+
+          const translator = await getOrCreateTranslator('en', targetLanguage);
+
+          for (const el of translatableElements) {
+            const originalText = originalPageTexts.get(el) || el.textContent;
+            if (originalText && originalText.trim()) {
+              const translated = await translator.translate(originalText);
+              el.textContent = translated;
+            }
+          }
+
+          document.documentElement.lang = targetLanguage;
+          showStatus(`Website content translated to ${targetLanguage}.`, 'info');
+        } catch (err) {
+          showStatus(err.message || 'Page translation failed.', 'warning');
+        } finally {
+          translatePageBtn.disabled = false;
+          hideProgress();
+        }
+      });
+    })();
+  </script>
 </body>
 
