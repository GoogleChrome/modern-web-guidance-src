+        }
+      }
+
+      // Token replacement
+      result = result.replace(/([a-zA-ZÀ-ÿ\u3040-\u30FF\u4E00-\u9FFF]+)/g, (word) => {
+        const wLower = word.toLowerCase();
+        for (const wc of wordConcepts) {
+          const srcWord = wc[src];
+          if (srcWord && srcWord.toLowerCase() === wLower && wc[targetLang]) {
+            const translated = wc[targetLang];
+            // Preserve capitalization
+            if (word[0] === word[0].toUpperCase() && word[0] !== word[0].toLowerCase()) {
+              return translated.charAt(0).toUpperCase() + translated.slice(1);
+            }
+            return translated;
+          }
+        }
+        return word;
+      });
+
+      return result;
+    }
+
+    // Main Translate Function (Hybrid: instant local + public API for arbitrary sentences)
+    async function translateText() {
+      const sourceTextEl = document.getElementById("source-text");
+      const targetTextEl = document.getElementById("target-text");
+      const sourceLangEl = document.getElementById("source-lang");
+      const targetLangEl = document.getElementById("target-lang");
+      const statusEl = document.getElementById("translation-status");
+
+      const text = sourceTextEl.value.trim();
+      const dict = uiTranslations[currentSiteLang] || uiTranslations.en;
+
+      if (!text) {
+        targetTextEl.value = "";
+        statusEl.textContent = dict.statusReady;
+        return;
+      }
+
+      const srcLang = sourceLangEl.value === "auto" ? detectLanguage(text) : sourceLangEl.value;
+      const tgtLang = targetLangEl.value;
+
+      if (srcLang === tgtLang) {
+        targetTextEl.value = text;
+        statusEl.textContent = dict.statusDone;
+        return;
+      }
+
+      statusEl.textContent = dict.statusTranslating;
+
+      // Provide immediate local translation first
+      const localResult = localTranslate(text, srcLang, tgtLang);
+      targetTextEl.value = localResult;
+
+      // If it matched a known phrase directly, we're done immediately
+      const isExactKnownPhrase = phraseConcepts.some(
+        (c) => Object.values(c).some((v) => v.toLowerCase() === text.toLowerCase())
+      );
+      if (isExactKnownPhrase) {
+        statusEl.textContent = dict.statusDone;
+        return;
+      }
+
+      // Attempt MyMemory free translation API with timeout fallback to localResult
+      try {
+        const controller = new AbortController();
+        const timeoutId = setTimeout(() => controller.abort(), 3500);
+        const url = `https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=${srcLang}|${tgtLang}`;
+        const response = await fetch(url, { signal: controller.signal });
+        clearTimeout(timeoutId);
+
+        if (response.ok) {
+          const data = await response.json();
+          if (data && data.responseData && data.responseData.translatedText) {
+            targetTextEl.value = data.responseData.translatedText;
+          }
+        }
+      } catch (err) {
+        // Offline or blocked: keep the local dictionary translation
+      } finally {
+        statusEl.textContent = (uiTranslations[currentSiteLang] || uiTranslations.en).statusDone;
+      }
+    }
+
+    // Speech synthesis helper
+    function speakText(text, langCode) {
+      if (!text || !("speechSynthesis" in window)) return;
+      window.speechSynthesis.cancel();
+      const utterance = new SpeechSynthesisUtterance(text);
+      utterance.lang = langCode === "auto" ? detectLanguage(text) : langCode;
+      window.speechSynthesis.speak(utterance);
+    }
+
+    // Initialize Event Listeners
+    document.addEventListener("DOMContentLoaded", () => {
+      const siteLangSelect = document.getElementById("site-lang");
+      const sourceLangSelect = document.getElementById("source-lang");
+      const targetLangSelect = document.getElementById("target-lang");
+      const swapBtn = document.getElementById("swap-lang-btn");
+      const sourceText = document.getElementById("source-text");
+      const targetText = document.getElementById("target-text");
+      const translateBtn = document.getElementById("translate-btn");
+      const clearBtn = document.getElementById("clear-btn");
+      const copyBtn = document.getElementById("copy-btn");
+      const speakSourceBtn = document.getElementById("speak-source-btn");
+      const speakTargetBtn = document.getElementById("speak-target-btn");
+      const charCount = document.getElementById("char-count");
+
+      // Initialize page language
+      setSiteLanguage(currentSiteLang);
+
+      siteLangSelect.addEventListener("change", (e) => {
+        setSiteLanguage(e.target.value);
+      });
+
+      // Debounced auto-translate on typing
+      let debounceTimer = null;
+      sourceText.addEventListener("input", () => {
+        charCount.textContent = `${sourceText.value.length} / 2000`;
+        clearTimeout(debounceTimer);
+        debounceTimer = setTimeout(() => {
+          translateText();
+        }, 350);
+      });
+
+      sourceLangSelect.addEventListener("change", translateText);
+      targetLangSelect.addEventListener("change", translateText);
+      translateBtn.addEventListener("click", translateText);
+
+      // Swap source & target languages and text
+      swapBtn.addEventListener("click", () => {
+        const currentSrc = sourceLangSelect.value === "auto"
+          ? detectLanguage(sourceText.value)
+          : sourceLangSelect.value;
+        const currentTgt = targetLangSelect.value;
+
+        sourceLangSelect.value = currentTgt;
+        targetLangSelect.value = currentSrc;
+
+        if (targetText.value) {
+          sourceText.value = targetText.value;
+          charCount.textContent = `${sourceText.value.length} / 2000`;
+        }
+        translateText();
+      });
+
+      // Clear text
+      clearBtn.addEventListener("click", () => {
+        sourceText.value = "";
+        targetText.value = "";
+        charCount.textContent = "0 / 2000";
+        const dict = uiTranslations[currentSiteLang] || uiTranslations.en;
+        document.getElementById("translation-status").textContent = dict.statusReady;
+        sourceText.focus();
+      });
+
+      // Copy translation
+      copyBtn.addEventListener("click", async () => {
+        if (!targetText.value) return;
+        const dict = uiTranslations[currentSiteLang] || uiTranslations.en;
+        try {
+          await navigator.clipboard.writeText(targetText.value);
+          copyBtn.textContent = dict.copiedBtn;
+          setTimeout(() => {
+            copyBtn.textContent = (uiTranslations[currentSiteLang] || uiTranslations.en).copyBtn;
+          }, 1500);
+        } catch {
+          targetText.select();
+          document.execCommand("copy");
+        }
+      });
+
+      // Text-to-Speech buttons
+      speakSourceBtn.addEventListener("click", () => {
+        speakText(sourceText.value, sourceLangSelect.value);
+      });
+      speakTargetBtn.addEventListener("click", () => {
+        speakText(targetText.value, targetLangSelect.value);
+      });
+
+      // Quick sample phrase chips
+      document.querySelectorAll(".chip[data-phrase]").forEach((chip) => {
+        chip.addEventListener("click", () => {
+          sourceText.value = chip.getAttribute("data-phrase");
+          if (sourceLangSelect.value !== "auto") {
+            sourceLangSelect.value = "en";
+          }
+          charCount.textContent = `${sourceText.value.length} / 2000`;
+          translateText();
+        });
+      });
+    });
+  </script>
+
 </body>
 
