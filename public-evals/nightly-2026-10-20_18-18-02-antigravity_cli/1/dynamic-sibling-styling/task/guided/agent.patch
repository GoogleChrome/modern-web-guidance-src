+  <script>
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const updateSiblings = (container) => {
+        const children = Array.from(container.children);
+        children.forEach((item, index) => {
+          item.style.setProperty('--sibling-index', index + 1);
+          item.style.setProperty('--sibling-count', children.length);
+        });
+      };
+
+      document.querySelectorAll('.grid, .fan-container, .circle-container').forEach((container) => {
+        updateSiblings(container);
+        new MutationObserver(() => updateSiblings(container)).observe(container, { childList: true });
+      });
+    }
+  </script>
