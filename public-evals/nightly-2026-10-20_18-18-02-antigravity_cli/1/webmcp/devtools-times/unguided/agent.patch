+          'Get the full content, metadata, headline, author, and publication date of the currently viewed article on the page.',
+        inputSchema: {
+          type: 'object',
+          properties: {},
+        },
+        annotations: {
+          readOnlyHint: true,
+        },
+        execute: async () => {
