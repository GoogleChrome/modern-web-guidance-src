+          }
+
+          const bookmarkedArticles = articles
+            .filter((a) => readingListSlugs.includes(a.slug))
+            .map((a) => ({
+              slug: a.slug,
+              title: a.title,
+              summary: a.summary,
+              category: a.category,
+              url: `${baseUrl}articles/${a.slug}`,
+            }));
+
+          return formatToolResult({
