+            username: {
+              type: 'string',
+              description: 'The account username.',
+            },
+            password: {
+              type: 'string',
+              description: 'The account password.',
+            },
+          },
+          required: ['username', 'password'],
+        },
+        annotations: {
+          readOnlyHint: false,
+        },
+        execute: async ({ username, password }: { username: string; password: string }) => {
+          const signInFormExists = Boolean(document.querySelector('form[toolname="sign_in"]'));
+          if (signInFormExists) {
+            const res = await new Promise<any>((resolve) => {
+              window.dispatchEvent(
+                new CustomEvent('webmcp:sign-in', {
+                  detail: { username, password, resolve },
+                })
+              );
+            });
+            return formatToolResult(res);
+          }
+
+          const response = await fetch(
+            'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login',
+            {
+              method: 'POST',
+              headers: { 'Content-Type': 'application/json' },
+              body: JSON.stringify({ username, password }),
+            }
+          );
+          const data = await response.json();
+          return formatToolResult({
+            success: response.ok,
+            status: response.status,
+            data,
+          });
+        },
+      },
+      {
+        name: 'register_user',
+        description:
+          'Register a new user account with a username and password. If on the Sign Up page, updates the form UI; otherwise registers directly via the registration endpoint.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            username: {
+              type: 'string',
+              description: 'The desired username.',
+            },
+            password: {
+              type: 'string',
+              description: 'The desired password (must be at least 8 characters and contain a number).',
+            },
+          },
+          required: ['username', 'password'],
+        },
+        annotations: {
+          readOnlyHint: false,
+        },
+        execute: async ({ username, password }: { username: string; password: string }) => {
+          const signUpFormExists = Boolean(document.querySelector('form[toolname="sign_up"]'));
+          if (signUpFormExists) {
+            const res = await new Promise<any>((resolve) => {
+              window.dispatchEvent(
+                new CustomEvent('webmcp:sign-up', {
+                  detail: { username, password, resolve },
+                })
+              );
+            });
+            return formatToolResult(res);
+          }
+
+          const response = await fetch(
+            'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register',
+            {
+              method: 'POST',
+              headers: { 'Content-Type': 'application/json' },
+              body: JSON.stringify({ username, password }),
+            }
+          );
+          const data = await response.json();
+          return formatToolResult({
+            success: response.ok,
+            status: response.status,
+            data,
+          });
+        },
+      },
+    ];
+
+    const registeredToolNames: string[] = [];
+
+    if (typeof modelContext.registerTool === 'function') {
+      for (const tool of tools) {
+        try {
+          modelContext.registerTool(tool);
+          registeredToolNames.push(tool.name);
+        } catch (err) {
+          console.warn(`WebMCP: Failed to register tool "${tool.name}":`, err);
+        }
+      }
+    } else if (typeof modelContext.provideContext === 'function') {
+      try {
+        modelContext.provideContext({ tools });
+      } catch (err) {
+        console.warn('WebMCP: Failed to provide context:', err);
+      }
+    }
+
+    return () => {
+      if (typeof modelContext.unregisterTool === 'function') {
+        for (const name of registeredToolNames) {
+          try {
+            modelContext.unregisterTool(name);
+          } catch {
+            // Ignore cleanup errors if already unregistered
+          }
+        }
+      }
+    };
+  }, []);
+
+  return null;
+}
