+
+          const updatedList = await toggleSlugInServerReadingList(slug);
+          return formatToolResult({
+            success: true,
+            action: 'added',
+            slug,
+            readingList: updatedList,
+          });
+        },
+      },
+      {
+        name: 'remove_from_reading_list',
+        description:
+          'Remove an article from the user\'s reading list (bookmarks) by its slug.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            slug: {
+              type: 'string',
+              description: 'The article slug (ID) to remove from the reading list.',
+            },
+          },
+          required: ['slug'],
+        },
+        annotations: {
+          readOnlyHint: false,
+          idempotentHint: true,
+        },
+        execute: async ({ slug }: { slug: string }) => {
+          const currentList = await fetchReadingListSlugs();
+          if (!currentList.includes(slug)) {
+            return formatToolResult({
+              success: true,
+              action: 'not_in_reading_list',
+              slug,
+              readingList: currentList,
+            });
+          }
+
+          const updatedList = await toggleSlugInServerReadingList(slug);
+          return formatToolResult({
+            success: true,
+            action: 'removed',
+            slug,
+            readingList: updatedList,
+          });
+        },
+      },
+      {
+        name: 'toggle_reading_list',
+        description:
+          'Toggle an article in the user\'s reading list (bookmarks) by its slug—adds it if not present, or removes it if already bookmarked.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            slug: {
+              type: 'string',
+              description: 'The article slug (ID) to toggle in the reading list.',
+            },
+          },
+          required: ['slug'],
+        },
+        annotations: {
+          readOnlyHint: false,
+        },
+        execute: async ({ slug }: { slug: string }) => {
+          const updatedList = await toggleSlugInServerReadingList(slug);
+          const isBookmarked = updatedList.includes(slug);
+          return formatToolResult({
+            success: true,
+            slug,
+            isBookmarked,
+            readingList: updatedList,
+          });
+        },
+      },
+      {
+        name: 'open_reading_list',
+        description: 'Open or close the Reading List flyout modal on the page.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            open: {
+              type: 'boolean',
+              description: 'True to open the reading list modal, false to close it (defaults to true).',
+            },
+          },
+        },
+        annotations: {
+          readOnlyHint: false,
+        },
+        execute: async ({ open = true }: { open?: boolean } = {}) => {
+          window.dispatchEvent(
+            new CustomEvent(open ? 'webmcp:open-reading-list' : 'webmcp:close-reading-list')
+          );
+          return formatToolResult({
+            success: true,
+            isOpen: open,
+          });
+        },
+      },
+      {
+        name: 'navigate_to',
+        description:
+          'Navigate the browser to a specific page, article, or category within The DevTools Times.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            destination: {
+              type: 'string',
+              enum: ['home', 'article', 'category', 'reports', 'multimedia', 'signin', 'signup', 'privacy', 'terms', 'imprint'],
+              description: 'The type of page to navigate to.',
+            },
+            slug: {
+              type: 'string',
+              description: 'The article slug (required when destination is "article") or category name (required when destination is "category").',
+            },
+          },
+          required: ['destination'],
+        },
+        annotations: {
+          readOnlyHint: false,
+        },
+        execute: async ({ destination, slug }: { destination: string; slug?: string }) => {
+          let targetUrl = baseUrl;
+
+          switch (destination) {
+            case 'home':
+              targetUrl = baseUrl;
+              break;
+            case 'article':
+              if (!slug) {
+                throw new Error('Parameter "slug" is required when navigating to an article.');
+              }
+              targetUrl = `${baseUrl}articles/${encodeURIComponent(slug)}`;
+              break;
+            case 'category':
+              if (!slug) {
+                throw new Error('Parameter "slug" (category name) is required when navigating to a category.');
+              }
+              targetUrl = `${baseUrl}category/${encodeURIComponent(slug.toLowerCase())}`;
+              break;
+            case 'reports':
+            case 'multimedia':
+            case 'signin':
+            case 'signup':
+              targetUrl = `${baseUrl}${destination}`;
+              break;
+            case 'privacy':
+            case 'terms':
+            case 'imprint':
+              targetUrl = `${baseUrl}legal/${destination}`;
+              break;
+            default:
+              targetUrl = baseUrl;
+          }
+
+          window.location.href = targetUrl;
+          return formatToolResult({
+            success: true,
+            navigatingTo: targetUrl,
+          });
