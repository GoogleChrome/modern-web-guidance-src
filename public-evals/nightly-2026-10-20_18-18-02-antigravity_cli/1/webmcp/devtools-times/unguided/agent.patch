+          const bodyEl = document.querySelector('main article .prose');
+
+          if (!articleEl || !headlineEl || !bodyEl) {
+            return formatToolResult({
+              isArticlePage: false,
+              currentUrl: window.location.pathname,
+              message: 'The user is not currently viewing an individual article page.',
+            });
+          }
+
+          const pathParts = window.location.pathname.split('/').filter(Boolean);
+          const slug = pathParts[pathParts.length - 1] || '';
+          const categoryEl = articleEl.querySelector('a[href*="/category/"]');
+          const summaryEl = articleEl.querySelector('p');
+          const readingList = await fetchReadingListSlugs();
+
+          return formatToolResult({
+            isArticlePage: true,
+            slug,
+            title: headlineEl.textContent?.trim() || document.title,
+            category: categoryEl?.textContent?.trim() || null,
+            summary: summaryEl?.textContent?.trim() || null,
+            content: bodyEl.textContent?.trim() || '',
+            isBookmarked: readingList.includes(slug),
+            url: window.location.href,
+          });
+        },
+      },
+      {
+        name: 'get_reading_list',
+        description:
+          'Retrieve the user\'s saved reading list (bookmarked articles) with full article details. Can also open the reading list UI flyout.',
+        inputSchema: {
+          type: 'object',
+          properties: {
