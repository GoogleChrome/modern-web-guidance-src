diff --git a/src/components/WebMCPTools.tsx b/src/components/WebMCPTools.tsx
new file mode 100644
index 0000000..c751dcf
--- /dev/null
+++ b/src/components/WebMCPTools.tsx
@@ -0,0 +1,680 @@
+import { useEffect } from 'react';
+import type { ModelContextTool } from '../global';
+
+interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+  category?: string;
+  author?: string;
+  date?: string;
+  readingTime?: number;
+  tags?: string[];
+}
+
+export default function WebMCPTools() {
+  useEffect(() => {
+    const modelContext = navigator.modelContext;
+    if (!modelContext) {
+      return;
+    }
+
+    const rawBaseUrl = import.meta.env.BASE_URL || '/';
+    const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
+
+    const fetchArticles = async (): Promise<Article[]> => {
+      const response = await fetch(`${baseUrl}api/articles.json`);
+      if (!response.ok) {
+        throw new Error(`Failed to fetch articles: ${response.statusText}`);
+      }
+      return await response.json();
+    };
+
+    const fetchReadingListSlugs = async (): Promise<string[]> => {
+      const response = await fetch(`${baseUrl}api/reading-list.json`);
+      if (!response.ok) {
+        throw new Error(`Failed to fetch reading list: ${response.statusText}`);
+      }
+      const data = await response.json();
+      return data.readingList || [];
+    };
+
+    const toggleSlugInServerReadingList = async (slug: string): Promise<string[]> => {
+      const response = await fetch(`${baseUrl}api/reading-list.json`, {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify({ slug }),
+      });
+      if (!response.ok) {
+        throw new Error(`Failed to update reading list: ${response.statusText}`);
+      }
+      const data = await response.json();
