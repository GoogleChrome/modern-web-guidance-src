+      function calculateCartTotals() {
+        const subtotal = state.cart.reduce((sum, entry) => sum + entry.unitPrice * entry.quantity, 0);
+        const discount = state.account.activeReward ? Math.min(subtotal, state.account.activeReward.discount) : 0;
+        const total = Math.max(0, Number((subtotal - discount).toFixed(2)));
+        const itemCount = state.cart.reduce((sum, entry) => sum + entry.quantity, 0);
+        return {
+          subtotal: Number(subtotal.toFixed(2)),
+          discount: Number(discount.toFixed(2)),
+          total,
+          itemCount
+        };
+      }
