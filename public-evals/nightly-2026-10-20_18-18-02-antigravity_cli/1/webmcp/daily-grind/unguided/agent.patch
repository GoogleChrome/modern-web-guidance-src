+        state.account.points -= reward.cost;
+        state.account.activeReward = reward;
+        renderAccount();
+        renderCart();
+        showNotification(`Redeemed "${reward.name}"! Discount applied to your cart.`);
+        return {
+          success: true,
+          redeemedReward: reward,
+          remainingPoints: state.account.points,
+          cartTotals: calculateCartTotals()
+        };
+      }
