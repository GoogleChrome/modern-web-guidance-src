+      // Core Business Logic Actions (shared by UI and WebMCP tools)
+      function searchMenu({ query = '', category = 'all', dietary = 'any', maxPrice } = {}) {
+        const normalizedQuery = String(query || '').trim().toLowerCase();
+        const normalizedCategory = String(category || 'all').toLowerCase();
+        const normalizedDietary = String(dietary || 'any').toLowerCase();
+
+        const filtered = MENU_ITEMS.filter(item => {
+          const matchesQuery = !normalizedQuery ||
+            item.name.toLowerCase().includes(normalizedQuery) ||
+            item.description.toLowerCase().includes(normalizedQuery) ||
+            item.id.toLowerCase().includes(normalizedQuery);
+          const matchesCategory = normalizedCategory === 'all' || !normalizedCategory || item.category === normalizedCategory;
+          const matchesDietary = normalizedDietary === 'any' || !normalizedDietary || item.dietary.includes(normalizedDietary);
+          const matchesPrice = typeof maxPrice !== 'number' || Number.isNaN(maxPrice) || item.price <= maxPrice;
+          return matchesQuery && matchesCategory && matchesDietary && matchesPrice;
+        });
+
+        renderMenu(filtered);
+        return {
+          count: filtered.length,
+          items: filtered
+        };
+      }
+
+      function getMenuItemDetails({ itemId }) {
+        const normalized = String(itemId || '').trim().toLowerCase();
+        const item = MENU_ITEMS.find(
+          m => m.id === normalized || m.name.toLowerCase() === normalized
+        );
+        if (!item) {
+          throw new Error(`Menu item "${itemId}" not found.`);
+        }
+        return {
+          ...item,
+          availableSizes: ['small', 'medium', 'large'],
+          availableMilks: ['none', 'whole', 'oat', 'almond', 'soy']
+        };
+      }
+
+      function addToCart({ itemId, size = 'medium', milk = 'oat', quantity = 1, specialInstructions = '' }) {
+        const normalizedId = String(itemId || '').trim().toLowerCase();
+        const menuItem = MENU_ITEMS.find(
+          m => m.id === normalizedId || m.name.toLowerCase() === normalizedId
+        );
+        if (!menuItem) {
+          throw new Error(`Menu item "${itemId}" not found. Available IDs: ${MENU_ITEMS.map(m => m.id).join(', ')}`);
+        }
+
+        const normalizedSize = ['small', 'medium', 'large'].includes(String(size).toLowerCase())
+          ? String(size).toLowerCase()
+          : 'medium';
+        const normalizedMilk = String(milk || 'oat').toLowerCase();
+        const qty = Math.max(1, Math.min(20, parseInt(quantity, 10) || 1));
+        const unitPrice = Number((menuItem.price + (SIZE_MODIFIERS[normalizedSize] || 0)).toFixed(2));
+
+        const existing = state.cart.find(
+          c => c.itemId === menuItem.id && c.size === normalizedSize && c.milk === normalizedMilk && c.specialInstructions === specialInstructions
+        );
+
+        if (existing) {
+          existing.quantity += qty;
+        } else {
+          state.cart.push({
+            itemId: menuItem.id,
+            name: menuItem.name,
+            size: normalizedSize,
+            milk: normalizedMilk,
+            quantity: qty,
+            unitPrice,
+            specialInstructions
+          });
+        }
+
+        renderCart();
+        const totals = calculateCartTotals();
+        showNotification(`Added ${qty}x ${menuItem.name} (${normalizedSize}) to your cart.`);
+        return {
+          success: true,
+          addedItem: {
+            itemId: menuItem.id,
+            name: menuItem.name,
+            size: normalizedSize,
+            milk: normalizedMilk,
+            quantity: qty,
+            unitPrice
+          },
+          cart: state.cart,
+          totals
+        };
+      }
+
+      function removeFromCart({ itemId, size }) {
+        const normalizedId = String(itemId || '').trim().toLowerCase();
+        const beforeCount = state.cart.length;
+        state.cart = state.cart.filter(entry => {
+          const idMatch = entry.itemId === normalizedId || entry.name.toLowerCase() === normalizedId;
+          const sizeMatch = !size || entry.size === String(size).toLowerCase();
+          return !(idMatch && sizeMatch);
+        });
+        renderCart();
+        const totals = calculateCartTotals();
+        return {
+          success: state.cart.length < beforeCount,
+          cart: state.cart,
+          totals
+        };
+      }
+
+      function clearCart() {
+        state.cart = [];
+        renderCart();
+        showNotification('Shopping cart cleared.');
+        return {
+          success: true,
+          cart: state.cart,
+          totals: calculateCartTotals()
+        };
+      }
