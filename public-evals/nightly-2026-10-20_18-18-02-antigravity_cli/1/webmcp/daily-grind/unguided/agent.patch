+      function submitOrder({ customerName = 'Alex Rivera', locationId = 'downtown-roastery', notes = '' } = {}) {
+        if (state.cart.length === 0) {
+          throw new Error('Cannot place an order with an empty cart. Please add items first.');
+        }
+        const location = LOCATIONS.find(l => l.id === locationId) || LOCATIONS[0];
+        const totals = calculateCartTotals();
+        const order = {
+          orderId: 'DG-' + (1000 + state.orders.length + 1),
+          customerName,
+          location: {
+            id: location.id,
+            name: location.name,
+            address: location.address
+          },
+          items: [...state.cart],
+          totals,
+          notes,
+          estimatedPickupMinutes: 10,
+          status: 'confirmed',
+          createdAt: new Date().toISOString()
+        };
+
+        state.orders.push(order);
+        const earnedPoints = Math.round(totals.total * 10);
+        if (state.account.loggedIn) {
+          state.account.points += earnedPoints;
+        }
+        state.cart = [];
+        state.account.activeReward = null;
+        renderCart();
+        renderAccount();
+
+        const confirmBanner = document.getElementById('order-confirmation');
+        if (confirmBanner) {
+          confirmBanner.textContent = `Order ${order.orderId} confirmed for ${order.customerName} at ${location.name}! Total: $${totals.total.toFixed(2)}. Ready in ~${order.estimatedPickupMinutes} mins.`;
+          confirmBanner.classList.add('active');
+        }
+        showNotification(`Order ${order.orderId} placed successfully!`);
+        return order;
+      }
