+      function findLocations({ city = '', feature = '' } = {}) {
+        const normalizedCity = String(city || '').trim().toLowerCase();
+        const normalizedFeature = String(feature || '').trim().toLowerCase();
+
+        const matches = LOCATIONS.filter(loc => {
+          const cityMatch = !normalizedCity ||
+            loc.city.toLowerCase().includes(normalizedCity) ||
+            loc.name.toLowerCase().includes(normalizedCity) ||
+            loc.address.toLowerCase().includes(normalizedCity);
+          const featureMatch = !normalizedFeature ||
+            loc.features.some(f => f.toLowerCase().includes(normalizedFeature));
+          return cityMatch && featureMatch;
+        });
