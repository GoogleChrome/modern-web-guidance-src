+
+      function redeemReward(rewardIdInput) {
+        const rewardId = typeof rewardIdInput === 'string'
+          ? rewardIdInput
+          : (rewardIdInput && rewardIdInput.rewardId);
+        const reward = REWARD_TIERS[rewardId];
+        if (!reward) {
+          throw new Error(`Invalid reward ID "${rewardId}". Valid IDs: ${Object.keys(REWARD_TIERS).join(', ')}`);
+        }
+        if (!state.account.loggedIn) {
+          throw new Error('User must be logged in to redeem rewards.');
+        }
+        if (state.account.points < reward.cost) {
+          throw new Error(`Insufficient points (${state.account.points} available, ${reward.cost} required).`);
+        }
