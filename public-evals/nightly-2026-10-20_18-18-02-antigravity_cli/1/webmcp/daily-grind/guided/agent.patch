+      }
+    }
+
+    function showStatus(elementId, message) {
+      const el = document.getElementById(elementId);
+      if (!el) return;
+      el.textContent = message;
+      el.classList.add('visible');
+    }
+
+    function filterCatalog({ query = '', category = 'all', dietary = 'any' } = {}) {
+      const normalizedQuery = String(query).trim().toLowerCase();
+      return MENU_CATALOG.filter((item) => {
+        const matchesQuery = !normalizedQuery ||
+          item.name.toLowerCase().includes(normalizedQuery) ||
+          item.description.toLowerCase().includes(normalizedQuery);
+        const matchesCategory = category === 'all' || item.category === category;
+        const matchesDietary = dietary === 'any' || item.dietary.includes(dietary);
+        return matchesQuery && matchesCategory && matchesDietary;
+      });
+    }
+
+    function addItemToCart({ itemId, size = 'medium', milk = 'oat', quantity = 1 }) {
+      const catalogItem = MENU_CATALOG.find(
+        (entry) => entry.id === itemId || entry.name.toLowerCase() === String(itemId).toLowerCase()
+      );
+      if (!catalogItem) {
+        return {
+          error: `Menu item "${itemId}" was not found.`,
+          availableItems: MENU_CATALOG.map((entry) => ({ id: entry.id, name: entry.name }))
+        };
+      }
+      if (!DRINK_SIZES.includes(size)) {
+        return { error: `Invalid size "${size}".`, supportedSizes: DRINK_SIZES };
+      }
+      if (!MILK_OPTIONS.includes(milk)) {
+        return { error: `Invalid milk option "${milk}".`, supportedMilkOptions: MILK_OPTIONS };
+      }
+      const parsedQty = Number(quantity);
+      if (!Number.isInteger(parsedQty) || parsedQty < 1 || parsedQty > 20) {
+        return { error: 'Quantity must be a whole number between 1 and 20.' };
+      }
+
+      const sizeUpcharge = size === 'large' ? 0.75 : size === 'small' ? -0.50 : 0;
+      const unitPrice = Number((catalogItem.price + sizeUpcharge).toFixed(2));
+      const existing = appState.cart.find(
+        (entry) => entry.itemId === catalogItem.id && entry.size === size && entry.milk === milk
+      );
+
+      if (existing) {
+        existing.quantity += parsedQty;
+      } else {
+        appState.cart.push({
+          itemId: catalogItem.id,
+          name: catalogItem.name,
+          size,
+          milk,
+          quantity: parsedQty,
+          unitPrice
+        });
+      }
+
+      renderCart();
+      return {
+        added: {
+          itemId: catalogItem.id,
+          name: catalogItem.name,
+          size,
+          milk,
+          quantity: parsedQty,
+          unitPrice
+        },
+        cart: appState.cart,
+        totals: calculateCartTotals()
+      };
+    }
+
+    // Wire up standard DOM interactions
+    renderMenu(MENU_CATALOG);
