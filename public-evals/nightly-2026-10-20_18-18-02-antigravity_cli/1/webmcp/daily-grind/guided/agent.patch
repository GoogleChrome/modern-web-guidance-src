+            <small style="display: block; color: #666;">Size: ${entry.size}, Milk: ${entry.milk}</small>
+          </div>
+          <span>$${(entry.unitPrice * entry.quantity).toFixed(2)}</span>
+        </li>
+      `).join('');
+    }
+
+    function renderRewards() {
+      const pointsEl = document.getElementById('rewards-points');
