+
+    // Declarative WebMCP Form 1: Menu Search & Filter
+    document.getElementById('menu-search-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const formData = new FormData(event.target);
+      const query = String(formData.get('query') ?? '').trim();
+      const category = String(formData.get('category') ?? 'all');
+      const dietary = String(formData.get('dietary') ?? 'any');
+
+      const validationErrors = [];
+      if (!CATEGORIES.includes(category)) {
+        validationErrors.push({ field: 'category', message: 'Unsupported menu category' });
+      }
+      if (!DIETARY_TAGS.includes(dietary)) {
+        validationErrors.push({ field: 'dietary', message: 'Unsupported dietary filter' });
+      }
+
+      if (validationErrors.length > 0) {
+        if (event.agentInvoked) {
+          const errorString = 'Validation failed: ' +
+            validationErrors.map((err) => `${err.field} (${err.message})`).join(', ');
+          event.respondWith(Promise.resolve(errorString));
+        }
+        return;
+      }
+
+      const filteredItems = filterCatalog({ query, category, dietary });
+      renderMenu(filteredItems);
+
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve({
+          count: filteredItems.length,
+          filters: { query, category, dietary },
+          items: filteredItems
+        }));
+      }
+    });
+
+    // Declarative WebMCP Form 2: Pickup Order Checkout
+    document.getElementById('checkout-form').addEventListener('submit', (event) => {
+      event.preventDefault();
+      const formData = new FormData(event.target);
+      const customerName = String(formData.get('customerName') ?? '').trim();
+      const locationId = String(formData.get('locationId') ?? '').trim();
+      const notes = String(formData.get('notes') ?? '').trim();
+
+      const validationErrors = [];
+      if (!customerName) {
+        validationErrors.push({ field: 'customerName', message: 'Customer name is required' });
+      }
+      const store = STORE_LOCATIONS.find((loc) => loc.id === locationId);
+      if (!store) {
+        validationErrors.push({ field: 'locationId', message: 'Valid pickup store location is required' });
+      }
+      if (appState.cart.length === 0) {
+        validationErrors.push({ field: 'cart', message: 'Cannot submit an order with an empty cart' });
+      }
+
+      if (validationErrors.length > 0) {
+        const errorString = 'Validation failed: ' +
+          validationErrors.map((err) => `${err.field} (${err.message})`).join(', ');
+        showStatus('order-status', errorString);
+        if (event.agentInvoked) {
+          event.respondWith(Promise.resolve(errorString));
+        }
+        return;
+      }
+
+      const totals = calculateCartTotals();
+      const orderConfirmation = {
+        orderId: `DG-${Date.now().toString().slice(-6)}`,
+        customerName,
+        pickupLocation: store.name,
+        estimatedReadyMinutes: store.waitTimeMinutes,
+        notes: notes || null,
+        items: [...appState.cart],
+        totals
+      };
+
+      appState.orders.push(orderConfirmation);
+      appState.cart = [];
+      appState.rewards.appliedDiscount = 0;
+      appState.rewards.activeRewardName = null;
+      renderCart();
+      renderRewards();
+
+      const confirmationMessage = `Order ${orderConfirmation.orderId} confirmed for ${customerName} at ${store.name}! Ready in ~${store.waitTimeMinutes} mins.`;
+      showStatus('order-status', confirmationMessage);
+
+      if (event.agentInvoked) {
+        event.respondWith(Promise.resolve(orderConfirmation));
+      }
+    });
+
+    // Imperative WebMCP API Registration & Lifecycle Management
+    const webMcpController = new AbortController();
+
+    window.addEventListener('pagehide', () => {
+      webMcpController.abort();
+    });
+
+    async function registerDailyGrindWebMcpTools() {
+      if (!('modelContext' in document) || !document.modelContext) {
+        return;
+      }
+
+      const registrationOptions = { signal: webMcpController.signal };
+
+      // 1. Read-Only Tool: Search and filter menu items
+      await document.modelContext.registerTool({
+        name: 'search_menu_items',
+        description: 'Searches the coffee shop menu and updates the visible menu grid. Use when the user asks about available drinks, pastries, calories, caffeine, or dietary options.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            query: {
+              type: 'string',
+              description: 'Keyword to match against item names or flavor descriptions.'
+            },
+            category: {
+              type: 'string',
+              enum: CATEGORIES,
+              default: 'all',
+              description: 'Menu section to filter by.'
+            },
+            dietary: {
+              type: 'string',
+              enum: DIETARY_TAGS,
+              default: 'any',
+              description: 'Dietary requirement that returned items must satisfy.'
+            },
+            maxPrice: {
+              type: 'number',
+              minimum: 0,
+              description: 'Maximum item base price in US dollars.'
+            }
+          }
+        },
+        execute({ query = '', category = 'all', dietary = 'any', maxPrice } = {}) {
+          if (typeof query !== 'string' || !CATEGORIES.includes(category) || !DIETARY_TAGS.includes(dietary)) {
+            return {
+              error: 'Invalid search filter arguments.',
+              supportedCategories: CATEGORIES,
+              supportedDietary: DIETARY_TAGS
+            };
+          }
+          if (maxPrice !== undefined && (typeof maxPrice !== 'number' || Number.isNaN(maxPrice) || maxPrice < 0)) {
+            return { error: 'maxPrice must be a non-negative number.' };
+          }
+
+          let results = filterCatalog({ query, category, dietary });
+          if (maxPrice !== undefined) {
+            results = results.filter((item) => item.price <= maxPrice);
+          }
+
+          renderMenu(results);
+          return {
+            count: results.length,
+            items: results
+          };
+        },
+        annotations: { readOnlyHint: true }
+      }, registrationOptions);
+
+      // 2. State-Mutating Tool: Add an item to the order cart
+      await document.modelContext.registerTool({
+        name: 'add_item_to_cart',
+        description: 'Adds a coffee or bakery item to the current order cart and updates the cart display. Use when the user asks to add a drink or pastry to their order.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            itemId: {
+              type: 'string',
+              enum: MENU_CATALOG.map((item) => item.id),
+              description: 'Identifier of the menu item to add.'
+            },
+            size: {
+              type: 'string',
+              enum: DRINK_SIZES,
+              default: 'medium',
+              description: 'Cup size for the beverage.'
+            },
+            milk: {
+              type: 'string',
+              enum: MILK_OPTIONS,
+              default: 'oat',
+              description: 'Milk choice for the beverage.'
+            },
+            quantity: {
+              type: 'integer',
+              minimum: 1,
+              maximum: 20,
+              default: 1,
+              description: 'Number of items to add.'
+            }
+          },
+          required: ['itemId']
+        },
+        execute({ itemId, size = 'medium', milk = 'oat', quantity = 1 } = {}) {
+          const result = addItemToCart({ itemId, size, milk, quantity });
+          if (result.error) {
+            return result;
+          }
+          showStatus('order-status', `Added ${result.added.quantity}x ${result.added.name} (${result.added.size}) to your cart.`);
+          return result;
+        },
+        annotations: {
+          readOnlyHint: false,
+          consequentialHint: false,
+          untrustedContentHint: false
+        }
+      }, registrationOptions);
+
+      // 3. Read-Only Tool: Get current shopping cart and rewards summary
+      await document.modelContext.registerTool({
+        name: 'get_cart_summary',
+        description: 'Retrieves the items currently in the order cart, the price breakdown, and the customer loyalty rewards balance. Use when the user asks what is in their cart or how many points they have.',
+        inputSchema: {
+          type: 'object',
+          properties: {}
+        },
+        execute() {
+          return {
+            items: appState.cart,
+            totals: calculateCartTotals(),
+            rewards: { ...appState.rewards }
+          };
+        },
+        annotations: { readOnlyHint: true }
+      }, registrationOptions);
+
+      // 4. Consequential Tool: Redeem loyalty points for an order discount
+      await document.modelContext.registerTool({
+        name: 'redeem_rewards_points',
+        description: 'Redeems loyalty points from the customer account to apply a dollar discount to the current order. Use when the user explicitly asks to spend their rewards points.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            pointsToRedeem: {
+              type: 'integer',
+              enum: [100, 200, 400],
+              default: 100,
+              description: 'Number of loyalty points to spend (100 points = $2.00 discount).'
+            }
+          },
+          required: ['pointsToRedeem']
+        },
+        execute({ pointsToRedeem } = {}) {
+          const validTiers = [100, 200, 400];
+          if (!validTiers.includes(pointsToRedeem)) {
+            return {
+              error: 'Unsupported redemption amount.',
+              supportedPointTiers: validTiers
+            };
+          }
+          if (appState.rewards.points < pointsToRedeem) {
+            return {
+              error: `Insufficient loyalty points. Available: ${appState.rewards.points}.`,
+              availablePoints: appState.rewards.points
+            };
+          }
+
+          const discountAmount = (pointsToRedeem / 100) * 2;
+          appState.rewards.points -= pointsToRedeem;
+          appState.rewards.appliedDiscount += discountAmount;
+          appState.rewards.activeRewardName = `${pointsToRedeem} Pts Redeemed`;
+
+          renderRewards();
+          renderCart();
+          showStatus('order-status', `Redeemed ${pointsToRedeem} points for a $${discountAmount.toFixed(2)} discount.`);
+
+          return {
+            redeemedPoints: pointsToRedeem,
+            discountApplied: discountAmount,
+            remainingPoints: appState.rewards.points,
+            totals: calculateCartTotals()
+          };
+        },
+        annotations: {
+          readOnlyHint: false,
+          consequentialHint: true,
+          untrustedContentHint: false
+        }
+      }, registrationOptions);
+
+      // 5. Read-Only Async Tool: Find store locations with AbortSignal support
+      await document.modelContext.registerTool({
+        name: 'find_store_locations',
+        description: 'Finds The Daily Grind coffee shop locations and current pickup wait times. Use when the user asks where stores are located, opening hours, or store amenities.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            feature: {
+              type: 'string',
+              enum: ['pour-over-bar', 'wifi', 'patio', 'roastery-tours', 'dog-friendly', 'express-pickup'],
+              description: 'Store amenity to filter locations by.'
+            }
+          }
+        },
+        async execute({ feature } = {}, { signal } = {}) {
+          if (signal?.aborted) {
+            signal.throwIfAborted();
+          }
+
+          if (feature !== undefined) {
+            const validFeatures = ['pour-over-bar', 'wifi', 'patio', 'roastery-tours', 'dog-friendly', 'express-pickup'];
+            if (!validFeatures.includes(feature)) {
+              return {
+                error: `Unsupported store feature "${feature}".`,
+                supportedFeatures: validFeatures
+              };
+            }
+          }
+
+          const matches = feature
+            ? STORE_LOCATIONS.filter((loc) => loc.features.includes(feature))
+            : STORE_LOCATIONS;
+
+          return {
+            count: matches.length,
+            locations: matches
+          };
+        },
+        annotations: { readOnlyHint: true }
+      }, registrationOptions);
+    }
+
+    // Lifecycle Events (`toolactivated` & `toolcancel`) with backward-compatible target detection
+    const targetFor = (type, listener, options) =>
+      (`on${type}` in (document.modelContext ?? {}) ? document.modelContext : window)
+        .addEventListener(type, listener, options);
+
+    targetFor('toolactivated', ({ toolName }) => {
+      showStatus('agent-activity-log', `AI Agent invoked tool: ${toolName}`);
+    }, { signal: webMcpController.signal });
+
+    targetFor('toolcancel', ({ toolName }) => {
+      showStatus('agent-activity-log', `AI Agent cancelled tool: ${toolName}`);
+    }, { signal: webMcpController.signal });
+
+    registerDailyGrindWebMcpTools();
+  </script>
 </body>
 
 </html>
