+        points: 420,
+        appliedDiscount: 0,
+        activeRewardName: null
+      },
+      orders: []
+    };
+
+    // UI Rendering Helpers
+    function renderMenu(items) {
+      const grid = document.getElementById('menu-grid');
+      if (!grid) return;
+      if (items.length === 0) {
+        grid.innerHTML = '<p style="grid-column: 1 / -1; text-align: center;">No menu items match your current filters.</p>';
+        return;
+      }
+      grid.innerHTML = items.map((item) => `
+        <div class="card" data-item-id="${item.id}">
+          <img src="${item.image}" alt="${item.name}">
+          <span class="badge">${item.category} • ${item.calories} cal</span>
+          <h3>${item.name}</h3>
+          <p>${item.description}</p>
+          <p class="price">$${item.price.toFixed(2)}</p>
+          <button type="button" class="btn add-to-cart-btn" data-item-id="${item.id}" style="border: none; cursor: pointer;">Add to Order</button>
+        </div>
+      `).join('');
+    }
+
+    function calculateCartTotals() {
+      const subtotal = appState.cart.reduce((sum, entry) => sum + entry.unitPrice * entry.quantity, 0);
+      const discount = Math.min(subtotal, appState.rewards.appliedDiscount);
+      const total = Math.max(0, subtotal - discount);
+      return {
+        subtotal: Number(subtotal.toFixed(2)),
+        discount: Number(discount.toFixed(2)),
+        total: Number(total.toFixed(2)),
+        itemCount: appState.cart.reduce((count, entry) => count + entry.quantity, 0)
+      };
+    }
+
+    function renderCart() {
+      const cartList = document.getElementById('cart-list');
+      const cartTotalEl = document.getElementById('cart-total');
+      const navCountEl = document.getElementById('nav-cart-count');
+      const totals = calculateCartTotals();
+
+      if (navCountEl) navCountEl.textContent = String(totals.itemCount);
+      if (cartTotalEl) cartTotalEl.textContent = totals.total.toFixed(2);
+
+      if (!cartList) return;
+      if (appState.cart.length === 0) {
+        cartList.innerHTML = '<li style="color: #777;">Your cart is currently empty.</li>';
+        return;
