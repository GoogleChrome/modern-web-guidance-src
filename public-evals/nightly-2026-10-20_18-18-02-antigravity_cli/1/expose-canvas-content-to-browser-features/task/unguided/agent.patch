+  <script>
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const cupForm = document.getElementById('cup-form');
+    const nameInput = document.getElementById('customer-name');
+    const milkSelect = document.getElementById('milk-select');
+    const syrupSelect = document.getElementById('syrup-select');
+    const orderStatus = document.getElementById('cup-order-status');
+
+    const milkColors = {
+      'Oat Milk': '#e6d2b5',
+      'Whole Milk': '#f5ebe0',
+      'Almond Milk': '#dfcab0',
+      'Soy Milk': '#ede0c8'
+    };
+
+    const syrupColors = {
+      'Vermont Maple': '#b3541e',
+      'Vanilla Bean': '#f3d58d',
+      'Salted Caramel': '#d97724',
+      'Hazelnut': '#7f4f24',
+      'No Syrup': 'transparent'
+    };
+
+    function updateOrderSummary() {
+      const customerName = nameInput.value.trim() || 'Guest';
+      const milk = milkSelect.value;
+      const syrup = syrupSelect.value;
+      const syrupText = syrup === 'No Syrup' ? 'unsweetened' : `with ${syrup}`;
+      orderStatus.textContent = `${customerName}'s ${milk} Latte (${syrupText})`;
+    }
+
+    function drawCoffeeCup(width, height) {
+      const centerX = width / 2;
+
+      // Soft warm backdrop circle
+      ctx.fillStyle = '#f7f1ee';
+      ctx.beginPath();
+      ctx.arc(centerX, height / 2 + 10, 230, 0, Math.PI * 2);
+      ctx.fill();
+
+      // Steam wisps above the lid
+      ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+      ctx.lineWidth = 3;
+      ctx.lineCap = 'round';
+      [-35, 0, 35].forEach((offset, idx) => {
+        ctx.beginPath();
+        ctx.moveTo(centerX + offset, 62);
+        ctx.bezierCurveTo(
+          centerX + offset - 12, 42 - idx * 3,
+          centerX + offset + 14, 28 - idx * 3,
+          centerX + offset - 4, 14
+        );
+        ctx.stroke();
+      });
+
+      // Cup shadow
+      ctx.fillStyle = 'rgba(62, 39, 35, 0.14)';
+      ctx.beginPath();
+      ctx.ellipse(centerX, 520, 115, 16, 0, 0, Math.PI * 2);
+      ctx.fill();
+
+      // Main paper cup body (trapezoid with rounded bottom)
+      ctx.fillStyle = '#fffdf9';
+      ctx.strokeStyle = '#4e342e';
+      ctx.lineWidth = 3.5;
+      ctx.beginPath();
+      ctx.moveTo(centerX - 150, 115);
+      ctx.lineTo(centerX + 150, 115);
+      ctx.lineTo(centerX + 112, 505);
+      ctx.quadraticCurveTo(centerX, 524, centerX - 112, 505);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+
+      // Liquid preview band near top of cup reflecting milk & syrup selection
+      const milkColor = milkColors[milkSelect.value] || '#e6d2b5';
+      ctx.fillStyle = milkColor;
+      ctx.beginPath();
+      ctx.moveTo(centerX - 145, 122);
+      ctx.lineTo(centerX + 145, 122);
+      ctx.lineTo(centerX + 140, 162);
+      ctx.lineTo(centerX - 140, 162);
+      ctx.closePath();
+      ctx.fill();
+
+      const syrupColor = syrupColors[syrupSelect.value];
+      if (syrupColor && syrupColor !== 'transparent') {
+        ctx.strokeStyle = syrupColor;
+        ctx.lineWidth = 4;
+        ctx.beginPath();
+        ctx.moveTo(centerX - 120, 142);
+        ctx.bezierCurveTo(centerX - 40, 130, centerX + 40, 154, centerX + 120, 140);
+        ctx.stroke();
+      }
+
+      // Kraft cardboard coffee sleeve in the middle of the cup
+      ctx.fillStyle = '#c89f76';
+      ctx.strokeStyle = '#4e342e';
+      ctx.lineWidth = 3;
+      ctx.beginPath();
+      ctx.moveTo(centerX - 140, 170);
+      ctx.lineTo(centerX + 140, 170);
+      ctx.lineTo(centerX + 118, 455);
+      ctx.lineTo(centerX - 118, 455);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+
+      // Coffee dome lid
+      ctx.fillStyle = '#4e342e';
+      ctx.beginPath();
+      ctx.roundRect(centerX - 158, 72, 316, 24, 6);
+      ctx.fill();
+
+      ctx.fillStyle = '#3e2723';
+      ctx.beginPath();
+      ctx.roundRect(centerX - 166, 94, 332, 22, 6);
+      ctx.fill();
+    }
+
+    canvas.onpaint = () => {
+      ctx.reset();
+      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
+
+      const cssWidth = canvas.clientWidth || 560;
+      const cssHeight = canvas.clientHeight || 560;
+
+      drawCoffeeCup(cssWidth, cssHeight);
+
+      const formWidth = cupForm.offsetWidth || 240;
+      const formX = (cssWidth - formWidth) / 2;
+      const formY = 182;
+
+      if (typeof ctx.drawElementImage === 'function') {
+        const transform = ctx.drawElementImage(cupForm, formX, formY);
+        if (transform) {
+          cupForm.style.transform = transform.toString();
+        } else if (typeof canvas.getElementTransform === 'function') {
+          const matrix = canvas.getElementTransform(cupForm, new DOMMatrix().translate(formX, formY));
+          if (matrix) {
+            cupForm.style.transform = matrix.toString();
+          }
+        }
+      }
+    };
+
+    const resizeObserver = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc ? dpc[0].inlineSize : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc ? dpc[0].blockSize : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      if (typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else if (typeof canvas.onpaint === 'function') {
+        canvas.onpaint();
+      }
+    });
+
+    const supportsDevicePixelBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    resizeObserver.observe(canvas, supportsDevicePixelBox ? { box: 'device-pixel-content-box' } : undefined);
+
+    cupForm.addEventListener('input', () => {
+      updateOrderSummary();
+      if (typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else if (typeof canvas.onpaint === 'function') {
+        canvas.onpaint();
+      }
+    });
+
+    cupForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const customerName = nameInput.value.trim() || 'Guest';
+      orderStatus.textContent = `Order ready for ${customerName}! (${milkSelect.value}, ${syrupSelect.value})`;
+      if (typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else if (typeof canvas.onpaint === 'function') {
+        canvas.onpaint();
+      }
+    });
+
+    updateOrderSummary();
+    if (typeof canvas.requestPaint === 'function') {
+      canvas.requestPaint();
+    } else if (typeof canvas.onpaint === 'function') {
+      canvas.onpaint();
+    }
+  </script>
 </body>
 
