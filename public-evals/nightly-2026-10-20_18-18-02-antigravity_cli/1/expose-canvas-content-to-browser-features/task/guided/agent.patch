+  <script>
+    const canvas = document.getElementById('canvas');
+    const ctx = canvas.getContext('2d');
+    const uiElement = document.getElementById('cup-order-ui');
+    const canvasWrapper = document.getElementById('canvas-wrapper');
+    const nameInput = document.getElementById('customer-name');
+    const milkSelect = document.getElementById('milk-option');
+    const syrupCheckboxes = document.querySelectorAll('input[name="syrup"]');
+    const orderBtn = document.getElementById('place-order-btn');
+    const orderStatus = document.getElementById('order-status');
+
+    const supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+
+    if (!supportsHtmlInCanvas) {
+      // Fallback: place interactive HTML content on top of the canvas using CSS
+      canvasWrapper.classList.add('fallback-mode');
+      canvasWrapper.appendChild(uiElement);
+    }
+
+    function getOrderDetails() {
+      const name = nameInput.value.trim() || 'Guest';
+      const milk = milkSelect.value;
+      const syrups = Array.from(syrupCheckboxes)
+        .filter((cb) => cb.checked)
+        .map((cb) => cb.value);
+      return { name, milk, syrups };
+    }
+
+    function updateOrderSummary(confirmed = false) {
+      const { name, milk, syrups } = getOrderDetails();
+      const syrupText = syrups.length > 0 ? syrups.join(' + ') : 'No Syrup';
+      if (confirmed) {
+        orderStatus.textContent = `Order placed for ${name}! (${milk}, ${syrupText})`;
+      } else {
+        orderStatus.textContent = `Ready for ${name} (${milk}, ${syrupText})`;
+      }
+      if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else {
+        drawScene();
+      }
+    }
+
+    nameInput.addEventListener('input', () => updateOrderSummary(false));
+    milkSelect.addEventListener('change', () => updateOrderSummary(false));
+    syrupCheckboxes.forEach((cb) =>
+      cb.addEventListener('change', () => updateOrderSummary(false))
+    );
+    orderBtn.addEventListener('click', () => updateOrderSummary(true));
+
+    function drawCoffeeCup(width, height, dpr) {
+      ctx.save();
+      ctx.scale(dpr, dpr);
+
+      const cssWidth = width / dpr;
+      const cssHeight = height / dpr;
+      const cx = cssWidth / 2;
+
+      // Subtle warm background circle
+      ctx.fillStyle = '#f5ebe6';
+      ctx.beginPath();
+      ctx.arc(cx, cssHeight / 2 + 10, 220, 0, Math.PI * 2);
+      ctx.fill();
+
+      // Steam wisps above the cup
+      ctx.strokeStyle = 'rgba(141, 110, 99, 0.35)';
+      ctx.lineWidth = 3;
+      ctx.lineCap = 'round';
+      [-35, 0, 35].forEach((offset, idx) => {
+        ctx.beginPath();
+        ctx.moveTo(cx + offset, 65);
+        ctx.bezierCurveTo(
+          cx + offset - 12,
+          45,
+          cx + offset + 12,
+          30,
+          cx + offset,
+          15 + idx * 3
+        );
+        ctx.stroke();
+      });
+
+      // Cup shadow
+      ctx.fillStyle = 'rgba(62, 39, 35, 0.12)';
+      ctx.beginPath();
+      ctx.ellipse(cx, 480, 115, 16, 0, 0, Math.PI * 2);
+      ctx.fill();
+
+      // Cup body (tapered artisanal paper cup)
+      const topY = 95;
+      const bottomY = 470;
+      const topHalfW = 150;
+      const bottomHalfW = 105;
+
+      const cupGrad = ctx.createLinearGradient(cx - topHalfW, topY, cx + topHalfW, topY);
+      cupGrad.addColorStop(0, '#fffbf7');
+      cupGrad.addColorStop(0.5, '#f7ede2');
+      cupGrad.addColorStop(1, '#e6d5c3');
+
+      ctx.fillStyle = cupGrad;
+      ctx.strokeStyle = '#5d4037';
+      ctx.lineWidth = 3;
+      ctx.beginPath();
+      ctx.moveTo(cx - topHalfW, topY);
+      ctx.lineTo(cx + topHalfW, topY);
+      ctx.lineTo(cx + bottomHalfW, bottomY);
+      ctx.quadraticCurveTo(cx, bottomY + 14, cx - bottomHalfW, bottomY);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+
+      // Kraft cardboard sleeve in the middle of the cup
+      const sleeveTopY = 150;
+      const sleeveBottomY = 425;
+      const t1 = (sleeveTopY - topY) / (bottomY - topY);
+      const t2 = (sleeveBottomY - topY) / (bottomY - topY);
+      const sleeveTopHalfW = topHalfW - (topHalfW - bottomHalfW) * t1 + 3;
+      const sleeveBottomHalfW = topHalfW - (topHalfW - bottomHalfW) * t2 + 3;
+
+      const sleeveGrad = ctx.createLinearGradient(cx - sleeveTopHalfW, sleeveTopY, cx + sleeveTopHalfW, sleeveTopY);
+      sleeveGrad.addColorStop(0, '#d7b38c');
+      sleeveGrad.addColorStop(0.5, '#c69c6d');
+      sleeveGrad.addColorStop(1, '#a67c52');
+
+      ctx.fillStyle = sleeveGrad;
+      ctx.strokeStyle = '#4e342e';
+      ctx.lineWidth = 2.5;
+      ctx.beginPath();
+      ctx.moveTo(cx - sleeveTopHalfW, sleeveTopY);
+      ctx.lineTo(cx + sleeveTopHalfW, sleeveTopY);
+      ctx.lineTo(cx + sleeveBottomHalfW, sleeveBottomY);
+      ctx.quadraticCurveTo(cx, sleeveBottomY + 10, cx - sleeveBottomHalfW, sleeveBottomY);
+      ctx.closePath();
+      ctx.fill();
+      ctx.stroke();
+
+      // Coffee lid dome & rim
+      ctx.fillStyle = '#4e342e';
+      ctx.beginPath();
+      ctx.roundRect(cx - topHalfW - 8, topY - 26, (topHalfW + 8) * 2, 18, 6);
+      ctx.fill();
+
+      ctx.fillStyle = '#3e2723';
+      ctx.beginPath();
+      ctx.roundRect(cx - topHalfW - 14, topY - 12, (topHalfW + 14) * 2, 16, 6);
+      ctx.fill();
+
+      ctx.restore();
+    }
+
+    function drawScene() {
+      const dpr = canvas.clientWidth > 0 ? canvas.width / canvas.clientWidth : (window.devicePixelRatio || 1);
+
+      if (typeof ctx.reset === 'function') {
+        ctx.reset();
+      } else {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+      }
+
+      drawCoffeeCup(canvas.width, canvas.height, dpr);
+
+      if (supportsHtmlInCanvas && typeof ctx.drawElementImage === 'function') {
+        ctx.save();
+        ctx.scale(dpr, dpr);
+        const cssWidth = canvas.width / dpr;
+        const formX = (cssWidth - uiElement.offsetWidth) / 2;
+        const formY = 165;
+        // Draw the HTML element inside the cup sleeve; drawElementImage automatically
+        // syncs the DOM geometry and accessibility bounds with the drawn location.
+        ctx.drawElementImage(uiElement, formX, formY);
+        ctx.restore();
+      }
+    }
+
+    if (supportsHtmlInCanvas) {
+      canvas.onpaint = () => {
+        drawScene();
+      };
+    }
+
+    // Scale canvas grid to match the device scale factor to prevent blurriness
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+
+      if (supportsHtmlInCanvas && typeof canvas.requestPaint === 'function') {
+        canvas.requestPaint();
+      } else {
+        drawScene();
+      }
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== 'undefined' &&
+      'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: 'device-pixel-content-box' }
+      : {};
+    observer.observe(canvas, options);
+  </script>
 </body>
 
