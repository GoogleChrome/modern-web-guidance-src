+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocLinks = Array.from(document.querySelectorAll('.toc-sidebar a[href^="#"]'));
+      const sections = Array.from(document.querySelectorAll('.seasonal-panel .drink-section'));
+
+      if (!panel || !tocLinks.length || !sections.length) return;
+
+      let programmaticTargetId = null;
+      let programmaticTimer = null;
+
+      function setActiveDrink(sectionId) {
+        if (!sectionId) return;
+
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + sectionId;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        sections.forEach((section) => {
+          const isMatch = section.id === sectionId;
+          section.classList.toggle('active', isMatch);
+          if (isMatch) {
+            section.setAttribute('data-active', 'true');
+          } else {
+            section.removeAttribute('data-active');
+          }
+        });
+      }
+
+      function updateActiveFromScroll() {
+        const panelRect = panel.getBoundingClientRect();
+        let closestSection = sections[0];
+        let minDistance = Infinity;
+
+        sections.forEach((section) => {
+          const rect = section.getBoundingClientRect();
+          const distance = Math.abs(rect.top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        });
+
+        if (programmaticTargetId) {
+          if (closestSection && closestSection.id === programmaticTargetId && minDistance < 20) {
+            programmaticTargetId = null;
+            if (programmaticTimer) {
+              clearTimeout(programmaticTimer);
+              programmaticTimer = null;
+            }
+          } else {
+            return;
+          }
+        }
+
+        if (closestSection) {
+          setActiveDrink(closestSection.id);
+        }
+      }
+
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          const targetId = link.getAttribute('href').slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          programmaticTargetId = targetId;
+          if (programmaticTimer) clearTimeout(programmaticTimer);
+          programmaticTimer = setTimeout(() => {
+            programmaticTargetId = null;
+            updateActiveFromScroll();
+          }, 900);
+
+          setActiveDrink(targetId);
+
+          panel.scrollTo({
+            top: targetSection.offsetTop,
+            behavior: 'smooth'
+          });
+        });
+      });
+
+      panel.addEventListener('scroll', updateActiveFromScroll, { passive: true });
+      panel.addEventListener('scrollend', () => {
+        programmaticTargetId = null;
+        if (programmaticTimer) {
+          clearTimeout(programmaticTimer);
+          programmaticTimer = null;
+        }
+        updateActiveFromScroll();
+      });
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            if (programmaticTargetId) return;
+            entries.forEach((entry) => {
+              if (entry.isIntersecting && entry.intersectionRatio >= 0.55) {
+                setActiveDrink(entry.target.id);
+              }
+            });
+          },
+          {
+            root: panel,
+            threshold: [0.55, 0.75, 0.95]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      updateActiveFromScroll();
+    })();
+  </script>
+
 </body>
 
