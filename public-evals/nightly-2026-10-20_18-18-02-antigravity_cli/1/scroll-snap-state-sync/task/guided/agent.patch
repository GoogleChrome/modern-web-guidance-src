+  <script>
+    (() => {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocLinks = document.querySelectorAll('.toc-sidebar a');
+      const sections = document.querySelectorAll('.seasonal-panel .drink-section');
+      const headers = document.querySelectorAll('.seasonal-panel .drink-section h3');
+
+      if (!panel || !tocLinks.length || !sections.length) return;
+
+      const setSelectedSection = (sectionId) => {
+        if (!sectionId) return;
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === `#${sectionId}`;
+          link.classList.toggle('active', isMatch);
+          link.classList.toggle(':target-current', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      };
+
+      const resolveSectionId = (el) => {
+        if (!el) return null;
+        const article = el.closest('.drink-section') || el;
+        return article.id || null;
+      };
+
+      // 1. Native Scroll Snap Event (scrollsnapchange)
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const snappedTarget = event.snapTargetBlock;
+        const sectionId = resolveSectionId(snappedTarget);
+        if (sectionId) {
+          setSelectedSection(sectionId);
+        }
+      });
+
+      // 2. Sync with CSS :target-current if scroll-target-group is supported
+      if (typeof CSS !== 'undefined' && CSS.supports && CSS.supports('scroll-target-group: auto')) {
+        const syncTargetCurrent = () => {
+          const currentLink = document.querySelector('.toc-sidebar a:target-current');
+          if (currentLink) {
+            const href = currentLink.getAttribute('href') || '';
+            setSelectedSection(href.replace(/^#/, ''));
+          }
+        };
+        panel.addEventListener('scrollend', syncTargetCurrent);
+      }
+
+      // 3. Fallback for browsers without scrollsnapchange support
+      if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+        const observer = new IntersectionObserver(
+          () => {
+            const panelRect = panel.getBoundingClientRect();
+            const topEntry = [...sections].reduce((currentTop, section) => {
+              const { bottom } = section.getBoundingClientRect();
+              if (bottom <= panelRect.top) return currentTop;
+              if (!currentTop) return section;
+              return bottom < currentTop.getBoundingClientRect().bottom
+                ? section
+                : currentTop;
+            }, undefined);
+            if (topEntry) {
+              setSelectedSection(topEntry.id);
+            }
+          },
+          { root: panel, threshold: [0.1, 0.5, 0.9] }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+        headers.forEach((header) => observer.observe(header));
+      }
+
+      // 4. Smoothly scroll the panel to the section when any TOC link is clicked
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+          const targetId = href.slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          event.preventDefault();
+          setSelectedSection(targetId);
+          targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
+        });
+      });
+    })();
+  </script>
+
