+  <script>
+    (function () {
+      const themeSwitcher = document.getElementById('theme-switcher');
+      const metaColorScheme = document.querySelector('meta[name="color-scheme"]');
+      const rootElement = document.documentElement;
+
+      function applyTheme(scheme, persist = true) {
+        const validScheme = (scheme === 'light' || scheme === 'dark') ? scheme : 'light dark';
+
+        if (metaColorScheme) {
+          metaColorScheme.content = validScheme;
+        }
+
+        // Force the chosen theme on the root element
+        if (validScheme === 'light' || validScheme === 'dark') {
+          rootElement.style.colorScheme = validScheme;
+          rootElement.setAttribute('data-theme', validScheme);
+        } else {
+          rootElement.style.removeProperty('color-scheme');
+          rootElement.removeAttribute('data-theme');
+        }
+
+        if (themeSwitcher && themeSwitcher.value !== validScheme) {
+          themeSwitcher.value = validScheme;
+        }
+
+        if (persist) {
+          try {
+            if (validScheme === 'light dark') {
+              localStorage.removeItem('color-scheme');
+            } else {
+              localStorage.setItem('color-scheme', validScheme);
+            }
+          } catch (e) {}
+        }
+      }
+
+      // Initialize select dropdown from current state
+      try {
+        const stored = localStorage.getItem('color-scheme');
+        if (stored === 'light' || stored === 'dark') {
+          applyTheme(stored, false);
+        } else {
+          applyTheme('light dark', false);
+        }
+      } catch (e) {
+        applyTheme('light dark', false);
+      }
+
+      if (themeSwitcher) {
+        themeSwitcher.addEventListener('change', (e) => {
+          applyTheme(e.target.value, true);
+        });
+      }
+
+      // Keep tabs synchronized if localStorage changes in another tab
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          applyTheme(e.newValue ?? 'light dark', false);
+        }
+      });
+
+      // Interactive filtering for the Late Night Specials select menu
+      const lateNightFilter = document.getElementById('late-night-filter');
+      const lateNightItems = document.querySelectorAll('#late-night-list .special-item');
+
+      if (lateNightFilter) {
+        lateNightFilter.addEventListener('change', (e) => {
+          const category = e.target.value;
+          lateNightItems.forEach((item) => {
+            if (category === 'all' || item.dataset.category === category) {
+              item.style.display = '';
+            } else {
+              item.style.display = 'none';
+            }
+          });
+        });
+      }
+    })();
+  </script>
