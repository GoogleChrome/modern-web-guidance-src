+  <script>
+    function updateMapleLatteCountdown() {
+      const remainingEl = document.getElementById('countdown-remaining');
+      const elapsedEl = document.getElementById('countdown-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      const timeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(timeZone);
+
+      const promoStart = Temporal.ZonedDateTime.from(`2026-02-01T00:00:00[${timeZone}]`);
+      const promoEnd = Temporal.ZonedDateTime.from(`2026-03-01T00:00:00[${timeZone}]`);
+
+      const remaining = now.until(promoEnd, { largestUnit: 'days' });
+      const elapsed = now.since(promoStart, { largestUnit: 'days' });
+
+      if (Temporal.ZonedDateTime.compare(now, promoEnd) >= 0) {
+        remainingEl.textContent = `Offer ended (0 days, 0 hours left)`;
+      } else {
+        remainingEl.textContent = `${remaining.days} days, ${remaining.hours} hours left until offer ends`;
+      }
+
+      elapsedEl.textContent = `${elapsed.days} days, ${elapsed.hours} hours elapsed since promotion started`;
+    }
+
+    document.addEventListener('DOMContentLoaded', updateMapleLatteCountdown);
+  </script>
