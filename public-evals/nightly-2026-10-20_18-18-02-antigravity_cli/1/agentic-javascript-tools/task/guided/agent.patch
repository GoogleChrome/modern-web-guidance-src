diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,92 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const menuItems = [
+      {
+        name: "Maple Oat Latte",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        category: "Seasonal",
+        price: "$5.50",
+        calories: 210,
+        ingredients: ["Espresso", "Steamed Oat Milk", "Vermont Maple Syrup", "Cinnamon"],
+        url: "/menu/seasonal"
+      },
+      {
+        name: "Dark Roast Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        category: "Espresso",
+        price: "$3.25",
+        calories: 5,
+        ingredients: ["100% Arabica Dark Roast Coffee Beans", "Water"],
+        url: "/menu/espresso"
+      },
+      {
+        name: "Cold Brew",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        category: "Cold Coffee",
+        price: "$4.50",
+        calories: 10,
+        ingredients: ["Coarse-Ground Artisanal Coffee Beans", "Filtered Cold Water"],
+        url: "/menu/cold-brew"
+      }
+    ];
+
+    if ("modelContext" in document) {
+      const controller = new AbortController();
+
+      document.modelContext.registerTool(
+        {
+          name: "get_menu_item_details",
+          description: "Looks up details for a menu item by name. Use when the user asks for information about a drink on the menu.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              itemName: {
+                type: "string",
+                description: "Name of the menu item to look up."
+              }
+            },
+            required: ["itemName"]
+          },
+          execute(input) {
+            const rawName = input && typeof input.itemName === "string" ? input.itemName.trim() : "";
+            if (!rawName) {
+              return {
+                error: "Pass the name of the menu item to look up.",
+                availableItems: menuItems.map((entry) => entry.name)
+              };
+            }
+
+            const normalizedQuery = rawName.toLowerCase();
+            const item =
+              menuItems.find((entry) => entry.name.toLowerCase() === normalizedQuery) ||
+              menuItems.find((entry) => entry.name.toLowerCase().includes(normalizedQuery));
+
+            if (!item) {
+              return {
+                error: `Menu item "${rawName}" not found.`,
+                availableItems: menuItems.map((entry) => entry.name)
+              };
+            }
+
+            return item;
+          },
+          annotations: {
+            readOnlyHint: true
+          }
+        },
+        { signal: controller.signal }
+      );
+
+      const cleanupToolRegistration = () => {
+        controller.abort();
+      };
+      window.addEventListener("pagehide", cleanupToolRegistration);
+      window.addEventListener("unload", cleanupToolRegistration);
+    }
+  </script>
 </body>
 
 </html>
