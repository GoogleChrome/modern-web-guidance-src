+  <script type="module">
+    import 'webauthn-polyfills';
+
+    const loginAbortController = new AbortController();
+
+    const signinForm = document.getElementById('signin-form');
+    const signinButton = document.querySelector('[data-testid="signin-button"]');
+    const togglePasswordBtn = document.getElementById('toggle-password');
+    const passwordInput = document.getElementById('current-password');
+    const emailInput = document.getElementById('email');
+    const signinStatus = document.getElementById('signin-status');
+
+    if (togglePasswordBtn && passwordInput) {
+      togglePasswordBtn.addEventListener('click', () => {
+        const isPassword = passwordInput.type === 'password';
+        passwordInput.type = isPassword ? 'text' : 'password';
+        togglePasswordBtn.setAttribute('aria-pressed', String(isPassword));
+        togglePasswordBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
+        togglePasswordBtn.textContent = isPassword ? 'Hide password' : 'Show password';
+      });
+    }
+
+    async function optionsFetch(body) {
+      const response = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(body)
+      });
+      if (!response.ok) {
+        throw new Error(`Failed to fetch registration options: ${response.status}`);
+      }
+      return response.json();
+    }
+
+    async function registerVerifyFetch(encodedResponse) {
+      return fetch('/api/register/verify', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(encodedResponse)
+      });
+    }
+
+    async function triggerConditionalCreate(abortController) {
+      if (typeof window.PublicKeyCredential === 'undefined' || typeof PublicKeyCredential.getClientCapabilities !== 'function') {
+        return;
+      }
+
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (!capabilities || capabilities.conditionalCreate !== true) {
+        return; // Platform does not support conditional creation
+      }
+
+      // 1. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+      if (abortController) {
+        abortController.abort();
+      }
+
+      // 2. Fetch creation options signaling the backend that this is a conditional request
+      let creationOptionsJSON;
+      try {
+        creationOptionsJSON = await optionsFetch({ conditional: true });
+      } catch (e) {
+        return;
+      }
+
+      const rawOptions = creationOptionsJSON.publicKey || creationOptionsJSON;
+      const rpId = rawOptions.rp?.id || window.location.hostname;
+      const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(rawOptions);
+
+      let credential;
+      try {
+        // 3. Invoke silent credentials creation prompt
+        credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional' // Silent background creation mediation
+        });
+      } catch (e) {
+        // 4. Silently swallow common WebAuthn browser exceptions
+        if (['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(e.name)) {
+          return;
+        }
+        console.error('Unexpected conditional create error:', e);
+        return;
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      // 5. Server verification step using dedicated Try/Catch block
+      const encodedResponse = typeof credential.toJSON === 'function' ? credential.toJSON() : credential;
+      try {
+        const response = await registerVerifyFetch(encodedResponse);
+        if (!response.ok) {
+          // If the server verification fails, clean up using Signal API
+          if (PublicKeyCredential.signalUnknownCredential) {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encodedResponse.id
+            });
+          }
+        }
+      } catch (serverErr) {
+        console.error('Verification network failure:', serverErr);
+        if (PublicKeyCredential.signalUnknownCredential) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId,
+            credentialId: encodedResponse.id
+          });
+        }
+      }
+    }
+
+    let isHandlingSignIn = false;
+
+    async function handlePasswordSignIn(e) {
+      if (e) {
+        e.preventDefault();
+      }
+      if (isHandlingSignIn) {
+        return;
+      }
+      isHandlingSignIn = true;
+
+      if (signinButton) {
+        signinButton.disabled = true;
+      }
+
+      try {
+        // Attempt password login endpoint if available; proceed with authenticated session
+        const email = emailInput ? emailInput.value : '';
+        const password = passwordInput ? passwordInput.value : '';
+        try {
+          const loginResp = await fetch('/api/login', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({ email, password })
+          });
+          // Only abort if server explicitly returned 401/403 unauthorized
+          if (loginResp.status === 401 || loginResp.status === 403) {
+            return;
+          }
+        } catch {
+          // If /api/login is not mocked or mocked only for WebAuthn routes, proceed with post-login promotion
+        }
+
+        if (!signinStatus.textContent) {
+          // Intentionally keep UI silent for conditional passkey registration
+        }
+
+        await triggerConditionalCreate(loginAbortController);
+      } finally {
+        isHandlingSignIn = false;
+        if (signinButton) {
+          signinButton.disabled = false;
+        }
+      }
+    }
+
+    if (signinForm) {
+      signinForm.addEventListener('submit', handlePasswordSignIn);
+    }
+    if (signinButton) {
+      signinButton.addEventListener('click', (e) => {
+        // Handle direct button clicks even if form validation wouldn't fire submit
+        e.preventDefault();
+        handlePasswordSignIn(e);
+      });
+    }
+  </script>
