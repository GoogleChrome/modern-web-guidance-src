+  <script>
+    (function () {
+      const board = document.getElementById('order-board');
+      if (!board) return;
+
+      const columns = Array.from(board.querySelectorAll('.board-column'));
+      let draggedCard = null;
+
+      function getCardContainer(column) {
+        return column.querySelector('.column-cards') || column;
+      }
+
+      // Reparent node using atomic moveBefore() when supported to preserve element/focus/animation state,
+      // falling back to insertBefore() in older browsers.
+      function reparentCard(targetContainer, cardNode, referenceNode = null) {
+        if ('moveBefore' in Element.prototype) {
+          targetContainer.moveBefore(cardNode, referenceNode);
+        } else {
+          targetContainer.insertBefore(cardNode, referenceNode);
+        }
+      }
+
+      function updateColumnState() {
+        columns.forEach((col, colIndex) => {
+          const cards = col.querySelectorAll('.card');
+          const countBadge = col.querySelector('.column-count');
+          if (countBadge) {
+            countBadge.textContent = String(cards.length);
+          }
+
+          cards.forEach((card) => {
+            const prevBtn = card.querySelector('[data-action="prev"]');
+            const nextBtn = card.querySelector('[data-action="next"]');
+            if (prevBtn) prevBtn.disabled = colIndex === 0;
+            if (nextBtn) nextBtn.disabled = colIndex === columns.length - 1;
+          });
+        });
+      }
+
+      function moveItemToColumn(itemId, columnId, referenceNode = null) {
+        const item = document.getElementById(itemId);
+        const column = document.getElementById(columnId) || board.querySelector(`.board-column[data-status="${columnId}"]`);
+        if (!item || !column) return;
+
+        const targetContainer = getCardContainer(column);
+        reparentCard(targetContainer, item, referenceNode);
+        updateColumnState();
+      }
+
+      // Expose helper for programmatic updates
+      window.moveItemToColumn = moveItemToColumn;
+
+      board.addEventListener('dragstart', (event) => {
+        const card = event.target.closest('.card');
+        if (!card) return;
+
+        draggedCard = card;
+        card.classList.add('dragging');
+        if (event.dataTransfer) {
+          event.dataTransfer.effectAllowed = 'move';
+          event.dataTransfer.setData('text/plain', card.id);
+        }
+      });
+
+      board.addEventListener('dragend', () => {
+        if (draggedCard) {
+          draggedCard.classList.remove('dragging');
+          draggedCard = null;
+        }
+        columns.forEach((col) => col.classList.remove('drag-over'));
+      });
+
+      columns.forEach((column) => {
+        column.addEventListener('dragover', (event) => {
+          event.preventDefault();
+          if (event.dataTransfer) {
+            event.dataTransfer.dropEffect = 'move';
+          }
+          column.classList.add('drag-over');
+        });
+
+        column.addEventListener('dragleave', (event) => {
+          if (!column.contains(event.relatedTarget)) {
+            column.classList.remove('drag-over');
+          }
+        });
+
+        column.addEventListener('drop', (event) => {
+          event.preventDefault();
+          column.classList.remove('drag-over');
+
+          const cardId = event.dataTransfer ? event.dataTransfer.getData('text/plain') : '';
+          const card = draggedCard || (cardId ? document.getElementById(cardId) : null);
+          if (!card) return;
+
+          const targetContainer = getCardContainer(column);
+          const afterElement = getDragAfterElement(targetContainer, event.clientY);
+
+          reparentCard(targetContainer, card, afterElement);
+          updateColumnState();
+        });
+      });
+
+      function getDragAfterElement(container, y) {
+        const draggableElements = [...container.querySelectorAll('.card:not(.dragging)')];
+        let closest = { offset: Number.NEGATIVE_INFINITY, element: null };
+
+        for (const child of draggableElements) {
+          const box = child.getBoundingClientRect();
+          const offset = y - box.top - box.height / 2;
+          if (offset < 0 && offset > closest.offset) {
+            closest = { offset, element: child };
+          }
+        }
+        return closest.element;
+      }
+
+      // Keyboard / button stage movement
+      board.addEventListener('click', (event) => {
+        const btn = event.target.closest('.btn-move');
+        if (!btn || btn.disabled) return;
+
+        const card = btn.closest('.card');
+        const currentColumn = btn.closest('.board-column');
+        if (!card || !currentColumn) return;
+
+        const currentIndex = columns.indexOf(currentColumn);
+        const targetIndex = btn.dataset.action === 'next' ? currentIndex + 1 : currentIndex - 1;
+        const targetColumn = columns[targetIndex];
+
+        if (targetColumn) {
+          const targetContainer = getCardContainer(targetColumn);
+          reparentCard(targetContainer, card, null);
+          updateColumnState();
+          btn.focus();
+        }
+      });
+
+      updateColumnState();
+    })();
+  </script>
 </body>
 
