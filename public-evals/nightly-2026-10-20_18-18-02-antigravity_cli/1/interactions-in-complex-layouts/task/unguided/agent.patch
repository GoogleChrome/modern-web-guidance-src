+  <script>
+    (function () {
+      const board = document.getElementById('kanban-board');
+      if (!board) return;
+
+      const columns = {
+        queued: {
+          el: document.getElementById('col-queued'),
+          list: document.querySelector('[data-column-list="queued"]'),
+          count: document.getElementById('count-queued')
+        },
+        brewing: {
+          el: document.getElementById('col-brewing'),
+          list: document.querySelector('[data-column-list="brewing"]'),
+          count: document.getElementById('count-brewing')
+        },
+        ready: {
+          el: document.getElementById('col-ready'),
+          list: document.querySelector('[data-column-list="ready"]'),
+          count: document.getElementById('count-ready')
+        }
+      };
+
+      let draggedCard = null;
+      let activeColumnEl = null;
+      let rafId = null;
+      let nextOrderId = 106;
+
+      // Cached vertical midpoints for cards in the target column during drag
+      // Prevents layout thrashing (repeated getBoundingClientRect calls on every dragover event)
+      let cachedColumnStatus = null;
+      let cachedCardPositions = [];
+
+      const dropIndicator = document.createElement('div');
+      dropIndicator.className = 'drop-indicator';
+
+      function updateCounts() {
+        for (const key of ['queued', 'brewing', 'ready']) {
+          const col = columns[key];
+          if (col && col.list && col.count) {
+            col.count.textContent = String(col.list.querySelectorAll('.card').length);
+          }
+        }
+      }
+
+      function cacheColumnPositions(columnStatus) {
+        const col = columns[columnStatus];
+        if (!col || !col.list) return;
+        cachedColumnStatus = columnStatus;
+        const cards = col.list.querySelectorAll('.card');
+        cachedCardPositions = [];
+        for (let i = 0; i < cards.length; i++) {
+          const card = cards[i];
+          if (card === draggedCard) continue;
+          const rect = card.getBoundingClientRect();
+          cachedCardPositions.push({
+            card: card,
+            midY: rect.top + rect.height / 2
+          });
+        }
+      }
+
+      function getInsertBeforeElement(clientY) {
+        for (let i = 0; i < cachedCardPositions.length; i++) {
+          if (clientY < cachedCardPositions[i].midY) {
+            return cachedCardPositions[i].card;
+          }
+        }
+        return null;
+      }
+
+      // Event delegation on the board container
+      board.addEventListener('dragstart', function (e) {
+        const card = e.target.closest('.board-column .card');
+        if (!card) return;
+
+        draggedCard = card;
+        cachedColumnStatus = null;
+
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', card.dataset.orderId || '');
+        }
+
+        requestAnimationFrame(function () {
+          if (draggedCard) {
+            draggedCard.classList.add('dragging');
+          }
+        });
+      });
+
+      board.addEventListener('dragend', function () {
+        if (rafId) {
+          cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        if (draggedCard) {
+          draggedCard.classList.remove('dragging');
+          draggedCard = null;
+        }
+        if (activeColumnEl) {
+          activeColumnEl.classList.remove('drag-over');
+          activeColumnEl = null;
+        }
+        if (dropIndicator.parentNode) {
+          dropIndicator.parentNode.removeChild(dropIndicator);
+        }
+        cachedColumnStatus = null;
+        cachedCardPositions = [];
+      });
+
+      board.addEventListener('dragover', function (e) {
+        if (!draggedCard) return;
+        const colEl = e.target.closest('.board-column');
+        if (!colEl) return;
+
+        e.preventDefault();
+        if (e.dataTransfer) {
+          e.dataTransfer.dropEffect = 'move';
+        }
+
+        const clientY = e.clientY;
+        const status = colEl.dataset.status;
+
+        if (activeColumnEl !== colEl) {
+          if (activeColumnEl) {
+            activeColumnEl.classList.remove('drag-over');
+          }
+          activeColumnEl = colEl;
+          activeColumnEl.classList.add('drag-over');
+          cacheColumnPositions(status);
+        } else if (cachedColumnStatus !== status) {
+          cacheColumnPositions(status);
+        }
+
+        if (!rafId) {
+          rafId = requestAnimationFrame(function () {
+            rafId = null;
+            if (!draggedCard || !activeColumnEl) return;
+            const listEl = columns[status] ? columns[status].list : activeColumnEl.querySelector('.column-cards');
+            if (!listEl) return;
+
+            const beforeEl = getInsertBeforeElement(clientY);
+            if (beforeEl) {
+              if (dropIndicator.nextSibling !== beforeEl || dropIndicator.parentNode !== listEl) {
+                listEl.insertBefore(dropIndicator, beforeEl);
+              }
+            } else {
+              if (dropIndicator.parentNode !== listEl || dropIndicator.nextSibling !== null) {
+                listEl.appendChild(dropIndicator);
+              }
+            }
+          });
+        }
+      });
+
+      board.addEventListener('dragleave', function (e) {
+        const colEl = e.target.closest('.board-column');
+        if (!colEl) return;
+        if (!colEl.contains(e.relatedTarget)) {
+          colEl.classList.remove('drag-over');
+          if (activeColumnEl === colEl) {
+            activeColumnEl = null;
+            cachedColumnStatus = null;
+          }
+        }
+      });
+
+      board.addEventListener('drop', function (e) {
+        const colEl = e.target.closest('.board-column');
+        if (!colEl || !draggedCard) return;
+
+        e.preventDefault();
+        const status = colEl.dataset.status;
+        const listEl = columns[status] ? columns[status].list : colEl.querySelector('.column-cards');
+        if (!listEl) return;
+
+        if (cachedColumnStatus !== status) {
+          cacheColumnPositions(status);
+        }
+
+        const beforeEl = getInsertBeforeElement(e.clientY);
+
+        requestAnimationFrame(function () {
+          if (dropIndicator.parentNode) {
+            dropIndicator.parentNode.removeChild(dropIndicator);
+          }
+
+          if (beforeEl && beforeEl.parentNode === listEl) {
+            listEl.insertBefore(draggedCard, beforeEl);
+          } else {
+            listEl.appendChild(draggedCard);
+          }
+
+          draggedCard.dataset.status = status;
+          draggedCard.classList.remove('dragging');
+          colEl.classList.remove('drag-over');
+
+          updateCounts();
+
+          draggedCard = null;
+          activeColumnEl = null;
+          cachedColumnStatus = null;
+          cachedCardPositions = [];
+        });
+      });
+
+      // Order creation helpers using DocumentFragment for zero-reflow batch insertions
+      const DRINKS = [
+        { name: 'Maple Oat Latte', details: 'Large • Extra Hot • Oat Milk' },
+        { name: 'Dark Roast Espresso', details: 'Double Shot • Ceramic Cup' },
+        { name: 'Cold Brew', details: 'Medium • Light Ice • Sweet Cream' },
+        { name: 'Caramel Macchiato', details: 'Medium • Iced • Blonde Roast' },
+        { name: 'Matcha Green Latte', details: 'Small • Almond Milk • Unsweetened' }
+      ];
+      const CUSTOMERS = ['Jordan P.', 'Sam W.', 'Riley C.', 'Avery B.', 'Quinn D.', 'Harper G.', 'Skyler N.'];
+      const CHANNELS = ['Mobile', 'In-Store', 'Drive-Thru', 'Pickup Counter'];
+
+      function createOrderCardElement(orderId, drink, customer, channel, status) {
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.draggable = true;
+        card.dataset.orderId = String(orderId);
+        card.dataset.status = status;
+
+        card.innerHTML =
+          '<div class="card-header">' +
+            '<span class="order-id">#' + orderId + '</span>' +
+            '<span class="order-time">Just now</span>' +
+          '</div>' +
+          '<h3>' + drink.name + '</h3>' +
+          '<p>' + drink.details + '</p>' +
+          '<div class="order-meta">' +
+            '<span>For: ' + customer + '</span>' +
+            '<span class="order-badge">' + channel + '</span>' +
+          '</div>';
+
+        return card;
+      }
+
+      function addOrdersBatch(count) {
+        const fragment = document.createDocumentFragment();
+        for (let i = 0; i < count; i++) {
+          const drink = DRINKS[(nextOrderId + i) % DRINKS.length];
+          const customer = CUSTOMERS[(nextOrderId + i) % CUSTOMERS.length];
+          const channel = CHANNELS[(nextOrderId + i) % CHANNELS.length];
+          const card = createOrderCardElement(nextOrderId++, drink, customer, channel, 'queued');
+          fragment.appendChild(card);
+        }
+
+        requestAnimationFrame(function () {
+          columns.queued.list.appendChild(fragment);
+          updateCounts();
+        });
+      }
+
+      const addOrderBtn = document.getElementById('add-order-btn');
+      if (addOrderBtn) {
+        addOrderBtn.addEventListener('click', function () {
+          addOrdersBatch(1);
+        });
+      }
+
+      const addBulkBtn = document.getElementById('add-bulk-btn');
+      if (addBulkBtn) {
+        addBulkBtn.addEventListener('click', function () {
+          addOrdersBatch(50);
+        });
+      }
+    })();
+  </script>
 </body>
 
