+/**
+ * The Daily Grind — Reusable UI Components Library
+ *
+ * Provides custom elements (Web Components) and programmatic UI helpers
+ * that work directly in the browser without a build step.
+ *
+ * Components included:
+ *  - <dg-navbar>           Responsive site navigation bar with cart trigger
+ *  - <dg-hero>             Configurable hero banner section
+ *  - <dg-button>           Reusable button / link action element
+ *  - <dg-badge>            Status and category pill badge
+ *  - <dg-product-card>     Menu item / product card with customization & cart actions
+ *  - <dg-location-card>    Cafe branch card with hours, address, and status badge
+ *  - <dg-testimonial>      Customer review card with star rating and avatar
+ *  - <dg-reward-progress>  Loyalty points progress tracker widget
+ *  - <dg-tabs>             Interactive category filter / tab switcher
+ *  - <dg-input>            Form input / select / textarea wrapper with validation
+ *  - <dg-quantity>         Numeric stepper control (+ / -)
+ *  - <dg-alert>            Dismissible contextual alert banner
+ *  - <dg-accordion>        Collapsible FAQ item
+ *  - <dg-modal>            Accessible dialog modal
+ *  - <dg-cart-drawer>      Slide-over shopping bag drawer
+ *  - <dg-footer>           Site footer with navigation links
+ */
+
+const escapeHtml = (str = '') =>
+  String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;');
+
+/* ==========================================================================
+   Shared Application State / Event Bus (Cart & Toast Notifications)
+   ========================================================================== */
+
+export const DailyGrindUI = {
+  cart: [
+    { id: 'maple-oat-latte', title: 'Maple Oat Latte', price: 5.75, size: 'Medium (12oz)', milk: 'Oat Milk', qty: 1 }
+  ],
+
+  getCartCount() {
+    return this.cart.reduce((sum, item) => sum + item.qty, 0);
+  },
+
+  getCartSubtotal() {
+    return this.cart.reduce((sum, item) => sum + item.price * item.qty, 0);
+  },
+
+  addToCart(item) {
+    const key = `${item.id || item.title}-${item.size || 'Medium'}-${item.milk || 'Standard'}`;
+    const existing = this.cart.find(
+      (i) => `${i.id || i.title}-${i.size || 'Medium'}-${i.milk || 'Standard'}` === key
+    );
+    if (existing) {
+      existing.qty += item.qty || 1;
+    } else {
+      this.cart.push({
+        id: item.id || item.title.toLowerCase().replace(/\s+/g, '-'),
+        title: item.title,
+        price: Number(item.price) || 4.5,
+        size: item.size || 'Medium (12oz)',
+        milk: item.milk || 'Oat Milk',
+        qty: Number(item.qty) || 1
+      });
+    }
+    window.dispatchEvent(new CustomEvent('dg:cart-updated', { detail: { cart: this.cart } }));
+    this.toast(`Added "${item.title}" to your order`, 'success');
+  },
+
+  updateQuantity(index, delta) {
+    if (!this.cart[index]) return;
+    this.cart[index].qty += delta;
+    if (this.cart[index].qty <= 0) {
+      this.cart.splice(index, 1);
+    }
+    window.dispatchEvent(new CustomEvent('dg:cart-updated', { detail: { cart: this.cart } }));
+  },
+
+  clearCart() {
+    this.cart = [];
+    window.dispatchEvent(new CustomEvent('dg:cart-updated', { detail: { cart: this.cart } }));
+  },
+
+  toast(message, variant = 'info') {
+    let stack = document.querySelector('.toast-stack');
+    if (!stack) {
+      stack = document.createElement('div');
+      stack.className = 'toast-stack';
+      stack.setAttribute('aria-live', 'polite');
+      document.body.appendChild(stack);
+    }
+
+    const toastEl = document.createElement('div');
+    toastEl.className = `toast toast-${escapeHtml(variant)}`;
+    toastEl.innerHTML = `
+      <span>${escapeHtml(message)}</span>
+      <button type="button" class="alert-close" aria-label="Dismiss notification">&times;</button>
+    `;
+
+    const remove = () => {
+      toastEl.remove();
+    };
+    toastEl.querySelector('button').addEventListener('click', remove);
+    stack.appendChild(toastEl);
+    setTimeout(remove, 3800);
+  },
+
+  openModal(modalId) {
+    const modal = document.getElementById(modalId) || document.querySelector('dg-modal');
+    if (modal && typeof modal.open === 'function') {
+      modal.open();
+    }
+  },
+
+  openCart() {
+    const drawer = document.querySelector('dg-cart-drawer');
+    if (drawer && typeof drawer.open === 'function') {
+      drawer.open();
+    }
+  }
+};
+
+window.DailyGrindUI = DailyGrindUI;
+
+/* ==========================================================================
+   1. <dg-navbar> — Responsive Navigation Bar Component
+   ========================================================================== */
+
+export class DgNavbar extends HTMLElement {
+  connectedCallback() {
+    this.render();
+    this._onCartUpdate = () => {
+      const badge = this.querySelector('.nav-cart-count');
+      if (badge) badge.textContent = DailyGrindUI.getCartCount();
+    };
+    window.addEventListener('dg:cart-updated', this._onCartUpdate);
+  }
+
+  disconnectedCallback() {
+    window.removeEventListener('dg:cart-updated', this._onCartUpdate);
+  }
+
+  render() {
+    const brand = this.getAttribute('brand') || 'THE DAILY GRIND';
+    const active = this.getAttribute('active') || '';
+    const showCart = this.getAttribute('show-cart') !== 'false';
+
+    const links = [
+      { href: '/menu', label: 'Menu', key: 'menu' },
+      { href: '/locations', label: 'Locations', key: 'locations' },
+      { href: '/rewards', label: 'Rewards', key: 'rewards' },
+      { href: '/account', label: 'My Account', key: 'account' }
+    ];
+
+    this.innerHTML = `
+      <nav class="dg-nav" aria-label="Main Navigation">
+        <a href="/" class="logo">
+          <span class="logo-icon" aria-hidden="true">&#9749;</span>
+          <span>${escapeHtml(brand)}</span>
+        </a>
+        <button type="button" class="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
+          &#9776;
+        </button>
+        <ul>
+          ${links
+            .map(
+              (link) => `
+            <li>
+              <a href="${link.href}" class="${active === link.key ? 'active' : ''}">${escapeHtml(link.label)}</a>
+            </li>`
+            )
+            .join('')}
+          ${
+            showCart
+              ? `<li>
+                  <button type="button" class="nav-cart-btn" data-action="open-cart" aria-label="Open order bag">
+                    <span>Order Bag</span>
+                    <span class="nav-cart-count">${DailyGrindUI.getCartCount()}</span>
+                  </button>
+                </li>`
+              : ''
+          }
+          <li><a href="/logout" class="logout-link">Logout</a></li>
+        </ul>
+      </nav>
+    `;
+
+    const toggle = this.querySelector('.nav-toggle');
+    const list = this.querySelector('ul');
+    if (toggle && list) {
+      toggle.addEventListener('click', () => {
+        const isOpen = list.classList.toggle('open');
+        toggle.setAttribute('aria-expanded', String(isOpen));
+      });
+    }
+
+    const cartBtn = this.querySelector('[data-action="open-cart"]');
+    if (cartBtn) {
+      cartBtn.addEventListener('click', () => DailyGrindUI.openCart());
+    }
+  }
+}
+
+/* ==========================================================================
+   2. <dg-hero> — Configurable Hero Banner Component
+   ========================================================================== */
+
+export class DgHero extends HTMLElement {
+  connectedCallback() {
+    const title = this.getAttribute('title') || 'Wake Up Your Senses';
+    const subtitle =
+      this.getAttribute('subtitle') ||
+      'Ethically sourced, locally roasted, delivered to your cup.';
+    const ctaText = this.getAttribute('cta-text') || 'Order Now';
+    const ctaHref = this.getAttribute('cta-href') || '/order-online';
