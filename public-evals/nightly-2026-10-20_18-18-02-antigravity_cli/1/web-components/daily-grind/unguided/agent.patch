+/* ==========================================================================
+   9. <dg-tabs> — Interactive Category Filter / Tab Switcher
+   ========================================================================== */
+
+export class DgTabs extends HTMLElement {
+  connectedCallback() {
+    const rawTabs = this.getAttribute('tabs') || 'All:all,Seasonal:seasonal,Espresso:espresso,Cold Brew:cold-brew';
+    const activeTab = this.getAttribute('active') || 'all';
+    const targetSelector = this.getAttribute('target') || '';
+
+    const tabs = rawTabs.split(',').map((item) => {
+      const [label, value] = item.trim().split(':');
+      return { label: label.trim(), value: (value || label).trim().toLowerCase() };
+    });
+
+    this.innerHTML = `
+      <div class="tabs-bar" role="tablist">
+        ${tabs
+          .map(
+            (t) => `
+          <button
+            type="button"
+            role="tab"
+            class="tab-btn ${t.value === activeTab ? 'active' : ''}"
+            aria-selected="${t.value === activeTab}"
+            data-tab-value="${escapeHtml(t.value)}"
+          >
+            ${escapeHtml(t.label)}
+          </button>`
+          )
+          .join('')}
+      </div>
+    `;
+
+    this.querySelectorAll('.tab-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const val = btn.getAttribute('data-tab-value');
+        this.querySelectorAll('.tab-btn').forEach((b) => {
+          b.classList.toggle('active', b === btn);
+          b.setAttribute('aria-selected', String(b === btn));
+        });
+
+        if (targetSelector) {
+          const container = document.querySelector(targetSelector);
+          if (container) {
+            container.querySelectorAll('[data-category]').forEach((item) => {
+              const cats = item.getAttribute('data-category').split(',').map((c) => c.trim());
+              const match = val === 'all' || cats.includes(val);
+              item.style.display = match ? '' : 'none';
+            });
+          }
+        }
+
+        this.dispatchEvent(new CustomEvent('dg:tab-change', { bubbles: true, detail: { value: val } }));
+      });
+    });
+  }
+}
+
+/* ==========================================================================
+   10. <dg-input> — Form Field Component (Text, Email, Select, Textarea)
+   ========================================================================== */
+
+export class DgInput extends HTMLElement {
+  connectedCallback() {
+    const label = this.getAttribute('label') || '';
+    const type = this.getAttribute('type') || 'text';
+    const name = this.getAttribute('name') || 'field';
+    const placeholder = this.getAttribute('placeholder') || '';
+    const value = this.getAttribute('value') || '';
+    const hint = this.getAttribute('hint') || '';
+    const error = this.getAttribute('error') || '';
+    const options = this.getAttribute('options') || '';
+    const required = this.hasAttribute('required');
+
+    const inputId = `dg-field-${name}-${Math.random().toString(36).slice(2, 7)}`;
+
+    let controlHtml = '';
+    if (type === 'select') {
+      const opts = options.split(',').map((o) => {
+        const [optLabel, optVal] = o.trim().split(':');
+        const v = (optVal || optLabel).trim();
+        return `<option value="${escapeHtml(v)}" ${v === value ? 'selected' : ''}>${escapeHtml(optLabel.trim())}</option>`;
+      });
+      controlHtml = `<select id="${inputId}" name="${escapeHtml(name)}" class="form-control ${error ? 'is-invalid' : ''}">${opts.join('')}</select>`;
+    } else if (type === 'textarea') {
+      controlHtml = `<textarea id="${inputId}" name="${escapeHtml(name)}" rows="3" placeholder="${escapeHtml(placeholder)}" class="form-control ${error ? 'is-invalid' : ''}">${escapeHtml(value)}</textarea>`;
+    } else {
+      controlHtml = `<input id="${inputId}" type="${escapeHtml(type)}" name="${escapeHtml(name)}" value="${escapeHtml(value)}" placeholder="${escapeHtml(placeholder)}" ${required ? 'required' : ''} class="form-control ${error ? 'is-invalid' : ''}" />`;
+    }
+
+    this.innerHTML = `
+      <div class="form-group">
+        ${label ? `<label class="form-label" for="${inputId}">${escapeHtml(label)}${required ? ' *' : ''}</label>` : ''}
+        ${controlHtml}
+        ${error ? `<span class="form-error">${escapeHtml(error)}</span>` : hint ? `<span class="form-hint">${escapeHtml(hint)}</span>` : ''}
+      </div>
+    `;
+  }
+}
+
+/* ==========================================================================
+   11. <dg-quantity> — Quantity Stepper Component
+   ========================================================================== */
+
+export class DgQuantity extends HTMLElement {
+  connectedCallback() {
+    this.value = parseInt(this.getAttribute('value') || '1', 10);
+    this.min = parseInt(this.getAttribute('min') || '1', 10);
+    this.max = parseInt(this.getAttribute('max') || '20', 10);
+    this.render();
+  }
+
+  render() {
+    this.innerHTML = `
+      <div class="qty-stepper" role="group" aria-label="Quantity selector">
+        <button type="button" class="qty-btn" data-dir="-1" ${this.value <= this.min ? 'disabled' : ''} aria-label="Decrease quantity">&minus;</button>
+        <span class="qty-value" aria-live="polite">${this.value}</span>
+        <button type="button" class="qty-btn" data-dir="1" ${this.value >= this.max ? 'disabled' : ''} aria-label="Increase quantity">+</button>
+      </div>
+    `;
+
+    this.querySelectorAll('.qty-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const delta = parseInt(btn.getAttribute('data-dir'), 10);
+        const next = Math.min(this.max, Math.max(this.min, this.value + delta));
+        if (next !== this.value) {
+          this.value = next;
+          this.setAttribute('value', String(this.value));
+          this.render();
+          this.dispatchEvent(new CustomEvent('dg:quantity-change', { bubbles: true, detail: { value: this.value } }));
+        }
+      });
+    });
+  }
+}
+
+/* ==========================================================================
+   12. <dg-alert> — Dismissible Contextual Alert Banner
+   ========================================================================== */
+
+export class DgAlert extends HTMLElement {
+  connectedCallback() {
+    const variant = this.getAttribute('variant') || 'info';
+    const title = this.getAttribute('title') || '';
+    const dismissible = this.getAttribute('dismissible') !== 'false';
+    const message = this.innerHTML.trim() || this.getAttribute('message') || '';
+
+    this.innerHTML = `
+      <div class="alert alert-${escapeHtml(variant)}" role="status">
+        <div>
+          ${title ? `<strong style="display:block; margin-bottom: 2px;">${escapeHtml(title)}</strong>` : ''}
+          <span>${message}</span>
+        </div>
+        ${dismissible ? `<button type="button" class="alert-close" aria-label="Dismiss alert">&times;</button>` : ''}
+      </div>
+    `;
+
+    const closeBtn = this.querySelector('.alert-close');
+    if (closeBtn) {
+      closeBtn.addEventListener('click', () => this.remove());
+    }
+  }
+}
+
+/* ==========================================================================
+   13. <dg-accordion> — Collapsible FAQ Item Component
+   ========================================================================== */
+
+export class DgAccordion extends HTMLElement {
+  connectedCallback() {
+    const question = this.getAttribute('question') || 'Frequently Asked Question';
+    const answer = this.getAttribute('answer') || this.innerHTML.trim();
+    const isOpen = this.hasAttribute('open');
+
+    this.innerHTML = `
+      <div class="accordion-item ${isOpen ? 'open' : ''}">
+        <button type="button" class="accordion-trigger" aria-expanded="${isOpen}">
+          <span>${escapeHtml(question)}</span>
+          <span class="accordion-icon" aria-hidden="true">${isOpen ? '−' : '+'}</span>
+        </button>
+        <div class="accordion-content">
+          <p>${escapeHtml(answer)}</p>
+        </div>
+      </div>
+    `;
+
+    const item = this.querySelector('.accordion-item');
+    const trigger = this.querySelector('.accordion-trigger');
+    const icon = this.querySelector('.accordion-icon');
+
+    trigger.addEventListener('click', () => {
+      const nowOpen = item.classList.toggle('open');
+      trigger.setAttribute('aria-expanded', String(nowOpen));
+      icon.textContent = nowOpen ? '−' : '+';
+    });
+  }
+}
+
+/* ==========================================================================
+   14. <dg-modal> — Accessible Customization / Dialog Modal Component
+   ========================================================================== */
+
+export class DgModal extends HTMLElement {
+  connectedCallback() {
+    const title = this.getAttribute('title') || 'Customize Your Drink';
+    this.innerHTML = `
+      <div class="modal-backdrop" role="dialog" aria-modal="true" aria-label="${escapeHtml(title)}">
+        <div class="modal-dialog">
+          <div class="modal-header">
+            <h3>${escapeHtml(title)}</h3>
+            <button type="button" class="alert-close" data-modal-close aria-label="Close modal">&times;</button>
+          </div>
+          <form class="modal-body" id="dg-customize-form">
+            <dg-input
+              type="select"
+              name="drink"
+              label="Select Beverage"
+              options="Maple Oat Latte:Maple Oat Latte,Dark Roast Espresso:Dark Roast Espresso,18-Hour Cold Brew:Cold Brew,Honey Cinnamon Cortado:Honey Cinnamon Cortado"
+            ></dg-input>
+            <dg-input
+              type="select"
+              name="size"
+              label="Cup Size"
+              options="Small (8oz):Small (8oz),Medium (12oz):Medium (12oz),Large (16oz):Large (16oz)"
+              value="Medium (12oz)"
+            ></dg-input>
+            <dg-input
+              type="select"
+              name="milk"
+              label="Milk Preference"
+              options="Barista Oat Milk:Oat Milk,Whole Dairy:Whole Milk,Almond Milk:Almond Milk,No Milk (Black):Black"
+              value="Oat Milk"
+            ></dg-input>
+            <dg-input
+              type="text"
+              name="notes"
+              label="Special Instructions"
+              placeholder="e.g. Extra hot, light ice, half sweet"
+              hint="Our baristas craft every cup to order."
+            ></dg-input>
+          </form>
+          <div class="modal-footer">
+            <button type="button" class="btn btn-ghost" data-modal-close>Cancel</button>
+            <button type="button" class="btn" data-modal-submit>Add Customized Drink ($5.75)</button>
+          </div>
+        </div>
+      </div>
+    `;
+
+    const backdrop = this.querySelector('.modal-backdrop');
+    this.querySelectorAll('[data-modal-close]').forEach((btn) =>
+      btn.addEventListener('click', () => this.close())
+    );
+    backdrop.addEventListener('click', (e) => {
+      if (e.target === backdrop) this.close();
+    });
+
+    const submitBtn = this.querySelector('[data-modal-submit]');
+    if (submitBtn) {
+      submitBtn.addEventListener('click', () => {
+        const form = this.querySelector('#dg-customize-form');
+        const fd = new FormData(form);
+        DailyGrindUI.addToCart({
+          title: fd.get('drink') || 'Maple Oat Latte',
+          size: fd.get('size') || 'Medium (12oz)',
+          milk: fd.get('milk') || 'Oat Milk',
+          price: 5.75,
+          qty: 1
+        });
+        this.close();
+      });
+    }
+  }
+
+  open() {
+    const backdrop = this.querySelector('.modal-backdrop');
+    if (backdrop) backdrop.classList.add('open');
+  }
+
+  close() {
+    const backdrop = this.querySelector('.modal-backdrop');
+    if (backdrop) backdrop.classList.remove('open');
+  }
+}
+
+/* ==========================================================================
+   15. <dg-cart-drawer> — Slide-Over Order Bag Drawer Component
+   ========================================================================== */
+
+export class DgCartDrawer extends HTMLElement {
+  connectedCallback() {
+    this.render();
+    this._onUpdate = () => this.renderItems();
+    window.addEventListener('dg:cart-updated', this._onUpdate);
+  }
+
+  disconnectedCallback() {
+    window.removeEventListener('dg:cart-updated', this._onUpdate);
+  }
+
+  render() {
+    this.innerHTML = `
+      <div class="drawer-backdrop" aria-hidden="true">
+        <aside class="drawer-panel" aria-label="Your Coffee Order Bag">
+          <div class="modal-header">
+            <h3>Your Order Bag</h3>
+            <button type="button" class="alert-close" data-drawer-close aria-label="Close bag">&times;</button>
+          </div>
+          <div class="modal-body" style="flex: 1; overflow-y: auto;" data-cart-items></div>
+          <div class="modal-footer" style="flex-direction: column; align-items: stretch; gap: 12px;">
+            <div class="flex-between" style="font-weight: 700; font-size: 1.05rem;">
+              <span>Estimated Subtotal</span>
+              <span data-cart-subtotal>$0.00</span>
+            </div>
+            <div class="flex-row" style="gap: 8px;">
+              <a href="/order-online" class="btn" style="flex: 1;">Proceed to Checkout</a>
+              <button type="button" class="btn btn-outline" data-clear-cart>Clear</button>
+            </div>
+          </div>
+        </aside>
+      </div>
+    `;
+
+    const backdrop = this.querySelector('.drawer-backdrop');
+    this.querySelector('[data-drawer-close]').addEventListener('click', () => this.close());
+    backdrop.addEventListener('click', (e) => {
+      if (e.target === backdrop) this.close();
+    });
+    this.querySelector('[data-clear-cart]').addEventListener('click', () => {
+      DailyGrindUI.clearCart();
+      DailyGrindUI.toast('Order bag cleared', 'info');
+    });
+
+    this.renderItems();
+  }
+
+  renderItems() {
+    const listEl = this.querySelector('[data-cart-items]');
+    const subtotalEl = this.querySelector('[data-cart-subtotal]');
+    if (!listEl || !subtotalEl) return;
+
+    const items = DailyGrindUI.cart;
+    subtotalEl.textContent = `$${DailyGrindUI.getCartSubtotal().toFixed(2)}`;
+
+    if (items.length === 0) {
+      listEl.innerHTML = `
+        <div style="text-align: center; padding: 40px 10px; color: var(--text-muted);">
+          <p style="font-size: 1.05rem; margin-bottom: 8px;">Your order bag is empty.</p>
+          <p style="font-size: 0.88rem;">Add a seasonal latte or single-origin espresso to get started!</p>
+        </div>
+      `;
+      return;
+    }
+
+    listEl.innerHTML = items
+      .map(
+        (item, idx) => `
+        <div class="drawer-item">
+          <div>
+            <div style="font-weight: 700; color: var(--primary);">${escapeHtml(item.title)}</div>
+            <div style="font-size: 0.8rem; color: var(--text-muted);">${escapeHtml(item.size)} &bull; ${escapeHtml(item.milk)}</div>
+            <div style="font-size: 0.85rem; font-weight: 600; margin-top: 2px;">$${(item.price * item.qty).toFixed(2)}</div>
+          </div>
+          <div class="qty-stepper">
+            <button type="button" class="qty-btn" data-cart-idx="${idx}" data-delta="-1" aria-label="Remove one">&minus;</button>
+            <span class="qty-value">${item.qty}</span>
+            <button type="button" class="qty-btn" data-cart-idx="${idx}" data-delta="1" aria-label="Add one">+</button>
+          </div>
+        </div>
+      `
+      )
+      .join('');
+
+    listEl.querySelectorAll('[data-cart-idx]').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const idx = parseInt(btn.getAttribute('data-cart-idx'), 10);
+        const delta = parseInt(btn.getAttribute('data-delta'), 10);
+        DailyGrindUI.updateQuantity(idx, delta);
+      });
+    });
+  }
+
+  open() {
+    const backdrop = this.querySelector('.drawer-backdrop');
+    if (backdrop) backdrop.classList.add('open');
+  }
+
+  close() {
+    const backdrop = this.querySelector('.drawer-backdrop');
+    if (backdrop) backdrop.classList.remove('open');
+  }
+}
+
+/* ==========================================================================
+   16. <dg-footer> — Reusable Site Footer Component
+   ========================================================================== */
+
+export class DgFooter extends HTMLElement {
+  connectedCallback() {
+    const year = this.getAttribute('year') || '2026';
+    const company = this.getAttribute('company') || 'The Daily Grind Coffee Co.';
+
+    this.innerHTML = `
+      <footer class="dg-footer">
+        <div class="footer-links">
+          <a href="/about">Our Story</a> |
+          <a href="/careers">Join the Team</a> |
+          <a href="/contact">Contact Us</a> |
+          <a href="/privacy-policy">Privacy</a>
+        </div>
+        <p>&copy; ${escapeHtml(year)} ${escapeHtml(company)} All rights reserved.</p>
+      </footer>
+    `;
+  }
+}
+
+/* ==========================================================================
+   Register All Custom Elements Safely
+   ========================================================================== */
+
+const COMPONENT_REGISTRY = [
+  ['dg-navbar', DgNavbar],
+  ['dg-hero', DgHero],
+  ['dg-button', DgButton],
+  ['dg-badge', DgBadge],
+  ['dg-product-card', DgProductCard],
+  ['dg-location-card', DgLocationCard],
+  ['dg-testimonial', DgTestimonial],
+  ['dg-reward-progress', DgRewardProgress],
+  ['dg-tabs', DgTabs],
+  ['dg-input', DgInput],
+  ['dg-quantity', DgQuantity],
+  ['dg-alert', DgAlert],
+  ['dg-accordion', DgAccordion],
+  ['dg-modal', DgModal],
+  ['dg-cart-drawer', DgCartDrawer],
+  ['dg-footer', DgFooter]
+];
+
+export function registerDailyGrindComponents() {
+  COMPONENT_REGISTRY.forEach(([tagName, ctor]) => {
+    if (!customElements.get(tagName)) {
+      customElements.define(tagName, ctor);
+    }
+  });
+}
+
+registerDailyGrindComponents();
