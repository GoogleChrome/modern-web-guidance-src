+    const pct = Math.min(100, Math.round((points / goal) * 100));
+    const remaining = Math.max(0, goal - points);
+
+    this.innerHTML = `
+      <div class="reward-widget">
+        <div class="reward-header">
+          <div>
+            <span class="badge badge-accent" style="margin-bottom: 6px;">${escapeHtml(tier)} Tier</span>
+            <h3 style="color: white; font-size: 1.3rem;">Daily Grind Rewards</h3>
+          </div>
+          <div style="text-align: right;">
+            <span class="reward-points">${points}</span>
+            <span style="font-size: 0.9rem; opacity: 0.85;"> / ${goal} Beans</span>
+          </div>
+        </div>
+        <div class="progress-track" role="progressbar" aria-valuenow="${points}" aria-valuemin="0" aria-valuemax="${goal}">
+          <div class="progress-fill" style="width: ${pct}%;"></div>
+        </div>
+        <div class="reward-milestones">
+          <span>${remaining > 0 ? `${remaining} Beans until your next free handcrafted drink!` : 'Free drink reward unlocked!'}</span>
+          <span>${pct}%</span>
+        </div>
+      </div>
+    `;
+  }
+}
