+            ? `<div class="card-media">
+                <img src="${escapeHtml(image)}" alt="${escapeHtml(title)}" loading="lazy" />
+                ${
+                  badge
+                    ? `<div class="card-badge-overlay">
+                        <span class="badge badge-${escapeHtml(badgeVariant)}">${escapeHtml(badge)}</span>
+                      </div>`
+                    : ''
+                }
+                ${price ? `<span class="card-price-tag">$${escapeHtml(price)}</span>` : ''}
+              </div>`
+            : ''
+        }
+        <div class="card-body">
+          ${!image && badge ? `<div style="margin-bottom:8px;"><span class="badge badge-${escapeHtml(badgeVariant)}">${escapeHtml(badge)}</span></div>` : ''}
+          <h3>${escapeHtml(title)}</h3>
+          <p>${escapeHtml(description)}</p>
+          ${
+            roast || calories
+              ? `<div class="card-meta">
+                  ${roast ? `<span>Roast: <strong>${escapeHtml(roast)}</strong></span>` : '<span></span>'}
+                  ${calories ? `<span>${escapeHtml(calories)} cal</span>` : ''}
+                </div>`
+              : ''
+          }
+          <div class="card-footer">
+            <a href="${escapeHtml(href)}" class="btn ${enableQuickAdd && price ? 'btn-outline btn-sm' : ''}" style="flex:1;">
+              ${escapeHtml(ctaText)}
+            </a>
+            ${
+              enableQuickAdd && price
+                ? `<button type="button" class="btn btn-sm" data-action="quick-add" style="flex:1;">
+                    + Quick Add
+                  </button>`
+                : ''
+            }
+          </div>
+        </div>
+      </article>
+    `;
+
+    const quickAddBtn = this.querySelector('[data-action="quick-add"]');
+    if (quickAddBtn) {
+      quickAddBtn.addEventListener('click', () => {
+        DailyGrindUI.addToCart({
+          title,
+          price: parseFloat(price) || 4.75
+        });
+      });
+    }
+  }
+}
