+/* ==========================================================================
+   The Daily Grind — Design Tokens & Reusable CSS Component System
+   ========================================================================== */
+
+:root {
+  /* Brand Colors */
+  --primary: #4e342e;
+  --primary-hover: #3e2723;
+  --primary-light: #7b5e57;
+  --secondary: #d7ccc8;
+  --secondary-light: #efebe9;
+  --accent: #ffab40;
+  --accent-hover: #ff9100;
+  --text: #3e2723;
+  --text-muted: #6d4c41;
+  --light: #fafafa;
+  --surface: #ffffff;
+  --border: #e0d6d2;
+
+  /* Semantic Colors */
+  --success: #2e7d32;
+  --success-bg: #e8f5e9;
+  --warning: #ef6c00;
+  --warning-bg: #fff3e0;
+  --danger: #c62828;
+  --danger-bg: #ffebee;
+  --info: #1565c0;
+  --info-bg: #e3f2fd;
+
+  /* Typography */
+  --font-sans: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  --font-serif: Georgia, 'Times New Roman', serif;
+
+  /* Spacing & Sizing */
+  --radius-sm: 4px;
+  --radius-md: 8px;
+  --radius-lg: 14px;
+  --radius-pill: 9999px;
+
+  /* Shadows */
+  --shadow-sm: 0 2px 5px rgba(62, 39, 35, 0.08);
+  --shadow-md: 0 6px 16px rgba(62, 39, 35, 0.12);
+  --shadow-lg: 0 14px 32px rgba(62, 39, 35, 0.18);
+
+  /* Transitions */
+  --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: var(--font-sans);
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+  -webkit-font-smoothing: antialiased;
+}
+
+/* ==========================================================================
+   Layout & Containers
+   ========================================================================== */
+
+.container {
+  max-width: 1140px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.section {
+  margin-bottom: 56px;
+}
+
+.section-header {
+  text-align: center;
+  margin-bottom: 32px;
+}
+
+.section-header h2 {
+  font-size: 2rem;
+  color: var(--primary);
+  margin-bottom: 8px;
+}
+
+.section-header p {
+  color: var(--text-muted);
+  max-width: 600px;
+  margin: 0 auto;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 24px;
+  margin-top: 20px;
+}
+
+.grid-2 {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
+  gap: 24px;
+}
+
+.flex-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.flex-between {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+/* ==========================================================================
+   Navigation Component (nav / dg-navbar)
+   ========================================================================== */
+
+nav,
+.dg-nav {
+  background: var(--primary);
+  color: white;
+  padding: 0.9rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  box-shadow: var(--shadow-sm);
+}
+
+.logo {
+  font-size: 1.45rem;
+  font-weight: 800;
+  letter-spacing: 1.2px;
+  color: white;
+  text-decoration: none;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.logo-icon {
+  color: var(--accent);
+  font-size: 1.3rem;
+}
+
+nav ul,
+.dg-nav ul {
+  display: flex;
+  align-items: center;
+  list-style: none;
+  gap: 20px;
+}
+
+nav a,
+.dg-nav a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.92rem;
+  font-weight: 500;
+  transition: color var(--transition), background var(--transition);
+}
+
+nav a:hover,
+.dg-nav a:hover,
+nav a.active,
+.dg-nav a.active {
+  color: var(--accent);
+}
+
+.logout-link {
