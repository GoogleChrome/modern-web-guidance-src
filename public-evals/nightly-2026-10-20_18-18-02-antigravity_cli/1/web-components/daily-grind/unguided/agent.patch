+/* ==========================================================================
+   8. <dg-reward-progress> — Loyalty Points Tracker Component
+   ========================================================================== */
+
+export class DgRewardProgress extends HTMLElement {
+  static get observedAttributes() {
+    return ['points', 'goal', 'tier'];
+  }
+
+  connectedCallback() {
+    this.render();
+  }
+
+  attributeChangedCallback() {
+    if (this.isConnected) this.render();
+  }
+
+  render() {
+    const points = parseInt(this.getAttribute('points') || '140', 10);
+    const goal = parseInt(this.getAttribute('goal') || '200', 10);
