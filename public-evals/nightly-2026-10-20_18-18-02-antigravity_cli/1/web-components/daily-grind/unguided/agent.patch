+/* ==========================================================================
+   3. <dg-button> — Reusable Button / Link Action Component
+   ========================================================================== */
+
+export class DgButton extends HTMLElement {
+  static get observedAttributes() {
+    return ['variant', 'size', 'href', 'disabled', 'block'];
+  }
+
+  connectedCallback() {
+    if (!this._initialContent) {
+      this._initialContent = this.innerHTML.trim() || this.getAttribute('label') || 'Action';
+    }
+    this.render();
+  }
+
+  attributeChangedCallback() {
+    if (this.isConnected) this.render();
+  }
+
+  render() {
+    const variant = this.getAttribute('variant') || 'primary';
+    const size = this.getAttribute('size') || 'md';
+    const href = this.getAttribute('href');
+    const disabled = this.hasAttribute('disabled');
+    const block = this.hasAttribute('block');
+
+    const classes = ['btn'];
+    if (variant !== 'primary') classes.push(`btn-${variant}`);
+    if (size === 'sm' || size === 'lg') classes.push(`btn-${size}`);
+    if (block) classes.push('btn-block');
+
+    if (href) {
+      this.innerHTML = `<a href="${escapeHtml(href)}" class="${classes.join(' ')}" ${
+        disabled ? 'aria-disabled="true" tabindex="-1"' : ''
+      }>${this._initialContent}</a>`;
+    } else {
+      this.innerHTML = `<button type="button" class="${classes.join(' ')}" ${
+        disabled ? 'disabled' : ''
+      }>${this._initialContent}</button>`;
+    }
+  }
+}
+
+/* ==========================================================================
+   4. <dg-badge> — Status & Category Badge Component
+   ========================================================================== */
+
+export class DgBadge extends HTMLElement {
+  connectedCallback() {
+    const variant = this.getAttribute('variant') || 'default';
+    const text = this.textContent.trim() || this.getAttribute('label') || '';
+    const cls = variant === 'default' ? 'badge' : `badge badge-${escapeHtml(variant)}`;
+    this.innerHTML = `<span class="${cls}">${escapeHtml(text)}</span>`;
+  }
+}
