diff --git a/components/dg-cart-drawer.js b/components/dg-cart-drawer.js
new file mode 100644
index 0000000..2d65ff4
--- /dev/null
+++ b/components/dg-cart-drawer.js
@@ -0,0 +1,537 @@
+/**
+ * `<dg-cart-drawer>` — Slide-out Shopping Bag / Order Drawer Web Component
+ *
+ * Uses a modal `<dialog closedby="any">` anchored to the right edge of the viewport
+ * with top-layer entry/exit animations and full keyboard/backdrop dismissal.
+ */
+
+import { attachDialogLightDismiss, closeDialogWithAnimation } from './top-layer-utils.js';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer base {
+    :host {
+      display: contents;
+      --_drawer-bg: var(--drawer-bg, #ffffff);
+      --_drawer-fg: var(--drawer-fg, var(--text, #3e2723));
+      --_drawer-primary: var(--drawer-primary, var(--primary, #4e342e));
+      --_drawer-accent: var(--drawer-accent, var(--accent, #ffab40));
+      --_drawer-border: var(--drawer-border, var(--border, #e0d6d2));
+    }
+
+    dialog {
+      margin: 0 0 0 auto;
+      padding: 0;
+      border: none;
+      border-left: 1px solid var(--_drawer-border);
+      background: var(--_drawer-bg);
+      color: var(--_drawer-fg);
+      width: min(92vw, 400px);
+      height: 100dvh;
+      max-height: 100dvh;
+      box-shadow: -12px 0 36px rgba(0, 0, 0, 0.22);
+      opacity: 0;
+      transform: translateX(100%);
+      transition-property: opacity, transform, display, overlay;
+      transition-duration: 0.28s;
+      transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+      transition-behavior: allow-discrete;
+    }
+
+    dialog::backdrop {
+      background-color: rgba(30, 18, 14, 0);
+      backdrop-filter: blur(0px);
+      transition-property: background-color, backdrop-filter, display, overlay;
+      transition-duration: 0.28s;
+      transition-timing-function: ease-out;
+      transition-behavior: allow-discrete;
+    }
+
+    :is(dialog[open]):where(:not([data-closing])) {
+      opacity: 1;
+      transform: translateX(0);
+
+      @starting-style {
+        opacity: 0;
+        transform: translateX(100%);
+      }
+
+      &::backdrop {
+        background-color: rgba(30, 18, 14, 0.5);
+        backdrop-filter: blur(2px);
+
+        @starting-style {
+          background-color: rgba(30, 18, 14, 0);
+          backdrop-filter: blur(0px);
+        }
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      dialog {
+        transform: none;
+        transition-duration: 0.1s;
+      }
+
+      @starting-style {
+        :is(dialog[open]):where(:not([data-closing])) {
+          transform: none;
+        }
+      }
+    }
+
+    .drawer-layout {
+      display: flex;
+      flex-direction: column;
+      height: 100%;
+    }
+
+    header {
+      padding: 1.25rem 1.5rem;
+      border-bottom: 1px solid var(--_drawer-border);
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      background: #fafafa;
+    }
+
+    h2 {
+      margin: 0;
+      font-size: 1.2rem;
+      color: var(--_drawer-primary);
+      display: flex;
+      align-items: center;
+      gap: 0.5rem;
+    }
+
+    .close-btn {
+      font: inherit;
+      width: 2rem;
+      height: 2rem;
+      border-radius: 50%;
+      border: 1px solid var(--_drawer-border);
+      background: #ffffff;
+      color: var(--_drawer-primary);
+      cursor: pointer;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      font-size: 1.15rem;
+    }
+
+    .close-btn:hover {
+      background: #efebe9;
+    }
+
+    .items-list {
+      flex: 1;
+      overflow-y: auto;
+      padding: 1.25rem 1.5rem;
+      display: flex;
+      flex-direction: column;
+      gap: 1rem;
+    }
+
+    .empty-state {
+      text-align: center;
+      color: #6d4c41;
+      margin: auto 0;
+      padding: 2rem 1rem;
+    }
+
+    .empty-icon {
+      font-size: 2.5rem;
+      margin-bottom: 0.5rem;
+      opacity: 0.6;
+    }
+
+    .cart-item {
+      display: flex;
+      gap: 0.85rem;
+      padding-bottom: 1rem;
+      border-bottom: 1px solid var(--_drawer-border);
+      align-items: center;
+    }
+
+    .cart-item img {
+      width: 60px;
+      height: 60px;
+      border-radius: 8px;
+      object-fit: cover;
+      background: #efebe9;
+      flex-shrink: 0;
+    }
+
+    .item-info {
+      flex: 1;
+      min-width: 0;
+    }
+
+    .item-name {
+      font-weight: 700;
+      color: var(--_drawer-primary);
+      font-size: 0.95rem;
+      margin: 0 0 0.15rem;
+    }
+
+    .item-meta {
+      font-size: 0.78rem;
+      color: #6d4c41;
+      margin-bottom: 0.4rem;
+    }
+
+    .qty-controls {
+      display: inline-flex;
+      align-items: center;
+      gap: 0.45rem;
+      border: 1px solid var(--_drawer-border);
+      border-radius: 6px;
+      padding: 0.1rem 0.35rem;
+      background: #fafafa;
+    }
+
+    .qty-btn {
+      font: inherit;
+      border: none;
+      background: transparent;
+      color: var(--_drawer-primary);
+      font-weight: 700;
+      cursor: pointer;
+      padding: 0.1rem 0.35rem;
+      font-size: 0.9rem;
+    }
+
+    .qty-val {
+      font-size: 0.82rem;
+      font-weight: 600;
+      min-width: 1.2rem;
+      text-align: center;
+    }
+
+    .item-price {
+      font-weight: 700;
+      font-size: 0.95rem;
+      color: var(--_drawer-primary);
+    }
+
+    footer {
+      padding: 1.25rem 1.5rem;
+      border-top: 1px solid var(--_drawer-border);
+      background: #fafafa;
+      display: flex;
+      flex-direction: column;
+      gap: 0.85rem;
+    }
+
+    .summary-row {
+      display: flex;
+      justify-content: space-between;
+      font-size: 0.92rem;
+      color: #5d4037;
+    }
+
+    .summary-total {
+      display: flex;
+      justify-content: space-between;
+      font-size: 1.1rem;
+      font-weight: 800;
+      color: var(--_drawer-primary);
+      padding-top: 0.5rem;
+      border-top: 1px dashed var(--_drawer-border);
+    }
+
+    .checkout-btn {
+      font: inherit;
+      width: 100%;
+      padding: 0.8rem 1.2rem;
+      border-radius: 8px;
+      border: none;
+      background: var(--_drawer-primary);
+      color: #ffffff;
+      font-weight: 700;
+      font-size: 0.98rem;
+      cursor: pointer;
+      transition: background-color 0.2s ease;
+    }
+
+    .checkout-btn:hover:not(:disabled) {
+      background: #3e2723;
+    }
+
+    .checkout-btn:disabled {
+      opacity: 0.5;
+      cursor: not-allowed;
+    }
+
+    button:focus-visible {
+      outline: 2px solid var(--_drawer-accent);
+      outline-offset: 2px;
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <dialog part="dialog" closedby="any" aria-labelledby="drawer-title">
+    <div class="drawer-layout" part="surface">
+      <header part="header">
+        <h2 id="drawer-title">
+          <span aria-hidden="true">&#128717;</span>
+          <span>Your Order Bag</span>
+        </h2>
+        <button type="button" class="close-btn" part="close-button" aria-label="Close order bag">
+          &times;
+        </button>
+      </header>
+
+      <div class="items-list" part="items"></div>
+
+      <footer part="footer">
+        <div class="summary-row">
+          <span>Estimated Pickup</span>
+          <strong>In 8–12 mins</strong>
+        </div>
+        <div class="summary-total">
+          <span>Total</span>
+          <span class="total-amount">$0.00</span>
+        </div>
+        <button type="button" class="checkout-btn" part="checkout-button" disabled>
+          Place Pickup Order
+        </button>
+      </footer>
+    </div>
+  </dialog>
+`;
+
+export class DgCartDrawer extends HTMLElement {
+  #items = [];
+  #initialized = false;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+    this.shadowRoot.append(template.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    const dialog = this.#dialog;
+    if (!this.#initialized && dialog) {
+      this.#setupListeners(dialog);
+      this.#initialized = true;
+    }
+    this.#renderItems();
+  }
+
+  get #dialog() {
+    return this.shadowRoot.querySelector('dialog');
+  }
+
+  get items() {
+    return [...this.#items];
+  }
+
+  get totalCount() {
+    return this.#items.reduce((sum, item) => sum + item.quantity, 0);
+  }
+
+  get totalPrice() {
+    return this.#items.reduce((sum, item) => sum + item.price * item.quantity, 0);
+  }
+
+  open() {
+    const dialog = this.#dialog;
+    if (!dialog || dialog.open) return;
+    dialog.showModal();
+  }
+
+  async close() {
+    const dialog = this.#dialog;
+    if (!dialog || !dialog.open) return;
+    await closeDialogWithAnimation(dialog);
+  }
+
+  addItem(product) {
+    const size = product.size || 'Medium (12oz)';
+    const milk = product.milk || 'Oat Milk';
+    const key = `${product.id}__${size}__${milk}`;
+    const existing = this.#items.find((item) => item.key === key);
+
+    if (existing) {
+      existing.quantity += product.quantity || 1;
+    } else {
+      this.#items.push({
+        key,
+        id: product.id,
+        name: product.name,
+        price: Number(product.price) || 0,
+        image: product.image,
+        size,
+        milk,
+        quantity: product.quantity || 1,
+      });
+    }
+
+    this.#renderItems();
+    this.#notifyChange();
+  }
+
+  updateQuantity(key, delta) {
+    const index = this.#items.findIndex((i) => i.key === key);
+    if (index === -1) return;
+    this.#items[index].quantity += delta;
+    if (this.#items[index].quantity <= 0) {
+      this.#items.splice(index, 1);
+    }
+    this.#renderItems();
+    this.#notifyChange();
+  }
+
+  clear() {
+    this.#items = [];
+    this.#renderItems();
+    this.#notifyChange();
+  }
+
+  #notifyChange() {
+    this.dispatchEvent(
+      new CustomEvent('dg-cart-change', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          items: this.items,
+          totalCount: this.totalCount,
+          totalPrice: this.totalPrice,
+        },
+      })
+    );
+  }
+
+  #setupListeners(dialog) {
+    const closeBtn = this.shadowRoot.querySelector('.close-btn');
+    const checkoutBtn = this.shadowRoot.querySelector('.checkout-btn');
+    const listEl = this.shadowRoot.querySelector('.items-list');
+
+    closeBtn?.addEventListener('click', () => this.close());
+
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      this.close();
+    });
+
+    attachDialogLightDismiss(dialog, () => this.close());
+
+    listEl?.addEventListener('click', (e) => {
+      const btn = e.target.closest('button[data-action]');
+      if (!btn) return;
+      const key = btn.dataset.key;
+      const action = btn.dataset.action;
+      if (action === 'inc') {
+        this.updateQuantity(key, 1);
+      } else if (action === 'dec') {
+        this.updateQuantity(key, -1);
+      }
+    });
+
+    checkoutBtn?.addEventListener('click', () => {
+      if (this.#items.length === 0) return;
+      const summary = {
+        items: this.items,
+        totalCount: this.totalCount,
+        totalPrice: this.totalPrice,
+      };
+      this.clear();
+      this.close();
+      this.dispatchEvent(
+        new CustomEvent('dg-checkout', {
+          bubbles: true,
+          composed: true,
+          detail: summary,
+        })
+      );
+    });
+  }
+
+  #renderItems() {
+    const listEl = this.shadowRoot.querySelector('.items-list');
+    const totalEl = this.shadowRoot.querySelector('.total-amount');
+    const checkoutBtn = this.shadowRoot.querySelector('.checkout-btn');
+
+    if (!listEl) return;
+
+    if (this.#items.length === 0) {
+      listEl.innerHTML = `
+        <div class="empty-state">
+          <div class="empty-icon" aria-hidden="true">&#9749;</div>
+          <p><strong>Your coffee bag is empty</strong></p>
+          <p style="font-size: 0.85rem; margin-top: 0.25rem;">Add a seasonal favorite or artisanal roast to start your pickup order.</p>
+        </div>
+      `;
+    } else {
+      listEl.innerHTML = '';
+      for (const item of this.#items) {
+        const row = document.createElement('div');
+        row.className = 'cart-item';
+
+        const img = document.createElement('img');
+        img.src = item.image;
+        img.alt = item.name;
+
+        const info = document.createElement('div');
+        info.className = 'item-info';
+
+        const nameEl = document.createElement('p');
+        nameEl.className = 'item-name';
+        nameEl.textContent = item.name;
+
+        const metaEl = document.createElement('p');
+        metaEl.className = 'item-meta';
+        metaEl.textContent = `${item.size} • ${item.milk}`;
+
+        const controls = document.createElement('div');
+        controls.className = 'qty-controls';
+
+        const decBtn = document.createElement('button');
+        decBtn.type = 'button';
+        decBtn.className = 'qty-btn';
+        decBtn.dataset.action = 'dec';
+        decBtn.dataset.key = item.key;
+        decBtn.setAttribute('aria-label', `Decrease quantity of ${item.name}`);
+        decBtn.textContent = '−';
+
+        const qtyVal = document.createElement('span');
+        qtyVal.className = 'qty-val';
+        qtyVal.textContent = String(item.quantity);
+
+        const incBtn = document.createElement('button');
+        incBtn.type = 'button';
+        incBtn.className = 'qty-btn';
+        incBtn.dataset.action = 'inc';
+        incBtn.dataset.key = item.key;
+        incBtn.setAttribute('aria-label', `Increase quantity of ${item.name}`);
+        incBtn.textContent = '+';
+
+        controls.append(decBtn, qtyVal, incBtn);
+        info.append(nameEl, metaEl, controls);
+
+        const priceEl = document.createElement('div');
+        priceEl.className = 'item-price';
+        priceEl.textContent = `$${(item.price * item.quantity).toFixed(2)}`;
+
+        row.append(img, info, priceEl);
+        listEl.append(row);
+      }
+    }
+
+    if (totalEl) {
+      totalEl.textContent = `$${this.totalPrice.toFixed(2)}`;
+    }
+    if (checkoutBtn) {
+      checkoutBtn.disabled = this.#items.length === 0;
+    }
+  }
+}
+
+if (!customElements.get('dg-cart-drawer')) {
+  customElements.define('dg-cart-drawer', DgCartDrawer);
+}
diff --git a/components/dg-footer.js b/components/dg-footer.js
new file mode 100644
index 0000000..814aaa3
--- /dev/null
+++ b/components/dg-footer.js
@@ -0,0 +1,209 @@
+/**
+ * `<dg-footer>` — Reusable Application Footer Web Component
+ *
+ * Features:
+ * - Semantic `<footer>` layout with brand bio, navigation links, and newsletter subscription
+ * - Dispatches `dg-newsletter-subscribe` custom event when a user signs up
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer base {
+    :host {
+      display: block;
+      margin-top: auto;
+      --_footer-bg: var(--footer-bg, var(--secondary, #d7ccc8));
+      --_footer-fg: var(--footer-fg, var(--text, #3e2723));
+      --_footer-primary: var(--footer-primary, var(--primary, #4e342e));
+      background: var(--_footer-bg);
+      color: var(--_footer-fg);
+    }
+
+    footer {
+      max-width: var(--container-max, 1140px);
+      margin: 0 auto;
+      padding: 2.75rem 1.25rem 2rem;
+      display: flex;
+      flex-direction: column;
+      gap: 2rem;
+    }
+
+    .footer-grid {
+      display: grid;
+      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+      gap: 2rem;
+      text-align: left;
+    }
+
+    .col h3 {
+      margin: 0 0 0.65rem;
+      font-size: 1.05rem;
+      color: var(--_footer-primary);
+    }
+
+    .col p {
+      font-size: 0.88rem;
+      line-height: 1.5;
+      margin: 0;
+    }
+
+    .newsletter-form {
+      display: flex;
+      gap: 0.45rem;
+      margin-top: 0.75rem;
+    }
+
+    .newsletter-form input {
+      font: inherit;
+      flex: 1;
+      min-width: 0;
+      padding: 0.5rem 0.75rem;
+      border-radius: 6px;
+      border: 1px solid rgba(62, 39, 35, 0.25);
+      background: #ffffff;
+      color: var(--_footer-fg);
+      font-size: 0.88rem;
+    }
+
+    .newsletter-form button {
+      font: inherit;
+      padding: 0.5rem 0.95rem;
+      border-radius: 6px;
+      border: none;
+      background: var(--_footer-primary);
+      color: #ffffff;
+      font-weight: 600;
+      font-size: 0.88rem;
+      cursor: pointer;
+      transition: background-color 0.2s ease;
+    }
+
+    .newsletter-form button:hover {
+      background: #3e2723;
+    }
+
+    .bottom-bar {
+      padding-top: 1.5rem;
+      border-top: 1px solid rgba(62, 39, 35, 0.15);
+      text-align: center;
+      display: flex;
+      flex-direction: column;
+      gap: 0.75rem;
+      align-items: center;
+    }
+
+    .footer-links {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      gap: 0.5rem 1.25rem;
+    }
+
+    .footer-links a {
+      color: var(--_footer-fg);
+      text-decoration: none;
+      font-size: 0.88rem;
+      font-weight: 600;
+      transition: color 0.2s ease;
+    }
+
+    .footer-links a:hover {
+      color: var(--_footer-primary);
+      text-decoration: underline;
+    }
+
+    .copyright {
+      font-size: 0.82rem;
+      opacity: 0.85;
+      margin: 0;
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <footer part="footer">
+    <div class="footer-grid">
+      <div class="col">
+        <h3>THE DAILY GRIND</h3>
+        <p>Small-batch specialty coffee ethically sourced from family farms and roasted fresh daily in our neighborhood roastery.</p>
+      </div>
+
+      <div class="col">
+        <h3>Roastery Hours</h3>
+        <p>Mon – Fri: 6:30 AM – 7:00 PM<br>Sat – Sun: 7:00 AM – 8:00 PM</p>
+      </div>
+
+      <div class="col">
+        <h3>Roaster's Notes</h3>
+        <p>Get early access to seasonal single-origin drops and brewing guides.</p>
+        <form class="newsletter-form" part="newsletter-form">
+          <input type="email" name="email" placeholder="you@example.com" aria-label="Email address for newsletter" required />
+          <button type="submit">Join</button>
+        </form>
+      </div>
+    </div>
+
+    <div class="bottom-bar">
+      <nav class="footer-links" aria-label="Footer Navigation" part="links">
+        <a href="/about">Our Story</a>
+        <a href="/careers">Join the Team</a>
+        <a href="/contact">Contact Us</a>
+        <a href="/privacy-policy">Privacy</a>
+      </nav>
+      <p class="copyright" part="copyright">&copy; <span class="year">2026</span> The Daily Grind Coffee Co. All rights reserved.</p>
+    </div>
+  </footer>
+`;
+
+export class DgFooter extends HTMLElement {
+  static observedAttributes = ['year'];
+
+  #initialized = false;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+    this.shadowRoot.append(template.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    if (!this.#initialized) {
+      const form = this.shadowRoot.querySelector('.newsletter-form');
+      form?.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const input = form.querySelector('input[name="email"]');
+        const email = input?.value?.trim();
+        if (!email) return;
+        this.dispatchEvent(
+          new CustomEvent('dg-newsletter-subscribe', {
+            bubbles: true,
+            composed: true,
+            detail: { email },
+          })
+        );
+        form.reset();
+      });
+      this.#initialized = true;
+    }
+    this.#syncYear();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (name === 'year' && oldVal !== newVal) {
+      this.#syncYear();
+    }
+  }
+
+  #syncYear() {
+    const yearEl = this.shadowRoot.querySelector('.year');
+    if (yearEl) {
+      yearEl.textContent = this.getAttribute('year') || '2026';
+    }
+  }
+}
+
+if (!customElements.get('dg-footer')) {
+  customElements.define('dg-footer', DgFooter);
+}
diff --git a/components/dg-modal.js b/components/dg-modal.js
