+/**
+ * Top-layer exit transition helper (`animate-to-from-top-layer` guide).
+ * Detects whether the browser natively transitions `display` and `overlay`
+ * when closing a `<dialog>` or `[popover]`. If unsupported, applies a
+ * `data-closing` attribute and waits for CSS transitions to finish before
+ * calling `.close()` or `.hidePopover()`.
+ */
+
+let supportsDisplayTransition;
+
+export function canTransitionDisplay() {
+  if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+  if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+    return false;
+  }
+  const probe = document.createElement('div');
+  probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+  document.body.appendChild(probe);
+  getComputedStyle(probe).display;
+  probe.style.display = 'none';
+  supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+  probe.remove();
+  return supportsDisplayTransition;
+}
+
+export function supportsTopLayerExit() {
+  return Boolean(window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay());
+}
+
+/**
+ * Smoothly closes a modal `<dialog>` element, falling back to `data-closing`
+ * animation waiting when native discrete top-layer exit transitions are unsupported.
+ *
+ * @param {HTMLDialogElement} dialog
+ * @param {string} [returnValue]
+ */
+export async function closeDialogWithAnimation(dialog, returnValue) {
+  if (!dialog || !dialog.open) return;
+
+  if (!supportsTopLayerExit()) {
+    dialog.setAttribute('data-closing', '');
+    const animations = dialog.getAnimations({ subtree: true });
+    if (animations.length > 0) {
+      await Promise.race([
+        Promise.allSettled(animations.map((a) => a.finished)),
+        new Promise((r) => setTimeout(r, 2000)),
+      ]);
+    }
+    if (!dialog.hasAttribute('data-closing')) return;
+    dialog.removeAttribute('data-closing');
+  }
+
+  dialog.close(returnValue);
+}
+
+/**
+ * Installs a light-dismiss fallback on a `<dialog>` element for browsers
+ * that do not yet support the declarative `closedby="any"` attribute
+ * (`light-dismiss-a-dialog` guide).
+ *
+ * @param {HTMLDialogElement} dialog
+ * @param {(dialog: HTMLDialogElement) => void} [onDismiss]
+ */
+export function attachDialogLightDismiss(dialog, onDismiss) {
+  if ('closedBy' in HTMLDialogElement.prototype) return;
+
+  dialog.addEventListener('click', (event) => {
+    if (event.target !== dialog) return;
+
+    const rect = dialog.getBoundingClientRect();
+    const isDialogContent =
+      rect.top <= event.clientY &&
+      event.clientY <= rect.top + rect.height &&
+      rect.left <= event.clientX &&
+      event.clientX <= rect.left + rect.width;
+
+    if (isDialogContent) return;
+
+    if (onDismiss) {
+      onDismiss(dialog);
+    } else {
+      closeDialogWithAnimation(dialog);
+    }
+  });
+}
