+
+const template = document.createElement('template');
+template.innerHTML = `
+  <dialog part="dialog" closedby="any" aria-labelledby="modal-title">
+    <div class="dialog-surface" part="surface">
+      <header class="modal-header" part="header">
+        <h2 id="modal-title" part="title">Details</h2>
+        <button type="button" class="close-btn" part="close-button" aria-label="Close dialog">
+          &times;
+        </button>
+      </header>
+      <div class="modal-body" part="body">
+        <slot></slot>
+      </div>
+      <footer class="modal-footer" part="footer" hidden>
+        <slot name="footer"></slot>
+      </footer>
+    </div>
+  </dialog>
+`;
+
+export class DgModal extends HTMLElement {
+  static observedAttributes = ['heading', 'open'];
+
+  #initialized = false;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+    this.shadowRoot.append(template.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    const dialog = this.#dialog;
+    if (!this.#initialized && dialog) {
+      this.#setupListeners(dialog);
+      this.#initialized = true;
+    }
+    this.#syncHeading();
+    if (this.hasAttribute('open') && dialog && !dialog.open) {
+      dialog.showModal();
+    }
+  }
+
+  get #dialog() {
+    return this.shadowRoot.querySelector('dialog');
+  }
+
+  get heading() {
+    return this.getAttribute('heading') ?? 'Details';
+  }
+
+  set heading(val) {
+    this.setAttribute('heading', val);
+  }
+
+  get open() {
+    return Boolean(this.#dialog?.open);
+  }
+
+  showModal() {
+    const dialog = this.#dialog;
+    if (!dialog || dialog.open) return;
+    dialog.showModal();
+    this.toggleAttribute('open', true);
+    this.dispatchEvent(new CustomEvent('dg-modal-open', { bubbles: true, composed: true }));
+  }
+
+  async close(returnValue) {
+    const dialog = this.#dialog;
+    if (!dialog || !dialog.open) return;
+    await closeDialogWithAnimation(dialog, returnValue);
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'heading') {
+      this.#syncHeading();
+    } else if (name === 'open') {
+      if (newVal !== null) {
+        this.showModal();
+      } else if (this.#dialog?.open) {
+        this.close();
+      }
+    }
+  }
+
+  #syncHeading() {
+    const titleEl = this.shadowRoot.querySelector('#modal-title');
+    if (titleEl) {
+      titleEl.textContent = this.heading;
+    }
+  }
+
+  #setupListeners(dialog) {
+    const closeBtn = this.shadowRoot.querySelector('.close-btn');
+    const footerSlot = this.shadowRoot.querySelector('slot[name="footer"]');
+    const footerEl = this.shadowRoot.querySelector('.modal-footer');
+
+    closeBtn?.addEventListener('click', () => {
+      this.close('dismiss');
+    });
+
+    footerSlot?.addEventListener('slotchange', () => {
+      const hasFooter = footerSlot.assignedNodes({ flatten: true }).length > 0;
+      if (footerEl) {
+        footerEl.hidden = !hasFooter;
+      }
+    });
+
+    dialog.addEventListener('cancel', (event) => {
+      event.preventDefault();
+      this.close('cancel');
+    });
+
+    dialog.addEventListener('close', () => {
+      this.removeAttribute('open');
+      this.dispatchEvent(
+        new CustomEvent('dg-modal-close', {
+          bubbles: true,
+          composed: true,
+          detail: { returnValue: dialog.returnValue },
+        })
+      );
+    });
+
+    attachDialogLightDismiss(dialog, () => this.close('backdrop'));
+  }
+}
+
+if (!customElements.get('dg-modal')) {
+  customElements.define('dg-modal', DgModal);
+}
