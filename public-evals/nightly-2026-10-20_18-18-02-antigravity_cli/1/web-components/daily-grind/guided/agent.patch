+      line-height: 1.3;
+    }
+
+    .price {
+      font-weight: 800;
+      font-size: 1.05rem;
+      color: var(--_card-primary);
+      white-space: nowrap;
+    }
+
+    .meta {
+      font-size: 0.78rem;
+      color: #6d4c41;
+      display: flex;
+      gap: 0.6rem;
+      align-items: center;
+    }
+
+    .meta[hidden] {
+      display: none;
+    }
+
+    .desc {
+      font-size: 0.92rem;
+      color: #5d4037;
+      line-height: 1.5;
+      flex: 1;
+    }
+
+    ::slotted(p) {
+      margin: 0;
+    }
+
+    .actions {
+      display: flex;
+      gap: 0.5rem;
+      margin-top: 0.75rem;
+      padding-top: 0.75rem;
+      border-top: 1px solid var(--_card-border);
+    }
+
+    .btn-primary,
+    .btn-secondary {
+      font: inherit;
+      font-size: 0.88rem;
+      font-weight: 600;
+      padding: 0.55rem 0.9rem;
+      border-radius: 6px;
+      cursor: pointer;
+      text-decoration: none;
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      gap: 0.35rem;
+      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
+    }
+
+    .btn-primary {
+      flex: 1;
+      background: var(--_card-primary);
+      color: #ffffff;
+      border: 1.5px solid var(--_card-primary);
+    }
+
+    .btn-primary:hover {
+      background: #3e2723;
+      border-color: #3e2723;
+    }
+
+    .btn-secondary {
+      background: transparent;
+      color: var(--_card-primary);
+      border: 1.5px solid var(--_card-border);
+    }
+
+    .btn-secondary:hover {
+      border-color: var(--_card-primary);
+      background: #efebe9;
+    }
+
+    button:focus-visible,
+    a:focus-visible {
+      outline: 2px solid var(--_card-accent);
+      outline-offset: 2px;
+    }
+
+    /* Container query: horizontal layout when placed in wide containers */
+    @container (min-width: 34rem) {
+      article {
+        flex-direction: row;
+        align-items: stretch;
+      }
+
+      .media {
+        width: 42%;
+        aspect-ratio: auto;
+        min-height: 200px;
+      }
+
+      .content {
+        width: 58%;
+      }
+    }
+  }
+`);
+
+const template = document.createElement('template');
+template.innerHTML = `
+  <article part="card">
+    <div class="media" part="media">
+      <img part="image" src="" alt="" loading="lazy" />
+      <span class="badge" part="badge" hidden></span>
+      <button type="button" class="fav-btn" part="favorite-button" aria-label="Save to favorites" aria-pressed="false">
+        <span class="fav-icon" aria-hidden="true">&#9825;</span>
+      </button>
+    </div>
+
+    <div class="content" part="content">
+      <div class="header-row">
+        <h3 part="title"></h3>
+        <span class="price" part="price"></span>
+      </div>
+      <div class="meta" part="meta" hidden></div>
+      <div class="desc" part="description">
+        <slot></slot>
+      </div>
+      <div class="actions" part="actions">
+        <button type="button" class="btn-primary add-btn" part="add-button">
+          Add to Order
+        </button>
+        <a class="btn-secondary details-btn" part="details-button" href="#">
+          View Details
+        </a>
+      </div>
+    </div>
+  </article>
+`;
+
+export class DgProductCard extends HTMLElement {
+  static observedAttributes = [
+    'product-id',
+    'name',
+    'price',
+    'image',
+    'badge',
+    'category',
+    'calories',
+    'href',
+    'favorited',
+  ];
+
+  #internals;
+  #favorited = false;
+  #initialized = false;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals?.();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+    this.shadowRoot.append(template.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    if (!this.#initialized) {
+      this.#setupListeners();
+      this.#initialized = true;
+    }
+    this.#favorited = this.hasAttribute('favorited');
+    this.#syncFavoriteState();
+    this.#syncUI();
+  }
+
+  get productId() {
+    return this.getAttribute('product-id') || this.name.toLowerCase().replace(/\s+/g, '-');
+  }
+
+  set productId(val) {
+    this.setAttribute('product-id', val);
+  }
+
+  get name() {
+    return this.getAttribute('name') ?? '';
+  }
+
+  set name(val) {
+    this.setAttribute('name', val);
+  }
+
+  get price() {
+    return Number(this.getAttribute('price')) || 0;
+  }
+
+  set price(val) {
+    this.setAttribute('price', String(val));
+  }
+
+  get image() {
+    return (
+      this.getAttribute('image') ||
+      'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=800&q=80'
+    );
+  }
+
+  set image(val) {
+    this.setAttribute('image', val);
+  }
+
+  get badge() {
+    return this.getAttribute('badge') ?? '';
+  }
+
+  set badge(val) {
+    if (val) {
+      this.setAttribute('badge', val);
+    } else {
+      this.removeAttribute('badge');
+    }
+  }
+
+  get calories() {
+    return this.getAttribute('calories') ?? '';
+  }
+
+  set calories(val) {
+    if (val) {
+      this.setAttribute('calories', val);
+    } else {
+      this.removeAttribute('calories');
+    }
+  }
+
+  get href() {
+    return this.getAttribute('href') || '#';
+  }
+
+  set href(val) {
+    this.setAttribute('href', val);
+  }
+
+  get favorited() {
+    return this.#favorited;
+  }
+
+  set favorited(val) {
+    const next = Boolean(val);
+    if (this.#favorited === next) return;
+    this.#favorited = next;
+    this.toggleAttribute('favorited', next);
+    this.#syncFavoriteState();
+  }
+
+  markInCart(inCart = true) {
+    if (!this.#internals?.states) return;
+    if (inCart) {
+      this.#internals.states.add('in-cart');
+    } else {
+      this.#internals.states.delete('in-cart');
+    }
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'favorited') {
+      this.#favorited = newVal !== null;
+      this.#syncFavoriteState();
+      return;
+    }
+    this.#syncUI();
+  }
+
+  getProductData() {
+    const slot = this.shadowRoot.querySelector('slot');
+    const assigned = slot?.assignedNodes({ flatten: true }) || [];
+    const description = assigned
+      .map((n) => n.textContent)
+      .join(' ')
+      .trim();
+
+    return {
+      id: this.productId,
+      name: this.name,
+      price: this.price,
+      image: this.image,
+      badge: this.badge,
+      calories: this.calories,
+      href: this.href,
+      description,
+    };
+  }
+
+  #setupListeners() {
+    const addBtn = this.shadowRoot.querySelector('.add-btn');
+    const detailsBtn = this.shadowRoot.querySelector('.details-btn');
+    const favBtn = this.shadowRoot.querySelector('.fav-btn');
+
+    addBtn?.addEventListener('click', () => {
+      this.markInCart(true);
+      this.dispatchEvent(
+        new CustomEvent('dg-add-to-cart', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            ...this.getProductData(),
+            size: 'Medium (12oz)',
+            milk: 'Oat Milk',
+            quantity: 1,
+          },
+        })
+      );
+    });
+
+    detailsBtn?.addEventListener('click', (e) => {
+      const event = new CustomEvent('dg-quick-view', {
+        bubbles: true,
+        composed: true,
+        cancelable: true,
+        detail: this.getProductData(),
+      });
+      const notCancelled = this.dispatchEvent(event);
+      if (!notCancelled) {
+        e.preventDefault();
+      }
+    });
+
+    favBtn?.addEventListener('click', () => {
+      this.favorited = !this.#favorited;
+      this.dispatchEvent(
+        new CustomEvent('dg-favorite-change', {
+          bubbles: true,
+          composed: true,
+          detail: {
+            ...this.getProductData(),
+            favorited: this.#favorited,
+          },
+        })
+      );
+    });
+  }
+
+  #syncFavoriteState() {
+    const favBtn = this.shadowRoot.querySelector('.fav-btn');
+    const favIcon = this.shadowRoot.querySelector('.fav-icon');
+    if (favBtn) {
+      favBtn.setAttribute('aria-pressed', String(this.#favorited));
+      favBtn.setAttribute(
+        'aria-label',
+        this.#favorited ? `Remove ${this.name} from favorites` : `Save ${this.name} to favorites`
+      );
+    }
+    if (favIcon) {
+      favIcon.innerHTML = this.#favorited ? '&#9829;' : '&#9825;';
+    }
+    if (this.#internals?.states) {
+      if (this.#favorited) {
+        this.#internals.states.add('favorited');
+      } else {
+        this.#internals.states.delete('favorited');
+      }
+    }
+  }
+
+  #syncUI() {
+    const img = this.shadowRoot.querySelector('img');
+    const badgeEl = this.shadowRoot.querySelector('.badge');
+    const titleEl = this.shadowRoot.querySelector('h3');
+    const priceEl = this.shadowRoot.querySelector('.price');
+    const metaEl = this.shadowRoot.querySelector('.meta');
+    const detailsBtn = this.shadowRoot.querySelector('.details-btn');
+
+    if (img) {
+      img.src = this.image;
+      img.alt = this.name || 'Coffee beverage';
+    }
+
+    if (badgeEl) {
+      if (this.badge) {
+        badgeEl.textContent = this.badge;
+        badgeEl.hidden = false;
+      } else {
+        badgeEl.textContent = '';
+        badgeEl.hidden = true;
+      }
+    }
+
+    if (titleEl) {
+      titleEl.textContent = this.name;
+    }
+
+    if (priceEl) {
+      priceEl.textContent = this.price > 0 ? `$${this.price.toFixed(2)}` : '';
+    }
+
+    if (metaEl) {
+      if (this.calories) {
+        metaEl.textContent = `${this.calories} cal`;
+        metaEl.hidden = false;
+      } else {
+        metaEl.textContent = '';
+        metaEl.hidden = true;
+      }
+    }
+
+    if (detailsBtn) {
+      detailsBtn.setAttribute('href', this.href);
+    }
+  }
+}
+
+if (!customElements.get('dg-product-card')) {
+  customElements.define('dg-product-card', DgProductCard);
+}
diff --git a/components/dg-tabs.js b/components/dg-tabs.js
new file mode 100644
index 0000000..b913898
--- /dev/null
+++ b/components/dg-tabs.js
@@ -0,0 +1,233 @@
+/**
+ * `<dg-tabs>` — Accessible Filter / Category Tab Bar Web Component
+ *
+ * Features:
+ * - Semantic `role="tablist"` and `role="tab"` inside a single Shadow DOM root
+ * - Roving `tabindex` with Left/Right/Home/End arrow key navigation
+ * - Dispatches `dg-tab-change` event with `{ value, label }` when active tab changes
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer base {
+    :host {
+      display: block;
+      --_tab-bg: var(--tab-bg, #efebe9);
+      --_tab-active-bg: var(--tab-active-bg, var(--primary, #4e342e));
+      --_tab-active-fg: var(--tab-active-fg, #ffffff);
+      --_tab-fg: var(--tab-fg, var(--text, #3e2723));
+      --_tab-accent: var(--tab-accent, var(--accent, #ffab40));
+    }
+
+    .tablist {
+      display: inline-flex;
+      flex-wrap: wrap;
+      gap: 0.35rem;
+      background: var(--_tab-bg);
+      padding: 0.35rem;
+      border-radius: 9999px;
+      border: 1px solid var(--border, #e0d6d2);
+    }
+
+    button[role="tab"] {
+      font: inherit;
+      font-size: 0.88rem;
+      font-weight: 600;
+      padding: 0.45rem 1.1rem;
+      border-radius: 9999px;
+      border: none;
+      background: transparent;
+      color: var(--_tab-fg);
+      cursor: pointer;
+      transition: background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
+    }
+
+    button[role="tab"]:hover {
+      background: rgba(78, 52, 46, 0.08);
+    }
+
+    button[role="tab"][aria-selected="true"] {
+      background: var(--_tab-active-bg);
+      color: var(--_tab-active-fg);
+      box-shadow: 0 2px 6px rgba(62, 39, 35, 0.2);
+    }
+
+    button[role="tab"]:focus-visible {
+      outline: 2px solid var(--_tab-accent);
+      outline-offset: 2px;
+    }
+  }
+`);
+
+const DEFAULT_TABS = [
+  { value: 'all', label: 'All Favorites' },
+  { value: 'seasonal', label: 'Seasonal' },
+  { value: 'espresso', label: 'Espresso' },
+  { value: 'cold-brew', label: 'Cold Brew & Iced' },
+  { value: 'bakery', label: 'Artisanal Bakery' },
+];
+
+export class DgTabs extends HTMLElement {
+  static observedAttributes = ['active', 'tabs'];
+
+  #tabs = DEFAULT_TABS;
+  #active = 'all';
+  #initialized = false;
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+  }
+
+  connectedCallback() {
+    if (this.hasAttribute('tabs')) {
+      this.#parseTabsAttribute(this.getAttribute('tabs'));
+    }
+    if (this.hasAttribute('active')) {
+      this.#active = this.getAttribute('active') || 'all';
+    }
+    this.#render();
+    if (!this.#initialized) {
+      this.#setupListeners();
+      this.#initialized = true;
+    }
+  }
+
+  get active() {
+    return this.#active;
+  }
+
+  set active(val) {
+    if (this.#active === val) return;
+    this.#active = val;
+    this.setAttribute('active', val);
+    this.#updateSelection();
+  }
+
+  get tabs() {
+    return this.#tabs;
+  }
+
+  set tabs(list) {
+    if (!Array.isArray(list)) return;
+    this.#tabs = list;
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal === newVal) return;
+    if (name === 'tabs') {
+      this.#parseTabsAttribute(newVal);
+      if (this.isConnected) this.#render();
+    } else if (name === 'active' && newVal) {
+      this.#active = newVal;
+      if (this.isConnected) this.#updateSelection();
+    }
+  }
+
+  #parseTabsAttribute(raw) {
+    if (!raw) {
+      this.#tabs = DEFAULT_TABS;
+      return;
+    }
+    try {
+      const parsed = JSON.parse(raw);
+      if (Array.isArray(parsed) && parsed.length > 0) {
+        this.#tabs = parsed;
+      }
+    } catch {
+      // Fallback to comma-separated "value:Label" pairs
+      this.#tabs = raw.split(',').map((pair) => {
+        const [value, label] = pair.split(':').map((s) => s.trim());
+        return { value: value || 'all', label: label || value || 'All' };
+      });
+    }
+  }
+
+  #render() {
+    const label = this.getAttribute('aria-label') || 'Menu Categories';
+    this.shadowRoot.innerHTML = '';
+    const list = document.createElement('div');
+    list.className = 'tablist';
+    list.setAttribute('role', 'tablist');
+    list.setAttribute('aria-label', label);
+    list.setAttribute('part', 'tablist');
+
+    for (const tab of this.#tabs) {
+      const isSelected = tab.value === this.#active;
+      const btn = document.createElement('button');
+      btn.type = 'button';
+      btn.setAttribute('role', 'tab');
+      btn.setAttribute('part', 'tab');
+      btn.dataset.value = tab.value;
+      btn.setAttribute('aria-selected', String(isSelected));
+      btn.tabIndex = isSelected ? 0 : -1;
+      btn.textContent = tab.label;
+      list.append(btn);
+    }
+
+    this.shadowRoot.append(list);
+  }
+
+  #updateSelection(focusActive = false) {
+    const buttons = this.shadowRoot.querySelectorAll('button[role="tab"]');
+    buttons.forEach((btn) => {
+      const selected = btn.dataset.value === this.#active;
+      btn.setAttribute('aria-selected', String(selected));
+      btn.tabIndex = selected ? 0 : -1;
+      if (selected && focusActive) {
+        btn.focus();
+      }
+    });
+  }
+
+  #selectTab(value, focusActive = false) {
+    const tab = this.#tabs.find((t) => t.value === value);
+    if (!tab) return;
+    this.#active = tab.value;
+    this.setAttribute('active', tab.value);
+    this.#updateSelection(focusActive);
+    this.dispatchEvent(
+      new CustomEvent('dg-tab-change', {
+        bubbles: true,
+        composed: true,
+        detail: { value: tab.value, label: tab.label },
+      })
+    );
+  }
+
+  #setupListeners() {
+    this.shadowRoot.addEventListener('click', (e) => {
+      const btn = e.target.closest('button[role="tab"]');
+      if (!btn) return;
+      this.#selectTab(btn.dataset.value, false);
+    });
+
+    this.shadowRoot.addEventListener('keydown', (e) => {
+      const buttons = Array.from(this.shadowRoot.querySelectorAll('button[role="tab"]'));
+      if (buttons.length === 0) return;
+      const currentIndex = buttons.findIndex((b) => b.dataset.value === this.#active);
+      let nextIndex = -1;
+
+      if (e.key === 'ArrowRight') {
+        nextIndex = (currentIndex + 1) % buttons.length;
+      } else if (e.key === 'ArrowLeft') {
+        nextIndex = (currentIndex - 1 + buttons.length) % buttons.length;
+      } else if (e.key === 'Home') {
+        nextIndex = 0;
+      } else if (e.key === 'End') {
+        nextIndex = buttons.length - 1;
+      }
+
+      if (nextIndex !== -1) {
+        e.preventDefault();
+        this.#selectTab(buttons[nextIndex].dataset.value, true);
+      }
+    });
+  }
+}
+
+if (!customElements.get('dg-tabs')) {
+  customElements.define('dg-tabs', DgTabs);
+}
