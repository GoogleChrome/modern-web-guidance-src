+    } else {
+      this.removeAttribute('brand');
+    }
+  }
+
+  get cartCount() {
+    return Number(this.getAttribute('cart-count')) || 0;
+  }
+
+  set cartCount(value) {
+    this.setAttribute('cart-count', String(Math.max(0, Number(value) || 0)));
+  }
+
+  get active() {
+    return this.getAttribute('active') ?? '';
+  }
+
+  set active(value) {
+    if (value) {
+      this.setAttribute('active', value);
+    } else {
+      this.removeAttribute('active');
+    }
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) {
