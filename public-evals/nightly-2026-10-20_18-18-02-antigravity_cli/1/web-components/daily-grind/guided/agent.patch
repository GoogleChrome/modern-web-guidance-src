index 0000000..4a28e32
--- /dev/null
+++ b/components/dg-toast.js
@@ -0,0 +1,164 @@
+/**
+ * `<dg-toast>` — Accessible Live-Region Toast Notification Manager
+ *
+ * Exposes `.show({ title, message, variant, duration })` method to display
+ * non-blocking feedback notifications (e.g., item added to bag, order placed).
+ */
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer base {
+    :host {
+      display: block;
+      position: fixed;
+      bottom: 1.5rem;
+      right: 1.5rem;
+      z-index: 2000;
+      pointer-events: none;
+      --_toast-bg: var(--toast-bg, #3e2723);
+      --_toast-fg: var(--toast-fg, #ffffff);
+      --_toast-accent: var(--toast-accent, var(--accent, #ffab40));
+    }
+
+    .stack {
+      display: flex;
+      flex-direction: column;
+      gap: 0.65rem;
+      align-items: flex-end;
+      max-width: min(92vw, 360px);
+    }
+
+    .toast {
+      pointer-events: auto;
+      background: var(--_toast-bg);
+      color: var(--_toast-fg);
+      border-left: 4px solid var(--_toast-accent);
+      border-radius: 10px;
+      padding: 0.85rem 1.1rem;
+      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.25);
+      display: flex;
+      align-items: flex-start;
+      gap: 0.75rem;
+      width: 100%;
+      animation: toast-in 0.22s cubic-bezier(0.22, 1, 0.36, 1) forwards;
+    }
+
+    .toast[data-variant="success"] {
+      border-left-color: #66bb6a;
+    }
+
+    .toast-body {
+      flex: 1;
+      font-size: 0.88rem;
+      line-height: 1.4;
+    }
+
+    .toast-title {
+      font-weight: 700;
+      font-size: 0.92rem;
+      margin-bottom: 0.15rem;
+      color: var(--_toast-accent);
+    }
+
+    .toast[data-variant="success"] .toast-title {
+      color: #a5d6a7;
+    }
+
+    .dismiss-btn {
+      font: inherit;
+      background: transparent;
+      border: none;
+      color: rgba(255, 255, 255, 0.75);
+      cursor: pointer;
+      font-size: 1.1rem;
+      line-height: 1;
+      padding: 0.1rem 0.25rem;
+    }
+
+    .dismiss-btn:hover {
+      color: #ffffff;
+    }
+
+    @keyframes toast-in {
+      from {
+        opacity: 0;
+        transform: translateY(10px) scale(0.97);
+      }
+      to {
+        opacity: 1;
+        transform: translateY(0) scale(1);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        animation-duration: 0.05s;
+      }
+    }
+  }
+`);
+
+export class DgToast extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.adoptedStyleSheets = [sheet];
+    const stack = document.createElement('div');
+    stack.className = 'stack';
+    stack.setAttribute('role', 'status');
+    stack.setAttribute('aria-live', 'polite');
+    stack.setAttribute('part', 'stack');
+    this.shadowRoot.append(stack);
+  }
+
+  /**
+   * @param {{ title?: string, message: string, variant?: 'default' | 'success', duration?: number }} options
+   */
+  show({ title = 'The Daily Grind', message = '', variant = 'default', duration = 3400 } = {}) {
+    const stack = this.shadowRoot.querySelector('.stack');
+    if (!stack) return;
+
+    const item = document.createElement('div');
+    item.className = 'toast';
