+++ b/components/dg-modal.js
@@ -0,0 +1,286 @@
+/**
+ * `<dg-modal>` — Reusable Modal Dialog Web Component
+ *
+ * Uses native `<dialog closedby="any">` (`light-dismiss-a-dialog` guide) with
+ * smooth top-layer entry/exit animations (`animate-to-from-top-layer` guide)
+ * and fallback support for browsers without `closedby` or discrete `display`
+ * transitions.
+ */
+
+import { attachDialogLightDismiss, closeDialogWithAnimation } from './top-layer-utils.js';
+
+const sheet = new CSSStyleSheet();
+sheet.replaceSync(`
+  @layer base {
+    :host {
+      display: contents;
+      --_modal-bg: var(--modal-bg, #ffffff);
+      --_modal-fg: var(--modal-fg, var(--text, #3e2723));
+      --_modal-primary: var(--modal-primary, var(--primary, #4e342e));
