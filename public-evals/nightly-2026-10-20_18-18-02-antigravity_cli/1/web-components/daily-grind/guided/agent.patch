@@ -0,0 +1,439 @@
+/* ==========================================================================
+   The Daily Grind — Reusable UI & Design System Stylesheet
+   Organized with Cascade Layers (@layer) for predictable specificity
+   ========================================================================== */
+
+@layer tokens, reset, typography, layout, components, utilities;
+
+@layer tokens {
+  :root {
+    /* Brand Colors */
+    --primary: #4e342e;
+    --primary-hover: #3e2723;
+    --primary-light: #7b5e57;
+    --secondary: #d7ccc8;
+    --secondary-light: #efebe9;
+    --accent: #ffab40;
+    --accent-hover: #ff9100;
+    --text: #3e2723;
+    --text-muted: #6d4c41;
+    --light: #fafafa;
+    --surface: #ffffff;
+    --border: #e0d6d2;
+
+    /* Semantic Status Colors */
+    --success: #2e7d32;
+    --success-bg: #e8f5e9;
+    --warning: #ef6c00;
+    --warning-bg: #fff3e0;
+    --danger: #c62828;
+    --danger-bg: #ffebee;
+
+    /* Spacing & Sizing */
+    --radius-sm: 4px;
+    --radius-md: 8px;
+    --radius-lg: 14px;
+    --radius-pill: 9999px;
+
+    /* Shadows */
+    --shadow-sm: 0 2px 5px rgba(62, 39, 35, 0.08);
+    --shadow-md: 0 6px 18px rgba(62, 39, 35, 0.12);
+    --shadow-lg: 0 16px 36px rgba(62, 39, 35, 0.2);
+
+    /* Typography */
+    --font-sans: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --container-max: 1140px;
+  }
+}
+
+@layer reset {
+  *,
+  *::before,
+  *::after {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+
+  body {
+    font-family: var(--font-sans);
+    line-height: 1.6;
+    color: var(--text);
+    background-color: var(--light);
+    min-height: 100vh;
+    display: flex;
+    flex-direction: column;
+  }
+
+  img {
+    max-width: 100%;
+    display: block;
+  }
+
+  button,
+  input,
+  select,
+  textarea {
+    font: inherit;
+    color: inherit;
+  }
+
+  /* Custom element upgrade fail-open guard (custom-elements guide) */
+  :is(dg-navbar, dg-product-card, dg-modal, dg-cart-drawer, dg-tabs, dg-toast, dg-footer):not(:defined) {
+    opacity: 0;
+    animation: defined-fallback 0.2s 2s forwards;
+  }
+
+  @keyframes defined-fallback {
+    to {
+      opacity: 1;
+    }
+  }
+}
+
+@layer typography {
+  h1, h2, h3, h4 {
+    color: var(--primary);
+    line-height: 1.25;
+    font-weight: 700;
+  }
+
+  .section-header {
+    text-align: center;
+    margin-bottom: 2rem;
+  }
+
+  .section-header h2 {
+    font-size: clamp(1.6rem, 3vw, 2.2rem);
+    margin-bottom: 0.5rem;
+  }
+
+  .section-header p {
+    color: var(--text-muted);
+    max-width: 560px;
+    margin: 0 auto;
+  }
+}
+
+@layer layout {
+  .container {
+    width: 100%;
+    max-width: var(--container-max);
+    margin: 2.5rem auto;
+    padding: 0 1.25rem;
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+    gap: 1.5rem;
+    margin-top: 1.25rem;
+  }
+}
+
+@layer components {
+  /* --------------------------------------------------------------------------
+     Hero Section Component (.hero)
+     -------------------------------------------------------------------------- */
+  .hero {
+    min-height: 60vh;
+    background: linear-gradient(rgba(35, 20, 15, 0.62), rgba(35, 20, 15, 0.62)),
+      url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+    background-size: cover;
+    background-position: center;
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    color: white;
+    text-align: center;
+    padding: 3rem 1.25rem;
+    gap: 0.75rem;
+  }
+
+  .hero h1 {
+    color: white;
+    font-size: clamp(2.25rem, 5vw, 3.4rem);
+    margin-bottom: 0.25rem;
+    letter-spacing: -0.02em;
+  }
+
+  .hero p {
+    font-size: 1.15rem;
+    max-width: 540px;
+    opacity: 0.95;
+    margin-bottom: 0.5rem;
+  }
+
+  .hero-actions {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.75rem;
+    justify-content: center;
+    margin-top: 0.5rem;
+  }
+
+  /* --------------------------------------------------------------------------
+     Button Component (.btn) — Native <button> and <a> styling
+     -------------------------------------------------------------------------- */
+  .btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 0.5rem;
+    background: var(--primary);
+    color: white;
+    padding: 0.65rem 1.35rem;
+    font-size: 0.95rem;
+    font-weight: 600;
+    text-decoration: none;
+    border-radius: var(--radius-md);
+    border: 1.5px solid transparent;
+    cursor: pointer;
+    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
+    line-height: 1.3;
+  }
+
+  .btn:hover {
+    background: var(--primary-hover);
+    transform: translateY(-1px);
+    box-shadow: var(--shadow-sm);
+  }
+
+  .btn:active {
+    transform: translateY(0);
+  }
+
+  .btn:focus-visible {
+    outline: 3px solid var(--accent);
+    outline-offset: 2px;
+  }
+
+  .btn:disabled,
+  .btn[aria-disabled="true"] {
+    opacity: 0.55;
+    pointer-events: none;
+  }
+
+  /* Button Variants */
+  .btn--accent {
+    background: var(--accent);
+    color: var(--primary-hover);
+  }
+
+  .btn--accent:hover {
+    background: var(--accent-hover);
+    color: var(--primary-hover);
+  }
+
+  .btn--outline {
+    background: transparent;
+    color: var(--primary);
+    border-color: var(--primary);
+  }
+
+  .btn--outline:hover {
+    background: var(--primary);
+    color: white;
+  }
+
+  .btn--outline-light {
+    background: rgba(255, 255, 255, 0.1);
+    color: white;
+    border-color: rgba(255, 255, 255, 0.75);
+    backdrop-filter: blur(4px);
+  }
+
+  .btn--outline-light:hover {
+    background: white;
+    color: var(--primary);
+  }
+
+  .btn--ghost {
+    background: transparent;
+    color: var(--text);
+  }
+
+  .btn--ghost:hover {
+    background: var(--secondary-light);
+  }
+
+  /* Button Sizes */
+  .btn--sm {
+    padding: 0.4rem 0.85rem;
+    font-size: 0.85rem;
+    border-radius: var(--radius-sm);
+  }
+
+  .btn--lg {
+    padding: 0.85rem 1.75rem;
+    font-size: 1.05rem;
+  }
+
+  /* --------------------------------------------------------------------------
+     Badge / Pill Component (.badge)
+     -------------------------------------------------------------------------- */
+  .badge {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.3rem;
+    padding: 0.2rem 0.65rem;
+    font-size: 0.75rem;
+    font-weight: 700;
+    text-transform: uppercase;
+    letter-spacing: 0.04em;
+    border-radius: var(--radius-pill);
+    background: var(--secondary);
+    color: var(--primary-hover);
+  }
+
+  .badge--accent {
+    background: var(--accent);
+    color: var(--primary-hover);
+  }
+
+  .badge--success {
+    background: var(--success-bg);
+    color: var(--success);
+  }
+
+  .badge--warning {
+    background: var(--warning-bg);
+    color: var(--warning);
+  }
+
+  /* --------------------------------------------------------------------------
+     Static Card Fallback (.card)
+     -------------------------------------------------------------------------- */
+  .card {
+    background: var(--surface);
+    padding: 1.5rem;
+    border-radius: var(--radius-md);
+    box-shadow: var(--shadow-sm);
+    border: 1px solid var(--border);
+    text-align: center;
+    transition: transform 0.2s ease, box-shadow 0.2s ease;
+  }
+
+  .card:hover {
+    transform: translateY(-2px);
+    box-shadow: var(--shadow-md);
+  }
+
+  .card h3 {
+    margin-bottom: 0.5rem;
+    color: var(--primary);
+  }
+
+  /* --------------------------------------------------------------------------
+     Alert / Callout Banner (.alert)
+     -------------------------------------------------------------------------- */
+  .alert {
+    display: flex;
+    align-items: flex-start;
+    justify-content: space-between;
+    gap: 1rem;
+    padding: 1rem 1.25rem;
+    border-radius: var(--radius-md);
+    border-left: 4px solid var(--primary);
+    background: var(--secondary-light);
+    color: var(--text);
+  }
+
+  .alert--accent {
+    border-left-color: var(--accent-hover);
+    background: var(--warning-bg);
+  }
+
+  .alert--success {
+    border-left-color: var(--success);
+    background: var(--success-bg);
+  }
+
+  /* --------------------------------------------------------------------------
+     Form Controls (.form-group, .form-control, .chip-group)
+     -------------------------------------------------------------------------- */
+  .form-group {
+    display: flex;
+    flex-direction: column;
+    gap: 0.4rem;
+    margin-bottom: 1rem;
+    text-align: left;
+  }
+
+  .form-label {
+    font-size: 0.875rem;
+    font-weight: 600;
+    color: var(--primary);
+  }
+
+  .form-control {
+    width: 100%;
+    padding: 0.6rem 0.85rem;
+    border: 1.5px solid var(--border);
+    border-radius: var(--radius-md);
+    background: var(--surface);
+    color: var(--text);
+    transition: border-color 0.2s ease, box-shadow 0.2s ease;
+  }
+
+  .form-control:focus {
+    outline: none;
+    border-color: var(--primary);
+    box-shadow: 0 0 0 3px rgba(78, 52, 46, 0.15);
+  }
+
+  .chip-group {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5rem;
+  }
+
+  .chip-option {
+    position: relative;
+  }
+
+  .chip-option input {
+    position: absolute;
+    opacity: 0;
+    pointer-events: none;
+  }
+
+  .chip-option span {
+    display: inline-block;
+    padding: 0.45rem 0.9rem;
+    border-radius: var(--radius-pill);
+    border: 1.5px solid var(--border);
+    background: var(--surface);
+    font-size: 0.85rem;
+    font-weight: 600;
+    cursor: pointer;
+    transition: all 0.15s ease;
+  }
+
+  .chip-option input:checked + span {
+    background: var(--primary);
+    color: white;
+    border-color: var(--primary);
+  }
+
+  .chip-option input:focus-visible + span {
+    outline: 2px solid var(--accent);
+    outline-offset: 2px;
+  }
+}
+
+@layer utilities {
+  .text-center { text-align: center; }
+  .text-muted { color: var(--text-muted); }
+  .mt-1 { margin-top: 0.5rem; }
+  .mt-2 { margin-top: 1rem; }
+  .mt-3 { margin-top: 1.5rem; }
+  .mb-2 { margin-bottom: 1rem; }
+  .flex-between {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1rem;
+  }
+}
