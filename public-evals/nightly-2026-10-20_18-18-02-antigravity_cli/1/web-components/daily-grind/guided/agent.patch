+        message: `${item.name} (${item.size}) added to your pickup order.`,
+        variant: 'success',
+      });
+    });
+
+    // 3. Favorite Toggle via <dg-product-card>
+    document.addEventListener('dg-favorite-change', (e) => {
+      const { name, favorited } = e.detail;
+      toast?.show({
+        title: favorited ? 'Saved to Favorites' : 'Removed from Favorites',
+        message: favorited ? `${name} saved to your account.` : `${name} removed from favorites.`,
+      });
+    });
+
+    // 4. Quick View / Customize Modal via <dg-product-card>
+    document.addEventListener('dg-quick-view', (e) => {
+      e.preventDefault();
+      const product = e.detail;
+      activeModalProduct = product;
+
+      document.getElementById('modal-product-img').src = product.image;
+      document.getElementById('modal-product-name').textContent = product.name;
+      document.getElementById('modal-product-price').textContent = `$${Number(product.price).toFixed(2)}`;
+      document.getElementById('modal-product-desc').textContent = product.description;
+
+      const badgeEl = document.getElementById('modal-product-badge');
+      if (product.badge) {
+        badgeEl.textContent = product.badge;
+        badgeEl.hidden = false;
+      } else {
+        badgeEl.hidden = true;
+      }
+
+      modal.heading = `Customize ${product.name}`;
+      modal.showModal();
+    });
+
+    document.getElementById('modal-cancel-btn')?.addEventListener('click', () => {
+      modal.close('cancel');
+    });
+
+    document.getElementById('modal-confirm-btn')?.addEventListener('click', () => {
+      const form = document.getElementById('customize-form');
+      const formData = new FormData(form);
+      const size = formData.get('size') || 'Medium (12oz)';
+      const milk = formData.get('milk') || 'Oat Milk';
+
+      cartDrawer?.addItem({
+        ...activeModalProduct,
+        size,
+        milk,
+        quantity: 1,
+      });
+
+      modal.close('confirm');
+      toast?.show({
+        title: 'Customized Drink Added',
+        message: `${activeModalProduct.name} (${size}, ${milk}) added to bag.`,
+        variant: 'success',
+      });
+    });
+
+    // 5. Sync Cart Count with <dg-navbar>
+    cartDrawer?.addEventListener('dg-cart-change', (e) => {
+      navbar.cartCount = e.detail.totalCount;
+    });
+
+    cartDrawer?.addEventListener('dg-checkout', (e) => {
+      toast?.show({
+        title: 'Order Confirmed!',
+        message: `Your pickup order (${e.detail.totalCount} items, $${e.detail.totalPrice.toFixed(2)}) will be ready in 8–12 mins.`,
+        variant: 'success',
+        duration: 5000,
+      });
+    });
+
+    navbar?.addEventListener('dg-cart-open', () => {
+      cartDrawer?.open();
+    });
+
+    document.getElementById('open-bag-hero')?.addEventListener('click', () => {
+      cartDrawer?.open();
+    });
+
+    // 6. Newsletter subscription via <dg-footer>
+    document.addEventListener('dg-newsletter-subscribe', (e) => {
+      toast?.show({
+        title: 'Welcome to Roaster’s Notes!',
+        message: `Subscribed ${e.detail.email} to seasonal coffee drops.`,
+        variant: 'success',
+      });
+    });
+
+    // 7. Showcase Demo Triggers
+    document.getElementById('demo-modal-btn')?.addEventListener('click', () => {
+      modal.heading = `Customize ${activeModalProduct.name}`;
+      modal.showModal();
+    });
+
+    document.getElementById('demo-drawer-btn')?.addEventListener('click', () => {
+      cartDrawer?.open();
+    });
+
+    document.getElementById('demo-toast-btn')?.addEventListener('click', () => {
+      toast?.show({
+        title: 'Fresh Batch Ready',
+        message: 'Our Ethiopia Yirgacheffe pour-over just finished brewing at the bar.',
+      });
+    });
+  </script>
 
 </body>
 
