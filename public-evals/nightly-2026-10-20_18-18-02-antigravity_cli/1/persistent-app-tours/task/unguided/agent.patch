+  <script>
+    (() => {
+      const featureLink = document.getElementById('feature');
+      const tourStep = document.getElementById('tour-step');
+      const closeBtn = document.getElementById('close-tour');
+
+      let isTourActive = true;
+
+      const updateTourPosition = () => {
+        if (!isTourActive || !featureLink || !tourStep) return;
+        if (!CSS.supports('anchor-name', '--feature-anchor')) {
+          const rect = featureLink.getBoundingClientRect();
+          const stepWidth = tourStep.offsetWidth || 260;
+          const left = Math.max(8, Math.min(window.innerWidth - stepWidth - 8, rect.left + rect.width / 2 - stepWidth / 2));
+          tourStep.style.top = `${rect.bottom + 12}px`;
+          tourStep.style.left = `${left}px`;
+          tourStep.style.translate = 'none';
+        }
+      };
+
+      const openTour = () => {
+        isTourActive = true;
+        if (typeof tourStep.showPopover === 'function') {
+          try {
+            tourStep.showPopover();
+          } catch (e) {}
+        } else {
+          tourStep.style.display = 'block';
+        }
+        updateTourPosition();
+      };
+
+      const closeTour = () => {
+        isTourActive = false;
+        if (typeof tourStep.hidePopover === 'function') {
+          try {
+            tourStep.hidePopover();
+          } catch (e) {}
+        } else {
+          tourStep.style.display = 'none';
+        }
+      };
+
+      tourStep.addEventListener('toggle', (event) => {
+        isTourActive = event.newState === 'open';
+        if (isTourActive) {
+          updateTourPosition();
+        }
+      });
+
+      closeBtn.addEventListener('click', () => {
+        closeTour();
+      });
+
+      featureLink.addEventListener('click', (event) => {
+        const isOpen = typeof tourStep.matches === 'function' && tourStep.matches(':popover-open')
+          ? true
+          : isTourActive;
+        if (isOpen) {
+          event.preventDefault();
+        }
+      });
+
+      window.addEventListener('resize', updateTourPosition, { passive: true });
+      window.addEventListener('scroll', updateTourPosition, { passive: true });
+
+      if (typeof ResizeObserver !== 'undefined') {
+        const ro = new ResizeObserver(updateTourPosition);
+        ro.observe(document.documentElement);
+        ro.observe(featureLink);
+      }
+
+      openTour();
+    })();
+  </script>
 </body>
 
 </html>
