+  <script>
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      const nextLink = document.getElementById('next');
+      const previousLink = document.getElementById('previous');
+
+      if (nextLink) {
+        nextLink.addEventListener('click', () => {
+          sessionStorage.setItem('transitionType', 'next');
+        });
+      }
+
+      if (previousLink) {
+        previousLink.addEventListener('click', () => {
+          sessionStorage.setItem('transitionType', 'previous');
+        });
+      }
+
+      const determineTransitionType = (fromEntry, toEntry) => {
+        const savedType = sessionStorage.getItem('transitionType');
+        if (savedType) {
+          sessionStorage.removeItem('transitionType');
+          return savedType;
+        }
+
+        const toUrl = toEntry?.url || window.location.href;
+        const fromUrl = fromEntry?.url || '';
+
+        if (nextLink && toUrl === nextLink.href) {
+          return 'next';
+        }
+        if (previousLink && toUrl === previousLink.href) {
+          return 'previous';
+        }
+        if (toUrl.includes('next') || toUrl.includes('page=2')) {
+          return 'next';
+        }
+        if (toUrl.includes('prev') || toUrl.includes('page=1') || (fromUrl.includes('page=2') && !toUrl.includes('page=2'))) {
+          return 'previous';
+        }
+
+        return 'next';
+      };
+
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition || !window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+          return;
+        }
+
+        const activation = event.activation || window.navigation?.activation;
+        const transitionType = determineTransitionType(activation?.from, activation?.entry);
+
+        if (transitionType) {
+          event.viewTransition.types.add(transitionType);
+        }
+      });
+    }
+  </script>
+
