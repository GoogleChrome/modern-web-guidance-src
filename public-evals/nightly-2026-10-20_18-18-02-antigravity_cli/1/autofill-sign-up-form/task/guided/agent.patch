+  <script>
+    const syncAria = (el) => {
+      if (el && typeof el.matches === 'function' && el.tagName === 'INPUT') {
+        el.setAttribute('aria-invalid', el.matches(':user-invalid') ? 'true' : 'false');
+      }
+    };
+
+    document.addEventListener('blur', (e) => syncAria(e.target), true);
+    document.addEventListener('input', (e) => {
+      if (e.target && e.target.hasAttribute && e.target.hasAttribute('aria-invalid')) {
+        syncAria(e.target);
+      }
+    });
+
+    const togglePasswordBtn = document.getElementById('toggle-password');
+    const passwordInput = document.getElementById('new-password');
+
+    togglePasswordBtn.addEventListener('click', () => {
+      const isShowing = passwordInput.type === 'text';
+      passwordInput.type = isShowing ? 'password' : 'text';
+      togglePasswordBtn.setAttribute('aria-pressed', String(!isShowing));
+      togglePasswordBtn.textContent = isShowing ? 'Show password' : 'Hide password';
+      togglePasswordBtn.setAttribute('aria-label', isShowing ? 'Show password' : 'Hide password');
+    });
+  </script>
