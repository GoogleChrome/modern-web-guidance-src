+  <script>
+    const sliders = document.querySelectorAll('input[type="range"]');
+
+    function syncSliderValue(slider) {
+      slider.style.setProperty('--attr-min', slider.min || 0);
+      slider.style.setProperty('--attr-max', slider.max || 100);
+      slider.style.setProperty('--control-value', slider.value);
+
+      const unit = slider.dataset.unit || '';
+      const ariaUnit = slider.dataset.ariaUnit || unit;
+      const val = Number(slider.value);
+
+      if (ariaUnit) {
+        const formattedAriaUnit = val === 1 && ariaUnit === 'pumps' ? 'pump' : ariaUnit;
+        slider.setAttribute('aria-valuetext', `${slider.value} ${formattedAriaUnit}`);
+      }
+
+      const output = document.getElementById(`${slider.id}-output`);
+      if (output) {
+        const formattedUnit = val === 1 && unit === ' pumps' ? ' pump' : unit;
+        output.textContent = `${slider.value}${formattedUnit}`;
+      }
+    }
+
+    sliders.forEach((slider) => {
+      syncSliderValue(slider);
+      slider.addEventListener('input', () => syncSliderValue(slider));
+    });
+
+    const customizerForm = document.getElementById('brew-customizer-form');
+    if (customizerForm) {
+      customizerForm.addEventListener('submit', (e) => {
+        e.preventDefault();
+      });
+    }
+  </script>
