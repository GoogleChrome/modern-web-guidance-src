+  <script>
+    (function () {
+      const sliders = document.querySelectorAll('input[type="range"].custom-slider');
+
+      function updateSlider(slider) {
+        const min = parseFloat(slider.min) || 0;
+        const max = parseFloat(slider.max) || 100;
+        const val = parseFloat(slider.value) || 0;
+        const percentage = ((val - min) / (max - min)) * 100;
+
+        slider.style.setProperty('--slider-progress', `${percentage}%`);
+        slider.setAttribute('aria-valuenow', String(val));
+
+        const unit = slider.getAttribute('data-unit') || '';
+        const formattedValue = unit.startsWith('/') ? `${val} ${unit}` : `${val}${unit}`;
+        slider.setAttribute('aria-valuetext', formattedValue);
+
+        const output = document.querySelector(`output[for="${slider.id}"]`);
+        if (output) {
+          output.textContent = formattedValue;
+        }
+      }
+
+      sliders.forEach((slider) => {
+        updateSlider(slider);
+        slider.addEventListener('input', () => updateSlider(slider));
+        slider.addEventListener('change', () => updateSlider(slider));
+      });
+    })();
+  </script>
