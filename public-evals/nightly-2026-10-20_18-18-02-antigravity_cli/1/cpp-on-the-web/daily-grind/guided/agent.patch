+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void reset_sphere_colors() {
+  spheres[0].c = Vec(.75, .25, .25);
+  spheres[1].c = Vec(.25, .25, .75);
+  spheres[2].c = Vec(.75, .75, .75);
+  spheres[3].c = Vec(0, 0, 0);
+  spheres[4].c = Vec(.75, .75, .75);
+  spheres[5].c = Vec(.75, .75, .75);
+  spheres[6].c = Vec(1, 1, 1) * .999;
+  spheres[7].c = Vec(1, 1, 1) * .999;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 8) {
+    spheres[index].c = Vec(r, g, b);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)((seed * 1103515245U + 12345U) & 0xFFFF)
+  };
+  // Randomize Left, Right, Back, Bottom, Top, Mirror, Glass spheres
+  int indices[] = {0, 1, 2, 4, 5, 6, 7};
+  for (int idx : indices) {
+    if (idx == 6 || idx == 7) {
+      // Tinted mirror and glass with high reflectance
+      double r = 0.45 + 0.549 * erand48(Xi);
+      double g = 0.45 + 0.549 * erand48(Xi);
+      double b = 0.45 + 0.549 * erand48(Xi);
+      spheres[idx].c = Vec(r, g, b);
+    } else {
+      // Vibrant diffuse wall/sphere colors
+      double r = 0.15 + 0.75 * erand48(Xi);
+      double g = 0.15 + 0.75 * erand48(Xi);
+      double b = 0.15 + 0.75 * erand48(Xi);
+      spheres[idx].c = Vec(r, g, b);
+    }
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_channel(int index, int channel) {
+  if (index < 0 || index >= 9) return 0.0;
+  if (channel == 0) return spheres[index].c.x;
+  if (channel == 1) return spheres[index].c.y;
+  if (channel == 2) return spheres[index].c.z;
+  return 0.0;
+}
+
+static int g_w = 0;
+static int g_h = 0;
+static int g_samps = 1;
+static Vec *g_c = nullptr;
+static unsigned char *g_rgba = nullptr;
+
+EMSCRIPTEN_KEEPALIVE
+unsigned char* init_render(int w, int h, int samps) {
+  g_w = w;
+  g_h = h;
+  g_samps = samps > 0 ? samps : 1;
+  if (g_c) free(g_c);
+  if (g_rgba) free(g_rgba);
+  g_c = (Vec*)malloc(sizeof(Vec) * w * h);
+  g_rgba = (unsigned char*)malloc(w * h * 4);
+  for (int i = 0; i < w * h * 4; i += 4) {
+    g_rgba[i] = 15;
+    g_rgba[i + 1] = 15;
+    g_rgba[i + 2] = 20;
+    g_rgba[i + 3] = 255;
+  }
+  return g_rgba;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void render_rows(int start_y, int end_y) {
+  if (!g_c || !g_rgba) return;
+  int w = g_w;
+  int h = g_h;
+  int samps = g_samps;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+
+  if (start_y < 0) start_y = 0;
+  if (end_y > h) end_y = h;
+
+  for (int y = start_y; y < end_y; y++) {
+    unsigned short Xi[3] = {0, 0, (unsigned short)(y * y * y)};
+    for (unsigned short x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      g_c[i] = Vec();
+      for (int sy = 0; sy < 2; sy++) {     // 2x2 subpixel rows
+        for (int sx = 0; sx < 2; sx++, r = Vec()) { // 2x2 subpixel cols
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          }
+          g_c[i] = g_c[i] + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      int px = i * 4;
+      g_rgba[px + 0] = (unsigned char)toInt(g_c[i].x);
+      g_rgba[px + 1] = (unsigned char)toInt(g_c[i].y);
+      g_rgba[px + 2] = (unsigned char)toInt(g_c[i].z);
+      g_rgba[px + 3] = 255;
+    }
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+unsigned char* render_scene(int w, int h, int samps) {
+  init_render(w, h, samps);
+  render_rows(0, h);
+  return g_rgba;
+}
+
+}
