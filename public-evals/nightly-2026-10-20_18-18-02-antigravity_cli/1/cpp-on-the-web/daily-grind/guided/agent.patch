+  <script type="module">
+    import createSmallptModule from './smallpt.js';
+
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const statusEl = document.getElementById('render-status');
+    const progressBar = document.getElementById('progress-bar');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const samplesSelect = document.getElementById('samples-select');
+    const swatchGrid = document.getElementById('swatch-grid');
+    const metricRes = document.getElementById('metric-resolution');
+    const metricSamples = document.getElementById('metric-samples');
+    const metricTime = document.getElementById('metric-time');
+
+    const SPHERE_NAMES = [
+      'Left Wall',
+      'Right Wall',
+      'Back Wall',
+      'Front Wall',
+      'Floor',
+      'Ceiling',
+      'Mirror Sphere',
+      'Glass Sphere'
+    ];
+
+    function updateSwatches(sphereColors) {
+      swatchGrid.innerHTML = '';
+      for (const s of sphereColors) {
+        if (s.index === 3) continue; // Front wall is black/invisible camera wall
+        const item = document.createElement('div');
+        item.className = 'swatch-item';
+        item.innerHTML = `
+          <span class="swatch-dot" style="background-color: ${s.hex}"></span>
+          <div class="swatch-info">
+            <span class="swatch-name">${s.name}</span>
+            <span class="swatch-hex">${s.hex.toUpperCase()}</span>
+          </div>
+        `;
+        swatchGrid.appendChild(item);
+      }
+    }
+
+    function getSelectedConfig() {
+      const [width, height] = resolutionSelect.value.split('x').map(Number);
+      const samples = Number(samplesSelect.value);
+      return { width, height, samples };
+    }
+
+    let worker = null;
+    let fallbackModule = null;
+    let fallbackRenderId = 0;
+
+    try {
+      worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+      worker.onmessage = (e) => {
+        const data = e.data;
+        if (data.type === 'START') {
+          canvas.width = data.width;
+          canvas.height = data.height;
+          metricRes.innerHTML = `Resolution: ${data.width} &times; ${data.height}`;
+          metricSamples.textContent = `Samples: ${data.samples} spp`;
+          progressBar.style.width = '2%';
+          statusEl.textContent = 'Path tracing (0%)...';
+          updateSwatches(data.sphereColors);
+        } else if (data.type === 'PROGRESS') {
+          const pixels = new Uint8ClampedArray(data.rgba);
+          const imageData = new ImageData(pixels, data.width, data.height);
+          ctx.putImageData(imageData, 0, 0);
+          const pct = Math.round(data.progress * 100);
+          progressBar.style.width = `${pct}%`;
+          statusEl.textContent = `Path tracing (${pct}%)...`;
+          metricTime.textContent = `Elapsed: ${(data.elapsedMs / 1000).toFixed(2)}s`;
+        } else if (data.type === 'DONE') {
+          const pixels = new Uint8ClampedArray(data.rgba);
+          const imageData = new ImageData(pixels, data.width, data.height);
+          ctx.putImageData(imageData, 0, 0);
+          progressBar.style.width = '100%';
+          statusEl.textContent = `Complete (${(data.elapsedMs / 1000).toFixed(2)}s)`;
+          metricTime.textContent = `Elapsed: ${(data.elapsedMs / 1000).toFixed(2)}s`;
+          updateSwatches(data.sphereColors);
+        }
+      };
+      worker.onerror = (err) => {
+        console.warn('Worker failed, falling back to sliced main-thread Wasm execution:', err);
+        worker = null;
+        triggerRender({ randomize: false, reset: true });
+      };
+    } catch (err) {
+      worker = null;
+    }
+
+    async function runFallbackRender({ width, height, samples, randomize, reset, seed }) {
+      const renderId = ++fallbackRenderId;
+      if (!fallbackModule) {
+        fallbackModule = await createSmallptModule();
+      }
+      const mod = fallbackModule;
+      if (reset) {
+        mod._reset_sphere_colors();
+      } else if (randomize) {
+        mod._randomize_sphere_colors(seed >>> 0);
+      }
+
+      const sphereColors = [];
+      for (let i = 0; i < 8; i++) {
+        const r = Math.round(Math.min(1, Math.max(0, mod._get_sphere_color_channel(i, 0))) * 255);
+        const g = Math.round(Math.min(1, Math.max(0, mod._get_sphere_color_channel(i, 1))) * 255);
+        const b = Math.round(Math.min(1, Math.max(0, mod._get_sphere_color_channel(i, 2))) * 255);
+        sphereColors.push({
+          index: i,
+          name: SPHERE_NAMES[i],
+          r, g, b,
+          hex: `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`
+        });
+      }
+      updateSwatches(sphereColors);
+
+      const sampsPerSubpixel = Math.max(1, Math.floor(samples / 4));
+      const totalSamples = sampsPerSubpixel * 4;
+      canvas.width = width;
+      canvas.height = height;
+      metricRes.innerHTML = `Resolution: ${width} &times; ${height}`;
+      metricSamples.textContent = `Samples: ${totalSamples} spp`;
+
+      const startTime = performance.now();
+      const ptr = mod._init_render(width, height, sampsPerSubpixel);
+      const byteLength = width * height * 4;
+
+      const chunkRows = 8;
+      for (let y = 0; y < height; y += chunkRows) {
+        if (renderId !== fallbackRenderId) return;
+        const endY = Math.min(height, y + chunkRows);
+        mod._render_rows(y, endY);
+
+        const slice = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, byteLength);
+        const imageData = new ImageData(new Uint8ClampedArray(slice), width, height);
+        ctx.putImageData(imageData, 0, 0);
+
+        const elapsedMs = performance.now() - startTime;
+        const pct = Math.round((endY / height) * 100);
+        progressBar.style.width = `${pct}%`;
+        statusEl.textContent = endY === height ? `Complete (${(elapsedMs / 1000).toFixed(2)}s)` : `Path tracing (${pct}%)...`;
+        metricTime.textContent = `Elapsed: ${(elapsedMs / 1000).toFixed(2)}s`;
+
+        await new Promise((r) => requestAnimationFrame(r));
+      }
+    }
+
+    function triggerRender({ randomize = false, reset = false } = {}) {
+      const { width, height, samples } = getSelectedConfig();
+      const seed = (Date.now() ^ Math.floor(Math.random() * 0xffffffff)) >>> 0;
+      if (worker) {
+        worker.postMessage({
+          type: 'RENDER',
+          width,
+          height,
+          samples,
+          randomize,
+          reset,
+          seed
+        });
+      } else {
+        runFallbackRender({ width, height, samples, randomize, reset, seed });
+      }
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      triggerRender({ randomize: true });
+    });
+
+    resetBtn.addEventListener('click', () => {
+      triggerRender({ reset: true });
+    });
+
+    resolutionSelect.addEventListener('change', () => {
+      triggerRender({ randomize: false });
+    });
+
+    samplesSelect.addEventListener('change', () => {
+      triggerRender({ randomize: false });
+    });
+
+    // Run initial path trace on load
+    triggerRender({ reset: true });
+  </script>
 </body>
 
