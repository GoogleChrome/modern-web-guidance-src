@@ -0,0 +1,125 @@
+import createSmallptModule from './smallpt.js';
+
+let wasmModule = null;
+let currentRenderId = 0;
+
+const SPHERE_NAMES = [
+  'Left Wall',
+  'Right Wall',
+  'Back Wall',
+  'Front Wall',
+  'Floor',
+  'Ceiling',
+  'Mirror Sphere',
+  'Glass Sphere'
+];
+
+async function ensureModule() {
+  if (!wasmModule) {
+    wasmModule = await createSmallptModule();
+  }
+  return wasmModule;
+}
+
+function readSphereColors(mod) {
+  const colors = [];
+  for (let i = 0; i < 8; i++) {
+    const r = Math.round(Math.min(1, Math.max(0, mod._get_sphere_color_channel(i, 0))) * 255);
+    const g = Math.round(Math.min(1, Math.max(0, mod._get_sphere_color_channel(i, 1))) * 255);
+    const b = Math.round(Math.min(1, Math.max(0, mod._get_sphere_color_channel(i, 2))) * 255);
+    colors.push({
+      index: i,
+      name: SPHERE_NAMES[i],
+      r,
+      g,
+      b,
+      hex: `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`
+    });
+  }
+  return colors;
+}
+
+self.onmessage = async (e) => {
+  const { type, width = 320, height = 240, samples = 8, randomize = false, reset = false, customColors = null, seed = Date.now() } = e.data;
+
+  if (type === 'RENDER') {
+    const renderId = ++currentRenderId;
+    const mod = await ensureModule();
+
+    if (reset) {
+      mod._reset_sphere_colors();
+    } else if (randomize) {
+      mod._randomize_sphere_colors(seed >>> 0);
+    } else if (Array.isArray(customColors)) {
+      for (const c of customColors) {
+        mod._set_sphere_color(c.index, c.r, c.g, c.b);
+      }
+    }
+
+    const sphereColors = readSphereColors(mod);
+    const sampsPerSubpixel = Math.max(1, Math.floor(samples / 4));
+    const totalSamplesPerPixel = sampsPerSubpixel * 4;
+
+    const startTime = performance.now();
+    const ptr = mod._init_render(width, height, sampsPerSubpixel);
+    const byteLength = width * height * 4;
+
+    self.postMessage({
+      type: 'START',
+      renderId,
+      width,
+      height,
+      samples: totalSamplesPerPixel,
+      sphereColors
+    });
+
+    const chunkRows = 16;
+    for (let y = 0; y < height; y += chunkRows) {
+      if (renderId !== currentRenderId) return;
+      const endY = Math.min(height, y + chunkRows);
+      mod._render_rows(y, endY);
+
+      const copy = new Uint8ClampedArray(byteLength);
+      copy.set(mod.HEAPU8.subarray(ptr, ptr + byteLength));
+
+      const elapsedMs = performance.now() - startTime;
+      const progress = endY / height;
+
+      self.postMessage(
+        {
+          type: 'PROGRESS',
+          renderId,
+          width,
+          height,
+          progress,
+          elapsedMs,
+          rgba: copy.buffer
+        },
+        [copy.buffer]
+      );
+
+      // Yield briefly in worker event loop so cancellation/new messages can be processed
+      await new Promise((r) => setTimeout(r, 0));
+    }
+
+    if (renderId === currentRenderId) {
+      const finalCopy = new Uint8ClampedArray(byteLength);
+      finalCopy.set(mod.HEAPU8.subarray(ptr, ptr + byteLength));
+      const elapsedMs = performance.now() - startTime;
+
+      self.postMessage(
+        {
+          type: 'DONE',
+          renderId,
+          width,
+          height,
+          samples: totalSamplesPerPixel,
+          elapsedMs,
+          sphereColors,
+          rgba: finalCopy.buffer
+        },
+        [finalCopy.buffer]
+      );
+    }
+  }
+};
