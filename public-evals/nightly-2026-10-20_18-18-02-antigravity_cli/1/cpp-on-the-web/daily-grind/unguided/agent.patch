+  <script src="smallpt.js"></script>
+  <script>
+    const SPHERE_NAMES = [
+      { id: 0, name: 'Left Wall' },
+      { id: 1, name: 'Right Wall' },
+      { id: 2, name: 'Back Wall' },
+      { id: 4, name: 'Floor' },
+      { id: 5, name: 'Ceiling' },
+      { id: 6, name: 'Mirror Sphere' },
+      { id: 7, name: 'Glass Sphere' }
+    ];
+
+    const canvas = document.getElementById('renderCanvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomizeBtn');
+    const resetBtn = document.getElementById('resetBtn');
+    const resolutionSelect = document.getElementById('resolutionSelect');
+    const samplesSelect = document.getElementById('samplesSelect');
+    const statusText = document.getElementById('statusText');
+    const timingText = document.getElementById('timingText');
+    const progressBar = document.getElementById('progressBar');
+    const paletteGrid = document.getElementById('paletteGrid');
+
+    let wasmReady = false;
+    let currentRenderId = 0;
+    let seedCounter = 1;
+
+    function toCssRgb(r, g, b) {
+      // Apply gamma correction (1/2.2) to match smallpt's toInt()
+      const gamma = (v) => Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255);
+      return `rgb(${gamma(r)}, ${gamma(g)}, ${gamma(b)})`;
+    }
+
+    function updatePaletteUI() {
+      if (!wasmReady) return;
+      paletteGrid.innerHTML = '';
+      for (const sphere of SPHERE_NAMES) {
+        const r = Module._get_sphere_color_channel(sphere.id, 0);
+        const g = Module._get_sphere_color_channel(sphere.id, 1);
+        const b = Module._get_sphere_color_channel(sphere.id, 2);
+
+        const item = document.createElement('div');
+        item.className = 'swatch-item';
+
+        const colorBox = document.createElement('div');
+        colorBox.className = 'swatch-color';
+        colorBox.style.backgroundColor = toCssRgb(r, g, b);
+
+        const label = document.createElement('span');
+        label.className = 'swatch-label';
+        label.textContent = sphere.name;
+
+        item.appendChild(colorBox);
+        item.appendChild(label);
+        paletteGrid.appendChild(item);
+      }
+    }
+
+    function parseResolution() {
+      const [w, h] = resolutionSelect.value.split('x').map(Number);
+      return { w, h };
+    }
+
+    function startRender() {
+      if (!wasmReady) return;
+
+      const renderId = ++currentRenderId;
+      const { w, h } = parseResolution();
+      const samps = parseInt(samplesSelect.value, 10);
+      const totalSpp = samps * 4;
+
+      canvas.width = w;
+      canvas.height = h;
+
+      const bufPtr = Module._init_render(w, h);
+      const imageData = ctx.createImageData(w, h);
+      updatePaletteUI();
+
+      let currentRow = 0;
+      const rowsPerChunk = Math.max(4, Math.floor(24 / Math.sqrt(samps)));
+      const startTime = performance.now();
+      const seedOffset = seedCounter++;
+
+      progressBar.style.width = '0%';
+      statusText.textContent = `Rendering (${totalSpp} SPP) — 0%`;
+
+      function step() {
+        if (renderId !== currentRenderId) return;
+
+        const nextRow = Math.min(h, currentRow + rowsPerChunk);
+        Module._render_rows(currentRow, nextRow, samps, seedOffset);
+        currentRow = nextRow;
+
+        // Copy pixel data from WebAssembly linear memory to Canvas
+        const wasmBytes = new Uint8ClampedArray(Module.HEAPU8.buffer, bufPtr, w * h * 4);
+        imageData.data.set(wasmBytes);
+        ctx.putImageData(imageData, 0, 0);
+
+        const pct = Math.round((currentRow / h) * 100);
+        const elapsed = Math.round(performance.now() - startTime);
+        progressBar.style.width = `${pct}%`;
+        timingText.textContent = `${elapsed} ms`;
+
+        if (currentRow < h) {
+          statusText.textContent = `Rendering (${totalSpp} SPP) — ${pct}%`;
+          requestAnimationFrame(step);
+        } else {
+          statusText.textContent = `Complete (${w}×${h}, ${totalSpp} SPP)`;
+        }
+      }
+
+      requestAnimationFrame(step);
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      if (!wasmReady) return;
+      const randomSeed = Math.floor(Math.random() * 0xffffffff);
+      Module._randomize_colors(randomSeed);
+      startRender();
+    });
+
+    resetBtn.addEventListener('click', () => {
+      if (!wasmReady) return;
+      Module._reset_colors();
+      startRender();
+    });
+
+    resolutionSelect.addEventListener('change', () => startRender());
+    samplesSelect.addEventListener('change', () => startRender());
+
+    function onWasmInitialized() {
+      if (wasmReady) return;
+      wasmReady = true;
+      randomizeBtn.disabled = false;
+      resetBtn.disabled = false;
+      startRender();
+    }
+
+    if (typeof Module !== 'undefined') {
+      if (Module.calledRun) {
+        onWasmInitialized();
+      } else {
+        const prevInit = Module.onRuntimeInitialized;
+        Module.onRuntimeInitialized = function () {
+          if (prevInit) prevInit();
+          onWasmInitialized();
+        };
+      }
+    }
+  </script>
