+
+// Buffers for progressive/interactive WebAssembly rendering
+static int cur_w = 0, cur_h = 0, cur_samples = 0;
+static Vec *accum_c = NULL;
+static uint8_t *rgba_buf = NULL;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void reset_colors() {
+  spheres[0].c = Vec(.75, .25, .25);
+  spheres[1].c = Vec(.25, .25, .75);
+  spheres[2].c = Vec(.75, .75, .75);
+  spheres[3].c = Vec();
+  spheres[4].c = Vec(.75, .75, .75);
+  spheres[5].c = Vec(.75, .75, .75);
+  spheres[6].c = Vec(1, 1, 1) * .999;
+  spheres[7].c = Vec(1, 1, 1) * .999;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) {
+    spheres[index].c = Vec(r, g, b);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_channel(int index, int channel) {
+  if (index < 0 || index >= 9) return 0;
+  if (channel == 0) return spheres[index].c.x;
+  if (channel == 1) return spheres[index].c.y;
+  if (channel == 2) return spheres[index].c.z;
+  return 0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_colors(unsigned int seed) {
+  srand(seed);
+  auto randCol = []() {
+    return 0.15 + 0.75 * (double(rand()) / RAND_MAX);
+  };
+  // Randomize Left, Right, Back, Bottom, Top, Mirror, Glass spheres
+  spheres[0].c = Vec(randCol(), randCol(), randCol()); // Left wall
+  spheres[1].c = Vec(randCol(), randCol(), randCol()); // Right wall
+  spheres[2].c = Vec(randCol(), randCol(), randCol()); // Back wall
+  spheres[4].c = Vec(randCol(), randCol(), randCol()); // Bottom floor
+  spheres[5].c = Vec(randCol(), randCol(), randCol()); // Top ceiling
+  // Also tint the mirror and glass spheres slightly or vibrantly
+  spheres[6].c = Vec(0.4 + 0.599 * (double(rand()) / RAND_MAX),
+                     0.4 + 0.599 * (double(rand()) / RAND_MAX),
+                     0.4 + 0.599 * (double(rand()) / RAND_MAX));
+  spheres[7].c = Vec(0.4 + 0.599 * (double(rand()) / RAND_MAX),
+                     0.4 + 0.599 * (double(rand()) / RAND_MAX),
+                     0.4 + 0.599 * (double(rand()) / RAND_MAX));
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* init_render(int w, int h) {
+  if (cur_w != w || cur_h != h || !accum_c || !rgba_buf) {
+    delete[] accum_c;
+    delete[] rgba_buf;
+    cur_w = w;
+    cur_h = h;
+    accum_c = new Vec[w * h];
+    rgba_buf = new uint8_t[w * h * 4];
+  }
+  for (int i = 0; i < w * h; i++) {
+    accum_c[i] = Vec();
+    rgba_buf[i * 4 + 0] = 0;
+    rgba_buf[i * 4 + 1] = 0;
+    rgba_buf[i * 4 + 2] = 0;
+    rgba_buf[i * 4 + 3] = 255;
+  }
+  cur_samples = 0;
+  return rgba_buf;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void render_rows(int y_start, int y_end, int samps, int seed_offset) {
+  int w = cur_w, h = cur_h;
+  if (!accum_c || !rgba_buf || w <= 0 || h <= 0) return;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+  for (int y = y_start; y < y_end && y < h; y++) {
+    unsigned short Xi[3] = {0, 0, (unsigned short)(y*y*y + seed_offset * 997)};
+    for (unsigned short x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      Vec c_pixel = Vec();
+      for (int sy = 0; sy < 2; sy++) {     // 2x2 subpixel rows
+        for (int sx = 0; sx < 2; sx++, r = Vec()) { // 2x2 subpixel cols
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          }
+          c_pixel = c_pixel + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      accum_c[i] = accum_c[i] + c_pixel;
+      rgba_buf[i * 4 + 0] = toInt(c_pixel.x);
+      rgba_buf[i * 4 + 1] = toInt(c_pixel.y);
+      rgba_buf[i * 4 + 2] = toInt(c_pixel.z);
+      rgba_buf[i * 4 + 3] = 255;
+    }
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void render_pass(int samps_per_subpixel, int pass_index) {
+  int w = cur_w, h = cur_h;
+  if (!accum_c || !rgba_buf || w <= 0 || h <= 0) return;
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+  cur_samples += samps_per_subpixel;
+  double inv_passes = 1.0 / (pass_index + 1);
+  for (int y = 0; y < h; y++) {
+    unsigned short Xi[3] = {
+      (unsigned short)(pass_index * 131 + y),
+      (unsigned short)(pass_index * 31337),
+      (unsigned short)(y*y*y + pass_index * 7919)
+    };
+    for (unsigned short x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      Vec c_pixel = Vec();
+      for (int sy = 0; sy < 2; sy++) {     // 2x2 subpixel rows
+        for (int sx = 0; sx < 2; sx++, r = Vec()) { // 2x2 subpixel cols
+          for (int s = 0; s < samps_per_subpixel; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps_per_subpixel);
+          }
+          c_pixel = c_pixel + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      accum_c[i] = accum_c[i] + c_pixel;
+      Vec avg = accum_c[i] * inv_passes;
+      rgba_buf[i * 4 + 0] = toInt(avg.x);
+      rgba_buf[i * 4 + 1] = toInt(avg.y);
+      rgba_buf[i * 4 + 2] = toInt(avg.z);
+      rgba_buf[i * 4 + 3] = 255;
+    }
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_scene(int w, int h, int samps) {
+  init_render(w, h);
+  render_rows(0, h, samps, 0);
+  return rgba_buf;
+}
+
+} // extern "C"
+
+int main(int argc, char *argv[]){
+  int w=1024, h=768, samps = argc==2 ? atoi(argv[1])/4 : 1; // # samples
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm()); // cam pos, dir
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r, *c=new Vec[w*h];
+#pragma omp parallel for schedule(dynamic, 1) private(r)       // OpenMP
+  for (int y=0; y<h; y++){                       // Loop over image rows
+    fprintf(stderr,"\rRendering (%d spp) %5.2f%%",samps*4,100.*y/(h-1));
+    for (unsigned short x=0, Xi[3]={0,0,(unsigned short)(y*y*y)}; x<w; x++)   // Loop cols
+      for (int sy=0, i=(h-y-1)*w+x; sy<2; sy++)     // 2x2 subpixel rows
+        for (int sx=0; sx<2; sx++, r=Vec()){        // 2x2 subpixel cols
+          for (int s=0; s<samps; s++){
+            double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+            double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+            Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                    cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samps);
+          } // Camera rays are pushed ^^^^^ forward to start in interior
+          c[i] = c[i] + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+        }
+  }
+  FILE *f = fopen("image.ppm", "w");         // Write image to PPM file.
+  fprintf(f, "P3\n%d %d\n%d\n", w, h, 255);
+  for (int i=0; i<w*h; i++)
+    fprintf(f,"%d %d %d ", toInt(c[i].x), toInt(c[i].y), toInt(c[i].z));
+}
