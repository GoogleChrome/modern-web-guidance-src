+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColorInfo {
+  index: number;
+  name: string;
+  rgb: [number, number, number];
+}
+
+const SPHERE_NAMES: { index: number; name: string }[] = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+declare global {
+  interface Window {
+    createSmallptModule?: (options?: Record<string, unknown>) => Promise<any>;
+  }
+}
+
+export default function SmallptRenderer({ baseUrl = '/devtools-times/' }: { baseUrl?: string }) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const moduleRef = useRef<any>(null);
+  const renderIdRef = useRef<number>(0);
+
+  const [status, setStatus] = useState<'loading' | 'rendering' | 'done' | 'error'>('loading');
+  const [progress, setProgress] = useState<number>(0);
+  const [renderTimeMs, setRenderTimeMs] = useState<number | null>(null);
+  const [samplesPerSubpixel, setSamplesPerSubpixel] = useState<number>(2); // 2 * 4 = 8 spp
+  const [resolution, setResolution] = useState<{ w: number; h: number }>({ w: 320, h: 240 });
+  const [sphereColors, setSphereColors] = useState<SphereColorInfo[]>([
+    { index: 0, name: 'Left Wall', rgb: [0.75, 0.25, 0.25] },
+    { index: 1, name: 'Right Wall', rgb: [0.25, 0.25, 0.75] },
+    { index: 2, name: 'Back Wall', rgb: [0.75, 0.75, 0.75] },
+    { index: 6, name: 'Mirror Sphere', rgb: [0.999, 0.999, 0.999] },
+    { index: 7, name: 'Glass Sphere', rgb: [0.999, 0.999, 0.999] },
+  ]);
+
+  const readSphereColors = useCallback((mod: any) => {
+    const updated: SphereColorInfo[] = SPHERE_NAMES.map(({ index, name }) => ({
+      index,
+      name,
+      rgb: [
+        mod._get_sphere_color_r(index),
+        mod._get_sphere_color_g(index),
+        mod._get_sphere_color_b(index),
+      ],
+    }));
+    setSphereColors(updated);
+  }, []);
+
+  const runRender = useCallback(
+    (mod: any, w: number, h: number, samps: number, seed: number) => {
+      if (!mod || !canvasRef.current) return;
+      const currentRenderId = ++renderIdRef.current;
+      setStatus('rendering');
+      setProgress(0);
+
+      const startTime = performance.now();
+      const ptr = mod._init_buffer(w, h);
+      const rowsPerChunk = 16;
+      let currentY = 0;
+
+      const step = () => {
+        if (renderIdRef.current !== currentRenderId) return;
+        const nextY = Math.min(currentY + rowsPerChunk, h);
+        mod._render_rows(w, h, samps, currentY, nextY, seed);
+        currentY = nextY;
+
+        const canvas = canvasRef.current;
+        if (canvas) {
+          const ctx = canvas.getContext('2d');
+          if (ctx) {
+            const heap = mod.HEAPU8 as Uint8Array;
+            const pixelView = new Uint8ClampedArray(heap.buffer, ptr, w * h * 4);
+            const imageData = new ImageData(new Uint8ClampedArray(pixelView), w, h);
+            ctx.putImageData(imageData, 0, 0);
+          }
+        }
+
+        setProgress(Math.round((currentY / h) * 100));
+
+        if (currentY < h) {
+          requestAnimationFrame(step);
+        } else {
+          setRenderTimeMs(Math.round(performance.now() - startTime));
+          setStatus('done');
+        }
+      };
+
+      requestAnimationFrame(step);
+    },
+    []
+  );
+
+  useEffect(() => {
+    let cancelled = false;
+    const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+    const scriptUrl = `${normalizedBase}smallpt.js`;
+    const wasmUrl = `${normalizedBase}smallpt.wasm`;
+
+    const initWasm = async () => {
+      try {
+        if (!window.createSmallptModule) {
+          await new Promise<void>((resolve, reject) => {
+            const existing = document.querySelector(`script[data-smallpt-wasm="true"]`);
+            if (existing && window.createSmallptModule) {
+              resolve();
+              return;
+            }
+            const script = document.createElement('script');
+            script.src = scriptUrl;
+            script.async = true;
+            script.dataset.smallptWasm = 'true';
+            script.onload = () => resolve();
+            script.onerror = () => {
+              // Fallback to root /smallpt.js if base path isn't used
+              const fallbackScript = document.createElement('script');
+              fallbackScript.src = '/smallpt.js';
+              fallbackScript.async = true;
+              fallbackScript.onload = () => resolve();
+              fallbackScript.onerror = (err) => reject(err);
+              document.head.appendChild(fallbackScript);
+            };
+            document.head.appendChild(script);
+          });
+        }
+
+        if (cancelled || !window.createSmallptModule) return;
+
+        const mod = await window.createSmallptModule({
+          locateFile: (path: string) => {
+            if (path.endsWith('.wasm')) {
+              return wasmUrl;
+            }
+            return path;
+          },
+        });
+
+        if (cancelled) return;
+        moduleRef.current = mod;
+        readSphereColors(mod);
+        runRender(mod, resolution.w, resolution.h, samplesPerSubpixel, 1);
+      } catch (e) {
+        console.error('Failed to initialize smallpt WebAssembly module:', e);
+        if (!cancelled) setStatus('error');
+      }
+    };
+
+    initWasm();
+    return () => {
+      cancelled = true;
+      renderIdRef.current++;
+    };
+  }, []);
+
+  const handleRandomizeAndRender = () => {
+    const mod = moduleRef.current;
+    if (!mod) return;
+    const seed = Math.floor(Math.random() * 1000000) + 1;
+    mod._randomize_sphere_colors(seed);
+    readSphereColors(mod);
+    runRender(mod, resolution.w, resolution.h, samplesPerSubpixel, seed);
+  };
+
+  const handleResetAndRender = () => {
+    const mod = moduleRef.current;
+    if (!mod) return;
+    mod._reset_default_colors();
+    readSphereColors(mod);
+    runRender(mod, resolution.w, resolution.h, samplesPerSubpixel, 1);
+  };
+
+  const toCssRgb = (rgb: [number, number, number]) => {
+    const r = Math.round(Math.pow(Math.min(1, Math.max(0, rgb[0])), 1 / 2.2) * 255);
+    const g = Math.round(Math.pow(Math.min(1, Math.max(0, rgb[1])), 1 / 2.2) * 255);
+    const b = Math.round(Math.pow(Math.min(1, Math.max(0, rgb[2])), 1 / 2.2) * 255);
+    return `rgb(${r}, ${g}, ${b})`;
+  };
+
+  return (
+    <section
+      id="smallpt-wasm-section"
+      className="bg-white border border-gray-200 rounded-lg shadow-sm p-6 my-6"
+    >
+      <div className="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 pb-4 mb-6 gap-4">
+        <div>
+          <span className="text-amber-800 text-xs font-brand uppercase tracking-widest">
+            Interactive WebAssembly Demo
+          </span>
+          <h2 className="text-2xl md:text-3xl font-brand text-gray-900 mt-1">
+            smallpt C++ Path Tracer (WebAssembly)
+          </h2>
+          <p className="text-sm text-gray-600 mt-1">
+            Kevin Beason&apos;s 99-line Monte Carlo global illumination path tracer compiled to WebAssembly and running client-side in your browser.
+          </p>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-3">
+          <button
+            id="randomize-colors-btn"
+            type="button"
+            onClick={handleRandomizeAndRender}
+            disabled={status === 'loading'}
+            className="bg-amber-600 hover:bg-amber-500 disabled:bg-gray-300 text-white font-semibold py-2.5 px-4 rounded shadow-sm transition-colors cursor-pointer text-sm"
+          >
+            Randomize Sphere Colors &amp; Re-render
+          </button>
+          <button
+            id="reset-colors-btn"
+            type="button"
+            onClick={handleResetAndRender}
+            disabled={status === 'loading'}
+            className="bg-gray-800 hover:bg-gray-700 disabled:bg-gray-300 text-white font-semibold py-2.5 px-4 rounded shadow-sm transition-colors cursor-pointer text-sm"
+          >
+            Reset Default Colors
+          </button>
+        </div>
+      </div>
+
+      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
+        <div className="lg:col-span-2 flex flex-col items-center bg-gray-950 rounded-lg p-4 relative">
+          <canvas
+            id="smallpt-canvas"
+            ref={canvasRef}
+            width={resolution.w}
+            height={resolution.h}
+            className="w-full max-w-[640px] aspect-[4/3] rounded border border-gray-800 bg-black"
+            style={{ imageRendering: 'auto' }}
+          />
+          <div className="w-full max-w-[640px] mt-3 flex items-center justify-between text-xs text-gray-300">
+            <div>
+              {status === 'loading' && <span>Loading WebAssembly module...</span>}
+              {status === 'rendering' && (
+                <span>
+                  Tracing paths in WebAssembly... <strong>{progress}%</strong> ({samplesPerSubpixel * 4} spp)
+                </span>
+              )}
+              {status === 'done' && (
+                <span>
+                  Rendered {resolution.w}&times;{resolution.h} at {samplesPerSubpixel * 4} spp in{' '}
+                  <strong>{renderTimeMs} ms</strong>
+                </span>
+              )}
+              {status === 'error' && (
+                <span className="text-red-400">Error loading smallpt WebAssembly module.</span>
+              )}
+            </div>
+            <div className="w-32 bg-gray-800 rounded-full h-2 overflow-hidden">
+              <div
+                className="bg-amber-500 h-full transition-all duration-150"
+                style={{ width: `${progress}%` }}
+              />
+            </div>
+          </div>
+        </div>
+
+        <div className="bg-gray-50 border border-gray-200 rounded-lg p-4 flex flex-col gap-4">
+          <div>
+            <h3 className="text-sm font-bold text-gray-900 uppercase tracking-wider mb-3">
+              Current Sphere Colors
+            </h3>
+            <ul className="space-y-2.5 text-sm">
+              {sphereColors.map((sphere) => (
+                <li key={sphere.index} className="flex items-center justify-between">
+                  <span className="text-gray-700 font-medium">{sphere.name}</span>
+                  <div className="flex items-center gap-2">
+                    <span className="font-mono text-xs text-gray-500">
+                      ({sphere.rgb[0].toFixed(2)}, {sphere.rgb[1].toFixed(2)}, {sphere.rgb[2].toFixed(2)})
+                    </span>
+                    <span
+                      className="w-5 h-5 rounded-full border border-gray-300 shadow-inner inline-block"
+                      style={{ backgroundColor: toCssRgb(sphere.rgb) }}
+                    />
+                  </div>
+                </li>
+              ))}
+            </ul>
+          </div>
+
+          <div className="border-t border-gray-200 pt-4">
+            <label
+              htmlFor="smallpt-spp-select"
+              className="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2"
+            >
+              Samples Per Pixel (Quality / Speed)
+            </label>
+            <select
+              id="smallpt-spp-select"
+              value={samplesPerSubpixel}
+              onChange={(e) => {
+                const newSamps = Number(e.target.value);
+                setSamplesPerSubpixel(newSamps);
+                if (moduleRef.current) {
+                  runRender(moduleRef.current, resolution.w, resolution.h, newSamps, Math.floor(Math.random() * 10000));
+                }
+              }}
+              className="w-full rounded border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800"
+            >
+              <option value={1}>4 spp (Fast preview)</option>
+              <option value={2}>8 spp (Balanced)</option>
+              <option value={4}>16 spp (Higher quality)</option>
+              <option value={8}>32 spp (Low noise)</option>
+            </select>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
