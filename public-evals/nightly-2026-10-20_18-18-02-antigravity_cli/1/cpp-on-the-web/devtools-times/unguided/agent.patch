+}
+
+static uint8_t *rgba_buf = NULL;
+static Vec *accum_buf = NULL;
+static int buf_w = 0;
+static int buf_h = 0;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  int n = sizeof(spheres) / sizeof(Sphere);
+  if (index >= 0 && index < n) {
+    spheres[index].c = Vec(r, g, b);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_r(int index) {
+  int n = sizeof(spheres) / sizeof(Sphere);
+  return (index >= 0 && index < n) ? spheres[index].c.x : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_g(int index) {
+  int n = sizeof(spheres) / sizeof(Sphere);
+  return (index >= 0 && index < n) ? spheres[index].c.y : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_b(int index) {
+  int n = sizeof(spheres) / sizeof(Sphere);
+  return (index >= 0 && index < n) ? spheres[index].c.z : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_default_colors() {
+  spheres[0].c = Vec(.75, .25, .25); // Left
+  spheres[1].c = Vec(.25, .25, .75); // Right
+  spheres[2].c = Vec(.75, .75, .75); // Back
+  spheres[3].c = Vec(0, 0, 0);       // Front
+  spheres[4].c = Vec(.75, .75, .75); // Bottom
+  spheres[5].c = Vec(.75, .75, .75); // Top
+  spheres[6].c = Vec(1, 1, 1) * .999; // Mirror
+  spheres[7].c = Vec(1, 1, 1) * .999; // Glass
+  spheres[8].c = Vec(0, 0, 0);       // Light
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  srand(seed);
+  auto randRange = [](double minVal, double maxVal) {
+    return minVal + (double(rand()) / double(RAND_MAX)) * (maxVal - minVal);
+  };
+  // Randomize Left, Right, Back, Bottom, Top, Mirror, Glass spheres
+  spheres[0].c = Vec(randRange(0.15, 0.9), randRange(0.15, 0.9), randRange(0.15, 0.9));
+  spheres[1].c = Vec(randRange(0.15, 0.9), randRange(0.15, 0.9), randRange(0.15, 0.9));
+  spheres[2].c = Vec(randRange(0.25, 0.9), randRange(0.25, 0.9), randRange(0.25, 0.9));
+  spheres[4].c = Vec(randRange(0.35, 0.9), randRange(0.35, 0.9), randRange(0.35, 0.9));
+  spheres[5].c = Vec(randRange(0.35, 0.9), randRange(0.35, 0.9), randRange(0.35, 0.9));
+  spheres[6].c = Vec(randRange(0.3, 0.999), randRange(0.3, 0.999), randRange(0.3, 0.999));
+  spheres[7].c = Vec(randRange(0.3, 0.999), randRange(0.3, 0.999), randRange(0.3, 0.999));
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* init_buffer(int w, int h) {
+  if (buf_w != w || buf_h != h || !rgba_buf || !accum_buf) {
+    if (rgba_buf) free(rgba_buf);
+    if (accum_buf) delete[] accum_buf;
+    buf_w = w;
+    buf_h = h;
+    rgba_buf = (uint8_t*)malloc(w * h * 4);
+    accum_buf = new Vec[w * h];
+  }
+  for (int i = 0; i < w * h; i++) {
+    accum_buf[i] = Vec();
+    rgba_buf[i * 4 + 0] = 0;
+    rgba_buf[i * 4 + 1] = 0;
+    rgba_buf[i * 4 + 2] = 0;
+    rgba_buf[i * 4 + 3] = 255;
+  }
+  return rgba_buf;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_rows(int w, int h, int samps, int y_start, int y_end, int pass_seed) {
+  if (!rgba_buf || buf_w != w || buf_h != h) {
+    init_buffer(w, h);
+  }
+  if (samps < 1) samps = 1;
+  if (y_start < 0) y_start = 0;
+  if (y_end > h) y_end = h;
+
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(w*.5135/h), cy=(cx%cam.d).norm()*.5135, r;
+
+  for (int y = y_start; y < y_end; y++) {
+    for (unsigned short x=0, Xi[3]={(unsigned short)(y + pass_seed), (unsigned short)(y * x + pass_seed * 31), (unsigned short)(y*y*y + pass_seed * 997)}; x<w; x++) {
+      int i = (h - y - 1) * w + x;
+      Vec pixel_c = Vec();
+      for (int sy=0; sy<2; sy++) {
+        for (int sx=0; sx<2; sx++, r=Vec()) {
+          for (int s=0; s<samps; s++) {
+            double r1=2*erand48(Xi), dx=r1<1 ? sqrt(r1)-1: 1-sqrt(2-r1);
+            double r2=2*erand48(Xi), dy=r2<1 ? sqrt(r2)-1: 1-sqrt(2-r2);
+            Vec d = cx*( ( (sx+.5 + dx)/2 + x)/w - .5) +
+                    cy*( ( (sy+.5 + dy)/2 + y)/h - .5) + cam.d;
