+          }
+          pixel_c = pixel_c + Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+        }
+      }
+      accum_buf[i] = pixel_c;
+      rgba_buf[i * 4 + 0] = (uint8_t)toInt(pixel_c.x);
+      rgba_buf[i * 4 + 1] = (uint8_t)toInt(pixel_c.y);
+      rgba_buf[i * 4 + 2] = (uint8_t)toInt(pixel_c.z);
+      rgba_buf[i * 4 + 3] = 255;
+    }
+  }
+  return rgba_buf;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render(int w, int h, int samps) {
+  init_buffer(w, h);
+  return render_rows(w, h, samps, 0, h, 0);
+}
+
+}
