diff --git a/src/components/SmallptPathTracer.tsx b/src/components/SmallptPathTracer.tsx
new file mode 100644
index 0000000..8de2971
--- /dev/null
+++ b/src/components/SmallptPathTracer.tsx
@@ -0,0 +1,224 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface PaletteColor {
+  r: number;
+  g: number;
+  b: number;
+  hex: string;
+}
+
+const SPHERE_LABELS: { index: number; label: string }[] = [
+  { index: 0, label: 'Left Wall' },
+  { index: 1, label: 'Right Wall' },
+  { index: 2, label: 'Back Wall' },
+  { index: 4, label: 'Floor' },
+  { index: 5, label: 'Ceiling' },
+  { index: 6, label: 'Mirror Sphere' },
+  { index: 7, label: 'Glass Sphere' },
+];
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const jobIdRef = useRef<number>(0);
+
+  const [status, setStatus] = useState<'initializing' | 'rendering' | 'done'>('initializing');
+  const [progress, setProgress] = useState<number>(0);
+  const [currentSpp, setCurrentSpp] = useState<number>(0);
+  const [elapsedMs, setElapsedMs] = useState<number>(0);
+  const [palette, setPalette] = useState<PaletteColor[]>([]);
+  const [maxPasses, setMaxPasses] = useState<number>(8);
+
+  const width = 320;
+  const height = 240;
+
+  const startRender = useCallback(
+    (randomize: boolean, resetColors = false, passes = maxPasses) => {
+      if (!workerRef.current) return;
+      const nextJobId = jobIdRef.current + 1;
+      jobIdRef.current = nextJobId;
+
+      setStatus('rendering');
+      setProgress(0);
+
+      workerRef.current.postMessage({
+        type: 'render',
+        jobId: nextJobId,
+        width,
+        height,
+        maxPasses: passes,
+        sampsPerPass: 1,
+        randomize,
+        resetColors,
+        seed: Math.floor(Math.random() * 0xffffffff),
+      });
+    },
+    [maxPasses]
+  );
+
+  useEffect(() => {
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+    const workerUrl = `${normalizedBase}wasm/smallpt-worker.js`;
+
+    const worker = new Worker(workerUrl, { type: 'module' });
+    workerRef.current = worker;
+
+    worker.onmessage = (e: MessageEvent) => {
+      const data = e.data;
+      if (data.jobId !== jobIdRef.current) return;
+
+      if (data.type === 'progress' || data.type === 'done') {
+        setProgress(data.progress);
+        setCurrentSpp(data.currentSpp);
+        setElapsedMs(data.elapsedMs);
+        if (data.palette) {
+          setPalette(data.palette);
+        }
+
+        const canvas = canvasRef.current;
+        if (canvas && data.pixels) {
+          const ctx = canvas.getContext('2d');
+          if (ctx) {
+            const clamped = new Uint8ClampedArray(data.pixels);
+            const imageData = new ImageData(clamped, data.width, data.height);
+            ctx.putImageData(imageData, 0, 0);
+          }
+        }
+
+        if (data.type === 'done') {
+          setStatus('done');
+        }
+      }
+    };
+
+    // Start initial render automatically on mount with default Cornell Box sphere colors
+    startRender(false, true, 8);
+
+    return () => {
+      worker.terminate();
+      workerRef.current = null;
+    };
+  }, []);
+
+  return (
+    <section
+      id="smallpt-wasm-tracer"
+      aria-labelledby="smallpt-heading"
+      className="bg-white border border-gray-200 rounded-lg shadow-sm p-6 my-6"
+    >
+      <div className="flex flex-col lg:flex-row gap-8 items-start">
+        <div className="w-full lg:w-auto flex-shrink-0 flex flex-col items-center">
+          <div className="relative bg-gray-900 rounded-md overflow-hidden shadow-md border border-gray-300">
+            <canvas
+              ref={canvasRef}
+              id="smallpt-canvas"
+              width={width}
+              height={height}
+              aria-label="smallpt WebAssembly path-traced Cornell box scene"
+              className="block w-full max-w-[480px] sm:w-[480px] aspect-[4/3] h-auto"
+            />
+            <div className="absolute bottom-2 right-2 bg-black/75 text-white text-xs font-mono px-2.5 py-1 rounded">
+              {status === 'rendering'
+                ? `Rendering: ${progress}% (${currentSpp} spp)`
+                : `Complete (${currentSpp} spp in ${(elapsedMs / 1000).toFixed(2)}s)`}
+            </div>
+          </div>
+
+          <div className="w-full max-w-[480px] mt-2 bg-gray-200 h-1.5 rounded-full overflow-hidden">
+            <div
+              className="bg-amber-600 h-full transition-all duration-150"
+              style={{ width: `${progress}%` }}
+            />
+          </div>
+        </div>
+
+        <div className="flex-1 flex flex-col justify-between">
+          <div>
+            <span className="text-amber-800 text-xs font-brand tracking-widest uppercase">
+              Interactive Graphics Lab • WebAssembly
+            </span>
+            <h2
+              id="smallpt-heading"
+              className="mt-1 text-2xl md:text-3xl font-brand text-gray-900"
+            >
+              smallpt C++ Path Tracer in WebAssembly
+            </h2>
+            <p className="mt-2 text-sm text-gray-700 leading-relaxed">
+              Running Kevin Beason&apos;s open-source 99-line C++ Monte Carlo global illumination
+              renderer (<code className="text-xs bg-gray-100 px-1.5 py-0.5 rounded">smallpt</code>)
+              client-side in a background Web Worker via Emscripten WebAssembly. Features soft
+              shadows, diffuse walls, a specular mirror sphere, and a dielectric glass sphere.
+            </p>
+
+            <div className="mt-5 flex flex-wrap items-center gap-3">
+              <button
+                type="button"
+                id="randomize-spheres-btn"
+                onClick={() => startRender(true, false, maxPasses)}
+                className="bg-amber-700 hover:bg-amber-800 active:bg-amber-900 text-white font-semibold text-sm px-4 py-2.5 rounded shadow-sm transition-colors cursor-pointer"
+              >
+                Randomize Sphere Colors &amp; Re-render
+              </button>
+
+              <button
+                type="button"
+                id="reset-spheres-btn"
+                onClick={() => startRender(false, true, maxPasses)}
+                className="bg-gray-200 hover:bg-gray-300 text-gray-800 font-medium text-sm px-3.5 py-2.5 rounded transition-colors cursor-pointer"
+              >
+                Reset Classic Colors
+              </button>
+
+              <label className="flex items-center gap-2 text-xs text-gray-600 ml-auto">
+                <span>Quality:</span>
+                <select
+                  value={maxPasses}
+                  onChange={(e) => {
+                    const nextPasses = Number(e.target.value);
+                    setMaxPasses(nextPasses);
+                    startRender(false, false, nextPasses);
+                  }}
+                  className="border border-gray-300 rounded px-2 py-1.5 bg-white text-gray-800"
+                >
+                  <option value={2}>Fast (8 spp)</option>
+                  <option value={8}>Balanced (32 spp)</option>
+                  <option value={16}>High (64 spp)</option>
+                </select>
+              </label>
+            </div>
+          </div>
+
+          {palette.length > 0 && (
+            <div className="mt-6 pt-4 border-t border-gray-200">
+              <h3 className="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2.5">
+                Current Scene Sphere Colors
+              </h3>
+              <ul className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs text-gray-700">
+                {SPHERE_LABELS.map(({ index, label }) => {
+                  const color = palette[index];
+                  if (!color) return null;
+                  return (
+                    <li
+                      key={index}
+                      className="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded px-2 py-1.5"
+                    >
+                      <span
+                        className="w-3.5 h-3.5 rounded-full border border-gray-300 flex-shrink-0"
+                        style={{ backgroundColor: color.hex }}
+                        aria-hidden="true"
+                      />
+                      <span className="truncate" title={`${label} (${color.hex})`}>
+                        {label}
+                      </span>
+                    </li>
+                  );
+                })}
+              </ul>
+            </div>
+          )}
+        </div>
+      </div>
+    </section>
+  );
+}
