diff --git a/public/wasm/smallpt-worker.js b/public/wasm/smallpt-worker.js
new file mode 100644
index 0000000..a38a460
--- /dev/null
+++ b/public/wasm/smallpt-worker.js
@@ -0,0 +1,108 @@
+import createSmallptModule from './smallpt.js';
+
+let wasmModule = null;
+let currentJobId = 0;
+
+async function ensureModule() {
+  if (!wasmModule) {
+    wasmModule = await createSmallptModule();
+  }
+  return wasmModule;
+}
+
+function readSphereColors(mod) {
+  const ptr = mod._malloc(9 * 3 * 8);
+  mod._get_sphere_colors(ptr);
+  const floatView = new Float64Array(mod.HEAPF64.buffer, ptr, 27);
+  const colors = [];
+  for (let i = 0; i < 9; i++) {
+    const r = Math.round(Math.pow(Math.max(0, Math.min(1, floatView[i * 3 + 0])), 1 / 2.2) * 255);
+    const g = Math.round(Math.pow(Math.max(0, Math.min(1, floatView[i * 3 + 1])), 1 / 2.2) * 255);
+    const b = Math.round(Math.pow(Math.max(0, Math.min(1, floatView[i * 3 + 2])), 1 / 2.2) * 255);
+    colors.push({ r, g, b, hex: `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}` });
+  }
+  mod._free(ptr);
+  return colors;
+}
+
+self.onmessage = async (e) => {
+  const { type, width = 320, height = 240, maxPasses = 8, sampsPerPass = 1, randomize = false, seed = Date.now(), jobId = 0 } = e.data;
+
+  if (type === 'stop') {
+    currentJobId = -1;
+    return;
+  }
+
+  if (type === 'render') {
+    currentJobId = jobId;
+    const mod = await ensureModule();
+    if (currentJobId !== jobId) return;
+
+    if (randomize) {
+      mod._randomize_sphere_colors(seed >>> 0);
+    } else if (e.data.resetColors) {
+      mod._reset_default_colors();
+    }
+
+    const palette = readSphereColors(mod);
+    const imgPtr = mod._init_buffer(width, height);
+    const byteLength = width * height * 4;
+    const startTime = performance.now();
+
+    const chunkRows = 24;
+
+    for (let pass = 0; pass < maxPasses; pass++) {
+      if (currentJobId !== jobId) return;
+
+      for (let y = 0; y < height; y += chunkRows) {
+        if (currentJobId !== jobId) return;
+        const yEnd = Math.min(y + chunkRows, height);
+        mod._render_rows(width, height, y, yEnd, sampsPerPass, pass);
+
+        const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, imgPtr, byteLength).slice();
+        const totalRowsDone = pass * height + yEnd;
+        const totalRowsTarget = maxPasses * height;
+        const progress = Math.round((totalRowsDone / totalRowsTarget) * 100);
+        const currentSpp = (pass + 1) * sampsPerPass * 4;
+
+        self.postMessage(
+          {
+            type: 'progress',
+            jobId,
+            width,
+            height,
+            pass: pass + 1,
+            maxPasses,
+            currentSpp,
+            progress,
+            elapsedMs: Math.round(performance.now() - startTime),
+            palette,
+            pixels: pixels.buffer,
+          },
+          [pixels.buffer]
+        );
+
+        // Yield briefly so worker can receive any incoming 'render' or 'stop' messages
+        await new Promise((r) => setTimeout(r, 0));
+      }
+    }
+
+    if (currentJobId === jobId) {
+      const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, imgPtr, byteLength).slice();
+      self.postMessage(
+        {
+          type: 'done',
+          jobId,
+          width,
+          height,
+          currentSpp: maxPasses * sampsPerPass * 4,
+          progress: 100,
+          elapsedMs: Math.round(performance.now() - startTime),
+          palette,
+          pixels: pixels.buffer,
+        },
+        [pixels.buffer]
+      );
+    }
+  }
+};
