+  <script>
+    const form = document.getElementById('subscription-form');
+    const roastSlider = document.getElementById('roast-level');
+    const roastOutput = document.getElementById('roast-output');
+    const progressEl = document.getElementById('subscription-progress');
+    const progressOutput = document.getElementById('progress-output');
+    const emailCheckbox = document.getElementById('email-updates');
+    const statusEl = document.getElementById('subscription-status');
+
+    const roastLabels = {
+      1: 'Light Roast (1/5)',
+      2: 'Medium-Light Roast (2/5)',
+      3: 'Medium Roast (3/5)',
+      4: 'Medium-Dark Roast (4/5)',
+      5: 'Dark Roast (5/5)'
+    };
+
+    let roastInteracted = false;
+
+    function updateProgress(complete = false) {
+      if (complete) {
+        progressEl.value = 100;
+        progressEl.textContent = '100%';
+        progressOutput.textContent = '100%';
+        return;
+      }
+      let steps = 0;
+      const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+      if (selectedFreq) steps += 1;
+      if (roastSlider.value) steps += 1;
+      if (emailCheckbox.checked) steps += 1;
+      if (roastInteracted) steps += 1;
+
+      const pct = Math.min(100, Math.max(25, steps * 25));
+      progressEl.value = pct;
+      progressEl.textContent = `${pct}%`;
+      progressOutput.textContent = `${pct}%`;
+    }
+
+    roastSlider.addEventListener('input', (e) => {
+      roastInteracted = true;
+      const val = Number(e.target.value);
+      const min = Number(e.target.min) || 1;
+      const max = Number(e.target.max) || 5;
+      const pct = ((val - min) / (max - min)) * 100;
+      e.target.style.setProperty('--progress', `${pct}%`);
+      roastOutput.textContent = roastLabels[val] || `Level ${val}`;
+      updateProgress();
+    });
+
+    form.addEventListener('change', () => {
+      updateProgress();
+    });
+
+    if (!CSS.supports('accent-color', '#4e342e')) {
+      roastSlider.addEventListener('input', (e) => {
+        const val = Number(e.target.value);
+        const min = Number(e.target.min) || 1;
+        const max = Number(e.target.max) || 5;
+        const pct = ((val - min) / (max - min)) * 100;
+        e.target.style.setProperty('--progress', `${pct}%`);
+      });
+    }
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      updateProgress(true);
+      const freq = form.querySelector('input[name="delivery_frequency"]:checked')?.value || 'weekly';
+      const roast = roastLabels[roastSlider.value];
+      statusEl.textContent = `✓ Subscription saved: ${roast}, delivered ${freq}!`;
+    });
+  </script>
