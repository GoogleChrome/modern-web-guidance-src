+  <script>
+    (function () {
+      const form = document.getElementById('coffee-subscription-form');
+      const progress = document.getElementById('subscription-progress');
+      const progressText = document.getElementById('progress-status-text');
+      const roastInput = document.getElementById('roast-preference');
+      const roastDisplay = document.getElementById('roast-level-display');
+      const emailCheckbox = document.getElementById('receive-emails');
+
+      const roastNames = {
+        '1': 'Light (1/5)',
+        '2': 'Medium-Light (2/5)',
+        '3': 'Medium (3/5)',
+        '4': 'Medium-Dark (4/5)',
+        '5': 'Dark Espresso (5/5)'
+      };
+
+      function updateFormState() {
+        if (roastInput && roastDisplay) {
+          roastDisplay.textContent = roastNames[roastInput.value] || roastInput.value;
+        }
+
+        let completedSteps = 0;
+        const totalSteps = 3;
+
+        const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+        if (selectedFreq) completedSteps += 1;
+        if (roastInput && roastInput.value) completedSteps += 1;
+        if (emailCheckbox && emailCheckbox.checked) completedSteps += 1;
+
+        const percentage = Math.round((completedSteps / totalSteps) * 100);
+        if (progress) {
+          progress.value = percentage;
+          progress.textContent = percentage + '%';
+        }
+        if (progressText) {
+          progressText.textContent = percentage + '% Complete';
+        }
+      }
+
+      if (form) {
+        form.addEventListener('input', updateFormState);
+        form.addEventListener('change', updateFormState);
+        updateFormState();
+      }
+    })();
+  </script>
