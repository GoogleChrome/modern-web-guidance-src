+      align-items: center;
+      justify-content: center;
+      padding: 80px 20px;
+      view-timeline-name: --craft-parallax;
+      view-timeline-axis: block;
+    }
+
+    .parallax-layer {
+      will-change: transform;
+    }
+
+    @supports (animation-timeline: view()) {
+      @media (prefers-reduced-motion: no-preference) {
+        .parallax-layer {
+          animation: parallax-shift linear both;
+          animation-timeline: --craft-parallax;
+          animation-range: entry 0% exit 100%;
+        }
+      }
+    }
+
+    .parallax-bg {
+      --parallax-speed: 1.4;
+      position: absolute;
+      inset: -20% 0;
+      background: linear-gradient(rgba(30, 18, 14, 0.72), rgba(30, 18, 14, 0.82)),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1400&q=80') center / cover no-repeat;
+      z-index: 1;
+      pointer-events: none;
+    }
+
+    .parallax-scene {
+      position: relative;
+      z-index: 2;
+      max-width: 1100px;
