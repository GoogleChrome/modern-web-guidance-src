+    /* Scroll-Driven Parallax Section */
+    @keyframes parallax-shift {
+      from {
+        transform: translate3d(0, calc(var(--parallax-speed, 0) * -120px), 0);
+      }
+      to {
+        transform: translate3d(0, calc(var(--parallax-speed, 0) * 120px), 0);
+      }
+    }
+
+    .parallax-section {
+      position: relative;
+      min-height: 75vh;
+      overflow: hidden;
+      background-color: #2b1b17;
+      color: var(--light);
