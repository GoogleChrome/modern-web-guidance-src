+      gap: 12px;
+      flex-wrap: wrap;
+      list-style: none;
+      margin-top: 16px;
+    }
+
+    .parallax-badges li {
+      background: rgba(255, 171, 64, 0.15);
+      border: 1px solid var(--accent);
+      color: #ffe0b2;
+      padding: 4px 12px;
+      border-radius: 999px;
+      font-size: 0.8rem;
+      font-weight: 600;
+    }
+
+    @media (max-width: 850px) {
+      .parallax-scene {
+        grid-template-columns: 1fr;
+        max-width: 540px;
+      }
+
+      .parallax-layer--slow,
+      .parallax-layer--mid,
+      .parallax-layer--fast {
+        --parallax-speed: 0.25;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .parallax-layer {
+        animation: none !important;
+        transform: none !important;
+        will-change: auto;
+      }
+    }
