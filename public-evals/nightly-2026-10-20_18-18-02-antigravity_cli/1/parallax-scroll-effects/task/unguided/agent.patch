+      display: grid;
+      grid-template-columns: 1fr 1.1fr 1fr;
+      gap: 32px;
+      align-items: center;
+    }
+
+    .parallax-media {
+      border-radius: 12px;
+      overflow: hidden;
+      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
+      border: 2px solid rgba(255, 171, 64, 0.25);
+      background: #1e120e;
+    }
+
+    .parallax-media img {
+      display: block;
+      width: 100%;
+      height: 300px;
+      object-fit: cover;
+    }
+
+    .parallax-media-caption {
+      padding: 12px 16px;
+      font-size: 0.85rem;
+      color: var(--secondary);
+      background: rgba(30, 18, 14, 0.9);
+      text-align: center;
+      letter-spacing: 0.5px;
+    }
+
+    .parallax-layer--slow {
+      --parallax-speed: 0.65;
+    }
+
+    .parallax-layer--mid {
+      --parallax-speed: -0.25;
+    }
+
+    .parallax-layer--fast {
+      --parallax-speed: -0.95;
+    }
+
+    .parallax-card {
+      background: rgba(62, 39, 35, 0.92);
+      border: 1px solid rgba(215, 204, 200, 0.2);
+      padding: 36px 28px;
+      border-radius: 12px;
+      text-align: center;
+      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
+    }
+
+    .parallax-eyebrow {
+      display: inline-block;
+      text-transform: uppercase;
+      letter-spacing: 2px;
+      font-size: 0.78rem;
+      color: var(--accent);
+      font-weight: 700;
+      margin-bottom: 10px;
+    }
+
+    .parallax-card h2 {
+      font-size: 2.1rem;
+      margin-bottom: 14px;
+      color: #ffffff;
+      line-height: 1.25;
+    }
+
+    .parallax-card p {
+      color: var(--secondary);
+      margin-bottom: 20px;
+      font-size: 1rem;
+    }
+
+    .parallax-badges {
+      display: flex;
