+    /* Spotlight Reveal Effect */
+    @property --inner-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    @property --outer-size {
+      syntax: "<length-percentage>";
+      inherits: true;
+      initial-value: 0px;
+    }
+
+    .product-card {
+      position: relative;
+      overflow: hidden;
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      transition: --inner-size 0.25s ease-in-out, --outer-size 0.25s ease-in-out;
+    }
+
+    .product-card:hover {
+      --inner-size: 90px;
+      --outer-size: 130px;
+    }
+
+    .product-card > :not(.reveal-layer) {
+      position: relative;
+      z-index: 2;
+    }
+
+    .reveal-layer {
+      position: absolute;
+      inset: 0;
+      z-index: 1;
+      pointer-events: none;
+      user-select: none;
+      transition: --inner-size 0.25s ease-in-out, --outer-size 0.25s ease-in-out;
+      -webkit-mask-image: radial-gradient(
+        circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
+        black var(--inner-size, 0px),
+        transparent var(--outer-size, 0px)
+      );
+      mask-image: radial-gradient(
+        circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
+        black var(--inner-size, 0px),
+        transparent var(--outer-size, 0px)
+      );
+      -webkit-mask-repeat: no-repeat;
+      mask-repeat: no-repeat;
+      background-color: #f3e5db;
+      background-image: radial-gradient(rgba(78, 52, 46, 0.14) 1.5px, transparent 1.5px);
+      background-size: 16px 16px;
+      display: flex;
+      align-items: flex-start;
+      justify-content: flex-end;
+      padding: 12px;
+    }
+
+    .reveal-badge {
+      font-size: 0.75rem;
+      font-weight: 700;
+      text-transform: uppercase;
+      letter-spacing: 0.05em;
+      color: var(--primary);
+      background: rgba(255, 171, 64, 0.35);
+      border: 1px solid var(--accent);
+      padding: 2px 8px;
+      border-radius: 999px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card,
+      .reveal-layer {
+        transition: none !important;
+      }
+    }
+
