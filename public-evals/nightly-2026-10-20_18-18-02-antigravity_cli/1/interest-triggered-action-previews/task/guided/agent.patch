+  <script type="module">
+    const seasonalPreview = document.getElementById("seasonal-preview");
+    const defaultPreviewText = "Select a drink to preview";
+
+    seasonalPreview.addEventListener("interest", (event) => {
+      const drink = event.source?.dataset.drink;
+      if (drink) {
+        seasonalPreview.textContent = drink;
+        seasonalPreview.dataset.preview = drink;
+      }
+    });
+
+    seasonalPreview.addEventListener("loseinterest", () => {
+      seasonalPreview.textContent = defaultPreviewText;
+      delete seasonalPreview.dataset.preview;
+    });
+
+    if (!HTMLButtonElement.prototype.hasOwnProperty("interestForElement")) {
+      await import("https://unpkg.com/interestfor@latest");
+    }
+  </script>
