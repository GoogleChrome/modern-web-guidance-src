+  <script>
+    const STORAGE_KEYS = {
+      pickupTime: 'dailyGrind.pickupReminderPlainTime',
+      anniversaryDate: 'dailyGrind.coffeeAnniversaryPlainDate'
+    };
+
+    function validateField(input, errorEl, emptyMessage) {
+      if (!input.value) {
+        input.setCustomValidity(emptyMessage);
+        errorEl.textContent = `⚠ ${emptyMessage}`;
+        return false;
+      }
+      input.setCustomValidity('');
+      errorEl.textContent = '';
+      return true;
+    }
+
+    function renderPreferences(plainTime, plainDate) {
+      const timeDisplay = document.getElementById('display-pickup-time');
+      const dateDisplay = document.getElementById('display-anniversary-date');
+
+      // Temporal.PlainTime and Temporal.PlainDate are time-zone unaware:
+      // formatting or reading their fields directly never shifts across time zones.
+      const formattedTime = plainTime.toLocaleString(undefined, {
+        hour: '2-digit',
+        minute: '2-digit'
+      });
+      const formattedDate = plainDate.toLocaleString(undefined, {
+        year: 'numeric',
+        month: 'long',
+        day: 'numeric'
+      });
+
+      const { year, month, day } = plainDate;
+      const isoDate = `${String(year).padStart(4, '0')}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
+      const isoTime = plainTime.toString({ smallestUnit: 'minute' });
+
+      timeDisplay.textContent = `${formattedTime} (${isoTime} local wall-clock time)`;
+      dateDisplay.textContent = `${formattedDate} (${isoDate} calendar date)`;
+    }
+
+    function initializeApp() {
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const timeError = document.getElementById('pickup-time-error');
+      const dateError = document.getElementById('anniversary-date-error');
+      const saveBtn = document.getElementById('save-preferences-btn');
+
+      // Restore previously saved PlainTime / PlainDate strings if available
+      const savedTimeStr = localStorage.getItem(STORAGE_KEYS.pickupTime) || timeInput.value;
+      const savedDateStr = localStorage.getItem(STORAGE_KEYS.anniversaryDate) || dateInput.value;
+
+      let currentPlainTime = Temporal.PlainTime.from(savedTimeStr);
+      let currentPlainDate = Temporal.PlainDate.from(savedDateStr);
+
+      timeInput.value = currentPlainTime.toString({ smallestUnit: 'minute' });
+      dateInput.value = currentPlainDate.toString();
+      renderPreferences(currentPlainTime, currentPlainDate);
+
+      // Validate on blur and clear errors on input
+      timeInput.addEventListener('blur', () => {
+        validateField(timeInput, timeError, 'Please select a daily pickup reminder time.');
+      });
+      timeInput.addEventListener('input', () => {
+        timeInput.setCustomValidity('');
+        timeError.textContent = '';
+        saveBtn.disabled = false;
+      });
+
+      dateInput.addEventListener('blur', () => {
+        validateField(dateInput, dateError, 'Please select your coffee anniversary date.');
+      });
+      dateInput.addEventListener('input', () => {
+        dateInput.setCustomValidity('');
+        dateError.textContent = '';
+        saveBtn.disabled = false;
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+
+        const isTimeValid = validateField(timeInput, timeError, 'Please select a daily pickup reminder time.');
+        const isDateValid = validateField(dateInput, dateError, 'Please select your coffee anniversary date.');
+
+        if (!isTimeValid) {
+          timeInput.focus();
+          return;
+        }
+        if (!isDateValid) {
+          dateInput.focus();
+          return;
+        }
+
+        // Capture location-agnostic values via Temporal Plain types
+        const nextPlainTime = Temporal.PlainTime.from(timeInput.value);
+        const nextPlainDate = Temporal.PlainDate.from(dateInput.value);
+
+        currentPlainTime = nextPlainTime;
+        currentPlainDate = nextPlainDate;
+
+        localStorage.setItem(STORAGE_KEYS.pickupTime, currentPlainTime.toString({ smallestUnit: 'minute' }));
+        localStorage.setItem(STORAGE_KEYS.anniversaryDate, currentPlainDate.toString());
+
+        renderPreferences(currentPlainTime, currentPlainDate);
+        saveBtn.disabled = true;
+      });
+    }
+
+    // Check if Temporal is supported natively; otherwise load @js-temporal/polyfill
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
