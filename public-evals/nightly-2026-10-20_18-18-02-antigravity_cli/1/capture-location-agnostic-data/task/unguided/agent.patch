+  <script>
+    (function () {
+      const STORAGE_KEY_TIME = 'dailyGrind_pickupReminderPlainTime';
+      const STORAGE_KEY_DATE = 'dailyGrind_coffeeAnniversaryPlainDate';
+
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const displayTime = document.getElementById('display-pickup-time');
+      const displayDate = document.getElementById('display-anniversary-date');
+      const statusEl = document.getElementById('preferences-status');
+
+      const MONTH_NAMES = [
+        'January', 'February', 'March', 'April', 'May', 'June',
+        'July', 'August', 'September', 'October', 'November', 'December'
+      ];
+
+      /**
+       * Parses and normalizes a location-agnostic wall-clock time (HH:MM)
+       * using Temporal.PlainTime when available, without any time zone or UTC conversion.
+       */
+      function parsePlainTime(rawTimeStr) {
+        if (!rawTimeStr) return null;
+        if (typeof Temporal !== 'undefined' && Temporal.PlainTime) {
+          const pt = Temporal.PlainTime.from(rawTimeStr);
+          return {
+            iso: pt.toString({ smallestUnit: 'minute' }),
+            hour: pt.hour,
+            minute: pt.minute
+          };
+        }
+        const parts = String(rawTimeStr).trim().split(':');
+        if (parts.length < 2) return null;
+        const hour = parseInt(parts[0], 10);
+        const minute = parseInt(parts[1], 10);
+        if (Number.isNaN(hour) || Number.isNaN(minute)) return null;
+        const iso = String(hour).padStart(2, '0') + ':' + String(minute).padStart(2, '0');
+        return { iso, hour, minute };
+      }
+
+      /**
+       * Parses and normalizes a location-agnostic calendar date (YYYY-MM-DD)
+       * using Temporal.PlainDate when available, avoiding Date.parse / UTC midnight shifts.
+       */
+      function parsePlainDate(rawDateStr) {
+        if (!rawDateStr) return null;
+        if (typeof Temporal !== 'undefined' && Temporal.PlainDate) {
+          const pd = Temporal.PlainDate.from(rawDateStr);
+          return {
+            iso: pd.toString(),
+            year: pd.year,
+            month: pd.month,
+            day: pd.day
+          };
+        }
+        const parts = String(rawDateStr).trim().split('-');
+        if (parts.length !== 3) return null;
+        const year = parseInt(parts[0], 10);
+        const month = parseInt(parts[1], 10);
+        const day = parseInt(parts[2], 10);
+        if (Number.isNaN(year) || Number.isNaN(month) || Number.isNaN(day)) return null;
+        const iso =
+          String(year).padStart(4, '0') + '-' +
+          String(month).padStart(2, '0') + '-' +
+          String(day).padStart(2, '0');
+        return { iso, year, month, day };
+      }
+
+      function formatPlainTimeDisplay(plainTime) {
+        if (!plainTime) return '';
+        const period = plainTime.hour >= 12 ? 'PM' : 'AM';
+        const hour12 = plainTime.hour % 12 === 0 ? 12 : plainTime.hour % 12;
+        const minutePadded = String(plainTime.minute).padStart(2, '0');
+        return `${plainTime.iso} (${hour12}:${minutePadded} ${period})`;
+      }
+
+      function formatPlainDateDisplay(plainDate) {
+        if (!plainDate) return '';
+        const monthName = MONTH_NAMES[plainDate.month - 1] || '';
+        return `${plainDate.iso} (${monthName} ${plainDate.day}, ${plainDate.year})`;
+      }
+
+      function renderPreferences(timeStr, dateStr) {
+        const pt = parsePlainTime(timeStr);
+        const pd = parsePlainDate(dateStr);
+
+        if (pt) {
+          timeInput.value = pt.iso;
+          displayTime.textContent = formatPlainTimeDisplay(pt);
+          displayTime.dataset.plainTime = pt.iso;
+        }
+
+        if (pd) {
+          dateInput.value = pd.iso;
+          displayDate.textContent = formatPlainDateDisplay(pd);
+          displayDate.dataset.plainDate = pd.iso;
+        }
+      }
+
+      function loadPreferences() {
+        try {
+          const savedTime = localStorage.getItem(STORAGE_KEY_TIME) || timeInput.value;
+          const savedDate = localStorage.getItem(STORAGE_KEY_DATE) || dateInput.value;
+          renderPreferences(savedTime, savedDate);
+        } catch (err) {
+          renderPreferences(timeInput.value, dateInput.value);
+        }
+      }
+
+      function savePreferences(showMessage) {
+        const pt = parsePlainTime(timeInput.value);
+        const pd = parsePlainDate(dateInput.value);
+        if (!pt || !pd) return;
+
+        try {
+          localStorage.setItem(STORAGE_KEY_TIME, pt.iso);
+          localStorage.setItem(STORAGE_KEY_DATE, pd.iso);
+        } catch (err) {
+          // Ignore storage quota/privacy errors while still updating the UI
+        }
+
+        renderPreferences(pt.iso, pd.iso);
+
+        if (showMessage) {
+          statusEl.textContent = `Saved! Locked to ${pt.iso} daily and ${pd.iso} across all time zones.`;
+        }
+      }
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        savePreferences(true);
+      });
+
+      timeInput.addEventListener('change', function () {
+        savePreferences(false);
+      });
+
+      dateInput.addEventListener('change', function () {
+        savePreferences(false);
+      });
+
+      loadPreferences();
+    })();
+  </script>
