diff --git a/server.js b/server.js
new file mode 100644
index 0000000..268783f
--- /dev/null
+++ b/server.js
@@ -0,0 +1,291 @@
+import { randomBytes } from 'node:crypto';
+import fs from 'node:fs/promises';
+import http from 'node:http';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import {
+  generateVerificationNonce,
+  verifyEmailVerificationToken,
+} from './email-verification.js';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const PORT = Number(process.env.PORT || 11222);
+const RP_ORIGIN = process.env.RP_ORIGIN || `http://localhost:${PORT}`;
+const ORIGIN_TRIAL_TOKEN =
+  process.env.EMAIL_VERIFICATION_ORIGIN_TRIAL_TOKEN ||
+  'A1b2C3d4E5f6G7h8I9j0K1l2M3n4O5p6Q7r8S9t0U1v2W3x4Y5z6==';
+
+// Server-side session store mapping session ID -> session state (never store the expected
+// nonce directly inside a client cookie where an attacker could replay both).
+export const sessionStore = new Map();
+
+export function parseCookies(cookieHeader = '') {
+  const cookies = {};
+  for (const part of cookieHeader.split(';')) {
+    const [rawKey, ...rest] = part.trim().split('=');
+    if (!rawKey) continue;
+    cookies[rawKey] = decodeURIComponent(rest.join('='));
+  }
+  return cookies;
+}
+
+export function getOrCreateSession(req, res) {
+  const cookies = parseCookies(req.headers.cookie);
+  const cookieName = RP_ORIGIN.startsWith('https://') ? '__Host-session_id' : 'session_id';
+  let sessionId = cookies['__Host-session_id'] || cookies.session_id;
+  let session = sessionId ? sessionStore.get(sessionId) : undefined;
+
+  if (!session) {
+    sessionId = randomBytes(32).toString('base64url');
+    session = {
+      id: sessionId,
+      nonces: {},
+      user: null,
+      lastVerificationResult: null,
+    };
+    sessionStore.set(sessionId, session);
+
+    const cookieFlags = [
+      `${cookieName}=${encodeURIComponent(sessionId)}`,
+      'Path=/',
+      'HttpOnly',
+      'SameSite=Lax',
+    ];
+    if (RP_ORIGIN.startsWith('https://')) {
+      cookieFlags.push('Secure');
+    }
+    res.setHeader('Set-Cookie', cookieFlags.join('; '));
+  }
+
+  return session;
+}
+
+/**
+ * Atomically reads and deletes the single-use nonce for a given flow (or any active flow)
+ * from server-side session state so an intercepted token cannot be replayed.
+ */
+export function consumeSessionNonce(session, flow = 'default') {
+  if (!session || !session.nonces) return undefined;
+  const expectedNonce = session.nonces[flow] ?? session.nonces.default;
+  delete session.nonces[flow];
+  if (flow !== 'default') {
+    delete session.nonces.default;
+  }
+  return expectedNonce;
+}
+
+/**
+ * Generates and stores fresh per-form cryptographic nonces in server-side session state.
+ */
+export function issueFormNonces(session) {
+  const signupNonce = generateVerificationNonce();
+  const signinNonce = generateVerificationNonce();
+  const recoveryNonce = generateVerificationNonce();
+
+  session.nonces.signup = signupNonce;
+  session.nonces.signin = signinNonce;
+  session.nonces.recovery = recoveryNonce;
+  session.nonces.default = signupNonce;
+
+  return { signupNonce, signinNonce, recoveryNonce };
+}
+
+export function completeAccountCreation(submittedEmail, flow = 'signup') {
+  return {
+    verified: true,
+    method: 'evp-fast-path',
+    flow,
+    email: submittedEmail,
+    message: `Email ownership for ${submittedEmail} was cryptographically verified via the Email Verification Protocol (EVP). Account ${flow} completed immediately without sending an OTP or magic link email.`,
+  };
+}
+
+export function sendTraditionalVerificationEmail(submittedEmail, flow = 'signup') {
+  return {
+    verified: false,
+    method: 'otp-fallback',
+    flow,
+    email: submittedEmail,
+    message: `Browser did not provide a valid Email Verification Token. Sent a fallback verification OTP / magic link email to ${submittedEmail} to complete ${flow}.`,
+  };
+}
+
+/**
+ * Processes an account creation, sign-in, or recovery form submission.
+ * Always treats the `token` field as untrusted input, atomically consumes the single-use
+ * nonce from server-side session state, verifies the SD-JWT presentation (`EVT + KB-JWT`),
+ * and falls back gracefully to standard OTP/magic link email when `token` is empty or fails.
+ */
+export async function handleVerificationSubmission({
+  submittedEmail,
+  rawToken,
+  flow = 'signup',
+  session,
+  expectedAudience = RP_ORIGIN,
+  verifyOptions = {},
+}) {
+  const cleanEmail = String(submittedEmail || '').trim();
+  const cleanToken = String(rawToken || '').trim();
+  // Atomically read and delete the single-use nonce from server-side session state
+  const expectedNonce = consumeSessionNonce(session, flow);
+
+  if (cleanToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken: cleanToken,
+        submittedEmail: cleanEmail,
+        expectedNonce,
+        expectedAudience,
+        ...verifyOptions,
+      });
+      // Fast path: email ownership is cryptographically verified; skip OTP email.
+      const result = completeAccountCreation(cleanEmail, flow);
+      if (session) {
+        session.user = { email: cleanEmail, verifiedVia: 'EVP' };
+        session.lastVerificationResult = result;
+      }
+      return result;
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err.message || err);
+    }
+  }
+
+  // Fallback path: send standard OTP code or magic link email to submittedEmail.
+  const fallbackResult = sendTraditionalVerificationEmail(cleanEmail, flow);
+  if (session) {
+    session.lastVerificationResult = fallbackResult;
+  }
+  return fallbackResult;
+}
+
+async function readRequestBody(req) {
+  const chunks = [];
+  for await (const chunk of req) {
+    chunks.push(chunk);
+  }
+  const raw = Buffer.concat(chunks).toString('utf8');
+  const contentType = req.headers['content-type'] || '';
+  if (contentType.includes('application/json')) {
+    try {
+      return JSON.parse(raw);
+    } catch {
+      return {};
+    }
+  }
+  const params = new URLSearchParams(raw);
+  return Object.fromEntries(params.entries());
+}
+
+export async function renderHtmlPage(session) {
+  const templatePath = path.join(__dirname, 'index.html');
+  let html = await fs.readFile(templatePath, 'utf8');
+  const { signupNonce, signinNonce, recoveryNonce } = issueFormNonces(session);
+
+  html = html
+    .replaceAll('__ORIGIN_TRIAL_TOKEN__', ORIGIN_TRIAL_TOKEN)
+    .replaceAll('__SIGNUP_NONCE__', signupNonce)
+    .replaceAll('__SIGNIN_NONCE__', signinNonce)
+    .replaceAll('__RECOVERY_NONCE__', recoveryNonce)
+    .replaceAll('SERVER_GENERATED_PER_FORM_NONCE', signupNonce);
+
+  return html;
+}
+
+export function createAppServer(options = {}) {
+  return http.createServer(async (req, res) => {
+    try {
+      const url = new URL(req.url || '/', RP_ORIGIN);
+      const session = getOrCreateSession(req, res);
+
+      // Standard security headers & Origin Trial header
+      res.setHeader('Origin-Trial', ORIGIN_TRIAL_TOKEN);
+      res.setHeader('X-Content-Type-Options', 'nosniff');
+      res.setHeader('X-Frame-Options', 'SAMEORIGIN');
+      res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+
+      if (
+        req.method === 'POST' &&
+        (url.pathname === '/api/verify-email' ||
+          url.pathname === '/api/signup' ||
+          url.pathname === '/api/signin' ||
+          url.pathname === '/api/recover')
+      ) {
+        res.setHeader('Cache-Control', 'no-store');
+        const body = await readRequestBody(req);
+        const routeFlowMap = {
+          '/api/signup': 'signup',
+          '/api/signin': 'signin',
+          '/api/recover': 'recovery',
+        };
+        const flow = body.flow || routeFlowMap[url.pathname] || 'signup';
+        const result = await handleVerificationSubmission({
+          submittedEmail: body.email,
+          rawToken: body.token,
+          flow,
+          session,
+          expectedAudience: options.expectedAudience || RP_ORIGIN,
+          verifyOptions: options.verifyOptions,
+        });
+
+        const accept = req.headers.accept || '';
+        if (accept.includes('application/json') || req.headers['x-requested-with'] === 'fetch') {
+          const freshNonces = issueFormNonces(session);
+          res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8' });
+          res.end(JSON.stringify({ ...result, nonces: freshNonces }));
+          return;
+        }
+
+        // Standard HTML form post redirect / response
+        const html = await renderHtmlPage(session);
+        res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+        res.end(html);
+        return;
+      }
+
+      if (req.method === 'POST' && url.pathname === '/logout') {
+        sessionStore.delete(session.id);
+        res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+        res.writeHead(303, { Location: '/' });
+        res.end();
+        return;
+      }
+
+      if (
+        req.method === 'GET' &&
+        (url.pathname === '/' ||
+          url.pathname === '/index.html' ||
+          url.pathname === '/account' ||
+          url.pathname === '/rewards')
+      ) {
+        // Serve the page with Cache-Control: no-store so back/forward navigation does not reuse an already-consumed nonce
+        res.setHeader('Cache-Control', 'no-store');
+        const html = await renderHtmlPage(session);
+        res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+        res.end(html);
+        return;
+      }
+
+      if (req.method === 'GET' && url.pathname === '/email-verification.js') {
+        const js = await fs.readFile(path.join(__dirname, 'email-verification.js'), 'utf8');
+        res.writeHead(200, { 'Content-Type': 'application/javascript; charset=utf-8' });
+        res.end(js);
+        return;
+      }
+
+      res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Not Found');
+    } catch (err) {
+      console.error('Server error:', err);
+      res.writeHead(500, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(JSON.stringify({ error: 'Internal server error' }));
+    }
+  });
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === path.resolve(fileURLToPath(import.meta.url))) {
+  const server = createAppServer();
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
diff --git a/test/email-verification.test.js b/test/email-verification.test.js
new file mode 100644
index 0000000..ff3f76b
--- /dev/null
+++ b/test/email-verification.test.js
@@ -0,0 +1,260 @@
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import test from 'node:test';
+import { exportJWK, generateKeyPair, SignJWT } from 'jose';
+import {
+  generateVerificationNonce,
+  verifyEmailVerificationToken,
+} from '../email-verification.js';
+import {
+  consumeSessionNonce,
+  handleVerificationSubmission,
+  issueFormNonces,
+} from '../server.js';
+
+async function buildMockEvtPresentation({
+  email = 'User@Example.com',
+  emailVerified = true,
+  iss = 'https://issuer.example.com',
+  aud = 'https://rp.example.com',
+  nonce = 'test-nonce-1234567890',
+  alg = 'EdDSA',
+  omitKid = false,
+}) {
+  const issuerKeys = await generateKeyPair('EdDSA', { crv: 'Ed25519', extractable: true });
+  const holderKeys = await generateKeyPair('EdDSA', { crv: 'Ed25519', extractable: true });
+
+  const issuerPublicJwk = await exportJWK(issuerKeys.publicKey);
+  issuerPublicJwk.alg = alg;
+  if (!omitKid) {
+    issuerPublicJwk.kid = 'issuer-key-1';
+  }
+
+  const holderPublicJwk = await exportJWK(holderKeys.publicKey);
+  holderPublicJwk.alg = alg;
+
+  const evtHeader = {
+    alg,
+    typ: 'ev+sd-jwt',
+    ...(omitKid ? {} : { kid: 'issuer-key-1' }),
+  };
+
+  const evtJwt = await new SignJWT({
+    iss,
+    email,
+    email_verified: emailVerified,
+    _sd_alg: 'sha-256',
+    cnf: {
+      jwk: holderPublicJwk,
+    },
+  })
+    .setProtectedHeader(evtHeader)
+    .setIssuedAt()
+    .setExpirationTime('5m')
+    .sign(issuerKeys.privateKey);
+
+  // SD-JWT without disclosures ends with `~` before the KB-JWT
+  const sdJwtWithoutKb = `${evtJwt}~`;
+  const sdHash = createHash('sha256').update(sdJwtWithoutKb).digest('base64url');
+
+  const kbJwt = await new SignJWT({
+    nonce,
+    aud,
+    sd_hash: sdHash,
+  })
+    .setProtectedHeader({ alg, typ: 'kb+jwt' })
+    .setIssuedAt()
+    .sign(holderKeys.privateKey);
+
+  return {
+    rawToken: `${sdJwtWithoutKb}${kbJwt}`,
+    issuerPublicKey: issuerKeys.publicKey,
+    issuerPublicJwk,
+  };
+}
+
+test('verifies a valid EVT + KB-JWT presentation and performs case-insensitive email comparison', async () => {
+  const nonce = generateVerificationNonce();
+  const { rawToken, issuerPublicKey } = await buildMockEvtPresentation({
+    email: 'CoffeeLover@Example.com',
+    nonce,
+    aud: 'https://rp.example.com',
+  });
+
+  const verified = await verifyEmailVerificationToken({
+    rawToken,
+    submittedEmail: 'coffeelover@example.com',
+    expectedNonce: nonce,
+    expectedAudience: 'https://rp.example.com',
+    resolveTxt: async (hostname) => {
+      assert.equal(hostname, '_email-verification.example.com');
+      return [['iss=issuer.example.com']];
+    },
+    fetchImpl: async (url) => {
+      assert.equal(String(url), 'https://issuer.example.com/.well-known/email-verification');
+      return {
+        ok: true,
+        json: async () => ({
+          issuer: 'https://issuer.example.com',
+          jwks_uri: 'https://issuer.example.com/.well-known/jwks.json',
+        }),
+      };
+    },
+    createRemoteJWKSetImpl: () => issuerPublicKey,
+  });
+
+  assert.equal(verified.payload.email, 'CoffeeLover@Example.com');
+  assert.equal(verified.payload.email_verified, true);
+});
+
+test('supports trial-verifying multiple JWKS keys when kid is omitted (e.g. Gmail)', async () => {
+  const nonce = generateVerificationNonce();
+  const wrongKeyPair = await generateKeyPair('EdDSA', { crv: 'Ed25519' });
+  const { rawToken, issuerPublicKey } = await buildMockEvtPresentation({
+    email: 'user@gmail.example.com',
+    iss: 'https://accounts.google.example.com',
+    nonce,
+    aud: 'https://rp.example.com',
+    omitKid: true,
+  });
+
+  // Simulate ERR_JWKS_MULTIPLE_MATCHING_KEYS async iterable thrown by jose when kid is absent
+  const multiKeyResolver = async () => {
+    const err = new Error('Multiple matching keys found in the JSON Web Key Set');
+    err.code = 'ERR_JWKS_MULTIPLE_MATCHING_KEYS';
+    err[Symbol.asyncIterator] = async function* () {
+      yield wrongKeyPair.publicKey;
+      yield issuerPublicKey;
+    };
+    throw err;
+  };
+
+  const verified = await verifyEmailVerificationToken({
+    rawToken,
+    submittedEmail: 'user@gmail.example.com',
+    expectedNonce: nonce,
+    expectedAudience: 'https://rp.example.com',
+    resolveTxt: async () => [['iss=accounts.google.example.com']],
+    fetchImpl: async () => ({
+      ok: true,
+      json: async () => ({
+        issuer: 'https://accounts.google.example.com',
+        jwks_uri: 'https://accounts.google.example.com/oauth2/v3/certs',
+      }),
+    }),
+    createRemoteJWKSetImpl: () => multiKeyResolver,
+  });
+
+  assert.equal(verified.payload.email_verified, true);
+});
+
+test('rejects when DNS TXT delegation does not match the EVT issuer', async () => {
+  const nonce = generateVerificationNonce();
+  const { rawToken, issuerPublicKey } = await buildMockEvtPresentation({
+    email: 'user@example.com',
+    iss: 'https://evil-issuer.example.com',
+    nonce,
+  });
+
+  await assert.rejects(
+    () =>
+      verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail: 'user@example.com',
+        expectedNonce: nonce,
+        expectedAudience: 'https://rp.example.com',
+        resolveTxt: async () => [['iss=legit-issuer.example.com']],
+        createRemoteJWKSetImpl: () => issuerPublicKey,
+      }),
+    /not delegated via DNS/
+  );
+});
+
+test('consumes nonce atomically once and falls back gracefully when token is empty or replayed', async () => {
+  const session = { id: 'sess-1', nonces: {} };
+  const { signupNonce } = issueFormNonces(session);
+  const { rawToken, issuerPublicKey } = await buildMockEvtPresentation({
+    email: 'member@example.com',
+    nonce: signupNonce,
+    aud: 'https://rp.example.com',
+  });
+
+  const verifyOptions = {
+    resolveTxt: async () => [['iss=issuer.example.com']],
+    fetchImpl: async () => ({
+      ok: true,
+      json: async () => ({
+        issuer: 'https://issuer.example.com',
+        jwks_uri: 'https://issuer.example.com/.well-known/jwks.json',
+      }),
+    }),
+    createRemoteJWKSetImpl: () => issuerPublicKey,
+  };
+
+  // First submission succeeds on the EVP fast path
+  const firstResult = await handleVerificationSubmission({
+    submittedEmail: 'member@example.com',
+    rawToken,
+    flow: 'signup',
+    session,
+    expectedAudience: 'https://rp.example.com',
+    verifyOptions,
+  });
+  assert.equal(firstResult.verified, true);
+  assert.equal(firstResult.method, 'evp-fast-path');
+
+  // Replaying the exact same token with the same session falls back to OTP because the nonce was consumed
+  const replayResult = await handleVerificationSubmission({
+    submittedEmail: 'member@example.com',
+    rawToken,
+    flow: 'signup',
+    session,
+    expectedAudience: 'https://rp.example.com',
+    verifyOptions,
+  });
+  assert.equal(replayResult.verified, false);
+  assert.equal(replayResult.method, 'otp-fallback');
+  assert.equal(consumeSessionNonce(session, 'signup'), undefined);
+});
+
+test('serves HTML form with Origin-Trial, Cache-Control: no-store, HttpOnly SameSite=Lax cookie, and fresh nonces', async () => {
+  const { createAppServer } = await import('../server.js');
+  const server = createAppServer({ expectedAudience: 'https://rp.example.com' });
+  await new Promise((resolve) => server.listen(0, resolve));
+  const { port } = server.address();
+
+  try {
+    const res = await fetch(`http://localhost:${port}/`);
+    assert.equal(res.status, 200);
+    assert.equal(res.headers.get('cache-control'), 'no-store');
+    assert.ok(res.headers.get('origin-trial'));
+    const setCookie = res.headers.get('set-cookie') || '';
+    assert.match(setCookie, /HttpOnly/);
+    assert.match(setCookie, /SameSite=Lax/);
+
+    const html = await res.text();
+    assert.match(html, /autocomplete="email-verification-token"/);
+    assert.match(html, /autocomplete="email"/);
+    assert.doesNotMatch(html, /__SIGNUP_NONCE__/);
+
+    // Fallback when posting with empty token
+    const cookiePair = setCookie.split(';')[0];
+    const postRes = await fetch(`http://localhost:${port}/api/verify-email`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/x-www-form-urlencoded',
+        'Accept': 'application/json',
+        'Cookie': cookiePair,
+      },
+      body: new URLSearchParams({ email: 'guest@example.com', token: '', flow: 'signin' }),
+    });
+    assert.equal(postRes.status, 200);
+    const body = await postRes.json();
+    assert.equal(body.verified, false);
+    assert.equal(body.method, 'otp-fallback');
+    assert.equal(body.flow, 'signin');
+  } finally {
+    server.close();
+  }
+});
+
