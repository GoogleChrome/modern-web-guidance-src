index 0000000..2e72ad7
--- /dev/null
+++ b/email-verification.js
@@ -0,0 +1,156 @@
+import { createHash, randomBytes } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// Allow 'EdDSA' alongside 'Ed25519' and 'ES256' while live issuers (e.g. Gmail) and Chrome Origin Trial
+// builds transition from 'EdDSA' (with crv: 'Ed25519') to 'Ed25519'.
+export const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+export const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+export const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+/**
+ * Generates a cryptographically random single-use nonce with at least 128 bits (256 bits / 32 bytes) of entropy.
+ */
+export function generateVerificationNonce() {
+  return randomBytes(32).toString('base64url');
+}
+
+/**
+ * Verifies an Email Verification Token (EVT + KB-JWT SD-JWT presentation) per the
+ * Email Verification Protocol (EVP).
+ *
+ * @param {object} options
+ * @param {string} options.rawToken - The raw SD-JWT presentation submitted via the hidden `token` input.
+ * @param {string} options.submittedEmail - The email address submitted via the form's `email` input.
+ * @param {string} options.expectedNonce - The single-use nonce consumed from server-side session storage.
+ * @param {string} options.expectedAudience - The relying party's public origin (e.g. `https://rp.example.com`).
+ * @param {typeof dns.resolveTxt} [options.resolveTxt] - Optional DNS TXT resolver override for testing.
+ * @param {typeof fetch} [options.fetchImpl] - Optional fetch implementation override for testing.
+ * @param {typeof createRemoteJWKSet} [options.createRemoteJWKSetImpl] - Optional JWKS loader override for testing.
+ */
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience,
+  resolveTxt = dns.resolveTxt,
+  fetchImpl = globalThis.fetch,
+  createRemoteJWKSetImpl = createRemoteJWKSet,
+}) {
+  // Step 1: Parse the SD-JWT claims and validate the email address
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt?.payload;
+  const iss = evtPayload?.iss;
+
+  if (!expectedNonce || !decoded.kbJwt || !iss || evtPayload.email_verified !== true) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+
+  // MANDATORY: Compare email addresses case-insensitively
+  if (evtPayload.email?.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation and load the issuer JWKS
+  const domain = submittedEmail.split('@')[1];
+  if (!domain) {
+    throw new Error('Invalid email domain.');
+  }
+
+  const txtRecords = (await resolveTxt(`_email-verification.${domain}`)).map((r) =>
+    Array.isArray(r) ? r.join('') : String(r)
+  );
+  if (
+    !txtRecords.some(
+      (txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss
+    )
+  ) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') {
+    throw new Error('Issuer must use HTTPS.');
+  }
+
+  const metadataResponse = await fetchImpl(discoveryUrl);
+  if (!metadataResponse.ok) {
+    throw new Error(`Failed to fetch issuer metadata: ${metadataResponse.status}`);
+  }
+  const metadata = await metadataResponse.json();
+  if (metadata.issuer !== iss || !metadata.jwks_uri?.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+
+  const issuerJwks = createRemoteJWKSetImpl(new URL(metadata.jwks_uri));
+
+  // Step 3: Verify the EVT signature and Key Binding JWT (KB-JWT)
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws JWKSMultipleMatchingKeys, which yields each matching CryptoKey.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, normalizeAlg(kbAlg));
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg, normalizeAlg(kbAlg)],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  return verified;
+}
