+            }
+            if (signinTokenInput && result.nonces.signinNonce) {
+              signinTokenInput.setAttribute('nonce', result.nonces.signinNonce);
+              signinTokenInput.value = '';
+            }
+            if (recoveryTokenInput && result.nonces.recoveryNonce) {
+              recoveryTokenInput.setAttribute('nonce', result.nonces.recoveryNonce);
+              recoveryTokenInput.value = '';
+            }
+          }
+        } catch {
+          // If fetch fails, fall back to standard form submission
+          form.submit();
+        } finally {
+          if (submitButton) submitButton.disabled = false;
+        }
+      });
+    }
+  </script>
 </body>
 
 </html>
