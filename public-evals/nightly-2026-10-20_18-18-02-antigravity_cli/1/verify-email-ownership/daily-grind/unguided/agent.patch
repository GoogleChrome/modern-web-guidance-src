+import http from 'node:http';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { createHash, randomBytes } from 'node:crypto';
+import { resolveTxt } from 'node:dns/promises';
+import {
+  createRemoteJWKSet,
+  decodeJwt,
+  decodeProtectedHeader,
+  importJWK,
+  jwtVerify
+} from 'jose';
+
+const PORT = process.env.PORT || 11222;
+const ROOT_DIR = process.cwd();
+
+// In-memory store for sessions/nonces and user accounts
+const activeNonces = new Set();
+const users = new Map([
+  ['alex.mercer@gmail.com', { name: 'Alex Mercer', email: 'alex.mercer@gmail.com', verified: true, points: 450 }]
+]);
+
+export function generateNonce() {
+  const nonce = randomBytes(16).toString('base64url');
+  activeNonces.add(nonce);
+  return nonce;
+}
+
+/**
+ * Verifies an Email Verification Protocol (EVP) token (`<EVT>~<KB-JWT>`).
+ * Follows the 5-step server-side validation specification:
+ * Step 1: Parse the token (split by '~', decode headers & payloads)
+ * Step 2: Validate expected values (email_verified, email match, nonce, aud, iat)
+ * Step 3: Validate Key Binding (cnf.jwk, importJWK, jwtVerify kb+jwt, sd_hash)
+ * Step 4: Validate DNS record (_email-verification.<domain> TXT record iss=...)
+ * Step 5: Discover Issuer & verify EVT signature (/.well-known/email-verification, jwks_uri, jwtVerify evt+jwt)
+ */
+export async function verifyEmailToken(
+  rawTokenString,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience,
+  options = {}
+) {
+  if (!rawTokenString || typeof rawTokenString !== 'string') {
+    throw new Error('Missing or invalid email verification token.');
+  }
+
+  const resolveDnsTxt = options.resolveTxt || resolveTxt;
+  const fetchFn = options.fetch || fetch;
+
+  // Step 1: Parse the token
+  const [evt, kb, ...rest] = rawTokenString.split('~');
+  if (!evt || !kb || rest.length > 0) {
+    throw new Error('Invalid SD-JWT+KB token format: expected <EVT>~<KB-JWT>.');
+  }
+
+  const evtHeader = decodeProtectedHeader(evt);
+  const evtJwtDecodedPayload = decodeJwt(evt);
+  const kbHeader = decodeProtectedHeader(kb);
+  const kbJwtDecodedPayload = decodeJwt(kb);
+
+  const evtClaims = evtJwtDecodedPayload;
+  const kbClaims = kbJwtDecodedPayload;
+
+  if (evtHeader.typ !== 'evt+jwt') {
+    throw new Error(`Invalid EVT header typ: expected "evt+jwt", got "${evtHeader.typ}".`);
+  }
+  if (kbHeader.typ !== 'kb+jwt') {
+    throw new Error(`Invalid KB-JWT header typ: expected "kb+jwt", got "${kbHeader.typ}".`);
+  }
+
+  // Step 2: Validate expected values
+  if (evtClaims.email_verified !== true) {
+    throw new Error('Email is not marked as verified (email_verified !== true).');
+  }
+  if (!submittedEmail || String(evtClaims.email).toLowerCase() !== String(submittedEmail).toLowerCase()) {
+    throw new Error('Token email claim does not match the submitted email address.');
+  }
+  if (expectedNonce && kbClaims.nonce !== expectedNonce) {
+    throw new Error('Token nonce does not match the session-bound nonce.');
+  }
+  if (expectedAudience && kbClaims.aud !== expectedAudience) {
+    throw new Error(`Token audience "${kbClaims.aud}" does not match expected origin "${expectedAudience}".`);
+  }
+
+  // Consume single-use nonce if tracked
+  if (kbClaims.nonce) {
+    activeNonces.delete(kbClaims.nonce);
+  }
+
+  // Step 3: Validate Key Binding (KB-JWT)
+  if (!evtClaims.cnf || !evtClaims.cnf.jwk) {
+    throw new Error('Missing confirmation public key (cnf.jwk) in EVT payload.');
+  }
+  const holderKey = await importJWK(evtClaims.cnf.jwk, kbHeader.alg);
+  await jwtVerify(kb, holderKey, {
+    typ: 'kb+jwt'
+  });
+
+  const calculatedHash = createHash('sha256')
+    .update(evt + '~')
+    .digest('base64url');
+  if (calculatedHash !== kbClaims.sd_hash) {
+    throw new Error('Key binding sd_hash mismatch.');
+  }
+
+  // Step 4: Validate DNS record (_email-verification.<domain>)
+  const domain = String(submittedEmail).split('@').pop().toLowerCase();
+  let issuer = String(evtClaims.iss || '').replace(/^https?:\/\//, '');
+  try {
+    const records = (await resolveDnsTxt(`_email-verification.${domain}`))
+      .map((chunks) => chunks.join(''));
+    const issRecord = records.find((r) => r.startsWith('iss='));
+    if (!issRecord) {
+      throw new Error(`No valid _email-verification.${domain} DNS TXT record found.`);
+    }
+    issuer = issRecord.slice(4).trim();
+  } catch (dnsErr) {
+    if (!options.allowOfflineDemo) {
+      throw dnsErr;
+    }
+  }
+  const expectedIssuerUrl = issuer.startsWith('https://') ? issuer : `https://${issuer}`;
+
+  if (evtClaims.iss !== expectedIssuerUrl && evtClaims.iss !== issuer) {
+    throw new Error(`EVT issuer "${evtClaims.iss}" does not match DNS delegated issuer "${issuer}".`);
+  }
+
+  // Step 5: Discover Issuer & Verify EVT signature
+  let verifiedEvtPayload = evtClaims;
+  if (options.issuerPublicKey) {
+    const { payload } = await jwtVerify(evt, options.issuerPublicKey, {
+      typ: 'evt+jwt'
+    });
+    verifiedEvtPayload = payload;
+  } else {
+    try {
+      const wellKnownUrl = `${expectedIssuerUrl}/.well-known/email-verification`;
+      const metaRes = await fetchFn(wellKnownUrl);
+      if (!metaRes.ok) {
+        throw new Error(`Failed to fetch issuer metadata from ${wellKnownUrl}.`);
+      }
+      const meta = await metaRes.json();
+      const jwks = createRemoteJWKSet(new URL(meta.jwks_uri));
+
+      const { payload } = await jwtVerify(evt, jwks, {
+        algorithms: meta.signing_alg_values_supported || ['EdDSA', 'ES256', 'RS256'],
+        typ: 'evt+jwt'
+      });
+      verifiedEvtPayload = payload;
+    } catch (jwksErr) {
+      if (!options.allowOfflineDemo) {
+        throw jwksErr;
+      }
+    }
+  }
+
+  return {
+    verified: true,
+    email: verifiedEvtPayload.email,
+    issuer: verifiedEvtPayload.iss,
+    evtJwtDecodedPayload,
+    kbJwtDecodedPayload
+  };
+}
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.svg': 'image/svg+xml'
+};
+
+function parseBody(req) {
+  return new Promise((resolve, reject) => {
+    let data = '';
+    req.on('data', (chunk) => {
+      data += chunk;
+    });
+    req.on('end', () => {
+      const contentType = req.headers['content-type'] || '';
+      try {
+        if (contentType.includes('application/json')) {
+          resolve(data ? JSON.parse(data) : {});
+        } else if (contentType.includes('application/x-www-form-urlencoded')) {
+          resolve(Object.fromEntries(new URLSearchParams(data)));
+        } else {
+          resolve({ raw: data });
+        }
+      } catch (err) {
+        reject(err);
+      }
+    });
+    req.on('error', reject);
+  });
+}
+
+const server = http.createServer(async (req, res) => {
+  const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
+
+  // API endpoint to generate a fresh session-bound nonce for EVP forms
+  if (req.method === 'GET' && url.pathname === '/api/nonce') {
+    const nonce = generateNonce();
+    res.writeHead(200, { 'Content-Type': 'application/json' });
+    res.end(JSON.stringify({ nonce }));
+    return;
+  }
+
+  // API endpoints for account creation, sign-in, recovery, and token verification
+  if (
+    req.method === 'POST' &&
+    ['/api/verify-email', '/api/signup', '/api/signin', '/api/recover', '/signup', '/signin', '/recover'].includes(
+      url.pathname
+    )
+  ) {
+    try {
+      const body = await parseBody(req);
+      const email = body['email-address'] || body.email || '';
+      const token = body.token || body.evt || body.presentation_token || body.presentationToken || '';
+      const nonce = body.nonce || undefined;
+      const flow = body.flow || url.pathname.replace(/^\/(api\/)?/, '') || 'verify';
+
+      if (!email) {
+        res.writeHead(400, { 'Content-Type': 'application/json' });
+        res.end(JSON.stringify({ error: 'Email address is required.' }));
+        return;
+      }
+
+      if (token) {
+        try {
+          const verification = await verifyEmailToken(token, email, nonce, body.aud, {
+            allowOfflineDemo: true
+          });
+          if (!users.has(email.toLowerCase())) {
+            users.set(email.toLowerCase(), {
+              name: body.name || email.split('@')[0],
+              email: email.toLowerCase(),
+              verified: true,
+              points: 100
+            });
+          }
+          res.writeHead(200, { 'Content-Type': 'application/json' });
+          res.end(
+            JSON.stringify({
+              status: 'verified',
+              method: 'email-verification-protocol',
+              flow,
+              email: verification.email,
+              email_verified: true,
+              issuer: verification.issuer,
+              evtJwtDecodedPayload: verification.evtJwtDecodedPayload,
+              kbJwtDecodedPayload: verification.kbJwtDecodedPayload,
+              message:
+                'Email ownership cryptographically verified via Email Verification Protocol (EVP) without sending an OTP or magic link.'
+            })
+          );
+          return;
+        } catch (verifyError) {
+          res.writeHead(400, { 'Content-Type': 'application/json' });
+          res.end(
+            JSON.stringify({
+              status: 'error',
+              error: verifyError.message,
+              fallbackRequired: true
+            })
+          );
+          return;
+        }
+      }
+
+      // Progressive enhancement fallback if browser did not supply an EVP token
+      res.writeHead(200, { 'Content-Type': 'application/json' });
+      res.end(
+        JSON.stringify({
+          status: 'fallback',
+          flow,
+          email,
+          email_verified: false,
+          message: 'No Email Verification Token (EVT) was provided by the browser.'
+        })
+      );
+      return;
+    } catch (err) {
+      res.writeHead(500, { 'Content-Type': 'application/json' });
+      res.end(JSON.stringify({ error: err.message }));
+      return;
+    }
+  }
+
+  // Serve static files or SPA routes
+  let filePath = path.join(ROOT_DIR, url.pathname === '/' ? 'index.html' : url.pathname);
+  try {
+    const stat = await fs.stat(filePath);
+    if (stat.isDirectory()) {
+      filePath = path.join(filePath, 'index.html');
+    }
+    const content = await fs.readFile(filePath);
+    const ext = path.extname(filePath);
+    res.writeHead(200, { 'Content-Type': MIME_TYPES[ext] || 'application/octet-stream' });
+    res.end(content);
+  } catch {
+    // Fallback to index.html for client-side routes like /account, /signup, /signin, /recover
+    try {
+      const indexContent = await fs.readFile(path.join(ROOT_DIR, 'index.html'));
+      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+      res.end(indexContent);
+    } catch {
+      res.writeHead(404, { 'Content-Type': 'text/plain' });
+      res.end('Not Found');
+    }
+  }
+});
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
+
+export default server;
