+  <script>
+    const beanList = document.getElementById('bean-list');
+    const addItemBtn = document.getElementById('add-item-btn');
+    const beanInput = document.getElementById('bean-input');
+
+    const customBeans = [
+      { name: 'Guatemala Antigua', desc: 'Medium-dark roast — velvety cocoa body with subtle smoky spice.' },
+      { name: 'Kenya AA', desc: 'Medium roast — vibrant berry acidity with a wine-like finish.' },
+      { name: 'Costa Rica Tarrazu', desc: 'Medium roast — crisp honey sweetness with bright green apple notes.' },
+      { name: 'Brazil Santos', desc: 'Light-medium roast — creamy hazelnut aroma and mild chocolate flavor.' },
+      { name: 'House Espresso Reserve', desc: 'Dark roast — syrupy crema with caramelized sugar and roasted almond.' }
+    ];
+
+    let itemCounter = 3;
+
+    function runWithViewTransition(updateCallback) {
+      if (!document.startViewTransition) {
+        updateCallback();
+        return;
+      }
+      document.startViewTransition(() => {
+        updateCallback();
+      });
+    }
+
+    function createBeanItem() {
+      itemCounter += 1;
+      const customName = beanInput ? beanInput.value.trim() : '';
+      const preset = customBeans[(itemCounter - 4) % customBeans.length];
+      const title = customName || `${preset.name} #${itemCounter}`;
+      const description = customName
+        ? 'Custom artisanal single-origin roast tailored to your taste.'
+        : preset.desc;
+
+      const li = document.createElement('li');
+      li.className = 'item';
+      li.id = `item-${itemCounter}`;
+      li.style.viewTransitionName = `item-${itemCounter}`;
+
+      const infoDiv = document.createElement('div');
+      infoDiv.className = 'item-info';
+
+      const h3 = document.createElement('h3');
+      h3.textContent = title;
+
+      const p = document.createElement('p');
+      p.textContent = description;
+
+      infoDiv.appendChild(h3);
+      infoDiv.appendChild(p);
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.className = 'remove-btn';
+      removeBtn.setAttribute('aria-label', `Remove ${title}`);
+      removeBtn.textContent = 'Remove';
+
+      li.appendChild(infoDiv);
+      li.appendChild(removeBtn);
+
+      if (beanInput) {
+        beanInput.value = '';
+      }
+
+      return li;
+    }
+
+    addItemBtn.addEventListener('click', () => {
+      const newItem = createBeanItem();
+      runWithViewTransition(() => {
+        beanList.appendChild(newItem);
+      });
+    });
+
+    beanList.addEventListener('click', (event) => {
+      const item = event.target.closest('.item');
+      if (!item) return;
+      runWithViewTransition(() => {
+        item.remove();
+      });
+    });
+  </script>
+
