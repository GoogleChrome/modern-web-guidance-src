+  <script>
+    const beanList = document.getElementById('bean-list');
+    const addItemBtn = document.getElementById('add-item-btn');
+    const customBeanInput = document.getElementById('custom-bean-input');
+
+    const customRoasts = [
+      { name: 'Guatemalan Antigua', notes: 'Medium-Dark Roast \u2022 Rich Chocolate & Spice' },
+      { name: 'Kenyan AA', notes: 'Light-Medium Roast \u2022 Bright Berry & Winey Acidity' },
+      { name: 'Costa Rican Tarrazu', notes: 'Medium Roast \u2022 Crisp Honey & Citrus' },
+      { name: 'Brazilian Santos', notes: 'Medium Roast \u2022 Smooth Hazelnut & Sweet Cocoa' },
+      { name: 'Jamaican Blue Mountain', notes: 'Medium Roast \u2022 Silky, Mild & Balanced' }
+    ];
+
+    let nextItemId = 4;
+
+    function runViewTransition(updateDOM) {
+      if (document.startViewTransition) {
+        document.startViewTransition(() => {
+          updateDOM();
+        });
+      } else {
+        updateDOM();
+      }
+    }
+
+    function createBeanItem(name, notes, transitionId) {
+      const li = document.createElement('li');
+      li.className = 'item';
+      li.style.viewTransitionName = `item-${transitionId}`;
+
+      const infoDiv = document.createElement('div');
+      infoDiv.className = 'item-info';
+
+      const nameSpan = document.createElement('span');
+      nameSpan.className = 'item-name';
+      nameSpan.textContent = name;
+
+      const notesSpan = document.createElement('span');
+      notesSpan.className = 'item-notes';
+      notesSpan.textContent = notes;
+
+      infoDiv.append(nameSpan, notesSpan);
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.className = 'remove-btn';
+      removeBtn.setAttribute('aria-label', `Remove ${name}`);
+      removeBtn.textContent = 'Remove';
+
+      li.append(infoDiv, removeBtn);
+      return li;
+    }
+
+    addItemBtn.addEventListener('click', () => {
+      const id = nextItemId++;
+      const customName = customBeanInput.value.trim();
+      const preset = customRoasts[(id - 4) % customRoasts.length];
+      const beanName = customName || `${preset.name} #${id}`;
+      const beanNotes = customName ? 'Custom House Selection \u2022 Freshly Roasted' : preset.notes;
+
+      const newItem = createBeanItem(beanName, beanNotes, id);
+      customBeanInput.value = '';
+
+      runViewTransition(() => {
+        beanList.appendChild(newItem);
+      });
+    });
+
+    beanList.addEventListener('click', (event) => {
+      const removeBtn = event.target.closest('.remove-btn');
+      if (!removeBtn) return;
+
+      const item = removeBtn.closest('.item');
+      if (!item) return;
+
+      runViewTransition(() => {
+        item.remove();
+      });
+    });
+  </script>
