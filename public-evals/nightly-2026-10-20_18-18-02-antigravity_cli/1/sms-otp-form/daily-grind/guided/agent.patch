+  <script>
+    const phoneForm = document.getElementById('phone-form');
+    const phoneInput = document.getElementById('phone-input');
+    const phoneError = document.getElementById('phone-error');
+    const sendCodeBtn = document.getElementById('send-code-btn');
+
+    const otpForm = document.getElementById('otp-form');
+    const otpInput = document.getElementById('otp-input');
+    const otpError = document.getElementById('otp-error');
+    const verifyCodeBtn = document.getElementById('verify-code-btn');
+    const resendCodeBtn = document.getElementById('resend-code-btn');
+
+    const statusBanner = document.getElementById('verification-status');
+    const smsPreview = document.getElementById('sms-payload-preview');
+
+    let otpAbortController = null;
+
+    function showStatus(message, type = 'info') {
+      if (!statusBanner) return;
+      statusBanner.textContent = message;
+      statusBanner.className = `status-banner visible ${type}`;
+    }
+
+    /**
+     * Formats an origin-bound SMS message so both WebOTP and Safari autofill
+     * can verify the host domain before suggesting or extracting the code.
+     */
+    function formatOriginBoundSms(code, hostDomain = window.location.hostname || 'example.com') {
+      const cleanDomain = hostDomain.replace(/^https?:\/\//, '').split('/')[0].split(':')[0] || 'example.com';
+      return `Your verification code is ${code}.\n\n@${cleanDomain} #${code}`;
+    }
+
+    function stopSmsOtpListener() {
+      if (otpAbortController) {
+        otpAbortController.abort();
+        otpAbortController = null;
+      }
+    }
+
+    async function startSmsOtpListener() {
+      // Feature-detect WebOTP support
+      if (!otpInput || !('OTPCredential' in window)) {
+        return;
+      }
+
+      // Cancel any previous pending WebOTP request (e.g., when re-sending an SMS code)
+      stopSmsOtpListener();
+      const ac = new AbortController();
+      otpAbortController = ac;
+
+      try {
+        const otp = await navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: ac.signal,
+        });
+
+        if (!otp) return;
+        otpInput.value = otp.code;
+
+        // Trigger standard form submission so submit event listeners and validation run
+        if (otpForm) {
+          otpForm.requestSubmit();
+        }
+      } catch (err) {
+        // Expected when aborted by manual submission, resend, unmount, or user dismissal
+        if (err && err.name === 'AbortError') {
+          return;
+        }
+        console.error('WebOTP verification error:', err);
+      }
+    }
+
+    // Accessible field validation helpers (validate on blur/submit, clear on input)
+    function validatePhoneField() {
+      phoneInput.setCustomValidity('');
+      if (!phoneInput.checkValidity()) {
+        const msg = phoneInput.validity.valueMissing
+          ? 'Please enter your phone number.'
+          : 'Please enter a valid phone number (7 to 20 digits).';
+        phoneInput.setCustomValidity(msg);
+        phoneError.textContent = `Error: ${msg}`;
+        phoneError.classList.add('visible');
+        phoneInput.setAttribute('aria-invalid', 'true');
+        return false;
+      }
+      phoneError.textContent = '';
+      phoneError.classList.remove('visible');
+      phoneInput.removeAttribute('aria-invalid');
+      return true;
+    }
+
+    function validateOtpField() {
+      otpInput.setCustomValidity('');
+      if (!otpInput.checkValidity()) {
+        const msg = otpInput.validity.valueMissing
+          ? 'Please enter the 6-digit verification code.'
+          : 'Please enter a valid 6-digit numeric code (e.g., 012345).';
+        otpInput.setCustomValidity(msg);
+        otpError.textContent = `Error: ${msg}`;
+        otpError.classList.add('visible');
+        otpInput.setAttribute('aria-invalid', 'true');
+        return false;
+      }
+      otpError.textContent = '';
+      otpError.classList.remove('visible');
+      otpInput.removeAttribute('aria-invalid');
+      return true;
+    }
+
+    phoneInput.addEventListener('input', () => {
+      phoneInput.setCustomValidity('');
+      phoneError.textContent = '';
+      phoneError.classList.remove('visible');
+      phoneInput.removeAttribute('aria-invalid');
+    });
+
+    phoneInput.addEventListener('blur', () => {
+      if (phoneInput.value.trim() !== '') {
+        validatePhoneField();
+      }
+    });
+
+    otpInput.addEventListener('input', () => {
+      otpInput.setCustomValidity('');
+      otpError.textContent = '';
+      otpError.classList.remove('visible');
+      otpInput.removeAttribute('aria-invalid');
+    });
+
+    otpInput.addEventListener('blur', () => {
+      if (otpInput.value.trim() !== '') {
+        validateOtpField();
+      }
+    });
+
+    phoneForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!validatePhoneField()) {
+        phoneInput.focus();
+        return;
+      }
+
+      sendCodeBtn.disabled = true;
+      const phoneValue = phoneInput.value.trim();
+      const sampleCode = '048291';
+      const formattedSms = formatOriginBoundSms(sampleCode);
+
+      showStatus(`Verification code sent via SMS to ${phoneValue}. Listening for automatic SMS code extraction...`, 'info');
+      if (smsPreview) {
+        smsPreview.hidden = false;
+        smsPreview.textContent = formattedSms;
+      }
+
+      // Restart the WebOTP listener for the newly requested SMS code and move focus to the OTP field
+      startSmsOtpListener();
+      otpInput.focus();
+      sendCodeBtn.disabled = false;
+    });
+
+    resendCodeBtn.addEventListener('click', () => {
+      // Abort previous pending WebOTP request and start a fresh listener for the re-sent SMS
+      startSmsOtpListener();
+      const sampleCode = '048291';
+      if (smsPreview) {
+        smsPreview.hidden = false;
+        smsPreview.textContent = formatOriginBoundSms(sampleCode);
+      }
+      showStatus('A new 6-digit verification code has been sent to your phone.', 'info');
+      otpInput.focus();
+    });
+
+    otpForm.addEventListener('submit', async (event) => {
+      // MANDATORY: Abort any in-flight WebOTP request when the form is submitted
+      stopSmsOtpListener();
+      event.preventDefault();
+
+      if (!validateOtpField()) {
+        otpInput.focus();
+        return;
+      }
+
+      verifyCodeBtn.disabled = true;
+      const formData = new FormData(otpForm);
+      const code = formData.get('otp');
+
+      showStatus(`Success! Phone number verified with one-time passcode ${code}.`, 'success');
+      verifyCodeBtn.disabled = false;
+    });
+
+    // Clean up any active WebOTP listener if the page unloads
+    window.addEventListener('pagehide', stopSmsOtpListener);
+
+    // Start listening when the OTP verification step becomes active
+    startSmsOtpListener();
+  </script>
+
 </body>
 
