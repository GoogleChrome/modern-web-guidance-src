@@ -0,0 +1,77 @@
+import type { APIRoute } from 'astro';
+
+function extractHostname(rawHost: string): string {
+  // Strip any scheme, port, or path so @domain contains only the host domain
+  const withoutScheme = rawHost.replace(/^https?:\/\//i, '');
+  const hostOnly = withoutScheme.split('/')[0].split(':')[0].trim();
+  return hostOnly || 'localhost';
+}
+
+export function formatOriginBoundSms(domain: string, otpCode: string, embeddedOrigin?: string): string {
+  const cleanDomain = extractHostname(domain);
+  const cleanCode = otpCode.trim();
+  const lastLine = embeddedOrigin
+    ? `@${cleanDomain} #${cleanCode} @${extractHostname(embeddedOrigin)}`
+    : `@${cleanDomain} #${cleanCode}`;
+
+  return `Your verification code is ${cleanCode}.\n\n${lastLine}`;
+}
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  try {
+    const contentType = request.headers.get('content-type') || '';
+    let phone = '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      phone = String(body.phone || '').trim();
+    } else {
+      const formData = await request.formData();
+      phone = String(formData.get('phone') || '').trim();
+    }
+
+    if (!phone) {
+      return new Response(
+        JSON.stringify({ error: 'Phone number is required.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    // Generate a 6-digit numeric OTP code (preserving leading zeros as string)
+    const otpCode = String(Math.floor(Math.random() * 1000000)).padStart(6, '0');
+    const domain = extractHostname(request.headers.get('host') || url.hostname || 'localhost');
+    const smsMessage = formatOriginBoundSms(domain, otpCode);
+
+    if (session) {
+      await session.set('pendingOtp', {
+        phone,
+        code: otpCode,
+        expiresAt: Date.now() + 10 * 60 * 1000,
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        phone,
+        domain,
+        smsPreview: smsMessage,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Failed to send verification code.' }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
diff --git a/src/pages/api/verify-otp.ts b/src/pages/api/verify-otp.ts
new file mode 100644
index 0000000..a0c5947
--- /dev/null
+++ b/src/pages/api/verify-otp.ts
@@ -0,0 +1,76 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const contentType = request.headers.get('content-type') || '';
+    let otp = '';
+    let phone = '';
+
+    if (contentType.includes('application/json')) {
+      const body = await request.json();
+      otp = String(body.otp || '').trim();
+      phone = String(body.phone || '').trim();
+    } else {
+      const formData = await request.formData();
+      otp = String(formData.get('otp') || '').trim();
+      phone = String(formData.get('phone') || '').trim();
+    }
+
+    if (!/^\d{6}$/.test(otp)) {
+      return new Response(
+        JSON.stringify({ error: 'Please enter a valid 6-digit verification code.' }),
+        {
+          status: 400,
+          headers: { 'Content-Type': 'application/json' },
+        }
+      );
+    }
+
+    const pendingOtp = await session?.get('pendingOtp');
+
+    if (pendingOtp) {
+      if (Date.now() > pendingOtp.expiresAt) {
+        return new Response(
+          JSON.stringify({ error: 'Verification code has expired. Please request a new code.' }),
+          {
+            status: 400,
+            headers: { 'Content-Type': 'application/json' },
+          }
+        );
+      }
+
+      if (pendingOtp.code !== otp) {
+        return new Response(
+          JSON.stringify({ error: 'Invalid verification code. Please check the SMS and try again.' }),
+          {
+            status: 400,
+            headers: { 'Content-Type': 'application/json' },
+          }
+        );
+      }
+
+      await session?.set('verifiedPhone', pendingOtp.phone || phone);
+      await session?.set('pendingOtp', undefined);
+    }
+
+    return new Response(
+      JSON.stringify({
+        success: true,
+        verified: true,
+        phone: pendingOtp?.phone || phone,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch {
+    return new Response(
+      JSON.stringify({ error: 'Failed to verify one-time passcode.' }),
+      {
+        status: 500,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+};
