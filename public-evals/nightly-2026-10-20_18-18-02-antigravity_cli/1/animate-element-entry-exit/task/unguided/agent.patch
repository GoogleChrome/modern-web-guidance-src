+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promos = [
+      {
+        title: 'Pastry Pairing',
+        description: 'Add a fresh-baked croissant to any medium or large coffee for just $2.',
+        link: '/menu'
+      },
+      {
+        title: 'Double Rewards Points',
+        description: 'Earn 2x beans on all whole-bean coffee bag purchases every Friday.',
+        link: '/rewards'
+      },
+      {
+        title: 'Afternoon Pick-Me-Up',
+        description: 'Enjoy 25% off all iced lattes and cold brews between 2 PM and 5 PM.',
+        link: '/order-online'
+      }
+    ];
+    let promoIndex = 0;
+
+    addBtn.addEventListener('click', () => {
+      const promo = promos[promoIndex % promos.length];
+      promoIndex++;
+
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <h3>${promo.title}</h3>
+        <p>${promo.description}</p>
+        <a href="${promo.link}" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.classList.add('removing');
+      let isRemoved = false;
+      const cleanup = () => {
+        if (isRemoved) return;
+        isRemoved = true;
+        lastCard.remove();
+      };
+
+      lastCard.addEventListener('transitionend', cleanup, { once: true });
+      setTimeout(cleanup, 350);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+    });
+  </script>
+
 </body>
 
