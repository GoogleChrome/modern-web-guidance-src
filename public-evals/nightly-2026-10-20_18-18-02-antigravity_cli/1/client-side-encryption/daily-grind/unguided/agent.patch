+        encapsulateTimeMs: +(performance.now() - startTime).toFixed(2),
+        capsuleSizeBytes: ephemeralClassical.publicKeyBytes.byteLength,
+        classicalCapsuleBytes: ephemeralClassical.publicKeyBytes.byteLength,
+        pqCiphertextBytes: 0
+      }
+    };
+  }
+
+  if (schemeId === 'RSA-OAEP-256') {
+    const randomEntropy = crypto.getRandomValues(new Uint8Array(32));
+    const rsaCiphertext = new Uint8Array(
+      await subtle.encrypt({ name: 'RSA-OAEP' }, publicKeyBundle.rsaPublicKey, randomEntropy)
+    );
+    const transcriptHash = new Uint8Array(
+      await subtle.digest('SHA-256', concatBytes(rsaCiphertext, publicKeyBundle.compositePublicKey))
+    );
+
+    const derived = await deriveSessionKeyHKDF({
+      ikmBytes: randomEntropy,
+      saltBytes: hkdfSalt,
+      protocolId: schemeId,
+      transcriptBytes: transcriptHash
+    });
+
+    return {
+      schemeId,
+      capsule: {
+        rsaCiphertext,
+        compositeCapsuleBytes: rsaCiphertext,
+        hkdfSalt
+      },
+      initiatorSecrets: {
+        classicalSharedSecretHex: bytesToHex(randomEntropy),
+        pqSharedSecretHex: null,
+        combinedIkmHex: bytesToHex(randomEntropy),
+        transcriptHashHex: bytesToHex(transcriptHash),
+        sessionAesKey: derived.aesKey,
+        sessionKeyHex: bytesToHex(derived.rawKeyBytes),
+        keyFingerprint: derived.keyFingerprint
+      },
+      metrics: {
+        encapsulateTimeMs: +(performance.now() - startTime).toFixed(2),
+        capsuleSizeBytes: rsaCiphertext.byteLength,
+        classicalCapsuleBytes: rsaCiphertext.byteLength,
+        pqCiphertextBytes: 0
+      }
+    };
+  }
+
+  throw new Error(`Unsupported schemeId: ${schemeId}`);
+}
+
+/**
+ * Step 3: Recipient decapsulates the capsule using its Private Key Bundle to recover
+ * the identical shared secret and derive the matching AES-256-GCM key.
+ */
+export async function decapsulateSharedSecret(recipientBundle, capsule) {
+  const subtle = crypto.subtle;
+  const startTime = performance.now();
+  const { schemeId, publicKeyBundle, privateKeyBundle, classicalCurve } = recipientBundle;
+
+  if (schemeId === 'X25519MLKEM768' || schemeId === 'SecP256r1MLKEM768') {
+    const ssClassical = await computeClassicalDHSharedSecret(
+      classicalCurve,
+      privateKeyBundle.classicalPrivateKey,
+      capsule.classicalEphemeralPublicKey
+    );
+    const pqDec = MLKEM768_FIPS203.decapsulate(privateKeyBundle.pqSecretKey, capsule.pqCiphertext);
+
+    const hybridIKM = concatBytes(ssClassical, pqDec.sharedSecret);
+    const transcriptHash = new Uint8Array(
+      await subtle.digest(
+        'SHA-256',
+        concatBytes(
+          capsule.classicalEphemeralPublicKey,
+          publicKeyBundle.classicalPublicKey,
+          capsule.pqCiphertext,
+          publicKeyBundle.pqPublicKey
+        )
+      )
+    );
+
+    const derived = await deriveSessionKeyHKDF({
+      ikmBytes: hybridIKM,
+      saltBytes: capsule.hkdfSalt,
+      protocolId: schemeId,
+      transcriptBytes: transcriptHash
+    });
+
+    return {
+      schemeId,
+      recipientSecrets: {
+        classicalSharedSecretHex: bytesToHex(ssClassical),
+        pqSharedSecretHex: bytesToHex(pqDec.sharedSecret),
+        combinedIkmHex: bytesToHex(hybridIKM),
+        transcriptHashHex: bytesToHex(transcriptHash),
+        sessionAesKey: derived.aesKey,
+        sessionKeyHex: bytesToHex(derived.rawKeyBytes),
+        keyFingerprint: derived.keyFingerprint,
+        implicitRejectionTriggered: pqDec.implicitRejectionTriggered
+      },
+      metrics: {
+        decapsulateTimeMs: +(performance.now() - startTime).toFixed(2)
+      }
+    };
+  }
+
+  if (schemeId === 'ML-KEM-768') {
+    const pqDec = MLKEM768_FIPS203.decapsulate(privateKeyBundle.pqSecretKey, capsule.pqCiphertext);
+    const transcriptHash = new Uint8Array(
+      await subtle.digest('SHA-256', concatBytes(capsule.pqCiphertext, publicKeyBundle.pqPublicKey))
+    );
+
+    const derived = await deriveSessionKeyHKDF({
+      ikmBytes: pqDec.sharedSecret,
+      saltBytes: capsule.hkdfSalt,
+      protocolId: schemeId,
+      transcriptBytes: transcriptHash
+    });
+
+    return {
+      schemeId,
+      recipientSecrets: {
+        classicalSharedSecretHex: null,
+        pqSharedSecretHex: bytesToHex(pqDec.sharedSecret),
+        combinedIkmHex: bytesToHex(pqDec.sharedSecret),
+        transcriptHashHex: bytesToHex(transcriptHash),
+        sessionAesKey: derived.aesKey,
+        sessionKeyHex: bytesToHex(derived.rawKeyBytes),
+        keyFingerprint: derived.keyFingerprint,
+        implicitRejectionTriggered: pqDec.implicitRejectionTriggered
+      },
+      metrics: {
+        decapsulateTimeMs: +(performance.now() - startTime).toFixed(2)
+      }
+    };
+  }
+
+  if (schemeId === 'X25519-ECDH') {
+    const ssClassical = await computeClassicalDHSharedSecret(
+      classicalCurve,
+      privateKeyBundle.classicalPrivateKey,
+      capsule.classicalEphemeralPublicKey
+    );
+    const transcriptHash = new Uint8Array(
+      await subtle.digest(
+        'SHA-256',
+        concatBytes(capsule.classicalEphemeralPublicKey, publicKeyBundle.classicalPublicKey)
+      )
+    );
+
+    const derived = await deriveSessionKeyHKDF({
+      ikmBytes: ssClassical,
+      saltBytes: capsule.hkdfSalt,
+      protocolId: schemeId,
+      transcriptBytes: transcriptHash
+    });
+
+    return {
+      schemeId,
+      recipientSecrets: {
+        classicalSharedSecretHex: bytesToHex(ssClassical),
+        pqSharedSecretHex: null,
+        combinedIkmHex: bytesToHex(ssClassical),
+        transcriptHashHex: bytesToHex(transcriptHash),
+        sessionAesKey: derived.aesKey,
+        sessionKeyHex: bytesToHex(derived.rawKeyBytes),
+        keyFingerprint: derived.keyFingerprint,
+        implicitRejectionTriggered: false
+      },
+      metrics: {
+        decapsulateTimeMs: +(performance.now() - startTime).toFixed(2)
+      }
+    };
+  }
+
+  if (schemeId === 'RSA-OAEP-256') {
+    const decEntropy = new Uint8Array(
+      await subtle.decrypt({ name: 'RSA-OAEP' }, privateKeyBundle.rsaPrivateKey, capsule.rsaCiphertext)
+    );
+    const transcriptHash = new Uint8Array(
+      await subtle.digest('SHA-256', concatBytes(capsule.rsaCiphertext, publicKeyBundle.compositePublicKey))
+    );
+
+    const derived = await deriveSessionKeyHKDF({
+      ikmBytes: decEntropy,
+      saltBytes: capsule.hkdfSalt,
+      protocolId: schemeId,
+      transcriptBytes: transcriptHash
+    });
