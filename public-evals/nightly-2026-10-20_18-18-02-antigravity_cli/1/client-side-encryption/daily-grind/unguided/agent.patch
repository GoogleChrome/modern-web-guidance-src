+/**
+ * Generates an X25519 keypair via WebCrypto, falling back to P-256 if the browser lacks X25519.
+ */
+async function generateClassicalDHKeyPair(preferX25519 = true) {
+  const subtle = crypto.subtle;
+  if (preferX25519) {
+    try {
+      const kp = await subtle.generateKey({ name: 'X25519' }, true, ['deriveBits']);
+      const pubRaw = new Uint8Array(await subtle.exportKey('raw', kp.publicKey));
+      return {
+        curve: 'X25519',
+        keyPair: kp,
+        publicKeyBytes: pubRaw
+      };
+    } catch (_) {
+      // Fallback to P-256 if X25519 isn't enabled in an older browser engine
+    }
+  }
+  const kp = await subtle.generateKey({ name: 'ECDH', namedCurve: 'P-256' }, true, ['deriveBits']);
+  const pubRaw = new Uint8Array(await subtle.exportKey('raw', kp.publicKey));
+  return {
+    curve: 'P-256',
+    keyPair: kp,
+    publicKeyBytes: pubRaw
+  };
+}
+
+async function computeClassicalDHSharedSecret(curve, privateKey, peerPublicKeyBytes) {
+  const subtle = crypto.subtle;
+  const alg = curve === 'X25519' ? { name: 'X25519' } : { name: 'ECDH', namedCurve: 'P-256' };
+  const peerKey = await subtle.importKey('raw', peerPublicKeyBytes, alg, false, []);
+  const bits = await subtle.deriveBits({ name: alg.name, public: peerKey }, privateKey, 256);
+  return new Uint8Array(bits);
+}
+
+/**
+ * Step 1: Recipient (e.g., Payment Gateway / Server or Peer B) generates keypair(s)
+ * and publishes public key bundle.
+ */
+export async function generateRecipientKeyBundle(schemeId = 'X25519MLKEM768') {
+  const subtle = crypto.subtle;
+  const startTime = performance.now();
+
+  if (schemeId === 'X25519MLKEM768' || schemeId === 'SecP256r1MLKEM768') {
+    const preferX25519 = schemeId === 'X25519MLKEM768';
+    const classical = await generateClassicalDHKeyPair(preferX25519);
+    const pq = MLKEM768_FIPS203.generateKeyPair();
+    const compositePub = concatBytes(classical.publicKeyBytes, pq.publicKey);
+    const pubDigest = new Uint8Array(await subtle.digest('SHA-256', compositePub));
