+    quantumResistance: 'NIST Level 3 Quantum-Safe + Classical ECDH Defense-in-Depth',
+    securityLevelBits: 192
+  },
+  HYBRID_P256_MLKEM768: {
+    id: 'SecP256r1MLKEM768',
+    label: 'Hybrid ECDH P-256 + ML-KEM-768 (NIST Post-Quantum Hybrid)',
+    category: 'Hybrid Post-Quantum KEM / Key Agreement',
+    standard: 'FIPS 203 (ML-KEM-768) + NIST SP 800-56A (P-256) + HKDF-SHA256',
+    quantumResistance: 'NIST Level 3 Quantum-Safe + FIPS Classical P-256',
