+      seed[32] = j;
+      seed[33] = i;
+      A[i][j] = sampleNTT(seed);
+    }
+  }
+
+  let N = 0;
+  const rVec = [];
+  for (let i = 0; i < MLKEM_K; i++) {
+    const prfIn = new Uint8Array(33);
+    prfIn.set(r32, 0);
+    prfIn[32] = N++;
+    rVec.push(ntt(samplePolyCBD2(shake256(prfIn, 128))));
+  }
+
+  const e1 = [];
+  for (let i = 0; i < MLKEM_K; i++) {
+    const prfIn = new Uint8Array(33);
+    prfIn.set(r32, 0);
+    prfIn[32] = N++;
+    e1.push(samplePolyCBD2(shake256(prfIn, 128)));
+  }
+
+  const prfInE2 = new Uint8Array(33);
+  prfInE2.set(r32, 0);
+  prfInE2[32] = N++;
+  const e2 = samplePolyCBD2(shake256(prfInE2, 128));
+
+  // u = NTT^-1(A^T * rVec) + e1
+  const c1Parts = [];
+  for (let i = 0; i < MLKEM_K; i++) {
+    let acc = new Int16Array(256);
+    for (let j = 0; j < MLKEM_K; j++) {
+      acc = polyAdd(acc, multiplyNTTs(A[j][i], rVec[j]));
+    }
+    const u_i = polyAdd(nttInv(acc), e1[i]);
+    c1Parts.push(compressAndEncode10(u_i));
+  }
+
+  // v = NTT^-1(tHat^T * rVec) + e2 + Decompress_1(m)
+  let vAcc = new Int16Array(256);
+  for (let i = 0; i < MLKEM_K; i++) {
+    vAcc = polyAdd(vAcc, multiplyNTTs(tHat[i], rVec[i]));
+  }
+  const mu = decodeAndDecompress1(m32);
+  const v = polyAdd(polyAdd(nttInv(vAcc), e2), mu);
+  const c2 = compressAndEncode4(v);
+
+  return concatBytes(...c1Parts, c2); // 3 * 320 + 128 = 1088 bytes
+}
+
+/** K-PKE.Decrypt (FIPS 203 Algorithm 15) */
+function kpkeDecrypt(dkPke, c1088) {
+  const uVec = [];
+  for (let i = 0; i < MLKEM_K; i++) {
+    uVec.push(decodeAndDecompress10(c1088.subarray(i * 320, (i + 1) * 320)));
+  }
+  const v = decodeAndDecompress4(c1088.subarray(960, 1088));
+
+  const sHat = [];
+  for (let i = 0; i < MLKEM_K; i++) {
+    sHat.push(byteDecode12(dkPke.subarray(i * 384, (i + 1) * 384)));
+  }
+
+  let acc = new Int16Array(256);
+  for (let i = 0; i < MLKEM_K; i++) {
+    acc = polyAdd(acc, multiplyNTTs(sHat[i], ntt(uVec[i])));
+  }
+  const w = polySub(v, nttInv(acc));
+  return compressAndEncode1(w);
+}
+
+/**
+ * Pure-JS FIPS 203 ML-KEM-768 Key Generation, Encapsulation, and Decapsulation.
+ */
+export const MLKEM768_FIPS203 = {
+  PUBLIC_KEY_BYTES: 1184,
+  SECRET_KEY_BYTES: 2400,
+  CIPHERTEXT_BYTES: 1088,
+  SHARED_SECRET_BYTES: 32,
+
+  generateKeyPair(seed64) {
+    const dAndZ = seed64 || crypto.getRandomValues(new Uint8Array(64));
+    const d = dAndZ.subarray(0, 32);
+    const z = dAndZ.subarray(32, 64);
+
+    // (rho, sigma) = G(d || k) where G = SHA3-512
+    const gIn = new Uint8Array(33);
+    gIn.set(d, 0);
+    gIn[32] = MLKEM_K;
+    const rhoSigma = sha3_512(gIn);
+    const rho = rhoSigma.subarray(0, 32);
+    const sigma = rhoSigma.subarray(32, 64);
+
+    const A = [];
+    for (let i = 0; i < MLKEM_K; i++) {
+      A[i] = [];
+      for (let j = 0; j < MLKEM_K; j++) {
+        const seed = new Uint8Array(34);
+        seed.set(rho, 0);
+        seed[32] = j;
+        seed[33] = i;
+        A[i][j] = sampleNTT(seed);
+      }
+    }
+
+    let N = 0;
+    const sHat = [];
+    for (let i = 0; i < MLKEM_K; i++) {
+      const prfIn = new Uint8Array(33);
+      prfIn.set(sigma, 0);
+      prfIn[32] = N++;
+      sHat.push(ntt(samplePolyCBD2(shake256(prfIn, 128))));
+    }
+
+    const eHat = [];
+    for (let i = 0; i < MLKEM_K; i++) {
+      const prfIn = new Uint8Array(33);
+      prfIn.set(sigma, 0);
+      prfIn[32] = N++;
+      eHat.push(ntt(samplePolyCBD2(shake256(prfIn, 128))));
+    }
+
+    const ekParts = [];
+    const dkParts = [];
+    for (let i = 0; i < MLKEM_K; i++) {
+      let t_i = new Int16Array(256);
+      for (let j = 0; j < MLKEM_K; j++) {
+        t_i = polyAdd(t_i, multiplyNTTs(A[i][j], sHat[j]));
+      }
+      t_i = polyAdd(t_i, eHat[i]);
+      ekParts.push(byteEncode12(t_i));
+      dkParts.push(byteEncode12(sHat[i]));
+    }
+
+    const ekPke = concatBytes(...ekParts, rho); // 1184 bytes
+    const dkPke = concatBytes(...dkParts); // 1152 bytes
+    const hEk = sha3_256(ekPke); // 32 bytes
+    const dk = concatBytes(dkPke, ekPke, hEk, z); // 2400 bytes
+
+    return { publicKey: ekPke, secretKey: dk };
+  },
+
+  encapsulate(publicKey, randomM32) {
+    if (publicKey.byteLength !== 1184) {
+      throw new Error(`Invalid ML-KEM-768 public key length: expected 1184, got ${publicKey.byteLength}`);
+    }
+    const m = randomM32 || crypto.getRandomValues(new Uint8Array(32));
+    const hEk = sha3_256(publicKey);
+    const kr = sha3_512(concatBytes(m, hEk));
+    const K = kr.subarray(0, 32);
+    const r = kr.subarray(32, 64);
+    const ciphertext = kpkeEncrypt(publicKey, m, r);
+    return {
+      ciphertext,
+      sharedSecret: new Uint8Array(K)
+    };
+  },
+
+  decapsulate(secretKey, ciphertext) {
+    if (secretKey.byteLength !== 2400) {
+      throw new Error(`Invalid ML-KEM-768 secret key length: expected 2400, got ${secretKey.byteLength}`);
+    }
+    if (ciphertext.byteLength !== 1088) {
+      throw new Error(`Invalid ML-KEM-768 ciphertext length: expected 1088, got ${ciphertext.byteLength}`);
+    }
+    const dkPke = secretKey.subarray(0, 1152);
+    const ekPke = secretKey.subarray(1152, 2336);
+    const h = secretKey.subarray(2336, 2368);
+    const z = secretKey.subarray(2368, 2400);
+
+    const mPrime = kpkeDecrypt(dkPke, ciphertext);
+    const krPrime = sha3_512(concatBytes(mPrime, h));
+    const kPrime = krPrime.subarray(0, 32);
+    const rPrime = krPrime.subarray(32, 64);
+
+    // Implicit rejection (FIPS 203 Algorithm 18): K_bar = J(z || c)
+    const kBar = shake256(concatBytes(z, ciphertext), 32);
+    const cPrime = kpkeEncrypt(ekPke, mPrime, rPrime);
+
+    const isMatch = constantTimeEqual(ciphertext, cPrime);
+    const sharedSecret = new Uint8Array(32);
+    const mask = isMatch ? 0xff : 0x00;
+    for (let i = 0; i < 32; i++) {
+      sharedSecret[i] = (kPrime[i] & mask) | (kBar[i] & ~mask);
+    }
+    return { sharedSecret, implicitRejectionTriggered: !isMatch };
+  }
+};
+
+// ============================================================================
+// SECTION 4: HKDF-SHA256 Key Derivation & Key Confirmation via WebCrypto
+// ============================================================================
+
+/**
+ * Derives a 256-bit AES-GCM CryptoKey and raw key material + confirmation fingerprint
+ * from input key material (IKM), salt, and structured protocol context info.
+ */
+export async function deriveSessionKeyHKDF({
+  ikmBytes,
+  saltBytes,
+  protocolId,
+  transcriptBytes = new Uint8Array(0)
+}) {
+  const subtle = crypto.subtle;
+  const salt = saltBytes && saltBytes.byteLength > 0 ? saltBytes : new Uint8Array(32);
+  const encoder = new TextEncoder();
+  const infoKey = concatBytes(
+    encoder.encode(`DailyGrind-KEM-v1|${protocolId}|AES-256-GCM|`),
+    transcriptBytes
+  );
+  const infoConfirm = concatBytes(
+    encoder.encode(`DailyGrind-KEM-v1|${protocolId}|KEY-CONFIRM|`),
+    transcriptBytes
+  );
+
+  const baseKey = await subtle.importKey('raw', ikmBytes, 'HKDF', false, ['deriveBits', 'deriveKey']);
+
+  const aesKey = await subtle.deriveKey(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt,
+      info: infoKey
+    },
+    baseKey,
+    { name: 'AES-GCM', length: 256 },
+    true,
+    ['encrypt', 'decrypt']
+  );
+
+  const rawKeyBuffer = await subtle.exportKey('raw', aesKey);
+  const confirmBits = await subtle.deriveBits(
+    {
+      name: 'HKDF',
+      hash: 'SHA-256',
+      salt,
+      info: infoConfirm
+    },
+    baseKey,
+    128
+  );
+
+  return {
+    aesKey,
+    rawKeyBytes: new Uint8Array(rawKeyBuffer),
+    keyFingerprint: bytesToHex(new Uint8Array(confirmBits)),
+    hkdfSaltHex: bytesToHex(salt)
+  };
+}
