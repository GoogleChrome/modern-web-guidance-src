+  const f = new Int16Array(poly);
+  let i = 1;
+  for (let len = 128; len >= 2; len >>= 1) {
+    for (let start = 0; start < 256; start += 2 * len) {
+      const zeta = MLKEM_ZETAS[i++];
+      for (let j = start; j < start + len; j++) {
+        const t = modQ(zeta * f[j + len]);
+        f[j + len] = modQ(f[j] - t);
+        f[j] = modQ(f[j] + t);
+      }
+    }
+  }
+  return f;
+}
+
+/** Inverse Number Theoretic Transform (FIPS 203 Algorithm 10) */
+function nttInv(poly) {
+  const f = new Int16Array(poly);
+  let i = 127;
+  for (let len = 2; len <= 128; len <<= 1) {
+    for (let start = 0; start < 256; start += 2 * len) {
+      const zeta = MLKEM_ZETAS[i--];
+      for (let j = start; j < start + len; j++) {
+        const t = f[j];
+        f[j] = modQ(t + f[j + len]);
+        f[j + len] = modQ(zeta * (f[j + len] - t));
+      }
+    }
+  }
+  // Multiply by 128^-1 mod 3329 = 3303
+  for (let j = 0; j < 256; j++) {
+    f[j] = modQ(f[j] * 3303);
+  }
+  return f;
