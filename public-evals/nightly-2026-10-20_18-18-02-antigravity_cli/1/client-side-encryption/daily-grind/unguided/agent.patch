+      schemeId,
+      schemeMeta: KEY_ESTABLISHMENT_SCHEMES.CLASSICAL_RSA_OAEP,
+      publicKeyBundle: {
+        rsaPublicKey: kp.publicKey,
+        compositePublicKey: spki,
+        fingerprint: bytesToHex(pubDigest.subarray(0, 16))
+      },
+      privateKeyBundle: {
+        rsaPrivateKey: kp.privateKey
+      },
+      metrics: {
+        keyGenTimeMs: +(performance.now() - startTime).toFixed(2),
+        publicKeySizeBytes: spki.byteLength,
+        classicalPubBytes: spki.byteLength,
+        pqPubBytes: 0
