+  const out = new Uint8Array(32);
+  for (let i = 0; i < 32; i++) {
+    let b = 0;
+    for (let bit = 0; bit < 8; bit++) {
+      const x = modQ(poly[8 * i + bit]);
+      const c = Math.round((x * 2) / MLKEM_Q) & 1;
