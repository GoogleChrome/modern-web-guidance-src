+// ============================================================================
+// SECTION 3: NIST FIPS 203 ML-KEM-768 Implementation
+// Parameters: n = 256, q = 3329, k = 3, eta1 = 2, eta2 = 2, du = 10, dv = 4
+// Public Key: 1184 bytes | Secret Key: 2400 bytes | Ciphertext: 1088 bytes | Shared Secret: 32 bytes
+// ============================================================================
+
+const MLKEM_Q = 3329;
+const MLKEM_N = 256;
+const MLKEM_K = 3;
+
