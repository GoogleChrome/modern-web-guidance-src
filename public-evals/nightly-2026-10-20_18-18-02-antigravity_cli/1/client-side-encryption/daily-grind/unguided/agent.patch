+const MLKEM_ZETAS = new Int16Array(128);
+{
+  function bitRev7(x) {
+    let r = 0;
+    for (let i = 0; i < 7; i++) {
+      r = (r << 1) | (x & 1);
+      x >>= 1;
+    }
+    return r;
+  }
+  let cur = 1;
+  const pows = new Int16Array(128);
+  for (let i = 0; i < 128; i++) {
+    pows[i] = cur;
+    cur = (cur * 17) % MLKEM_Q;
+  }
+  for (let i = 0; i < 128; i++) {
+    MLKEM_ZETAS[i] = pows[bitRev7(i)];
+  }
+}
+
+function modQ(x) {
+  const r = x % MLKEM_Q;
+  return r < 0 ? r + MLKEM_Q : r;
+}
+
