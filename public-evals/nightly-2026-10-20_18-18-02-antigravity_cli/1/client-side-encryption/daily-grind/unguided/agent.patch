+    const classical = await generateClassicalDHKeyPair(true);
+    const pubDigest = new Uint8Array(await subtle.digest('SHA-256', classical.publicKeyBytes));
+    return {
+      schemeId,
+      schemeMeta: KEY_ESTABLISHMENT_SCHEMES.CLASSICAL_X25519,
+      classicalCurve: classical.curve,
+      publicKeyBundle: {
+        classicalPublicKey: classical.publicKeyBytes,
+        compositePublicKey: classical.publicKeyBytes,
+        fingerprint: bytesToHex(pubDigest.subarray(0, 16))
+      },
+      privateKeyBundle: {
+        classicalPrivateKey: classical.keyPair.privateKey
+      },
+      metrics: {
+        keyGenTimeMs: +(performance.now() - startTime).toFixed(2),
+        publicKeySizeBytes: classical.publicKeyBytes.byteLength,
+        classicalPubBytes: classical.publicKeyBytes.byteLength,
+        pqPubBytes: 0
+      }
+    };
+  }
