+        pqSharedSecretHex: null,
+        combinedIkmHex: bytesToHex(decEntropy),
+        transcriptHashHex: bytesToHex(transcriptHash),
+        sessionAesKey: derived.aesKey,
+        sessionKeyHex: bytesToHex(derived.rawKeyBytes),
+        keyFingerprint: derived.keyFingerprint,
+        implicitRejectionTriggered: false
+      },
+      metrics: {
+        decapsulateTimeMs: +(performance.now() - startTime).toFixed(2)
+      }
+    };
+  }
+
+  throw new Error(`Unsupported schemeId: ${schemeId}`);
+}
+
+// ============================================================================
+// SECTION 6: Authenticated Encryption with Associated Data (AES-256-GCM AEAD)
+// ============================================================================
+
+/**
+ * Encrypts sensitive plaintext (string or object or Uint8Array) with AES-256-GCM,
+ * binding Additional Authenticated Data (AAD) to prevent context tampering or replay.
+ */
+export async function encryptSensitiveDataAEAD({
+  aesKey,
+  plaintext,
+  aadContext = '',
+  keyFingerprint = '',
+  schemeId = 'X25519MLKEM768'
+}) {
+  const subtle = crypto.subtle;
+  const encoder = new TextEncoder();
+
+  const plaintextBytes =
+    plaintext instanceof Uint8Array
+      ? plaintext
+      : typeof plaintext === 'string'
+      ? encoder.encode(plaintext)
+      : encoder.encode(JSON.stringify(plaintext));
+
+  // 96-bit (12-byte) cryptographically random IV/nonce per NIST SP 800-38D
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const aadString = typeof aadContext === 'string' ? aadContext : JSON.stringify(aadContext);
+  const aadBytes = encoder.encode(aadString);
+
+  const encryptedBuffer = await subtle.encrypt(
+    {
+      name: 'AES-GCM',
+      iv,
+      additionalData: aadBytes,
+      tagLength: 128
+    },
+    aesKey,
+    plaintextBytes
+  );
+
+  const encryptedBytes = new Uint8Array(encryptedBuffer);
+  // WebCrypto AES-GCM appends the 16-byte (128-bit) authentication tag at the end of the ciphertext
+  const ciphertextBody = encryptedBytes.subarray(0, encryptedBytes.length - 16);
+  const authTag = encryptedBytes.subarray(encryptedBytes.length - 16);
+
+  return {
+    version: 'AEAD-AES-256-GCM-v1',
+    schemeId,
+    keyFingerprint,
+    ivHex: bytesToHex(iv),
+    ivBase64: bytesToBase64(iv),
+    aad: aadString,
+    aadHex: bytesToHex(aadBytes),
+    ciphertextHex: bytesToHex(ciphertextBody),
+    authTagHex: bytesToHex(authTag),
+    combinedPayloadBase64: bytesToBase64(encryptedBytes),
+    byteLength: encryptedBytes.byteLength,
+    timestamp: new Date().toISOString()
+  };
+}
+
+/**
+ * Decrypts and authenticates an AES-256-GCM envelope.
+ * Throws a descriptive authentication error if the ciphertext, IV, key, or AAD was tampered with.
+ */
+export async function decryptSensitiveDataAEAD({
+  aesKey,
+  envelope,
+  overrideAad = undefined
+}) {
+  const subtle = crypto.subtle;
+  const encoder = new TextEncoder();
+  const decoder = new TextDecoder();
+
+  const iv = hexToBytes(envelope.ivHex);
+  const aadString = overrideAad !== undefined ? overrideAad : envelope.aad;
+  const aadBytes = encoder.encode(aadString);
+  const ciphertextBody = hexToBytes(envelope.ciphertextHex);
+  const authTag = hexToBytes(envelope.authTagHex);
+  const combined = concatBytes(ciphertextBody, authTag);
+
+  try {
+    const decryptedBuffer = await subtle.decrypt(
+      {
+        name: 'AES-GCM',
+        iv,
+        additionalData: aadBytes,
+        tagLength: 128
+      },
+      aesKey,
+      combined
+    );
+    const decryptedBytes = new Uint8Array(decryptedBuffer);
+    const text = decoder.decode(decryptedBytes);
+    let parsedJson = null;
+    try {
+      parsedJson = JSON.parse(text);
+    } catch (_) {
+      // Plain string
+    }
+    return {
+      authenticated: true,
+      plaintext: text,
+      parsedJson,
+      plaintextBytes: decryptedBytes
+    };
+  } catch (err) {
+    throw new Error(
+      `AEAD Authentication Failed (GCM Tag / AAD Verification Rejected): Ciphertext, authentication tag, or associated data was modified or key mismatch occurred.`
+    );
+  }
+}
