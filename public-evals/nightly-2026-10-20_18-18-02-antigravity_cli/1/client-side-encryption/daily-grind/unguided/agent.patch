+      state.decapsulationResult = decResult;
+
+      // Update Metadata Badges
+      badgeStandard.textContent = recipientBundle.schemeMeta.standard;
+      badgeQuantum.textContent = recipientBundle.schemeMeta.quantumResistance;
+      badgePubkeySize.textContent = `Public Key: ${recipientBundle.metrics.publicKeySizeBytes} B`;
+      badgeCapsuleSize.textContent = `KEM Capsule: ${encResult.metrics.capsuleSizeBytes} B`;
+      badgeTiming.textContent = `Handshake: ${totalMs} ms`;
+
+      // Update Step 1 UI
+      recipientCurveLabel.textContent = recipientBundle.schemeId;
+      recipientPubFp.textContent = recipientBundle.publicKeyBundle.fingerprint;
+      if (recipientBundle.metrics.classicalPubBytes > 0) {
+        classicalPubLen.textContent = `${recipientBundle.metrics.classicalPubBytes} bytes`;
+        recipientClassicalPub.textContent = bytesToHex(
+          recipientBundle.publicKeyBundle.classicalPublicKey ||
+            recipientBundle.publicKeyBundle.compositePublicKey
+        );
+      } else {
+        classicalPubLen.textContent = '0 bytes (Pure Post-Quantum)';
+        recipientClassicalPub.textContent = 'N/A — Pure Post-Quantum ML-KEM-768 Mode';
+      }
+
+      if (recipientBundle.metrics.pqPubBytes > 0) {
+        pqPubLen.textContent = `${recipientBundle.metrics.pqPubBytes} bytes`;
+        recipientPqPub.textContent = bytesToHex(recipientBundle.publicKeyBundle.pqPublicKey);
+      } else {
+        pqPubLen.textContent = '0 bytes (Classical Mode)';
+        recipientPqPub.textContent = 'N/A — Classical Key Establishment Mode';
+      }
+
+      // Update Step 2 UI
+      initiatorSsClassical.textContent =
+        encResult.initiatorSecrets.classicalSharedSecretHex || 'N/A (Pure Post-Quantum)';
+      initiatorSsPq.textContent =
+        encResult.initiatorSecrets.pqSharedSecretHex || 'N/A (Classical Only)';
+      capsuleBytesLabel.textContent = `${encResult.metrics.capsuleSizeBytes} bytes`;
+      initiatorCapsuleHex.textContent = bytesToHex(encResult.capsule.compositeCapsuleBytes);
+
+      // Update Step 3 UI
+      transcriptHashBox.textContent = encResult.initiatorSecrets.transcriptHashHex;
+      sessionKeyFp.textContent = `Confirm: ${encResult.initiatorSecrets.keyFingerprint}`;
+      derivedSessionKeyBox.textContent = encResult.initiatorSecrets.sessionKeyHex;
+
+      const keysMatch =
+        encResult.initiatorSecrets.sessionKeyHex === decResult.recipientSecrets.sessionKeyHex;
+      if (keysMatch) {
+        keyAgreementBanner.classList.remove('mismatch');
+        keyMatchStatusText.textContent = `Shared Secrets Match! Initiator & Recipient derived identical 256-bit AES-GCM key (Confirm: ${encResult.initiatorSecrets.keyFingerprint.slice(0, 12)}...)`;
+      } else {
+        keyAgreementBanner.classList.add('mismatch');
+        keyMatchStatusText.textContent = `Key Mismatch (Implicit Rejection Active)`;
+      }
+
+      statusText.textContent = `${schemeId} Active (${totalMs} ms)`;
+
+      await performEncryption();
+    }
+
+    async function performEncryption() {
+      const payload = buildPlaintextPayload();
+      const aadContext = inputAadContext.value;
+      const { sessionAesKey, keyFingerprint } = state.encapsulationResult.initiatorSecrets;
+
+      const envelope = await encryptSensitiveDataAEAD({
+        aesKey: sessionAesKey,
+        plaintext: payload,
+        aadContext,
+        keyFingerprint,
+        schemeId: state.currentScheme
+      });
+
+      state.latestValidEnvelope = structuredClone(envelope);
+      populateEnvelopeEditor(envelope);
+      await verifyCurrentEnvelope();
+    }
+
+    function populateEnvelopeEditor(envelope) {
+      envelopeIv.value = envelope.ivHex;
+      envelopeTag.value = envelope.authTagHex;
+      envelopeCiphertext.value = envelope.ciphertextHex;
+      envelopeAadVerify.value = envelope.aad;
+      ciphertextByteCount.textContent = `${envelope.ciphertextHex.length / 2} bytes (+ 16B GCM Tag)`;
+    }
+
+    async function verifyCurrentEnvelope() {
+      const editedEnvelope = {
+        ivHex: envelopeIv.value.trim(),
+        authTagHex: envelopeTag.value.trim(),
+        ciphertextHex: envelopeCiphertext.value.trim(),
+        aad: envelopeAadVerify.value
+      };
+
+      try {
+        // Recipient uses its independently decapsulated AES-256-GCM session key
+        const recipientAesKey = state.decapsulationResult.recipientSecrets.sessionAesKey;
+        const result = await decryptSensitiveDataAEAD({
+          aesKey: recipientAesKey,
+          envelope: editedEnvelope
+        });
+
+        decapVerificationBox.classList.remove('error');
+        decapVerificationBox.innerHTML = `
+          <div><strong>AEAD Authentication &amp; Decryption Verified (128-bit GCM Tag Valid)</strong></div>
+          <div style="margin-top:4px; font-size:0.8rem; color:#a7f3d0;">
+            Decapsulated by Recipient via <code>${state.currentScheme}</code> | AAD Context Verified: <code>${editedEnvelope.aad}</code>
+          </div>
+          <pre style="margin-top:8px; background:#090d12; padding:8px; border-radius:6px; overflow-x:auto; font-size:0.76rem; color:#e2e8f0;">${JSON.stringify(result.parsedJson, null, 2)}</pre>
+        `;
+      } catch (err) {
+        decapVerificationBox.classList.add('error');
+        decapVerificationBox.innerHTML = `
+          <div><strong>AEAD Integrity / Authentication Rejected!</strong></div>
+          <div style="margin-top:4px;">${err.message}</div>
+          <div style="margin-top:6px; font-size:0.78rem; opacity:0.9;">
+            Zero plaintext was released because WebCrypto AES-256-GCM verified the 128-bit authentication tag before outputting any decrypted bytes.
+          </div>
+        `;
+      }
+    }
+
+    // Simulate FIPS 203 ML-KEM Implicit Rejection when KEM Ciphertext is modified in transit
+    async function simulateKemCiphertextTampering() {
+      if (!state.encapsulationResult.capsule.pqCiphertext) {
+        decapVerificationBox.classList.add('error');
+        decapVerificationBox.innerHTML = `
+          <div><strong>Select a Hybrid or Post-Quantum ML-KEM-768 scheme to test FIPS 203 Implicit Rejection.</strong></div>
+        `;
+        return;
+      }
+
+      const tamperedCapsule = {
+        ...state.encapsulationResult.capsule,
+        pqCiphertext: new Uint8Array(state.encapsulationResult.capsule.pqCiphertext)
+      };
+      // Flip 1 bit in the ML-KEM-768 lattice ciphertext
+      tamperedCapsule.pqCiphertext[0] ^= 0x01;
+
+      const tamperedDec = await decapsulateSharedSecret(state.recipientBundle, tamperedCapsule);
+      state.decapsulationResult = tamperedDec;
+
+      keyAgreementBanner.classList.add('mismatch');
+      keyMatchStatusText.textContent = `FIPS 203 Implicit Rejection Triggered! Recipient derived pseudorandom fallback key (${tamperedDec.recipientSecrets.keyFingerprint.slice(0, 12)}...) != Initiator key.`;
+
+      await verifyCurrentEnvelope();
+    }
+
+    // Browser Vault Persistence (stores only encrypted AEAD envelopes in localStorage)
+    function loadVaultFromStorage() {
+      try {
+        const raw = localStorage.getItem('daily_grind_pq_vault_v1');
+        state.vaultItems = raw ? JSON.parse(raw) : [];
+      } catch (_) {
+        state.vaultItems = [];
+      }
+      renderVaultList();
+    }
+
+    function saveCurrentToVault() {
+      if (!state.latestValidEnvelope) return;
+      const record = {
+        id: `VAULT-${Date.now().toString().slice(-5)}`,
+        envelope: structuredClone(state.latestValidEnvelope)
+      };
+      state.vaultItems.unshift(record);
+      try {
+        localStorage.setItem('daily_grind_pq_vault_v1', JSON.stringify(state.vaultItems.slice(0, 10)));
+      } catch (_) {}
+      renderVaultList();
+    }
+
+    function renderVaultList() {
+      if (state.vaultItems.length === 0) {
+        vaultRecordsList.innerHTML = `<div style="color: var(--crypto-muted); font-size: 0.82rem;">No encrypted envelopes saved yet. Click "Save Envelope to Browser Vault" to persist an AES-256-GCM record.</div>`;
+        return;
+      }
+      vaultRecordsList.innerHTML = state.vaultItems
+        .map(
+          (item) => `
+          <div class="vault-item">
+            <div>
+              <strong style="color:#fff;">${item.id}</strong>
+              <span class="meta-tag pq" style="margin-left:8px;">${item.envelope.schemeId}</span>
+              <span class="meta-tag" style="margin-left:6px;">Key FP: ${item.envelope.keyFingerprint.slice(0, 12)}...</span>
+              <div style="color:var(--crypto-muted); margin-top:4px; font-family:monospace; font-size:0.75rem;">
+                IV: ${item.envelope.ivHex} | Tag: ${item.envelope.authTagHex} | Ciphertext: ${item.envelope.ciphertextHex.slice(0, 44)}...
+              </div>
+            </div>
+            <div style="color:#6ee7b7; font-size:0.78rem; font-weight:600;">
+              AES-256-GCM Sealed (${item.envelope.byteLength} B)
+            </div>
+          </div>
+        `
+        )
+        .join('');
+    }
+
+    // Event Listeners
+    schemeSelector.addEventListener('change', (e) => {
+      establishKeyAndEncrypt(e.target.value);
+    });
+
+    document.getElementById('btn-rekey').addEventListener('click', () => {
+      establishKeyAndEncrypt(schemeSelector.value);
+    });
+
+    document.getElementById('btn-encrypt-payload').addEventListener('click', () => {
+      performEncryption();
+    });
+
+    document.getElementById('btn-decrypt-verify').addEventListener('click', () => {
+      verifyCurrentEnvelope();
+    });
+
+    document.getElementById('btn-tamper-ciphertext').addEventListener('click', () => {
+      const bytes = hexToBytes(envelopeCiphertext.value);
+      if (bytes.length > 0) {
+        bytes[0] ^= 0x01;
+        envelopeCiphertext.value = bytesToHex(bytes);
+        verifyCurrentEnvelope();
+      }
+    });
+
+    document.getElementById('btn-tamper-aad').addEventListener('click', () => {
+      envelopeAadVerify.value = envelopeAadVerify.value.replace('currency=USD', 'currency=EUR');
+      if (!envelopeAadVerify.value.includes('tampered')) {
+        envelopeAadVerify.value += '|tampered=true';
+      }
+      verifyCurrentEnvelope();
+    });
+
+    document.getElementById('btn-tamper-tag').addEventListener('click', () => {
+      const tagBytes = hexToBytes(envelopeTag.value);
+      tagBytes[tagBytes.length - 1] ^= 0xff;
+      envelopeTag.value = bytesToHex(tagBytes);
+      verifyCurrentEnvelope();
+    });
+
+    document.getElementById('btn-restore-envelope').addEventListener('click', async () => {
+      if (state.latestValidEnvelope) {
+        // Restore clean decapsulation in case KEM tampering was tested
+        state.decapsulationResult = await decapsulateSharedSecret(
+          state.recipientBundle,
+          state.encapsulationResult.capsule
+        );
+        keyAgreementBanner.classList.remove('mismatch');
+        keyMatchStatusText.textContent = `Shared Secrets Match! Initiator & Recipient derived identical 256-bit AES-GCM key (Confirm: ${state.encapsulationResult.initiatorSecrets.keyFingerprint.slice(0, 12)}...)`;
+        populateEnvelopeEditor(state.latestValidEnvelope);
+        await verifyCurrentEnvelope();
+      }
+    });
+
+    document.getElementById('btn-test-kem-rejection').addEventListener('click', () => {
+      simulateKemCiphertextTampering();
+    });
+
+    document.getElementById('btn-save-vault').addEventListener('click', () => {
+      saveCurrentToVault();
+    });
+
+    document.getElementById('btn-clear-vault').addEventListener('click', () => {
+      localStorage.removeItem('daily_grind_pq_vault_v1');
+      state.vaultItems = [];
+      renderVaultList();
+    });
+
+    document.querySelectorAll('.select-item-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const item = btn.getAttribute('data-item');
+        const price = btn.getAttribute('data-price');
+        inputOrderItem.value = `${item} - $${price}`;
+        performEncryption();
+        document.getElementById('quantum-checkout').scrollIntoView({ behavior: 'smooth' });
+      });
+    });
+
+    // Initialize on load
+    loadVaultFromStorage();
+    establishKeyAndEncrypt('X25519MLKEM768').then(() => {
+      saveCurrentToVault();
+    });
+  </script>
 </body>
 
