+      sLow[y + 2] ^= ~tL3 & tL4;
+      sHigh[y + 2] ^= ~tH3 & tH4;
+      sLow[y + 3] ^= ~tL4 & tL0;
+      sHigh[y + 3] ^= ~tH4 & tH0;
+      sLow[y + 4] ^= ~tL0 & tL1;
+      sHigh[y + 4] ^= ~tH0 & tH1;
