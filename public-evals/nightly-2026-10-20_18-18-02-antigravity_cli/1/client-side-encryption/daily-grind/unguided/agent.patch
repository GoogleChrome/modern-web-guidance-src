+    stateBytes[b + 1] = (l >>> 8) & 0xff;
+    stateBytes[b + 2] = (l >>> 16) & 0xff;
+    stateBytes[b + 3] = (l >>> 24) & 0xff;
+    stateBytes[b + 4] = h & 0xff;
+    stateBytes[b + 5] = (h >>> 8) & 0xff;
+    stateBytes[b + 6] = (h >>> 16) & 0xff;
+    stateBytes[b + 7] = (h >>> 24) & 0xff;
+  }
+}
+
+function keccakSponge(rateBytes, suffix, inputBytes, outputLen) {
+  const state = new Uint8Array(200);
+  let offset = 0;
+  while (offset + rateBytes <= inputBytes.length) {
+    for (let i = 0; i < rateBytes; i++) {
+      state[i] ^= inputBytes[offset + i];
+    }
+    keccakP1600(state);
+    offset += rateBytes;
+  }
+  const rem = inputBytes.length - offset;
+  for (let i = 0; i < rem; i++) {
+    state[i] ^= inputBytes[offset + i];
+  }
+  state[rem] ^= suffix;
+  state[rateBytes - 1] ^= 0x80;
+  keccakP1600(state);
+
+  const out = new Uint8Array(outputLen);
+  let outOffset = 0;
+  while (outOffset < outputLen) {
+    const block = Math.min(rateBytes, outputLen - outOffset);
+    out.set(state.subarray(0, block), outOffset);
+    outOffset += block;
+    if (outOffset < outputLen) {
+      keccakP1600(state);
+    }
+  }
