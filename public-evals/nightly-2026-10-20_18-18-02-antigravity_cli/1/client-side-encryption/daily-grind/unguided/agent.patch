+    return {
+      schemeId,
+      schemeMeta: KEY_ESTABLISHMENT_SCHEMES[
+        schemeId === 'X25519MLKEM768' ? 'HYBRID_X25519_MLKEM768' : 'HYBRID_P256_MLKEM768'
+      ],
+      classicalCurve: classical.curve,
+      publicKeyBundle: {
+        classicalPublicKey: classical.publicKeyBytes,
+        pqPublicKey: pq.publicKey,
+        compositePublicKey: compositePub,
+        fingerprint: bytesToHex(pubDigest.subarray(0, 16))
+      },
+      privateKeyBundle: {
+        classicalPrivateKey: classical.keyPair.privateKey,
+        pqSecretKey: pq.secretKey
+      },
+      metrics: {
+        keyGenTimeMs: +(performance.now() - startTime).toFixed(2),
+        publicKeySizeBytes: compositePub.byteLength,
+        classicalPubBytes: classical.publicKeyBytes.byteLength,
+        pqPubBytes: pq.publicKey.byteLength
+      }
+    };
+  }
+
+  if (schemeId === 'ML-KEM-768') {
+    const pq = MLKEM768_FIPS203.generateKeyPair();
+    const pubDigest = new Uint8Array(await subtle.digest('SHA-256', pq.publicKey));
+    return {
+      schemeId,
+      schemeMeta: KEY_ESTABLISHMENT_SCHEMES.PQ_MLKEM768,
+      publicKeyBundle: {
+        pqPublicKey: pq.publicKey,
+        compositePublicKey: pq.publicKey,
+        fingerprint: bytesToHex(pubDigest.subarray(0, 16))
+      },
+      privateKeyBundle: {
+        pqSecretKey: pq.secretKey
+      },
+      metrics: {
+        keyGenTimeMs: +(performance.now() - startTime).toFixed(2),
+        publicKeySizeBytes: pq.publicKey.byteLength,
+        classicalPubBytes: 0,
+        pqPubBytes: pq.publicKey.byteLength
+      }
+    };
+  }
