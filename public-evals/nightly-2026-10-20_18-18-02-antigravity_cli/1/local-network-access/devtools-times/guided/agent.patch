+import React, { useEffect, useState, useCallback } from 'react';
+import {
+  checkNetworkPermission,
+  fetchLocalDeviceStatus,
+  fetchLoopbackDaemon,
+  openLocalWebSocket,
+  openLocalWebTransport,
+  type LnaPermissionName,
+} from '../utils/localNetworkAccess';
+
+interface ConnectionPanelState {
+  permissionState: PermissionState;
+  url: string;
+  loading: boolean;
+  result: string | null;
+  error: string | null;
+}
+
+export default function LocalNetworkAccessModal() {
+  const [isOpen, setIsOpen] = useState(false);
+
+  const [localNetwork, setLocalNetwork] = useState<ConnectionPanelState>({
+    permissionState: 'prompt',
+    url: 'http://192.168.1.100:8080/api/status',
+    loading: false,
+    result: null,
+    error: null,
+  });
+
+  const [loopbackNetwork, setLoopbackNetwork] = useState<ConnectionPanelState>({
+    permissionState: 'prompt',
+    url: 'http://127.0.0.1:45678/health',
+    loading: false,
+    result: null,
+    error: null,
+  });
+
+  const [wsUrl, setWsUrl] = useState('ws://192.168.1.100:8080/stream');
+  const [wsStatus, setWsStatus] = useState<string | null>(null);
+  const [wsError, setWsError] = useState<string | null>(null);
+
+  const [wtUrl, setWtUrl] = useState('https://192.168.1.100:4433/wt');
+  const [wtStatus, setWtStatus] = useState<string | null>(null);
+  const [wtError, setWtError] = useState<string | null>(null);
+
+  const connectLocalDevice = useCallback(async (targetUrl: string) => {
+    setLocalNetwork((prev) => ({ ...prev, loading: true, error: null, result: null }));
+    try {
+      const data = await fetchLocalDeviceStatus(targetUrl);
+      setLocalNetwork((prev) => ({
+        ...prev,
+        loading: false,
+        result: JSON.stringify(data, null, 2),
+      }));
+    } catch (err) {
+      setLocalNetwork((prev) => ({
+        ...prev,
+        loading: false,
+        error:
+          err instanceof Error
+            ? `${err.message}. Check that the local network device is powered on, connected to the same LAN, and that 'Local network' access is allowed in browser Site settings.`
+            : 'Failed to reach local network device.',
+      }));
+    }
+  }, []);
+
+  const connectLoopbackDaemon = useCallback(async (targetUrl: string) => {
+    setLoopbackNetwork((prev) => ({ ...prev, loading: true, error: null, result: null }));
+    try {
+      const data = await fetchLoopbackDaemon(targetUrl);
+      setLoopbackNetwork((prev) => ({
+        ...prev,
+        loading: false,
+        result: JSON.stringify(data, null, 2),
+      }));
+    } catch (err) {
+      setLoopbackNetwork((prev) => ({
+        ...prev,
+        loading: false,
+        error:
+          err instanceof Error
+            ? `${err.message}. Check that your local companion service is running on 127.0.0.1 / localhost and that 'Loopback network' access is allowed in browser Site settings.`
+            : 'Failed to reach loopback companion service.',
+      }));
+    }
+  }, []);
+
+  // Pre-check granular permission states without firing network requests when state is 'prompt'
+  useEffect(() => {
+    let mounted = true;
+
+    async function initPermissions() {
+      const localState = await checkNetworkPermission('local-network', (newState) => {
+        if (mounted) {
+          setLocalNetwork((prev) => ({ ...prev, permissionState: newState }));
+        }
+      });
+      if (mounted) {
+        setLocalNetwork((prev) => ({ ...prev, permissionState: localState }));
+        if (localState === 'granted') {
+          connectLocalDevice('http://192.168.1.100:8080/api/status');
+        }
+      }
+
+      const loopbackState = await checkNetworkPermission('loopback-network', (newState) => {
+        if (mounted) {
+          setLoopbackNetwork((prev) => ({ ...prev, permissionState: newState }));
+        }
+      });
+      if (mounted) {
+        setLoopbackNetwork((prev) => ({ ...prev, permissionState: loopbackState }));
+        if (loopbackState === 'granted') {
+          connectLoopbackDaemon('http://127.0.0.1:45678/health');
+        }
+      }
+    }
+
+    initPermissions();
+    return () => {
+      mounted = false;
+    };
+  }, [connectLocalDevice, connectLoopbackDaemon]);
+
+  const handleWebSocketConnect = () => {
+    setWsError(null);
+    setWsStatus('Connecting...');
+    try {
+      const socket = openLocalWebSocket(wsUrl);
+      socket.addEventListener('open', () => {
+        setWsStatus('Connected over WebSocket');
+      });
+      socket.addEventListener('error', () => {
+        setWsStatus(null);
+        setWsError(
+          'WebSocket connection failed. Verify the local endpoint is reachable and permitted in browser Site settings.'
+        );
+      });
+      socket.addEventListener('close', () => {
+        setWsStatus((prev) => (prev === 'Connected over WebSocket' ? 'Closed' : prev));
+      });
+    } catch (err) {
+      setWsStatus(null);
+      setWsError(err instanceof Error ? err.message : 'WebSocket error');
+    }
+  };
+
+  const handleWebTransportConnect = async () => {
+    setWtError(null);
+    setWtStatus('Connecting...');
+    try {
+      const transport = await openLocalWebTransport(wtUrl);
+      setWtStatus('WebTransport session ready');
+      transport.closed.catch(() => {
+        setWtStatus('Closed');
+      });
+    } catch (err) {
+      setWtStatus(null);
+      setWtError(
