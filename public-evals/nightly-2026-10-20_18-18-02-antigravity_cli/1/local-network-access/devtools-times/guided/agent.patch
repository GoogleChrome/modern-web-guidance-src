+
+                <div
+                  data-remediation="local-network"
+                  hidden={localNetwork.permissionState !== 'denied'}
+                  className="p-3 mb-3 rounded bg-red-50 border border-red-200 text-xs text-red-800"
+                >
+                  <strong>Permission Denied:</strong> Local network access is blocked. To
