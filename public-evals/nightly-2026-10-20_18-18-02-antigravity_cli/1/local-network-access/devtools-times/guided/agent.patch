+            </div>
+
+            {typeof window !== 'undefined' && !window.isSecureContext && (
+              <div
+                role="alert"
+                className="mb-4 p-3 rounded bg-amber-50 border border-amber-300 text-xs text-amber-900"
+              >
+                <strong>Secure Context Required:</strong> Local Network Access permissions require{' '}
+                <code>https://</code> in production.
+              </div>
