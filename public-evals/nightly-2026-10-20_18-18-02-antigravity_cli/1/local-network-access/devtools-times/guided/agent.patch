+
+            <div className="space-y-5">
+              {/* 1. Local Network Section (local-network / targetAddressSpace: 'local') */}
+              <section className="p-4 rounded-md border border-gray-200 bg-gray-50">
+                <div className="flex items-center justify-between mb-2">
+                  <div>
+                    <h3 className="text-sm font-bold text-gray-900">
+                      Local Network Device (<code>local-network</code>)
