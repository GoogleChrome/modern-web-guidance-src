+                    </p>
+                  </div>
+                  {renderPermissionBadge('local-network', localNetwork.permissionState)}
+                </div>
+
+                {localNetwork.permissionState === 'prompt' && (
+                  <p className="text-xs text-gray-700 bg-white p-2 rounded border border-gray-200 mb-3">
+                    <strong>Why we need access:</strong> Granting Local Network permission allows
