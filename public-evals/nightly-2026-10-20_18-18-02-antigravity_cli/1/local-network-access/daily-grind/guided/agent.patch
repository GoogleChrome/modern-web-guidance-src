+  <script type="module">
+    /**
+     * Cross-browser permission check for the granular LNA permissions.
+     * Never falls back to querying 'local-network-access', which crashes older Chrome versions.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     */
+    export async function queryLnaPermissionSafe(permissionName) {
+      if (!navigator.permissions?.query) {
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+      try {
+        const status = await navigator.permissions.query({ name: permissionName });
+        // Keep UI synchronized if the user changes permission in browser site settings
+        status.addEventListener('change', () => {
+          updatePermissionUI(permissionName, status.state);
+        });
+        updatePermissionUI(permissionName, status.state);
+        return status.state;
+      } catch {
+        // Unrecognized permission name; proceed on user gesture
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+    }
+
+    function updatePermissionUI(permissionName, state) {
+      const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+      const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+      const promptNotice = document.querySelector(`[data-prompt-notice="${permissionName}"]`);
+      if (statusBadge) {
+        statusBadge.textContent = state;
+        statusBadge.dataset.state = state;
+      }
+      if (remediationBox) {
+        // Show remediation instructions whenever permission is explicitly denied
+        remediationBox.hidden = state !== 'denied';
+      }
+      if (promptNotice) {
+        promptNotice.hidden = state !== 'prompt';
+      }
+    }
+
+    /**
+     * Connects to a local network device (e.g., LAN smart brewer or IoT hub) over HTTP.
+     */
+    export async function fetchLocalDeviceStatus(deviceUrl = 'http://192.168.1.100:8080/api/status') {
+      const request = new Request(deviceUrl, {
+        method: 'GET',
+        mode: 'cors',
+        // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+        targetAddressSpace: 'local',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Device responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Connects to a local companion daemon running on the user's loopback interface.
+     */
+    export async function fetchLoopbackDaemon(daemonUrl = 'http://127.0.0.1:45678/health') {
+      const request = new Request(daemonUrl, {
+        method: 'GET',
+        mode: 'cors',
+        // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+        targetAddressSpace: 'loopback',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Companion app responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Opens a WebSocket connection to a local network or loopback device (IP literal, .local, or localhost).
+     */
+    export function openLocalWebSocket(wsUrl = 'ws://192.168.1.100:8080/stream') {
+      // Pass only subprotocol string(s) as the second argument (never an options object).
+      // Browsers exempt ws:// from Mixed Content when the host is a local/loopback IP literal,
+      // .local, or localhost, and gate the connection on 'local-network' or 'loopback-network'.
+      const socket = new WebSocket(wsUrl, ['v1.telemetry']);
+      return socket;
+    }
+
+    /**
+     * Opens a WebTransport session to a local network endpoint using a pinned self-signed certificate hash.
+     */
+    export async function openLocalWebTransport(wtUrl = 'https://192.168.1.100:4433/wt', certSha256Bytes) {
+      const transport = new WebTransport(wtUrl, {
+        serverCertificateHashes: [
+          {
+            algorithm: 'sha-256',
+            value: certSha256Bytes,
+          },
+        ],
+      });
+
+      // transport.ready resolves only after the user grants the 'local-network' permission
+      // and rejects with WebTransportError if the permission is denied.
+      await transport.ready;
+      return transport;
+    }
+
+    async function handleLocalHttpConnect() {
+      const urlInput = document.getElementById('local-http-url');
+      const output = document.getElementById('local-output');
+      const remediation = document.querySelector('[data-remediation="local-network"]');
+      output.textContent = `Connecting to local device at ${urlInput.value} (targetAddressSpace: 'local')...`;
+
+      try {
+        const data = await fetchLocalDeviceStatus(urlInput.value);
+        output.textContent = `Connected to local brewer:\n${JSON.stringify(data, null, 2)}`;
+        await queryLnaPermissionSafe('local-network');
+      } catch (err) {
+        output.textContent = `Local network request failed: ${err.message}. Verify the device is powered on, connected to the same network, and allowed in browser site settings.`;
+        const state = await queryLnaPermissionSafe('local-network');
+        if (remediation && state === 'denied') {
+          remediation.hidden = false;
+        }
+      }
+    }
+
+    async function handleLoopbackHttpConnect() {
+      const urlInput = document.getElementById('loopback-http-url');
+      const output = document.getElementById('loopback-output');
+      const remediation = document.querySelector('[data-remediation="loopback-network"]');
+      output.textContent = `Connecting to loopback daemon at ${urlInput.value} (targetAddressSpace: 'loopback')...`;
+
+      try {
+        const data = await fetchLoopbackDaemon(urlInput.value);
+        output.textContent = `Connected to loopback daemon:\n${JSON.stringify(data, null, 2)}`;
+        await queryLnaPermissionSafe('loopback-network');
+      } catch (err) {
+        output.textContent = `Loopback request failed: ${err.message}. Verify the companion daemon is running on your machine and allowed in browser site settings.`;
+        const state = await queryLnaPermissionSafe('loopback-network');
+        if (remediation && state === 'denied') {
+          remediation.hidden = false;
+        }
+      }
+    }
+
+    function handleWebSocketConnect(inputId, outputId, permissionName) {
+      const urlInput = document.getElementById(inputId);
+      const output = document.getElementById(outputId);
+      output.textContent = `Opening WebSocket to ${urlInput.value}...`;
+
+      try {
+        const socket = openLocalWebSocket(urlInput.value);
+        socket.addEventListener('open', () => {
+          output.textContent = `WebSocket connected to ${urlInput.value}`;
+          queryLnaPermissionSafe(permissionName);
+        });
+        socket.addEventListener('message', (event) => {
+          output.textContent = `Telemetry received: ${String(event.data)}`;
+        });
+        socket.addEventListener('error', () => {
+          output.textContent = `WebSocket connection failed for ${urlInput.value}. Ensure the endpoint is reachable, uses ws:// with an IP literal, .local, or localhost (or wss:// for custom hostnames), and that ${permissionName} permission is allowed.`;
+          queryLnaPermissionSafe(permissionName);
+        });
+      } catch (err) {
+        output.textContent = `WebSocket error: ${err.message}`;
+      }
+    }
+
+    async function initLocalNetworkAccess() {
+      const insecureWarning = document.getElementById('insecure-context-warning');
+      if (!window.isSecureContext && insecureWarning) {
+        insecureWarning.hidden = false;
+      }
+
+      document.getElementById('btn-fetch-local')?.addEventListener('click', handleLocalHttpConnect);
+      document.getElementById('btn-fetch-loopback')?.addEventListener('click', handleLoopbackHttpConnect);
+      document.getElementById('btn-ws-local')?.addEventListener('click', () => {
+        handleWebSocketConnect('local-ws-url', 'local-output', 'local-network');
+      });
+      document.getElementById('btn-ws-loopback')?.addEventListener('click', () => {
+        handleWebSocketConnect('loopback-ws-url', 'loopback-output', 'loopback-network');
+      });
+
+      // Pre-check granular permissions; only auto-connect if already 'granted'
+      const [localState, loopbackState] = await Promise.all([
+        queryLnaPermissionSafe('local-network'),
+        queryLnaPermissionSafe('loopback-network'),
+      ]);
+
+      if (localState === 'granted') {
+        handleLocalHttpConnect();
+      }
+      if (loopbackState === 'granted') {
+        handleLoopbackHttpConnect();
+      }
+    }
+
+    initLocalNetworkAccess();
+  </script>
