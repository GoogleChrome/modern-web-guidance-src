+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryContainer = document.getElementById('journal-summary');
+    const summaryOutput = document.getElementById('summary-output');
+    const journalArticle = document.getElementById('journal-article');
+
+    function renderBulletsFromText(rawSummary) {
+      const lines = rawSummary
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^[\s*\-•+\d.)]+/, '').trim())
+        .filter(Boolean);
+
+      const ul = document.createElement('ul');
+      for (const line of lines) {
+        const li = document.createElement('li');
+        // Strip basic markdown bold/italic markers if present
+        li.textContent = line.replace(/\*\*(.*?)\*\*/g, '$1').replace(/\*(.*?)\*/g, '$1');
+        ul.appendChild(li);
+      }
+      summaryOutput.innerHTML = '';
+      summaryOutput.appendChild(ul);
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      const articleText = journalArticle.innerText.trim();
+      summaryContainer.classList.add('visible');
+      summarizeBtn.disabled = true;
+      summarizeBtn.textContent = 'Summarizing...';
+      summaryOutput.innerHTML = '<p class="summary-status">Generating summary with browser AI...</p>';
+
+      let summarizer = null;
+      try {
+        const options = {
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'An article from a coffee roaster journal about ethical bean sourcing, harvesting, and processing.',
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (e.loaded !== undefined) {
+                const pct = Math.round(e.loaded * 100);
+                summaryOutput.innerHTML = `<p class="summary-status">Downloading browser AI model (${pct}%)...</p>`;
+              }
+            });
+          }
+        };
+
+        if ('Summarizer' in self) {
+          const availability = await Summarizer.availability();
+          if (availability === 'unavailable') {
+            throw new Error('The browser Summarizer API is currently unavailable on this device.');
+          }
+          summarizer = await Summarizer.create(options);
+        } else if (self.ai && self.ai.summarizer) {
+          const capabilities = await self.ai.summarizer.capabilities();
+          if (capabilities && capabilities.available === 'no') {
+            throw new Error('The browser AI Summarizer is currently unavailable on this device.');
+          }
+          summarizer = await self.ai.summarizer.create(options);
+        } else {
+          throw new Error('Browser native AI Summarizer API is not supported in this browser.');
+        }
+
+        const result = await summarizer.summarize(articleText, {
+          context: 'Summarize the coffee bean sourcing process into a few concise bullet points.'
+        });
+
+        renderBulletsFromText(result);
+        summarizeBtn.textContent = 'Summarize';
+      } catch (err) {
+        console.error('Summarization error:', err);
+        summaryOutput.innerHTML = `<p class="summary-status">${err.message || 'Unable to summarize using browser AI.'}</p>`;
+        summarizeBtn.textContent = 'Summarize';
+      } finally {
+        if (summarizer && typeof summarizer.destroy === 'function') {
+          summarizer.destroy();
+        }
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
+
