+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryStatus = document.getElementById('summary-status');
+    const summaryContainer = document.getElementById('summary-container');
+    const summaryList = document.getElementById('summary-list');
+    const journalArticle = document.getElementById('journal-article');
+
+    const summarizerOptions = {
+      type: 'key-points',
+      format: 'plain-text',
+      length: 'short',
+      sharedContext: 'An artisanal coffee roastery journal entry detailing their direct-trade bean sourcing and processing standards.',
+    };
+
+    function renderSummaryPoints(rawSummary) {
+      summaryList.replaceChildren();
+      const lines = rawSummary
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^[\s*•\-–\d.)]+/, '').trim())
+        .filter(Boolean);
+
+      const items = lines.length > 0 ? lines : [rawSummary.trim()].filter(Boolean);
+
+      for (const point of items) {
+        const li = document.createElement('li');
+        li.textContent = point;
+        summaryList.appendChild(li);
+      }
+
+      summaryContainer.hidden = items.length === 0;
+    }
+
+    async function checkSummarizerSupport() {
+      if (!('Summarizer' in self)) {
+        summarizeBtn.disabled = true;
+        summaryStatus.textContent = 'Local summarization is currently unsupported in this browser.';
+        return;
+      }
+
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          summarizeBtn.disabled = true;
+          summaryStatus.textContent = 'Local summarization is unavailable on this device.';
+        }
+      } catch (err) {
+        summarizeBtn.disabled = true;
+        summaryStatus.textContent = 'Unable to verify local AI summarization support.';
+      }
+    }
+
+    checkSummarizerSupport();
+
+    summarizeBtn.addEventListener('click', async () => {
+      if (!('Summarizer' in self)) {
+        summarizeBtn.disabled = true;
+        summaryStatus.textContent = 'Local summarization is currently unsupported in this browser.';
+        return;
+      }
+
+      summarizeBtn.disabled = true;
+      summaryStatus.textContent = 'Checking local AI model availability...';
+
+      let summarizer;
+      try {
+        const availability = await Summarizer.availability(summarizerOptions);
+        if (availability === 'unavailable') {
+          summaryStatus.textContent = 'Local summarization is unavailable on this device.';
+          return;
+        }
+
+        summarizer = await Summarizer.create({
+          ...summarizerOptions,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (e.total) {
+                const percent = Math.round((e.loaded / e.total) * 100);
+                summaryStatus.textContent = `Downloading on-device AI model (${percent}%)...`;
+              } else {
+                summaryStatus.textContent = 'Downloading on-device AI model...';
+              }
+            });
+          },
+        });
+
+        summaryStatus.textContent = 'Generating summary...';
+        const longText = journalArticle.innerText;
+        const summary = await summarizer.summarize(longText, {
+          context: 'Summarize the coffee bean sourcing and processing steps into concise bullet points.',
+        });
+
+        renderSummaryPoints(summary);
+        summaryStatus.textContent = 'Summary generated on-device.';
+      } catch (error) {
+        summaryStatus.textContent = `Could not generate summary: ${error.message || 'An unexpected error occurred.'}`;
+      } finally {
+        summarizer?.destroy?.();
+        if ('Summarizer' in self) {
+          summarizeBtn.disabled = false;
+        }
+      }
+    });
+  </script>
