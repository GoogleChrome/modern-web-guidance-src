   </style>
 </head>
 
 <body>
+  <div class="scroller" role="region" tabindex="-1" aria-label="The Daily Grind page">
+  <div class="scroll-sentinel" aria-hidden="true"></div>
 
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
@@ -206,7 +279,35 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <!-- This final row reserves space so the floating button cannot cover the footer. -->
+  <button type="button" class="back-to-top">
+    <span aria-hidden="true">↑</span> Back to top
+  </button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const observer = new IntersectionObserver(([entry]) => {
+        scroller.classList.toggle('scrolled', !entry.isIntersecting);
+      }, { root: scroller, threshold: 1 });
+
+      observer.observe(scroller.querySelector('.scroll-sentinel'));
+    }
+
+    backToTop.addEventListener('click', () => {
+      // Return keyboard focus before the button becomes hidden at the top.
+      scroller.focus({ preventScroll: true });
+      scroller.scrollTo({
+        top: 0,
+        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+      });
+    });
+  </script>
+
 </body>
 
 </html>
