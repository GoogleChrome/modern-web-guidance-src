+  <script>
+    const startButton = document.getElementById('start-btn');
+    const output = document.getElementById('output');
+    const yieldToBrowser = () => new Promise(resolve => setTimeout(resolve, 0));
+
+    function simulateBlend(index) {
+      const started = performance.now();
+      let flavor = index + 1;
+      // Synthetic computation represents about 2ms of flavor analysis per blend.
+      while (performance.now() - started < 2) {
+        flavor = Math.sin(flavor) * Math.cos(flavor) + 1;
+      }
+      return flavor;
+    }
+
+    startButton.addEventListener('click', async () => {
+      if (startButton.disabled) return;
+      startButton.disabled = true;
+      output.textContent = 'Processing...';
+
+      try {
+        // Let the browser display the initial status before starting the work.
+        await yieldToBrowser();
+        const total = 1000;
+        let processed = 0;
+
+        while (processed < total) {
+          const chunkStarted = performance.now();
+          do {
+            simulateBlend(processed);
+            processed++;
+          } while (processed < total && performance.now() - chunkStarted < 50);
+
+          output.textContent = `Processed ${processed} of ${total}...`;
+          // A new task gives rendering and queued user input time to run.
+          await yieldToBrowser();
+        }
+
+        output.textContent = 'Done! All items processed.';
+      } catch (error) {
+        output.textContent = 'Simulation failed. Please try again.';
+        console.error(error);
+      } finally {
+        startButton.disabled = false;
+      }
+    });
+  </script>
