+  <script type="module">
+    const startButton = document.getElementById('start-btn');
+    const output = document.getElementById('output');
+    const totalItems = 1000;
+
+    function yieldToBrowser() {
+      if (typeof window.scheduler?.yield === 'function') {
+        return window.scheduler.yield();
+      }
+      return new Promise(resolve => setTimeout(resolve, 0));
+    }
+
+    function processBlend() {
+      // Simulate approximately 2ms of computation for one recipe blend.
+      const start = performance.now();
+      while (performance.now() - start < 2) {
+        // Stand-in for flavor profile calculations.
+      }
+    }
+
+    startButton.addEventListener('click', async () => {
+      if (startButton.disabled) return;
+      startButton.disabled = true;
+      output.textContent = 'Processing...';
+
+      try {
+        await yieldToBrowser();
+        let deadline = performance.now() + 50;
+
+        for (let processed = 1; processed <= totalItems; processed++) {
+          processBlend();
+
+          if (performance.now() >= deadline || processed === totalItems) {
+            output.textContent = `Processed ${processed} of ${totalItems}...`;
+            // Let input events and rendering run before the next batch.
+            await yieldToBrowser();
+            deadline = performance.now() + 50;
+          }
+        }
+
+        output.textContent = 'Done! All items processed.';
+      } finally {
+        startButton.disabled = false;
+      }
+    });
+  </script>
+
