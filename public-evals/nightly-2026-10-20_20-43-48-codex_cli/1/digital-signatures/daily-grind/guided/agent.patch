+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {generateKey,signContent,verifyContent,encode,decode,exportPair,importPair} from './crypto.js';
+for(const algorithm of ['Ed25519','ML-DSA-65']) {
+ test(`${algorithm}: text and artifact signatures verify and reject changes`, async()=>{
+  const key=await generateKey(algorithm);const other=await generateKey(algorithm);
+  for(const content of [new TextEncoder().encode('An authentic message'),new Uint8Array([0,255,3,9,128])]){
+   const signature=await signContent(key,content);
+   assert.equal(await verifyContent(algorithm,key.publicBytes,decode(encode(signature)),content),true);
+   const tampered=content.slice();tampered[0]^=1;
+   assert.equal(await verifyContent(algorithm,key.publicBytes,signature,tampered),false);
+   assert.equal(await verifyContent(algorithm,other.publicBytes,signature,content),false);
+  }
+  const restored=await importPair(await exportPair(key));const bytes=new TextEncoder().encode('Round trip');
+  assert.equal(await verifyContent(algorithm,key.publicBytes,await signContent(restored,bytes),bytes),true);
+ });
+}
