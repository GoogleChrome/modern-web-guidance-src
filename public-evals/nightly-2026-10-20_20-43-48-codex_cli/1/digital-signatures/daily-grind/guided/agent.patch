+import { ml_dsa65 } from '@noble/post-quantum/ml-dsa.js';
+export const encode = value => { let str=''; for (const byte of new Uint8Array(value)) str+=String.fromCharCode(byte); return btoa(str); };
+export const decode = value => Uint8Array.from(atob(value.replace(/\s/g,'')), c=>c.charCodeAt(0));
+export async function generateKey(algorithm, name='My signing key') {
+  const material = algorithm==='Ed25519' ? await crypto.subtle.generateKey({name:'Ed25519'}, true, ['sign','verify']) : ml_dsa65.keygen();
+  const publicBytes = algorithm==='Ed25519' ? new Uint8Array(await crypto.subtle.exportKey('raw',material.publicKey)) : material.publicKey;
+  return {id:crypto.randomUUID(), name, algorithm, material, publicBytes, created:new Date()};
+}
+export async function signContent(key, bytes) {
+  return key.algorithm==='Ed25519' ? new Uint8Array(await crypto.subtle.sign('Ed25519',key.material.privateKey,bytes)) : ml_dsa65.sign(bytes,key.material.secretKey);
+}
+export async function verifyContent(algorithm,publicBytes,signature,bytes) {
+  if(algorithm==='Ed25519') { const key=await crypto.subtle.importKey('raw',publicBytes,{name:'Ed25519'},false,['verify']);return crypto.subtle.verify('Ed25519',key,signature,bytes); }
+  if(algorithm==='ML-DSA-65') return ml_dsa65.verify(signature,bytes,publicBytes);
+  throw new Error('Unsupported signature algorithm.');
+}
+export async function exportPair(key) {
+  const secret=key.algorithm==='Ed25519' ? new Uint8Array(await crypto.subtle.exportKey('pkcs8',key.material.privateKey)) : key.material.secretKey;
+  return {format:'cipher-key-v1',name:key.name,algorithm:key.algorithm,publicKey:encode(key.publicBytes),privateKey:encode(secret)};
+}
+export async function importPair(data) {
+  if(data.format!=='cipher-key-v1'||!['Ed25519','ML-DSA-65'].includes(data.algorithm)) throw new Error('Choose a Cipher key-pair JSON file.');
+  const publicBytes=decode(data.publicKey),secret=decode(data.privateKey);
+  const material=data.algorithm==='Ed25519' ? {publicKey:await crypto.subtle.importKey('raw',publicBytes,{name:'Ed25519'},true,['verify']),privateKey:await crypto.subtle.importKey('pkcs8',secret,{name:'Ed25519'},true,['sign'])} : {publicKey:publicBytes,secretKey:secret};
+  const key={id:crypto.randomUUID(),name:String(data.name||'Imported key').slice(0,60),algorithm:data.algorithm,publicBytes,material,created:new Date()};
+  const probe=new TextEncoder().encode('cipher-key-pair-check');
+  if(!await verifyContent(key.algorithm,publicBytes,await signContent(key,probe),probe)) throw new Error('The public and private keys do not match.');
+  return key;
+}
