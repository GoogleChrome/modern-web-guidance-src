new file mode 100644
index 0000000..b382935
--- /dev/null
+++ b/crypto.js
@@ -0,0 +1,38 @@
+import { ml_dsa65 } from '@noble/post-quantum/ml-dsa.js';
+
+export const algorithms = ['Ed25519', 'ECDSA', 'ML-DSA-65'];
+export const toBase64 = bytes => { let result = ''; for (const b of new Uint8Array(bytes)) result += String.fromCharCode(b); return btoa(result); };
+export const fromBase64 = text => { const s = text.trim(); if (!s || !/^[A-Za-z0-9+/]*={0,2}$/.test(s)) throw new Error('Enter valid Base64 data.'); return Uint8Array.from(atob(s), c => c.charCodeAt(0)); };
+function checkAlgorithm(algorithm) { if (!algorithms.includes(algorithm)) throw new Error('Unsupported signing algorithm.'); }
+const keyParams = algorithm => algorithm === 'ECDSA' ? {name: 'ECDSA', namedCurve: 'P-256'} : {name: 'Ed25519'};
+const signParams = algorithm => algorithm === 'ECDSA' ? {name: 'ECDSA', hash: 'SHA-256'} : {name: 'Ed25519'};
+export async function generateKey(algorithm, name) {
+  checkAlgorithm(algorithm);
+  let privateKey, publicKey;
+  if (algorithm === 'ML-DSA-65') { const keys = ml_dsa65.keygen(); privateKey = keys.secretKey; publicKey = keys.publicKey; }
+  else { const pair = await crypto.subtle.generateKey(keyParams(algorithm), true, ['sign','verify']); privateKey = new Uint8Array(await crypto.subtle.exportKey('pkcs8', pair.privateKey)); publicKey = new Uint8Array(await crypto.subtle.exportKey('spki', pair.publicKey)); }
+  return {id: crypto.randomUUID(), name, algorithm, privateKey:toBase64(privateKey), publicKey:toBase64(publicKey), created: new Date().toISOString()};
+}
+export async function signBytes(key, data) {
+  checkAlgorithm(key.algorithm);
+  const secret = fromBase64(key.privateKey);
+  if (key.algorithm === 'ML-DSA-65') return ml_dsa65.sign(data, secret);
+  const imported = await crypto.subtle.importKey('pkcs8', secret, keyParams(key.algorithm), false, ['sign']);
+  return new Uint8Array(await crypto.subtle.sign(signParams(key.algorithm), imported, data));
+}
+export async function verifyBytes(algorithm, publicKey, data, signature) {
+  checkAlgorithm(algorithm);
+  const pub = fromBase64(publicKey);
+  if (algorithm === 'ML-DSA-65') return ml_dsa65.verify(signature, data, pub);
+  const imported = await crypto.subtle.importKey('spki', pub, keyParams(algorithm), false, ['verify']);
+  return crypto.subtle.verify(signParams(algorithm), imported, signature, data);
+}
+export async function validateKey(key) {
+  checkAlgorithm(key.algorithm);
+  if (!key.publicKey || typeof key.name !== 'string') throw new Error('This file is not a Cipher key.');
+  const probe = new TextEncoder().encode('Cipher key validation');
+  if (key.privateKey) { const signed = await signBytes(key, probe); if (!await verifyBytes(key.algorithm, key.publicKey, probe, signed)) throw new Error('The private and public keys do not match.'); }
+  else { const pub = fromBase64(key.publicKey); if (key.algorithm === 'ML-DSA-65') { if (pub.length !== ml_dsa65.lengths.publicKey) throw new Error('Invalid ML-DSA-65 public key.'); } else await crypto.subtle.importKey('spki',pub,keyParams(key.algorithm),false,['verify']); }
+  return {...key,id:crypto.randomUUID(),created:key.created || new Date().toISOString()};
+}
+export function publicKeyExport(key) { return {format:'cipher-key-v1',name:key.name,algorithm:key.algorithm,publicKey:key.publicKey,created:key.created}; }
diff --git a/crypto.test.js b/crypto.test.js
