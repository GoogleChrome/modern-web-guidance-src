@@ -0,0 +1,36 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { algorithms, generateKey, signBytes, verifyBytes, validateKey, publicKeyExport, toBase64, fromBase64 } from './crypto.js';
+const bytes = new TextEncoder().encode('Release artifact: v1.0 — authentic ✓');
+for (const algorithm of algorithms) {
+  test(`${algorithm}: signatures verify, tampering and wrong keys fail`, async () => {
+    const key = await generateKey(algorithm, 'Test key');
+    const other = await generateKey(algorithm, 'Other key');
+    const signature = await signBytes(key, bytes);
+    assert.equal(await verifyBytes(algorithm,key.publicKey,bytes,signature),true);
+    const changed = bytes.slice(); changed[0] ^= 1;
+    assert.equal(await verifyBytes(algorithm,key.publicKey,changed,signature),false);
+    assert.equal(await verifyBytes(algorithm,other.publicKey,bytes,signature),false);
+    const altered = signature.slice(); altered[0] ^= 1;
+    assert.equal(await verifyBytes(algorithm,key.publicKey,bytes,altered),false);
+    assert.deepEqual(fromBase64(toBase64(bytes)),bytes);
+    const imported=await validateKey(JSON.parse(JSON.stringify(key)));
+    assert.equal(await verifyBytes(algorithm,imported.publicKey,bytes,await signBytes(imported,bytes)),true);
+    const publicOnly=publicKeyExport(key);
+    assert.equal(publicOnly.privateKey,undefined);
+    assert.equal((await validateKey(publicOnly)).publicKey,key.publicKey);
+    await assert.rejects(()=>validateKey({...key,publicKey:other.publicKey}));
+  });
+}
+test('Unknown algorithms and malformed keys are rejected',async()=>{
+  await assert.rejects(()=>generateKey('unknown','Bad key'),/Unsupported/);
+  await assert.rejects(()=>validateKey({algorithm:'ML-DSA-65',name:'Invalid',publicKey:'AAAA'}),/Invalid/);
+  assert.throws(()=>fromBase64('<invalid>'),/Base64/);
+});
+test('Binary artifacts round-trip without text decoding',async()=>{
+  const key=await generateKey('Ed25519','Artifact key');
+  const binary=new Uint8Array([0,255,128,13,10,0,1]);
+  const signature=await signBytes(key,binary);
+  const envelope=JSON.parse(JSON.stringify({algorithm:key.algorithm,publicKey:key.publicKey,data:toBase64(binary),signature:toBase64(signature)}));
+  assert.equal(await verifyBytes(envelope.algorithm,envelope.publicKey,fromBase64(envelope.data),fromBase64(envelope.signature)),true);
+});
