+<script>
+    (() => {
+      const types = {
+        checkout: { name: 'Checkout', priority: 1, slices: 35, label: 'Urgent' },
+        menu: { name: 'Menu update', priority: 2, slices: 65, label: 'Standard' },
+        telemetry: { name: 'Telemetry', priority: 3, slices: 90, label: 'Background' }
+      };
+      const queueList = document.getElementById('queue-list');
+      const log = document.getElementById('activity-log');
+      let queue = [], sequence = 0, completed = 0, active = null, timer = null;
+      let lastPaint = 0;
+      const sortQueue = () => queue.sort((a, b) => a.priority - b.priority || a.id - b.id);
+
+      function record(message, success = false) {
+        const line = document.createElement('div');
+        line.className = 'log-line' + (success ? ' log-success' : '');
+        const time = document.createElement('span');
+        time.className = 'log-time';
+        time.textContent = new Date().toLocaleTimeString('en-GB');
+        const content = document.createElement('span');
+        content.className = 'log-message';
+        content.textContent = message;
+        line.append(time, content);
+        log.append(line);
+        while (log.children.length > 80) log.firstChild.remove();
+        log.scrollTop = log.scrollHeight;
+      }
+
+      function render() {
+        document.getElementById('queue-count').textContent = queue.length;
+        document.getElementById('pending-count').textContent = queue.length;
+        document.getElementById('completed-count').textContent = completed;
+        if (!queue.length) {
+          queueList.innerHTML = '<div class="queue-empty"><span class="empty-icon" aria-hidden="true">☷</span><strong>All quiet behind the counter</strong><p>Choose a task above to get things brewing.</p></div>';
+          return;
+        }
+        queueList.innerHTML = queue.map(task => {
+          const progress = Math.round(task.done / task.slices * 100);
+          const state = task === active ? 'Running' : task.done ? 'Paused' : 'Queued';
+          return `<div class="queue-task"><div class="queue-task-top"><strong>${task.name} <span style="color:#a69381;font-weight:400">#${task.id}</span></strong><span class="task-state">${task.label} · ${state} ${progress}%</span></div><div class="task-progress" role="progressbar" aria-label="${task.name} #${task.id}" aria-valuenow="${progress}" aria-valuemin="0" aria-valuemax="100"><div style="width:${progress}%"></div></div></div>`;
+        }).join('');
+      }
+
+      function tick() {
+        timer = null;
+        sortQueue();
+        const task = queue[0];
+        if (!task) { active = null; render(); return; }
+        if (active !== task) {
+          if (active && queue.includes(active)) record(`Paused ${active.name} #${active.id} for higher priority work.`);
+          record(`${task.done ? 'Resuming' : 'Running'} ${task.name} #${task.id} [${task.label.toLowerCase()}]`);
+          active = task;
+        }
+        // Bound CPU work to 4ms, then yield to input, rendering, and new tasks.
+        const deadline = performance.now() + 4;
+        let sample = 0;
+        while (performance.now() < deadline) sample = Math.sqrt(sample + Math.random());
+        task.done++;
+        if (task.done >= task.slices) {
+          queue.shift();
+          completed++;
+          record(`Completed ${task.name} #${task.id}`, true);
+          active = null;
+          render();
+        } else if (performance.now() - lastPaint > 80) {
+          render();
+          lastPaint = performance.now();
+        }
+        if (queue.length) timer = setTimeout(tick, 16);
+        else record('Queue clear. Ready for the next rush.', true);
+      }
+
+      function enqueue(taskTypes) {
+        taskTypes.forEach(type => {
+          const task = { ...types[type], id: ++sequence, done: 0 };
+          queue.push(task);
+          record(`Queued ${task.name} #${task.id} [${task.label.toLowerCase()}]`);
+        });
+        sortQueue();
+        render();
+        if (timer === null) timer = setTimeout(tick, 0);
+      }
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.task]));
+      });
+      document.getElementById('run-batch').addEventListener('click', () => {
+        record('Batch added: 1 urgent, 2 standard, 2 background.');
+        enqueue(['telemetry', 'menu', 'checkout', 'telemetry', 'menu']);
+      });
+      document.getElementById('reset-queue').addEventListener('click', () => {
+        clearTimeout(timer);
+        timer = null;
+        queue = [];
+        active = null;
+        completed = 0;
+        sequence = 0;
+        log.replaceChildren();
+        render();
+        record('Queue reset. Ready when you are.');
+      });
+      render();
+      record('Scheduler ready. Waiting for a little bustle.');
+    })();
+  </script>
 </body>
 
