+  <script>
+    const hero = document.querySelector('.hero');
+    const video = document.getElementById('roasting-video');
+    const mainSlot = document.getElementById('main-video-slot');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const theaterToggle = document.getElementById('theater-toggle');
+    const exitTheater = document.getElementById('exit-theater');
+
+    function setTheaterMode(enabled) {
+      const destination = enabled ? heroSlot : mainSlot;
+
+      if (video.parentElement !== destination) {
+        if (typeof destination.moveBefore === 'function') {
+          // Atomic reparenting keeps the live iframe and its playback state intact.
+          destination.moveBefore(video, null);
+        } else {
+          // Legacy fallback: functional reparenting, but the iframe may reload.
+          destination.insertBefore(video, null);
+        }
+      }
+
+      hero.classList.toggle('is-theater', enabled);
+      theaterToggle.setAttribute('aria-pressed', String(enabled));
+      exitTheater.hidden = !enabled;
+    }
+
+    theaterToggle.addEventListener('click', () => {
+      setTheaterMode(video.parentElement !== heroSlot);
+    });
+
+    exitTheater.addEventListener('click', () => {
+      setTheaterMode(false);
+      theaterToggle.focus({ preventScroll: true });
+    });
+  </script>
