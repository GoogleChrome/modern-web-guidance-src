+  <script>
+    (function () {
+      var player = document.getElementById('roasting-player');
+      var mainSlot = document.getElementById('main-video-slot');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var hero = document.querySelector('.hero');
+      var toggle = document.getElementById('theater-toggle');
+      var exit = document.getElementById('exit-theater');
+      var theater = false;
+      var canMove = typeof heroSlot.moveBefore === 'function';
+
+      function positionFallback() {
+        if (canMove || !theater) return;
+        // Older browsers reload reparented iframes. Keep this one connected
+        // to its original parent and align it with the hero's reserved slot.
+        var rect = heroSlot.getBoundingClientRect();
+        player.style.position = 'fixed';
+        player.style.top = rect.top + 'px';
+        player.style.left = rect.left + 'px';
+        player.style.width = rect.width + 'px';
+        player.style.height = rect.height + 'px';
+        player.style.zIndex = '10';
+      }
+
+      function setTheater(enabled) {
+        theater = enabled;
+        hero.classList.toggle('is-theater', theater);
+        heroSlot.hidden = !theater;
+        mainSlot.classList.toggle('is-empty', theater);
+        exit.hidden = !theater;
+        toggle.setAttribute('aria-pressed', String(theater));
+        toggle.textContent = theater ? 'Exit theater mode' : 'Theater mode';
+
+        if (canMove) {
+          // Atomic moves preserve the browsing context, playback and focus.
+          (theater ? heroSlot : mainSlot).moveBefore(player, null);
+        } else if (theater) {
+          positionFallback();
+        } else {
+          player.removeAttribute('style');
+        }
+      }
+
+      toggle.addEventListener('click', function () { setTheater(!theater); });
+      exit.addEventListener('click', function () {
+        setTheater(false);
+        toggle.focus();
+      });
+      window.addEventListener('resize', positionFallback);
+      window.addEventListener('scroll', positionFallback, true);
+      if (!canMove && typeof ResizeObserver === 'function') {
+        new ResizeObserver(positionFallback).observe(heroSlot);
+      }
+    }());
+  </script>
+
