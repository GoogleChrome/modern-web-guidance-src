+      font-weight: bold;
+      line-height: 1.3;
+      text-align: center;
+      isolation: isolate;
+      /* Keep a stacking context at rest and reserve transform for hover. */
+      transform: scale(1);
+      transition: transform 0.3s ease;
+      animation: promo-spin 12s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+    }
+
+    .target:hover {
+      transform: scale(1.15);
+    }
+
+    /* Independent properties let both animations and the transition coexist. */
+    @keyframes promo-spin {
+      from { rotate: 0deg; }
+      to { rotate: 360deg; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -18px 0; }
+      to { translate: 18px 0; }
+    }
