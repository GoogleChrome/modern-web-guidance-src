--- a/index.html
+++ b/index.html
@@ -119,8 +119,58 @@
       margin-bottom: 10px;
       color: var(--primary);
     }
 
+    .seasonal-promo {
+      display: flex;
+      justify-content: center;
+      padding: 28px 24px;
+    }
+
+    .target {
+      display: grid;
+      place-content: center;
+      width: 112px;
+      height: 112px;
+      border: 2px dashed var(--primary);
+      border-radius: 50%;
+      background: var(--accent);
+      color: var(--text);
+      font-size: 0.9rem;
+      font-weight: bold;
+      line-height: 1.3;
+      text-align: center;
+      text-decoration: none;
+      /* An identity scale creates a stacking context even before hover. */
+      scale: 1;
+      transition: scale 250ms ease;
+      /* Separate properties let both animations and the transition compose. */
+      animation: promo-spin 12s linear infinite,
+        promo-slide 3s ease-in-out infinite alternate;
+    }
+
+    .target:hover,
+    .target:focus-visible {
+      scale: 1.12;
+    }
+
+    @keyframes promo-spin {
+      from { rotate: 0turn; }
+      to { rotate: 1turn; }
+    }
+
+    @keyframes promo-slide {
+      from { translate: -20px 0; }
+      to { translate: 20px 0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .target {
+        animation: none;
+        transition: none;
+      }
+    }
+
     .btn {
       display: inline-block;
       background: var(--primary);
       color: white;
