+
+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const roastValue = document.getElementById('roast-value');
+    const progress = document.getElementById('setup-progress');
+    const status = document.getElementById('save-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastValue.value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      roast.style.setProperty('--range-fill', `${(Number(roast.value) - 1) / 4 * 100}%`);
+      const completed = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked'))) + 1;
+      progress.value = completed;
+      progress.textContent = `${Math.round(completed / 3 * 100)}%`;
+      document.getElementById('progress-text').textContent = `${Math.round(completed / 3 * 100)}% complete`;
+      document.getElementById('progress-help').textContent = `${completed} of 3 ready: email, delivery frequency, and roast preference.`;
+    }
+
+    form.addEventListener('input', () => {
+      status.textContent = '';
+      updateSetup();
+    });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const preferences = {
+        email: email.value.trim(),
+        frequency: new FormData(form).get('frequency'),
+        roast: Number(roast.value),
+        emailUpdates: document.getElementById('email-updates').checked
+      };
+      try {
+        localStorage.setItem('daily-grind-subscription-preferences', JSON.stringify(preferences));
+        status.textContent = 'Your preferences are saved on this device. Your next cup is one step closer.';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please allow local storage and try again.';
+      }
+    });
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-subscription-preferences'));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.email === 'string') email.value = saved.email;
+        if (['weekly', 'fortnightly', 'monthly'].includes(saved.frequency)) {
+          form.querySelector(`input[name="frequency"][value="${saved.frequency}"]`).checked = true;
+        }
+        if (Number.isInteger(saved.roast) && saved.roast >= 1 && saved.roast <= 5) roast.value = saved.roast;
+        document.getElementById('email-updates').checked = saved.emailUpdates === true;
+      }
+    } catch {
+      // Keep the form usable when storage is unavailable or contains invalid data.
+    }
+    updateSetup();
+  </script>
+
