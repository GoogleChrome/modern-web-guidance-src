+<script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast');
+    const progress = document.getElementById('setup-progress');
+    const status = document.getElementById('form-status');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      document.getElementById('roast-value').value = roastName;
+      roast.setAttribute('aria-valuetext', roastName);
+      roast.style.setProperty('--roast-fill', `${(Number(roast.value) - 1) * 25}%`);
+      const completed = Number(email.value.trim() !== '' && email.validity.valid)
+        + Number(Boolean(form.querySelector('input[name="frequency"]:checked'))) + 1;
+      progress.value = completed;
+      progress.textContent = `${completed} of 3 complete`;
+      document.getElementById('completion-value').value = `${Math.round(completed / 3 * 100)}% complete`;
+    }
+
+    form.addEventListener('input', () => {
+      status.textContent = '';
+      updateSetup();
+    });
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const preferences = {
+        email: email.value.trim(),
+        frequency: new FormData(form).get('frequency'),
+        roast: Number(roast.value),
+        emailUpdates: document.getElementById('email-updates').checked
+      };
+      try {
+        localStorage.setItem('daily-grind-preferences', JSON.stringify(preferences));
+        status.textContent = 'Your coffee preferences are saved in this browser. Your subscription has not started.';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please allow local storage and try again.';
+      }
+    });
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-preferences'));
+      if (saved && typeof saved === 'object') {
+        email.value = typeof saved.email === 'string' ? saved.email : '';
+        const frequency = Array.from(form.querySelectorAll('input[name="frequency"]')).find(input => input.value === saved.frequency);
+        if (frequency) frequency.checked = true;
+        if (Number.isInteger(saved.roast) && saved.roast >= 1 && saved.roast <= 5) roast.value = saved.roast;
+        document.getElementById('email-updates').checked = saved.emailUpdates === true;
+      }
+    } catch {
+      // The form remains usable when storage is unavailable.
+    }
+    updateSetup();
+  </script>
 </body>
 
