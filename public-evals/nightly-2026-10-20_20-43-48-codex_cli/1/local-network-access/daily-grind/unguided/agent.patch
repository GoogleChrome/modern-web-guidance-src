new file mode 100644
index 0000000..d29db8c
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,16 @@
+import statikk from 'statikk';
+import { fileURLToPath } from 'node:url';
+
+const { url } = await statikk({
+  root: fileURLToPath(new URL('.', import.meta.url)),
+  port: Number(process.env.PORT || 11222),
+  setHeaders(response) {
+    // Include the legacy directive for browsers predating the split permissions.
+    response.setHeader(
+      'Permissions-Policy',
+      'local-network=(self), loopback-network=(self), local-network-access=(self)',
+    );
+  },
+});
+
+console.log(`Serving The Daily Grind at ${url}`);
