diff --git a/local-network.js b/local-network.js
new file mode 100644
index 0000000..25f4ad8
--- /dev/null
+++ b/local-network.js
@@ -0,0 +1,110 @@
+const form = document.querySelector('#connection-form');
+const space = document.querySelector('#connection-space');
+const endpoint = document.querySelector('#connection-url');
+const button = document.querySelector('#connection-submit');
+const status = document.querySelector('#connection-status');
+const result = document.querySelector('#connection-result');
+const permissions = new Map();
+const blockedMessage = 'Access is blocked. Open browser site settings, allow Local network or Loopback network access for this site, then connect again.';
+
+function showPermission(state) {
+  status.textContent = state === 'denied' ? blockedMessage
+    : state === 'granted' ? 'Permission granted. Enter a resource URL and connect.'
+      : 'Ready. Choose a service and connect to request access.';
+}
+
+async function checkPermission(targetSpace) {
+  if (!navigator.permissions?.query) return 'prompt';
+  const name = `${targetSpace}-network`;
+  try {
+    if (!permissions.has(name)) {
+      const permission = await navigator.permissions.query({ name });
+      permissions.set(name, permission);
+      permission.addEventListener('change', () => {
+        if (space.value === targetSpace) showPermission(permission.state);
+      });
+    }
+    return permissions.get(name).state;
+  } catch {
+    // Unsupported permission names still allow a user-initiated attempt.
+    return 'prompt';
+  }
+}
+
+async function refreshPermission() {
+  if (!window.isSecureContext) {
+    status.textContent = 'Open this page over HTTPS to connect to local services (localhost is supported for development).';
+    button.disabled = true;
+    return;
+  }
+  const targetSpace = space.value;
+  const state = await checkPermission(targetSpace);
+  if (space.value === targetSpace) showPermission(state);
+}
+
+space.addEventListener('change', () => {
+  endpoint.placeholder = space.value === 'loopback'
+    ? 'http://localhost:8080/status' : 'http://device.local:8080/status';
+  result.hidden = true;
+  void refreshPermission();
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (!window.isSecureContext || button.disabled) return;
+
+  let url;
+  try {
+    url = new URL(endpoint.value);
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
+      throw new Error('Invalid URL');
+    }
+  } catch {
+    status.textContent = 'Enter a valid HTTP or HTTPS URL without a username or password.';
+    return;
+  }
+
+  const targetSpace = space.value;
+  button.disabled = true;
+  space.disabled = true;
+  result.hidden = true;
+  result.textContent = '';
+
+  try {
+    if (await checkPermission(targetSpace) === 'denied') {
+      status.textContent = blockedMessage;
+      return;
+    }
+    status.textContent = 'Connecting… Allow access if your browser asks.';
+    const response = await fetch(url.href, {
+      method: 'GET',
+      mode: 'cors',
+      credentials: 'omit',
+      redirect: 'error',
+      targetAddressSpace: targetSpace,
+      signal: AbortSignal.timeout(30000),
+    });
+    if (!response.ok) {
+      status.textContent = `The service responded with HTTP ${response.status}. Check the resource URL and try again.`;
+      return;
+    }
+    const text = await response.text();
+    result.textContent = text || '(Empty response)';
+    result.hidden = false;
+    status.textContent = 'Connected. Response received from the service.';
+  } catch (error) {
+    if (await checkPermission(targetSpace) === 'denied') {
+      status.textContent = blockedMessage;
+    } else if (error.name === 'TimeoutError') {
+      status.textContent = 'Connection timed out. Check the service address and that the device or companion app is running, then try again.';
+    } else {
+      status.textContent = 'Could not connect. Check that the service is running, the device is on your network, and browser site settings allow access. The service must allow this site through CORS. Your browser may require HTTPS for the service.';
+    }
+  } finally {
+    button.disabled = false;
+    space.disabled = false;
+  }
+});
+
+// Check permission only; network requests wait for an explicit form submission.
+void refreshPermission();
