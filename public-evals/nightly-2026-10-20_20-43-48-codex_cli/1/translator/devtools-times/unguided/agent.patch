+        <div className="translate-toolbar"><span><span className="privacy-icon">♧</span>Your words, handled with care.</span><div><span className="shortcut">Ctrl + Enter</span><button className="primary-button" disabled={!text.trim() || bytes > 500 || loading} onClick={translate}>{loading ? 'Translating…' : 'Translate text'}<ArrowRightIcon /></button></div></div>
