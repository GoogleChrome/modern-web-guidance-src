+type Entry = { id: string; source: string; target: string; text: string; translation: string; date: string; saved?: boolean };
+const initialHistory: Entry[] = [
+  { id: 'welcome', source: 'en', target: 'fr', text: 'The best journeys answer questions that, in the beginning, you didn’t even think to ask.', translation: 'Les plus beaux voyages répondent à des questions que vous ne pensiez même pas à poser au départ.', date: 'Example' },
+  { id: 'coffee', source: 'en', target: 'es', text: 'A coffee and a little conversation, please.', translation: 'Un café y un poco de conversación, por favor.', date: 'Example' },
+  { id: 'hello', source: 'en', target: 'ja', text: 'Hello! It’s so nice to meet you.', translation: 'こんにちは！お会いできてうれしいです。', date: 'Example' },
