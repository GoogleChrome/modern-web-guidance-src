+import type { APIRoute } from 'astro';
+const languages = new Set(['en', 'fr', 'es', 'de', 'it', 'pt', 'ja', 'ko', 'zh', 'ar', 'hi', 'nl']);
+export const POST: APIRoute = async ({ request }) => {
+  try {
+    const { text, source, target } = await request.json();
+    if (typeof text !== 'string' || !text.trim() || new TextEncoder().encode(text).length > 500 || !languages.has(source) || !languages.has(target)) {
+      return Response.json({ error: 'Enter text up to 500 bytes and choose supported languages.' }, { status: 400 });
+    }
+    if (source === target) return Response.json({ translation: text });
+    const params = new URLSearchParams({ q: text, langpair: `${source}|${target}` });
+    const result = await fetch(`https://api.mymemory.translated.net/get?${params}`, { signal: AbortSignal.timeout(15000) });
+    if (!result.ok) throw new Error('Service unavailable');
+    const data = await result.json();
+    if (Number(data.responseStatus) !== 200 || !data.responseData?.translatedText) throw new Error('Service unavailable');
+    return Response.json({ translation: data.responseData.translatedText });
+  } catch {
+    return Response.json({ error: 'Translation is unavailable right now. Please try again in a moment.' }, { status: 503 });
+  }
+};
