+    finally { if (id === requestId.current) setLoading(false); }
+  }
+  function speak(value: string, lang: string) {
+    if (!value) return;
+    if (!('speechSynthesis' in window)) { setToast('Audio playback is unavailable in this browser.'); return; }
+    speechSynthesis.cancel(); const utterance = new SpeechSynthesisUtterance(value); utterance.lang = lang; utterance.onerror = () => setToast('Audio is unavailable for this language.'); speechSynthesis.speak(utterance);
