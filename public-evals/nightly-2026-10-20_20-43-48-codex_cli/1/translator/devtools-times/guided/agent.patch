diff --git a/src/components/TextTranslator.tsx b/src/components/TextTranslator.tsx
new file mode 100644
index 0000000..95f433d
--- /dev/null
+++ b/src/components/TextTranslator.tsx
@@ -0,0 +1,151 @@
+import { useEffect, useRef, useState } from 'react';
+import { getTranslatorAPI, languages, translateText, type Availability } from '../utils/translator';
+
+const control = 'rounded border border-gray-300 bg-white px-3 py-2 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-800 disabled:opacity-50';
+const MAX_LENGTH = 5000;
+
+export default function TextTranslator() {
+  const [source, setSource] = useState('en');
+  const [target, setTarget] = useState('es');
+  const [text, setText] = useState('');
+  const [result, setResult] = useState('');
+  const [availability, setAvailability] = useState<Availability | 'checking' | 'unsupported' | 'error'>('checking');
+  const [busy, setBusy] = useState(false);
+  const [progress, setProgress] = useState<number | null>(null);
+  const [message, setMessage] = useState('');
+  const request = useRef<AbortController | null>(null);
+  const input = useRef<HTMLTextAreaElement>(null);
+
+  useEffect(() => {
+    let active = true;
+    setAvailability('checking');
+    const api = getTranslatorAPI();
+    if (!api) setAvailability('unsupported');
+    else if (source === target) setAvailability('available');
+    else api.availability({ sourceLanguage: source, targetLanguage: target })
+      .then(value => { if (active) setAvailability(value); })
+      .catch(() => { if (active) setAvailability('error'); });
+    return () => { active = false; };
+  }, [source, target]);
+
+  useEffect(() => () => { request.current?.abort(); }, []);
+
+  function reset() {
+    request.current?.abort();
+    request.current = null;
+    setBusy(false);
+    setProgress(null);
+    setResult('');
+    setMessage('');
+  }
+
+  async function translate(event: React.FormEvent) {
+    event.preventDefault();
+    if (busy || !text.trim() || text.length > MAX_LENGTH) return;
+    setResult('');
+    setMessage('');
+    if (source === target) {
+      setResult(text);
+      setMessage('The languages match. Your text is ready to copy.');
+      return;
+    }
+    const api = getTranslatorAPI();
+    if (!api || !['available', 'downloadable', 'downloading'].includes(availability)) return;
+    const controller = new AbortController();
+    request.current = controller;
+    setBusy(true);
+    setProgress(null);
+    try {
+      const translated = await translateText(api, { sourceLanguage: source, targetLanguage: target }, text, controller.signal, setProgress);
+      if (!controller.signal.aborted) {
+        setResult(translated);
+        setMessage('Translation ready.');
+      }
+    } catch {
+      if (!controller.signal.aborted) setMessage('Translation failed. Check your connection if a language pack needs downloading, then try again.');
+    } finally {
+      if (request.current === controller) {
+        request.current = null;
+        setBusy(false);
+        setProgress(null);
+      }
+    }
+  }
+
+  async function copy() {
+    try {
+      await navigator.clipboard.writeText(result);
+      setMessage('Translation copied.');
+    } catch {
+      setMessage('Could not access the clipboard. Select and copy the translation manually.');
+    }
+  }
+
+  const unavailable = ['unsupported', 'unavailable', 'error', 'checking'].includes(availability);
+  const notice = {
+    unsupported: 'On-device translation is not supported in this browser. Try desktop Chrome or Edge with the Translator API enabled.',
+    unavailable: 'This language pair is unavailable on your device. Choose different languages.',
+    error: 'Could not check translation availability. Try changing languages or reloading the page.',
+    checking: 'Checking language availability…',
+    downloadable: 'The first translation downloads a language pack. This may take a few moments and requires an internet connection.',
+    downloading: 'A language pack is downloading. Select Translate to continue.',
+    available: 'Ready to translate on your device.',
+  }[availability];
+
+  return (
+    <form onSubmit={translate} className="space-y-5">
+      <div className="flex flex-wrap items-end gap-3">
+        <div className="flex-1 min-w-40">
+          <label htmlFor="source-language" className="block text-sm font-semibold mb-2">From</label>
+          <select id="source-language" value={source} disabled={busy} onChange={e => { reset(); setAvailability('checking'); setSource(e.target.value); }} className={`${control} w-full`}>
+            {languages.map(([code, name]) => <option key={code} value={code}>{name}</option>)}
+          </select>
+        </div>
+        <button type="button" disabled={busy || source === target} className={control} onClick={() => {
+          const previousResult = result;
+          reset();
+          setAvailability('checking');
+          setSource(target);
+          setTarget(source);
+          setText(previousResult || text);
+        }}>Swap languages <span aria-hidden="true">⇄</span></button>
+        <div className="flex-1 min-w-40">
+          <label htmlFor="target-language" className="block text-sm font-semibold mb-2">To</label>
+          <select id="target-language" value={target} disabled={busy} onChange={e => { reset(); setAvailability('checking'); setTarget(e.target.value); }} className={`${control} w-full`}>
+            {languages.map(([code, name]) => <option key={code} value={code}>{name}</option>)}
+          </select>
+        </div>
+      </div>
+
+      <div className="grid md:grid-cols-2 border border-gray-300 rounded overflow-hidden">
+        <div className="p-4 md:p-5">
+          <label htmlFor="translation-source" className="block text-sm font-semibold mb-3">Original text</label>
+          <textarea ref={input} id="translation-source" lang={source} dir="auto" value={text} maxLength={MAX_LENGTH} required
+            aria-describedby="translation-limit" placeholder="Type or paste text here…"
+            onChange={e => { reset(); setText(e.target.value); }}
+            className={`${control} block w-full min-h-64 resize-y text-base leading-relaxed`} />
+          <p id="translation-limit" className="text-xs text-gray-500 mt-2">{text.length.toLocaleString()} / 5,000 characters</p>
+        </div>
+        <div className="bg-gray-50 p-4 md:p-5 border-t md:border-t-0 md:border-l border-gray-300" aria-busy={busy}>
+          <label htmlFor="translation-result" className="block text-sm font-semibold mb-3">Translation</label>
+          <textarea id="translation-result" lang={target} dir="auto" readOnly value={result} placeholder="Your translation will appear here."
+            className={`${control} block w-full min-h-64 resize-y text-base leading-relaxed`} />
+          <button type="button" onClick={copy} disabled={!result || busy} className={`${control} mt-2`}>Copy translation</button>
+        </div>
+      </div>
+
+      <p className="text-sm text-gray-600" role="status">{notice}</p>
+      {busy && <div className="text-sm text-gray-600">
+        {progress !== null && progress < 100 ? <><label htmlFor="translation-download">Downloading language pack: {progress}%</label><progress id="translation-download" className="block w-full mt-2" max={100} value={progress} /></> : 'Translating…'}
+      </div>}
+      <div className="flex flex-wrap items-center gap-3">
+        <button type="submit" disabled={busy || !text.trim() || text.length > MAX_LENGTH || unavailable}
+          className="rounded bg-gray-800 px-5 py-2.5 text-sm font-semibold text-white hover:bg-gray-700 disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-800">{busy ? 'Translating…' : 'Translate'}</button>
+        <button type="button" className={control} onClick={() => { reset(); setText(''); input.current?.focus(); }}>Clear</button>
+        {busy && <button type="button" className={control} onClick={reset}>Cancel</button>}
+      </div>
+      <p role="status" className="text-sm text-gray-700 min-h-5">{message}</p>
+      <p className="text-xs text-gray-500 border-t border-gray-200 pt-4">Text is translated on your device. Language packs may need an initial download. Machine translations can contain mistakes.</p>
+    </form>
+  );
+}
