diff --git a/src/utils/translator.ts b/src/utils/translator.ts
new file mode 100644
index 0000000..4e81103
--- /dev/null
+++ b/src/utils/translator.ts
@@ -0,0 +1,58 @@
+export const languages = [
+  ['ar', 'Arabic'], ['bn', 'Bengali'], ['zh', 'Chinese (Simplified)'],
+  ['zh-Hant', 'Chinese (Traditional)'], ['nl', 'Dutch'], ['en', 'English'],
+  ['fr', 'French'], ['de', 'German'], ['el', 'Greek'], ['he', 'Hebrew'],
+  ['hi', 'Hindi'], ['id', 'Indonesian'], ['it', 'Italian'], ['ja', 'Japanese'],
+  ['ko', 'Korean'], ['pl', 'Polish'], ['pt', 'Portuguese'], ['ru', 'Russian'],
+  ['es', 'Spanish'], ['sv', 'Swedish'], ['th', 'Thai'], ['tr', 'Turkish'],
+  ['uk', 'Ukrainian'], ['vi', 'Vietnamese'],
+] as const;
+
+export interface LanguagePair {
+  sourceLanguage: string;
+  targetLanguage: string;
+}
+
+export type Availability = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+
+export interface TranslatorSession {
+  translate(text: string, options?: { signal: AbortSignal }): Promise<string>;
+  destroy(): void;
+}
+
+export interface TranslatorAPI {
+  availability(options: LanguagePair): Promise<Availability>;
+  create(options: LanguagePair & {
+    signal: AbortSignal;
+    monitor(monitor: { addEventListener(type: 'downloadprogress', listener: (event: { loaded: number }) => void): void }): void;
+  }): Promise<TranslatorSession>;
+}
+
+export function getTranslatorAPI(): TranslatorAPI | undefined {
+  return (globalThis as typeof globalThis & { Translator?: TranslatorAPI }).Translator;
+}
+
+// Called directly from the submit gesture after a separate availability check.
+export async function translateText(
+  api: TranslatorAPI,
+  pair: LanguagePair,
+  text: string,
+  signal: AbortSignal,
+  onProgress: (percent: number) => void,
+): Promise<string> {
+  const session = await api.create({
+    ...pair,
+    signal,
+    monitor(monitor) {
+      monitor.addEventListener('downloadprogress', ({ loaded }) => {
+        if (!signal.aborted) onProgress(Math.round(Math.max(0, Math.min(1, loaded)) * 100));
+      });
+    },
+  });
+  try {
+    signal.throwIfAborted();
+    return await session.translate(text, { signal });
+  } finally {
+    session.destroy();
+  }
+}
diff --git a/tests/translator.test.mjs b/tests/translator.test.mjs
new file mode 100644
index 0000000..97306aa
--- /dev/null
+++ b/tests/translator.test.mjs
@@ -0,0 +1,67 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { getTranslatorAPI, translateText } from '../src/utils/translator.ts';
+
+const pair = { sourceLanguage: 'en', targetLanguage: 'es' };
+
+test('unsupported environments return no translator', () => {
+  assert.equal(getTranslatorAPI(), undefined);
+});
+
+test('translates with the selected pair, reports progress, and releases the model', async () => {
+  const controller = new AbortController();
+  const progress = [];
+  let destroyed = false;
+  const api = {
+    async create(options) {
+      assert.equal(options.sourceLanguage, 'en');
+      assert.equal(options.targetLanguage, 'es');
+      assert.equal(options.signal, controller.signal);
+      options.monitor({ addEventListener(type, listener) {
+        assert.equal(type, 'downloadprogress');
+        listener({ loaded: 0.425 });
+        listener({ loaded: 1 });
+      } });
+      return {
+        async translate(text, { signal }) {
+          assert.equal(text, 'Hello');
+          assert.equal(signal, controller.signal);
+          return 'Hola';
+        },
+        destroy() { destroyed = true; },
+      };
+    },
+  };
+  assert.equal(await translateText(api, pair, 'Hello', controller.signal, value => progress.push(value)), 'Hola');
+  assert.deepEqual(progress, [43, 100]);
+  assert.equal(destroyed, true);
+});
+
+test('translation errors release the model and propagate to the UI', async () => {
+  let destroyed = false;
+  const api = { async create() { return {
+    async translate() { throw new Error('Model failed'); },
+    destroy() { destroyed = true; },
+  }; } };
+  await assert.rejects(translateText(api, pair, 'Hello', new AbortController().signal, () => {}), /Model failed/);
+  assert.equal(destroyed, true);
+});
+
+test('cancellation during model creation prevents translation and releases the model', async () => {
+  const controller = new AbortController();
+  let destroyed = false;
+  const api = { async create() {
+    controller.abort();
+    return {
+      async translate() { assert.fail('Cancelled requests must not translate'); },
+      destroy() { destroyed = true; },
+    };
+  } };
+  await assert.rejects(translateText(api, pair, 'Hello', controller.signal, () => {}), { name: 'AbortError' });
+  assert.equal(destroyed, true);
+});
+
+test('model download failures propagate without attempting translation', async () => {
+  const api = { async create() { throw new Error('Download failed'); } };
+  await assert.rejects(translateText(api, pair, 'Hello', new AbortController().signal, () => {}), /Download failed/);
+});
