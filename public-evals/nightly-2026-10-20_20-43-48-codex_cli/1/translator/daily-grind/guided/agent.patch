diff --git a/translator.css b/translator.css
new file mode 100644
index 0000000..a6f907b
--- /dev/null
+++ b/translator.css
@@ -0,0 +1,43 @@
+.translator {
+  margin-block-start: 48px;
+  padding: clamp(20px, 4vw, 36px);
+  background: white;
+  border: 1px solid var(--secondary);
+  border-radius: 8px;
+  scroll-margin-top: 100px;
+}
+.translator > p { margin-block: 8px 24px; }
+.language-controls, .translation-panels { display: grid; gap: 20px; }
+.language-controls { grid-template-columns: 1fr auto 1fr; align-items: end; margin-block-end: 20px; }
+.translation-panels { grid-template-columns: 1fr 1fr; }
+.translation-field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
+.translation-field label { font-weight: 600; }
+.translator select, .translator textarea, .translator button { font: inherit; }
+.translator select, .translator textarea {
+  width: 100%;
+  padding: 12px;
+  border: 1px solid #998882;
+  border-radius: 5px;
+  background: var(--light);
+  color: var(--text);
+}
+.translator textarea { resize: vertical; min-height: 150px; }
+.translator button { cursor: pointer; min-height: 48px; }
+.translator .btn { margin: 0; border: 1px solid var(--primary); }
+.secondary-btn { padding: 10px 16px; border: 1px solid #998882; border-radius: 5px; color: var(--primary); background: white; }
+.secondary-btn:hover { background: #f1ece9; }
+.translator button:disabled { opacity: .55; cursor: default; }
+.translator :focus-visible { outline: 3px solid #a75b00; outline-offset: 3px; }
+.translation-field small, .translation-note { font-size: .85rem; }
+.translation-note { margin-block: 20px; }
+.translation-actions { display: flex; gap: 12px; }
+#copy-translation { align-self: flex-start; }
+#translation-status { min-height: 1.6em; margin-block-start: 12px; }
+#translation-status[data-error="true"] { color: #a32319; }
+@media (max-width: 700px) {
+  nav { flex-wrap: wrap; gap: 12px; }
+  nav ul { flex-wrap: wrap; gap: 12px; }
+  nav ul li { margin: 0; }
+  .translation-panels, .language-controls { grid-template-columns: 1fr; }
+  #swap-languages { justify-self: start; }
+}
diff --git a/translator.js b/translator.js
new file mode 100644
index 0000000..8f90ae3
--- /dev/null
+++ b/translator.js
@@ -0,0 +1,129 @@
+(() => {
+  'use strict';
+  const form = document.getElementById('translation-form');
+  const source = document.getElementById('source-language');
+  const target = document.getElementById('target-language');
+  const input = document.getElementById('source-text');
+  const output = document.getElementById('translated-text');
+  const submit = document.getElementById('translate-button');
+  const copy = document.getElementById('copy-translation');
+  const status = document.getElementById('translation-status');
+  const limit = document.getElementById('translation-limit');
+  let activeRequest = null;
+  let revision = 0;
+
+  function announce(message, error = false) {
+    status.textContent = message;
+    status.dataset.error = String(error);
+  }
+
+  function updateInput() {
+    const bytes = new TextEncoder().encode(input.value).length;
+    limit.textContent = `${bytes} / 500 UTF-8 bytes`;
+    input.setCustomValidity(bytes > 500 ? 'Please shorten your text to 500 UTF-8 bytes.' :
+      input.value && !input.value.trim() ? 'Please enter text to translate.' : '');
+    input.lang = source.value;
+    output.lang = target.value;
+  }
+
+  function invalidate() {
+    revision++;
+    if (activeRequest) activeRequest.abort();
+    activeRequest = null;
+    submit.disabled = false;
+    submit.textContent = 'Translate';
+    output.value = '';
+    copy.disabled = true;
+    form.setAttribute('aria-busy', 'false');
+    announce('');
+    updateInput();
+  }
+
+  input.addEventListener('input', invalidate);
+  source.addEventListener('change', invalidate);
+  target.addEventListener('change', invalidate);
+
+  document.getElementById('swap-languages').addEventListener('click', () => {
+    const previousOutput = output.value;
+    [source.value, target.value] = [target.value, source.value];
+    if (previousOutput) input.value = previousOutput;
+    invalidate();
+  });
+
+  document.getElementById('clear-translation').addEventListener('click', () => {
+    input.value = '';
+    invalidate();
+    input.focus();
+  });
+
+  copy.addEventListener('click', async () => {
+    const currentRevision = revision;
+    try {
+      await navigator.clipboard.writeText(output.value);
+      if (currentRevision === revision) announce('Translation copied.');
+    } catch {
+      if (currentRevision !== revision) return;
+      output.focus();
+      output.select();
+      announce('Copy is unavailable. The translation is selected so you can copy it manually.');
+    }
+  });
+
+  form.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    invalidate();
+    if (!form.reportValidity()) return;
+    if (source.value === target.value) {
+      output.value = input.value;
+      copy.disabled = false;
+      announce('Both languages are the same. Your text is ready to copy.');
+      return;
+    }
+
+    const currentRevision = revision;
+    const controller = new AbortController();
+    activeRequest = controller;
+    const timeout = setTimeout(() => controller.abort(), 15000);
+    submit.disabled = true;
+    submit.textContent = 'Translating…';
+    form.setAttribute('aria-busy', 'true');
+    announce('Translating…');
+    try {
+      const params = new URLSearchParams({ q: input.value.trim(), langpair: `${source.value}|${target.value}` });
+      const response = await fetch(`https://api.mymemory.translated.net/get?${params}`, {
+        signal: controller.signal,
+        credentials: 'omit',
+        referrerPolicy: 'no-referrer'
+      });
+      if (!response.ok) throw new Error('service');
+      const data = await response.json();
+      if (currentRevision !== revision) return;
+      if (Number(data.responseStatus) === 429 || data.quotaFinished) {
+        announce('The translation service’s free limit has been reached. Please try again later.', true);
+        return;
+      }
+      if (Number(data.responseStatus) !== 200 || typeof data.responseData?.translatedText !== 'string' || !data.responseData.translatedText.trim()) {
+        throw new Error('service');
+      }
+      // Decode entities without interpreting literal markup or creating resources.
+      const decoded = document.createElement('textarea');
+      decoded.innerHTML = data.responseData.translatedText.replace(/</g, '&lt;').replace(/>/g, '&gt;');
+      output.value = decoded.value;
+      copy.disabled = false;
+      announce('Translation ready.');
+    } catch (error) {
+      if (currentRevision !== revision) return;
+      announce(error.name === 'AbortError' ? 'Translation timed out. Please try again.' :
+        'Unable to translate right now. Check your connection and try again.', true);
+    } finally {
+      clearTimeout(timeout);
+      if (currentRevision === revision) {
+        activeRequest = null;
+        submit.disabled = false;
+        submit.textContent = 'Translate';
+        form.setAttribute('aria-busy', 'false');
+      }
+    }
+  });
+  updateInput();
+})();
diff --git a/translator.test.cjs b/translator.test.cjs
new file mode 100644
index 0000000..95014fc
--- /dev/null
+++ b/translator.test.cjs
@@ -0,0 +1,141 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const code = readFileSync(`${__dirname}/translator.js`, 'utf8');
+
+function setup(fetchImplementation) {
+  const elements = new Map();
+  function element(id) {
+    if (!elements.has(id)) elements.set(id, {
+      value: '', disabled: false, dataset: {}, handlers: {},
+      addEventListener(name, callback) { this.handlers[name] = callback; },
+      setAttribute(name, value) { this[name] = value; },
+      setCustomValidity(value) { this.validationMessage = value; },
+      focus() { this.focused = true; },
+      select() { this.selected = true; }
+    });
+    return elements.get(id);
+  }
+  element('source-language').value = 'en';
+  element('target-language').value = 'es';
+  element('translation-form').reportValidity = () =>
+    Boolean(element('source-text').value) && !element('source-text').validationMessage;
+  const calls = [];
+  const clipboard = { writeText: async (text) => { clipboard.text = text; } };
+  runInNewContext(code, {
+    document: {
+      getElementById: element,
+      createElement: () => ({
+        set innerHTML(html) {
+          this.value = html.replace(/&(amp|lt|gt|quot|#39);/g, (_, entity) =>
+            ({ amp: '&', lt: '<', gt: '>', quot: '"', '#39': "'" })[entity]);
+        }
+      })
+    },
+    fetch: async (...args) => {
+      calls.push(args);
+      return fetchImplementation ? fetchImplementation(...args) : {
+        ok: true, json: async () => ({ responseStatus: 200, responseData: { translatedText: 'Hola' } })
+      };
+    },
+    navigator: { clipboard }, TextEncoder, URLSearchParams, AbortController, setTimeout, clearTimeout
+  });
+  const fire = (id, event) => element(id).handlers[event]({ preventDefault() {} });
+  const submit = (text = 'Hello') => {
+    element('source-text').value = text;
+    return fire('translation-form', 'submit');
+  };
+  return { element, fire, submit, calls, clipboard };
+}
+
+test('translates text using the chosen language pair and allows copying', async () => {
+  const app = setup();
+  await app.submit('Hello & welcome?');
+  const url = new URL(app.calls[0][0]);
+  assert.equal(url.searchParams.get('q'), 'Hello & welcome?');
+  assert.equal(url.searchParams.get('langpair'), 'en|es');
+  assert.equal(app.element('translated-text').value, 'Hola');
+  assert.equal(app.element('translate-button').disabled, false);
+  await app.fire('copy-translation', 'click');
+  assert.equal(app.clipboard.text, 'Hola');
+});
+
+test('blocks blank text and multibyte text exceeding the API limit', async () => {
+  const app = setup();
+  await app.submit('   ');
+  await app.submit('日'.repeat(167));
+  assert.equal(app.calls.length, 0);
+  assert.match(app.element('source-text').validationMessage, /500 UTF-8 bytes/);
+  assert.equal(app.element('translation-limit').textContent, '501 / 500 UTF-8 bytes');
+});
+
+test('same-language translation returns the original without a service request', async () => {
+  const app = setup();
+  app.element('target-language').value = 'en';
+  await app.submit();
+  assert.equal(app.element('translated-text').value, 'Hello');
+  assert.equal(app.calls.length, 0);
+});
+
+test('swap uses the translation as the new input and clear resets it', async () => {
+  const app = setup();
+  await app.submit();
+  app.fire('swap-languages', 'click');
+  assert.equal(app.element('source-language').value, 'es');
+  assert.equal(app.element('target-language').value, 'en');
+  assert.equal(app.element('source-text').value, 'Hola');
+  assert.equal(app.element('translated-text').value, '');
+  app.fire('clear-translation', 'click');
+  assert.equal(app.element('source-text').value, '');
+  assert.equal(app.element('source-text').focused, true);
+});
+
+test('input changes abort a request and prevent stale results from appearing', async () => {
+  let resolveRequest;
+  const app = setup(() => new Promise(resolve => { resolveRequest = resolve; }));
+  const pending = app.submit();
+  app.element('source-text').value = 'Goodbye';
+  app.fire('source-text', 'input');
+  assert.equal(app.calls[0][1].signal.aborted, true);
+  resolveRequest({ ok: true, json: async () => ({ responseStatus: 200, responseData: { translatedText: 'Hola' } }) });
+  await pending;
+  assert.equal(app.element('translated-text').value, '');
+  assert.equal(app.element('translation-status').textContent, '');
+});
+
+test('service, quota, invalid responses and timeout failures are recoverable', async () => {
+  const cases = [
+    [async () => { throw new Error('offline'); }, /Check your connection/],
+    [async () => ({ ok: false }), /Check your connection/],
+    [async () => ({ ok: true, json: async () => ({ responseStatus: 429, quotaFinished: true }) }), /free limit/],
+    [async () => ({ ok: true, json: async () => ({ responseStatus: 200, responseData: {} }) }), /Check your connection/],
+    [async () => { const error = new Error(); error.name = 'AbortError'; throw error; }, /timed out/]
+  ];
+  for (const [response, message] of cases) {
+    const app = setup(response);
+    await app.submit();
+    assert.match(app.element('translation-status').textContent, message);
+    assert.equal(app.element('translation-status').dataset.error, 'true');
+    assert.equal(app.element('translate-button').disabled, false);
+    assert.equal(app.element('translated-text').value, '');
+  }
+});
+
+test('copy failure selects the translation for manual copying', async () => {
+  const app = setup();
+  await app.submit();
+  app.clipboard.writeText = async () => { throw new Error('denied'); };
+  await app.fire('copy-translation', 'click');
+  assert.equal(app.element('translated-text').selected, true);
+  assert.match(app.element('translation-status').textContent, /copy it manually/);
+});
+
+test('translated entities are decoded while literal markup stays plain text', async () => {
+  const app = setup(async () => ({ ok: true, json: async () => ({
+    responseStatus: 200, responseData: { translatedText: '<img src=x> café &amp; thé' }
+  }) }));
+  await app.submit();
+  assert.equal(app.element('translated-text').value, '<img src=x> café & thé');
+});
