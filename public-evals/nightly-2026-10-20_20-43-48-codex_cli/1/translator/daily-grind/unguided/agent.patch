+      espressoDescription: 'Bold, smokey, and perfect for a morning boost.',
+      coldBrewTitle: 'Cold Brew', coldBrewDescription: 'Steeped for 18 hours for maximum smoothness.',
+      story: 'Our Story', careers: 'Join the Team', contact: 'Contact Us', privacy: 'Privacy',
+      copyright: '© 2026 The Daily Grind Coffee Co. All rights reserved.',
+      announcement: 'Website language changed to English.'
+    },
+    es: {
+      title: 'The Daily Grind | Café artesanal',
+      language: 'Idioma del sitio web', menu: 'Menú', locations: 'Locales', rewards: 'Recompensas',
+      account: 'Mi cuenta', logout: 'Cerrar sesión', heroTitle: 'Despierta tus sentidos',
+      heroDescription: 'De origen ético, tostado localmente, servido en tu taza.',
+      order: 'Pide ahora', seasonal: 'Favoritos de temporada', mapleTitle: 'Latte de avena y arce',
+      mapleDescription: 'Cremosa leche de avena con un toque de sirope de arce de Vermont.',
+      details: 'Ver detalles', espressoTitle: 'Espresso de tueste oscuro',
+      espressoDescription: 'Intenso, ahumado y perfecto para empezar la mañana con energía.',
+      coldBrewTitle: 'Café de extracción en frío', coldBrewDescription: 'Infusionado durante 18 horas para una suavidad máxima.',
+      story: 'Nuestra historia', careers: 'Únete al equipo', contact: 'Contáctanos', privacy: 'Privacidad',
+      copyright: '© 2026 The Daily Grind Coffee Co. Todos los derechos reservados.',
+      announcement: 'El idioma del sitio web se ha cambiado a español.'
+    },
+    fr: {
+      title: 'The Daily Grind | Café artisanal',
+      language: 'Langue du site', menu: 'Carte', locations: 'Nos cafés', rewards: 'Fidélité',
+      account: 'Mon compte', logout: 'Déconnexion', heroTitle: 'Éveillez vos sens',
+      heroDescription: 'Un café issu de sources éthiques, torréfié localement, servi dans votre tasse.',
+      order: 'Commander', seasonal: 'Les favoris de saison', mapleTitle: 'Latte à l’avoine et à l’érable',
+      mapleDescription: 'Un lait d’avoine onctueux avec une touche de sirop d’érable du Vermont.',
+      details: 'Voir les détails', espressoTitle: 'Espresso à torréfaction foncée',
+      espressoDescription: 'Intense et fumé, idéal pour faire le plein d’énergie le matin.',
+      coldBrewTitle: 'Café infusé à froid', coldBrewDescription: 'Infusé pendant 18 heures pour une douceur incomparable.',
+      story: 'Notre histoire', careers: 'Rejoindre l’équipe', contact: 'Nous contacter', privacy: 'Confidentialité',
+      copyright: '© 2026 The Daily Grind Coffee Co. Tous droits réservés.',
+      announcement: 'La langue du site est maintenant le français.'
+    },
+    de: {
+      title: 'The Daily Grind | Handwerklich gerösteter Kaffee',
+      language: 'Sprache der Website', menu: 'Karte', locations: 'Standorte', rewards: 'Treueprogramm',
+      account: 'Mein Konto', logout: 'Abmelden', heroTitle: 'Wecke deine Sinne',
+      heroDescription: 'Ethisch bezogen, lokal geröstet, direkt in deine Tasse.',
+      order: 'Jetzt bestellen', seasonal: 'Saisonale Lieblinge', mapleTitle: 'Ahorn-Hafer-Latte',
+      mapleDescription: 'Cremige Hafermilch mit einem Hauch Ahornsirup aus Vermont.',
+      details: 'Details ansehen', espressoTitle: 'Dunkel gerösteter Espresso',
+      espressoDescription: 'Kräftig, rauchig und perfekt für einen schwungvollen Start in den Tag.',
+      coldBrewTitle: 'Cold Brew', coldBrewDescription: '18 Stunden kalt gezogen für einen besonders milden Geschmack.',
+      story: 'Unsere Geschichte', careers: 'Komm ins Team', contact: 'Kontakt', privacy: 'Datenschutz',
+      copyright: '© 2026 The Daily Grind Coffee Co. Alle Rechte vorbehalten.',
+      announcement: 'Die Sprache der Website wurde auf Deutsch geändert.'
+    }
+  };
+
+  const storageKey = 'daily-grind-language';
+  const picker = document.getElementById('site-language');
+  const status = document.getElementById('translation-status');
+
+  function setLanguage(language, announce = false) {
+    const selected = Object.hasOwn(translations, language) ? language : 'en';
+    const copy = translations[selected];
+    document.querySelectorAll('[data-i18n]').forEach(element => {
+      const key = element.dataset.i18n;
+      if (Object.hasOwn(copy, key)) element.textContent = copy[key];
+    });
+    document.documentElement.lang = selected;
+    document.title = copy.title;
+    picker.value = selected;
+    if (announce) status.textContent = copy.announcement;
+    // Language switching still works when browser storage is unavailable.
+    try { localStorage.setItem(storageKey, selected); } catch {}
+  }
+
+  let savedLanguage = 'en';
+  try { savedLanguage = localStorage.getItem(storageKey) || 'en'; } catch {}
+  setLanguage(savedLanguage);
+  picker.addEventListener('change', event => setLanguage(event.target.value, true));
+})();
