+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+import { x25519 } from '@noble/curves/ed25519.js';
+const encoder = new TextEncoder();
+const algorithms = { hybrid: ml_kem768_x25519, quantum: ml_kem768 };
+export const toBase64 = bytes => btoa(String.fromCharCode(...bytes));
+export const fromBase64 = text => Uint8Array.from(atob(text), c => c.charCodeAt(0));
+export function generateKeys(mode) {
+  if (!['classical','hybrid','quantum'].includes(mode)) throw new Error('Unknown protection mode.');
+  return { mode, ... (mode === 'classical' ? x25519.keygen() : algorithms[mode].keygen()) };
+}
+async function derive(secret, salt, mode) {
+  const base = await crypto.subtle.importKey('raw', secret, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey({name:'HKDF',hash:'SHA-256',salt,info:encoder.encode(`cipher-envelope-v1:${mode}`)},base,{name:'AES-GCM',length:256},false,['encrypt','decrypt']);
+}
+function metadata(e) { return encoder.encode(JSON.stringify([e.version,e.mode,e.algorithm,e.capsule,e.salt,e.aad])); }
+export async function encrypt(keys, message, aad = '') {
+  let secret, capsule;
+  if (keys.mode === 'classical') {
+    const ephemeral = x25519.keygen();
+    secret = x25519.getSharedSecret(ephemeral.secretKey, keys.publicKey);
+    capsule = ephemeral.publicKey;
+    ephemeral.secretKey.fill(0);
+  } else {
+    const result = algorithms[keys.mode].encapsulate(keys.publicKey);
+    secret = result.sharedSecret;
+    capsule = result.cipherText;
+  }
+  const salt = crypto.getRandomValues(new Uint8Array(32));
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  let key;
+  try { key = await derive(secret,salt,keys.mode); } finally { secret.fill(0); }
+  const envelope = {version:1,mode:keys.mode,algorithm:'AES-256-GCM',capsule:toBase64(capsule),salt:toBase64(salt),iv:toBase64(iv),aad};
+  envelope.ciphertext = toBase64(new Uint8Array(await crypto.subtle.encrypt({name:'AES-GCM',iv,additionalData:metadata(envelope),tagLength:128},key,encoder.encode(message))));
+  return envelope;
+}
+export async function decrypt(keys, envelope) {
+  if (envelope.version !== 1 || envelope.mode !== keys.mode || envelope.algorithm !== 'AES-256-GCM' || typeof envelope.aad !== 'string') throw new Error('This envelope does not match the current session.');
+  const capsule = fromBase64(envelope.capsule), salt = fromBase64(envelope.salt), iv = fromBase64(envelope.iv);
+  if (iv.length !== 12 || salt.length !== 32) throw new Error('Invalid envelope.');
+  const secret = keys.mode === 'classical' ? x25519.getSharedSecret(keys.secretKey,capsule) : algorithms[keys.mode].decapsulate(capsule,keys.secretKey);
+  let key;
+  try { key = await derive(secret,salt,keys.mode); } finally { secret.fill(0); }
+  return new TextDecoder().decode(await crypto.subtle.decrypt({name:'AES-GCM',iv,additionalData:metadata(envelope),tagLength:128},key,fromBase64(envelope.ciphertext)));
+}
+export function destroyKeys(keys) { keys?.secretKey.fill(0); }
diff --git a/crypto.test.js b/crypto.test.js
new file mode 100644
index 0000000..7328bde
--- /dev/null
+++ b/crypto.test.js
@@ -0,0 +1,20 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {generateKeys,encrypt,decrypt,destroyKeys} from './crypto.js';
+for (const mode of ['classical','hybrid','quantum']) {
+  test(`${mode}: authenticates messages and rejects tampering and wrong keys`, async()=>{
+    const keys=generateKeys(mode);
+    const envelope=await encrypt(keys,'A private message 🔐','conversation-42');
+    assert.equal(await decrypt(keys,envelope),'A private message 🔐');
+    const second=await encrypt(keys,'A private message 🔐','conversation-42');
+    assert.notEqual(envelope.iv,second.iv);
+    assert.notEqual(envelope.capsule,second.capsule);
+    await assert.rejects(decrypt(keys,{...envelope,aad:'tampered'}));
+    const changed=Uint8Array.from(atob(envelope.ciphertext),c=>c.charCodeAt(0));changed[0]^=1;
+    await assert.rejects(decrypt(keys,{...envelope,ciphertext:btoa(String.fromCharCode(...changed))}));
+    const wrongKeys=generateKeys(mode);
+    await assert.rejects(decrypt(wrongKeys,envelope));
+    destroyKeys(wrongKeys);destroyKeys(keys);
+    assert.ok(keys.secretKey.every(byte=>byte===0));
+  });
+}
