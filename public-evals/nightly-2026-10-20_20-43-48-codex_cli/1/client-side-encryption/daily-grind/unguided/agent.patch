@@ -0,0 +1,53 @@
+import { x25519 } from '@noble/curves/ed25519.js';
+import { ml_kem768, ml_kem1024 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+
+const encoder = new TextEncoder();
+export const b64 = bytes => btoa(String.fromCharCode(...bytes));
+export const unb64 = value => Uint8Array.from(atob(value), c => c.charCodeAt(0));
+export const algorithms = { hybrid: 'X25519 + ML-KEM-768', classical: 'X25519', pq: 'ML-KEM-768', pq1024: 'ML-KEM-1024' };
+export async function establishSession(algorithm = 'hybrid', name = '') {
+  if (!Object.hasOwn(algorithms, algorithm)) throw new Error('Unknown algorithm');
+  const started = performance.now();
+  let sender, receiver, publicKey, ciphertext;
+  if (algorithm === 'classical') {
+    const alice = x25519.keygen(), bob = x25519.keygen();
+    sender = x25519.getSharedSecret(alice.secretKey, bob.publicKey);
+    receiver = x25519.getSharedSecret(bob.secretKey, alice.publicKey);
+    publicKey = alice.publicKey;
+    ciphertext = bob.publicKey;
+    alice.secretKey.fill(0); bob.secretKey.fill(0);
+  } else {
+    const kem = algorithm === 'hybrid' ? ml_kem768_x25519 : algorithm === 'pq1024' ? ml_kem1024 : ml_kem768;
+    const keys = kem.keygen();
+    const encapsulated = kem.encapsulate(keys.publicKey);
+    sender = encapsulated.sharedSecret;
+    receiver = kem.decapsulate(encapsulated.cipherText, keys.secretKey);
+    publicKey = keys.publicKey;
+    ciphertext = encapsulated.cipherText;
+    keys.secretKey.fill(0);
+  }
+  const same = sender.length === receiver.length && sender.reduce((diff, byte, i) => diff | (byte ^ receiver[i]), 0) === 0;
+  if (!same) throw new Error('Shared secret verification failed');
+  const salt = crypto.getRandomValues(new Uint8Array(32));
+  const source = await crypto.subtle.importKey('raw', sender, 'HKDF', false, ['deriveKey']);
+  const key = await crypto.subtle.deriveKey({name:'HKDF', hash:'SHA-256', salt, info:encoder.encode('cipher/browser-session/v1/'+algorithm)}, source, {name:'AES-GCM',length:256}, false, ['encrypt','decrypt']);
+  sender.fill(0); receiver.fill(0);
+  const fingerprint = new Uint8Array(await crypto.subtle.digest('SHA-256', publicKey));
+  return { id: crypto.randomUUID(), name: name.trim() || 'Untitled session', algorithm, label: algorithms[algorithm], key, publicKey, ciphertext, fingerprint: Array.from(fingerprint.slice(0, 8), b => b.toString(16).padStart(2, '0')).join(':'), created: new Date(), duration: Math.round(performance.now() - started), salt };
+}
+export async function encryptMessage(session, plaintext, aad = '') {
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const ciphertext = await crypto.subtle.encrypt({name:'AES-GCM',iv,additionalData:encoder.encode(aad),tagLength:128},session.key,encoder.encode(plaintext));
+  return JSON.stringify({version:1,session:session.id,algorithm:'AES-256-GCM',iv:b64(iv),aad,ciphertext:b64(new Uint8Array(ciphertext))},null,2);
+}
+export async function decryptMessage(session, envelope) {
+  let data;
+  try { data = JSON.parse(envelope); } catch { throw new Error('Enter a valid Cipher JSON envelope.'); }
+  if (data.version !== 1 || data.algorithm !== 'AES-256-GCM') throw new Error('Unsupported encrypted envelope.');
+  if (data.session !== session.id) throw new Error('This message belongs to a different session. Select its original key in the vault.');
+  try {
+    const plaintext = await crypto.subtle.decrypt({name:'AES-GCM',iv:unb64(data.iv),additionalData:encoder.encode(data.aad || ''),tagLength:128},session.key,unb64(data.ciphertext));
+    return new TextDecoder('utf-8',{fatal:true}).decode(plaintext);
+  } catch { throw new Error('Authentication failed. The ciphertext or associated data has changed.'); }
+}
