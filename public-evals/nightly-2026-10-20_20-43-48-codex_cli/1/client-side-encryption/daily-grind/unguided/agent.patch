+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { establishSession, encryptMessage, decryptMessage, algorithms } from './crypto.js';
+for (const algorithm of Object.keys(algorithms)) {
+  test(`${algorithm}: shared secret, encryption, authentication, nonce uniqueness`, async () => {
+    const session = await establishSession(algorithm, 'Test session');
+    assert.equal(session.key.extractable, false);
+    assert.equal(session.publicKey.length > 0, true);
+    const plaintext = 'Confidential message 🔐';
+    const envelope = await encryptMessage(session, plaintext, 'context');
+    assert.equal(await decryptMessage(session, envelope), plaintext);
+    const next = await encryptMessage(session, plaintext, 'context');
+    assert.notEqual(JSON.parse(next).iv, JSON.parse(envelope).iv);
+    const tampered = JSON.parse(envelope);
+    tampered.aad = 'modified';
+    await assert.rejects(() => decryptMessage(session, JSON.stringify(tampered)), /Authentication failed/);
+    const damaged = JSON.parse(envelope);
+    damaged.ciphertext = (damaged.ciphertext[0] === 'A' ? 'B' : 'A') + damaged.ciphertext.slice(1);
+    await assert.rejects(() => decryptMessage(session, JSON.stringify(damaged)), /Authentication failed/);
+    const other = await establishSession(algorithm);
+    await assert.rejects(() => decryptMessage(other, envelope), /different session/);
+  });
+}
+test('reject invalid inputs', async () => {
+  await assert.rejects(() => establishSession('invalid'), /Unknown algorithm/);
+  const session = await establishSession();
+  await assert.rejects(() => decryptMessage(session, 'invalid'), /valid Cipher JSON/);
+  await assert.rejects(() => decryptMessage(session, '{}'), /Unsupported/);
+});
