+  <script type="importmap">
+    {
+      "imports": {
+        "@js-temporal/polyfill": "https://esm.sh/@js-temporal/polyfill@0.5.1"
+      }
+    }
+  </script>
+  <script type="module">
+    const form = document.getElementById('coffee-preferences');
+    const reminderInput = document.getElementById('pickup-reminder');
+    const anniversaryInput = document.getElementById('coffee-anniversary');
+    const status = document.getElementById('preferences-status');
+    const storageKey = 'daily-grind-coffee-preferences';
+
+    // Keep floating clock/calendar values. Never convert them to Date or UTC.
+    // The fallback is loaded only in browsers without the native Plain types.
+    const temporalReady = (async () => {
+      if (globalThis.Temporal?.PlainTime && globalThis.Temporal?.PlainDate) {
+        return globalThis.Temporal;
+      }
+      return (await import('@js-temporal/polyfill')).Temporal;
+    })();
+    // Handle loading failures now, even if the user has not submitted the form.
+    temporalReady.catch(() => {
+      status.textContent = 'Date and time support could not load. Please reconnect and reload to save preferences.';
+    });
+
+    function normalizePreferences(values, temporal) {
+      return {
+        pickupReminder: values.pickupReminder
+          ? temporal.PlainTime.from(values.pickupReminder).toString({ smallestUnit: 'minute' })
+          : '',
+        coffeeAnniversary: values.coffeeAnniversary
+          ? temporal.PlainDate.from(values.coffeeAnniversary).toString()
+          : ''
+      };
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+
+      try {
+        const preferences = normalizePreferences({
+          pickupReminder: reminderInput.value,
+          coffeeAnniversary: anniversaryInput.value
+        }, await temporalReady);
+        // Store only HH:mm and YYYY-MM-DD strings, without offsets or timestamps.
+        localStorage.setItem(storageKey, JSON.stringify(preferences));
+        status.textContent = 'Preferences saved on this device. Your time and date stay the same when you travel.';
+      } catch {
+        status.textContent = 'Preferences could not be saved. Check your connection and browser storage settings, then try again.';
+      }
+    });
+
+    try {
+      const saved = localStorage.getItem(storageKey);
+      if (saved) {
+        const preferences = normalizePreferences(JSON.parse(saved), await temporalReady);
+        reminderInput.value = preferences.pickupReminder;
+        anniversaryInput.value = preferences.coffeeAnniversary;
+      }
+    } catch {
+      status.textContent = 'Saved preferences could not be loaded. You can choose them again.';
+    }
+  </script>
