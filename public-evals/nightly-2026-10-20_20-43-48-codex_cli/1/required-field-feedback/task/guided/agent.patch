+  <script>
+    const mailingListForm = document.getElementById('mailing-list-form');
+    const emailInput = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('mailing-list-error');
+    const signupStatus = document.getElementById('mailing-list-status');
+
+    function showEmailError() {
+      const invalid = !emailInput.validity.valid;
+      emailInput.setAttribute('aria-invalid', String(invalid));
+      emailError.textContent = invalid
+        ? (emailInput.validity.valueMissing
+          ? 'Please enter your email address.'
+          : 'Please enter a valid email address.')
+        : '';
+    }
+
+    emailInput.addEventListener('blur', showEmailError);
+    emailInput.addEventListener('input', () => {
+      emailInput.removeAttribute('aria-invalid');
+      emailError.textContent = '';
+      signupStatus.textContent = '';
+    });
+    emailInput.addEventListener('invalid', (event) => {
+      event.preventDefault();
+      showEmailError();
+      emailInput.focus();
+    });
+
+    mailingListForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Connect a mailing-list service here before accepting subscriptions.
+      signupStatus.textContent = 'Online signup is not available yet. Please contact us to join our mailing list.';
+    });
+  </script>
+
 </body>
 
