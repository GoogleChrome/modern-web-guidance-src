diff --git a/media.js b/media.js
new file mode 100644
index 0000000..fc5698e
--- /dev/null
+++ b/media.js
@@ -0,0 +1,62 @@
+(() => {
+  const players = [...document.querySelectorAll('[data-lazy-media]')];
+  const pending = new Set(players);
+
+  function activate(player) {
+    if (!pending.delete(player)) return;
+
+    // Keep both poster and media URLs inert until the player is nearby.
+    if (player.dataset.poster) {
+      player.poster = player.dataset.poster;
+      delete player.dataset.poster;
+    }
+    player.querySelectorAll('source[data-src]').forEach((source) => {
+      source.src = source.dataset.src;
+      delete source.dataset.src;
+    });
+    player.preload = 'metadata';
+    player.load();
+  }
+
+  if ('IntersectionObserver' in window) {
+    const observer = new IntersectionObserver((entries) => {
+      entries.forEach((entry) => {
+        if (!entry.isIntersecting) return;
+        activate(entry.target);
+        observer.unobserve(entry.target);
+      });
+    }, { rootMargin: '200px 0px', threshold: 0 });
+
+    players.forEach((player) => observer.observe(player));
+  } else {
+    // Older browsers still defer offscreen requests instead of loading everything.
+    let scheduled = false;
+    function checkViewport() {
+      scheduled = false;
+      pending.forEach((player) => {
+        const rect = player.getBoundingClientRect();
+        if (rect.bottom >= -200 && rect.top <= window.innerHeight + 200) {
+          activate(player);
+        }
+      });
+      if (!pending.size) {
+        window.removeEventListener('scroll', scheduleCheck);
+        window.removeEventListener('resize', scheduleCheck);
+      }
+    }
+    function scheduleCheck() {
+      if (scheduled) return;
+      scheduled = true;
+      window.requestAnimationFrame(checkViewport);
+    }
+    window.addEventListener('scroll', scheduleCheck, { passive: true });
+    window.addEventListener('resize', scheduleCheck);
+    checkViewport();
+  }
+
+  // Keyboard focus or a direct click can arrive before the observer callback.
+  players.forEach((player) => {
+    player.addEventListener('focusin', () => activate(player), { once: true });
+    player.addEventListener('pointerdown', () => activate(player), { once: true });
+  });
+})();
