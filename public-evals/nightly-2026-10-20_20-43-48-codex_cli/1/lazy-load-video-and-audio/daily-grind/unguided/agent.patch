diff --git a/tests/media.test.cjs b/tests/media.test.cjs
new file mode 100644
index 0000000..16458b0
--- /dev/null
+++ b/tests/media.test.cjs
@@ -0,0 +1,102 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const script = readFileSync('media.js', 'utf8');
+const html = readFileSync('index.html', 'utf8');
+
+function setup(withObserver = true) {
+  const players = [0, 1600, 2400].map((top, index) => ({
+    dataset: index < 2 ? { poster: `poster-${index}.jpg` } : {},
+    sources: [{ dataset: { src: `media-${index}` } }],
+    preload: 'none',
+    loads: 0,
+    top,
+    events: {},
+    querySelectorAll() { return this.sources; },
+    addEventListener(name, callback) { this.events[name] = callback; },
+    getBoundingClientRect() { return { top: this.top, bottom: this.top + 200 }; },
+    load() {
+      this.loads++;
+      assert.equal(this.sources[0].src, `media-${index}`);
+      if (index < 2) assert.equal(this.poster, `poster-${index}.jpg`);
+    },
+  }));
+  const events = {};
+  let callback;
+  const observed = new Set();
+  const window = {
+    innerHeight: 800,
+    addEventListener(name, handler) { events[name] = handler; },
+    removeEventListener(name) { delete events[name]; },
+    requestAnimationFrame(handler) { handler(); },
+  };
+  class IntersectionObserver {
+    constructor(handler, options) {
+      callback = handler;
+      assert.equal(options.rootMargin, '200px 0px');
+    }
+    observe(player) { observed.add(player); }
+    unobserve(player) { observed.delete(player); }
+  }
+  if (withObserver) window.IntersectionObserver = IntersectionObserver;
+  runInNewContext(script, {
+    document: { querySelectorAll: () => players },
+    window,
+    IntersectionObserver,
+  });
+  return { players, events, observed, intersect: (entries) => callback(entries) };
+}
+
+test('HTML keeps media and poster URLs inert, with no eager media preloads', () => {
+  const players = [...html.matchAll(/<(video|audio)\b([^>]*)>([\s\S]*?)<\/\1>/g)];
+  assert.equal(players.length, 3);
+  for (const [, , attributes, content] of players) {
+    assert.match(attributes, /preload="none"/);
+    assert.match(attributes, /data-lazy-media/);
+    assert.doesNotMatch(attributes, /\s(?:src|poster|autoplay)=/);
+    assert.match(content, /<source\s+data-src="https:\/\//);
+    assert.doesNotMatch(content, /\ssrc=/);
+  }
+  assert.doesNotMatch(html, /url\(|<link[^>]+rel="(?:preload|prefetch)"/);
+});
+
+test('only approaching players load, with posters deferred and one load per player', () => {
+  const { players, intersect, observed } = setup();
+  for (const player of players) {
+    assert.equal(player.loads, 0);
+    assert.equal(player.poster, undefined);
+    assert.equal(player.sources[0].src, undefined);
+  }
+  intersect(players.map((target) => ({ target, isIntersecting: false })));
+  assert.ok(players.every((player) => player.loads === 0));
+  intersect([{ target: players[0], isIntersecting: true }]);
+  assert.deepEqual(players.map((player) => player.loads), [1, 0, 0]);
+  assert.equal(observed.has(players[0]), false);
+  intersect([{ target: players[1], isIntersecting: true }]);
+  players[1].events.focusin();
+  players[1].events.pointerdown();
+  assert.deepEqual(players.map((player) => player.loads), [1, 1, 0]);
+  intersect([{ target: players[2], isIntersecting: true }]);
+  assert.equal(players[2].preload, 'metadata');
+  assert.equal(players[2].loads, 1);
+});
+
+test('direct interaction activates only the selected player', () => {
+  const { players } = setup();
+  players[2].events.focusin();
+  assert.deepEqual(players.map((player) => player.loads), [0, 0, 1]);
+});
+
+test('fallback defers offscreen players and removes listeners when finished', () => {
+  const { players, events } = setup(false);
+  assert.deepEqual(players.map((player) => player.loads), [1, 0, 0]);
+  players[1].top = 950;
+  events.scroll();
+  assert.deepEqual(players.map((player) => player.loads), [1, 1, 0]);
+  players[2].top = 1000;
+  events.resize();
+  assert.deepEqual(players.map((player) => player.loads), [1, 1, 1]);
+  assert.deepEqual(Object.keys(events), []);
+});
