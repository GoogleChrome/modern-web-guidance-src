diff --git a/tests/media.test.js b/tests/media.test.js
new file mode 100644
index 0000000..e66b961
--- /dev/null
+++ b/tests/media.test.js
@@ -0,0 +1,106 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const script = readFileSync(new URL('../media.js', `file://${__filename}`), 'utf8');
+
+function fixture(withObserver = true) {
+  const players = ['video', 'audio'].map((type) => {
+    let deferred = true;
+    const source = { dataset: { src: `${type}.media` } };
+    return {
+      dataset: { preload: 'metadata', ...(type === 'video' ? { poster: 'poster.jpg' } : {}) },
+      source, loads: 0, preload: 'none',
+      hasAttribute: () => deferred,
+      removeAttribute: () => { deferred = false; },
+      querySelectorAll: () => [source],
+      load() { this.loads++; },
+      focus() { this.focused = true; },
+    };
+  });
+  const buttons = players.map((player, index) => ({
+    hidden: true, dataset: { loadMedia: index },
+    addEventListener(event, handler) { this.click = handler; },
+  }));
+  const observed = new Set();
+  let intersect;
+  let options;
+  class IntersectionObserver {
+    constructor(callback, config) { intersect = callback; options = config; }
+    observe(media) { observed.add(media); }
+    unobserve(media) { observed.delete(media); }
+  }
+  const window = withObserver ? { IntersectionObserver } : {};
+  runInNewContext(script, {
+    window, IntersectionObserver,
+    document: {
+      querySelectorAll: (selector) => selector === '[data-deferred-media]' ? players : buttons,
+      getElementById: (id) => players[id],
+    },
+  });
+  return { players, buttons, observed, intersect, options };
+}
+
+test('offscreen media do not attach sources, posters, or preload data', () => {
+  const { players, intersect, observed, options } = fixture();
+  assert.equal(options.rootMargin, '200px 0px');
+  assert.equal(observed.size, 2);
+  intersect(players.map((target) => ({ target, isIntersecting: false })));
+  for (const player of players) {
+    assert.equal(player.source.src, undefined);
+    assert.equal(player.poster, undefined);
+    assert.equal(player.preload, 'none');
+    assert.equal(player.loads, 0);
+  }
+});
+
+test('each approaching player activates independently and only once', () => {
+  const { players, intersect, observed } = fixture();
+  for (const player of players) {
+    intersect([{ target: player, isIntersecting: true }]);
+    assert.equal(player.source.src, player === players[0] ? 'video.media' : 'audio.media');
+    assert.equal(player.preload, 'metadata');
+    assert.equal(player.loads, 1);
+    assert.equal(observed.has(player), false);
+    intersect([{ target: player, isIntersecting: true }]);
+    assert.equal(player.loads, 1);
+    if (player === players[0]) {
+      assert.equal(player.poster, 'poster.jpg');
+      assert.equal(players[1].loads, 0);
+    }
+  }
+});
+
+test('without IntersectionObserver, explicit activation preserves deferred downloads', () => {
+  const { players, buttons } = fixture(false);
+  assert.ok(players.every((player) => player.loads === 0));
+  assert.ok(buttons.every((button) => !button.hidden));
+  buttons[0].click();
+  assert.equal(players[0].loads, 1);
+  assert.equal(players[0].focused, true);
+  assert.equal(buttons[0].hidden, true);
+  assert.equal(players[1].loads, 0);
+});
+
+test('HTML keeps offscreen URLs inert before JavaScript or preload scanning', () => {
+  const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+  const media = [...html.matchAll(/<(video|audio)\b([^>]*)>([\s\S]*?)<\/\1>/g)];
+  assert.equal(media.length, 3);
+  assert.doesNotMatch(media[0][2], /loading="lazy"/);
+  assert.match(media[0][3], /<source src=/);
+  for (const [, tag, attributes, content] of media.slice(1)) {
+    assert.match(attributes, /loading="lazy"/);
+    assert.match(attributes, /preload="none"/);
+    assert.match(attributes, /\bcontrols\b/);
+    assert.doesNotMatch(attributes, /\s(?:poster|src)="/);
+    assert.match(content, /<source data-src=/);
+    assert.doesNotMatch(content, /\ssrc="/);
+    if (tag === 'video') {
+      assert.match(attributes, /width="\d+"/);
+      assert.match(attributes, /height="\d+"/);
+      assert.match(attributes, /data-poster=/);
+    }
+  }
+  assert.doesNotMatch(html, /rel="(?:preload|prefetch)"/);
+});
