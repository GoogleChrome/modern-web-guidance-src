diff --git a/media.js b/media.js
new file mode 100644
index 0000000..64eb494
--- /dev/null
+++ b/media.js
@@ -0,0 +1,46 @@
+(() => {
+  const players = document.querySelectorAll('[data-deferred-media]');
+
+  function activate(media) {
+    if (!media.hasAttribute('data-deferred-media')) return;
+    media.removeAttribute('data-deferred-media');
+
+    if (media.dataset.poster) {
+      media.poster = media.dataset.poster;
+      delete media.dataset.poster;
+    }
+    for (const source of media.querySelectorAll('source[data-src]')) {
+      source.src = source.dataset.src;
+      delete source.dataset.src;
+    }
+    media.preload = media.dataset.preload;
+    delete media.dataset.preload;
+    media.load();
+  }
+
+  // Source and poster URLs stay inert until intersection in every browser,
+  // including those which ignore native media loading="lazy".
+  if ('IntersectionObserver' in window) {
+    const observer = new IntersectionObserver((entries) => {
+      for (const entry of entries) {
+        if (!entry.isIntersecting) continue;
+        activate(entry.target);
+        observer.unobserve(entry.target);
+      }
+    }, { rootMargin: '200px 0px', threshold: 0 });
+
+    for (const media of players) observer.observe(media);
+  } else {
+    // Older browsers can load each player on demand without eagerly fetching
+    // offscreen assets. With scripting disabled, direct links remain available.
+    for (const button of document.querySelectorAll('[data-load-media]')) {
+      button.hidden = false;
+      button.addEventListener('click', () => {
+        const media = document.getElementById(button.dataset.loadMedia);
+        activate(media);
+        button.hidden = true;
+        media.focus();
+      }, { once: true });
+    }
+  }
+})();
