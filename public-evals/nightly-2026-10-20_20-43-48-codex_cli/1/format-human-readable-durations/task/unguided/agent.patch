+  <script>
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+    const unitChoices = document.querySelectorAll('input[name="largestUnit"]');
+    const locales = navigator.languages?.length ? navigator.languages : navigator.language;
+    const hourFormatter = new Intl.NumberFormat(locales, { style: 'unit', unit: 'hour', unitDisplay: 'long' });
+    const minuteFormatter = new Intl.NumberFormat(locales, { style: 'unit', unit: 'minute', unitDisplay: 'long' });
+    const listFormatter = new Intl.ListFormat(locales, { style: 'long', type: 'conjunction' });
+    const durationFormatter = typeof Intl.DurationFormat === 'function'
+      ? new Intl.DurationFormat(locales, { style: 'long' })
+      : null;
+
+    function updateDuration() {
+      const inputs = [hoursInput, minutesInput];
+      const values = inputs.map(input => input.value === '' ? 0 : input.valueAsNumber);
+      const validInputs = inputs.map((input, index) => {
+        const valid = input.validity.valid && Number.isSafeInteger(values[index]) && values[index] >= 0;
+        input.setAttribute('aria-invalid', String(!valid));
+        return valid;
+      });
+      const totalMinutes = values[0] * 60 + values[1];
+
+      if (!validInputs.every(Boolean) || !Number.isSafeInteger(totalMinutes)) {
+        humanValue.textContent = 'Enter a valid duration using non-negative whole hours and minutes.';
+        return;
+      }
+
+      const largestUnit = document.querySelector('input[name="largestUnit"]:checked').value;
+      const hours = largestUnit === 'hours' ? Math.floor(totalMinutes / 60) : 0;
+      const minutes = largestUnit === 'hours' ? totalMinutes % 60 : totalMinutes;
+
+      if (durationFormatter && totalMinutes > 0) {
+        humanValue.textContent = durationFormatter.format(hours ? { hours, minutes } : { minutes });
+      } else {
+        const parts = [];
+        if (hours) parts.push(hourFormatter.format(hours));
+        if (minutes || !hours) parts.push(minuteFormatter.format(minutes));
+        humanValue.textContent = listFormatter.format(parts);
+      }
+    }
+
+    hoursInput.addEventListener('input', updateDuration);
+    minutesInput.addEventListener('input', updateDuration);
+    unitChoices.forEach(choice => choice.addEventListener('change', updateDuration));
+    updateDuration();
+  </script>
