+  <script type="module">
+    const calculator = document.querySelector('.steeping-calculator');
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+    const locale = navigator.languages?.length ? navigator.languages : navigator.language;
+    const formatter = typeof Intl.DurationFormat === 'function'
+      ? new Intl.DurationFormat(locale, { style: 'long' })
+      : null;
+    const unitFormatters = {
+      hours: new Intl.NumberFormat(locale, { style: 'unit', unit: 'hour', unitDisplay: 'long' }),
+      minutes: new Intl.NumberFormat(locale, { style: 'unit', unit: 'minute', unitDisplay: 'long' })
+    };
+    const listFormatter = new Intl.ListFormat(locale, { style: 'long', type: 'conjunction' });
+    let durationAPI = globalThis.Temporal;
+
+    function updateDuration() {
+      const inputs = [hoursInput, minutesInput];
+      if (inputs.some(input => !input.validity.valid)) {
+        humanValue.textContent = 'Enter whole, non-negative hours and minutes (up to 1,000,000 each).';
+        return;
+      }
+      // Treat an empty field as zero while the user edits.
+      const hours = Number(hoursInput.value);
+      const minutes = Number(minutesInput.value);
+      const largestUnit = calculator.querySelector('input[name="largestUnit"]:checked').value;
+      const totalMinutes = hours * 60 + minutes;
+      const balanced = durationAPI
+        ? durationAPI.Duration.from({ hours, minutes }).round({ largestUnit, smallestUnit: 'minutes' })
+        : largestUnit === 'hours'
+          ? { hours: Math.floor(totalMinutes / 60), minutes: totalMinutes % 60 }
+          : { hours: 0, minutes: totalMinutes };
+
+      if (formatter) {
+        humanValue.textContent = formatter.format({ hours: balanced.hours, minutes: balanced.minutes });
+      } else {
+        const parts = [];
+        if (balanced.hours) parts.push(unitFormatters.hours.format(balanced.hours));
+        if (balanced.minutes || !balanced.hours) parts.push(unitFormatters.minutes.format(balanced.minutes));
+        humanValue.textContent = listFormatter.format(parts);
+      }
+    }
+
+    calculator.addEventListener('input', updateDuration);
+    calculator.addEventListener('change', updateDuration);
+    updateDuration();
+
+    // Load Temporal only where needed. The calculator also works if the CDN is unavailable.
+    if (!durationAPI) {
+      import('https://esm.sh/@js-temporal/polyfill@0.5.1')
+        .then(({ Temporal }) => {
+          durationAPI = Temporal;
+          updateDuration();
+        })
+        .catch(() => { /* Keep the localized arithmetic fallback. */ });
+    }
+  </script>
 </body>
 
