diff --git a/README.md b/README.md
new file mode 100644
index 0000000..9143290
--- /dev/null
+++ b/README.md
@@ -0,0 +1,13 @@
+# smallpt playground
+
+Kevin Beason’s open-source C++ smallpt path tracer, compiled to WebAssembly with Emscripten. Open `index.html` through an HTTP server (`pnpm start`), rather than a file URL. The checked-in Wasm and preview make a compiler unnecessary to serve the app.
+
+The renderer runs locally in a module Web Worker, sends progressive scanlines to a canvas, and supports randomized or individually editable wall, mirror, and glass colors, sample counts, resolution, and PNG export. Changing a control cancels the previous worker and starts a fresh render.
+
+## Rebuild
+
+Install Emscripten and run `npm run build:wasm`. The build emits `assets/smallpt.js` and `assets/smallpt.wasm`. It uses ES modules, optimization, memory growth and runtime assertions. No threads or cross-origin isolation headers are required.
+
+`vendor/smallpt.cpp` is the unmodified upstream source from https://www.kevinbeason.com/smallpt/smallpt.cpp; its MIT license is in `vendor/LICENSE.txt`. `src/renderer.cpp` adapts image generation to an exported row-based interface. The original path tracing, material evaluation, camera, and supersampling are retained. The default wall palette is coral and green.
+
+The initial `assets/preview.png` is a 128-sample render from this same C++ adapter, not a placeholder photograph. To regenerate it, compile `src/renderer.cpp` with `g++ -O3 -Wno-narrowing -DSMALLPT_PREVIEW`, run the binary, and convert `/tmp/smallpt-preview.ppm` to PNG.
diff --git a/app.js b/app.js
new file mode 100644
index 0000000..4d8bf05
--- /dev/null
+++ b/app.js
@@ -0,0 +1,114 @@
+const canvas = document.querySelector('#render');
+const context = canvas.getContext('2d');
+const preview = document.querySelector('#preview');
+const state = document.querySelector('#render-state');
+const info = document.querySelector('#render-info');
+const progress = document.querySelector('#progress');
+const download = document.querySelector('#download');
+const samples = document.querySelector('#samples');
+const resolution = document.querySelector('#resolution');
+const colorInputs = [...document.querySelectorAll('input[type=color]')];
+const defaults = ['#bf5e42', '#549173', '#fefefe', '#fefefe'];
+let worker;
+let currentSeed = 42;
+let renderNumber = 0;
+
+function rgb(hex) {
+  return [1, 3, 5].map(offset => parseInt(hex.slice(offset, offset + 2), 16) / 255);
+}
+function setState(message, error = false) {
+  state.replaceChildren();
+  const dot = document.createElement('span');
+  dot.className = 'live-dot';
+  if (error) dot.style.background = '#d96b4b';
+  state.append(dot, document.createTextNode(message));
+}
+function fail(message) {
+  worker?.terminate();
+  setState('Render unavailable — try again', true);
+  state.title = message;
+  state.setAttribute('role', 'alert');
+  canvas.setAttribute('aria-busy', 'false');
+}
+function startRender() {
+  worker?.terminate();
+  state.removeAttribute('role');
+  state.removeAttribute('title');
+  const thisRender = ++renderNumber;
+  const width = Number(resolution.value), height = width * 3 / 4;
+  const spp = Number(samples.value);
+  canvas.width = width; canvas.height = height;
+  canvas.classList.remove('active');
+  canvas.setAttribute('aria-busy', 'true');
+  download.disabled = true;
+  progress.value = 0;
+  info.textContent = `${width} × ${height} · ${spp} samples / pixel`;
+  setState('Warming up the light…');
+  try {
+    worker = new Worker(new URL('./renderer.worker.js', import.meta.url), { type: 'module' });
+    worker.onerror = event => { if (thisRender === renderNumber) fail(event.message); };
+    worker.onmessage = ({ data }) => {
+      if (thisRender !== renderNumber) return;
+      if (data.type === 'error') { fail(data.message); return; }
+      if (data.type === 'rows') {
+        if (data.row === 0) {
+          // Keep an authentic smallpt render behind the progressively updated scanlines.
+          if (preview.complete && preview.naturalWidth) context.drawImage(preview, 0, 0, width, height);
+          canvas.classList.add('active');
+        }
+        context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, data.count), 0, data.row);
+        const percent = Math.round((data.row + data.count) / height * 100);
+        progress.value = percent;
+        setState(`Tracing light · ${percent}%`);
+      }
+      if (data.type === 'done') {
+        setState(`Render complete · ${(data.elapsed / 1000).toFixed(1)}s`);
+        state.setAttribute('role', 'status');
+        canvas.setAttribute('aria-busy', 'false');
+        download.disabled = false;
+        // Use the most recent output as the backdrop for the next render.
+        preview.src = canvas.toDataURL('image/png');
+        worker.terminate();
+      }
+    };
+    worker.postMessage({ width, height, samples: spp, seed: currentSeed,
+      colors: colorInputs.map(input => [Number(input.dataset.sphere), rgb(input.value)]) });
+  } catch (error) { fail(error.message); }
+}
+function randomHex() {
+  // Keep reflectance high enough for the mirror and glass to remain readable.
+  const hue = crypto.getRandomValues(new Uint32Array(1))[0] % 360;
+  const saturation = .35 + Math.random() * .3;
+  const lightness = .55 + Math.random() * .15;
+  const a = saturation * Math.min(lightness, 1 - lightness);
+  const channel = n => {
+    const k = (n + hue / 30) % 12;
+    return Math.round(255 * (lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)))).toString(16).padStart(2, '0');
+  };
+  return `#${channel(0)}${channel(8)}${channel(4)}`;
+}
+document.querySelector('#randomize').addEventListener('click', () => {
+  colorInputs.forEach(input => { input.value = randomHex(); });
+  currentSeed = crypto.getRandomValues(new Uint32Array(1))[0];
+  startRender();
+});
+document.querySelector('#reset').addEventListener('click', () => {
+  colorInputs.forEach((input, index) => { input.value = defaults[index]; });
+  currentSeed = 42;
+  startRender();
+});
+document.querySelector('#rerender').addEventListener('click', startRender);
+colorInputs.forEach(input => input.addEventListener('change', startRender));
+samples.addEventListener('change', startRender);
+resolution.addEventListener('change', startRender);
+download.addEventListener('click', () => {
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const anchor = document.createElement('a');
+    anchor.href = url; anchor.download = `smallpt-${currentSeed}.png`; anchor.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+if (preview.complete) startRender();
+else { preview.addEventListener('load', startRender, { once: true }); preview.addEventListener('error', startRender, { once: true }); }
