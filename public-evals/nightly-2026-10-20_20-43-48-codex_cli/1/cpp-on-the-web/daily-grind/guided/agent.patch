diff --git a/renderer.worker.js b/renderer.worker.js
new file mode 100644
index 0000000..83b09ea
--- /dev/null
+++ b/renderer.worker.js
@@ -0,0 +1,22 @@
+import createSmallpt from './assets/smallpt.js';
+
+self.onmessage = async ({ data }) => {
+  try {
+    const engine = await createSmallpt();
+    const { width, height, samples, seed, colors } = data;
+    for (const [id, rgb] of colors) engine._set_color(id, ...rgb);
+    engine._begin_render(width, height, samples, seed);
+    const pointer = engine._pixel_buffer();
+    const started = performance.now();
+    for (let row = 0; row < height; row += 4) {
+      const count = Math.min(4, height - row);
+      engine._render_rows(row, count);
+      const offset = pointer + row * width * 4;
+      const pixels = engine.HEAPU8.slice(offset, offset + count * width * 4);
+      self.postMessage({ type: 'rows', row, count, pixels, elapsed: performance.now() - started }, [pixels.buffer]);
+    }
+    self.postMessage({ type: 'done', elapsed: performance.now() - started });
+  } catch (error) {
+    self.postMessage({ type: 'error', message: error.message || String(error) });
+  }
+};
