+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc src/renderer.cpp -O3 -flto --no-entry -Wno-narrowing -Wno-return-type -Wno-dangling-else -fno-exceptions \
+  -sEXPORT_ES6=1 -sMODULARIZE=1 -sENVIRONMENT=worker -sSTRICT=1 \
+  -sSTACK_SIZE=1048576 -sALLOW_MEMORY_GROWTH=1 -sFILESYSTEM=0 -sASSERTIONS=1 \
+  -sEXPORTED_FUNCTIONS='["_set_color","_begin_render","_pixel_buffer","_render_rows"]' \
+  -sINCOMING_MODULE_JS_API='["wasmBinary"]' \
+  -sEXPORTED_RUNTIME_METHODS='["HEAPU8"]' -o assets/smallpt.js
diff --git a/src/renderer.cpp b/src/renderer.cpp
new file mode 100644
index 0000000..64b5d49
--- /dev/null
+++ b/src/renderer.cpp
@@ -0,0 +1,52 @@
+// Browser adapter for Kevin Beason's smallpt. Original source and MIT license in vendor/.
+#define main smallpt_original_main
+#include "../vendor/smallpt.cpp"
+#undef main
+#include <stdint.h>
+
+
+static int width, height, samples;
+static unsigned seed;
+static unsigned char* pixels = nullptr;
+extern "C" {
+void set_color(int id, double r, double g, double b) {
+  if (id >= 0 && id < 8) spheres[id].c = Vec(r,g,b);
+}
+void begin_render(int w, int h, int spp, unsigned render_seed) {
+  width=w; height=h; samples=spp/4; seed=render_seed;
+  free(pixels); pixels = (unsigned char*)calloc(w*h*4, 1);
+}
+unsigned char* pixel_buffer() { return pixels; }
+void render_rows(int start, int count) {
+  Ray cam(Vec(50,52,295.6), Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for (int row=start; row<start+count && row<height; ++row) {
+    int y=height-row-1;
+    unsigned short Xi[3]={(unsigned short)seed,(unsigned short)(seed>>16),(unsigned short)(y*y*y+1)};
+    for (int x=0; x<width; ++x) {
+      Vec color;
+      for (int sy=0;sy<2;++sy) for(int sx=0;sx<2;++sx) {
+        Vec r;
+        for(int s=0;s<samples;++s) {
+          double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+          double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+          Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+          r=r+radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*(1./samples);
+        }
+        color=color+Vec(clamp(r.x),clamp(r.y),clamp(r.z))*.25;
+      }
+      int i=(row*width+x)*4;
+      pixels[i]=toInt(color.x); pixels[i+1]=toInt(color.y); pixels[i+2]=toInt(color.z); pixels[i+3]=255;
+    }
+  }
+}
+}
+#ifdef SMALLPT_PREVIEW
+int main() {
+  set_color(0,.75,.37,.26); set_color(1,.33,.57,.45);
+  begin_render(640,480,128,42); render_rows(0,480);
+  FILE* out=fopen("/tmp/smallpt-preview.ppm","wb"); fprintf(out,"P6\n640 480\n255\n");
+  for(int i=0;i<640*480;++i) fwrite(pixels+i*4,1,3,out);
+  fclose(out);
+}
+#endif
