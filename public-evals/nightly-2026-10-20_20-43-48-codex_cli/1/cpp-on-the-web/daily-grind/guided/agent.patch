diff --git a/tests/wasm-smoke.mjs b/tests/wasm-smoke.mjs
new file mode 100644
index 0000000..e87108e
--- /dev/null
+++ b/tests/wasm-smoke.mjs
@@ -0,0 +1,29 @@
+// Exercise the shipped Emscripten module without launching a browser.
+import { readFile } from 'node:fs/promises';
+import assert from 'node:assert/strict';
+import createSmallpt from '../assets/smallpt.js';
+const wasmBinary = await readFile(new URL('../assets/smallpt.wasm', import.meta.url));
+const nodeProcess = globalThis.process;
+globalThis.process = undefined;
+globalThis.WorkerGlobalScope = class {};
+try {
+  const engine = await createSmallpt({ wasmBinary });
+  const render = color => {
+    engine._set_color(0, ...color);
+    engine._begin_render(40, 30, 16, 42);
+    for (let row = 0; row < 30; row += 3) engine._render_rows(row, 3);
+    const ptr = engine._pixel_buffer();
+    return engine.HEAPU8.slice(ptr, ptr + 40 * 30 * 4);
+  };
+  const a = render([.75, .25, .25]);
+  const b = render([.25, .75, .25]);
+  assert.equal(a.length, 4800);
+  assert(a.filter((_, i) => i % 4 !== 3).some(v => v > 0), 'Rendered pixels contain light');
+  assert(a.every((v, i) => i % 4 !== 3 || v === 255), 'All rows are opaque');
+  assert.notDeepEqual(a, b, 'Changing sphere colors changes the rendered pixels');
+  assert.deepEqual(b, render([.25, .75, .25]), 'Same seed and settings reproduce the image');
+  console.log('PASS: compiled Wasm renders scanlines, colors change output, and seeds reproduce it.');
+} finally {
+  globalThis.process = nodeProcess;
+  delete globalThis.WorkerGlobalScope;
+}
