+const canvas=document.querySelector('#render');
+const context=canvas.getContext('2d');
+const $=id=>document.getElementById(id);
+let worker,colors=[[.999,.999,.999],[.999,.999,.999]],currentSamples=64,rendered=false,run=0;
+const preview=new Image();
+preview.onload=()=>{if(!rendered)context.drawImage(preview,0,0,canvas.width,canvas.height)};
+preview.src='assets/preview.png';
+function render(){
+  if(worker)worker.terminate();
+  const thisRun=++run;
+  currentSamples=Number($('quality').value);
+  $('render-status').textContent='Tracing light paths…';
+  $('image-status').textContent='LIVE RENDER';
+  $('progress').style.width='0%';
+  $('status-dot').style.background='#b1a05d';
+  $('render-stats').textContent=`640 × 480 · 0 / ${currentSamples} samples`;
+  try { worker=new Worker('assets/render-worker.js'); } catch(error){showError(error.message);return}
+  worker.onmessage=({data})=>{
+    if(thisRun!==run)return;
+    if(data.error){showError(data.error);return}
+    rendered=true;
+    context.putImageData(new ImageData(data.rgba,data.width,data.height),0,0);
+    $('progress').style.width=`${data.progress*100}%`;
+    $('render-stats').textContent=`640 × 480 · ${data.samples} / ${currentSamples} samples`;
+    if(data.progress===1){
+      $('render-status').textContent=`Render complete · ${(data.elapsed/1000).toFixed(1)}s`;
+      $('status-dot').style.background='#598254';
+      $('image-status').textContent='RENDER COMPLETE';
+      worker.terminate();worker=null;
+    } else $('render-status').textContent=`Rendering · ${Math.round(data.progress*100)}%`;
+  };
+  worker.onerror=event=>showError(event.message);
+  const seed=crypto.getRandomValues(new Uint32Array(1))[0];
+  worker.postMessage({width:640,height:480,samples:currentSamples,seed,colors});
+}
+function showError(message){$('render-status').textContent='Renderer unavailable. Please reload to retry.';$('image-status').textContent='RENDER ERROR';$('status-dot').style.background='#b15d4f';console.error(message)}
+function randomColor(){
+  const hue=Math.floor(Math.random()*360);
+  const el=document.createElement('canvas').getContext('2d');
+  el.fillStyle=`hsl(${hue} 53% 73%)`;el.fillRect(0,0,1,1);
+  return [...el.getImageData(0,0,1,1).data].slice(0,3).map(v=>v/255);
+}
+function updateSwatches(){
+  colors.forEach((color,i)=>{
+    const rgb=`rgb(${color.map(v=>Math.round(v*255)).join(',')})`;
+    $(i===0?'mirror-chip':'glass-chip').style.background=rgb;
+    const sphere=$(i===0?'mirror-sphere':'glass-sphere');
+    sphere.style.background=`radial-gradient(circle at 30% 22%,#fff 0,${rgb} 30%,#354430 67%,${rgb} 100%)`;
+  });
+}
+$('randomize').onclick=()=>{colors=[randomColor(),randomColor()];$('palette-label').textContent='Random palette';updateSwatches();render()};
+$('reset').onclick=()=>{colors=[[.999,.999,.999],[.999,.999,.999]];$('palette-label').textContent='Original palette';['mirror-sphere','glass-sphere','mirror-chip','glass-chip'].forEach(id=>$(id).removeAttribute('style'));render()};
+$('quality').onchange=render;
+$('save').onclick=()=>{canvas.toBlob(blob=>{if(!blob)return;const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='smallpt-render.png';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)},'image/png')};
+render();
