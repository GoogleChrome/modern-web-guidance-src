diff --git a/renderer/bridge.cpp b/renderer/bridge.cpp
new file mode 100644
index 0000000..cd975b0
--- /dev/null
+++ b/renderer/bridge.cpp
@@ -0,0 +1,41 @@
+// Browser adaptation of Kevin Beason's smallpt. See vendor/LICENSE.txt.
+#define main smallpt_original_main
+#include "../vendor/smallpt.cpp"
+#undef main
+#include <stdint.h>
+
+static int width, height, passes;
+static Vec* accumulation = nullptr;
+static unsigned char* pixels = nullptr;
+static unsigned int sceneSeed;
+extern "C" {
+void setup(int w, int h, unsigned int seed) {
+  delete[] accumulation; delete[] pixels;
+  width=w; height=h; passes=0; sceneSeed=seed;
+  accumulation=new Vec[w*h](); pixels=new unsigned char[w*h*4]();
+}
+void color(int id, double r, double g, double b) {
+  if(id>=0 && id<8) spheres[id].c=Vec(r,g,b);
+}
+unsigned char* buffer() { return pixels; }
+void render_rows(int first, int count, int pass) {
+  Ray cam(Vec(50,52,295.6),Vec(0,-0.042612,-1).norm());
+  Vec cx=Vec(width*.5135/height), cy=(cx%cam.d).norm()*.5135;
+  for(int y=first; y<first+count && y<height; ++y) {
+    unsigned short Xi[3]={(unsigned short)(sceneSeed+pass*3719), (unsigned short)(y*1973+pass*9277), (unsigned short)(y*y*y+sceneSeed*7+pass*26699)};
+    for(int x=0;x<width;++x) {
+      int i=(height-y-1)*width+x;
+      Vec sample;
+      for(int sy=0;sy<2;++sy) for(int sx=0;sx<2;++sx) {
+        double r1=2*erand48(Xi), dx=r1<1?sqrt(r1)-1:1-sqrt(2-r1);
+        double r2=2*erand48(Xi), dy=r2<1?sqrt(r2)-1:1-sqrt(2-r2);
+        Vec d=cx*(((sx+.5+dx)/2+x)/width-.5)+cy*(((sy+.5+dy)/2+y)/height-.5)+cam.d;
+        sample=sample+radiance(Ray(cam.o+d*140,d.norm()),0,Xi)*.25;
+      }
+      accumulation[i]=accumulation[i]+sample;
+      Vec c=accumulation[i]*(1./(pass+1));
+      pixels[i*4]=toInt(c.x); pixels[i*4+1]=toInt(c.y); pixels[i*4+2]=toInt(c.z); pixels[i*4+3]=255;
+    }
+  }
+}
+}
