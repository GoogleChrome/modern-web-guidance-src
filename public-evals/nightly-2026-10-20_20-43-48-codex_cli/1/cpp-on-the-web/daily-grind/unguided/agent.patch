diff --git a/assets/render-worker.js b/assets/render-worker.js
new file mode 100644
index 0000000..4bcd289
--- /dev/null
+++ b/assets/render-worker.js
@@ -0,0 +1,17 @@
+importScripts('smallpt.js');
+const engine = createSmallpt();
+self.onmessage = async ({data}) => {
+  try {
+    const m = await engine;
+    const {width,height,samples,colors,seed}=data;
+    m._setup(width,height,seed);
+    m._color(0,.75,.25,.25); m._color(1,.25,.25,.75);
+    colors.forEach((c,i)=>m._color(i+6,...c));
+    const start=performance.now();
+    for(let pass=0;pass<samples/4;pass++) {
+      for(let row=0;row<height;row+=8) m._render_rows(row,8,pass);
+      const rgba=m.HEAPU8.slice(m._buffer(),m._buffer()+width*height*4);
+      self.postMessage({rgba,width,height,samples:(pass+1)*4,progress:(pass+1)*4/samples,elapsed:performance.now()-start},[rgba.buffer]);
+    }
+  } catch(error) { self.postMessage({error:error.message}); }
+};
