+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc renderer/bridge.cpp -O3 -Wno-c++11-narrowing --no-entry -s WASM=1 -s STACK_SIZE=5242880 -s MODULARIZE=1 -s EXPORT_NAME=createSmallpt -s ENVIRONMENT=web,worker,node -s ALLOW_MEMORY_GROWTH=1 -s EXPORTED_FUNCTIONS='["_setup","_color","_buffer","_render_rows"]' -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' -o assets/smallpt.js
diff --git a/scripts/check.cjs b/scripts/check.cjs
new file mode 100644
index 0000000..6afc149
--- /dev/null
+++ b/scripts/check.cjs
@@ -0,0 +1,20 @@
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const createSmallpt=require('../assets/smallpt.js');
+(async()=>{
+  assert(WebAssembly.validate(fs.readFileSync('assets/smallpt.wasm')));
+  const m=await createSmallpt();
+  function frame(tinted){
+    m._setup(64,48,42);
+    m._color(6,...(tinted?[.85,.35,.4]:[.999,.999,.999]));
+    m._color(7,...(tinted?[.4,.65,.9]:[.999,.999,.999]));
+    for(let p=0;p<4;p++)m._render_rows(0,48,p);
+    return m.HEAPU8.slice(m._buffer(),m._buffer()+64*48*4);
+  }
+  const original=frame(false),colored=frame(true),repeat=frame(false);
+  assert.deepEqual(original,repeat,'A fixed seed must reproduce the frame');
+  assert.notDeepEqual(original,colored,'Sphere colors must change rendered pixels');
+  assert(original.some((v,i)=>i%4!==3&&v>0),'Image must contain light');
+  assert(original.every((v,i)=>i%4!==3||v===255),'Frame must be fully opaque');
+  console.log('PASS: valid WebAssembly, nonempty RGBA frame, deterministic seed, randomized colors affect output, repeated initialization.');
+})();
diff --git a/scripts/ppm-to-png.py b/scripts/ppm-to-png.py
new file mode 100644
index 0000000..ae4c513
--- /dev/null
+++ b/scripts/ppm-to-png.py
@@ -0,0 +1,23 @@
+"""Convert the renderer's binary PPM preview to a PNG with the standard library."""
+import struct
+import zlib
+from pathlib import Path
+
+source = Path('/tmp/smallpt-preview.ppm').read_bytes()
+header, rgb = source.split(b'\n255\n', 1)
+width, height = map(int, header.splitlines()[1].split())
+assert len(rgb) == width * height * 3
+
+
+def chunk(kind, data):
+    return (struct.pack('>I', len(data)) + kind + data
+            + struct.pack('>I', zlib.crc32(kind + data) & 0xffffffff))
+
+
+raw = b''.join(b'\0' + rgb[y * width * 3:(y + 1) * width * 3]
+               for y in range(height))
+Path('assets/preview.png').write_bytes(
+    b'\x89PNG\r\n\x1a\n'
+    + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
+    + chunk(b'IDAT', zlib.compress(raw, 9)) + chunk(b'IEND', b''))
+print(f'Saved {width} × {height} WebAssembly-rendered preview.')
diff --git a/scripts/preview.cjs b/scripts/preview.cjs
new file mode 100644
index 0000000..d63ae19
--- /dev/null
+++ b/scripts/preview.cjs
@@ -0,0 +1,13 @@
+const fs=require('fs');
+const createSmallpt=require('../assets/smallpt.js');
+(async()=>{
+  const m=await createSmallpt();
+  const w=640,h=480,passes=64;
+  m._setup(w,h,42);
+  for(let p=0;p<passes;p++) m._render_rows(0,h,p);
+  const rgba=m.HEAPU8.slice(m._buffer(),m._buffer()+w*h*4);
+  const rgb=Buffer.alloc(w*h*3);
+  for(let i=0;i<w*h;i++) for(let c=0;c<3;c++) rgb[i*3+c]=rgba[i*4+c];
+  fs.writeFileSync('/tmp/smallpt-preview.ppm',Buffer.concat([Buffer.from(`P6\n${w} ${h}\n255\n`),rgb]));
+  console.log('Rendered preview with the compiled WebAssembly module.');
+})();
