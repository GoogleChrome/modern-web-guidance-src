diff --git a/public/renderer/worker.js b/public/renderer/worker.js
new file mode 100644
index 0000000..9314ca1
--- /dev/null
+++ b/public/renderer/worker.js
@@ -0,0 +1,27 @@
+import createSmallpt from './smallpt.mjs';
+
+self.onmessage = async ({ data }) => {
+  try {
+    const { width, height, samples, seed, colors } = data;
+    const renderer = await createSmallpt();
+    renderer._setup(width, height, seed);
+    for (const [id, color] of Object.entries(colors)) renderer._set_color(Number(id), ...color);
+    const started = performance.now();
+    let lastUpdate = started;
+    const passes = samples / 4;
+    for (let pass = 0; pass < passes; pass++) {
+      for (let row = 0; row < height; row += 4) {
+        renderer._render_rows(row, Math.min(4, height - row));
+        const now = performance.now();
+        if (now - lastUpdate > 120 || row + 4 >= height) {
+          const pixels = renderer.HEAPU8.slice(renderer._pixel_buffer(), renderer._pixel_buffer() + width * height * 4);
+          self.postMessage({ pixels, progress: (pass + Math.min(row + 4, height) / height) / passes, samples: (pass + 1) * 4, elapsed: (now - started) / 1000, display: pass > 0 || row + 4 >= height, done: pass + 1 === passes && row + 4 >= height }, [pixels.buffer]);
+          lastUpdate = now;
+        }
+      }
+      renderer._finish_pass();
+    }
+  } catch (error) {
+    self.postMessage({ error: error instanceof Error ? error.message : String(error) });
+  }
+};
