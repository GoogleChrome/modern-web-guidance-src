+const canvas = document.querySelector<HTMLCanvasElement>('#render-canvas')!;
+const ctx = canvas.getContext('2d')!;
+const preview = document.querySelector<HTMLImageElement>('#preview')!;
+const resolution = document.querySelector<HTMLSelectElement>('#resolution')!;
+const status = document.querySelector<HTMLElement>('#render-status')!;
+const progress = document.querySelector<HTMLElement>('#progress')!;
+const samplesLabel = document.querySelector<HTMLElement>('#render-samples')!;
+const timeLabel = document.querySelector<HTMLElement>('#render-time')!;
+const swatches = [...document.querySelectorAll<HTMLElement>('.palette > span')];
+const qualityButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-samples]')];
+let samples = 64;
+let worker: Worker | undefined;
+let hasImage = false;
+let renderedOnce = false;
+let currentColors: Record<number, number[]>;
+const originalColors: Record<number, number[]> = {
+  0: [.55, .27, .64], 1: [.27, .65, .51], 2: [.75, .75, .75],
+  3: [0, 0, 0], 4: [.75, .75, .75], 5: [.75, .75, .75],
+  6: [.999, .999, .999], 7: [.999, .999, .999],
+};
+currentColors = structuredClone(originalColors);
+
+function randomValue() {
+  return crypto.getRandomValues(new Uint32Array(1))[0] / 4294967296;
+}
+function paletteColor(hue: number, saturation = .4, lightness = .59) {
+  const a = saturation * Math.min(lightness, 1 - lightness);
+  return [0, 8, 4].map(n => {
+    const k = (n + hue / 30) % 12;
+    return lightness - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+  });
+}
+function cssColor(color: number[]) {
+  return `rgb(${color.map(value => Math.round(Math.pow(value, 1 / 2.2) * 255)).join(' ')})`;
+}
+function run() {
+  worker?.terminate();
+  const width = Number(resolution.value);
+  const height = width * .75;
+  // Keep the last result visible while a replacement starts rendering.
+  if (canvas.width !== width || canvas.height !== height) {
+    if (hasImage) {
+      preview.src = canvas.toDataURL('image/png');
+      preview.hidden = false;
+    }
+    canvas.width = width;
+    canvas.height = height;
+    hasImage = false;
+  }
+  progress.style.width = '0%';
+  status.textContent = 'Tracing the light…';
+  timeLabel.textContent = '0.0s';
+  samplesLabel.textContent = `0 / ${samples} spp`;
+  document.querySelector('#status-dot')!.setAttribute('style', 'background:#adc18f');
+  try {
+    worker = new Worker('/renderer/worker.js', { type: 'module' });
+    worker.onmessage = ({ data }) => {
+      if (data.error) { showError(data.error); return; }
+      if (data.display) {
+        ctx.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, height), 0, 0);
+        preview.hidden = true;
+        hasImage = true;
