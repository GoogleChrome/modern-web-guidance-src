+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+em++ renderer/smallpt.cpp -O3 --no-entry -sMODULARIZE=1 -sEXPORT_ES6=1 -sENVIRONMENT=web,worker,node -sALLOW_MEMORY_GROWTH=1 -sEXPORTED_RUNTIME_METHODS='["HEAPU8"]'  -sSTACK_SIZE=1048576 -sEXPORTED_FUNCTIONS='["_setup","_set_color","_pixel_buffer","_render_rows","_finish_pass"]' -o public/renderer/smallpt.mjs
diff --git a/scripts/check-renderer.mjs b/scripts/check-renderer.mjs
new file mode 100644
index 0000000..7b8c6ec
--- /dev/null
+++ b/scripts/check-renderer.mjs
@@ -0,0 +1,50 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import createSmallpt from '../public/renderer/smallpt.mjs';
+
+const wasmBinary = await readFile(new URL('../public/renderer/smallpt.wasm', import.meta.url));
+assert(WebAssembly.validate(wasmBinary), 'The compiled file must be valid WebAssembly');
+const renderer = await createSmallpt({ wasmBinary });
+const width = 64, height = 48;
+function render(colors) {
+  renderer._setup(width, height, 12345);
+  for (const [id, color] of Object.entries(colors)) renderer._set_color(Number(id), ...color);
+  for (let pass = 0; pass < 4; pass++) {
+    // Use exactly the same incremental API as the browser worker.
+    for (let row = 0; row < height; row += 4) renderer._render_rows(row, 4);
+    renderer._finish_pass();
+  }
+  return renderer.HEAPU8.slice(renderer._pixel_buffer(), renderer._pixel_buffer() + width * height * 4);
+}
+const original = render({ 6: [.999, .999, .999], 7: [.999, .999, .999] });
+assert.equal(original.length, width * height * 4);
+assert(original.some((value, index) => index % 4 !== 3 && value > 0), 'Render must contain visible light');
+assert(original.every((value, index) => index % 4 !== 3 || value === 255), 'Alpha must remain opaque');
+assert.deepEqual(original, render({ 6: [.999, .999, .999], 7: [.999, .999, .999] }), 'A fixed seed must reproduce the same result');
+const recolored = render({ 6: [.9, .65, .75], 7: [.7, .9, .8] });
+let differences = 0;
+for (let i = 0; i < original.length; i++) if (original[i] !== recolored[i]) differences++;
+assert(differences > 100, 'Changing sphere colors must change the rendered image');
+console.log(`WebAssembly render passed: ${width}×${height}, 16 spp; ${differences} color channels changed with randomized sphere colors.`);
+
+renderer._setup(800, 600, 1);
+assert(renderer.HEAPU8.length >= renderer._pixel_buffer() + 800 * 600 * 4, 'Memory growth must support the largest resolution');
+let lastMessage;
+let messageCount = 0;
+globalThis.self = {
+  postMessage(message) {
+    assert(!message.error, message.error);
+    assert(message.progress >= 0 && message.progress <= 1);
+    assert.equal(message.pixels.length, width * height * 4);
+    lastMessage = message;
+    messageCount++;
+  },
+};
+await import('../public/renderer/worker.js');
+await self.onmessage({ data: { width, height, samples: 16, seed: 12345, colors: { 0: [.55, .27, .64], 1: [.27, .65, .51] } } });
+assert.equal(lastMessage.done, true);
+assert.equal(lastMessage.progress, 1);
+assert.equal(lastMessage.samples, 16);
+assert.equal(lastMessage.display, true);
+console.log(`Worker integration passed: ${messageCount} progressive image updates, complete at 16 spp.`);
+delete globalThis.self;
