+const element = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = element<HTMLCanvasElement>('output');
+const context = canvas.getContext('2d')!;
+const base = (document.querySelector('.app-shell') as HTMLElement).dataset.base!;
+const quality = element<HTMLSelectElement>('quality');
+const resolution = element<HTMLSelectElement>('resolution');
+const renderButton = element<HTMLButtonElement>('render');
+const initialColors = [[.75, .66, .38], [.38, .62, .52], [.999, .999, .999], [.94, .97, .999]];
+let colors = initialColors.map(c => [...c]);
+let worker: Worker | undefined;
+let rendering = false;
+let hasPixels = false;
+let currentSeed = 0;
+
+function paintPalette() {
+  document.querySelectorAll<HTMLElement>('.palette > span').forEach((swatch, i) => {
+    const css = colors[i].map(c => Math.round(Math.pow(c, 1 / 2.2) * 255));
+    swatch.style.setProperty('--swatch', `rgb(${css.join(',')})`);
+  });
+}
+function stop() {
+  worker?.terminate(); worker = undefined; rendering = false;
+  renderButton.querySelector('span')!.textContent = 'Render scene';
+}
+function fail(message: string) {
+  stop();
+  element('status').textContent = message;
+  element('viewport-label').textContent = 'RENDER ERROR';
+  element('status-dot').style.background = '#e7a989';
+}
+function render() {
+  stop();
+  if (!('WebAssembly' in window) || !('Worker' in window)) {
+    fail('WebAssembly and Web Workers are required.'); return;
+  }
+  const width = Number(resolution.value), height = width * .75;
+  const samples = Number(quality.value);
+  const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+  currentSeed = seed; hasPixels = false;
+  canvas.width = width; canvas.height = height;
+  element('resolution-label').textContent = `${width} × ${height}`;
+  element('sample-count').textContent = '0';
+  element('sample-target').textContent = String(samples);
+  element('elapsed').textContent = '0.0 s';
+  element('status').textContent = 'Tracing light…';
+  element('viewport-label').textContent = 'LIVE RENDER';
+  element('status-dot').style.background = '#c3db9b';
+  element('progress').style.width = '0%';
+  renderButton.querySelector('span')!.textContent = 'Stop rendering';
+  rendering = true;
+  try {
+    worker = new Worker(`${base}wasm/render-worker.js`, { type: 'module' });
+    worker.onerror = () => fail('Renderer failed to load. Try rendering again.');
+    worker.onmessage = ({ data }) => {
+      if (data.error) { fail('Render failed. Try a lower resolution.'); console.error(data.error); return; }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), data.width, data.height), 0, 0);
+      element('sample-count').textContent = String(data.samples);
+      hasPixels = true;
+      element('elapsed').textContent = `${data.elapsed.toFixed(1)} s`;
+      element('progress').style.width = `${data.progress * 100}%`;
+      if (data.done) {
+        stop();
+        element('status').textContent = 'Render complete';
+        element('viewport-label').textContent = 'RENDER COMPLETE';
+      }
+    };
+    worker.postMessage({ width, height, samples, colors, seed });
+  } catch (error) { fail('Could not start the renderer. Try again.'); console.error(error); }
+}
+renderButton.addEventListener('click', () => {
+  if (rendering) { stop(); element('status').textContent = 'Render paused'; element('viewport-label').textContent = 'PAUSED'; }
+  else render();
+});
+element('randomize').addEventListener('click', () => {
+  const values = crypto.getRandomValues(new Uint8Array(12));
+  colors = colors.map((_, i) => Array.from({ length: 3 }, (__, j) =>
+    (i < 2 ? .16 : .55) + values[i * 3 + j] / 255 * (i < 2 ? .64 : .44)));
+  paintPalette(); render();
+});
+element('reset').addEventListener('click', () => { colors = initialColors.map(c => [...c]); paintPalette(); render(); });
+quality.addEventListener('change', render);
+resolution.addEventListener('change', render);
+element('download').addEventListener('click', async () => {
+  // Export an independent snapshot, including the preview if rendering has not started.
+  const snapshot = document.createElement('canvas');
+  snapshot.width = canvas.width; snapshot.height = canvas.height;
+  const ctx = snapshot.getContext('2d')!;
+  if (!hasPixels) {
+    const preview = new Image(); preview.src = `${base}renders/cornell-preview.png`;
+    try { await preview.decode(); ctx.drawImage(preview, 0, 0, snapshot.width, snapshot.height); } catch { return; }
+  } else ctx.drawImage(canvas, 0, 0);
+  snapshot.toBlob(blob => {
+    if (!blob) return;
+    const link = document.createElement('a'); const url = URL.createObjectURL(blob);
+    link.href = url; link.download = `smallpt-${currentSeed}.png`; link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+window.addEventListener('pagehide', stop);
+paintPalette();
+render();
