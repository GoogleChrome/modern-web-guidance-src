diff --git a/scripts/build-wasm.sh b/scripts/build-wasm.sh
new file mode 100644
index 0000000..f15548c
--- /dev/null
+++ b/scripts/build-wasm.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+set -eu
+cd "$(dirname "$0")/.."
+mkdir -p public/wasm
+em++ native/browser.cpp -O3 -flto -fno-exceptions -Wno-c++11-narrowing -Wno-dangling-else -Wno-return-type --no-entry -sEXPORT_ES6=1 -sMODULARIZE=1 \
+  -sENVIRONMENT=web,worker -sSTRICT=1 -sALLOW_MEMORY_GROWTH=1 \
+  -sSTACK_SIZE=2097152 -sSTACK_OVERFLOW_CHECK=2 -sASSERTIONS=1 -sFILESYSTEM=0 -sEXPORTED_RUNTIME_METHODS=HEAPU8 \
+  -o public/wasm/smallpt.mjs
+
+cp native/LICENSE.txt public/wasm/LICENSE.txt
diff --git a/scripts/check-wasm.mjs b/scripts/check-wasm.mjs
new file mode 100644
index 0000000..a2120b4
--- /dev/null
+++ b/scripts/check-wasm.mjs
@@ -0,0 +1,41 @@
+// Command-line validation of the actual browser binary; no browser required.
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import sharp from 'sharp';
+const binary = await fs.readFile(new URL('../public/wasm/smallpt.wasm', import.meta.url));
+const module = await WebAssembly.compile(binary);
+const unsupported = () => { throw new Error('Unexpected runtime failure'); };
+const { exports: wasm } = await WebAssembly.instantiate(module, {
+  env: { __handle_stack_overflow: () => { throw new Error("Stack overflow"); }, _abort_js: unsupported, _emscripten_runtime_keepalive_clear() {},
+    emscripten_resize_heap: unsupported, _setitimer_js: unsupported },
+  wasi_snapshot_preview1: { fd_write: unsupported, fd_close: unsupported,
+    fd_seek: unsupported, proc_exit: unsupported },
+});
+wasm.emscripten_stack_init();
+wasm.__set_stack_limits(wasm.emscripten_stack_get_base(), wasm.emscripten_stack_get_end());
+wasm.__wasm_call_ctors();
+const pixels = (width, height) => new Uint8Array(wasm.memory.buffer, wasm.framebuffer(), width * height * 4).slice();
+wasm.setup(32, 24, 42);
+wasm.render_rows(0, 24);
+const before = pixels(32, 24);
+assert(before.some((v, i) => i % 4 !== 3 && v > 0), 'Image contains rendered light');
+assert(before.every((v, i) => i % 4 !== 3 || v === 255), 'Every pixel is opaque');
+wasm.setup(32, 24, 42);
+wasm.color(6, .65, .95, .55);
+wasm.color(7, .95, .55, .7);
+wasm.render_rows(0, 24);
+assert.notDeepEqual(pixels(32, 24), before, 'Sphere color changes alter the output');
+console.log('Wasm checks passed: rendered pixels, alpha, and randomized sphere colors.');
+if (process.argv.includes('--preview')) {
+  const width = 640, height = 480;
+  wasm.setup(width, height, 1042);
+  [[0, .75, .66, .38], [1, .38, .62, .52], [6, .999, .999, .999], [7, .94, .97, .999]]
+    .forEach(args => wasm.color(...args));
+  for (let pass = 0; pass < 64; pass++) {
+    for (let row = 0; row < height; row += 16) wasm.render_rows(row, Math.min(row + 16, height));
+  }
+  await fs.mkdir(new URL('../public/renders', import.meta.url), { recursive: true });
+  await sharp(pixels(width, height), { raw: { width, height, channels: 4 } })
+    .png().toFile(new URL('../public/renders/cornell-preview.png', import.meta.url).pathname);
+  console.log('Created 256-spp preview using the compiled WebAssembly binary.');
+}
