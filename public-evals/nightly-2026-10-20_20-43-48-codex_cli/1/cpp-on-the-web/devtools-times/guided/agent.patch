diff --git a/public/wasm/render-worker.js b/public/wasm/render-worker.js
new file mode 100644
index 0000000..74632d4
--- /dev/null
+++ b/public/wasm/render-worker.js
@@ -0,0 +1,30 @@
+import createSmallpt from './smallpt.mjs';
+
+const engine = createSmallpt();
+self.onmessage = async ({ data }) => {
+  try {
+    const module = await engine;
+    const { width, height, samples, colors, seed } = data;
+    module._setup(width, height, seed);
+    colors.forEach((rgb, i) => module._color([0, 1, 6, 7][i], ...rgb));
+    const started = performance.now();
+    for (let pass = 0; pass < samples / 4; pass++) {
+      for (let row = 0; row < height; row += 16) {
+        const end = Math.min(height, row + 16);
+        module._render_rows(row, end);
+        if (pass === 0 || end === height) {
+          const ptr = module._framebuffer();
+          const pixels = module.HEAPU8.slice(ptr, ptr + width * height * 4);
+          self.postMessage({ pixels, width, height,
+            progress: (pass + end / height) / (samples / 4),
+            samples: (pass + (end === height ? 1 : 0)) * 4,
+            elapsed: (performance.now() - started) / 1000,
+            done: pass === samples / 4 - 1 && end === height,
+          }, [pixels.buffer]);
+        }
+      }
+    }
+  } catch (error) {
+    self.postMessage({ error: error instanceof Error ? error.message : String(error) });
+  }
+};
