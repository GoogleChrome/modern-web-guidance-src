@@ -0,0 +1,48 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { runInNewContext } from 'node:vm';
+import { renderCounter } from '../component.mjs';
+
+test('server delivers a complete, styled counter before JavaScript', async () => {
+  const markup = renderCounter();
+  const page = (await readFile('index.html', 'utf8')).replace('<!-- SERVER_COMPONENT -->', markup);
+  assert.match(page, /<link rel="stylesheet" href="\/style.css">/);
+  assert.match(page, /<live-counter data-server-rendered="true"/);
+  assert.match(page, /<output aria-live="polite">0<\/output>/);
+  assert.match(page, /data-action="decrement"/);
+  assert.match(page, /data-action="increment"/);
+});
+
+test('hydration retains existing nodes and attaches behavior only once', async () => {
+  const output = { textContent: '0' };
+  const status = { textContent: 'Server rendered' };
+  const label = { textContent: '' };
+  const listeners = [];
+  const element = {
+    dataset: {},
+    querySelector: selector => selector === 'output' ? output : status,
+    addEventListener: (type, callback) => listeners.push(callback)
+  };
+  const document = { querySelector: selector => selector === 'live-counter' ? element : label };
+  const customElements = { define(name, Class) {
+    Object.setPrototypeOf(element, Class.prototype);
+    element.connectedCallback();
+  }};
+  const script = (await readFile('app.js', 'utf8')).split('const source =')[0];
+  runInNewContext(script, { document, customElements, HTMLElement: class {}, console });
+  assert.equal(element.querySelector('output'), output);
+  assert.equal(element.dataset.hydrated, 'true');
+  assert.equal(label.textContent, 'Hydrated in place');
+  element.connectedCallback();
+  assert.equal(listeners.length, 1);
+  const click = action => listeners[0]({ target: { closest: () => ({ dataset: { action } }) } });
+  click('increment');
+  click('increment');
+  assert.equal(output.textContent, 2);
+  click('decrement');
+  assert.equal(output.textContent, 1);
+  element.reset();
+  assert.equal(output.textContent, '0');
+  assert.equal(element.querySelector('output'), output);
+});
