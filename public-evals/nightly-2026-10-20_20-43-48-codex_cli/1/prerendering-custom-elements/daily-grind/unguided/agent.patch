new file mode 100644
index 0000000..1cc1428
--- /dev/null
+++ b/app.js
@@ -0,0 +1,72 @@
+const originalElement = document.querySelector('live-counter');
+const originalOutput = originalElement.querySelector('output');
+class LiveCounter extends HTMLElement {
+  connectedCallback() {
+    if (this.hydrated) return;
+    this.hydrated = true;
+    this.value = Number(this.querySelector('output').textContent);
+    this.addEventListener('click', (event) => {
+      const action = event.target.closest('[data-action]')?.dataset.action;
+      if (!action) return;
+      this.value += action === 'increment' ? 1 : -1;
+      this.querySelector('output').textContent = this.value;
+    });
+    this.querySelector('[data-counter-status]').textContent = 'Hydrated & interactive';
+    this.dataset.hydrated = 'true';
+  }
+  reset() {
+    this.value = 0;
+    this.querySelector('output').textContent = '0';
+  }
+}
+customElements.define('live-counter', LiveCounter);
+document.querySelector('#hydration-label').textContent = 'Hydrated in place';
+// These references are retained through the element's upgrade.
+console.assert(originalElement === document.querySelector('live-counter') && originalOutput === originalElement.querySelector('output'), 'Server DOM must be preserved');
+const source = `class LiveCounter extends HTMLElement {
+  connectedCallback() {
+    if (this.hydrated) return;
+    this.hydrated = true;
+    const output = this.querySelector('output');
+    this.addEventListener('click', (event) => {
+      const action = event.target.closest('[data-action]')?.dataset.action;
+      if (!action) return;
+      output.textContent = Number(output.textContent)
+        + (action === 'increment' ? 1 : -1);
+    });
+  }
+}
+customElements.define('live-counter', LiveCounter);`;
+document.querySelector('#main-code').textContent = source;
+function setView(view) {
+  document.querySelector('#preview-view').hidden = view !== 'preview';
+  document.querySelector('#code-view').hidden = view !== 'code';
+  document.querySelectorAll('[data-view]').forEach(button => {
+    const active = button.dataset.view === view;
+    button.classList.toggle('active', active);
+    button.setAttribute('aria-selected', String(active));
+  });
+}
+document.querySelectorAll('[data-view]').forEach(button => button.addEventListener('click', () => setView(button.dataset.view)));
+document.querySelector('#view-source').addEventListener('click', () => {setView('code'); document.querySelector('#code-view').scrollIntoView({ behavior: 'smooth', block: 'center' });});
+document.querySelectorAll('[data-theme]').forEach(button => button.addEventListener('click', () => {
+  document.querySelector('#preview-view').classList.toggle('dark', button.dataset.theme === 'dark');
+  document.querySelectorAll('[data-theme]').forEach(b => {b.classList.toggle('selected', b === button); b.setAttribute('aria-pressed', String(b === button));});
+}));
+let toastTimeout;
+function toast(message) {const el = document.querySelector('#toast'); el.textContent = message; el.hidden = false; clearTimeout(toastTimeout); toastTimeout = setTimeout(() => el.hidden = true, 2600);}
+document.querySelector('#reset').addEventListener('click', () => { originalElement.reset(); setView('preview'); toast('Counter reset. The original DOM is still in place.'); });
+document.querySelector('#copy-code').addEventListener('click', async () => {
+  try { await navigator.clipboard.writeText(source); toast('Component code copied'); }
+  catch { toast('Select the code to copy it manually.'); }
+});
+const dialog = document.querySelector('#info-dialog');
+function openInfo(title, html) { document.querySelector('#dialog-title').textContent = title; document.querySelector('#dialog-body').innerHTML = html; dialog.showModal(); }
+document.querySelector('#guide-button').addEventListener('click', () => openInfo('HTML first. Interaction next.', '<p>1. The server sends a complete <code>&lt;live-counter&gt;</code> element, along with its stylesheet.</p><p>2. The browser paints the styled HTML before JavaScript runs.</p><p>3. Registering the custom element upgrades it in place. Its connection callback attaches a click listener to the existing DOM.</p><p>Try the + and − controls, switch the preview theme, or explore the Code tab.</p>'));
+document.querySelectorAll('[data-section]').forEach(button => button.addEventListener('click', () => {
+  if (button.dataset.section === 'components') openInfo('Your components', '<p><code>&lt;live-counter&gt;</code></p><p>A server-rendered counter with increment and decrement controls. Registered, hydrated, and ready to use in your playground.</p>');
+  else if (button.dataset.section === 'activity') openInfo('Element activity', `<p>✓ Server HTML delivered<br>✓ Custom element registered<br>✓ Existing element upgraded<br>✓ Click listener attached</p><p>Current count: <strong>${originalElement.value}</strong><br>DOM replacements: <strong>0</strong></p>`);
+  else {setView('preview'); window.scrollTo({top:0, behavior:'smooth'});}
+}));
+document.querySelectorAll('.dialog-close, .dialog-done').forEach(button => button.addEventListener('click', () => dialog.close()));
+dialog.addEventListener('click', event => {if (event.target === dialog) {const r = dialog.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) dialog.close();}});
