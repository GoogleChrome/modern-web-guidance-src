new file mode 100644
index 0000000..b513ba3
--- /dev/null
+++ b/component.mjs
@@ -0,0 +1,9 @@
+export function renderCounter() {
+  return `<live-counter data-server-rendered="true" aria-label="Interactive counter">
+    <div class="counter-icon">↗</div>
+    <div class="counter-title">A little interaction.</div>
+    <p>Server-rendered. Ready when you are.</p>
+    <div class="counter-controls"><button data-action="decrement" aria-label="Decrease count">−</button><output aria-live="polite">0</output><button data-action="increment" aria-label="Increase count">+</button></div>
+    <div class="counter-footer"><span class="small-dot"></span><span data-counter-status>Server rendered</span><span class="component-tag">&lt;live-counter&gt;</span></div>
+  </live-counter>`;
+}
