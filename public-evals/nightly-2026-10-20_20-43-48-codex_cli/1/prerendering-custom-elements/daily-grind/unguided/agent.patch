diff --git a/server.mjs b/server.mjs
new file mode 100644
index 0000000..79d5edd
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,12 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { renderCounter } from './component.mjs';
+const assets = { '/style.css': ['style.css', 'text/css'], '/app.js': ['app.js', 'text/javascript'] };
+createServer(async (req, res) => {
+  try {
+    const asset = assets[new URL(req.url, 'http://localhost').pathname];
+    const body = asset ? await readFile(asset[0]) : (await readFile('index.html', 'utf8')).replace('<!-- SERVER_COMPONENT -->', renderCounter());
+    res.writeHead(200, { 'Content-Type': asset ? asset[1] : 'text/html; charset=utf-8' });
+    res.end(body);
+  } catch { res.writeHead(500); res.end('Unable to load the page.'); }
+}).listen(Number(process.env.PORT) || 11222, '0.0.0.0');
