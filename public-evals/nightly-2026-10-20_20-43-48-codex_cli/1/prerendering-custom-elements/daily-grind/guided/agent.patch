diff --git a/tests/hydration.test.mjs b/tests/hydration.test.mjs
new file mode 100644
index 0000000..a853962
--- /dev/null
+++ b/tests/hydration.test.mjs
@@ -0,0 +1,96 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { Window } from 'happy-dom';
+
+const html = readFileSync(new URL('../index.html', import.meta.url), 'utf8');
+const source = readFileSync(new URL('../app.js', import.meta.url), 'utf8').replace('export class', 'class');
+
+function page() {
+  const window = new Window({ settings: {
+    disableCSSFileLoading: true,
+    disableJavaScriptFileLoading: true,
+  } });
+  window.document.write(html);
+  return window;
+}
+
+function attachServerRoots(window) {
+  // Simulate the native HTML parser attaching DSD before module execution.
+  for (const card of window.document.querySelectorAll('coffee-card')) {
+    if (card.shadowRoot) continue;
+    const template = card.querySelector('template');
+    card.attachShadow({ mode: 'open' }).append(template.content);
+    template.remove();
+  }
+}
+
+test('server response contains complete styled product trees before JavaScript', () => {
+  const window = page();
+  const cards = [...window.document.querySelectorAll('coffee-card')];
+  assert.equal(cards.length, 5);
+  for (const card of cards) {
+    const root = card.shadowRoot ?? card.querySelector('template[shadowrootmode="open"]').content;
+    assert.ok(root.querySelector('style').textContent.includes(':host'));
+    assert.ok(root.querySelector('h3').textContent);
+    assert.ok(root.querySelector('button[aria-label]'));
+    assert.ok(root.querySelector('img[width][height]'));
+  }
+  window.happyDOM.abort();
+});
+
+test('hydration preserves every node and reconnecting does not duplicate listeners', () => {
+  const window = page();
+  attachServerRoots(window);
+  const card = window.document.querySelector('coffee-card');
+  const root = card.shadowRoot;
+  const nodes = [...root.querySelectorAll('*')];
+  const original = root.innerHTML;
+  // A second attachShadow call could clear the declarative root; forbid it.
+  card.attachShadow = () => { throw new Error('Must reuse server root'); };
+  window.eval(source);
+  assert.strictEqual(card.shadowRoot, root);
+  assert.equal(root.innerHTML, original);
+  assert.deepEqual([...root.querySelectorAll('*')], nodes);
+  card.remove();
+  window.document.querySelector('.product-grid').append(card);
+  root.querySelector('button').click();
+  assert.equal(window.document.querySelector('#bag-count').textContent, '1');
+  assert.equal(window.document.querySelector('#bag-total').textContent, '$5.50');
+  assert.equal(root.innerHTML, original);
+  window.happyDOM.abort();
+});
+
+test('fallback moves original template content into a shadow root', () => {
+  const window = page();
+  const card = window.document.querySelector('coffee-card');
+  const button = card.querySelector('template').content.querySelector('button');
+  window.eval(source);
+  assert.strictEqual(card.shadowRoot.querySelector('button'), button);
+  assert.equal(card.querySelector('template'), null);
+  button.click();
+  assert.equal(window.document.querySelector('#bag-count').textContent, '1');
+  window.happyDOM.abort();
+});
+
+test('filters and bag totals work across multiple server-rendered cards', () => {
+  const window = page();
+  attachServerRoots(window);
+  window.eval(source);
+  const document = window.document;
+  document.querySelector('[data-filter="tea"]').click();
+  const visible = [...document.querySelectorAll('coffee-card')].filter(card => !card.hidden);
+  assert.equal(visible.length, 2);
+  assert.ok(visible.every(card => card.dataset.category === 'tea'));
+  const button = visible[0].shadowRoot.querySelector('button');
+  button.click();
+  button.click();
+  assert.equal(document.querySelector('#bag-count').textContent, '2');
+  assert.equal(document.querySelector('#bag-total').textContent, '$11.50');
+  document.querySelector('.clear-bag').click();
+  assert.equal(document.querySelector('#bag-count').textContent, '0');
+  assert.equal(document.querySelector('#bag-total').textContent, '$0.00');
+  document.querySelector('[data-filter="all"]').click();
+  assert.equal([...document.querySelectorAll('coffee-card')].filter(card => !card.hidden).length, 5);
+  window.happyDOM.abort();
+});
