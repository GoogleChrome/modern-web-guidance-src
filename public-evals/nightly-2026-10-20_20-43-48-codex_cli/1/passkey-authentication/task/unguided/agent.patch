+  <script>
+    (() => {
+      const form = document.querySelector('#sign-in-form');
+      const username = document.querySelector('[data-testid="username-field"]');
+      const button = document.querySelector('[data-testid="auth-button"]');
+      const status = document.querySelector('[data-testid="auth-status"]');
+      let activeController;
+      let explicitSignIn = false;
+      let signedIn = false;
+
+      function decodeBase64url(value) {
+        const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+        const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, '=');
+        return Uint8Array.from(atob(padded), character => character.charCodeAt(0));
+      }
+
+      function encodeBase64url(value) {
+        return btoa(String.fromCharCode(...new Uint8Array(value)))
+          .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serializeCredential(credential) {
+        if (typeof credential.toJSON === 'function') return credential.toJSON();
+        return {
+          id: credential.id,
+          rawId: encodeBase64url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment,
+          clientExtensionResults: credential.getClientExtensionResults(),
+          response: {
+            clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+            authenticatorData: encodeBase64url(credential.response.authenticatorData),
+            signature: encodeBase64url(credential.response.signature),
+            userHandle: credential.response.userHandle == null
+              ? null : encodeBase64url(credential.response.userHandle)
+          }
+        };
+      }
+
+      async function authenticate(conditional) {
+        activeController?.abort();
+        const controller = new AbortController();
+        activeController = controller;
+        try {
+          // The server must issue and retain a fresh challenge in this session.
+          const optionsResponse = await fetch('/api/login/options', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(conditional ? {} : { username: username.value.trim() }),
+            signal: controller.signal
+          });
+          if (!optionsResponse.ok) throw new Error('Unable to start passkey sign-in. Please try again.');
+          const options = await optionsResponse.json();
+          const publicKey = { ...(options.publicKey || options) };
+          publicKey.challenge = decodeBase64url(publicKey.challenge);
+          publicKey.userVerification = 'required';
+          if (conditional) {
+            // Discoverable passkeys must not be restricted to a username or credential ID.
+            publicKey.allowCredentials = [];
+          } else if (publicKey.allowCredentials) {
+            publicKey.allowCredentials = publicKey.allowCredentials.map(credential => ({
+              ...credential, id: decodeBase64url(credential.id)
+            }));
+          }
+          if (controller.signal.aborted) return;
+          const credential = await navigator.credentials.get({
+            publicKey,
+            mediation: conditional ? 'conditional' : 'required',
+            signal: controller.signal
+          });
+          if (controller.signal.aborted) return;
+          if (!credential) throw new Error('No passkey was selected. Please try again.');
+          button.disabled = true;
+          status.textContent = 'Verifying your passkey…';
+          const verification = await fetch('/api/login/verify', {
+            method: 'POST',
+            credentials: 'same-origin',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(serializeCredential(credential)),
+            signal: controller.signal
+          });
+          if (!verification.ok) throw new Error('Passkey verification failed. Please try again.');
+          // Support both a JSON result and a successful empty response.
+          const result = verification.status === 204 ? null : await verification.text();
+          if (result && JSON.parse(result).success === false) {
+            throw new Error('Passkey verification failed. Please try again.');
+          }
+          if (controller.signal.aborted) return;
+          signedIn = true;
+          status.textContent = 'Successfully signed in with your passkey.';
+        } catch (error) {
+          if (controller.signal.aborted) return;
+          status.textContent = error.name === 'NotAllowedError'
+            ? 'Passkey sign-in was canceled or timed out. Please try again.'
+            : conditional
+              ? 'Passkey autofill is unavailable. Use the sign-in button to try again.'
+              : error.message || 'Unable to sign in. Please try again.';
+        } finally {
+          if (activeController === controller) {
+            activeController = null;
+            button.disabled = signedIn;
+          }
+        }
+      }
+
+      async function startAutofill() {
+        try {
+          const available = await PublicKeyCredential.isConditionalMediationAvailable?.();
+          if (available && !explicitSignIn && !signedIn && !activeController) {
+            await authenticate(true);
+          }
+        } catch {
+          // Explicit sign-in remains available if conditional mediation is unsupported.
+        }
+      }
+
+      form.addEventListener('submit', async event => {
+        event.preventDefault();
+        if (button.disabled || signedIn) return;
+        explicitSignIn = true;
+        button.disabled = true;
+        status.textContent = 'Use your device to verify your passkey…';
+        await authenticate(false);
+        explicitSignIn = false;
+        if (!signedIn) void startAutofill();
+      });
+
+      if (!window.PublicKeyCredential || !navigator.credentials?.get) {
+        button.disabled = true;
+        status.textContent = 'Passkeys are not supported in this browser. Use a supported browser over HTTPS.';
+      } else {
+        void startAutofill();
+      }
+    })();
+  </script>
 </body>
 
