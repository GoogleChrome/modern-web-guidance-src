+  <script src="./webauthn-polyfills.js"></script>
+  <script>
+    const signinForm = document.getElementById('signin-form');
+    const authButton = document.querySelector('[data-testid="auth-button"]');
+    const authStatus = document.getElementById('auth-status');
+    let activeRequest;
+    let authenticated = false;
+
+    async function authenticate(conditional) {
+      if (authenticated) return;
+
+      // Cancel both the options fetch and WebAuthn request before changing flows.
+      activeRequest?.abort();
+      const controller = new AbortController();
+      activeRequest = controller;
+      const { signal } = controller;
+
+      if (!conditional) {
+        authButton.disabled = true;
+        authStatus.textContent = 'Use your passkey to sign in…';
+      }
+
+      try {
+        if (conditional) {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          if (signal.aborted || !capabilities.conditionalGet) return;
+        }
+
+        // The server must store the challenge in the session and enforce user
+        // verification when verifying it. Never generate challenges in the client.
+        const optionsResponse = await fetch('/api/login/options', {
+          credentials: 'same-origin',
+          cache: 'no-store',
+          signal,
+        });
+        if (!optionsResponse.ok) throw new Error('Unable to start passkey sign-in. Please try again.');
+        const options = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseRequestOptionsFromJSON(options.publicKey ?? options);
+        publicKey.allowCredentials = [];
+        publicKey.userVerification = 'required';
+        if (signal.aborted) return;
+
+        const credential = await navigator.credentials.get({
+          publicKey,
+          mediation: conditional ? 'conditional' : 'required',
+          signal,
+        });
+        if (signal.aborted) return;
+        if (!credential) throw new Error('No passkey was selected. Please try again.');
+
+        authButton.disabled = true;
+        authStatus.textContent = 'Verifying your passkey…';
+        const encoded = credential.toJSON();
+        const verification = await fetch('/api/login/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(encoded),
+          signal,
+        });
+        if (!verification.ok) {
+          if (verification.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+            // Provider synchronization must never hide the verification error.
+            try {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId: publicKey.rpId ?? location.hostname,
+                credentialId: encoded.id,
+              });
+            } catch { /* This optional API may be unavailable in the provider. */ }
+          }
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        const result = await verification.json();
+        if (result.verified === false || result.success === false) {
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        if (signal.aborted) return;
+        authenticated = true;
+        authStatus.textContent = 'Signed in successfully.';
+      } catch (error) {
+        if (signal.aborted || error.name === 'AbortError') return;
+        if (error.name === 'NotAllowedError') {
+          if (!conditional) authStatus.textContent = 'Sign-in was cancelled or timed out. Please try again.';
+        } else {
+          authStatus.textContent = error instanceof TypeError
+            ? 'Unable to connect to passkey sign-in. Please try again.'
+            : error.message;
+        }
+      } finally {
+        if (activeRequest === controller) {
+          activeRequest = null;
+          authButton.disabled = authenticated;
+          // Restore autofill after an explicit prompt is dismissed or fails.
+          if (!conditional && !authenticated) void authenticate(true);
+        }
+      }
+    }
+
+    signinForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!authButton.disabled) void authenticate(false);
+    });
+
+    if (window.isSecureContext && window.PublicKeyCredential && navigator.credentials?.get) {
+      void authenticate(true);
+    } else {
+      authButton.disabled = true;
+      authStatus.textContent = 'Passkey sign-in requires HTTPS and a browser that supports passkeys.';
+    }
+  </script>
 </body>
 
