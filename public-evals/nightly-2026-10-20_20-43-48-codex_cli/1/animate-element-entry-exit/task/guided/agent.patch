+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    let promoCount = 0;
+    let busy = false;
+
+    // Probe actual behavior: some browsers parse allow-discrete without
+    // supporting display transitions.
+    function canTransitionDisplay() {
+      if (!window.CSS?.supports('transition-behavior', 'allow-discrete')) return false;
+      const probe = document.createElement('div');
+      probe.style.cssText = 'position: fixed; transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      const supported = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supported;
+    }
+
+    const supportsDisplayTransition = canTransitionDisplay();
+
+    function updateControls() {
+      removeBtn.disabled = busy || !domContainer.querySelector('.card');
+      toggleBtn.disabled = busy || !domContainer.contains(toggleCard);
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden && domContainer.contains(toggleCard)));
+    }
+
+    async function hideCard(card) {
+      if (card.hidden) return;
+      // Commit the visible style before starting an exit, even after a quick add.
+      getComputedStyle(card).opacity;
+      if (supportsDisplayTransition) {
+        card.hidden = true;
+      } else {
+        card.setAttribute('data-closing', '');
+      }
+      const animations = card.getAnimations();
+      let timeout;
+      await Promise.race([
+        Promise.allSettled(animations.map(animation => animation.finished)),
+        new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+      ]);
+      clearTimeout(timeout);
+      card.hidden = true;
+      card.removeAttribute('data-closing');
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Coffee Break Special ${++promoCount}`;
+      const description = document.createElement('p');
+      description.textContent = 'Discover a new favorite with our rotating coffee and bakery pairings.';
+      card.append(heading, description);
+      domContainer.appendChild(card);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const card = domContainer.querySelector('.card:last-child');
+      if (!card || busy) return;
+      busy = true;
+      updateControls();
+      await hideCard(card);
+      card.remove();
+      busy = false;
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', async () => {
+      if (busy || !domContainer.contains(toggleCard)) return;
+      busy = true;
+      updateControls();
+      if (toggleCard.hidden) {
+        toggleCard.hidden = false;
+      } else {
+        await hideCard(toggleCard);
+      }
+      busy = false;
+      updateControls();
+    });
+  </script>
 </body>
 
