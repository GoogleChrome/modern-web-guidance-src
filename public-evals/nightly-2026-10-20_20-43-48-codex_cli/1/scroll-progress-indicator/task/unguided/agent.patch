@@ -206,7 +235,52 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      if (window.CSS && CSS.supports('animation-timeline: scroll(root block)')) {
+        return;
+      }
+
+      var indicator = document.querySelector('.scroll-progress');
+      var scheduled = false;
+      var requestFrame = window.requestAnimationFrame || function (callback) {
+        return window.setTimeout(callback, 16);
+      };
+
+      function updateProgress() {
+        var root = document.documentElement;
+        var scrollTop = window.pageYOffset || root.scrollTop || 0;
+        var scrollRange = Math.max(root.scrollHeight, document.body.scrollHeight) - root.clientHeight;
+        var progress = scrollRange > 0 ? Math.min(1, Math.max(0, scrollTop / scrollRange)) : 0;
+
+        indicator.style.transform = 'scaleX(' + progress + ')';
+        indicator.style.visibility = 'visible';
+        scheduled = false;
+      }
+
+      function scheduleUpdate() {
+        if (!scheduled) {
+          scheduled = true;
+          requestFrame(updateProgress);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('load', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+
+      if ('ResizeObserver' in window) {
+        var observer = new ResizeObserver(scheduleUpdate);
+        observer.observe(document.documentElement);
+        observer.observe(document.body);
+      }
+
+      updateProgress();
+    }());
+  </script>
+
 </body>
 
 </html>
