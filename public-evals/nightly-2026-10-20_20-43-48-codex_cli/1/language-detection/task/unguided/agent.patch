+  <script>
+    const form = document.querySelector('#feedback-form');
+    const message = document.querySelector('#feedback-message');
+    const button = document.querySelector('#detect-button');
+    const status = document.querySelector('#detection-status');
+    const progress = document.querySelector('#model-progress');
+    let detector;
+
+    async function checkAvailability() {
+      if (!('LanguageDetector' in window)) {
+        status.textContent = 'Built-in language detection is not supported in this browser. Try a browser that supports the Language Detector API.';
+        return;
+      }
+
+      try {
+        const availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          status.textContent = 'Language detection is unavailable on this device.';
+          return;
+        }
+        status.textContent = availability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'The language model needs to download. Select Detect to get started.';
+        button.disabled = false;
+      } catch (error) {
+        status.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      const text = message.value.trim();
+      if (button.disabled) return;
+      if (!text) {
+        status.textContent = 'Please enter a message before detecting its language.';
+        message.focus();
+        return;
+      }
+
+      button.disabled = true;
+      message.disabled = true;
+      form.setAttribute('aria-busy', 'true');
+      status.textContent = 'Preparing language detection…';
+      try {
+        if (!detector) {
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percent = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+                progress.hidden = false;
+                progress.value = percent;
+                status.textContent = `Downloading language model: ${percent}%`;
+              });
+            }
+          });
+        }
+        progress.hidden = true;
+        status.textContent = 'Detecting language…';
+        const results = await detector.detect(text);
+        const result = results[0];
+        if (!result || result.detectedLanguage === 'und' || !Number.isFinite(result.confidence)) {
+          status.textContent = 'The language could not be identified. Try a longer message.';
+          return;
+        }
+
+        let language = result.detectedLanguage;
+        try {
+          language = new Intl.DisplayNames(['en'], { type: 'language' }).of(language) || language;
+        } catch (error) {
+          // Keep the browser's language code if a display name is unavailable.
+        }
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent', maximumFractionDigits: 1
+        }).format(result.confidence);
+        status.textContent = `Language: ${language}. AI confidence: ${confidence}.`;
+      } catch (error) {
+        detector?.destroy();
+        detector = undefined;
+        status.textContent = 'Language detection failed. Please try again. If the model needs downloading, check your internet connection.';
+      } finally {
+        progress.hidden = true;
+        button.disabled = false;
+        message.disabled = false;
+        form.removeAttribute('aria-busy');
+      }
+    });
+
+    message.addEventListener('input', () => {
+      if (!button.disabled) status.textContent = 'Select Detect to identify your message’s language.';
+    });
+
+    checkAvailability();
+  </script>
+
