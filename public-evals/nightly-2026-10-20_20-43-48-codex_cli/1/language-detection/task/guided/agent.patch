+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const detectButton = document.getElementById('detect-button');
+    const status = document.getElementById('feedback-status');
+    const download = document.getElementById('download-progress');
+    const progress = document.getElementById('model-progress');
+    const percentage = document.getElementById('download-percentage');
+    let availability;
+    let detector;
+    let busy = false;
+
+    function readyMessage() {
+      return availability === 'available'
+        ? 'Ready to detect your message’s language.'
+        : 'The language model needs to download. Click Detect to get started.';
+    }
+
+    async function checkAvailability() {
+      if (!('LanguageDetector' in window)) {
+        status.textContent = 'Built-in language detection is not supported in this browser. Try a supported desktop browser, such as Chrome.';
+        return;
+      }
+
+      try {
+        availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          status.textContent = 'Built-in language detection is unavailable on this device.';
+          return;
+        }
+        status.textContent = readyMessage();
+        detectButton.disabled = false;
+      } catch (error) {
+        status.textContent = 'Language detection availability could not be checked. Reload the page to try again.';
+      }
+    }
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (busy || detectButton.disabled) return;
+      const text = message.value.trim();
+      if (!text) {
+        status.textContent = 'Please enter a message before detecting its language.';
+        message.focus();
+        return;
+      }
+
+      busy = true;
+      detectButton.disabled = true;
+      message.readOnly = true;
+      status.textContent = 'Preparing language detection…';
+
+      try {
+        if (!detector) {
+          download.hidden = availability === 'available';
+          progress.value = 0;
+          percentage.textContent = '0%';
+          // Create directly from the user gesture, after the initial availability check.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percent = Math.max(0, Math.min(100, Math.round(event.loaded * 100)));
+                download.hidden = false;
+                progress.value = percent;
+                progress.textContent = `${percent}%`;
+                percentage.textContent = `${percent}%`;
+              });
+            }
+          });
+          availability = 'available';
+        }
+
+        download.hidden = true;
+        status.textContent = 'Detecting language…';
+        const [result] = await detector.detect(text);
+        if (!result || result.detectedLanguage === 'und') {
+          status.textContent = 'The language could not be identified. Try a longer message.';
+          return;
+        }
+
+        let language = result.detectedLanguage;
+        if (typeof Intl.DisplayNames === 'function') {
+          language = new Intl.DisplayNames(['en'], { type: 'language' }).of(language) || language;
+        }
+        const confidence = (result.confidence * 100).toFixed(1);
+        status.textContent = `Language: ${language}. AI confidence: ${confidence}%.`;
+      } catch (error) {
+        status.textContent = 'Language detection failed. Please try again. If the model needs downloading, check your connection.';
+        if (detector) detector.destroy();
+        detector = undefined;
+      } finally {
+        download.hidden = true;
+        busy = false;
+        detectButton.disabled = false;
+        message.readOnly = false;
+      }
+    });
+
+    message.addEventListener('input', () => {
+      if (!detectButton.disabled) status.textContent = readyMessage();
+    });
+
+    checkAvailability();
+  </script>
+
 </body>
 
