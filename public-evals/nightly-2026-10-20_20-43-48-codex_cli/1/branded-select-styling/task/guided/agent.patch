+  <script>
+    // Keep the full brand palette in browsers without customizable selects.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const select = document.getElementById('coffee-roast');
+      const wrapper = document.createElement('div');
+      wrapper.className = 'roast-fallback';
+      wrapper.innerHTML = `
+        <button type="button" class="roast-trigger" id="roast-trigger"
+          role="combobox" aria-haspopup="listbox" aria-expanded="false"
+          aria-controls="roast-options" aria-labelledby="roast-label roast-value">
+          <span id="roast-value"></span>
+        </button>
+        <ul class="roast-options" id="roast-options" role="listbox"
+          aria-labelledby="roast-label" hidden></ul>`;
+      select.after(wrapper);
+      select.hidden = true;
+      const trigger = wrapper.querySelector('button');
+      const list = wrapper.querySelector('ul');
+      const value = wrapper.querySelector('span');
+      document.getElementById('roast-label').htmlFor = trigger.id;
+      let active = select.selectedIndex;
+      let search = '';
+      let searchTimer;
+      const options = Array.from(select.options, (option, index) => {
+        const item = document.createElement('li');
+        item.id = `roast-option-${index}`;
+        item.setAttribute('role', 'option');
+        item.textContent = option.textContent;
+        item.addEventListener('click', () => choose(index));
+        list.append(item);
+        return item;
+      });
+      function render() {
+        value.textContent = select.options[select.selectedIndex].textContent;
+        options.forEach((option, index) => {
+          option.setAttribute('aria-selected', String(index === select.selectedIndex));
+          option.dataset.active = String(index === active);
+        });
+        if (!list.hidden) trigger.setAttribute('aria-activedescendant', options[active].id);
+      }
+      function open() {
+        active = select.selectedIndex;
+        list.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        render();
+      }
+      function close() {
+        list.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        trigger.removeAttribute('aria-activedescendant');
+      }
+      function choose(index) {
+        select.selectedIndex = index;
+        active = index;
+        select.dispatchEvent(new Event('change', { bubbles: true }));
+        close();
+        render();
+        trigger.focus();
+      }
+      trigger.addEventListener('click', () => list.hidden ? open() : close());
+      list.addEventListener('pointerdown', event => event.preventDefault());
+      trigger.addEventListener('keydown', (event) => {
+        if (event.key === 'Tab' || event.key === 'Escape') {
+          close();
+          return;
+        }
+        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+          event.preventDefault();
+          if (list.hidden) open();
+          else if (event.key === 'ArrowDown') active = (active + 1) % options.length;
+          else if (event.key === 'ArrowUp') active = (active + options.length - 1) % options.length;
+          if (event.key === 'Home') active = 0;
+          if (event.key === 'End') active = options.length - 1;
+          render();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          if (list.hidden) open();
+          else choose(active);
+        } else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
+          event.preventDefault();
+          if (list.hidden) open();
+          clearTimeout(searchTimer);
+          search += event.key.toLowerCase();
+          const match = options.findIndex(option => option.textContent.toLowerCase().startsWith(search));
+          if (match !== -1) active = match;
+          render();
+          searchTimer = setTimeout(() => { search = ''; }, 500);
+        }
+      });
+      document.addEventListener('pointerdown', event => {
+        if (!wrapper.contains(event.target)) close();
+      });
+      trigger.addEventListener('blur', close);
+      select.addEventListener('change', render);
+      render();
+    }
+  </script>
