+  <script>
+    const selector = document.querySelector('.roast-selector');
+    const trigger = document.getElementById('roast-trigger');
+    const list = document.getElementById('roast-list');
+    const options = Array.from(list.querySelectorAll('[role="option"]'));
+    const value = document.getElementById('roast-value');
+    const input = document.getElementById('roast-input');
+
+    function closeRoasts(returnFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openRoasts() {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    function selectRoast(option) {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      value.textContent = option.querySelector('span').textContent;
+      input.value = option.dataset.value;
+      closeRoasts(true);
+      input.dispatchEvent(new Event('change', { bubbles: true }));
+    }
+
+    trigger.addEventListener('click', () => list.hidden ? openRoasts() : closeRoasts());
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    list.addEventListener('click', event => {
+      const option = event.target.closest('[role="option"]');
+      if (option) selectRoast(option);
+    });
+
+    list.addEventListener('keydown', event => {
+      const index = options.indexOf(document.activeElement);
+      let next;
+      if (event.key === 'ArrowDown') next = (index + 1) % options.length;
+      if (event.key === 'ArrowUp') next = (index - 1 + options.length) % options.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = options.length - 1;
+      if (next !== undefined) {
+        event.preventDefault();
+        options[next].focus();
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        if (index >= 0) selectRoast(options[index]);
+      } else if (event.key === 'Escape') {
+        event.preventDefault();
+        closeRoasts(true);
+      }
+    });
+
+    document.addEventListener('click', event => {
+      if (!selector.contains(event.target)) closeRoasts();
+    });
+    selector.addEventListener('focusout', event => {
+      if (!selector.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
