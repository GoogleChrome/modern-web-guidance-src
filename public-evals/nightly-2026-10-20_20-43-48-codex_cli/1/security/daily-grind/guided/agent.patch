diff --git a/test/security.test.js b/test/security.test.js
new file mode 100644
index 0000000..380ae0f
--- /dev/null
+++ b/test/security.test.js
@@ -0,0 +1,174 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const { createServer, readConfig } = require('../server');
+
+async function app(t, env = {}, logs = []) {
+  const server = createServer({ config: readConfig(env), logReport: report => logs.push(report) });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  const base = `http://127.0.0.1:${server.address().port}`;
+  return { base, server, request: (url = '/', options) => fetch(base + url, options) };
+}
+const legacy = body => ({ method: 'POST', headers: { 'Content-Type': 'application/csp-report' },
+  body: JSON.stringify({ 'csp-report': body }) });
+
+function rawStatus(base, headers) {
+  return new Promise((resolve, reject) => {
+    const req = http.get(base, { headers }, res => { res.resume(); resolve(res.statusCode); });
+    req.on('error', reject);
+  });
+}
+
+test('enforced CSP matches static HTML and permits its CSS and stock image', async t => {
+  const { request } = await app(t);
+  const res = await request();
+  const csp = res.headers.get('content-security-policy');
+  for (const rule of ["default-src 'none'", "script-src 'none' 'report-sample'", "style-src 'self'",
+    'img-src https://images.unsplash.com', "require-trusted-types-for 'script'", "trusted-types 'none'",
+    "base-uri 'none'", "object-src 'none'", "frame-ancestors 'self'", 'report-uri /security-reports']) {
+    assert.ok(csp.includes(rule), rule);
+  }
+  assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval/);
+  const html = await res.text();
+  assert.doesNotMatch(html, /<script\b|<style\b|\sstyle=|\son\w+=/i);
+  assert.match(html, /href="\/styles.css"/);
+  assert.match(html, /action="\/logout" method="post"/);
+  const css = await request('/styles.css');
+  assert.equal(css.headers.get('content-type'), 'text/css; charset=utf-8');
+  assert.match(await css.text(), /https:\/\/images.unsplash.com/);
+});
+
+test('companion headers apply to pages, assets and errors', async t => {
+  const { request } = await app(t);
+  for (const route of ['/', '/styles.css', '/missing', '/logout']) {
+    const res = await request(route);
+    assert.equal(res.headers.get('x-content-type-options'), 'nosniff');
+    assert.equal(res.headers.get('x-frame-options'), 'SAMEORIGIN');
+    assert.equal(res.headers.get('cross-origin-opener-policy'), 'same-origin-allow-popups');
+    assert.equal(res.headers.get('cross-origin-resource-policy'), 'same-origin');
+    assert.equal(res.headers.get('cache-control'), 'no-store');
+    assert.match(res.headers.get('permissions-policy'), /camera=\(\)/);
+    assert.equal(res.headers.get('referrer-policy'), 'strict-origin-when-cross-origin');
+    assert.match(res.headers.get('vary'), /Sec-Fetch-Site/);
+    assert.equal(res.headers.get('cross-origin-embedder-policy'), null);
+    assert.equal(res.headers.get('access-control-allow-origin'), null);
+  }
+});
+
+test('staging mode retains baseline protection and reports the full candidate', async t => {
+  const { request } = await app(t, { CSP_MODE: 'report-only' });
+  const res = await request();
+  assert.match(res.headers.get('content-security-policy-report-only'), /require-trusted-types-for/);
+  assert.equal(res.headers.get('content-security-policy'), "frame-ancestors 'self'; object-src 'none'; base-uri 'none'");
+});
+
+test('production validates canonical HTTPS origin and uses short HSTS without trusting proxy headers', async t => {
+  for (const env of [{ NODE_ENV: 'production' }, { NODE_ENV: 'production', APP_ORIGIN: 'http://example.com' },
+    { APP_ORIGIN: 'https://user:pass@example.com' }, { APP_ORIGIN: 'https://example.com/path' },
+    { CSP_MODE: 'off' }, { HSTS_MAX_AGE: '-1' }, { HSTS_MAX_AGE: '31536001' }]) {
+    assert.throws(() => readConfig(env));
+  }
+  const { request } = await app(t, { NODE_ENV: 'production', APP_ORIGIN: 'https://coffee.example' });
+  const res = await request('/', { headers: { Host: 'attacker.example', 'X-Forwarded-Proto': 'http' } });
+  assert.equal(res.headers.get('strict-transport-security'), 'max-age=300');
+  assert.equal(res.headers.get('reporting-endpoints'), 'default="https://coffee.example/security-reports"');
+  assert.match(res.headers.get('content-security-policy'), /report-to default/);
+  const local = await app(t);
+  const localRes = await local.request('/', { headers: { 'X-Forwarded-Proto': 'https' } });
+  assert.equal(localRes.headers.get('strict-transport-security'), null);
+  assert.equal(localRes.headers.get('reporting-endpoints'), null);
+});
+
+test('resource isolation blocks cross-site and untrusted sibling fetches but allows navigation and legacy clients', async t => {
+  const { request, base } = await app(t);
+  for (const site of ['cross-site', 'same-site']) {
+    assert.equal((await request('/', { headers: { 'Sec-Fetch-Site': site } })).status, 403);
+  }
+  assert.equal(await rawStatus(base, { 'Sec-Fetch-Site': 'cross-site', 'Sec-Fetch-Mode': 'navigate', 'Sec-Fetch-Dest': 'document' }), 200);
+  assert.equal(await rawStatus(base, { 'Sec-Fetch-Site': 'cross-site', 'Sec-Fetch-Mode': 'navigate', 'Sec-Fetch-Dest': 'object' }), 403);
+  assert.equal((await request('/')).status, 200);
+});
+
+test('logout is POST-only, validates origin, and clears browser data only on success', async t => {
+  const { request } = await app(t, { APP_ORIGIN: 'https://coffee.example' });
+  assert.equal((await request('/logout')).status, 405);
+  for (const headers of [{}, { Origin: 'https://attacker.example' }, { Origin: 'null' }]) {
+    const res = await request('/logout', { method: 'POST', headers });
+    assert.equal(res.status, 403);
+    assert.equal(res.headers.get('clear-site-data'), null);
+  }
+  const res = await request('/logout', { method: 'POST', headers: { Origin: 'https://coffee.example' } });
+  assert.equal(res.status, 200);
+  assert.equal(res.headers.get('clear-site-data'), '"cookies", "storage", "cache"');
+});
+
+test('legacy and Reporting API reports log only allowlisted enums, discarding secrets', async t => {
+  const logs = [];
+  const { request } = await app(t, {}, logs);
+  assert.equal((await request('/security-reports', legacy({ 'effective-directive': 'script-src',
+    disposition: 'enforce', 'document-uri': 'https://coffee.example/?token=secret',
+    'script-sample': 'private data' }))).status, 204);
+  assert.equal((await request('/security-reports', { method: 'POST', headers: { 'Content-Type': 'application/reports+json' },
+    body: JSON.stringify([{ type: 'csp-violation', url: 'secret', body: { effectiveDirective: 'malicious\nsecret', disposition: 'private' } }]) })).status, 204);
+  assert.deepEqual(logs, [{ type: 'csp-violation', directive: 'script-src', disposition: 'enforce' },
+    { type: 'csp-violation', directive: 'other', disposition: 'unknown' }]);
+});
+
+test('collector rejects malformed, oversized and unsupported reports', async t => {
+  const { request } = await app(t);
+  assert.equal((await request('/security-reports')).status, 405);
+  assert.equal((await request('/security-reports', { method: 'POST', body: '{}' })).status, 415);
+  for (const body of ['{', 'null', '{}']) {
+    assert.equal((await request('/security-reports', { ...legacy({}), body })).status, 400);
+  }
+  assert.equal((await request('/security-reports', legacy({ sample: 'x'.repeat(17000) }))).status, 413);
+});
+
+test('collector bounds streamed requests without Content-Length', async t => {
+  const { server } = await app(t);
+  const status = await new Promise((resolve, reject) => {
+    const req = http.request({ host: '127.0.0.1', port: server.address().port, path: '/security-reports', method: 'POST',
+      headers: { 'Content-Type': 'application/csp-report', 'Transfer-Encoding': 'chunked' } }, res => {
+      res.resume(); resolve(res.statusCode);
+    });
+    req.on('error', reject);
+    req.write('x'.repeat(17000)); req.end();
+  });
+  assert.equal(status, 413);
+});
+
+test('collector rate limit bounds processing and logs', async t => {
+  const { request } = await app(t);
+  for (let i = 0; i < 60; i++) assert.equal((await request('/security-reports', legacy({}))).status, 204);
+  const res = await request('/security-reports', legacy({}));
+  assert.equal(res.status, 429);
+  assert.equal(res.headers.get('retry-after'), '60');
+});
+
+test('fixed routing preserves linked pages, handles HEAD and blocks unintended methods and files', async t => {
+  const { request } = await app(t);
+  for (const route of ['/menu', '/menu/seasonal', '/account', '/privacy-policy']) {
+    assert.equal((await request(route)).status, 200);
+  }
+  const head = await request('/', { method: 'HEAD' });
+  assert.equal(head.status, 200);
+  assert.equal(await head.text(), '');
+  for (const route of ['/server.js', '/package.json', '/.env', '/missing']) {
+    assert.equal((await request(route)).status, 404);
+  }
+  assert.equal((await request('/', { method: 'POST' })).status, 405);
+});
+
+test('malformed request targets and hostile Host values cannot crash the server', async t => {
+  const { server, request } = await app(t);
+  for (const target of ['//attacker.example/', 'http://attacker.example/']) {
+    const status = await new Promise((resolve, reject) => {
+      const req = http.request({ host: '127.0.0.1', port: server.address().port, path: target,
+        headers: { Host: '[malformed' } }, res => { res.resume(); resolve(res.statusCode); });
+      req.on('error', reject); req.end();
+    });
+    assert.equal(status, 400);
+  }
+  assert.equal((await request('/', { headers: { Host: '[malformed' } })).status, 200);
+});
