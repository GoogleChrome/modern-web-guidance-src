+++ b/test/security.test.js
@@ -0,0 +1,97 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const fs = require('node:fs');
+const { createServer, CSP } = require('../server');
+
+async function start(t, options) {
+  const server = createServer(options);
+  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise((resolve) => server.close(resolve)));
+  return (path = '/', { method = 'GET', headers = {}, body } = {}) => new Promise((resolve, reject) => {
+    const req = http.request({ host: '127.0.0.1', port: server.address().port, path, method, headers }, (res) => {
+      let data = '';
+      res.on('data', (chunk) => { data += chunk; });
+      res.on('end', () => resolve({ status: res.statusCode, headers: res.headers, body: data }));
+    });
+    req.on('error', reject);
+    req.end(body);
+  });
+}
+
+test('observation mode keeps pages and assets usable and secures all response paths', async (t) => {
+  const request = await start(t);
+  for (const route of ['/', '/menu', '/account', '/logout', '/.git/config', '/csp-report']) {
+    const response = await request(route);
+    assert.equal(response.headers['content-security-policy-report-only'], CSP);
+    assert.match(response.headers['content-security-policy'], /frame-ancestors 'none'/);
+    assert.equal(response.headers['x-content-type-options'], 'nosniff');
+    assert.equal(response.headers['x-frame-options'], 'DENY');
+    assert.equal(response.headers['referrer-policy'], 'strict-origin-when-cross-origin');
+    assert.match(response.headers['permissions-policy'], /camera=\(\)/);
+    assert.equal(response.headers['cache-control'], 'no-store');
+    assert.equal(response.headers['strict-transport-security'], undefined);
+  }
+  const home = await request('/');
+  assert.equal(home.status, 200);
+  assert.match(home.body, /href="\/styles.css"/);
+  assert.doesNotMatch(home.body, /<style\b|\sstyle=|<script\b|\son\w+=/i);
+  const css = await request('/styles.css');
+  assert.match(css.headers['content-type'], /text\/css/);
+  const urls = [...css.body.matchAll(/url\(['"]?(https?:[^'"\)]+)/g)].map((match) => new URL(match[1]));
+  assert.ok(urls.length > 0);
+  for (const url of urls) assert.equal(url.origin, 'https://images.unsplash.com');
+  assert.equal(css.body, fs.readFileSync('styles.css', 'utf8'));
+  assert.equal((await request('/', { method: 'HEAD' })).body, '');
+  assert.equal((await request('/.git/config')).status, 404);
+});
+
+test('enforcement and rollback are explicit, invalid configurations fail closed', async (t) => {
+  const request = await start(t, { cspMode: 'enforce' });
+  const response = await request('/');
+  assert.equal(response.headers['content-security-policy'], CSP);
+  assert.equal(response.headers['content-security-policy-report-only'], undefined);
+  assert.doesNotMatch(CSP, /unsafe-inline|unsafe-eval|\*/);
+  assert.throws(() => createServer({ cspMode: 'disabled' }), /CSP_MODE/);
+});
+
+test('rejects unsupported methods and malformed or external request targets without crashing', async (t) => {
+  const request = await start(t);
+  for (const method of ['POST', 'PUT', 'DELETE', 'TRACE']) {
+    const response = await request('/account', { method });
+    assert.equal(response.status, 405);
+    assert.equal(response.headers.allow, 'GET, HEAD');
+  }
+  for (const target of ['http://example.com/', '//example.com/', '/[']) {
+    const response = await request(target);
+    assert.equal(response.status, target === '/[' ? 200 : 400);
+  }
+  assert.equal((await request('/', { headers: { Host: '[' } })).status, 200);
+});
+
+test('report collection validates input, bounds size and volume, and omits private data', async (t) => {
+  const logs = [];
+  const request = await start(t, { logger: (line) => logs.push(line) });
+  const report = (body, type = 'application/csp-report') => request('/csp-report', {
+    method: 'POST', headers: { 'Content-Type': type }, body,
+  });
+  assert.equal((await report('{}', 'text/plain')).status, 415);
+  assert.equal((await report('{')).status, 400);
+  assert.equal((await report('{}')).status, 400);
+  assert.equal((await report('null')).status, 400);
+  assert.equal((await report(JSON.stringify({ 'csp-report': { 'effective-directive': 'script-src\nforged' } }))).status, 400);
+  assert.equal((await report('x'.repeat(17 * 1024))).status, 413);
+  const valid = JSON.stringify({ 'csp-report': {
+    'effective-directive': 'script-src-elem',
+    'document-uri': 'https://private.example/?token=secret',
+    'script-sample': '<sensitive>',
+  } });
+  assert.equal((await report(valid)).status, 204);
+  assert.deepEqual(JSON.parse(logs[0]), { event: 'csp-violation', directive: 'script-src-elem', mode: 'report-only' });
+  assert.doesNotMatch(logs.join(''), /secret|sensitive|private/);
+  let response;
+  for (let i = 0; i < 60; i++) response = await report(valid);
+  assert.equal(response.status, 429);
+  assert.equal(response.headers['retry-after'], '60');
+  assert.equal((await request('/')).status, 200);
+});
