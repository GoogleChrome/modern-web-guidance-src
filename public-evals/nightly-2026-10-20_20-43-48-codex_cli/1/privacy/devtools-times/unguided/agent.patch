+import test from 'node:test';
+import assert from 'node:assert/strict';
+import sessionStore from '../src/server/session-store.mjs';
+
+test('sessions expire without being read, and edits reset retention', (t) => {
+  t.mock.timers.enable({ apis: ['setTimeout'] });
+  const store = sessionStore({ ttlMs: 100 });
+  store.setItem('a', 'first');
+  t.mock.timers.tick(80);
+  store.setItem('a', 'edited');
+  t.mock.timers.tick(80);
+  assert.equal(store.getItem('a'), 'edited');
+  t.mock.timers.tick(21);
+  assert.equal(store.getItem('a'), null);
+});
+test('session capacity and explicit deletion bound stored data', () => {
+  const store = sessionStore({ maxSessions: 1 });
+  store.setItem('a', 'one');
+  store.setItem('b', 'two');
+  assert.equal(store.getItem('a'), null);
+  store.removeItem('b');
+  assert.deepEqual(store.getKeys(), []);
+  store.clear();
+});
