+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+
+// Set PRIVACY_TEST_ORIGIN to test an already-running production build.
+const origin = process.env.PRIVACY_TEST_ORIGIN;
+test('production responses protect data and enforce reading-list boundaries', { skip: !origin }, async () => {
+  const base = `${origin}/devtools-times/`;
+  const page = await fetch(base);
+  assert.equal(page.status, 200);
+  assert.equal(page.headers.get('set-cookie'), null, 'browsing must not create a session');
+  assert.equal(page.headers.get('x-content-type-options'), 'nosniff');
+  assert.equal(page.headers.get('x-frame-options'), 'DENY');
+  assert.equal(page.headers.get('referrer-policy'), 'no-referrer');
+  assert.match(page.headers.get('cache-control'), /no-store/);
+  assert.match(page.headers.get('content-security-policy'), /frame-ancestors 'none'/);
+  const html = await page.text();
+  const policy = page.headers.get('content-security-policy');
+  assert.match(policy, /default-src 'self'/);
+  assert.doesNotMatch(html, /<(?:script|img|link)[^>]+(?:src|href)="https?:\/\//);
+  assert.doesNotMatch(policy, /script-src[^;]+unsafe-inline/);
+  for (const [, attrs, content] of html.matchAll(/<script([^>]*)>([\s\S]*?)<\/script>/g)) {
+    if (/\bsrc=/.test(attrs) || /application\/(?:ld\+)?json/.test(attrs) || !content) continue;
+    const hash = createHash('sha256').update(content).digest('base64');
+    assert.ok(policy.includes(`sha256-${hash}`), 'inline script needs a CSP hash');
+  }
+  for (const route of ['signin', 'signup']) {
+    const account = await fetch(`${base}${route}`);
+    assert.doesNotMatch(await account.text(), /type="password"/);
+  }
+  const articles = await fetch(`${base}api/articles.json`).then(r => r.json());
+  for (const article of articles) {
+    const response = await fetch(`${base}articles/${article.slug}`);
+    assert.equal(response.status, 200, article.slug);
+    const articleHtml = await response.text();
+    const articlePolicy = response.headers.get('content-security-policy');
+    assert.doesNotMatch(articleHtml, /<(?:script|img|link)[^>]+(?:src|href)="https?:\/\//, article.slug);
+    assert.doesNotMatch(articleHtml, /document\.cookie\s*=/, article.slug);
+    for (const [, attrs, content] of articleHtml.matchAll(/<script([^>]*)>([\s\S]*?)<\/script>/g)) {
+      if (!content || /\bsrc=/.test(attrs)) continue;
+      const hash = createHash('sha256').update(content).digest('base64');
+      assert.ok(articlePolicy.includes(`sha256-${hash}`), `${article.slug}: script hash`);
+    }
+  }
+  const api = `${base}api/reading-list.json`;
+  const mutate = (body, headers = {}, method = 'POST') => fetch(api, {
+    method, headers: { 'Content-Type': 'application/json', Origin: origin, ...headers }, body,
+  });
+  assert.equal((await mutate('{')).status, 400);
+  assert.equal((await mutate(JSON.stringify({ slug: {} }))).status, 400);
+  assert.equal((await mutate(JSON.stringify({ slug: 'no-such-article' }))).status, 404);
+  assert.equal((await mutate('x'.repeat(1025))).status, 413);
+  assert.equal((await mutate('{}', { Origin: 'https://other.example' })).status, 403);
+  assert.equal((await fetch(api, { method: 'DELETE' })).status, 403);
+  assert.equal((await mutate('{}', { 'Content-Type': 'text/plain' })).status, 415);
+  const saved = await mutate(JSON.stringify({ slug: 'coffee-alchemy' }));
+  assert.equal(saved.status, 200);
+  assert.deepEqual(await saved.json(), { readingList: ['coffee-alchemy'] });
+  const cookie = saved.headers.get('set-cookie');
+  assert.match(cookie, /HttpOnly/i);
+  assert.match(cookie, /SameSite=Strict/i);
+  assert.match(cookie, /Secure/i);
+  const cookiePair = cookie.split(';')[0];
+  const read = () => fetch(api, { headers: { Cookie: cookiePair } }).then(r => r.json());
+  assert.deepEqual(await read(), { readingList: ['coffee-alchemy'] });
+  assert.deepEqual(await fetch(api).then(r => r.json()), { readingList: [] });
+  const deleted = await mutate(undefined, { Cookie: cookiePair }, 'DELETE');
+  assert.equal(deleted.status, 200);
+  assert.match(deleted.headers.get('set-cookie'), /Max-Age=0|1970/i);
+  assert.deepEqual(await read(), { readingList: [] });
+});
