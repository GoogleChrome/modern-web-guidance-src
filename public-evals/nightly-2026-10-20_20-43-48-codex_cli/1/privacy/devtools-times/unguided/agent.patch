diff --git a/src/server/session-store.mjs b/src/server/session-store.mjs
new file mode 100644
index 0000000..a3370c7
--- /dev/null
+++ b/src/server/session-store.mjs
@@ -0,0 +1,24 @@
+// Ephemeral, single-process storage: no user data is persisted to disk.
+export default function sessionStore({ ttlMs = 86_400_000, maxSessions = 10_000 } = {}) {
+  const entries = new Map();
+  const removeItem = (key) => {
+    clearTimeout(entries.get(key)?.timer);
+    entries.delete(key);
+  };
+  return {
+    name: 'ephemeral-sessions',
+    hasItem: (key) => entries.has(key),
+    getItem: (key) => entries.get(key)?.value ?? null,
+    setItem(key, value) {
+      removeItem(key);
+      if (entries.size >= maxSessions) removeItem(entries.keys().next().value);
+      const timer = setTimeout(() => removeItem(key), ttlMs);
+      timer.unref?.();
+      entries.set(key, { value, timer });
+    },
+    removeItem,
+    getKeys: () => [...entries.keys()],
+    clear() { for (const key of entries.keys()) removeItem(key); },
+    dispose() { this.clear(); },
+  };
+}
