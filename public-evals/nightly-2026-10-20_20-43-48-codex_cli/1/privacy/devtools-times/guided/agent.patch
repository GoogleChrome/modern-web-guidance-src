--- /dev/null
+++ b/src/components/PrivacyControls.tsx
@@ -0,0 +1,28 @@
+import { useState } from 'react';
+
+export default function PrivacyControls() {
+  const [message, setMessage] = useState('');
+  const [list, setList] = useState<string[] | null>(null);
+  const [busy, setBusy] = useState(false);
+  async function request(method: 'GET' | 'DELETE') {
+    setBusy(true);
+    setMessage('');
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, { method, cache: 'no-store' });
+      if (!response.ok) throw new Error();
+      const data = await response.json();
+      setList(data.readingList);
+      setMessage(method === 'DELETE' ? 'Your saved reading list and session have been deleted.' : 'These are the article identifiers saved in your current session.');
+    } catch {
+      setMessage('Unable to access your reading list. Please try again.');
+    } finally { setBusy(false); }
+  }
+  return <section className="my-6 border border-gray-300 rounded-lg p-4" aria-label="Reading list data controls">
+    <div className="flex flex-wrap gap-3">
+      <button type="button" disabled={busy} onClick={() => request('GET')} className="border rounded px-4 py-2 disabled:opacity-50">View my saved data</button>
+      <button type="button" disabled={busy} onClick={() => request('DELETE')} className="bg-gray-900 text-white rounded px-4 py-2 disabled:opacity-50">Delete my reading list</button>
+    </div>
+    <p role="status" aria-live="polite">{message}</p>
+    {list !== null && (list.length ? <ul>{list.map(slug => <li key={slug}>{slug}</li>)}</ul> : <p>No saved articles.</p>)}
+  </section>;
+}
