new file mode 100644
index 0000000..bc84f01
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,59 @@
+import http from 'node:http';
+import { readFile } from 'node:fs/promises';
+
+// Explicit public-file allowlist: never expose repository files or user-selected paths.
+const routes = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy', ['privacy.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy/', ['privacy.html', 'text/html; charset=utf-8']],
+  ['/assets/styles.css', ['assets/styles.css', 'text/css; charset=utf-8']],
+  ['/assets/coffee.jpg', ['assets/coffee.jpg', 'image/jpeg']],
+]);
+
+export function createServer({ httpsDeployment = false } = {}) {
+  return http.createServer(async (req, res) => {
+    // Apply controls to errors and assets as well as successful HTML responses.
+    res.setHeader('Content-Security-Policy', "default-src 'none'; style-src 'self'; img-src 'self'; script-src 'none'; connect-src 'none'; font-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'");
+    res.setHeader('Referrer-Policy', 'no-referrer');
+    res.setHeader('X-Content-Type-Options', 'nosniff');
+    res.setHeader('X-Frame-Options', 'DENY');
+    res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), display-capture=()');
+    res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+    res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+    res.setHeader('Cache-Control', 'no-store');
+    // Enable only behind HTTPS termination; do not trust client-supplied forwarding headers.
+    if (httpsDeployment) res.setHeader('Strict-Transport-Security', 'max-age=31536000');
+
+    const reply = (status, message) => {
+      res.writeHead(status, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end(req.method === 'HEAD' ? undefined : message);
+    };
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      return reply(405, 'Method not allowed');
+    }
+    let pathname;
+    try {
+      // Ignore query strings; never persist or reflect request data.
+      pathname = new URL(req.url, 'http://localhost').pathname;
+    } catch {
+      return reply(400, 'Invalid request');
+    }
+    const file = routes.get(pathname);
+    if (!file) return reply(404, 'Page not found');
+    try {
+      const data = await readFile(new URL(`./public/${file[0]}`, import.meta.url));
+      res.writeHead(200, { 'Content-Type': file[1], 'Content-Length': data.length });
+      res.end(req.method === 'HEAD' ? undefined : data);
+    } catch {
+      reply(500, 'Unable to load page');
+    }
+  });
+}
+
+if (import.meta.main) {
+  const server = createServer({ httpsDeployment: process.env.HTTPS_DEPLOYMENT === 'true' });
+  server.requestTimeout = 15_000;
+  server.headersTimeout = 10_000;
+  server.listen(Number(process.env.PORT || 11222), '0.0.0.0');
+}
diff --git a/test/privacy.test.mjs b/test/privacy.test.mjs
new file mode 100644
index 0000000..fcea586
--- /dev/null
+++ b/test/privacy.test.mjs
@@ -0,0 +1,54 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createServer } from '../server.mjs';
+import { readFile } from 'node:fs/promises';
+
+test('privacy controls protect successful, rejected, and asset responses', async (t) => {
+  const server = createServer({ httpsDeployment: true });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  const base = `http://127.0.0.1:${server.address().port}`;
+  for (const [path, method, status] of [
+    ['/', 'GET', 200], ['/privacy-policy', 'GET', 200],
+    ['/assets/styles.css', 'GET', 200], ['/assets/coffee.jpg', 'GET', 200],
+    ['/', 'HEAD', 200], ['/', 'POST', 405],
+    ['/.git/config', 'GET', 404], ['/package.json', 'GET', 404],
+    ['/server.mjs', 'GET', 404], ['/assets/%2e%2e/server.mjs', 'GET', 404],
+    ['/?email=private@example.com', 'GET', 200],
+  ]) {
+    const response = await fetch(base + path, { method });
+    assert.equal(response.status, status, `${method} ${path}`);
+    assert.equal(response.headers.get('set-cookie'), null);
+    assert.equal(response.headers.get('referrer-policy'), 'no-referrer');
+    assert.equal(response.headers.get('cache-control'), 'no-store');
+    assert.equal(response.headers.get('x-content-type-options'), 'nosniff');
+    assert.equal(response.headers.get('strict-transport-security'), 'max-age=31536000');
+    assert.match(response.headers.get('content-security-policy'), /script-src 'none'/);
+    assert.match(response.headers.get('content-security-policy'), /connect-src 'none'/);
+    assert.match(response.headers.get('content-security-policy'), /frame-ancestors 'none'/);
+    assert.match(response.headers.get('permissions-policy'), /geolocation=\(\)/);
+    const body = await response.text();
+    assert.ok(!body.includes('private@example.com'));
+    if (method === 'HEAD') assert.equal(body, '');
+  }
+});
+
+test('local development does not enable HSTS', async (t) => {
+  const server = createServer();
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  t.after(() => new Promise(resolve => server.close(resolve)));
+  const response = await fetch(`http://127.0.0.1:${server.address().port}`, {
+    headers: { 'X-Forwarded-Proto': 'https' },
+  });
+  assert.equal(response.headers.get('strict-transport-security'), null);
+  await response.text();
+});
+
+test('published pages contain no external resources, inline code, or data collection', async () => {
+  for (const file of ['index.html', 'privacy.html', 'assets/styles.css']) {
+    const source = await readFile(new URL(`../public/${file}`, import.meta.url), 'utf8');
+    assert.doesNotMatch(source, /https?:\/\/|<script\b|<form\b|<style\b|\bstyle=|\bon\w+=/i);
+  }
+  const home = await readFile(new URL('../public/index.html', import.meta.url), 'utf8');
+  assert.match(home, /href="\/privacy-policy"/);
+});
