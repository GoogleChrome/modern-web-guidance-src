+++ b/test/privacy.test.mjs
@@ -0,0 +1,104 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { once } from 'node:events';
+import { readFile } from 'node:fs/promises';
+import { createApp } from '../server.mjs';
+
+async function withServer(options, run) {
+  const server = createApp(options);
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  try {
+    await run('http://127.0.0.1:' + server.address().port);
+  } finally {
+    await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+  }
+}
+
+function checkHeaders(response) {
+  const h = response.headers;
+  assert.equal(h.get('referrer-policy'), 'no-referrer');
+  assert.equal(h.get('x-content-type-options'), 'nosniff');
+  assert.equal(h.get('x-frame-options'), 'DENY');
+  assert.equal(h.get('cache-control'), 'no-store');
+  assert.equal(h.get('cross-origin-resource-policy'), 'same-origin');
+  assert.equal(h.get('cross-origin-opener-policy'), 'same-origin');
+  assert.match(h.get('permissions-policy'), /camera=\(\).*microphone=\(\).*geolocation=\(\)/);
+  const csp = h.get('content-security-policy');
+  for (const directive of ["default-src 'none'", "script-src 'none'", "style-src 'self'",
+    "img-src 'self'", "connect-src 'none'", "frame-ancestors 'none'", "form-action 'none'",
+    "base-uri 'none'", "object-src 'none'"]) {
+    assert.ok(csp.split('; ').includes(directive), directive);
+  }
+  assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval|https:/);
+  assert.equal(h.get('set-cookie'), null);
+  assert.equal(h.get('reporting-endpoints'), null);
+  assert.equal(h.get('access-control-allow-origin'), null);
+}
+
+test('published pages and their assets resolve under the restrictive policy', async () => {
+  await withServer({ httpsOnly: false }, async base => {
+    for (const path of ['/', '/index.html', '/privacy-policy', '/privacy-policy/']) {
+      const response = await fetch(base + path);
+      assert.equal(response.status, 200);
+      checkHeaders(response);
+      assert.match(response.headers.get('content-type'), /^text\/html/);
+      const html = await response.text();
+      assert.doesNotMatch(html, /<script\b|<style\b|\sstyle=|<iframe\b|<form\b|<input\b/i);
+      // Audit every HTML resource reference, including URLs added in future changes.
+      for (const match of html.matchAll(/(?:src|href)\s*=\s*["']([^"']+)["']/gi)) {
+        assert.ok(match[1].startsWith('/'), 'Only local resources: ' + match[1]);
+        if (match[1].startsWith('/assets/')) {
+          const asset = await fetch(base + match[1]);
+          assert.equal(asset.status, 200);
+          checkHeaders(asset);
+        }
+      }
+    }
+    const cssResponse = await fetch(base + '/assets/styles.css');
+    const css = await cssResponse.text();
+    assert.doesNotMatch(css, /@import/i);
+    for (const match of css.matchAll(/url\(['"]?([^'")]+)['"]?\)/gi)) {
+      assert.ok(match[1].startsWith('/assets/'));
+      const asset = await fetch(base + match[1]);
+      assert.equal(asset.status, 200);
+      assert.equal(asset.headers.get('content-type'), 'image/jpeg');
+      const bytes = new Uint8Array(await asset.arrayBuffer());
+      assert.deepEqual([...bytes.slice(0, 3)], [255, 216, 255]);
+    }
+  });
+});
+
+test('private files, traversal, reflected secrets and unsupported methods are rejected', async () => {
+  await withServer({ httpsOnly: false }, async base => {
+    for (const path of ['/server.mjs', '/package.json', '/PRIVACY.md', '/.git/config',
+      '/assets/../server.mjs', '/%2e%2e%2fpackage.json', '/not-found?email=private@example.com',
+      '//example.com/', '/%ZZ']) {
+      const response = await fetch(base + path);
+      assert.equal(response.status, 404, path);
+      checkHeaders(response);
+      assert.equal(await response.text(), 'Page not found');
+    }
+    const post = await fetch(base + '/', { method: 'POST', body: 'private@example.com' });
+    assert.equal(post.status, 405);
+    assert.equal(post.headers.get('allow'), 'GET, HEAD');
+    checkHeaders(post);
+    assert.equal(await post.text(), 'Method not allowed');
+    const head = await fetch(base + '/', { method: 'HEAD' });
+    assert.equal(head.status, 200);
+    checkHeaders(head);
+    assert.equal(await head.text(), '');
+    const query = await fetch(base + '/?token=secret');
+    assert.equal(await query.text(), await readFile(new URL('../index.html', import.meta.url), 'utf8'));
+  });
+});
+
+test('HSTS and HTTPS upgrade require explicit TLS deployment configuration', async () => {
+  for (const httpsOnly of [false, true]) {
+    await withServer({ httpsOnly }, async base => {
+      const response = await fetch(base, { headers: { 'X-Forwarded-Proto': 'https' } });
+      assert.equal(response.headers.get('strict-transport-security'), httpsOnly ? 'max-age=300' : null);
+      assert.equal(response.headers.get('content-security-policy').includes('upgrade-insecure-requests'), httpsOnly);
+    });
+  }
+});
