new file mode 100644
index 0000000..1c646d9
--- /dev/null
+++ b/server.mjs
@@ -0,0 +1,61 @@
+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { pathToFileURL } from 'node:url';
+
+const routes = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy', ['privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy/', ['privacy-policy.html', 'text/html; charset=utf-8']],
+  ['/assets/styles.css', ['assets/styles.css', 'text/css; charset=utf-8']],
+  ['/assets/coffee.jpg', ['assets/coffee.jpg', 'image/jpeg']],
+]);
+
+// No request logging, cookies, identifiers, reporting payloads, or user storage.
+export function createApp({ httpsOnly = process.env.HTTPS_ONLY === 'true' } = {}) {
+  return createServer({ maxHeaderSize: 8192, requestTimeout: 15000, headersTimeout: 10000 }, async (req, res) => {
+    res.setHeader('Content-Security-Policy', [
+      "default-src 'none'", "script-src 'none'", "style-src 'self'",
+      "img-src 'self'", "connect-src 'none'", "object-src 'none'",
+      "base-uri 'none'", "frame-ancestors 'none'", "form-action 'none'",
+      "require-trusted-types-for 'script'", "trusted-types 'none'",
+      ...(httpsOnly ? ['upgrade-insecure-requests'] : []),
+    ].join('; '));
+    res.setHeader('Referrer-Policy', 'no-referrer');
+    res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()');
+    res.setHeader('X-Content-Type-Options', 'nosniff');
+    res.setHeader('X-Frame-Options', 'DENY');
+    res.setHeader('Cross-Origin-Opener-Policy', 'same-origin');
+    res.setHeader('Cross-Origin-Resource-Policy', 'same-origin');
+    res.setHeader('Cache-Control', 'no-store');
+    // Enable only behind an edge that enforces HTTPS. Never trust forwarded headers.
+    if (httpsOnly) res.setHeader('Strict-Transport-Security', 'max-age=300');
+
+    const respond = (status, body, type = 'text/plain; charset=utf-8') => {
+      res.writeHead(status, { 'Content-Type': type });
+      res.end(req.method === 'HEAD' ? undefined : body);
+    };
+    if (!['GET', 'HEAD'].includes(req.method)) {
+      res.setHeader('Allow', 'GET, HEAD');
+      respond(405, 'Method not allowed');
+      return;
+    }
+    // Exact allowlist: never resolve request paths against the filesystem.
+    const route = routes.get((req.url ?? '').split('?')[0]);
+    if (!route) {
+      respond(404, 'Page not found');
+      return;
+    }
+    try {
+      const contents = await readFile(new URL(route[0], import.meta.url));
+      respond(200, contents, route[1]);
+    } catch {
+      // Do not reflect URLs, headers, filesystem paths, or exception details.
+      respond(500, 'Unable to serve this page');
+    }
+  });
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  createApp().listen(Number(process.env.PORT ?? 11222), '0.0.0.0');
+}
