+  <script type="module">
+    const rewardsButton = document.querySelector('.rewards-toggle');
+    const rewardsPopover = document.getElementById('rewards-popover');
+
+    // Keep the expanded state accessible with native controls and either polyfill.
+    rewardsPopover.addEventListener('toggle', (event) => {
+      rewardsButton.setAttribute('aria-expanded', String(event.newState === 'open'));
+    });
+
+    async function loadRequiredPolyfills() {
+      // Invoker commands depend on the Popover API: finish installing it first.
+      if (!('popover' in HTMLElement.prototype)) {
+        await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+      }
+
+      if (!('commandForElement' in HTMLButtonElement.prototype)) {
+        await import('https://esm.run/invokers-polyfill');
+      }
+    }
+
+    loadRequiredPolyfills().catch((error) => {
+      console.error('Unable to load rewards popover support:', error);
+    });
+  </script>
