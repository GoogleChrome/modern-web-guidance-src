+  <script type="module">
+    const rewardsButton = document.querySelector('.rewards-toggle');
+    const rewardsPopover = document.getElementById('rewards-popover');
+
+    if ('showPopover' in HTMLElement.prototype) {
+      rewardsPopover.addEventListener('toggle', (event) => {
+        rewardsButton.setAttribute('aria-expanded', String(event.newState === 'open'));
+      });
+    } else {
+      let fallback;
+      rewardsButton.addEventListener('click', async () => {
+        rewardsButton.disabled = true;
+        try {
+          fallback ??= import('./rewards-popover-fallback.js');
+          const { toggleRewardsPopover } = await fallback;
+          toggleRewardsPopover(rewardsPopover, rewardsButton);
+        } catch (error) {
+          fallback = undefined;
+          console.error('Unable to load rewards popover support.', error);
+        } finally {
+          rewardsButton.disabled = false;
+        }
+      });
+    }
+  </script>
