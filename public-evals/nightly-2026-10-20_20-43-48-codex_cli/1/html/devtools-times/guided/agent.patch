+}
+
+:focus-visible {
+  outline: 3px solid #92400e;
+  outline-offset: 3px;
+}
+
+.skip-link {
+  position: fixed;
+  top: 1rem;
+  left: 1rem;
+  transform: translateY(-200%);
+  padding: 0.75rem 1rem;
+  background: white;
+  color: #111827;
+  z-index: 100;
+}
+.skip-link:focus { transform: translateY(0); }
+
+.app-dialog {
+  width: min(42rem, calc(100% - 2rem));
+  max-height: calc(100dvh - 2rem);
+  margin: auto;
+  padding: 0;
+  overflow-y: auto;
+  border: 1px solid #d1d5db;
+}
+.app-dialog::backdrop {
+  background: rgb(255 255 255 / 0.5);
+  backdrop-filter: blur(4px);
+}
+body:has(dialog[open]) { overflow: hidden; }
+
+.navigation-popover {
+  position: fixed;
+  inset: var(--popover-top, 8rem) 0 auto;
+  margin-inline: auto;
+  width: min(72rem, calc(100% - 2rem));
+  max-height: calc(100dvh - var(--popover-top, 8rem) - 1rem);
+  overflow-y: auto;
+  padding: 1rem;
+  color: #111827;
+}
+/* Keep unsupported browsers from displaying closed polyfilled popovers. */
+[popover]:is(:popover-open, .\:popover-open) { display: block; }
