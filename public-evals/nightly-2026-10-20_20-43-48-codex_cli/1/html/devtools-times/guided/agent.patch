@@ -0,0 +1,26 @@
+import { useId, type ReactNode } from 'react';
+
+export default function NavigationPopover({ label, children }: { label: string; children: ReactNode }) {
+  const id = useId();
+  return (
+    <>
+      <button type="button" popoverTarget={id} onClick={event => {
+        const panel = event.currentTarget.nextElementSibling;
+        const bottom = (event.currentTarget.closest('header') ?? event.currentTarget).getBoundingClientRect().bottom;
+        if (panel instanceof HTMLElement) {
+          panel.style.setProperty('--popover-top', `${Math.min(Math.max(16, bottom + 8), window.innerHeight - 160)}px`);
+        }
+      }} className="flex items-center gap-1 whitespace-nowrap py-2 hover:text-amber-800">
+        {label}
+        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" className="w-3 h-3"><path d="m6 9 6 6 6-6" /></svg>
+      </button>
+      <div id={id} popover="auto" className="navigation-popover bg-white border border-gray-300 shadow-lg">
+        <div className="flex justify-between items-center gap-4 mb-4">
+          <h2 className="font-semibold">{label}</h2>
+          <button type="button" popoverTarget={id} popoverTargetAction="hide" aria-label={`Close ${label}`} className="p-2">✕</button>
+        </div>
+        {children}
+      </div>
+    </>
+  );
+}
