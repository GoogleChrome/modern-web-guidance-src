+    'Lifestyle & Sports': ['lifestyle', 'sports', 'Urban Development'],
+  };
+  return (
+    <nav aria-label="Sections" className="border-y border-gray-900">
+      <ul className="container mx-auto px-4 flex items-center gap-6 text-sm font-semibold overflow-x-auto">
+        {Object.entries(groups).map(([label, sections]) => {
+          const matchingCategories = categories.filter(category => sections.some(section => section.toLowerCase() === category.toLowerCase()));
+          return (
+            <li key={label}>
+              <NavigationPopover label={label}>
+                <FlyoutMenu categories={matchingCategories} articles={articles.filter(article => matchingCategories.includes(article.data.category))} reports={reports.filter(item => item.data.category === label)} multimedia={multimedia.filter(item => item.data.category === label)} />
+              </NavigationPopover>
+            </li>
+          );
+        })}
+      </ul>
+    </nav>
+  );
+}
