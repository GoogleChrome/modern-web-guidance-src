diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..e7f9c8f
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,49 @@
+import { useEffect, useId, useRef, type ReactNode } from 'react';
+
+interface Props {
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+/** The browser owns modality, Escape dismissal, and the focus boundary. */
+export default function Modal({ title, onClose, children }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+  const titleId = useId();
+
+  useEffect(() => {
+    const dialog = ref.current!;
+    const invoker = document.activeElement;
+    dialog.showModal();
+    return () => {
+      dialog.close();
+      if (invoker instanceof HTMLElement && invoker.isConnected) invoker.focus();
+    };
+  }, []);
+
+  return (
+    <dialog
+      ref={ref}
+      aria-labelledby={titleId}
+      closedby="any"
+      className="app-dialog bg-white shadow-xl"
+      onClose={onClose}
+      onClick={event => {
+        // Light-dismiss fallback for browsers without closedby support.
+        if ('closedBy' in HTMLDialogElement.prototype || event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
+          event.currentTarget.close();
+        }
+      }}
+    >
+      <header className="flex items-center justify-between gap-4 border-b border-gray-200 p-4">
+        <h2 id={titleId} className="text-lg font-semibold text-gray-800">{title}</h2>
+        <form method="dialog">
+          <button type="submit" aria-label={`Close ${title}`} className="p-2 text-gray-600 hover:text-amber-700">✕</button>
+        </form>
+      </header>
+      {children}
+    </dialog>
+  );
+}
