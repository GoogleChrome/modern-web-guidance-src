diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..d70f469
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,39 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+/** Native modal behavior includes focus containment, Escape and an inert background. */
+export default function Modal({ id, title, onClose, children }: Props) {
+  const ref = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = ref.current!;
+    const opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
+    dialog.showModal();
+    dialog.querySelector<HTMLElement>('[data-initial-focus]')?.focus();
+    return () => {
+      dialog.close();
+      if (opener?.isConnected) opener.focus();
+    };
+  }, []);
+
+  return (
+    <dialog ref={ref} id={id} aria-labelledby={`${id}-title`} className="modal bg-white shadow-xl w-full max-w-2xl" onClose={onClose}
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) event.currentTarget.close();
+      }}>
+      <div className="p-4 flex items-center justify-between gap-4 border-b border-gray-200">
+        <h2 tabIndex={-1} id={`${id}-title`} className="text-lg font-semibold">{title}</h2>
+        <button type="button" aria-label={`Close ${title.toLowerCase()}`} className="p-2 text-gray-600 hover:text-amber-700" onClick={() => ref.current?.close()}>✕</button>
+      </div>
+      {children}
+    </dialog>
+  );
+}
