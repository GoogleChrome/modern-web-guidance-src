diff --git a/script.js b/script.js
new file mode 100644
index 0000000..273c0b4
--- /dev/null
+++ b/script.js
@@ -0,0 +1,41 @@
+// Keep the original menu links when native dialogs are unavailable or JS is off.
+const dialog = document.querySelector('#drink-details');
+
+if (typeof dialog?.showModal === 'function') {
+  const title = dialog.querySelector('#drink-title');
+  const description = dialog.querySelector('#drink-description');
+  const menuLink = dialog.querySelector('#drink-menu-link');
+
+  document.querySelectorAll('[data-drink-details]').forEach((link) => {
+    const card = link.closest('article');
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = link.className;
+    button.textContent = link.textContent;
+    button.setAttribute('aria-label', link.getAttribute('aria-label'));
+    button.setAttribute('aria-haspopup', 'dialog');
+    button.setAttribute('aria-controls', dialog.id);
+
+    button.addEventListener('click', () => {
+      title.textContent = card.querySelector('h3').textContent;
+      description.textContent = card.querySelector('p').textContent;
+      menuLink.href = link.href;
+      // Native modality handles background inertness, focus containment, Escape,
+      // initial autofocus, and returning focus to this button on dismissal.
+      dialog.showModal();
+    });
+
+    link.replaceWith(button);
+  });
+
+  // Safari and other browsers without closedby still get backdrop dismissal.
+  if (!('closedBy' in HTMLDialogElement.prototype)) {
+    dialog.addEventListener('click', (event) => {
+      if (event.target !== dialog) return;
+      const { top, right, bottom, left } = dialog.getBoundingClientRect();
+      const inside = event.clientX >= left && event.clientX <= right
+        && event.clientY >= top && event.clientY <= bottom;
+      if (!inside) dialog.close();
+    });
+  }
+}
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..dcdd48e
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,262 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+.site-header {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  position: sticky;
+  top: 0;
+  z-index: 1000;
+  flex-wrap: wrap;
+  gap: 1rem;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+.primary-nav ul {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem 1.25rem;
+  list-style: none;
+}
+
+.primary-nav li {
+  margin: 0;
+}
+
+.site-header a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+.site-header a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  position: relative;
+  isolation: isolate;
+  min-height: 60vh;
+  background: var(--primary);
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 40px 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  list-style: none;
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  height: 100%;
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  border: 0;
+  font: inherit;
+  cursor: pointer;
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Keep keyboard navigation visible and clear of the sticky header. */
+:focus-visible {
+  outline: 3px solid #a64300;
+  outline-offset: 4px;
+}
+
+.site-header :focus-visible,
+.hero :focus-visible {
+  outline-color: var(--accent);
+}
+
+#main-content {
+  scroll-margin-top: 8rem;
+}
+
+.skip-link {
+  position: fixed;
+  top: 1rem;
+  left: 1rem;
+  z-index: 1100;
+  padding: 0.75rem 1rem;
+  background: white;
+  color: var(--text);
+  transform: translateY(-200%);
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+.site-header .logo {
+  font-size: 1.5rem;
+}
+
+.hero-image,
+.hero::before {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+}
+
+.hero-image {
+  object-fit: cover;
+  z-index: -2;
+}
+
+.hero::before {
+  content: "";
+  background: rgb(0 0 0 / 50%);
+  z-index: -1;
+}
+
+.section-title {
+  text-align: center;
+}
+
+.footer-links ul {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 0.5rem 1.25rem;
+  list-style: none;
+}
+
+.drink-dialog {
+  margin: auto;
+  width: min(32rem, calc(100% - 2rem));
+  max-height: calc(100dvh - 2rem);
+  overflow: auto;
+  padding: 1.5rem;
+  border: 0;
+  border-radius: 8px;
+  color: var(--text);
+  background: var(--light);
+}
+
+.drink-dialog::backdrop {
+  background: rgb(0 0 0 / 60%);
+}
+
+.dialog-close {
+  display: block;
+  margin: 0 0 1rem auto;
+  padding: 0.5rem 0.75rem;
+  border: 1px solid var(--primary);
+  border-radius: 4px;
+  background: white;
+  color: var(--text);
+  font: inherit;
+  cursor: pointer;
+}
+
+@media (max-width: 600px) {
+  .site-header {
+    position: static;
+  }
+
+  .hero h1 {
+    font-size: 2.25rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    transition: none !important;
+  }
+}
