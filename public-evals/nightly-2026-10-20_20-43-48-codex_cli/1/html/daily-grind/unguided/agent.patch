diff --git a/app.js b/app.js
new file mode 100644
index 0000000..14d6a3d
--- /dev/null
+++ b/app.js
@@ -0,0 +1,23 @@
+const accountPopover = document.querySelector("#account-menu");
+const accountTrigger = document.querySelector('[popovertarget="account-menu"]');
+
+// Native dialogs provide modal focus containment, Escape handling, and inertness.
+// Explicit restoration also covers a trigger inside a popover that has closed.
+for (const trigger of document.querySelectorAll("[data-dialog]")) {
+  trigger.addEventListener("click", () => {
+    const dialog = document.getElementById(trigger.dataset.dialog);
+    if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
+
+    const openedFromAccount = accountPopover.contains(trigger);
+    if (accountPopover.matches(":popover-open")) accountPopover.hidePopover();
+    dialog.addEventListener(
+      "close",
+      () => {
+        const returnTarget = openedFromAccount ? accountTrigger : trigger;
+        returnTarget.focus({ preventScroll: true });
+      },
+      { once: true },
+    );
+    dialog.showModal();
+  });
+}
