@@ -0,0 +1,647 @@
+:root {
+  color-scheme: light;
+  --paper: #f7f4ee;
+  --ink: #302a24;
+  --muted: #71685e;
+  --accent: #cc653c;
+  --line: #ded9cf;
+  font-family: Arial, Helvetica, sans-serif;
+  color: var(--ink);
+  background: var(--paper);
+  font-synthesis: none;
+}
+* {
+  box-sizing: border-box;
+}
+body {
+  margin: 0;
+}
+a {
+  color: inherit;
+  text-decoration: none;
+}
+button,
+input {
+  font: inherit;
+}
+button,
+a {
+  -webkit-tap-highlight-color: transparent;
+}
+button {
+  cursor: pointer;
+}
+button:disabled {
+  cursor: default;
+}
+button {
+  color: inherit;
+}
+img {
+  display: block;
+  max-width: 100%;
+}
+p,
+h1,
+h2,
+h3 {
+  margin: 0;
+}
+a:focus-visible,
+button:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 5px;
+}
+main:focus {
+  outline: none;
+}
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+  border: 0;
+}
+.skip-link {
+  position: fixed;
+  top: 12px;
+  left: 12px;
+  padding: 14px 20px;
+  background: var(--paper);
+  z-index: 10;
+  transform: translateY(-150%);
+}
+.skip-link:focus {
+  transform: translateY(0);
+}
+.container {
+  width: min(1240px, calc(100% - 112px));
+  margin-inline: auto;
+}
+.site-header {
+  min-height: 104px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 22px 56px;
+  gap: 24px;
+}
+.brand {
+  display: flex;
+  align-items: center;
+  gap: 13px;
+  font-size: 13px;
+  font-weight: 800;
+  letter-spacing: 1.5px;
+  white-space: nowrap;
+}
+.brand-mark {
+  font-family: Georgia, serif;
+  font-size: 39px;
+  letter-spacing: -5px;
+  line-height: 1;
+  border: 1px solid var(--ink);
+  width: 53px;
+  height: 53px;
+  display: grid;
+  place-items: center;
+  padding-right: 5px;
+  border-radius: 50%;
+}
+.brand small {
+  display: block;
+  font-size: 8px;
+  letter-spacing: 1.9px;
+  font-weight: 500;
+  margin-top: 7px;
+}
+.nav-list,
+.footer-links,
+.product-grid {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+.nav-list {
+  display: flex;
+  align-items: center;
+  gap: 36px;
+  font-size: 13px;
+}
+.nav-list a:hover,
+.footer-links a:hover,
+.text-link:hover {
+  color: var(--accent);
+}
+.account-button {
+  display: flex;
+  gap: 18px;
+  align-items: center;
+  border: 1px solid #bbb4a9;
+  background: transparent;
+  padding: 13px 17px;
+  border-radius: 3px;
+}
+.account-button:hover {
+  background: #ece6dc;
+}
+.hero {
+  position: relative;
+  isolation: isolate;
+  min-height: 570px;
+  display: flex;
+  align-items: center;
+  color: #fff;
+  padding: 70px max(56px, calc((100vw - 1240px) / 2));
+  background: #302a24;
+  overflow: hidden;
+}
+.hero-image {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  object-position: 50% 53%;
+  z-index: -2;
+}
+.hero::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  background: linear-gradient(
+    90deg,
+    rgba(22, 17, 12, 0.83),
+    rgba(22, 17, 12, 0.4) 52%,
+    rgba(22, 17, 12, 0.1)
+  );
+}
+.eyebrow {
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 2px;
+  line-height: 1.6;
+}
+.hero .eyebrow {
+  color: #f6d5ad;
+  margin-bottom: 23px;
+}
+.hero h1 {
+  font-family: Georgia, "Times New Roman", serif;
+  font-weight: 400;
+  font-size: clamp(56px, 6.1vw, 88px);
+  line-height: 1.02;
+  letter-spacing: -2.5px;
+}
+.hero-description {
+  color: #e9e1d7;
+  font-size: 15px;
+  line-height: 1.8;
+  margin-top: 24px;
+}
+.button {
+  border: 1px solid transparent;
+  display: inline-flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 38px;
+  background: var(--ink);
+  color: white;
+  padding: 16px 23px;
+  border-radius: 3px;
+  font-size: 13px;
+  font-weight: 600;
+  line-height: 1.3;
+}
+.button:hover {
+  background: #514235;
+}
+.hero .button {
+  margin-top: 29px;
+}
+.button-accent {
+  background: var(--accent);
+}
+.button-accent:hover {
+  background: #b44f29;
+}
+.hero-note {
+  position: absolute;
+  right: 42px;
+  bottom: 29px;
+  font-size: 11px;
+  letter-spacing: 0.4px;
+}
+.hero-note span {
+  font-size: 23px;
+  margin-right: 9px;
+  vertical-align: middle;
+  color: #f6d5ad;
+}
+.favorites {
+  padding-block: 66px 50px;
+}
+.section-heading {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 24px;
+  margin-bottom: 29px;
+}
+.section-heading .eyebrow {
+  color: var(--muted);
+  font-size: 9px;
+  margin-bottom: 9px;
+}
+h2 {
+  font-family: Georgia, "Times New Roman", serif;
+  font-size: 36px;
+  font-weight: 400;
+  line-height: 1.2;
+  letter-spacing: -0.7px;
+}
+.text-link {
+  font-size: 12px;
+  white-space: nowrap;
+  display: inline-flex;
+  gap: 22px;
+  align-items: center;
+  padding-block: 7px;
+  border-bottom: 1px solid #b4aa9c;
+}
+.product-grid {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 26px;
+}
+.card {
+  height: 100%;
+  border: 1px solid var(--line);
+  border-radius: 4px;
+  overflow: hidden;
+  background: #fbf9f4;
+}
+.card-image-wrap {
+  position: relative;
+  background: #dfd6c8;
+  overflow: hidden;
+}
+.card img {
+  width: 100%;
+  height: auto;
+  aspect-ratio: 1.53;
+  object-fit: cover;
+  transition: transform 0.3s;
+}
+.card:hover img {
+  transform: scale(1.025);
+}
+.badge {
+  position: absolute;
+  top: 16px;
+  left: 16px;
+  background: var(--paper);
+  padding: 7px 10px;
+  font-size: 8px;
+  font-weight: 700;
+  letter-spacing: 1px;
+  z-index: 1;
+}
+.card-content {
+  padding: 25px 24px 20px;
+}
+.card h3 {
+  font:
+    400 24px/1.25 Georgia,
+    serif;
+  letter-spacing: -0.5px;
+}
+.card p {
+  color: var(--muted);
+  font-size: 13px;
+  line-height: 1.7;
+  margin-top: 12px;
+  min-height: 44px;
+}
+.details-button {
+  width: 100%;
+  display: flex;
+  justify-content: space-between;
+  gap: 10px;
+  background: none;
+  border: 0;
+  border-top: 1px solid var(--line);
+  padding: 17px 0 2px;
+  margin-top: 24px;
+  font-size: 11px;
+  font-weight: 600;
+  text-align: left;
+}
+.details-button:hover {
+  color: #a94524;
+}
+.coffee-note {
+  display: flex;
+  align-items: center;
+  gap: 23px;
+  border-block: 1px solid var(--line);
+  padding-block: 29px;
+}
+.coffee-note > span {
+  color: var(--accent);
+  font-size: 45px;
+}
+.coffee-note p {
+  font:
+    400 23px/1.4 Georgia,
+    serif;
+}
+.coffee-note small {
+  display: block;
+  font:
+    12px/1.7 Arial,
+    sans-serif;
+  color: var(--muted);
+  margin-top: 5px;
+}
+.coffee-note .text-link {
+  margin-left: auto;
+}
+.site-footer {
+  display: grid;
+  grid-template-columns: 1fr auto;
+  gap: 30px;
+  padding-block: 42px 26px;
+}
+.footer-brand {
+  font:
+    24px Georgia,
+    serif;
+  letter-spacing: -0.6px;
+}
+.footer-brand span {
+  font:
+    10px Arial,
+    sans-serif;
+  vertical-align: top;
+  margin-left: 3px;
+}
+.footer-links {
+  display: flex;
+  gap: 25px;
+  font-size: 11px;
+  padding-top: 7px;
+}
+.site-footer > p {
+  grid-column: 1/-1;
+  font-size: 10px;
+  color: var(--muted);
+  border-top: 1px solid var(--line);
+  padding-top: 23px;
+}
+.account-popover {
+  position: fixed;
+  inset: 90px 30px auto auto;
+  margin: 0;
+  width: 240px;
+  border: 1px solid var(--line);
+  border-radius: 5px;
+  padding: 22px;
+  background: var(--paper);
+  color: var(--ink);
+  box-shadow: 0 12px 35px #302a2420;
+}
+.account-popover .eyebrow {
+  font-size: 9px;
+  margin-bottom: 13px;
+  color: var(--muted);
+}
+.account-popover a,
+.account-popover button {
+  display: flex;
+  width: 100%;
+  justify-content: space-between;
+  text-align: left;
+  padding: 14px 0;
+  background: none;
+  border: 0;
+  border-top: 1px solid var(--line);
+  font-size: 13px;
+}
+.account-popover a:hover,
+.account-popover button:hover {
+  color: #a94524;
+}
+dialog {
+  width: min(480px, calc(100% - 32px));
+  max-height: calc(100dvh - 48px);
+  overflow: auto;
+  margin: auto;
+  border: 1px solid var(--line);
+  padding: 44px 35px 35px;
+  border-radius: 6px;
+  background: var(--paper);
+  color: var(--ink);
+  box-shadow: 0 20px 80px #0003;
+}
+dialog::backdrop {
+  background: #211b16a6;
+  backdrop-filter: blur(4px);
+}
+body:has(dialog[open]) {
+  overflow: hidden;
+}
+dialog .eyebrow {
+  color: #a94524;
+  margin-bottom: 12px;
+}
+dialog h2 {
+  font-size: 32px;
+}
+dialog > p:not(.eyebrow) {
+  font-size: 15px;
+  line-height: 1.8;
+  color: var(--muted);
+  margin-top: 18px;
+}
+dialog > .button {
+  margin-top: 26px;
+}
+.close-button {
+  position: absolute;
+  top: 12px;
+  right: 12px;
+  border: 0;
+  background: transparent;
+  font-size: 28px;
+  line-height: 1;
+  width: 36px;
+  height: 36px;
+}
+.dialog-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12px;
+  margin-top: 26px;
+}
+.button-secondary {
+  background: transparent;
+  color: var(--ink);
+  border-color: #b4aa9c;
+}
+.button-secondary:hover {
+  background: #e8e0d4;
+}
+@media (min-width: 1600px) {
+  .hero {
+    min-height: 650px;
+  }
+}
+@media (max-width: 900px) {
+  .site-header {
+    padding: 22px 28px;
+  }
+  .nav-list {
+    gap: 20px;
+  }
+  .container {
+    width: calc(100% - 56px);
+  }
+  .hero {
+    padding-inline: 40px;
+  }
+  .product-grid {
+    gap: 16px;
+  }
+  .card-content {
+    padding: 22px 18px 18px;
+  }
+  .card h3 {
+    font-size: 21px;
+  }
+  .card p {
+    min-height: 66px;
+  }
+  .hero-note {
+    right: 28px;
+  }
+  .footer-links {
+    gap: 16px;
+  }
+}
+@media (max-width: 640px) {
+  .site-header {
+    padding: 20px;
+    flex-wrap: wrap;
+    gap: 22px;
+  }
+  .brand {
+    font-size: 12px;
+  }
+  .brand-mark {
+    width: 45px;
+    height: 45px;
+    font-size: 33px;
+  }
+  .site-header nav {
+    width: 100%;
+  }
+  .nav-list {
+    justify-content: space-between;
+    gap: 12px;
+    font-size: 12px;
+  }
+  .account-button {
+    padding: 9px 11px;
+    gap: 8px;
+  }
+  .container {
+    width: calc(100% - 40px);
+  }
+  .hero {
+    min-height: 530px;
+    padding: 56px 25px 80px;
+  }
+  .hero::before {
+    background: linear-gradient(90deg, #16110cdb, #16110c60);
+  }
+  .hero h1 {
+    font-size: 63px;
+  }
+  .hero .eyebrow {
+    font-size: 9px;
+  }
+  .hero-note {
+    left: 25px;
+    right: auto;
+    bottom: 24px;
+    font-size: 10px;
+  }
+  .favorites {
+    padding-block: 42px 35px;
+  }
+  .section-heading {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 14px;
+  }
+  .section-heading h2 {
+    font-size: 32px;
+  }
+  .product-grid {
+    grid-template-columns: 1fr;
+    gap: 24px;
+  }
+  .card img {
+    aspect-ratio: 1.65;
+  }
+  .card h3 {
+    font-size: 25px;
+  }
+  .card p {
+    min-height: 0;
+  }
+  .card-content {
+    padding: 24px;
+  }
+  .coffee-note {
+    flex-wrap: wrap;
+    gap: 15px;
+  }
+  .coffee-note p {
+    font-size: 20px;
+    flex: 1;
+  }
+  .coffee-note .text-link {
+    margin-left: 49px;
+  }
+  .site-footer {
+    grid-template-columns: 1fr;
+    gap: 24px;
+    padding-top: 32px;
+  }
+  .footer-links {
+    flex-wrap: wrap;
+    gap: 20px;
+  }
+  .account-popover {
+    inset: 140px 20px auto auto;
+  }
+  .dialog-actions .button {
+    padding-inline: 18px;
+    gap: 12px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    scroll-behavior: auto !important;
+    transition: none !important;
+  }
+}
