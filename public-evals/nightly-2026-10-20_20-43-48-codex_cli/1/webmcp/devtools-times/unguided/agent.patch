diff --git a/src/scripts/webmcp.ts b/src/scripts/webmcp.ts
new file mode 100644
index 0000000..914656b
--- /dev/null
+++ b/src/scripts/webmcp.ts
@@ -0,0 +1,14 @@
+import { registerNewsTools, type ModelContext } from '../lib/webmcp';
+
+// Astro's router preserves the document and reruns page-load events.
+// Register once for that document; handlers read fresh data on every invocation.
+const context = (document as Document & { modelContext?: ModelContext }).modelContext
+  ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+
+if (context) {
+  const controller = new AbortController();
+  void registerNewsTools(context, controller.signal).catch(error => {
+    controller.abort();
+    console.warn('News WebMCP tools could not be registered:', error);
+  });
+}
diff --git a/tests/webmcp.test.mjs b/tests/webmcp.test.mjs
new file mode 100644
index 0000000..2e815a0
--- /dev/null
+++ b/tests/webmcp.test.mjs
@@ -0,0 +1,119 @@
+import { test, beforeEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { stripTypeScriptTypes } from 'node:module';
+
+// Load the actual client code with only Vite's build-time base URL substituted.
+const source = async path => stripTypeScriptTypes(await readFile(new URL(path, import.meta.url), 'utf8'));
+const moduleUrl = code => `data:text/javascript;base64,${Buffer.from(code).toString('base64')}`;
+const clientUrl = moduleUrl((await source('../src/lib/news-client.ts')).replace('import.meta.env.BASE_URL', "'/devtools-times/'"));
+const toolsUrl = moduleUrl((await source('../src/lib/webmcp.ts')).replace("'./news-client'", JSON.stringify(clientUrl)));
+const { createNewsTools, registerNewsTools } = await import(toolsUrl);
+const articles = [{ slug: 'urban-cycling', title: 'Urban Cycling', summary: 'A healthier city', image: '/bike.jpg' }];
+let requests, list, events, navigation;
+beforeEach(() => {
+  requests = []; list = []; events = []; navigation = [];
+  globalThis.window = {
+    dispatchEvent: event => events.push(event),
+    location: { assign: url => navigation.push(url) },
+  };
+  globalThis.fetch = async (url, options = {}) => {
+    requests.push({ url, options });
+    if (url.endsWith('articles.json')) return Response.json(articles);
+    if (options.method === 'PUT') {
+      const { slug, saved } = JSON.parse(options.body);
+      list = saved ? [...new Set([...list, slug])] : list.filter(item => item !== slug);
+    }
+    return Response.json({ readingList: list });
+  };
+});
+const execute = (name, input = {}, options) => createNewsTools().find(tool => tool.name === name).execute(input, options);
+
+test('registers five tools with a lifecycle signal and read-only hints', async () => {
+  const calls = [];
+  const controller = new AbortController();
+  await registerNewsTools({ registerTool: (tool, options) => calls.push({ tool, options }) }, controller.signal);
+  assert.equal(calls.length, 5);
+  assert.equal(new Set(calls.map(call => call.tool.name)).size, 5);
+  assert.ok(calls.every(call => call.options.signal === controller.signal));
+  assert.deepEqual(calls.filter(call => call.tool.annotations.readOnlyHint).map(call => call.tool.name), ['search_articles', 'get_reading_list']);
+  controller.abort();
+  await registerNewsTools({ registerTool: () => assert.fail('Must not register after cancellation') }, controller.signal);
+});
+
+test('search matches titles and summaries and respects the application base', async () => {
+  const result = await execute('search_articles', { query: '  HEALTHIER  ' });
+  assert.equal(result.count, 1);
+  assert.equal(result.articles[0].url, '/devtools-times/articles/urban-cycling');
+  assert.equal(requests[0].url, '/devtools-times/api/articles.json');
+  assert.equal((await execute('search_articles', { query: 'missing' })).count, 0);
+});
+
+test('rejects malformed arguments and unknown articles without mutation', async () => {
+  for (const input of [null, [], {}, { query: ' ' }, { query: 2 }, { query: 'city', extra: true }]) {
+    assert.ok((await execute('search_articles', input)).error);
+  }
+  assert.ok((await execute('save_article', { slug: '../signin' })).error);
+  assert.ok(!requests.some(({ options }) => options.method));
+});
+
+test('save and remove use explicit states and notify the UI', async () => {
+  await execute('save_article', { slug: 'urban-cycling' });
