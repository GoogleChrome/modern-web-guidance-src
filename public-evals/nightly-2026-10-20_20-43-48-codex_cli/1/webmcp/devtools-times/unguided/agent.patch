+const endpointSource = (await source('../src/pages/api/reading-list.json.ts')).replace(
+  "import { getEntry } from 'astro:content';",
+  "const getEntry = async (_, slug) => slug === 'urban-cycling' ? { id: slug } : undefined;",
+);
+const endpoint = await import(moduleUrl(endpointSource));
+const session = { get: async () => list, set: async (_, value) => { list = value; } };
+const put = input => endpoint.PUT({ request: new Request('https://example.com/api/reading-list.json', { method: 'PUT', body: JSON.stringify(input) }), session });
+
+test('reading-list endpoint makes repeated save/remove operations idempotent', async () => {
+  await put({ slug: 'urban-cycling', saved: true });
+  await put({ slug: 'urban-cycling', saved: true });
+  assert.deepEqual(list, ['urban-cycling']);
+  await put({ slug: 'urban-cycling', saved: false });
+  await put({ slug: 'urban-cycling', saved: false });
+  assert.deepEqual(list, []);
+});
+
+test('reading-list endpoint validates input and preserves POST toggling', async () => {
+  assert.equal((await put({ slug: 'missing', saved: true })).status, 404);
+  assert.equal((await put({ slug: 'urban-cycling', saved: 'yes' })).status, 400);
+  assert.equal((await put(null)).status, 400);
+  const post = () => endpoint.POST({ request: new Request('https://example.com/api/reading-list.json', { method: 'POST', body: JSON.stringify({ slug: 'urban-cycling' }) }), session });
+  await post();
+  assert.deepEqual(list, ['urban-cycling']);
+  await post();
+  assert.deepEqual(list, []);
