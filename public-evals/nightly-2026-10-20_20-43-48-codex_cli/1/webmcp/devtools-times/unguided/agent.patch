+test('returns actionable HTTP errors and propagates cancellation to fetch', async () => {
+  globalThis.fetch = async () => new Response('', { status: 503 });
+  assert.match((await execute('get_reading_list')).error, /503/);
+  const controller = new AbortController();
+  globalThis.fetch = async (_, options) => {
+    assert.equal(options.signal, controller.signal);
+    controller.abort();
+    options.signal.throwIfAborted();
+  };
+  await assert.rejects(execute('search_articles', { query: 'city' }, { signal: controller.signal }), { name: 'AbortError' });
+});
