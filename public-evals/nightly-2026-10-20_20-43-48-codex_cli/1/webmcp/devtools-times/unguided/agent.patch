diff --git a/src/lib/news-client.ts b/src/lib/news-client.ts
new file mode 100644
index 0000000..ba60df3
--- /dev/null
+++ b/src/lib/news-client.ts
@@ -0,0 +1,44 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image: string;
+}
+
+const base = import.meta.env.BASE_URL;
+export const readingListChanged = 'news:reading-list-changed';
+
+async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${base}api/${path}`, {
+    ...options,
+    credentials: 'same-origin',
+  });
+  if (!response.ok) throw new Error(`Request failed (${response.status}). Please try again.`);
+  return response.json();
+}
+
+export const getArticles = (signal?: AbortSignal) => request<Article[]>('articles.json', { signal });
+export const getReadingList = (signal?: AbortSignal) =>
+  request<{ readingList: string[] }>('reading-list.json', { signal });
+
+export function searchArticles<T extends Pick<Article, 'title' | 'summary'>>(articles: T[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export function articleUrl(slug: string) {
+  return `${base}articles/${encodeURIComponent(slug)}`;
+}
+
+export async function updateReadingList(slug: string, saved?: boolean, signal?: AbortSignal) {
+  const data = await request<{ readingList: string[] }>('reading-list.json', {
+    method: saved === undefined ? 'POST' : 'PUT',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, saved }),
+    signal,
+  });
+  window.dispatchEvent(new CustomEvent(readingListChanged, { detail: data.readingList }));
+  return data;
+}
diff --git a/src/lib/webmcp.ts b/src/lib/webmcp.ts
new file mode 100644
index 0000000..e5c4241
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,81 @@
+import { articleUrl, getArticles, getReadingList, searchArticles, updateReadingList } from './news-client';
+
+interface Tool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations: { readOnlyHint: boolean };
+  execute: (input: Record<string, unknown>, options?: { signal?: AbortSignal }) => Promise<unknown>;
+}
+
+export interface ModelContext {
+  registerTool(tool: Tool, options: { signal: AbortSignal }): void | Promise<void>;
+}
+
+const schema = (properties: Record<string, unknown>, required: string[] = []) => ({
+  type: 'object', properties, required, additionalProperties: false,
+});
+const slugSchema = { type: 'string', minLength: 1, description: 'Article slug returned by search_articles or get_reading_list.' };
+
+export function createNewsTools(): Tool[] {
+  const tool = (name: string, description: string, inputSchema: Record<string, unknown>, readOnlyHint: boolean,
+    run: Tool['execute']): Tool => ({
+    name, description, inputSchema, annotations: { readOnlyHint },
+    async execute(input, options = {}) {
+      try {
+        options.signal?.throwIfAborted();
+        if (!input || typeof input !== 'object' || Array.isArray(input)) return { error: 'Expected an object of tool arguments.' };
+        const allowed = Object.keys(inputSchema.properties as object);
+        if (Object.keys(input).some(key => !allowed.includes(key))) return { error: 'Unknown tool argument.' };
+        return await run(input, options);
+      } catch (error) {
+        if (options.signal?.aborted) throw error;
+        return { error: error instanceof Error ? error.message : 'Unable to complete the request.' };
+      }
+    },
+  });
+  const validSlug = (slug: unknown): slug is string => typeof slug === 'string' && slug.trim().length > 0;
+
+  return [
+    tool('search_articles', 'Search news article titles and summaries. Returns article slugs and links for opening or saving articles.',
+      schema({ query: { type: 'string', minLength: 1, description: 'Words to find in article titles or summaries.' } }, ['query']), true,
+      async ({ query }, { signal } = {}) => {
+        if (typeof query !== 'string' || !query.trim()) return { error: 'Provide a non-empty query.' };
+        const articles = searchArticles(await getArticles(signal), query);
+        return { articles: articles.map(article => ({ ...article, url: articleUrl(article.slug) })), count: articles.length };
+      }),
+    tool('get_reading_list', 'Get articles saved in the current visitor’s reading list.', schema({}), true,
+      async (_, { signal } = {}) => {
+        const [{ readingList }, articles] = await Promise.all([getReadingList(signal), getArticles(signal)]);
+        return { articles: articles.filter(article => readingList.includes(article.slug)).map(article => ({ ...article, url: articleUrl(article.slug) })) };
+      }),
+    ...([true, false] as const).map(saved => tool(saved ? 'save_article' : 'remove_saved_article',
+      saved ? 'Save an article to the current visitor’s reading list. Already saved articles remain saved.' : 'Remove an article from the current visitor’s reading list. Already removed articles remain removed.',
+      schema({ slug: slugSchema }, ['slug']), false,
+      async ({ slug }, { signal } = {}) => {
+        if (!validSlug(slug)) return { error: 'Provide an article slug.' };
+        if (!(await getArticles(signal)).some(article => article.slug === slug)) return { error: 'Article not found. Use search_articles to find a valid slug.' };
+        return { ...await updateReadingList(slug, saved, signal), slug, saved };
+      })),
+    tool('open_article', 'Navigate to a news article in this tab.', schema({ slug: slugSchema }, ['slug']), false,
+      async ({ slug }, { signal } = {}) => {
+        if (!validSlug(slug)) return { error: 'Provide an article slug.' };
+        if (!(await getArticles(signal)).some(article => article.slug === slug)) return { error: 'Article not found. Use search_articles to find a valid slug.' };
+        signal?.throwIfAborted();
+        const url = articleUrl(slug);
+        window.location.assign(url);
+        return { url };
+      }),
+  ];
+}
+
+export async function registerNewsTools(context: ModelContext, signal: AbortSignal) {
+  try {
+    for (const tool of createNewsTools()) {
+      signal.throwIfAborted();
+      await context.registerTool(tool, { signal });
+    }
+  } catch (error) {
+    if (!signal.aborted) throw error;
+  }
+}
