+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createNewsClient } from '../src/lib/news-client.ts';
+import { createNewsTools } from '../src/lib/news-tools.ts';
+
+const article = { slug: 'coffee', title: 'Coffee Alchemy', summary: 'Better brewing', image: '/coffee.jpg' };
+function setup() {
+  const requests: { url: string; options: RequestInit }[] = [];
+  let saved: string[] = [];
+  let changes = 0;
+  const request = (async (url: string, options: RequestInit = {}) => {
+    requests.push({ url, options });
+    options.signal?.throwIfAborted();
+    if (url.endsWith('articles.json')) return Response.json([article]);
+    if (options.method === 'POST') {
+      const { slug, saved: shouldSave } = JSON.parse(String(options.body));
+      saved = saved.filter(s => s !== slug);
+      if (shouldSave) saved.push(slug);
+    }
+    return Response.json({ readingList: saved });
+  }) as typeof fetch;
+  const news = createNewsClient('/devtools-times/', request, () => changes++);
+  const navigated: string[] = [];
+  const tools = createNewsTools(news, async url => { navigated.push(url); });
+  const options = { signal: new AbortController().signal };
+  return { tools, options, requests, navigated, changes: () => changes };
+}
+
+test('search returns matching articles with deployment-base links and bounded results', async () => {
+  const { tools, options } = setup();
+  const result = await tools.search.execute({ query: 'BREWING', limit: 1 }, options) as any;
+  assert.equal(result.total, 1);
+  assert.equal(result.articles[0].url, '/devtools-times/articles/coffee');
+  assert.deepEqual(await tools.search.execute({ query: 'missing' }, options), { total: 0, articles: [] });
+});
+
+test('invalid inputs and unknown articles cannot mutate or navigate', async () => {
+  const { tools, options, requests, navigated } = setup();
+  for (const input of [{ query: '' }, { query: 'coffee', limit: 51 }, { query: 'coffee', limit: 1.5 }, { query: 'coffee', unexpected: true }, null]) {
+    assert.ok((await tools.search.execute(input as any, options) as any).error);
+  }
+  assert.equal(requests.length, 0);
+  assert.ok((await tools.save.execute({ slug: 'coffee', saved: 'true' }, options) as any).error);
+  assert.ok((await tools.save.execute({ slug: 'missing', saved: true }, options) as any).error);
+  assert.ok((await tools.open.execute({ slug: '../signin' }, options) as any).error);
+  assert.equal(requests.some(r => r.options.method === 'POST'), false);
+  assert.deepEqual(navigated, []);
+});
+
+test('explicit save requests are idempotent and notify UI subscribers', async () => {
+  const { tools, options, changes } = setup();
+  await tools.save.execute({ slug: 'coffee', saved: true }, options);
+  await tools.save.execute({ slug: 'coffee', saved: true }, options);
+  assert.equal((await tools.readingList.execute({}, options) as any).articles.length, 1);
+  await tools.save.execute({ slug: 'coffee', saved: false }, options);
+  await tools.save.execute({ slug: 'coffee', saved: false }, options);
+  assert.deepEqual(await tools.readingList.execute({}, options), { articles: [] });
+  assert.equal(changes(), 4);
+});
+
+test('open only navigates to a known article and requests honor execution signals', async () => {
+  const { tools, options, requests, navigated } = setup();
+  await tools.open.execute({ slug: 'coffee' }, options);
+  assert.deepEqual(navigated, ['/devtools-times/articles/coffee']);
+  assert.equal(requests[0].options.signal, options.signal);
+  const controller = new AbortController();
+  controller.abort();
+  await assert.rejects(async () => tools.save.execute({ slug: 'coffee', saved: true }, { signal: controller.signal }), { name: 'AbortError' });
+  assert.equal(requests.length, 1);
+});
+
+test('HTTP errors return actionable tool results', async () => {
+  const news = createNewsClient('/', (async () => new Response('', { status: 503 })) as typeof fetch);
+  const tools = createNewsTools(news, async () => {});
+  const result = await tools.search.execute({ query: 'coffee' }, { signal: new AbortController().signal }) as any;
+  assert.match(result.error, /503/);
+});
+
+test('cancelling an in-flight request stops execution before mutation', async () => {
+  const controller = new AbortController();
+  const news = createNewsClient('/', ((_url, { signal }: RequestInit) => new Promise((_resolve, reject) => {
+    signal!.addEventListener('abort', () => reject(signal!.reason), { once: true });
+  })) as typeof fetch);
+  const tools = createNewsTools(news, async () => assert.fail('Cancelled tool navigated'));
+  const pending = tools.save.execute({ slug: 'coffee', saved: true }, { signal: controller.signal });
+  controller.abort();
+  await assert.rejects(async () => pending, { name: 'AbortError' });
+});
