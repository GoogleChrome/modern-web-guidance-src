diff --git a/src/lib/news-client.ts b/src/lib/news-client.ts
new file mode 100644
index 0000000..1328be0
--- /dev/null
+++ b/src/lib/news-client.ts
@@ -0,0 +1,34 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image: string;
+}
+
+export const READING_LIST_CHANGED = 'reading-list-changed';
+
+export function createNewsClient(baseUrl: string, request: typeof fetch = fetch, onReadingListChange?: (slugs: string[]) => void) {
+  const base = `${baseUrl.replace(/\/$/, '')}/`;
+  async function json<T>(path: string, options: RequestInit = {}): Promise<T> {
+    const response = await request(`${base}api/${path}`, { ...options, credentials: 'same-origin' });
+    if (!response.ok) throw new Error(`Request failed (${response.status}). Please try again.`);
+    return response.json();
+  }
+  return {
+    articleUrl: (slug: string) => `${base}articles/${encodeURIComponent(slug)}`,
+    articles: (signal?: AbortSignal) => json<Article[]>('articles.json', { signal }),
+    async readingList(signal?: AbortSignal) {
+      return (await json<{ readingList: string[] }>('reading-list.json', { signal, cache: 'no-store' })).readingList;
+    },
+    async setSaved(slug: string, saved: boolean, signal?: AbortSignal) {
+      const { readingList } = await json<{ readingList: string[] }>('reading-list.json', {
+        method: 'POST', signal, headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ slug, saved }),
+      });
+      onReadingListChange?.(readingList);
+      return readingList;
+    },
+  };
+}
+
+export type NewsClient = ReturnType<typeof createNewsClient>;
