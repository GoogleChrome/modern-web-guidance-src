new file mode 100644
index 0000000..3cb979e
--- /dev/null
+++ b/src/lib/news-tools.ts
@@ -0,0 +1,52 @@
+import type { NewsClient } from './news-client';
+
+export function createNewsTools(news: NewsClient, navigate: (url: string) => Promise<void>) {
+  const schema = (properties: object, required: string[] = []) => ({ type: 'object', properties, required, additionalProperties: false });
+  const slug = { type: 'string', minLength: 1, description: 'Article identifier returned by article search.' };
+  function tool(name: string, description: string, inputSchema: object, readOnlyHint: boolean, run: WebMCP.ToolExecuteCallback): WebMCP.ModelContextTool {
+    return {
+      name, description, inputSchema, annotations: { readOnlyHint },
+      async execute(input, { signal }) {
+        try {
+          signal.throwIfAborted();
+          if (!input || typeof input !== 'object' || Array.isArray(input)) return { error: 'Provide an object of tool arguments.' };
+          const properties = (inputSchema as { properties: object }).properties;
+          if (Object.keys(input).some(key => !Object.hasOwn(properties, key))) return { error: 'Unexpected tool argument.' };
+          return await run(input, { signal });
+        } catch (error) {
+          if (signal.aborted) throw error;
+          return { error: error instanceof Error ? error.message : 'Unable to complete the request.' };
+        }
+      },
+    };
+  }
+  return {
+    search: tool('search_articles', 'Find news articles by words in their title or summary. Returns article identifiers and links.', schema({
+      query: { type: 'string', minLength: 1, maxLength: 200, description: 'Words to find in article titles and summaries.' },
+      limit: { type: 'integer', minimum: 1, maximum: 50, default: 10, description: 'Maximum number of matching articles to return.' },
+    }, ['query']), true, async ({ query, limit = 10 }, { signal }) => {
+      if (typeof query !== 'string' || !query.trim() || query.length > 200 || !Number.isInteger(limit) || Number(limit) < 1 || Number(limit) > 50) return { error: 'Provide a nonempty query up to 200 characters and an integer limit from 1 to 50.' };
+      const term = query.trim().toLowerCase();
+      const matches = (await news.articles(signal)).filter(a => `${a.title}\n${a.summary}`.toLowerCase().includes(term));
+      return { total: matches.length, articles: matches.slice(0, Number(limit)).map(a => ({ ...a, url: news.articleUrl(a.slug) })) };
+    }),
+    readingList: tool('get_reading_list', 'Retrieve articles saved in the current browser session reading list.', schema({}), true, async (_, { signal }) => {
+      const slugs = await news.readingList(signal);
+      const articles = await news.articles(signal);
+      return { articles: articles.filter(a => slugs.includes(a.slug)).map(a => ({ ...a, url: news.articleUrl(a.slug) })) };
+    }),
+    save: tool('set_article_saved', 'Save an article to or remove it from the current session reading list. Repeating the request preserves the requested state.', schema({ slug, saved: { type: 'boolean', description: 'Whether the article should be in the reading list.' } }, ['slug', 'saved']), false, async ({ slug, saved }, { signal }) => {
+      if (typeof slug !== 'string' || !slug.trim() || typeof saved !== 'boolean') return { error: 'Provide an article slug and a saved boolean.' };
+      if (!(await news.articles(signal)).some(a => a.slug === slug)) return { error: 'Article not found. Use search_articles to find a valid slug.' };
+      return { slug, saved, readingList: await news.setSaved(slug, saved, signal) };
+    }),
+    open: tool('open_article', 'Open a news article in the current tab so the user can read it.', schema({ slug }, ['slug']), false, async ({ slug }, { signal }) => {
+      if (typeof slug !== 'string' || !slug.trim()) return { error: 'Provide an article slug.' };
+      if (!(await news.articles(signal)).some(a => a.slug === slug)) return { error: 'Article not found. Use search_articles to find a valid slug.' };
+      signal.throwIfAborted();
+      const url = news.articleUrl(slug);
+      await navigate(url);
+      return { url };
+    }),
+  };
+}
