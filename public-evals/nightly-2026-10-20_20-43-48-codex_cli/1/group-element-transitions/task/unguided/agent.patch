+  <script>
+    const beanForm = document.querySelector('#bean-form');
+    const beanInput = document.querySelector('#bean-name');
+    const beanList = document.querySelector('#bean-list');
+    const beanStatus = document.querySelector('#bean-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextBeanId = 4;
+    let customBlendNumber = 1;
+    let activeTransition;
+    let pendingUpdate = Promise.resolve();
+
+    function updateBeans(update) {
+      // Wait only for DOM updates, never for animation completion, so rapid clicks work.
+      pendingUpdate = pendingUpdate.then(() => {
+        activeTransition?.skipTransition();
+        if (reducedMotion.matches || !document.startViewTransition ||
+            !CSS.supports('view-transition-class', 'bean-item')) {
+          update();
+          return;
+        }
+        activeTransition = document.startViewTransition(update);
+        return activeTransition.updateCallbackDone;
+      }).catch(console.error);
+    }
+
+    reducedMotion.addEventListener('change', (event) => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+
+    beanForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = beanInput.value.trim() || `Custom Blend ${customBlendNumber++}`;
+      const item = document.createElement('li');
+      item.className = 'item';
+      item.style.viewTransitionName = `bean-${nextBeanId++}`;
+      const label = document.createElement('span');
+      label.textContent = name;
+      const removeButton = document.createElement('button');
+      removeButton.type = 'button';
+      removeButton.className = 'remove-bean';
+      removeButton.textContent = 'Remove';
+      removeButton.setAttribute('aria-label', `Remove ${name}`);
+      item.append(label, removeButton);
+      beanInput.value = '';
+      updateBeans(() => {
+        beanList.append(item);
+        beanStatus.textContent = `${name} added. ${beanList.children.length} selections.`;
+      });
+    });
+
+    beanList.addEventListener('click', (event) => {
+      const button = event.target.closest('.remove-bean');
+      if (!button) return;
+      const item = button.closest('.item');
+      updateBeans(() => {
+        if (!item.isConnected) return;
+        const focusTarget = (item.nextElementSibling || item.previousElementSibling)
+          ?.querySelector('button') || beanForm.querySelector('button');
+        const restoreFocus = item.contains(document.activeElement);
+        const name = item.querySelector('span').textContent;
+        item.remove();
+        if (restoreFocus) focusTarget.focus({ preventScroll: true });
+        beanStatus.textContent = `${name} removed. ${beanList.children.length} selections.`;
+      });
+    });
+  </script>
