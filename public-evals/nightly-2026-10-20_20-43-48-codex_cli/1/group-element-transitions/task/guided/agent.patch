+  <script>
+    const beanList = document.getElementById('bean-list');
+    const beanForm = document.getElementById('bean-form');
+    const beanName = document.getElementById('bean-name');
+    const beanStatus = document.getElementById('bean-status');
+    const addButton = document.getElementById('add-item');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextBeanId = 4;
+    let customBeanCount = 0;
+    let activeTransition;
+    let pendingUpdate = Promise.resolve();
+
+    function updateBeans(update) {
+      // Wait only for DOM updates, never for animations, so rapid clicks are kept.
+      pendingUpdate = pendingUpdate.then(() => {
+        if (reducedMotion.matches || !document.startViewTransition) {
+          update();
+          return;
+        }
+
+        activeTransition?.skipTransition();
+        const scope = typeof beanList.startViewTransition === 'function'
+          ? beanList : document;
+        activeTransition = scope.startViewTransition(update);
+        // A newer interaction may skip an unfinished snapshot.
+        activeTransition.ready.catch(() => {});
+        return activeTransition.updateCallbackDone;
+      });
+    }
+
+    beanForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = beanName.value.trim() || `Custom Blend ${++customBeanCount}`;
+      const item = document.createElement('li');
+      item.className = 'item';
+      item.style.viewTransitionName = `bean-${nextBeanId++}`;
+      const details = document.createElement('div');
+      const title = document.createElement('h3');
+      title.textContent = name;
+      const description = document.createElement('p');
+      description.textContent = 'Your custom coffee bean selection.';
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.className = 'remove-item';
+      remove.textContent = 'Remove';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      details.append(title, description);
+      item.append(details, remove);
+      beanName.value = '';
+      updateBeans(() => {
+        beanList.append(item);
+        beanStatus.textContent = `${name} added. ${beanList.children.length} selections.`;
+      });
+    });
+
+    beanList.addEventListener('click', (event) => {
+      const remove = event.target.closest('.remove-item');
+      if (!remove) return;
+      const item = remove.closest('.item');
+      updateBeans(() => {
+        const focusTarget = item.nextElementSibling?.querySelector('button')
+          || item.previousElementSibling?.querySelector('button') || addButton;
+        const hadFocus = item.contains(document.activeElement);
+        const name = item.querySelector('h3').textContent;
+        item.remove();
+        if (hadFocus) focusTarget.focus({ preventScroll: true });
+        beanStatus.textContent = `${name} removed. ${beanList.children.length} selections.`;
+      });
+    });
+
+    reducedMotion.addEventListener('change', (event) => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+  </script>
+
