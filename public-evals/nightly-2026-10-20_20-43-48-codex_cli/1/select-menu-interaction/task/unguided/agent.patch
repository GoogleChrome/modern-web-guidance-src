+
+    function updateShopValidation() {
+      const invalid = !shopSelect.validity.valid;
+      shopSelect.setAttribute('aria-invalid', String(invalid));
+      shopError.hidden = !invalid;
+    }
+
+    shopSelect.addEventListener('blur', updateShopValidation);
+    shopSelect.addEventListener('change', updateShopValidation);
+    // Native validation fires this event when an empty selection blocks submission.
