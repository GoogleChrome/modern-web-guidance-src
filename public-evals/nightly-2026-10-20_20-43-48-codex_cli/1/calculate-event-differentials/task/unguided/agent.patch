+  <script>
+    (() => {
+      const promotion = document.getElementById('maple-promotion');
+      const status = document.getElementById('promotion-status');
+      const countdown = document.getElementById('promotion-countdown');
+      const days = document.getElementById('promotion-days');
+      const hours = document.getElementById('promotion-hours');
+      const elapsed = document.getElementById('promotion-elapsed');
+      const hourInMilliseconds = 60 * 60 * 1000;
+
+      function duration(milliseconds) {
+        const totalHours = Math.floor(Math.max(0, milliseconds) / hourInMilliseconds);
+        return { days: Math.floor(totalHours / 24), hours: totalHours % 24 };
+      }
+
+      function updatePromotion() {
+        const now = Date.now();
+        // Numeric components use the visitor's local time zone. March is month 2.
+        const end = new Date(2026, 2, 1, 0, 0, 0).getTime();
+        const remaining = duration(end - now);
+        status.textContent = now >= end ? 'Offer ended' : 'Time remaining';
+        countdown.hidden = false;
+        days.textContent = remaining.days;
+        hours.textContent = remaining.hours;
+
+        // Set data-start to the confirmed local start, e.g. YYYY-MM-DDTHH:mm:ss.
+        const start = promotion.dataset.start ? new Date(promotion.dataset.start).getTime() : NaN;
+        if (Number.isFinite(start) && start < end) {
+          const timeSinceStart = duration(now - start);
+          elapsed.textContent = now < start
+            ? 'Promotion has not started yet.'
+            : `Since promotion started: ${timeSinceStart.days} days, ${timeSinceStart.hours} hours`;
+        } else {
+          elapsed.textContent = 'Elapsed time unavailable: promotion start date needed.';
+        }
+      }
+
+      updatePromotion();
+      setInterval(updatePromotion, 60 * 1000);
+      window.addEventListener('pageshow', updatePromotion);
+      document.addEventListener('visibilitychange', () => {
+        if (!document.hidden) updatePromotion();
+      });
+    })();
+  </script>
+
 </body>
 
