+  <script>
+    // Fallback for browsers without CSS sibling-index()/sibling-count().
+    // Observe structural edits so newly inserted and removed items reflow too.
+    const layoutSelector = '.grid, .fan-container, .circle-container';
+    const itemSelector = '.spectrum-card, .fan-card, .circle-orb';
+    const hasSiblingFunctions = CSS.supports('order: sibling-index()') && CSS.supports('order: sibling-count()');
+    function syncCollections() {
+      document.querySelectorAll(layoutSelector).forEach(container => {
+        // Existing and newly added product cards share the spectrum treatment.
+        if (container.matches('.grid')) {
+          Array.from(container.children).forEach(item => {
+            if (item.matches('.card')) item.classList.add('spectrum-card');
+          });
+        }
+        const items = Array.from(container.children).filter(item => item.matches(itemSelector));
+        container.style.setProperty('--item-count', items.length || 1);
+        if (!hasSiblingFunctions) {
+          items.forEach((item, index) => {
+            item.style.setProperty('--item-index', index);
+            item.style.setProperty('--item-count', items.length);
+          });
+        }
+      });
+    }
+    syncCollections();
+    new MutationObserver(syncCollections).observe(document.querySelector('main'), {
+      childList: true,
+      subtree: true
+    });
+  </script>
