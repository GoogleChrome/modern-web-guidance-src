+  <script>
+    // Older engines receive the same live, one-based sibling data as native CSS.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)') ||
+        !CSS.supports('top: calc(sibling-count() * 1px)')) {
+      const groups = document.querySelectorAll('.grid, .fan-container, .circle-container');
+      const sync = (group) => {
+        const items = Array.from(group.children);
+        items.forEach((item, index) => {
+          item.style.setProperty('--sibling-index', index + 1);
+          item.style.setProperty('--sibling-count', items.length);
+        });
+      };
+      const observer = new MutationObserver((records) => {
+        new Set(records.map((record) => record.target)).forEach(sync);
+      });
+      groups.forEach((group) => {
+        sync(group);
+        observer.observe(group, { childList: true });
+      });
+    }
+  </script>
