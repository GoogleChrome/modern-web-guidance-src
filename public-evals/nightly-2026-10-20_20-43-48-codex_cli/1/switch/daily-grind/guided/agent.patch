@@ -0,0 +1,37 @@
+const iced = document.querySelector('#iced');
+const status = document.querySelector('#menu-status');
+const drinks = [
+  { hot: 'Maple Oat Latte', cold: 'Iced Maple Oat Latte', price: '$5.50', hotDescription: 'Cozy espresso, creamy oat milk, a little maple magic.', coldDescription: 'Maple-sweet espresso and creamy oat milk, poured over ice.' },
+  { hot: 'Dark Roast Espresso', cold: 'Iced Dark Roast Espresso', price: '$3.50', hotDescription: 'Rich, chocolatey, and unapologetically full of character.', coldDescription: 'Our bold, chocolatey espresso, chilled over fresh ice.' },
+  { hot: 'Signature Cold Brew', cold: 'Signature Cold Brew on Ice', price: '$4.50', hotDescription: 'Steeped for 18 hours. Smooth from the very first sip.', coldDescription: 'Our slow-steeped signature, served over ice for extra refreshment.' },
+];
+
+function updateMenu(announce = true) {
+  drinks.forEach((drink, index) => {
+    document.querySelector(`[data-title="${index}"]`).textContent = iced.checked ? drink.cold : drink.hot;
+    document.querySelector(`[data-description="${index}"]`).textContent = iced.checked ? drink.coldDescription : drink.hotDescription;
+  });
+  document.querySelectorAll('.temperature-tag').forEach(tag => { tag.hidden = !iced.checked; });
+  if (announce) status.textContent = iced.checked ? 'Showing iced seasonal favorites.' : 'Showing original seasonal favorites. Cold brew is always chilled.';
+}
+iced.addEventListener('change', () => updateMenu());
+updateMenu(false);
+
+if (!('switch' in HTMLInputElement.prototype)) {
+  import('input-switch-polyfill').catch(() => {
+    // Keep the native checkbox operable if the enhancement cannot load.
+    iced.setAttribute('role', 'switch');
+  });
+}
+
+const dialog = document.querySelector('#drink-dialog');
+document.querySelectorAll('[data-drink]').forEach(button => {
+  button.addEventListener('click', () => {
+    const drink = drinks[Number(button.dataset.drink)];
+    document.querySelector('#dialog-title').textContent = iced.checked ? drink.cold : drink.hot;
+    document.querySelector('#dialog-description').textContent = iced.checked ? drink.coldDescription : drink.hotDescription;
+    document.querySelector('#dialog-price').textContent = drink.price;
+    document.querySelector('#dialog-temperature').textContent = iced.checked ? 'Served over ice' : button.dataset.drink === '2' ? 'Served chilled' : 'Served warm';
+    dialog.showModal();
+  });
+});
