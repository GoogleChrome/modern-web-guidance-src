+import { defineConfig } from 'vite';
+
+export default defineConfig({
+  plugins: [{
+    name: 'bundle-switch-stylesheet',
+    transform(source, id) {
+      if (!id.endsWith('/input-switch-polyfill/input-switch-polyfill.js')) return;
+      // The polyfill fetches its stylesheet at runtime. Make Vite emit that asset
+      // and supply its production URL instead of resolving a node_modules path.
+      return {
+        code: `import switchStylesheetUrl from 'input-switch-polyfill/input-switch-polyfill.css?url';\n${source.replace("import.meta.resolve('./input-switch-polyfill.css')", 'switchStylesheetUrl')}`,
+        map: null,
+      };
+    },
+  }],
+});
