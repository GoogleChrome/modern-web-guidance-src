+  <script>
+    const feedbackForm = document.getElementById('feedback-form');
+    const feedbackMessage = document.getElementById('feedback-message');
+    const feedbackStatus = document.getElementById('feedback-status');
+    const sendButton = feedbackForm.querySelector('button');
+    let sending = false;
+
+    feedbackMessage.addEventListener('input', () => {
+      feedbackMessage.setCustomValidity('');
+      feedbackStatus.textContent = '';
+    });
+
+    feedbackMessage.addEventListener('keydown', (event) => {
+      if (event.key !== 'Enter' || event.shiftKey) return;
+      // IME confirmation must not send unfinished text, including in Safari.
+      if (event.isComposing || event.keyCode === 229) return;
+      event.preventDefault();
+      if (!event.repeat && !sending) feedbackForm.requestSubmit();
+    });
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (sending) return;
+      if (!feedbackMessage.value.trim()) {
+        feedbackMessage.setCustomValidity('Please enter your feedback.');
+        feedbackMessage.reportValidity();
+        return;
+      }
+
+      sending = true;
+      sendButton.disabled = true;
+      feedbackMessage.readOnly = true;
+      feedbackStatus.textContent = 'Sending…';
+
+      try {
+        const response = await fetch(feedbackForm.action, {
+          method: 'POST',
+          body: new URLSearchParams(new FormData(feedbackForm))
+        });
+        if (!response.ok) throw new Error('Feedback submission failed');
+        feedbackForm.reset();
+        feedbackStatus.textContent = 'Thank you for your feedback!';
+      } catch {
+        feedbackStatus.textContent = 'Could not send your feedback. Please try again later.';
+      } finally {
+        sending = false;
+        sendButton.disabled = false;
+        feedbackMessage.readOnly = false;
+      }
+    });
+  </script>
