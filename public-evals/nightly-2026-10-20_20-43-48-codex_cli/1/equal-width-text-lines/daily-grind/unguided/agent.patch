+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = heroHeading.querySelectorAll('span');
+
+    function fitHeadingLines() {
+      const availableWidth = heroHeading.clientWidth;
+      if (!availableWidth) return;
+
+      // Measure each line at a shared size, then change its font size to fit.
+      headingLines.forEach((line) => { line.style.fontSize = '100px'; });
+      const lineWidths = Array.from(headingLines, (line) => line.getBoundingClientRect().width);
+      headingLines.forEach((line, index) => {
+        line.style.fontSize = `${100 * availableWidth / lineWidths[index]}px`;
+      });
+    }
+
+    fitHeadingLines();
+    new ResizeObserver(fitHeadingLines).observe(heroHeading);
+    document.fonts.ready.then(fitHeadingLines);
+  </script>
