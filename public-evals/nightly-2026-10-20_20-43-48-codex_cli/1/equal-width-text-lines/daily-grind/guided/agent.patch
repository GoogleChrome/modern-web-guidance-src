+  <script>
+    if (!CSS.supports('text-fit', 'grow per-line-all 800%')) {
+      const heading = document.querySelector('.hero h1');
+      const lines = [...heading.children];
+      const fitHeading = () => {
+        // Reset, measure together, then write to avoid a reflow for every line.
+        lines.forEach(line => line.style.removeProperty('--text-fit-scale'));
+        const width = heading.clientWidth;
+        if (!width) return;
+        const scales = lines.map(line => width / line.getBoundingClientRect().width);
+        lines.forEach((line, index) => {
+          line.style.setProperty('--text-fit-scale', Math.min(scales[index], 8));
+        });
+      };
+
+      let previousWidth;
+      const observer = new ResizeObserver(([entry]) => {
+        if (entry.contentRect.width !== previousWidth) {
+          previousWidth = entry.contentRect.width;
+          fitHeading();
+        }
+      });
+      observer.observe(heading);
+      fitHeading();
+      document.fonts.ready.then(fitHeading);
+      document.fonts.addEventListener('loadingdone', fitHeading);
+    }
+  </script>
