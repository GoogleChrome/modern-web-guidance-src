+  <script>
+    (function () {
+      var supportsScrollAnimation = window.CSS &&
+        typeof window.CSS.supports === 'function' &&
+        window.CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)');
+
+      if (supportsScrollAnimation) return;
+
+      var navigation = document.querySelector('nav');
+      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      var pendingFrame = null;
+
+      function updateNavigation() {
+        pendingFrame = null;
+        if (reducedMotion.matches) {
+          navigation.style.removeProperty('--nav-padding');
+          return;
+        }
+
+        var rem = parseFloat(window.getComputedStyle(document.documentElement).fontSize);
+        var progress = Math.min(1, Math.max(0, window.pageYOffset / (1.25 * rem)));
+        navigation.style.setProperty('--nav-padding', (1 - 0.625 * progress) + 'rem');
+      }
+
+      function scheduleUpdate() {
+        if (pendingFrame === null) {
+          pendingFrame = window.requestAnimationFrame(updateNavigation);
+        }
+      }
+
+      window.addEventListener('scroll', scheduleUpdate, { passive: true });
+      window.addEventListener('resize', scheduleUpdate);
+      window.addEventListener('pageshow', scheduleUpdate);
+      if (reducedMotion.addEventListener) {
+        reducedMotion.addEventListener('change', scheduleUpdate);
+      } else {
+        reducedMotion.addListener(scheduleUpdate);
+      }
+      updateNavigation();
+    }());
+  </script>
