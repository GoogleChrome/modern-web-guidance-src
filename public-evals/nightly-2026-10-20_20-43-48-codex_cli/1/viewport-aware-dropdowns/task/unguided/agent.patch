+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      const viewport = window.visualViewport;
+      const edge = 8;
+      const minX = (viewport?.offsetLeft ?? 0) + edge;
+      const minY = (viewport?.offsetTop ?? 0) + edge;
+      const maxX = minX + (viewport?.width ?? document.documentElement.clientWidth) - edge * 2;
+      const maxY = minY + (viewport?.height ?? document.documentElement.clientHeight) - edge * 2;
+      const anchor = trigger.getBoundingClientRect();
+
+      panel.style.maxWidth = `${Math.max(0, maxX - minX)}px`;
+      panel.style.maxHeight = `${Math.max(0, maxY - minY)}px`;
+      const { width, height } = panel.getBoundingClientRect();
+      const below = Math.max(0, maxY - Math.max(minY, anchor.bottom));
+      const above = Math.max(0, Math.min(maxY, anchor.top) - minY);
+      const flipUp = height > below && above > below;
+      const availableHeight = flipUp ? above : below;
+
+      // Flip to the trigger's right edge before clamping to the viewport.
+      let left = anchor.left;
+      if (left + width > maxX) left = anchor.right - width;
+      left = Math.max(minX, Math.min(left, maxX - width));
+
+      panel.style.maxHeight = `${availableHeight}px`;
+      const fittedHeight = panel.getBoundingClientRect().height;
+      const top = flipUp ? anchor.top - fittedHeight : anchor.bottom;
+      panel.style.left = `${left}px`;
+      panel.style.top = `${Math.max(minY, Math.min(top, maxY - fittedHeight))}px`;
+    }
+
+    // Position before the next paint, including programmatic popover opens.
+    panel.addEventListener('beforetoggle', (event) => {
+      trigger.setAttribute('aria-expanded', String(event.newState === 'open'));
+      if (event.newState === 'open') requestAnimationFrame(positionPanel);
+    });
+    panel.addEventListener('toggle', positionPanel);
+    window.addEventListener('resize', positionPanel);
+    document.addEventListener('scroll', positionPanel, true);
+    window.visualViewport?.addEventListener('resize', positionPanel);
+    window.visualViewport?.addEventListener('scroll', positionPanel);
+    const resizeObserver = new ResizeObserver(positionPanel);
+    resizeObserver.observe(trigger);
+    resizeObserver.observe(panel);
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+  </script>
