+  <script type="module">
+    // Native popovers provide top-layer rendering, Escape and light dismissal.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@0.6.1/dist/popover.min.js");
+    }
+
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+    const hasAnchorPositioning = CSS.supports('anchor-name: --options-trigger') &&
+      CSS.supports('position-area: block-end span-inline-end') &&
+      CSS.supports('position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline');
+
+    if (!hasAnchorPositioning) {
+      // Keep older browsers tethered too, including during scroll and zoom.
+      panel.style.positionArea = 'none';
+      const positionPanel = () => {
+        const viewport = window.visualViewport;
+        const leftEdge = (viewport?.offsetLeft ?? 0) + 8;
+        const topEdge = (viewport?.offsetTop ?? 0) + 8;
+        const rightEdge = leftEdge + (viewport?.width ?? document.documentElement.clientWidth) - 16;
+        const bottomEdge = topEdge + (viewport?.height ?? document.documentElement.clientHeight) - 16;
+        const anchor = trigger.getBoundingClientRect();
+
+        panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+        panel.style.maxHeight = `${Math.max(0, bottomEdge - topEdge)}px`;
+        const width = panel.offsetWidth;
+        const height = panel.offsetHeight;
+        const below = Math.max(0, bottomEdge - anchor.bottom);
+        const above = Math.max(0, anchor.top - topEdge);
+        const flipUp = height > below && above > below;
+        const availableHeight = flipUp ? above : below;
+        panel.style.maxHeight = `${availableHeight}px`;
+
+        const left = anchor.left + width > rightEdge ? anchor.right - width : anchor.left;
+        const top = flipUp ? anchor.top - panel.offsetHeight : anchor.bottom;
+        panel.style.left = `${Math.max(leftEdge, Math.min(left, rightEdge - width))}px`;
+        panel.style.top = `${Math.max(topEdge, Math.min(top, bottomEdge - panel.offsetHeight))}px`;
+      };
+
+      let open = false;
+      const update = () => { if (open) positionPanel(); };
+      panel.addEventListener('beforetoggle', event => {
+        open = event.newState === 'open';
+        if (open) requestAnimationFrame(update);
+      });
+      window.addEventListener('resize', update);
+      document.addEventListener('scroll', update, true);
+      window.visualViewport?.addEventListener('resize', update);
+      window.visualViewport?.addEventListener('scroll', update);
+      new ResizeObserver(update).observe(trigger);
+    }
+  </script>
