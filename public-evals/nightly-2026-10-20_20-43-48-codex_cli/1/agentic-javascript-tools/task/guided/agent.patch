--- a/index.html
+++ b/index.html
@@ -206,7 +206,78 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      if (typeof document.modelContext?.registerTool !== 'function') return;
+
+      let registration;
+
+      const menuItemTool = {
+        name: 'get_menu_item',
+        description: 'Looks up a coffee menu item and returns its name, description, and details URL. Use when someone asks about a drink on The Daily Grind menu.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              minLength: 1,
+              description: 'The menu item to look up, such as Maple Oat Latte, Dark Roast Espresso, or Cold Brew. Matching ignores case and surrounding whitespace.'
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: true },
+        execute(input) {
+          if (typeof input?.name !== 'string' || !input.name.trim()) {
+            return { error: 'Provide a non-empty menu item name.' };
+          }
+
+          // Read the displayed menu so assistant responses stay in sync with it.
+          const items = Array.from(document.querySelectorAll('main .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const name = input.name.trim().toLowerCase();
+          const item = items.find((entry) => entry.name.toLowerCase() === name);
+
+          return item ?? {
+            error: `Menu item "${input.name.trim()}" not found.`,
+            availableItems: items.map((entry) => entry.name)
+          };
+        }
+      };
+
+      async function registerMenuTool() {
+        if (registration) return;
+        const controller = new AbortController();
+        registration = controller;
+
+        try {
+          await document.modelContext.registerTool(menuItemTool, { signal: controller.signal });
+        } catch (error) {
+          controller.abort();
+          if (registration === controller) registration = undefined;
+          if (error?.name !== 'AbortError') {
+            console.warn('Could not register the menu lookup tool.', error);
+          }
+        }
+      }
+
+      window.addEventListener('pagehide', () => {
+        registration?.abort();
+        registration = undefined;
+      });
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) registerMenuTool();
+      });
+
+      registerMenuTool();
+    })();
+  </script>
+
 </body>
 
 </html>
