     <a href="/order-online" class="btn">Order Now</a>
   </header>
 
   <main class="container">
-    <section>
+    <section id="seasonal-menu">
       <h2 style="text-align: center;">Seasonal Favorites</h2>
       <div class="grid">
         <div class="card">
           <h3>Maple Oat Latte</h3>
@@ -206,7 +206,82 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      // Prefer the current WebMCP API, with support for earlier implementations.
+      const modelContext = document.modelContext ?? navigator.modelContext;
+      if (typeof modelContext?.registerTool !== 'function') return;
+
+      const tool = {
+        name: 'get_menu_item',
+        description: 'Look up a Daily Grind menu item by its full name. Returns its name, description, and details URL. Available items include Maple Oat Latte, Dark Roast Espresso, and Cold Brew. Names are case-insensitive. Returns an error and available names if no item matches.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            name: {
+              type: 'string',
+              minLength: 1,
+              description: 'The full menu item name, for example "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew". Capitalization and surrounding whitespace are ignored.'
+            }
+          },
+          required: ['name'],
+          additionalProperties: false
+        },
+        annotations: { readOnlyHint: true },
+        async execute(input) {
+          if (typeof input?.name !== 'string' || !input.name.trim()) {
+            return JSON.stringify({ error: 'Provide a non-empty menu item name.' });
+          }
+
+          // Read the displayed menu so the assistant receives the same details as visitors.
+          const items = Array.from(document.querySelectorAll('#seasonal-menu .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const item = items.find(({ name }) => name.toLowerCase() === input.name.trim().toLowerCase());
+
+          return JSON.stringify(item ?? {
+            error: 'Menu item not found.',
+            availableNames: items.map(({ name }) => name)
+          });
+        }
+      };
+
+      let registration = null;
+
+      async function registerMenuTool() {
+        if (registration) return;
+        const controller = new AbortController();
+        registration = controller;
+        try {
+          await modelContext.registerTool(tool, { signal: controller.signal });
+        } catch (error) {
+          if (registration === controller) registration = null;
+          if (!controller.signal.aborted) console.warn('Could not register menu lookup tool.', error);
+        }
+      }
+
+      function unregisterMenuTool() {
+        if (!registration) return;
+        registration.abort();
+        registration = null;
+        // Older WebMCP implementations use explicit unregistration.
+        if (typeof modelContext.unregisterTool === 'function') {
+          modelContext.unregisterTool(tool.name);
+        }
+      }
+
+      // pagehide also runs when navigating into the back/forward cache.
+      window.addEventListener('pagehide', unregisterMenuTool);
+      window.addEventListener('pageshow', (event) => {
+        if (event.persisted) void registerMenuTool();
+      });
+      void registerMenuTool();
+    })();
+  </script>
+
 </body>
 
