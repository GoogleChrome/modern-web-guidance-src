+  <script type="module">
+    const startDateInput = document.getElementById('startDateInput');
+    const yearsInput = document.getElementById('yearsInput');
+    const monthsInput = document.getElementById('monthsInput');
+    const overflowSelect = document.getElementById('overflowSelect');
+    const resultDate = document.getElementById('resultDate');
+    let calendar;
+
+    function showResult(message, isError = false) {
+      resultDate.textContent = message;
+      resultDate.dataset.error = String(isError);
+    }
+
+    function readDuration(input, label) {
+      const value = input.valueAsNumber;
+      if (!input.validity.valid || !Number.isSafeInteger(value) || value < 0) {
+        throw new Error(`Enter a non-negative whole number for ${label}.`);
+      }
+      return value;
+    }
+
+    function updateDelivery() {
+      if (!calendar) return;
+      try {
+        if (!startDateInput.value || !startDateInput.validity.valid) {
+          throw new Error('Choose a valid start date.');
+        }
+        const years = readDuration(yearsInput, 'years');
+        const months = readDuration(monthsInput, 'months');
+        const start = calendar.PlainDate.from(startDateInput.value);
+        const next = start.add({ years, months }, { overflow: overflowSelect.value });
+        showResult(next.toLocaleString(undefined, {
+          weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
+        }) + ` (${next.toString()})`);
+      } catch (error) {
+        const message = error instanceof RangeError
+          ? 'Unable to calculate this delivery date. The target day may not exist with “reject” selected, or the interval may be too large. Choose “constrain” or adjust the date or interval.'
+          : error.message;
+        showResult(message, true);
+      }
+    }
+
+    for (const input of [startDateInput, yearsInput, monthsInput, overflowSelect]) {
+      input.addEventListener('input', updateDelivery);
+      input.addEventListener('change', updateDelivery);
+    }
+
+    try {
+      // Date-only calendar arithmetic avoids time-zone and daylight-saving shifts.
+      // Keep the polyfill local to this module; do not overwrite native globals.
+      calendar = typeof globalThis.Temporal?.PlainDate?.from === 'function'
+        && typeof globalThis.Temporal?.Now?.plainDateISO === 'function'
+        ? globalThis.Temporal
+        : (await import('https://esm.sh/@js-temporal/polyfill@0.5.1')).Temporal;
+      if (!startDateInput.value) startDateInput.value = calendar.Now.plainDateISO().toString();
+      updateDelivery();
+    } catch {
+      showResult('The delivery planner could not load. Check your connection and reload the page to try again.', true);
+    }
+  </script>
+
 </body>
 
