+  <script>
+    const form = document.querySelector('#cup-form');
+    const fields = form.querySelectorAll('.content-sized');
+
+    // Keep content sizing available in browsers without CSS field-sizing support.
+    if (!CSS.supports('field-sizing', 'content')) {
+      const canvas = document.createElement('canvas');
+      const context = canvas.getContext('2d');
+
+      function fitField(field) {
+        const style = getComputedStyle(field);
+        context.font = style.font;
+        const value = field.tagName === 'SELECT'
+          ? field.selectedOptions[0].textContent
+          : field.value || field.placeholder || ' ';
+        const textWidth = Math.max(...value.split('\n').map(line => context.measureText(line).width));
+        const chromeWidth = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight)
+          + parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+        field.style.width = `${Math.ceil(textWidth + chromeWidth + 2)}px`;
+
+        if (field.tagName === 'TEXTAREA') {
+          field.style.height = 'auto';
+          field.style.height = `${field.scrollHeight + parseFloat(style.borderTopWidth)
+            + parseFloat(style.borderBottomWidth)}px`;
+        }
+      }
+
+      const fitAll = () => fields.forEach(fitField);
+      fields.forEach(field => {
+        field.addEventListener('input', () => fitField(field));
+        field.addEventListener('change', () => fitField(field));
+      });
+      window.addEventListener('resize', fitAll);
+      document.fonts.ready.then(fitAll);
+      fitAll();
+    }
+
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      const name = form.elements.name.value.trim();
+      const drink = form.elements.drink.value;
+      const notes = form.elements.notes.value.trim();
+      document.querySelector('#cup-preview').textContent =
+        `${drink} for ${name}${notes ? ` — ${notes}` : ''}. Looking good! This is a preview; no order has been placed.`;
+    });
+  </script>
