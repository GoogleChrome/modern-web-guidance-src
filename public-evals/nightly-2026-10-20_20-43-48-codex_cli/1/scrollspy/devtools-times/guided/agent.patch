--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,132 @@
+<section-navigation class="section-navigation">
+  <nav aria-label="On this page" class="section-navigation__links">
+    <span class="section-navigation__label">On this page</span>
+    <a href="#today" aria-current="location">Today</a>
+    <a href="#top-news">Top News</a>
+    <a href="#world">World</a>
+    <a href="#politics">Politics</a>
+  </nav>
+</section-navigation>
+
+<script>
+  class SectionNavigation extends HTMLElement {
+    private cleanup?: () => void;
+
+    connectedCallback() {
+      // Wait until the sections following this component have been parsed.
+      const frame = requestAnimationFrame(() => this.trackSections());
+      this.cleanup = () => cancelAnimationFrame(frame);
+    }
+
+    private trackSections() {
+      const links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
+      const targets = links.map(link => document.getElementById(link.hash.slice(1)));
+      const setCurrent = (current: HTMLAnchorElement | undefined) => {
+        links.forEach(link => {
+          if (link === current) link.setAttribute('aria-current', 'location');
+          else link.removeAttribute('aria-current');
+        });
+      };
+      const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+        CSS.supports('selector(:target-current)');
+
+      if (nativeTracking) {
+        const syncCurrent = () => setCurrent(links.find(link => link.matches(':target-current')));
+        syncCurrent();
+        document.addEventListener('scrollend', syncCurrent);
+        window.addEventListener('resize', syncCurrent);
+        this.cleanup = () => {
+          document.removeEventListener('scrollend', syncCurrent);
+          window.removeEventListener('resize', syncCurrent);
+        };
+      } else {
+        const syncCurrent = () => {
+          let current = links[0];
+          targets.forEach((target, index) => {
+            if (target && target.getBoundingClientRect().top <= window.innerHeight * 0.21) {
+              current = links[index];
+            }
+          });
+          setCurrent(current);
+        };
+        // Track a narrow band near the top, retaining the previous section in gaps.
+        let observer: IntersectionObserver;
+        const observeSections = () => {
+          observer?.disconnect();
+          // Pixel margins use viewport height; percentage root margins use width.
+          observer = new IntersectionObserver(syncCurrent, {
+            rootMargin: `-${window.innerHeight * 0.2}px 0px -${window.innerHeight * 0.79}px 0px`,
+            threshold: 0,
+          });
+          targets.forEach(target => { if (target) observer.observe(target); });
+          syncCurrent();
+        };
+        observeSections();
+        window.addEventListener('resize', observeSections);
+        this.cleanup = () => {
+          observer.disconnect();
+          window.removeEventListener('resize', observeSections);
+        };
+      }
+    }
+
+    disconnectedCallback() {
+      this.cleanup?.();
+    }
+  }
+
+  if (!customElements.get('section-navigation')) {
+    customElements.define('section-navigation', SectionNavigation);
+  }
+</script>
+
+<style>
+  .section-navigation {
+    display: block;
+    position: sticky;
+    top: 0;
+    z-index: 20;
+    background: white;
+    border-bottom: 1px solid #d1d5db;
+  }
+
+  .section-navigation__links {
+    display: flex;
+    align-items: center;
+    gap: clamp(1rem, 4vw, 2rem);
+    padding-inline: 1.5rem;
+    overflow-x: auto;
+    white-space: nowrap;
+    scroll-target-group: auto;
+    font-size: 0.875rem;
+  }
+
+  .section-navigation__label {
+    color: #6b7280;
+    font-size: 0.75rem;
+  }
+
+  a {
+    padding-block: 1rem;
+    border-bottom: 3px solid transparent;
+    color: #4b5563;
+    font-weight: 600;
+    text-decoration: none;
+  }
+
+  a:hover { color: #111827; }
+  a:focus-visible { outline: 2px solid #92400e; outline-offset: -4px; }
+
+  @supports not ((scroll-target-group: auto) and selector(:target-current)) {
+    a[aria-current] { color: #111827; border-bottom-color: #d97706; }
+  }
+
+  @supports (scroll-target-group: auto) and selector(:target-current) {
+    a:is(:target-current) { color: #111827; border-bottom-color: #d97706; }
+  }
+
+  @media (max-width: 480px) {
+    .section-navigation__label { display: none; }
+    .section-navigation__links { justify-content: space-between; padding-inline: 1rem; }
+  }
+</style>
