diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..8487ece
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,74 @@
+---
+interface Props {
+    sections: { id: string; label: string }[];
+}
+const { sections } = Astro.props;
+---
+
+<nav aria-label="On this page" data-section-nav class="sticky top-0 z-20 border-b border-gray-300 bg-white shadow-sm">
+    <div class="flex items-center gap-6 overflow-x-auto px-4 md:px-6">
+        <span class="hidden shrink-0 text-xs font-semibold uppercase tracking-wider text-gray-500 sm:block">On this page</span>
+        {sections.map(({ id, label }, index) => (
+            <a href={`#${id}`} aria-current={index === 0 ? 'location' : undefined} class="shrink-0 border-b-2 border-transparent py-3 text-sm font-semibold text-gray-600 transition-colors hover:text-amber-800 focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-amber-700">
+                {label}
+            </a>
+        ))}
+    </div>
+</nav>
+
+<style>
+    a[aria-current="location"] {
+        border-color: var(--color-amber-700);
+        color: var(--color-amber-800);
+    }
+</style>
+
+<script>
+    let cleanup: (() => void) | undefined;
+
+    function setupSectionNav() {
+        cleanup?.();
+        const nav = document.querySelector<HTMLElement>('[data-section-nav]');
+        if (!nav) return;
+        const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
+        const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+        let frame = 0;
+
+        function update() {
+            frame = 0;
+            if (!nav) return;
+            const offset = nav.getBoundingClientRect().height + 16;
+            let active = 0;
+            sections.forEach((section, index) => {
+                if (section && section.getBoundingClientRect().top <= offset) active = index;
+            });
+            // Short final sections may never reach the top of the viewport.
+            if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
+                active = links.length - 1;
+            }
+            links.forEach((link, index) => {
+                if (index === active) link.setAttribute('aria-current', 'location');
+                else link.removeAttribute('aria-current');
+            });
+        }
+
+        function scheduleUpdate() {
+            if (!frame) frame = requestAnimationFrame(update);
+        }
+
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+        window.addEventListener('resize', scheduleUpdate);
+        const observer = new ResizeObserver(scheduleUpdate);
+        observer.observe(document.body);
+        update();
+        cleanup = () => {
+            window.removeEventListener('scroll', scheduleUpdate);
+            window.removeEventListener('resize', scheduleUpdate);
+            observer.disconnect();
+            cancelAnimationFrame(frame);
+        };
+    }
+
+    document.addEventListener('astro:page-load', setupSectionNav);
+    document.addEventListener('astro:before-swap', () => cleanup?.());
+</script>
