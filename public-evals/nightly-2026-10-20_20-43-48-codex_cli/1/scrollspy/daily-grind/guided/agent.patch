+  <script type="module">
+    const navigation = document.querySelector('nav');
+    const links = [...navigation.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.querySelector(link.hash));
+    const nativeTracking = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(a:target-current)');
+
+    function setCurrent(current) {
+      links.forEach(link => {
+        const active = link === current;
+        link.classList.toggle('is-current', !nativeTracking && active);
+        if (active) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    function syncCurrent() {
+      if (nativeTracking) {
+        setCurrent(links.find(link => link.matches(':target-current')));
+        return;
+      }
+
+      const top = navigation.getBoundingClientRect().bottom;
+      let current = 0;
+      let mostVisible = 0;
+      sections.forEach((section, index) => {
+        const bounds = section.getBoundingClientRect();
+        const visible = Math.max(0,
+          Math.min(bounds.bottom, window.innerHeight) - Math.max(bounds.top, top));
+        if (visible > mostVisible) {
+          mostVisible = visible;
+          current = index;
+        }
+      });
+      if (Math.ceil(window.scrollY + window.innerHeight) >=
+          document.documentElement.scrollHeight) current = links.length - 1;
+      setCurrent(links[current]);
+    }
+
+    let frame;
+    function scheduleSync() {
+      if (frame) return;
+      frame = requestAnimationFrame(() => {
+        frame = undefined;
+        syncCurrent();
+      });
+    }
+
+    const navigationSize = new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height',
+        `${navigation.getBoundingClientRect().height + 16}px`);
+      scheduleSync();
+    });
+    navigationSize.observe(navigation);
+
+    if (!nativeTracking) {
+      const observer = new IntersectionObserver(scheduleSync, {
+        threshold: [0, 0.25, 0.5, 0.75, 1]
+      });
+      sections.forEach(section => observer.observe(section));
+    }
+
+    document.addEventListener('scroll', scheduleSync, { passive: true });
+    document.addEventListener('scrollend', scheduleSync);
+    window.addEventListener('resize', scheduleSync);
+    window.addEventListener('hashchange', scheduleSync);
+    scheduleSync();
+  </script>
+
