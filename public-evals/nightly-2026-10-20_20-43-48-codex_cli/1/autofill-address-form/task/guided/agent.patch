+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const addressPreview = document.getElementById('address-preview');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const data = new FormData(shippingForm);
+      const lines = [
+        'Your shipping address preview',
+        ...['full_name', 'address_line1', 'address_line2', 'city', 'region', 'postal_code', 'country']
+          .map((name) => data.get(name).trim())
+          .filter(Boolean),
+        '',
+        'This address has not been saved or submitted.'
+      ];
+      addressPreview.textContent = lines.join('\n');
+    });
+
+    shippingForm.addEventListener('input', () => {
+      addressPreview.textContent = '';
+    });
+
+    document.getElementById('review-address').disabled = false;
+  </script>
