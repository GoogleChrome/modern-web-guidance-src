+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingStatus = document.getElementById('shipping-status');
+
+    shippingForm.addEventListener('input', (event) => {
+      event.target.setCustomValidity('');
+      shippingStatus.textContent = '';
+    });
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      for (const field of shippingForm.querySelectorAll('input[required]')) {
+        field.setCustomValidity(field.value.trim() ? '' : 'Please fill out this field.');
+      }
+      if (!shippingForm.reportValidity()) return;
+      shippingStatus.textContent = 'Shipping address confirmed for this visit. No order has been placed.';
+    });
+  </script>
