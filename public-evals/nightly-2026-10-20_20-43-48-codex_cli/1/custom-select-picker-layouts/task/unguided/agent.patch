+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const menu = document.getElementById('roast-menu');
+    const options = [...menu.querySelectorAll('[role="option"]')];
+
+    function closeRoasts(restoreFocus = false) {
+      menu.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openRoasts() {
+      menu.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options.find(option => option.getAttribute('aria-selected') === 'true').focus();
+    }
+
+    trigger.addEventListener('click', () => menu.hidden ? openRoasts() : closeRoasts());
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openRoasts();
+      }
+    });
+
+    options.forEach(option => option.addEventListener('click', () => {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      document.getElementById('roast-value').textContent = option.querySelector('strong').textContent + ' roast';
+      document.getElementById('order-now').href = '/order-online?roast=' + option.dataset.value;
+      closeRoasts(true);
+    }));
+
+    picker.addEventListener('keydown', event => {
+      if (event.key === 'Escape') {
+        closeRoasts(true);
+        event.preventDefault();
+      }
+      if (menu.hidden) return;
+      const current = options.indexOf(document.activeElement);
+      let next;
+      if (['ArrowRight', 'ArrowDown'].includes(event.key)) next = (current + 1) % options.length;
+      if (['ArrowLeft', 'ArrowUp'].includes(event.key)) next = (current + options.length - 1) % options.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = options.length - 1;
+      if (next !== undefined) {
+        event.preventDefault();
+        options[next].focus();
+      }
+    });
+
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closeRoasts();
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closeRoasts();
+    });
+  </script>
