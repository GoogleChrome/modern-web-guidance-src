+  <script>
+    // Keep the three-column photo picker on browsers without customizable selects.
+    const roastSelect = document.getElementById('roast');
+    if (!CSS.supports('appearance', 'base-select')) {
+      const fallback = document.querySelector('.roast-fallback');
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-trigger');
+      trigger.setAttribute('aria-controls', 'roast-menu');
+      const menu = document.createElement('div');
+      menu.id = 'roast-menu';
+      menu.className = 'roast-menu';
+      menu.hidden = true;
+      menu.setAttribute('role', 'listbox');
+      menu.setAttribute('aria-labelledby', 'roast-label');
+      menu.setAttribute('aria-orientation', 'horizontal');
+      const options = Array.from(roastSelect.options);
+      const cards = options.map(option => {
+        const card = document.createElement('button');
+        card.type = 'button';
+        card.className = 'roast-option';
+        card.dataset.tone = option.value;
+        card.setAttribute('role', 'option');
+        card.setAttribute('aria-label', option.getAttribute('aria-label'));
+        const image = document.createElement('img');
+        image.src = 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=240&q=80';
+        image.alt = '';
+        image.width = 120;
+        image.height = 78;
+        const name = document.createElement('span');
+        name.className = 'roast-name';
+        name.textContent = option.value[0].toUpperCase() + option.value.slice(1);
+        const notes = document.createElement('span');
+        notes.className = 'roast-notes';
+        notes.textContent = option.dataset.notes;
+        card.append(image, name, notes);
+        card.addEventListener('click', () => {
+          roastSelect.value = option.value;
+          roastSelect.dispatchEvent(new Event('change', { bubbles: true }));
+          update();
+          close(true);
+        });
+        menu.append(card);
+        return card;
+      });
+      function update() {
+        trigger.textContent = `${roastSelect.value[0].toUpperCase()}${roastSelect.value.slice(1)} roast ▾`;
+        cards.forEach((card, index) => {
+          card.setAttribute('aria-selected', String(options[index].selected));
+          card.tabIndex = options[index].selected ? 0 : -1;
+        });
+      }
+      function close(restoreFocus = false) {
+        menu.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) trigger.focus();
+      }
+      function open() {
+        menu.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        cards[roastSelect.selectedIndex].focus();
+      }
+      trigger.addEventListener('click', () => menu.hidden ? open() : close());
+      trigger.addEventListener('keydown', event => {
+        if (['ArrowDown', 'ArrowUp'].includes(event.key)) {
+          event.preventDefault();
+          open();
+        }
+      });
+      menu.addEventListener('keydown', event => {
+        const index = cards.indexOf(document.activeElement);
+        let next = index;
+        if (['ArrowRight', 'ArrowDown'].includes(event.key)) next = (index + 1) % cards.length;
+        else if (['ArrowLeft', 'ArrowUp'].includes(event.key)) next = (index + cards.length - 1) % cards.length;
+        else if (event.key === 'Home') next = 0;
+        else if (event.key === 'End') next = cards.length - 1;
+        else if (event.key === 'Escape') { event.preventDefault(); close(true); return; }
+        else if (event.key.length === 1) {
+          const match = options.findIndex(option => option.value.startsWith(event.key.toLowerCase()));
+          if (match < 0) return;
+          next = match;
+        } else return;
+        event.preventDefault();
+        cards[next].focus();
+      });
+      document.addEventListener('pointerdown', event => {
+        if (!fallback.contains(event.target)) close();
+      });
+      fallback.addEventListener('focusout', event => {
+        if (!fallback.contains(event.relatedTarget)) close();
+      });
+      fallback.append(trigger, menu);
+      update();
+      roastSelect.hidden = true;
+      fallback.hidden = false;
+      document.getElementById('roast-label').htmlFor = trigger.id;
+    }
+  </script>
