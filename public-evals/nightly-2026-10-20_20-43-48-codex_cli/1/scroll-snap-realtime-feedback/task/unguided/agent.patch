+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+    const supportsSnapEvents = 'onscrollsnapchanging' in gallery;
+    let previousLeft = gallery.scrollLeft;
+    let settleTimer;
+    let requestedIndex = null;
+
+    function markPending(index) {
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.toggle('pending', i === index);
+      });
+    }
+
+    function nearestIndex() {
+      const galleryLeft = gallery.getBoundingClientRect().left + gallery.clientLeft;
+      return items.reduce((nearest, item, index) =>
+        Math.abs(item.getBoundingClientRect().left - galleryLeft) <
+        Math.abs(items[nearest].getBoundingClientRect().left - galleryLeft) ? index : nearest, 0);
+    }
+
+    function select(index) {
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    }
+
+    function finishScroll() {
+      clearTimeout(settleTimer);
+      requestedIndex = null;
+      previousLeft = gallery.scrollLeft;
+      select(nearestIndex());
+    }
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      const index = items.indexOf(event.snapTargetInline);
+      if (index !== -1) markPending(index);
+    });
+
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      const index = items.indexOf(event.snapTargetInline);
+      if (index !== -1) select(index);
+    });
+
+    gallery.addEventListener('scroll', () => {
+      if (!supportsSnapEvents) {
+        const progress = gallery.scrollLeft / gallery.clientWidth;
+        const direction = Math.sign(gallery.scrollLeft - previousLeft);
+        const target = requestedIndex ?? (direction > 0 ? Math.ceil(progress) : Math.floor(progress));
+        markPending(Math.max(0, Math.min(items.length - 1, target)));
+      }
+      previousLeft = gallery.scrollLeft;
+      // Older browsers without scrollend use a short inactivity fallback.
+      if (!('onscrollend' in gallery)) {
+        clearTimeout(settleTimer);
+        settleTimer = setTimeout(finishScroll, 180);
+      }
+    }, { passive: true });
+
+    gallery.addEventListener('scrollend', finishScroll);
+    ['pointerdown', 'wheel', 'keydown'].forEach((eventName) => {
+      gallery.addEventListener(eventName, () => { requestedIndex = null; }, { passive: true });
+    });
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        requestedIndex = index;
+        markPending(index);
+        const left = gallery.scrollLeft + items[index].getBoundingClientRect().left -
+          gallery.getBoundingClientRect().left - gallery.clientLeft;
+        if (Math.abs(gallery.scrollLeft - left) < 1) {
+          finishScroll();
+          return;
+        }
+        gallery.scrollTo({
+          left,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+  </script>
