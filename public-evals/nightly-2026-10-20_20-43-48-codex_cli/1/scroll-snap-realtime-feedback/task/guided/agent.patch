+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+    let frame = null;
+    let scrollTimeout;
+
+    const findClosestItemIndex = () => {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      let closest = 0;
+      let distance = Infinity;
+      items.forEach((item, index) => {
+        const nextDistance = Math.abs(item.offsetLeft + item.offsetWidth / 2 - center);
+        if (nextDistance < distance) {
+          closest = index;
+          distance = nextDistance;
+        }
+      });
+      return closest;
+    };
+
+    const setPending = (index) => {
+      if (!thumbnails[index]) return;
+      thumbnails.forEach((thumbnail, i) => thumbnail.classList.toggle('pending', i === index));
+    };
+
+    const setActive = (index) => {
+      if (!thumbnails[index]) return;
+      cancelAnimationFrame(frame);
+      frame = null;
+      clearTimeout(scrollTimeout);
+      thumbnails.forEach((thumbnail, i) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', i === index);
+        if (i === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    };
+
+    const syncSelection = () => setActive(findClosestItemIndex());
+    const supportsPending = 'onscrollsnapchanging' in gallery;
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      setPending(items.indexOf(event.snapTargetInline));
+    });
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      setActive(items.indexOf(event.snapTargetInline));
+    });
+
+    // Also clear pending when a gesture returns to the already active slide.
+    gallery.addEventListener('scrollend', syncSelection);
+    gallery.addEventListener('scroll', () => {
+      if (!supportsPending && frame === null) {
+        frame = requestAnimationFrame(() => {
+          frame = null;
+          setPending(findClosestItemIndex());
+        });
+      }
+      if (!('onscrollend' in gallery)) {
+        clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(syncSelection, 150);
+      }
+    }, { passive: true });
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        gallery.scrollTo({
+          left: items[index].offsetLeft,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    syncSelection();
+    window.addEventListener('load', syncSelection, { once: true });
+    window.addEventListener('pageshow', syncSelection);
+  </script>
