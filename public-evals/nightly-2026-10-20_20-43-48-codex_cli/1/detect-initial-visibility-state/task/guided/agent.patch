+        });
+        return;
+      }
+
+      // UNRELIABLE FALLBACK: current visibility cannot recover initial state
+      // after an async script delay. This timestamp is only the observation
+      // time, not the exact time the page was backgrounded.
+      const hiddenNow = document.visibilityState === 'hidden';
+      console.warn(
+        'Visibility history unavailable: fallback detection is active and potentially unreliable, especially for async scripts. timeBackgrounded is an observation time only.'
+      );
+      console.log({
+        initiallyBackgrounded: hiddenNow,
+        timeBackgrounded: hiddenNow ? performance.now() : null,
+        fallbackDetection: true
+      });
+    })();
+  </script>
