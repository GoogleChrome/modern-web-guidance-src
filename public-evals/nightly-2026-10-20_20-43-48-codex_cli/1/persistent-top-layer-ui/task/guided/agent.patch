+    <div id="feedback-host-footer"></div>
   </footer>
 
+  <button type="button" class="btn feedback-launcher" id="feedback-launcher" aria-haspopup="dialog" aria-controls="feedback-dialog">Share feedback</button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackLauncher = document.getElementById('feedback-launcher');
+    const moveButton = document.getElementById('feedback-move');
+    const mainHost = document.getElementById('feedback-host-main');
+    const footerHost = document.getElementById('feedback-host-footer');
+
+    feedbackLauncher.addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+
+    for (const id of ['feedback-close', 'feedback-done']) {
+      document.getElementById(id).addEventListener('click', () => feedbackDialog.close());
+    }
+
+    feedbackDialog.addEventListener('close', () => {
+      // A fallback move queues a close event, but immediately reopens the dialog.
+      if (!feedbackDialog.open) feedbackLauncher.focus({ preventScroll: true });
+    });
+
+    moveButton.addEventListener('click', () => {
+      const target = feedbackDialog.parentElement === mainHost ? footerHost : mainHost;
+
+      if (typeof target.moveBefore === 'function') {
+        // Both hosts are connected to this document. This atomic move retains
+        // the top layer, modal focus handling, and all descendant state.
+        target.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const returnValue = feedbackDialog.returnValue;
+        const focused = feedbackDialog.contains(document.activeElement) ? document.activeElement : null;
+        const selection = focused instanceof HTMLTextAreaElement ||
+          (focused instanceof HTMLInputElement && focused.selectionStart !== null)
+          ? [focused.selectionStart, focused.selectionEnd, focused.selectionDirection] : null;
+        const scrollPositions = [feedbackDialog, ...feedbackDialog.querySelectorAll('textarea')]
+          .map(element => [element, element.scrollTop, element.scrollLeft]);
+
+        // Explicitly close first: a traditional move can leave an open attribute
+        // without modal/top-layer state, making showModal() a no-op.
+        if (wasOpen) feedbackDialog.close();
+        target.insertBefore(feedbackDialog, null);
+        if (wasOpen) {
+          feedbackDialog.showModal();
+          focused?.focus({ preventScroll: true });
+          if (selection) focused.setSelectionRange(...selection);
+        }
+        feedbackDialog.returnValue = returnValue;
+        for (const [element, top, left] of scrollPositions) {
+          element.scrollTop = top;
+          element.scrollLeft = left;
+        }
+      }
+
+      const isLeft = target === footerHost;
+      moveButton.textContent = isLeft ? 'Move to right →' : 'Move to left ←';
+      document.getElementById('feedback-status').textContent =
+        `Position: ${isLeft ? 'left' : 'right'} · Moved with your draft intact.`;
+    });
+  </script>
