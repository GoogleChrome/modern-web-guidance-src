diff --git a/src/pages/api/auth/[action].ts b/src/pages/api/auth/[action].ts
new file mode 100644
index 0000000..7475f76
--- /dev/null
+++ b/src/pages/api/auth/[action].ts
@@ -0,0 +1,129 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import type { AuthenticatorTransport } from '@simplewebauthn/server';
+import { db, random, digest, getSession, takeChallenge, passwordHash, passwordMatches, rateLimit, type User, type Key } from '../../../lib/auth-store';
+
+export const ALL: APIRoute = async ({ request, cookies, params, url }) => {
+  const reply = (data: unknown, status = 200) => Response.json(data, { status, headers: { 'Cache-Control': 'no-store' } });
+  const configured = process.env.AUTH_ORIGIN || url.origin;
+  const origin = new URL(configured).origin;
+  const rpID = new URL(origin).hostname;
+  const cookieOptions = { path: import.meta.env.BASE_URL, httpOnly: true, sameSite: 'lax' as const, secure: origin.startsWith('https:') };
+  const session = getSession(cookies.get('times_auth')?.value);
+  const user = session ? db.prepare('SELECT * FROM users WHERE id = ?').get(session.user_id) as User : undefined;
+  const keys = () => db.prepare('SELECT * FROM passkeys WHERE user_id = ? ORDER BY created_at DESC').all(user!.id) as Key[];
+  const establish = (userId: string) => {
+    if (session) db.prepare('DELETE FROM sessions WHERE id = ?').run(session.id);
+    db.prepare('DELETE FROM sessions WHERE expires < ?').run(Date.now());
+    const token = random();
+    db.prepare('INSERT INTO sessions VALUES (?, ?, ?, ?)').run(digest(token), userId, Date.now() + 7 * 86400_000, Date.now());
+    cookies.set('times_auth', token, { ...cookieOptions, maxAge: 7 * 86400 });
+  };
+  const challenge = (value: unknown) => {
+    const token = random();
+    db.prepare('DELETE FROM challenges WHERE expires < ?').run(Date.now());
+    db.prepare('INSERT INTO challenges VALUES (?, ?, ?)').run(digest(token), JSON.stringify(value), Date.now() + 300_000);
+    cookies.set('times_challenge', token, { ...cookieOptions, maxAge: 300 });
+  };
+  try {
+    if (request.method === 'GET' && params.action === 'me') {
+      return reply({ user: user ? { username: user.username, hasPassword: !!user.password } : null, passkeys: user ? keys().map(({ id, name, created_at, last_used }) => ({ id, name, created_at, last_used })) : [], recent: !!session && Date.now() - session.verified_at < 300_000 });
+    }
+    if (request.method !== 'POST') return reply({ error: 'Method not allowed' }, 405);
+    if (request.headers.get('origin') !== origin) return reply({ error: 'Invalid request origin' }, 403);
+    const body = await request.json();
+    if (['login', 'signup', 'register-options', 'authenticate-options'].includes(params.action!)) rateLimit(`${params.action}:${digest(cookies.get('times_auth')?.value || request.headers.get('x-forwarded-for') || 'anonymous')}`);
+    const requireUser = () => { if (!user) throw new Error('Please sign in to continue.'); };
+    const requireRecent = () => { requireUser(); if (Date.now() - session!.verified_at > 300_000) throw new Error('Please verify your identity before making this change.'); };
+    const username = () => {
+      if (typeof body.username !== 'string' || !/^[a-zA-Z0-9_.-]{3,40}$/.test(body.username.trim())) throw new Error('Use 3–40 letters, numbers, dots, hyphens, or underscores for your username.');
+      return body.username.trim().toLowerCase();
+    };
+    if (params.action === 'signup') {
+      const name = username();
+      if (typeof body.password !== 'string' || body.password.length < 8 || body.password.length > 256 || !/\d/.test(body.password)) throw new Error('Use a password of 8–256 characters with at least one number.');
+      if (db.prepare('SELECT id FROM users WHERE username = ?').get(name)) throw new Error('That username is already taken.');
+      const id = random();
+      db.prepare('INSERT INTO users VALUES (?, ?, ?)').run(id, name, passwordHash(body.password));
+      establish(id);
+      return reply({ ok: true });
+    }
+    if (params.action === 'login' || params.action === 'reauth-password') {
+      if (params.action === 'reauth-password') requireUser();
+      rateLimit(`password:${params.action === 'login' ? username() : user!.id}`);
+      const account = params.action === 'login' ? db.prepare('SELECT * FROM users WHERE username = ?').get(username()) as User | undefined : user;
+      const hash = account?.password || passwordHash(random());
+      if (typeof body.password !== 'string' || body.password.length > 256 || !passwordMatches(body.password, hash) || !account?.password) throw new Error('The username or password is incorrect.');
+      establish(account.id);
+      return reply({ ok: true });
+    }
+    if (params.action === 'logout') {
+      if (session) db.prepare('DELETE FROM sessions WHERE id = ?').run(session.id);
+      cookies.delete('times_auth', cookieOptions);
+      return reply({ ok: true });
+    }
+    if (params.action === 'register-options') {
+      if (user) requireRecent();
+      const name = user?.username || username();
+      if (!user && db.prepare('SELECT id FROM users WHERE username = ?').get(name)) throw new Error('That username is already taken. Sign in to add a passkey.');
+      const userId = user?.id || random();
+      const options = await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID, userName: name, userID: Buffer.from(userId), attestationType: 'none', excludeCredentials: user ? keys().map(k => ({ id: k.id })) : [], authenticatorSelection: { residentKey: 'required', userVerification: 'required' } });
+      challenge({ kind: 'register', challenge: options.challenge, userId, username: name, sessionId: session?.id || null });
+      return reply(options);
+    }
+    if (params.action === 'authenticate-options') {
+      if (body.reauthenticate) requireUser();
+      const options = await generateAuthenticationOptions({ rpID, userVerification: 'required', ...(body.reauthenticate ? { allowCredentials: keys().map(k => ({ id: k.id, transports: JSON.parse(k.transports) })) } : {}) });
+      if (body.reauthenticate && !keys().length) throw new Error('No passkey is available. Verify with your password.');
+      challenge({ kind: body.reauthenticate ? 'reauthenticate' : 'authenticate', challenge: options.challenge, userId: body.reauthenticate ? user!.id : null, sessionId: body.reauthenticate ? session!.id : null });
+      return reply(options);
+    }
+    if (params.action === 'register-verify' || params.action === 'authenticate-verify') {
+      const pending = takeChallenge(cookies.get('times_challenge')?.value || '');
+      cookies.delete('times_challenge', cookieOptions);
+      if ((pending.sessionId || null) !== (session?.id || null)) throw new Error('Your session changed. Please try again.');
+      if (params.action === 'register-verify') {
+        if (pending.kind !== 'register') throw new Error('Invalid registration request.');
+        if (pending.sessionId) requireRecent();
+        const result = await verifyRegistrationResponse({ response: body.credential, expectedChallenge: pending.challenge, expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true });
+        if (!result.verified || !result.registrationInfo) throw new Error('Could not verify this passkey.');
+        const { credential } = result.registrationInfo;
+        db.exec('BEGIN IMMEDIATE');
+        try {
+          if (!pending.sessionId) db.prepare('INSERT INTO users VALUES (?, ?, NULL)').run(pending.userId, pending.username);
+          db.prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, NULL)').run(credential.id, pending.userId, Buffer.from(credential.publicKey).toString('base64url'), credential.counter, JSON.stringify(credential.transports || []), 'My passkey', Date.now());
+          db.exec('COMMIT');
+        } catch (error) { db.exec('ROLLBACK'); throw error; }
+        establish(pending.userId);
+      } else {
+        if (!['authenticate', 'reauthenticate'].includes(pending.kind)) throw new Error('Invalid authentication request.');
+        const key = db.prepare('SELECT * FROM passkeys WHERE id = ?').get(body.credential?.id || '') as Key | undefined;
+        if (!key || (pending.userId && key.user_id !== pending.userId)) throw new Error('This passkey is not registered for this account.');
+        if (body.credential.response?.userHandle && body.credential.response.userHandle !== Buffer.from(key.user_id).toString('base64url')) throw new Error('Invalid account identifier.');
+        const result = await verifyAuthenticationResponse({ response: body.credential, expectedChallenge: pending.challenge, expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true, credential: { id: key.id, publicKey: Buffer.from(key.public_key, 'base64url'), counter: key.counter, transports: JSON.parse(key.transports) as AuthenticatorTransport[] } });
+        if (!result.verified) throw new Error('Could not verify this passkey.');
+        const update = db.prepare('UPDATE passkeys SET counter = ?, last_used = ? WHERE id = ? AND counter = ?').run(result.authenticationInfo.newCounter, Date.now(), key.id, key.counter);
+        if (update.changes !== 1) throw new Error('This passkey changed. Please try again.');
+        establish(key.user_id);
+      }
+      return reply({ ok: true });
+    }
+    if (params.action === 'rename' || params.action === 'delete') {
+      requireRecent();
+      const key = keys().find(k => k.id === body.id);
+      if (!key) return reply({ error: 'Passkey not found.' }, 404);
+      if (params.action === 'rename') {
+        if (typeof body.name !== 'string' || !body.name.trim() || body.name.trim().length > 60) throw new Error('Enter a name between 1 and 60 characters.');
+        db.prepare('UPDATE passkeys SET name = ? WHERE id = ? AND user_id = ?').run(body.name.trim(), key.id, user!.id);
+      } else {
+        if (!user!.password && keys().length === 1) throw new Error('Add another passkey before removing your only way to sign in.');
+        db.prepare('DELETE FROM passkeys WHERE id = ? AND user_id = ?').run(key.id, user!.id);
+      }
+      return reply({ ok: true });
+    }
+    return reply({ error: 'Not found' }, 404);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : '';
+    return reply({ error: /SQLITE|constraint|verification|signature|RP ID|Unexpected|JSON/i.test(message) ? 'We could not verify this request. Please try again.' : message || 'Something went wrong. Please try again.' }, 400);
+  }
+};
