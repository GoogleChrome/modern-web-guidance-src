diff --git a/src/components/AuthForm.tsx b/src/components/AuthForm.tsx
new file mode 100644
index 0000000..170bb25
--- /dev/null
+++ b/src/components/AuthForm.tsx
@@ -0,0 +1,36 @@
+import { useState } from 'react';
+import { FingerPrintIcon, ArrowRightIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import { api, base, registerPasskey, authenticatePasskey, authError } from '../lib/auth-client';
+
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [busy, setBusy] = useState<string | null>(null);
+  const [error, setError] = useState('');
+  async function run(kind: string) {
+    setBusy(kind); setError('');
+    try {
+      if (kind === 'passkey') {
+        if (signup) await registerPasskey(username); else await authenticatePasskey();
+      } else await api(signup ? 'signup' : 'login', { username, password });
+      window.location.assign(`${base}account/security`);
+    } catch (e) { setError(authError(e)); } finally { setBusy(null); }
+  }
+  return <div className="mx-auto max-w-[440px]">
+    <a href={base} className="text-xs font-semibold tracking-[0.15em] text-gray-500">THE DEVTOOLS TIMES / YOUR ACCOUNT</a>
+    <h1 className="mt-8 font-serif text-4xl text-gray-900">{signup ? 'Make yourself at home.' : 'Welcome back.'}</h1>
+    <p className="mt-3 mb-8 text-gray-500">{signup ? 'A world of stories. One account to make it yours.' : 'Sign in to keep your stories close.'}</p>
+    {error && <div role="alert" className="mb-5 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-800">{error}</div>}
+    <form onSubmit={e => { e.preventDefault(); void run('password'); }} className="space-y-5">
+      <div><label className="mb-2 block text-sm font-semibold" htmlFor="username">Username</label><input className="auth-input" id="username" name="username" autoComplete="username webauthn" required minLength={3} maxLength={40} value={username} onChange={e => setUsername(e.target.value)} placeholder="Your username" /></div>
+      {signup && <button type="button" disabled={!!busy} onClick={() => void run('passkey')} className="auth-primary"><FingerPrintIcon className="h-5 w-5" />{busy === 'passkey' ? 'Creating your passkey…' : 'Create account with a passkey'}</button>}
+      {signup && <p className="text-xs leading-5 text-gray-500">Use 3–40 letters, numbers, dots, hyphens, or underscores. Your passkey replaces a password.</p>}
+      {signup && <div className="auth-divider">or use a password</div>}
+      <div><label className="mb-2 block text-sm font-semibold" htmlFor="password">Password</label><input className="auth-input" type="password" id="password" autoComplete={signup ? 'new-password' : 'current-password'} required minLength={signup ? 8 : undefined} maxLength={256} value={password} onChange={e => setPassword(e.target.value)} placeholder={signup ? 'Create a password' : 'Enter your password'} />{signup && <p className="mt-2 text-xs text-gray-500">At least 8 characters, including a number.</p>}</div>
+      <button disabled={!!busy} className={signup ? 'auth-secondary' : 'auth-primary'}>{busy === 'password' ? 'Please wait…' : signup ? 'Create account with password' : 'Sign in'}<ArrowRightIcon className="h-4 w-4" /></button>
+    </form>
+    {!signup && <><div className="auth-divider">or, skip the password</div><button className="auth-secondary" disabled={!!busy} onClick={() => void run('passkey')}><FingerPrintIcon className="h-5 w-5" />{busy === 'passkey' ? 'Waiting for your passkey…' : 'Sign in with a passkey'}</button><p className="mt-3 text-center text-xs leading-5 text-gray-500">Use your fingerprint, face, or device PIN.<br />Your biometric data never leaves your device.</p></>}
+    <p className="mt-8 border-t border-gray-200 pt-6 text-center text-sm text-gray-500">{signup ? 'Already have an account?' : 'New to The Times?'} <a className="font-semibold text-gray-900 underline underline-offset-4" href={`${base}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'}</a></p>
+    <p className="mt-7 flex items-center justify-center gap-2 text-xs text-gray-400"><ShieldCheckIcon className="h-4 w-4" />Your account. A little more secure.</p>
+  </div>;
+}
