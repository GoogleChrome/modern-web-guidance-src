+  let logs = ''; server.stderr.on('data', data => logs += data);
+  t.after(async () => { server.kill(); await new Promise(resolve => server.once('exit', resolve)); rmSync(directory, { recursive: true, force: true }); });
+  for (let i = 0; i < 100; i++) {
+    try { await fetch(base + 'me'); break; } catch { await new Promise(resolve => setTimeout(resolve, 100)); }
+    if (i === 99) throw new Error(logs);
+  }
+  const account = client(); const stranger = client();
+  let options; let key;
+  await t.test('requires a valid origin and signed-in management', async () => {
+    assert.equal((await account('signup', { username: 'reader', password: 'password123' }, 'https://evil.example')).status, 403);
+    assert.equal((await account('delete', { id: 'anything' })).status, 400);
+  });
+  await t.test('creates a passwordless account only after verified attestation', async () => {
+    options = (await account('register-options', { username: 'reader' })).data;
