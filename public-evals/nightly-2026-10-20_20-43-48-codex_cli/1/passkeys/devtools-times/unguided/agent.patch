+++ b/src/lib/auth-store.ts
@@ -0,0 +1,42 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { randomBytes, createHash, scryptSync, timingSafeEqual } from 'node:crypto';
+
+const path = process.env.AUTH_DB_PATH || './data/auth.sqlite';
+mkdirSync(dirname(path), { recursive: true });
+export const db = new DatabaseSync(path);
+db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, password TEXT);
+CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), public_key TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, name TEXT NOT NULL, created_at INTEGER NOT NULL, last_used INTEGER);
+CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), expires INTEGER NOT NULL, verified_at INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, value TEXT NOT NULL, expires INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS attempts (id TEXT PRIMARY KEY, count INTEGER NOT NULL, expires INTEGER NOT NULL);`);
+export type User = { id: string; username: string; password: string | null };
+export type Key = { id: string; user_id: string; public_key: string; counter: number; transports: string; name: string; created_at: number; last_used: number | null };
+export type Session = { id: string; user_id: string; expires: number; verified_at: number };
+export const random = () => randomBytes(32).toString('base64url');
+export const digest = (value: string) => createHash('sha256').update(value).digest('hex');
+export function passwordHash(password: string) {
+  const salt = random();
+  return `${salt}:${scryptSync(password, salt, 64).toString('hex')}`;
+}
+export function passwordMatches(password: string, hash: string) {
+  const [salt, value] = hash.split(':');
+  return timingSafeEqual(scryptSync(password, salt, 64), Buffer.from(value, 'hex'));
+}
+export function getSession(token?: string): Session | undefined {
+  if (!token) return;
+  return db.prepare('SELECT * FROM sessions WHERE id = ? AND expires > ?').get(digest(token), Date.now()) as Session | undefined;
+}
+export function takeChallenge(id: string) {
+  const row = db.prepare('DELETE FROM challenges WHERE id = ? RETURNING value, expires').get(digest(id)) as { value: string; expires: number } | undefined;
+  if (!row || row.expires < Date.now()) throw new Error('This request expired. Please try again.');
+  return JSON.parse(row.value);
+}
+export function rateLimit(id: string) {
+  const now = Date.now();
+  db.prepare('DELETE FROM attempts WHERE expires < ?').run(now);
+  const row = db.prepare(`INSERT INTO attempts VALUES (?, 1, ?) ON CONFLICT(id) DO UPDATE SET count = count + 1 RETURNING count`).get(id, now + 60_000) as { count: number };
+  if (row.count > 20) throw new Error('Too many attempts. Please wait a minute and try again.');
+}
