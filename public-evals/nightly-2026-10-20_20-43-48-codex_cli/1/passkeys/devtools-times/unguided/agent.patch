@@ -0,0 +1,25 @@
+import { startRegistration, startAuthentication, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+export const base = import.meta.env.BASE_URL;
+export async function api(action: string, body?: unknown) {
+  const response = await fetch(`${base}api/auth/${action}`, body === undefined ? { cache: 'no-store' } : { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || 'Please try again.');
+  return data;
+}
+export async function registerPasskey(username?: string) {
+  if (!browserSupportsWebAuthn() || !window.isSecureContext) throw new Error('Passkeys require a supported browser and a secure connection (HTTPS or localhost).');
+  const optionsJSON = await api('register-options', { username });
+  const credential = await startRegistration({ optionsJSON });
+  return api('register-verify', { credential });
+}
+export async function authenticatePasskey(reauthenticate = false) {
+  if (!browserSupportsWebAuthn() || !window.isSecureContext) throw new Error('Passkeys require a supported browser and a secure connection (HTTPS or localhost).');
+  const optionsJSON = await api('authenticate-options', { reauthenticate });
+  const credential = await startAuthentication({ optionsJSON });
+  return api('authenticate-verify', { credential });
+}
+export function authError(error: unknown) {
+  if (error instanceof Error && ['NotAllowedError', 'AbortError'].includes(error.name)) return 'The passkey request was canceled or timed out. You can try again.';
+  if (error instanceof Error && error.name === 'InvalidStateError') return 'This device already has a passkey for your account. Try another device.';
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
diff --git a/src/lib/auth-store.ts b/src/lib/auth-store.ts
