+import { useEffect, useState } from 'react';
+import { FingerPrintIcon, PlusIcon, ShieldCheckIcon, ArrowRightIcon, KeyIcon, CheckIcon, DevicePhoneMobileIcon } from '@heroicons/react/24/outline';
+import { api, base, registerPasskey, authenticatePasskey, authError } from '../lib/auth-client';
+type Passkey = { id: string; name: string; created_at: number; last_used: number | null };
+type Account = { user: { username: string; hasPassword: boolean } | null; passkeys: Passkey[]; recent: boolean };
+export default function SecuritySettings() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [message, setMessage] = useState('');
+  const [rename, setRename] = useState<Passkey | null>(null);
+  const [remove, setRemove] = useState<Passkey | null>(null);
+  const [verify, setVerify] = useState(false);
+  const [password, setPassword] = useState('');
+  const dialogOpen = !!(rename || remove || verify);
+  useEffect(() => {
+    if (!dialogOpen) return;
+    const previous = document.activeElement as HTMLElement | null;
+    const dialog = document.getElementById('security-dialog');
+    dialog?.querySelector<HTMLElement>('input, button')?.focus();
+    return () => previous?.focus();
+  }, [dialogOpen]);
+  async function load() { const result = await api('me'); if (!result.user) { window.location.assign(`${base}signin`); return; } setAccount(result); }
+  useEffect(() => { load().catch(e => setError(authError(e))); }, []);
+  async function run(action: () => Promise<unknown>, success: string) {
+    setBusy(true); setError(''); setMessage('');
+    try { await action(); await load(); setMessage(success); }
+    catch (e) { setError(authError(e)); }
+    finally { setBusy(false); }
+  }
+  async function ensureRecent() {
+    const current = await api('me'); setAccount(current);
+    if (!current.recent) { setRename(null); setRemove(null); setVerify(true); throw new Error('For your security, verify your identity, then try your change again.'); }
+  }
+  const date = (time: number) => new Date(time).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
+  return <div className="mx-auto max-w-5xl px-6 py-10 md:px-10 md:py-14">
+    <div className="mb-8 flex items-center justify-between border-b border-gray-200 pb-5"><span className="text-xs font-semibold tracking-[.18em] text-gray-500">YOUR TIMES ACCOUNT</span><button disabled={busy} onClick={() => void run(async () => { await api('logout', {}); window.location.assign(`${base}signin`); }, '')} className="text-sm text-gray-500 hover:underline">Sign out ↗</button></div>
+    <div className="mb-10"><p className="mb-3 text-sm text-gray-500">Account <span className="mx-2">/</span> <span className="text-gray-900">Security</span></p><h1 className="font-serif text-4xl md:text-5xl">A safer way to sign in.</h1><p className="mt-4 text-gray-500">Manage your passkeys and keep your account protected.</p></div>
+    {error && <div role="alert" className="mb-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">{error}</div>}
+    {message && <div role="status" className="mb-5 flex items-center gap-2 rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-900"><CheckIcon className="h-4 w-4" />{message}</div>}
+    {!account ? <p role="status" className="py-12 text-gray-500">Loading account security…</p> : <div className="grid gap-8 md:grid-cols-[1fr_270px]">
+      <div className="space-y-6">
+        <section className="overflow-hidden rounded-xl border border-gray-200">
+          <div className="border-b border-gray-200 p-6"><div className="mb-4 flex items-center gap-3"><div className="rounded-lg bg-[#edf2ee] p-2.5"><FingerPrintIcon className="h-6 w-6 text-[#34533f]" /></div><h2 className="text-xl font-semibold">Passkeys</h2><span className="ml-auto rounded-full bg-[#edf2ee] px-2.5 py-1 text-xs font-medium text-[#34533f]">Recommended</span></div><p className="text-sm leading-6 text-gray-500">Sign in with your fingerprint, face, or screen lock. A simpler, more secure alternative to passwords.</p></div>
+          <div className="p-6">
+            <div className="mb-4 flex items-center justify-between"><h3 className="text-sm font-semibold">Your passkeys <span className="ml-1 text-gray-400">({account.passkeys.length})</span></h3><span className="text-xs text-gray-400">{account.user?.username}</span></div>
+            {account.passkeys.length === 0 ? <div className="mb-5 rounded-lg border border-dashed border-gray-300 bg-gray-50 px-5 py-7 text-center"><KeyIcon className="mx-auto mb-3 h-7 w-7 text-gray-400" /><p className="text-sm font-semibold">Your next sign-in, made simpler.</p><p className="mt-2 text-xs leading-5 text-gray-500">Add your first passkey to get started.<br />No password to remember. No code to type.</p></div> : <div className="mb-5 divide-y divide-gray-100">{account.passkeys.map(key => <div key={key.id} className="flex flex-wrap items-center gap-3 py-4"><DevicePhoneMobileIcon className="h-6 w-6 text-gray-400" /><div className="min-w-0 flex-1"><p className="break-words text-sm font-semibold">{key.name}</p><p className="mt-1 text-xs leading-5 text-gray-500">Added {date(key.created_at)}<br />{key.last_used ? `Last used ${date(key.last_used)}` : 'Not used to sign in yet'}</p></div><div className="flex gap-3 text-xs"><button disabled={busy} className="underline underline-offset-4" onClick={() => setRename({ ...key })}>Rename</button><button disabled={busy} className="text-red-700 underline underline-offset-4" onClick={() => setRemove(key)}>Remove</button></div></div>)}</div>}
+            <button disabled={busy} className="auth-primary" onClick={() => void run(async () => { await ensureRecent(); await registerPasskey(); }, 'Passkey added. You’re ready for a simpler sign-in.')}><PlusIcon className="h-4 w-4" />{busy ? 'Please wait…' : 'Add a passkey'}</button>
+            <p className="mt-3 text-center text-xs text-gray-400">Your device will guide you through the next step.</p>
+          </div>
+        </section>
+        <section className="flex gap-4 rounded-xl border border-gray-200 p-6"><ShieldCheckIcon className="h-6 w-6 shrink-0 text-gray-500" /><div className="flex-1"><h2 className="font-semibold">Verify your identity</h2><p className="mt-2 text-sm leading-6 text-gray-500">We ask for a quick verification before sensitive account changes. Verification lasts for 5 minutes.</p><button disabled={busy} className="mt-4 flex items-center gap-2 text-sm font-semibold text-[#34533f]" onClick={() => setVerify(true)}>Verify now <ArrowRightIcon className="h-4 w-4" /></button></div></section>
+      </div>
+      <aside><div className="rounded-xl bg-[#f4f5f0] p-6"><div className="mb-5 flex h-10 w-10 items-center justify-center rounded-full bg-white"><ShieldCheckIcon className="h-6 w-6 text-[#34533f]" /></div><h2 className="font-serif text-2xl">More peace of mind.<br />Less to remember.</h2><div className="mt-6 space-y-5">{[['Built to protect you', 'Passkeys help protect against phishing and stolen passwords.'], ['Private by design', 'Your fingerprint and face data stay on your device. We never see them.'], ['Ready wherever you are', 'Your passkeys can sync across devices through your password manager.']].map(([title, text]) => <div key={title}><h3 className="mb-1 flex items-center gap-2 text-sm font-semibold"><CheckIcon className="h-4 w-4 text-[#34533f]" />{title}</h3><p className="ml-6 text-xs leading-5 text-gray-500">{text}</p></div>)}</div></div><p className="mt-5 px-2 text-xs leading-5 text-gray-400">Use a device you trust. On a shared computer, choose a passkey from your phone or security key.</p></aside>
+    </div>}
+    {(rename || remove || verify) && <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4"><section id="security-dialog" role="dialog" onKeyDown={e => {
+        if (e.key === 'Escape' && !busy) { setRename(null); setRemove(null); setVerify(false); setPassword(''); }
+        if (e.key === 'Tab') {
+          const items = Array.from(e.currentTarget.querySelectorAll<HTMLElement>('button:not(:disabled), input:not(:disabled)'));
+          const first = items[0], last = items[items.length - 1];
+          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
+          if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
+        }
+      }} aria-modal="true" aria-labelledby="dialog-title" className="w-full max-w-md rounded-xl bg-white p-7 shadow-xl"><h2 id="dialog-title" className="mb-3 font-serif text-2xl">{rename ? 'Rename your passkey' : remove ? 'Remove this passkey?' : 'Verify your identity'}</h2>
+      {rename && <form onSubmit={e => { e.preventDefault(); void run(async () => { await ensureRecent(); await api('rename', { id: rename.id, name: rename.name }); setRename(null); }, 'Passkey renamed.'); }}><label htmlFor="passkey-name" className="mb-2 block text-sm text-gray-500">Choose a name you’ll recognize.</label><input id="passkey-name" autoFocus required maxLength={60} className="auth-input mb-5" value={rename.name} onChange={e => setRename({ ...rename, name: e.target.value })} /><button disabled={busy} className="auth-primary">Save name</button></form>}
+      {remove && <><p className="mb-5 text-sm leading-6 text-gray-500">You’ll no longer be able to sign in with “{remove.name}”. This does not delete the passkey from your device’s password manager.</p><button disabled={busy} className="auth-primary" onClick={() => void run(async () => { await ensureRecent(); await api('delete', { id: remove.id }); setRemove(null); }, 'Passkey removed.')}>Remove passkey</button></>}
+      {verify && <><p className="mb-5 text-sm leading-6 text-gray-500">Confirm it’s you to continue with sensitive account changes.</p>{!!account?.passkeys.length && <button disabled={busy} className="auth-primary mb-5" onClick={() => void run(async () => { await authenticatePasskey(true); setVerify(false); }, 'Identity verified. You can now make changes.')}><FingerPrintIcon className="h-5 w-5" />Verify with a passkey</button>}{account?.user?.hasPassword && <form onSubmit={e => { e.preventDefault(); void run(async () => { await api('reauth-password', { password }); setPassword(''); setVerify(false); }, 'Identity verified. You can now make changes.'); }}><label htmlFor="verify-password" className="mb-2 block text-sm">Confirm your password</label><input id="verify-password" required type="password" autoComplete="current-password" className="auth-input mb-3" value={password} onChange={e => setPassword(e.target.value)} /><button disabled={busy} className="auth-secondary">Verify with password</button></form>}</>}
+      {error && <p role="alert" className="mt-4 text-sm text-red-700">{error}</p>}<button disabled={busy} className="mt-5 w-full text-sm text-gray-500" onClick={() => { setRename(null); setRemove(null); setVerify(false); setPassword(''); setError(''); }}>Cancel</button>
+    </section></div>}
+  </div>;
+}
