index 0000000..5d6eab6
--- /dev/null
+++ b/src/components/PasskeySettings.tsx
@@ -0,0 +1,90 @@
+import { useEffect, useRef, useState } from 'react';
+import { KeyIcon } from '@heroicons/react/24/outline';
+import providers from '../lib/passkey-providers.json';
+import { api, authenticate, base, capabilities, message, registerPasskey, syncPasskeys, type Account } from '../lib/passkeys';
+
+const button = 'px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed';
+export default function PasskeySettings() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [supported, setSupported] = useState(false);
+  const [canCreate, setCanCreate] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [password, setPassword] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [editing, setEditing] = useState('');
+  const [name, setName] = useState('');
+  const [deleting, setDeleting] = useState('');
+  const controller = useRef<AbortController | null>(null);
+  async function load() {
+    const next = await api<Account>('session', undefined, 'GET');
+    setAccount(next); setDisplayName(next.user.displayName);
+    await syncPasskeys(next);
+    return next;
+  }
+  useEffect(() => {
+    void load().catch(err => setError(message(err)));
+    void capabilities().then(caps => { setSupported(Boolean(caps)); setCanCreate(Boolean(caps?.passkeyPlatformAuthenticator || caps?.userVerifyingPlatformAuthenticator || caps?.hybridTransport)); });
+    return () => controller.current?.abort();
+  }, []);
+  async function run(action: (signal: AbortSignal) => Promise<void>, success: string) {
+    controller.current?.abort();
+    const abort = new AbortController(); controller.current = abort;
+    setBusy(true); setError(''); setNotice('');
+    try { await action(abort.signal); await load(); setNotice(success); }
+    catch (err) { if (!abort.signal.aborted) setError(message(err)); }
+    finally { if (!abort.signal.aborted) setBusy(false); }
+  }
+  const date = (time: number) => new Date(time).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });
+  return <div className="max-w-2xl mx-auto p-6 space-y-8">
+    <div><h1 className="text-3xl font-bold">Account security</h1><p className="mt-2 text-gray-600">Manage your passkeys and keep your account secure.</p></div>
+    {error && <p role="alert" className="p-3 bg-red-50 text-red-800 rounded-md">{error}</p>}
+    {notice && <p role="status" className="p-3 bg-green-50 text-green-800 rounded-md">{notice}</p>}
+    {!account ? <p role="status">{error ? <a href={`${base}signin`} className="underline">Return to sign in</a> : 'Loading your account…'}</p> : <>
+      <section className="border border-gray-200 rounded-lg p-5 space-y-4" aria-labelledby="identity-heading">
+        <h2 id="identity-heading" className="text-xl font-bold">Verify your identity</h2>
+        <p className="text-sm text-gray-600">Before adding or changing passkeys, verify with an existing passkey or your password. Verification lasts 5 minutes.</p>
+        <p className="text-sm">Signed in as <strong>{account.user.username}</strong></p>
+        {supported && account.passkeys.length > 0 && <button className={button} disabled={busy} onClick={() => void run(signal => authenticate('reauth', signal), 'Identity verified. You can now make changes.')}>Verify with passkey</button>}
+        <form className="flex flex-wrap gap-2" onSubmit={event => { event.preventDefault(); void run(async () => { await api('reauth/password', { password }); setPassword(''); }, 'Identity verified. You can now make changes.'); }}>
+          <label htmlFor="verify-password" className="w-full text-sm font-medium">Verify with password</label>
+          <input id="verify-password" type="password" autoComplete="current-password" required value={password} onChange={event => setPassword(event.target.value)} className="min-w-0 flex-1 border border-gray-300 rounded-md px-3 py-2" />
+          <button disabled={busy} className={button}>Verify</button>
+        </form>
+      </section>
+      <section aria-labelledby="passkeys-heading" className="space-y-4">
+        <h2 id="passkeys-heading" className="text-xl font-bold">Your passkeys</h2>
+        <p className="text-sm text-gray-600">Sign in using your fingerprint, face, device PIN, or a security key. Your biometric information stays on your device.</p>
+        {canCreate ? <button disabled={busy} className={`${button} bg-gray-900 text-white hover:bg-gray-700`} onClick={() => void run(registerPasskey, 'Passkey created. You can use it the next time you sign in.')}>Create passkey</button> : <p className="text-sm text-gray-600">Passkey creation is unavailable in this browser. Use a supported browser on HTTPS or localhost. Your password remains available.</p>}
+        {supported && !canCreate && <button disabled={busy} className={button} onClick={() => void run(registerPasskey, 'Security key registered.')}>Register a security key</button>}
+        {account.passkeys.length === 0 ? <p className="p-5 bg-gray-50 rounded-lg">No passkeys yet. Create one for faster sign-ins.</p> : <ul className="space-y-3">
+          {account.passkeys.map(key => {
+            const provider = (providers as Record<string, { name: string }>)[key.aaguid]?.name || 'Unknown passkey provider';
+            return <li key={key.id} className="border border-gray-200 rounded-lg p-4 space-y-3">
+              <div className="flex gap-3"><KeyIcon className="w-6 h-6 shrink-0 text-gray-600" aria-hidden="true" /><div className="min-w-0"><h3 className="font-semibold break-words">{key.name}</h3><p className="text-sm text-gray-600">{provider} · {key.deviceType === 'multiDevice' ? 'Synced passkey' : 'Device-bound passkey'}</p></div></div>
+              <p className="text-sm text-gray-600">Created {date(key.registeredAt)}<br />Last used: {key.lastUsedAt ? date(key.lastUsedAt) : 'Not used yet'}</p>
+              {editing === key.id ? <form className="flex flex-wrap gap-2" onSubmit={event => { event.preventDefault(); void run(async () => { await api('passkeys', { id: key.id, name }, 'PUT'); setEditing(''); }, 'Passkey renamed.'); }}>
+                <label htmlFor="passkey-name" className="w-full text-sm">Passkey name</label><input id="passkey-name" autoFocus required maxLength={80} value={name} onChange={event => setName(event.target.value)} className="min-w-0 flex-1 border rounded-md px-3 py-2" /><button disabled={busy} className={button}>Save</button><button type="button" disabled={busy} className={button} onClick={() => setEditing('')}>Cancel</button>
+              </form> : <div className="flex gap-2"><button className={button} disabled={busy} aria-label={`Rename ${key.name}`} onClick={() => { setEditing(key.id); setName(key.name); }}>Rename</button><button className={`${button} text-red-700`} disabled={busy} aria-label={`Delete ${key.name}`} onClick={() => setDeleting(key.id)}>Delete</button></div>}
+              {deleting === key.id && <div className="p-3 bg-red-50 rounded-md space-y-3"><p className="text-sm">Delete this passkey? It will no longer sign you in.{account.passkeys.length === 1 ? ' This is your last passkey. You can still sign in with your password.' : ''}</p><div className="flex gap-2"><button disabled={busy} className={`${button} text-red-700`} onClick={() => void run(async () => { await api('passkeys', { id: key.id }, 'DELETE'); setDeleting(''); }, 'Passkey deleted. Remove it from your password manager if it still appears.')}>Confirm deletion</button><button disabled={busy} className={button} onClick={() => setDeleting('')}>Cancel</button></div></div>}
+            </li>;
+          })}
+        </ul>}
+      </section>
+      <section className="border-t border-gray-200 pt-6 space-y-4" aria-labelledby="profile-heading">
+        <h2 id="profile-heading" className="text-xl font-bold">Profile</h2>
+        <form className="flex flex-wrap gap-2" onSubmit={event => { event.preventDefault(); void run(async () => {
+          const result = await api<{ user: Account['user'] }>('profile', { displayName }, 'PUT');
+          if (window.PublicKeyCredential && 'signalCurrentUserDetails' in PublicKeyCredential) {
+            try { await PublicKeyCredential.signalCurrentUserDetails({ rpId: account.rpId, userId: account.user.id, name: result.user.username, displayName: result.user.displayName }); } catch { /* Optional manager synchronization. */ }
+          }
+        }, 'Display name updated.'); }}>
+          <label htmlFor="display-name" className="w-full text-sm font-medium">Display name</label><input id="display-name" autoComplete="nickname" required maxLength={100} value={displayName} onChange={event => setDisplayName(event.target.value)} className="min-w-0 flex-1 border border-gray-300 rounded-md px-3 py-2" /><button disabled={busy} className={button}>Save name</button>
+        </form>
+      </section>
+      <button className={button} disabled={busy} onClick={() => void run(async () => { await api('logout'); window.location.assign(`${base}signin`); }, '')}>Sign out</button>
+    </>}
+    {busy && <p role="status" className="text-sm text-gray-600">Working… Follow any instructions from your browser.</p>}
+  </div>;
+}
