diff --git a/src/pages/api/auth/[...action].ts b/src/pages/api/auth/[...action].ts
new file mode 100644
index 0000000..4d7b09d
--- /dev/null
+++ b/src/pages/api/auth/[...action].ts
@@ -0,0 +1,158 @@
+import type { APIRoute, APIContext } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import type { AuthenticationResponseJSON, RegistrationResponseJSON } from '@simplewebauthn/server';
+import * as store from '../../../lib/server/auth-store';
+
+const COOKIE = 'times_auth';
+const REMOTE = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+class HttpError extends Error { constructor(public status: number, message: string) { super(message); } }
+const fail = (status: number, message: string): never => { throw new HttpError(status, message); };
+function configuration(url: URL) {
+  const origin = process.env.WEBAUTHN_ORIGIN || (import.meta.env.DEV || ['localhost', '127.0.0.1'].includes(url.hostname) ? url.origin : '');
+  if (!origin) fail(503, 'Passkey authentication is not configured.');
+  const rpId = process.env.WEBAUTHN_RP_ID || new URL(origin).hostname;
+  return { origin, rpId };
+}
+function sessionFor(context: Pick<APIContext, 'cookies'>) {
+  const raw = context.cookies.get(COOKIE)?.value;
+  return raw ? store.getSession(raw) : undefined;
+}
+function newSession(context: APIContext, userId?: string, verifiedAt = 0) {
+  const raw = store.token();
+  const session = { id: store.hash(raw), userId, verifiedAt, expiresAt: Date.now() + (userId ? 7 * 86400_000 : 600_000) };
+  store.saveSession(session);
+  context.cookies.set(COOKIE, raw, { httpOnly: true, sameSite: 'lax', secure: context.url.protocol === 'https:', path: import.meta.env.BASE_URL, maxAge: userId ? 604800 : 600 });
+  return session;
+}
+export function currentUser(context: Pick<APIContext, 'cookies'>) {
+  const session = sessionFor(context);
+  return session?.userId ? store.userById(session.userId) : undefined;
+}
+async function remotePassword(action: string, username: string, password: string) {
+  let response: Response;
+  try {
+    response = await fetch(`${REMOTE}/${action}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000) });
+  } catch { return fail(502, 'The password service is unavailable. Please try again.'); }
+  if (!response.ok) fail(action === 'register' ? 400 : 401, action === 'register' ? 'Registration failed. Check your details or choose another username.' : 'The username or password is incorrect.');
+}
+function text(value: unknown, max = 100) {
+  if (typeof value !== 'string' || !value.trim() || value.trim().length > max) fail(400, 'Please provide a valid value.');
+  return (value as string).trim();
+}
+export const ALL: APIRoute = async context => {
+  const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+  try {
+    const action = context.params.action;
+    const { origin, rpId } = configuration(context.url);
+    if (!['GET', 'POST', 'PUT', 'DELETE'].includes(context.request.method)) fail(405, 'Method not allowed.');
+    if (context.request.method !== 'GET') {
+      if (context.request.headers.get('origin') !== origin) fail(403, 'Request origin does not match this site.');
+      if (!context.request.headers.get('content-type')?.startsWith('application/json')) fail(415, 'JSON is required.');
+    }
+    const ip = context.clientAddress;
+    if (!store.rateLimit(`${ip}:${action}`, ['login', 'register', 'reauth/password'].includes(action!) ? 10 : 60)) fail(429, 'Too many attempts. Please wait a minute.');
+    let session = sessionFor(context);
+    const user = session?.userId ? store.userById(session.userId) : undefined;
+    const requireUser = () => user || fail(401, 'Please sign in to continue.');
+    const requireRecent = () => { requireUser(); if (!session || Date.now() - session.verifiedAt > 300_000) fail(403, 'Verify your identity before making this change.'); };
+    const rawBody = context.request.method === 'GET' ? '{}' : await context.request.text();
+    if (rawBody.length > 65536) fail(413, 'Request is too large.');
+    const body = JSON.parse(rawBody);
+    if (!body || typeof body !== 'object' || Array.isArray(body)) fail(400, 'Invalid request.');
+    if (action === 'session' && context.request.method === 'GET') {
+      requireUser();
+      return json({ user, rpId, passkeys: store.passkeysFor(user!.id).map(({ publicKey, counter, ...key }) => key), recentlyVerified: Date.now() - session!.verifiedAt < 300_000 });
+    }
+    if (action === 'register' && context.request.method === 'POST') {
+      const username = text(body.username);
+      if (typeof body.password !== 'string' || body.password.length < 8 || body.password.length > 1024 || !/\d/.test(body.password)) fail(400, 'Use a password with at least 8 characters and a number.');
+      await remotePassword('register', username, body.password);
+      return json({ success: true });
+    }
+    if (action === 'login' && context.request.method === 'POST') {
+      const username = text(body.username);
+      if (typeof body.password !== 'string' || !body.password || body.password.length > 1024) fail(400, 'Enter your password.');
+      await remotePassword('login', username, body.password);
+      const account = store.ensureUser(username);
+      if (session) store.removeSession(session.id);
+      newSession(context, account.id, Date.now());
+      return json({ success: true });
+    }
+    if (action === 'logout' && context.request.method === 'POST') {
+      if (session) store.removeSession(session.id);
+      context.cookies.delete(COOKIE, { path: import.meta.env.BASE_URL });
+      return json({ success: true });
+    }
+    if (action === 'reauth/password' && context.request.method === 'POST') {
+      requireUser();
+      if (typeof body.password !== 'string' || !body.password || body.password.length > 1024) fail(400, 'Enter your password.');
+      await remotePassword('login', user!.username, body.password);
+      session!.verifiedAt = Date.now(); store.saveSession(session!);
+      return json({ success: true });
+    }
+    if (['registration/options', 'authentication/options', 'reauth/options'].includes(action!) && context.request.method === 'POST') {
+      const purpose = action!.split('/')[0];
+      if (purpose === 'registration') requireRecent();
+      if (purpose === 'reauth') requireUser();
+      session ||= newSession(context);
+      const keys = user ? store.passkeysFor(user.id) : [];
+      if (purpose === 'reauth' && !keys.length) fail(400, 'No passkeys are registered. Verify with your password.');
+      const userVerification = purpose === 'reauth' ? 'required' : 'preferred';
+      const options = purpose === 'registration'
+        ? await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID: rpId, userID: Buffer.from(user!.id, 'base64url'), userName: user!.username, userDisplayName: user!.displayName, attestationType: 'none', excludeCredentials: keys.map(key => ({ id: key.id, transports: key.transports })), authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification } })
+        : await generateAuthenticationOptions({ rpID: rpId, userVerification, allowCredentials: purpose === 'reauth' ? keys.map(key => ({ id: key.id, transports: key.transports })) : [] });
+      store.saveChallenge({ challenge: options.challenge, sessionId: session.id, userId: user?.id, purpose, userVerification, expiresAt: Date.now() + 300_000 });
+      return json(options);
+    }
+    if (['registration/verify', 'authentication/verify', 'reauth/verify'].includes(action!) && context.request.method === 'POST') {
+      const purpose = action!.split('/')[0];
+      if (!session) fail(400, 'The request expired. Please try again.');
+      let clientData;
+      try { clientData = JSON.parse(Buffer.from(body.response.clientDataJSON, 'base64url').toString()); } catch { return fail(400, 'Invalid passkey response.'); }
+      const challenge = store.consumeChallenge(clientData.challenge, session!.id, purpose);
+      if (!challenge || challenge.userId !== user?.id) fail(400, 'The request expired or was already used. Please try again.');
+      if (purpose === 'registration') {
+        requireRecent();
+        const result = await verifyRegistrationResponse({ response: body as RegistrationResponseJSON, expectedChallenge: challenge!.challenge, expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: challenge!.userVerification === 'required' });
+        if (!result.verified || !result.registrationInfo) fail(400, 'Unable to verify this passkey.');
+        const info = result.registrationInfo!;
+        if (store.passkeyById(info.credential.id)) fail(409, 'This passkey is already registered.');
+        store.insertPasskey({ id: info.credential.id, userId: user!.id, publicKey: Buffer.from(info.credential.publicKey).toString('base64url'), counter: info.credential.counter, transports: store.validTransports(info.credential.transports), aaguid: info.aaguid, deviceType: info.credentialDeviceType, backedUp: info.credentialBackedUp, name: 'My passkey', registeredAt: Date.now() });
+      } else {
+        const key = typeof body.id === 'string' ? store.passkeyById(body.id) : undefined;
+        if (!key) fail(404, 'This passkey is no longer registered. Try another passkey or your password.');
+        if (purpose === 'reauth' && key!.userId !== requireUser().id) fail(403, 'Use a passkey belonging to your signed-in account.');
+        if (body.response.userHandle && body.response.userHandle !== key!.userId) fail(403, 'The passkey account does not match.');
+        const result = await verifyAuthenticationResponse({ response: body as AuthenticationResponseJSON, expectedChallenge: challenge!.challenge, expectedOrigin: origin, expectedRPID: rpId, requireUserVerification: challenge!.userVerification === 'required', credential: { id: key!.id, publicKey: new Uint8Array(Buffer.from(key!.publicKey, 'base64url')), counter: key!.counter, transports: key!.transports } });
+        if (!result.verified) fail(400, 'Unable to verify this passkey.');
+        // Optimistic update rejects concurrent assertions using the same stored counter.
+        const updated = { ...key!, counter: result.authenticationInfo.newCounter, backedUp: result.authenticationInfo.credentialBackedUp, lastUsedAt: Date.now() };
+        const changed = store.db.prepare('UPDATE passkeys SET data=? WHERE id=? AND data=?').run(JSON.stringify(updated), key!.id, JSON.stringify(key));
+        if (!changed.changes) fail(409, 'This passkey changed. Please try again.');
+        if (purpose === 'reauth') { session!.verifiedAt = Date.now(); store.saveSession(session!); }
+        else { store.removeSession(session!.id); newSession(context, key!.userId, result.authenticationInfo.userVerified ? Date.now() : 0); }
+      }
+      return json({ success: true });
+    }
+    if (action === 'profile' && context.request.method === 'PUT') {
+      requireRecent();
+      const updated = { ...user!, displayName: text(body.displayName) };
+      store.saveUser(updated);
+      return json({ user: updated });
+    }
+    if (action === 'passkeys' && ['PUT', 'DELETE'].includes(context.request.method)) {
+      requireRecent();
+      const key = store.passkeyById(text(body.id, 2048));
+      if (!key || key.userId !== user!.id) fail(404, 'Passkey not found.');
+      if (context.request.method === 'DELETE') store.deletePasskey(key!.id, user!.id);
+      else store.savePasskey({ ...key!, name: text(body.name, 80) });
+      return json({ success: true });
+    }
+    return json({ error: 'Not found.' }, 404);
+  } catch (error) {
+    if (error instanceof HttpError) return json({ error: error.message }, error.status);
+    if (error instanceof SyntaxError) return json({ error: 'Invalid request.' }, 400);
+    console.error('Authentication request failed:', error instanceof Error ? error.message : 'Unknown error');
+    return json({ error: 'The request could not be verified. Please try again.' }, 400);
+  }
+};
diff --git a/tests/passkeys.test.ts b/tests/passkeys.test.ts
new file mode 100644
index 0000000..6bf731e
--- /dev/null
+++ b/tests/passkeys.test.ts
@@ -0,0 +1,138 @@
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn, type ChildProcess } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createHash, generateKeyPairSync, randomBytes, sign } from 'node:crypto';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+
+const directory = mkdtempSync(join(tmpdir(), 'times-auth-'));
+process.env.AUTH_DB_PATH = join(directory, 'auth.sqlite');
+const store = await import('../src/lib/server/auth-store');
+const origin = 'http://localhost:14327';
+const base = `${origin}/devtools-times/`;
+let server: ChildProcess;
+let output = '';
+const alice = store.ensureUser('alice');
+const bob = store.ensureUser('bob');
+function session(userId?: string, verifiedAt = Date.now()) {
+  const raw = store.token(); store.saveSession({ id: store.hash(raw), userId, verifiedAt, expiresAt: Date.now() + 600_000 }); return raw;
+}
+let cookie = session(alice.id);
+async function request(action: string, body?: unknown, method = 'POST', raw = cookie, requestOrigin = origin) {
+  const response = await fetch(`${base}api/auth/${action}`, { method, headers: { Origin: requestOrigin, 'Content-Type': 'application/json', Cookie: `times_auth=${raw}` }, ...(method === 'GET' ? {} : { body: JSON.stringify(body || {}) }), redirect: 'manual' });
+  return { response, data: await response.json() };
+}
+const encode = (value: Uint8Array) => Buffer.from(value).toString('base64url');
+const digest = (value: string | Uint8Array) => createHash('sha256').update(value).digest();
+const pair = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+const jwk = pair.publicKey.export({ format: 'jwk' });
+const id = randomBytes(32);
+const cose = isoCBOR.encode(new Map<number, number | Uint8Array>([[1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x!, 'base64url')], [-3, Buffer.from(jwk.y!, 'base64url')]]));
+function registration(challenge: string, responseOrigin = origin) {
+  const clientData = Buffer.from(JSON.stringify({ type: 'webauthn.create', challenge, origin: responseOrigin }));
+  const authData = Buffer.concat([digest('localhost'), Buffer.from([0x45]), Buffer.alloc(4), Buffer.alloc(16), Buffer.from([0, id.length]), id, cose]);
+  const attestation = isoCBOR.encode(new Map<string, any>([['fmt', 'none'], ['attStmt', new Map()], ['authData', authData]]));
+  return { id: encode(id), rawId: encode(id), type: 'public-key', response: { clientDataJSON: encode(clientData), attestationObject: encode(attestation), transports: ['internal'] }, clientExtensionResults: {} };
+}
+function assertion(challenge: string, count: number, userId = alice.id, uv = true, signer = pair.privateKey) {
+  const clientData = Buffer.from(JSON.stringify({ type: 'webauthn.get', challenge, origin }));
+  const counter = Buffer.alloc(4); counter.writeUInt32BE(count);
+  const authData = Buffer.concat([digest('localhost'), Buffer.from([uv ? 5 : 1]), counter]);
+  const signature = sign('sha256', Buffer.concat([authData, digest(clientData)]), signer);
+  return { id: encode(id), rawId: encode(id), type: 'public-key', response: { clientDataJSON: encode(clientData), authenticatorData: encode(authData), signature: encode(signature), userHandle: userId }, clientExtensionResults: {} };
+}
+before(async () => {
+  server = spawn(process.execPath, ['dist/server/entry.mjs'], { env: { ...process.env, HOST: '127.0.0.1', PORT: '14327', WEBAUTHN_ORIGIN: origin, WEBAUTHN_RP_ID: 'localhost' }, stdio: ['ignore', 'pipe', 'pipe'] });
+  server.stdout?.on('data', chunk => { output += chunk; }); server.stderr?.on('data', chunk => { output += chunk; });
+  for (let i = 0; i < 100; i++) {
+    try { if ((await fetch(`${base}api/auth/session`)).status === 401) return; } catch { /* Wait for server startup. */ }
+    await new Promise(resolve => setTimeout(resolve, 100));
+  }
+  throw new Error(`Server failed to start: ${output}`);
+});
+after(async () => { server?.kill(); await new Promise(resolve => server?.once('exit', resolve)); store.db.close(); rmSync(directory, { recursive: true, force: true }); });
+
+test('sign-in renders and account settings require a session', async () => {
+  assert.equal((await fetch(`${base}signin`)).status, 200);
+  const response = await fetch(`${base}account/security`, { redirect: 'manual' });
+  assert.equal(response.status, 302);
+  assert.match(response.headers.get('location')!, /signin/);
+});
+test('rejects foreign origins and unauthenticated enrollment', async () => {
+  assert.equal((await request('registration/options', {}, 'POST', cookie, 'https://attacker.example')).response.status, 403);
+  assert.equal((await request('registration/options', {}, 'POST', '')).response.status, 401);
+});
+test('registration requires recent verification and returns discoverable options', async () => {
+  assert.equal((await request('registration/options', {}, 'POST', session(alice.id, 0))).response.status, 403);
+  const { data } = await request('registration/options');
+  assert.equal(data.authenticatorSelection.residentKey, 'required');
+  assert.equal(data.authenticatorSelection.authenticatorAttachment, undefined);
+  assert.equal(data.user.id, alice.id);
+  const credential = registration(data.challenge);
+  assert.equal((await request('registration/verify', credential)).response.status, 200);
+  assert.equal((await request('registration/verify', credential)).response.status, 400);
+  assert.equal(store.passkeysFor(alice.id).length, 1);
+  const list = await request('session', undefined, 'GET');
+  assert.equal(list.data.passkeys[0].publicKey, undefined);
+  assert.equal((await request('registration/options')).data.excludeCredentials[0].id, encode(id));
+});
+test('rejects wrong WebAuthn origin and cross-session challenges', async () => {
+  const { data } = await request('registration/options');
+  assert.equal((await request('registration/verify', registration(data.challenge, 'https://attacker.example'))).response.status, 400);
+  const next = await request('authentication/options');
+  assert.equal((await request('authentication/verify', assertion(next.data.challenge, 1), 'POST', session())).response.status, 400);
+});
+test('discoverable sign-in verifies a real signature and rotates the session', async () => {
+  const anon = session();
+  const { data } = await request('authentication/options', {}, 'POST', anon);
+  assert.deepEqual(data.allowCredentials, []);
+  const result = await request('authentication/verify', assertion(data.challenge, 1), 'POST', anon);
+  assert.equal(result.response.status, 200);
+  assert.equal(store.getSession(anon), undefined);
+  const header = result.response.headers.get('set-cookie')!;
+  assert.match(header, /HttpOnly/i); assert.match(header, /SameSite=Lax/i);
+  cookie = header.match(/times_auth=([^;]+)/)![1];
+  assert.equal((await request('session', undefined, 'GET')).data.user.id, alice.id);
+  assert.equal(store.passkeyById(encode(id))?.counter, 1);
+});
+test('rejects invalid signatures, stale counters, unknown and expired challenges', async () => {
+  const wrong = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  let options = await request('authentication/options');
+  assert.equal((await request('authentication/verify', assertion(options.data.challenge, 2, alice.id, true, wrong.privateKey))).response.status, 400);
+  options = await request('authentication/options');
+  assert.equal((await request('authentication/verify', assertion(options.data.challenge, 1))).response.status, 400);
+  options = await request('authentication/options');
+  const unknown = { ...assertion(options.data.challenge, 2), id: encode(randomBytes(32)) };
+  assert.equal((await request('authentication/verify', unknown)).response.status, 404);
+  const expired = store.token();
+  store.saveChallenge({ challenge: expired, sessionId: store.hash(cookie), userId: alice.id, purpose: 'authentication', userVerification: 'preferred', expiresAt: 0 });
+  assert.equal((await request('authentication/verify', assertion(expired, 2))).response.status, 400);
+});
+test('reauthentication rejects other accounts and requires user verification', async () => {
+  const bobsCookie = session(bob.id);
+  assert.equal((await request('reauth/options', {}, 'POST', bobsCookie)).response.status, 400);
+  // Even a forged allowance cannot bypass ownership validation at verification.
+  const challenge = store.token();
+  store.saveChallenge({ challenge, sessionId: store.hash(bobsCookie), userId: bob.id, purpose: 'reauth', userVerification: 'required', expiresAt: Date.now() + 300_000 });
+  assert.equal((await request('reauth/verify', assertion(challenge, 2), 'POST', bobsCookie)).response.status, 403);
+  const options = await request('reauth/options');
+  assert.equal(options.data.allowCredentials[0].id, encode(id));
+  assert.equal(options.data.userVerification, 'required');
+  assert.equal((await request('reauth/verify', assertion(options.data.challenge, 2, alice.id, false))).response.status, 400);
+  const next = await request('reauth/options');
+  assert.equal((await request('reauth/verify', assertion(next.data.challenge, 2))).response.status, 200);
+});
+test('management enforces ownership, persists names, updates profile, and deletes', async () => {
+  assert.equal((await request('passkeys', { id: encode(id), name: 'stolen' }, 'PUT', session(bob.id))).response.status, 404);
+  assert.equal((await request('passkeys', { id: encode(id), name: 'My laptop' }, 'PUT')).response.status, 200);
+  assert.equal(store.passkeyById(encode(id))?.name, 'My laptop');
+  assert.equal((await request('profile', { displayName: 'Alice Reader' }, 'PUT')).response.status, 200);
+  assert.equal(store.userById(alice.id)?.displayName, 'Alice Reader');
