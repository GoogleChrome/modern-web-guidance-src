diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..8aad069
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,56 @@
+// Native WebAuthn JSON and capability methods, with compatibility for older browsers.
+import 'webauthn-polyfills';
+
+export const base = import.meta.env.BASE_URL;
+export class ApiError extends Error { constructor(public status: number, message: string) { super(message); } }
+export async function api<T = any>(path: string, body?: unknown, method = 'POST', signal?: AbortSignal): Promise<T> {
+  const response = await fetch(`${base}api/auth/${path}`, { method, credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, ...(method !== 'GET' ? { body: JSON.stringify(body || {}) } : {}), signal });
+  const data = await response.json();
+  if (!response.ok) throw new ApiError(response.status, data.error || 'Please try again.');
+  return data;
+}
+export async function capabilities() {
+  if (!window.isSecureContext || !window.PublicKeyCredential) return null;
+  try { return await PublicKeyCredential.getClientCapabilities(); } catch { return null; }
+}
+export function message(error: unknown) {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was cancelled or timed out. Please try again.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try a different device or security key.';
+    if (error.name === 'SecurityError') return 'Passkeys require HTTPS or localhost and a matching site domain.';
+    if (error.name === 'AbortError') return 'The passkey request was cancelled.';
+  }
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
+export async function authenticate(purpose: 'authentication' | 'reauth', signal: AbortSignal, conditional = false) {
+  const options = await api('' + purpose + '/options', {}, 'POST', signal);
+  const credential = await navigator.credentials.get({ publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(options), signal, ...(conditional ? { mediation: 'conditional' as const } : {}) }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was selected.');
+  const encoded = credential.toJSON();
+  try { await api(`${purpose}/verify`, encoded, 'POST', signal); }
+  catch (error) {
+    if (purpose === 'authentication' && error instanceof ApiError && error.status === 404 && PublicKeyCredential.signalUnknownCredential) {
+      try { await PublicKeyCredential.signalUnknownCredential({ rpId: options.rpId, credentialId: credential.id }); } catch { /* Synchronization is best effort. */ }
+    }
+    throw error;
+  }
+}
+export async function registerPasskey(signal: AbortSignal) {
+  const options = await api('registration/options', {}, 'POST', signal);
+  const credential = await navigator.credentials.create({ publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options), signal }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was created.');
+  // Do not signal on network errors: verification may have succeeded on the server.
+  try { await api('registration/verify', credential.toJSON(), 'POST', signal); }
+  catch (error) {
+    if (error instanceof ApiError && error.status !== 409 && PublicKeyCredential.signalUnknownCredential) {
+      try { await PublicKeyCredential.signalUnknownCredential({ rpId: options.rp.id, credentialId: credential.id }); } catch { /* Best effort. */ }
+    }
+    throw error;
+  }
+}
+export type Account = { user: { id: string; username: string; displayName: string }; rpId: string; recentlyVerified: boolean; passkeys: { id: string; name: string; aaguid: string; deviceType: string; backedUp: boolean; registeredAt: number; lastUsedAt?: number }[] };
+export async function syncPasskeys(account: Account) {
+  if (window.PublicKeyCredential && 'signalAllAcceptedCredentials' in PublicKeyCredential) {
+    try { await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: account.rpId, userId: account.user.id, allAcceptedCredentialIds: account.passkeys.map(key => key.id) }); } catch { /* Unsupported managers must not interrupt account changes. */ }
+  }
+}
diff --git a/src/lib/server/auth-store.ts b/src/lib/server/auth-store.ts
new file mode 100644
index 0000000..3735511
--- /dev/null
+++ b/src/lib/server/auth-store.ts
@@ -0,0 +1,60 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { createHash, randomBytes } from 'node:crypto';
+import type { AuthenticatorTransport } from '@simplewebauthn/server';
+
+export function validTransports(values: string[] = []): AuthenticatorTransport[] {
+  const allowed = new Set(['ble', 'cable', 'hybrid', 'internal', 'nfc', 'smart-card', 'usb']);
+  return values.filter((value): value is AuthenticatorTransport => allowed.has(value));
+}
+export type User = { id: string; username: string; displayName: string };
+export type Passkey = { id: string; userId: string; publicKey: string; counter: number; transports: AuthenticatorTransport[]; aaguid: string; deviceType: string; backedUp: boolean; name: string; registeredAt: number; lastUsedAt?: number };
+export type Session = { id: string; userId?: string; verifiedAt: number; expiresAt: number };
+export type Challenge = { challenge: string; sessionId: string; userId?: string; purpose: string; expiresAt: number; userVerification: 'preferred' | 'required' };
+const path = resolve(process.env.AUTH_DB_PATH || '.data/auth.sqlite');
+mkdirSync(dirname(path), { recursive: true });
+export const db = new DatabaseSync(path);
+db.exec(`PRAGMA journal_mode=WAL; PRAGMA busy_timeout=5000;
+ CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, data TEXT NOT NULL);
+ CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, userId TEXT NOT NULL, data TEXT NOT NULL);
+ CREATE INDEX IF NOT EXISTS passkeys_user ON passkeys(userId);
+ CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, data TEXT NOT NULL, expiresAt INTEGER NOT NULL);
+ CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, data TEXT NOT NULL, expiresAt INTEGER NOT NULL);
+ CREATE TABLE IF NOT EXISTS rate_limits (id TEXT PRIMARY KEY, count INTEGER NOT NULL, expiresAt INTEGER NOT NULL);`);
+export const token = () => randomBytes(32).toString('base64url');
+export const hash = (value: string) => createHash('sha256').update(value).digest('hex');
+function decode<T>(row: unknown): T | undefined { return row ? JSON.parse((row as { data: string }).data) : undefined; }
+export function userById(id: string) { return decode<User>(db.prepare('SELECT data FROM users WHERE id=?').get(id)); }
+export function ensureUser(username: string) {
+  const existing = decode<User>(db.prepare('SELECT data FROM users WHERE username=?').get(username));
+  if (existing) return existing;
+  const user = { id: token(), username, displayName: username };
+  db.prepare('INSERT OR IGNORE INTO users VALUES (?,?,?)').run(user.id, username, JSON.stringify(user));
+  return decode<User>(db.prepare('SELECT data FROM users WHERE username=?').get(username))!;
+}
+export function saveUser(user: User) { db.prepare('UPDATE users SET data=? WHERE id=?').run(JSON.stringify(user), user.id); }
+export function passkeyById(id: string) { return decode<Passkey>(db.prepare('SELECT data FROM passkeys WHERE id=?').get(id)); }
+export function passkeysFor(userId: string) { return db.prepare('SELECT data FROM passkeys WHERE userId=?').all(userId).map(row => decode<Passkey>(row)!); }
+export function insertPasskey(key: Passkey) { db.prepare('INSERT INTO passkeys VALUES (?,?,?)').run(key.id, key.userId, JSON.stringify(key)); }
+export function savePasskey(key: Passkey) { db.prepare('UPDATE passkeys SET data=? WHERE id=? AND userId=?').run(JSON.stringify(key), key.id, key.userId); }
+export function deletePasskey(id: string, userId: string) { db.prepare('DELETE FROM passkeys WHERE id=? AND userId=?').run(id, userId); }
+export function getSession(raw: string) { return decode<Session>(db.prepare('SELECT data FROM sessions WHERE id=? AND expiresAt>?').get(hash(raw), Date.now())); }
+export function saveSession(session: Session) { db.prepare('DELETE FROM sessions WHERE expiresAt<?').run(Date.now()); db.prepare('INSERT OR REPLACE INTO sessions VALUES (?,?,?)').run(session.id, JSON.stringify(session), session.expiresAt); }
+export function removeSession(id: string) { db.prepare('DELETE FROM sessions WHERE id=?').run(id); }
+export function saveChallenge(value: Challenge) {
+  db.prepare('DELETE FROM challenges WHERE expiresAt<?').run(Date.now());
+  db.prepare('INSERT INTO challenges VALUES (?,?,?)').run(value.challenge, JSON.stringify(value), value.expiresAt);
+}
+export function consumeChallenge(challenge: string, sessionId: string, purpose: string) {
+  // DELETE RETURNING atomically consumes a challenge, including across server processes.
+  const value = decode<Challenge>(db.prepare('DELETE FROM challenges WHERE id=? RETURNING data').get(challenge));
+  if (!value || value.sessionId !== sessionId || value.purpose !== purpose || value.expiresAt < Date.now()) return undefined;
+  return value;
+}
+export function rateLimit(id: string, max = 30) {
+  const now = Date.now();
+  db.prepare('DELETE FROM rate_limits WHERE expiresAt<?').run(now);
+  const row = db.prepare(`INSERT INTO rate_limits VALUES (?,1,?) ON CONFLICT(id) DO UPDATE SET count=count+1 RETURNING count`).get(hash(id), now + 60_000) as {count: number};
+  return row.count <= max;
+}
