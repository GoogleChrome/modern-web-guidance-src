+}
+function loginForm() {
+  if (!supported()) return;
+  showModal(`<div class="modal-icon">${icon('cup')}</div><h2>Good to have you back.</h2><p>Your next coffee is calling. Use a saved passkey to sign in securely.</p><p class="form-error" role="alert"></p><button class="button primary wide" id="login-confirm">${icon('key')}Sign in with a passkey</button><button class="text-button switch" id="switch-register">New here? Create an account</button>`);
+  $('#switch-register').onclick = registrationForm;
+  $('#login-confirm').onclick = async event => {
+    if (busy) return; busy = true; event.currentTarget.disabled = true;
+    try { await authenticate(false); modal.close(); toast(`Welcome back, ${user.name.split(' ')[0]}.`); }
+    catch (error) { $('.form-error').textContent = friendlyError(error); }
+    finally { busy = false; if ($('#login-confirm')) $('#login-confirm').disabled = false; }
+  };
+}
+async function authenticate(reauthenticate = true) {
+  const optionsJSON = await api('authenticate/options', { reauthenticate });
+  const credential = await SimpleWebAuthnBrowser.startAuthentication({ optionsJSON });
+  const result = await api('authenticate/verify', { credential }); user = result.user; verifiedAt = Date.now(); render();
+}
+async function ensureFresh() { if (Date.now() - verifiedAt >= 300000) await authenticate(true); }
+function addPasskey() {
+  if (!user) return registrationForm();
+  if (!supported()) return;
+  showModal(`<div class="modal-icon">${icon('key')}</div><h2>A little extra peace of mind.</h2><p>Add a passkey on another device or a security key, so you always have a way back in.</p><form id="add-form"><label>Passkey name<input name="name" required maxlength="60" placeholder="e.g. Personal laptop"></label><p class="form-error" role="alert"></p><button class="button primary" type="submit">Create passkey</button></form>`);
+  $('#add-form').onsubmit = async event => {
+    event.preventDefault(); if (busy) return; busy = true;
+    const form = event.currentTarget; const button = form.querySelector('button'); button.disabled = true;
+    try { await ensureFresh(); const optionsJSON = await api('register/options'); const credential = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON }); const result = await api('register/verify', { credential, name: new FormData(form).get('name') }); user = result.user; verifiedAt = Date.now(); render(); modal.close(); toast('Your new passkey is ready to use.'); }
+    catch (error) { form.querySelector('.form-error').textContent = friendlyError(error); }
+    finally { busy = false; button.disabled = false; }
+  };
+}
+function renameKey(key) {
+  showModal(`<div class="modal-icon">${icon('key')}</div><h2>Make it familiar.</h2><p>Give this passkey a name you’ll recognize.</p><form id="rename-form"><label>Passkey name<input name="name" required maxlength="60" value="${escapeHTML(key.name)}"></label><p class="form-error" role="alert"></p><button class="button primary" type="submit">Save name</button></form>`);
+  $('#rename-form').onsubmit = async event => {
+    event.preventDefault(); if (busy) return; busy = true;
+    const form = event.currentTarget; const button = form.querySelector('button'); button.disabled = true;
+    try { await ensureFresh(); const result = await api(`passkeys/${encodeURIComponent(key.id)}`, { name: new FormData(form).get('name') }, 'PATCH'); user = result.user; render(); modal.close(); toast('Passkey name updated.'); }
+    catch (error) { form.querySelector('.form-error').textContent = friendlyError(error); }
+    finally { busy = false; button.disabled = false; }
+  };
+}
+function removeKey(key) {
+  if (user.passkeys.length === 1) return info('Keep a way back in.', '<p>This is your only passkey. Add another one before removing it, so you can always access your account.</p>', 'shield');
+  showModal(`<div class="modal-icon">${icon('shield')}</div><h2>Remove this passkey?</h2><p>You won’t be able to use <strong>${escapeHTML(key.name)}</strong> to sign in anymore. Your other passkeys will keep working.</p><p class="form-error" role="alert"></p><div class="modal-actions"><button class="button secondary" id="cancel-remove">Keep passkey</button><button class="button primary" id="confirm-remove">Remove passkey</button></div>`);
+  $('#cancel-remove').onclick = () => modal.close();
+  $('#confirm-remove').onclick = async event => {
+    if (busy) return; busy = true; event.currentTarget.disabled = true;
+    try { await ensureFresh(); const result = await api(`passkeys/${encodeURIComponent(key.id)}`, {}, 'DELETE'); user = result.user; render(); modal.close(); toast('Passkey removed from your account.'); }
+    catch (error) { $('.form-error').textContent = friendlyError(error); }
+    finally { busy = false; if ($('#confirm-remove')) $('#confirm-remove').disabled = false; }
+  };
+}
+$('.modal-close').onclick = () => { if (!busy) modal.close(); };
+modal.addEventListener('cancel', e => { if (busy) e.preventDefault(); });
+modal.addEventListener('click', e => { if (e.target === modal && !busy) { const r = modal.getBoundingClientRect(); if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) modal.close(); } });
+$('#hero-add').onclick = addPasskey; $('#add-passkey').onclick = addPasskey;
+$('#header-account').onclick = () => {
