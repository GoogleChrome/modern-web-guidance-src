+  $('#avatar').textContent = user ? user.name.split(/\s+/).map(n => n[0]).slice(0, 2).join('').toUpperCase() : 'DG';
+  $('#header-account').title = user ? `Signed in as ${user.name}` : 'Sign in or create your account';
+  $('#signout span').textContent = user ? 'Sign out' : 'Sign in';
+  $('#session-description').textContent = user ? 'Signed in securely. Right where you left off.' : 'You’re browsing securely on this device.';
+  $('#hero-add').innerHTML = `${icon('key')}${keys.length ? 'Add another passkey' : 'Set up a passkey'}<svg class="arrow"><use href="#arrow"/></svg>`;
+  if (!keys.length) {
+    $('#passkey-list').innerHTML = `<div class="empty-state"><span class="empty-icon">${icon('key')}</span><h3>A fresh start, without a password.</h3><p>Add your first passkey to make your next sign-in a little easier.</p><button class="text-button" id="empty-add">Create your first passkey <span>↗</span></button></div>`;
+    $('#empty-add').onclick = addPasskey;
+  } else {
+    $('#passkey-list').innerHTML = keys.map(k => `<div class="key-row"><span class="icon-box">${icon(k.deviceType === 'multiDevice' ? 'monitor' : 'key')}</span><div class="key-info"><h3>${escapeHTML(k.name)}</h3><p>${k.backedUp ? 'Synced passkey' : 'Device passkey'} · Added ${new Date(k.createdAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}<br>${k.lastUsed ? `Last used ${new Date(k.lastUsed).toLocaleDateString()}` : 'Ready for your next sign-in'}</p></div><div class="key-actions"><button data-rename="${escapeHTML(k.id)}" aria-label="Rename ${escapeHTML(k.name)}">Rename</button><button data-remove="${escapeHTML(k.id)}" aria-label="Remove ${escapeHTML(k.name)}">Remove</button></div></div>`).join('');
+    document.querySelectorAll('[data-rename]').forEach(b => b.onclick = () => renameKey(keys.find(k => k.id === b.dataset.rename)));
+    document.querySelectorAll('[data-remove]').forEach(b => b.onclick = () => removeKey(keys.find(k => k.id === b.dataset.remove)));
+  }
+}
+function registrationForm() {
+  if (!supported()) return;
+  showModal(`<div class="modal-icon">${icon('key')}</div><h2>Your daily ritual, secured.</h2><p>Create your account with a passkey. Next time, all you need is your fingerprint, face, or device PIN.</p><form id="register-form"><label>Your name<input name="name" autocomplete="name" required maxlength="80" placeholder="e.g. Alex Morgan"></label><label>Email address<input name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@example.com"></label><label>Passkey name<input name="keyName" required maxlength="60" value="My first passkey"></label><p class="form-error" role="alert"></p><button class="button primary" type="submit">${icon('key')}Create account with a passkey</button></form><button class="text-button switch" id="switch-login">Already part of the grind? Sign in</button>`);
+  $('#switch-login').onclick = loginForm;
+  $('#register-form').onsubmit = async event => {
+    event.preventDefault(); if (busy) return; busy = true;
+    const form = event.currentTarget, button = form.querySelector('button'); button.disabled = true; button.textContent = 'Waiting for your device…'; form.querySelector('.form-error').textContent = '';
+    try {
+      const fields = new FormData(form);
+      const optionsJSON = await api('register/options', { name: fields.get('name'), email: fields.get('email') });
+      const credential = await SimpleWebAuthnBrowser.startRegistration({ optionsJSON });
