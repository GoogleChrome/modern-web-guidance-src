+import express from 'express';
+import { randomBytes, randomUUID } from 'node:crypto';
+import { existsSync, mkdirSync, readFileSync, writeFileSync, renameSync } from 'node:fs';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+
+const root = path.dirname(fileURLToPath(import.meta.url));
+const dataDir = process.env.DATA_DIR || path.join(root, '.data');
+mkdirSync(dataDir, { recursive: true });
+const dbFile = path.join(dataDir, 'accounts.json');
+let users = existsSync(dbFile) ? JSON.parse(readFileSync(dbFile, 'utf8')) : [];
+const save = () => { writeFileSync(dbFile + '.tmp', JSON.stringify(users), { mode: 0o600 }); renameSync(dbFile + '.tmp', dbFile); };
+const sessions = new Map();
+const app = express();
+app.disable('x-powered-by');
+app.set('trust proxy', 'loopback');
+app.use(express.json({ limit: '32kb' }));
+app.use('/api', (req, res, next) => {
+  res.set('Cache-Control', 'no-store');
+  const origin = process.env.APP_ORIGIN || `${req.protocol}://${req.get('host')}`;
+  req.expectedOrigin = origin;
+  req.rpID = new URL(origin).hostname;
+  if (req.method !== 'GET' && req.get('origin') && req.get('origin') !== origin) return res.status(403).json({ error: 'Request origin is not allowed.' });
+  const cookie = req.headers.cookie?.split('; ').find(c => c.startsWith('grind_session='))?.slice(14);
+  let session = sessions.get(cookie);
+  if (!session || session.expires < Date.now()) {
+    const id = randomBytes(32).toString('hex');
+    session = { id, expires: Date.now() + 86400000, attempts: [] };
+    sessions.set(id, session);
+    res.cookie('grind_session', id, { httpOnly: true, sameSite: 'strict', secure: origin.startsWith('https:'), maxAge: 86400000 });
+  }
+  req.session = session;
+  req.user = users.find(u => u.id === session.userId);
+  if (req.method !== 'GET') {
+    session.attempts = session.attempts.filter(t => t > Date.now() - 60000);
+    if (session.attempts.length >= 30) return res.status(429).json({ error: 'Too many requests. Try again in a minute.' });
+    session.attempts.push(Date.now());
+  }
+  next();
+});
+const safeUser = u => u ? { id: u.id, name: u.name, email: u.email, passkeys: u.passkeys.map(({ publicKey, counter, ...key }) => key) } : null;
+const requireUser = (req, res, next) => req.user ? next() : res.status(401).json({ error: 'Please sign in first.' });
+const fresh = (req, res, next) => req.session.verifiedAt > Date.now() - 5 * 60000 ? next() : res.status(403).json({ error: 'Confirm your identity to continue.', reauthenticate: true });
+function challenge(req, type) {
+  const pending = req.session.pending;
+  delete req.session.pending;
+  if (!pending || pending.type !== type || pending.expires < Date.now()) throw new Error('This request expired. Please try again.');
+  return pending;
+}
+function signIn(req, res, user) {
+  sessions.delete(req.session.id);
+  const id = randomBytes(32).toString('hex');
+  sessions.set(id, { id, userId: user.id, expires: Date.now() + 86400000, verifiedAt: Date.now(), attempts: [] });
+  res.cookie('grind_session', id, { httpOnly: true, sameSite: 'strict', secure: req.expectedOrigin.startsWith('https:'), maxAge: 86400000 });
+}
+app.get('/api/account', (req, res) => res.json({ user: safeUser(req.user), verifiedAt: req.session.verifiedAt || null }));
+app.post('/api/register/options', async (req, res) => {
+  let user = req.user;
+  if (user && !(req.session.verifiedAt > Date.now() - 300000)) return res.status(403).json({ error: 'Confirm your identity to add a passkey.', reauthenticate: true });
+  if (!user) {
+    const name = String(req.body.name || '').trim().slice(0, 80);
+    const email = String(req.body.email || '').trim().toLowerCase();
+    if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 254) return res.status(400).json({ error: 'Enter your name and a valid email address.' });
+    if (users.some(u => u.email === email)) return res.status(409).json({ error: 'An account with that email already exists. Sign in with your passkey.' });
+    user = { id: randomUUID(), name, email, passkeys: [] };
+  }
+  const options = await generateRegistrationOptions({ rpName: 'The Daily Grind', rpID: req.rpID, userID: new TextEncoder().encode(user.id), userName: user.email, userDisplayName: user.name, attestationType: 'none', excludeCredentials: user.passkeys.map(k => ({ id: k.id, transports: k.transports })), authenticatorSelection: { residentKey: 'required', userVerification: 'required' } });
+  req.session.pending = { type: 'register', challenge: options.challenge, user, expires: Date.now() + 300000 };
+  res.json(options);
+});
+app.post('/api/register/verify', async (req, res) => {
+  const pending = challenge(req, 'register');
+  const result = await verifyRegistrationResponse({ response: req.body.credential, expectedChallenge: pending.challenge, expectedOrigin: req.expectedOrigin, expectedRPID: req.rpID, requireUserVerification: true });
+  if (!result.verified) throw new Error('Could not verify your passkey.');
+  const { credential, credentialDeviceType, credentialBackedUp } = result.registrationInfo;
+  if (users.some(u => u.passkeys.some(k => k.id === credential.id))) throw new Error('This passkey is already registered.');
+  const user = users.find(u => u.id === pending.user.id) || pending.user;
+  if (!users.includes(user) && users.some(u => u.email === user.email)) throw new Error('This account already exists. Please sign in.');
+  user.passkeys.push({ id: credential.id, publicKey: Buffer.from(credential.publicKey).toString('base64url'), counter: credential.counter, transports: credential.transports, deviceType: credentialDeviceType, backedUp: credentialBackedUp, name: String(req.body.name || 'My passkey').trim().slice(0, 60) || 'My passkey', createdAt: new Date().toISOString(), lastUsed: null });
+  if (!users.includes(user)) users.push(user);
+  save(); signIn(req, res, user); res.json({ user: safeUser(user) });
+});
+app.post('/api/authenticate/options', async (req, res) => {
+  const reauth = req.body.reauthenticate === true;
+  if (reauth && !req.user) return res.status(401).json({ error: 'Please sign in first.' });
+  const options = await generateAuthenticationOptions({ rpID: req.rpID, userVerification: 'required', ...(reauth ? { allowCredentials: req.user.passkeys.map(k => ({ id: k.id, transports: k.transports })) } : {}) });
+  req.session.pending = { type: 'authenticate', challenge: options.challenge, userId: reauth ? req.user.id : null, expires: Date.now() + 300000 };
+  res.json(options);
+});
+app.post('/api/authenticate/verify', async (req, res) => {
+  const pending = challenge(req, 'authenticate');
+  const user = users.find(u => u.passkeys.some(k => k.id === req.body.credential?.id));
+  if (!user || (pending.userId && user.id !== pending.userId)) throw new Error('This passkey does not belong to this account.');
+  if (req.body.credential.response?.userHandle && Buffer.from(req.body.credential.response.userHandle, 'base64url').toString('utf8') !== user.id) throw new Error('This passkey does not belong to this account.');
+  const key = user.passkeys.find(k => k.id === req.body.credential.id);
+  const result = await verifyAuthenticationResponse({ response: req.body.credential, expectedChallenge: pending.challenge, expectedOrigin: req.expectedOrigin, expectedRPID: req.rpID, credential: { ...key, publicKey: new Uint8Array(Buffer.from(key.publicKey, 'base64url')) }, requireUserVerification: true });
+  if (!result.verified) throw new Error('Could not verify your identity.');
+  key.counter = result.authenticationInfo.newCounter; key.lastUsed = new Date().toISOString(); save();
+  signIn(req, res, user); res.json({ user: safeUser(user) });
+});
+app.patch('/api/passkeys/:id', requireUser, fresh, (req, res) => {
+  const key = req.user.passkeys.find(k => k.id === req.params.id);
+  if (!key) return res.status(404).json({ error: 'Passkey not found.' });
+  const name = String(req.body.name || '').trim();
+  if (!name || name.length > 60) return res.status(400).json({ error: 'Use a name between 1 and 60 characters.' });
+  key.name = name; save(); res.json({ user: safeUser(req.user) });
+});
+app.delete('/api/passkeys/:id', requireUser, fresh, (req, res) => {
+  if (req.user.passkeys.length <= 1) return res.status(400).json({ error: 'Add another passkey before removing your last one so you can still sign in.' });
+  if (!req.user.passkeys.some(k => k.id === req.params.id)) return res.status(404).json({ error: 'Passkey not found.' });
+  req.user.passkeys = req.user.passkeys.filter(k => k.id !== req.params.id); save(); res.json({ user: safeUser(req.user) });
+});
+app.post('/api/logout', (req, res) => { sessions.delete(req.session.id); res.clearCookie('grind_session'); res.json({ ok: true }); });
+app.get('/vendor/webauthn.js', (req, res) => res.sendFile(path.join(root, 'node_modules/@simplewebauthn/browser/dist/bundle/index.umd.min.js')));
+app.get('/', (req, res) => res.sendFile(path.join(root, 'index.html')));
+app.get('/styles.css', (req, res) => res.sendFile(path.join(root, 'styles.css')));
+app.get('/app.js', (req, res) => res.sendFile(path.join(root, 'app.js')));
+app.use((err, req, res, next) => { res.status(400).json({ error: err.message?.startsWith('This ') ? err.message : 'We couldn’t complete that request. Please try again.' }); });
+setInterval(() => { for (const [id, session] of sessions) if (session.expires < Date.now()) sessions.delete(id); }, 60000).unref();
+const port = Number(process.env.PORT || 11222);
+if (process.env.NODE_ENV !== 'test') app.listen(port, '0.0.0.0', () => console.log(`The Daily Grind is running on port ${port}`));
+export { app };
