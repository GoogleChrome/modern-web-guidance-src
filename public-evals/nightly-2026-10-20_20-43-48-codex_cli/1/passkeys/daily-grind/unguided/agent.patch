+const $ = s => document.querySelector(s);
+const icon = name => `<svg aria-hidden="true"><use href="#${name}"/></svg>`;
+const escapeHTML = value => String(value).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+let user = null;
+let verifiedAt = 0;
+let busy = false;
+const modal = $('#modal');
+let toastTimer;
+function toast(message) { $('#toast').textContent = message; $('#toast').classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => $('#toast').classList.remove('show'), 5000); }
+async function api(url, body, method = 'POST') {
+  const response = await fetch(`/api/${url}`, { method, headers: { 'Content-Type': 'application/json' }, ...(method !== 'GET' ? { body: JSON.stringify(body || {}) } : {}) });
+  const result = await response.json();
+  if (!response.ok) { const error = new Error(result.error || 'Something went wrong. Please try again.'); error.reauthenticate = result.reauthenticate; throw error; }
+  return result;
+}
+function showModal(content) { $('#modal-content').innerHTML = content; if (!modal.open) modal.showModal(); }
+function info(title, content, symbol = 'help') { showModal(`<div class="modal-icon">${icon(symbol)}</div><h2>${title}</h2>${content}<button class="button secondary wide" id="info-close">Got it</button>`); $('#info-close').onclick = () => modal.close(); }
+function supported() {
+  if (!window.isSecureContext || !window.PublicKeyCredential || !window.SimpleWebAuthnBrowser) { info('A secure connection, please.', '<p>Passkeys need HTTPS (or localhost) and a browser that supports WebAuthn. Open this page in a current version of Safari, Chrome, Edge, or Firefox.</p>', 'lock'); return false; }
+  return true;
+}
+function friendlyError(error) {
+  if (error.name === 'NotAllowedError' || error.code === 'ERROR_PASSTHROUGH_SEE_CAUSE_PROPERTY') return 'The passkey request was canceled or timed out. You can try again whenever you’re ready.';
+  if (error.name === 'InvalidStateError') return 'This device already has that passkey. Try another device or security key.';
+  return error.message || 'Couldn’t connect to your passkey. Please try again.';
+}
+function render() {
+  const keys = user?.passkeys || [];
+  $('#key-count').textContent = keys.length;
+  $('#account-email').textContent = user?.email || 'Not signed in';
