+  rewards: ['Good days add up.', '<p>Your Daily Grind account is the first step to a more rewarding coffee routine. Sign in to keep your account ready for what’s brewing next.</p>'],
+  profile: ['Your personal blend.', () => user ? `<p><strong>${escapeHTML(user.name)}</strong><br>${escapeHTML(user.email)}</p><p>Your account uses passkeys to keep your daily ritual secure.</p>` : '<p>Sign in or create your account with a passkey to make yourself at home.</p>'],
+  orders: ['Your next good cup awaits.', '<p>You don’t have any online orders here yet. Stop by your local café for your next daily ritual.</p>'],
