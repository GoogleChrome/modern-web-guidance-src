+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash, generateKeyPairSync, randomBytes, sign } from 'node:crypto';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+
+process.env.NODE_ENV = 'test';
+process.env.DATA_DIR = mkdtempSync(join(tmpdir(), 'grind-test-'));
+process.env.APP_ORIGIN = 'http://localhost';
+const { app } = await import('../server.js');
+const server = app.listen(0, '127.0.0.1');
+await new Promise(resolve => server.once('listening', resolve));
+const base = `http://127.0.0.1:${server.address().port}`;
+const hash = data => createHash('sha256').update(data).digest();
+const b64 = data => Buffer.from(data).toString('base64url');
+function client() {
+  let cookie = '';
+  return async (route, body, method = 'POST', origin = 'http://localhost') => {
+    const response = await fetch(`${base}/api/${route}`, { method, headers: { cookie, origin, 'content-type': 'application/json' }, ...(method === 'GET' ? {} : { body: JSON.stringify(body || {}) }) });
+    if (response.headers.get('set-cookie')) cookie = response.headers.get('set-cookie').split(';')[0];
+    return { status: response.status, data: await response.json() };
+  };
+}
+function authenticator() {
+  const { publicKey, privateKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const id = randomBytes(32); let count = 0;
+  const cose = isoCBOR.encode(new Map([[1, 2], [3, -7], [-1, 1], [-2, new Uint8Array(Buffer.from(jwk.x, 'base64url'))], [-3, new Uint8Array(Buffer.from(jwk.y, 'base64url'))]]));
+  const clientData = (type, challenge) => Buffer.from(JSON.stringify({ type, challenge, origin: 'http://localhost' }));
+  const authData = flags => { const counter = Buffer.alloc(4); counter.writeUInt32BE(count); return Buffer.concat([hash('localhost'), Buffer.from([flags]), counter]); };
+  return {
+    register(options) {
+      const length = Buffer.alloc(2); length.writeUInt16BE(id.length);
+      const data = Buffer.concat([authData(0x45), Buffer.alloc(16), length, id, cose]);
+      return { id: b64(id), rawId: b64(id), type: 'public-key', clientExtensionResults: {}, response: { clientDataJSON: b64(clientData('webauthn.create', options.challenge)), attestationObject: b64(isoCBOR.encode(new Map([['fmt', 'none'], ['authData', new Uint8Array(data)], ['attStmt', new Map()]]))), transports: ['internal'] } };
+    },
+    authenticate(options) {
+      count++; const data = authData(0x05); const json = clientData('webauthn.get', options.challenge);
+      return { id: b64(id), rawId: b64(id), type: 'public-key', clientExtensionResults: {}, response: { clientDataJSON: b64(json), authenticatorData: b64(data), signature: b64(sign('sha256', Buffer.concat([data, hash(json)]), privateKey)) } };
+    }
+  };
+}
+test('passkey lifecycle verifies signatures, protects accounts, and prevents lockout', async () => {
+  const request = client(); const first = authenticator(); const second = authenticator();
+  assert.equal((await request('account', null, 'GET')).data.user, null);
+  assert.equal((await request('passkeys/no-key', { name: 'test' }, 'PATCH')).status, 401);
+  assert.equal((await request('register/options', { name: 'Alex', email: 'alex@example.com' }, 'POST', 'https://evil.example')).status, 403);
+  const options = await request('register/options', { name: 'Alex Morgan', email: 'alex@example.com' });
+  assert.equal(options.status, 200); assert.equal(options.data.authenticatorSelection.userVerification, 'required');
+  const credential = first.register(options.data);
+  const registered = await request('register/verify', { credential, name: 'Laptop' });
+  assert.equal(registered.status, 200); assert.equal(registered.data.user.passkeys.length, 1);
+  assert.equal(registered.data.user.passkeys[0].publicKey, undefined);
+  const firstId = registered.data.user.passkeys[0].id;
+  assert.equal((await request('register/verify', { credential })).status, 400);
