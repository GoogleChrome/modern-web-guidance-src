+    const key = { ...info.credential, publicKey: Buffer.from(info.credential.publicKey).toString('base64url'), name: label(req.body.name || 'My passkey', 'passkey name'), aaguid: info.aaguid, credentialType: info.credentialType, credentialDeviceType: info.credentialDeviceType, credentialBackedUp: info.credentialBackedUp, registeredAt: Date.now(), lastUsedAt: null };
+    db.exec('BEGIN IMMEDIATE');
+    try {
+      if (pending.isNew) db.prepare('INSERT INTO users VALUES (?,?,?)').run(pending.user.id, pending.user.name, pending.user.displayName);
+      db.prepare('INSERT INTO credentials VALUES (?,?,?)').run(key.id, pending.user.id, JSON.stringify(key));
+      db.exec('COMMIT');
+    } catch (err) { db.exec('ROLLBACK'); throw fail(409, 'This username or passkey is already registered. Please sign in or try again.'); }
+    req.session = { userId: pending.user.id, verifiedAt: Date.now() };
+    req.saveSession(true);
+    res.json({ verified: true });
+  });
+  for (const mode of ['login', 'reauth']) {
+    app.post(`/api/${mode}/options`, ...(mode === 'reauth' ? [signedIn] : []), async (req, res) => {
+      const userKeys = mode === 'reauth' ? keys(req.user.id) : [];
+      if (mode === 'reauth' && !userKeys.length) throw fail(400, 'Add a passkey before verifying your identity.');
+      const options = await webauthn.generateAuthenticationOptions({ rpID: req.site.rpID, userVerification: mode === 'reauth' ? 'required' : 'preferred', allowCredentials: userKeys.map(key => ({ id: key.id, transports: key.transports })) });
+      setCeremony(req, options, mode, { userId: mode === 'reauth' ? req.user.id : null });
+      res.json(options);
+    });
+    app.post(`/api/${mode}/verify`, ...(mode === 'reauth' ? [signedIn] : []), async (req, res) => {
+      const pending = consume(req, mode);
