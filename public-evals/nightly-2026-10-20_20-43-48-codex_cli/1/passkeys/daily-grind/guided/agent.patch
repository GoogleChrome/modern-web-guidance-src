@@ -0,0 +1,161 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash, generateKeyPairSync, randomBytes, sign } from 'node:crypto';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+import { createApp } from '../server.js';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const origin = 'http://localhost:11222';
+const digest = bytes => createHash('sha256').update(bytes).digest();
+const b64 = bytes => Buffer.from(bytes).toString('base64url');
+const uint32 = n => { const bytes = Buffer.alloc(4); bytes.writeUInt32BE(n); return bytes; };
+const uint16 = n => { const bytes = Buffer.alloc(2); bytes.writeUInt16BE(n); return bytes; };
+function authenticator() {
+  const id = randomBytes(32), { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const cose = isoCBOR.encode(new Map([[1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x, 'base64url')], [-3, Buffer.from(jwk.y, 'base64url')]]));
+  let counter = 0;
+  return {
+    id: b64(id),
+    registration(options, changes = {}) {
+      const clientData = Buffer.from(JSON.stringify({ type: 'webauthn.create', challenge: options.challenge, origin, ...changes }));
+      const authData = Buffer.concat([digest('localhost'), Buffer.from([0x45]), uint32(0), Buffer.alloc(16), uint16(id.length), id, cose]);
+      const attestation = isoCBOR.encode(new Map([['fmt', 'none'], ['attStmt', new Map()], ['authData', authData]]));
+      return { id: b64(id), rawId: b64(id), type: 'public-key', response: { clientDataJSON: b64(clientData), attestationObject: b64(attestation), transports: ['internal'] }, clientExtensionResults: {} };
+    },
+    assertion(options, userId, { verified = true, challenge = options.challenge, signatureValid = true } = {}) {
+      const clientData = Buffer.from(JSON.stringify({ type: 'webauthn.get', challenge, origin }));
+      const authData = Buffer.concat([digest('localhost'), Buffer.from([verified ? 5 : 1]), uint32(++counter)]);
+      const signature = sign('sha256', Buffer.concat([authData, digest(clientData)]), privateKey);
+      if (!signatureValid) signature[signature.length - 1] ^= 1;
+      return { id: b64(id), rawId: b64(id), type: 'public-key', response: { clientDataJSON: b64(clientData), authenticatorData: b64(authData), signature: b64(signature), userHandle: userId }, clientExtensionResults: {} };
+    },
+  };
+}
+async function fixture(t, database = ':memory:') {
+  const { app, db } = createApp({ database, origin });
+  const server = app.listen(0, '127.0.0.1');
+  await new Promise(resolve => server.once('listening', resolve));
+  const close = () => { server.closeAllConnections(); server.close(); if (db.isOpen) db.close(); };
+  t.after(close);
+  const url = `http://127.0.0.1:${server.address().port}`;
+  const client = (initialCookie = '') => {
+    let cookie = initialCookie;
+    return { get cookie() { return cookie; }, async request(path, body, method = 'POST', requestOrigin = origin) {
+      const response = await fetch(url + '/api/' + path, { method, headers: { Origin: requestOrigin, Cookie: cookie, 'Content-Type': 'application/json' }, body: method === 'GET' ? undefined : JSON.stringify(body ?? {}) });
+      const set = response.headers.get('set-cookie'); if (set) cookie = set.split(';')[0];
+      return { status: response.status, data: await response.json(), headers: response.headers };
+    } };
+  };
+  return { client, db, close };
+}
+async function signup(client, name = 'coffee.person') {
+  const auth = authenticator();
+  const options = await client.request('register/options', { name, displayName: 'Coffee Person' });
+  assert.equal(options.status, 200);
+  assert.equal(options.data.authenticatorSelection.residentKey, 'required');
+  const result = await client.request('register/verify', { credential: auth.registration(options.data), name: 'My laptop' });
+  assert.equal(result.status, 200, JSON.stringify(result.data));
+  const { data } = await client.request('session', null, 'GET');
+  return { auth, user: data.user };
+}
+
+test('real registration, logout, discoverable sign-in, rotation, and replay prevention', async t => {
+  const { client } = await fixture(t); const c = client();
+  const { auth, user } = await signup(c);
+  const registeredCookie = c.cookie;
+  let list = await c.request('credentials', null, 'GET');
+  assert.equal(list.data.length, 1); assert.equal(list.data[0].publicKey, undefined);
+  assert.ok(list.data[0].registeredAt); assert.equal(list.data[0].lastUsedAt, null);
+  await c.request('logout');
+  assert.equal((await client(registeredCookie).request('session', null, 'GET')).data.user, null);
+  assert.equal((await c.request('credentials', null, 'GET')).status, 401);
+  const options = await c.request('login/options');
+  assert.deepEqual(options.data.allowCredentials, []);
+  const before = c.cookie;
+  const assertion = auth.assertion(options.data, user.id);
+  assert.equal((await c.request('login/verify', assertion)).status, 200);
