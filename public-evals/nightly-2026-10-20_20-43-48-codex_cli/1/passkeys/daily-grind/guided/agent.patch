+import 'webauthn-polyfills';
+import providers from './providers.json';
+
+const $ = id => document.getElementById(id);
+let session, passkeys = [], supported = false, capabilities = {}, controller, busy = false;
+let dialogAction;
+const message = (text = '', error = false) => { $('status').textContent = text; $('status').classList.toggle('error', error); };
+async function api(path, body, method = 'POST', requestSignal) {
+  const response = await fetch(`/api/${path}`, { method, signal: requestSignal, credentials: 'same-origin', headers: body === undefined ? {} : { 'Content-Type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
+  const data = await response.json();
+  if (!response.ok) throw Object.assign(new Error(data.error || 'Please try again.'), { status: response.status });
+  return data;
+}
+async function signal(method, details) {
+  try { if (supported && typeof PublicKeyCredential[method] === 'function') await PublicKeyCredential[method]({ rpId: session.rpId, ...details }); }
+  catch { /* Password manager synchronization must never block account operations. */ }
+}
+function stopPrompt() { controller?.abort(); controller = new AbortController(); }
+async function run(work) {
+  if (busy) return;
+  busy = true; stopPrompt(); message();
+  const buttons = [...document.querySelectorAll('button')];
+  buttons.forEach(button => button.disabled = true);
+  try { await work(); }
+  catch (error) {
+    const errors = { NotAllowedError: 'The passkey prompt was cancelled or timed out. You can try again.', AbortError: 'The passkey request was cancelled. Please try again.', InvalidStateError: 'A passkey already exists in this provider. Try another device or security key.', SecurityError: 'Passkeys require a secure connection and a matching site address.' };
+    message(errors[error.name] || error.message || 'Something went wrong. Please try again.', true);
+    if (error.status === 401) await refresh();
+  } finally {
+    busy = false; buttons.forEach(button => button.disabled = false);
+    document.querySelectorAll('[data-passkey]').forEach(button => button.disabled = !supported);
+    if (!session?.user) void conditionalSignIn();
+  }
+}
+async function authenticate(mode = 'login', conditional = false) {
+  const requestController = controller;
+  const options = await api(`${mode}/options`, {}, 'POST', requestController.signal);
+  const credential = await navigator.credentials.get({ publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(options), signal: requestController.signal, ...(conditional ? { mediation: 'conditional' } : {}) });
+  if (!credential) throw new Error('No passkey was selected. Please try again.');
+  const encoded = credential.toJSON();
+  try { await api(`${mode}/verify`, encoded); }
+  catch (error) {
+    if (mode === 'login' && !session?.user && error.status === 404) await signal('signalUnknownCredential', { credentialId: encoded.id });
+    throw error;
+  }
+  await refresh();
+}
+async function conditionalSignIn() {
+  if (!supported || !capabilities.conditionalGet || busy || session?.user || $('signin-panel').hidden) return;
+  stopPrompt();
+  try { await authenticate('login', true); message('Welcome back. You’re signed in securely.'); }
+  catch (error) { if (!['AbortError', 'NotAllowedError'].includes(error.name)) message(error.message, true); }
+}
+async function ensureVerified() {
+  if (!session.verifiedAt || Date.now() - session.verifiedAt > 5 * 60 * 1000) await authenticate('reauth');
+}
+async function register(isNew, name = 'My passkey') {
+  if (!isNew) await ensureVerified();
+  const options = await api('register/options', isNew ? { name: $('username').value, displayName: $('display-name').value } : {});
+  const credential = await navigator.credentials.create({ publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options), signal: controller.signal });
+  if (!credential) throw new Error('No passkey was created. Please try again.');
+  const encoded = credential.toJSON();
+  try { await api('register/verify', { credential: encoded, name }); }
+  catch (error) {
+    // Do not delete a potentially committed credential after an ambiguous network failure.
+    if (error.status === 400 || error.status === 403) await signal('signalUnknownCredential', { credentialId: encoded.id });
+    throw error;
+  }
+  await refresh();
+  message(isNew ? 'You’re in! Your account and passkey are ready.' : 'Your new passkey is ready to use.');
+}
+const date = timestamp => timestamp ? new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(timestamp) : 'Not used yet';
+function renderKeys() {
+  $('key-count').textContent = passkeys.length;
+  $('key-list').replaceChildren();
+  if (!passkeys.length) { const empty = document.createElement('p'); empty.textContent = 'No passkeys yet. Add one to secure your account.'; $('key-list').append(empty); }
+  for (const key of passkeys) {
+    const row = document.createElement('div'); row.className = 'key-row';
+    const provider = key.aaguid !== '00000000-0000-0000-0000-000000000000' ? providers[key.aaguid] : null;
+    const icon = document.createElement(provider?.icon ? 'img' : 'span'); icon.className = 'key-icon';
+    if (provider?.icon) { icon.src = provider.icon; icon.alt = provider.name; }
+    else { icon.textContent = '⌘'; icon.setAttribute('aria-hidden', 'true'); }
+    const info = document.createElement('div'); info.className = 'key-info';
+    const title = document.createElement('strong'); title.textContent = key.name;
+    const detail = document.createElement('p'); detail.textContent = `${provider?.name || (key.credentialBackedUp ? 'Synced passkey' : 'Passkey')} · Added ${date(key.registeredAt)}`;
+    const last = document.createElement('p'); last.textContent = `Last used: ${date(key.lastUsedAt)}`;
+    info.append(title, detail, last);
+    const actions = document.createElement('div'); actions.className = 'key-actions';
+    const rename = document.createElement('button'); rename.className = 'text-button'; rename.textContent = 'Rename'; rename.setAttribute('aria-label', `Rename ${key.name}`);
+    rename.addEventListener('click', () => openDialog('rename', key));
+    const remove = document.createElement('button'); remove.className = 'text-button'; remove.textContent = 'Remove'; remove.setAttribute('aria-label', `Remove ${key.name}`);
+    remove.addEventListener('click', () => {
+      if (passkeys.length <= 1) return message('Add another passkey before removing your last one so you can still sign in.', true);
+      openDialog('remove', key);
+    });
+    actions.append(rename, remove); row.append(icon, info, actions); $('key-list').append(row);
+  }
+}
+async function refresh() {
+  session = await api('session', undefined, 'GET');
+  $('loading').hidden = true; $('guest').hidden = !!session.user; $('member').hidden = !session.user; $('logout').hidden = !session.user;
+  if (session.user) {
+    $('member-title').textContent = `Good to see you, ${session.user.displayName}.`;
+    $('profile-name').value = session.user.displayName; $('profile-username').value = session.user.name;
+    $('verified-badge').textContent = session.verifiedAt && Date.now() - session.verifiedAt < 300000 ? 'Identity verified' : 'Identity protected';
+    passkeys = await api('credentials', undefined, 'GET'); renderKeys();
+    await signal('signalAllAcceptedCredentials', { userId: session.user.id, allAcceptedCredentialIds: passkeys.map(key => key.id) });
+  }
+}
+function openDialog(action, key) {
+  stopPrompt();
+  dialogAction = { action, key };
+  const remove = action === 'remove', add = action === 'add';
+  $('dialog-title').textContent = remove ? 'Remove this passkey?' : add ? 'Add a passkey.' : 'Make it memorable.';
+  $('dialog-description').textContent = remove ? `“${key.name}” will no longer sign you in. You may be asked to verify your identity before removing it.` : add ? 'Give it a name so it’s easy to recognize. You can use your device or a security key.' : 'Choose a name that helps you recognize this passkey.';
+  $('dialog-name-wrap').hidden = remove; $('key-name').required = !remove; $('key-name').value = key?.name || ''; $('confirm-dialog').textContent = remove ? 'Remove passkey' : add ? 'Create passkey' : 'Save name';
+  $('edit-dialog').showModal();
+}
+$('dialog-form').addEventListener('submit', event => {
+  event.preventDefault(); const { action, key } = dialogAction; const name = $('key-name').value.trim();
+  if (action !== 'remove' && !name) { $('key-name').focus(); return; }
+  $('edit-dialog').close();
+  void run(async () => {
+    if (action === 'add') return register(false, name);
+    if (action === 'remove') { await ensureVerified(); await api(`credentials/${encodeURIComponent(key.id)}`, undefined, 'DELETE'); await refresh(); message('Passkey removed. Remove its saved copy from your password manager if it still appears.'); }
+    else { await api(`credentials/${encodeURIComponent(key.id)}`, { name }, 'PUT'); await refresh(); message('Passkey name updated.'); }
+  });
+});
+for (const id of ['cancel-dialog', 'close-dialog']) $(id).addEventListener('click', () => $('edit-dialog').close());
+function selectTab(signup) {
+  stopPrompt();
+  $('signin-panel').hidden = signup; $('signup-panel').hidden = !signup;
+  for (const [id, selected] of [['signin-tab', !signup], ['signup-tab', signup]]) { $(id).setAttribute('aria-selected', selected); $(id).tabIndex = selected ? 0 : -1; }
+  message(); if (!signup) void conditionalSignIn();
+}
+$('signin-tab').addEventListener('click', () => selectTab(false));
+$('signup-tab').addEventListener('click', () => selectTab(true));
+for (const id of ['signin-tab', 'signup-tab']) $(id).addEventListener('keydown', event => { if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) { event.preventDefault(); const signup = event.key === 'End' || (event.key !== 'Home' && id === 'signin-tab'); selectTab(signup); $(signup ? 'signup-tab' : 'signin-tab').focus(); } });
+$('signin-form').addEventListener('submit', event => { event.preventDefault(); void run(async () => { await authenticate(); message('Welcome back. You’re signed in securely.'); }); });
+$('signup-form').addEventListener('submit', event => { event.preventDefault(); void run(() => register(true)); });
+$('add-key').addEventListener('click', () => openDialog('add'));
+$('verify-identity').addEventListener('click', () => run(async () => { await authenticate('reauth'); message('Identity verified. You can make sensitive changes for the next five minutes.'); }));
+$('profile-form').addEventListener('submit', event => {
+  event.preventDefault(); const updates = { displayName: $('profile-name').value, name: $('profile-username').value };
+  void run(async () => { await ensureVerified(); const user = await api('user', updates, 'PUT'); await signal('signalCurrentUserDetails', { userId: user.id, name: user.name, displayName: user.displayName }); await refresh(); message('Your account details have been saved.'); });
+});
+$('logout').addEventListener('click', () => run(async () => { await api('logout', {}); await refresh(); message('You’re signed out. See you for your next cup.'); }));
+async function initialize() {
+  supported = !!(window.isSecureContext && window.PublicKeyCredential && navigator.credentials);
+  if (supported) { try { capabilities = await PublicKeyCredential.getClientCapabilities(); } catch { /* Explicit passkey prompts can still work. */ } }
+  $('unsupported').hidden = supported;
+  document.querySelectorAll('[data-passkey]').forEach(button => button.disabled = !supported);
+  try { await refresh(); await conditionalSignIn(); }
+  catch (error) { $('loading').hidden = true; message(`Couldn’t load your account. ${error.message} Refresh to try again.`, true); }
+}
+window.addEventListener('pagehide', () => controller?.abort());
+void initialize();
