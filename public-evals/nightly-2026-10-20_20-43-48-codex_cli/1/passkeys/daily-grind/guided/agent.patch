+  const { auth: otherAuth, user: otherUser } = await signup(otherClient, 'other.person');
+  assert.equal((await c.request(`credentials/${auth.id}`, undefined, 'DELETE')).status, 409);
+  assert.equal((await otherClient.request(`credentials/${auth.id}`, { name: 'stolen' }, 'PUT')).status, 404);
+  assert.equal((await c.request(`credentials/${auth.id}`, { name: 'Work laptop' }, 'PUT')).status, 200);
+  assert.equal((await c.request('credentials', null, 'GET')).data[0].name, 'Work laptop');
+  const second = authenticator(); let options = await c.request('register/options');
+  assert.equal(options.data.excludeCredentials[0].id, auth.id);
+  assert.equal((await c.request('register/verify', { credential: second.registration(options.data), name: 'Backup key' })).status, 200);
+  // Expire step-up grants while preserving the signed-in session.
+  for (const row of db.prepare('SELECT id,data FROM sessions').all()) { const data = JSON.parse(row.data); data.verifiedAt = 0; db.prepare('UPDATE sessions SET data=? WHERE id=?').run(JSON.stringify(data), row.id); }
+  assert.equal((await c.request('register/options')).status, 403);
+  assert.equal((await c.request('user', { name: 'updated.person', displayName: 'Updated' }, 'PUT')).status, 403);
+  assert.equal((await c.request(`credentials/${second.id}`, undefined, 'DELETE')).status, 403);
+  options = await c.request('reauth/options');
+  assert.equal(options.data.allowCredentials.length, 2);
+  assert.equal((await c.request('reauth/verify', otherAuth.assertion(options.data, otherUser.id))).status, 403);
+  options = await c.request('reauth/options');
+  assert.equal((await c.request('reauth/verify', auth.assertion(options.data, user.id, { verified: false }))).status, 400);
+  options = await c.request('reauth/options');
+  assert.equal((await c.request('reauth/verify', auth.assertion(options.data, user.id))).status, 200);
+  assert.equal((await c.request('user', { name: 'updated.person', displayName: 'Updated' }, 'PUT')).status, 200);
+  assert.equal((await c.request(`credentials/${second.id}`, undefined, 'DELETE')).status, 200);
+  assert.equal((await c.request('credentials', null, 'GET')).data.length, 1);
+  options = await c.request('login/options');
+  assert.equal((await c.request('login/verify', { id: second.id })).status, 404);
