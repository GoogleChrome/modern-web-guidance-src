+      req.saveSession(mode === 'login');
+      res.json({ verified: true });
+    });
+  }
+  app.get('/api/credentials', signedIn, (req, res) => res.json(keys(req.user.id).map(({ publicKey, counter, ...key }) => key)));
+  app.put('/api/credentials/:id', signedIn, (req, res) => {
+    const key = getKey(req.params.id);
+    if (!key || key.userId !== req.user.id) throw fail(404, 'Passkey not found.');
+    storeKey({ ...key, name: label(req.body.name, 'passkey name') });
+    res.json({ success: true });
+  });
+  app.delete('/api/credentials/:id', signedIn, (req, res) => {
+    recent(req);
+    const key = getKey(req.params.id);
+    if (!key || key.userId !== req.user.id) throw fail(404, 'Passkey not found.');
+    if (keys(req.user.id).length <= 1) throw fail(409, 'Add another passkey before removing your last one so you can still sign in.');
+    db.prepare('DELETE FROM credentials WHERE id=?').run(key.id);
+    res.json({ success: true });
+  });
+  app.put('/api/user', signedIn, (req, res) => {
+    recent(req);
+    const name = username(req.body.name), displayName = label(req.body.displayName, 'name');
+    try { db.prepare('UPDATE users SET name=?,displayName=? WHERE id=?').run(name, displayName, req.user.id); }
+    catch { throw fail(409, 'That username is already taken.'); }
+    res.json(getUser(req.user.id));
+  });
+  app.post('/api/logout', (req, res) => {
+    if (req.sessionId) db.prepare('DELETE FROM sessions WHERE id=?').run(req.sessionId);
+    res.clearCookie('grind_session', { path: '/' });
+    res.json({ success: true });
+  });
+  app.get('/account', (req, res) => res.sendFile(resolve(root, 'account.html')));
+  app.use('/assets', express.static(resolve(root, 'public')));
+  app.get('/', (req, res) => res.sendFile(resolve(root, 'index.html')));
+  app.use('/api', (req, res) => res.status(404).json({ error: 'Endpoint not found.' }));
+  app.use((err, req, res, next) => {
+    if (!err.status || err.status >= 500) console.error(err);
+    res.status(err.status || 500).json({ error: err.status ? err.message : 'Something went wrong. Please try again.' });
+  });
+  return { app, db };
+}
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const { app } = createApp();
+  app.listen(Number(process.env.PORT || 11222), '0.0.0.0', () => console.log(`The Daily Grind is running on port ${process.env.PORT || 11222}`));
+}
