+      let result;
+      try { result = await verifier.verifyAuthenticationResponse({ response: req.body, expectedChallenge: pending.challenge, expectedOrigin: req.site.origin, expectedRPID: req.site.rpID, credential: { ...key, publicKey: Buffer.from(key.publicKey, 'base64url') }, requireUserVerification: pending.userVerification === 'required' }); }
