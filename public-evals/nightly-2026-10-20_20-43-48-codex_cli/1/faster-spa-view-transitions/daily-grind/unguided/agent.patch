index 0000000..d58d6cd
--- /dev/null
+++ b/router.test.js
@@ -0,0 +1,109 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import { JSDOM } from 'jsdom';
+import { startRouter } from './router.js';
+
+const html = readFileSync(new URL('./index.html', import.meta.url), 'utf8');
+function setup(path = '/') {
+  const dom = new JSDOM(html, { url: `https://daily-grind.test${path}` });
+  const { window } = dom;
+  window.scrollTo = (x, y) => {
+    window.scrollX = x;
+    window.scrollY = y;
+  };
+  startRouter(window.document, window);
+  const click = href => {
+    const link = [...window.document.querySelectorAll('a')].find(link =>
+      link.getAttribute('href') === href && !link.closest('[hidden]'));
+    assert.ok(link, `Visible link to ${href}`);
+    link.click();
+  };
+  return { window, document: window.document, click };
+}
+
+test('returning to a view preserves its DOM, inputs, listeners, and scroll', () => {
+  const { window, document, click } = setup();
+  click('/account');
+  const account = document.querySelector('[data-view="/account"]');
+  const input = account.querySelector('input');
+  input.value = 'Coffee enthusiast';
+  let events = 0;
+  input.addEventListener('change', () => events++);
+  window.scrollTo(0, 320);
+  click('/menu');
+  assert.equal(account.hidden, true);
+  assert.equal(document.querySelectorAll('[data-view]').length, 3);
+  click('/account');
+  assert.strictEqual(document.querySelector('[data-view="/account"]'), account);
+  assert.strictEqual(account.querySelector('input'), input);
+  assert.equal(input.value, 'Coffee enthusiast');
+  input.dispatchEvent(new window.Event('change'));
+  assert.equal(events, 1);
+  assert.equal(window.scrollY, 320);
+  assert.equal(document.querySelectorAll('[data-view]:not([hidden])').length, 1);
+  assert.equal(document.querySelectorAll('[data-view="/account"]').length, 1);
+  assert.equal(document.querySelector('nav a[aria-current]').pathname, '/account');
+  window.close();
+});
+
+test('Back and Forward restore cached views', async () => {
+  const { window, document, click } = setup();
+  click('/menu');
+  const menu = document.querySelector('[data-view="/menu"]');
+  click('/account');
+  const popstate = () => new Promise(resolve => window.addEventListener('popstate', resolve, { once: true }));
+  let popped = popstate();
+  window.history.back();
+  await popped;
+  assert.equal(window.location.pathname, '/menu');
+  assert.strictEqual(document.querySelector('[data-view="/menu"]'), menu);
+  assert.equal(menu.hidden, false);
+  popped = popstate();
+  window.history.forward();
+  await popped;
+  assert.equal(window.location.pathname, '/account');
+  assert.equal(menu.hidden, true);
+  window.close();
+});
+
+test('a deep link initializes the correct view and moves focus out of hidden content', () => {
+  const { window, document, click } = setup('/menu/seasonal/');
+  assert.equal(document.querySelector('[data-view="/"]').hidden, true);
+  assert.equal(document.title, 'Maple Oat Latte | The Daily Grind');
+  document.querySelector('[data-view="/menu/seasonal"] a').focus();
+  click('/menu');
+  assert.equal(document.activeElement.textContent, 'Our Menu');
+  window.close();
+});
+
+test('modified clicks, external URLs, downloads, hashes, and unknown routes stay native', () => {
+  const { window, document } = setup();
+  for (const attributes of [
+    { href: '/menu', ctrlKey: true },
+    { href: 'https://example.com', target: '_blank' },
+    { href: '/menu', target: '_blank' },
+    { href: '/menu', download: '' },
+    { href: '/#favorites' },
+    { href: '/logout' },
+  ]) {
+    const link = document.createElement('a');
+    for (const [name, value] of Object.entries(attributes)) {
+      if (name !== 'ctrlKey') link.setAttribute(name, value);
+    }
+    document.body.append(link);
+    let prevented;
+    // Cancel native navigation after recording whether the router intercepted it.
+    window.addEventListener('click', event => {
+      prevented = event.defaultPrevented;
+      event.preventDefault();
+    }, { once: true });
+    link.dispatchEvent(new window.MouseEvent('click', {
+      bubbles: true, cancelable: true, button: 0, ctrlKey: attributes.ctrlKey,
+    }));
+    assert.equal(prevented, false, JSON.stringify(attributes));
+    assert.equal(window.location.pathname, '/');
+    link.remove();
+  }
+  window.close();
+});
