+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { resolve } from 'node:path';
+
+export async function createAppServer() {
+  const html = await readFile(new URL('./index.html', import.meta.url));
+  const router = await readFile(new URL('./router.js', import.meta.url));
+  const routes = new Set(['/', '/index.html',
+    ...[...html.toString().matchAll(/data-route="([^"]+)"/g)].map(match => match[1])]);
+  return createServer((request, response) => {
+    const path = new URL(request.url, 'http://localhost').pathname.replace(/\/+$/, '') || '/';
+    if (request.method !== 'GET' && request.method !== 'HEAD') {
+      response.writeHead(405, { Allow: 'GET, HEAD' });
+      response.end();
+      return;
+    }
+    const body = routes.has(path) ? html : path === '/router.js' ? router : null;
+    response.writeHead(body ? 200 : 404, {
+      'Content-Type': path === '/router.js' ? 'text/javascript; charset=utf-8' : 'text/html; charset=utf-8',
+    });
+    response.end(request.method === 'HEAD' ? undefined : body || 'Not found');
+  });
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const server = await createAppServer();
+  const port = Number(process.env.PORT || 11222);
+  server.listen(port, '0.0.0.0', () => console.log(`The Daily Grind: http://localhost:${port}`));
+}
