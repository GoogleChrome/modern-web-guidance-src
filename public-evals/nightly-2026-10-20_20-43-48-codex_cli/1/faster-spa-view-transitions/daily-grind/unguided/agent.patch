index 0000000..2ed262f
--- /dev/null
+++ b/router.js
@@ -0,0 +1,73 @@
+// Views stay mounted for the lifetime of the document, preserving DOM identity,
+// event listeners, and in-progress input without serializing or rebuilding them.
+export function startRouter(document, window) {
+  const host = document.getElementById('views');
+  const home = host.querySelector('[data-view="/"]');
+  const templates = new Map([...document.querySelectorAll('template[data-route]')]
+    .map(template => [template.dataset.route, template]));
+  const views = new Map([['/', home]]);
+  const scrollPositions = new Map();
+  const homeTitle = document.title;
+  let activePath = '/';
+
+  const routePath = url => url.pathname.replace(/\/+$/, '') || '/';
+  const hasRoute = path => path === '/' || templates.has(path);
+
+  function show(url) {
+    const path = routePath(url);
+    if (!hasRoute(path)) return false;
+
+    scrollPositions.set(activePath, [window.scrollX, window.scrollY]);
+    let view = views.get(path);
+    if (!view) {
+      view = templates.get(path).content.firstElementChild.cloneNode(true);
+      view.dataset.view = path;
+      view.hidden = true;
+      host.append(view);
+      views.set(path, view);
+    }
+
+    const previous = views.get(activePath);
+    const focusWasInView = previous.contains(document.activeElement);
+    previous.hidden = true;
+    view.hidden = false;
+    activePath = path;
+    document.title = path === '/' ? homeTitle
+      : `${templates.get(path).dataset.title} | The Daily Grind`;
+    for (const link of document.querySelectorAll('nav a[href]')) {
+      if (routePath(new URL(link.href)) === path) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    }
+
+    // Hidden views are excluded from tab order and the accessibility tree.
+    if (focusWasInView) {
+      const heading = view.querySelector('h1');
+      heading.setAttribute('tabindex', '-1');
+      heading.focus({ preventScroll: true });
+    }
+    window.scrollTo(...(scrollPositions.get(path) || [0, 0]));
+    return true;
+  }
+
+  document.addEventListener('click', event => {
+    if (event.defaultPrevented || event.button !== 0 || event.metaKey ||
+        event.ctrlKey || event.shiftKey || event.altKey) return;
+    const link = event.target.closest?.('a[href]');
+    if (!link || link.hasAttribute('download') ||
+        (link.target && link.target !== '_self')) return;
+    const url = new URL(link.href);
+    if (url.origin !== window.location.origin || url.hash || !hasRoute(routePath(url))) return;
+    event.preventDefault();
+    if (url.href === window.location.href) return;
+    window.history.pushState(null, '', url);
+    show(url);
+  });
+
+  window.addEventListener('popstate', () => {
+    if (!show(new URL(window.location.href))) window.location.reload();
+  });
+  if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
+  show(new URL(window.location.href));
+}
+
+if (typeof document !== 'undefined') startRouter(document, window);
diff --git a/router.test.js b/router.test.js
