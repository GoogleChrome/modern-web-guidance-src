diff --git a/server.cjs b/server.cjs
new file mode 100644
index 0000000..a4e51da
--- /dev/null
+++ b/server.cjs
@@ -0,0 +1,32 @@
+const { createServer } = require('node:http');
+const { readFileSync } = require('node:fs');
+
+const index = readFileSync(`${__dirname}/index.html`);
+const navigation = readFileSync(`${__dirname}/navigation.js`);
+const routes = new Set(['/', '/index.html', ...Array.from(
+  index.toString().matchAll(/<template data-route="([^"]+)"/g), match => match[1]
+)]);
+
+// Serve the app shell for declared routes so reloads and deep links work too.
+const server = createServer((request, response) => {
+  if (request.method !== 'GET' && request.method !== 'HEAD') {
+    response.writeHead(405, { Allow: 'GET, HEAD' });
+    response.end();
+    return;
+  }
+  const path = new URL(request.url, 'http://localhost').pathname;
+  const isScript = path === '/navigation.js';
+  if (!isScript && !routes.has(path)) {
+    response.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+    response.end('Not found');
+    return;
+  }
+  response.writeHead(200, {
+    'Content-Type': isScript ? 'text/javascript; charset=utf-8' : 'text/html; charset=utf-8'
+  });
+  response.end(request.method === 'HEAD' ? undefined : isScript ? navigation : index);
+});
+
+server.listen(process.env.PORT || 11222, '0.0.0.0', () => {
+  console.log(`The Daily Grind is listening on port ${server.address().port}`);
+});
