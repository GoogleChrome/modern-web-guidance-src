diff --git a/navigation.js b/navigation.js
new file mode 100644
index 0000000..414492f
--- /dev/null
+++ b/navigation.js
@@ -0,0 +1,65 @@
+(() => {
+  const outlet = document.getElementById('views');
+  const templates = new Map(
+    [...document.querySelectorAll('template[data-route]')].map(template => [template.dataset.route, template])
+  );
+  // Only the finite set of declared routes can enter this cache.
+  const views = new Map([['/', document.getElementById('home-view')]]);
+  let activePath = '/';
+
+  function showView(path, { focus = true } = {}) {
+    if (path !== '/' && !templates.has(path)) return false;
+
+    if (!views.has(path)) {
+      const template = templates.get(path);
+      const view = document.createElement('main');
+      view.className = 'spa-view container';
+      view.tabIndex = -1;
+      view.setAttribute('aria-label', template.dataset.title);
+      view.append(template.content.cloneNode(true));
+      outlet.append(view);
+      views.set(path, view);
+    }
+
+    const target = views.get(path);
+    // Release focus before making its previous ancestor inaccessible.
+    if (focus && document.activeElement instanceof HTMLElement) {
+      document.activeElement.blur();
+    }
+    for (const view of views.values()) {
+      const inactive = view !== target;
+      view.classList.toggle('inactive', inactive);
+      view.inert = inactive;
+      view.setAttribute('aria-hidden', String(inactive));
+    }
+    activePath = path;
+    document.title = path === '/'
+      ? 'The Daily Grind | Artisanal Coffee'
+      : `${templates.get(path).dataset.title} | The Daily Grind`;
+    document.querySelectorAll('nav a').forEach(link => {
+      if (new URL(link.href).pathname === path) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    });
+    if (focus) target.focus();
+    return true;
+  }
+
+  document.addEventListener('click', event => {
+    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+    const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
+    if (!link || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
+    const url = new URL(link.href);
+    if (url.origin !== location.origin || url.search || url.hash) return;
+    if (url.pathname !== '/' && !templates.has(url.pathname)) return;
+
+    event.preventDefault();
+    if (activePath === url.pathname) return;
+    history.pushState(null, '', url.pathname);
+    showView(url.pathname);
+  });
+
+  window.addEventListener('popstate', () => {
+    if (!showView(location.pathname)) location.reload();
+  });
+  showView(location.pathname, { focus: false });
+})();
diff --git a/navigation.test.cjs b/navigation.test.cjs
new file mode 100644
index 0000000..b7ae200
--- /dev/null
+++ b/navigation.test.cjs
@@ -0,0 +1,112 @@
+const { readFileSync } = require('node:fs');
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { JSDOM } = require('jsdom');
+
+const html = readFileSync(`${__dirname}/index.html`, 'utf8');
+const script = readFileSync(`${__dirname}/navigation.js`, 'utf8');
+
+function app(path = '/') {
+  const dom = new JSDOM(html, { url: `https://daily-grind.test${path}`, runScripts: 'outside-only' });
+  dom.window.eval(script);
+  return dom;
+}
+
+function navigate(window, path) {
+  const link = window.document.createElement('a');
+  link.href = path;
+  window.document.body.append(link);
+  link.click();
+  link.remove();
+}
+
+test('revisiting a view reuses its DOM, input values, and event listeners', t => {
+  const dom = app();
+  t.after(() => dom.window.close());
+  const { window } = dom;
+  const { document } = window;
+  assert.equal(document.querySelectorAll('.spa-view').length, 1);
+  navigate(window, '/account');
+  const input = document.getElementById('favorite-coffee');
+  const account = input.closest('.spa-view');
+  input.value = 'Oat latte';
+  let events = 0;
+  input.addEventListener('input', () => events++);
+  input.focus();
+
+  navigate(window, '/menu');
+  assert.equal(account.isConnected, true);
+  assert.equal(account.classList.contains('inactive'), true);
+  assert.equal(account.inert, true);
+  assert.equal(account.getAttribute('aria-hidden'), 'true');
+  assert.notEqual(document.activeElement, input);
+
+  navigate(window, '/account');
+  assert.equal(document.getElementById('favorite-coffee'), input);
+  assert.equal(input.value, 'Oat latte');
+  input.dispatchEvent(new window.Event('input'));
+  assert.equal(events, 1);
+  assert.equal(account.inert, false);
+  assert.equal(account.getAttribute('aria-hidden'), 'false');
+  assert.equal(document.activeElement, account);
+  assert.equal(document.querySelectorAll('.spa-view:not(.inactive)').length, 1);
+  assert.equal(document.querySelectorAll('.spa-view').length, 3);
+  assert.equal(document.querySelector('nav [aria-current="page"]').pathname, '/account');
+});
+
+test('native disclosure state survives navigation and history Back/Forward', async t => {
+  const dom = app('/menu/seasonal');
+  t.after(() => dom.window.close());
+  const { window } = dom;
+  const details = window.document.querySelector('#views details');
+  details.open = true;
+  navigate(window, '/menu');
+  const back = new Promise(resolve => window.addEventListener('popstate', resolve, { once: true }));
+  window.history.back();
+  await back;
+  assert.equal(window.location.pathname, '/menu/seasonal');
+  assert.equal(window.document.querySelector('#views details'), details);
+  assert.equal(details.open, true);
+  assert.equal(details.closest('.spa-view').classList.contains('inactive'), false);
+  assert.equal(window.document.title, 'Maple Oat Latte | The Daily Grind');
+
+  const forward = new Promise(resolve => window.addEventListener('popstate', resolve, { once: true }));
+  window.history.forward();
+  await forward;
+  assert.equal(window.location.pathname, '/menu');
+  assert.equal(details.closest('.spa-view').inert, true);
+});
+
+test('routing respects native links and never caches undeclared routes', t => {
+  const dom = app();
+  t.after(() => dom.window.close());
+  const { window } = dom;
+  for (const { href, attributes = {}, options = {} } of [
+    { href: 'https://example.com' },
+    { href: '/logout' },
+    { href: '/menu?query=coffee' },
+    { href: '/menu#coffee' },
+    { href: '/menu', attributes: { target: '_blank' } },
+    { href: '/menu', attributes: { download: '' } },
+    { href: '/menu', options: { ctrlKey: true } },
+    { href: '/menu', options: { metaKey: true } },
+    { href: '/menu', options: { shiftKey: true } },
+    { href: '/menu', options: { altKey: true } },
+    { href: '/menu', options: { button: 1 } }
+  ]) {
+    const link = window.document.createElement('a');
+    link.href = href;
+    Object.entries(attributes).forEach(([key, value]) => link.setAttribute(key, value));
+    window.document.body.append(link);
+    let intercepted;
+    window.addEventListener('click', event => {
+      intercepted = event.defaultPrevented;
+      event.preventDefault(); // Suppress jsdom's unsupported native navigation.
+    }, { once: true });
+    link.dispatchEvent(new window.MouseEvent('click', { bubbles: true, cancelable: true, ...options }));
+    assert.equal(intercepted, false, href);
+    link.remove();
+  }
+  assert.equal(window.location.pathname, '/');
+  assert.equal(window.document.querySelectorAll('.spa-view').length, 1);
+});
