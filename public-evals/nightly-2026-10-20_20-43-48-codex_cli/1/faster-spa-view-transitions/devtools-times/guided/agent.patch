\ No newline at end of file
+}
+
+/* Retain inactive views' DOM and rendering state without reserving page space. */
+.spa-view[data-inactive] {
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0 0 auto;
+  block-size: 0;
+  overflow: clip;
+  pointer-events: none;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view[data-inactive] {
+    display: none;
+  }
+}
diff --git a/tests/view-cache.test.mjs b/tests/view-cache.test.mjs
new file mode 100644
index 0000000..f56719c
--- /dev/null
+++ b/tests/view-cache.test.mjs
@@ -0,0 +1,122 @@
+import assert from "node:assert/strict";
+import { afterEach, test } from "node:test";
+import { JSDOM } from "jsdom";
+
+let dom;
+let instance = 0;
+afterEach(() => {
+  dom?.window.close();
+  delete globalThis.document;
+});
+
+function markup(key, cache = true) {
+  return `<main data-view-cache data-astro-transition-persist="view-cache">
+    <div class="spa-view" data-view-key="${key}" data-cache-view="${cache}" tabindex="-1">
+      <input aria-label="Draft"><button>Count</button>
+    </div>
+  </main>`;
+}
+
+async function setup(key = "/devtools-times/") {
+  dom = new JSDOM(markup(key), { url: "https://example.com/devtools-times/" });
+  globalThis.document = dom.window.document;
+  // Isolate each cache instance while importing the production implementation.
+  await import(`../src/scripts/view-cache.ts?test=${instance++}`);
+}
+
+function navigate(key, cache = true) {
+  const newDocument = new dom.window.DOMParser().parseFromString(markup(key, cache), "text/html");
+  const fresh = newDocument.querySelector(".spa-view");
+  const event = new dom.window.Event("astro:before-swap");
+  event.newDocument = newDocument;
+  let swaps = 0;
+  // Model Astro's documented persistence contract: the old host replaces the
+  // fetched placeholder, retaining its existing subtree during the body swap.
+  event.swap = () => {
+    swaps++;
+    const host = document.querySelector("[data-view-cache]");
+    newDocument.querySelector("[data-view-cache]").replaceWith(host);
+    document.body.replaceWith(newDocument.body);
+  };
+  document.dispatchEvent(event);
+  event.swap();
+  assert.equal(swaps, 1, "Astro's original swap still runs exactly once");
+  return { fresh, active: document.querySelector(".spa-view:not([data-inactive])") };
+}
+
+test("revisiting restores the exact nodes, input values, and event listeners", async () => {
+  await setup();
+  const original = document.querySelector(".spa-view");
+  const input = original.querySelector("input");
+  input.value = "Keep this draft";
+  let clicks = 0;
+  original.querySelector("button").addEventListener("click", () => clicks++);
+
+  const { active: next } = navigate("/devtools-times/reports");
+  assert.equal(original.isConnected, true);
+  assert.equal(original.inert, true);
+  assert.equal(original.getAttribute("aria-hidden"), "true");
+  assert.equal(document.activeElement, next);
+
+  const { active, fresh } = navigate("/devtools-times/");
+  assert.equal(active, original);
+  assert.equal(active.inert, false);
+  assert.equal(active.hasAttribute("aria-hidden"), false);
+  assert.equal(document.activeElement, original);
+  assert.equal(input.value, "Keep this draft");
+  active.querySelector("button").click();
+  assert.equal(clicks, 1);
+  assert.equal(fresh.isConnected, false);
+  assert.equal(document.querySelectorAll(".spa-view:not([data-inactive])").length, 1);
+});
+
+test("evicts the least recently used view and rebuilds it on its next visit", async () => {
+  await setup("/a");
+  const oldest = document.querySelector(".spa-view");
+  const b = navigate("/b").active;
+  navigate("/c");
+  navigate("/d");
+  navigate("/e");
+  navigate("/b"); // Refresh B's recency, so A is evicted first.
+  navigate("/f");
+  assert.equal(document.querySelectorAll(".spa-view").length, 5);
+  assert.equal(oldest.isConnected, false);
+  assert.equal(b.isConnected, true);
+  const { active, fresh } = navigate("/a");
+  assert.equal(active, fresh);
+  assert.notEqual(active, oldest);
+});
+
+test("keeps query variants separate and reuses the same route for fragment navigation", async () => {
+  await setup("/reports?sort=new");
+  const first = document.querySelector(".spa-view");
+  assert.notEqual(navigate("/reports?sort=old").active, first);
+  assert.equal(navigate("/reports?sort=new").active, first);
+  assert.equal(navigate("/reports?sort=new").active, first);
+  assert.equal(document.querySelectorAll(".spa-view").length, 2);
+});
+
+test("discards opted-out forms after leaving and pauses inactive media", async () => {
+  await setup("/a");
+  const original = document.querySelector(".spa-view");
+  const video = document.createElement("video");
+  let paused = 0;
+  video.pause = () => paused++;
+  original.append(video);
+  const form = navigate("/signin", false).active;
+  form.querySelector("input").value = "secret";
+  assert.equal(paused, 1);
+  navigate("/a");
+  assert.equal(form.isConnected, false);
+  assert.notEqual(navigate("/signin", false).active, form);
+});
+
+test("leaves Astro's swap untouched for pages without a cache host", async () => {
+  await setup();
+  const event = new dom.window.Event("astro:before-swap");
+  event.newDocument = new dom.window.DOMParser().parseFromString("<p>Other layout</p>", "text/html");
+  const swap = () => {};
+  event.swap = swap;
+  document.dispatchEvent(event);
+  assert.equal(event.swap, swap);
+});
