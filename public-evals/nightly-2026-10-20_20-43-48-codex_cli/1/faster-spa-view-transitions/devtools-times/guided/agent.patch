diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..5456064
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,64 @@
+import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+// Includes the active view. Map insertion order tracks least-recently-used views.
+const MAX_VIEWS = 5;
+const views = new Map<string, HTMLElement>();
+
+function remember(view: HTMLElement) {
+  const key = view.dataset.viewKey!;
+  views.delete(key);
+  views.set(key, view);
+}
+
+const initialView = document.querySelector<HTMLElement>("[data-view-cache] > .spa-view");
+if (initialView) remember(initialView);
+
+document.addEventListener("astro:before-swap", (event: TransitionBeforeSwapEvent) => {
+  const host = document.querySelector<HTMLElement>("[data-view-cache]");
+  const incoming = event.newDocument.querySelector<HTMLElement>("[data-view-cache] > .spa-view");
+  if (!host || !incoming) {
+    // Other layouts use Astro's normal swap and end this cache's lifetime.
+    views.clear();
+    return;
+  }
+  const current = host.querySelector<HTMLElement>(".spa-view:not([data-inactive])");
+  if (current) remember(current);
+
+  const swap = event.swap;
+  event.swap = () => {
+    // The normal Astro swap preserves the host and its islands, and handles
+    // document metadata, scripts, history, and route announcements as usual.
+    swap();
+
+    const key = incoming.dataset.viewKey!;
+    const target = views.get(key) ?? incoming;
+    for (const view of views.values()) {
+      if (view === target) continue;
+      if (view.dataset.cacheView === "false") {
+        views.delete(view.dataset.viewKey!);
+        view.remove();
+        continue;
+      }
+      view.setAttribute("data-inactive", "");
+      view.setAttribute("aria-hidden", "true");
+      view.inert = true;
+      // Retained media should not continue playing while its view is inactive.
+      view.querySelectorAll<HTMLMediaElement>("audio, video").forEach((media) => media.pause());
+    }
+
+    if (target === incoming) host.append(target);
+    target.removeAttribute("data-inactive");
+    target.removeAttribute("aria-hidden");
+    target.inert = false;
+    remember(target);
+
+    while (views.size > MAX_VIEWS) {
+      const oldestKey = views.keys().next().value!;
+      views.get(oldestKey)!.remove();
+      views.delete(oldestKey);
+    }
+
+    // Astro restores scroll after this callback, including Back/Forward and hashes.
+    target.focus({ preventScroll: true });
+  };
+});
