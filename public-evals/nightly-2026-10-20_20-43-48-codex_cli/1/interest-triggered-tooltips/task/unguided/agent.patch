+      visibility: hidden;
+      opacity: 0;
+      z-index: 10;
+    }
+
+    /* Bridge the gap so the tooltip stays open when hovered. */
+    .details-tooltip::after {
+      content: '';
+      position: absolute;
+      top: 100%;
+      left: 0;
+      width: 100%;
+      height: 8px;
+      background: linear-gradient(135deg, var(--primary) 50%, transparent 50%)
+        center top / 8px 8px no-repeat;
+    }
+
+    .details-tooltip strong,
+    .details-tooltip span {
+      display: block;
+    }
+
+    .details-trigger:not(.is-dismissed):hover .details-tooltip,
+    .details-trigger:not(.is-dismissed):focus-within .details-tooltip {
+      visibility: visible;
+      opacity: 1;
+    }
+
+    .details-trigger .btn:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
