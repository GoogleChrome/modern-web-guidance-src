+@layer base{.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}}
+@layer components{.brand-icon svg{width:32px;height:36px;stroke-width:1.5}.site-footer .brand-icon svg{width:27px;height:30px}}
+@layer responsive{@media(max-width:800px){.brand-icon svg{width:26px;height:30px}}}
