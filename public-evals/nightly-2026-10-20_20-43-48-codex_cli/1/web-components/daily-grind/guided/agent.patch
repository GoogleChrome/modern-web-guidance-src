+import { escapeHTML as esc, hydrateIcons, productCard, button, Modal } from './components.js';
+
+const products = [
+  { id:'maple', name:'Maple Oat Latte', price:5.50, category:'seasonal', badge:'A taste of the season', image:'assets/maple-latte.jpg', alt:'Creamy iced latte in a tall glass', description:'Espresso, creamy oat milk & a little Vermont maple magic.', detail:'Our signature espresso meets smooth oat milk and real Vermont maple syrup. Comfort in a cup, finished with a little cinnamon.', options:true },
+  { id:'espresso', name:'Dark Roast Espresso', price:3.75, category:'coffee', badge:'For the purists', image:'assets/espresso.jpg', alt:'Rich dark espresso in a ceramic cup', description:'Deep, rich & beautifully bold. A little cup with a lot of soul.', detail:'A double shot of our small-batch house roast. Expect dark chocolate, toasted hazelnut, and a smooth, lingering finish.', options:false },
+  { id:'cold', name:'Signature Cold Brew', price:4.75, category:'coffee', badge:'A daily essential', image:'assets/cold-brew.jpg', alt:'A glass of cold coffee served over ice', description:'Slow-steeped for 18 hours. Smooth from first sip to last.', detail:'Patiently steeped in cold water for 18 hours to bring out a naturally sweet, chocolatey flavor. Served over ice for an easy afternoon ritual.', options:true },
+  { id:'croissant', name:'Butter Croissant', price:3.95, category:'bakery', badge:'Fresh from the oven', image:'assets/croissant.jpg', alt:'Golden, flaky butter croissants', description:'Golden, flaky layers. Made for tearing, sharing & coffee.', detail:'A classic all-butter croissant, baked until golden with a soft center and crisp, delicate layers. Contains wheat, dairy, and eggs.', options:false },
+  { id:'cinnamon', name:'Cinnamon Morning Bun', price:4.50, category:'bakery', badge:'A cozy little treat', image:'assets/morning-bun.jpg', alt:'Freshly baked cinnamon pastries', description:'A soft cinnamon swirl with a sweet, buttery finish.', detail:'Our soft morning bun is rolled with cinnamon sugar and finished with a light vanilla glaze. Contains wheat, dairy, and eggs.', options:false }
+];
+const currency = amount => `$${amount.toFixed(2)}`;
+const modal = new Modal(document.querySelector('#app-dialog'));
+let bag = [];
+try {
+  const saved = JSON.parse(localStorage.getItem('daily-grind-bag') || '[]');
+  if (Array.isArray(saved)) bag = saved.filter(item => products.some(p => p.id === item.id) && Number.isInteger(item.quantity) && item.quantity > 0 && item.quantity < 100 && ['Regular','Large'].includes(item.size) && ['Hot','Iced','As served'].includes(item.style));
+} catch { /* Storage may be unavailable; the bag still works for this visit. */ }
+let toastTimer;
+function notify(message) {
+  const toast = document.querySelector('#toast');
+  toast.textContent = message; toast.classList.add('visible');
+  clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('visible'), 3000);
+}
+function saveBag() {
+  try { localStorage.setItem('daily-grind-bag', JSON.stringify(bag)); } catch { /* Private mode fallback. */ }
+  document.querySelector('.bag-count').textContent = bag.reduce((sum, item) => sum + item.quantity, 0);
+}
+function addToBag(id, size = 'Regular', style = 'As served') {
+  const product = products.find(p => p.id === id);
+  if (!product) return;
+  const existing = bag.find(item => item.id === id && item.size === size && item.style === style);
+  if (existing && existing.quantity >= 99) { notify('You can add up to 99 of each item.'); return; }
+  if (existing) existing.quantity += 1; else bag.push({id, size, style, quantity:1});
+  saveBag(); notify(`${product.name} added to your bag`);
+}
+function renderProducts(filter = 'seasonal') {
+  const selection = filter === 'seasonal' ? products.slice(0,3) : products.filter(p => p.category === filter);
+  document.querySelector('#products').innerHTML = selection.map(productCard).join('');
+  document.querySelectorAll('[data-filter]').forEach(el => {
+    const selected = el.dataset.filter === filter;
+    el.classList.toggle('active', selected); el.setAttribute('aria-pressed', selected);
+  });
+}
+function showProduct(id) {
+  const product = products.find(p => p.id === id);
+  if (!product) return;
+  modal.open(product.name, `<img class="dialog-image" src="${product.image}" alt="${esc(product.alt)}"><p>${esc(product.detail)}</p><form id="product-form" data-id="${product.id}">${product.options ? '<div class="choice-row"><label>Size<select name="size"><option>Regular</option><option value="Large">Large (+$0.75)</option></select></label><label>Your way<select name="style"><option>Hot</option><option>Iced</option></select></label></div>' : ''}${button({label:`Add to bag · ${currency(product.price)}`, type:'submit'})}</form>`);
+  const form = document.querySelector('#product-form');
+  form.addEventListener('change', () => { form.querySelector('button').innerHTML = `Add to bag · ${currency(product.price + (form.elements.size?.value === 'Large' ? .75 : 0))}`; });
+  form.addEventListener('submit', event => {
+    event.preventDefault(); addToBag(id, form.elements.size?.value || 'Regular', form.elements.style?.value || 'As served'); modal.close();
+  });
+  if (id === 'cold') form.elements.style.value = 'Iced';
+}
+function showBag() {
+  const total = bag.reduce((sum, item) => sum + (products.find(p => p.id === item.id).price + (item.size === 'Large' ? .75 : 0)) * item.quantity, 0);
+  const rows = bag.map((item,index) => {
+    const p = products.find(p => p.id === item.id);
+    return `<div class="bag-row"><img src="${p.image}" alt=""><div><h3>${esc(p.name)}</h3><p>${esc(item.size)}${item.style === 'As served' ? '' : ` · ${esc(item.style)}`} · ${currency(p.price + (item.size === 'Large' ? .75 : 0))}</p><div class="quantity-controls"><button data-quantity="${index}" data-change="-1" aria-label="Remove one ${esc(p.name)}">−</button><span>${item.quantity}</span><button data-quantity="${index}" data-change="1" aria-label="Add one ${esc(p.name)}">+</button></div></div></div>`;
+  }).join('');
+  modal.open('Your daily pick-me-up.', bag.length ? `${rows}<div class="bag-total"><span>Subtotal</span><span>${currency(total)}</span></div><p class="dialog-note">Your favorites are saved. Visit your neighborhood Daily Grind to order and pay. Online checkout is coming soon.</p>${button({label:'Find a café',action:'data-open="locations"'})}` : `<p>Your bag is waiting for something good. Explore the menu and find your new favorite.</p>${button({label:'Explore the menu',action:'data-close-menu'})}`);
+}
+function showRewards() {
+  modal.open('Your daily ritual, rewarded.', `<p>Join the good company. Get a free first drink, birthday treats, and something to look forward to every day.</p><form id="rewards-form"><label>Your name<input name="name" autocomplete="given-name" required maxlength="60" placeholder="First name"></label><label>Email address<input name="email" type="email" autocomplete="email" required placeholder="you@example.com"></label>${button({label:'Join Daily Rewards',type:'submit'})}<p class="dialog-note">This preview saves your interest on this device. Rewards enrollment will be available when we launch.</p></form>`);
+  document.querySelector('#rewards-form').addEventListener('submit', event => {
+    event.preventDefault();
+    const form = new FormData(event.target);
+    try { localStorage.setItem('daily-grind-rewards-interest', JSON.stringify({name:form.get('name'),email:form.get('email')})); } catch { /* Optional persistence. */ }
+    modal.open('You’re in good company.', `<span class="success-symbol" aria-hidden="true">✧</span><p>Thanks, ${esc(form.get('name'))}! Your interest has been saved on this device. Our full rewards program is coming soon.</p>${button({label:'Back to the good stuff',action:'data-close-menu'})}`);
+  });
+}
+function openPanel(name) {
+  if (name === 'bag') return showBag();
+  if (name === 'rewards') return showRewards();
+  if (name === 'locations') return modal.open('Find your Daily Grind.', `<p>Slow down. Stay a while. There’s a little good company waiting for you.</p><div class="location-card"><h3>The Neighborhood Café</h3><p>124 Maple Street · Portland, OR</p><p>Monday–Friday · 7am–6pm<br>Saturday–Sunday · 8am–5pm</p></div><div class="location-card"><h3>The Roastery</h3><p>38 Oak Avenue · Portland, OR</p><p>Monday–Saturday · 7am–4pm<br>Sunday · 8am–2pm</p></div><p class="dialog-note">Illustrative café locations for this site preview.</p>`);
+  if (name === 'account') return modal.open('Hello, good company.', `<p>Your daily coffee ritual starts here. Join Daily Rewards to hear about what’s brewing.</p>${button({label:'Discover Daily Rewards',action:'data-open="rewards"'})}<p class="dialog-note">Member accounts are coming soon. Your shopping bag is already saved on this device.</p>`);
+  if (name === 'story') return modal.open('Small batches. Big heart.', `<p>The Daily Grind started in 2014 with a simple idea: make good coffee and make people feel at home.</p><p>We seek out thoughtfully grown beans, roast them in small batches, and put care into every cup. But our favorite part has always been the people on the other side of the counter.</p><p>Whether it’s your first visit or your everyday stop, there’s a place for you here.</p>${button({label:'Find your neighborhood café',action:'data-open="locations"'})}`);
+  if (name === 'contact') return modal.open('Let’s talk over coffee.', '<p>Questions, kind words, or just want to say hello? We’d love to hear from you.</p><p><a class="text-link" href="mailto:hello@dailygrind.example">hello@dailygrind.example ↗</a></p><p class="dialog-note">Example contact address for this site preview.</p>');
+}
+document.addEventListener('click', event => {
+  const target = event.target.closest('button, a'); if (!target) return;
+  if (target.dataset.open) openPanel(target.dataset.open);
+  if (target.dataset.product) showProduct(target.dataset.product);
+  if (target.dataset.add) addToBag(target.dataset.add);
+  if (target.dataset.filter) renderProducts(target.dataset.filter);
+  if (target.hasAttribute('data-close-menu')) { modal.close(); document.querySelector('#menu').scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'}); }
+  if (target.dataset.quantity !== undefined) {
+    const index = Number(target.dataset.quantity);
+    bag[index].quantity = Math.min(99, bag[index].quantity + Number(target.dataset.change));
+    if (bag[index].quantity <= 0) bag.splice(index,1);
+    saveBag(); showBag();
+  }
+});
+document.querySelector('#full-menu').addEventListener('click', () => {
+  document.querySelector('#products').innerHTML = products.map(productCard).join('');
+  document.querySelectorAll('[data-filter]').forEach(el => { el.classList.remove('active'); el.setAttribute('aria-pressed','false'); });
+});
+hydrateIcons(); renderProducts(); saveBag();
