+/** Shared rendering primitives. Values passed into HTML must be escaped. */
+export const escapeHTML = value => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
+const paths = {
+  arrow: '<path d="M4 12h16m-6-6 6 6-6 6"/>',
+  bag: '<path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 8V5a3 3 0 0 1 6 0v3"/>',
+  user: '<circle cx="12" cy="7" r="3.5"/><path d="M5 21v-3a7 7 0 0 1 14 0v3"/>',
+  pin: '<path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10" r="2.5"/>',
+  leaf: '<path d="M20 3C10 2 3 6 4 13c1 7 13 8 16-10Z"/><path d="M3 22 15 9M8 16l-1-5m5 1 5 1"/>',
+  bean: '<path d="M18 4c5 4 2 12-3 15s-10 2-12-2S4 7 8 4s7-3 10 0Z"/><path d="M17 4c1 5-7 6-7 10s-4 5-6 4"/>',
+  cup: '<path d="M4 8h13v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8Zm13 1h2a3 3 0 1 1 0 6h-2M7 3v2m4-3v3m4-2v2M2 23h18"/>',
+  heart: '<path d="M20 5c-3-3-7-1-8 1-1-2-5-4-8-1-5 5 3 11 8 15 5-4 13-10 8-15Z"/>'
+};
+export function icon(name) { return `<svg viewBox="0 0 24 24" aria-hidden="true">${paths[name] || paths.cup}</svg>`; }
+export function hydrateIcons(root = document) { root.querySelectorAll('[data-icon]').forEach(el => { el.innerHTML = icon(el.dataset.icon); }); }
+export function button({label, action = '', variant = '', type = 'button'}) {
+  return `<button type="${escapeHTML(type)}" class="button ${escapeHTML(variant)}" ${action}>${escapeHTML(label)}${icon('arrow')}</button>`;
+}
+export function productCard(product) {
+  return `<article class="product-card"><img src="${escapeHTML(product.image)}" alt="${escapeHTML(product.alt)}" width="800" height="510" loading="lazy"><span class="badge ${product.badge === 'A daily essential' ? 'green' : ''}">${escapeHTML(product.badge)}</span><header><h3>${escapeHTML(product.name)}</h3><span class="price">$${product.price.toFixed(2)}</span></header><p>${escapeHTML(product.description)}</p><footer><button class="text-link" data-product="${escapeHTML(product.id)}">A closer look ${icon('arrow')}<span class="sr-only"> at ${escapeHTML(product.name)}</span></button><button class="add-button" data-add="${escapeHTML(product.id)}" aria-label="Add ${escapeHTML(product.name)} to your bag">+</button></footer></article>`;
+}
+export class Modal {
+  constructor(element) {
+    this.element = element;
+    this.content = element.querySelector('#dialog-content');
+    element.querySelector('[data-close]').addEventListener('click', () => element.close());
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      element.addEventListener('click', event => {
+        if (event.target !== element) return;
+        const {top, bottom, left, right} = element.getBoundingClientRect();
+        if (event.clientX < left || event.clientX > right || event.clientY < top || event.clientY > bottom) element.close();
+      });
+    }
+  }
+  open(title, body) {
+    this.content.innerHTML = `<h2 id="dialog-title">${escapeHTML(title)}</h2>${body}`;
+    if (!this.element.open) this.element.showModal();
+  }
+  close() { this.element.close(); }
+}
