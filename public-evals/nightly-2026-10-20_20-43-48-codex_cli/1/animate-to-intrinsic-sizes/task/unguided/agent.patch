+    /* Native disclosure controls keep both interactions JavaScript-free. */
+    summary {
+      cursor: pointer;
+      list-style: none;
+    }
+
+    summary::-webkit-details-marker {
+      display: none;
+    }
+
+    summary:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    details::details-content {
+      block-size: 0;
+      overflow: clip;
+      transition: block-size 350ms ease, content-visibility 350ms allow-discrete;
+    }
+
+    details[open]::details-content {
+      block-size: auto;
+    }
+
+    #promo-alert {
+      position: relative;
+      background: var(--accent);
+      color: var(--text);
+      block-size: auto;
+      overflow: clip;
+      transition: block-size 350ms ease;
+    }
+
+    #promo-alert:not([open]) {
+      block-size: 0;
+    }
+
+    .promo-message {
+      padding: 14px 64px;
+      text-align: center;
+      font-size: 0.9rem;
+    }
+
+    #alert-dismiss {
+      position: absolute;
+      inset-block-start: 4px;
+      inset-inline-end: 16px;
+      display: grid;
+      place-items: center;
+      width: 44px;
+      height: 44px;
+      border-radius: 5px;
+      font-size: 1.5rem;
+    }
+
+    #alert-dismiss:hover {
+      background: rgb(78 52 46 / 10%);
+    }
+
+    #promo-alert:not([open]) > summary {
+      visibility: hidden;
+    }
+
+    .faq {
+      max-width: 760px;
+      margin: 56px auto 0;
+    }
+
+    .faq h2 {
+      text-align: center;
+      margin-bottom: 20px;
+    }
+
+    .faq details {
+      background: white;
+      border: 1px solid var(--secondary);
+      border-radius: 8px;
+    }
+
+    #faq-trigger {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 20px;
+      padding: 20px 24px;
+      font-weight: 600;
+    }
+
+    #faq-trigger::after {
+      content: '+';
+      font-size: 1.5rem;
+      line-height: 1;
+      transition: transform 350ms ease;
+    }
+
+    details[open] > #faq-trigger::after {
+      transform: rotate(45deg);
+    }
+
+    #faq-content {
+      padding: 0 24px 24px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      details::details-content,
+      #promo-alert,
+      #faq-trigger::after {
+        transition: none;
+      }
+    }
