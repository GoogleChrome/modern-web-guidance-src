+  <template id="toast-template">
+    <div class="toast" popover="manual">
+      <span role="status" aria-live="polite" aria-atomic="true">added to cart!</span>
+      <button type="button" class="toast-close" aria-label="Close notification"
+        popovertargetaction="hide">&times;</button>
+    </div>
+  </template>
+
+  <script>
+    const toastTemplate = document.getElementById('toast-template');
+    let toastId = 0;
+
+    function showToast() {
+      const toast = toastTemplate.content.firstElementChild.cloneNode(true);
+      toast.id = `cart-toast-${++toastId}`;
+      toast.querySelector('.toast-close').setAttribute('popovertarget', toast.id);
+
+      let dismissTimer;
+      let removalTimer;
+      toast.addEventListener('beforetoggle', (event) => {
+        if (event.newState === 'closed') {
+          clearTimeout(dismissTimer);
+          // Keep the element alive for its CSS exit transition, then release it.
+          removalTimer = setTimeout(() => toast.remove(), 220);
+        }
+      });
+      toast.addEventListener('transitionend', (event) => {
+        if (event.target === toast && event.propertyName === 'opacity' &&
+            !toast.matches(':popover-open')) {
+          clearTimeout(removalTimer);
+          toast.remove();
+        }
+      });
+
+      document.body.append(toast);
+      toast.showPopover();
+      dismissTimer = setTimeout(() => toast.hidePopover(), 3000);
+    }
+
+    document.querySelectorAll('.toast-trigger').forEach((trigger) => {
+      trigger.addEventListener('click', showToast);
+    });
+  </script>
