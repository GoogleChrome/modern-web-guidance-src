+    /* Each manual popover has its own top-layer entry. Toasts are appended
+       directly to body, so the number of following siblings is its stack slot. */
+    .toast {
+      --toast-height: 64px;
+      --toast-gap: 12px;
+      position: fixed;
+      inset: auto 16px auto auto;
+      bottom: calc(16px + (sibling-count() - sibling-index()) *
+        (var(--toast-height) + var(--toast-gap)));
+      margin: 0;
+      width: min(320px, calc(100vw - 32px));
+      height: var(--toast-height);
+      padding: 14px 16px;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 18%);
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      opacity: 0;
+      translate: 24px 0;
+      transition: opacity 200ms ease, translate 200ms ease, bottom 200ms ease,
+        display 200ms allow-discrete, overlay 200ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      opacity: 1;
+      translate: 0 0;
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast-close {
+      flex: none;
+      width: 32px;
+      height: 32px;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 24px;
+      line-height: 1;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    .toast-close:focus-visible,
+    .toast-trigger:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        translate: 24px 0;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transition-duration: 0s;
+      }
+    }
+
