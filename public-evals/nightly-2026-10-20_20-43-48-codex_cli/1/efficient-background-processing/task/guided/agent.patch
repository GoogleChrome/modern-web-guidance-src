+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperature = document.getElementById('roast-temp-value');
+      const context = canvas.getContext('2d');
+      const beans = Array.from({ length: 36 }, (_, index) => ({
+        phase: index * 2.4,
+        radius: 34 + (index % 6) * 11,
+        speed: 0.7 + (index % 5) * 0.12
+      }));
+      let frameId = null;
+      let intervalId = null;
+      let previousTime = null;
+      let elapsed = 0;
+      let roastTemperature = 185;
+      let inViewport = false;
+      let renderingSkipped = false;
+      let pageActive = true;
+
+      function drawBeans() {
+        if (!context) return;
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        beans.forEach((bean, index) => {
+          const angle = elapsed * bean.speed + bean.phase;
+          const x = canvas.width / 2 + Math.cos(angle) * bean.radius * 4.5;
+          const y = canvas.height / 2 + Math.sin(angle) * bean.radius;
+          context.save();
+          context.translate(x, y);
+          context.rotate(angle + index);
+          context.scale(1, 0.65);
+          context.beginPath();
+          context.arc(0, 0, 15, 0, Math.PI * 2);
+          context.fillStyle = index % 2 ? '#a96b42' : '#c58a56';
+          context.fill();
+          context.beginPath();
+          context.moveTo(0, -12);
+          context.bezierCurveTo(-8, -3, 8, 3, 0, 12);
+          context.strokeStyle = '#4e342e';
+          context.lineWidth = 3;
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(time) {
+        if (previousTime !== null) elapsed += Math.min(time - previousTime, 50) / 1000;
+        previousTime = time;
+        drawBeans();
+        frameId = requestAnimationFrame(animate);
+      }
+
+      function stop() {
+        if (frameId !== null) cancelAnimationFrame(frameId);
+        if (intervalId !== null) clearInterval(intervalId);
+        frameId = null;
+        intervalId = null;
+        previousTime = null;
+      }
+
+      function syncActivity() {
+        if (!inViewport || renderingSkipped || document.hidden || !pageActive) {
+          stop();
+          return;
+        }
+        if (context && frameId === null) frameId = requestAnimationFrame(animate);
+        if (intervalId === null) {
+          intervalId = setInterval(() => {
+            roastTemperature = Math.max(180, Math.min(220, roastTemperature + (Math.random() - 0.4) * 3));
+            temperature.textContent = roastTemperature.toFixed(1);
+          }, 1000);
+        }
+      }
+
+      // Listen on the widget itself: rendering-state events may not bubble.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          renderingSkipped = event.skipped;
+          syncActivity();
+        });
+      }
+
+      // Also gate by actual viewport visibility: browsers can render offscreen
+      // content ahead of time. This doubles as the older-browser fallback.
+      function checkViewport() {
+        const rect = widget.getBoundingClientRect();
+        inViewport = rect.bottom > 0 && rect.top < window.innerHeight &&
+          rect.right > 0 && rect.left < window.innerWidth;
+        syncActivity();
+      }
+
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          const entry = entries[entries.length - 1];
+          inViewport = entry.isIntersecting && entry.intersectionRatio > 0;
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // No polling loop, even on browsers without IntersectionObserver.
+        window.addEventListener('scroll', checkViewport, { passive: true });
+        window.addEventListener('resize', checkViewport, { passive: true });
+        checkViewport();
+      }
+
+      document.addEventListener('visibilitychange', syncActivity);
+      window.addEventListener('pagehide', () => {
+        pageActive = false;
+        stop();
+      });
+      window.addEventListener('pageshow', () => {
+        pageActive = true;
+        checkViewport();
+      });
+    })();
+  </script>
+
