+  <script>
+    (function () {
+      var widget = document.getElementById('roasting-widget');
+      var canvas = document.getElementById('roast-canvas');
+      var temperatureValue = document.getElementById('roast-temp-value');
+      var context = canvas.getContext('2d');
+      var frameId = null;
+      var intervalId = null;
+      var running = false;
+      var inView = false;
+      var renderingSkipped = false;
+      var pageActive = true;
+      var lastFrameTime = null;
+      var elapsed = 0;
+      var temperature = 180;
+      var beans = [];
+
+      for (var i = 0; i < 48; i++) {
+        beans.push({
+          phase: Math.random() * Math.PI * 2,
+          speed: 0.6 + Math.random() * 0.8,
+          radius: 0.25 + Math.random() * 0.7,
+          size: 9 + Math.random() * 6
+        });
+      }
+
+      function draw(time) {
+        if (!running) return;
+        if (lastFrameTime !== null) elapsed += Math.min(time - lastFrameTime, 50) / 1000;
+        lastFrameTime = time;
+
+        context.clearRect(0, 0, canvas.width, canvas.height);
+        beans.forEach(function (bean) {
+          var angle = bean.phase + elapsed * bean.speed;
+          var x = canvas.width / 2 + Math.cos(angle) * canvas.width * 0.44 * bean.radius;
+          var y = canvas.height / 2 + Math.sin(angle) * canvas.height * 0.35 * bean.radius;
+          context.save();
+          context.translate(x, y);
+          context.rotate(angle * 2);
+          context.scale(1, 0.65);
+          context.beginPath();
+          context.arc(0, 0, bean.size, 0, Math.PI * 2);
+          context.fillStyle = 'hsl(24, 45%, ' + (40 - (temperature - 180) * 0.3) + '%)';
+          context.fill();
+          context.beginPath();
+          context.moveTo(-bean.size * 0.7, 0);
+          context.bezierCurveTo(0, -5, 0, 5, bean.size * 0.7, 0);
+          context.strokeStyle = '#29170f';
+          context.lineWidth = 2;
+          context.stroke();
+          context.restore();
+        });
+        frameId = window.requestAnimationFrame(draw);
+      }
+
+      // All visibility signals share one lifecycle so repeated events cannot
+      // create duplicate animation loops or temperature intervals.
+      function syncActivity() {
+        var shouldRun = inView && !renderingSkipped && !document.hidden && pageActive;
+        if (shouldRun === running) return;
+        running = shouldRun;
+
+        if (running) {
+          lastFrameTime = null;
+          if (context) frameId = window.requestAnimationFrame(draw);
+          intervalId = window.setInterval(function () {
+            temperature += 1;
+            if (temperature > 220) temperature = 180;
+            temperatureValue.textContent = temperature;
+          }, 1000);
+        } else {
+          if (frameId !== null) window.cancelAnimationFrame(frameId);
+          if (intervalId !== null) window.clearInterval(intervalId);
+          frameId = null;
+          intervalId = null;
+          lastFrameTime = null;
+        }
+      }
+
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', function (event) {
+          if (event.target !== widget) return;
+          renderingSkipped = event.skipped;
+          syncActivity();
+        });
+      }
+
+      // Also track actual intersection: native rendering may continue a little
+      // beyond the viewport. This works without rendering-state events too.
+      function checkViewport() {
+        var rect = widget.getBoundingClientRect();
+        inView = rect.bottom > 0 && rect.right > 0 &&
+          rect.top < (window.innerHeight || document.documentElement.clientHeight) &&
+          rect.left < (window.innerWidth || document.documentElement.clientWidth);
+        syncActivity();
+      }
+
+      if ('IntersectionObserver' in window) {
+        var observer = new IntersectionObserver(function (entries) {
+          inView = entries[entries.length - 1].isIntersecting;
+          syncActivity();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Legacy fallback has no polling timer and catches nested scrolling.
+        window.addEventListener('scroll', checkViewport, true);
+        window.addEventListener('resize', checkViewport);
+        checkViewport();
+      }
+
+      document.addEventListener('visibilitychange', function () {
+        if (!document.hidden && !('IntersectionObserver' in window)) checkViewport();
+        syncActivity();
+      });
+      window.addEventListener('pagehide', function () {
+        pageActive = false;
+        syncActivity();
+      });
+      window.addEventListener('pageshow', function () {
+        pageActive = true;
+        checkViewport();
+      });
+    }());
+  </script>
+
