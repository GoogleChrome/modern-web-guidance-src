   </style>
+  <script>
+    // Register before the first reveal, including restores from the back/forward cache.
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    if (!motionPreference.matches) {
+      function applyTransitionType(transition, activation) {
+        if (!transition) return;
+        if (motionPreference.matches) {
+          transition.skipTransition();
+          return;
+        }
+        if (!transition.types || !activation?.from || !activation?.entry) return;
+
+        const from = new URL(activation.from.url);
+        const to = new URL(activation.entry.url);
+        if (from.origin !== to.origin || from.pathname !== to.pathname) return;
+
+        const fromPage = Number(from.searchParams.get('page') || 1);
+        const toPage = Number(to.searchParams.get('page') || 1);
+        if (toPage > fromPage) transition.types.add('next');
+        if (toPage < fromPage) transition.types.add('previous');
+      }
+
+      window.addEventListener('pageswap', (event) => {
+        applyTransitionType(event.viewTransition, event.activation);
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        applyTransitionType(event.viewTransition, window.navigation?.activation);
+      });
+    }
+  </script>
 </head>
 
