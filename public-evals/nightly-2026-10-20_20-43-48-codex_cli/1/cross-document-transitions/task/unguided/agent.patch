+  <script>
+    const favoritePages = [
+      null, // The first page is rendered in the HTML above.
+      [
+        ['Pumpkin Spice Latte', 'Espresso, pumpkin spice, and silky steamed milk.', '/menu/seasonal'],
+        ['Cinnamon Cappuccino', 'Rich espresso topped with cinnamon-dusted milk foam.', '/menu/espresso'],
+        ['Vanilla Cream Cold Brew', 'Slow-steeped coffee finished with vanilla cream.', '/menu/cold-brew'],
+      ],
+      [
+        ['Salted Caramel Latte', 'Buttery caramel and espresso with a touch of sea salt.', '/menu/seasonal'],
+        ['Maple Flat White', 'Velvety microfoam and espresso with a splash of maple.', '/menu/espresso'],
+        ['Spiced Cold Brew', 'Our smooth cold brew with warming seasonal spices.', '/menu/cold-brew'],
+      ],
+    ];
+    const requestedPage = Number(new URL(location.href).searchParams.get('page') || 1);
+    const currentPage = Number.isInteger(requestedPage)
+      ? Math.min(favoritePages.length, Math.max(1, requestedPage)) : 1;
+
+    if (currentPage > 1) {
+      const cards = document.querySelectorAll('.grid .card');
+      favoritePages[currentPage - 1].forEach(([name, description, href], index) => {
+        cards[index].querySelector('h3').textContent = name;
+        cards[index].querySelector('p').textContent = description;
+        cards[index].querySelector('a').href = href;
+      });
+    }
+
+    document.getElementById('page-status').textContent = `Page ${currentPage} of ${favoritePages.length}`;
+    for (const [id, targetPage] of [['previous', currentPage - 1], ['next', currentPage + 1]]) {
+      const link = document.getElementById(id);
+      const disabled = targetPage < 1 || targetPage > favoritePages.length;
+      const target = new URL(location.href);
+      target.searchParams.set('page', String(Math.min(favoritePages.length, Math.max(1, targetPage))));
+      link.href = target.href;
+      if (disabled) {
+        link.setAttribute('aria-disabled', 'true');
+        link.tabIndex = -1;
+        link.addEventListener('click', (event) => event.preventDefault());
+      } else {
+        link.removeAttribute('aria-disabled');
+        link.removeAttribute('tabindex');
+      }
+    }
+  </script>
