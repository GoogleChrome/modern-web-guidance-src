+  <script>
+    const canvas = document.getElementById('canvas');
+    const stage = document.querySelector('.cup-stage');
+    const form = document.getElementById('coffee-form');
+    const milk = document.getElementById('coffee-milk');
+    const syrup = document.getElementById('coffee-syrup');
+    const preview = document.getElementById('recipe-preview');
+    const status = document.getElementById('recipe-status');
+    const context = canvas.getContext('2d');
+    if (context) stage.classList.add('has-canvas');
+
+    function drawCup() {
+      if (!context) return;
+      const bounds = stage.getBoundingClientRect();
+      const cup = form.getBoundingClientRect();
+      if (!bounds.width || !bounds.height) return;
+      const ratio = window.devicePixelRatio || 1;
+      canvas.width = Math.round(bounds.width * ratio);
+      canvas.height = Math.round(bounds.height * ratio);
+      // Draw in CSS pixels; the backing bitmap uses physical display pixels.
+      context.setTransform(canvas.width / bounds.width, 0, 0, canvas.height / bounds.height, 0, 0);
+      const x = cup.left - bounds.left;
+      const y = cup.top - bounds.top;
+      const width = cup.width;
+      const height = cup.height;
+      const handleWidth = Math.min(58, bounds.width - x - width - 9);
+
+      context.fillStyle = 'rgba(78, 52, 46, 0.10)';
+      context.beginPath();
+      context.ellipse(x + width / 2 + 8, y + height + 13, width / 2 + 10, 12, 0, 0, Math.PI * 2);
+      context.fill();
+
+      context.strokeStyle = '#cbb6a3';
+      context.lineWidth = 15;
+      context.beginPath();
+      context.ellipse(x + width - 2, y + height * 0.48, handleWidth, height * 0.19, 0, -Math.PI / 2, Math.PI / 2);
+      context.stroke();
+      context.strokeStyle = '#fffaf3';
+      context.lineWidth = 9;
+      context.stroke();
+
+      context.fillStyle = '#fffaf3';
+      context.strokeStyle = '#cbb6a3';
+      context.lineWidth = 2;
+      context.beginPath();
+      context.roundRect(x - 2, y - 4, width + 4, height + 7, [12, 12, 30, 30]);
+      context.fill();
+      context.stroke();
+
+      context.fillStyle = '#5d3a29';
+      context.beginPath();
+      context.ellipse(x + width / 2, y + 5, width / 2 + 2, 17, 0, 0, Math.PI * 2);
+      context.fill();
+      context.strokeStyle = '#e1c6a5';
+      context.lineWidth = 5;
+      context.stroke();
+    }
+
+    function updateRecipe() {
+      const milkText = milk.selectedOptions[0].textContent.toLocaleLowerCase();
+      const syrupText = syrup.selectedOptions[0].textContent.toLocaleLowerCase();
+      preview.textContent = `Espresso with ${milkText} and ${syrupText}.`;
+      status.textContent = '';
+    }
+
+    milk.addEventListener('change', updateRecipe);
+    syrup.addEventListener('change', updateRecipe);
+    form.addEventListener('input', () => { status.textContent = ''; });
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = document.getElementById('coffee-name');
+      if (!name.value.trim()) {
+        name.setCustomValidity('Please enter your name.');
+        name.reportValidity();
+        return;
+      }
+      status.textContent = `Recipe created for ${name.value.trim()}! ${preview.textContent}`;
+    });
+    document.getElementById('coffee-name').addEventListener('input', (event) => event.target.setCustomValidity(''));
+
+    // Measuring the real form also handles text wrapping and browser translation.
+    const observer = new ResizeObserver(drawCup);
+    observer.observe(stage);
+    observer.observe(form);
+    window.addEventListener('resize', drawCup);
+    // Re-arm the query when moving between displays with different pixel ratios.
+    function watchPixelRatio() {
+      const query = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+      query.addEventListener('change', () => {
+        drawCup();
+        watchPixelRatio();
+      }, { once: true });
+    }
+    watchPixelRatio();
+    drawCup();
+  </script>
+
