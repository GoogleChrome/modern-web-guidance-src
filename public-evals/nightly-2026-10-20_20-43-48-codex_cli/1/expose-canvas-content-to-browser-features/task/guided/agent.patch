+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('coffee-stage');
+      const form = document.getElementById('coffee-form');
+      const name = document.getElementById('coffee-name');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const summary = document.getElementById('coffee-summary');
+      const status = document.getElementById('coffee-status');
+      const ctx = canvas.getContext('2d');
+      let nativeHTML = !!ctx && 'content' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function' && typeof canvas.requestPaint === 'function';
+
+      // Unsupported browsers keep the very same form above the decorative canvas.
+      if (nativeHTML) canvas.append(form);
+      else canvas.setAttribute('aria-hidden', 'true');
+
+      function useOverlay() {
+        nativeHTML = false;
+        canvas.onpaint = null;
+        stage.append(form);
+        canvas.setAttribute('aria-hidden', 'true');
+        stage.style.height = '';
+      }
+
+      function drawCup() {
+        if (!ctx) return;
+        const width = canvas.clientWidth;
+        const height = canvas.clientHeight;
+        if (!width || !height) return;
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        // All drawing coordinates are CSS pixels; the backing store is device pixels.
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+        const cupWidth = form.offsetWidth + 36;
+        const left = (width - cupWidth) / 2;
+        const right = left + cupWidth;
+        const bottom = height - 52;
+
+        ctx.fillStyle = '#d4c1b3';
+        ctx.beginPath();
+        ctx.ellipse(width / 2, bottom + 14, cupWidth / 2 + 16, 17, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.strokeStyle = '#fffdf8';
+        ctx.lineWidth = 16;
+        ctx.beginPath();
+        ctx.ellipse(right - 3, 205, 26, 55, 0, 0, Math.PI * 2);
+        ctx.stroke();
+        ctx.fillStyle = '#fffdf8';
+        ctx.beginPath();
+        ctx.moveTo(left, 112);
+        ctx.lineTo(right, 112);
+        ctx.lineTo(right - 12, bottom - 22);
+        ctx.quadraticCurveTo(width / 2, bottom + 20, left + 12, bottom - 22);
+        ctx.closePath();
+        ctx.fill();
+        ctx.beginPath();
+        ctx.ellipse(width / 2, 112, cupWidth / 2, 25, 0, 0, Math.PI * 2);
+        ctx.fill();
+        const coffeeColors = { whole: '#ad7951', oat: '#bf946c', almond: '#bd8a60', soy: '#b48a66' };
+        ctx.fillStyle = coffeeColors[milk.value];
+        ctx.beginPath();
+        ctx.ellipse(width / 2, 112, cupWidth / 2 - 10, 17, 0, 0, Math.PI * 2);
+        ctx.fill();
+        ctx.strokeStyle = '#bca18e';
+        ctx.lineWidth = 3;
+        ctx.lineCap = 'round';
+        for (const offset of [-24, 0, 24]) {
+          ctx.beginPath();
+          ctx.moveTo(width / 2 + offset, 73);
+          ctx.bezierCurveTo(width / 2 + offset - 12, 59, width / 2 + offset + 12, 49, width / 2 + offset, 35);
+          ctx.stroke();
+        }
+      }
+
+      function render() {
+        if (nativeHTML) canvas.requestPaint();
+        else drawCup();
+      }
+
+      canvas.onpaint = () => {
+        drawCup();
+        try {
+          // This also synchronizes native clicks, selection, focus and accessibility bounds.
+          ctx.drawElementImage(form, (canvas.clientWidth - form.offsetWidth) / 2, 145);
+        } catch (error) {
+          useOverlay();
+          resize();
+        }
+      };
+
+      function resize(entry) {
+        if (!ctx) return;
+        form.style.width = Math.min(520, Math.max(0, stage.clientWidth - 100)) + 'px';
+        if (nativeHTML) stage.style.height = (form.offsetHeight + 240) + 'px';
+        const pixels = entry?.devicePixelContentBoxSize?.[0];
+        const width = pixels?.inlineSize ?? Math.round(canvas.clientWidth * window.devicePixelRatio);
+        const height = pixels?.blockSize ?? Math.round(canvas.clientHeight * window.devicePixelRatio);
+        if (canvas.width !== width) canvas.width = width;
+        if (canvas.height !== height) canvas.height = height;
+        render();
+      }
+
+      if ('ResizeObserver' in window) {
+        const canvasObserver = new ResizeObserver(([entry]) => resize(entry));
+        const devicePixels = 'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+        canvasObserver.observe(canvas, devicePixels ? { box: 'device-pixel-content-box' } : {});
+        // Translation, zoom, and status messages may change the form's height.
+        new ResizeObserver(() => resize()).observe(form);
+      }
+      window.addEventListener('resize', () => resize());
+      // Also catch moving the window between monitors with different pixel densities.
+      let density;
+      function watchDensity() {
+        density?.removeEventListener('change', densityChanged);
+        density = matchMedia(`(resolution: ${window.devicePixelRatio}dppx)`);
+        density.addEventListener('change', densityChanged);
+      }
+      function densityChanged() { resize(); watchDensity(); }
+      watchDensity();
+
+      form.addEventListener('input', () => {
+        summary.textContent = `${milk.selectedOptions[0].textContent} · ${syrup.selectedOptions[0].textContent}`;
+        status.textContent = '';
+        render();
+      });
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        status.textContent = name.value.trim()
+          ? `${name.value.trim()}, your latte is customized with ${summary.textContent}.`
+          : `Your latte is customized with ${summary.textContent}.`;
+        resize();
+      });
+      resize();
+      // Printing real HTML preserves readable, selectable content in both paths.
+      window.addEventListener('beforeprint', () => { if (nativeHTML) useOverlay(); });
+    })();
+  </script>
