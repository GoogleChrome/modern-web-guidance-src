+  <script>
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const registrationStatus = document.getElementById('registration-status');
+
+    function decodeBase64url(value) {
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
+      const binary = atob(base64.padEnd(Math.ceil(base64.length / 4) * 4, '='));
+      return Uint8Array.from(binary, character => character.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      const bytes = value instanceof ArrayBuffer
+        ? new Uint8Array(value)
+        : new Uint8Array(value.buffer, value.byteOffset, value.byteLength);
+      let binary = '';
+      for (const byte of bytes) binary += String.fromCharCode(byte);
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    function serializeExtensions(value) {
+      if (value instanceof ArrayBuffer || ArrayBuffer.isView(value)) {
+        return encodeBase64url(value);
+      }
+      if (Array.isArray(value)) return value.map(serializeExtensions);
+      if (value && typeof value === 'object') {
+        return Object.fromEntries(Object.entries(value).map(([key, item]) =>
+          [key, serializeExtensions(item)]));
+      }
+      return value;
+    }
+
+    function parseCreationOptions(options) {
+      if (typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+        return PublicKeyCredential.parseCreationOptionsFromJSON(options);
+      }
+      return {
+        ...options,
+        challenge: decodeBase64url(options.challenge),
+        user: { ...options.user, id: decodeBase64url(options.user.id) },
+        ...(options.excludeCredentials && {
+          excludeCredentials: options.excludeCredentials.map(credential => ({
+            ...credential, id: decodeBase64url(credential.id)
+          }))
+        })
+      };
+    }
+
+    function serializeCredential(credential) {
+      if (typeof credential.toJSON === 'function') return credential.toJSON();
+      return {
+        id: credential.id,
+        rawId: encodeBase64url(credential.rawId),
+        type: credential.type,
+        authenticatorAttachment: credential.authenticatorAttachment,
+        response: {
+          clientDataJSON: encodeBase64url(credential.response.clientDataJSON),
+          attestationObject: encodeBase64url(credential.response.attestationObject),
+          ...(typeof credential.response.getTransports === 'function' && {
+            transports: credential.response.getTransports()
+          })
+        },
+        clientExtensionResults: serializeExtensions(credential.getClientExtensionResults())
+      };
+    }
+
+    async function postRegistration(url, body) {
+      const response = await fetch(url, {
+        method: 'POST',
+        credentials: 'same-origin',
+        mode: 'same-origin',
+        redirect: 'error',
+        cache: 'no-store',
+        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+        body: JSON.stringify(body)
+      });
+      if (!response.ok) throw new Error('Registration request failed. Please try again.');
+      return response;
+    }
+
+    registerButton.addEventListener('click', async () => {
+      if (registerButton.disabled) return;
+      registerButton.disabled = true;
+      registrationStatus.textContent = 'Preparing your passkey…';
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential ||
+            !navigator.credentials || typeof navigator.credentials.create !== 'function') {
+          throw new Error('Passkeys require a supported browser and a secure connection.');
+        }
+
+        const optionsResponse = await postRegistration('/api/register/options', { promotion: true });
+        const options = await optionsResponse.json();
+        registrationStatus.textContent = 'Follow your device’s instructions to create a passkey.';
+        const credential = await navigator.credentials.create({
+          publicKey: parseCreationOptions(options)
+        });
+        if (!credential || credential.type !== 'public-key') {
+          throw new Error('No passkey was created. Please try again.');
+        }
+
+        registrationStatus.textContent = 'Verifying your passkey…';
+        const verificationResponse = await postRegistration(
+          '/api/register/verify', serializeCredential(credential)
+        );
+        // The server must validate the challenge, origin, RP ID and attestation
+        // against this session before confirming registration.
+        const verification = await verificationResponse.json();
+        if (verification.verified !== true) {
+          throw new Error('Passkey verification failed. Please try again.');
+        }
+        registrationStatus.textContent = 'Your passkey has been created successfully.';
+      } catch (error) {
+        if (error.name === 'NotAllowedError' || error.name === 'AbortError') {
+          registrationStatus.textContent = 'Passkey creation was cancelled or timed out. You can try again.';
+        } else if (error.name === 'InvalidStateError') {
+          registrationStatus.textContent = 'A passkey for this account already exists on this device.';
+        } else {
+          registrationStatus.textContent = 'Unable to register your passkey. Please try again using a supported browser and a secure connection.';
+        }
+      } finally {
+        registerButton.disabled = false;
+      }
+    });
+  </script>
