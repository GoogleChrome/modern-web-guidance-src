   </footer>
 
+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTourButton = tourStep.querySelector('button');
+    const hasPopover = 'popover' in HTMLElement.prototype;
+    const hasAnchoring = CSS.supports('anchor-name: --rewards-link') &&
+      CSS.supports('top: anchor(bottom)');
+    let tourOpen = true;
+    let positionFrame;
+
+    // Track layout changes as well as scrolling and resizing in older browsers.
+    function trackRewardsLink() {
+      if (!tourOpen) return;
+      const bounds = rewardsLink.getBoundingClientRect();
+      const left = Math.max(12, Math.min(bounds.right - tourStep.offsetWidth,
+        document.documentElement.clientWidth - tourStep.offsetWidth - 12));
+      tourStep.style.top = `${bounds.bottom}px`;
+      tourStep.style.left = `${left}px`;
+      tourStep.style.right = 'auto';
+      positionFrame = requestAnimationFrame(trackRewardsLink);
+    }
+
+    tourStep.hidden = false;
+    if (hasPopover) tourStep.showPopover();
+    if (!hasAnchoring || !hasPopover) trackRewardsLink();
+    closeTourButton.focus({ preventScroll: true });
+
+    closeTourButton.addEventListener('click', () => {
+      tourOpen = false;
+      cancelAnimationFrame(positionFrame);
+      if (hasPopover) tourStep.hidePopover();
+      else tourStep.hidden = true;
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    function preventTourNavigation(event) {
+      if (tourOpen) event.preventDefault();
+    }
+    rewardsLink.addEventListener('click', preventTourNavigation);
+    rewardsLink.addEventListener('auxclick', preventTourNavigation);
+  </script>
+
 </body>
 
