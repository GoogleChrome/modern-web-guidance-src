+        <button id="summarize-journal" class="btn" type="button" aria-controls="journal-summary" aria-describedby="journal-status" disabled>Summarize</button>
+        <p id="journal-status" class="journal-status" role="status">Checking whether your browser supports on-device summaries…</p>
+      </div>
+      <div id="journal-summary" class="journal-summary" role="region" aria-labelledby="summary-title" aria-busy="false" hidden>
+        <h3 id="summary-title">Our sourcing, at a glance</h3>
+        <ul id="journal-summary-points"></ul>
+      </div>
+    </section>
