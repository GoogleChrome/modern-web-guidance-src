+  <script>
+    (() => {
+      const button = document.getElementById('summarize-journal');
+      const status = document.getElementById('journal-status');
+      const result = document.getElementById('journal-summary');
+      const points = document.getElementById('journal-summary-points');
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+      };
+
+      async function checkAvailability() {
+        if (!('Summarizer' in window)) {
+          status.textContent = 'On-device summaries aren’t supported in this browser. You can still enjoy the full journal above.';
+          return;
+        }
+
+        try {
+          const availability = await window.Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = 'On-device summaries aren’t available on this device. The full journal is ready to read above.';
+            return;
+          }
+          button.disabled = false;
+          status.textContent = availability === 'available'
+            ? 'Get a few key points with your browser’s on-device AI.'
+            : 'Your browser will download its AI model on first use. This may take a few minutes.';
+        } catch {
+          status.textContent = 'Your browser’s AI couldn’t be accessed. The full journal is ready to read above.';
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        result.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing your on-device summary…';
+        let summarizer;
+
+        try {
+          // Create directly in the click handler to preserve user activation for downloads.
+          summarizer = await window.Summarizer.create({
+            ...options,
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const progress = Math.round(event.loaded * 100);
+                status.textContent = `Downloading your browser’s AI model… ${progress}%`;
+              });
+            },
+          });
+          status.textContent = 'Reading the journal and finding the key points…';
+          const summary = await summarizer.summarize(document.getElementById('journal-text').innerText);
+          const lines = summary.split(/\n+/)
+            .map(line => line.replace(/^\s*(?:[-*•‣–—]|\d+[.)])\s*/, '').trim())
+            .filter(Boolean);
+          if (!lines.length) throw new Error('Empty summary');
+
+          points.replaceChildren(...lines.map(line => {
+            const item = document.createElement('li');
+            item.textContent = line;
+            return item;
+          }));
+          result.hidden = false;
+          status.textContent = 'Summary ready below. Generated by on-device AI; refer to the journal for the full story.';
+        } catch {
+          status.textContent = 'We couldn’t create a summary. Please try again, or read the full journal above.';
+        } finally {
+          if (summarizer) summarizer.destroy();
+          result.setAttribute('aria-busy', 'false');
+          button.disabled = false;
+          button.textContent = 'Summarize';
+        }
+      });
+
+      checkAvailability();
+    })();
+  </script>
+
