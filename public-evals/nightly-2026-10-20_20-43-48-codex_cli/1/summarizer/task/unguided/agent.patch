+  <script>
+    (() => {
+      const button = document.getElementById('summarize-journal');
+      const status = document.getElementById('journal-status');
+      const summary = document.getElementById('journal-summary');
+      const points = document.getElementById('journal-summary-points');
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en'
+      };
+      let busy = false;
+
+      if (!('Summarizer' in window)) {
+        button.disabled = true;
+        status.textContent = 'Summaries need a browser with built-in AI support, such as Chrome on a supported desktop. You can still read the full journal above.';
+        return;
+      }
+
+      // Check support without starting a model download on page load.
+      window.Summarizer.availability(options).then((availability) => {
+        if (busy) return;
+        if (availability === 'unavailable') {
+          button.disabled = true;
+          status.textContent = 'Your browser’s AI summarizer is unavailable on this device. You can still read the full journal above.';
+        }
+      }).catch(() => {
+        // Creation on click can retry if the initial availability check fails.
+      });
+
+      button.addEventListener('click', async () => {
+        if (busy) return;
+        busy = true;
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        summary.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing your browser’s AI…';
+        let summarizer;
+
+        try {
+          // Create directly within the click to preserve user activation.
+          summarizer = await window.Summarizer.create({
+            ...options,
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                status.textContent = `Downloading your browser’s AI model… ${Math.round(event.loaded * 100)}%`;
+              });
+            }
+          });
+          status.textContent = 'Reading the journal and finding the key points…';
+          const result = await summarizer.summarize(document.getElementById('journal-copy').innerText);
+          const bullets = result.split(/\n+/)
+            .map((line) => line.replace(/^\s*(?:[-*•‣]|\d+[.)])\s*/, '').trim())
+            .filter(Boolean);
+          if (!bullets.length) throw new Error('Empty summary');
+
+          points.replaceChildren(...bullets.map((text) => {
+            const item = document.createElement('li');
+            item.textContent = text;
+            return item;
+          }));
+          summary.hidden = false;
+          status.textContent = 'Your summary is ready below. Generated on your device.';
+        } catch (error) {
+          status.textContent = error.name === 'NotSupportedError'
+            ? 'Your browser’s AI summarizer is unavailable on this device. The full journal is above.'
+            : 'The summary couldn’t be created. Please try again; if a model download was interrupted, check your connection.';
+        } finally {
+          summarizer?.destroy();
+          busy = false;
+          button.disabled = false;
+          button.textContent = summary.hidden ? 'Summarize' : 'Summarize again';
+          summary.setAttribute('aria-busy', 'false');
+        }
+      });
+    })();
+  </script>
+
