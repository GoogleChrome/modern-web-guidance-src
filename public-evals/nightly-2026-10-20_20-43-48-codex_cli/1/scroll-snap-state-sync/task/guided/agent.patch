+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const headings = [...panel.querySelectorAll('.drink-section h3')];
+
+    function setActiveHeading(id) {
+      tocLinks.forEach(link => {
+        if (link.hash === `#${id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    tocLinks.forEach(link => {
+      link.addEventListener('click', event => {
+        // Preserve native modified-click behavior and real fragment destinations.
+        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const heading = document.getElementById(link.hash.slice(1));
+        const inset = parseFloat(getComputedStyle(panel).scrollPaddingTop) || 0;
+        panel.scrollTo({
+          top: panel.scrollTop + heading.getBoundingClientRect().top
+            - panel.getBoundingClientRect().top - panel.clientTop - inset,
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', event => {
+        if (event.snapTargetBlock) setActiveHeading(event.snapTargetBlock.id);
+      });
+    } else {
+      const visibleHeadings = new Set();
+      const observer = new IntersectionObserver(entries => {
+        entries.forEach(entry => {
+          if (entry.isIntersecting) visibleHeadings.add(entry.target);
+          else visibleHeadings.delete(entry.target);
+        });
+        const top = panel.getBoundingClientRect().top;
+        const active = [...visibleHeadings].sort((a, b) =>
+          Math.abs(a.getBoundingClientRect().top - top)
+          - Math.abs(b.getBoundingClientRect().top - top)
+        )[0];
+        if (active) setActiveHeading(active.id);
+      }, { root: panel, rootMargin: '0px 0px -65% 0px', threshold: 0 });
+      headings.forEach(heading => observer.observe(heading));
+    }
+  </script>
