+  <script type="module">
+    // Vendored webauthn-polyfills 0.1.7: JSON support only. Conditional creation
+    // must be detected natively, never inferred from a browser version.
+    import './vendor/webauthn-polyfills/json_serialization.js';
+
+    const form = document.getElementById('signin-form');
+    const signinButton = form.querySelector('[data-testid="signin-button"]');
+    const status = document.getElementById('signin-status');
+    let signedIn = false;
+
+    async function promotePasskey() {
+      try {
+        if (!window.isSecureContext ||
+            typeof window.PublicKeyCredential?.getClientCapabilities !== 'function' ||
+            typeof navigator.credentials?.create !== 'function') return;
+
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (capabilities.conditionalCreate !== true) return;
+
+        // The authenticated server supplies the user, fresh challenge, RP and
+        // excludeCredentials. Never derive the account from the submitted name.
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+        if (!optionsResponse.ok) return;
+
+        const options = await optionsResponse.json();
+        const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(options);
+        const credential = await navigator.credentials.create({
+          publicKey,
+          mediation: 'conditional'
+        });
+        if (!credential) return;
+
+        const verification = await fetch('/api/register/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ ...credential.toJSON(), conditional: true })
+        });
+
+        // Only a definitive server rejection warrants removing the credential;
+        // a network failure may have occurred after it was successfully stored.
+        if (!verification.ok && typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: publicKey.rp.id || window.location.hostname,
+            credentialId: credential.id
+          });
+        }
+      } catch {
+        // Background promotion is optional. No prompts, retries, or error UI.
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (signinButton.disabled || signedIn) return;
+      signinButton.disabled = true;
+      status.textContent = 'Signing in…';
+
+      try {
+        // /api/login must establish a full authenticated session (including any
+        // required MFA) before returning success. Never promote a partial login.
+        const response = await fetch(form.action, {
+          method: 'POST',
+          credentials: 'same-origin',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            username: form.elements.username.value,
+            password: form.elements.password.value
+          })
+        });
+        if (!response.ok || response.status === 202) {
+          status.textContent = 'Sign-in was not completed. Please try again.';
+          return;
+        }
+
+        signedIn = true;
+        form.elements.password.value = '';
+        form.hidden = true;
+        status.textContent = 'You’re signed in.';
+        void promotePasskey();
+      } catch {
+        status.textContent = 'Unable to sign in. Please try again.';
+      } finally {
+        signinButton.disabled = false;
+      }
+    });
+  </script>
