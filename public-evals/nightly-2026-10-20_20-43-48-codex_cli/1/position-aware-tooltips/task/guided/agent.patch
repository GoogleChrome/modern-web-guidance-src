+    }
+
+    .info-button:hover {
+      background: var(--secondary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    #maple-tooltip {
+      position: fixed;
+      width: min(260px, calc(100vw - 32px));
+      padding: 0;
+      border: 0;
+      margin: auto;
+      overflow: visible;
+      background: transparent;
+      color: white;
+      container-type: anchored;
+    }
+
+    .tooltip-content {
+      position: relative;
+      padding: 12px 16px;
+      margin-block: 0 12px;
+      border-radius: 10px 10px 4px 4px;
+      background: var(--primary);
+      box-shadow: 0 4px 16px rgb(0 0 0 / 18%);
+      font-size: 0.875rem;
+      text-align: start;
+    }
+
+    @supports (anchor-name: --maple-info) {
+      #maple-tooltip {
+        inset: auto;
+        margin: 0;
+        position-anchor: --maple-info;
+        position-area: block-start;
+        position-try-fallbacks: flip-block;
+      }
+
+      /* Only show a directional arrow when CSS can detect its active side. */
+      @supports (container-type: anchored) {
+        .tooltip-content::after {
+          content: "";
+          position: absolute;
+          inset-inline-start: calc(50% - 8px);
+          inset-block-end: -8px;
+          border: 8px solid transparent;
+          border-block-start-color: var(--primary);
+          border-block-end-width: 0;
+        }
+      }
+    }
+
+    /* Query a descendant: a container cannot query and restyle itself. */
+    @container anchored(fallback: flip-block) {
+      .tooltip-content {
+        margin-block: 12px 0;
+        border-radius: 4px 4px 10px 10px;
+      }
+
+      .tooltip-content::after {
+        inset-block-start: -8px;
+        inset-block-end: auto;
+        border-block-start-width: 0;
+        border-block-start-color: transparent;
+        border-block-end-width: 8px;
+        border-block-end-color: var(--primary);
+      }
+    }
+
