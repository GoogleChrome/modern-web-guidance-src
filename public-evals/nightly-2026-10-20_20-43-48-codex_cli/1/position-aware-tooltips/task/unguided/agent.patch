     .btn:hover {
       background: #3e2723;
     }
 
+    .card-actions {
+      display: flex;
+      justify-content: center;
+      align-items: center;
+      gap: 10px;
+      margin-top: 15px;
+    }
+
+    .card-actions .btn {
+      margin-top: 0;
+    }
+
+    .info-button {
+      anchor-name: --maple-info;
+      width: 30px;
+      height: 30px;
+      border: 1px solid var(--primary);
+      border-radius: 50%;
+      background: white;
+      color: var(--primary);
+      font: bold 1rem Georgia, serif;
+      cursor: pointer;
+    }
+
+    .info-button:hover {
+      background: var(--secondary);
+    }
+
+    .info-button:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    .latte-tooltip {
+      position: fixed;
+      position-anchor: --maple-info;
+      position-area: top;
+      position-try-fallbacks: flip-block;
+      container-type: anchored;
+      inset: auto;
+      width: min(260px, calc(100vw - 32px));
+      max-width: none;
+      max-height: none;
+      margin: 0;
+      padding: 0;
+      border: 0;
+      overflow: visible;
+      background: transparent;
+      color: white;
+      text-align: left;
+      font-size: 0.875rem;
+    }
+
+    /* Keep the surface inside the anchored container so its state can style it. */
+    .latte-tooltip-content {
+      position: relative;
+      margin: 0 0 12px;
+      padding: 14px 16px;
+      border-radius: 12px 12px 4px 4px;
+      background: var(--primary);
+      box-shadow: 0 4px 16px rgb(0 0 0 / 18%);
+    }
+
+    .latte-tooltip-content::after {
+      content: "";
+      position: absolute;
+      top: 100%;
+      left: 50%;
+      transform: translateX(-50%);
+      border-style: solid;
+      border-width: 6px 6px 0;
+      border-color: var(--primary) transparent transparent;
+    }
+
+    @container anchored(fallback: flip-block) {
+      .latte-tooltip-content {
+        margin: 12px 0 0;
+        border-radius: 4px 4px 12px 12px;
+      }
+
+      .latte-tooltip-content::after {
+        top: auto;
+        bottom: 100%;
+        border-width: 0 6px 6px;
+        border-color: transparent transparent var(--primary);
+      }
+    }
+
     footer {
