@@ -0,0 +1,14 @@
+import 'react';
+
+// Experimental WebMCP declarative attributes are not yet in React's DOM types.
+declare module 'react' {
+  interface FormHTMLAttributes<T> {
+    toolname?: string;
+    tooldescription?: string;
+    toolautosubmit?: string;
+  }
+
+  interface InputHTMLAttributes<T> {
+    toolparamdescription?: string;
+  }
+}
diff --git a/src/utils/formTools.ts b/src/utils/formTools.ts
new file mode 100644
index 0000000..b9d6921
--- /dev/null
+++ b/src/utils/formTools.ts
@@ -0,0 +1,11 @@
+/** Return the same asynchronous form outcome to WebMCP agents, when supported. */
+export function respondToFormTool(event: Event, result: Promise<unknown>): void {
+  const toolEvent = event as Event & {
+    agentInvoked?: boolean;
+    respondWith?: (result: Promise<unknown>) => void;
+  };
+
+  if (toolEvent.agentInvoked && typeof toolEvent.respondWith === 'function') {
+    toolEvent.respondWith(result);
+  }
+}
