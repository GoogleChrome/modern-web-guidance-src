+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const list = document.getElementById('roast-options');
+    const options = [...list.querySelectorAll('[role="option"]')];
+    const orderButton = document.getElementById('order-button');
+
+    function closePicker(restoreFocus = false) {
+      list.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (restoreFocus) trigger.focus();
+    }
+
+    function openPicker(index = options.findIndex(option => option.getAttribute('aria-selected') === 'true')) {
+      list.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options[index].focus();
+    }
+
+    function selectRoast(option) {
+      options.forEach(item => item.setAttribute('aria-selected', String(item === option)));
+      trigger.querySelector('.roast-icon').replaceWith(option.querySelector('svg').cloneNode(true));
+      document.getElementById('roast-value').replaceChildren(...[...option.querySelector('.roast-copy').children].map(node => node.cloneNode(true)));
+      orderButton.href = '/order-online?roast=' + encodeURIComponent(option.dataset.value);
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => list.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', event => {
+      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
+        event.preventDefault();
+        openPicker(event.key === 'ArrowUp' ? options.length - 1 : undefined);
+      }
+    });
+    options.forEach(option => option.addEventListener('click', () => selectRoast(option)));
+    list.addEventListener('keydown', event => {
+      const index = options.indexOf(document.activeElement);
+      let next;
+      if (event.key === 'ArrowDown') next = (index + 1) % options.length;
+      if (event.key === 'ArrowUp') next = (index - 1 + options.length) % options.length;
+      if (event.key === 'Home') next = 0;
+      if (event.key === 'End') next = options.length - 1;
+      if (next !== undefined) {
+        event.preventDefault();
+        options[next].focus();
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        selectRoast(options[index]);
+      }
+    });
+    picker.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !list.hidden) {
+        event.preventDefault();
+        closePicker(true);
+      }
+    });
+    picker.addEventListener('focusout', event => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+    document.addEventListener('click', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+  </script>
