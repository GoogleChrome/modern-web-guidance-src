+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyContainers = [...document.querySelectorAll('.sticky-container')];
+    const supportsScrollState = CSS.supports('container-type: scroll-state');
+    let navigationHeight = navigation.getBoundingClientRect().height;
+    let pendingFrame = false;
+
+    function updateStickyFallback() {
+      pendingFrame = false;
+      // The document is the scroll root; compare directly with viewport bounds.
+      const states = stickyContainers.map(container => {
+        const header = container.getBoundingClientRect();
+        const section = container.parentElement.getBoundingClientRect();
+        return section.top < navigationHeight &&
+          header.top >= navigationHeight - 1 && header.top <= navigationHeight + 1;
+      });
+      stickyContainers.forEach((container, index) => {
+        container.classList.toggle('is-stuck', states[index]);
+      });
+    }
+
+    function scheduleStickyUpdate() {
+      if (!supportsScrollState && !pendingFrame) {
+        pendingFrame = true;
+        requestAnimationFrame(updateStickyFallback);
+      }
+    }
+
+    new ResizeObserver(() => {
+      navigationHeight = navigation.getBoundingClientRect().height;
+      document.documentElement.style.setProperty('--nav-height', `${navigationHeight}px`);
+      scheduleStickyUpdate();
+    }).observe(navigation);
+
+    if (!supportsScrollState) {
+      window.addEventListener('scroll', scheduleStickyUpdate, { passive: true });
+      window.addEventListener('resize', scheduleStickyUpdate);
+      scheduleStickyUpdate();
+    }
+  </script>
+
