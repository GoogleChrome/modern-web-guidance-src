+  <script type="module">
+    const deadlineValue = document.getElementById('temporal-value');
+    const referenceChanged = document.getElementById('temporal-ref-changed');
+    const renderCountValue = document.getElementById('temporal-render-count');
+    const extendButton = document.getElementById('extend-temporal-btn');
+
+    try {
+      const Temporal = globalThis.Temporal ??
+        (await import('https://esm.sh/@js-temporal/polyfill@0.5.1')).Temporal;
+
+      let state = { deadline: Temporal.Now.plainDateISO().add({ days: 7 }) };
+      let renderCount = 0;
+
+      function render(changed = false) {
+        const date = state.deadline.toString();
+        deadlineValue.textContent = date;
+        deadlineValue.dateTime = date;
+        referenceChanged.textContent = changed ? 'Yes' : 'No';
+        renderCountValue.textContent = String(++renderCount);
+      }
+
+      function setState(nextState) {
+        if (Object.is(state, nextState)) return;
+        const changed = !Object.is(state.deadline, nextState.deadline);
+        state = nextState;
+        render(changed);
+      }
+
+      extendButton.addEventListener('click', () => {
+        setState({ ...state, deadline: state.deadline.add({ days: 1 }) });
+      });
+
+      render();
+      extendButton.disabled = false;
+    } catch (error) {
+      deadlineValue.textContent = 'Unable to load the deadline. Please reload to try again.';
+      console.error('Unable to initialize the Temporal deadline tracker:', error);
+    }
+  </script>
+
 </body>
 
