+  <script>
+    const favorites = Array.from(document.querySelectorAll('#favorites-items .card'));
+    const status = document.getElementById('favorites-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let currentFavorite = 0;
+    let activeTransition = null;
+
+    function showFavorite(step) {
+      if (activeTransition) return;
+
+      const update = () => {
+        favorites[currentFavorite].hidden = true;
+        currentFavorite = (currentFavorite + step + favorites.length) % favorites.length;
+        favorites[currentFavorite].hidden = false;
+        status.textContent = `${currentFavorite + 1} of ${favorites.length}: ${favorites[currentFavorite].querySelector('h3').textContent}`;
+      };
+
+      if (reducedMotion.matches || !document.startViewTransition ||
+          !CSS.supports('selector(:active-view-transition-type(forward))')) {
+        update();
+        return;
+      }
+
+      activeTransition = document.startViewTransition({
+        update,
+        types: [step > 0 ? 'forward' : 'backward']
+      });
+      activeTransition.finished.finally(() => {
+        activeTransition = null;
+      });
+    }
+
+    document.getElementById('favorites-previous').addEventListener('click', () => showFavorite(-1));
+    document.getElementById('favorites-next').addEventListener('click', () => showFavorite(1));
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) activeTransition?.skipTransition();
+    });
+  </script>
 </body>
 
