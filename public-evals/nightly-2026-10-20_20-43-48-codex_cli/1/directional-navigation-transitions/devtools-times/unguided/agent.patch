diff --git a/src/components/TopStoriesSlider.astro b/src/components/TopStoriesSlider.astro
new file mode 100644
index 0000000..cbed647
--- /dev/null
+++ b/src/components/TopStoriesSlider.astro
@@ -0,0 +1,88 @@
+---
+import type { CollectionEntry } from 'astro:content';
+
+interface Props {
+    articles: CollectionEntry<'articles'>[];
+}
+
+const { articles } = Astro.props;
+---
+
+<top-stories-slider class="block bg-white border-b border-gray-300">
+    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4" aria-label="Top Stories" aria-roledescription="carousel">
+        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
+            <div class="min-w-0 flex-1 overflow-hidden" data-viewport>
+                {articles.map((article, index) => (
+                    <div data-story hidden={index !== 0} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${articles.length}`}>
+                        <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                            <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                        </a>
+                        <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                    </div>
+                ))}
+            </div>
+            <div class="flex shrink-0 items-center gap-3">
+                <button type="button" data-previous disabled class="rounded border border-gray-300 px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50">Previous</button>
+                <span class="text-xs text-gray-500 tabular-nums" data-status aria-live="polite" aria-atomic="true">
+                    {articles.length ? 1 : 0} / {articles.length}
+                </span>
+                <button type="button" data-next disabled class="rounded border border-gray-300 px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900 disabled:opacity-50">Next</button>
+            </div>
+        </div>
+    </section>
+</top-stories-slider>
+
+<style>
+    @media (prefers-reduced-motion: no-preference) {
+        [data-story][data-direction='next'] {
+            animation: enter-from-right 300ms ease-out;
+        }
+
+        [data-story][data-direction='previous'] {
+            animation: enter-from-left 300ms ease-out;
+        }
+    }
+
+    @keyframes enter-from-right {
+        from { transform: translateX(100%); }
+        to { transform: translateX(0); }
+    }
+
+    @keyframes enter-from-left {
+        from { transform: translateX(-100%); }
+        to { transform: translateX(0); }
+    }
+</style>
+
+<script>
+    class TopStoriesSlider extends HTMLElement {
+        connectedCallback() {
+            if (this.dataset.initialized) return;
+            this.dataset.initialized = 'true';
+
+            const stories = Array.from(this.querySelectorAll<HTMLElement>('[data-story]'));
+            const previous = this.querySelector<HTMLButtonElement>('[data-previous]')!;
+            const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
+            const status = this.querySelector<HTMLElement>('[data-status]')!;
+            let currentIndex = 0;
+
+            const showStory = (direction: 'next' | 'previous') => {
+                if (stories.length < 2) return;
+                stories[currentIndex].hidden = true;
+                currentIndex = (currentIndex + (direction === 'next' ? 1 : -1) + stories.length) % stories.length;
+                const story = stories[currentIndex];
+                story.dataset.direction = direction;
+                story.hidden = false;
+                status.textContent = `${currentIndex + 1} / ${stories.length}`;
+            };
+
+            previous.disabled = next.disabled = stories.length < 2;
+            previous.addEventListener('click', () => showStory('previous'));
+            next.addEventListener('click', () => showStory('next'));
+        }
+    }
+
+    if (!customElements.get('top-stories-slider')) {
+        customElements.define('top-stories-slider', TopStoriesSlider);
+    }
+</script>
