+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const newsletterEmail = document.querySelector('#newsletter-email');
+
+    function syncNewsletterValidity() {
+      newsletterEmail.setAttribute('aria-invalid', String(newsletterEmail.matches(':user-invalid')));
+    }
+
+    function scheduleNewsletterValiditySync() {
+      syncNewsletterValidity();
+      // Recheck after the browser finishes updating its user-interaction state.
+      requestAnimationFrame(syncNewsletterValidity);
+    }
+
+    ['input', 'change', 'blur', 'focus', 'invalid'].forEach((eventName) => {
+      newsletterEmail.addEventListener(eventName, scheduleNewsletterValiditySync);
+    });
+    newsletter.addEventListener('reset', scheduleNewsletterValiditySync);
+    window.addEventListener('pageshow', scheduleNewsletterValiditySync);
+    newsletter.addEventListener('submit', (event) => {
+      // Keep the address on this page until a newsletter service is connected.
+      event.preventDefault();
+      scheduleNewsletterValiditySync();
+    });
+    syncNewsletterValidity();
+  </script>
+
 </body>
 
