+  <script>
+    const newsletterForm = document.querySelector('.newsletter');
+    const newsletterEmail = document.getElementById('newsletter-email');
+    const newsletterStatus = newsletterForm.querySelector('.newsletter-status');
+
+    const syncNewsletterValidity = () => {
+      newsletterEmail.setAttribute('aria-invalid', String(newsletterEmail.matches(':user-invalid')));
+    };
+
+    const scheduleNewsletterValidity = () => {
+      syncNewsletterValidity();
+      // Recheck after the browser updates interaction state, including failed submissions.
+      requestAnimationFrame(syncNewsletterValidity);
+    };
+
+    for (const eventName of ['blur', 'input', 'change', 'invalid']) {
+      newsletterEmail.addEventListener(eventName, scheduleNewsletterValidity);
+    }
+
+    newsletterEmail.addEventListener('input', () => {
+      newsletterStatus.textContent = '';
+    });
+
+    newsletterForm.addEventListener('reset', () => {
+      newsletterStatus.textContent = '';
+      requestAnimationFrame(syncNewsletterValidity);
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      scheduleNewsletterValidity();
+      // Replace this message with the signup request when a newsletter service is connected.
+      newsletterStatus.textContent = 'Newsletter signup is not available yet. Please check back soon.';
+    });
+  </script>
+
 </body>
 
