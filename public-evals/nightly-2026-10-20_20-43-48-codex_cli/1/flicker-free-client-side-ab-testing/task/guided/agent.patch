+  <style>html.experiment-pending { visibility: hidden; }</style>
+  <script>
+    // Install the fallback before requesting the SDK, including on a warm cache.
+    (() => {
+      const root = document.documentElement;
+      if (!('blocking' in HTMLScriptElement.prototype)) {
+        root.classList.add('experiment-pending');
+      }
+      const settle = (event) => {
+        if (event.target.id !== 'experiment-sdk') return;
+        // An SDK that applies changes at DOMContentLoaded gets to finish first.
+        const reveal = () => {
+          root.classList.remove('experiment-pending');
+          root.dataset.experimentStatus = event.type === 'error' ? 'unavailable' : 'loaded';
+        };
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', reveal, { once: true });
+        } else reveal();
+        document.removeEventListener('load', settle, true);
+        document.removeEventListener('error', settle, true);
+      };
+      document.addEventListener('load', settle, true);
+      document.addEventListener('error', settle, true);
+    })();
+  </script>
+  <script id="experiment-sdk" src="https://cdn.example.com/experiment-sdk.js" async blocking="render"></script>
