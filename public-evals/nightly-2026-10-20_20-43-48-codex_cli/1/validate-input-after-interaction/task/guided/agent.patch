@@ -206,7 +287,41 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.querySelector('#newsletter-email');
+    const emailError = document.querySelector('#newsletter-error');
+    const signupStatus = document.querySelector('#newsletter-status');
+
+    // Handle feedback ourselves so validation never interrupts typing.
+    newsletter.noValidate = true;
+
+    function showEmailError(show) {
+      emailError.hidden = !show;
+      email.setAttribute('aria-invalid', String(show));
+    }
+
+    email.addEventListener('focus', () => showEmailError(false));
+    email.addEventListener('input', () => {
+      showEmailError(false);
+      signupStatus.textContent = '';
+    });
+    email.addEventListener('blur', () => showEmailError(!email.validity.valid));
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!email.validity.valid) {
+        email.focus();
+        return;
+      }
+
+      showEmailError(false);
+      // Replace this message with a signup request when a service is available.
+      signupStatus.textContent = 'Online signup is coming soon. Please check back.';
+    });
+  </script>
+
 </body>
 
 </html>
