@@ -206,7 +272,37 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.querySelector('#newsletter-email');
+    const message = document.querySelector('#newsletter-message');
+
+    function clearMessage() {
+      email.removeAttribute('aria-invalid');
+      message.textContent = '';
+      message.classList.remove('newsletter-error');
+    }
+
+    function validateEmail() {
+      email.value = email.value.trim();
+      const valid = email.validity.valid;
+      email.setAttribute('aria-invalid', String(!valid));
+      message.classList.toggle('newsletter-error', !valid);
+      message.textContent = valid ? '' : 'Please enter a valid email address.';
+      return valid;
+    }
+
+    email.addEventListener('blur', validateEmail);
+    email.addEventListener('input', clearMessage);
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!validateEmail()) return;
+      message.textContent = 'Online signup is coming soon. Please check back later.';
+    });
+  </script>
+
 </body>
 
 </html>
