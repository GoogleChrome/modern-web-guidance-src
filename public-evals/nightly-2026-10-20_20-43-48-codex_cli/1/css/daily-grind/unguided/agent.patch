diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..e9fce4c
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,239 @@
+/* Later layers take precedence without increasing selector specificity. */
+@layer reset, tokens, base, layout, components, accessibility;
+
+@layer reset {
+  :where(*, *::before, *::after) {
+    box-sizing: border-box;
+  }
+
+  :where(body, h1, h2, h3, p, ul) {
+    margin: 0;
+    padding: 0;
+  }
+}
+
+@layer tokens {
+  :root {
+    /* Palette primitives. Components consume the semantic aliases below. */
+    --color-coffee-700: #4e342e;
+    --color-coffee-900: #3e2723;
+    --color-sand-200: #d7ccc8;
+    --color-amber-400: #ffab40;
+    --color-white: #fff;
+    --color-neutral-50: #fafafa;
+
+    --color-brand: var(--color-coffee-700);
+    --color-brand-hover: var(--color-coffee-900);
+    --color-text: var(--color-coffee-900);
+    --color-text-inverse: var(--color-white);
+    --color-accent: var(--color-amber-400);
+    --color-page: var(--color-neutral-50);
+    --color-surface: var(--color-white);
+    --color-surface-muted: var(--color-sand-200);
+    --color-hero-overlay: rgb(0 0 0 / 50%);
+
+    --font-family-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-logo: 1.5rem;
+    --font-size-hero: 3rem;
+    --font-weight-bold: 700;
+    --line-height-body: 1.6;
+    --letter-spacing-logo: 0.0625rem;
+
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.75rem;
+    --space-4: 0.9375rem;
+    --space-5: 1rem;
+    --space-6: 1.25rem;
+    --space-7: 2.5rem;
+    --radius-small: 0.25rem;
+    --radius-button: 0.3125rem;
+    --radius-card: 0.5rem;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --border-width: 1px;
+    --focus-width: 3px;
+    --focus-offset: 3px;
+    --duration-interaction: 300ms;
+    --content-max-width: 68.75rem;
+    --page-gutter: var(--space-6);
+    --nav-gutter: 5%;
+    --layer-sticky: 10;
+  }
+}
+
+@layer base {
+  .daily-grind {
+    font-family: var(--font-family-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+}
+
+@layer layout {
+  @scope (.daily-grind) {
+    .container {
+      max-inline-size: var(--content-max-width);
+      margin-block: var(--space-7);
+      margin-inline: auto;
+      padding-inline: var(--page-gutter);
+    }
+  }
+}
+
+@layer components {
+  /* Component rules apply only inside the Daily Grind page. */
+  @scope (.daily-grind) {
+    .site-nav {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: center;
+      gap: var(--space-5) var(--space-6);
+      position: sticky;
+      inset-block-start: 0;
+      z-index: var(--layer-sticky);
+      padding-block: var(--space-5);
+      padding-inline: var(--nav-gutter);
+      background: var(--color-brand);
+      color: var(--color-text-inverse);
+
+      & .site-nav__logo {
+        font-size: var(--font-size-logo);
+        font-weight: var(--font-weight-bold);
+        letter-spacing: var(--letter-spacing-logo);
+      }
+
+      & .site-nav__links {
+        display: flex;
+        flex-wrap: wrap;
+        align-items: center;
+        gap: var(--space-3) var(--space-6);
+        list-style: none;
+      }
+
+      & :where(a) {
+        color: inherit;
+        text-decoration: none;
+        font-size: var(--font-size-nav);
+        transition: color var(--duration-interaction);
+
+        &:is(:hover, :focus-visible) {
+          color: var(--color-accent);
+        }
+      }
+
+      & .site-nav__logout {
+        display: inline-block;
+        border: var(--border-width) solid var(--color-accent);
+        padding: var(--space-1) var(--space-3);
+        border-radius: var(--radius-small);
+      }
+    }
+
+    .hero {
+      --hero-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      --hero-height: 60vh;
+
+      min-block-size: var(--hero-height);
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      padding: var(--space-7) var(--page-gutter);
+      background-image: linear-gradient(var(--color-hero-overlay), var(--color-hero-overlay)), var(--hero-image);
+      background-size: cover;
+      background-position: center;
+      color: var(--color-text-inverse);
+      text-align: center;
+
+      & .hero__title {
+        font-size: clamp(2rem, 6vw, var(--font-size-hero));
+        margin-block-end: var(--space-5);
+      }
+    }
+
+    .favorites {
+      --favorites-card-min: 15.625rem;
+
+      & .favorites__title {
+        text-align: center;
+      }
+
+      & .favorites__grid {
+        display: grid;
+        grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--favorites-card-min)), 1fr));
+        gap: var(--space-6);
+        margin-block-start: var(--space-6);
+      }
+    }
+
+    .product-card {
+      background: var(--color-surface);
+      padding: var(--space-6);
+      border-radius: var(--radius-card);
+      box-shadow: var(--shadow-card);
+      text-align: center;
+
+      & .product-card__title {
+        margin-block-end: var(--space-2);
+        color: var(--color-brand);
+      }
+    }
+
+    .button {
+      display: inline-block;
+      background: var(--color-brand);
+      color: var(--color-text-inverse);
+      padding: var(--space-2) var(--space-6);
+      text-decoration: none;
+      border-radius: var(--radius-button);
+      margin-block-start: var(--space-4);
+      transition: background-color var(--duration-interaction);
+
+      &:is(:hover, :focus-visible) {
+        background-color: var(--color-brand-hover);
+      }
+    }
+
+    .site-footer {
+      background: var(--color-surface-muted);
+      text-align: center;
+      padding: var(--space-7) var(--page-gutter);
+      margin-block-start: var(--space-7);
+
+      & .site-footer__links {
+        margin-block-end: var(--space-6);
+
+        & :where(a) {
+          display: inline-block;
+          margin-inline: var(--space-2);
+          color: var(--color-text);
+          text-decoration: none;
+          font-size: var(--font-size-small);
+
+          &:is(:hover, :focus-visible) {
+            text-decoration: underline;
+          }
+        }
+      }
+    }
+  }
+}
+
+@layer accessibility {
+  @scope (.daily-grind) {
+    :where(a, button):focus-visible {
+      outline: var(--focus-width) solid currentColor;
+      outline-offset: var(--focus-offset);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      :where(a, button) {
+        transition: none;
+      }
+    }
+  }
+}
