@@ -0,0 +1,221 @@
+/* Later layers win without increasing selector specificity. */
+@layer tokens, reset, base, layout, components;
+
+@layer tokens {
+  :root {
+    /* Palette primitives feed semantic tokens used by the UI. */
+    --color-brown-900: #3e2723;
+    --color-brown-800: #4e342e;
+    --color-brown-200: #d7ccc8;
+    --color-amber-400: #ffab40;
+    --color-white: #fff;
+    --color-off-white: #fafafa;
+
+    --color-brand: var(--color-brown-800);
+    --color-text: var(--color-brown-900);
+    --color-accent: var(--color-amber-400);
+    --color-page: var(--color-off-white);
+    --color-surface: var(--color-white);
+    --color-on-brand: var(--color-white);
+    --color-footer: var(--color-brown-200);
+    --color-action-hover: var(--color-brown-900);
+
+    --font-body: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+    --font-size-small: 0.85rem;
+    --font-size-nav: 0.9rem;
+    --font-size-logo: 1.5rem;
+    --font-size-hero: 3rem;
+    --line-height-body: 1.6;
+
+    --space-1: 0.3125rem;
+    --space-2: 0.625rem;
+    --space-3: 0.75rem;
+    --space-4: 0.9375rem;
+    --space-5: 1rem;
+    --space-6: 1.25rem;
+    --space-7: 2.5rem;
+
+    --radius-small: 0.25rem;
+    --radius-button: 0.3125rem;
+    --radius-card: 0.5rem;
+    --shadow-card: 0 2px 5px rgb(0 0 0 / 10%);
+    --duration-interaction: 0.3s;
+    --content-max: 68.75rem;
+    --card-min: 15.625rem;
+    --page-gutter: var(--space-6);
+    --layer-sticky: 10;
+  }
+}
+
+@layer reset {
+  /* Reset only the elements this page uses; leave other widgets alone. */
+  :where(body, h1, h2, h3, p, ul) {
+    margin: 0;
+    padding: 0;
+  }
+
+  :where(.site-nav, .hero, .container, .grid, .card, .btn, .logout-link, .site-footer) {
+    box-sizing: border-box;
+  }
+}
+
+@layer base {
+  body {
+    font-family: var(--font-body);
+    line-height: var(--line-height-body);
+    color: var(--color-text);
+    background-color: var(--color-page);
+  }
+
+  :where(a:focus-visible) {
+    outline: 2px solid currentColor;
+    outline-offset: 4px;
+  }
+}
+
+@layer layout {
+  .container {
+    max-inline-size: var(--content-max);
+    margin-block: var(--space-7);
+    margin-inline: auto;
+    padding-inline: var(--page-gutter);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
+    gap: var(--space-6);
+    margin-block-start: var(--space-6);
+  }
+}
+
+@layer components {
+  /* Direct-child selectors keep component styles out of nested components.
+     :where() keeps incidental structure from increasing specificity. */
+  .site-nav {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    align-items: center;
+    gap: var(--space-5) var(--space-6);
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--layer-sticky);
+    padding-block: var(--space-5);
+    padding-inline: 5%;
+    color: var(--color-on-brand);
+    background: var(--color-brand);
+
+    & > :where(ul) {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: var(--space-5) var(--space-6);
+      list-style: none;
+    }
+
+    & > :where(ul > li > a) {
+      color: inherit;
+      text-decoration: none;
+      font-size: var(--font-size-nav);
+      transition: color var(--duration-interaction);
+
+      &:where(:hover, :focus-visible) {
+        color: var(--color-accent);
+      }
+    }
+  }
+
+  .logo {
+    font-size: var(--font-size-logo);
+    font-weight: bold;
+    letter-spacing: 0.0625rem;
+  }
+
+  .logout-link {
+    border: 1px solid var(--color-accent);
+    padding-block: var(--space-1);
+    padding-inline: var(--space-3);
+    border-radius: var(--radius-small);
+  }
+
+  .hero {
+    --hero-overlay: rgb(0 0 0 / 50%);
+
+    display: flex;
+    flex-direction: column;
+    justify-content: center;
+    align-items: center;
+    min-block-size: 60vh;
+    padding-inline: var(--page-gutter);
+    color: var(--color-on-brand);
+    text-align: center;
+    background:
+      linear-gradient(var(--hero-overlay), var(--hero-overlay)),
+      url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80') center / cover;
+
+    & > :where(h1) {
+      font-size: var(--font-size-hero);
+      margin-block-end: var(--space-5);
+    }
+  }
+
+  .section-title {
+    text-align: center;
+  }
+
+  .card {
+    padding: var(--space-6);
+    border-radius: var(--radius-card);
+    color: var(--color-text);
+    background: var(--color-surface);
+    box-shadow: var(--shadow-card);
+    text-align: center;
+
+    & > :where(h3) {
+      margin-block-end: var(--space-2);
+      color: var(--color-brand);
+    }
+  }
+
+  .btn {
+    display: inline-block;
+    margin-block-start: var(--space-4);
+    padding-block: var(--space-2);
+    padding-inline: var(--space-6);
+    border-radius: var(--radius-button);
+    color: var(--color-on-brand);
+    background: var(--color-brand);
+    text-decoration: none;
+    transition: background-color var(--duration-interaction);
+
+    &:where(:hover, :focus-visible) {
+      background-color: var(--color-action-hover);
+    }
+  }
+
+  .site-footer {
+    margin-block-start: var(--space-7);
+    padding-block: var(--space-7);
+    padding-inline: var(--page-gutter);
+    background: var(--color-footer);
+    text-align: center;
+  }
+
+  .footer-links {
+    margin-block-end: var(--space-6);
+
+    & > :where(a) {
+      margin-inline: var(--space-2);
+      color: inherit;
+      text-decoration: none;
+      font-size: var(--font-size-small);
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    :where(.btn, .site-nav > ul > li > a) {
+      transition: none;
+    }
+  }
+}
