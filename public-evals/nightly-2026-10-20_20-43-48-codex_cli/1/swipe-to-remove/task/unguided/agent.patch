+  <script>
+    const cart = document.querySelector('.SwipeableList');
+    const cartCount = document.querySelector('.cart-heading .cart-count');
+    const emptyCart = document.querySelector('.cart-empty');
+    const cartStatus = document.querySelector('#cart-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    cart.querySelectorAll('.SwipeableList-item').forEach((item) => {
+      const content = item.querySelector('.SwipeableList-content');
+      const button = item.querySelector('.cart-remove');
+      let pointerId = null;
+      let startX = 0;
+      let startY = 0;
+      let offset = 0;
+      let dragging = false;
+      let removing = false;
+      const threshold = () => Math.min(96, content.offsetWidth * 0.3);
+
+      function resetSwipe() {
+        pointerId = null;
+        dragging = false;
+        offset = 0;
+        item.classList.remove('is-dragging', 'is-ready');
+        content.style.transform = '';
+      }
+
+      async function removeItem(direction = -1) {
+        if (removing) return;
+        removing = true;
+        pointerId = null;
+        item.classList.remove('is-dragging');
+        item.classList.add('is-removing');
+        button.disabled = true;
+        content.style.transform = `translateX(${direction * content.offsetWidth}px)`;
+        const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+        if (!reducedMotion.matches) await delay(200);
+
+        const height = item.getBoundingClientRect().height;
+        const collapse = item.animate([
+          { height: `${height}px`, paddingBottom: '12px', opacity: 1 },
+          { height: '0px', paddingBottom: '0px', opacity: 0 }
+        ], { duration: reducedMotion.matches ? 0 : 260, easing: 'ease', fill: 'forwards' });
+        await collapse.finished;
+
+        const nextButton = (item.nextElementSibling || item.previousElementSibling)?.querySelector('button');
+        const restoreFocus = item.contains(document.activeElement);
+        const name = item.querySelector('h3').textContent;
+        item.remove();
+        const count = cart.children.length;
+        cartCount.textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
+        emptyCart.hidden = count !== 0;
+        cartStatus.textContent = `${name} removed. ${count} ${count === 1 ? 'item' : 'items'} in your cart.`;
+        if (restoreFocus) {
+          const focusTarget = nextButton || document.querySelector('#cart-title');
+          if (!nextButton) focusTarget.tabIndex = -1;
+          focusTarget.focus();
+        }
+      }
+
+      button.addEventListener('click', () => removeItem());
+      content.addEventListener('pointerdown', (event) => {
+        if (removing || pointerId !== null || !event.isPrimary || event.button !== 0 || event.target.closest('button')) return;
+        pointerId = event.pointerId;
+        startX = event.clientX;
+        startY = event.clientY;
+      });
+
+      content.addEventListener('pointermove', (event) => {
+        if (event.pointerId !== pointerId || removing) return;
+        const dx = event.clientX - startX;
+        const dy = event.clientY - startY;
+        if (!dragging) {
+          if (Math.max(Math.abs(dx), Math.abs(dy)) < 8) return;
+          if (Math.abs(dy) >= Math.abs(dx)) {
+            resetSwipe();
+            return;
+          }
+          dragging = true;
+          content.setPointerCapture(pointerId);
+          item.classList.add('is-dragging');
+        }
+        offset = dx;
+        content.style.transform = `translateX(${offset}px)`;
+        item.classList.toggle('is-ready', Math.abs(offset) >= threshold());
+      });
+
+      content.addEventListener('pointerup', (event) => {
+        if (event.pointerId !== pointerId) return;
+        if (dragging && Math.abs(offset) >= threshold()) {
+          removeItem(Math.sign(offset));
+        } else {
+          resetSwipe();
+        }
+      });
+
+      ['pointercancel', 'lostpointercapture'].forEach((type) => {
+        content.addEventListener(type, () => {
+          if (!removing) resetSwipe();
+        });
+      });
+      // A mouse released outside the row before dragging should not leave it active.
+      window.addEventListener('pointerup', (event) => {
+        if (event.pointerId === pointerId) resetSwipe();
+      });
+    });
+  </script>
