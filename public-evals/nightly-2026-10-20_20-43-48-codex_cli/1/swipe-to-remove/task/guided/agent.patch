+  <script>
+    const list = document.querySelector('.SwipeableList');
+    const status = document.querySelector('.cart-status');
+    const handles = new WeakMap();
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+    const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+    const resizeObserver = needsScrollWorkaround ? new ResizeObserver(entries => {
+      for (const { target } of entries) {
+        target.scrollLeft = target.clientWidth;
+      }
+    }) : null;
+
+    const viewportObserver = new IntersectionObserver(entries => {
+      for (const entry of entries) {
+        const item = entry.target;
+        if (item.classList.contains('is-removing')) continue;
+        if (entry.isIntersecting) {
+          const handle = handles.get(item) || setupItem(item);
+          handle.observer.observe(handle.content);
+        } else {
+          handles.get(item)?.observer.disconnect();
+        }
+      }
+    });
+
+    function setupItem(item) {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      item.classList.add('is-initialized');
+      // Center before observing: an initial spacer must never count as a swipe.
+      if (needsScrollWorkaround) {
+        track.scrollLeft = track.clientWidth;
+        resizeObserver.observe(track);
+      }
+      const observer = new IntersectionObserver(entries => {
+        const entry = entries.at(-1);
+        if (item.classList.contains('is-removing') || !entry.rootBounds) return;
+        // Only horizontal displacement commits removal; vertical page scrolling cannot.
+        const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+        const distance = Math.abs(offset) / entry.boundingClientRect.width;
+        item.classList.toggle('is-activating', distance > 0.2);
+        if (distance > 0.8) removeItem(item, Math.sign(offset));
+      }, { root: track, threshold: [0, 0.2, 0.8, 1] });
+      const handle = { observer, content };
+      handles.set(item, handle);
+      return handle;
+    }
+
+    async function removeItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      const height = item.getBoundingClientRect().height;
+      const width = track.clientWidth;
+      viewportObserver.unobserve(item);
+      handles.get(item)?.observer.disconnect();
+      resizeObserver?.unobserve(track);
+      item.classList.add('is-removing');
+
+      if (item.contains(document.activeElement)) {
+        const remaining = [...list.children].filter(row => row !== item && !row.classList.contains('is-removing'));
+        (remaining[0]?.querySelector('.cart-remove') || document.getElementById('cart-title')).focus({ preventScroll: true });
+      }
+      item.inert = true;
+      const count = list.querySelectorAll('.SwipeableList-item:not(.is-removing)').length;
+      document.getElementById('cart-count').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
+      status.textContent = `${item.dataset.name} removed.${count === 0 ? ' Your cart is empty.' : ''}`;
+
+      const options = { duration: reducedMotion.matches ? 0 : 300, easing: 'ease', fill: 'forwards' };
+      const animations = [
+        item.animate([{ height: `${height}px` }, { height: '0px' }], options),
+        content.animate([{ transform: 'translateX(0)' }, { transform: `translateX(${direction * width}px)` }], options)
+      ];
+      await Promise.allSettled(animations.map(animation => animation.finished));
+      // Let Safari's latched swipe momentum settle before detaching the row.
+      if (globalThis.GestureEvent) setTimeout(() => item.remove(), 5000);
+      else item.remove();
+    }
+
+    list.addEventListener('click', event => {
+      const button = event.target.closest('.cart-remove');
+      if (button) removeItem(button.closest('.SwipeableList-item'));
+    });
+
+    for (const item of list.children) viewportObserver.observe(item);
+  </script>
