@@ -0,0 +1,701 @@
+import { useEffect, useRef, useState } from "react";
+import {
+  ArrowLeftIcon,
+  ArrowRightIcon,
+  CheckIcon,
+  ChevronRightIcon,
+  ComputerDesktopIcon,
+  DevicePhoneMobileIcon,
+  FingerPrintIcon,
+  KeyIcon,
+  LockClosedIcon,
+  PencilSquareIcon,
+  PlusIcon,
+  ShieldCheckIcon,
+  TrashIcon,
+  UserCircleIcon,
+  XMarkIcon,
+} from "@heroicons/react/24/outline";
+
+type Credential = {
+  provider?: string;
+  providerIcon?: string;
+  id: string;
+  name: string;
+  aaguid: string;
+  backedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+  transports?: string[];
+};
+type Account = {
+  id: string;
+  name: string;
+  displayName: string;
+  rpId: string;
+  credentials: Credential[];
+};
+type DialogAction = { type: "rename" | "delete"; credential: Credential };
+const base = import.meta.env.BASE_URL;
+class ApiError extends Error {
+  constructor(
+    message: string,
+    public status: number,
+  ) {
+    super(message);
+  }
+}
+async function api(action: string, method = "GET", body?: unknown) {
+  const response = await fetch(`${base}api/account/${action}`, {
+    method,
+    headers: { "Content-Type": "application/json" },
+    ...(body ? { body: JSON.stringify(body) } : {}),
+  });
+  const data = await response.json();
+  if (!response.ok)
+    throw new ApiError(
+      data.error || "Something went wrong. Please try again.",
+      response.status,
+    );
+  return data;
+}
+async function sync(account: Account) {
+  if (!window.PublicKeyCredential?.signalAllAcceptedCredentials) return;
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId: account.rpId,
+      userId: account.id,
+      allAcceptedCredentialIds: account.credentials.map((c) => c.id),
+    });
+  } catch {
+    /* Provider synchronization is best effort. */
+  }
+}
+const date = (timestamp: number) =>
+  new Date(timestamp).toLocaleDateString("en-US", {
+    month: "short",
+    day: "numeric",
+    year: "numeric",
+  });
+
+export default function PasskeySettings() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [supported, setSupported] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [tab, setTab] = useState("security");
+  const [action, setAction] = useState<DialogAction | null>(null);
+  const [name, setName] = useState("");
+  const [displayName, setDisplayName] = useState("");
+  const dialog = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    let active = true;
+    api("credentials")
+      .then((data) => {
+        if (active) {
+          setAccount(data);
+          setDisplayName(data.displayName);
+          void sync(data);
+        }
+      })
+      .catch((e) => {
+        if (active && e.message !== "Sign in to manage your passkeys.")
+          setError(e.message);
+      })
+      .finally(() => {
+        if (active) setLoading(false);
+      });
+    (async () => {
+      if (!window.PublicKeyCredential || !window.isSecureContext) return;
+      await import("webauthn-polyfills");
+      const capabilities = await PublicKeyCredential.getClientCapabilities();
+      if (active) setSupported(!!capabilities.passkeyPlatformAuthenticator);
+    })().catch(() => {});
+    return () => {
+      active = false;
+    };
+  }, []);
+
+  async function refresh() {
+    const data = await api("credentials");
+    setAccount(data);
+    return data as Account;
+  }
+  function openDialog(type: DialogAction["type"], credential: Credential) {
+    setError("");
+    setNotice("");
+    setName(credential.name);
+    setAction({ type, credential });
+    dialog.current?.showModal();
+  }
+  async function changeCredential(event: React.FormEvent) {
+    event.preventDefault();
+    if (!action) return;
+    setBusy(true);
+    setError("");
+    try {
+      await api("credential", action.type === "delete" ? "DELETE" : "PUT", {
+        id: action.credential.id,
+        name,
+      });
+      const next = await refresh();
+      if (action.type === "delete") await sync(next);
+      setNotice(
+        action.type === "delete"
+          ? "Passkey removed from your account."
+          : "Passkey name updated.",
+      );
+      dialog.current?.close();
+      setAction(null);
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function createPasskey() {
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      const options = await api("options", "POST");
+      const credential = (await navigator.credentials.create({
+        publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options),
+      })) as PublicKeyCredential | null;
+      if (!credential) throw new Error("Passkey creation was cancelled.");
+      try {
+        await api("verify", "POST", credential.toJSON());
+      } catch (error) {
+        // An explicit rejection leaves an orphan in the provider. A lost network
+        // response is ambiguous: avoid removing a potentially saved credential.
+        if (
+          error instanceof ApiError &&
+          error.status === 400 &&
+          typeof PublicKeyCredential.signalUnknownCredential === "function"
+        ) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: options.rp.id,
+              credentialId: credential.id,
+            });
+          } catch {
+            /* Optional provider synchronization. */
+          }
+        }
+        throw error;
+      }
+      await sync(await refresh());
+      setNotice("Your new passkey is ready.");
+    } catch (e) {
+      const err = e as Error;
+      setError(
+        err.name === "NotAllowedError" || err.name === "AbortError"
+          ? "Passkey creation was cancelled. You can try again whenever you’re ready."
+          : err.name === "InvalidStateError"
+            ? "A passkey already exists in this password manager."
+            : err.name === "SecurityError"
+              ? "Passkeys require a secure connection to this website."
+              : err.message,
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  async function saveProfile(e: React.FormEvent) {
+    e.preventDefault();
+    setBusy(true);
+    setError("");
+    setNotice("");
+    try {
+      await api("profile", "PUT", { displayName });
+      const next = await refresh();
+      if (
+        typeof window.PublicKeyCredential?.signalCurrentUserDetails ===
+        "function"
+      ) {
+        try {
+          await PublicKeyCredential.signalCurrentUserDetails({
+            rpId: next.rpId,
+            userId: next.id,
+            name: next.name,
+            displayName: next.displayName,
+          });
+        } catch {
+          /* Optional provider synchronization. */
+        }
+      }
+      setNotice("Your profile has been updated.");
+    } catch (e) {
+      setError((e as Error).message);
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <div className="account-shell">
+      <div className="account-breadcrumb">
+        <a href={base}>Home</a>
+        <ChevronRightIcon />
+        <span>My account</span>
+        <ChevronRightIcon />
+        <span>
+          {tab === "security" ? "Sign-in & security" : "Personal information"}
+        </span>
+      </div>
+      <div className="account-title-row">
+        <div>
+          <p className="account-eyebrow">YOUR TIMES, YOUR WAY</p>
+          <h1>My account</h1>
+        </div>
+        <a className="back-news" href={base}>
+          <ArrowLeftIcon /> Back to the news
+        </a>
+      </div>
+      <div className="account-layout">
+        <aside className="account-sidebar">
+          <div className="account-identity">
+            <div className="account-avatar">
+              <UserCircleIcon />
+            </div>
+            <div>
+              <strong>{account?.displayName || "Your account"}</strong>
+              <span>Times reader</span>
+            </div>
+          </div>
+          <p className="sidebar-label">ACCOUNT SETTINGS</p>
+          <nav aria-label="Account settings">
+            <button
+              className={tab === "profile" ? "selected" : ""}
+              onClick={() => {
+                setTab("profile");
+                setError("");
+                setNotice("");
+              }}
+            >
+              <UserCircleIcon />
+              Personal information
+              <ChevronRightIcon />
+            </button>
+            <button
+              className={tab === "security" ? "selected" : ""}
+              onClick={() => {
+                setTab("security");
+                setError("");
+                setNotice("");
+              }}
+            >
+              <ShieldCheckIcon />
+              Sign-in & security
+              <ChevronRightIcon />
+            </button>
+          </nav>
+          <div className="sidebar-note">
+            <LockClosedIcon />
+            <p>
+              A little peace of mind.
+              <br />
+              <span>
+                Keep your account secure so you can focus on the stories that
+                matter.
+              </span>
+            </p>
+          </div>
+        </aside>
+        <section
+          className="settings-content"
+          aria-labelledby="settings-heading"
+        >
+          <div className="settings-heading">
+            <div className="section-symbol">
+              <ShieldCheckIcon />
+            </div>
+            <div>
+              <h2 id="settings-heading">
+                {tab === "security"
+                  ? "Sign-in & security"
+                  : "Personal information"}
+              </h2>
+              <p>
+                {tab === "security"
+                  ? "A safer, simpler way to access your account."
+                  : "Make yourself at home. Keep your details up to date."}
+              </p>
+            </div>
+          </div>
+          {error && !dialog.current?.open && (
+            <div className="settings-alert error" role="alert">
+              {error}
+            </div>
+          )}
+          {notice && (
+            <div className="settings-alert success" role="status">
+              <CheckIcon />
+              {notice}
+            </div>
+          )}
+          {tab === "security" ? (
+            <>
+              <div className="passkey-intro">
+                <div className="passkey-copy">
+                  <span className="small-label">
+                    LESS FRICTION. MORE PROTECTION.
+                  </span>
+                  <h3>Your key to a safer account.</h3>
+                  <p>
+                    Skip the password. With a passkey, sign in using your
+                    fingerprint, face, or device screen lock.
+                  </p>
+                  <div className="intro-badges">
+                    <span>
+                      <CheckIcon /> Phishing resistant
+                    </span>
+                    <span>
+                      <CheckIcon /> Uniquely yours
+                    </span>
+                  </div>
+                </div>
+                <div className="passkey-art" aria-hidden="true">
+                  <div className="art-orbit orbit-one" />
+                  <div className="art-orbit orbit-two" />
+                  <div className="art-card">
+                    <FingerPrintIcon />
+                    <span>
+                      <LockClosedIcon /> SECURE BY DESIGN
+                    </span>
+                  </div>
+                  <div className="art-check">
+                    <CheckIcon />
+                  </div>
+                  <div className="art-spark spark-one">+</div>
+                  <div className="art-spark spark-two">+</div>
+                </div>
+              </div>
+              <div className="passkeys-panel">
+                <div className="panel-heading">
+                  <div>
+                    <h3>
+                      Passkeys{" "}
+                      <span className="count">
+                        {account?.credentials.length ?? 0}
+                      </span>
+                    </h3>
+                    <p>Manage the passkeys connected to your account.</p>
+                  </div>
+                  {account && supported && (
+                    <button
+                      className="primary-button"
+                      onClick={createPasskey}
+                      disabled={busy}
+                    >
+                      <PlusIcon />
+                      {busy ? "Please wait…" : "Create a passkey"}
+                    </button>
+                  )}
+                </div>
+                {loading ? (
+                  <div className="passkey-empty" role="status">
+                    <KeyIcon />
+                    <h4>Loading your passkeys…</h4>
+                  </div>
+                ) : !account ? (
+                  <div className="passkey-empty">
+                    <div className="empty-symbol">
+                      <KeyIcon />
+                    </div>
+                    <h4>A more personal, more secure Times.</h4>
+                    <p>
+                      Sign in to view your passkeys and manage your account
+                      security.
+                    </p>
+                    <a
+                      className="primary-button"
+                      href={`${base}signin?redirect=account/security`}
+                    >
+                      Sign in to your account <ArrowRightIcon />
+                    </a>
+                    <span className="empty-footnote">
+                      New to The Times?{" "}
+                      <a href={`${base}signup`}>Create an account</a>
+                    </span>
+                  </div>
+                ) : account.credentials.length === 0 ? (
+                  <div className="passkey-empty">
+                    <div className="empty-symbol">
+                      <KeyIcon />
+                    </div>
+                    <h4>Your next sign-in could be simpler.</h4>
+                    <p>
