new file mode 100644
index 0000000..7e8aca6
--- /dev/null
+++ b/src/pages/api/account/authenticate.ts
@@ -0,0 +1,74 @@
+import type { APIRoute } from "astro";
+import {
+  generateAuthenticationOptions,
+  verifyAuthenticationResponse,
+} from "@simplewebauthn/server";
+import { accounts } from "../../../lib/passkeys";
+export const POST: APIRoute = async ({ request, session, url }) => {
+  const reply = (data: unknown, status = 200) =>
+    Response.json(data, { status, headers: { "Cache-Control": "no-store" } });
+  if (request.headers.get("origin") !== url.origin)
+    return reply({ error: "Invalid origin." }, 403);
+  if (!session) return reply({ error: "Session unavailable." }, 503);
+  try {
+    const body = await request.json();
+    if (body.options === true) {
+      const options = await generateAuthenticationOptions({
+        rpID: url.hostname,
+        allowCredentials: [],
+        userVerification: "required",
+      });
+      await session.set("authenticationChallenge", {
+        value: options.challenge,
+        expires: Date.now() + 300000,
+        userVerification: "required",
+      });
+      return reply(options);
+    }
+    const challenge = (await session.get("authenticationChallenge")) as
+      { value: string; expires: number; userVerification: string } | undefined;
+    await session.delete("authenticationChallenge");
+    if (!challenge || challenge.expires < Date.now())
+      return reply({ error: "Sign-in expired. Please try again." }, 400);
+    const userId = await accounts(async (records) => {
+      const account = Object.values(records).find((a) =>
+        a.credentials.some((c) => c.id === body.id),
+      );
+      if (!account) return null;
+      const credential = account.credentials.find((c) => c.id === body.id)!;
+      if (body.response?.userHandle && body.response.userHandle !== account.id)
+        throw new Error("Unable to verify this passkey.");
+      const result = await verifyAuthenticationResponse({
+        response: body,
+        expectedChallenge: challenge.value,
+        expectedOrigin: url.origin,
+        expectedRPID: url.hostname,
+        requireUserVerification: challenge.userVerification === "required",
+        credential: {
+          id: credential.id,
+          publicKey: Buffer.from(credential.publicKey, "base64url"),
+          counter: credential.counter,
+          transports: credential.transports,
+        },
+      });
+      if (!result.verified) throw new Error("Unable to verify this passkey.");
+      credential.counter = result.authenticationInfo.newCounter;
+      credential.lastUsedAt = Date.now();
+      credential.backedUp = result.authenticationInfo.credentialBackedUp;
+      return account.id;
+    });
+    if (!userId)
+      return reply(
+        { error: "This passkey is no longer connected to an account." },
+        404,
+      );
+    await session.regenerate();
+    await session.set("accountId", userId);
+    return reply({ success: true });
+  } catch {
+    return reply(
+      { error: "Unable to sign in with this passkey. Please try again." },
+      400,
+    );
+  }
+};
diff --git a/src/pages/api/account/login.ts b/src/pages/api/account/login.ts
new file mode 100644
index 0000000..6c5b09e
--- /dev/null
+++ b/src/pages/api/account/login.ts
@@ -0,0 +1,53 @@
+import type { APIRoute } from "astro";
+import { createHash } from "node:crypto";
+import { accounts } from "../../../lib/passkeys";
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (request.headers.get("origin") !== url.origin)
+    return Response.json({ error: "Invalid origin." }, { status: 403 });
+  if (!session)
+    return Response.json({ error: "Session unavailable." }, { status: 503 });
+  try {
+    const { username, password } = await request.json();
+    if (
+      typeof username !== "string" ||
+      typeof password !== "string" ||
+      !username.trim() ||
+      !password
+    )
+      return Response.json(
+        { error: "Enter your username and password." },
+        { status: 400 },
+      );
+    const response = await fetch(
+      "https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login",
+      {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ username, password }),
+        signal: AbortSignal.timeout(15000),
+      },
+    );
+    if (!response.ok)
+      return Response.json(
+        { error: "Incorrect username or password." },
+        { status: 401 },
+      );
+    const id = createHash("sha256").update(username).digest("base64url");
+    await accounts((records) => {
+      records[id] ??= {
+        id,
+        name: username,
+        displayName: username,
+        credentials: [],
+      };
+    });
+    await session.regenerate();
+    await session.set("accountId", id);
+    return Response.json({ success: true });
+  } catch {
+    return Response.json(
+      { error: "Unable to sign in. Please try again." },
+      { status: 503 },
+    );
+  }
+};
