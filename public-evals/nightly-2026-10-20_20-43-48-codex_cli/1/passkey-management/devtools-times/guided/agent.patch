+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import {
+  createHash,
+  generateKeyPairSync,
+  randomBytes,
+  sign,
+} from "node:crypto";
+import { setTimeout as delay } from "node:timers/promises";
+
+// A small CBOR encoder for the synthetic authenticator's test fixtures.
+function cbor(value) {
+  const head = (major, n) =>
+    n < 24
+      ? Buffer.from([major * 32 + n])
+      : n < 256
+        ? Buffer.from([major * 32 + 24, n])
+        : Buffer.from([major * 32 + 25, n >> 8, n & 255]);
+  if (Buffer.isBuffer(value))
+    return Buffer.concat([head(2, value.length), value]);
+  if (typeof value === "string") {
+    const bytes = Buffer.from(value);
+    return Buffer.concat([head(3, bytes.length), bytes]);
+  }
+  if (typeof value === "number")
+    return head(value < 0 ? 1 : 0, value < 0 ? -1 - value : value);
+  if (value instanceof Map)
+    return Buffer.concat([
+      head(5, value.size),
+      ...[...value].flatMap(([k, v]) => [cbor(k), cbor(v)]),
+    ]);
+  throw new Error("Unsupported test fixture");
+}
+
+test("passkey registration, account isolation, management, and authentication over HTTP", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "times-passkeys-"));
+  const port = 14000 + Math.floor(Math.random() * 10000);
+  const origin = `http://localhost:${port}`;
+  const base = `${origin}/devtools-times/`;
+  const mock = `const original = globalThis.fetch; globalThis.fetch = (url, options) => String(url) === 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/login' ? Promise.resolve(Response.json({success: JSON.parse(options.body).password === 'test-password'}, {status: JSON.parse(options.body).password === 'test-password' ? 200 : 401})) : original(url, options);`;
+  const server = spawn(
+    process.execPath,
+    [
+      "--import",
+      `data:text/javascript,${encodeURIComponent(mock)}`,
+      "dist/server/entry.mjs",
+    ],
+    {
+      env: {
+        ...process.env,
+        HOST: "localhost",
+        PORT: String(port),
+        PASSKEY_STORE_PATH: join(directory, "passkeys.json"),
+      },
+      stdio: "pipe",
+    },
+  );
+  let output = "";
+  server.stderr.on("data", (chunk) => (output += chunk));
+  server.stdout.on("data", (chunk) => (output += chunk));
+  function client() {
+    let cookie = "";
+    return async (action, method = "GET", body, requestOrigin = origin) => {
+      const response = await fetch(`${base}api/account/${action}`, {
+        method,
+        headers: {
+          Origin: requestOrigin,
+          Cookie: cookie,
+          "Content-Type": "application/json",
+        },
+        ...(body ? { body: JSON.stringify(body) } : {}),
+      });
+      for (const value of response.headers.getSetCookie())
+        cookie = value.split(";")[0];
+      return { status: response.status, data: await response.json() };
+    };
+  }
+  try {
+    let ready = false;
+    for (let i = 0; i < 100; i++) {
+      try {
+        await fetch(`${base}api/account/credentials`);
+        ready = true;
+        break;
+      } catch {
+        await delay(50);
+      }
+    }
+    assert.ok(ready, output);
+    const page = await fetch(`${base}account/security`);
+    assert.equal(page.status, 200);
+    assert.match(await page.text(), /Sign-in &amp; security/);
+    const alice = client();
+    assert.equal((await alice("credentials")).status, 401);
+    assert.equal(
+      (await alice("login", "POST", { username: "alice", password: "wrong" }))
+        .status,
+      401,
+    );
+    assert.equal(
+      (
+        await alice(
+          "login",
+          "POST",
+          { username: "alice", password: "test-password" },
+          "https://other.example",
+        )
+      ).status,
+      403,
+    );
+    assert.equal(
+      (
+        await alice("login", "POST", {
+          username: "alice",
+          password: "test-password",
+        })
+      ).status,
+      200,
+    );
+    const account = (await alice("credentials")).data;
+    assert.deepEqual(account.credentials, []);
+    const options = (await alice("options", "POST")).data;
+    assert.equal(options.authenticatorSelection.residentKey, "required");
+    assert.equal(
+      options.authenticatorSelection.authenticatorAttachment,
+      undefined,
+    );
+    assert.equal(options.rp.id, "localhost");
+    const { publicKey, privateKey } = generateKeyPairSync("ec", {
+      namedCurve: "prime256v1",
+    });
+    const jwk = publicKey.export({ format: "jwk" });
+    const cose = cbor(
+      new Map([
+        [1, 2],
+        [3, -7],
+        [-1, 1],
+        [-2, Buffer.from(jwk.x, "base64url")],
+        [-3, Buffer.from(jwk.y, "base64url")],
+      ]),
+    );
+    const credentialId = randomBytes(32);
+    const id = credentialId.toString("base64url");
+    const rpHash = createHash("sha256").update("localhost").digest();
+    const authData = Buffer.concat([
+      rpHash,
+      Buffer.from([0x45]),
+      Buffer.alloc(4),
+      Buffer.alloc(16),
+      Buffer.from([0, 32]),
+      credentialId,
+      cose,
+    ]);
+    const clientData = Buffer.from(
+      JSON.stringify({
+        type: "webauthn.create",
+        challenge: options.challenge,
+        origin,
+      }),
+    );
+    const registration = {
+      id,
+      rawId: id,
+      type: "public-key",
+      response: {
+        clientDataJSON: clientData.toString("base64url"),
+        attestationObject: cbor(
+          new Map([
+            ["fmt", "none"],
+            ["attStmt", new Map()],
+            ["authData", authData],
+          ]),
+        ).toString("base64url"),
+        transports: ["internal"],
+      },
+      clientExtensionResults: {},
+    };
+    const registered = await alice("verify", "POST", registration);
+    assert.equal(registered.status, 200, JSON.stringify(registered.data));
+    assert.equal(
+      (await alice("verify", "POST", registration)).status,
+      400,
+      "Challenge must be single-use",
+    );
+    let credentials = (await alice("credentials")).data.credentials;
+    assert.equal(credentials.length, 1);
+    assert.equal(
+      credentials[0].publicKey,
+      undefined,
+      "Public keys are not exposed in the management API",
+    );
+    assert.equal(credentials[0].provider, "Unknown passkey provider");
+    assert.equal(
+      (await alice("credential", "PUT", { id, name: "   " })).status,
+      400,
+    );
+    assert.equal(
+      (await alice("credential", "PUT", { id, name: "My laptop" })).status,
+      200,
+    );
+    assert.equal(
+      (await alice("credentials")).data.credentials[0].name,
+      "My laptop",
+    );
+    assert.equal(
+      (await alice("profile", "PUT", { displayName: "Alice Reader" })).status,
+      200,
+    );
+    assert.equal((await alice("credentials")).data.displayName, "Alice Reader");
+    const bob = client();
+    await bob("login", "POST", { username: "bob", password: "test-password" });
+    assert.equal((await bob("credential", "DELETE", { id })).status, 400);
+    assert.deepEqual((await bob("credentials")).data.credentials, []);
+    const passkeyLogin = client();
+    const authOptions = (
+      await passkeyLogin("authenticate", "POST", { options: true })
+    ).data;
+    const assertionData = Buffer.from(
+      JSON.stringify({
+        type: "webauthn.get",
+        challenge: authOptions.challenge,
+        origin,
+      }),
+    );
+    const assertionAuthData = Buffer.concat([
+      rpHash,
+      Buffer.from([0x05]),
+      Buffer.from([0, 0, 0, 1]),
+    ]);
+    const signature = sign(
+      "sha256",
+      Buffer.concat([
+        assertionAuthData,
+        createHash("sha256").update(assertionData).digest(),
+      ]),
+      privateKey,
+    );
+    const assertion = {
+      id,
+      rawId: id,
+      type: "public-key",
+      clientExtensionResults: {},
+      response: {
+        clientDataJSON: assertionData.toString("base64url"),
+        authenticatorData: assertionAuthData.toString("base64url"),
+        signature: signature.toString("base64url"),
+        userHandle: account.id,
+      },
+    };
+    const authenticated = await passkeyLogin("authenticate", "POST", assertion);
+    assert.equal(authenticated.status, 200, JSON.stringify(authenticated.data));
+    credentials = (await passkeyLogin("credentials")).data.credentials;
+    assert.ok(credentials[0].lastUsedAt > 0);
+    assert.equal((await passkeyLogin("credentials")).data.id, account.id);
+    assert.equal((await alice("credential", "DELETE", { id })).status, 200);
+    assert.deepEqual((await alice("credentials")).data.credentials, []);
+    const relogin = client();
+    await relogin("authenticate", "POST", { options: true });
+    assert.equal(
+      (await relogin("authenticate", "POST", assertion)).status,
+      404,
+    );
+  } finally {
+    server.kill();
+    await new Promise((resolve) => server.once("exit", resolve));
+    await rm(directory, { recursive: true, force: true });
+  }
+});
