+                  </article>
+                  <article>
+                    <div className="knowledge-icon">
+                      <ComputerDesktopIcon />
+                    </div>
+                    <h4>Go where you go</h4>
+                    <p>
+                      Save a passkey in your password manager to use it across
+                      your devices.
+                    </p>
+                  </article>
+                </div>
+              </div>
+              <div className="faq">
+                <h3>A few things you might be wondering</h3>
+                <details>
+                  <summary>Can I still sign in with my password?</summary>
+                  <p>
+                    Yes. Adding or removing a passkey doesn’t change your
+                    password. You can continue to sign in with your username and
+                    password.
+                  </p>
+                </details>
+                <details>
+                  <summary>What happens when I remove a passkey?</summary>
+                  <p>
+                    That passkey will no longer be connected to your Times
+                    account. Your password manager may also need you to remove
+                    its saved copy. Other passkeys and your password will
+                    continue to work.
+                  </p>
+                </details>
+                <details>
+                  <summary>What if I lose my device?</summary>
+                  <p>
+                    If your passkey is synced, it may be available on another
+                    device through your password manager. You can also use your
+                    password to sign in and remove a lost device’s passkey.
+                  </p>
+                </details>
+              </div>
+            </>
+          ) : (
+            <div className="passkeys-panel profile-panel">
+              <h3>Your details</h3>
+              {account ? (
+                <form onSubmit={saveProfile}>
+                  <label>
+                    Username
+                    <input value={account.name} readOnly />
+                  </label>
+                  <p className="field-help">
+                    Your username is used to sign in.
+                  </p>
+                  <label htmlFor="display-name">
+                    Display name
+                    <input
+                      id="display-name"
+                      value={displayName}
+                      onChange={(e) => setDisplayName(e.target.value)}
+                      maxLength={80}
+                      required
+                    />
+                  </label>
+                  <button className="primary-button" disabled={busy}>
+                    Save changes
+                  </button>
+                </form>
+              ) : (
+                <p>
+                  <a
+                    className="text-button"
+                    href={`${base}signin?redirect=account/security`}
+                  >
+                    Sign in to manage your profile <ArrowRightIcon />
+                  </a>
+                </p>
+              )}
+            </div>
+          )}
+          <p className="account-help">
+            Your trust matters. Read our{" "}
+            <a href={`${base}legal/privacy`}>
+              Privacy Policy <ArrowRightIcon />
+            </a>
+          </p>
+        </section>
+      </div>
+      <dialog
+        ref={dialog}
+        className="passkey-dialog"
+        aria-labelledby="passkey-dialog-title"
+        onClose={() => setAction(null)}
+      >
+        <form onSubmit={changeCredential}>
+          <button
+            type="button"
+            className="dialog-close"
+            aria-label="Close dialog"
+            onClick={() => dialog.current?.close()}
+          >
+            <XMarkIcon />
+          </button>
+          <div className="dialog-symbol">
+            <KeyIcon />
+          </div>
+          <h2 id="passkey-dialog-title">
+            {action?.type === "rename"
+              ? "Rename passkey"
+              : "Remove this passkey?"}
+          </h2>
+          {action?.type === "rename" ? (
+            <>
+              <p>Choose a name that helps you recognize this passkey.</p>
+              <label htmlFor="passkey-name">Passkey name</label>
+              <input
+                id="passkey-name"
+                autoFocus
+                required
+                maxLength={60}
+                value={name}
+                onChange={(e) => setName(e.target.value)}
+              />
+            </>
+          ) : (
+            <p>
+              “{action?.credential.name}” will no longer work with your account.
+              You can still sign in with your password or another passkey.
+            </p>
+          )}
+          {error && (
+            <div className="settings-alert error" role="alert">
+              {error}
+            </div>
+          )}
+          <div className="dialog-buttons">
+            <button
+              className="secondary-button"
+              type="button"
+              onClick={() => dialog.current?.close()}
+            >
+              Cancel
+            </button>
+            <button
+              className={
+                action?.type === "delete" ? "danger-button" : "primary-button"
+              }
+              disabled={busy || (action?.type === "rename" && !name.trim())}
+            >
+              {busy
+                ? "Saving…"
+                : action?.type === "rename"
+                  ? "Save name"
+                  : "Remove passkey"}
+            </button>
+          </div>
+        </form>
+      </dialog>
+    </div>
+  );
+}
