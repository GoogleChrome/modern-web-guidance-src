@@ -0,0 +1,79 @@
+import { useEffect, useState } from "react";
+import { FingerPrintIcon } from "@heroicons/react/24/outline";
+export default function PasskeySignIn() {
+  const [available, setAvailable] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  useEffect(() => {
+    if (window.PublicKeyCredential && window.isSecureContext)
+      import("webauthn-polyfills")
+        .then(() => setAvailable(true))
+        .catch(() => {});
+  }, []);
+  if (!available) return null;
+  async function signIn() {
+    setBusy(true);
+    setError("");
+    const url = `${import.meta.env.BASE_URL}api/account/authenticate`;
+    const post = (body: unknown) =>
+      fetch(url, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify(body),
+      });
+    try {
+      const response = await post({ options: true });
+      const options = await response.json();
+      if (!response.ok) throw new Error(options.error);
+      const credential = (await navigator.credentials.get({
+        publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(options),
+      })) as PublicKeyCredential | null;
+      if (!credential) return;
+      const result = await post(credential.toJSON());
+      if (!result.ok) {
+        if (
+          result.status === 404 &&
+          PublicKeyCredential.signalUnknownCredential
+        ) {
+          try {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId: options.rpId,
+              credentialId: credential.id,
+            });
+          } catch {
+            /* Optional manager synchronization. */
+          }
+        }
+        throw new Error((await result.json()).error);
+      }
+      window.location.assign(`${import.meta.env.BASE_URL}account/security`);
+    } catch (e) {
+      const err = e as Error;
+      setError(
+        ["NotAllowedError", "AbortError"].includes(err.name)
+          ? "Passkey sign-in was cancelled. You can try again or use your password."
+          : err.message,
+      );
+    } finally {
+      setBusy(false);
+    }
+  }
+  return (
+    <div className="mt-6 border-t border-gray-200 pt-5">
+      <button
+        type="button"
+        disabled={busy}
+        onClick={signIn}
+        className="flex w-full items-center justify-center gap-2 rounded-md border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-50 disabled:opacity-50"
+      >
+        <FingerPrintIcon className="h-5 w-5" />
+        {busy ? "Waiting for your passkey…" : "Sign in with a passkey"}
+      </button>
+      {error && (
+        <p className="mt-3 text-sm text-red-700" role="alert">
+          {error}
+        </p>
+      )}
+    </div>
+  );
+}
