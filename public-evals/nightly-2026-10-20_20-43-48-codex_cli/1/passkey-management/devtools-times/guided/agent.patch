+                      <br className="desktop-break" /> for a secure sign-in
+                      without a password.
+                    </p>
+                    {supported && (
+                      <button
+                        className="text-button"
+                        disabled={busy}
+                        onClick={createPasskey}
+                      >
+                        Create your first passkey <ArrowRightIcon />
+                      </button>
+                    )}
+                  </div>
+                ) : (
+                  <ul className="credential-list">
+                    {account.credentials.map((c) => (
+                      <li key={c.id}>
+                        <div className="credential-symbol">
+                          {c.providerIcon ? (
+                            <img
+                              src={c.providerIcon}
+                              alt={c.provider || "Passkey provider"}
+                              width={24}
+                              height={24}
+                            />
+                          ) : c.transports?.includes("internal") ? (
+                            <DevicePhoneMobileIcon />
+                          ) : (
+                            <KeyIcon />
+                          )}
+                        </div>
+                        <div className="credential-details">
+                          <h4>
+                            {c.name}{" "}
+                            <span>
+                              {c.backedUp ? "Synced passkey" : "Device passkey"}
+                            </span>
+                          </h4>
+                          <p>
+                            {c.provider}
+                            <span className="date-divider">·</span>Added{" "}
+                            {date(c.registeredAt)}
+                            <span className="date-divider">·</span>
+                            {c.lastUsedAt
+                              ? `Last used ${date(c.lastUsedAt)}`
+                              : "Not used yet"}
+                          </p>
+                        </div>
+                        <div className="credential-actions">
+                          <button
+                            onClick={() => openDialog("rename", c)}
+                            aria-label={`Rename ${c.name}`}
+                            title="Rename passkey"
+                          >
+                            <PencilSquareIcon />
+                          </button>
+                          <button
+                            onClick={() => openDialog("delete", c)}
+                            aria-label={`Remove ${c.name}`}
+                            title="Remove passkey"
+                          >
+                            <TrashIcon />
+                          </button>
+                        </div>
+                      </li>
+                    ))}
+                  </ul>
+                )}
+                <div className="panel-footnote">
+                  <LockClosedIcon />
+                  <p>
+                    Your biometric data stays on your device. It’s never shared
+                    with The Times.
+                  </p>
+                </div>
+              </div>
+              {account && !supported && !loading && (
+                <p className="unsupported-note">
+                  Passkey creation isn’t available on this device or browser.
+                  You can still manage existing passkeys and sign in with your
+                  password.
+                </p>
+              )}
+              <div className="good-to-know">
+                <div>
+                  <span className="small-label">GOOD TO KNOW</span>
+                  <h3>A small change. A stronger sign-in.</h3>
+                </div>
+                <div className="knowledge-grid">
+                  <article>
+                    <div className="knowledge-icon">
+                      <FingerPrintIcon />
+                    </div>
+                    <h4>Just be yourself</h4>
+                    <p>
