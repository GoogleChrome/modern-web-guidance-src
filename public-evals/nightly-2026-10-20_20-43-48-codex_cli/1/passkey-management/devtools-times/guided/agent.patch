new file mode 100644
index 0000000..db0219a
--- /dev/null
+++ b/src/pages/api/account/[action].ts
@@ -0,0 +1,130 @@
+import type { APIRoute } from "astro";
+import {
+  generateRegistrationOptions,
+  verifyRegistrationResponse,
+} from "@simplewebauthn/server";
+import {
+  accounts,
+  publicAccount,
+  registeredCredential,
+} from "../../../lib/passkeys";
+
+const handler: APIRoute = async ({ request, session, url, params }) => {
+  const reply = (data: unknown, status = 200) =>
+    Response.json(data, { status, headers: { "Cache-Control": "no-store" } });
+  const userId = (await session?.get("accountId")) as string | undefined;
+  if (!userId) return reply({ error: "Sign in to manage your passkeys." }, 401);
+  if (request.method !== "GET" && request.headers.get("origin") !== url.origin)
+    return reply({ error: "Invalid origin." }, 403);
+  const account = await accounts((records) => records[userId]);
+  if (!account) return reply({ error: "Account not found." }, 401);
+  const rpId = url.hostname;
+  try {
+    if (params.action === "credentials" && request.method === "GET")
+      return reply({ ...publicAccount(account), rpId });
+    if (params.action === "options" && request.method === "POST") {
+      const options = await generateRegistrationOptions({
+        rpName: "The DevTools Times",
+        rpID: rpId,
+        userID: Buffer.from(userId, "base64url"),
+        userName: account.name,
+        userDisplayName: account.displayName,
+        excludeCredentials: account.credentials.map((c) => ({
+          id: c.id,
+          transports: c.transports,
+        })),
+        authenticatorSelection: {
+          residentKey: "required",
+          requireResidentKey: true,
+          userVerification: "required",
+        },
+      });
+      await session!.set("passkeyChallenge", {
+        value: options.challenge,
+        expires: Date.now() + 300000,
+      });
+      return reply(options);
+    }
+    if (params.action === "verify" && request.method === "POST") {
+      const challenge = (await session!.get("passkeyChallenge")) as
+        { value: string; expires: number } | undefined;
+      await session!.delete("passkeyChallenge");
+      if (!challenge || challenge.expires < Date.now())
+        return reply({ error: "Registration expired. Please try again." }, 400);
+      const result = await verifyRegistrationResponse({
+        response: await request.json(),
+        expectedChallenge: challenge.value,
+        expectedOrigin: url.origin,
+        expectedRPID: rpId,
+        requireUserVerification: true,
+      });
+      if (!result.verified || !result.registrationInfo)
+        return reply({ error: "Could not verify this passkey." }, 400);
+      const credential = registeredCredential(result.registrationInfo);
+      await accounts((records) => {
+        if (
+          Object.values(records).some((a) =>
+            a.credentials.some((c) => c.id === credential.id),
+          )
+        )
+          throw new Error("This passkey is already registered.");
+        records[userId].credentials.push(credential);
+      });
+      return reply({ success: true });
+    }
+    const body = await request.json();
+    if (
+      params.action === "credential" &&
+      ["PUT", "DELETE"].includes(request.method)
+    ) {
+      await accounts((records) => {
+        const credential = records[userId].credentials.find(
+          (c) => c.id === body.id,
+        );
+        if (!credential) throw new Error("Passkey not found.");
+        if (request.method === "DELETE")
+          records[userId].credentials = records[userId].credentials.filter(
+            (c) => c.id !== body.id,
+          );
+        else {
+          if (
+            typeof body.name !== "string" ||
+            !body.name.trim() ||
+            body.name.trim().length > 60
+          )
+            throw new Error("Enter a name between 1 and 60 characters.");
+          credential.name = body.name.trim();
+        }
+      });
+      return reply({ success: true });
+    }
+    if (params.action === "profile" && request.method === "PUT") {
+      if (
+        typeof body.displayName !== "string" ||
+        !body.displayName.trim() ||
+        body.displayName.trim().length > 80
+      )
+        return reply(
+          { error: "Enter a display name between 1 and 80 characters." },
+          400,
+        );
+      await accounts((records) => {
+        records[userId].displayName = body.displayName.trim();
+      });
+      return reply({ success: true });
+    }
+    return reply({ error: "Not found." }, 404);
+  } catch (error) {
+    return reply(
+      {
+        error:
+          error instanceof Error ? error.message : "Unable to update passkeys.",
+      },
+      400,
+    );
+  }
+};
+export const GET = handler;
+export const POST = handler;
+export const PUT = handler;
+export const DELETE = handler;
