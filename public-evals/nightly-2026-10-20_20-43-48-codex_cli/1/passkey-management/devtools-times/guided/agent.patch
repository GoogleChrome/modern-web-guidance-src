diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..27387c4
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,84 @@
+import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
+import { dirname, resolve } from "node:path";
+import providers from "./passkey-providers.json";
+import type { VerifiedRegistrationResponse } from "@simplewebauthn/server";
+
+export type Passkey = {
+  id: string;
+  name: string;
+  aaguid: string;
+  publicKey: string;
+  counter: number;
+  transports?: string[];
+  backedUp: boolean;
+  registeredAt: number;
+  lastUsedAt?: number;
+};
+export type Account = {
+  id: string;
+  name: string;
+  displayName: string;
+  credentials: Passkey[];
+};
+const path = resolve(process.env.PASSKEY_STORE_PATH || ".data/passkeys.json");
+let queue = Promise.resolve();
+export async function accounts<T>(
+  operation: (records: Record<string, Account>) => T | Promise<T>,
+): Promise<T> {
+  const pending = queue.then(async () => {
+    let records: Record<string, Account>;
+    try {
+      records = JSON.parse(await readFile(path, "utf8"));
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      records = {};
+    }
+    const result = await operation(records);
+    await mkdir(dirname(path), { recursive: true });
+    await writeFile(`${path}.tmp`, JSON.stringify(records), { mode: 0o600 });
+    await rename(`${path}.tmp`, path);
+    return result;
+  });
+  queue = pending.then(
+    () => {},
+    () => {},
+  );
+  return pending;
+}
+export function publicAccount(account: Account) {
+  return {
+    ...account,
+    credentials: account.credentials.map(
+      ({ publicKey, counter, ...credential }) => {
+        const provider =
+          credential.aaguid === "00000000-0000-0000-0000-000000000000"
+            ? undefined
+            : (
+                providers as Record<
+                  string,
+                  { name: string; icon_light?: string }
+                >
+              )[credential.aaguid];
+        return {
+          ...credential,
+          provider: provider?.name || "Unknown passkey provider",
+          providerIcon: provider?.icon_light,
+        };
+      },
+    ),
+  };
+}
+export function registeredCredential(
+  info: NonNullable<VerifiedRegistrationResponse["registrationInfo"]>,
+): Passkey {
+  return {
+    id: info.credential.id,
+    name: "My passkey",
+    aaguid: info.aaguid,
+    publicKey: Buffer.from(info.credential.publicKey).toString("base64url"),
+    counter: info.credential.counter,
+    transports: info.credential.transports,
+    backedUp: info.credentialBackedUp,
+    registeredAt: Date.now(),
+  };
+}
