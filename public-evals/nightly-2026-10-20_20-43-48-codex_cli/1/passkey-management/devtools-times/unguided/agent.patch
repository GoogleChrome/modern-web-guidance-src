+import { useEffect, useRef, useState } from 'react';
+import { ArrowRightIcon, ArrowUpRightIcon, BellIcon, BookOpenIcon, CheckIcon, ChevronDownIcon, ChevronRightIcon, ComputerDesktopIcon, EllipsisHorizontalIcon, FingerPrintIcon, GlobeAltIcon, KeyIcon, LifebuoyIcon, LockClosedIcon, PlusIcon, ShieldCheckIcon, SparklesIcon, UserIcon, XMarkIcon, DevicePhoneMobileIcon } from '@heroicons/react/24/outline';
+import type { ComponentType, SVGProps } from 'react';
+import '../styles/account.css';
+type IconType = ComponentType<SVGProps<SVGSVGElement>>;
+type Passkey = { id: string; name: string; type: 'computer' | 'phone' | 'key'; provider: string; created: string; used: string; current?: boolean };
+const initial: Passkey[] = [
+  { id: 'mac', name: 'MacBook Pro', type: 'computer', provider: 'iCloud Keychain', created: 'Oct 12, 2026', used: 'Just now', current: true },
+  { id: 'iphone', name: 'iPhone 16 Pro', type: 'phone', provider: 'iCloud Keychain', created: 'Oct 12, 2026', used: '2 days ago' },
+  { id: 'yubikey', name: 'YubiKey 5C NFC', type: 'key', provider: 'Security key', created: 'Sep 28, 2026', used: '12 days ago' },
+];
+const iconFor = (type: Passkey['type']) => type === 'computer' ? ComputerDesktopIcon : type === 'phone' ? DevicePhoneMobileIcon : KeyIcon;
+function Icon({ as: Component, ...props }: { as: IconType } & SVGProps<SVGSVGElement>) { return <Component width={20} height={20} strokeWidth={1.65} {...props} />; }
+export default function PasskeySettings({ baseUrl = '/' }: { baseUrl?: string }) {
+  const [passkeys, setPasskeys] = useState(initial);
+  const [ready, setReady] = useState(false);
+  const [menu, setMenu] = useState<string | null>(null);
+  const [dialog, setDialog] = useState<'add' | 'rename' | 'remove' | 'learn' | 'profile' | 'notifications' | null>(null);
+  const [selected, setSelected] = useState<Passkey | null>(null);
+  const [name, setName] = useState('');
+  const [device, setDevice] = useState<Passkey['type']>('computer');
+  const [toast, setToast] = useState('');
+  const [tab, setTab] = useState('Passkeys');
+  const [newsletter, setNewsletter] = useState(true);
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    try { const saved = localStorage.getItem('times-passkeys-v1'); if (saved) { const data = JSON.parse(saved); if (Array.isArray(data) && data.every(p => p && typeof p.id === 'string' && typeof p.name === 'string' && ['computer', 'phone', 'key'].includes(p.type))) setPasskeys(data); } } catch { /* Use the initial preview when storage is unavailable. */ }
+    setReady(true);
+  }, []);
+  useEffect(() => { if (ready) { try { localStorage.setItem('times-passkeys-v1', JSON.stringify(passkeys)); } catch { setToast('Your browser could not save these changes.'); } } }, [passkeys, ready]);
+  useEffect(() => { if (dialog) dialogRef.current?.showModal(); else dialogRef.current?.close(); }, [dialog]);
+  useEffect(() => { if (!toast) return; const timeout = window.setTimeout(() => setToast(''), 5000); return () => clearTimeout(timeout); }, [toast]);
+  useEffect(() => { if (!menu) return; const close = () => setMenu(null); window.addEventListener('click', close); return () => window.removeEventListener('click', close); }, [menu]);
+  function open(action: 'add' | 'rename' | 'remove', passkey?: Passkey) { setSelected(passkey || null); setName(passkey?.name || ''); setDevice('computer'); setMenu(null); setDialog(action); }
+  function save(e: React.FormEvent) {
+    e.preventDefault();
+    if (dialog === 'remove' && selected) { setPasskeys(keys => keys.filter(k => k.id !== selected.id)); setToast('Passkey removed from this preview.'); }
+    else if (dialog === 'rename' && selected) { setPasskeys(keys => keys.map(k => k.id === selected.id ? { ...k, name: name.trim() } : k)); setToast('Passkey renamed.'); }
+    else if (dialog === 'add') { setPasskeys(keys => [...keys, { id: crypto.randomUUID(), name: name.trim(), type: device, provider: device === 'key' ? 'Security key' : 'This device', created: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }), used: 'Not used yet' }]); setToast('Passkey added to this preview.'); }
+    setDialog(null);
+  }
+  return <div className="account-app">
+    <aside className="sidebar">
+      <a href={baseUrl} className="brand"><span className="brand-mark">d<span>.</span></span><span>the devtools<span className="brand-bottom">times<span className="brand-dot">.</span></span></span></a>
+      <div className="workspace-label">YOUR ACCOUNT</div>
+      <nav className="account-nav" aria-label="Account settings">
+        <button onClick={() => setDialog('profile')}><Icon as={UserIcon} />Profile</button>
+        <button className="active" aria-current="page" onClick={() => setTab('Passkeys')}><Icon as={ShieldCheckIcon} />Security<span className="active-dot" /></button>
+        <button onClick={() => setDialog('notifications')}><Icon as={BellIcon} />Notifications</button>
+        <a href={`${baseUrl}#reading`} onClick={e => { e.preventDefault(); setToast('Your reading list is empty. Save an article to read it later.'); }}><Icon as={BookOpenIcon} />Reading list</a>
+      </nav>
+      <div className="sidebar-bottom">
+        <div className="subscriber-card"><span className="subscriber-icon"><Icon as={SparklesIcon} /></span><h3>A little more perspective.</h3><p>Independent journalism.<br />Unlimited possibilities.</p><a href={`${baseUrl}signup`}>Explore subscription <Icon as={ArrowUpRightIcon} /></a></div>
+        <button className="help-link" onClick={() => setDialog('learn')}><Icon as={LifebuoyIcon} />Help & support<Icon as={ArrowUpRightIcon} /></button>
+        <button className="sidebar-profile" onClick={() => setDialog('profile')}><span className="avatar">JD</span><span><strong>Jamie Davis</strong><small>Personal account</small></span><Icon as={ChevronDownIcon} /></button>
+      </div>
+    </aside>
+    <div className="workspace">
+      <header className="topbar"><div className="breadcrumb">Account <Icon as={ChevronRightIcon} /><span>Security</span></div><div className="topbar-right"><a href={`${baseUrl}news`}>Back to the Times <Icon as={ArrowUpRightIcon} /></a><span className="topbar-divider"/><button className="avatar avatar-small" aria-label="Open your profile" onClick={() => setDialog('profile')}>JD</button></div></header>
+      <main className="settings-main">
+        <div className="page-heading"><div className="eyebrow">ACCOUNT SETTINGS</div><h1>Security</h1><p>A little peace of mind. Keep your account safe and secure.</p><span className="secure-label"><Icon as={ShieldCheckIcon} /> Your account is protected</span></div>
+        <div className="tabs" role="tablist" aria-label="Security settings">{['Passkeys', 'Password', 'Two-step verification'].map(t => <button role="tab" aria-selected={tab === t} className={tab === t ? 'selected' : ''} onClick={() => setTab(t)} key={t}>{t}{t === 'Passkeys' && <span>{passkeys.length}</span>}</button>)}</div>
+        {tab === 'Passkeys' ? <div role="tabpanel">
+          <section className="passkey-intro"><div className="intro-copy"><div className="intro-kicker"><span className="tiny-star">✧</span> A SIMPLER, SAFER SIGN-IN</div><h2>Your account. Only you.</h2><p>Skip the password. Use your fingerprint, face, or device<br className="desktop-break" /> screen lock to sign in securely with a passkey.</p><button className="text-link" onClick={() => setDialog('learn')}>Get to know passkeys <Icon as={ArrowRightIcon} /></button></div><div className="key-art" aria-hidden="true"><div className="orbit orbit-one"/><div className="orbit orbit-two"/><span className="art-dot dot-one"/><span className="art-dot dot-two"/><span className="art-spark spark-one">✧</span><span className="art-spark spark-two">✧</span><div className="key-tile"><Icon as={KeyIcon} /></div><span className="key-check"><Icon as={CheckIcon} /></span></div></section>
+          <section className="registered-section"><div className="section-heading"><div><h2>Your passkeys <span>{passkeys.length}</span></h2><p>Manage the devices and security keys you use to sign in.</p></div><button className="primary-button" onClick={() => open('add')}><Icon as={PlusIcon} />Add a passkey</button></div>
+            <div className="passkeys-card"><div className="list-labels"><span>PASSKEY</span><span>LAST USED</span><span/></div>{passkeys.length === 0 ? <div className="empty-state"><Icon as={KeyIcon} /><h3>No passkeys yet</h3><p>Add a passkey for a simpler, more secure way to sign in.</p><button className="text-link" onClick={() => open('add')}>Add your first passkey <Icon as={ArrowRightIcon} /></button></div> : passkeys.map(passkey => <div className="passkey-row" key={passkey.id}><div className="passkey-info"><span className={`device-icon ${passkey.type}`}><Icon as={iconFor(passkey.type)} /></span><div><div className="device-name">{passkey.name}{passkey.current && <span className="current-badge">This device</span>}</div><div className="device-meta">{passkey.provider}<span>·</span>Added {passkey.created}</div></div></div><div className="last-used">{passkey.current && <span/>}{passkey.used}</div><div className="row-actions"><button className="more-button" aria-label={`Manage ${passkey.name}`} aria-expanded={menu === passkey.id} onClick={e => { e.stopPropagation(); setMenu(menu === passkey.id ? null : passkey.id); }}><Icon as={EllipsisHorizontalIcon} /></button>{menu === passkey.id && <div className="action-menu"><button onClick={() => open('rename', passkey)}>Rename passkey</button><button className="danger-text" onClick={() => open('remove', passkey)}>Remove passkey</button></div>}</div></div>)}<div className="list-footer"><Icon as={LockClosedIcon} /><span>Your biometric data stays on your device. It’s never shared with us.</span></div></div>
+          </section>
+          <div className="info-grid"><section className="info-card"><span className="info-icon"><Icon as={ShieldCheckIcon} /></span><div><h3>Built for your peace of mind</h3><p>Passkeys are encrypted and protect your account<br className="desktop-break" /> from phishing and password leaks.</p></div></section><section className="info-card"><span className="info-icon"><Icon as={GlobeAltIcon} /></span><div><h3>Ready wherever you are</h3><p>Use passkeys across your devices with iCloud<br className="desktop-break" /> Keychain, Google Password Manager, and more.</p></div></section></div>
+          <div className="security-tip"><span className="tip-icon"><Icon as={FingerPrintIcon} /></span><p><strong>A small step for extra security.</strong> Add a second passkey so you always have a way in.</p><button aria-label="Learn about backup passkeys" onClick={() => setDialog('learn')}><Icon as={ArrowRightIcon} /></button></div>
+        </div> : <section className="alternate-panel" role="tabpanel"><span className="info-icon"><Icon as={tab === 'Password' ? LockClosedIcon : ShieldCheckIcon} /></span><h2>{tab === 'Password' ? 'Your password' : 'An extra layer of protection'}</h2><p>{tab === 'Password' ? 'A strong, unique password helps keep your account secure. Passkeys let you sign in without one.' : 'Passkeys already provide strong protection with your device’s built-in verification.'}</p><button className="primary-button" onClick={() => setTab('Passkeys')}>Manage your passkeys <Icon as={ArrowRightIcon} /></button><p className="preview-note">Password and two-step verification changes require a connected account service.</p></section>}
+        <footer className="settings-footer"><span><span className="footer-monogram">d.</span> A trusted space for curious minds.</span><div><a href={`${baseUrl}legal/privacy`}>Privacy policy</a><span>·</span><a href={`${baseUrl}legal/terms`}>Terms of service</a><span className="footer-copyright">© 2026 The DevTools Times</span></div></footer>
+      </main>
+    </div>
+    {toast && <div className="toast" role="status"><Icon as={CheckIcon} />{toast}<button aria-label="Dismiss notification" onClick={() => setToast('')}><Icon as={XMarkIcon} /></button></div>}
+    <dialog ref={dialogRef} className="settings-dialog" onCancel={() => setDialog(null)} onClick={e => { if (e.target === e.currentTarget) setDialog(null); }}><div className="dialog-content"><button className="dialog-close" aria-label="Close dialog" onClick={() => setDialog(null)}><Icon as={XMarkIcon} /></button>
+      {(dialog === 'add' || dialog === 'rename' || dialog === 'remove') && <form onSubmit={save}><span className="dialog-icon"><Icon as={dialog === 'remove' ? ShieldCheckIcon : KeyIcon} /></span><h2>{dialog === 'add' ? 'Add a passkey' : dialog === 'rename' ? 'Rename your passkey' : 'Remove this passkey?'}</h2><p>{dialog === 'remove' ? `You won’t be able to use ${selected?.name} to sign in. You can add it again later.` : dialog === 'rename' ? 'Choose a name that helps you recognize this device.' : 'Give your new passkey a name you’ll recognize.'}</p>{dialog === 'remove' && passkeys.length === 1 && <div className="dialog-notice">This is your last passkey. Make sure you have another way to sign in before removing it.</div>}{dialog !== 'remove' && <><label htmlFor="passkey-name">Passkey name</label><input id="passkey-name" autoFocus maxLength={60} required value={name} onChange={e => setName(e.target.value)} placeholder="e.g. My MacBook" pattern=".*\S.*" />{dialog === 'add' && <><label htmlFor="device-type">Device type</label><select id="device-type" value={device} onChange={e => setDevice(e.target.value as Passkey['type'])}><option value="computer">Computer</option><option value="phone">Phone or tablet</option><option value="key">Security key</option></select><div className="dialog-notice">Interactive preview: this adds a local entry. A live account service is needed to register a passkey for sign-in.</div></>}</>}<div className="dialog-buttons"><button type="button" className="secondary-button" onClick={() => setDialog(null)}>Cancel</button><button className={dialog === 'remove' ? 'danger-button' : 'primary-button'} type="submit">{dialog === 'add' ? 'Add passkey' : dialog === 'rename' ? 'Save changes' : 'Remove passkey'}</button></div></form>}
+      {dialog === 'learn' && <><span className="dialog-icon"><Icon as={FingerPrintIcon} /></span><h2>A safer way to sign in</h2><p>Passkeys replace passwords with your fingerprint, face, or device PIN. Your device keeps the private key, so there’s no password to remember or accidentally share.</p><div className="learn-item"><Icon as={ShieldCheckIcon} /><div><strong>Protection built in</strong><p>A passkey only works on the site it was created for, helping protect you from phishing.</p></div></div><div className="learn-item"><Icon as={ComputerDesktopIcon} /><div><strong>Keep a backup handy</strong><p>Add a second device or security key so you can still sign in if you lose access to your main device.</p></div></div><button className="primary-button" onClick={() => setDialog(null)}>Got it <Icon as={CheckIcon} /></button></>}
+      {dialog === 'profile' && <><span className="avatar">JD</span><h2>Jamie Davis</h2><p>jamie.davis@example.com</p><div className="profile-detail"><span>Account type</span><strong>Personal account</strong></div><div className="profile-detail"><span>Security</span><strong>{passkeys.length} passkeys</strong></div><button className="primary-button" onClick={() => setDialog(null)}>Back to security</button></>}
+      {dialog === 'notifications' && <><span className="dialog-icon"><Icon as={BellIcon} /></span><h2>Notifications</h2><p>Choose what you hear from the Times.</p><label className="notification-option"><span><strong>The daily briefing</strong><small>A fresh perspective in your inbox.</small></span><input type="checkbox" checked={newsletter} onChange={e => setNewsletter(e.target.checked)} /></label><p className="preview-note">Preferences in this preview apply to this session.</p><button className="primary-button" onClick={() => { setDialog(null); setToast('Notification preference updated for this session.'); }}>Save preference</button></>}
+    </div></dialog>
+  </div>;
+}
