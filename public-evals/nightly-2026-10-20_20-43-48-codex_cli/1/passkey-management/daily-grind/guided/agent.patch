+const storageKey = 'daily-grind-passkeys-v1';
+const initialPasskeys = [
+  { id: 'demo-macbook', name: 'MacBook Pro', provider: 'iCloud Keychain', type: 'laptop', registeredAt: '2026-10-12T10:00:00Z', lastUsedAt: '2026-10-20T09:41:00Z', current: true },
+  { id: 'demo-iphone', name: 'iPhone 15', provider: 'iCloud Keychain', type: 'phone', registeredAt: '2026-10-12T10:05:00Z', lastUsedAt: '2026-10-19T17:30:00Z' },
+  { id: 'demo-yubikey', name: 'YubiKey 5 NFC', provider: 'Security key', type: 'usb', registeredAt: '2026-10-14T14:00:00Z', lastUsedAt: null }
+];
+let passkeys;
+try {
+  const saved = JSON.parse(localStorage.getItem(storageKey));
+  passkeys = Array.isArray(saved) && saved.every(p => typeof p.id === 'string' && typeof p.name === 'string' && ['laptop', 'phone', 'usb'].includes(p.type) && !Number.isNaN(Date.parse(p.registeredAt))) ? saved : structuredClone(initialPasskeys);
+} catch { passkeys = structuredClone(initialPasskeys); }
+const $ = selector => document.querySelector(selector);
+const icon = name => `<svg aria-hidden="true"><use href="#${name}"/></svg>`;
+const escapeHTML = text => String(text).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
+const formatDate = value => dateFormat.format(new Date(value));
+const dialog = $('#dialog');
+let submitAction = null;
+let toastTimer;
+function notify(message) {
+  $('#toast').textContent = message;
+  $('#toast').classList.add('visible');
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => $('#toast').classList.remove('visible'), 4500);
+}
+function persist() {
+  try { localStorage.setItem(storageKey, JSON.stringify(passkeys)); return true; }
+  catch { notify('Changes are available for this visit. Browser storage is unavailable.'); return false; }
+}
+function render() {
+  $('#tab-count').textContent = passkeys.length;
+  $('#heading-count').textContent = passkeys.length;
+  $('#passkey-list').innerHTML = passkeys.length ? passkeys.map(p => {
+    let lastUsed = 'Not used yet';
+    if (p.lastUsedAt && !Number.isNaN(Date.parse(p.lastUsedAt))) {
+      const day = p.lastUsedAt.slice(0, 10);
+      const today = new Date();
+      const yesterday = new Date(today);
+      yesterday.setUTCDate(today.getUTCDate() - 1);
+      lastUsed = day === today.toISOString().slice(0, 10) ? 'Last used today' : day === yesterday.toISOString().slice(0, 10) ? 'Last used yesterday' : `Last used ${formatDate(p.lastUsedAt)}`;
+    }
+    return `<article class="passkey-row"><span class="device-icon">${icon(p.type)}</span><div class="device-details"><div class="device-title"><h3>${escapeHTML(p.name)}</h3>${p.current ? '<span class="device-tag">This device</span>' : ''}</div><p class="provider">${escapeHTML(p.provider || 'Unknown passkey provider')}</p><div class="device-dates"><span>Added ${formatDate(p.registeredAt)}</span><span class="dot">·</span><span>${lastUsed}</span></div></div><div class="row-actions"><button data-rename="${escapeHTML(p.id)}" aria-label="Rename ${escapeHTML(p.name)}">${icon('edit')}<span>Rename</span></button><button class="remove-button" data-remove="${escapeHTML(p.id)}" aria-label="Remove ${escapeHTML(p.name)}">${icon('trash')}<span>Remove</span></button></div></article>`;
+  }).join('') : `<div class="empty-state"><span class="device-icon">${icon('key')}</span><h3>A fresh start for your sign-in</h3><p>No passkeys added yet. Add one to get started.</p></div>`;
+}
+function openDialog(title, content, action, buttonText = 'Save changes', danger = false) {
+  $('#dialog-title').textContent = title;
+  $('#dialog-content').innerHTML = content;
+  $('#dialog-submit').textContent = buttonText;
+  $('#dialog-submit').classList.toggle('danger', danger);
+  $('#dialog-submit').hidden = !action;
+  $('.dialog-cancel').textContent = action ? 'Cancel' : 'Got it';
+  submitAction = action;
+  dialog.showModal();
+  const input = dialog.querySelector('input');
+  if (input) { input.focus(); input.select(); }
+}
+$('#dialog-form').addEventListener('submit', event => { event.preventDefault(); if (submitAction) submitAction(new FormData(event.currentTarget)); });
+$('.dialog-close').addEventListener('click', () => dialog.close());
+$('.dialog-cancel').addEventListener('click', () => dialog.close());
+dialog.addEventListener('click', event => { if(event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close(); } });
+$('#passkey-list').addEventListener('click', event => {
+  const rename = event.target.closest('[data-rename]');
+  const remove = event.target.closest('[data-remove]');
+  if (rename) {
+    const passkey = passkeys.find(p => p.id === rename.dataset.rename);
+    openDialog('Rename your passkey', '<p>A familiar name makes it easier to find the right passkey.</p><label for="passkey-name">Passkey name</label><input id="passkey-name" name="name" required maxlength="60" autocomplete="off">', data => {
+      const name = data.get('name').trim();
+      if (!name) { $('#passkey-name').setCustomValidity('Enter a name for your passkey.'); $('#passkey-name').reportValidity(); return; }
+      passkey.name = name;
+      const saved = persist(); render(); dialog.close(); if (saved) notify('Passkey renamed. Looking good!');
+    });
+    $('#passkey-name').value = passkey.name;
+    $('#passkey-name').select();
+    $('#passkey-name').addEventListener('input', event => event.target.setCustomValidity(''));
+  }
+  if (remove) {
+    const passkey = passkeys.find(p => p.id === remove.dataset.remove);
+    openDialog('Remove this passkey?', `<p>You’ll no longer be able to use <strong>${escapeHTML(passkey.name)}</strong> to sign in to this account.</p>${passkeys.length === 1 ? '<p class="demo-note">This is your last passkey. Make sure you can sign in with your password before removing it.</p>' : ''}<p>You may also need to remove the saved passkey from your device or password manager.</p>`, () => {
+      passkeys = passkeys.filter(p => p.id !== passkey.id);
+      const saved = persist(); render(); dialog.close(); if (saved) notify('Passkey removed from this preview.');
+    }, 'Remove passkey', true);
+  }
+});
+$('#add-button').addEventListener('click', () => {
+  openDialog('A simpler way to sign in', '<p>Give your new passkey a name so you’ll recognize it later.</p><label for="passkey-name">Passkey name</label><input id="passkey-name" name="name" placeholder="e.g. My personal laptop" required maxlength="60" autocomplete="off"><label for="device-type">Device type</label><select name="type" id="device-type"><option value="laptop">Computer</option><option value="phone">Phone or tablet</option><option value="usb">Security key</option></select><p class="demo-note">You’re exploring a demo. This adds a sample passkey to this browser only. No sign-in credential will be created.</p>', data => {
+    const name = data.get('name').trim();
+    if (!name) { $('#passkey-name').setCustomValidity('Enter a name for your passkey.'); $('#passkey-name').reportValidity(); return; }
+    const type = data.get('type');
+    passkeys.push({ id: crypto.randomUUID(), name, type, provider: type === 'usb' ? 'Security key · Demo' : 'Device passkey · Demo', registeredAt: new Date().toISOString(), lastUsedAt: null });
+    const saved = persist(); render(); dialog.close(); if (saved) notify('Sample passkey added to your preview.');
+  }, 'Add sample passkey');
+  $('#passkey-name').addEventListener('input', event => event.target.setCustomValidity(''));
+});
+function showPasskeys(show = true) {
+  $('#passkey-panel').hidden = !show; $('#password-panel').hidden = show;
+  $('#passkeys-tab').classList.toggle('selected', show); $('#password-tab').classList.toggle('selected', !show);
+  $('#passkeys-tab').setAttribute('aria-current', show ? 'page' : 'false'); $('#password-tab').setAttribute('aria-current', show ? 'false' : 'page');
+}
+$('#passkeys-tab').addEventListener('click', () => showPasskeys());
+$('#password-tab').addEventListener('click', () => showPasskeys(false));
+$('#back-passkeys').addEventListener('click', () => showPasskeys());
+$('#security-nav').addEventListener('click', () => showPasskeys());
+$('#account-button').addEventListener('click', () => { showPasskeys(); window.scrollTo({ top: 0, behavior: 'smooth' }); });
+$('#learn-button').addEventListener('click', () => openDialog('Meet your new sign-in ritual', '<p>A passkey is a secure alternative to a password. Your device checks it’s you using your fingerprint, face, or screen lock.</p><p>Your biometric information stays on your device. Passkeys are unique to each website, helping protect you from phishing.</p><p>Keep passkeys on more than one device, or use a synced password manager, so you can sign in wherever your day takes you.</p>', null));
+$('#help-button').addEventListener('click', () => openDialog('A little help with passkeys', '<p><strong>Can’t find a passkey?</strong><br>Check the password manager or device you used when you created it.</p><p><strong>Getting a new phone?</strong><br>Add a passkey on your new device before removing your old one.</p><p><strong>About this preview</strong><br>Passkey changes are saved on this browser only. Real sign-in and account support require a connected account service.</p>', null));
+document.querySelectorAll('[data-page]').forEach(button => button.addEventListener('click', event => {
+  event.preventDefault(); const titles = { menu:'Something good is brewing', locations:'Your neighborhood coffee spot', story:'Good coffee. Good days.', rewards:'Your daily ritual, rewarded', order:'Your next coffee is calling', overview:'Welcome to your daily corner', orders:'Your coffee history', profile:'Your personal details', addresses:'Your saved addresses', payments:'Your payment methods' };
+  const key = button.dataset.page;
+  openDialog(titles[key], key === 'rewards' ? '<p>You have <strong>240 Grind points</strong>. Just 60 more points until your next free drink.</p><p>Pick up your favorite coffee to keep the good days coming.</p>' : '<p>This account preview is focused on login and security. Choose Passkeys to manage your saved sign-in devices.</p>', null);
+}));
+document.querySelectorAll('[data-legal]').forEach(button => button.addEventListener('click', () => openDialog(button.dataset.legal, '<p>This is a local interface preview. Passkey names and sample device details are stored only in this browser. No passwords, biometric data, or real sign-in credentials are collected.</p>', null)));
+$('#signout').addEventListener('click', () => openDialog('You’re in a preview', '<p>There’s no active account session to sign out of. Your sample passkey list is saved on this browser for your next visit.</p>', null));
+render();
