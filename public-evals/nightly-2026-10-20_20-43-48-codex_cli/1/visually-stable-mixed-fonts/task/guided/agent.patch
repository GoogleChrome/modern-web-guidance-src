+            <div id="independent-theme-container"><div class="theme-meta"><span>A different mood. Its own rules.</span><span>↗</span></div><p class="theme-copy">Some things deserve<br>a little <em>independence.</em></p><div class="theme-foot">Libre Baskerville &nbsp; / &nbsp; font-size-adjust: 0.5</div></div>
+          </div>
+        </div>
+        <div class="code-view" id="css-panel" role="tabpanel" aria-labelledby="css-tab" hidden><div class="specimen-name">THE CSS BEHIND THE HARMONY</div><pre><code id="css-code"></code></pre></div>
+        <div class="stage-footer"><span>Made for the details.</span><button class="copy-btn" id="copy" type="button"><span aria-hidden="true">▣</span> <span id="copy-label" aria-live="polite">Copy CSS</span></button></div>
+      </div>
+    </section>
+    <section class="notes" aria-label="How it works">
+      <article class="note"><span class="note-icon" aria-hidden="true">↕</span><div><h2>Optically in sync</h2><p>Match the height of lowercase letters, so different fonts feel the same size.</p></div></article>
+      <article class="note"><span class="note-icon" aria-hidden="true">⌘</span><div><h2>A little CSS magic</h2><p>Let <code>from-font</code> find the right proportions. No manual fine-tuning needed.</p></div></article>
+      <article class="note"><span class="note-icon" aria-hidden="true">◈</span><div><h2>Independent by design</h2><p>A fixed ratio gives a separate theme its own consistent typographic rhythm.</p></div></article>
+    </section>
+    <footer><span>A small experiment in visual consistency.</span><span>BUILT WITH CURIOSITY & A LITTLE CSS</span></footer>
+  </main>
+  <script>
+    const $ = id => document.getElementById(id);
+    const paragraph = $('mixed-fonts-container');
+    const bodyFont = $('body-font'), codeFont = $('code-font'), size = $('font-size'), normalize = $('normalize');
+    const codeText = () => `#mixed-fonts-container {\n  font-family: ${bodyFont.value};\n  font-size: ${Number(size.value) / 16}rem;\n  font-size-adjust: ${normalize.checked ? 'from-font' : 'none'};\n  line-height: 1.65;\n}\n\n#mixed-fonts-container code {\n  font-family: ${codeFont.value};\n  font-size: 1em;\n}\n\n#independent-theme-container {\n  font-family: 'Libre Baskerville', Georgia, serif;\n  font-size-adjust: 0.5;\n}\n\n@supports not (font-size-adjust: from-font) {\n  #mixed-fonts-container { line-height: 1.7; }\n  #mixed-fonts-container code { font-size: .94em; }\n}\n\n@supports not (font-size-adjust: 0.5) {\n  #independent-theme-container {\n    font-size: 1rem;\n    line-height: 1.7;\n  }\n}`;
+    function update() {
+      paragraph.style.fontFamily = bodyFont.value;
+      paragraph.querySelectorAll('code').forEach(code => code.style.fontFamily = codeFont.value);
+      paragraph.style.fontSize = `${Number(size.value) / 16}rem`;
+      paragraph.style.fontSizeAdjust = normalize.checked ? 'from-font' : 'none';
+      $('size-output').textContent = `${size.value} px`;
+      $('property-value').textContent = `font-size-adjust: ${normalize.checked ? 'from-font' : 'none'};`;
+      $('auto-badge').textContent = normalize.checked ? 'AUTO ADJUSTED' : 'NATURAL HEIGHT';
+      $('css-code').textContent = codeText();
+    }
+    [bodyFont, codeFont, size, normalize].forEach(control => control.addEventListener('input', update));
+    $('reset').addEventListener('click', () => { bodyFont.selectedIndex=0; codeFont.selectedIndex=0; size.value=28; normalize.checked=true; setTheme('sage'); update(); });
+    const tabs = [$('preview-tab'), $('css-tab')];
+    function selectTab(index) { tabs.forEach((tab,i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex=i===index?0:-1; $(tab.getAttribute('aria-controls')).hidden=i!==index; }); }
+    tabs.forEach((tab,index) => { tab.addEventListener('click', () => selectTab(index)); tab.addEventListener('keydown', event => { let next=index; if(event.key==='ArrowRight'||event.key==='ArrowLeft') next=1-index; else if(event.key==='Home') next=0; else if(event.key==='End') next=1; else return; event.preventDefault(); selectTab(next); tabs[next].focus(); }); });
+    const themes = { sage:['#eaf0df','#3a4930'], clay:['#f2e6dc','#6e493a'], slate:['#e5eaf1','#3f5069'] };
+    function setTheme(name) { const container=$('independent-theme-container'); container.style.backgroundColor=themes[name][0]; container.style.color=themes[name][1]; document.querySelectorAll('[data-theme]').forEach(button => button.setAttribute('aria-pressed',String(button.dataset.theme===name))); }
+    document.querySelectorAll('[data-theme]').forEach(button => button.addEventListener('click', () => setTheme(button.dataset.theme)));
+    $('copy').addEventListener('click', async () => { try { await navigator.clipboard.writeText(codeText()); $('copy-label').textContent='Copied!'; } catch { selectTab(1); const selection=window.getSelection(); const range=document.createRange(); range.selectNodeContents($('css-code')); selection.removeAllRanges(); selection.addRange(range); $('copy-label').textContent='Select & copy CSS'; } setTimeout(() => $('copy-label').textContent='Copy CSS',2500); });
+    update();
+  </script>
+</body>
+</html>
