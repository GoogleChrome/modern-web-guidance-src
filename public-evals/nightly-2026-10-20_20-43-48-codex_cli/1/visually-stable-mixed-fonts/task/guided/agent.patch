+    @media(max-width:600px) { .topbar nav { gap:16px; } .external { padding-left:16px; } .topbar nav .nav-lab { display:none; } .workbench { grid-template-columns:1fr; } aside { border-right:0; border-bottom:1px solid var(--line); display:grid; grid-template-columns:1fr 1fr; gap:18px; } aside .panel-title { grid-column:1/-1; margin:0; } .control-group { margin:0; } .divider,.reset { display:none; } .adjust-control { grid-column:1/-1; } .property { margin-top:10px; } .helper { margin:7px 0 0; } .notes { grid-template-columns:1fr; gap:20px; } .note p { max-width:60ch; } h1 { letter-spacing:-1.4px; } .status { font-size:.5rem; } .stage-head { padding:14px 22px; } .preview { padding:24px 22px; } footer { gap:15px; } }
