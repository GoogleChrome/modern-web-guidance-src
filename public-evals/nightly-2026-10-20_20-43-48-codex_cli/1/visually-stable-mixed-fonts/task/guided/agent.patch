+  </style>
+</head>
+<body>
+  <header class="topbar">
+    <a class="brand" href="./" aria-label="Typeform home"><span class="brand-mark">t</span> typeform <small>LAB</small></a>
+    <nav aria-label="Main navigation"><a class="active nav-lab" href="#playground"><span class="nav-dot"></span>Playground</a><a class="external" href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noreferrer">The CSS behind it ↗</a></nav>
+  </header>
+  <main>
+    <section class="intro">
+      <div class="eyebrow">SMALL DETAILS. BETTER TYPOGRAPHY.</div>
+      <h1>Different fonts. <em>Same harmony.</em></h1>
+      <p>A little playground for fonts that look right together. Mix, match, and let CSS find the balance.</p>
+      <div class="intro-mark" aria-hidden="true">Aa</div>
+    </section>
+    <section class="workbench" id="playground" aria-label="Typography playground">
+      <aside>
+        <h2 class="panel-title">THE CONTROLS</h2>
+        <div class="control-group"><label for="body-font">Text font</label><select id="body-font"><option value="'DM Sans', sans-serif">DM Sans</option><option value="Arial, sans-serif">Arial</option><option value="Georgia, serif">Georgia</option></select></div>
+        <div class="control-group"><label for="code-font">Code font</label><select id="code-font"><option value="'IBM Plex Mono', monospace">IBM Plex Mono</option><option value="'Courier New', monospace">Courier New</option><option value="monospace">System Mono</option></select></div>
+        <div class="control-group"><div class="label-row"><label for="font-size">Font size</label><output id="size-output" for="font-size">28 px</output></div><input id="font-size" type="range" min="18" max="40" value="28"><div class="range-labels"><span>18 px</span><span>40 px</span></div></div>
+        <div class="divider"></div>
+        <div class="adjust-control"><div class="toggle-row"><label for="normalize">Normalize font height</label><input class="switch" type="checkbox" id="normalize" checked></div><p class="helper">One consistent x-height.<br>Automatically, across every font.</p><div class="property" id="property-value">font-size-adjust: from-font;</div></div>
+        <button class="reset" id="reset" type="button">↺ &nbsp; Reset to defaults</button>
+      </aside>
+      <div class="stage">
+        <div class="stage-head"><div class="tabs" role="tablist" aria-label="View"><button class="tab" id="preview-tab" role="tab" aria-selected="true" aria-controls="preview-panel" tabindex="0">Preview</button><button class="tab" id="css-tab" role="tab" aria-selected="false" aria-controls="css-panel" tabindex="-1">CSS</button></div><div class="status">LIVE IN YOUR BROWSER</div></div>
