diff --git a/tests/control.test.cjs b/tests/control.test.cjs
new file mode 100644
index 0000000..5a02a8b
--- /dev/null
+++ b/tests/control.test.cjs
@@ -0,0 +1,71 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const vm = require('node:vm');
+
+function createControl(attributes = {}) {
+  const internals = { form: {}, validity: { valid: true }, willValidate: true,
+    setFormValue(value, state) { this.value = value; this.state = state; },
+    setValidity(flags, message, anchor) { this.validity = { ...flags, valid: !Object.keys(flags).length }; this.message = message; this.anchor = anchor; }
+  };
+  const buttons = Array.from({ length: 5 }, (_, i) => ({ dataset: { value: String(i + 1) }, attrs: {}, classList: { toggle() {} }, setAttribute(key, value) { this.attrs[key] = value; }, focus() {} }));
+  const group = { attrs: {}, setAttribute(key, value) { this.attrs[key] = value; } };
+  class MockHTMLElement extends EventTarget {
+    constructor() { super(); this.attributes = { ...attributes }; this.dataset = {}; }
+    attachInternals() { return internals; }
+    attachShadow() { return this.shadowRoot = { innerHTML: '', addEventListener() {}, querySelectorAll() { return buttons; }, querySelector() { return group; } }; }
+    getAttribute(key) { return this.attributes[key] ?? null; }
+    hasAttribute(key) { return key in this.attributes; }
+    matches() { return this.hasAttribute('disabled'); }
+  }
+  class CustomEvent extends Event { constructor(type, init = {}) { super(type); this.detail = init.detail; } }
+  class ElementInternals { setFormValue() {} }
+  const context = vm.createContext({ HTMLElement: MockHTMLElement, ElementInternals, window: { ElementInternals }, CustomEvent, Event, InputEvent: Event });
+  const source = readFileSync('app.js', 'utf8').split("customElements.define('star-rating', StarRating);")[0];
+  vm.runInContext(source + '\nglobalThis.Control = StarRating;', context);
+  const control = new context.Control();
+  control.connectedCallback();
+  return { control, internals, buttons };
+}
+
+test('submits its own normalized value and saves restoration state', () => {
+  const { control, internals } = createControl({ value: '4' });
+  assert.equal(internals.value, '4');
+  control.value = '5';
+  assert.equal(internals.value, '5');
+  assert.equal(internals.state, '5');
+  control.value = 'unexpected';
+  assert.equal(internals.value, '');
+});
+
+test('required empty control reports valueMissing with an internal focus anchor', () => {
+  const { control, internals, buttons } = createControl({ required: '' });
+  assert.equal(internals.validity.valueMissing, true);
+  assert.equal(internals.message, 'Please choose a rating.');
+  assert.equal(internals.anchor, buttons[0]);
+  control.value = '2';
+  assert.equal(internals.validity.valid, true);
+  assert.equal(internals.message, '');
+});
+
+test('reset restores the attribute default; restoration accepts saved browser state', () => {
+  const { control } = createControl({ value: '4' });
+  control.value = '1';
+  control.formResetCallback();
+  assert.equal(control.value, '4');
+  control.formStateRestoreCallback('3', 'restore');
+  assert.equal(control.value, '3');
+  control.formStateRestoreCallback(new FormData(), 'restore');
+  assert.equal(control.value, '');
+});
+
+test('fieldset disable and re-enable preserve host attributes and keyboard access', () => {
+  const { control, buttons } = createControl({ value: '4' });
+  control.formDisabledCallback(true);
+  assert.ok(buttons.every(button => button.disabled && button.tabIndex === -1));
+  assert.equal(control.hasAttribute('disabled'), false);
+  control.formDisabledCallback(false);
+  assert.ok(buttons.every(button => !button.disabled));
+  assert.equal(buttons[3].tabIndex, 0);
+  assert.equal(buttons.filter(button => button.tabIndex === 0).length, 1);
+});
