+  formStateRestoreCallback(state, mode) { this.value = typeof state === 'string' ? state : ''; this.#lifecycle('restore', `State restored (${mode || 'restore'})`); }
+  #lifecycle(type, message) { this.dispatchEvent(new CustomEvent('rating-lifecycle', { detail: { type, message } })); }
+}
+customElements.define('star-rating', StarRating);
+
+const $ = selector => document.querySelector(selector);
+const form = $('#feedback-form');
+const rating = $('#experience');
+let savedRating = rating.value;
+let eventCount = 0;
+let copyTimer;
+const escapeHTML = value => String(value).replace(/[&<>"']/g, character => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[character]));
+function record(message) {
+  eventCount++;
+  $('#event-count').textContent = eventCount;
+  const item = document.createElement('li');
+  const time = document.createElement('time');
+  time.textContent = new Date().toLocaleTimeString('en-GB');
+  item.append(time, document.createTextNode(message));
+  $('#event-log').prepend(item);
+  if ($('#event-log').children.length > 30) $('#event-log').lastElementChild.remove();
+}
+function updateInspector() {
+  const data = Object.fromEntries(new FormData(form));
+  const entries = Object.entries(data);
+  $('#form-data').innerHTML = '<span class="json-punctuation">{</span>\n' + entries.map(([key, value], index) => `  <span class="json-key">${escapeHTML(JSON.stringify(key))}</span><span class="json-punctuation">: </span><span class="json-value">${escapeHTML(JSON.stringify(value))}</span>${index < entries.length - 1 ? ',' : ''}`).join('\n') + '\n<span class="json-punctuation">}</span>';
+  $('#state-value').textContent = JSON.stringify(rating.value);
+  $('#state-description').textContent = labels[Number(rating.value) - 1] || 'Not selected';
+  const valid = !rating.willValidate || rating.validity.valid;
+  $('#state-validity').className = valid ? 'valid-state' : 'invalid-state';
+  $('#state-validity').textContent = !rating.willValidate ? '— Disabled' : valid ? '✓ Valid' : '! Value missing';
+  $('#clear-rating').disabled = rating.hasAttribute('disabled');
+  $('#rating-help').textContent = rating.hasAttribute('data-invalid') ? 'Please choose a rating before sending.' : rating.hasAttribute('disabled') ? 'This control is disabled and excluded from submission.' : 'A small rating. A big help.';
+  $('#rating-help').classList.toggle('error', rating.hasAttribute('data-invalid'));
+}
+form.addEventListener('input', updateInspector);
+rating.addEventListener('rating-sync', updateInspector);
+rating.addEventListener('change', () => { record(`change → rating = "${rating.value}"`); $('#form-result').textContent = ''; });
+rating.addEventListener('rating-invalid', () => { updateInspector(); record('invalid → Please choose a rating'); });
+rating.addEventListener('rating-lifecycle', event => { record(`${event.detail.type} → ${event.detail.message}`); updateInspector(); });
+$('#required-toggle').addEventListener('change', event => { rating.toggleAttribute('required', event.target.checked); record(`required → ${event.target.checked}`); });
+$('#disabled-toggle').addEventListener('change', event => { rating.toggleAttribute('disabled', event.target.checked); updateInspector(); });
+$('#clear-rating').addEventListener('click', () => { rating.value = ''; updateInspector(); record('value → Cleared'); $('#form-result').textContent = ''; });
+$('#restore-state').addEventListener('click', () => { rating.formStateRestoreCallback(savedRating, 'restore'); $('#form-result').textContent = 'Saved rating restored. Browser restoration callback simulated.'; });
+form.addEventListener('submit', event => {
+  event.preventDefault();
+  savedRating = rating.value;
+  record(`submit → ${new FormData(form).has('rating') ? `rating = "${rating.value}"` : 'rating omitted (disabled)'}`);
+  $('#form-result').textContent = 'Thanks! Your feedback was captured successfully.';
+  updateInspector();
+});
+form.addEventListener('reset', () => { $('#form-result').textContent = ''; queueMicrotask(updateInspector); });
+$('#reset-all').addEventListener('click', () => {
+  rating.toggleAttribute('required', true); rating.removeAttribute('disabled');
+  $('#required-toggle').checked = true; $('#disabled-toggle').checked = false;
+  form.reset(); savedRating = '4';
+  $('#event-log').replaceChildren(); eventCount = 0; record('ready → Playground reset');
+  switchOutput('data');
+});
+function switchOutput(output) {
+  $('#data-output').hidden = output !== 'data'; $('#events-output').hidden = output !== 'events';
+  document.querySelectorAll('[data-output]').forEach(button => { const selected = button.dataset.output === output; button.classList.toggle('selected', selected); button.setAttribute('aria-selected', selected); });
+}
+document.querySelectorAll('[data-output]').forEach(button => button.addEventListener('click', () => switchOutput(button.dataset.output)));
+$('#copy-data').addEventListener('click', async () => {
+  try {
+    await navigator.clipboard.writeText(JSON.stringify(Object.fromEntries(new FormData(form)), null, 2));
+    $('#copy-data').innerHTML = '<svg><use href="#i-check"/></svg>';
+    $('#copy-data').setAttribute('aria-label', 'Form data copied');
+    record('clipboard → Form data copied');
+    clearTimeout(copyTimer); copyTimer = setTimeout(() => { $('#copy-data').innerHTML = '<svg><use href="#i-copy"/></svg>'; $('#copy-data').setAttribute('aria-label', 'Copy form data'); }, 1800);
+  } catch { record('clipboard → Copy unavailable in this context'); }
+});
+function switchView(view) {
+  $('#playground-view').hidden = view !== 'playground'; $('#code-view').hidden = view !== 'code';
+  document.querySelectorAll('[data-view]').forEach(button => { const selected = button.dataset.view === view; button.classList.toggle(button.classList.contains('nav-item') ? 'active' : 'selected', selected); if (button.getAttribute('role') === 'tab') button.setAttribute('aria-selected', selected); });
+}
+document.querySelectorAll('[data-view]').forEach(button => button.addEventListener('click', () => switchView(button.dataset.view)));
+$('#implementation-code').textContent = `// The actual custom control registered in this playground.\n// Supporting UI styles are included in its shadow root.\n\n${StarRating.toString()}\n\ncustomElements.define('star-rating', StarRating);`;
+$('#docs-open').addEventListener('click', () => $('#docs-dialog').showModal());
+$('#docs-close').addEventListener('click', () => $('#docs-dialog').close());
+$('#docs-dialog').addEventListener('click', event => { if (event.target === $('#docs-dialog')) { const bounds = event.target.getBoundingClientRect(); if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) event.target.close(); } });
+record('ready → Custom control associated with form');
+updateInspector();
