+const labels = ['Poor', 'Fair', 'Good', 'Great', 'Excellent'];
+const supportsFACE = 'attachInternals' in HTMLElement.prototype && 'ElementInternals' in window && 'setFormValue' in ElementInternals.prototype;
+
+class StarRating extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'disabled', 'value'];
+  #internals;
+  #value = '';
+  #disabled = false;
+  #fallback;
+  constructor() {
+    super();
+    this.#internals = supportsFACE ? this.attachInternals() : null;
+    this.attachShadow({ mode: 'open', delegatesFocus: true });
+    this.shadowRoot.innerHTML = `<style>
+      :host{display:block;outline:none}.ratings{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}button{font:inherit;min-width:0;border:1px solid #e9e5ee;background:#fff;border-radius:7px;padding:14px 2px 10px;cursor:pointer;color:#d4cedf;display:flex;flex-direction:column;align-items:center;gap:8px;transition:background .15s,border-color .15s,transform .15s}svg{width:25px;height:25px;fill:#f4f1f8;stroke:currentColor;stroke-width:1.3;stroke-linejoin:round}span{font-family:'DM Sans',sans-serif;font-size:8px;color:#aaa3b5}button.filled svg{fill:#c8b5e5;stroke:#c2adde}button[aria-checked=true]{border-color:#a68acb;background:#f6f1fc;box-shadow:0 0 0 1px #ab90d21a}button[aria-checked=true] svg{fill:#ab8bd3;stroke:#ab8bd3}button[aria-checked=true] span{color:#9b7cbb}button:hover:not(:disabled){background:#faf7ff;border-color:#bca3d8;transform:translateY(-2px)}button:focus-visible{outline:2px solid #9a7ac4;outline-offset:3px}button:disabled{opacity:.4;cursor:not-allowed}:host([data-invalid]) button{border-color:#d5a0aa}@media(prefers-reduced-motion:reduce){button{transition:none}}
+      </style><div class="ratings" role="radiogroup" aria-label="How was your experience?">${labels.map((label, i) => `<button type="button" role="radio" aria-checked="false" aria-label="${i + 1} out of 5, ${label}" data-value="${i + 1}" tabindex="${i === 0 ? 0 : -1}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.8 2.8 5.7 6.3.9-4.6 4.5 1.1 6.3-5.6-3-5.6 3 1.1-6.3-4.6-4.5 6.3-.9Z"/></svg><span>${label}</span></button>`).join('')}</div>`;
+    this.shadowRoot.addEventListener('click', event => {
+      const button = event.target.closest('button');
+      if (button && !this.#disabled) this.#choose(button.dataset.value);
+    });
+    this.shadowRoot.addEventListener('keydown', event => {
+      const keys = ['ArrowRight', 'ArrowUp', 'ArrowLeft', 'ArrowDown', 'Home', 'End'];
+      if (this.#disabled || !keys.includes(event.key)) return;
+      event.preventDefault();
+      const index = Number(this.#value || 1);
+      const next = event.key === 'Home' ? 1 : event.key === 'End' ? 5 : Math.max(1, Math.min(5, index + (['ArrowRight', 'ArrowUp'].includes(event.key) ? 1 : -1)));
+      this.#choose(String(next));
+      this.shadowRoot.querySelector(`[data-value="${next}"]`).focus();
+    });
+    this.addEventListener('invalid', () => { this.dataset.invalid = ''; this.dispatchEvent(new CustomEvent('rating-invalid')); });
+  }
+  connectedCallback() {
+    if (!supportsFACE && !this.#fallback) {
+      this.#fallback = document.createElement('input');
+      this.#fallback.type = 'text';
+      this.#fallback.tabIndex = -1;
+      this.#fallback.setAttribute('aria-label', 'Experience rating');
+      this.#fallback.style.cssText = 'position:absolute;width:1px;height:1px;opacity:0;pointer-events:none';
+      this.append(this.#fallback);
+      this.closest('form')?.addEventListener('reset', () => this.formResetCallback());
+    }
+    this.value = this.getAttribute('value') || '';
+    this.#sync();
+  }
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue) return;
+    if (name === 'value') this.value = newValue || '';
+    if (name === 'disabled') this.formDisabledCallback(this.matches(':disabled') || this.hasAttribute('disabled'));
+    this.#sync();
+  }
+  get value() { return this.#value; }
+  set value(value) {
+    this.#value = /^[1-5]$/.test(String(value)) ? String(value) : '';
+    delete this.dataset.invalid;
+    this.#sync();
+  }
+  get form() { return this.#internals?.form || this.closest('form'); }
+  get validity() { return this.#internals?.validity || this.#fallback?.validity; }
+  get validationMessage() { return this.#internals?.validationMessage || this.#fallback?.validationMessage; }
+  get willValidate() { return this.#internals?.willValidate ?? !this.#disabled; }
+  checkValidity() { return this.#internals?.checkValidity() ?? this.#fallback.checkValidity(); }
+  reportValidity() { return this.#internals?.reportValidity() ?? this.#fallback.reportValidity(); }
+  #sync() {
+    const buttons = [...this.shadowRoot.querySelectorAll('button')];
+    const selected = this.#value || '1';
+    buttons.forEach(button => {
+      button.setAttribute('aria-checked', String(button.dataset.value === this.#value));
+      button.tabIndex = button.dataset.value === selected && !this.#disabled ? 0 : -1;
+      button.disabled = this.#disabled;
+      button.classList.toggle('filled', Number(button.dataset.value) <= Number(this.#value));
+    });
+    const required = this.hasAttribute('required');
+    this.shadowRoot.querySelector('[role=radiogroup]').setAttribute('aria-required', String(required));
+    this.shadowRoot.querySelector('[role=radiogroup]').setAttribute('aria-disabled', String(this.#disabled));
+    const missing = required && !this.#value;
+    if (this.#internals) {
+      this.#internals.setFormValue(this.#value, this.#value);
+      this.#internals.setValidity(missing ? { valueMissing: true } : {}, missing ? 'Please choose a rating.' : '', buttons[0]);
+    } else if (this.#fallback) {
+      this.#fallback.name = this.getAttribute('name') || '';
+      this.#fallback.value = this.#value;
+      this.#fallback.required = required;
+      this.#fallback.disabled = this.#disabled;
+    }
+    this.dispatchEvent(new CustomEvent('rating-sync'));
+  }
+  #choose(value) {
+    if (this.value === value) return;
+    this.value = value;
+    this.dispatchEvent(new InputEvent('input', { bubbles: true, composed: true, inputType: 'insertReplacementText', data: value }));
+    this.dispatchEvent(new Event('change', { bubbles: true }));
+  }
+  formResetCallback() { this.value = this.getAttribute('value') || ''; this.#lifecycle('reset', 'Restored the default value'); }
