+const TOPICS = [
+  ['design', '◈', 'Design'], ['development', '⌘', 'Development'],
+  ['product', '▧', 'Product'], ['accessibility', '⊕', 'Accessibility'],
+  ['engineering', '⌁', 'Engineering'], ['inspiration', '✧', 'Inspiration']
+];
+class TopicPicker extends HTMLElement {
+  static formAssociated = true;
+  static observedAttributes = ['required', 'disabled', 'name'];
+  constructor() {
+    super();
+    this.internals = this.attachInternals();
+    this.attachShadow({ mode: 'open', delegatesFocus: true });
+    this.selected = [];
+    this.isDisabled = false;
+    this.shadowRoot.innerHTML = `<style>
+      :host{display:block} .topics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}
+      button{font-family:'DM Sans',sans-serif;border:1px solid #e7e6ee;background:#fff;display:flex;align-items:center;justify-content:center;gap:7px;padding:12px 5px;border-radius:6px;font-size:10px;color:#95919f;cursor:pointer;transition:background .15s,border-color .15s;white-space:nowrap}
+      button:hover{background:#faf7ff;border-color:#c2b0e2}button[aria-pressed=true]{background:#f4effc;border-color:#beaadf;color:#9577c5;box-shadow:0 0 0 1px #bca5df0a} .icon{font-size:14px;line-height:12px}button:focus-visible{outline:2px solid #ac8fdf;outline-offset:3px}button:disabled{opacity:.45;cursor:not-allowed;background:#f4f4f6} .error{font-size:10px;color:#bf746e;margin:10px 0 0}.error[hidden]{display:none}@media(max-width:1100px) and (min-width:621px){.topics{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:380px){.topics{grid-template-columns:repeat(2,minmax(0,1fr))}}
+    </style><div class="topics" role="group" aria-label="Interests">${TOPICS.map(([value,icon,label])=>`<button type="button" data-value="${value}" aria-pressed="false"><span class="icon" aria-hidden="true">${icon}</span>${label}</button>`).join('')}</div><p class="error" role="alert" hidden>Select at least one interest.</p>`;
+    this.shadowRoot.addEventListener('click', event => {
+      const button = event.target.closest('button');
+      if (!button || this.isDisabled) return;
+      const value = button.dataset.value;
+      this.selected = this.selected.includes(value) ? this.selected.filter(item => item !== value) : [...this.selected, value];
+      this.sync();
+      this.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
+      this.dispatchEvent(new Event('change', { bubbles: true }));
+      this.emit('setFormValue', `interests → ${JSON.stringify(this.selected)}`);
+    });
+    this.addEventListener('invalid', () => { this.shadowRoot.querySelector('.error').hidden = false; });
+  }
+  connectedCallback() {
+    this.selected = this.parse(this.getAttribute('value') || '');
+    this.sync();
+  }
+  parse(value) {
+    let values;
+    try { values = JSON.parse(value); } catch { values = String(value).split(','); }
+    return Array.isArray(values) ? [...new Set(values.filter(v => TOPICS.some(t => t[0] === v)))] : [];
+  }
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue !== newValue && this.isConnected) this.sync();
+  }
+  get value() { return [...this.selected]; }
+  set value(value) { this.selected = this.parse(JSON.stringify(value)); this.sync(); }
+  get form() { return this.internals.form; }
+  get validity() { return this.internals.validity; }
+  get validationMessage() { return this.internals.validationMessage; }
+  get willValidate() { return this.internals.willValidate; }
+  checkValidity() { return this.internals.checkValidity(); }
+  reportValidity() { return this.internals.reportValidity(); }
+  sync() {
+    const data = new FormData();
+    if (this.getAttribute('name')) this.selected.forEach(value => data.append(this.getAttribute('name'), value));
+    this.internals.setFormValue(data, JSON.stringify(this.selected));
+    const missing = this.hasAttribute('required') && this.selected.length === 0;
+    this.internals.setValidity(missing ? { valueMissing: true } : {}, missing ? 'Select at least one interest.' : '', this.shadowRoot.querySelector('button'));
+    this.internals.ariaRequired = String(this.hasAttribute('required'));
+    this.internals.ariaDisabled = String(this.isDisabled);
+    this.shadowRoot.querySelectorAll('button').forEach(button => {
+      button.setAttribute('aria-pressed', String(this.selected.includes(button.dataset.value)));
+      button.disabled = this.isDisabled;
+    });
+    if (!missing || this.isDisabled) this.shadowRoot.querySelector('.error').hidden = true;
+    this.dispatchEvent(new CustomEvent('control-update', { bubbles: true }));
+  }
+  emit(name, detail) { this.dispatchEvent(new CustomEvent('lifecycle', { bubbles: true, detail: { name, detail } })); }
+  formAssociatedCallback(form) { this.emit('formAssociatedCallback', form ? 'Associated with <form id="preferences">' : 'Detached from form'); }
+  formResetCallback() {
+    this.selected = this.parse(this.getAttribute('value') || '');
+    this.shadowRoot.querySelector('.error').hidden = true;
+    this.sync();
+    this.emit('formResetCallback', 'Default selection restored');
+  }
+  formDisabledCallback(disabled) {
+    this.isDisabled = disabled;
+    this.sync();
+    this.emit('formDisabledCallback', `disabled → ${disabled}`);
+  }
+  formStateRestoreCallback(state, mode) {
+    this.selected = this.parse(typeof state === 'string' ? state : '[]');
+    this.sync();
+    this.emit('formStateRestoreCallback', `${mode} → ${JSON.stringify(this.selected)}`);
+  }
+}
+const form = document.querySelector('form');
+const log = document.querySelector('#event-log');
+let eventCount = 0;
+function addEvent(name, detail) {
+  const row = document.createElement('div'); row.className = 'event';
+  const time = document.createElement('time'); time.textContent = new Date().toLocaleTimeString('en-GB');
+  const dot = document.createElement('span'); dot.className = 'event-dot';
+  const title = document.createElement('span'); title.className = 'event-name'; title.textContent = name;
+  const text = document.createElement('span'); text.className = 'event-details'; text.textContent = detail;
+  row.append(time, dot, title, text); log.append(row); log.scrollTop = log.scrollHeight;
+  if (log.children.length > 50) log.firstChild.remove();
+  document.querySelector('#event-count').textContent = ++eventCount;
+}
+document.addEventListener('lifecycle', event => addEvent(event.detail.name, event.detail.detail));
+customElements.define('topic-picker', TopicPicker);
+const picker = document.querySelector('topic-picker');
+let currentInspector = 'data';
+let displayedOutput = '';
+let savedState = JSON.stringify(picker.value);
+let toastTimer;
+function toast(message) { const el = document.querySelector('#toast'); el.textContent = message; el.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove('show'), 3500); }
+function formDataObject() {
+  const data = new FormData(form); const object = {};
+  for (const [key, value] of data) {
+    if (key === picker.getAttribute('name')) { (object[key] ||= []).push(value); }
+    else object[key] = value;
+  }
+  return object;
+}
+function updateInspector() {
+  let object;
+  if (currentInspector === 'data') object = formDataObject();
+  if (currentInspector === 'validity') object = { valid: picker.validity.valid, valueMissing: picker.validity.valueMissing, willValidate: picker.willValidate, validationMessage: picker.validationMessage };
+  if (currentInspector === 'state') object = { value: picker.value, disabled: picker.isDisabled, required: picker.hasAttribute('required'), savedState: JSON.parse(savedState) };
+  displayedOutput = JSON.stringify(object, null, 2);
+  const pre = document.querySelector('#data-output'); pre.replaceChildren();
+  displayedOutput.split(/("(?:\\.|[^"\\])*"\s*:|"(?:\\.|[^"\\])*"|\btrue\b|\bfalse\b)/g).forEach(part => {
+    const span = document.createElement('span'); span.className = /":$/.test(part.trim()) ? 'json-key' : part.startsWith('"') || /^(true|false)$/.test(part) ? 'json-value' : 'json-punctuation'; span.textContent = part; pre.append(span);
+  });
+  const valid = [...form.elements].every(el => !el.willValidate || el.validity.valid);
+  const badge = document.querySelector('#form-status'); badge.textContent = valid ? '✓ Valid' : '! Invalid'; badge.classList.toggle('invalid', !valid);
+}
+form.addEventListener('input', updateInspector);
+form.addEventListener('control-update', updateInspector);
+form.addEventListener('invalid', () => { addEvent('invalid', 'Constraint validation prevented submission'); toast('Check the required fields before submitting.'); }, true);
+form.addEventListener('submit', event => {
+  event.preventDefault(); savedState = JSON.stringify(picker.value); updateInspector();
+  addEvent('submit', `FormData collected · ${[...new FormData(form)].length} entries`);
+  document.querySelector('#data-note').textContent = '✓ Form submitted · state saved';
+  toast('Form submitted. Your preferences have been saved.');
+});
+form.addEventListener('reset', () => { queueMicrotask(() => { document.querySelector('#required-toggle').checked = picker.hasAttribute('required'); document.querySelector('#disabled-toggle').checked = picker.hasAttribute('disabled'); updateInspector(); }); document.querySelector('#data-note').innerHTML = '<span>↳</span> Updates as you make changes'; });
+document.querySelector('#required-toggle').addEventListener('change', event => { picker.toggleAttribute('required', event.target.checked); addEvent('constraintChanged', `required → ${event.target.checked}`); });
+document.querySelector('#disabled-toggle').addEventListener('change', event => { picker.toggleAttribute('disabled', event.target.checked); });
+document.querySelector('#restore-button').addEventListener('click', () => { picker.formStateRestoreCallback(savedState, 'restore'); updateInspector(); toast('Saved selection restored (simulated browser callback).'); });
+document.querySelector('#restore-button').title = 'Simulate a browser state-restore callback using the last submitted selection';
+document.querySelector('#clear-button').addEventListener('click', () => { log.replaceChildren(); eventCount = 0; document.querySelector('#event-count').textContent = '0'; });
+document.querySelectorAll('[data-inspect]').forEach(button => button.addEventListener('click', () => {
+  document.querySelectorAll('[data-inspect]').forEach(tab => tab.classList.toggle('selected', tab === button)); currentInspector = button.dataset.inspect;
+  document.querySelector('#code-title').textContent = { data: 'new FormData(form)', validity: 'control.validity', state: 'control.state' }[currentInspector]; updateInspector();
+}));
+document.querySelector('#copy-button').addEventListener('click', async () => { try { await navigator.clipboard.writeText(displayedOutput); toast('Copied to clipboard.'); } catch { toast('Clipboard is unavailable in this environment.'); } });
+function selectTab(tab) {
+  document.querySelectorAll('[data-tab]').forEach(button => button.classList.toggle('selected', button.dataset.tab === tab));
+  document.querySelector('#preview-panel').hidden = tab !== 'preview'; document.querySelector('#code-panel').hidden = tab !== 'code';
+}
+document.querySelectorAll('[data-tab]').forEach(button => button.addEventListener('click', () => selectTab(button.dataset.tab)));
+document.querySelectorAll('[data-page]').forEach(link => link.addEventListener('click', () => {
+  document.querySelectorAll('[data-page]').forEach(item => item.classList.toggle('active', item === link));
+  document.querySelector('#breadcrumb').textContent = link.textContent.replace(/[▦◈▧1]/g, '').trim();
+  if (link.dataset.page === 'components') selectTab('code'); else selectTab('preview');
+  if (link.dataset.page === 'overview') document.querySelector('.feature-strip').scrollIntoView({ behavior: 'smooth', block: 'center' });
+}));
+document.querySelector('#implementation-code').textContent = TopicPicker.toString();
+addEvent('setFormValue', 'interests → ["design", "development"]');
+updateInspector();
