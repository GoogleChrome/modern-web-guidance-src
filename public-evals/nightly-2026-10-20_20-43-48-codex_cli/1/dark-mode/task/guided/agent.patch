+  <script>
+    const themeSelect = document.getElementById('theme-select');
+    const themeMeta = document.querySelector('meta[name="color-scheme"]');
+
+    function applyTheme(value) {
+      const theme = value === 'light' || value === 'dark' ? value : 'system';
+      if (theme === 'system') {
+        delete document.documentElement.dataset.theme;
+      } else {
+        document.documentElement.dataset.theme = theme;
+      }
+      themeMeta.content = theme === 'system' ? 'light dark' : theme;
+      themeSelect.value = theme;
+    }
+
+    applyTheme(document.documentElement.dataset.theme);
+    themeSelect.addEventListener('change', () => {
+      applyTheme(themeSelect.value);
+      try {
+        if (themeSelect.value === 'system') localStorage.removeItem('daily-grind-theme');
+        else localStorage.setItem('daily-grind-theme', themeSelect.value);
+      } catch { /* Apply the choice even if saving it is blocked. */ }
+    });
+
+    window.addEventListener('storage', (event) => {
+      if (event.key === 'daily-grind-theme' || event.key === null) applyTheme(event.newValue);
+    });
+
+    document.getElementById('specials-select').addEventListener('change', (event) => {
+      document.querySelectorAll('#specials-list .special').forEach((special) => {
+        special.hidden = event.target.value !== 'all' && special.dataset.category !== event.target.value;
+      });
+      document.getElementById('specials-list').scrollTop = 0;
+    });
+  </script>
