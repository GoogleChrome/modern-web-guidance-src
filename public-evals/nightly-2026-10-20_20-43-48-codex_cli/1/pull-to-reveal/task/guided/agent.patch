+  <script>
+    // Match native initial positioning while preserving explicit fragment links.
+    if (!CSS.supports('scroll-initial-target', 'nearest') && !location.hash) {
+      document.querySelector('nav').scrollIntoView({ behavior: 'instant', block: 'start' });
+    }
+
+    const searchForm = document.querySelector('.search-bar');
+    const searchInput = document.querySelector('#coffee-search');
+    const cards = [...document.querySelectorAll('#seasonal-favorites .card')];
+    const searchStatus = document.querySelector('#search-status');
+
+    searchForm.addEventListener('submit', (event) => event.preventDefault());
+    searchInput.addEventListener('input', () => {
+      const query = searchInput.value.trim().toLocaleLowerCase();
+      let matches = 0;
+      for (const card of cards) {
+        card.hidden = !card.textContent.toLocaleLowerCase().includes(query);
+        if (!card.hidden) matches++;
+      }
+      searchStatus.hidden = !query;
+      searchStatus.textContent = matches ? `${matches} seasonal favorites found.` : 'No seasonal favorites found.';
+    });
+  </script>
+
