+  <script>
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const page = document.getElementById('page-content');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    const closeButton = drawer.querySelector('.drawer-close');
+    let phase = 'closed';
+    const visibleThreshold = 0.001;
+
+    function finishClosing() {
+      if (phase === 'closed') return;
+      phase = 'closed';
+      drawer.hidePopover();
+      page.inert = false;
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus({ preventScroll: true });
+    }
+
+    async function openDrawer() {
+      if (phase !== 'closed') return;
+      phase = 'opening';
+      drawer.showPopover();
+      page.inert = true;
+      openButton.setAttribute('aria-expanded', 'true');
+      sheet.focus({ preventScroll: true });
+
+      // Reset every opening, including browsers without scroll-initial-target.
+      scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'instant' });
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (phase === 'opening') scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (phase === 'closed') return;
+      phase = 'closing';
+      if (scroller.scrollLeft >= sheet.offsetWidth - 1) {
+        finishClosing();
+      } else {
+        // Keep the popover in the top layer until the sheet is off-screen.
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'auto' });
+      }
+    }
+
+    new IntersectionObserver(entries => {
+      const entry = entries.at(-1);
+      if (phase === 'closed') return;
+      // Ignore the initial off-screen position while preparing the entrance.
+      if (phase === 'opening') {
+        if (entry.intersectionRatio < visibleThreshold) return;
+        phase = 'open';
+      }
+      if (entry.intersectionRatio < visibleThreshold) finishClosing();
+    }, { root: scroller, threshold: [visibleThreshold, 1] }).observe(sheet);
+
+    if (!CSS.supports('animation-timeline: scroll()') || !CSS.supports('timeline-scope: --drawer-fade')) {
+      const updateBackdrop = () => {
+        const opacity = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / sheet.offsetWidth));
+        drawer.style.setProperty('--drawer-backdrop', opacity);
+      };
+      scroller.addEventListener('scroll', updateBackdrop, { passive: true });
+    }
+
+    openButton.addEventListener('click', openDrawer);
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', event => {
+      if (!sheet.contains(event.target) || event.target.closest('a')) closeDrawer();
+    });
+    document.addEventListener('keydown', event => {
+      if (phase === 'closed') return;
+      if (event.key === 'Escape') {
+        event.preventDefault();
+        closeDrawer();
+      }
+      if (event.key === 'Tab') {
+        const items = sheet.querySelectorAll('button, a[href]');
+        const first = items[0];
+        const last = items[items.length - 1];
+        if (event.shiftKey && (document.activeElement === first || document.activeElement === sheet)) {
+          event.preventDefault();
+          last.focus();
+        } else if (!event.shiftKey && document.activeElement === last) {
+          event.preventDefault();
+          first.focus();
+        }
+      }
+    });
+  </script>
