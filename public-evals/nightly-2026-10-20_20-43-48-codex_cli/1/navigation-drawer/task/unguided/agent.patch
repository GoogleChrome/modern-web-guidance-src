+  <script>
+    const menuButton = document.querySelector('.menu-button');
+    const drawer = document.querySelector('.drawer');
+    const scroller = document.querySelector('.drawer-scroller');
+    const panel = document.querySelector('.drawer-panel');
+    const closeButton = document.querySelector('.drawer-close');
+    let state = 'closed';
+    let startedOutsidePanel = false;
+
+    // Native scrolling supplies touch tracking, momentum, and snap settling.
+    // Observe visibility so swipe and button dismissal share the same cleanup.
+    const observer = new IntersectionObserver(([entry]) => {
+      if (!drawer.open) return;
+      if (entry.intersectionRatio > 0.001) {
+        if (state === 'opening') state = 'open';
+      } else if (state === 'open' || state === 'closing') {
+        drawer.close();
+      }
+    }, { root: scroller, threshold: [0, 0.001, 1] });
+
+    menuButton.addEventListener('click', () => {
+      if (drawer.open) return;
+      state = 'opening';
+      drawer.showModal();
+      menuButton.setAttribute('aria-expanded', 'true');
+      // Start offscreen, including on browsers without scroll-initial-target.
+      scroller.scrollTo({ left: panel.offsetWidth, behavior: 'instant' });
+      observer.observe(panel);
+      requestAnimationFrame(() => {
+        requestAnimationFrame(() => {
+          if (drawer.open && state === 'opening') scroller.scrollTo({ left: 0 });
+        });
+      });
+    });
+
+    function closeDrawer() {
+      state = 'closing';
+      if (scroller.scrollLeft >= panel.offsetWidth - 1) {
+        drawer.close();
+      } else {
+        scroller.scrollTo({ left: panel.offsetWidth });
+      }
+    }
+
+    closeButton.addEventListener('click', closeDrawer);
+    drawer.addEventListener('cancel', (event) => {
+      // Keep the native Escape / platform close request, but animate dismissal.
+      event.preventDefault();
+      closeDrawer();
+    });
+    drawer.addEventListener('pointerdown', (event) => {
+      startedOutsidePanel = !panel.contains(event.target);
+    }, { passive: true });
+    drawer.addEventListener('click', (event) => {
+      // The transparent scroll surface acts as the backdrop. Do not treat a
+      // swipe that starts inside the panel and ends outside as a backdrop tap.
+      if (startedOutsidePanel && !panel.contains(event.target)) closeDrawer();
+    });
+    drawer.addEventListener('close', () => {
+      state = 'closed';
+      observer.disconnect();
+      menuButton.setAttribute('aria-expanded', 'false');
+      menuButton.focus({ preventScroll: true });
+    });
+  </script>
