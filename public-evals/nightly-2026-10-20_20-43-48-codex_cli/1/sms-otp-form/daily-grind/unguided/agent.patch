+const $ = (id) => document.getElementById(id);
+const countries = {
+  US: { prefix: '+1', flag: '🇺🇸', length: 10, example: '(555) 000-0000' },
+  CA: { prefix: '+1', flag: '🇨🇦', length: 10, example: '(555) 000-0000' },
+  GB: { prefix: '+44', flag: '🇬🇧', length: 10, example: '7700 900000' },
+  AU: { prefix: '+61', flag: '🇦🇺', length: 9, example: '412 345 678' },
+  IN: { prefix: '+91', flag: '🇮🇳', length: 10, example: '98765 43210' },
+};
+let phoneNumber = '';
+let timer;
+let otpController;
+let expiresAt = 0;
+let verified = false;
+const announce = (message) => { $('live-status').textContent = message; };
+function error(field, message) {
+  $(field + '-error').textContent = message;
+  $(field + '-error').hidden = !message;
+  $(field).setAttribute('aria-invalid', String(Boolean(message)));
+}
+function cooldown() {
+  clearInterval(timer);
+  const until = Date.now() + 30000;
+  const tick = () => {
+    const seconds = Math.max(0, Math.ceil((until - Date.now()) / 1000));
+    $('resend').disabled = seconds > 0;
+    $('resend').textContent = seconds ? `Resend in ${seconds}s` : 'Resend code';
+    if (!seconds) clearInterval(timer);
+  };
+  tick(); timer = setInterval(tick, 1000);
+}
+async function listenForSMS() {
+  otpController?.abort();
+  if (!('OTPCredential' in window) || !window.isSecureContext) return;
+  otpController = new AbortController();
+  const controller = otpController;
+  const timeout = setTimeout(() => controller.abort(), 120000);
+  try {
+    const credential = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal });
+    if (credential?.code && !$('code-form').hidden) {
+      $('code').value = credential.code.replace(/\D/g, '').slice(0, 6);
+      announce('Verification code filled from your SMS. Select Verify phone number to continue.');
+      $('code').focus();
+    }
+  } catch (_) { /* Manual entry and platform SMS autofill remain available. */ }
+  finally { clearTimeout(timeout); }
+}
+$('country').addEventListener('change', () => {
+  const country = countries[$('country').value];
+  $('country-flag').textContent = country.flag;
+  $('phone').placeholder = country.example;
+  error('phone', '');
+});
+$('phone').addEventListener('input', () => error('phone', ''));
+$('phone-form').addEventListener('submit', (event) => {
+  event.preventDefault();
+  const country = countries[$('country').value];
+  const raw = $('phone').value.trim();
+  let digits = raw.replace(/\D/g, '');
+  if (raw.startsWith('+') && digits.startsWith(country.prefix.slice(1))) digits = digits.slice(country.prefix.length - 1);
+  if ((country.prefix === '+44' || country.prefix === '+61') && digits.startsWith('0')) digits = digits.slice(1);
+  if (!/^[+\d\s().-]+$/.test(raw) || digits.length !== country.length || /^(\d)\1+$/.test(digits)) {
+    error('phone', `Enter a valid ${country.length}-digit phone number for the selected country.`);
+    $('phone').focus(); return;
+  }
+  phoneNumber = `${country.prefix} ${digits}`;
+  $('sent-number').textContent = phoneNumber;
+  $('phone-form').hidden = true;
+  $('code-form').hidden = false;
+  $('step-one').className = 'step complete';
+  $('step-one').removeAttribute('aria-current');
+  $('step-one').querySelector('.step-number').textContent = '✓';
+  $('step-two').className = 'step current';
+  $('step-two').setAttribute('aria-current', 'step');
+  expiresAt = Date.now() + 300000;
+  cooldown(); listenForSMS(); $('code').focus();
+  announce('Demo verification started. No SMS was sent. Enter demo code 123456. It expires in five minutes.');
+});
+$('code').addEventListener('input', () => {
+  $('code').value = $('code').value.replace(/\D/g, '').slice(0, 6);
+  error('code', '');
+});
+$('code').addEventListener('paste', (event) => {
+  const pasted = event.clipboardData.getData('text');
+  const match = pasted.match(/\b\d{6}\b/);
+  const digits = pasted.replace(/\D/g, '');
+  if (match || digits.length === 6) {
+    event.preventDefault(); $('code').value = match ? match[0] : digits;
+    error('code', ''); announce('Six-digit verification code pasted.');
+  }
+});
+$('code-form').addEventListener('submit', (event) => {
+  event.preventDefault();
+  if (Date.now() > expiresAt) { error('code', 'This code has expired. Request a new code below.'); $('resend').disabled = false; $('resend').textContent = 'Resend code'; clearInterval(timer); $('code').focus(); return; }
+  if ($('code').value !== '123456') { error('code', $('code').value.length !== 6 ? 'Enter all 6 digits of your verification code.' : 'That code doesn’t match. For this demo, use 123456.'); $('code').focus(); return; }
+  verified = true;
+  clearInterval(timer); otpController?.abort();
+  $('code-form').hidden = true;
+  $('success').hidden = false;
+  $('verified-number').textContent = phoneNumber;
+  $('step-two').querySelector('.step-number').textContent = '✓';
+  $('success').focus(); announce('Your phone number has been verified in this demo.');
+});
+function reset() {
+  clearInterval(timer); otpController?.abort();
+  $('success').hidden = true; $('code-form').hidden = true; $('phone-form').hidden = false;
+  $('code').value = ''; verified = false; error('code', '');
+  $('step-one').className = 'step current'; $('step-one').setAttribute('aria-current', 'step');
+  $('step-one').querySelector('.step-number').textContent = '1';
+  $('step-two').className = 'step'; $('step-two').removeAttribute('aria-current');
+  $('step-two').querySelector('.step-number').textContent = '2';
+  $('phone').focus(); announce('Enter your phone number.');
+}
+$('change-number').addEventListener('click', reset);
+$('verify-another').addEventListener('click', reset);
+$('resend').addEventListener('click', () => {
+  expiresAt = Date.now() + 300000;
+  $('code').value = ''; error('code', ''); cooldown(); listenForSMS();
+  announce('Demo code renewed. Use 123456. No SMS was sent.'); $('code').focus();
+});
+const info = {
+  menu: ['Made for your daily ritual', 'Find your favorite in our seasonal selection: Maple Oat Latte, Dark Roast Espresso, and our slow-steeped Cold Brew. Ask your local café for today’s menu and availability.'],
+  story: ['Good coffee. Good days.', 'The Daily Grind is built around a simple ritual: ethically sourced coffee, locally roasted, and thoughtfully made for your everyday.'],
+  locations: ['Your neighborhood coffee stop', 'Visit your local Daily Grind café for a familiar face and a freshly brewed cup. This demo does not include a store locator.'],
+  rewards: ['Your daily ritual, rewarded', 'Enjoy coffee perks with Grind Rewards. Verify your phone number to complete this demo. Reward balances and purchases will be available when a rewards service is connected.'],
+  support: ['A little help with verification', 'Choose your country and enter your mobile number. In this demo, use code 123456. You can paste all six digits at once. If the code expires, select Resend code to try again.'],
+  privacy: ['Your number stays yours', 'This demo keeps your phone number only in memory for this visit. It does not send messages, save your number, or share it with an SMS provider.'],
+  terms: ['A note about this demo', 'This verification experience is a demonstration. No SMS messages are delivered and no account or reward balance is created. A secure verification service is required for live use.'],
+};
+function showInfo(key) {
+  const content = key === 'rewards' && verified ? ['Welcome to your next coffee ritual', 'Your phone verification demo is complete! A connected rewards service will let you earn points, discover offers, and redeem your favorite cup.'] : info[key];
+  $('dialog-title').textContent = content[0]; $('dialog-copy').textContent = content[1]; $('info-dialog').showModal();
+}
+document.querySelectorAll('[data-info]').forEach((link) => link.addEventListener('click', (event) => { event.preventDefault(); showInfo(link.dataset.info); }));
+$('rewards-button').addEventListener('click', () => showInfo('rewards'));
+$('close-dialog').addEventListener('click', () => $('info-dialog').close());
+window.addEventListener('pagehide', () => { clearInterval(timer); otpController?.abort(); });
