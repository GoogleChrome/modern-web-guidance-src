@@ -0,0 +1,201 @@
+(() => {
+  'use strict';
+  const $ = (id) => document.getElementById(id);
+  // Set this to a same-origin API prefix before loading this script to enable real SMS.
+  const api = window.DAILY_GRIND_VERIFICATION_API;
+  const demo = !api;
+  let phone = '';
+  let challengeId = '';
+  let expiresAt = 0;
+  let otpController;
+  let cooldownTimer;
+  let cooldownUntil = 0;
+  let busy = false;
+  let view = 'entry';
+  $('demo-note').hidden = !demo;
+
+  function stopListening() {
+    otpController?.abort();
+    otpController = undefined;
+  }
+
+  function setError(field, message) {
+    $(field + '-error').textContent = message;
+    $(field).setAttribute('aria-invalid', String(Boolean(message)));
+  }
+
+  function show(next) {
+    view = next;
+    for (const name of ['entry', 'code', 'success']) $(name + '-view').hidden = next !== name;
+    $('phone-step').className = 'step ' + (next === 'entry' ? 'active' : 'complete');
+    $('code-step').className = 'step ' + (next === 'code' ? 'active' : next === 'success' ? 'complete' : '');
+    $('phone-step').removeAttribute('aria-current');
+    $('code-step').removeAttribute('aria-current');
+    if (next !== 'success') $(next === 'entry' ? 'phone-step' : 'code-step').setAttribute('aria-current', 'step');
+    $('status').textContent = '';
+    $(next === 'entry' ? 'form-title' : next + '-title').focus();
+  }
+
+  function updateCooldown() {
+    const remaining = Math.max(0, Math.ceil((cooldownUntil - Date.now()) / 1000));
+    $('resend-button').disabled = busy || remaining > 0;
+    $('resend-button').textContent = remaining ? `Resend in ${remaining}s` : 'Resend code';
+    if (!remaining) clearInterval(cooldownTimer);
+  }
+
+  function setBusy(value) {
+    busy = value;
+    $('send-button').disabled = value;
+    $('verify-button').disabled = value;
+    $('edit-phone').disabled = value;
+    updateCooldown();
+  }
+
+  async function post(path, body) {
+    const controller = new AbortController();
+    const timeout = setTimeout(() => controller.abort(), 15000);
+    try {
+      const response = await fetch(api.replace(/\/$/, '') + path, {
+        method: 'POST', credentials: 'same-origin', signal: controller.signal,
+        headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.message || 'Something went wrong. Please try again.');
+      return data;
+    } catch (error) {
+      if (error.name === 'AbortError') throw new Error('The request timed out. Please try again.');
+      throw error;
+    } finally { clearTimeout(timeout); }
+  }
+
+  async function listenForSms() {
+    stopListening();
+    if (demo || !window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+    const controller = new AbortController();
+    otpController = controller;
+    const timeout = setTimeout(() => controller.abort(), 120000);
+    try {
+      const credential = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal });
+      if (!controller.signal.aborted && view === 'code' && credential?.code) {
+        $('otp').value = credential.code;
+        // Wait for the send response, which supplies the challenge ID.
+        if (!busy) $('otp-form').requestSubmit();
+      }
+    } catch {
+      // Dismissal, denied permission, or no API support leaves manual entry available.
+    } finally {
+      clearTimeout(timeout);
+      if (otpController === controller) otpController = undefined;
+    }
+  }
+
+  async function sendCode(resend = false) {
+    if (busy) return;
+    setBusy(true);
+    stopListening();
+    setError('otp', '');
+    $('otp').value = '';
+    if (!resend) {
+      $('sent-description').textContent = `We’ll send a verification code to ${phone}.`;
+      show('code');
+    }
+    // Listen before dispatching SMS to avoid missing a fast delivery.
+    listenForSms();
+    try {
+      const data = demo ? { challengeId: 'demo' } : await post('/send', { phone });
+      if (typeof data.challengeId !== 'string' || !data.challengeId) throw new Error('Unable to start verification. Please try again.');
+      challengeId = data.challengeId;
+      expiresAt = Date.now() + 5 * 60 * 1000;
+      $('sent-description').textContent = demo ? `Try the verification flow for ${phone}. No text message will be sent.` : `We sent a verification code to ${phone}.`;
+      cooldownUntil = Date.now() + 30000;
+      clearInterval(cooldownTimer);
+      cooldownTimer = setInterval(updateCooldown, 1000);
+      $('status').textContent = resend ? (demo ? 'New demo code ready. Enter 123456.' : 'A new code is on its way.') : '';
+      $('otp').focus();
+    } catch (error) {
+      stopListening();
+      if (!resend) show('entry');
+      setError(resend ? 'otp' : 'phone', error.message || 'Unable to send a code. Please try again.');
+    } finally {
+      setBusy(false);
+    }
+    if (/^[0-9]{6}$/.test($('otp').value)) $('otp-form').requestSubmit();
+  }
+
+  $('country').addEventListener('change', () => {
+    $('country-flag').textContent = $('country').selectedOptions[0].dataset.flag;
+    setError('phone', '');
+  });
+  $('phone').addEventListener('input', () => setError('phone', ''));
+  $('phone-form').addEventListener('submit', (event) => {
+    event.preventDefault();
+    if (busy) return;
+    const raw = $('phone').value.trim();
+    const digits = raw.replace(/\D/g, '');
+    const country = $('country').value;
+    const lengths = { '+1': [10, 10], '+44': [10, 10], '+61': [9, 9], '+91': [10, 10], '+49': [7, 12], '+33': [9, 9] };
+    const national = country !== '+1' ? digits.replace(/^0/, '') : digits;
+    const [min, max] = lengths[country];
+    if (!/^[\d\s().-]+$/.test(raw) || national.length < min || national.length > max) {
+      setError('phone', 'Enter a valid mobile number without the country calling code.');
+      $('phone').focus();
+      return;
+    }
+    phone = country + national;
+    setError('phone', '');
+    sendCode();
+  });
+  $('otp').addEventListener('input', () => {
+    $('otp').value = $('otp').value.replace(/\D/g, '').slice(0, 6);
+    setError('otp', '');
+  });
+  $('otp').addEventListener('paste', (event) => {
+    const text = event.clipboardData?.getData('text');
+    if (text && /^[\d\s-]+$/.test(text)) {
+      event.preventDefault();
+      $('otp').value = text.replace(/\D/g, '').slice(0, 6);
+      setError('otp', '');
+    }
+  });
+  $('otp-form').addEventListener('submit', async (event) => {
+    event.preventDefault();
+    stopListening();
+    if (busy) return;
+    const code = $('otp').value;
+    if (!/^[0-9]{6}$/.test(code)) {
+      setError('otp', 'Enter the complete 6-digit code.');
+      $('otp').focus();
+      return;
+    }
+    if (demo && Date.now() > expiresAt) {
+      setError('otp', 'This code has expired. Request a new code below.');
+      return;
+    }
+    setBusy(true);
+    try {
+      const data = demo ? { verified: code === '123456' } : await post('/verify', { challengeId, code });
+      if (data.verified !== true) throw new Error('That code doesn’t match. Check your code and try again.');
+      clearInterval(cooldownTimer);
+      $('verified-number').textContent = phone;
+      if (demo) $('success-copy').textContent = 'Demo verification complete. Your number has not been verified by an SMS service.';
+      show('success');
+    } catch (error) {
+      setError('otp', error.message || 'Unable to verify your code. Please try again.');
+      $('otp').focus();
+    } finally { setBusy(false); }
+  });
+  $('resend-button').addEventListener('click', () => {
+    if (Date.now() >= cooldownUntil) sendCode(true);
+  });
+  $('edit-phone').addEventListener('click', () => {
+    stopListening();
+    clearInterval(cooldownTimer);
+    challengeId = '';
+    show('entry');
+    $('phone').focus();
+  });
+  window.addEventListener('pagehide', () => {
+    stopListening();
+    clearInterval(cooldownTimer);
+  });
+})();
