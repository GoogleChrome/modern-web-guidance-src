+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const vm = require('node:vm');
+const fs = require('node:fs');
+const source = fs.readFileSync(require('node:path').join(__dirname, '../verification.js'), 'utf8');
+function setup(real = false, response = {}) {
+  const elements = new Map();
+  const get = id => {
+    if (!elements.has(id)) elements.set(id, {value:'',hidden:false,textContent:'',disabled:false,attrs:{},events:{},
+      setAttribute(k,v){this.attrs[k]=v},removeAttribute(k){delete this.attrs[k]},focus(){this.focused=true},
+      addEventListener(k,fn){this.events[k]=fn},requestSubmit(){return this.events.submit({preventDefault(){}})}
+    });
+    return elements.get(id);
+  };
+  get('country').value = '+1';
+  let now = 1000, credentialsOptions, resolveOtp;
+  const calls = [];
+  const window = {isSecureContext:true,addEventListener(k,fn){this[k]=fn}};
+  if(real){ window.DAILY_GRIND_VERIFICATION_API='/api/phone'; window.OTPCredential=function(){}; }
+  const navigator = {credentials:{get(options){credentialsOptions=options;return new Promise(resolve=>{resolveOtp=resolve})}}};
+  vm.runInNewContext(source,{document:{getElementById:get},window,navigator,AbortController,
+    Date:{now:()=>now},setTimeout:()=>1,clearTimeout(){},setInterval:()=>2,clearInterval(){},
+    fetch:async(url,options)=>{calls.push({url,body:JSON.parse(options.body)});return {ok:response.ok??true,json:async()=>response.data??(url.endsWith('/send')?{challengeId:'server-id'}:{verified:true})}}});
+  const event = async(id,type='submit')=>{await get(id).events[type]({preventDefault(){}});await new Promise(resolve=>setImmediate(resolve))};
+  return {get,event,window,calls,advance(ms){now+=ms},receiveOtp(code){resolveOtp({code})},get otpSignal(){return credentialsOptions?.signal}};
+}
+test('rejects invalid numbers accessibly',async()=>{const s=setup();s.get('phone').value='123';await s.event('phone-form');assert.equal(s.get('phone').attrs['aria-invalid'],'true');assert.ok(s.get('phone-error').textContent);});
+test('demo completes without network and preserves international phone',async()=>{const s=setup();s.get('phone').value='(555) 123-4567';await s.event('phone-form');assert.equal(s.get('code-view').hidden,false);assert.equal(s.get('resend-button').disabled,true);s.get('otp').value='123456';await s.event('otp-form');assert.equal(s.get('success-view').hidden,false);assert.equal(s.get('verified-number').textContent,'+15551234567');assert.match(s.get('success-copy').textContent,/has not been verified/);assert.equal(s.calls.length,0);});
+test('wrong and incomplete codes stay on code step',async()=>{const s=setup();s.get('phone').value='5551234567';await s.event('phone-form');s.get('otp').value='012345';await s.event('otp-form');assert.match(s.get('otp-error').textContent,/doesn’t match/);s.get('otp').value='123';await s.event('otp-form');assert.match(s.get('otp-error').textContent,/complete/);});
+test('expired demo code can be resent',async()=>{const s=setup();s.get('phone').value='5551234567';await s.event('phone-form');s.advance(300001);s.get('otp').value='123456';await s.event('otp-form');assert.match(s.get('otp-error').textContent,/expired/);await s.event('resend-button','click');assert.equal(s.get('otp').value,'');s.get('otp').value='123456';await s.event('otp-form');assert.equal(s.get('success-view').hidden,false);});
+test('real flow uses server challenge and aborts WebOTP on manual submission',async()=>{const s=setup(true);s.get('phone').value='5551234567';await s.event('phone-form');assert.equal(s.get('demo-note').hidden,true);assert.equal(s.otpSignal.aborted,false);s.get('otp').value='012345';await s.event('otp-form');assert.equal(s.otpSignal.aborted,true);assert.equal(s.calls[1].body.challengeId,'server-id');assert.equal(s.calls[1].body.code,'012345');assert.equal(s.get('success-view').hidden,false);});
+test('send errors restore phone step and stop WebOTP',async()=>{const s=setup(true,{ok:false,data:{message:'Please wait before trying again.'}});s.get('phone').value='5551234567';await s.event('phone-form');assert.equal(s.get('entry-view').hidden,false);assert.equal(s.otpSignal.aborted,true);assert.match(s.get('phone-error').textContent,/Please wait/);assert.equal(s.get('send-button').disabled,false);});
+test('changing phone aborts WebOTP and returns to first step',async()=>{const s=setup(true);s.get('phone').value='5551234567';await s.event('phone-form');await s.event('edit-phone','click');assert.equal(s.otpSignal.aborted,true);assert.equal(s.get('entry-view').hidden,false);assert.equal(s.get('phone').focused,true);});
+
+test('automatically extracted SMS code runs normal server verification',async()=>{const s=setup(true);s.get('phone').value='5551234567';await s.event('phone-form');s.receiveOtp('012345');await new Promise(resolve=>setImmediate(resolve));assert.equal(s.get('otp').value,'012345');assert.equal(s.calls[1].body.code,'012345');assert.equal(s.get('success-view').hidden,false);});
