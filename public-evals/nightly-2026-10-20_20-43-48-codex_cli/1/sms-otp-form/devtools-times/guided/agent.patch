index 0000000..e5ab9ca
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,139 @@
+import type { APIRoute } from 'astro';
+
+type Challenge = {
+  phone: string;
+  sid?: string;
+  expiresAt: number;
+  resendAt: number;
+  attempts: number;
+  verified?: boolean;
+};
+
+const json = (body: object, status = 200) => Response.json(body, {
+  status,
+  headers: { 'Cache-Control': 'no-store' },
+});
+
+// Credentials stay on the server. Configure a six-digit, domain-bound SMS template.
+async function verifyRequest(resource: string, body: Record<string, string>) {
+  const { TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_VERIFY_SERVICE_SID } = process.env;
+  const response = await fetch(
+    `https://verify.twilio.com/v2/Services/${TWILIO_VERIFY_SERVICE_SID}/${resource}`,
+    {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${TWILIO_ACCOUNT_SID}:${TWILIO_AUTH_TOKEN}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: new URLSearchParams(body),
+      signal: AbortSignal.timeout(15000),
+    },
+  );
+  return { response, data: await response.json() };
+}
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  // This project disables Astro's global origin check; enforce it for this endpoint.
+  if (request.headers.get('origin') !== url.origin) {
+    return json({ error: 'Please submit this form from this website.' }, 403);
+  }
+  if (!request.headers.get('content-type')?.startsWith('application/json')) {
+    return json({ error: 'Expected a JSON request.' }, 415);
+  }
+  if (!session) return json({ error: 'Sign-up is temporarily unavailable.' }, 503);
+
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  if (!body || !['send', 'verify', 'register'].includes(body.action)) {
+    return json({ error: 'Invalid sign-up action.' }, 400);
+  }
+
+  const now = Date.now();
+  const challenge = await session.get('signupChallenge') as Challenge | undefined;
+
+  try {
+    if (body.action === 'send') {
+      const phone = typeof body.phone === 'string' ? body.phone.replace(/[\s().-]/g, '') : '';
+      if (!/^\+[1-9]\d{7,14}$/.test(phone)) {
+        return json({ error: 'Enter a phone number with country code, such as +1 202 555 0123.' }, 400);
+      }
+      if (challenge && challenge.resendAt > now) {
+        return json({ error: 'Please wait before requesting another code.', resendAt: challenge.resendAt }, 429);
+      }
+      if (!process.env.TWILIO_ACCOUNT_SID || !process.env.TWILIO_AUTH_TOKEN ||
+          !process.env.TWILIO_VERIFY_SERVICE_SID || !process.env.TWILIO_VERIFY_TEMPLATE_SID) {
+        return json({ error: 'SMS verification is temporarily unavailable. Please try again later.' }, 503);
+      }
+      const pending: Challenge = { phone, expiresAt: now + 10 * 60_000, resendAt: now + 30_000, attempts: 0 };
+      // Invalidate any earlier approval before sending another code, even if delivery fails.
+      await session.set('signupChallenge', pending);
+      const { response, data } = await verifyRequest('Verifications', {
+        To: phone,
+        Channel: 'sms',
+        TemplateSid: process.env.TWILIO_VERIFY_TEMPLATE_SID,
+      });
+      if (!response.ok || data.status !== 'pending' || typeof data.sid !== 'string') {
+        return json({ error: 'Could not send a code. Check your number and try again shortly.', resendAt: pending.resendAt }, response.status === 429 ? 429 : 502);
+      }
+      // Twilio resends may reuse the same code and its original expiration time.
+      if (challenge?.sid === data.sid) {
+        pending.expiresAt = challenge.expiresAt;
+        pending.attempts = challenge.attempts;
+      }
+      pending.sid = data.sid;
+      await session.set('signupChallenge', pending);
+      return json({ phone, resendAt: pending.resendAt });
+    }
+
+    if (!challenge?.sid || challenge.expiresAt <= now) {
+      return json({ error: 'Your code has expired. Request another code.', expired: true }, 400);
+    }
+
+    if (body.action === 'verify') {
+      if (typeof body.code !== 'string' || !/^\d{6}$/.test(body.code)) {
+        return json({ error: 'Enter the six-digit code from your text message.' }, 400);
+      }
+      if (challenge.verified) return json({ verified: true });
+      if (challenge.attempts >= 5) {
+        return json({ error: 'Too many attempts. Request another code.', expired: true }, 429);
+      }
+      challenge.attempts += 1;
+      await session.set('signupChallenge', challenge);
+      const { response, data } = await verifyRequest('VerificationCheck', {
+        VerificationSid: challenge.sid,
+        Code: body.code,
+      });
+      if (response.status === 404) {
+        return json({ error: 'Your code has expired. Request another code.', expired: true }, 400);
+      }
+      if (!response.ok || data.status !== 'approved') {
+        return json({ error: 'That code could not be verified. Check it and try again.' }, 400);
+      }
+      challenge.verified = true;
+      challenge.expiresAt = now + 10 * 60_000;
+      await session.set('signupChallenge', challenge);
+      return json({ verified: true });
+    }
+
+    if (!challenge.verified) return json({ error: 'Verify your phone number before signing up.' }, 403);
+    if (typeof body.username !== 'string' || !body.username.trim() ||
+        typeof body.password !== 'string' || body.password.length < 8 || !/\d/.test(body.password)) {
+      return json({ error: 'Enter a username and a password of at least eight characters containing a number.' }, 400);
+    }
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: body.username.trim(), password: body.password, phone: challenge.phone }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'Registration failed. Please check your details or try another username.' }, 400);
+    await session.delete('signupChallenge');
+    return json({ registered: true });
+  } catch {
+    return json({ error: 'Could not connect to the sign-up service. Please try again shortly.' }, 503);
+  }
+};
diff --git a/tests/signup-form.test.tsx b/tests/signup-form.test.tsx
new file mode 100644
index 0000000..8f44e63
--- /dev/null
+++ b/tests/signup-form.test.tsx
@@ -0,0 +1,153 @@
+import React from 'react';
+import { afterEach, beforeEach, expect, test, vi } from 'vitest';
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import SignUpForm from '../src/components/SignUpForm';
+
+let requests: Array<Record<string, string>>;
+let smsGet: ReturnType<typeof vi.fn>;
+let options: CredentialRequestOptions & { otp?: unknown };
+let deliver: (value: unknown) => void;
+
+beforeEach(() => {
+  requests = [];
+  vi.stubGlobal('isSecureContext', true);
+  vi.stubGlobal('OTPCredential', class {});
+  smsGet = vi.fn((value) => {
+    options = value;
+    return new Promise((resolve) => { deliver = resolve; });
+  });
+  Object.defineProperty(navigator, 'credentials', { configurable: true, value: { get: smsGet } });
+  vi.stubGlobal('fetch', vi.fn(async (_url, init) => {
+    const body = JSON.parse(init.body);
+    requests.push(body);
+    if (body.action === 'send') {
+      // The listener must already be active when delivery is requested.
+      if ('OTPCredential' in window) expect(smsGet).toHaveBeenCalled();
+      return Response.json({ phone: '+12025550123', resendAt: Date.now() + 30_000 });
+    }
+    return Response.json({});
+  }));
+});
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+async function sendCode() {
+  fireEvent.change(screen.getByLabelText('Username'), { target: { value: 'reader' } });
+  fireEvent.change(screen.getByLabelText('Password'), { target: { value: 'password1' } });
+  fireEvent.change(screen.getByLabelText('Phone number'), { target: { value: '+12025550123' } });
+  fireEvent.click(screen.getByRole('button', { name: 'Send verification code' }));
+  await waitFor(() => expect(screen.getByRole('button', { name: 'Verify & create account' }).hasAttribute('disabled')).toBe(false));
+}
+
+test('uses an accessible single text input with code autofill, numeric keyboard, and leading zeros', async () => {
+  render(<SignUpForm />);
+  await sendCode();
+  const input = screen.getByLabelText('Verification code') as HTMLInputElement;
+  expect(input.type).toBe('text');
+  expect(input.getAttribute('autocomplete')).toBe('one-time-code');
+  expect(input.getAttribute('inputmode')).toBe('numeric');
+  expect(input.getAttribute('aria-describedby')).toBe('code-hint');
+  expect(document.activeElement).toBe(input);
+  fireEvent.change(input, { target: { value: '012345' } });
+  fireEvent.click(screen.getByRole('button', { name: 'Verify & create account' }));
+  await screen.findByRole('heading', { name: 'You’re all set' });
+  expect(requests.map((request) => request.action)).toEqual(['send', 'verify', 'register']);
+  expect(requests[1].code).toBe('012345');
+  expect(options.signal?.aborted).toBe(true);
+});
+
+test('extracts WebOTP and submits through the normal verification flow', async () => {
+  render(<SignUpForm />);
+  await sendCode();
+  expect(options.otp).toEqual({ transport: ['sms'] });
+  await act(async () => deliver({ code: '012345' }));
+  await screen.findByRole('heading', { name: 'You’re all set' });
+  expect(requests[1]).toEqual({ action: 'verify', code: '012345' });
+  expect(options.signal?.aborted).toBe(true);
+});
+
+test('supports manual verification without WebOTP', async () => {
+  delete (window as unknown as Record<string, unknown>).OTPCredential;
+  render(<SignUpForm />);
+  await sendCode();
+  expect(smsGet).not.toHaveBeenCalled();
+  fireEvent.change(screen.getByLabelText('Verification code'), { target: { value: '654321' } });
+  fireEvent.click(screen.getByRole('button', { name: 'Verify & create account' }));
+  await screen.findByRole('heading', { name: 'You’re all set' });
+});
+
+test('keeps the manual form usable when SMS extraction is denied', async () => {
+  smsGet.mockRejectedValueOnce(new DOMException('Denied', 'NotAllowedError'));
+  render(<SignUpForm />);
+  await sendCode();
+  expect(screen.queryByRole('alert')).toBeNull();
+  expect(screen.getByLabelText('Verification code')).toBeTruthy();
+});
+
+test('aborts the SMS listener when changing details or unmounting', async () => {
+  const { unmount } = render(<SignUpForm />);
+  await sendCode();
+  const firstSignal = options.signal;
+  fireEvent.click(screen.getByRole('button', { name: 'Change number or details' }));
+  expect(firstSignal?.aborted).toBe(true);
+  expect(screen.getByLabelText('Phone number')).toBeTruthy();
+  unmount();
+});
+
+test('aborts pending extraction when navigating away', async () => {
+  render(<SignUpForm />);
+  await sendCode();
+  fireEvent(document, new Event('astro:before-swap'));
+  expect(options.signal?.aborted).toBe(true);
+  await act(async () => deliver({ code: '012345' }));
+  expect(requests.map((request) => request.action)).toEqual(['send']);
+});
+
+test('does not register when a code is rejected and announces the error', async () => {
+  const fetchMock = vi.mocked(fetch);
+  render(<SignUpForm />);
+  await sendCode();
+  fetchMock.mockResolvedValueOnce(Response.json({ error: 'That code is incorrect.' }, { status: 400 }));
+  fireEvent.change(screen.getByLabelText('Verification code'), { target: { value: '111111' } });
+  fireEvent.click(screen.getByRole('button', { name: 'Verify & create account' }));
+  expect((await screen.findByRole('alert')).textContent).toBe('That code is incorrect.');
+  expect(screen.getByLabelText('Verification code').getAttribute('aria-invalid')).toBe('true');
+  expect(requests.some((request) => request.action === 'register')).toBe(false);
+});
+
+test('disables resend during the cooldown', async () => {
+  render(<SignUpForm />);
+  await sendCode();
+  expect(screen.getByRole('button', { name: /Resend code in/ }).hasAttribute('disabled')).toBe(true);
+});
+
+test('accepts a pasted code containing spaces without losing digits', async () => {
+  render(<SignUpForm />);
+  await sendCode();
+  const input = screen.getByLabelText('Verification code') as HTMLInputElement;
+  fireEvent.paste(input, { clipboardData: { getData: () => '012 345' } });
+  expect(input.value).toBe('012345');
+});
+
+test('aborts an active SMS listener on unmount', async () => {
+  const { unmount } = render(<SignUpForm />);
+  await sendCode();
+  const signal = options.signal;
+  expect(signal?.aborted).toBe(false);
+  unmount();
+  expect(signal?.aborted).toBe(true);
+});
+
+test('resend cancels the previous listener and starts another before delivery', async () => {
+  vi.mocked(fetch).mockResolvedValueOnce(Response.json({ phone: '+12025550123', resendAt: Date.now() - 1 }));
+  render(<SignUpForm />);
+  await sendCode();
+  const firstSignal = options.signal;
+  fireEvent.click(screen.getByRole('button', { name: 'Resend code' }));
+  await waitFor(() => expect(smsGet).toHaveBeenCalledTimes(2));
+  expect(firstSignal?.aborted).toBe(true);
+  expect(options.signal?.aborted).toBe(false);
+});
diff --git a/tests/signup.test.mjs b/tests/signup.test.mjs
new file mode 100644
index 0000000..bec5db4
--- /dev/null
+++ b/tests/signup.test.mjs
@@ -0,0 +1,176 @@
+import { test, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import { POST } from '../src/pages/api/signup.ts';
+
+const originalFetch = globalThis.fetch;
+const originalEnv = { ...process.env };
+afterEach(() => {
+  globalThis.fetch = originalFetch;
+  for (const key of Object.keys(process.env)) if (!(key in originalEnv)) delete process.env[key];
+  Object.assign(process.env, originalEnv);
+});
+
+function setup() {
+  Object.assign(process.env, {
+    TWILIO_ACCOUNT_SID: 'ACtest', TWILIO_AUTH_TOKEN: 'secret',
+    TWILIO_VERIFY_SERVICE_SID: 'VAtest', TWILIO_VERIFY_TEMPLATE_SID: 'HJtest',
+  });
+  const state = new Map();
+  const session = {
+    get: async (key) => structuredClone(state.get(key)),
+    set: async (key, value) => state.set(key, structuredClone(value)),
+    delete: async (key) => state.delete(key),
+  };
+  const calls = [];
+  globalThis.fetch = async (url, options) => {
+    calls.push({ url, options });
+    if (String(url).endsWith('/Verifications')) return Response.json({ sid: 'VEtest', status: 'pending' });
+    if (String(url).endsWith('/VerificationCheck')) {
+      return Response.json({ status: options.body.get('Code') === '012345' ? 'approved' : 'pending' });
+    }
+    return Response.json({ success: true });
+  };
+  const submit = async (body, origin = 'https://example.com') => {
+    const url = new URL('https://example.com/devtools-times/api/signup');
+    const request = new Request(url, {
+      method: 'POST', headers: { origin, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+    });
+    const response = await POST({ request, session, url });
+    return { status: response.status, data: await response.json(), response };
+  };
+  return { submit, state, calls };
+}
+
+const details = { username: 'reader', password: 'password1' };
+
+test('sends a normalized phone number using the domain-bound SMS template', async () => {
+  const { submit, state, calls } = setup();
+  const result = await submit({ action: 'send', phone: '+1 (202) 555-0123' });
+  assert.equal(result.status, 200);
+  assert.equal(result.data.phone, '+12025550123');
+  assert.equal(result.response.headers.get('cache-control'), 'no-store');
+  assert.equal(calls[0].options.body.get('Channel'), 'sms');
+  assert.equal(calls[0].options.body.get('TemplateSid'), 'HJtest');
+  assert.equal(state.get('signupChallenge').verified, undefined);
+});
+
+test('rejects malformed and local-only phone numbers without sending SMS', async () => {
+  const { submit, calls } = setup();
+  for (const phone of ['2025550123', '+0123456789', '+1', null, '+12025550123456789']) {
+    assert.equal((await submit({ action: 'send', phone })).status, 400);
+  }
+  assert.equal(calls.length, 0);
+});
+
+test('rejects cross-origin requests', async () => {
+  const { submit, calls } = setup();
+  assert.equal((await submit({ action: 'send', phone: '+12025550123' }, 'https://other.example')).status, 403);
+  assert.equal(calls.length, 0);
+});
+
+test('fails clearly when SMS credentials are missing', async () => {
+  const { submit, calls } = setup();
+  delete process.env.TWILIO_AUTH_TOKEN;
+  assert.equal((await submit({ action: 'send', phone: '+12025550123' })).status, 503);
+  assert.equal(calls.length, 0);
+});
+
+test('enforces resend cooldown even when changing the number', async () => {
+  const { submit, calls } = setup();
+  await submit({ action: 'send', phone: '+12025550123' });
+  const result = await submit({ action: 'send', phone: '+442079460123' });
+  assert.equal(result.status, 429);
+  assert.ok(result.data.resendAt > Date.now());
+  assert.equal(calls.length, 1);
+});
+
+test('blocks registration without a server-side approved challenge', async () => {
+  const { submit, calls } = setup();
+  assert.equal((await submit({ action: 'register', ...details, verified: true })).status, 400);
+  await submit({ action: 'send', phone: '+12025550123' });
+  assert.equal((await submit({ action: 'register', ...details, verified: true })).status, 403);
+  assert.equal(calls.length, 1);
+});
+
+test('preserves leading zeros and consumes verification after account creation', async () => {
+  const { submit, state, calls } = setup();
+  await submit({ action: 'send', phone: '+12025550123' });
+  assert.equal((await submit({ action: 'verify', code: '012345' })).status, 200);
+  assert.equal(calls[1].options.body.get('Code'), '012345');
+  assert.equal(calls[1].options.body.get('VerificationSid'), 'VEtest');
+  assert.equal((await submit({ action: 'register', ...details, phone: '+442079460123' })).status, 200);
+  assert.equal(JSON.parse(calls[2].options.body).phone, '+12025550123');
+  assert.equal(state.has('signupChallenge'), false);
+  assert.equal((await submit({ action: 'register', ...details })).status, 400);
+  assert.equal(calls.length, 3);
+});
+
+test('rejects malformed codes before contacting the provider', async () => {
+  const { submit, calls } = setup();
+  await submit({ action: 'send', phone: '+12025550123' });
+  for (const code of ['12345', '1234567', '12a456', 123456]) {
+    assert.equal((await submit({ action: 'verify', code })).status, 400);
+  }
+  assert.equal(calls.length, 1);
+});
+
+test('rejects incorrect codes and limits verification attempts', async () => {
+  const { submit, calls } = setup();
+  await submit({ action: 'send', phone: '+12025550123' });
+  for (let index = 0; index < 5; index++) {
+    assert.equal((await submit({ action: 'verify', code: '111111' })).status, 400);
+  }
+  const result = await submit({ action: 'verify', code: '012345' });
+  assert.equal(result.status, 429);
+  assert.equal(result.data.expired, true);
+  assert.equal(calls.length, 6);
+});
+
+test('expired challenges cannot verify or register', async () => {
+  const { submit, state, calls } = setup();
+  state.set('signupChallenge', { phone: '+12025550123', sid: 'VEtest', expiresAt: Date.now() - 1, verified: true });
+  for (const action of ['verify', 'register']) {
+    const result = await submit({ action, code: '012345', ...details });
+    assert.equal(result.status, 400);
+    assert.equal(result.data.expired, true);
+  }
+  assert.equal(calls.length, 0);
+});
+
+test('provider errors never approve a code or create an account', async () => {
+  const { submit, state } = setup();
+  await submit({ action: 'send', phone: '+12025550123' });
+  globalThis.fetch = async () => Response.json({ error: 'provider detail' }, { status: 404 });
+  const result = await submit({ action: 'verify', code: '012345' });
+  assert.equal(result.data.expired, true);
+  assert.equal(state.get('signupChallenge').verified, undefined);
+});
+
+test('resend invalidates approval and retains expiry for a reused provider code', async () => {
+  const { submit, state } = setup();
+  const expiresAt = Date.now() + 60_000;
+  state.set('signupChallenge', { phone: '+12025550123', sid: 'VEtest', expiresAt, resendAt: 0, attempts: 0, verified: true });
+  await submit({ action: 'send', phone: '+12025550123' });
+  assert.equal(state.get('signupChallenge').verified, undefined);
+  assert.equal(state.get('signupChallenge').expiresAt, expiresAt);
+});
+
+test('delivery failure cannot reuse earlier verification', async () => {
+  const { submit, state } = setup();
+  state.set('signupChallenge', { phone: '+12025550123', sid: 'VEold', expiresAt: Date.now() + 60_000, resendAt: 0, verified: true });
+  globalThis.fetch = async () => { throw new Error('network'); };
+  assert.equal((await submit({ action: 'send', phone: '+442079460123' })).status, 503);
+  assert.equal(state.get('signupChallenge').verified, undefined);
+  assert.equal((await submit({ action: 'register', ...details })).status, 400);
+});
+
+test('registration failure allows retry without consuming the approved code again', async () => {
+  const { submit, state } = setup();
+  await submit({ action: 'send', phone: '+12025550123' });
+  await submit({ action: 'verify', code: '012345' });
+  globalThis.fetch = async () => Response.json({}, { status: 409 });
+  assert.equal((await submit({ action: 'register', ...details })).status, 400);
+  assert.equal(state.get('signupChallenge').verified, true);
+  globalThis.fetch = async () => Response.json({});
+  assert.equal((await submit({ action: 'register', ...details })).status, 200);
+});
