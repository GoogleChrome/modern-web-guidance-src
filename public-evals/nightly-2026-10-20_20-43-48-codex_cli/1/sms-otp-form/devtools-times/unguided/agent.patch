+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { handleSignup, normalizePhone, validPhone, validPassword } from '../src/lib/signup.ts';
+
+const config = { accountSid: 'AC_test', authToken: 'secret', serviceSid: 'VA_test' };
+function fixture() {
+  const values = new Map<string, unknown>();
+  return {
+    values,
+    session: { get: async (key: string) => values.get(key), set: (key: string, value: unknown) => { values.set(key, value); }, delete: (key: string) => { values.delete(key); } },
+    request: (body: object, origin = 'https://news.example') => new Request('https://news.example/api/signup', {
+      method: 'POST', headers: { Origin: origin, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+    }),
+  };
+}
+const details = { action: 'complete', username: 'reader', password: 'password1', phone: '+12025550123', code: '123456' };
+const pending = () => ({ phone: details.phone, sentAt: Date.now(), expiresAt: Date.now() + 600000, attempts: 0 });
+
+test('phone normalization and account validation', () => {
+  assert.equal(normalizePhone('+1 (202) 555-0123'), details.phone);
+  assert.equal(validPhone(details.phone), true);
+  for (const phone of ['2025550123', '+0123456789', '+123', '+1234567890123456', '+12025550123abc']) assert.equal(validPhone(phone), false);
+  assert.equal(validPassword('password1'), true);
+  assert.equal(validPassword('password'), false);
+  assert.equal(validPassword('short1'), false);
+});
+
+test('rejects cross-origin requests and missing configuration', async () => {
+  const { request, session } = fixture();
+  assert.equal((await handleSignup(request(details, 'https://other.example'), session, config)).status, 403);
+  assert.equal((await handleSignup(request(details), session, {})).status, 503);
+});
+
+test('requires a matching, unexpired SMS challenge before registration', async () => {
+  const { request, session, values } = fixture();
+  assert.equal((await handleSignup(request(details), session, config)).status, 410);
+  values.set('signupChallenge', { ...pending(), phone: '+442079460123' });
+  assert.equal((await handleSignup(request(details), session, config)).status, 410);
+  values.set('signupChallenge', { ...pending(), expiresAt: Date.now() - 1 });
+  assert.equal((await handleSignup(request(details), session, config)).status, 410);
+});
+
+test('send normalizes phone, invokes SMS provider, and enforces resend cooldown', async (t) => {
+  const { request, session } = fixture();
+  const calls: string[] = [];
+  t.mock.method(globalThis, 'fetch', async (url: string, options: RequestInit) => {
+    calls.push(url);
+    assert.equal(new URLSearchParams(options.body as URLSearchParams).get('To'), details.phone);
+    return Response.json({ status: 'pending' });
+  });
+  const body = { action: 'send', phone: '+1 (202) 555-0123' };
+  const response = await handleSignup(request(body), session, config);
+  assert.equal(response.status, 200);
+  assert.equal((await response.json()).phone, details.phone);
+  assert.equal((await handleSignup(request(body), session, config)).status, 429);
+  assert.equal(calls.length, 1);
+});
+
+test('incorrect codes never reach registration', async (t) => {
+  const { request, session, values } = fixture();
+  values.set('signupChallenge', pending());
+  const fetchMock = t.mock.method(globalThis, 'fetch', async () => Response.json({ status: 'pending' }));
+  assert.equal((await handleSignup(request(details), session, config)).status, 400);
+  assert.equal(fetchMock.mock.callCount(), 1);
+  assert.equal((values.get('signupChallenge') as { attempts: number }).attempts, 1);
+});
+
+test('limits code attempts and rejects malformed codes', async () => {
+  const { request, session, values } = fixture();
+  values.set('signupChallenge', { ...pending(), attempts: 5 });
+  assert.equal((await handleSignup(request({ ...details, code: '123' }), session, config)).status, 400);
+  assert.equal((await handleSignup(request(details), session, config)).status, 429);
+});
+
+test('approved code registers verified phone, consumes challenge, and blocks replay', async (t) => {
+  const { request, session, values } = fixture();
+  values.set('signupChallenge', pending());
+  const urls: string[] = [];
+  t.mock.method(globalThis, 'fetch', async (url: string, options: RequestInit) => {
+    urls.push(url);
+    if (url.endsWith('/VerificationCheck')) return Response.json({ status: 'approved' });
+    assert.deepEqual(JSON.parse(options.body as string), { username: details.username, password: details.password, phone: details.phone });
+    return Response.json({ success: true });
+  });
+  assert.equal((await handleSignup(request(details), session, config)).status, 200);
+  assert.equal(urls.length, 2);
+  assert.equal(values.has('signupChallenge'), false);
+  assert.equal((await handleSignup(request(details), session, config)).status, 410);
+});
+
+test('registration can retry after approval without reusing the OTP', async (t) => {
+  const { request, session, values } = fixture();
+  values.set('signupChallenge', pending());
+  let checks = 0;
+  let registrations = 0;
+  t.mock.method(globalThis, 'fetch', async (url: string) => {
+    if (url.endsWith('/VerificationCheck')) { checks++; return Response.json({ status: 'approved' }); }
+    registrations++;
+    return Response.json({}, { status: registrations === 1 ? 500 : 200 });
+  });
+  assert.equal((await handleSignup(request(details), session, config)).status, 502);
+  assert.equal((await handleSignup(request(details), session, config)).status, 200);
+  assert.equal(checks, 1);
+});
+
+test('provider errors do not expose credentials or create accounts', async (t) => {
+  const { request, session } = fixture();
+  t.mock.method(globalThis, 'fetch', async () => { throw new Error('secret provider error'); });
+  const response = await handleSignup(request({ action: 'send', phone: details.phone }), session, config);
+  assert.equal(response.status, 502);
+  assert.equal((await response.text()).includes('secret'), false);
+});
