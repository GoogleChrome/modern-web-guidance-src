diff --git a/src/lib/signup.ts b/src/lib/signup.ts
new file mode 100644
index 0000000..9bfa6c9
--- /dev/null
+++ b/src/lib/signup.ts
@@ -0,0 +1,91 @@
+export const normalizePhone = (value: string) => value.replace(/[\s().-]/g, '');
+export const validPhone = (value: string) => /^\+[1-9]\d{7,14}$/.test(value);
+export const validPassword = (value: string) => value.length >= 8 && /\d/.test(value);
+
+type Challenge = { phone: string; sentAt: number; expiresAt: number; attempts: number; verified?: boolean };
+export interface SignupSession {
+  get(key: string): Promise<unknown>;
+  set(key: string, value: unknown): unknown;
+  delete(key: string): unknown;
+}
+export interface SmsConfig {
+  accountSid?: string;
+  authToken?: string;
+  serviceSid?: string;
+}
+const json = (data: object, status = 200) => Response.json(data, {
+  status, headers: { 'Cache-Control': 'no-store' },
+});
+
+export async function handleSignup(request: Request, session: SignupSession | undefined, config: SmsConfig) {
+  // This endpoint has its own origin check because the app disables Astro's global check.
+  if (request.headers.get('origin') !== new URL(request.url).origin) {
+    return json({ error: 'Please submit this form from this website.' }, 403);
+  }
+  if (!session || !config.accountSid || !config.authToken || !config.serviceSid) {
+    return json({ error: 'SMS verification is currently unavailable. Please try again later.' }, 503);
+  }
+  let body;
+  try { body = await request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+  const { action, username, password, code } = body;
+  const phone = typeof body.phone === 'string' ? normalizePhone(body.phone) : '';
+  const challenge = await session.get('signupChallenge') as Challenge | undefined;
+  const now = Date.now();
+  const provider = async (path: string, params: Record<string, string>) => {
+    const response = await fetch(`https://verify.twilio.com/v2/Services/${config.serviceSid}/${path}`, {
+      method: 'POST',
+      headers: {
+        Authorization: `Basic ${Buffer.from(`${config.accountSid}:${config.authToken}`).toString('base64')}`,
+        'Content-Type': 'application/x-www-form-urlencoded',
+      },
+      body: new URLSearchParams(params),
+      signal: AbortSignal.timeout(15000),
+    });
+    return { response, data: await response.json() };
+  };
+  try {
+    if (action === 'send') {
+      if (!validPhone(phone)) return json({ error: 'Enter a phone number with its country code, for example +1 202 555 0123.' }, 400);
+      const retryAfter = challenge ? Math.ceil((challenge.sentAt + 30000 - now) / 1000) : 0;
+      if (retryAfter > 0) return json({ error: `Please wait ${retryAfter} seconds before requesting another code.`, retryAfter }, 429);
+      // Reserve the cooldown even if the provider rejects the request.
+      const next = { phone, sentAt: now, expiresAt: now + 600000, attempts: 0 };
+      await session.set('signupChallenge', next);
+      const { response, data } = await provider('Verifications', { To: phone, Channel: 'sms' });
+      if (!response.ok || data.status !== 'pending') {
+        return json({ error: 'We could not send a code. Check your number and try again shortly.', retryAfter: 30 }, response.status === 429 ? 429 : 502);
+      }
+      return json({ phone, retryAfter: 30 });
+    }
+    if (action !== 'complete') return json({ error: 'Invalid request.' }, 400);
+    if (typeof username !== 'string' || !username.trim() || username.length > 100 || typeof password !== 'string' || !validPassword(password)) {
+      return json({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+    }
+    if (!challenge || challenge.phone !== phone || challenge.expiresAt <= now) {
+      return json({ error: 'Your verification has expired. Request a new code.' }, 410);
+    }
+    if (!challenge.verified) {
+      if (typeof code !== 'string' || !/^\d{6}$/.test(code)) return json({ error: 'Enter the 6-digit code from your text message.' }, 400);
+      if (challenge.attempts >= 5) return json({ error: 'Too many attempts. Request a new code.' }, 429);
+      challenge.attempts += 1;
+      await session.set('signupChallenge', challenge);
+      const { response, data } = await provider('VerificationCheck', { To: challenge.phone, Code: code });
+      if (response.status === 404) return json({ error: 'Your code has expired. Request a new code.' }, 410);
+      if (!response.ok || data.status !== 'approved') return json({ error: 'That code could not be verified. Check it and try again.' }, 400);
+      // Retain approval briefly so a registration failure can be retried without reusing an OTP.
+      challenge.verified = true;
+      await session.set('signupChallenge', challenge);
+    }
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: username.trim(), password, phone: challenge.phone }),
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok) return json({ error: 'Your account could not be created. Try another username or try again shortly.' }, response.status >= 500 ? 502 : 400);
+    await session.delete('signupChallenge');
+    return json({ success: true });
+  } catch {
+    return json({ error: 'We could not connect to the service. Please try again.' }, 502);
+  }
+}
