+import type { APIRoute } from 'astro';
+import { handleSignup } from '../../lib/signup';
+
+export const POST: APIRoute = ({ request, session }) => handleSignup(request, session, {
+  accountSid: process.env.TWILIO_ACCOUNT_SID || import.meta.env.TWILIO_ACCOUNT_SID,
+  authToken: process.env.TWILIO_AUTH_TOKEN || import.meta.env.TWILIO_AUTH_TOKEN,
+  serviceSid: process.env.TWILIO_VERIFY_SERVICE_SID || import.meta.env.TWILIO_VERIFY_SERVICE_SID,
+});
