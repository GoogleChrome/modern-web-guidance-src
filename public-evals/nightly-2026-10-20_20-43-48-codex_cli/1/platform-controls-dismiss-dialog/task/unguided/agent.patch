+  <script>
+    const coffeeDialog = document.getElementById('coffee-details');
+    const coffeeTitle = document.getElementById('coffee-details-title');
+    const coffeeDescription = document.getElementById('coffee-details-description');
+
+    document.querySelectorAll('.show-details').forEach((button) => {
+      button.addEventListener('click', () => {
+        const card = button.closest('.card');
+        coffeeTitle.textContent = card.querySelector('h3').textContent;
+        coffeeDescription.textContent = card.querySelector('p').textContent;
+        coffeeDialog.showModal();
+      });
+    });
+
+    coffeeDialog.addEventListener('click', (event) => {
+      const bounds = coffeeDialog.getBoundingClientRect();
+      if (event.target === coffeeDialog && (
+        event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom
+      )) {
+        coffeeDialog.close();
+      }
+    });
