+  <script>
+    const coffeeDialog = document.getElementById('coffee-details');
+    const coffeeTitle = document.getElementById('coffee-details-title');
+    const coffeeDescription = document.getElementById('coffee-details-description');
+
+    document.querySelectorAll('[data-coffee-details]').forEach((button) => {
+      button.addEventListener('click', () => {
+        const card = button.closest('.card');
+        coffeeTitle.textContent = card.querySelector('h3').textContent;
+        coffeeDescription.textContent = card.querySelector('p').textContent;
+        coffeeDialog.showModal();
+      });
+    });
+
+    // Support outside-click dismissal in browsers without native closedby support.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      coffeeDialog.addEventListener('click', (event) => {
+        if (event.target !== coffeeDialog) return;
+
+        const rect = coffeeDialog.getBoundingClientRect();
+        const isInside = event.clientX >= rect.left && event.clientX <= rect.right &&
+          event.clientY >= rect.top && event.clientY <= rect.bottom;
+
+        if (!isInside) coffeeDialog.close();
+      });
+    }
+  </script>
