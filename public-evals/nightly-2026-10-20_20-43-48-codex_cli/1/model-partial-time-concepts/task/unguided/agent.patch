+  <script>
+    (() => {
+      // A December 2027 card is valid through December 31 in the user's timezone.
+      // Compare UTC calendar dates so leap days count correctly and DST cannot
+      // turn a calendar day into a 23- or 25-hour day in this calculation.
+      const now = new Date();
+      const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
+      const expiresOn = Date.UTC(2028, 0, 1);
+      const daysRemaining = Math.max(0, (expiresOn - today) / 86400000);
+
+      document.getElementById('card-expiry').textContent = daysRemaining > 0
+        ? `Your credit card expires in ${daysRemaining} ${daysRemaining === 1 ? 'day' : 'days'} (December 2027).`
+        : 'Your credit card expired in December 2027.';
+    })();
+  </script>
