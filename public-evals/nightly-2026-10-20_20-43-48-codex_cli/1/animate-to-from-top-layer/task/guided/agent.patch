+  <dialog id="logout-dialog" class="overlay-panel" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <div class="overlay-heading">
+      <h2 id="logout-title">Log out?</h2>
+      <button type="button" id="close-dialog-btn" class="close-button" aria-label="Close logout confirmation">&times;</button>
+    </div>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <button type="button" id="confirm-logout-btn" class="btn">Log out</button>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="overlay-panel" aria-labelledby="ordering-title" hidden>
+    <div class="overlay-heading">
+      <h2 id="ordering-title">Ordering update</h2>
+      <button type="button" id="close-notice-btn" class="close-button" aria-label="Dismiss ordering notice">&times;</button>
+    </div>
+    <p role="status">online ordering is currently offline</p>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderingButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+    const closingPanels = new WeakMap();
+
+    function revealPanel(panel) {
+      // Commit the initial style so entry also animates without @starting-style.
+      panel.getBoundingClientRect();
+      panel.setAttribute('data-visible', '');
+    }
+
+    function dismissPanel(panel, trigger) {
+      if (closingPanels.has(panel)) return closingPanels.get(panel);
+      if (!panel.hasAttribute('data-visible')) return Promise.resolve();
+
+      // Keep the panel and backdrop rendered until their CSS exits finish.
+      // This also supports browsers without discrete top-layer transitions.
+      panel.setAttribute('data-closing', '');
+      const animations = panel.getAnimations({ subtree: true });
+      const closing = (async () => {
+        let timeout;
+        await Promise.race([
+          Promise.allSettled(animations.map(animation => animation.finished)),
+          new Promise(resolve => { timeout = setTimeout(resolve, 400); })
+        ]);
+        clearTimeout(timeout);
+        if (panel === logoutDialog) {
+          panel.close();
+        } else {
+          panel.hidden = true;
+          trigger.setAttribute('aria-expanded', 'false');
+        }
+        panel.removeAttribute('data-visible');
+        panel.removeAttribute('data-closing');
+        closingPanels.delete(panel);
+        trigger.focus({ preventScroll: true });
+      })();
+      closingPanels.set(panel, closing);
+      return closing;
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      if (logoutDialog.open || closingPanels.has(logoutDialog)) return;
+      logoutDialog.showModal();
+      revealPanel(logoutDialog);
+    });
+
+    const dismissLogout = () => dismissPanel(logoutDialog, logoutLink);
+    document.getElementById('close-dialog-btn').addEventListener('click', dismissLogout);
+    document.getElementById('cancel-logout-btn').addEventListener('click', dismissLogout);
+    logoutDialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      dismissLogout();
+    });
+    document.getElementById('confirm-logout-btn').addEventListener('click', async () => {
+      await dismissLogout();
+      window.location.assign(logoutLink.href);
+    });
+
+    const dismissNotice = () => dismissPanel(orderingNotice, orderingButton);
+    orderingButton.addEventListener('click', () => {
+      if (closingPanels.has(orderingNotice)) return;
+      if (!orderingNotice.hidden) {
+        dismissNotice();
+        return;
+      }
+      orderingNotice.hidden = false;
+      orderingButton.setAttribute('aria-expanded', 'true');
+      revealPanel(orderingNotice);
+      document.getElementById('close-notice-btn').focus({ preventScroll: true });
+    });
+    document.getElementById('close-notice-btn').addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !logoutDialog.open && !orderingNotice.hidden) {
+        event.preventDefault();
+        dismissNotice();
+      }
+    });
+  </script>
