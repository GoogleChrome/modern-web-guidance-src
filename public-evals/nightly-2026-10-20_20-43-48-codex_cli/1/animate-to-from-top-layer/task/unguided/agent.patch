+  <dialog class="logout-dialog" id="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" class="close-button" id="close-dialog-btn" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" class="btn btn-secondary" id="cancel-logout-btn" autofocus>Cancel</button>
+      <a href="/logout" class="btn">Log out</a>
+    </div>
+  </dialog>
+
+  <aside class="order-notice" id="order-notice" aria-label="Online ordering notice" hidden>
+    <p role="status">online ordering is currently offline</p>
+    <button type="button" class="close-button" id="dismiss-notice-btn" aria-label="Dismiss ordering notice">&times;</button>
+  </aside>
+
+  <script>
+    const logoutTrigger = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderTrigger = document.getElementById('foobar');
+    const orderNotice = document.getElementById('order-notice');
+
+    // Keep each surface mounted until its CSS exit animation has finished.
+    async function animateOut(element, finish) {
+      if (element.classList.contains('is-closing')) return;
+      element.classList.add('is-closing');
+      await Promise.all(element.getAnimations().map(animation => animation.finished.catch(() => {})));
+      finish();
+      element.classList.remove('is-closing');
+    }
+
+    function closeLogout() {
+      if (logoutDialog.open) animateOut(logoutDialog, () => logoutDialog.close());
+    }
+
+    logoutTrigger.addEventListener('click', event => {
+      event.preventDefault();
+      if (!logoutDialog.open) logoutDialog.showModal();
+    });
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogout);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogout);
+    logoutDialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeLogout();
+    });
+    logoutDialog.addEventListener('click', event => {
+      if (event.target !== logoutDialog) return;
+      const bounds = logoutDialog.getBoundingClientRect();
+      if (event.clientX < bounds.left || event.clientX > bounds.right ||
+          event.clientY < bounds.top || event.clientY > bounds.bottom) closeLogout();
+    });
+
+    orderTrigger.addEventListener('click', () => {
+      orderNotice.hidden = false;
+      orderTrigger.setAttribute('aria-expanded', 'true');
+    });
+
+    function dismissNotice() {
+      if (orderNotice.hidden) return;
+      animateOut(orderNotice, () => {
+        const restoreFocus = orderNotice.contains(document.activeElement);
+        orderNotice.hidden = true;
+        orderTrigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) orderTrigger.focus();
+      });
+    }
+
+    document.getElementById('dismiss-notice-btn').addEventListener('click', dismissNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !logoutDialog.open) dismissNotice();
+    });
+  </script>
+
