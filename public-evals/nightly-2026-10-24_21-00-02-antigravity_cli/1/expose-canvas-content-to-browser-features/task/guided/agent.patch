+  <script>
+    const canvas = document.getElementById("canvas");
+    const canvasStage = document.getElementById("canvas-stage");
+    const uiElement = document.getElementById("cup-order-ui");
+    const form = document.getElementById("coffee-customizer-form");
+    const nameInput = document.getElementById("customer-name");
+    const milkSelect = document.getElementById("milk-choice");
+    const orderStatus = document.getElementById("order-status");
+    const ctx = canvas.getContext("2d");
+
+    // 1. Check if HTML-in-Canvas is supported in the browser
+    const supportsHtmlInCanvas = "content" in HTMLCanvasElement.prototype;
+
+    if (!supportsHtmlInCanvas && canvasStage && uiElement) {
+      // Fallback strategy: place the interactive HTML content on top of the canvas using CSS
+      canvasStage.classList.add("is-fallback");
+      canvasStage.appendChild(uiElement);
+    }
+
+    const MILK_COLORS = {
+      "Oat Milk": "#e6d2b5",
+      "Whole Milk": "#f5ebe0",
+      "Almond Milk": "#dfcbb2",
+      "Coconut Milk": "#f7f3ee"
+    };
+
+    const SYRUP_COLORS = {
+      "Vermont Maple": "#b5651d",
+      "Madagascar Vanilla": "#f3d59b",
+      "Salted Caramel": "#c67d30",
+      "Roasted Hazelnut": "#7b4b2a"
+    };
+
+    function getOrderState() {
+      const selectedSyrup = form.querySelector('input[name="syrup"]:checked');
+      return {
+        name: (nameInput.value || "Guest").trim(),
+        milk: milkSelect.value,
+        syrup: selectedSyrup ? selectedSyrup.value : "Vermont Maple"
+      };
+    }
+
+    function drawCoffeeCupScene() {
+      const dpr = canvas.clientWidth > 0 ? canvas.width / canvas.clientWidth : (window.devicePixelRatio || 1);
+      const width = canvas.clientWidth || 780;
+      const height = canvas.clientHeight || 500;
+      const state = getOrderState();
+
+      ctx.save();
+      ctx.scale(dpr, dpr);
+
+      // Soft warm backdrop
+      const bgGrad = ctx.createLinearGradient(0, 0, width, height);
+      bgGrad.addColorStop(0, "#fdfaf6");
+      bgGrad.addColorStop(1, "#efe6dd");
+      ctx.fillStyle = bgGrad;
+      ctx.fillRect(0, 0, width, height);
+
+      // Subtle wooden counter surface at bottom
+      ctx.fillStyle = "#d7ccc8";
+      ctx.fillRect(0, height - 70, width, 70);
+      ctx.fillStyle = "#bcaaa4";
+      ctx.fillRect(0, height - 70, width, 4);
+
+      const cupCenterX = 200;
+      const cupTopY = 125;
+      const cupBottomY = 415;
+      const topHalfW = 102;
+      const bottomHalfW = 72;
+
+      // Cup drop shadow
+      ctx.beginPath();
+      ctx.ellipse(cupCenterX, cupBottomY + 12, bottomHalfW + 18, 16, 0, 0, Math.PI * 2);
+      ctx.fillStyle = "rgba(62, 39, 35, 0.16)";
+      ctx.fill();
+
+      // Steam wisps
+      ctx.strokeStyle = "rgba(141, 110, 99, 0.35)";
+      ctx.lineWidth = 3;
+      ctx.lineCap = "round";
+      [-35, 0, 35].forEach((offsetX, i) => {
+        ctx.beginPath();
+        ctx.moveTo(cupCenterX + offsetX, cupTopY - 22);
+        ctx.bezierCurveTo(
+          cupCenterX + offsetX - 14, cupTopY - 45,
+          cupCenterX + offsetX + 14, cupTopY - 65,
+          cupCenterX + offsetX - 4, cupTopY - 85 - (i % 2) * 8
+        );
+        ctx.stroke();
+      });
+
+      // Cup body (tapered artisanal ceramic/paper cup)
+      ctx.beginPath();
+      ctx.moveTo(cupCenterX - topHalfW, cupTopY);
+      ctx.lineTo(cupCenterX + topHalfW, cupTopY);
+      ctx.lineTo(cupCenterX + bottomHalfW, cupBottomY);
+      ctx.quadraticCurveTo(cupCenterX, cupBottomY + 18, cupCenterX - bottomHalfW, cupBottomY);
+      ctx.closePath();
+
+      const cupGrad = ctx.createLinearGradient(cupCenterX - topHalfW, cupTopY, cupCenterX + topHalfW, cupTopY);
+      cupGrad.addColorStop(0, "#fffdf9");
+      cupGrad.addColorStop(0.55, "#f7f1e8");
+      cupGrad.addColorStop(1, "#e2d5c6");
+      ctx.fillStyle = cupGrad;
+      ctx.fill();
+      ctx.lineWidth = 2.5;
+      ctx.strokeStyle = "#8d6e63";
+      ctx.stroke();
+
+      // Liquid preview band near top of cup showing milk & syrup blend
+      const milkColor = MILK_COLORS[state.milk] || "#e6d2b5";
+      const syrupColor = SYRUP_COLORS[state.syrup] || "#b5651d";
+
+      // Kraft cardboard sleeve in the middle of the cup
+      const sleeveTopY = 215;
+      const sleeveBottomY = 325;
+      const t1 = (sleeveTopY - cupTopY) / (cupBottomY - cupTopY);
+      const t2 = (sleeveBottomY - cupTopY) / (cupBottomY - cupTopY);
+      const sleeveTopW = topHalfW - (topHalfW - bottomHalfW) * t1;
+      const sleeveBottomW = topHalfW - (topHalfW - bottomHalfW) * t2;
+
+      ctx.beginPath();
+      ctx.moveTo(cupCenterX - sleeveTopW, sleeveTopY);
+      ctx.lineTo(cupCenterX + sleeveTopW, sleeveTopY);
+      ctx.lineTo(cupCenterX + sleeveBottomW, sleeveBottomY);
+      ctx.lineTo(cupCenterX - sleeveBottomW, sleeveBottomY);
+      ctx.closePath();
+
+      const sleeveGrad = ctx.createLinearGradient(cupCenterX - sleeveTopW, sleeveTopY, cupCenterX + sleeveTopW, sleeveTopY);
+      sleeveGrad.addColorStop(0, "#c89f76");
+      sleeveGrad.addColorStop(0.5, "#d7b38c");
+      sleeveGrad.addColorStop(1, "#b0855b");
+      ctx.fillStyle = sleeveGrad;
+      ctx.fill();
+      ctx.strokeStyle = "#795548";
+      ctx.lineWidth = 2;
+      ctx.stroke();
+
+      // Syrup accent stripe on the sleeve
+      ctx.beginPath();
+      ctx.moveTo(cupCenterX - sleeveTopW + 3, sleeveTopY + 12);
+      ctx.lineTo(cupCenterX + sleeveTopW - 3, sleeveTopY + 12);
+      ctx.strokeStyle = syrupColor;
+      ctx.lineWidth = 5;
+      ctx.stroke();
+
+      // Handwritten-style order preview on the cup sleeve
+      ctx.fillStyle = "#3e2723";
+      ctx.textAlign = "center";
+      ctx.font = "bold 18px 'Segoe UI', sans-serif";
+      ctx.fillText(state.name.slice(0, 16), cupCenterX, sleeveTopY + 46);
+
+      ctx.font = "600 12px 'Segoe UI', sans-serif";
+      ctx.fillStyle = "#4e342e";
+      ctx.fillText(state.milk, cupCenterX, sleeveTopY + 68);
+      ctx.fillText("+ " + state.syrup, cupCenterX, sleeveTopY + 86);
+
+      // Coffee Lid
+      ctx.beginPath();
+      ctx.roundRect(cupCenterX - topHalfW - 10, cupTopY - 18, (topHalfW + 10) * 2, 22, 8);
+      ctx.fillStyle = "#4e342e";
+      ctx.fill();
+      ctx.strokeStyle = "#3e2723";
+      ctx.lineWidth = 2;
+      ctx.stroke();
+
+      // Top rim highlight showing milk foam & syrup drizzle
+      ctx.beginPath();
+      ctx.ellipse(cupCenterX, cupTopY - 18, topHalfW - 8, 8, 0, 0, Math.PI * 2);
+      ctx.fillStyle = milkColor;
+      ctx.fill();
+      ctx.strokeStyle = syrupColor;
+      ctx.lineWidth = 2.5;
+      ctx.stroke();
+
+      ctx.restore();
+    }
+
+    function renderCanvas() {
+      ctx.reset();
+      drawCoffeeCupScene();
+
+      // 5. Render the HTML content to the canvas inside canvas.onpaint using drawElementImage
+      // In 2D context, drawElementImage automatically syncs the DOM hit-test bounds
+      // and accessibility focus rings with the drawn coordinates.
+      if (supportsHtmlInCanvas && typeof ctx.drawElementImage === "function") {
+        const dpr = canvas.clientWidth > 0 ? canvas.width / canvas.clientWidth : (window.devicePixelRatio || 1);
+        ctx.save();
+        ctx.scale(dpr, dpr);
+        ctx.drawElementImage(uiElement, 390, 32);
+        ctx.restore();
+      }
+    }
+
+    function requestCanvasUpdate() {
+      if (supportsHtmlInCanvas && typeof canvas.requestPaint === "function") {
+        canvas.requestPaint();
+      } else {
+        renderCanvas();
+      }
+    }
+
+    // Use canvas.onpaint event handler to render the HTML content to the canvas
+    canvas.onpaint = () => {
+      renderCanvas();
+    };
+
+    // 4. Scale canvas grid to match device scale factor to prevent blurriness
+    const observer = new ResizeObserver(([entry]) => {
+      const dpc = entry.devicePixelContentBoxSize;
+      canvas.width = dpc
+        ? dpc[0].inlineSize
+        : Math.round(entry.contentRect.width * window.devicePixelRatio);
+      canvas.height = dpc
+        ? dpc[0].blockSize
+        : Math.round(entry.contentRect.height * window.devicePixelRatio);
+      requestCanvasUpdate();
+    });
+
+    const supportsDevicePixelContentBox =
+      typeof ResizeObserverEntry !== "undefined" &&
+      "devicePixelContentBoxSize" in ResizeObserverEntry.prototype;
+    const options = supportsDevicePixelContentBox
+      ? { box: "device-pixel-content-box" }
+      : {};
+    observer.observe(canvas, options);
+
+    // Re-paint when user types or selects options
+    form.addEventListener("input", () => {
+      orderStatus.textContent = "";
+      requestCanvasUpdate();
+    });
+
+    form.addEventListener("change", () => {
+      orderStatus.textContent = "";
+      requestCanvasUpdate();
+    });
+
+    form.addEventListener("submit", (event) => {
+      event.preventDefault();
+      const state = getOrderState();
+      orderStatus.textContent = `Order ready for ${state.name}: ${state.milk} with ${state.syrup}!`;
+      requestCanvasUpdate();
+    });
+
+    // Initial render
+    requestCanvasUpdate();
+  </script>
+
 </body>
 
