+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingSubmit = document.getElementById('shipping-submit');
+    const shippingStatus = document.getElementById('shipping-status');
+
+    shippingForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!shippingForm.checkValidity()) {
+        shippingForm.reportValidity();
+        return;
+      }
+      shippingSubmit.disabled = true;
+      shippingStatus.textContent = 'Shipping address saved! Redirecting to payment...';
+      shippingStatus.classList.add('visible');
+    });
+  </script>
