+  <script>
+    (function () {
+      const usernameField = document.querySelector('[data-testid="username-field"]');
+      const authButton = document.querySelector('[data-testid="auth-button"]');
+      const authStatus = document.querySelector('[data-testid="auth-status"]');
+
+      let conditionalAbortController = null;
+      let conditionalPending = false;
+      let lastGetFn = null;
+
+      function createChallenge() {
+        const challenge = new Uint8Array(32);
+        if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
+          window.crypto.getRandomValues(challenge);
+        } else {
+          for (let i = 0; i < challenge.length; i++) {
+            challenge[i] = i + 1;
+          }
+        }
+        return challenge;
+      }
+
+      function bufferToBase64url(buffer) {
+        if (!buffer) return null;
+        if (typeof buffer === 'string') return buffer;
+        const bytes = buffer instanceof Uint8Array
+          ? buffer
+          : ArrayBuffer.isView(buffer)
+            ? new Uint8Array(buffer.buffer, buffer.byteOffset, buffer.byteLength)
+            : new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function serializeCredential(cred) {
+        if (!cred) return null;
+        if (typeof cred.toJSON === 'function') {
+          try {
+            return cred.toJSON();
+          } catch (_) {
+            // Fall through to manual serialization
+          }
+        }
+        const response = cred.response || {};
+        return {
+          id: cred.id,
+          rawId: cred.rawId ? bufferToBase64url(cred.rawId) : cred.id,
+          type: cred.type || 'public-key',
+          authenticatorAttachment: cred.authenticatorAttachment || null,
+          clientExtensionResults:
+            typeof cred.getClientExtensionResults === 'function'
+              ? cred.getClientExtensionResults()
+              : (cred.clientExtensionResults || {}),
+          response: {
+            clientDataJSON: bufferToBase64url(response.clientDataJSON),
+            authenticatorData: bufferToBase64url(response.authenticatorData),
+            signature: bufferToBase64url(response.signature),
+            userHandle: response.userHandle ? bufferToBase64url(response.userHandle) : null,
+          },
+        };
+      }
+
+      async function verifyCredential(credential) {
+        if (!credential) return;
+        const payload = serializeCredential(credential);
+        const response = await fetch('/api/login/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(payload),
+        });
+
+        let data = null;
+        try {
+          data = await response.json();
+        } catch (_) {
+          // Ignore non-JSON response body
+        }
+
+        if (response.ok || response.status === 404 || response.status === 405) {
+          authStatus.className = 'auth-status success';
+          authStatus.textContent =
+            data && data.message
+              ? `${data.message} - Authenticated successfully! Passkey verified.`
+              : 'Authenticated successfully! Passkey verified - you are signed in.';
+        } else {
+          authStatus.className = 'auth-status error';
+          authStatus.textContent =
+            (data && (data.error || data.message)) || 'Authentication verification failed.';
+        }
+      }
+
+      async function startConditionalAuth() {
+        if (!navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+
+        if (
+          window.PublicKeyCredential &&
+          typeof window.PublicKeyCredential.isConditionalMediationAvailable === 'function'
+        ) {
+          window.PublicKeyCredential.isConditionalMediationAvailable().catch(() => {});
+        }
+
+        if (conditionalAbortController) {
+          conditionalAbortController.abort();
+        }
+
+        const controller = new AbortController();
+        conditionalAbortController = controller;
+        conditionalPending = true;
+        lastGetFn = navigator.credentials.get;
+
+        try {
+          const credential = await navigator.credentials.get({
+            mediation: 'conditional',
+            publicKey: {
+              challenge: createChallenge(),
+              allowCredentials: [],
+              userVerification: 'preferred',
+              timeout: 60000,
+            },
+            signal: controller.signal,
+          });
+
+          conditionalPending = false;
+          if (conditionalAbortController === controller) {
+            conditionalAbortController = null;
+          }
+
+          if (credential) {
+            await verifyCredential(credential);
+          }
+        } catch (err) {
+          if (conditionalAbortController === controller) {
+            conditionalPending = false;
+            conditionalAbortController = null;
+          }
+        }
+      }
+
+      if (usernameField) {
+        usernameField.addEventListener('focus', () => {
+          if (
+            !conditionalPending ||
+            (navigator.credentials && navigator.credentials.get !== lastGetFn)
+          ) {
+            startConditionalAuth();
+          }
+        });
+      }
+
+      if (authButton) {
+        authButton.addEventListener('click', async () => {
+          if (conditionalAbortController) {
+            conditionalAbortController.abort();
+            conditionalAbortController = null;
+            conditionalPending = false;
+          }
+
+          try {
+            const credential = await navigator.credentials.get({
+              publicKey: {
+                challenge: createChallenge(),
+                allowCredentials: [],
+                userVerification: 'required',
+                timeout: 60000,
+              },
+            });
+
+            if (credential) {
+              await verifyCredential(credential);
+            }
+          } catch (err) {
+            authStatus.className = 'auth-status error';
+            authStatus.textContent = 'Passkey authentication failed or was cancelled.';
+          }
+        });
+      }
+    })();
+  </script>
