+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const emailInput = document.getElementById('newsletter-email');
+    const successMsg = document.getElementById('newsletter-success');
+
+    const updateAriaState = (event) => {
+      const input = event.target;
+      if (!input.matches?.('input, textarea, select')) return;
+
+      const isUserInvalid = CSS.supports('selector(:user-invalid)')
+        ? input.matches(':user-invalid')
+        : input.classList.contains('user-invalid-fallback');
+
+      if (isUserInvalid) {
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+
+    document.addEventListener('blur', updateAriaState, true);
+    document.addEventListener('focus', updateAriaState, true);
+
+    document.addEventListener('input', (event) => {
+      const input = event.target;
+      if (!input.matches?.('input, textarea, select')) return;
+
+      if (successMsg) {
+        successMsg.style.display = 'none';
+      }
+
+      if (input.getAttribute('aria-invalid') === 'true') {
+        updateAriaState(event);
+      }
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (emailInput.checkValidity()) {
+        emailInput.removeAttribute('aria-invalid');
+        if (successMsg) {
+          successMsg.style.display = 'block';
+        }
+        newsletterForm.reset();
+      } else {
+        emailInput.setAttribute('aria-invalid', 'true');
+      }
+    });
+  </script>
+
 </body>
 
