+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const feedback = document.getElementById('newsletter-feedback');
+
+      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+      function isValidEmail(value) {
+        return emailRegex.test(value.trim());
+      }
+
+      function clearState() {
+        emailInput.classList.remove('is-invalid', 'is-valid', 'error', 'invalid');
+        form.classList.remove('is-invalid', 'error', 'invalid');
+        emailInput.setAttribute('aria-invalid', 'false');
+        feedback.textContent = '';
+        feedback.className = 'newsletter-feedback';
+      }
+
+      function showError(message) {
+        emailInput.classList.remove('is-valid');
+        emailInput.classList.add('is-invalid', 'error');
+        form.classList.add('is-invalid');
+        emailInput.setAttribute('aria-invalid', 'true');
+        feedback.textContent = message;
+        feedback.className = 'newsletter-feedback error';
+      }
+
+      function showSuccess(message) {
+        emailInput.classList.remove('is-invalid', 'error', 'invalid');
+        form.classList.remove('is-invalid', 'error', 'invalid');
+        emailInput.classList.add('is-valid');
+        emailInput.setAttribute('aria-invalid', 'false');
+        feedback.textContent = message;
+        feedback.className = 'newsletter-feedback success';
+      }
+
+      // Never show an error while the user is actively typing
+      emailInput.addEventListener('input', function () {
+        clearState();
+      });
+
+      // Validate only after the user clicks away (blur)
+      emailInput.addEventListener('blur', function () {
+        const val = emailInput.value.trim();
+        if (val === '') {
+          clearState();
+          return;
+        }
+        if (!isValidEmail(val)) {
+          showError('Please enter a valid email address.');
+        } else {
+          emailInput.classList.remove('is-invalid', 'error', 'invalid');
+          form.classList.remove('is-invalid', 'error', 'invalid');
+          emailInput.classList.add('is-valid');
+          emailInput.setAttribute('aria-invalid', 'false');
+          feedback.textContent = '';
+          feedback.className = 'newsletter-feedback';
+        }
+      });
+
+      // Also validate on form submission
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        const val = emailInput.value.trim();
+        if (val === '') {
+          showError('Please enter your email address.');
+          return;
+        }
+        if (!isValidEmail(val)) {
+          showError('Please enter a valid email address.');
+          return;
+        }
+        showSuccess('Thanks for subscribing!');
+        emailInput.value = '';
+        emailInput.classList.remove('is-valid');
+      });
+    })();
+  </script>
+
 </body>
 
