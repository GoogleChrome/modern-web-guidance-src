+/**
+ * Generate a fresh cryptographic nonce (256 bits / 32 bytes base64url)
+ * and store it in server-side session state keyed by sessionId.
+ */
+export function createSessionNonce(existingSessionId) {
+  const sessionId =
+    existingSessionId || randomBytes(32).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  sessionStore.set(sessionId, {
+    nonce,
+    expiresAt: Date.now() + NONCE_TTL_MS,
+  });
+  return { sessionId, nonce };
+}
