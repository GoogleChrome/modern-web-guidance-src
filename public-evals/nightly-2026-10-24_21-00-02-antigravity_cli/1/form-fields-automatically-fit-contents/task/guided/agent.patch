+      border-radius: 4px;
+      min-height: 48px;
+      align-self: start;
+    }
+
+    @media (pointer: coarse) {
+      .form-group input,
+      .form-group select {
+        min-height: 52px;
+      }
+    }
+
+    .form-group input:focus-visible,
+    .form-group textarea:focus-visible,
+    .form-group select:focus-visible {
+      outline: 3px solid var(--primary);
+      outline-offset: 2px;
+    }
+
+    .form-group input {
+      field-sizing: content;
+      width: auto;
+      min-inline-size: 15ch;
+      max-inline-size: min(50ch, 100%);
+    }
+
+    .form-group textarea {
+      field-sizing: content;
+      height: auto;
+      width: min(50ch, 100%);
+      min-block-size: 3lh;
+      max-block-size: 10lh;
+    }
+
+    .form-group select {
+      field-sizing: content;
+      width: auto;
+      max-inline-size: min(50ch, 100%);
+    }
+
+    /* Fallback for browsers that do not support field-sizing: content */
+    @supports not (field-sizing: content) {
+      .growable-textarea {
+        display: grid;
+        width: min(50ch, 100%);
+      }
+
+      .growable-textarea::after,
+      .growable-textarea > textarea {
+        grid-area: 1 / 1 / 2 / 2;
+        font: inherit;
+        line-height: 1.5;
+        padding: 0.75rem;
+        border: 1px solid #8d6e63;
+        border-radius: 4px;
+        width: 100%;
+        min-block-size: 3lh;
+        max-block-size: 10lh;
+      }
+
+      .growable-textarea::after {
+        content: attr(data-replicated-value) " ";
+        white-space: pre-wrap;
+        visibility: hidden;
+      }
+
+      .growable-textarea > textarea {
+        resize: none;
+        overflow: hidden;
+      }
+    }
+
+    button.btn {
+      border: none;
+      font-family: inherit;
+      font-size: 1rem;
+      cursor: pointer;
+    }
+
