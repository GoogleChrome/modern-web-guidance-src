+  <script>
+    (function () {
+      const liveRegion = document.getElementById('switch-status-live');
+
+      function updateSwitchUI(switchEl, isChecked) {
+        switchEl.setAttribute('aria-checked', String(isChecked));
+        const stateText = switchEl.querySelector('[data-state-text]');
+        if (stateText) {
+          stateText.textContent = isChecked ? 'On' : 'Off';
+        }
+      }
+
+      function toggleSwitch(switchEl) {
+        if (switchEl.disabled || switchEl.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+        const current = switchEl.getAttribute('aria-checked') === 'true';
+        const next = !current;
+        updateSwitchUI(switchEl, next);
+
+        switchEl.dispatchEvent(
+          new CustomEvent('switch:change', {
+            bubbles: true,
+            detail: { checked: next, id: switchEl.id }
+          })
+        );
+      }
+
+      document.querySelectorAll('[role="switch"]').forEach((switchEl) => {
+        switchEl.addEventListener('click', () => {
+          toggleSwitch(switchEl);
+        });
+      });
+
+      // Dark mode switch handler
+      const darkModeSwitch = document.getElementById('dark-mode-switch');
+      if (darkModeSwitch) {
+        darkModeSwitch.addEventListener('switch:change', (e) => {
+          const isDark = e.detail.checked;
+          document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
+          if (liveRegion) {
+            liveRegion.textContent = `Dark mode ${isDark ? 'enabled' : 'disabled'}.`;
+          }
+        });
+      }
+
+      // Dairy-Free menu filter switch handler
+      const dairyFreeSwitch = document.getElementById('dairy-free-switch');
+      const cards = document.querySelectorAll('#menu-grid .card');
+      if (dairyFreeSwitch) {
+        dairyFreeSwitch.addEventListener('switch:change', (e) => {
+          const onlyDairyFree = e.detail.checked;
+          let visibleCount = 0;
+          cards.forEach((card) => {
+            const isDairyFree = card.getAttribute('data-dairy-free') === 'true';
+            const shouldHide = onlyDairyFree && !isDairyFree;
+            card.hidden = shouldHide;
+            if (!shouldHide) visibleCount++;
+          });
+          if (liveRegion) {
+            liveRegion.textContent = onlyDairyFree
+              ? `Showing ${visibleCount} dairy-free items.`
+              : `Showing all ${visibleCount} seasonal items.`;
+          }
+        });
+      }
+    })();
+  </script>
