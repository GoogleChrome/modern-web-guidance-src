+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const statusEl = document.getElementById('switch-status');
+    const switches = document.querySelectorAll('input[type="checkbox"][switch]');
+
+    switches.forEach((input) => {
+      input.addEventListener('change', (event) => {
+        const isChecked = event.currentTarget.checked;
+        const label = event.currentTarget.id === 'notifications'
+          ? 'Order-ready notifications'
+          : 'Reusable cup default';
+        if (statusEl) {
+          statusEl.textContent = `${label}: ${isChecked ? 'Enabled' : 'Disabled'}`;
+        }
+      });
+    });
+  </script>
+
