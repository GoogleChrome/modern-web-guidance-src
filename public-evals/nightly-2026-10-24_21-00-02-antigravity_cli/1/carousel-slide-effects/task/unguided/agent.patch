+    /* Horizontal Carousel */
+    .carousel-section {
+      margin-top: 50px;
+    }
+
+    .carousel-section h2 {
+      text-align: center;
+      margin-bottom: 10px;
+    }
+
+    @keyframes scale-card {
+      0%, 100% {
+        scale: 0.85;
+      }
+      50% {
+        scale: 1.1;
+      }
+    }
+
+    .scroller {
+      display: flex;
+      gap: 24px;
+      overflow-x: auto;
+      scroll-snap-type: x mandatory;
+      padding: 40px calc(50% - 140px);
+      list-style: none;
+      align-items: stretch;
+      scrollbar-width: thin;
+      scrollbar-color: var(--primary) var(--secondary);
+    }
+
+    .scroller:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+      border-radius: 8px;
+    }
+
+    .scroller .card {
+      flex: 0 0 280px;
+      scroll-snap-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      transition: box-shadow 0.3s ease;
+    }
+
+    .scroller .card img {
+      width: 100%;
+      height: 180px;
+      object-fit: cover;
+      border-radius: 6px;
+      margin-bottom: 12px;
+    }
+
+    .scroller .card .price {
+      font-weight: bold;
+      color: var(--primary);
+      font-size: 1.1rem;
+      margin-top: 8px;
+    }
+
+    @media (prefers-reduced-motion: no-preference) {
+      .scroller {
+        scroll-behavior: smooth;
+      }
+
+      .scroller .card {
+        animation: scale-card linear both;
+        animation-timeline: view(inline);
+        animation-range: cover 0% cover 100%;
+      }
+    }
+
     footer {
       background: var(--secondary);
       text-align: center;
       padding: 40px 20px;
