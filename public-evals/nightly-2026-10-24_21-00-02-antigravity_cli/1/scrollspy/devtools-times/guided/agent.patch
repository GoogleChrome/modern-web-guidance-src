diff --git a/src/components/ScrollspyNav.astro b/src/components/ScrollspyNav.astro
new file mode 100644
index 0000000..602460b
--- /dev/null
+++ b/src/components/ScrollspyNav.astro
@@ -0,0 +1,70 @@
+---
+export interface SectionItem {
+  id: string;
+  label: string;
+}
+
+export interface Props {
+  sections: SectionItem[];
+  title?: string;
+  variant?: 'horizontal' | 'sidebar';
+  ariaLabel?: string;
+}
+
+const {
+  sections,
+  title = 'On this page',
+  variant = 'horizontal',
+  ariaLabel = 'Page sections',
+} = Astro.props;
+---
+
+{sections.length > 0 && (
+  variant === 'horizontal' ? (
+    <div class="sticky top-0 z-30 bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-xs">
+      <div class="max-w-6xl mx-auto px-4 sm:px-6">
+        <nav
+          data-scrollspy
+          aria-label={ariaLabel}
+          class="flex items-center space-x-2 py-2.5 overflow-x-auto text-sm font-medium text-gray-600"
+        >
+          <span class="text-xs font-bold uppercase tracking-wider text-gray-400 mr-2 shrink-0">
+            Sections:
+          </span>
+          {sections.map((section) => (
+            <a
+              href={`#${section.id}`}
+              class="px-3 py-1.5 rounded-md border-b-2 border-transparent hover:text-gray-900 hover:bg-gray-50 transition-colors whitespace-nowrap"
+            >
+              {section.label}
+            </a>
+          ))}
+        </nav>
+      </div>
+    </div>
+  ) : (
+    <aside class="mb-6 lg:mb-0">
+      <div class="sticky top-6 bg-gray-50/80 rounded-lg p-4 border border-gray-200">
+        {title && (
+          <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">
+            {title}
+          </h2>
+        )}
+        <nav
+          data-scrollspy
+          aria-label={ariaLabel}
+          class="flex flex-col space-y-1 text-sm text-gray-600"
+        >
+          {sections.map((section) => (
+            <a
+              href={`#${section.id}`}
+              class="px-3 py-1.5 rounded-r-md border-l-2 border-transparent hover:text-gray-900 hover:bg-gray-100 transition-colors"
+            >
+              {section.label}
+            </a>
+          ))}
+        </nav>
+      </div>
+    </aside>
+  )
+)}
