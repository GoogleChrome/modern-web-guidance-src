diff --git a/src/components/SectionNav.tsx b/src/components/SectionNav.tsx
new file mode 100644
index 0000000..e6291f7
--- /dev/null
+++ b/src/components/SectionNav.tsx
@@ -0,0 +1,176 @@
+import React, { useEffect, useState } from 'react';
+
+export interface SectionItem {
+    id: string;
+    label: string;
+}
+
+interface SectionNavProps {
+    sections?: SectionItem[];
+    autoDetectSelector?: string;
+}
+
+const SectionNav: React.FC<SectionNavProps> = ({ sections: initialSections, autoDetectSelector }) => {
+    const [sections, setSections] = useState<SectionItem[]>(initialSections || []);
+    const [activeSection, setActiveSection] = useState<string>('');
+
+    useEffect(() => {
+        const initObserver = () => {
+            let currentSections = initialSections || [];
+
+            if (!currentSections.length && autoDetectSelector) {
+                const elements = Array.from(document.querySelectorAll(autoDetectSelector));
+                const detected: SectionItem[] = [];
+                elements.forEach((el, index) => {
+                    const attrLabel = el.getAttribute('data-nav-section');
+                    const text = (attrLabel || el.textContent)?.trim();
+                    if (!text) return;
+                    let id = el.id || el.closest('[id]')?.id || '';
+                    if (!id) {
+                        id = text
+                            .toLowerCase()
+                            .replace(/[^a-z0-9]+/g, '-')
+                            .replace(/(^-|-$)/g, '') || `section-${index}`;
+                        el.id = id;
+                    }
+                    if (!detected.some(s => s.id === id)) {
+                        detected.push({ id, label: text });
+                    }
+                });
+                currentSections = detected;
+                setSections(detected);
+            } else if (initialSections) {
+                setSections(initialSections);
+            }
+
+            if (currentSections.length === 0) return () => {};
+
+            const sectionElements = currentSections
+                .map(s => document.getElementById(s.id))
+                .filter((el): el is HTMLElement => el !== null);
+
+            if (sectionElements.length === 0) return () => {};
+
+            const visibleSections = new Map<string, IntersectionObserverEntry>();
+
+            const updateActiveFromScroll = () => {
+                // Check if user scrolled to the very bottom of the page
+                if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 20) {
+                    setActiveSection(currentSections[currentSections.length - 1].id);
+                    return;
+                }
+
+                // Find the section closest to the top of the viewport (below sticky header)
+                const offset = 120;
+                let currentId = currentSections[0].id;
+                for (const el of sectionElements) {
+                    const rect = el.getBoundingClientRect();
+                    if (rect.top <= offset) {
+                        currentId = el.id;
+                    } else {
+                        break;
+                    }
+                }
+                setActiveSection(currentId);
+            };
+
+            const observer = new IntersectionObserver(
+                (entries) => {
+                    entries.forEach((entry) => {
+                        if (entry.isIntersecting) {
+                            visibleSections.set(entry.target.id, entry);
+                        } else {
+                            visibleSections.delete(entry.target.id);
+                        }
+                    });
+
+                    if (visibleSections.size > 0) {
+                        // Pick the highest visible section in document order or highest intersection ratio
+                        const sortedVisible = Array.from(visibleSections.values()).sort(
+                            (a, b) => a.target.getBoundingClientRect().top - b.target.getBoundingClientRect().top
+                        );
+                        setActiveSection(sortedVisible[0].target.id);
+                    } else {
+                        updateActiveFromScroll();
+                    }
+                },
+                {
+                    rootMargin: '-80px 0px -55% 0px',
+                    threshold: [0, 0.1, 0.25, 0.5, 0.75, 1],
+                }
+            );
+
+            sectionElements.forEach((el) => observer.observe(el));
+            window.addEventListener('scroll', updateActiveFromScroll, { passive: true });
+            updateActiveFromScroll();
+
+            return () => {
+                observer.disconnect();
+                window.removeEventListener('scroll', updateActiveFromScroll);
+            };
+        };
+
+        let cleanup = initObserver();
+
+        const handlePageLoad = () => {
+            if (cleanup) cleanup();
+            cleanup = initObserver();
+        };
+
+        document.addEventListener('astro:page-load', handlePageLoad);
+
+        return () => {
+            if (cleanup) cleanup();
+            document.removeEventListener('astro:page-load', handlePageLoad);
+        };
+    }, [initialSections, autoDetectSelector]);
+
+    if (sections.length === 0) {
+        return null;
+    }
+
+    const handleClick = (e: React.MouseEvent<HTMLAnchorElement>, id: string) => {
+        e.preventDefault();
+        const el = document.getElementById(id);
+        if (el) {
+            setActiveSection(id);
+            const yOffset = -60;
+            const y = el.getBoundingClientRect().top + window.scrollY + yOffset;
+            window.scrollTo({ top: y, behavior: 'smooth' });
+            window.history.replaceState(null, '', `#${id}`);
+        }
+    };
+
+    return (
+        <nav
+            aria-label="Page sections"
+            className="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-gray-200 shadow-xs transition-all"
+        >
+            <div className="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-center space-x-2 sm:space-x-6 h-11 overflow-x-auto">
+                <span className="text-xs font-bold uppercase tracking-wider text-gray-400 hidden sm:inline-block mr-1">
+                    On this page:
+                </span>
+                {sections.map((section) => {
+                    const isActive = activeSection === section.id;
+                    return (
+                        <a
+                            key={section.id}
+                            href={`#${section.id}`}
+                            onClick={(e) => handleClick(e, section.id)}
+                            aria-current={isActive ? 'location' : undefined}
+                            className={`relative h-full flex items-center px-3 text-xs sm:text-sm font-semibold whitespace-nowrap transition-colors duration-200 border-b-2 ${
+                                isActive
+                                    ? 'text-amber-600 border-amber-500 bg-amber-50/50'
+                                    : 'text-gray-600 border-transparent hover:text-gray-900 hover:border-gray-300'
+                            }`}
+                        >
+                            {section.label}
+                        </a>
+                    );
+                })}
+            </div>
+        </nav>
+    );
+};
+
+export default SectionNav;
