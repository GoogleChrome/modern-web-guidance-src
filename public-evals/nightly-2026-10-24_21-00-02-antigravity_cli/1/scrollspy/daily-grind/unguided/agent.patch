+  <script>
+    (function () {
+      const nav = document.querySelector('nav');
+      const navLinks = Array.from(document.querySelectorAll('nav ul a:not(.logout-link)'));
+      const sections = navLinks
+        .map((link) => {
+          const href = link.getAttribute('href') || '';
+          const id = link.dataset.section || (href.startsWith('#') ? href.slice(1) : href.replace(/^\//, ''));
+          return id ? document.getElementById(id) : null;
+        })
+        .filter(Boolean);
+
+      function setActiveSection(activeId) {
+        navLinks.forEach((link) => {
+          const href = link.getAttribute('href') || '';
+          const id = link.dataset.section || (href.startsWith('#') ? href.slice(1) : href.replace(/^\//, ''));
+          const isActive = Boolean(activeId && id === activeId);
+          link.classList.toggle('active', isActive);
+          if (isActive) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      function updateActiveSectionOnScroll() {
+        if (!sections.length) return;
+
+        const navHeight = nav ? nav.offsetHeight : 0;
+        const viewportHeight = window.innerHeight;
+        const scrollBottom = window.scrollY + viewportHeight;
+        const docHeight = document.documentElement.scrollHeight;
+
+        // If scrolled to the very bottom of the page, highlight the last section if visible
+        if (docHeight - scrollBottom <= 10) {
+          const lastSection = sections[sections.length - 1];
+          const rect = lastSection.getBoundingClientRect();
+          if (rect.top < viewportHeight && rect.bottom > navHeight) {
+            setActiveSection(lastSection.id);
+            return;
+          }
+        }
+
+        // Determine the section occupying the largest visible portion or crossing the trigger line
+        const triggerLine = navHeight + Math.min(160, (viewportHeight - navHeight) * 0.35);
+        let currentSectionId = null;
+
+        for (const section of sections) {
+          const rect = section.getBoundingClientRect();
+          if (rect.top <= triggerLine && rect.bottom > navHeight + 20) {
+            currentSectionId = section.id;
+          }
+        }
+
+        // Fallback: if no section crossed the trigger line yet, pick the section with the most visible height
+        if (!currentSectionId) {
+          let maxVisibleHeight = 0;
+          for (const section of sections) {
+            const rect = section.getBoundingClientRect();
+            const visibleTop = Math.max(rect.top, navHeight);
+            const visibleBottom = Math.min(rect.bottom, viewportHeight);
+            const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+            if (visibleHeight > maxVisibleHeight && visibleHeight > 60) {
+              maxVisibleHeight = visibleHeight;
+              currentSectionId = section.id;
+            }
+          }
+        }
+
+        setActiveSection(currentSectionId);
+      }
+
+      if ('IntersectionObserver' in window && sections.length > 0) {
+        const observer = new IntersectionObserver(
+          () => {
+            updateActiveSectionOnScroll();
+          },
+          {
+            root: null,
+            rootMargin: '-10% 0px -25% 0px',
+            threshold: [0, 0.1, 0.25, 0.5, 0.75, 1]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      navLinks.forEach((link) => {
+        link.addEventListener('click', () => {
+          const href = link.getAttribute('href') || '';
+          const id = link.dataset.section || (href.startsWith('#') ? href.slice(1) : href.replace(/^\//, ''));
+          if (id) {
+            setActiveSection(id);
+          }
+        });
+      });
+
+      window.addEventListener('scroll', updateActiveSectionOnScroll, { passive: true });
+      window.addEventListener('resize', updateActiveSectionOnScroll);
+      window.addEventListener('hashchange', updateActiveSectionOnScroll);
+      window.addEventListener('DOMContentLoaded', updateActiveSectionOnScroll);
+      updateActiveSectionOnScroll();
+    })();
+  </script>
 </body>
 
