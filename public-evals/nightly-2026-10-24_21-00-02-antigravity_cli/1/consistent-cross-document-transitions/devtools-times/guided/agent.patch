+
+    <script is:inline blocking="render">
+      document.documentElement.dataset.theme =
+        localStorage.getItem("theme") || "light";
+
+      window.addEventListener("pagereveal", async (event) => {
+        if (!event.viewTransition) return;
+
+        const from = window.navigation?.activation?.from;
+        if (!from) return;
+
+        const fromUrl = new URL(from.url);
+        const currentUrl = new URL(window.location.href);
+
+        let targetElement = null;
+
+        if (currentUrl.pathname.includes("/articles/")) {
+          targetElement = document.querySelector("#main-content h1");
+        } else if (fromUrl.pathname.includes("/articles/")) {
+          const slug = fromUrl.pathname
+            .split("/articles/")[1]
+            ?.replace(/\/$/, "");
+          if (slug) {
+            targetElement = document.querySelector(
+              `a[href$="/articles/${slug}"] h1, a[href$="/articles/${slug}"] h2, a[href$="/articles/${slug}"] h3`
+            );
+          }
+        }
+
+        if (!targetElement) return;
+
+        targetElement.style.viewTransitionName = "article-title";
+
+        try {
+          await event.viewTransition.ready;
+        } catch (error) {
+          if (error.name !== "InvalidStateError") {
+            throw error;
+          }
+        } finally {
+          await event.viewTransition.finished;
+          targetElement.style.viewTransitionName = "";
+        }
+      });
+    </script>
+
+    <slot name="head" />
