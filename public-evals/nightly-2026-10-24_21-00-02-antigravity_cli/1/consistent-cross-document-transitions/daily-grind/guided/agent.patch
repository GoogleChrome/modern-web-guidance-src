diff --git a/js/transition-setup.js b/js/transition-setup.js
new file mode 100644
index 0000000..42547a8
--- /dev/null
+++ b/js/transition-setup.js
@@ -0,0 +1,156 @@
+// Critical render-blocking setup for consistent cross-document view transitions
+(function () {
+  // 1. Apply persisted theme state before first paint / snapshot capture
+  try {
+    const savedTheme = localStorage.getItem('theme') || 'light';
+    document.documentElement.dataset.theme = savedTheme;
+  } catch {
+    document.documentElement.dataset.theme = 'light';
+  }
+
+  // Normalize URL pathname so "/menu/index.html" and "/menu/" match "/menu"
+  function normalizePath(pathname) {
+    return pathname.replace(/\/index\.html$/, '').replace(/\/+$/, '') || '/';
+  }
+
+  const PRODUCT_MAP = {
+    '/menu/seasonal': {
+      cardId: 'card-seasonal',
+      titleName: 'product-title',
+      imageName: 'product-image',
+    },
+    '/menu/espresso': {
+      cardId: 'card-espresso',
+      titleName: 'product-title',
+      imageName: 'product-image',
+    },
+    '/menu/cold-brew': {
+      cardId: 'card-cold-brew',
+      titleName: 'product-title',
+      imageName: 'product-image',
+    },
+  };
+
+  // Handle outgoing page snapshot when navigating between list and product detail pages
+  window.addEventListener('pageswap', async (event) => {
+    if (!event.viewTransition) return;
+
+    const toUrl = event.activation?.entry?.url ? new URL(event.activation.entry.url) : null;
+    const fromUrl = event.activation?.from?.url
+      ? new URL(event.activation.from.url)
+      : new URL(window.location.href);
+
+    if (!toUrl) return;
+
+    const fromPath = normalizePath(fromUrl.pathname);
+    const toPath = normalizePath(toUrl.pathname);
+
+    const assignedElements = [];
+
+    // Navigating from Home or Menu list to a Product Detail page
+    if ((fromPath === '/' || fromPath === '/menu') && PRODUCT_MAP[toPath]) {
+      const config = PRODUCT_MAP[toPath];
+      const card = document.getElementById(config.cardId);
+      if (card) {
+        const title = card.querySelector('h3');
+        const img = card.querySelector('img');
+        if (title) {
+          title.style.viewTransitionName = config.titleName;
+          assignedElements.push(title);
+        }
+        if (img) {
+          img.style.viewTransitionName = config.imageName;
+          assignedElements.push(img);
+        }
+      }
+    }
+
+    // Navigating from a Product Detail page back to Home or Menu list
+    if (PRODUCT_MAP[fromPath] && (toPath === '/' || toPath === '/menu')) {
+      const config = PRODUCT_MAP[fromPath];
+      const heading = document.getElementById('product-heading');
+      const img = document.getElementById('product-image');
+      if (heading) {
+        heading.style.viewTransitionName = config.titleName;
+        assignedElements.push(heading);
+      }
+      if (img) {
+        img.style.viewTransitionName = config.imageName;
+        assignedElements.push(img);
+      }
+    }
+
+    if (assignedElements.length > 0) {
+      try {
+        await event.viewTransition.finished;
+      } catch {
+        // Ignore skipped transition errors
+      } finally {
+        for (const el of assignedElements) {
+          el.style.viewTransitionName = '';
+        }
+      }
+    }
+  });
+
+  // Handle incoming page snapshot on the destination page before transition runs
+  window.addEventListener('pagereveal', async (event) => {
+    if (!event.viewTransition) return;
+
+    const fromEntry = window.navigation?.activation?.from;
+    if (!fromEntry?.url) return;
+
+    const fromPath = normalizePath(new URL(fromEntry.url).pathname);
+    const currentPath = normalizePath(window.location.pathname);
+
+    const assignedElements = [];
+
+    // Arriving on a Product Detail page from Home or Menu
+    if (PRODUCT_MAP[currentPath] && (fromPath === '/' || fromPath === '/menu')) {
+      const config = PRODUCT_MAP[currentPath];
+      const heading = document.getElementById('product-heading');
+      const img = document.getElementById('product-image');
+      if (heading) {
+        heading.style.viewTransitionName = config.titleName;
+        assignedElements.push(heading);
+      }
+      if (img) {
+        img.style.viewTransitionName = config.imageName;
+        assignedElements.push(img);
+      }
+    }
+
+    // Arriving on Home or Menu from a Product Detail page
+    if ((currentPath === '/' || currentPath === '/menu') && PRODUCT_MAP[fromPath]) {
+      const config = PRODUCT_MAP[fromPath];
+      const card = document.getElementById(config.cardId);
+      if (card) {
+        const title = card.querySelector('h3');
+        const img = card.querySelector('img');
+        if (title) {
+          title.style.viewTransitionName = config.titleName;
+          assignedElements.push(title);
+        }
+        if (img) {
+          img.style.viewTransitionName = config.imageName;
+          assignedElements.push(img);
+        }
+      }
+    }
+
+    if (assignedElements.length > 0) {
+      try {
+        await event.viewTransition.ready;
+      } catch (error) {
+        if (error.name !== 'InvalidStateError') {
+          throw error;
+        }
+      } finally {
+        await event.viewTransition.finished;
+        for (const el of assignedElements) {
+          el.style.viewTransitionName = '';
+        }
+      }
+    }
+  });
+})();
