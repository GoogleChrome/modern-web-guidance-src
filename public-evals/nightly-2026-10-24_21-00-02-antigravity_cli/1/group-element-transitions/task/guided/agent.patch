+        'colombia-supremo': {
+          name: 'Colombian Supremo',
+          roast: 'Medium Roast',
+          notes: 'Velvety body with rich toasted caramel, cocoa, and red apple sweetness.',
+          price: '$16.00 / 12oz',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+        },
+        'sumatra-mandheling': {
+          name: 'Sumatra Mandheling',
+          roast: 'Dark Roast',
+          notes: 'Full-bodied and earthy with dark chocolate, cedar, and warm spice finish.',
+          price: '$17.00 / 12oz',
+          image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80'
+        },
+        'guatemala-antigua': {
+          name: 'Guatemalan Antigua',
+          roast: 'Medium-Dark',
+          notes: 'Balanced volcanic soil complexity with milk chocolate and toasted hazelnut.',
+          price: '$18.00 / 12oz',
+          image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80'
+        },
+        'kenya-aa': {
+          name: 'Kenyan AA Nyeri',
+          roast: 'Light-Medium',
+          notes: 'Vibrant blackcurrant acidity with juicy grapefruit and cane sugar finish.',
+          price: '$19.00 / 12oz',
+          image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+        },
+        'costa-rica-tarrazu': {
+          name: 'Costa Rican Tarrazú',
+          roast: 'Medium Roast',
+          notes: 'Crisp honey sweetness with notes of orange blossom and roasted almond.',
+          price: '$17.00 / 12oz',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+        }
+      };
+
+      const INITIAL_KEYS = [
+        'ethiopia-yirgacheffe',
+        'colombia-supremo',
+        'sumatra-mandheling',
+        'guatemala-antigua'
+      ];
+
+      let nextIdCounter = 5;
+      const listEl = document.getElementById('bean-selection-list');
+      const selectEl = document.getElementById('bean-catalog-select');
+      const addBtn = document.getElementById('add-bean-btn');
+      const resetBtn = document.getElementById('reset-beans-btn');
+      const statusEl = document.getElementById('bean-count-status');
+      const emptyStateEl = document.getElementById('bean-empty-state');
+
+      function createBeanItemElement(itemId, beanData) {
+        const li = document.createElement('li');
+        li.className = 'bean-card bean-item';
+        li.dataset.itemId = itemId;
+        // Mandatory: Each element in the group must have a unique view-transition-name
+        li.style.viewTransitionName = itemId;
+
+        const img = document.createElement('img');
+        img.src = beanData.image;
+        img.alt = `${beanData.name} coffee beans`;
+
+        const body = document.createElement('div');
+        body.className = 'bean-card-body';
+
+        const badge = document.createElement('span');
+        badge.className = 'bean-badge';
+        badge.textContent = beanData.roast;
+
+        const title = document.createElement('h3');
+        title.textContent = beanData.name;
+
+        const notes = document.createElement('p');
+        notes.className = 'bean-notes';
+        notes.textContent = beanData.notes;
+
+        const footer = document.createElement('div');
+        footer.className = 'bean-card-footer';
+
+        const price = document.createElement('span');
+        price.className = 'bean-price';
+        price.textContent = beanData.price;
+
+        const removeBtn = document.createElement('button');
+        removeBtn.type = 'button';
+        removeBtn.className = 'btn-remove';
+        removeBtn.dataset.removeId = itemId;
+        removeBtn.setAttribute('aria-label', `Remove ${beanData.name} from selection`);
+        removeBtn.textContent = 'Remove';
+
+        footer.append(price, removeBtn);
+        body.append(badge, title, notes, footer);
+        li.append(img, body);
+
+        return li;
+      }
+
+      function updateStatusCount() {
+        const count = listEl.children.length;
+        statusEl.textContent = `${count} ${count === 1 ? 'bean' : 'beans'} selected`;
+        emptyStateEl.hidden = count > 0;
+      }
+
+      function runWithViewTransition(updateDOM, onFinished) {
+        if (document.startViewTransition) {
+          const transition = document.startViewTransition(() => {
+            updateDOM();
+          });
+          if (onFinished) {
+            transition.finished.finally(onFinished);
+          }
+        } else {
+          // Fallback: Perform the DOM update immediately without animation
+          updateDOM();
+          if (onFinished) {
+            onFinished();
+          }
+        }
+      }
+
+      addBtn.addEventListener('click', () => {
+        const selectedKey = selectEl.value;
+        const beanData = BEAN_CATALOG[selectedKey];
+        if (!beanData) return;
+
+        const itemId = `bean-${nextIdCounter++}`;
+        const newItemEl = createBeanItemElement(itemId, beanData);
+
+        runWithViewTransition(() => {
+          listEl.appendChild(newItemEl);
+          updateStatusCount();
+        });
+      });
+
+      listEl.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('.btn-remove');
+        if (!removeBtn) return;
+
+        const itemEl = removeBtn.closest('.bean-card');
+        if (!itemEl) return;
+
+        // Determine the next focus target before removing the element so focus is not abandoned
+        const allItems = Array.from(listEl.querySelectorAll('.bean-card'));
+        const removedIndex = allItems.indexOf(itemEl);
+
+        runWithViewTransition(
+          () => {
+            itemEl.remove();
+            updateStatusCount();
+          },
+          () => {
+            const remainingRemoveBtns = listEl.querySelectorAll('.btn-remove');
+            if (remainingRemoveBtns.length > 0) {
+              const targetIdx = Math.min(removedIndex, remainingRemoveBtns.length - 1);
+              remainingRemoveBtns[targetIdx].focus();
+            } else {
+              addBtn.focus();
+            }
+          }
+        );
+      });
+
+      resetBtn.addEventListener('click', () => {
+        runWithViewTransition(() => {
+          listEl.replaceChildren();
+          INITIAL_KEYS.forEach((key, index) => {
+            const itemId = `bean-${index + 1}`;
+            listEl.appendChild(createBeanItemElement(itemId, BEAN_CATALOG[key]));
+          });
+          updateStatusCount();
+        });
+      });
+    })();
+  </script>
