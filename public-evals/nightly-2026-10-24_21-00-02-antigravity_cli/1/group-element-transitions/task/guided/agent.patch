+    /* View Transition Configuration for Group Element Transitions */
+    :root {
+      /* Disable the root transition because we are only transitioning specific elements */
+      view-transition-name: none;
+    }
+
+    ::view-transition {
+      /* Non-transitioned elements below the view transitions remain interactive */
+      pointer-events: none;
+    }
+
+    .bean-item {
+      view-transition-class: bean-item;
+    }
+
+    /* Shared transition logic for all elements in the 'bean-item' view-transition-class */
+    ::view-transition-group(.bean-item) {
+      animation-duration: 0.45s;
+      animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
+    }
+
+    /* Entry animation for newly added bean items (:only-child in image-pair) */
+    ::view-transition-new(.bean-item):only-child {
+      animation-name: bean-slide-in;
+      animation-duration: 0.45s;
+      animation-timing-function: ease-out;
+    }
+
+    /* Exit animation for removed bean items (:only-child in image-pair) */
+    ::view-transition-old(.bean-item):only-child {
+      animation-name: bean-slide-out;
+      animation-duration: 0.35s;
+      animation-timing-function: ease-in;
+    }
+
+    @keyframes bean-slide-in {
+      from {
+        opacity: 0;
+        translate: 0 24px;
+        scale: 0.95;
+      }
+    }
+
+    @keyframes bean-slide-out {
+      to {
+        opacity: 0;
+        translate: 0 -24px;
+        scale: 0.95;
+      }
+    }
+
+    /* Handle accessibility by respecting reduced motion preferences */
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
