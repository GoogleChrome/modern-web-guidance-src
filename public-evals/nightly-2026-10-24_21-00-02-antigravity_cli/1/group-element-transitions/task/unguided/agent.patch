+        {
+          slug: 'guatemala-antigua',
+          name: 'Guatemala Antigua',
+          origin: 'Antigua Valley, Guatemala',
+          roast: 'Medium-Dark',
+          price: '$18.00',
+          notes: 'Rich cocoa nibs, brown sugar sweetness, and a subtle smoky finish.',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          slug: 'kenya-aa',
+          name: 'Kenya AA Nyeri',
+          origin: 'Nyeri Region, Kenya',
+          roast: 'Light-Medium',
+          price: '$21.00',
+          notes: 'Juicy blackcurrant, ruby grapefruit, and a crisp wine-like complexity.',
+          image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          slug: 'brazil-cerrado',
+          name: 'Brazil Cerrado',
+          origin: 'Minas Gerais, Brazil',
+          roast: 'Medium Roast',
+          price: '$16.50',
+          notes: 'Creamy milk chocolate, toasted almond, and low-acid honeyed warmth.',
+          image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          slug: 'costa-rica-tarrazu',
+          name: 'Costa Rica Tarrazú',
+          origin: 'San José, Costa Rica',
+          roast: 'Medium Roast',
+          price: '$19.00',
+          notes: 'Crisp honeycrisp apple, vanilla bean, and clean citrus blossom.',
+          image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          slug: 'jamaica-blue-mountain',
+          name: 'Jamaica Blue Mountain',
+          origin: 'Blue Mountains, Jamaica',
+          roast: 'Medium Roast',
+          price: '$28.00',
+          notes: 'Silky sweet cream, delicate floral aroma, and zero bitterness.',
+          image: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=600&q=80'
+        }
+      ];
+
+      let nextId = 1;
+      let selectedBeans = [
+        { ...BEAN_CATALOG[0], instanceId: 'bean-item-' + (nextId++) },
+        { ...BEAN_CATALOG[1], instanceId: 'bean-item-' + (nextId++) },
+        { ...BEAN_CATALOG[2], instanceId: 'bean-item-' + (nextId++) },
+        { ...BEAN_CATALOG[3], instanceId: 'bean-item-' + (nextId++) }
+      ];
+
+      const gridEl = document.getElementById('bean-grid');
+      const selectEl = document.getElementById('bean-catalog-select');
+      const addSelectedBtn = document.getElementById('add-selected-bean-btn');
+      const addRandomBtn = document.getElementById('add-random-bean-btn');
+      const shuffleBtn = document.getElementById('shuffle-beans-btn');
+
+      function runWithViewTransition(updateDomFn) {
+        if (document.startViewTransition) {
+          return document.startViewTransition(() => {
+            updateDomFn();
+          });
+        }
+        updateDomFn();
+      }
+
+      function createBeanCardElement(bean) {
+        const card = document.createElement('article');
+        card.className = 'bean-card';
+        card.dataset.instanceId = bean.instanceId;
+        card.style.viewTransitionName = bean.instanceId;
+        card.style.setProperty('view-transition-class', 'bean-card');
+
+        card.innerHTML = `
+          <img class="bean-card-image" src="${bean.image}" alt="${bean.name}" loading="lazy">
+          <div class="bean-card-body">
+            <div class="bean-card-meta">
+              <span class="bean-roast">${bean.roast}</span>
+              <span class="bean-price">${bean.price}</span>
+            </div>
+            <h3>${bean.name}</h3>
+            <p class="bean-origin">${bean.origin}</p>
+            <p class="bean-notes">${bean.notes}</p>
+            <button type="button" class="btn-remove-bean" data-remove-id="${bean.instanceId}" aria-label="Remove ${bean.name}">
+              Remove from Box
+            </button>
+          </div>
+        `;
+
+        return card;
+      }
+
+      function renderBeans() {
+        gridEl.innerHTML = '';
+
+        if (selectedBeans.length === 0) {
+          const empty = document.createElement('div');
+          empty.className = 'bean-empty-state';
+          empty.innerHTML = '<p>Your artisanal bean box is currently empty. Select a coffee bean above to start building your lineup!</p>';
+          gridEl.appendChild(empty);
+          shuffleBtn.disabled = true;
+          return;
+        }
+
+        shuffleBtn.disabled = selectedBeans.length < 2;
+
+        selectedBeans.forEach((bean) => {
+          gridEl.appendChild(createBeanCardElement(bean));
+        });
+      }
+
+      function addBeanBySlug(slug) {
+        const template = BEAN_CATALOG.find((b) => b.slug === slug) || BEAN_CATALOG[0];
+        const newBean = {
+          ...template,
+          instanceId: 'bean-item-' + (nextId++)
+        };
+
+        runWithViewTransition(() => {
+          selectedBeans.push(newBean);
+          renderBeans();
+        });
+      }
+
+      function removeBeanById(instanceId) {
+        runWithViewTransition(() => {
+          selectedBeans = selectedBeans.filter((b) => b.instanceId !== instanceId);
+          renderBeans();
+        });
+      }
+
+      function shuffleBeans() {
+        if (selectedBeans.length < 2) return;
+        runWithViewTransition(() => {
+          for (let i = selectedBeans.length - 1; i > 0; i--) {
+            const j = Math.floor(Math.random() * (i + 1));
+            const temp = selectedBeans[i];
+            selectedBeans[i] = selectedBeans[j];
+            selectedBeans[j] = temp;
+          }
+          renderBeans();
+        });
+      }
+
+      addSelectedBtn.addEventListener('click', () => {
+        addBeanBySlug(selectEl.value);
+      });
+
+      addRandomBtn.addEventListener('click', () => {
+        const randomTemplate = BEAN_CATALOG[Math.floor(Math.random() * BEAN_CATALOG.length)];
+        selectEl.value = randomTemplate.slug;
+        addBeanBySlug(randomTemplate.slug);
+      });
+
+      shuffleBtn.addEventListener('click', () => {
+        shuffleBeans();
+      });
+
+      gridEl.addEventListener('click', (event) => {
+        const removeBtn = event.target.closest('[data-remove-id]');
+        if (removeBtn) {
+          removeBeanById(removeBtn.getAttribute('data-remove-id'));
+        }
+      });
+
+      renderBeans();
+    })();
+  </script>
 </body>
 
