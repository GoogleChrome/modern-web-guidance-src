+  <script>
+    (function () {
+      const form = document.getElementById('subscription-form');
+      const roastSlider = document.getElementById('roast-level');
+      const roastOutput = document.getElementById('roast-level-output');
+      const progressBar = document.getElementById('setup-progress');
+      const progressOutput = document.getElementById('setup-progress-output');
+      const emailCheckbox = document.getElementById('email-updates');
+
+      const roastNames = {
+        0: 'Light Roast (0%)',
+        25: 'Medium-Light Roast (25%)',
+        50: 'Medium Roast (50%)',
+        75: 'Medium-Dark Roast (75%)',
+        100: 'Dark Roast (100%)'
+      };
+
+      let roastTouched = true;
+
+      function updateProgress() {
+        let completed = 0;
+        const selectedFreq = form.querySelector('input[name="delivery_frequency"]:checked');
+        if (selectedFreq) completed += 40;
+        if (roastTouched) completed += 35;
+        if (emailCheckbox && emailCheckbox.checked) completed += 25;
+
+        progressBar.value = completed;
+        progressBar.textContent = completed + '%';
+        if (progressOutput) {
+          progressOutput.textContent = completed + '%';
+        }
+      }
+
+      if (roastSlider) {
+        roastSlider.addEventListener('input', (e) => {
+          const val = Number(e.target.value);
+          if (roastOutput) {
+            roastOutput.textContent = roastNames[val] || `${val}%`;
+          }
+          if (!CSS.supports('accent-color', '#4e342e')) {
+            e.target.style.setProperty('--progress', `${val}%`);
+          }
+          updateProgress();
+        });
+      }
+
+      form.addEventListener('change', updateProgress);
+      updateProgress();
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        progressBar.value = 100;
+        if (progressOutput) {
+          progressOutput.textContent = '100%';
+        }
+      });
+    })();
+  </script>
