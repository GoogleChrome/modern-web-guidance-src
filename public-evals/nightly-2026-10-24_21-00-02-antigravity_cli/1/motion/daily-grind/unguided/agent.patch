+  <script>
+    (function () {
+      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      const animatedElements = document.querySelectorAll('[data-animate]');
+      const nav = document.getElementById('main-nav');
+      const hero = document.querySelector('.hero');
+
+      function revealAllImmediately() {
+        animatedElements.forEach((el) => el.classList.add('is-visible'));
+      }
+
+      if (prefersReducedMotion.matches || !('IntersectionObserver' in window)) {
+        revealAllImmediately();
+      } else {
+        const observer = new IntersectionObserver(
+          (entries, obs) => {
+            entries.forEach((entry) => {
+              if (entry.isIntersecting) {
+                entry.target.classList.add('is-visible');
+                obs.unobserve(entry.target);
+              }
+            });
+          },
+          {
+            threshold: 0.12,
+            rootMargin: '0px 0px -30px 0px'
+          }
+        );
+
+        animatedElements.forEach((el) => observer.observe(el));
+      }
+
+      // Listen for runtime changes to prefers-reduced-motion
+      prefersReducedMotion.addEventListener('change', (event) => {
+        if (event.matches) {
+          revealAllImmediately();
+          if (hero) {
+            hero.style.setProperty('--hero-parallax', '0px');
+          }
+        }
+      });
+
+      // Performant rAF-throttled scroll handler for navbar state & subtle hero parallax
+      let ticking = false;
+      function onScroll() {
+        const scrollY = window.scrollY || window.pageYOffset;
+
+        if (nav) {
+          nav.classList.toggle('scrolled', scrollY > 24);
+        }
+
+        if (hero && !prefersReducedMotion.matches && scrollY < 600) {
+          const offset = Math.min(scrollY * 0.2, 80);
+          hero.style.setProperty('--hero-parallax', `${offset.toFixed(1)}px`);
+        }
+
+        ticking = false;
+      }
+
+      window.addEventListener(
+        'scroll',
+        () => {
+          if (!ticking) {
+            window.requestAnimationFrame(onScroll);
+            ticking = true;
+          }
+        },
+        { passive: true }
+      );
+    })();
+  </script>
+
