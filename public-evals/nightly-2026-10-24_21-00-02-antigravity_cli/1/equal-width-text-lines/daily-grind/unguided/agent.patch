+  <script>
+    (function () {
+      const lockup = document.querySelector('.hero-lockup');
+      if (!lockup) return;
+      const lines = Array.from(lockup.querySelectorAll('.lockup-line'));
+
+      function fitLockup() {
+        const targetWidth = lockup.clientWidth;
+        if (!targetWidth) return;
+
+        lines.forEach((line) => {
+          const baseSize = 100;
+          line.style.fontSize = baseSize + 'px';
+          const initialWidth = line.getBoundingClientRect().width;
+          if (!initialWidth) return;
+
+          let fittedSize = (targetWidth / initialWidth) * baseSize;
+          line.style.fontSize = fittedSize + 'px';
+
+          const refinedWidth = line.getBoundingClientRect().width;
+          if (refinedWidth > 0 && Math.abs(refinedWidth - targetWidth) > 0.05) {
+            fittedSize = fittedSize * (targetWidth / refinedWidth);
+            line.style.fontSize = fittedSize + 'px';
+          }
+        });
+      }
+
+      fitLockup();
+      window.addEventListener('resize', fitLockup);
+      window.addEventListener('load', fitLockup);
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(fitLockup);
+      }
+      if (typeof ResizeObserver !== 'undefined') {
+        new ResizeObserver(fitLockup).observe(lockup);
+      }
+    })();
+  </script>
+
 </body>
 
