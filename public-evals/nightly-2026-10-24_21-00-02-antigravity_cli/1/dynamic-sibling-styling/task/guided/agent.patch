+  <script>
+    /* MANDATORY: Check for native support before applying fallback */
+    if (!CSS.supports('top: calc(sibling-index() * 1px)')) {
+      const updateDynamicSiblings = (container) => {
+        const children = Array.from(container.children);
+        const count = children.length;
+        children.forEach((item, index) => {
+          /* MANDATORY: Injected index must be 1-based to match native function */
+          item.style.setProperty('--sibling-index', index + 1);
+          item.style.setProperty('--sibling-count', count);
+        });
+      };
+
+      const containers = document.querySelectorAll('.grid, .fan-container, .circle-container');
+      const observer = new MutationObserver((mutations) => {
+        mutations.forEach((mutation) => {
+          if (mutation.type === 'childList') {
+            updateDynamicSiblings(mutation.target);
+          }
+        });
+      });
+
+      containers.forEach((container) => {
+        updateDynamicSiblings(container);
+        observer.observe(container, { childList: true });
+      });
+    }
+  </script>
+
