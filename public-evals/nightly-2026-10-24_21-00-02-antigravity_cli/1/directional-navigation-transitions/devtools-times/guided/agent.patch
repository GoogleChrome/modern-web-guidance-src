+    <script>
+        function navigate(updateDOM: () => void, direction: 'forward' | 'backward') {
+            // Feature detect for browsers that do not support View Transitions
+            if (!document.startViewTransition) {
+                updateDOM();
+                return;
+            }
+
+            // Start transition with the specific navigation type
+            const transition = document.startViewTransition({
+                update: updateDOM,
+                types: [direction], // Matches the CSS :active-view-transition-type() selectors
+            });
+
+            transition.ready.catch(() => {});
+        }
+
+        function initTopStoriesSlider() {
+            const slider = document.getElementById('top-stories-slider');
+            const prevButton = document.getElementById('top-stories-prev');
+            const nextButton = document.getElementById('top-stories-next');
+
+            if (!slider || !prevButton || !nextButton || slider.dataset.initialized === 'true') {
+                return;
+            }
+            slider.dataset.initialized = 'true';
+
+            const items = Array.from(slider.querySelectorAll<HTMLElement>('.top-story-item'));
+            if (items.length === 0) return;
+
+            let currentIndex = items.findIndex((item) => !item.hidden);
+            if (currentIndex === -1) currentIndex = 0;
+
+            const showStory = (nextIndex: number, direction: 'forward' | 'backward') => {
+                const updateDOM = () => {
+                    currentIndex = nextIndex;
+                    items.forEach((item, index) => {
+                        const isActive = index === currentIndex;
+                        item.hidden = !isActive;
+                        item.classList.toggle('hidden', !isActive);
+                    });
+                };
+
+                navigate(updateDOM, direction);
+            };
+
+            nextButton.addEventListener('click', () => {
+                const nextIndex = (currentIndex + 1) % items.length;
+                showStory(nextIndex, 'forward');
+            });
+
+            prevButton.addEventListener('click', () => {
+                const prevIndex = (currentIndex - 1 + items.length) % items.length;
+                showStory(prevIndex, 'backward');
+            });
+        }
+
+        initTopStoriesSlider();
+        document.addEventListener('astro:page-load', initTopStoriesSlider);
+    </script>
 </Layout>
