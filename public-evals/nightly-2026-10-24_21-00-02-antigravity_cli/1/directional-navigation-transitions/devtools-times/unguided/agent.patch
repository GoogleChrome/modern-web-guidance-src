@@ -0,0 +1,129 @@
+import React, { useState, useEffect } from 'react';
+
+export interface TopStoryItem {
+  id: string;
+  title: string;
+  date: string;
+}
+
+interface TopStoriesSliderProps {
+  stories: TopStoryItem[];
+  baseUrl?: string;
+}
+
+export default function TopStoriesSlider({ stories, baseUrl = '/' }: TopStoriesSliderProps) {
+  const [currentIndex, setCurrentIndex] = useState(0);
+  const [direction, setDirection] = useState<'next' | 'prev' | null>(null);
+  const [step, setStep] = useState(0);
+  const [prefersReducedMotion, setPrefersReducedMotion] = useState(false);
+
+  useEffect(() => {
+    if (typeof window === 'undefined' || !window.matchMedia) return;
+    const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
+    setPrefersReducedMotion(mediaQuery.matches);
+
+    const handleChange = (event: MediaQueryListEvent) => {
+      setPrefersReducedMotion(event.matches);
+    };
+
+    mediaQuery.addEventListener('change', handleChange);
+    return () => mediaQuery.removeEventListener('change', handleChange);
+  }, []);
+
+  if (!stories || stories.length === 0) {
+    return null;
+  }
+
+  const checkReducedMotion = () => {
+    if (typeof window !== 'undefined' && window.matchMedia) {
+      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    }
+    return prefersReducedMotion;
+  };
+
+  const handlePrevious = () => {
+    const reduced = checkReducedMotion();
+    setPrefersReducedMotion(reduced);
+    setDirection('prev');
+    setCurrentIndex((prevIndex) => (prevIndex - 1 + stories.length) % stories.length);
+    setStep((prevStep) => prevStep + 1);
+  };
+
+  const handleNext = () => {
+    const reduced = checkReducedMotion();
+    setPrefersReducedMotion(reduced);
+    setDirection('next');
+    setCurrentIndex((prevIndex) => (prevIndex + 1) % stories.length);
+    setStep((prevStep) => prevStep + 1);
+  };
+
+  const currentStory = stories[currentIndex];
+  const animationClass = prefersReducedMotion
+    ? ''
+    : direction === 'next'
+    ? 'slide-in-right motion-reduce:animate-none motion-reduce:transition-none'
+    : direction === 'prev'
+    ? 'slide-in-left motion-reduce:animate-none motion-reduce:transition-none'
+    : '';
+
+  const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  return (
+    <div className="flex items-center justify-between gap-4" aria-label="Top Stories">
+      <button
+        type="button"
+        onClick={handlePrevious}
+        aria-label="Previous"
+        className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 hover:text-amber-500 rounded transition-colors motion-reduce:transition-none shrink-0 cursor-pointer"
+      >
+        <svg
+          xmlns="http://www.w3.org/2000/svg"
+          fill="none"
+          viewBox="0 0 24 24"
+          strokeWidth={2}
+          stroke="currentColor"
+          className="w-4 h-4"
+          aria-hidden="true"
+        >
+          <path strokeLinecap="round" strokeLinejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
+        </svg>
+        <span>Previous</span>
+      </button>
+
+      <div className="flex-1 overflow-hidden">
+        <div
+          key={`${currentStory.id}-${step}`}
+          data-direction={direction ?? undefined}
+          className={`text-center ${animationClass}`}
+        >
+          <a href={`${normalizedBaseUrl}articles/${currentStory.id}`}>
+            <h3 className="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">
+              {currentStory.title}
+            </h3>
+          </a>
+          <span className="text-xs text-gray-500">{currentStory.date}</span>
+        </div>
+      </div>
+
+      <button
+        type="button"
+        onClick={handleNext}
+        aria-label="Next"
+        className="flex items-center gap-1 px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 hover:text-amber-500 rounded transition-colors motion-reduce:transition-none shrink-0 cursor-pointer"
+      >
+        <span>Next</span>
+        <svg
+          xmlns="http://www.w3.org/2000/svg"
+          fill="none"
+          viewBox="0 0 24 24"
+          strokeWidth={2}
+          stroke="currentColor"
+          className="w-4 h-4"
+          aria-hidden="true"
+        >
+          <path strokeLinecap="round" strokeLinejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
+        </svg>
+      </button>
+    </div>
+  );
+}
