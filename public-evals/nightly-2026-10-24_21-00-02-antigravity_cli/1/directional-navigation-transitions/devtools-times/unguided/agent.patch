+.slide-in-right {
+  animation: slide-in-from-right 300ms ease-out;
+}
+
+.slide-in-left {
+  animation: slide-in-from-left 300ms ease-out;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .slide-in-right,
+  .slide-in-left {
+    animation: none !important;
+    transition: none !important;
+  }
+}
