+    /* Carousel / Seasonal Favorites */
+    .carousel-wrapper {
+      max-width: 550px;
+      margin: 20px auto 0;
+    }
+
+    .carousel-viewport {
+      position: relative;
+      overflow: hidden;
+      padding: 8px 4px;
