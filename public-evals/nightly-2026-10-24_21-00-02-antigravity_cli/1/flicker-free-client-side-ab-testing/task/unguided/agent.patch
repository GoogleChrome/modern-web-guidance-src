+<!DOCTYPE html>
+<html lang="en" class="async-hide anti-flicker" data-experiment-loading="true">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>PulseFlow — Modern Product Analytics &amp; Experimentation</title>
+
+  <!-- Preconnect to the experiment CDN to minimize connection latency -->
+  <link rel="preconnect" href="https://cdn.example.com" crossorigin>
+  <link rel="dns-prefetch" href="https://cdn.example.com">
+
+  <!-- Anti-flicker stylesheet: prevents Flash of Original Content (FOOC) before A/B variant is applied -->
+  <style id="anti-flicker-style">
+    html.async-hide,
+    html.anti-flicker,
+    html[data-experiment-loading="true"] body {
+      opacity: 0 !important;
+      visibility: hidden !important;
+    }
+  </style>
+
+  <!-- Anti-flicker controller & early-DOM mutation bridge -->
+  <script>
+    (function () {
+      var docEl = document.documentElement;
+      docEl.classList.add('async-hide', 'anti-flicker');
+      docEl.setAttribute('data-experiment-loading', 'true');
+
+      var revealed = false;
+      var pendingSelectors = [];
+      var origQuerySelector = document.querySelector.bind(document);
+      var origGetElementById = document.getElementById.bind(document);
+
+      function flushPendingMutations() {
+        for (var i = 0; i < pendingSelectors.length; i++) {
+          var item = pendingSelectors[i];
+          var target = item.byId
+            ? origGetElementById(item.selector)
+            : origQuerySelector(item.selector);
+          if (target) {
+            if (item.proxy.__textSet) {
+              target.textContent = item.proxy.textContent;
+            } else if (item.proxy.__htmlSet) {
+              target.innerHTML = item.proxy.innerHTML;
+            }
+            for (var j = 0; j < item.proxy.attributes.length; j++) {
+              var attr = item.proxy.attributes[j];
+              target.setAttribute(attr.name, attr.value);
+            }
+          }
+        }
+        pendingSelectors.length = 0;
+      }
+
+      // Bridge synchronous DOM queries executed in <head> before <body> is parsed
+      document.querySelector = function (selector) {
+        var found = origQuerySelector(selector);
+        if (found || document.body) return found;
+        var dummy = document.createElement('div');
+        Object.defineProperty(dummy, 'textContent', {
+          get: function () { return this._text || ''; },
+          set: function (v) { this._text = v; this.__textSet = true; }
+        });
+        Object.defineProperty(dummy, 'innerText', {
+          get: function () { return this._text || ''; },
+          set: function (v) { this._text = v; this.__textSet = true; }
+        });
+        Object.defineProperty(dummy, 'innerHTML', {
+          get: function () { return this._html || ''; },
+          set: function (v) { this._html = v; this.__htmlSet = true; }
+        });
+        pendingSelectors.push({ selector: selector, proxy: dummy, byId: false });
+        return dummy;
+      };
+
+      document.getElementById = function (id) {
+        var found = origGetElementById(id);
+        if (found || document.body) return found;
+        var dummy = document.createElement('div');
+        Object.defineProperty(dummy, 'textContent', {
+          get: function () { return this._text || ''; },
+          set: function (v) { this._text = v; this.__textSet = true; }
+        });
+        Object.defineProperty(dummy, 'innerText', {
+          get: function () { return this._text || ''; },
+          set: function (v) { this._text = v; this.__textSet = true; }
+        });
+        Object.defineProperty(dummy, 'innerHTML', {
+          get: function () { return this._html || ''; },
+          set: function (v) { this._html = v; this.__htmlSet = true; }
+        });
+        pendingSelectors.push({ selector: id, proxy: dummy, byId: true });
+        return dummy;
+      };
+
+      function revealPage() {
+        if (revealed) return;
+        revealed = true;
+        flushPendingMutations();
+        document.querySelector = origQuerySelector;
+        document.getElementById = origGetElementById;
+        docEl.classList.remove('async-hide', 'anti-flicker');
+        docEl.removeAttribute('data-experiment-loading');
+      }
+
+      function scheduleReveal() {
+        if (document.readyState === 'loading') {
+          document.addEventListener('DOMContentLoaded', revealPage, { once: true });
+        } else {
+          revealPage();
+        }
+      }
+
+      // Fallback timeout ensures the page never remains hidden if the CDN hangs
+      var fallbackTimer = setTimeout(revealPage, 2000);
+
+      window.__finishExperimentSetup = function () {
+        clearTimeout(fallbackTimer);
+        scheduleReveal();
+      };
+    })();
+  </script>
+
+  <!-- Synchronous A/B testing script in <head> blocks initial paint until variant logic executes -->
+  <script src="https://cdn.example.com/experiment-sdk.js" onload="window.__finishExperimentSetup && window.__finishExperimentSetup()" onerror="window.__finishExperimentSetup && window.__finishExperimentSetup()"></script>
