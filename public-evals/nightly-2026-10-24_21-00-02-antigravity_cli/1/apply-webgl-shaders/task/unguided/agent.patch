+  <script>
+    (function () {
+      const hero = document.getElementById('hero');
+      const canvas = document.getElementById('hero-webgl-canvas');
+      const titleEl = document.getElementById('hero-title');
+      const ctaEl = document.getElementById('hero-cta');
+
+      if (!hero || !canvas || !titleEl || !ctaEl) return;
+
+      const gl = canvas.getContext('webgl', {
+        alpha: true,
+        antialias: true,
+        premultipliedAlpha: true
+      }) || canvas.getContext('experimental-webgl', {
+        alpha: true,
+        antialias: true,
+        premultipliedAlpha: true
+      });
+
+      if (!gl) return;
+
+      // Offscreen 2D canvas to rasterize HTML content ('Wake Up Your Senses' and 'Order Now')
+      // into a WebGL texture while keeping original DOM elements interactive & selectable.
+      const sourceCanvas = document.createElement('canvas');
+      const ctx = sourceCanvas.getContext('2d');
+
+      const vertexShaderSource = `
+        attribute vec2 a_position;
+        attribute vec2 a_texCoord;
+        varying vec2 v_uv;
+
+        void main() {
+          v_uv = a_texCoord;
+          gl_Position = vec4(a_position, 0.0, 1.0);
+        }
+      `;
+
+      const fragmentShaderSource = `
+        precision highp float;
+
+        varying vec2 v_uv;
+        uniform sampler2D u_texture;
+        uniform vec2 u_resolution;
+        uniform float u_time;
+        uniform vec2 u_mouse;
+        uniform float u_hover;
+        uniform vec4 u_ripples[8];
+        uniform int u_rippleCount;
+        uniform vec4 u_titleRect;
+        uniform vec4 u_ctaRect;
+
+        float boxMask(vec2 uv, vec4 rect, float feather) {
+          vec2 d = abs(uv - (rect.xy + rect.zw * 0.5)) - rect.zw * 0.5;
+          float dist = length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
+          return 1.0 - smoothstep(0.0, feather, dist);
+        }
+
+        void main() {
+          vec2 aspect = vec2(u_resolution.x / max(u_resolution.y, 1.0), 1.0);
+          vec2 uv = v_uv;
+
+          // Ambient multi-frequency fluid ripple distortion
+          float wave1 = sin(uv.x * 18.0 + u_time * 2.4) * cos(uv.y * 14.0 - u_time * 1.8);
+          float wave2 = sin((uv.x * 26.0 - uv.y * 20.0) + u_time * 3.1);
+          vec2 ambientOffset = vec2(wave1, wave2) * 0.0022;
+
+          // Interactive cursor ripple wave
+          vec2 toMouse = (uv - u_mouse) * aspect;
+          float mouseDist = length(toMouse);
+          float mouseInfluence = exp(-mouseDist * 6.5) * u_hover;
+          float mouseWave = sin(mouseDist * 48.0 - u_time * 8.5) * mouseInfluence;
+          vec2 dirToMouse = mouseDist > 0.0001 ? normalize(toMouse) : vec2(0.0);
+          vec2 mouseOffset = dirToMouse * mouseWave * 0.012;
+
+          // Propagating click/impulse ripples
+          vec2 impulseOffset = vec2(0.0);
+          for (int i = 0; i < 8; i++) {
+            vec4 ripple = u_ripples[i];
+            float startTime = ripple.z;
+            float strength = ripple.w;
+            if (strength > 0.001) {
+              float age = u_time - startTime;
+              if (age >= 0.0 && age < 2.8) {
+                vec2 delta = (uv - ripple.xy) * aspect;
+                float dist = length(delta);
+                float radius = age * 0.42;
+                float band = exp(-pow((dist - radius) * 18.0, 2.0));
+                float decay = exp(-age * 1.9);
+                float ring = sin((dist - radius) * 65.0) * band * decay * strength;
+                vec2 dir = dist > 0.0001 ? normalize(delta) : vec2(0.0);
+                impulseOffset += dir * ring * 0.018;
+              }
+            }
+          }
+
+          // Focus distortion around the target HTML elements
+          float regionMask = max(
+            boxMask(uv, u_titleRect, 0.09),
+            boxMask(uv, u_ctaRect, 0.07)
+          );
+
+          vec2 totalOffset = (ambientOffset + mouseOffset + impulseOffset) * regionMask;
+          vec2 displacedUv = clamp(uv + totalOffset, 0.0, 1.0);
+
+          // Subtle chromatic dispersion along the ripple normal
+          float chromaShift = length(totalOffset) * 0.32;
+          vec4 sampleCenter = texture2D(u_texture, displacedUv);
+          vec4 sampleR = texture2D(u_texture, clamp(displacedUv + totalOffset * 0.35, 0.0, 1.0));
+          vec4 sampleB = texture2D(u_texture, clamp(displacedUv - totalOffset * 0.35, 0.0, 1.0));
+
+          float alpha = max(sampleCenter.a, max(sampleR.a, sampleB.a) * 0.85);
+          vec3 color = vec3(
+            mix(sampleCenter.r, sampleR.r, clamp(chromaShift * 18.0, 0.0, 0.65)),
+            sampleCenter.g,
+            mix(sampleCenter.b, sampleB.b, clamp(chromaShift * 18.0, 0.0, 0.65))
+          );
+
+          // Specular highlight shimmer on ripple crests
+          float crest = clamp((mouseWave + length(impulseOffset) * 35.0) * regionMask, 0.0, 1.0);
+          color += vec3(1.0, 0.88, 0.68) * crest * 0.14 * alpha;
+
+          gl_FragColor = vec4(color, alpha);
+        }
+      `;
+
+      function compileShader(type, source) {
+        const shader = gl.createShader(type);
+        gl.shaderSource(shader, source);
+        gl.compileShader(shader);
+        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
+          gl.deleteShader(shader);
+          return null;
+        }
+        return shader;
+      }
+
+      const vertexShader = compileShader(gl.VERTEX_SHADER, vertexShaderSource);
+      const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentShaderSource);
+      if (!vertexShader || !fragmentShader) return;
+
+      const program = gl.createProgram();
+      gl.attachShader(program, vertexShader);
+      gl.attachShader(program, fragmentShader);
+      gl.linkProgram(program);
+      if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
+
+      gl.useProgram(program);
+
+      // Fullscreen quad with UV coordinates (0,0 top-left to 1,1 bottom-right to match DOM coordinates)
+      const quadVertices = new Float32Array([
+        -1.0,  1.0,  0.0, 0.0,
+         1.0,  1.0,  1.0, 0.0,
+        -1.0, -1.0,  0.0, 1.0,
+        -1.0, -1.0,  0.0, 1.0,
+         1.0,  1.0,  1.0, 0.0,
+         1.0, -1.0,  1.0, 1.0
+      ]);
+
+      const buffer = gl.createBuffer();
+      gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
+      gl.bufferData(gl.ARRAY_BUFFER, quadVertices, gl.STATIC_DRAW);
+
+      const posLoc = gl.getAttribLocation(program, 'a_position');
+      const uvLoc = gl.getAttribLocation(program, 'a_texCoord');
+      gl.enableVertexAttribArray(posLoc);
+      gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 16, 0);
+      gl.enableVertexAttribArray(uvLoc);
+      gl.vertexAttribPointer(uvLoc, 2, gl.FLOAT, false, 16, 8);
+
+      const texture = gl.createTexture();
+      gl.bindTexture(gl.TEXTURE_2D, texture);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
+      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
+
+      const uTexture = gl.getUniformLocation(program, 'u_texture');
+      const uResolution = gl.getUniformLocation(program, 'u_resolution');
+      const uTime = gl.getUniformLocation(program, 'u_time');
+      const uMouse = gl.getUniformLocation(program, 'u_mouse');
+      const uHover = gl.getUniformLocation(program, 'u_hover');
+      const uRipples = gl.getUniformLocation(program, 'u_ripples');
+      const uRippleCount = gl.getUniformLocation(program, 'u_rippleCount');
+      const uTitleRect = gl.getUniformLocation(program, 'u_titleRect');
+      const uCtaRect = gl.getUniformLocation(program, 'u_ctaRect');
+
+      let dpr = Math.min(window.devicePixelRatio || 1, 2);
+      let heroWidth = 1;
+      let heroHeight = 1;
+      let isCtaHovered = false;
+      let targetHover = 0.35;
+      let currentHover = 0.35;
+      let mouseUV = { x: 0.5, y: 0.5 };
+      let targetMouseUV = { x: 0.5, y: 0.5 };
+      let titleRectUV = [0.2, 0.2, 0.6, 0.2];
+      let ctaRectUV = [0.4, 0.6, 0.2, 0.15];
+
+      const MAX_RIPPLES = 8;
+      const ripples = [];
+      let startTimestamp = performance.now();
+
+      function getNowSeconds() {
+        return (performance.now() - startTimestamp) * 0.001;
+      }
+
+      function addRipple(uvX, uvY, strength) {
+        ripples.unshift({
+          x: uvX,
+          y: uvY,
+          time: getNowSeconds(),
+          strength: strength
+        });
+        if (ripples.length > MAX_RIPPLES) {
+          ripples.pop();
+        }
+      }
+
+      function drawRoundedRect(context, x, y, width, height, radius) {
+        const r = Math.min(radius, width / 2, height / 2);
+        context.beginPath();
+        context.moveTo(x + r, y);
+        context.arcTo(x + width, y, x + width, y + height, r);
+        context.arcTo(x + width, y + height, x, y + height, r);
+        context.arcTo(x, y + height, x, y, r);
+        context.arcTo(x, y, x + width, y, r);
+        context.closePath();
+      }
+
+      function syncHtmlToTexture() {
+        dpr = Math.min(window.devicePixelRatio || 1, 2);
+        const heroRect = hero.getBoundingClientRect();
+        heroWidth = Math.max(1, Math.round(heroRect.width));
+        heroHeight = Math.max(1, Math.round(heroRect.height));
+
+        const pixelWidth = Math.max(1, Math.round(heroWidth * dpr));
+        const pixelHeight = Math.max(1, Math.round(heroHeight * dpr));
+
+        if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
+          canvas.width = pixelWidth;
+          canvas.height = pixelHeight;
+        }
+        if (sourceCanvas.width !== pixelWidth || sourceCanvas.height !== pixelHeight) {
+          sourceCanvas.width = pixelWidth;
+          sourceCanvas.height = pixelHeight;
+        }
+
+        ctx.save();
+        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        ctx.clearRect(0, 0, heroWidth, heroHeight);
+
+        // 1. Rasterize 'Wake Up Your Senses' (h1#hero-title) matching exact DOM layout
+        const titleRect = titleEl.getBoundingClientRect();
+        const titleStyle = window.getComputedStyle(titleEl);
+        const titleX = titleRect.left - heroRect.left;
+        const titleY = titleRect.top - heroRect.top;
+
+        titleRectUV = [
+          titleX / heroWidth,
+          titleY / heroHeight,
+          titleRect.width / heroWidth,
+          titleRect.height / heroHeight
+        ];
+
+        ctx.font = `${titleStyle.fontWeight} ${titleStyle.fontSize} ${titleStyle.fontFamily}`;
+        ctx.fillStyle = '#ffffff';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.shadowColor = 'rgba(0, 0, 0, 0.35)';
+        ctx.shadowBlur = 8;
+        ctx.shadowOffsetY = 2;
+        ctx.fillText(
+          (titleEl.textContent || 'Wake Up Your Senses').trim(),
+          titleX + titleRect.width * 0.5,
+          titleY + titleRect.height * 0.5
+        );
+
+        // 2. Rasterize 'Order Now' (a#hero-cta) matching exact DOM button box & text
+        ctx.shadowColor = 'transparent';
+        ctx.shadowBlur = 0;
+        ctx.shadowOffsetY = 0;
+
+        const ctaRect = ctaEl.getBoundingClientRect();
+        const ctaStyle = window.getComputedStyle(ctaEl);
+        const ctaX = ctaRect.left - heroRect.left;
+        const ctaY = ctaRect.top - heroRect.top;
+
+        ctaRectUV = [
+          ctaX / heroWidth,
+          ctaY / heroHeight,
+          ctaRect.width / heroWidth,
+          ctaRect.height / heroHeight
+        ];
+
+        const borderRadius = parseFloat(ctaStyle.borderRadius) || 5;
+        drawRoundedRect(ctx, ctaX, ctaY, ctaRect.width, ctaRect.height, borderRadius);
+        ctx.fillStyle = isCtaHovered ? '#3e2723' : '#4e342e';
+        ctx.fill();
+
+        ctx.font = `${ctaStyle.fontWeight} ${ctaStyle.fontSize} ${ctaStyle.fontFamily}`;
+        ctx.fillStyle = '#ffffff';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.fillText(
+          (ctaEl.textContent || 'Order Now').trim(),
+          ctaX + ctaRect.width * 0.5,
+          ctaY + ctaRect.height * 0.5
+        );
+
+        ctx.restore();
+
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
+        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, sourceCanvas);
+
+        hero.classList.add('webgl-ready');
+      }
+
+      // Pointer & interaction listeners (preserving text selection and button clicks)
+      hero.addEventListener('pointermove', function (e) {
+        const rect = hero.getBoundingClientRect();
+        const x = (e.clientX - rect.left) / Math.max(rect.width, 1);
+        const y = (e.clientY - rect.top) / Math.max(rect.height, 1);
+        const dx = x - targetMouseUV.x;
+        const dy = y - targetMouseUV.y;
+        targetMouseUV.x = x;
+        targetMouseUV.y = y;
+        targetHover = 1.0;
+
+        if (Math.hypot(dx, dy) > 0.035) {
+          addRipple(x, y, 0.45);
+        }
+      });
+
+      hero.addEventListener('pointerleave', function () {
+        targetHover = 0.35;
+      });
+
+      hero.addEventListener('pointerdown', function (e) {
+        const rect = hero.getBoundingClientRect();
+        const x = (e.clientX - rect.left) / Math.max(rect.width, 1);
+        const y = (e.clientY - rect.top) / Math.max(rect.height, 1);
+        addRipple(x, y, 1.0);
+      });
+
+      titleEl.addEventListener('pointerenter', function () {
+        addRipple(
+          titleRectUV[0] + titleRectUV[2] * 0.5,
+          titleRectUV[1] + titleRectUV[3] * 0.5,
+          0.75
+        );
+      });
+
+      ctaEl.addEventListener('pointerenter', function () {
+        isCtaHovered = true;
+        syncHtmlToTexture();
+        addRipple(
+          ctaRectUV[0] + ctaRectUV[2] * 0.5,
+          ctaRectUV[1] + ctaRectUV[3] * 0.5,
+          0.85
+        );
+      });
+
+      ctaEl.addEventListener('pointerleave', function () {
+        isCtaHovered = false;
+        syncHtmlToTexture();
+      });
+
+      window.addEventListener('resize', syncHtmlToTexture);
+      if (document.fonts && document.fonts.ready) {
+        document.fonts.ready.then(syncHtmlToTexture);
+      }
+
+      syncHtmlToTexture();
+      // Seed an initial gentle ripple on load
+      addRipple(0.5, 0.45, 0.8);
+
+      const rippleUniformData = new Float32Array(MAX_RIPPLES * 4);
+
+      function render() {
+        const now = getNowSeconds();
+
+        mouseUV.x += (targetMouseUV.x - mouseUV.x) * 0.14;
+        mouseUV.y += (targetMouseUV.y - mouseUV.y) * 0.14;
+        currentHover += (targetHover - currentHover) * 0.08;
+
+        for (let i = 0; i < MAX_RIPPLES; i++) {
+          const r = ripples[i];
+          const base = i * 4;
+          if (r) {
+            rippleUniformData[base] = r.x;
+            rippleUniformData[base + 1] = r.y;
+            rippleUniformData[base + 2] = r.time;
+            rippleUniformData[base + 3] = r.strength;
+          } else {
+            rippleUniformData[base] = 0;
+            rippleUniformData[base + 1] = 0;
+            rippleUniformData[base + 2] = 0;
+            rippleUniformData[base + 3] = 0;
+          }
+        }
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0, 0, 0, 0);
+        gl.clear(gl.COLOR_BUFFER_BIT);
+
+        gl.useProgram(program);
+        gl.activeTexture(gl.TEXTURE0);
+        gl.bindTexture(gl.TEXTURE_2D, texture);
+        gl.uniform1i(uTexture, 0);
+        gl.uniform2f(uResolution, canvas.width, canvas.height);
+        gl.uniform1f(uTime, now);
+        gl.uniform2f(uMouse, mouseUV.x, mouseUV.y);
+        gl.uniform1f(uHover, currentHover);
+        gl.uniform4fv(uRipples, rippleUniformData);
+        gl.uniform1i(uRippleCount, ripples.length);
+        gl.uniform4fv(uTitleRect, titleRectUV);
+        gl.uniform4fv(uCtaRect, ctaRectUV);
+
+        gl.drawArrays(gl.TRIANGLES, 0, 6);
+
+        requestAnimationFrame(render);
+      }
+
+      requestAnimationFrame(render);
+    })();
+  </script>
+
