+  <script>
+    const thumbnails = document.querySelectorAll('.thumbnail');
+    const backButton = document.getElementById('back-button');
+    const hero = document.getElementById('hero');
+    const heroImage = document.getElementById('hero-image');
+    const detailTitle = document.getElementById('title');
+    const detailDescription = document.getElementById('detail-description');
+    const detailPrice = document.getElementById('detail-price');
+    const detailNotes = document.getElementById('detail-notes');
+    const listHeading = document.getElementById('list-heading');
+
+    function populateDetail(card) {
+      const titleText = card.dataset.title || card.querySelector('.title')?.textContent || '';
+      const descText = card.dataset.description || '';
+      const priceText = card.dataset.price || '';
+      const notesText = card.dataset.notes || '';
+      const imageSrc = card.dataset.image || '';
+      const bgColor = card.dataset.bg || getComputedStyle(card).backgroundColor;
+
+      detailTitle.textContent = titleText;
+      detailDescription.textContent = descText;
+      detailPrice.textContent = priceText;
+      detailNotes.textContent = notesText;
+      hero.style.backgroundColor = bgColor;
+      if (imageSrc && heroImage) {
+        heroImage.src = imageSrc;
+        heroImage.alt = titleText;
+      }
+      document.title = `${titleText} | The Daily Grind`;
+    }
+
+    function goFromListToDetail(e) {
+      e.preventDefault();
+      const card = e.currentTarget;
+
+      document.querySelectorAll('.thumbnail.selected').forEach((el) => {
+        el.classList.remove('selected');
+      });
+
+      card.classList.add('selected');
+      populateDetail(card);
+
+      if (!document.startViewTransition) {
+        document.body.classList.add('detail');
+        detailTitle?.focus();
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.add('detail');
+      });
+
+      transition.finished.finally(() => {
+        detailTitle?.focus();
+      });
+    }
+
+    function goFromDetailToList(e) {
+      if (e) e.preventDefault();
+
+      if (!document.startViewTransition) {
+        document.body.classList.remove('detail');
+        document.title = 'The Daily Grind | Artisanal Coffee';
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+        return;
+      }
+
+      const transition = document.startViewTransition(() => {
+        document.body.classList.remove('detail');
+        document.title = 'The Daily Grind | Artisanal Coffee';
+      });
+
+      transition.finished.finally(() => {
+        listHeading?.focus();
+        document.querySelectorAll('.selected').forEach((element) => {
+          element.classList.remove('selected');
+        });
+      });
+    }
+
+    thumbnails.forEach((thumbnail) => {
+      thumbnail.addEventListener('click', goFromListToDetail);
+    });
+
+    backButton.addEventListener('click', goFromDetailToList);
+  </script>
 </body>
 
