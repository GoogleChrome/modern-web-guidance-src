+  <script>
+    const ITEMS = {
+      'maple-oat-latte': {
+        title: 'Maple Oat Latte',
+        image: 'https://images.unsplash.com/photo-1572442388796-11668a67e53d?auto=format&fit=crop&w=1200&q=80',
+        price: '$5.75',
+        description: 'Creamy steamed oat milk blended with our signature double-shot espresso and pure Grade-A Vermont maple syrup, finished with a light dusting of cinnamon.',
+        roast: 'Medium-Dark Velvet',
+        notes: 'Toasted oats, warm maple, caramel'
+      },
+      'dark-roast-espresso': {
+        title: 'Dark Roast Espresso',
+        image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=1200&q=80',
+        price: '$4.25',
+        description: 'Bold, smokey, and full-bodied single-origin espresso roasted to perfection for a rich crema and an unmistakable morning boost.',
+        roast: 'Artisanal French Dark',
+        notes: 'Dark chocolate, roasted walnut, molasses'
+      },
+      'cold-brew': {
+        title: 'Cold Brew',
+        image: 'https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=1200&q=80',
+        price: '$5.25',
+        description: 'Coarsely ground Ethiopian and Colombian beans steeped in cold filtered water for 18 hours for maximum smoothness and naturally sweet complexity.',
+        roast: 'Medium Reserve Blend',
+        notes: 'Sweet cocoa, stone fruit, silky finish'
+      }
+    };
+
+    const listPage = document.getElementById('list-page');
+    const listHeading = document.getElementById('list-heading');
+    const detailPage = document.getElementById('detail-page');
+    const heroEl = document.getElementById('hero');
+    const heroImg = document.getElementById('hero-img');
+    const titleEl = document.getElementById('title');
+    const detailPrice = document.getElementById('detail-price');
+    const detailDescription = document.getElementById('detail-description');
+    const detailRoast = document.getElementById('detail-roast');
+    const detailNotes = document.getElementById('detail-notes');
+    const backButton = document.getElementById('back-button');
+    const navMenuLink = document.getElementById('nav-menu-link');
+    const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+    let activeThumbnail = null;
+
+    function prefersReducedMotion() {
+      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    }
+
+    function applyTransitionMarkers(containerEl, headingEl) {
+      if (containerEl) {
+        containerEl.classList.add('is-transitioning-hero');
+        containerEl.style.viewTransitionName = 'hero';
+      }
+      if (headingEl) {
+        headingEl.classList.add('is-transitioning-title');
+        headingEl.style.viewTransitionName = 'title';
+      }
+    }
+
+    function clearTransitionMarkers(containerEl, headingEl) {
+      if (containerEl) {
+        containerEl.classList.remove('is-transitioning-hero');
+        containerEl.style.removeProperty('view-transition-name');
+        if (!containerEl.getAttribute('style')) {
+          containerEl.removeAttribute('style');
+        }
+      }
+      if (headingEl) {
+        headingEl.classList.remove('is-transitioning-title');
+        headingEl.style.removeProperty('view-transition-name');
+        if (!headingEl.getAttribute('style')) {
+          headingEl.removeAttribute('style');
+        }
+      }
+    }
+
+    function cleanupAllTransitionMarkers() {
+      thumbnails.forEach((thumb) => {
+        const thumbTitle = thumb.querySelector('.title');
+        clearTransitionMarkers(thumb, thumbTitle);
+      });
+    }
+
+    function populateDetailView(itemId, itemData) {
+      heroEl.dataset.item = itemId;
+      heroImg.src = itemData.image;
+      heroImg.alt = itemData.title;
+      titleEl.textContent = itemData.title;
+      detailPrice.textContent = itemData.price;
+      detailDescription.textContent = itemData.description;
+      detailRoast.textContent = itemData.roast;
+      detailNotes.textContent = itemData.notes;
+    }
+
+    async function showDetailView(thumbnailEl) {
+      if (!thumbnailEl || !detailPage.hidden) return;
+
+      const itemId = thumbnailEl.dataset.id;
+      const itemData = ITEMS[itemId];
+      if (!itemData) return;
+
+      activeThumbnail = thumbnailEl;
+      const thumbTitle = thumbnailEl.querySelector('.title');
+
+      const updateDOM = () => {
+        clearTransitionMarkers(thumbnailEl, thumbTitle);
+        populateDetailView(itemId, itemData);
+        listPage.hidden = true;
+        detailPage.hidden = false;
+        titleEl.focus();
+      };
+
+      if (!document.startViewTransition || prefersReducedMotion()) {
+        updateDOM();
+        cleanupAllTransitionMarkers();
+        titleEl.focus();
+        return;
+      }
+
+      cleanupAllTransitionMarkers();
+      applyTransitionMarkers(thumbnailEl, thumbTitle);
+
+      const transition = document.startViewTransition(() => {
+        updateDOM();
+      });
+
+      try {
+        await transition.finished;
+      } finally {
+        cleanupAllTransitionMarkers();
+        titleEl.focus();
+      }
+    }
+
+    async function showListView() {
+      if (detailPage.hidden) return;
+
+      const targetThumbnail = activeThumbnail || thumbnails[0];
+      const thumbTitle = targetThumbnail ? targetThumbnail.querySelector('.title') : null;
+
+      const updateDOM = () => {
+        if (targetThumbnail) {
+          applyTransitionMarkers(targetThumbnail, thumbTitle);
+        }
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        listHeading.focus();
+      };
+
+      if (!document.startViewTransition || prefersReducedMotion()) {
+        detailPage.hidden = true;
+        listPage.hidden = false;
+        cleanupAllTransitionMarkers();
+        listHeading.focus();
+        return;
+      }
+
+      cleanupAllTransitionMarkers();
+
+      const transition = document.startViewTransition(() => {
+        updateDOM();
+      });
+
+      try {
+        await transition.finished;
+      } finally {
+        cleanupAllTransitionMarkers();
+        listHeading.focus();
+      }
+    }
+
+    thumbnails.forEach((thumb) => {
+      thumb.addEventListener('click', () => {
+        showDetailView(thumb);
+      });
+
+      thumb.addEventListener('keydown', (event) => {
+        if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          showDetailView(thumb);
+        }
+      });
+    });
+
+    backButton.addEventListener('click', () => {
+      showListView();
+    });
+
+    navMenuLink.addEventListener('click', (event) => {
+      event.preventDefault();
+      if (!detailPage.hidden) {
+        showListView();
+      } else {
+        listHeading.focus();
+      }
+    });
+  </script>
 </body>
 
