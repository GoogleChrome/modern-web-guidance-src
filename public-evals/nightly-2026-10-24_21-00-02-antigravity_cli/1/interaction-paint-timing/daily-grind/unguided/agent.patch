+      function renderRoute(path, pushHistory) {
+        const routeData = routes[path] || {
+          title: 'The Daily Grind — ' + path.replace(/^\//, '').replace(/-/g, ' ').toUpperCase(),
+          subtitle: 'Artisanal small-batch coffee crafted with care.',
+          heading: 'Explore ' + path.replace(/^\//, ''),
+          cards: routes['/'].cards
+        };
+
+        if (pushHistory && window.location.pathname !== path) {
+          history.pushState({ route: path }, routeData.title, path);
+        }
+
+        document.title = routeData.title + ' | The Daily Grind';
+
+        // Replace hero and main view content with new DOM elements so the browser
+        // registers a contentful paint for both Soft Navigations and ICP
+        const heroSection = document.getElementById('hero-section');
+        if (heroSection) {
+          heroSection.innerHTML =
+            '<h1>' + routeData.title + '</h1>' +
+            '<p>' + routeData.subtitle + '</p>' +
+            '<div style="display:flex; gap:12px; flex-wrap:wrap; justify-content:center;">' +
+              '<a href="/order-online" data-route="/order-online" class="btn">Order Now</a>' +
+              '<button type="button" class="btn" data-interaction=" tasting-notes" style="background:#ffab40; color:#3e2723; font-weight:bold;">Show Roaster Tasting Notes</button>' +
+            '</div>';
+        }
+
+        const viewContent = document.getElementById('view-content');
+        if (viewContent) {
+          const cardsHtml = routeData.cards
+            .map(function (c) {
+              return (
+                '<div class="card">' +
+                  '<h3>' + c.title + '</h3>' +
+                  '<p>' + c.description + '</p>' +
+                  '<p style="font-weight:bold; margin-top:8px; color:var(--primary);">' + (c.price || '') + '</p>' +
+                  '<div style="display:flex; gap:8px; justify-content:center; flex-wrap:wrap;">' +
+                    '<a href="' + c.route + '" data-route="' + c.route + '" class="btn">' + c.actionLabel + '</a>' +
+                    '<button type="button" class="btn" data-quick-add="' + c.title + '" style="background:#6d4c41;">Quick Add</button>' +
+                  '</div>' +
+                '</div>'
+              );
+            })
+            .join('');
+
+          viewContent.innerHTML =
+            '<h2 style="text-align: center;">' + routeData.heading + '</h2>' +
+            '<div class="grid">' + cardsHtml + '</div>' +
+            '<div id="interaction-banner"></div>';
+        }
+      }
+
+      // Render contentful update for in-page user interactions (without URL change)
+      function renderInteractionUpdate(title, detail) {
+        const viewContent = document.getElementById('view-content');
+        if (!viewContent) return;
+        let banner = document.getElementById('interaction-banner');
+        if (!banner) {
+          banner = document.createElement('div');
+          banner.id = 'interaction-banner';
+          viewContent.appendChild(banner);
+        }
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.style.marginTop = '20px';
+        card.style.border = '2px solid var(--accent)';
+        card.innerHTML =
+          '<h3>' + title + '</h3>' +
+          '<p>' + detail + '</p>';
+        banner.replaceChildren(card);
+      }
+
+      // Intercept clicks for client-side navigation and interactive content updates
+      document.addEventListener('click', function (event) {
+        const quickAddBtn = event.target.closest('[data-quick-add]');
+        if (quickAddBtn) {
+          event.preventDefault();
+          const item = quickAddBtn.getAttribute('data-quick-add');
+          renderInteractionUpdate(
+            'Added ' + item + ' to Your Cup',
+            'Freshly ground to order! This in-page update triggers an Interaction Contentful Paint entry without changing the URL.'
+          );
+          return;
+        }
+
+        const tastingBtn = event.target.closest('[data-interaction]');
+        if (tastingBtn) {
+          event.preventDefault();
+          renderInteractionUpdate(
+            'Today\'s Roaster Tasting Notes: Ethiopian & Colombian Blend',
+            'Aroma of toasted hazelnut, bright Meyer lemon acidity, and a lingering velvety dark cocoa finish.'
+          );
+          return;
+        }
+
+        const link = event.target.closest('a[href]');
+        if (!link) return;
+        const href = link.getAttribute('href');
+        if (!href || !href.startsWith('/')) return;
+
+        event.preventDefault();
+        renderRoute(href, true);
+      });
+
+      window.addEventListener('popstate', function () {
+        renderRoute(window.location.pathname || '/', false);
+      });
+    })();
+  </script>
 </body>
 
 </html>
