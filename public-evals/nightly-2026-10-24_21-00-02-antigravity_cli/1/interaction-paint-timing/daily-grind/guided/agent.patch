+
+    const ITEM_DETAILS = {
+      '/menu/seasonal': {
+        title: 'Maple Oat Latte — Tasting Notes & Nutrition',
+        body: 'Crafted with organic barista-grade oat milk, Grade-A dark amber Vermont maple syrup, and our signature two-bean espresso blend. Topped with a light dusting of Ceylon cinnamon. (210 kcal, 16oz)',
