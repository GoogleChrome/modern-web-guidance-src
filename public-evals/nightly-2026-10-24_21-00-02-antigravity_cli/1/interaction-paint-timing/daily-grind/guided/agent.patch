+
+    function renderSoftRoute(pathname) {
+      const detailSection = document.getElementById('interaction-detail');
+      const routeSection = document.getElementById('route-content');
+
+      // Check if it is an item detail view
+      if (ITEM_DETAILS[pathname] && detailSection) {
+        const detail = ITEM_DETAILS[pathname];
+        detailSection.hidden = false;
+        detailSection.innerHTML = `
+          <h3>${detail.title}</h3>
+          <p>${detail.body}</p>
+        `;
+        return;
+      }
+
+      const route = ROUTES[pathname] || {
+        heading: `Explore ${pathname.replace('/', '').replace(/-/g, ' ') || 'The Daily Grind'}`,
+        description: 'Handcrafted coffee experiences tailored for every moment of your day.',
+        items: ROUTES['/menu'].items,
+      };
+
+      if (detailSection) {
+        detailSection.hidden = true;
+      }
+
+      if (routeSection) {
+        routeSection.innerHTML = `
+          <h2 style="text-align: center;">${route.heading}</h2>
+          <p style="text-align: center; margin-top: 8px;">${route.description}</p>
+          <div class="grid">
+            ${route.items
+              .map(
+                (item) => `
+              <div class="card">
+                <h3>${item.title}</h3>
+                <p>${item.copy}</p>
+                <a href="${item.slug}" class="btn" data-spa-nav>View Details</a>
+              </div>
+            `
+              )
+              .join('')}
+          </div>
+        `;
+      }
+    }
+
+    document.addEventListener('click', (event) => {
+      const link = event.target.closest('a[data-spa-nav]');
+      if (!link) return;
+
+      const url = new URL(link.href, window.location.origin);
+      if (url.origin !== window.location.origin) return;
+
+      event.preventDefault();
+      // Render new contentful DOM update and update visible URL via History API
+      renderSoftRoute(url.pathname);
+      history.pushState({ path: url.pathname }, '', url.pathname);
+    });
+
+    window.addEventListener('popstate', () => {
+      renderSoftRoute(window.location.pathname);
+    });
+  </script>
