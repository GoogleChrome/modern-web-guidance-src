+  <script>
+    function findMostVisibleSection(container) {
+      const containerRect = container.getBoundingClientRect();
+      const cards = container.querySelectorAll('.origin-card');
+      let bestCard = null;
+      let maxVisibleHeight = -1;
+
+      cards.forEach((card) => {
+        const rect = card.getBoundingClientRect();
+        const visibleTop = Math.max(rect.top, containerRect.top);
+        const visibleBottom = Math.min(rect.bottom, containerRect.bottom);
+        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+        if (visibleHeight > maxVisibleHeight) {
+          maxVisibleHeight = visibleHeight;
+          bestCard = card;
+        }
+      });
+
+      if (!bestCard) return '';
+      return bestCard.dataset.origin || bestCard.querySelector('h3')?.textContent.trim() || '';
+    }
+
+    function initializeScroller() {
+      const scroller = document.querySelector('#scroller');
+      const status = document.querySelector('#status');
+      let isScrolling = false;
+
+      // 1. Lightweight informative feedback during scroll (avoid layout recalculations here)
+      scroller.addEventListener('scroll', () => {
+        if (!isScrolling) {
+          isScrolling = true;
+          status.textContent = 'Scrolling...';
+          status.classList.add('is-scrolling');
+        }
+      }, { passive: true });
+
+      // 2. Defer layout measurements until scrolling rests via scrollend
+      scroller.addEventListener('scrollend', () => {
+        isScrolling = false;
+        status.classList.remove('is-scrolling');
+        const visibleOrigin = findMostVisibleSection(scroller);
+        status.textContent = `Scroll ended. Visible: ${visibleOrigin}`;
+      });
+    }
+
+    if ('onscrollend' in window) {
+      initializeScroller();
+    } else {
+      initializeScroller();
+      const scroller = document.querySelector('#scroller');
+      scroller.addEventListener('scroll', () => {
+        clearTimeout(window.scrollendtimer);
+        window.scrollendtimer = setTimeout(() => {
+          scroller.dispatchEvent(new CustomEvent('scrollend'));
+        }, 100);
+      }, { passive: true });
+    }
+  </script>
