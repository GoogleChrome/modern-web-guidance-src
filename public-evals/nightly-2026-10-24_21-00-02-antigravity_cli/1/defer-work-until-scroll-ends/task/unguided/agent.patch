+  <script>
+    (function () {
+      const scroller = document.getElementById('scroller');
+      const status = document.getElementById('status');
+      const cards = Array.from(scroller.querySelectorAll('.origin-card'));
+
+      // Track visibility ratios asynchronously via IntersectionObserver
+      // so we avoid forced synchronous layout inside high-frequency scroll events.
+      const visibilityMap = new Map();
+      const thresholds = Array.from({ length: 21 }, (_, i) => i * 0.05);
+
+      const observer = new IntersectionObserver(
+        (entries) => {
+          for (const entry of entries) {
+            visibilityMap.set(entry.target, entry.intersectionRatio);
+          }
+        },
+        {
+          root: scroller,
+          threshold: thresholds
+        }
+      );
+
+      cards.forEach((card) => {
+        visibilityMap.set(card, 0);
+        observer.observe(card);
+      });
+
+      function getMostVisibleOrigin() {
+        let bestCard = cards[0];
+        let maxRatio = -1;
+
+        for (const card of cards) {
+          const ratio = visibilityMap.get(card) ?? 0;
+          if (ratio > maxRatio) {
+            maxRatio = ratio;
+            bestCard = card;
+          }
+        }
+
+        // Fallback geometry calculation on scroll stop if needed
+        if (maxRatio <= 0) {
+          const scrollerRect = scroller.getBoundingClientRect();
+          let maxVisibleHeight = -1;
+
+          for (const card of cards) {
+            const rect = card.getBoundingClientRect();
+            const visibleTop = Math.max(rect.top, scrollerRect.top);
+            const visibleBottom = Math.min(rect.bottom, scrollerRect.bottom);
+            const visibleHeight = Math.max(0, visibleBottom - visibleTop);
+
+            if (visibleHeight > maxVisibleHeight) {
+              maxVisibleHeight = visibleHeight;
+              bestCard = card;
+            }
+          }
+        }
+
+        return bestCard.dataset.origin || bestCard.querySelector('h3').textContent.trim();
+      }
+
+      let isScrolling = false;
+      let fallbackTimer = null;
+
+      function onScrollStop() {
+        if (fallbackTimer) {
+          clearTimeout(fallbackTimer);
+          fallbackTimer = null;
+        }
+        isScrolling = false;
+        const mostVisible = getMostVisibleOrigin();
+        status.textContent = `Scroll ended. Visible: ${mostVisible}`;
+        status.classList.remove('is-scrolling');
+      }
+
+      // Lightweight scroll handler: passive listener + boolean guard so DOM writes
+      // only happen once at the start of a scroll gesture (zero layout thrashing).
+      scroller.addEventListener(
+        'scroll',
+        () => {
+          if (!isScrolling) {
+            isScrolling = true;
+            status.textContent = 'Scrolling...';
+            status.classList.add('is-scrolling');
+          }
+
+          clearTimeout(fallbackTimer);
+          fallbackTimer = setTimeout(onScrollStop, 150);
+        },
+        { passive: true }
+      );
+
+      // Use native scrollend event where supported for exact scroll completion
+      if ('onscrollend' in window) {
+        scroller.addEventListener('scrollend', onScrollStop, { passive: true });
+      }
+    })();
+  </script>
+
