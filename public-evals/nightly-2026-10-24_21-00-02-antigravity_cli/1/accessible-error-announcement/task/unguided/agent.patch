     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const form = document.getElementById('newsletter-form');
+      const emailInput = document.getElementById('newsletter-email');
+      const errorMessage = document.getElementById('newsletter-error');
+
+      if (!form || !emailInput || !errorMessage) return;
+
+      const defaultErrorText =
+        errorMessage.getAttribute('data-error-message') ||
+        errorMessage.textContent.trim() ||
+        'Please enter a valid email address.';
+
+      let hasInteracted = false;
+
+      function showError() {
+        emailInput.setAttribute('aria-invalid', 'true');
+        emailInput.setAttribute('aria-describedby', 'newsletter-error');
+        emailInput.setAttribute('aria-errormessage', 'newsletter-error');
+        emailInput.classList.add('is-invalid');
+        errorMessage.hidden = false;
+        errorMessage.removeAttribute('aria-hidden');
+        if (errorMessage.textContent !== defaultErrorText) {
+          errorMessage.textContent = defaultErrorText;
+        }
+      }
+
+      function clearError() {
+        emailInput.setAttribute('aria-invalid', 'false');
+        emailInput.classList.remove('is-invalid');
+        errorMessage.textContent = '';
+        errorMessage.hidden = true;
+        errorMessage.setAttribute('aria-hidden', 'true');
+      }
+
+      function syncErrorState() {
+        if (emailInput.validity.valid) {
+          clearError();
+          return;
+        }
+
+        let userInvalidMatched = false;
+        try {
+          userInvalidMatched = emailInput.matches(':user-invalid');
+        } catch (err) {
+          userInvalidMatched = false;
+        }
+
+        if (hasInteracted || userInvalidMatched) {
+          showError();
+        } else {
+          clearError();
+        }
+      }
+
+      clearError();
+
+      emailInput.addEventListener('input', function () {
+        if (emailInput.validity.valid) {
+          clearError();
+        } else {
+          syncErrorState();
+        }
+      });
+
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('change', function () {
+        hasInteracted = true;
+        syncErrorState();
+      });
+
+      emailInput.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        showError();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        if (!emailInput.checkValidity()) {
+          showError();
+          emailInput.focus();
+        } else {
+          clearError();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
