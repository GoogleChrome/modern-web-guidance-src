+export class DgNavbar extends HTMLElement {
+  static get observedAttributes() {
+    return ['brand', 'cart-count', 'active-link'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(navbarTemplate.content.cloneNode(true));
+
+    this._brandText = this.shadowRoot.querySelector('.brand-text');
+    this._menuToggle = this.shadowRoot.querySelector('.menu-toggle');
+    this._navList = this.shadowRoot.querySelector('#primary-nav-list');
+    this._cartBtn = this.shadowRoot.querySelector('.cart-btn');
+    this._cartBadge = this.shadowRoot.querySelector('.cart-badge');
+
+    this._onToggleMenu = this._onToggleMenu.bind(this);
+    this._onCartClick = this._onCartClick.bind(this);
+    this._onKeyDown = this._onKeyDown.bind(this);
+  }
+
+  connectedCallback() {
+    this._menuToggle.addEventListener('click', this._onToggleMenu);
+    this._cartBtn.addEventListener('click', this._onCartClick);
+    this.shadowRoot.addEventListener('keydown', this._onKeyDown);
+    this._syncAttributes();
+  }
+
+  disconnectedCallback() {
+    this._menuToggle.removeEventListener('click', this._onToggleMenu);
+    this._cartBtn.removeEventListener('click', this._onCartClick);
+    this.shadowRoot.removeEventListener('keydown', this._onKeyDown);
+  }
+
+  attributeChangedCallback() {
+    this._syncAttributes();
+  }
+
+  get cartCount() {
+    return Number(this.getAttribute('cart-count') || 0);
+  }
+
+  set cartCount(val) {
+    this.setAttribute('cart-count', String(val));
+  }
+
+  _syncAttributes() {
+    const brand = this.getAttribute('brand') || 'THE DAILY GRIND';
+    if (this._brandText) {
+      this._brandText.textContent = brand;
+    }
+
+    const count = this.cartCount;
+    if (this._cartBadge && this._cartBtn) {
+      this._cartBadge.textContent = String(count);
+      this._cartBtn.setAttribute(
+        'aria-label',
+        `Shopping bag, ${count} ${count === 1 ? 'item' : 'items'}`
+      );
+    }
+
+    const active = this.getAttribute('active-link');
+    const links = this.shadowRoot.querySelectorAll('a[data-nav]');
+    links.forEach((link) => {
+      if (active && link.getAttribute('data-nav') === active) {
+        link.setAttribute('aria-current', 'page');
+      } else {
+        link.removeAttribute('aria-current');
+      }
+    });
+  }
+
+  _onToggleMenu() {
+    const isOpen = this._navList.getAttribute('data-open') === 'true';
+    const nextState = !isOpen;
+    this._navList.setAttribute('data-open', String(nextState));
+    this._menuToggle.setAttribute('aria-expanded', String(nextState));
+  }
+
+  _onKeyDown(event) {
+    if (event.key === 'Escape' && this._navList.getAttribute('data-open') === 'true') {
+      this._navList.setAttribute('data-open', 'false');
+      this._menuToggle.setAttribute('aria-expanded', 'false');
+      this._menuToggle.focus();
+    }
+  }
+
+  _onCartClick() {
+    this.dispatchEvent(
+      new CustomEvent('dg-cart-toggle', {
+        bubbles: true,
+        composed: true,
+        detail: { count: this.cartCount }
+      })
+    );
+  }
+}
