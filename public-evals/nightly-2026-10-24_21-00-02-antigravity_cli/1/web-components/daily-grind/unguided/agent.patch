+export class DgBrewGuide extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(brewGuideTemplate.content.cloneNode(true));
+
+    this._currentMethod = 'pourover';
+    this._tabs = Array.from(this.shadowRoot.querySelectorAll('.tab'));
+    this._panel = this.shadowRoot.querySelector('.panel');
+    this._cupsRange = this.shadowRoot.getElementById('cups-range');
+
+    this._onTabClick = this._onTabClick.bind(this);
+    this._onTabKeyDown = this._onTabKeyDown.bind(this);
+    this._updateCalculator = this._updateCalculator.bind(this);
+  }
+
+  connectedCallback() {
+    this._tabs.forEach((tab) => {
+      tab.addEventListener('click', this._onTabClick);
+      tab.addEventListener('keydown', this._onTabKeyDown);
+    });
+    this._cupsRange.addEventListener('input', this._updateCalculator);
+    this._renderMethod();
+  }
+
+  disconnectedCallback() {
+    this._tabs.forEach((tab) => {
+      tab.removeEventListener('click', this._onTabClick);
+      tab.removeEventListener('keydown', this._onTabKeyDown);
+    });
+    this._cupsRange.removeEventListener('input', this._updateCalculator);
+  }
+
+  _selectMethod(method) {
+    if (!BREW_METHODS[method]) return;
+    this._currentMethod = method;
+
+    this._tabs.forEach((tab) => {
+      const selected = tab.dataset.method === method;
+      tab.setAttribute('aria-selected', String(selected));
+      tab.tabIndex = selected ? 0 : -1;
+      if (selected) {
+        this._panel.id = `panel-${method}`;
+        this._panel.setAttribute('aria-labelledby', tab.id);
+      }
+    });
+
+    this._renderMethod();
+  }
+
+  _renderMethod() {
+    const data = BREW_METHODS[this._currentMethod];
+    this.shadowRoot.getElementById('method-title').textContent = data.title;
+    this.shadowRoot.getElementById('method-desc').textContent = data.desc;
+    this.shadowRoot.getElementById('spec-grind').textContent = data.grind;
+    this.shadowRoot.getElementById('spec-temp').textContent = data.temp;
+    this.shadowRoot.getElementById('spec-time').textContent = data.time;
+
+    const stepsList = this.shadowRoot.getElementById('method-steps');
+    stepsList.innerHTML = '';
+    data.steps.forEach((step) => {
+      const li = document.createElement('li');
+      li.textContent = step;
+      stepsList.appendChild(li);
+    });
+
+    this._updateCalculator();
+  }
+
+  _updateCalculator() {
+    const cups = Number(this._cupsRange.value || 2);
+    const data = BREW_METHODS[this._currentMethod];
+    this.shadowRoot.getElementById('cups-display').textContent =
+      `${cups} ${cups === 1 ? 'serving' : 'servings'}`;
+    this.shadowRoot.getElementById('calc-coffee').textContent = `${cups * data.coffeePerCup}g`;
+    this.shadowRoot.getElementById('calc-water').textContent = `${cups * data.waterPerCup}ml`;
+  }
+
+  _onTabClick(event) {
+    this._selectMethod(event.currentTarget.dataset.method);
+  }
+
+  _onTabKeyDown(event) {
+    const idx = this._tabs.indexOf(event.currentTarget);
+    if (idx === -1) return;
+
+    let nextIdx = -1;
+    if (event.key === 'ArrowRight') {
+      nextIdx = (idx + 1) % this._tabs.length;
+    } else if (event.key === 'ArrowLeft') {
+      nextIdx = (idx - 1 + this._tabs.length) % this._tabs.length;
+    } else if (event.key === 'Home') {
+      nextIdx = 0;
+    } else if (event.key === 'End') {
+      nextIdx = this._tabs.length - 1;
+    }
+
+    if (nextIdx !== -1) {
+      event.preventDefault();
+      const nextTab = this._tabs[nextIdx];
+      this._selectMethod(nextTab.dataset.method);
+      nextTab.focus();
+    }
+  }
+}
