+// Register all Custom Elements idempotently
+const registry = [
+  ['dg-navbar', DgNavbar],
+  ['dg-hero', DgHero],
+  ['coffee-card', CoffeeCard],
+  ['coffee-menu-section', CoffeeMenuSection],
+  ['dg-brew-guide', DgBrewGuide],
+  ['dg-rewards-banner', DgRewardsBanner],
+  ['dg-order-drawer', DgOrderDrawer],
+  ['dg-footer', DgFooter]
+];
+
+registry.forEach(([tagName, ctor]) => {
+  if (!customElements.get(tagName)) {
+    customElements.define(tagName, ctor);
+  }
+});
