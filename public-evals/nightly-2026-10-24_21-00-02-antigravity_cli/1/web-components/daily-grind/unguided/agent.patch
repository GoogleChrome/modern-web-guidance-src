+export class DgOrderDrawer extends HTMLElement {
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(orderDrawerTemplate.content.cloneNode(true));
+
+    this._items = [];
+    this._backdrop = this.shadowRoot.getElementById('backdrop');
+    this._closeBtn = this.shadowRoot.getElementById('close-btn');
+    this._itemList = this.shadowRoot.getElementById('item-list');
+    this._emptyMsg = this.shadowRoot.getElementById('empty-msg');
+    this._totalPrice = this.shadowRoot.getElementById('total-price');
+    this._toast = this.shadowRoot.getElementById('toast');
+
+    this.open = this.open.bind(this);
+    this.close = this.close.bind(this);
+    this._onKeyDown = this._onKeyDown.bind(this);
+  }
+
+  connectedCallback() {
+    this._closeBtn.addEventListener('click', this.close);
+    this._backdrop.addEventListener('click', (e) => {
+      if (e.target === this._backdrop) this.close();
+    });
+    window.addEventListener('keydown', this._onKeyDown);
+  }
+
+  disconnectedCallback() {
+    this._closeBtn.removeEventListener('click', this.close);
+    window.removeEventListener('keydown', this._onKeyDown);
+  }
+
+  addItem(item) {
+    this._items.push({ ...item, id: Date.now() + Math.random() });
+    this._render();
+    this.showToast(`Added ${item.size} ${item.name} ($${item.price.toFixed(2)}) to bag`);
+    this._emitUpdate();
+  }
+
+  showToast(message) {
+    this._toast.textContent = message;
+    this._toast.hidden = false;
+    clearTimeout(this._toastTimer);
+    this._toastTimer = setTimeout(() => {
+      this._toast.hidden = true;
+    }, 3200);
+  }
+
+  open() {
+    this._backdrop.hidden = false;
+    this._closeBtn.focus();
+  }
+
+  close() {
+    this._backdrop.hidden = true;
+  }
+
+  _onKeyDown(event) {
+    if (event.key === 'Escape' && !this._backdrop.hidden) {
+      this.close();
+    }
+  }
+
+  _emitUpdate() {
+    this.dispatchEvent(
+      new CustomEvent('dg-cart-updated', {
+        bubbles: true,
+        composed: true,
+        detail: { count: this._items.length, items: [...this._items] }
+      })
+    );
+  }
+
+  _render() {
+    this._itemList.innerHTML = '';
+    this._emptyMsg.hidden = this._items.length > 0;
+
+    let total = 0;
+    this._items.forEach((item) => {
+      total += item.price;
+      const li = document.createElement('li');
+      li.className = 'item';
+      li.innerHTML = `
+        <div>
+          <span class="item-title"></span>
+          <span class="item-meta"></span>
+        </div>
+        <button type="button" class="remove-btn">Remove</button>
+      `;
+      li.querySelector('.item-title').textContent = item.name;
+      li.querySelector('.item-meta').textContent = `${item.size} • $${item.price.toFixed(2)}`;
+      li.querySelector('.remove-btn').addEventListener('click', () => {
+        this._items = this._items.filter((i) => i.id !== item.id);
+        this._render();
+        this._emitUpdate();
+      });
+      this._itemList.appendChild(li);
+    });
+
+    this._totalPrice.textContent = `$${total.toFixed(2)}`;
+  }
+}
