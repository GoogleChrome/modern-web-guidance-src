+export class DgHero extends HTMLElement {
+  static get observedAttributes() {
+    return ['heading', 'subtitle', 'cta-text', 'cta-href', 'background-image', 'eyebrow'];
+  }
+
+  constructor() {
+    super();
+    this.attachShadow({ mode: 'open' });
+    this.shadowRoot.appendChild(heroTemplate.content.cloneNode(true));
+  }
+
+  connectedCallback() {
+    this._render();
+  }
+
+  attributeChangedCallback() {
+    this._render();
+  }
+
+  _render() {
+    const heading = this.getAttribute('heading') || 'Wake Up Your Senses';
+    const subtitle =
+      this.getAttribute('subtitle') ||
+      'Ethically sourced, locally roasted, delivered to your cup.';
+    const ctaText = this.getAttribute('cta-text') || 'Order Now';
+    const ctaHref = this.getAttribute('cta-href') || '/order-online';
+    const eyebrow = this.getAttribute('eyebrow') || 'Small-Batch Roastery';
+    const bgImage = this.getAttribute('background-image');
+
+    this.shadowRoot.getElementById('hero-heading').textContent = heading;
+    this.shadowRoot.getElementById('hero-subtitle').textContent = subtitle;
+    this.shadowRoot.querySelector('.eyebrow').textContent = eyebrow;
+
+    const ctaEl = this.shadowRoot.getElementById('hero-cta');
+    ctaEl.textContent = ctaText;
+    ctaEl.setAttribute('href', ctaHref);
+
+    if (bgImage) {
+      this.style.setProperty('--hero-bg', `url('${bgImage}')`);
+    }
+  }
+}
