+export class GrindNavbar extends HTMLElement {
+  static observedAttributes = ['brand', 'cart-count'];
+  #internals;
+  #menuOpen = false;
+  #onDocumentOrderUpdate;
+
+  constructor() {
+    super();
+    this.#internals = this.attachInternals?.() ?? null;
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.append(navbarTemplate.content.cloneNode(true));
+    }
+    this.shadowRoot.adoptedStyleSheets = [navbarSheet];
+
+    const toggleBtn = this.shadowRoot.getElementById('menu-toggle');
+    toggleBtn?.addEventListener('click', () => {
+      this.menuOpen = !this.#menuOpen;
+    });
+
+    const cartBtn = this.shadowRoot.getElementById('cart-btn');
+    cartBtn?.addEventListener('click', () => {
+      this.dispatchEvent(
+        new CustomEvent('grind-cart-toggle', {
+          bubbles: true,
+          composed: true,
+          detail: { count: this.cartCount },
+        })
+      );
+    });
+
+    this.#onDocumentOrderUpdate = (e) => {
+      if (typeof e.detail?.totalCount === 'number') {
+        this.cartCount = e.detail.totalCount;
+      }
+    };
+  }
+
+  connectedCallback() {
+    document.addEventListener('grind-order-updated', this.#onDocumentOrderUpdate);
+    this.#render();
+  }
+
+  disconnectedCallback() {
+    document.removeEventListener('grind-order-updated', this.#onDocumentOrderUpdate);
+  }
+
+  get brand() {
+    return this.getAttribute('brand') ?? 'THE DAILY GRIND';
+  }
+  set brand(val) {
+    val ? this.setAttribute('brand', val) : this.removeAttribute('brand');
+  }
+
+  get cartCount() {
+    return Number(this.getAttribute('cart-count')) || 0;
+  }
+  set cartCount(val) {
+    this.setAttribute('cart-count', String(Math.max(0, Number(val) || 0)));
+  }
+
+  get menuOpen() {
+    return this.#menuOpen;
+  }
+  set menuOpen(open) {
+    this.#menuOpen = Boolean(open);
+    if (this.#internals?.states) {
+      if (this.#menuOpen) {
+        this.#internals.states.add('menu-open');
+      } else {
+        this.#internals.states.delete('menu-open');
+      }
+    }
+    const toggleBtn = this.shadowRoot?.getElementById('menu-toggle');
+    if (toggleBtn) {
+      toggleBtn.setAttribute('aria-expanded', String(this.#menuOpen));
+    }
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) {
+      this.#render();
+    }
+  }
+
+  #render() {
+    const brandSlot = this.shadowRoot?.querySelector('slot[name="brand"]');
+    if (brandSlot && brandSlot.assignedNodes().length === 0 && this.hasAttribute('brand')) {
+      brandSlot.textContent = this.brand;
+    }
+    const cartLabel = this.shadowRoot?.getElementById('cart-label');
+    if (cartLabel) {
+      cartLabel.textContent = `Order (${this.cartCount})`;
+    }
+  }
+}
+
+if (!customElements.get('grind-navbar')) {
+  customElements.define('grind-navbar', GrindNavbar);
