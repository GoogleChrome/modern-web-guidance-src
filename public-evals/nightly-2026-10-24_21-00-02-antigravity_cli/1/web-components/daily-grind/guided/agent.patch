+    } else {
+      this.#renderHeading();
+    }
+  }
+
+  #renderHeading() {
+    const headingEl = this.shadowRoot?.getElementById('section-heading');
+    if (headingEl && this.hasAttribute('heading')) {
+      headingEl.textContent = this.heading;
+    }
+    const subtitleEl = this.shadowRoot?.getElementById('section-subtitle');
+    if (subtitleEl && this.hasAttribute('subtitle')) {
+      subtitleEl.textContent = this.getAttribute('subtitle');
+    }
+  }
+
+  #updateFilterButtons() {
+    const filterBtns = this.shadowRoot?.querySelectorAll('.filter-btn');
+    filterBtns?.forEach((btn) => {
+      const isMatch = btn.getAttribute('data-filter') === this.#activeFilter;
+      btn.setAttribute('aria-pressed', String(isMatch));
+    });
+  }
+
+  #getSlottedCards() {
+    const slot = this.shadowRoot?.querySelector('slot');
+    if (!slot) return [];
+    return slot.assignedElements({ flatten: true }).filter((el) => el.tagName.toLowerCase() === 'coffee-card');
+  }
+
+  #applyFilters() {
+    const cards = this.#getSlottedCards();
+    if (cards.length === 0) return;
+
+    let visible = 0;
+    cards.forEach((card) => {
+      const category = (card.getAttribute('category') || '').toLowerCase();
+      const name = (card.getAttribute('name') || card.textContent || '').toLowerCase();
+      const desc = (card.getAttribute('description') || card.textContent || '').toLowerCase();
+      const notes = (card.getAttribute('notes') || '').toLowerCase();
+      const isFav = card.hasAttribute('favorited');
+
+      let matchesCategory = true;
+      if (this.#activeFilter === 'favorites') {
+        matchesCategory = isFav;
+      } else if (this.#activeFilter !== 'all') {
+        matchesCategory = category === this.#activeFilter.toLowerCase();
+      }
+
+      let matchesSearch = true;
+      if (this.#searchQuery) {
+        matchesSearch =
+          name.includes(this.#searchQuery) ||
+          desc.includes(this.#searchQuery) ||
+          notes.includes(this.#searchQuery) ||
+          category.includes(this.#searchQuery);
+      }
+
+      const show = matchesCategory && matchesSearch;
+      card.toggleAttribute('hidden', !show);
+      if (show) visible++;
+    });
+
+    const visibleCountEl = this.shadowRoot?.getElementById('visible-count');
+    if (visibleCountEl) {
+      visibleCountEl.textContent =
+        visible === cards.length
+          ? `Showing all ${cards.length} artisanal drinks`
+          : `Showing ${visible} of ${cards.length} artisanal drinks`;
+    }
+
+    const emptyState = this.shadowRoot?.getElementById('empty-state');
+    if (emptyState) {
+      emptyState.hidden = visible > 0;
+    }
+  }
+
+  #renderOrderTray() {
+    const tray = this.shadowRoot?.getElementById('order-tray');
+    const list = this.shadowRoot?.getElementById('order-list');
+    const totalEl = this.shadowRoot?.getElementById('order-total');
+    if (!tray || !list || !totalEl) return;
+
+    if (this.#orders.length === 0) {
+      tray.hidden = true;
+      list.innerHTML = '';
+      totalEl.textContent = 'Total: $0.00';
+      return;
+    }
+
+    tray.hidden = false;
+    list.innerHTML = '';
+    let sum = 0;
+
+    this.#orders.forEach((item) => {
+      sum += Number(item.price) || 0;
+      const li = document.createElement('li');
+      li.className = 'order-item';
+
+      const info = document.createElement('span');
+      info.textContent = `${item.name} (${item.size}) — $${Number(item.price).toFixed(2)}`;
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.className = 'remove-btn';
+      removeBtn.textContent = 'Remove';
+      removeBtn.setAttribute('aria-label', `Remove ${item.name} (${item.size}) from order`);
+      removeBtn.addEventListener('click', () => {
+        this.#orders = this.#orders.filter((o) => o.id !== item.id);
+        this.#renderOrderTray();
+        this.#dispatchOrderUpdate();
+      });
+
+      li.append(info, removeBtn);
+      list.append(li);
+    });
+
+    totalEl.textContent = `Total: $${sum.toFixed(2)}`;
+  }
+
+  #dispatchOrderUpdate() {
+    this.dispatchEvent(
+      new CustomEvent('grind-order-updated', {
+        bubbles: true,
+        composed: true,
+        detail: {
+          totalCount: this.#orders.length,
+          items: this.orders,
+        },
+      })
+    );
+  }
+}
+
+if (!customElements.get('grind-menu-section')) {
+  customElements.define('grind-menu-section', GrindMenuSection);
+}
+
+// ============================================================================
+// 5. <grind-footer> — Reusable Site Footer Web Component
+// ============================================================================
+const footerSheet = new CSSStyleSheet();
+footerSheet.replaceSync(`
+  @layer base;
+
+  @layer base {
+    :host {
+      display: block;
+      --_footer-bg: var(--secondary, #d7ccc8);
+      --_footer-text: var(--text, #3e2723);
+      --_footer-primary: var(--primary, #4e342e);
+      background: var(--_footer-bg);
+      color: var(--_footer-text);
+      text-align: center;
+      padding: 40px 20px;
+      margin-top: 40px;
+    }
+
+    .footer-links {
+      margin-bottom: 20px;
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      align-items: center;
+      gap: 8px 14px;
+    }
+
+    .footer-links a {
+      color: var(--_footer-text);
+      text-decoration: none;
+      font-size: 0.85rem;
+      font-weight: 500;
+    }
+
+    .footer-links a:hover,
+    .footer-links a:focus-visible {
+      color: var(--_footer-primary);
+      text-decoration: underline;
+    }
+
+    .divider {
+      opacity: 0.5;
+    }
+
+    p {
+      margin: 0;
+      font-size: 0.9rem;
+    }
+  }
+`);
+
+const footerTemplate = document.createElement('template');
+footerTemplate.innerHTML = `
+  <footer part="footer">
+    <nav class="footer-links" part="links" aria-label="Footer">
+      <a href="/about">Our Story</a>
+      <span class="divider" aria-hidden="true">|</span>
+      <a href="/careers">Join the Team</a>
+      <span class="divider" aria-hidden="true">|</span>
+      <a href="/contact">Contact Us</a>
+      <span class="divider" aria-hidden="true">|</span>
+      <a href="/privacy-policy">Privacy</a>
+    </nav>
+    <p id="copyright-text" part="copyright">&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+`;
+
+export class GrindFooter extends HTMLElement {
+  static observedAttributes = ['year', 'company'];
+
+  constructor() {
+    super();
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
+      this.shadowRoot.append(footerTemplate.content.cloneNode(true));
+    }
+    this.shadowRoot.adoptedStyleSheets = [footerSheet];
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  attributeChangedCallback(name, oldVal, newVal) {
+    if (oldVal !== newVal) {
+      this.#render();
+    }
+  }
+
+  #render() {
+    const year = this.getAttribute('year') || '2026';
+    const company = this.getAttribute('company') || 'The Daily Grind Coffee Co.';
+    const copyEl = this.shadowRoot?.getElementById('copyright-text');
+    if (copyEl) {
+      copyEl.innerHTML = `&copy; ${year} ${company} All rights reserved.`;
+    }
+  }
+}
+
+if (!customElements.get('grind-footer')) {
+  customElements.define('grind-footer', GrindFooter);
+}
