+      menuSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
+    });
+  }
+
+  connectedCallback() {
+    this.#render();
+  }
+
+  get heading() {
+    return this.getAttribute('heading') ?? 'Wake Up Your Senses';
+  }
+  set heading(val) {
