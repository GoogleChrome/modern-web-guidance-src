+export class GrindHero extends HTMLElement {
+  static observedAttributes = ['heading', 'subtitle', 'cta-text', 'cta-href', 'background-image'];
+
+  constructor() {
+    super();
+    if (!this.shadowRoot) {
+      this.attachShadow({ mode: 'open' });
