+  <script>
+    (function () {
+      const scrollContainer = document.getElementById('reviews-scroll-container');
+      const topIndicator = document.querySelector('.indicator-top');
+      const bottomIndicator = document.querySelector('.indicator-bottom');
+
+      function setIndicatorVisibility(element, isVisible) {
+        if (!element) return;
+        if (isVisible) {
+          element.classList.remove('indicator-hidden');
+          element.classList.add('visible');
+          element.style.display = 'block';
+          element.style.opacity = '1';
+          element.style.visibility = 'visible';
+        } else {
+          element.classList.add('indicator-hidden');
+          element.classList.remove('visible');
+          element.style.display = 'none';
+          element.style.opacity = '0';
+          element.style.visibility = 'hidden';
+        }
+      }
+
+      function updateScrollIndicators() {
+        if (!scrollContainer) return;
+        const { scrollTop, scrollHeight, clientHeight } = scrollContainer;
+        const canScrollUp = scrollTop > 0;
+        const canScrollDown = Math.ceil(scrollTop + clientHeight) < scrollHeight - 1;
+
+        setIndicatorVisibility(topIndicator, canScrollUp);
+        setIndicatorVisibility(bottomIndicator, canScrollDown);
+      }
+
+      if (scrollContainer) {
+        scrollContainer.addEventListener('scroll', updateScrollIndicators, { passive: true });
+        window.addEventListener('resize', updateScrollIndicators);
+        window.addEventListener('load', updateScrollIndicators);
+        updateScrollIndicators();
+      }
+    })();
+  </script>
+
