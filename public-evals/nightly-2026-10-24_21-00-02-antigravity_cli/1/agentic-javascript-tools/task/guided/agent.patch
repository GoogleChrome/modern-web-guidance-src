diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,86 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const menuItems = [
+      {
+        name: "Maple Oat Latte",
+        category: "Seasonal",
+        price: "$5.75",
+        calories: 210,
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        url: "/menu/seasonal",
+      },
+      {
+        name: "Dark Roast Espresso",
+        category: "Espresso",
+        price: "$3.50",
+        calories: 5,
+        description: "Bold, smokey, and perfect for a morning boost.",
+        url: "/menu/espresso",
+      },
+      {
+        name: "Cold Brew",
+        category: "Cold Brew",
+        price: "$4.75",
+        calories: 15,
+        description: "Steeped for 18 hours for maximum smoothness.",
+        url: "/menu/cold-brew",
+      },
+    ];
+
+    if ("modelContext" in document && document.modelContext) {
+      const controller = new AbortController();
+
+      window.addEventListener("pagehide", () => controller.abort());
+      window.addEventListener("unload", () => controller.abort());
+
+      await document.modelContext.registerTool(
+        {
+          name: "get_menu_item_details",
+          description:
+            "Retrieves details for a menu item by name. Use when the user asks about a drink or item on the menu.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              itemName: {
+                type: "string",
+                description: "Name of the menu item to look up.",
+              },
+            },
+            required: ["itemName"],
+          },
+          execute(input) {
+            const rawName = typeof input?.itemName === "string" ? input.itemName.trim() : "";
+            if (!rawName) {
+              return {
+                error: "Please provide the name of a menu item to look up.",
+                availableItems: menuItems.map((entry) => entry.name),
+              };
+            }
+
+            const item = menuItems.find(
+              (entry) => entry.name.toLowerCase() === rawName.toLowerCase()
+            );
+
+            if (!item) {
+              return {
+                error: `Menu item "${rawName}" not found.`,
+                availableItems: menuItems.map((entry) => entry.name),
+              };
+            }
+
+            return item;
+          },
+          annotations: {
+            readOnlyHint: true,
+          },
+        },
+        { signal: controller.signal }
+      );
+    }
+  </script>
 </body>
 
 </html>
