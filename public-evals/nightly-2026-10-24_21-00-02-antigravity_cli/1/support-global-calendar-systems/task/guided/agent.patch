+  <script type="module">
+    const CALENDARS = [
+      {
+        id: 'islamic-umalqura',
+        locale: 'en-u-ca-islamic-umalqura',
+        formatOptions: { day: 'numeric', month: 'long', year: 'numeric', era: 'long' }
+      },
+      {
+        id: 'hebrew',
+        locale: 'en-u-ca-hebrew',
+        formatOptions: { day: 'numeric', month: 'long', year: 'numeric', era: 'long' }
+      },
+      {
+        id: 'japanese',
+        locale: 'en-u-ca-japanese',
+        formatOptions: { day: 'numeric', month: 'long', year: 'numeric', era: 'long' }
+      }
+    ];
+
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    function updateCalendarCards(isoDateString) {
+      const selectedIsoDate = isoDateString
+        ? Temporal.PlainDate.from(isoDateString)
+        : Temporal.Now.plainDateISO();
+      const todayIso = Temporal.Now.plainDateISO();
+
+      for (const config of CALENDARS) {
+        const card = document.querySelector(`.calendar-card[data-calendar="${config.id}"]`);
+        if (!card) continue;
+
+        const supported = isCalendarSupported(config.id);
+        const targetDate = supported
+          ? selectedIsoDate.withCalendar(config.id)
+          : selectedIsoDate;
+        const todayInCalendar = supported
+          ? todayIso.withCalendar(config.id)
+          : todayIso;
+
+        // 1. Formatted localized date (including era names)
+        const formattedDisplay = targetDate.toLocaleString(config.locale, config.formatOptions);
+        const formattedEl = card.querySelector('[data-field="formatted-date"]');
+        if (formattedEl) {
+          formattedEl.textContent = formattedDisplay;
+        }
+
+        // 2. Converted year, numeric month, and unique stable monthCode
+        const yearEl = card.querySelector('[data-field="year"]');
+        const monthEl = card.querySelector('[data-field="month"]');
+        const monthCodeEl = card.querySelector('[data-field="monthCode"]');
+        if (yearEl) yearEl.textContent = String(targetDate.year);
+        if (monthEl) monthEl.textContent = String(targetDate.month);
+        if (monthCodeEl) monthCodeEl.textContent = targetDate.monthCode;
+
+        // 3. Total number of months in that specific calendar year
+        const monthsInYear = targetDate.monthsInYear;
+        const monthsInYearEl = card.querySelector('[data-field="monthsInYear"]');
+        const monthsInYearCountEl = card.querySelector('[data-field="monthsInYearCount"]');
+        if (monthsInYearEl) monthsInYearEl.textContent = String(monthsInYear);
+        if (monthsInYearCountEl) monthsInYearCountEl.textContent = String(monthsInYear);
+
+        // 4. Timeline label comparing selected date against current date using Temporal.PlainDate.compare()
+        const comparison = Temporal.PlainDate.compare(targetDate, todayInCalendar);
+        const relativeLabel = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+        const timelineEl = card.querySelector('[data-field="timeline"]');
+        if (timelineEl) {
+          timelineEl.textContent = relativeLabel;
+          timelineEl.dataset.timeline = relativeLabel;
+        }
+
+        // 5. Month breakdown showing each month's code and days in that month for that specific year
+        const monthsListEl = card.querySelector('[data-field="months-list"]');
+        if (monthsListEl) {
+          monthsListEl.replaceChildren();
+          for (let m = 1; m <= targetDate.monthsInYear; m++) {
+            const monthDate = targetDate.with({ month: m, day: 1 });
+            const li = document.createElement('li');
+            li.className = 'month-chip' + (monthDate.monthCode === targetDate.monthCode ? ' active-month' : '');
+            li.dataset.monthCode = monthDate.monthCode;
+            li.dataset.days = String(monthDate.daysInMonth);
+
+            const codeSpan = document.createElement('span');
+            codeSpan.textContent = monthDate.monthCode;
+
+            const daysSpan = document.createElement('span');
+            daysSpan.textContent = `${monthDate.daysInMonth} days`;
+
+            li.append(codeSpan, daysSpan);
+            monthsListEl.appendChild(li);
+          }
+        }
+      }
+    }
+
+    function initializeApp() {
+      const dateInput = document.getElementById('calendar-date-input');
+      const todayIso = Temporal.Now.plainDateISO();
+
+      if (dateInput) {
+        if (!dateInput.value) {
+          dateInput.value = todayIso.toString();
+        }
+        const handleDateChange = (event) => {
+          const val = event.target.value;
+          if (val) {
+            updateCalendarCards(val);
+          }
+        };
+        dateInput.addEventListener('input', handleDateChange);
+        dateInput.addEventListener('change', handleDateChange);
+      }
+
+      updateCalendarCards(dateInput?.value || todayIso.toString());
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
