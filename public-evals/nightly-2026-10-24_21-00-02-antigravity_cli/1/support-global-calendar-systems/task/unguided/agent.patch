+  <script type="module">
+    async function getTemporal() {
+      let supportsNonIsoCalendars = false;
+      if (typeof globalThis.Temporal !== 'undefined') {
+        try {
+          const probe = globalThis.Temporal.PlainDate.from('2026-01-01').withCalendar('islamic-umalqura');
+          probe.toLocaleString('en-US', { calendar: 'islamic-umalqura' });
+          supportsNonIsoCalendars = true;
+        } catch {
+          supportsNonIsoCalendars = false;
+        }
+      }
+
+      if (!supportsNonIsoCalendars) {
+        try {
+          const polyfill = await import('https://esm.sh/@js-temporal/polyfill');
+          globalThis.Temporal = polyfill.Temporal;
+        } catch {
+          await import('./temporal-polyfill.umd.js');
+          globalThis.Temporal = globalThis.temporal.Temporal;
+        }
+      }
+
+      return globalThis.Temporal;
+    }
+
+    const CALENDARS = [
+      { id: 'islamic-umalqura', prefix: 'islamic', includeEra: false },
+      { id: 'hebrew', prefix: 'hebrew', includeEra: false },
+      { id: 'japanese', prefix: 'japanese', includeEra: true }
+    ];
+
+    async function initCalendarTool() {
+      const Temporal = await getTemporal();
+      const dateInput = document.getElementById('calendar-date-input');
+      const todayIso = Temporal.Now.plainDateISO();
+
+      if (!dateInput.value) {
+        dateInput.value = todayIso.toString();
+      }
+
+      function renderCalendars(isoDateString) {
+        if (!isoDateString) return;
+
+        let selectedIsoDate;
+        try {
+          selectedIsoDate = Temporal.PlainDate.from(isoDateString);
+        } catch {
+          return;
+        }
+
+        const currentToday = Temporal.Now.plainDateISO();
+        const comparison = Temporal.PlainDate.compare(selectedIsoDate, currentToday);
+        const timelineStatus = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+        for (const cal of CALENDARS) {
+          const convertedDate = selectedIsoDate.withCalendar(cal.id);
+
+          const formatOptions = {
+            calendar: cal.id,
+            year: 'numeric',
+            month: 'long',
+            day: 'numeric'
+          };
+          if (cal.includeEra) {
+            formatOptions.era = 'long';
+          }
+
+          const formattedDate = convertedDate.toLocaleString('en-US', formatOptions);
+
+          const dateEl = document.getElementById(`${cal.prefix}-date`);
+          const timelineEl = document.getElementById(`${cal.prefix}-timeline`);
+          const yearEl = document.getElementById(`${cal.prefix}-year`);
+          const monthEl = document.getElementById(`${cal.prefix}-month`);
+          const monthCodeEl = document.getElementById(`${cal.prefix}-month-code`);
+          const monthsInYearEl = document.getElementById(`${cal.prefix}-months-in-year`);
+          const breakdownEl = document.getElementById(`${cal.prefix}-breakdown`);
+
+          if (dateEl) dateEl.textContent = formattedDate;
+          if (timelineEl) {
+            timelineEl.textContent = timelineStatus;
+            timelineEl.dataset.timeline = timelineStatus;
+          }
+          if (yearEl) yearEl.textContent = String(convertedDate.year);
+          if (monthEl) monthEl.textContent = String(convertedDate.month);
+          if (monthCodeEl) monthCodeEl.textContent = convertedDate.monthCode;
+          if (monthsInYearEl) monthsInYearEl.textContent = String(convertedDate.monthsInYear);
+
+          if (breakdownEl) {
+            breakdownEl.innerHTML = '';
+            const totalMonths = convertedDate.monthsInYear;
+            for (let m = 1; m <= totalMonths; m++) {
+              const monthStart = convertedDate.with({ month: m, day: 1 });
+              const li = document.createElement('li');
+              li.className = 'month-chip' + (monthStart.monthCode === convertedDate.monthCode ? ' active-month' : '');
+              li.dataset.monthCode = monthStart.monthCode;
+              li.dataset.days = String(monthStart.daysInMonth);
+
+              const codeSpan = document.createElement('span');
+              codeSpan.className = 'month-chip-code';
+              codeSpan.textContent = monthStart.monthCode;
+
+              const daysSpan = document.createElement('span');
+              daysSpan.className = 'month-chip-days';
+              daysSpan.textContent = `${monthStart.daysInMonth} days`;
+
+              li.append(codeSpan, daysSpan);
+              breakdownEl.appendChild(li);
+            }
+          }
+        }
+      }
+
+      renderCalendars(dateInput.value);
+
+      dateInput.addEventListener('input', (e) => {
+        renderCalendars(e.target.value);
+      });
+      dateInput.addEventListener('change', (e) => {
+        renderCalendars(e.target.value);
+      });
+    }
+
+    initCalendarTool();
+  </script>
 </body>
 
