+  <script>
+    (function () {
+      const featureLink = document.getElementById('feature');
+      const tourStep = document.getElementById('tour-step');
+      const closeBtn = document.getElementById('close-tour');
+      let isTourActive = true;
+
+      if (typeof tourStep.showPopover === 'function') {
+        tourStep.showPopover();
+      } else {
+        tourStep.style.display = 'block';
+      }
+
+      if (!(window.CSS && CSS.supports && CSS.supports('anchor-name', '--feature'))) {
+        const updatePosition = () => {
+          if (!isTourActive) return;
+          const rect = featureLink.getBoundingClientRect();
+          tourStep.style.top = (rect.bottom + 8) + 'px';
+          tourStep.style.left = rect.left + 'px';
+        };
+        updatePosition();
+        window.addEventListener('resize', updatePosition);
+        window.addEventListener('scroll', updatePosition, true);
+      }
+
+      featureLink.addEventListener('click', (event) => {
+        if (isTourActive) {
+          event.preventDefault();
+        }
+      });
+
+      tourStep.addEventListener('toggle', (event) => {
+        if (event.newState === 'closed') {
+          isTourActive = false;
+        }
+      });
+
+      closeBtn.addEventListener('click', () => {
+        isTourActive = false;
+        if (typeof tourStep.hidePopover === 'function' && tourStep.matches(':popover-open')) {
+          tourStep.hidePopover();
+        } else if (typeof tourStep.hidePopover !== 'function') {
+          tourStep.style.display = 'none';
+        }
+      });
+    })();
+  </script>
