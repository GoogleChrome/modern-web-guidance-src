+  <script type="module">
+    const featureLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    let isTourOpen = true;
+
+    tourStep.addEventListener('toggle', (event) => {
+      isTourOpen = event.newState === 'open';
+    });
+
+    featureLink.addEventListener('click', (event) => {
+      if (isTourOpen || tourStep.matches(':is(:popover-open, .\\:popover-open)')) {
+        event.preventDefault();
+      }
+    });
+
+    if (!('popover' in HTMLElement.prototype)) {
+      try {
+        await import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js');
+      } catch {}
+    }
+
+    tourStep.showPopover();
+    tourStep.querySelector('button').focus();
+
+    if (!CSS.supports('anchor-name: --foo')) {
+      try {
+        await import('https://unpkg.com/@oddbird/css-anchor-positioning');
+      } catch {}
+    }
+  </script>
