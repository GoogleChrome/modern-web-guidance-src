+      <div class="floating-widget-controls">
+        <label for="quick-order-size" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);">Size</label>
+        <select id="quick-order-size" class="floating-widget-select" name="size">
