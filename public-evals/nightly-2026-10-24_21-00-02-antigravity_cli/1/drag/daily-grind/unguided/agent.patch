+  <aside id="floating-element" class="floating-widget" aria-label="Quick Order Floating Widget">
+    <div class="floating-widget-header">
+      <span>☕ Quick Order &amp; Rewards</span>
+      <span class="floating-widget-grip" aria-hidden="true">⋮⋮</span>
+    </div>
+    <div class="floating-widget-body">
+      <p>You have <strong>140 Bean Points</strong>! Ready for your free handcrafted drink?</p>
+      <div class="floating-widget-actions">
+        <a href="/rewards" class="widget-btn" draggable="false">Redeem Now</a>
+        <button type="button" id="reset-widget-pos" class="reset-btn" title="Reset position">Reset Pos</button>
+      </div>
+    </div>
+  </aside>
+
+  <script>
+    (function () {
+      const floatingEl = document.getElementById('floating-element');
+      const resetBtn = document.getElementById('reset-widget-pos');
+      if (!floatingEl) return;
+
+      const STORAGE_KEY = 'daily_grind_floating_pos';
+
+      let isDragging = false;
+      let startX = 0;
+      let startY = 0;
+      let initialLeft = 0;
+      let initialTop = 0;
+      let activePointerId = null;
+
+      function clampPosition(left, top) {
+        const rect = floatingEl.getBoundingClientRect();
+        const maxLeft = Math.max(0, window.innerWidth - rect.width);
+        const maxTop = Math.max(0, window.innerHeight - rect.height);
+        return {
+          left: Math.min(Math.max(0, left), maxLeft),
+          top: Math.min(Math.max(0, top), maxTop)
+        };
+      }
+
+      function applyPosition(left, top) {
+        const clamped = clampPosition(left, top);
+        floatingEl.style.left = clamped.left + 'px';
+        floatingEl.style.top = clamped.top + 'px';
+        floatingEl.style.right = 'auto';
+        floatingEl.style.bottom = 'auto';
+        return clamped;
+      }
+
+      // Restore saved position if available
+      try {
+        const saved = localStorage.getItem(STORAGE_KEY);
+        if (saved) {
+          const parsed = JSON.parse(saved);
+          if (typeof parsed.left === 'number' && typeof parsed.top === 'number') {
+            applyPosition(parsed.left, parsed.top);
+          }
+        }
+      } catch (e) {
+        // Ignore storage errors
+      }
+
+      function onDragStart(clientX, clientY, target) {
+        if (target && target.closest('a, button, input, textarea, select')) {
+          return false;
+        }
+        const rect = floatingEl.getBoundingClientRect();
+        isDragging = true;
+        startX = clientX;
+        startY = clientY;
+        initialLeft = rect.left;
+        initialTop = rect.top;
+
+        applyPosition(initialLeft, initialTop);
+        floatingEl.classList.add('dragging');
+        return true;
+      }
+
+      function onDragMove(clientX, clientY) {
+        if (!isDragging) return;
+        const dx = clientX - startX;
+        const dy = clientY - startY;
+        applyPosition(initialLeft + dx, initialTop + dy);
+      }
+
+      function onDragEnd() {
+        if (!isDragging) return;
+        isDragging = false;
+        activePointerId = null;
+        floatingEl.classList.remove('dragging');
+
+        const rect = floatingEl.getBoundingClientRect();
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify({
+            left: Math.round(rect.left),
+            top: Math.round(rect.top)
+          }));
+        } catch (e) {
+          // Ignore storage errors
+        }
+      }
+
+      if (window.PointerEvent) {
+        floatingEl.addEventListener('pointerdown', function (e) {
+          if (e.button !== undefined && e.button !== 0) return;
+          if (onDragStart(e.clientX, e.clientY, e.target)) {
+            activePointerId = e.pointerId;
+            if (floatingEl.setPointerCapture) {
+              try {
+                floatingEl.setPointerCapture(e.pointerId);
+              } catch (err) {}
+            }
+            e.preventDefault();
+          }
+        });
+
+        window.addEventListener('pointermove', function (e) {
+          if (!isDragging || (activePointerId !== null && e.pointerId !== activePointerId)) return;
+          onDragMove(e.clientX, e.clientY);
+        });
+
+        window.addEventListener('pointerup', function (e) {
+          if (!isDragging || (activePointerId !== null && e.pointerId !== activePointerId)) return;
+          onDragEnd();
+        });
+
+        window.addEventListener('pointercancel', function (e) {
+          if (!isDragging || (activePointerId !== null && e.pointerId !== activePointerId)) return;
+          onDragEnd();
+        });
+      } else {
+        floatingEl.addEventListener('mousedown', function (e) {
+          if (e.button !== 0) return;
+          if (onDragStart(e.clientX, e.clientY, e.target)) {
+            e.preventDefault();
+          }
+        });
+
+        window.addEventListener('mousemove', function (e) {
+          if (!isDragging) return;
+          onDragMove(e.clientX, e.clientY);
+        });
+
+        window.addEventListener('mouseup', function () {
+          onDragEnd();
+        });
+
+        floatingEl.addEventListener('touchstart', function (e) {
+          if (e.touches.length !== 1) return;
+          const touch = e.touches[0];
+          if (onDragStart(touch.clientX, touch.clientY, e.target)) {
+            e.preventDefault();
+          }
+        }, { passive: false });
+
+        window.addEventListener('touchmove', function (e) {
+          if (!isDragging || e.touches.length !== 1) return;
+          const touch = e.touches[0];
+          onDragMove(touch.clientX, touch.clientY);
+        }, { passive: false });
+
+        window.addEventListener('touchend', function () {
+          onDragEnd();
+        });
+      }
+
+      // Keep within viewport on window resize
+      window.addEventListener('resize', function () {
+        if (floatingEl.style.left && floatingEl.style.top) {
+          const currentLeft = parseFloat(floatingEl.style.left);
+          const currentTop = parseFloat(floatingEl.style.top);
+          if (!isNaN(currentLeft) && !isNaN(currentTop)) {
+            applyPosition(currentLeft, currentTop);
+          }
+        }
+      });
+
+      if (resetBtn) {
+        resetBtn.addEventListener('click', function () {
+          floatingEl.style.left = '';
+          floatingEl.style.top = '';
+          floatingEl.style.right = '24px';
+          floatingEl.style.bottom = '24px';
+          try {
+            localStorage.removeItem(STORAGE_KEY);
+          } catch (e) {}
+        });
+      }
+    })();
+  </script>
 </body>
 
