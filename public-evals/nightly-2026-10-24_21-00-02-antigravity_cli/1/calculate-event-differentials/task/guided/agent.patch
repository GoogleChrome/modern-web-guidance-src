+  <script>
+    function initializeMapleOatCountdown() {
+      const remainingEl = document.getElementById('maple-oat-remaining');
+      const elapsedEl = document.getElementById('maple-oat-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      // Get the current time in the user's local system time zone
+      const now = Temporal.Now.zonedDateTimeISO();
+      const tz = now.timeZoneId;
+
+      // Combine separate date and time strings using Temporal methods
+      const startDateStr = '2026-02-01';
+      const startTimeStr = '00:00:00';
+      const endDateStr = '2026-03-01';
+      const endTimeStr = '00:00:00';
+
+      const start = Temporal.PlainDate.from(startDateStr).toPlainDateTime(startTimeStr).toZonedDateTime(tz);
+      const end = Temporal.PlainDate.from(endDateStr).toPlainDateTime(endTimeStr).toZonedDateTime(tz);
+
+      // Calculate elapsed and remaining durations balanced to days and hours
+      const timeElapsed = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      // Format durations with .toLocaleString() (Intl.DurationFormat) for human display
+      // and .toString() for machine-readable ISO 8601 <time datetime="..."> attributes
+      if (timeRemaining.sign <= 0) {
+        const zeroDuration = Temporal.Duration.from({ days: 0, hours: 0 });
+        remainingEl.textContent = `${zeroDuration.toLocaleString(undefined, { style: 'long', daysDisplay: 'always', hoursDisplay: 'always' })} (Offer ended)`;
+        remainingEl.setAttribute('datetime', zeroDuration.toString());
+      } else {
+        remainingEl.textContent = timeRemaining.toLocaleString(undefined, { style: 'long' });
+        remainingEl.setAttribute('datetime', timeRemaining.toString());
+      }
+
+      if (timeElapsed.sign < 0) {
+        const zeroElapsed = Temporal.Duration.from({ days: 0, hours: 0 });
+        elapsedEl.textContent = zeroElapsed.toLocaleString(undefined, { style: 'long', daysDisplay: 'always', hoursDisplay: 'always' });
+        elapsedEl.setAttribute('datetime', zeroElapsed.toString());
+      } else {
+        elapsedEl.textContent = timeElapsed.toLocaleString(undefined, { style: 'long' });
+        elapsedEl.setAttribute('datetime', timeElapsed.toString());
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initializeMapleOatCountdown);
+      } else {
+        initializeMapleOatCountdown();
+      }
+    })();
+  </script>
+
