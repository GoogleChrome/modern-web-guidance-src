+  <script>
+    function updateMapleOatTimer() {
+      const remainingEl = document.getElementById('countdown-remaining');
+      const elapsedEl = document.getElementById('countdown-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      const userTimeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(userTimeZone);
+
+      const promoStart = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 2,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone
+      });
+
+      const promoEnd = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 3,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone
+      });
+
+      const durationFormatter = new Intl.DurationFormat(navigator.language || 'en-US', {
+        style: 'long'
+      });
+
+      if (Temporal.ZonedDateTime.compare(now, promoEnd) < 0) {
+        const remainingDuration = now.until(promoEnd, {
+          largestUnit: 'days',
+          smallestUnit: 'hours',
+          roundingMode: 'trunc'
+        });
+        remainingEl.textContent = `${ durationFormatter.format({
+          days: remainingDuration.days,
+          hours: remainingDuration.hours
+        }) } (${ remainingDuration.days } days, ${ remainingDuration.hours } hours left)`;
+      } else {
+        remainingEl.textContent = '0 days, 0 hours left (Offer has ended)';
+      }
+
+      if (Temporal.ZonedDateTime.compare(now, promoStart) >= 0) {
+        const elapsedDuration = now.since(promoStart, {
+          largestUnit: 'days',
+          smallestUnit: 'hours',
+          roundingMode: 'trunc'
+        });
+        elapsedEl.textContent = `${ durationFormatter.format({
+          days: elapsedDuration.days,
+          hours: elapsedDuration.hours
+        }) } (${ elapsedDuration.days } days, ${ elapsedDuration.hours } hours since start)`;
+      } else {
+        elapsedEl.textContent = '0 days, 0 hours (Promotion has not started yet)';
+      }
+    }
+
+    window.addEventListener('DOMContentLoaded', updateMapleOatTimer);
+  </script>
