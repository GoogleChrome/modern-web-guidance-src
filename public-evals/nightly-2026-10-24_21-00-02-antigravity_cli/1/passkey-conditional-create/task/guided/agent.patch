+  <script type="module">
+    const form = document.getElementById('signin-form');
+    const passwordInput = document.getElementById('password');
+    const togglePasswordBtn = document.getElementById('toggle-password');
+    const signinBtn = document.querySelector('[data-testid="signin-button"]');
+
+    // AbortController for any active autofill (conditional get) WebAuthn request
+    const loginAbortController = new AbortController();
+
+    if (togglePasswordBtn && passwordInput) {
+      togglePasswordBtn.addEventListener('click', () => {
+        const isPassword = passwordInput.type === 'password';
+        passwordInput.type = isPassword ? 'text' : 'password';
+        togglePasswordBtn.setAttribute('aria-pressed', String(isPassword));
+        togglePasswordBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
+        togglePasswordBtn.textContent = isPassword ? 'Hide' : 'Show';
+      });
+    }
+
+    async function triggerConditionalCreate() {
+      if (
+        typeof window.PublicKeyCredential === 'undefined' ||
+        typeof PublicKeyCredential.getClientCapabilities !== 'function'
+      ) {
+        return;
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (!capabilities || capabilities.conditionalCreate !== true) {
+          return;
+        }
+
+        // 1. Abort any active autofill conditional-get controllers to clear the WebAuthn pipeline
+        loginAbortController.abort();
+
+        // 2. Fetch creation options from POST /api/register/options
+        const optionsResponse = await fetch('/api/register/options', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ conditional: true })
+        });
+
+        if (!optionsResponse.ok) {
+          return;
+        }
+
+        const creationOptionsJSON = await optionsResponse.json();
+        const publicKey = typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function'
+          ? PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON)
+          : creationOptionsJSON;
+
+        const rpId = (publicKey && publicKey.rp && publicKey.rp.id) || window.location.hostname;
+
+        let credential;
+        try {
+          // 3. Invoke silent credentials creation with conditional mediation
+          credential = await navigator.credentials.create({
+            publicKey,
+            mediation: 'conditional'
+          });
+        } catch (err) {
+          // 4. Silently swallow common WebAuthn browser exceptions without showing UI
+          if (err && ['InvalidStateError', 'NotAllowedError', 'AbortError'].includes(err.name)) {
+            return;
+          }
+          return;
+        }
+
+        if (!credential) {
+          return;
+        }
+
+        // 5. Server verification step at POST /api/register/verify
+        const encodedResponse = typeof credential.toJSON === 'function'
+          ? credential.toJSON()
+          : credential;
+
+        try {
+          const verifyResponse = await fetch('/api/register/verify', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify(encodedResponse)
+          });
+
+          if (!verifyResponse.ok) {
+            if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+              await PublicKeyCredential.signalUnknownCredential({
+                rpId,
+                credentialId: encodedResponse.id
+              });
+            }
+          }
+        } catch (serverErr) {
+          if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+            await PublicKeyCredential.signalUnknownCredential({
+              rpId,
+              credentialId: encodedResponse.id
+            });
+          }
+        }
+      } catch (_) {
+        // Silently ignore any unexpected error in background passkey promotion
+      }
+    }
+
+    let isPromoting = false;
+
+    async function handleSignIn(e) {
+      if (e) {
+        e.preventDefault();
+      }
+      if (isPromoting) {
+        return;
+      }
+      isPromoting = true;
+      try {
+        await triggerConditionalCreate();
+      } finally {
+        isPromoting = false;
+      }
+    }
+
+    if (form) {
+      form.addEventListener('submit', handleSignIn);
+    }
+
+    if (signinBtn) {
+      signinBtn.addEventListener('click', handleSignIn);
+    }
+  </script>
