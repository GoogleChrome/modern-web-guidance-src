+      gap: 40px;
+      align-items: start;
+    }
+
+    #tracked {
+      display: flex;
+      flex-direction: column;
+      gap: 40vh;
+      padding-block: 20vh;
+
+      section:nth-child(1) { view-timeline: --tl-1 block; }
+      section:nth-child(2) { view-timeline: --tl-2 block; }
+      section:nth-child(3) { view-timeline: --tl-3 block; }
+      section:nth-child(4) { view-timeline: --tl-4 block; }
+      section:nth-child(5) { view-timeline: --tl-5 block; }
+    }
+
+    #tracked section {
+      background: white;
+      padding: 32px;
+      border-radius: 12px;
+      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
+      border-inline-start: 4px solid var(--accent);
+    }
+
+    #tracked section h3 {
+      color: var(--primary);
+      font-size: 1.5rem;
+      margin-block-end: 12px;
+    }
+
+    .step-badge {
+      display: inline-block;
+      background: var(--secondary);
+      color: var(--primary);
+      font-weight: bold;
+      font-size: 0.8rem;
+      padding: 4px 10px;
+      border-radius: 999px;
+      margin-block-end: 10px;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+    }
+
+    #animated {
+      position: sticky;
+      top: 100px;
+      display: grid;
+      grid-template-areas: "stack";
+      place-items: center;
+      min-block-size: 70vh;
+      perspective: 1000px;
+      overflow: hidden;
+    }
+
+    @keyframes animate-in {
+      from {
+        scale: 0.5;
+        opacity: 0;
+        transform: rotateY(-180deg);
+      }
+      to {
+        scale: 1;
+        opacity: 1;
+        transform: rotateY(0deg);
+      }
+    }
+
+    @keyframes animate-out {
+      to {
+        translate: 100% 0;
+        opacity: 0;
+      }
+    }
+
+    #animated section {
+      grid-area: stack;
+      width: 100%;
+      background: white;
+      border-radius: 16px;
+      overflow: hidden;
+      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
+      backface-visibility: hidden;
+    }
+
+    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
+      #animated {
+        section {
+          animation: animate-in auto linear both, animate-out auto linear forwards;
+          animation-range: entry 25% cover 50%, exit 50% exit 75%;
+          backface-visibility: hidden;
+        }
+
+        section:nth-child(1) { animation-timeline: --tl-1; }
+        section:nth-child(2) { animation-timeline: --tl-2; }
+        section:nth-child(3) { animation-timeline: --tl-3; }
+        section:nth-child(4) { animation-timeline: --tl-4; }
+        section:nth-child(5) { animation-timeline: --tl-5; }
+      }
+    }
+
+    #animated section img {
+      display: block;
+      width: 100%;
+      height: 340px;
+      object-fit: cover;
+    }
+
+    .animated-caption {
+      padding: 20px 24px;
+      text-align: center;
+    }
+
+    .animated-caption h4 {
+      color: var(--primary);
+      font-size: 1.25rem;
+      margin-block-end: 6px;
+    }
+
+    @media (max-width: 768px) {
+      .scrollytelling-layout {
+        grid-template-columns: 1fr;
+      }
+
+      #animated {
+        position: sticky;
+        top: 70px;
+        min-block-size: 45vh;
+        z-index: 10;
+      }
+
+      #animated section img {
+        height: 220px;
+      }
+    }
+
+    /* MANDATORY Copy-Paste Safety: Disable continuous storytelling motion for sensitive users */
+    @media (prefers-reduced-motion: reduce) {
+      #animated {
+        position: static;
+        display: flex;
+        flex-direction: column;
+        gap: 24px;
+      }
+
+      #animated section {
+        animation: none !important;
+        opacity: 1 !important;
+        transform: none !important;
+        translate: 0 0 !important;
+        scale: 1 !important;
+      }
+    }
+
