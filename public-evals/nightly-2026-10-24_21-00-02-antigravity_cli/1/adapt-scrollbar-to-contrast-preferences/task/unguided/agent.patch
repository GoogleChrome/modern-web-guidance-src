diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11,16 +11,107 @@
       --secondary: #d7ccc8;
       --accent: #ffab40;
       --text: #3e2723;
       --light: #fafafa;
+      --scrollbar-track: #d7ccc8;
+      --scrollbar-thumb: #3e2723;
+      --scrollbar-thumb-hover: #1b0f0d;
+      --scrollbar-border: #ffffff;
     }
 
     * {
       box-sizing: border-box;
       margin: 0;
       padding: 0;
+      scrollbar-width: auto;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
     }
 
+    /* High-visibility Custom Scrollbars */
+    ::-webkit-scrollbar {
+      width: 16px;
+      height: 16px;
+    }
+
+    ::-webkit-scrollbar-track {
+      background: var(--scrollbar-track);
+      border-left: 1px solid rgba(62, 39, 35, 0.25);
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background-color: var(--scrollbar-thumb);
+      border-radius: 8px;
+      border: 3px solid var(--scrollbar-track);
+      box-shadow: inset 0 0 0 1px var(--scrollbar-border);
+      min-height: 40px;
+    }
+
+    ::-webkit-scrollbar-thumb:hover {
+      background-color: var(--scrollbar-thumb-hover);
+    }
+
+    ::-webkit-scrollbar-thumb:active {
+      background-color: #000000;
+      border-color: var(--accent);
+    }
+
+    ::-webkit-scrollbar-corner {
+      background: var(--scrollbar-track);
+    }
+
+    /* Enhanced High Contrast & Forced Colors Support */
+    @media (prefers-contrast: more) {
+      :root {
+        --scrollbar-track: #ffffff;
+        --scrollbar-thumb: #000000;
+        --scrollbar-thumb-hover: #3e2723;
+      }
+
+      ::-webkit-scrollbar {
+        width: 18px;
+        height: 18px;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+        border: 2px solid #000000;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background-color: var(--scrollbar-thumb);
+        border: 2px solid #ffffff;
+        outline: 2px solid #000000;
+        border-radius: 0;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background-color: var(--accent);
+        border-color: #000000;
+      }
+    }
+
+    @media (forced-colors: active) {
+      * {
+        scrollbar-color: ButtonText Canvas;
+      }
+
+      ::-webkit-scrollbar-track {
+        background: Canvas;
+        border: 2px solid ButtonText;
+      }
+
+      ::-webkit-scrollbar-thumb {
+        background-color: ButtonText;
+        border: 2px solid Canvas;
+      }
+
+      ::-webkit-scrollbar-thumb:hover,
+      ::-webkit-scrollbar-thumb:active {
+        background-color: Highlight;
+      }
+    }
+
     body {
       font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
       line-height: 1.6;
       color: var(--text);
