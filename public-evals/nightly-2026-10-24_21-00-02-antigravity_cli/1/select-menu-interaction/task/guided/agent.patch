+  <script>
+    const orderForm = document.getElementById('order-form');
+    const orderStatus = document.getElementById('order-status');
+
+    // Sync aria-invalid with the CSS :user-invalid state
+    const syncAria = (el) => {
+      if (!el || !el.matches?.('input, textarea, select')) return;
+      if (el.matches(':user-invalid')) {
+        el.setAttribute('aria-invalid', 'true');
+      } else {
+        el.removeAttribute('aria-invalid');
+      }
+    };
+
+    // Update on blur/focus (capture phase) and input/change (to clear it immediately)
+    document.addEventListener('blur', (e) => syncAria(e.target), true);
+    document.addEventListener('focus', (e) => syncAria(e.target), true);
+    document.addEventListener('input', (e) => {
+      if (e.target.hasAttribute?.('aria-invalid')) syncAria(e.target);
+    });
+    document.addEventListener('change', (e) => {
+      syncAria(e.target);
+    });
+
+    // Sync all required controls when submission is attempted
+    orderForm.addEventListener('invalid', (e) => {
+      syncAria(e.target);
+    }, true);
+
+    orderForm.addEventListener('submit', (e) => {
+      e.preventDefault();
+      const shopSelect = document.getElementById('local-shop');
+      syncAria(shopSelect);
+      if (orderForm.checkValidity()) {
+        const selectedOption = shopSelect.options[shopSelect.selectedIndex];
+        orderStatus.textContent = `Order started for ${selectedOption.text}.`;
+        orderStatus.classList.add('visible');
+      }
+    });
+  </script>
