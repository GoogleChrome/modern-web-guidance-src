+  <script>
+    (function () {
+      const form = document.getElementById('order-form');
+      const shopSelect = document.getElementById('local-shop');
+      const errorMsg = document.getElementById('local-shop-error');
+      const successMsg = document.getElementById('order-success');
+
+      if (!form || !shopSelect || !errorMsg) return;
+
+      let hasInteracted = false;
+
+      function updateValidationState() {
+        const isValid = shopSelect.checkValidity() && shopSelect.value.trim() !== '';
+
+        if (!hasInteracted) {
+          shopSelect.classList.remove('touched', 'is-invalid', 'is-valid');
+          shopSelect.setAttribute('aria-invalid', 'false');
+          errorMsg.classList.remove('visible');
+          errorMsg.setAttribute('aria-hidden', 'true');
+          return isValid;
+        }
+
+        shopSelect.classList.add('touched');
+
+        if (isValid) {
+          shopSelect.classList.remove('is-invalid');
+          shopSelect.classList.add('is-valid');
+          shopSelect.setAttribute('aria-invalid', 'false');
+          errorMsg.classList.remove('visible');
+          errorMsg.setAttribute('aria-hidden', 'true');
+        } else {
+          shopSelect.classList.remove('is-valid');
+          shopSelect.classList.add('is-invalid');
+          shopSelect.setAttribute('aria-invalid', 'true');
+          errorMsg.classList.add('visible');
+          errorMsg.setAttribute('aria-hidden', 'false');
+          if (successMsg) {
+            successMsg.classList.remove('visible');
+            successMsg.setAttribute('aria-hidden', 'true');
+          }
+        }
+
+        return isValid;
+      }
+
+      shopSelect.addEventListener('change', function () {
+        hasInteracted = true;
+        updateValidationState();
+      });
+
+      shopSelect.addEventListener('input', function () {
+        hasInteracted = true;
+        updateValidationState();
+      });
+
+      shopSelect.addEventListener('blur', function () {
+        hasInteracted = true;
+        updateValidationState();
+      });
+
+      shopSelect.addEventListener('invalid', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        form.classList.add('submitted');
+        updateValidationState();
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        hasInteracted = true;
+        form.classList.add('submitted');
+        const isValid = updateValidationState();
+
+        if (!isValid) {
+          shopSelect.focus();
+          return;
+        }
+
+        if (successMsg) {
+          const selectedOption = shopSelect.options[shopSelect.selectedIndex];
+          const shopName = selectedOption ? selectedOption.text : shopSelect.value;
+          successMsg.textContent = 'Order started for ' + shopName + '!';
+          successMsg.classList.add('visible');
+          successMsg.setAttribute('aria-hidden', 'false');
+        }
+      });
+    })();
+  </script>
