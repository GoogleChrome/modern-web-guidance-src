+        const elapsedMs = Math.round(performance.now() - startTime);
+        statusTextEl.textContent = `Completed ${totalBlends.toLocaleString()} blends in ${elapsedMs}ms across ${yieldSlices} main-thread yields.`;
+        isRunning = false;
+        runSimBtn.disabled = false;
+        cancelSimBtn.disabled = true;
+      }
+
+      runSimBtn.addEventListener('click', () => {
+        runBatchSimulation();
+      });
+
+      cancelSimBtn.addEventListener('click', () => {
+        if (!isRunning) return;
+        activeRunId++;
+        isRunning = false;
+        runSimBtn.disabled = false;
+        cancelSimBtn.disabled = true;
+        statusTextEl.textContent = 'Simulation paused / cancelled by user.';
+      });
+
+      // Run an initial warm-up batch automatically so results are populated on load
+      window.addEventListener('DOMContentLoaded', () => {
+        runBatchSimulation();
+      });
+    })();
+  </script>
 </body>
 
 </html>
