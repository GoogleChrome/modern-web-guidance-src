+
+      /**
+       * Yields control back to the browser main thread so rendering, input events,
+       * and animations stay responsive during large batch computations.
+       */
+      function yieldToMain() {
+        if (typeof globalThis.scheduler !== 'undefined' && typeof globalThis.scheduler.yield === 'function') {
+          return globalThis.scheduler.yield();
+        }
+        return new Promise((resolve) => {
+          if (typeof MessageChannel !== 'undefined') {
+            const channel = new MessageChannel();
+            channel.port1.onmessage = () => resolve();
+            channel.port2.postMessage(null);
+          } else {
+            setTimeout(resolve, 0);
+          }
+        });
+      }
+
+      /**
+       * Simulates complex thermodynamic & extraction kinetics for a single recipe blend.
+       */
+      function evaluateSingleBlend(index, roastTemp, grindLevel, targetProfile) {
+        const originA = ORIGINS[index % ORIGINS.length];
+        const originB = ORIGINS[(index * 7 + 3) % ORIGINS.length];
+        const originC = ORIGINS[(index * 13 + 5) % ORIGINS.length];
+
+        const ratioA = 0.45 + ((index % 17) - 8) * 0.015;
+        const ratioB = 0.35 + ((index % 11) - 5) * 0.015;
+        const ratioC = Math.max(0.05, 1 - ratioA - ratioB);
+
+        // Multi-step iterative extraction curve modeling
+        let extractionYield = 0;
+        let maillardFactor = 0;
+        let volatileRetention = 0;
+        const tempNormalized = (roastTemp - 185) / 45;
+        const grindNormalized = grindLevel / 10;
+
+        for (let step = 1; step <= 40; step++) {
+          const t = step / 40;
+          const diffusion = Math.sin(t * Math.PI * (0.8 + grindNormalized * 0.4)) * Math.exp(-t * 0.45);
+          const thermal = Math.cos(tempNormalized * t * 1.7) * (1 - 0.25 * tempNormalized);
+          extractionYield += diffusion * (1 + 0.2 * grindNormalized);
+          maillardFactor += (1 - thermal) * (0.6 + tempNormalized * 0.5);
+          volatileRetention += Math.atan(diffusion + thermal) * 0.35;
+        }
+
+        const normYield = Math.min(1.2, Math.max(0.7, extractionYield / 18));
+        const normMaillard = Math.min(1.3, Math.max(0.6, maillardFactor / 16));
+        const normVolatile = Math.min(1.25, Math.max(0.65, volatileRetention / 12));
+
+        const baseAcidity = originA.acidity * ratioA + originB.acidity * ratioB + originC.acidity * ratioC;
+        const baseBody = originA.body * ratioA + originB.body * ratioB + originC.body * ratioC;
+        const baseSweetness = originA.sweetness * ratioA + originB.sweetness * ratioB + originC.sweetness * ratioC;
+        const baseBitterness = originA.bitterness * ratioA + originB.bitterness * ratioB + originC.bitterness * ratioC;
+        const baseAroma = originA.aroma * ratioA + originB.aroma * ratioB + originC.aroma * ratioC;
+
+        const acidity = Math.min(99, Math.max(15, baseAcidity * (1.15 - tempNormalized * 0.35) * normVolatile));
+        const body = Math.min(99, Math.max(20, baseBody * (0.88 + tempNormalized * 0.24 + grindNormalized * 0.12) * normYield));
+        const sweetness = Math.min(99, Math.max(20, baseSweetness * (1.08 - Math.abs(tempNormalized - 0.48) * 0.45) * normMaillard));
+        const bitterness = Math.min(99, Math.max(10, baseBitterness * (0.7 + tempNormalized * 0.55 + grindNormalized * 0.2)));
+        const aroma = Math.min(99, Math.max(20, baseAroma * normVolatile * (1.05 - Math.abs(grindNormalized - 0.6) * 0.2)));
+
+        let cuppingScore = 0;
+        if (targetProfile === 'bright') {
+          cuppingScore = acidity * 0.36 + aroma * 0.3 + sweetness * 0.22 + body * 0.12 - bitterness * 0.12;
+        } else if (targetProfile === 'bold') {
+          cuppingScore = body * 0.38 + bitterness * 0.22 + sweetness * 0.2 + aroma * 0.2 - acidity * 0.08;
+        } else if (targetProfile === 'velvet') {
+          cuppingScore = body * 0.34 + sweetness * 0.34 + aroma * 0.22 + acidity * 0.1 - bitterness * 0.1;
+        } else {
+          cuppingScore = sweetness * 0.3 + aroma * 0.26 + body * 0.24 + acidity * 0.2 - Math.abs(bitterness - 42) * 0.15;
+        }
+
+        cuppingScore = Math.min(98.9, Math.max(65.0, cuppingScore + 12));
+
+        return {
+          id: index + 1,
+          name: `${originA.name.split(' ')[0]} / ${originB.name.split(' ')[0]} #${index + 1}`,
+          ratios: `${Math.round(ratioA * 100)}% ${originA.name}, ${Math.round(ratioB * 100)}% ${originB.name}, ${Math.round(ratioC * 100)}% ${originC.name}`,
+          acidity,
+          body,
+          sweetness,
+          bitterness,
+          aroma,
+          score: cuppingScore
+        };
+      }
+
+      function updateFlavorBars(totals, count) {
+        if (count === 0) return;
+        const metrics = ['acidity', 'body', 'sweetness', 'bitterness', 'aroma'];
+        for (const key of metrics) {
+          const avg = Math.round(totals[key] / count);
+          document.getElementById(`val-${key}`).textContent = `${avg} / 100`;
+          document.getElementById(`bar-${key}`).style.width = `${avg}%`;
+        }
+      }
+
