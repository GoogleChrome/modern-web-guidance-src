+  <script type="module">
+    const ORIGINS = [
+      { name: 'Ethiopian Yirgacheffe', acidity: 92, body: 55, sweetness: 85, bitterness: 30, aroma: 95, note: 'Bergamot & Jasmine' },
+      { name: 'Colombian Huila', acidity: 74, body: 76, sweetness: 84, bitterness: 45, aroma: 82, note: 'Brown Sugar & Fig' },
+      { name: 'Sumatra Mandheling', acidity: 38, body: 94, sweetness: 62, bitterness: 78, aroma: 75, note: 'Dark Chocolate' },
+      { name: 'Guatemalan Antigua', acidity: 68, body: 80, sweetness: 78, bitterness: 52, aroma: 84, note: 'Toasted Hazelnut' },
+      { name: 'Kenyan AA', acidity: 90, body: 68, sweetness: 79, bitterness: 40, aroma: 91, note: 'Blood Orange' },
+      { name: 'Brazilian Cerrado', acidity: 48, body: 86, sweetness: 80, bitterness: 64, aroma: 72, note: 'Toasted Hazelnut' }
+    ];
+
+    const TARGET_PROFILES = {
+      balanced: { acidity: 65, body: 78, sweetness: 82, bitterness: 50, aroma: 82 },
+      bright: { acidity: 90, body: 60, sweetness: 80, bitterness: 32, aroma: 92 },
+      bold: { acidity: 42, body: 92, sweetness: 68, bitterness: 76, aroma: 78 },
+      floral: { acidity: 84, body: 62, sweetness: 88, bitterness: 35, aroma: 95 }
+    };
+
+    const BREW_MODIFIERS = {
+      espresso: { acidity: 0.95, body: 1.15, sweetness: 1.05, bitterness: 1.12, aroma: 1.08 },
+      pourover: { acidity: 1.12, body: 0.88, sweetness: 1.06, bitterness: 0.85, aroma: 1.14 },
+      immersion: { acidity: 0.78, body: 1.08, sweetness: 1.15, bitterness: 0.75, aroma: 0.96 },
+      frenchpress: { acidity: 0.9, body: 1.18, sweetness: 0.98, bitterness: 1.06, aroma: 1.0 }
+    };
+
+    const roastTempInput = document.getElementById('roast-temperature');
+    const roastTempVal = document.getElementById('roast-temp-val');
+    const targetProfileSelect = document.getElementById('target-profile');
+    const brewMethodSelect = document.getElementById('brew-method');
+    const batchSizeSelect = document.getElementById('batch-size');
+    const runBtn = document.getElementById('run-simulation-btn');
+    const filterSelect = document.getElementById('tasting-notes-filter');
+
+    const statusEl = document.getElementById('simulation-status');
+    const percentEl = document.getElementById('simulation-percent');
+    const progressBar = document.getElementById('simulation-progressbar');
+    const progressFill = document.getElementById('simulation-progress-fill');
+    const metricProcessed = document.getElementById('metric-processed');
+    const metricYields = document.getElementById('metric-yields');
+    const metricElapsed = document.getElementById('metric-elapsed');
+    const resultsContainer = document.getElementById('simulation-results');
+
+    let lastSimulatedResults = [];
+
+    roastTempInput.addEventListener('input', () => {
+      roastTempVal.textContent = `${roastTempInput.value}°C`;
+    });
+
+    filterSelect.addEventListener('change', () => {
+      renderTopBlends(lastSimulatedResults, filterSelect.value);
+    });
+
+    function generateRecipeBatch(count) {
+      const batch = [];
+      for (let i = 0; i < count; i++) {
+        const primaryIdx = i % ORIGINS.length;
+        const secondaryIdx = (i * 3 + 1) % ORIGINS.length;
+        const tertiaryIdx = (i * 7 + 2) % ORIGINS.length;
+
+        const r1 = 40 + ((i * 17) % 35);
+        const r2 = 15 + ((i * 23) % (85 - r1));
+        const r3 = 100 - r1 - r2;
+
+        batch.push({
+          id: i + 1,
+          name: `Blend #${String(i + 1).padStart(4, '0')}`,
+          components: [
+            { origin: ORIGINS[primaryIdx], ratio: r1 },
+            { origin: ORIGINS[secondaryIdx], ratio: r2 },
+            { origin: ORIGINS[tertiaryIdx], ratio: r3 }
+          ],
+          roastDurationSec: 540 + ((i * 13) % 240)
+        });
+      }
+      return batch;
+    }
+
+    function simulateSingleBlend(blend, config) {
+      const { target, brewMod, roastTemp } = config;
+      const tempDelta = (roastTemp - 210) / 25;
+
+      let acidity = 0;
+      let body = 0;
+      let sweetness = 0;
+      let bitterness = 0;
+      let aroma = 0;
+
+      for (const comp of blend.components) {
+        const weight = comp.ratio / 100;
+        acidity += comp.origin.acidity * weight;
+        body += comp.origin.body * weight;
+        sweetness += comp.origin.sweetness * weight;
+        bitterness += comp.origin.bitterness * weight;
+        aroma += comp.origin.aroma * weight;
+      }
+
+      // Multi-step thermal Maillard & caramelization curve simulation
+      let thermalFactor = 1.0;
+      const steps = 1200;
+      for (let step = 0; step < steps; step++) {
+        const progress = step / steps;
+        const curve = Math.sin(progress * Math.PI) * Math.cos(progress * 0.5) * (1 + tempDelta * 0.25);
+        thermalFactor += (curve - 0.35) * 0.0003;
+      }
+
+      const clamp = (val) => Math.max(0, Math.min(100, Math.round(val)));
+
+      const finalProfile = {
+        acidity: clamp(acidity * (1 - tempDelta * 0.18) * brewMod.acidity * thermalFactor),
+        body: clamp(body * (1 + tempDelta * 0.14) * brewMod.body * thermalFactor),
+        sweetness: clamp(sweetness * (1 - Math.abs(tempDelta) * 0.1) * brewMod.sweetness),
+        bitterness: clamp(bitterness * (1 + tempDelta * 0.28) * brewMod.bitterness),
+        aroma: clamp(aroma * (1 - Math.max(0, tempDelta - 0.3) * 0.15) * brewMod.aroma)
+      };
+
+      const diffSq =
+        Math.pow(finalProfile.acidity - target.acidity, 2) +
+        Math.pow(finalProfile.body - target.body, 2) +
+        Math.pow(finalProfile.sweetness - target.sweetness, 2) +
+        Math.pow(finalProfile.bitterness - target.bitterness, 2) +
+        Math.pow(finalProfile.aroma - target.aroma, 2);
+
+      const rmsError = Math.sqrt(diffSq / 5);
+      const matchScore = Math.max(0, Math.min(99.9, Number((100 - rmsError * 1.15).toFixed(1))));
+
+      const sortedComponents = [...blend.components].sort((a, b) => b.ratio - a.ratio);
+      const dominantNote = sortedComponents[0].origin.note;
+
+      return {
+        id: blend.id,
+        name: blend.name,
+        components: sortedComponents,
+        profile: finalProfile,
+        matchScore,
+        dominantNote
+      };
+    }
+
+    function updateProgressUI(processed, total, yieldCount, elapsedMs, statusText) {
+      const pct = total > 0 ? Math.round((processed / total) * 100) : 0;
+      statusEl.textContent = statusText;
+      percentEl.textContent = `${pct}%`;
+      progressBar.setAttribute('aria-valuenow', String(pct));
+      progressFill.style.width = `${pct}%`;
+      metricProcessed.textContent = `${processed.toLocaleString()} / ${total.toLocaleString()}`;
+      metricYields.textContent = String(yieldCount);
+      metricElapsed.textContent = `${Math.round(elapsedMs)} ms`;
+    }
+
+    function renderTopBlends(results, filterNote) {
+      resultsContainer.innerHTML = '';
+      const filtered = filterNote === 'all'
+        ? results
+        : results.filter((item) => item.dominantNote === filterNote);
+
+      const topBlends = filtered.slice(0, 6);
+
+      if (topBlends.length === 0) {
+        const emptyMsg = document.createElement('p');
+        emptyMsg.textContent = 'No simulated blends match the selected tasting note filter.';
+        resultsContainer.appendChild(emptyMsg);
+        return;
+      }
+
+      const fragment = document.createDocumentFragment();
+
+      for (const item of topBlends) {
+        const card = document.createElement('article');
+        card.className = 'blend-card';
+
+        const compositionSummary = item.components
+          .map((c) => `${c.ratio}% ${c.origin.name}`)
+          .join(' • ');
+
+        const metrics = [
+          ['Acidity', item.profile.acidity],
+          ['Body', item.profile.body],
+          ['Sweetness', item.profile.sweetness],
+          ['Bitterness', item.profile.bitterness],
+          ['Aroma', item.profile.aroma]
+        ];
+
+        const barsHtml = metrics
+          .map(
+            ([label, value]) => `
+            <div class="flavor-bar-row">
+              <span>${label}</span>
+              <div class="flavor-bar-bg">
+                <div class="flavor-bar-val" style="width: ${value}%"></div>
+              </div>
+              <span>${value}</span>
+            </div>`
+          )
+          .join('');
+
+        card.innerHTML = `
+          <div class="blend-card-header">
+            <h3>${item.name}</h3>
+            <span class="match-badge">${item.matchScore}% Match</span>
+          </div>
+          <p class="blend-composition"><strong>Origins:</strong> ${compositionSummary}</p>
+          <p class="blend-composition"><strong>Primary Note:</strong> ${item.dominantNote}</p>
+          <div class="flavor-bars">${barsHtml}</div>
+        `;
+
+        fragment.appendChild(card);
+      }
+
+      resultsContainer.appendChild(fragment);
+    }
+
+    async function processRecipeBatchWithYielding(blends, config) {
+      const startTime = performance.now();
+      let deadline = performance.now() + 50;
+      let yieldCount = 0;
+      let processedCount = 0;
+      const simulated = [];
+
+      for (const blend of blends) {
+        simulated.push(simulateSingleBlend(blend, config));
+        processedCount++;
+
+        if (performance.now() >= deadline) {
+          yieldCount++;
+          updateProgressUI(
+            processedCount,
+            blends.length,
+            yieldCount,
+            performance.now() - startTime,
+            `Simulating flavor chemistry (${processedCount.toLocaleString()} of ${blends.length.toLocaleString()})...`
+          );
+
+          if ('scheduler' in window && 'yield' in window.scheduler) {
+            await scheduler.yield();
+          } else {
+            await new Promise((resolve) => setTimeout(resolve, 0));
+          }
+          deadline = performance.now() + 50;
+        }
+      }
+
+      simulated.sort((a, b) => b.matchScore - a.matchScore);
+
+      const totalElapsed = performance.now() - startTime;
+      updateProgressUI(
+        processedCount,
+        blends.length,
+        yieldCount,
+        totalElapsed,
+        `Simulation complete! Top matching blends ranked out of ${blends.length.toLocaleString()} candidates.`
+      );
+
+      return simulated;
+    }
+
+    async function handleRunSimulation() {
+      runBtn.disabled = true;
+      const batchSize = Number(batchSizeSelect.value) || 6000;
+      const config = {
+        target: TARGET_PROFILES[targetProfileSelect.value] || TARGET_PROFILES.balanced,
+        brewMod: BREW_MODIFIERS[brewMethodSelect.value] || BREW_MODIFIERS.espresso,
+        roastTemp: Number(roastTempInput.value) || 215
+      };
+
+      const blends = generateRecipeBatch(batchSize);
+      updateProgressUI(0, blends.length, 0, 0, 'Starting batch flavor simulation...');
+
+      try {
+        lastSimulatedResults = await processRecipeBatchWithYielding(blends, config);
+        renderTopBlends(lastSimulatedResults, filterSelect.value);
+      } finally {
+        runBtn.disabled = false;
+      }
+    }
+
+    runBtn.addEventListener('click', handleRunSimulation);
+
+    // Run an initial simulation automatically on load so top blends are immediately visible
+    handleRunSimulation();
+  </script>
 </body>
 
