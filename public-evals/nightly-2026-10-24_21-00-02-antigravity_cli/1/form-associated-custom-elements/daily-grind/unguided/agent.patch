+              color: #ffab40;
+            }
+            .bean-btn:disabled {
+              cursor: not-allowed;
+              opacity: 0.6;
+            }
+            .rating-status {
+              font-size: 0.9rem;
+              color: #5d4037;
+              margin-left: 8px;
+              font-weight: 500;
+            }
+          </style>
+          <div class="rating-wrap" role="group" aria-label="Bean Rating">
+            ${[1, 2, 3, 4, 5].map(n => `
+              <button type="button" class="bean-btn" data-value="${n}" aria-label="${n} Beans">${n}</button>
+            `).join('')}
+            <span class="rating-status"></span>
+          </div>
+        `;
+
+        this.shadowRoot.querySelectorAll('.bean-btn').forEach(btn => {
+          btn.addEventListener('click', () => {
+            this._selectRating(btn.dataset.value);
+          });
+        });
+      }
+    }
+
+    customElements.define('roast-selector', RoastSelector);
+    customElements.define('coffee-rating', CoffeeRating);
+
+    // Interactive Form Wiring
+    const form = document.getElementById('order-form');
+    const fieldset = document.getElementById('order-fieldset');
+    const roastControl = document.getElementById('roast-level');
+    const ratingControl = document.getElementById('bean-rating');
+    const outputBox = document.getElementById('submission-output');
+    const toggleDisableBtn = document.getElementById('toggle-disable-btn');
+    const clearRoastBtn = document.getElementById('clear-roast-btn');
+    const restoreStateBtn = document.getElementById('restore-state-btn');
+
+    form.addEventListener('submit', (e) => {
+      e.preventDefault();
+      if (!form.reportValidity()) {
+        return;
+      }
+      const formData = new FormData(form);
+      const payload = Object.fromEntries(formData.entries());
+      outputBox.textContent = `Submitted FormData: ${JSON.stringify(payload)}`;
+      outputBox.classList.add('visible');
+    });
+
+    form.addEventListener('reset', () => {
+      outputBox.textContent = 'Form reset to default values.';
+      outputBox.classList.add('visible');
+    });
+
+    toggleDisableBtn.addEventListener('click', () => {
+      fieldset.disabled = !fieldset.disabled;
+      toggleDisableBtn.textContent = fieldset.disabled ? 'Enable Controls' : 'Toggle Disabled';
+    });
+
+    clearRoastBtn.addEventListener('click', () => {
+      roastControl.value = '';
+      outputBox.textContent = `Cleared selection. Valid: ${roastControl.checkValidity()} (${roastControl.validationMessage})`;
+      outputBox.classList.add('visible');
+    });
+
+    restoreStateBtn.addEventListener('click', () => {
+      roastControl.formStateRestoreCallback('dark', 'restore');
+      ratingControl.formStateRestoreCallback('5', 'restore');
+      outputBox.textContent = 'Restored session state: roastLevel="dark", beanRating="5".';
+      outputBox.classList.add('visible');
+    });
+  </script>
+
 </body>
 
