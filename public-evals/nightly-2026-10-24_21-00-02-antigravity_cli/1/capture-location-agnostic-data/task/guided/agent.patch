+  <script>
+    function initializeApp() {
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+
+      const displayPickupTime = document.getElementById('display-pickup-time');
+      const displayAnniversaryDate = document.getElementById('display-anniversary-date');
+      const displayAnnualMilestone = document.getElementById('display-annual-milestone');
+      const displayAnniversaryAppointment = document.getElementById('display-anniversary-appointment');
+      const anniversaryStatusBadge = document.getElementById('anniversary-status-badge');
+
+      const STORAGE_TIME_KEY = 'dailyGrind_pickupReminderTime';
+      const STORAGE_DATE_KEY = 'dailyGrind_coffeeAnniversaryDate';
+
+      // Restore saved ISO plain strings if available
+      const savedTimeStr = localStorage.getItem(STORAGE_TIME_KEY);
+      const savedDateStr = localStorage.getItem(STORAGE_DATE_KEY);
+
+      if (savedTimeStr) {
+        timeInput.value = savedTimeStr;
+      }
+      if (savedDateStr) {
+        dateInput.value = savedDateStr;
+      }
+
+      function renderSchedule(rawDate, rawTime) {
+        if (!rawDate || !rawTime) return;
+
+        // Parse location-agnostic calendar date and wall-clock time via Temporal Plain types
+        const anniversaryDate = Temporal.PlainDate.from(rawDate);
+        const reminderTime = Temporal.PlainTime.from(rawTime);
+
+        // Combine into a location-agnostic PlainDateTime without binding to a time zone
+        const localAppointment = anniversaryDate.toPlainDateTime(reminderTime);
+
+        // Read calendar fields directly from the PlainDate without formatToParts()
+        const { year, month, day } = anniversaryDate;
+
+        // Construct PlainMonthDay for the recurring annual anniversary with explicit iso8601 calendar
+        const annualAnniversary = Temporal.PlainMonthDay.from({
+          month,
+          day,
+          calendar: 'iso8601',
+        });
+
+        const today = Temporal.Now.plainDateISO();
+        const isTodayAnniversary = annualAnniversary.equals(today.toPlainMonthDay());
+
+        // Convert PlainMonthDay to a PlainDate with a specific year before date arithmetic
+        const occurrenceThisYear = annualAnniversary.toPlainDate({ year: today.year });
+        const nextYearOccurrence = occurrenceThisYear.add({ years: 1 }, { overflow: 'constrain' });
+
+        // Format and display without time zone conversion
+        displayPickupTime.textContent = `${reminderTime.toLocaleString()} (${reminderTime.toString().slice(0, 5)})`;
+        displayAnniversaryDate.textContent = `${anniversaryDate.toLocaleString()} (${anniversaryDate.toString()})`;
+        displayAnnualMilestone.textContent = `${annualAnniversary.toLocaleString()} — Next: ${
+           Temporal.PlainDate.compare(occurrenceThisYear, today) >= 0
+            ? occurrenceThisYear.toString()
+            : nextYearOccurrence.toString()
+        }`;
+        displayAnniversaryAppointment.textContent = localAppointment.toString();
+
+        anniversaryStatusBadge.hidden = !isTodayAnniversary;
+
+        // Persist plain ISO representations so traveling across time zones never shifts values
+        localStorage.setItem(STORAGE_TIME_KEY, reminderTime.toString().slice(0, 5));
+        localStorage.setItem(STORAGE_DATE_KEY, anniversaryDate.toString());
+      }
+
+      // Clear custom validity on active input
+      [timeInput, dateInput].forEach((input) => {
+        input.addEventListener('input', () => {
+          input.setCustomValidity('');
+        });
+        input.addEventListener('blur', () => {
+          if (input.checkValidity()) {
+            renderSchedule(dateInput.value, timeInput.value);
+          }
+        });
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        if (form.checkValidity()) {
+          renderSchedule(dateInput.value, timeInput.value);
+        }
+      });
+
+      renderSchedule(dateInput.value, timeInput.value);
+    }
+
+    // Check if Temporal is supported natively; load temporal-polyfill conditionally
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
+
 </body>
 
