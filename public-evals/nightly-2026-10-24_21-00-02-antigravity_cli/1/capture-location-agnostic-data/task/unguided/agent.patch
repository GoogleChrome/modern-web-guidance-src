+  <script>
+    (function () {
+      const STORAGE_KEY_TIME = 'dailyGrind_pickupReminderTime';
+      const STORAGE_KEY_DATE = 'dailyGrind_coffeeAnniversaryDate';
+
+      const MONTHS = [
+        'January', 'February', 'March', 'April', 'May', 'June',
+        'July', 'August', 'September', 'October', 'November', 'December'
+      ];
+
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const timeDisplay = document.getElementById('pickup-time-display');
+      const dateDisplay = document.getElementById('anniversary-date-display');
+      const form = document.getElementById('coffee-preferences-form');
+      const saveStatus = document.getElementById('preferences-save-status');
+
+      /**
+       * Formats an ISO wall-clock time string ("HH:MM") purely via string parsing.
+       * Avoids Date object instantiation or UTC conversions so time zones never shift the value.
+       */
+      function formatWallClockTime(rawTime) {
+        if (!rawTime || typeof rawTime !== 'string') return 'Not set';
+        const parts = rawTime.trim().split(':');
+        if (parts.length < 2) return rawTime;
+
+        const hours24 = parseInt(parts[0], 10);
+        const minutes = parts[1];
+        if (isNaN(hours24)) return rawTime;
+
+        const period = hours24 >= 12 ? 'PM' : 'AM';
+        const hours12 = hours24 % 12 === 0 ? 12 : hours24 % 12;
+        const normalized24 = String(hours24).padStart(2, '0') + ':' + minutes;
+
+        return `${hours12}:${minutes} ${period} (${normalized24})`;
+      }
+
+      /**
+       * Formats an ISO calendar date string ("YYYY-MM-DD") purely via string parsing.
+       * Avoids new Date("YYYY-MM-DD") which parses as UTC midnight and shifts backward in western time zones.
+       */
+      function formatCalendarDate(rawDate) {
+        if (!rawDate || typeof rawDate !== 'string') return 'Not set';
+        const parts = rawDate.trim().split('-');
+        if (parts.length !== 3) return rawDate;
+
+        const year = parts[0];
+        const monthIndex = parseInt(parts[1], 10) - 1;
+        const day = parseInt(parts[2], 10);
+
+        if (isNaN(monthIndex) || monthIndex < 0 || monthIndex > 11 || isNaN(day)) {
+          return rawDate;
+        }
+
+        return `${MONTHS[monthIndex]} ${day}, ${year} (${rawDate.trim()})`;
+      }
+
+      function updateDisplayAndStorage(showSavedMessage) {
+        const rawTime = timeInput.value;
+        const rawDate = dateInput.value;
+
+        if (rawTime) {
+          localStorage.setItem(STORAGE_KEY_TIME, rawTime);
+          timeDisplay.textContent = formatWallClockTime(rawTime);
+        }
+
+        if (rawDate) {
+          localStorage.setItem(STORAGE_KEY_DATE, rawDate);
+          dateDisplay.textContent = formatCalendarDate(rawDate);
+        }
+
+        if (showSavedMessage) {
+          saveStatus.textContent = 'Preferences saved! Your schedule remains locked to ' +
+            rawTime + ' and ' + rawDate + ' across all time zones.';
+        }
+      }
+
+      function initPreferences() {
+        const savedTime = localStorage.getItem(STORAGE_KEY_TIME);
+        const savedDate = localStorage.getItem(STORAGE_KEY_DATE);
+
+        if (savedTime) {
+          timeInput.value = savedTime;
+        } else {
+          localStorage.setItem(STORAGE_KEY_TIME, timeInput.value);
+        }
+
+        if (savedDate) {
+          dateInput.value = savedDate;
+        } else {
+          localStorage.setItem(STORAGE_KEY_DATE, dateInput.value);
+        }
+
+        timeDisplay.textContent = formatWallClockTime(timeInput.value);
+        dateDisplay.textContent = formatCalendarDate(dateInput.value);
+      }
+
+      timeInput.addEventListener('input', function () {
+        saveStatus.textContent = '';
+        updateDisplayAndStorage(false);
+      });
+
+      timeInput.addEventListener('change', function () {
+        updateDisplayAndStorage(true);
+      });
+
+      dateInput.addEventListener('input', function () {
+        saveStatus.textContent = '';
+        updateDisplayAndStorage(false);
+      });
+
+      dateInput.addEventListener('change', function () {
+        updateDisplayAndStorage(true);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        updateDisplayAndStorage(true);
+      });
+
+      initPreferences();
+    })();
+  </script>
 </body>
 
