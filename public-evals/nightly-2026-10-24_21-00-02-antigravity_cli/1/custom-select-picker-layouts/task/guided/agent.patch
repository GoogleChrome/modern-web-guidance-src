+  <script>
+    document.addEventListener("DOMContentLoaded", () => {
+      const roastSelect = document.getElementById("roast-picker");
+      if (!roastSelect || !CSS.supports("appearance", "base-select")) return;
+
+      // Enable spatial Left/Right keyboard navigation across the 3-column grid picker
+      roastSelect.addEventListener("keydown", (e) => {
+        if (!roastSelect.matches(":open")) return;
+        if (!["ArrowLeft", "ArrowRight"].includes(e.key)) return;
+
+        const options = Array.from(roastSelect.querySelectorAll("option"));
+        const current = document.activeElement?.tagName === "OPTION"
+          ? document.activeElement
+          : roastSelect.selectedOptions[0] || options[0];
+        if (!current) return;
+
+        const currentRect = current.getBoundingClientRect();
+        const isRight = e.key === "ArrowRight";
+
+        const candidates = options
+          .filter((opt) => {
+            if (opt === current) return false;
+            const rect = opt.getBoundingClientRect();
+            return isRight ? rect.left > currentRect.left : rect.left < currentRect.left;
+          })
+          .sort((a, b) => {
+            const distA = Math.abs(a.getBoundingClientRect().left - currentRect.left);
+            const distB = Math.abs(b.getBoundingClientRect().left - currentRect.left);
+            return distA - distB;
+          });
+
+        if (candidates[0]) {
+          e.preventDefault();
+          candidates[0].focus();
+        }
+      });
+    });
+  </script>
