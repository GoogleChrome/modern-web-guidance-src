+  <script>
+    document.querySelectorAll('.sticky-container').forEach(container => {
+      const topOffset = parseFloat(getComputedStyle(container).top) || 0;
+
+      const observer = new IntersectionObserver(
+        ([e]) => {
+          const isStuck =
+            e.intersectionRatio < 1 &&
+            e.boundingClientRect.top <= topOffset + 1 &&
+            e.boundingClientRect.bottom > 0;
+          e.target.classList.toggle('is-stuck', isStuck);
+        },
+        {
+          root: null,
+          threshold: [1],
+          rootMargin: `-${topOffset + 1}px 0px 0px 0px`
+        }
+      );
+
+      observer.observe(container);
+    });
+  </script>
+
 </body>
 
