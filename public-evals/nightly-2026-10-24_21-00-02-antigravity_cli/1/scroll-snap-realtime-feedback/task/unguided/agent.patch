+  <script>
+    (function () {
+      const gallery = document.getElementById('gallery');
+      const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+      const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+      function getClosestIndex() {
+        const galleryRect = gallery.getBoundingClientRect();
+        const galleryCenter = galleryRect.left + galleryRect.width / 2;
+        let closestIndex = 0;
+        let minDistance = Infinity;
+
+        items.forEach((item, index) => {
+          const rect = item.getBoundingClientRect();
+          const itemCenter = rect.left + rect.width / 2;
+          const distance = Math.abs(itemCenter - galleryCenter);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestIndex = index;
+          }
+        });
+
+        return closestIndex;
+      }
+
+      function setPendingThumbnail(targetIndex) {
+        thumbnails.forEach((thumb, index) => {
+          thumb.classList.toggle('pending', index === targetIndex);
+        });
+      }
+
+      function setActiveThumbnail(activeIndex) {
+        thumbnails.forEach((thumb, index) => {
+          thumb.classList.remove('pending');
+          if (index === activeIndex) {
+            thumb.classList.add('active');
+            thumb.setAttribute('aria-current', 'true');
+          } else {
+            thumb.classList.remove('active');
+            thumb.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // Click a thumbnail to scroll its corresponding item into view
+      thumbnails.forEach((thumb, index) => {
+        thumb.addEventListener('click', () => {
+          if (items[index]) {
+            setPendingThumbnail(index);
+            items[index].scrollIntoView({
+              behavior: 'smooth',
+              block: 'nearest',
+              inline: 'center'
+            });
+          }
+        });
+      });
+
+      // Use native scrollsnapchanging when available for immediate snap target feedback
+      gallery.addEventListener('scrollsnapchanging', (event) => {
+        const targetIndex = items.indexOf(event.snapTargetInline);
+        if (targetIndex !== -1) {
+          setPendingThumbnail(targetIndex);
+        }
+      });
+
+      // Use native scrollsnapchange when available for finalized snap selection
+      gallery.addEventListener('scrollsnapchange', (event) => {
+        const activeIndex = items.indexOf(event.snapTargetInline);
+        if (activeIndex !== -1) {
+          setActiveThumbnail(activeIndex);
+        }
+      });
+
+      // Fallback & supplementary scroll/scrollend handling
+      let scrollTimeout = null;
+      const supportsScrollSnapChanging = 'onscrollsnapchanging' in gallery;
+      const supportsScrollEnd = 'onscrollend' in window;
+
+      gallery.addEventListener('scroll', () => {
+        if (!supportsScrollSnapChanging) {
+          const targetIndex = getClosestIndex();
+          setPendingThumbnail(targetIndex);
+        }
+
+        if (!supportsScrollEnd) {
+          clearTimeout(scrollTimeout);
+          scrollTimeout = setTimeout(() => {
+            setActiveThumbnail(getClosestIndex());
+          }, 150);
+        }
+      }, { passive: true });
+
+      gallery.addEventListener('scrollend', () => {
+        setActiveThumbnail(getClosestIndex());
+      });
+    })();
+  </script>
