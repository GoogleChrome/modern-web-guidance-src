+  <script>
+    (function () {
+      const panel = document.getElementById('seasonal-panel');
+      const tocLinks = document.querySelectorAll('.toc-sidebar a');
+      const headers = panel ? panel.querySelectorAll('.drink-section h3') : [];
+
+      if (!panel || !tocLinks.length || !headers.length) return;
+
+      function resolveTargetId(el) {
+        if (!el) return null;
+        if (el.matches && el.matches('.drink-section h3') && el.id) {
+          return el.id;
+        }
+        const heading = el.querySelector ? el.querySelector('h3[id]') : null;
+        if (heading) return heading.id;
+        return el.id ? el.id.replace(/-section$/, '') : null;
+      }
+
+      function setActiveLink(targetId) {
+        if (!targetId) return;
+        tocLinks.forEach((link) => {
+          const href = link.getAttribute('href');
+          const isMatch = href === `#${targetId}` || href === `#${targetId}-section`;
+          link.classList.toggle('active', isMatch);
+          link.classList.toggle(':target-current', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'location');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+      }
+
+      // 1. Native Scroll Snap Event (scrollsnapchange)
+      panel.addEventListener('scrollsnapchange', (event) => {
+        const snappedTarget = event.snapTargetBlock;
+        const targetId = resolveTargetId(snappedTarget);
+        if (targetId) {
+          setActiveLink(targetId);
+        }
+      });
+
+      // 2. Fallback for browsers without scrollsnapchange support
+      if (!('onscrollsnapchange' in HTMLElement.prototype)) {
+        const observer = new IntersectionObserver(
+          () => {
+            const panelRect = panel.getBoundingClientRect();
+            const topEntry = [...headers].reduce((currentTop, header) => {
+              const { bottom } = header.getBoundingClientRect();
+              if (bottom < panelRect.top) return currentTop;
+              if (!currentTop) return header;
+              return bottom < currentTop.getBoundingClientRect().bottom
+                ? header
+                : currentTop;
+            }, undefined);
+            if (topEntry) {
+              setActiveLink(topEntry.id);
+            }
+          },
+          { root: panel, threshold: 0.9 }
+        );
+
+        headers.forEach((header) => observer.observe(header));
+      }
+
+      // 3. Smooth scroll panel when clicking any TOC link
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          const href = link.getAttribute('href');
+          if (!href || !href.startsWith('#')) return;
+          const targetId = href.slice(1);
+          const targetEl = document.getElementById(targetId);
+          if (targetEl && panel.contains(targetEl)) {
+            event.preventDefault();
+            setActiveLink( resolveTargetId(targetEl) || targetId );
+            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
+            history.replaceState(null, '', href);
+          }
+        });
+      });
+    })();
+  </script>
