+  <script>
+    (function () {
+      const panel = document.querySelector('.seasonal-panel');
+      const tocLinks = Array.from(document.querySelectorAll('.toc-sidebar a[href^="#"]'));
+      const sections = Array.from(document.querySelectorAll('.seasonal-panel .drink-section'));
+
+      if (!panel || !tocLinks.length || !sections.length) return;
+
+      let programmaticTargetId = null;
+      let programmaticTimer = null;
+
+      function setActiveSection(sectionId) {
+        tocLinks.forEach((link) => {
+          const isMatch = link.getAttribute('href') === '#' + sectionId;
+          link.classList.toggle('active', isMatch);
+          if (isMatch) {
+            link.setAttribute('aria-current', 'true');
+          } else {
+            link.removeAttribute('aria-current');
+          }
+        });
+
+        sections.forEach((sec) => {
+          sec.classList.toggle('active', sec.id === sectionId);
+        });
+      }
+
+      function getClosestSectionId() {
+        const panelRect = panel.getBoundingClientRect();
+        let closestSection = sections[0];
+        let minDistance = Infinity;
+
+        sections.forEach((section) => {
+          const header = section.querySelector('header') || section;
+          const rect = header.getBoundingClientRect();
+          const distance = Math.abs(rect.top - panelRect.top);
+          if (distance < minDistance) {
+            minDistance = distance;
+            closestSection = section;
+          }
+        });
+
+        return closestSection ? closestSection.id : null;
+      }
+
+      // Smoothly scroll panel when clicking any TOC link
+      tocLinks.forEach((link) => {
+        link.addEventListener('click', (event) => {
+          event.preventDefault();
+          const targetId = link.getAttribute('href').slice(1);
+          const targetSection = document.getElementById(targetId);
+          if (!targetSection) return;
+
+          programmaticTargetId = targetId;
+          if (programmaticTimer) clearTimeout(programmaticTimer);
+          programmaticTimer = setTimeout(() => {
+            programmaticTargetId = null;
+          }, 700);
+
+          setActiveSection(targetId);
+
+          const targetTop = targetSection.offsetTop;
+          panel.scrollTo({
+            top: targetTop,
+            behavior: 'smooth'
+          });
+        });
+      });
+
+      // IntersectionObserver to detect sections snapping into view
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver(
+          (entries) => {
+            if (programmaticTargetId) return;
+            let bestEntry = null;
+            entries.forEach((entry) => {
+              if (entry.isIntersecting) {
+                if (!bestEntry || entry.intersectionRatio > bestEntry.intersectionRatio) {
+                  bestEntry = entry;
+                }
+              }
+            });
+            if (bestEntry && bestEntry.target && bestEntry.target.id) {
+              setActiveSection(bestEntry.target.id);
+            }
+          },
+          {
+            root: panel,
+            threshold: [0.5, 0.75]
+          }
+        );
+
+        sections.forEach((section) => observer.observe(section));
+      }
+
+      // Sync active state on panel scroll and scrollend
+      function handleScroll() {
+        const closestId = getClosestSectionId();
+        if (!closestId) return;
+
+        if (programmaticTargetId) {
+          const targetSection = document.getElementById(programmaticTargetId);
+          if (targetSection && Math.abs(panel.scrollTop - targetSection.offsetTop) <= 8) {
+            programmaticTargetId = null;
+            if (programmaticTimer) clearTimeout(programmaticTimer);
+          } else {
+            return;
+          }
+        }
+
+        setActiveSection(closestId);
+      }
+
+      panel.addEventListener('scroll', handleScroll, { passive: true });
+      panel.addEventListener('scrollend', () => {
+        programmaticTargetId = null;
+        if (programmaticTimer) clearTimeout(programmaticTimer);
+        const closestId = getClosestSectionId();
+        if (closestId) setActiveSection(closestId);
+      });
+    })();
+  </script>
