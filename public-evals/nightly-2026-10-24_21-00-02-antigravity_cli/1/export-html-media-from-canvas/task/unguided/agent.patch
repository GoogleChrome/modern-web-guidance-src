+  <script>
+    (function () {
+      const canvas = document.getElementById('gift_card_canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+
+      const recipientInput = document.getElementById('card_recipient');
+      const messageInput = document.getElementById('card_message');
+      const amountSelect = document.getElementById('card_amount');
+      const colorPicker = document.getElementById('card_bg_color');
+      const colorSwatches = document.querySelectorAll('.color-swatch');
+      const exportBtn = document.getElementById('export_btn');
+      const statusEl = document.getElementById('canvas_status');
+
+      const previewRecipient = document.getElementById('preview_recipient');
+      const previewMessage = document.getElementById('preview_message');
+      const previewAmount = document.getElementById('preview_amount');
+
+      // Feature detection for HTML-in-Canvas API
+      function supportsHtmlInCanvas(canvasEl, context2d) {
+        return Boolean(
+          context2d &&
+          (typeof context2d.drawElementImage === 'function' || typeof context2d.drawElement === 'function') &&
+          ('onpaint' in canvasEl || typeof canvasEl.requestPaint === 'function' || 'layoutsubtree' in canvasEl)
+        );
+      }
+
+      const hasNativeHtmlInCanvas = supportsHtmlInCanvas(canvas, ctx);
+
+      // Fallback 2D renderer if native HTML-in-Canvas is unavailable in the current browser
+      function drawFallbackCard() {
+        const width = canvas.width;
+        const height = canvas.height;
+        const bgColor = exportElement.style.backgroundColor || colorPicker.value || '#4e342e';
+        const recipient = previewRecipient.textContent || 'Coffee Lover';
+        const message = previewMessage.textContent || '';
+        const amount = previewAmount.textContent || '$25';
+
+        ctx.clearRect(0, 0, width, height);
+
+        // Rounded card background
+        const r = 16;
+        ctx.save();
+        ctx.beginPath();
+        ctx.moveTo(r, 0);
+        ctx.lineTo(width - r, 0);
+        ctx.quadraticCurveTo(width, 0, width, r);
+        ctx.lineTo(width, height - r);
+        ctx.quadraticCurveTo(width, height, width - r, height);
+        ctx.lineTo(r, height);
+        ctx.quadraticCurveTo(0, height, 0, height - r);
+        ctx.lineTo(0, r);
+        ctx.quadraticCurveTo(0, 0, r, 0);
+        ctx.closePath();
+        ctx.fillStyle = bgColor;
+        ctx.fill();
+
+        // Brand Header
+        ctx.fillStyle = '#ffab40';
+        ctx.font = '800 18px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('THE DAILY GRIND', 28, 46);
+
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
+        ctx.font = '400 12px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('ARTISANAL COFFEE CO.', 28, 64);
+
+        // Amount pill
+        ctx.font = '700 24px "Segoe UI", Tahoma, sans-serif';
+        const amountWidth = ctx.measureText(amount).width + 24;
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';
+        ctx.beginPath();
+        ctx.roundRect ? ctx.roundRect(width - 28 - amountWidth, 24, amountWidth, 36, 18) : ctx.rect(width - 28 - amountWidth, 24, amountWidth, 36);
+        ctx.fill();
+
+        ctx.fillStyle = '#ffffff';
+        ctx.fillText(amount, width - 28 - amountWidth + 12, 50);
+
+        // Custom message (word wrap)
+        ctx.fillStyle = '#ffffff';
+        ctx.font = '600 22px "Segoe UI", Tahoma, sans-serif';
+        const words = message.split(' ');
+        let line = '';
+        let y = 135;
+        const maxWidth = width - 56;
+        for (let i = 0; i < words.length; i++) {
+          const testLine = line + words[i] + ' ';
+          if (ctx.measureText(testLine).width > maxWidth && i > 0) {
+            ctx.fillText(line.trim(), 28, y);
+            line = words[i] + ' ';
+            y += 30;
+          } else {
+            line = testLine;
+          }
+        }
+        ctx.fillText(line.trim(), 28, y);
+
+        // Recipient
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.9)';
+        ctx.font = 'italic 15px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('For: ' + recipient, 28, y + 32);
+
+        // Footer divider & text
+        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
+        ctx.lineWidth = 1;
+        ctx.beginPath();
+        ctx.moveTo(28, height - 48);
+        ctx.lineTo(width - 28, height - 48);
+        ctx.stroke();
+
+        ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
+        ctx.font = '400 12px "Segoe UI", Tahoma, sans-serif';
+        ctx.fillText('REDEEMABLE AT ALL LOCATIONS', 28, height - 26);
+
+        const badge = '☕ GIFT CARD';
+        const badgeWidth = ctx.measureText(badge).width;
+        ctx.fillText(badge, width - 28 - badgeWidth, height - 26);
+        ctx.restore();
+      }
+
+      // Render HTML element #export_element onto the canvas
+      function renderCardToCanvas() {
+        if (typeof ctx.reset === 'function') {
+          ctx.reset();
+        } else {
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        }
+
+        if (typeof ctx.drawElementImage === 'function') {
+          const transform = ctx.drawElementImage(exportElement, 0, 0);
+          if (transform) {
+            exportElement.style.transform = transform.toString();
+          }
+        } else if (typeof ctx.drawElement === 'function') {
+          const transform = ctx.drawElement(exportElement, 0, 0);
+          if (transform) {
+            exportElement.style.transform = transform.toString();
+          }
+        } else {
+          drawFallbackCard();
+        }
+      }
+
+      // Synchronize rendering with the canvas paint event
+      canvas.addEventListener('paint', () => {
+        renderCardToCanvas();
+      });
+
+      canvas.onpaint = () => {
+        renderCardToCanvas();
+      };
+
+      function triggerCanvasPaint() {
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        } else {
+          renderCardToCanvas();
+        }
+      }
+
+      // Sync UI inputs with #export_element and trigger synchronized paint
+      function updateCardDesign() {
+        previewRecipient.textContent = recipientInput.value.trim() || 'Coffee Lover';
+        previewMessage.textContent = messageInput.value.trim() || 'Enjoy a cup on me!';
+        previewAmount.textContent = amountSelect.value;
+        exportElement.style.backgroundColor = colorPicker.value;
+
+        triggerCanvasPaint();
+      }
+
+      recipientInput.addEventListener('input', updateCardDesign);
+      messageInput.addEventListener('input', updateCardDesign);
+      amountSelect.addEventListener('change', updateCardDesign);
+
+      colorPicker.addEventListener('input', () => {
+        colorSwatches.forEach((s) => s.classList.remove('active'));
+        updateCardDesign();
+      });
+
+      colorSwatches.forEach((swatch) => {
+        swatch.addEventListener('click', () => {
+          colorSwatches.forEach((s) => s.classList.remove('active'));
+          swatch.classList.add('active');
+          const selectedColor = swatch.getAttribute('data-color');
+          colorPicker.value = selectedColor;
+          updateCardDesign();
+        });
+      });
+
+      // Export and download the canvas as a PNG image file
+      exportBtn.addEventListener('click', () => {
+        // Ensure latest state is painted before exporting
+        renderCardToCanvas();
+
+        const recipientSlug = (recipientInput.value.trim() || 'coffee')
+          .toLowerCase()
+          .replace(/[^a-z0-9]+/g, '-')
+          .replace(/^-|-$/g, '');
+        const filename = `daily-grind-gift-card-${recipientSlug || 'coffee'}.png`;
+
+        if (typeof canvas.toBlob === 'function') {
+          canvas.toBlob((blob) => {
+            if (!blob) return;
+            const url = URL.createObjectURL(blob);
+            const link = document.createElement('a');
+            link.href = url;
+            link.download = filename;
+            document.body.appendChild(link);
+            link.click();
+            document.body.removeChild(link);
+            URL.revokeObjectURL(url);
+            statusEl.textContent = 'Gift card exported and downloaded!';
+          }, 'image/png');
+        } else {
+          const dataUrl = canvas.toDataURL('image/png');
+          const link = document.createElement('a');
+          link.href = dataUrl;
+          link.download = filename;
+          document.body.appendChild(link);
+          link.click();
+          document.body.removeChild(link);
+          statusEl.textContent = 'Gift card exported and downloaded!';
+        }
+      });
+
+      // Initial render
+      updateCardDesign();
+    })();
+  </script>
 </body>
 
