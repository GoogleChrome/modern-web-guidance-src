+  <script src="https://cdn.jsdelivr.net/npm/three-html-render/dist/polyfill.js"></script>
+  <script>
+    (function () {
+      const canvas = document.getElementById('gift_card_canvas');
+      const ctx = canvas.getContext('2d');
+      const exportElement = document.getElementById('export_element');
+      const canvasWrapper = document.getElementById('canvas_wrapper');
+      const messageControl = document.getElementById('card_message_control');
+      const inlineMessage = document.getElementById('inline_card_message');
+      const colorPicker = document.getElementById('card_bg_color');
+      const swatches = document.querySelectorAll('.color-swatch');
+      const exportBtn = document.getElementById('export_btn');
+      const fallbackWarning = document.getElementById('fallback_warning');
+
+      // Check if HTML-in-Canvas is supported in the browser
+      let supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+      if (!supportsHtmlInCanvas && typeof window.installHtmlInCanvasPolyfill === 'function') {
+        window.installHtmlInCanvasPolyfill();
+        supportsHtmlInCanvas = 'content' in HTMLCanvasElement.prototype;
+      }
+
+      function requestCanvasPaint() {
+        if (typeof canvas.requestPaint === 'function') {
+          canvas.requestPaint();
+        }
+      }
+
+      if (supportsHtmlInCanvas) {
+        // Render the HTML content to the canvas inside a canvas.onpaint event handler
+        canvas.onpaint = (event) => {
+          ctx.reset();
+          // Draw #export_element at x:0, y:0. In 2D context, drawElementImage
+          // automatically syncs the DOM element geometry for hit testing and accessibility.
+          ctx.drawElementImage(exportElement, 0, 0);
+        };
+      } else {
+        // Fallback strategy: place HTML content on top of the canvas using CSS
+        // and display a warning if native HTML-in-Canvas export is unavailable.
+        canvasWrapper.classList.add('fallback-active');
+        canvasWrapper.appendChild(exportElement);
+        fallbackWarning.textContent =
+          'Note: HTML-in-Canvas API is not natively supported in this browser; using fallback preview.';
+        fallbackWarning.style.display = 'block';
+      }
+
+      // Scale canvas grid to match the device scale factor to prevent blurriness
+      const observer = new ResizeObserver(([entry]) => {
+        const dpc = entry.devicePixelContentBoxSize;
+        canvas.width = dpc
+          ? dpc[0].inlineSize
+          : Math.round(entry.contentRect.width * window.devicePixelRatio);
+        canvas.height = dpc
+          ? dpc[0].blockSize
+          : Math.round(entry.contentRect.height * window.devicePixelRatio);
+        requestCanvasPaint();
+      });
+
+      const supportsDevicePixelContentBox =
+        typeof ResizeObserverEntry !== 'undefined' &&
+        'devicePixelContentBoxSize' in ResizeObserverEntry.prototype;
+      const options = supportsDevicePixelContentBox
+        ? { box: 'device-pixel-content-box' }
+        : {};
+      observer.observe(canvas, options);
+
+      // Sync custom message inputs and trigger paint
+      function updateMessage(value) {
+        messageControl.value = value;
+        inlineMessage.value = value;
+        inlineMessage.setAttribute('value', value);
+        requestCanvasPaint();
+      }
+
+      messageControl.addEventListener('input', (e) => {
+        updateMessage(e.target.value);
+      });
+
+      inlineMessage.addEventListener('input', (e) => {
+        updateMessage(e.target.value);
+      });
+
+      // Sync background color selection and trigger paint
+      function updateBackgroundColor(color) {
+        exportElement.style.backgroundColor = color;
+        colorPicker.value = color;
+        swatches.forEach((swatch) => {
+          swatch.classList.toggle(
+            'active',
+            swatch.dataset.color.toLowerCase() === color.toLowerCase()
+          );
+        });
+        requestCanvasPaint();
+      }
+
+      colorPicker.addEventListener('input', (e) => {
+        updateBackgroundColor(e.target.value);
+      });
+
+      swatches.forEach((swatch) => {
+        swatch.addEventListener('click', () => {
+          updateBackgroundColor(swatch.dataset.color);
+        });
+      });
+
+      // Export the canvas content as an image file
+      exportBtn.addEventListener('click', () => {
+        if (!supportsHtmlInCanvas) {
+          // Draw fallback representation onto canvas before export if HTML-in-Canvas is unsupported
+          const dpr = window.devicePixelRatio || 1;
+          ctx.save();
+          ctx.scale(dpr, dpr);
+          ctx.fillStyle = exportElement.style.backgroundColor || '#4e342e';
+          ctx.fillRect(0, 0, 420, 250);
+          ctx.fillStyle = '#ffab40';
+          ctx.font = 'bold 16px sans-serif';
+          ctx.fillText('THE DAILY GRIND', 28, 44);
+          ctx.fillStyle = '#ffffff';
+          ctx.font = 'bold 20px sans-serif';
+          ctx.fillText(inlineMessage.value || 'Enjoy a coffee on me!', 28, 130);
+          ctx.font = '14px sans-serif';
+          ctx.fillText('ARTISANAL COFFEE GIFT CARD - $25.00', 28, 220);
+          ctx.restore();
+        }
+
+        const dataURL = canvas.toDataURL('image/png');
+        const link = document.createElement('a');
+        link.download = 'daily-grind-gift-card.png';
+        link.href = dataURL;
+        link.click();
+      });
+    })();
+  </script>
