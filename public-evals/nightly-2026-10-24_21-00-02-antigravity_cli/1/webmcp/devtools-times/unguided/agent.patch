+import type { ModelContextTool } from '../../global';
+
+export interface ArticleMetadata {
+  slug: string;
+  title: string;
+  summary: string;
+  author?: string;
+  date?: string;
+  category?: string;
+  readingTime?: number;
+}
+
+const formatToolResponse = (data: Record<string, any>) => ({
+  ...data,
+  content: [
+    {
+      type: 'text',
+      text: JSON.stringify(data, null, 2),
+    },
+  ],
+});
+
+let currentAbortController: AbortController | null = null;
+const registeredToolNames = new Set<string>();
+
+function getArticleProseElement(): HTMLElement | null {
+  return (
+    document.querySelector<HTMLElement>('article .prose') ||
+    document.querySelector<HTMLElement>('article') ||
+    document.querySelector<HTMLElement>('main')
+  );
+}
+
+function getCurrentArticleMetadata(fallback?: Partial<ArticleMetadata>): ArticleMetadata {
+  const datasetEl = document.querySelector<HTMLElement>('article[data-article-slug]');
+  const slugFromUrl = window.location.pathname
+    .replace(/\/$/, '')
+    .split('/')
+    .pop() || '';
+
+  const slug = fallback?.slug || datasetEl?.dataset.articleSlug || slugFromUrl;
+  const title =
+    fallback?.title ||
+    datasetEl?.dataset.articleTitle ||
+    document.querySelector('article h1')?.textContent?.trim() ||
+    document.title;
+  const summary =
+    fallback?.summary ||
+    datasetEl?.dataset.articleSummary ||
+    document.querySelector('article p')?.textContent?.trim() ||
+    '';
+  const author = fallback?.author || datasetEl?.dataset.articleAuthor || '';
+  const date = fallback?.date || datasetEl?.dataset.articleDate || '';
+  const category = fallback?.category || datasetEl?.dataset.articleCategory || '';
+  const readingTime =
+    fallback?.readingTime ||
+    (datasetEl?.dataset.articleReadingTime ? Number(datasetEl.dataset.articleReadingTime) : undefined);
+
+  return {
+    slug,
+    title,
+    summary,
+    author,
+    date,
+    category,
+    readingTime,
+  };
+}
+
+export function createSiteTools(baseUrl: string): ModelContextTool[] {
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  return [
+    {
+      name: 'search_articles',
+      description: 'Search articles across The DevTools Times by keyword in title, summary, or slug.',
+      annotations: {
+        readOnlyHint: true,
+        idempotentHint: true,
+      },
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: {
+            type: 'string',
+            description: 'Keywords to search for in article titles, summaries, or slugs.',
+          },
+        },
+        required: ['query'],
+      },
+      async execute(input: { query?: string }) {
+        const query = String(input?.query || '').trim();
+        const response = await fetch(`${normalizedBase}api/articles.json`);
+        const articles: Array<{ slug: string; title: string; summary: string; image?: string }> =
+          await response.json();
+        const q = query.toLowerCase();
+        const results = q
+          ? articles.filter(
+              a =>
+                a.title.toLowerCase().includes(q) ||
+                a.summary.toLowerCase().includes(q) ||
+                a.slug.toLowerCase().includes(q)
+            )
+          : articles;
+
+        return formatToolResponse({
+          query,
+          count: results.length,
+          results: results.map(a => ({
+            slug: a.slug,
+            title: a.title,
+            summary: a.summary,
+            url: `${normalizedBase}articles/${a.slug}`,
+          })),
+        });
+      },
+    },
+    {
+      name: 'get_reading_list',
+      description: "Retrieve the current user's bookmarked reading list articles.",
+      annotations: {
+        readOnlyHint: true,
+        idempotentHint: true,
+      },
+      inputSchema: {
+        type: 'object',
+        properties: {},
+      },
+      async execute() {
+        const [listRes, articlesRes] = await Promise.all([
+          fetch(`${normalizedBase}api/reading-list.json`),
+          fetch(`${normalizedBase}api/articles.json`),
+        ]);
+        const listData = await listRes.json();
+        const allArticles: Array<{ slug: string; title: string; summary: string }> =
+          await articlesRes.json();
+        const readingList: string[] = listData.readingList || [];
+        const savedArticles = allArticles.filter(a => readingList.includes(a.slug));
+
+        return formatToolResponse({
+          count: readingList.length,
+          readingList,
+          articles: savedArticles.map(a => ({
+            slug: a.slug,
+            title: a.title,
+            summary: a.summary,
+            url: `${normalizedBase}articles/${a.slug}`,
+          })),
+        });
+      },
+    },
+    {
+      name: 'manage_reading_list',
+      description: "Add, remove, or toggle an article in the user's reading list by slug.",
+      inputSchema: {
+        type: 'object',
+        properties: {
+          slug: {
+            type: 'string',
+            description: 'The slug of the article (e.g., "coffee-alchemy", "super-bowl-lx").',
+          },
+          action: {
+            type: 'string',
+            enum: ['add', 'remove', 'toggle'],
+            description: 'Whether to add, remove, or toggle the article in the reading list.',
+          },
+        },
+        required: ['slug'],
+      },
+      async execute(input: { slug: string; action?: 'add' | 'remove' | 'toggle' }) {
+        const slug = String(input?.slug || '').trim();
+        const action = input?.action || 'toggle';
+        const response = await fetch(`${normalizedBase}api/reading-list.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({
+            slug,
+            action: action === 'toggle' ? undefined : action,
+          }),
+        });
+        const data = await response.json();
+        const readingList: string[] = data.readingList || [];
+        window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: { readingList } }));
+
+        return formatToolResponse({
+          slug,
+          action,
+          isBookmarked: readingList.includes(slug),
+          readingList,
+        });
+      },
+    },
+  ];
+}
+
+export function createArticleUtilityTools(
+  baseUrl: string,
+  articleMeta?: Partial<ArticleMetadata>
+): ModelContextTool[] {
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  return [
+    {
+      name: 'get_article_details',
+      description:
+        'Extract metadata, full text content, headings, and word count of the current article on the page.',
+      annotations: {
+        readOnlyHint: true,
+        idempotentHint: true,
+      },
+      inputSchema: {
+        type: 'object',
+        properties: {
+          includeFullText: {
+            type: 'boolean',
+            description: 'Whether to include the full body text of the article (default: true).',
+          },
+        },
+      },
+      async execute(input?: { includeFullText?: boolean }) {
+        const meta = getCurrentArticleMetadata(articleMeta);
+        const proseEl = getArticleProseElement();
+        const fullText = proseEl?.innerText?.trim() || '';
+        const words = fullText ? fullText.split(/\s+/).filter(Boolean) : [];
+        const headings = Array.from(
+          (proseEl || document).querySelectorAll('h1, h2, h3, h4')
+        ).map(h => h.textContent?.trim() || '').filter(Boolean);
+
+        return formatToolResponse({
+          ...meta,
+          url: window.location.href,
+          wordCount: words.length,
+          headings,
+          ...(input?.includeFullText !== false ? { contentText: fullText } : {}),
+        });
+      },
+    },
+    {
+      name: 'estimate_article_reading_time',
+      description:
+        'Calculate the word count, character count, and estimated reading time for the current article at a customizable words-per-minute (WPM) speed.',
+      annotations: {
+        readOnlyHint: true,
+        idempotentHint: true,
+      },
+      inputSchema: {
+        type: 'object',
+        properties: {
+          wordsPerMinute: {
+            type: 'number',
+            description: 'Reading speed in words per minute (default: 200).',
+          },
+        },
+      },
+      async execute(input?: { wordsPerMinute?: number }) {
+        const wpm = Number(input?.wordsPerMinute) > 0 ? Number(input?.wordsPerMinute) : 200;
+        const meta = getCurrentArticleMetadata(articleMeta);
+        const proseEl = getArticleProseElement();
+        const text = proseEl?.innerText?.trim() || '';
+        const words = text ? text.split(/\s+/).filter(Boolean) : [];
+        const wordCount = words.length;
+        const characterCount = text.length;
+        const estimatedMinutes = Math.max(1, Math.ceil(wordCount / wpm));
+
+        return formatToolResponse({
+          slug: meta.slug,
+          title: meta.title,
+          wordCount,
+          characterCount,
+          wordsPerMinute: wpm,
+          estimatedReadingMinutes: estimatedMinutes,
+          publishedReadingTime: meta.readingTime ?? estimatedMinutes,
+        });
+      },
+    },
+    {
+      name: 'get_article_popularity',
+      description:
+        'Fetch live popularity and trending statistics for an article from the /api/article-popularity endpoint.',
+      annotations: {
+        readOnlyHint: true,
+        idempotentHint: true,
+      },
+      inputSchema: {
+        type: 'object',
+        properties: {
+          id: {
+            type: 'string',
+            description: 'The article slug or ID (defaults to the current article on the page).',
+          },
+        },
+      },
+      async execute(input?: { id?: string }) {
+        const meta = getCurrentArticleMetadata(articleMeta);
+        const articleId = String(input?.id || meta.slug || '').trim();
+        const response = await fetch(
+          `${normalizedBase}api/article-popularity?id=${encodeURIComponent(articleId)}`
+        );
+        const data = await response.json();
+        return formatToolResponse({
+          status: response.status,
+          ok: response.ok,
+          ...data,
+        });
+      },
+    },
+    {
+      name: 'customize_article_reader',
+      description:
+        'Adjust client-side article reader display preferences such as font size, line spacing, or theme mode on the current article page.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          fontSize: {
+            type: 'string',
+            enum: ['sm', 'base', 'lg', 'xl'],
+            description: 'Text size for the article body (sm, base, lg, xl).',
+          },
+          theme: {
+            type: 'string',
+            enum: ['default', 'sepia', 'dark'],
+            description: 'Visual reading theme for the article container (default, sepia, dark).',
+          },
+        },
+      },
+      async execute(input?: { fontSize?: 'sm' | 'base' | 'lg' | 'xl'; theme?: 'default' | 'sepia' | 'dark' }) {
+        const fontSize = input?.fontSize || 'base';
+        const theme = input?.theme || 'default';
+        const proseEl = getArticleProseElement();
+
+        if (proseEl) {
+          proseEl.dataset.readerFontSize = fontSize;
+          proseEl.dataset.readerTheme = theme;
+          proseEl.classList.remove('text-sm', 'text-base', 'text-lg', 'text-xl');
+          proseEl.classList.add(`text-${fontSize}`);
+
+          proseEl.classList.remove(
+            'bg-amber-50',
+            'text-amber-950',
+            'bg-gray-900',
+            'text-gray-100',
+            'p-6',
+            'rounded-lg'
+          );
+          if (theme === 'sepia') {
+            proseEl.classList.add('bg-amber-50', 'text-amber-950', 'p-6', 'rounded-lg');
+          } else if (theme === 'dark') {
+            proseEl.classList.add('bg-gray-900', 'text-gray-100', 'p-6', 'rounded-lg');
+          }
+        }
+
+        window.dispatchEvent(
+          new CustomEvent('article-reader-customized', { detail: { fontSize, theme } })
+        );
+
+        return formatToolResponse({
+          applied: Boolean(proseEl),
+          fontSize,
+          theme,
+        });
+      },
+    },
+    {
+      name: 'highlight_article_text',
+      description:
+        'Find and highlight occurrences of a specific keyword or phrase inside the current article body.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          phrase: {
+            type: 'string',
+            description: 'The keyword or phrase to highlight in the article body (pass empty string to clear highlights).',
+          },
+        },
+        required: ['phrase'],
+      },
+      async execute(input: { phrase: string }) {
+        const phrase = String(input?.phrase || '').trim();
+        const proseEl = getArticleProseElement();
+        if (!proseEl) {
+          return formatToolResponse({ phrase, matches: 0, error: 'Article body not found' });
+        }
+
+        // Remove existing highlights
+        proseEl.querySelectorAll('mark[data-webmcp-highlight]').forEach(mark => {
+          const parent = mark.parentNode;
+          if (parent) {
+            parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
+            parent.normalize();
+          }
+        });
+
+        if (!phrase) {
+          return formatToolResponse({ phrase: '', matches: 0, cleared: true });
+        }
+
+        let matchCount = 0;
+        const walker = document.createTreeWalker(proseEl, NodeFilter.SHOW_TEXT);
+        const textNodes: Text[] = [];
+        let currentNode = walker.nextNode();
+        while (currentNode) {
+          if (
+            currentNode.parentElement &&
+            !['SCRIPT', 'STYLE', 'MARK'].includes(currentNode.parentElement.tagName)
+          ) {
+            textNodes.push(currentNode as Text);
+          }
+          currentNode = walker.nextNode();
+        }
+
+        const escaped = phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+        const regex = new RegExp(`(${escaped})`, 'gi');
+
+        for (const node of textNodes) {
+          const value = node.nodeValue || '';
+          if (!regex.test(value)) continue;
+          regex.lastIndex = 0;
+
+          const fragment = document.createDocumentFragment();
+          let lastIdx = 0;
+          let match: RegExpExecArray | null;
+          while ((match = regex.exec(value)) !== null) {
+            if (match.index > lastIdx) {
+              fragment.appendChild(document.createTextNode(value.slice(lastIdx, match.index)));
+            }
+            const mark = document.createElement('mark');
+            mark.dataset.webmcpHighlight = 'true';
+            mark.className = 'bg-amber-200 text-gray-900 px-0.5 rounded';
+            mark.textContent = match[0];
+            fragment.appendChild(mark);
+            matchCount++;
+            lastIdx = regex.lastIndex;
+          }
+          if (lastIdx < value.length) {
+            fragment.appendChild(document.createTextNode(value.slice(lastIdx)));
+          }
+          node.parentNode?.replaceChild(fragment, node);
+        }
+
+        return formatToolResponse({
+          phrase,
+          matches: matchCount,
+        });
+      },
+    },
+    {
+      name: 'share_article',
+      description:
+        'Generate a formatted citation or shareable link for the current article and copy it to the clipboard if supported.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          format: {
+            type: 'string',
+            enum: ['url', 'markdown', 'citation'],
+            description: 'Output format: "url", "markdown", or academic "citation" (default: "markdown").',
+          },
+        },
+      },
+      async execute(input?: { format?: 'url' | 'markdown' | 'citation' }) {
+        const format = input?.format || 'markdown';
+        const meta = getCurrentArticleMetadata(articleMeta);
+        const url = window.location.href;
+
+        let formatted = url;
+        if (format === 'markdown') {
+          formatted = `[${meta.title}](${url}) — ${meta.summary}`;
+        } else if (format === 'citation') {
+          const authorPart = meta.author ? `${meta.author}. ` : '';
+          const datePart = meta.date ? `(${meta.date}). ` : '';
+          formatted = `${authorPart}${datePart}"${meta.title}." The DevTools Times. Retrieved from ${url}`;
+        }
+
+        let copiedToClipboard = false;
+        try {
+          if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
+            await navigator.clipboard.writeText(formatted);
+            copiedToClipboard = true;
+          }
+        } catch {
+          // Clipboard access may be restricted without user gesture
+        }
+
+        return formatToolResponse({
+          slug: meta.slug,
+          title: meta.title,
+          format,
+          formatted,
+          url,
+          copiedToClipboard,
+        });
+      },
+    },
+  ];
+}
+
+export async function registerWebMCPTools(options: {
+  baseUrl: string;
+  isArticlePage?: boolean;
+  articleMeta?: Partial<ArticleMetadata>;
+}): Promise<() => void> {
+  if (typeof window === 'undefined' || typeof navigator === 'undefined') {
+    return () => {};
+  }
+
+  const mc = navigator.modelContext;
+  if (!mc) {
+    return () => {};
+  }
+
+  if (currentAbortController) {
+    currentAbortController.abort();
+  }
+  const abortController = new AbortController();
+  currentAbortController = abortController;
+
+  const tools: ModelContextTool[] = [
+    ...createSiteTools(options.baseUrl),
+    ...(options.isArticlePage ? createArticleUtilityTools(options.baseUrl, options.articleMeta) : []),
+  ];
+
+  if (typeof mc.registerTool === 'function') {
+    for (const tool of tools) {
+      try {
+        if (registeredToolNames.has(tool.name) && typeof mc.unregisterTool === 'function') {
+          await mc.unregisterTool(tool.name);
+          registeredToolNames.delete(tool.name);
+        }
+      } catch {
+        // Ignore if tool wasn't previously registered
+      }
+
+      try {
+        await mc.registerTool(tool, { signal: abortController.signal });
+        registeredToolNames.add(tool.name);
+      } catch {
+        // Fallback if options/signal parameter is not accepted by the implementation
+        try {
+          await mc.registerTool(tool);
+          registeredToolNames.add(tool.name);
+        } catch (err) {
+          console.warn(`Failed to register WebMCP tool "${tool.name}":`, err);
+        }
+      }
+    }
+  } else if (typeof mc.provideContext === 'function') {
+    try {
+      await mc.provideContext({ tools });
+      tools.forEach(t => registeredToolNames.add(t.name));
+    } catch (err) {
+      console.warn('Failed to provide WebMCP context:', err);
+    }
+  }
+
+  return () => {
+    abortController.abort();
+    if (typeof mc.unregisterTool === 'function') {
+      for (const tool of tools) {
+        if (registeredToolNames.has(tool.name)) {
+          try {
+            mc.unregisterTool(tool.name);
+          } catch {
+            // Ignore cleanup errors
+          }
+          registeredToolNames.delete(tool.name);
+        }
+      }
+    }
+  };
+}
