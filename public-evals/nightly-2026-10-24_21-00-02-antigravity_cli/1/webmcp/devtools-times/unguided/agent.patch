+++ b/src/components/ArticleUtilities.tsx
@@ -0,0 +1,394 @@
+import React, { useState, useEffect } from 'react';
+import { registerWebMCPTools, type ArticleMetadata } from '../utils/webmcp';
+
+interface Props {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+}
+
+export default function ArticleUtilities({
+  slug,
+  title,
+  summary,
+  author,
+  date,
+  category,
+  readingTime,
+}: Props) {
+  const [fontSize, setFontSize] = useState<'sm' | 'base' | 'lg' | 'xl'>('base');
+  const [theme, setTheme] = useState<'default' | 'sepia' | 'dark'>('default');
+  const [highlightPhrase, setHighlightPhrase] = useState('');
+  const [highlightCount, setHighlightCount] = useState<number | null>(null);
+  const [wpm, setWpm] = useState(200);
+  const [readingStats, setReadingStats] = useState<{
+    wordCount: number;
+    estimatedMinutes: number;
+  } | null>(null);
+  const [copiedText, setCopiedText] = useState<string | null>(null);
+
+  const baseUrl = import.meta.env.BASE_URL;
+
+  const computeStats = (wordsPerMinute: number) => {
+    const proseEl = document.querySelector<HTMLElement>('article .prose');
+    const text = proseEl?.innerText?.trim() || '';
+    const words = text ? text.split(/\s+/).filter(Boolean) : [];
+    const wordCount = words.length;
+    const estimatedMinutes = Math.max(1, Math.ceil(wordCount / (wordsPerMinute || 200)));
+    const stats = { wordCount, estimatedMinutes };
+    setReadingStats(stats);
+    return stats;
+  };
+
+  useEffect(() => {
+    computeStats(wpm);
+
+    const articleMeta: ArticleMetadata = {
+      slug,
+      title,
+      summary,
+      author,
+      date,
+      category,
+      readingTime,
+    };
+
+    let cleanupFn: (() => void) | undefined;
+    registerWebMCPTools({
+      baseUrl,
+      isArticlePage: true,
+      articleMeta,
+    }).then(cleanup => {
+      cleanupFn = cleanup;
+    });
+
+    const handleReaderCustomized = (e: Event) => {
+      const custom = e as CustomEvent<{
+        fontSize?: 'sm' | 'base' | 'lg' | 'xl';
+        theme?: 'default' | 'sepia' | 'dark';
+      }>;
+      if (custom.detail?.fontSize) setFontSize(custom.detail.fontSize);
+      if (custom.detail?.theme) setTheme(custom.detail.theme);
+    };
+
+    window.addEventListener('article-reader-customized', handleReaderCustomized);
+    return () => {
+      window.removeEventListener('article-reader-customized', handleReaderCustomized);
+      if (cleanupFn) cleanupFn();
+    };
+  }, [slug, title, summary, author, date, category, readingTime, baseUrl]);
+
+  const applyReaderStyle = (
+    nextSize: 'sm' | 'base' | 'lg' | 'xl',
+    nextTheme: 'default' | 'sepia' | 'dark'
+  ) => {
+    setFontSize(nextSize);
+    setTheme(nextTheme);
+    const proseEl = document.querySelector<HTMLElement>('article .prose');
+    if (proseEl) {
+      proseEl.dataset.readerFontSize = nextSize;
+      proseEl.dataset.readerTheme = nextTheme;
+      proseEl.classList.remove('text-sm', 'text-base', 'text-lg', 'text-xl');
+      proseEl.classList.add(`text-${nextSize}`);
+
+      proseEl.classList.remove(
+        'bg-amber-50',
+        'text-amber-950',
+        'bg-gray-900',
+        'text-gray-100',
+        'p-6',
+        'rounded-lg'
+      );
+      if (nextTheme === 'sepia') {
+        proseEl.classList.add('bg-amber-50', 'text-amber-950', 'p-6', 'rounded-lg');
+      } else if (nextTheme === 'dark') {
+        proseEl.classList.add('bg-gray-900', 'text-gray-100', 'p-6', 'rounded-lg');
+      }
+    }
+  };
+
+  const applyHighlight = (phrase: string): number => {
+    const proseEl = document.querySelector<HTMLElement>('article .prose');
+    if (!proseEl) return 0;
+
+    proseEl.querySelectorAll('mark[data-webmcp-highlight]').forEach(mark => {
+      const parent = mark.parentNode;
+      if (parent) {
+        parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
+        parent.normalize();
+      }
+    });
+
+    const trimmed = phrase.trim();
+    if (!trimmed) {
+      setHighlightCount(null);
+      return 0;
+    }
+
+    let matchCount = 0;
+    const walker = document.createTreeWalker(proseEl, NodeFilter.SHOW_TEXT);
+    const textNodes: Text[] = [];
+    let currentNode = walker.nextNode();
+    while (currentNode) {
+      if (
+        currentNode.parentElement &&
+        !['SCRIPT', 'STYLE', 'MARK'].includes(currentNode.parentElement.tagName)
+      ) {
+        textNodes.push(currentNode as Text);
+      }
+      currentNode = walker.nextNode();
+    }
+
+    const escaped = trimmed.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+    const regex = new RegExp(`(${escaped})`, 'gi');
+
+    for (const node of textNodes) {
+      const value = node.nodeValue || '';
+      if (!regex.test(value)) continue;
+      regex.lastIndex = 0;
+
+      const fragment = document.createDocumentFragment();
+      let lastIdx = 0;
+      let match: RegExpExecArray | null;
+      while ((match = regex.exec(value)) !== null) {
+        if (match.index > lastIdx) {
+          fragment.appendChild(document.createTextNode(value.slice(lastIdx, match.index)));
+        }
+        const mark = document.createElement('mark');
+        mark.dataset.webmcpHighlight = 'true';
+        mark.className = 'bg-amber-200 text-gray-900 px-0.5 rounded';
+        mark.textContent = match[0];
+        fragment.appendChild(mark);
+        matchCount++;
+        lastIdx = regex.lastIndex;
+      }
+      if (lastIdx < value.length) {
+        fragment.appendChild(document.createTextNode(value.slice(lastIdx)));
+      }
+      node.parentNode?.replaceChild(fragment, node);
+    }
+
+    setHighlightCount(matchCount);
+    return matchCount;
+  };
+
+  const handleReaderFormSubmit = (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    const formData = new FormData(e.currentTarget);
+    const nextSize = (formData.get('fontSize') as 'sm' | 'base' | 'lg' | 'xl') || fontSize;
+    const nextTheme = (formData.get('theme') as 'default' | 'sepia' | 'dark') || theme;
+    applyReaderStyle(nextSize, nextTheme);
+
+    const nativeEvent = e.nativeEvent as SubmitEvent;
+    if (typeof nativeEvent.respondWith === 'function') {
+      const payload = { applied: true, fontSize: nextSize, theme: nextTheme };
+      nativeEvent.respondWith(
+        Promise.resolve({
+          ...payload,
+          content: [{ type: 'text', text: JSON.stringify(payload) }],
+        })
+      );
+    }
+  };
+
+  const handleHighlightFormSubmit = (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    const formData = new FormData(e.currentTarget);
+    const phrase = String(formData.get('phrase') ?? highlightPhrase);
+    setHighlightPhrase(phrase);
+    const matches = applyHighlight(phrase);
+
+    const nativeEvent = e.nativeEvent as SubmitEvent;
+    if (typeof nativeEvent.respondWith === 'function') {
+      const payload = { phrase: phrase.trim(), matches };
+      nativeEvent.respondWith(
+        Promise.resolve({
+          ...payload,
+          content: [{ type: 'text', text: JSON.stringify(payload) }],
+        })
+      );
+    }
+  };
+
+  const handleReadingTimeFormSubmit = (e: React.FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    const formData = new FormData(e.currentTarget);
+    const speed = Number(formData.get('wordsPerMinute')) || wpm || 200;
+    setWpm(speed);
+    const stats = computeStats(speed);
+
+    const nativeEvent = e.nativeEvent as SubmitEvent;
+    if (typeof nativeEvent.respondWith === 'function') {
+      const payload = {
+        slug,
+        title,
+        wordsPerMinute: speed,
+        wordCount: stats.wordCount,
+        estimatedReadingMinutes: stats.estimatedMinutes,
+      };
+      nativeEvent.respondWith(
+        Promise.resolve({
+          ...payload,
+          content: [{ type: 'text', text: JSON.stringify(payload) }],
+        })
+      );
+    }
+  };
+
+  const handleCopyCitation = async () => {
+    const url = window.location.href;
+    const citation = `${author} (${date}). "${title}." The DevTools Times. ${url}`;
+    try {
+      await navigator.clipboard?.writeText(citation);
+      setCopiedText('Citation copied!');
+      setTimeout(() => setCopiedText(null), 2000);
+    } catch {
+      setCopiedText(citation);
+    }
+  };
+
+  return (
+    <section
+      aria-label="Article Utilities"
+      className="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-6 text-sm text-gray-700"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-4">
+        {/* Reading Time & Word Count Utility */}
+        <form
+          toolname="estimate_article_reading_time"
+          tooldescription="Calculate the word count and estimated reading time for the current article at a given words-per-minute speed."
+          toolautosubmit="true"
+          onSubmit={handleReadingTimeFormSubmit}
+          className="flex items-center gap-2"
+        >
+          <span className="font-semibold text-gray-800">
+            {readingStats
+              ? `${readingStats.wordCount} words (~${readingStats.estimatedMinutes} min read)`
+              : `${readingTime || 3} min read`}
+          </span>
+          <label htmlFor="article-wpm-input" className="text-xs text-gray-500">
+            @ WPM:
+          </label>
+          <input
+            id="article-wpm-input"
+            type="number"
+            name="wordsPerMinute"
+            min={50}
+            max={1000}
+            step={25}
+            value={wpm}
+            onChange={e => {
+              const val = Number(e.target.value) || 200;
+              setWpm(val);
+              computeStats(val);
+            }}
+            toolparamtitle="Words Per Minute"
+            toolparamdescription="Reading speed in words per minute (default: 200)."
+            className="w-16 px-2 py-1 text-xs border border-gray-300 rounded bg-white"
+          />
+          <button type="submit" className="sr-only">
+            Calculate Reading Time
+          </button>
+        </form>
+
+        {/* Reader Appearance Utility */}
+        <form
+          toolname="customize_article_reader"
+          tooldescription="Customize the article reader display preferences including font size and color theme."
+          toolautosubmit="true"
+          onSubmit={handleReaderFormSubmit}
+          className="flex items-center gap-2"
+        >
+          <label htmlFor="article-font-size" className="text-xs text-gray-500">
+            Text:
+          </label>
+          <select
+            id="article-font-size"
+            name="fontSize"
+            value={fontSize}
+            onChange={e =>
+              applyReaderStyle(e.target.value as 'sm' | 'base' | 'lg' | 'xl', theme)
+            }
+            toolparamtitle="Font Size"
+            toolparamdescription="Text size for the article body ('sm', 'base', 'lg', or 'xl')."
+            className="px-2 py-1 text-xs border border-gray-300 rounded bg-white"
+          >
+            <option value="sm">Small</option>
+            <option value="base">Normal</option>
+            <option value="lg">Large</option>
+            <option value="xl">Extra Large</option>
+          </select>
+
+          <label htmlFor="article-reader-theme" className="text-xs text-gray-500">
+            Theme:
+          </label>
+          <select
+            id="article-reader-theme"
+            name="theme"
+            value={theme}
+            onChange={e =>
+              applyReaderStyle(fontSize, e.target.value as 'default' | 'sepia' | 'dark')
+            }
+            toolparamtitle="Reader Theme"
+            toolparamdescription="Visual color theme for the article body ('default', 'sepia', or 'dark')."
+            className="px-2 py-1 text-xs border border-gray-300 rounded bg-white"
+          >
+            <option value="default">Default</option>
+            <option value="sepia">Sepia</option>
+            <option value="dark">Dark</option>
+          </select>
+          <button type="submit" className="sr-only">
+            Apply Reader Style
+          </button>
+        </form>
+
+        {/* Find & Highlight Utility */}
+        <form
+          toolname="highlight_article_text"
+          tooldescription="Find and highlight occurrences of a keyword or phrase within the current article text."
+          toolautosubmit="true"
+          onSubmit={handleHighlightFormSubmit}
+          className="flex items-center gap-1.5"
+        >
+          <input
+            type="text"
+            name="phrase"
+            placeholder="Highlight in article..."
+            value={highlightPhrase}
+            onChange={e => setHighlightPhrase(e.target.value)}
+            toolparamtitle="Highlight Phrase"
+            toolparamdescription="Keyword or phrase to highlight in the article text."
+            className="px-2 py-1 text-xs border border-gray-300 rounded bg-white w-36"
+          />
+          <button
+            type="submit"
+            className="px-2.5 py-1 text-xs font-medium bg-gray-800 text-white rounded hover:bg-gray-700"
+          >
+            Highlight
+          </button>
+          {highlightCount !== null && (
+            <span className="text-xs text-amber-700 font-medium">
+              {highlightCount} {highlightCount === 1 ? 'match' : 'matches'}
+            </span>
+          )}
+        </form>
+
+        {/* Cite / Copy Utility */}
+        <div className="flex items-center gap-2">
+          <button
+            type="button"
+            onClick={handleCopyCitation}
+            className="px-2.5 py-1 text-xs font-medium border border-gray-300 rounded bg-white hover:bg-gray-100"
+          >
+            Cite Article
+          </button>
+          {copiedText && <span className="text-xs text-green-700">{copiedText}</span>}
+        </div>
+      </div>
+    </section>
+  );
+}
