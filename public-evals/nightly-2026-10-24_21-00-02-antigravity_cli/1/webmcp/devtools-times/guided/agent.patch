new file mode 100644
index 0000000..c255707
--- /dev/null
+++ b/src/components/ArticleUtilities.tsx
@@ -0,0 +1,249 @@
+import React, { useState, useEffect } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+interface RelatedArticle {
+  slug: string;
+  title: string;
+  category: string;
+  url: string;
+}
+
+export interface ArticleUtilitiesProps {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  initialIsBookmarked: boolean;
+  relatedArticles: RelatedArticle[];
+}
+
+export default function ArticleUtilities({
+  slug,
+  title,
+  summary,
+  author,
+  date,
+  category,
+  readingTime,
+  initialIsBookmarked,
+  relatedArticles,
+}: ArticleUtilitiesProps) {
+  const [isBookmarked, setIsBookmarked] = useState(initialIsBookmarked);
+  const [shareStatus, setShareStatus] = useState<string | null>(null);
+
+  useEffect(() => {
+    setIsBookmarked(initialIsBookmarked);
+  }, [initialIsBookmarked, slug]);
+
+  useEffect(() => {
+    const handleUpdate = (event: Event) => {
+      const customEvent = event as CustomEvent<{ readingList?: string[] }>;
+      if (Array.isArray(customEvent.detail?.readingList)) {
+        setIsBookmarked(customEvent.detail.readingList.includes(slug));
+      }
+    };
+    window.addEventListener('reading-list-updated', handleUpdate);
+    return () => {
+      window.removeEventListener('reading-list-updated', handleUpdate);
+    };
+  }, [slug]);
+
+  useWebMCP({
+    name: 'get_current_article_details',
+    description:
+      'Extract metadata, word count, estimated reading time, section headings, body text, and related articles for the article currently open on the page. Use when the user asks to summarize, inspect, or answer questions about the current article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        includeBodyText: {
+          type: 'boolean',
+          default: true,
+          description: 'Whether to include the full plain-text body of the article.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    execute({ includeBodyText = true }: { includeBodyText?: boolean } = {}) {
+      const proseEl = document.querySelector('article .prose');
+      const bodyText = proseEl?.textContent?.trim() ?? '';
+      const words = bodyText ? bodyText.split(/\s+/).filter(Boolean).length : 0;
+      const calculatedReadingMinutes = Math.max(1, Math.ceil(words / 200));
+      const headings = Array.from(
+        document.querySelectorAll('article .prose h2, article .prose h3, article .prose h4')
+      )
+        .map((el) => el.textContent?.trim() ?? '')
+        .filter(Boolean);
+
+      return {
+        slug,
+        title,
+        summary,
+        author,
+        date,
+        category,
+        url: window.location.href,
+        isBookmarked,
+        wordCount: words,
+        readingTimeMinutes: readingTime ?? calculatedReadingMinutes,
+        headings,
+        relatedArticles,
+        ...(includeBodyText ? { bodyText } : {}),
+      };
+    },
+  });
+
+  useWebMCP({
+    name: 'bookmark_current_article',
+    description:
+      'Toggle bookmark status for the currently open article in the user reading list. Use when the user asks to bookmark, save, or unbookmark the current article.',
+    inputSchema: {
+      type: 'object',
+      properties: {},
+    },
+    annotations: {
+      readOnlyHint: false,
+    },
+    async execute(_input, { signal }) {
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug }),
+          signal,
+        });
+        if (!response.ok) {
+          return { error: `Failed to update bookmark status (HTTP ${response.status})` };
+        }
+        const data = await response.json();
+        const readingList: string[] = data.readingList || [];
+        const nextBookmarked = readingList.includes(slug);
+        setIsBookmarked(nextBookmarked);
+        window.dispatchEvent(
+          new CustomEvent('reading-list-updated', { detail: { readingList } })
+        );
+        return {
+          slug,
+          title,
+          action: nextBookmarked ? 'bookmarked' : 'removed',
+          isBookmarked: nextBookmarked,
+          readingList,
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  useWebMCP({
+    name: 'get_article_popularity',
+    description:
+      'Fetch live view count and trending status for the current article or a specified article slug. Use when the user asks how popular an article is or whether it is trending.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        articleSlug: {
+          type: 'string',
+          description: 'Slug of the article to inspect. Defaults to the currently open article.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    async execute({ articleSlug }: { articleSlug?: string } = {}, { signal }) {
+      const targetId =
+        typeof articleSlug === 'string' && articleSlug.trim() ? articleSlug.trim() : slug;
+      try {
+        const response = await fetch(
+          `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(targetId)}`,
+          { signal }
+        );
+        if (!response.ok) {
+          return { error: `Popularity request failed with status ${response.status}` };
+        }
+        const data = await response.json();
+        return {
+          slug: data.id ?? targetId,
+          views: data.views,
+          trending: Boolean(data.trending),
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  useWebMCP({
+    name: 'share_current_article',
+    description:
+      'Copy a formatted citation or shareable link for the current article to the clipboard and return the share payload. Use when the user wants to share, cite, or copy a link to the current article.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        format: {
+          type: 'string',
+          enum: ['url', 'markdown', 'citation'],
+          default: 'url',
+          description: 'Format of the share text to generate and copy.',
+        },
+      },
+    },
+    annotations: {
+      readOnlyHint: true,
+    },
+    async execute({ format = 'url' }: { format?: 'url' | 'markdown' | 'citation' } = {}) {
+      const supportedFormats = ['url', 'markdown', 'citation'];
+      if (!supportedFormats.includes(format)) {
+        return {
+          error: 'Pass a supported share format.',
+          supportedFormats,
+        };
+      }
+
+      const url = window.location.href;
+      let formattedText = url;
+      if (format === 'markdown') {
+        formattedText = `[${title}](${url}) — ${summary}`;
+      } else if (format === 'citation') {
+        formattedText = `${author}. "${title}." The DevTools Times, ${date}. ${url}`;
+      }
+
+      let copiedToClipboard = false;
+      try {
+        if (navigator.clipboard?.writeText) {
+          await navigator.clipboard.writeText(formattedText);
+          copiedToClipboard = true;
+        }
+      } catch {
+        copiedToClipboard = false;
+      }
+
+      setShareStatus(`Prepared ${format} share text`);
+      return {
+        slug,
+        title,
+        format,
+        shareText: formattedText,
+        url,
+        copiedToClipboard,
+      };
+    },
+  });
+
+  return shareStatus ? (
+    <span className="sr-only" role="status" aria-live="polite">
+      {shareStatus}
+    </span>
+  ) : null;
+}
