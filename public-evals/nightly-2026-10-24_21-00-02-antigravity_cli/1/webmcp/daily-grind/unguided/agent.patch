     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const PAGES = {
+        '/menu': {
+          title: 'Menu',
+          description: 'Full coffee and beverage menu'
+        },
+        '/locations': {
+          title: 'Locations',
+          description: 'Store locations and hours'
+        },
+        '/rewards': {
+          title: 'Rewards',
+          description: 'Loyalty rewards program'
+        },
+        '/account': {
+          title: 'My Account',
+          description: 'User account profile and settings'
+        },
+        '/order-online': {
+          title: 'Order Now',
+          description: 'Place an online coffee order for pickup or delivery'
+        },
+        '/menu/seasonal': {
+          title: 'Maple Oat Latte (Seasonal Favorites)',
+          description: 'Details for Maple Oat Latte: Creamy oat milk with a hint of Vermont maple syrup'
+        },
+        '/menu/espresso': {
+          title: 'Dark Roast Espresso (Seasonal Favorites)',
+          description: 'Details for Dark Roast Espresso: Bold, smokey, and perfect for a morning boost'
+        },
+        '/menu/cold-brew': {
+          title: 'Cold Brew (Seasonal Favorites)',
+          description: 'Details for Cold Brew: Steeped for 18 hours for maximum smoothness'
+        },
+        '/about': {
+          title: 'Our Story',
+          description: 'About The Daily Grind Coffee Co. and our story'
+        },
+        '/careers': {
+          title: 'Join the Team',
+          description: 'Careers and job opportunities at The Daily Grind'
+        },
+        '/contact': {
+          title: 'Contact Us',
+          description: 'Contact customer support and inquiries'
+        },
+        '/privacy-policy': {
+          title: 'Privacy',
+          description: 'Privacy policy and terms'
+        }
+      };
+
+      const navigateTool = {
+        name: 'navigate',
+        description:
+          'Navigate to a page on The Daily Grind website. Supports main navigation (Menu, Locations, Rewards, My Account), online ordering (Order Now), Seasonal Favorites product details (Maple Oat Latte at /menu/seasonal, Dark Roast Espresso at /menu/espresso, Cold Brew at /menu/cold-brew), and company pages (Our Story at /about, Join the Team / Careers at /careers, Contact Us at /contact, Privacy Policy at /privacy-policy). Does not allow logging out.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            path: {
+              type: 'string',
+              enum: Object.keys(PAGES),
+              description:
+                'The destination URL path to navigate to: ' +
+                Object.entries(PAGES)
+                  .map(([path, info]) => `${path} (${info.title} - ${info.description})`)
+                  .join('; ')
+            }
+          },
+          required: ['path']
+        },
+        execute: async (input) => {
+          const params = typeof input === 'string' ? JSON.parse(input) : (input || {});
+          let targetPath =
+            params.path || params.url || params.page || params.destination || params.href || params.route || '';
+
+          if (typeof targetPath === 'string' && /^https?:\/\//i.test(targetPath)) {
+            try {
+              targetPath = new URL(targetPath).pathname;
+            } catch (_) {}
+          }
+
+          if (typeof targetPath === 'string' && targetPath && !targetPath.startsWith('/')) {
+            targetPath = '/' + targetPath;
+          }
+
+          if (targetPath === '/logout' || !Object.prototype.hasOwnProperty.call(PAGES, targetPath)) {
+            return {
+              isError: true,
+              content: [
+                {
+                  type: 'text',
+                  text: `Invalid or disallowed navigation path: "${targetPath}". Valid paths are: ${Object.keys(PAGES).join(', ')}`
+                }
+              ]
+            };
+          }
+
+          const pageInfo = PAGES[targetPath];
+          const link = document.querySelector(`a[href="${targetPath}"]`);
+          if (link) {
+            const clickEvent = new MouseEvent('click', {
+              bubbles: true,
+              cancelable: true,
+              view: window
+            });
+            const notCancelled = link.dispatchEvent(clickEvent);
+            if (notCancelled) {
+              window.location.href = targetPath;
+            }
+          } else {
+            window.location.href = targetPath;
+          }
+
+          return {
+            content: [
+              {
+                type: 'text',
+                text: `Navigating to ${pageInfo.title} (${targetPath}).`
+              }
+            ]
+          };
+        }
+      };
+
+      function registerWebMCPTools() {
+        if (!('modelContext' in navigator) || !navigator.modelContext) {
+          return;
+        }
+        if (typeof navigator.modelContext.registerTool === 'function') {
+          navigator.modelContext.registerTool(navigateTool);
+        } else if (typeof navigator.modelContext.provideContext === 'function') {
+          navigator.modelContext.provideContext({ tools: [navigateTool] });
+        }
+      }
+
+      registerWebMCPTools();
+    })();
+  </script>
 </body>
 
 </html>
