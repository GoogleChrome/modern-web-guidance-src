+  <script>
+    (() => {
+      const MENU_CATEGORIES = ['all', 'seasonal', 'espresso', 'cold-brew', 'bakery'];
+      const DRINK_SIZES = ['small', 'medium', 'large'];
+      const MILK_OPTIONS = ['whole', 'oat', 'almond', 'none'];
+
+      const MENU_ITEMS = [
+        {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          category: 'seasonal',
+          price: 5.75,
+          calories: 190,
