+  <script>
+    const theaterBtn = document.getElementById('theater-mode-btn');
+    const iframe = document.getElementById('roasting-video');
+    const hero = document.getElementById('hero');
+    const mainContainer = document.getElementById('main-container');
+    const seasonalFavorites = document.getElementById('seasonal-favorites');
+
+    let isTheaterMode = false;
+
+    theaterBtn.addEventListener('click', () => {
+      isTheaterMode = !isTheaterMode;
+      const targetParent = isTheaterMode ? hero : mainContainer;
+      const referenceNode = isTheaterMode ? null : seasonalFavorites;
+
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(iframe, referenceNode);
+      } else {
+        targetParent.insertBefore(iframe, referenceNode);
+      }
+
+      theaterBtn.setAttribute('aria-pressed', String(isTheaterMode));
+      theaterBtn.textContent = isTheaterMode ? 'Exit Theater Mode' : 'Theater Mode';
+    });
+  </script>
+
