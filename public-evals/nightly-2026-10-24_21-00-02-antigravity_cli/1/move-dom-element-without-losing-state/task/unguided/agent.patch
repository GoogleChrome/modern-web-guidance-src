+  <script>
+    const theaterBtn = document.getElementById('theater-mode-btn');
+    const iframe = document.getElementById('roasting-video');
+    const heroSection = document.querySelector('.hero');
+    const mainContainer = document.querySelector('main.container');
+    const seasonalSection = document.getElementById('seasonal-favorites');
+
+    function reparentWithoutReload(targetParent, node, referenceNode = null) {
+      if ('moveBefore' in targetParent && typeof targetParent.moveBefore === 'function') {
+        targetParent.moveBefore(node, referenceNode);
+      } else if (referenceNode) {
+        targetParent.insertBefore(node, referenceNode);
+      } else {
+        targetParent.appendChild(node);
+      }
+    }
+
+    theaterBtn.addEventListener('click', () => {
+      const isTheaterMode = heroSection.contains(iframe);
+
+      if (!isTheaterMode) {
+        reparentWithoutReload(heroSection, iframe, null);
+        heroSection.classList.add('theater-mode');
+        theaterBtn.setAttribute('aria-pressed', 'true');
+        theaterBtn.textContent = 'Exit Theater Mode';
+      } else {
+        reparentWithoutReload(mainContainer, iframe, seasonalSection);
+        heroSection.classList.remove('theater-mode');
+        theaterBtn.setAttribute('aria-pressed', 'false');
+        theaterBtn.textContent = 'Theater Mode';
+      }
+    });
+  </script>
+
