diff --git a/src/utils/localNetworkAccess.ts b/src/utils/localNetworkAccess.ts
new file mode 100644
index 0000000..ec24327
--- /dev/null
+++ b/src/utils/localNetworkAccess.ts
@@ -0,0 +1,132 @@
+export type TargetAddressSpace = 'local' | 'loopback' | 'public';
+
+export type LocalNetworkPermissionName =
+  | 'local-network'
+  | 'loopback-network'
+  | 'local-network-access';
+
+export interface LocalNetworkRequestInit extends RequestInit {
+  targetAddressSpace?: TargetAddressSpace;
+}
+
+const LOOPBACK_HOSTS = new Set([
+  'localhost',
+  '127.0.0.1',
+  '[::1]',
+  '::1',
+]);
+
+/**
+ * Infers the target IP address space ('loopback', 'local', or 'public') for a URL.
+ */
+export function inferTargetAddressSpace(input: RequestInfo | URL): TargetAddressSpace {
+  try {
+    const rawUrl =
+      typeof input === 'string'
+        ? input
+        : input instanceof URL
+          ? input.href
+          : input.url;
+    const base =
+      typeof window !== 'undefined' ? window.location.origin : 'http://localhost';
+    const parsed = new URL(rawUrl, base);
+    const hostname = parsed.hostname.toLowerCase();
+
+    if (
+      LOOPBACK_HOSTS.has(hostname) ||
+      hostname.endsWith('.localhost') ||
+      /^127\.\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(hostname)
+    ) {
+      return 'loopback';
+    }
+
+    if (
+      hostname.endsWith('.local') ||
+      /^10\.\d{1,3}\.\d{1,3}\.\d{1,3}$/.test(hostname) ||
+      /^192\.168\.\d{1,3}\.\d{1,3}$/.test(hostname) ||
+      /^172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3}$/.test(hostname) ||
+      /^169\.254\.\d{1,3}\.\d{1,3}$/.test(hostname) ||
+      /^\[?(fc|fd|fe80)[0-9a-f:]*\]?$/i.test(hostname)
+    ) {
+      return 'local';
+    }
+  } catch {
+    // Fallback to 'local' when explicitly invoked via local network helper
+  }
+  return 'local';
+}
+
+/**
+ * Queries the browser Permissions API for Local Network Access permissions:
+ * 'local-network', 'loopback-network', or 'local-network-access'.
+ */
+export async function queryLocalNetworkPermission(
+  name: LocalNetworkPermissionName = 'local-network-access'
+): Promise<PermissionStatus | null> {
+  if (typeof navigator === 'undefined' || !navigator.permissions?.query) {
+    return null;
+  }
+
+  const candidates: LocalNetworkPermissionName[] = [
+    name,
+    'local-network',
+    'loopback-network',
+    'local-network-access',
+  ];
+
+  for (const permissionName of new Set(candidates)) {
+    try {
+      return await navigator.permissions.query({
+        name: permissionName as PermissionName,
+      });
+    } catch {
+      // Try next supported permission descriptor
+    }
+  }
+
+  return null;
+}
+
+/**
+ * Fetches a resource on the user's local network (`targetAddressSpace: 'local'`).
+ */
+export async function fetchLocalNetworkResource(
+  input: RequestInfo | URL,
+  init: LocalNetworkRequestInit = {}
+): Promise<Response> {
+  const targetAddressSpace = init.targetAddressSpace ?? 'local';
+  return fetch(input, {
+    ...init,
+    targetAddressSpace,
+  });
+}
+
+/**
+ * Fetches a resource on the user's loopback interface (`targetAddressSpace: 'loopback'`).
+ */
+export async function fetchLoopbackResource(
+  input: RequestInfo | URL,
+  init: LocalNetworkRequestInit = {}
+): Promise<Response> {
+  const targetAddressSpace = init.targetAddressSpace ?? 'loopback';
+  return fetch(input, {
+    ...init,
+    targetAddressSpace,
+  });
+}
+
+/**
+ * Fetches a resource on either the local network or loopback interface,
+ * automatically setting `targetAddressSpace` to `'local'` or `'loopback'`.
+ */
+export async function fetchPrivateResource(
+  input: RequestInfo | URL,
+  init: LocalNetworkRequestInit = {}
+): Promise<Response> {
+  const targetAddressSpace =
+    init.targetAddressSpace ?? inferTargetAddressSpace(input);
+  return fetch(input, {
+    ...init,
+    targetAddressSpace,
+  });
+}
