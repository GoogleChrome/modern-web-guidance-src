+---
+import Layout from '../layouts/Layout.astro';
+import LocalNetworkAccessPanel from '../components/LocalNetworkAccessPanel';
+---
+
+<Layout title="Local Network & Loopback Access | The DevTools Times">
+  <div class="py-8 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
+    <LocalNetworkAccessPanel client:load />
+
+    <section class="mt-8 p-6 bg-gray-50 border border-gray-200 rounded-lg">
+      <h3 class="text-lg font-bold text-gray-900 mb-2">Cross-Origin Hardware Bridge Embed</h3>
+      <p class="text-xs text-gray-600 mb-4">
+        When delegating Local Network Access to an embedded cross-origin iframe, explicitly grant <code class="bg-gray-200 px-1 rounded">allow="local-network; loopback-network"</code> alongside the top-level <code class="bg-gray-200 px-1 rounded">Permissions-Policy</code> header.
+      </p>
+      <iframe
+        src="about:blank"
+        allow="local-network; loopback-network"
+        title="Local Device Bridge"
+        class="w-full h-16 border border-gray-300 rounded bg-white"
+      ></iframe>
+    </section>
+  </div>
+</Layout>
diff --git a/src/utils/localNetworkAccess.ts b/src/utils/localNetworkAccess.ts
