+import React, { useState, useEffect, useCallback } from 'react';
+import {
+  queryLnaPermissionSafe,
+  fetchLocalDeviceStatus,
+  fetchLoopbackDaemon,
+  openLocalWebSocket,
+  type LnaPermissionName,
+} from '../utils/localNetworkAccess';
+
+export default function LocalNetworkAccessPanel() {
+  const [localPermission, setLocalPermission] = useState<PermissionState>('prompt');
+  const [loopbackPermission, setLoopbackPermission] = useState<PermissionState>('prompt');
+
+  const [localUrl, setLocalUrl] = useState('http://192.168.1.100:8080/api/status');
+  const [loopbackUrl, setLoopbackUrl] = useState('http://127.0.0.1:45678/health');
+  const [wsUrl, setWsUrl] = useState('ws://192.168.1.100:8080/stream');
+
+  const [localResult, setLocalResult] = useState<string | null>(null);
+  const [localError, setLocalError] = useState<string | null>(null);
+  const [localLoading, setLocalLoading] = useState(false);
+
+  const [loopbackResult, setLoopbackResult] = useState<string | null>(null);
+  const [loopbackError, setLoopbackError] = useState<string | null>(null);
+  const [loopbackLoading, setLoopbackLoading] = useState(false);
+
+  const [wsStatus, setWsStatus] = useState<string | null>(null);
+
+  const handleConnectLocal = useCallback(async (urlToFetch = localUrl) => {
+    setLocalLoading(true);
+    setLocalError(null);
+    setLocalResult(null);
+    try {
+      const data = await fetchLocalDeviceStatus(urlToFetch);
+      setLocalResult(JSON.stringify(data, null, 2));
+      const updated = await queryLnaPermissionSafe('local-network');
+      setLocalPermission(updated);
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err);
+      setLocalError(
+        `Could not reach local network resource (${message}). Verify that the device at ${urlToFetch} is powered on, connected to the same local network, serves CORS headers (Access-Control-Allow-Origin), and that Local Network permission is allowed.`
+      );
+      const updated = await queryLnaPermissionSafe('local-network');
+      setLocalPermission(updated);
+    } finally {
+      setLocalLoading(false);
+    }
+  }, [localUrl]);
+
+  const handleConnectLoopback = useCallback(async (urlToFetch = loopbackUrl) => {
+    setLoopbackLoading(true);
+    setLoopbackError(null);
+    setLoopbackResult(null);
+    try {
+      const data = await fetchLoopbackDaemon(urlToFetch);
+      setLoopbackResult(JSON.stringify(data, null, 2));
+      const updated = await queryLnaPermissionSafe('loopback-network');
+      setLoopbackPermission(updated);
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err);
+      setLoopbackError(
+        `Could not reach loopback companion service (${message}). Verify that your local daemon at ${urlToFetch} is running on this machine, serves CORS headers (Access-Control-Allow-Origin), and that Loopback Network permission is allowed.`
+      );
+      const updated = await queryLnaPermissionSafe('loopback-network');
+      setLoopbackPermission(updated);
+    } finally {
+      setLoopbackLoading(false);
+    }
+  }, [loopbackUrl]);
+
+  useEffect(() => {
+    let mounted = true;
+
+    async function initPermissions() {
+      const localState = await queryLnaPermissionSafe('local-network', (nextState) => {
+        if (mounted) setLocalPermission(nextState);
+      });
+      if (mounted) {
+        setLocalPermission(localState);
+        // Only auto-connect when permission is already 'granted' (never on 'prompt')
+        if (localState === 'granted') {
+          handleConnectLocal();
+        }
+      }
+
+      const loopbackState = await queryLnaPermissionSafe('loopback-network', (nextState) => {
+        if (mounted) setLoopbackPermission(nextState);
+      });
+      if (mounted) {
+        setLoopbackPermission(loopbackState);
+        // Only auto-connect when permission is already 'granted' (never on 'prompt')
+        if (loopbackState === 'granted') {
+          handleConnectLoopback();
+        }
+      }
+    }
+
+    initPermissions();
+    return () => {
+      mounted = false;
+    };
+  }, [handleConnectLocal, handleConnectLoopback]);
+
+  const handleConnectWebSocket = () => {
+    setWsStatus('Connecting...');
+    try {
+      const socket = openLocalWebSocket(wsUrl);
+      socket.addEventListener('open', () => {
+        setWsStatus('Connected to local WebSocket stream.');
+        socket.close();
+      });
+      socket.addEventListener('error', () => {
+        setWsStatus(
+          'WebSocket connection failed. Ensure the local endpoint is reachable and Local/Loopback Network permission is allowed.'
+        );
+      });
+    } catch (err) {
+      setWsStatus(err instanceof Error ? err.message : 'Failed to open WebSocket.');
+    }
+  };
+
+  const renderBadge = (permissionName: LnaPermissionName, state: PermissionState) => {
+    const colorMap: Record<PermissionState, string> = {
+      granted: 'bg-green-100 text-green-800 border-green-300',
+      prompt: 'bg-amber-100 text-amber-800 border-amber-300',
+      denied: 'bg-red-100 text-red-800 border-red-300',
+    };
+    return (
+      <span
+        data-permission-status={permissionName}
+        className={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border ${colorMap[state]}`}
+      >
+        {state}
+      </span>
+    );
+  };
+
+  return (
+    <section
+      aria-labelledby="lna-heading"
+      className="max-w-4xl mx-auto my-8 p-6 bg-white border border-gray-200 rounded-lg shadow-sm"
+    >
+      <div className="border-b border-gray-200 pb-4 mb-6">
+        <h2 id="lna-heading" className="text-2xl font-brand text-gray-900">
+          Local Network &amp; Loopback Companion Access
+        </h2>
+        <p className="text-sm text-gray-600 mt-1">
+          Connect to local network devices (LAN printers, newsroom hardware bridges) or a local companion daemon on your machine using granular Local Network Access permissions.
+        </p>
+      </div>
+
+      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
+        {/* Local Network Card */}
+        <div className="p-4 border border-gray-200 rounded-md flex flex-col justify-between bg-gray-50">
+          <div>
+            <div className="flex items-center justify-between mb-2">
+              <h3 className="text-base font-bold text-gray-900">Local Network Device</h3>
+              {renderBadge('local-network', localPermission)}
+            </div>
+            <p className="text-xs text-gray-600 mb-3">
+              Permission: <code className="bg-gray-200 px-1 rounded">local-network</code> &middot; Address Space: <code className="bg-gray-200 px-1 rounded">targetAddressSpace: &apos;local&apos;</code>
+            </p>
+
+            {localPermission === 'prompt' && (
+              <p className="text-xs text-gray-700 bg-amber-50 border border-amber-200 p-2.5 rounded mb-3">
+                To discover or check status on your local network printer or IoT display, click the button below. Your browser will ask for <strong>Local network</strong> permission.
+              </p>
+            )}
+
+            <div
+              data-remediation="local-network"
+              hidden={localPermission !== 'denied'}
+              className="text-xs text-red-800 bg-red-50 border border-red-200 p-3 rounded mb-3"
+              role="alert"
+            >
+              <strong>Local Network access is blocked.</strong> To re-enable access, click the site settings icon in your browser&apos;s address bar, set <strong>Local network</strong> to <strong>Allow</strong>, and try again.
+            </div>
+
+            <label htmlFor="local-device-url" className="block text-xs font-medium text-gray-700 mb-1">
+              Local Network Endpoint URL
+            </label>
+            <input
+              id="local-device-url"
+              type="url"
+              value={localUrl}
+              onChange={(e) => setLocalUrl(e.target.value)}
+              className="w-full px-2.5 py-1.5 text-xs border border-gray-300 rounded bg-white mb-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
+            />
+          </div>
+
+          <div>
+            <button
+              type="button"
+              onClick={() => handleConnectLocal(localUrl)}
+              disabled={localLoading}
+              className="w-full py-2 px-3 text-xs font-semibold text-white bg-gray-900 hover:bg-gray-800 rounded transition disabled:opacity-50 cursor-pointer"
+            >
+              {localLoading ? 'Connecting to Local Device...' : 'Connect to Local Network Device'}
+            </button>
+
+            {localResult && (
+              <pre className="mt-3 p-2 text-xs bg-green-50 text-green-900 border border-green-200 rounded overflow-x-auto">
+                {localResult}
+              </pre>
+            )}
+            {localError && (
+              <p className="mt-3 p-2 text-xs bg-red-50 text-red-700 border border-red-200 rounded" role="status">
+                {localError}
+              </p>
+            )}
+          </div>
+        </div>
+
+        {/* Loopback Network Card */}
+        <div className="p-4 border border-gray-200 rounded-md flex flex-col justify-between bg-gray-50">
+          <div>
+            <div className="flex items-center justify-between mb-2">
+              <h3 className="text-base font-bold text-gray-900">Loopback Companion Service</h3>
+              {renderBadge('loopback-network', loopbackPermission)}
+            </div>
+            <p className="text-xs text-gray-600 mb-3">
+              Permission: <code className="bg-gray-200 px-1 rounded">loopback-network</code> &middot; Address Space: <code className="bg-gray-200 px-1 rounded">targetAddressSpace: &apos;loopback&apos;</code>
+            </p>
+
+            {loopbackPermission === 'prompt' && (
+              <p className="text-xs text-gray-700 bg-amber-50 border border-amber-200 p-2.5 rounded mb-3">
+                To sync offline reading lists or telemetry with your local desktop companion service on <code className="bg-amber-100 px-1 rounded">127.0.0.1</code> / <code className="bg-amber-100 px-1 rounded">localhost</code>, click the button below.
+              </p>
+            )}
+
+            <div
+              data-remediation="loopback-network"
+              hidden={loopbackPermission !== 'denied'}
+              className="text-xs text-red-800 bg-red-50 border border-red-200 p-3 rounded mb-3"
+              role="alert"
+            >
+              <strong>Loopback Network access is blocked.</strong> To re-enable access, open your browser&apos;s <strong>Site settings</strong> from the address bar, set <strong>Loopback network</strong> to <strong>Allow</strong>, and retry.
+            </div>
+
+            <label htmlFor="loopback-daemon-url" className="block text-xs font-medium text-gray-700 mb-1">
+              Loopback Companion URL
+            </label>
+            <input
+              id="loopback-daemon-url"
+              type="url"
+              value={loopbackUrl}
+              onChange={(e) => setLoopbackUrl(e.target.value)}
+              className="w-full px-2.5 py-1.5 text-xs border border-gray-300 rounded bg-white mb-3 focus:outline-none focus:ring-2 focus:ring-amber-400"
+            />
+          </div>
+
+          <div>
+            <button
+              type="button"
+              onClick={() => handleConnectLoopback(loopbackUrl)}
+              disabled={loopbackLoading}
+              className="w-full py-2 px-3 text-xs font-semibold text-white bg-gray-900 hover:bg-gray-800 rounded transition disabled:opacity-50 cursor-pointer"
+            >
+              {loopbackLoading ? 'Connecting to Loopback Service...' : 'Connect to Loopback Companion'}
+            </button>
+
+            {loopbackResult && (
+              <pre className="mt-3 p-2 text-xs bg-green-50 text-green-900 border border-green-200 rounded overflow-x-auto">
+                {loopbackResult}
+              </pre>
+            )}
+            {loopbackError && (
+              <p className="mt-3 p-2 text-xs bg-red-50 text-red-700 border border-red-200 rounded" role="status">
+                {loopbackError}
+              </p>
+            )}
+          </div>
+        </div>
+      </div>
+
+      {/* Real-time WebSocket Stream Section */}
+      <div className="mt-6 pt-4 border-t border-gray-200 flex flex-col sm:flex-row sm:items-end gap-3">
+        <div className="flex-grow">
+          <label htmlFor="local-ws-url" className="block text-xs font-medium text-gray-700 mb-1">
+            Local Telemetry WebSocket (<code className="bg-gray-100 px-1 rounded">ws://</code> IP literal, <code className="bg-gray-100 px-1 rounded">.local</code>, or <code className="bg-gray-100 px-1 rounded">localhost</code>)
+          </label>
+          <input
+            id="local-ws-url"
+            type="text"
+            value={wsUrl}
+            onChange={(e) => setWsUrl(e.target.value)}
+            className="w-full px-2.5 py-1.5 text-xs border border-gray-300 rounded bg-white focus:outline-none focus:ring-2 focus:ring-amber-400"
+          />
+        </div>
+        <button
+          type="button"
+          onClick={handleConnectWebSocket}
+          className="py-2 px-4 text-xs font-semibold text-gray-900 bg-amber-400 hover:bg-amber-300 rounded transition whitespace-nowrap cursor-pointer"
+        >
+          Open Local WebSocket
+        </button>
+      </div>
+      {wsStatus && (
+        <p className="mt-2 text-xs text-gray-700" role="status">
+          {wsStatus}
+        </p>
+      )}
+    </section>
+  );
+}
