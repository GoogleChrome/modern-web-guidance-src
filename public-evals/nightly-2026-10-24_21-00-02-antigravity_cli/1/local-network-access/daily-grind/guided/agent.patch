+  <script type="module">
+    /**
+     * Cross-browser permission check for the granular LNA permissions.
+     * Never falls back to querying 'local-network-access', which crashes older Chrome versions.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     */
+    export async function queryLnaPermissionSafe(permissionName) {
+      if (!navigator.permissions?.query) {
+        return 'prompt';
+      }
+      try {
+        const status = await navigator.permissions.query({ name: permissionName });
+        return status.state;
+      } catch {
+        // Unrecognized permission name; proceed on user gesture
+        return 'prompt';
+      }
+    }
+
+    /**
+     * Queries the granular Local Network Access permission for the target space
+     * and keeps UI synchronized with permission state changes.
+     * @param {'local-network' | 'loopback-network'} permissionName
+     */
+    export async function checkNetworkPermission(permissionName) {
+      if (!navigator.permissions?.query) {
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+      try {
+        const status = await navigator.permissions.query({ name: permissionName });
+
+        // Keep UI synchronized if the user changes permission in browser site settings
+        status.addEventListener('change', () => {
+          updatePermissionUI(permissionName, status.state);
+        });
+
+        updatePermissionUI(permissionName, status.state);
+        return status.state;
+      } catch {
+        updatePermissionUI(permissionName, 'prompt');
+        return 'prompt';
+      }
+    }
+
+    function updatePermissionUI(permissionName, state) {
+      const statusBadge = document.querySelector(`[data-permission-status="${permissionName}"]`);
+      const remediationBox = document.querySelector(`[data-remediation="${permissionName}"]`);
+      const promptExplainer = document.querySelector(`[data-prompt-explainer="${permissionName}"]`);
+      if (statusBadge) {
+        statusBadge.textContent = state;
+        statusBadge.dataset.state = state;
+      }
+      if (remediationBox) {
+        // Show remediation instructions whenever permission is explicitly denied
+        remediationBox.hidden = state !== 'denied';
+      }
+      if (promptExplainer) {
+        promptExplainer.hidden = state === 'granted';
+      }
+    }
+
+    /**
+     * Connects to a local network device (e.g., LAN brewer, printer, or IoT hub) over HTTP.
+     * @param {string} [deviceUrl='http://192.168.1.100:8080/api/status']
+     */
+    export async function fetchLocalDeviceStatus(deviceUrl = 'http://192.168.1.100:8080/api/status') {
+      const request = new Request(deviceUrl, {
+        method: 'GET',
+        mode: 'cors',
+        // MANDATORY: Declare 'local' when targeting RFC 1918 / .local LAN addresses
+        targetAddressSpace: 'local',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Device responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Connects to a local companion daemon running on the user's loopback interface.
+     * @param {string} [daemonUrl='http://127.0.0.1:45678/health']
+     */
+    export async function fetchLoopbackDaemon(daemonUrl = 'http://127.0.0.1:45678/health') {
+      const request = new Request(daemonUrl, {
+        method: 'GET',
+        mode: 'cors',
+        // MANDATORY: Declare 'loopback' when targeting 127.0.0.1, [::1], or localhost
+        targetAddressSpace: 'loopback',
+      });
+
+      const response = await fetch(request);
+      if (!response.ok) {
+        throw new Error(`Companion app responded with HTTP ${response.status}`);
+      }
+      return response.json();
+    }
+
+    /**
+     * Opens a WebSocket connection to a local network device (IP literal, .local, or localhost).
+     * @param {string} [wsUrl='ws://192.168.1.100:8080/stream']
+     */
+    export function openLocalWebSocket(wsUrl = 'ws://192.168.1.100:8080/stream') {
+      // Pass only subprotocol string(s) as the second argument (never an options object).
+      // Browsers exempt ws:// from Mixed Content when the host is a local/loopback IP literal,
+      // .local, or localhost, and gate the connection on 'local-network' or 'loopback-network'.
+      const socket = new WebSocket(wsUrl, ['v1.telemetry']);
+      return socket;
+    }
+
+    /**
+     * Opens a WebTransport session to a local network endpoint using a pinned self-signed certificate hash.
+     * @param {string} [wtUrl='https://192.168.1.100:4433/wt']
+     * @param {BufferSource} [certSha256Bytes]
+     */
+    export async function openLocalWebTransport(wtUrl = 'https://192.168.1.100:4433/wt', certSha256Bytes) {
+      const options = certSha256Bytes
+        ? {
+            serverCertificateHashes: [
+              {
+                algorithm: 'sha-256',
+                value: certSha256Bytes,
+              },
+            ],
+          }
+        : undefined;
+      const transport = new WebTransport(wtUrl, options);
+
+      // transport.ready resolves only after the user grants the 'local-network' permission
+      // and rejects with WebTransportError if the permission is denied.
+      await transport.ready;
+      return transport;
+    }
+
+    async function handleLocalDeviceConnect() {
+      const urlInput = document.getElementById('local-device-url');
+      const output = document.getElementById('local-device-output');
+      const deviceUrl = urlInput ? urlInput.value.trim() : 'http://192.168.1.100:8080/api/status';
+
+      if (output) {
+        output.textContent = `Connecting to local network endpoint (${deviceUrl})...`;
+      }
+
+      try {
+        const data = await fetchLocalDeviceStatus(deviceUrl);
+        if (output) {
+          output.textContent = `Connected to local device: ${JSON.stringify(data)}`;
+        }
+        await checkNetworkPermission('local-network');
+      } catch (err) {
+        const state = await checkNetworkPermission('local-network');
+        if (output) {
+          output.textContent =
+            `Local network connection failed (${err instanceof Error ? err.message : String(err)}). ` +
+            'Verify that the local brewer/printer is powered on, connected to the same network, ' +
+            `and allowed in browser site settings (current permission: ${state}).`;
+        }
+      }
+    }
+
+    async function handleLoopbackConnect() {
+      const urlInput = document.getElementById('loopback-daemon-url');
+      const output = document.getElementById('loopback-daemon-output');
+      const daemonUrl = urlInput ? urlInput.value.trim() : 'http://127.0.0.1:45678/health';
+
+      if (output) {
+        output.textContent = `Connecting to loopback companion (${daemonUrl})...`;
+      }
+
+      try {
+        const data = await fetchLoopbackDaemon(daemonUrl);
+        if (output) {
+          output.textContent = `Connected to loopback daemon: ${JSON.stringify(data)}`;
+        }
+        await checkNetworkPermission('loopback-network');
+      } catch (err) {
+        const state = await checkNetworkPermission('loopback-network');
+        if (output) {
+          output.textContent =
+            `Loopback connection failed (${err instanceof Error ? err.message : String(err)}). ` +
+            'Verify that the local companion daemon is running on your machine and allowed in ' +
+            `browser site settings (current permission: ${state}).`;
+        }
+      }
+    }
+
+    function bindWebSocketAction(buttonId, inputId, outputId, permissionName) {
+      const button = document.getElementById(buttonId);
+      const input = document.getElementById(inputId);
+      const output = document.getElementById(outputId);
+      if (!button) return;
+
+      button.addEventListener('click', () => {
+        const wsUrl = input ? input.value.trim() : 'ws://192.168.1.100:8080/stream';
+        if (output) {
+          output.textContent = `Opening WebSocket (${wsUrl})...`;
+        }
+        try {
+          const socket = openLocalWebSocket(wsUrl);
+          socket.addEventListener('open', () => {
+            if (output) {
+              output.textContent = `WebSocket connected to ${wsUrl}.`;
+            }
+            checkNetworkPermission(permissionName);
+          });
+          socket.addEventListener('message', (event) => {
+            if (output) {
+              output.textContent = `Telemetry received: ${String(event.data)}`;
+            }
+          });
+          socket.addEventListener('error', async () => {
+            const state = await checkNetworkPermission(permissionName);
+            if (output) {
+              output.textContent =
+                `WebSocket connection failed for ${wsUrl}. Check that the endpoint is reachable, ` +
+                'connected to the same network, and permitted in browser site settings ' +
+                `(permission: ${state}).`;
+            }
+          });
+        } catch (err) {
+          if (output) {
+            output.textContent = `WebSocket initialization error: ${err instanceof Error ? err.message : String(err)}`;
+          }
+        }
+      });
+    }
+
+    async function initLocalNetworkAccess() {
+      const insecureWarning = document.getElementById('lna-insecure-warning');
+      if (insecureWarning) {
+        insecureWarning.hidden = window.isSecureContext;
+      }
+
+      // Wire explicit user gesture buttons for when permission state is 'prompt'
+      document.getElementById('connect-local-btn')?.addEventListener('click', handleLocalDeviceConnect);
+      document.getElementById('connect-loopback-btn')?.addEventListener('click', handleLoopbackConnect);
+      bindWebSocketAction('stream-local-ws-btn', 'local-ws-url', 'local-device-output', 'local-network');
+      bindWebSocketAction('stream-loopback-ws-btn', 'loopback-ws-url', 'loopback-daemon-output', 'loopback-network');
+
+      // Pre-check granular permission state; only connect automatically when already 'granted'
+      const [localState, loopbackState] = await Promise.all([
+        checkNetworkPermission('local-network'),
+        checkNetworkPermission('loopback-network'),
+      ]);
+
+      if (localState === 'granted') {
+        handleLocalDeviceConnect();
+      }
+      if (loopbackState === 'granted') {
+        handleLoopbackConnect();
+      }
+    }
+
+    // Expose helpers on window for programmatic access or testing
+    Object.assign(window, {
+      queryLnaPermissionSafe,
+      checkNetworkPermission,
+      fetchLocalDeviceStatus,
+      fetchLoopbackDaemon,
+      openLocalWebSocket,
+      openLocalWebTransport,
+    });
+
+    initLocalNetworkAccess();
+  </script>
