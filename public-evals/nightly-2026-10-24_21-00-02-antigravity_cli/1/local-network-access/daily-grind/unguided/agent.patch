@@ -0,0 +1,44 @@
+import { parseArgs } from 'node:util';
+import statikk from 'statikk';
+
+const { values } = parseArgs({
+  options: {
+    port: { type: 'string' },
+    expose: { type: 'boolean' },
+    cors: { type: 'boolean' },
+    coi: { type: 'boolean' },
+    csp: { type: 'string' },
+  },
+  strict: false,
+});
+
+const port = Number(values.port || process.env.PORT || 11222);
+
+const { app, url } = await statikk({
+  ...values,
+  port,
+  cors: true,
+});
+
+// Prepend middleware to set Local Network Access Permissions-Policy and PNA headers
+app.stack.unshift({
+  route: '',
+  handle: (req, res, next) => {
+    res.setHeader(
+      'Permissions-Policy',
+      'local-network-access=*, local-network=*, loopback-network=*'
+    );
+    res.setHeader('Access-Control-Allow-Private-Network', 'true');
+    if (req.method === 'OPTIONS') {
+      res.setHeader('Access-Control-Allow-Origin', req.headers.origin || '*');
+      res.setHeader('Access-Control-Allow-Methods', 'GET, HEAD, PUT, PATCH, POST, DELETE, OPTIONS');
+      res.setHeader('Access-Control-Allow-Headers', req.headers['access-control-request-headers'] || '*');
+      res.statusCode = 204;
+      res.end();
+      return;
+    }
+    next();
+  },
+});
+
+console.log(`Server listening on ${url}`);
