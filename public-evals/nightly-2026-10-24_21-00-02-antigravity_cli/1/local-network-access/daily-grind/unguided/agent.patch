+  <script>
+    async function checkLocalNetworkPermission() {
+      const statusEl = document.getElementById('local-status');
+      if (!navigator.permissions || !navigator.permissions.query) {
+        if (statusEl) statusEl.textContent = 'Permissions API not supported.';
+        return null;
+      }
+
+      const permissionNames = ['local-network-access', 'local-network', 'loopback-network'];
+      const results = {};
+
+      for (const name of permissionNames) {
+        try {
+          const status = await navigator.permissions.query({ name });
+          results[name] = status.state;
+        } catch (err) {
+          // Permission name might not be supported in all browsers
+        }
+      }
+
+      if (statusEl) {
+        const entries = Object.entries(results);
+        statusEl.textContent = entries.length
+          ? entries.map(([k, v]) => `${k}: ${v}`).join(', ')
+          : 'Permission status ready.';
+      }
+      return results;
+    }
+
+    async function fetchLocalResource(url, addressSpace = 'loopback') {
+      const statusEl = document.getElementById('local-status');
+      if (statusEl) statusEl.textContent = `Connecting (${addressSpace})...`;
+
+      try {
+        const response = await fetch(url, {
+          targetAddressSpace: addressSpace,
+        });
+        const data = await response.text();
+        if (statusEl) statusEl.textContent = `Connected (${response.status})`;
+        return data;
+      } catch (error) {
+        if (statusEl) statusEl.textContent = `Connection failed: ${error.message}`;
+        throw error;
+      }
+    }
+
+    window.checkLocalNetworkPermission = checkLocalNetworkPermission;
+    window.fetchLocalResource = fetchLocalResource;
+
+    document.getElementById('connect-local-btn')?.addEventListener('click', () => {
+      const url = document.getElementById('local-endpoint-input').value;
+      const addressSpace = document.getElementById('address-space-select').value;
+      fetchLocalResource(url, addressSpace).catch(() => {});
+    });
+
+    document.getElementById('check-permission-btn')?.addEventListener('click', () => {
+      checkLocalNetworkPermission();
+    });
+  </script>
 </body>
 
