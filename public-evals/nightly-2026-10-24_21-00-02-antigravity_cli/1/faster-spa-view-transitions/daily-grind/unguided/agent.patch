+
+      function normalizePath(rawPath) {
+        if (!rawPath) return '/';
+        const cleaned = rawPath.split('?')[0].split('#')[0].replace(/\/+$/, '');
+        return cleaned || '/';
+      }
+
+      function getOrCreateView(path) {
+        const normalized = normalizePath(path);
+        // Reuse existing cached DOM node so structural DOM state is preserved on revisit
+        if (viewCache.has(normalized)) {
+          return viewCache.get(normalized);
+        }
+
+        const route = routeDefinitions[normalized] || routeDefinitions['/'];
+        const panel = document.createElement('div');
+        panel.className = 'view-panel';
+        panel.setAttribute('data-view', normalized);
+        panel.setAttribute('data-rendered', 'true');
+        panel.appendChild(route.build());
+
+        viewsContainer.appendChild(panel);
+        viewCache.set(normalized, panel);
+        return panel;
+      }
+
+      function navigateTo(path, pushState = true) {
+        const normalized = normalizePath(path);
+        const targetPanel = getOrCreateView(normalized);
+
+        // Hide all other cached views without removing/destroying them from the DOM
+        viewCache.forEach((panel, viewPath) => {
+          if (viewPath === normalized) {
+            panel.hidden = false;
+            panel.classList.add('active-view');
+          } else {
+            panel.hidden = true;
+            panel.classList.remove('active-view');
+          }
+        });
+
+        const route = routeDefinitions[normalized];
+        if (route && route.title) {
+          document.title = route.title;
+        }
+
+        document.querySelectorAll('nav a[data-route]').forEach(link => {
+          const linkRoute = normalizePath(link.getAttribute('href'));
+          const isActive = linkRoute === normalized || (linkRoute !== '/' && normalized.startsWith(linkRoute + '/'));
+          link.classList.toggle('active', isActive);
+        });
+
+        if (pushState && window.location.pathname !== normalized) {
+          window.history.pushState({ path: normalized }, '', normalized);
+        }
+      }
+
+      document.addEventListener('click', (event) => {
+        const anchor = event.target.closest('a[href]');
+        if (!anchor) return;
+        const href = anchor.getAttribute('href');
+        if (!href || href.startsWith('http') || href.startsWith('mailto:') || href.startsWith('#')) {
+          return;
+        }
+        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) {
+          return;
+        }
+        event.preventDefault();
+        navigateTo(href, true);
+      });
+
+      window.addEventListener('popstate', (event) => {
+        const targetPath = (event.state && event.state.path) || window.location.pathname;
+        navigateTo(targetPath, false);
+      });
+
+      // Expose view cache helper for inspection if needed
+      window.__SPA_ROUTER__ = {
+        navigateTo,
+        getCachedViews: () => Array.from(viewCache.keys()),
+        getViewElement: (path) => viewCache.get(normalizePath(path))
+      };
+
+      // Initialize current route view on load
+      navigateTo(window.location.pathname, false);
+    })();
