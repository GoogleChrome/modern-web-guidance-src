+  <script>
+    const ROUTE_TO_VIEW = {
+      '/': 'view-home',
+      '/menu': 'view-menu',
+      '/locations': 'view-locations',
+      '/rewards': 'view-rewards',
+      '/account': 'view-account'
+    };
+
+    // LRU cache for dynamic secondary views to prevent unbounded memory growth
+    const MAX_DYNAMIC_VIEWS = 5;
+    const dynamicViewOrder = [];
+
+    const DYNAMIC_VIEW_CONTENT = {
+      '/order-online': {
+        title: 'Order Online',
+        description: 'Skip the line! Select your favorite handcrafted beverage for express pickup.',
+        ctaText: 'Browse Menu',
+        ctaHref: '/menu'
+      },
+      '/menu/seasonal': {
+        title: 'Maple Oat Latte',
+        description: 'Rich espresso steamed with creamy oat milk and pure Vermont Grade-A maple syrup, topped with cinnamon dust.',
+        ctaText: 'Back to Menu',
+        ctaHref: '/menu'
+      },
+      '/menu/espresso': {
+        title: 'Dark Roast Espresso',
+        description: 'Our signature house blend roasted to a deep, chocolaty finish with notes of smoked cedar and molasses.',
+        ctaText: 'Back to Menu',
+        ctaHref: '/menu'
+      },
+      '/menu/cold-brew': {
+        title: '18-Hour Cold Brew',
+        description: 'Coarse-ground Ethiopian beans steeped in cold filtered water for 18 hours for a velvety, low-acid finish.',
+        ctaText: 'Back to Menu',
+        ctaHref: '/menu'
+      },
+      '/about': {
+        title: 'Our Story',
+        description: 'Founded in 2015, The Daily Grind partners directly with small-lot farmers to roast sustainable, specialty coffee.',
+        ctaText: 'Visit a Cafe',
+        ctaHref: '/locations'
+      },
+      '/careers': {
+        title: 'Join the Team',
+        description: 'We are always looking for passionate baristas, roasters, and community builders.',
+        ctaText: 'View Locations',
+        ctaHref: '/locations'
+      },
+      '/contact': {
+        title: 'Contact Us',
+        description: 'Questions or catering inquiries? Reach us at hello@dailygrind.example or visit any of our cafes.',
+        ctaText: 'Find a Location',
+        ctaHref: '/locations'
+      },
+      '/privacy-policy': {
+        title: 'Privacy Policy',
+        description: 'We respect your privacy and only use your account details to manage your orders and Daily Grind Rewards.',
+        ctaText: 'My Account',
+        ctaHref: '/account'
+      },
+      '/logout': {
+        title: 'Signed Out',
+        description: 'You have been safely signed out of your Daily Grind account. See you tomorrow morning!',
+        ctaText: 'Return Home',
+        ctaHref: '/'
+      }
+    };
+
+    function getOrCreateViewId(path) {
+      const normalized = path.replace(/\/+$/, '') || '/';
+      if (ROUTE_TO_VIEW[normalized]) {
+        return ROUTE_TO_VIEW[normalized];
+      }
+
+      const viewId = 'view-' + normalized.replace(/[^a-z0-9]+/gi, '-').replace(/^-|-$/g, '');
+      let viewEl = document.getElementById(viewId);
+
+      if (!viewEl) {
+        const info = DYNAMIC_VIEW_CONTENT[normalized] || {
+          title: 'The Daily Grind',
+          description: 'Explore our artisanal coffee offerings.',
+          ctaText: 'Back Home',
+          ctaHref: '/'
+        };
+
+        viewEl = document.createElement('div');
+        viewEl.id = viewId;
+        viewEl.className = 'spa-view inactive';
+        viewEl.setAttribute('data-route', normalized);
+        viewEl.setAttribute('tabindex', '-1');
+        viewEl.setAttribute('aria-hidden', 'true');
+        viewEl.innerHTML = `
+          <div class="container">
+            <section class="card">
+              <h3>${info.title}</h3>
+              <p>${info.description}</p>
+              <a href="${info.ctaHref}" class="btn">${info.ctaText}</a>
+            </section>
+          </div>
+        `;
+        document.getElementById('spa-root').appendChild(viewEl);
+      }
+
+      // Update LRU order and evict oldest dynamic view if threshold exceeded
+      const existingIdx = dynamicViewOrder.indexOf(viewId);
+      if (existingIdx !== -1) {
+        dynamicViewOrder.splice(existingIdx, 1);
+      }
+      dynamicViewOrder.push(viewId);
+
+      while (dynamicViewOrder.length > MAX_DYNAMIC_VIEWS) {
+        const evictedId = dynamicViewOrder.shift();
+        const evictedEl = document.getElementById(evictedId);
+        if (evictedEl && evictedEl.classList.contains('inactive')) {
+          evictedEl.remove();
+        }
+      }
+
+      return viewId;
+    }
+
+    function switchToView(viewId, { manageFocus = true } = {}) {
+      const targetView = document.getElementById(viewId);
+      if (!targetView) return;
+
+      // Hide all views while preserving their structural DOM and rendering state
+      document.querySelectorAll('.spa-view').forEach(view => {
+        if (view !== targetView) {
+          view.classList.add('inactive');
+          view.setAttribute('aria-hidden', 'true');
+          view.toggleAttribute('inert', true);
+        }
+      });
+
+      // Show the target view
+      targetView.classList.remove('inactive');
+      targetView.setAttribute('aria-hidden', 'false');
+      targetView.toggleAttribute('inert', false);
+
+      // Update active nav link state
+      const activeRoute = targetView.getAttribute('data-route');
+      document.querySelectorAll('nav a').forEach(link => {
+        if (link.getAttribute('href') === activeRoute) {
+          link.setAttribute('aria-current', 'page');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+
+      // MANDATORY: Move focus to the new view to ensure a logical tab-order
+      if (manageFocus) {
+        targetView.focus({ preventScroll: true });
+      }
+    }
+
+    function navigateTo(path, { pushState = true, manageFocus = true } = {}) {
+      const viewId = getOrCreateViewId(path);
+      if (pushState && window.location.pathname !== path) {
+        window.history.pushState({ viewId, path }, '', path);
+      }
+      switchToView(viewId, { manageFocus });
+    }
+
+    document.addEventListener('click', event => {
+      const link = event.target.closest('a[href]');
+      if (!link) return;
+
+      const url = new URL(link.href, window.location.origin);
+      if (
+        url.origin === window.location.origin &&
+        !link.hasAttribute('download') &&
+        link.target !== '_blank' &&
+        !event.metaKey &&
+        !event.ctrlKey &&
+        !event.shiftKey &&
+        !event.altKey &&
+        event.button === 0
+      ) {
+        event.preventDefault();
+        navigateTo(url.pathname, { pushState: true, manageFocus: true });
+      }
+    });
+
+    window.addEventListener('popstate', event => {
+      const path = (event.state && event.state.path) || window.location.pathname;
+      navigateTo(path, { pushState: false, manageFocus: true });
+    });
+
+    // Sync initial URL on load without stealing initial focus unless non-root
+    if (window.location.pathname !== '/') {
+      navigateTo(window.location.pathname, { pushState: false, manageFocus: false });
+    }
+  </script>
+
