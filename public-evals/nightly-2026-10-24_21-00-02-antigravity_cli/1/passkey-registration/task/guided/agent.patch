+  <script type="importmap">
+    {
+      "imports": {
+        "webauthn-polyfills": "/node_modules/webauthn-polyfills/esm/json_serialization.js"
+      }
+    }
+  </script>
+  <script type="module">
+    import 'webauthn-polyfills';
+
+    const registerButton = document.querySelector('[data-testid="register-button"]');
+    const statusMessage = document.getElementById('passkey-status');
+
+    function setStatus(message) {
+      if (!statusMessage) return;
+      statusMessage.textContent = message;
+      statusMessage.hidden = !message;
+    }
+
+    async function checkPasskeySupport() {
+      if (
+        typeof window.PublicKeyCredential === 'undefined' ||
+        typeof PublicKeyCredential.getClientCapabilities !== 'function'
+      ) {
+        if (registerButton) registerButton.disabled = true;
+        return false;
+      }
+
+      try {
+        const capabilities = await PublicKeyCredential.getClientCapabilities();
+        if (
+          !capabilities.passkeyPlatformAuthenticator ||
+          !capabilities.conditionalGet
+        ) {
+          if (registerButton) registerButton.disabled = true;
+          return false;
+        }
+        if (registerButton) registerButton.disabled = false;
+        return true;
+      } catch (err) {
+        console.error('Failed to check passkey capabilities:', err);
+        if (registerButton) registerButton.disabled = true;
+        return false;
+      }
+    }
+
+    async function signalUnknownCredentialIfSupported(rpId, credentialId) {
+      if (
+        typeof window.PublicKeyCredential !== 'undefined' &&
+        typeof PublicKeyCredential.signalUnknownCredential === 'function' &&
+        rpId &&
+        credentialId
+      ) {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId,
+          credentialId,
+        });
+      }
+    }
+
+    async function registerPasskey(isPromotion = true) {
+      const supported = await checkPasskeySupport();
+      if (!supported) {
+        return;
+      }
+
+      const optionsResponse = await fetch('/api/register/options', {
+        method: 'POST',
+        headers: {
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify({ promotion: isPromotion }),
+      });
+
+      const creationOptionsJSON = await optionsResponse.json();
+      const publicKey =
+        PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+      const rpId =
+        (creationOptionsJSON.rp && creationOptionsJSON.rp.id) ||
+        (publicKey.rp && publicKey.rp.id) ||
+        window.location.hostname;
+
+      let credential;
+      try {
+        credential = await navigator.credentials.create({ publicKey });
+      } catch (err) {
+        if (err.name === 'InvalidStateError') {
+          console.log('A passkey already exists for this account.');
+          setStatus('A passkey already exists for this account.');
+        } else if (err.name === 'SecurityError') {
+          console.error('Configuration RP ID or Secure Context error.');
+          setStatus('Configuration RP ID or Secure Context error.');
+        } else if (err.name === 'NotAllowedError') {
+          console.log('User cancelled the passkey dialog.');
+          setStatus('Passkey creation was cancelled.');
+        } else if (err.name === 'AbortError') {
+          console.log('The creation operation has been aborted.');
+          setStatus('The creation operation has been aborted.');
+        } else {
+          console.error('Passkey creation failed:', err);
+          setStatus('Passkey creation failed.');
+        }
+        return;
+      }
+
+      if (!credential) {
+        return;
+      }
+
+      const encodedResponse =
+        typeof credential.toJSON === 'function' ? credential.toJSON() : credential;
+
+      try {
+        const response = await fetch('/api/register/verify', {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+          },
+          body: JSON.stringify(encodedResponse),
+        });
+
+        if (!response.ok) {
+          await signalUnknownCredentialIfSupported(rpId, encodedResponse.id);
+          setStatus('Failed to verify passkey registration.');
+          return;
+        }
+
+        setStatus('Passkey registered successfully.');
+      } catch (serverErr) {
+        console.error('Server verification network failure:', serverErr);
+        await signalUnknownCredentialIfSupported(rpId, encodedResponse.id);
+        setStatus('Network error during passkey verification.');
+      }
+    }
+
+    checkPasskeySupport();
+
+    if (registerButton) {
+      registerButton.addEventListener('click', () => {
+        registerPasskey(true);
+      });
+    }
+  </script>
 </body>
 
