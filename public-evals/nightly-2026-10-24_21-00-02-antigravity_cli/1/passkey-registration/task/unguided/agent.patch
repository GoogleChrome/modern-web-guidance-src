+  <script>
+    (function () {
+      const promoSection = document.getElementById('passkey-promo-section');
+      const registerBtn = document.querySelector('[data-testid="register-button"]');
+      const statusEl = document.getElementById('passkey-status');
+
+      function setStatus(message, type) {
+        if (!statusEl) return;
+        statusEl.textContent = message;
+        statusEl.className = 'passkey-status' + (type ? ' ' + type : '');
+        statusEl.hidden = !message;
+      }
+
+      function base64UrlToUint8Array(base64url) {
+        const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+        const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+        const rawData = window.atob(base64);
+        const outputArray = new Uint8Array(rawData.length);
+        for (let i = 0; i < rawData.length; ++i) {
+          outputArray[i] = rawData.charCodeAt(i);
+        }
+        return outputArray;
+      }
+
+      function bufferToBase64Url(buffer) {
+        if (!buffer) return null;
+        const bytes = new Uint8Array(buffer);
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return window.btoa(binary)
+          .replace(/\+/g, '-')
+          .replace(/\//g, '_')
+          .replace(/=+$/g, '');
+      }
+
+      function parseCreationOptions(rawOptions) {
+        const options = rawOptions && rawOptions.publicKey ? rawOptions.publicKey : rawOptions;
+
+        if (typeof PublicKeyCredential !== 'undefined' &&
+            typeof PublicKeyCredential.parseCreationOptionsFromJSON === 'function') {
+          try {
+            return PublicKeyCredential.parseCreationOptionsFromJSON(options);
+          } catch (_) {
+            // Fall through to manual conversion if options are not strictly conforming JSON
+          }
+        }
+
+        const parsed = Object.assign({}, options);
+        if (typeof parsed.challenge === 'string') {
+          parsed.challenge = base64UrlToUint8Array(parsed.challenge);
+        }
+        if (parsed.user && typeof parsed.user.id === 'string') {
+          parsed.user = Object.assign({}, parsed.user, {
+            id: base64UrlToUint8Array(parsed.user.id)
+          });
+        }
+        if (Array.isArray(parsed.excludeCredentials)) {
+          parsed.excludeCredentials = parsed.excludeCredentials.map(function (cred) {
+            return Object.assign({}, cred, {
+              id: typeof cred.id === 'string' ? base64UrlToUint8Array(cred.id) : cred.id
+            });
+          });
+        }
+        return parsed;
+      }
+
+      function serializeCredential(credential) {
+        if (typeof credential.toJSON === 'function') {
+          return credential.toJSON();
+        }
+
+        const response = credential.response;
+        const serializedResponse = {
+          clientDataJSON: bufferToBase64Url(response.clientDataJSON),
+          attestationObject: bufferToBase64Url(response.attestationObject)
+        };
+
+        if (typeof response.getTransports === 'function') {
+          serializedResponse.transports = response.getTransports();
+        }
+        if (typeof response.getPublicKeyAlgorithm === 'function') {
+          serializedResponse.publicKeyAlgorithm = response.getPublicKeyAlgorithm();
+        }
+        if (typeof response.getPublicKey === 'function') {
+          const pk = response.getPublicKey();
+          if (pk) {
+            serializedResponse.publicKey = bufferToBase64Url(pk);
+          }
+        }
+        if (typeof response.getAuthenticatorData === 'function') {
+          const authData = response.getAuthenticatorData();
+          if (authData) {
+            serializedResponse.authenticatorData = bufferToBase64Url(authData);
+          }
+        }
+
+        return {
+          id: credential.id,
+          rawId: bufferToBase64Url(credential.rawId),
+          type: credential.type,
+          authenticatorAttachment: credential.authenticatorAttachment || undefined,
+          response: serializedResponse,
+          clientExtensionResults: typeof credential.getClientExtensionResults === 'function'
+            ? credential.getClientExtensionResults()
+            : {}
+        };
+      }
+
+      // Feature detection: check if WebAuthn and platform authenticator are available
+      async function checkPasskeySupport() {
+        if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.create) {
+          if (promoSection) promoSection.hidden = true;
+          return false;
+        }
+
+        if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+          try {
+            const available = await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+            if (!available && promoSection) {
+              promoSection.hidden = true;
+              return false;
+            }
+          } catch (_) {
+            // Keep visible if availability check fails unexpectedly
+          }
+        }
+        return true;
+      }
+
+      checkPasskeySupport();
+
+      if (registerBtn) {
+        registerBtn.addEventListener('click', async function () {
+          setStatus('', '');
+          registerBtn.disabled = true;
+
+          try {
+            if (!window.PublicKeyCredential || !navigator.credentials || !navigator.credentials.create) {
+              throw new Error('Passkeys are not supported on this browser or device.');
+            }
+
+            const optionsRes = await fetch('/api/register/options', {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json'
+              },
+              credentials: 'same-origin',
+              body: JSON.stringify({ promotion: true })
+            });
+
+            if (!optionsRes.ok) {
+              let errMsg = 'Failed to fetch passkey registration options.';
+              try {
+                const errData = await optionsRes.json();
+                if (errData && (errData.error || errData.message)) {
+                  errMsg = errData.error || errData.message;
+                }
+              } catch (_) {}
+              throw new Error(errMsg);
+            }
+
+            const rawOptions = await optionsRes.json();
+            const publicKey = parseCreationOptions(rawOptions);
+
+            const credential = await navigator.credentials.create({ publicKey: publicKey });
+            if (!credential) {
+              throw new Error('Passkey creation did not return a credential.');
+            }
+
+            const verifyRes = await fetch('/api/register/verify', {
+              method: 'POST',
+              headers: {
+                'Content-Type': 'application/json'
+              },
+              credentials: 'same-origin',
+              body: JSON.stringify(serializeCredential(credential))
+            });
+
+            if (!verifyRes.ok) {
+              let verifyErrMsg = 'Passkey verification failed.';
+              try {
+                const verifyErrData = await verifyRes.json();
+                if (verifyErrData && (verifyErrData.error || verifyErrData.message)) {
+                  verifyErrMsg = verifyErrData.error || verifyErrData.message;
+                }
+              } catch (_) {}
+              throw new Error(verifyErrMsg);
+            }
+
+            setStatus('Passkey registered successfully!', 'success');
+          } catch (err) {
+            if (err && err.name === 'InvalidStateError') {
+              setStatus('A passkey is already registered for this device.', 'error');
+            } else if (err && err.name === 'NotAllowedError') {
+              setStatus('Passkey creation was cancelled or not allowed.', 'error');
+            } else {
+              setStatus((err && err.message) ? err.message : 'An error occurred during passkey registration.', 'error');
+            }
+          } finally {
+            registerBtn.disabled = false;
+          }
+        });
+      }
+    })();
+  </script>
