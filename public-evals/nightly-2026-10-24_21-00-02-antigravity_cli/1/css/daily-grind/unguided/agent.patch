+/* ==========================================================================
+   Layer Order Declaration
+   ========================================================================== */
+@layer reset, tokens, base, layout, components, utilities;
+
+/* ==========================================================================
+   1. Reset Layer (@layer reset)
+   ========================================================================== */
+@layer reset {
+  *,
+  *::before,
+  *::after {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+
+  html {
+    -moz-text-size-adjust: none;
+    -webkit-text-size-adjust: none;
+    text-size-adjust: none;
+    scroll-behavior: smooth;
+  }
+
+  body {
+    min-block-size: 100dvh;
+    line-height: 1.6;
+    -webkit-font-smoothing: antialiased;
+  }
+
+  h1, h2, h3, h4, button, input, label {
+    line-height: 1.2;
+    text-wrap: balance;
+  }
+
+  p, li, figcaption {
+    text-wrap: pretty;
+  }
+
+  ul, ol {
+    list-style: none;
+  }
+
+  img, picture, video, canvas, svg {
+    display: block;
+    max-inline-size: 100%;
+  }
+
+  input, button, textarea, select {
+    font: inherit;
+  }
+
+  a {
+    color: inherit;
+    text-decoration: none;
+  }
+}
+
+/* ==========================================================================
+   2. Design Tokens Layer (@layer tokens)
+   ========================================================================== */
+@layer tokens {
+  :root {
+    /* Primitive Color Palette (Coffee & Warm Earth Tones) */
+    --palette-espresso-900: #2b1b17;
+    --palette-espresso-800: #3e2723;
+    --palette-espresso-700: #4e342e;
+    --palette-espresso-600: #5d4037;
+    --palette-latte-300: #bcaaa4;
+    --palette-latte-200: #d7ccc8;
+    --palette-latte-100: #efebe9;
+    --palette-cream-50: #fafafa;
+    --palette-white: #ffffff;
+    --palette-amber-400: #ffab40;
+    --palette-amber-500: #ff9100;
+
+    /* Semantic Color Tokens */
+    --color-brand-primary: var(--palette-espresso-700);
+    --color-brand-primary-hover: var(--palette-espresso-800);
+    --color-brand-secondary: var(--palette-latte-200);
+    --color-brand-accent: var(--palette-amber-400);
+    --color-brand-accent-hover: var(--palette-amber-500);
+
+    --color-text-main: var(--palette-espresso-800);
+    --color-text-muted: var(--palette-espresso-600);
+    --color-text-inverse: var(--palette-white);
+
+    --color-surface-page: var(--palette-cream-50);
+    --color-surface-card: var(--palette-white);
+    --color-surface-header: var(--palette-espresso-700);
+    --color-surface-footer: var(--palette-latte-200);
+    --color-hero-overlay: rgb(27 17 14 / 0.55);
+
+    --color-border-subtle: var(--palette-latte-100);
+    --color-border-accent: var(--palette-amber-400);
+
+    /* Legacy Token Aliases (for backward compatibility) */
+    --primary: var(--color-brand-primary);
+    --secondary: var(--color-brand-secondary);
+    --accent: var(--color-brand-accent);
+    --text: var(--color-text-main);
+    --light: var(--color-surface-page);
+
+    /* Typography Tokens */
+    --font-family-sans: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif;
+    --font-family-display: Georgia, 'Times New Roman', serif;
+
+    --font-size-xs: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
+    --font-size-sm: clamp(0.875rem, 0.82rem + 0.25vw, 0.95rem);
+    --font-size-base: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
+    --font-size-lg: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
+    --font-size-xl: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
+    --font-size-hero: clamp(2.5rem, 2rem + 2.5vw, 3.75rem);
+
+    --font-weight-regular: 400;
+    --font-weight-medium: 500;
+    --font-weight-semibold: 600;
+    --font-weight-bold: 700;
+
+    --letter-spacing-tight: -0.02em;
+    --letter-spacing-wide: 0.06em;
+
+    --line-height-tight: 1.2;
+    --line-height-base: 1.6;
+
+    /* Spacing Scale */
+    --space-2xs: 0.25rem;  /* 4px */
+    --space-xs: 0.5rem;    /* 8px */
+    --space-sm: 0.75rem;   /* 12px */
+    --space-md: 1rem;      /* 16px */
+    --space-lg: 1.25rem;   /* 20px */
+    --space-xl: 1.5rem;    /* 24px */
+    --space-2xl: 2.5rem;   /* 40px */
+    --space-3xl: 4rem;     /* 64px */
+
+    /* Layout & Sizing */
+    --container-max-width: 68.75rem; /* 1100px */
+    --container-gutter: clamp(1.25rem, 5vw, 3rem);
+    --grid-min-card-size: 16rem; /* 256px */
+
+    /* Border Radius */
+    --radius-sm: 0.25rem;  /* 4px */
+    --radius-md: 0.375rem; /* 6px */
+    --radius-lg: 0.5rem;   /* 8px */
+    --radius-pill: 9999px;
+
+    /* Shadows & Elevation */
+    --shadow-sm: 0 2px 5px rgb(43 27 23 / 0.08);
+    --shadow-md: 0 8px 20px rgb(43 27 23 / 0.12);
+    --shadow-nav: 0 2px 10px rgb(0 0 0 / 0.15);
+
+    /* Transitions & Motion */
+    --ease-standard: cubic-bezier(0.2, 0, 0, 1);
+    --duration-fast: 150ms;
+    --duration-normal: 280ms;
+    --transition-colors:
+      color var(--duration-normal) var(--ease-standard),
+      background-color var(--duration-normal) var(--ease-standard),
+      border-color var(--duration-normal) var(--ease-standard);
+    --transition-transform:
+      transform var(--duration-normal) var(--ease-standard),
+      box-shadow var(--duration-normal) var(--ease-standard);
+
+    /* Z-Index Scale */
+    --z-sticky: 1000;
+  }
+}
+
+/* ==========================================================================
+   3. Base Layer (@layer base)
+   ========================================================================== */
+@layer base {
+  body {
+    font-family: var(--font-family-sans);
+    font-size: var(--font-size-base);
+    line-height: var(--line-height-base);
+    color: var(--color-text-main);
+    background-color: var(--color-surface-page);
+    display: flex;
+    flex-direction: column;
+  }
+
+  main {
+    flex: 1;
+  }
+
+  h1, h2, h3 {
+    color: var(--color-brand-primary);
+    font-weight: var(--font-weight-bold);
+    letter-spacing: var(--letter-spacing-tight);
+  }
+
+  h2 {
+    font-size: var(--font-size-xl);
+    margin-block-end: var(--space-lg);
+  }
+
+  h3 {
+    font-size: var(--font-size-lg);
+  }
+
+  :focus-visible {
+    outline: 2px solid var(--color-brand-accent);
+    outline-offset: 3px;
+  }
+}
+
+/* ==========================================================================
+   4. Layout Layer (@layer layout)
+   ========================================================================== */
+@layer layout {
+  .container {
+    width: min(100% - (var(--container-gutter) * 2), var(--container-max-width));
+    margin-inline: auto;
+    margin-block: var(--space-2xl);
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--grid-min-card-size)), 1fr));
+    gap: var(--space-lg);
+    margin-block-start: var(--space-lg);
+    container-type: inline-size;
+  }
+
+  .section,
+  main > section {
+    padding-block: var(--space-md);
+
+    & > :is(.section-header, h2) {
+      text-align: center;
+      margin-block-end: var(--space-xl);
+    }
+
+    &:has(> .grid) > h2 {
+      margin-block-end: var(--space-lg);
+    }
+  }
+}
+
+/* ==========================================================================
+   5. Components Layer (@layer components)
+   ========================================================================== */
+@layer components {
+  /* ------------------------------------------------------------------------
+     Site Navigation Scoped Component
+     ------------------------------------------------------------------------ */
+  @scope (.site-nav, body > nav) {
+    :scope {
+      background-color: var(--color-surface-header);
+      color: var(--color-text-inverse);
+      padding-block: var(--space-md);
+      padding-inline: var(--container-gutter);
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: center;
+      gap: var(--space-md);
+      position: sticky;
+      inset-block-start: 0;
+      z-index: var(--z-sticky);
+      box-shadow: var(--shadow-nav);
+    }
+
+    .logo {
+      font-size: var(--font-size-lg);
+      font-weight: var(--font-weight-bold);
+      letter-spacing: var(--letter-spacing-wide);
+      text-transform: uppercase;
+      color: var(--color-text-inverse);
+      transition: var(--transition-colors);
+
+      &:is(:hover, :focus-visible) {
+        color: var(--color-brand-accent);
+      }
+    }
+
+    :is(.nav-list, ul) {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: var(--space-lg);
+    }
+
+    :is(.nav-link, a:not(.logo)) {
+      color: var(--color-text-inverse);
+      font-size: var(--font-size-sm);
+      font-weight: var(--font-weight-medium);
+      transition: var(--transition-colors);
+
+      &:is(:hover, :focus-visible) {
+        color: var(--color-brand-accent);
+      }
+
+      &:is([data-variant="outlined"], .logout-link) {
+        border: 1px solid var(--color-border-accent);
+        padding-block: var(--space-2xs);
+        padding-inline: var(--space-sm);
+        border-radius: var(--radius-sm);
+
+        &:is(:hover, :focus-visible) {
+          background-color: var(--color-brand-accent);
+          color: var(--palette-espresso-900);
+        }
+      }
+    }
+  }
+
+  /* ------------------------------------------------------------------------
+     Hero Banner Scoped Component
+     ------------------------------------------------------------------------ */
+  @scope (.hero) {
+    :scope {
+      --hero-bg-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+      min-block-size: 60vh;
+      background-image:
+        linear-gradient(var(--color-hero-overlay), var(--color-hero-overlay)),
+        var(--hero-bg-image);
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: var(--color-text-inverse);
+      text-align: center;
+      padding-block: var(--space-3xl);
+      padding-inline: var(--container-gutter);
+    }
+
+    h1 {
+      color: var(--color-text-inverse);
+      font-size: var(--font-size-hero);
+      margin-block-end: var(--space-md);
+    }
+
+    p {
+      font-size: var(--font-size-lg);
+      max-inline-size: 55ch;
+      opacity: 0.95;
+    }
+  }
+
+  /* ------------------------------------------------------------------------
+     Menu / Feature Card Scoped Component (to .btn boundary)
+     ------------------------------------------------------------------------ */
+  @scope (.card) to (.btn) {
+    :scope {
+      --card-padding: var(--space-lg);
+      background-color: var(--color-surface-card);
+      padding: var(--card-padding);
+      border-radius: var(--radius-lg);
+      border: 1px solid var(--color-border-subtle);
+      box-shadow: var(--shadow-sm);
+      text-align: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: space-between;
+      align-items: center;
+      transition: var(--transition-transform);
+
+      &:is(:hover, :focus-within) {
+        transform: translateY(-3px);
+        box-shadow: var(--shadow-md);
+      }
+
+      &:has(.btn:focus-visible) {
+        border-color: var(--color-border-accent);
+      }
+    }
+
+    h3 {
+      margin-block-end: var(--space-xs);
+      color: var(--color-brand-primary);
+    }
+
+    p {
+      color: var(--color-text-muted);
+      font-size: var(--font-size-sm);
+      max-inline-size: 40ch;
+    }
+  }
+
+  /* ------------------------------------------------------------------------
+     Button Component
+     ------------------------------------------------------------------------ */
+  .btn {
+    --btn-bg: var(--color-brand-primary);
+    --btn-bg-hover: var(--color-brand-primary-hover);
+    --btn-text: var(--color-text-inverse);
+
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    background-color: var(--btn-bg);
+    color: var(--btn-text);
+    font-weight: var(--font-weight-semibold);
+    padding-block: var(--space-xs);
+    padding-inline: var(--space-lg);
+    border-radius: var(--radius-md);
+    margin-block-start: var(--space-md);
+    transition: var(--transition-colors), var(--transition-transform);
+    cursor: pointer;
+
+    &:is(:hover, :focus-visible) {
+      background-color: var(--btn-bg-hover);
+    }
+
+    &:active {
+      transform: translateY(1px);
+    }
+
+    &[data-variant="accent"] {
+      --btn-bg: var(--color-brand-accent);
+      --btn-bg-hover: var(--color-brand-accent-hover);
+      --btn-text: var(--palette-espresso-900);
+    }
+  }
+
+  /* ------------------------------------------------------------------------
+     Site Footer Scoped Component
+     ------------------------------------------------------------------------ */
+  @scope (.site-footer, body > footer) {
+    :scope {
+      background-color: var(--color-surface-footer);
+      color: var(--color-text-main);
+      text-align: center;
+      padding-block: var(--space-2xl);
+      padding-inline: var(--container-gutter);
+      margin-block-start: var(--space-2xl);
+    }
+
+    .footer-links {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      align-items: center;
+      margin-block-end: var(--space-lg);
+      gap: var(--space-xs);
+
+      & a {
+        margin-inline: var(--space-xs);
+        color: var(--color-text-main);
+        font-size: var(--font-size-xs);
+        font-weight: var(--font-weight-medium);
+        transition: var(--transition-colors);
+
+        &:not(:last-child)::after {
+          content: "|";
+          margin-inline-start: calc(var(--space-xs) * 2);
+          opacity: 0.5;
+          pointer-events: none;
+          display: inline-block;
+          text-decoration: none;
+        }
+
+        &:is(:hover, :focus-visible) {
+          color: var(--color-brand-primary);
+          text-decoration: underline;
+          text-underline-offset: 0.25em;
+        }
+      }
+    }
+
+    :is(.copyright, p) {
+      font-size: var(--font-size-sm);
+      color: var(--color-text-muted);
+    }
+  }
+}
+
+/* ==========================================================================
+   6. Utilities Layer (@layer utilities)
+   ========================================================================== */
+@layer utilities {
+  .text-center {
+    text-align: center;
+  }
+
+  .visually-hidden {
+    position: absolute;
+    inline-size: 1px;
+    block-size: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+  }
+}
