+  <script>
+    (function () {
+      var nav = document.querySelector('nav');
+      if (!nav) return;
+
+      var logo = nav.querySelector('.logo');
+      var links = nav.querySelectorAll('a');
+      var logoutLink = nav.querySelector('.logout-link');
+      var maxScroll = 150;
+      var supportsScrollTimeline = typeof CSS !== 'undefined' && CSS.supports && CSS.supports('animation-timeline: scroll()');
+
+      function updateNavOnScroll() {
+        var scrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
+        var progress = Math.min(Math.max(scrollY / maxScroll, 0), 1);
+
+        if (scrollY > 20) {
+          nav.classList.add('scrolled');
+        } else {
+          nav.classList.remove('scrolled');
+        }
+
+        // Smooth scroll-linked fallback for older browsers that don't support CSS animation-timeline: scroll()
+        if (!supportsScrollTimeline) {
+          var padY = 1.5 - (1.0 * progress);
+          var shadowAlpha = 0.1 + (0.15 * progress);
+          var shadowBlur = 4 + (8 * progress);
+          nav.style.paddingTop = padY.toFixed(3) + 'rem';
+          nav.style.paddingBottom = padY.toFixed(3) + 'rem';
+          nav.style.boxShadow = '0 4px ' + shadowBlur.toFixed(1) + 'px rgba(0, 0, 0, ' + shadowAlpha.toFixed(3) + ')';
+
+          if (logo) {
+            var logoSize = 1.5 - (0.35 * progress);
+            logo.style.fontSize = logoSize.toFixed(3) + 'rem';
+          }
+
+          var linkSize = (0.9 - (0.05 * progress)).toFixed(3) + 'rem';
+          for (var i = 0; i < links.length; i++) {
+            links[i].style.fontSize = linkSize;
+          }
+
+          if (logoutLink) {
+            var btnPadY = 5 - (2 * progress);
+            var btnPadX = 12 - (2 * progress);
+            logoutLink.style.padding = btnPadY.toFixed(1) + 'px ' + btnPadX.toFixed(1) + 'px';
+          }
+        }
+      }
+
+      var ticking = false;
+      window.addEventListener('scroll', function () {
+        if (!ticking) {
+          if (window.requestAnimationFrame) {
+            window.requestAnimationFrame(function () {
+              updateNavOnScroll();
+              ticking = false;
+            });
+          } else {
+            updateNavOnScroll();
+            ticking = false;
+          }
+          ticking = true;
+        }
+      }, { passive: true });
+
+      updateNavOnScroll();
+    })();
+  </script>
