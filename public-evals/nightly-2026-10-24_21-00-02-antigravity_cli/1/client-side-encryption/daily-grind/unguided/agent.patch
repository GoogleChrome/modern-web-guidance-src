+          encapsulationData = {
+            mechanism: 'ECDH P-256 Ephemeral-Static Key Agreement + HKDF-SHA-256',
+            classicalAlgorithm: 'ECDH-P256',
+            ephemeralP256PublicKey: toBase64(ephP256PubRaw),
+            hkdfSalt: toBase64(salt.buffer),
+            hkdfInfo: spec.infoContext
+          };
+          ephemeralInternal = {
+            ephP256PublicKey: ephP256.publicKey,
+            salt: salt.buffer
+          };
+        }
+
+        // Encrypt customer note with Authenticated Encryption (AES-256-GCM with 128-bit auth tag and AAD)
+        const plaintextBytes = textEncoder.encode(plaintextNote);
+        const ciphertextBuffer = await subtle.encrypt(
+          {
+            name: 'AES-GCM',
+            iv: iv,
+            additionalData: aadBytes,
+            tagLength: 128
+          },
+          aesKey,
+          plaintextBytes
+        );
+
+        const cipherBytes = new Uint8Array(ciphertextBuffer);
+        const tagByteLength = 16; // 128-bit authentication tag
+        const encryptedBody = cipherBytes.slice(0, cipherBytes.byteLength - tagByteLength);
+        const authTag = cipherBytes.slice(cipherBytes.byteLength - tagByteLength);
+
+        const publicEnvelope = {
+          protocol: 'DailyGrind-EncryptedDeliveryNote/1.0',
+          createdAt: timestamp,
+          mode: mode,
+          keyEstablishment: encapsulationData,
+          aead: {
+            algorithm: 'AES-256-GCM',
+            iv: toBase64(iv.buffer),
+            aad: toBase64(aadBytes.buffer),
+            aadDecoded: aadObject,
+            ciphertext: toBase64(encryptedBody.buffer),
+            authTag: toBase64(authTag.buffer),
+            combinedCiphertextWithTag: toBase64(ciphertextBuffer)
+          }
+        };
+
+        return {
+          publicEnvelope,
+          ephemeralInternal
+        };
+      }
+
+      async function decapsulateAndDecrypt(record) {
+        const { publicEnvelope, ephemeralInternal } = record;
+        const mode = publicEnvelope.mode;
+        const spec = MODE_SPECS[mode] || MODE_SPECS['hybrid-x25519-mlkem768'];
+
+        let aesKey;
+
+        if (mode === 'hybrid-x25519-mlkem768') {
+          const x25519SharedBits = await subtle.deriveBits(
+            { name: 'X25519', public: ephemeralInternal.ephX25519PublicKey },
+            state.courierKeys.x25519.privateKey,
+            256
+          );
+          const pqSharedBits = await subtle.decapsulateBits(
+            { name: 'ML-KEM-768' },
+            state.courierKeys.mlkem768.privateKey,
+            ephemeralInternal.mlKemCiphertext
+          );
+          const hybridSecret = concatBuffers(x25519SharedBits, pqSharedBits);
+          aesKey = await deriveAesGcmKeyFromSecret(hybridSecret, ephemeralInternal.salt, spec.infoContext);
+        } else if (mode === 'pq-mlkem768') {
+          aesKey = await subtle.decapsulateKey(
+            { name: 'ML-KEM-768' },
+            state.courierKeys.mlkem768.privateKey,
+            ephemeralInternal.mlKemCiphertext,
+            { name: 'AES-GCM', length: 256 },
+            false,
+            ['encrypt', 'decrypt']
+          );
+        } else if (mode === 'pq-mlkem1024') {
+          const pqSharedBits1024 = await subtle.decapsulateBits(
+            { name: 'ML-KEM-1024' },
+            state.courierKeys.mlkem1024.privateKey,
+            ephemeralInternal.mlKemCiphertext
+          );
+          aesKey = await deriveAesGcmKeyFromSecret(pqSharedBits1024, ephemeralInternal.salt, spec.infoContext);
+        } else if (mode === 'classical-x25519') {
+          const x25519Bits = await subtle.deriveBits(
+            { name: 'X25519', public: ephemeralInternal.ephX25519PublicKey },
+            state.courierKeys.x25519.privateKey,
+            256
+          );
+          aesKey = await deriveAesGcmKeyFromSecret(x25519Bits, ephemeralInternal.salt, spec.infoContext);
+        } else if (mode === 'classical-p256') {
+          const p256Bits = await subtle.deriveBits(
+            { name: 'ECDH', public: ephemeralInternal.ephP256PublicKey },
+            state.courierKeys.p256.privateKey,
+            256
+          );
+          aesKey = await deriveAesGcmKeyFromSecret(p256Bits, ephemeralInternal.salt, spec.infoContext);
+        }
+
+        const ivBuffer = fromBase64(publicEnvelope.aead.iv);
+        const aadBuffer = fromBase64(publicEnvelope.aead.aad);
+        const combinedCiphertextBuffer = fromBase64(publicEnvelope.aead.combinedCiphertextWithTag);
+
+        const decryptedBuffer = await subtle.decrypt(
+          {
+            name: 'AES-GCM',
+            iv: new Uint8Array(ivBuffer),
+            additionalData: new Uint8Array(aadBuffer),
+            tagLength: 128
+          },
+          aesKey,
+          combinedCiphertextBuffer
+        );
+
+        return textDecoder.decode(decryptedBuffer);
+      }
+
+      async function updateModeMetadata() {
+        const modeSelect = document.getElementById('kem-mode');
+        const mode = modeSelect.value;
+        const spec = MODE_SPECS[mode] || MODE_SPECS['hybrid-x25519-mlkem768'];
+
+        document.getElementById('active-mode-label').textContent = spec.label;
+        document.getElementById('kdf-label').textContent = spec.kdfLabel;
+
+        const keyBuffers = [];
+        if (mode === 'hybrid-x25519-mlkem768') {
+          if (state.courierKeys.x25519PubBytes) keyBuffers.push(state.courierKeys.x25519PubBytes);
+          if (state.courierKeys.mlkem768PubBytes) keyBuffers.push(state.courierKeys.mlkem768PubBytes);
+        } else if (mode === 'pq-mlkem768') {
+          if (state.courierKeys.mlkem768PubBytes) keyBuffers.push(state.courierKeys.mlkem768PubBytes);
+        } else if (mode === 'pq-mlkem1024') {
+          if (state.courierKeys.mlkem1024PubBytes) keyBuffers.push(state.courierKeys.mlkem1024PubBytes);
+        } else if (mode === 'classical-x25519') {
+          if (state.courierKeys.x25519PubBytes) keyBuffers.push(state.courierKeys.x25519PubBytes);
+        } else if (mode === 'classical-p256') {
+          if (state.courierKeys.p256PubBytes) keyBuffers.push(state.courierKeys.p256PubBytes);
+        }
+
+        if (keyBuffers.length > 0) {
+          const fp = await computeKeyFingerprint(keyBuffers);
+          document.getElementById('recipient-key-fp').textContent = fp;
+        } else {
+          document.getElementById('recipient-key-fp').textContent = 'Unavailable';
+        }
+      }
+
+      function setStatus(message, type) {
+        const statusEl = document.getElementById('crypto-status');
+        statusEl.textContent = message;
+        statusEl.className = 'status-banner ' + (type === 'error' ? 'status-error' : type === 'success' ? 'status-success' : 'status-ready');
+      }
+
+      async function handleEncryptSubmit(event) {
+        if (event) event.preventDefault();
+        const mode = document.getElementById('kem-mode').value;
+        const orderRef = document.getElementById('order-reference').value.trim();
+        const noteText = document.getElementById('delivery-note-input').value.trim();
+
+        if (!noteText) {
+          setStatus('Please enter a delivery note to encrypt.', 'error');
+          return;
+        }
+
+        try {
+          const result = await establishKeyAndEncrypt(mode, noteText, orderRef);
+          state.lastEnvelope = result;
+          state.isTampered = false;
+
+          document.getElementById('encrypted-payload-output').textContent = JSON.stringify(result.publicEnvelope, null, 2);
+          document.getElementById('verify-decrypt-btn').disabled = false;
+          document.getElementById('tamper-test-btn').disabled = false;
+          document.getElementById('tamper-test-btn').textContent = 'Simulate Tampering';
+
+          const decryptedText = await decapsulateAndDecrypt(result);
+          const decryptedBox = document.getElementById('decrypted-result-container');
+          decryptedBox.style.display = 'block';
+          document.getElementById('decrypted-note-text').textContent = decryptedText;
+
+          setStatus('Shared secret established & delivery note encrypted with AES-256-GCM authenticated encryption.', 'success');
+        } catch (err) {
+          setStatus('Encryption failed: ' + err.message, 'error');
+        }
+      }
+
+      async function handleVerifyDecrypt() {
+        if (!state.lastEnvelope) return;
+        try {
+          const activeRecord = state.isTampered ? state.tamperedEnvelope : state.lastEnvelope;
+          const plaintext = await decapsulateAndDecrypt(activeRecord);
+          const decryptedBox = document.getElementById('decrypted-result-container');
+          decryptedBox.style.display = 'block';
+          document.getElementById('decrypted-note-text').textContent = plaintext;
+          setStatus('Authenticated decryption verified! Tag & AAD integrity confirmed.', 'success');
+        } catch (err) {
+          document.getElementById('decrypted-result-container').style.display = 'none';
+          setStatus('AEAD Authentication Failed: Ciphertext or Associated Data was tampered with!', 'error');
+        }
+      }
+
+      function handleTamperToggle() {
+        if (!state.lastEnvelope) return;
+        const tamperBtn = document.getElementById('tamper-test-btn');
+
+        if (!state.isTampered) {
+          const cloned = JSON.parse(JSON.stringify(state.lastEnvelope.publicEnvelope));
+          const rawCombined = new Uint8Array(fromBase64(cloned.aead.combinedCiphertextWithTag));
+          rawCombined[0] ^= 0xff; // Flip bits in ciphertext to trigger GCM authentication failure
+          cloned.aead.combinedCiphertextWithTag = toBase64(rawCombined.buffer);
+
+          state.tamperedEnvelope = {
+            publicEnvelope: cloned,
+            ephemeralInternal: state.lastEnvelope.ephemeralInternal
+          };
+          state.isTampered = true;
+          tamperBtn.textContent = 'Restore Valid Envelope';
+          document.getElementById('encrypted-payload-output').textContent = JSON.stringify(cloned, null, 2);
+          setStatus('Simulated 1-byte ciphertext tampering. Click "Decapsulate & Verify" to test AEAD protection.', 'ready');
+        } else {
+          state.isTampered = false;
+          tamperBtn.textContent = 'Simulate Tampering';
+          document.getElementById('encrypted-payload-output').textContent = JSON.stringify(state.lastEnvelope.publicEnvelope, null, 2);
+          setStatus('Restored original authenticated envelope.', 'ready');
+        }
+      }
+
+      function attachListeners() {
+        const form = document.getElementById('encrypted-notes-form');
+        form.addEventListener('submit', handleEncryptSubmit);
+
+        document.getElementById('kem-mode').addEventListener('change', async () => {
+          await updateModeMetadata();
+          await handleEncryptSubmit();
+        });
+
+        document.getElementById('rotate-keys-btn').addEventListener('click', async () => {
+          setStatus('Rotating courier public keys (X25519, P-256, ML-KEM-768, ML-KEM-1024)...', 'ready');
+          await generateCourierKeys();
+          await handleEncryptSubmit();
+        });
+
+        document.getElementById('verify-decrypt-btn').addEventListener('click', handleVerifyDecrypt);
+        document.getElementById('tamper-test-btn').addEventListener('click', handleTamperToggle);
+
+        document.querySelectorAll('.chip-btn').forEach((btn) => {
+          btn.addEventListener('click', async () => {
+            const sample = btn.getAttribute('data-sample');
+            if (sample) {
+              document.getElementById('delivery-note-input').value = sample;
+              await handleEncryptSubmit();
+            }
+          });
+        });
+      }
+
+      window.DailyGrindCrypto = {
+        establishKeyAndEncrypt,
+        decapsulateAndDecrypt,
+        generateCourierKeys,
+        getState: () => state
+      };
+
+      document.addEventListener('DOMContentLoaded', async () => {
+        if (!subtle) {
+          setStatus('Web Crypto API is not available in this browser context.', 'error');
+          return;
+        }
+        attachListeners();
+        await generateCourierKeys();
+        await handleEncryptSubmit();
+      });
+    })();
+  </script>
 </body>
 
 </html>
