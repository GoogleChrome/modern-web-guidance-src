+      }
+    });
+
+    decryptBtn.addEventListener('click', async () => {
+      if (!latestEnvelope || !currentRecipient) return;
+      try {
+        const recipientSharedKey = await decapsulateEnvelopeKey(
+          currentRecipient.keyPair.privateKey,
+          latestEnvelope.capsule,
+          PROTOCOL_INFO,
+        );
+
+        const decryptedJson = await decryptMessage(
+          recipientSharedKey,
+          latestEnvelope.iv,
+          latestEnvelope.ciphertext,
+          latestEnvelope.additionalData,
+        );
+
+        const parsed = JSON.parse(decryptedJson);
+        decryptedTextEl.textContent = `[Order ${parsed.orderReference} — ${parsed.address}]: ${parsed.note}`;
+        decryptedBox.hidden = false;
+        setStatus('Decapsulated shared secret and verified AEAD authentication tag + AAD.');
+      } catch (err) {
+        decryptedBox.hidden = true;
+        setStatus(`Decryption / Authentication rejected (${err.name}): ${err.message}`, true);
+      }
+    });
+
+    rotateKeysBtn.addEventListener('click', () => {
+      initRecipient(true);
+    });
+
+    initRecipient(false);
+  </script>
+
 </body>
 
