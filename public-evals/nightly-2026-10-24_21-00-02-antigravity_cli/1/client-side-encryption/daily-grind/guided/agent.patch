+    async function savePersistedKeyPair(keyPair) {
+      const db = await openKeyDatabase();
+      if (!db) return;
+      return new Promise((resolve) => {
+        const tx = db.transaction(IDB_STORE, 'readwrite');
+        const store = tx.objectStore(IDB_STORE);
