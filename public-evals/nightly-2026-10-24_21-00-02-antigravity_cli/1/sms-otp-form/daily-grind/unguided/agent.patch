+  <script>
+    (function () {
+      const form = document.getElementById('phone-verification-form');
+      const phoneInput = document.getElementById('phone-number');
+      const otpInput = document.getElementById('otp-code');
+      const sendCodeBtn = document.getElementById('send-code-btn');
+      const statusEl = document.getElementById('verification-status');
+
+      let activeAbortController = null;
+
+      function updateStatus(message, type) {
+        if (!statusEl) return;
+        statusEl.textContent = message;
+        statusEl.className = 'status-message visible ' + (type || 'info');
+      }
+
+      function extractOtpFromText(text) {
+        if (!text) return null;
+        // Support origin-bound SMS format (e.g., "@example.com #123456") or standard 4-8 digit OTP codes
+        const hashMatch = text.match(/#([0-9]{4,8})\b/);
+        if (hashMatch) return hashMatch[1];
+        const digitsMatch = text.match(/\b([0-9]{6})\b/) || text.match(/\b([0-9]{4,8})\b/);
+        return digitsMatch ? digitsMatch[1] : null;
+      }
+
+      function startWebOtpListener() {
+        if (!('OTPCredential' in window) || !navigator.credentials || typeof navigator.credentials.get !== 'function') {
+          return;
+        }
+
+        if (activeAbortController) {
+          activeAbortController.abort();
+        }
+        activeAbortController = new AbortController();
+
+        navigator.credentials.get({
+          otp: { transport: ['sms'] },
+          signal: activeAbortController.signal
+        }).then(function (otp) {
+          if (otp && otp.code) {
+            otpInput.value = otp.code;
+            otpInput.removeAttribute('aria-invalid');
+            updateStatus('Passcode automatically extracted from SMS and verified!', 'success');
+            if (typeof form.requestSubmit === 'function') {
+              form.requestSubmit();
+            } else {
+              form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
+            }
+          }
+        }).catch(function (err) {
+          // Silently ignore AbortError or unsupported environments
+          if (err && err.name !== 'AbortError') {
+            console.debug('WebOTP error:', err);
+          }
+        });
+      }
+
+      // Initialize WebOTP API on page load
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', startWebOtpListener);
+      } else {
+        startWebOtpListener();
+      }
+
+      // Automatic code extraction when user pastes full SMS text into the OTP input
+      otpInput.addEventListener('paste', function (e) {
+        const clipboardData = e.clipboardData || window.clipboardData;
+        if (!clipboardData) return;
+        const pastedText = clipboardData.getData('text');
+        const extracted = extractOtpFromText(pastedText);
+        if (extracted) {
+          e.preventDefault();
+          otpInput.value = extracted;
+          otpInput.removeAttribute('aria-invalid');
+          updateStatus('Passcode extracted from pasted message.', 'info');
+        }
+      });
+
+      // Sanitize OTP input if full SMS text is autofilled or typed
+      otpInput.addEventListener('input', function () {
+        const val = otpInput.value;
+        if (val.length > 6) {
+          const extracted = extractOtpFromText(val);
+          if (extracted) {
+            otpInput.value = extracted;
+          } else {
+            otpInput.value = val.replace(/\D/g, '').slice(0, 6);
+          }
+        }
+        if (otpInput.value) {
+          otpInput.removeAttribute('aria-invalid');
+        }
+      });
+
+      phoneInput.addEventListener('input', function () {
+        if (phoneInput.value) {
+          phoneInput.removeAttribute('aria-invalid');
+        }
+      });
+
+      // Handle sending SMS verification code
+      sendCodeBtn.addEventListener('click', function () {
+        const phoneValue = phoneInput.value.trim();
+        const phoneRegex = /^\+?[0-9\s\-\(\)]{7,20}$/;
+
+        if (!phoneValue || !phoneRegex.test(phoneValue)) {
+          phoneInput.setAttribute('aria-invalid', 'true');
+          phoneInput.focus();
+          updateStatus('Please enter a valid phone number before requesting an SMS code.', 'error');
+          return;
+        }
+
+        phoneInput.removeAttribute('aria-invalid');
+        updateStatus('A 6-digit verification code has been sent via SMS to ' + phoneValue + '.', 'info');
+        startWebOtpListener();
+        otpInput.focus();
+      });
+
+      // Handle form submission
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        if (activeAbortController) {
+          activeAbortController.abort();
+          activeAbortController = null;
+        }
+
+        const phoneValue = phoneInput.value.trim();
+        const otpValue = otpInput.value.trim();
+        const phoneRegex = /^\+?[0-9\s\-\(\)]{7,20}$/;
+        const otpRegex = /^[0-9]{6}$/;
+
+        if (!phoneValue || !phoneRegex.test(phoneValue)) {
+          phoneInput.setAttribute('aria-invalid', 'true');
+          phoneInput.focus();
+          updateStatus('Please enter a valid phone number.', 'error');
+          return;
+        }
+        phoneInput.removeAttribute('aria-invalid');
+
+        if (!otpValue || !otpRegex.test(otpValue)) {
+          otpInput.setAttribute('aria-invalid', 'true');
+          otpInput.focus();
+          updateStatus('Please enter a valid 6-digit one-time passcode.', 'error');
+          return;
+        }
+        otpInput.removeAttribute('aria-invalid');
+
+        updateStatus('Phone number ' + phoneValue + ' has been successfully verified!', 'success');
+      });
+    })();
+  </script>
+
 </body>
 
