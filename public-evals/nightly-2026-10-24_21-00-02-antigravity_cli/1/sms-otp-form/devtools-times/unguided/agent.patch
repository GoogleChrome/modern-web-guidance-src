+/**
+ * Extracts a 6-digit one-time passcode from raw text or origin-bound SMS messages.
+ * Supports WebOTP origin-bound format (`@domain #123456`) as well as plain 6-digit codes.
+ */
+export function extractOtpFromText(raw: string): string {
+  if (!raw) return '';
+  // Match origin-bound SMS format first: #123456
+  const hashMatch = raw.match(/#(\d{6})\b/);
+  if (hashMatch) {
+    return hashMatch[1];
+  }
+  // Match standalone 6-digit passcode
+  const standaloneMatch = raw.match(/\b(\d{6})\b/);
+  if (standaloneMatch) {
+    return standaloneMatch[1];
+  }
+  // Fallback to stripping non-digits and taking up to 6 digits
+  return raw.replace(/\D/g, '').slice(0, OTP_LENGTH);
+}
