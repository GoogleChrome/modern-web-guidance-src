+  <script>
+    (function () {
+      const roastNames = {
+        1: 'Light (1 / 5)',
+        2: 'Blonde (2 / 5)',
+        3: 'Medium (3 / 5)',
+        4: 'Full City (4 / 5)',
+        5: 'Dark (5 / 5)'
+      };
+
+      const tastingNotesByRoast = {
+        1: 'Bright bergamot, jasmine floral aromatics, and crisp stone-fruit acidity.',
+        2: 'Honeyed pear, lightly toasted grain, and silky caramel sweetness.',
+        3: 'Balanced toasted almond, milk chocolate body, and a smooth citrus finish.',
+        4: 'Rich dark cocoa, roasted hazelnut, and warm baking spice.',
+        5: 'Bold bittersweet chocolate, smoky cedar, and a lingering velvety crema.'
+      };
+
+      function getGrindLabel(microns) {
+        if (microns <= 300) return microns + ' μm · Espresso';
+        if (microns <= 450) return microns + ' μm · AeroPress';
+        if (microns <= 600) return microns + ' μm · Pour-Over';
+        if (microns <= 800) return microns + ' μm · Drip / Chemex';
+        return microns + ' μm · French Press';
+      }
+
+      function getTempLabel(fahrenheit) {
+        const celsius = Math.round(((fahrenheit - 32) * 5) / 9);
+        return fahrenheit + '°F (' + celsius + '°C)';
+      }
+
+      function getSweetnessLabel(percent) {
+        const pumps = Math.round(percent / 25);
+        const pumpWord = pumps === 1 ? 'Pump' : 'Pumps';
+        return percent + '% (' + pumps + ' ' + pumpWord + ')';
+      }
+
+      function updateSliderFillAndAria(slider) {
+        const min = parseFloat(slider.min || '0');
+        const max = parseFloat(slider.max || '100');
+        const val = parseFloat(slider.value || '0');
+        const percentage = max > min ? ((val - min) / (max - min)) * 100 : 0;
+        const clamped = Math.max(0, Math.min(100, percentage));
+
+        slider.style.setProperty('--range-progress', clamped.toFixed(2) + '%');
+        slider.setAttribute('aria-valuenow', String(val));
+
+        let displayValue = String(val);
+        if (slider.id === 'roast-slider') {
+          displayValue = roastNames[val] || ('Level ' + val);
+          const output = document.getElementById('roast-output');
+          const summary = document.getElementById('summary-roast');
+          const notes = document.getElementById('tasting-notes');
+          if (output) output.textContent = displayValue;
+          if (summary) summary.textContent = displayValue;
+          if (notes && tastingNotesByRoast[val]) notes.textContent = tastingNotesByRoast[val];
+        } else if (slider.id === 'grind-slider') {
+          displayValue = getGrindLabel(val);
+          const output = document.getElementById('grind-output');
+          const summary = document.getElementById('summary-grind');
+          if (output) output.textContent = displayValue;
+          if (summary) summary.textContent = displayValue;
+        } else if (slider.id === 'temp-slider') {
+          displayValue = getTempLabel(val);
+          const output = document.getElementById('temp-output');
+          const summary = document.getElementById('summary-temp');
+          if (output) output.textContent = displayValue;
+          if (summary) summary.textContent = displayValue;
+        } else if (slider.id === 'sweetness-slider') {
+          displayValue = getSweetnessLabel(val);
+          const output = document.getElementById('sweetness-output');
+          const summary = document.getElementById('summary-sweetness');
+          if (output) output.textContent = displayValue;
+          if (summary) summary.textContent = displayValue;
+        }
+
+        slider.setAttribute('aria-valuetext', displayValue);
+      }
+
+      const sliders = document.querySelectorAll('input[type="range"]');
+      sliders.forEach(function (slider) {
+        updateSliderFillAndAria(slider);
+        slider.addEventListener('input', function () {
+          updateSliderFillAndAria(slider);
+        });
+        slider.addEventListener('change', function () {
+          updateSliderFillAndAria(slider);
+        });
+      });
+
+      const form = document.getElementById('brew-customizer-form');
+      if (form) {
+        form.addEventListener('reset', function () {
+          requestAnimationFrame(function () {
+            sliders.forEach(updateSliderFillAndAria);
+          });
+        });
+        form.addEventListener('submit', function (e) {
+          e.preventDefault();
+          const notes = document.getElementById('tasting-notes');
+          if (notes) {
+            notes.textContent = 'Brew profile saved! Your custom settings are ready for order.';
+          }
+        });
+      }
+    })();
+  </script>
 </body>
 
