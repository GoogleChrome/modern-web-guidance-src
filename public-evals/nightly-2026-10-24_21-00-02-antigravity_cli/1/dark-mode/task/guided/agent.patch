+        if (mode === 'light' || mode === 'dark') {
+          metaColorScheme.content = mode;
+          rootEl.style.colorScheme = mode;
+          rootEl.dataset.theme = mode;
+          if (persist) {
+            try {
+              localStorage.setItem('color-scheme', mode);
+            } catch (e) {}
+          }
+        } else {
+          metaColorScheme.content = 'light dark';
+          rootEl.style.colorScheme = 'light dark';
+          delete rootEl.dataset.theme;
+          if (persist) {
+            try {
+              localStorage.removeItem('color-scheme');
+            } catch (e) {}
+          }
+        }
+
+        if (themeSelect && themeSelect.value !== mode) {
+          themeSelect.value = mode;
+        }
+      }
+
+      // Initialize from saved preference or default to system
+      let initialMode = 'system';
+      try {
+        const stored = localStorage.getItem('color-scheme');
+        if (stored === 'light' || stored === 'dark') {
+          initialMode = stored;
+        }
+      } catch (e) {}
+
+      updateSystemOptionLabel();
+      applyTheme(initialMode, false);
+
+      themeSelect.addEventListener('change', (e) => {
+        applyTheme(e.target.value, true);
+      });
+
+      // Keep system label updated when OS color scheme changes (without erasing user's stored choice)
+      darkMediaQuery.addEventListener('change', () => {
+        updateSystemOptionLabel();
+      });
+
+      // Sync theme across tabs via storage event
+      window.addEventListener('storage', (e) => {
+        if (e.key === 'color-scheme') {
+          const nextMode = (e.newValue === 'light' || e.newValue === 'dark') ? e.newValue : 'system';
+          applyTheme(nextMode, false);
+        }
+      });
+
+      // Filter late night specials when using the section's select menu
+      const specialsSelect = document.getElementById('specials-category');
+      const specialItems = document.querySelectorAll('#specials-scroll-container .special-item');
+      if (specialsSelect) {
+        specialsSelect.addEventListener('change', (e) => {
+          const category = e.target.value;
+          specialItems.forEach((item) => {
+            item.hidden = category !== 'all' && item.dataset.category !== category;
+          });
+        });
+      }
+    })();
+  </script>
+
 </body>
 
