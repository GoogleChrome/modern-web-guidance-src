+          .scale(canvas.width / 2, -canvas.height / 2, 1); // Stretch to canvas dimensions
+
+        // 4. Multiply: (Clip -> Pixels) * (MVP) * (pixels -> unit square)
+        const screenSpaceTransform = clipToCanvasViewport
+          .multiply(mvpDOM)
+          .multiply(cssToUnitSpace);
+
+        // 5. Synchronize via updateElementGeometry (Chrome 155+) and/or getElementTransform
+        if (typeof canvas.updateElementGeometry === 'function') {
+          try {
+            canvas.updateElementGeometry(targetHTMLElement, {
+              canvasTransform: screenSpaceTransform
+            });
+          } catch (_) {
+            // Ignore if options signature differs
+          }
+        }
+
+        if (typeof canvas.getElementTransform === 'function') {
+          const computedTransform = canvas.getElementTransform(
+            targetHTMLElement,
+            screenSpaceTransform
+          );
+          if (computedTransform) {
+            targetHTMLElement.style.transform = computedTransform.toString();
+            return;
+          }
+        }
+
+        targetHTMLElement.style.transform = screenSpaceTransform.toString();
+      }
+
+      // 4x4 perspective matrix helper
+      function createPerspectiveMatrix(fovRad, aspect, near, far) {
+        const f = 1.0 / Math.tan(fovRad / 2);
+        const nf = 1 / (near - far);
+        return new Float32Array([
+          f / aspect, 0, 0, 0,
+          0, f, 0, 0,
+          0, 0, (far + near) * nf, -1,
+          0, 0, (2 * far * near) * nf, 0
+        ]);
+      }
+
+      // Animation state
+      let isSpinning = true;
+      let rotationY = -0.35;
+      let rotationX = 0.16;
+      let lastTime = performance.now();
+      let currentFrontMVP = null;
+
+      toggleSpinBtn.addEventListener('click', () => {
+        isSpinning = !isSpinning;
+        toggleSpinBtn.textContent = isSpinning ? 'Pause Rotation' : 'Resume Rotation';
+      });
+
+      frontViewBtn.addEventListener('click', () => {
+        rotationY = 0;
+        rotationX = 0.08;
+        renderScene(performance.now());
+      });
+
+      // Listen for the HTML-in-Canvas 'paint' event to upload the live DOM subtree and sync geometry
+      canvas.addEventListener('paint', () => {
+        uploadFormElementToTexture(formElement);
+        if (currentFrontMVP) {
+          syncFormElementTransform(formElement, currentFrontMVP);
+        }
+      });
+
+      function renderScene(now) {
+        const dt = Math.min((now - lastTime) / 1000, 0.1);
+        lastTime = now;
+
+        if (isSpinning) {
+          rotationY += dt * 0.55;
+          rotationX = 0.15 + Math.sin(now * 0.0012) * 0.08;
+        }
+
+        // Upload texture on frame if browser supports direct call outside paint event
+        try {
+          uploadFormElementToTexture(formElement);
+        } catch (_) {
+          // Wait for paint event if restricted outside onpaint
+        }
+
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.enable(gl.DEPTH_TEST);
+        gl.clearColor(0.11, 0.06, 0.05, 1.0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+        gl.useProgram(program);
+
+        const aspect = (canvas.width || 680) / (canvas.height || 520);
+        const projMatrix = new DOMMatrix(Array.from(createPerspectiveMatrix(Math.PI / 4, aspect, 0.1, 100.0)));
+
+        const viewMatrix = new DOMMatrix().translate(0, 0, -3.1);
+
+        const modelMatrix = new DOMMatrix()
+          .rotate(rotationX * (180 / Math.PI), rotationY * (180 / Math.PI), 0)
+          .scale(1.45, 1.45, 1.45);
+
+        const mvpMatrix = projMatrix.multiply(viewMatrix).multiply(modelMatrix);
+        const mvpArray = mvpMatrix.toFloat32Array();
+        const modelArray = modelMatrix.toFloat32Array();
+
+        // MVP for the front (+Z) face at z = 0.5 where the HTML form is projected
+        const frontFaceMVPMatrix = mvpMatrix.multiply(new DOMMatrix().translate(0, 0, 0.5));
+        currentFrontMVP = frontFaceMVPMatrix.toFloat32Array();
+
+        gl.uniformMatrix4fv(uMVPMatrixLoc, false, mvpArray);
+        gl.uniformMatrix4fv(uModelMatrixLoc, false, modelArray);
+        gl.uniform1i(uSamplerLoc, 0);
+
+        // Bind vertex attributes
+        gl.bindBuffer(gl.ARRAY_BUFFER, posBuffer);
+        gl.enableVertexAttribArray(aPositionLoc);
+        gl.vertexAttribPointer(aPositionLoc, 3, gl.FLOAT, false, 0, 0);
+
+        gl.bindBuffer(gl.ARRAY_BUFFER, normBuffer);
+        gl.enableVertexAttribArray(aNormalLoc);
+        gl.vertexAttribPointer(aNormalLoc, 3, gl.FLOAT, false, 0, 0);
+
+        gl.bindBuffer(gl.ARRAY_BUFFER, uvBuffer);
+        gl.enableVertexAttribArray(aTexCoordLoc);
+        gl.vertexAttribPointer(aTexCoordLoc, 2, gl.FLOAT, false, 0, 0);
+
+        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer);
+
+        // Draw front face (+Z) with the live interactive HTML form texture
+        gl.activeTexture(gl.TEXTURE0);
+        gl.bindTexture(gl.TEXTURE_2D, htmlTexture);
+        gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
+
+        // Draw the other 5 faces of the coffee box with the artisanal package texture
+        gl.bindTexture(gl.TEXTURE_2D, packageTexture);
+        gl.drawElements(gl.TRIANGLES, 30, gl.UNSIGNED_SHORT, 6 * 2);
+
+        // Keep the underlying HTML form's hit-testing and CSS transform synced as the box rotates
+        syncFormElementTransform(formElement, currentFrontMVP);
+
+        canvas.requestPaint?.();
+        requestAnimationFrame(renderScene);
+      }
+
+      canvas.requestPaint?.();
+      requestAnimationFrame(renderScene);
+    })();
+  </script>
