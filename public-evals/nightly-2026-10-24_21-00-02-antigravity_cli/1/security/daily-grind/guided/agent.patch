 const path = require('node:path');
+const crypto = require('node:crypto');
 
 const PORT = parseInt(process.env.PORT || '11222', 10);
 const WORK_DIR = __dirname;
 
+function generateNonce() {
+  const bytes = new Uint8Array(16);
+  crypto.getRandomValues(bytes);
+  return btoa(String.fromCharCode(...bytes));
+}
+
+function buildSecurityHeaders(nonce) {
+  const csp = [
+    `script-src 'nonce-${nonce}' 'strict-dynamic' 'report-sample'`,
+    "object-src 'none'",
+    "base-uri 'none'",
+    "frame-ancestors 'self'",
+    "require-trusted-types-for 'script'",
+    "form-action 'self'",
+    'report-to main-endpoint',
+  ].join('; ');
+
+  return {
+    'Reporting-Endpoints':
+      'default="https://reports.example/default", main-endpoint="https://reports.example/main"',
+    'Content-Security-Policy': csp,
+    'Strict-Transport-Security': 'max-age=31536000; includeSubDomains; preload',
+    'X-Frame-Options': 'SAMEORIGIN',
+    'X-Content-Type-Options': 'nosniff',
+    'Referrer-Policy': 'strict-origin-when-cross-origin',
+    'Permissions-Policy':
+      'camera=(), geolocation=(), microphone=(), focus-without-user-activation=()',
+    'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
+    'Cross-Origin-Resource-Policy': 'same-origin',
+    Vary: 'Sec-Fetch-Dest, Sec-Fetch-Mode, Sec-Fetch-Site',
+  };
+}
+
+function isAllowedByFetchMetadata(req) {
+  const site = req.headers['sec-fetch-site'];
+  const mode = req.headers['sec-fetch-mode'];
+  const dest = req.headers['sec-fetch-dest'];
+
+  if (!site) return true; // Fallback for legacy browsers
+  if (['same-origin', 'same-site', 'none'].includes(site)) return true;
+
+  // Allow standard navigate GET requests (link clicks)
+  if (
+    site === 'cross-site' &&
+    mode === 'navigate' &&
+    req.method === 'GET' &&
+    !['object', 'embed'].includes(dest)
+  ) {
+    return true;
+  }
+
+  return false;
+}
+
 const server = http.createServer((req, res) => {
