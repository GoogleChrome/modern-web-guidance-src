+                url: report.url,
+                body: report.body ? report.body.toJSON() : null
+              };
+              console.warn('ReportingObserver report:', payload);
+              if (navigator.sendBeacon) {
+                navigator.sendBeacon('/csp-report', JSON.stringify(payload));
+              }
+            }
+          }, { buffered: true });
