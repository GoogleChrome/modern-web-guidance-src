+    (function () {
+      if (window.trustedTypes && window.trustedTypes.createPolicy) {
+        try {
+          window.trustedTypes.createPolicy('default', {
+            createHTML: (str) => str.replace(/</g, '&lt;').replace(/>/g, '&gt;'),
+            createScriptURL: (url) => {
+              const parsed = new URL(url, window.location.origin);
+              if (parsed.origin === window.location.origin) {
+                return parsed.href;
+              }
+              throw new TypeError('Untrusted script URL blocked by Trusted Types policy.');
+            },
+            createScript: () => {
+              throw new TypeError('Dynamic script evaluation blocked by Trusted Types policy.');
+            }
+          });
+        } catch (e) {
+          // Policy already registered
+        }
+      }
+
+      if ('SecurityPolicyViolationEvent' in window) {
+        document.addEventListener('securitypolicyviolation', (event) => {
+          const payload = {
+            type: 'csp-violation',
+            blockedURI: event.blockedURI,
+            violatedDirective: event.violatedDirective,
+            effectiveDirective: event.effectiveDirective,
+            originalPolicy: event.originalPolicy,
+            disposition: event.disposition,
+            sourceFile: event.sourceFile,
+            lineNumber: event.lineNumber,
+            columnNumber: event.columnNumber,
+            statusCode: event.statusCode,
+            sample: event.sample
+          };
+          console.warn('CSP Violation intercepted:', payload);
+          if (navigator.sendBeacon) {
+            navigator.sendBeacon('/csp-report', JSON.stringify(payload));
+          }
+        });
+      }
+
+      if ('ReportingObserver' in window) {
+        try {
+          const observer = new ReportingObserver((reports) => {
