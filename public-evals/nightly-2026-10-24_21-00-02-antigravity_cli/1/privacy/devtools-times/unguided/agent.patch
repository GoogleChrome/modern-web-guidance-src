diff --git a/src/components/PrivacyPreferences.tsx b/src/components/PrivacyPreferences.tsx
new file mode 100644
index 0000000..125e928
--- /dev/null
+++ b/src/components/PrivacyPreferences.tsx
@@ -0,0 +1,266 @@
+import React, { useState, useEffect } from 'react';
+
+export interface PrivacyConsent {
+  essential: boolean;
+  analytics: boolean;
+  advertising: boolean;
+  updatedAt: string;
+}
+
+const STORAGE_KEY = 'devtools_times_privacy_consent';
+
+const DEFAULT_PREFS: PrivacyConsent = {
+  essential: true,
+  analytics: false,
+  advertising: false,
+  updatedAt: '',
+};
+
+interface Props {
+  baseUrl?: string;
+}
+
+export default function PrivacyPreferences({ baseUrl = '/' }: Props) {
+  const [showBanner, setShowBanner] = useState(false);
+  const [showModal, setShowModal] = useState(false);
+  const [analytics, setAnalytics] = useState(false);
+  const [advertising, setAdvertising] = useState(false);
+  const [dntEnabled, setDntEnabled] = useState(false);
+
+  useEffect(() => {
+    const dnt =
+      navigator.doNotTrack === '1' ||
+      (window as any).doNotTrack === '1' ||
+      (navigator as any).globalPrivacyControl === true;
+    setDntEnabled(Boolean(dnt));
+
+    try {
+      const stored = localStorage.getItem(STORAGE_KEY);
+      if (stored) {
+        const parsed: PrivacyConsent = JSON.parse(stored);
+        setAnalytics(Boolean(parsed.analytics) && !dnt);
+        setAdvertising(Boolean(parsed.advertising) && !dnt);
+        setShowBanner(false);
+      } else if (!dnt) {
+        setShowBanner(true);
+      }
+    } catch {
+      setShowBanner(true);
+    }
+
+    const handleOpenPreferences = () => {
+      setShowModal(true);
+    };
+
+    window.addEventListener('open-privacy-preferences', handleOpenPreferences);
+    return () => {
+      window.removeEventListener('open-privacy-preferences', handleOpenPreferences);
+    };
+  }, []);
+
+  const savePreferences = (newAnalytics: boolean, newAdvertising: boolean) => {
+    const finalAnalytics = dntEnabled ? false : newAnalytics;
+    const finalAdvertising = dntEnabled ? false : newAdvertising;
+
+    const prefs: PrivacyConsent = {
+      essential: true,
+      analytics: finalAnalytics,
+      advertising: finalAdvertising,
+      updatedAt: new Date().toISOString(),
+    };
+
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
+    } catch {
+      // Ignore storage errors
+    }
+
+    setAnalytics(finalAnalytics);
+    setAdvertising(finalAdvertising);
+    setShowBanner(false);
+    setShowModal(false);
+
+    if (typeof (window as any).applyPrivacyConsent === 'function') {
+      (window as any).applyPrivacyConsent(prefs);
+    }
+    window.dispatchEvent(new CustomEvent('privacy-consent-updated', { detail: prefs }));
+  };
+
+  const handleRejectNonEssential = () => {
+    savePreferences(false, false);
+  };
+
+  const handleAcceptAll = () => {
+    savePreferences(true, true);
+  };
+
+  const handleSaveCustom = (e: React.FormEvent) => {
+    e.preventDefault();
+    savePreferences(analytics, advertising);
+  };
+
+  const normalizedBaseUrl = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  return (
+    <>
+      {showBanner && !showModal && (
+        <div
+          role="region"
+          aria-label="Privacy and Data Consent Banner"
+          className="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-300 shadow-lg p-4 md:p-6"
+        >
+          <div className="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
+            <div className="text-sm text-gray-700 max-w-3xl">
+              <p className="font-semibold text-gray-900 mb-1">
+                Privacy by Design &amp; Data Minimization
+              </p>
+              <p>
+                We respect your privacy. By default, non-essential third-party scripts (analytics and advertising) are disabled. We only use essential session data to support features you explicitly use, such as your reading list. Review our{' '}
+                <a
+                  href={`${normalizedBaseUrl}legal/privacy`}
+                  className="underline font-medium text-gray-900 hover:text-amber-600"
+                >
+                  Privacy Policy
+                </a>{' '}
+                for full transparency on data collection and retention.
+              </p>
+            </div>
+            <div className="flex flex-wrap items-center gap-2 shrink-0">
+              <button
+                type="button"
+                onClick={handleRejectNonEssential}
+                data-skip-tracking="true"
+                className="px-4 py-2 text-xs font-semibold text-gray-900 bg-gray-100 border border-gray-300 rounded hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-gray-900"
+              >
+                 Essential Only (Recommended)
+              </button>
+              <button
+                type="button"
+                onClick={() => setShowModal(true)}
+                data-skip-tracking="true"
+                className="px-4 py-2 text-xs font-semibold text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-900"
+              >
+                Customize Preferences
+              </button>
+              <button
+                type="button"
+                onClick={handleAcceptAll}
+                data-skip-tracking="true"
+                className="px-4 py-2 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-900"
+              >
+                Allow All
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
+
+      {showModal && (
+        <div
+          role="dialog"
+          aria-modal="true"
+          aria-labelledby="privacy-modal-title"
+          className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
+        >
+          <div className="bg-white rounded-lg shadow-xl max-w-lg w-full p-6 border border-gray-200 max-h-[90vh] overflow-y-auto">
+            <div className="flex items-center justify-between border-b border-gray-200 pb-3 mb-4">
+              <h2 id="privacy-modal-title" className="text-lg font-bold text-gray-900">
+                Privacy &amp; Data Preferences
+              </h2>
+              <button
+                type="button"
+                onClick={() => setShowModal(false)}
+                aria-label="Close privacy preferences"
+                className="text-gray-500 hover:text-gray-800"
+              >
+                ✕
+              </button>
+            </div>
+
+            <p className="text-xs text-gray-600 mb-4">
+              In accordance with Privacy by Design and Data Minimization principles, non-essential scripts are off by default. You can opt in to specific categories below and withdraw consent at any time.
+            </p>
+
+            {dntEnabled && (
+              <div className="mb-4 p-3 bg-amber-50 border border-amber-200 rounded text-xs text-amber-900">
+                <strong>Global Privacy Control / Do Not Track detected:</strong> Your browser is sending a privacy signal. Non-essential tracking and advertising scripts are automatically disabled.
+              </div>
+            )}
+
+            <form onSubmit={handleSaveCustom} className="space-y-4">
+              <div className="p-3 bg-gray-50 rounded border border-gray-200">
+                <div className="flex items-center justify-between">
+                  <label className="text-sm font-semibold text-gray-900">
+                    Strictly Necessary (Essential)
+                  </label>
+                  <span className="text-xs font-medium text-gray-600 bg-gray-200 px-2 py-0.5 rounded">
+                    Always Active
+                  </span>
+                </div>
+                <p className="text-xs text-gray-600 mt-1">
+                  Required for core site functionality such as maintaining your bookmarked reading list session and storing your privacy preferences locally. No third-party data sharing occurs.
+                </p>
+              </div>
+
+              <div className="p-3 bg-white rounded border border-gray-200">
+                <div className="flex items-center justify-between">
+                  <label htmlFor="consent-analytics" className="text-sm font-semibold text-gray-900">
+                    Analytics Scripts (Opt-In)
+                  </label>
+                  <input
+                    id="consent-analytics"
+                    type="checkbox"
+                    checked={analytics}
+                    disabled={dntEnabled}
+                    onChange={(e) => setAnalytics(e.target.checked)}
+                    className="h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+                  />
+                </div>
+                <p className="text-xs text-gray-600 mt-1">
+                  Loads our external analytics script (<code>analytics-client.js</code>) to measure aggregated page views and site performance. Authentication and sensitive actions are excluded via <code>data-skip-tracking</code>.
+                </p>
+              </div>
+
+              <div className="p-3 bg-white rounded border border-gray-200">
+                <div className="flex items-center justify-between">
+                  <label htmlFor="consent-advertising" className="text-sm font-semibold text-gray-900">
+                    Third-Party Advertising (Opt-In)
+                  </label>
+                  <input
+                    id="consent-advertising"
+                    type="checkbox"
+                    checked={advertising}
+                    disabled={dntEnabled}
+                    onChange={(e) => setAdvertising(e.target.checked)}
+                    className="h-4 w-4 rounded border-gray-300 text-gray-900 focus:ring-gray-900"
+                  />
+                </div>
+                <p className="text-xs text-gray-600 mt-1">
+                  Enables third-party ad network slots and scripts (<code>ad-client.js</code>) to display banner and layout advertisements. Disabled by default to prevent unsolicited third-party tracking.
+                </p>
+              </div>
+
+              <div className="flex flex-wrap justify-end gap-2 pt-3 border-t border-gray-200">
+                <button
+                  type="button"
+                  onClick={handleRejectNonEssential}
+                  data-skip-tracking="true"
+                  className="px-3 py-2 text-xs font-semibold text-gray-700 bg-gray-100 rounded hover:bg-gray-200"
+                >
+                  Reject All Non-Essential
+                </button>
+                <button
+                  type="submit"
+                  data-skip-tracking="true"
+                  className="px-4 py-2 text-xs font-semibold text-white bg-gray-900 rounded hover:bg-gray-800"
+                >
+                  Save Preferences
+                </button>
+              </div>
+            </form>
+          </div>
+        </div>
+      )}
+    </>
+  );
+}
