+
+      function minimizePayload(rawObject, allowedKeys) {
+        const minimized = {};
+        for (const key of allowedKeys) {
+          if (Object.prototype.hasOwnProperty.call(rawObject, key)) {
+            minimized[key] = rawObject[key];
+          }
+        }
+        return minimized;
+      }
+
+      // ============================================================================
+      // 5. EPHEMERAL SESSION STORAGE WITH TTL & EXPIRATION SWEEP
+      // ============================================================================
+      const EphemeralStore = {
+        set(key, value, ttlMs = RETENTION_TTL_MS) {
+          try {
+            const now = Date.now();
+            const envelope = {
+              data: value,
+              createdAt: now,
+              expiresAt: now + ttlMs
+            };
+            window.sessionStorage.setItem(key, JSON.stringify(envelope));
+            return true;
+          } catch (_) {
+            return false;
+          }
+        },
+
+        get(key) {
+          try {
+            const raw = window.sessionStorage.getItem(key);
+            if (!raw) return null;
+            const envelope = JSON.parse(raw);
+            if (!envelope || typeof envelope.expiresAt !== 'number' || Date.now() > envelope.expiresAt) {
+              window.sessionStorage.removeItem(key);
+              return null;
+            }
+            return envelope;
+          } catch (_) {
+            window.sessionStorage.removeItem(key);
+            return null;
+          }
+        },
+
+        purgeExpired() {
+          try {
+            const keysToRemove = [];
+            for (let i = 0; i < window.sessionStorage.length; i++) {
+              const k = window.sessionStorage.key(i);
+              if (k && k.startsWith(STORAGE_PREFIX)) {
+                this.get(k); // Automatically removes if expired
+              } else if (k) {
+                // Remove any unapproved legacy/third-party keys in sessionStorage
+                keysToRemove.push(k);
+              }
+            }
+            keysToRemove.forEach(k => window.sessionStorage.removeItem(k));
+            // Ensure localStorage has zero persistent PII or tracking keys
+            window.localStorage.clear();
+          } catch (_) {
+            // Ignore storage access errors in restricted modes
+          }
+        },
+
+        purgeAll() {
+          try {
+            window.sessionStorage.clear();
+            window.localStorage.clear();
+            // Clear any accessible first-party cookies
+            if (document.cookie) {
+              const cookies = document.cookie.split(';');
+              for (const cookie of cookies) {
+                const eqPos = cookie.indexOf('=');
+                const name = (eqPos > -1 ? cookie.substr(0, eqPos) : cookie).trim();
+                if (name) {
+                  document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;SameSite=Strict`;
+                }
+              }
+            }
+          } catch (_) {
+            // Ignore storage errors
+          }
+        }
+      };
+
+      // ============================================================================
+      // 6. CONSENT MANAGEMENT (Privacy by Default)
+      // ============================================================================
+      function getConsentState() {
+        const signals = isPrivacySignalActive();
+        const stored = EphemeralStore.get(CONSENT_KEY);
+        if (!stored || !stored.data) {
+          return {
+            essential: true,
+            functionalPreferences: false,
+            analytics: false,
+            gpcEnforced: signals.active,
+            updatedAt: null
+          };
+        }
+        return {
+          essential: true,
+          functionalPreferences: signals.active ? false : Boolean(stored.data.functionalPreferences),
+          analytics: false,
+          gpcEnforced: signals.active,
+          updatedAt: stored.data.updatedAt
+        };
+      }
+
+      function saveConsentState(functionalPreferences) {
+        const signals = isPrivacySignalActive();
+        const effectiveFunctional = signals.active ? false : Boolean(functionalPreferences);
+        const state = {
+          essential: true,
+          functionalPreferences: effectiveFunctional,
+          analytics: false,
+          gpcEnforced: signals.active,
+          updatedAt: new Date().toISOString()
+        };
+        EphemeralStore.set(CONSENT_KEY, state);
+        syncConsentUI(state);
+        return state;
+      }
+
+      function syncConsentUI(state) {
+        const toggleFunctional = document.getElementById('toggle-functional-storage');
+        const banner = document.getElementById('privacy-banner');
+        const gpcIndicator = document.getElementById('gpc-status-indicator');
+
+        if (gpcIndicator) {
+          gpcIndicator.textContent = state.gpcEnforced
+            ? '[GPC / DNT Signal Active: Strict Privacy Enforced]'
+            : '';
+        }
+
+        if (toggleFunctional) {
+          toggleFunctional.checked = Boolean(state.functionalPreferences);
+          toggleFunctional.disabled = Boolean(state.gpcEnforced);
+        }
+
+        if (banner && state.updatedAt) {
+          banner.hidden = true;
+        }
+      }
+
+      // ============================================================================
+      // 7. THIRD-PARTY AUDIT & RUNTIME GUARD
+      // ============================================================================
+      function isOriginAllowed(urlString) {
+        try {
+          const parsed = new URL(urlString, window.location.origin);
+          if (parsed.origin === window.location.origin) {
+            return true;
+          }
+          return ALLOWED_THIRD_PARTY_ORIGINS.includes(parsed.origin);
+        } catch (_) {
+          return false;
+        }
+      }
+
+      function runThirdPartyAudit() {
+        const findings = [];
+        const elements = document.querySelectorAll('script[src], iframe[src], img[src], link[href]');
+
+        elements.forEach(el => {
+          const rawUrl = el.getAttribute('src') || el.getAttribute('href');
+          if (!rawUrl || rawUrl.startsWith('#') || rawUrl.startsWith('data:')) return;
+
+          try {
+            const resolved = new URL(rawUrl, window.location.origin);
+            if (resolved.origin !== window.location.origin) {
+              const allowed = ALLOWED_THIRD_PARTY_ORIGINS.includes(resolved.origin);
+              // Enforce privacy attributes on external elements
+              if (el.tagName === 'IMG' || el.tagName === 'SCRIPT' || el.tagName === 'IFRAME') {
+                if (el.getAttribute('referrerpolicy') !== 'no-referrer') {
+                  el.setAttribute('referrerpolicy', 'no-referrer');
+                }
+              }
+              if (!allowed) {
+                findings.push({
+                  tag: el.tagName.toLowerCase(),
+                  origin: resolved.origin,
+                  status: 'blocked'
+                });
+                el.remove();
+              } else {
+                findings.push({
+                  tag: el.tagName.toLowerCase(),
+                  origin: resolved.origin,
+                  status: 'allowed'
+                });
+              }
+            }
+          } catch (_) {
+            // Ignore malformed URLs
+          }
+        });
+
+        // Harden external anchor links with rel="noopener noreferrer"
+        document.querySelectorAll('a[href]').forEach(link => {
+          try {
+            const href = link.getAttribute('href');
+            if (!href || href.startsWith('#')) return;
+            const resolved = new URL(href, window.location.origin);
+            if (resolved.origin !== window.location.origin || link.getAttribute('target') === '_blank') {
+              link.setAttribute('rel', 'noopener noreferrer');
+              link.setAttribute('referrerpolicy', 'no-referrer');
+            }
+          } catch (_) {
+            // Ignore
+          }
+        });
+
+        const summaryEl = document.getElementById('audit-summary');
+        const blockedCount = findings.filter(f => f.status === 'blocked').length;
+        if (summaryEl) {
+          summaryEl.textContent = blockedCount === 0
+            ? `Runtime Audit Verified: 0 unauthorized third-party scripts or trackers detected (${findings.length} approved static asset origin audited).`
+            : `Runtime Audit Alert: Blocked and removed ${blockedCount} unauthorized third-party resource(s).`;
+        }
+
+        return { findings, blockedCount };
+      }
+
+      // Override navigator.sendBeacon to block unauthorized third-party telemetry exfiltration
+      if (typeof navigator.sendBeacon === 'function') {
+        const originalSendBeacon = navigator.sendBeacon.bind(navigator);
+        navigator.sendBeacon = function (url, data) {
+          if (!isOriginAllowed(url)) {
+            return false;
+          }
+          return originalSendBeacon(url, data);
+        };
+      }
+
+      // ============================================================================
+      // 8. UI EVENT HANDLERS: Forms, Logout, Data Inspection & Purge
+      // ============================================================================
+      function renderDataInspector() {
+        const outputEl = document.getElementById('data-inspector-output');
+        if (!outputEl) return;
+
+        EphemeralStore.purgeExpired();
+        const snapshot = {};
+        try {
+          for (let i = 0; i < window.sessionStorage.length; i++) {
+            const key = window.sessionStorage.key(i);
+            if (key && key.startsWith(STORAGE_PREFIX)) {
+              snapshot[key] = EphemeralStore.get(key);
+            }
+          }
+        } catch (_) {
+          // Ignore
+        }
+
+        const keys = Object.keys(snapshot);
+        if (keys.length === 0) {
+          outputEl.textContent = 'Zero personal or session data is currently stored in your browser.';
+        } else {
+          outputEl.textContent = JSON.stringify(snapshot, null, 2);
+        }
+      }
+
+      function initEventListeners() {
+        // Privacy Banner Buttons
+        const btnEssential = document.getElementById('btn-essential-only');
+        const btnOptIn = document.getElementById('btn-opt-in-prefs');
+        const toggleFunctional = document.getElementById('toggle-functional-storage');
+
+        if (btnEssential) {
+          btnEssential.addEventListener('click', () => {
+            saveConsentState(false);
+            renderDataInspector();
+          });
+        }
+
+        if (btnOptIn) {
+          btnOptIn.addEventListener('click', () => {
+            saveConsentState(true);
+            renderDataInspector();
+          });
+        }
+
+        if (toggleFunctional) {
+          toggleFunctional.addEventListener('change', (e) => {
+            saveConsentState(Boolean(e.target.checked));
+            renderDataInspector();
+          });
+        }
+
+        // Express Order Form (Data Minimization + Ephemeral TTL)
+        const orderForm = document.getElementById('express-order-form');
+        const orderStatus = document.getElementById('order-status');
+        if (orderForm) {
+          orderForm.addEventListener('submit', (e) => {
+            e.preventDefault();
+            const formData = new FormData(orderForm);
+            const rawPayload = {
+              pickupAlias: sanitizeText(formData.get('pickupAlias') || '', 20),
+              beverage: sanitizeText(formData.get('beverage') || '', 40)
+            };
+
+            if (!rawPayload.pickupAlias) {
+              if (orderStatus) {
+                orderStatus.hidden = false;
+                orderStatus.textContent = 'Please provide a pickup alias or initials.';
+              }
+              return;
+            }
+
+            // Strip any unexpected fields
+            const minimized = minimizePayload(rawPayload, ALLOWED_ORDER_FIELDS);
+            const consent = getConsentState();
+
+            const record = {
+              pickupAlias: minimized.pickupAlias,
+              beverage: minimized.beverage,
+              retentionPolicy: '15-minute ephemeral session TTL'
+            };
+
+            if (consent.functionalPreferences) {
+              EphemeralStore.set(ORDER_KEY, record, RETENTION_TTL_MS);
+            }
+
+            if (orderStatus) {
+              orderStatus.hidden = false;
+              orderStatus.textContent = `Order queued for "${record.pickupAlias}" (${record.beverage}). Data minimized and scheduled for automatic purge.`;
+            }
+            orderForm.reset();
+            renderDataInspector();
+          });
+        }
+
+        // Rewards Signup Form (Explicit Consent + Client-Side Hashing / Pseudonymization)
+        const rewardsForm = document.getElementById('rewards-form');
+        const rewardsStatus = document.getElementById('rewards-status');
+        if (rewardsForm) {
+          rewardsForm.addEventListener('submit', async (e) => {
+            e.preventDefault();
+            const formData = new FormData(rewardsForm);
+            const rawEmail = String(formData.get('email') || '').trim();
+            const consentTerms = formData.get('consentTerms') === 'on';
+            const consentNewsletter = formData.get('consentNewsletter') === 'on';
+
+            if (!rawEmail || !rawEmail.includes('@') || !consentTerms) {
+              if (rewardsStatus) {
+                rewardsStatus.hidden = false;
+                rewardsStatus.textContent = 'Please enter a valid email and explicitly accept the required reward points consent checkbox.';
+              }
+              return;
+            }
+
+            const minimized = minimizePayload(
+              { email: rawEmail, consentTerms, consentNewsletter },
+              ALLOWED_REWARDS_FIELDS
+            );
+
+            // Pseudonymize email with SHA-256 and mask plaintext before storing
+            const emailHash = await sha256Hex(minimized.email);
+            const masked = maskEmail(minimized.email);
+
+            const safeRewardsRecord = {
+              emailHash,
+              maskedEmail: masked,
+              consentTerms: Boolean(minimized.consentTerms),
+              consentNewsletter: Boolean(minimized.consentNewsletter),
+              purpose: 'Rewards punch card verification only'
+            };
+
+            EphemeralStore.set(REWARDS_KEY, safeRewardsRecord, RETENTION_TTL_MS);
+
+            if (rewardsStatus) {
+              rewardsStatus.hidden = false;
+              rewardsStatus.textContent = `Enrolled ${masked}! Plaintext email discarded; only salted/SHA-256 identifier (${emailHash.slice(0, 12)}...) retained in session.`;
+            }
+            rewardsForm.reset();
+            renderDataInspector();
+          });
+        }
+
+        // Secure Logout Form (POST + Full Session & Storage Purge)
+        const logoutForm = document.getElementById('logout-form');
+        if (logoutForm) {
+          logoutForm.addEventListener('submit', (e) => {
+            e.preventDefault();
+            EphemeralStore.purgeAll();
+            renderDataInspector();
+            const orderStatusEl = document.getElementById('order-status');
+            if (orderStatusEl) orderStatusEl.hidden = true;
+            const rewardsStatusEl = document.getElementById('rewards-status');
+            if (rewardsStatusEl) rewardsStatusEl.hidden = true;
+            const inspector = document.getElementById('data-inspector-output');
+            if (inspector) {
+              inspector.textContent = 'Session terminated. All sessionStorage, localStorage, and cookies have been securely purged.';
+            }
+          });
+        }
+
+        // Data Subject Rights Controls: Inspect, Export, Purge
+        const btnInspect = document.getElementById('btn-inspect-data');
+        const btnExport = document.getElementById('btn-export-data');
+        const btnClear = document.getElementById('btn-clear-data');
+
+        if (btnInspect) {
+          btnInspect.addEventListener('click', () => {
+            renderDataInspector();
+          });
+        }
+
+        if (btnExport) {
+          btnExport.addEventListener('click', () => {
+            EphemeralStore.purgeExpired();
+            const exportPayload = {
+              exportedAt: new Date().toISOString(),
+              controller: 'The Daily Grind Coffee Co.',
+              privacyByDesignVersion: '1.0',
+              records: {}
+            };
+            try {
+              for (let i = 0; i < window.sessionStorage.length; i++) {
+                const key = window.sessionStorage.key(i);
+                if (key && key.startsWith(STORAGE_PREFIX)) {
+                  exportPayload.records[key] = EphemeralStore.get(key);
+                }
+              }
+            } catch (_) {
+              // Ignore
+            }
+            const outputEl = document.getElementById('data-inspector-output');
+            if (outputEl) {
+              outputEl.textContent = JSON.stringify(exportPayload, null, 2);
+            }
+          });
+        }
+
+        if (btnClear) {
+          btnClear.addEventListener('click', () => {
+            EphemeralStore.purgeAll();
+            syncConsentUI(getConsentState());
+            const outputEl = document.getElementById('data-inspector-output');
+            if (outputEl) {
+              outputEl.textContent = 'All client-side data (sessionStorage, localStorage, cookies) has been permanently erased.';
+            }
+          });
+        }
+      }
+
+      // ============================================================================
+      // 9. INITIALIZATION & LIFECYCLE CLEANUP
+      // ============================================================================
+      function initPrivacyByDesign() {
+        sanitizeCurrentUrl();
+        EphemeralStore.purgeExpired();
+        const consent = getConsentState();
+        syncConsentUI(consent);
+        runThirdPartyAudit();
+        initEventListeners();
+
+        // Periodically purge expired session records every 60 seconds
+        setInterval(() => {
+          EphemeralStore.purgeExpired();
+        }, 60 * 1000);
+      }
+
+      // Expose read-only audit & privacy API for programmatic verification
+      window.DailyGrindPrivacy = Object.freeze({
+        getConsentState,
+        runThirdPartyAudit,
+        minimizePayload,
+        sanitizeText,
+        maskEmail,
+        sha256Hex,
+        purgeAllData: () => EphemeralStore.purgeAll()
+      });
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', initPrivacyByDesign);
+      } else {
+        initPrivacyByDesign();
+      }
+    })();
+  </script>
 </body>
 
