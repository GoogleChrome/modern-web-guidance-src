+  <script>
+    const previousLink = document.getElementById('previous');
+    const nextLink = document.getElementById('next');
+
+    if (previousLink) {
+      previousLink.addEventListener('click', () => {
+        sessionStorage.setItem('transitionType', 'previous');
+      });
+    }
+
+    if (nextLink) {
+      nextLink.addEventListener('click', () => {
+        sessionStorage.setItem('transitionType', 'next');
+      });
+    }
+
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pagereveal', async (e) => {
+        if (!e.viewTransition) return;
+
+        let transitionType = sessionStorage.getItem('transitionType');
+        sessionStorage.removeItem('transitionType');
+
+        if (!transitionType && typeof navigation !== 'undefined' && navigation.activation) {
+          const fromUrl = navigation.activation.from?.url;
+          const toUrl = navigation.activation.entry?.url || window.location.href;
+          const nextHref = document.getElementById('next')?.href;
+          const prevHref = document.getElementById('previous')?.href;
+
+          if (toUrl && nextHref && toUrl === nextHref) {
+            transitionType = 'next';
+          } else if (toUrl && prevHref && toUrl === prevHref) {
+            transitionType = 'previous';
+          } else if (fromUrl && prevHref && fromUrl === prevHref) {
+            transitionType = 'next';
+          } else if (fromUrl && nextHref && fromUrl === nextHref) {
+            transitionType = 'previous';
+          }
+        }
+
+        if (transitionType) {
+          e.viewTransition.types.add(transitionType);
+        }
+      });
+    }
+  </script>
+
 </body>
 
