+  <script>
+    function determineTransitionType(fromEntry, currentEntry) {
+      const savedType = sessionStorage.getItem('transitionType');
+      if (savedType === 'next' || savedType === 'previous') {
+        sessionStorage.removeItem('transitionType');
+        return savedType;
+      }
+
+      if (fromEntry?.url && currentEntry?.url) {
+        const fromUrl = new URL(fromEntry.url, window.location.origin);
+        const currentUrl = new URL(currentEntry.url, window.location.origin);
+
+        const explicitDirection = currentUrl.searchParams.get('direction');
+        if (explicitDirection === 'next' || explicitDirection === 'previous') {
+          return explicitDirection;
+        }
+
+        if (currentUrl.href.includes('previous') || currentUrl.href.includes('prev')) {
+          return 'previous';
+        }
+        if (currentUrl.href.includes('next')) {
+          return 'next';
+        }
+
+        const fromPage = Number(fromUrl.searchParams.get('page') ?? 1);
+        const toPage = Number(currentUrl.searchParams.get('page') ?? 1);
+        if (!Number.isNaN(fromPage) && !Number.isNaN(toPage) && fromPage !== toPage) {
+          return toPage > fromPage ? 'next' : 'previous';
+        }
+      }
+
+      if (
+        typeof fromEntry?.index === 'number' &&
+        typeof currentEntry?.index === 'number' &&
+        fromEntry.index !== currentEntry.index
+      ) {
+        return currentEntry.index > fromEntry.index ? 'next' : 'previous';
+      }
+
+      return 'next';
+    }
+
+    if ('onpagereveal' in window) {
+      window.addEventListener('pagereveal', async (e) => {
+        if (e.viewTransition && window.navigation?.activation) {
+          const transitionType = determineTransitionType(
+            window.navigation.activation.from,
+            window.navigation.activation.entry
+          );
+          if (transitionType) {
+            e.viewTransition.types.add(transitionType);
+          }
+        } else if (e.viewTransition) {
+          const savedType = sessionStorage.getItem('transitionType');
+          if (savedType) {
+            sessionStorage.removeItem('transitionType');
+            e.viewTransition.types.add(savedType);
+          }
+        }
+      });
+    }
+
+    const prevLink = document.getElementById('previous');
+    const nextLink = document.getElementById('next');
+    const currentParams = new URLSearchParams(window.location.search);
+    const currentPage = Number(currentParams.get('page') ?? 1);
+
+    if (prevLink) {
+      prevLink.href = `?page=${currentPage - 1}&direction=previous`;
+      prevLink.addEventListener('click', () => {
+        sessionStorage.setItem('transitionType', 'previous');
+      });
+    }
+
+    if (nextLink) {
+      nextLink.href = `?page=${currentPage + 1}&direction=next`;
+      nextLink.addEventListener('click', () => {
+        sessionStorage.setItem('transitionType', 'next');
+      });
+    }
+  </script>
