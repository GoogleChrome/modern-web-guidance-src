+  <script>
+    if (!HTMLScriptElement.supports || !HTMLScriptElement.supports('speculationrules')) {
+      const prefetched = new Set();
+
+      function shouldPrefetch(anchor) {
+        if (!anchor || !anchor.href) return false;
+        if (anchor.classList.contains('logout-link') || anchor.hasAttribute('data-no-prefetch')) return false;
+
+        try {
+          const url = new URL(anchor.href, window.location.origin);
+          if (url.origin !== window.location.origin) return false;
+          if (url.pathname === '/logout' || url.pathname === window.location.pathname) return false;
+          if (prefetched.has(url.href)) return false;
+          return true;
+        } catch {
+          return false;
+        }
+      }
+
+      function prefetchLink(anchor) {
+        if (!shouldPrefetch(anchor)) return;
+        const url = new URL(anchor.href, window.location.origin).href;
+        prefetched.add(url);
+
+        const link = document.createElement('link');
+        link.rel = 'prefetch';
+        link.href = url;
+        link.as = 'document';
+        document.head.appendChild(link);
+      }
+
+      document.addEventListener('pointerover', (e) => {
+        const anchor = e.target.closest('a');
+        if (anchor) prefetchLink(anchor);
+      });
+
+      document.addEventListener('focusin', (e) => {
+        const anchor = e.target.closest('a');
+        if (anchor) prefetchLink(anchor);
+      });
+    }
+  </script>
