+  <script>
+    (() => {
+      const searchInput = document.getElementById("search-input");
+      const menuGrid = document.querySelector(".grid");
+      const cards = Array.from(menuGrid.querySelectorAll(".card"));
+
+      // Cache text nodes in the menu cards using TreeWalker so we don't rebuild on every keystroke
+      const collectTextNodes = () => {
+        const nodes = [];
+        for (const card of cards) {
+          const treeWalker = document.createTreeWalker(card, NodeFilter.SHOW_TEXT);
+          let currentNode = treeWalker.nextNode();
+          while (currentNode) {
+            if (currentNode.textContent.trim().length > 0) {
+              nodes.push(currentNode);
+            }
+            currentNode = treeWalker.nextNode();
+          }
+        }
+        return nodes;
+      };
+
+      const allTextNodes = collectTextNodes();
+
+      const clearMarkFallback = () => {
+        const marks = menuGrid.querySelectorAll("mark.search-highlight");
+        for (const mark of marks) {
+          const parent = mark.parentNode;
+          parent.replaceChild(document.createTextNode(mark.textContent), mark);
+          parent.normalize();
+        }
+      };
+
+      const updateHighlights = () => {
+        const query = searchInput.value.trim().toLowerCase();
+
+        if (CSS.highlights) {
+          // MANDATORY: Clear previous highlights before registering new ones
+          CSS.highlights.clear();
+
+          if (!query) return;
+
+          const matchingRanges = [];
+          for (const textNode of allTextNodes) {
+            const text = textNode.textContent.toLowerCase();
+            let startPos = 0;
+            while (startPos < text.length) {
+              const index = text.indexOf(query, startPos);
+              if (index === -1) break;
+              const range = new Range();
+              range.setStart(textNode, index);
+              range.setEnd(textNode, index + query.length);
+              matchingRanges.push(range);
+              startPos = index + query.length;
+            }
+          }
+
+          if (matchingRanges.length > 0) {
+            const searchHighlight = new Highlight(...matchingRanges);
+            CSS.highlights.set("search-results", searchHighlight);
+          }
+        } else {
+          // Fallback for browsers without CSS Custom Highlight API
+          clearMarkFallback();
+          if (!query) return;
+
+          const nodes = collectTextNodes();
+          for (const textNode of nodes) {
+            const text = textNode.textContent;
+            let pos = text.toLowerCase().indexOf(query);
+            if (pos === -1) continue;
+
+            const frag = document.createDocumentFragment();
+            let last = 0;
+            while (pos !== -1) {
+              frag.append(text.slice(last, pos));
+              const mark = document.createElement("mark");
+              mark.className = "search-highlight";
+              mark.textContent = text.slice(pos, pos + query.length);
+              frag.append(mark);
+              last = pos + query.length;
+              pos = text.toLowerCase().indexOf(query, last);
+            }
+            frag.append(text.slice(last));
+            textNode.replaceWith(frag);
+          }
+        }
+      };
+
+      searchInput.addEventListener("input", updateHighlights);
+    })();
+  </script>
