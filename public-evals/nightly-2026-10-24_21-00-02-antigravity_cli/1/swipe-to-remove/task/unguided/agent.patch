+  <script>
+    (function () {
+      const list = document.querySelector('.SwipeableList');
+      if (!list) return;
+
+      const SWIPE_THRESHOLD_RATIO = 0.3;
+      const MIN_THRESHOLD_PX = 80;
+
+      function updateCartSummary() {
+        const remainingItems = list.querySelectorAll('.SwipeableList-item:not(.is-collapsing)');
+        const countEl = document.getElementById('cart-count');
+        const totalEl = document.getElementById('cart-total');
+        const summaryEl = document.getElementById('cart-summary');
+        const emptyEl = document.getElementById('cart-empty-msg');
+
+        let total = 0;
+        remainingItems.forEach((item) => {
+          const price = parseFloat(item.getAttribute('data-price') || '0');
+          total += price;
+        });
+
+        if (countEl) countEl.textContent = String(remainingItems.length);
+        if (totalEl) totalEl.textContent = '$' + total.toFixed(2);
+
+        if (remainingItems.length === 0) {
+          if (summaryEl) summaryEl.style.display = 'none';
+          if (emptyEl) emptyEl.classList.add('is-visible');
+        }
+      }
+
+      function removeItem(item, content, direction) {
+        if (item.classList.contains('is-collapsing')) return;
+
+        const width = item.offsetWidth || 300;
+        const exitX = direction >= 0 ? width : -width;
+
+        // Lock current explicit height before collapsing for a smooth height transition
+        item.style.maxHeight = item.offsetHeight + 'px';
+        // Force reflow
+        void item.offsetHeight;
+
+        item.classList.remove('is-dragging');
+        item.classList.add('is-past-threshold');
+        const track = item.querySelector('.SwipeableList-track');
+        if (track) track.classList.add('is-active');
+
+        content.style.transform = `translateX(${exitX}px)`;
+
+        requestAnimationFrame(() => {
+          item.classList.add('is-collapsing');
+          updateCartSummary();
+        });
+
+        const cleanup = () => {
+          if (item.parentNode) {
+            item.parentNode.removeChild(item);
+          }
+        };
+
+        item.addEventListener('transitionend', (e) => {
+          if (e.propertyName === 'max-height' || e.propertyName === 'height') {
+            cleanup();
+          }
+        });
+        setTimeout(cleanup, 450);
+      }
+
+      function initSwipeItem(item) {
+        const track = item.querySelector('.SwipeableList-track');
+        const content = item.querySelector('.SwipeableList-content');
+        if (!track || !content) return;
+
+        let startX = 0;
+        let currentX = 0;
+        let isDragging = false;
+        let activePointerId = null;
+
+        function getThreshold() {
+          return Math.max(MIN_THRESHOLD_PX, (item.offsetWidth || 300) * SWIPE_THRESHOLD_RATIO);
+        }
+
+        function onStart(clientX, pointerId) {
+          if (item.classList.contains('is-collapsing')) return;
+          isDragging = true;
+          startX = clientX;
+          currentX = 0;
+          activePointerId = pointerId;
+          item.classList.add('is-dragging');
+        }
+
+        function onMove(clientX) {
+          if (!isDragging) return;
+          currentX = clientX - startX;
+          content.style.transform = `translateX(${currentX}px)`;
+
+          const pastThreshold = Math.abs(currentX) >= getThreshold();
+          item.classList.toggle('is-past-threshold', pastThreshold);
+          track.classList.toggle('is-active', pastThreshold);
+        }
+
+        function onEnd() {
+          if (!isDragging) return;
+          isDragging = false;
+          activePointerId = null;
+          item.classList.remove('is-dragging');
+
+          if (Math.abs(currentX) >= getThreshold()) {
+            removeItem(item, content, currentX >= 0 ? 1 : -1);
+          } else {
+            content.style.transform = 'translateX(0px)';
+            item.classList.remove('is-past-threshold');
+            track.classList.remove('is-active');
+          }
+        }
+
+        if (window.PointerEvent) {
+          content.addEventListener('pointerdown', (e) => {
+            if (e.button !== undefined && e.button !== 0) return;
+            onStart(e.clientX, e.pointerId);
+            if (content.setPointerCapture) {
+              try {
+                content.setPointerCapture(e.pointerId);
+              } catch (_) {}
+            }
+          });
+
+          content.addEventListener('pointermove', (e) => {
+            if (!isDragging || (activePointerId !== null && e.pointerId !== activePointerId)) return;
+            onMove(e.clientX);
+          });
+
+          content.addEventListener('pointerup', (e) => {
+            if (activePointerId !== null && e.pointerId !== activePointerId) return;
+            onEnd();
+          });
+
+          content.addEventListener('pointercancel', (e) => {
+            if (activePointerId !== null && e.pointerId !== activePointerId) return;
+            onEnd();
+          });
+        } else {
+          content.addEventListener('touchstart', (e) => {
+            if (e.touches.length > 0) onStart(e.touches[0].clientX, null);
+          }, { passive: true });
+
+          window.addEventListener('touchmove', (e) => {
+            if (isDragging && e.touches.length > 0) onMove(e.touches[0].clientX);
+          }, { passive: true });
+
+          window.addEventListener('touchend', onEnd);
+          window.addEventListener('touchcancel', onEnd);
+
+          content.addEventListener('mousedown', (e) => {
+            if (e.button !== 0) return;
+            onStart(e.clientX, null);
+          });
+
+          window.addEventListener('mousemove', (e) => {
+            if (isDragging) onMove(e.clientX);
+          });
+
+          window.addEventListener('mouseup', onEnd);
+        }
+      }
+
+      list.querySelectorAll('.SwipeableList-item').forEach(initSwipeItem);
+    })();
+  </script>
 </body>
 
