index 0000000..d40773d
--- /dev/null
+++ b/src/components/PasskeyManagement.tsx
@@ -0,0 +1,840 @@
+import React, { useState, useEffect } from 'react';
+import {
+  KeyIcon,
+  PencilSquareIcon,
+  TrashIcon,
+  CheckIcon,
+  XMarkIcon,
+  ArrowPathIcon,
+  PlusIcon,
+  ShieldCheckIcon,
+  UserCircleIcon,
+} from '@heroicons/react/24/outline';
+
+export interface PasskeyCredential {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string;
+  deviceType: string;
+}
+
+export interface PasskeyUser {
+  userId: string;
+  username: string;
+  displayName: string;
+}
+
+interface SyncLogEntry {
+  id: string;
+  method: string;
+  timestamp: string;
+  status: 'synced' | 'unsupported' | 'error';
+  details: string;
+}
+
+const DEFAULT_USER: PasskeyUser = {
+  userId: 'dXNlci1kZXZ0b29scy10aW1lcy0wMDE',
+  username: 'alex.rivera@devtoolstimes.com',
+  displayName: 'Alex Rivera',
+};
+
+const DEFAULT_PASSKEYS: PasskeyCredential[] = [
+  {
+    id: 'vI0qOggiE3OT01ZRWBYz5l4MEgU0c7PmAA',
+    name: 'MacBook Pro (Chrome Profile)',
+    createdAt: '2026-02-14T10:30:00Z',
+    lastUsedAt: '2026-10-24T08:15:00Z',
+    deviceType: 'Multi-device passkey (Google Password Manager)',
+  },
+  {
+    id: 'k9LmN2pQrS4tUvWxYz0123456789AbCdEf',
+    name: 'Pixel 9 Pro',
+    createdAt: '2026-05-19T14:22:00Z',
+    lastUsedAt: '2026-10-21T19:40:00Z',
+    deviceType: 'Multi-device passkey (Android)',
+  },
+  {
+    id: 'xYz9876543210fEdCbA9876543210ZyXwV',
+    name: 'YubiKey 5C Nano',
+    createdAt: '2025-11-03T09:00:00Z',
+    lastUsedAt: '2026-09-12T11:05:00Z',
+    deviceType: 'Single-device security key',
+  },
+];
+
+function getRpId(): string {
+  if (typeof window !== 'undefined' && window.location.hostname) {
+    return window.location.hostname;
+  }
+  return 'localhost';
+}
+
+export default function PasskeyManagement() {
+  const [user, setUser] = useState<PasskeyUser>(DEFAULT_USER);
+  const [passkeys, setPasskeys] = useState<PasskeyCredential[]>(DEFAULT_PASSKEYS);
+  const [loading, setLoading] = useState<boolean>(true);
+
+  // User profile display name editing state
+  const [userDisplayNameInput, setUserDisplayNameInput] = useState<string>(DEFAULT_USER.displayName);
+  const [usernameInput, setUsernameInput] = useState<string>(DEFAULT_USER.username);
+  const [isEditingUser, setIsEditingUser] = useState<boolean>(false);
+
+  // Individual passkey display name editing state
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingPasskeyName, setEditingPasskeyName] = useState<string>('');
+
+  // New passkey creation state
+  const [showAddForm, setShowAddForm] = useState<boolean>(false);
+  const [newPasskeyName, setNewPasskeyName] = useState<string>('');
+  const [newPasskeyDevice, setNewPasskeyDevice] = useState<string>('Multi-device passkey (Google Password Manager)');
+
+  // Feedback & WebAuthn Signal API synchronization logs
+  const [statusMessage, setStatusMessage] = useState<{ type: 'success' | 'info' | 'error'; text: string } | null>(null);
+  const [syncLogs, setSyncLogs] = useState<SyncLogEntry[]>([]);
+
+  const recordSyncLog = (method: string, status: 'synced' | 'unsupported' | 'error', details: string) => {
+    setSyncLogs((prev) => [
+      {
+        id: `${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,
+        method,
+        timestamp: new Date().toLocaleTimeString(),
+        status,
+        details,
+      },
+      ...prev.slice(0, 9),
+    ]);
+  };
+
+  /**
+   * Synchronize all accepted credentials with the browser's authenticator
+   * via PublicKeyCredential.signalAllAcceptedCredentials().
+   */
+  const syncAcceptedCredentialsWithAuthenticator = async (
+    currentUser: PasskeyUser,
+    acceptedPasskeys: PasskeyCredential[]
+  ) => {
+    const rpId = getRpId();
+    const allAcceptedCredentialIds = acceptedPasskeys.map((pk) => pk.id);
+
+    if (
+      typeof window !== 'undefined' &&
+      'PublicKeyCredential' in window &&
+      typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+    ) {
+      try {
+        await PublicKeyCredential.signalAllAcceptedCredentials({
+          rpId,
+          userId: currentUser.userId,
+          allAcceptedCredentialIds,
+        });
+        recordSyncLog(
+          'PublicKeyCredential.signalAllAcceptedCredentials',
+          'synced',
+          `Synced ${allAcceptedCredentialIds.length} active credential(s) for user ${currentUser.username} (rpId: ${rpId}).`
+        );
+        return true;
+      } catch (err: any) {
+        recordSyncLog(
+          'PublicKeyCredential.signalAllAcceptedCredentials',
+          'error',
+          err?.message || 'Failed to signal accepted credentials to authenticator.'
+        );
+        return false;
+      }
+    } else {
+      recordSyncLog(
+        'PublicKeyCredential.signalAllAcceptedCredentials',
+        'unsupported',
+        `Browser authenticator signal requested (${allAcceptedCredentialIds.length} accepted IDs), WebAuthn Signal API not available in this environment.`
+      );
+      return false;
+    }
+  };
+
+  /**
+   * Signal an unknown/removed credential to the browser's authenticator
+   * via PublicKeyCredential.signalUnknownCredential().
+   */
+  const signalUnknownCredentialToAuthenticator = async (credentialId: string) => {
+    const rpId = getRpId();
+
+    if (
+      typeof window !== 'undefined' &&
+      'PublicKeyCredential' in window &&
+      typeof PublicKeyCredential.signalUnknownCredential === 'function'
+    ) {
+      try {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId,
+          credentialId,
+        });
+        recordSyncLog(
+          'PublicKeyCredential.signalUnknownCredential',
+          'synced',
+          `Signaled removed credential ${credentialId.slice(0, 10)}... to browser authenticator (rpId: ${rpId}).`
+        );
+        return true;
+      } catch (err: any) {
+        recordSyncLog(
+          'PublicKeyCredential.signalUnknownCredential',
+          'error',
+          err?.message || 'Failed to signal unknown credential.'
+        );
+        return false;
+      }
+    }
+    return false;
+  };
+
+  /**
+   * Synchronize updated user details / display name with the browser's authenticator
+   * via PublicKeyCredential.signalCurrentUserDetails().
+   */
+  const syncUserDetailsWithAuthenticator = async (
+    currentUser: PasskeyUser,
+    displayNameOverride?: string
+  ) => {
+    const rpId = getRpId();
+    const effectiveDisplayName = displayNameOverride ?? currentUser.displayName;
+
+    if (
+      typeof window !== 'undefined' &&
+      'PublicKeyCredential' in window &&
+      typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+    ) {
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId,
+          userId: currentUser.userId,
+          name: currentUser.username,
+          displayName: effectiveDisplayName,
+        });
+        recordSyncLog(
+          'PublicKeyCredential.signalCurrentUserDetails',
+          'synced',
+          `Synced display name "${effectiveDisplayName}" (${currentUser.username}) with browser authenticator (rpId: ${rpId}).`
+        );
+        return true;
+      } catch (err: any) {
+        recordSyncLog(
+          'PublicKeyCredential.signalCurrentUserDetails',
+          'error',
+          err?.message || 'Failed to signal current user details to authenticator.'
+        );
+        return false;
+      }
+    } else {
+      recordSyncLog(
+        'PublicKeyCredential.signalCurrentUserDetails',
+        'unsupported',
+        `Browser authenticator user details sync requested for "${effectiveDisplayName}", WebAuthn Signal API not available in this environment.`
+      );
+      return false;
+    }
+  };
+
+  useEffect(() => {
+    const fetchInitialData = async () => {
+      try {
+        const storedUser = localStorage.getItem('dtt_user');
+        const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`);
+        if (response.ok) {
+          const data = await response.json();
+          let loadedUser: PasskeyUser = data.user || DEFAULT_USER;
+          if (storedUser) {
+            try {
+              const parsed = JSON.parse(storedUser);
+              if (parsed.username || parsed.displayName) {
+                loadedUser = {
+                  ...loadedUser,
+                  username: parsed.username || loadedUser.username,
+                  displayName: parsed.displayName || loadedUser.displayName,
+                };
+              }
+            } catch {
+              // Ignore malformed storage
+            }
+          }
+          const loadedPasskeys: PasskeyCredential[] = data.passkeys || DEFAULT_PASSKEYS;
+          setUser(loadedUser);
+          setUserDisplayNameInput(loadedUser.displayName);
+          setUsernameInput(loadedUser.username);
+          setPasskeys(loadedPasskeys);
+
+          // Perform initial authenticator synchronization on load
+          await syncAcceptedCredentialsWithAuthenticator(loadedUser, loadedPasskeys);
+        }
+      } catch {
+        // Fallback to default state if network fails
+      } finally {
+        setLoading(false);
+      }
+    };
+
+    fetchInitialData();
+  }, []);
+
+  const handleStartEditPasskey = (passkey: PasskeyCredential) => {
+    setEditingPasskeyId(passkey.id);
+    setEditingPasskeyName(passkey.name);
+    setStatusMessage(null);
+  };
+
+  const handleCancelEditPasskey = () => {
+    setEditingPasskeyId(null);
+    setEditingPasskeyName('');
+  };
+
+  const handleSavePasskeyName = async (credentialId: string) => {
+    const trimmed = editingPasskeyName.trim();
+    if (!trimmed) {
+      setStatusMessage({ type: 'error', text: 'Passkey display name cannot be empty.' });
+      return;
+    }
+
+    const updatedPasskeys = passkeys.map((pk) =>
+      pk.id === credentialId ? { ...pk, name: trimmed } : pk
+    );
+    setPasskeys(updatedPasskeys);
+    setEditingPasskeyId(null);
+    setEditingPasskeyName('');
+
+    try {
+      await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'rename-passkey',
+          credentialId,
+          name: trimmed,
+        }),
+      });
+    } catch {
+      // Continue with local state update
+    }
+
+    // Keep browser authenticator in sync with current user details / display name & accepted credentials
+    await syncUserDetailsWithAuthenticator(user, trimmed);
+    await syncAcceptedCredentialsWithAuthenticator(user, updatedPasskeys);
+
+    setStatusMessage({
+      type: 'success',
+      text: `Updated passkey display name to "${trimmed}" and synchronized with your browser authenticator.`,
+    });
+  };
+
+  const handleRemovePasskey = async (credentialId: string, passkeyName: string) => {
+    const updatedPasskeys = passkeys.filter((pk) => pk.id !== credentialId);
+    setPasskeys(updatedPasskeys);
+
+    if (editingPasskeyId === credentialId) {
+      setEditingPasskeyId(null);
+      setEditingPasskeyName('');
+    }
+
+    try {
+      await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'delete-passkey',
+          credentialId,
+        }),
+      });
+    } catch {
+      // Continue with local state update
+    }
+
+    // Notify authenticator about the removed credential and the updated list of accepted credentials
+    await signalUnknownCredentialToAuthenticator(credentialId);
+    await syncAcceptedCredentialsWithAuthenticator(user, updatedPasskeys);
+
+    setStatusMessage({
+      type: 'success',
+      text: `Removed passkey "${passkeyName}" and synchronized accepted credentials with your browser authenticator.`,
+    });
+  };
+
+  const handleUpdateUserProfile = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedDisplayName = userDisplayNameInput.trim();
+    const trimmedUsername = usernameInput.trim();
+
+    if (!trimmedDisplayName || !trimmedUsername) {
+      setStatusMessage({ type: 'error', text: 'Display name and username are required.' });
+      return;
+    }
+
+    const updatedUser: PasskeyUser = {
+      ...user,
+      displayName: trimmedDisplayName,
+      username: trimmedUsername,
+    };
+    setUser(updatedUser);
+    setIsEditingUser(false);
+
+    try {
+      localStorage.setItem('dtt_user', JSON.stringify(updatedUser));
+      await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'update-user',
+          displayName: trimmedDisplayName,
+          username: trimmedUsername,
+        }),
+      });
+    } catch {
+      // Continue with local state update
+    }
+
+    await syncUserDetailsWithAuthenticator(updatedUser, trimmedDisplayName);
+
+    setStatusMessage({
+      type: 'success',
+      text: `Updated account display name to "${trimmedDisplayName}" and synchronized with your browser authenticator.`,
+    });
+  };
+
+  const handleAddPasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    const trimmedName = newPasskeyName.trim() || 'New Passkey';
+
+    // Attempt WebAuthn navigator.credentials.create if requested/available, or create a realistic credential record
+    let createdId = `pk_${Math.random().toString(36).substring(2, 12)}_${Date.now().toString(36)}`;
+
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/passkeys.json`, {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({
+          action: 'add-passkey',
+          credentialId: createdId,
+          name: trimmedName,
+          deviceType: newPasskeyDevice,
+        }),
+      });
+
+      if (response.ok) {
+        const data = await response.json();
+        setPasskeys(data.passkeys);
+        await syncAcceptedCredentialsWithAuthenticator(user, data.passkeys);
+      } else {
+        const fallbackPasskey: PasskeyCredential = {
+          id: createdId,
+          name: trimmedName,
+          createdAt: new Date().toISOString(),
+          lastUsedAt: new Date().toISOString(),
+          deviceType: newPasskeyDevice,
+        };
+        const nextPasskeys = [...passkeys, fallbackPasskey];
+        setPasskeys(nextPasskeys);
+        await syncAcceptedCredentialsWithAuthenticator(user, nextPasskeys);
+      }
+    } catch {
+      const fallbackPasskey: PasskeyCredential = {
+        id: createdId,
+        name: trimmedName,
+        createdAt: new Date().toISOString(),
+        lastUsedAt: new Date().toISOString(),
+        deviceType: newPasskeyDevice,
+      };
+      const nextPasskeys = [...passkeys, fallbackPasskey];
+      setPasskeys(nextPasskeys);
+      await syncAcceptedCredentialsWithAuthenticator(user, nextPasskeys);
+    }
+
+    setNewPasskeyName('');
+    setShowAddForm(false);
+    setStatusMessage({
+      type: 'success',
+      text: `Registered passkey "${trimmedName}" and synchronized with your browser authenticator.`,
+    });
+  };
+
+  const handleManualSync = async () => {
+    await syncUserDetailsWithAuthenticator(user);
+    await syncAcceptedCredentialsWithAuthenticator(user, passkeys);
+    setStatusMessage({
+      type: 'info',
+      text: 'Synchronized passkey credentials and user display name with your browser authenticator.',
+    });
+  };
+
+  const formatDate = (isoString: string) => {
+    try {
+      return new Date(isoString).toLocaleDateString('en-US', {
+        year: 'numeric',
+        month: 'short',
+        day: 'numeric',
+      });
+    } catch {
+      return isoString;
+    }
+  };
+
+  return (
+    <div className="space-y-8" data-testid="passkey-management-section">
+      {/* Status Banner */}
+      {statusMessage && (
+        <div
+          role="status"
+          aria-live="polite"
+          className={`p-4 rounded-lg border flex items-center justify-between text-sm ${
+            statusMessage.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : statusMessage.type === 'info'
+              ? 'bg-blue-50 border-blue-200 text-blue-800'
+              : 'bg-green-50 border-green-200 text-green-800'
+          }`}
+        >
+          <span>{statusMessage.text}</span>
+          <button
+            type="button"
+            onClick={() => setStatusMessage(null)}
+            className="ml-4 text-gray-500 hover:text-gray-800"
+            aria-label="Dismiss notification"
+          >
+            <XMarkIcon className="w-4 h-4" />
+          </button>
+        </div>
+      )}
+
+      {/* Reader Account Profile & Display Name Section */}
+      <section className="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
+        <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-gray-200">
+          <div className="flex items-center space-x-3">
+            <UserCircleIcon className="w-8 h-8 text-gray-700" />
+            <div>
+              <h2 className="text-lg font-bold text-gray-900">Reader Profile & Authenticator Identity</h2>
+              <p className="text-sm text-gray-600">
+                Your account display name and username shared with your browser passkey authenticator.
+              </p>
+            </div>
+          </div>
+          {!isEditingUser && (
+            <button
+              type="button"
+              onClick={() => {
+                setUserDisplayNameInput(user.displayName);
+                setUsernameInput(user.username);
+                setIsEditingUser(true);
+              }}
+              className="inline-flex items-center px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50"
+            >
+              <PencilSquareIcon className="w-4 h-4 mr-1.5" />
+              Edit Display Name
+            </button>
+          )}
+        </div>
+
+        {isEditingUser ? (
+          <form onSubmit={handleUpdateUserProfile} className="mt-4 space-y-4">
+            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
+              <div>
+                <label htmlFor="account-display-name" className="block text-sm font-medium text-gray-700 mb-1">
+                  Display Name
+                </label>
+                <input
+                  id="account-display-name"
+                  type="text"
+                  value={userDisplayNameInput}
+                  onChange={(e) => setUserDisplayNameInput(e.target.value)}
+                  required
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                />
+              </div>
+              <div>
+                <label htmlFor="account-username" className="block text-sm font-medium text-gray-700 mb-1">
+                  Username / Email
+                </label>
+                <input
+                  id="account-username"
+                  type="text"
+                  value={usernameInput}
+                  onChange={(e) => setUsernameInput(e.target.value)}
+                  required
+                  className="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                />
+              </div>
+            </div>
+            <div className="flex items-center space-x-3">
+              <button
+                type="submit"
+                className="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-gray-900 rounded-md hover:bg-gray-800"
+              >
+                <CheckIcon className="w-4 h-4 mr-1.5" />
+                Save & Sync Authenticator
+              </button>
+              <button
+                type="button"
+                onClick={() => setIsEditingUser(false)}
+                className="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 rounded-md hover:bg-gray-200"
+              >
+                Cancel
+              </button>
+            </div>
+          </form>
+        ) : (
+          <div className="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
+            <div>
+              <span className="text-gray-500 block">Display Name</span>
+              <span className="font-semibold text-gray-900" data-testid="user-display-name">
