diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
new file mode 100644
index 0000000..e3cdb2c
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,259 @@
+import type { APIRoute } from 'astro';
+
+export interface PasskeyCredential {
+  id: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string;
+  deviceType: string;
+}
+
+export interface PasskeyUser {
+  userId: string;
+  username: string;
+  displayName: string;
+}
+
+const DEFAULT_USER: PasskeyUser = {
+  userId: 'dXNlci1kZXZ0b29scy10aW1lcy0wMDE',
+  username: 'alex.rivera@devtoolstimes.com',
+  displayName: 'Alex Rivera',
+};
+
+const DEFAULT_PASSKEYS: PasskeyCredential[] = [
+  {
+    id: 'vI0qOggiE3OT01ZRWBYz5l4MEgU0c7PmAA',
+    name: 'MacBook Pro (Chrome Profile)',
+    createdAt: '2026-02-14T10:30:00Z',
+    lastUsedAt: '2026-10-24T08:15:00Z',
+    deviceType: 'Multi-device passkey (Google Password Manager)',
+  },
+  {
+    id: 'k9LmN2pQrS4tUvWxYz0123456789AbCdEf',
+    name: 'Pixel 9 Pro',
+    createdAt: '2026-05-19T14:22:00Z',
+    lastUsedAt: '2026-10-21T19:40:00Z',
+    deviceType: 'Multi-device passkey (Android)',
+  },
+  {
+    id: 'xYz9876543210fEdCbA9876543210ZyXwV',
+    name: 'YubiKey 5C Nano',
+    createdAt: '2025-11-03T09:00:00Z',
+    lastUsedAt: '2026-09-12T11:05:00Z',
+    deviceType: 'Single-device security key',
+  },
+];
+
+async function getPasskeyState(session: App.Locals['session'] | undefined) {
+  let user: PasskeyUser | undefined = await session?.get('passkeyUser');
+  if (!user) {
+    user = { ...DEFAULT_USER };
+    await session?.set('passkeyUser', user);
+  }
+
+  let passkeys: PasskeyCredential[] | undefined = await session?.get('passkeys');
+  if (!passkeys) {
+    passkeys = DEFAULT_PASSKEYS.map((k) => ({ ...k }));
+    await session?.set('passkeys', passkeys);
+  }
+
+  return { user, passkeys };
+}
+
+export const GET: APIRoute = async ({ session }) => {
+  const { user, passkeys } = await getPasskeyState(session);
+
+  return new Response(
+    JSON.stringify({
+      user,
+      passkeys,
+    }),
+    {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  const { user, passkeys } = await getPasskeyState(session);
+  const body = await request.json().catch(() => ({}));
+  const { action } = body;
+
+  if (action === 'update-user') {
+    const { username, displayName } = body;
+    if (typeof displayName === 'string' && displayName.trim()) {
+      user.displayName = displayName.trim();
+    }
+    if (typeof username === 'string' && username.trim()) {
+      user.username = username.trim();
+    }
+    await session?.set('passkeyUser', user);
+    return new Response(
+      JSON.stringify({ user, passkeys }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'rename-passkey' || action === 'update-passkey') {
+    const { credentialId, name, displayName } = body;
+    const newName = (name ?? displayName ?? '').trim();
+    if (!credentialId || !newName) {
+      return new Response(
+        JSON.stringify({ error: 'credentialId and name are required' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const updatedPasskeys = passkeys.map((pk) =>
+      pk.id === credentialId ? { ...pk, name: newName } : pk
+    );
+    await session?.set('passkeys', updatedPasskeys);
+
+    return new Response(
+      JSON.stringify({ user, passkeys: updatedPasskeys }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'delete-passkey' || action === 'remove-passkey') {
+    const { credentialId } = body;
+    if (!credentialId) {
+      return new Response(
+        JSON.stringify({ error: 'credentialId is required' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    const updatedPasskeys = passkeys.filter((pk) => pk.id !== credentialId);
+    await session?.set('passkeys', updatedPasskeys);
+
+    return new Response(
+      JSON.stringify({
+        user,
+        passkeys: updatedPasskeys,
+        removedCredentialId: credentialId,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'add-passkey') {
+    const { credentialId, name, deviceType } = body;
+    const newPasskey: PasskeyCredential = {
+      id: credentialId || `pk_${Date.now().toString(36)}`,
+      name: (name || 'New Passkey').trim(),
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+      deviceType: deviceType || 'Multi-device passkey',
+    };
+    const updatedPasskeys = [...passkeys, newPasskey];
+    await session?.set('passkeys', updatedPasskeys);
+
+    return new Response(
+      JSON.stringify({ user, passkeys: updatedPasskeys, passkey: newPasskey }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  if (action === 'reset') {
+    const resetUser = { ...DEFAULT_USER };
+    const resetPasskeys = DEFAULT_PASSKEYS.map((k) => ({ ...k }));
+    await session?.set('passkeyUser', resetUser);
+    await session?.set('passkeys', resetPasskeys);
+    return new Response(
+      JSON.stringify({ user: resetUser, passkeys: resetPasskeys }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  }
+
+  return new Response(
+    JSON.stringify({ error: 'Invalid action' }),
+    { status: 400, headers: { 'Content-Type': 'application/json' } }
+  );
+};
+
+export const PUT: APIRoute = async (context) => {
+  const { user, passkeys } = await getPasskeyState(context.session);
+  const body = await context.request.json().catch(() => ({}));
+  const { credentialId, name, displayName, username } = body;
+
+  if (credentialId) {
+    const newName = (name ?? displayName ?? '').trim();
+    const updatedPasskeys = passkeys.map((pk) =>
+      pk.id === credentialId && newName ? { ...pk, name: newName } : pk
+    );
+    await context.session?.set('passkeys', updatedPasskeys);
+    if (displayName && typeof displayName === 'string') {
+      user.displayName = displayName.trim();
+      await context.session?.set('passkeyUser', user);
+    }
+    return new Response(
+      JSON.stringify({ user, passkeys: updatedPasskeys }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  if (displayName || username) {
+    if (typeof displayName === 'string' && displayName.trim()) {
+      user.displayName = displayName.trim();
+    }
+    if (typeof username === 'string' && username.trim()) {
+      user.username = username.trim();
+    }
+    await context.session?.set('passkeyUser', user);
+    return new Response(
+      JSON.stringify({ user, passkeys }),
+      { status: 200, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  return new Response(
+    JSON.stringify({ error: 'Invalid update payload' }),
+    { status: 400, headers: { 'Content-Type': 'application/json' } }
+  );
+};
+
+export const DELETE: APIRoute = async ({ request, url, session }) => {
+  const { user, passkeys } = await getPasskeyState(session);
+  let credentialId = url.searchParams.get('credentialId') || url.searchParams.get('id');
+
+  if (!credentialId) {
+    const body = await request.json().catch(() => ({}));
+    credentialId = body.credentialId || body.id;
+  }
+
+  if (!credentialId) {
+    return new Response(
+      JSON.stringify({ error: 'credentialId is required' }),
+      { status: 400, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+
+  const updatedPasskeys = passkeys.filter((pk) => pk.id !== credentialId);
+  await session?.set('passkeys', updatedPasskeys);
+
+  return new Response(
+    JSON.stringify({
+      user,
+      passkeys: updatedPasskeys,
+      removedCredentialId: credentialId,
+    }),
+    { status: 200, headers: { 'Content-Type': 'application/json' } }
+  );
+};
