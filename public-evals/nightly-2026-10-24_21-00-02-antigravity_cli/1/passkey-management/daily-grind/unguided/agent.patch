+  <script>
+    (function () {
+      const STORAGE_KEY = 'daily_grind_account_passkeys_v1';
+
+      const defaultState = {
+        user: {
+          id: 'dXNlcl9hbGV4X3JpdmVyYV8wMQ',
+          name: 'alex.rivera@example.com',
+          displayName: 'Alex Rivera'
+        },
+        passkeys: [
+          {
+            id: 'cred_iCloud_Keychain_9f8a7b6c5d4e',
+            name: 'MacBook Pro (iCloud Keychain)',
+            authenticatorType: 'Platform / Synced',
+            createdAt: '2026-06-14',
+            lastUsedAt: '2026-10-24',
+            aaguid: 'fbfc3007-154e-4ecc-8c0b-6e020557d7bd'
+          },
+          {
+            id: 'cred_Google_Password_Mgr_3c2d1e0f9a8b',
+            name: 'Pixel 9 Pro (Google Password Manager)',
+            authenticatorType: 'Platform / Synced',
+            createdAt: '2026-08-02',
+            lastUsedAt: '2026-10-19',
+            aaguid: 'ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4'
+          },
+          {
+            id: 'cred_YubiKey_5_NFC_7b6a5c4d3e2f',
+            name: 'YubiKey 5C NFC Backup',
+            authenticatorType: 'Security Key',
+            createdAt: '2026-03-10',
+            lastUsedAt: '2026-09-05',
+            aaguid: '2fc0579f-8113-47ea-b116-bb5a8db9202a'
+          }
+        ]
+      };
+
+      function loadState() {
+        try {
+          const raw = localStorage.getItem(STORAGE_KEY);
+          if (raw) {
+            const parsed = JSON.parse(raw);
+            if (parsed && parsed.user && Array.isArray(parsed.passkeys)) {
+              return parsed;
+            }
+          }
+        } catch (err) {
+          // Ignore storage errors
+        }
+        return JSON.parse(JSON.stringify(defaultState));
+      }
+
+      function saveState() {
+        try {
+          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
+        } catch (err) {
+          // Ignore storage errors
+        }
+      }
+
+      const state = loadState();
+      let editingCredentialId = null;
+
+      function getRpId() {
+        return window.location.hostname || 'localhost';
+      }
+
+      function toBase64Url(bytes) {
+        let binary = '';
+        for (let i = 0; i < bytes.byteLength; i++) {
+          binary += String.fromCharCode(bytes[i]);
+        }
+        return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+      }
+
+      function fromBase64UrlToUint8Array(base64url) {
+        const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+        const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+        try {
+          const raw = atob(base64);
+          const out = new Uint8Array(raw.length);
+          for (let i = 0; i < raw.length; i++) {
+            out[i] = raw.charCodeAt(i);
+          }
+          return out;
+        } catch (e) {
+          return new TextEncoder().encode(base64url);
+        }
+      }
+
+      function updateStatusBanner(html, variant) {
+        const banner = document.getElementById('sync-status');
+        const msg = document.getElementById('sync-status-message');
+        if (!banner || !msg) return;
+        banner.className = 'sync-banner' + (variant ? ' ' + variant : '');
+        msg.innerHTML = html;
+      }
+
+      async function signalUnknownCredentialToAuthenticator(credentialId) {
+        const rpId = getRpId();
+        if (
+          typeof window.PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalUnknownCredential === 'function'
+        ) {
+          await PublicKeyCredential.signalUnknownCredential({
+            rpId: rpId,
+            credentialId: credentialId
+          });
+          return { supported: true, method: 'signalUnknownCredential', rpId: rpId };
+        }
+        return { supported: false, method: 'signalUnknownCredential', rpId: rpId };
+      }
+
+      async function signalAllAcceptedCredentialsToAuthenticator() {
+        const rpId = getRpId();
+        const allAcceptedCredentialIds = state.passkeys.map(function (pk) {
+          return pk.id;
+        });
+        if (
+          typeof window.PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalAllAcceptedCredentials === 'function'
+        ) {
+          await PublicKeyCredential.signalAllAcceptedCredentials({
+            rpId: rpId,
+            userId: state.user.id,
+            allAcceptedCredentialIds: allAcceptedCredentialIds
+          });
+          return {
+            supported: true,
+            method: 'signalAllAcceptedCredentials',
+            count: allAcceptedCredentialIds.length,
+            rpId: rpId
+          };
+        }
+        return {
+          supported: false,
+          method: 'signalAllAcceptedCredentials',
+          count: allAcceptedCredentialIds.length,
+          rpId: rpId
+        };
+      }
+
+      async function signalCurrentUserDetailsToAuthenticator() {
+        const rpId = getRpId();
+        if (
+          typeof window.PublicKeyCredential !== 'undefined' &&
+          typeof PublicKeyCredential.signalCurrentUserDetails === 'function'
+        ) {
+          await PublicKeyCredential.signalCurrentUserDetails({
+            rpId: rpId,
+            userId: state.user.id,
+            name: state.user.name,
+            displayName: state.user.displayName
+          });
+          return { supported: true, method: 'signalCurrentUserDetails', rpId: rpId };
+        }
+        return { supported: false, method: 'signalCurrentUserDetails', rpId: rpId };
+      }
+
+      function escapeHtml(str) {
+        return String(str)
+          .replace(/&/g, '&amp;')
+          .replace(/</g, '&lt;')
+          .replace(/>/g, '&gt;')
+          .replace(/"/g, '&quot;')
+          .replace(/'/g, '&#039;');
+      }
+
+      function renderProfile() {
+        const displayNameInput = document.getElementById('user-display-name');
+        const nameInput = document.getElementById('user-name');
+        const idInput = document.getElementById('user-id-display');
+        const badgeName = document.getElementById('current-user-badge-name');
+        const badgeEmail = document.getElementById('current-user-badge-email');
+
+        if (displayNameInput) displayNameInput.value = state.user.displayName;
+        if (nameInput) nameInput.value = state.user.name;
+        if (idInput) idInput.value = state.user.id;
+        if (badgeName) badgeName.textContent = state.user.displayName;
+        if (badgeEmail) badgeEmail.textContent = state.user.name;
+      }
+
+      function renderPasskeys() {
+        const listEl = document.getElementById('passkey-list');
+        const countBadge = document.getElementById('passkey-count-badge');
+        if (!listEl) return;
+
+        if (countBadge) {
+          countBadge.textContent = state.passkeys.length + ' Active';
+        }
+
+        if (state.passkeys.length === 0) {
+          listEl.innerHTML =
+            '<li class="empty-state">No passkeys are currently registered on your account. Add a passkey above to enable passwordless sign-in.</li>';
+          return;
+        }
+
+        listEl.innerHTML = state.passkeys
+          .map(function (pk) {
+            const isEditing = editingCredentialId === pk.id;
+            const safeName = escapeHtml(pk.name);
+            const safeId = escapeHtml(pk.id);
+            const safeType = escapeHtml(pk.authenticatorType || 'Passkey');
+            const safeCreated = escapeHtml(pk.createdAt || 'Unknown');
+            const safeLastUsed = escapeHtml(pk.lastUsedAt || 'Never');
+
+            const renameMarkup = isEditing
+              ? '<form class="rename-row" data-rename-form-id="' +
+                safeId +
+                '">' +
+                '<input type="text" class="form-input rename-input" data-rename-input-id="' +
+                safeId +
+                '" value="' +
+                safeName +
+                '" aria-label="New passkey name" required>' +
+                '<button type="submit" class="btn-action btn-sm">Save</button>' +
+                '<button type="button" class="btn-action btn-secondary btn-sm" data-action="cancel-rename" data-id="' +
+                safeId +
+                '">Cancel</button>' +
+                '</form>'
+              : '';
+
+            return (
+              '<li class="passkey-item" data-credential-id="' +
+              safeId +
+              '">' +
+              '<div class="passkey-info">' +
+              '<div class="passkey-title-row">' +
+              '<span class="passkey-name">' +
+              safeName +
+              '</span>' +
+              '<span class="passkey-badge">' +
+              safeType +
+              '</span>' +
+              '</div>' +
+              '<div class="passkey-meta">' +
+              '<span>ID: <code>' +
+              safeId +
+              '</code></span>' +
+              '<span>Created: ' +
+              safeCreated +
+              '</span>' +
+              '<span>Last used: ' +
+              safeLastUsed +
+              '</span>' +
+              '</div>' +
+              renameMarkup +
+              '</div>' +
+              '<div class="passkey-actions">' +
+              '<button type="button" class="btn-action btn-secondary btn-sm" data-action="start-rename" data-id="' +
+              safeId +
+              '">Rename</button>' +
+              '<button type="button" class="btn-action btn-danger btn-sm" data-action="delete-passkey" data-id="' +
+              safeId +
+              '">Delete</button>' +
+              '</div>' +
+              '</li>'
+            );
+          })
+          .join('');
+      }
+
+      async function handleDeletePasskey(credentialId) {
+        const target = state.passkeys.find(function (pk) {
+          return pk.id === credentialId;
+        });
+        if (!target) return;
+
+        state.passkeys = state.passkeys.filter(function (pk) {
+          return pk.id !== credentialId;
+        });
+        if (editingCredentialId === credentialId) {
+          editingCredentialId = null;
+        }
+        saveState();
+        renderPasskeys();
+
+        try {
+          await signalUnknownCredentialToAuthenticator(credentialId);
+          await signalAllAcceptedCredentialsToAuthenticator();
+          updateStatusBanner(
+            '<strong>Passkey Removed &amp; Authenticator Synced:</strong> Deleted <em>' +
+              escapeHtml(target.name) +
+              '</em> (<code>' +
+              escapeHtml(credentialId) +
+              '</code>) and signaled <code>PublicKeyCredential.signalUnknownCredential</code> &amp; <code>signalAllAcceptedCredentials</code> to your browser authenticator.',
+            'success'
+          );
+        } catch (err) {
+          updateStatusBanner(
+            '<strong>Passkey Removed:</strong> Deleted <em>' +
+              escapeHtml(target.name) +
+              '</em> from your account, but browser authenticator signal reported: ' +
+              escapeHtml(err && err.message ? err.message : String(err)),
+            'warning'
+          );
+        }
+      }
+
+      async function handleRenamePasskey(credentialId, newName) {
+        const trimmed = (newName || '').trim();
+        if (!trimmed) return;
+        const target = state.passkeys.find(function (pk) {
+          return pk.id === credentialId;
+        });
+        if (!target) return;
+
+        const oldName = target.name;
+        target.name = trimmed;
+        editingCredentialId = null;
+        saveState();
+        renderPasskeys();
+
+        try {
+          await signalCurrentUserDetailsToAuthenticator();
+          await signalAllAcceptedCredentialsToAuthenticator();
+          updateStatusBanner(
+            '<strong>Passkey Renamed &amp; Synced:</strong> Updated <em>' +
+              escapeHtml(oldName) +
+              '</em> to <em>' +
+              escapeHtml(trimmed) +
+              '</em> and synchronized your browser authenticator via <code>signalCurrentUserDetails</code> &amp; <code>signalAllAcceptedCredentials</code>.',
+            'success'
+          );
+        } catch (err) {
+          updateStatusBanner(
+            '<strong>Passkey Renamed:</strong> Updated to <em>' +
+              escapeHtml(trimmed) +
+              '</em>.',
+            'warning'
+          );
+        }
+      }
+
+      async function handleRegisterPasskey(nicknameInput) {
