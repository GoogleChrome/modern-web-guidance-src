+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fallback to local simulated store
+  }
+  const currentUser = getStoredUser();
+  const updatedUser = {
+    ...currentUser,
+    name: (body.name ?? currentUser.name).trim(),
+    displayName: (body.displayName ?? currentUser.displayName).trim()
+  };
