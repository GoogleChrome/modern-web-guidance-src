+/**
+ * Synchronize accepted credential IDs with the browser's password manager / authenticator
+ * using the WebAuthn Signal API (`PublicKeyCredential.signalAllAcceptedCredentials`).
+ */
+export async function syncAcceptedCredentials(currentCredentialsList) {
+  const base64UrlUserId = currentUser.id;
+  const credentialIds = currentCredentialsList.map((c) => c.id);
+
+  recordSignalEvent('signalAllAcceptedCredentials', {
+    rpId,
+    userId: base64UrlUserId,
+    allAcceptedCredentialIds: credentialIds
+  });
+
+  if (!window.PublicKeyCredential || !PublicKeyCredential.signalAllAcceptedCredentials) {
+    return;
+  }
+
+  try {
+    await PublicKeyCredential.signalAllAcceptedCredentials({
+      rpId,
+      userId: base64UrlUserId, // Base64URL-encoded User ID string
+      allAcceptedCredentialIds: credentialIds // Array of Base64URL credential ID strings
+    });
+  } catch (e) {
+    console.error('SignalAllAcceptedCredentials sync failure:', e);
+  }
+}
+
+/**
+ * Render the user's account profile details.
+ */
+function renderUserProfile(user) {
+  currentUser = user;
+  const displayNameInput = document.getElementById('account-display-name');
+  const usernameInput = document.getElementById('account-username');
+  const profileHeading = document.getElementById('profile-heading-name');
+  const profileSubheading = document.getElementById('profile-heading-email');
+  const avatarInitials = document.getElementById('profile-avatar-initials');
+
+  if (displayNameInput && document.activeElement !== displayNameInput) {
+    displayNameInput.value = user.displayName || '';
+  }
+  if (usernameInput && document.activeElement !== usernameInput) {
+    usernameInput.value = user.name || '';
+  }
+  if (profileHeading) {
+    profileHeading.textContent = user.displayName || 'Coffee Lover';
+  }
+  if (profileSubheading) {
+    profileSubheading.textContent = user.name || '';
+  }
+  if (avatarInitials) {
+    const initials = (user.displayName || 'DG')
+      .split(/\s+/)
+      .filter(Boolean)
+      .slice(0, 2)
+      .map((part) => part[0].toUpperCase())
+      .join('');
+    avatarInitials.textContent = initials || 'DG';
+  }
+}
+
+/**
+ * Render the list of registered passkeys inside the management container.
+ */
+export function renderUI(credentialsList) {
+  const listContainer = document.getElementById('passkey-list');
+  const emptyState = document.getElementById('passkey-empty-state');
+  const countBadge = document.getElementById('passkey-count-badge');
+
+  if (countBadge) {
+    countBadge.textContent = `${credentialsList.length} ${
+      credentialsList.length === 1 ? 'passkey' : 'passkeys'
+    }`;
+  }
+
+  if (!listContainer) return;
+  listContainer.innerHTML = '';
+
+  if (!credentialsList || credentialsList.length === 0) {
+    if (emptyState) emptyState.hidden = false;
+    return;
+  }
+
+  if (emptyState) emptyState.hidden = true;
+
+  for (const cred of credentialsList) {
+    const providerInfo = getProviderDetailsFromAaguid(cred.aaguid);
+    const displayName = cred.name || providerInfo.name;
+    const providerName = providerInfo.name;
+    const iconSrc = cred.providerIcon || providerInfo.providerIcon || DEFAULT_PASSKEY_ICON;
+    const registeredDateStr = formatEpochDate(cred.registeredAt);
+    const lastUsedDateStr = cred.lastUsedAt
+      ? formatEpochDate(cred.lastUsedAt)
+      : 'Never used';
+
+    const item = document.createElement('div');
+    item.className = 'passkey-row';
+    item.dataset.credentialId = cred.id;
+    item.dataset.aaguid = cred.aaguid || '00000000-0000-0000-0000-000000000000';
+
+    const isEditing = activeRenameId === cred.id;
+
+    // Provider Icon
+    const iconWrapper = document.createElement('div');
+    iconWrapper.className = 'passkey-provider-icon-wrap';
+    const img = document.createElement('img');
+    img.className = 'passkey-provider-icon';
+    img.src = iconSrc;
+    img.alt = `${providerName} icon`;
+    img.width = 36;
+    img.height = 36;
+    iconWrapper.appendChild(img);
+
+    // Details column (Name + Dates)
+    const infoCol = document.createElement('div');
+    infoCol.className = 'passkey-info';
+
+    if (isEditing) {
+      const editForm = document.createElement('form');
+      editForm.className = 'passkey-rename-inline-form';
+      editForm.addEventListener('submit', async (e) => {
+        e.preventDefault();
+        const inputVal = renameInput.value.trim();
+        if (!inputVal) return;
+        activeRenameId = null;
+        await performCredentialRename(cred.id, inputVal);
+      });
+
+      const renameInput = document.createElement('input');
+      renameInput.type = 'text';
+      renameInput.className = 'passkey-rename-input';
+      renameInput.value = displayName;
+      renameInput.setAttribute('aria-label', 'Passkey nickname');
+      renameInput.required = true;
+
+      const saveBtn = document.createElement('button');
+      saveBtn.type = 'submit';
+      saveBtn.className = 'btn-small btn-primary';
+      saveBtn.textContent = 'Save';
+
+      const cancelBtn = document.createElement('button');
+      cancelBtn.type = 'button';
+      cancelBtn.className = 'btn-small btn-ghost';
+      cancelBtn.textContent = 'Cancel';
+      cancelBtn.addEventListener('click', () => {
+        activeRenameId = null;
+        renderUI(credentialsList);
+      });
+
+      editForm.append(renameInput, saveBtn, cancelBtn);
+      infoCol.appendChild(editForm);
+      setTimeout(() => renameInput.focus(), 0);
+    } else {
+      const titleRow = document.createElement('div');
+      titleRow.className = 'passkey-title-row';
+
+      const nameEl = document.createElement('span');
+      nameEl.className = 'passkey-name';
+      nameEl.textContent = displayName;
+      titleRow.appendChild(nameEl);
+
+      if (displayName !== providerName && providerName !== 'Unknown passkey provider') {
+        const providerBadge = document.createElement('span');
+        providerBadge.className = 'passkey-provider-badge';
+        providerBadge.textContent = providerName;
+        titleRow.appendChild(providerBadge);
+      }
+
+      if (cred.credentialBackedUp) {
+        const syncBadge = document.createElement('span');
+        syncBadge.className = 'passkey-sync-badge';
+        syncBadge.textContent = 'Synced';
+        titleRow.appendChild(syncBadge);
+      }
+
+      infoCol.appendChild(titleRow);
+    }
+
+    const metaRow = document.createElement('div');
+    metaRow.className = 'passkey-meta';
+
+    const regSpan = document.createElement('span');
+    regSpan.className = 'passkey-date-registered';
+    regSpan.innerHTML = `<strong>Created:</strong> <time datetime="${new Date(cred.registeredAt).toISOString()}">${registeredDateStr}</time>`;
+
+    const usedSpan = document.createElement('span');
+    usedSpan.className = 'passkey-date-used';
+    usedSpan.innerHTML = cred.lastUsedAt
+      ? `<strong>Last used:</strong> <time datetime="${new Date(cred.lastUsedAt).toISOString()}">${lastUsedDateStr}</time>`
+      : `<strong>Last used:</strong> Never`;
+
+    metaRow.append(regSpan, usedSpan);
+    infoCol.appendChild(metaRow);
+
+    // Actions column (Rename + Delete buttons)
+    const actionsCol = document.createElement('div');
+    actionsCol.className = 'passkey-actions';
+
+    const renameBtn = document.createElement('button');
+    renameBtn.type = 'button';
+    renameBtn.className = 'btn-action btn-rename';
+    renameBtn.setAttribute('aria-label', `Rename ${displayName}`);
+    renameBtn.textContent = 'Rename';
+    renameBtn.addEventListener('click', () => {
+      activeRenameId = cred.id;
+      renderUI(credentialsList);
+    });
+
+    const deleteBtn = document.createElement('button');
+    deleteBtn.type = 'button';
+    deleteBtn.className = 'btn-action btn-delete';
+    deleteBtn.setAttribute('aria-label', `Delete ${displayName}`);
+    deleteBtn.textContent = 'Delete';
+    deleteBtn.addEventListener('click', () => {
+      performDelete(cred.id);
+    });
+
+    actionsCol.append(renameBtn, deleteBtn);
+
+    item.append(iconWrapper, infoCol, actionsCol);
+    listContainer.appendChild(item);
+  }
+}
+
+/**
+ * Load the management panel, render stored credentials, and invoke
+ * PublicKeyCredential.signalAllAcceptedCredentials() on page load.
+ */
+export async function loadManagementPanel() {
+  renderUserProfile(getStoredUser());
+  const response = await listFetch();
+  const list = await response.json();
+
+  renderUI(list);
+  // Sync accepted credentials on initial page load
+  await syncAcceptedCredentials(list);
+}
+
+/**
+ * Delete a credential on the server and synchronize remaining accepted credential IDs
+ * with the browser authenticator via PublicKeyCredential.signalAllAcceptedCredentials().
+ */
+export async function performDelete(credentialId) {
+  const response = await deleteFetch(credentialId);
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+
+    renderUI(updatedList);
+    // Sync remaining accepted credentials after deletion
+    await syncAcceptedCredentials(updatedList);
+    showStatusBanner('Passkey deleted and browser authenticator synchronized.', 'success');
+  } else {
+    showStatusBanner('Could not delete passkey. Please try again.', 'error');
+  }
+}
+
+/**
+ * Rename a passkey's custom nickname on the server.
+ * Note: Renaming an individual passkey's nickname is a server-side label change
+ * and does NOT invoke signalCurrentUserDetails().
+ */
+export async function performCredentialRename(credentialId, newCredentialName) {
+  const response = await renameCredentialFetch(credentialId, { name: newCredentialName });
+  if (response.ok) {
+    const updatedResponse = await listFetch();
+    renderUI(await updatedResponse.json());
+    showStatusBanner(`Passkey renamed to "${newCredentialName}".`, 'success');
+  } else {
+    showStatusBanner('Could not rename passkey. Please try again.', 'error');
+  }
+}
+
+/**
+ * Update the user's account username (`name`) or `displayName` on the server
+ * and immediately synchronize the updated user details with the password manager
+ * via PublicKeyCredential.signalCurrentUserDetails().
+ */
+export async function performUserRename(targetRpId, userId, updatedName, updatedDisplayName) {
+  const response = await updateUserFetch({
+    name: updatedName,
+    displayName: updatedDisplayName
+  });
+
+  if (response.ok) {
+    const updatedUser = await response.json();
+    renderUserProfile(updatedUser);
+
+    recordSignalEvent('signalCurrentUserDetails', {
+      rpId: targetRpId,
+      userId,
+      name: updatedName,
+      displayName: updatedDisplayName
+    });
+
+    if (window.PublicKeyCredential && PublicKeyCredential.signalCurrentUserDetails) {
+      try {
+        await PublicKeyCredential.signalCurrentUserDetails({
+          rpId: targetRpId, // RP ID matching server
+          userId, // Base64URL-encoded user ID
+          name: updatedName, // Updated username
+          displayName: updatedDisplayName // Updated display name
+        });
+      } catch (e) {
+        console.error('SignalCurrentUserDetails sync failure:', e);
+      }
+    }
+    showStatusBanner('Account profile updated and synced with your authenticator.', 'success');
+  } else {
+    showStatusBanner('Could not update account details.', 'error');
+  }
+}
+
+/**
+ * Gate the "Create passkey" button using PublicKeyCredential.getClientCapabilities().
+ */
+async function checkPasskeyCapabilities() {
+  const createBtn = document.getElementById('create-passkey-btn');
+  const fallbackNote = document.getElementById('passkey-unsupported-fallback');
+
+  if (!window.PublicKeyCredential || !PublicKeyCredential.getClientCapabilities) {
+    if (createBtn) {
+      createBtn.hidden = true;
+      createBtn.disabled = true;
+    }
+    if (fallbackNote) fallbackNote.hidden = false;
+    return false;
+  }
+
+  try {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    // Note: webauthn-polyfills sets userVerifyingPlatformAuthenticator when native passkeyPlatformAuthenticator is undefined
+    const isPlatformSupported =
+      capabilities.passkeyPlatformAuthenticator ??
+      capabilities.userVerifyingPlatformAuthenticator ??
+      false;
+    const isConditionalSupported = capabilities.conditionalGet ?? true;
+
+    if (!isPlatformSupported || !isConditionalSupported) {
+      if (createBtn) {
+        createBtn.hidden = true;
+        createBtn.disabled = true;
+      }
+      if (fallbackNote) fallbackNote.hidden = false;
+      return false;
+    }
+
+    if (createBtn) {
+      createBtn.hidden = false;
+      createBtn.disabled = false;
+    }
+    if (fallbackNote) fallbackNote.hidden = true;
+    return true;
+  } catch (e) {
+    console.warn('Error checking client capabilities:', e);
+    return false;
+  }
+}
+
+/**
+ * Register a new passkey using WebAuthn native JSON parsing and serialization methods,
+ * with segregated try/catch blocks and signalUnknownCredential on verification failure.
+ */
+export async function registerPasskey(isPromotion = false) {
+  if (window.PublicKeyCredential && PublicKeyCredential.getClientCapabilities) {
+    const capabilities = await PublicKeyCredential.getClientCapabilities();
+    const isPlatformSupported =
+      capabilities.passkeyPlatformAuthenticator ??
+      capabilities.userVerifyingPlatformAuthenticator ??
+      false;
+    if (!isPlatformSupported || !capabilities.conditionalGet) {
+      const createBtn = document.getElementById('create-passkey-btn');
+      const fallbackNote = document.getElementById('passkey-unsupported-fallback');
+      if (createBtn) createBtn.hidden = true;
+      if (fallbackNote) fallbackNote.hidden = false;
+      return;
+    }
+  }
+
+  const creationOptionsJSON = await optionsFetch({ promotion: isPromotion });
+  const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(creationOptionsJSON);
+
+  let credential;
+  try {
+    credential = await navigator.credentials.create({ publicKey });
+  } catch (err) {
+    if (err.name === 'InvalidStateError') {
+      showStatusBanner('A passkey already exists for this authenticator.', 'warning');
+    } else if (err.name === 'SecurityError') {
+      showStatusBanner('Configuration RP ID or Secure Context error.', 'error');
+    } else if (err.name === 'NotAllowedError') {
+      showStatusBanner('Passkey creation was cancelled.', 'info');
+    } else if (err.name === 'AbortError') {
+      console.log('The creation operation has been aborted.');
+    }
+    return; // Safe exit: do not signal unknown credential for user cancellation
+  }
+
+  if (!credential) return;
+
+  // Server Verification phase (Segregated Try/Catch)
+  const encodedResponse = credential.toJSON();
+  try {
+    const response = await registerVerifyFetch(encodedResponse);
+    if (!response.ok) {
+      if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+        await PublicKeyCredential.signalUnknownCredential({
+          rpId,
+          credentialId: encodedResponse.id
+        });
+      }
+      showStatusBanner('Server verification failed for the new passkey.', 'error');
+      return;
+    }
+    const updatedResponse = await listFetch();
+    const updatedList = await updatedResponse.json();
+    renderUI(updatedList);
+    await syncAcceptedCredentials(updatedList);
+    showStatusBanner('New passkey registered and synced with your account.', 'success');
+  } catch (serverErr) {
+    console.error('Server verification network failure:', serverErr);
+    if (window.PublicKeyCredential && PublicKeyCredential.signalUnknownCredential) {
+      await PublicKeyCredential.signalUnknownCredential({
+        rpId,
+        credentialId: encodedResponse.id
+      });
+    }
+    showStatusBanner('Network error while verifying passkey.', 'error');
+  }
+}
+
+function setupEventListeners() {
+  const userForm = document.getElementById('user-profile-form');
+  if (userForm) {
+    userForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      const displayNameInput = document.getElementById('account-display-name');
+      const usernameInput = document.getElementById('account-username');
+      const updatedDisplayName = displayNameInput ? displayNameInput.value.trim() : currentUser.displayName;
+      const updatedName = usernameInput ? usernameInput.value.trim() : currentUser.name;
+      if (!updatedName || !updatedDisplayName) return;
+
+      await performUserRename(rpId, currentUser.id, updatedName, updatedDisplayName);
+    });
+  }
+
+  const createBtn = document.getElementById('create-passkey-btn');
+  if (createBtn) {
+    createBtn.addEventListener('click', () => {
+      registerPasskey(false);
+    });
+  }
+
+  const resetBtn = document.getElementById('reset-demo-passkeys-btn');
+  if (resetBtn) {
+    resetBtn.addEventListener('click', async () => {
+      resetDemoCredentials();
+      await loadManagementPanel();
+      showStatusBanner('Demo passkeys and profile reset to default.', 'info');
+    });
+  }
+}
+
+async function initPasskeyManagement() {
+  setupEventListeners();
+  await checkPasskeyCapabilities();
+  await loadManagementPanel();
+}
+
+if (document.readyState === 'loading') {
+  window.addEventListener('DOMContentLoaded', initPasskeyManagement);
+} else {
+  initPasskeyManagement();
+}
