+/**
+ * Resolve provider metadata from AAGUID registry.
+ * Checks for '00000000-0000-0000-0000-000000000000' before lookup.
+ */
+export function getProviderDetailsFromAaguid(aaguid) {
+  if (!aaguid || aaguid === '00000000-0000-0000-0000-000000000000') {
+    return {
+      name: 'Unknown passkey provider',
+      providerIcon: undefined
+    };
+  }
+  const provider = aaguids[aaguid];
+  return {
