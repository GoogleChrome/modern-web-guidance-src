+
+export async function optionsFetch({ promotion = false } = {}) {
+  try {
+    const res = await fetch('/api/register/options', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify({ promotion })
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return await res.json();
+    }
+  } catch {
+    // Fallback to local options generation
+  }
+
+  const user = getStoredUser();
+  const existingCredentials = getStoredCredentials();
+  const challenge = generateRandomBase64Url(32);
+  try {
+    sessionStorage.setItem(STORAGE_KEY_CHALLENGE, challenge);
+  } catch {
+    // Ignore sessionStorage errors
+  }
+
+  // Note: Omit authenticatorAttachment in management flow so security keys and platform authenticators are both allowed
+  const authenticatorSelection = {
+    residentKey: 'required',
+    requireResidentKey: true,
+    userVerification: 'preferred',
+    ...(promotion && { authenticatorAttachment: 'platform' })
+  };
+
+  return {
+    challenge,
+    rp: {
+      id: getRpId(),
+      name: 'The Daily Grind'
+    },
+    user: {
+      id: user.id,
+      name: user.name,
+      displayName: user.displayName
+    },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },
+      { type: 'public-key', alg: -257 }
+    ],
+    excludeCredentials: existingCredentials.map((cred) => ({
+      type: 'public-key',
+      id: cred.id,
+      transports: cred.transports || ['internal', 'hybrid']
+    })),
+    authenticatorSelection
+  };
+}
+
+export async function registerVerifyFetch(encodedResponse) {
