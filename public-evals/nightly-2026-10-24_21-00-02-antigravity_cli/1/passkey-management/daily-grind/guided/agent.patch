+}
+
+export async function renameCredentialFetch(credentialId, body) {
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+      body: JSON.stringify(body)
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fallback to local simulated store
+  }
+  const creds = getStoredCredentials();
+  const idx = creds.findIndex((c) => c.id === credentialId);
+  if (idx === -1) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  creds[idx] = {
+    ...creds[idx],
+    name: (body.name || '').trim() || creds[idx].name
+  };
+  saveStoredCredentials(creds);
+  return jsonResponse(creds[idx]);
+}
+
+export async function deleteFetch(credentialId) {
+  try {
+    const res = await fetch(`/api/credential/${encodeURIComponent(credentialId)}`, {
+      method: 'DELETE',
+      headers: { Accept: 'application/json' }
+    });
+    if (res.ok && res.headers.get('content-type')?.includes('application/json')) {
+      return res;
+    }
+  } catch {
+    // Fallback to local simulated store
+  }
+  const creds = getStoredCredentials();
+  const idx = creds.findIndex((c) => c.id === credentialId);
+  if (idx === -1) {
+    return jsonResponse({ error: 'Credential not found.' }, 404);
+  }
+  creds.splice(idx, 1);
+  saveStoredCredentials(creds);
+  return jsonResponse({ success: true });
+}
+
+export async function updateUserFetch(body) {
