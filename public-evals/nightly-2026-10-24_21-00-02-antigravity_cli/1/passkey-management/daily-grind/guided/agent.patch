+  banner.hidden = false;
+}
+
+function recordSignalEvent(signalName, payload) {
+  const logEl = document.getElementById('signal-sync-indicator');
+  if (!logEl) return;
+  const supported = Boolean(
+    window.PublicKeyCredential && window.PublicKeyCredential[signalName]
+  );
+  logEl.textContent = supported
+    ? `Authenticator synced via PublicKeyCredential.${signalName}()`
+    : `Authenticator sync Checked (${signalName} — progressive enhancement)`;
+  logEl.dataset.lastSignal = signalName;
+  logEl.dataset.lastPayload = JSON.stringify(payload);
+}
