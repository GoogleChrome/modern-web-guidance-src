+<!DOCTYPE html>
+<html lang="en">
+
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>My Account | The Daily Grind</title>
+  <link rel="stylesheet" href="/account.css">
+</head>
+
+<body>
+
+  <nav>
+    <a href="/" class="logo">THE DAILY GRIND</a>
+    <ul>
+      <li><a href="/menu">Menu</a></li>
+      <li><a href="/locations">Locations</a></li>
+      <li><a href="/rewards">Rewards</a></li>
+      <li><a href="/account" class="active" aria-current="page">My Account</a></li>
+      <li><a href="/logout" class="logout-link">Logout</a></li>
+    </ul>
+  </nav>
+
+  <header class="account-header">
+    <div class="account-header-inner">
+      <div class="profile-avatar" id="profile-avatar-initials" aria-hidden="true">AR</div>
+      <div class="profile-summary">
+        <span class="member-badge">Gold Roaster &bull; 480 Beans</span>
+        <h1 id="profile-heading-name">Alex Rivera</h1>
+        <p id="profile-heading-email">alex.rivera@dailygrind.coffee</p>
+      </div>
+    </div>
+  </header>
+
+  <main class="container">
+    <div id="passkey-status-banner" class="status-banner" role="status" aria-live="polite" hidden></div>
+
+    <div class="account-layout">
+      <!-- Profile & Account Identity Details -->
+      <section class="panel profile-panel" aria-labelledby="profile-section-title">
+        <div class="panel-header">
+          <div>
+            <h2 id="profile-section-title">Account Profile</h2>
+            <p class="panel-subtitle">Update your username or display name and keep your browser's passkey authenticator in sync.</p>
+          </div>
+        </div>
+
+        <form id="user-profile-form" class="profile-form">
+          <div class="form-group">
+            <label for="account-display-name">Display Name</label>
+            <input
+              type="text"
+              id="account-display-name"
+              name="displayName"
+              value="Alex Rivera"
+               autocomplete="name"
+              required
+            >
+          </div>
+
+          <div class="form-group">
+            <label for="account-username">Username / Email</label>
+            <input
+              type="email"
+              id="account-username"
+              name="name"
+              value="alex.rivera@dailygrind.coffee"
+              autocomplete="username"
+              required
+            >
+          </div>
+
+          <div class="form-actions">
+            <button type="submit" id="save-profile-btn" class="btn btn-primary">
+              Save Profile &amp; Sync Authenticator
+            </button>
+          </div>
+        </form>
+      </section>
+
+      <!-- Passkey Management Panel -->
+      <section class="panel passkeys-panel" aria-labelledby="passkeys-section-title">
+        <div class="panel-header passkeys-panel-header">
+          <div>
+            <div class="title-with-badge">
+              <h2 id="passkeys-section-title">Registered Passkeys</h2>
+              <span id="passkey-count-badge" class="count-badge">3 passkeys</span>
+            </div>
+            <p class="panel-subtitle">
+              Passkeys let you sign in securely to The Daily Grind using your fingerprint, face, or screen lock without a password.
+            </p>
+          </div>
+
+          <div class="header-actions">
+            <button type="button" id="create-passkey-btn" class="btn btn-accent">
+              + Create passkey
+            </button>
+          </div>
+        </div>
+
+        <div id="passkey-unsupported-fallback" class="fallback-notice" hidden>
+          <strong>Passkeys unavailable on this device:</strong> Your current browser or device does not support platform passkeys. We recommend enabling standard multi-factor authentication (MFA) in your security preferences.
+        </div>
+
+        <!-- Dynamic Passkey List -->
+        <div id="passkey-list" class="passkey-list" role="list" aria-label="Registered passkeys"></div>
+
+        <!-- Empty State -->
+        <div id="passkey-empty-state" class="empty-state" hidden>
+          <p class="empty-state-title">No passkeys found</p>
+          <p class="empty-state-text">
+            You haven't registered any passkeys on your account yet. Add a passkey for faster, phishing-resistant sign-ins.
+          </p>
+        </div>
+
+        <div class="passkey-footer-bar">
+          <span id="signal-sync-indicator" class="signal-sync-indicator">
+            Authenticator sync ready
+          </span>
+          <button type="button" id="reset-demo-passkeys-btn" class="btn-link">
+            Reset demo passkeys
+          </button>
+        </div>
+      </section>
+    </div>
+  </main>
+
+  <footer>
+    <div class="footer-links">
+      <a href="/about">Our Story</a> |
+      <a href="/careers">Join the Team</a> |
+      <a href="/contact">Contact Us</a> |
+      <a href="/privacy-policy">Privacy</a>
+    </div>
+    <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
+  </footer>
+
+  <script type="module">
+    if (window.PublicKeyCredential && !PublicKeyCredential.parseRequestOptionsFromJSON) {
+      await import('/webauthn-polyfills.js');
+    }
+  </script>
+  <script type="module" src="/passkey-management.js"></script>
+</body>
+
+</html>
