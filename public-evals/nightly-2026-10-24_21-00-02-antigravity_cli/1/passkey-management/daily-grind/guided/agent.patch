+function formatEpochDate(epochMs) {
+  if (!epochMs) return 'Never used';
+  try {
+    return new Intl.DateTimeFormat('en-US', {
+      year: 'numeric',
+      month: 'short',
+      day: 'numeric'
+    }).format(new Date(epochMs));
+  } catch {
+    return new Date(epochMs).toLocaleDateString();
+  }
+}
