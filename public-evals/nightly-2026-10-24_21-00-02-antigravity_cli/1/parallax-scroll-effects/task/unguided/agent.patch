+    /* Scroll-Driven Parallax Section */
+    .parallax-section {
+      position: relative;
+      height: 75vh;
+      min-height: 520px;
+      overflow: hidden;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      background-color: #2b1b17;
+      color: var(--light);
+      view-timeline-name: --craft-parallax;
+      view-timeline-axis: block;
+    }
+
+    .parallax-layer {
+      position: absolute;
+      inset: -20% 0;
+      pointer-events: none;
+      will-change: transform;
+    }
+
+    /* Deep background layer: moves slowest relative to scroll */
+    .parallax-layer--back {
+      z-index: 1;
+      background:
+        linear-gradient(180deg, rgba(43, 27, 23, 0.72) 0%, rgba(43, 27, 23, 0.55) 50%, rgba(43, 27, 23, 0.82) 100%),
+        url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=1600&q=80') center / cover no-repeat;
+    }
+
+    /* Midground layer: moves at medium speed */
+    .parallax-layer--mid {
+      z-index: 2;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      padding: 0 6%;
+    }
+
+    .parallax-photo-card {
+      width: clamp(180px, 24vw, 290px);
+      aspect-ratio: 4 / 5;
+      border-radius: 12px;
+      overflow: hidden;
+      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
+      border: 2px solid rgba(255, 171, 64, 0.35);
+      background-color: var(--primary);
+    }
+
+    .parallax-photo-card img {
+      width: 100%;
+      height: 100%;
+      object-fit: cover;
+      display: block;
+    }
+
+    .parallax-photo-card--left {
+      transform: rotate(-4deg);
+      margin-top: -60px;
+    }
+
+    .parallax-photo-card--right {
+      transform: rotate(4deg);
+      margin-top: 80px;
+    }
+
+    /* Foreground decorative accents: moves fastest */
+    .parallax-layer--front {
+      z-index: 3;
+      display: flex;
+      justify-content: space-around;
+      align-items: center;
+      padding: 0 12%;
+    }
+
+    .floating-badge {
+      width: 96px;
+      height: 96px;
+      border-radius: 50%;
+      background: radial-gradient(circle at 30% 30%, rgba(255, 171, 64, 0.32), rgba(78, 52, 46, 0.75));
+      border: 1px solid rgba(255, 171, 64, 0.5);
+      backdrop-filter: blur(4px);
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
+    }
+
+    .floating-badge svg {
+      width: 44px;
+      height: 44px;
+      fill: var(--accent);
+    }
+
+    .floating-badge--top {
+      align-self: flex-start;
+      margin-top: 12%;
+    }
+
+    .floating-badge--bottom {
+      align-self: flex-end;
+      margin-bottom: 12%;
+    }
+
+    /* Content card anchored in foreground */
+    .parallax-content {
+      position: relative;
+      z-index: 4;
+      max-width: 600px;
+      margin: 0 20px;
+      padding: 2.5rem 2rem;
+      text-align: center;
+      background: rgba(43, 27, 23, 0.84);
+      border: 1px solid rgba(215, 204, 200, 0.25);
+      border-radius: 12px;
+      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
+      backdrop-filter: blur(8px);
+      will-change: transform;
+    }
+
+    .parallax-eyebrow {
+      display: inline-block;
+      text-transform: uppercase;
+      letter-spacing: 2px;
+      font-size: 0.8rem;
+      font-weight: 700;
+      color: var(--accent);
+      margin-bottom: 0.5rem;
+    }
+
+    .parallax-content h2 {
+      font-size: 2.25rem;
+      margin-bottom: 1rem;
+      color: #ffffff;
+    }
+
+    .parallax-content p {
+      color: var(--secondary);
+      font-size: 1.05rem;
+      margin-bottom: 1.25rem;
+    }
+
+    @keyframes parallax-shift-back {
+      from {
+        transform: translate3d(0, -14%, 0) scale(1.08);
+      }
+      to {
+        transform: translate3d(0, 14%, 0) scale(1.08);
+      }
+    }
+
+    @keyframes parallax-shift-mid {
+      from {
+        transform: translate3d(0, 18%, 0);
+      }
+      to {
+        transform: translate3d(0, -18%, 0);
+      }
+    }
+
+    @keyframes parallax-shift-front {
+      from {
+        transform: translate3d(0, 34%, 0);
+      }
+      to {
+        transform: translate3d(0, -34%, 0);
+      }
+    }
+
+    @keyframes parallax-shift-content {
+      from {
+        transform: translate3d(0, 8%, 0);
+      }
+      to {
+        transform: translate3d(0, -8%, 0);
+      }
+    }
+
+    /* Enable pure CSS scroll-driven parallax only when user has no reduced-motion preference */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) {
+        .parallax-layer--back {
+          animation: parallax-shift-back linear both;
+          animation-timeline: --craft-parallax;
+          animation-range: entry 0% exit 100%;
+        }
+
+        .parallax-layer--mid {
+          animation: parallax-shift-mid linear both;
+          animation-timeline: --craft-parallax;
+          animation-range: entry 0% exit 100%;
+        }
+
+        .parallax-layer--front {
+          animation: parallax-shift-front linear both;
+          animation-timeline: --craft-parallax;
+          animation-range: entry 0% exit 100%;
+        }
+
+        .parallax-content {
+          animation: parallax-shift-content linear both;
+          animation-timeline: --craft-parallax;
+          animation-range: entry 0% exit 100%;
+        }
+      }
+    }
+
+    @media (max-width: 768px) {
+      .parallax-photo-card {
+        opacity: 0.35;
+      }
+
+      .floating-badge {
+        display: none;
+      }
+
+      .parallax-content h2 {
+        font-size: 1.8rem;
+      }
+    }
+
