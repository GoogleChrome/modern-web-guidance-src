+  <script>
+    /**
+     * Accurately detects whether the page was initially loaded in a background tab
+     * or backgrounded during load, and records the exact timestamp (in milliseconds)
+     * of when it was backgrounded.
+     */
+    (function detectInitialBackgroundLoad() {
+      let wasBackgrounded = false;
+      let backgroundTime = null;
+      let isFallbackDetection = false;
+
+      // Primary Detection: Use the Performance Timeline API ('visibility-state' entries)
+      // Browsers supporting VisibilityStateEntry record exact historical visibility transitions
+      // starting at startTime: 0 (initial page load), making this accurate even for async/late scripts.
+      const supportsVisibilityStateEntries =
+        typeof PerformanceObserver !== 'undefined' &&
+        Array.isArray(PerformanceObserver.supportedEntryTypes) &&
+        PerformanceObserver.supportedEntryTypes.includes('visibility-state');
+
+      const visibilityEntries =
+        typeof performance !== 'undefined' && typeof performance.getEntriesByType === 'function'
+          ? performance.getEntriesByType('visibility-state')
+          : [];
+
+      if (supportsVisibilityStateEntries || visibilityEntries.length > 0) {
+        const finalizeDetection = (entries) => {
+          // Entry at startTime === 0 represents the initial visibility state when navigation started
+          const initialEntry = entries.find((e) => e.startTime === 0) || entries[0];
+          const firstHiddenEntry = entries.find((e) => e.name === 'hidden');
+
+          const initiallyLoadedInBackground = initialEntry ? initialEntry.name === 'hidden' : false;
+          wasBackgrounded = Boolean(firstHiddenEntry);
+          backgroundTime = firstHiddenEntry ? firstHiddenEntry.startTime : null;
+
+          const detectionInfo = {
+            wasBackgrounded,
+            loadedInBackground: initiallyLoadedInBackground,
+            backgroundStatus: wasBackgrounded,
+            backgroundTime,
+            fallbackActive: false,
+            detectionMethod: 'PerformanceVisibilityStateEntry'
+          };
+
+          console.log(detectionInfo);
+
+          // Also listen for future background transitions if not yet backgrounded
+          if (!wasBackgrounded) {
+            document.addEventListener(
+              'visibilitychange',
+              (event) => {
+                if (document.visibilityState === 'hidden') {
+                  console.log({
+                    wasBackgrounded: true,
+                    loadedInBackground: false,
+                    backgroundStatus: true,
+                    backgroundTime: event.timeStamp,
+                    fallbackActive: false,
+                    detectionMethod: 'visibilitychange'
+                  });
+                }
+              },
+              { once: true, capture: true }
+            );
+          }
+        };
+
+        if (visibilityEntries.length > 0) {
+          finalizeDetection(visibilityEntries);
+        } else {
+          // Use buffered PerformanceObserver to retrieve initial visibility-state entries
+          const observer = new PerformanceObserver((list) => {
+            const entries = list.getEntries();
+            if (entries.length > 0) {
+              observer.disconnect();
+              finalizeDetection(entries);
+            }
+          });
+          observer.observe({ type: 'visibility-state', buffered: true });
+        }
+      } else {
+        // WARNING: Legacy Fallback Detection Active!
+        // Querying `document.visibilityState` or `document.hidden` directly is a point-in-time check
+        // and is HIGHLY INACCURATE / POTENTIALLY UNRELIABLE for async or deferred scripts:
+        // 1. If the page initially loaded in a background tab, but the user switched to the tab
+        //    before this script executed, `document.visibilityState` will report 'visible' (false negative).
+        // 2. If the page transitioned to hidden before this script ran, the exact historical timestamp
+        //    of when it was backgrounded is lost, so `performance.now()` or `0` is only an approximation.
+        isFallbackDetection = true;
+        wasBackgrounded = document.visibilityState === 'hidden' || Boolean(document.hidden);
+        backgroundTime = wasBackgrounded ? 0 : null;
+
+        console.warn(
+          '[Visibility Detection] Legacy fallback (document.visibilityState) is active. ' +
+          'This detection is potentially unreliable for async scripts because prior visibility ' +
+          'transitions and their exact timestamps before script execution cannot be observed.'
+        );
+
+        const fallbackDetectionInfo = {
+          wasBackgrounded,
+          loadedInBackground: wasBackgrounded,
+          backgroundStatus: wasBackgrounded,
+          backgroundTime,
+          fallbackActive: isFallbackDetection,
+          unreliableForAsyncScripts: true,
+          detectionMethod: 'legacy-document-visibilityState-fallback'
+        };
+
+        console.log(fallbackDetectionInfo);
+
+        if (!wasBackgrounded) {
+          document.addEventListener(
+            'visibilitychange',
+            (event) => {
+              if (document.visibilityState === 'hidden' || document.hidden) {
+                console.log({
+                  wasBackgrounded: true,
+                  loadedInBackground: false,
+                  backgroundStatus: true,
+                  backgroundTime: event.timeStamp,
+                  fallbackActive: true,
+                  unreliableForAsyncScripts: true,
+                  detectionMethod: 'legacy-visibilitychange-fallback'
+                });
+              }
+            },
+            { once: true, capture: true }
+          );
+        }
+      }
+    })();
+  </script>
+
