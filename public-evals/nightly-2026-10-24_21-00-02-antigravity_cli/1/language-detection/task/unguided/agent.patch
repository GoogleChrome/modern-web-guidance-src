+  <script>
+    const detectBtn = document.getElementById('detect-btn');
+    const feedbackTextarea = document.getElementById('feedback-message');
+    const detectionResult = document.getElementById('detection-result');
+
+    let cachedDetector = null;
+
+    function showStatus(message) {
+      detectionResult.textContent = message;
+      detectionResult.classList.add('visible');
+    }
+
+    function getLanguageName(code) {
+      if (!code) return 'Unknown';
+      try {
+        const displayNames = new Intl.DisplayNames(['en'], { type: 'language' });
+        return displayNames.of(code) || code;
+      } catch {
+        return code;
+      }
+    }
+
+    detectBtn.addEventListener('click', async () => {
+      const text = feedbackTextarea.value.trim();
+      if (!text) {
+        showStatus('Please enter a feedback message first.');
+        return;
+      }
+
+      if (!('LanguageDetector' in self)) {
+        showStatus('Built-in language detection is not supported in this browser.');
+        return;
+      }
+
+      detectBtn.disabled = true;
+
+      try {
+        const availability = await LanguageDetector.availability();
+
+        if (availability === 'unavailable') {
+          showStatus('Language detection is unavailable on this device.');
+          return;
+        }
+
+        if (!cachedDetector) {
+          if (availability !== 'available') {
+            showStatus('Downloading language detection model: 0%');
+          } else {
+            showStatus('Initializing language detector...');
+          }
+
+          cachedDetector = await LanguageDetector.create({
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = Math.round((e.loaded || 0) * 100);
+                showStatus(`Downloading language detection model: ${percent}%`);
+              });
+            }
+          });
+        }
+
+        const results = await cachedDetector.detect(text);
+
+        if (!results || results.length === 0) {
+          showStatus('Could not detect the language.');
+          return;
+        }
+
+        const topResult = results[0];
+        const languageName = getLanguageName(topResult.detectedLanguage);
+        const confidencePercent = (topResult.confidence * 100).toFixed(1);
+
+        showStatus(`Detected Language: ${languageName} (${topResult.detectedLanguage}) — Confidence: ${confidencePercent}%`);
+      } catch (error) {
+        showStatus(`Error detecting language: ${error.message || error}`);
+      } finally {
+        detectBtn.disabled = false;
+      }
+    });
+  </script>
+
