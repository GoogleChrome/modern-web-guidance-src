+  <script>
+    (async function initLanguageDetection() {
+      const textarea = document.getElementById('feedback-message');
+      const detectBtn = document.getElementById('detect-btn');
+      const progressContainer = document.getElementById('download-progress-container');
+      const progressBar = document.getElementById('download-progress-bar');
+      const progressText = document.getElementById('download-progress-text');
+      const resultEl = document.getElementById('detection-result');
+
+      const languageNames = new Intl.DisplayNames(['en'], { type: 'language' });
+      let detectorInstance = null;
+
+      function showStatus(message) {
+        resultEl.textContent = message;
+        resultEl.hidden = false;
+      }
+
+      function disableFeature(message) {
+        detectBtn.disabled = true;
+        textarea.disabled = true;
+        showStatus(message);
+      }
+
+      if (!('LanguageDetector' in self)) {
+        disableFeature('Built-in language detection is not supported in this browser.');
+        return;
+      }
+
+      let availability;
+      try {
+        availability = await LanguageDetector.availability();
+      } catch (err) {
+        disableFeature('Unable to check language detection availability.');
+        return;
+      }
+
+      if (availability === 'unavailable') {
+        disableFeature('The built-in language detection model is unavailable on this device.');
+        return;
+      }
+
+      detectBtn.addEventListener('click', async () => {
+        const text = textarea.value.trim();
+        if (!text) {
+          showStatus('Please enter a message before detecting the language.');
+          return;
+        }
+
+        detectBtn.disabled = true;
+
+        try {
+          const currentAvailability = await LanguageDetector.availability();
+          if (currentAvailability === 'unavailable') {
+            disableFeature('The built-in language detection model is unavailable on this device.');
+            return;
+          }
+
+          if (!detectorInstance) {
+            if (currentAvailability === 'downloadable' || currentAvailability === 'downloading') {
+              progressContainer.hidden = false;
+              progressBar.value = 0;
+              progressText.textContent = '0%';
+              showStatus('Downloading language detection model...');
+            } else {
+              showStatus('Initializing language detector...');
+            }
+
+            detectorInstance = await LanguageDetector.create({
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  const percentage = Math.round(e.loaded * 100);
+                  progressContainer.hidden = false;
+                  progressBar.value = percentage;
+                  progressText.textContent = `${percentage}%`;
+                  showStatus(`Downloading model: ${percentage}%`);
+                  console.log(`Downloaded ${e.loaded * 100}%`);
+                });
+              },
+            });
+
+            progressContainer.hidden = true;
+          }
+
+          const results = await detectorInstance.detect(text);
+          if (!results || results.length === 0) {
+            showStatus('Could not detect a language for the provided message.');
+            return;
+          }
+
+          const topResult = results[0];
+          let readableLanguage = topResult.detectedLanguage;
+          try {
+            readableLanguage = languageNames.of(topResult.detectedLanguage) || topResult.detectedLanguage;
+          } catch {
+            // Fallback to raw language tag if Intl.DisplayNames cannot format it
+          }
+
+          const confidencePercent = (topResult.confidence * 100).toFixed(1);
+          showStatus(`Detected Language: ${readableLanguage} (${confidencePercent}% confidence)`);
+        } catch (error) {
+          progressContainer.hidden = true;
+          showStatus(`Language detection failed: ${error.message || 'Unknown error'}`);
+        } finally {
+          if ( !textarea.disabled ) {
+            detectBtn.disabled = false;
+          }
+        }
+      });
+    })();
+  </script>
