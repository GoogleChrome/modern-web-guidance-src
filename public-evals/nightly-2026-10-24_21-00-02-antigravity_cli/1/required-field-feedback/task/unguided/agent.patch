+  <script>
+    (function () {
+      const form = document.getElementById('mailing-list-form');
+      const emailInput = document.getElementById('mailing-email');
+      const errorMsg = document.getElementById('mailing-email-error');
+      const successMsg = document.getElementById('mailing-list-success');
+
+      let interacted = false;
+
+      function setErrorState(message) {
+        emailInput.classList.add('input-error');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorMsg.textContent = message;
+        errorMsg.classList.add('visible');
+      }
+
+      function clearErrorState() {
+        emailInput.classList.remove('input-error');
+        emailInput.setAttribute('aria-invalid', 'false');
+        errorMsg.classList.remove('visible');
+      }
+
+      function validateField() {
+        const value = emailInput.value.trim();
+        if (value === '') {
+          setErrorState('Please enter your email address.');
+          return false;
+        }
+        if (!emailInput.validity.valid) {
+          setErrorState('Please enter a valid email address.');
+          return false;
+        }
+        clearErrorState();
+        return true;
+      }
+
+      emailInput.addEventListener('blur', function () {
+        interacted = true;
+        validateField();
+      });
+
+      emailInput.addEventListener('input', function () {
+        successMsg.classList.remove('visible');
+        if (interacted) {
+          if (emailInput.value.trim() === '') {
+            setErrorState('Please enter your email address.');
+          } else if (emailInput.validity.valid) {
+            clearErrorState();
+          }
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        interacted = true;
+        if (validateField()) {
+          clearErrorState();
+          emailInput.value = '';
+          interacted = false;
+          successMsg.classList.add('visible');
+        }
+      });
+    })();
+  </script>
+
 </body>
 
