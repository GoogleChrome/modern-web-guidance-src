+  <script>
+    const mailingForm = document.getElementById('mailing-list-form');
+    const emailInput = document.getElementById('mailing-email');
+    const errorMsg = document.getElementById('email-error');
+    const subscribeBtn = document.getElementById('subscribe-btn');
+    const successMsg = document.getElementById('subscribe-success');
+
+    // Track whether the user has actively focused or edited the field
+    let hasInteracted = false;
+
+    const updateErrorText = (input) => {
+      if (input.validity.valueMissing) {
+        errorMsg.innerHTML = '<span aria-hidden="true">❌</span> Email address is required.';
+      } else if (input.validity.typeMismatch) {
+        errorMsg.innerHTML = '<span aria-hidden="true">❌</span> Please enter a valid email address.';
+      }
+    };
+
+    const syncAriaState = (input) => {
+      const isUserInvalid = input.matches(':user-invalid');
+      if (isUserInvalid) {
+        updateErrorText(input);
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+
+    emailInput.addEventListener('focus', () => {
+      hasInteracted = true;
+    });
+
+    emailInput.addEventListener('blur', (event) => {
+      const input = event.target;
+      // If the user focused the required field and left it blank without typing,
+      // ensure the visual and ARIA state reflect the interaction.
+      if (hasInteracted && !input.checkValidity()) {
+        updateErrorText(input);
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        syncAriaState(input);
+      }
+    });
+
+    emailInput.addEventListener('input', (event) => {
+      const input = event.target;
+      hasInteracted = true;
+      if (input.checkValidity()) {
+        input.removeAttribute('aria-invalid');
+      } else if (input.hasAttribute('aria-invalid') || input.matches(':user-invalid')) {
+        updateErrorText(input);
+      }
+    });
+
+    mailingForm.addEventListener('invalid', (event) => {
+      const input = event.target;
+      if (input === emailInput) {
+        updateErrorText(input);
+        input.setAttribute('aria-invalid', 'true');
+      }
+    }, true);
+
+    mailingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!mailingForm.checkValidity()) {
+        syncAriaState(emailInput);
+        return;
+      }
+      subscribeBtn.disabled = true;
+      successMsg.style.display = 'block';
+    });
+  </script>
+
 </body>
 
