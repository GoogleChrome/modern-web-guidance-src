+        screenDetail.style.transform = `translate3d(${detailTranslatePct}%, 0, 0)`;
+        screenHome.style.transform = `translate3d(${homeTranslatePct}%, 0, 0) scale(${homeScale})`;
+        screenHome.style.opacity = String(homeOpacity);
+      }
+
+      function endSwipe() {
+        if (!swipeState.active) return;
+        const wasTracking = swipeState.tracking;
+        const ratio = swipeState.deltaX / swipeState.width;
+
+        swipeState.active = false;
+        swipeState.tracking = false;
+        viewport.classList.remove('is-swiping');
+
+        // Clear inline drag transforms so CSS transition takes over cleanly
+        screenDetail.style.transform = '';
+        screenHome.style.transform = '';
+        screenHome.style.opacity = '';
+
+        if (wasTracking && (ratio > 0.22 || swipeState.deltaX > 110)) {
+          navigateBackToHome();
+        }
+      }
+
+      // Touch events for mobile/tablet
+      viewport.addEventListener('touchstart', function (e) {
+        if (e.touches.length !== 1) return;
+        startSwipe(e.touches[0].clientX, e.touches[0].clientY);
+      }, { passive: true });
+
+      viewport.addEventListener('touchmove', function (e) {
+        if (e.touches.length !== 1) return;
+        moveSwipe(e.touches[0].clientX, e.touches[0].clientY, e);
+      }, { passive: false });
+
+      viewport.addEventListener('touchend', endSwipe);
+      viewport.addEventListener('touchcancel', endSwipe);
+
+      // Mouse/Pointer drag support for desktop swipe-back
+      viewport.addEventListener('pointerdown', function (e) {
+        if (e.pointerType === 'touch' || e.button !== 0) return;
+        if (e.target.closest('button, a, select, input, textarea')) return;
+        startSwipe(e.clientX, e.clientY);
+      });
+
+      window.addEventListener('pointermove', function (e) {
+        if (e.pointerType === 'touch' || !swipeState.active) return;
+        moveSwipe(e.clientX, e.clientY, e);
+      });
+
+      window.addEventListener('pointerup', function (e) {
+        if (e.pointerType === 'touch') return;
+        endSwipe();
+      });
+
+      // Initial Deep-Link Bootstrapping on Page Load
+      const initialSlug = resolveSlugFromLocation(window.location);
+      if (initialSlug && ITEMS[initialSlug]) {
+        history.replaceState({ view: 'detail', item: initialSlug }, '', buildDeepLinkUrl(initialSlug));
+        applyNavigationState(initialSlug);
+      } else {
+        history.replaceState({ view: 'home', item: null }, '', window.location.pathname + window.location.search + window.location.hash);
+        applyNavigationState(null);
+      }
+    })();
+  </script>
+
 </body>
 
