+              favorited: this.favorited,
+            },
+          }));
+        });
+      }
+
+      get open() {
+        return this.hasAttribute('open');
+      }
+      set open(val) {
+        this.toggleAttribute('open', !!val);
+      }
+
+      get favorited() {
+        return this.hasAttribute('favorited');
+      }
+      set favorited(val) {
+        this.toggleAttribute('favorited', !!val);
+      }
+
+      attributeChangedCallback(name, oldVal, newVal) {
+        if (oldVal === newVal || !this.shadowRoot) return;
+        this.#syncAttributeToDOM(name, newVal);
+      }
+
+      #syncAttributeToDOM(name, value) {
+        switch (name) {
+          case 'open': {
+            const isOpen = value !== null;
+            const toggleBtn = this.shadowRoot.getElementById('toggle');
+            if (toggleBtn) {
+              toggleBtn.setAttribute('aria-expanded', String(isOpen));
+              toggleBtn.textContent = isOpen ? 'Hide Notes' : 'Tasting Notes';
+            }
+            break;
+          }
+          case 'favorited': {
+            const isFav = value !== null;
+            const favBtn = this.shadowRoot.getElementById('favorite-btn');
+            const favLabel = this.shadowRoot.getElementById('fav-label');
+            const star = favBtn?.querySelector('[aria-hidden="true"]');
+            if (favBtn) favBtn.setAttribute('aria-pressed', String(isFav));
+            if (favLabel) favLabel.textContent = isFav ? 'Saved' : 'Save';
+            if (star) star.textContent = isFav ? '★' : '☆';
+            break;
+          }
+          case 'price': {
+            const el = this.shadowRoot.getElementById('price-display');
+            if (el && el.textContent !== (value ?? '')) el.textContent = value ?? '';
+            break;
+          }
+          case 'roast': {
+            const el = this.shadowRoot.getElementById('roast-badge');
+            if (el && el.textContent !== (value ?? '')) el.textContent = value ?? '';
+            break;
+          }
+          case 'origin': {
+            const el = this.shadowRoot.getElementById('origin-val');
+            if (el && el.textContent !== (value ?? '')) el.textContent = value ?? '';
+            break;
+          }
+          case 'notes': {
+            const el = this.shadowRoot.getElementById('notes-val');
+            if (el && el.textContent !== (value ?? '')) el.textContent = value ?? '';
+            break;
+          }
+          case 'caffeine': {
+            const el = this.shadowRoot.getElementById('caffeine-val');
+            if (el && el.textContent !== (value ?? '')) el.textContent = value ?? '';
+            break;
+          }
+        }
+      }
+    }
+
+    customElements.define('coffee-card', CoffeeCard);
+  </script>
+
