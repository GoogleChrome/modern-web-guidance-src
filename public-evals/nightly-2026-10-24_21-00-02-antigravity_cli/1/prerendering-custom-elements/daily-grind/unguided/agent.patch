+class CoffeeCard extends HTMLElement {
+  static observedAttributes = ['name', 'price', 'href', 'count'];
+
+  constructor() {
+    super();
+    this._count = Number(this.getAttribute('count') || 0);
+    this._onAddClick = this._onAddClick.bind(this);
+  }
+
+  connectedCallback() {
+    // If no Declarative Shadow DOM was server-rendered, create and render one as fallback.
+    if (!this.shadowRoot) {
+      const shadow = this.attachShadow({ mode: 'open' });
+      shadow.innerHTML = this._renderTemplate();
+    }
+
+    // Hydrate in place: bind references and event listeners to existing shadow DOM nodes
+    // without re-creating or overwriting innerHTML.
+    this._titleEl = this.shadowRoot.querySelector('[data-title]');
+    this._priceEl = this.shadowRoot.querySelector('[data-price]');
+    this._linkEl = this.shadowRoot.querySelector('[data-link]');
+    this._addBtn = this.shadowRoot.querySelector('[data-add-btn]');
+    this._countEl = this.shadowRoot.querySelector('[data-count]');
+
+    if (this._addBtn) {
+      this._addBtn.addEventListener('click', this._onAddClick);
+    }
+
+    this.setAttribute('hydrated', '');
+  }
+
+  disconnectedCallback() {
+    if (this._addBtn) {
+      this._addBtn.removeEventListener('click', this._onAddClick);
+    }
+  }
+
+  attributeChangedCallback(name, oldValue, newValue) {
+    if (oldValue === newValue || !this.shadowRoot) return;
+
+    if (name === 'name' && this._titleEl) {
+      this._titleEl.textContent = newValue ?? '';
+    } else if (name === 'price' && this._priceEl) {
+      this._priceEl.textContent = newValue ?? '';
+    } else if (name === 'href' && this._linkEl) {
+      this._linkEl.setAttribute('href', newValue ?? '#');
+    } else if (name === 'count') {
+      this._count = Number(newValue || 0);
+      if (this._countEl) {
+        this._countEl.textContent = String(this._count);
+      }
+    }
+  }
+
+  _onAddClick() {
+    this._count += 1;
+    if (this._countEl) {
+      this._countEl.textContent = String(this._count);
+    }
+    this.setAttribute('count', String(this._count));
+    this.dispatchEvent(
+      new CustomEvent('coffee-add', {
+        detail: {
+          name: this.getAttribute('name'),
+          price: this.getAttribute('price'),
+          count: this._count,
+        },
+        bubbles: true,
+        composed: true,
+      })
+    );
+  }
+
+  _renderTemplate() {
+    const name = this.getAttribute('name') || '';
+    const price = this.getAttribute('price') || '';
+    const href = this.getAttribute('href') || '#';
+    return `
+      <style>
+        :host {
+          display: block;
+        }
+        .card {
+          background: white;
+          padding: 20px;
+          border-radius: 8px;
+          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+          text-align: center;
+          height: 100%;
+          display: flex;
+          flex-direction: column;
+          justify-content: space-between;
+        }
+        h3 {
+          margin: 0 0 10px;
+          color: var(--primary, #4e342e);
+        }
+        p {
+          margin: 0 0 15px;
+        }
+        .price {
+          font-weight: bold;
+          color: var(--primary, #4e342e);
+          margin-bottom: 10px;
+        }
+        .actions {
+          display: flex;
+          gap: 10px;
+          justify-content: center;
+          align-items: center;
+          margin-top: 15px;
+        }
+        .btn {
+          display: inline-block;
+          background: var(--primary, #4e342e);
+          color: white;
+          padding: 10px 16px;
+          text-decoration: none;
+          border-radius: 5px;
+          border: none;
+          font: inherit;
+          cursor: pointer;
+          transition: background 0.3s;
+        }
+        .btn:hover {
+          background: #3e2723;
+        }
+        .btn-secondary {
+          background: var(--secondary, #d7ccc8);
+          color: var(--text, #3e2723);
+        }
+        .btn-secondary:hover {
+          background: #bcaaa4;
+        }
+      </style>
+      <div class="card">
+        <div>
+          <h3 data-title>${name}</h3>
+          <p><slot></slot></p>
+          <div class="price" data-price>${price}</div>
+        </div>
+        <div class="actions">
+          <a href="${href}" class="btn" data-link>View Details</a>
+          <button type="button" class="btn btn-secondary" data-add-btn>
+            Add (<span data-count>${this._count}</span>)
+          </button>
+        </div>
+      </div>
+    `;
+  }
+}
+
+if (!customElements.get('coffee-card')) {
+  customElements.define('coffee-card', CoffeeCard);
+}
+
+export { CoffeeCard };
