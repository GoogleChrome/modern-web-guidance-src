+  <script>
+    const promoAlert = document.getElementById('promo-alert');
+    const alertDismiss = document.getElementById('alert-dismiss');
+    const faqTrigger = document.getElementById('faq-trigger');
+    const faqContent = document.getElementById('faq-content');
+
+    // Dismiss promo alert and hide from assistive technology tree after collapse transition
+    alertDismiss?.addEventListener('click', () => {
+      promoAlert.classList.add('is-dismissed');
+      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !CSS.supports('interpolate-size', 'allow-keywords')) {
+        promoAlert.hidden = true;
+      }
+    });
+
+    promoAlert?.addEventListener('transitionend', (e) => {
+      if (e.propertyName === 'block-size' && promoAlert.classList.contains('is-dismissed')) {
+        promoAlert.hidden = true;
+      }
+    });
+
+    // Toggle FAQ accordion state & aria-expanded while letting CSS interpolate block-size to auto
+    const setFaqExpanded = (expanded) => {
+      faqTrigger.setAttribute('aria-expanded', String(expanded));
+      faqContent.classList.toggle('is-expanded', expanded);
+      if (expanded) {
+        faqContent.removeAttribute('hidden');
+      }
+    };
+
+    faqTrigger?.addEventListener('click', () => {
+      const isExpanded = faqTrigger.getAttribute('aria-expanded') === 'true';
+      setFaqExpanded(!isExpanded);
+    });
+
+    faqContent?.addEventListener('transitionend', (e) => {
+      if (e.propertyName === 'block-size' && faqTrigger.getAttribute('aria-expanded') === 'false') {
+        if ('onbeforematch' in HTMLElement.prototype) {
+          faqContent.setAttribute('hidden', 'until-found');
+        } else {
+          faqContent.hidden = true;
+        }
+      }
+    });
+
+    // Synchronize UI state when revealed via native Find-in-page search
+    faqContent?.addEventListener('beforematch', () => {
+      setFaqExpanded(true);
+    });
+
+    // Feature-detect hidden="until-found" fallback for unsupported browsers
+    if (!('onbeforematch' in HTMLElement.prototype)) {
+      document.querySelectorAll('[hidden="until-found"]').forEach((el) => {
+        el.removeAttribute('hidden');
+        if (el.id === 'faq-content') {
+          setFaqExpanded(true);
+        }
+      });
+    }
+  </script>
+
 </body>
 
