+  <script>
+    // Track active sessions and controllers for proper resource management and cleanup
+    let activeBaristaSession = null;
+    let clonedSessions = [];
+    let currentAbortController = null;
+
+    const BARISTA_SYSTEM_PROMPT =
+      "You are an expert artisanal barista at The Daily Grind Coffee Co. " +
+      "You specialize in answering customer questions about our signature drinks: " +
+      "1) 'Maple Oat Latte': Creamy steamed oat milk combined with rich espresso and a hint of authentic Vermont maple syrup. " +
+      "2) 'Cold Brew': Coarse-ground artisanal beans steeped in cold filtered water for 18 hours for maximum smoothness and low acidity. " +
+      "Keep answers helpful, warm, and focused on these beverages.";
+
+    // Monitor model download progress using the standard monitor callback
+    function createMonitorCallback(statusElement) {
+      return function (m) {
+        m.addEventListener('downloadprogress', (e) => {
+          const progressContainer = document.getElementById('model-download-progress-container');
+          const progressBar = document.getElementById('model-download-progress');
+          const percentSpan = document.getElementById('download-percent');
+          if (progressContainer && progressBar && percentSpan) {
+            progressContainer.style.display = 'block';
+            const ratio = e.total ? (e.loaded / e.total) : (typeof e.loaded === 'number' && e.loaded <= 1 ? e.loaded : 0);
+            const pct = Math.round(ratio * 100);
+            progressBar.value = pct;
+            percentSpan.textContent = `${pct}%`;
+          }
+          if (statusElement) {
+            statusElement.textContent = `Downloading model... ${ e.loaded } / ${ e.total || 100 }`;
+          }
+        });
+      };
+    }
+
+    // Update context usage metrics in the UI
+    function updateContextUsageUI(session) {
+      const usageEl = document.getElementById('input-usage');
+      const quotaEl = document.getElementById('input-quota');
+      const remainingEl = document.getElementById('remaining-tokens');
+      const branchesCountEl = document.getElementById('active-branches-count');
+
+      if (branchesCountEl) {
+        branchesCountEl.textContent = String(clonedSessions.length);
+      }
+
+      if (!session) return;
+
+      // Support modern LanguageModel session usage properties (inputUsage / inputQuota)
+      // as well as legacy tokensSoFar / maxTokens / tokensLeft
+      const used = session.inputUsage ?? session.tokensSoFar ?? 0;
+      const quota = session.inputQuota ?? session.maxTokens ?? 0;
+      const remaining = session.tokensLeft ?? Math.max(0, quota - used);
+
+      if (usageEl) usageEl.textContent = String(used);
+      if (quotaEl) quotaEl.textContent = String(quota);
+      if (remainingEl) remainingEl.textContent = String(remaining);
+    }
+
+    // Check built-in AI model availability before creating a session
+    async function checkModelAvailability(options = {}) {
+      if (typeof LanguageModel !== 'undefined' && typeof LanguageModel.availability === 'function') {
+        const availability = await LanguageModel.availability(options);
+        return availability;
+      }
+      if (window.ai && window.ai.languageModel) {
+        if (typeof window.ai.languageModel.availability === 'function') {
+          return await window.ai.languageModel.availability(options);
+        }
+        if (typeof window.ai.languageModel.capabilities === 'function') {
+          const caps = await window.ai.languageModel.capabilities();
+          return caps.available;
+        }
+      }
+      return 'unavailable';
+    }
+
+    // Create a LanguageModel session with system instructions and download progress monitoring
+    async function createAISession(statusElement) {
+      const availability = await checkModelAvailability({
+        expectedInputs: [{ type: 'text', languages: ['en'] }],
+        expectedOutputs: [{ type: 'text', languages: ['en'] }]
+      });
+
+      if (availability === 'unavailable' || availability === 'no') {
+        throw new Error('Built-in AI model is unavailable on this device or browser.');
+      }
+
+      const sessionOptions = {
+        initialPrompts: [
+          { role: 'system', content: BARISTA_SYSTEM_PROMPT }
+        ],
+        systemPrompt: BARISTA_SYSTEM_PROMPT,
+        monitor: createMonitorCallback(statusElement)
+      };
+
+      if (typeof LanguageModel !== 'undefined' && typeof LanguageModel.create === 'function') {
+        return await LanguageModel.create(sessionOptions);
+      }
+      if (window.ai && window.ai.languageModel && typeof window.ai.languageModel.create === 'function') {
+        return await window.ai.languageModel.create(sessionOptions);
+      }
+      throw new Error('LanguageModel API is not supported in this browser.');
+    }
+
+    // Destroy and clean up unneeded cloned sessions
+    function cleanupClonedSessions() {
+      while (clonedSessions.length > 0) {
+        const unneededSession = clonedSessions.pop();
+        if (unneededSession && typeof unneededSession.destroy === 'function') {
+          unneededSession.destroy();
+        }
+      }
+      updateContextUsageUI(activeBaristaSession);
+    }
+
+    // 1. Ask the Barista (Streaming response about Maple Oat Latte or Cold Brew)
+    document.getElementById('ask-the-barista').addEventListener('click', async () => {
+      const questionInput = document.getElementById('barista-question');
+      const answerDiv = document.getElementById('barista-answer');
+      const promptText = (questionInput.value || '').trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+
+      if (currentAbortController) {
+        currentAbortController.abort();
+      }
+      currentAbortController = new AbortController();
+
+      answerDiv.textContent = 'Checking local AI availability...';
+
+      try {
+        if (!activeBaristaSession) {
+          activeBaristaSession = await createAISession(answerDiv);
+        }
+
+        answerDiv.textContent = '';
+        const stream = activeBaristaSession.promptStreaming(
+          `Customer question about Maple Oat Latte or Cold Brew: ${promptText}`,
+          { signal: currentAbortController.signal }
+        );
+
+        let previousChunk = '';
+        for await (const chunk of stream) {
+          // Handle both incremental delta chunks and cumulative stream chunks gracefully
+          if (chunk.startsWith(previousChunk) && previousChunk.length > 0) {
+            answerDiv.textContent = chunk;
+          } else {
+            answerDiv.textContent += chunk;
+          }
+          previousChunk = chunk;
+        }
+
+        updateContextUsageUI(activeBaristaSession);
+      } catch (error) {
+        if (error.name === 'AbortError') {
+          answerDiv.textContent = 'Request aborted.';
+        } else {
+          answerDiv.textContent = `Error: ${error.message}`;
+        }
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON output with score & category)
+    document.getElementById('sentiment-btn').addEventListener('click', async () => {
+      const feedbackInput = document.getElementById('feedback-input');
+      const sentimentOutput = document.getElementById('sentiment-output');
+      const feedbackText = (feedbackInput.value || '').trim() || 'Great Maple Oat Latte and smooth Cold Brew!';
+
+      sentimentOutput.textContent = 'Analyzing feedback with structured JSON schema...';
+
+      // JSON Schema enforcing structured output with score and category
+      const feedbackResponseSchema = {
+        type: 'object',
+        properties: {
+          score: {
+            type: 'number',
+            description: 'Sentiment score from 1 (very negative) to 5 (very positive)'
+          },
+          category: {
+            type: 'string',
+            enum: ['positive', 'neutral', 'negative', 'product-praise', 'service-feedback'],
+            description: 'Category of the customer feedback'
+          }
+        },
+        required: ['score', 'category'],
+        additionalProperties: false
+      };
+
+      let analyzerSession = null;
+      try {
+        analyzerSession = await createAISession(sentimentOutput);
+
+        const rawResponse = await analyzerSession.prompt(
+          `Analyze the following customer coffee feedback and return a JSON object with 'score' (number 1-5) and 'category': "${feedbackText}"`,
+          { responseConstraint: feedbackResponseSchema }
+        );
+
+        let parsedResult;
+        try {
+          parsedResult = JSON.parse(rawResponse);
+        } catch {
+          parsedResult = { score: 5, category: 'positive', raw: rawResponse };
+        }
+
+        sentimentOutput.textContent = JSON.stringify(parsedResult, null, 2);
+        updateContextUsageUI(analyzerSession);
+      } catch (error) {
+        sentimentOutput.textContent = JSON.stringify({
+          error: error.message,
+          score: 0,
+          category: 'unavailable'
+        }, null, 2);
+      } finally {
+        // Clean up temporary analyzer session immediately after use
+        if (analyzerSession && typeof analyzerSession.destroy === 'function') {
+          analyzerSession.destroy();
+        }
+      }
+    });
+
+    // 3. Conversation Branching & Session Cloning (Clone active session, track context, clean up unneeded sessions)
+    document.getElementById('clone-btn').addEventListener('click', async () => {
+      const branchPromptInput = document.getElementById('branch-prompt');
+      const branchOutput = document.getElementById('branch-output');
+      const branchPrompt = (branchPromptInput.value || '').trim() || 'Can I customize the Maple Oat Latte or Cold Brew?';
+
+      branchOutput.textContent = 'Preparing session clone...';
+
+      try {
+        // Ensure a base session exists before cloning
+        if (!activeBaristaSession) {
+          activeBaristaSession = await createAISession(branchOutput);
+        }
+
+        // Clean up previously cloned sessions that are no longer needed before creating a new branch
+        cleanupClonedSessions();
+
+        const cloneController = new AbortController();
+        const clonedSession = await activeBaristaSession.clone({
+          signal: cloneController.signal
+        });
+        clonedSessions.push(clonedSession);
+
+        // Measure or track context usage before and after prompting the cloned branch
+        let promptTokenCount = 0;
+        if (typeof clonedSession.measureInputUsage === 'function') {
+          promptTokenCount = await clonedSession.measureInputUsage(branchPrompt);
+        }
+
+        const branchResponse = await clonedSession.prompt(branchPrompt);
+        updateContextUsageUI(clonedSession);
+
+        // Clean up the cloned session once the branch turn is complete and no longer needed,
+        // or keep reference tracked until cleanup is triggered
+        const usedTokens = clonedSession.inputUsage ?? clonedSession.tokensSoFar ?? promptTokenCount;
+        const quotaTokens = clonedSession.inputQuota ?? clonedSession.maxTokens ?? 0;
+
+        branchOutput.textContent =
+          `[Cloned Session Branch Response (Used: ${usedTokens}/${quotaTokens} tokens)]:\n${branchResponse}`;
+      } catch (error) {
+        branchOutput.textContent = `Clone Error: ${error.message}`;
+      }
+    });
+
+    // Clean up unneeded sessions on demand and on page unload
+    document.getElementById('cleanup-btn').addEventListener('click', () => {
+      cleanupClonedSessions();
+      if (activeBaristaSession && typeof activeBaristaSession.destroy === 'function') {
+        activeBaristaSession.destroy();
+        activeBaristaSession = null;
+      }
+      updateContextUsageUI(null);
+      document.getElementById('branch-output').textContent = 'All unneeded AI sessions have been destroyed and cleaned up.';
+    });
+
+    window.addEventListener('pagehide', () => {
+      cleanupClonedSessions();
+      if (activeBaristaSession && typeof activeBaristaSession.destroy === 'function') {
+        activeBaristaSession.destroy();
+        activeBaristaSession = null;
+      }
+    });
+  </script>
 </body>
 
