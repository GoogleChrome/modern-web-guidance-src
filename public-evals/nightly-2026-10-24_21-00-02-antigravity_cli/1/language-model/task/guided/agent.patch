+  <script>
+    const BARISTA_SYSTEM_PROMPT =
+      'You are a knowledgeable barista at The Daily Grind coffee shop. Answer customer questions specifically about the Maple Oat Latte (creamy oat milk with a hint of Vermont maple syrup) and the Cold Brew (steeped for 18 hours for maximum smoothness). Keep answers friendly, helpful, and concise.';
+
+    let baseSession = null;
+    let activeSession = null;
+    let activeAbortController = null;
+    const clonedSessions = [];
+
+    const questionInput = document.getElementById('barista-question');
+    const askBtn = document.getElementById('ask-the-barista');
+    const stopBtn = document.getElementById('stop-barista-btn');
+    const progressEl = document.getElementById('download-progress');
+    const baristaAnswerEl = document.getElementById('barista-answer');
+
+    const feedbackInput = document.getElementById('feedback-input');
+    const sentimentBtn = document.getElementById('sentiment-btn');
+    const sentimentOutputEl = document.getElementById('sentiment-output');
+
+    const cloneBtn = document.getElementById('clone-btn');
+    const cleanupBtn = document.getElementById('cleanup-btn');
+    const contextUsageEl = document.getElementById('context-usage');
+    const branchOutputEl = document.getElementById('branch-output');
+
+    function updateContextMetrics(session) {
+      if (!session) {
+        contextUsageEl.textContent = 'Context Usage: 0 / 0 tokens';
+        return;
+      }
+      const usage = session.contextUsage ?? 0;
+      const maxWindow = session.contextWindow ?? 0;
+      contextUsageEl.textContent = `Context Usage: ${usage} / ${maxWindow} tokens`;
+    }
+
+    async function ensureModelAvailable() {
+      if (!('LanguageModel' in self)) {
+        return { supported: false, availability: 'unavailable' };
+      }
+      const availability = await LanguageModel.availability();
+      return {
+        supported: availability !== 'unavailable',
+        availability,
+      };
+    }
+
+    async function createSessionWithMonitor(initialPrompts) {
+      const { supported, availability } = await ensureModelAvailable();
+      if (!supported || availability === 'unavailable') {
+        throw new Error('Built-in AI LanguageModel is unavailable on this device.');
+      }
+
+      const session = await LanguageModel.create({
+        initialPrompts,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const pct = Math.round((e.loaded || 0) * 100);
+            progressEl.textContent = `Downloading AI model: ${pct}%`;
+          });
+        },
+      });
+      progressEl.textContent = '';
+      updateContextMetrics(session);
+      return session;
+    }
+
+    async function getOrInitBaseSession() {
+      if (!baseSession) {
+        baseSession = await createSessionWithMonitor([
+          { role: 'system', content: BARISTA_SYSTEM_PROMPT },
+        ]);
+      }
+      if (!activeSession) {
+        activeSession = await baseSession.clone();
+        updateContextMetrics(activeSession);
+      }
+      return activeSession;
+    }
+
+    // Pre-warm the base session when user interacts with the barista question input
+    questionInput.addEventListener(
+      'focus',
+      () => {
+        if ('LanguageModel' in self && !baseSession) {
+          getOrInitBaseSession().catch(() => {});
+        }
+      },
+      { once: true }
+    );
+
+    // 1. Ask the Barista (Streaming response into #barista-answer)
+    askBtn.addEventListener('click', async () => {
+      const promptText = questionInput.value.trim() || 'Tell me about the Maple Oat Latte and Cold Brew.';
+      baristaAnswerEl.textContent = '';
+
+      const { supported, availability } = await ensureModelAvailable();
+      if (!supported || availability === 'unavailable') {
+        baristaAnswerEl.textContent =
+          'Local AI model is unavailable on this browser/device. Fallback: Our Maple Oat Latte blends creamy oat milk with pure Vermont maple syrup, and our Cold Brew is slow-steeped for 18 hours for ultra-smooth flavor.';
+        return;
+      }
+
+      askBtn.disabled = true;
+      stopBtn.style.display = 'inline-block';
+      activeAbortController = new AbortController();
+
+      try {
+        const session = await getOrInitBaseSession();
+        const stream = session.promptStreaming(promptText, {
+          signal: activeAbortController.signal,
+        });
+
+        let completeResult = '';
+        for await (const chunk of stream) {
+          completeResult += chunk;
+          baristaAnswerEl.append(chunk);
+        }
+        updateContextMetrics(session);
+      } catch (err) {
+        if (err.name === 'AbortError') {
+          baristaAnswerEl.append(' [Generation stopped]');
+        } else {
+          baristaAnswerEl.textContent = `Error: ${err.message}`;
+        }
+      } finally {
+        askBtn.disabled = false;
+        stopBtn.style.display = 'none';
+        activeAbortController = null;
+      }
+    });
+
+    stopBtn.addEventListener('click', () => {
+      if (activeAbortController) {
+        activeAbortController.abort();
+      }
+    });
+
+    // 2. Customer Feedback Analyzer (Structured JSON with score & category)
+    sentimentBtn.addEventListener('click', async () => {
+      const feedbackText = feedbackInput.value.trim() || 'Great Maple Oat Latte and smooth Cold Brew!';
+      sentimentOutputEl.textContent = 'Analyzing feedback...';
+
+      const schema = {
+        type: 'object',
+        properties: {
+          score: { type: 'number', minimum: 1, maximum: 5 },
+          category: {
+            type: 'string',
+            enum: ['Maple Oat Latte', 'Cold Brew', 'Service', 'General'],
+          },
+        },
+        required: ['score', 'category'],
+      };
+
+      const { supported, availability } = await ensureModelAvailable();
+      if (!supported || availability === 'unavailable') {
+        const fallbackData = { score: 5, category: 'Maple Oat Latte' };
+        sentimentOutputEl.textContent = JSON.stringify(fallbackData, null, 2);
+        return;
+      }
+
+      sentimentBtn.disabled = true;
+      let analysisSession = null;
+      try {
+        if (baseSession) {
+          analysisSession = await baseSession.clone();
+        } else {
+          analysisSession = await createSessionWithMonitor([
+            {
+              role: 'system',
+              content: 'You analyze coffee shop customer feedback and return a satisfaction score (1-5) and category.',
+            },
+          ]);
+        }
+
+        const result = await analysisSession.prompt(
+          `Analyze the following customer feedback: "${feedbackText}"`,
+          { responseConstraint: schema }
+        );
+
+        const data = JSON.parse(result);
+        sentimentOutputEl.textContent = JSON.stringify(data, null, 2);
+        updateContextMetrics(analysisSession);
+      } catch (err) {
+        sentimentOutputEl.textContent = `Error analyzing feedback: ${err.message}`;
+      } finally {
+        if (analysisSession) {
+          analysisSession.destroy();
+        }
+        sentimentBtn.disabled = false;
+      }
+    });
+
+    // 3. Conversation Branching & Session Cleanup
+    cloneBtn.addEventListener('click', async () => {
+      const { supported, availability } = await ensureModelAvailable();
+      if (!supported || availability === 'unavailable') {
+        branchOutputEl.textContent = 'Cannot clone session: Built-in AI model is unavailable.';
+        return;
+      }
+
+      cloneBtn.disabled = true;
+      try {
+        const sourceSession = await getOrInitBaseSession();
+
+        // Clean up previous cloned branches before creating new branches to avoid leaking memory
+        while (clonedSessions.length > 0) {
+          const oldClone = clonedSessions.pop();
+          oldClone.destroy();
+        }
+
+        const clonedSession = await sourceSession.clone();
+        clonedSessions.push(clonedSession);
+
+        // Switch active session to the newly cloned branch and destroy the old active session if separate from baseSession
+        if (activeSession && activeSession !== baseSession) {
+          activeSession.destroy();
+        }
+        activeSession = clonedSession;
+
+        updateContextMetrics(activeSession);
+        branchOutputEl.textContent = `Session cloned successfully! Active branch context usage: ${activeSession.contextUsage ?? 0} / ${activeSession.contextWindow ?? 0} tokens.`;
+      } catch (err) {
+        branchOutputEl.textContent = `Error cloning session: ${err.message}`;
+      } finally {
+        cloneBtn.disabled = false;
+      }
+    });
+
+    cleanupBtn.addEventListener('click', () => {
+      let destroyedCount = 0;
+      while (clonedSessions.length > 0) {
+        const s = clonedSessions.pop();
+        s.destroy();
+        destroyedCount++;
+      }
+      if (activeSession) {
+        activeSession.destroy();
+        activeSession = null;
+        destroyedCount++;
+      }
+      if (baseSession) {
+        baseSession.destroy();
+        baseSession = null;
+        destroyedCount++;
+      }
+      updateContextMetrics(null);
+      branchOutputEl.textContent = `Cleaned up ${destroyedCount} unneeded session(s) and freed device memory.`;
+    });
+
+    window.addEventListener('pagehide', () => {
+      while (clonedSessions.length > 0) {
+        clonedSessions.pop().destroy();
+      }
+      if (activeSession) {
+        activeSession.destroy();
+        activeSession = null;
+      }
+      if (baseSession) {
+        baseSession.destroy();
+        baseSession = null;
+      }
+    });
+  </script>
 </body>
 
