+  <script type="module">
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const statusText = document.getElementById('status-text');
+    const metricsText = document.getElementById('metrics-text');
+    const progressFill = document.getElementById('progress-fill');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const sppSelect = document.getElementById('spp-select');
+    const paletteGrid = document.getElementById('palette-grid');
+
+    function renderPaletteSwatches(palette) {
+      paletteGrid.innerHTML = '';
+      for (const item of palette) {
+        if (item.index === 3) continue; // Skip invisible black front wall
+        const el = document.createElement('div');
+        el.className = 'swatch-item';
+        const dot = document.createElement('span');
+        dot.className = 'swatch-color';
+        dot.style.backgroundColor = item.hex;
+        const label = document.createElement('span');
+        label.className = 'swatch-label';
+        label.textContent = `${item.name}`;
+        label.title = `${item.name}: ${item.hex}`;
+        el.appendChild(dot);
+        el.appendChild(label);
+        paletteGrid.appendChild(el);
+      }
+    }
+
+    function getRenderParams() {
+      const [width, height] = resolutionSelect.value.split('x').map(Number);
+      const targetSpp = Number(sppSelect.value);
+      return { width, height, targetSpp };
+    }
+
+    // Use a module Web Worker so WebAssembly path tracing never blocks the main UI thread,
+    // with automatic main-thread fallback if Worker creation fails.
+    let worker = null;
+    try {
+      worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+    } catch (err) {
+      console.warn('Worker initialization failed, using main-thread fallback:', err);
+    }
+
+    if (worker) {
+      worker.onmessage = (e) => {
+        const msg = e.data;
+        if (msg.type === 'PALETTE') {
+          renderPaletteSwatches(msg.palette);
+        } else if (msg.type === 'FRAME') {
+          if (canvas.width !== msg.width || canvas.height !== msg.height) {
+            canvas.width = msg.width;
+            canvas.height = msg.height;
+          }
+          const imgData = new ImageData(msg.pixels, msg.width, msg.height);
+          ctx.putImageData(imgData, 0, 0);
+
+          const pct = Math.min(100, Math.round(msg.progress * 100));
+          progressFill.style.width = `${pct}%`;
+          const secs = (msg.elapsedMs / 1000).toFixed(1);
+          metricsText.textContent = `${msg.currentSpp} / ${msg.targetSpp} SPP • ${secs}s`;
+          statusText.textContent = msg.done
+            ? `Render complete (${msg.width}×${msg.height})`
+            : `Tracing paths in WebAssembly... (${pct}%)`;
+        }
+      };
+    }
+
+    // Main-thread fallback state in case Web Worker is unavailable
+    let fallbackModPromise = null;
+    let fallbackRenderId = 0;
+
+    async function runFallbackRender({ width, height, targetSpp, randomize, reset, seed }) {
+      const renderId = ++fallbackRenderId;
+      if (!fallbackModPromise) {
+        const { default: createSmallptModule } = await import('./smallpt.js');
+        fallbackModPromise = createSmallptModule();
+      }
+      const mod = await fallbackModPromise;
+      if (reset) mod._reset_default_colors();
+      else if (randomize) mod._randomize_sphere_colors(seed >>> 0);
+
+      const names = ['Left Wall', 'Right Wall', 'Back Wall', 'Front Wall', 'Floor', 'Ceiling', 'Mirror Sphere', 'Glass Sphere'];
+      const palette = [];
+      for (let i = 0; i < 8; i++) {
+        const r = Math.round(Math.pow(Math.min(1, Math.max(0, mod._get_sphere_color_r(i))), 1 / 2.2) * 255);
+        const g = Math.round(Math.pow(Math.min(1, Math.max(0, mod._get_sphere_color_g(i))), 1 / 2.2) * 255);
+        const b = Math.round(Math.pow(Math.min(1, Math.max(0, mod._get_sphere_color_b(i))), 1 / 2.2) * 255);
+        palette.push({
+          index: i,
+          name: names[i],
+          hex: `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`
+        });
+      }
+      renderPaletteSwatches(palette);
+
+      if (canvas.width !== width || canvas.height !== height) {
+        canvas.width = width;
+        canvas.height = height;
+      }
+      mod._init_render(width, height);
+      const t0 = performance.now();
+      const sampsPerSubpixel = Math.max(1, Math.floor(targetSpp / 4));
+      const chunkRows = 20;
+      for (let y = 0; y < height; y += chunkRows) {
+        if (renderId !== fallbackRenderId) return;
+        const endY = Math.min(height, y + chunkRows);
+        const ptr = mod._render_rows(y, endY, sampsPerSubpixel, 1);
+        const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, width * height * 4);
+        ctx.putImageData(new ImageData(pixels, width, height), 0, 0);
+        const pct = Math.round((endY / height) * 100);
+        progressFill.style.width = `${pct}%`;
+        const secs = ((performance.now() - t0) / 1000).toFixed(1);
+        metricsText.textContent = `${sampsPerSubpixel * 4} SPP • ${secs}s`;
+        statusText.textContent = endY === height ? `Render complete (${width}×${height})` : `Tracing paths... (${pct}%)`;
+        await new Promise((r) => setTimeout(r, 0));
+      }
+    }
+
+    function triggerRender({ randomize = false, reset = false } = {}) {
+      const { width, height, targetSpp } = getRenderParams();
+      const seed = Math.floor(Math.random() * 0xffffffff);
+      statusText.textContent = 'Starting WebAssembly path tracer...';
+      progressFill.style.width = '2%';
+
+      if (worker) {
+        worker.postMessage({
+          type: 'RENDER',
+          width,
+          height,
+          targetSpp,
+          randomize,
+          reset,
+          seed
+        });
+      } else {
+        runFallbackRender({ width, height, targetSpp, randomize, reset, seed });
+      }
+    }
+
+    randomizeBtn.addEventListener('click', () => triggerRender({ randomize: true }));
+    resetBtn.addEventListener('click', () => triggerRender({ reset: true }));
+    resolutionSelect.addEventListener('change', () => triggerRender());
+    sppSelect.addEventListener('change', () => triggerRender());
 
+    // Initial render on load
+    triggerRender({ reset: true });
+  </script>
