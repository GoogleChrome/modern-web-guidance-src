+}
+
+static uint8_t *pixel_buffer = nullptr;
+static Vec *subpixel_accum = nullptr; // w * h * 4 subpixels
+static int current_w = 0;
+static int current_h = 0;
+static int current_subpixel_samples = 0;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  int n = sizeof(spheres) / sizeof(Sphere);
+  if (index >= 0 && index < n) {
+    spheres[index].c = Vec(r, g, b);
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_r(int index) {
+  int n = sizeof(spheres) / sizeof(Sphere);
+  return (index >= 0 && index < n) ? spheres[index].c.x : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_g(int index) {
+  int n = sizeof(spheres) / sizeof(Sphere);
+  return (index >= 0 && index < n) ? spheres[index].c.y : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_b(int index) {
+  int n = sizeof(spheres) / sizeof(Sphere);
+  return (index >= 0 && index < n) ? spheres[index].c.z : 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_default_colors() {
+  spheres[0].c = Vec(.75, .25, .25);      // Left wall
+  spheres[1].c = Vec(.25, .25, .75);      // Right wall
+  spheres[2].c = Vec(.75, .75, .75);      // Back wall
+  spheres[3].c = Vec(0, 0, 0);            // Front wall
+  spheres[4].c = Vec(.75, .75, .75);      // Bottom wall
+  spheres[5].c = Vec(.75, .75, .75);      // Top wall
+  spheres[6].c = Vec(1, 1, 1) * .999;     // Mirror sphere
+  spheres[7].c = Vec(1, 1, 1) * .999;     // Glass sphere
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(unsigned int seed) {
+  unsigned short Xi[3] = {
+    (unsigned short)(seed & 0xFFFF),
+    (unsigned short)((seed >> 16) & 0xFFFF),
+    (unsigned short)((seed * 1103515245 + 12345) & 0xFFFF)
+  };
+  auto rand_c = [&](double min_val, double max_val) {
+    return min_val + erand48(Xi) * (max_val - min_val);
+  };
+  // Randomize walls and spheres (indices 0..7, keeping 3 as black front wall and 8 as light source)
+  spheres[0].c = Vec(rand_c(0.15, 0.9), rand_c(0.15, 0.9), rand_c(0.15, 0.9)); // Left
+  spheres[1].c = Vec(rand_c(0.15, 0.9), rand_c(0.15, 0.9), rand_c(0.15, 0.9)); // Right
+  spheres[2].c = Vec(rand_c(0.25, 0.9), rand_c(0.25, 0.9), rand_c(0.25, 0.9)); // Back
+  spheres[4].c = Vec(rand_c(0.25, 0.9), rand_c(0.25, 0.9), rand_c(0.25, 0.9)); // Bottom
+  spheres[5].c = Vec(rand_c(0.35, 0.9), rand_c(0.35, 0.9), rand_c(0.35, 0.9)); // Top
+  spheres[6].c = Vec(rand_c(0.4, 0.999), rand_c(0.4, 0.999), rand_c(0.4, 0.999)); // Mirror sphere tint
+  spheres[7].c = Vec(rand_c(0.4, 0.999), rand_c(0.4, 0.999), rand_c(0.4, 0.999)); // Glass sphere tint
+}
+
+EMSCRIPTEN_KEEPALIVE
+void init_render(int w, int h) {
+  if (w != current_w || h != current_h) {
+    free(pixel_buffer);
+    free(subpixel_accum);
+    current_w = w;
+    current_h = h;
+    pixel_buffer = (uint8_t*)malloc(w * h * 4 * sizeof(uint8_t));
+    subpixel_accum = (Vec*)malloc(w * h * 4 * sizeof(Vec));
+  }
+  for (int i = 0; i < w * h * 4; ++i) {
+    subpixel_accum[i] = Vec();
+  }
+  for (int i = 0; i < w * h; ++i) {
+    pixel_buffer[i * 4 + 0] = 0;
+    pixel_buffer[i * 4 + 1] = 0;
+    pixel_buffer[i * 4 + 2] = 0;
+    pixel_buffer[i * 4 + 3] = 255;
+  }
+  current_subpixel_samples = 0;
+}
+
+// Render `samps_per_subpixel` samples per 2x2 subpixel (total 4 * samps_per_subpixel samples per pixel)
+// over rows [start_y, end_y) and accumulate into subpixel_accum & pixel_buffer.
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_rows(int start_y, int end_y, int samps_per_subpixel, int pass_index) {
+  int w = current_w;
+  int h = current_h;
+  if (!pixel_buffer || !subpixel_accum || w <= 0 || h <= 0) return nullptr;
+  if (start_y < 0) start_y = 0;
+  if (end_y > h) end_y = h;
+  if (samps_per_subpixel < 1) samps_per_subpixel = 1;
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm()); // cam pos, dir
+  Vec cx = Vec(w * .5135 / h), cy = (cx % cam.d).norm() * .5135, r;
+
+  double prev_samps = (double)current_subpixel_samples;
+  double new_samps = (double)samps_per_subpixel;
+  double total_samps = prev_samps + new_samps;
+
+  for (int y = start_y; y < end_y; y++) {
+    unsigned short Xi[3] = {
+      (unsigned short)(y + pass_index * 997),
+      (unsigned short)(pass_index * 7919),
+      (unsigned short)(y * y * y + pass_index * 104729)
+    };
+    for (unsigned short x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      Vec pixel_c(0, 0, 0);
+      for (int sy = 0; sy < 2; sy++) {     // 2x2 subpixel rows
+        for (int sx = 0; sx < 2; sx++) {   // 2x2 subpixel cols
+          int sub_idx = i * 4 + sy * 2 + sx;
+          r = Vec();
+          for (int s = 0; s < samps_per_subpixel; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps_per_subpixel);
+          }
+          subpixel_accum[sub_idx] = (subpixel_accum[sub_idx] * prev_samps + r * new_samps) * (1.0 / total_samps);
+          const Vec &sc = subpixel_accum[sub_idx];
+          pixel_c = pixel_c + Vec(clamp(sc.x), clamp(sc.y), clamp(sc.z)) * .25;
+        }
+      }
+      pixel_buffer[i * 4 + 0] = toInt(pixel_c.x);
+      pixel_buffer[i * 4 + 1] = toInt(pixel_c.y);
+      pixel_buffer[i * 4 + 2] = toInt(pixel_c.z);
+      pixel_buffer[i * 4 + 3] = 255;
+    }
+  }
+  if (end_y == h) {
+    current_subpixel_samples += samps_per_subpixel;
+  }
+  return pixel_buffer;
+}
+
+// Convenience single-call render function
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_scene(int w, int h, int samps) {
+  init_render(w, h);
+  int samps_per_subpixel = samps >= 4 ? samps / 4 : 1;
+  return render_rows(0, h, samps_per_subpixel, 0);
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_pixel_buffer() {
+  return pixel_buffer;
+}
+
+}
