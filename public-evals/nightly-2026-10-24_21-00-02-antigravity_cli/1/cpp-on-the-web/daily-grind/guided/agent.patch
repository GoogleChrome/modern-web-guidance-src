@@ -0,0 +1,112 @@
+import createSmallptModule from './smallpt.js';
+
+let wasmModule = null;
+let isRendering = false;
+let currentRenderId = 0;
+
+const SPHERE_NAMES = [
+  'Left Wall',
+  'Right Wall',
+  'Back Wall',
+  'Front Wall',
+  'Floor',
+  'Ceiling',
+  'Mirror Sphere',
+  'Glass Sphere'
+];
+
+async function ensureModule() {
+  if (!wasmModule) {
+    wasmModule = await createSmallptModule();
+  }
+  return wasmModule;
+}
+
+function getSphereColors(mod) {
+  const colors = [];
+  for (let i = 0; i < 8; i++) {
+    const r = Math.round(Math.pow(Math.min(1, Math.max(0, mod._get_sphere_color_r(i))), 1 / 2.2) * 255);
+    const g = Math.round(Math.pow(Math.min(1, Math.max(0, mod._get_sphere_color_g(i))), 1 / 2.2) * 255);
+    const b = Math.round(Math.pow(Math.min(1, Math.max(0, mod._get_sphere_color_b(i))), 1 / 2.2) * 255);
+    colors.push({
+      index: i,
+      name: SPHERE_NAMES[i],
+      r, g, b,
+      hex: `#${r.toString(16).padStart(2, '0')}${g.toString(16).padStart(2, '0')}${b.toString(16).padStart(2, '0')}`
+    });
+  }
+  return colors;
+}
+
+self.onmessage = async (e) => {
+  const { type, width = 320, height = 240, targetSpp = 32, randomize = false, reset = false, customColors = null, seed = Date.now() } = e.data;
+
+  if (type === 'RENDER') {
+    const renderId = ++currentRenderId;
+    const mod = await ensureModule();
+
+    if (reset) {
+      mod._reset_default_colors();
+    } else if (randomize) {
+      mod._randomize_sphere_colors(seed >>> 0);
+    } else if (Array.isArray(customColors)) {
+      for (const c of customColors) {
+        mod._set_sphere_color(c.index, c.r, c.g, c.b);
+      }
+    }
+
+    const palette = getSphereColors(mod);
+    self.postMessage({ type: 'PALETTE', palette, renderId });
+
+    mod._init_render(width, height);
+
+    const startTime = performance.now();
+    // Progressive passes: first quick 4 SPP pass in row chunks, then accumulate up to targetSpp
+    const passes = [];
+    let accumulatedSpp = 0;
+    while (accumulatedSpp < targetSpp) {
+      const stepSpp = accumulatedSpp === 0 ? 4 : Math.min(8, targetSpp - accumulatedSpp);
+      const sampsPerSubpixel = Math.max(1, Math.floor(stepSpp / 4));
+      passes.push(sampsPerSubpixel);
+      accumulatedSpp += sampsPerSubpixel * 4;
+    }
+
+    let completedSpp = 0;
+    const chunkRows = 40;
+
+    for (let p = 0; p < passes.length; p++) {
+      const sampsPerSubpixel = passes[p];
+      for (let y = 0; y < height; y += chunkRows) {
+        if (renderId !== currentRenderId) return; // superseded by a newer render request
+        const endY = Math.min(height, y + chunkRows);
+        const ptr = mod._render_rows(y, endY, sampsPerSubpixel, p + 1);
+        const byteLength = width * height * 4;
+        const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, byteLength).slice();
+
+        const progress = ((p + (endY / height)) / passes.length);
+        const currentSpp = completedSpp + (endY === height ? sampsPerSubpixel * 4 : Math.round((endY / height) * sampsPerSubpixel * 4));
+        const elapsedMs = performance.now() - startTime;
+
+        self.postMessage(
+          {
+            type: 'FRAME',
+            renderId,
+            width,
+            height,
+            pixels,
+            progress,
+            currentSpp,
+            targetSpp: accumulatedSpp,
+            elapsedMs,
+            done: p === passes.length - 1 && endY === height
+          },
+          [pixels.buffer]
+        );
+
+        // Yield briefly so incoming messages (e.g. clicking Randomize again) can interrupt
+        await new Promise((r) => setTimeout(r, 0));
+      }
+      completedSpp += sampsPerSubpixel * 4;
+    }
+  }
+};
