+  <script src="smallpt.js"></script>
+  <script>
+    const SPHERE_META = [
+      { index: 0, name: 'Left Wall (Diff)' },
+      { index: 1, name: 'Right Wall (Diff)' },
+      { index: 2, name: 'Back Wall (Diff)' },
+      { index: 4, name: 'Floor (Diff)' },
+      { index: 5, name: 'Ceiling (Diff)' },
+      { index: 6, name: 'Mirror Sphere' },
+      { index: 7, name: 'Glass Sphere' }
+    ];
+
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const passesSelect = document.getElementById('passes-select');
+    const statusBadge = document.getElementById('status-badge');
+    const statsText = document.getElementById('stats-text');
+    const progressFill = document.getElementById('progress-fill');
+    const sphereListEl = document.getElementById('sphere-list');
+
+    let wasmReady = false;
+    let currentJobId = 0;
+    let startTime = 0;
+
+    function toSrgbCss(r, g, b) {
+      const gamma = (v) => Math.min(255, Math.max(0, Math.round(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255)));
+      return `rgb(${gamma(r)}, ${gamma(g)}, ${gamma(b)})`;
+    }
+
+    function updateSwatchesUI() {
+      if (!wasmReady) return;
+      sphereListEl.innerHTML = '';
+      for (const item of SPHERE_META) {
+        const r = Module._get_sphere_color_r(item.index);
+        const g = Module._get_sphere_color_g(item.index);
+        const b = Module._get_sphere_color_b(item.index);
+        const div = document.createElement('div');
+        div.className = 'sphere-item';
+        div.innerHTML = `
+          <span class="swatch" style="background:${toSrgbCss(r, g, b)}"></span>
+          <span class="sphere-name" title="${item.name}">${item.name}</span>
+        `;
+        sphereListEl.appendChild(div);
+      }
+    }
+
+    function parseResolution() {
+      const [w, h] = resolutionSelect.value.split('x').map(Number);
+      return { w, h };
+    }
+
+    function startRender(randomize = false) {
+      if (!wasmReady) return;
+      currentJobId++;
+      const jobId = currentJobId;
+
+      if (randomize) {
+        const seed = Math.floor(Math.random() * 0xFFFFFFFF) >>> 0;
+        Module._randomize_sphere_colors(seed);
+      }
+
+      updateSwatchesUI();
+
+      const { w, h } = parseResolution();
+      const targetPasses = parseInt(passesSelect.value, 10) || 8;
+      canvas.width = w;
+      canvas.height = h;
 
+      Module._init_renderer(w, h);
+      startTime = performance.now();
+      progressFill.style.width = '0%';
+      statusBadge.textContent = 'Rendering (WASM)...';
+      statusBadge.className = 'badge';
+
+      function stepPass(passIndex) {
+        if (jobId !== currentJobId) return;
+
+        const seedOffset = ((Date.now() & 0xFFFF) + passIndex * 7919) >>> 0;
+        const ptr = Module._render_pass(1, seedOffset);
+        const byteLength = w * h * 4;
+        const pixels = new Uint8ClampedArray(Module.HEAPU8.buffer, ptr, byteLength);
+        const imageData = new ImageData(new Uint8ClampedArray(pixels), w, h);
+        ctx.putImageData(imageData, 0, 0);
+
+        const completedPasses = passIndex + 1;
+        const totalSpp = completedPasses * 4;
+        const elapsedSec = ((performance.now() - startTime) / 1000).toFixed(2);
+        const pct = Math.min(100, Math.round((completedPasses / targetPasses) * 100));
+
+        progressFill.style.width = `${pct}%`;
+        statsText.textContent = `${totalSpp} spp (${completedPasses}/${targetPasses} passes) | ${elapsedSec}s`;
+
+        if (completedPasses < targetPasses) {
+          requestAnimationFrame(() => stepPass(completedPasses));
+        } else {
+          statusBadge.textContent = 'Render Complete';
+          statusBadge.className = 'badge done';
+        }
+      }
+
+      requestAnimationFrame(() => stepPass(0));
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      startRender(true);
+    });
+
+    resetBtn.addEventListener('click', () => {
+      if (!wasmReady) return;
+      Module._reset_default_colors();
+      startRender(false);
+    });
+
+    resolutionSelect.addEventListener('change', () => startRender(false));
+    passesSelect.addEventListener('change', () => startRender(false));
+
+    if (typeof Module !== 'undefined') {
+      if (Module.calledRun) {
+        wasmReady = true;
+        startRender(false);
+      } else {
+        const prevInit = Module.onRuntimeInitialized;
+        Module.onRuntimeInitialized = function () {
+          if (prevInit) prevInit();
+          wasmReady = true;
+          startRender(false);
+        };
+      }
+    }
+  </script>
