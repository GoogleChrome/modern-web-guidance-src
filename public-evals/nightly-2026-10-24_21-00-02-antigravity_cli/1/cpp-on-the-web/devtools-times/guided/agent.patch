+++ b/src/components/SmallptPathTracer.tsx
@@ -0,0 +1,268 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColorInfo {
+  index: number;
+  name: string;
+  hex: string;
+}
+
+const SPHERE_NAMES: { index: number; name: string }[] = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 4, name: 'Floor' },
+  { index: 5, name: 'Ceiling' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+function toGammaHex(r: number, g: number, b: number): string {
+  const clamp = (x: number) => (x < 0 ? 0 : x > 1 ? 1 : x);
+  const toByte = (x: number) => Math.floor(Math.pow(clamp(x), 1 / 2.2) * 255 + 0.5);
+  const hex = (n: number) => n.toString(16).padStart(2, '0');
+  return `#${hex(toByte(r))}${hex(toByte(g))}${hex(toByte(b))}`;
+}
+
+export default function SmallptPathTracer() {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const wasmModuleRef = useRef<any>(null);
+  const renderIdRef = useRef<number>(0);
+
+  const [isRendering, setIsRendering] = useState<boolean>(true);
+  const [progress, setProgress] = useState<number>(0);
+  const [renderTimeMs, setRenderTimeMs] = useState<number | null>(null);
+  const [samplesPerSubpixel, setSamplesPerSubpixel] = useState<number>(2); // 2 * 4 = 8 spp
+  const [sphereColors, setSphereColors] = useState<SphereColorInfo[]>([]);
+  const [error, setError] = useState<string | null>(null);
+
+  const WIDTH = 320;
+  const HEIGHT = 240;
+  const ROWS_PER_SLICE = 8;
+
+  const readSphereColors = useCallback((mod: any) => {
+    const list: SphereColorInfo[] = SPHERE_NAMES.map(({ index, name }) => {
+      const r = mod._get_sphere_color_channel(index, 0);
+      const g = mod._get_sphere_color_channel(index, 1);
+      const b = mod._get_sphere_color_channel(index, 2);
+      return {
+        index,
+        name,
+        hex: toGammaHex(r, g, b),
+      };
+    });
+    setSphereColors(list);
+  }, []);
+
+  const startRender = useCallback(
+    (samps: number, randomize: boolean) => {
+      const mod = wasmModuleRef.current;
+      const canvas = canvasRef.current;
+      if (!mod || !canvas) return;
+
+      const currentRenderId = ++renderIdRef.current;
+
+      if (randomize) {
+        const seed = Math.floor(Math.random() * 0xffffffff) >>> 0;
+        mod._randomize_sphere_colors(seed);
+      }
+
+      readSphereColors(mod);
+      setIsRendering(true);
+      setProgress(0);
+      setRenderTimeMs(null);
+
+      const startTime = performance.now();
+      const ptr = mod._init_render(WIDTH, HEIGHT, samps);
+      const ctx = canvas.getContext('2d');
+      if (!ctx) return;
+
+      let currentRow = 0;
+
+      const renderNextSlice = () => {
+        if (renderIdRef.current !== currentRenderId) return;
+
+        const nextRow = Math.min(currentRow + ROWS_PER_SLICE, HEIGHT);
+        const outPtr = mod._render_rows(currentRow, nextRow);
+        currentRow = nextRow;
+
+        const byteLength = WIDTH * HEIGHT * 4;
+        const pixels = new Uint8ClampedArray(
+          mod.HEAPU8.buffer,
+          outPtr || ptr,
+          byteLength
+        );
+        const imageData = new ImageData(new Uint8ClampedArray(pixels), WIDTH, HEIGHT);
+        ctx.putImageData(imageData, 0, 0);
+
+        const pct = Math.round((currentRow / HEIGHT) * 100);
+        setProgress(pct);
+
+        if (currentRow < HEIGHT) {
+          requestAnimationFrame(renderNextSlice);
+        } else {
+          setIsRendering(false);
+          setRenderTimeMs(Math.round(performance.now() - startTime));
+        }
+      };
+
+      requestAnimationFrame(renderNextSlice);
+    },
+    [readSphereColors]
+  );
+
+  useEffect(() => {
+    let mounted = true;
+
+    async function loadWasm() {
+      try {
+        const rawBase = import.meta.env.BASE_URL || '/';
+        const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
+        const wasmJsUrl = new URL(`${base}wasm/smallpt.mjs`, window.location.origin).href;
+        const ModuleFactory = (await import(/* @vite-ignore */ wasmJsUrl)).default;
+        const mod = await ModuleFactory();
+        if (!mounted) return;
+        wasmModuleRef.current = mod;
+        startRender(samplesPerSubpixel, false);
+      } catch (err: any) {
+        console.error('Failed to load smallpt WebAssembly module:', err);
+        if (mounted) {
+          setError(err?.message || 'Failed to initialize WebAssembly path tracer.');
+          setIsRendering(false);
+        }
+      }
+    }
+
+    loadWasm();
+
+    return () => {
+      mounted = false;
+      renderIdRef.current++;
+    };
+  }, []);
+
+  const handleRandomizeAndRender = () => {
+    startRender(samplesPerSubpixel, true);
+  };
+
+  const handleResetAndRender = () => {
+    if (!wasmModuleRef.current) return;
+    wasmModuleRef.current._reset_sphere_colors();
+    startRender(samplesPerSubpixel, false);
+  };
+
+  return (
+    <section
+      aria-label="smallpt WebAssembly Path Tracer"
+      className="my-6 bg-gray-900 text-white rounded-lg shadow-md border border-gray-800 overflow-hidden"
+    >
+      <div className="p-4 sm:p-6 flex flex-col lg:flex-row gap-6 items-center">
+        {/* Canvas Display */}
+        <div className="relative flex-shrink-0 bg-black rounded border border-gray-700 overflow-hidden shadow-inner">
+          <canvas
+            ref={canvasRef}
+            width={WIDTH}
+            height={HEIGHT}
+            id="smallpt-canvas"
+            className="block w-[320px] sm:w-[440px] h-auto aspect-[4/3]"
+          />
+          {isRendering && (
+            <div className="absolute bottom-0 inset-x-0 bg-black/75 px-3 py-1.5 flex items-center justify-between text-xs font-mono">
+              <span>Rendering via WebAssembly...</span>
+              <span>{progress}%</span>
+            </div>
+          )}
+        </div>
+
+        {/* Info & Controls */}
+        <div className="flex-1 space-y-4 w-full">
+          <div>
+            <div className="flex items-center gap-2">
+              <span className="px-2 py-0.5 text-xs font-semibold uppercase tracking-wider bg-amber-500 text-gray-950 rounded">
+                WebAssembly Demo
+              </span>
+              <span className="text-xs text-gray-400 font-mono">
+                {WIDTH}&times;{HEIGHT} &bull; {samplesPerSubpixel * 4} spp
+                {renderTimeMs !== null ? ` • ${(renderTimeMs / 1000).toFixed(2)}s` : ''}
+              </span>
+            </div>
+            <h2 className="text-xl sm:text-2xl font-bold mt-1 text-white">
+              smallpt C++ Path Tracer in WebAssembly
+            </h2>
+            <p className="text-sm text-gray-300 mt-1">
+              Kevin Beason&apos;s open-source 99-line C++ Monte Carlo global illumination path tracer
+              compiled to WebAssembly with Emscripten and running client-side in your browser.
+            </p>
+          </div>
+
+          {error && (
+            <div className="p-3 bg-red-900/60 border border-red-700 rounded text-xs text-red-200">
+              {error}
+            </div>
+          )}
+
+          {/* Sphere Color Swatches */}
+          {sphereColors.length > 0 && (
+            <div>
+              <div className="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">
+                Current Scene Sphere Colors
+              </div>
+              <div className="flex flex-wrap gap-2">
+                {sphereColors.map((sphere) => (
+                  <div
+                    key={sphere.index}
+                    className="flex items-center gap-1.5 bg-gray-800/90 border border-gray-700 px-2.5 py-1 rounded text-xs"
+                  >
+                    <span
+                      className="w-3 h-3 rounded-full border border-white/20 inline-block"
+                      style={{ backgroundColor: sphere.hex }}
+                    />
+                    <span className="text-gray-200">{sphere.name}</span>
+                  </div>
+                ))}
+              </div>
+            </div>
+          )}
+
+          {/* Action Buttons */}
+          <div className="flex flex-wrap items-center gap-3 pt-1">
+            <button
+              type="button"
+              id="randomize-spheres-btn"
+              onClick={handleRandomizeAndRender}
+              className="px-4 py-2 bg-amber-500 hover:bg-amber-400 active:bg-amber-600 text-gray-950 font-bold text-sm rounded shadow transition cursor-pointer"
+            >
+              Run Again with Randomized Sphere Colors
+            </button>
+
+            <button
+              type="button"
+              id="reset-spheres-btn"
+              onClick={handleResetAndRender}
+              className="px-3 py-2 bg-gray-800 hover:bg-gray-700 text-gray-200 font-medium text-sm rounded border border-gray-700 transition cursor-pointer"
+            >
+              Reset Classic Colors
+            </button>
+
+            <label className="flex items-center gap-2 text-xs text-gray-300 ml-auto">
+              <span>Samples:</span>
+              <select
+                value={samplesPerSubpixel}
+                onChange={(e) => {
+                  const val = Number(e.target.value);
+                  setSamplesPerSubpixel(val);
+                  startRender(val, false);
+                }}
+                className="bg-gray-800 border border-gray-700 rounded px-2 py-1 text-white"
+              >
+                <option value={1}>4 spp (Fast)</option>
+                <option value={2}>8 spp (Balanced)</option>
+                <option value={4}>16 spp (Detailed)</option>
+                <option value={8}>32 spp (High Quality)</option>
+              </select>
+            </label>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
