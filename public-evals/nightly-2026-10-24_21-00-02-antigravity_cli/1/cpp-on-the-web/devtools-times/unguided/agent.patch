@@ -0,0 +1,332 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColorInfo {
+  name: string;
+  index: number;
+  hex: string;
+}
+
+declare global {
+  interface Window {
+    createSmallptModule?: (options?: Record<string, unknown>) => Promise<any>;
+  }
+}
+
+const SPHERE_NAMES: { index: number; name: string }[] = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 4, name: 'Floor' },
+  { index: 5, name: 'Ceiling' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+function toHex(r: number, g: number, b: number): string {
+  const clamp = (x: number) => Math.max(0, Math.min(1, x));
+  const toByte = (x: number) => Math.min(255, Math.max(0, Math.round(Math.pow(clamp(x), 1 / 2.2) * 255)));
+  const hex = (n: number) => n.toString(16).padStart(2, '0');
+  return `#${hex(toByte(r))}${hex(toByte(g))}${hex(toByte(b))}`;
+}
+
+export default function SmallptPathTracer({ baseUrl = '/devtools-times/' }: { baseUrl?: string }) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const wasmModuleRef = useRef<any>(null);
+  const renderJobRef = useRef<number>(0);
+
+  const [status, setStatus] = useState<'loading' | 'rendering' | 'ready' | 'error'>('loading');
+  const [progress, setProgress] = useState<number>(0);
+  const [renderTimeMs, setRenderTimeMs] = useState<number | null>(null);
+  const [samplesPerSubpixel, setSamplesPerSubpixel] = useState<number>(4);
+  const [resolution, setResolution] = useState<{ w: number; h: number }>({ w: 320, h: 240 });
+  const [sphereColors, setSphereColors] = useState<SphereColorInfo[]>([]);
+  const [renderCount, setRenderCount] = useState<number>(0);
+
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+
+  const readSphereColorsFromWasm = useCallback((mod: any) => {
+    if (!mod || !mod._get_sphere_color_channel) return;
+    const colors: SphereColorInfo[] = SPHERE_NAMES.map(({ index, name }) => {
+      const r = mod._get_sphere_color_channel(index, 0);
+      const g = mod._get_sphere_color_channel(index, 1);
+      const b = mod._get_sphere_color_channel(index, 2);
+      return { name, index, hex: toHex(r, g, b) };
+    });
+    setSphereColors(colors);
+  }, []);
+
+  const runRender = useCallback(
+    (randomize: boolean, customSamps?: number, customRes?: { w: number; h: number }) => {
+      const mod = wasmModuleRef.current;
+      const canvas = canvasRef.current;
+      if (!mod || !canvas) return;
+
+      const jobId = ++renderJobRef.current;
+      const w = customRes ? customRes.w : resolution.w;
+      const h = customRes ? customRes.h : resolution.h;
+      const samps = customSamps ?? samplesPerSubpixel;
+
+      if (randomize) {
+        const seed = Math.floor(Math.random() * 0xffffffff) >>> 0;
+        mod._randomize_sphere_colors(seed);
+      }
+
+      readSphereColorsFromWasm(mod);
+
+      canvas.width = w;
+      canvas.height = h;
+      const ctx = canvas.getContext('2d');
+      if (!ctx) return;
+
+      setStatus('rendering');
+      setProgress(0);
+      const startTime = performance.now();
+
+      mod._init_buffer(w, h);
+      const rowsPerChunk = 16;
+      let currentRow = 0;
+
+      const renderNextChunk = () => {
+        if (renderJobRef.current !== jobId) return;
+
+        const nextRow = Math.min(currentRow + rowsPerChunk, h);
+        const ptr = mod._render_rows(w, h, samps, currentRow, nextRow);
+
+        const byteLength = w * h * 4;
+        const pixels = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, byteLength);
+        const imageData = new ImageData(new Uint8ClampedArray(pixels), w, h);
+        ctx.putImageData(imageData, 0, 0);
+
+        currentRow = nextRow;
+        setProgress(Math.round((currentRow / h) * 100));
+
+        if (currentRow < h) {
+          requestAnimationFrame(renderNextChunk);
+        } else {
+          const elapsed = Math.round(performance.now() - startTime);
+          setRenderTimeMs(elapsed);
+          setStatus('ready');
+          setRenderCount((c) => c + 1);
+        }
+      };
+
+      requestAnimationFrame(renderNextChunk);
+    },
+    [resolution, samplesPerSubpixel, readSphereColorsFromWasm]
+  );
+
+  useEffect(() => {
+    let cancelled = false;
+
+    async function loadWasm() {
+      try {
+        setStatus('loading');
+        if (!window.createSmallptModule) {
+          await new Promise<void>((resolve, reject) => {
+            const existingScript = document.querySelector('script[data-smallpt-wasm]');
+            if (existingScript && window.createSmallptModule) {
+              resolve();
+              return;
+            }
+            const script = document.createElement('script');
+            script.src = `${normalizedBase}smallpt.js`;
+            script.async = true;
+            script.setAttribute('data-smallpt-wasm', 'true');
+            script.onload = () => resolve();
+            script.onerror = () => reject(new Error('Failed to load smallpt.js'));
+            document.head.appendChild(script);
+          });
+        }
+
+        if (cancelled || !window.createSmallptModule) return;
+
+        const mod = await window.createSmallptModule({
+          locateFile: (path: string) => `${normalizedBase}${path}`,
+        });
+
+        if (cancelled) return;
+        wasmModuleRef.current = mod;
+        runRender(false);
+      } catch (err) {
+        console.error('Error initializing smallpt WebAssembly module:', err);
+        if (!cancelled) setStatus('error');
+      }
+    }
+
+    loadWasm();
+
+    return () => {
+      cancelled = true;
+      renderJobRef.current++;
+    };
+  }, [normalizedBase]);
+
+  const handleRandomizeAndRun = () => {
+    runRender(true);
+  };
+
+  const handleResetDefault = () => {
+    const mod = wasmModuleRef.current;
+    if (!mod) return;
+    mod._reset_default_colors();
+    runRender(false);
+  };
+
+  return (
+    <section
+      id="smallpt-wasm-section"
+      className="my-8 bg-white border border-gray-300 rounded-lg shadow-sm overflow-hidden"
+    >
+      <div className="bg-gray-900 text-white px-6 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
+        <div>
+          <div className="flex items-center gap-2">
+            <span className="inline-block w-2.5 h-2.5 rounded-full bg-amber-400"></span>
+            <span className="text-xs uppercase tracking-wider font-semibold text-amber-400">
+              Interactive WebAssembly Feature
+            </span>
+          </div>
+          <h2 className="text-xl font-bold mt-0.5">
+            smallpt: Global Illumination Path Tracer in C++ &amp; WebAssembly
+          </h2>
+          <p className="text-xs text-gray-300 mt-0.5">
+            Kevin Beason&apos;s 99-line Monte Carlo path tracer compiled with Emscripten, running client-side in your browser.
+          </p>
+        </div>
+        <div className="flex flex-wrap items-center gap-2">
+          <button
+            id="randomize-spheres-btn"
+            type="button"
+            onClick={handleRandomizeAndRun}
+            disabled={status === 'loading'}
+            className="bg-amber-400 hover:bg-amber-300 disabled:opacity-50 text-gray-950 font-bold text-sm px-4 py-2.5 rounded shadow cursor-pointer transition-colors"
+          >
+            Randomize Sphere Colors &amp; Re-run
+          </button>
+          <button
+            id="reset-spheres-btn"
+            type="button"
+            onClick={handleResetDefault}
+            disabled={status === 'loading'}
+            className="bg-gray-700 hover:bg-gray-600 disabled:opacity-50 text-white font-semibold text-xs px-3 py-2.5 rounded cursor-pointer transition-colors"
+          >
+            Reset Cornell Box
+          </button>
+        </div>
+      </div>
+
+      <div className="p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
+        <div className="lg:col-span-7 flex flex-col items-center">
+          <div className="relative w-full max-w-[480px] aspect-[4/3] bg-black rounded overflow-hidden border border-gray-300 shadow-inner flex items-center justify-center">
+            <canvas
+              ref={canvasRef}
+              id="smallpt-canvas"
+              width={resolution.w}
+              height={resolution.h}
+              className="w-full h-full object-contain"
+            />
+            {status === 'loading' && (
+              <div className="absolute inset-0 flex flex-col items-center justify-center bg-black/75 text-white text-sm">
+                <span>Loading smallpt.wasm...</span>
+              </div>
+            )}
+          </div>
+
+          <div className="w-full max-w-[480px] mt-3 flex items-center justify-between text-xs text-gray-600">
+            <div>
+              {status === 'rendering' ? (
+                <span className="font-semibold text-amber-700">
+                  Tracing rays in WebAssembly... {progress}%
+                </span>
+              ) : status === 'ready' ? (
+                <span className="font-semibold text-green-700">
+                  Render #{renderCount} complete in {renderTimeMs} ms ({resolution.w}&times;{resolution.h}, {samplesPerSubpixel * 4} spp)
+                </span>
+              ) : status === 'error' ? (
+                <span className="font-semibold text-red-600">Failed to initialize WebAssembly renderer</span>
+              ) : (
+                <span>Initializing WebAssembly runtime...</span>
+              )}
+            </div>
+          </div>
+
+          <div className="w-full max-w-[480px] mt-1.5 h-1.5 bg-gray-200 rounded-full overflow-hidden">
+            <div
+              className="h-full bg-amber-500 transition-all duration-150"
+              style={{ width: `${progress}%` }}
+            />
+          </div>
+        </div>
+
+        <div className="lg:col-span-5 flex flex-col justify-between space-y-4 text-sm text-gray-700">
+          <div>
+            <h3 className="font-bold text-gray-900 text-base mb-1">Scene Sphere Palette</h3>
+            <p className="text-xs text-gray-500 mb-3">
+              In <code className="bg-gray-100 px-1 py-0.5 rounded">smallpt</code>, all walls and objects in the Cornell box scene are represented as spheres (walls use radius 10<sup>5</sup>). Click the button above to randomize sphere albedos and trace a new image.
+            </p>
+            <div className="grid grid-cols-2 gap-2">
+              {sphereColors.map((sphere) => (
+                <div
+                  key={sphere.index}
+                  className="flex items-center gap-2 p-2 rounded border border-gray-200 bg-gray-50"
+                >
+                  <span
+                    className="w-5 h-5 rounded-full border border-gray-400 shrink-0 shadow-xs"
+                    style={{ backgroundColor: sphere.hex }}
+                  />
+                  <div className="truncate">
+                    <div className="text-xs font-medium text-gray-900 truncate">{sphere.name}</div>
+                    <div className="text-[10px] font-mono text-gray-500 uppercase">{sphere.hex}</div>
+                  </div>
+                </div>
+              ))}
+            </div>
+          </div>
+
+          <div className="pt-3 border-t border-gray-200 flex flex-wrap items-center justify-between gap-3">
+            <div className="flex items-center gap-2">
+              <label htmlFor="smallpt-spp" className="text-xs font-semibold text-gray-700">
+                Samples/pixel:
+              </label>
+              <select
+                id="smallpt-spp"
+                value={samplesPerSubpixel}
+                onChange={(e) => {
+                  const newSamps = Number(e.target.value);
+                  setSamplesPerSubpixel(newSamps);
+                  runRender(false, newSamps);
+                }}
+                className="text-xs border border-gray-300 rounded px-2 py-1 bg-white text-gray-900"
+              >
+                <option value={1}>4 spp (Fast)</option>
+                <option value={2}>8 spp (Balanced)</option>
+                <option value={4}>16 spp (Default)</option>
+                <option value={8}>32 spp (High Quality)</option>
+              </select>
+            </div>
+
+            <div className="flex items-center gap-2">
+              <label htmlFor="smallpt-res" className="text-xs font-semibold text-gray-700">
+                Resolution:
+              </label>
+              <select
+                id="smallpt-res"
+                value={`${resolution.w}x${resolution.h}`}
+                onChange={(e) => {
+                  const [w, h] = e.target.value.split('x').map(Number);
+                  const newRes = { w, h };
+                  setResolution(newRes);
+                  runRender(false, undefined, newRes);
+                }}
+                className="text-xs border border-gray-300 rounded px-2 py-1 bg-white text-gray-900"
+              >
+                <option value="200x150">200&times;150</option>
+                <option value="320x240">320&times;240</option>
+                <option value="400x300">400&times;300</option>
+              </select>
+            </div>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
