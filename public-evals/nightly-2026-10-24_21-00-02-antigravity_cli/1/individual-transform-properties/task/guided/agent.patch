     .btn:hover {
       background: #3e2723;
     }
 
+    /* Featured Promo Badge */
+    .seasonal-header {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      gap: 12px;
+      margin-bottom: 10px;
+    }
+
+    .target {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      background: var(--accent);
+      color: var(--primary);
+      font-weight: bold;
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      letter-spacing: 0.5px;
+      width: 68px;
+      height: 68px;
+      border-radius: 50%;
+      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
+      text-align: center;
+      line-height: 1.2;
+      padding: 8px;
+      cursor: pointer;
+
+      /* Identity transformations for stable stacking context and containing block */
+      translate: 0px;
+      rotate: 0deg;
+      scale: 1;
+
+      /* Concurrent spinning and sliding animations */
+      animation:
+        spin 6s linear infinite,
+        slide 3s ease-in-out infinite alternate;
+
+      /* Smooth hover scale transition independent of rotate and translate */
+      transition: scale 0.3s ease;
+    }
+
+    .target:hover {
+      scale: 1.2;
+    }
+
+    @keyframes spin {
+      from {
+        rotate: 0deg;
+      }
+      to {
+        rotate: 360deg;
+      }
+    }
+
+    @keyframes slide {
+      from {
+        translate: -24px 0;
+      }
+      to {
+        translate: 24px 0;
+      }
+    }
+
