+  <script>
+    (function () {
+      const taskListEl = document.getElementById('ops-task-list');
+      const logListEl = document.getElementById('ops-execution-log');
+      const statActiveEl = document.getElementById('stat-active');
+      const statCompletedEl = document.getElementById('stat-completed');
+      const statYieldsEl = document.getElementById('stat-yields');
+      const statSchedulerModeEl = document.getElementById('stat-scheduler-mode');
+      const queueBadgeEl = document.getElementById('queue-badge');
+
+      let taskIdCounter = 0;
+      let activeCount = 0;
+      let completedCount = 0;
+      let yieldCount = 0;
+
+      // Feature detect the scheduler API and load polyfill if needed
+      function ensureSchedulerSupport(onReady) {
+        if (!('scheduler' in window && 'postTask' in window.scheduler)) {
+          statSchedulerModeEl.textContent = 'Polyfill Fallback';
+          const script = document.createElement('script');
+          script.src = 'https://unpkg.com/scheduler-polyfill';
+          script.onload = () => {
+            statSchedulerModeEl.textContent = 'Scheduler Polyfill';
+            if (onReady) onReady();
+          };
+          script.onerror = () => {
+            // Local priority-ordered fallback if offline or CDN unreachable
+            installLocalSchedulerFallback();
+            if (onReady) onReady();
+          };
+          document.head.appendChild(script);
+        } else {
+          statSchedulerModeEl.textContent = 'Native Scheduler API';
+          if (onReady) onReady();
+        }
+      }
+
+      const priorityRank = {
+        'user-blocking': 0,
+        'user-visible': 1,
+        'background': 2
+      };
+
+      const fallbackQueue = [];
+      let fallbackFlushScheduled = false;
+
+      function installLocalSchedulerFallback() {
+        window.scheduler = window.scheduler || {};
+        if (!('postTask' in window.scheduler)) {
+          window.scheduler.postTask = function (callback, options) {
+            const priority = (options && options.priority) || 'user-visible';
+            return new Promise((resolve, reject) => {
+              fallbackQueue.push({
+                callback,
+                priority,
+                rank: priorityRank[priority] ?? 1,
+                seq: ++taskIdCounter,
+                resolve,
+                reject
+              });
+              fallbackQueue.sort((a, b) => a.rank - b.rank || a.seq - b.seq);
+              if (!fallbackFlushScheduled) {
+                fallbackFlushScheduled = true;
+                setTimeout(flushFallbackQueue, 0);
+              }
+            });
+          };
+        }
+      }
+
+      async function flushFallbackQueue() {
+        fallbackFlushScheduled = false;
+        while (fallbackQueue.length > 0) {
+          const next = fallbackQueue.shift();
+          try {
+            const result = await next.callback();
+            next.resolve(result);
+          } catch (err) {
+            next.reject(err);
+          }
+        }
+      }
+
+      ensureSchedulerSupport();
+
+      // Yield to the main thread periodically with a 50ms budget
+      async function yieldToMainThread() {
+        yieldCount++;
+        statYieldsEl.textContent = String(yieldCount);
+        if ('scheduler' in window && 'yield' in window.scheduler) {
+          await window.scheduler.yield();
+        } else {
+          await new Promise(resolve => setTimeout(resolve, 0));
+        }
+      }
+
+      function updateCounters() {
+        statActiveEl.textContent = String(activeCount);
+        statCompletedEl.textContent = String(completedCount);
+        if (activeCount > 0) {
+          queueBadgeEl.textContent = activeCount + ' Active';
+          queueBadgeEl.className = 'priority-badge badge-user-blocking';
+        } else {
+          queueBadgeEl.textContent = 'Idle';
+          queueBadgeEl.className = 'priority-badge badge-user-visible';
+        }
+      }
+
+      function appendLog(message, priority) {
+        const emptyEl = document.getElementById('log-empty-state');
+        if (emptyEl) {
+          emptyEl.remove();
+        }
+        const li = document.createElement('li');
+        li.className = 'log-entry priority-' + priority;
+        const timeStr = new Date().toLocaleTimeString([], { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
+        li.innerHTML = '<span>[' + timeStr + '] ' + message + '</span>' +
+          '<span class="priority-badge badge-' + priority + '">' + priority + '</span>';
+        logListEl.prepend(li);
+      }
+
+      function createTaskElement(task) {
+        const emptyEl = document.getElementById('tasks-empty-state');
+        if (emptyEl) {
+          emptyEl.remove();
+        }
+        const li = document.createElement('li');
+        li.className = 'task-item';
+        li.id = 'task-item-' + task.id;
+        li.innerHTML =
+          '<div class="task-item-top">' +
+            '<span class="task-name">#' + task.id + ' ' + task.name + '</span>' +
+            '<span class="priority-badge badge-' + task.priority + '">' + task.priority + '</span>' +
+          '</div>' +
+          '<div class="progress-track">' +
+            '<div class="progress-fill" id="progress-' + task.id + '"></div>' +
+          '</div>' +
+          '<div class="task-meta">' +
+            '<span id="status-' + task.id + '">Queued (' + task.category + ')</span>' +
+            '<span id="chunks-' + task.id + '">0 / ' + task.workUnits + ' units</span>' +
+          '</div>';
+        taskListEl.prepend(li);
+        return li;
+      }
+
+      // Perform a simulated long task broken up using a 50ms deadline budget
+      async function executeHeavyWorkWithYielding(task) {
+        const statusEl = document.getElementById('status-' + task.id);
+        const progressEl = document.getElementById('progress-' + task.id);
+        const chunksEl = document.getElementById('chunks-' + task.id);
+
+        if (statusEl) statusEl.textContent = 'Running on main thread...';
+        appendLog('Started #' + task.id + ': ' + task.name, task.priority);
+
+        const startTime = performance.now();
+        // Set a time-based deadline 50 milliseconds into the future
+        let deadline = performance.now() + 50;
+
+        for (let unit = 1; unit <= task.workUnits; unit++) {
+          // Simulate synchronous CPU computation (~4ms per unit)
+          const unitEnd = performance.now() + 4;
+          while (performance.now() < unitEnd) {
+            Math.sqrt(unit * 12345.6789);
+          }
+
+          if (progressEl) {
+            const pct = Math.round((unit / task.workUnits) * 100);
+            progressEl.style.width = pct + '%';
+          }
+          if (chunksEl) {
+            chunksEl.textContent = unit + ' / ' + task.workUnits + ' units';
+          }
+
+          // Yield to the main thread periodically when 50ms budget is exceeded
+          if (performance.now() >= deadline && unit < task.workUnits) {
+            if (statusEl) statusEl.textContent = 'Yielding to keep UI responsive...';
+            await yieldToMainThread();
+            deadline = performance.now() + 50;
+            if (statusEl) statusEl.textContent = 'Running on main thread...';
+          }
+        }
+
+        const duration = Math.round(performance.now() - startTime);
+        if (statusEl) {
+          statusEl.textContent = 'Completed in ' + duration + 'ms';
+        }
+        appendLog('Completed #' + task.id + ': ' + task.name + ' (' + duration + 'ms)', task.priority);
+      }
+
+      function scheduleOperation(config) {
+        const task = {
+          id: ++taskIdCounter,
+          name: config.name,
+          category: config.category,
+          priority: config.priority,
+          workUnits: config.workUnits || 16
+        };
+
+        activeCount++;
+        updateCounters();
+        createTaskElement(task);
+
+        const runTask = async () => {
+          try {
+            await executeHeavyWorkWithYielding(task);
+          } finally {
+            activeCount = Math.max(0, activeCount - 1);
+            completedCount++;
+            updateCounters();
+          }
+        };
+
+        if ('scheduler' in window && 'postTask' in window.scheduler) {
+          if (task.priority === 'user-visible') {
+            // Default priority is 'user-visible'
+            window.scheduler.postTask(runTask);
+          } else {
+            window.scheduler.postTask(runTask, { priority: task.priority });
+          }
+        } else {
+          installLocalSchedulerFallback();
+          window.scheduler.postTask(runTask, { priority: task.priority });
+        }
+      }
+
+      // Button event handlers
+      document.getElementById('btn-urgent-checkout').addEventListener('click', () => {
+        scheduleOperation({
+          name: 'Urgent Checkout Payment & Cart Lock',
+          category: 'Checkout',
+          priority: 'user-blocking',
+          workUnits: 14
+        });
+      });
+
+      document.getElementById('btn-standard-menu').addEventListener('click', () => {
+        scheduleOperation({
+          name: 'Standard Seasonal Menu & Price Sync',
+          category: 'Menu Update',
+          priority: 'user-visible',
+          workUnits: 18
+        });
+      });
+
+      document.getElementById('btn-background-telemetry').addEventListener('click', () => {
+        scheduleOperation({
+          name: 'Background Telemetry & roast metrics log',
+          category: 'Telemetry',
+          priority: 'background',
+          workUnits: 24
+        });
+      });
+
+      document.getElementById('btn-batch-mixed').addEventListener('click', () => {
+        // Queue mixed tasks in reverse/mixed order so priority scheduling reorders execution:
+        // user-blocking runs first, then user-visible, then background
+        const batchConfigs = [
+          {
+            name: 'Batch Telemetry: Espresso Machine Sensors',
+            category: 'Telemetry',
+            priority: 'background',
+            workUnits: 20
+          },
+          {
+            name: 'Batch Menu Update: Inventory Availability',
+            category: 'Menu Update',
+            priority: 'user-visible',
+            workUnits: 16
+          },
+          {
+            name: 'Batch Urgent Checkout: Express Order #402',
+            category: 'Checkout',
+            priority: 'user-blocking',
+            workUnits: 12
+          },
+          {
+            name: 'Batch Telemetry: Foot Traffic Analytics',
+            category: 'Telemetry',
+            priority: 'background',
+            workUnits: 20
+          },
+          {
+            name: 'Batch Menu Update: Pastry Counter Board',
+            category: 'Menu Update',
+            priority: 'user-visible',
+            workUnits: 16
+          },
+          {
+            name: 'Batch Urgent Checkout: Mobile Pickup #403',
+            category: 'Checkout',
+            priority: 'user-blocking',
+            workUnits: 12
+          }
+        ];
+
+        batchConfigs.forEach(cfg => scheduleOperation(cfg));
+      });
+
+      document.getElementById('btn-clear-queue').addEventListener('click', () => {
+        taskListEl.innerHTML = '<li class="empty-state" id="tasks-empty-state">No operations queued. Use the controls above to schedule tasks.</li>';
+        logListEl.innerHTML = '<li class="empty-state" id="log-empty-state">Execution events will appear here in priority order.</li>';
+        completedCount = 0;
+        yieldCount = 0;
+        statCompletedEl.textContent = '0';
+        statYieldsEl.textContent = '0';
+        updateCounters();
+      });
+    })();
+  </script>
