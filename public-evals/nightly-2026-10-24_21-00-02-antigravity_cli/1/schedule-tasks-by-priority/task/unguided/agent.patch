+  <script>
+    (function () {
+      const PRIORITY_WEIGHTS = {
+        'user-blocking': 0,
+        'user-visible': 1,
+        'background': 2
+      };
+
+      const hasNativePostTask =
+        typeof globalThis.scheduler === 'object' &&
+        globalThis.scheduler !== null &&
+        typeof globalThis.scheduler.postTask === 'function';
+
+      const hasNativeYield =
+        typeof globalThis.scheduler === 'object' &&
+        globalThis.scheduler !== null &&
+        typeof globalThis.scheduler.yield === 'function';
+
+      const modeBadge = document.getElementById('scheduler-mode-badge');
+      if (modeBadge) {
+        modeBadge.textContent = hasNativePostTask
+          ? 'API: scheduler.postTask' + (hasNativeYield ? ' + scheduler.yield' : '')
+          : 'API: Priority Queue Fallback';
+      }
+
+      // Fallback priority scheduler if browser lacks native scheduler.postTask
+      const fallbackBuckets = {
+        'user-blocking': [],
+        'user-visible': [],
+        'background': []
+      };
+      let fallbackPumpScheduled = false;
+
+      function scheduleFallbackPump() {
+        if (fallbackPumpScheduled) return;
+        fallbackPumpScheduled = true;
+        const channel = new MessageChannel();
+        channel.port1.onmessage = () => {
+          fallbackPumpScheduled = false;
+          const nextQueue =
+            fallbackBuckets['user-blocking'].length > 0
+              ? fallbackBuckets['user-blocking']
+              : fallbackBuckets['user-visible'].length > 0
+                ? fallbackBuckets['user-visible']
+                : fallbackBuckets['background'];
+
+          if (nextQueue.length > 0) {
+            const job = nextQueue.shift();
+            if (
+              fallbackBuckets['user-blocking'].length > 0 ||
+              fallbackBuckets['user-visible'].length > 0 ||
+              fallbackBuckets['background'].length > 0
+            ) {
+              scheduleFallbackPump();
+            }
+            if (job.signal && job.signal.aborted) {
+              job.reject(new DOMException('Task aborted', 'AbortError'));
+              return;
+            }
+            Promise.resolve()
+              .then(() => job.callback())
+              .then(job.resolve, job.reject);
+          }
+        };
+        channel.port2.postMessage(null);
+      }
+
+      function postPrioritizedTask(callback, options = {}) {
