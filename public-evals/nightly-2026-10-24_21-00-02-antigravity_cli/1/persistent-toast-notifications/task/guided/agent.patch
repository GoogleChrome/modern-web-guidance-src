+    /* Toast Notifications */
+    .toast {
+      position: fixed;
+      inset: auto 1.5rem 1.5rem auto;
+      margin: 0;
+      padding: 0.85rem 1.25rem;
+      background: var(--primary);
+      color: var(--light);
+      border: 1px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      font-size: 0.95rem;
+      font-weight: 500;
+      opacity: 0;
+      transform: translateY(1rem) scale(0.95);
+      transition-property: opacity, transform, bottom, margin-bottom, display, overlay;
+      transition-duration: 0.3s;
+      transition-timing-function: ease-out;
+      transition-behavior: allow-discrete;
+    }
+
+    /* Fallback stacking using sibling combinators when sibling-index() is unsupported */
+    .toast + .toast {
+      margin-bottom: 4rem;
+    }
+    .toast + .toast + .toast {
+      margin-bottom: 8rem;
+    }
+    .toast + .toast + .toast + .toast {
+      margin-bottom: 12rem;
+    }
+    .toast + .toast + .toast + .toast + .toast {
+      margin-bottom: 16rem;
+    }
+
+    /* Dynamic CSS vertical stacking via sibling-index() */
+    @supports (margin-bottom: calc(1rem * sibling-index())) {
+      .toast,
+      .toast + .toast,
+      .toast + .toast + .toast,
+      .toast + .toast + .toast + .toast,
+      .toast + .toast + .toast + .toast + .toast {
+        margin-bottom: calc((sibling-index() - 1) * 4rem);
+      }
+    }
+
+    .toast:not(:is(:popover-open, .\:popover-open)) {
+      display: none;
+    }
+
+    :is(.toast:popover-open, .toast.\:popover-open):where(:not([data-closing])) {
+      opacity: 1;
+      transform: translateY(0) scale(1);
+
+      @starting-style {
+        opacity: 0;
+        transform: translateY(1rem) scale(0.95);
+      }
+    }
+
+    .toast-close {
+      background: transparent;
+      border: none;
+      color: var(--secondary);
+      font-size: 1.25rem;
+      line-height: 1;
+      cursor: pointer;
+      padding: 0.15rem 0.35rem;
+      border-radius: 4px;
+      transition: color 0.2s, background-color 0.2s;
+    }
+
+    .toast-close:hover {
+      color: var(--accent);
+      background-color: rgba(255, 255, 255, 0.1);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transform: none;
+        transition-duration: 0.1s;
+      }
+
+      @starting-style {
+        :is(.toast:popover-open, .toast.\:popover-open):where(:not([data-closing])) {
+          transform: none;
+        }
+      }
+    }
