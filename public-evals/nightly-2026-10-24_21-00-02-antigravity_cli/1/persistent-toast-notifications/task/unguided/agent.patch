+    /* Toast Notification System */
+    .toast {
+      position: fixed;
+      inset: auto 24px 24px auto;
+      margin: 0;
+      padding: 14px 20px;
+      background: var(--primary);
+      color: var(--light);
+      border: 1px solid rgba(255, 255, 255, 0.15);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
+      font-family: inherit;
+      font-size: 0.95rem;
+      font-weight: 500;
+      min-width: 240px;
+
+      /* Dynamic vertical stacking in the top layer via purely CSS sibling selectors */
+      --toast-offset: 0px;
+      --toast-step: 68px;
+      --toast-slide: 24px;
+      translate: 0 calc(var(--toast-offset) + var(--toast-slide));
+      opacity: 0;
+
+      transition:
+        opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1),
+        translate 0.3s cubic-bezier(0.22, 1, 0.36, 1),
+        display 0.3s allow-discrete,
+        overlay 0.3s allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      gap: 16px;
+      opacity: 1;
+      --toast-slide: 0px;
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        --toast-slide: 24px;
+      }
+    }
+
+    .toast.closing {
+      opacity: 0;
+      --toast-slide: 24px;
+      pointer-events: none;
+    }
+
+    /* Pure CSS sibling-based vertical offset for stacked top-layer notifications */
+    .toast:popover-open:has(~ .toast:popover-open) {
+      --toast-offset: calc(-1 * var(--toast-step));
+    }
+
+    .toast:popover-open:has(~ .toast:popover-open ~ .toast:popover-open) {
+      --toast-offset: calc(-2 * var(--toast-step));
+    }
+
+    .toast:popover-open:has(~ .toast:popover-open ~ .toast:popover-open ~ .toast:popover-open) {
+      --toast-offset: calc(-3 * var(--toast-step));
+    }
+
+    .toast:popover-open:has(~ .toast:popover-open ~ .toast:popover-open ~ .toast:popover-open ~ .toast:popover-open) {
+      --toast-offset: calc(-4 * var(--toast-step));
+    }
+
+    .toast:popover-open:has(~ .toast:popover-open ~ .toast:popover-open ~ .toast:popover-open ~ .toast:popover-open ~ .toast:popover-open) {
