+  <script>
+    const TARGET_ZONES = [
+      { label: 'New York', timeZone: 'America/New_York' },
+      { label: 'London', timeZone: 'Europe/London' },
+      { label: 'Tokyo', timeZone: 'Asia/Tokyo' },
+      { label: 'UTC', timeZone: 'UTC' }
+    ];
+
+    function updateSchedule() {
+      if (typeof Temporal === 'undefined') return;
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const timeZone = hostTzSelect.value;
+
+      if (!date || !time || !timeZone) return;
+
+      const inputStr = `${date}T${time}[${timeZone}]`;
+
+      // Detect DST transition gap or overlap conflicts using disambiguation: 'reject'
+      let hasConflict = false;
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          hasConflict = true;
+        }
+      }
+
+      // Resolve the host time safely using disambiguation: 'compatible'
+      const hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+
+      if (hasConflict) {
+        const earlierTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'earlier' });
+        const laterTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'later' });
+        const resolvedFormatted = hostTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+
+        // If 'compatible' matches 'later' (and differs from 'earlier'), the local time fell in a skipped Spring Forward gap.
+        // If 'compatible' matches 'earlier', the local time fell in a repeated Fall Back overlap.
+        const isGap = hostTime.equals(laterTime) && !earlierTime.equals(laterTime);
+
+        if (isGap) {
+          hostWarning.textContent = `Daylight Saving Time Notice: ${time} on ${date} does not exist in ${timeZone} due to a DST spring-forward transition gap. Using 'compatible' disambiguation, the time was resolved forward to ${resolvedFormatted} (${hostTime.offset}).`;
+        } else {
+          hostWarning.textContent = `Daylight Saving Time Notice: ${time} on ${date} is ambiguous in ${timeZone} due to a DST fall-back transition overlap. Using 'compatible' disambiguation, the time was resolved to the first occurrence at ${resolvedFormatted} (${hostTime.offset}).`;
+        }
+        hostWarning.classList.add('visible');
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.classList.remove('visible');
+      }
+
+      // Render target timezone cards using immutable .withTimeZone() conversions
+      grid.innerHTML = '';
+      for (const target of TARGET_ZONES) {
+        const convertedTime = hostTime.withTimeZone(target.timeZone);
+        const formattedTime = convertedTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+        const formattedDate = convertedTime.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+
+        const card = document.createElement('div');
+        card.className = 'card tz-card';
+        card.innerHTML = `
+          <h3>${target.label}</h3>
+          <span class="tz-id">${target.timeZone} (${convertedTime.offset})</span>
+          <div class="tz-time">${formattedTime}</div>
+          <div class="tz-date">${formattedDate}</div>
+        `;
+        grid.appendChild(card);
+      }
+    }
+
+    function initializeApp() {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+
+      [dateInput, timeInput, hostTzSelect].forEach((el) => {
+        el.addEventListener('change', updateSchedule);
+        el.addEventListener('input', updateSchedule);
+      });
+
+      updateSchedule();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
