+  <script>
+    (function () {
+      const TARGET_TIMEZONES = [
+        { id: 'America/New_York', label: 'New York', subtitle: 'Roastery HQ' },
+        { id: 'Europe/London', label: 'London', subtitle: 'European Chapter' },
+        { id: 'Asia/Tokyo', label: 'Tokyo', subtitle: 'Asia-Pacific Chapter' },
+        { id: 'UTC', label: 'UTC', subtitle: 'Universal Reference' }
+      ];
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      function formatLocalTime(zdt) {
+        const plainTime = zdt.toPlainTime();
+        const hour24 = plainTime.hour;
+        const minute = String(plainTime.minute).padStart(2, '0');
+        const period = hour24 >= 12 ? 'PM' : 'AM';
+        const hour12 = hour24 % 12 || 12;
+        return `${hour12}:${minute} ${period}`;
+      }
+
+      function formatLocalDate(zdt) {
+        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+        const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
+        const dayName = days[zdt.dayOfWeek - 1] || '';
+        const monthName = months[zdt.month - 1] || '';
+        return `${dayName}, ${monthName} ${zdt.day}, ${zdt.year}`;
+      }
+
+      function updateSchedule() {
+        const dateStr = dateInput.value;
+        const timeStr = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateStr || !timeStr || !hostTz) {
+          return;
+        }
+
+        if (typeof Temporal === 'undefined') {
+          hostWarning.textContent = 'Notice: The native Temporal API is required to compute timezone-aware tasting schedules.';
+          hostWarning.classList.add('visible');
+          return;
+        }
+
+        const plainDate = Temporal.PlainDate.from(dateStr);
+        const plainTime = Temporal.PlainTime.from(timeStr);
+        const requestedDt = plainDate.toPlainDateTime(plainTime);
+
+        // Compute earlier, later, and compatible ZonedDateTime instances immutably
+        const earlierZdt = requestedDt.toZonedDateTime(hostTz, { disambiguation: 'earlier' });
+        const laterZdt = requestedDt.toZonedDateTime(hostTz, { disambiguation: 'later' });
+        const resolvedHostZdt = requestedDt.toZonedDateTime(hostTz, { disambiguation: 'compatible' });
+
+        // Detect DST gap (non-existent wall-clock time) or overlap (ambiguous wall-clock time)
+        const resolvedPlainDt = resolvedHostZdt.toPlainDateTime();
+        const isGap = !requestedDt.equals(resolvedPlainDt);
+        const isOverlap = !isGap && !earlierZdt.equals(laterZdt);
+
+        if (isGap) {
+          const requestedFormatted = `${timeStr}`;
+          const resolvedFormatted = formatLocalTime(resolvedHostZdt);
+          hostWarning.textContent =
+            `Daylight Saving Time Gap Detected: The selected local time (${requestedFormatted}) does not exist in ${hostTz} due to a forward clock transition (spring-forward gap). Using disambiguation: "compatible", it was automatically resolved forward to ${resolvedFormatted} (${resolvedHostZdt.offset}).`;
+          hostWarning.classList.add('visible');
+        } else if (isOverlap) {
+          const resolvedFormatted = formatLocalTime(resolvedHostZdt);
+          hostWarning.textContent =
+            `Daylight Saving Time Overlap Detected: The selected local time (${resolvedFormatted}) is ambiguous in ${hostTz} because clocks fall back and this time occurs twice (${earlierZdt.offset} and ${laterZdt.offset}). Using disambiguation: "compatible", it was resolved to the first occurrence at offset ${resolvedHostZdt.offset}.`;
+          hostWarning.classList.add('visible');
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.classList.remove('visible');
+        }
+
+        // Render timezone cards using immutable .withTimeZone() conversions
+        grid.innerHTML = '';
+        TARGET_TIMEZONES.forEach((tz) => {
+          const targetZdt = resolvedHostZdt.withTimeZone(tz.id);
+          const isHost = tz.id === hostTz;
+
+          const card = document.createElement('div');
+          card.className = `card tz-card${isHost ? ' is-host' : ''}`;
+          card.setAttribute('data-tz', tz.id);
+
+          const cityEl = document.createElement('h3');
+          cityEl.className = 'tz-city';
+          cityEl.textContent = tz.label;
+
+          const idEl = document.createElement('div');
+          idEl.className = 'tz-id';
+          idEl.textContent = `${tz.subtitle} (${tz.id})`;
+
+          const timeEl = document.createElement('div');
+          timeEl.className = 'tz-time';
+          timeEl.textContent = formatLocalTime(targetZdt);
+
+          const dateEl = document.createElement('div');
+          dateEl.className = 'tz-date';
+          dateEl.textContent = formatLocalDate(targetZdt);
+
+          const offsetEl = document.createElement('span');
+          offsetEl.className = 'tz-offset';
+          offsetEl.textContent = `UTC${targetZdt.offset === '+00:00' ? '' : targetZdt.offset}${isHost ? ' • Host' : ''}`;
+
+          card.appendChild(cityEl);
+          card.appendChild(idEl);
+          card.appendChild(timeEl);
+          card.appendChild(dateEl);
+          card.appendChild(offsetEl);
+
+          grid.appendChild(card);
+        });
+      }
+
+      dateInput.addEventListener('change', updateSchedule);
+      dateInput.addEventListener('input', updateSchedule);
+      timeInput.addEventListener('change', updateSchedule);
+      timeInput.addEventListener('input', updateSchedule);
+      hostTzSelect.addEventListener('change', updateSchedule);
+      hostTzSelect.addEventListener('input', updateSchedule);
+
+      updateSchedule();
+    })();
+  </script>
 </body>
 
