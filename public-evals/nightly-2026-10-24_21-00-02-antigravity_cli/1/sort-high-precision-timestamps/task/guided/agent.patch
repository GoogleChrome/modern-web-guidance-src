+  <script type="module">
+    // Out-of-order batch of coffee order events collected from distributed backend services
+    // with nanosecond-precision ISO 8601 UTC timestamps (including sub-millisecond events).
+    const rawOrderEvents = [
+      {
+        orderId: 'ORD-8842',
+        nodeId: 'barista-dispatch-2',
+        eventType: 'order.barista.queued',
+        details: 'Maple Oat Latte routed to Espresso Bar #2',
+        ts: '2026-10-24T08:15:30.004987654Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        nodeId: 'payment-svc-3',
+        eventType: 'payment.authorized',
+        details: 'Contactless tap authorized ($6.25)',
+        ts: '2026-10-24T08:15:30.004123456Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        nodeId: 'api-gateway-1',
+        eventType: 'order.received',
+        details: 'Mobile order payload validated',
+        ts: '2026-10-24T08:15:30.004120000Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        nodeId: 'notification-svc-1',
+        eventType: 'customer.notified',
+        details: 'Push alert dispatched: Order in progress',
+        ts: '2026-10-24T08:15:30.012450890Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        nodeId: 'inventory-svc-2',
+        eventType: 'inventory.beans.reserved',
+        details: '18g Dark Roast + 240ml Oat Milk allocated',
+        ts: '2026-10-24T08:15:30.004123890Z'
+      },
+      {
+        orderId: 'ORD-8842',
+        nodeId: 'rewards-ledger-1',
+        eventType: 'loyalty.points.accrued',
+        details: '+62 Daily Grind points credited',
+        ts: '2026-10-24T08:15:30.004550120Z'
+      }
+    ];
+
+    async function ensureTemporalSupport() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/temporal-polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+    }
+
+    // 1. Parse recorded timestamps as Temporal.Instant to preserve full nanosecond precision
+    function parseOrderEvents(rawEvents) {
+      return rawEvents.map(evt => ({
+        ...evt,
+        timestamp: Temporal.Instant.from(evt.ts)
+      }));
+    }
+
+    // 2. Sort chronologically using Temporal.Instant.compare()
+    function sequenceEvents(items) {
+      return [...items].sort((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+    }
+
+    // 3. Calculate intervals between consecutive events with Instant.prototype.since()
+    function analyzeOrderTrace(sortedEvents) {
+      return sortedEvents.map((curr, index) => {
+        if (index === 0) {
+          return {
+            ...curr,
+            isoTimestamp: curr.timestamp.toString(),
+            duration: null,
+            formattedInterval: '— (Initial event)'
+          };
+        }
+
+        const prev = sortedEvents[index - 1];
+        const isSimultaneous = curr.timestamp.equals(prev.timestamp);
+        const gap = curr.timestamp.since(prev.timestamp);
+        const formattedInterval = isSimultaneous
+          ? '0ns'
+          : `+${gap.toLocaleString('en-US', { style: 'narrow' })}`;
+
+        return {
+          ...curr,
+          isoTimestamp: curr.timestamp.toString(),
+          prevEventType: prev.eventType,
+          duration: gap,
+          formattedInterval
+        };
+      });
+    }
+
+    function renderOrderEvents(analyzedEvents) {
+      const tbody = document.getElementById('events-table-body');
+      const summaryList = document.getElementById('interval-summary-list');
+      const resultsContainer = document.getElementById('events-results');
+      const statusEl = document.getElementById('events-status');
+
+      tbody.replaceChildren();
+      summaryList.replaceChildren();
+
+      analyzedEvents.forEach((evt, idx) => {
+        const tr = document.createElement('tr');
+
+        const seqTd = document.createElement('td');
+        seqTd.textContent = String(idx + 1);
+
+        const orderTd = document.createElement('td');
+        const orderCode = document.createElement('code');
+        orderCode.textContent = evt.orderId;
+        orderTd.appendChild(orderCode);
+
+        const nodeTd = document.createElement('td');
+        const nodeBadge = document.createElement('span');
+        nodeBadge.className = 'badge-service';
+        nodeBadge.textContent = evt.nodeId;
+        nodeTd.appendChild(nodeBadge);
+
+        const typeTd = document.createElement('td');
+        const typeCode = document.createElement('code');
+        typeCode.textContent = evt.eventType;
+        typeTd.appendChild(typeCode);
+
+        const detailsTd = document.createElement('td');
+        detailsTd.textContent = evt.details;
+
+        const tsTd = document.createElement('td');
+        const tsCode = document.createElement('code');
+        tsCode.textContent = evt.isoTimestamp;
+        tsTd.appendChild(tsCode);
+
+        const intervalTd = document.createElement('td');
+        const intervalSpan = document.createElement('span');
+        intervalSpan.className = 'interval-pill';
+        intervalSpan.textContent = evt.formattedInterval;
+        intervalTd.appendChild(intervalSpan);
+
+        tr.append(seqTd, orderTd, nodeTd, typeTd, detailsTd, tsTd, intervalTd);
+        tbody.appendChild(tr);
+
+        if (idx > 0) {
+          const li = document.createElement('li');
+          li.textContent = `${evt.prevEventType} → ${evt.eventType}: ${evt.duration.toLocaleString('en-US', { style: 'narrow' })}`;
+          summaryList.appendChild(li);
+        }
+      });
+
+      statusEl.textContent = `Loaded and sorted ${analyzedEvents.length} distributed events with full nanosecond precision.`;
+      resultsContainer.hidden = false;
+    }
+
+    function initializeApp() {
+      const loadBtn = document.getElementById('load-order-events-btn');
+      loadBtn.addEventListener('click', () => {
+        const parsed = parseOrderEvents(rawOrderEvents);
+        const sorted = sequenceEvents(parsed);
+        const analyzed = analyzeOrderTrace(sorted);
+        renderOrderEvents(analyzed);
+      });
+    }
+
+    (async () => {
+      await ensureTemporalSupport();
+      initializeApp();
+    })();
+  </script>
 </body>
 
