+    /**
+     * Format a Temporal.Duration into a human-readable sub-millisecond breakdown
+     * alongside its exact ISO 8601 duration string and total nanoseconds.
+     */
+    function formatInterval(duration, diffNanoseconds) {
+      const balanced = duration.round({ largestUnit: 'second', smallestUnit: 'nanosecond' });
+      const parts = [];
+      if (balanced.seconds > 0) parts.push(`${balanced.seconds}s`);
+      if (balanced.milliseconds > 0) parts.push(`${balanced.milliseconds}ms`);
+      if (balanced.microseconds > 0) parts.push(`${balanced.microseconds}µs`);
+      if (balanced.nanoseconds > 0 || parts.length === 0) parts.push(`${balanced.nanoseconds}ns`);
+
+      return {
+        human: `+${parts.join(' ')}`,
+        iso: balanced.toString(),
+        totalNs: `${diffNanoseconds.toString()} ns`
+      };
+    }
+
+    /**
+     * Ingests a batch of out-of-order coffee order events, parses nanosecond UTC
+     * timestamps via Temporal.Instant, sorts them chronologically without losing
+     * sub-millisecond precision, and computes consecutive intervals.
+     */
+    function processOrderEvents(rawEvents) {
+      const parsed = rawEvents.map((event, ingestionIndex) => {
+        const instant = Temporal.Instant.from(event.timestamp);
+        return {
+          ...event,
+          ingestionIndex: ingestionIndex + 1,
+          instant,
+          epochNanoseconds: instant.epochNanoseconds,
+          utcTimestamp: instant.toString()
+        };
+      });
+
+      const sorted = [...parsed].sort((a, b) =>
+        Temporal.Instant.compare(a.instant, b.instant)
+      );
+
+      return sorted.map((event, index) => {
+        if (index === 0) {
+          return {
+            ...event,
+            chronologicalOrder: 1,
+            interval: null,
+            intervalNs: 0n
+          };
+        }
+
+        const prev = sorted[index - 1];
+        const duration = prev.instant.until(event.instant, {
+          largestUnit: 'second',
+          smallestUnit: 'nanosecond'
+        });
+        const diffNs = event.epochNanoseconds - prev.epochNanoseconds;
+
+        return {
+          ...event,
+          chronologicalOrder: index + 1,
+          interval: formatInterval(duration, diffNs),
+          intervalNs: diffNs
+        };
+      });
+    }
+
+    function renderOrderEvents() {
+      const processed = processOrderEvents(RAW_ORDER_EVENTS);
+      const summaryEl = document.getElementById('events-summary');
+      const outputEl = document.getElementById('events-output');
+
+      const firstInstant = processed[0].instant;
+      const lastInstant = processed[processed.length - 1].instant;
+      const totalSpanDuration = firstInstant.until(lastInstant, {
+        largestUnit: 'second',
+        smallestUnit: 'nanosecond'
+      });
+      const totalSpanNs = lastInstant.epochNanoseconds - firstInstant.epochNanoseconds;
+      const totalSpanFormatted = formatInterval(totalSpanDuration, totalSpanNs);
+
+      let minIntervalNs = null;
+      for (let i = 1; i < processed.length; i++) {
+        if (minIntervalNs === null || processed[i].intervalNs < minIntervalNs) {
+          minIntervalNs = processed[i].intervalNs;
+        }
+      }
+
+      summaryEl.hidden = false;
+      summaryEl.innerHTML = `
+        <div class="summary-metric">
+          <span class="label">Events Reconciled</span>
+          <span class="value">${processed.length} events</span>
+        </div>
+        <div class="summary-metric">
+          <span class="label">Earliest Event (UTC)</span>
+          <span class="value">${firstInstant.toString()}</span>
+        </div>
+        <div class="summary-metric">
+          <span class="label">Total Batch Span</span>
+          <span class="value">${totalSpanFormatted.human} (${totalSpanFormatted.iso})</span>
+        </div>
+        <div class="summary-metric">
+          <span class="label">Shortest Sub-ms Gap</span>
+          <span class="value">${minIntervalNs.toString()} ns</span>
+        </div>
+      `;
+
+      const rowsHtml = processed
