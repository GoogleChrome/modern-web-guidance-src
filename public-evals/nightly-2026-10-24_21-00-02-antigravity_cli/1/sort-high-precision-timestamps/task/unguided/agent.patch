+               <div class="mono" style="color: #6d4c41; margin-top: 2px;">${evt.interval.totalNs} (${evt.interval.iso})</div>`
+            : `<span class="badge">Initial Event (0 ns)</span>`;
+
+          return `
+            <tr data-event-id="${evt.eventId}" data-epoch-ns="${evt.epochNanoseconds.toString()}">
+              <td><strong>#${evt.chronologicalOrder}</strong> <span style="color:#8d6e63;font-size:0.8rem;">(was #${evt.ingestionIndex})</span></td>
+              <td>
+                <div><strong>${evt.orderId}</strong> &mdash; ${evt.item}</div>
+                <div style="font-size: 0.82rem; color: #5d4037;">${evt.stage}</div>
