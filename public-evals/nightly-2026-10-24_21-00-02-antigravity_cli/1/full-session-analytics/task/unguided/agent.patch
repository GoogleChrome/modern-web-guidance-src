+  <script type="module">
+    import { onCLS, onINP, onLCP } from 'web-vitals';
+
+    const queue = new Set();
+    let fetchLaterController;
+    let fetchLaterResult;
+
+    function updateQueue(metric) {
+      // If a previous fetchLater was already activated/sent, clear the queue
+      if (fetchLaterResult?.activated) {
+        queue.clear();
+      }
+      queue.add(metric);
+
+      const body = JSON.stringify([...queue]);
+
+      // Abort any existing pending fetchLater request and schedule a new one
+      // with the updated metrics payload
+      fetchLaterController?.abort();
+      fetchLaterController = new AbortController();
+
+      if ('fetchLater' in window) {
+        fetchLaterResult = fetchLater('/path/to/analytics/endpoint', {
+          method: 'POST',
+          body,
+          signal: fetchLaterController.signal,
+        });
+      }
+    }
+
+    onCLS(updateQueue, { reportAllChanges: true });
+    onINP(updateQueue, { reportAllChanges: true });
+    onLCP(updateQueue, { reportAllChanges: true });
+
+    // Fallback for browsers that do not support fetchLater()
+    if (!('fetchLater' in window)) {
+      addEventListener('visibilitychange', () => {
+        if (document.visibilityState === 'hidden' && queue.size > 0) {
+          const body = JSON.stringify([...queue]);
+          navigator.sendBeacon('/path/to/analytics/endpoint', body);
+          queue.clear();
+        }
+      });
+    }
+  </script>
