+  <script>
+    (function () {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      if (!widget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let currentTemp = 385;
+      let tempDirection = 1;
+
+      const beans = Array.from({ length: 28 }, (_, i) => ({
+        x: 60 + ((i * 27) % (canvas.width - 120)),
+        y: 40 + ((i * 43) % (canvas.height - 80)),
+        vx: (i % 2 === 0 ? 1 : -1) * (1.2 + (i % 5) * 0.35),
+        vy: (i % 3 === 0 ? -1 : 1) * (1.0 + (i % 4) * 0.3),
+        angle: (i * 0.45) % (Math.PI * 2),
+        spin: (i % 2 === 0 ? 1 : -1) * 0.035,
+        rx: 12 + (i % 3) * 2,
+        ry: 8 + (i % 2) * 1.5
+      }));
+
+      function drawBeans() {
+        if (!ctx) return;
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+
+        const roastRatio = Math.min(1, Math.max(0, (currentTemp - 370) / 75));
+        const r = Math.round(138 - roastRatio * 72);
+        const g = Math.round(92 - roastRatio * 56);
+        const b = Math.round(52 - roastRatio * 34);
+        const beanColor = `rgb(${r}, ${g}, ${b})`;
+
+        for (const bean of beans) {
+          bean.x += bean.vx;
+          bean.y += bean.vy;
+          bean.angle += bean.spin;
+
+          if (bean.x < bean.rx + 10 || bean.x > canvas.width - bean.rx - 10) {
+            bean.vx *= -1;
+          }
+          if (bean.y < bean.ry + 10 || bean.y > canvas.height - bean.ry - 10) {
+            bean.vy *= -1;
+          }
+
+          ctx.save();
+          ctx.translate(bean.x, bean.y);
+          ctx.rotate(bean.angle);
+
+          ctx.beginPath();
+          ctx.ellipse(0, 0, bean.rx, bean.ry, 0, 0, Math.PI * 2);
+          ctx.fillStyle = beanColor;
+          ctx.fill();
+          ctx.lineWidth = 1.5;
+          ctx.strokeStyle = '#24120b';
+          ctx.stroke();
+
+          ctx.beginPath();
+          ctx.moveTo(-bean.rx * 0.7, 0);
+          ctx.quadraticCurveTo(0, bean.ry * 0.35, bean.rx * 0.7, 0);
+          ctx.strokeStyle = '#1a0c07';
+          ctx.lineWidth = 1.5;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+      }
+
+      function animate() {
+        drawBeans();
+        animationFrameId = requestAnimationFrame(animate);
+      }
+
+      function updateTemperature() {
+        currentTemp += tempDirection * (1 + Math.floor(Math.random() * 2));
+        if (currentTemp >= 435) {
+          currentTemp = 435;
+          tempDirection = -1;
+        } else if (currentTemp <= 380) {
+          currentTemp = 380;
+          tempDirection = 1;
+        }
+        tempValueEl.textContent = `${currentTemp}°F`;
+      }
+
+      function startSimulation() {
+        if (animationFrameId === null) {
+          animationFrameId = requestAnimationFrame(animate);
+        }
+        if (tempIntervalId === null) {
+          tempIntervalId = setInterval(updateTemperature, 500);
+        }
+      }
+
+      function stopSimulation() {
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      startSimulation();
+
+      widget.addEventListener('contentvisibilityautostatechange', (event) => {
+        if (event.skipped) {
+          stopSimulation();
+        } else {
+          startSimulation();
+        }
+      });
+
+      const isSupported = 'contentVisibility' in document.documentElement.style;
+
+      if (!isSupported) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              startSimulation();
+            } else {
+              stopSimulation();
+            }
+          });
+        }, {
+          rootMargin: '200px'
+        });
+
+        observer.observe(widget);
+      }
+    })();
+  </script>
 </body>
 
