+  <script type="module">
+    // Feature detect Popover API and conditionally load polyfill
+    if (!('popover' in HTMLElement.prototype)) {
+      import('https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js').catch(() => {});
+    }
+
+    // Feature detect Invoker Commands API and conditionally load polyfill
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+    }
+
+    const dialog = document.getElementById('logout-dialog');
+    const openDialogBtn = document.getElementById('open-dialog-btn');
+    const closeDialogBtn = document.getElementById('close-dialog-btn');
+    const foobarBtn = document.getElementById('foobar');
+    const infoOverlay = document.getElementById('info-overlay');
+    const closeOverlayBtn = document.getElementById('close-overlay-btn');
+
+    // Probe discrete display transition support (guards against Firefox bug 1882408)
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    function supportsTopLayerExit() {
+      return window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay();
+    }
+
+    async function closeTopLayer(element) {
+      if (!supportsTopLayerExit()) {
+        element.setAttribute('data-closing', '');
+        const animations = element.getAnimations({ subtree: true });
+        if (animations.length > 0) {
+          await Promise.race([
+            Promise.allSettled(animations.map((a) => a.finished)),
+            new Promise((r) => setTimeout(r, 2000)),
+          ]);
+        }
+        if (!element.hasAttribute('data-closing')) return;
+        element.removeAttribute('data-closing');
+      }
+
+      if (typeof element.close === 'function' && element.open) {
+        element.close();
+      } else if (typeof element.hidePopover === 'function') {
+        element.hidePopover();
+      }
+    }
+
+    // Intercept logout link click to open confirmation modal
+    openDialogBtn.addEventListener('click', (event) => {
+      event.preventDefault();
+      dialog.removeAttribute('data-closing');
+      if (!dialog.open) {
+        dialog.showModal();
+      }
+    });
+
+    // Close button handler using animated exit helper
+    closeDialogBtn.addEventListener('click', (event) => {
+      if (!supportsTopLayerExit()) {
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        closeTopLayer(dialog);
+      }
+    });
+
+    // Route native dialog cancel (Esc / closedby) through top-layer exit helper
+    dialog.addEventListener('cancel', (event) => {
+      if (!supportsTopLayerExit()) {
+        event.preventDefault();
+        closeTopLayer(dialog);
+      }
+    });
+
+    // Fallback for browsers without <dialog closedby> support
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      dialog.addEventListener('click', (event) => {
+        if (event.target !== dialog) return;
+        const rect = dialog.getBoundingClientRect();
+        const isDialogContent = (
+          rect.top <= event.clientY &&
+          event.clientY <= rect.top + rect.height &&
+          rect.left <= event.clientX &&
+          event.clientX <= rect.left + rect.width
+        );
+        if (isDialogContent) return;
+        closeTopLayer(dialog);
+      });
+    }
+
+    // Ensure explicit popover close control also uses top-layer exit fallback when needed
+    closeOverlayBtn.addEventListener('click', (event) => {
+      if (!supportsTopLayerExit()) {
+        event.preventDefault();
+        event.stopImmediatePropagation();
+        closeTopLayer(infoOverlay);
+      }
+    });
+  </script>
