+  <!-- Logout Confirmation Modal -->
+  <dialog id="logout-dialog" closedby="any" aria-labelledby="logout-dialog-title">
+    <h2 id="logout-dialog-title">Confirm Logout</h2>
+    <p>Are you sure you want to log out of your account?</p>
+    <div class="modal-actions">
+      <button type="button" id="close-dialog-btn" class="btn btn-secondary" commandfor="logout-dialog" command="close">Cancel</button>
+      <a href="/logout" class="btn">Confirm Logout</a>
+    </div>
+  </dialog>
+
+  <!-- Dismissible Informational Floating Overlay -->
+  <div id="info-overlay" popover="auto" role="status" aria-live="polite">
+    <div class="overlay-header">
+      <h3>Notice</h3>
+      <button type="button" id="close-overlay-btn" class="overlay-dismiss" commandfor="info-overlay" command="hide-popover" popovertarget="info-overlay" popovertargetaction="hide" aria-label="Dismiss notification">&times;</button>
+    </div>
+    <p>online ordering is currently offline</p>
+  </div>
