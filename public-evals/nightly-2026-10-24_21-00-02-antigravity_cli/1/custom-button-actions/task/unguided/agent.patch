+  <script>
+    const actionTarget = document.getElementById('action-target');
+
+    actionTarget.addEventListener('command', (event) => {
+      switch (event.command) {
+        case '--spin':
+          actionTarget.classList.toggle('is-spun');
+          break;
+        case '--grow':
+          actionTarget.classList.toggle('is-grown');
+          break;
+        case '--round':
+          actionTarget.classList.toggle('is-rounded');
+          break;
+        case '--reset':
+          actionTarget.classList.remove('is-spun', 'is-grown', 'is-rounded');
+          break;
+      }
+    });
+
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      document.addEventListener('click', (event) => {
+        const button = event.target.closest('button[commandfor][command]');
+        if (!button || event.defaultPrevented) return;
+        const target = document.getElementById(button.getAttribute('commandfor'));
+        const command = button.getAttribute('command');
+        if (target && command && command.startsWith('--')) {
+          const commandEvent = new Event('command', { bubbles: false, cancelable: true });
+          commandEvent.command = command;
+          commandEvent.source = button;
+          target.dispatchEvent(commandEvent);
+        }
+      });
+    }
+  </script>
