diff --git a/app.js b/app.js
new file mode 100644
index 0000000..4b9f40e
--- /dev/null
+++ b/app.js
@@ -0,0 +1,450 @@
+import {
+  ML_DSA_PUBLIC_KEY_ALGORITHMS,
+  DOMAIN_CONTEXTS,
+  supportsPostQuantumSignatures,
+  generateSigningKeyPair,
+  getPublicKeyFromPrivateKey,
+  exportPrivateKeySeedOrPkcs8,
+  importPrivateKeySeedOrPkcs8,
+  importPublicKeyBytes,
+  signPayload,
+  verifyPayload,
+  bytesToBase64Url,
+  base64UrlToBytes,
+  bytesToHex,
+} from './crypto-signing.js';
+
+// State held in memory for active key pair and signed artifacts
+let activeKeyInfo = null;
+let latestSignedArtifact = null;
+
+const KEY_SIZES_INFO = {
+  'ML-DSA-44': { pubBytes: 1312, sigBytes: 2420, label: 'ML-DSA-44 (NIST Category 2, ~128-bit PQ)' },
+  'ML-DSA-65': { pubBytes: 1952, sigBytes: 3309, label: 'ML-DSA-65 (NIST Category 3, ~192-bit PQ Default)' },
+  'ML-DSA-87': { pubBytes: 2592, sigBytes: 4627, label: 'ML-DSA-87 (NIST Category 5, ~256-bit PQ)' },
+  Ed25519: { pubBytes: 32, sigBytes: 64, label: 'Ed25519 (Classical Fallback)' },
+};
+
+function setStatusBanner(element, state, titleText, detailText) {
+  if (!element) return;
+  element.className = `verification-banner status-${state}`;
+  element.textContent = '';
+
+  const badge = document.createElement('strong');
+  badge.className = 'status-title';
+  badge.textContent = titleText;
+
+  const detail = document.createElement('span');
+  detail.className = 'status-detail';
+  detail.textContent = detailText;
+
+  element.append(badge, detail);
+}
+
+async function initSigningSystem() {
+  const pqSupported = supportsPostQuantumSignatures('ML-DSA-65');
+  const pqBadge = document.getElementById('pq-support-badge');
+  if (pqBadge) {
+    pqBadge.textContent = pqSupported
+      ? 'Post-Quantum Ready (SubtleCrypto.supports ML-DSA-65)'
+      : 'Classical Fallback Active (Ed25519 — ML-DSA unavailable)';
+    pqBadge.className = pqSupported ? 'badge badge-pq' : 'badge badge-classical';
+  }
+
+  await rotateActiveKey('auto');
+}
+
+async function rotateActiveKey(preferredSuite = 'auto') {
+  const extractableToggle = document.getElementById('extractable-seed-toggle');
+  const extractable = Boolean(extractableToggle?.checked);
+
+  activeKeyInfo = await generateSigningKeyPair({
+    preferredSuite,
+    extractable,
+  });
+
+  renderKeyStatus();
+  return activeKeyInfo;
+}
+
+function renderKeyStatus() {
+  if (!activeKeyInfo) return;
+
+  const suiteEl = document.getElementById('active-key-suite');
+  const formatEl = document.getElementById('active-key-format');
+  const sizeEl = document.getElementById('active-key-size');
+  const fingerprintEl = document.getElementById('active-key-fingerprint');
+  const pubKeyInput = document.getElementById('active-public-key-b64');
+
+  const meta = KEY_SIZES_INFO[activeKeyInfo.suite] || {
+    pubBytes: activeKeyInfo.publicKeyBytes.byteLength,
+    sigBytes: 'variable',
+    label: activeKeyInfo.suite,
+  };
+
+  if (suiteEl) suiteEl.textContent = meta.label;
+  if (formatEl) formatEl.textContent = `'${activeKeyInfo.keyFormat}'`;
+  if (sizeEl) {
+    sizeEl.textContent = `${activeKeyInfo.publicKeyBytes.byteLength} bytes public key / ~${meta.sigBytes} bytes signature`;
+  }
+  if (fingerprintEl) {
+    fingerprintEl.textContent = bytesToHex(activeKeyInfo.publicKeyBytes, 16);
+  }
+  if (pubKeyInput) {
+    pubKeyInput.value = bytesToBase64Url(activeKeyInfo.publicKeyBytes);
+  }
+}
+
+function buildCanonicalReceiptPayload(formData) {
+  const itemPrices = {
+    'Maple Oat Latte': 5.75,
+    'Dark Roast Espresso': 3.5,
+    'Cold Brew': 4.75,
+    'Cardamom Cortado': 5.25,
+    'Ethiopian Pour-Over': 6.0,
+  };
+  const item = formData.get('item') || 'Maple Oat Latte';
+  const quantity = Number.parseInt(formData.get('quantity') || '1', 10) || 1;
+  const unitPrice = itemPrices[item] ?? 5.0;
+  const totalUsd = Number((unitPrice * quantity).toFixed(2));
+
+  return {
+    type: 'coffee-order-receipt',
+    version: 1,
+    issuer: 'The Daily Grind Coffee Co.',
+    orderId: (formData.get('orderId') || `DG-ORD-${Date.now().toString(36).toUpperCase()}`).trim(),
+    customerName: (formData.get('customerName') || 'Alex Rivera').trim(),
+    item,
+    size: formData.get('size') || '12oz Regular',
+    quantity,
+    totalUsd,
+    roastBatch: (formData.get('roastBatch') || 'BATCH-2026-10-VT').trim(),
+    issuedAt: new Date().toISOString(),
+  };
+}
+
+function buildCanonicalVoucherPayload(formData) {
+  const amountUsd = Number.parseFloat(formData.get('amountUsd') || '25') || 25;
+  return {
+    type: 'gift-voucher',
+    version: 1,
+    issuer: 'The Daily Grind Coffee Co.',
+    voucherCode: (formData.get('voucherCode') || `DG-GIFT-${Date.now().toString(36).toUpperCase()}`).trim(),
+    recipientName: (formData.get('recipientName') || 'Jordan Taylor').trim(),
+    senderName: (formData.get('senderName') || 'Sam Chen').trim(),
+    amountUsd: Number(amountUsd.toFixed(2)),
+    message: (formData.get('message') || 'Enjoy a warm cup on me!').trim(),
+    expiresOn: formData.get('expiresOn') || '2027-12-31',
+    issuedAt: new Date().toISOString(),
+  };
+}
+
+async function createSignedBundle(payloadObj, domainContextString) {
+  if (!activeKeyInfo) {
+    await rotateActiveKey('auto');
+  }
+
+  const canonicalPayload = JSON.stringify(payloadObj, null, 2);
+  const payloadBytes = new TextEncoder().encode(canonicalPayload);
+  const contextBytes = new TextEncoder().encode(domainContextString);
+
+  const signatureBytes = await signPayload(
+    activeKeyInfo.keyPair.privateKey,
+    payloadBytes,
+    contextBytes,
+  );
+
+  const bundle = {
+    suite: activeKeyInfo.suite,
+    keyFormat: activeKeyInfo.keyFormat,
+    context: domainContextString,
+    publicKey: bytesToBase64Url(activeKeyInfo.publicKeyBytes),
+    publicKeyByteLength: activeKeyInfo.publicKeyBytes.byteLength,
+    signature: bytesToBase64Url(signatureBytes),
+    signatureByteLength: signatureBytes.byteLength,
+    payload: payloadObj,
+    canonicalPayload,
+  };
+
+  latestSignedArtifact = bundle;
+  populateVerifierWithBundle(bundle);
+  renderArtifactPreview(bundle);
+  return bundle;
+}
+
+function renderArtifactPreview(bundle) {
+  const previewCard = document.getElementById('signed-artifact-preview');
+  if (!previewCard) return;
+
+  const isVoucher = bundle.payload.type === 'gift-voucher';
+  const badgeEl = document.getElementById('artifact-preview-badge');
+  const titleEl = document.getElementById('artifact-preview-title');
+  const metaEl = document.getElementById('artifact-preview-meta');
+  const summaryEl = document.getElementById('artifact-preview-summary');
+
+  if (badgeEl) {
+    badgeEl.textContent = `${bundle.suite} • Context: ${bundle.context}`;
+  }
+  if (titleEl) {
+    titleEl.textContent = isVoucher
+      ? `Gift Voucher ${bundle.payload.voucherCode} ($${bundle.payload.amountUsd.toFixed(2)})`
+      : `Order Receipt ${bundle.payload.orderId} ($${bundle.payload.totalUsd.toFixed(2)})`;
+  }
+  if (metaEl) {
+    metaEl.textContent = `Public Key (${bundle.keyFormat}): ${bundle.publicKeyByteLength} B | Signature: ${bundle.signatureByteLength} B`;
+  }
+  if (summaryEl) {
+    summaryEl.textContent = isVoucher
+      ? `For ${bundle.payload.recipientName} from ${bundle.payload.senderName} — "${bundle.payload.message}" (Expires ${bundle.payload.expiresOn})`
+      : `${bundle.payload.quantity}x ${bundle.payload.size} ${bundle.payload.item} for ${bundle.payload.customerName} (Batch ${bundle.payload.roastBatch})`;
+  }
+}
+
+function populateVerifierWithBundle(bundle) {
+  const payloadTextarea = document.getElementById('verify-payload-input');
+  const contextSelect = document.getElementById('verify-context-input');
+  const publicKeyTextarea = document.getElementById('verify-public-key-input');
+  const signatureTextarea = document.getElementById('verify-signature-input');
+  const bundleJsonTextarea = document.getElementById('signed-bundle-json');
+
+  if (payloadTextarea) payloadTextarea.value = bundle.canonicalPayload;
+  if (contextSelect) contextSelect.value = bundle.context;
+  if (publicKeyTextarea) publicKeyTextarea.value = bundle.publicKey;
+  if (signatureTextarea) signatureTextarea.value = bundle.signature;
+  if (bundleJsonTextarea) {
+    bundleJsonTextarea.value = JSON.stringify(
+      {
+        suite: bundle.suite,
+        keyFormat: bundle.keyFormat,
+        context: bundle.context,
+        publicKey: bundle.publicKey,
+        signature: bundle.signature,
+        payload: bundle.payload,
+      },
+      null,
+      2,
+    );
+  }
+}
+
+async function runVerificationFromInputs() {
+  const banner = document.getElementById('verification-result-banner');
+  const payloadTextarea = document.getElementById('verify-payload-input');
+  const contextInput = document.getElementById('verify-context-input');
+  const publicKeyTextarea = document.getElementById('verify-public-key-input');
+  const signatureTextarea = document.getElementById('verify-signature-input');
+
+  try {
+    const rawPayloadText = payloadTextarea?.value ?? '';
+    const contextString = (contextInput?.value ?? '').trim();
+    const pubKeyB64 = (publicKeyTextarea?.value ?? '').trim();
+    const sigB64 = (signatureTextarea?.value ?? '').trim();
+
+    if (!rawPayloadText || !pubKeyB64 || !sigB64) {
+      setStatusBanner(
+        banner,
+        'warning',
+        'Missing Verification Inputs',
+        'Sign a coffee order receipt or gift voucher first, or paste a signed bundle below.',
+      );
+      return false;
+    }
+
+    const publicKeyBytes = base64UrlToBytes(pubKeyB64);
+    const signatureBytes = base64UrlToBytes(sigB64);
+    const payloadBytes = new TextEncoder().encode(rawPayloadText);
+    const contextBytes = new TextEncoder().encode(contextString);
+
+    const detectedSuite =
+      ML_DSA_PUBLIC_KEY_ALGORITHMS[publicKeyBytes.byteLength] || 'Ed25519';
+
+    const isValid = await verifyPayload(
+      publicKeyBytes,
+      signatureBytes,
+      payloadBytes,
+      contextBytes,
+    );
+
+    if (isValid) {
+      let parsedType = 'Artifact';
+      try {
+        const parsed = JSON.parse(rawPayloadText);
+        parsedType =
+          parsed.type === 'gift-voucher'
+            ? `Gift Voucher (${parsed.voucherCode || 'Valid'})`
+            : `Order Receipt (${parsed.orderId || 'Valid'})`;
+      } catch {
+        // Keep generic label if payload is plain text
+      }
+      setStatusBanner(
+        banner,
+        'valid',
+        `Authentic & Untampered ${parsedType}`,
+        `Verified with ${detectedSuite} (${publicKeyBytes.byteLength}B public key, ${signatureBytes.byteLength}B signature, context "${contextString}").`,
+      );
+    } else {
+      setStatusBanner(
+        banner,
+        'invalid',
+        'Verification Failed — Signature or Context Mismatch',
+        `The payload, signature, or domain-separation context ("${contextString}") did not pass ${detectedSuite} cryptographic verification.`,
+      );
+    }
+    return isValid;
+  } catch (err) {
+    setStatusBanner(
+      banner,
+      'invalid',
+      'Cryptographic Verification Error',
+      err?.message || String(err),
+    );
+    return false;
+  }
+}
+
+function wireUpEventListeners() {
+  const suiteSelector = document.getElementById('suite-selector');
+  const rotateKeyBtn = document.getElementById('rotate-key-btn');
+  const exportSeedBtn = document.getElementById('export-seed-btn');
+  const seedOutput = document.getElementById('exported-seed-output');
+
+  rotateKeyBtn?.addEventListener('click', async () => {
+    const preferred = suiteSelector?.value || 'auto';
+    await rotateActiveKey(preferred);
+    if (seedOutput) {
+      seedOutput.textContent = '';
+      seedOutput.hidden = true;
+    }
+  });
+
+  suiteSelector?.addEventListener('change', async () => {
+    await rotateActiveKey(suiteSelector.value);
+  });
+
+  exportSeedBtn?.addEventListener('click', async () => {
+    if (!seedOutput || !activeKeyInfo) return;
+    try {
+      const exported = await exportPrivateKeySeedOrPkcs8(activeKeyInfo.keyPair.privateKey);
+      const reimported = await importPrivateKeySeedOrPkcs8(
+        exported.bytes,
+        exported.algorithm,
+        false,
+      );
+      let derivedPubInfo = '';
+      if (typeof crypto.subtle.getPublicKey === 'function') {
+        const derivedPub = await getPublicKeyFromPrivateKey(reimported);
+        derivedPubInfo = ` | getPublicKey() verified (${derivedPub.algorithm.name})`;
+      }
+      seedOutput.hidden = false;
+      seedOutput.textContent = `Exported '${exported.format}' (${exported.bytes.byteLength} bytes): ${bytesToBase64Url(exported.bytes)}${derivedPubInfo}`;
+    } catch (err) {
+      seedOutput.hidden = false;
+      seedOutput.textContent = `Private key is non-extractable by default. Enable "Allow 'raw-seed' export" and rotate key first. (${err.message})`;
+    }
+  });
+
+  // Order Receipt Form
+  const receiptForm = document.getElementById('receipt-signing-form');
+  receiptForm?.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const formData = new FormData(receiptForm);
+    const payload = buildCanonicalReceiptPayload(formData);
+    await createSignedBundle(payload, DOMAIN_CONTEXTS.receipt);
+    await runVerificationFromInputs();
+  });
+
+  // Gift Voucher Form
+  const voucherForm = document.getElementById('voucher-signing-form');
+  voucherForm?.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    const formData = new FormData(voucherForm);
+    const payload = buildCanonicalVoucherPayload(formData);
+    await createSignedBundle(payload, DOMAIN_CONTEXTS.voucher);
+    await runVerificationFromInputs();
+  });
+
+  // Verification Form & Tamper Simulation Buttons
+  const verifyForm = document.getElementById('artifact-verify-form');
+  verifyForm?.addEventListener('submit', async (event) => {
+    event.preventDefault();
+    await runVerificationFromInputs();
+  });
+
+  const tamperAmountBtn = document.getElementById('tamper-payload-btn');
+  tamperAmountBtn?.addEventListener('click', async () => {
+    const payloadTextarea = document.getElementById('verify-payload-input');
+    if (!payloadTextarea || !payloadTextarea.value) return;
+    try {
+      const parsed = JSON.parse(payloadTextarea.value);
+      if (typeof parsed.amountUsd === 'number') {
+        parsed.amountUsd = Number((parsed.amountUsd + 100).toFixed(2));
+      } else if (typeof parsed.totalUsd === 'number') {
+        parsed.totalUsd = 0.01;
+      } else {
+        parsed.tampered = true;
+      }
+      payloadTextarea.value = JSON.stringify(parsed, null, 2);
+    } catch {
+      payloadTextarea.value += '\n// tampered';
+    }
+    await runVerificationFromInputs();
+  });
+
+  const replayContextBtn = document.getElementById('replay-context-btn');
+  replayContextBtn?.addEventListener('click', async () => {
+    const contextSelect = document.getElementById('verify-context-input');
+    if (!contextSelect) return;
+    contextSelect.value =
+      contextSelect.value === DOMAIN_CONTEXTS.receipt
+        ? DOMAIN_CONTEXTS.voucher
+        : DOMAIN_CONTEXTS.receipt;
+    await runVerificationFromInputs();
+  });
+
+  const restoreBundleBtn = document.getElementById('restore-bundle-btn');
+  restoreBundleBtn?.addEventListener('click', async () => {
+    if (latestSignedArtifact) {
+      populateVerifierWithBundle(latestSignedArtifact);
+      await runVerificationFromInputs();
+    }
+  });
+
+  const loadJsonBundleBtn = document.getElementById('load-bundle-json-btn');
+  loadJsonBundleBtn?.addEventListener('click', async () => {
+    const bundleJsonTextarea = document.getElementById('signed-bundle-json');
+    if (!bundleJsonTextarea?.value) return;
+    try {
+      const parsed = JSON.parse(bundleJsonTextarea.value);
+      const canonicalPayload =
+        typeof parsed.canonicalPayload === 'string'
+          ? parsed.canonicalPayload
+          : JSON.stringify(parsed.payload, null, 2);
+      populateVerifierWithBundle({
+        suite: parsed.suite || 'ML-DSA-65',
+        keyFormat: parsed.keyFormat || 'raw-public',
+        context: parsed.context || DOMAIN_CONTEXTS.receipt,
+        publicKey: parsed.publicKey || '',
+        signature: parsed.signature || '',
+        payload: parsed.payload || {},
+        canonicalPayload,
+      });
+      await runVerificationFromInputs();
+    } catch (err) {
+      const banner = document.getElementById('verification-result-banner');
+      setStatusBanner(banner, 'invalid', 'Invalid Bundle JSON', err.message);
+    }
+  });
+}
+
+document.addEventListener('DOMContentLoaded', async () => {
+  wireUpEventListeners();
+  await initSigningSystem();
+
+  // Sign an initial receipt right away so the page has a live signed receipt ready to inspect & verify
+  const receiptForm = document.getElementById('receipt-signing-form');
+  if (receiptForm) {
+    const payload = buildCanonicalReceiptPayload(new FormData(receiptForm));
+    await createSignedBundle(payload, DOMAIN_CONTEXTS.receipt);
+    await runVerificationFromInputs();
+  }
+});
diff --git a/crypto-signing.js b/crypto-signing.js
new file mode 100644
index 0000000..ba66177
--- /dev/null
+++ b/crypto-signing.js
@@ -0,0 +1,287 @@
+/**
+ * Digital Signing & Verification Module for The Daily Grind
+ * Uses Web Cryptography API (`crypto.subtle`) with post-quantum ML-DSA
+ * (`ML-DSA-65`, `ML-DSA-44`, `ML-DSA-87`) and classical `Ed25519` fallback.
+ */
+
+export const ML_DSA_PUBLIC_KEY_ALGORITHMS = {
+  1312: 'ML-DSA-44',
+  1952: 'ML-DSA-65',
+  2592: 'ML-DSA-87',
+};
+
+export const DOMAIN_CONTEXTS = {
+  receipt: 'daily-grind-order-receipt-v1',
+  voucher: 'daily-grind-gift-voucher-v1',
+};
+
+/**
+ * Checks whether the current browser supports post-quantum ML-DSA signatures
+ * via the static `SubtleCrypto.supports()` method.
+ */
+export function supportsPostQuantumSignatures(algorithm = 'ML-DSA-65') {
+  return (
+    typeof globalThis.SubtleCrypto?.supports === 'function' &&
+    SubtleCrypto.supports('sign', algorithm)
+  );
+}
+
+/**
+ * Generates an asymmetric signing key pair.
+ * Defaults to `'ML-DSA-65'` when supported, falling back to `'Ed25519'`.
+ *
+ * @param {object} [options]
+ * @param {'ML-DSA-65'|'ML-DSA-44'|'ML-DSA-87'|'Ed25519'|'auto'} [options.preferredSuite='auto']
+ * @param {boolean} [options.extractable=false]
+ */
+export async function generateSigningKeyPair(options = {}) {
+  const { preferredSuite = 'auto', extractable = false } = options;
+
+  const requestedMlDsa =
+    preferredSuite === 'auto'
+      ? 'ML-DSA-65'
+      : preferredSuite.startsWith('ML-DSA')
+        ? preferredSuite
+        : null;
+
+  if (requestedMlDsa && supportsPostQuantumSignatures(requestedMlDsa)) {
+    const keyPair = await crypto.subtle.generateKey(
+      requestedMlDsa,
+      extractable,
+      ['sign', 'verify'],
+    );
+    const publicKeyBytes = new Uint8Array(
+      await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+    );
+    return {
+      suite: requestedMlDsa,
+      keyFormat: 'raw-public',
+      isPostQuantum: true,
+      keyPair,
+      publicKeyBytes,
+    };
+  }
+
+  // Classical fallback: Ed25519
+  const keyPair = await crypto.subtle.generateKey(
+    'Ed25519',
+    extractable,
+    ['sign', 'verify'],
+  );
+  const publicKeyBytes = new Uint8Array(
+    await crypto.subtle.exportKey('raw', keyPair.publicKey),
+  );
+  return {
+    suite: 'Ed25519',
+    keyFormat: 'raw',
+    isPostQuantum: false,
+    keyPair,
+    publicKeyBytes,
+  };
+}
+
+/**
+ * Derives the public verification CryptoKey from a private signing CryptoKey
+ * when `crypto.subtle.getPublicKey` is supported.
+ */
+export async function getPublicKeyFromPrivateKey(privateKey) {
+  if (typeof crypto.subtle.getPublicKey === 'function') {
+    return crypto.subtle.getPublicKey(privateKey, ['verify']);
+  }
+  throw new DOMException('crypto.subtle.getPublicKey is not supported', 'NotSupportedError');
+}
+
+/**
+ * Exports an extractable private signing key using `'raw-seed'` for ML-DSA
+ * (since `'raw'` and `'raw-private'` throw NotSupportedError on ML-DSA)
+ * or `'pkcs8'` for classical keys.
+ */
+export async function exportPrivateKeySeedOrPkcs8(privateKey) {
+  if (privateKey.algorithm.name.startsWith('ML-DSA')) {
+    const seedBuffer = await crypto.subtle.exportKey('raw-seed', privateKey);
+    return {
+      format: 'raw-seed',
+      algorithm: privateKey.algorithm.name,
+      bytes: new Uint8Array(seedBuffer),
+    };
+  }
+  const pkcs8Buffer = await crypto.subtle.exportKey('pkcs8', privateKey);
+  return {
+    format: 'pkcs8',
+    algorithm: privateKey.algorithm.name,
+    bytes: new Uint8Array(pkcs8Buffer),
+  };
+}
+
+/**
+ * Imports a private signing key with usage `['sign']` only
+ * (passing `['sign', 'verify']` to `importKey()` on a private key throws SyntaxError).
+ */
+export async function importPrivateKeySeedOrPkcs8(
+  keyBytes,
+  algorithm = 'ML-DSA-65',
+  extractable = false,
+) {
+  const bytes = keyBytes instanceof Uint8Array ? keyBytes : new Uint8Array(keyBytes);
+  if (algorithm.startsWith('ML-DSA')) {
+    const format = bytes.byteLength === 32 ? 'raw-seed' : 'pkcs8';
+    return crypto.subtle.importKey(format, bytes, algorithm, extractable, ['sign']);
+  }
+  return crypto.subtle.importKey('pkcs8', bytes, algorithm, extractable, ['sign']);
+}
+
+/**
+ * Imports a public verification key from raw public key bytes (`'raw-public'` for ML-DSA,
+ * `'raw'` for Ed25519) with usage `['verify']` only.
+ */
+export async function importPublicKeyBytes(publicKeyBytes, explicitAlgorithm = null) {
+  const bytes =
+    publicKeyBytes instanceof Uint8Array
+      ? publicKeyBytes
+      : new Uint8Array(publicKeyBytes);
+  const mlDsaName =
+    explicitAlgorithm && explicitAlgorithm.startsWith('ML-DSA')
+      ? explicitAlgorithm
+      : ML_DSA_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+
+  if (mlDsaName) {
+    return crypto.subtle.importKey('raw-public', bytes, mlDsaName, true, ['verify']);
+  }
+  return crypto.subtle.importKey('raw', bytes, 'Ed25519', true, ['verify']);
+}
+
+/**
+ * Prepends a 1-byte length-prefixed context header to payloadBytes for classical
+ * fallback algorithms (`Ed25519`) which ignore the `context` property in WebIDL.
+ */
+export function frameFallbackInput(payloadBytes, contextBytes) {
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+  const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+  framed[0] = contextBytes.byteLength;
+  framed.set(contextBytes, 1);
+  framed.set(payloadBytes, 1 + contextBytes.byteLength);
+  return framed;
+}
+
+function normalizeContextBytes(context) {
+  if (!context) return new Uint8Array(0);
+  if (typeof context === 'string') return new TextEncoder().encode(context);
+  if (context instanceof Uint8Array) return context;
+  return new Uint8Array(context);
+}
+
+function normalizePayloadBytes(payload) {
+  if (typeof payload === 'string') return new TextEncoder().encode(payload);
+  if (payload instanceof Uint8Array) return payload;
+  return new Uint8Array(payload);
