+ */
+export function bytesToBase64Url(bytes) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  let binary = '';
+  for (let i = 0; i < u8.byteLength; i++) {
+    binary += String.fromCharCode(u8[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+/**
+ * Decodes a URL-safe Base64 (or standard Base64) string into a Uint8Array.
+ */
+export function base64UrlToBytes(base64Url) {
+  const normalized = String(base64Url)
+    .trim()
+    .replace(/-/g, '+')
+    .replace(/_/g, '/');
+  const padLength = (4 - (normalized.length % 4)) % 4;
+  const padded = normalized + '='.repeat(padLength);
+  const binary = atob(padded);
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) {
+    bytes[i] = binary.charCodeAt(i);
+  }
+  return bytes;
+}
+
+/**
+ * Formats bytes as a short colon-separated hex fingerprint.
+ */
+export function bytesToHex(bytes, maxBytes = 16) {
+  const u8 = bytes instanceof Uint8Array ? bytes : new Uint8Array(bytes);
+  const slice = u8.subarray(0, maxBytes);
+  return Array.from(slice, (b) => b.toString(16).padStart(2, '0')).join(':');
+}
