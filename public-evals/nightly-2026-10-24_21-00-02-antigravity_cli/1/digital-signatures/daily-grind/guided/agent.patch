+/**
+ * Verifies a signature using `crypto.subtle.verify()` with domain separation.
+ * Accepts either a `CryptoKey` or raw public key bytes (`Uint8Array` / `ArrayBuffer`).
+ */
+export async function verifyPayload(
+  publicKeyOrBytes,
+  signatureBytes,
+  payload,
+  context = new Uint8Array(0),
+) {
+  const payloadBytes = normalizePayloadBytes(payload);
+  const contextBytes = normalizeContextBytes(context);
+  const sigBytes =
+    signatureBytes instanceof Uint8Array
+      ? signatureBytes
+      : new Uint8Array(signatureBytes);
+
+  if (contextBytes.byteLength > 255) {
+    throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+  }
+
+  const publicKey =
+    publicKeyOrBytes instanceof CryptoKey
+      ? publicKeyOrBytes
+      : await importPublicKeyBytes(publicKeyOrBytes);
+
+  if (publicKey.algorithm.name.startsWith('ML-DSA')) {
+    return crypto.subtle.verify(
+      { name: publicKey.algorithm.name, context: contextBytes },
+      publicKey,
+      sigBytes,
+      payloadBytes,
+    );
+  }
+
+  const framed = frameFallbackInput(payloadBytes, contextBytes);
+  return crypto.subtle.verify('Ed25519', publicKey, sigBytes, framed);
+}
