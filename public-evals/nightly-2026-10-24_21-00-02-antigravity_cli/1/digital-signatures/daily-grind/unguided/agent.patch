+      const verifyChecksList = document.getElementById('verify-checks-list');
+      const signedLedgerList = document.getElementById('signed-ledger-list');
+
+      function setDocTab(docType) {
+        currentDocType = docType;
+        if (docType === 'CAFE_ORDER_RECEIPT') {
+          tabReceipt.classList.add('active');
+          tabReceipt.setAttribute('aria-selected', 'true');
+          tabVoucher.classList.remove('active');
+          tabVoucher.setAttribute('aria-selected', 'false');
+          receiptForm.style.display = 'block';
+          voucherForm.style.display = 'none';
+        } else {
+          tabVoucher.classList.add('active');
+          tabVoucher.setAttribute('aria-selected', 'true');
+          tabReceipt.classList.remove('active');
+          tabReceipt.setAttribute('aria-selected', 'false');
+          receiptForm.style.display = 'none';
+          voucherForm.style.display = 'block';
+        }
+      }
+
+      function buildPayloadFromActiveForm() {
+        const issuedAt = new Date().toISOString();
+        if (currentDocType === 'CAFE_ORDER_RECEIPT') {
+          const orderId = document.getElementById('receipt-order-id').value.trim() || 'ORD-2026-0001';
+          const customer = document.getElementById('receipt-customer').value.trim() || 'Valued Guest';
+          const items = document.getElementById('receipt-items').value.trim() || '1x House Drip Coffee';
+          const totalAmount = Number(parseFloat(document.getElementById('receipt-total').value || '4.50').toFixed(2));
+          const location = document.getElementById('receipt-location').value.trim() || 'Downtown Roastery #04';
+
+          return {
+            issuer: 'The Daily Grind Coffee Co.',
+            documentType: 'CAFE_ORDER_RECEIPT',
+            orderId,
+            customer,
+            items,
+            currency: 'USD',
+            totalAmount,
+            storeLocation: location,
+            issuedAt
+          };
+        } else {
+          const voucherCode = document.getElementById('voucher-code').value.trim() || 'TDG-GIFT-0001';
+          const amount = Number(parseFloat(document.getElementById('voucher-amount').value || '25.00').toFixed(2));
+          const recipient = document.getElementById('voucher-recipient').value.trim() || 'friend@example.com';
+          const purchaser = document.getElementById('voucher-sender').value.trim() || 'Daily Grind Customer';
+          const expiresAt = document.getElementById('voucher-expiry').value || '2027-12-31';
+          const message = document.getElementById('voucher-message').value.trim();
+
+          return {
+            issuer: 'The Daily Grind Coffee Co.',
+            documentType: 'GIFT_VOUCHER',
+            voucherCode,
+            recipient,
+            purchaser,
+            currency: 'USD',
+            valueAmount: amount,
+            expiresAt,
+            personalNote: message,
+            issuedAt
+          };
+        }
+      }
+
+      function updateArtifactPreviewCard(bundle) {
+        const p = bundle.payload;
+        previewDocType.textContent = p.documentType === 'GIFT_VOUCHER' ? 'SIGNED GIFT VOUCHER' : 'SIGNED COFFEE RECEIPT';
+        previewAlgBadge.textContent = `SIGNED • ${bundle.algorithm}`;
+
+        if (p.documentType === 'CAFE_ORDER_RECEIPT') {
+          previewSummaryGrid.innerHTML = `
+            <div><strong>Order ID:</strong> ${p.orderId}</div>
+            <div><strong>Total:</strong> $${Number(p.totalAmount).toFixed(2)} ${p.currency}</div>
+            <div><strong>Customer:</strong> ${p.customer}</div>
+            <div><strong>Items:</strong> ${p.items}</div>
+          `;
+        } else {
+          previewSummaryGrid.innerHTML = `
+            <div><strong>Voucher:</strong> ${p.voucherCode}</div>
+            <div><strong>Value:</strong> $${Number(p.valueAmount).toFixed(2)} ${p.currency}</div>
+            <div><strong>Recipient:</strong> ${p.recipient}</div>
+            <div><strong>Expires:</strong> ${p.expiresAt}</div>
+          `;
+        }
+
+        const shortSig = bundle.signature.length > 96
+          ? bundle.signature.slice(0, 48) + '...' + bundle.signature.slice(-40)
+          : bundle.signature;
+        previewSignatureSnippet.textContent = shortSig;
+      }
+
+      function renderLedger() {
+        signedLedgerList.innerHTML = '';
+        issuedLedger.slice(0, 6).forEach((entry, idx) => {
+          const p = entry.payload;
+          const isVoucher = p.documentType === 'GIFT_VOUCHER';
+          const title = isVoucher ? `Voucher ${p.voucherCode}` : `Receipt ${p.orderId}`;
+          const amount = isVoucher ? `$${Number(p.valueAmount).toFixed(2)}` : `$${Number(p.totalAmount).toFixed(2)}`;
+          const subtitle = isVoucher ? `To: ${p.recipient}` : `${p.customer} • ${p.items}`;
+
+          const itemEl = document.createElement('div');
+          itemEl.className = 'ledger-item';
+          itemEl.innerHTML = `
+            <div class="ledger-item-info">
+              <strong>${title} (${amount}) — <span style="font-weight:600; color:var(--success);">${entry.algorithm}</span></strong>
+              <span>${subtitle}</span>
+            </div>
+            <button type="button" class="btn btn-outline btn-sm" data-ledger-idx="${idx}">Inspect &amp; Verify</button>
+          `;
+          itemEl.querySelector('button').addEventListener('click', async () => {
+            lastValidSignedBundle = JSON.parse(JSON.stringify(entry));
+            verifierJsonInput.value = JSON.stringify(entry, null, 2);
+            verifierPubKeyInput.value = entry.issuerPublicKey;
+            await runVerificationFromInputs();
+          });
+          signedLedgerList.appendChild(itemEl);
+        });
+      }
+
+      async function generateAndActivateKeys(suiteName) {
+        keyStatusPill.textContent = 'Generating Keys...';
+        activeKeyState = await generateKeypairForSuite(suiteName);
+        algSelect.value = activeKeyState.algorithm;
+        keyStatusPill.textContent = 'Keypair Ready';
+        activeAlgLabel.textContent = activeKeyState.algorithm;
+        activeSecurityClass.textContent = activeKeyState.securityClass;
+        activeKeyFingerprint.textContent = activeKeyState.fingerprint;
+        activePubKeyDisplay.value = activeKeyState.publicKeyText;
+        verifierPubKeyInput.value = activeKeyState.publicKeyText;
+      }
+
+      async function signActiveDocument() {
+        if (!activeKeyState) {
+          await generateAndActivateKeys(algSelect.value);
+        }
+        const payload = buildPayloadFromActiveForm();
+        const canonicalStr = canonicalizeJson(payload);
+        const payloadBytes = textEncoder.encode(canonicalStr);
+        const payloadSha256 = await sha256Hex(payloadBytes);
+        const signature = await signCanonicalBytes(activeKeyState, payloadBytes);
+
+        const signedBundle = {
+          version: '1.0',
+          algorithm: activeKeyState.algorithm,
+          securityClass: activeKeyState.securityClass,
+          keyFingerprint: activeKeyState.fingerprint,
+          payloadSha256,
+          payload,
+          signature,
+          issuerPublicKey: activeKeyState.publicKeyText
+        };
+
+        lastValidSignedBundle = JSON.parse(JSON.stringify(signedBundle));
+        issuedLedger.unshift(JSON.parse(JSON.stringify(signedBundle)));
+
+        updateArtifactPreviewCard(signedBundle);
+        renderLedger();
+
+        verifierJsonInput.value = JSON.stringify(signedBundle, null, 2);
+        verifierPubKeyInput.value = signedBundle.issuerPublicKey;
+        await runVerificationFromInputs();
+      }
+
+      async function runVerificationFromInputs() {
+        let parsed;
+        try {
+          parsed = JSON.parse(verifierJsonInput.value);
+        } catch (err) {
+          verifyResultBanner.className = 'verify-banner invalid';
+          verifyStatusHeading.textContent = '✗ INVALID JSON SYNTAX';
+          verifyStatusDetail.textContent = 'The signed document bundle is not valid JSON: ' + err.message;
+          verifyChecksList.innerHTML = '';
+          return;
+        }
+
+        const result = await verifySignedBundle(parsed, verifierPubKeyInput.value);
+        verifyResultBanner.className = 'verify-banner ' + (result.valid ? 'valid' : 'invalid');
+        verifyStatusHeading.textContent = result.valid
+          ? '✓ AUTHENTIC & TAMPER-FREE DOCUMENT VERIFIED'
+          : '✗ VERIFICATION FAILED — TAMPERING OR INVALID SIGNATURE DETECTED';
+        verifyStatusDetail.textContent = result.reason;
+        verifyChecksList.innerHTML = result.checks.map(c => `<li>${c}</li>`).join('');
+      }
+
+      // Event Listeners
+      tabReceipt.addEventListener('click', () => setDocTab('CAFE_ORDER_RECEIPT'));
+      tabVoucher.addEventListener('click', () => setDocTab('GIFT_VOUCHER'));
+
+      algSelect.addEventListener('change', async () => {
+        await generateAndActivateKeys(algSelect.value);
+        await signActiveDocument();
+      });
+
+      generateKeysBtn.addEventListener('click', async () => {
+        await generateAndActivateKeys(algSelect.value);
+        await signActiveDocument();
+      });
+
+      copyPubKeyBtn.addEventListener('click', async () => {
+        if (navigator.clipboard && activePubKeyDisplay.value) {
+          await navigator.clipboard.writeText(activePubKeyDisplay.value);
+          copyPubKeyBtn.textContent = 'Copied!';
+          setTimeout(() => { copyPubKeyBtn.textContent = 'Copy Public Key'; }, 1500);
+        }
+      });
+
+      signDocumentBtn.addEventListener('click', async () => {
+        await signActiveDocument();
+      });
+
+      sendToVerifierBtn.addEventListener('click', async () => {
+        if (lastValidSignedBundle) {
+          verifierJsonInput.value = JSON.stringify(lastValidSignedBundle, null, 2);
+          verifierPubKeyInput.value = lastValidSignedBundle.issuerPublicKey;
+          await runVerificationFromInputs();
+        }
+      });
+
+      copySignedJsonBtn.addEventListener('click', async () => {
+        if (navigator.clipboard && verifierJsonInput.value) {
+          await navigator.clipboard.writeText(verifierJsonInput.value);
+          copySignedJsonBtn.textContent = 'Copied JSON!';
+          setTimeout(() => { copySignedJsonBtn.textContent = 'Copy Signed JSON'; }, 1500);
+        }
+      });
+
+      downloadSignedJsonBtn.addEventListener('click', () => {
+        if (!lastValidSignedBundle) return;
+        const blob = new Blob([JSON.stringify(lastValidSignedBundle, null, 2)], { type: 'application/json' });
+        const url = URL.createObjectURL(blob);
+        const a = document.createElement('a');
+        const idSlug = lastValidSignedBundle.payload.orderId || lastValidSignedBundle.payload.voucherCode || 'signed-doc';
+        a.href = url;
+        a.download = `${idSlug.toLowerCase()}.signed.json`;
+        document.body.appendChild(a);
+        a.click();
+        a.remove();
+        URL.revokeObjectURL(url);
+      });
+
+      verifyDocumentBtn.addEventListener('click', async () => {
+        await runVerificationFromInputs();
+      });
+
+      simulateTamperPayloadBtn.addEventListener('click', async () => {
+        try {
+          const bundle = JSON.parse(verifierJsonInput.value);
+          if (bundle && bundle.payload) {
+            if (bundle.payload.documentType === 'GIFT_VOUCHER') {
+              bundle.payload.valueAmount = 999.99;
+            } else {
+              bundle.payload.totalAmount = 0.01;
+            }
+            verifierJsonInput.value = JSON.stringify(bundle, null, 2);
+            await runVerificationFromInputs();
+          }
+        } catch {
+          await runVerificationFromInputs();
+        }
+      });
+
+      simulateTamperSigBtn.addEventListener('click', async () => {
+        try {
+          const bundle = JSON.parse(verifierJsonInput.value);
+          if (bundle && typeof bundle.signature === 'string' && bundle.signature.length > 4) {
+            const firstChar = bundle.signature[0].toLowerCase();
+            const flipped = firstChar === 'a' ? 'b' : 'a';
+            bundle.signature = flipped + bundle.signature.slice(1);
+            verifierJsonInput.value = JSON.stringify(bundle, null, 2);
+            await runVerificationFromInputs();
+          }
+        } catch {
+          await runVerificationFromInputs();
+        }
+      });
+
+      restoreValidDocBtn.addEventListener('click', async () => {
+        if (lastValidSignedBundle) {
+          verifierJsonInput.value = JSON.stringify(lastValidSignedBundle, null, 2);
+          verifierPubKeyInput.value = lastValidSignedBundle.issuerPublicKey;
+          await runVerificationFromInputs();
+        }
+      });
+
+      // Quick Order Receipt buttons in Seasonal Favorites
+      document.querySelectorAll('.quick-order-btn').forEach(btn => {
+        btn.addEventListener('click', async () => {
+          const item = btn.getAttribute('data-item');
+          const price = btn.getAttribute('data-price');
+          setDocTab('CAFE_ORDER_RECEIPT');
+          document.getElementById('receipt-order-id').value = 'ORD-2026-' + Math.floor(1000 + Math.random() * 9000);
+          document.getElementById('receipt-items').value = '1x ' + item;
+          document.getElementById('receipt-total').value = price;
+          await signActiveDocument();
+          document.getElementById('crypto-portal').scrollIntoView({ behavior: 'smooth' });
+        });
+      });
+
+      // Initialize on page load: generate default keypair, pre-sign both a sample gift voucher and receipt
+      (async function init() {
+        await generateAndActivateKeys('ECDSA-P256');
+        // Pre-issue a signed Gift Voucher into the session ledger so both document types are immediately available
+        setDocTab('GIFT_VOUCHER');
+        await signActiveDocument();
+        // Switch back to Coffee Order Receipt and sign it as the active document
+        setDocTab('CAFE_ORDER_RECEIPT');
+        await signActiveDocument();
+      })();
+    })();
+  </script>
 </body>
 
 </html>
