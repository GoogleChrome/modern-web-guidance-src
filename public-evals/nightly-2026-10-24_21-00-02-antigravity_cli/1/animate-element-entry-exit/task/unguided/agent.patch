+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+
+    const promoOffers = [
+      {
+        title: 'Double Bean Points',
+        description: 'Earn 2x loyalty points on all whole-bean coffee bag purchases all weekend.',
+        link: '/rewards'
+      },
+      {
+        title: 'Happy Hour Cold Brew',
+        description: 'Enjoy 50% off any size house-steeped cold brew every afternoon from 2 PM to 4 PM.',
+        link: '/menu/cold-brew'
+      },
+      {
+        title: 'Bring a Mug Discount',
+        description: 'Save $1.00 on any beverage when you bring in your own reusable tumbler.',
+        link: '/menu'
+      },
+      {
+        title: 'Roaster’s Flight',
+        description: 'Sample three single-origin pour-overs paired with artisanal dark chocolate.',
+        link: '/menu/seasonal'
+      }
+    ];
+
+    let promoCount = 0;
+
+    addBtn.addEventListener('click', () => {
+      const offer = promoOffers[promoCount % promoOffers.length];
+      promoCount++;
+      const card = document.createElement('div');
+      card.className = 'card';
+      card.innerHTML = `
+        <h3>${offer.title}</h3>
+        <p>${offer.description}</p>
+        <a href="${offer.link}" class="btn">Claim Offer</a>
+      `;
+      domContainer.appendChild(card);
+    });
+
+    removeBtn.addEventListener('click', () => {
+      const cards = domContainer.querySelectorAll('.card:not(.removing)');
+      const lastCard = cards[cards.length - 1];
+      if (!lastCard) return;
+
+      lastCard.classList.add('removing');
+      const cleanup = () => {
+        if (lastCard.parentNode) {
+          lastCard.remove();
+        }
+      };
+      lastCard.addEventListener('transitionend', cleanup, { once: true });
+      setTimeout(cleanup, 300);
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+    });
+  </script>
