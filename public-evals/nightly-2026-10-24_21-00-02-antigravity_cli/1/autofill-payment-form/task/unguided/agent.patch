+            <div class="form-group">
+              <label for="expiry-date">Expiry Date</label>
+              <input
+                type="text"
+                id="expiry-date"
+                name="expiryDate"
+                placeholder="MM/YY"
+                inputmode="numeric"
+                autocomplete="cc-exp"
+                maxlength="5"
+                pattern="(0[1-9]|1[0-2])\/\d{2}"
+                required
+              >
+            </div>
+
+            <div class="form-group">
+              <label for="security-code">Security Code (CVV)</label>
+              <input
+                type="password"
+                id="security-code"
+                name="securityCode"
+                placeholder="123"
+                inputmode="numeric"
+                autocomplete="cc-csc"
+                maxlength="4"
+                pattern="\d{3,4}"
+                required
+              >
+            </div>
+          </div>
+
