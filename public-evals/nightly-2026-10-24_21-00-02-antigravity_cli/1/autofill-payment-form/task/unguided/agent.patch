+            >
+          </div>
+
+          <div class="form-group">
+            <label for="card-number">Card Number</label>
+            <input
+              type="text"
+              id="card-number"
+              name="cardNumber"
+              placeholder="1234 5678 9012 3456"
+              inputmode="numeric"
+              autocomplete="cc-number"
+              maxlength="19"
+              pattern="[\d ]{13,19}"
+              required
+            >
+          </div>
+
