+  <script>
+    const navList = document.querySelector('nav ul');
+    navList.addEventListener('click', (event) => {
+      const link = event.target.closest('a:not(.logout-link)');
+      if (!link) return;
+
+      event.preventDefault();
+
+      const prevActiveItem = navList.querySelector('li.active');
+      if (prevActiveItem) {
+        prevActiveItem.classList.remove('active');
+        prevActiveItem.querySelector('a')?.removeAttribute('aria-current');
+      }
+
+      const nextActiveItem = link.closest('li');
+      if (nextActiveItem) {
+        nextActiveItem.classList.add('active');
+        link.setAttribute('aria-current', 'page');
+      }
+    });
+  </script>
