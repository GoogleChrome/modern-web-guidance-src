+  <script>
+    (function () {
+      const navList = document.getElementById('nav-list');
+      const indicator = document.getElementById('nav-indicator');
+      const navItems = document.querySelectorAll('nav a.nav-item');
+
+      function updateIndicator(activeItem, animate = true) {
+        if (!activeItem || !indicator || !navList) return;
+        if (!animate) {
+          indicator.style.transition = 'none';
+        }
+        const listRect = navList.getBoundingClientRect();
+        const itemRect = activeItem.getBoundingClientRect();
+        const left = itemRect.left - listRect.left;
+        const width = itemRect.width;
+
+        indicator.style.left = `${left}px`;
+        indicator.style.width = `${width}px`;
+
+        if (!animate) {
+          // Force reflow before restoring transition
+          indicator.offsetHeight;
+          indicator.style.transition = '';
+        }
+      }
+
+      const initialActive = document.querySelector('nav a.nav-item.active') || navItems[0];
+      if (initialActive) {
+        updateIndicator(initialActive, false);
+      }
+
+      navItems.forEach((item) => {
+        item.addEventListener('click', (e) => {
+          e.preventDefault();
+          navItems.forEach((nav) => {
+            nav.classList.remove('active');
+            nav.removeAttribute('aria-current');
+          });
+          item.classList.add('active');
+          item.setAttribute('aria-current', 'page');
+          updateIndicator(item, true);
+        });
+      });
+
+      window.addEventListener('resize', () => {
+        const currentActive = document.querySelector('nav a.nav-item.active');
+        if (currentActive) {
+          updateIndicator(currentActive, false);
+        }
+      });
+    })();
+  </script>
