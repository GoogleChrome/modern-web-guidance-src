+  <button type="button" id="open-feedback-btn" class="feedback-fab" aria-haspopup="dialog" aria-controls="feedback-modal">
+    Give Feedback
+  </button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-modal');
+    const openFeedbackBtn = document.getElementById('open-feedback-btn');
+    const moveDialogBtn = document.getElementById('move-dialog-btn');
+    const primaryHost = document.getElementById('primary-dialog-host');
+    const secondaryHost = document.getElementById('secondary-dialog-host');
+    const parentLabel = document.getElementById('modal-parent-label');
+    const moveMethodBadge = document.getElementById('move-method-badge');
+    const primaryStatus = document.getElementById('primary-host-status');
+    const secondaryStatus = document.getElementById('secondary-host-status');
+
+    function updateHostIndicators() {
+      const currentParent = feedbackDialog.parentElement;
+      const isPrimary = currentParent === primaryHost;
+      parentLabel.textContent = currentParent ? `#${currentParent.id}` : 'unknown';
+      primaryStatus.textContent = isPrimary ? 'Contains Modal' : 'Empty';
+      secondaryStatus.textContent = !isPrimary ? 'Contains Modal' : 'Empty';
+    }
+
+    openFeedbackBtn.addEventListener('click', () => {
+      if (!feedbackDialog.open) {
+        feedbackDialog.showModal();
+      }
+    });
+
+    moveDialogBtn.addEventListener('click', () => {
+      const targetParent =
+        feedbackDialog.parentElement === primaryHost ? secondaryHost : primaryHost;
+
+      // Relocate the open dialog in the DOM while preserving top-layer modal and focus state
+      if ('moveBefore' in Element.prototype) {
+        targetParent.moveBefore(feedbackDialog, null);
+        moveMethodBadge.textContent = 'Moved via moveBefore()';
+      } else {
+        // Fallback: traditional move closes <dialog> and resets focus/selection state
+        const wasOpen =
+          feedbackDialog.hasAttribute('open') || feedbackDialog.matches(':popover-open');
+        const activeEl = document.activeElement;
+        const hadFocusInside = feedbackDialog.contains(activeEl);
+        const selectionStart =
+          hadFocusInside && typeof activeEl.selectionStart === 'number'
+            ? activeEl.selectionStart
+            : null;
+        const selectionEnd =
+          hadFocusInside && typeof activeEl.selectionEnd === 'number'
+            ? activeEl.selectionEnd
+            : null;
+
+        targetParent.insertBefore(feedbackDialog, null);
+
+        // Manually re-open and restore modal & focus state in unsupported browsers
+        if (wasOpen && typeof feedbackDialog.showModal === 'function') {
+          feedbackDialog.showModal();
+        } else if (wasOpen && typeof feedbackDialog.showPopover === 'function') {
+          feedbackDialog.showPopover();
+        }
+
+        if (hadFocusInside && activeEl && typeof activeEl.focus === 'function') {
+          activeEl.focus();
+          if (
+            selectionStart !== null &&
+            selectionEnd !== null &&
+            typeof activeEl.setSelectionRange === 'function'
+          ) {
+            try {
+              activeEl.setSelectionRange(selectionStart, selectionEnd);
+            } catch (_) {
+              // Ignore inputs that do not support selection ranges (e.g., type="email")
+            }
+          }
+        }
+        moveMethodBadge.textContent = 'Moved via insertBefore() fallback';
+      }
+
+      updateHostIndicators();
+    });
+  </script>
+
