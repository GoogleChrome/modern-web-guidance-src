+  <script>
+    (function () {
+      const triggers = document.querySelectorAll('[data-modal-target]');
+      const dialogs = document.querySelectorAll('dialog.coffee-modal');
+      let lastTrigger = null;
+
+      triggers.forEach((btn) => {
+        btn.addEventListener('click', () => {
+          lastTrigger = btn;
+          const dialog = document.getElementById(btn.getAttribute('data-modal-target'));
+          if (dialog && !dialog.open && typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          }
+        });
+      });
+
+      dialogs.forEach((dialog) => {
+        // Explicit close buttons fallback when Invoker Commands aren't handled natively
+        dialog.querySelectorAll('[data-modal-close]').forEach((closeBtn) => {
+          closeBtn.addEventListener('click', (e) => {
+            if (dialog.open) {
+              e.preventDefault();
+              dialog.close();
+            }
+          });
+        });
+
+        // Backdrop click light-dismiss fallback when closedby="any" isn't handled natively
+        dialog.addEventListener('click', (e) => {
+          if (e.target === dialog && dialog.open) {
+            dialog.close();
+          }
+        });
+
+        // Restore focus to the trigger button when dismissed
+        dialog.addEventListener('close', () => {
+          if (lastTrigger && typeof lastTrigger.focus === 'function') {
+            lastTrigger.focus();
+            lastTrigger = null;
+          }
+        });
+      });
+    })();
+  </script>
