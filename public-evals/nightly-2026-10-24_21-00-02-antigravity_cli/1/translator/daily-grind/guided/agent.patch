+  <script>
+    (function () {
+      const SOURCE_LANG = 'en';
+      const selectEl = document.getElementById('target-lang');
+      const translateBtn = document.getElementById('start-translation-btn');
+      const statusTextEl = document.getElementById('translation-status-text');
+      const progressEl = document.getElementById('translation-progress');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Preserve original English text and tracks current language
+      const originalTexts = new Map();
+      translatableElements.forEach((el) => {
+        originalTexts.set(el, el.textContent.trim());
+      });
+
+      let currentLanguage = SOURCE_LANG;
+      const translatorCache = new Map();
+
+      function setStatus(message, progressPercent = null) {
+        statusTextEl.textContent = message;
+        if (progressPercent === null) {
+          progressEl.hidden = true;
+        } else {
+          progressEl.hidden = false;
+          progressEl.value = progressPercent;
+        }
+      }
+
+      function restoreOriginalText() {
+        translatableElements.forEach((el) => {
+          const original = originalTexts.get(el);
+          if (original !== undefined) {
+            el.textContent = original;
+          }
+          el.removeAttribute('lang');
+        });
+        document.documentElement.lang = SOURCE_LANG;
+        currentLanguage = SOURCE_LANG;
+        setStatus('Showing original English text.');
+      }
+
+      // Feature detection exclusively via global Translator interface (never window.ai.translator)
+      if (!('Translator' in self)) {
+        selectEl.disabled = true;
+        translateBtn.disabled = true;
+        setStatus('Client-side translation is currently unsupported in this browser.');
+        return;
+      }
+
+      async function getOrCreateTranslator(options) {
+        const cacheKey = `${options.sourceLanguage}->${options.targetLanguage}`;
+        if (translatorCache.has(cacheKey)) {
+          return translatorCache.get(cacheKey);
+        }
+
+        const translator = await self.Translator.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = Math.round((e.loaded || 0) * 100);
+              setStatus(`Downloading language pack (${pct}%)...`, pct);
+            });
+          },
+        });
+
+        translatorCache.set(cacheKey, translator);
+        return translator;
+      }
+
+      async function applyTranslation(translator, targetLanguage) {
+        setStatus('Translating menu descriptions and story...');
+        for (const el of translatableElements) {
+          const sourceText = originalTexts.get(el);
+          if (!sourceText) continue;
+          const translated = await translator.translate(sourceText);
+          el.textContent = translated;
+          el.setAttribute('lang', targetLanguage);
+        }
+        document.documentElement.lang = targetLanguage;
+        currentLanguage = targetLanguage;
+        setStatus(`Translated to ${selectEl.options[selectEl.selectedIndex].text}.`);
+      }
+
+      async function handleLanguageSelection(fromUserClick) {
+        const targetLanguage = selectEl.value;
+
+        if (targetLanguage === SOURCE_LANG) {
+          restoreOriginalText();
+          return;
+        }
+
+        // Identical options object passed to both Translator.availability() and Translator.create()
+        const options = {
+          sourceLanguage: SOURCE_LANG,
+          targetLanguage,
+        };
+
+        try {
+          translateBtn.disabled = true;
+          const availability = await self.Translator.availability(options);
+
+          if (availability === 'unavailable') {
+            setStatus(`Translation to ${selectEl.options[selectEl.selectedIndex].text} is unavailable on this device.`);
+            return;
+          }
+
+          if (availability === 'available') {
+            const translator = await getOrCreateTranslator(options);
+            await applyTranslation(translator, targetLanguage);
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            if (!fromUserClick) {
+              // Strictly require an explicit button click gesture before calling create() when downloadable/downloading
+              setStatus('Language model download required. Click "Translate" to download and translate.');
+              return;
+            }
+            setStatus('Starting language model download...', 0);
+            const translator = await getOrCreateTranslator(options);
+            await applyTranslation(translator, targetLanguage);
+          }
+        } catch (err) {
+          console.error('Translation failed:', err);
+          setStatus('Unable to complete on-device translation.');
+        } finally {
+          translateBtn.disabled = false;
+        }
+      }
+
+      // Changing the select checks availability and translates immediately if already 'available' on-device
+      selectEl.addEventListener('change', () => {
+        handleLanguageSelection(false);
+      });
+
+      // Clicking the button provides the explicit user gesture needed for 'downloadable' or 'downloading' models
+      translateBtn.addEventListener('click', () => {
+        handleLanguageSelection(true);
+      });
+    })();
+  </script>
