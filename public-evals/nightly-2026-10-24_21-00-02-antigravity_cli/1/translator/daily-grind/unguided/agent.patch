+  <script>
+    (function () {
+      const langSelect = document.getElementById('language-select');
+      const statusBanner = document.getElementById('translation-status');
+      const statusMessage = document.getElementById('translation-message');
+      const progressWrap = document.getElementById('translation-progress-wrap');
+      const progressBar = document.getElementById('translation-progress-bar');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Store original English text and track current page language
+      let currentLanguage = 'en';
+      const originalTexts = new Map();
+      translatableElements.forEach((el) => {
+        originalTexts.set(el, el.textContent.trim());
+      });
+
+      function setStatus(message, { isError = false, progress = null } = {}) {
+        if (!message) {
+          statusBanner.classList.remove('visible', 'error');
+          progressWrap.classList.remove('visible');
+          statusMessage.textContent = '';
+          return;
+        }
+        statusMessage.textContent = message;
+        statusBanner.classList.add('visible');
+        statusBanner.classList.toggle('error', isError);
+
+        if (typeof progress === 'number') {
+          progressWrap.classList.add('visible');
+          progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
+        } else {
+          progressWrap.classList.remove('visible');
+        }
+      }
+
+      async function createOnDeviceTranslator(sourceLanguage, targetLanguage) {
+        if (!('Translator' in self)) {
+          throw new Error('The On-Device Translator API (window.Translator) is not supported in this browser.');
+        }
+
+        // 1. Check availability of the language pair
+        if (typeof self.Translator.availability === 'function') {
+          const availability = await self.Translator.availability({
+            sourceLanguage,
+            targetLanguage
+          });
+
+          if (availability === 'unavailable') {
+            throw new Error(`On-device translation from "${sourceLanguage}" to "${targetLanguage}" is unavailable.`);
+          }
+
+          if (availability === 'downloadable' || availability === 'downloading') {
+            setStatus(`Downloading on-device language model (${sourceLanguage} → ${targetLanguage})...`, { progress: 0 });
+          }
+        }
+
+        // 2. Create the translator instance and monitor download progress
+        const translator = await self.Translator.create({
+          sourceLanguage,
+          targetLanguage,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const total = e.total || 1;
+              const loaded = e.loaded || 0;
+              const percent = Math.round((loaded / total) * 100);
+              setStatus(`Downloading language pack (${targetLanguage.toUpperCase()}): ${percent}%`, { progress: percent });
+            });
+          }
+        });
+
+        return translator;
+      }
+
+      async function translatePage(targetLanguage) {
+        if (targetLanguage === currentLanguage) {
+          return;
+        }
+
+        // Fast restore if switching back to original English
+        if (targetLanguage === 'en') {
+          translatableElements.forEach((el) => {
+            el.textContent = originalTexts.get(el);
+            el.removeAttribute('lang');
+          });
+          document.documentElement.lang = 'en';
+          currentLanguage = 'en';
+          setStatus('');
+          return;
+        }
+
+        langSelect.disabled = true;
+        translatableElements.forEach((el) => el.classList.add('translating'));
+        setStatus(`Preparing on-device translation to ${targetLanguage.toUpperCase()}...`);
+
+        let translator = null;
+        try {
+          // Translate from English source text to target language using built-in Translator API
+          const sourceLanguage = 'en';
+          translator = await createOnDeviceTranslator(sourceLanguage, targetLanguage);
+
+          setStatus(`Translating coffee menu and story to ${targetLanguage.toUpperCase()} on-device...`);
+
+          for (const el of translatableElements) {
+            const sourceText = originalTexts.get(el);
+            if (sourceText) {
+              const translated = await translator.translate(sourceText);
+              if (translated) {
+                el.textContent = translated;
+                el.setAttribute('lang', targetLanguage);
+              }
+            }
+          }
+
+          document.documentElement.lang = targetLanguage;
+          currentLanguage = targetLanguage;
+          setStatus(`Translated to ${targetLanguage.toUpperCase()} using browser on-device AI.`);
+          setTimeout(() => {
+            if (currentLanguage === targetLanguage && !statusBanner.classList.contains('error')) {
+              setStatus('');
+            }
+          }, 3000);
+        } catch (err) {
+          console.error('On-device translation error:', err);
+          setStatus(err.message || 'Unable to translate page on-device.', { isError: true });
+        } finally {
+          if (translator && typeof translator.destroy === 'function') {
+            translator.destroy();
+          }
+          translatableElements.forEach((el) => el.classList.remove('translating'));
+          langSelect.disabled = false;
+        }
+      }
+
+      langSelect.addEventListener('change', (event) => {
+        translatePage(event.target.value);
+      });
+    })();
+  </script>
 </body>
 
