diff --git a/src/components/TranslationControl.tsx b/src/components/TranslationControl.tsx
new file mode 100644
index 0000000..51326bd
--- /dev/null
+++ b/src/components/TranslationControl.tsx
@@ -0,0 +1,477 @@
+import React, { useState, useEffect, useId } from 'react';
+import { LanguageIcon, ArrowPathIcon } from '@heroicons/react/24/outline';
+
+export interface SupportedLanguage {
+  code: string;
+  label: string;
+}
+
+export const SUPPORTED_LANGUAGES: SupportedLanguage[] = [
+  { code: 'en', label: 'English' },
+  { code: 'es', label: 'Spanish (Español)' },
+  { code: 'fr', label: 'French (Français)' },
+  { code: 'de', label: 'German (Deutsch)' },
+  { code: 'it', label: 'Italian (Italiano)' },
+  { code: 'pt', label: 'Portuguese (Português)' },
+  { code: 'ja', label: 'Japanese (日本語)' },
+  { code: 'zh', label: 'Chinese (中文)' },
+  { code: 'ko', label: 'Korean (한국어)' },
+  { code: 'ar', label: 'Arabic (العربية)' },
+  { code: 'hi', label: 'Hindi (हिन्दी)' },
+  { code: 'nl', label: 'Dutch (Nederlands)' },
+  { code: 'pl', label: 'Polish (Polski)' },
+  { code: 'ru', label: 'Russian (Русский)' },
+  { code: 'tr', label: 'Turkish (Türkçe)' },
+  { code: 'vi', label: 'Vietnamese (Tiếng Việt)' },
+];
+
+type AvailabilityState =
+  | 'checking'
+  | 'available'
+  | 'downloadable'
+  | 'downloading'
+  | 'unavailable'
+  | 'unsupported';
+
+interface TranslationControlProps {
+  /** Selector or container ID to scope translation, or defaults to closest article/teaser or whole page */
+  scopeId?: string;
+  /** Compact variant for teaser cards vs full toolbar for article pages and header */
+  variant?: 'toolbar' | 'compact';
+  /** Default source language (BCP 47 code) */
+  defaultSourceLanguage?: string;
+  /** Default target language (BCP 47 code) */
+  defaultTargetLanguage?: string;
+}
+
+const originalTextStore = new WeakMap<Element, string>();
+const originalAttrStore = new WeakMap<Element, string>();
+
+function collectTranslatableElements(root: ParentNode): HTMLElement[] {
+  const marked = Array.from(
+    root.querySelectorAll<HTMLElement>('[data-translatable]')
+  );
+
+  // Also collect prose children inside any [data-translatable-prose] container
+  const proseContainers = Array.from(
+    root.querySelectorAll<HTMLElement>('[data-translatable-prose]')
+  );
+  const proseElements: HTMLElement[] = [];
+  for (const container of proseContainers) {
+    const blocks = container.querySelectorAll<HTMLElement>(
+      'p, h1, h2, h3, h4, h5, h6, li, blockquote, figcaption'
+    );
+    proseElements.push(...Array.from(blocks));
+  }
+
+  // Deduplicate while preserving order
+  const seen = new Set<HTMLElement>();
+  const result: HTMLElement[] = [];
+  for (const el of [...marked, ...proseElements]) {
+    if (!seen.has(el) && (el.textContent?.trim() ?? '').length > 0) {
+      seen.add(el);
+      result.push(el);
+    }
+  }
+  return result;
+}
+
+function getTargetRoot(
+  scopeId: string | undefined,
+  anchorEl: HTMLElement | null
+): ParentNode {
+  if (scopeId) {
+    const scoped = document.getElementById(scopeId);
+    if (scoped) return scoped;
+  }
+  if (anchorEl) {
+    const closestScope = anchorEl.closest('[data-translation-scope]');
+    if (closestScope) return closestScope;
+  }
+  return document;
+}
+
+export default function TranslationControl({
+  scopeId,
+  variant = 'toolbar',
+  defaultSourceLanguage = 'en',
+  defaultTargetLanguage = 'es',
+}: TranslationControlProps) {
+  const instanceId = useId();
+  const [sourceLanguage, setSourceLanguage] = useState(defaultSourceLanguage);
+  const [targetLanguage, setTargetLanguage] = useState(defaultTargetLanguage);
+  const [availability, setAvailability] =
+    useState<AvailabilityState>('checking');
+  const [isTranslating, setIsTranslating] = useState(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [isTranslated, setIsTranslated] = useState(false);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [anchorRef, setAnchorRef] = useState<HTMLDivElement | null>(null);
+
+  useEffect(() => {
+    let cancelled = false;
+
+    async function checkModelAvailability() {
+      setErrorMessage(null);
+
+      if (typeof self === 'undefined' || !('Translator' in self) || !self.Translator) {
+        if (!cancelled) {
+          setAvailability('unsupported');
+        }
+        return;
+      }
+
+      if (sourceLanguage === targetLanguage) {
+        if (!cancelled) {
+          setAvailability('available');
+        }
+        return;
+      }
+
+      setAvailability('checking');
+      try {
+        const options = { sourceLanguage, targetLanguage };
+        const status = await self.Translator.availability(options);
+        if (!cancelled) {
+          setAvailability(status);
+        }
+      } catch (err) {
+        if (!cancelled) {
+          setAvailability('unavailable');
+        }
+      }
+    }
+
+    checkModelAvailability();
+
+    return () => {
+      cancelled = true;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  const handleRestoreOriginal = () => {
+    const root = getTargetRoot(scopeId, anchorRef);
+    const elements = collectTranslatableElements(root);
+    for (const el of elements) {
+      const original = originalTextStore.get(el);
+      if (original !== undefined) {
+        el.textContent = original;
+      }
+      const origLang = originalAttrStore.get(el);
+      if (origLang !== undefined) {
+        if (origLang === '') {
+          el.removeAttribute('lang');
+        } else {
+          el.setAttribute('lang', origLang);
+        }
+      }
+    }
+    setIsTranslated(false);
+    setErrorMessage(null);
+  };
+
+  const handleTranslate = async () => {
+    setErrorMessage(null);
+
+    if (sourceLanguage === targetLanguage) {
+      handleRestoreOriginal();
+      return;
+    }
+
+    if (typeof self === 'undefined' || !('Translator' in self) || !self.Translator) {
+      setAvailability('unsupported');
+      setErrorMessage(
+        'Client-side translation is currently unsupported in this browser.'
+      );
+      return;
+    }
+
+    const options = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    try {
+      setIsTranslating(true);
+      setDownloadProgress(null);
+
+      // Check availability with identical options object
+      const currentAvailability = await self.Translator.availability(options);
+      setAvailability(currentAvailability);
+
+      if (currentAvailability === 'unavailable') {
+        setErrorMessage(
+          `On-device translation from ${sourceLanguage.toUpperCase()} to ${targetLanguage.toUpperCase()} is unavailable on this device.`
+        );
+        setIsTranslating(false);
+        return;
+      }
+
+      // Instantiate translator inside user gesture handler with downloadprogress monitor
+      const translator = await self.Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            if (typeof e.loaded === 'number') {
+              setDownloadProgress(Math.round(e.loaded * 100));
+            }
+          });
+        },
+      });
+
+      setDownloadProgress(null);
+
+      const root = getTargetRoot(scopeId, anchorRef);
+      const elements = collectTranslatableElements(root);
+
+      for (const el of elements) {
+        if (!originalTextStore.has(el)) {
+          originalTextStore.set(el, el.textContent ?? '');
+        }
+        if (!originalAttrStore.has(el)) {
+          originalAttrStore.set(el, el.getAttribute('lang') ?? '');
+        }
+
+        const sourceText =
+          sourceLanguage === 'en'
+            ? (originalTextStore.get(el) ?? el.textContent ?? '')
+            : (el.textContent ?? '');
+
+        const trimmed = sourceText.trim();
+        if (!trimmed) continue;
+
+        if (trimmed.length > 350 && typeof translator.translateStreaming === 'function') {
+          const stream = translator.translateStreaming(trimmed);
+          let accumulated = '';
+          for await (const chunk of stream) {
+            accumulated += chunk;
+            el.textContent = accumulated;
+          }
+        } else {
+          const translated = await translator.translate(trimmed);
+          el.textContent = translated;
+        }
+        el.setAttribute('lang', targetLanguage);
+      }
+
+      if (typeof translator.destroy === 'function') {
+        translator.destroy();
+      }
+
+      setIsTranslated(true);
+      setAvailability('available');
+    } catch (err: any) {
+      setErrorMessage(
+        err?.message || 'Unable to complete on-device translation.'
+      );
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  const isDisabled =
+    isTranslating ||
+    availability === 'unsupported' ||
+    availability === 'unavailable' ||
+    availability === 'checking';
+
+  if (variant === 'compact') {
+    return (
+      <div
+        ref={setAnchorRef}
+        className="inline-flex flex-wrap items-center gap-1.5 text-xs text-gray-600"
+        onClick={(e) => e.stopPropagation()}
+      >
+        <LanguageIcon className="w-4 h-4 text-gray-500 flex-shrink-0" aria-hidden="true" />
+        <label htmlFor={`target-lang-${instanceId}`} className="sr-only">
+          Translate to language
+        </label>
+        <select
+          id={`target-lang-${instanceId}`}
+          value={targetLanguage}
+          onChange={(e) => setTargetLanguage(e.target.value)}
+          disabled={isTranslating || availability === 'unsupported'}
+          className="border border-gray-300 rounded px-1.5 py-0.5 bg-white text-xs text-gray-700 focus:outline-none focus:ring-1 focus:ring-amber-500 disabled:opacity-50"
+          aria-label="Target language"
+        >
+          {SUPPORTED_LANGUAGES.filter((l) => l.code !== sourceLanguage).map(
+            (lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.label}
+              </option>
+            )
+          )}
+        </select>
+
+        <button
+          type="button"
+          onClick={handleTranslate}
+          disabled={isDisabled}
+          title={
+            availability === 'unsupported'
+              ? 'Client-side translation is currently unsupported in this browser'
+              : availability === 'unavailable'
+                ? 'Language pair unavailable on this device'
+                : 'Translate on-device'
+          }
+          className="px-2 py-0.5 rounded bg-amber-500 text-white font-medium hover:bg-amber-600 disabled:bg-gray-200 disabled:text-gray-500 disabled:cursor-not-allowed transition-colors cursor-pointer"
+        >
+          {isTranslating
+            ? downloadProgress !== null
+              ? `Downloading ${downloadProgress}%`
+              : 'Translating…'
+            : availability === 'downloadable'
+              ? 'Download & Translate'
+              : 'Translate'}
+        </button>
+
+        {isTranslated && (
+          <button
+            type="button"
+            onClick={handleRestoreOriginal}
+            disabled={isTranslating}
+            className="px-1.5 py-0.5 rounded border border-gray-300 text-gray-600 hover:bg-gray-100 transition-colors cursor-pointer"
+          >
+            Original
+          </button>
+        )}
+      </div>
+    );
+  }
+
+  return (
+    <div
+      ref={setAnchorRef}
+      className="bg-amber-50/60 border border-amber-200/80 rounded-lg p-3 my-3 text-sm"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-2 text-gray-800 font-semibold">
+          <LanguageIcon className="w-5 h-5 text-amber-700 flex-shrink-0" aria-hidden="true" />
+          <span>On-Device Translation</span>
+          {availability === 'available' && (
+            <span className="text-xs font-normal px-2 py-0.5 rounded-full bg-green-100 text-green-800">
+              Model Ready
+            </span>
+          )}
+          {(availability === 'downloadable' || availability === 'downloading') && (
+            <span className="text-xs font-normal px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">
+              Model Download Required
+            </span>
+          )}
+          {(availability === 'unsupported' || availability === 'unavailable') && (
+            <span className="text-xs font-normal px-2 py-0.5 rounded-full bg-gray-200 text-gray-700">
+              Unavailable
+            </span>
+          )}
+        </div>
+
+        <div className="flex flex-wrap items-center gap-2">
+          <div className="flex items-center gap-1.5">
+            <label
+              htmlFor={`source-${instanceId}`}
+              className="text-xs text-gray-600 font-medium"
+            >
+              From
+            </label>
+            <select
+              id={`source-${instanceId}`}
+              value={sourceLanguage}
+              onChange={(e) => setSourceLanguage(e.target.value)}
+              disabled={isTranslating || availability === 'unsupported'}
+              className="border border-gray-300 rounded px-2 py-1 bg-white text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-500 disabled:opacity-50"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.label}
+                </option>
+              ))}
+            </select>
+          </div>
+
+          <div className="flex items-center gap-1.5">
+            <label
+              htmlFor={`target-${instanceId}`}
+              className="text-xs text-gray-600 font-medium"
+            >
+              To
+            </label>
+            <select
+              id={`target-${instanceId}`}
+              value={targetLanguage}
+              onChange={(e) => setTargetLanguage(e.target.value)}
+              disabled={isTranslating || availability === 'unsupported'}
+              className="border border-gray-300 rounded px-2 py-1 bg-white text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-500 disabled:opacity-50"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.label}
+                </option>
+              ))}
+            </select>
+          </div>
+
+          <button
+            type="button"
+            onClick={handleTranslate}
+            disabled={isDisabled}
+            className="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-gray-900 text-white text-xs font-semibold hover:bg-amber-600 disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed transition-colors cursor-pointer"
+          >
+            {isTranslating && (
+              <ArrowPathIcon className="w-3.5 h-3.5 animate-spin" aria-hidden="true" />
+            )}
+            <span>
+              {isTranslating
+                ? downloadProgress !== null
+                  ? `Downloading model (${downloadProgress}%)…`
+                  : 'Translating…'
+                : availability === 'downloadable' || availability === 'downloading'
+                  ? 'Download & Translate'
+                  : 'Translate'}
+            </span>
+          </button>
+
+          {isTranslated && (
+            <button
+              type="button"
+              onClick={handleRestoreOriginal}
+              disabled={isTranslating}
+              className="px-2.5 py-1 rounded border border-gray-300 bg-white text-gray-700 text-xs font-medium hover:bg-gray-100 transition-colors cursor-pointer"
+            >
+              Show Original
+            </button>
+          )}
+        </div>
+      </div>
+
+      {downloadProgress !== null && (
+        <div className="mt-2">
+          <div className="w-full bg-gray-200 rounded-full h-1.5 overflow-hidden">
+            <div
+              className="bg-amber-600 h-1.5 transition-all duration-200"
+              style={{ width: `${downloadProgress}%` }}
+            />
+          </div>
+        </div>
+      )}
+
+      {availability === 'unsupported' && (
+        <p className="mt-2 text-xs text-gray-600" role="status">
+          Client-side translation is currently unsupported in this browser. Use Chrome 138+ or Edge 148+ on desktop for built-in on-device AI translation.
+        </p>
+      )}
+
+      {availability === 'unavailable' && (
+        <p className="mt-2 text-xs text-gray-600" role="status">
+          The selected language pair ({sourceLanguage.toUpperCase()} → {targetLanguage.toUpperCase()}) is unavailable for on-device translation on this device.
+        </p>
+      )}
+
+      {errorMessage && (
+        <p className="mt-2 text-xs text-red-600" role="alert">
+          {errorMessage}
+        </p>
+      )}
+    </div>
+  );
+}
