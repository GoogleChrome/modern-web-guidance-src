+// Cache of active Translator instances by `source-target`
+const translatorCache = new Map<string, TranslatorInstance>();
+// Cache of translated strings by `source-target:text`
+const textTranslationCache = new Map<string, string>();
+
+/**
+ * Checks whether the browser supports built-in on-device AI translation (window.Translator).
+ */
+export function getBrowserTranslatorAPI(): TranslatorStatic | null {
+  if (typeof window === 'undefined') return null;
+  if ('Translator' in window && window.Translator) {
+    return window.Translator;
+  }
+  if (window.ai?.translator) {
+    return window.ai.translator;
+  }
+  if (window.translation?.createTranslator) {
+    return {
+      availability: async (opts) => {
+        if (window.translation?.canTranslate) {
+          return await window.translation.canTranslate(opts);
+        }
+        return 'available';
+      },
+      create: (opts) => window.translation!.createTranslator!(opts),
+    };
+  }
+  return null;
+}
+
+/**
+ * Checks availability of a language pair in the browser's on-device Translator API.
+ */
+export async function checkTranslationAvailability(
+  sourceLanguage: LanguageCode,
+  targetLanguage: LanguageCode
+): Promise<AvailabilityStatus> {
+  if (sourceLanguage === targetLanguage) return 'available';
+  const api = getBrowserTranslatorAPI();
+  if (!api) return 'fallback';
+
+  try {
+    if (typeof api.availability === 'function') {
+      const result = await api.availability({ sourceLanguage, targetLanguage });
+      if (result === 'available' || result === 'readily') return 'available';
+      if (result === 'downloadable' || result === 'after-download') return 'downloadable';
+      if (result === 'downloading') return 'downloading';
+      return 'fallback';
+    }
+    if (typeof api.capabilities === 'function') {
+      const caps = await api.capabilities({ sourceLanguage, targetLanguage });
+      if (caps.available === 'readily') return 'available';
+      if (caps.available === 'after-download') return 'downloadable';
+    }
+  } catch {
+    // Fallback to local dictionary engine if API throws
+  }
+  return 'fallback';
+}
+
+/**
+ * Fallback on-device translation when the browser's built-in AI model is unavailable.
+ */
+export function translateWithFallback(
+  text: string,
+  sourceLanguage: LanguageCode,
+  targetLanguage: LanguageCode
+): string {
+  const trimmed = text.trim();
+  if (!trimmed || sourceLanguage === targetLanguage) return text;
+
+  // Check exact phrase match first
+  const exactEntry = PHRASE_DICTIONARY[trimmed];
+  if (exactEntry && exactEntry[targetLanguage]) {
+    return text.replace(trimmed, exactEntry[targetLanguage]!);
+  }
+
+  // Apply phrase and word replacements
+  let result = text;
+  for (const [phrase, translations] of Object.entries(PHRASE_DICTIONARY)) {
+    const targetPhrase = translations[targetLanguage];
+    if (targetPhrase && result.includes(phrase)) {
+      result = result.split(phrase).join(targetPhrase);
+    }
+  }
+
+  const rules = WORD_REPLACEMENTS[targetLanguage] || [];
+  for (const [pattern, replacement] of rules) {
+    result = result.replace(pattern, replacement);
+  }
+
+  return result;
+}
+
+/**
+ * Translates a single text string using the browser's Built-in On-Device Translator API
+ * (`window.Translator`) if available, or falls back to the built-in local translation engine.
+ */
+export async function translateText(
+  text: string,
+  sourceLanguage: LanguageCode,
+  targetLanguage: LanguageCode,
+  onDownloadProgress?: (progress: number) => void
+): Promise<{ translatedText: string; engine: EngineMode }> {
+  const trimmed = text.trim();
+  if (!trimmed || sourceLanguage === targetLanguage) {
+    return { translatedText: text, engine: 'browser-ai' };
+  }
+
+  const pairKey = `${sourceLanguage}->${targetLanguage}`;
+  const cacheKey = `${pairKey}:${trimmed}`;
+  if (textTranslationCache.has(cacheKey)) {
+    const api = getBrowserTranslatorAPI();
+    return {
+      translatedText: textTranslationCache.get(cacheKey)!,
+      engine: api && translatorCache.has(pairKey) ? 'browser-ai' : 'local-fallback',
+    };
+  }
+
+  const api = getBrowserTranslatorAPI();
+  if (api) {
+    try {
+      let translator = translatorCache.get(pairKey);
+      if (!translator) {
+        translator = await api.create({
+          sourceLanguage,
+          targetLanguage,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const pct = e.total ? Math.round((e.loaded / e.total) * 100) : Math.round(e.loaded * 100);
+              onDownloadProgress?.(Math.min(100, Math.max(0, pct)));
+            });
+          },
+        });
+        translatorCache.set(pairKey, translator);
+      }
+      const output = await translator.translate(trimmed);
+      if (output) {
+        textTranslationCache.set(cacheKey, output);
+        return { translatedText: output, engine: 'browser-ai' };
+      }
+    } catch {
+      // Fall through to on-device fallback dictionary
+    }
+  }
+
+  const fallbackOutput = translateWithFallback(text, sourceLanguage, targetLanguage);
+  textTranslationCache.set(cacheKey, fallbackOutput);
+  return { translatedText: fallbackOutput, engine: 'local-fallback' };
+}
+
+/**
+ * Translates all DOM elements within `root` (or the entire document) that are marked
+ * with `[data-translatable]` or are inside `[data-translatable-prose]`.
+ */
+export async function translateDOMElements(
+  root: ParentNode,
+  sourceLanguage: LanguageCode,
+  targetLanguage: LanguageCode,
+  options?: {
+    onProgress?: (progress: TranslationProgress) => void;
+    signal?: AbortSignal;
+  }
+): Promise<TranslationProgress> {
+  const elements = collectTranslatableElements(root);
+
+  if (targetLanguage === 'en' && sourceLanguage === 'en') {
+    restoreOriginalDOMElements(root);
+    const doneProgress: TranslationProgress = {
+      status: 'idle',
+      sourceLanguage,
+      targetLanguage,
+      engine: getBrowserTranslatorAPI() ? 'browser-ai' : 'local-fallback',
+      translatedCount: 0,
+      totalCount: elements.length,
+    };
+    options?.onProgress?.(doneProgress);
+    return doneProgress;
+  }
+
+  // First restore originals so we always translate cleanly from the source text
+  restoreOriginalDOMElements(root);
+
+  let activeEngine: EngineMode = getBrowserTranslatorAPI() ? 'browser-ai' : 'local-fallback';
+  const totalCount = elements.length;
+
+  options?.onProgress?.({
+    status: 'translating',
+    sourceLanguage,
+    targetLanguage,
+    engine: activeEngine,
+    translatedCount: 0,
+    totalCount,
+  });
+
+  let translatedCount = 0;
+
+  for (const el of elements) {
+    if (options?.signal?.aborted) {
+      break;
+    }
+
+    const originalText = el.getAttribute('data-original-text') ?? el.textContent ?? '';
+    if (!originalText.trim()) {
+      translatedCount++;
+      continue;
+    }
+
+    if (!el.hasAttribute('data-original-text')) {
+      el.setAttribute('data-original-text', originalText);
+    }
+
+    const { translatedText, engine } = await translateText(
+      originalText,
+      sourceLanguage,
+      targetLanguage,
+      (downloadProgress) => {
+        options?.onProgress?.({
+          status: 'downloading',
+          sourceLanguage,
+          targetLanguage,
+          engine: 'browser-ai',
+          downloadProgress,
+          translatedCount,
+          totalCount,
+        });
+      }
+    );
+
+    activeEngine = engine;
+    el.textContent = translatedText;
+    el.setAttribute('data-translated-lang', targetLanguage);
+    el.setAttribute('lang', targetLanguage);
+
+    translatedCount++;
+    options?.onProgress?.({
+      status: 'translating',
+      sourceLanguage,
+      targetLanguage,
+      engine: activeEngine,
+      translatedCount,
+      totalCount,
+    });
+  }
+
+  const finalState: TranslationProgress = {
+    status: 'translated',
+    sourceLanguage,
+    targetLanguage,
+    engine: activeEngine,
+    translatedCount,
+    totalCount,
+  };
+  options?.onProgress?.(finalState);
+  return finalState;
+}
+
+/**
+ * Restores all translated elements within `root` back to their original text.
+ */
+export function restoreOriginalDOMElements(root: ParentNode): void {
+  const elements = root.querySelectorAll<HTMLElement>('[data-original-text]');
+  elements.forEach((el) => {
+    const original = el.getAttribute('data-original-text');
+    if (original !== null) {
+      el.textContent = original;
+    }
+    el.removeAttribute('data-translated-lang');
+    el.removeAttribute('lang');
+  });
+}
+
+/**
+ * Collects leaf translatable elements inside `root`.
+ * Supports explicit `[data-translatable]` elements as well as block elements inside `[data-translatable-prose]`.
+ */
+export function collectTranslatableElements(root: ParentNode): HTMLElement[] {
+  const result: HTMLElement[] = [];
+  const seen = new Set<HTMLElement>();
+
+  // 1. Explicit [data-translatable] elements
+  const explicit = root.querySelectorAll<HTMLElement>('[data-translatable]');
+  explicit.forEach((el) => {
+    if (!seen.has(el)) {
+      seen.add(el);
+      result.push(el);
+    }
+  });
+
+  // 2. Prose content children inside [data-translatable-prose]
+  const proseContainers = root.querySelectorAll<HTMLElement>('[data-translatable-prose]');
+  proseContainers.forEach((container) => {
+    const proseBlocks = container.querySelectorAll<HTMLElement>('p, h1, h2, h3, h4, h5, h6, li, blockquote, figcaption');
+    proseBlocks.forEach((block) => {
+      if (!seen.has(block)) {
+        seen.add(block);
+        result.push(block);
+      }
+    });
+  });
+
+  return result;
+}
+
+const STORAGE_KEY_TARGET = 'devtools_times_target_lang';
+const STORAGE_KEY_SOURCE = 'devtools_times_source_lang';
+
+export function getSavedLanguagePrefs(): { sourceLanguage: LanguageCode; targetLanguage: LanguageCode } {
+  if (typeof window === 'undefined') {
+    return { sourceLanguage: 'en', targetLanguage: 'en' };
+  }
+  try {
+    const savedTarget = localStorage.getItem(STORAGE_KEY_TARGET) as LanguageCode | null;
+    const savedSource = localStorage.getItem(STORAGE_KEY_SOURCE) as LanguageCode | null;
+    const validCodes = new Set(SUPPORTED_LANGUAGES.map((l) => l.code));
+    return {
+      sourceLanguage: savedSource && validCodes.has(savedSource) ? savedSource : 'en',
+      targetLanguage: savedTarget && validCodes.has(savedTarget) ? savedTarget : 'en',
+    };
+  } catch {
+    return { sourceLanguage: 'en', targetLanguage: 'en' };
+  }
+}
+
+export function saveLanguagePrefs(sourceLanguage: LanguageCode, targetLanguage: LanguageCode): void {
+  if (typeof window === 'undefined') return;
+  try {
+    localStorage.setItem(STORAGE_KEY_SOURCE, sourceLanguage);
+    localStorage.setItem(STORAGE_KEY_TARGET, targetLanguage);
+  } catch {
+    // ignore storage errors
+  }
+}
