diff --git a/src/components/ArticleTranslationControl.tsx b/src/components/ArticleTranslationControl.tsx
new file mode 100644
index 0000000..b0e9203
--- /dev/null
+++ b/src/components/ArticleTranslationControl.tsx
@@ -0,0 +1,448 @@
+import React, { useState, useEffect, useRef, useCallback } from 'react';
+import { LanguageIcon, ArrowPathIcon, CheckCircleIcon, SparklesIcon } from '@heroicons/react/24/outline';
+import {
+  SUPPORTED_LANGUAGES,
+  type LanguageCode,
+  type TranslationProgress,
+  type AvailabilityStatus,
+  checkTranslationAvailability,
+  translateDOMElements,
+  restoreOriginalDOMElements,
+  getSavedLanguagePrefs,
+  saveLanguagePrefs,
+  getBrowserTranslatorAPI,
+} from '../utils/translator';
+
+interface ArticleTranslationControlProps {
+  /**
+   * Presentation variant:
+   * - 'header': Compact global translation control in the site header
+   * - 'article': Rich inline translation toolbar on the article detail page
+   * - 'teaser': Compact per-teaser translation menu/control
+   */
+  variant?: 'header' | 'article' | 'teaser';
+  /**
+   * Optional CSS selector or DOM id to scope translation (defaults to `document` for 'header',
+   * closest `article` for 'article' / 'teaser').
+   */
+  scopeSelector?: string;
+}
+
+export default function ArticleTranslationControl({
+  variant = 'article',
+  scopeSelector,
+}: ArticleTranslationControlProps) {
+  const [sourceLang, setSourceLang] = useState<LanguageCode>('en');
+  const [targetLang, setTargetLang] = useState<LanguageCode>('en');
+  const [availability, setAvailability] = useState<AvailabilityStatus>('available');
+  const [hasBrowserAI, setHasBrowserAI] = useState<boolean>(false);
+  const [progress, setProgress] = useState<TranslationProgress>({
+    status: 'idle',
+    sourceLanguage: 'en',
+    targetLanguage: 'en',
+    engine: 'local-fallback',
+  });
+  const [isOpen, setIsOpen] = useState(false);
+
+  const rootRef = useRef<HTMLDivElement>(null);
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  const resolveScopeRoot = useCallback((): ParentNode => {
+    if (typeof document === 'undefined') return null as unknown as ParentNode;
+    if (scopeSelector) {
+      const matched = document.querySelector(scopeSelector);
+      if (matched) return matched;
+    }
+    if (variant === 'teaser' && rootRef.current) {
+      const closestCard = rootRef.current.closest('[data-translatable-card], article, .teaser-card');
+      if (closestCard) return closestCard;
+    }
+    if (variant === 'article' && rootRef.current) {
+      const closestArticle = rootRef.current.closest('article') || document.querySelector('main');
+      if (closestArticle) return closestArticle;
+    }
+    return document;
+  }, [scopeSelector, variant]);
+
+  const runTranslation = useCallback(
+    async (src: LanguageCode, tgt: LanguageCode, broadcast = true) => {
+      const scopeRoot = resolveScopeRoot();
+      if (!scopeRoot) return;
+
+      if (abortControllerRef.current) {
+        abortControllerRef.current.abort();
+      }
+      const controller = new AbortController();
+      abortControllerRef.current = controller;
+
+      if (tgt === 'en' && src === 'en') {
+        restoreOriginalDOMElements(scopeRoot);
+        setProgress({
+          status: 'idle',
+          sourceLanguage: src,
+          targetLanguage: tgt,
+          engine: getBrowserTranslatorAPI() ? 'browser-ai' : 'local-fallback',
+        });
+      } else {
+        await translateDOMElements(scopeRoot, src, tgt, {
+          signal: controller.signal,
+          onProgress: (p) => setProgress(p),
+        });
+      }
+
+      if (broadcast && variant !== 'teaser') {
+        saveLanguagePrefs(src, tgt);
+        window.dispatchEvent(
+          new CustomEvent('devtools-times:language-change', {
+            detail: { sourceLanguage: src, targetLanguage: tgt },
+          })
+        );
+      }
+    },
+    [resolveScopeRoot, variant]
+  );
+
+  // Check browser AI support & sync initial language preference
+  useEffect(() => {
+    const api = getBrowserTranslatorAPI();
+    setHasBrowserAI(Boolean(api));
+
+    if (variant !== 'teaser') {
+      const prefs = getSavedLanguagePrefs();
+      setSourceLang(prefs.sourceLanguage);
+      setTargetLang(prefs.targetLanguage);
+      if (prefs.targetLanguage !== 'en') {
+        runTranslation(prefs.sourceLanguage, prefs.targetLanguage, false);
+      }
+    }
+  }, [variant, runTranslation]);
+
+  // Listen for global language changes and Astro page transitions
+  useEffect(() => {
+    if (variant === 'teaser') return;
+
+    const handleGlobalLangChange = (e: Event) => {
+      const customEvent = e as CustomEvent<{ sourceLanguage: LanguageCode; targetLanguage: LanguageCode }>;
+      if (!customEvent.detail) return;
+      const { sourceLanguage: newSrc, targetLanguage: newTgt } = customEvent.detail;
+      setSourceLang(newSrc);
+      setTargetLang(newTgt);
+      runTranslation(newSrc, newTgt, false);
+    };
+
+    const handlePageLoad = () => {
+      const prefs = getSavedLanguagePrefs();
+      setSourceLang(prefs.sourceLanguage);
+      setTargetLang(prefs.targetLanguage);
+      if (prefs.targetLanguage !== 'en') {
+        runTranslation(prefs.sourceLanguage, prefs.targetLanguage, false);
+      }
+    };
+
+    window.addEventListener('devtools-times:language-change', handleGlobalLangChange);
+    document.addEventListener('astro:page-load', handlePageLoad);
+
+    return () => {
+      window.removeEventListener('devtools-times:language-change', handleGlobalLangChange);
+      document.removeEventListener('astro:page-load', handlePageLoad);
+    };
+  }, [variant, runTranslation]);
+
+  // Update availability status when language pair changes
+  useEffect(() => {
+    let mounted = true;
+    checkTranslationAvailability(sourceLang, targetLang).then((status) => {
+      if (mounted) setAvailability(status);
+    });
+    return () => {
+      mounted = false;
+    };
+  }, [sourceLang, targetLang]);
+
+  // Close popover on outside click
+  useEffect(() => {
+    if (!isOpen) return;
+    const handleClickOutside = (e: MouseEvent) => {
+      if (rootRef.current && !rootRef.current.contains(e.target as Node)) {
+        setIsOpen(false);
+      }
+    };
+    document.addEventListener('mousedown', handleClickOutside);
+    return () => document.removeEventListener('mousedown', handleClickOutside);
+  }, [isOpen]);
+
+  const handleTargetChange = (newTarget: LanguageCode) => {
+    setTargetLang(newTarget);
+    runTranslation(sourceLang, newTarget, variant !== 'teaser');
+  };
+
+  const handleSourceChange = (newSource: LanguageCode) => {
+    setSourceLang(newSource);
+    if (targetLang !== newSource) {
+      runTranslation(newSource, targetLang, variant !== 'teaser');
+    }
+  };
+
+  const handleReset = () => {
+    setSourceLang('en');
+    setTargetLang('en');
+    runTranslation('en', 'en', variant !== 'teaser');
+    setIsOpen(false);
+  };
+
+  const isTranslating = progress.status === 'translating' || progress.status === 'downloading';
+  const isTranslated = progress.status === 'translated' && targetLang !== 'en';
+  const activeLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === targetLang) || SUPPORTED_LANGUAGES[0];
+
+  if (variant === 'teaser') {
+    return (
+      <div ref={rootRef} className="relative inline-flex items-center" data-translation-control="teaser">
+        <button
+          type="button"
+          onClick={(e) => {
+            e.preventDefault();
+            e.stopPropagation();
+            setIsOpen((prev) => !prev);
+          }}
+          title="Translate teaser on-device"
+          aria-label="Translate teaser"
+          className={`inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-medium transition-colors ${
+            isTranslated
+              ? 'bg-amber-100 text-amber-900 border border-amber-300'
+              : 'text-gray-500 hover:text-amber-600 hover:bg-gray-100'
+          }`}
+        >
+          <LanguageIcon className="w-4 h-4" />
+          <span>{isTranslated ? activeLangObj.code.toUpperCase() : 'Translate'}</span>
+        </button>
+
+        {isOpen && (
+          <div
+            onClick={(e) => {
+              e.preventDefault();
+              e.stopPropagation();
+            }}
+            className="absolute bottom-full right-0 mb-1.5 w-52 bg-white border border-gray-200 rounded-lg shadow-lg p-2.5 z-30 text-xs"
+          >
+            <div className="flex items-center justify-between pb-1.5 mb-2 border-b border-gray-100">
+              <span className="font-semibold text-gray-800 flex items-center gap-1">
+                <SparklesIcon className="w-3.5 h-3.5 text-amber-500" />
+                On-Device Translate
+              </span>
+              {isTranslated && (
+                <button
+                  type="button"
+                  onClick={handleReset}
+                  className="text-amber-700 hover:underline font-medium"
+                >
+                  Reset
+                </button>
+              )}
+            </div>
+            <label className="block text-[11px] text-gray-500 mb-1">Target Language</label>
+            <select
+              aria-label="Select teaser translation language"
+              value={targetLang}
+              onChange={(e) => {
+                handleTargetChange(e.target.value as LanguageCode);
+                setIsOpen(false);
+              }}
+              className="w-full border border-gray-300 rounded px-2 py-1 text-gray-800 bg-white focus:outline-none focus:ring-1 focus:ring-amber-500"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.flag} {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+        )}
+      </div>
+    );
+  }
+
+  if (variant === 'header') {
+    return (
+      <div ref={rootRef} className="relative inline-flex items-center" data-translation-control="header">
+        <div className="inline-flex items-center bg-gray-100 hover:bg-gray-200/80 border border-gray-300 rounded px-2 py-1 text-xs transition-colors">
+          <LanguageIcon className="w-4 h-4 text-gray-700 mr-1.5 flex-shrink-0" />
+          <label htmlFor="header-language-select" className="sr-only">
+            Translate page on-device
+          </label>
+          <select
+            id="header-language-select"
+            aria-label="Translate page on-device"
+            value={targetLang}
+            onChange={(e) => handleTargetChange(e.target.value as LanguageCode)}
+            className="bg-transparent text-gray-800 font-semibold text-xs focus:outline-none cursor-pointer pr-1"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.code === 'en' ? 'Translate: Original (EN)' : `${lang.flag} ${lang.name}`}
+              </option>
+            ))}
+          </select>
+          {isTranslating && (
+            <ArrowPathIcon className="w-3.5 h-3.5 text-amber-600 animate-spin ml-1 flex-shrink-0" />
+          )}
+          {isTranslated && !isTranslating && (
+            <button
+              type="button"
+              onClick={handleReset}
+              title="Restore original language"
+              className="ml-1.5 text-[11px] text-amber-800 hover:text-amber-950 font-semibold underline"
+            >
+              Reset
+            </button>
+          )}
+        </div>
+      </div>
+    );
+  }
+
+  // Default: 'article' variant — rich on-device translation control bar
+  return (
+    <div
+      ref={rootRef}
+      data-translation-control="article"
+      className="my-4 p-3.5 sm:p-4 rounded-lg border border-gray-200 bg-gray-50/90 shadow-xs"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        {/* Left: Label & On-device badge */}
+        <div className="flex items-center gap-2">
+          <div className="w-8 h-8 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center flex-shrink-0">
+            <LanguageIcon className="w-5 h-5" />
+          </div>
+          <div>
+            <div className="flex items-center gap-2">
+              <span className="text-sm font-semibold text-gray-900">
+                On-Device Article Translation
+              </span>
+              <span
+                className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium ${
+                  hasBrowserAI
+                    ? 'bg-emerald-100 text-emerald-800'
+                    : 'bg-amber-100 text-amber-800'
+                }`}
+              >
+                <SparklesIcon className="w-3 h-3" />
+                {hasBrowserAI ? 'Browser Built-in AI' : 'On-Device Engine'}
+              </span>
+            </div>
+            <p className="text-xs text-gray-500">
+              Translate this article and teasers directly in your browser without sending text to a server.
+            </p>
+          </div>
+        </div>
+
+        {/* Right: Language selectors & actions */}
+        <div className="flex flex-wrap items-center gap-2">
+          <div className="flex items-center gap-1.5 text-xs">
+            <label htmlFor="article-source-lang" className="text-gray-600 font-medium">
+              From:
+            </label>
+            <select
+              id="article-source-lang"
+              aria-label="Source language"
+              value={sourceLang}
+              onChange={(e) => handleSourceChange(e.target.value as LanguageCode)}
+              className="border border-gray-300 rounded-md px-2 py-1.5 bg-white text-gray-800 font-medium text-xs focus:outline-none focus:ring-2 focus:ring-amber-400"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.flag} {lang.name}
+                </option>
+              ))}
+            </select>
+          </div>
+
+          <span className="text-gray-400 text-xs font-bold">→</span>
+
+          <div className="flex items-center gap-1.5 text-xs">
+            <label htmlFor="article-target-lang" className="text-gray-600 font-medium">
+              To:
+            </label>
+            <select
+              id="article-target-lang"
+              aria-label="Target language"
+              value={targetLang}
+              onChange={(e) => handleTargetChange(e.target.value as LanguageCode)}
+              className="border border-gray-300 rounded-md px-2.5 py-1.5 bg-white text-gray-900 font-semibold text-xs focus:outline-none focus:ring-2 focus:ring-amber-400"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={lang.code} value={lang.code}>
+                  {lang.flag} {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+
+          <button
+            type="button"
+            onClick={() => runTranslation(sourceLang, targetLang, true)}
+            disabled={isTranslating || sourceLang === targetLang}
+            className="inline-flex items-center gap-1.5 bg-gray-900 hover:bg-gray-800 disabled:bg-gray-300 disabled:text-gray-500 text-white text-xs font-semibold px-3 py-1.5 rounded-md transition-colors cursor-pointer disabled:cursor-not-allowed"
+          >
+            {isTranslating ? (
+              <>
+                <ArrowPathIcon className="w-3.5 h-3.5 animate-spin" />
+                <span>Translating…</span>
+              </>
+            ) : (
+              <span>Translate</span>
+            )}
+          </button>
+
+          {(isTranslated || targetLang !== 'en') && (
+            <button
+              type="button"
+              onClick={handleReset}
+              className="inline-flex items-center gap-1 border border-gray-300 bg-white hover:bg-gray-100 text-gray-700 text-xs font-medium px-2.5 py-1.5 rounded-md transition-colors cursor-pointer"
+            >
+              Show Original
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Status / Progress bar when downloading model or after translating */}
+      {(isTranslating || isTranslated) && (
+        <div className="mt-2.5 pt-2 border-t border-gray-200/80 flex flex-wrap items-center justify-between gap-2 text-xs">
+          {progress.status === 'downloading' && (
+            <div className="flex items-center gap-2 text-amber-800 w-full">
+              <ArrowPathIcon className="w-4 h-4 animate-spin flex-shrink-0" />
+              <span>
+                Downloading on-device language pack ({progress.downloadProgress ?? 0}%)…
+              </span>
+              <div className="flex-grow bg-gray-200 rounded-full h-1.5 max-w-xs overflow-hidden">
+                <div
+                  className="bg-amber-500 h-1.5 transition-all duration-200"
+                  style={{ width: `${progress.downloadProgress ?? 0}%` }}
+                />
+              </div>
+            </div>
+          )}
+
+          {progress.status === 'translating' && (
+            <div className="flex items-center gap-2 text-gray-600">
+              <ArrowPathIcon className="w-3.5 h-3.5 animate-spin text-amber-600" />
+              <span>
+                Translating on-device ({progress.translatedCount ?? 0}/{progress.totalCount ?? 0} sections)…
+              </span>
+            </div>
+          )}
+
+          {isTranslated && (
+            <div className="flex items-center gap-1.5 text-emerald-700 font-medium">
+              <CheckCircleIcon className="w-4 h-4" />
+              <span>
+                Translated to {activeLangObj.name} ({activeLangObj.nativeName}) on-device
+                {availability === 'downloadable' ? ' (model ready)' : ''}
+              </span>
+            </div>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
