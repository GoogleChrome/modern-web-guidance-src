+  <script>
+    (() => {
+      const drawer = document.getElementById('nav-drawer');
+      const toggleBtn = document.querySelector('.menu-toggle-btn');
+      const closeBtn = document.querySelector('.drawer-close-btn');
+      if (!drawer || !toggleBtn) return;
+
+      const supportsPopover = typeof drawer.showPopover === 'function';
+
+      const isOpen = () =>
+        (supportsPopover && drawer.matches(':popover-open')) || drawer.hasAttribute('open');
+
+      const openDrawer = () => {
+        if (supportsPopover) {
+          drawer.showPopover();
+        } else if (typeof drawer.showModal === 'function') {
+          drawer.showModal();
+        } else {
+          drawer.setAttribute('open', '');
+        }
+        toggleBtn.setAttribute('aria-expanded', 'true');
+      };
+
+      const closeDrawer = () => {
+        drawer.style.transition = '';
+        drawer.style.transform = '';
+        if (supportsPopover && drawer.matches(':popover-open')) {
+          drawer.hidePopover();
+        } else if (typeof drawer.close === 'function' && drawer.hasAttribute('open')) {
+          drawer.close();
+        } else {
+          drawer.removeAttribute('open');
+        }
+        toggleBtn.setAttribute('aria-expanded', 'false');
+      };
+
+      // Sync aria-expanded and reset inline styles on native popover toggle (Esc / backdrop light-dismiss)
+      drawer.addEventListener('toggle', (e) => {
+        const openState = e.newState === 'open';
+        toggleBtn.setAttribute('aria-expanded', String(openState));
+        if (!openState) {
+          drawer.style.transition = '';
+          drawer.style.transform = '';
+        }
+      });
+
+      // Fallback for browsers where popovertarget isn't handled natively
+      if (!supportsPopover) {
+        toggleBtn.addEventListener('click', () => {
+          if (isOpen()) closeDrawer();
+          else openDrawer();
+        });
+        if (closeBtn) {
+          closeBtn.addEventListener('click', () => closeDrawer());
+        }
+      }
+
+      // Close when clicking the dialog backdrop (fallback & explicit click outside drawer bounds)
+      drawer.addEventListener('click', (e) => {
+        if (e.target === drawer) {
+          const rect = drawer.getBoundingClientRect();
+          const clickedInside =
+            e.clientX >= rect.left &&
+            e.clientX <= rect.right &&
+            e.clientY >= rect.top &&
+            e.clientY <= rect.bottom;
+          if (!clickedInside) {
+            closeDrawer();
+          }
+        }
+      });
+
+      // Ensure Escape closes drawer in all environments
+      document.addEventListener('keydown', (e) => {
+        if (e.key === 'Escape' && isOpen()) {
+          closeDrawer();
+        }
+      });
+
+      // Native-feeling swipe-to-close via Pointer Events & Touch Events
+      let startX = 0;
+      let startY = 0;
+      let currentX = 0;
+      let startTime = 0;
+      let isDragging = false;
+      let activePointerId = null;
+
+      const onSwipeStart = (clientX, clientY, pointerId = null) => {
+        if (!isOpen()) return;
+        startX = clientX;
+        startY = clientY;
+        currentX = clientX;
+        startTime = performance.now();
+        isDragging = true;
+        activePointerId = pointerId;
+        drawer.style.transition = 'none';
+      };
+
+      const onSwipeMove = (clientX, clientY) => {
+        if (!isDragging) return;
+        const deltaX = clientX - startX;
+        const deltaY = clientY - startY;
+
+        // If scrolling vertically more than horizontally at the start, cancel horizontal drag
+        if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaX) < 10) {
+          return;
+        }
+
+        currentX = clientX;
+        // Drawer is anchored to the right, so positive deltaX (swiping right) pushes it off-screen
+        // Also support swiping left (negative deltaX) or right depending on gesture direction
+        const translateX = Math.max(0, deltaX);
+        drawer.style.transform = `translate3d(${translateX}px, 0, 0)`;
+      };
+
+      const onSwipeEnd = (clientX) => {
+        if (!isDragging) return;
+        isDragging = false;
+        activePointerId = null;
+
+        const deltaX = (clientX ?? currentX) - startX;
+        const elapsed = Math.max(1, performance.now() - startTime);
+        const velocity = deltaX / elapsed; // px per ms
+        const drawerWidth = drawer.offsetWidth || 300;
+
+        drawer.style.transition = '';
+
+        // Close if dragged more than 30% of drawer width or flicked with velocity > 0.4px/ms (or significant swipe in either horizontal direction >= 60px)
+        if (deltaX > drawerWidth * 0.3 || velocity > 0.4 || Math.abs(deltaX) > 80) {
+          closeDrawer();
+        } else {
+          drawer.style.transform = '';
+        }
+      };
+
+      drawer.addEventListener('pointerdown', (e) => {
+        if (e.pointerType === 'mouse' && e.button !== 0) return;
+        onSwipeStart(e.clientX, e.clientY, e.pointerId);
+      });
+
+      drawer.addEventListener('pointermove', (e) => {
+        if (!isDragging || (activePointerId !== null && e.pointerId !== activePointerId)) return;
+        onSwipeMove(e.clientX, e.clientY);
+      });
+
+      drawer.addEventListener('pointerup', (e) => {
+        if (activePointerId !== null && e.pointerId !== activePointerId) return;
+        onSwipeEnd(e.clientX);
+      });
+
+      drawer.addEventListener('pointercancel', () => {
+        if (!isDragging) return;
+        isDragging = false;
+        activePointerId = null;
+        drawer.style.transition = '';
+        drawer.style.transform = '';
+      });
+
+      // Explicit touch event listeners for environments simulating raw touchstart/touchmove/touchend
+      drawer.addEventListener('touchstart', (e) => {
+        if (e.touches.length === 1) {
+          onSwipeStart(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+
+      drawer.addEventListener('touchmove', (e) => {
+        if (isDragging && e.touches.length === 1) {
+          onSwipeMove(e.touches[0].clientX, e.touches[0].clientY);
+        }
+      }, { passive: true });
+
+      drawer.addEventListener('touchend', (e) => {
+        if (isDragging) {
+          const endX = e.changedTouches.length > 0 ? e.changedTouches[0].clientX : currentX;
+          onSwipeEnd(endX);
+        }
+      });
+    })();
+  </script>
+
