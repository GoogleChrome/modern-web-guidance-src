+  <script>
+    (async () => {
+      const summarizeBtn = document.getElementById('summarize-btn');
+      const statusEl = document.getElementById('summarizer-status');
+      const summaryContainer = document.getElementById('journal-summary');
+      const summaryList = document.getElementById('journal-summary-list');
+      const articleEl = document.getElementById('journal-article');
+
+      const summarizerOptions = {
+        sharedContext: "An artisanal coffee roaster's journal article describing their ethical, direct-trade coffee bean sourcing and processing practices.",
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+      };
+
+      function showStatus(message) {
+        statusEl.textContent = message;
+        statusEl.hidden = !message;
+      }
+
+      function renderBullets(summaryText) {
+        summaryList.replaceChildren();
+        const lines = summaryText
+          .split(/\r?\n/)
+          .map((line) => line.replace(/^\s*(?:[-*•]|\d+[.)])\s*/, '').trim())
+          .filter(Boolean);
+
+        for (const line of lines) {
+          const li = document.createElement('li');
+          li.textContent = line;
+          summaryList.appendChild(li);
+        }
+        summaryContainer.hidden = false;
+      }
+
+      if (!('Summarizer' in self)) {
+        summarizeBtn.disabled = true;
+        showStatus('Local summarization is currently unsupported in this browser.');
+        return;
+      }
+
+      let availability;
+      try {
+        availability = await Summarizer.availability(summarizerOptions);
+      } catch (err) {
+        summarizeBtn.disabled = true;
+        showStatus('Local summarization is currently unavailable.');
+        return;
+      }
+
+      if (availability === 'unavailable') {
+        summarizeBtn.disabled = true;
+        showStatus('Local summarization is currently unavailable on this device.');
+        return;
+      }
+
+      let summarizerInstance = null;
+
+      summarizeBtn.addEventListener('click', async () => {
+        summarizeBtn.disabled = true;
+        try {
+          if (!summarizerInstance) {
+            showStatus(
+              availability === 'downloadable' || availability === 'downloading'
+                ? 'Preparing on-device AI model...'
+                : 'Initializing summarizer...'
+            );
+            summarizerInstance = await Summarizer.create({
+              ...summarizerOptions,
+              monitor(m) {
+                m.addEventListener('downloadprogress', (e) => {
+                  if (e.total) {
+                    const pct = Math.round((e.loaded / e.total) * 100);
+                    showStatus(`Downloading AI model: ${pct}%`);
+                  }
+                });
+              },
+            });
+          }
+
+          showStatus('Generating summary...');
+          const textToSummarize = articleEl.innerText.trim();
+          const summary = await summarizerInstance.summarize(textToSummarize, {
+            context: 'Summarize the coffee bean sourcing process into concise bullet points for coffee shop customers.',
+          });
+
+          renderBullets(summary);
+          showStatus('');
+          summarizeBtn.textContent = 'Summarize Again';
+        } catch (error) {
+          showStatus(`Unable to generate summary: ${error.message || 'Unknown error'}`);
+        } finally {
+          summarizeBtn.disabled = false;
+        }
+      });
+    })();
+  </script>
