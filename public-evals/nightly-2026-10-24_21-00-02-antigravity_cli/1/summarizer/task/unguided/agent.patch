+  <script>
+    const summarizeBtn = document.getElementById('summarize-btn');
+    const summaryStatus = document.getElementById('summary-status');
+    const summaryContainer = document.getElementById('summary-container');
+    const summaryList = document.getElementById('summary-list');
+    const journalArticle = document.getElementById('journal-article');
+
+    function renderBullets(summaryText) {
+      summaryList.innerHTML = '';
+      const lines = summaryText
+        .split(/\r?\n/)
+        .map((line) => line.replace(/^[\s*\-•+\d.)]+/, '').trim())
+        .filter(Boolean);
+
+      lines.forEach((point) => {
+        const li = document.createElement('li');
+        li.textContent = point;
+        summaryList.appendChild(li);
+      });
+    }
+
+    summarizeBtn.addEventListener('click', async () => {
+      summaryStatus.textContent = '';
+      const sourceText = journalArticle.innerText.trim();
+
+      if (!('Summarizer' in self)) {
+        summaryStatus.textContent =
+          'Native browser AI (Summarizer API) is not supported in this browser.';
+        return;
+      }
+
+      summarizeBtn.disabled = true;
+      summaryStatus.textContent = 'Checking browser AI availability...';
+
+      let summarizer;
+      try {
+        const options = {
+          type: 'key-points',
+          format: 'markdown',
+          length: 'short',
+          sharedContext: 'An article from a specialty coffee roaster about their ethical bean sourcing and roasting process.'
+        };
+
+        const availability = await Summarizer.availability();
+        if (availability === 'unavailable') {
+          summaryStatus.textContent =
+            'The browser AI summarizer model is currently unavailable on this device.';
+          return;
+        }
+
+        summaryStatus.textContent =
+          availability === 'available'
+            ? 'Generating summary...'
+            : 'Preparing on-device AI model...';
+
+        summarizer = await Summarizer.create({
+          ...options,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              const percent = Math.round((e.loaded || 0) * 100);
+              summaryStatus.textContent = `Downloading browser AI model (${percent}%)...`;
+            });
+          }
+        });
+
+        summaryStatus.textContent = 'Summarizing article...';
+        const summary = await summarizer.summarize(sourceText, {
+          context: 'Summarize the coffee bean sourcing and quality process into concise bullet points.'
+        });
+
+        renderBullets(summary);
+        summaryContainer.classList.add('visible');
+        summaryStatus.textContent = 'Summary generated with built-in browser AI.';
+      } catch (err) {
+        console.error('Summarization failed:', err);
+        summaryStatus.textContent = `Unable to generate summary: ${err.message || 'Unknown error'}`;
+      } finally {
+        if (summarizer && typeof summarizer.destroy === 'function') {
+          summarizer.destroy();
+        }
+        summarizeBtn.disabled = false;
+      }
+    });
+  </script>
+
