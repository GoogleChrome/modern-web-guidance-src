+  <script>
+    const statusBanner = document.getElementById('global-status');
+
+    function showStatus(message) {
+      if (!statusBanner) return;
+      statusBanner.textContent = message;
+      statusBanner.classList.add('visible');
+    }
+
+    // Handle menu search & filter client-side
+    const searchForm = document.getElementById('search-menu-form');
+    if (searchForm) {
+      searchForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(searchForm);
+        const query = (formData.get('query') || '').toString().trim().toLowerCase();
+        const category = (formData.get('category') || 'all').toString();
+
+        const cards = Array.from(document.querySelectorAll('#menu-grid .card'));
+        const matches = [];
+
+        cards.forEach((card) => {
+          const cardCategory = card.getAttribute('data-category') || '';
+          const cardText = card.textContent.toLowerCase();
+          const matchesQuery = !query || cardText.includes(query);
+          const matchesCategory = category === 'all' || cardCategory === category;
+          const visible = matchesQuery && matchesCategory;
+          card.style.display = visible ? '' : 'none';
+          if (visible) {
+            matches.push(card.getAttribute('data-name') || card.querySelector('h3')?.textContent || '');
+          }
+        });
+
+        const summary = matches.length > 0
+          ? `Found ${matches.length} item(s): ${matches.join(', ')}.`
+          : 'No menu items matched your search criteria.';
+        showStatus(summary);
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve({
+            status: 'success',
+            query,
+            category,
+            count: matches.length,
+            items: matches
+          }));
+        }
+      });
+    }
+
+    // Handle coffee order form client-side
+    const orderForm = document.getElementById('order-coffee-form');
+    if (orderForm) {
+      orderForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(orderForm);
+        const order = {
+          drink: formData.get('drink'),
+          size: formData.get('size'),
+          milk: formData.get('milk'),
+          quantity: Number(formData.get('quantity') || 1),
+          notes: formData.get('notes') || ''
+        };
+
+        const message = `Order received: ${order.quantity}x ${order.size} ${order.drink} (${order.milk} milk)${order.notes ? ' - Notes: ' + order.notes : ''}.`;
+        showStatus(message);
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve({
+            status: 'success',
+            message,
+            order
+          }));
+        }
+      });
+    }
+
+    // Handle contact form client-side
+    const contactForm = document.getElementById('contact-support-form');
+    if (contactForm) {
+      contactForm.addEventListener('submit', (event) => {
+        event.preventDefault();
+        const formData = new FormData(contactForm);
+        const submission = {
+          name: formData.get('name'),
+          email: formData.get('email'),
+          message: formData.get('message')
+        };
+
+        const feedbackMessage = `Thank you, ${submission.name}! Your message has been sent to our team.`;
+        showStatus(feedbackMessage);
+
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.respondWith(Promise.resolve({
+            status: 'success',
+            message: feedbackMessage,
+            submission
+          }));
+        }
+      });
+    }
+
+    // Handle inline action/navigation forms when invoked by an AI agent
+    document.querySelectorAll('form.inline-tool-form').forEach((form) => {
+      form.addEventListener('submit', (event) => {
+        const toolName = form.getAttribute('toolname');
+        const action = form.getAttribute('action');
+        if (event.agentInvoked && typeof event.respondWith === 'function') {
+          event.preventDefault();
+          const formData = new FormData(form);
+          const params = Object.fromEntries(formData.entries());
+          const message = `Executed tool "${toolName}" targeting ${action}.`;
+          showStatus(message);
+          event.respondWith(Promise.resolve({
+            status: 'success',
+            tool: toolName,
+            action,
+            params,
+            message
+          }));
+        }
+      });
+    });
+  </script>
