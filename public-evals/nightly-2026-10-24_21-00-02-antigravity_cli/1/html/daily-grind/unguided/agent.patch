+  <script defer>
+    (() => {
+      const triggerMap = new WeakMap();
+
+      document.addEventListener('click', (event) => {
+        const trigger = event.target.closest('[data-dialog-open]');
+        if (trigger) {
+          const dialogId = trigger.getAttribute('data-dialog-open');
+          const targetDialog = document.getElementById(dialogId);
+          if (!targetDialog || typeof targetDialog.showModal !== 'function') return;
+
+          const currentDialog = trigger.closest('dialog[open]');
+          const originTrigger = currentDialog
+            ? (triggerMap.get(currentDialog) || trigger)
+            : trigger;
+
+          if (currentDialog && currentDialog !== targetDialog) {
+            triggerMap.delete(currentDialog);
+            currentDialog.close();
+          }
+
+          const selectedDrink = trigger.getAttribute('data-order-drink');
+          if (selectedDrink) {
+            const drinkSelect = targetDialog.querySelector('#order-drink-select');
+            if (drinkSelect) {
+              drinkSelect.value = selectedDrink;
+            }
+          }
+
+          triggerMap.set(targetDialog, originTrigger);
+          targetDialog.showModal();
+          return;
+        }
+
+        // Close modal dialog when clicking directly on its backdrop
+        const openDialog = event.target.closest('dialog[open]');
+        if (openDialog && event.target === openDialog) {
+          const rect = openDialog.getBoundingClientRect();
+          const clickedInside =
+            rect.top <= event.clientY &&
+            event.clientY <= rect.bottom &&
+            rect.left <= event.clientX &&
+            event.clientX <= rect.right;
+          if (!clickedInside) {
+            openDialog.close();
+          }
+        }
+      });
+
+      document.querySelectorAll('dialog').forEach((dialog) => {
+        dialog.addEventListener('close', () => {
+          const returnTrigger = triggerMap.get(dialog);
+          if (returnTrigger && typeof returnTrigger.focus === 'function') {
+            triggerMap.delete(dialog);
+            returnTrigger.focus();
+          }
+        });
+      });
+    })();
+  </script>
