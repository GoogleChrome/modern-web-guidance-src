+  <script>
+    (() => {
+      const board = document.getElementById('order-board');
+      if (!board) return;
+
+      let draggedCard = null;
+
+      function getActionsHtml(columnId) {
+        if (columnId === 'queued') {
+          return '<button type="button" data-move-to="brewing">Start Brewing &rarr;</button>';
+        }
+        if (columnId === 'brewing') {
+          return '<button type="button" data-move-to="queued">&larr; Queued</button><button type="button" data-move-to="ready">Mark Ready &rarr;</button>';
+        }
+        return '<button type="button" data-move-to="brewing">&larr; Brewing</button>';
+      }
+
+      function updateColumnCounts(columnsToUpdate) {
+        for (const col of columnsToUpdate) {
+          if (!col) continue;
+          const colId = col.dataset.column || col.id;
+          const badge = col.querySelector(`[data-count-for="${colId}"]`);
+          if (badge) {
+            badge.textContent = String(col.querySelectorAll('.card').length);
+          }
+        }
+      }
+
+      function moveItemToColumn(itemId, columnId, beforeCard = null) {
+        const item = typeof itemId === 'string' ? document.getElementById(itemId) : itemId;
+        const targetColumn = typeof columnId === 'string'
+          ? (document.getElementById(columnId) || board.querySelector(`.board-column[data-column="${columnId}"]`))
+          : columnId;
+
+        if (!item || !targetColumn) return;
+
+        const sourceColumn = item.closest('.board-column');
+        const targetColName = targetColumn.dataset.column || targetColumn.id;
+
+        if (beforeCard && beforeCard.parentNode === targetColumn) {
+          targetColumn.insertBefore(item, beforeCard);
+        } else {
+          targetColumn.appendChild(item);
+        }
+
+        const actionsContainer = item.querySelector('.order-actions');
+        if (actionsContainer && targetColName) {
+          actionsContainer.innerHTML = getActionsHtml(targetColName);
+        }
+
+        updateColumnCounts(new Set([sourceColumn, targetColumn]));
+      }
+
+      // Expose helper globally if needed for programmatic updates
+      window.moveItemToColumn = moveItemToColumn;
+
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card[draggable="true"]');
+        if (!card) return;
+        draggedCard = card;
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          e.dataTransfer.setData('text/plain', card.id);
+        }
+        requestAnimationFrame(() => {
+          card.classList.add('dragging');
+        });
+      });
+
+      board.addEventListener('dragend', () => {
+        if (draggedCard) {
+          draggedCard.classList.remove('dragging');
+          draggedCard = null;
+        }
+        board.querySelectorAll('.board-column.drag-over').forEach((col) => {
+          col.classList.remove('drag-over');
+        });
+      });
+
+      board.addEventListener('dragover', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+        if (e.dataTransfer) {
+          e.dataTransfer.dropEffect = 'move';
+        }
+        if (!column.classList.contains('drag-over')) {
+          board.querySelectorAll('.board-column.drag-over').forEach((col) => {
+            if (col !== column) col.classList.remove('drag-over');
+          });
+          column.classList.add('drag-over');
+        }
+      });
+
+      board.addEventListener('dragleave', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        if (!column.contains(e.relatedTarget)) {
+          column.classList.remove('drag-over');
+        }
+      });
+
+      board.addEventListener('drop', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+        column.classList.remove('drag-over');
+
+        const cardId = e.dataTransfer ? e.dataTransfer.getData('text/plain') : '';
+        const card = draggedCard || (cardId ? document.getElementById(cardId) : null);
+        if (!card) return;
+
+        const targetCard = e.target.closest('.card');
+        const beforeCard = (targetCard && targetCard !== card && targetCard.parentNode === column)
+          ? targetCard
+          : null;
+
+        moveItemToColumn(card, column, beforeCard);
+      });
+
+      board.addEventListener('click', (e) => {
+        const btn = e.target.closest('button[data-move-to]');
+        if (!btn) return;
+        const card = btn.closest('.card');
+        const targetCol = btn.dataset.moveTo;
+        if (card && targetCol) {
+          moveItemToColumn(card, targetCol);
+        }
+      });
+    })();
+  </script>
 </body>
 
