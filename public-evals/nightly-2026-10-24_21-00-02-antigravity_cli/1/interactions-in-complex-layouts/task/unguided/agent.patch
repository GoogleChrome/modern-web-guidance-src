+  <script>
+    (() => {
+      const board = document.getElementById('kanban-board');
+      const columns = Array.from(document.querySelectorAll('.board-column'));
+      let draggedCard = null;
+      let activeDropColumn = null;
+      let rafId = null;
+      let nextOrderNumber = 107;
+
+      const DRINK_MENU = [
+        { name: 'Maple Oat Latte', desc: 'Creamy oat milk with a hint of Vermont maple syrup.', size: 'Grande • Hot' },
+        { name: 'Dark Roast Espresso', desc: 'Bold, smokey, and perfect for a morning boost.', size: 'Double • Hot' },
+        { name: 'Cold Brew', desc: 'Steeped for 18 hours for maximum smoothness.', size: 'Venti • Iced' },
+        { name: 'Matcha Oat Latte', desc: 'Ceremonial grade matcha whisked with steamed oat milk.', size: 'Tall • Iced' },
+        { name: 'Vanilla Nitro Cold Brew', desc: 'Velvety nitro-infused cold brew topped with vanilla cream.', size: 'Grande • Iced' }
+      ];
+      const CUSTOMERS = ['Casey L.', 'Jamie R.', 'Avery W.', 'Quinn S.', 'Devon H.', 'Skyler N.'];
+
+      function updateColumnCounts() {
+        for (let i = 0; i < columns.length; i++) {
+          const col = columns[i];
+          const status = col.dataset.status;
+          const badge = col.querySelector('.column-count');
+          if (badge) {
+            const count = col.querySelectorAll('.card').length;
+            badge.textContent = String(count);
+          }
+          if (status) {
+            col.setAttribute('data-count', String(col.querySelectorAll('.card').length));
+          }
+        }
+      }
+
+      // Event delegation on the board container to avoid per-card listener overhead
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card) return;
+        draggedCard = card;
+
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          try {
+            e.dataTransfer.setData('text/plain', card.id);
+          } catch (_) {
+            // Ignore in synthetic events with read-only dataTransfer
+          }
+        }
+
+        if (rafId) cancelAnimationFrame(rafId);
+        rafId = requestAnimationFrame(() => {
+          card.classList.add('is-dragging');
+        });
+      });
+
+      board.addEventListener('dragend', (e) => {
+        const card = e.target.closest('.card') || draggedCard;
+        if (rafId) {
+          cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        if (card) {
+          card.classList.remove('is-dragging');
+        }
+        if (activeDropColumn) {
+          activeDropColumn.classList.remove('drag-over');
+          activeDropColumn = null;
+        }
+        draggedCard = null;
+      });
+
+      board.addEventListener('dragenter', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+        if (activeDropColumn !== column) {
+          if (activeDropColumn) {
+            activeDropColumn.classList.remove('drag-over');
+          }
+          activeDropColumn = column;
+          column.classList.add('drag-over');
+        }
+      });
+
+      board.addEventListener('dragover', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+        if (e.dataTransfer) {
+          e.dataTransfer.dropEffect = 'move';
+        }
+      });
+
+      board.addEventListener('dragleave', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        const related = e.relatedTarget;
+        if (!related || !column.contains(related)) {
+          column.classList.remove('drag-over');
+          if (activeDropColumn === column) {
+            activeDropColumn = null;
+          }
+        }
+      });
+
+      board.addEventListener('drop', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+
+        let card = draggedCard;
+        if (!card && e.dataTransfer) {
+          try {
+            const id = e.dataTransfer.getData('text/plain');
+            if (id) card = document.getElementById(id);
+          } catch (_) {
+            // Fallback to draggedCard
+          }
+        }
+
+        column.classList.remove('drag-over');
+        if (activeDropColumn === column) {
+          activeDropColumn = null;
+        }
+
+        if (card && card.classList.contains('card')) {
+          card.classList.remove('is-dragging');
+          card.dataset.status = column.dataset.status || '';
+          column.appendChild(card);
+          updateColumnCounts();
+        }
+        draggedCard = null;
+      });
+
+      function createOrderCardElement(orderNum) {
+        const drink = DRINK_MENU[orderNum % DRINK_MENU.length];
+        const customer = CUSTOMERS[orderNum % CUSTOMERS.length];
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.id = `order-${orderNum}`;
+        card.draggable = true;
+        card.dataset.orderId = String(orderNum);
+        card.dataset.status = 'queued';
+
+        card.innerHTML = `
+          <div class="card-top">
+            <span>#${orderNum} &bull; ${customer}</span>
+            <span>${drink.size}</span>
+          </div>
+          <h3>${drink.name}</h3>
+          <p>${drink.desc}</p>
+        `;
+        return card;
+      }
+
+      const addOrderBtn = document.getElementById('add-order-btn');
+      const rushOrdersBtn = document.getElementById('rush-orders-btn');
+      const queuedColumn = document.getElementById('queued');
+
+      if (addOrderBtn && queuedColumn) {
+        addOrderBtn.addEventListener('click', () => {
+          const card = createOrderCardElement(nextOrderNumber++);
+          queuedColumn.appendChild(card);
+          updateColumnCounts();
+        });
+      }
+
+      if (rushOrdersBtn && queuedColumn) {
+        rushOrdersBtn.addEventListener('click', () => {
+          // Batch DOM insertion via DocumentFragment to prevent layout thrashing
+          const fragment = document.createDocumentFragment();
+          for (let i = 0; i < 50; i++) {
+            fragment.appendChild(createOrderCardElement(nextOrderNumber++));
+          }
+          requestAnimationFrame(() => {
+            queuedColumn.appendChild(fragment);
+            updateColumnCounts();
+          });
+        });
+      }
+    })();
+  </script>
 </body>
 
 </html>
