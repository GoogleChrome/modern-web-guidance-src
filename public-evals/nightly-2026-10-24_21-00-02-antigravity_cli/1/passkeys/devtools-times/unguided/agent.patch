@@ -0,0 +1,726 @@
+export interface StoredPasskey {
+  id: string;
+  rawId: string;
+  name: string;
+  username: string;
+  userDisplayName: string;
+  userId: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  transports: AuthenticatorTransport[];
+  attachment: 'platform' | 'cross-platform';
+  backedUp: boolean;
+  publicKeyAlgorithm: number;
+  signCount: number;
+}
+
+export interface UserAccount {
+  id: string;
+  username: string;
+  displayName: string;
+  email: string;
+  password?: string;
+  passwordSet: boolean;
+  passwordlessOnly: boolean;
+  createdAt: string;
+  recoveryCodes: string[];
+}
+
+export interface AuthSession {
+  username: string;
+  userId: string;
+  displayName: string;
+  email: string;
+  authenticatedAt: string;
+  authMethod: 'passkey' | 'password';
+  credentialId?: string;
+  lastReauthAt: string | null;
+}
+
+const STORAGE_KEYS = {
+  USERS: 'dtt_users_v1',
+  PASSKEYS: 'dtt_passkeys_v1',
+  SESSION: 'dtt_auth_session_v1',
+};
+
+// Reauthentication window: 5 minutes
+export const REAUTH_TTL_MS = 5 * 60 * 1000;
+
+export function bufferToBase64Url(buffer: ArrayBuffer | Uint8Array): string {
+  const bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function base64UrlToBuffer(base64url: string): Uint8Array<ArrayBuffer> {
+  const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+  const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+  const rawData = atob(base64);
+  const buffer = new ArrayBuffer(rawData.length);
+  const outputArray = new Uint8Array(buffer);
+  for (let i = 0; i < rawData.length; ++i) {
+    outputArray[i] = rawData.charCodeAt(i);
+  }
+  return outputArray;
+}
+
+export function stringToBuffer(str: string): Uint8Array<ArrayBuffer> {
+  const encoded = new TextEncoder().encode(str);
+  const buffer = new ArrayBuffer(encoded.byteLength);
+  const view = new Uint8Array(buffer);
+  view.set(encoded);
+  return view;
+}
+
+export function bufferToString(buffer: ArrayBuffer | Uint8Array): string {
+  return new TextDecoder().decode(buffer);
+}
+
+export function generateRandomChallenge(length = 32): Uint8Array<ArrayBuffer> {
+  const buffer = new ArrayBuffer(length);
+  const challenge = new Uint8Array(buffer);
+  if (typeof window !== 'undefined' && window.crypto?.getRandomValues) {
+    window.crypto.getRandomValues(challenge);
+  } else {
+    for (let i = 0; i < length; i++) {
+      challenge[i] = Math.floor(Math.random() * 256);
+    }
+  }
+  return challenge;
+}
+
+export function generateRecoveryCodes(): string[] {
+  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
+  const codes: string[] = [];
+  for (let c = 0; c < 6; c++) {
+    let part1 = '';
+    let part2 = '';
+    for (let i = 0; i < 4; i++) {
+      part1 += chars[Math.floor(Math.random() * chars.length)];
+      part2 += chars[Math.floor(Math.random() * chars.length)];
+    }
+    codes.push(`${part1}-${part2}`);
+  }
+  return codes;
+}
+
+export function isWebAuthnSupported(): boolean {
+  return (
+    typeof window !== 'undefined' &&
+    typeof window.PublicKeyCredential !== 'undefined' &&
+    typeof navigator.credentials !== 'undefined'
+  );
+}
+
+export async function checkPlatformAuthenticator(): Promise<boolean> {
+  if (!isWebAuthnSupported()) return false;
+  try {
+    if (typeof PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable === 'function') {
+      return await PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable();
+    }
+  } catch {
+    // Ignore errors in restricted contexts
+  }
+  return false;
+}
+
+export async function checkConditionalMediation(): Promise<boolean> {
+  if (!isWebAuthnSupported()) return false;
+  try {
+    if (typeof PublicKeyCredential.isConditionalMediationAvailable === 'function') {
+      return await PublicKeyCredential.isConditionalMediationAvailable();
+    }
+  } catch {
+    // Ignore errors
+  }
+  return false;
+}
+
+export function detectDevicePasskeyName(attachment?: string): string {
+  if (typeof navigator === 'undefined') return 'Passkey';
+  const ua = navigator.userAgent || '';
+  if (attachment === 'cross-platform') {
+    return 'Security Key / External Device';
+  }
+  if (/Macintosh|Mac OS X/i.test(ua)) return 'MacBook Touch ID / iCloud Keychain';
+  if (/iPhone|iPad|iPod/i.test(ua)) return 'iCloud Keychain (Face ID / Touch ID)';
+  if (/Windows/i.test(ua)) return 'Windows Hello';
+  if (/Android/i.test(ua)) return 'Google Password Manager (Android)';
+  if (/Linux/i.test(ua)) return 'Chrome Profile Passkey (Linux)';
+  return 'Device Passkey';
+}
+
+export function getUsers(): UserAccount[] {
+  if (typeof window === 'undefined') return [];
+  try {
+    const raw = localStorage.getItem(STORAGE_KEYS.USERS);
+    return raw ? JSON.parse(raw) : [];
+  } catch {
+    return [];
+  }
+}
+
+export function saveUsers(users: UserAccount[]): void {
+  if (typeof window === 'undefined') return;
+  localStorage.setItem(STORAGE_KEYS.USERS, JSON.stringify(users));
+}
+
+export function getOrCreateUser(
+  username: string,
+  options?: { displayName?: string; email?: string; password?: string }
+): UserAccount {
+  const normalized = username.trim();
+  const users = getUsers();
+  let user = users.find((u) => u.username.toLowerCase() === normalized.toLowerCase());
+  if (!user) {
+    const userIdBytes = stringToBuffer(`user:${normalized.toLowerCase()}:${Date.now()}`);
+    user = {
+      id: bufferToBase64Url(userIdBytes),
+      username: normalized,
+      displayName: options?.displayName?.trim() || normalized,
+      email: options?.email?.trim() || `${normalized.toLowerCase().replace(/[^a-z0-9]/g, '.')}@example.com`,
+      password: options?.password,
+      passwordSet: Boolean(options?.password),
+      passwordlessOnly: !options?.password,
+      createdAt: new Date().toISOString(),
+      recoveryCodes: generateRecoveryCodes(),
+    };
+    users.push(user);
+    saveUsers(users);
+  } else if (options?.password && !user.passwordSet) {
+    user.password = options.password;
+    user.passwordSet = true;
+    saveUsers(users);
+  }
+  return user;
+}
+
+export function updateUserAccount(
+  username: string,
+  updates: Partial<Pick<UserAccount, 'displayName' | 'email' | 'password' | 'passwordSet' | 'passwordlessOnly' | 'recoveryCodes'>>
+): UserAccount | null {
+  const users = getUsers();
+  const idx = users.findIndex((u) => u.username.toLowerCase() === username.toLowerCase());
+  if (idx === -1) return null;
+  users[idx] = { ...users[idx], ...updates };
+  saveUsers(users);
+
+  const session = getSession();
+  if (session && session.username.toLowerCase() === username.toLowerCase()) {
+    setSession({
+      ...session,
+      displayName: users[idx].displayName,
+      email: users[idx].email,
+    });
+  }
+
+  // Signal updated user details to the browser credential manager if supported
+  signalUserDetailsToAuthenticator(users[idx]);
+  return users[idx];
+}
+
+export function getPasskeys(username?: string): StoredPasskey[] {
+  if (typeof window === 'undefined') return [];
+  try {
+    const raw = localStorage.getItem(STORAGE_KEYS.PASSKEYS);
+    const all: StoredPasskey[] = raw ? JSON.parse(raw) : [];
+    if (!username) return all;
+    return all.filter((pk) => pk.username.toLowerCase() === username.trim().toLowerCase());
+  } catch {
+    return [];
+  }
+}
+
+export function savePasskeys(passkeys: StoredPasskey[]): void {
+  if (typeof window === 'undefined') return;
+  localStorage.setItem(STORAGE_KEYS.PASSKEYS, JSON.stringify(passkeys));
+}
+
+export function getSession(): AuthSession | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = localStorage.getItem(STORAGE_KEYS.SESSION);
+    return raw ? JSON.parse(raw) : null;
+  } catch {
+    return null;
+  }
+}
+
+export function setSession(session: AuthSession | null): void {
+  if (typeof window === 'undefined') return;
+  if (!session) {
+    localStorage.removeItem(STORAGE_KEYS.SESSION);
+  } else {
+    localStorage.setItem(STORAGE_KEYS.SESSION, JSON.stringify(session));
+  }
+  window.dispatchEvent(new CustomEvent('dtt-auth-changed', { detail: session }));
+}
+
+export function isRecentlyReauthenticated(session: AuthSession | null = getSession()): boolean {
+  if (!session || !session.lastReauthAt) return false;
+  const elapsed = Date.now() - new Date(session.lastReauthAt).getTime();
+  return elapsed >= 0 && elapsed < REAUTH_TTL_MS;
+}
+
+export function getReauthRemainingSeconds(session: AuthSession | null = getSession()): number {
+  if (!session || !session.lastReauthAt) return 0;
+  const remaining = REAUTH_TTL_MS - (Date.now() - new Date(session.lastReauthAt).getTime());
+  return Math.max(0, Math.ceil(remaining / 1000));
+}
+
+export function clearReauthStatus(): void {
+  const session = getSession();
+  if (session) {
+    setSession({
+      ...session,
+      lastReauthAt: null,
+    });
+  }
+}
+
+// WebAuthn Signal API helpers (Chrome 132+ / DevTools support)
+export async function signalUnknownCredentialToAuthenticator(credentialId: string): Promise<void> {
+  if (typeof window === 'undefined' || typeof PublicKeyCredential === 'undefined') return;
+  const pkc = PublicKeyCredential as unknown as {
+    signalUnknownCredential?: (options: { rpId: string; credentialId: string }) => Promise<void>;
+  };
+  if (typeof pkc.signalUnknownCredential === 'function') {
+    try {
+      await pkc.signalUnknownCredential({
+        rpId: window.location.hostname,
+        credentialId,
+      });
+    } catch {
+      // Ignore if unsupported by authenticator
+    }
+  }
+}
+
+export async function signalAcceptedCredentialsToAuthenticator(username: string): Promise<void> {
+  if (typeof window === 'undefined' || typeof PublicKeyCredential === 'undefined') return;
+  const pkc = PublicKeyCredential as unknown as {
+    signalAllAcceptedCredentials?: (options: {
+      rpId: string;
+      userId: string;
+      allAcceptedCredentialIds: string[];
+    }) => Promise<void>;
+  };
+  if (typeof pkc.signalAllAcceptedCredentials === 'function') {
+    const user = getOrCreateUser(username);
+    const userPasskeys = getPasskeys(username);
+    try {
+      await pkc.signalAllAcceptedCredentials({
+        rpId: window.location.hostname,
+        userId: user.id,
+        allAcceptedCredentialIds: userPasskeys.map((p) => p.id),
+      });
+    } catch {
+      // Ignore
+    }
+  }
+}
+
+export async function signalUserDetailsToAuthenticator(user: UserAccount): Promise<void> {
+  if (typeof window === 'undefined' || typeof PublicKeyCredential === 'undefined') return;
+  const pkc = PublicKeyCredential as unknown as {
+    signalCurrentUserDetails?: (options: {
+      rpId: string;
+      userId: string;
+      name: string;
+      displayName: string;
+    }) => Promise<void>;
+  };
+  if (typeof pkc.signalCurrentUserDetails === 'function') {
+    try {
+      await pkc.signalCurrentUserDetails({
+        rpId: window.location.hostname,
+        userId: user.id,
+        name: user.username,
+        displayName: user.displayName,
+      });
+    } catch {
+      // Ignore
+    }
+  }
+}
+
+async function syncWithApi(payload: Record<string, unknown>): Promise<Record<string, unknown> | null> {
+  try {
+    const baseUrl = import.meta.env.BASE_URL || '/devtools-times/';
+    const response = await fetch(`${baseUrl}api/passkeys.json`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify(payload),
+    });
+    if (response.ok) {
+      return await response.json();
+    }
+  } catch {
+    // Fallback to local state if offline
+  }
+  return null;
+}
+
+export interface RegisterPasskeyOptions {
+  username: string;
+  displayName?: string;
+  email?: string;
+  passkeyName?: string;
+  authenticatorAttachment?: AuthenticatorAttachment;
+}
+
+export async function registerPasskey(options: RegisterPasskeyOptions): Promise<{
+  passkey: StoredPasskey;
+  user: UserAccount;
+  session: AuthSession;
+}> {
+  if (!isWebAuthnSupported()) {
+    throw new Error('WebAuthn passkeys are not supported in this browser environment.');
+  }
+
+  const username = options.username.trim();
+  if (!username) {
+    throw new Error('Username is required to register a passkey.');
+  }
+
+  const user = getOrCreateUser(username, {
+    displayName: options.displayName,
+    email: options.email,
+  });
+  const existingPasskeys = getPasskeys(username);
+
+  // Request registration challenge from backend API
+  const apiChallengeRes = await syncWithApi({
+    action: 'register-options',
+    username: user.username,
+    displayName: user.displayName,
+    userId: user.id,
+  });
+
+  const challengeBuffer =
+    typeof apiChallengeRes?.challenge === 'string'
+      ? base64UrlToBuffer(apiChallengeRes.challenge)
+      : generateRandomChallenge(32);
+
+  const userIdBuffer = base64UrlToBuffer(user.id);
+
+  const excludeCredentials: PublicKeyCredentialDescriptor[] = existingPasskeys.map((pk) => ({
+    id: base64UrlToBuffer(pk.rawId || pk.id),
+    type: 'public-key',
+    transports: pk.transports,
+  }));
+
+  const authenticatorSelection: AuthenticatorSelectionCriteria = {
+    residentKey: 'required',
+    requireResidentKey: true,
+    userVerification: 'required',
+  };
+
+  if (options.authenticatorAttachment) {
+    authenticatorSelection.authenticatorAttachment = options.authenticatorAttachment;
+  }
+
+  const publicKey: PublicKeyCredentialCreationOptions = {
+    challenge: challengeBuffer,
+    rp: {
+      name: 'The DevTools Times',
+      id: window.location.hostname,
+    },
+    user: {
+      id: userIdBuffer,
+      name: user.username,
+      displayName: user.displayName || user.username,
+    },
+    pubKeyCredParams: [
+      { type: 'public-key', alg: -7 },   // ES256
+      { type: 'public-key', alg: -257 }, // RS256
+    ],
+    timeout: 60000,
+    attestation: 'none',
+    excludeCredentials,
+    authenticatorSelection,
+  };
+
+  const credential = (await navigator.credentials.create({
+    publicKey,
+  })) as PublicKeyCredential | null;
+
+  if (!credential) {
+    throw new Error('Passkey creation was cancelled or returned no credential.');
+  }
+
+  const attestationResponse = credential.response as AuthenticatorAttestationResponse & {
+    getTransports?: () => AuthenticatorTransport[];
+    getPublicKeyAlgorithm?: () => number;
+  };
+
+  const rawIdB64 = bufferToBase64Url(credential.rawId);
+  const credentialId = credential.id || rawIdB64;
+  const attachment =
+    (credential.authenticatorAttachment as 'platform' | 'cross-platform') ||
+    options.authenticatorAttachment ||
+    'platform';
+
+  const transports =
+    typeof attestationResponse.getTransports === 'function'
+      ? (attestationResponse.getTransports() as AuthenticatorTransport[])
+      : attachment === 'platform'
+        ? (['internal', 'hybrid'] as AuthenticatorTransport[])
+        : (['usb', 'nfc', 'ble'] as AuthenticatorTransport[]);
+
+  const alg =
+    typeof attestationResponse.getPublicKeyAlgorithm === 'function'
+      ? attestationResponse.getPublicKeyAlgorithm()
+      : -7;
+
+  const friendlyName =
+    options.passkeyName?.trim() ||
+    `${detectDevicePasskeyName(attachment)}${existingPasskeys.length > 0 ? ` #${existingPasskeys.length + 1}` : ''}`;
+
+  const now = new Date().toISOString();
+  const newPasskey: StoredPasskey = {
+    id: credentialId,
+    rawId: rawIdB64,
+    name: friendlyName,
+    username: user.username,
+    userDisplayName: user.displayName,
+    userId: user.id,
+    createdAt: now,
+    lastUsedAt: now,
+    transports,
+    attachment,
+    backedUp: attachment === 'platform',
+    publicKeyAlgorithm: alg,
+    signCount: 0,
+  };
+
+  const allPasskeys = getPasskeys();
+  const filtered = allPasskeys.filter((pk) => pk.id !== newPasskey.id);
+  filtered.push(newPasskey);
+  savePasskeys(filtered);
+
+  // Sync registration verification with server API
+  await syncWithApi({
+    action: 'register-verify',
+    passkey: newPasskey,
+    attestationObject: bufferToBase64Url(attestationResponse.attestationObject),
+    clientDataJSON: bufferToBase64Url(attestationResponse.clientDataJSON),
+  });
+
+  await signalAcceptedCredentialsToAuthenticator(user.username);
+
+  const session: AuthSession = {
+    username: user.username,
+    userId: user.id,
+    displayName: user.displayName,
+    email: user.email,
+    authenticatedAt: now,
+    authMethod: 'passkey',
+    credentialId: newPasskey.id,
+    lastReauthAt: now,
+  };
+  setSession(session);
+
+  return { passkey: newPasskey, user, session };
+}
+
+export interface AuthenticatePasskeyOptions {
+  username?: string;
+  mediation?: CredentialMediationRequirement;
+  signal?: AbortSignal;
+  purpose?: 'login' | 'reauth';
+}
+
+export async function authenticateWithPasskey(options: AuthenticatePasskeyOptions = {}): Promise<{
+  passkey: StoredPasskey;
+  user: UserAccount;
+  session: AuthSession;
+}> {
+  if (!isWebAuthnSupported()) {
+    throw new Error('WebAuthn passkeys are not supported in this browser environment.');
+  }
+
+  const targetUsername = options.username?.trim();
+  const userPasskeys = targetUsername ? getPasskeys(targetUsername) : [];
+
+  const apiChallengeRes = await syncWithApi({
+    action: 'auth-options',
+    username: targetUsername,
+    purpose: options.purpose || 'login',
+  });
+
+  const challengeBuffer =
+    typeof apiChallengeRes?.challenge === 'string'
+      ? base64UrlToBuffer(apiChallengeRes.challenge)
+      : generateRandomChallenge(32);
+
+  // For reauthentication of a signed-in user (or when user has known local passkeys), scope allowCredentials if available
+  const allowCredentials: PublicKeyCredentialDescriptor[] =
+    userPasskeys.length > 0 && options.mediation !== 'conditional'
+      ? userPasskeys.map((pk) => ({
+          id: base64UrlToBuffer(pk.rawId || pk.id),
+          type: 'public-key',
+          transports: pk.transports,
+        }))
+      : [];
+
+  const publicKey: PublicKeyCredentialRequestOptions = {
+    challenge: challengeBuffer,
+    rpId: window.location.hostname,
+    userVerification: 'required',
+    timeout: 60000,
+    ...(allowCredentials.length > 0 ? { allowCredentials } : {}),
+  };
+
+  const credential = (await navigator.credentials.get({
+    publicKey,
+    mediation: options.mediation,
+    signal: options.signal,
+  })) as PublicKeyCredential | null;
+
+  if (!credential) {
+    throw new Error('Passkey authentication was cancelled or returned no credential.');
+  }
+
+  const assertionResponse = credential.response as AuthenticatorAssertionResponse;
+  const rawIdB64 = bufferToBase64Url(credential.rawId);
+  const credentialId = credential.id || rawIdB64;
+
+  const allPasskeys = getPasskeys();
+  let matchedPasskey = allPasskeys.find(
+    (pk) => pk.id === credentialId || pk.rawId === rawIdB64
+  );
+
+  // If the authenticator returned a discoverable credential created in a virtual authenticator or earlier session
+  let resolvedUsername = matchedPasskey?.username || targetUsername || '';
+  let resolvedUserId = matchedPasskey?.userId || '';
+
+  if (!resolvedUsername && assertionResponse.userHandle) {
+    const handleB64 = bufferToBase64Url(assertionResponse.userHandle);
+    resolvedUserId = handleB64;
+    const users = getUsers();
+    const matchedUserById = users.find((u) => u.id === handleB64);
+    if (matchedUserById) {
+      resolvedUsername = matchedUserById.username;
+    } else {
+      const decoded = bufferToString(assertionResponse.userHandle);
+      const match = decoded.match(/^user:([^:]+):/);
+      if (match?.[1]) {
+        resolvedUsername = match[1];
+      } else if (decoded && /^[\x20-\x7E]+$/.test(decoded)) {
+        resolvedUsername = decoded;
+      }
+    }
+  }
+
+  if (!resolvedUsername) {
+    const currentSession = getSession();
+    resolvedUsername = currentSession?.username || 'reader';
+  }
+
+  // If reauthenticating a specific user, verify the credential belongs to that user
+  if (
+    options.purpose === 'reauth' &&
+    targetUsername &&
+    matchedPasskey &&
+    matchedPasskey.username.toLowerCase() !== targetUsername.toLowerCase()
+  ) {
+    throw new Error(`Selected passkey does not belong to account "${targetUsername}".`);
+  }
+
+  const user = getOrCreateUser(resolvedUsername);
+  const now = new Date().toISOString();
+
+  if (matchedPasskey) {
+    matchedPasskey.lastUsedAt = now;
+    matchedPasskey.signCount = (matchedPasskey.signCount || 0) + 1;
+    savePasskeys(allPasskeys);
+  } else {
+    matchedPasskey = {
+      id: credentialId,
+      rawId: rawIdB64,
+      name: detectDevicePasskeyName(credential.authenticatorAttachment || 'platform'),
+      username: user.username,
+      userDisplayName: user.displayName,
+      userId: resolvedUserId || user.id,
+      createdAt: now,
+      lastUsedAt: now,
+      transports: ['internal', 'hybrid'],
+      attachment: (credential.authenticatorAttachment as 'platform' | 'cross-platform') || 'platform',
+      backedUp: true,
+      publicKeyAlgorithm: -7,
+      signCount: 1,
+    };
+    allPasskeys.push(matchedPasskey);
+    savePasskeys(allPasskeys);
+  }
+
+  await syncWithApi({
+    action: 'auth-verify',
+    credentialId: matchedPasskey.id,
+    username: user.username,
+    purpose: options.purpose || 'login',
+    authenticatorData: bufferToBase64Url(assertionResponse.authenticatorData),
+    clientDataJSON: bufferToBase64Url(assertionResponse.clientDataJSON),
+    signature: bufferToBase64Url(assertionResponse.signature),
+  });
+
+  const existingSession = getSession();
+  const session: AuthSession = {
+    username: user.username,
+    userId: user.id,
+    displayName: user.displayName,
+    email: user.email,
+    authenticatedAt:
+      options.purpose === 'reauth' && existingSession
+        ? existingSession.authenticatedAt
+        : now,
+    authMethod: 'passkey',
+    credentialId: matchedPasskey.id,
+    lastReauthAt: now,
+  };
+  setSession(session);
+
+  return { passkey: matchedPasskey, user, session };
+}
+
+export async function renamePasskey(credentialId: string, newName: string): Promise<StoredPasskey | null> {
+  const trimmed = newName.trim();
+  if (!trimmed) return null;
+  const allPasskeys = getPasskeys();
+  const target = allPasskeys.find((pk) => pk.id === credentialId);
+  if (!target) return null;
+  target.name = trimmed;
+  savePasskeys(allPasskeys);
+  await syncWithApi({
+    action: 'rename',
+    credentialId,
+    name: trimmed,
+  });
+  return target;
+}
+
+export async function deletePasskey(credentialId: string): Promise<boolean> {
+  const allPasskeys = getPasskeys();
+  const target = allPasskeys.find((pk) => pk.id === credentialId);
+  if (!target) return false;
+  const remaining = allPasskeys.filter((pk) => pk.id !== credentialId);
+  savePasskeys(remaining);
+
+  await syncWithApi({
+    action: 'delete',
+    credentialId,
+  });
+
+  await signalUnknownCredentialToAuthenticator(credentialId);
+  await signalAcceptedCredentialsToAuthenticator(target.username);
+  return true;
+}
+
+export async function signOutUser(): Promise<void> {
+  setSession(null);
+  await syncWithApi({ action: 'logout' });
+}
