diff --git a/src/pages/api/passkeys.json.ts b/src/pages/api/passkeys.json.ts
new file mode 100644
index 0000000..d0de799
--- /dev/null
+++ b/src/pages/api/passkeys.json.ts
@@ -0,0 +1,221 @@
+import type { APIRoute } from 'astro';
+import crypto from 'node:crypto';
+import type { StoredPasskey } from '../../utils/passkeys';
+
+interface ServerPasskeyStore {
+  passkeys: StoredPasskey[];
+  challenges: Map<string, { challenge: string; username?: string; createdAt: number }>;
+}
+
+const globalStore = globalThis as unknown as { __dttPasskeyStore?: ServerPasskeyStore };
+if (!globalStore.__dttPasskeyStore) {
+  globalStore.__dttPasskeyStore = {
+    passkeys: [],
+    challenges: new Map(),
+  };
+}
+const store = globalStore.__dttPasskeyStore;
+
+function generateBase64UrlChallenge(bytes = 32): string {
+  return crypto
+    .randomBytes(bytes)
+    .toString('base64')
+    .replace(/\+/g, '-')
+    .replace(/\//g, '_')
+    .replace(/=+$/, '');
+}
+
+export const GET: APIRoute = async ({ url, session }) => {
+  const username = url.searchParams.get('username');
+  const sessionPasskeys: StoredPasskey[] = (await session?.get('passkeys')) || [];
+  const mergedMap = new Map<string, StoredPasskey>();
+
+  for (const pk of [...store.passkeys, ...sessionPasskeys]) {
+    mergedMap.set(pk.id, pk);
+  }
+
+  let passkeys = Array.from(mergedMap.values());
+  if (username) {
+    passkeys = passkeys.filter((pk) => pk.username.toLowerCase() === username.toLowerCase());
+  }
+
+  const currentUser = (await session?.get('currentUser')) || null;
+
+  return new Response(
+    JSON.stringify({
+      passkeys,
+      currentUser,
+      challenge: generateBase64UrlChallenge(),
+    }),
+    {
+      headers: { 'Content-Type': 'application/json' },
+    }
+  );
+};
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { action } = body;
+
+    if (action === 'register-options') {
+      const challenge = generateBase64UrlChallenge(32);
+      store.challenges.set(challenge, {
+        challenge,
+        username: body.username,
+        createdAt: Date.now(),
+      });
+      await session?.set('lastChallenge', challenge);
+
+      return new Response(
+        JSON.stringify({
+          challenge,
+          rp: { name: 'The DevTools Times' },
+          user: {
+            id: body.userId || generateBase64UrlChallenge(16),
+            name: body.username,
+            displayName: body.displayName || body.username,
+          },
+          pubKeyCredParams: [
+            { type: 'public-key', alg: -7 },
+            { type: 'public-key', alg: -257 },
+          ],
+          timeout: 60000,
+          attestation: 'none',
+        }),
+        { headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'register-verify') {
+      const passkey: StoredPasskey = body.passkey;
+      if (!passkey || !passkey.id) {
+        return new Response(JSON.stringify({ error: 'Invalid passkey payload' }), { status: 400 });
+      }
+
+      store.passkeys = store.passkeys.filter((pk) => pk.id !== passkey.id);
+      store.passkeys.push(passkey);
+
+      const sessionPasskeys: StoredPasskey[] = (await session?.get('passkeys')) || [];
+      const updated = sessionPasskeys.filter((pk) => pk.id !== passkey.id);
+      updated.push(passkey);
+      await session?.set('passkeys', updated);
+      await session?.set('currentUser', {
+        username: passkey.username,
+        displayName: passkey.userDisplayName,
+        userId: passkey.userId,
+        lastReauthAt: new Date().toISOString(),
+      });
+
+      return new Response(
+        JSON.stringify({
+          verified: true,
+          passkey,
+        }),
+        { headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'auth-options') {
+      const challenge = generateBase64UrlChallenge(32);
+      store.challenges.set(challenge, {
+        challenge,
+        username: body.username,
+        createdAt: Date.now(),
+      });
+      await session?.set('lastChallenge', challenge);
+
+      const username = body.username;
+      const allowCredentials = username
+        ? store.passkeys
+            .filter((pk) => pk.username.toLowerCase() === username.toLowerCase())
+            .map((pk) => ({
+              id: pk.rawId || pk.id,
+              type: 'public-key',
+              transports: pk.transports,
+            }))
+        : [];
+
+      return new Response(
+        JSON.stringify({
+          challenge,
+          allowCredentials,
+          userVerification: 'required',
+          timeout: 60000,
+        }),
+        { headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'auth-verify') {
+      const { credentialId, username, purpose } = body;
+      const now = new Date().toISOString();
+      const target = store.passkeys.find((pk) => pk.id === credentialId);
+      if (target) {
+        target.lastUsedAt = now;
+        target.signCount = (target.signCount || 0) + 1;
+      }
+
+      await session?.set('currentUser', {
+        username: target?.username || username,
+        displayName: target?.userDisplayName || username,
+        userId: target?.userId,
+        lastReauthAt: now,
+        purpose: purpose || 'login',
+      });
+
+      return new Response(
+        JSON.stringify({
+          verified: true,
+          authenticatedAt: now,
+          lastReauthAt: now,
+        }),
+        { headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (action === 'rename') {
+      const { credentialId, name } = body;
+      const target = store.passkeys.find((pk) => pk.id === credentialId);
+      if (target && name) {
+        target.name = name;
+      }
+      const sessionPasskeys: StoredPasskey[] = (await session?.get('passkeys')) || [];
+      const sessionTarget = sessionPasskeys.find((pk) => pk.id === credentialId);
+      if (sessionTarget && name) {
+        sessionTarget.name = name;
+        await session?.set('passkeys', sessionPasskeys);
+      }
+      return new Response(JSON.stringify({ ok: true, passkey: target || sessionTarget }), {
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (action === 'delete') {
+      const { credentialId } = body;
+      store.passkeys = store.passkeys.filter((pk) => pk.id !== credentialId);
+      const sessionPasskeys: StoredPasskey[] = (await session?.get('passkeys')) || [];
+      await session?.set(
+        'passkeys',
+        sessionPasskeys.filter((pk) => pk.id !== credentialId)
+      );
+      return new Response(JSON.stringify({ ok: true }), {
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    if (action === 'logout') {
+      await session?.set('currentUser', null);
+      return new Response(JSON.stringify({ ok: true }), {
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    return new Response(JSON.stringify({ error: 'Unknown action' }), { status: 400 });
+  } catch (err) {
+    return new Response(
+      JSON.stringify({ error: err instanceof Error ? err.message : 'Internal server error' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
