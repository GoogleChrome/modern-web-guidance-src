+// ============================================================================
+// WebAuthn Binary Parsing & Verification Helpers
+// ============================================================================
+
+function parseAuthenticatorData(authDataBuf) {
+  const buf = Buffer.isBuffer(authDataBuf) ? authDataBuf : Buffer.from(authDataBuf);
+  if (buf.length < 37) {
+    throw new Error(`Invalid authenticatorData length: ${buf.length} (minimum 37 bytes)`);
+  }
+  const rpIdHash = buf.subarray(0, 32);
+  const flagsByte = buf[32];
+  const flags = {
+    userPresent: Boolean(flagsByte & 0x01),
+    userVerified: Boolean(flagsByte & 0x04),
+    backupEligible: Boolean(flagsByte & 0x08),
+    backedUp: Boolean(flagsByte & 0x10),
+    attestedCredentialData: Boolean(flagsByte & 0x40),
+    extensionData: Boolean(flagsByte & 0x80),
+    raw: flagsByte,
+  };
+  const signCount = buf.readUInt32BE(33);
+
+  const result = {
+    rpIdHash,
+    flags,
+    signCount,
+  };
+
+  if (flags.attestedCredentialData && buf.length >= 55) {
+    const aaguidBytes = buf.subarray(37, 53);
+    const aaguid = formatAAGUID(aaguidBytes);
+    const credIdLen = buf.readUInt16BE(53);
+    const credentialIdBytes = buf.subarray(55, 55 + credIdLen);
+    const publicKeyOffset = 55 + credIdLen;
+
+    let coseKey = null;
+    let publicKeyJwk = null;
+    let alg = -7;
+
+    if (buf.length > publicKeyOffset) {
+      try {
+        const decoded = decodeCBOR(buf, publicKeyOffset);
+        coseKey = decoded.value;
+        const converted = coseToJwk(coseKey);
+        publicKeyJwk = converted.jwk;
+        alg = converted.alg;
+      } catch (_err) {
+        // Fallback if COSE key uses non-standard encoding
+      }
+    }
+
+    result.aaguid = aaguid;
+    result.credentialId = Buffer.from(credentialIdBytes).toString('base64url');
+    result.coseKey = coseKey;
+    result.publicKeyJwk = publicKeyJwk;
+    result.alg = alg;
+  }
+
+  return result;
+}
+
+function coseToJwk(coseKey) {
+  if (!coseKey || typeof coseKey !== 'object') {
+    throw new Error('Invalid COSE key');
+  }
+  const kty = coseKey[1];
+  const alg = coseKey[3] || -7;
+
+  // EC2 (P-256)
+  if (kty === 2) {
+    const x = Buffer.from(coseKey[-2]).toString('base64url');
+    const y = Buffer.from(coseKey[-3]).toString('base64url');
+    return {
+      alg,
+      jwk: {
+        kty: 'EC',
+        crv: 'P-256',
+        x,
+        y,
+      },
+    };
+  }
+
+  // RSA (RS256)
+  if (kty === 3) {
+    const n = Buffer.from(coseKey[-1]).toString('base64url');
+    const e = Buffer.from(coseKey[-2]).toString('base64url');
+    return {
+      alg,
+      jwk: {
+        kty: 'RSA',
+        n,
+        e,
+      },
+    };
+  }
+
+  // OKP (Ed25519)
+  if (kty === 1) {
+    const x = Buffer.from(coseKey[-2]).toString('base64url');
+    return {
+      alg,
+      jwk: {
+        kty: 'OKP',
+        crv: 'Ed25519',
+        x,
+      },
+    };
+  }
+
+  throw new Error(`Unsupported COSE key type: ${kty}`);
+}
