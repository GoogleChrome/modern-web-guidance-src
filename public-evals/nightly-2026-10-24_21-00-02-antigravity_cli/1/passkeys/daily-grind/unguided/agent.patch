+// ============================================================================
+// CBOR Encoder & Decoder (RFC 8949) for WebAuthn attestationObject & COSE_Key
+// ============================================================================
+
+function encodeCBOR(val) {
+  const chunks = [];
+  function writeTypeAndLen(major, len) {
+    const mt = major << 5;
+    if (len < 24) {
+      chunks.push(Buffer.from([mt | len]));
+    } else if (len < 256) {
+      chunks.push(Buffer.from([mt | 24, len]));
+    } else if (len < 65536) {
+      const b = Buffer.alloc(3);
+      b[0] = mt | 25;
+      b.writeUInt16BE(len, 1);
+      chunks.push(b);
+    } else {
+      const b = Buffer.alloc(5);
+      b[0] = mt | 26;
+      b.writeUInt32BE(len, 1);
+      chunks.push(b);
+    }
+  }
+  function encode(v) {
+    if (typeof v === 'number') {
+      if (v >= 0) writeTypeAndLen(0, v);
+      else writeTypeAndLen(1, -1 - v);
+    } else if (v instanceof Uint8Array || Buffer.isBuffer(v)) {
+      writeTypeAndLen(2, v.length);
+      chunks.push(Buffer.from(v));
+    } else if (typeof v === 'string') {
+      const s = Buffer.from(v, 'utf8');
+      writeTypeAndLen(3, s.length);
+      chunks.push(s);
+    } else if (Array.isArray(v)) {
+      writeTypeAndLen(4, v.length);
+      for (const item of v) encode(item);
+    } else if (v === false) {
+      chunks.push(Buffer.from([0xf4]));
+    } else if (v === true) {
+      chunks.push(Buffer.from([0xf5]));
+    } else if (v === null || v === undefined) {
+      chunks.push(Buffer.from([0xf6]));
+    } else if (v && typeof v === 'object') {
+      const entries = Object.entries(v);
+      writeTypeAndLen(5, entries.length);
+      for (const [k, val2] of entries) {
+        const numK = Number(k);
+        if (!Number.isNaN(numK) && String(numK) === k) encode(numK);
+        else encode(k);
+        encode(val2);
+      }
+    }
+  }
+  encode(val);
+  return Buffer.concat(chunks);
+}
+
+function decodeCBOR(buf, startOffset = 0) {
+  const bytes = Buffer.isBuffer(buf) ? buf : Buffer.from(buf);
+  let offset = startOffset;
+
+  function readLen(ai) {
+    if (ai < 24) return ai;
+    if (ai === 24) return bytes[offset++];
+    if (ai === 25) {
+      const v = bytes.readUInt16BE(offset);
+      offset += 2;
+      return v;
+    }
+    if (ai === 26) {
+      const v = bytes.readUInt32BE(offset);
+      offset += 4;
+      return v;
+    }
+    if (ai === 27) {
+      const hi = bytes.readUInt32BE(offset);
+      const lo = bytes.readUInt32BE(offset + 4);
+      offset += 8;
+      return hi * 4294967296 + lo;
+    }
+    throw new Error(`Unsupported CBOR length info: ${ai}`);
+  }
+
+  function decodeItem() {
+    if (offset >= bytes.length) {
+      throw new Error('Unexpected end of CBOR buffer');
+    }
+    const ib = bytes[offset++];
+    const major = ib >> 5;
+    const ai = ib & 0x1f;
+
+    if (major === 0) return readLen(ai);
+    if (major === 1) return -1 - readLen(ai);
+    if (major === 2) {
+      const len = readLen(ai);
+      const slice = bytes.subarray(offset, offset + len);
+      offset += len;
+      return slice;
+    }
+    if (major === 3) {
+      const len = readLen(ai);
+      const str = bytes.subarray(offset, offset + len).toString('utf8');
+      offset += len;
+      return str;
+    }
+    if (major === 4) {
+      if (ai === 31) {
+        const arr = [];
+        while (bytes[offset] !== 0xff) arr.push(decodeItem());
+        offset++;
+        return arr;
+      }
+      const len = readLen(ai);
+      const arr = [];
+      for (let i = 0; i < len; i++) arr.push(decodeItem());
+      return arr;
+    }
+    if (major === 5) {
+      if (ai === 31) {
+        const obj = {};
+        while (bytes[offset] !== 0xff) {
+          const k = decodeItem();
+          const v = decodeItem();
+          obj[k] = v;
+        }
+        offset++;
+        return obj;
+      }
+      const len = readLen(ai);
+      const obj = {};
+      for (let i = 0; i < len; i++) {
+        const k = decodeItem();
+        const v = decodeItem();
+        obj[k] = v;
+      }
+      return obj;
+    }
+    if (major === 6) {
+      readLen(ai); // tag number
+      return decodeItem();
+    }
+    if (major === 7) {
+      if (ai === 20) return false;
+      if (ai === 21) return true;
+      if (ai === 22 || ai === 23) return null;
+      if (ai === 25) {
+        offset += 2;
+        return 0;
+      }
+      if (ai === 26) {
+        const v = bytes.readFloatBE(offset);
+        offset += 4;
+        return v;
+      }
+      if (ai === 27) {
+        const v = bytes.readDoubleBE(offset);
+        offset += 8;
+        return v;
+      }
+      return ai;
+    }
+    throw new Error(`Unsupported CBOR major type: ${major}`);
+  }
+
+  const value = decodeItem();
+  return { value, offset };
+}
