+      reauthExpiresAt: reauth.expiresAt,
+      verifiedAt: new Date(user.lastVerifiedAt).toISOString(),
+    });
+  } catch (err) {
+    sendJson(res, err.statusCode || 401, {
+      verified: false,
+      reauthenticated: false,
+      error: err.message || 'Passkey reauthentication failed',
+    });
+  }
+}
+
+// ============================================================================
+// HTTP Server & Router
+// ============================================================================
+
+const MIME_TYPES = {
+  '.html': 'text/html; charset=utf-8',
+  '.css': 'text/css; charset=utf-8',
+  '.js': 'application/javascript; charset=utf-8',
+  '.json': 'application/json; charset=utf-8',
+  '.svg': 'image/svg+xml',
+  '.png': 'image/png',
+  '.jpg': 'image/jpeg',
+  '.ico': 'image/x-icon',
+};
+
+const server = http.createServer(async (req, res) => {
+  try {
+    if (req.method === 'OPTIONS') {
+      res.writeHead(204, {
+        'Access-Control-Allow-Origin': '*',
+        'Access-Control-Allow-Methods': 'GET, POST, PUT, PATCH, DELETE, OPTIONS',
+        'Access-Control-Allow-Headers': 'Content-Type, X-User-Id, X-Reauth-Token',
+      });
+      return res.end();
+    }
+
+    const parsedUrl = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
+    const pathname = parsedUrl.pathname;
+
+    // ------------------------------------------------------------------------
+    // Session & Bootstrap APIs
+    // ------------------------------------------------------------------------
+    if (pathname === '/api/session' && req.method === 'GET') {
+      const user = getActiveUser(req);
+      return sendJson(res, 200, {
+        authenticated: Boolean(user),
+        user: sanitizeUser(user),
+        defaultSeedKey: {
+          credentialId: db.defaultCredentialId,
+          privateKeyJwk: db.defaultSeedPrivateKeyJwk,
+          publicKeyJwk: DEFAULT_SEED_KEYPAIR.publicKeyJwk,
+        },
+      });
+    }
+
+    if ((pathname === '/api/logout' || pathname === '/api/auth/logout') && req.method === 'POST') {
+      const user = getActiveUser(req);
+      if (user) {
+        addAuditLog(user, 'logout', 'Signed Out', `Session ended for ${user.email}`);
+      }
+      db.activeUserId = null;
+      saveDb();
+      return sendJson(res, 200, { ok: true, authenticated: false });
+    }
+
+    if (pathname === '/api/session/demo' && req.method === 'POST') {
+      const demoUser = db.users[0];
+      if (demoUser) {
+        db.activeUserId = demoUser.id;
+        demoUser.lastVerifiedAt = Date.now();
+        saveDb();
+      }
+      return sendJson(res, 200, {
+        authenticated: Boolean(demoUser),
+        user: sanitizeUser(demoUser),
+      });
+    }
+
+    // ------------------------------------------------------------------------
+    // Passkey Registration APIs
+    // ------------------------------------------------------------------------
+    if (
+      (pathname === '/api/passkeys/register/options' ||
+        pathname === '/api/auth/register/options' ||
+        pathname === '/api/webauthn/register/options') &&
+      req.method === 'POST'
+    ) {
+      const body = await parseJsonBody(req);
+      return handleRegisterOptions(req, res, body);
+    }
+
+    if (
+      (pathname === '/api/passkeys/register/verify' ||
+        pathname === '/api/auth/register/verify' ||
+        pathname === '/api/webauthn/register/verify') &&
+      req.method === 'POST'
+    ) {
+      const body = await parseJsonBody(req);
+      return handleRegisterVerify(req, res, body);
+    }
+
+    // ------------------------------------------------------------------------
+    // Passkey Authentication (Sign-In) APIs
+    // ------------------------------------------------------------------------
+    if (
+      (pathname === '/api/passkeys/authenticate/options' ||
+        pathname === '/api/auth/login/options' ||
+        pathname === '/api/webauthn/authenticate/options') &&
+      req.method === 'POST'
+    ) {
+      const body = await parseJsonBody(req);
+      return handleAuthenticateOptions(req, res, body);
+    }
+
+    if (
+      (pathname === '/api/passkeys/authenticate/verify' ||
+        pathname === '/api/auth/login/verify' ||
+        pathname === '/api/webauthn/authenticate/verify') &&
+      req.method === 'POST'
+    ) {
+      const body = await parseJsonBody(req);
+      return handleAuthenticateVerify(req, res, body);
+    }
+
+    // ------------------------------------------------------------------------
+    // Passkey Management APIs (List, Add, Rename, Delete)
+    // ------------------------------------------------------------------------
+    if (pathname === '/api/passkeys' && req.method === 'GET') {
+      const user = getActiveUser(req);
+      if (!user) return sendJson(res, 401, { error: 'Not authenticated' });
+      return sendJson(res, 200, {
+        passkeys: sanitizeUser(user).passkeys,
+      });
+    }
+
+    if (pathname === '/api/passkeys/add/options' && req.method === 'POST') {
+      const body = await parseJsonBody(req);
+      return handleAddPasskeyOptions(req, res, body);
+    }
+
+    if (pathname === '/api/passkeys/add/verify' && req.method === 'POST') {
+      const body = await parseJsonBody(req);
+      return handleAddPasskeyVerify(req, res, body);
+    }
+
+    if (pathname.startsWith('/api/passkeys/') && (req.method === 'PATCH' || req.method === 'PUT' || req.method === 'DELETE')) {
+      const subPath = pathname.slice('/api/passkeys/'.length);
+      if (
+        !subPath.startsWith('register/') &&
+        !subPath.startsWith('authenticate/') &&
+        !subPath.startsWith('reauthenticate/') &&
+        !subPath.startsWith('add/')
+      ) {
+        const user = getActiveUser(req);
+        if (!user) return sendJson(res, 401, { error: 'Not authenticated' });
+
+        const targetId = decodeURIComponent(subPath);
+        const pkIndex = (user.passkeys || []).findIndex((pk) => pk.id === targetId || pk.credentialId === targetId);
+        if (pkIndex === -1) {
+          return sendJson(res, 404, { error: 'Passkey not found' });
+        }
+
+        if (req.method === 'PATCH' || req.method === 'PUT') {
+          const body = await parseJsonBody(req);
+          const newName = String(body.name || body.label || '').trim();
+          if (!newName) {
+            return sendJson(res, 400, { error: 'Passkey name cannot be empty' });
+          }
+          const oldName = user.passkeys[pkIndex].name;
+          user.passkeys[pkIndex].name = newName;
+          addAuditLog(user, 'rename-passkey', 'Passkey Renamed', `Renamed passkey from "${oldName}" to "${newName}"`);
+          saveDb();
+          return sendJson(res, 200, {
+            ok: true,
+            passkey: user.passkeys[pkIndex],
+            user: sanitizeUser(user),
+          });
+        }
+
+        if (req.method === 'DELETE') {
+          const removed = user.passkeys.splice(pkIndex, 1)[0];
+          addAuditLog(user, 'delete-passkey', 'Passkey Removed', `Deleted passkey "${removed.name}" (${removed.credentialId.slice(0, 12)}...)`);
+          saveDb();
+          return sendJson(res, 200, {
+            ok: true,
+            deletedId: targetId,
+            user: sanitizeUser(user),
+          });
+        }
+      }
+    }
+
+    // ------------------------------------------------------------------------
+    // Passkey Reauthentication APIs
+    // ------------------------------------------------------------------------
+    if (
+      (pathname === '/api/passkeys/reauthenticate/options' || pathname === '/api/auth/reauthenticate/options') &&
+      req.method === 'POST'
+    ) {
+      const body = await parseJsonBody(req);
+      return handleReauthenticateOptions(req, res, body);
+    }
+
+    if (
+      (pathname === '/api/passkeys/reauthenticate/verify' || pathname === '/api/auth/reauthenticate/verify') &&
+      req.method === 'POST'
+    ) {
+      const body = await parseJsonBody(req);
+      return handleReauthenticateVerify(req, res, body);
+    }
+
+    if (pathname === '/api/passkeys/reauthenticate/expire' && req.method === 'POST') {
+      const user = getActiveUser(req);
+      if (!user) return sendJson(res, 401, { error: 'Not authenticated' });
+      user.lastVerifiedAt = null;
+      for (const [k, v] of Object.entries(db.reauthTokens)) {
+        if (v.userId === user.id) delete db.reauthTokens[k];
+      }
+      addAuditLog(user, 'lock-session', 'Step-Up Verification Expired', 'Session locked; passkey reauthentication required for sensitive actions');
+      saveDb();
+      return sendJson(res, 200, {
+        ok: true,
+        user: sanitizeUser(user),
+      });
+    }
+
+    // ------------------------------------------------------------------------
+    // Protected Sensitive Account APIs (Require Passkey Reauthentication)
+    // ------------------------------------------------------------------------
+    if (pathname === '/api/account/email' && req.method === 'POST') {
+      const user = getActiveUser(req);
+      if (!user) return sendJson(res, 401, { error: 'Not authenticated' });
+      const body = await parseJsonBody(req);
+      const reauthToken = body.reauthToken || req.headers['x-reauth-token'];
+
+      if (!isUserReauthenticated(user, reauthToken)) {
+        return sendJson(res, 403, {
+          error: 'Step-up passkey reauthentication is required to change your email address.',
+          requireReauth: true,
+        });
+      }
+
+      const newEmail = String(body.email || body.newEmail || '').trim();
+      if (!newEmail || !newEmail.includes('@')) {
+        return sendJson(res, 400, { error: 'Please provide a valid email address.' });
+      }
+
+      const oldEmail = user.email;
+      user.email = newEmail;
+      user.username = newEmail;
+      addAuditLog(user, 'sensitive-action', 'Email Address Updated (Re-auth Verified)', `Changed account email from ${oldEmail} to ${newEmail}`);
+      saveDb();
+
+      return sendJson(res, 200, {
+        ok: true,
+        message: `Email address updated to ${newEmail}`,
+        user: sanitizeUser(user),
+      });
+    }
+
+    if (pathname === '/api/account/reveal-secrets' && req.method === 'POST') {
+      const user = getActiveUser(req);
+      if (!user) return sendJson(res, 401, { error: 'Not authenticated' });
+      const body = await parseJsonBody(req);
+      const reauthToken = body.reauthToken || req.headers['x-reauth-token'];
+
+      if (!isUserReauthenticated(user, reauthToken)) {
+        return sendJson(res, 403, {
+          error: 'Step-up passkey reauthentication is required to view sensitive security keys and PINs.',
+          requireReauth: true,
+        });
+      }
+
+      addAuditLog(user, 'sensitive-action', 'Security Secrets Revealed (Re-auth Verified)', 'Viewed Grind Rewards Card PIN & Account Recovery Code');
+      saveDb();
+
+      return sendJson(res, 200, {
+        ok: true,
+        secrets: {
+          giftCardNumber: '6045 8821 9034 4829',
+          giftCardPin: user.giftCardPin || '8492',
+          recoveryCode: user.recoveryCode || 'DG-9482-ROAST-2026',
+          apiPersonalToken: `dg_live_${Buffer.from(user.id).toString('hex').slice(0, 16)}`,
+        },
+        user: sanitizeUser(user),
+      });
+    }
+
+    if (pathname === '/api/account/wallet/reload' && req.method === 'POST') {
+      const user = getActiveUser(req);
+      if (!user) return sendJson(res, 401, { error: 'Not authenticated' });
+      const body = await parseJsonBody(req);
+      const reauthToken = body.reauthToken || req.headers['x-reauth-token'];
+
+      if (!isUserReauthenticated(user, reauthToken)) {
+        return sendJson(res, 403, {
+          error: 'Step-up passkey reauthentication is required to charge your saved payment method.',
+          requireReauth: true,
+        });
+      }
+
+      const amount = Number(body.amount) || 25;
+      user.walletBalance = Number(((user.walletBalance || 0) + amount).toFixed(2));
+      user.rewardsPoints = (user.rewardsPoints || 0) + Math.round(amount * 10);
+      addAuditLog(
+        user,
+        'sensitive-action',
+        'Coffee Wallet Reloaded (Re-auth Verified)',
+        `Authorized $${amount.toFixed(2)} reload via ${user.paymentMethod || 'Visa •••• 4242'} using passkey verification`
+      );
+      saveDb();
+
+      return sendJson(res, 200, {
+        ok: true,
+        message: `Reloaded $${amount.toFixed(2)} to your Daily Grind Wallet!`,
+        user: sanitizeUser(user),
+      });
+    }
+
+    if (pathname === '/api/account/order' && req.method === 'POST') {
+      const user = getActiveUser(req);
+      if (!user) return sendJson(res, 401, { error: 'Please sign in with your passkey to place an order.' });
+      const body = await parseJsonBody(req);
+      const item = body.item || 'Seasonal Artisan Coffee';
+      const amount = Number(body.amount) || 5.75;
+      const reauthToken = body.reauthToken || req.headers['x-reauth-token'];
+
+      if (body.requireReauth && !isUserReauthenticated(user, reauthToken)) {
+        return sendJson(res, 403, {
+          error: 'Passkey reauthentication required to authorize this order.',
+          requireReauth: true,
+        });
+      }
+
+      user.walletBalance = Math.max(0, Number(((user.walletBalance || 0) - amount).toFixed(2)));
+      user.rewardsPoints = (user.rewardsPoints || 0) + Math.round(amount * 15);
+      const order = {
+        id: `ORD-${Math.floor(1000 + Math.random() * 9000)}`,
+        item,
+        amount,
+        timestamp: new Date().toISOString(),
+        status: 'Brewing Now',
+      };
+      user.orders = user.orders || [];
+      user.orders.unshift(order);
+      addAuditLog(user, 'order', 'Coffee Order Authorized', `Ordered ${item} ($${amount.toFixed(2)})`);
+      saveDb();
+
+      return sendJson(res, 200, {
+        ok: true,
+        order,
+        user: sanitizeUser(user),
+      });
+    }
+
+    if (pathname === '/api/account' && req.method === 'DELETE') {
+      const user = getActiveUser(req);
+      if (!user) return sendJson(res, 401, { error: 'Not authenticated' });
+      const body = await parseJsonBody(req);
+      const reauthToken = body.reauthToken || req.headers['x-reauth-token'];
+
+      if (!isUserReauthenticated(user, reauthToken)) {
+        return sendJson(res, 403, {
+          error: 'Step-up passkey reauthentication is required to delete your account.',
+          requireReauth: true,
+        });
+      }
+
+      db.users = db.users.filter((u) => u.id !== user.id);
+      db.activeUserId = null;
+      saveDb();
+
+      return sendJson(res, 200, {
+        ok: true,
+        deleted: true,
+      });
+    }
+
+    // ------------------------------------------------------------------------
+    // Static Files & SPA Route Fallback
+    // ------------------------------------------------------------------------
+    let filePath = path.join(__dirname, pathname === '/' ? 'index.html' : pathname);
+    if (fs.existsSync(filePath) && fs.statSync(filePath).isDirectory()) {
+      filePath = path.join(filePath, 'index.html');
+    }
+
+    if (fs.existsSync(filePath) && fs.statSync(filePath).isFile()) {
+      const ext = path.extname(filePath).toLowerCase();
+      const contentType = MIME_TYPES[ext] || 'application/octet-stream';
+      const content = fs.readFileSync(filePath);
+      res.writeHead(200, { 'Content-Type': contentType, 'Cache-Control': 'no-cache' });
+      return res.end(content);
+    }
+
+    // Fallback to index.html for all client-side routes (/login, /register, /account, /reauthenticate, etc.)
+    const indexHtmlPath = path.join(__dirname, 'index.html');
+    const htmlContent = fs.readFileSync(indexHtmlPath);
+    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-cache' });
+    return res.end(htmlContent);
+  } catch (err) {
+    sendJson(res, 500, { error: err.message || 'Internal Server Error' });
+  }
+});
+
+// Resolve port from CLI (--port 11222) or process.env.PORT
+function resolvePort() {
+  const args = process.argv.slice(2);
+  for (let i = 0; i < args.length; i++) {
+    if ((args[i] === '--port' || args[i] === '-p') && args[i + 1]) {
+      const p = Number(args[i + 1]);
+      if (!Number.isNaN(p) && p > 0) return p;
+    }
+    if (args[i].startsWith('--port=')) {
+      const p = Number(args[i].split('=')[1]);
+      if (!Number.isNaN(p) && p > 0) return p;
+    }
+  }
+  return Number(process.env.PORT) || 11222;
+}
+
+if (require.main === module) {
+  const port = resolvePort();
+  server.listen(port, () => {
+    console.log(`The Daily Grind Passkey Server listening on http://localhost:${port}`);
+  });
+}
+
+module.exports = {
+  server,
+  encodeCBOR,
+  decodeCBOR,
+  parseAuthenticatorData,
+  verifyWebAuthnSignature,
+};
