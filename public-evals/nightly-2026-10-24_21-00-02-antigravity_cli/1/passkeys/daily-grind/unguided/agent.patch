+  color: var(--primary);
+  border-color: var(--primary);
+}
+
+.btn-outline:hover:not(:disabled) {
+  background: var(--secondary-light);
+}
+
+.btn-danger {
+  background: var(--danger-bg);
+  color: var(--danger);
+  border-color: #ef9a9a;
+}
+
+.btn-danger:hover:not(:disabled) {
+  background: var(--danger);
+  color: white;
+}
+
+.btn-sm {
+  padding: 6px 12px;
+  font-size: 0.84rem;
+}
+
+.btn-block {
+  width: 100%;
+}
+
+/* View Switcher Bar */
+.workspace-tabs {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  background: var(--secondary-light);
+  padding: 8px;
+  border-radius: 10px;
+  margin-bottom: 24px;
+  border: 1px solid var(--border);
+}
+
+.workspace-tab {
+  flex: 1;
+  min-width: 150px;
+  padding: 10px 14px;
+  border: none;
+  border-radius: 7px;
+  background: transparent;
+  color: var(--text);
+  font-weight: 600;
+  font-size: 0.92rem;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  transition: all 0.2s;
+}
+
+.workspace-tab:hover {
+  background: rgba(78, 52, 46, 0.08);
+}
+
+.workspace-tab.active {
+  background: var(--primary);
+  color: white;
+  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
+}
+
+/* Status Banner / Toast */
+.status-banner {
+  padding: 14px 18px;
+  border-radius: 8px;
+  margin-bottom: 20px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  font-weight: 500;
+  border: 1px solid transparent;
+}
+
+.status-banner.hidden {
+  display: none;
+}
+
+.status-banner.success {
+  background: var(--success-bg);
+  color: var(--success);
+  border-color: #a5d6a7;
+}
+
+.status-banner.error {
+  background: var(--danger-bg);
+  color: var(--danger);
+  border-color: #ef9a9a;
+}
+
+.status-banner.info {
+  background: var(--info-bg);
+  color: var(--info);
+  border-color: #90caf9;
+}
+
+.status-banner.warning {
+  background: var(--warning-bg);
+  color: var(--warning);
+  border-color: #ffcc80;
+}
+
+/* Forms */
+.form-group {
+  margin-bottom: 16px;
+  text-align: left;
+}
+
+.form-group label {
+  display: block;
+  font-weight: 600;
+  font-size: 0.9rem;
+  margin-bottom: 6px;
+  color: var(--primary-dark);
+}
+
+.form-control {
+  width: 100%;
+  padding: 10px 13px;
+  border: 1px solid #bcaaa4;
+  border-radius: 6px;
+  font-size: 0.95rem;
+  color: var(--text);
+  background: var(--white);
+  transition: border-color 0.2s, box-shadow 0.2s;
+}
+
+.form-control:focus {
+  outline: none;
+  border-color: var(--primary);
+  box-shadow: 0 0 0 3px rgba(78, 52, 46, 0.15);
+}
+
+.form-hint {
+  display: block;
+  font-size: 0.8rem;
+  color: var(--text-muted);
+  margin-top: 4px;
+}
+
+/* Auth Container */
+.auth-wrapper {
+  max-width: 560px;
+  margin: 0 auto 32px auto;
+}
+
+.auth-mode-toggle {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  background: var(--secondary-light);
+  padding: 5px;
+  border-radius: 8px;
+  margin-bottom: 20px;
+}
+
+.auth-mode-btn {
+  padding: 10px;
+  border: none;
+  background: transparent;
+  font-weight: 600;
+  color: var(--text);
+  border-radius: 6px;
+  cursor: pointer;
+}
+
+.auth-mode-btn.active {
+  background: var(--white);
+  color: var(--primary);
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
+}
+
+.divider {
+  display: flex;
+  align-items: center;
+  margin: 18px 0;
+  color: var(--text-muted);
+  font-size: 0.82rem;
+  text-transform: uppercase;
+  letter-spacing: 0.5px;
+}
+
+.divider::before,
+.divider::after {
+  content: '';
+  flex: 1;
+  height: 1px;
+  background: var(--border);
+}
+
+.divider span {
+  padding: 0 12px;
+}
+
+/* Account Profile Summary Bar */
+.account-header-card {
+  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
+  color: white;
+  padding: 24px 28px;
+  border-radius: 12px;
+  margin-bottom: 24px;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 20px;
+  box-shadow: var(--shadow);
+}
+
+.account-user-info h2 {
+  color: white;
+  font-size: 1.55rem;
+  margin-bottom: 4px;
+}
+
+.account-user-meta {
+  color: var(--secondary);
+  font-size: 0.92rem;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 14px;
+  align-items: center;
+}
+
+.account-stats {
+  display: flex;
+  gap: 16px;
+  flex-wrap: wrap;
+}
+
+.stat-box {
+  background: rgba(255, 255, 255, 0.1);
+  border: 1px solid rgba(255, 255, 255, 0.18);
+  padding: 10px 16px;
+  border-radius: 8px;
+  min-width: 125px;
+  text-align: center;
+}
+
+.stat-box .stat-label {
+  font-size: 0.75rem;
+  text-transform: uppercase;
+  color: var(--secondary);
+  display: block;
+}
+
+.stat-box .stat-value {
+  font-size: 1.2rem;
+  font-weight: 700;
+  color: var(--accent);
+}
+
+/* Passkey Items List */
+.passkeys-list {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  margin-top: 16px;
+}
+
+.passkey-item {
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 16px 18px;
+  background: var(--light);
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  transition: border-color 0.2s, box-shadow 0.2s;
+}
+
+.passkey-item:hover {
+  border-color: #a1887f;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
+}
+
+.passkey-item-top {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.passkey-title-group {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.passkey-icon {
+  width: 42px;
+  height: 42px;
+  border-radius: 8px;
+  background: var(--primary);
+  color: var(--accent);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 1.25rem;
+  flex-shrink: 0;
+}
+
+.passkey-name {
+  font-size: 1.05rem;
+  font-weight: 700;
+  color: var(--primary-dark);
+}
+
+.passkey-provider {
+  font-size: 0.83rem;
+  color: var(--text-muted);
+}
+
+.passkey-badges {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 3px 9px;
+  border-radius: 999px;
+  font-size: 0.75rem;
+  font-weight: 600;
+}
+
+.badge-synced {
+  background: var(--success-bg);
+  color: var(--success);
+}
+
+.badge-hardware {
+  background: var(--info-bg);
+  color: var(--info);
+}
+
+.badge-alg {
+  background: var(--secondary-light);
+  color: var(--primary);
+  border: 1px solid var(--secondary);
+}
+
+.badge-verified {
+  background: var(--success-bg);
+  color: var(--success);
+  border: 1px solid #81c784;
+}
+
+.badge-unverified {
+  background: var(--warning-bg);
+  color: var(--warning);
+  border: 1px solid #ffb74d;
+}
+
+.passkey-details-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 10px;
+  font-size: 0.82rem;
+  color: var(--text-muted);
+  border-top: 1px dashed var(--border);
+  padding-top: 10px;
+}
+
+.passkey-actions {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+}
+
+.rename-inline-box {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+  background: white;
+  padding: 10px;
+  border-radius: 6px;
+  border: 1px solid var(--primary);
+}
+
+.rename-inline-box.hidden {
+  display: none;
+}
+
+.add-passkey-box {
+  background: var(--secondary-light);
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  padding: 16px;
+  margin-bottom: 18px;
+}
+
+.add-passkey-row {
+  display: flex;
+  gap: 10px;
+  flex-wrap: wrap;
+  align-items: flex-end;
+}
+
+.add-passkey-row .form-group {
+  flex: 1;
+  min-width: 180px;
+  margin-bottom: 0;
+}
+
+/* Reauthentication & Sensitive Actions */
+.reauth-banner-box {
+  padding: 16px;
+  border-radius: 8px;
+  margin-bottom: 18px;
+  border: 1px solid var(--border);
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 12px;
+}
+
+.reauth-banner-box.verified {
+  background: var(--success-bg);
+  border-color: #a5d6a7;
+}
+
+.reauth-banner-box.locked {
+  background: var(--warning-bg);
+  border-color: #ffcc80;
+}
+
+.sensitive-action-block {
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  padding: 16px;
+  margin-bottom: 14px;
+  background: var(--light);
+}
+
+.sensitive-action-block h4 {
+  color: var(--primary-dark);
+  margin-bottom: 6px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.secrets-vault {
+  background: #261815;
+  color: #ffe0b2;
+  font-family: monospace;
+  padding: 12px 14px;
+  border-radius: 6px;
+  margin: 10px 0;
+  font-size: 0.88rem;
+  display: grid;
+  gap: 6px;
+}
+
+/* Audit Log */
+.audit-log-list {
+  list-style: none;
+  max-height: 280px;
+  overflow-y: auto;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.audit-log-item {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  gap: 12px;
+  padding: 10px 12px;
+  background: var(--light);
+  border-radius: 6px;
+  border-left: 4px solid var(--primary);
+  font-size: 0.86rem;
+}
+
+.audit-log-item.type-reauthenticate {
+  border-left-color: var(--accent-dark);
+}
+
+.audit-log-item.type-register,
+.audit-log-item.type-add-passkey {
+  border-left-color: var(--success);
+}
+
+.audit-log-item.type-delete-passkey {
+  border-left-color: var(--danger);
+}
+
+/* Modal */
+.modal-backdrop {
+  position: fixed;
+  inset: 0;
+  background: rgba(30, 18, 15, 0.68);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: 2000;
+  padding: 20px;
+}
+
+.modal-backdrop.hidden {
+  display: none;
+}
+
+.modal-card {
+  background: var(--white);
+  max-width: 480px;
+  width: 100%;
+  border-radius: 12px;
+  padding: 28px;
+  box-shadow: var(--shadow-lg);
+  border: 1px solid var(--border);
+  text-align: left;
+}
+
+.modal-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 14px;
+}
+
+.modal-header h3 {
+  color: var(--primary);
+  font-size: 1.25rem;
+}
+
+.modal-close {
+  background: none;
+  border: none;
+  font-size: 1.4rem;
+  cursor: pointer;
+  color: var(--text-muted);
+}
+
+.ceremony-steps {
+  margin: 14px 0;
+  padding: 12px;
+  background: var(--secondary-light);
+  border-radius: 8px;
+  font-size: 0.85rem;
+}
+
+/* Footer */
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 32px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 14px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.hidden {
+  display: none !important;
+}
