+function verifyWebAuthnSignature({ publicKeyJwk, publicKeySpki, alg = -7, authDataBuffer, clientDataBuffer, signatureBuffer }) {
+  const clientDataHash = crypto.createHash('sha256').update(clientDataBuffer).digest();
+  const signedData = Buffer.concat([Buffer.from(authDataBuffer), clientDataHash]);
+
+  let keyObject = null;
+  if (publicKeyJwk) {
+    keyObject = crypto.createPublicKey({ key: publicKeyJwk, format: 'jwk' });
+  } else if (publicKeySpki) {
+    keyObject = crypto.createPublicKey({
+      key: Buffer.from(publicKeySpki, 'base64url'),
+      format: 'der',
+      type: 'spki',
+    });
+  } else {
+    throw new Error('No public key available for signature verification');
+  }
+
+  if (alg === -8) {
+    return crypto.verify(null, signedData, keyObject, signatureBuffer);
+  }
+
+  // Try standard ASN.1 DER signature first (WebAuthn spec standard)
+  try {
+    if (crypto.verify('sha256', signedData, keyObject, signatureBuffer)) {
+      return true;
+    }
+  } catch (_e) {
+    // Proceed to IEEE-P1363 fallback
+  }
+
+  // Fallback for raw 64-byte IEEE-P1363 ECDSA signature (r || s)
+  try {
+    if (crypto.verify('sha256', signedData, { key: keyObject, dsaEncoding: 'ieee-p1363' }, signatureBuffer)) {
+      return true;
+    }
+  } catch (_e) {
+    // Verification failed
+  }
+
+  return false;
+}
