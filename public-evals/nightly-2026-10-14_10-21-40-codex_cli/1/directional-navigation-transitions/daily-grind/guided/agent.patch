+  <script>
+    const seasonalSlides = Array.from(document.querySelectorAll('#seasonal-slides .card'));
+    const seasonalStatus = document.getElementById('seasonal-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let seasonalIndex = 0;
+    let seasonalAnimation;
+
+    function showSeasonalSlide(direction) {
+      seasonalAnimation?.cancel();
+      seasonalSlides[seasonalIndex].hidden = true;
+      seasonalIndex = (seasonalIndex + direction + seasonalSlides.length) % seasonalSlides.length;
+      const slide = seasonalSlides[seasonalIndex];
+      slide.hidden = false;
+      seasonalStatus.textContent = `${seasonalIndex + 1} of ${seasonalSlides.length}: ${slide.querySelector('h3').textContent}`;
+
+      if (!reducedMotion.matches && typeof slide.animate === 'function') {
+        seasonalAnimation = slide.animate(
+          [
+            { transform: `translateX(${direction > 0 ? '100%' : '-100%'})` },
+            { transform: 'translateX(0)' }
+          ],
+          { duration: 300, easing: 'ease-out' }
+        );
+      }
+    }
+
+    document.getElementById('seasonal-previous').addEventListener('click', () => showSeasonalSlide(-1));
+    document.getElementById('seasonal-next').addEventListener('click', () => showSeasonalSlide(1));
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) seasonalAnimation?.cancel();
+    });
+  </script>
