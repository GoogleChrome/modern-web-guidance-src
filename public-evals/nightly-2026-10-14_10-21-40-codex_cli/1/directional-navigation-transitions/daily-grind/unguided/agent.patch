+  <script>
+    const seasonalCards = Array.from(document.querySelectorAll('#seasonal-items .card'));
+    const seasonalStatus = document.getElementById('seasonal-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let seasonalIndex = 0;
+    let seasonalAnimation;
+
+    function showSeasonalItem(direction) {
+      seasonalAnimation?.cancel();
+      seasonalCards[seasonalIndex].hidden = true;
+      seasonalIndex = (seasonalIndex + direction + seasonalCards.length) % seasonalCards.length;
+      const card = seasonalCards[seasonalIndex];
+      card.hidden = false;
+      seasonalStatus.textContent = `${seasonalIndex + 1} of ${seasonalCards.length}: ${card.querySelector('h3').textContent}`;
+
+      if (!reducedMotion.matches) {
+        seasonalAnimation = card.animate(
+          [
+            { transform: `translateX(${direction * 100}%)`, opacity: 0 },
+            { transform: 'translateX(0)', opacity: 1 }
+          ],
+          { duration: 320, easing: 'ease-out' }
+        );
+      }
+    }
+
+    document.getElementById('seasonal-previous').addEventListener('click', () => showSeasonalItem(-1));
+    document.getElementById('seasonal-next').addEventListener('click', () => showSeasonalItem(1));
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) seasonalAnimation?.cancel();
+    });
+    document.querySelector('.seasonal-controls').hidden = false;
+  </script>
