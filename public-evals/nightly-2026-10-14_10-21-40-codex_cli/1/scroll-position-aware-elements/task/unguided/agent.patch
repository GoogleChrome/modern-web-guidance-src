diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -26,8 +26,72 @@
       color: var(--text);
       background-color: var(--light);
     }
 
+    .scroller {
+      position: relative;
+      height: 100vh;
+      height: 100dvh;
+      overflow-y: auto;
+    }
+
+    /* Observe the first 160px without adding space to the page. */
+    .scroll-sentinel {
+      position: absolute;
+      top: 0;
+      left: 0;
+      width: 1px;
+      height: 160px;
+      pointer-events: none;
+    }
+
+    .back-to-top {
+      position: fixed;
+      right: max(24px, env(safe-area-inset-right));
+      bottom: max(24px, env(safe-area-inset-bottom));
+      z-index: 1001;
+      display: grid;
+      place-items: center;
+      width: 48px;
+      height: 48px;
+      border: 0;
+      border-radius: 50%;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 4px 14px rgb(0 0 0 / 20%);
+      cursor: pointer;
+      opacity: 0;
+      visibility: hidden;
+      pointer-events: none;
+      transform: translateY(16px);
+      transition: opacity 200ms ease, transform 200ms ease,
+        visibility 0s linear 200ms;
+    }
+
+    .back-to-top.is-visible {
+      opacity: 1;
+      visibility: visible;
+      pointer-events: auto;
+      transform: translateY(0);
+      transition-delay: 0s;
+    }
+
+    .back-to-top:hover {
+      background: #3e2723;
+    }
+
+    .back-to-top:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .back-to-top {
+        transition: none;
+        transform: none;
+      }
+    }
+
     /* Navigation */
     nav {
       background: var(--primary);
       color: white;
@@ -155,8 +219,10 @@
   </style>
 </head>
 
 <body>
+  <div class="scroller" tabindex="-1" role="region" aria-label="The Daily Grind">
+  <div class="scroll-sentinel" aria-hidden="true"></div>
 
   <nav>
     <div class="logo">THE DAILY GRIND</div>
     <ul>
@@ -206,7 +272,42 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <button class="back-to-top" type="button" aria-label="Back to top" aria-hidden="true" disabled>
+    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
+      <path d="m6 12 6-6 6 6M12 6v12" />
+    </svg>
+  </button>
+  </div>
+
+  <script>
+    const scroller = document.querySelector('.scroller');
+    const backToTop = scroller.querySelector('.back-to-top');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    const observer = new IntersectionObserver(([entry]) => {
+      const visible = !entry.isIntersecting;
+
+      if (!visible && document.activeElement === backToTop) {
+        scroller.focus({ preventScroll: true });
+      }
+
+      backToTop.disabled = !visible;
+      backToTop.setAttribute('aria-hidden', String(!visible));
+      backToTop.classList.toggle('is-visible', visible);
+    }, { root: scroller, threshold: 0 });
+
+    observer.observe(scroller.querySelector('.scroll-sentinel'));
+
+    backToTop.addEventListener('click', () => {
+      scroller.focus({ preventScroll: true });
+      scroller.scrollTo({
+        top: 0,
+        behavior: reducedMotion.matches ? 'instant' : 'smooth'
+      });
+    });
+  </script>
+
 </body>
 
 </html>
