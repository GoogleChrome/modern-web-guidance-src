+  <script>
+    const heroHeading = document.querySelector('.hero h1');
+    const headingLines = [...heroHeading.querySelectorAll('span')];
+    let previousWidth = 0;
+
+    function fitHeadingLines() {
+      const width = heroHeading.clientWidth;
+      if (!width || width === previousWidth) return;
+      previousWidth = width;
+
+      // Measure each line in its actual font, then size the letters to fit.
+      for (const line of headingLines) {
+        line.style.fontSize = '100px';
+        const measuredWidth = line.getBoundingClientRect().width;
+        line.style.fontSize = `${100 * width / measuredWidth}px`;
+      }
+    }
+
+    fitHeadingLines();
+    new ResizeObserver(fitHeadingLines).observe(heroHeading);
+    document.fonts.ready.then(() => {
+      previousWidth = 0;
+      fitHeadingLines();
+    });
+  </script>
