+  <script type="module">
+    const rewardsButton = document.getElementById('rewards-toggle');
+    const rewardsPopover = document.getElementById('rewards-popover');
+
+    if (typeof rewardsPopover.showPopover === 'function') {
+      rewardsPopover.addEventListener('toggle', (event) => {
+        rewardsButton.setAttribute('aria-expanded', String(event.newState === 'open'));
+      });
+    } else {
+      // Fetch the fallback only on interaction in browsers without native support.
+      let fallback;
+      let loading = false;
+      rewardsButton.addEventListener('click', async () => {
+        if (loading) return;
+        loading = true;
+        try {
+          fallback ??= import('./rewards-popover-fallback.js').then(({ setupRewardsPopover }) =>
+            setupRewardsPopover(rewardsButton, rewardsPopover));
+          const toggle = await fallback;
+          toggle();
+        } catch (error) {
+          fallback = undefined;
+          console.error('Unable to load rewards controls.', error);
+        } finally {
+          loading = false;
+        }
+      });
+    }
+  </script>
