+  <script type="module">
+    // Native browsers fetch no polyfill. Await only the dependency that is needed.
+    if (!("popover" in HTMLElement.prototype)) {
+      const rewardsButton = document.querySelector('.rewards-toggle');
+      rewardsButton.disabled = true;
+      try {
+        await import('./vendor/popover-polyfill-0.7.3.min.js');
+      } catch (error) {
+        // Keep rewards reachable if the optional local asset fails to load.
+        rewardsButton.removeAttribute('popovertarget');
+        rewardsButton.addEventListener('click', () => window.location.assign('/rewards'));
+        console.error('Unable to load the rewards popover fallback.', error);
+      } finally {
+        rewardsButton.disabled = false;
+      }
+    }
+  </script>
