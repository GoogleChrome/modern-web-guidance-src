+type Passkey = { id: string; name: string; createdAt: number; lastUsed: number | null };
+type Account = { user: { username: string; hasPassword: boolean } | null; verified: boolean; passkeys: Passkey[] };
+export default function AccountSecurity() {
+  const modalRef = useRef<HTMLElement>(null);
+  const [account, setAccount] = useState<Account | null>(null);
+  const [error, setError] = useState(''); const [message, setMessage] = useState(''); const [busy, setBusy] = useState(false);
+  const [dialog, setDialog] = useState<'add' | 'verify' | 'rename' | 'remove' | null>(null);
+  const [selected, setSelected] = useState<Passkey | null>(null); const [name, setName] = useState(''); const [password, setPassword] = useState('');
+  useEffect(() => {
+    if (!dialog) return;
+    const previous = document.activeElement as HTMLElement | null;
+    const modal = modalRef.current;
+    const focusable = () => Array.from(modal?.querySelectorAll<HTMLElement>('button:not(:disabled), input, a[href]') || []);
+    focusable()[0]?.focus();
+    function handleKey(event: KeyboardEvent) {
+      if (event.key === 'Escape' && !busy) { setDialog(null); setError(''); setPassword(''); }
+      if (event.key === 'Tab') {
+        const elements = focusable(); const first = elements[0]; const last = elements.at(-1);
+        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
+        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
+      }
+    }
+    document.addEventListener('keydown', handleKey);
+    return () => { document.removeEventListener('keydown', handleKey); previous?.focus(); };
+  }, [dialog, busy]);
+  async function refresh() { setAccount(await api('account')); }
+  useEffect(() => { refresh().catch(e => setError(e.message)); }, []);
+  async function run(action: () => Promise<void>, success = '') {
+    setBusy(true); setError(''); setMessage('');
+    try { await action(); await refresh(); setDialog(null); setMessage(success); }
+    catch (e) { setError(e instanceof Error ? e.message : 'Please try again.'); }
+    finally { setBusy(false); }
+  }
+  function open(kind: 'add' | 'rename' | 'remove', key?: Passkey) {
+    setError(''); setMessage(''); setSelected(key || null); setName(key?.name || '');
+    setDialog(account?.verified ? kind : 'verify');
+  }
+  const date = (value: number) => new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
+  if (!account) return <div className="security-page"><p role="status">{error || 'Loading your account…'}</p></div>;
+  if (!account.user) return <div className="security-page"><div className="empty-state"><LockClosedIcon /><h1>Your account, protected.</h1><p>Sign in to manage your passkeys and account security.</p><a className="primary-button" href={`${base}signin`}>Sign in <ArrowRightIcon /></a></div></div>;
+  return <div className="security-page">
+    <a className="back-link" href={base}><ArrowLeftIcon /> Back to the Times</a>
+    <div className="account-heading"><div><span className="eyebrow">YOUR ACCOUNT</span><h1>Account & security</h1><p className="muted">A little peace of mind for your daily read.</p></div><div className="account-profile"><span className="avatar">{account.user.username.slice(0, 1).toUpperCase()}</span><div><strong>{account.user.username}</strong><button disabled={busy} onClick={() => run(async () => { await api('logout', {}); window.location.assign(`${base}signin`); })}>Sign out ↗</button></div></div></div>
+    <div className="account-tabs"><span><ShieldCheckIcon /> Security</span></div>
+    <div className="security-banner"><div className="icon-tile"><ShieldCheckIcon /></div><div><span className="eyebrow">GOOD NEWS FOR YOUR SECURITY</span><h2>Your face. Your fingerprint. Your way in.</h2><p>Passkeys make signing in easier and help keep your account safe. No passwords, no guesswork.</p></div><span className="badge"><CheckIcon /> Built-in protection</span></div>
+    {error && !dialog && <p className="notice error" role="alert">{error}</p>}{message && <p className="notice success" role="status">{message}</p>}
+    <div className="security-columns"><section className="passkeys-panel"><div className="panel-heading"><div><h2>Passkeys <span className="count">{account.passkeys.length}</span></h2><p className="muted">A secure, password-free way to sign in.</p></div><button className="primary-button compact" disabled={busy} onClick={() => open('add')}><PlusIcon /> Add a passkey</button></div>
+      {account.passkeys.length === 0 ? <div className="empty-state"><FingerPrintIcon /><h3>Your first passkey is one tap away.</h3><p>Create a passkey on this device, or use a security key.<br />Your private key always stays with you.</p><button className="secondary-button" onClick={() => open('add')}>Create your first passkey <ArrowRightIcon /></button></div> : <div className="passkey-list">{account.passkeys.map(key => <div className="passkey-row" key={key.id}><div className="key-icon"><KeyIcon /></div><div className="key-details"><h3>{key.name}</h3><p>Added {date(key.createdAt)}</p><p>Last used: {key.lastUsed ? date(key.lastUsed) : 'Not used yet'}</p></div><div className="key-actions"><button disabled={busy} onClick={() => open('rename', key)}>Rename</button><button disabled={busy} onClick={() => open('remove', key)}>Remove</button></div></div>)}</div>}
+      <div className="panel-footnote"><LockClosedIcon /> Your biometric data is never shared with the Times.</div>
+    </section><aside className="security-help"><div className="small-icon"><FingerPrintIcon /></div><h3>What's a passkey?</h3><p>Think of it as a digital key to your account. Unlock it with the same fingerprint, face, or PIN you use on your device.</p><div className="help-item"><CheckIcon /><span><strong>Safer by design</strong><br />Passkeys help protect against phishing.</span></div><div className="help-item"><CheckIcon /><span><strong>Ready when you are</strong><br />Your password manager can sync passkeys across devices.</span></div><div className="help-item"><CheckIcon /><span><strong>Made for you</strong><br />Use your phone, computer, or a physical security key.</span></div></aside></div>
