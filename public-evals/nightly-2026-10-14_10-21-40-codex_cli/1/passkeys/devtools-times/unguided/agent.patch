index 0000000..3645dc0
--- /dev/null
+++ b/src/pages/api/auth/[action].ts
@@ -0,0 +1,119 @@
+import type { APIRoute } from 'astro';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { db, token, hash, passwordHash, passwordMatches, userByName, keysFor, takeChallenge, type User, type Key } from '../../../lib/auth-store';
+
+export const ALL: APIRoute = async ({ request, cookies, params, url }) => {
+  const reply = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+  const origin = process.env.AUTH_ORIGIN || url.origin;
+  const rpID = new URL(origin).hostname;
+  const cookieOptions = { path: import.meta.env.BASE_URL, httpOnly: true, sameSite: 'strict' as const, secure: new URL(origin).protocol === 'https:' };
+  const now = Date.now();
+  const sessionToken = cookies.get('auth_session')?.value;
+  const session = sessionToken ? db.prepare('SELECT sessions.*, users.username, users.password FROM sessions JOIN users ON users.id = sessions.user_id WHERE sessions.id = ? AND expires > ?').get(hash(sessionToken), now) as { id: string; user_id: string; username: string; password: string | null; verified_at: number } | undefined : undefined;
+  const requireSession = () => { if (!session) throw new Error('Please sign in to continue.'); return session; };
+  const requireRecent = () => { const s = requireSession(); if (now - s.verified_at > 300000) throw new Error('Please verify your identity before making this change.'); return s; };
+  const signIn = (userID: string) => {
+    if (sessionToken) db.prepare('DELETE FROM sessions WHERE id = ?').run(hash(sessionToken));
+    const value = token();
+    db.prepare('INSERT INTO sessions VALUES (?, ?, ?, ?)').run(hash(value), userID, now + 7 * 86400000, now);
+    cookies.set('auth_session', value, { ...cookieOptions, maxAge: 7 * 86400 });
+  };
+  try {
+    if (request.method === 'GET' && params.action === 'account') {
+      if (!session) return reply({ user: null });
+      return reply({ user: { username: session.username, hasPassword: !!session.password }, verified: now - session.verified_at < 300000, passkeys: keysFor(session.user_id).map(k => ({ id: k.id, name: k.name, createdAt: k.created_at, lastUsed: k.last_used })) });
+    }
+    if (request.method !== 'POST') return reply({ error: 'Method not allowed.' }, 405);
+    if (request.headers.get('origin') !== origin) return reply({ error: 'Invalid request origin.' }, 403);
+    if (Number(request.headers.get('content-length') || 0) > 65536) return reply({ error: 'Request too large.' }, 413);
+    db.prepare('DELETE FROM sessions WHERE expires < ?').run(now);
+    db.prepare('DELETE FROM limits WHERE expires < ?').run(now);
+    const rateKey = session?.id || hash(cookies.get('auth_challenge')?.value || request.headers.get('x-forwarded-for') || 'anonymous');
+    const limit = db.prepare('INSERT INTO limits VALUES (?, 1, ?) ON CONFLICT(key) DO UPDATE SET count = count + 1 RETURNING count').get(rateKey, now + 60000) as { count: number };
+    if (limit.count > 60) return reply({ error: 'Too many attempts. Please wait a minute.' }, 429);
+    const body = await request.json();
+    const username = typeof body.username === 'string' ? body.username.trim() : '';
+    const validName = () => { if (!/^[a-zA-Z0-9_.@+-]{3,80}$/.test(username)) throw new Error('Use 3–80 characters: letters, numbers, or . _ @ + -'); };
+    const name = typeof body.name === 'string' ? body.name.trim().slice(0, 60) : 'My passkey';
+    if (params.action === 'logout') {
+      if (session) db.prepare('DELETE FROM sessions WHERE id = ?').run(session.id);
+      cookies.delete('auth_session', cookieOptions); return reply({ ok: true });
+    }
+    if (params.action === 'register') {
+      validName();
+      if (typeof body.password !== 'string' || body.password.length < 8 || body.password.length > 128 || !/\d/.test(body.password)) throw new Error('Password must be 8–128 characters and include a number.');
+      if (userByName(username)) throw new Error('This username is already taken.');
+      const id = token(); db.prepare('INSERT INTO users VALUES (?, ?, ?)').run(id, username, passwordHash(body.password)); signIn(id); return reply({ ok: true });
+    }
+    if (params.action === 'login' || params.action === 'reauth-password') {
+      const user = params.action === 'login' ? userByName(username) : db.prepare('SELECT * FROM users WHERE id = ?').get(requireSession().user_id) as User;
+      const password = typeof body.password === 'string' && body.password.length <= 128 ? body.password : '';
+      const matched = passwordMatches(password, user?.password || passwordHash('invalid-password'));
+      if (!user?.password || !matched) throw new Error('The username or password is incorrect.');
+      if (params.action === 'login') signIn(user.id);
+      else db.prepare('UPDATE sessions SET verified_at = ? WHERE id = ?').run(now, session!.id);
+      return reply({ ok: true });
+    }
+    if (params.action === 'rename' || params.action === 'remove') {
+      const s = requireRecent(); const keys = keysFor(s.user_id); const key = keys.find(k => k.id === body.id);
+      if (!key) throw new Error('Passkey not found.');
+      if (params.action === 'rename') { if (!name) throw new Error('Enter a name for this passkey.'); db.prepare('UPDATE passkeys SET name = ? WHERE id = ?').run(name, key.id); }
+      else { if (keys.length === 1 && !s.password) throw new Error('Add another passkey before removing your only sign-in method.'); db.prepare('DELETE FROM passkeys WHERE id = ?').run(key.id); }
+      return reply({ ok: true });
+    }
+    if (params.action === 'options') {
+      const purpose = body.purpose;
+      if (!['register', 'add', 'login', 'reauth'].includes(purpose)) throw new Error('Invalid operation.');
+      let userID: string | null = null;
+      if (purpose === 'register') { validName(); if (userByName(username)) throw new Error('This username is already taken.'); userID = token(); }
+      if (purpose === 'add') userID = requireRecent().user_id;
+      if (purpose === 'reauth') userID = requireSession().user_id;
+      const options = purpose === 'register' || purpose === 'add'
+        ? await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID, userID: Buffer.from(userID!), userName: purpose === 'add' ? session!.username : username, attestationType: 'none', excludeCredentials: keysFor(userID!).map(k => ({ id: k.id })), authenticatorSelection: { residentKey: 'required', userVerification: 'required' } })
+        : await generateAuthenticationOptions({ rpID, userVerification: 'required', ...(purpose === 'reauth' ? { allowCredentials: keysFor(userID!).map(k => ({ id: k.id })) } : {}) });
+      const previous = cookies.get('auth_challenge')?.value;
+      if (previous) takeChallenge(previous);
+      db.prepare('DELETE FROM challenges WHERE expires < ?').run(now);
+      const challengeToken = token();
+      db.prepare('INSERT INTO challenges VALUES (?, ?, ?, ?, ?, ?)').run(hash(challengeToken), options.challenge, purpose, userID, username || null, now + 300000);
+      cookies.set('auth_challenge', challengeToken, { ...cookieOptions, maxAge: 300 });
+      return reply(options);
+    }
+    if (params.action === 'verify') {
+      const challengeToken = cookies.get('auth_challenge')?.value;
+      const challenge = challengeToken ? takeChallenge(challengeToken) : undefined;
+      cookies.delete('auth_challenge', cookieOptions);
+      if (!challenge || challenge.expires < now) throw new Error('This request expired. Please try again.');
+      const { purpose, user_id: userID } = challenge;
+      if ((purpose === 'add' || purpose === 'reauth') && requireSession().user_id !== userID) throw new Error('Account changed. Please try again.');
+      if (purpose === 'register' || purpose === 'add') {
+        if (purpose === 'add') requireRecent();
+        const result = await verifyRegistrationResponse({ response: body.credential, expectedChallenge: challenge.challenge, expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true });
+        if (!result.verified || !result.registrationInfo) throw new Error('Passkey verification failed.');
+        const { credential } = result.registrationInfo;
+        db.exec('BEGIN IMMEDIATE');
+        try {
+          if (purpose === 'register') db.prepare('INSERT INTO users VALUES (?, ?, NULL)').run(userID!, challenge.username!);
+          db.prepare('INSERT INTO passkeys VALUES (?, ?, ?, ?, ?, ?, ?, NULL)').run(credential.id, userID!, name || 'My passkey', Buffer.from(credential.publicKey).toString('base64url'), credential.counter, JSON.stringify(credential.transports || []), now);
+          db.exec('COMMIT');
+        } catch (error) { db.exec('ROLLBACK'); throw error; }
+        if (purpose === 'register') signIn(userID!);
+      } else {
+        const key = db.prepare('SELECT * FROM passkeys WHERE id = ?').get(body.credential?.id || '') as Key | undefined;
+        if (!key || (purpose === 'reauth' && key.user_id !== userID)) throw new Error('This passkey is not registered for this account.');
+        if (body.credential.response?.userHandle && body.credential.response.userHandle !== Buffer.from(key.user_id).toString('base64url')) throw new Error('Account verification failed.');
+        const result = await verifyAuthenticationResponse({ response: body.credential, expectedChallenge: challenge.challenge, expectedOrigin: origin, expectedRPID: rpID, requireUserVerification: true, credential: { id: key.id, publicKey: Buffer.from(key.public_key, 'base64url'), counter: key.counter, transports: JSON.parse(key.transports) } });
+        if (!result.verified) throw new Error('Passkey verification failed.');
+        const updated = db.prepare('UPDATE passkeys SET counter = ?, last_used = ? WHERE id = ? AND counter = ?').run(result.authenticationInfo.newCounter, now, key.id, key.counter);
+        if (!updated.changes) throw new Error('Passkey changed. Please try again.');
+        if (purpose === 'login') signIn(key.user_id);
+        else db.prepare('UPDATE sessions SET verified_at = ? WHERE id = ?').run(now, session!.id);
+      }
+      return reply({ ok: true });
+    }
+    return reply({ error: 'Not found.' }, 404);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Request failed.';
+    return reply({ error: /UNIQUE constraint/.test(message) ? 'This account or passkey already exists.' : /Please|Password|username|passkey|Passkey|request|Account|Enter|sign-in|operation/.test(message) ? message : 'Verification failed. Please try again.' }, 400);
+  }
+};
