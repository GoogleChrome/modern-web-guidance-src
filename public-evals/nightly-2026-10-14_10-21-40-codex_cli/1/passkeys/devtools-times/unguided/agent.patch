diff --git a/tests/auth.test.mjs b/tests/auth.test.mjs
new file mode 100644
index 0000000..0ac2dfc
--- /dev/null
+++ b/tests/auth.test.mjs
@@ -0,0 +1,97 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { generateKeyPairSync, createHash, randomBytes, sign } from 'node:crypto';
+import { DatabaseSync } from 'node:sqlite';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+
+const origin = 'http://localhost:14329';
+const directory = mkdtempSync(`${tmpdir()}/times-auth-`);
+const server = spawn(process.execPath, ['dist/server/entry.mjs'], { env: { ...process.env, HOST: '127.0.0.1', PORT: '14329', AUTH_ORIGIN: origin, AUTH_DB_PATH: `${directory}/auth.sqlite` }, stdio: 'pipe' });
+let logs = ''; server.stderr.on('data', chunk => { logs += chunk; });
+const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));
+const sha = value => createHash('sha256').update(value).digest();
+const b64 = value => Buffer.from(value).toString('base64url');
+function client() {
+  const jar = new Map();
+  return async (action, body, customOrigin = origin) => {
+    const res = await fetch(`${origin}/devtools-times/api/auth/${action}`, { method: body === undefined ? 'GET' : 'POST', headers: { Origin: customOrigin, 'Content-Type': 'application/json', Cookie: [...jar].map(([k, v]) => `${k}=${v}`).join('; ') }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+    for (const value of res.headers.getSetCookie()) { const [key, val] = value.split(';')[0].split('='); jar.set(key, val); }
+    return { status: res.status, data: await res.json() };
+  };
+}
+function authenticator() {
+  const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const credentialID = randomBytes(32); let userHandle; let counter = 0;
+  const rpHash = sha('localhost');
+  return {
+    id: b64(credentialID),
+    registration(options, customOrigin = origin) {
+      userHandle = options.user.id;
+      const publicCose = isoCBOR.encode(new Map([[1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x, 'base64url')], [-3, Buffer.from(jwk.y, 'base64url')]]));
+      const size = Buffer.alloc(2); size.writeUInt16BE(credentialID.length);
+      const authData = Buffer.concat([rpHash, Buffer.from([0x45]), Buffer.alloc(4), Buffer.alloc(16), size, credentialID, publicCose]);
+      const attestationObject = isoCBOR.encode(new Map([['fmt', 'none'], ['attStmt', new Map()], ['authData', authData]]));
+      return { id: b64(credentialID), rawId: b64(credentialID), type: 'public-key', response: { clientDataJSON: b64(JSON.stringify({ type: 'webauthn.create', challenge: options.challenge, origin: customOrigin })), attestationObject: b64(attestationObject), transports: ['internal'] }, clientExtensionResults: {} };
+    },
+    authentication(options, customOrigin = origin, flags = 5) {
+      const count = Buffer.alloc(4); count.writeUInt32BE(++counter);
+      const authenticatorData = Buffer.concat([rpHash, Buffer.from([flags]), count]);
+      const clientData = Buffer.from(JSON.stringify({ type: 'webauthn.get', challenge: options.challenge, origin: customOrigin }));
+      return { id: b64(credentialID), rawId: b64(credentialID), type: 'public-key', response: { clientDataJSON: b64(clientData), authenticatorData: b64(authenticatorData), signature: b64(sign('sha256', Buffer.concat([authenticatorData, sha(clientData)]), privateKey)), userHandle }, clientExtensionResults: {} };
+    },
+  };
+}
+
+test('verified passkey lifecycle and security boundaries', async t => {
+  t.after(() => { server.kill(); rmSync(directory, { recursive: true, force: true }); });
+  let ready = false;
+  for (let i = 0; i < 60; i++) { try { await fetch(`${origin}/devtools-times/api/auth/account`); ready = true; break; } catch { await sleep(100); } }
+  assert.ok(ready, logs);
+  const owner = client(); const stranger = client(); const key = authenticator();
+  assert.equal((await owner('register', { username: 'blocked', password: 'password1' }, 'https://evil.example')).status, 403);
+  assert.equal((await stranger('options', { purpose: 'add' })).status, 400);
+  let options = (await owner('options', { purpose: 'register', username: 'reader' })).data;
+  const registration = key.registration(options);
+  assert.equal((await owner('verify', { credential: registration, name: 'Personal laptop' })).status, 200);
+  assert.equal((await owner('verify', { credential: registration })).status, 400, 'challenge cannot be replayed');
+  let account = (await owner('account')).data;
+  assert.equal(account.user.username, 'reader'); assert.equal(account.passkeys.length, 1);
+  assert.equal((await owner('remove', { id: key.id })).status, 400, 'cannot remove only sign-in method');
+  assert.equal((await owner('rename', { id: key.id, name: 'My laptop' })).status, 200);
+  assert.equal((await owner('account')).data.passkeys[0].name, 'My laptop');
+  await owner('logout', {});
+  assert.equal((await owner('account')).data.user, null);
+  options = (await owner('options', { purpose: 'login' })).data;
+  assert.equal((await owner('verify', { credential: key.authentication(options, 'https://evil.example') })).status, 400, 'reject wrong authenticator origin');
+  options = (await owner('options', { purpose: 'login' })).data;
+  assert.equal((await owner('verify', { credential: key.authentication(options) })).status, 200);
+  options = (await owner('options', { purpose: 'reauth' })).data;
+  assert.equal((await owner('verify', { credential: key.authentication(options, origin, 1) })).status, 400, 'require biometric or PIN verification');
+  options = (await owner('options', { purpose: 'reauth' })).data;
+  const forged = key.authentication(options); forged.response.signature = b64(randomBytes(64));
+  assert.equal((await owner('verify', { credential: forged })).status, 400, 'reject invalid signature');
+  const db = new DatabaseSync(`${directory}/auth.sqlite`);
+  db.prepare('UPDATE sessions SET verified_at = 0').run();
+  assert.equal((await owner('rename', { id: key.id, name: 'Blocked' })).status, 400, 'management requires recent verification');
+  options = (await owner('options', { purpose: 'reauth' })).data;
+  assert.equal((await owner('verify', { credential: key.authentication(options) })).status, 200);
+  const second = authenticator(); options = (await owner('options', { purpose: 'add' })).data;
+  assert.equal((await owner('verify', { credential: second.registration(options), name: 'Backup key' })).status, 200);
+  assert.equal((await owner('remove', { id: key.id })).status, 200);
+  assert.equal((await owner('account')).data.passkeys.length, 1);
+  assert.equal((await stranger('register', { username: 'passwordreader', password: 'password1' })).status, 200);
+  assert.equal((await stranger('rename', { id: second.id, name: 'Stolen' })).status, 400, 'enforce credential ownership');
+  db.prepare('UPDATE sessions SET verified_at = 0').run();
+  assert.equal((await stranger('reauth-password', { password: 'wrong' })).status, 400);
+  assert.equal((await stranger('reauth-password', { password: 'password1' })).status, 200);
+  await stranger('logout', {});
+  assert.equal((await stranger('login', { username: 'passwordreader', password: 'password1' })).status, 200);
+  options = (await stranger('options', { purpose: 'register', username: 'expired' })).data;
+  db.prepare('UPDATE challenges SET expires = 0').run();
+  assert.equal((await stranger('verify', { credential: authenticator().registration(options) })).status, 400);
+  db.close();
+});
