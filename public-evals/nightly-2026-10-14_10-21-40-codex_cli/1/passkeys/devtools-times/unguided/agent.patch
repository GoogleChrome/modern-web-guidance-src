+}
diff --git a/src/components/AuthForm.tsx b/src/components/AuthForm.tsx
new file mode 100644
index 0000000..8557a0b
--- /dev/null
+++ b/src/components/AuthForm.tsx
@@ -0,0 +1,34 @@
+import { useState } from 'react';
+import { FingerPrintIcon, ArrowRightIcon, LockClosedIcon } from '@heroicons/react/24/outline';
+import { api, base, passkey } from '../lib/auth-client';
+export default function AuthForm({ signup = false }: { signup?: boolean }) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const [passwordMode, setPasswordMode] = useState(false);
+  async function submit(usePasskey: boolean) {
+    setBusy(true); setError('');
+    try {
+      if (usePasskey) await passkey(signup ? 'register' : 'login', username, 'My first passkey');
+      else await api(signup ? 'register' : 'login', { username, password });
+      window.location.assign(`${base}account`);
+    } catch (e) { setError(e instanceof Error ? e.message : 'Please try again.'); }
+    finally { setBusy(false); }
+  }
+  return <div className="auth-shell">
+    <div className="auth-intro"><span className="eyebrow">YOUR TIMES. YOUR WAY.</span><h1>{signup ? 'A better way to stay informed.' : 'Welcome back to your Times.'}</h1><p>Independent stories, fresh perspectives, and the news that matters. All in one place.</p><div className="auth-note"><FingerPrintIcon /><div><strong>A little simpler. A lot more secure.</strong><p>Use a passkey to sign in with your fingerprint, face, or device PIN.</p></div></div></div>
+    <div className="auth-card"><div className="icon-tile"><FingerPrintIcon /></div><h2>{signup ? 'Create your account' : 'Sign in'}</h2><p className="muted">{signup ? 'Your next great read starts here.' : 'Pick up where you left off.'}</p>
+      <form onSubmit={e => { e.preventDefault(); submit(!passwordMode); }}>
+        {(signup || passwordMode) && <label className="field-label">Username<input autoComplete="username webauthn" value={username} onChange={e => setUsername(e.target.value)} required minLength={3} maxLength={80} placeholder="Choose your username" /></label>}
+        {passwordMode && <label className="field-label">Password<input type="password" autoComplete={signup ? 'new-password' : 'current-password'} value={password} onChange={e => setPassword(e.target.value)} required minLength={signup ? 8 : undefined} maxLength={128} placeholder="Enter your password" />{signup && <small>At least 8 characters, including a number.</small>}</label>}
+        {error && <p className="notice error" role="alert">{error}</p>}
+        <button className="primary-button" disabled={busy}>{passwordMode ? <LockClosedIcon /> : <FingerPrintIcon />}{busy ? 'Please wait…' : passwordMode ? signup ? 'Create account' : 'Sign in' : signup ? 'Create account with a passkey' : 'Sign in with a passkey'}{!busy && <ArrowRightIcon />}</button>
+      </form>
+      <p className="passkey-caption">{passwordMode ? 'Your password is securely protected.' : 'No password to remember. No password to forget.'}</p>
+      <div className="divider"><span>or</span></div><button className="secondary-button" disabled={busy} onClick={() => { setPasswordMode(!passwordMode); setError(''); }}>{passwordMode ? 'Use a passkey instead' : signup ? 'Create account with a password' : 'Sign in with a password'}</button>
+      <p className="auth-switch">{signup ? 'Already have an account?' : 'New to The DevTools Times?'} <a href={`${base}${signup ? 'signin' : 'signup'}`}>{signup ? 'Sign in' : 'Create an account'} <span aria-hidden="true">↗</span></a></p>
+      <div className="secure-caption"><LockClosedIcon /> Secure, private, and always yours.</div>
+    </div>
+  </div>;
+}
