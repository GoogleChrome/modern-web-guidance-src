@@ -0,0 +1,19 @@
+import { startRegistration, startAuthentication, browserSupportsWebAuthn } from '@simplewebauthn/browser';
+export const base = import.meta.env.BASE_URL;
+export async function api(action: string, body?: unknown) {
+  const response = await fetch(`${base}api/auth/${action}`, { method: body === undefined ? 'GET' : 'POST', headers: body === undefined ? {} : { 'Content-Type': 'application/json' }, ...(body === undefined ? {} : { body: JSON.stringify(body) }) });
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
+  return data;
+}
+export async function passkey(purpose: 'register' | 'add' | 'login' | 'reauth', username?: string, name?: string) {
+  if (!browserSupportsWebAuthn() || !window.isSecureContext) throw new Error('Passkeys require a supported browser and a secure connection.');
+  try {
+    const optionsJSON = await api('options', { purpose, username });
+    const credential = purpose === 'register' || purpose === 'add' ? await startRegistration({ optionsJSON }) : await startAuthentication({ optionsJSON });
+    await api('verify', { credential, name });
+  } catch (error) {
+    if (error instanceof Error && (error.name === 'NotAllowedError' || error.message.includes('timed out'))) throw new Error('The passkey request was canceled or timed out. You can try again.');
+    throw error;
+  }
+}
diff --git a/src/lib/auth-store.ts b/src/lib/auth-store.ts
new file mode 100644
index 0000000..29072f4
--- /dev/null
+++ b/src/lib/auth-store.ts
@@ -0,0 +1,24 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { randomBytes, createHash, scryptSync, timingSafeEqual } from 'node:crypto';
+const path = process.env.AUTH_DB_PATH || '.data/auth.sqlite';
+mkdirSync(dirname(path), { recursive: true });
+export const db = new DatabaseSync(path);
+db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON;
+CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT NOT NULL UNIQUE COLLATE NOCASE, password TEXT);
+CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, public_key TEXT NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, created_at INTEGER NOT NULL, last_used INTEGER);
+CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), expires INTEGER NOT NULL, verified_at INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, challenge TEXT NOT NULL, purpose TEXT NOT NULL, user_id TEXT, username TEXT, expires INTEGER NOT NULL);
+CREATE TABLE IF NOT EXISTS limits (key TEXT PRIMARY KEY, count INTEGER NOT NULL, expires INTEGER NOT NULL);`);
+export type User = { id: string; username: string; password: string | null };
+export type Key = { id: string; user_id: string; name: string; public_key: string; counter: number; transports: string; created_at: number; last_used: number | null };
+export const token = () => randomBytes(32).toString('base64url');
+export const hash = (value: string) => createHash('sha256').update(value).digest('hex');
+export function passwordHash(password: string) { const salt = token(); return `${salt}:${scryptSync(password, salt, 64).toString('hex')}`; }
+export function passwordMatches(password: string, stored: string) { const [salt, digest] = stored.split(':'); return timingSafeEqual(scryptSync(password, salt, 64), Buffer.from(digest, 'hex')); }
+export const userByName = (name: string) => db.prepare('SELECT * FROM users WHERE username = ?').get(name) as User | undefined;
+export const keysFor = (id: string) => db.prepare('SELECT * FROM passkeys WHERE user_id = ? ORDER BY created_at DESC').all(id) as Key[];
+export function takeChallenge(id: string) {
+  return db.prepare('DELETE FROM challenges WHERE id = ? RETURNING *').get(hash(id)) as { challenge: string; purpose: string; user_id: string | null; username: string | null; expires: number } | undefined;
+}
