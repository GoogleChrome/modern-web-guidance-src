diff --git a/src/lib/passkeys.ts b/src/lib/passkeys.ts
new file mode 100644
index 0000000..ea7d50b
--- /dev/null
+++ b/src/lib/passkeys.ts
@@ -0,0 +1,71 @@
+import 'webauthn-polyfills';
+
+export interface Account {
+  user: { id: string; username: string; displayName: string };
+  rpId: string; verifiedUntil: number;
+  passkeys: { id: string; name: string; aaguid: string; deviceType: string; backedUp: boolean; registeredAt: number; lastUsedAt?: number }[];
+}
+export const appUrl = (path: string) => `${import.meta.env.BASE_URL}${path}`;
+export class RequestError extends Error {
+  constructor(message: string, public status: number) { super(message); }
+}
+export async function authRequest<T = Account>(action: string, body?: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch(appUrl(`api/auth/${action}`), {
+    method: body === undefined ? 'GET' : 'POST', credentials: 'same-origin', signal,
+    headers: body === undefined ? {} : { 'Content-Type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  const data = await response.json();
+  if (!response.ok) throw new RequestError(data.error || 'Please try again.', response.status);
+  return data;
+}
+export const supportsPasskeys = () => window.isSecureContext && 'PublicKeyCredential' in window && !!navigator.credentials;
+export const errorMessage = (error: unknown) => {
+  if (error instanceof DOMException) {
+    if (error.name === 'NotAllowedError') return 'The passkey request was cancelled or timed out. You can try again.';
+    if (error.name === 'InvalidStateError') return 'A passkey already exists in this password manager. Try another device or security key.';
+    if (error.name === 'SecurityError') return 'Passkeys need a secure connection and the correct site address.';
+    if (error.name === 'AbortError') return 'The passkey request was cancelled.';
+  }
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+};
+async function signalUnknown(rpId: string, credentialId: string) {
+  if (!PublicKeyCredential.signalUnknownCredential) return;
+  try { await PublicKeyCredential.signalUnknownCredential({ rpId, credentialId }); } catch { /* Optional vault sync. */ }
+}
+export async function registerPasskey(name: string) {
+  const { options, challengeId } = await authRequest<{ options: PublicKeyCredentialCreationOptionsJSON; challengeId: string }>('passkeys/options', {});
+  const credential = await navigator.credentials.create({ publicKey: PublicKeyCredential.parseCreationOptionsFromJSON(options) }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was created.');
+  try { return await authRequest('passkeys/verify', { challengeId, credential: credential.toJSON(), name }); }
+  catch (error) {
+    // Do not discard a credential on network uncertainty: verification might have succeeded.
+    if (error instanceof RequestError && error.status !== 409) await signalUnknown(options.rp.id!, credential.id);
+    throw error;
+  }
+}
+export async function authenticatePasskey(reauth = false, signal?: AbortSignal, conditional = false) {
+  const flow = reauth ? 'reauth' : 'login';
+  const { options, challengeId } = await authRequest<{ options: PublicKeyCredentialRequestOptionsJSON; challengeId: string }>(`passkeys/${flow}/options`, {}, signal);
+  const credential = await navigator.credentials.get({
+    publicKey: PublicKeyCredential.parseRequestOptionsFromJSON(options), signal,
+    ...(conditional ? { mediation: 'conditional' as const } : {}),
+  }) as PublicKeyCredential | null;
+  if (!credential) throw new Error('No passkey was selected.');
+  try { return await authRequest(`passkeys/${flow}/verify`, { challengeId, credential: credential.toJSON() }, signal); }
+  catch (error) {
+    if (!reauth && error instanceof RequestError && error.status === 404) await signalUnknown(options.rpId!, credential.id);
+    throw error;
+  }
+}
+export async function syncPasskeys(account: Account, profile = false) {
+  if (!supportsPasskeys()) return;
+  try {
+    if (profile && PublicKeyCredential.signalCurrentUserDetails) {
+      await PublicKeyCredential.signalCurrentUserDetails({ rpId: account.rpId, userId: account.user.id, name: account.user.username, displayName: account.user.displayName });
+    }
+    if (PublicKeyCredential.signalAllAcceptedCredentials) {
+      await PublicKeyCredential.signalAllAcceptedCredentials({ rpId: account.rpId, userId: account.user.id, allAcceptedCredentialIds: account.passkeys.map(key => key.id) });
+    }
+  } catch { /* Unsupported vault synchronization must not block account management. */ }
+}
diff --git a/src/lib/server/auth-api.ts b/src/lib/server/auth-api.ts
new file mode 100644
index 0000000..fd48f07
--- /dev/null
+++ b/src/lib/server/auth-api.ts
@@ -0,0 +1,170 @@
+import type { APIContext } from 'astro';
+import type { AuthenticatorTransport } from '@simplewebauthn/server';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+import { getAuthStore, hashToken, type AuthStore, type Session } from './auth-store';
+
+export class AuthError extends Error {
+  constructor(message: string, public status = 400) { super(message); }
+}
+const cookieName = 'times_auth';
+const passwordService = 'https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api';
+export function authConfig(url: URL, production = false) {
+  const origin = new URL(process.env.AUTH_ORIGIN || (production ? 'https://astro-news-pytrpecapa-uc.a.run.app' : url.origin));
+  if (origin.protocol !== 'https:' && !['localhost', '127.0.0.1', '[::1]'].includes(origin.hostname)) {
+    throw new AuthError('Passkeys require HTTPS or localhost.', 503);
+  }
+  return { origin: origin.origin, rpID: process.env.AUTH_RP_ID || origin.hostname };
+}
+export function currentSession(context: Pick<APIContext, 'cookies'>, store = getAuthStore()) {
+  const token = context.cookies.get(cookieName)?.value;
+  return token ? store.session(hashToken(token)) : undefined;
+}
+const text = (value: unknown, max: number, label: string) => {
+  if (typeof value !== 'string' || !value.trim() || value.length > max) throw new AuthError(`Enter a valid ${label}.`);
+  return value.trim();
+};
+function recent(session: Session) {
+  if (!session.verifiedAt || Date.now() - session.verifiedAt > 300000) throw new AuthError('Confirm your identity before making this change.', 403);
+}
+export async function handleAuth(context: APIContext, production = false, store: AuthStore = getAuthStore(), upstream = fetch) {
+  const { request, url, cookies, params } = context;
+  const config = authConfig(url, production);
+  const action = params.action || '';
+  const method = request.method;
+  if (method !== 'GET' && (request.headers.get('origin') !== config.origin || !request.headers.get('content-type')?.startsWith('application/json'))) {
+    throw new AuthError('This request must come from this application.', 403);
+  }
+  if (Number(request.headers.get('content-length') || 0) > 65536) throw new AuthError('Request is too large.', 413);
+  let session = currentSession(context, store);
+  function startSession(userId: string | null) {
+    if (session) store.deleteSession(session.id);
+    const created = store.createSession(userId);
+    cookies.set(cookieName, created.token, { httpOnly: true, secure: config.origin.startsWith('https:'), sameSite: 'lax', path: import.meta.env?.BASE_URL || '/', maxAge: 86400 });
+    session = created.session;
+    return session;
+  }
+  function signedIn() {
+    session = session ? store.session(session.id) : undefined;
+    if (!session?.userId) throw new AuthError('Sign in to manage your account.', 401);
+    const user = store.user(session.userId);
+    if (!user) throw new AuthError('Sign in again.', 401);
+    return { user, session };
+  }
+  function account() {
+    const { user, session: active } = signedIn();
+    return { user, rpId: config.rpID, verifiedUntil: active.verifiedAt + 300000,
+      passkeys: store.passkeys(user.id).map(({ publicKey, counter, userId, ...key }) => key) };
+  }
+  async function passwordLogin(username: string, password: string) {
+    let response: Response;
+    try {
+      response = await upstream(`${passwordService}/login`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password }), signal: AbortSignal.timeout(15000) });
+    } catch { throw new AuthError('Password sign-in is unavailable. Try again or use a passkey.', 503); }
+    if (!response.ok) throw new AuthError('Username or password is incorrect.', 401);
+  }
+  if (action === 'account' && method === 'GET') return account();
+  if (method !== 'POST') throw new AuthError('Endpoint not found.', 404);
+  if (!store.rateLimit(`ip:${context.clientAddress}`, 120)) throw new AuthError('Too many attempts. Wait a minute and try again.', 429);
+  if (!session) session = startSession(null);
+  if (!store.rateLimit(`session:${session.id}`, 60)) throw new AuthError('Too many attempts. Wait a minute and try again.', 429);
+  const raw = await request.text();
+  if (raw.length > 65536) throw new AuthError('Request is too large.', 413);
+  let body: Record<string, any>;
+  try { body = JSON.parse(raw); } catch { throw new AuthError('Invalid request.'); }
+  if (!body || typeof body !== 'object' || Array.isArray(body)) throw new AuthError('Invalid request.');
+  if (action === 'logout') {
+    store.deleteSession(session.id);
+    cookies.delete(cookieName, { path: import.meta.env?.BASE_URL || '/' });
+    return { success: true };
+  }
+  if (action === 'login' || action === 'signup' || action === 'password/reauth') {
+    const username = action === 'password/reauth' ? signedIn().user.username : text(body.username, 128, 'username');
+    if (typeof body.password !== 'string' || !body.password || body.password.length > 1024) throw new AuthError('Enter your password.');
+    if (!store.rateLimit(`password:${username}`, 10)) throw new AuthError('Too many attempts. Wait a minute and try again.', 429);
+    if (action === 'signup') {
+      if (body.password.length < 8 || !/\d/.test(body.password)) throw new AuthError('Use at least 8 characters and a number.');
+      let response: Response;
+      try { response = await upstream(`${passwordService}/register`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password: body.password }), signal: AbortSignal.timeout(15000) }); }
+      catch { throw new AuthError('Registration is unavailable. Please try again.', 503); }
+      if (!response.ok) throw new AuthError('Registration failed. Try another username or sign in to your existing account.');
+    }
+    await passwordLogin(username, body.password);
+    if (action === 'password/reauth') store.verifySession(session.id);
+    else startSession(store.ensureUser(username).id);
+    return account();
+  }
+  if (action === 'passkeys/options') {
+    const { user, session: active } = signedIn();
+    recent(active);
+    const options = await generateRegistrationOptions({ rpName: 'The DevTools Times', rpID: config.rpID,
+      userID: new Uint8Array(Buffer.from(user.id, 'base64url')), userName: user.username, userDisplayName: user.displayName,
+      attestationType: 'none', supportedAlgorithmIDs: [-7, -257],
+      excludeCredentials: store.passkeys(user.id).map(key => ({ id: key.id, transports: key.transports })),
+      authenticatorSelection: { residentKey: 'required', requireResidentKey: true, userVerification: 'required' } });
+    return { options, challengeId: store.addChallenge(active, 'register', options.challenge) };
+  }
+  if (action === 'passkeys/verify') {
+    const { user, session: active } = signedIn();
+    recent(active);
+    const pending = store.takeChallenge(text(body.challengeId, 128, 'challenge'), active.id, 'register');
+    if (!pending || pending.userId !== user.id) throw new AuthError('This request expired. Try again.');
+    const result = await verifyRegistrationResponse({ response: body.credential, expectedChallenge: pending.challenge,
+      expectedOrigin: config.origin, expectedRPID: config.rpID, requireUserVerification: true, supportedAlgorithmIDs: [-7, -257] });
+    if (!result.verified) throw new AuthError('Could not verify the new passkey.');
+    const info = result.registrationInfo;
+    if (store.passkey(info.credential.id)) throw new AuthError('This passkey is already registered.', 409);
+    store.addPasskey({ id: info.credential.id, publicKey: Buffer.from(info.credential.publicKey).toString('base64url'),
+      counter: info.credential.counter, transports: (info.credential.transports || []).filter((transport): transport is AuthenticatorTransport => ['ble', 'cable', 'hybrid', 'internal', 'nfc', 'smart-card', 'usb'].includes(transport)), userId: user.id,
+      aaguid: info.aaguid, deviceType: info.credentialDeviceType, backedUp: info.credentialBackedUp,
+      name: body.name ? text(body.name, 64, 'passkey name') : 'My passkey', registeredAt: Date.now() });
+    return account();
+  }
+  if (action === 'passkeys/login/options' || action === 'passkeys/reauth/options') {
+    const reauth = action.includes('/reauth/');
+    if (!reauth && session.userId) throw new AuthError('You are already signed in.');
+    const keys = reauth ? store.passkeys(signedIn().user.id) : [];
+    if (reauth && !keys.length) throw new AuthError('No passkeys available. Confirm with your password instead.');
+    const options = await generateAuthenticationOptions({ rpID: config.rpID, userVerification: 'required',
+      allowCredentials: keys.map(key => ({ id: key.id, transports: key.transports })) });
+    return { options, challengeId: store.addChallenge(session, reauth ? 'reauth' : 'login', options.challenge) };
+  }
+  if (action === 'passkeys/login/verify' || action === 'passkeys/reauth/verify') {
+    const reauth = action.includes('/reauth/');
+    if (reauth) signedIn();
+    else if (session.userId) throw new AuthError('You are already signed in.');
+    const pending = store.takeChallenge(text(body.challengeId, 128, 'challenge'), session.id, reauth ? 'reauth' : 'login');
+    if (!pending || pending.userId !== session.userId) throw new AuthError('This request expired. Try again.');
+    const key = store.passkey(text(body.credential?.id, 2048, 'credential'));
+    if (!key) throw new AuthError('This passkey is no longer registered.', 404);
+    if (reauth && key.userId !== session.userId) throw new AuthError('Use a passkey belonging to this account.', 403);
+    if (body.credential.response?.userHandle && body.credential.response.userHandle !== key.userId) throw new AuthError('This passkey belongs to a different account.', 403);
+    if (!reauth && !body.credential.response?.userHandle) throw new AuthError('Use a discoverable passkey for sign-in.');
+    const result = await verifyAuthenticationResponse({ response: body.credential, expectedChallenge: pending.challenge,
+      expectedOrigin: config.origin, expectedRPID: config.rpID, requireUserVerification: true,
+      credential: { id: key.id, publicKey: new Uint8Array(Buffer.from(key.publicKey, 'base64url')), counter: key.counter, transports: key.transports } });
+    if (!result.verified) throw new AuthError('Could not verify your passkey.');
+    const info = result.authenticationInfo;
+    if (!store.updatePasskey({ ...key, counter: info.newCounter, backedUp: info.credentialBackedUp, deviceType: info.credentialDeviceType, lastUsedAt: Date.now() }, key.counter)) {
+      throw new AuthError('The passkey changed during verification. Try again.');
+    }
+    if (reauth) store.verifySession(session.id);
+    else startSession(key.userId);
+    return account();
+  }
+  if (action === 'passkeys/rename' || action === 'passkeys/delete') {
+    const { user, session: active } = signedIn();
+    recent(active);
+    const key = store.passkey(text(body.id, 2048, 'credential'));
+    if (!key || key.userId !== user.id) throw new AuthError('Passkey not found.', 404);
+    if (action.endsWith('/rename')) store.updatePasskey({ ...key, name: text(body.name, 64, 'passkey name') });
+    else store.deletePasskey(key.id, user.id);
+    return account();
+  }
+  if (action === 'account/profile') {
+    const { user, session: active } = signedIn();
+    recent(active);
+    store.displayName(user.id, text(body.displayName, 128, 'display name'));
+    return account();
+  }
+  throw new AuthError('Endpoint not found.', 404);
+}
diff --git a/src/lib/server/auth-store.ts b/src/lib/server/auth-store.ts
new file mode 100644
index 0000000..7ab8e40
--- /dev/null
+++ b/src/lib/server/auth-store.ts
@@ -0,0 +1,90 @@
+import { DatabaseSync } from 'node:sqlite';
+import { mkdirSync } from 'node:fs';
+import { dirname } from 'node:path';
+import { createHash, randomBytes } from 'node:crypto';
+import type { AuthenticatorTransport, CredentialDeviceType } from '@simplewebauthn/server';
+
+export interface User { id: string; username: string; displayName: string }
+export interface Passkey {
+  id: string; userId: string; publicKey: string; counter: number;
+  transports: AuthenticatorTransport[]; deviceType: CredentialDeviceType;
+  backedUp: boolean; aaguid: string; name: string; registeredAt: number; lastUsedAt?: number;
+}
+export interface Session { id: string; userId: string | null; expiresAt: number; verifiedAt: number }
+export interface Challenge {
+  id: string; sessionId: string; purpose: 'register' | 'login' | 'reauth';
+  challenge: string; userId: string | null; expiresAt: number;
+}
+export const randomToken = () => randomBytes(32).toString('base64url');
+export const hashToken = (token: string) => createHash('sha256').update(token).digest('hex');
+
+export class AuthStore {
+  db: DatabaseSync;
+  constructor(path: string) {
+    if (path !== ':memory:') mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
+    this.db = new DatabaseSync(path);
+    this.db.exec(`PRAGMA journal_mode=WAL; PRAGMA foreign_keys=ON; PRAGMA busy_timeout=5000;
+      CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, username TEXT UNIQUE NOT NULL, displayName TEXT NOT NULL);
+      CREATE TABLE IF NOT EXISTS passkeys (id TEXT PRIMARY KEY, userId TEXT NOT NULL REFERENCES users(id), record TEXT NOT NULL);
+      CREATE INDEX IF NOT EXISTS passkeys_user ON passkeys(userId);
+      CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, userId TEXT REFERENCES users(id), expiresAt INTEGER NOT NULL, verifiedAt INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS challenges (id TEXT PRIMARY KEY, sessionId TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,
+        purpose TEXT NOT NULL, challenge TEXT NOT NULL, userId TEXT, expiresAt INTEGER NOT NULL);
+      CREATE TABLE IF NOT EXISTS rate_limits (key TEXT PRIMARY KEY, count INTEGER NOT NULL, expiresAt INTEGER NOT NULL);`);
+  }
+  user(id: string) { return this.db.prepare('SELECT * FROM users WHERE id=?').get(id) as unknown as User | undefined; }
+  ensureUser(username: string) {
+    this.db.prepare('INSERT OR IGNORE INTO users VALUES (?, ?, ?)').run(randomToken(), username, username);
+    return this.db.prepare('SELECT * FROM users WHERE username=?').get(username) as unknown as User;
+  }
+  displayName(id: string, name: string) { this.db.prepare('UPDATE users SET displayName=? WHERE id=?').run(name, id); }
+  passkeys(userId: string): Passkey[] {
+    return this.db.prepare('SELECT record FROM passkeys WHERE userId=?').all(userId).map(row => JSON.parse(row.record as string));
+  }
+  passkey(id: string): Passkey | undefined {
+    const row = this.db.prepare('SELECT record FROM passkeys WHERE id=?').get(id);
+    return row ? JSON.parse(row.record as string) : undefined;
+  }
+  addPasskey(key: Passkey) { this.db.prepare('INSERT INTO passkeys VALUES (?, ?, ?)').run(key.id, key.userId, JSON.stringify(key)); }
+  updatePasskey(key: Passkey, previousCounter?: number) {
+    // Compare the counter atomically so concurrent verification cannot overwrite newer state.
+    const result = this.db.prepare(`UPDATE passkeys SET record=? WHERE id=? AND userId=?
+      AND (? IS NULL OR json_extract(record, '$.counter')=?)`).run(JSON.stringify(key), key.id, key.userId, previousCounter ?? null, previousCounter ?? null);
+    return result.changes === 1;
+  }
+  deletePasskey(id: string, userId: string) { return this.db.prepare('DELETE FROM passkeys WHERE id=? AND userId=?').run(id, userId).changes === 1; }
+  session(id: string) { return this.db.prepare('SELECT * FROM sessions WHERE id=? AND expiresAt>?').get(id, Date.now()) as unknown as Session | undefined; }
+  createSession(userId: string | null) {
+    const token = randomToken();
+    const session: Session = { id: hashToken(token), userId, expiresAt: Date.now() + 86400000, verifiedAt: userId ? Date.now() : 0 };
+    this.db.prepare('INSERT INTO sessions VALUES (?, ?, ?, ?)').run(session.id, userId, session.expiresAt, session.verifiedAt);
+    this.cleanup();
+    return { token, session };
+  }
+  deleteSession(id: string) { this.db.prepare('DELETE FROM sessions WHERE id=?').run(id); }
+  verifySession(id: string) { this.db.prepare('UPDATE sessions SET verifiedAt=? WHERE id=?').run(Date.now(), id); }
+  addChallenge(session: Session, purpose: Challenge['purpose'], challenge: string) {
+    const record: Challenge = { id: randomToken(), sessionId: session.id, purpose, challenge, userId: session.userId, expiresAt: Date.now() + 300000 };
+    this.db.prepare('INSERT INTO challenges VALUES (?, ?, ?, ?, ?, ?)').run(record.id, record.sessionId, purpose, challenge, record.userId, record.expiresAt);
+    return record.id;
+  }
+  takeChallenge(id: string, sessionId: string, purpose: Challenge['purpose']) {
+    // DELETE ... RETURNING consumes the challenge exactly once, including on failed verification.
+    return this.db.prepare('DELETE FROM challenges WHERE id=? AND sessionId=? AND purpose=? AND expiresAt>? RETURNING *')
+      .get(id, sessionId, purpose, Date.now()) as unknown as Challenge | undefined;
+  }
+  rateLimit(key: string, limit = 30) {
+    const now = Date.now();
+    const row = this.db.prepare(`INSERT INTO rate_limits VALUES (?, 1, ?) ON CONFLICT(key) DO UPDATE SET
+      count=CASE WHEN expiresAt<=? THEN 1 ELSE count+1 END,
+      expiresAt=CASE WHEN expiresAt<=? THEN excluded.expiresAt ELSE expiresAt END RETURNING count`).get(key, now + 60000, now, now);
+    return Number(row?.count) <= limit;
+  }
+  cleanup() {
+    this.db.prepare('DELETE FROM sessions WHERE expiresAt<=?').run(Date.now());
+    this.db.prepare('DELETE FROM challenges WHERE expiresAt<=?').run(Date.now());
+    this.db.prepare('DELETE FROM rate_limits WHERE expiresAt<=?').run(Date.now());
+  }
+}
+let singleton: AuthStore | undefined;
+export const getAuthStore = () => singleton ??= new AuthStore(process.env.AUTH_DB_PATH || './.data/auth.sqlite');
