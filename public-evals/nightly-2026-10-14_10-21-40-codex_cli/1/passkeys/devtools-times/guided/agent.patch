+import type { APIRoute } from 'astro';
+import { AuthError, handleAuth } from '../../../lib/server/auth-api';
+const handler: APIRoute = async context => {
+  try {
+    return Response.json(await handleAuth(context, import.meta.env.PROD), { headers: { 'Cache-Control': 'no-store' } });
+  } catch (error) {
+    return Response.json({ error: error instanceof AuthError ? error.message : 'Passkey verification failed. Please try again.' }, {
+      status: error instanceof AuthError ? error.status : 400, headers: { 'Cache-Control': 'no-store' },
+    });
+  }
+};
+export const GET = handler;
+export const POST = handler;
diff --git a/tests/auth.test.ts b/tests/auth.test.ts
new file mode 100644
index 0000000..bf316b0
--- /dev/null
+++ b/tests/auth.test.ts
@@ -0,0 +1,208 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash, generateKeyPairSync, randomBytes, sign } from 'node:crypto';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import type { APIContext } from 'astro';
+import { isoCBOR } from '@simplewebauthn/server/helpers';
+import { AuthStore, hashToken } from '../src/lib/server/auth-store';
+import { AuthError, handleAuth } from '../src/lib/server/auth-api';
+
+const origin = 'http://localhost:11224';
+const sha = (value: string | Buffer) => createHash('sha256').update(value).digest();
+const b64 = (value: Uint8Array) => Buffer.from(value).toString('base64url');
+function harness(store = new AuthStore(':memory:')) {
+  const cookies = new Map<string, string>();
+  const calls: string[] = [];
+  const upstream = (async (url: string, init: RequestInit) => {
+    calls.push(url);
+    const body = JSON.parse(init.body as string);
+    return Response.json({}, { status: body.password === 'valid1234' ? 200 : 401 });
+  }) as typeof fetch;
+  const call = async (action: string, body?: unknown, requestOrigin = origin) => {
+    const request = new Request(`${origin}/api/auth/${action}`, {
+      method: body === undefined ? 'GET' : 'POST',
+      headers: { origin: requestOrigin, 'content-type': 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body),
+    });
+    return handleAuth({ request, url: new URL(request.url), params: { action }, clientAddress: '127.0.0.1',
+      cookies: { get: (name: string) => cookies.has(name) ? { value: cookies.get(name) } : undefined,
+        set: (name: string, value: string) => cookies.set(name, value), delete: (name: string) => cookies.delete(name) },
+    } as unknown as APIContext, false, store, upstream) as Promise<any>;
+  };
+  const session = () => store.session(hashToken(cookies.get('times_auth')!))!;
+  return { call, store, cookies, session, calls };
+}
+// Software authenticator signs real WebAuthn data; no browser or mocked verification.
+function authenticator() {
+  const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const id = randomBytes(32);
+  const cose = isoCBOR.encode(new Map<number, number | Uint8Array>([
+    [1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x!, 'base64url')], [-3, Buffer.from(jwk.y!, 'base64url')],
+  ]));
+  const counter = (n: number) => { const buffer = Buffer.alloc(4); buffer.writeUInt32BE(n); return buffer; };
+  const client = (challenge: string, type: string, from = origin) => Buffer.from(JSON.stringify({ type, challenge, origin: from, crossOrigin: false }));
+  return {
+    id: b64(id),
+    registration(challenge: string, from = origin, flags = 0x45) {
+      const length = Buffer.alloc(2); length.writeUInt16BE(id.length);
+      const authData = Buffer.concat([sha('localhost'), Buffer.from([flags]), counter(0), Buffer.alloc(16), length, id, cose]);
+      return { id: b64(id), rawId: b64(id), type: 'public-key', clientExtensionResults: {},
+        response: { clientDataJSON: b64(client(challenge, 'webauthn.create', from)), transports: ['internal'],
+          attestationObject: b64(isoCBOR.encode(new Map<string, any>([['fmt', 'none'], ['attStmt', new Map()], ['authData', authData]]))) } };
+    },
+    assertion(challenge: string, userHandle: string, n = 1, from = origin, flags = 0x05) {
+      const authData = Buffer.concat([sha('localhost'), Buffer.from([flags]), counter(n)]);
+      const clientData = client(challenge, 'webauthn.get', from);
+      const signature = sign('sha256', Buffer.concat([authData, sha(clientData)]), privateKey);
+      return { id: b64(id), rawId: b64(id), type: 'public-key', clientExtensionResults: {},
+        response: { clientDataJSON: b64(clientData), authenticatorData: b64(authData), signature: b64(signature), userHandle } };
+    },
+  };
+}
+async function enroll(h: ReturnType<typeof harness>, auth = authenticator()) {
+  const account = await h.call('login', { username: 'alice', password: 'valid1234' });
+  const pending = await h.call('passkeys/options', {});
+  assert.equal(pending.options.authenticatorSelection.residentKey, 'required');
+  assert.equal(pending.options.authenticatorSelection.authenticatorAttachment, undefined);
+  const enrolled = await h.call('passkeys/verify', { challengeId: pending.challengeId, name: 'Laptop', credential: auth.registration(pending.options.challenge) });
+  return { auth, account: enrolled, user: account.user, pending };
+}
+const status = (expected: number) => (err: unknown) => err instanceof AuthError && err.status === expected;
+
+test('registration, discoverable sign-in, scoped reauthentication, rename, profile, delete and logout', async () => {
+  const h = harness();
+  const { auth, user, pending } = await enroll(h);
+  assert.equal(h.store.passkeys(user.id)[0].name, 'Laptop');
+  assert.equal(h.store.passkeys(user.id)[0].aaguid, '00000000-0000-0000-0000-000000000000');
+  await assert.rejects(h.call('passkeys/verify', { challengeId: pending.challengeId, credential: auth.registration(pending.options.challenge) }), status(400));
+  const exclusion = await h.call('passkeys/options', {});
+  assert.equal(exclusion.options.excludeCredentials[0].id, auth.id);
+  const oldToken = h.cookies.get('times_auth');
+  await h.call('logout', {});
+  assert.equal(h.store.session(hashToken(oldToken!)), undefined);
+  await assert.rejects(h.call('account'), status(401));
+  const login = await h.call('passkeys/login/options', {});
+  assert.deepEqual(login.options.allowCredentials, []);
+  const anonymousToken = h.cookies.get('times_auth');
+  const account = await h.call('passkeys/login/verify', { challengeId: login.challengeId, credential: auth.assertion(login.options.challenge, user.id) });
+  assert.equal(account.user.id, user.id);
+  assert.notEqual(h.cookies.get('times_auth'), anonymousToken);
+  assert.equal(h.store.session(hashToken(anonymousToken!)), undefined);
+  assert.equal(h.store.passkey(auth.id)?.counter, 1);
+  assert.ok(account.passkeys[0].lastUsedAt);
+  assert.equal(account.passkeys[0].publicKey, undefined);
+  h.store.db.prepare('UPDATE sessions SET verifiedAt=0').run();
+  await assert.rejects(h.call('passkeys/delete', { id: auth.id }), status(403));
+  const reauth = await h.call('passkeys/reauth/options', {});
+  assert.equal(reauth.options.allowCredentials[0].id, auth.id);
+  const confirmed = await h.call('passkeys/reauth/verify', { challengeId: reauth.challengeId, credential: auth.assertion(reauth.options.challenge, user.id, 2) });
+  assert.ok(confirmed.verifiedUntil > Date.now(), 'reauthentication response enables account controls');
+  assert.equal((await h.call('passkeys/rename', { id: auth.id, name: 'Personal laptop' })).passkeys[0].name, 'Personal laptop');
+  assert.equal((await h.call('account/profile', { displayName: 'Alice Reader' })).user.displayName, 'Alice Reader');
+  assert.deepEqual((await h.call('passkeys/delete', { id: auth.id })).passkeys, []);
+  await assert.rejects(h.call('passkeys/reauth/options', {}), status(400));
+  h.store.db.close();
+});
+
+test('rejects wrong origins, modified signatures, missing user verification and expired challenges', async () => {
+  const h = harness();
+  const { auth, user } = await enroll(h);
+  await assert.rejects(h.call('passkeys/options', {}, 'https://attacker.example'), status(403));
+  for (const variant of ['origin', 'signature', 'verification', 'expiry', 'challenge', 'userHandle']) {
+    const pending = await h.call('passkeys/reauth/options', {});
+    const credential = auth.assertion(variant === 'challenge' ? 'wrong-challenge' : pending.options.challenge,
+      variant === 'userHandle' ? 'wrong-user' : user.id, 1, variant === 'origin' ? 'https://attacker.example' : origin, variant === 'verification' ? 0x01 : 0x05);
+    if (variant === 'signature') credential.response.signature = b64(randomBytes(70));
+    if (variant === 'expiry') h.store.db.prepare('UPDATE challenges SET expiresAt=0 WHERE id=?').run(pending.challengeId);
+    await assert.rejects(h.call('passkeys/reauth/verify', { challengeId: pending.challengeId, credential }));
+    assert.equal(h.store.passkey(auth.id)?.counter, 0);
+  }
+  h.store.db.close();
+});
+
+test('rejects registration without user verification and with foreign origin', async () => {
+  const h = harness();
+  await h.call('login', { username: 'alice', password: 'valid1234' });
+  const auth = authenticator();
+  for (const variant of ['origin', 'verification']) {
+    const pending = await h.call('passkeys/options', {});
+    await assert.rejects(h.call('passkeys/verify', { challengeId: pending.challengeId,
+      credential: auth.registration(pending.options.challenge, variant === 'origin' ? 'https://attacker.example' : origin, variant === 'verification' ? 0x41 : 0x45) }));
+  }
+  assert.equal(h.store.passkeys(h.session().userId!).length, 0);
+  h.store.db.close();
+});
+
+test('cannot manage or reauthenticate with another account’s credential', async () => {
+  const h = harness();
+  const { auth, user } = await enroll(h);
+  await h.call('login', { username: 'bob', password: 'valid1234' });
+  await assert.rejects(h.call('passkeys/rename', { id: auth.id, name: 'Stolen' }), status(404));
+  await assert.rejects(h.call('passkeys/delete', { id: auth.id }), status(404));
+  // Give Bob a credential so reauth can generate a legitimate scoped challenge.
+  const bobAuth = authenticator();
+  const registration = await h.call('passkeys/options', {});
+  await h.call('passkeys/verify', { challengeId: registration.challengeId, credential: bobAuth.registration(registration.options.challenge) });
+  const pending = await h.call('passkeys/reauth/options', {});
+  assert.deepEqual(pending.options.allowCredentials.map((key: any) => key.id), [bobAuth.id]);
+  await assert.rejects(h.call('passkeys/reauth/verify', { challengeId: pending.challengeId, credential: auth.assertion(pending.options.challenge, user.id) }), status(403));
+  assert.equal(h.store.passkey(auth.id)?.counter, 0);
+  h.store.db.close();
+});
+
+test('unknown credentials return 404, challenge cannot cross sessions, and counter replay is rejected', async () => {
+  const h = harness();
+  const { auth, user } = await enroll(h);
+  const step = await h.call('passkeys/reauth/options', {});
+  const other = harness(h.store);
+  await other.call('login', { username: 'alice', password: 'valid1234' });
+  await assert.rejects(other.call('passkeys/reauth/verify', { challengeId: step.challengeId, credential: auth.assertion(step.options.challenge, user.id) }), status(400));
+  await h.call('passkeys/reauth/verify', { challengeId: step.challengeId, credential: auth.assertion(step.options.challenge, user.id) });
+  const replay = await h.call('passkeys/reauth/options', {});
+  await assert.rejects(h.call('passkeys/reauth/verify', { challengeId: replay.challengeId, credential: auth.assertion(replay.options.challenge, user.id) }));
+  await h.call('logout', {});
+  const pending = await h.call('passkeys/login/options', {});
+  const unknown = authenticator();
+  await assert.rejects(h.call('passkeys/login/verify', { challengeId: pending.challengeId, credential: unknown.assertion(pending.options.challenge, user.id) }), status(404));
+  h.store.db.close();
+});
+
+test('password fallback checks the signed-in identity and preserves existing account mapping', async () => {
+  const h = harness();
+  const { user } = await enroll(h);
+  h.store.db.prepare('UPDATE sessions SET verifiedAt=0').run();
+  await assert.rejects(h.call('password/reauth', { username: 'bob', password: 'wrong' }), status(401));
+  assert.equal(h.session().verifiedAt, 0);
+  const confirmed = await h.call('password/reauth', { username: 'bob', password: 'valid1234' });
+  assert.ok(confirmed.verifiedUntil > Date.now());
+  assert.equal(h.session().userId, user.id);
+  assert.ok(h.session().verifiedAt > 0);
+  await h.call('logout', {});
+  assert.equal((await h.call('login', { username: 'alice', password: 'valid1234' })).user.id, user.id);
+  await h.call('signup', { username: 'new-reader', password: 'valid1234' });
+  assert.ok(h.calls.some(url => url.endsWith('/register')));
+  assert.equal((await h.call('account')).user.username, 'new-reader');
+  h.store.db.close();
+});
+
+test('data persists across database reopen; expiry, atomic challenge consumption and throttling', () => {
+  const dir = mkdtempSync(join(tmpdir(), 'times-auth-'));
+  try {
+    const path = join(dir, 'auth.sqlite');
+    let store = new AuthStore(path);
+    const user = store.ensureUser('reader');
+    const { session, token } = store.createSession(user.id);
+    const challenge = store.addChallenge(session, 'register', 'random-challenge');
+    store.db.close(); store = new AuthStore(path);
+    assert.equal(store.session(hashToken(token))?.userId, user.id);
+    assert.equal(store.takeChallenge(challenge, session.id, 'register')?.challenge, 'random-challenge');
+    assert.equal(store.takeChallenge(challenge, session.id, 'register'), undefined);
+    for (let i = 0; i < 10; i++) assert.equal(store.rateLimit('test', 10), true);
+    assert.equal(store.rateLimit('test', 10), false);
+    store.db.prepare('UPDATE sessions SET expiresAt=0').run();
+    assert.equal(store.session(session.id), undefined);
+    store.db.close();
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
