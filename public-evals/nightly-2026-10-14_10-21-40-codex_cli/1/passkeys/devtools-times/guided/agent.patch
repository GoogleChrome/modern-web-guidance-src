+        <div><label htmlFor="password" className="block text-sm font-medium text-gray-700 mb-1">Password</label>
+          <input type="password" id="password" name="password" autoComplete="current-password" value={password} onChange={e => setPassword(e.target.value)} required className="w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-gray-700" /></div>
+        <button type="submit" disabled={loading} className="w-full py-2 px-4 border border-gray-300 rounded-md font-medium hover:bg-gray-50 disabled:opacity-50">Sign in with password</button>
       </form>
+      <p className="text-sm text-center mt-6">New here? <a className="underline" href={appUrl('signup')}>Create an account</a></p>
     </div>
   );
 }
