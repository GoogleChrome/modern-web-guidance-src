+import { useEffect, useState } from 'react';
+import { FingerPrintIcon, KeyIcon, ShieldCheckIcon } from '@heroicons/react/24/outline';
+import { appUrl, authRequest, authenticatePasskey, registerPasskey, syncPasskeys, supportsPasskeys, errorMessage, RequestError, type Account } from '../lib/passkeys';
+import providers from '../lib/passkey-providers.json';
+
+const button = 'inline-flex justify-center items-center gap-2 rounded-md px-4 py-2 text-sm font-medium border border-gray-300 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed';
+const input = 'w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-gray-700';
+const date = (value?: number) => value ? new Date(value).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : 'Not used yet';
+
+export default function PasskeyManager() {
+  const [account, setAccount] = useState<Account | null>(null);
+  const [supported, setSupported] = useState(false);
+  const [canCreate, setCanCreate] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [name, setName] = useState('');
+  const [displayName, setDisplayName] = useState('');
+  const [password, setPassword] = useState('');
+  const [editing, setEditing] = useState<string | null>(null);
+  const [nickname, setNickname] = useState('');
+  const [deleting, setDeleting] = useState<string | null>(null);
+  const [now, setNow] = useState(Date.now());
+  const verified = !!account && account.verifiedUntil > now;
+  function update(next: Account) { setAccount(next); setNow(Date.now()); }
+  useEffect(() => {
+    let active = true;
+    setSupported(supportsPasskeys());
+    if (supportsPasskeys()) PublicKeyCredential.getClientCapabilities().then(capabilities => {
+      if (active) setCanCreate(!!capabilities.passkeyPlatformAuthenticator && !!capabilities.conditionalGet);
+    }).catch(() => {});
+    authRequest('account').then(next => {
+      if (!active) return;
+      update(next); setDisplayName(next.user.displayName); void syncPasskeys(next);
+      if (new URLSearchParams(window.location.search).has('welcome')) setNotice('Your account is ready. Add a passkey to sign in without typing a password.');
+    }).catch(err => {
+      if (!active) return;
+      if (err instanceof RequestError && err.status === 401) window.location.assign(appUrl('signin'));
+      else setError(errorMessage(err));
+    });
+    const timer = window.setInterval(() => setNow(Date.now()), 1000);
+    return () => { active = false; clearInterval(timer); };
+  }, []);
+  async function run(work: () => Promise<void>) {
+    setBusy(true); setError(''); setNotice('');
+    try { await work(); }
+    catch (err) { setError(errorMessage(err)); }
+    finally { setBusy(false); }
+  }
+  async function verify(usePassword = false) {
+    await run(async () => {
+      const next = usePassword ? await authRequest('password/reauth', { password }) : await authenticatePasskey(true);
+      update(next); setPassword(''); setNotice('Identity confirmed. You can make account changes for the next five minutes.');
+    });
+  }
+  return <div className="max-w-3xl mx-auto px-4 py-12 sm:px-6">
+    <a href={appUrl('')} className="text-sm text-gray-500 hover:underline">← Back to the Times</a>
+    <div className="mt-6 mb-8 flex items-start justify-between gap-4">
+      <div><p className="text-xs uppercase tracking-widest text-gray-500 mb-2">Your account</p><h1 className="font-brand text-4xl">Account security</h1><p className="mt-2 text-gray-600">Manage how you sign in to The DevTools Times.</p></div>
+      {account && <button className={button} disabled={busy} onClick={() => run(async () => { await authRequest('logout', {}); window.location.assign(appUrl('signin')); })}>Sign out</button>}
+    </div>
+    {error && <p role="alert" className="mb-5 rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-800">{error}</p>}
+    {notice && <p role="status" className="mb-5 rounded-md bg-green-50 border border-green-200 p-4 text-sm text-green-800">{notice}</p>}
+    {!account ? <p role="status">{error ? 'Unable to load your account. Reload this page to try again.' : 'Loading your account…'}</p> : <div className="space-y-6" aria-busy={busy}>
+      <section className="border border-gray-200 rounded-lg p-5 sm:p-6">
+        <div className="flex gap-3"><ShieldCheckIcon className="w-6 h-6 shrink-0" /><div><h2 className="font-semibold text-lg">Confirm your identity</h2><p className="text-sm text-gray-600 mt-1">For your protection, account changes require a recent sign-in.</p></div></div>
+        <p className={`text-sm my-4 ${verified ? 'text-green-700' : 'text-amber-800'}`}>{verified ? 'Identity confirmed · account changes are enabled' : 'Please confirm your identity to add, rename, or remove passkeys.'}</p>
+        <div className="flex flex-col sm:flex-row gap-4">
+          {account.passkeys.length > 0 && <button className={button} disabled={busy || !supported} onClick={() => verify()}><FingerPrintIcon className="w-5 h-5" />Confirm with passkey</button>}
+          <form className="flex flex-1 gap-2" onSubmit={event => { event.preventDefault(); void verify(true); }}>
+            <label htmlFor="confirm-password" className="sr-only">Confirm your password</label>
+            <input id="confirm-password" type="password" autoComplete="current-password" placeholder="Your password" className={input} value={password} onChange={event => setPassword(event.target.value)} required disabled={busy} />
+            <button className={button} disabled={busy}>Confirm</button>
+          </form>
+        </div>
+      </section>
+      <section className="border border-gray-200 rounded-lg p-5 sm:p-6">
+        <div className="flex gap-3"><FingerPrintIcon className="w-6 h-6 shrink-0" /><div><h2 className="font-semibold text-lg">Passkeys</h2><p className="text-sm text-gray-600 mt-1">A safer, simpler way to sign in. Use your face, fingerprint, screen lock, or a security key. Your biometric data stays on your device.</p></div></div>
+        {!account.passkeys.length && <div className="text-center my-6 py-6 rounded-md bg-gray-50"><KeyIcon className="w-8 h-8 mx-auto text-gray-400 mb-3" /><p className="font-medium">No passkeys yet</p><p className="text-sm text-gray-500 mt-1">Add your first passkey below. You can still use your password.</p></div>}
+        <ul className="divide-y divide-gray-200 my-4">
+          {account.passkeys.map(key => {
+            const provider = (providers as Record<string, { name: string; icon_light?: string }>)[key.aaguid];
+            return <li key={key.id} className="py-5">
+              <div className="flex flex-wrap items-start justify-between gap-3">
+                <div className="flex gap-3">
+                  {provider?.icon_light ? <img src={provider.icon_light} alt="" className="w-8 h-8" /> : <KeyIcon className="w-7 h-7 text-gray-500" />}
+                  <div><p className="font-medium break-all">{key.name}</p><p className="text-xs text-gray-500 mt-1">{provider?.name || 'Passkey provider'} · {key.deviceType === 'multiDevice' ? (key.backedUp ? 'Synced passkey' : 'Sync-capable passkey') : 'Device-bound passkey'}</p><p className="text-xs text-gray-500 mt-1">Added {date(key.registeredAt)} · Last used: {date(key.lastUsedAt)}</p></div>
+                </div>
+                <div className="flex gap-2"><button className={button} disabled={busy || !verified} onClick={() => { setEditing(key.id); setNickname(key.name); setDeleting(null); }}>Rename<span className="sr-only"> {key.name}</span></button><button className={`${button} text-red-700`} disabled={busy || !verified} onClick={() => { setDeleting(key.id); setEditing(null); }}>Remove<span className="sr-only"> {key.name}</span></button></div>
+              </div>
+              {editing === key.id && <form className="mt-4 flex flex-wrap gap-2" onSubmit={event => { event.preventDefault(); void run(async () => { update(await authRequest('passkeys/rename', { id: key.id, name: nickname })); setEditing(null); setNotice('Passkey renamed.'); }); }}>
+                <label className="sr-only" htmlFor={`rename-${key.id}`}>New passkey name</label><input id={`rename-${key.id}`} className={`${input} sm:flex-1`} value={nickname} onChange={event => setNickname(event.target.value)} required maxLength={64} autoFocus /><button className={button} disabled={busy || !verified}>Save</button><button className={button} type="button" onClick={() => setEditing(null)}>Cancel</button>
+              </form>}
+              {deleting === key.id && <div className="mt-4 rounded-md bg-red-50 p-4 text-sm"><p>Remove “{key.name}”? It will no longer work for this account. You can still sign in with your password{account.passkeys.length > 1 ? ' or another passkey' : ''}.</p><div className="mt-3 flex gap-2"><button className={`${button} text-red-700`} disabled={busy || !verified} onClick={() => run(async () => { const next = await authRequest('passkeys/delete', { id: key.id }); update(next); await syncPasskeys(next); setDeleting(null); setNotice('Passkey removed. You may also remove it from your password manager.'); })}>Remove passkey</button><button className={button} disabled={busy} onClick={() => setDeleting(null)}>Cancel</button></div></div>}
+            </li>;
+          })}
+        </ul>
+        <form className="border-t border-gray-200 pt-5" onSubmit={event => { event.preventDefault(); void run(async () => { const next = await registerPasskey(name); update(next); await syncPasskeys(next); setName(''); setNotice('Passkey added. You can now use it to sign in.'); }); }}>
+          <label htmlFor="passkey-name" className="block text-sm font-medium mb-2">Name your new passkey</label>
+          <div className="flex flex-col sm:flex-row gap-3"><input id="passkey-name" className={input} value={name} onChange={event => setName(event.target.value)} placeholder="e.g. Personal laptop" maxLength={64} required disabled={busy || !verified || !canCreate} /><button className={`${button} bg-gray-900 text-white hover:bg-gray-800 whitespace-nowrap`} disabled={busy || !verified || !canCreate}><span aria-hidden="true">+</span> Add passkey</button></div>
+          <p className="text-xs text-gray-500 mt-2">{canCreate ? 'Save a passkey on this device, another device, or a compatible security key.' : 'Passkey creation is unavailable in this browser or on this device. You can still use your password.'}</p>
+        </form>
+      </section>
+      <section className="border border-gray-200 rounded-lg p-5 sm:p-6"><h2 className="font-semibold text-lg">Account details</h2><p className="text-sm text-gray-600 mt-1">Signed in as <strong className="break-all">{account.user.username}</strong></p>
+        <form className="mt-5" onSubmit={event => { event.preventDefault(); void run(async () => { const next = await authRequest('account/profile', { displayName }); update(next); await syncPasskeys(next, true); setNotice('Display name updated.'); }); }}><label htmlFor="display-name" className="block text-sm font-medium mb-2">Display name</label><div className="flex gap-3"><input id="display-name" className={input} value={displayName} onChange={event => setDisplayName(event.target.value)} required maxLength={128} disabled={busy || !verified} /><button className={button} disabled={busy || !verified}>Save</button></div></form>
+      </section>
+    </div>}
+  </div>;
+}
