+test('serves the account interface and stylesheet with security headers', async () => {
+  const page = await fetch(origin);
+  assert.equal(page.status, 200);
+  assert.match(page.headers.get('content-security-policy'), /frame-ancestors 'none'/);
+  const html = await page.text();
+  assert.match(html, /Sign-in &amp; security|Sign-in & security/);
+  assert.match(html, /Create a passkey/);
+  assert.match(html, /role="tablist"/);
+  const styles = await fetch(`${origin}/styles.css`);
+  assert.equal(styles.status, 200);
+  assert.match(styles.headers.get('content-type'), /text\/css/);
+});
