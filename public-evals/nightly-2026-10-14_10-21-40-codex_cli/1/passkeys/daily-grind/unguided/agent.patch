+
+let app, server, origin;
+before(async () => {
+  app = createApp({ databasePath: ':memory:' });
+  server = app.listen(0, '127.0.0.1');
+  await new Promise(resolve => server.on('listening', resolve));
+  origin = `http://127.0.0.1:${server.address().port}`;
+});
+after(() => { server.close(); app.locals.db.close(); });
+function client() {
+  let cookie = '';
+  return async (path, body, method = body ? 'POST' : 'GET', requestOrigin = origin) => {
+    const response = await fetch(`${origin}/api${path}`, { method, headers: { 'Content-Type': 'application/json', Origin: requestOrigin, Cookie: cookie }, ...(body ? { body: JSON.stringify(body) } : {}) });
+    const setCookie = response.headers.get('set-cookie');
+    if (setCookie) cookie = setCookie.split(';')[0];
+    return { status: response.status, body: await response.json(), headers: response.headers };
+  };
+}
+const sha = value => createHash('sha256').update(value).digest();
+function authenticator() {
+  const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'prime256v1' });
+  const jwk = publicKey.export({ format: 'jwk' });
+  const id = randomBytes(32);
+  const cose = isoCBOR.encode(new Map([[1, 2], [3, -7], [-1, 1], [-2, Buffer.from(jwk.x, 'base64url')], [-3, Buffer.from(jwk.y, 'base64url')]]));
+  let counter = 0;
+  let userHandle;
+  function clientData(type, challenge, override = {}) { return Buffer.from(JSON.stringify({ type, challenge, origin, crossOrigin: false, ...override })); }
+  function authData(flags, count) {
+    const buffer = Buffer.alloc(37);
+    sha('127.0.0.1').copy(buffer); buffer[32] = flags; buffer.writeUInt32BE(count, 33); return buffer;
+  }
+  return {
+    id: id.toString('base64url'),
+    register(options, override = {}) {
+      userHandle = options.user.id;
+      const size = Buffer.alloc(2); size.writeUInt16BE(id.length);
+      const data = Buffer.concat([authData(0x45, 0), Buffer.alloc(16), size, id, Buffer.from(cose)]);
+      const attestation = isoCBOR.encode(new Map([['fmt', 'none'], ['attStmt', new Map()], ['authData', data]]));
+      return { id: id.toString('base64url'), rawId: id.toString('base64url'), type: 'public-key', response: { clientDataJSON: clientData('webauthn.create', options.challenge, override).toString('base64url'), attestationObject: Buffer.from(attestation).toString('base64url'), transports: ['internal'] }, clientExtensionResults: {}, authenticatorAttachment: 'platform' };
+    },
+    authenticate(options, { flags = 5, counterValue = ++counter, ...override } = {}) {
+      const data = authData(flags, counterValue);
+      const client = clientData('webauthn.get', options.challenge, override);
+      const signature = sign('sha256', Buffer.concat([data, sha(client)]), privateKey);
+      return { id: id.toString('base64url'), rawId: id.toString('base64url'), type: 'public-key', response: { authenticatorData: data.toString('base64url'), clientDataJSON: client.toString('base64url'), signature: signature.toString('base64url'), userHandle }, clientExtensionResults: {} };
+    },
+  };
+}
+async function register(request, auth, email, name = 'First key') {
+  const options = await request('/registration/options', { name: 'Alex Morgan', email, passkeyName: name });
+  assert.equal(options.status, 200);
+  const verification = await request('/registration/verify', auth.register(options.body));
+  assert.equal(verification.status, 200, JSON.stringify(verification.body));
+  return (await request('/me')).body;
+}
+
+test('registration, authentication, reauthentication and passkey management work with real signed WebAuthn responses', async () => {
+  const browser = client(), key = authenticator();
+  const guest = await browser('/me');
+  assert.equal(guest.body.user, null);
+  assert.match(guest.headers.get('set-cookie'), /HttpOnly/);
+  const registered = await register(browser, key, 'alex@example.com');
+  assert.equal(registered.user.name, 'Alex Morgan');
+  assert.equal(registered.passkeys.length, 1);
+  assert.equal(registered.passkeys[0].name, 'First key');
+  const firstSession = app.locals.db.prepare('SELECT id FROM sessions WHERE user_id=?').get(registered.user.id).id;
+  const noDelete = await browser(`/passkeys/${key.id}`, {}, 'DELETE');
+  assert.equal(noDelete.status, 400);
+
+  const loginBrowser = client();
+  const options = (await loginBrowser('/authentication/options', {})).body;
+  assert.equal(options.userVerification, 'required');
+  const login = await loginBrowser('/authentication/verify', { credential: key.authenticate(options), purpose: 'login' });
+  assert.equal(login.status, 200, JSON.stringify(login.body));
+  assert.equal((await loginBrowser('/me')).body.user.id, registered.user.id);
+  assert.equal((await loginBrowser('/authentication/verify', { credential: key.authenticate(options), purpose: 'login' })).status, 400, 'Challenge cannot be replayed');
+
+  app.locals.db.prepare('UPDATE sessions SET verified_at=0 WHERE user_id=?').run(registered.user.id);
+  const denied = await browser(`/passkeys/${key.id}`, { name: 'Laptop' }, 'PATCH');
+  assert.equal(denied.body.code, 'REAUTH_REQUIRED');
+  const reauthOptions = (await browser('/authentication/options', { purpose: 'reauth' })).body;
+  assert.equal(reauthOptions.allowCredentials[0].id, key.id);
+  assert.equal((await browser('/authentication/verify', { purpose: 'reauth', credential: key.authenticate(reauthOptions) })).status, 200);
+  assert.equal((await browser(`/passkeys/${key.id}`, { name: 'Laptop' }, 'PATCH')).status, 200);
+
+  const backup = authenticator();
+  const options2 = (await browser('/registration/options', { passkeyName: 'Backup key' })).body;
+  assert.equal(options2.excludeCredentials[0].id, key.id);
+  assert.equal((await browser('/registration/verify', backup.register(options2))).status, 200);
+  assert.equal((await browser('/me')).body.passkeys.length, 2);
+  assert.equal((await browser(`/passkeys/${backup.id}`, {}, 'DELETE')).status, 200);
+  assert.equal((await loginBrowser('/me')).body.user, null, 'Removing a key revokes other sessions');
+  assert.ok(app.locals.db.prepare('SELECT id FROM sessions WHERE id=?').get(firstSession));
+  assert.equal((await browser('/logout', {})).status, 200);
+  assert.equal((await browser('/me')).body.user, null);
+});
+
+test('rejects cross-origin writes, unauthenticated management, expired and mismatched ceremonies', async () => {
+  const request = client();
+  assert.equal((await request('/registration/options', { name: 'Bad', email: 'bad@example.com' }, 'POST', 'https://evil.example')).status, 403);
+  assert.equal((await request('/authentication/options', { purpose: 'reauth' })).status, 401);
+  assert.equal((await request('/sessions/revoke', {})).status, 401);
+  assert.equal((await request('/passkeys/unknown', { name: 'No' }, 'PATCH')).status, 401);
+  assert.equal((await request('/registration/options', { name: 'Valid', email: 'invalid' })).status, 400);
+  const key = authenticator();
+  const options = (await request('/registration/options', { name: 'Bad Origin', email: 'origin@example.com' })).body;
+  assert.equal((await request('/registration/verify', key.register(options, { origin: 'https://evil.example' }))).status, 400);
+  assert.equal((await request('/registration/verify', key.register(options))).status, 400, 'Failed challenge is consumed');
+  const moreOptions = (await request('/registration/options', { name: 'Expired', email: 'expired@example.com' })).body;
+  app.locals.db.exec("UPDATE sessions SET pending=json_set(pending, '$.expires', 0) WHERE user_id IS NULL AND pending IS NOT NULL");
+  assert.equal((await request('/registration/verify', key.register(moreOptions))).status, 400);
+  assert.equal(app.locals.db.prepare('SELECT COUNT(*) AS count FROM users').get().count, 1, 'Failed registrations never create accounts');
+});
+
+test('enforces ownership, valid signatures, user verification, counters, and session revocation', async () => {
+  const alice = client(), bob = client();
+  const aliceKey = authenticator(), bobKey = authenticator();
+  const aliceAccount = await register(alice, aliceKey, 'alice@example.com');
+  await register(bob, bobKey, 'bob@example.com');
+  assert.equal((await bob(`/passkeys/${aliceKey.id}`, { name: 'Hacked' }, 'PATCH')).status, 404);
+  const bobOptions = (await bob('/authentication/options', { purpose: 'reauth' })).body;
+  assert.equal((await bob('/authentication/verify', { purpose: 'reauth', credential: aliceKey.authenticate(bobOptions) })).status, 400);
+  const attacker = client();
+  const options = (await attacker('/authentication/options', {})).body;
+  const bad = aliceKey.authenticate(options);
+  bad.response.signature = randomBytes(70).toString('base64url');
+  assert.equal((await attacker('/authentication/verify', { credential: bad })).status, 400);
+  const noUVOptions = (await attacker('/authentication/options', {})).body;
+  assert.equal((await attacker('/authentication/verify', { credential: aliceKey.authenticate(noUVOptions, { flags: 1 }) })).status, 400);
+  const validOptions = (await attacker('/authentication/options', {})).body;
+  assert.equal((await attacker('/authentication/verify', { credential: aliceKey.authenticate(validOptions, { counterValue: 20 }) })).status, 200);
+  const replayOptions = (await attacker('/authentication/options', {})).body;
+  assert.equal((await attacker('/authentication/verify', { credential: aliceKey.authenticate(replayOptions, { counterValue: 19 }) })).status, 400);
+  const revoked = await alice('/sessions/revoke', {});
+  assert.equal(revoked.body.revoked, 1);
+  assert.equal((await attacker('/me')).body.user, null);
+  assert.equal((await alice('/me')).body.user.id, aliceAccount.user.id);
+});
