+  const tabs = [...document.querySelectorAll('[data-tab]')];
+  const index = tabs.indexOf(event.target);
+  const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
+  renderTab(tabs[next].dataset.tab); tabs[next].focus();
+});
+window.addEventListener('hashchange', () => { const page = location.hash.slice(1); if (['account', 'home', 'menu', 'orders', 'rewards', 'locations'].includes(page)) navigate(page); });
+icons();
+const initialPage = location.hash.slice(1);
+if (['home', 'menu', 'orders', 'rewards', 'locations'].includes(initialPage)) navigate(initialPage);
+refresh().catch(() => toast('We couldn’t load your account. Please check your connection and try again.'));
