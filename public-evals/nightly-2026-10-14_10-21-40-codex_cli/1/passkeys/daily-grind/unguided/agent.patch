+++ b/server.js
@@ -0,0 +1,204 @@
+import express from 'express';
+import { DatabaseSync } from 'node:sqlite';
+import { randomBytes, createHash } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+import { mkdirSync } from 'node:fs';
+import { generateRegistrationOptions, verifyRegistrationResponse, generateAuthenticationOptions, verifyAuthenticationResponse } from '@simplewebauthn/server';
+
+const root = dirname(fileURLToPath(import.meta.url));
+const FIVE_MINUTES = 300000;
+const WEEK = 7 * 86400000;
+const hash = value => createHash('sha256').update(value).digest('hex');
+const token = () => randomBytes(32).toString('base64url');
+const problem = (status, message, code) => Object.assign(new Error(message), { status, code });
+
+export function createApp({ databasePath = process.env.DATABASE_PATH || join(root, 'data', 'accounts.sqlite'), publicOrigin = process.env.PUBLIC_ORIGIN } = {}) {
+  if (databasePath !== ':memory:') mkdirSync(dirname(databasePath), { recursive: true });
+  const db = new DatabaseSync(databasePath);
+  db.exec(`PRAGMA foreign_keys=ON; PRAGMA journal_mode=WAL;
+    CREATE TABLE IF NOT EXISTS users (id TEXT PRIMARY KEY, name TEXT NOT NULL, email TEXT UNIQUE NOT NULL, created_at INTEGER NOT NULL);
+    CREATE TABLE IF NOT EXISTS credentials (id TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id), name TEXT NOT NULL, public_key BLOB NOT NULL, counter INTEGER NOT NULL, transports TEXT NOT NULL, device_type TEXT NOT NULL, backed_up INTEGER NOT NULL, created_at INTEGER NOT NULL, last_used INTEGER);
+    CREATE TABLE IF NOT EXISTS sessions (id TEXT PRIMARY KEY, user_id TEXT REFERENCES users(id), expires_at INTEGER NOT NULL, verified_at INTEGER NOT NULL DEFAULT 0, pending TEXT);
+  `);
+  const app = express();
+  app.disable('x-powered-by');
+  app.set('trust proxy', 1);
+  app.use(express.json({ limit: '32kb' }));
+  app.use((req, res, next) => {
+    res.set('X-Content-Type-Options', 'nosniff');
+    res.set('Referrer-Policy', 'same-origin');
+    res.set('Permissions-Policy', 'publickey-credentials-create=(self), publickey-credentials-get=(self)');
+    res.set('Content-Security-Policy', "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://images.unsplash.com data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'");
+    next();
+  });
+  const attempts = new Map();
+  app.use('/api', (req, res, next) => {
+    res.set('Cache-Control', 'no-store');
+    req.siteOrigin = publicOrigin || `${req.protocol}://${req.get('host')}`;
+    req.rpID = new URL(req.siteOrigin).hostname;
+    if (req.method !== 'GET') {
+      if (req.get('origin') !== req.siteOrigin) return next(problem(403, 'This request must come from this website.'));
+      if (!req.body || typeof req.body !== 'object' || Array.isArray(req.body)) return next(problem(400, 'Please send a JSON object.'));
+      const now = Date.now();
+      for (const [key, value] of attempts) if (value.until < now) attempts.delete(key);
+      const bucket = attempts.get(req.ip) || { count: 0, until: now + 900000 };
+      bucket.count++; attempts.set(req.ip, bucket);
+      if (bucket.count > 100) return next(problem(429, 'Too many attempts. Please try again in 15 minutes.'));
+    }
+    const cookie = req.headers.cookie?.split(';').map(x => x.trim()).find(x => x.startsWith('dg_session='))?.slice(11);
+    req.session = cookie && /^[\w-]{43}$/.test(cookie) ? db.prepare('SELECT * FROM sessions WHERE id=? AND expires_at>?').get(hash(cookie), Date.now()) : null;
+    if (!req.session) {
+      db.prepare('DELETE FROM sessions WHERE expires_at<?').run(Date.now());
+      const raw = token();
+      req.session = { id: hash(raw), user_id: null, verified_at: 0, expires_at: Date.now() + WEEK };
+      db.prepare('INSERT INTO sessions(id, expires_at) VALUES (?,?)').run(req.session.id, req.session.expires_at);
+      setCookie(req, res, raw);
+    }
+    next();
+  });
+  function setCookie(req, res, value, maxAge = WEEK) {
+    res.cookie('dg_session', value, { httpOnly: true, secure: req.siteOrigin.startsWith('https:'), sameSite: 'lax', path: '/', maxAge });
+  }
+  function rotate(req, res, userID) {
+    const raw = token();
+    db.prepare('DELETE FROM sessions WHERE id=?').run(req.session.id);
+    db.prepare('INSERT INTO sessions(id,user_id,expires_at,verified_at) VALUES (?,?,?,?)').run(hash(raw), userID, Date.now() + WEEK, Date.now());
+    setCookie(req, res, raw);
+  }
+  function requireUser(req) {
+    if (!req.session.user_id) throw problem(401, 'Sign in to manage your account.');
+    return db.prepare('SELECT * FROM users WHERE id=?').get(req.session.user_id);
+  }
+  function requireRecent(req) {
+    const user = requireUser(req);
+    if (Date.now() - req.session.verified_at > FIVE_MINUTES) throw problem(403, 'Confirm it’s you with your passkey to continue.', 'REAUTH_REQUIRED');
+    return user;
+  }
+  function remember(req, pending) {
+    db.prepare('UPDATE sessions SET pending=? WHERE id=?').run(JSON.stringify({ ...pending, expires: Date.now() + FIVE_MINUTES }), req.session.id);
+  }
+  function consume(req, purpose) {
+    const value = db.prepare('SELECT pending FROM sessions WHERE id=?').get(req.session.id)?.pending;
+    db.prepare('UPDATE sessions SET pending=NULL WHERE id=?').run(req.session.id);
+    const pending = value ? JSON.parse(value) : null;
+    if (!pending || pending.purpose !== purpose || pending.expires < Date.now()) throw problem(400, 'This request has expired. Please try again.');
+    return pending;
+  }
+  const nameValue = value => {
+    if (typeof value !== 'string' || !value.trim() || value.trim().length > 60) throw problem(400, 'Please enter a name between 1 and 60 characters.');
+    return value.trim();
+  };
+  const keys = userID => db.prepare('SELECT id,name,device_type,backed_up,created_at,last_used FROM credentials WHERE user_id=? ORDER BY created_at').all(userID);
+
+  app.get('/api/me', (req, res) => {
+    const user = req.session.user_id ? requireUser(req) : null;
+    res.json({ user, passkeys: user ? keys(user.id) : [], verifiedUntil: req.session.verified_at ? req.session.verified_at + FIVE_MINUTES : 0 });
+  });
+  app.post('/api/registration/options', async (req, res) => {
+    let user;
+    if (req.session.user_id) user = requireRecent(req);
+    else {
+      const name = nameValue(req.body.name);
+      const email = typeof req.body.email === 'string' ? req.body.email.trim().toLowerCase() : '';
+      if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw problem(400, 'Please enter a valid email address.');
+      if (db.prepare('SELECT id FROM users WHERE email=?').get(email)) throw problem(409, 'An account with this email already exists. Sign in with your passkey.');
+      user = { id: token(), name, email };
+    }
+    const keyName = nameValue(req.body.passkeyName || 'My passkey');
+    const existing = db.prepare('SELECT id,transports FROM credentials WHERE user_id=?').all(user.id);
+    if (existing.length >= 10) throw problem(400, 'You can have up to 10 passkeys. Remove an unused one first.');
+    const options = await generateRegistrationOptions({
+      rpName: 'The Daily Grind', rpID: req.rpID, userID: Buffer.from(user.id, 'base64url'), userName: user.email, userDisplayName: user.name,
+      attestationType: 'none', authenticatorSelection: { residentKey: 'required', userVerification: 'required' },
+      supportedAlgorithmIDs: [-7, -257], excludeCredentials: existing.map(k => ({ id: k.id, transports: JSON.parse(k.transports) })),
+    });
+    remember(req, { purpose: 'register', challenge: options.challenge, user, keyName, newAccount: !req.session.user_id });
+    res.json(options);
+  });
+  app.post('/api/registration/verify', async (req, res) => {
+    const pending = consume(req, 'register');
+    if (!pending.newAccount) {
+      const user = requireRecent(req);
+      if (user.id !== pending.user.id) throw problem(403, 'Account changed. Please try again.');
+    }
+    let result;
+    try { result = await verifyRegistrationResponse({ response: req.body, expectedChallenge: pending.challenge, expectedOrigin: req.siteOrigin, expectedRPID: req.rpID, requireUserVerification: true, supportedAlgorithmIDs: [-7, -257] }); }
+    catch { throw problem(400, 'Your passkey could not be verified. Please try again.'); }
+    if (!result.verified) throw problem(400, 'Your passkey could not be verified.');
+    const info = result.registrationInfo;
+    db.exec('BEGIN');
+    try {
+      if (db.prepare('SELECT COUNT(*) AS count FROM credentials WHERE user_id=?').get(pending.user.id).count >= 10) throw problem(400, 'You can have up to 10 passkeys. Remove an unused one first.');
+      if (pending.newAccount) db.prepare('INSERT INTO users(id,name,email,created_at) VALUES (?,?,?,?)').run(pending.user.id, pending.user.name, pending.user.email, Date.now());
+      db.prepare('INSERT INTO credentials VALUES (?,?,?,?,?,?,?,?,?,?)').run(info.credential.id, pending.user.id, pending.keyName, Buffer.from(info.credential.publicKey), info.credential.counter, JSON.stringify(info.credential.transports || []), info.credentialDeviceType, Number(info.credentialBackedUp), Date.now(), null);
+      db.exec('COMMIT');
+    } catch (error) { db.exec('ROLLBACK'); if (error.status) throw error; throw problem(409, 'This account or passkey is already registered. Please sign in.'); }
+    if (pending.newAccount) rotate(req, res, pending.user.id);
+    res.json({ verified: true });
+  });
+  app.post('/api/authentication/options', async (req, res) => {
+    const reauth = req.body.purpose === 'reauth';
+    const user = reauth ? requireUser(req) : null;
+    const credentials = user ? db.prepare('SELECT id,transports FROM credentials WHERE user_id=?').all(user.id) : null;
+    const options = await generateAuthenticationOptions({ rpID: req.rpID, userVerification: 'required', ...(credentials ? { allowCredentials: credentials.map(k => ({ id: k.id, transports: JSON.parse(k.transports) })) } : {}) });
+    remember(req, { purpose: reauth ? 'reauth' : 'login', challenge: options.challenge, userID: user?.id });
+    res.json(options);
+  });
+  app.post('/api/authentication/verify', async (req, res) => {
+    const purpose = req.body.purpose === 'reauth' ? 'reauth' : 'login';
+    const pending = consume(req, purpose);
+    const response = req.body.credential;
+    if (!response || typeof response.id !== 'string') throw problem(400, 'No passkey response was received.');
+    const credential = db.prepare('SELECT * FROM credentials WHERE id=?').get(response.id);
+    if (!credential || (purpose === 'reauth' && (credential.user_id !== pending.userID || credential.user_id !== req.session.user_id))) throw problem(400, 'This passkey does not belong to this account.');
+    if (response.response?.userHandle && response.response.userHandle !== credential.user_id) throw problem(400, 'This passkey does not belong to this account.');
+    let result;
+    try { result = await verifyAuthenticationResponse({ response, expectedChallenge: pending.challenge, expectedOrigin: req.siteOrigin, expectedRPID: req.rpID, requireUserVerification: true, credential: { id: credential.id, publicKey: new Uint8Array(credential.public_key), counter: credential.counter, transports: JSON.parse(credential.transports) } }); }
+    catch { throw problem(400, 'Your passkey could not be verified. Please try again.'); }
+    if (!result.verified) throw problem(400, 'Your passkey could not be verified.');
+    const updated = db.prepare('UPDATE credentials SET counter=?,last_used=?,backed_up=? WHERE id=? AND counter=?').run(result.authenticationInfo.newCounter, Date.now(), Number(result.authenticationInfo.credentialBackedUp), credential.id, credential.counter);
+    if (!updated.changes) throw problem(400, 'This passkey changed during verification. Please try again.');
+    if (purpose === 'reauth') db.prepare('UPDATE sessions SET verified_at=? WHERE id=?').run(Date.now(), req.session.id);
+    else rotate(req, res, credential.user_id);
+    res.json({ verified: true });
+  });
+  app.patch('/api/passkeys/:id', (req, res) => {
+    const user = requireRecent(req);
+    const name = nameValue(req.body.name);
+    const result = db.prepare('UPDATE credentials SET name=? WHERE id=? AND user_id=?').run(name, req.params.id, user.id);
+    if (!result.changes) throw problem(404, 'Passkey not found.');
+    res.json({ updated: true });
+  });
+  app.delete('/api/passkeys/:id', (req, res) => {
+    const user = requireRecent(req);
+    if (!db.prepare('SELECT id FROM credentials WHERE id=? AND user_id=?').get(req.params.id, user.id)) throw problem(404, 'Passkey not found.');
+    if (keys(user.id).length < 2) throw problem(400, 'Add another passkey before removing your last one, so you can still sign in.');
+    db.prepare('DELETE FROM credentials WHERE id=? AND user_id=?').run(req.params.id, user.id);
+    // Removing a credential also ends all other sessions.
+    db.prepare('DELETE FROM sessions WHERE user_id=? AND id!=?').run(user.id, req.session.id);
+    res.json({ removed: true });
+  });
+  app.post('/api/sessions/revoke', (req, res) => {
+    const user = requireRecent(req);
+    const result = db.prepare('DELETE FROM sessions WHERE user_id=? AND id!=?').run(user.id, req.session.id);
+    res.json({ revoked: result.changes });
+  });
+  app.post('/api/logout', (req, res) => {
+    db.prepare('DELETE FROM sessions WHERE id=?').run(req.session.id);
+    setCookie(req, res, '', 0);
+    res.json({ signedOut: true });
+  });
+  app.use('/api', (req, res) => res.status(404).json({ error: 'Endpoint not found.' }));
+  app.use(express.static(join(root, 'public')));
+  app.get('/', (req, res) => res.sendFile(join(root, 'index.html')));
+  app.use((error, req, res, next) => {
+    if (!error.status) console.error(error);
+    res.status(error.status || 500).json({ error: error.status ? error.message : 'Something went wrong. Please try again.', code: error.code });
+  });
+  app.locals.db = db;
+  return app;
+}
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  createApp().listen(Number(process.env.PORT) || 11222, '0.0.0.0', () => console.log('The Daily Grind is ready'));
+}
