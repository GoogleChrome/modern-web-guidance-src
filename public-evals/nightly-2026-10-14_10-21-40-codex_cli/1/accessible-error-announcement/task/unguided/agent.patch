+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const newsletterEmail = document.querySelector('#newsletter-email');
+
+    const syncEmailInvalid = () => {
+      newsletterEmail.setAttribute('aria-invalid', String(newsletterEmail.matches(':user-invalid')));
+    };
+
+    // Read the browser's interaction state after its event handling has finished.
+    const scheduleEmailInvalidSync = () => {
+      requestAnimationFrame(syncEmailInvalid);
+    };
+
+    newsletterEmail.addEventListener('blur', scheduleEmailInvalidSync);
+    newsletterEmail.addEventListener('input', scheduleEmailInvalidSync);
+    newsletterEmail.addEventListener('invalid', scheduleEmailInvalidSync);
+    newsletter.addEventListener('reset', scheduleEmailInvalidSync);
+    newsletter.addEventListener('submit', (event) => {
+      // Keep the email on this page until a subscription service is connected.
+      event.preventDefault();
+      scheduleEmailInvalidSync();
+    });
+  </script>
+
