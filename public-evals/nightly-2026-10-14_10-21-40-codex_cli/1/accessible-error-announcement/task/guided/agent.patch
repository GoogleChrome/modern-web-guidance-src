+  <script>
+    const newsletterForm = document.getElementById('newsletter-form');
+    const newsletterEmail = document.getElementById('newsletter-email');
+
+    const syncNewsletterValidity = () => {
+      if (newsletterEmail.matches(':user-invalid')) {
+        newsletterEmail.setAttribute('aria-invalid', 'true');
+      } else {
+        newsletterEmail.removeAttribute('aria-invalid');
+      }
+    };
+
+    const updateNewsletterValidity = () => {
+      syncNewsletterValidity();
+      // Recheck after the browser updates its interaction state, including on submission.
+      requestAnimationFrame(syncNewsletterValidity);
+    };
+
+    for (const eventName of ['focus', 'blur', 'input', 'change', 'invalid']) {
+      newsletterEmail.addEventListener(eventName, updateNewsletterValidity);
+    }
+
+    newsletterForm.addEventListener('reset', () => {
+      requestAnimationFrame(syncNewsletterValidity);
+    });
+
+    newsletterForm.addEventListener('submit', (event) => {
+      // Keep the page in place until a newsletter subscription service is connected.
+      event.preventDefault();
+      updateNewsletterValidity();
+    });
+  </script>
+
 </body>
 
