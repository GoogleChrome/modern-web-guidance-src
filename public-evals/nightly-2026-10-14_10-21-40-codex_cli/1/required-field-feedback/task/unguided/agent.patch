+  <script>
+    const mailingListForm = document.getElementById('mailing-list-form');
+    const emailInput = document.getElementById('mailing-list-email');
+    const emailError = document.getElementById('mailing-list-error');
+    const signupStatus = document.getElementById('mailing-list-status');
+    let emailTouched = false;
+
+    function validateEmail() {
+      let message = '';
+      if (emailTouched) {
+        if (!emailInput.value.trim()) {
+          message = 'Please enter your email address.';
+        } else if (!emailInput.validity.valid) {
+          message = 'Please enter a valid email address.';
+        }
+      }
+
+      emailError.textContent = message;
+      emailError.hidden = !message;
+      if (message) {
+        emailInput.setAttribute('aria-invalid', 'true');
+      } else {
+        emailInput.removeAttribute('aria-invalid');
+      }
+      return emailInput.value.trim() !== '' && emailInput.validity.valid;
+    }
+
+    emailInput.addEventListener('blur', () => {
+      emailTouched = true;
+      validateEmail();
+    });
+
+    emailInput.addEventListener('input', () => {
+      signupStatus.textContent = '';
+      validateEmail();
+    });
+
+    mailingListForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      signupStatus.textContent = '';
+      if (!validateEmail()) {
+        emailInput.focus();
+        return;
+      }
+
+      // Connect a mailing-list provider here before accepting subscriptions.
+      signupStatus.textContent = 'Mailing list signup is not available yet. Please check back soon.';
+    });
+  </script>
+
 </body>
 
