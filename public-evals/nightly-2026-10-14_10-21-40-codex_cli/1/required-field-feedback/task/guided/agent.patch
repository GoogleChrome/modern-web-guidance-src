+  <script>
+    const mailingList = document.querySelector('.mailing-list');
+    const email = document.getElementById('mailing-list-email');
+    const errorText = document.getElementById('email-error-text');
+    const signupStatus = mailingList.querySelector('.signup-status');
+
+    function showEmailValidity() {
+      errorText.textContent = email.validity.valueMissing
+        ? 'Please enter your email address.'
+        : 'Please enter a valid email address.';
+      if (email.validity.valid) {
+        email.removeAttribute('aria-invalid');
+      } else {
+        email.setAttribute('aria-invalid', 'true');
+      }
+    }
+
+    email.addEventListener('blur', showEmailValidity);
+    email.addEventListener('invalid', showEmailValidity);
+    email.addEventListener('input', () => {
+      signupStatus.hidden = true;
+      if (email.hasAttribute('aria-invalid')) showEmailValidity();
+    });
+
+    mailingList.addEventListener('submit', (event) => {
+      event.preventDefault();
+      signupStatus.hidden = false;
+    });
+  </script>
+
 </body>
 
 </html>
