+  <script>
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-level');
+    const progress = document.getElementById('setup-progress');
+    const completion = document.getElementById('completion-text');
+    const roastDescription = document.getElementById('roast-description');
+    const result = document.getElementById('subscription-result');
+    const roastNames = ['Light', 'Medium-light', 'Medium', 'Medium-dark', 'Dark'];
+
+    function updateSetup() {
+      const roastName = roastNames[Number(roast.value) - 1];
+      roastDescription.value = roastName;
+      document.getElementById('roast-hint').textContent = `${roastName} is selected. Adjust to suit your taste.`;
+      roast.setAttribute('aria-valuetext', roastName);
+      roast.style.setProperty('--roast-fill', `${(Number(roast.value) - 1) * 25}%`);
+      const complete = 1 + Number(email.value.trim() !== '' && email.validity.valid) + Number(Boolean(form.querySelector('input[name="frequency"]:checked')));
+      progress.value = complete;
+      progress.textContent = `${Math.round(complete / 3 * 100)}% complete`;
+      completion.textContent = `${complete} of 3 ready`;
+      result.textContent = '';
+    }
+
+    form.addEventListener('input', updateSetup);
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const frequency = form.querySelector('input[name="frequency"]:checked').value;
+      const updates = document.getElementById('email-updates').checked ? 'Email offers selected.' : 'Email offers declined.';
+      result.textContent = `Your preferences are ready: ${roastDescription.value.toLowerCase()} roast, delivered ${frequency}. ${updates} This preview has not started a subscription.`;
+    });
+    updateSetup();
+  </script>
