+  <script>
+    const themeToggle = document.getElementById('theme-toggle');
+    const systemTheme = matchMedia('(prefers-color-scheme: dark)');
+    function syncThemeButton() {
+      const dark = document.documentElement.dataset.theme
+        ? document.documentElement.dataset.theme === 'dark' : systemTheme.matches;
+      themeToggle.setAttribute('aria-pressed', String(dark));
+    }
+    themeToggle.addEventListener('click', () => {
+      const theme = themeToggle.getAttribute('aria-pressed') === 'true' ? 'light' : 'dark';
+      document.documentElement.dataset.theme = theme;
+      try { localStorage.setItem('daily-grind-theme', theme); } catch { /* The toggle still works without persistence. */ }
+      syncThemeButton();
+    });
+    systemTheme.addEventListener('change', syncThemeButton);
+    syncThemeButton();
+
+    const form = document.getElementById('subscription-form');
+    const email = document.getElementById('subscription-email');
+    const roast = document.getElementById('roast-preference');
+    const consent = document.getElementById('receive-emails');
+    const progress = document.getElementById('setup-progress');
+    const status = document.getElementById('save-status');
+    const roasts = [
+      ['Light', 'Bright and delicate, with lively fruity notes.'],
+      ['Medium-light', 'Fresh and mellow, with a gentle sweetness.'],
+      ['Medium', 'Balanced and smooth, with a rounded sweetness.'],
+      ['Medium-dark', 'Rich and full-bodied, with warm chocolate notes.'],
+      ['Dark', 'Bold and deep, with a lingering roasted finish.']
+    ];
+
+    function updateSetup() {
+      const [name, description] = roasts[Number(roast.value) - 1];
+      document.getElementById('roast-value').value = name;
+      document.getElementById('roast-description').textContent = description;
+      roast.setAttribute('aria-valuetext', name);
+      roast.style.setProperty('--range-fill', `${(Number(roast.value) - 1) * 25}%`);
+      const frequency = form.querySelector('input[name="frequency"]:checked');
+      form.querySelectorAll('.choice').forEach(label => {
+        label.classList.toggle('selected', label.querySelector('input').checked);
+      });
+      // The roast has a valid default. Optional marketing consent never affects completion.
+      const completed = Number(email.value.trim() !== '' && email.validity.valid) + Number(Boolean(frequency)) + 1;
+      progress.value = completed;
+      progress.textContent = `${completed} of 3 complete`;
+      document.getElementById('setup-count').textContent = `${completed} of 3 complete`;
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem('daily-grind-subscription'));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.email === 'string') email.value = saved.email;
+        if (Number.isInteger(saved.roast) && saved.roast >= 1 && saved.roast <= 5) roast.value = saved.roast;
+        const frequency = [...form.querySelectorAll('input[name="frequency"]')].find(input => input.value === saved.frequency);
+        if (frequency) frequency.checked = true;
+        consent.checked = saved.receiveEmails === true;
+      }
+    } catch { /* Ignore unavailable storage or invalid saved preferences. */ }
+
+    form.addEventListener('input', () => { status.textContent = ''; updateSetup(); });
+    form.addEventListener('change', updateSetup);
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+      const preferences = {
+        email: email.value.trim(),
+        frequency: form.querySelector('input[name="frequency"]:checked').value,
+        roast: Number(roast.value),
+        receiveEmails: consent.checked
+      };
+      try {
+        localStorage.setItem('daily-grind-subscription', JSON.stringify(preferences));
+        status.textContent = 'Your coffee preferences are saved on this device. You can update them anytime.';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please allow site storage and try again.';
+      }
+      updateSetup();
+    });
+    updateSetup();
+  </script>
+
