+import { ml_dsa65 } from '@noble/post-quantum/ml-dsa.js';
+export const encode = bytes => btoa(Array.from(bytes, b => String.fromCharCode(b)).join(''));
+export const decode = value => Uint8Array.from(atob(value.trim()), c => c.charCodeAt(0));
+export async function generateKey(algorithm) {
+  if (algorithm === 'ML-DSA') return { algorithm, ...ml_dsa65.keygen() };
+  if (algorithm !== 'ECDSA') throw new Error('Unsupported algorithm');
+  const pair = await crypto.subtle.generateKey({ name: 'ECDSA', namedCurve: 'P-256' }, true, ['sign', 'verify']);
+  return { algorithm, ...pair, publicBytes: new Uint8Array(await crypto.subtle.exportKey('raw', pair.publicKey)) };
+}
+export function publicBytes(key) { return key.algorithm === 'ML-DSA' ? key.publicKey : key.publicBytes; }
+export async function signContent(key, content) {
+  if (key.algorithm === 'ML-DSA') return ml_dsa65.sign(content, key.secretKey);
+  return new Uint8Array(await crypto.subtle.sign({ name: 'ECDSA', hash: 'SHA-256' }, key.privateKey, content));
+}
+export async function verifyContent(algorithm, publicKey, signature, content) {
+  if (algorithm === 'ML-DSA') return ml_dsa65.verify(signature, content, publicKey);
+  if (algorithm !== 'ECDSA') throw new Error('Unsupported algorithm');
+  const key = await crypto.subtle.importKey('raw', publicKey, { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
+  return crypto.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, signature, content);
+}
+export async function fingerprint(key) {
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', publicBytes(key)));
+  return Array.from(digest.slice(0, 12), b => b.toString(16).padStart(2, '0')).join(':');
+}
+export async function importKeyPair(data) {
+  if (data.format !== 'cipher-key-pair-v1' || typeof data.publicKey !== 'string') throw new Error('Invalid Cipher key pair.');
+  const supplied = decode(data.publicKey);
+  let key;
+  if (data.algorithm === 'ML-DSA') {
+    const secretKey = decode(data.privateKey);
+    key = { algorithm:data.algorithm, secretKey, publicKey:ml_dsa65.getPublicKey(secretKey) };
+  } else if (data.algorithm === 'ECDSA') {
+    const privateKey = await crypto.subtle.importKey('jwk', data.privateKey, { name:'ECDSA', namedCurve:'P-256' }, true, ['sign']);
+    const jwk = await crypto.subtle.exportKey('jwk', privateKey);
+    const publicKey = await crypto.subtle.importKey('jwk', { kty:jwk.kty, crv:jwk.crv, x:jwk.x, y:jwk.y, ext:true }, { name:'ECDSA', namedCurve:'P-256' }, true, ['verify']);
+    key = { algorithm:data.algorithm, privateKey, publicKey, publicBytes:new Uint8Array(await crypto.subtle.exportKey('raw', publicKey)) };
+  } else throw new Error('Unsupported key algorithm.');
+  const derived = publicBytes(key);
+  if (derived.length !== supplied.length || derived.some((b, i) => b !== supplied[i])) throw new Error('Public and private keys do not match.');
+  const challenge = crypto.getRandomValues(new Uint8Array(32));
+  if (!await verifyContent(key.algorithm, derived, await signContent(key, challenge), challenge)) throw new Error('Invalid key pair.');
+  return key;
+}
