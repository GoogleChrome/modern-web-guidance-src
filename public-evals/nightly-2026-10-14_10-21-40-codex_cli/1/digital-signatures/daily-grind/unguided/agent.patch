+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { generateKey, importKeyPair, publicBytes, signContent, verifyContent, encode, decode } from './crypto.js';
+for (const algorithm of ['ECDSA', 'ML-DSA']) {
+  test(`${algorithm}: sign and verify text and binary artifacts, reject tampering and wrong keys`, async () => {
+    const key = await generateKey(algorithm), other = await generateKey(algorithm);
+    for (const content of [new TextEncoder().encode('Trust is good. Cryptographic proof is better.'), new Uint8Array([0, 255, 127, 13, 10])]) {
+      const signature = await signContent(key, content);
+      assert.equal(await verifyContent(algorithm, decode(encode(publicBytes(key))), decode(encode(signature)), content), true);
+      const changed = content.slice(); changed[0] ^= 1;
+      assert.equal(await verifyContent(algorithm, publicBytes(key), signature, changed), false);
+      assert.equal(await verifyContent(algorithm, publicBytes(other), signature, content), false);
+    }
+  });
+}
+
+for (const algorithm of ['ECDSA', 'ML-DSA']) {
+  test(`${algorithm}: exported keys can be restored and mismatched key pairs are rejected`, async () => {
+    const key = await generateKey(algorithm), other = await generateKey(algorithm);
+    const data = { format:'cipher-key-pair-v1', algorithm, publicKey:encode(publicBytes(key)), privateKey:algorithm === 'ML-DSA' ? encode(key.secretKey) : await crypto.subtle.exportKey('jwk', key.privateKey) };
+    const restored = await importKeyPair(data);
+    const content = new TextEncoder().encode('Restored identity');
+    assert.equal(await verifyContent(algorithm, publicBytes(key), await signContent(restored, content), content), true);
+    await assert.rejects(importKeyPair({ ...data, publicKey:encode(publicBytes(other)) }));
+  });
+}
