+import { createIcons, icons } from 'lucide';
+import { generateKey, importKeyPair, publicBytes, signContent, verifyContent, fingerprint, encode, decode } from './crypto.js';
+const $ = id => document.getElementById(id);
+const refreshIcons = () => createIcons({ icons, attrs: { 'stroke-width': 1.7 } });
+const keys = [], activity = [];
+let algorithm = 'ECDSA', mode = 'sign', contentType = 'message', currentFile = null, lastBundle = null, toastTimer;
+const safe = value => String(value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function toast(message) { $('toast').textContent = message; $('toast').classList.remove('hidden'); clearTimeout(toastTimer); toastTimer = setTimeout(() => $('toast').classList.add('hidden'), 4500); }
+function download(data, filename) { const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type:'application/json' })); const a = document.createElement('a'); a.href = url; a.download = filename; a.click(); setTimeout(() => URL.revokeObjectURL(url), 1000); }
+function log(action, detail) { activity.unshift({ action, detail, time:new Date().toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' }) }); renderActivity(); }
