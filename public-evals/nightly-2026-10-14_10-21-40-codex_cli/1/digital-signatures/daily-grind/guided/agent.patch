@@ -0,0 +1,20 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { generate, sign, verify, publicBytes, fingerprint, encode, decode, privateExport } from './crypto.js';
+for (const algorithm of ['ECDSA P-256','ML-DSA-65']) {
+ test(`${algorithm}: text and binary signatures reject tampering and wrong keys`,async()=>{
+  const key=await generate(algorithm);const other=await generate(algorithm);const pub=await publicBytes(key);
+  for(const message of [new TextEncoder().encode('A token: eyJ.test.✓'),new Uint8Array([0,255,128,42,0,1])]){
+   const signature=await sign(key,message);
+   assert.equal(await verify(algorithm,decode(encode(pub)),decode(encode(signature)),message),true);
+   const modified=message.slice();modified[0]^=1;
+   assert.equal(await verify(algorithm,pub,signature,modified),false);
+   assert.equal(await verify(algorithm,await publicBytes(other),signature,message),false);
+   const alteredSig=signature.slice();alteredSig[0]^=1;
+   assert.equal(await verify(algorithm,pub,alteredSig,message),false);
+  }
+  assert.match(await fingerprint(pub),/^([a-f0-9]{2}:){7}[a-f0-9]{2}$/);
+  assert.ok(decode(await privateExport(key)).length>0);
+ });
+}
+test('unknown algorithms are rejected',async()=>{await assert.rejects(()=>generate('fake'));await assert.rejects(()=>verify('fake',new Uint8Array(),new Uint8Array(),new Uint8Array()));});
