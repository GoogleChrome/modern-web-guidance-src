@@ -0,0 +1,29 @@
+import { ml_dsa65 } from '@noble/post-quantum/ml-dsa.js';
+export const encode = (bytes) => btoa(Array.from(bytes, b => String.fromCharCode(b)).join(''));
+export const decode = (text) => Uint8Array.from(atob(text.trim()), c => c.charCodeAt(0));
+export async function generate(algorithm) {
+  if (algorithm === 'ML-DSA-65') return { algorithm, ...ml_dsa65.keygen() };
+  if (algorithm !== 'ECDSA P-256') throw new Error('Unsupported algorithm.');
+  const pair = await crypto.subtle.generateKey({name:'ECDSA', namedCurve:'P-256'}, true, ['sign','verify']);
+  return { algorithm, secretKey: pair.privateKey, publicKey: pair.publicKey };
+}
+export async function publicBytes(key) {
+  return key.algorithm === 'ML-DSA-65' ? key.publicKey : new Uint8Array(await crypto.subtle.exportKey('spki', key.publicKey));
+}
+export async function privateExport(key) {
+  return key.algorithm === 'ML-DSA-65' ? encode(key.secretKey) : encode(new Uint8Array(await crypto.subtle.exportKey('pkcs8', key.secretKey)));
+}
+export async function sign(key, message) {
+  if (key.algorithm === 'ML-DSA-65') return ml_dsa65.sign(message, key.secretKey);
+  return new Uint8Array(await crypto.subtle.sign({name:'ECDSA',hash:'SHA-256'}, key.secretKey, message));
+}
+export async function verify(algorithm, publicKey, signature, message) {
+  if (algorithm === 'ML-DSA-65') return ml_dsa65.verify(signature, message, publicKey);
+  if (algorithm !== 'ECDSA P-256') throw new Error('Unsupported algorithm.');
+  const key = await crypto.subtle.importKey('spki', publicKey, {name:'ECDSA',namedCurve:'P-256'}, false, ['verify']);
+  return crypto.subtle.verify({name:'ECDSA',hash:'SHA-256'}, key, signature, message);
+}
+export async function fingerprint(bytes) {
+  const hash = new Uint8Array(await crypto.subtle.digest('SHA-256', bytes));
+  return Array.from(hash.slice(0,8), b=>b.toString(16).padStart(2,'0')).join(':');
+}
