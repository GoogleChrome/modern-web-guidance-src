@@ -0,0 +1,247 @@
+/* Layer order is the cascade contract: utilities intentionally win over components. */
+@layer reset, tokens, base, layout, components, utilities;
+
+@layer reset {
+  :where(*, *::before, *::after) { box-sizing: border-box; }
+  :where(body, h1, h2, h3, p, ul) { margin: 0; }
+  :where(ul) { padding: 0; list-style: none; }
+  :where(img, svg) { display: block; }
+  :where(img) { max-inline-size: 100%; }
+  :where(a) { color: inherit; text-decoration: none; }
+}
+
+@layer tokens {
+  :root {
+    /* Primitive palette, followed by semantic roles. */
+    --cream-50: #fbf9f3;
+    --cream-100: #f3efe5;
+    --cream-200: #e6e0d2;
+    --green-700: #234438;
+    --green-800: #183329;
+    --sage-500: #65765b;
+    --ink-900: #252c25;
+    --ink-500: #65695e;
+    --color-page: var(--cream-50);
+    --color-surface: var(--cream-100);
+    --color-text: var(--ink-900);
+    --color-muted: var(--ink-500);
+    --color-brand: var(--green-700);
+    --color-brand-hover: var(--green-800);
+    --color-border: var(--cream-200);
+    --color-on-brand: var(--cream-50);
+    --font-body: 'Segoe UI', Arial, sans-serif;
+    --font-display: Georgia, 'Times New Roman', serif;
+    --text-xs: 0.65rem;
+    --text-sm: 0.8rem;
+    --text-base: 0.9375rem;
+    --text-lg: 1.125rem;
+    --space-1: 0.25rem;
+    --space-2: 0.5rem;
+    --space-3: 0.75rem;
+    --space-4: 1rem;
+    --space-5: 1.5rem;
+    --space-6: 2rem;
+    --space-7: 3rem;
+    --space-8: 4rem;
+    --space-9: 5rem;
+    --page-width: 1200px;
+    --page-gutter: clamp(1.25rem, 5.2vw, 5rem);
+    --radius-sm: 0.2rem;
+    --radius-pill: 999px;
+    --motion-fast: 180ms;
+    --layer-header: 10;
+  }
+}
+
+@layer base {
+  html { scroll-padding-block-start: 7rem; }
+  body {
+    background: var(--color-page);
+    color: var(--color-text);
+    font-family: var(--font-body);
+    font-size: var(--text-base);
+    line-height: 1.65;
+    -webkit-font-smoothing: antialiased;
+  }
+  :where(h1, h2, h3) { font-family: var(--font-display); font-weight: 400; line-height: 1.12; }
+  :where(a) {
+    transition: color var(--motion-fast), background-color var(--motion-fast);
+    &:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
+  }
+  ::selection { background: var(--color-brand); color: var(--color-on-brand); }
+}
+
+@layer layout {
+  .page-width { inline-size: min(var(--page-width), 100% - var(--page-gutter) * 2); margin-inline: auto; }
+  .hero { display: grid; grid-template-columns: 1fr 1fr; min-block-size: 570px; }
+  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); }
+  @media (width < 760px) {
+    .hero { grid-template-columns: 1fr; }
+    .product-grid { grid-template-columns: 1fr; gap: var(--space-7); }
+  }
+}
+
+@layer components {
+  .site-header {
+    position: sticky;
+    inset-block-start: 0;
+    z-index: var(--layer-header);
+    background: var(--color-page);
+    border-block-end: 1px solid var(--color-border);
+  }
+  .navigation {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: var(--space-6);
+    min-block-size: 94px;
+    padding-block: var(--space-4);
+    font-size: var(--text-sm);
+    & .navigation-links { display: flex; gap: var(--space-6); }
+    & .account-links { display: flex; align-items: center; gap: var(--space-5); }
+    & .account-link { display: flex; align-items: center; gap: var(--space-2); }
+    & .account-link svg { inline-size: 18px; block-size: 18px; }
+    & .logout-link { border: 1px solid var(--color-border); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-4); }
+    & a:hover { color: var(--sage-500); }
+    & .logout-link span { margin-inline-start: var(--space-3); }
+    @media (width < 1000px) { gap: var(--space-4); & .navigation-links { gap: var(--space-4); } & .account-links { gap: var(--space-3); } }
+    @media (width < 760px) {
+      flex-wrap: wrap;
+      gap: var(--space-4);
+      & .navigation-links { order: 3; flex-basis: 100%; justify-content: center; gap: var(--space-7); }
+      & .account-link { font-size: 0; gap: 0; padding: var(--space-2); }
+      & .logout-link { padding: var(--space-2) var(--space-3); }
+    }
+  }
+  .wordmark {
+    display: flex;
+    align-items: center;
+    gap: var(--space-3);
+    color: var(--color-brand);
+    font-size: 1rem;
+    font-weight: 750;
+    letter-spacing: 0.065em;
+    line-height: 1.4;
+    & .brand-icon { inline-size: 36px; block-size: 40px; }
+    & .wordmark-caption { display: block; margin-block-start: var(--space-1); font-size: 0.5rem; letter-spacing: 0.2em; font-weight: 500; }
+    @media (width < 400px) { font-size: var(--text-sm); gap: var(--space-2); & .brand-icon { inline-size: 28px; } }
+  }
+  .eyebrow { color: var(--color-brand); font-size: var(--text-xs); font-weight: 650; letter-spacing: 0.18em; }
+  .button {
+    display: inline-flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: var(--space-7);
+    background: var(--color-brand);
+    color: var(--color-on-brand);
+    border-radius: var(--radius-sm);
+    padding: 0.9rem var(--space-5);
+    font-size: var(--text-sm);
+    &:hover { background: var(--color-brand-hover); }
+    & span { font-size: var(--text-lg); }
+  }
+  .text-link {
+    display: inline-flex;
+    align-items: center;
+    gap: var(--space-5);
+    font-size: var(--text-sm);
+    color: var(--color-brand);
+    & span { font-size: var(--text-lg); }
+    &:hover { text-decoration: underline; text-underline-offset: 5px; }
+  }
+  /* Section typography stays inside its component scope. */
+  .hero-copy { padding: var(--space-9) var(--space-7) var(--space-7) max(var(--page-gutter), calc((100vw - var(--page-width)) / 2)); }
+  @scope (.hero) {
+    h1 { margin-block: var(--space-5); font-size: clamp(3.75rem, 5.65vw, 5.5rem); letter-spacing: -0.055em; color: var(--color-brand); }
+    h1 em { color: var(--sage-500); font-weight: 400; }
+  }
+  .hero-copy {
+    & .eyebrow { display: flex; align-items: center; gap: var(--space-3); }
+    & .small-line { inline-size: 26px; block-size: 1px; background: currentColor; }
+    & .hero-description { color: var(--color-muted); font-size: var(--text-lg); line-height: 1.7; }
+    & .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5); margin-block-start: var(--space-6); }
+    & .hero-note { display: flex; align-items: center; gap: var(--space-3); margin-block-start: var(--space-7); font-size: 0.7rem; color: var(--color-muted); line-height: 1.6; }
+    & .hero-note strong { font-weight: 400; }
+    & .note-icon { color: var(--sage-500); font-size: 2rem; }
+    @media (width < 760px) { padding: var(--space-7) var(--page-gutter); & h1 { font-size: clamp(3.7rem, 12vw, 5rem); } }
+  }
+  .hero-image {
+    position: relative;
+    min-inline-size: 0;
+    background: var(--color-brand);
+    & > img { inline-size: 100%; block-size: 100%; position: absolute; object-fit: cover; object-position: 48% center; }
+    & .roast-stamp { position: absolute; inset-block-start: var(--space-6); inset-inline-end: var(--space-6); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-1); inline-size: 118px; aspect-ratio: 1; border: 1px solid var(--cream-100); border-radius: 50%; color: var(--cream-100); background: rgb(35 68 56 / 80%); transform: rotate(12deg); font-size: 0.5rem; letter-spacing: 0.13em; }
+    & .stamp-symbol { font-size: 2.4rem; line-height: 1.2; }
