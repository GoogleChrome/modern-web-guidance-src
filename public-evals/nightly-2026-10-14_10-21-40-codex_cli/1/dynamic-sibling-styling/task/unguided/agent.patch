+  <script>
+    // Recalculate on insertion, removal, or class changes, including new containers.
+    // Only matching items are counted; decorative content never affects the layout.
+    const groups = [
+      ['.grid', '.spectrum-card'],
+      ['.fan-container', '.fan-card'],
+      ['.circle-container', '.circle-orb']
+    ];
+
+    function updateCollections() {
+      for (const [containerSelector, itemSelector] of groups) {
+        document.querySelectorAll(containerSelector).forEach(container => {
+          const items = Array.from(container.children).filter(item => item.matches(itemSelector));
+          container.style.setProperty('--layout-count', items.length);
+          items.forEach((item, index) => {
+            item.style.setProperty('--item-index', index + 1);
+            item.style.setProperty('--item-count', items.length);
+          });
+        });
+      }
+    }
+
+    updateCollections();
+    new MutationObserver(updateCollections).observe(document.body, {
+      childList: true,
+      subtree: true,
+      attributes: true,
+      attributeFilter: ['class']
+    });
+  </script>
 </body>
 
