+  <script>
+    // Native CSS updates automatically; older browsers get the same live counts.
+    if (!CSS.supports('top: calc(sibling-index() * 1px)') ||
+        !CSS.supports('top: calc(sibling-count() * 1px)')) {
+      const syncSiblings = () => {
+        document.querySelectorAll('.spectrum-card, .fan-card, .circle-orb').forEach(item => {
+          const siblings = Array.from(item.parentElement.children);
+          item.style.setProperty('--sibling-index', siblings.indexOf(item) + 1);
+          item.style.setProperty('--sibling-count', siblings.length);
+        });
+      };
+      syncSiblings();
+      new MutationObserver(syncSiblings).observe(document.querySelector('main'), {
+        childList: true,
+        subtree: true
+      });
+    }
+  </script>
+
