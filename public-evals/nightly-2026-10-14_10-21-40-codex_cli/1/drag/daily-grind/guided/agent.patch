     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <aside class="floating-card" aria-label="Coffee to go">
+    <button class="drag-handle" type="button" aria-label="Move coffee card. Drag or use arrow keys.">
+      <span>Drag to move</span><span aria-hidden="true">⠿</span>
+    </button>
+    <div class="floating-card-content">
+      <h3>Your next cup awaits</h3>
+      <p>A little pick-me-up, wherever your day takes you.</p>
+      <a href="/order-online" class="btn">Order a coffee</a>
+    </div>
+  </aside>
+
+  <script>
+    const floatingCard = document.querySelector('.floating-card');
+    const dragHandle = floatingCard.querySelector('.drag-handle');
+    let activePointer = null;
+    let offsetX = 0;
+    let offsetY = 0;
+
+    function moveTo(left, top) {
+      const maxLeft = Math.max(0, window.innerWidth - floatingCard.offsetWidth);
+      const maxTop = Math.max(0, window.innerHeight - floatingCard.offsetHeight);
+      floatingCard.style.left = `${Math.max(0, Math.min(left, maxLeft))}px`;
+      floatingCard.style.top = `${Math.max(0, Math.min(top, maxTop))}px`;
+      floatingCard.style.right = 'auto';
+      floatingCard.style.bottom = 'auto';
+    }
+
+    function keepInView() {
+      const rect = floatingCard.getBoundingClientRect();
+      moveTo(rect.left, rect.top);
+    }
+
+    dragHandle.addEventListener('pointerdown', (event) => {
+      if (event.button !== 0 || !event.isPrimary || activePointer !== null) return;
+      const rect = floatingCard.getBoundingClientRect();
+      offsetX = event.clientX - rect.left;
+      offsetY = event.clientY - rect.top;
+      dragHandle.setPointerCapture(event.pointerId);
+      activePointer = event.pointerId;
+      dragHandle.classList.add('dragging');
+    });
+
+    dragHandle.addEventListener('pointermove', (event) => {
+      if (event.pointerId !== activePointer) return;
+      moveTo(event.clientX - offsetX, event.clientY - offsetY);
+    });
+
+    function endDrag(event) {
+      if (event.pointerId !== activePointer) return;
+      activePointer = null;
+      dragHandle.classList.remove('dragging');
+      if (dragHandle.hasPointerCapture(event.pointerId)) {
+        dragHandle.releasePointerCapture(event.pointerId);
+      }
+    }
+
+    dragHandle.addEventListener('pointerup', endDrag);
+    dragHandle.addEventListener('pointercancel', endDrag);
+    dragHandle.addEventListener('lostpointercapture', endDrag);
+    dragHandle.addEventListener('keydown', (event) => {
+      const steps = { ArrowLeft: [-15, 0], ArrowRight: [15, 0], ArrowUp: [0, -15], ArrowDown: [0, 15] };
+      const step = steps[event.key];
+      if (!step) return;
+      event.preventDefault();
+      const rect = floatingCard.getBoundingClientRect();
+      moveTo(rect.left + step[0], rect.top + step[1]);
+    });
+
+    floatingCard.classList.add('drag-ready');
+    window.addEventListener('resize', keepInView);
+    new ResizeObserver(keepInView).observe(floatingCard);
+    keepInView();
+  </script>
+
 </body>
 
