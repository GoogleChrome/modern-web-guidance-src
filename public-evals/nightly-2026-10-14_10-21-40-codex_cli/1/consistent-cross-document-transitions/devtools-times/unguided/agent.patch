diff --git a/src/scripts/page-ready.js b/src/scripts/page-ready.js
new file mode 100644
index 0000000..f68af6c
--- /dev/null
+++ b/src/scripts/page-ready.js
@@ -0,0 +1,32 @@
+// This module runs from a render-blocking script in the shared document head.
+// Async island hydration can outlive script execution, so also guard snapshots.
+let ready = false;
+const guardTransition = (event) => {
+  if (!ready) event.viewTransition?.skipTransition();
+};
+window.addEventListener("pagereveal", guardTransition);
+window.addEventListener("pageswap", guardTransition);
+
+if (document.readyState === "loading") {
+  await new Promise((resolve) => {
+    document.addEventListener("DOMContentLoaded", resolve, { once: true });
+  });
+}
+
+// client:load islands power the initial UI. Lazy islands initialize on visibility
+// and must not hold up rendering (including content below the fold).
+const hydration = Array.from(
+  document.querySelectorAll('astro-island[client="load"][ssr]'),
+  (island) => new Promise((resolve) => {
+    island.addEventListener("astro:hydrate", resolve, { once: true });
+  }),
+);
+
+// Loading the stylesheet alone does not load the headline font. Request it
+// explicitly before checking readiness to prevent a font swap in the snapshot.
+const fonts = document.fonts.load('500 1em "Grenze"');
+Promise.all([...hydration, fonts]).then(() => {
+  ready = true;
+}).catch(() => {
+  // Leave transitions disabled if a critical resource fails; the page still loads.
+});
