diff --git a/tests/page-ready.test.mjs b/tests/page-ready.test.mjs
new file mode 100644
index 0000000..56b2422
--- /dev/null
+++ b/tests/page-ready.test.mjs
@@ -0,0 +1,70 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+
+const source = await readFile(new URL('../src/scripts/page-ready.js', import.meta.url), 'utf8');
+const run = new (Object.getPrototypeOf(async function () {}).constructor)('window', 'document', source);
+const tick = () => new Promise((resolve) => setImmediate(resolve));
+
+function page({ islands = [], fonts = Promise.resolve([]), loading = false } = {}) {
+  const window = new EventTarget();
+  const document = Object.assign(new EventTarget(), {
+    readyState: loading ? 'loading' : 'interactive',
+    querySelectorAll(selector) {
+      assert.equal(selector, 'astro-island[client="load"][ssr]');
+      assert.notEqual(this.readyState, 'loading');
+      return islands;
+    },
+    fonts: { load: () => fonts },
+  });
+  const skipped = (type) => {
+    let count = 0;
+    const event = new Event(type);
+    event.viewTransition = { skipTransition: () => count++ };
+    window.dispatchEvent(event);
+    return count;
+  };
+  return { window, document, skipped };
+}
+
+test('skips both snapshots until critical hydration and fonts finish', async () => {
+  const island = new EventTarget();
+  let loadFont;
+  const context = page({ islands: [island], fonts: new Promise((resolve) => { loadFont = resolve; }) });
+  await run(context.window, context.document);
+  assert.equal(context.skipped('pagereveal'), 1);
+  assert.equal(context.skipped('pageswap'), 1);
+  island.dispatchEvent(new Event('astro:hydrate'));
+  await tick();
+  assert.equal(context.skipped('pagereveal'), 1);
+  loadFont([]);
+  await tick();
+  assert.equal(context.skipped('pagereveal'), 0);
+  assert.equal(context.skipped('pageswap'), 0);
+});
+
+test('waits for parsing before discovering critical islands', async () => {
+  const context = page({ loading: true });
+  const running = run(context.window, context.document);
+  assert.equal(context.skipped('pagereveal'), 1);
+  context.document.readyState = 'interactive';
+  context.document.dispatchEvent(new Event('DOMContentLoaded'));
+  await running;
+  await tick();
+  assert.equal(context.skipped('pagereveal'), 0);
+});
+
+test('failed font loading leaves transitions disabled without throwing', async () => {
+  const context = page({ fonts: Promise.reject(new Error('Font unavailable')) });
+  await run(context.window, context.document);
+  await tick();
+  assert.equal(context.skipped('pagereveal'), 1);
+  context.window.dispatchEvent(new Event('pagereveal'));
+});
+
+test('a critical island that never hydrates keeps transitions disabled', async () => {
+  const context = page({ islands: [new EventTarget()] });
+  await run(context.window, context.document);
+  await tick();
+  assert.equal(context.skipped('pagereveal'), 1);
+});
