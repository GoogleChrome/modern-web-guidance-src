+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const listbox = document.getElementById('roast-options');
+    const options = Array.from(listbox.querySelectorAll('[role="option"]'));
+    const summary = trigger.querySelector('.roast-summary');
+    const order = document.getElementById('hero-order');
+    let selected = 0;
+    let active = 0;
+
+    function activate(index) {
+      active = index;
+      options.forEach((option, i) => option.classList.toggle('is-active', i === active));
+      trigger.setAttribute('aria-activedescendant', options[active].id);
+    }
+
+    function closePicker() {
+      listbox.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.removeAttribute('aria-activedescendant');
+    }
+
+    function openPicker() {
+      listbox.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      activate(selected);
+    }
+
+    function select(index) {
+      selected = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === selected)));
+      summary.replaceChildren(...Array.from(options[selected].children, child => child.cloneNode(true)));
+      order.href = '/order-online?roast=' + encodeURIComponent(options[selected].dataset.roast);
+      closePicker();
+    }
+
+    trigger.addEventListener('click', () => listbox.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', event => {
+      if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        const wasClosed = listbox.hidden;
+        if (wasClosed) openPicker();
+        if (event.key === 'Home') activate(0);
+        else if (event.key === 'End') activate(options.length - 1);
+        else if (!wasClosed) activate((active + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length);
+      } else if ((event.key === 'Enter' || event.key === ' ') && !listbox.hidden) {
+        event.preventDefault();
+        select(active);
+      } else if (event.key === 'Escape' && !listbox.hidden) {
+        event.preventDefault();
+        closePicker();
+      } else if (event.key === 'Tab') {
+        closePicker();
+      }
+    });
+
+    options.forEach((option, index) => {
+      option.addEventListener('pointerenter', () => activate(index));
+      option.addEventListener('click', () => {
+        select(index);
+        trigger.focus();
+      });
+    });
+    document.addEventListener('pointerdown', event => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+    select(0);
+  </script>
 </body>
 
