+      mask-image: radial-gradient(circle at var(--mouse-x) var(--mouse-y),
+          black var(--inner-size), transparent var(--outer-size));
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .product-card {
+        transition-duration: 0s;
+      }
+    }
