+    .product-card {
+      --mouse-x: 50%;
+      --mouse-y: 50%;
+      --inner-size: 0px;
+      --outer-size: 0px;
+      position: relative;
+      isolation: isolate;
+      overflow: hidden;
+      transition: --inner-size 250ms ease, --outer-size 250ms ease;
+    }
+
+    .product-card:hover {
+      --inner-size: 70px;
