+
+    .product-card > :not(.spotlight-overlay) {
+      position: relative;
+      z-index: 1;
+    }
+
+    .spotlight-overlay {
+      position: absolute;
+      inset: 0;
+      z-index: 0;
+      pointer-events: none;
+      border-radius: inherit;
+      background:
