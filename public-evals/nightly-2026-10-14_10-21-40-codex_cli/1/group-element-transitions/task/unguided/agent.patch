+  <script>
+    const beanList = document.querySelector('#bean-list');
+    const beanForm = document.querySelector('#bean-form');
+    const beanName = document.querySelector('#bean-name');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextBeanId = 4;
+    let activeTransition;
+
+    function updateBeans(update) {
+      // Interrupt an older animation so repeated clicks are handled immediately.
+      activeTransition?.skipTransition();
+      if (reducedMotion.matches || !document.startViewTransition ||
+          !CSS.supports('view-transition-class', 'bean-item')) {
+        update();
+        return;
+      }
+      const transition = document.startViewTransition(update);
+      activeTransition = transition;
+      // Skipping a transition rejects ready, but still performs its DOM update.
+      transition.ready.catch(() => {});
+      transition.finished.finally(() => {
+        if (activeTransition === transition) activeTransition = undefined;
+      }).catch(() => {});
+    }
+
+    reducedMotion.addEventListener('change', () => {
+      if (reducedMotion.matches) activeTransition?.skipTransition();
+    });
+
+    beanForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const id = nextBeanId++;
+      const name = beanName.value.trim() || `Custom Blend ${id - 3}`;
+      const item = document.createElement('li');
+      item.className = 'item';
+      item.style.viewTransitionName = `bean-${id}`;
+      const label = document.createElement('span');
+      label.textContent = name;
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.className = 'remove-bean';
+      remove.textContent = 'Remove';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      item.append(label, remove);
+      beanName.value = '';
+      updateBeans(() => beanList.append(item));
+    });
+
+    beanList.addEventListener('click', (event) => {
+      const remove = event.target.closest('.remove-bean');
+      if (!remove) return;
+      const item = remove.closest('.item');
+      updateBeans(() => {
+        if (item.contains(document.activeElement)) {
+          const neighbor = item.nextElementSibling || item.previousElementSibling;
+          (neighbor?.querySelector('button') || beanForm.querySelector('button')).focus();
+        }
+        item.remove();
+      });
+    });
+  </script>
