+  <script>
+    const beanForm = document.querySelector('#bean-form');
+    const beanInput = document.querySelector('#bean-name');
+    const beanList = document.querySelector('#bean-list');
+    const beanStatus = document.querySelector('#bean-status');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    let nextBeanId = 4;
+    let activeTransition;
+    let pendingUpdate = Promise.resolve();
+
+    function updateBeans(update) {
+      // Serialize snapshot callbacks so rapid clicks always preserve every edit.
+      pendingUpdate = pendingUpdate.then(() => {
+        activeTransition?.skipTransition();
+        if (!document.startViewTransition || reducedMotion.matches) {
+          update();
+          return;
+        }
+        activeTransition = document.startViewTransition(update);
+        // An interrupted animation is expected when another edit arrives.
+        activeTransition.ready.catch(() => {});
+        return activeTransition.updateCallbackDone;
+      });
+    }
+
+    reducedMotion.addEventListener('change', (event) => {
+      if (event.matches) activeTransition?.skipTransition();
+    });
+
+    beanForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = beanInput.value.trim();
+      if (!name) {
+        beanInput.setCustomValidity('Enter a coffee bean name.');
+        beanInput.reportValidity();
+        return;
+      }
+
+      const item = document.createElement('li');
+      item.className = 'item';
+      item.style.viewTransitionName = `bean-${nextBeanId++}`;
+      const label = document.createElement('span');
+      label.textContent = name;
+      const remove = document.createElement('button');
+      remove.className = 'remove-bean';
+      remove.type = 'button';
+      remove.textContent = 'Remove';
+      remove.setAttribute('aria-label', `Remove ${name}`);
+      item.append(label, remove);
+      beanInput.value = '';
+      beanInput.focus();
+      updateBeans(() => {
+        beanList.append(item);
+        beanStatus.textContent = `${name} added.`;
+      });
+    });
+
+    beanInput.addEventListener('input', () => beanInput.setCustomValidity(''));
+
+    beanList.addEventListener('click', (event) => {
+      const button = event.target.closest('.remove-bean');
+      if (!button) return;
+      const item = button.closest('.item');
+      updateBeans(() => {
+        if (item.contains(document.activeElement)) {
+          const nextButton = (item.nextElementSibling || item.previousElementSibling)
+            ?.querySelector('button');
+          (nextButton || beanInput).focus();
+        }
+        item.remove();
+        beanStatus.textContent = `${item.querySelector('span').textContent} removed.`;
+      });
+    });
+  </script>
