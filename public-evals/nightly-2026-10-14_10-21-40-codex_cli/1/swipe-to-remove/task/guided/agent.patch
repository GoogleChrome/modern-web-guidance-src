+  <script>
+    const list = document.querySelector('.SwipeableList');
+    const count = document.querySelector('#cart-count');
+    const empty = document.querySelector('#cart-empty');
+    const status = document.querySelector('#cart-status');
+    const undo = document.querySelector('#cart-undo');
+    const removedItems = [];
+    const handles = new WeakMap();
+    const needsScrollWorkaround = !CSS.supports('scroll-initial-target', 'nearest');
+    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+
+    const resizeObserver = needsScrollWorkaround ? new ResizeObserver(entries => {
+      for (const entry of entries) {
+        const track = entry.target;
+        const handle = handles.get(track.closest('.SwipeableList-item'));
+        // Only reset horizontal position on width changes, never during collapse.
+        if (handle && handle.width !== track.clientWidth) {
+          handle.width = track.clientWidth;
+          track.scrollLeft = handle.width;
+        }
+      }
+    }) : null;
+
+    const viewportObserver = new IntersectionObserver(entries => {
+      for (const entry of entries) {
+        const item = entry.target;
+        if (item.classList.contains('is-removing')) continue;
+        if (entry.isIntersecting) {
+          const handle = handles.get(item) || setupItem(item);
+          handle.observer.observe(handle.content);
+        } else {
+          handles.get(item)?.observer.disconnect();
+        }
+      }
+    });
+
+    function setupItem(item) {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      item.classList.add('is-initialized');
+      // Center before observing so initialization cannot count as a swipe.
+      if (needsScrollWorkaround) track.scrollLeft = track.clientWidth;
+
+      const observer = new IntersectionObserver(entries => {
+        const entry = entries[entries.length - 1];
+        if (!entry.rootBounds || item.classList.contains('is-removing')) return;
+        const offset = entry.boundingClientRect.x - entry.rootBounds.x;
+        const direction = offset > 0 ? 'left' : 'right';
+        // 20% displacement gives feedback; 80% commits the removal.
+        if (entry.intersectionRatio < 0.2) {
+          removeItem(item, direction, entry);
+          return;
+        }
+        item.classList.toggle('is-activating', entry.intersectionRatio < 0.8);
+        if (Math.abs(offset) > 1) item.dataset.swipeDirection = direction;
+      }, { root: track, threshold: [0.2, 0.8] });
+
+      const handle = { observer, content, width: track.clientWidth };
+      handles.set(item, handle);
+      resizeObserver?.observe(track);
+      return handle;
+    }
+
+    function updateCart() {
+      const remaining = list.querySelectorAll('.SwipeableList-item:not(.is-removing)').length;
+      count.textContent = `${remaining} ${remaining === 1 ? 'item' : 'items'}`;
+      empty.hidden = remaining !== 0;
+    }
+
+    async function removeItem(item, direction = 'right', entry) {
+      if (item.classList.contains('is-removing')) return;
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      const clone = item.cloneNode(true);
+      clone.className = 'SwipeableList-item';
+      clone.removeAttribute('data-swipe-direction');
+      const next = item.nextElementSibling;
+      const hadFocus = item.contains(document.activeElement);
+      const rect = entry?.boundingClientRect || content.getBoundingClientRect();
+      const x = rect.x - (entry?.rootBounds.x ?? track.getBoundingClientRect().x);
+      const slide = direction === 'left' ? rect.width - x : -(rect.width + x);
+
+      viewportObserver.unobserve(item);
+      handles.get(item)?.observer.disconnect();
+      resizeObserver?.unobserve(track);
+      item.classList.add('is-removing');
+      item.dataset.swipeDirection = direction;
+      item.inert = true;
+      updateCart();
+
+      const options = { duration: reducedMotion.matches ? 0 : 300, easing: 'ease', fill: 'forwards' };
+      const animations = [
+        item.animate([{ height: `${item.getBoundingClientRect().height}px` }, { height: '0px' }], options),
+        content.animate([{ transform: 'translateX(0)' }, { transform: `translateX(${slide}px)` }], options)
+      ];
+      await Promise.allSettled(animations.map(animation => animation.finished));
+
+      removedItems.push({ clone, next });
+      status.textContent = `${item.dataset.name} removed from your cart.`;
+      undo.hidden = false;
+      if (hadFocus) {
+        const nextButton = list.querySelector('.SwipeableList-item:not(.is-removing) .cart-remove');
+        (nextButton || undo).focus({ preventScroll: true });
+      }
+      // Avoid Safari transferring the current swipe's momentum to the next row.
+      if (globalThis.GestureEvent && entry) setTimeout(() => item.remove(), 5000);
+      else item.remove();
+    }
+
+    list.addEventListener('click', event => {
+      const button = event.target.closest('.cart-remove');
+      if (button) removeItem(button.closest('.SwipeableList-item'));
+    });
+
+    undo.addEventListener('click', () => {
+      const record = removedItems.pop();
+      if (!record) return;
+      list.insertBefore(record.clone, record.next?.parentNode === list ? record.next : null);
+      status.textContent = `${record.clone.dataset.name} restored to your cart.`;
+      undo.hidden = removedItems.length === 0;
+      updateCart();
+      record.clone.querySelector('.cart-remove').focus({ preventScroll: true });
+    });
+
+    for (const item of list.children) viewportObserver.observe(item);
+    new MutationObserver(mutations => {
+      for (const mutation of mutations) {
+        for (const node of mutation.addedNodes) {
+          if (node.nodeType === Node.ELEMENT_NODE && node.matches('.SwipeableList-item')) {
+            viewportObserver.observe(node);
+          }
+        }
+      }
+    }).observe(list, { childList: true });
+  </script>
+
