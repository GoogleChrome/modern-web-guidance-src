+  <script>
+    const cart = document.querySelector('.SwipeableList');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function removeItem(item, direction = -1) {
+      if (item.classList.contains('is-removing')) return;
+      const content = item.querySelector('.SwipeableList-content');
+      const button = item.querySelector('.cart-remove');
+      const name = item.querySelector('h3').textContent;
+      const shouldMoveFocus = item.contains(document.activeElement);
+      const remaining = [...cart.children].filter(row => row !== item && !row.classList.contains('is-removing'));
+      const nextButton = (item.nextElementSibling && remaining.includes(item.nextElementSibling)
+        ? item.nextElementSibling : remaining[remaining.length - 1])?.querySelector('button');
+
+      item.style.height = `${item.getBoundingClientRect().height}px`;
+      item.classList.remove('is-dragging', 'is-ready');
+      item.classList.add('is-removing');
+      button.disabled = true;
+      content.style.transform = `translateX(${direction * item.offsetWidth}px)`;
+
+      const finish = () => {
+        item.remove();
+        const count = cart.querySelectorAll('.SwipeableList-item:not(.is-removing)').length;
+        document.getElementById('cart-count').textContent = `${count} ${count === 1 ? 'item' : 'items'}`;
+        document.getElementById('cart-empty').hidden = count !== 0;
+        document.getElementById('cart-status').textContent = `${name} removed. ${count} ${count === 1 ? 'item remains' : 'items remain'}.`;
+        if (shouldMoveFocus) {
+          if (nextButton?.isConnected && !nextButton.disabled) nextButton.focus();
+          else {
+            const heading = document.getElementById('cart-title');
+            heading.tabIndex = -1;
+            heading.focus();
+          }
+        }
+      };
+
+      if (reducedMotion.matches) {
+        finish();
+        return;
+      }
+      // Let the colored action show before collapsing the row's measured height.
+      window.setTimeout(() => {
+        item.style.height = '0px';
+        item.style.marginBottom = '0px';
+        item.style.opacity = '0';
+        window.setTimeout(finish, 300);
+      }, 180);
+    }
+
+    cart.querySelectorAll('.SwipeableList-item').forEach(item => {
+      const track = item.querySelector('.SwipeableList-track');
+      const content = item.querySelector('.SwipeableList-content');
+      let gesture = null;
+      const threshold = () => Math.min(120, track.clientWidth * 0.3);
+
+      const reset = () => {
+        gesture = null;
+        item.classList.remove('is-dragging', 'is-ready');
+        content.style.transform = '';
+      };
+
+      track.addEventListener('pointerdown', event => {
+        if (!event.isPrimary || event.button !== 0 || event.target.closest('button') || item.classList.contains('is-removing')) return;
+        gesture = { id: event.pointerId, x: event.clientX, y: event.clientY, distance: 0, dragging: false };
+      });
+
+      track.addEventListener('pointermove', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const dx = event.clientX - gesture.x;
+        const dy = event.clientY - gesture.y;
+        if (!gesture.dragging) {
+          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
+          if (Math.abs(dy) >= Math.abs(dx)) { reset(); return; }
+          gesture.dragging = true;
+          track.setPointerCapture(event.pointerId);
+          item.classList.add('is-dragging');
+        }
+        gesture.distance = Math.max(-track.clientWidth, Math.min(track.clientWidth, dx));
+        content.style.transform = `translateX(${gesture.distance}px)`;
+        item.classList.toggle('is-ready', Math.abs(gesture.distance) >= threshold());
+      });
+
+      track.addEventListener('pointerup', event => {
+        if (!gesture || gesture.id !== event.pointerId) return;
+        const distance = gesture.distance;
+        const shouldRemove = gesture.dragging && Math.abs(distance) >= threshold();
+        gesture = null;
+        if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId);
+        if (shouldRemove) removeItem(item, Math.sign(distance));
+        else reset();
+      });
+
+      track.addEventListener('pointercancel', reset);
+      track.addEventListener('lostpointercapture', () => { if (gesture) reset(); });
+      track.addEventListener('pointerleave', () => { if (gesture && !gesture.dragging) reset(); });
+      item.querySelector('.cart-remove').addEventListener('click', () => removeItem(item));
+    });
+  </script>
+
