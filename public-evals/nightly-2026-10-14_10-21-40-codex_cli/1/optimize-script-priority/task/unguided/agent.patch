diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,64 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>Overview · Dashboard</title>
+    <script async src="/js/app.js"></script>
+    <script src="/js/legacy-widgets.js"></script>
+    <script async src="/js/tracker.js"></script>
+    <style>
+      * { box-sizing: border-box; }
+      body { margin: 0; background: #fafaf8; color: #20221f; font-family: Arial, sans-serif; -webkit-font-smoothing: antialiased; }
+      header { height: 88px; padding: 0 6%; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e6e7e1; }
+      .brand { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 600; letter-spacing: -.5px; }
+      .mark { width: 22px; height: 22px; background: #22251f; border-radius: 6px; transform: rotate(-10deg); }
+      .avatar { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #e9eadf; font-size: 11px; font-weight: bold; }
+      main { max-width: 1120px; margin: 76px auto; padding: 0 32px; }
+      .eyebrow { color: #777b70; font-size: 11px; letter-spacing: 1.8px; text-transform: uppercase; }
+      h1 { font-size: clamp(32px, 5vw, 44px); font-weight: 500; letter-spacing: -1.8px; margin: 15px 0 12px; }
+      .intro { margin: 0; color: #797d73; font-size: 14px; line-height: 1.6; }
+      .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 44px 0 54px; }
+      .metric { padding: 27px; border: 1px solid #e3e5dc; border-radius: 10px; background: #fff; }
+      .label { margin: 0; color: #73786d; font-size: 13px; }
+      .value { margin: 20px 0 14px; font-size: 36px; letter-spacing: -1.5px; }
+      .change { font-size: 12px; color: #627e49; }
+      .change span { margin-left: 6px; color: #91958b; }
+      .section-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 21px; }
+      h2 { margin: 0; font-size: 16px; font-weight: 500; letter-spacing: -.3px; }
+      .section-heading span { color: #90948a; font-size: 12px; }
+      .activity { padding: 0; margin: 0; list-style: none; border-top: 1px solid #e3e5dc; }
+      .activity li { display: flex; gap: 16px; align-items: center; padding: 23px 0; border-bottom: 1px solid #e3e5dc; font-size: 13px; }
+      .dot { width: 7px; height: 7px; flex-shrink: 0; border-radius: 50%; background: #97a981; }
+      .activity time { margin-left: auto; color: #90948a; white-space: nowrap; font-size: 12px; }
+      footer { margin-top: 44px; display: flex; gap: 7px; align-items: center; color: #92968c; font-size: 11px; }
+      footer .dot { width: 5px; height: 5px; }
