+    </style>
+  </head>
+  <body>
+    <header>
+      <div class="brand"><span class="mark" aria-hidden="true"></span>baseline</div>
+      <div class="avatar" aria-label="Alex Morgan">AM</div>
+    </header>
+    <main>
+      <div class="eyebrow">Your workspace, at a glance</div>
