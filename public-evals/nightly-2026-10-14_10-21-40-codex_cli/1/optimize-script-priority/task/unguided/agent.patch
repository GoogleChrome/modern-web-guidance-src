+          <li><span class="dot" aria-hidden="true"></span><span>Olivia Chen joined your customers</span><time>48 min ago</time></li>
+          <li><span class="dot" aria-hidden="true"></span><span>Monthly report is ready</span><time>2 hours ago</time></li>
+        </ul>
+      </section>
+      <footer><span class="dot" aria-hidden="true"></span>All systems operational</footer>
+    </main>
