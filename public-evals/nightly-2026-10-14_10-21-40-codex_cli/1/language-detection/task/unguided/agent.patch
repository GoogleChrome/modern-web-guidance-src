+  <script>
+    const form = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const button = document.getElementById('detect-button');
+    const status = document.getElementById('feedback-status');
+    const progress = document.getElementById('download-progress');
+    const result = document.getElementById('feedback-result');
+    let availability;
+    let detector;
+    let busy = false;
+
+    async function checkAvailability() {
+      if (!('LanguageDetector' in window)) {
+        status.textContent = 'Language detection is not supported in this browser. Please try a browser with built-in language detection.';
+        return;
+      }
+      try {
+        availability = await LanguageDetector.availability();
+        if (availability === 'unavailable') {
+          status.textContent = 'Language detection is unavailable on this device.';
+          return;
+        }
+        status.textContent = availability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'The language model needs to download. Click Detect to get started.';
+        button.disabled = false;
+      } catch (error) {
+        status.textContent = 'Could not check language detection availability. Please reload to try again.';
+      }
+    }
+
+    form.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (busy || button.disabled) return;
+      const text = message.value.trim();
+      result.hidden = true;
+      if (!text) {
+        status.textContent = 'Please enter a message first.';
+        message.focus();
+        return;
+      }
+
+      busy = true;
+      button.disabled = true;
+      message.disabled = true;
+      form.setAttribute('aria-busy', 'true');
+      try {
+        if (!detector) {
+          if (availability === 'downloadable' || availability === 'downloading') {
+            progress.value = 0;
+            progress.hidden = false;
+            status.textContent = 'Downloading language model: 0%';
+          } else {
+            status.textContent = 'Preparing language detection…';
+          }
+          // Create within the submit gesture so the browser can authorize a download.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percentage = Math.round(Math.min(1, Math.max(0, event.loaded)) * 100);
+                progress.hidden = false;
+                progress.value = percentage;
+                status.textContent = `Downloading language model: ${percentage}%`;
+              });
+            }
+          });
+        }
+        progress.hidden = true;
+        status.textContent = 'Detecting language…';
+        const languages = await detector.detect(text);
+        const best = languages[0];
+        if (!best || !Number.isFinite(best.confidence)) {
+          throw new Error('No detection result');
+        }
+        let languageName = best.detectedLanguage === 'und' ? 'Unknown language' : best.detectedLanguage;
+        if (best.detectedLanguage !== 'und' && typeof Intl.DisplayNames === 'function') {
+          languageName = new Intl.DisplayNames(['en'], { type: 'language' }).of(best.detectedLanguage);
+        }
+        const confidence = (Math.min(1, Math.max(0, best.confidence)) * 100).toFixed(1);
+        result.textContent = `Language: ${languageName} · AI confidence: ${confidence}%`;
+        result.hidden = false;
+        status.textContent = 'Detection complete.';
+      } catch (error) {
+        status.textContent = 'Language detection failed. Please try again. If the model needs downloading, check your internet connection.';
+      } finally {
+        progress.hidden = true;
+        busy = false;
+        button.disabled = false;
+        message.disabled = false;
+        form.setAttribute('aria-busy', 'false');
+      }
+    });
+
+    checkAvailability();
+  </script>
+
 </body>
 
