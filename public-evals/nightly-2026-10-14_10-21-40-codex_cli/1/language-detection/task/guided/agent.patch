+  <script>
+    const feedbackForm = document.querySelector('#feedback-form');
+    const messageInput = document.querySelector('#feedback-message');
+    const detectButton = document.querySelector('#detect-button');
+    const feedbackStatus = document.querySelector('#feedback-status');
+    const modelProgress = document.querySelector('#model-progress');
+    let modelAvailability = 'unavailable';
+    let detector;
+    let busy = false;
+
+    async function checkLanguageDetection() {
+      if (!('LanguageDetector' in window)) {
+        feedbackStatus.textContent = 'Built-in language detection is not supported in this browser. Try a browser that supports the Language Detector API.';
+        return;
+      }
+
+      try {
+        modelAvailability = await LanguageDetector.availability();
+        if (modelAvailability === 'unavailable') {
+          feedbackStatus.textContent = 'Built-in language detection is unavailable on this device.';
+          return;
+        }
+        detectButton.disabled = false;
+        feedbackStatus.textContent = modelAvailability === 'available'
+          ? 'Ready to detect your message’s language.'
+          : 'Click Detect to download the language model and detect your message’s language.';
+      } catch {
+        feedbackStatus.textContent = 'Could not check language detection availability. Reload the page to try again.';
+      }
+    }
+
+    feedbackForm.addEventListener('submit', async (event) => {
+      event.preventDefault();
+      if (busy || modelAvailability === 'unavailable') return;
+
+      const message = messageInput.value.trim();
+      if (!message) {
+        feedbackStatus.textContent = 'Enter a message before detecting its language.';
+        messageInput.focus();
+        return;
+      }
+
+      busy = true;
+      detectButton.disabled = true;
+      messageInput.disabled = true;
+      modelProgress.hidden = true;
+      feedbackStatus.textContent = 'Detecting language…';
+
+      try {
+        if (!detector) {
+          if (modelAvailability !== 'available') {
+            modelProgress.value = 0;
+            modelProgress.hidden = false;
+            feedbackStatus.textContent = 'Downloading language model: 0%';
+          }
+          // Create directly from the user gesture; downloads require activation.
+          detector = await LanguageDetector.create({
+            monitor(monitor) {
+              monitor.addEventListener('downloadprogress', (event) => {
+                const percentage = Math.min(100, Math.max(0, Math.round(event.loaded * 100)));
+                modelProgress.hidden = false;
+                modelProgress.value = percentage;
+                feedbackStatus.textContent = `Downloading language model: ${percentage}%`;
+              });
+            },
+          });
+          modelAvailability = 'available';
+        }
+
+        modelProgress.hidden = true;
+        feedbackStatus.textContent = 'Detecting language…';
+        const results = await detector.detect(message);
+        const result = results[0];
+        if (!result || !result.detectedLanguage || result.detectedLanguage === 'und') {
+          feedbackStatus.textContent = 'Could not identify a language. Try a longer message.';
+          return;
+        }
+
+        let languageName = result.detectedLanguage;
+        try {
+          languageName = new Intl.DisplayNames(['en'], { type: 'language' }).of(result.detectedLanguage) || languageName;
+        } catch {
+          // Keep the language code if display names are unavailable.
+        }
+        const confidence = new Intl.NumberFormat('en', {
+          style: 'percent',
+          maximumFractionDigits: 1,
+        }).format(result.confidence);
+        feedbackStatus.textContent = `Language: ${languageName} · AI confidence: ${confidence}`;
+      } catch {
+        feedbackStatus.textContent = 'Language detection failed. Check your connection if the model needs downloading, then click Detect to try again.';
+      } finally {
+        modelProgress.hidden = true;
+        busy = false;
+        detectButton.disabled = false;
+        messageInput.disabled = false;
+      }
+    });
+
+    checkLanguageDetection();
+  </script>
+
 </body>
 
