+    /* Each manual popover occupies the browser's top layer independently.
+       Only earlier top-layer elements can be anchors, so this shared name
+       chains each toast above its predecessor without a layout wrapper. */
+    .toast {
+      position: fixed;
+      inset: auto;
+      right: max(1rem, env(safe-area-inset-right));
+      bottom: calc(anchor(--toast-stack top, 0px) + 1rem);
+      anchor-name: --toast-stack;
+      margin: 0;
+      width: min(320px, calc(100vw - 2rem));
+      padding: 1rem 1rem 1rem 1.25rem;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 6px 24px rgb(0 0 0 / 20%);
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+      opacity: 0;
+      transform: translateX(1rem);
+      transition: opacity 200ms ease, transform 200ms ease,
+        display 200ms allow-discrete, overlay 200ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast-close {
+      flex: none;
+      border: 0;
+      border-radius: 4px;
+      padding: 0.25rem 0.6rem;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.25rem;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    .toast-close:focus-visible,
+    .toast-trigger:focus-visible {
+      outline: 2px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @starting-style {
+      .toast:popover-open {
+        opacity: 0;
+        transform: translateX(1rem);
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transition-duration: 0s;
+      }
+    }
