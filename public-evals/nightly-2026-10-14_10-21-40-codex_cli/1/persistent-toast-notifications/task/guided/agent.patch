+    .toast {
+      --toast-height: 4rem;
+      --toast-gap: 0.75rem;
+      position: fixed;
+      inset: auto 1rem 1rem auto;
+      /* Toasts are prepended as direct body children, so their indices start at 1. */
+      bottom: calc(1rem + (sibling-index() - 1) * (var(--toast-height) + var(--toast-gap)));
+      margin: 0;
+      width: min(22rem, calc(100vw - 2rem));
+      height: var(--toast-height);
+      padding: 0.75rem 1rem;
+      border: 1px solid var(--secondary);
+      border-left: 4px solid var(--accent);
+      border-radius: 8px;
+      background: var(--primary);
+      color: white;
+      box-shadow: 0 8px 24px rgb(62 39 35 / 20%);
+      align-items: center;
+      justify-content: space-between;
+      gap: 1rem;
+      opacity: 0;
+      transform: translateX(1rem);
+      transition: opacity 220ms ease, transform 220ms ease, bottom 220ms ease,
+        display 220ms allow-discrete, overlay 220ms allow-discrete;
+    }
+
+    .toast:popover-open {
+      display: flex;
+    }
+
+    .toast:popover-open:not([data-closing]) {
+      opacity: 1;
+      transform: translateX(0);
+    }
+
+    @starting-style {
+      .toast:popover-open:not([data-closing]) {
+        opacity: 0;
+        transform: translateX(1rem);
+      }
+    }
+
+    .toast::backdrop {
+      background: transparent;
+      pointer-events: none;
+    }
+
+    .toast-close {
+      flex: none;
+      width: 2.5rem;
+      height: 2.5rem;
+      border: 0;
+      border-radius: 4px;
+      background: transparent;
+      color: inherit;
+      font: inherit;
+      font-size: 1.5rem;
+      cursor: pointer;
+    }
+
+    .toast-close:hover {
+      background: rgb(255 255 255 / 15%);
+    }
+
+    .toast-trigger:focus-visible,
+    .toast-close:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 3px;
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .toast {
+        transform: none;
+        transition-duration: 10ms;
+      }
+
+      @starting-style {
+        .toast:popover-open:not([data-closing]) {
+          transform: none;
+        }
+      }
+    }
