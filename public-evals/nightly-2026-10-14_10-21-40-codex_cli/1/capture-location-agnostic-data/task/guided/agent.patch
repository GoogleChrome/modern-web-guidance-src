+  <script type="module">
+    const form = document.getElementById('coffee-preferences-form');
+    const pickupTime = document.getElementById('pickup-reminder-time');
+    const anniversaryDate = document.getElementById('coffee-anniversary-date');
+    const status = document.getElementById('preferences-status');
+    const storageKey = 'daily-grind-coffee-preferences';
+
+    // Plain types validate calendar values without binding them to a time zone.
+    const temporalReady = globalThis.Temporal
+      ? Promise.resolve(globalThis.Temporal)
+      : import('https://esm.sh/@js-temporal/polyfill@0.5.1')
+        .then(module => module.Temporal)
+        .catch(() => null);
+
+    function describePreferences(preferences) {
+      const details = [];
+      if (preferences.pickupReminderTime) {
+        details.push(`Daily pickup: ${preferences.pickupReminderTime}`);
+      }
+      if (preferences.coffeeAnniversaryDate) {
+        details.push(`Coffee anniversary: ${preferences.coffeeAnniversaryDate}`);
+      }
+      return details.join(' · ') || 'No time or date selected.';
+    }
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved && typeof saved === 'object') {
+        if (typeof saved.pickupReminderTime === 'string') {
+          pickupTime.value = saved.pickupReminderTime;
+        }
+        if (typeof saved.coffeeAnniversaryDate === 'string') {
+          anniversaryDate.value = saved.coffeeAnniversaryDate;
+        }
+        status.textContent = describePreferences({
+          pickupReminderTime: pickupTime.value,
+          coffeeAnniversaryDate: anniversaryDate.value
+        });
+      }
+    } catch {
+      status.textContent = 'Saved preferences could not be loaded. You can select them again.';
+    }
+
+    form.addEventListener('submit', async event => {
+      event.preventDefault();
+      if (!form.reportValidity()) return;
+
+      // Persist the exact native input strings (HH:mm and YYYY-MM-DD).
+      // Never turn these preferences into Date objects, UTC, or timestamps.
+      const preferences = {
+        pickupReminderTime: pickupTime.value,
+        coffeeAnniversaryDate: anniversaryDate.value
+      };
+      const temporal = await temporalReady;
+      try {
+        if (temporal) {
+          if (preferences.pickupReminderTime) temporal.PlainTime.from(preferences.pickupReminderTime);
+          if (preferences.coffeeAnniversaryDate) temporal.PlainDate.from(preferences.coffeeAnniversaryDate);
+        }
+      } catch {
+        status.textContent = 'Please choose a valid time and calendar date.';
+        return;
+      }
+
+      // If the polyfill is unavailable offline, native input validation and
+      // plain string storage still preserve the same location-agnostic values.
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(preferences));
+        status.textContent = `Preferences saved. ${describePreferences(preferences)}`;
+      } catch {
+        status.textContent = 'Preferences could not be saved in this browser. Please try again.';
+      }
+    });
+  </script>
