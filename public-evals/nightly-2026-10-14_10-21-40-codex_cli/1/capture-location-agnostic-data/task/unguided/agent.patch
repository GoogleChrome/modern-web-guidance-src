+  <script>
+    (() => {
+      const storageKey = 'daily-grind-coffee-preferences';
+      const form = document.getElementById('coffee-preferences');
+      const reminder = document.getElementById('pickup-reminder');
+      const anniversary = document.getElementById('coffee-anniversary');
+      const status = document.getElementById('preferences-status');
+
+      // Keep these as wall-clock and calendar strings. Never convert them to
+      // Date objects, UTC timestamps, or offsets: travel must not shift them.
+      try {
+        const saved = JSON.parse(localStorage.getItem(storageKey));
+        if (saved && typeof saved === 'object') {
+          if (typeof saved.pickupReminder === 'string') {
+            reminder.value = saved.pickupReminder;
+          }
+          if (typeof saved.coffeeAnniversary === 'string') {
+            anniversary.value = saved.coffeeAnniversary;
+          }
+        }
+      } catch {
+        status.textContent = 'Saved preferences could not be loaded. You can set them below.';
+      }
+
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        if (!form.reportValidity()) return;
+
+        try {
+          localStorage.setItem(storageKey, JSON.stringify({
+            pickupReminder: reminder.value,
+            coffeeAnniversary: anniversary.value
+          }));
+          status.textContent = 'Preferences saved. Your selected time and date stay the same wherever you travel.';
+        } catch {
+          status.textContent = 'Preferences could not be saved in this browser. Please allow browser storage and try again.';
+        }
+      });
+    })();
+  </script>
+
