+];
+function loadPasskeys() {
+  try {
+    const saved = JSON.parse(localStorage.getItem(storageKey));
+    if (Array.isArray(saved) && saved.every(p => typeof p.id === 'string' && typeof p.name === 'string' && typeof p.provider === 'string' && Number.isFinite(p.registeredAt))) return saved;
+  } catch { /* Local storage may be unavailable; the demo still works in memory. */ }
+  return structuredClone(initialPasskeys);
+}
+let passkeys = loadPasskeys();
+let toastTimer;
+function toast(message) {
+  const el = document.getElementById('toast');
+  el.textContent = message;
+  el.hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => el.hidden = true, 4500);
+}
+function persist() {
+  try { localStorage.setItem(storageKey, JSON.stringify(passkeys)); }
+  catch { toast('Browser storage is unavailable. Changes will last for this session.'); }
+  render();
+}
+function formatDate(value) { return new Intl.DateTimeFormat('en-US', {month:'short',day:'numeric',year:'numeric',timeZone:'UTC'}).format(value); }
+function lastUsed(value) {
+  if (!value) return 'Never used';
+  if (value === Date.UTC(2026,9,14)) return 'Today';
+  if (value === Date.UTC(2026,9,13)) return 'Yesterday';
+  return formatDate(value);
+}
+function render() {
+  document.getElementById('count').textContent = passkeys.length;
+  document.getElementById('tab-count').textContent = passkeys.length;
+  document.getElementById('list-total').textContent = `${passkeys.length} passkey${passkeys.length === 1 ? '' : 's'}`;
+  const list = document.getElementById('passkey-list');
+  list.replaceChildren();
+  if (!passkeys.length) {
+    list.innerHTML = '<div class="empty-state"><h3>A fresh start for safer sign-ins.</h3><p>You have no demo passkeys. Add one to explore how they work.</p></div>';
+    return;
+  }
+  passkeys.forEach(p => {
+    const row = document.createElement('article');
+    row.className = 'passkey-row';
+    row.innerHTML = `<span class="provider-icon">${icon(p.type)}</span><div class="passkey-content"><div class="passkey-name"><h3></h3>${p.current ? '<span class="current-badge">This device</span>' : ''}</div><p class="provider-label"></p><div class="passkey-meta"><span class="registered"></span><span class="meta-dot">·</span><span class="last-used"></span></div></div><div class="row-actions"><button class="icon-button rename">${icon('edit')}</button><button class="icon-button delete">${icon('trash')}</button></div>`;
+    row.querySelector('h3').textContent = p.name;
+    row.querySelector('.provider-label').textContent = p.provider;
+    row.querySelector('.registered').textContent = `Added ${formatDate(p.registeredAt)}`;
+    row.querySelector('.last-used').textContent = `Last used ${lastUsed(p.lastUsedAt)}`;
+    const rename = row.querySelector('.rename');
+    const remove = row.querySelector('.delete');
+    rename.setAttribute('aria-label', `Rename ${p.name}`);
+    rename.title = 'Rename passkey';
+    remove.setAttribute('aria-label', `Remove ${p.name}`);
+    remove.title = 'Remove passkey';
+    rename.addEventListener('click', () => openDialog('rename', p));
+    remove.addEventListener('click', () => openDialog('remove', p));
+    list.append(row);
+  });
+}
+const dialog = document.getElementById('action-dialog');
+let action, selected;
+function openDialog(mode, item, content) {
+  action = mode;
+  selected = item;
+  const title = document.getElementById('dialog-title');
+  const description = document.getElementById('dialog-description');
+  const fields = document.getElementById('dialog-fields');
+  const submit = document.getElementById('dialog-submit');
+  fields.replaceChildren();
+  submit.classList.toggle('danger', mode === 'remove');
+  submit.textContent = mode === 'rename' ? 'Save changes' : mode === 'remove' ? 'Remove passkey' : mode === 'add' ? 'Add demo passkey' : 'Got it';
+  if (mode === 'rename' || mode === 'add') {
+    title.textContent = mode === 'rename' ? 'Rename your passkey' : 'Add a demo passkey';
+    description.textContent = mode === 'rename' ? 'Give this passkey a name that’s easy to recognize. This only changes its label in your account.' : 'This is a preview account. Add a sample device to try managing passkeys. No real passkey will be created on your device.';
+    const label = document.createElement('label');
