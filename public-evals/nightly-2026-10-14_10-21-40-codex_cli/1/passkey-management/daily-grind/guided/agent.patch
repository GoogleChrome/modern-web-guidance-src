+}
+document.getElementById('overview-tab').addEventListener('click', () => showTab(false));
+document.getElementById('passkeys-tab').addEventListener('click', () => showTab(true));
+document.getElementById('manage-passkeys').addEventListener('click', () => showTab(true));
+document.querySelector('.tabs').addEventListener('keydown', event => {if (['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) {event.preventDefault();const target = event.key === 'Home' ? false : event.key === 'End' ? true : document.getElementById('passkeys-tab').getAttribute('aria-selected') !== 'true';showTab(target);document.getElementById(target ? 'passkeys-tab' : 'overview-tab').focus();}});
