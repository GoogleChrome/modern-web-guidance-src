@@ -0,0 +1,124 @@
+import { useEffect, useRef, useState } from 'react';
+import {
+  ArrowLeftIcon, ArrowRightIcon, ArrowUpRightIcon, BellIcon, BookmarkIcon,
+  CheckIcon, ChevronDownIcon, ChevronRightIcon, CreditCardIcon, DevicePhoneMobileIcon,
+  FingerPrintIcon, KeyIcon, LifebuoyIcon, LockClosedIcon, ComputerDesktopIcon,
+  PencilSquareIcon, PlusIcon, ShieldCheckIcon, TrashIcon, UserIcon, XMarkIcon,
+} from '@heroicons/react/24/outline';
+
+type Passkey = { id: string; name: string; device: 'computer' | 'phone' | 'key'; provider: string; created: string; lastUsed: string; current?: boolean };
+const initialPasskeys: Passkey[] = [
+  { id: 'macbook', name: 'MacBook Pro', device: 'computer', provider: 'iCloud Keychain', created: 'May 12, 2026', lastUsed: 'Just now', current: true },
+  { id: 'iphone', name: 'iPhone 15', device: 'phone', provider: 'iCloud Keychain', created: 'May 12, 2026', lastUsed: '2 days ago' },
+  { id: 'yubikey', name: 'YubiKey 5C', device: 'key', provider: 'Security key', created: 'Apr 28, 2026', lastUsed: '12 days ago' },
+];
+const storageKey = 'devtools-times-passkeys-preview-v1';
+const deviceIcons = { computer: ComputerDesktopIcon, phone: DevicePhoneMobileIcon, key: KeyIcon };
+const navItems = [
+  { name: 'Personal information', icon: UserIcon },
+  { name: 'Sign-in & security', icon: ShieldCheckIcon },
+  { name: 'Subscription & billing', icon: CreditCardIcon },
+  { name: 'Notifications', icon: BellIcon },
+  { name: 'Saved articles', icon: BookmarkIcon },
+];
+
+type Modal = { type: 'rename'; passkey: Passkey } | { type: 'remove'; passkey: Passkey } | { type: 'add' } | { type: 'learn' } | { type: 'section'; name: string } | null;
+
+export default function PasskeySettings({ baseUrl }: { baseUrl: string }) {
+  const [passkeys, setPasskeys] = useState(initialPasskeys);
+  const [ready, setReady] = useState(false);
+  const [message, setMessage] = useState('');
+  const [modal, setModal] = useState<Modal>(null);
+  const [name, setName] = useState('');
+  const [device, setDevice] = useState<Passkey['device']>('computer');
+  const [formError, setFormError] = useState('');
+  const dialog = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    try {
+      const saved = localStorage.getItem(storageKey);
+      if (saved) {
+        const parsed: unknown = JSON.parse(saved);
+        if (Array.isArray(parsed) && parsed.every(p => p && typeof p.id === 'string' && typeof p.name === 'string' && ['computer', 'phone', 'key'].includes(p.device) && typeof p.provider === 'string' && typeof p.created === 'string' && typeof p.lastUsed === 'string')) setPasskeys(parsed);
+      }
+    } catch { setMessage('Your saved preview could not be loaded. The sample passkeys are shown.'); }
+    setReady(true);
+  }, []);
+
+  useEffect(() => {
+    if (modal) dialog.current?.showModal();
+    else dialog.current?.close();
+  }, [modal]);
+
+  function openModal(next: NonNullable<Modal>) {
+    setName(next.type === 'rename' ? next.passkey.name : '');
+    setDevice('computer');
+    setFormError('');
+    setModal(next);
+  }
+
+  function save(next: Passkey[], success: string) {
+    try {
+      localStorage.setItem(storageKey, JSON.stringify(next));
+      setPasskeys(next);
+      setMessage(success);
+      setModal(null);
+    } catch { setFormError('Changes could not be saved. Please allow browser storage and try again.'); }
+  }
+
+  function submit(event: React.FormEvent) {
+    event.preventDefault();
+    if (!modal) return;
+    if (modal.type === 'remove') {
+      save(passkeys.filter(p => p.id !== modal.passkey.id), `${modal.passkey.name} was removed.`);
+    } else if (modal.type === 'rename' || modal.type === 'add') {
+      const cleanName = name.trim();
+      if (!cleanName) { setFormError('Enter a name for this passkey.'); return; }
+      if (passkeys.some(p => p.name.toLowerCase() === cleanName.toLowerCase() && (modal.type !== 'rename' || p.id !== modal.passkey.id))) {
+        setFormError('A passkey with this name already exists. Choose another name.'); return;
+      }
+      if (modal.type === 'rename') save(passkeys.map(p => p.id === modal.passkey.id ? { ...p, name: cleanName } : p), 'Passkey name updated.');
+      else save([...passkeys, { id: crypto.randomUUID(), name: cleanName, device, provider: device === 'key' ? 'Security key' : 'Device passkey', created: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }), lastUsed: 'Not used yet' }], 'Sample passkey added to your preview.');
+    }
+  }
+
+  return <>
+    <a className="skip-link" href="#account-content">Skip to content</a>
+    <header className="account-header">
+      <a href={`${baseUrl}news`} className="wordmark" aria-label="The DevTools Times home">The DevTools Times<span className="wordmark-dot">.</span></a>
+      <span className="header-divider" /> <span className="header-account">Your account</span>
+      <div className="header-actions"><a href={`${baseUrl}news`} className="back-to-news"><ArrowLeftIcon /> Back to the news</a><span className="header-rule" /><button className="profile-button" onClick={() => openModal({ type: 'section', name: 'Your account' })} aria-label="View Alex Morgan's account"><span className="avatar">AM</span><span>Alex Morgan</span><ChevronDownIcon /></button></div>
+    </header>
+    <div className="account-shell">
+      <aside className="account-sidebar">
+        <div className="sidebar-label">MY ACCOUNT</div>
+        <nav aria-label="Account settings">{navItems.map(({ name: item, icon: Icon }) => <button key={item} className={`side-nav-item ${item === 'Sign-in & security' ? 'selected' : ''}`} aria-current={item === 'Sign-in & security' ? 'page' : undefined} onClick={() => item === 'Sign-in & security' ? document.getElementById('account-content')?.focus() : item === 'Saved articles' ? window.location.assign(`${baseUrl}news`) : openModal({ type: 'section', name: item })}><Icon /><span>{item}</span>{item === 'Sign-in & security' && <ChevronRightIcon className="nav-chevron" />}</button>)}</nav>
+        <div className="sidebar-support"><span className="support-icon"><LifebuoyIcon /></span><h2>A little help?</h2><p>We're here to make things easy.</p><button onClick={() => openModal({ type: 'section', name: 'Account support' })}>Visit the help center <ArrowUpRightIcon /></button></div>
+        <div className="subscriber"><span className="subscriber-dot" /> Digital subscriber <span>Since 2024</span></div>
+      </aside>
+      <main id="account-content" tabIndex={-1} className="account-main">
+        <nav className="breadcrumbs" aria-label="Breadcrumb"><span>Account</span><ChevronRightIcon /><button onClick={() => openModal({ type: 'section', name: 'Sign-in & security' })}>Sign-in & security</button><ChevronRightIcon /><span aria-current="page">Passkeys</span></nav>
+        <div className="page-heading"><div className="eyebrow">SIGN-IN & SECURITY</div><h1>Your keys. Your peace of mind.</h1><p>A safer, simpler way to sign in. Manage the passkeys connected to your account.</p></div>
+        <section className="passkey-intro" aria-labelledby="intro-heading"><div className="intro-icon"><FingerPrintIcon /></div><div><h2 id="intro-heading">Goodbye passwords. Hello passkeys.</h2><p>Sign in with your fingerprint, face, or device PIN. Passkeys are secure<br className="desktop-break" /> by design and uniquely yours.</p><button onClick={() => openModal({ type: 'learn' })}>Learn how passkeys work <ArrowUpRightIcon /></button></div><div className="intro-art" aria-hidden="true"><span className="art-ring ring-one" /><span className="art-ring ring-two" /><span className="art-ring ring-three" /><span className="art-key"><KeyIcon /></span><span className="art-check"><CheckIcon /></span></div></section>
+        <section className="registered-section" aria-labelledby="passkeys-heading">
+          <div className="section-heading"><div><div className="title-with-count"><h2 id="passkeys-heading">Your passkeys</h2><span className="count">{passkeys.length}</span></div><p>These devices and security keys can sign in to your account.</p></div><button className="primary-button" disabled={!ready} onClick={() => openModal({ type: 'add' })}><PlusIcon /> Add a passkey</button></div>
+          <div className="passkey-list">{passkeys.map(passkey => { const Icon = deviceIcons[passkey.device]; return <article className="passkey-card" key={passkey.id}><div className={`device-icon ${passkey.device}`}><Icon /></div><div className="passkey-info"><div className="passkey-name"><h3>{passkey.name}</h3>{passkey.current && <span className="current-badge"><span /> This device</span>}</div><div className="provider">{passkey.provider}</div><div className="key-metadata"><span>Added {passkey.created}</span><span className="metadata-dot">·</span><span>Last used: <strong>{passkey.lastUsed}</strong></span></div></div><div className="card-actions"><button className="rename-button" disabled={!ready} onClick={() => openModal({ type: 'rename', passkey })} aria-label={`Rename ${passkey.name}`}><PencilSquareIcon /><span>Rename</span></button><span className="action-divider" /><button className="remove-button" disabled={!ready} onClick={() => openModal({ type: 'remove', passkey })} aria-label={`Remove ${passkey.name}`}><TrashIcon /></button></div></article>; })}{passkeys.length === 0 && <div className="empty-state"><KeyIcon /><h3>A fresh start for your security</h3><p>Add a passkey to see it here. You can still sign in with your password.</p><button className="primary-button" onClick={() => openModal({ type: 'add' })}><PlusIcon /> Add your first passkey</button></div>}</div>
+          <div className="security-note"><LockClosedIcon /><p>Your biometric data stays on your device. We never see or store it.</p></div>
+          <div role="status" className={message ? 'status-message' : 'status-empty'}>{message && <><CheckIcon />{message}<button aria-label="Dismiss notification" onClick={() => setMessage('')}><XMarkIcon /></button></>}</div>
+        </section>
+        <div className="tips-grid"><section className="tip-card"><span className="tip-icon"><ShieldCheckIcon /></span><div><h2>Built for your protection</h2><p>Passkeys can't be guessed or reused. They help protect your account from phishing and data breaches.</p></div></section><section className="tip-card"><span className="tip-icon"><DevicePhoneMobileIcon /></span><div><h2>A backup is a good idea</h2><p>Add a passkey on another device or a security key so you always have a way back in.</p></div></section></div>
+        <div className="account-help"><span>Have a question about signing in?</span><button onClick={() => openModal({ type: 'section', name: 'Account support' })}>We're here to help <ArrowRightIcon /></button></div>
+      </main>
+    </div>
+    <footer className="account-footer"><div><span className="footer-brand">The DevTools Times.</span><span>© {new Date().getFullYear()} The DevTools Times Company</span></div><div><span className="preview-label">Account preview</span><a href={`${baseUrl}legal/privacy`}>Privacy policy</a><a href={`${baseUrl}legal/terms`}>Terms of service</a><button onClick={() => openModal({ type: 'section', name: 'Account support' })}>Contact us <ArrowUpRightIcon /></button></div></footer>
+    <dialog ref={dialog} className="passkey-dialog" onCancel={() => setModal(null)} onClose={() => setModal(null)} aria-labelledby="dialog-title">
+      {modal && <><button className="dialog-close" aria-label="Close dialog" onClick={() => setModal(null)}><XMarkIcon /></button><div className={`dialog-icon ${modal.type === 'remove' ? 'danger' : ''}`}>{modal.type === 'remove' ? <TrashIcon /> : modal.type === 'learn' ? <FingerPrintIcon /> : <KeyIcon />}</div>
+      <h2 id="dialog-title">{modal.type === 'rename' ? 'Rename your passkey' : modal.type === 'remove' ? `Remove ${modal.passkey.name}?` : modal.type === 'add' ? 'Add a passkey' : modal.type === 'learn' ? 'A simpler way to sign in' : modal.name}</h2>
+      {(modal.type === 'add' || modal.type === 'rename' || modal.type === 'remove') ? <form onSubmit={submit}>
+        <p className="dialog-description">{modal.type === 'remove' ? `This passkey will be removed from this account preview. Keep another sign-in method available before removing a device.` : modal.type === 'rename' ? 'Choose a name that helps you recognize this device.' : 'Try adding a sample device to this account preview. Live passkey registration is not connected yet.'}</p>
+        {modal.type !== 'remove' && <><label htmlFor="passkey-name">Passkey name</label><input id="passkey-name" value={name} onChange={e => setName(e.target.value)} placeholder="e.g. My personal laptop" maxLength={60} required autoFocus aria-describedby={formError ? 'passkey-error' : undefined} aria-invalid={!!formError} />{modal.type === 'add' && <><label htmlFor="passkey-device">Device type</label><select id="passkey-device" value={device} onChange={e => setDevice(e.target.value as Passkey['device'])}><option value="computer">Computer</option><option value="phone">Phone or tablet</option><option value="key">Security key</option></select></>}</>}
+        {formError && <p id="passkey-error" className="form-error" role="alert">{formError}</p>}<div className="dialog-actions"><button type="button" className="secondary-button" onClick={() => setModal(null)}>Cancel</button><button className={modal.type === 'remove' ? 'danger-button' : 'primary-button'} type="submit">{modal.type === 'remove' ? 'Remove passkey' : modal.type === 'rename' ? 'Save changes' : 'Add sample passkey'}</button></div>
+      </form> : modal.type === 'learn' ? <div className="learn-content"><p>Passkeys use your device's built-in security to make signing in easier.</p><ol><li><strong>Unlock with a touch or a glance.</strong><span>Use your fingerprint, face, or device PIN.</span></li><li><strong>Your information stays private.</strong><span>Your biometric data never leaves your device.</span></li><li><strong>Keep another way to sign in.</strong><span>A second device or security key makes a useful backup.</span></li></ol><button className="primary-button" onClick={() => setModal(null)}>Got it</button></div> : <div className="learn-content"><p>{modal.name === 'Account support' ? 'Need help with a passkey? You can rename a device to recognize it, or remove an entry you no longer use. Keep a backup sign-in method before removing your last passkey.' : 'This account preview focuses on passkey management. You can view, rename, add sample devices, and remove the passkeys listed here.'}</p><button className="primary-button" onClick={() => setModal(null)}>Back to passkeys</button></div>}</>}
+    </dialog>
+  </>;
+}
