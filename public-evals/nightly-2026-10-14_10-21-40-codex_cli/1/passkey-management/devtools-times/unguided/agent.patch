+import React, { useEffect, useRef, useState } from 'react';
+import { ArrowRightIcon, ArrowUpRightIcon, BookOpenIcon, CheckIcon, ChevronDownIcon, ChevronRightIcon, ComputerDesktopIcon, CreditCardIcon, DevicePhoneMobileIcon, EllipsisHorizontalIcon, EnvelopeIcon, KeyIcon, LockClosedIcon, PlusIcon, QuestionMarkCircleIcon, ShieldCheckIcon, UserCircleIcon, XMarkIcon, PencilSquareIcon, TrashIcon, ArrowRightOnRectangleIcon } from '@heroicons/react/24/outline';
+
+type Passkey = { id: string; name: string; kind: 'computer' | 'phone' | 'key'; created: string; used: string; provider: string; current?: boolean };
+const initial: Passkey[] = [
+  { id: 'mac', name: 'MacBook Pro', kind: 'computer', created: 'May 14, 2025', used: 'Just now', provider: 'iCloud Keychain', current: true },
+  { id: 'phone', name: 'iPhone 15', kind: 'phone', created: 'May 14, 2025', used: '2 days ago', provider: 'iCloud Keychain' },
+  { id: 'yubi', name: 'YubiKey 5C NFC', kind: 'key', created: 'Apr 28, 2025', used: '16 days ago', provider: 'Security key' },
+];
+const storageKey = 'devtools-times-passkeys-v1';
+const navItems = [ { name: 'Overview', icon: UserCircleIcon }, { name: 'Personal details', icon: PencilSquareIcon }, { name: 'Sign-in & security', icon: ShieldCheckIcon }, { name: 'Subscription', icon: CreditCardIcon }, { name: 'Email preferences', icon: EnvelopeIcon }, { name: 'Saved stories', icon: BookOpenIcon } ];
+
+export default function PasskeySettings({ baseUrl = '/devtools-times/' }: { baseUrl?: string }) {
+  const [passkeys, setPasskeys] = useState<Passkey[]>(initial);
+  const [ready, setReady] = useState(false);
+  const [section, setSection] = useState('Sign-in & security');
+  const [tab, setTab] = useState('Passkeys');
+  const [menu, setMenu] = useState<string | null>(null);
+  const [modal, setModal] = useState<{ type: 'add' | 'rename' | 'remove' | 'help'; key?: Passkey } | null>(null);
+  const [name, setName] = useState('');
+  const [kind, setKind] = useState<Passkey['kind']>('computer');
+  const [notice, setNotice] = useState('');
+  const [profile, setProfile] = useState(false);
+  const dialog = useRef<HTMLDialogElement>(null);
+  useEffect(() => {
+    try {
+      const saved = localStorage.getItem(storageKey);
+      if (saved) {
+        const parsed = JSON.parse(saved);
+        if (Array.isArray(parsed) && parsed.every(p => typeof p.id === 'string' && typeof p.name === 'string' && ['computer', 'phone', 'key'].includes(p.kind) && typeof p.created === 'string' && typeof p.used === 'string' && typeof p.provider === 'string')) setPasskeys(parsed);
+      }
+    } catch { /* A fresh list is available if storage is inaccessible. */ }
+    setReady(true);
+  }, []);
+  useEffect(() => {
+    if (ready) { try { localStorage.setItem(storageKey, JSON.stringify(passkeys)); } catch { setNotice('Your browser could not save these changes.'); } }
+  }, [passkeys, ready]);
+  useEffect(() => {
+    if (modal) dialog.current?.showModal();
+    else dialog.current?.close();
+  }, [modal]);
+  useEffect(() => {
+    if (!notice) return;
+    const timer = setTimeout(() => setNotice(''), 5000);
+    return () => clearTimeout(timer);
+  }, [notice]);
+  useEffect(() => {
+    const close = () => { setMenu(null); setProfile(false); };
+    document.addEventListener('click', close);
+    return () => document.removeEventListener('click', close);
+  }, []);
+  const openModal = (type: 'add' | 'rename' | 'remove' | 'help', key?: Passkey) => { setName(key?.name || ''); setKind('computer'); setMenu(null); setModal({ type, key }); };
+  const submit = (event: React.FormEvent) => {
+    event.preventDefault();
+    if (modal?.type === 'rename') {
+      setPasskeys(keys => keys.map(key => key.id === modal.key?.id ? { ...key, name: name.trim() } : key));
+      setNotice('Passkey renamed successfully.');
+    } else if (modal?.type === 'add') {
+      setPasskeys(keys => [...keys, { id: crypto.randomUUID(), name: name.trim(), kind, created: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }), used: 'Not used yet', provider: kind === 'key' ? 'Security key' : 'Device passkey' }]);
+      setNotice('Demo passkey added successfully.');
+    } else if (modal?.type === 'remove') {
+      setPasskeys(keys => keys.filter(key => key.id !== modal.key?.id));
+      setNotice('Passkey removed successfully.');
+    }
+    setModal(null);
+  };
+  return (
+    <div className="account-app">
+      <header className="account-header">
+        <a href={`${baseUrl}news`} className="brand"><img src={`${baseUrl}logo.svg`} alt="The DevTools Times" /><span>INDEPENDENT MINDS. INFORMED LIVES.</span></a>
+        <div className="header-actions"><a href={`${baseUrl}news`} className="back-news">Back to the news <ArrowUpRightIcon /></a><span className="header-divider" /><div className="profile-wrap"><button className="profile-button" aria-label="Open account menu" aria-expanded={profile} onClick={e => { e.stopPropagation(); setProfile(!profile); }}><span className="avatar">JD</span><ChevronDownIcon /></button>{profile && <div className="profile-menu"><strong>Jamie Davis</strong><small>jamie.davis@gmail.com</small><a href={`${baseUrl}signin`}><ArrowRightOnRectangleIcon /> Sign out</a></div>}</div></div>
+      </header>
+      <div className="account-shell">
+        <aside className="account-sidebar">
+          <div className="account-label">YOUR ACCOUNT</div>
+          <nav aria-label="Account settings">{navItems.map(item => <button key={item.name} className={`sidebar-item ${section === item.name ? 'selected' : ''}`} onClick={() => { if (item.name === 'Saved stories') { window.location.href = `${baseUrl}news`; return; } setSection(item.name); }}><item.icon /><span>{item.name}</span>{section === item.name && <ChevronRightIcon className="nav-arrow" />}</button>)}</nav>
+          <div className="sidebar-help"><span className="help-symbol"><QuestionMarkCircleIcon /></span><h3>A little help?</h3><p>We’re here to make things easy.</p><button onClick={() => openModal('help')}>Visit our help center <ArrowUpRightIcon /></button></div>
+          <a className="sidebar-signout" href={`${baseUrl}signin`}><ArrowRightOnRectangleIcon /> Sign out</a>
+        </aside>
+        <main className="account-main">
+          <div className="breadcrumb">Account <ChevronRightIcon /><span>{section}</span></div>
+          <div className="page-heading"><div><h1>{section}</h1><p>{section === 'Sign-in & security' ? 'A little peace of mind. Keep your account safe and accessible.' : 'Everything you need to make this account your own.'}</p></div><span className="secure-account"><span /> Your account is secure</span></div>
+          {section === 'Sign-in & security' ? <>
+            <div className="security-tabs" role="tablist" aria-label="Security settings">{['Password', 'Passkeys', 'Active sessions'].map(item => <button role="tab" aria-selected={tab === item} key={item} onClick={() => setTab(item)} className={tab === item ? 'active' : ''}>{item}{item === 'Passkeys' && <span className="tab-count">{passkeys.length}</span>}</button>)}</div>
+            {tab === 'Passkeys' ? <div role="tabpanel" className="passkeys-panel">
+              <section className="passkey-intro"><div className="intro-content"><span className="eyebrow"><span /> A SMARTER WAY TO SIGN IN</span><h2>Your key. Your account.<br />No password needed.</h2><p>Passkeys let you sign in with your fingerprint, face, or<br className="desktop-break" /> screen lock. Simple for you. Safer for your account.</p><button className="intro-link" onClick={() => openModal('help')}>Get to know passkeys <ArrowUpRightIcon /></button></div><div className="key-illustration" aria-hidden="true"><div className="orbit orbit-one" /><div className="orbit orbit-two" /><div className="orbit orbit-three" /><span className="spark spark-one">✦</span><span className="spark spark-two">✧</span><div className="key-tile"><KeyIcon /></div><div className="shield-tile"><ShieldCheckIcon /></div><span className="orbit-dot" /></div></section>
+              <section className="registered-section"><div className="registered-heading"><div><h2>Your passkeys <span>{passkeys.length}</span></h2><p>Manage the devices and security keys you use to sign in.</p></div><button className="primary-button" onClick={() => openModal('add')}><PlusIcon /> Add a passkey</button></div>
+                <div className="passkey-list">{passkeys.length ? passkeys.map(key => { const DeviceIcon = key.kind === 'computer' ? ComputerDesktopIcon : key.kind === 'phone' ? DevicePhoneMobileIcon : KeyIcon; return <article className="passkey-row" key={key.id}><div className={`device-icon ${key.kind}`}><DeviceIcon /></div><div className="device-info"><div className="device-title"><h3>{key.name}</h3>{key.current && <span className="current-badge">This device</span>}</div><p>{key.provider}<span>·</span>Added {key.created}</p></div><div className="last-used"><span>Last used</span><strong className={key.current ? 'recent' : ''}>{key.current && <span className="small-dot" />}{key.used}</strong></div><div className="row-menu-wrap"><button className={`row-menu-button ${menu === key.id ? 'opened' : ''}`} aria-label={`Manage ${key.name}`} aria-expanded={menu === key.id} onClick={e => { e.stopPropagation(); setMenu(menu === key.id ? null : key.id); }}><EllipsisHorizontalIcon /></button>{menu === key.id && <div className="row-menu" onClick={e => e.stopPropagation()}><button onClick={() => openModal('rename', key)}><PencilSquareIcon />Rename passkey</button><button className="danger-text" onClick={() => openModal('remove', key)}><TrashIcon />Remove passkey</button></div>}</div></article>; }) : <div className="empty-state"><KeyIcon /><h3>Your next sign-in can be simpler.</h3><p>Add your first passkey to get started.</p></div>}</div>
+                <p className="list-note"><LockClosedIcon />Your biometric data stays on your device. It’s never shared with us.</p>
+              </section>
+              <section className="backup-note"><div className="backup-icon"><ShieldCheckIcon /></div><div><h3>A spare key is always a good idea.</h3><p>Add a passkey on another device so you can still sign in if you lose access to one.</p></div><button aria-label="Add a backup passkey" onClick={() => openModal('add')}><ArrowRightIcon /></button></section>
+              <div className="questions"><QuestionMarkCircleIcon /><span>Questions about signing in?</span><button onClick={() => openModal('help')}>We’re here to help <ArrowUpRightIcon /></button></div>
+            </div> : <section className="alternative-panel"><div className="alt-icon">{tab === 'Password' ? <LockClosedIcon /> : <ComputerDesktopIcon />}</div><h2>{tab === 'Password' ? 'A more secure way to sign in' : 'Your current session'}</h2><p>{tab === 'Password' ? 'Use a passkey to sign in without remembering a password. Your device takes care of the rest.' : 'You’re browsing The DevTools Times on this device. Passkey activity is available in your passkey list.'}</p><button className="primary-button" onClick={() => setTab('Passkeys')}>Manage your passkeys <ArrowRightIcon /></button></section>}
+          </> : <section className="alternative-panel"><UserCircleIcon className="large-icon" /><h2>{section === 'Overview' ? 'Good to see you, Jamie.' : section}</h2>{section === 'Personal details' ? <><p>Your account details</p><div className="detail-line"><span>Name</span><strong>Jamie Davis</strong></div><div className="detail-line"><span>Email address</span><strong>jamie.davis@gmail.com</strong></div></> : section === 'Subscription' ? <><p>You’re part of our community of independent minds.</p><div className="detail-line"><span>Your plan</span><strong>Digital subscriber</strong></div></> : section === 'Email preferences' ? <><p>Choose what arrives in your inbox.</p><label className="detail-line"><span>The daily briefing</span><input type="checkbox" defaultChecked /></label><label className="detail-line"><span>Weekly highlights</span><input type="checkbox" defaultChecked /></label><button className="primary-button" onClick={() => setNotice('Email preferences saved for this session.')}>Save preferences</button></> : <><p>Your next great read is waiting. Manage your account or keep exploring.</p><button className="primary-button" onClick={() => setSection('Sign-in & security')}>Manage sign-in & security <ArrowRightIcon /></button></>}</section>}
+          <footer className="account-footer"><span>© {new Date().getFullYear()} The DevTools Times</span><div><button onClick={() => openModal('help')}>Privacy & terms</button><span>·</span><button onClick={() => openModal('help')}>Help center <ArrowUpRightIcon /></button></div></footer>
+        </main>
+      </div>
+      {notice && <div className="toast" role="status"><CheckIcon />{notice}<button aria-label="Dismiss notification" onClick={() => setNotice('')}><XMarkIcon /></button></div>}
+      <dialog ref={dialog} className="passkey-dialog" aria-labelledby="passkey-dialog-title" onCancel={() => setModal(null)} onClick={e => { if (e.target === e.currentTarget) setModal(null); }}>
+        {modal && <><button className="dialog-close" onClick={() => setModal(null)} aria-label="Close dialog"><XMarkIcon /></button><div className="dialog-icon">{modal.type === 'remove' ? <TrashIcon /> : <KeyIcon />}</div><h2 id="passkey-dialog-title">{modal.type === 'add' ? 'Add a passkey' : modal.type === 'rename' ? 'Rename your passkey' : modal.type === 'remove' ? 'Remove this passkey?' : 'A simpler, safer sign-in'}</h2>
+        {modal.type === 'help' ? <><p>Passkeys replace passwords with your device’s fingerprint, face recognition, or screen lock. They’re designed to protect you from phishing.</p><div className="help-detail"><ShieldCheckIcon /><div><strong>Keep a backup</strong><p>Register a second device or a security key so you always have a way to sign in.</p></div></div><p className="demo-note">This account preview stores passkey entries in your browser. Real registration and account support require a connected account service.</p><button className="primary-button full-width" onClick={() => setModal(null)}>Got it</button></> : <form onSubmit={submit}><p>{modal.type === 'remove' ? `“${modal.key?.name}” will no longer appear in your passkey list. You can add it again later.` : modal.type === 'rename' ? 'Give this passkey a name you’ll easily recognize.' : 'Give your new passkey a name so it’s easy to find.'}</p>{modal.type !== 'remove' && <><label htmlFor="passkey-name">Passkey name</label><input id="passkey-name" autoFocus required maxLength={60} value={name} onChange={e => setName(e.target.value)} placeholder="e.g. My MacBook" />{modal.type === 'add' && <><label htmlFor="device-type">Device type</label><select id="device-type" value={kind} onChange={e => setKind(e.target.value as Passkey['kind'])}><option value="computer">Computer</option><option value="phone">Phone or tablet</option><option value="key">Security key</option></select><p className="demo-note">Demo mode: this adds a local entry. No sign-in credential is created.</p></>}</>}{modal.type === 'remove' && passkeys.length === 1 && <p className="demo-note">This is your last passkey. Make sure you have another way to access your account.</p>}<div className="dialog-actions"><button type="button" className="secondary-button" onClick={() => setModal(null)}>Cancel</button><button type="submit" disabled={modal.type !== 'remove' && !name.trim()} className={modal.type === 'remove' ? 'danger-button' : 'primary-button'}>{modal.type === 'remove' ? 'Remove passkey' : modal.type === 'rename' ? 'Save changes' : 'Add demo passkey'}</button></div></form>}</>}
+      </dialog>
+    </div>
+  );
+}
