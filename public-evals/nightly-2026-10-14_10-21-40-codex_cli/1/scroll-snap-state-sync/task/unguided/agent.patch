+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const headings = tocLinks.map(link => document.getElementById(link.hash.slice(1)));
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+
+    function headingScrollTop(heading) {
+      const panelTop = panel.getBoundingClientRect().top + panel.clientTop;
+      const padding = parseFloat(getComputedStyle(panel).scrollPaddingTop) || 0;
+      return panel.scrollTop + heading.getBoundingClientRect().top - panelTop - padding;
+    }
+
+    function updateCurrentDrink() {
+      let currentIndex = 0;
+      let closestDistance = Infinity;
+      headings.forEach((heading, index) => {
+        const distance = Math.abs(headingScrollTop(heading) - panel.scrollTop);
+        if (distance < closestDistance) {
+          currentIndex = index;
+          closestDistance = distance;
+        }
+      });
+      tocLinks.forEach((link, index) => {
+        if (index === currentIndex) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    tocLinks.forEach((link, index) => {
+      link.addEventListener('click', event => {
+        // Preserve modified clicks and their normal link behavior.
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const heading = headings[index];
+        heading.focus({ preventScroll: true });
+        panel.scrollTo({
+          top: headingScrollTop(heading),
+          behavior: reducedMotion.matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    let scrollFrame = null;
+    panel.addEventListener('scroll', () => {
+      if (scrollFrame !== null) return;
+      scrollFrame = requestAnimationFrame(() => {
+        updateCurrentDrink();
+        scrollFrame = null;
+      });
+    }, { passive: true });
+    panel.addEventListener('scrollend', updateCurrentDrink);
+    window.addEventListener('resize', updateCurrentDrink);
+    updateCurrentDrink();
+  </script>
 </body>
 
