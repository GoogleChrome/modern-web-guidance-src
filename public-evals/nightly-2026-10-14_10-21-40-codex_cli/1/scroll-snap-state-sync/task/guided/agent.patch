+  <script>
+    const panel = document.querySelector('.seasonal-panel');
+    const tocLinks = [...document.querySelectorAll('.toc-sidebar a')];
+    const headers = tocLinks.map(link => document.getElementById(link.hash.slice(1)));
+
+    function setCurrentHeader(header) {
+      tocLinks.forEach(link => {
+        if (link.hash === `#${header.id}`) {
+          link.setAttribute('aria-current', 'location');
+        } else {
+          link.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    function headerOffset(header) {
+      return header.getBoundingClientRect().top - panel.getBoundingClientRect().top
+        - panel.clientTop - parseFloat(getComputedStyle(panel).scrollPaddingTop);
+    }
+
+    function syncNearestHeader() {
+      const nearest = headers.reduce((closest, header) =>
+        Math.abs(headerOffset(header)) < Math.abs(headerOffset(closest)) ? header : closest);
+      setCurrentHeader(nearest);
+    }
+
+    tocLinks.forEach((link, index) => {
+      link.addEventListener('click', event => {
+        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
+        event.preventDefault();
+        const header = headers[index];
+        header.focus({ preventScroll: true });
+        panel.scrollTo({
+          top: panel.scrollTop + headerOffset(header),
+          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    if ('onscrollsnapchange' in panel) {
+      panel.addEventListener('scrollsnapchange', event => {
+        if (headers.includes(event.snapTargetBlock)) setCurrentHeader(event.snapTargetBlock);
+      });
+    } else {
+      const observer = new IntersectionObserver(syncNearestHeader, {
+        root: panel,
+        threshold: [0, 1]
+      });
+      headers.forEach(header => observer.observe(header));
+      panel.addEventListener('scrollend', syncNearestHeader);
+    }
+
+    syncNearestHeader();
+  </script>
