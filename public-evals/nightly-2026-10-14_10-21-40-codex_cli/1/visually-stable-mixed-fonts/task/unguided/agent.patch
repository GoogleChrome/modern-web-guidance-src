+<style>
+:root{font-family:Arial,Helvetica,sans-serif;color:#242a37;background:#f7f8fa;font-synthesis:none}*{box-sizing:border-box}body{margin:0}button,select,input{font:inherit}button,a,input,select{-webkit-tap-highlight-color:transparent}button{cursor:pointer}button:focus-visible,a:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #57c8ad;outline-offset:4px}.app{display:flex;min-height:100vh}.sidebar{width:236px;background:#18232c;color:#a7b1b9;padding:35px 23px;display:flex;flex-direction:column;position:fixed;height:100vh}.brand{color:white;font-weight:700;font-size:24px;letter-spacing:-1px;display:flex;align-items:center;gap:10px}.brand-icon{width:30px;height:30px;background:#a9eed7;color:#18232c;border-radius:8px;display:grid;place-items:center;font-family:Georgia,serif;font-size:24px}.workspace{font-size:10px;letter-spacing:1.6px;margin:51px 12px 17px;color:#788996}.nav{display:flex;align-items:center;gap:12px;padding:13px 14px;font-size:13px;text-decoration:none;color:#a7b1b9;border-radius:7px;margin:4px 0}.nav.active{background:#2c3a42;color:#c2f4e2}.nav svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.6}.sidebar-bottom{margin-top:auto;border-top:1px solid #344048;padding-top:21px;font-size:12px;line-height:1.8}.version{font-size:10px;color:#758792}.main{margin-left:236px;width:calc(100% - 236px)}header{height:79px;border-bottom:1px solid #e5e8ed;display:flex;align-items:center;justify-content:space-between;padding:0 48px;background:#fff;font-size:12px;color:#85909e}.breadcrumb span{color:#354150;margin-left:12px}.header-right{display:flex;align-items:center;gap:17px}.local{font-size:11px}.dot{display:inline-block;width:6px;height:6px;background:#38ac86;border-radius:50%;margin-right:6px}.avatar{height:29px;width:29px;display:grid;place-items:center;background:#e9edf0;border:1px solid #dbe0e4;border-radius:50%;color:#50606b;font-size:10px;font-weight:700}main{max-width:1250px;margin:auto;padding:43px 48px 30px}.eyebrow{font-size:10px;font-weight:700;letter-spacing:1.8px;color:#739488;margin-bottom:13px}h1{font-size:34px;letter-spacing:-1.1px;margin:0 0 12px;font-weight:650}.intro{font-size:14px;color:#7a8290;line-height:1.7;margin:0}.title-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px}.badge{font-size:10px;border:1px solid #dae3df;border-radius:20px;padding:7px 11px;color:#678477;background:#f0f6f3;white-space:nowrap}.toolbar{display:flex;align-items:center;gap:24px;background:white;border:1px solid #e0e4e8;padding:17px 20px;border-radius:9px;margin-bottom:23px;min-height:73px}.field{display:flex;align-items:center;gap:12px;font-size:11px;color:#6a7380}select{border:1px solid #e1e5e8;border-radius:5px;background:#fafbfc;padding:8px 26px 8px 10px;color:#36404c;font-size:11px}input[type=range]{accent-color:#35846d;width:100px;height:4px}.size-output{font-size:11px;color:#424d59;min-width:31px}.toolbar-divider{width:1px;height:26px;background:#e8ebee}.reset{margin-left:auto;background:none;border:0;color:#78828d;font-size:11px;display:flex;gap:7px;align-items:center}.cards{display:grid;grid-template-columns:1.15fr 1fr;gap:22px}.card{background:#fff;border:1px solid #e0e4e8;border-radius:10px;overflow:hidden}.card-head{padding:20px 22px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e9ecf0}.card-title{font-size:13px;font-weight:600;display:flex;align-items:center;gap:10px}.number{font-size:9px;color:#8a959e;font-family:monospace}.pill{font-size:9px;border-radius:4px;padding:5px 7px;background:#e8f6ef;color:#43876f;letter-spacing:.3px}.pill.purple{background:#f1edf9;color:#8a73ad}.preview{padding:24px 23px 27px;min-height:221px}.preview-label{font-size:9px;letter-spacing:1.7px;color:#929ba4;display:flex;align-items:center;justify-content:space-between}.toggle{display:flex;gap:7px;align-items:center;font-size:10px;letter-spacing:0;color:#7a8590}.switch{border:0;width:27px;height:16px;border-radius:10px;background:#3f9278;padding:2px;display:flex;justify-content:flex-end}.switch::after{content:'';width:12px;height:12px;background:white;border-radius:50%}.switch[aria-checked=false]{background:#bec5cc;justify-content:flex-start}#mixed-fonts-container{font-family:Arial,Helvetica,sans-serif;font-size:24px;line-height:1.65;font-size-adjust:from-font;margin:27px 0 13px;color:#35414c}code{font-family:"Courier New",Courier,monospace}#mixed-fonts-container code,#independent-theme-container code{font-size:1em;border-radius:4px;padding:2px 5px;background:#edf3f0;color:#3d7e68}.preview-note{font-size:10px;color:#98a0a9;margin:16px 0 0}.theme-preview{background:#fbfaff;padding:24px 23px 26px;min-height:221px}#independent-theme-container{font-family:Georgia,"Times New Roman",serif;font-size:24px;font-size-adjust:0.5;line-height:1.65;margin-top:26px;color:#4e4267}#independent-theme-container code{color:#84709e;background:#f0ecf6}.card-footer{display:flex;align-items:center;justify-content:space-between;padding:14px 22px;border-top:1px solid #e9ecf0;font-size:10px;color:#8b949e}.card-footer code{color:#566471;font-size:11px}.theme-footer{background:#fefcff}.info{display:flex;gap:11px;background:#edf4f1;border:1px solid #dceae3;border-radius:7px;padding:15px 18px;margin:23px 0 31px;color:#698074;font-size:11px;line-height:1.7}.info-icon{font-family:Georgia,serif;border:1px solid #8aa597;border-radius:50%;height:15px;min-width:15px;text-align:center;line-height:14px;margin-top:2px;font-size:11px}.info strong{color:#3b6552;font-weight:600}.section-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}.section-heading h2{font-size:14px;margin:0;font-weight:600}.section-heading span{font-size:10px;color:#8b95a0}.editor{border:1px solid #e0e4e8;border-radius:9px;overflow:hidden;background:white}.editor-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e8ebef;padding:0 18px;height:44px}.tabs{display:flex;height:100%;gap:22px}.tab{background:none;border:0;color:#99a2ac;font-size:11px;padding:0 3px;border-bottom:2px solid transparent}.tab.active{color:#426e5d;border-bottom-color:#43856f}.copy{font-size:10px;color:#7c8791;background:white;border:1px solid #e1e6ea;border-radius:4px;padding:5px 9px}.code-area{display:flex;padding:20px 22px 23px;overflow:auto}.line-numbers{font-family:monospace;font-size:11px;color:#bac2c9;text-align:right;line-height:1.9;padding-right:25px;user-select:none}pre{font-family:"Courier New",monospace;font-size:11px;line-height:1.9;margin:0;color:#586878}.selector{color:#91759f}.property{color:#477b71}.value{color:#b88b58}.comment{color:#a3acb3}footer{display:flex;justify-content:space-between;margin-top:23px;font-size:10px;color:#9ca4ae}footer a{color:#7c8991;text-decoration:none}.arrow{margin-left:5px}@media(min-width:1500px){main{padding-top:60px}.preview,.theme-preview{min-height:260px}}@media(max-width:1050px){.sidebar{width:190px;padding:30px 15px}.main{margin-left:190px;width:calc(100% - 190px)}main{padding:32px 26px}header{padding:0 26px}.toolbar{gap:13px}.cards{grid-template-columns:1fr}.preview,.theme-preview{min-height:180px}}@media(max-width:650px){.sidebar{display:none}.main{margin-left:0;width:100%}header{height:60px;padding:0 20px}main{padding:28px 20px}.title-row{align-items:flex-start;gap:12px}h1{font-size:29px}.badge{font-size:8px}.toolbar{flex-wrap:wrap;gap:16px}.toolbar-divider{display:none}.field{gap:8px}.reset{margin-left:0}.local{display:none}footer{gap:20px;line-height:1.8}}
+</style>
+</head>
+<body>
+<div class="app">
+<aside class="sidebar">
+<div class="brand"><span class="brand-icon">t</span>typeform<span style="color:#a9eed7">.</span></div>
+<div class="workspace">THE WORKSPACE</div>
+<nav aria-label="Main navigation">
+<a class="nav" href="#overview"><svg viewBox="0 0 20 20"><rect x="3" y="3" width="5" height="5" rx="1"/><rect x="12" y="3" width="5" height="5" rx="1"/><rect x="3" y="12" width="5" height="5" rx="1"/><rect x="12" y="12" width="5" height="5" rx="1"/></svg>Overview</a>
+<a class="nav active" href="#playground" aria-current="page"><svg viewBox="0 0 20 20"><path d="M3 5h14M10 5v12M6 17h8M3 8V5m14 3V5"/></svg>Font harmony</a>
+<a class="nav" href="#implementation"><svg viewBox="0 0 20 20"><path d="m7 5-5 5 5 5m6-10 5 5-5 5m-2-12-2 14"/></svg>Implementation</a>
+</nav>
+<div class="sidebar-bottom"><span class="dot"></span>A little more typographic balance.<br><span class="version">CSS EXPLORATIONS / VOL. 01</span></div>
+</aside>
+<div class="main">
+<header><div class="breadcrumb">Workspace <span style="color:#bbc2c9">/</span><span>Font harmony</span></div><div class="header-right"><span class="local"><span class="dot"></span>Live playground</span><span class="avatar">TF</span></div></header>
+<main id="overview">
+<div class="eyebrow">THE TYPOGRAPHY LAB</div>
+<div class="title-row"><div><h1>Different fonts. Same rhythm.</h1><p class="intro">Bring your text and code into harmony with a little modern CSS.</p></div><span class="badge">CSS Fonts Level 5</span></div>
+<section id="playground" aria-label="Font harmony playground">
+<div class="toolbar"><label class="field" for="font-family">Text family <select id="font-family"><option value="Arial, Helvetica, sans-serif">Arial · Sans serif</option><option value="Georgia, 'Times New Roman', serif">Georgia · Serif</option><option value="Verdana, sans-serif">Verdana · Sans serif</option></select></label><div class="toolbar-divider"></div><label class="field" for="font-size">Font size <input type="range" min="16" max="32" value="24" id="font-size"><output class="size-output" for="font-size" id="size-output">24 px</output></label><button class="reset" id="reset" type="button"><span aria-hidden="true">↺</span> Reset</button></div>
+<div class="cards">
+<article class="card"><div class="card-head"><span class="card-title"><span class="number">01</span>Mixed fonts</span><span class="pill">AUTO NORMALIZED</span></div><div class="preview"><div class="preview-label">ONE LINE. TWO FONT FAMILIES.<div class="toggle">Normalize <button class="switch" id="normalize" type="button" role="switch" aria-checked="true" aria-label="Normalize mixed font heights"></button></div></div><p id="mixed-fonts-container">Good typography makes <code>code</code> feel right at home.</p><p class="preview-note">Regular text + inline monospace, sharing the same x-height.</p></div><div class="card-footer"><span>Font-size adjustment</span><code id="adjustment-label">from-font</code></div></article>
+<article class="card"><div class="card-head"><span class="card-title"><span class="number">02</span>Independent theme</span><span class="pill purple">FIXED ASPECT VALUE</span></div><div class="theme-preview"><div class="preview-label">A LITTLE WORLD OF ITS OWN <span style="color:#a18db7">◇</span></div><div id="independent-theme-container">A different voice.<br>The same <code>balance</code>.</div><p class="preview-note">A serif theme with its own carefully set proportions.</p></div><div class="card-footer theme-footer"><span>Font-size adjustment</span><code>0.5</code></div></article>
+</div>
+<div class="info"><span class="info-icon" aria-hidden="true">i</span><div><strong>Small property. Noticeable difference.</strong> <code>font-size-adjust</code> aligns fonts by their lowercase height. Use <code>from-font</code> to follow your primary font, or a numeric value to give a theme its own proportions.</div></div>
+</section>
+<section id="implementation"><div class="section-heading"><h2>Under the hood</h2><span>Simple, by design.</span></div><div class="editor"><div class="editor-top"><div class="tabs" role="tablist" aria-label="Implementation language"><button class="tab active" id="css-tab" type="button" role="tab" aria-selected="true" aria-controls="code-panel">CSS</button><button class="tab" id="html-tab" type="button" role="tab" aria-selected="false" aria-controls="code-panel" tabindex="-1">HTML</button></div><button class="copy" id="copy" type="button">▢ &nbsp; Copy code</button></div><div class="code-area" id="code-panel" role="tabpanel" aria-labelledby="css-tab"><div class="line-numbers" aria-hidden="true" id="line-numbers"></div><pre id="code-display"></pre></div></div></section>
+<footer><span>Built for the details that make reading feel better.</span><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/font-size-adjust" target="_blank" rel="noopener noreferrer">Explore font-size-adjust <span class="arrow">↗</span></a></footer>
+</main>
+</div>
+</div>
+<script>
+const paragraph=document.getElementById('mixed-fonts-container');
+const family=document.getElementById('font-family');
+const size=document.getElementById('font-size');
+const normalize=document.getElementById('normalize');
+const cssTab=document.getElementById('css-tab');
+const htmlTab=document.getElementById('html-tab');
+let activeTab='css';
+let currentCode='';
+function renderCode(){
+ const enabled=normalize.getAttribute('aria-checked')==='true';
+ const css=`/* Normalize mixed fonts automatically */\n#mixed-fonts-container {\n  font-family: ${family.value};\n  font-size: ${size.value}px;\n  font-size-adjust: ${enabled?'from-font':'none'};\n}\n\n/* Give this theme its own aspect value */\n#independent-theme-container {\n  font-size-adjust: 0.5;\n}`;
+ const html='<p id="mixed-fonts-container">\n  Good typography makes <code>code</code>\n  feel right at home.\n</p>\n\n<div id="independent-theme-container">\n  A different voice.<br>\n  The same <code>balance</code>.\n</div>';
+ currentCode=activeTab==='css'?css:html;
+ const display=document.getElementById('code-display');
+ display.textContent=currentCode;
+ if(activeTab==='css'){
+  display.replaceChildren(...currentCode.split('\n').flatMap((line,index)=>{
+   const span=document.createElement('span');
+   span.className=line.startsWith('/*')?'comment':line.startsWith('#')?'selector':line.trim().includes(':')?'property':'';
+   span.textContent=line;return index?[document.createTextNode('\n'),span]:[span];
+  }));
+ }
+ document.getElementById('line-numbers').textContent=currentCode.split('\n').map((_,i)=>i+1).join('\n');
+}
+function update(){const enabled=normalize.getAttribute('aria-checked')==='true';paragraph.style.fontFamily=family.value;paragraph.style.fontSize=size.value+'px';paragraph.style.fontSizeAdjust=enabled?'from-font':'none';document.getElementById('size-output').value=size.value+' px';document.getElementById('adjustment-label').textContent=enabled?'from-font':'none';document.querySelector('.pill').textContent=enabled?'AUTO NORMALIZED':'ORIGINAL METRICS';renderCode()}
+family.addEventListener('change',update);size.addEventListener('input',update);normalize.addEventListener('click',()=>{normalize.setAttribute('aria-checked',normalize.getAttribute('aria-checked')==='true'?'false':'true');update()});
+document.getElementById('reset').addEventListener('click',()=>{family.selectedIndex=0;size.value=24;normalize.setAttribute('aria-checked','true');update()});
+function setTab(tab){activeTab=tab;for(const button of [cssTab,htmlTab]){const selected=button.id===tab+'-tab';button.classList.toggle('active',selected);button.setAttribute('aria-selected',String(selected));button.tabIndex=selected?0:-1}document.getElementById('code-panel').setAttribute('aria-labelledby',tab+'-tab');renderCode()}
+cssTab.addEventListener('click',()=>setTab('css'));htmlTab.addEventListener('click',()=>setTab('html'));
+for(const button of [cssTab,htmlTab])button.addEventListener('keydown',event=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){event.preventDefault();const tab=event.key==='Home'?'css':event.key==='End'?'html':activeTab==='css'?'html':'css';setTab(tab);document.getElementById(tab+'-tab').focus()}});
+document.getElementById('copy').addEventListener('click',async()=>{const button=document.getElementById('copy');try{await navigator.clipboard.writeText(currentCode);button.textContent='✓ Copied'}catch{button.textContent='Select code to copy';const selection=window.getSelection();const range=document.createRange();range.selectNodeContents(document.getElementById('code-display'));selection.removeAllRanges();selection.addRange(range)}setTimeout(()=>button.textContent='▢  Copy code',2200)});
+renderCode();
+</script>
+</body>
+</html>
