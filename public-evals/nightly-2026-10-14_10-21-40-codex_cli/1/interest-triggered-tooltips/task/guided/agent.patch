+  <script>
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+    let activeTooltip;
+    let closeTimer;
+
+    function positionTooltip() {
+      if (!activeTooltip) return;
+      const { trigger, tooltip } = activeTooltip;
+      const button = trigger.getBoundingClientRect();
+      const { width, height } = tooltip.getBoundingClientRect();
+      const gap = 8;
+      let left = button.right + gap;
+      let top = button.top + (button.height - height) / 2;
+
+      if (left + width > window.innerWidth - gap) {
+        left = button.left - width - gap;
+      }
+      if (left < gap) {
+        left = button.left + (button.width - width) / 2;
+        top = button.bottom + gap;
+        if (top + height > window.innerHeight - gap) {
+          top = button.top - height - gap;
+        }
+      }
+      tooltip.style.left = `${Math.max(gap, Math.min(left, window.innerWidth - width - gap))}px`;
+      tooltip.style.top = `${Math.max(gap, Math.min(top, window.innerHeight - height - gap))}px`;
+    }
+
+    function closeTooltip() {
+      clearTimeout(closeTimer);
+      if (!activeTooltip) return;
+      const { tooltip } = activeTooltip;
+      if (supportsPopover) tooltip.hidePopover();
+      tooltip.hidden = true;
+      activeTooltip = undefined;
+    }
+
+    function scheduleClose() {
+      clearTimeout(closeTimer);
+      closeTimer = setTimeout(() => {
+        if (!activeTooltip) return;
+        const { trigger, tooltip } = activeTooltip;
+        if (!trigger.matches(':hover') && !tooltip.matches(':hover') &&
+            document.activeElement !== trigger) closeTooltip();
+      }, 150);
+    }
+
+    document.querySelectorAll('[data-tooltip]').forEach((trigger) => {
+      const tooltip = document.getElementById(trigger.dataset.tooltip);
+      function openTooltip() {
+        clearTimeout(closeTimer);
+        if (activeTooltip?.trigger === trigger) return;
+        closeTooltip();
+        tooltip.hidden = false;
+        if (supportsPopover) tooltip.showPopover();
+        activeTooltip = { trigger, tooltip };
+        positionTooltip();
+      }
+      trigger.addEventListener('mouseenter', openTooltip);
+      trigger.addEventListener('focus', openTooltip);
+      trigger.addEventListener('mouseleave', scheduleClose);
+      trigger.addEventListener('blur', scheduleClose);
+      tooltip.addEventListener('mouseenter', () => clearTimeout(closeTimer));
+      tooltip.addEventListener('mouseleave', scheduleClose);
+    });
+
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape') closeTooltip();
+    });
+    document.addEventListener('pointerdown', (event) => {
+      if (activeTooltip && !activeTooltip.trigger.contains(event.target) &&
+          !activeTooltip.tooltip.contains(event.target)) closeTooltip();
+    });
+    window.addEventListener('resize', positionTooltip);
+    document.addEventListener('scroll', positionTooltip, true);
+  </script>
