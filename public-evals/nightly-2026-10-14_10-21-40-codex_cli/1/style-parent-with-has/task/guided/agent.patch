+  <script>
+    const contactForm = document.getElementById('contact-form');
+    const syncInvalidState = (event) => {
+      const field = event.target;
+      if (!field.matches('input, textarea')) return;
+      if (event.type === 'invalid' || field.matches(':user-invalid')) {
+        field.setAttribute('aria-invalid', 'true');
+      } else {
+        field.removeAttribute('aria-invalid');
+      }
+    };
+
+    contactForm.addEventListener('blur', syncInvalidState, true);
+    contactForm.addEventListener('input', syncInvalidState);
+    contactForm.addEventListener('invalid', syncInvalidState, true);
+    // Keep entered messages on the page until a delivery endpoint is connected.
+    contactForm.addEventListener('submit', (event) => event.preventDefault());
+  </script>
+
