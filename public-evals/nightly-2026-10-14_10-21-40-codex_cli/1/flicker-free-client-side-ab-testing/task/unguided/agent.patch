+  <script>
+    (() => {
+      let finished = false;
+      let timer;
+      const reveal = () => {
+        if (finished) return;
+        finished = true;
+        clearTimeout(timer);
+        document.documentElement.classList.remove('experiment-pending');
+        document.removeEventListener('experiment:ready', reveal);
+      };
+      // The SDK must dispatch this event AFTER its DOM changes are committed.
+      document.addEventListener('experiment:ready', reveal);
+      const fallback = () => {
+        if (finished) return;
+        const apply = () => {
+          if (finished) return;
+          // Apply a complete local fallback variant before revealing any content.
+          document.querySelector('[data-experiment-heading]').innerHTML = 'A little structure.<br>A lot of <em>possibility.</em>';
+          document.querySelector('[data-experiment-cta]').textContent = 'Find your flow';
+          document.documentElement.dataset.experimentStatus = 'fallback';
+          reveal();
+        };
+        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply, { once: true });
+        else apply();
+      };
+      window.formaExperiment = { ready: reveal, fallback };
+      timer = setTimeout(fallback, 3000);
+    })();
+  </script>
