+import { useEffect, useRef, useState } from 'react';
+import { languages, MAX_TEXT_LENGTH } from '../lib/translation';
+import './translator.css';
+
+function Icon({ name, size = 20 }: { name: string; size?: number }) {
+  const paths: Record<string, React.ReactNode> = {
+    arrow: <path d="M4 12h16m-6-6 6 6-6 6" />,
+    swap: <><path d="M4 8h16l-4-4M20 16H4l4 4" /></>,
+    copy: <><rect x="8" y="8" width="12" height="13" rx="2" /><path d="M16 8V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h4" /></>,
+    sound: <><path d="m11 4-6 5H2v6h3l6 5V4Zm4 4a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /></>,
+    globe: <><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18M5 6h14M5 18h14" /></>,
+    close: <path d="m6 6 12 12M6 18 18 6" />,
+    check: <path d="m5 12 4 4L19 6" />,
+    book: <><path d="M12 5v16M12 5C8 2 4 3 2 4v15c3-1 7-1 10 2 3-3 7-3 10-2V4c-2-1-6-2-10 1Z" /></>,
+  };
+  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">{paths[name]}</svg>;
+}
+
+export default function Translator() {
+  const [source, setSource] = useState('en');
+  const [target, setTarget] = useState('es');
+  const [text, setText] = useState('');
+  const [translation, setTranslation] = useState('');
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const requestRef = useRef<AbortController | null>(null);
+  const inputRef = useRef<HTMLTextAreaElement>(null);
+  useEffect(() => () => { requestRef.current?.abort(); window.speechSynthesis?.cancel(); }, []);
+  function invalidate() {
+    requestRef.current?.abort(); requestRef.current = null;
+    setLoading(false); setTranslation(''); setError(''); setNotice('');
+    window.speechSynthesis?.cancel();
+  }
+  async function translate() {
+    if (!text.trim()) return;
+    requestRef.current?.abort();
+    const controller = new AbortController(); requestRef.current = controller;
+    setLoading(true); setError(''); setNotice(''); setTranslation('');
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/translate`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ text, source, target }), signal: controller.signal,
+      });
+      const data = await response.json();
+      if (!response.ok) throw new Error(data.error || 'Translation failed. Please try again.');
+      if (requestRef.current === controller) setTranslation(data.translation);
+    } catch (err) {
+      if (requestRef.current === controller && !controller.signal.aborted) setError(err instanceof Error ? err.message : 'Unable to connect. Please try again.');
+    } finally { if (requestRef.current === controller) setLoading(false); }
+  }
+  async function copy() {
+    try { await navigator.clipboard.writeText(translation); setNotice('Translation copied to clipboard.'); }
+    catch { setNotice('Could not copy. Select the translation and copy it manually.'); }
+  }
+  function speak(value: string, language: string) {
+    if (!('speechSynthesis' in window)) { setNotice('Read aloud is unavailable in this browser.'); return; }
+    window.speechSynthesis.cancel();
+    const speech = new SpeechSynthesisUtterance(value); speech.lang = language;
+    speech.onerror = () => setNotice('Read aloud is unavailable for this language.');
+    window.speechSynthesis.speak(speech);
+  }
+  const targetName = languages.find(([code]) => code === target)?.[1];
+  return <section className="translation-workspace" aria-labelledby="translation-title">
+    <div className="translator-breadcrumb"><a href={import.meta.env.BASE_URL}>The DevTools Times</a><span>/</span><span>Translate</span></div>
+    <div className="translator-intro">
+      <div><div className="translator-eyebrow"><span /> WORDS WITHOUT BORDERS</div>
+        <h1 id="translation-title">A little less lost<br />in <em>translation.</em></h1>
+        <p>New perspectives start with understanding.<br className="desktop-break" /> Translate your words, and connect with the world.</p>
+      </div>
+      <div className="language-art" aria-hidden="true"><span className="art-orbit" /><span className="art-a">A</span><span className="art-character">あ</span><span className="art-small">Hola.</span><span className="art-spark">✳</span><span className="art-caption">Different languages. Shared meaning.</span></div>
+    </div>
+    <div className="translator-card">
+      <div className="translator-toolbar">
+        <div className="translator-language"><span>FROM</span><select aria-label="Source language" value={source} onChange={e => { invalidate(); setSource(e.target.value); }}>{languages.map(([code, name]) => <option key={code} value={code}>{name}</option>)}</select></div>
+        <button className="swap-button" aria-label="Swap languages" title="Swap languages" onClick={() => { const result = translation; invalidate(); setSource(target); setTarget(source); if (result) setText(result.slice(0, MAX_TEXT_LENGTH)); }}><Icon name="swap" /></button>
+        <div className="translator-language"><span>TO</span><select aria-label="Target language" value={target} onChange={e => { invalidate(); setTarget(e.target.value); }}>{languages.map(([code, name]) => <option key={code} value={code}>{name}</option>)}</select></div>
+      </div>
+      <div className="translator-panels">
+        <div className="translator-source">
+          <label className="sr-only" htmlFor="translate-input">Text to translate</label>
+          <textarea id="translate-input" ref={inputRef} placeholder="Enter your text here…" value={text} maxLength={MAX_TEXT_LENGTH} dir="auto" onChange={e => { invalidate(); setText(e.target.value); }} onKeyDown={e => { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); void translate(); } }} />
+          {text && <button className="clear-button" aria-label="Clear text" onClick={() => { invalidate(); setText(''); inputRef.current?.focus(); }}><Icon name="close" size={17} /></button>}
+          <div className="panel-actions"><button className="icon-button" disabled={!text.trim()} aria-label="Listen to source text" onClick={() => speak(text, source)}><Icon name="sound" /></button><span>{text.length} / {MAX_TEXT_LENGTH}</span></div>
+        </div>
+        <div className="translator-result" aria-busy={loading}>
+          {translation ? <p className="translated-text" dir="auto" aria-live="polite">{translation}</p> : <div className="result-placeholder"><span className={loading ? 'translation-symbol is-loading' : 'translation-symbol'}><Icon name="globe" size={28} /></span><p>{loading ? 'Finding the right words…' : 'Your translation will appear here'}</p><span>{loading ? `Translating into ${targetName}` : 'A new language. The same idea.'}</span></div>}
+          <div className="panel-actions"><button className="icon-button" disabled={!translation} aria-label="Listen to translation" onClick={() => speak(translation, target)}><Icon name="sound" /></button><button className="icon-button" disabled={!translation} aria-label="Copy translation" onClick={copy}><Icon name="copy" /></button></div>
+        </div>
+      </div>
+      <div className="translator-bottom"><span><Icon name="globe" size={15} /> {languages.length} languages. Endless possibilities.</span><button className="translate-button" disabled={loading || !text.trim()} onClick={translate}>{loading ? 'Translating…' : 'Translate text'}<Icon name="arrow" size={18} /></button></div>
+    </div>
+    {error && <p className="translation-error" role="alert">{error}</p>}
+    <p className="translation-notice" role="status">{notice}</p>
+    <div className="translator-helper"><span>Try a little inspiration</span>{['Hello, how are you?', 'The world is full of possibilities.', 'Thank you for your kindness.'].map(sample => <button key={sample} onClick={() => { invalidate(); setText(sample); setSource('en'); inputRef.current?.focus(); }}>{sample}<span>↗</span></button>)}</div>
+    <div className="translator-features">
+      <div><span className="feature-icon"><Icon name="globe" /></span><h2>A world of languages</h2><p>From Spanish to Japanese, find the words<br />to make yourself understood.</p></div>
+      <div><span className="feature-icon"><Icon name="book" /></span><h2>Made for the everyday</h2><p>A headline, a hello, a new idea.<br />Make sense of the moments that matter.</p></div>
+      <div><span className="feature-icon"><Icon name="copy" /></span><h2>Take your words with you</h2><p>Listen to a translation or copy it.<br />Your next conversation starts here.</p></div>
+    </div>
+    <div className="translator-footnote"><span className="footnote-star">✳</span><p>A small tool for a more connected world.</p><span>Powered by <a href="https://mymemory.translated.net/" target="_blank" rel="noreferrer">MyMemory</a>. Text is sent to this service for translation.</span></div>
+  </section>;
+}
