new file mode 100644
index 0000000..e210b40
--- /dev/null
+++ b/src/lib/translation.ts
@@ -0,0 +1,27 @@
+export const languages = [
+  ['en', 'English'], ['es', 'Spanish'], ['fr', 'French'], ['de', 'German'],
+  ['it', 'Italian'], ['pt', 'Portuguese'], ['nl', 'Dutch'], ['pl', 'Polish'],
+  ['uk', 'Ukrainian'], ['ar', 'Arabic'], ['hi', 'Hindi'], ['ja', 'Japanese'],
+  ['ko', 'Korean'], ['zh', 'Chinese'], ['tr', 'Turkish'], ['ru', 'Russian'],
+] as const;
+export const MAX_TEXT_LENGTH = 500;
+
+// Keep each provider request within its 500-byte UTF-8 limit, preferring word boundaries.
+export function splitText(text: string): string[] {
+  const chunks: string[] = [];
+  let remaining = text;
+  const encoder = new TextEncoder();
+  while (encoder.encode(remaining).length > 480) {
+    let part = '';
+    for (const char of remaining) {
+      if (encoder.encode(part + char).length > 480) break;
+      part += char;
+    }
+    const boundary = part.lastIndexOf(' ');
+    if (boundary > part.length / 2) part = part.slice(0, boundary + 1);
+    chunks.push(part);
+    remaining = remaining.slice(part.length);
+  }
+  if (remaining) chunks.push(remaining);
+  return chunks;
+}
diff --git a/src/pages/api/translate.ts b/src/pages/api/translate.ts
new file mode 100644
index 0000000..910cf9e
--- /dev/null
+++ b/src/pages/api/translate.ts
@@ -0,0 +1,37 @@
+import type { APIRoute } from 'astro';
+import { languages, MAX_TEXT_LENGTH, splitText } from '../../lib/translation';
+
+const json = (data: unknown, status = 200) => new Response(JSON.stringify(data), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+export const POST: APIRoute = async ({ request }) => {
+  let body;
+  try { body = await request.json(); }
+  catch { return json({ error: 'Please send a valid translation request.' }, 400); }
+  const { text, source, target } = body ?? {};
+  if (typeof text !== 'string' || !text.trim() || text.length > MAX_TEXT_LENGTH) {
+    return json({ error: 'Enter between 1 and 500 characters to translate.' }, 400);
+  }
+  if (![source, target].every(code => languages.some(([language]) => language === code))) {
+    return json({ error: 'Please select a supported language.' }, 400);
+  }
+  if (source === target) return json({ translation: text });
+  try {
+    const translations = await Promise.all(splitText(text).map(async chunk => {
+      const url = new URL('https://api.mymemory.translated.net/get');
+      url.searchParams.set('q', chunk.trim());
+      url.searchParams.set('langpair', `${source}|${target}`);
+      const response = await fetch(url, { signal: AbortSignal.timeout(12000) });
+      if (!response.ok) throw new Error('provider');
+      const data = await response.json();
+      if (Number(data.responseStatus) !== 200 || data.quotaFinished || typeof data.responseData?.translatedText !== 'string') {
+        throw new Error('provider');
+      }
+      return data.responseData.translatedText;
+    }));
+    return json({ translation: translations.join(' ') });
+  } catch {
+    return json({ error: 'The translation service is unavailable or has reached its daily limit. Please try again later.' }, 503);
+  }
+};
