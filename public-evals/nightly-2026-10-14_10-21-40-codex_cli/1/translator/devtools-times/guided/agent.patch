@@ -0,0 +1,61 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { translateText, type TranslatorAPI } from '../src/utils/translation.ts';
+
+const pair = { sourceLanguage: 'en', targetLanguage: 'es' };
+
+test('creates immediately, forwards language pair and text, reports progress, and releases the model', async () => {
+  let created = false;
+  let destroyed = false;
+  const progress: number[] = [];
+  const api: TranslatorAPI = {
+    availability: async () => 'available',
+    create: async options => {
+      created = true;
+      assert.equal(options.sourceLanguage, 'en');
+      assert.equal(options.targetLanguage, 'es');
+      options.monitor?.({ addEventListener: (_type, callback) => callback({ loaded: 0.456 }) });
+      return {
+        translate: async text => { assert.equal(text, 'Hello'); return 'Hola'; },
+        destroy: () => { destroyed = true; },
+      };
+    },
+  };
+  const pending = translateText(api, pair, 'Hello', value => progress.push(value), new AbortController().signal);
+  assert.equal(created, true, 'create runs before yielding user activation');
+  assert.equal(await pending, 'Hola');
+  assert.deepEqual(progress, [46]);
+  assert.equal(destroyed, true);
+});
+
+test('releases the model even when translation fails', async () => {
+  let destroyed = false;
+  const api: TranslatorAPI = {
+    availability: async () => 'available',
+    create: async () => ({
+      translate: async () => { throw new Error('Translation failed'); },
+      destroy: () => { destroyed = true; },
+    }),
+  };
+  await assert.rejects(translateText(api, pair, 'Hello', () => {}, new AbortController().signal), /Translation failed/);
+  assert.equal(destroyed, true);
+});
+
+test('abandoning a request during model creation skips translation and releases the model', async () => {
+  const controller = new AbortController();
+  let destroyed = false;
+  let translated = false;
+  const api: TranslatorAPI = {
+    availability: async () => 'available',
+    create: async () => {
+      controller.abort();
+      return {
+        translate: async () => { translated = true; return 'Hola'; },
+        destroy: () => { destroyed = true; },
+      };
+    },
+  };
+  await assert.rejects(translateText(api, pair, 'Hello', () => {}, controller.signal), { name: 'AbortError' });
+  assert.equal(translated, false);
+  assert.equal(destroyed, true);
+});
