@@ -0,0 +1,153 @@
+import { useEffect, useRef, useState } from 'react';
+import { ArrowsRightLeftIcon, ClipboardDocumentIcon, LanguageIcon, XMarkIcon } from '@heroicons/react/24/outline';
+import { languages, translateText, type Availability, type TranslatorAPI } from '../utils/translation';
+
+const limit = 5000;
+const control = 'rounded border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:opacity-50';
+const action = 'inline-flex items-center gap-2 rounded px-3 py-2 text-sm font-semibold hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-amber-600 disabled:opacity-40';
+
+export default function TextTranslator() {
+  const [source, setSource] = useState('en');
+  const [target, setTarget] = useState('es');
+  const [text, setText] = useState('');
+  const [result, setResult] = useState('');
+  const [availability, setAvailability] = useState<Availability | 'checking' | 'unsupported'>('checking');
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState('');
+  const [error, setError] = useState('');
+  const [progress, setProgress] = useState<number | null>(null);
+  const request = useRef<AbortController | null>(null);
+  const revision = useRef(0);
+  const api = () => (window as Window & { Translator?: TranslatorAPI }).Translator;
+
+  useEffect(() => {
+    let active = true;
+    setAvailability('checking');
+    const translator = api();
+    if (!translator) {
+      setAvailability('unsupported');
+    } else if (source === target) {
+      setAvailability('available');
+    } else {
+      translator.availability({ sourceLanguage: source, targetLanguage: target })
+        .then(value => { if (active) setAvailability(value); })
+        .catch(() => { if (active) setAvailability('unavailable'); });
+    }
+    return () => { active = false; };
+  }, [source, target]);
+
+  useEffect(() => () => { request.current?.abort(); revision.current++; }, []);
+
+  function reset() {
+    revision.current++;
+    setResult(''); setError(''); setMessage(''); setProgress(null);
+  }
+
+  async function translate(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!text.trim() || busy) return;
+    reset();
+    if (source === target) { setResult(text); setMessage('Translation ready.'); return; }
+    const translator = api();
+    if (!translator || availability === 'checking' || availability === 'unavailable') return;
+    const controller = new AbortController();
+    request.current = controller;
+    setBusy(true);
+    setMessage(availability === 'available' ? 'Translating…' : 'Preparing your language pack…');
+    try {
+      const translated = await translateText(translator,
+        { sourceLanguage: source, targetLanguage: target }, text,
+        percent => {
+          if (!controller.signal.aborted) {
+            setProgress(percent);
+            setMessage(percent < 100 ? `Downloading language pack: ${percent}%` : 'Translating…');
+          }
+        }, controller.signal);
+      if (!controller.signal.aborted) {
+        setResult(translated); setMessage('Translation ready.'); setAvailability('available');
+      }
+    } catch {
+      if (!controller.signal.aborted) {
+        setMessage('');
+        setError('We couldn’t translate this text. Check your connection if a language pack needs downloading, then try again.');
+      }
+    } finally {
+      if (!controller.signal.aborted) { setBusy(false); setProgress(null); }
+      if (request.current === controller) request.current = null;
+    }
+  }
+
+  function swap() {
+    const previous = source;
+    setSource(target); setTarget(previous);
+    if (result) setText(result);
+    reset();
+  }
+
+  async function copy() {
+    const current = revision.current;
+    try {
+      await navigator.clipboard.writeText(result);
+      if (revision.current === current) setMessage('Translation copied to clipboard.');
+    } catch {
+      if (revision.current === current) setError('Copy is unavailable. Select the translation and copy it manually.');
+    }
+  }
+
+  const blocked = availability === 'unsupported' || availability === 'unavailable' || availability === 'checking';
+  const languageName = (code: string) => languages.find(([value]) => value === code)?.[1];
+
+  return (
+    <form onSubmit={translate}>
+      <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-2 text-sm font-semibold"><LanguageIcon className="h-5 w-5" aria-hidden="true" /> Text translation</div>
+        <span className="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-900">On-device translation</span>
+      </div>
+      <div className="overflow-hidden rounded-lg border border-gray-300">
+        <div className="grid grid-cols-[1fr_auto_1fr] items-center gap-2 border-b border-gray-300 bg-gray-50 p-4 sm:gap-5 sm:px-6">
+          <div className="min-w-0"><label htmlFor="source-language" className="mb-2 block text-xs font-semibold uppercase tracking-wider text-gray-500">From</label>
+            <select id="source-language" value={source} disabled={busy} onChange={e => { reset(); setSource(e.target.value); }} className={`${control} w-full`}>
+              {languages.map(([code, name]) => <option key={code} value={code}>{name}</option>)}
+            </select>
+          </div>
+          <button type="button" className={`${action} mt-6 px-2`} onClick={swap} disabled={busy} aria-label="Swap languages" title="Swap languages"><ArrowsRightLeftIcon className="h-5 w-5" aria-hidden="true" /></button>
+          <div className="min-w-0"><label htmlFor="target-language" className="mb-2 block text-xs font-semibold uppercase tracking-wider text-gray-500">To</label>
+            <select id="target-language" value={target} disabled={busy} onChange={e => { reset(); setTarget(e.target.value); }} className={`${control} w-full`}>
+              {languages.map(([code, name]) => <option key={code} value={code}>{name}</option>)}
+            </select>
+          </div>
+        </div>
+        <div className="grid divide-y divide-gray-200 md:grid-cols-2 md:divide-x md:divide-y-0">
+          <div className="p-4 sm:p-6">
+            <div className="mb-3 flex h-8 items-center justify-between"><label htmlFor="source-text" className="text-sm font-semibold">Original text</label>
+              <button type="button" className={action} disabled={!text || busy} onClick={() => { setText(''); reset(); }} aria-label="Clear text"><XMarkIcon className="h-4 w-4" aria-hidden="true" /></button>
+            </div>
+            <textarea id="source-text" value={text} lang={source} dir="auto" disabled={busy} maxLength={limit} onChange={e => { setText(e.target.value); reset(); }} placeholder="Type or paste the text you’d like to translate…" aria-describedby="text-limit" className="min-h-64 w-full resize-y rounded bg-transparent p-2 text-lg leading-relaxed placeholder:text-gray-400 focus-visible:outline-2 focus-visible:outline-amber-600" />
+            <div className="mt-3 flex items-center justify-between gap-3 text-xs text-gray-500">
+              <button type="button" disabled={busy} onClick={() => { setText('The world is full of stories. A new language opens the door to more of them.'); setSource('en'); reset(); }} className="rounded font-semibold text-gray-700 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-amber-600 disabled:opacity-40">Try an example</button>
+              <span id="text-limit">{text.length.toLocaleString()} / 5,000 characters</span>
+            </div>
+          </div>
+          <div className="bg-gray-50/70 p-4 sm:p-6" aria-busy={busy}>
+            <div className="mb-3 flex h-8 items-center justify-between"><label htmlFor="translated-text" className="text-sm font-semibold">{languageName(target)} translation</label>
+              <button type="button" className={action} disabled={!result || busy} onClick={copy}><ClipboardDocumentIcon className="h-4 w-4" aria-hidden="true" /> Copy</button>
+            </div>
+            <textarea id="translated-text" value={result} readOnly lang={target} dir="auto" placeholder="Your translation will appear here." className="min-h-64 w-full resize-y rounded bg-transparent p-2 text-lg leading-relaxed placeholder:text-gray-400 focus-visible:outline-2 focus-visible:outline-amber-600" />
+            <p className="mt-3 text-xs text-gray-500">Translated text can be selected and copied.</p>
+          </div>
+        </div>
+      </div>
+      <div className="mt-5 flex flex-wrap items-center justify-between gap-4">
+        <p className="max-w-xl text-xs leading-relaxed text-gray-500">The first translation may download a language pack. After that, you can translate offline.</p>
+        <button type="submit" disabled={busy || blocked || !text.trim()} className="inline-flex items-center gap-2 rounded bg-gray-900 px-7 py-3 text-sm font-semibold text-white hover:bg-gray-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-600 disabled:cursor-not-allowed disabled:opacity-40"><LanguageIcon className="h-5 w-5" aria-hidden="true" />{busy ? 'Translating…' : 'Translate text'}</button>
+      </div>
+      <div role="status" className="mt-4 text-sm text-gray-600">
+        {availability === 'unsupported' ? <p className="rounded border border-amber-200 bg-amber-50 p-4 text-amber-950">On-device translation is unavailable in this browser. Try a supported desktop browser, such as a recent version of Chrome or Edge.</p>
+          : availability === 'unavailable' ? <p className="rounded border border-amber-200 bg-amber-50 p-4 text-amber-950">This language pair is unavailable on your device. Choose another pair of languages.</p>
+          : availability === 'checking' ? 'Checking language availability…' : message}
+      </div>
+      {progress !== null && <progress value={progress} max={100} aria-label="Language pack download" className="mt-2 w-full accent-amber-500" />}
+      {error && <p role="alert" className="mt-3 text-sm text-red-700">{error}</p>}
+    </form>
+  );
+}
