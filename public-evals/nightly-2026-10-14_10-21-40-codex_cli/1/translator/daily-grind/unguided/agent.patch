diff --git a/app.js b/app.js
new file mode 100644
index 0000000..737b355
--- /dev/null
+++ b/app.js
@@ -0,0 +1,147 @@
+const languages = [ ['en', 'English'], ['es', 'Spanish'], ['fr', 'French'], ['de', 'German'], ['it', 'Italian'], ['pt', 'Portuguese'], ['nl', 'Dutch'], ['ja', 'Japanese'], ['ko', 'Korean'], ['zh-CN', 'Chinese (Simplified)'], ['ar', 'Arabic'], ['hi', 'Hindi'], ['tr', 'Turkish'], ['uk', 'Ukrainian'], ['pl', 'Polish'], ['ru', 'Russian'], ['sv', 'Swedish'], ['el', 'Greek'], ['vi', 'Vietnamese'], ['id', 'Indonesian'] ];
+const sourceLanguage = document.querySelector('#source-language');
+const targetLanguage = document.querySelector('#target-language');
+const sourceText = document.querySelector('#source-text');
+const output = document.querySelector('#translated-text');
+const translateButton = document.querySelector('#translate-button');
+const copyButton = document.querySelector('#copy-result');
+const listenSource = document.querySelector('#listen-source');
+const listenResult = document.querySelector('#listen-result');
+const status = document.querySelector('#status');
+let requestController;
+let revision = 0;
+for (const [code, name] of languages) {
+  sourceLanguage.add(new Option(name, code));
+  targetLanguage.add(new Option(name, code));
+}
+sourceLanguage.value = 'en';
+targetLanguage.value = 'es';
+function message(text = '', error = false) {
+  status.textContent = text;
+  status.hidden = !text;
+  status.classList.toggle('error', error);
+}
+function updateControls() {
+  document.querySelector('#character-count').textContent = `${sourceText.value.length} / 500`;
+  document.querySelector('#clear-text').hidden = !sourceText.value;
+  document.querySelector('#output-language').textContent = targetLanguage.selectedOptions[0].text.toUpperCase();
+  sourceText.dir = sourceLanguage.value === 'ar' ? 'rtl' : 'auto';
+  copyButton.disabled = !output.value;
+  listenSource.disabled = !sourceText.value.trim() || !('speechSynthesis' in window);
+  listenResult.disabled = !output.value || !('speechSynthesis' in window);
+}
+function invalidate() {
+  revision++;
+  requestController?.abort();
+  output.value = '';
+  translateButton.disabled = false;
+  translateButton.innerHTML = 'Translate text <svg><use href="#arrow"/></svg>';
+  copyButton.querySelector('span').textContent = 'Copy translation';
+  window.speechSynthesis?.cancel();
+  message();
+  updateControls();
+}
+sourceText.addEventListener('input', invalidate);
+sourceLanguage.addEventListener('change', invalidate);
+targetLanguage.addEventListener('change', invalidate);
+document.querySelector('#clear-text').addEventListener('click', () => {
+  sourceText.value = '';
+  invalidate();
+  sourceText.focus();
+});
+document.querySelector('#swap-languages').addEventListener('click', () => {
+  const previousSource = sourceLanguage.value;
+  sourceLanguage.value = targetLanguage.value;
+  targetLanguage.value = previousSource;
+  if (output.value) sourceText.value = output.value.slice(0, 500);
+  invalidate();
+});
+document.querySelectorAll('[data-example]').forEach(button => button.addEventListener('click', () => {
+  sourceLanguage.value = 'en';
+  sourceText.value = button.dataset.example;
+  invalidate();
+  sourceText.focus();
+}));
+// Decode the HTML entities returned by translation providers without inserting markup.
+function decodeEntities(text) {
+  const doc = new DOMParser().parseFromString(text, 'text/html');
+  return doc.body.textContent || '';
+}
+document.querySelector('#translation-form').addEventListener('submit', async event => {
+  event.preventDefault();
+  const text = sourceText.value.trim();
+  if (!text) { message('Enter some text to translate.', true); sourceText.focus(); return; }
+  if (sourceLanguage.value === targetLanguage.value) {
+    output.value = text;
+    message('Both languages are the same. Your text is ready to copy.');
+    updateControls();
+    return;
+  }
+  if (new TextEncoder().encode(text).length > 500) {
+    message('Please shorten your text. The translation service allows 500 UTF-8 bytes per request; some characters use more than one byte.', true);
+    return;
+  }
+  requestController?.abort();
+  const controller = new AbortController();
+  requestController = controller;
+  const currentRevision = ++revision;
+  translateButton.disabled = true;
+  translateButton.innerHTML = 'Translating… <svg><use href="#globe"/></svg>';
+  message('Finding the right words…');
+  const timeout = setTimeout(() => controller.abort(), 20000);
+  try {
+    const query = new URLSearchParams({ q: text, langpair: `${sourceLanguage.value}|${targetLanguage.value}` });
+    const response = await fetch(`https://api.mymemory.translated.net/get?${query}`, { signal: controller.signal });
+    if (!response.ok) throw new Error('The translation service is unavailable. Please try again shortly.');
+    const data = await response.json();
+    if (Number(data.responseStatus) !== 200 || data.quotaFinished) {
+      throw new Error(data.quotaFinished || Number(data.responseStatus) === 429 ? 'The translation service’s daily limit has been reached. Please try again later.' : 'This translation could not be completed. Please try another language or try again later.');
+    }
+    if (!data.responseData?.translatedText) throw new Error('No translation was returned. Please try again.');
+    if (currentRevision !== revision) return;
+    output.value = decodeEntities(data.responseData.translatedText);
+    message('Translation ready.');
+    updateControls();
+  } catch (error) {
+    if (currentRevision !== revision) return;
+    message(error.name === 'AbortError' ? 'The request took too long. Please try again.' : error instanceof TypeError ? 'Could not connect to the translation service. Check your internet connection and try again.' : error.message, true);
+  } finally {
+    clearTimeout(timeout);
+    if (currentRevision === revision) {
+      translateButton.disabled = false;
+      translateButton.innerHTML = 'Translate text <svg><use href="#arrow"/></svg>';
+    }
+  }
+});
+sourceText.addEventListener('keydown', event => {
+  if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
+    event.preventDefault();
+    if (!translateButton.disabled) document.querySelector('#translation-form').requestSubmit();
+  }
+});
+copyButton.addEventListener('click', async () => {
+  try {
+    await navigator.clipboard.writeText(output.value);
+    copyButton.querySelector('span').textContent = 'Copied!';
+    message('Translation copied to your clipboard.');
+  } catch {
+    output.focus();
+    output.select();
+    message('Select and copy the translation using Ctrl+C or Command+C.');
+  }
+});
+function speak(text, language) {
+  if (!text || !('speechSynthesis' in window)) return;
+  window.speechSynthesis.cancel();
+  const utterance = new SpeechSynthesisUtterance(text);
+  utterance.lang = language;
+  const voice = window.speechSynthesis.getVoices().find(voice => voice.lang.toLowerCase().startsWith(language.toLowerCase()));
+  if (voice) utterance.voice = voice;
+  utterance.onerror = event => {
+    if (!['interrupted', 'canceled'].includes(event.error)) message('Pronunciation is unavailable for this language on your device.', true);
+  };
+  window.speechSynthesis.speak(utterance);
+}
+listenSource.addEventListener('click', () => speak(sourceText.value, sourceLanguage.value));
+listenResult.addEventListener('click', () => speak(output.value, targetLanguage.value));
+updateControls();
