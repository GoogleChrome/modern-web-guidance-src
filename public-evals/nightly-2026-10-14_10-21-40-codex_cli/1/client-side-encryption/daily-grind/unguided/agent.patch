diff --git a/tests/crypto.test.js b/tests/crypto.test.js
new file mode 100644
index 0000000..d0f5fe4
--- /dev/null
+++ b/tests/crypto.test.js
@@ -0,0 +1,36 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { generateRecipient, establish, encryptData, decryptData, wipeRecipient } from '../crypto.js';
+for (const mode of ['classical', 'hybrid', 'quantum']) {
+  test(`${mode}: recipient round trip and authentication`, async () => {
+    const recipient = generateRecipient(mode);
+    const session = await establish(mode, recipient);
+    const plaintext = new TextEncoder().encode('Sensitive information — 🔐');
+    const output = await encryptData(session, plaintext, 'document-123');
+    assert.deepEqual(await decryptData(session, output), plaintext);
+    await assert.rejects(() => decryptData(session, { ...output, context: 'altered' }));
+    const ciphertext = (output.ciphertext[0] === 'A' ? 'B' : 'A') + output.ciphertext.slice(1);
+    await assert.rejects(() => decryptData(session, { ...output, ciphertext }));
+    const next = await encryptData(session, plaintext);
+    assert.notEqual(next.iv, output.iv);
+    const imported = await establish(mode, { publicKey: JSON.parse(JSON.stringify(recipient.publicKey)) });
+    assert.equal(imported.receiverKey, null);
+    await assert.rejects(() => decryptData(imported, output));
+    wipeRecipient(recipient);
+    Object.values(recipient.privateKey).forEach(key => assert.ok(key.every(byte => byte === 0)));
+  });
+}
+test('Binary file round trip exceeds string spread limits', async () => {
+  const recipient = generateRecipient('hybrid');
+  const session = await establish('hybrid', recipient);
+  const bytes = new Uint8Array(200000);
+  bytes.set(crypto.getRandomValues(new Uint8Array(60000)));
+  const envelope = await encryptData(session, bytes, '', 'sample.bin');
+  assert.deepEqual(await decryptData(session, envelope), bytes);
+  wipeRecipient(recipient);
+});
+test('Reject a recipient key from another protection mode', async () => {
+  const recipient = generateRecipient('classical');
+  await assert.rejects(() => establish('hybrid', recipient), /protection mode/);
+  wipeRecipient(recipient);
+});
