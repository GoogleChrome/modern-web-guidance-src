@@ -0,0 +1,62 @@
+import { ml_kem768 } from '@noble/post-quantum/ml-kem.js';
+import { ml_kem768_x25519 } from '@noble/post-quantum/hybrid.js';
+const encoder = new TextEncoder();
+export const encode64 = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes)));
+export const decode64 = text => Uint8Array.from(atob(text.trim()), c => c.charCodeAt(0));
+const kemFor = suite => suite === 'hybrid' ? ml_kem768_x25519 : ml_kem768;
+export async function fingerprint(publicKey) {
+  const bytes = new Uint8Array(await crypto.subtle.digest('SHA-256', publicKey));
+  return Array.from(bytes.slice(0, 12), b => b.toString(16).padStart(2, '0')).join('').match(/.{4}/g).join(' ');
+}
+export async function generateRecipient(suite) {
+  if (!['hybrid','pq','classical'].includes(suite)) throw new Error('Unsupported key suite');
+  if (suite !== 'classical') {
+    const pair = kemFor(suite).keygen();
+    return {suite, publicKey:pair.publicKey, secretKey:pair.secretKey};
+  }
+  let pair, algorithm = 'X25519';
+  try { pair = await crypto.subtle.generateKey('X25519', false, ['deriveBits']); }
+  catch { algorithm = 'ECDH'; pair = await crypto.subtle.generateKey({name:'ECDH',namedCurve:'P-256'}, false, ['deriveBits']); }
+  return {suite, algorithm, pair, publicKey:new Uint8Array(await crypto.subtle.exportKey('raw', pair.publicKey))};
+}
+export function importRecipient(suite, text) {
+  const publicKey = decode64(text);
+  const size = suite === 'hybrid' ? 1216 : suite === 'pq' ? 1184 : publicKey.length === 65 ? 65 : 32;
+  if (publicKey.length !== size) throw new Error(`This suite requires a ${size}-byte public key.`);
+  return {suite, publicKey, algorithm: publicKey.length === 65 ? 'ECDH' : 'X25519', imported:true};
+}
+async function aesKey(shared, salt, metadata) {
+  const base = await crypto.subtle.importKey('raw', shared, 'HKDF', false, ['deriveKey']);
+  return crypto.subtle.deriveKey({name:'HKDF',hash:'SHA-256',salt,info:encoder.encode(JSON.stringify(metadata))},base,{name:'AES-GCM',length:256},false,['encrypt','decrypt']);
+}
+async function classicalSecret(privateKey, publicKey, algorithm) {
+  const peer = await crypto.subtle.importKey('raw',publicKey,algorithm === 'ECDH' ? {name:'ECDH',namedCurve:'P-256'} : 'X25519',false,[]);
+  return new Uint8Array(await crypto.subtle.deriveBits({name:algorithm,public:peer},privateKey,256));
+}
+export async function encryptPayload(recipient, bytes, context = 'cipher-envelope-v1', filename = '') {
+  let shared, capsule;
+  if(recipient.suite !== 'classical') {
+    const encapsulated = kemFor(recipient.suite).encapsulate(recipient.publicKey);
+    shared = encapsulated.sharedSecret; capsule = encapsulated.cipherText;
+  } else {
+    const ephemeral = await crypto.subtle.generateKey(recipient.algorithm === 'ECDH' ? {name:'ECDH',namedCurve:'P-256'} : 'X25519',false,['deriveBits']);
+    capsule = new Uint8Array(await crypto.subtle.exportKey('raw',ephemeral.publicKey));
+    shared = await classicalSecret(ephemeral.privateKey,recipient.publicKey,recipient.algorithm);
+  }
+  const metadata = {version:1,suite:recipient.suite,cipher:'AES-256-GCM',recipient:await fingerprint(recipient.publicKey),context,filename};
+  const salt = crypto.getRandomValues(new Uint8Array(32));
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const key = await aesKey(shared,salt,metadata); shared.fill(0);
+  const ciphertext = new Uint8Array(await crypto.subtle.encrypt({name:'AES-GCM',iv,additionalData:encoder.encode(JSON.stringify(metadata)),tagLength:128},key,bytes));
+  // Chunk encoding keeps large file envelopes within the browser's argument limit.
+  let ct = ''; for(let i=0;i<ciphertext.length;i+=8192) ct += String.fromCharCode(...ciphertext.subarray(i,i+8192));
+  return {metadata,salt:encode64(salt),capsule:encode64(capsule),iv:encode64(iv),ciphertext:btoa(ct)};
+}
+export async function decryptPayload(recipient,envelope) {
+  if (recipient.imported) throw new Error('Decryption requires the recipient’s private key.');
+  if (envelope.metadata.suite !== recipient.suite) throw new Error('Key suite mismatch');
+  const capsule = decode64(envelope.capsule);
+  const shared = recipient.suite === 'classical' ? await classicalSecret(recipient.pair.privateKey,capsule,recipient.algorithm) : kemFor(recipient.suite).decapsulate(capsule,recipient.secretKey);
+  const key = await aesKey(shared,decode64(envelope.salt),envelope.metadata); shared.fill(0);
+  return new Uint8Array(await crypto.subtle.decrypt({name:'AES-GCM',iv:decode64(envelope.iv),additionalData:encoder.encode(JSON.stringify(envelope.metadata)),tagLength:128},key,decode64(envelope.ciphertext)));
+}
diff --git a/crypto.test.js b/crypto.test.js
