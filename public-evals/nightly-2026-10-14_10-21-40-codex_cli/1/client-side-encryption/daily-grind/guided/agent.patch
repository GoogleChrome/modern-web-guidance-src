@@ -0,0 +1,23 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {generateRecipient,encryptPayload,decryptPayload,decode64,encode64,importRecipient} from './crypto.js';
+for (const suite of ['hybrid','pq','classical']) {
+  test(`${suite}: binary round trip, fresh IV, tamper rejection, wrong recipient rejection`, async () => {
+    const recipient = await generateRecipient(suite);
+    const bytes = new Uint8Array([0,255,128,42,1,0]);
+    const env = await encryptPayload(recipient,bytes,'test-context','binary.dat');
+    assert.deepEqual(await decryptPayload(recipient,env),bytes);
+    const next = await encryptPayload(recipient,bytes);
+    assert.notEqual(next.iv,env.iv);
+    assert.equal(decode64(env.iv).length,12);
+    const modified = structuredClone(env); const ciphertext=decode64(modified.ciphertext);ciphertext[0]^=1;modified.ciphertext=encode64(ciphertext);
+    await assert.rejects(decryptPayload(recipient,modified));
+    const metadata = structuredClone(env);metadata.metadata.filename='tampered.dat';
+    await assert.rejects(decryptPayload(recipient,metadata));
+    await assert.rejects(decryptPayload(await generateRecipient(suite),env));
+    const imported=importRecipient(suite,encode64(recipient.publicKey));
+    const importedEnvelope=await encryptPayload(imported,bytes);
+    assert.deepEqual(await decryptPayload(recipient,importedEnvelope),bytes);
+  });
+}
+test('reject invalid imported key',()=>assert.throws(()=>importRecipient('hybrid','AAAA')));
