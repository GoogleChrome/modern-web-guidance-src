diff --git a/src/lib/session-driver.mjs b/src/lib/session-driver.mjs
new file mode 100644
index 0000000..95dc054
--- /dev/null
+++ b/src/lib/session-driver.mjs
@@ -0,0 +1,27 @@
+// Ephemeral, single-process storage: never write user data to disk.
+// Delete expired entries even when a visitor never returns.
+export default function createSessionDriver({ ttlMs = 86400000, maxEntries = 10000 } = {}) {
+  const entries = new Map();
+  function remove(key) {
+    const entry = entries.get(key);
+    if (entry) clearTimeout(entry.timer);
+    entries.delete(key);
+  }
+  return {
+    async getItem(key) {
+      const entry = entries.get(key);
+      if (!entry) return null;
+      if (entry.expires <= Date.now()) { remove(key); return null; }
+      return entry.value;
+    },
+    async setItem(key, value) {
+      remove(key);
+      // Bound memory; oldest sessions may expire early under load.
+      if (entries.size >= maxEntries) remove(entries.keys().next().value);
+      const timer = setTimeout(() => remove(key), ttlMs);
+      timer.unref?.();
+      entries.set(key, { value, expires: Date.now() + ttlMs, timer });
+    },
+    async removeItem(key) { remove(key); },
+  };
+}
