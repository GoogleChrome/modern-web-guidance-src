+test('rendered article pages use local images and authorize their own inline scripts', async () => {
+  const articles = await (await fetch(`${base}api/articles.json`)).json();
+  for (const article of articles) {
+    assert.ok(article.image.startsWith('/images/'), article.slug);
+    const response = await fetch(`${base}articles/${article.slug}`);
+    assert.equal(response.status, 200, article.slug);
+    assert.equal(response.headers.get('set-cookie'), null);
+    const html = await response.text();
+    const policy = response.headers.get('content-security-policy');
+    assert.match(policy, /connect-src 'self'/);
+    for (const [, attributes, content] of html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/gi)) {
+      if (/\bsrc=/.test(attributes) || /type="application\/(?:json|ld\+json)"/.test(attributes)) continue;
+      const hash = createHash('sha256').update(content).digest('base64');
+      assert.ok(policy.includes(`'sha256-${hash}'`), `Inline script blocked on ${article.slug}`);
+    }
+  }
+});
