@@ -0,0 +1,27 @@
+import { useState } from 'react';
+
+export default function PrivacyControls() {
+  const [message, setMessage] = useState('');
+  const [busy, setBusy] = useState(false);
+  async function clearData() {
+    setBusy(true);
+    try {
+      const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, { method: 'DELETE' });
+      if (!response.ok) throw new Error();
+      setMessage('Your reading list and its session cookie have been deleted.');
+    } catch {
+      setMessage('We could not delete your reading list. Please try again.');
+    } finally { setBusy(false); }
+  }
+  return (
+    <div className="my-6 p-4 border border-gray-300 rounded-lg">
+      <h2 className="text-xl font-bold">Manage your reading list</h2>
+      <p>Download your saved article IDs or delete all saved articles for this browser.</p>
+      <div className="flex flex-wrap gap-4 items-center">
+        <a href={`${import.meta.env.BASE_URL}api/reading-list.json?export=1`} download="reading-list.json" className="underline">Download my data</a>
+        <button onClick={clearData} disabled={busy} className="px-4 py-2 rounded bg-gray-900 text-white disabled:opacity-50">{busy ? 'Deleting…' : 'Delete my data'}</button>
+      </div>
+      <p role="status" aria-live="polite">{message}</p>
+    </div>
+  );
+}
