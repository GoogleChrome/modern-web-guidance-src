+  origin = `http://127.0.0.1:${port}`;
+  base = `${origin}/devtools-times/`;
+  server = spawn(process.execPath, ['dist/server/entry.mjs'], {
+    env: { ...process.env, HOST: '127.0.0.1', PORT: String(port), NODE_ENV: 'production' },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  server.stdout.on('data', data => { logs += data; });
+  server.stderr.on('data', data => { logs += data; });
+  for (let i = 0; i < 100; i++) {
+    try { if ((await fetch(`${base}api/reading-list.json`)).ok) return; } catch {}
+    if (server.exitCode !== null) break;
+    await delay(50);
+  }
+  throw new Error(`Server did not become ready: ${logs}`);
+});
+after(async () => {
+  if (server && server.exitCode === null) {
+    const exited = new Promise(resolve => server.once('exit', resolve));
+    server.kill();
+    await exited;
+  }
+});
+
+const post = (body, extra = {}) => fetch(`${base}api/reading-list.json`, {
+  method: 'POST', headers: { Origin: origin, 'Content-Type': 'application/json', ...extra }, body,
+});
+
+test('browsing is cookieless and security headers cover HTML and API', async () => {
+  for (const path of ['', 'legal/privacy', 'signin', 'signup', 'api/reading-list.json', 'missing-page']) {
+    const response = await fetch(base + path);
+    assert.equal(response.headers.get('set-cookie'), null, path);
+    assert.equal(response.headers.get('x-content-type-options'), 'nosniff');
+    assert.equal(response.headers.get('x-frame-options'), 'DENY');
+    assert.equal(response.headers.get('referrer-policy'), 'no-referrer');
+    assert.match(response.headers.get('cache-control'), /no-store/);
+    assert.match(response.headers.get('permissions-policy'), /geolocation=\(\)/);
+    assert.match(response.headers.get('content-security-policy'), /frame-ancestors 'none'/);
+    const text = await response.text();
+    assert.doesNotMatch(text, /fonts\.googleapis|fonts\.gstatic|analytics-client|ad-client|i\.imgur\.com|cinemai-102/);
+    if (path === '' || path === 'legal/privacy') {
+      const policy = response.headers.get('content-security-policy');
+      assert.match(policy, /connect-src 'self'/);
+      assert.match(policy, /script-src[^;]*sha256-/);
+      assert.doesNotMatch(policy, /script-src[^;]*unsafe-inline/);
+    }
+    if (path === 'signin' || path === 'signup') assert.doesNotMatch(text, /type="password"/);
+  }
+});
+
+test('mutations reject missing or foreign origins, including DELETE', async () => {
+  for (const method of ['POST', 'DELETE']) {
+    for (const headers of [{}, { Origin: 'https://example.invalid' },
+      { 'Content-Type': 'application/json' },
+      { Origin: 'https://example.invalid', 'Content-Type': 'application/json' }]) {
+      const response = await fetch(`${base}api/reading-list.json`, { method, headers });
+      assert.equal(response.status, 403);
+      // JSON mutations must also be rejected by application middleware.
+      if (headers['Content-Type']) assert.match(response.headers.get('cache-control'), /no-store/);
+      assert.equal(response.headers.get('set-cookie'), null);
+    }
+  }
+});
+
+test('invalid or excessive input creates no session', async () => {
+  for (const [body, expected] of [
+    ['{', 400], ['null', 400], ['[]', 400], ['{}', 400],
+    ['{"slug":42}', 400], ['{"slug":"../secret"}', 400],
+    ['{"slug":"housing-crisis","email":"unneeded"}', 400],
+    ['{"slug":"unknown-article"}', 404], ['x'.repeat(1025), 413],
+  ]) {
+    const response = await post(body);
+    assert.equal(response.status, expected, body.slice(0, 80));
+    assert.equal(response.headers.get('set-cookie'), null);
+  }
+  assert.equal((await post('{}', { 'Content-Type': 'text/plain' })).status, 415);
+});
+
+test('reading list stores only IDs, isolates sessions, exports and deletes', async () => {
+  const saved = await post('{"slug":"housing-crisis"}');
+  assert.equal(saved.status, 200);
+  assert.deepEqual(await saved.json(), { readingList: ['housing-crisis'] });
+  const cookieHeader = saved.headers.get('set-cookie');
+  assert.match(cookieHeader, /HttpOnly/i);
+  assert.match(cookieHeader, /Secure/i);
+  assert.match(cookieHeader, /SameSite=Strict/i);
+  assert.match(cookieHeader, /Max-Age=86400/i);
+  const cookie = cookieHeader.split(';')[0];
+  assert.doesNotMatch(cookie, /housing-crisis/);
+  const own = await fetch(`${base}api/reading-list.json?export=1`, { headers: { Cookie: cookie } });
+  assert.deepEqual(await own.json(), { readingList: ['housing-crisis'] });
+  assert.match(own.headers.get('content-disposition'), /attachment/);
+  assert.deepEqual(await (await fetch(`${base}api/reading-list.json`)).json(), { readingList: [] });
+  const deleted = await fetch(`${base}api/reading-list.json`, {
+    method: 'DELETE', headers: { Cookie: cookie, Origin: origin },
+  });
+  assert.equal(deleted.status, 200);
+  assert.match(deleted.headers.get('set-cookie'), /Expires=Thu, 01 Jan 1970/i);
+  assert.deepEqual(await (await fetch(`${base}api/reading-list.json`, { headers: { Cookie: cookie } })).json(), { readingList: [] });
+});
+
+test('removing last saved article destroys its session', async () => {
+  const saved = await post('{"slug":"housing-crisis"}');
+  const cookie = saved.headers.get('set-cookie').split(';')[0];
+  const removed = await post('{"slug":"housing-crisis"}', { Cookie: cookie });
+  assert.deepEqual(await removed.json(), { readingList: [] });
+  assert.match(removed.headers.get('set-cookie'), /Expires=Thu, 01 Jan 1970/i);
+});
+
+test('session storage expires, deletes and bounds retained data', async () => {
+  const driver = createSessionDriver({ ttlMs: 20, maxEntries: 2 });
+  await driver.setItem('a', 'one');
+  await driver.setItem('b', 'two');
+  await driver.setItem('c', 'three');
+  assert.equal(await driver.getItem('a'), null);
+  await driver.removeItem('b');
+  assert.equal(await driver.getItem('b'), null);
+  assert.equal(await driver.getItem('c'), 'three');
+  await delay(30);
+  assert.equal(await driver.getItem('c'), null);
+});
