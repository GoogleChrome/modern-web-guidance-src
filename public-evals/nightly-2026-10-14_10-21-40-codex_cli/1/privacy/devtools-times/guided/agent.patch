diff --git a/scripts/audit-privacy.mjs b/scripts/audit-privacy.mjs
new file mode 100644
index 0000000..a4462fc
--- /dev/null
+++ b/scripts/audit-privacy.mjs
@@ -0,0 +1,28 @@
+import { readdir, readFile } from 'node:fs/promises';
+const failures = [];
+const patterns = [
+  /<(?:script|iframe|img)\b[^>]*\bsrc=["'`]https?:\/\//i,
+  /<link\b[^>]*\bhref=["'`]https?:\/\//i,
+  /fetch\(\s*["'`]https?:\/\//,
+  /(?:localStorage|sessionStorage)\s*\./,
+  /crossorigin\s*=\s*["']use-credentials["']/i,
+  /document\.cookie\s*=/,
+  /(?:image|src)\s*:\s*["']https?:\/\//,
+];
+async function scan(dir) {
+  for (const entry of await readdir(dir, { withFileTypes: true })) {
+    const path = `${dir}/${entry.name}`;
+    if (entry.isDirectory()) await scan(path);
+    else if (/\.(astro|tsx?|md|css)$/.test(path)) {
+      const lines = (await readFile(path, 'utf8')).split('\n');
+      lines.forEach((line, i) => {
+        if (patterns.some(pattern => pattern.test(line))) failures.push(`${path}:${i + 1}`);
+      });
+    }
+  }
+}
+await scan('src');
+if (failures.length) {
+  console.error('Privacy review required for remote resource or browser data handling:', failures.join(', '));
+  process.exitCode = 1;
+} else console.log('Source privacy audit passed: no remote resources, credentialed images, or browser storage.');
diff --git a/scripts/privacy.test.mjs b/scripts/privacy.test.mjs
new file mode 100644
index 0000000..139357b
--- /dev/null
+++ b/scripts/privacy.test.mjs
@@ -0,0 +1,100 @@
+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { spawn } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { setTimeout as delay } from 'node:timers/promises';
+import createSessionDriver from '../src/server/session-driver.mjs';
+
+let server;
+const origin = 'http://localhost:14329';
+const base = `${origin}/devtools-times/`;
+const endpoint = `${base}api/reading-list.json`;
+before(async () => {
+  server = spawn(process.execPath, ['dist/server/entry.mjs'], {
+    env: { ...process.env, HOST: '127.0.0.1', PORT: '14329' }, stdio: 'ignore',
+  });
+  for (let i = 0; i < 100; i++) {
+    try { if ((await fetch(base)).ok) return; } catch {}
+    await delay(50);
+  }
+  throw new Error('Built application did not start');
+});
+after(() => server?.kill());
+const mutate = (body, cookie = '', requestOrigin = origin, method = 'POST') => fetch(endpoint, {
+  method,
+  headers: { Origin: requestOrigin, 'Content-Type': 'application/json', ...(cookie ? { Cookie: cookie } : {}) },
+  ...(body === undefined ? {} : { body: typeof body === 'string' ? body : JSON.stringify(body) }),
+});
+
+test('public pages have privacy headers, CSP hashes, local resources and no guest cookie', async () => {
+  const articles = await (await fetch(`${base}api/articles.json`)).json();
+  for (const path of ['', 'signin', 'signup', 'legal/privacy', 'reports', 'multimedia', ...articles.map(article => `articles/${article.slug}`)]) {
+    const res = await fetch(`${base}${path}`);
+    assert.equal(res.status, 200);
+    assert.equal(res.headers.get('set-cookie'), null);
+    assert.equal(res.headers.get('referrer-policy'), 'no-referrer');
+    assert.equal(res.headers.get('x-content-type-options'), 'nosniff');
+    assert.equal(res.headers.get('x-frame-options'), 'DENY');
+    assert.match(res.headers.get('permissions-policy'), /camera=\(\)/);
+    assert.match(res.headers.get('cache-control'), /no-store/);
+    assert.match(res.headers.get('content-security-policy'), /frame-ancestors 'none'/);
+    const html = await res.text();
+    const csp = res.headers.get('content-security-policy');
+    assert.match(csp, /script-src/);
+    assert.doesNotMatch(csp, /unsafe-inline|unsafe-eval/);
+    assert.doesNotMatch(html, /<(?:script|img|iframe|link)\b[^>]*(?:src|href)="https?:\/\//i);
+    for (const script of html.matchAll(/<script([^>]*)>([\s\S]*?)<\/script>/g)) {
+      if (/\bsrc=|type="(?:application\/json|application\/ld\+json)"/.test(script[1]) || !script[2].trim()) continue;
+      const hash = createHash('sha256').update(script[2]).digest('base64');
+      assert.ok(csp.includes(`sha256-${hash}`), `${path}: legitimate script missing CSP hash`);
+    }
+    if (path === 'signin' || path === 'signup') assert.doesNotMatch(html, /type="password"/);
+  }
+});
+
+test('reading lists minimize, validate, export and delete data', async () => {
+  const guest = await fetch(endpoint);
+  assert.equal(guest.headers.get('set-cookie'), null);
+  assert.deepEqual(await guest.json(), { readingList: [] });
+  assert.equal((await mutate({ slug: 'silent-architects' }, '', 'https://other.example')).status, 403);
+  assert.equal((await mutate({ slug: 'silent-architects' }, '', '')).status, 403);
+  const crossSite = await fetch(endpoint, { method: 'POST', headers: { Origin: origin, 'Sec-Fetch-Site': 'cross-site', 'Content-Type': 'application/json' }, body: JSON.stringify({ slug: 'silent-architects' }) });
+  assert.equal(crossSite.status, 403);
+  const wrongType = await fetch(endpoint, { method: 'POST', headers: { Origin: origin, 'Content-Type': 'text/plain' }, body: '{}' });
+  assert.equal(wrongType.status, 415);
+  assert.equal((await mutate('{broken')).status, 400);
+  assert.equal((await mutate({ slug: 'does-not-exist' })).status, 400);
+  assert.equal((await mutate({ slug: 'silent-architects', email: 'unnecessary' })).status, 400);
+  assert.equal((await mutate('x'.repeat(513))).status, 413);
+  const saved = await mutate({ slug: 'silent-architects' });
+  assert.equal(saved.status, 200);
+  const setCookie = saved.headers.get('set-cookie');
+  for (const flag of ['HttpOnly', 'Secure', 'SameSite=Strict', 'Max-Age=86400']) assert.ok(setCookie.toLowerCase().includes(flag.toLowerCase()));
+  assert.match(setCookie, /Path=\/devtools-times\//i);
+  const cookie = setCookie.split(';')[0];
+  assert.deepEqual(await saved.json(), { readingList: ['silent-architects'] });
+  const exported = await fetch(endpoint, { headers: { Cookie: cookie } });
+  assert.match(exported.headers.get('cache-control'), /no-store/);
+  assert.deepEqual(await exported.json(), { readingList: ['silent-architects'] });
+  const denied = await mutate(undefined, cookie, 'https://other.example', 'DELETE');
+  assert.equal(denied.status, 403);
+  const deleted = await mutate(undefined, cookie, origin, 'DELETE');
+  assert.equal(deleted.status, 200);
+  assert.match(deleted.headers.get('set-cookie'), /Expires=Thu, 01 Jan 1970/i);
+  assert.deepEqual(await (await fetch(endpoint, { headers: { Cookie: cookie } })).json(), { readingList: [] });
+});
+
+test('memory storage expires, bounds and deletes retained data', async () => {
+  const driver = createSessionDriver({ ttl: 0.02, capacity: 1 });
+  await driver.setItem('one', { readingList: ['article'] });
+  const copy = await driver.getItem('one');
+  copy.readingList.push('not-persisted');
+  assert.deepEqual(await driver.getItem('one'), { readingList: ['article'] });
+  await driver.setItem('two', {});
+  assert.equal(await driver.getItem('one'), null);
+  await delay(30);
+  assert.equal(await driver.getItem('two'), null);
+  await driver.setItem('three', {});
+  await driver.removeItem('three');
+  assert.equal(await driver.getItem('three'), null);
+});
