diff --git a/src/server/session-driver.mjs b/src/server/session-driver.mjs
new file mode 100644
index 0000000..1731860
--- /dev/null
+++ b/src/server/session-driver.mjs
@@ -0,0 +1,26 @@
+// Ephemeral, bounded storage: reading lists never reach disk or a third party.
+export default function createSessionDriver({ ttl = 86400, capacity = 10000 } = {}) {
+  const entries = new Map();
+  const purge = () => {
+    const now = Date.now();
+    for (const [key, entry] of entries) {
+      if (entry.expires <= now) entries.delete(key);
+    }
+  };
+  const timer = setInterval(purge, 60000);
+  timer.unref();
+  return {
+    async getItem(key) {
+      purge();
+      return entries.has(key) ? structuredClone(entries.get(key).value) : null;
+    },
+    async setItem(key, value) {
+      purge();
+      if (!entries.has(key) && entries.size >= capacity) {
+        entries.delete(entries.keys().next().value);
+      }
+      entries.set(key, { value: structuredClone(value), expires: Date.now() + ttl * 1000 });
+    },
+    async removeItem(key) { entries.delete(key); },
+  };
+}
