+'use strict';
+const key = 'daily-grind-privacy-v1';
+const lifetime = 30 * 24 * 60 * 60 * 1000;
+const toggle = document.querySelector('#remember-toggle');
+const status = document.querySelector('#preference-status');
+let remembered = false;
+let expiresAt = null;
+let toastTimer;
+function notify(message) {
+  const toast = document.querySelector('#toast');
+  toast.textContent = message;
+  toast.hidden = false;
+  clearTimeout(toastTimer);
+  toastTimer = setTimeout(() => { toast.hidden = true; }, 4500);
+}
+function render() {
+  toggle.setAttribute('aria-checked', String(remembered));
+  status.textContent = remembered ? 'Saved on this device for 30 days' : 'Optional storage is off';
+}
+function clearPreference() {
+  remembered = false;
+  expiresAt = null;
+  try { localStorage.removeItem(key); } catch { notify('Browser storage is unavailable. Optional storage stays off.'); }
+  render();
+}
+try {
+  const saved = JSON.parse(localStorage.getItem(key));
+  if (saved && saved.version === 1 && saved.remember === true && Number.isFinite(saved.expiresAt) && saved.expiresAt > Date.now() && saved.expiresAt <= Date.now() + lifetime) {
+    remembered = true;
+    expiresAt = saved.expiresAt;
+  } else { localStorage.removeItem(key); }
+} catch { remembered = false; }
+render();
+toggle.addEventListener('click', () => {
+  if (remembered) { clearPreference(); notify('Preferences reset. Nothing is saved on your device.'); return; }
+  try {
+    expiresAt = Date.now() + lifetime;
+    localStorage.setItem(key, JSON.stringify({ version: 1, remember: true, expiresAt }));
+    remembered = true;
+    render();
+    notify('Your preference is saved on this device for 30 days.');
+  } catch { expiresAt = null; notify('Your browser blocks storage. Your choice has not been saved.'); }
+});
+document.querySelector('#reset-preferences').addEventListener('click', () => { clearPreference(); notify('Privacy defaults restored. Optional storage is off.'); });
+window.addEventListener('storage', (event) => { if (event.key === key || event.key === null) location.reload(); });
+document.querySelector('#export-data').addEventListener('click', () => {
+  const data = { personalData: [], analytics: false, marketing: false, preferences: { remember: remembered, expiresAt: expiresAt ? new Date(expiresAt).toISOString() : null }, scope: 'This browser only. No server-side account or personal data exists.' };
+  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' }));
+  const link = document.createElement('a');
+  link.href = url; link.download = 'daily-grind-privacy.json';
+  document.body.append(link); link.click(); link.remove();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+  notify('Your privacy data has been downloaded.');
+});
+const content = {
+  policy: { title: 'A little less data. A lot more trust.', paragraphs: [
+    'This website does not collect personal information, create accounts, use cookies, or track your browsing. No analytics, advertising, fingerprinting, or third-party embeds are installed.',
+    'If you enable “Remember my preferences,” we store only that choice, a format version, and its expiry time in this browser. It expires after 30 days and is removed on your next visit. Turning it off removes it immediately. Nothing is sent to a server.',
+    'You can download or clear your preferences in “Your data.” All images, styles, and scripts are hosted locally. Our application does not record request logs; your hosting provider may separately process network metadata. Configure the host’s logging and retention before production deployment.',
+    'We do not sell or share personal data. This policy describes this website; it does not cover an in-store purchase or any future ordering service.' ] },
+  audit: { title: 'Our resource audit', paragraphs: [
+    'Reviewed application resources: HTML, JavaScript, CSS, and stock photography. All are delivered from this site. There are zero third-party scripts, fonts, embeds, advertising services, or runtime dependencies.',
+    'Stock photography is sourced from Unsplash, downloaded during development, and hosted locally. Visiting this page does not contact Unsplash.',
+    'The application stores one optional preference record locally, for up to 30 days. There are no cookies, persistent visitor identifiers, or server-side personal data stores.',
+    'This is an internal technical resource review, not an independent certification. The automated audit checks external resources and sensitive browser APIs. Repeat the review whenever an integration changes; hosting providers require a separate operational review.' ] },
+  security: { title: 'Privacy has a strong foundation.', paragraphs: [
+    'The application server sets an enforced Content Security Policy with a fresh script nonce, Trusted Types, blocked framing and plugins, and restricted connections. Images, scripts, and styles are served locally.',
+    'Permissions Policy disables camera, microphone, location, payment, and other unused browser features. Referrer Policy prevents your page address from being shared. MIME-type and cross-origin protections are also configured.',
+    'No passwords, payment information, tokens, or personal profiles are stored. Downloads are generated locally. Clearing saved data removes this application’s preference without affecting other sites.',
+    'Production must be served over HTTPS by the hosting platform. Enable HTTPS_ONLY=1 after TLS is configured to add HSTS. The application is currently informational and does not process orders or payments.' ] },
+  delete: { title: 'Make a fresh start.', paragraphs: [ 'This will remove your saved privacy preference from this browser and restore privacy defaults. There are no account records, personal details, or browsing history to delete.', 'You can still use the site exactly as before. This only affects The Daily Grind’s preference on this device.' ] },
+  story: { title: 'Good coffee. Good intentions.', paragraphs: [ 'The Daily Grind is about the small things done thoughtfully: ethically sourced coffee, a slower morning, and a little care in every cup.', 'That same care belongs in our website. We keep data collection to a minimum, serve every resource ourselves, and give you simple, clear controls.' ] },
+  menu: { title: 'Find your daily favorite.', paragraphs: [ 'Maple Oat Latte — Creamy oat milk with a hint of Vermont maple syrup.', 'Dark Roast Espresso — Bold, smoky, and made for a morning boost.', 'Cold Brew — Steeped for 18 hours for maximum smoothness.', 'Our menu is here to browse. Online ordering and payment processing are not available on this website.' ] }
+};
+const dialog = document.querySelector('#detail-dialog');
+const confirm = document.querySelector('#dialog-confirm');
+function openDialog(name) {
+  const detail = content[name];
+  if (!detail) return;
+  document.querySelector('#dialog-title').textContent = detail.title;
+  const target = document.querySelector('#dialog-content');
+  target.replaceChildren(...detail.paragraphs.map(text => { const paragraph = document.createElement('p'); paragraph.textContent = text; return paragraph; }));
+  confirm.hidden = name !== 'delete';
+  document.querySelector('#dialog-done').textContent = name === 'delete' ? 'Keep my preference' : 'Got it';
+  dialog.showModal();
+}
+document.querySelectorAll('[data-modal]').forEach(button => button.addEventListener('click', () => openDialog(button.dataset.modal)));
+document.querySelector('#close-dialog').addEventListener('click', () => dialog.close());
+document.querySelector('#dialog-done').addEventListener('click', () => dialog.close());
+confirm.addEventListener('click', () => { clearPreference(); dialog.close(); notify('Saved data cleared. You’re back to privacy defaults.'); });
+dialog.addEventListener('click', event => { if (event.target === dialog) { const bounds = dialog.getBoundingClientRect(); if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close(); } });
+document.querySelectorAll('.sidebar nav a').forEach(link => link.addEventListener('click', () => {
+  document.querySelectorAll('.sidebar nav a').forEach(item => { item.classList.remove('selected'); item.removeAttribute('aria-current'); });
+  link.classList.add('selected'); link.setAttribute('aria-current', 'location');
+}));
