new file mode 100644
index 0000000..f2cfdec
--- /dev/null
+++ b/tests/preferences.test.mjs
@@ -0,0 +1,52 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import vm from 'node:vm';
+import { readFile } from 'node:fs/promises';
+const source = await readFile(new URL('../app.js', import.meta.url), 'utf8');
+const key = 'daily-grind-privacy-v1';
+function setup(initial, blocked = false) {
+  const store = new Map(initial ? [[key, JSON.stringify(initial)]] : []);
+  const elements = new Map();
+  const element = selector => {
+    if (!elements.has(selector)) elements.set(selector, { attributes: {}, hidden: false, textContent: '', events: {}, setAttribute(k,v) { this.attributes[k]=v; }, addEventListener(k,v) { this.events[k]=v; } });
+    return elements.get(selector);
+  };
+  vm.runInNewContext(source, {
+    document: { querySelector: element, querySelectorAll: () => [] },
+    localStorage: { getItem: k => { if (blocked) throw Error(); return store.get(k) || null; }, setItem: (k,v) => { if (blocked) throw Error(); store.set(k,v); }, removeItem: k => { if (blocked) throw Error(); store.delete(k); } },
+    window: { addEventListener() {} }, setTimeout: () => 1, clearTimeout() {}, Date, JSON, Number
+  });
+  return { store, element };
+}
+test('optional persistence is off until explicit consent, then can be revoked', () => {
+  const { store, element } = setup();
+  assert.equal(store.size, 0);
+  assert.equal(element('#remember-toggle').attributes['aria-checked'], 'false');
+  element('#remember-toggle').events.click();
+  const record = JSON.parse(store.get(key));
+  assert.deepEqual(Object.keys(record).sort(), ['expiresAt', 'remember', 'version']);
+  assert.equal(record.remember, true);
+  assert.ok(record.expiresAt > Date.now());
+  element('#remember-toggle').events.click();
+  assert.equal(store.size, 0);
+  assert.equal(element('#remember-toggle').attributes['aria-checked'], 'false');
+});
+test('expired preferences are removed and future invalid records are rejected', () => {
+  for (const expiresAt of [Date.now() - 1, Date.now() + 40 * 86400000]) {
+    const { store, element } = setup({ version: 1, remember: true, expiresAt });
+    assert.equal(store.size, 0);
+    assert.equal(element('#remember-toggle').attributes['aria-checked'], 'false');
+  }
+});
+test('blocked storage fails closed without claiming a saved preference', () => {
+  const { element } = setup(null, true);
+  element('#remember-toggle').events.click();
+  assert.equal(element('#remember-toggle').attributes['aria-checked'], 'false');
+  assert.match(element('#toast').textContent, /has not been saved/);
+});
+test('reset deletes the application preference', () => {
+  const { store, element } = setup({ version: 1, remember: true, expiresAt: Date.now() + 86400000 });
+  assert.equal(element('#remember-toggle').attributes['aria-checked'], 'true');
+  element('#reset-preferences').events.click();
+  assert.equal(store.size, 0);
+});
