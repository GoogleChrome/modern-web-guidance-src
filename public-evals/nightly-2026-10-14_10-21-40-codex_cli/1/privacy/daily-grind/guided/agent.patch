+let server, base;
+before(async () => { server = createServer({ httpsOnly: true }); await new Promise(resolve => server.listen(0, '127.0.0.1', resolve)); base = `http://127.0.0.1:${server.address().port}`; });
+after(() => new Promise(resolve => server.close(resolve)));
+test('security policies and fresh nonces are delivered with HTML', async () => {
+  const response = await fetch(base);
+  assert.equal(response.status, 200);
+  const csp = response.headers.get('content-security-policy');
+  const nonce = csp.match(/'nonce-([^']+)'/)[1];
+  assert.match(await response.text(), new RegExp(`nonce="${nonce}"`));
+  assert.match(csp, /frame-ancestors 'none'/);
+  assert.match(csp, /require-trusted-types-for 'script'/);
+  assert.equal(response.headers.get('referrer-policy'), 'no-referrer');
+  assert.equal(response.headers.get('x-content-type-options'), 'nosniff');
+  assert.match(response.headers.get('permissions-policy'), /geolocation=\(\)/);
+  assert.equal(response.headers.get('strict-transport-security'), 'max-age=300');
+  assert.equal(response.headers.get('set-cookie'), null);
+  assert.notEqual((await fetch(base)).headers.get('content-security-policy'), csp);
+});
+test('public resource allowlist prevents source and traversal access', async () => {
+  for (const path of ['/server.mjs', '/package.json', '/tests/privacy.test.mjs', '/%2e%2e%2fpackage.json', '/missing']) assert.equal((await fetch(base + path)).status, 404);
+  assert.equal((await fetch(base, { method: 'POST', body: 'secret' })).status, 405);
+});
+test('cross-site resource requests blocked; navigation allowed', async () => {
+  assert.equal((await fetch(base + '/app.js', { headers: { 'Sec-Fetch-Site': 'cross-site' } })).status, 403);
+  const code = await new Promise((resolve, reject) => {
+    http.get(base, { headers: { 'Sec-Fetch-Site': 'cross-site', 'Sec-Fetch-Mode': 'navigate', 'Sec-Fetch-Dest': 'document' } }, response => { response.resume(); resolve(response.statusCode); }).on('error', reject);
+  });
+  assert.equal(code, 200);
+});
+test('all browser resources are local; no tracking or dangerous sinks', async () => {
+  const html = await readFile(new URL('../index.html', import.meta.url), 'utf8');
+  const css = await readFile(new URL('../styles.css', import.meta.url), 'utf8');
+  const js = await readFile(new URL('../app.js', import.meta.url), 'utf8');
+  assert.doesNotMatch(html, /(?:src|href)=["']https?:\/\//);
+  assert.doesNotMatch(css, /url\(["']?https?:/);
+  assert.doesNotMatch(js, /innerHTML|outerHTML|document\.write|eval\(|sendBeacon|navigator\.geolocation|document\.cookie/);
+  assert.match(js, /localStorage\.removeItem\(key\)/);
