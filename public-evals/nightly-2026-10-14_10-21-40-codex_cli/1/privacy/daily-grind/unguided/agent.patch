+import { createServer } from 'node:http';
+import { readFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+
+// Explicit allowlist prevents source/configuration exposure and path traversal.
+const routes = new Map([
+  ['/', ['index.html', 'text/html; charset=utf-8']],
+  ['/index.html', ['index.html', 'text/html; charset=utf-8']],
+  ['/privacy-policy', ['privacy.html', 'text/html; charset=utf-8']],
+  ['/privacy-review', ['PRIVACY-REVIEW.md', 'text/plain; charset=utf-8']],
+  ['/assets/styles.css', ['assets/styles.css', 'text/css; charset=utf-8']],
+  ['/assets/coffee.jpg', ['assets/coffee.jpg', 'image/jpeg']],
+]);
+export const securityHeaders = {
+  'Content-Security-Policy': "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'none'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
+  'Referrer-Policy': 'no-referrer',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Frame-Options': 'DENY',
+  'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()',
+  'Cross-Origin-Opener-Policy': 'same-origin',
+  'Cross-Origin-Resource-Policy': 'same-origin',
+  'Cache-Control': 'no-store',
+};
+export function createApp({ production = process.env.NODE_ENV === 'production' } = {}) {
+  return createServer(async (request, response) => {
+    const headers = { ...securityHeaders };
+    // Set production mode only behind a TLS-terminating host. Do not trust client forwarding headers.
+    if (production) headers['Strict-Transport-Security'] = 'max-age=31536000';
+    for (const [name, value] of Object.entries(headers)) response.setHeader(name, value);
+    if (!['GET', 'HEAD'].includes(request.method)) {
+      response.writeHead(405, { Allow: 'GET, HEAD', 'Content-Type': 'text/plain; charset=utf-8' });
+      return response.end('Method not allowed');
+    }
+    let pathname;
+    try { pathname = new URL(request.url, 'http://localhost').pathname; }
+    catch { response.writeHead(400); return response.end('Bad request'); }
+    const route = routes.get(pathname);
+    if (!route) {
+      response.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+      return response.end(request.method === 'HEAD' ? undefined : 'Page not found');
+    }
+    try {
+      const body = await readFile(new URL(route[0], import.meta.url));
+      response.writeHead(200, { 'Content-Type': route[1], 'Content-Length': body.length });
+      response.end(request.method === 'HEAD' ? undefined : body);
+    } catch {
+      response.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+      response.end(request.method === 'HEAD' ? undefined : 'Unable to serve page');
+    }
+  });
+}
+if (process.argv[1] === fileURLToPath(import.meta.url)) {
+  const port = Number(process.env.PORT || 11222);
+  createApp().listen(port, '0.0.0.0', () => console.log(`Daily Grind listening on port ${port}`));
+}
