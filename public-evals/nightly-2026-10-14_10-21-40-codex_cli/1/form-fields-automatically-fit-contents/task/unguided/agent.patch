+  <script>
+    const form = document.getElementById('preferences-form');
+    const status = document.getElementById('form-status');
+    const fields = [...form.querySelectorAll('input, textarea, select')];
+    const storageKey = 'daily-grind-preferences';
+
+    try {
+      const saved = JSON.parse(localStorage.getItem(storageKey));
+      if (saved) {
+        fields.forEach(field => {
+          if (typeof saved[field.name] === 'string') field.value = saved[field.name];
+        });
+      }
+    } catch {
+      // The form remains usable when browser storage is unavailable.
+    }
+
+    if (!CSS.supports('field-sizing', 'content')) {
+      const measure = document.createElement('span');
+      measure.style.cssText = 'position:fixed;visibility:hidden;white-space:pre;pointer-events:none;';
+      measure.setAttribute('aria-hidden', 'true');
+      document.body.appendChild(measure);
+
+      function sizeField(field) {
+        const style = getComputedStyle(field);
+        measure.style.font = style.font;
+        measure.style.letterSpacing = style.letterSpacing;
+        const content = field.tagName === 'SELECT'
+          ? field.selectedOptions[0]?.textContent || ''
+          : field.value || field.placeholder || '';
+        const width = Math.max(...content.split('\n').map(line => {
+          measure.textContent = line || ' ';
+          return measure.getBoundingClientRect().width;
+        }));
+        const padding = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
+        const borders = parseFloat(style.borderLeftWidth) + parseFloat(style.borderRightWidth);
+        // Leave room for the native dropdown arrow and text caret.
+        field.style.width = `${Math.ceil(width + padding + borders + (field.tagName === 'SELECT' ? 24 : 3))}px`;
+        if (field.tagName === 'TEXTAREA') {
+          field.style.height = 'auto';
+          field.style.height = `${field.scrollHeight + parseFloat(style.borderTopWidth) + parseFloat(style.borderBottomWidth)}px`;
+        }
+      }
+
+      const sizeFields = () => fields.forEach(sizeField);
+      fields.forEach(field => {
+        field.addEventListener('input', () => sizeField(field));
+        field.addEventListener('change', () => sizeField(field));
+      });
+      window.addEventListener('resize', sizeFields);
+      document.fonts.ready.then(sizeFields);
+      sizeFields();
+    }
+
+    form.addEventListener('input', () => { status.textContent = ''; });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      try {
+        localStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(new FormData(form))));
+        status.textContent = 'Preferences saved on this device. See you for your next cup!';
+      } catch {
+        status.textContent = 'Your browser could not save these preferences. Please try again with browser storage enabled.';
+      }
+    });
+  </script>
