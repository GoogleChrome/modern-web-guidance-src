diff --git a/src/utils/accountForm.ts b/src/utils/accountForm.ts
new file mode 100644
index 0000000..35e360e
--- /dev/null
+++ b/src/utils/accountForm.ts
@@ -0,0 +1,56 @@
+export type AccountAction = 'login' | 'register';
+
+export interface AccountResult {
+  ok: boolean;
+  message: string;
+}
+
+export async function submitAccount(
+  action: AccountAction,
+  formData: FormData,
+): Promise<AccountResult> {
+  const username = formData.get('username');
+  const password = formData.get('password');
+
+  if (typeof username !== 'string' || !username || typeof password !== 'string' || !password) {
+    return { ok: false, message: 'Username and password are required.' };
+  }
+
+  try {
+    const response = await fetch(
+      `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`,
+      {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ username, password }),
+      },
+    );
+    const data = await response.json();
+
+    if (!response.ok) {
+      const reason = typeof data?.error === 'string' ? data.error : 'Unknown error';
+      const operation = action === 'login' ? 'Login' : 'Registration';
+      return { ok: false, message: `${operation} failed: ${reason}` };
+    }
+
+    return {
+      ok: true,
+      message: action === 'login'
+        ? 'Login successful!'
+        : 'User registered successfully! You can now sign in.',
+    };
+  } catch {
+    return { ok: false, message: 'An unexpected error occurred. Please try again later.' };
+  }
+}
+
+/** Hand the same submission result to WebMCP without exposing credentials or tokens. */
+export function respondToAgent(event: Event, result: Promise<AccountResult>): void {
+  const agentEvent = event as Event & {
+    agentInvoked?: boolean;
+    respondWith?: (response: Promise<string>) => void;
+  };
+  if (agentEvent.agentInvoked && typeof agentEvent.respondWith === 'function') {
+    agentEvent.respondWith(result.then((value) => JSON.stringify(value)));
+  }
+}
diff --git a/tests/accountForm.test.mjs b/tests/accountForm.test.mjs
new file mode 100644
index 0000000..1eaac0b
--- /dev/null
+++ b/tests/accountForm.test.mjs
@@ -0,0 +1,74 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { respondToAgent, submitAccount } from '../src/utils/accountForm.ts';
+
+const credentials = () => {
+  const data = new FormData();
+  data.set('username', 'reader');
+  data.set('password', 'example123');
+  return data;
+};
+
+for (const action of ['login', 'register']) {
+  test(`${action} uses submitted fields and returns only status to the agent`, async (t) => {
+    const fetchMock = t.mock.method(globalThis, 'fetch', async (url, options) => {
+      assert.equal(url, `https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`);
+      assert.equal(options.method, 'POST');
+      assert.equal(options.headers['Content-Type'], 'application/json');
+      assert.deepEqual(JSON.parse(options.body), { username: 'reader', password: 'example123' });
+      return Response.json({ token: 'private-token', password: 'example123' });
+    });
+    const result = await submitAccount(action, credentials());
+    assert.equal(result.ok, true);
+    assert.deepEqual(Object.keys(result).sort(), ['message', 'ok']);
+    assert.doesNotMatch(JSON.stringify(result), /private-token|example123/);
+    assert.equal(fetchMock.mock.callCount(), 1);
+  });
+}
+
+test('missing credentials produce an actionable error without a request', async (t) => {
+  const fetchMock = t.mock.method(globalThis, 'fetch', () => assert.fail('Unexpected request'));
+  const result = await submitAccount('login', new FormData());
+  assert.equal(result.ok, false);
+  assert.match(result.message, /required/);
+  assert.equal(fetchMock.mock.callCount(), 0);
+});
+
+test('API errors are returned as useful status messages', async (t) => {
+  t.mock.method(globalThis, 'fetch', async () => Response.json({ error: 'APP_ERR_1001' }, { status: 400 }));
+  assert.deepEqual(await submitAccount('register', credentials()), {
+    ok: false, message: 'Registration failed: APP_ERR_1001',
+  });
+});
+
+test('network and malformed response failures produce the existing UI error', async (t) => {
+  const fetchMock = t.mock.method(globalThis, 'fetch', async () => { throw new Error('Offline'); });
+  const expected = { ok: false, message: 'An unexpected error occurred. Please try again later.' };
+  assert.deepEqual(await submitAccount('login', credentials()), expected);
+  fetchMock.mock.mockImplementation(async () => new Response('<html>Not JSON</html>'));
+  assert.deepEqual(await submitAccount('register', credentials()), expected);
+});
+
+test('agent response is registered synchronously and resolves after submission', async () => {
+  let finish;
+  const submission = new Promise((resolve) => { finish = resolve; });
+  let response;
+  const event = Object.assign(new Event('submit'), {
+    agentInvoked: true,
+    respondWith(promise) { response = promise; },
+  });
+  respondToAgent(event, submission);
+  assert.ok(response instanceof Promise);
+  finish({ ok: true, message: 'Login successful!' });
+  assert.deepEqual(JSON.parse(await response), { ok: true, message: 'Login successful!' });
+});
+
+test('ordinary submits and browsers without WebMCP require no agent API', () => {
+  const result = Promise.resolve({ ok: true, message: 'Login successful!' });
+  respondToAgent(new Event('submit'), result);
+  respondToAgent(Object.assign(new Event('submit'), { agentInvoked: true }), result);
+  respondToAgent(Object.assign(new Event('submit'), {
+    agentInvoked: false,
+    respondWith() { assert.fail('Ordinary submission must not send an agent response'); },
+  }), result);
+});
