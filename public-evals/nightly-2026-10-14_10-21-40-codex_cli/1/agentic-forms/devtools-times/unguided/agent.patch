diff --git a/src/hooks/useAuthForm.ts b/src/hooks/useAuthForm.ts
new file mode 100644
index 0000000..594fa9c
--- /dev/null
+++ b/src/hooks/useAuthForm.ts
@@ -0,0 +1,60 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { submitAuth, type AuthAction, type Credentials, type AuthResult } from '../utils/auth';
+import { registerFormTool } from '../utils/webmcp';
+
+export function useAuthForm(action: AuthAction) {
+  const [username, setUsername] = useState('');
+  const [password, setPassword] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [success, setSuccess] = useState<string | null>(null);
+  const [loading, setLoading] = useState(false);
+  const busy = useRef(false);
+
+  const submit = useCallback(async (input: unknown, signal?: AbortSignal): Promise<AuthResult> => {
+    if (busy.current) return { ok: false, message: 'A submission is already in progress.' };
+    busy.current = true;
+    setLoading(true);
+    setError(null);
+    setSuccess(null);
+    try {
+      const result = await submitAuth(action, input, signal);
+      if (result.ok) {
+        setSuccess(result.message);
+        if (action === 'register') {
+          setUsername('');
+          setPassword('');
+        }
+      } else {
+        setError(result.message);
+      }
+      return result;
+    } finally {
+      busy.current = false;
+      setLoading(false);
+    }
+  }, [action]);
+
+  useEffect(() => registerFormTool({
+    name: action === 'login' ? 'sign_in' : 'sign_up',
+    description: action === 'login'
+      ? 'Submit the sign-in form with a username and password. Returns the login status.'
+      : 'Create an account by submitting the sign-up form. Passwords must be at least 8 characters and contain a number. Returns the registration status.',
+    inputSchema: {
+      type: 'object',
+      properties: {
+        username: { type: 'string', minLength: 1, description: 'Account username.' },
+        password: { type: 'string', minLength: 1, description: 'Account password.' },
+      },
+      required: ['username', 'password'],
+      additionalProperties: false,
+    },
+    execute: async (input, options) => JSON.stringify(await submit(input, options?.signal)),
+  }), [action, submit]);
+
+  const handleSubmit = async (event: React.FormEvent) => {
+    event.preventDefault();
+    await submit({ username, password } satisfies Credentials);
+  };
+
+  return { username, setUsername, password, setPassword, error, success, loading, handleSubmit };
+}
diff --git a/src/utils/auth.ts b/src/utils/auth.ts
new file mode 100644
index 0000000..c816ed2
--- /dev/null
+++ b/src/utils/auth.ts
@@ -0,0 +1,47 @@
+export type AuthAction = 'login' | 'register';
+export interface Credentials {
+  username: string;
+  password: string;
+}
+export interface AuthResult {
+  ok: boolean;
+  message: string;
+}
+
+export async function submitAuth(
+  action: AuthAction,
+  input: unknown,
+  signal?: AbortSignal,
+): Promise<AuthResult> {
+  const credentials = input as Partial<Credentials> | null;
+  if (!credentials || typeof credentials.username !== 'string' || !credentials.username.length ||
+      typeof credentials.password !== 'string' || !credentials.password.length) {
+    return { ok: false, message: 'Username and password are required.' };
+  }
+
+  try {
+    const response = await fetch(`https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/${action}`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: credentials.username, password: credentials.password }),
+      signal,
+    });
+    const data = await response.json();
+    if (!response.ok) {
+      return {
+        ok: false,
+        message: `${action === 'login' ? 'Login' : 'Registration'} failed: ${data.error || 'Unknown error'}`,
+      };
+    }
+    // Return only the form's status, never credentials or authentication tokens.
+    return {
+      ok: true,
+      message: action === 'login' ? 'Login successful!' : 'User registered successfully! You can now sign in.',
+    };
+  } catch {
+    return {
+      ok: false,
+      message: signal?.aborted ? 'Request cancelled.' : 'An unexpected error occurred. Please try again later.',
+    };
+  }
+}
diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..7bf4aed
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,31 @@
+export interface FormTool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: unknown, options?: { signal?: AbortSignal }) => Promise<string>;
+}
+
+interface ModelContext {
+  registerTool: (tool: FormTool, options?: { signal: AbortSignal }) => void | Promise<unknown>;
+  unregisterTool?: (name: string) => void;
+}
+
+// Keep the experimental API optional; support older navigator-based implementations too.
+export function registerFormTool(tool: FormTool): () => void {
+  const context = (document as Document & { modelContext?: ModelContext }).modelContext
+    ?? (navigator as Navigator & { modelContext?: ModelContext }).modelContext;
+  if (!context?.registerTool) return () => {};
+
+  const controller = new AbortController();
+  try {
+    void Promise.resolve(context.registerTool(tool, { signal: controller.signal })).catch(() => {
+      // Registration can be denied by browser policy. The manual form remains available.
+    });
+  } catch {
+    // Unsupported API versions must not interrupt form rendering.
+  }
+  return () => {
+    controller.abort();
+    context.unregisterTool?.(tool.name);
+  };
+}
diff --git a/tests/form-tools.test.ts b/tests/form-tools.test.ts
new file mode 100644
index 0000000..c8c62ff
--- /dev/null
+++ b/tests/form-tools.test.ts
@@ -0,0 +1,86 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { submitAuth } from '../src/utils/auth.ts';
+import { registerFormTool, type FormTool } from '../src/utils/webmcp.ts';
+
+function setBrowserGlobal(t: { after: (cleanup: () => void) => void }, name: string, value: unknown) {
+  const original = Object.getOwnPropertyDescriptor(globalThis, name);
+  Object.defineProperty(globalThis, name, { value, configurable: true });
+  t.after(() => {
+    if (original) Object.defineProperty(globalThis, name, original);
+    else Reflect.deleteProperty(globalThis, name);
+  });
+}
+
+test('both form actions submit credentials and return only the visible status', async (t) => {
+  for (const action of ['login', 'register'] as const) {
+    let requested = false;
+    t.mock.method(globalThis, 'fetch', async (url: string, init: RequestInit) => {
+      requested = true;
+      assert.ok(url.endsWith(`/api/${action}`));
+      assert.equal(init.method, 'POST');
+      assert.deepEqual(JSON.parse(init.body as string), { username: 'reader', password: 'password1' });
+      return Response.json({ token: 'private-token' });
+    });
+    const result = await submitAuth(action, { username: 'reader', password: 'password1' });
+    assert.equal(requested, true);
+    assert.equal(result.ok, true);
+    assert.equal(result.message, action === 'login'
+      ? 'Login successful!' : 'User registered successfully! You can now sign in.');
+    assert.ok(!JSON.stringify(result).includes('private-token'));
+    t.mock.restoreAll();
+  }
+});
+
+test('invalid agent input does not send a request', async (t) => {
+  const fetchMock = t.mock.method(globalThis, 'fetch', async () => { throw new Error('unexpected request'); });
+  for (const input of [null, {}, { username: 'reader' }, { username: 'reader', password: '' }, { username: 42, password: 'pass' }]) {
+    assert.equal((await submitAuth('login', input)).ok, false);
+  }
+  assert.equal(fetchMock.mock.callCount(), 0);
+});
+
+test('API errors, network failures and cancellation produce usable results', async (t) => {
+  t.mock.method(globalThis, 'fetch', async () => Response.json({ error: 'APP_ERR_2001' }, { status: 401 }));
+  assert.deepEqual(await submitAuth('login', { username: 'reader', password: 'pass' }), {
+    ok: false, message: 'Login failed: APP_ERR_2001',
+  });
+  t.mock.restoreAll();
+  t.mock.method(globalThis, 'fetch', async (_url: unknown, options: RequestInit) => {
+    options.signal?.throwIfAborted();
+    throw new Error('offline');
+  });
+  assert.equal((await submitAuth('register', { username: 'reader', password: 'pass' })).ok, false);
+  assert.equal((await submitAuth('login', { username: 'reader', password: 'pass' }, AbortSignal.abort())).message, 'Request cancelled.');
+});
+
+test('registration supports document and legacy navigator APIs and cleans up', async (t) => {
+  const tool: FormTool = {
+    name: 'test_form', description: 'Test form', inputSchema: {}, execute: async () => 'done',
+  };
+  for (const location of ['document', 'navigator']) {
+    let signal: AbortSignal | undefined;
+    const context = {
+      registerTool(registered: FormTool, options: { signal: AbortSignal }) {
+        assert.equal(registered, tool);
+        signal = options.signal;
+      },
+    };
+    setBrowserGlobal(t, 'document', location === 'document' ? { modelContext: context } : {});
+    setBrowserGlobal(t, 'navigator', location === 'navigator' ? { modelContext: context } : {});
+    const cleanup = registerFormTool(tool);
+    assert.equal(signal?.aborted, false);
+    cleanup();
+    assert.equal(signal?.aborted, true);
+    t.mock.restoreAll();
+  }
+});
+
+test('unsupported browsers and denied registrations leave forms available', async (t) => {
+  const tool: FormTool = { name: 'test', description: '', inputSchema: {}, execute: async () => '' };
+  setBrowserGlobal(t, 'document', {});
+  assert.doesNotThrow(() => registerFormTool(tool)());
+  t.mock.restoreAll();
+  setBrowserGlobal(t, 'document', { modelContext: { registerTool() { throw new Error('denied'); } } });
+  assert.doesNotThrow(() => registerFormTool(tool)());
+});
