+  <script>
+    const actionTarget = document.getElementById('action-target');
+    const commandClasses = new Map([
+      ['--spin', 'is-spun'],
+      ['--grow', 'is-grown'],
+      ['--round', 'is-rounded'],
+    ]);
+    const actionButtons = document.querySelectorAll('button[commandfor="action-target"]');
+
+    function handleCommand(command) {
+      if (command === '--reset') {
+        actionTarget.classList.remove(...commandClasses.values());
+      } else if (commandClasses.has(command)) {
+        actionTarget.classList.toggle(commandClasses.get(command));
+      }
+
+      for (const button of actionButtons) {
+        const className = commandClasses.get(button.getAttribute('command'));
+        if (className) {
+          button.setAttribute('aria-pressed', String(actionTarget.classList.contains(className)));
+        }
+      }
+    }
+
+    actionTarget.addEventListener('command', (event) => handleCommand(event.command));
+
+    // Preserve the declarative controls in browsers without native command support.
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      for (const button of actionButtons) {
+        button.addEventListener('click', () => handleCommand(button.getAttribute('command')));
+      }
+    }
+  </script>
+
