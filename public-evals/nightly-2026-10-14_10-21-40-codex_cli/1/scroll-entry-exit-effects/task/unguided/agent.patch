diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,8 +114,36 @@
       box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
       text-align: center;
     }
 
+    /* Keep full-size cards unless scroll timelines and motion are enabled. */
+    @media (prefers-reduced-motion: no-preference) {
+      @supports (animation-timeline: view()) and (animation-range: entry 0% exit 100%) {
+        .grid > .card {
+          animation: card-reveal auto linear both;
+          /* The shorthand above resets the timeline, so set it afterward. */
+          animation-timeline: view(block);
+          animation-range: entry 0% exit 100%;
+        }
+
+        /* Keep links readable and stable during keyboard interaction. */
+        .grid > .card:focus-within {
+          animation: none;
+          transform: scale(1);
+        }
+
+        @keyframes card-reveal {
+          entry 0%, exit 100% {
+            transform: scale(0.5);
+          }
+
+          entry 100%, exit 0% {
+            transform: scale(1);
+          }
+        }
+      }
+    }
+
     .card h3 {
       margin-bottom: 10px;
       color: var(--primary);
     }
