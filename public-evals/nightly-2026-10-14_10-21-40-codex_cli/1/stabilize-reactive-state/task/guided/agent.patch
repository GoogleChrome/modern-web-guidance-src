+  <script type="module">
+    const deadlineValue = document.getElementById('temporal-value');
+    const referenceChanged = document.getElementById('temporal-ref-changed');
+    const renderCount = document.getElementById('temporal-render-count');
+    const extendButton = document.getElementById('extend-temporal-btn');
+
+    try {
+      const Temporal = globalThis.Temporal ??
+        (await import('https://esm.sh/@js-temporal/polyfill@0.5.1')).Temporal;
+
+      let state = {
+        deadline: Temporal.Now.plainDateISO().add({ days: 7 }),
+        referenceChanged: false,
+        renderCount: 1,
+      };
+
+      function render() {
+        const date = state.deadline.toString();
+        deadlineValue.textContent = date;
+        deadlineValue.dateTime = date;
+        referenceChanged.textContent = state.referenceChanged ? 'Yes' : 'No';
+        renderCount.textContent = String(state.renderCount);
+      }
+
+      function setDeadline(deadline) {
+        if (Object.is(state.deadline, deadline)) return;
+
+        state = {
+          deadline,
+          referenceChanged: !Object.is(state.deadline, deadline),
+          renderCount: state.renderCount + 1,
+        };
+        render();
+      }
+
+      extendButton.addEventListener('click', () => {
+        setDeadline(state.deadline.add({ days: 1 }));
+      });
+
+      render();
+      extendButton.disabled = false;
+    } catch (error) {
+      deadlineValue.textContent = 'Unavailable';
+      const errorMessage = document.getElementById('temporal-error');
+      errorMessage.textContent = 'The deadline tracker could not load. Please refresh to try again.';
+      errorMessage.hidden = false;
+      console.error('Failed to initialize the Temporal deadline tracker:', error);
+    }
+  </script>
+
 </body>
 
