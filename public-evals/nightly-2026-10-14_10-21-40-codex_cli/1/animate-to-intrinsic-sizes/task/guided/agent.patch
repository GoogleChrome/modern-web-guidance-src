+
+      #promo-alert::details-content {
+        transition: content-visibility 0.4s;
+        transition-behavior: allow-discrete;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      #promo-alert,
+      #promo-alert::details-content,
+      .faq-accordion::details-content,
+      #faq-trigger::after {
+        transition: none !important;
+      }
+    }
