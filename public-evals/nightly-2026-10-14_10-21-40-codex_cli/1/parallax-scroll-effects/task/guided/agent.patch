+      border-radius: 48% 48% 8px 8px;
+      pointer-events: none;
+    }
+
+    .coffee-story__rings::after {
+      content: "";
+      position: absolute;
+      inset: -18px 18px 18px -18px;
+      border: 1px solid rgba(229, 184, 121, 0.2);
+      border-radius: inherit;
+    }
+
+    .coffee-story__photo {
+      position: relative;
+    }
+
+    .coffee-story__photo img {
+      display: block;
+      width: 100%;
+      height: auto;
+      aspect-ratio: 4 / 5;
+      object-fit: cover;
+      border-radius: 48% 48% 8px 8px;
+    }
+
+    .coffee-story__caption {
+      position: absolute;
+      bottom: 24px;
+      left: -24px;
+      padding: 14px 22px;
+      background: #eddfcb;
+      color: #3e2723;
+      font-family: Georgia, 'Times New Roman', serif;
+      font-size: 1.05rem;
+    }
+
+    /* Both checks exclude partial implementations. Keep timeline declarations
+       after the animation shorthand, which otherwise resets them. */
+    @supports ((animation-timeline: view()) and (animation-range: entry)) {
+      @media (prefers-reduced-motion: no-preference) {
+        .coffee-story {
+          view-timeline: --coffee-story block;
+        }
+
+        .coffee-story__layer {
+          animation: coffee-depth linear both;
+          animation-timeline: --coffee-story;
+          animation-range: entry 0% exit 100%;
+        }
+
+        .coffee-story__background { --travel: 60px; }
+        .coffee-story__rings { --travel: -55px; }
+        .coffee-story__photo { --travel: -24px; }
+      }
+    }
+
+    @keyframes coffee-depth {
+      from { transform: translateY(calc(-1 * var(--travel))); }
+      to { transform: translateY(var(--travel)); }
+    }
+
+    @media (max-width: 700px) {
+      .coffee-story__inner {
+        grid-template-columns: 1fr;
+        gap: 64px;
+        padding: 64px 28px 80px;
+      }
+
+      .coffee-story__visual {
+        width: min(100%, 340px);
+        justify-self: center;
+      }
+
+      .coffee-story__caption {
+        left: -12px;
+      }
+    }
