+    /* A static composition by default; scroll motion is a progressive enhancement. */
+    .coffee-story {
+      position: relative;
+      isolation: isolate;
+      overflow: clip;
+      background: #211813;
+      color: #fff8ee;
+    }
+
+    .coffee-story__background {
+      position: absolute;
+      z-index: -2;
+      inset: -80px 0;
+      width: 100%;
+      height: calc(100% + 160px);
+      object-fit: cover;
+      opacity: 0.2;
+      pointer-events: none;
+    }
+
+    .coffee-story::after {
+      content: "";
+      position: absolute;
+      z-index: -1;
+      inset: 0;
+      background: linear-gradient(90deg, rgba(25, 17, 12, 0.96), rgba(25, 17, 12, 0.72));
+      pointer-events: none;
+    }
+
+    .coffee-story__inner {
