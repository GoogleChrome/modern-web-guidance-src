+  <script>
+    const navigation = document.querySelector('nav');
+    const sectionLinks = Array.from(navigation.querySelectorAll('a[href^="#"]'))
+      .map(link => ({ link, section: document.getElementById(link.hash.slice(1)) }))
+      .filter(({ section }) => section);
+    let updatePending = false;
+
+    function updateActiveSection() {
+      const navBottom = navigation.getBoundingClientRect().bottom;
+      document.documentElement.style.setProperty('--nav-height', `${navBottom + 16}px`);
+      let activeLink = null;
+      let largestVisibleHeight = 0;
+
+      sectionLinks.forEach(({ link, section }) => {
+        const bounds = section.getBoundingClientRect();
+        const visibleHeight = Math.max(0,
+          Math.min(bounds.bottom, window.innerHeight) - Math.max(bounds.top, navBottom));
+        if (visibleHeight > largestVisibleHeight) {
+          largestVisibleHeight = visibleHeight;
+          activeLink = link;
+        }
+      });
+
+      sectionLinks.forEach(({ link }) => {
+        if (link === activeLink) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+      updatePending = false;
+    }
+
+    function scheduleUpdate() {
+      if (updatePending) return;
+      updatePending = true;
+      window.requestAnimationFrame(updateActiveSection);
+    }
+
+    window.addEventListener('scroll', scheduleUpdate, { passive: true });
+    window.addEventListener('resize', scheduleUpdate);
+    window.addEventListener('pageshow', scheduleUpdate);
+    new ResizeObserver(scheduleUpdate).observe(navigation);
+    updateActiveSection();
+  </script>
+
 </body>
 
