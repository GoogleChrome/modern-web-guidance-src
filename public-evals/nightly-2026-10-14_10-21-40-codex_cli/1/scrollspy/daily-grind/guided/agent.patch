+  <script type="module">
+    const navigation = document.querySelector('nav');
+    const links = [...navigation.querySelectorAll('a[href^="#"]')];
+    const sections = links.map(link => document.getElementById(link.hash.slice(1)));
+    const nativeScrollspy = CSS.supports('scroll-target-group: auto') &&
+      CSS.supports('selector(:target-current)');
+
+    function setCurrent(currentLink) {
+      links.forEach(link => {
+        const isCurrent = link === currentLink;
+        link.classList.toggle('is-current', !nativeScrollspy && isCurrent);
+        if (isCurrent) link.setAttribute('aria-current', 'location');
+        else link.removeAttribute('aria-current');
+      });
+    }
+
+    let frame;
+    function syncCurrent() {
+      cancelAnimationFrame(frame);
+      frame = requestAnimationFrame(() => {
+        if (nativeScrollspy) {
+          setCurrent(navigation.querySelector('a:target-current'));
+          return;
+        }
+
+        // Track the section at the top of the content below the sticky menu.
+        const top = navigation.getBoundingClientRect().bottom + 1;
+        let index = 0;
+        sections.forEach((section, sectionIndex) => {
+          if (section.getBoundingClientRect().top <= top) index = sectionIndex;
+        });
+        // Short final sections may never reach the top of the viewport.
+        const page = document.scrollingElement;
+        if (page.scrollTop > 0 && page.scrollTop + page.clientHeight >= page.scrollHeight - 1) {
+          index = sections.length - 1;
+        }
+        setCurrent(links[index]);
+      });
+    }
+
+    if (!nativeScrollspy) {
+      const observer = new IntersectionObserver(syncCurrent);
+      sections.forEach(section => observer.observe(section));
+    }
+
+    new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height', `${navigation.offsetHeight}px`);
+      syncCurrent();
+    }).observe(navigation);
+    document.addEventListener('scroll', syncCurrent, { passive: true });
+    document.addEventListener('scrollend', syncCurrent);
+    window.addEventListener('resize', syncCurrent);
+    window.addEventListener('pageshow', syncCurrent);
+    syncCurrent();
+  </script>
+
 </body>
 
