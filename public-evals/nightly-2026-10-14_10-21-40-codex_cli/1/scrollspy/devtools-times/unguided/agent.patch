new file mode 100644
index 0000000..4b1817d
--- /dev/null
+++ b/src/components/SectionNav.tsx
@@ -0,0 +1,75 @@
+import { useEffect, useRef, useState } from 'react';
+
+const sections = [
+    { id: 'top-stories', label: 'Top Stories' },
+    { id: 'top-news', label: 'Top News' },
+    { id: 'world', label: 'World' },
+    { id: 'politics', label: 'Politics' },
+];
+
+export default function SectionNav() {
+    const [activeSection, setActiveSection] = useState(sections[0].id);
+    const navRef = useRef<HTMLElement>(null);
+
+    useEffect(() => {
+        let frame = 0;
+
+        const updateSection = () => {
+            frame = 0;
+            const activationLine = (navRef.current?.getBoundingClientRect().bottom ?? 48) + 24;
+            const pageSections = sections
+                .map(section => document.getElementById(section.id))
+                .filter((section): section is HTMLElement => section !== null);
+            let current = pageSections[0]?.id ?? sections[0].id;
+
+            for (const section of pageSections) {
+                if (section.getBoundingClientRect().top <= activationLine) current = section.id;
+            }
+
+            // The final section may be too short to reach the activation line.
+            if (window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
+                current = pageSections.at(-1)?.id ?? current;
+            }
+            setActiveSection(current);
+        };
+
+        const scheduleUpdate = () => {
+            if (!frame) frame = window.requestAnimationFrame(updateSection);
+        };
+        const resizeObserver = new ResizeObserver(scheduleUpdate);
+        resizeObserver.observe(document.body);
+        window.addEventListener('scroll', scheduleUpdate, { passive: true });
+        window.addEventListener('resize', scheduleUpdate);
+        window.addEventListener('hashchange', scheduleUpdate);
+        updateSection();
+
+        return () => {
+            window.cancelAnimationFrame(frame);
+            resizeObserver.disconnect();
+            window.removeEventListener('scroll', scheduleUpdate);
+            window.removeEventListener('resize', scheduleUpdate);
+            window.removeEventListener('hashchange', scheduleUpdate);
+        };
+    }, []);
+
+    return (
+        <nav ref={navRef} aria-label="Page sections" className="section-nav sticky top-0 z-30 border-b border-gray-200 bg-white/95 backdrop-blur-sm">
+            <div className="flex items-center justify-start sm:justify-center gap-6 overflow-x-auto px-4 sm:gap-8">
+                {sections.map(section => (
+                    <a
+                        key={section.id}
+                        href={`#${section.id}`}
+                        aria-current={activeSection === section.id ? 'location' : undefined}
+                        className={`shrink-0 border-b-2 py-3 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-amber-600 ${
+                            activeSection === section.id
+                                ? 'border-amber-500 text-amber-700'
+                                : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-900'
+                        }`}
+                    >
+                        {section.label}
+                    </a>
+                ))}
+            </div>
+        </nav>
+    );
+}
