diff --git a/src/components/SectionNav.astro b/src/components/SectionNav.astro
new file mode 100644
index 0000000..97864de
--- /dev/null
+++ b/src/components/SectionNav.astro
@@ -0,0 +1,116 @@
+---
+const sections = [
+    { id: 'top-stories', title: 'Top Stories' },
+    { id: 'top-news', title: 'Top News' },
+    { id: 'world', title: 'World' },
+    { id: 'politics', title: 'Politics' },
+];
+---
+
+<nav class="section-nav" aria-label="On this page" data-section-nav>
+    <div class="section-links">
+        {sections.map(({ id, title }) => <a href={`#${id}`}>{title}</a>)}
+    </div>
+</nav>
+
+<style>
+    .section-nav {
+        position: sticky;
+        top: 0;
+        z-index: 20;
+        background: white;
+        border-bottom: 1px solid #d1d5db;
+    }
+
+    .section-links {
+        display: flex;
+        justify-content: center;
+        gap: clamp(1rem, 4vw, 2.5rem);
+        padding-inline: 1rem;
+        scroll-target-group: auto;
+    }
+
+    a {
+        padding-block: 0.875rem;
+        border-bottom: 3px solid transparent;
+        color: #4b5563;
+        font-size: 0.875rem;
+        white-space: nowrap;
+    }
+
+    a:hover { color: #111827; }
+    a:focus-visible { outline: 2px solid #92400e; outline-offset: -2px; }
+
+    a:is(:target-current, .is-current) {
+        color: #92400e;
+        border-bottom-color: #b45309;
+        font-weight: 700;
+    }
+
+    :global([data-page-section]) { scroll-margin-top: 4rem; }
+</style>
+
+<script>
+    function setupSectionNav() {
+        const nav = document.querySelector<HTMLElement>('[data-section-nav]');
+        if (!nav) return;
+
+        const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
+        const targets = links.map(link => document.getElementById(link.hash.slice(1)));
+        const supportsNative = CSS.supports('scroll-target-group: auto') &&
+            CSS.supports('selector(:target-current)');
+        let frame = 0;
+
+        const update = () => {
+            frame = 0;
+            let current: HTMLAnchorElement | undefined;
+            if (supportsNative) {
+                current = nav.querySelector<HTMLAnchorElement>('a:target-current') ?? undefined;
+            } else {
+                // Keep the preceding section selected through gaps such as ad slots.
+                const readingLine = Math.max(nav.getBoundingClientRect().bottom, innerHeight * 0.2);
+                let index = 0;
+                targets.forEach((target, i) => {
+                    if (target && target.getBoundingClientRect().top <= readingLine) index = i;
+                });
+                if (scrollY + innerHeight >= document.documentElement.scrollHeight - 2) {
+                    index = links.length - 1;
+                }
+                current = links[index];
+            }
+            links.forEach(link => {
+                const active = link === current;
+                link.classList.toggle('is-current', !supportsNative && active);
+                if (active) link.setAttribute('aria-current', 'location');
+                else link.removeAttribute('aria-current');
+            });
+        };
+
+        const scheduleUpdate = () => {
+            if (!frame) frame = requestAnimationFrame(update);
+        };
+        const observer = supportsNative ? null : new IntersectionObserver(scheduleUpdate, {
+            rootMargin: '-20% 0px -79% 0px',
+            threshold: 0,
+        });
+        targets.forEach(target => { if (target) observer?.observe(target); });
+
+        // Mirror native state for screen readers; cover gaps and fast jumps in the fallback.
+        document.addEventListener('scroll', scheduleUpdate, { passive: true });
+        document.addEventListener('scrollend', scheduleUpdate);
+        window.addEventListener('resize', scheduleUpdate);
+        window.addEventListener('hashchange', scheduleUpdate);
+        scheduleUpdate();
+
+        document.addEventListener('astro:before-swap', () => {
+            observer?.disconnect();
+            cancelAnimationFrame(frame);
+            document.removeEventListener('scroll', scheduleUpdate);
+            document.removeEventListener('scrollend', scheduleUpdate);
+            window.removeEventListener('resize', scheduleUpdate);
+            window.removeEventListener('hashchange', scheduleUpdate);
+        }, { once: true });
+    }
+
+    document.addEventListener('astro:page-load', setupSectionNav);
+</script>
