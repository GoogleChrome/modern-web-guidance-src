+++ b/tests/signup.test.ts
@@ -0,0 +1,126 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { POST } from '../src/pages/api/signup.ts';
+
+const origin = 'https://news.example';
+const phone = '+14155550123';
+const digest = (code: string) => createHash('sha256').update(`test-salt:${code}`).digest('hex');
+
+function fixture(initial?: Record<string, unknown>) {
+  const values = new Map<string, unknown>();
+  if (initial) values.set('signupPhoneChallenge', initial);
+  const session = {
+    get: async (key: string) => values.get(key),
+    set: (key: string, value: unknown) => { values.set(key, value); },
+    delete: (key: string) => { values.delete(key); },
+  };
+  return {
+    values,
+    call: (body: Record<string, unknown>, requestOrigin = origin) => POST({
+      request: new Request(`${origin}/api/signup`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json', origin: requestOrigin },
+        body: JSON.stringify(body),
+      }),
+      url: new URL(`${origin}/api/signup`), session,
+    } as unknown as Parameters<typeof POST>[0]),
+  };
+}
+
+const challenge = (overrides = {}) => ({
+  phone, digest: digest('012345'), salt: 'test-salt',
+  expiresAt: Date.now() + 300_000, sentAt: Date.now() - 61_000, attempts: 0, ...overrides,
+});
+const registration = { action: 'register', phone, code: '012345', username: 'reader', password: 'password1' };
+
+// Provider and account-service calls are mocked: no SMS or real accounts are created.
+test('server-side SMS signup verification', async (t) => {
+  const originalFetch = globalThis.fetch;
+  const originalEnv = { ...process.env };
+  try {
+    process.env.TWILIO_ACCOUNT_SID = 'ACtest';
+    process.env.TWILIO_AUTH_TOKEN = 'test-token';
+    process.env.TWILIO_FROM_NUMBER = '+14155550000';
+    let calls: { url: string; options?: RequestInit }[] = [];
+    globalThis.fetch = async (url, options) => {
+      calls.push({ url: String(url), options });
+      return new Response('{}', { status: 201 });
+    };
+
+    await t.test('rejects cross-origin requests and invalid phone numbers', async () => {
+      const f = fixture();
+      assert.equal((await f.call({ action: 'send', phone }, 'https://other.example')).status, 403);
+      assert.equal((await f.call({ action: 'send', phone: '4155550123' })).status, 400);
+      assert.equal(calls.length, 0);
+    });
+
+    await t.test('registration cannot bypass phone verification', async () => {
+      assert.equal((await fixture().call(registration)).status, 400);
+      assert.equal((await fixture(challenge()).call({ ...registration, phone: '+14155550124' })).status, 400);
+      assert.equal(calls.length, 0);
+    });
+
+    await t.test('rejects expired codes and limits incorrect attempts', async () => {
+      assert.equal((await fixture(challenge({ expiresAt: Date.now() - 1 })).call(registration)).status, 400);
+      const f = fixture(challenge());
+      for (let i = 0; i < 5; i++) assert.equal((await f.call({ ...registration, code: '999999' })).status, 400);
+      assert.equal((await f.call(registration)).status, 429);
+      assert.equal(calls.length, 0);
+    });
+
+    await t.test('preserves leading zeros, registers verified phone, and prevents replay', async () => {
+      const f = fixture(challenge());
+      assert.equal((await f.call(registration)).status, 200);
+      assert.deepEqual(JSON.parse(calls[0].options?.body as string), { username: 'reader', password: 'password1', phone });
+      assert.equal(f.values.has('signupPhoneChallenge'), false);
