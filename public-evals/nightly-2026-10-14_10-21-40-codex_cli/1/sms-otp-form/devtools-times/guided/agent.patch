diff --git a/src/pages/api/signup.ts b/src/pages/api/signup.ts
new file mode 100644
index 0000000..bb4bec6
--- /dev/null
+++ b/src/pages/api/signup.ts
@@ -0,0 +1,101 @@
+import type { APIRoute } from 'astro';
+import { createHash, randomInt, randomBytes, timingSafeEqual } from 'node:crypto';
+
+interface Challenge {
+  phone: string;
+  digest: string;
+  salt: string;
+  expiresAt: number;
+  sentAt: number;
+  attempts: number;
+}
+
+const key = 'signupPhoneChallenge';
+const lifetime = 5 * 60_000;
+const cooldown = 60_000;
+const hash = (code: string, salt: string) => createHash('sha256').update(`${salt}:${code}`).digest('hex');
+const json = (body: Record<string, unknown>, status = 200) => new Response(JSON.stringify(body), {
+  status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' },
+});
+
+// Limits SMS sends across sessions in this server process, not just in the UI.
+const phoneSends = new Map<string, number>();
+const pendingPhones = new Set<string>();
+
+export const POST: APIRoute = async ({ request, session, url }) => {
+  if (request.headers.get('origin') !== url.origin) return json({ error: 'Please submit this form from this website.' }, 403);
+  if (!session) return json({ error: 'Verification is unavailable. Please try again later.' }, 503);
+  let data: Record<string, unknown>;
+  try {
+    const body = await request.json();
+    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error();
+    data = body;
+  } catch {
+    return json({ error: 'Invalid request.' }, 400);
+  }
+  const phone = typeof data.phone === 'string' ? data.phone.replace(/[ ()-]/g, '') : '';
+  if (!/^\+[1-9][0-9]{6,14}$/.test(phone)) return json({ error: 'Enter a valid phone number with its country code, such as +1 415 555 0123.' }, 400);
+  const challenge = await session.get<Challenge>(key);
+  const now = Date.now();
+
+  if (data.action === 'send') {
+    const sentAt = Math.max(challenge?.sentAt || 0, phoneSends.get(phone) || 0);
+    const retryAfter = Math.ceil((sentAt + cooldown - now) / 1000);
+    if (retryAfter > 0 || pendingPhones.has(phone)) return json({ error: 'Please wait before requesting another code.', retryAfter: Math.max(1, retryAfter) }, 429);
+    const sid = process.env.TWILIO_ACCOUNT_SID || import.meta.env?.TWILIO_ACCOUNT_SID;
+    const token = process.env.TWILIO_AUTH_TOKEN || import.meta.env?.TWILIO_AUTH_TOKEN;
+    const from = process.env.TWILIO_FROM_NUMBER || import.meta.env?.TWILIO_FROM_NUMBER;
+    if (!sid || !token || !from) return json({ error: 'SMS verification is currently unavailable. Please try again later.' }, 503);
+    const code = randomInt(0, 1_000_000).toString().padStart(6, '0');
+    const salt = randomBytes(32).toString('hex');
+    pendingPhones.add(phone);
+    try {
+      const response = await fetch(`https://api.twilio.com/2010-04-01/Accounts/${encodeURIComponent(sid)}/Messages.json`, {
+        method: 'POST',
+        headers: {
+          Authorization: `Basic ${Buffer.from(`${sid}:${token}`).toString('base64')}`,
+          'Content-Type': 'application/x-www-form-urlencoded',
+        },
+        body: new URLSearchParams({ To: phone, From: from, Body: `Your DevTools Times verification code is ${code}. It expires in 5 minutes.\n\n@${url.hostname} #${code}` }),
+        signal: AbortSignal.timeout(15_000),
+      });
+      if (!response.ok) return json({ error: 'We could not send the SMS. Check your number and try again.' }, 502);
+      // A resend replaces the previous code; no plaintext code is stored or returned.
+      await session.set(key, { phone, digest: hash(code, salt), salt, expiresAt: now + lifetime, sentAt: now, attempts: 0 } satisfies Challenge);
+      for (const [number, timestamp] of phoneSends) if (timestamp + cooldown <= now) phoneSends.delete(number);
+      phoneSends.set(phone, now);
+      return json({ phone, retryAfter: cooldown / 1000 });
+    } catch {
+      return json({ error: 'Unable to send the SMS. Please try again.' }, 502);
+    } finally {
+      pendingPhones.delete(phone);
+    }
+  }
+
+  if (data.action !== 'register') return json({ error: 'Invalid request.' }, 400);
+  if (!challenge || challenge.phone !== phone) return json({ error: 'Request a verification code for this phone number first.' }, 400);
+  if (challenge.expiresAt <= now) return json({ error: 'This code has expired. Request a new code.' }, 400);
+  if (challenge.attempts >= 5) return json({ error: 'Too many incorrect attempts. Request a new code.' }, 429);
+  const code = typeof data.code === 'string' ? data.code : '';
+  if (!/^[0-9]{6}$/.test(code) || !timingSafeEqual(Buffer.from(hash(code, challenge.salt), 'hex'), Buffer.from(challenge.digest, 'hex'))) {
+    await session.set(key, { ...challenge, attempts: challenge.attempts + 1 });
+    return json({ error: 'The code is incorrect. Check the SMS and try again.' }, 400);
+  }
+  const username = typeof data.username === 'string' ? data.username.trim() : '';
+  const password = typeof data.password === 'string' ? data.password : '';
+  if (!username || username.length > 100 || password.length < 8 || !/[0-9]/.test(password)) {
+    return json({ error: 'Enter a username and a password of at least 8 characters including a number.' }, 400);
+  }
+  try {
+    const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', {
+      method: 'POST', headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username, password, phone }),
+      signal: AbortSignal.timeout(15_000),
+    });
+    if (!response.ok) return json({ error: 'Registration failed. Your username may already be taken. Please try again.' }, 502);
+    await session.delete(key);
+    return json({ success: true });
+  } catch {
+    return json({ error: 'Unable to create your account. Please try again.' }, 502);
+  }
+};
