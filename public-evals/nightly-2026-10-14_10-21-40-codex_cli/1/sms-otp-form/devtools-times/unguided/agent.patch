@@ -0,0 +1,53 @@
+import type { APIRoute } from 'astro';
+
+type Verification = { phone: string; sentAt: number; expiresAt: number; attempts: number; verified: boolean };
+const json = (data: object, status = 200) => new Response(JSON.stringify(data), { status, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } });
+
+export const POST: APIRoute = async ({ request, session }) => {
+  if (request.headers.get('origin') !== new URL(request.url).origin) return json({ error: 'Please submit this form from this website.' }, 403);
+  if (!session) return json({ error: 'Your session is unavailable. Please refresh and try again.' }, 503);
+  let body;
+  try { body = await request.json(); } catch { return json({ error: 'Invalid request.' }, 400); }
+  if (!body || typeof body !== 'object') return json({ error: 'Invalid request.' }, 400);
+  const { action, phone, code, username, password } = body;
+  if (typeof phone !== 'string' || !/^\+[1-9]\d{7,14}$/.test(phone)) return json({ error: 'Enter a valid phone number, including its country code.' }, 400);
+  const state = await session.get('signupVerification') as Verification | undefined;
+  const now = Date.now();
+  if (action === 'register') {
+    if (!state?.verified || state.phone !== phone || state.expiresAt < now) return json({ error: 'Please verify your phone number again before creating your account.' }, 403);
+    if (typeof username !== 'string' || username.trim().length < 3 || username.length > 50 || typeof password !== 'string' || password.length < 8 || !/\d/.test(password)) return json({ error: 'Enter a username and a password with at least 8 characters and a number.' }, 400);
+    try {
+      const response = await fetch('https://us-central1-web-devrel-apps.cloudfunctions.net/times_cdn/api/register', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username: username.trim(), password, phone }), signal: AbortSignal.timeout(15000) });
+      if (!response.ok) return json({ error: 'Unable to create your account. Try another username or try again later.' }, response.status === 409 ? 409 : 502);
+      await session.delete('signupVerification');
+      return json({ success: true });
+    } catch { return json({ error: 'Account creation is temporarily unavailable. Please try again.' }, 502); }
+  }
+  if (action !== 'send' && action !== 'verify') return json({ error: 'Invalid request.' }, 400);
+  const account = process.env.TWILIO_ACCOUNT_SID;
+  const token = process.env.TWILIO_AUTH_TOKEN;
+  const service = process.env.TWILIO_VERIFY_SERVICE_SID;
+  if (!account || !token || !service) return json({ error: 'SMS verification is temporarily unavailable. Please try again later.' }, 503);
+  if (action === 'send' && state && now - state.sentAt < 30000) return json({ error: 'Please wait 30 seconds before requesting another code.' }, 429);
+  if (action === 'verify') {
+    if (!state || state.phone !== phone || state.expiresAt < now) return json({ error: 'Your code has expired. Please request a new one.' }, 400);
+    if (state.attempts >= 5) return json({ error: 'Too many attempts. Please request a new code.' }, 429);
+    if (state.verified) return json({ success: true });
+    if (typeof code !== 'string' || !/^\d{6}$/.test(code)) return json({ error: 'Enter the 6-digit code from your text message.' }, 400);
+    await session.set('signupVerification', { ...state, attempts: state.attempts + 1 });
+  } else {
+    // Reserve the cooldown before contacting the SMS provider.
+    await session.set('signupVerification', { phone, sentAt: now, expiresAt: now + 600000, attempts: 0, verified: false });
+  }
+  try {
+    const params = new URLSearchParams({ To: phone, ...(action === 'send' ? { Channel: 'sms' } : { Code: code }) });
+    const response = await fetch(`https://verify.twilio.com/v2/Services/${service}/${action === 'send' ? 'Verifications' : 'VerificationCheck'}`, { method: 'POST', headers: { Authorization: `Basic ${Buffer.from(`${account}:${token}`).toString('base64')}`, 'Content-Type': 'application/x-www-form-urlencoded' }, body: params, signal: AbortSignal.timeout(15000) });
+    const result = await response.json();
+    if (!response.ok) return json({ error: response.status === 429 ? 'Too many attempts. Please wait before trying again.' : action === 'send' ? 'We couldn’t send a code to that number. Check it and try again.' : 'That code is invalid or has expired. Please try again or request a new one.' }, response.status === 429 ? 429 : 400);
+    if (action === 'verify') {
+      if (result.status !== 'approved') return json({ error: 'That code isn’t correct. Please check your message and try again.' }, 400);
+      await session.set('signupVerification', { ...state!, verified: true, expiresAt: now + 600000 });
+    }
+    return json({ success: true });
+  } catch { return json({ error: 'SMS verification is temporarily unavailable. Please try again.' }, 502); }
+};
