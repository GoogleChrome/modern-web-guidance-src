diff --git a/tests/signup.test.mjs b/tests/signup.test.mjs
new file mode 100644
index 0000000..cbc4263
--- /dev/null
+++ b/tests/signup.test.mjs
@@ -0,0 +1,78 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { POST } from '../src/pages/api/signup.ts';
+
+const phone = '+15551234567';
+function context(body, values = new Map(), origin = 'https://example.com') {
+  return {
+    request: new Request('https://example.com/devtools-times/api/signup', {
+      method: 'POST', headers: { origin, 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+    }),
+    session: { get: async key => values.get(key), set: async (key, value) => values.set(key, value), delete: async key => values.delete(key) },
+  };
+}
+
+test('SMS sign-up server safeguards and registration', async t => {
+  const previousFetch = globalThis.fetch;
+  const keys = ['TWILIO_ACCOUNT_SID', 'TWILIO_AUTH_TOKEN', 'TWILIO_VERIFY_SERVICE_SID'];
+  const original = keys.map(key => process.env[key]);
+  keys.forEach(key => process.env[key] = 'test');
+  try {
+    await t.test('rejects cross-origin requests', async () => {
+      assert.equal((await POST(context({ action: 'send', phone }, new Map(), 'https://other.com'))).status, 403);
+    });
+    await t.test('rejects invalid phone numbers', async () => {
+      assert.equal((await POST(context({ action: 'send', phone: '123' }))).status, 400);
+    });
+    await t.test('fails clearly when SMS is not configured', async () => {
+      delete process.env.TWILIO_AUTH_TOKEN;
+      assert.equal((await POST(context({ action: 'send', phone }))).status, 503);
+      process.env.TWILIO_AUTH_TOKEN = 'test';
+    });
+    await t.test('prevents registration without verification', async () => {
+      assert.equal((await POST(context({ action: 'register', phone, username: 'reader', password: 'password1' }))).status, 403);
+    });
+    await t.test('enforces code expiry and attempt limits', async () => {
+      const values = new Map([['signupVerification', { phone, expiresAt: Date.now() - 1, attempts: 0 }]]);
+      assert.equal((await POST(context({ action: 'verify', phone, code: '123456' }, values))).status, 400);
+      values.set('signupVerification', { phone, expiresAt: Date.now() + 60000, attempts: 5 });
+      assert.equal((await POST(context({ action: 'verify', phone, code: '123456' }, values))).status, 429);
+    });
+    await t.test('sends SMS, throttles resend, rejects wrong code, verifies and consumes approval', async () => {
+      const values = new Map();
+      let approved = false;
+      let registrations = 0;
+      globalThis.fetch = async (url, options) => {
+        if (url.includes('/api/register')) {
+          registrations++;
+          assert.equal(JSON.parse(options.body).phone, phone);
+          return Response.json({ success: true });
+        }
+        assert.equal(options.headers['Content-Type'], 'application/x-www-form-urlencoded');
+        assert.equal(new URLSearchParams(options.body).get('To'), phone);
+        if (url.endsWith('/Verifications')) assert.equal(new URLSearchParams(options.body).get('Channel'), 'sms');
+        return Response.json({ status: approved ? 'approved' : 'pending' });
+      };
+      assert.equal((await POST(context({ action: 'send', phone }, values))).status, 200);
+      assert.equal((await POST(context({ action: 'send', phone }, values))).status, 429);
+      assert.equal((await POST(context({ action: 'verify', phone, code: '111111' }, values))).status, 400);
+      assert.equal(values.get('signupVerification').verified, false);
+      approved = true;
+      assert.equal((await POST(context({ action: 'verify', phone, code: '123456' }, values))).status, 200);
+      assert.equal(values.get('signupVerification').verified, true);
+      assert.equal((await POST(context({ action: 'register', phone, username: 'reader', password: 'password1' }, values))).status, 200);
+      assert.equal(registrations, 1);
+      assert.equal(values.has('signupVerification'), false);
+      assert.equal((await POST(context({ action: 'register', phone, username: 'reader', password: 'password1' }, values))).status, 403);
+    });
+    await t.test('provider failures do not approve verification', async () => {
+      globalThis.fetch = async () => { throw new Error('Unavailable'); };
+      const values = new Map();
+      assert.equal((await POST(context({ action: 'send', phone }, values))).status, 502);
+      assert.equal(values.get('signupVerification').verified, false);
+    });
+  } finally {
+    globalThis.fetch = previousFetch;
+    keys.forEach((key, index) => { if (original[index] === undefined) delete process.env[key]; else process.env[key] = original[index]; });
+  }
+});
