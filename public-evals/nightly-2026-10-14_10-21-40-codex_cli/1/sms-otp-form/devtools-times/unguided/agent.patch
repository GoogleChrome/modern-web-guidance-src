+/* The reader onboarding experience. */
+.signup-page { --ink: #272e26; --green: #46583b; --muted: #7a7d73; background: #fafaf7; color: var(--ink); font-family: 'DM Sans', sans-serif; -webkit-font-smoothing: antialiased; }
+.signup-header { height: 108px; padding: 0 5.2%; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e7e8df; }
+.signup-brand { display: flex; align-items: center; gap: 14px; text-decoration: none; font-family: 'Playfair Display', Georgia, serif; font-size: 24px; font-weight: 600; letter-spacing: -.7px; }
+.brand-mark { width: 45px; height: 48px; background: var(--green); color: #fff; display: flex; align-items: center; justify-content: center; font-family: Georgia, serif; font-size: 37px; font-weight: 400; letter-spacing: -4px; padding-right: 5px; }
+.brand-mark > span { color: #d2d4a3; }
+.brand-tagline { display: block; font-family: 'DM Sans', sans-serif; font-size: 8px; font-weight: 500; letter-spacing: 2px; margin-top: 5px; }
+.header-signin { font-size: 12px; color: #797d73; }
+.header-signin a { color: var(--ink); font-weight: 600; margin-left: 14px; }
