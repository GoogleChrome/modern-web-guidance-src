+(() => {
+  'use strict';
+  const $ = id => document.getElementById(id);
+  const DEMO_CODE = '246810';
+  let phone = '', stage = 'phone', otpController = null, otpTimeout = null, timer = null;
+  let expiresAt = 0, resendAt = 0, attempts = 0;
+  // This static preview uses a demo adapter. Replace sendCode and verifyCode with
+  // server calls when connecting an SMS provider; never validate real OTPs here.
+  const verification = {
+    async sendCode() { return { expiresAt: Date.now() + 5 * 60 * 1000 }; },
+    async verifyCode(code) {
+      if (Date.now() > expiresAt) throw new Error('This code has expired. Request a new code below.');
+      if (attempts >= 5) throw new Error('Too many attempts. Request a new code to try again.');
+      attempts++;
+      if (code !== DEMO_CODE) throw new Error('That code doesn’t match. For this demo, enter 246810.');
+      return { verified: true };
+    }
+  };
+  function stopListener() {
+    otpController?.abort(); otpController = null;
+    clearTimeout(otpTimeout);
+  }
+  async function startListener() {
+    stopListener();
+    if (!window.isSecureContext || !('OTPCredential' in window) || !navigator.credentials) return;
+    const controller = new AbortController(); otpController = controller;
+    otpTimeout = setTimeout(() => controller.abort(), 60000);
+    try {
+      const credential = await navigator.credentials.get({ otp: { transport: ['sms'] }, signal: controller.signal });
+      if (credential && !controller.signal.aborted && stage === 'code') {
+        $('otp-input').value = credential.code;
+        $('otp-form').requestSubmit();
+      }
+    } catch { /* Dismissal, timeout, or unsupported permissions: manual entry remains available. */ }
+  }
+  function setStage(next) {
+    stage = next;
+    ['phone', 'code', 'success'].forEach(name => $(name + '-stage').hidden = name !== next);
+    $('step-one').className = 'step ' + (next === 'phone' ? 'current' : 'complete');
+    $('step-two').className = 'step ' + (next === 'phone' ? '' : 'current');
+    $('step-one').querySelector('.step-number').textContent = next === 'phone' ? '1' : '✓';
+    $('step-two').querySelector('.step-number').textContent = next === 'success' ? '✓' : '2';
+    $('step-one').removeAttribute('aria-current'); $('step-two').removeAttribute('aria-current');
+    $(next === 'phone' ? 'step-one' : 'step-two').setAttribute('aria-current', 'step');
+    document.querySelector('.form-panel').setAttribute('aria-labelledby', next === 'phone' ? 'form-title' : next === 'code' ? 'code-title' : 'success-title');
+    if (next !== 'code') { stopListener(); clearInterval(timer); }
+    $('status').textContent = '';
+  }
+  function error(input, message) {
+    $(input + '-error').textContent = message;
+    $(input === 'otp' ? 'otp-input' : input).setAttribute('aria-invalid', message ? 'true' : 'false');
+  }
+  function cooldown() {
+    clearInterval(timer); resendAt = Date.now() + 30000;
+    const update = () => {
+      const seconds = Math.max(0, Math.ceil((resendAt - Date.now()) / 1000));
+      $('resend').disabled = seconds > 0;
+      $('resend-timer').textContent = seconds ? `(${seconds}s)` : '';
+      if (!seconds) clearInterval(timer);
+    };
+    update(); timer = setInterval(update, 1000);
+  }
+  async function sendCode() {
+    stopListener();
+    const result = await verification.sendCode(phone);
+    expiresAt = result.expiresAt; attempts = 0;
+    $('otp-input').value = ''; error('otp', '');
+    setStage('code');
+    $('code-destination').textContent = `Your code will go to ${phone}. In this preview, use the demo code below.`;
+    $('demo-note').lastElementChild.textContent = 'Demo code: 246810 · No SMS is sent.';
+    cooldown(); $('otp-input').focus(); startListener();
+  }
+  $('phone-form').addEventListener('submit', async event => {
+    event.preventDefault();
+    const raw = $('phone').value.trim();
+    const digits = raw.replace(/[\s().-]/g, '');
+    const country = $('country').selectedOptions[0];
+    const valid = /^\d+$/.test(digits) && (country.value === '49' ? digits.length >= 7 && digits.length <= 11 : digits.length === Number(country.dataset.length));
+    if (!valid) { error('phone', `Enter a valid phone number (${country.value === '49' ? '7–11' : country.dataset.length} digits, without the country code).`); $('phone').focus(); return; }
+    error('phone', ''); phone = `+${country.value} ${raw}`;
+    const button = event.submitter; button.disabled = true;
+    try { await sendCode(); } catch { error('phone', 'We couldn’t send your code. Please try again.'); } finally { button.disabled = false; }
+  });
+  $('phone').addEventListener('input', () => error('phone', ''));
+  $('country').addEventListener('change', () => {
+    $('phone').placeholder = $('country').value === '1' ? '(555) 123-4567' : 'Your phone number'; error('phone', '');
+  });
+  $('otp-input').addEventListener('input', () => { $('otp-input').value = $('otp-input').value.replace(/\D/g, '').slice(0, 6); error('otp', ''); });
+  $('otp-input').addEventListener('paste', event => {
+    const pasted = event.clipboardData.getData('text').replace(/\D/g, '');
+    if (pasted.length === 6) { event.preventDefault(); $('otp-input').value = pasted; error('otp', ''); }
+  });
+  $('otp-form').addEventListener('submit', async event => {
+    event.preventDefault(); stopListener();
+    if (!/^[0-9]{6}$/.test($('otp-input').value)) { error('otp', 'Enter the complete 6-digit code.'); $('otp-input').focus(); return; }
+    const button = event.submitter || $('otp-form').querySelector('button'); button.disabled = true;
+    try {
+      await verification.verifyCode($('otp-input').value);
+      setStage('success');
+      $('success-message').textContent = `Your demo phone number ${phone} is verified. You're ready for a little more good in your daily routine.`;
+      $('stage-icon').innerHTML = '<svg viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="12"/><path d="m10 16 4 4 8-8"/></svg>';
+      $('demo-note').lastElementChild.textContent = 'Demo complete · No real phone verification performed.';
+      $('success-title').focus();
+    } catch (err) { error('otp', err.message); $('otp-input').focus(); }
+    finally { button.disabled = false; }
+  });
+  function reset() {
+    setStage('phone'); error('otp', '');
+    $('demo-note').lastElementChild.textContent = 'Demo experience · No SMS will be sent.';
+    $('stage-icon').innerHTML = '<svg viewBox="0 0 32 32" aria-hidden="true"><rect x="9" y="3" width="14" height="26" rx="3"/><path d="M13 7h6m-4 18h2"/><path d="m20 16 3 3 6-6"/></svg>';
+    $('phone').focus();
+  }
+  $('edit-number').addEventListener('click', reset); $('restart').addEventListener('click', reset);
+  $('resend').addEventListener('click', async () => {
+    if (Date.now() < resendAt) return;
+    $('resend').disabled = true;
+    try { await sendCode(); $('status').textContent = 'A fresh demo code is ready: 246810. It expires in 5 minutes.'; }
+    catch { $('status').textContent = 'Couldn’t request a new code. Please try again.'; $('resend').disabled = false; }
+  });
+  window.addEventListener('pagehide', () => { stopListener(); clearInterval(timer); });
+  const information = {
+    menu: ['A cup for every kind of day.', '<p>Your next favorite is waiting.</p><ul><li>Maple oat latte · Creamy, cozy, gently sweet</li><li>Dark roast espresso · Bold and beautifully balanced</li><li>Cold brew · Slow-steeped for 18 hours</li></ul>'],
+    story: ['Good coffee. Better days.', '<p>We believe the everyday deserves something special. That’s why we choose ethically sourced beans, roast locally, and put a little care into every cup.</p>'],
+    locations: ['Find your daily.', '<p>Our café directory is coming soon. Ask your local Daily Grind team about opening hours and what’s brewing today.</p>'],
+    rewards: ['A little extra with every sip.', '<p>Daily Grind members earn with every purchase and enjoy members-only treats and seasonal favorites. Verify your phone number to get your account ready.</p><p>This is a demo experience. Rewards enrollment is not connected yet.</p>'],
+    account: ['Your Daily Grind account.', '<p>You’re on the phone verification step. Add your number and complete the demo to see the verified account experience.</p>'],
+    support: ['We’re here to help.', '<p>Check that you chose the right country code and entered your number without the country prefix. You can change your number or request another code.</p><p>In this preview, no text message is sent. Use <strong>246810</strong> to try the verification flow.</p>'],
+    privacy: ['Your privacy matters.', '<p>This demo keeps your phone number only in memory while the page is open. It isn’t sent to a server, saved, or shared. The photo and fonts load from external services.</p>'],
+    terms: ['A note about this preview.', '<p>This is an interactive preview of phone verification. No SMS is sent, no real phone ownership is verified, and no rewards account is created.</p>']
+  };
+  function showInfo(key) { const [title, content] = information[key]; $('dialog-title').textContent = title; $('dialog-content').innerHTML = content; $('info-dialog').showModal(); }
+  document.querySelectorAll('[data-info]').forEach(button => button.addEventListener('click', () => showInfo(button.dataset.info)));
+  $('continue').addEventListener('click', () => showInfo('rewards'));
+  $('close-dialog').addEventListener('click', () => $('info-dialog').close());
+  $('dialog-done').addEventListener('click', () => $('info-dialog').close());
+  $('info-dialog').addEventListener('click', event => { if (event.target === $('info-dialog')) { const r = event.target.getBoundingClientRect(); if (event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom) event.target.close(); } });
+  $('step-one').setAttribute('aria-current', 'step');
+})();
