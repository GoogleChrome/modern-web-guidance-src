+  <script>
+    // Keep the centered-card highlight available without scroll-state queries.
+    if (!CSS.supports('container-type', 'scroll-state')) {
+      const carousel = document.querySelector('.carousel');
+      const items = Array.from(carousel.querySelectorAll('.carousel-item'));
+      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+      let frame = null;
+
+      const updateCenteredCard = () => {
+        frame = null;
+        const bounds = carousel.getBoundingClientRect();
+        const center = bounds.left + carousel.clientWidth / 2;
+        const nearest = items.reduce((closest, item) => {
+          const rect = item.getBoundingClientRect();
+          const distance = Math.abs(rect.left + rect.width / 2 - center);
+          return distance < closest.distance ? { item, distance } : closest;
+        }, { item: null, distance: Infinity }).item;
+
+        items.forEach(item => {
+          item.classList.toggle('is-snapped', !reducedMotion.matches && item === nearest);
+        });
+      };
+
+      const scheduleUpdate = () => {
+        if (frame === null) frame = requestAnimationFrame(updateCenteredCard);
+      };
+
+      carousel.addEventListener('scroll', scheduleUpdate, { passive: true });
+      reducedMotion.addEventListener('change', scheduleUpdate);
+      new ResizeObserver(scheduleUpdate).observe(carousel);
+      scheduleUpdate();
+    }
+  </script>
+
