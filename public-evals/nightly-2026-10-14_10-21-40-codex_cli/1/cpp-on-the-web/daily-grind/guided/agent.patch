diff --git a/public/render-worker.js b/public/render-worker.js
new file mode 100644
index 0000000..835e329
--- /dev/null
+++ b/public/render-worker.js
@@ -0,0 +1,21 @@
+import createSmallpt from './smallpt.js';
+
+self.onmessage = async ({ data }) => {
+  try {
+    const { width, height, samples, seed, colors } = data;
+    const module = await createSmallpt();
+    if (!module._init(width, height, samples, seed, ...colors.flat())) {
+      throw new Error('Unsupported render settings.');
+    }
+    for (let row = 0; row < height; row += 4) {
+      const count = Math.min(4, height - row);
+      module._render_rows(row, count);
+      const offset = module._pixels() + row * width * 4;
+      const pixels = module.HEAPU8.slice(offset, offset + count * width * 4);
+      self.postMessage({ type: 'rows', row, count, pixels, progress: (row + count) / height }, [pixels.buffer]);
+    }
+    self.postMessage({ type: 'done' });
+  } catch (error) {
+    self.postMessage({ type: 'error', message: error.message || 'Unable to initialize WebAssembly.' });
+  }
+};
