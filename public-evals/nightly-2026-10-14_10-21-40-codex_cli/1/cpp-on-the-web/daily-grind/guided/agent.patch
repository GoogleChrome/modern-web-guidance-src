@@ -0,0 +1,100 @@
+const $ = (id) => document.getElementById(id);
+const canvas = $('canvas');
+const context = canvas.getContext('2d');
+let worker;
+let colors = [[0.999, 0.999, 0.999], [0.999, 0.999, 0.999]];
+let started;
+let clock;
+let completed = false;
+const formatTime = () => `${((performance.now() - started) / 1000).toFixed(1)} s`;
+
+function stopClock() { clearInterval(clock); }
+function fail(message) {
+  stopClock();
+  worker?.terminate();
+  $('status').textContent = message;
+  $('status-dot').className = 'status-dot error';
+  $('download').disabled = !completed;
+  $('render').innerHTML = '<span aria-hidden="true">↻</span> Try again';
+}
+function render() {
+  if (!context || !window.Worker || !window.WebAssembly) {
+    fail('This browser needs WebAssembly, Web Workers, and canvas support.');
+    return;
+  }
+  worker?.terminate();
+  stopClock();
+  const width = Number($('resolution').value);
+  const height = width * 3 / 4;
+  const samples = Number($('samples').value);
+  canvas.width = width;
+  canvas.height = height;
+  canvas.classList.remove('visible');
+  completed = false;
+  $('download').disabled = true;
+  $('status').textContent = 'Preparing the light…';
+  $('status-dot').className = 'status-dot busy';
+  $('progress').value = 0;
+  $('render-size').textContent = `${width} × ${height}`;
+  $('render-spp').textContent = `${samples} spp`;
+  $('render').innerHTML = '<span aria-hidden="true">↻</span> Restart render';
+  started = performance.now();
+  clock = setInterval(() => { $('elapsed').textContent = formatTime(); }, 100);
+  try {
+    worker = new Worker(new URL('./public/render-worker.js', import.meta.url), { type: 'module' });
+    worker.onmessage = ({ data }) => {
+      if (data.type === 'error') return fail(`Render failed: ${data.message}`);
+      if (data.type === 'rows') {
+        // Leave the preview visible behind the transparent, unfinished rows.
+        canvas.classList.add('visible');
+        context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), width, data.count), 0, data.row);
+        $('progress').value = data.progress * 100;
+        $('status').textContent = `Tracing light · ${Math.round(data.progress * 100)}%`;
+      }
+      if (data.type === 'done') {
+        stopClock();
+        $('elapsed').textContent = formatTime();
+        $('status').textContent = 'Render complete';
+        $('status-dot').className = 'status-dot';
+        $('render').innerHTML = '<span aria-hidden="true">↻</span> Render again';
+        completed = true;
+        $('download').disabled = false;
+        worker.terminate();
+      }
+    };
+    worker.onerror = () => fail('Render failed. Please try again.');
+    const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+    worker.postMessage({ width, height, samples, seed, colors });
+  } catch (error) { fail(`Render failed: ${error.message}`); }
+}
+function randomColor() {
+  // Pastel tints retain enough reflectance for the original mirror and glass materials.
+  const hue = Math.random() * 6;
+  const chroma = 0.25 + Math.random() * 0.3;
+  const x = chroma * (1 - Math.abs(hue % 2 - 1));
+  const rgb = hue < 1 ? [chroma, x, 0] : hue < 2 ? [x, chroma, 0] : hue < 3 ? [0, chroma, x] : hue < 4 ? [0, x, chroma] : hue < 5 ? [x, 0, chroma] : [chroma, 0, x];
+  return rgb.map((v) => v + 0.98 - chroma);
+}
+function updatePalette() {
+  ['one', 'two'].forEach((id, index) => {
+    const hex = '#' + colors[index].map((value) => Math.round(value * 255).toString(16).padStart(2, '0')).join('');
+    $('hex-' + id).textContent = hex.toUpperCase();
+    $('swatch-' + id).style.background = `radial-gradient(circle at 30% 25%, white 1%, ${hex} 38%, color-mix(in srgb, ${hex}, black 28%) 90%)`;
+  });
+}
+$('randomize').addEventListener('click', () => { colors = [randomColor(), randomColor()]; updatePalette(); render(); });
+$('render').addEventListener('click', render);
+$('download').addEventListener('click', () => {
+  if (!completed) return;
+  canvas.toBlob((blob) => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.href = url;
+    link.download = `smallpt-${canvas.width}x${canvas.height}.png`;
+    link.click();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+  }, 'image/png');
+});
+window.addEventListener('pagehide', () => { worker?.terminate(); stopClock(); });
+render();
