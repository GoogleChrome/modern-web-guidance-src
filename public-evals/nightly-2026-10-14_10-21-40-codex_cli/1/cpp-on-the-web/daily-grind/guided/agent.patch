new file mode 100644
index 0000000..c4adbab
--- /dev/null
+++ b/scripts/load-renderer.mjs
@@ -0,0 +1,18 @@
+// Run the browser-only ES module in an isolated worker-like realm, without a browser.
+import { readFile } from 'node:fs/promises';
+import vm from 'node:vm';
+export async function loadRenderer() {
+  const path = new URL('../public/smallpt.js', import.meta.url);
+  const context = vm.createContext({
+    console, WebAssembly, URL, TextDecoder, TextEncoder, setTimeout, clearTimeout,
+    WorkerGlobalScope: class {},
+    fetch: async (url) => new Response(await readFile(new URL(url)), { headers: { 'Content-Type': 'application/wasm' } }),
+  });
+  const script = new vm.SourceTextModule(await readFile(path, 'utf8'), {
+    context,
+    initializeImportMeta(meta) { meta.url = path.href; },
+  });
+  await script.link(() => { throw new Error('Unexpected dependency'); });
+  await script.evaluate();
+  return script.namespace.default();
+}
diff --git a/scripts/preview.mjs b/scripts/preview.mjs
new file mode 100644
index 0000000..9c9b8b7
--- /dev/null
+++ b/scripts/preview.mjs
@@ -0,0 +1,32 @@
+import { writeFile } from 'node:fs/promises';
+import { deflateSync } from 'node:zlib';
+import { loadRenderer } from './load-renderer.mjs';
+const module = await loadRenderer();
+const width = 640, height = 480;
+module._init(width, height, 128, 42, ...Array(6).fill(0.999));
+const start = performance.now();
+for (let row = 0; row < height; row += 4) module._render_rows(row, 4);
+const rgba = module.HEAPU8.slice(module._pixels(), module._pixels() + width * height * 4);
+function crc32(bytes) {
+  let crc = 0xffffffff;
+  for (const byte of bytes) {
+    crc ^= byte;
+    for (let i = 0; i < 8; i++) crc = (crc >>> 1) ^ ((crc & 1) ? 0xedb88320 : 0);
+  }
+  return (crc ^ 0xffffffff) >>> 0;
+}
+function chunk(type, data) {
+  const name = Buffer.from(type);
+  const body = Buffer.concat([name, data]);
+  const header = Buffer.alloc(4); header.writeUInt32BE(data.length);
+  const footer = Buffer.alloc(4); footer.writeUInt32BE(crc32(body));
+  return Buffer.concat([header, body, footer]);
+}
+const header = Buffer.alloc(13);
+header.writeUInt32BE(width, 0); header.writeUInt32BE(height, 4); header[8] = 8; header[9] = 6;
+const scanlines = [];
+for (let row = 0; row < height; row++) scanlines.push(Buffer.from([0]), Buffer.from(rgba.subarray(row * width * 4, (row + 1) * width * 4)));
+await writeFile(new URL('../public/preview.png', import.meta.url), Buffer.concat([
+  Buffer.from([137,80,78,71,13,10,26,10]), chunk('IHDR', header), chunk('IDAT', deflateSync(Buffer.concat(scanlines))), chunk('IEND', Buffer.alloc(0)),
+]));
+console.log(`Generated real WASM preview at 640 × 480, 128 spp in ${((performance.now() - start) / 1000).toFixed(1)}s.`);
diff --git a/scripts/test-wasm.mjs b/scripts/test-wasm.mjs
new file mode 100644
index 0000000..31cfa95
--- /dev/null
+++ b/scripts/test-wasm.mjs
@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { loadRenderer } from './load-renderer.mjs';
+const module = await loadRenderer();
+const width = 64, height = 48;
+function render(colors, batch) {
+  assert.equal(module._init(width, height, 16, 42, ...colors), 1);
+  for (let row = 0; row < height; row += batch) module._render_rows(row, Math.min(batch, height - row));
+  return module.HEAPU8.slice(module._pixels(), module._pixels() + width * height * 4);
+}
+const white = Array(6).fill(0.999);
+const first = render(white, height);
+assert.equal(first.length, width * height * 4);
+assert.ok(first.every((value, index) => index % 4 !== 3 || value === 255), 'Every pixel is opaque');
+assert.ok(new Set(first).size > 100, 'Rendered image has varied pixel intensities');
+assert.deepEqual(render(white, 4), first, 'Row batching preserves render output');
+assert.notDeepEqual(render([0.9, 0.5, 0.6, 0.5, 0.9, 0.7], 4), first, 'Sphere colors change the rendered pixels');
+assert.equal(module._init(0, 48, 16, 42, ...white), 0, 'Invalid dimensions rejected');
+console.log('PASS: browser ES module initializes; WASM renders RGBA, row batches match, sphere colors change output, invalid dimensions rejected.');
