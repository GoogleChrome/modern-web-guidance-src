--- /dev/null
+++ b/render-worker.js
@@ -0,0 +1,36 @@
+importScripts('public/wasm/smallpt.js');
+const ready = createSmallpt();
+let activeJob = 0;
+self.onmessage = async ({data}) => {
+  const job = ++activeJob;
+  try {
+    const module = await ready;
+    if (job !== activeJob) return;
+    const {width, height, samples, seed, colors, id} = data;
+    module._init_render(width, height, seed, ...colors.flat());
+    const start = performance.now();
+    const passes = samples / 4;
+    let lastFrame = 0;
+    for (let pass = 0; pass < passes; pass++) {
+      for (let y = 0; y < height; y += 12) {
+        if (job !== activeJob) return;
+        const rows = Math.min(12, height - y);
+        module._render_rows(y, rows);
+        const now = performance.now();
+        const progress = (pass + (y + rows) / height) / passes;
+        const complete = pass === passes - 1 && y + rows === height;
+        if (now - lastFrame > 180 || complete) {
+          const pointer = module._get_pixels();
+          const pixels = module.HEAPU8.slice(pointer, pointer + width * height * 4);
+          postMessage({type:'frame', id, pixels, width, height, progress, samples: (pass + 1) * 4, elapsed: (now - start) / 1000, complete}, [pixels.buffer]);
+          lastFrame = now;
+        }
+        // Yield between chunks so a new render can replace the current one.
+        await new Promise(resolve => setTimeout(resolve, 0));
+      }
+      module._finish_pass();
+    }
+  } catch (error) {
+    postMessage({type:'error', id:data.id, message:error.message});
+  }
+};
