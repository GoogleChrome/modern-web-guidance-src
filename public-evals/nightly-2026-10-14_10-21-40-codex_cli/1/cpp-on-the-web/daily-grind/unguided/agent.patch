@@ -0,0 +1,28 @@
+const fs = require('node:fs');
+const assert = require('node:assert/strict');
+const createSmallpt = require('../public/wasm/smallpt.js');
+(async () => {
+  const module = await createSmallpt();
+  assert.ok(module.HEAPU8, 'WASM memory is accessible');
+  const render = (colors, width = 64, height = 48, passes = 4) => {
+    module._init_render(width,height,42,...colors);
+    for (let pass = 0; pass < passes; pass++) {
+      for (let y = 0; y < height; y += 12) module._render_rows(y,Math.min(12,height-y));
+      module._finish_pass();
+    }
+    const pointer = module._get_pixels();
+    return Buffer.from(module.HEAPU8.slice(pointer,pointer+width*height*4));
+  };
+  const original = [.999,.999,.999,.999,.999,.999];
+  const baseline = render(original);
+  assert.ok(baseline.some((v,i) => i%4 !== 3 && v > 30), 'Render contains light');
+  assert.ok(baseline.every((v,i) => i%4 !== 3 || v === 255), 'Pixels are opaque');
+  assert.deepEqual(render(original),baseline,'Fixed seeds are reproducible');
+  assert.notDeepEqual(render([.6,.2,.1,.2,.5,.6]),baseline,'Sphere colors change output');
+  console.log('WASM checks passed: visible pixels, alpha, reproducibility, sphere colors.');
+  if (process.argv.includes('--preview')) {
+    const start = Date.now();
+    fs.writeFileSync('/tmp/smallpt-preview.rgba',render(original,640,480,32));
+    console.log(`128 spp preview rendered in ${((Date.now()-start)/1000).toFixed(1)}s`);
+  }
+})().catch(error => { console.error(error); process.exitCode = 1; });
