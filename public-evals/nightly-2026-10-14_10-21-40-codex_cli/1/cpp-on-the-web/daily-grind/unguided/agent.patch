+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+mkdir -p public/wasm
+em++ src/smallpt.cpp -O3 --no-entry -s MODULARIZE=1 -s EXPORT_NAME=createSmallpt -s ENVIRONMENT=web,worker,node -s ALLOW_MEMORY_GROWTH=1 -s STACK_SIZE=1048576 -s EXPORTED_RUNTIME_METHODS='["HEAPU8"]' -s EXPORTED_FUNCTIONS='["_init_render","_render_rows","_finish_pass","_get_pixels"]' -o public/wasm/smallpt.js
