--- /dev/null
+++ b/scripts/check-worker.cjs
@@ -0,0 +1,30 @@
+// Exercise the actual worker orchestration under Node, without opening a browser.
+const { Worker } = require('node:worker_threads');
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const worker = new Worker(`
+  const {parentPort}=require('node:worker_threads');
+  global.self=global;
+  global.importScripts=()=>{global.createSmallpt=require(${JSON.stringify(path.resolve('public/wasm/smallpt.js'))});};
+  global.postMessage=(data,transfer)=>parentPort.postMessage(data,transfer);
+  require(${JSON.stringify(path.resolve('render-worker.js'))});
+  parentPort.on('message',data=>self.onmessage({data}));
+`, {eval:true});
+const config={width:64,height:48,samples:16,seed:42,colors:[[.999,.999,.999],[.999,.999,.999]]};
+const timeout=setTimeout(()=>{console.error('Worker timed out');process.exitCode=1;worker.terminate();},15000);
+let replaced=false;
+worker.on('message',data=>{
+  try {
+    assert.notEqual(data.type,'error',data.message);
+    assert.equal(data.pixels.length,64*48*4);
+    if (!replaced) { replaced=true;worker.postMessage({...config,id:2,colors:[[.5,.3,.2],[.2,.4,.5]]}); }
+    if (data.id===2 && data.complete) {
+      assert.equal(data.progress,1);
+      assert.equal(data.samples,16);
+      console.log('Worker checks passed: progressive frames, replacement render, completion.');
+      clearTimeout(timeout);worker.terminate();
+    }
+  } catch(error) {console.error(error);process.exitCode=1;clearTimeout(timeout);worker.terminate();}
+});
+worker.on('error',error=>{console.error(error);process.exitCode=1;clearTimeout(timeout);});
+worker.postMessage({...config,id:1});
