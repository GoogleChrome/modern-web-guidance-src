new file mode 100644
index 0000000..3ff1408
--- /dev/null
+++ b/README.md
@@ -0,0 +1,17 @@
+# smallpt browser lab
+
+Kevin Beason's [smallpt](https://www.kevinbeason.com/smallpt/) C++ path tracer compiled to WebAssembly with Emscripten. Open `index.html` through the included HTTP server. The precompiled JavaScript and `.wasm` are committed in `public/wasm`, so Emscripten is only needed when rebuilding.
+
+```sh
+pnpm start
+# Recompile with Emscripten (em++ must be on PATH)
+pnpm build
+# Check compiled renderer and worker orchestration in Node; no browser needed
+pnpm check
+```
+
+The original source and MIT license are in `vendor/`. `src/smallpt.cpp` preserves its scene, ray intersections, radiance calculation, Russian roulette, and 2×2 subpixel sampling. Its file-writing main is replaced with an incremental RGBA interface. Per-subpixel radiance is accumulated across passes before clamping, matching smallpt's sample averaging. A dedicated worker renders 12 rows at a time, transfers progressive frames, and accepts replacement renders without blocking the page.
+
+The page starts a 64-sample render automatically. Randomize changes the reflectance of the two visible mirror and glass spheres and starts another render. Color pickers, quality presets, resolution selection, reset, viewport expansion, and PNG download work locally. `public/preview.png` is a 128-sample image generated using this WebAssembly binary, displayed while the first render initializes.
+
+No server-side rendering, uploads, OpenMP, SharedArrayBuffer, or cross-origin isolation is required. Rendering speed depends on the device and selected quality. Serve the app over HTTP rather than opening a `file:` URL so the worker and WebAssembly can load.
diff --git a/app.js b/app.js
new file mode 100644
index 0000000..0aef2be
--- /dev/null
+++ b/app.js
@@ -0,0 +1,111 @@
+const canvas = document.querySelector('#render');
+const context = canvas.getContext('2d');
+const status = document.querySelector('#status');
+const statusDot = document.querySelector('#status-dot');
+const progress = document.querySelector('#progress');
+const sampleCount = document.querySelector('#sample-count');
+const elapsed = document.querySelector('#elapsed');
+const colorInputs = [document.querySelector('#mirror-color'), document.querySelector('#glass-color')];
+let samples = 64;
+let job = 0;
+let hasFrame = false;
+let worker;
+let firstLiveFrame = false;
+const preview = new Image();
+preview.onload = () => { if (!firstLiveFrame) { context.drawImage(preview,0,0,canvas.width,canvas.height); hasFrame = true; } };
+preview.src = 'public/preview.png';
+function updateColors() {
+  for (const [index, name] of ['mirror','glass'].entries()) {
+    const color = colorInputs[index].value;
+    document.querySelector(`#${name}-hex`).textContent = color.toUpperCase();
+    const sphere = document.querySelector(`#${name}-preview`);
+    if (color === '#ffffff') sphere.style.background = '';
+    else sphere.style.background = `radial-gradient(circle at 30% 24%, #fff 0%, ${color} 27%, #18251d 68%, ${color} 95%)`;
+  }
+}
+function linearColor(hex) {
+  // The scene stores linear reflectance; cap it below 1 for Russian roulette.
+  return [1,3,5].map(offset => Math.min(.999,Math.pow(parseInt(hex.slice(offset,offset+2),16)/255,2.2)));
+}
+function run() {
+  if (!worker) return;
+  const width = Number(document.querySelector('#resolution').value);
+  const height = width * .75;
+  // Keep the previous image visible until the next image is ready.
+  document.querySelector('#dimensions').textContent = `${width} × ${height}`;
+  status.textContent = 'Tracing light…';
+  statusDot.className = 'working';
+  progress.style.width = '0%';
+  sampleCount.innerHTML = `0 <small>/ ${samples}</small>`;
+  elapsed.textContent = '0.0s';
+  const seed = crypto.getRandomValues(new Uint32Array(1))[0];
+  worker.postMessage({id:++job, width, height, samples, seed, colors:colorInputs.map(input => linearColor(input.value))});
+}
+try {
+  worker = new Worker('render-worker.js');
+  worker.onmessage = ({data}) => {
+    if (data.id !== job) return;
+    if (data.type === 'error') { showError(data.message); return; }
+    if (canvas.width !== data.width || canvas.height !== data.height) { canvas.width = data.width; canvas.height = data.height; }
+    context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels),data.width,data.height),0,0);
+    firstLiveFrame = true;
+    hasFrame = true;
+    progress.style.width = `${data.progress * 100}%`;
+    sampleCount.innerHTML = `${data.samples} <small>/ ${samples}</small>`;
+    elapsed.textContent = `${data.elapsed.toFixed(1)}s`;
+    if (data.complete) { status.textContent = 'Render complete'; statusDot.className = ''; }
+  };
+  worker.onerror = event => showError(event.message);
+  run();
+} catch (error) { showError(error.message); }
+function showError(message) {
+  status.textContent = 'Renderer unavailable — try reloading';
+  statusDot.className = 'error';
+  console.error('smallpt:', message);
+}
+document.querySelector('#randomize').addEventListener('click', () => {
+  // Pastel tints keep the mirror and glass recognizable while changing their color.
+  for (const input of colorInputs) {
+    const hue = Math.random() * 360;
+    const saturation = .25 + Math.random() * .35;
+    const lightness = .65 + Math.random() * .15;
+    const chroma = (1 - Math.abs(2 * lightness - 1)) * saturation;
+    const x = chroma * (1 - Math.abs((hue / 60) % 2 - 1));
+    const m = lightness - chroma / 2;
+    const rgb = hue < 60 ? [chroma,x,0] : hue < 120 ? [x,chroma,0] : hue < 180 ? [0,chroma,x] : hue < 240 ? [0,x,chroma] : hue < 300 ? [x,0,chroma] : [chroma,0,x];
+    input.value = '#' + rgb.map(c => Math.round((c+m)*255).toString(16).padStart(2,'0')).join('');
+  }
+  updateColors(); run();
+});
+colorInputs.forEach(input => input.addEventListener('change', () => { updateColors(); run(); }));
+document.querySelector('#reset').addEventListener('click', () => { colorInputs.forEach(input => input.value = '#ffffff'); updateColors(); run(); });
+document.querySelectorAll('[data-samples]').forEach(button => {
+  button.setAttribute('aria-pressed', String(button.classList.contains('selected')));
+  button.addEventListener('click', () => {
+    samples = Number(button.dataset.samples);
+    document.querySelectorAll('[data-samples]').forEach(option => { const selected = option === button; option.classList.toggle('selected', selected); option.setAttribute('aria-pressed',String(selected)); });
+    run();
+  });
+});
+document.querySelector('#resolution').addEventListener('change', run);
+document.querySelector('#download').addEventListener('click', () => {
+  if (!hasFrame) return;
+  canvas.toBlob(blob => {
+    if (!blob) return;
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement('a');
+    link.download = `smallpt-${Date.now()}.png`; link.href = url; link.click();
+    setTimeout(() => URL.revokeObjectURL(url),1000);
+  }, 'image/png');
+});
+const renderPanel = document.querySelector('.render-panel');
+const fitButton = document.querySelector('#fit');
+function toggleExpanded(expanded) {
+  renderPanel.classList.toggle('expanded', expanded);
+  fitButton.setAttribute('aria-label', expanded ? 'Collapse viewport' : 'Expand viewport');
+  fitButton.title = expanded ? 'Collapse viewport' : 'Expand viewport';
+  fitButton.setAttribute('aria-pressed',String(expanded));
+  document.body.style.overflow = expanded ? 'hidden' : '';
+}
+fitButton.addEventListener('click', () => toggleExpanded(!renderPanel.classList.contains('expanded')));
+document.addEventListener('keydown', event => { if(event.key === 'Escape') toggleExpanded(false); });
