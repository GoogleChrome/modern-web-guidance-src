diff --git a/src/scripts/studio.ts b/src/scripts/studio.ts
new file mode 100644
index 0000000..c4c88ca
--- /dev/null
+++ b/src/scripts/studio.ts
@@ -0,0 +1,139 @@
+const get = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = get<HTMLCanvasElement>('render-canvas');
+const context = canvas.getContext('2d');
+const quality = get<HTMLInputElement>('quality');
+const resolution = get<HTMLSelectElement>('resolution');
+const mirror = get<HTMLInputElement>('color-mirror');
+const glass = get<HTMLInputElement>('color-glass');
+const samples = [16, 32, 64, 128, 256];
+const defaultColors: Record<number, number[]> = {
+  0: [.36, .65, .53], 1: [.70, .73, .67], 6: [.999, .999, .999], 7: [.999, .999, .999],
+};
+let colors = structuredClone(defaultColors);
+let worker: Worker | null = null;
+let requestId = 0;
+let targetSamples = 64;
+let hasFrame = false;
+
+function setStatus(text: string, busy = false) {
+  get('status-text').textContent = text;
+  get('status-indicator').classList.toggle('busy', busy);
+}
+function render() {
+  if (!worker || !context) return;
+  requestId++;
+  const width = Number(resolution.value), height = width * 3 / 4;
+  targetSamples = samples[Number(quality.value)];
+  get('progress-bar').style.width = '0%';
+  get('sample-count').textContent = `0 / ${targetSamples} spp`;
+  get('elapsed').textContent = '0.0 s';
+  get('viewport-status').textContent = 'RENDERING';
+  setStatus('Tracing the light…', true);
+  worker.postMessage({ type: 'render', requestId, width, height, samples: targetSamples,
+    seed: crypto.getRandomValues(new Uint32Array(1))[0], colors });
+}
+function updateSwatches() {
+  get('mirror-swatch').style.background = mirror.value;
+  get('glass-swatch').style.background = glass.value;
+}
+const toRgb = (hex: string) => [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16) / 255);
+const toHex = (rgb: number[]) => '#' + rgb.map(c => Math.round(c * 255).toString(16).padStart(2, '0')).join('');
+// Reflective tints are kept bright enough for light to survive multiple bounces.
+function randomColor() {
+  const values = crypto.getRandomValues(new Uint8Array(3));
+  const rgb = Array.from(values, v => .35 + v / 255 * .60);
+  rgb[values[0] % 3] = .96;
+  return rgb;
+}
+get('randomize').addEventListener('click', () => {
+  colors[6] = randomColor(); colors[7] = randomColor();
+  mirror.value = toHex(colors[6]); glass.value = toHex(colors[7]);
+  updateSwatches(); render();
+});
+get('rerender').addEventListener('click', render);
+get('reset').addEventListener('click', () => {
+  colors = structuredClone(defaultColors);
+  mirror.value = glass.value = '#fefefe';
+  quality.value = '2'; resolution.value = '640';
+  updateQuality(); updateSwatches(); render();
+});
+function updateQuality() {
+  const spp = samples[Number(quality.value)];
+  get('quality-value').innerHTML = `${spp} <small>spp</small>`;
+  quality.style.background = `linear-gradient(to right,#718e60 ${Number(quality.value) * 25}%,#e9ede1 ${Number(quality.value) * 25}%)`;
+  quality.setAttribute('aria-valuetext', `${spp} samples per pixel`);
+}
+quality.addEventListener('input', updateQuality);
+quality.addEventListener('change', render);
+resolution.addEventListener('change', render);
+mirror.addEventListener('input', updateSwatches);
+glass.addEventListener('input', updateSwatches);
+mirror.addEventListener('change', () => { colors[6] = toRgb(mirror.value); render(); });
+glass.addEventListener('change', () => { colors[7] = toRgb(glass.value); render(); });
+
+try {
+  if (!context) throw new Error('Canvas is unavailable.');
+  worker = new Worker('/renderer/worker.js', { type: 'module' });
+  worker.onmessage = ({ data }) => {
+    if (data.requestId !== requestId) return;
+    if (data.type === 'error') {
+      setStatus('Could not render. Select Render again to retry.');
+      get('viewport-status').textContent = 'RENDER ERROR';
+      console.error('smallpt:', data.message);
+      return;
+    }
+    if (data.type === 'frame') {
+      if (canvas.width !== data.width || canvas.height !== data.height) {
+        canvas.width = data.width; canvas.height = data.height;
+      }
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), data.width, data.height), 0, 0);
+      canvas.classList.add('has-frame');
+      hasFrame = true;
+    }
+    get('progress-bar').style.width = `${data.progress * 100}%`;
+    get('sample-count').textContent = `${data.spp} / ${targetSamples} spp`;
+    get('elapsed').textContent = `${(data.elapsed / 1000).toFixed(1)} s`;
+    if (data.done) {
+      setStatus('Render complete');
+      get('viewport-status').textContent = 'RENDER COMPLETE';
+    } else {
+      setStatus(`Tracing the light… ${Math.floor(data.progress * 100)}%`, true);
+    }
+  };
+  worker.onerror = () => {
+    setStatus('Renderer unavailable. Reload to try again.');
+    get('viewport-status').textContent = 'RENDER ERROR';
+  };
+  render();
+} catch (error) {
+  setStatus('WebAssembly rendering is unavailable in this browser.');
+  get('viewport-status').textContent = 'PREVIEW';
+  console.error(error);
+}
+
+get('download').addEventListener('click', () => {
+  const anchor = document.createElement('a');
+  anchor.download = `smallpt-${Date.now()}.png`;
+  if (hasFrame) {
+    canvas.toBlob(blob => {
+      if (!blob) return;
+      anchor.href = URL.createObjectURL(blob); anchor.click();
+      setTimeout(() => URL.revokeObjectURL(anchor.href), 1000);
+    }, 'image/png');
+  } else { anchor.href = '/renderer/preview.png'; anchor.click(); }
+});
+get('expand').addEventListener('click', async () => {
+  const viewport = get('viewport');
+  try {
+    if (document.fullscreenElement) await document.exitFullscreen();
+    else await viewport.requestFullscreen();
+  } catch { setStatus('Full screen is unavailable in this browser.'); }
+});
+const dialog = get<HTMLDialogElement>('about-dialog');
+get('about-button').addEventListener('click', () => dialog.showModal());
+get('close-about').addEventListener('click', () => dialog.close());
+dialog.addEventListener('click', event => { if (event.target === dialog) {
+  const bounds = dialog.getBoundingClientRect();
+  if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
+} });
+window.addEventListener('pagehide', () => worker?.terminate());
