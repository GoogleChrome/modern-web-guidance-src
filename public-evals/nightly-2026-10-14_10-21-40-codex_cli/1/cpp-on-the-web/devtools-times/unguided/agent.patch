+import createSmallpt from './smallpt.js';
+
+let module;
+let generation = 0;
+const ready = createSmallpt();
+const yieldTask = () => new Promise(resolve => setTimeout(resolve, 0));
+
+self.onmessage = async ({ data }) => {
+  const token = ++generation;
+  if (data.type === 'cancel') return;
+  try {
+    module = await ready;
+    if (token !== generation) return;
+    const { width, height, samples, seed, colors } = data;
+    module._init(width, height, seed);
+    for (const [id, rgb] of Object.entries(colors)) {
+      module._set_color(Number(id), ...rgb);
+    }
+    const total = height * (samples / 4);
+    const start = performance.now();
+    let completed = 0;
+    let lastFrame = 0;
+    // Finish a complete initial pass before replacing the reference preview.
+    while (completed < total && token === generation) {
+      completed = module._render_rows(4);
+      const elapsed = performance.now() - start;
+      if ((completed >= height && elapsed - lastFrame > 180) || completed === total) {
+        const pixels = module.HEAPU8.slice(module._get_pixels(), module._get_pixels() + width * height * 4);
+        self.postMessage({ type: 'frame', requestId: data.requestId, pixels, width, height,
+          progress: completed / total, spp: Math.floor(completed / height) * 4,
+          elapsed, done: completed === total }, [pixels.buffer]);
+        lastFrame = elapsed;
+      } else if (completed < height && elapsed - lastFrame > 250) {
+        self.postMessage({ type: 'progress', requestId: data.requestId,
+          progress: completed / total, elapsed, spp: 0 });
+        lastFrame = elapsed;
+      }
+      await yieldTask();
+    }
+  } catch (error) {
+    self.postMessage({ type: 'error', requestId: data.requestId,
+      message: error instanceof Error ? error.message : String(error) });
+  }
+};
