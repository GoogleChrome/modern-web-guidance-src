+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcc renderer/smallpt.cpp -O3 --no-entry \
+  -s MODULARIZE=1 -s EXPORT_ES6=1 -s ENVIRONMENT=worker,node \
+  -s EXPORTED_RUNTIME_METHODS=HEAPU8 \
+  -s ALLOW_MEMORY_GROWTH=1 -s STACK_SIZE=1048576 \
+  -s EXPORTED_FUNCTIONS='["_init","_set_color","_render_rows","_get_pixels"]' \
+  -o public/renderer/smallpt.js
+cp renderer/LICENSE.txt public/renderer/LICENSE.txt
+cp renderer/smallpt.cpp public/renderer/smallpt.cpp
diff --git a/scripts/check-wasm.mjs b/scripts/check-wasm.mjs
new file mode 100644
index 0000000..b69129c
--- /dev/null
+++ b/scripts/check-wasm.mjs
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import createSmallpt from '../public/renderer/smallpt.js';
+const module = await createSmallpt();
+const width = 48, height = 36, byteLength = width * height * 4;
+function render(colors = [.999,.999,.999]) {
+  module._init(width, height, 42);
+  module._set_color(6, ...colors);
+  module._set_color(7, ...colors);
+  let progress = 0;
+  for(let i = 0; i < height * 4; i += 3) {
+    const next = module._render_rows(3);
+    assert.ok(next > progress, 'Progress advances');
+    progress = next;
+  }
+  assert.equal(progress, height * 4);
+  const pixels = module.HEAPU8.slice(module._get_pixels(), module._get_pixels() + byteLength);
+  assert.equal(pixels.length, byteLength);
+  for(let i=3;i<byteLength;i+=4) assert.equal(pixels[i],255,'Pixel alpha is opaque');
+  assert.ok(pixels.some((value, i) => i%4 !== 3 && value > 0),'Renderer produces visible pixels');
+  return pixels;
+}
+const original = render();
+assert.deepEqual(render(), original, 'The same seed produces the same render');
+assert.notDeepEqual(render([.96,.38,.44]), original, 'Changing sphere colors changes rendered pixels');
+module._init(960, 720, 42);
+module._render_rows(4);
+assert.ok(module.HEAPU8.length >= module._get_pixels() + 960 * 720 * 4, 'Exported heap updates after memory growth');
+console.log('WebAssembly checks passed: RGBA output, progressive sampling, deterministic seeds, sphere recoloring.');
diff --git a/scripts/check-worker.mjs b/scripts/check-worker.mjs
new file mode 100644
index 0000000..b8dd7f0
--- /dev/null
+++ b/scripts/check-worker.mjs
@@ -0,0 +1,46 @@
+import assert from 'node:assert/strict';
+import { Worker } from 'node:worker_threads';
+const workerUrl = new URL('../public/renderer/worker.js', import.meta.url).href;
+const worker = new Worker(`
+  const { parentPort } = require('node:worker_threads');
+  globalThis.self = { postMessage: (message, transfer) => parentPort.postMessage(message, transfer) };
+  import(${JSON.stringify(workerUrl)}).then(() => {
+    parentPort.on('message', data => self.onmessage({ data }));
+    parentPort.postMessage({ type: 'ready' });
+  }).catch(error => { throw error; });
+`, { eval: true });
+const colors = { 0: [.36,.65,.53], 1: [.70,.73,.67], 6: [.96,.38,.44], 7: [.45,.8,.96] };
+let frames = 0;
+let complete = false;
+const timeout = setTimeout(() => { worker.terminate(); throw new Error('Worker timed out'); }, 15000);
+try {
+  await new Promise((resolve, reject) => {
+    worker.on('error', reject);
+    worker.on('message', data => {
+      try {
+        if (data.type === 'ready') {
+          worker.postMessage({type:'render',requestId:1,width:384,height:288,samples:64,seed:42,colors});
+          worker.postMessage({type:'render',requestId:2,width:48,height:36,samples:16,seed:43,colors});
+          return;
+        }
+        assert.notEqual(data.type, 'error', data.message);
+        assert.equal(data.requestId, 2, 'Superseded render is cancelled');
+        if (data.type === 'frame') {
+          frames++;
+          assert.equal(data.pixels.length, 48*36*4);
+          assert.equal(data.width, 48);
+          if (data.done) {
+            assert.equal(data.spp, 16);
+            assert.equal(data.progress, 1);
+            complete = true; resolve();
+          }
+        }
+      } catch (error) { reject(error); }
+    });
+  });
+  assert.ok(complete && frames > 0);
+  console.log('Worker checks passed: transferable frame output, completed render, cancellation of superseded requests.');
+} finally {
+  clearTimeout(timeout);
+  await worker.terminate();
+}
