diff --git a/scripts/build-wasm.sh b/scripts/build-wasm.sh
new file mode 100755
index 0000000..d01f35d
--- /dev/null
+++ b/scripts/build-wasm.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+em++ -fno-exceptions native/smallpt.cpp -O3 -flto --no-entry \
+  -sEXPORT_ES6=1 -sMODULARIZE=1 -sSTRICT=1 -sENVIRONMENT=worker \
+  -sINCOMING_MODULE_JS_API='["wasmBinary"]' -sALLOW_MEMORY_GROWTH=1 -sFILESYSTEM=0 -sASSERTIONS=1 \
+  -sEXPORTED_RUNTIME_METHODS='["HEAPU8"]' \
+  -sEXPORTED_FUNCTIONS='["_init","_set_color","_render_pass"]' \
+  -o public/wasm/smallpt.js
diff --git a/scripts/check-renderer.mjs b/scripts/check-renderer.mjs
new file mode 100644
index 0000000..6022109
--- /dev/null
+++ b/scripts/check-renderer.mjs
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import createSmallpt from '../public/wasm/smallpt.js';
+
+// Supply the browser worker globals and binary without opening a browser.
+const wasmBinary = await readFile(new URL('../public/wasm/smallpt.wasm', import.meta.url));
+const nodeProcess = globalThis.process;
+globalThis.process = undefined;
+globalThis.WorkerGlobalScope = class {};
+let module;
+try { module = await createSmallpt({ wasmBinary }); }
+finally { globalThis.process = nodeProcess; delete globalThis.WorkerGlobalScope; }
+const getFrame = (w, h) => {
+  const pointer = module._render_pass();
+  return module.HEAPU8.slice(pointer, pointer + w * h * 4);
+};
+module._init(48, 36, 1);
+const original = getFrame(48, 36);
+assert.equal(original.length, 48 * 36 * 4);
+assert(original.some((value, index) => index % 4 !== 3 && value > 0), 'Scene contains illuminated pixels');
+assert(original.every((value, index) => index % 4 !== 3 || value === 255), 'All pixels are opaque');
+module._init(48, 36, 1);
+assert.deepEqual(getFrame(48, 36), original, 'Same seed reproduces output');
+module._init(48, 36, 1);
+module._set_color(6, .8, .25, .4);
+module._set_color(7, .25, .7, .4);
+assert.notDeepEqual(getFrame(48, 36), original, 'Changing sphere colors changes rendered output');
+module._init(48, 36, 2);
+const first = getFrame(48, 36);
+assert.notDeepEqual(getFrame(48, 36), first, 'Subsequent passes add samples');
+console.log('Wasm checks passed: valid pixels, deterministic reset, sphere color changes, progressive passes.');
+if (nodeProcess.argv.includes('--preview')) {
+  const { default: sharp } = await import('sharp');
+  module._set_color(6, 244 / 255, 244 / 255, 244 / 255);
+  module._set_color(7, 244 / 255, 244 / 255, 244 / 255);
+  module._init(640, 480, 1);
+  let frame;
+  const start = performance.now();
+  for (let pass = 0; pass < 128; pass++) {
+    frame = getFrame(640, 480);
+    if ((pass + 1) % 32 === 0) console.log(`Preview: ${(pass + 1) * 4} / 512 samples per pixel`);
+  }
+  await sharp(frame, { raw: { width: 640, height: 480, channels: 4 } }).png().toFile('public/render-preview.png');
+  console.log(`Preview rendered from Wasm at 512 spp in ${((performance.now() - start) / 1000).toFixed(1)}s.`);
+}
