+const element = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
+const canvas = element<HTMLCanvasElement>('render');
+const context = canvas.getContext('2d')!;
+const base = document.querySelector<HTMLElement>('.workspace')!.dataset.base!;
+const mirror = element<HTMLInputElement>('mirror-color');
+const glass = element<HTMLInputElement>('glass-color');
+let worker: Worker | undefined;
+let targetSamples = 128;
+let seed = 1;
+let hasPixels = false;
+let colors: Record<number, number[]>;
+const normalize = (hex: string) => [1, 3, 5].map(offset => parseInt(hex.slice(offset, offset + 2), 16) / 255);
+function original() {
+  mirror.value = glass.value = '#f4f4f4';
+  colors = { 0: [.75, .25, .25], 1: [.25, .25, .75], 2: [.75, .75, .75], 4: [.75, .75, .75], 5: [.75, .75, .75], 6: normalize(mirror.value), 7: normalize(glass.value) };
+  updateSwatches();
+}
+function updateSwatches() {
+  element('mirror-hex').textContent = mirror.value.toUpperCase();
+  element('glass-hex').textContent = glass.value.toUpperCase();
+  document.querySelectorAll<HTMLElement>('.wall-colors i').forEach((swatch, index) => {
+    swatch.style.setProperty('--swatch', `rgb(${colors[[0, 1, 4][index]].map(c => Math.round(c * 255)).join(',')})`);
+  });
+}
+function render() {
+  worker?.terminate();
+  element('status').textContent = 'Tracing light…';
+  element('status-dot').classList.remove('complete');
+  element('progress').style.width = '0%';
+  element('samples-stat').textContent = '0';
+  element('time-stat').textContent = '0.0s';
+  try {
+    if (!window.WebAssembly || !window.Worker) throw new Error('This browser needs WebAssembly and Web Workers to render.');
+    worker = new Worker(`${base}wasm/render-worker.js`, { type: 'module' });
+    worker.onmessage = ({ data }) => {
+      if (data.error) { fail(data.error); return; }
+      canvas.width = data.width;
+      canvas.height = data.height;
+      context.putImageData(new ImageData(new Uint8ClampedArray(data.pixels), data.width, data.height), 0, 0);
+      canvas.style.opacity = '1';
+      hasPixels = true;
+      element('samples-stat').textContent = String(data.samples);
+      element('time-stat').textContent = `${(data.elapsed / 1000).toFixed(1)}s`;
+      element('progress').style.width = `${data.samples / targetSamples * 100}%`;
+      element('status').textContent = data.done ? 'Render complete' : 'Tracing light…';
+      element('status-dot').classList.toggle('complete', data.done);
+      if (data.done) { worker?.terminate(); worker = undefined; }
+    };
+    worker.onerror = () => fail('Could not load the renderer. Try Render again.');
+    worker.postMessage({ width: 640, height: 480, samples: targetSamples, seed, colors });
+  } catch (error) { fail((error as Error).message); }
+}
+function fail(message: string) {
+  element('status').textContent = message;
+  worker?.terminate();
