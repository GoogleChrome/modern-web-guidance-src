+element('randomize').addEventListener('click', () => {
+  const values = crypto.getRandomValues(new Uint32Array(7));
+  seed = values[0];
+  const randomColor = (value: number) => {
+    const hue = value % 360;
+    const rgb = [0, 8, 4].map(n => {
+      const k = (n + hue / 30) % 12;
+      return .62 - .25 * Math.max(-1, Math.min(k - 3, 9 - k, 1));
+    });
+    return '#' + rgb.map(c => Math.round(c * 255).toString(16).padStart(2, '0')).join('');
+  };
+  mirror.value = randomColor(values[1]);
+  glass.value = randomColor(values[2]);
+  colors[6] = normalize(mirror.value);
+  colors[7] = normalize(glass.value);
+  colors[0] = normalize(randomColor(values[3]));
+  colors[1] = normalize(randomColor(values[4]));
+  updateSwatches();
+  render();
+});
+for (const [input, id] of [[mirror, 6], [glass, 7]] as const) {
+  input.addEventListener('input', () => { colors[id] = normalize(input.value); updateSwatches(); });
+  input.addEventListener('change', render);
+}
+element('rerender').addEventListener('click', () => { seed = crypto.getRandomValues(new Uint32Array(1))[0]; render(); });
+element('reset').addEventListener('click', () => { seed = 1; original(); render(); });
