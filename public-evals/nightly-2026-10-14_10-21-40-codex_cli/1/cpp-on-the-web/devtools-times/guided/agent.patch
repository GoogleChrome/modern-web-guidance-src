+import createSmallpt from './smallpt.js';
+const modulePromise = createSmallpt();
+let generation = 0;
+self.onmessage = async ({ data }) => {
+  const run = ++generation;
+  try {
+    const module = await modulePromise;
+    if (run !== generation) return;
+    const { width, height, samples, seed, colors } = data;
+    module._init(width, height, seed);
+    for (const [id, color] of Object.entries(colors)) {
+      module._set_color(Number(id), ...color);
+    }
+    const started = performance.now();
+    for (let pass = 0; pass < samples / 4; pass++) {
+      if (run !== generation) return;
+      const pointer = module._render_pass();
+      const pixels = module.HEAPU8.slice(pointer, pointer + width * height * 4);
+      self.postMessage({ pixels, width, height, samples: (pass + 1) * 4,
+        elapsed: performance.now() - started, done: (pass + 1) * 4 >= samples }, [pixels.buffer]);
+      await new Promise(resolve => setTimeout(resolve, 0));
+    }
+  } catch (error) {
+    self.postMessage({ error: error.message || String(error) });
+  }
+};
