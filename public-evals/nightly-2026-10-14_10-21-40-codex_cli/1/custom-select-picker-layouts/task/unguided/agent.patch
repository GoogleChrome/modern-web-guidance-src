+  <script>
+    const picker = document.querySelector('.roast-picker');
+    const trigger = document.getElementById('roast-trigger');
+    const menu = document.getElementById('roast-menu');
+    const options = [...menu.querySelectorAll('[role="option"]')];
+    let selectedIndex = 1;
+
+    function closePicker(returnFocus = false) {
+      menu.hidden = true;
+      trigger.setAttribute('aria-expanded', 'false');
+      if (returnFocus) trigger.focus();
+    }
+
+    function openPicker(index = selectedIndex) {
+      menu.hidden = false;
+      trigger.setAttribute('aria-expanded', 'true');
+      options[index].focus();
+    }
+
+    function selectRoast(index) {
+      selectedIndex = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      document.getElementById('roast-value').textContent = `${options[index].querySelector('strong').textContent} roast`;
+      document.getElementById('order-now').href = `/order-online?roast=${options[index].dataset.roast}`;
+      closePicker(true);
+    }
+
+    trigger.addEventListener('click', () => menu.hidden ? openPicker() : closePicker());
+    trigger.addEventListener('keydown', (event) => {
+      if (['ArrowDown', 'ArrowUp'].includes(event.key)) {
+        event.preventDefault();
+        openPicker();
+      }
+    });
+
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => selectRoast(index));
+      option.addEventListener('keydown', (event) => {
+        let nextIndex;
+        if (['ArrowRight', 'ArrowDown'].includes(event.key)) nextIndex = (index + 1) % options.length;
+        if (['ArrowLeft', 'ArrowUp'].includes(event.key)) nextIndex = (index + options.length - 1) % options.length;
+        if (event.key === 'Home') nextIndex = 0;
+        if (event.key === 'End') nextIndex = options.length - 1;
+        if (nextIndex !== undefined) {
+          event.preventDefault();
+          options[nextIndex].focus();
+        }
+        if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          selectRoast(index);
+        }
+      });
+    });
+
+    picker.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !menu.hidden) {
+        event.preventDefault();
+        closePicker(true);
+      }
+    });
+    picker.addEventListener('focusout', (event) => {
+      if (!picker.contains(event.relatedTarget)) closePicker();
+    });
+    document.addEventListener('click', (event) => {
+      if (!picker.contains(event.target)) closePicker();
+    });
+  </script>
 </body>
 
