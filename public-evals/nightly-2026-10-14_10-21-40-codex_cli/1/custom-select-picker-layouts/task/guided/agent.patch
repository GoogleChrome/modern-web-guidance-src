+  <script>
+    const roast = document.querySelector('#roast');
+    roast.addEventListener('change', () => {
+      document.querySelector('#order-now').href = '/order-online?roast=' + encodeURIComponent(roast.value);
+    });
+
+    // Preserve the card grid in browsers without customizable native selects.
+    if (!CSS.supports('appearance', 'base-select')) {
+      const field = document.querySelector('.roast-field');
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-menu');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-value');
+      trigger.innerHTML = '<span id="roast-value"></span><span aria-hidden="true">⌄</span>';
+      const menu = document.createElement('div');
+      menu.id = 'roast-menu';
+      menu.className = 'roast-menu';
+      menu.setAttribute('role', 'listbox');
+      menu.setAttribute('aria-labelledby', 'roast-label');
+      menu.hidden = true;
+      const options = Array.from(roast.options);
+      const cards = options.map((option) => {
+        const card = document.createElement('div');
+        card.className = 'roast-option';
+        card.setAttribute('role', 'option');
+        card.setAttribute('aria-label', option.getAttribute('aria-label'));
+        card.tabIndex = -1;
+        const photo = document.createElement('img');
+        photo.className = 'roast-photo roast-photo-' + option.value;
+        photo.src = 'assets/coffee-beans.jpg';
+        photo.alt = '';
+        const title = document.createElement('span');
+        title.className = 'roast-title';
+        title.textContent = option.value[0].toUpperCase() + option.value.slice(1);
+        const notes = document.createElement('span');
+        notes.className = 'roast-notes';
+        notes.textContent = option.dataset.notes;
+        card.append(photo, title, notes);
+        card.addEventListener('click', () => {
+          roast.value = option.value;
+          roast.dispatchEvent(new Event('change', { bubbles: true }));
+          sync();
+          close(true);
+        });
+        menu.append(card);
+        return card;
+      });
+      function sync() {
+        trigger.querySelector('#roast-value').textContent = options[roast.selectedIndex].value.replace(/^./, c => c.toUpperCase());
+        cards.forEach((card, index) => card.setAttribute('aria-selected', String(index === roast.selectedIndex)));
+      }
+      function close(restoreFocus = false) {
+        menu.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) trigger.focus();
+      }
+      function open() {
+        menu.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        cards[roast.selectedIndex].focus();
+      }
+      trigger.addEventListener('click', () => menu.hidden ? open() : close());
+      trigger.addEventListener('keydown', event => {
+        if (['ArrowDown', 'ArrowUp'].includes(event.key)) {
+          event.preventDefault();
+          open();
+        }
+      });
+      menu.addEventListener('keydown', event => {
+        const index = cards.indexOf(document.activeElement);
+        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
+        if (step || event.key === 'Home' || event.key === 'End') {
+          event.preventDefault();
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? cards.length - 1 : (index + step + cards.length) % cards.length;
+          cards[next].focus();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          cards[index].click();
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          close(true);
+        } else if (event.key.length === 1) {
+          const match = options.findIndex(option => option.value.startsWith(event.key.toLowerCase()));
+          if (match !== -1) cards[match].focus();
+        }
+      });
+      document.addEventListener('click', event => { if (!field.contains(event.target)) close(); });
+      field.addEventListener('focusout', event => { if (!field.contains(event.relatedTarget)) close(); });
+      roast.hidden = true;
+      document.querySelector('#roast-label').htmlFor = trigger.id;
+      field.append(trigger, menu);
+      sync();
+    }
+  </script>
