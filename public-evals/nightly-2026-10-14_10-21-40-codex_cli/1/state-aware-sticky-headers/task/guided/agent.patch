+  <script>
+    const navigation = document.querySelector('nav');
+    const stickyContainers = [...document.querySelectorAll('.sticky-container')];
+    const needsStuckFallback = !CSS.supports('container-type', 'scroll-state');
+    let framePending = false;
+
+    function updateStuckHeaders() {
+      framePending = false;
+      const top = navigation.getBoundingClientRect().height;
+      stickyContainers.forEach(container => {
+        const marker = container.previousElementSibling.getBoundingClientRect();
+        const section = container.parentElement.getBoundingClientRect();
+        // The document is the scroll root; the marker preserves the natural header position.
+        container.classList.toggle('is-stuck', marker.top < top &&
+          section.bottom > top + container.getBoundingClientRect().height);
+      });
+    }
+
+    function scheduleStuckUpdate() {
+      if (!framePending) {
+        framePending = true;
+        requestAnimationFrame(updateStuckHeaders);
+      }
+    }
+
+    new ResizeObserver(() => {
+      document.documentElement.style.setProperty('--nav-height',
+        `${navigation.getBoundingClientRect().height}px`);
+      if (needsStuckFallback) scheduleStuckUpdate();
+    }).observe(navigation);
+
+    if (needsStuckFallback) {
+      window.addEventListener('scroll', scheduleStuckUpdate, { passive: true });
+      window.addEventListener('resize', scheduleStuckUpdate);
+      scheduleStuckUpdate();
+    }
+  </script>
+
