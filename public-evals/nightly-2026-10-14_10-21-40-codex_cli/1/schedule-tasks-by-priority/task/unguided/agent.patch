+<script>
+    (() => {
+      const definitions = {
+        checkout: { name: 'Checkout', label: 'Urgent', className: 'urgent', priority: 'user-blocking', rank: 0, chunks: 36 },
+        menu: { name: 'Menu update', label: 'Standard', className: 'standard', priority: 'user-visible', rank: 1, chunks: 60 },
+        telemetry: { name: 'Telemetry logging', label: 'Background', className: 'background', priority: 'background', rank: 2, chunks: 84 }
+      };
+      const pending = [];
+      const list = document.getElementById('task-list');
+      const activity = document.getElementById('activity-list');
+      const status = document.getElementById('queue-status');
+      let nextId = 1;
+      let completed = 0;
+      let scheduled = false;
+      let lastTaskId = null;
+      let nativeScheduler = typeof globalThis.scheduler?.postTask === 'function';
+
+      function log(message) {
+        if (activity.dataset.started !== 'true') {
+          activity.replaceChildren();
+          activity.dataset.started = 'true';
+        }
+        const entry = document.createElement('li');
+        const time = document.createElement('time');
+        time.dateTime = new Date().toISOString();
+        time.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
+        entry.append(time, document.createTextNode(message));
+        activity.prepend(entry);
+        while (activity.children.length > 40) activity.lastElementChild.remove();
+      }
+
+      function render() {
+        pending.sort((a, b) => a.rank - b.rank || a.id - b.id);
+        list.replaceChildren();
+        if (!pending.length) {
+          const empty = document.createElement('li');
+          empty.className = 'empty-queue';
+          empty.textContent = 'All caught up. Run a task to get started.';
+          list.append(empty);
+        }
+        for (const [index, task] of pending.entries()) {
+          const row = document.createElement('li');
+          row.className = 'queue-task';
+          const top = document.createElement('div');
+          top.className = 'task-topline';
+          const title = document.createElement('strong');
+          title.textContent = `${task.name} #${task.id}`;
+          const badge = document.createElement('span');
+          badge.className = `priority ${task.className}`;
+          badge.textContent = task.label;
+          top.append(title, badge);
+          const state = document.createElement('span');
+          state.className = 'task-state';
+          state.textContent = `${index === 0 ? 'Running' : task.done ? 'Paused for higher priority' : 'Queued'} · ${Math.round(task.done / task.chunks * 100)}%`;
+          const progress = document.createElement('progress');
+          progress.max = task.chunks;
+          progress.value = task.done;
+          progress.setAttribute('aria-label', `${task.name} #${task.id} progress`);
+          row.append(top, state, progress);
+          list.append(row);
+        }
+        document.getElementById('queue-count').textContent = `${pending.length} pending`;
+        document.getElementById('completed-count').textContent = `${completed} completed`;
+        const statusText = pending.length ? 'Processing tasks' : 'Ready for tasks';
+        if (status.textContent !== statusText) status.textContent = statusText;
+      }
+
+      // Choose again after every chunk so newly queued urgent work can preempt.
+      function runChunk() {
+        scheduled = false;
+        pending.sort((a, b) => a.rank - b.rank || a.id - b.id);
+        const task = pending[0];
+        if (!task) return;
+        if (lastTaskId !== task.id) {
+          log(`${task.done ? 'Resumed' : 'Started'} ${task.name.toLowerCase()} #${task.id}.`);
+          lastTaskId = task.id;
+        }
+        // Bound CPU work to 4ms; never monopolize the main thread for a whole task.
+        const deadline = performance.now() + 4;
+        let checksum = task.checksum || 0;
+        while (performance.now() < deadline) {
+          for (let i = 0; i < 100; i++) checksum = (checksum + Math.sqrt(i + task.id)) % 100000;
+        }
+        task.checksum = checksum;
+        task.done++;
+        if (task.done === task.chunks) {
+          pending.shift();
+          completed++;
+          log(`Completed ${task.name.toLowerCase()} #${task.id}.`);
+          lastTaskId = null;
+        }
+        render();
+        scheduleNext();
+      }
+
+      function scheduleNext() {
+        if (scheduled || !pending.length) return;
+        scheduled = true;
+        pending.sort((a, b) => a.rank - b.rank || a.id - b.id);
+        // A delay gives input and rendering room between bounded work chunks.
+        if (nativeScheduler) {
+          globalThis.scheduler.postTask(runChunk, { priority: pending[0].priority, delay: 16 }).catch(() => {
+            nativeScheduler = false;
+            setTimeout(runChunk, 16);
+          });
+        } else {
+          setTimeout(runChunk, 16);
+        }
+      }
+
+      function enqueue(types) {
+        for (const type of types) {
+          const task = { ...definitions[type], id: nextId++, done: 0 };
+          pending.push(task);
+          log(`Queued ${task.name.toLowerCase()} #${task.id} · ${task.label.toLowerCase()}.`);
+        }
+        render();
+        scheduleNext();
+      }
+      document.querySelectorAll('[data-task]').forEach(button => {
+        button.addEventListener('click', () => enqueue([button.dataset.task]));
+      });
+      // Deliberately enqueue out of order to demonstrate priority selection.
+      document.getElementById('run-batch').addEventListener('click', () => enqueue(['telemetry', 'menu', 'checkout']));
+    })();
+  </script>
