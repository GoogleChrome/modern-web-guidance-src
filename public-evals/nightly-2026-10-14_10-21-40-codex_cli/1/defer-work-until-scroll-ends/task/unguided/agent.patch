+  <script>
+    const scroller = document.getElementById('scroller');
+    const status = document.getElementById('status');
+    const origins = Array.from(scroller.querySelectorAll('[data-origin]'));
+    const supportsScrollEnd = 'onscrollend' in scroller;
+    let scrolling = false;
+    let scrollTimer;
+
+    function updateVisibleOrigin() {
+      if (!scrolling) return;
+      scrolling = false;
+
+      // Read layout only once scrolling has settled, never in the scroll handler.
+      const bounds = scroller.getBoundingClientRect();
+      const viewportLeft = bounds.left + scroller.clientLeft;
+      const viewportTop = bounds.top + scroller.clientTop;
+      const viewportRight = viewportLeft + scroller.clientWidth;
+      const viewportBottom = viewportTop + scroller.clientHeight;
+      let mostVisible = origins[0];
+      let largestArea = -1;
+
+      for (const origin of origins) {
+        const rect = origin.getBoundingClientRect();
+        const width = Math.max(0, Math.min(rect.right, viewportRight) - Math.max(rect.left, viewportLeft));
+        const height = Math.max(0, Math.min(rect.bottom, viewportBottom) - Math.max(rect.top, viewportTop));
+        const visibleArea = width * height;
+        if (visibleArea > largestArea) {
+          largestArea = visibleArea;
+          mostVisible = origin;
+        }
+      }
+
+      status.textContent = `Scroll ended. Visible: ${mostVisible.dataset.origin}`;
+    }
+
+    scroller.addEventListener('scroll', () => {
+      // A single text update per scrolling session keeps the hot path lightweight.
+      if (!scrolling) {
+        scrolling = true;
+        status.textContent = 'Scrolling…';
+      }
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(updateVisibleOrigin, 150);
+      }
+    }, { passive: true });
+
+    if (supportsScrollEnd) {
+      scroller.addEventListener('scrollend', updateVisibleOrigin);
+    }
+  </script>
