+  <script>
+    const reviewsScroller = document.querySelector('.reviews-scroll');
+    const reviewsFrame = document.querySelector('.reviews-frame');
+
+    function updateReviewIndicators() {
+      const { scrollTop, scrollHeight, clientHeight } = reviewsScroller;
+      reviewsFrame.classList.toggle('scrolled-down', scrollTop > 0);
+      // Allow for fractional scroll positions at the bottom of the list.
+      reviewsFrame.classList.toggle('can-scroll-down', scrollHeight - clientHeight - scrollTop > 1);
+    }
+
+    reviewsScroller.addEventListener('scroll', updateReviewIndicators, { passive: true });
+    window.addEventListener('resize', updateReviewIndicators);
+    const reviewsResizeObserver = new ResizeObserver(updateReviewIndicators);
+    reviewsResizeObserver.observe(reviewsScroller);
+    reviewsResizeObserver.observe(document.querySelector('.reviews-list'));
+    updateReviewIndicators();
+  </script>
+
 </body>
 
