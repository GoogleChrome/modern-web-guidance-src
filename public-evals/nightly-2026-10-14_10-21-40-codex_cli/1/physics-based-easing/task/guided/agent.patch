+    }
+
+    .card.bounce {
+      transition: transform 0.75s ease-out;
+      /* Successively smaller rebounds give the scale a playful bounce. */
+      transition-timing-function: linear(
+        0, 0.214 14.7%, 0.386 23.7%, 0.598 31.9%, 0.999 44.7%,
+        0.807 52.6%, 0.762 56%, 0.747 59.4%, 0.758 62.4%,
+        0.793 65.6%, 0.999 77.4%, 0.961 81.2%, 0.949 84.8%,
+        0.956 88%, 0.993 95.5%, 1
+      );
+    }
+
+    .card.spring:hover,
+    .card.spring:focus-within,
+    .card.bounce:hover,
+    .card.bounce:focus-within {
+      transform: scale(1.04);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .card.spring,
+      .card.bounce {
+        transition: none;
+        transform: none;
+      }
+    }
