+  <button type="button" id="feedback-launcher" class="feedback-launcher" aria-haspopup="dialog" aria-controls="feedback-dialog">Feedback</button>
+
+  <script>
+    const feedbackDialog = document.getElementById('feedback-dialog');
+    const feedbackLauncher = document.getElementById('feedback-launcher');
+    const feedbackMove = document.getElementById('feedback-move');
+    const feedbackLocation = document.getElementById('feedback-location');
+    const mainHost = document.getElementById('feedback-main-host');
+    const footerHost = document.getElementById('feedback-footer-host');
+
+    feedbackLauncher.addEventListener('click', () => {
+      if (!feedbackDialog.open) feedbackDialog.showModal();
+    });
+
+    document.querySelectorAll('.feedback-close, .feedback-close-action').forEach(button => {
+      button.addEventListener('click', () => feedbackDialog.close());
+    });
+
+    // Escape uses the dialog's native cancel behavior. Restore the opener only
+    // for a real dismissal, not a fallback close immediately followed by reopen.
+    feedbackDialog.addEventListener('close', () => {
+      if (!feedbackDialog.open) feedbackLauncher.focus({ preventScroll: true });
+    });
+
+    feedbackMove.addEventListener('click', () => {
+      const target = feedbackDialog.parentElement === mainHost ? footerHost : mainHost;
+
+      if (typeof target.moveBefore === 'function') {
+        // Both hosts stay connected to the same document. This atomic move
+        // preserves top-layer membership, modality, and the focused element.
+        target.moveBefore(feedbackDialog, null);
+      } else {
+        const wasOpen = feedbackDialog.open;
+        const focused = document.activeElement;
+        const selection = focused instanceof HTMLTextAreaElement ||
+          (focused instanceof HTMLInputElement && focused.selectionStart !== null)
+          ? [focused.selectionStart, focused.selectionEnd, focused.selectionDirection]
+          : null;
+        const scrollTop = feedbackDialog.scrollTop;
+        const scrollLeft = feedbackDialog.scrollLeft;
+        const returnValue = feedbackDialog.returnValue;
+
+        // Explicitly close before detaching: some engines keep the open
+        // attribute after removal even though the dialog leaves the top layer.
+        if (wasOpen) feedbackDialog.close();
+        target.insertBefore(feedbackDialog, null);
+        if (wasOpen) {
+          feedbackDialog.showModal();
+          feedbackDialog.returnValue = returnValue;
+          if (focused instanceof HTMLElement && feedbackDialog.contains(focused)) {
+            focused.focus({ preventScroll: true });
+            if (selection) focused.setSelectionRange(...selection);
+          }
+          feedbackDialog.scrollTop = scrollTop;
+          feedbackDialog.scrollLeft = scrollLeft;
+        }
+      }
+
+      const atFooter = target === footerHost;
+      feedbackLocation.textContent = `Window location: ${atFooter ? 'Footer' : 'Seasonal favorites'}`;
+      feedbackMove.textContent = atFooter ? 'Move to favorites' : 'Move to footer';
+    });
+  </script>
