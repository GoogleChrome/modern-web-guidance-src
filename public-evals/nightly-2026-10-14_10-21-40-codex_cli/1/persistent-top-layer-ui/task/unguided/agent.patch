+  <button class="feedback-launcher" id="feedback-open" type="button" aria-haspopup="dialog" aria-controls="feedback-dialog"><span aria-hidden="true">♡</span> Share your thoughts</button>
+
+  <script>
+    const dialog = document.getElementById('feedback-dialog');
+    const form = document.getElementById('feedback-form');
+    const message = document.getElementById('feedback-message');
+    const status = document.getElementById('feedback-status');
+    const launcher = document.getElementById('feedback-open');
+    const hosts = [document.getElementById('feedback-main-host'), document.getElementById('feedback-footer-host')];
+    const draftKey = 'daily-grind-feedback-draft';
+
+    function updateCount() {
+      document.getElementById('feedback-count').textContent = `${message.value.length} / 1,000`;
+    }
+
+    function saveDraft() {
+      const values = Object.fromEntries(new FormData(form));
+      try {
+        localStorage.setItem(draftKey, JSON.stringify(values));
+        return true;
+      } catch {
+        // The dialog still works when browser storage is disabled or full.
+        return false;
+      }
+    }
+
+    try {
+      const draft = JSON.parse(localStorage.getItem(draftKey) || 'null');
+      if (draft && typeof draft === 'object') {
+        if (typeof draft.message === 'string') message.value = draft.message.slice(0, 1000);
+        for (const input of form.querySelectorAll('input[type="radio"]')) {
+          if (draft[input.name] === input.value) input.checked = true;
+        }
+      }
+    } catch { /* Ignore unavailable storage or an invalid saved draft. */ }
+    updateCount();
+
+    form.addEventListener('input', () => {
+      updateCount();
+      status.textContent = saveDraft() ? '' : 'Draft stays here while this page is open. Device storage is unavailable.';
+    });
+    form.addEventListener('submit', event => {
+      event.preventDefault();
+      status.textContent = saveDraft()
+        ? 'Thank you! Your feedback is saved on this device.'
+        : 'Device storage is unavailable. Your feedback is still here in this dialog.';
+    });
+
+    function openFeedback() {
+      if (!dialog.open) dialog.showModal();
+    }
+    launcher.addEventListener('click', openFeedback);
+    document.getElementById('feedback-close').addEventListener('click', () => dialog.close());
+    dialog.addEventListener('close', () => {
+      // A fallback move reopens synchronously before this queued event fires.
+      if (!dialog.open) launcher.focus({ preventScroll: true });
+    });
+
+    document.getElementById('feedback-move').addEventListener('click', () => {
+      const destination = hosts.find(host => host !== dialog.parentElement);
+      // Both hosts stay connected in the same document, as moveBefore requires.
+      if (typeof destination.moveBefore === 'function') {
+        destination.moveBefore(dialog, null);
+      } else {
+        const wasOpen = dialog.open;
+        const activeElement = document.activeElement;
+        const hadFocus = dialog.contains(activeElement);
+        const selection = hadFocus && typeof activeElement.selectionStart === 'number'
+          ? [activeElement.selectionStart, activeElement.selectionEnd, activeElement.selectionDirection]
+          : null;
+        const scrollPositions = [dialog, ...dialog.querySelectorAll('*')]
+          .map(element => [element, element.scrollLeft, element.scrollTop]);
+        const pageScroll = [window.scrollX, window.scrollY];
+        const returnValue = dialog.returnValue;
+        // Explicitly close first so showModal restores the top layer and inertness.
+        if (wasOpen) dialog.close();
+        destination.appendChild(dialog);
+        if (wasOpen) dialog.showModal();
+        dialog.returnValue = returnValue;
+        if (hadFocus) {
+          activeElement.focus({ preventScroll: true });
+          if (selection) activeElement.setSelectionRange(...selection);
+        }
+        for (const [element, left, top] of scrollPositions) {
+          element.scrollLeft = left;
+          element.scrollTop = top;
+        }
+        window.scrollTo(...pageScroll);
+      }
+      document.getElementById('feedback-move-status').textContent = 'Moved. Your draft stays with you.';
+    });
+
+    openFeedback();
+  </script>
 </body>
 
