+++ b/timing.test.js
@@ -0,0 +1,116 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createTimingMonitor } from './timing.js';
+
+function setup(types = []) {
+  let time = 100;
+  const callbacks = new Map();
+  const frames = [];
+  const env = {
+    location: { pathname: '/menu', href: 'https://coffee.example/menu' },
+    document: { visibilityState: 'visible' },
+    performance: { now: () => time },
+    requestAnimationFrame: callback => frames.push(callback),
+    PerformanceObserver: class {
+      static supportedEntryTypes = types;
+      constructor(callback) { this.callback = callback; }
+      observe({ type }) { callbacks.set(type, this.callback); }
+      disconnect() {}
+    },
+  };
+  return {
+    env, monitor: createTimingMonitor(env),
+    setTime: value => { time = value; },
+    flush: () => { while (frames.length) frames.shift()(); },
+    emit: (type, entry) => callbacks.get(type)({ getEntries: () => [entry] }),
+  };
+}
+
+test('fallback includes event queueing and rendering, with the destination URL', () => {
+  const { env, monitor, setTime, flush } = setup();
+  const token = monitor.begin('View Details', 'Navigation', { timeStamp: 80 });
+  env.location.pathname = '/menu/espresso';
+  monitor.contentUpdated(token);
+  assert.equal(monitor.snapshot().length, 0);
+  setTime(130);
+  flush();
+  assert.deepEqual(monitor.snapshot().map(({ first, path, source }) => ({ first, path, source })), [
+    { first: 50, path: '/menu/espresso', source: 'Frame estimate' },
+  ]);
+});
+
+test('background rendering and cleared in-flight work do not produce samples', () => {
+  const { env, monitor, flush } = setup();
+  monitor.contentUpdated(monitor.begin('Filter', 'Interaction'));
+  env.document.visibilityState = 'hidden';
+  flush();
+  assert.equal(monitor.snapshot().length, 0);
+  env.document.visibilityState = 'visible';
+  monitor.contentUpdated(monitor.begin('Filter', 'Interaction'));
+  monitor.clear();
+  flush();
+  assert.equal(monitor.snapshot().length, 0);
+});
+
+test('native paint before navigation is reclassified using interactionId', () => {
+  const { monitor, emit } = setup(['interaction-contentful-paint', 'soft-navigation']);
+  monitor.hint({ timeStamp: 100 }, 'Menu');
+  const paint = { interactionId: 7, startTime: 100, presentationTime: 150 };
+  emit('interaction-contentful-paint', paint);
+  emit('soft-navigation', {
+    interactionId: 7, startTime: 100, presentationTime: 140,
+    name: 'https://coffee.example/menu/espresso',
+    getLargestInteractionContentfulPaint: () => paint,
+  });
+  emit('interaction-contentful-paint', { ...paint, presentationTime: 210 });
+  assert.equal(monitor.snapshot().length, 1);
+  assert.deepEqual(monitor.snapshot()[0], {
+    id: 'native-7', label: 'Menu', kind: 'Navigation', path: '/menu/espresso',
+    start: 100, first: 40, latest: 110, source: 'Browser measured',
+  });
+});
+
+test('native mode excludes untracked panel updates and avoids fallback duplicates', () => {
+  const { monitor, emit, flush } = setup(['interaction-contentful-paint']);
+  emit('interaction-contentful-paint', { interactionId: 1, startTime: 100, presentationTime: 120 });
+  monitor.contentUpdated(monitor.begin('Menu', 'Navigation'));
+  flush();
+  assert.equal(monitor.snapshot().length, 0);
+});
+
+test('record storage is bounded and exported snapshots are independent', () => {
+  const { monitor, flush } = setup();
+  for (let i = 0; i < 110; i++) {
+    monitor.contentUpdated(monitor.begin(`Filter ${i}`, 'Interaction'));
+    flush();
+  }
+  assert.equal(monitor.snapshot().length, 100);
+  const records = monitor.snapshot();
+  records[0].label = 'Changed';
+  assert.equal(monitor.snapshot()[0].label, 'Filter 10');
+});
+
+test('clearing ignores delayed buffered native entries', () => {
+  const { monitor, emit, setTime } = setup(['interaction-contentful-paint']);
+  monitor.hint({ timeStamp: 80 }, 'Menu');
+  setTime(200);
+  monitor.clear();
+  emit('interaction-contentful-paint', { interactionId: 2, startTime: 80, presentationTime: 250 });
+  assert.equal(monitor.snapshot().length, 0);
+});
+
+test('rapid updates discard an earlier render opportunity that was superseded', () => {
+  const { monitor, flush } = setup();
+  monitor.contentUpdated(monitor.begin('First filter', 'Interaction'));
+  monitor.contentUpdated(monitor.begin('Second filter', 'Interaction'));
+  flush();
+  assert.equal(monitor.snapshot().length, 1);
+  assert.equal(monitor.snapshot()[0].label, 'Second filter');
+});
+
+test('history traversal can explicitly estimate when no native initiating event exists', () => {
+  const { monitor, flush } = setup(['interaction-contentful-paint']);
+  monitor.contentUpdated(monitor.begin('Back / forward', 'Navigation'), { estimate: true });
+  flush();
+  assert.equal(monitor.snapshot()[0].source, 'Frame estimate');
+});
