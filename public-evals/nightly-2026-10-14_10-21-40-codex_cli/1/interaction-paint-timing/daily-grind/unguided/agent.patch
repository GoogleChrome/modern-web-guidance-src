+import { createTimingMonitor } from './timing.js';
+
+const monitor = createTimingMonitor();
+const content = document.querySelector('#coffee-content');
+const original = content.innerHTML;
+const products = {
+  seasonal: ['Maple Oat Latte', 'Creamy oat milk with a hint of Vermont maple syrup.', 'Seasonal'],
+  espresso: ['Dark Roast Espresso', 'Bold, smokey, and perfect for a morning boost.', 'Hot'],
+  'cold-brew': ['Cold Brew', 'Steeped for 18 hours for maximum smoothness.', 'Cold'],
+};
+const escape = value => String(value).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
+const card = ([name, description, category], slug) => `<div class="card" data-category="${category}"><span class="category">${category}</span><h3>${name}</h3><p>${description}</p><a href="/menu/${slug}" class="btn">View Details</a></div>`;
+
+function renderRoute(path) {
+  if (path === '/') content.innerHTML = original;
+  else if (path === '/menu' || path === '/order-online') {
+    content.innerHTML = `<div class="section-heading"><div><span class="eyebrow">Find your daily favorite</span><h2>Our coffee menu</h2></div><a href="/">Back to home &rarr;</a></div><div class="filters" role="group" aria-label="Filter drinks">${['All', 'Seasonal', 'Hot', 'Cold'].map(category => `<button data-filter="${category}" aria-pressed="${category === 'All'}">${category}</button>`).join('')}</div><p id="filter-summary" aria-live="polite">Showing all 3 drinks</p><div class="grid">${Object.entries(products).map(([slug, product]) => card(product, slug)).join('')}</div>`;
+  } else {
+    const product = products[path.split('/')[2]];
+    if (!product || !path.startsWith('/menu/')) return false;
+    content.innerHTML = `<a href="/menu" class="back-link">&larr; All drinks</a><article class="product-detail"><span class="eyebrow">${product[2]} favorite</span><h2>${product[0]}</h2><p>${product[1]}</p><p>Ethically sourced coffee, locally roasted and made fresh for your cup.</p><a href="/menu" class="btn">Explore the menu</a></article>`;
+  }
+  document.title = `${path === '/' ? 'The Daily Grind' : path === '/menu' || path === '/order-online' ? 'Our Coffee Menu' : products[path.split('/')[2]][0]} | Artisanal Coffee`;
+  document.querySelectorAll('nav a').forEach(link => {
+    if (link.pathname === path) link.setAttribute('aria-current', 'page');
+    else link.removeAttribute('aria-current');
+  });
+  return true;
+}
+
+// Capture the initiating event before handlers, including keyboard activation.
+for (const type of ['pointerdown', 'keydown', 'click']) {
+  document.addEventListener(type, event => {
+    const target = event.target.closest('a, button, input, select');
+    if (!target || target.closest('#timing-panel')) return;
+    monitor.hint(event, target.textContent.trim() || target.getAttribute('aria-label') || type);
+  }, true);
+}
+
+document.addEventListener('click', event => {
+  const filter = event.target.closest('[data-filter]');
+  if (filter) {
+    if (filter.getAttribute('aria-pressed') === 'true') return;
+    const token = monitor.begin(`Filter: ${filter.dataset.filter}`, 'Interaction', event);
+    document.querySelectorAll('[data-filter]').forEach(button => button.setAttribute('aria-pressed', String(button === filter)));
+    let count = 0;
+    content.querySelectorAll('[data-category]').forEach(card => {
+      card.hidden = filter.dataset.filter !== 'All' && card.dataset.category !== filter.dataset.filter;
+      if (!card.hidden) count++;
+    });
+    document.querySelector('#filter-summary').textContent = `Showing ${count} ${count === 1 ? 'drink' : 'drinks'}${filter.dataset.filter === 'All' ? '' : ` · ${filter.dataset.filter}`}`;
+    monitor.contentUpdated(token);
+    return;
+  }
+  const link = event.target.closest('a');
+  if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target || link.hasAttribute('download')) return;
+  const url = new URL(link.href);
+  if (url.origin !== location.origin || url.search || url.hash) return;
+  const known = ['/', '/menu', '/order-online', ...Object.keys(products).map(slug => `/menu/${slug}`)];
+  if (!known.includes(url.pathname)) return;
+  event.preventDefault();
+  if (url.pathname === location.pathname) return;
+  const token = monitor.begin(link.textContent.trim(), 'Navigation', event);
+  history.pushState(null, '', url.pathname);
+  renderRoute(url.pathname);
+  content.scrollIntoView({ block: 'start' });
+  content.focus({ preventScroll: true });
+  monitor.contentUpdated(token);
+});
+window.addEventListener('popstate', () => {
+  const token = monitor.begin('Back / forward', 'Navigation');
+  // History traversal may have no observable initiating DOM interaction.
+  if (renderRoute(location.pathname)) monitor.contentUpdated(token, { estimate: true });
+});
+if (location.pathname !== '/') renderRoute(location.pathname);
+
+const ms = value => Number.isFinite(value) ? `${value.toFixed(1)} ms` : '—';
+document.querySelector('#measurement-mode').textContent = monitor.nativePaint ? 'Browser measured' : 'Frame estimates';
+document.querySelector('#measurement-note').textContent = monitor.nativePaint
+  ? 'Real presentation timings from the browser. First update and latest contentful update are grouped by interaction. Up to 100 interactions are kept in this tab.'
+  : 'This browser does not expose contentful interaction paints. Timings estimate the next frame after a content update; they do not confirm pixels reached the screen. Up to 100 interactions are kept in this tab.';
+monitor.subscribe(records => {
+  const valid = records.filter(record => Number.isFinite(record.first));
+  document.querySelector('#interaction-count').textContent = valid.filter(record => record.kind === 'Interaction').length;
+  document.querySelector('#navigation-count').textContent = valid.filter(record => record.kind === 'Navigation').length;
+  document.querySelector('#latest-timing').textContent = valid.length ? ms(valid.at(-1).first) : '—';
+  document.querySelector('#timing-rows').innerHTML = valid.length ? valid.slice(-8).reverse().map(record => `<tr><td><strong>${escape(record.label)}</strong><small>${escape(record.path)}</small></td><td><span class="type-pill">${record.kind}</span></td><td>${ms(record.first)}</td><td>${ms(record.latest)}</td><td>${record.source}</td></tr>`).join('') : '<tr><td colspan="5" class="empty-state">Your next interaction starts the story.<br><small>Open the menu, view a drink, or filter the selection to see live timings.</small></td></tr>';
+  document.querySelector('#export-timings').disabled = !valid.length;
+});
+document.querySelector('#clear-timings').addEventListener('click', () => monitor.clear());
+document.querySelector('#export-timings').addEventListener('click', () => {
+  const blob = new Blob([JSON.stringify({ mode: monitor.nativePaint ? 'native' : 'estimate', records: monitor.snapshot() }, null, 2)], { type: 'application/json' });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = 'daily-grind-timings.json';
+  link.click();
+  setTimeout(() => URL.revokeObjectURL(url), 1000);
+});
