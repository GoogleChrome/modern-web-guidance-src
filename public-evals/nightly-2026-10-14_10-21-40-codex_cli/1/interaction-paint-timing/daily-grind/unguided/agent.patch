index 0000000..a49a935
--- /dev/null
+++ b/timing.js
@@ -0,0 +1,99 @@
+// Native contentful paint timings are presentation timestamps, not handler timings.
+// The fallback is deliberately labelled an estimate: rAF cannot prove presentation.
+export function createTimingMonitor(env = window) {
+  const records = new Map();
+  const hints = [];
+  const listeners = new Set();
+  const observers = [];
+  let sequence = 0;
+  let generation = 0;
+  let latestUpdate = 0;
+  let cutoff = 0;
+  const supported = env.PerformanceObserver?.supportedEntryTypes || [];
+  let nativePaint = false;
+  const notify = () => listeners.forEach(listener => listener(snapshot()));
+  const snapshot = () => [...records.values()].map(record => ({ ...record }));
+  const save = (key, data) => {
+    records.set(key, { ...records.get(key), ...data });
+    if (records.size > 100) records.delete(records.keys().next().value);
+    notify();
+  };
+  const observe = (type, callback) => {
+    if (!supported.includes(type)) return false;
+    try {
+      const observer = new env.PerformanceObserver(list => {
+        for (const entry of list.getEntries()) {
+          if (entry.startTime >= cutoff) callback(entry);
+        }
+      });
+      observer.observe({ type, buffered: true });
+      observers.push(observer);
+      return true;
+    } catch { return false; }
+  };
+  const hintFor = start => hints.findLast(hint => Math.abs(hint.start - start) < 8);
+  const nativeRecord = entry => {
+    if (entry.largestContentfulPaint?.element?.closest?.('#timing-panel')) return;
+    const hint = hintFor(entry.startTime);
+    const key = `native-${entry.interactionId}`;
+    if (!hint && !records.has(key)) return;
+    const shown = entry.presentationTime;
+    if (!Number.isFinite(shown) || shown <= 0) return;
+    const existing = records.get(key);
+    // Keep both the first observed update and subsequent contentful updates.
+    save(key, {
+      id: key,
+      label: existing?.label || hint.label,
+      kind: existing?.kind || 'Interaction',
+      path: existing?.path || hint.path,
+      start: entry.startTime,
+      first: Math.min(existing?.first ?? Infinity, shown - entry.startTime),
+      latest: Math.max(existing?.latest ?? 0, shown - entry.startTime),
+      source: 'Browser measured',
+    });
+  };
+  nativePaint = observe('interaction-contentful-paint', nativeRecord);
+  if (nativePaint) observe('soft-navigation', entry => {
+    const hint = hintFor(entry.startTime);
+    const key = `native-${entry.interactionId}`;
+    if (!hint && !records.has(key)) return;
+    const shown = entry.presentationTime;
+    const existing = records.get(key);
+    save(key, {
+      id: key, label: existing?.label || hint.label,
+      kind: 'Navigation', path: new URL(entry.name, env.location.href).pathname,
+      start: entry.startTime,
+      first: Math.min(existing?.first ?? Infinity, shown > 0 ? shown - entry.startTime : Infinity),
+      latest: Math.max(existing?.latest ?? 0, shown > 0 ? shown - entry.startTime : 0),
+      source: 'Browser measured',
+    });
+    const paint = entry.getLargestInteractionContentfulPaint?.();
+    if (paint) nativeRecord(paint);
+  });
+  return {
+    nativePaint,
+    snapshot,
+    subscribe(listener) { listeners.add(listener); listener(snapshot()); return () => listeners.delete(listener); },
+    hint(event, label) {
+      hints.push({ start: event.timeStamp, label, path: env.location.pathname });
+      if (hints.length > 100) hints.shift();
+    },
+    begin(label, kind, event) {
+      return { id: `estimate-${++sequence}`, label, kind, start: event?.timeStamp ?? env.performance.now(), generation };
+    },
+    contentUpdated(token, { estimate = false } = {}) {
+      if ((nativePaint && !estimate) || env.document.visibilityState !== 'visible') return;
+      const update = ++latestUpdate;
+      const path = env.location.pathname;
+      // One frame allows the new DOM to render; the second is an estimate of
+      // the first opportunity to present it. Never call this a native paint.
+      env.requestAnimationFrame(() => env.requestAnimationFrame(() => {
+        if (update !== latestUpdate || token.generation !== generation || env.document.visibilityState !== 'visible') return;
+        const duration = env.performance.now() - token.start;
+        save(token.id, { ...token, path, first: duration, latest: duration, source: 'Frame estimate' });
+      }));
+    },
+    clear() { generation++; cutoff = env.performance.now(); records.clear(); hints.length = 0; notify(); },
+    disconnect() { observers.forEach(observer => observer.disconnect()); listeners.clear(); generation++; },
+  };
+}
