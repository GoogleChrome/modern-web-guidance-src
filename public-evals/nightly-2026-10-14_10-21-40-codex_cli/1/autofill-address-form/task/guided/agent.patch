+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const addressReview = document.getElementById('address-review');
+
+    shippingForm.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const details = new FormData(shippingForm);
+      const address = ['full_name', 'street_address', 'city', 'region', 'postal_code', 'country']
+        .map((field) => details.get(field).trim())
+        .filter(Boolean)
+        .join('\n');
+      addressReview.textContent = `Your shipping address:\n${address}\n\nCheck these details before placing your order.`;
+    });
+
+    shippingForm.addEventListener('input', () => {
+      addressReview.textContent = '';
+    });
+  </script>
