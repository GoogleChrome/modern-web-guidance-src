+  <script>
+    const shippingForm = document.getElementById('shipping-form');
+    const shippingStatus = document.getElementById('shipping-status');
+
+    shippingForm.addEventListener('submit', function (event) {
+      event.preventDefault();
+      const requiredFields = shippingForm.querySelectorAll('[required]');
+      for (const field of requiredFields) {
+        field.value = field.value.trim();
+      }
+      if (!shippingForm.reportValidity()) return;
+
+      const address = new FormData(shippingForm);
+      const destination = ['streetAddress', 'addressLine2', 'city', 'region', 'postalCode', 'country']
+        .map(key => address.get(key).trim())
+        .filter(Boolean)
+        .join(', ');
+      shippingStatus.textContent = `Address confirmed for this visit: ${destination}.`;
+    });
+
+    shippingForm.addEventListener('input', function () {
+      shippingStatus.textContent = '';
+    });
+  </script>
