+  <script>
+    // Register early so fresh loads and back/forward restores receive their type.
+    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
+    if (!motionPreference.matches) {
+      function applyTransitionType(event, activation) {
+        if (!event.viewTransition) return;
+        if (motionPreference.matches) {
+          event.viewTransition.skipTransition();
+          return;
+        }
+        if (!event.viewTransition.types || !activation?.from?.url || !activation.entry?.url) return;
+
+        const from = new URL(activation.from.url);
+        const to = new URL(activation.entry.url);
+        if (from.origin !== to.origin || from.pathname !== to.pathname) return;
+
+        const fromPage = Number(from.searchParams.get('page') || 1);
+        const toPage = Number(to.searchParams.get('page') || 1);
+        if (toPage > fromPage) event.viewTransition.types.add('next');
+        if (toPage < fromPage) event.viewTransition.types.add('previous');
+      }
+
+      window.addEventListener('pageswap', (event) => {
+        applyTransitionType(event, event.activation);
+      });
+      window.addEventListener('pagereveal', (event) => {
+        applyTransitionType(event, window.navigation?.activation);
+      });
+    }
+  </script>
 </head>
 
