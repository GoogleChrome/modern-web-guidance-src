+  <script>
+    const seasonalPages = [
+      null, // The first page's cards are already present in the HTML.
+      [
+        ['Pumpkin Spice Latte', 'Espresso and steamed milk with warm pumpkin spices.', '/menu/pumpkin-spice'],
+        ['Cinnamon Honey Cappuccino', 'Velvety foam, fragrant cinnamon, and a touch of honey.', '/menu/cinnamon-honey'],
+        ['Salted Caramel Cold Brew', 'Slow-steeped coffee with caramel and a pinch of sea salt.', '/menu/caramel-cold-brew']
+      ],
+      [
+        ['Toasted Hazelnut Mocha', 'Rich chocolate and toasted hazelnut with freshly pulled espresso.', '/menu/hazelnut-mocha'],
+        ['Vanilla Chai Latte', 'Spiced black tea with silky milk and mellow vanilla.', '/menu/vanilla-chai'],
+        ['Orange Dark Chocolate Latte', 'Dark chocolate and bright orange paired with espresso.', '/menu/orange-chocolate']
+      ]
+    ];
+    const requestedPage = Number(new URL(location.href).searchParams.get('page') || 1);
+    const page = Number.isInteger(requestedPage)
+      ? Math.max(1, Math.min(seasonalPages.length, requestedPage)) : 1;
+
+    if (page > 1) {
+      const cards = seasonalPages[page - 1].map(([name, description, href]) => {
+        const card = document.createElement('div');
+        card.className = 'card';
+        const heading = document.createElement('h3');
+        heading.textContent = name;
+        const summary = document.createElement('p');
+        summary.textContent = description;
+        const link = document.createElement('a');
+        link.className = 'btn';
+        link.href = href;
+        link.textContent = 'View Details';
+        card.append(heading, summary, link);
+        return card;
+      });
+      document.querySelector('.grid').replaceChildren(...cards);
+    }
+
+    document.getElementById('page-number').textContent = `Page ${page} of ${seasonalPages.length}`;
+    for (const [id, destination] of [['previous', page - 1], ['next', page + 1]]) {
+      const link = document.getElementById(id);
+      if (destination < 1 || destination > seasonalPages.length) {
+        link.removeAttribute('href');
+        link.setAttribute('aria-disabled', 'true');
+        link.tabIndex = -1;
+      } else {
+        const url = new URL(location.href);
+        url.searchParams.set('page', destination);
+        url.hash = '';
+        link.href = url.href;
+        link.removeAttribute('aria-disabled');
+        link.removeAttribute('tabindex');
+      }
+    }
+  </script>
+
