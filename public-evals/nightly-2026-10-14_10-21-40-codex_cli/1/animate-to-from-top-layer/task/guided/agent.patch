+  <dialog id="logout-dialog" class="logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
+    <button type="button" id="close-dialog-btn" class="overlay-close" aria-label="Close logout confirmation">&times;</button>
+    <h2 id="logout-title">Log out?</h2>
+    <p id="logout-description">Are you sure you want to log out of your account?</p>
+    <div class="dialog-actions">
+      <button type="button" id="cancel-logout-btn" class="btn btn-secondary" autofocus>Cancel</button>
+      <button type="button" id="confirm-logout-btn" class="btn">Yes, log out</button>
+    </div>
+  </dialog>
+
+  <aside id="ordering-notice" class="ordering-notice" aria-label="Online ordering information" hidden>
+    <p role="status">online ordering is currently offline</p>
+    <button type="button" id="close-notice-btn" class="overlay-close" aria-label="Dismiss ordering information">&times;</button>
+  </aside>
+
+  <script>
+    const logoutLink = document.getElementById('open-dialog-btn');
+    const logoutDialog = document.getElementById('logout-dialog');
+    const orderButton = document.getElementById('foobar');
+    const orderingNotice = document.getElementById('ordering-notice');
+
+    function reveal(element) {
+      // Commit the initial state for browsers without @starting-style.
+      void element.offsetWidth;
+      element.classList.add('is-visible');
+    }
+
+    async function dismiss(element, finish) {
+      if (element.dataset.closing) return;
+      element.dataset.closing = 'true';
+      element.classList.remove('is-visible');
+      // Keep the dialog and backdrop mounted until their CSS transitions finish.
+      const animations = element.getAnimations({ subtree: true });
+      await Promise.allSettled(animations.map(animation => animation.finished));
+      finish();
+      delete element.dataset.closing;
+    }
+
+    function closeLogout() {
+      return dismiss(logoutDialog, () => logoutDialog.close());
+    }
+
+    function closeNotice() {
+      return dismiss(orderingNotice, () => {
+        const restoreFocus = orderingNotice.contains(document.activeElement);
+        orderingNotice.hidden = true;
+        orderButton.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) orderButton.focus();
+      });
+    }
+
+    logoutLink.addEventListener('click', event => {
+      event.preventDefault();
+      if (logoutDialog.open) return;
+      logoutDialog.showModal();
+      reveal(logoutDialog);
+    });
+
+    document.getElementById('close-dialog-btn').addEventListener('click', closeLogout);
+    document.getElementById('cancel-logout-btn').addEventListener('click', closeLogout);
+    logoutDialog.addEventListener('cancel', event => {
+      event.preventDefault();
+      closeLogout();
+    });
+
+    document.getElementById('confirm-logout-btn').addEventListener('click', async () => {
+      if (logoutDialog.dataset.closing) return;
+      await closeLogout();
+      window.location.assign(logoutLink.href);
+    });
+
+    orderButton.addEventListener('click', () => {
+      if (orderingNotice.dataset.closing) return;
+      if (!orderingNotice.hidden) {
+        closeNotice();
+        return;
+      }
+      orderingNotice.hidden = false;
+      orderButton.setAttribute('aria-expanded', 'true');
+      reveal(orderingNotice);
+    });
+
+    document.getElementById('close-notice-btn').addEventListener('click', closeNotice);
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && !logoutDialog.open && !orderingNotice.hidden) {
+        closeNotice();
+      }
+    });
+  </script>
+
