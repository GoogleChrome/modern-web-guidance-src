+  <script>
+    const player = document.getElementById('roasting-player');
+    const mainSlot = document.getElementById('main-video-slot');
+    const heroSlot = document.getElementById('hero-video-slot');
+    const hero = document.querySelector('.hero');
+    const toggleButton = document.getElementById('toggle-theater');
+    const exitButton = document.getElementById('exit-theater');
+    const canMoveWithoutReload = typeof heroSlot.moveBefore === 'function';
+    let theaterMode = false;
+
+    function positionFallbackPlayer() {
+      if (canMoveWithoutReload || !theaterMode) return;
+      const target = heroSlot.getBoundingClientRect();
+      const origin = document.body.getBoundingClientRect();
+      player.style.top = `${target.top - origin.top}px`;
+      player.style.left = `${target.left - origin.left}px`;
+      player.style.width = `${target.width}px`;
+      player.style.height = `${target.height}px`;
+    }
+
+    function setTheaterMode(enabled) {
+      theaterMode = enabled;
+      hero.classList.toggle('theater-active', enabled);
+      heroSlot.hidden = !enabled;
+      exitButton.hidden = !enabled;
+      toggleButton.setAttribute('aria-pressed', String(enabled));
+      toggleButton.textContent = enabled ? 'Exit theater mode' : 'Theater mode';
+
+      if (canMoveWithoutReload) {
+        // An atomic move retains the iframe's document and ongoing playback.
+        (enabled ? heroSlot : mainSlot).moveBefore(player, null);
+        mainSlot.hidden = enabled;
+      } else {
+        // appendChild/insertBefore would reload an iframe. Keep its parent and
+        // position it over the hero's reserved space instead; never change src.
+        mainSlot.classList.toggle('video-away', enabled);
+        player.classList.toggle('positioned-player', enabled);
+        if (enabled) {
+          positionFallbackPlayer();
+        } else {
+          ['top', 'left', 'width', 'height'].forEach(property => player.style.removeProperty(property));
+        }
+      }
+    }
+
+    toggleButton.hidden = false;
+    toggleButton.addEventListener('click', () => setTheaterMode(!theaterMode));
+    exitButton.addEventListener('click', () => {
+      setTheaterMode(false);
+      toggleButton.focus({ preventScroll: true });
+    });
+
+    if (!canMoveWithoutReload) {
+      window.addEventListener('resize', positionFallbackPlayer);
+      if (typeof ResizeObserver === 'function') {
+        const observer = new ResizeObserver(positionFallbackPlayer);
+        observer.observe(hero);
+        observer.observe(document.querySelector('nav'));
+      }
+    }
+  </script>
