+  <script>
+    (function () {
+      var frame = document.getElementById('roasting-frame');
+      var home = document.getElementById('main-video-slot');
+      var heroSlot = document.getElementById('hero-video-slot');
+      var hero = document.querySelector('.hero');
+      var toggle = document.getElementById('theater-toggle');
+      var exit = document.getElementById('exit-theater');
+      var theater = false;
+      var canMove = typeof home.moveBefore === 'function';
+      var pendingLayout = false;
+
+      function placeLegacyFrame() {
+        if (canMove) return;
+        var target = theater ? heroSlot : home;
+        var rect = target.getBoundingClientRect();
+        var bodyRect = document.body.getBoundingClientRect();
+        frame.style.top = (rect.top - bodyRect.top) + 'px';
+        frame.style.left = (rect.left - bodyRect.left) + 'px';
+        frame.style.width = rect.width + 'px';
+        frame.style.height = rect.height + 'px';
+      }
+
+      function scheduleLayout() {
+        if (pendingLayout || canMove) return;
+        pendingLayout = true;
+        requestAnimationFrame(function () {
+          pendingLayout = false;
+          placeLegacyFrame();
+        });
+      }
+
+      function setTheater(enabled) {
+        theater = enabled;
+        heroSlot.hidden = !enabled;
+        exit.hidden = !enabled;
+        hero.classList.toggle('theater-active', enabled);
+        home.classList.toggle('vacant', enabled);
+
+        if (canMove) {
+          // Both slots remain connected; this atomic move preserves the
+          // iframe's browsing context, playback, and fullscreen state.
+          (enabled ? heroSlot : home).moveBefore(frame, null);
+        } else {
+          // Never detach or rewrite src in the fallback: only move visually.
+          placeLegacyFrame();
+        }
+
+        toggle.setAttribute('aria-pressed', String(enabled));
+        exit.setAttribute('aria-pressed', String(enabled));
+        toggle.textContent = enabled ? 'Exit theater mode' : 'Theater mode';
+      }
+
+      toggle.addEventListener('click', function () { setTheater(!theater); });
+      exit.addEventListener('click', function () {
+        setTheater(false);
+        toggle.focus();
+      });
+
+      if (!canMove) {
+        home.classList.add('legacy-placement');
+        placeLegacyFrame();
+        window.addEventListener('resize', scheduleLayout);
+        window.addEventListener('load', scheduleLayout);
+        if (typeof ResizeObserver === 'function') {
+          var observer = new ResizeObserver(scheduleLayout);
+          observer.observe(document.body);
+          observer.observe(home);
+          observer.observe(heroSlot);
+        }
+      }
+    }());
+  </script>
