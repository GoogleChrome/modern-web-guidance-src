+  <script>
+    const menuButton = document.getElementById('menu-button');
+    const drawer = document.getElementById('navigation-drawer');
+    const closeButton = document.getElementById('close-menu');
+
+    menuButton.addEventListener('click', () => {
+      drawer.showModal();
+      // Start at the panel; swiping right scrolls to the empty dismissal snap point.
+      drawer.scrollTo({ left: drawer.clientWidth, behavior: 'instant' });
+      menuButton.setAttribute('aria-expanded', 'true');
+    });
+
+    closeButton.addEventListener('click', () => drawer.close());
+    drawer.addEventListener('close', () => {
+      menuButton.setAttribute('aria-expanded', 'false');
+    });
+    drawer.querySelector('nav').addEventListener('click', (event) => {
+      if (event.target.closest('a')) drawer.close();
+    });
+
+    const closeIfSwipedAway = () => {
+      if (drawer.open && drawer.scrollLeft <= 1) drawer.close();
+    };
+
+    if ('onscrollend' in drawer) {
+      drawer.addEventListener('scrollend', closeIfSwipedAway);
+    } else {
+      // Older engines lack scrollend; only close once the closed snap point settles.
+      let scrollTimer;
+      drawer.addEventListener('scroll', () => {
+        clearTimeout(scrollTimer);
+        scrollTimer = setTimeout(closeIfSwipedAway, 150);
+      }, { passive: true });
+    }
+
+    // The transparent snap point is inside the dialog, so handle it explicitly.
+    // Also support backdrop dismissal in browsers without closedby="any".
+    const isDismissTarget = (event) => {
+      if (event.target.closest('.drawer-dismiss')) return true;
+      if ('closedBy' in drawer || event.target !== drawer) return false;
+      const bounds = drawer.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    };
+    let dismissalStarted = false;
+    drawer.addEventListener('pointerdown', (event) => {
+      dismissalStarted = isDismissTarget(event);
+    });
+    drawer.addEventListener('pointercancel', () => { dismissalStarted = false; });
+    drawer.addEventListener('click', (event) => {
+      if (dismissalStarted && isDismissTarget(event)) drawer.close();
+      dismissalStarted = false;
+    });
+  </script>
