+  <script>
+    const drawer = document.getElementById('navigation-drawer');
+    const openButton = document.getElementById('drawer-open');
+    const page = document.getElementById('page-content');
+    const scroller = drawer.querySelector('.drawer-scroller');
+    const sheet = drawer.querySelector('.drawer-sheet');
+    let state = 'closed';
+    let hasEntered = false;
+    let previousOverflow;
+
+    const nativeBackdropFade = CSS.supports('animation-timeline: scroll()') &&
+      CSS.supports('timeline-scope: --drawer-fade');
+
+    function updateBackdrop() {
+      if (!nativeBackdropFade) {
+        const progress = 1 - scroller.scrollLeft / sheet.offsetWidth;
+        drawer.style.setProperty('--drawer-backdrop', Math.max(0, Math.min(1, progress)));
+      }
+    }
+
+    if (!nativeBackdropFade) {
+      scroller.addEventListener('scroll', updateBackdrop, { passive: true });
+    }
+
+    function finishClosing() {
+      if (state === 'closed') return;
+      state = 'closed';
+      drawer.hidePopover();
+      page.inert = false;
+      document.documentElement.style.overflow = previousOverflow;
+      openButton.setAttribute('aria-expanded', 'false');
+      openButton.focus({ preventScroll: true });
+    }
+
+    async function openDrawer() {
+      if (state !== 'closed') return;
+      state = 'opening';
+      hasEntered = false;
+      previousOverflow = document.documentElement.style.overflow;
+      drawer.showPopover();
+      page.inert = true;
+      document.documentElement.style.overflow = 'hidden';
+      openButton.setAttribute('aria-expanded', 'true');
+      sheet.focus({ preventScroll: true });
+
+      // Reset on every open, including browsers without scroll-initial-target.
+      scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'instant' });
+      updateBackdrop();
+      // Let the closed position commit before starting the native slide-in.
+      await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+      if (state !== 'opening') return;
+      scroller.scrollTo({ left: 0, behavior: 'auto' });
+    }
+
+    function closeDrawer() {
+      if (state === 'closed' || state === 'closing') return;
+      state = 'closing';
+      // Escape or backdrop taps can arrive before the opening frames commit.
+      if (scroller.scrollLeft >= sheet.offsetWidth - 1) {
+        finishClosing();
+      } else {
+        scroller.scrollTo({ left: sheet.offsetWidth, behavior: 'auto' });
+      }
+    }
+
+    // All closing paths, including native swipes, converge after the sheet exits.
+    const observer = new IntersectionObserver(entries => {
+      if (state === 'closed') return;
+      const entry = entries.at(-1);
+      if (entry.intersectionRect.width > 0) hasEntered = true;
+      if (entry.intersectionRatio === 1 && state === 'opening') state = 'open';
+      if (entry.intersectionRatio < 0.001 && hasEntered) finishClosing();
+    }, { root: scroller, threshold: [0.001, 1] });
+    observer.observe(sheet);
+
+    openButton.addEventListener('click', openDrawer);
+    drawer.querySelector('.drawer-close').addEventListener('click', closeDrawer);
+    drawer.addEventListener('click', event => {
+      if (!sheet.contains(event.target) || event.target.closest('a')) closeDrawer();
+    });
+    document.addEventListener('keydown', event => {
+      if (event.key === 'Escape' && state !== 'closed') {
+        event.preventDefault();
+        closeDrawer();
+      }
+    });
+  </script>
