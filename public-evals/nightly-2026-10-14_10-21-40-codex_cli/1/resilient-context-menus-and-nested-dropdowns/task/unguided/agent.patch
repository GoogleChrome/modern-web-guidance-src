+  <script>
+    const trigger = document.getElementById('trigger-btn');
+    const panel = document.getElementById('action-panel');
+
+    function positionPanel() {
+      if (!panel.matches(':popover-open')) return;
+
+      const viewport = window.visualViewport;
+      const padding = 8;
+      const leftEdge = (viewport?.offsetLeft ?? 0) + padding;
+      const topEdge = (viewport?.offsetTop ?? 0) + padding;
+      const rightEdge = leftEdge + (viewport?.width ?? document.documentElement.clientWidth) - padding * 2;
+      const bottomEdge = topEdge + (viewport?.height ?? document.documentElement.clientHeight) - padding * 2;
+      const anchor = trigger.getBoundingClientRect();
+
+      // Measure at the available width before deciding whether to flip.
+      panel.style.maxWidth = `${Math.max(0, rightEdge - leftEdge)}px`;
+      panel.style.maxHeight = `${Math.max(0, bottomEdge - topEdge)}px`;
+      const size = panel.getBoundingClientRect();
+      const below = Math.max(0, bottomEdge - anchor.bottom);
+      const above = Math.max(0, anchor.top - topEdge);
+      const flipUp = size.height > below && above > below;
+      panel.style.maxHeight = `${flipUp ? above : below}px`;
+
+      // Prefer below/left-aligned; flip to above/right-aligned on collision.
+      const height = panel.getBoundingClientRect().height;
+      let left = anchor.left;
+      if (left + size.width > rightEdge) left = anchor.right - size.width;
+      const top = flipUp ? anchor.top - height : anchor.bottom;
+      panel.style.left = `${Math.max(leftEdge, Math.min(left, rightEdge - size.width))}px`;
+      panel.style.top = `${Math.max(topEdge, Math.min(top, bottomEdge - height))}px`;
+    }
+
+    let positionFrame;
+    function schedulePosition() {
+      cancelAnimationFrame(positionFrame);
+      positionFrame = requestAnimationFrame(positionPanel);
+    }
+
+    panel.addEventListener('beforetoggle', (event) => {
+      if (event.newState === 'open') schedulePosition();
+    });
+    panel.addEventListener('toggle', () => {
+      trigger.setAttribute('aria-expanded', String(panel.matches(':popover-open')));
+      positionPanel();
+    });
+    window.addEventListener('resize', schedulePosition);
+    document.addEventListener('scroll', schedulePosition, true);
+    window.visualViewport?.addEventListener('resize', schedulePosition);
+    window.visualViewport?.addEventListener('scroll', schedulePosition);
+    const anchorObserver = new ResizeObserver(schedulePosition);
+    anchorObserver.observe(trigger);
+    anchorObserver.observe(document.querySelector('nav'));
+
+    panel.addEventListener('click', (event) => {
+      const action = event.target.closest('button[data-href]');
+      if (!action) return;
+      panel.hidePopover();
+      window.location.assign(action.dataset.href);
+    });
+  </script>
