+  <script type="module">
+    // Older browsers need a conditional fallback for popover invocation and dismissal.
+    if (!("popover" in HTMLElement.prototype)) {
+      await import("https://unpkg.com/@oddbird/popover-polyfill@latest/dist/popover.min.js");
+    }
+
+    const trigger = document.getElementById("trigger-btn");
+    const panel = document.getElementById("action-panel");
+    const hasAnchors = CSS.supports("anchor-name: --options-trigger") &&
+      CSS.supports("position-area: block-end span-inline-end") &&
+      CSS.supports("position-try-fallbacks: flip-block");
+    const isOpen = () => panel.matches(":is(:popover-open, .\\:popover-open)");
+
+    function positionPanel() {
+      if (!isOpen()) return;
+      const gap = 8;
+      const viewport = window.visualViewport;
+      const minX = (viewport?.offsetLeft ?? 0) + gap;
+      const minY = (viewport?.offsetTop ?? 0) + gap;
+      const maxX = minX + (viewport?.width ?? window.innerWidth) - gap * 2;
+      const maxY = minY + (viewport?.height ?? window.innerHeight) - gap * 2;
+      const anchor = trigger.getBoundingClientRect();
+      panel.style.maxWidth = `${Math.max(0, maxX - minX)}px`;
+      panel.style.maxHeight = `${Math.max(0, maxY - minY)}px`;
+      const width = panel.offsetWidth;
+      const height = panel.offsetHeight;
+      const below = Math.max(0, maxY - anchor.bottom - gap);
+      const above = Math.max(0, anchor.top - gap - minY);
+      const fitsHorizontally = anchor.left + width <= maxX || anchor.right - width >= minX;
+
+      // Native CSS handles the usual four placements. Clamp when none can fit,
+      // or when anchor positioning is unavailable (including zoomed viewports).
+      const manual = !hasAnchors || !fitsHorizontally || height > Math.max(below, above) ||
+        anchor.left < minX || anchor.right > maxX || anchor.top < minY || anchor.bottom > maxY ||
+        (viewport && (viewport.scale !== 1 || viewport.offsetTop || viewport.offsetLeft));
+      panel.classList.toggle("manual-position", Boolean(manual));
+      if (!manual) {
+        panel.style.removeProperty("left");
+        panel.style.removeProperty("top");
+        return;
+      }
+
+      const placeAbove = height > below && above > below;
+      panel.style.maxHeight = `${Math.max(0, placeAbove ? above : below)}px`;
+      const left = anchor.left + width <= maxX ? anchor.left : anchor.right - width;
+      panel.style.left = `${Math.max(minX, Math.min(left, maxX - width))}px`;
+      const top = placeAbove ? anchor.top - gap - panel.offsetHeight : anchor.bottom + gap;
+      panel.style.top = `${Math.max(minY, Math.min(top, maxY - panel.offsetHeight))}px`;
+    }
+
+    panel.addEventListener("toggle", positionPanel);
+    window.addEventListener("resize", positionPanel);
+    document.addEventListener("scroll", positionPanel, { capture: true, passive: true });
+    window.visualViewport?.addEventListener("resize", positionPanel);
+    window.visualViewport?.addEventListener("scroll", positionPanel);
+    new ResizeObserver(positionPanel).observe(trigger);
+    panel.addEventListener("click", (event) => {
+      const action = event.target.closest("button[data-href]");
+      if (action) {
+        panel.hidePopover();
+        window.location.assign(action.dataset.href);
+      }
+    });
+  </script>
