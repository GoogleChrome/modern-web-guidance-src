diff --git a/test/webmcp.test.cjs b/test/webmcp.test.cjs
new file mode 100644
index 0000000..d8f4805
--- /dev/null
+++ b/test/webmcp.test.cjs
@@ -0,0 +1,143 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { runInNewContext } = require('node:vm');
+
+const source = readFileSync(new URL('../webmcp.js', `file://${__filename}`), 'utf8');
+const html = readFileSync(new URL('../index.html', `file://${__filename}`), 'utf8');
+const origin = 'https://daily-grind.example';
+const settle = () => new Promise((resolve) => setImmediate(resolve));
+
+function setup({ supported = true, failAt } = {}) {
+  const tools = new Map();
+  const signals = [];
+  const events = {};
+  const clicks = [];
+  const warnings = [];
+  // Read the actual page's links and cards so these checks catch HTML drift.
+  const links = [...html.matchAll(/<a href="([^"]+)"[^>]*data-tool-destination="([^"]+)"[^>]*>([^<]+)<\/a>/g)]
+    .map(([, path, destination, label]) => ({
+      href: new URL(path, origin).href,
+      dataset: { toolDestination: destination },
+      textContent: label,
+      click() { clicks.push(destination); },
+    }));
+  const cards = [...html.matchAll(/<div class="card">\s*<h3>([^<]+)<\/h3>\s*<p>([^<]+)<\/p>\s*<a href="([^"]+)"/g)]
+    .map(([, name, description, path]) => ({
+      querySelector(selector) {
+        return selector === 'a' ? links.find((link) => link.href === new URL(path, origin).href)
+          : { textContent: selector === 'h3' ? name : description };
+      },
+    }));
+  let calls = 0;
+  const document = {
+    querySelector(selector) {
+      const patterns = {
+        '.logo': /<div class="logo">([^<]+)</,
+        '.hero h1': /<h1>([^<]+)</,
+        '.hero p': /<header class="hero">[\s\S]*?<p>([^<]+)</,
+      };
+      return { textContent: html.match(patterns[selector])[1] };
+    },
+    querySelectorAll(selector) { return selector === 'a[data-tool-destination]' ? links : cards; },
+  };
+  if (supported) document.modelContext = {
+    async registerTool(tool, { signal }) {
+      signals.push(signal);
+      if (++calls === failAt) throw new Error('Registration blocked');
+      assert.equal(tools.has(tool.name), false, 'No duplicate registrations');
+      tools.set(tool.name, tool);
+      signal.addEventListener('abort', () => tools.delete(tool.name), { once: true });
+    },
+  };
+  runInNewContext(source, {
+    document, URL, AbortController,
+    window: { location: { origin }, addEventListener(name, callback) { events[name] = callback; } },
+    console: { warn(...args) { warnings.push(args); } },
+  });
+  return { tools, signals, events, clicks, links, warnings };
+}
+
+test('unsupported browsers continue without registration or lifecycle handlers', () => {
+  const app = setup({ supported: false });
+  assert.equal(app.tools.size, 0);
+  assert.deepEqual(app.events, {});
+});
+
+test('read tool returns the actual page information and current drink descriptions', async () => {
+  const app = setup();
+  await settle();
+  assert.equal(app.tools.size, 2);
+  const tool = app.tools.get('get_coffee_shop_info');
+  assert.equal(tool.annotations.readOnlyHint, true);
+  const info = tool.execute({});
+  assert.equal(info.name, 'THE DAILY GRIND');
+  assert.equal(info.seasonalFavorites.length, 3);
+  assert.equal(info.seasonalFavorites[0].name, 'Maple Oat Latte');
+  assert.match(info.seasonalFavorites[0].description, /Vermont maple syrup/);
+  assert.equal(info.seasonalFavorites[0].detailsUrl, `${origin}/menu/seasonal`);
+  app.links[0].textContent = 'Updated menu';
+  assert.equal(tool.execute({}).destinations[0].label, 'Updated menu');
+  assert.ok(tool.execute({ unexpected: true }).error);
+});
+
+test('navigation invokes every supported link and rejects invalid inputs without clicking', async () => {
+  const app = setup();
+  await settle();
+  const tool = app.tools.get('navigate_coffee_shop');
+  const destinations = tool.inputSchema.properties.destination.enum;
+  assert.equal(destinations.length, 12);
+  for (const destination of destinations) {
+    assert.equal(tool.execute({ destination }).destination, destination);
+    assert.equal(app.clicks.at(-1), destination);
+  }
+  for (const input of [undefined, null, [], {}, { destination: 1 },
+    { destination: 'logout' }, { destination: 'https://other.example' },
+    { destination: '__proto__' }, { destination: 'menu', unexpected: true }]) {
+    assert.ok(tool.execute(input).error);
+  }
+  assert.equal(app.clicks.length, 12);
+});
+
+test('navigation rejects missing links and links changed to another origin', async () => {
+  const app = setup();
+  await settle();
+  const tool = app.tools.get('navigate_coffee_shop');
+  app.links[0].href = 'https://other.example/menu';
+  assert.ok(tool.execute({ destination: 'menu' }).error);
+  app.links.splice(1, 1);
+  assert.ok(tool.execute({ destination: 'locations' }).error);
+  assert.equal(app.clicks.length, 0);
+});
+
+test('page lifecycle unregisters tools and restores them after back/forward navigation', async () => {
+  const app = setup();
+  await settle();
+  app.events.pageshow();
+  await settle();
+  assert.equal(app.signals.length, 2);
+  app.events.pagehide();
+  assert.equal(app.tools.size, 0);
+  assert.ok(app.signals.every((signal) => signal.aborted));
+  app.events.pageshow();
+  await settle();
+  assert.equal(app.tools.size, 2);
+});
+
+test('registration failure rolls back partial registration and permits retry', async () => {
+  const app = setup({ failAt: 2 });
+  await settle();
+  assert.equal(app.tools.size, 0);
+  assert.equal(app.warnings.length, 1);
+  app.events.pageshow();
+  await settle();
+  assert.equal(app.tools.size, 2);
+});
+
+test('leaving while registration is pending stops further registration', async () => {
+  const app = setup();
+  app.events.pagehide();
+  await settle();
+  assert.equal(app.tools.size, 0);
+  assert.equal(app.signals.length, 1);
+});
diff --git a/webmcp.js b/webmcp.js
new file mode 100644
index 0000000..4d30df5
--- /dev/null
+++ b/webmcp.js
@@ -0,0 +1,92 @@
+(() => {
+  // Progressive enhancement: ordinary links work without WebMCP support.
+  const modelContext = document.modelContext;
+  if (typeof modelContext?.registerTool !== 'function') return;
+
+  const destinationLinks = () => Array.from(
+    document.querySelectorAll('a[data-tool-destination]')
+  ).filter((link) => new URL(link.href).origin === window.location.origin);
+  const destinations = destinationLinks().map((link) => link.dataset.toolDestination);
+  const validInput = (input, keys) => input !== null && typeof input === 'object'
+    && !Array.isArray(input) && Object.keys(input).every((key) => keys.includes(key));
+
+  const tools = [
+    {
+      name: 'get_coffee_shop_info',
+      description: 'Read The Daily Grind homepage, including seasonal drink names, descriptions, detail URLs, and available navigation destinations.',
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      execute(input = {}) {
+        if (!validInput(input, [])) return { error: 'Provide an empty object.' };
+        return {
+          name: document.querySelector('.logo').textContent.trim(),
+          headline: document.querySelector('.hero h1').textContent.trim(),
+          description: document.querySelector('.hero p').textContent.trim(),
+          seasonalFavorites: Array.from(document.querySelectorAll('#seasonal-favorites .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href,
+            destination: card.querySelector('a').dataset.toolDestination,
+          })),
+          destinations: destinationLinks().map((link) => ({
+            destination: link.dataset.toolDestination,
+            label: link.textContent.trim(),
+            url: link.href,
+          })),
+        };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'navigate_coffee_shop',
+      description: 'Follow an existing Daily Grind link to the menu, a featured drink, locations, rewards, account, online ordering, or a footer page. Opens the linked page in this tab; online ordering opens the order page.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          destination: {
+            type: 'string',
+            enum: destinations,
+            description: 'Destination identifier from get_coffee_shop_info, such as menu, maple-oat-latte, or order-online.',
+          },
+        },
+        required: ['destination'],
+        additionalProperties: false,
+      },
+      execute(input) {
+        if (!validInput(input, ['destination']) || typeof input.destination !== 'string'
+          || !destinations.includes(input.destination)) {
+          return { error: 'Choose a supported destination.', availableDestinations: destinations };
+        }
+        const link = destinationLinks().find((link) => link.dataset.toolDestination === input.destination);
+        if (!link) return { error: 'This destination is no longer available. Read get_coffee_shop_info for current links.' };
+        // Reuse the user's navigation action, including any application click handlers.
+        link.click();
+        return { destination: input.destination, url: link.href };
+      },
+      annotations: { readOnlyHint: false },
+    },
+  ];
+
+  let registration;
+  async function registerTools() {
+    if (registration) return;
+    const controller = new AbortController();
+    registration = controller;
+    try {
+      for (const tool of tools) {
+        if (controller.signal.aborted) return;
+        await modelContext.registerTool(tool, { signal: controller.signal });
+      }
+    } catch (error) {
+      controller.abort();
+      if (registration === controller) registration = undefined;
+      console.warn('Daily Grind WebMCP registration failed:', error);
+    }
+  }
+
+  window.addEventListener('pagehide', () => {
+    registration?.abort();
+    registration = undefined;
+  });
+  window.addEventListener('pageshow', () => { void registerTools(); });
+  void registerTools();
+})();
