new file mode 100644
index 0000000..0f1f5fe
--- /dev/null
+++ b/tests/webmcp.test.mjs
@@ -0,0 +1,83 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createNewsTools, registerNewsTools } from '../src/lib/webmcp.ts';
+
+const articles = [
+  { slug: 'science', title: 'Science news', summary: 'New discoveries' },
+  { slug: 'sports', title: 'Sports news', summary: 'Science of swimming' },
+];
+function fixture() {
+  let saved = [];
+  const tools = createNewsTools({
+    baseUrl: '/devtools-times/',
+    getArticles: async signal => { signal?.throwIfAborted(); return articles; },
+    searchArticles: (items, query) => items.filter(a => `${a.title} ${a.summary}`.toLowerCase().includes(query.toLowerCase())),
+    getReadingList: async () => saved,
+    updateReadingList: async (slug, state) => {
+      saved = state ? [...new Set([...saved, slug])] : saved.filter(s => s !== slug);
+      return saved;
+    },
+  });
+  return Object.fromEntries(tools.map(tool => [tool.name, tool]));
+}
+
+test('search returns bounded results and base-aware article links', async () => {
+  const tools = fixture();
+  const result = await tools.search_articles.execute({ query: ' SCIENCE ', limit: 1 });
+  assert.equal(result.total, 2);
+  assert.equal(result.articles.length, 1);
+  assert.equal(result.articles[0].url, '/devtools-times/articles/science');
+  assert.deepEqual(await tools.search_articles.execute({ query: 'absent' }), { articles: [], total: 0 });
+});
+
+test('invalid arguments and unknown slugs reject without mutation', async () => {
+  const tools = fixture();
+  for (const input of [{query:''}, {query:2}, {query:'x'.repeat(201)}, {query:'x',limit:0}, {query:'x',limit:1.5}, {query:'x',limit:51}]) {
+    await assert.rejects(tools.search_articles.execute(input));
+  }
+  await assert.rejects(tools.save_article.execute({ slug: '../unknown' }), /Article not found/);
+  assert.deepEqual(await tools.get_reading_list.execute({}), { articles: [] });
+});
+
+test('save and remove are idempotent and reading list returns article metadata', async () => {
+  const tools = fixture();
+  await tools.save_article.execute({ slug: 'science' });
+  assert.deepEqual((await tools.save_article.execute({ slug: 'science' })).readingList, ['science']);
+  assert.equal((await tools.get_reading_list.execute({})).articles[0].title, 'Science news');
+  await tools.remove_saved_article.execute({ slug: 'science' });
+  assert.deepEqual((await tools.remove_saved_article.execute({ slug: 'science' })).readingList, []);
+});
+
+test('execution cancellation reaches underlying service', async () => {
+  const controller = new AbortController();
+  controller.abort();
+  await assert.rejects(fixture().search_articles.execute({ query: 'science' }, { signal: controller.signal }), { name: 'AbortError' });
+});
+
+test('unsupported browsers do nothing and repeated initialization registers once', async () => {
+  const tools = Object.values(fixture());
+  await registerNewsTools(undefined, tools);
+  const registered = [];
