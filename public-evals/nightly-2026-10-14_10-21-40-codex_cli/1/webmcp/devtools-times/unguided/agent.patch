diff --git a/src/lib/news-client.ts b/src/lib/news-client.ts
new file mode 100644
index 0000000..1f3291f
--- /dev/null
+++ b/src/lib/news-client.ts
@@ -0,0 +1,44 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image?: string;
+}
+
+export const READING_LIST_CHANGED = 'reading-list:changed';
+
+async function request<T>(path: string, options?: RequestInit): Promise<T> {
+  const response = await fetch(`${import.meta.env.BASE_URL}${path}`, options);
+  if (!response.ok) throw new Error(`Request failed (${response.status})`);
+  return response.json();
+}
+
+export function getArticles(signal?: AbortSignal): Promise<Article[]> {
+  return request('api/articles.json', { signal });
+}
+
+export function searchArticles(articles: Article[], query: string): Article[] {
+  const term = query.trim().toLowerCase();
+  if (!term) return [];
+  return articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  );
+}
+
+export async function getReadingList(signal?: AbortSignal): Promise<string[]> {
+  const data = await request<{ readingList: string[] }>('api/reading-list.json', { signal });
+  return data.readingList;
+}
+
+// Omitting saved preserves the bookmark button's toggle behavior. Explicit
+// state makes agent retries safe: saving twice never removes the bookmark.
+export async function updateReadingList(slug: string, saved?: boolean, signal?: AbortSignal): Promise<string[]> {
+  const data = await request<{ readingList: string[] }>('api/reading-list.json', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ slug, saved }),
+    signal,
+  });
+  window.dispatchEvent(new CustomEvent(READING_LIST_CHANGED, { detail: data.readingList }));
+  return data.readingList;
+}
diff --git a/src/lib/webmcp.ts b/src/lib/webmcp.ts
new file mode 100644
index 0000000..6509779
--- /dev/null
+++ b/src/lib/webmcp.ts
@@ -0,0 +1,124 @@
+interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+}
+
+export interface Tool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  annotations: { readOnlyHint: boolean; untrustedContentHint?: boolean };
+  execute: (input: Record<string, unknown>, options?: { signal?: AbortSignal }) => Promise<unknown>;
+}
+
+export interface ModelContext {
+  registerTool: (tool: Tool) => void | Promise<void>;
+  unregisterTool: (name: string) => void | Promise<void>;
+}
+
+interface Services {
+  getArticles: (signal?: AbortSignal) => Promise<Article[]>;
+  searchArticles: (articles: Article[], query: string) => Article[];
+  getReadingList: (signal?: AbortSignal) => Promise<string[]>;
+  updateReadingList: (slug: string, saved: boolean, signal?: AbortSignal) => Promise<string[]>;
+  baseUrl: string;
+}
+
+function stringInput(input: Record<string, unknown>, key: string, maxLength: number): string {
+  const value = input[key];
+  if (typeof value !== 'string' || !value.trim() || value.length > maxLength) {
+    throw new Error(`${key} must be a non-empty string of at most ${maxLength} characters.`);
+  }
+  return value.trim();
+}
+
+export function createNewsTools(services: Services): Tool[] {
+  const articleResult = (article: Article) => ({
+    slug: article.slug, title: article.title, summary: article.summary,
+    url: `${services.baseUrl}articles/${encodeURIComponent(article.slug)}`,
+  });
+  const slugSchema = {
+    type: 'object', properties: { slug: { type: 'string', minLength: 1, maxLength: 200,
+      description: 'An exact article slug returned by search_articles or get_reading_list.' } },
+    required: ['slug'], additionalProperties: false,
+  };
+  const readingListTool = (name: string, saved: boolean): Tool => ({
+    name,
+    description: `${saved ? 'Save an article to' : 'Remove an article from'} the current session's reading list. Repeating this action keeps the same saved state and updates the visible bookmarks.`,
+    inputSchema: slugSchema,
+    annotations: { readOnlyHint: false },
+    async execute(input, options) {
+      const slug = stringInput(input, 'slug', 200);
+      const articles = await services.getArticles(options?.signal);
+      if (!articles.some(article => article.slug === slug)) throw new Error('Article not found. Use search_articles to find a valid slug.');
+      const readingList = await services.updateReadingList(slug, saved, options?.signal);
+      return { slug, saved: readingList.includes(slug), readingList };
+    },
+  });
+
+  return [
+    {
+      name: 'search_articles',
+      description: 'Search news article titles and summaries, case-insensitively. Returns article slugs, summaries and links. Use a returned slug with the reading-list tools.',
+      inputSchema: {
+        type: 'object',
+        properties: {
+          query: { type: 'string', minLength: 1, maxLength: 200, description: 'Text to search for in titles and summaries.' },
+          limit: { type: 'integer', minimum: 1, maximum: 50, default: 10 },
+        },
+        required: ['query'], additionalProperties: false,
+      },
+      annotations: { readOnlyHint: true, untrustedContentHint: true },
+      async execute(input, options) {
+        const query = stringInput(input, 'query', 200);
+        const limit = input.limit ?? 10;
+        if (typeof limit !== 'number' || !Number.isInteger(limit) || limit < 1 || limit > 50) {
+          throw new Error('limit must be an integer between 1 and 50.');
+        }
+        const matches = services.searchArticles(await services.getArticles(options?.signal), query);
+        return { articles: matches.slice(0, limit).map(articleResult), total: matches.length };
+      },
+    },
+    {
+      name: 'get_reading_list',
+      description: "List the articles saved in the current browser session's reading list, including their slugs, summaries and links.",
+      inputSchema: { type: 'object', properties: {}, additionalProperties: false },
+      annotations: { readOnlyHint: true, untrustedContentHint: true },
+      async execute(_input, options) {
+        const [articles, slugs] = await Promise.all([
+          services.getArticles(options?.signal), services.getReadingList(options?.signal),
+        ]);
+        return { articles: articles.filter(article => slugs.includes(article.slug)).map(articleResult) };
+      },
+    },
+    readingListTool('save_article', true),
+    readingListTool('remove_saved_article', false),
+  ];
+}
+
+// One registration per Document. Astro's ClientRouter keeps the Document alive
+// across route changes, so these site-wide tools survive its page swaps.
+const registrations = new WeakMap<ModelContext, Promise<void>>();
+
+export function registerNewsTools(context: ModelContext | undefined, tools: Tool[]): Promise<void> {
+  if (!context || typeof context.registerTool !== 'function') return Promise.resolve();
+  const existing = registrations.get(context);
+  if (existing) return existing;
+  const registration = Promise.resolve().then(async () => {
+    const registered: string[] = [];
+    try {
+      for (const tool of tools) {
+        await context.registerTool(tool);
+        registered.push(tool.name);
+      }
+    } catch (error) {
+      // Roll back partial registration so a later page load can retry cleanly.
+      await Promise.allSettled(registered.map(name => context.unregisterTool(name)));
+      registrations.delete(context);
+      throw error;
+    }
+  });
+  registrations.set(context, registration);
+  return registration;
+}
