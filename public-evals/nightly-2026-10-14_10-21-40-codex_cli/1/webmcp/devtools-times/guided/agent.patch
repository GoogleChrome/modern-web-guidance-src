--- /dev/null
+++ b/src/components/WebMCP.astro
@@ -0,0 +1,29 @@
+<script>
+  import { navigate } from 'astro:transitions/client';
+  import { newsClient } from '../utils/app-client';
+  import { registerNewsTools, type ModelContext } from '../utils/webmcp';
+
+  let controller: AbortController | undefined;
+  function cleanup() {
+    controller?.abort();
+    controller = undefined;
+  }
+  async function register() {
+    cleanup();
+    const context = (document as Document & { modelContext?: ModelContext }).modelContext;
+    if (!context?.registerTool || !window.isSecureContext) return;
+    const current = new AbortController();
+    controller = current;
+    try {
+      await registerNewsTools(context, newsClient, navigate, current.signal);
+    } catch (error) {
+      current.abort();
+      if (controller === current) controller = undefined;
+      console.warn('WebMCP registration failed:', error);
+    }
+  }
+  document.addEventListener('astro:before-swap', cleanup);
+  document.addEventListener('astro:page-load', register);
+  window.addEventListener('pagehide', cleanup);
+  window.addEventListener('pageshow', (event) => { if (event.persisted) void register(); });
+</script>
