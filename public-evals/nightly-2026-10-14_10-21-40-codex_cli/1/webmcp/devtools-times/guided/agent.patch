+test('cancels an in-flight fetch when an agent aborts execution', async () => {
+  let requestStarted;
+  const started = new Promise(resolve => { requestStarted = resolve; });
+  const tools = [];
+  const request = (_url, { signal }) => new Promise((_resolve, reject) => {
+    requestStarted();
+    signal.addEventListener('abort', () => reject(signal.reason), { once: true });
+  });
+  await registerNewsTools({ registerTool(tool) { tools.push(tool); } }, createNewsClient('/', request), () => {}, new AbortController().signal);
+  const controller = new AbortController();
+  const pending = tools[0].execute({ query: 'coffee' }, { signal: controller.signal });
+  await started;
+  controller.abort();
+  await assert.rejects(pending, { name: 'AbortError' });
+});
