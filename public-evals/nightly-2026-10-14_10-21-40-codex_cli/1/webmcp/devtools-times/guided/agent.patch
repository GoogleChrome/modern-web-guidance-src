+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createNewsClient } from '../src/utils/news-client.ts';
+import { registerNewsTools } from '../src/utils/webmcp.ts';
+
+const articles = [{ slug: 'coffee-alchemy', title: 'Coffee Alchemy', summary: 'A better brew', image: '/coffee.jpg' }];
+
+async function setup() {
+  const calls = [];
+  const changes = [];
+  let readingList = [];
+  const client = createNewsClient('/devtools-times/', async (url, options) => {
+    calls.push({ url, options });
+    if (url.endsWith('articles.json')) return Response.json(articles);
+    if (options.method === 'POST') {
+      const { slug, saved } = JSON.parse(options.body);
+      readingList = readingList.filter(item => item !== slug);
+      if (saved) readingList.push(slug);
+    }
+    return Response.json({ readingList });
+  }, list => changes.push(list));
+  const tools = new Map();
+  const registrations = [];
+  const controller = new AbortController();
+  const navigations = [];
+  await registerNewsTools({ registerTool(tool, { signal }) {
+    tools.set(tool.name, tool);
+    registrations.push(tool);
+    signal.addEventListener('abort', () => tools.delete(tool.name));
+  } }, client, url => { navigations.push(url); }, controller.signal);
+  const execute = (name, input = {}, signal = new AbortController().signal) => tools.get(name).execute(input, { signal });
+  return { tools, registrations, controller, calls, changes, navigations, execute };
+}
+
+test('registers four schema-described tools and cleans up on abort', async () => {
+  const app = await setup();
+  assert.equal(app.tools.size, 4);
+  for (const tool of app.tools.values()) {
+    assert.equal(tool.inputSchema.type, 'object');
+    assert.equal(tool.inputSchema.additionalProperties, false);
+  }
+  assert.equal(app.tools.get('search_articles').annotations.readOnlyHint, true);
+  assert.equal(app.tools.get('set_article_bookmark').annotations.readOnlyHint, false);
+  app.controller.abort();
+  assert.equal(app.tools.size, 0);
+});
+
+test('searches titles and summaries case-insensitively, validates input, returns base-aware URLs', async () => {
+  const app = await setup();
+  assert.equal((await app.execute('search_articles', { query: ' COFFEE ' })).total, 1);
+  const result = await app.execute('search_articles', { query: 'brew' });
+  assert.equal(result.articles[0].url, '/devtools-times/articles/coffee-alchemy');
+  assert.equal((await app.execute('search_articles', { query: 'unknown' })).total, 0);
+  assert.match((await app.execute('search_articles', { query: ' ' })).error, /non-empty/);
+});
+
+test('sets bookmark state idempotently and publishes reading-list updates', async () => {
+  const app = await setup();
+  const input = { slug: 'coffee-alchemy', saved: true };
+  await app.execute('set_article_bookmark', input);
+  await app.execute('set_article_bookmark', input);
+  assert.equal((await app.execute('get_reading_list')).articles.length, 1);
+  assert.equal(app.changes.length, 2);
+  assert.deepEqual(app.changes[1], ['coffee-alchemy']);
+  await app.execute('set_article_bookmark', { ...input, saved: false });
+  assert.deepEqual((await app.execute('get_reading_list')).articles, []);
