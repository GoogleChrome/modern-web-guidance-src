+test('forwards execution cancellation and prevents work after lifecycle cleanup', async () => {
+  const app = await setup();
+  const cancelled = new AbortController();
+  cancelled.abort();
+  await assert.rejects(app.execute('search_articles', { query: 'coffee' }, cancelled.signal), { name: 'AbortError' });
+  const before = app.calls.length;
+  app.controller.abort();
+  await assert.rejects(app.registrations[0].execute({ query: 'coffee' }, { signal: new AbortController().signal }), { name: 'AbortError' });
+  assert.equal(app.calls.length, before);
+});
