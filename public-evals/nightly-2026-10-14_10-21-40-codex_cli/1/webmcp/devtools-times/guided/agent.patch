new file mode 100644
index 0000000..f1f8c9d
--- /dev/null
+++ b/src/utils/news-client.ts
@@ -0,0 +1,45 @@
+export interface Article {
+  slug: string;
+  title: string;
+  summary: string;
+  image: string;
+}
+
+export function filterArticles(articles: Article[], query: string) {
+  const term = query.trim().toLowerCase();
+  return term ? articles.filter(article =>
+    article.title.toLowerCase().includes(term) || article.summary.toLowerCase().includes(term)
+  ) : [];
+}
+
+export function createNewsClient(baseUrl: string, request: typeof fetch = fetch,
+  onReadingListChange: (slugs: string[]) => void = () => {}) {
+  async function json<T>(path: string, options: RequestInit = {}): Promise<T> {
+    const response = await request(`${baseUrl}${path}`, options);
+    if (!response.ok) throw new Error(`Request failed (${response.status}). Please retry.`);
+    const data = await response.json();
+    options.signal?.throwIfAborted();
+    return data;
+  }
+
+  return {
+    articleUrl: (slug: string) => `${baseUrl}articles/${encodeURIComponent(slug)}`,
+    getArticles: (signal?: AbortSignal) => json<Article[]>('api/articles.json', { signal }),
+    async getReadingList(signal?: AbortSignal) {
+      const data = await json<{ readingList: string[] }>('api/reading-list.json', { signal });
+      return data.readingList;
+    },
+    async setBookmark(slug: string, saved: boolean, signal?: AbortSignal) {
+      const data = await json<{ readingList: string[] }>('api/reading-list.json', {
+        method: 'POST', signal,
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ slug, saved }),
+      });
+      signal?.throwIfAborted();
+      onReadingListChange(data.readingList);
+      return data.readingList;
+    },
+  };
+}
+
+export type NewsClient = ReturnType<typeof createNewsClient>;
diff --git a/src/utils/webmcp.ts b/src/utils/webmcp.ts
new file mode 100644
index 0000000..ee3a7e0
--- /dev/null
+++ b/src/utils/webmcp.ts
@@ -0,0 +1,88 @@
+import { filterArticles, type NewsClient } from './news-client.ts';
+
+interface Tool {
+  name: string;
+  description: string;
+  inputSchema: Record<string, unknown>;
+  execute: (input: Record<string, unknown>, options: { signal: AbortSignal }) => Promise<unknown>;
+  annotations: { readOnlyHint: boolean };
+}
+
+export interface ModelContext {
+  registerTool(tool: Tool, options: { signal: AbortSignal }): Promise<void> | void;
+}
+
+export async function registerNewsTools(context: ModelContext, client: NewsClient,
+  navigate: (url: string) => Promise<unknown> | void, lifetime: AbortSignal) {
+  const schema = (properties: Record<string, unknown>, required: string[] = []) => ({
+    type: 'object', properties, required, additionalProperties: false,
+  });
+  const slugSchema = { type: 'string', minLength: 1, description: 'Exact article slug returned by search_articles or get_reading_list.' };
+  const tools: Tool[] = [
+    {
+      name: 'search_articles',
+      description: 'Search news article titles and summaries. Returns matching articles with slugs and URLs.',
+      inputSchema: schema({ query: { type: 'string', minLength: 1, description: 'Words to search for in article titles and summaries.' } }, ['query']),
+      async execute({ query }, { signal }) {
+        if (typeof query !== 'string' || !query.trim()) return { error: 'Provide a non-empty search query.' };
+        const articles = filterArticles(await client.getArticles(signal), query);
+        return { articles: articles.map(article => ({ ...article, url: client.articleUrl(article.slug) })), total: articles.length };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'get_reading_list',
+      description: 'Get the current session’s saved news articles with slugs and URLs.',
+      inputSchema: schema({}),
+      async execute(_input, { signal }) {
+        const [articles, slugs] = await Promise.all([client.getArticles(signal), client.getReadingList(signal)]);
+        return { articles: articles.filter(article => slugs.includes(article.slug)).map(article => ({ ...article, url: client.articleUrl(article.slug) })) };
+      },
+      annotations: { readOnlyHint: true },
+    },
+    {
+      name: 'set_article_bookmark',
+      description: 'Save or remove a news article from the current session’s reading list. Repeating the same request preserves the requested state.',
+      inputSchema: schema({ slug: slugSchema, saved: { type: 'boolean', description: 'True to save the article; false to remove it.' } }, ['slug', 'saved']),
+      async execute({ slug, saved }, { signal }) {
+        if (typeof slug !== 'string' || typeof saved !== 'boolean') return { error: 'Provide an article slug and a boolean saved value.' };
+        const articles = await client.getArticles(signal);
+        if (!articles.some(article => article.slug === slug)) return { error: 'Article not found. Use search_articles to find a valid slug.' };
+        const readingList = await client.setBookmark(slug, saved, signal);
+        return { slug, saved: readingList.includes(slug), readingList };
+      },
+      annotations: { readOnlyHint: false },
+    },
+    {
+      name: 'open_article',
+      description: 'Navigate to a news article in the current tab using its exact slug.',
+      inputSchema: schema({ slug: slugSchema }, ['slug']),
+      async execute({ slug }, { signal }) {
+        if (typeof slug !== 'string' || !slug) return { error: 'Provide an article slug.' };
+        const articles = await client.getArticles(signal);
+        if (!articles.some(article => article.slug === slug)) return { error: 'Article not found. Use search_articles to find a valid slug.' };
+        signal.throwIfAborted();
+        const url = client.articleUrl(slug);
+        await navigate(url);
+        return { url };
+      },
+      annotations: { readOnlyHint: false },
+    },
+  ];
+
+  for (const tool of tools) {
+    if (lifetime.aborted) return;
+    const execute = tool.execute;
+    await context.registerTool({ ...tool, async execute(input, options) {
+      // Registration cleanup does not cancel executions in the current API.
+      const signal = AbortSignal.any([options.signal, lifetime]);
+      try {
+        signal.throwIfAborted();
+        return await execute(input, { signal });
+      } catch (error) {
+        if (signal.aborted) throw error;
+        return { error: error instanceof Error ? error.message : 'Unable to complete this action. Please retry.' };
+      }
+    } }, { signal: lifetime });
+  }
+}
