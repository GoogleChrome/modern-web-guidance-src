+test('returns actionable HTTP and network failures to agents', async () => {
+  for (const request of [async () => new Response('', { status: 503 }), async () => { throw new Error('Network unavailable'); }]) {
+    const tools = [];
+    await registerNewsTools({ registerTool(tool) { tools.push(tool); } }, createNewsClient('/', request), () => {}, new AbortController().signal);
+    const result = await tools[0].execute({ query: 'coffee' }, { signal: new AbortController().signal });
+    assert.match(result.error, /503|Network unavailable/);
