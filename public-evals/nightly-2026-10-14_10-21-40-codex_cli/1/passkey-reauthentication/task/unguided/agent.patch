+  <script>
+    const reauthButton = document.querySelector('[data-testid="reauth-button"]');
+    const reauthStatus = document.getElementById('reauth-status');
+
+    function decodeBase64url(value) {
+      if (typeof value !== 'string' || !/^[A-Za-z0-9_-]+={0,2}$/.test(value)) {
+        throw new Error('The server returned invalid verification options.');
+      }
+      const base64 = value.replace(/-/g, '+').replace(/_/g, '/').replace(/=+$/, '');
+      return Uint8Array.from(atob(base64 + '='.repeat((4 - base64.length % 4) % 4)), char => char.charCodeAt(0));
+    }
+
+    function encodeBase64url(value) {
+      let binary = '';
+      for (const byte of new Uint8Array(value)) binary += String.fromCharCode(byte);
+      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+    }
+
+    reauthButton.addEventListener('click', async () => {
+      if (reauthButton.disabled) return;
+      reauthButton.disabled = true;
+      reauthStatus.textContent = 'Preparing identity verification…';
+
+      try {
+        if (!window.isSecureContext || !window.PublicKeyCredential || !navigator.credentials?.get) {
+          throw new Error('Passkey verification requires a supported browser and a secure connection.');
+        }
+
+        const optionsResponse = await fetch('/api/reauth/options', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: '{}'
+        });
+        if (!optionsResponse.ok) throw new Error('Could not start verification. Please try again.');
+        const options = await optionsResponse.json();
+        const publicKey = options.publicKey ?? options;
+
+        // Never allow an empty list to become a discoverable-credential sign-in.
+        // The server must supply only credentials belonging to this signed-in user.
+        if (!Array.isArray(publicKey.allowCredentials) || publicKey.allowCredentials.length === 0) {
+          throw new Error('No registered passkey or security key is available for this account.');
+        }
+        const request = {
+          ...publicKey,
+          challenge: decodeBase64url(publicKey.challenge),
+          allowCredentials: publicKey.allowCredentials.map(credential => {
+            if (credential.type !== 'public-key') {
+              throw new Error('The server returned invalid verification options.');
+            }
+            return { ...credential, id: decodeBase64url(credential.id) };
+          }),
+          userVerification: 'required'
+        };
+
+        reauthStatus.textContent = 'Confirm with your passkey or security key…';
+        const assertion = await navigator.credentials.get({ publicKey: request });
+        if (!assertion || assertion.type !== 'public-key' || !assertion.response?.signature) {
+          throw new Error('Identity verification did not complete. Please try again.');
+        }
+        const response = assertion.response;
+        const payload = {
+          id: assertion.id,
+          rawId: encodeBase64url(assertion.rawId),
+          type: assertion.type,
+          response: {
+            clientDataJSON: encodeBase64url(response.clientDataJSON),
+            authenticatorData: encodeBase64url(response.authenticatorData),
+            signature: encodeBase64url(response.signature),
+            userHandle: response.userHandle == null ? null : encodeBase64url(response.userHandle)
+          },
+          clientExtensionResults: assertion.getClientExtensionResults()
+        };
+        if (assertion.authenticatorAttachment != null) {
+          payload.authenticatorAttachment = assertion.authenticatorAttachment;
+        }
+
+        reauthStatus.textContent = 'Checking verification…';
+        const verificationResponse = await fetch('/api/reauth/verify', {
+          method: 'POST',
+          credentials: 'same-origin',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(payload)
+        });
+        if (!verificationResponse.ok) throw new Error('Verification was rejected. Please try again.');
+        const result = await verificationResponse.json();
+        if (result.verified !== true) throw new Error('Verification was rejected. Please try again.');
+        reauthStatus.textContent = 'Identity confirmed. You can continue with your account change.';
+      } catch (error) {
+        reauthStatus.textContent = error.name === 'NotAllowedError' || error.name === 'AbortError'
+          ? 'Verification was cancelled or timed out. Please try again.'
+          : error.message || 'Could not verify your identity. Please try again.';
+      } finally {
+        reauthButton.disabled = false;
+      }
+    });
+  </script>
