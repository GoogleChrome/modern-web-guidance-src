+  <script>
+    const menuToggle = document.getElementById('menu-toggle');
+    const menu = document.getElementById('promo-menu');
+    function closeMenu() { menu.hidden = true; menuToggle.setAttribute('aria-expanded', 'false'); }
+    menuToggle.addEventListener('click', () => {
+      menu.hidden = !menu.hidden;
+      menuToggle.setAttribute('aria-expanded', String(!menu.hidden));
+    });
+    document.addEventListener('keydown', (event) => {
+      if (event.key === 'Escape' && !menu.hidden) { closeMenu(); menuToggle.focus(); }
+    });
+    document.addEventListener('click', (event) => {
+      if (!menu.hidden && !event.target.closest('nav')) closeMenu();
+    });
+    menu.querySelector('a').addEventListener('click', closeMenu);
+    const galleryToggle = document.getElementById('gallery-toggle');
+    galleryToggle.addEventListener('click', () => {
+      const alternate = document.getElementById('gallery-alt');
+      alternate.hidden = !alternate.hidden;
+      document.getElementById('gallery-first').hidden = !alternate.hidden;
+      galleryToggle.setAttribute('aria-expanded', String(!alternate.hidden));
