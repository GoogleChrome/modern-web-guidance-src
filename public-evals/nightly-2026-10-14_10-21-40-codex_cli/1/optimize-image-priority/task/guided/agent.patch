+    :focus-visible { outline: 2px solid #61734d; outline-offset: 5px; }
+    [hidden] { display: none !important; }
+    header, main, footer { max-width: 1440px; margin: auto; padding-inline: clamp(20px, 5vw, 80px); }
+    header { height: 88px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #d9dad1; }
