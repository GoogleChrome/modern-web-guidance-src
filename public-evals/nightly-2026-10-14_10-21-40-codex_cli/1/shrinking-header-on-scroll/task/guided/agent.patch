+  <script>
+    // Use native scroll animations only when both timeline and range work.
+    if (!(window.CSS && CSS.supports && CSS.supports(
+      '(animation-timeline: scroll()) and (animation-range: 0% 100%)'
+    ))) {
+      const navigation = document.querySelector('nav');
+      let pendingFrame = null;
+      let expandedHeight;
+      let compactHeight;
+      let scrollDistance;
+
+      function updateNavigation() {
+        pendingFrame = null;
+        const scrollPosition = window.pageYOffset || 0;
+        const progress = Math.max(0, Math.min(1, scrollPosition / scrollDistance));
+        navigation.style.height = (expandedHeight -
+          (expandedHeight - compactHeight) * progress) + 'px';
+      }
+
+      function measureNavigation() {
+        if (pendingFrame !== null) {
+          cancelAnimationFrame(pendingFrame);
+        }
+        const styles = getComputedStyle(document.documentElement);
+        expandedHeight = parseFloat(styles.getPropertyValue('--nav-expanded'));
+        compactHeight = parseFloat(styles.getPropertyValue('--nav-compact'));
+        scrollDistance = parseFloat(styles.getPropertyValue('--nav-scroll-distance'));
+        updateNavigation();
+      }
+
+      window.addEventListener('scroll', function () {
+        if (pendingFrame === null) {
+          pendingFrame = requestAnimationFrame(updateNavigation);
+        }
+      }, { passive: true });
+      window.addEventListener('resize', measureNavigation);
+      window.addEventListener('pageshow', measureNavigation);
+      // Initialize immediately, including when a scrolled page is restored.
+      measureNavigation();
+    }
+  </script>
