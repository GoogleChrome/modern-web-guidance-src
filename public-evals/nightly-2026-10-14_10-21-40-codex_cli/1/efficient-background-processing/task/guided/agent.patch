+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const temperatureValue = document.getElementById('roast-temp-value');
+      const context = canvas.getContext('2d');
+      const beans = Array.from({ length: 36 }, () => ({
+        phase: Math.random() * Math.PI * 2,
+        radius: 0.3 + Math.random() * 0.65,
+        speed: 0.6 + Math.random() * 0.7
+      }));
+      let frameId = null;
+      let intervalId = null;
+      let running = false;
+      let inViewport = false;
+      let renderingSkipped = false;
+      let pageActive = true;
+      let lastTime = null;
+      let roastTime = 0;
+      let temperature = 185;
+
+      function drawBeans() {
+        if (!context) return;
+        const width = canvas.width;
+        const height = canvas.height;
+        context.clearRect(0, 0, width, height);
+        beans.forEach((bean) => {
+          const angle = bean.phase + roastTime * bean.speed;
+          const x = width / 2 + Math.cos(angle) * width * 0.43 * bean.radius;
+          const y = height / 2 + Math.sin(angle) * height * 0.34 * bean.radius;
+          context.save();
+          context.translate(x, y);
+          context.rotate(-angle * 1.5);
+          context.fillStyle = temperature > 205 ? '#75432b' : '#ad7146';
+          context.beginPath();
+          context.ellipse(0, 0, 15, 10, 0, 0, Math.PI * 2);
+          context.fill();
+          context.strokeStyle = '#3e2723';
+          context.lineWidth = 2;
+          context.beginPath();
+          context.moveTo(-10, 0);
+          context.bezierCurveTo(-3, -5, 3, 5, 10, 0);
+          context.stroke();
+          context.restore();
+        });
+      }
+
+      function animate(time) {
+        frameId = null;
+        if (!running) return;
+        if (lastTime !== null) roastTime += Math.min((time - lastTime) / 1000, 0.05);
+        lastTime = time;
+        drawBeans();
+        frameId = requestAnimationFrame(animate);
+      }
+
+      // One owner for both resources prevents duplicate loops on repeated events.
+      function syncSimulation() {
+        const shouldRun = pageActive && inViewport && !renderingSkipped && !document.hidden;
+        if (shouldRun === running) return;
+        running = shouldRun;
+        lastTime = null;
+        if (running) {
+          if (context) frameId = requestAnimationFrame(animate);
+          intervalId = setInterval(() => {
+            temperature += (215 - temperature) * 0.04 + (Math.random() - 0.5) * 1.2;
+            temperatureValue.textContent = Math.round(temperature);
+          }, 1000);
+        } else {
+          if (frameId !== null) cancelAnimationFrame(frameId);
+          if (intervalId !== null) clearInterval(intervalId);
+          frameId = null;
+          intervalId = null;
+        }
+      }
+
+      // Listen on the element itself: this rendering-state event may not bubble.
+      if ('oncontentvisibilityautostatechange' in widget) {
+        widget.addEventListener('contentvisibilityautostatechange', (event) => {
+          renderingSkipped = event.skipped;
+          syncSimulation();
+        });
+      }
+
+      // Also enforce exact viewport visibility: native rendering may start early.
+      if ('IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          inViewport = entries[entries.length - 1].isIntersecting;
+          syncSimulation();
+        }, { threshold: 0 });
+        observer.observe(widget);
+      } else {
+        // Legacy fallback uses events, never an always-running polling timer.
+        const checkViewport = () => {
+          const rect = widget.getBoundingClientRect();
+          inViewport = rect.bottom > 0 && rect.right > 0 &&
+            rect.top < window.innerHeight && rect.left < window.innerWidth;
+          syncSimulation();
+        };
+        window.addEventListener('scroll', checkViewport, { passive: true, capture: true });
+        window.addEventListener('resize', checkViewport, { passive: true });
+        window.addEventListener('pageshow', checkViewport);
+        checkViewport();
+      }
+
+      document.addEventListener('visibilitychange', syncSimulation);
+      window.addEventListener('pagehide', () => {
+        pageActive = false;
+        syncSimulation();
+      });
+      window.addEventListener('pageshow', () => {
+        pageActive = true;
+        syncSimulation();
+      });
+    })();
+  </script>
+
 </body>
 
