diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -92,8 +92,100 @@
       font-size: 3rem;
       margin-bottom: 1rem;
     }
 
+    .store-label {
+      position: absolute;
+      width: 1px;
+      height: 1px;
+      padding: 0;
+      overflow: hidden;
+      clip-path: inset(50%);
+      white-space: nowrap;
+    }
+
+    .store-select {
+      width: min(100%, 280px);
+      min-height: 48px;
+      margin-top: 24px;
+      padding: 12px 16px;
+      border: 1px solid var(--secondary);
+      border-radius: 6px;
+      background: var(--light);
+      color: var(--primary);
+      font: inherit;
+      text-align: left;
+      cursor: pointer;
+    }
+
+    .store-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 4px;
+    }
+
+    @supports (appearance: base-select) {
+      .store-select,
+      .store-select::picker(select) {
+        appearance: base-select;
+      }
+
+      .store-select::picker-icon {
+        color: var(--primary);
+        transition: transform 240ms ease;
+      }
+
+      .store-select:open::picker-icon {
+        transform: rotate(180deg);
+      }
+
+      .store-select::picker(select) {
+        margin-top: 8px;
+        padding: 6px;
+        border: 1px solid var(--secondary);
+        border-radius: 6px;
+        background: var(--light);
+        color: var(--primary);
+        box-shadow: 0 12px 30px rgb(0 0 0 / 20%);
+        opacity: 0;
+        transition:
+          opacity 240ms ease,
+          display 240ms allow-discrete,
+          overlay 240ms allow-discrete;
+      }
+
+      .store-select:open::picker(select) {
+        opacity: 1;
+      }
+
+      @starting-style {
+        .store-select:open::picker(select) {
+          opacity: 0;
+        }
+      }
+
+      .store-select option {
+        padding: 10px 12px;
+        border-radius: 4px;
+      }
+
+      .store-select option:hover,
+      .store-select option:focus {
+        background: var(--secondary);
+      }
+
+      .store-select option:checked {
+        background: var(--secondary);
+        font-weight: 700;
+      }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .store-select::picker(select),
+      .store-select::picker-icon {
+        transition: none;
+      }
+    }
+
