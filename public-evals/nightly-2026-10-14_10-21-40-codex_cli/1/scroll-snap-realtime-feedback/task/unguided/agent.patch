+  <script>
+    const gallery = document.getElementById('gallery');
+    const items = Array.from(gallery.querySelectorAll('.gallery-item'));
+    const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+    const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+    const supportsScrollEnd = 'onscrollend' in gallery;
+    let settleTimer;
+    let pointerDown = false;
+
+    function nearestItem() {
+      const galleryLeft = gallery.getBoundingClientRect().left + gallery.clientLeft;
+      return items.reduce((nearest, item, index) =>
+        Math.abs(item.getBoundingClientRect().left - galleryLeft) <
+        Math.abs(items[nearest].getBoundingClientRect().left - galleryLeft) ? index : nearest, 0);
+    }
+
+    function showPending(index) {
+      thumbnails.forEach((thumbnail, i) => thumbnail.classList.toggle('pending', i === index));
+    }
+
+    function finishScroll() {
+      clearTimeout(settleTimer);
+      const selected = nearestItem();
+      thumbnails.forEach((thumbnail, index) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', index === selected);
+        if (index === selected) {
+          thumbnail.setAttribute('aria-current', 'true');
+        } else {
+          thumbnail.removeAttribute('aria-current');
+        }
+      });
+    }
+
+    // The browser reports its intended snap destination before scrolling finishes.
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      const index = items.indexOf(event.snapTargetInline);
+      if (index !== -1) showPending(index);
+    });
+
+    function scheduleFinish() {
+      clearTimeout(settleTimer);
+      settleTimer = setTimeout(() => {
+        if (!pointerDown) finishScroll();
+      }, 180);
+    }
+
+    gallery.addEventListener('scroll', () => {
+      // Older browsers still get feedback on every scroll event, without a debounce.
+      if (!supportsSnapChanging) showPending(nearestItem());
+      if (!supportsScrollEnd) scheduleFinish();
+    }, { passive: true });
+    gallery.addEventListener('scrollend', finishScroll);
+    gallery.addEventListener('pointerdown', () => { pointerDown = true; }, { passive: true });
+    function releasePointer() {
+      if (!pointerDown) return;
+      pointerDown = false;
+      if (!supportsScrollEnd) scheduleFinish();
+    }
+    window.addEventListener('pointerup', releasePointer, { passive: true });
+    window.addEventListener('pointercancel', releasePointer, { passive: true });
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        const offset = items[index].getBoundingClientRect().left -
+          gallery.getBoundingClientRect().left - gallery.clientLeft;
+        if (Math.abs(offset) < 1) {
+          finishScroll();
+          return;
+        }
+        showPending(index);
+        gallery.scrollTo({
+          left: gallery.scrollLeft + offset,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+  </script>
