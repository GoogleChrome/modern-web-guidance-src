+  <script>
+    const gallery = document.querySelector('#gallery');
+    const items = [...gallery.querySelectorAll('.gallery-item')];
+    const thumbnails = [...document.querySelectorAll('.gallery-thumbnails .thumbnail')];
+    let frame = null;
+    let scrollTimeout;
+
+    const closestItemIndex = () => {
+      const center = gallery.scrollLeft + gallery.clientWidth / 2;
+      return items.reduce((closest, item, index) => {
+        const distance = Math.abs(item.offsetLeft + item.offsetWidth / 2 - center);
+        const closestDistance = Math.abs(items[closest].offsetLeft + items[closest].offsetWidth / 2 - center);
+        return distance < closestDistance ? index : closest;
+      }, 0);
+    };
+
+    const setPending = (index) => {
+      if (index < 0) return;
+      thumbnails.forEach((thumbnail, position) => {
+        thumbnail.classList.toggle('pending', position === index);
+      });
+    };
+
+    const setActive = (index) => {
+      if (index < 0) return;
+      thumbnails.forEach((thumbnail, position) => {
+        thumbnail.classList.remove('pending');
+        thumbnail.classList.toggle('active', position === index);
+        if (position === index) thumbnail.setAttribute('aria-current', 'true');
+        else thumbnail.removeAttribute('aria-current');
+      });
+    };
+
+    const settle = () => {
+      clearTimeout(scrollTimeout);
+      if (frame !== null) cancelAnimationFrame(frame);
+      frame = null;
+      setActive(closestItemIndex());
+    };
+
+    const supportsSnapChanging = 'onscrollsnapchanging' in gallery;
+    const supportsScrollEnd = 'onscrollend' in gallery;
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      setPending(items.indexOf(event.snapTargetInline));
+    });
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      const index = items.indexOf(event.snapTargetInline);
+      if (index < 0) return;
+      clearTimeout(scrollTimeout);
+      if (frame !== null) cancelAnimationFrame(frame);
+      frame = null;
+      setActive(index);
+    });
+
+    gallery.addEventListener('scroll', () => {
+      if (!supportsSnapChanging && frame === null) {
+        frame = requestAnimationFrame(() => {
+          frame = null;
+          setPending(closestItemIndex());
+        });
+      }
+      if (!supportsScrollEnd) {
+        clearTimeout(scrollTimeout);
+        scrollTimeout = setTimeout(settle, 150);
+      }
+    }, { passive: true });
+    gallery.addEventListener('scrollend', settle);
+
+    thumbnails.forEach((thumbnail, index) => {
+      thumbnail.addEventListener('click', () => {
+        gallery.scrollTo({
+          left: items[index].offsetLeft + items[index].offsetWidth / 2 - gallery.clientWidth / 2,
+          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
+        });
+      });
+    });
+
+    window.addEventListener('load', settle, { once: true });
+    window.addEventListener('pageshow', settle);
+    window.addEventListener('resize', settle);
+    settle();
+  </script>
