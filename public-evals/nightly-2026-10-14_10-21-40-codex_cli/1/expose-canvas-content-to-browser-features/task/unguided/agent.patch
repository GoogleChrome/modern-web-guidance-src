+  <script>
+    const stage = document.querySelector('.coffee-stage');
+    const canvas = document.getElementById('canvas');
+    const form = document.getElementById('coffee-form');
+    const milk = document.getElementById('coffee-milk');
+    const syrup = document.getElementById('coffee-syrup');
+    const summary = document.getElementById('coffee-summary');
+    const status = document.getElementById('coffee-status');
+    const context = canvas.getContext('2d');
+
+    function drawCup() {
+      if (!context) return;
+      const bounds = stage.getBoundingClientRect();
+      const content = form.getBoundingClientRect();
+      if (!bounds.width || !bounds.height) return;
+      const ratio = window.devicePixelRatio || 1;
+      canvas.width = Math.round(bounds.width * ratio);
+      canvas.height = Math.round(bounds.height * ratio);
+      // All drawing coordinates are CSS pixels, shared with the HTML layout.
+      context.setTransform(canvas.width / bounds.width, 0, 0, canvas.height / bounds.height, 0, 0);
+      const left = content.left - bounds.left - 18;
+      const right = content.right - bounds.left + 18;
+      const top = content.top - bounds.top - 20;
+      const bottom = content.bottom - bounds.top + 22;
+      const center = (left + right) / 2;
+      const width = right - left;
+
+      context.fillStyle = 'rgba(78, 52, 46, 0.12)';
+      context.beginPath();
+      context.ellipse(center, bottom + 9, width / 2 + 10, 10, 0, 0, Math.PI * 2);
+      context.fill();
+
+      context.strokeStyle = '#bda18b';
+      context.lineWidth = 12;
+      context.beginPath();
+      context.ellipse(right - 2, top + 100, Math.min(34, bounds.width - right - 8), 50, 0, 0, Math.PI * 2);
+      context.stroke();
+
+      context.fillStyle = '#fff5e5';
+      context.strokeStyle = '#bda18b';
+      context.lineWidth = 2;
+      context.beginPath();
+      context.moveTo(left, top);
+      context.lineTo(right, top);
+      context.lineTo(right, bottom - 24);
+      context.quadraticCurveTo(right, bottom, right - 24, bottom);
+      context.lineTo(left + 24, bottom);
+      context.quadraticCurveTo(left, bottom, left, bottom - 24);
+      context.closePath();
+      context.fill();
+      context.stroke();
+
+      context.fillStyle = '#d8b99a';
+      context.beginPath();
+      context.ellipse(center, top, width / 2, 15, 0, 0, Math.PI * 2);
+      context.fill();
+      context.stroke();
+      context.fillStyle = { whole: '#a57550', oat: '#b88c61', almond: '#bc956f', soy: '#ae825c' }[milk.value];
+      context.beginPath();
+      context.ellipse(center, top, width / 2 - 7, 10, 0, 0, Math.PI * 2);
+      context.fill();
+
+      context.strokeStyle = '#bda18b';
+      context.lineWidth = 2;
+      for (const offset of [-28, 0, 28]) {
+        context.beginPath();
+        context.moveTo(center + offset, top - 24);
+        context.bezierCurveTo(center + offset - 12, top - 34, center + offset + 12, top - 42, center + offset, top - 52);
+        context.stroke();
+      }
+    }
+
+    function updateCoffee() {
+      const size = form.querySelector('input[name="size"]:checked').parentElement.textContent.trim();
+      summary.textContent = [size, milk.selectedOptions[0].textContent, syrup.selectedOptions[0].textContent].join(' · ');
+      status.textContent = '';
+      drawCup();
+    }
+
+    form.addEventListener('input', updateCoffee);
+    form.addEventListener('change', updateCoffee);
+    form.addEventListener('submit', (event) => {
+      event.preventDefault();
+      const name = document.getElementById('coffee-name').value.trim();
+      status.textContent = (name ? name + ', your' : 'Your') + ' latte is customized: ' + summary.textContent + '. Ready to order from our menu.';
+    });
+    // Observe both elements so wrapping, zoom, and translated text stay aligned.
+    const observer = new ResizeObserver(drawCup);
+    observer.observe(stage);
+    observer.observe(form);
+    window.addEventListener('resize', drawCup);
+    // A display change can change pixel density without changing CSS dimensions.
+    let densityQuery;
+    function watchDensity() {
+      if (densityQuery) densityQuery.removeEventListener('change', watchDensity);
+      densityQuery = window.matchMedia('(resolution: ' + (window.devicePixelRatio || 1) + 'dppx)');
+      densityQuery.addEventListener('change', watchDensity);
+      drawCup();
+    }
+    watchDensity();
+    if (document.fonts) document.fonts.ready.then(drawCup);
+  </script>
 </body>
 
