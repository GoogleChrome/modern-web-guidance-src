+  <script>
+    (() => {
+      const canvas = document.getElementById('canvas');
+      const stage = document.getElementById('coffee-stage');
+      const form = document.getElementById('coffee-form');
+      const name = document.getElementById('coffee-name');
+      const milk = document.getElementById('coffee-milk');
+      const syrup = document.getElementById('coffee-syrup');
+      const summary = document.getElementById('coffee-summary');
+      const confirmation = document.getElementById('coffee-confirmation');
+      const ctx = canvas.getContext('2d');
+      let nativeCanvas = Boolean(ctx && 'requestPaint' in HTMLCanvasElement.prototype &&
+        typeof ctx.drawElementImage === 'function');
+
+      function useOverlay() {
+        nativeCanvas = false;
+        canvas.onpaint = null;
+        form.style.transform = '';
+        stage.append(form);
+        stage.classList.remove('native-canvas');
+        stage.style.height = '';
+        // The bitmap is decorative; all meaningful content is in the real form.
+        canvas.setAttribute('aria-hidden', 'true');
+      }
+
+      if (nativeCanvas) {
+        stage.style.height = stage.offsetHeight + 'px';
+        stage.classList.add('native-canvas');
+        canvas.append(form);
+      } else {
+        useOverlay();
+      }
+
+      function drawCup() {
+        const width = canvas.clientWidth;
+        const height = canvas.clientHeight;
+        ctx.setTransform(1, 0, 0, 1, 0, 0);
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+        ctx.setTransform(canvas.width / width, 0, 0, canvas.height / height, 0, 0);
+
+        // All geometry uses CSS pixels; only the backing store uses device pixels.
+        ctx.fillStyle = '#d7c4b4';
+        ctx.beginPath();
+        ctx.ellipse(width / 2, height - 22, width * 0.4, 10, 0, 0, Math.PI * 2);
+        ctx.fill();
+
+        ctx.fillStyle = '#fffaf4';
+        ctx.strokeStyle = '#c5aa94';
+        ctx.lineWidth = 2;
+        ctx.beginPath();
+        ctx.moveTo(16, 58);
+        ctx.lineTo(width - 16, 58);
+        ctx.lineTo(width - 24, height - 54);
+        ctx.quadraticCurveTo(width - 24, height - 36, width - 42, height - 36);
+        ctx.lineTo(42, height - 36);
+        ctx.quadraticCurveTo(24, height - 36, 24, height - 54);
+        ctx.closePath();
+        ctx.fill();
+        ctx.stroke();
+
+        // The lid color responds to the chosen syrup.
+        ctx.fillStyle = { none: '#4e342e', vanilla: '#795548', caramel: '#a46632', maple: '#874529' }[syrup.value];
+        ctx.beginPath();
+        ctx.roundRect(12, 42, width - 24, 24, 8);
+        ctx.fill();
+        ctx.beginPath();
+        ctx.roundRect(26, 28, width - 52, 20, [10, 10, 0, 0]);
+        ctx.fill();
+      }
+
+      function render() {
+        if (!ctx || !canvas.clientWidth || !canvas.clientHeight) return;
+        drawCup();
+        if (nativeCanvas) {
+          try {
+            const inset = parseFloat(getComputedStyle(stage).getPropertyValue('--form-inset'));
+            const transform = ctx.drawElementImage(form, inset, 88);
+            // Earlier API versions return a matrix; newer versions sync hit testing automatically.
+            if (transform) {
+              const cssTransform = transform.toString();
+              if (form.style.transform !== cssTransform) form.style.transform = cssTransform;
+            }
+          } catch (error) {
+            // An incomplete experimental implementation must not strand the controls.
+            useOverlay();
+            resize();
+          }
+        }
+      }
+
+      function requestRender() {
+        if (nativeCanvas) canvas.requestPaint();
+        else render();
+      }
+
+      function resize(entry) {
+        const pixels = entry?.devicePixelContentBoxSize?.[0];
+        const dpr = window.devicePixelRatio || 1;
+        const width = pixels?.inlineSize || Math.round(canvas.clientWidth * dpr);
+        const height = pixels?.blockSize || Math.round(canvas.clientHeight * dpr);
+        if (canvas.width !== width) canvas.width = width;
+        if (canvas.height !== height) canvas.height = height;
+        requestRender();
+      }
+
+      if (nativeCanvas) canvas.onpaint = render;
+      const canvasObserver = new ResizeObserver(([entry]) => resize(entry));
+      try {
+        canvasObserver.observe(canvas, { box: 'device-pixel-content-box' });
+      } catch {
+        canvasObserver.observe(canvas);
+      }
+      const formObserver = new ResizeObserver(() => {
+        // Reflow for small screens, translated labels, zoom, and longer summaries.
+        if (nativeCanvas) stage.style.height = (form.offsetHeight + 178) + 'px';
+        resize();
+      });
+      formObserver.observe(form);
+      window.addEventListener('resize', () => resize());
+      window.addEventListener('beforeprint', () => {
+        // Keep the real form printable even when it was a canvas descendant.
+        if (nativeCanvas) useOverlay();
+      });
+
+      // A display move can change DPR without changing the CSS dimensions.
+      let resolutionQuery;
+      function watchResolution() {
+        resolutionQuery?.removeEventListener('change', resolutionChanged);
+        resolutionQuery = matchMedia(`(resolution: ${window.devicePixelRatio || 1}dppx)`);
+        resolutionQuery.addEventListener('change', resolutionChanged, { once: true });
+      }
+      function resolutionChanged() { resize(); watchResolution(); }
+      watchResolution();
+
+      function updateSummary() {
+        const owner = name.value.trim();
+        const milkLabel = milk.selectedOptions[0].textContent.toLowerCase();
+        const syrupLabel = syrup.value === 'none' ? 'no syrup' :
+          syrup.selectedOptions[0].textContent.toLowerCase() + ' syrup';
+        summary.textContent = `${owner ? owner + '’s' : 'Your'} cup: latte with ${milkLabel} and ${syrupLabel}.`;
+        confirmation.textContent = '';
+        requestRender();
+      }
+      form.addEventListener('input', updateSummary);
+      form.addEventListener('change', updateSummary);
+      form.addEventListener('submit', (event) => {
+        event.preventDefault();
+        confirmation.textContent = 'Cup saved for this visit. ' + summary.textContent;
+        requestRender();
+      });
+      resize();
+    })();
+  </script>
+
