diff --git a/tests/view-cache.test.mjs b/tests/view-cache.test.mjs
new file mode 100644
index 0000000..661c48f
--- /dev/null
+++ b/tests/view-cache.test.mjs
@@ -0,0 +1,151 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { Window } from "happy-dom";
+import { installViewCache, viewKey } from "../src/scripts/view-cache.ts";
+
+function setup(maxViews = 8) {
+  const window = new Window({ url: "https://example.test/devtools-times/" });
+  const doc = window.document;
+  const markup = (label) => `<main><div data-view-cache data-astro-transition-persist="visited-views"><div data-cached-view><input value="${label}"><button>${label}</button><script type="application/json">{}</script></div></div></main>`;
+  doc.body.innerHTML = markup("home");
+  installViewCache(doc, maxViews);
+
+  function prepare(path, formData) {
+    const event = new window.Event("astro:before-preparation");
+    Object.assign(event, {
+      from: new URL(doc.location.href),
+      to: new URL(path, doc.location.href),
+      signal: new AbortController().signal,
+      formData,
+    });
+    doc.dispatchEvent(event);
+    return event;
+  }
+
+  function commit(preparation) {
+    const incoming = doc.implementation.createHTMLDocument(preparation.to.pathname);
+    incoming.title = preparation.to.pathname;
+    incoming.body.innerHTML = markup(preparation.to.pathname);
+    const event = new window.Event("astro:before-swap");
+    Object.assign(event, {
+      from: preparation.from,
+      to: preparation.to,
+      signal: preparation.signal,
+      newDocument: incoming,
+      // Model Astro's persistent-element swap: preserve the host, replace the
+      // surrounding page, and then dispatch after-swap for island cleanup.
+      swap() {
+        const host = doc.querySelector("[data-view-cache]");
+        const placeholder = incoming.querySelector("[data-view-cache]");
+        doc.documentElement.append(host);
+        doc.title = incoming.title;
+        doc.body.replaceWith(incoming.body);
+        placeholder.replaceWith(host);
+      },
+    });
+    doc.dispatchEvent(event);
+    event.swap();
+    window.history.pushState({}, "", event.to.href);
+    doc.dispatchEvent(new window.Event("astro:after-swap"));
+    return doc.querySelector("[data-cached-view]:not([hidden])");
+  }
+
+  return {
+    window, doc, prepare, commit,
+    navigate: (path, formData) => commit(prepare(path, formData)),
+    active: () => doc.querySelector("[data-cached-view]:not([hidden])"),
+  };
+}
+
+test("revisiting a view restores the same nodes, input state and listeners", () => {
+  const app = setup();
+  const home = app.active();
+  const input = home.querySelector("input");
+  input.value = "saved draft";
+  let clicks = 0;
+  home.querySelector("button").addEventListener("click", () => clicks++);
+
+  app.navigate("articles/coffee-alchemy");
+  assert.ok(home.isConnected);
+  assert.equal(home.hidden, true);
+  assert.equal(home.inert, true);
+  assert.equal(home.querySelector("script").dataset.astroExec, "");
+  assert.equal(app.navigate("/devtools-times/"), home);
+  assert.equal(home.querySelector("input"), input);
+  assert.equal(input.value, "saved draft");
+  assert.equal(home.hidden, false);
+  assert.equal(home.inert, false);
+  home.querySelector("button").click();
+  assert.equal(clicks, 1);
+  assert.equal(app.doc.querySelectorAll("[data-cached-view]:not([hidden])").length, 1);
+  assert.equal(app.doc.title, "/devtools-times/");
+});
+
+test("focus leaves the hidden view and islands remain connected after swapping", () => {
+  const app = setup();
+  let unmounts = 0;
+  class TestIsland extends app.window.HTMLElement {
+    disconnectedCallback() {
+      app.doc.addEventListener("astro:after-swap", () => {
+        if (!this.isConnected) unmounts++;
+      }, { once: true });
+    }
+  }
+  app.window.customElements.define("test-island", TestIsland);
+  const home = app.active();
+  home.append(app.doc.createElement("test-island"));
+  home.querySelector("input").focus();
+  app.navigate("reports");
+  assert.equal(home.contains(app.doc.activeElement), false);
+  assert.equal(unmounts, 0);
+  app.navigate("/devtools-times/");
+  assert.equal(unmounts, 0);
+});
+
+test("the least recently used view is evicted and recreated on its next visit", () => {
+  const app = setup(2);
+  const home = app.active();
+  const reports = app.navigate("reports");
+  app.navigate("/devtools-times/");
+  app.navigate("multimedia");
+  assert.equal(home.isConnected, true);
+  assert.equal(reports.isConnected, false);
+  assert.equal(app.doc.querySelectorAll("[data-cached-view]").length, 2);
+  assert.notEqual(app.navigate("reports"), reports);
+});
+
+test("queries have independent views while fragments share the same view", () => {
+  const app = setup();
+  const first = app.navigate("reports?sort=date");
+  const second = app.navigate("reports?sort=title");
+  assert.notEqual(first, second);
+  assert.equal(app.navigate("reports?sort=date#section"), first);
+  assert.equal(viewKey(new URL("https://example.test/a?q=1#one")), "https://example.test/a?q=1");
+});
+
+test("same-view refreshes replace the cached DOM with the fresh response", () => {
+  const app = setup();
+  const home = app.active();
+  assert.notEqual(app.navigate("/devtools-times/"), home);
+  assert.equal(home.isConnected, false);
+  assert.equal(app.doc.querySelectorAll("[data-cached-view]").length, 1);
+});
+
+test("committed submissions invalidate cached content", () => {
+  const app = setup();
+  const home = app.active();
+  const reports = app.navigate("reports");
+  assert.notEqual(app.navigate("/devtools-times/", new app.window.FormData()), home);
+  assert.equal(home.isConnected, false);
+  assert.equal(reports.isConnected, false);
+  // The outgoing view also contains pre-submission data and must be refreshed.
+  assert.notEqual(app.navigate("reports"), reports);
+});
+
+test("canceled submissions leave previously cached views intact", () => {
+  const app = setup();
+  const home = app.active();
+  app.navigate("reports");
+  app.prepare("signin", new app.window.FormData());
+  assert.equal(app.navigate("/devtools-times/"), home);
+});
