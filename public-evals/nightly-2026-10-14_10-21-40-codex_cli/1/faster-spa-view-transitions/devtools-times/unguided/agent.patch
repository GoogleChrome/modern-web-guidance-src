diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..7bd1b30
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,90 @@
+import type {
+  TransitionBeforePreparationEvent,
+  TransitionBeforeSwapEvent,
+} from "astro:transitions/client";
+
+const MAX_VIEWS = 8;
+const HOST_SELECTOR = "[data-view-cache]";
+const VIEW_SELECTOR = "[data-cached-view]";
+
+// Fragments share a view; query parameters may represent different content.
+export function viewKey(url: URL): string {
+  return url.origin + url.pathname + url.search;
+}
+
+export function installViewCache(doc: Document, maxViews = MAX_VIEWS): void {
+  const initialView = doc.querySelector<HTMLElement>(`${HOST_SELECTOR} > ${VIEW_SELECTOR}`);
+  if (!initialView) return;
+
+  // Keep the live nodes in a persistent host. Detached Astro islands would be
+  // unmounted after a swap, losing the very state we want to preserve.
+  const views = new Map<string, HTMLElement>();
+  let activeKey = viewKey(new URL(doc.location.href));
+  views.set(activeKey, initialView);
+  const refreshes = new WeakSet<AbortSignal>();
+  const invalidations = new WeakSet<AbortSignal>();
+
+  doc.addEventListener("astro:before-preparation", ((event: TransitionBeforePreparationEvent) => {
+    // Same-view navigations and submissions must show the fresh server result.
+    if (event.formData || viewKey(event.from) === viewKey(event.to)) {
+      refreshes.add(event.signal);
+    }
+    // A submission can change data shown by any previously visited view.
+    if (event.formData) invalidations.add(event.signal);
+  }) as EventListener);
+
+  doc.addEventListener("astro:before-swap", ((event: TransitionBeforeSwapEvent) => {
+    const host = doc.querySelector<HTMLElement>(HOST_SELECTOR);
+    const incoming = event.newDocument.querySelector<HTMLElement>(`${HOST_SELECTOR} > ${VIEW_SELECTOR}`);
+    if (!host || !incoming) return;
+
+    const key = viewKey(event.to);
+    const cached = refreshes.has(event.signal) ? undefined : views.get(key);
+    const nextView = cached ?? incoming;
+    const swap = event.swap;
+
+    event.swap = () => {
+      const previous = views.get(activeKey);
+      // Wait until the swap commits so canceled submissions leave views intact.
+      if (invalidations.has(event.signal)) {
+        for (const view of views.values()) {
+          if (view !== previous) view.remove();
+        }
+        views.clear();
+      }
+      if (previous && previous !== nextView) {
+        if (previous.contains(doc.activeElement)) {
+          (doc.activeElement as HTMLElement).blur();
+        }
+        previous.hidden = true;
+        previous.inert = true;
+        // Astro executes scripts after swapping. Scripts belonging to an
+        // inactive view must not run again while another view is being opened.
+        previous.querySelectorAll("script").forEach((script) => {
+          script.dataset.astroExec = "";
+        });
+      }
+      if (invalidations.has(event.signal)) previous?.remove();
+
+      // Astro updates the head, shell, history and persistent host as usual.
+      swap();
+      const replaced = views.get(key);
+      if (replaced && replaced !== nextView) replaced.remove();
+      if (!cached) host.append(nextView);
+      nextView.hidden = false;
+      nextView.inert = false;
+      activeKey = key;
+
+      // Insertion order implements LRU eviction, including the active view.
+      views.delete(key);
+      views.set(key, nextView);
+      while (views.size > Math.max(1, maxViews)) {
+        const oldestKey = views.keys().next().value!;
+        views.get(oldestKey)!.remove();
+        views.delete(oldestKey);
+      }
+    };
+  }) as EventListener);
+}
+
+if (typeof document !== "undefined") installViewCache(document);
