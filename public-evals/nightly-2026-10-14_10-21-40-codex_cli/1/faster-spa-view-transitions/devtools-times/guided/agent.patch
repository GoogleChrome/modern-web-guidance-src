+.spa-views {
+  position: relative;
+}
+
+.spa-view.inactive {
+  content-visibility: hidden;
+  position: absolute;
+  inset: 0 auto auto 0;
+  width: 100%;
+  height: 0;
+  overflow: clip;
+  /* content-visibility hides children, but the container still paints. */
+  background: transparent;
+  border: 0;
+  padding: 0;
+  margin: 0;
+  pointer-events: none;
+}
+
+@supports not (content-visibility: hidden) {
+  .spa-view.inactive {
+    display: none;
+  }
+}
diff --git a/tests/view-cache.test.ts b/tests/view-cache.test.ts
new file mode 100644
index 0000000..e86ab41
--- /dev/null
+++ b/tests/view-cache.test.ts
@@ -0,0 +1,152 @@
+import assert from "node:assert/strict";
+import { afterEach, test } from "node:test";
+import { Window } from "happy-dom";
+import { installViewCache, ViewCache, viewKey } from "../src/scripts/view-cache.ts";
+
+const windows: Window[] = [];
+
+function fixture() {
+  const window = new Window();
+  windows.push(window);
+  window.document.body.innerHTML = `
+    <div data-view-cache data-astro-transition-persist="visited-views">
+      <main data-spa-view class="spa-view" tabindex="-1"><input id="draft"></main>
+    </div>`;
+  const host = window.document.querySelector("[data-view-cache]")!;
+  const initial = host.firstElementChild!;
+  const incoming = () => {
+    const main = window.document.createElement("main");
+    main.setAttribute("data-spa-view", "");
+    main.tabIndex = -1;
+    return main;
+  };
+  return { window, host, initial, incoming };
+}
+
+afterEach(async () => {
+  for (const window of windows.splice(0)) await window.happyDOM.close();
+  Reflect.deleteProperty(globalThis, "document");
+});
+
+test("returning to a view retains its DOM, input state, and event listeners", () => {
+  const { window, host, initial, incoming } = fixture();
+  const cache = new ViewCache(host as unknown as HTMLElement, "/home");
+  const input = initial.querySelector("input")!;
+  input.value = "unfinished draft";
+  let clicks = 0;
+  initial.addEventListener("click", () => clicks++);
+  const next = incoming();
+
+  cache.activate("/article", next as unknown as HTMLElement);
+  assert.equal(initial.isConnected, true);
+  assert.equal(initial.classList.contains("inactive"), true);
+  assert.equal(initial.inert, true);
+  assert.equal(initial.getAttribute("aria-hidden"), "true");
+
+  const restored = cache.activate("/home", incoming() as unknown as HTMLElement);
+  assert.equal(restored, initial);
+  assert.equal(input.value, "unfinished draft");
+  assert.equal(initial.inert, false);
+  assert.equal(initial.hasAttribute("aria-hidden"), false);
+  assert.equal(host.firstElementChild, initial);
+  assert.equal(next.inert, true);
+  initial.dispatchEvent(new window.Event("click"));
+  assert.equal(clicks, 1);
+  assert.equal(host.children.length, 2);
+});
+
+test("the least recently used view is evicted and can be rebuilt", () => {
+  const { host, initial, incoming } = fixture();
+  const cache = new ViewCache(host as unknown as HTMLElement, "/a", 3);
+  const b = incoming();
+  cache.activate("/b", b as unknown as HTMLElement);
+  cache.activate("/c", incoming() as unknown as HTMLElement);
+  cache.activate("/a", incoming() as unknown as HTMLElement);
+  cache.activate("/d", incoming() as unknown as HTMLElement);
+  assert.equal(b.isConnected, false);
+  assert.equal(initial.isConnected, true);
+  assert.equal(host.children.length, 3);
+  const rebuilt = incoming();
+  assert.equal(cache.activate("/b", rebuilt as unknown as HTMLElement), rebuilt);
+  assert.equal(host.children.length, 3);
+});
+
+test("the default cache stays bounded across many dynamic routes", () => {
+  const { host, incoming } = fixture();
+  const cache = new ViewCache(host as unknown as HTMLElement, "/a");
+  for (let i = 0; i < 30; i++) cache.activate(`/articles/${i}`, incoming() as unknown as HTMLElement);
+  assert.equal(host.children.length, 5);
+  assert.equal(host.querySelectorAll(".inactive").length, 4);
+});
+
+test("a refresh replaces stale DOM instead of adding a duplicate entry", () => {
+  const { host, initial, incoming } = fixture();
+  const cache = new ViewCache(host as unknown as HTMLElement, "/home");
+  const fresh = incoming();
+  assert.equal(cache.activate("/home", fresh as unknown as HTMLElement, true), fresh);
+  assert.equal(initial.isConnected, false);
+  assert.equal(host.children.length, 1);
+});
+
+test("fragments share a cache entry while query strings stay distinct", () => {
+  assert.equal(viewKey(new URL("https://example.com/app/news?q=one#heading")), "/app/news?q=one");
+  assert.equal(viewKey(new URL("https://example.com/app/news?q=one#other")), "/app/news?q=one");
+  assert.notEqual(viewKey(new URL("https://example.com/app/news?q=one")), viewKey(new URL("https://example.com/app/news?q=two")));
+});
+
+test("router integration defers changes until swap and focuses the active view", () => {
+  const { window, host, initial } = fixture();
+  Object.defineProperty(globalThis, "document", { configurable: true, value: window.document });
+  installViewCache();
+
+  function navigate(from: string, to: string) {
+    const next = window.document.implementation.createHTMLDocument();
+    next.body.innerHTML = `<div data-view-cache data-astro-transition-persist="visited-views"><main data-spa-view tabindex="-1"></main></div>`;
+    const event = new window.Event("astro:before-swap") as any;
+    Object.assign(event, {
+      from: new URL(from, "https://example.com"),
+      to: new URL(to, "https://example.com"),
+      newDocument: next,
+      // Model Astro's persistent-host contract while replacing the body.
+      swap() {
+        const placeholder = next.querySelector("[data-view-cache]")!;
+        window.document.body.replaceWith(next.body);
+        placeholder.replaceWith(host);
+      },
+    });
+    window.document.dispatchEvent(event);
+    return event;
+  }
+
+  const event = navigate("/home", "/article");
+  assert.equal(host.children.length, 1);
+  assert.equal(initial.classList.contains("inactive"), false);
+  event.swap();
+  window.document.dispatchEvent(new window.Event("astro:after-swap"));
+  assert.equal(host.children.length, 2);
+  assert.equal(window.document.activeElement, host.firstElementChild);
+  assert.equal(initial.isConnected, true);
+
+  navigate("/article", "/home").swap();
+  window.document.dispatchEvent(new window.Event("astro:after-swap"));
+  assert.equal(host.firstElementChild, initial);
+  assert.equal(window.document.activeElement, initial);
+  assert.equal(host.children.length, 2);
+});
+
+test("navigation to a document without a cache host keeps the normal swap", () => {
+  const { window, host } = fixture();
+  Object.defineProperty(globalThis, "document", { configurable: true, value: window.document });
+  installViewCache();
+  const event = new window.Event("astro:before-swap") as any;
+  const swap = () => {};
+  Object.assign(event, {
+    from: new URL("https://example.com/home"),
+    to: new URL("https://example.com/other"),
+    newDocument: window.document.implementation.createHTMLDocument(),
+    swap,
+  });
+  window.document.dispatchEvent(event);
+  assert.equal(event.swap, swap);
+  assert.equal(host.children.length, 1);
+});
