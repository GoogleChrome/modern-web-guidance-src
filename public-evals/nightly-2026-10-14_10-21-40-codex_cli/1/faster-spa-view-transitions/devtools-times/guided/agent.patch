diff --git a/src/scripts/view-cache.ts b/src/scripts/view-cache.ts
new file mode 100644
index 0000000..baac1b9
--- /dev/null
+++ b/src/scripts/view-cache.ts
@@ -0,0 +1,88 @@
+import type { TransitionBeforeSwapEvent } from "astro:transitions/client";
+
+const HOST_SELECTOR = "[data-view-cache]";
+const VIEW_SELECTOR = "[data-spa-view]";
+const MAX_VIEWS = 5;
+
+// Fragments share a view; different query strings may render different content.
+export function viewKey(url: URL): string {
+  return url.pathname + url.search;
+}
+
+export class ViewCache {
+  readonly host: HTMLElement;
+  private views = new Map<string, HTMLElement>();
+  private limit: number;
+
+  constructor(host: HTMLElement, key: string, limit = MAX_VIEWS) {
+    this.host = host;
+    this.limit = Math.max(1, limit);
+    const initial = host.querySelector<HTMLElement>(VIEW_SELECTOR);
+    if (initial) this.views.set(key, initial);
+  }
+
+  activate(key: string, incoming: HTMLElement, refresh = false): HTMLElement {
+    const previous = this.views.get(key);
+    const view = refresh ? incoming : previous ?? incoming;
+    if (previous && previous !== view) previous.remove();
+
+    // Reinserting the key makes this the most recently used entry.
+    this.views.delete(key);
+    this.views.set(key, view);
+    for (const cached of this.views.values()) {
+      const inactive = cached !== view;
+      cached.classList.toggle("inactive", inactive);
+      cached.inert = inactive;
+      if (inactive) cached.setAttribute("aria-hidden", "true");
+      else cached.removeAttribute("aria-hidden");
+    }
+
+    // Keep active content first for fragment targets and document-wide queries.
+    if (this.host.firstElementChild !== view) this.host.prepend(view);
+    while (this.views.size > this.limit) {
+      const oldest = this.views.keys().next().value!;
+      this.views.get(oldest)!.remove();
+      this.views.delete(oldest);
+    }
+    return view;
+  }
+}
+
+export function installViewCache(): void {
+  let cache: ViewCache | undefined;
+  let focusTarget: HTMLElement | undefined;
+
+  document.addEventListener("astro:before-swap", (event) => {
+    const swapEvent = event as TransitionBeforeSwapEvent;
+    const host = document.querySelector<HTMLElement>(HOST_SELECTOR);
+    const incomingHost = swapEvent.newDocument.querySelector<HTMLElement>(HOST_SELECTOR);
+    const incoming = incomingHost?.querySelector<HTMLElement>(VIEW_SELECTOR);
+    if (!host || !incomingHost || !incoming) {
+      cache = undefined;
+      focusTarget = undefined;
+      return;
+    }
+
+    const originalSwap = swapEvent.swap;
+    // Defer mutations until Astro actually swaps, after the outgoing snapshot.
+    swapEvent.swap = () => {
+      if (!cache || cache.host !== host) {
+        cache = new ViewCache(host, viewKey(swapEvent.from));
+      }
+      focusTarget = cache.activate(
+        viewKey(swapEvent.to),
+        incoming,
+        viewKey(swapEvent.from) === viewKey(swapEvent.to),
+      );
+      // Astro moves the persistent host into the new body. Cached islands stay
+      // connected at astro:after-swap, preserving their React state/listeners.
+      originalSwap();
+    };
+  });
+
+  document.addEventListener("astro:after-swap", () => {
+    // Astro owns history and scroll restoration; focusing must not scroll.
+    focusTarget?.focus({ preventScroll: true });
+    focusTarget = undefined;
+  });
+}
