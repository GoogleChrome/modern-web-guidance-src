@@ -0,0 +1,87 @@
+(() => {
+  const views = document.getElementById('views');
+  const home = document.getElementById('view-home');
+  const favorites = home.querySelector('.grid');
+  const pages = new Map([
+    ['/menu', { title: 'Menu', content: '<h1>Our Menu</h1><p>Find your next favorite cup.</p>', favorites: true }],
+    ['/menu/seasonal', { title: 'Maple Oat Latte', content: '<h1>Maple Oat Latte</h1><p>Creamy oat milk with a hint of Vermont maple syrup.</p><a class="btn" href="#/order-online">Order Now</a>' }],
+    ['/menu/espresso', { title: 'Dark Roast Espresso', content: '<h1>Dark Roast Espresso</h1><p>Bold, smokey, and perfect for a morning boost.</p><a class="btn" href="#/order-online">Order Now</a>' }],
+    ['/menu/cold-brew', { title: 'Cold Brew', content: '<h1>Cold Brew</h1><p>Steeped for 18 hours for maximum smoothness.</p><a class="btn" href="#/order-online">Order Now</a>' }],
+    ['/locations', { title: 'Locations', content: '<h1>Locations</h1><p>Visit The Daily Grind for your favorite coffee.</p><p>Store addresses and hours are not available yet.</p>' }],
+    ['/rewards', { title: 'Rewards', content: '<h1>Rewards</h1><p>Your next favorite cup awaits.</p><p>Rewards enrollment is not available yet.</p><a class="btn" href="#/menu">Explore the Menu</a>' }],
+    ['/account', { title: 'My Account', content: '<h1>My Account</h1><p>Account sign-in is not available yet.</p><a class="btn" href="#/rewards">Explore Rewards</a>' }],
+    ['/order-online', { title: 'Order Online', content: '<h1>Order Online</h1><p>Plan your next coffee order. Online checkout is not available yet.</p><label for="drink">Your coffee</label><select id="drink"><option>Maple Oat Latte</option><option>Dark Roast Espresso</option><option>Cold Brew</option></select><label for="notes">Order notes</label><textarea id="notes" rows="3" placeholder="Milk preferences, extras…"></textarea>' }],
+    ['/about', { title: 'Our Story', content: '<h1>Our Story</h1><p>Ethically sourced, locally roasted, delivered to your cup.</p>' }],
+    ['/careers', { title: 'Join the Team', content: '<h1>Join the Team</h1><p>Open positions are not available yet.</p>' }],
+    ['/contact', { title: 'Contact Us', content: '<h1>Contact Us</h1><p>Contact information is not available yet.</p>' }],
+    ['/privacy-policy', { title: 'Privacy', content: '<h1>Privacy</h1><p>A published privacy policy is not available yet.</p>' }],
+    ['/not-found', { title: 'Page Not Found', content: '<h1>Page Not Found</h1><p>This page is not available.</p><a class="btn" href="#/">Back to Home</a>' }],
+  ]);
+
+  // This finite route set bounds the cache. Unknown URLs share one error view.
+  const cache = new Map([['/', { element: home, title: 'Home', x: 0, y: 0 }]]);
+  let activeRoute = '/';
+
+  function getView(route) {
+    if (!cache.has(route)) {
+      const page = pages.get(route);
+      const element = document.createElement('section');
+      element.className = 'spa-view inactive';
+      element.dataset.route = route;
+      element.tabIndex = -1;
+      element.setAttribute('aria-label', page.title);
+      element.setAttribute('aria-hidden', 'true');
+      element.inert = true;
+      const content = document.createElement('div');
+      content.className = 'container view-content';
+      // Only fixed, local page definitions are inserted; URL text is never HTML.
+      content.innerHTML = page.content;
+      if (page.favorites) content.append(favorites.cloneNode(true));
+      element.append(content);
+      views.append(element);
+      cache.set(route, { element, title: page.title, x: 0, y: 0 });
+    }
+    return cache.get(route);
+  }
+
+  function navigate(initial = false) {
+    const requestedRoute = window.location.hash.slice(1) || '/';
+    const route = requestedRoute === '/' || pages.has(requestedRoute)
+      ? requestedRoute
+      : '/not-found';
+    if (!initial && route === activeRoute) return;
+
+    const previous = cache.get(activeRoute);
+    previous.x = window.scrollX;
+    previous.y = window.scrollY;
+    const next = getView(route);
+
+    if (previous !== next) {
+      // Move focus before hiding its former ancestor from assistive technology.
+      next.element.classList.remove('inactive');
+      next.element.inert = false;
+      next.element.setAttribute('aria-hidden', 'false');
+      next.element.focus({ preventScroll: true });
+      previous.element.inert = true;
+      previous.element.setAttribute('aria-hidden', 'true');
+      previous.element.classList.add('inactive');
+    } else {
+      next.element.setAttribute('aria-hidden', 'false');
+    }
+
+    activeRoute = route;
+    document.title = `${next.title} | The Daily Grind`;
+    document.querySelectorAll('nav a[href^="#/"]').forEach(link => {
+      const linkRoute = link.getAttribute('href').slice(1);
+      const current = route === linkRoute || (linkRoute === '/menu' && route.startsWith('/menu/'));
+      if (current) link.setAttribute('aria-current', 'page');
+      else link.removeAttribute('aria-current');
+    });
+    if (!initial) window.scrollTo({ left: next.x, top: next.y, behavior: 'instant' });
+  }
+
+  // Hash routes work on the static host and retain native link/history behavior.
+  if ('scrollRestoration' in window.history) window.history.scrollRestoration = 'manual';
+  window.addEventListener('hashchange', () => navigate());
+  navigate(true);
+})();
