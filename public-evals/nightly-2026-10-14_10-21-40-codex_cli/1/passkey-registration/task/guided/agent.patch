+  <script src="/vendor/webauthn-polyfills.js"></script>
+  <script>
+    (() => {
+      const button = document.querySelector('[data-testid="register-button"]');
+      const status = document.getElementById('register-status');
+      let supported = false;
+      let registering = false;
+      let registered = false;
+
+      async function checkSupport() {
+        if (!window.isSecureContext || !window.PublicKeyCredential ||
+            !navigator.credentials?.create) {
+          status.textContent = 'Passkeys require a supported browser and a secure connection.';
+          return;
+        }
+
+        try {
+          const capabilities = await PublicKeyCredential.getClientCapabilities();
+          // Older browsers cannot report passkeyPlatformAuthenticator. Use their
+          // platform authenticator capability rather than guessing from the UA.
+          const platformAvailable = capabilities.passkeyPlatformAuthenticator ??
+            capabilities.userVerifyingPlatformAuthenticator;
+          supported = Boolean(capabilities.conditionalGet && platformAvailable);
+          button.disabled = !supported;
+          status.textContent = supported ? '' : 'Passkey creation is unavailable on this device. You can still use your usual sign-in.';
+        } catch {
+          status.textContent = 'Unable to check passkey support. Please reload to try again.';
+        }
+      }
+
+      async function postJSON(url, body) {
+        return fetch(url, {
+          method: 'POST',
+          credentials: 'same-origin',
+          mode: 'same-origin',
+          redirect: 'error',
+          cache: 'no-store',
+          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
+          body: JSON.stringify(body),
+        });
+      }
+
+      button.addEventListener('click', async () => {
+        if (!supported || registering || registered) return;
+        registering = true;
+        button.disabled = true;
+        button.setAttribute('aria-busy', 'true');
+        status.textContent = 'Preparing your passkey…';
+
+        try {
+          const optionsResponse = await postJSON('/api/register/options', { promotion: true });
+          if (!optionsResponse.ok) {
+            throw new Error('Unable to start passkey registration. Please try again.');
+          }
+          const optionsJSON = await optionsResponse.json();
+          const publicKey = PublicKeyCredential.parseCreationOptionsFromJSON(optionsJSON);
+          status.textContent = 'Follow your device’s instructions to create your passkey.';
+          const credential = await navigator.credentials.create({ publicKey });
+          if (!credential) {
+            status.textContent = 'Passkey creation was cancelled. You can try again.';
+            return;
+          }
+          const encodedCredential = credential.toJSON();
+
+          status.textContent = 'Verifying your passkey…';
+          try {
+            const verifyResponse = await postJSON('/api/register/verify', encodedCredential);
+            if (!verifyResponse.ok) throw new Error('Verification failed.');
+            const result = await verifyResponse.json();
+            if (result.verified !== true) throw new Error('Verification failed.');
+          } catch {
+            // A created credential must not remain advertised by the password
+            // manager after failed registration. This API is optional.
+            if (typeof PublicKeyCredential.signalUnknownCredential === 'function') {
+              try {
+                await PublicKeyCredential.signalUnknownCredential({
+                  rpId: publicKey.rp.id || window.location.hostname,
+                  credentialId: encodedCredential.id,
+                });
+              } catch {
+                // Synchronization failure must not hide the verification error.
+              }
+            }
+            throw new Error('Unable to verify your passkey. Please try again.');
+          }
+
+          registered = true;
+          button.textContent = 'Passkey created';
+          status.textContent = 'Your passkey is ready to use for your next sign-in.';
+        } catch (error) {
+          const messages = {
+            InvalidStateError: 'A passkey already exists for this account on this authenticator.',
+            NotAllowedError: 'Passkey creation was cancelled or timed out. You can try again.',
+            AbortError: 'Passkey creation was interrupted. You can try again.',
+            SecurityError: 'Passkey creation is unavailable because of a secure connection or site configuration issue.',
+          };
+          // Never render server-provided error content as HTML.
+          status.textContent = messages[error.name] ||
+            (error.name === 'Error' ? error.message : 'Unable to create your passkey. Please try again.');
+        } finally {
+          registering = false;
+          button.disabled = !supported || registered;
+          button.removeAttribute('aria-busy');
+        }
+      });
+
+      checkSupport();
+    })();
+  </script>
