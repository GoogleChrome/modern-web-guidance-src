@@ -206,7 +290,77 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const offers = [
+      ['An Afternoon Pick-Me-Up', 'Save 20% on a cold brew between 2 p.m. and 4 p.m.'],
+      ['Coffee Tastes Better Together', 'Buy one latte and get a second latte half price.'],
+      ['Bring Your Favorite Cup', 'Bring a reusable cup and save on your next coffee.']
+    ];
+    let nextOffer = 0;
+
+    function updateControls() {
+      removeBtn.disabled = !domContainer.querySelector('.card:not([data-closing])');
+      toggleBtn.disabled = !toggleCard.isConnected || toggleCard.hasAttribute('data-closing');
+    }
+
+    addBtn.addEventListener('click', () => {
+      const [title, description] = offers[nextOffer++ % offers.length];
+      const card = document.createElement('article');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = title;
+      const paragraph = document.createElement('p');
+      paragraph.textContent = description;
+      card.append(heading, paragraph);
+      domContainer.append(card);
+
+      // Older browsers need an explicit entry animation instead of @starting-style.
+      if (!('CSSStartingStyleRule' in window)) {
+        card.animate([
+          { opacity: 0, transform: reducedMotion.matches ? 'none' : 'scale(0.92)' },
+          { opacity: 1, transform: reducedMotion.matches ? 'none' : 'scale(1)' }
+        ], { duration: reducedMotion.matches ? 100 : 280, easing: 'ease' });
+      }
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const cards = domContainer.querySelectorAll('.card:not([data-closing])');
+      const card = cards[cards.length - 1];
+      if (!card) return;
+
+      // Keep the card rendered during its exit, including in browsers that
+      // cannot transition display: none. Hidden cards can be removed immediately.
+      if (!card.hidden) {
+        getComputedStyle(card).opacity;
+        card.setAttribute('data-closing', '');
+        updateControls();
+        const animations = card.getAnimations();
+        let timeout;
+        await Promise.race([
+          Promise.allSettled(animations.map(animation => animation.finished)),
+          new Promise(resolve => { timeout = setTimeout(resolve, 1000); })
+        ]);
+        clearTimeout(timeout);
+      }
+      card.remove();
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      toggleCard.toggleAttribute('hidden');
+      toggleBtn.setAttribute('aria-expanded', String(!toggleCard.hidden));
+      toggleBtn.textContent = toggleCard.hidden ? 'Show Featured Promo' : 'Hide Featured Promo';
+    });
+  </script>
+
 </body>
 
