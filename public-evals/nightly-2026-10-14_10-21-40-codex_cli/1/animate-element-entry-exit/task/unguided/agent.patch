+  <script>
+    const domContainer = document.getElementById('domContainer');
+    const addBtn = document.getElementById('addBtn');
+    const removeBtn = document.getElementById('removeBtn');
+    const toggleBtn = document.getElementById('toggleBtn');
+    const toggleCard = document.getElementById('toggleCard');
+    let promoCount = 0;
+    let removing = false;
+
+    function updateControls() {
+      removeBtn.disabled = removing || !domContainer.lastElementChild;
+      toggleBtn.disabled = !domContainer.contains(toggleCard);
+    }
+
+    function animateCard(card, entering) {
+      if (card.hidden || !card.animate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
+        return Promise.resolve();
+      }
+
+      const frames = [
+        { opacity: 0, transform: 'scale(0.9)' },
+        { opacity: 1, transform: 'scale(1)' }
+      ];
+      const animation = card.animate(entering ? frames : frames.slice().reverse(), {
+        duration: 280,
+        easing: 'ease-in-out',
+        fill: entering ? 'none' : 'forwards'
+      });
+      return animation.finished.catch(() => {});
+    }
+
+    addBtn.addEventListener('click', () => {
+      const card = document.createElement('div');
+      card.className = 'card';
+      const heading = document.createElement('h3');
+      heading.textContent = `Freshly Brewed Offer ${++promoCount}`;
+      const description = document.createElement('p');
+      description.textContent = 'Make time for your favorite roast and a freshly baked treat.';
+      const link = document.createElement('a');
+      link.className = 'btn';
+      link.href = '/order-online';
+      link.textContent = 'Explore the Menu';
+      card.append(heading, description, link);
+      domContainer.append(card);
+      animateCard(card, true);
+      updateControls();
+    });
+
+    removeBtn.addEventListener('click', async () => {
+      const card = domContainer.lastElementChild;
+      if (!card || removing) return;
+      removing = true;
+      updateControls();
+      // Finish any entrance animation before starting the exit transition.
+      card.getAnimations?.().forEach(animation => animation.cancel());
+      await animateCard(card, false);
+      card.remove();
+      removing = false;
+      updateControls();
+    });
+
+    toggleBtn.addEventListener('click', () => {
+      const hidden = toggleCard.toggleAttribute('hidden');
+      toggleBtn.setAttribute('aria-expanded', String(!hidden));
+      toggleBtn.textContent = hidden ? 'Show Featured Promo' : 'Hide Featured Promo';
+    });
+
+    updateControls();
+  </script>
+
 </body>
 
