+  <script>
+    const detailsDialog = document.getElementById('coffee-details');
+    const detailsTitle = document.getElementById('coffee-details-title');
+    const detailsDescription = document.getElementById('coffee-details-description');
+
+    document.querySelectorAll('.show-details').forEach((button) => {
+      button.addEventListener('click', () => {
+        const card = button.closest('.card');
+        detailsTitle.textContent = card.querySelector('h3').textContent;
+        detailsDescription.textContent = card.querySelector('p').textContent;
+        detailsDialog.showModal();
+      });
+    });
+
+    // Older browsers support modal dialogs but need an outside-click fallback.
+    if (!('closedBy' in HTMLDialogElement.prototype)) {
+      detailsDialog.addEventListener('click', (event) => {
+        if (event.target !== detailsDialog) return;
+
+        const bounds = detailsDialog.getBoundingClientRect();
+        const isInside = event.clientX >= bounds.left && event.clientX <= bounds.right &&
+          event.clientY >= bounds.top && event.clientY <= bounds.bottom;
+
+        if (!isInside) detailsDialog.close();
+      });
+    }
+  </script>
