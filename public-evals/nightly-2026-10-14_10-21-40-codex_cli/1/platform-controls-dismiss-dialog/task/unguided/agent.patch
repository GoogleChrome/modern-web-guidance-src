+  <script>
+    const coffeeDialog = document.getElementById('coffee-details');
+    const coffeeHeading = document.getElementById('coffee-details-heading');
+    const coffeeDescription = document.getElementById('coffee-details-description');
+
+    document.querySelectorAll('.show-details').forEach((button) => {
+      button.addEventListener('click', () => {
+        const card = button.closest('.card');
+        coffeeHeading.textContent = card.querySelector('h3').textContent;
+        coffeeDescription.textContent = card.querySelector('p').textContent;
+        coffeeDialog.showModal();
+      });
+    });
+
+    // Require both ends of a click to be outside so dragging from inside won't close it.
+    let pointerStartedOutside = false;
+    const isOutsideDialog = (event) => {
+      const bounds = coffeeDialog.getBoundingClientRect();
+      return event.clientX < bounds.left || event.clientX > bounds.right ||
+        event.clientY < bounds.top || event.clientY > bounds.bottom;
+    };
+
+    coffeeDialog.addEventListener('pointerdown', (event) => {
+      pointerStartedOutside = isOutsideDialog(event);
+    });
+
+    coffeeDialog.addEventListener('click', (event) => {
+      if (pointerStartedOutside && isOutsideDialog(event)) {
+        coffeeDialog.close();
+      }
+      pointerStartedOutside = false;
+    });
+    // Native modal dialogs handle Escape, contain focus, and restore it to the opener.
+  </script>
