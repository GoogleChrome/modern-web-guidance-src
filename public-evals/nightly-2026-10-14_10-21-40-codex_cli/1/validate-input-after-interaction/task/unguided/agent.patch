@@ -206,7 +273,43 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = document.querySelector('#newsletter-email');
+    const error = document.querySelector('#newsletter-error');
+    const status = document.querySelector('#newsletter-status');
+
+    function clearFeedback() {
+      email.removeAttribute('aria-invalid');
+      error.textContent = '';
+      status.hidden = true;
+      status.textContent = '';
+    }
+
+    // Hide old errors throughout editing; check the address only on blur.
+    email.addEventListener('focus', clearFeedback);
+    email.addEventListener('input', clearFeedback);
+    email.addEventListener('blur', () => {
+      const valid = email.validity.valid;
+      email.setAttribute('aria-invalid', String(!valid));
+      error.textContent = valid ? '' : email.validity.valueMissing
+        ? 'Please enter your email address.'
+        : 'Please enter a valid email address, like you@example.com.';
+    });
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      // Enter also ends editing and triggers the same blur validation.
+      if (document.activeElement === email) email.blur();
+      if (!email.validity.valid) return;
+
+      // Replace this message with the signup request when a service is connected.
+      status.textContent = 'Newsletter signup is not available yet. Please check back soon.';
+      status.hidden = false;
+    });
+  </script>
+
 </body>
 
 </html>
