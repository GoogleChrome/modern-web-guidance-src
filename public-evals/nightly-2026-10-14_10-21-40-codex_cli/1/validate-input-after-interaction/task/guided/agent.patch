@@ -206,7 +284,44 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    const newsletter = document.querySelector('.newsletter');
+    const email = newsletter.elements.email;
+    const error = document.querySelector('#newsletter-error');
+    const status = newsletter.querySelector('.newsletter-status');
+
+    function clearError() {
+      email.removeAttribute('aria-invalid');
+      error.hidden = true;
+      error.textContent = '';
+    }
+
+    email.addEventListener('focus', clearError);
+    email.addEventListener('input', () => {
+      clearError();
+      status.textContent = '';
+    });
+
+    email.addEventListener('blur', () => {
+      const invalid = !email.validity.valid;
+      email.setAttribute('aria-invalid', String(invalid));
+      error.textContent = invalid ? 'Please enter a valid email address, like you@example.com.' : '';
+      error.hidden = !invalid;
+    });
+
+    newsletter.addEventListener('submit', (event) => {
+      event.preventDefault();
+      if (!email.validity.valid) {
+        email.focus();
+        return;
+      }
+
+      // Connect a newsletter service before confirming a subscription.
+      status.textContent = 'Newsletter signup is not available yet. Please check back soon.';
+    });
+  </script>
+
 </body>
 
 </html>
