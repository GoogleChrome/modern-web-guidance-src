+  <script>
+    // Keep every picker part branded where customizable selects are unavailable.
+    if (!window.CSS || !CSS.supports('appearance', 'base-select')) {
+      const select = document.getElementById('coffee-roast');
+      const control = select.parentElement;
+      const trigger = document.createElement('button');
+      trigger.type = 'button';
+      trigger.id = 'roast-trigger';
+      trigger.className = 'roast-trigger';
+      trigger.setAttribute('aria-haspopup', 'listbox');
+      trigger.setAttribute('aria-expanded', 'false');
+      trigger.setAttribute('aria-controls', 'roast-options');
+      trigger.setAttribute('aria-labelledby', 'roast-label roast-value');
+      const value = document.createElement('span');
+      value.id = 'roast-value';
+      const arrow = document.createElement('span');
+      arrow.className = 'roast-arrow';
+      arrow.setAttribute('aria-hidden', 'true');
+      trigger.append(value, arrow);
+
+      const list = document.createElement('ul');
+      list.id = 'roast-options';
+      list.className = 'roast-options';
+      list.setAttribute('role', 'listbox');
+      list.setAttribute('aria-labelledby', 'roast-label');
+      list.hidden = true;
+      const options = Array.from(select.options, (option, index) => {
+        const item = document.createElement('li');
+        item.textContent = option.textContent;
+        item.setAttribute('role', 'option');
+        item.tabIndex = -1;
+        item.addEventListener('click', () => choose(index));
+        list.append(item);
+        return item;
+      });
+
+      function syncSelection() {
+        value.textContent = select.options[select.selectedIndex].textContent;
+        options.forEach((option, index) => {
+          option.setAttribute('aria-selected', String(index === select.selectedIndex));
+        });
+      }
+
+      function close(restoreFocus = false) {
+        list.hidden = true;
+        trigger.setAttribute('aria-expanded', 'false');
+        if (restoreFocus) trigger.focus();
+      }
+
+      function open(index = select.selectedIndex) {
+        list.hidden = false;
+        trigger.setAttribute('aria-expanded', 'true');
+        options[index].focus();
+      }
+
+      function choose(index) {
+        select.selectedIndex = index;
+        select.dispatchEvent(new Event('change', { bubbles: true }));
+        close(true);
+      }
+
+      trigger.addEventListener('click', () => list.hidden ? open() : close());
+      trigger.addEventListener('keydown', (event) => {
+        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+          event.preventDefault();
+          open(event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1 : select.selectedIndex);
+        }
+      });
+      list.addEventListener('keydown', (event) => {
+        const index = options.indexOf(document.activeElement);
+        if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+          event.preventDefault();
+          const next = event.key === 'Home' ? 0 : event.key === 'End' ? options.length - 1
+            : (index + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
+          options[next].focus();
+        } else if (event.key === 'Enter' || event.key === ' ') {
+          event.preventDefault();
+          choose(index);
+        } else if (event.key === 'Escape') {
+          event.preventDefault();
+          close(true);
+        } else if (event.key === 'Tab') {
+          // Restore the trigger before the browser advances to the next control.
+          close(true);
+        } else if (event.key.length === 1) {
+          const match = options.find(option => option.textContent.toLowerCase().startsWith(event.key.toLowerCase()));
+          if (match) {
+            event.preventDefault();
+            match.focus();
+          }
+        }
+      });
+      document.addEventListener('pointerdown', (event) => {
+        if (!control.contains(event.target)) close();
+      });
+      control.addEventListener('focusout', (event) => {
+        if (!control.contains(event.relatedTarget)) close();
+      });
+      select.addEventListener('change', syncSelection);
+      syncSelection();
+      control.append(trigger, list);
+      select.hidden = true;
+      document.getElementById('roast-label').htmlFor = trigger.id;
+    }
+  </script>
