+  <script>
+    const selector = document.querySelector('.roast-selector');
+    const trigger = document.getElementById('roast-trigger');
+    const list = document.getElementById('roast-options');
+    const options = Array.from(list.querySelectorAll('[role="option"]'));
+    let selectedIndex = 1;
+    let activeIndex = selectedIndex;
+
+    function setActive(index) {
+      activeIndex = index;
+      options.forEach((option, i) => option.classList.toggle('active', i === index));
+      trigger.setAttribute('aria-activedescendant', options[index].id);
+    }
+
+    function setOpen(open) {
+      list.hidden = !open;
+      trigger.setAttribute('aria-expanded', String(open));
+      if (open) setActive(selectedIndex);
+      else trigger.removeAttribute('aria-activedescendant');
+    }
+
+    function selectRoast(index) {
+      selectedIndex = index;
+      options.forEach((option, i) => option.setAttribute('aria-selected', String(i === index)));
+      document.getElementById('roast-value').textContent = options[index].childNodes[0].textContent.trim();
+      document.getElementById('coffee-roast').value = options[index].dataset.value;
+      setOpen(false);
+      trigger.focus();
+    }
+
+    trigger.addEventListener('click', () => setOpen(list.hidden));
+    trigger.addEventListener('keydown', (event) => {
+      if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
+        event.preventDefault();
+        const wasClosed = list.hidden;
+        if (wasClosed) setOpen(true);
+        if (event.key === 'Home') setActive(0);
+        else if (event.key === 'End') setActive(options.length - 1);
+        else if (!wasClosed) setActive((activeIndex + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length);
+      } else if (event.key === 'Enter' || event.key === ' ') {
+        event.preventDefault();
+        if (list.hidden) setOpen(true);
+        else selectRoast(activeIndex);
+      } else if (event.key === 'Escape') {
+        event.preventDefault();
+        setOpen(false);
+      } else if (event.key === 'Tab') {
+        setOpen(false);
+      } else if (/^[a-z]$/i.test(event.key)) {
+        const index = options.findIndex(option => option.dataset.value.startsWith(event.key.toLowerCase()));
+        if (index !== -1) {
+          event.preventDefault();
+          if (list.hidden) setOpen(true);
+          setActive(index);
+        }
+      }
+    });
+    options.forEach((option, index) => {
+      option.addEventListener('click', () => selectRoast(index));
+      option.addEventListener('pointermove', () => setActive(index));
+    });
+    document.addEventListener('click', (event) => {
+      if (!selector.contains(event.target)) setOpen(false);
+    });
+    selector.addEventListener('focusout', (event) => {
+      if (!selector.contains(event.relatedTarget)) setOpen(false);
+    });
+  </script>
