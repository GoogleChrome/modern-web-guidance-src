+  <script>
+    const rewardsLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeTourButton = tourStep.querySelector('button');
+    const supportsPopover = 'popover' in HTMLElement.prototype;
+    const supportsAnchors = CSS.supports('anchor-name: --rewards') &&
+      CSS.supports('top: anchor(bottom)') && CSS.supports('left: anchor(center)');
+    let tourOpen = true;
+    let positionFrame;
+
+    // Track layout shifts as well as scrolling and resizing in older browsers.
+    function trackRewardsLink() {
+      if (!tourOpen) return;
+      const linkRect = rewardsLink.getBoundingClientRect();
+      const tourRect = tourStep.getBoundingClientRect();
+      const left = Math.max(12, Math.min(
+        linkRect.left + linkRect.width / 2 - tourRect.width / 2,
+        document.documentElement.clientWidth - tourRect.width - 12
+      ));
+      tourStep.style.left = `${left}px`;
+      tourStep.style.top = `${linkRect.bottom + 12}px`;
+      positionFrame = requestAnimationFrame(trackRewardsLink);
+    }
+
+    function preventTourNavigation(event) {
+      if (tourOpen) event.preventDefault();
+    }
+
+    rewardsLink.addEventListener('click', preventTourNavigation);
+    rewardsLink.addEventListener('auxclick', preventTourNavigation);
+
+    closeTourButton.addEventListener('click', (event) => {
+      event.preventDefault();
+      tourOpen = false;
+      cancelAnimationFrame(positionFrame);
+      if (supportsPopover) tourStep.hidePopover();
+      else tourStep.hidden = true;
+      rewardsLink.focus({ preventScroll: true });
+    });
+
+    tourStep.hidden = false;
+    if (supportsPopover) tourStep.showPopover();
+    else tourStep.classList.add('tour-fallback');
+    if (!supportsPopover || !supportsAnchors) trackRewardsLink();
+    closeTourButton.focus({ preventScroll: true });
+  </script>
 </body>
 
