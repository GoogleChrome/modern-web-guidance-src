+  <script>
+    (() => {
+      const button = document.getElementById('summarize-button');
+      const status = document.getElementById('journal-status');
+      const summaryPanel = document.getElementById('journal-summary');
+      const points = document.getElementById('summary-points');
+      const options = {
+        type: 'key-points',
+        format: 'plain-text',
+        length: 'short',
+        expectedInputLanguages: ['en'],
+        outputLanguage: 'en',
+        monitor(monitor) {
+          monitor.addEventListener('downloadprogress', (event) => {
+            const progress = event.total ? event.loaded / event.total : event.loaded;
+            status.textContent = `Downloading your browser's AI model: ${Math.round(progress * 100)}%. The first use may take a few minutes.`;
+          });
+        },
+      };
+
+      async function checkAvailability() {
+        if (!window.isSecureContext || !('Summarizer' in window)) {
+          status.textContent = "Native AI summaries aren't supported in this browser. Try a supported desktop browser over HTTPS; you can still read the full journal above.";
+          return;
+        }
+
+        try {
+          const availability = await Summarizer.availability(options);
+          if (availability === 'unavailable') {
+            status.textContent = "Your browser's AI summarizer isn't available on this device. You can still read the full journal above.";
+            return;
+          }
+          button.disabled = false;
+          status.textContent = availability === 'available'
+            ? 'Get a few key points using AI on your device.'
+            : "On first use, your browser may download its AI model. The summary is generated on your device.";
+        } catch {
+          status.textContent = "Couldn't check your browser's AI availability. Select Summarize to try again.";
+          button.disabled = false;
+        }
+      }
+
+      button.addEventListener('click', async () => {
+        button.disabled = true;
+        button.textContent = 'Summarizing…';
+        summaryPanel.setAttribute('aria-busy', 'true');
+        status.textContent = "Preparing your browser's AI summarizer…";
+        let summarizer;
+
+        try {
+          // Create directly from the click so a model download retains user activation.
+          summarizer = await Summarizer.create(options);
+          status.textContent = 'Summarizing the journal on your device…';
+          const text = document.getElementById('journal-text').innerText;
+          const summary = await summarizer.summarize(text);
+          const bullets = summary.split(/\r?\n/)
+            .map(line => line.replace(/^\s*(?:[-*•]\s+|\d+[.)]\s+)/, '').trim())
+            .filter(Boolean);
+          if (!bullets.length) throw new Error('Empty summary');
+
+          points.replaceChildren(...bullets.map(text => {
+            const item = document.createElement('li');
+            item.textContent = text;
+            return item;
+          }));
+          summaryPanel.hidden = false;
+          status.textContent = 'Your AI summary is ready. Read the journal above for the full story.';
+        } catch (error) {
+          status.textContent = error.name === 'NotAllowedError'
+            ? 'Your browser could not start its AI model. Select Summarize again to retry, or open this page directly if it is embedded.'
+            : "Couldn't generate a summary. Check that your browser supports native AI and has enough space for its model, then try again.";
+        } finally {
+          if (summarizer) summarizer.destroy();
+          summaryPanel.setAttribute('aria-busy', 'false');
+          button.disabled = false;
+          button.textContent = 'Summarize';
+        }
+      });
+
+      checkAvailability();
+    })();
+  </script>
+
 </body>
 
