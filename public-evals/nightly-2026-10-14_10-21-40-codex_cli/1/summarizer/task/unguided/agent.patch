+  <script>
+    const summarizeButton = document.getElementById('summarize-button');
+    const summaryStatus = document.getElementById('summary-status');
+    const summaryPanel = document.getElementById('journal-summary');
+    const summaryPoints = document.getElementById('summary-points');
+
+    summarizeButton.addEventListener('click', async () => {
+      if (!('Summarizer' in window)) {
+        summaryStatus.textContent = 'Built-in AI summaries are not available in this browser. Try a supported desktop Chrome browser.';
+        return;
+      }
+
+      summarizeButton.disabled = true;
+      summarizeButton.textContent = 'Summarizing…';
+      summaryPanel.setAttribute('aria-busy', 'true');
+      summaryStatus.textContent = 'Preparing your browser’s AI. The first use may need a model download.';
+      let summarizer;
+
+      try {
+        // Create directly in the click handler to preserve user activation for downloads.
+        summarizer = await window.Summarizer.create({
+          type: 'key-points',
+          format: 'plain-text',
+          length: 'short',
+          expectedInputLanguages: ['en'],
+          outputLanguage: 'en',
+          monitor(monitor) {
+            monitor.addEventListener('downloadprogress', (event) => {
+              summaryStatus.textContent = `Downloading your browser’s AI model… ${Math.round(event.loaded * 100)}%`;
+            });
+          }
+        });
+        summaryStatus.textContent = 'Reading the journal and gathering the key points…';
+        const summary = await summarizer.summarize(document.getElementById('journal-text').innerText);
+        const points = summary.trim().split(/\n\s*(?=[•*\-] |\d+[.)] )/)
+          .map(point => point.replace(/^\s*(?:[•*\-]|\d+[.)])\s+/, '').replace(/\s*\n\s*/g, ' ').trim())
+          .filter(Boolean);
+        if (!points.length) throw new Error('Empty summary');
+
+        summaryPoints.replaceChildren(...points.map(point => {
+          const item = document.createElement('li');
+          item.textContent = point;
+          return item;
+        }));
+        summaryPanel.hidden = false;
+        summaryStatus.textContent = 'Summary ready. Generated by AI on your device.';
+      } catch (error) {
+        summaryStatus.textContent = error.name === 'NotSupportedError'
+          ? 'Built-in AI is unavailable on this device. Try a supported desktop Chrome browser.'
+          : 'Your browser couldn’t create a summary. Please try again; a first-time model download may need an internet connection.';
+      } finally {
+        if (summarizer) summarizer.destroy();
+        summarizeButton.disabled = false;
+        summarizeButton.textContent = 'Summarize';
+        summaryPanel.setAttribute('aria-busy', 'false');
+      }
+    });
+  </script>
+
