+        <button id="summarize-button" class="btn" type="button" aria-controls="journal-summary" aria-describedby="summary-status">Summarize</button>
+        <p id="summary-status" class="journal-status" role="status" aria-live="polite">Short on time? Get a few key points with your browser's built-in AI.</p>
+      </div>
+      <div id="journal-summary" class="journal-summary" role="region" aria-labelledby="summary-title" aria-busy="false" hidden>
+        <h3 id="summary-title">Our sourcing, at a glance</h3>
+        <ul id="summary-points"></ul>
+      </div>
+    </section>
