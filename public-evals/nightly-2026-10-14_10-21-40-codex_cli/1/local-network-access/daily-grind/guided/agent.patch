diff --git a/local-network.mjs b/local-network.mjs
new file mode 100644
index 0000000..18e27d4
--- /dev/null
+++ b/local-network.mjs
@@ -0,0 +1,53 @@
+export async function queryNetworkPermission(addressSpace) {
+  if (!['local', 'loopback'].includes(addressSpace)) {
+    throw new Error('Choose a local network or loopback resource.');
+  }
+  try {
+    return await navigator.permissions.query({ name: `${addressSpace}-network` });
+  } catch {
+    // Unsupported permission names and browsers without the Permissions API
+    // still allow a connection attempt initiated by the user.
+    return null;
+  }
+}
+
+export async function readLocalResource(urlValue, addressSpace) {
+  const url = new URL(urlValue);
+  if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) {
+    throw new Error('Enter an HTTP or HTTPS URL without embedded credentials.');
+  }
+  if (!globalThis.isSecureContext) {
+    throw new Error('Open this website over HTTPS (or localhost for development) to connect to local resources.');
+  }
+  const permission = await queryNetworkPermission(addressSpace);
+  if (permission?.state === 'denied') {
+    throw new Error(`Allow ${addressSpace === 'local' ? 'Local network' : 'Loopback network'} access in your browser’s site settings, then try again.`);
+  }
+
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 15000);
+  try {
+    const response = await fetch(url.href, {
+      method: 'GET',
+      mode: 'cors',
+      credentials: 'omit',
+      redirect: 'error',
+      targetAddressSpace: addressSpace,
+      signal: controller.signal,
+    });
+    if (!response.ok) {
+      throw new Error(`The resource returned HTTP ${response.status}. Check the URL and local service.`);
+    }
+    return await response.text();
+  } catch (error) {
+    if (error.name === 'AbortError') {
+      throw new Error('The connection timed out. Check that the service is running and reachable.');
+    }
+    if (error instanceof TypeError) {
+      throw new Error('Could not read the resource. Check the URL and resource location, that the service is running on this computer or network, browser site permissions, and the service’s CORS settings. Your browser must also support connections to HTTP local resources from HTTPS pages.');
+    }
+    throw error;
+  } finally {
+    clearTimeout(timeout);
+  }
+}
diff --git a/local-network.test.mjs b/local-network.test.mjs
new file mode 100644
index 0000000..87aa30c
--- /dev/null
+++ b/local-network.test.mjs
@@ -0,0 +1,66 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readLocalResource } from './local-network.mjs';
+
+function setup(t, permissionQuery, fetchHandler) {
+  const originalNavigator = Object.getOwnPropertyDescriptor(globalThis, 'navigator');
+  const originalSecureContext = Object.getOwnPropertyDescriptor(globalThis, 'isSecureContext');
+  Object.defineProperty(globalThis, 'navigator', {
+    configurable: true,
+    value: { permissions: { query: permissionQuery } },
+  });
+  Object.defineProperty(globalThis, 'isSecureContext', { configurable: true, value: true });
+  t.mock.method(globalThis, 'fetch', fetchHandler);
+  t.after(() => {
+    if (originalNavigator) Object.defineProperty(globalThis, 'navigator', originalNavigator);
+    else delete globalThis.navigator;
+    if (originalSecureContext) Object.defineProperty(globalThis, 'isSecureContext', originalSecureContext);
+    else delete globalThis.isSecureContext;
+  });
+}
+
+for (const space of ['local', 'loopback']) {
+  test(`reads a ${space} resource with the matching permission and address space`, async (t) => {
+    setup(t, async ({ name }) => {
+      assert.equal(name, `${space}-network`);
+      return { state: 'granted' };
+    }, async (url, options) => {
+      assert.equal(url, 'http://localhost:8080/health');
+      assert.equal(options.targetAddressSpace, space);
+      assert.equal(options.mode, 'cors');
+      assert.equal(options.credentials, 'omit');
+      assert.equal(options.redirect, 'error');
+      assert.ok(options.signal instanceof AbortSignal);
+      return new Response('ready');
+    });
+    assert.equal(await readLocalResource('http://localhost:8080/health', space), 'ready');
+  });
+}
+
+test('denied permission prevents a network request and explains recovery', async (t) => {
+  setup(t, async () => ({ state: 'denied' }), () => assert.fail('must not fetch'));
+  await assert.rejects(readLocalResource('http://localhost:8080', 'loopback'), /site settings/);
+});
+
+test('unsupported permission queries still attempt a user-requested connection', async (t) => {
+  setup(t, async () => { throw new TypeError('unsupported permission'); }, async () => new Response('ready'));
+  assert.equal(await readLocalResource('http://localhost:8080', 'loopback'), 'ready');
+});
+
+test('insecure contexts and non-HTTP URLs do not initiate requests', async (t) => {
+  setup(t, () => assert.fail('must not query'), () => assert.fail('must not fetch'));
+  await assert.rejects(readLocalResource('file:///etc/hosts', 'loopback'), /HTTP or HTTPS/);
+  await assert.rejects(readLocalResource('http://user:password@localhost', 'loopback'), /credentials/);
+  Object.defineProperty(globalThis, 'isSecureContext', { configurable: true, value: false });
+  await assert.rejects(readLocalResource('http://localhost:8080', 'loopback'), /HTTPS/);
+});
+
+test('network failures include permission and CORS remediation', async (t) => {
+  setup(t, async () => ({ state: 'prompt' }), async () => { throw new TypeError('failed to fetch'); });
+  await assert.rejects(readLocalResource('http://localhost:8080', 'loopback'), /CORS settings/);
+});
+
+test('HTTP errors are reported as unsuccessful connections', async (t) => {
+  setup(t, async () => ({ state: 'granted' }), async () => new Response('missing', { status: 404 }));
+  await assert.rejects(readLocalResource('http://localhost:8080', 'loopback'), /HTTP 404/);
+});
diff --git a/local-resource.mjs b/local-resource.mjs
new file mode 100644
index 0000000..439d4aa
--- /dev/null
+++ b/local-resource.mjs
@@ -0,0 +1,36 @@
+import { readLocalResource } from './local-network.mjs';
+
+const form = document.querySelector('#local-resource-form');
+const location = document.querySelector('#address-space');
+const url = document.querySelector('#resource-url');
+const button = document.querySelector('#connect-resource');
+const status = document.querySelector('#resource-status');
+const result = document.querySelector('#resource-result');
+
+location.addEventListener('change', () => {
+  url.placeholder = location.value === 'local'
+    ? 'http://192.168.1.100:8080/status'
+    : 'http://localhost:8080/health';
+});
+
+form.addEventListener('submit', async (event) => {
+  event.preventDefault();
+  if (button.disabled) return;
+  button.disabled = true;
+  status.textContent = 'Connecting… If prompted, allow access to your local resource.';
+  result.hidden = true;
+  result.textContent = '';
+  try {
+    const text = await readLocalResource(url.value, location.value);
+    // Treat local responses as text, never as executable HTML.
+    result.textContent = text.slice(0, 20000);
+    result.hidden = false;
+    status.textContent = text.length > 20000
+      ? 'Connected. Showing the first 20,000 characters of the response.'
+      : 'Connected. Resource response received.';
+  } catch (error) {
+    status.textContent = error.message;
+  } finally {
+    button.disabled = false;
+  }
+});
