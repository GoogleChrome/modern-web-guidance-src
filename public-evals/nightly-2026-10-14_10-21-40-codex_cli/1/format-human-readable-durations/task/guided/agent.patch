+  <script type="module">
+    const hoursInput = document.getElementById('hoursInput');
+    const minutesInput = document.getElementById('minutesInput');
+    const humanValue = document.getElementById('humanValue');
+    const unitOptions = document.querySelectorAll('input[name="largestUnit"]');
+    const locale = navigator.languages?.length ? navigator.languages : navigator.language;
+    const durationFormatter = typeof Intl.DurationFormat === 'function'
+      ? new Intl.DurationFormat(locale, { style: 'long' }) : null;
+    const unitFormatters = {
+      hours: new Intl.NumberFormat(locale, { style: 'unit', unit: 'hour', unitDisplay: 'long' }),
+      minutes: new Intl.NumberFormat(locale, { style: 'unit', unit: 'minute', unitDisplay: 'long' })
+    };
+    const listFormatter = new Intl.ListFormat(locale, { style: 'long', type: 'conjunction' });
+    let temporal = globalThis.Temporal;
+
+    function updateDuration() {
+      if (!hoursInput.validity.valid || !minutesInput.validity.valid) {
+        humanValue.textContent = 'Enter whole numbers from 0 to 1,000,000.';
+        return;
+      }
+      const hours = hoursInput.value === '' ? 0 : hoursInput.valueAsNumber;
+      const minutes = minutesInput.value === '' ? 0 : minutesInput.valueAsNumber;
+      const largestUnit = document.querySelector('input[name="largestUnit"]:checked').value;
+      const totalMinutes = hours * 60 + minutes;
+      // Keep the calculator usable while the optional Temporal polyfill loads.
+      const balanced = temporal
+        ? temporal.Duration.from({ hours, minutes }).round({ largestUnit, smallestUnit: 'minutes' })
+        : { hours: largestUnit === 'hours' ? Math.floor(totalMinutes / 60) : 0,
+            minutes: largestUnit === 'hours' ? totalMinutes % 60 : totalMinutes };
+      const duration = { hours: balanced.hours, minutes: balanced.minutes };
+      if (durationFormatter && totalMinutes > 0) {
+        humanValue.textContent = durationFormatter.format(duration);
+      } else {
+        const parts = [];
+        if (duration.hours) parts.push(unitFormatters.hours.format(duration.hours));
+        if (duration.minutes || !parts.length) parts.push(unitFormatters.minutes.format(duration.minutes));
+        humanValue.textContent = listFormatter.format(parts);
+      }
+    }
+
+    hoursInput.addEventListener('input', updateDuration);
+    minutesInput.addEventListener('input', updateDuration);
+    unitOptions.forEach(option => option.addEventListener('change', updateDuration));
+    updateDuration();
+    if (!temporal) {
+      import('https://esm.sh/@js-temporal/polyfill@0.5.1')
+        .then(module => { temporal = module.Temporal; updateDuration(); })
+        .catch(() => { /* Arithmetic and Intl formatting remain available offline. */ });
+    }
+  </script>
+
