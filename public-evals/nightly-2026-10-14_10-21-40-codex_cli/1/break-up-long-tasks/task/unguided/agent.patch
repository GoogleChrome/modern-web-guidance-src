+  <script>
+    const startButton = document.getElementById('start-btn');
+    const output = document.getElementById('output');
+    const yieldToBrowser = () => new Promise(resolve => setTimeout(resolve, 0));
+
+    // Stand in for the approximately 2ms of flavor analysis per recipe.
+    function processBlend() {
+      const started = performance.now();
+      while (performance.now() - started < 2) {
+        // Simulate CPU work for this blend.
+      }
+    }
+
+    startButton.addEventListener('click', async () => {
+      if (startButton.disabled) return;
+
+      startButton.disabled = true;
+      output.textContent = 'Processing...';
+
+      try {
+        // Let the initial status render before starting the CPU work.
+        await yieldToBrowser();
+        let batchStarted = performance.now();
+
+        for (let processed = 1; processed <= 1000; processed++) {
+          processBlend();
+
+          if (performance.now() - batchStarted >= 50) {
+            output.textContent = `Processed ${processed} of 1000...`;
+            // A new task lets the browser render and handle input between batches.
+            await yieldToBrowser();
+            batchStarted = performance.now();
+          }
+        }
+
+        output.textContent = 'Done! All items processed.';
+      } catch (error) {
+        output.textContent = 'Simulation interrupted. Please try again.';
+        console.error(error);
+      } finally {
+        startButton.disabled = false;
+      }
+    });
+  </script>
