+    document,
+    window: { addEventListener: (type, handler) => { handlers[type] = handler; } },
+    localStorage: { setItem: (key, value) => { if (storageBlocked) throw new Error('blocked'); saved[key] = value; } },
+  });
+  return { document, control, state, color, saved, handlers };
+}
+
+test('switch has a native checkbox, accessible name, and description', () => {
+  assert.match(html, /<label[^>]*for="theme-switch"/);
+  assert.match(html, /<input id="theme-switch" type="checkbox" role="switch" aria-describedby="theme-description">/);
+  assert.match(html, /id="theme-description"/);
+  assert.match(html, /input:focus-visible \+ \.switch-track/);
+  assert.match(html, /prefers-reduced-motion:reduce/);
+  assert.match(html, /forced-colors:active/);
+});
+
+test('initial state matches a restored dark preference', () => {
+  const app = setup('dark');
+  assert.equal(app.control.checked, true);
+  assert.equal(app.state.textContent, 'On');
+  assert.equal(app.color.content, '#1e241e');
+});
+
+test('native change events toggle both directions and save the preference', () => {
+  const app = setup();
+  for (const dark of [true, false]) {
+    app.control.checked = dark;
+    app.handlers.change();
+    assert.equal(app.document.documentElement.dataset.theme, dark ? 'dark' : 'light');
+    assert.equal(app.saved['daily-grind-theme'], dark ? 'dark' : 'light');
+    assert.equal(app.state.textContent, dark ? 'On' : 'Off');
+  }
+});
+
+test('blocked storage does not prevent a theme change', () => {
+  const app = setup('light', true);
+  app.control.checked = true;
+  assert.doesNotThrow(() => app.handlers.change());
+  assert.equal(app.document.documentElement.dataset.theme, 'dark');
+});
+
+test('cross-tab changes and clearing preferences synchronize the switch', () => {
+  const app = setup();
+  app.handlers.storage({ key: 'daily-grind-theme', newValue: 'dark' });
+  assert.equal(app.control.checked, true);
+  app.handlers.storage({ key: 'unrelated', newValue: 'light' });
+  assert.equal(app.control.checked, true);
+  app.handlers.storage({ key: null, newValue: null });
+  assert.equal(app.control.checked, false);
+});
+
+test('early theme restoration handles saved preferences and unavailable storage', () => {
+  const earlyScript = html.match(/<script>([\s\S]*?)<\/script>/)[1];
+  for (const preference of ['dark', 'light', null]) {
+    const document = { documentElement: { dataset: { theme: 'light' } } };
+    vm.runInNewContext(earlyScript, { document, localStorage: { getItem: () => preference } });
+    assert.equal(document.documentElement.dataset.theme, preference === 'dark' ? 'dark' : 'light');
+  }
+  assert.doesNotThrow(() => vm.runInNewContext(earlyScript, { localStorage: { getItem: () => { throw new Error('blocked'); } } }));
+});
