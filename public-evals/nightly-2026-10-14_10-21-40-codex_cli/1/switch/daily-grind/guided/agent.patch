+(() => {
+  const control = document.getElementById('theme-switch');
+  const state = document.getElementById('theme-state');
+  const themeColor = document.querySelector('meta[name="theme-color"]');
+
+  function applyTheme(dark) {
+    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
+    control.checked = dark;
+    state.textContent = dark ? 'On' : 'Off';
+    themeColor.content = dark ? '#1e241e' : '#f6f3ed';
+  }
+
+  applyTheme(document.documentElement.dataset.theme === 'dark');
+  control.addEventListener('change', () => {
+    applyTheme(control.checked);
+    try {
+      localStorage.setItem('daily-grind-theme', control.checked ? 'dark' : 'light');
+    } catch (_) { /* Storage restrictions should never prevent switching themes. */ }
+  });
+
+  // Keep the preference consistent when it changes in another tab.
+  window.addEventListener('storage', (event) => {
+    if (event.key === 'daily-grind-theme' || event.key === null) {
+      applyTheme(event.newValue === 'dark');
+    }
+  });
+})();
