         <div class="card">
           <h3>Maple Oat Latte</h3>
           <p>Creamy oat milk with a hint of Vermont maple syrup.</p>
           <a href="/menu/seasonal" class="btn">View Details</a>
@@ -206,7 +206,72 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (() => {
+      // WebMCP is optional; the menu remains usable in unsupported browsers.
+      const modelContext = document.modelContext;
+      if (typeof modelContext?.registerTool !== 'function') return;
+
+      const lookupTool = {
+        name: 'get_menu_item',
+        description: 'Look up a menu item by its full name and return its name, description, and details URL. Matching ignores capitalization and surrounding whitespace. Available items include Maple Oat Latte, Dark Roast Espresso, and Cold Brew.',
+        inputSchema: {
+          type: 'object',
+          properties: {
+            itemName: {
+              type: 'string',
+              minLength: 1,
+              description: 'The full menu item name, for example "Maple Oat Latte", "Dark Roast Espresso", or "Cold Brew".'
+            }
+          },
+          required: ['itemName'],
+          additionalProperties: false
+        },
+        execute(input) {
+          if (typeof input?.itemName !== 'string' || !input.itemName.trim()) {
+            return { error: 'Provide a non-empty menu item name in itemName.' };
+          }
+
+          const items = Array.from(document.querySelectorAll('#menu-items .card'), (card) => ({
+            name: card.querySelector('h3').textContent.trim(),
+            description: card.querySelector('p').textContent.trim(),
+            detailsUrl: card.querySelector('a').href
+          }));
+          const name = input.itemName.trim().toLowerCase();
+          const item = items.find((entry) => entry.name.toLowerCase() === name);
+          return item ?? {
+            error: `Menu item "${input.itemName.trim()}" not found.`,
+            availableItems: items.map((entry) => entry.name)
+          };
+        },
+        annotations: { readOnlyHint: true }
+      };
+
+      let registration;
+      async function registerMenuTool() {
+        if (registration) return;
+        const controller = new AbortController();
+        registration = controller;
+        try {
+          await modelContext.registerTool(lookupTool, { signal: controller.signal });
+        } catch (error) {
+          if (registration === controller) registration = undefined;
+          if (!controller.signal.aborted) {
+            console.warn('Could not register the menu lookup tool.', error);
+          }
+        }
+      }
+
+      window.addEventListener('pagehide', () => {
+        registration?.abort();
+        registration = undefined;
+      });
+      window.addEventListener('pageshow', registerMenuTool);
+      registerMenuTool();
+    })();
+  </script>
+
 </body>
 
 </html>
