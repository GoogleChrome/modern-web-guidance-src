diff --git a/src/components/ModalDialog.tsx b/src/components/ModalDialog.tsx
new file mode 100644
index 0000000..1cd7a9b
--- /dev/null
+++ b/src/components/ModalDialog.tsx
@@ -0,0 +1,49 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  labelledBy: string;
+  onClose: () => void;
+  children: ReactNode;
+  initialFocus: string;
+}
+
+/** Keep dismissal, modal focus containment and background inertness native. */
+export default function ModalDialog({ id, labelledBy, onClose, children, initialFocus }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const onCloseRef = useRef(onClose);
+  onCloseRef.current = onClose;
+
+  useEffect(() => {
+    const dialog = dialogRef.current!;
+    const invoker = document.activeElement;
+    dialog.showModal();
+    dialog.querySelector<HTMLElement>(initialFocus)?.focus();
+    return () => {
+      if (dialog.open) dialog.close();
+      if (invoker instanceof HTMLElement && invoker.isConnected) invoker.focus();
+    };
+  }, [initialFocus]);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      id={id}
+      aria-labelledby={labelledBy}
+      className="overlay-dialog bg-white shadow-xl"
+      onClose={() => onCloseRef.current()}
+      onClick={event => {
+        if (event.target !== event.currentTarget) return;
+        const bounds = event.currentTarget.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right ||
+            event.clientY < bounds.top || event.clientY > bounds.bottom) {
+          event.currentTarget.close();
+        }
+      }}
+    >
+      <button type="button" aria-label="Close dialog" onClick={() => dialogRef.current?.close()}
+        className="absolute top-2 right-2 p-2 text-gray-600 hover:text-amber-700">✕</button>
+      {children}
+    </dialog>
+  );
+}
