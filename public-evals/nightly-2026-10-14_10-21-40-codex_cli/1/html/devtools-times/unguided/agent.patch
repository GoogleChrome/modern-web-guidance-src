+          <input id="article-query" name="q" type="search" autoComplete="off" autoFocus
+            placeholder="Search for articles…" value={searchTerm} onChange={event => setSearchTerm(event.target.value)}
+            className="w-full p-2 border border-gray-300 rounded-md" />
+        </form>
+        <p role="status" className="text-sm text-gray-600 my-4">
+          {query ? `${results.length} ${results.length === 1 ? 'result' : 'results'} found.` : 'Featured articles'}
+        </p>
+        <ul className={query ? "space-y-2" : "grid grid-cols-1 sm:grid-cols-3 gap-4"}>
+          {displayedArticles.map(article => (
+            <li key={article.slug}>
+              <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block hover:bg-gray-100 p-4 rounded-md">
+                {!query && article.image && (
+                  <img src={article.image} srcSet={article.imageSrcSet}
+                    sizes="(min-width: 672px) 176px, (min-width: 640px) 26vw, calc(100vw - 112px)"
+                    width={240} height={135} alt="" loading="lazy" decoding="async"
+                    className="w-full aspect-video object-cover rounded-md mb-2" />
+                )}
+                <h3 className="font-bold text-lg text-gray-800">{article.title}</h3>
+                {query && <p className="text-sm text-gray-600">{article.summary}</p>}
+              </a>
+            </li>
+          ))}
+        </ul>
+      </div>
+    </ModalDialog>
+  );
 }
