diff --git a/src/components/Modal.tsx b/src/components/Modal.tsx
new file mode 100644
index 0000000..4dce5cc
--- /dev/null
+++ b/src/components/Modal.tsx
@@ -0,0 +1,49 @@
+import { useEffect, useRef, type ReactNode } from 'react';
+
+interface Props {
+  id: string;
+  title: string;
+  onClose: () => void;
+  children: ReactNode;
+}
+
+export default function Modal({ id, title, onClose, children }: Props) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+
+  useEffect(() => {
+    const dialog = dialogRef.current!;
+    const invoker = document.activeElement;
+    dialog.showModal();
+    return () => {
+      dialog.close();
+      if (invoker instanceof HTMLElement && invoker.isConnected) invoker.focus();
+    };
+  }, []);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      id={id}
+      aria-labelledby={`${id}-title`}
+      closedby="any"
+      className="app-dialog bg-white shadow-xl"
+      onClose={onClose}
+      onClick={event => {
+        // Older browsers ignore closedby; retain backdrop dismissal there.
+        const dialog = event.currentTarget;
+        if ('closedBy' in HTMLDialogElement.prototype || event.target !== dialog) return;
+        const bounds = dialog.getBoundingClientRect();
+        if (event.clientX < bounds.left || event.clientX > bounds.right ||
+            event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
+      }}
+    >
+      <header className="flex items-center justify-between gap-4 border-b border-gray-200 p-4">
+        <h2 id={`${id}-title`} className="text-lg font-semibold">{title}</h2>
+        <form method="dialog">
+          <button type="submit" aria-label={`Close ${title}`} autoFocus={id !== 'search-dialog'} className="p-2 text-gray-600 hover:text-amber-700">✕</button>
+        </form>
+      </header>
+      {children}
+    </dialog>
+  );
+}
diff --git a/src/components/NavigationPopover.tsx b/src/components/NavigationPopover.tsx
new file mode 100644
index 0000000..3955029
--- /dev/null
+++ b/src/components/NavigationPopover.tsx
@@ -0,0 +1,40 @@
+import { useEffect, useId, useRef, useState, type ReactNode } from 'react';
+
+export default function NavigationPopover({ label, children, active = false }: { label: string; children: ReactNode; active?: boolean }) {
+  const id = useId();
+  const triggerRef = useRef<HTMLButtonElement>(null);
+  const popoverRef = useRef<HTMLDivElement>(null);
+  const [open, setOpen] = useState(false);
+
+  useEffect(() => {
+    const popover = popoverRef.current!;
+    const position = () => {
+      const bottom = triggerRef.current!.getBoundingClientRect().bottom;
+      popover.style.setProperty('--popover-top', `${Math.max(8, bottom + 8)}px`);
+    };
+    const beforeToggle = (event: Event) => {
+      if ((event as ToggleEvent).newState === 'open') position();
+    };
+    const toggle = (event: Event) => setOpen((event as ToggleEvent).newState === 'open');
+    popover.addEventListener('beforetoggle', beforeToggle);
+    popover.addEventListener('toggle', toggle);
+    window.addEventListener('resize', position);
+    window.addEventListener('scroll', position, true);
+    return () => {
+      popover.removeEventListener('beforetoggle', beforeToggle);
+      popover.removeEventListener('toggle', toggle);
+      window.removeEventListener('resize', position);
+      window.removeEventListener('scroll', position, true);
+    };
+  }, []);
+
+  return <>
+    <button ref={triggerRef} type="button" popoverTarget={id} aria-controls={id} aria-expanded={open} className={`flex items-center gap-1 whitespace-nowrap py-2 hover:text-gray-600 ${active ? 'text-amber-700' : ''}`}>
+      {label}
+      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" className="w-3 h-3"><path d="m6 9 6 6 6-6" /></svg>
+    </button>
+    <div ref={popoverRef} id={id} popover="auto" aria-label={label} className="navigation-popover bg-white shadow-lg border border-gray-300">
+      {children}
+    </div>
+  </>;
+}
