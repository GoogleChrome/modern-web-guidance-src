+import { useMemo, useState } from 'react';
+import Modal from './Modal';
+import type { SearchArticle } from './SearchButton';
+
+export default function SearchFlyout({ articles, onClose }: { articles: SearchArticle[]; onClose: () => void }) {
+  const [searchTerm, setSearchTerm] = useState('');
+  const query = searchTerm.trim().toLowerCase();
+  const results = useMemo(() => articles.filter(article =>
+    article.title.toLowerCase().includes(query) || article.summary.toLowerCase().includes(query)
+  ), [articles, query]);
+  const displayedArticles = query ? results : articles.slice(0, 3);
+
+  return <Modal id="search-dialog" title="Search articles" onClose={onClose}>
+    <search className="block p-4">
+      <form onSubmit={event => event.preventDefault()}>
+        <label htmlFor="article-search" className="block text-sm font-semibold mb-2">Search by title or topic</label>
+        <input id="article-search" name="q" type="search" autoComplete="on" autoFocus value={searchTerm} onChange={event => setSearchTerm(event.target.value)} placeholder="Search for articles…" className="w-full p-2 border border-gray-300 rounded-md" aria-controls="search-results" />
+      </form>
+    </search>
+    <section className="p-4" aria-labelledby="search-results-heading">
+      <h3 id="search-results-heading" className="font-semibold mb-3">{query ? 'Results' : 'Featured'}</h3>
+      <p role="status" className="text-sm text-gray-600">{query ? `${results.length} results for “${searchTerm.trim()}”.` : 'Browse featured articles or enter a search.'}</p>
+      <ul id="search-results" className="space-y-2 mt-3">
+        {displayedArticles.map(article => <li key={article.slug}>
+          <a href={`${import.meta.env.BASE_URL}articles/${article.slug}`} className="block hover:bg-gray-100 p-4 rounded-md">
+            <h4 className="font-bold text-lg">{article.title}</h4>
+            <p className="text-sm text-gray-600">{article.summary}</p>
+          </a>
+        </li>)}
+      </ul>
+    </section>
+  </Modal>;
 }
