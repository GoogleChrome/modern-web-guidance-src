diff --git a/app.js b/app.js
new file mode 100644
index 0000000..8ea17de
--- /dev/null
+++ b/app.js
@@ -0,0 +1,26 @@
+// Enhance destination links only when the browser supports native overlays.
+if ('showPopover' in HTMLElement.prototype) {
+  document.querySelector('#account-menu').hidden = false;
+  document.querySelector('[data-account-fallback]').hidden = true;
+  document.querySelector('.account-toggle').hidden = false;
+}
+
+if (typeof HTMLDialogElement !== 'undefined' && 'showModal' in HTMLDialogElement.prototype) {
+  document.querySelectorAll('[data-dialog]').forEach((link) => {
+    const dialog = document.getElementById(link.dataset.dialog);
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = link.className;
+    button.textContent = link.textContent;
+    button.setAttribute('aria-label', link.getAttribute('aria-label'));
+    button.setAttribute('aria-haspopup', 'dialog');
+    button.setAttribute('aria-controls', dialog.id);
+    link.replaceWith(button);
+
+    // showModal supplies the top layer, inert background, and native Escape handling.
+    button.addEventListener('click', () => dialog.showModal());
+    dialog.addEventListener('close', () => {
+      if (button.isConnected) button.focus({ preventScroll: true });
+    });
+  });
+}
