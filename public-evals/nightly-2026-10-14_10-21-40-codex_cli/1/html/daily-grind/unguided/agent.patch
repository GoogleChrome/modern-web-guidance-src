diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..8fc0a92
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,223 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+/* Navigation */
+.site-header { position: sticky; top: 0; z-index: 1000; }
+.site-nav {
+  background: var(--primary);
+  color: white;
+  padding: 1rem 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+.site-nav ul {
+  display: flex;
+  list-style: none;
+}
+
+.site-nav ul li {
+  margin-left: 20px;
+}
+
+.site-nav a,
+.account-toggle {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+.site-nav a:hover,
+.account-toggle:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+/* Hero Section */
+.hero {
+  height: 60vh;
+  position: relative;
+  isolation: isolate;
+  background: var(--primary);
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  align-items: center;
+  color: white;
+  text-align: center;
+  padding: 0 20px;
+}
+
+.hero h1 {
+  font-size: 3rem;
+  margin-bottom: 1rem;
+}
+
+/* Content Sections */
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
+  gap: 20px;
+  margin-top: 20px;
+}
+
+.card {
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links a {
+  margin: 0 10px;
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+.hero-image, .hero::after {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  z-index: -1;
+}
+
+.hero-image { object-fit: cover; }
+.hero::after { content: ""; background: rgba(0, 0, 0, 0.5); }
+.section-title { text-align: center; }
+button { font: inherit; cursor: pointer; }
+button.btn { border: 0; }
+dialog:not([open]) { display: none; }
+.account-toggle { border: 0; background: transparent; }
+.site-nav .logo { color: white; text-decoration: none; font-size: 1.5rem; }
+:focus-visible { outline: 3px solid #b05c00; outline-offset: 4px; }
+.site-nav :focus-visible, .hero :focus-visible { outline-color: var(--accent); }
+
+.skip-link {
+  position: fixed;
+  top: 8px;
+  left: 8px;
+  padding: 10px 20px;
+  background: white;
+  color: var(--text);
+  z-index: 2000;
+  transform: translateY(-150%);
+}
+.skip-link:focus { transform: translateY(0); }
+#main-content { scroll-margin-top: 100px; }
+
+.account-menu {
+  position: fixed;
+  inset: 75px 5% auto auto;
+  margin: 0;
+  min-width: 180px;
+  padding: 16px;
+  border: 1px solid var(--secondary);
+  border-radius: 8px;
+  background: white;
+  color: var(--text);
+  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
+}
+.account-menu ul { list-style: none; }
+.account-menu a { display: block; padding: 8px; color: inherit; }
+[hidden] { display: none !important; }
+
+.product-dialog {
+  margin: auto;
+  width: min(480px, calc(100% - 32px));
+  max-height: calc(100dvh - 32px);
+  overflow: auto;
+  padding: 28px;
+  border: 0;
+  border-radius: 8px;
+  color: var(--text);
+  background: white;
+}
+.product-dialog::backdrop { background: rgba(0, 0, 0, 0.6); }
+.product-dialog h2 { margin-bottom: 12px; }
+.dialog-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 24px; }
+.dialog-actions .btn { margin: 0; }
+.close-button { padding: 10px 20px; border: 1px solid var(--primary); border-radius: 5px; background: white; color: var(--primary); }
+
+@media (max-width: 640px) {
+  .site-nav { flex-direction: column; gap: 12px; padding: 16px; }
+  .site-nav ul { flex-wrap: wrap; justify-content: center; gap: 12px 16px; }
+  .site-nav ul li { margin-left: 0; }
+  .hero { min-height: 360px; height: 60svh; }
+  .hero h1 { font-size: clamp(2rem, 9vw, 3rem); }
+  .account-menu { top: 120px; }
+  #main-content { scroll-margin-top: 150px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { transition: none !important; }
+}
