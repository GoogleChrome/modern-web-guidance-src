diff --git a/site.js b/site.js
new file mode 100644
index 0000000..b83a9d7
--- /dev/null
+++ b/site.js
@@ -0,0 +1,22 @@
+// Keep ordinary menu links when scripting or native modal dialogs are unavailable.
+if (typeof HTMLDialogElement !== 'undefined' &&
+    typeof HTMLDialogElement.prototype.showModal === 'function') {
+  for (const link of document.querySelectorAll('a[data-dialog]')) {
+    const dialog = document.getElementById(link.dataset.dialog);
+    if (!(dialog instanceof HTMLDialogElement)) continue;
+
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = link.className;
+    button.textContent = link.textContent;
+    button.setAttribute('aria-label', link.getAttribute('aria-label'));
+    button.setAttribute('aria-haspopup', 'dialog');
+    button.setAttribute('aria-controls', dialog.id);
+
+    // Native modality handles initial focus, background inertness, and Escape.
+    button.addEventListener('click', () => dialog.showModal());
+    // Restore the invoker even in browsers that do not focus a clicked button.
+    dialog.addEventListener('close', () => button.focus());
+    link.replaceWith(button);
+  }
+}
diff --git a/styles.css b/styles.css
new file mode 100644
index 0000000..cb4e95b
--- /dev/null
+++ b/styles.css
@@ -0,0 +1,245 @@
+:root {
+  --primary: #4e342e;
+  --secondary: #d7ccc8;
+  --accent: #ffab40;
+  --text: #3e2723;
+  --light: #fafafa;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
+  line-height: 1.6;
+  color: var(--text);
+  background-color: var(--light);
+}
+
+button {
+  font: inherit;
+  cursor: pointer;
+}
+
+:focus-visible {
+  outline: 3px solid var(--text);
+  outline-offset: 4px;
+}
+
+.site-header :focus-visible,
+.hero :focus-visible,
+.btn:focus-visible {
+  outline: 3px solid var(--accent);
+  outline-offset: 4px;
+  box-shadow: 0 0 0 4px var(--primary);
+}
+
+.skip-link {
+  position: fixed;
+  top: 1rem;
+  left: 1rem;
+  z-index: 20;
+  transform: translateY(-200%);
+  padding: 0.75rem 1rem;
+  background: white;
+  color: var(--text);
+}
+
+.skip-link:focus {
+  transform: translateY(0);
+}
+
+.site-header {
+  position: sticky;
+  top: 0;
+  z-index: 10;
+  background: var(--primary);
+  color: white;
+}
+
+.site-header nav {
+  padding: 1rem 5%;
+  display: flex;
+  flex-wrap: wrap;
+  gap: 1rem;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.site-header .logo {
+  font-size: 1.5rem;
+  font-weight: bold;
+  letter-spacing: 1px;
+}
+
+nav ul {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.75rem 20px;
+  list-style: none;
+}
+
+.site-header a {
+  color: white;
+  text-decoration: none;
+  font-size: 0.9rem;
+  transition: color 0.3s;
+}
+
+.site-header a:hover {
+  color: var(--accent);
+}
+
+.logout-link {
+  border: 1px solid var(--accent);
+  padding: 5px 12px;
+  border-radius: 4px;
+}
+
+.hero {
+  position: relative;
+  isolation: isolate;
+  min-height: 60vh;
+  display: grid;
+  place-items: center;
+  color: white;
+  background: var(--primary);
+  text-align: center;
+  padding: 40px 20px;
+}
+
+.hero-image,
+.hero::before {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  pointer-events: none;
+}
+
+.hero-image {
+  z-index: -2;
+  object-fit: cover;
+}
+
+.hero::before {
+  content: '';
+  z-index: -1;
+  background: rgb(0 0 0 / 50%);
+}
+
+.hero h1 {
+  font-size: clamp(2rem, 5vw, 3rem);
+  margin-bottom: 1rem;
+}
+
+.container {
+  max-width: 1100px;
+  margin: 40px auto;
+  padding: 0 20px;
+}
+
+.container > h2 {
+  text-align: center;
+}
+
+.grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
+  gap: 20px;
+  margin-top: 20px;
+  list-style: none;
+}
+
+.card {
+  height: 100%;
+  background: white;
+  padding: 20px;
+  border-radius: 8px;
+  box-shadow: 0 2px 5px rgb(0 0 0 / 10%);
+  text-align: center;
+}
+
+.card h3 {
+  margin-bottom: 10px;
+  color: var(--primary);
+}
+
+.btn {
+  display: inline-block;
+  background: var(--primary);
+  color: white;
+  border: 0;
+  padding: 10px 20px;
+  text-decoration: none;
+  border-radius: 5px;
+  margin-top: 15px;
+  transition: background 0.3s;
+}
+
+.btn:hover {
+  background: #3e2723;
+}
+
+footer {
+  background: var(--secondary);
+  text-align: center;
+  padding: 40px 20px;
+  margin-top: 40px;
+}
+
+.footer-links {
+  margin-bottom: 20px;
+}
+
+.footer-links ul {
+  justify-content: center;
+}
+
+.footer-links a {
+  color: var(--text);
+  text-decoration: none;
+  font-size: 0.85rem;
+}
+
+/* Explicit hiding also protects the fallback in browsers without dialog support. */
+dialog:not([open]) {
+  display: none;
+}
+
+dialog {
+  margin: auto;
+  width: min(30rem, calc(100% - 2rem));
+  max-height: calc(100% - 2rem);
+  overflow: auto;
+  padding: 2rem;
+  border: 0;
+  border-radius: 8px;
+  color: var(--text);
+  background: white;
+}
+
+dialog h2 {
+  margin-bottom: 1rem;
+}
+
+dialog::backdrop {
+  background: rgb(0 0 0 / 60%);
+}
+
+/* Keep wrapped navigation from covering content at narrow widths and high zoom. */
+@media (max-width: 700px) {
+  .site-header {
+    position: static;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .site-header a,
+  .btn {
+    transition: none;
+  }
+}
