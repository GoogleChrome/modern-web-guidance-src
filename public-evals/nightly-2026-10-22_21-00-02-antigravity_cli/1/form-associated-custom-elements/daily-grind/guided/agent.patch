+    class RatingInput extends HTMLElement {
+      // MANDATORY: opt in. Without this, attachInternals() form APIs are unavailable.
+      static formAssociated = true;
+
+      static get observedAttributes() {
+        return ['value', 'required', 'disabled'];
+      }
+
+      #internals = null;
+      #value = '';
+      #defaultValue = '';
+      #fallbackInput = null;
+
+      constructor() {
+        super();
+        if (supportsFACE) {
+          this.#internals = this.attachInternals();
+        }
+        this.attachShadow({ mode: 'open', delegatesFocus: true });
+        this.#render();
+      }
+
+      connectedCallback() {
+        if (this.hasAttribute('value')) {
+          this.#defaultValue = this.getAttribute('value') || '';
+          if (!this.#value) {
+            this.#value = this.#defaultValue;
+          }
+        }
+        if (!supportsFACE) {
+          this.#ensureFallbackInput();
+        }
+        this.#syncFormValue();
+        this.#updateUI();
+        this.#validate();
+      }
+
+      attributeChangedCallback(name, oldValue, newValue) {
+        if (oldValue === newValue) return;
+        if (name === 'value' && newValue !== null) {
+          this.value = newValue;
+        } else if (name === 'required') {
+          this.#validate();
+        } else if (name === 'disabled') {
+          this.formDisabledCallback(this.hasAttribute('disabled'));
+        }
+      }
+
+      get value() {
+        return this.#value;
+      }
+
+      set value(v) {
+        const normalized = v == null ? '' : String(v);
+        this.#value = normalized;
+        this.#syncFormValue();
+        this.#updateUI();
+        this.#validate();
+      }
+
+      get form() {
+        return this.#internals ? this.#internals.form : this.closest('form');
+      }
+
+      get name() {
+        return this.getAttribute('name');
+      }
+
+      get type() {
+        return this.localName;
+      }
+
+      get validity() {
+        return this.#internals ? this.#internals.validity : this.#fallbackInput?.validity;
+      }
+
+      get validationMessage() {
+        return this.#internals ? this.#internals.validationMessage : (this.#fallbackInput?.validationMessage || '');
+      }
+
+      get willValidate() {
+        return this.#internals ? this.#internals.willValidate : Boolean(this.#fallbackInput?.willValidate);
+      }
+
+      checkValidity() {
+        return this.#internals ? this.#internals.checkValidity() : Boolean(this.#fallbackInput?.checkValidity());
+      }
+
+      reportValidity() {
+        return this.#internals ? this.#internals.reportValidity() : Boolean(this.#fallbackInput?.reportValidity());
+      }
+
+      #ensureFallbackInput() {
+        if (this.#fallbackInput) return;
+        const input = document.createElement('input');
+        input.type = 'text';
+        input.tabIndex = -1;
+        input.setAttribute('aria-hidden', 'true');
+        input.name = this.name || '';
+        input.required = this.hasAttribute('required');
+        Object.assign(input.style, {
+          position: 'absolute',
+          clipPath: 'inset(50%)',
+          overflow: 'hidden',
+          width: '1px',
+          height: '1px',
+          margin: '-1px',
+          padding: '0',
+          border: '0',
+          whiteSpace: 'nowrap',
+        });
+        this.appendChild(input);
+        this.#fallbackInput = input;
+      }
+
+      #syncFormValue() {
+        if (this.#internals) {
+          // Push the value into the owning <form> for submission.
+          this.#internals.setFormValue(this.#value);
+        } else if (this.#fallbackInput) {
+          this.#fallbackInput.name = this.name || '';
+          this.#fallbackInput.value = this.#value;
+          this.#fallbackInput.required = this.hasAttribute('required');
+        }
+      }
+
+      #validate() {
+        const anchor = this.shadowRoot.querySelector('[tabindex="0"], button');
+        if (this.hasAttribute('required') && !this.#value) {
