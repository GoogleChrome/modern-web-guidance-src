+
+      /* Internal helpers */
+
+      _setCustomState(stateName, active) {
+        if (!this._internals.states) return;
+        if (active) {
+          this._internals.states.add(stateName);
+        } else {
+          this._internals.states.delete(stateName);
+        }
+      }
+
+      _syncFormValue() {
+        if (this.disabled || this._value === '') {
+          this._internals.setFormValue(null, JSON.stringify({ value: this._value }));
+        } else {
+          const statePayload = JSON.stringify({
+            value: this._value,
