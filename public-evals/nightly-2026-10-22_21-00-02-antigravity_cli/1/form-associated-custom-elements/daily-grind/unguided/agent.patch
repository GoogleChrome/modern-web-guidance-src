+          this._defaultValue = this.getAttribute('value') || '';
+          this._value = this._defaultValue;
+        }
+        this._disabled = this.hasAttribute('disabled') || this._disabled;
+        this._syncFormValue();
+        this._updateValidity();
+        this._updateUI();
+      }
