+    class RoastSelector extends HTMLElement {
+      static formAssociated = true;
+
+      static get observedAttributes() {
+        return ['value', 'disabled', 'required', 'min', 'max', 'pattern', 'name'];
+      }
+
+      constructor() {
+        super();
+        this._internals = this.attachInternals();
+        this._shadow = this.attachShadow({ mode: 'open', delegatesFocus: true });
+
+        this._defaultValue = this.getAttribute('value') || '';
+        this._value = this._defaultValue;
+        this._dirty = false;
+        this._disabled = this.hasAttribute('disabled');
+        this._customErrorMessage = '';
+        this._associatedForm = null;
+
+        this._render();
+        this._syncFormValue();
+        this._updateValidity();
+        this._updateUI();
+      }
+
+      /* Form-associated lifecycle callbacks */
+
+      formAssociatedCallback(form) {
+        this._associatedForm = form;
+        this.dispatchEvent(new CustomEvent('form-associated', {
+          detail: { form },
+          bubbles: false
+        }));
+      }
+
+      formDisabledCallback(disabled) {
+        this._disabled = Boolean(disabled);
+        this._setCustomState('disabled', this._disabled);
+        this._syncFormValue();
+        this._updateValidity();
+        this._updateUI();
+      }
+
+      formResetCallback() {
+        this._dirty = false;
+        this._customErrorMessage = '';
+        this._value = this.getAttribute('value') || '';
+        this._syncFormValue();
+        this._updateValidity();
+        this._updateUI();
+      }
+
+      formStateRestoreCallback(state, mode) {
+        this._dirty = true;
+        if (state instanceof FormData) {
+          const entry = this.name ? state.get(this.name) : Array.from(state.values())[0];
+          this._value = entry !== null && entry !== undefined ? String(entry) : '';
+        } else if (typeof state === 'string') {
+          try {
+            const parsed = JSON.parse(state);
+            if (parsed && typeof parsed === 'object' && 'value' in parsed) {
+              this._value = String(parsed.value ?? '');
+            } else {
+              this._value = state;
+            }
+          } catch {
+            this._value = state;
+          }
+        } else {
+          this._value = '';
+        }
