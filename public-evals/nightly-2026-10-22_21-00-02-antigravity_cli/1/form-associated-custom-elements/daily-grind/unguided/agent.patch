+  <script>
+    const ROAST_LEVELS = [
+      { level: '1', name: 'Light Blonde', notes: 'Bright & Citrusy' },
+      { level: '2', name: 'Cinnamon Medium-Light', notes: 'Floral & Honey' },
+      { level: '3', name: 'City Medium', notes: 'Balanced Caramel' },
