+
+      _updateValidity() {
+        const anchor = this._shadow.querySelector('.roast-option') || this._focusAnchor;
+
+        if (this.disabled) {
+          this._internals.setValidity({});
+          this._setCustomState('invalid', false);
+          this._setCustomState('valid', false);
+          return;
+        }
+
+        const flags = {};
+        let message = '';
+
+        if (this._customErrorMessage) {
+          flags.customError = true;
+          message = this._customErrorMessage;
+        }
+
+        if (this.required && (!this._value || this._value.trim() === '')) {
+          flags.valueMissing = true;
+          if (!message) {
+            message = 'Please select a roast level.';
+          }
+        }
+
+        if (this._value !== '') {
+          const numericValue = Number(this._value);
+          const minAttr = this.getAttribute('min');
+          const maxAttr = this.getAttribute('max');
+          const patternAttr = this.getAttribute('pattern');
+
+          if (Number.isNaN(numericValue)) {
+            flags.badInput = true;
+            if (!message) {
+              message = 'Roast level must be a valid number.';
+            }
+          } else {
+            if (minAttr !== null && minAttr !== '' && numericValue < Number(minAttr)) {
+              flags.rangeUnderflow = true;
+              if (!message) {
+                message = `Roast level must be at least ${minAttr}.`;
+              }
+            }
+            if (maxAttr !== null && maxAttr !== '' && numericValue > Number(maxAttr)) {
+              flags.rangeOverflow = true;
+              if (!message) {
+                message = `Roast level must be at most ${maxAttr}.`;
+              }
