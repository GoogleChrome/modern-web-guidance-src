+  <script>
+    // Out-of-order batch of coffee order events collected from distributed backend microservices
+    // Note: Several events share the exact same millisecond (e.g. .104...) and only differ in sub-millisecond (microsecond/nanosecond) digits.
+    const RAW_ORDER_EVENTS = [
+      {
+        eventId: 'evt-904',
+        orderId: 'ORD-8821',
+        service: 'barista-queue-svc',
