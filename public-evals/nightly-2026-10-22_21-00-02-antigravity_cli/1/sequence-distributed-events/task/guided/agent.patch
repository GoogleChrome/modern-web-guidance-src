+  <script type="module">
+    // Out-of-order coffee order events collected from distributed backend services
+    // with nanosecond-precision UTC timestamps measured against a synchronized clock.
+    const rawOrderEvents = [
+      {
+        orderId: 'ORD-8492',
+        service: 'roastery-inventory-db',
+        eventType: 'inventory.beans_reserved',
+        detail: 'Reserved 18g Ethiopian Yirgacheffe & 240ml Oat Milk',
+        ts: '2026-10-22T08:15:30.104512890Z'
+      },
+      {
+        orderId: 'ORD-8492',
+        service: 'barista-queue-worker',
+        eventType: 'barista.ticket_dispatched',
+        detail: 'Routed Maple Oat Latte ticket to Espresso Bar #2',
+        ts: '2026-10-22T08:15:30.105004120Z'
+      },
+      {
+        orderId: 'ORD-8492',
+        service: 'edge-api-gateway',
+        eventType: 'order.request_received',
+        detail: 'POST /v2/orders (Maple Oat Latte, Grande)',
+        ts: '2026-10-22T08:15:30.104100000Z'
+      },
+      {
+        orderId: 'ORD-8492',
+        service: 'payment-ledger-svc',
+        eventType: 'payment.authorized',
+        detail: 'Card token auth completed ($6.45)',
+        ts: '2026-10-22T08:15:30.104519345Z'
+      },
+      {
+        orderId: 'ORD-8492',
+        service: 'loyalty-rewards-svc',
+        eventType: 'rewards.points_accrued',
+        detail: '+65 Bean Points credited to customer ledger',
+        ts: '2026-10-22T08:15:30.104512955Z'
+      },
+      {
+        orderId: 'ORD-8492',
+        service: 'auth-token-verifier',
+        eventType: 'auth.session_verified',
+        detail: 'Validated customer session JWT',
+        ts: '2026-10-22T08:15:30.104100450Z'
+      },
+      {
+        orderId: 'ORD-8492',
+        service: 'push-notifier-svc',
+        eventType: 'notification.order_confirmed',
+        detail: 'Dispatched push notification & receipt email',
+        ts: '2026-10-22T08:15:30.105004120Z'
+      }
+    ];
+
+    async function ensureTemporal() {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+      }
+    }
+
+    function parseOrderEvents(rawBatch) {
+      return rawBatch.map((evt, originalIndex) => ({
+        ...evt,
+        originalIndex: originalIndex + 1,
+        timestamp: Temporal.Instant.from(evt.ts)
+      }));
+    }
+
+    function sequenceEvents(events) {
+      return [...events].sort((a, b) => Temporal.Instant.compare(a.timestamp, b.timestamp));
+    }
+
+    function analyzeSequencedEvents(sortedEvents) {
+      return sortedEvents.map((curr, index) => {
+        if (index === 0) {
+          return {
+            ...curr,
+            intervalDuration: null,
+            isSimultaneous: false,
+            formattedInterval: '— (Initial Event)'
+          };
+        }
+
+        const prev = sortedEvents[index - 1];
+        const isSimultaneous = curr.timestamp.equals(prev.timestamp);
+        const gap = curr.timestamp.since(prev.timestamp);
+
+        return {
+          ...curr,
+          intervalDuration: gap,
+          isSimultaneous,
+          formattedInterval: isSimultaneous
+            ? '0ns (Simultaneous)'
+            : `+${gap.toLocaleString('en-US', { style: 'narrow' })}`
+        };
+      });
+    }
+
+    const loadBtn = document.getElementById('load-order-events-btn');
+    const outputEl = document.getElementById('trace-output');
+
+    loadBtn.addEventListener('click', async () => {
+      loadBtn.disabled = true;
+      loadBtn.textContent = 'Sequencing Events...';
+
+      try {
+        await ensureTemporal();
+
+        const parsedEvents = parseOrderEvents(rawOrderEvents);
+        const sortedEvents = sequenceEvents(parsedEvents);
+        const analyzedEvents = analyzeSequencedEvents(sortedEvents);
+
+        const firstInstant = analyzedEvents[0].timestamp;
+        const lastInstant = analyzedEvents[analyzedEvents.length - 1].timestamp;
+        const totalSpan = lastInstant.since(firstInstant);
+
+        const rowsHtml = analyzedEvents.map((evt, idx) => `
+          <tr>
+            <td><strong>#${idx + 1}</strong> <span style="color: #8d6e63; font-size: 0.8rem;">(raw #${evt.originalIndex})</span></td>
+            <td><span class="service-badge">${evt.service}</span></td>
+            <td>
+              <div><strong>${evt.eventType}</strong></div>
+              <div style="color: #5d4037; font-size: 0.82rem;">${evt.detail}</div>
+            </td>
+            <td class="mono">${evt.timestamp.toString()}</td>
+            <td><span class="interval-badge mono">${evt.formattedInterval}</span></td>
+          </tr>
+        `).join('');
+
+        outputEl.innerHTML = `
+          <div class="trace-summary">
+            <div><strong>Order ID:</strong> ORD-8492 (Maple Oat Latte)</div>
+            <div><strong>Events Sequenced:</strong> ${analyzedEvents.length} distributed events</div>
+            <div><strong>Total End-to-End Span:</strong> <span class="mono">${totalSpan.toLocaleString('en-US', { style: 'narrow' })}</span></div>
+          </div>
+          <div class="trace-table-wrapper">
+            <table class="trace-table">
+              <thead>
+                <tr>
+                  <th>Seq</th>
+                  <th>Backend Service</th>
+                  <th>Order Event</th>
+                  <th>UTC Timestamp (Nanosecond Precision)</th>
+                  <th>Interval Since Previous</th>
+                </tr>
+              </thead>
+              <tbody>
+                ${rowsHtml}
+              </tbody>
+            </table>
+          </div>
+        `;
+
+        loadBtn.textContent = 'Reload & Sequence Order Events';
+      } catch (err) {
+        outputEl.innerHTML = `<p style="color: #b71c1c; margin-top: 10px;">Failed to sequence order events: ${err.message}</p>`;
+        loadBtn.textContent = 'Load & Sequence Order Events';
+      } finally {
+        loadBtn.disabled = false;
+      }
+    });
+  </script>
 </body>
 
 </html>
