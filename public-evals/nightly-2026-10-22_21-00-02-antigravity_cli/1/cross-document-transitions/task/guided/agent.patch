+  <script>
+    const cardsByPage = {
+      1: [
+        {
+          title: 'Maple Oat Latte',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          href: '/menu/seasonal',
+        },
+        {
+          title: 'Dark Roast Espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          href: '/menu/espresso',
+        },
+        {
+          title: 'Cold Brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          href: '/menu/cold-brew',
+        },
+      ],
+      2: [
+        {
+          title: 'Cinnamon Cortado',
+          description: 'Rich espresso balanced with steamed milk and warm spice.',
+          href: '/menu/cortado',
+        },
+        {
+          title: 'Honey Lavender Matcha',
+          description: 'Ceremonial grade matcha lightly sweetened with floral notes.',
+          href: '/menu/matcha',
+        },
+        {
+          title: 'Roasted Hazelnut Pour-Over',
+          description: 'Single-origin beans brewed fresh to highlight nutty aromas.',
+          href: '/menu/pour-over',
+        },
+      ],
+    };
+
+    function getPageNumber(urlString) {
+      try {
+        const url = new URL(urlString, window.location.origin);
+        const page = Number.parseInt(url.searchParams.get('page') || '1', 10);
+        return Number.isNaN(page) ? 1 : page;
+      } catch {
+        return 1;
+      }
+    }
+
+    function determineTransitionType(fromUrl, toUrl) {
+      const storedDirection = sessionStorage.getItem('transitionDirection');
+      if (storedDirection === 'next' || storedDirection === 'previous') {
+        sessionStorage.removeItem('transitionDirection');
+        return storedDirection;
+      }
+
+      if (toUrl) {
+        try {
+          const dest = new URL(toUrl, window.location.origin);
+          const dirParam = dest.searchParams.get('direction');
+          if (dirParam === 'next' || dirParam === 'previous') {
+            return dirParam;
+          }
+        } catch {
+          // ignore
+        }
+      }
+
+      if (fromUrl && toUrl) {
+        const fromPage = getPageNumber(fromUrl);
+        const toPage = getPageNumber(toUrl);
+        if (toPage < fromPage) {
+          return 'previous';
+        }
+        if (toPage > fromPage) {
+          return 'next';
+        }
+      }
+
+      return 'next';
+    }
+
+    const prevLink = document.getElementById('previous');
+    const nextLink = document.getElementById('next');
+
+    prevLink?.addEventListener('click', () => {
+      sessionStorage.setItem('transitionDirection', 'previous');
+    });
+
+    nextLink?.addEventListener('click', () => {
+      sessionStorage.setItem('transitionDirection', 'next');
+    });
+
+    const currentPage = getPageNumber(window.location.href);
+    if (cardsByPage[currentPage] && currentPage !== 1) {
+      const grid = document.querySelector('.grid');
+      if (grid) {
+        grid.innerHTML = cardsByPage[currentPage]
+          .map(
+            (item) => `
+        <div class="card">
+          <h3>${item.title}</h3>
+          <p>${item.description}</p>
+          <a href="${item.href}" class="btn">View Details</a>
+        </div>`
+          )
+          .join('');
+      }
+    }
+
+    if ('onpagereveal' in window) {
+      window.addEventListener('pagereveal', async (e) => {
+        if (e.viewTransition) {
+          const fromUrl = window.navigation?.activation?.from?.url;
+          const toUrl = window.navigation?.activation?.entry?.url || window.location.href;
+          const transitionType = determineTransitionType(fromUrl, toUrl);
+          e.viewTransition.types.add(transitionType);
+        }
+      });
+    }
+  </script>
 </body>
 
 </html>
