   </style>
+  <script>
+    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
+      window.addEventListener('pageswap', (event) => {
+        if (event.viewTransition) {
+          const transitionType = sessionStorage.getItem('transitionType');
+          if (transitionType) {
+            event.viewTransition.types.add(transitionType);
+          }
+        }
+      });
+
+      window.addEventListener('pagereveal', (event) => {
+        if (!event.viewTransition) return;
+
+        let transitionType = sessionStorage.getItem('transitionType');
+        sessionStorage.removeItem('transitionType');
+
+        if (!transitionType && window.navigation?.activation?.from && window.navigation?.activation?.entry) {
+          const fromUrl = new URL(window.navigation.activation.from.url);
+          const toUrl = new URL(window.navigation.activation.entry.url);
+          const fromPage = Number(fromUrl.searchParams.get('page') ?? 1);
+          const toPage = Number(toUrl.searchParams.get('page') ?? 1);
+
+          if (toUrl.searchParams.get('dir') === 'previous' || toPage < fromPage) {
+            transitionType = 'previous';
+          } else if (toUrl.searchParams.get('dir') === 'next' || toPage > fromPage) {
+            transitionType = 'next';
+          }
+        }
+
+        if (!transitionType) {
+          const params = new URLSearchParams(window.location.search);
+          transitionType = params.get('dir') === 'previous' ? 'previous' : 'next';
+        }
+
+        event.viewTransition.types.add(transitionType);
+      });
+    }
+  </script>
 </head>
 
