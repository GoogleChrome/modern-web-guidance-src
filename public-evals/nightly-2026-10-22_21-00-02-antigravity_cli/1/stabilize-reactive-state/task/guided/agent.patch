+  <script type="module">
+    if (typeof Temporal === "undefined") {
+      try {
+        const module = await import("https://esm.sh/@js-temporal/polyfill");
+        globalThis.Temporal = module.Temporal;
+      } catch (e) {
+        console.error("Failed to load Temporal polyfill:", e);
+      }
+    }
+
+    const listEl = document.getElementById("deadline-list");
+    const statusEl = document.getElementById("tracker-status");
+
+    function createInitialEvents() {
+      // Shared baseline Temporal.PlainDateTime used across multiple launch tasks
+      const sharedBatchCutoff = Temporal.PlainDateTime.from("2026-11-15T14:00:00");
+      const winterTastingCutoff = Temporal.PlainDateTime.from("2026-11-20T17:00:00");
+
+      return [
+        {
+          id: "harvest-cupping",
+          title: "Autumn Harvest Cupping RSVP",
+          description: "Final guest list lock for our single-origin Ethiopian cupping session.",
+          baselineDeadline: sharedBatchCutoff,
+          deadline: sharedBatchCutoff,
+          extensionsCount: 0,
+        },
+        {
+          id: "roast-profile-lock",
+          title: "Roast Profile Submission",
+          description: "Head roaster sign-off sharing the initial batch cutoff timestamp.",
+          baselineDeadline: sharedBatchCutoff,
+          deadline: sharedBatchCutoff,
+          extensionsCount: 0,
+        },
+        {
+          id: "latte-art-throwdown",
+          title: "Community Latte Art Throwdown",
+          description: "Barista bracket registration and milk sponsor confirmation deadline.",
+          baselineDeadline: winterTastingCutoff,
+          deadline: winterTastingCutoff,
+          extensionsCount: 0,
+        },
+      ];
+    }
+
+    let trackerState = {
+      events: typeof Temporal !== "undefined" ? createInitialEvents() : [],
+    };
+
+    function formatPlainDateTime(dt) {
+      return dt.toLocaleString("en-US", {
+        month: "short",
+        day: "numeric",
+        year: "numeric",
+        hour: "numeric",
+        minute: "2-digit",
+      });
+    }
+
+    function updateState(nextState, announcement) {
+      // Reactive reference check: only re-render when state reference changes
+      if (nextState === trackerState) {
+        return;
+      }
+      trackerState = nextState;
+      renderTracker();
+      if (announcement && statusEl) {
+        statusEl.textContent = announcement;
+      }
+    }
+
+    function extendDeadline(eventId, durationLike, label) {
+      const target = trackerState.events.find((item) => item.id === eventId);
+      if (!target) return;
+
+      // Immutable Temporal update returns a brand-new PlainDateTime instance
+      const newDeadline = target.deadline.add(durationLike);
+
+      const nextEvents = trackerState.events.map((item) =>
+        item.id === eventId
+          ? {
+              ...item,
+              deadline: newDeadline,
+              extensionsCount: item.extensionsCount + 1,
+            }
+          : item
+      );
+
+      updateState(
+        { ...trackerState, events: nextEvents },
+        `Extended "${target.title}" by ${label} to ${formatPlainDateTime(newDeadline)}. Shared baseline (${formatPlainDateTime(target.baselineDeadline)}) remains unchanged.`
+      );
+    }
+
+    function resetDeadline(eventId) {
+      const target = trackerState.events.find((item) => item.id === eventId);
+      if (!target) return;
+
+      const restoredDeadline = target.baselineDeadline.with({});
+      const nextEvents = trackerState.events.map((item) =>
+        item.id === eventId
+          ? {
+              ...item,
+              deadline: restoredDeadline,
+              extensionsCount: 0,
+            }
+          : item
+      );
+
+      updateState(
+        { ...trackerState, events: nextEvents },
+        `Reset "${target.title}" to its original baseline of ${formatPlainDateTime(restoredDeadline)}.`
+      );
+    }
+
+    function renderTracker() {
+      if (!listEl) return;
+      listEl.innerHTML = "";
+
+      for (const item of trackerState.events) {
+        const li = document.createElement("li");
+        li.className = "tracker-card";
+        li.dataset.eventId = item.id;
+
+        const isExtended = Temporal.PlainDateTime.compare(item.deadline, item.baselineDeadline) !== 0;
+
+        li.innerHTML = `
+          <div>
+            <h3>${item.title}</h3>
+            <p>${item.description}</p>
+          </div>
+          <div class="deadline-meta">
+            <p><strong>Current Deadline:</strong> <time datetime="${item.deadline.toString()}">${formatPlainDateTime(item.deadline)}</time></p>
+            <p><strong>Original Baseline:</strong> <time datetime="${item.baselineDeadline.toString()}">${formatPlainDateTime(item.baselineDeadline)}</time></p>
+            <p><strong>Status:</strong> ${isExtended ? `Extended (${item.extensionsCount}x)` : "Original schedule (unmodified reference)"}</p>
+          </div>
+          <div class="deadline-actions">
+            <button type="button" class="btn-action" data-action="extend-hours" data-event-id="${item.id}" aria-label="Extend +1 Hour for ${item.title}">
+              Extend +1 Hour
+            </button>
+            <button type="button" class="btn-action" data-action="extend-day" data-event-id="${item.id}" aria-label="Extend +1 Day for ${item.title}">
+              Extend +1 Day
+            </button>
+            <button type="button" class="btn-action secondary" data-action="reset" data-event-id="${item.id}" aria-label="Reset ${item.title} to baseline">
+              Reset
+            </button>
+          </div>
+        `;
+
+        listEl.appendChild(li);
+      }
+    }
+
+    if (listEl) {
+      listEl.addEventListener("click", (event) => {
+        const button = event.target.closest("button[data-action]");
+        if (!button) return;
+        const { action, eventId } = button.dataset;
+        if (action === "extend-hours") {
+          extendDeadline(eventId, { hours: 1 }, "1 hour");
+        } else if (action === "extend-day") {
+          extendDeadline(eventId, { days: 1 }, "1 day");
+        } else if (action === "reset") {
+          resetDeadline(eventId);
+        }
+      });
+    }
+
+    renderTracker();
+  </script>
 </body>
 
