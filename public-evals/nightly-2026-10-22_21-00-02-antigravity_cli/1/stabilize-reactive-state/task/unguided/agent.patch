+                      <span class="date-label">Shared Baseline:</span>
+                      <span class="date-val" data-baseline-date="${escapeHtml(evt.id)}">
+                        ${escapeHtml(evt.originalDeadline.toString())} (${escapeHtml(formatReadableDate(evt.originalDeadline))})
+                      </span>
+                    </div>
+                    <div class="date-row">
+                      <span class="date-label">Active Deadline:</span>
+                      <span class="date-val ${isExtended ? 'extended-val' : ''}" data-current-date="${escapeHtml(evt.id)}">
+                        ${escapeHtml(evt.currentDeadline.toString())} (${escapeHtml(formatReadableDate(evt.currentDeadline))})
+                      </span>
+                    </div>
+                    <div class="date-row">
+                      <span class="date-label">Temporal Shift:</span>
+                      <span class="delta-pill ${isExtended ? 'extended' : 'unchanged'}" data-shift-days="${escapeHtml(evt.id)}">
+                        ${isExtended ? `+${daysExtended} day${daysExtended === 1 ? '' : 's'} (${evt.extensionsCount}x)` : 'Unmodified (+0d)'}
+                      </span>
+                    </div>
+                  </div>
+
+                  <div class="extension-actions">
+                    <button type="button" class="btn-extend" data-action="extend" data-event-id="${escapeHtml(evt.id)}" data-days="1" title="Create new Temporal.PlainDate via .add({ days: 1 })">
+                      +1 Day
+                    </button>
+                    <button type="button" class="btn-extend" data-action="extend" data-event-id="${escapeHtml(evt.id)}" data-days="3" title="Create new Temporal.PlainDate via .add({ days: 3 })">
+                      +3 Days
+                    </button>
+                    <button type="button" class="btn-extend btn-extend-accent" data-action="extend" data-event-id="${escapeHtml(evt.id)}" data-days="7" title="Create new Temporal.PlainDate via .add({ days: 7 })">
+                      +1 Week
+                    </button>
+                    <button type="button" class="btn-reset-card" data-action="reset" data-event-id="${escapeHtml(evt.id)}" ${!isExtended ? 'disabled' : ''}>
+                      Reset
+                    </button>
+                  </div>
+                </div>
+              </article>
+            `;
+          })
+          .join('');
+      }
+
+      // Reactive View 3: Shared Baseline vs Active Deadline Comparison Table
+      function renderComparisonTableView(currentState) {
+        const tbodyEl = document.getElementById('baseline-comparison-tbody');
+        if (!tbodyEl) return;
+
+        tbodyEl.innerHTML = currentState.events
+          .map(evt => {
+            const shiftDays = getDaysBetween(evt.originalDeadline, evt.currentDeadline);
+            const isExtended = shiftDays !== 0;
+            return `
+              <tr data-row-event-id="${escapeHtml(evt.id)}">
+                <td><strong>${escapeHtml(evt.title)}</strong></td>
+                <td>${escapeHtml(evt.sharedSeriesLabel)}</td>
+                <td><code>${escapeHtml(evt.originalDeadline.toString())}</code></td>
+                <td><code>${escapeHtml(evt.currentDeadline.toString())}</code></td>
+                <td>
+                  <span class="delta-pill ${isExtended ? 'extended' : 'unchanged'}">
+                    ${isExtended ? `+${shiftDays}d (New Instance)` : 'Same Baseline'}
+                  </span>
+                </td>
+              </tr>
+            `;
+          })
+          .join('');
+      }
+
+      // Reactive View 4: Immutable Temporal Audit Log View
+      function renderAuditLogView(currentState) {
+        const logListEl = document.getElementById('temporal-audit-log');
+        const badgeEl = document.getElementById('audit-count-badge');
+        if (!logListEl) return;
+
+        const updateCount = Math.max(0, currentState.auditLog.length - 1);
+        if (badgeEl) {
+          badgeEl.textContent = `${updateCount} Update${updateCount === 1 ? '' : 's'}`;
+        }
+
+        logListEl.innerHTML = currentState.auditLog
+          .map(
+            entry => `
+              <li class="audit-log-item">
+                <div>${escapeHtml(entry.message)}</div>
+                <div style="margin-top: 3px;"><span class="audit-code">${escapeHtml(entry.code)}</span></div>
+              </li>
+            `
+          )
+          .join('');
+      }
+
+      // Subscribe all reactive views to the immutable state store
+      subscribe(renderStatsView);
+      subscribe(renderCardsGridView);
+      subscribe(renderComparisonTableView);
+      subscribe(renderAuditLogView);
+
+      // Delegate click events for extending and resetting deadlines
+      const cardsGridEl = document.getElementById('deadline-cards-grid');
+      if (cardsGridEl) {
+        cardsGridEl.addEventListener('click', event => {
+          const btn = event.target.closest('button[data-action]');
+          if (!btn) return;
+          const action = btn.getAttribute('data-action');
+          const eventId = btn.getAttribute('data-event-id');
+
+          if (action === 'extend') {
+            const days = Number(btn.getAttribute('data-days')) || 1;
+            extendDeadline(eventId, { days });
+          } else if (action === 'reset') {
+            resetDeadline(eventId);
+          }
+        });
+      }
+
+      // Filter and Reset-All Controls
+      const categorySelect = document.getElementById('filter-category');
+      const statusSelect = document.getElementById('filter-status');
+      const searchInput = document.getElementById('filter-search');
+      const resetAllBtn = document.getElementById('btn-reset-all');
+
+      if (categorySelect) {
+        categorySelect.addEventListener('change', e => updateFilters({ category: e.target.value }));
+      }
+      if (statusSelect) {
+        statusSelect.addEventListener('change', e => updateFilters({ status: e.target.value }));
+      }
+      if (searchInput) {
+        searchInput.addEventListener('input', e => updateFilters({ search: e.target.value }));
+      }
+      if (resetAllBtn) {
+        resetAllBtn.addEventListener('click', () => resetAllDeadlines());
+      }
+
+      // Add New Event Form Handling
+      const addForm = document.getElementById('add-deadline-form');
+      const baselineSelect = document.getElementById('new-event-baseline');
+      const customDateInput = document.getElementById('new-event-date');
+
+      if (baselineSelect && customDateInput) {
+        const syncCustomDateField = () => {
+          const val = baselineSelect.value;
+          if (SHARED_BASELINES[val]) {
+            customDateInput.value = SHARED_BASELINES[val].date.toString();
+          }
+        };
+        baselineSelect.addEventListener('change', syncCustomDateField);
+        syncCustomDateField();
+      }
+
+      if (addForm) {
+        addForm.addEventListener('submit', e => {
+          e.preventDefault();
+          const titleInput = document.getElementById('new-event-title');
+          const catInput = document.getElementById('new-event-category');
+          const baseInput = document.getElementById('new-event-baseline');
+          const dateInput = document.getElementById('new-event-date');
+
+          const chosenBase = baseInput ? baseInput.value : 'custom';
+          const customISO = dateInput ? dateInput.value : '2026-11-10';
+          const matchesShared =
+            SHARED_BASELINES[chosenBase] &&
+            SHARED_BASELINES[chosenBase].date.toString() === customISO;
+
+          addEvent({
+            title: titleInput ? titleInput.value : '',
+            category: catInput ? catInput.value : 'Community Event',
+            baselineKey: matchesShared ? chosenBase : 'custom',
+            customDateISO: customISO
+          });
+
+          if (titleInput) titleInput.value = '';
+        });
+      }
+
+      // Expose programmatic API on window for external inspection or testing
+      window.DailyGrindDeadlineTracker = Object.freeze({
+        getState: () => state,
+        getSharedBaselines: () => SHARED_BASELINES,
+        extendDeadline,
+        resetDeadline,
+        resetAllDeadlines,
+        addEvent,
+        subscribe
+      });
+    })();
+  </script>
 </body>
 
 </html>
