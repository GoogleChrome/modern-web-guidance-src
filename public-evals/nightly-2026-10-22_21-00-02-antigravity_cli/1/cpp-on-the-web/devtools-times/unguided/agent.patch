index 0000000..ff62dca
--- /dev/null
+++ b/src/wasm/smallpt.cpp
@@ -0,0 +1,251 @@
+// smallpt, a Path Tracer by Kevin Beason, 2008
+// Compiled to WebAssembly via Emscripten for real-time interactive client-side rendering.
+#include <math.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#else
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+
+struct Vec {        // Usage: time ./smallpt 5000 && xv image.ppm
+  double x, y, z;                  // position, also color (r,g,b)
+  Vec(double x_=0, double y_=0, double z_=0){ x=x_; y=y_; z=z_; }
+  Vec operator+(const Vec &b) const { return Vec(x+b.x,y+b.y,z+b.z); }
+  Vec operator-(const Vec &b) const { return Vec(x-b.x,y-b.y,z-b.z); }
+  Vec operator*(double b) const { return Vec(x*b,y*b,z*b); }
+  Vec mult(const Vec &b) const { return Vec(x*b.x,y*b.y,z*b.z); }
+  Vec& norm(){ return *this = *this * (1/sqrt(x*x+y*y+z*z)); }
+  double dot(const Vec &b) const { return x*b.x+y*b.y+z*b.z; } // cross:
+  Vec operator%(Vec&b){return Vec(y*b.z-z*b.y,z*b.x-x*b.z,x*b.y-y*b.x);}
+};
+
+struct Ray { Vec o, d; Ray(Vec o_, Vec d_) : o(o_), d(d_) {} };
+enum Refl_t { DIFF, SPEC, REFR };  // material types, used in radiance()
+
+struct Sphere {
+  double rad;       // radius
+  Vec p, e, c;      // position, emission, color
+  Refl_t refl;      // reflection type (DIFFuse, SPECular, REFRactive)
+  Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_):
+    rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+  double intersect(const Ray &r) const { // returns distance, 0 if nohit
+    Vec op = p-r.o; // Solve t^2*d.d + 2*t*(o-p).d + (o-p).(o-p)-R^2 = 0
+    double t, eps=1e-4, b=op.dot(r.d), det=b*b-op.dot(op)+rad*rad;
+    if (det<0) return 0; else det=sqrt(det);
+    return (t=b-det)>eps ? t : ((t=b+det)>eps ? t : 0);
+  }
+};
+
+Sphere spheres[] = {//Scene: radius, position, emission, color, material
+  Sphere(1e5, Vec( 1e5+1,40.8,81.6), Vec(),Vec(.75,.25,.25),DIFF),//Left (0)
+  Sphere(1e5, Vec(-1e5+99,40.8,81.6),Vec(),Vec(.25,.25,.75),DIFF),//Rght (1)
+  Sphere(1e5, Vec(50,40.8, 1e5),     Vec(),Vec(.75,.75,.75),DIFF),//Back (2)
+  Sphere(1e5, Vec(50,40.8,-1e5+170), Vec(),Vec(),           DIFF),//Frnt (3)
+  Sphere(1e5, Vec(50, 1e5, 81.6),    Vec(),Vec(.75,.75,.75),DIFF),//Botm (4)
+  Sphere(1e5, Vec(50,-1e5+81.6,81.6),Vec(),Vec(.75,.75,.75),DIFF),//Top  (5)
+  Sphere(16.5,Vec(27,16.5,47),       Vec(),Vec(1,1,1)*.999, SPEC),//Mirr (6)
+  Sphere(16.5,Vec(73,16.5,78),       Vec(),Vec(1,1,1)*.999, REFR),//Glas (7)
+  Sphere(600, Vec(50,681.6-.27,81.6),Vec(12,12,12),  Vec(), DIFF) //Lite (8)
+};
+
+inline double clamp(double x){ return x<0 ? 0 : x>1 ? 1 : x; }
+inline int toInt(double x){ return int(pow(clamp(x),1/2.2)*255+.5); }
+inline bool intersect(const Ray &r, double &t, int &id){
+  double n=sizeof(spheres)/sizeof(Sphere), d, inf=t=1e20;
+  for(int i=int(n);i--;) if((d=spheres[i].intersect(r))&&d<t){t=d;id=i;}
+  return t<inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi){
+  double t;                               // distance to intersection
+  int id=0;                               // id of intersected object
+  if (!intersect(r, t, id)) return Vec(); // if miss, return black
+  const Sphere &obj = spheres[id];        // the hit object
+  Vec x=r.o+r.d*t, n=(x-obj.p).norm(), nl=n.dot(r.d)<0?n:n*-1, f=obj.c;
+  double p = f.x>f.y && f.x>f.z ? f.x : f.y>f.z ? f.y : f.z; // max refl
+  if (++depth>5) {
+    if (depth>12) return obj.e; // prevent stack overflow in deeply nested dielectric bounces
+    if (erand48(Xi)<p) f=f*(1/p); else return obj.e; //R.R.
+  }
+  if (obj.refl == DIFF){                  // Ideal DIFFUSE reflection
+    double r1=2*M_PI*erand48(Xi), r2=erand48(Xi), r2s=sqrt(r2);
+    Vec w=nl, u=((fabs(w.x)>.1?Vec(0,1):Vec(1))%w).norm(), v=w%u;
+    Vec d = (u*cos(r1)*r2s + v*sin(r1)*r2s + w*sqrt(1-r2)).norm();
+    return obj.e + f.mult(radiance(Ray(x,d),depth,Xi));
+  } else if (obj.refl == SPEC)            // Ideal SPECULAR reflection
+    return obj.e + f.mult(radiance(Ray(x,r.d-n*2*n.dot(r.d)),depth,Xi));
+  Ray reflRay(x, r.d-n*2*n.dot(r.d));     // Ideal dielectric REFRACTION
+  bool into = n.dot(nl)>0;                // Ray from outside going in?
+  double nc=1, nt=1.5, nnt=into?nc/nt:nt/nc, ddn=r.d.dot(nl), cos2t;
+  if ((cos2t=1-nnt*nnt*(1-ddn*ddn))<0)    // Total internal reflection
+    return obj.e + f.mult(radiance(reflRay,depth,Xi));
+  Vec tdir = (r.d*nnt - n*((into?1:-1)*(ddn*nnt+sqrt(cos2t)))).norm();
+  double a=nt-nc, b=nt+nc, R0=a*a/(b*b), c = 1-(into?-ddn:tdir.dot(n));
+  double Re=R0+(1-R0)*c*c*c*c*c,Tr=1-Re,P=.25+.5*Re,RP=Re/P,TP=Tr/(1-P);
+  return obj.e + f.mult(depth>2 ? (erand48(Xi)<P ?   // Russian roulette
+    radiance(reflRay,depth,Xi)*RP:radiance(Ray(x,tdir),depth,Xi)*TP) :
+    radiance(reflRay,depth,Xi)*Re+radiance(Ray(x,tdir),depth,Xi)*Tr);
+}
+
+// Persistent accumulation buffers for progressive & one-shot rendering
+static int g_width = 0;
+static int g_height = 0;
+static int g_total_samples = 0; // total subpixel samples accumulated (in units of 4x subpixels)
+static Vec *g_accum = nullptr;
+static uint8_t *g_rgba = nullptr;
+static unsigned int g_seed_offset = 0;
+
+extern "C" {
+
+static double rand_range(unsigned int *state, double min_val, double max_val) {
+  *state = *state * 1664525u + 1013904223u;
+  double t = (double)(*state & 0xFFFFFF) / (double)0x1000000;
+  return min_val + t * (max_val - min_val);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_scene_colors() {
+  spheres[0].c = Vec(.75, .25, .25);      // Left wall
+  spheres[1].c = Vec(.25, .25, .75);      // Right wall
+  spheres[2].c = Vec(.75, .75, .75);      // Back wall
+  spheres[3].c = Vec(0, 0, 0);            // Front wall
+  spheres[4].c = Vec(.75, .75, .75);      // Bottom wall
+  spheres[5].c = Vec(.75, .75, .75);      // Top wall
+  spheres[6].c = Vec(1, 1, 1) * .999;     // Mirror sphere
+  spheres[7].c = Vec(1, 1, 1) * .999;     // Glass sphere
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_scene_colors(unsigned int seed) {
+  unsigned int st = seed ? seed : 1337u;
+  // Left wall (sphere 0) - vibrant color
+  spheres[0].c = Vec(rand_range(&st, 0.15, 0.90), rand_range(&st, 0.15, 0.90), rand_range(&st, 0.15, 0.90));
+  // Right wall (sphere 1) - vibrant color
+  spheres[1].c = Vec(rand_range(&st, 0.15, 0.90), rand_range(&st, 0.15, 0.90), rand_range(&st, 0.15, 0.90));
+  // Back wall (sphere 2) - tinted pastel/vivid surface
+  spheres[2].c = Vec(rand_range(&st, 0.35, 0.90), rand_range(&st, 0.35, 0.90), rand_range(&st, 0.35, 0.90));
+  // Bottom floor (sphere 4) - softly tinted
+  spheres[4].c = Vec(rand_range(&st, 0.45, 0.85), rand_range(&st, 0.45, 0.85), rand_range(&st, 0.45, 0.85));
+  // Top ceiling (sphere 5) - bright neutral/pastel
+  spheres[5].c = Vec(rand_range(&st, 0.65, 0.92), rand_range(&st, 0.65, 0.92), rand_range(&st, 0.65, 0.92));
+  // Mirror sphere (sphere 6) - colored metallic tint
+  spheres[6].c = Vec(rand_range(&st, 0.45, 0.999), rand_range(&st, 0.45, 0.999), rand_range(&st, 0.45, 0.999));
+  // Glass sphere (sphere 7) - colored refractive glass tint
+  spheres[7].c = Vec(rand_range(&st, 0.50, 0.999), rand_range(&st, 0.50, 0.999), rand_range(&st, 0.50, 0.999));
+}
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+  if (index >= 0 && index < 9) {
+    spheres[index].c = Vec(clamp(r), clamp(g), clamp(b));
+  }
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_channel(int index, int channel) {
+  if (index < 0 || index >= 9) return 0.0;
+  if (channel == 0) return spheres[index].c.x;
+  if (channel == 1) return spheres[index].c.y;
+  if (channel == 2) return spheres[index].c.z;
+  return 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void init_renderer(int w, int h, unsigned int seed) {
+  if (g_width != w || g_height != h || !g_accum || !g_rgba) {
+    delete[] g_accum;
+    delete[] g_rgba;
+    g_width = w;
+    g_height = h;
+    g_accum = new Vec[w * h];
+    g_rgba = new uint8_t[w * h * 4];
+  }
+  for (int i = 0; i < w * h; i++) {
+    g_accum[i] = Vec(0, 0, 0);
+    g_rgba[i * 4 + 0] = 0;
+    g_rgba[i * 4 + 1] = 0;
+    g_rgba[i * 4 + 2] = 0;
+    g_rgba[i * 4 + 3] = 255;
+  }
+  g_total_samples = 0;
+  g_seed_offset = seed;
+}
+
+// Render one progressive pass of `samps_per_subpixel` (1 pass = 4 spp because of 2x2 subpixels)
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_pass(int samps_per_subpixel) {
+  if (!g_accum || !g_rgba || g_width <= 0 || g_height <= 0) return nullptr;
+  int w = g_width;
+  int h = g_height;
+  int samps = samps_per_subpixel < 1 ? 1 : samps_per_subpixel;
+
+  Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+  Vec cx = Vec(w * .5135 / h);
+  Vec cy = (cx % cam.d).norm() * .5135;
+  Vec r;
+
+  unsigned int pass_seed = g_seed_offset + (unsigned int)(g_total_samples * 7919);
+
+  for (int y = 0; y < h; y++) {
+    unsigned short Xi[3] = {
+      (unsigned short)((y + pass_seed) & 0xFFFF),
+      (unsigned short)((y * 31 + pass_seed * 17) & 0xFFFF),
+      (unsigned short)((y * y * y + pass_seed * 131) & 0xFFFF)
+    };
+    for (unsigned short x = 0; x < w; x++) {
+      int i = (h - y - 1) * w + x;
+      Vec pixel_sample(0, 0, 0);
+      for (int sy = 0; sy < 2; sy++) {
+        for (int sx = 0; sx < 2; sx++, r = Vec()) {
+          for (int s = 0; s < samps; s++) {
+            double r1 = 2 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1 : 1 - sqrt(2 - r1);
+            double r2 = 2 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1 : 1 - sqrt(2 - r2);
+            Vec d = cx * (((sx + .5 + dx) / 2 + x) / w - .5) +
+                    cy * (((sy + .5 + dy) / 2 + y) / h - .5) + cam.d;
+            r = r + radiance(Ray(cam.o + d * 140, d.norm()), 0, Xi) * (1. / samps);
+          }
+          pixel_sample = pixel_sample + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+        }
+      }
+      g_accum[i] = g_accum[i] + pixel_sample;
+    }
+  }
+
+  g_total_samples += 1;
+  double inv_passes = 1.0 / (double)g_total_samples;
+
+  for (int i = 0; i < w * h; i++) {
+    Vec avg = g_accum[i] * inv_passes;
+    g_rgba[i * 4 + 0] = (uint8_t)toInt(avg.x);
+    g_rgba[i * 4 + 1] = (uint8_t)toInt(avg.y);
+    g_rgba[i * 4 + 2] = (uint8_t)toInt(avg.z);
+    g_rgba[i * 4 + 3] = 255;
+  }
+
+  return g_rgba;
+}
+
+// Convenience single-call render for N total samples per pixel
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_smallpt(int w, int h, int total_spp, unsigned int seed) {
+  init_renderer(w, h, seed);
+  int samps = total_spp / 4;
+  if (samps < 1) samps = 1;
+  return render_pass(samps);
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* get_rgba_buffer() {
+  return g_rgba;
+}
+
+EMSCRIPTEN_KEEPALIVE
+int get_total_spp() {
+  return g_total_samples * 4;
+}
+
+} // extern "C"
