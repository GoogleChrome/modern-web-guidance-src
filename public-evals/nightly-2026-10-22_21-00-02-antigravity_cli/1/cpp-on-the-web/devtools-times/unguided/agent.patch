+++ b/src/components/SmallptPathTracer.tsx
@@ -0,0 +1,340 @@
+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColorInfo {
+  index: number;
+  name: string;
+  role: string;
+  rgb: [number, number, number];
+}
+
+interface SmallptWasmExports {
+  memory: WebAssembly.Memory;
+  _initialize?: () => void;
+  reset_scene_colors: () => void;
+  randomize_scene_colors: (seed: number) => void;
+  set_sphere_color: (index: number, r: number, g: number, b: number) => void;
+  get_sphere_color_channel: (index: number, channel: number) => number;
+  init_renderer: (w: number, h: number, seed: number) => void;
+  render_pass: (sampsPerSubpixel: number) => number;
+  render_smallpt: (w: number, h: number, totalSpp: number, seed: number) => number;
+  get_rgba_buffer: () => number;
+  get_total_spp: () => number;
+}
+
+const SPHERE_METADATA: { index: number; name: string; role: string }[] = [
+  { index: 0, name: 'Left Wall Sphere', role: 'Diffuse (1e5 rad)' },
+  { index: 1, name: 'Right Wall Sphere', role: 'Diffuse (1e5 rad)' },
+  { index: 2, name: 'Back Wall Sphere', role: 'Diffuse (1e5 rad)' },
+  { index: 4, name: 'Floor Sphere', role: 'Diffuse (1e5 rad)' },
+  { index: 6, name: 'Mirror Sphere', role: 'Specular (16.5 rad)' },
+  { index: 7, name: 'Glass Sphere', role: 'Refractive (16.5 rad)' },
+];
+
+const RENDER_WIDTH = 320;
+const RENDER_HEIGHT = 240;
+const TARGET_PASSES = 6; // 6 passes * 4 subpixel samples = 24 spp progressive convergence
+
+const toHex = (r: number, g: number, b: number) => {
+  const clampByte = (v: number) => Math.max(0, Math.min(255, Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255)));
+  return (
+    '#' +
+    [clampByte(r), clampByte(g), clampByte(b)]
+      .map((x) => x.toString(16).padStart(2, '0'))
+      .join('')
+  );
+};
+
+interface Props {
+  wasmUrl?: string;
+}
+
+export const SmallptPathTracer: React.FC<Props> = ({ wasmUrl }) => {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const wasmRef = useRef<SmallptWasmExports | null>(null);
+  const animFrameRef = useRef<number | null>(null);
+  const passCountRef = useRef<number>(0);
+
+  const [status, setStatus] = useState<'loading' | 'rendering' | 'ready' | 'error'>('loading');
+  const [errorMsg, setErrorMsg] = useState<string | null>(null);
+  const [currentSpp, setCurrentSpp] = useState<number>(0);
+  const [renderTimeMs, setRenderTimeMs] = useState<number>(0);
+  const [sphereColors, setSphereColors] = useState<SphereColorInfo[]>([]);
+  const [renderRunId, setRenderRunId] = useState<number>(0);
+
+  const readSphereColorsFromWasm = useCallback((exports: SmallptWasmExports): SphereColorInfo[] => {
+    return SPHERE_METADATA.map((meta) => ({
+      ...meta,
+      rgb: [
+        exports.get_sphere_color_channel(meta.index, 0),
+        exports.get_sphere_color_channel(meta.index, 1),
+        exports.get_sphere_color_channel(meta.index, 2),
+      ],
+    }));
+  }, []);
+
+  const drawPassToCanvas = useCallback((exports: SmallptWasmExports, ptr: number) => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    const ctx = canvas.getContext('2d');
+    if (!ctx) return;
+
+    const byteLength = RENDER_WIDTH * RENDER_HEIGHT * 4;
+    const pixelView = new Uint8ClampedArray(exports.memory.buffer, ptr, byteLength);
+    const imageData = new ImageData(new Uint8ClampedArray(pixelView), RENDER_WIDTH, RENDER_HEIGHT);
+    ctx.putImageData(imageData, 0, 0);
+  }, []);
+
+  const startProgressiveRender = useCallback(
+    (seed: number) => {
+      const exports = wasmRef.current;
+      if (!exports) return;
+
+      if (animFrameRef.current !== null) {
+        cancelAnimationFrame(animFrameRef.current);
+        animFrameRef.current = null;
+      }
+
+      exports.init_renderer(RENDER_WIDTH, RENDER_HEIGHT, seed);
+      setSphereColors(readSphereColorsFromWasm(exports));
+      passCountRef.current = 0;
+
+      const t0 = performance.now();
+      // Immediately execute the first pass synchronously so the canvas has output right away
+      const firstPtr = exports.render_pass(1);
+      drawPassToCanvas(exports, firstPtr);
+      passCountRef.current = 1;
+      const firstElapsed = Math.round(performance.now() - t0);
+      setCurrentSpp(exports.get_total_spp());
+      setRenderTimeMs(firstElapsed);
+      setStatus('rendering');
+
+      let totalElapsed = firstElapsed;
+
+      const step = () => {
+        if (!wasmRef.current) return;
+        if (passCountRef.current >= TARGET_PASSES) {
+          setStatus('ready');
+          return;
+        }
+        const passStart = performance.now();
+        const ptr = wasmRef.current.render_pass(1);
+        drawPassToCanvas(wasmRef.current, ptr);
+        passCountRef.current += 1;
+        totalElapsed += Math.round(performance.now() - passStart);
+        setCurrentSpp(wasmRef.current.get_total_spp());
+        setRenderTimeMs(totalElapsed);
+
+        if (passCountRef.current < TARGET_PASSES) {
+          animFrameRef.current = requestAnimationFrame(step);
+        } else {
+          setStatus('ready');
+          animFrameRef.current = null;
+        }
+      };
+
+      animFrameRef.current = requestAnimationFrame(step);
+    },
+    [drawPassToCanvas, readSphereColorsFromWasm]
+  );
+
+  useEffect(() => {
+    let cancelled = false;
+
+    async function loadWasm() {
+      try {
+        const resolvedUrl =
+          wasmUrl ||
+          `${import.meta.env.BASE_URL || '/'}smallpt.wasm`.replace(/\/+/g, '/');
+
+        const response = await fetch(resolvedUrl);
+        if (!response.ok) {
+          throw new Error(`Failed to fetch smallpt.wasm (${response.status})`);
+        }
+        const wasmBytes = await response.arrayBuffer();
+        const imports = {
+          env: {
+            emscripten_notify_memory_growth: () => {},
+          },
+          wasi_snapshot_preview1: {
+            proc_exit: () => {},
+            fd_close: () => 0,
+            fd_write: () => 0,
+            fd_seek: () => 0,
+          },
+        };
+
+        const { instance } = await WebAssembly.instantiate(wasmBytes, imports);
+        if (cancelled) return;
+
+        const exports = instance.exports as unknown as SmallptWasmExports;
+        if (typeof exports._initialize === 'function') {
+          exports._initialize();
+        }
+        exports.reset_scene_colors();
+        wasmRef.current = exports;
+
+        startProgressiveRender(1337);
+      } catch (err: any) {
+        if (!cancelled) {
+          console.error('Error initializing smallpt WebAssembly module:', err);
+          setErrorMsg(err?.message || 'Failed to initialize WebAssembly path tracer.');
+          setStatus('error');
+        }
+      }
+    }
+
+    loadWasm();
+
+    return () => {
+      cancelled = true;
+      if (animFrameRef.current !== null) {
+        cancelAnimationFrame(animFrameRef.current);
+      }
+    };
+  }, [wasmUrl, startProgressiveRender]);
+
+  const handleRandomizeSphereColors = () => {
+    const exports = wasmRef.current;
+    if (!exports) return;
+
+    const randomSeed = Math.floor(Math.random() * 0x7fffffff) + 1;
+    exports.randomize_scene_colors(randomSeed);
+
+    // Also allow fine-tuned vibrant RGB randomization from JS using set_sphere_color
+    const randomChannel = (min: number, max: number) => min + Math.random() * (max - min);
+    // Left & Right walls: rich saturated contrasting colors
+    exports.set_sphere_color(0, randomChannel(0.15, 0.95), randomChannel(0.15, 0.95), randomChannel(0.15, 0.95));
+    exports.set_sphere_color(1, randomChannel(0.15, 0.95), randomChannel(0.15, 0.95), randomChannel(0.15, 0.95));
+    // Back & Floor walls: subtle tinted surfaces
+    exports.set_sphere_color(2, randomChannel(0.35, 0.9), randomChannel(0.35, 0.9), randomChannel(0.35, 0.9));
+    exports.set_sphere_color(4, randomChannel(0.45, 0.9), randomChannel(0.45, 0.9), randomChannel(0.45, 0.9));
+    // Mirror & Glass spheres: vivid metallic & dielectric tints
+    exports.set_sphere_color(6, randomChannel(0.45, 0.999), randomChannel(0.45, 0.999), randomChannel(0.45, 0.999));
+    exports.set_sphere_color(7, randomChannel(0.45, 0.999), randomChannel(0.45, 0.999), randomChannel(0.45, 0.999));
+
+    setRenderRunId((prev) => prev + 1);
+    startProgressiveRender(randomSeed);
+  };
+
+  const handleResetDefaultColors = () => {
+    const exports = wasmRef.current;
+    if (!exports) return;
+    exports.reset_scene_colors();
+    setRenderRunId((prev) => prev + 1);
+    startProgressiveRender(1337);
+  };
+
+  return (
+    <section
+      id="smallpt-wasm-section"
+      className="bg-white border border-gray-200 rounded-lg shadow-sm p-5 md:p-6 my-6"
+    >
+      <div className="flex flex-col lg:flex-row gap-6 items-start">
+        {/* Left column: Rendered Canvas */}
+        <div className="w-full lg:w-7/12 flex flex-col items-center">
+          <div className="relative w-full overflow-hidden rounded-md border border-gray-900 bg-black aspect-[4/3] shadow-inner">
+            <canvas
+              ref={canvasRef}
+              id="smallpt-canvas"
+              width={RENDER_WIDTH}
+              height={RENDER_HEIGHT}
+              data-status={status}
+              data-spp={currentSpp}
+              data-run-id={renderRunId}
+              className="w-full h-full object-contain block"
+            />
+            {status === 'loading' && (
+              <div className="absolute inset-0 flex items-center justify-center bg-black/75 text-white text-sm font-medium">
+                Compiling &amp; running smallpt.wasm...
+              </div>
+            )}
+            {status === 'error' && (
+              <div className="absolute inset-0 flex items-center justify-center bg-red-950/90 text-red-200 p-4 text-center text-sm">
+                {errorMsg}
+              </div>
+            )}
+            <div className="absolute bottom-2 right-2 bg-black/75 text-white text-xs font-mono px-2.5 py-1 rounded">
+              {RENDER_WIDTH}&times;{RENDER_HEIGHT} &bull; {currentSpp} spp &bull; {renderTimeMs} ms
+              {status === 'rendering' ? ' (refining...)' : ''}
+            </div>
+          </div>
+        </div>
+
+        {/* Right column: Description, Controls, and Active Sphere Palette */}
+        <div className="w-full lg:w-5/12 flex flex-col justify-between space-y-4">
+          <div>
+            <div className="flex items-center space-x-2">
+              <span className="inline-block bg-amber-100 text-amber-900 text-xs font-semibold px-2.5 py-0.5 rounded uppercase tracking-wider">
+                WebAssembly Graphics Lab
+              </span>
+              <span className="text-xs font-mono text-gray-500">smallpt.wasm</span>
+            </div>
+
+            <h2 className="mt-2 text-2xl md:text-3xl font-brand text-gray-900 leading-tight">
+              Interactive C++ Path Tracer (smallpt)
+            </h2>
+
+            <p className="mt-2 text-sm text-gray-600 leading-relaxed">
+              Kevin Beason&apos;s 99-line C++ global illumination renderer compiled to WebAssembly.
+              Simulates Monte Carlo path tracing, diffuse Cornell box walls, a specular mirror
+              sphere, and a refractive dielectric glass sphere directly in your browser.
+            </p>
+          </div>
+
+          {/* Sphere Color Swatches */}
+          <div className="border-t border-b border-gray-100 py-3">
+            <h3 className="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-2">
+              Current Scene Sphere Colors
+            </h3>
+            <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
+              {sphereColors.map((sphere) => {
+                const hex = toHex(sphere.rgb[0], sphere.rgb[1], sphere.rgb[2]);
+                return (
+                  <div
+                    key={sphere.index}
+                    className="flex items-center space-x-2 bg-gray-50 border border-gray-200 rounded px-2 py-1.5"
+                  >
+                    <span
+                      className="w-4 h-4 rounded-full border border-gray-300 flex-shrink-0"
+                      style={{ backgroundColor: hex }}
+                      title={`RGB(${sphere.rgb.map((n) => n.toFixed(2)).join(', ')})`}
+                    />
+                    <div className="min-w-0">
+                      <p className="text-xs font-medium text-gray-800 truncate">{sphere.name}</p>
+                      <p className="text-[10px] font-mono text-gray-500">{hex}</p>
+                    </div>
+                  </div>
+                );
+              })}
+            </div>
+          </div>
+
+          {/* Action Buttons */}
+          <div className="flex flex-wrap items-center gap-3 pt-1">
+            <button
+              type="button"
+              id="randomize-spheres-btn"
+              onClick={handleRandomizeSphereColors}
+              disabled={status === 'loading'}
+              className="bg-amber-500 hover:bg-amber-600 active:bg-amber-700 disabled:opacity-50 text-gray-950 font-semibold text-sm px-4 py-2.5 rounded shadow-sm transition-colors cursor-pointer"
+            >
+              Randomize Sphere Colors
+            </button>
+
+            <button
+              type="button"
+              id="reset-spheres-btn"
+              onClick={handleResetDefaultColors}
+              disabled={status === 'loading'}
+              className="bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium text-sm px-3.5 py-2.5 rounded border border-gray-300 transition-colors cursor-pointer"
+            >
+              Reset Classic Scene
+            </button>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+};
+
+export default SmallptPathTracer;
