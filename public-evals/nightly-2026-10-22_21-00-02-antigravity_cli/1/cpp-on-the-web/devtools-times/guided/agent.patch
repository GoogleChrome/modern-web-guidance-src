+import React, { useEffect, useRef, useState, useCallback } from 'react';
+
+interface SphereColorInfo {
+  name: string;
+  rgb: [number, number, number];
+}
+
+const SPHERE_NAMES: { index: number; name: string }[] = [
+  { index: 0, name: 'Left Wall' },
+  { index: 1, name: 'Right Wall' },
+  { index: 2, name: 'Back Wall' },
+  { index: 4, name: 'Floor' },
+  { index: 5, name: 'Ceiling' },
+  { index: 6, name: 'Mirror Sphere' },
+  { index: 7, name: 'Glass Sphere' },
+];
+
+export default function SmallptPathTracer({ baseUrl = '/devtools-times/' }: { baseUrl?: string }) {
+  const canvasRef = useRef<HTMLCanvasElement | null>(null);
+  const workerRef = useRef<Worker | null>(null);
+  const wasmModRef = useRef<any>(null);
+  const renderIdRef = useRef<number>(0);
+
+  const [width, setWidth] = useState<number>(240);
+  const [height, setHeight] = useState<number>(180);
+  const [samples, setSamples] = useState<number>(4);
+  const [isRendering, setIsRendering] = useState<boolean>(true);
+  const [progress, setProgress] = useState<number>(0);
+  const [renderTimeMs, setRenderTimeMs] = useState<number | null>(null);
+  const [sphereColors, setSphereColors] = useState<SphereColorInfo[]>([
+    { name: 'Left Wall', rgb: [191, 64, 64] },
+    { name: 'Right Wall', rgb: [64, 64, 191] },
+    { name: 'Back Wall', rgb: [191, 191, 191] },
+    { name: 'Floor', rgb: [191, 191, 191] },
+    { name: 'Ceiling', rgb: [191, 191, 191] },
+    { name: 'Mirror Sphere', rgb: [255, 255, 255] },
+    { name: 'Glass Sphere', rgb: [255, 255, 255] },
+  ]);
+  const [errorMsg, setErrorMsg] = useState<string | null>(null);
+
+  const normalizedBase = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
+  const wasmJsUrl = `${normalizedBase}wasm/smallpt.js`;
+
+  const extractPaletteFromMod = (mod: any): SphereColorInfo[] => {
+    return SPHERE_NAMES.map(({ index, name }) => {
+      const r = Math.round(mod._get_sphere_color_channel(index, 0) * 255);
+      const g = Math.round(mod._get_sphere_color_channel(index, 1) * 255);
+      const b = Math.round(mod._get_sphere_color_channel(index, 2) * 255);
+      return { name, rgb: [r, g, b] };
+    });
+  };
+
+  const paintBufferToCanvas = useCallback((rgbaBytes: Uint8ClampedArray, w: number, h: number) => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    if (canvas.width !== w) canvas.width = w;
+    if (canvas.height !== h) canvas.height = h;
+    const ctx = canvas.getContext('2d');
+    if (!ctx) return;
+    const imgData = new ImageData(new Uint8ClampedArray(rgbaBytes), w, h);
+    ctx.putImageData(imgData, 0, 0);
+  }, []);
+
+  const runFallbackMainThreadRender = useCallback(
+    async (
+      mode: 'default' | 'randomize' | 'current',
+      w: number,
+      h: number,
+      samps: number,
+      seed: number,
+      currentRenderId: number
+    ) => {
+      try {
+        if (!wasmModRef.current) {
+          const fullUrl = new URL(wasmJsUrl, window.location.origin).href;
+          const modFactory = (await import(/* @vite-ignore */ fullUrl)).default;
+          wasmModRef.current = await modFactory();
+        }
+        const mod = wasmModRef.current;
+        if (currentRenderId !== renderIdRef.current) return;
+
+        if (mode === 'default') {
+          mod._reset_default_colors();
+        } else if (mode === 'randomize') {
+          mod._randomize_sphere_colors(seed);
+        }
+        setSphereColors(extractPaletteFromMod(mod));
+
+        const t0 = performance.now();
+        mod._init_render(w, h);
+        const chunkRows = 15;
+
+        for (let y = 0; y < h; y += chunkRows) {
+          if (currentRenderId !== renderIdRef.current) return;
+          const yEnd = Math.min(y + chunkRows, h);
+          const ptr = mod._render_rows(w, h, samps, y, yEnd);
+          const view = new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, w * h * 4);
+          paintBufferToCanvas(view, w, h);
+          setProgress(Math.round((yEnd / h) * 100));
+          await new Promise((r) => setTimeout(r, 0));
+        }
+
+        const t1 = performance.now();
+        setRenderTimeMs(Math.round(t1 - t0));
+        setIsRendering(false);
+      } catch (err: any) {
+        console.error('Wasm fallback error:', err);
+        setErrorMsg(err?.message || 'Failed to run WebAssembly path tracer.');
+        setIsRendering(false);
+      }
+    },
+    [wasmJsUrl, paintBufferToCanvas]
+  );
+
+  const triggerRender = useCallback(
+    (mode: 'default' | 'randomize' | 'current', customSamps?: number, customW?: number, customH?: number) => {
+      const w = customW ?? width;
+      const h = customH ?? height;
+      const samps = customSamps ?? samples;
+      const seed = Math.floor(Math.random() * 0xffffffff);
+
+      renderIdRef.current += 1;
+      const currentRenderId = renderIdRef.current;
+
+      setIsRendering(true);
+      setProgress(0);
+      setErrorMsg(null);
+
+      if (workerRef.current) {
+        workerRef.current.postMessage({
+          type: 'RENDER',
+          renderId: currentRenderId,
+          mode,
+          width: w,
+          height: h,
+          samples: samps,
+          seed,
+        });
+      } else {
+        runFallbackMainThreadRender(mode, w, h, samps, seed, currentRenderId);
+      }
+    },
+    [width, height, samples, runFallbackMainThreadRender]
+  );
+
+  useEffect(() => {
+    const fullWasmJsUrl = new URL(wasmJsUrl, window.location.origin).href;
+    const workerCode = `
+      let mod = null;
+      let activeRenderId = 0;
+      const SPHERE_NAMES = ${JSON.stringify(SPHERE_NAMES)};
+
+      function getPalette(m) {
+        return SPHERE_NAMES.map(({ index, name }) => ({
+          name,
+          rgb: [
+            Math.round(m._get_sphere_color_channel(index, 0) * 255),
+            Math.round(m._get_sphere_color_channel(index, 1) * 255),
+            Math.round(m._get_sphere_color_channel(index, 2) * 255),
+          ]
+        }));
+      }
+
+      self.onmessage = async (e) => {
+        const msg = e.data;
+        if (msg.type === 'RENDER') {
+          activeRenderId = msg.renderId;
+          const { renderId, mode, width, height, samples, seed } = msg;
+          try {
+            if (!mod) {
+              const factory = (await import(${JSON.stringify(fullWasmJsUrl)})).default;
+              mod = await factory();
+            }
+            if (renderId !== activeRenderId) return;
+
+            if (mode === 'default') {
+              mod._reset_default_colors();
+            } else if (mode === 'randomize') {
+              mod._randomize_sphere_colors(seed);
+            }
+
+            const palette = getPalette(mod);
+            self.postMessage({ type: 'PALETTE', renderId, palette });
+
+            const t0 = performance.now();
+            mod._init_render(width, height);
+            const chunkRows = 15;
+
+            for (let y = 0; y < height; y += chunkRows) {
+              if (renderId !== activeRenderId) return;
+              const yEnd = Math.min(y + chunkRows, height);
+              const ptr = mod._render_rows(width, height, samples, y, yEnd);
+              const copy = new Uint8ClampedArray(width * height * 4);
+              copy.set(new Uint8ClampedArray(mod.HEAPU8.buffer, ptr, width * height * 4));
+              self.postMessage(
+                {
+                  type: 'PROGRESS',
+                  renderId,
+                  width,
+                  height,
+                  progress: Math.round((yEnd / height) * 100),
+                  buffer: copy.buffer,
+                },
+                [copy.buffer]
+              );
+              await new Promise((r) => setTimeout(r, 0));
+            }
+
+            if (renderId !== activeRenderId) return;
+            const elapsedMs = Math.round(performance.now() - t0);
+            self.postMessage({ type: 'DONE', renderId, elapsedMs });
+          } catch (err) {
+            self.postMessage({ type: 'ERROR', renderId, message: err ? String(err.message || err) : 'Worker error' });
+          }
+        }
+      };
+    `;
+
+    let worker: Worker | null = null;
+    try {
+      const blob = new Blob([workerCode], { type: 'application/javascript' });
+      const blobUrl = URL.createObjectURL(blob);
+      worker = new Worker(blobUrl, { type: 'module' });
+      workerRef.current = worker;
+
+      worker.onmessage = (e) => {
+        const data = e.data;
+        if (data.renderId !== renderIdRef.current) return;
+
+        if (data.type === 'PALETTE') {
+          setSphereColors(data.palette);
+        } else if (data.type === 'PROGRESS') {
+          const bytes = new Uint8ClampedArray(data.buffer);
+          paintBufferToCanvas(bytes, data.width, data.height);
+          setProgress(data.progress);
+        } else if (data.type === 'DONE') {
+          setRenderTimeMs(data.elapsedMs);
+          setIsRendering(false);
+        } else if (data.type === 'ERROR') {
+          runFallbackMainThreadRender('current', width, height, samples, Date.now(), data.renderId);
+        }
+      };
+
+      worker.onerror = () => {
+        workerRef.current = null;
+        runFallbackMainThreadRender('default', width, height, samples, Date.now(), renderIdRef.current);
+      };
+    } catch {
+      workerRef.current = null;
+    }
+
+    // Start initial render on mount
+    renderIdRef.current = 1;
+    if (workerRef.current) {
+      workerRef.current.postMessage({
+        type: 'RENDER',
+        renderId: 1,
+        mode: 'default',
+        width: 240,
+        height: 180,
+        samples: 4,
+        seed: 1337,
+      });
+    } else {
+      runFallbackMainThreadRender('default', 240, 180, 4, 1337, 1);
+    }
+
+    return () => {
+      if (worker) {
+        worker.terminate();
+      }
+    };
+  }, []);
+
+  const handleRandomizeClick = () => {
+    triggerRender('randomize');
+  };
+
+  const handleResetClick = () => {
+    triggerRender('default');
+  };
+
+  const handleSamplesChange = (newSamps: number) => {
+    setSamples(newSamps);
+    triggerRender('current', newSamps);
+  };
+
+  return (
+    <section
+      id="smallpt-wasm-section"
+      className="my-6 bg-white border border-gray-300 rounded-lg shadow-sm overflow-hidden"
+    >
+      <div className="bg-gray-900 text-white px-6 py-4 flex flex-wrap items-center justify-between gap-4">
+        <div>
+          <div className="flex items-center gap-2">
+            <span className="inline-block w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse" />
+            <span className="text-xs uppercase tracking-widest text-amber-400 font-semibold">
+              Interactive WebAssembly Graphics Lab
+            </span>
+          </div>
+          <h2 className="text-xl md:text-2xl font-bold mt-1">
+            smallpt C++ Global Illumination Path Tracer (Wasm)
+          </h2>
+          <p className="text-xs text-gray-300 mt-0.5">
+            Compiled from Kevin Beason&apos;s 99-line C++ Monte Carlo path tracer using Emscripten &mdash; running client-side in your browser.
+          </p>
+        </div>
+
+        <div className="flex flex-wrap items-center gap-3">
+          <button
+            id="randomize-spheres-btn"
+            type="button"
+            onClick={handleRandomizeClick}
+            className="bg-amber-400 hover:bg-amber-300 active:bg-amber-500 text-gray-950 font-bold text-sm px-4 py-2.5 rounded shadow transition cursor-pointer flex items-center gap-2"
+          >
+            <svg xmlns="http://www.w3.org/2000/svg" className="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
+              <path
+                fillRule="evenodd"
+                d="M15.312 11.424a5.5 5.5 0 01-9.201 2.466l-.312-.311h2.433a.75.75 0 000-1.5H3.989a.75.75 0 00-.75.75v4.242a.75.75 0 001.5 0v-2.43l.31.31a7 7 0 0011.712-3.138.75.75 0 00-1.449-.39zm1.23-3.723a.75.75 0 00.219-.53V2.929a.75.75 0 00-1.5 0V5.36l-.31-.31A7 7 0 003.239 8.188a.75.75 0 101.448.389A5.5 5.5 0 0113.89 6.11l.311.31h-2.432a.75.75 0 000 1.5h4.243a.75.75 0 00.53-.219z"
+                clipRule="evenodd"
+              />
+            </svg>
+            Randomize Sphere Colors &amp; Re-render
+          </button>
+
+          <button
+            id="reset-spheres-btn"
+            type="button"
+            onClick={handleResetClick}
+            className="bg-gray-700 hover:bg-gray-600 text-white text-xs font-semibold px-3 py-2.5 rounded transition cursor-pointer"
+          >
+            Reset Cornell Box
+          </button>
+        </div>
+      </div>
+
+      <div className="p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
+        {/* Canvas Output Column */}
+        <div className="lg:col-span-7 flex flex-col items-center">
+          <div className="relative bg-black rounded-md overflow-hidden border border-gray-800 shadow-inner w-full max-w-[480px] aspect-[4/3] flex items-center justify-center">
+            <canvas
+              id="smallpt-canvas"
+              ref={canvasRef}
+              width={width}
+              height={height}
+              className="w-full h-full object-contain"
+              style={{ imageRendering: 'auto' }}
+            />
+            {isRendering && (
+              <div className="absolute bottom-2 left-2 right-2 bg-black/75 text-white text-xs px-3 py-1.5 rounded flex items-center justify-between backdrop-blur-xs">
+                <span>Tracing rays in WebAssembly...</span>
+                <span className="font-mono font-bold text-amber-400">{progress}%</span>
+              </div>
+            )}
+          </div>
+
+          {errorMsg && (
+            <p className="text-red-600 text-xs mt-2 font-medium">{errorMsg}</p>
+          )}
+        </div>
+
+        {/* Controls & Sphere Color Palette Column */}
+        <div className="lg:col-span-5 flex flex-col justify-between space-y-5">
+          <div>
+            <h3 className="text-sm font-bold uppercase tracking-wider text-gray-500 mb-3">
+              Current Scene Sphere Colors
+            </h3>
+            <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-2 gap-2.5">
+              {sphereColors.map((item) => {
+                const cssColor = `rgb(${item.rgb[0]}, ${item.rgb[1]}, ${item.rgb[2]})`;
+                return (
+                  <div
+                    key={item.name}
+                    className="flex items-center gap-2.5 p-2 rounded border border-gray-200 bg-gray-50 text-xs"
+                  >
+                    <span
+                      className="w-5 h-5 rounded-full border border-gray-300 shrink-0 shadow-2xs"
+                      style={{ backgroundColor: cssColor }}
+                    />
+                    <div className="truncate">
+                      <div className="font-semibold text-gray-800 truncate">{item.name}</div>
+                      <div className="text-[11px] font-mono text-gray-500">
+                        {item.rgb[0]}, {item.rgb[1]}, {item.rgb[2]}
+                      </div>
+                    </div>
+                  </div>
+                );
+              })}
+            </div>
+          </div>
+
+          <div className="border-t border-gray-200 pt-4 space-y-3">
+            <div className="flex items-center justify-between">
+              <label htmlFor="smallpt-samples" className="text-xs font-semibold text-gray-700">
+                Quality (Samples / Subpixel):
+              </label>
+              <div className="flex gap-1.5" id="smallpt-samples">
+                {[1, 2, 4, 8].map((s) => (
+                  <button
+                    key={s}
+                    type="button"
+                    onClick={() => handleSamplesChange(s)}
+                    className={`px-2.5 py-1 text-xs font-mono rounded cursor-pointer transition ${
+                      samples === s
+                        ? 'bg-gray-900 text-white font-bold'
+                        : 'bg-gray-100 hover:bg-gray-200 text-gray-700'
+                    }`}
+                  >
+                    {s * 4} spp
+                  </button>
+                ))}
+              </div>
+            </div>
+
+            <div className="flex items-center justify-between text-xs text-gray-600 bg-gray-100 px-3 py-2 rounded">
+              <span>
+                Resolution: <strong className="font-mono">{width}&times;{height}</strong>
+              </span>
+              <span>
+                Status:{' '}
+                {isRendering ? (
+                  <strong className="text-amber-600">Rendering ({progress}%)</strong>
+                ) : (
+                  <strong className="text-emerald-700">
+                    Done in {renderTimeMs !== null ? `${renderTimeMs} ms` : '—'}
+                  </strong>
+                )}
+              </span>
+            </div>
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
