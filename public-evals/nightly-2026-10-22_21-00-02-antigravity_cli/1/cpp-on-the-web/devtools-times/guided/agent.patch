diff --git a/src/wasm/smallpt.cpp b/src/wasm/smallpt.cpp
new file mode 100644
index 0000000..c4a9ff6
--- /dev/null
+++ b/src/wasm/smallpt.cpp
@@ -0,0 +1,226 @@
+#include <math.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <emscripten/emscripten.h>
+
+struct Vec {
+    double x, y, z;
+    Vec(double x_ = 0, double y_ = 0, double z_ = 0) { x = x_; y = y_; z = z_; }
+    Vec operator+(const Vec &b) const { return Vec(x + b.x, y + b.y, z + b.z); }
+    Vec operator-(const Vec &b) const { return Vec(x - b.x, y - b.y, z - b.z); }
+    Vec operator*(double b) const { return Vec(x * b, y * b, z * b); }
+    Vec mult(const Vec &b) const { return Vec(x * b.x, y * b.y, z * b.z); }
+    Vec& norm() { return *this = *this * (1.0 / sqrt(x * x + y * y + z * z)); }
+    double dot(const Vec &b) const { return x * b.x + y * b.y + z * b.z; }
+    Vec operator%(Vec &b) { return Vec(y * b.z - z * b.y, z * b.x - x * b.z, x * b.y - y * b.x); }
+};
+
+struct Ray {
+    Vec o, d;
+    Ray(Vec o_, Vec d_) : o(o_), d(d_) {}
+};
+
+enum Refl_t { DIFF, SPEC, REFR };
+
+struct Sphere {
+    double rad;
+    Vec p, e, c;
+    Refl_t refl;
+    Sphere(double rad_, Vec p_, Vec e_, Vec c_, Refl_t refl_) :
+        rad(rad_), p(p_), e(e_), c(c_), refl(refl_) {}
+    double intersect(const Ray &r) const {
+        Vec op = p - r.o;
+        double t, eps = 1e-4, b = op.dot(r.d), det = b * b - op.dot(op) + rad * rad;
+        if (det < 0) return 0; else det = sqrt(det);
+        return (t = b - det) > eps ? t : ((t = b + det) > eps ? t : 0);
+    }
+};
+
+Sphere spheres[] = {
+    Sphere(1e5, Vec( 1e5 + 1, 40.8, 81.6), Vec(), Vec(.75, .25, .25), DIFF), // Left
+    Sphere(1e5, Vec(-1e5 + 99, 40.8, 81.6), Vec(), Vec(.25, .25, .75), DIFF), // Rght
+    Sphere(1e5, Vec(50, 40.8, 1e5),        Vec(), Vec(.75, .75, .75), DIFF), // Back
+    Sphere(1e5, Vec(50, 40.8, -1e5 + 170), Vec(), Vec(),              DIFF), // Frnt
+    Sphere(1e5, Vec(50, 1e5, 81.6),        Vec(), Vec(.75, .75, .75), DIFF), // Botm
+    Sphere(1e5, Vec(50, -1e5 + 81.6, 81.6), Vec(), Vec(.75, .75, .75), DIFF), // Top
+    Sphere(16.5, Vec(27, 16.5, 47),        Vec(), Vec(1, 1, 1) * .999, SPEC), // Mirr
+    Sphere(16.5, Vec(73, 16.5, 78),        Vec(), Vec(1, 1, 1) * .999, REFR), // Glas
+    Sphere(600, Vec(50, 681.6 - .27, 81.6), Vec(12, 12, 12), Vec(), DIFF)  // Lite
+};
+
+inline double clamp(double x) { return x < 0 ? 0 : x > 1 ? 1 : x; }
+inline int toInt(double x) { return int(pow(clamp(x), 1.0 / 2.2) * 255.0 + .5); }
+
+inline bool intersect(const Ray &r, double &t, int &id) {
+    double n = sizeof(spheres) / sizeof(Sphere), d, inf = t = 1e20;
+    for (int i = int(n); i--;) {
+        if ((d = spheres[i].intersect(r)) && d < t) {
+            t = d;
+            id = i;
+        }
+    }
+    return t < inf;
+}
+
+Vec radiance(const Ray &r, int depth, unsigned short *Xi) {
+    double t;
+    int id = 0;
+    if (!intersect(r, t, id)) return Vec();
+    const Sphere &obj = spheres[id];
+    Vec x = r.o + r.d * t;
+    Vec n = (x - obj.p).norm();
+    Vec nl = n.dot(r.d) < 0 ? n : n * -1;
+    Vec f = obj.c;
+    double p = f.x > f.y && f.x > f.z ? f.x : f.y > f.z ? f.y : f.z;
+    if (++depth > 5) {
+        if (depth > 50 || erand48(Xi) >= p) return obj.e;
+        f = f * (1.0 / p);
+    }
+    if (obj.refl == DIFF) {
+        double r1 = 2.0 * M_PI * erand48(Xi), r2 = erand48(Xi), r2s = sqrt(r2);
+        Vec w = nl;
+        Vec u = ((fabs(w.x) > .1 ? Vec(0, 1) : Vec(1)) % w).norm();
+        Vec v = w % u;
+        Vec d = (u * cos(r1) * r2s + v * sin(r1) * r2s + w * sqrt(1 - r2)).norm();
+        return obj.e + f.mult(radiance(Ray(x, d), depth, Xi));
+    } else if (obj.refl == SPEC) {
+        return obj.e + f.mult(radiance(Ray(x, r.d - n * 2.0 * n.dot(r.d)), depth, Xi));
+    }
+    Ray reflRay(x, r.d - n * 2.0 * n.dot(r.d));
+    bool into = n.dot(nl) > 0;
+    double nc = 1.0, nt = 1.5, nnt = into ? nc / nt : nt / nc, ddn = r.d.dot(nl), cos2t;
+    if ((cos2t = 1.0 - nnt * nnt * (1.0 - ddn * ddn)) < 0)
+        return obj.e + f.mult(radiance(reflRay, depth, Xi));
+    Vec tdir = (r.d * nnt - n * ((into ? 1 : -1) * (ddn * nnt + sqrt(cos2t)))).norm();
+    double a = nt - nc, b = nt + nc, R0 = a * a / (b * b), c = 1.0 - (into ? -ddn : tdir.dot(n));
+    double Re = R0 + (1.0 - R0) * c * c * c * c * c, Tr = 1.0 - Re, P = .25 + .5 * Re, RP = Re / P, TP = Tr / (1.0 - P);
+    return obj.e + f.mult(depth > 2 ? (erand48(Xi) < P ?
+        radiance(reflRay, depth, Xi) * RP : radiance(Ray(x, tdir), depth, Xi) * TP) :
+        radiance(reflRay, depth, Xi) * Re + radiance(Ray(x, tdir), depth, Xi) * Tr);
+}
+
+static uint8_t* out_buffer = nullptr;
+static int out_buffer_size = 0;
+static Vec* accum_buffer = nullptr;
+static int accum_buffer_pixels = 0;
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE
+void set_sphere_color(int index, double r, double g, double b) {
+    if (index >= 0 && index < 9) {
+        spheres[index].c = Vec(r, g, b);
+    }
+}
+
+EMSCRIPTEN_KEEPALIVE
+void reset_default_colors() {
+    spheres[0].c = Vec(.75, .25, .25);
+    spheres[1].c = Vec(.25, .25, .75);
+    spheres[2].c = Vec(.75, .75, .75);
+    spheres[3].c = Vec(0, 0, 0);
+    spheres[4].c = Vec(.75, .75, .75);
+    spheres[5].c = Vec(.75, .75, .75);
+    spheres[6].c = Vec(.999, .999, .999);
+    spheres[7].c = Vec(.999, .999, .999);
+}
+
+EMSCRIPTEN_KEEPALIVE
+void randomize_sphere_colors(uint32_t seed) {
+    srand(seed);
+    auto randColor = []() {
+        return 0.15 + 0.80 * (double(rand()) / double(RAND_MAX));
+    };
+    // Left wall, Right wall, Back wall, Bottom floor, Top ceiling
+    spheres[0].c = Vec(randColor(), randColor(), randColor());
+    spheres[1].c = Vec(randColor(), randColor(), randColor());
+    spheres[2].c = Vec(randColor(), randColor(), randColor());
+    spheres[4].c = Vec(randColor(), randColor(), randColor());
+    spheres[5].c = Vec(randColor(), randColor(), randColor());
+    // Mirror & Glass spheres get vibrant tinted colors
+    spheres[6].c = Vec(0.4 + 0.599 * (double(rand()) / RAND_MAX),
+                       0.4 + 0.599 * (double(rand()) / RAND_MAX),
+                       0.4 + 0.599 * (double(rand()) / RAND_MAX));
+    spheres[7].c = Vec(0.4 + 0.599 * (double(rand()) / RAND_MAX),
+                       0.4 + 0.599 * (double(rand()) / RAND_MAX),
+                       0.4 + 0.599 * (double(rand()) / RAND_MAX));
+}
+
+EMSCRIPTEN_KEEPALIVE
+double get_sphere_color_channel(int index, int channel) {
+    if (index < 0 || index >= 9) return 0.0;
+    if (channel == 0) return spheres[index].c.x;
+    if (channel == 1) return spheres[index].c.y;
+    if (channel == 2) return spheres[index].c.z;
+    return 0.0;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* init_render(int w, int h) {
+    int needed_bytes = w * h * 4;
+    if (out_buffer_size < needed_bytes) {
+        if (out_buffer) free(out_buffer);
+        out_buffer = (uint8_t*)malloc(needed_bytes);
+        out_buffer_size = needed_bytes;
+    }
+    int needed_pixels = w * h;
+    if (accum_buffer_pixels < needed_pixels) {
+        if (accum_buffer) free(accum_buffer);
+        accum_buffer = (Vec*)malloc(needed_pixels * sizeof(Vec));
+        accum_buffer_pixels = needed_pixels;
+    }
+    for (int i = 0; i < needed_pixels; i++) {
+        accum_buffer[i] = Vec(0, 0, 0);
+        out_buffer[i * 4 + 0] = 0;
+        out_buffer[i * 4 + 1] = 0;
+        out_buffer[i * 4 + 2] = 0;
+        out_buffer[i * 4 + 3] = 255;
+    }
+    return out_buffer;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_rows(int w, int h, int samps, int y_start, int y_end) {
+    if (!out_buffer || !accum_buffer) {
+        init_render(w, h);
+    }
+    if (y_start < 0) y_start = 0;
+    if (y_end > h) y_end = h;
+
+    Ray cam(Vec(50, 52, 295.6), Vec(0, -0.042612, -1).norm());
+    Vec cx = Vec(w * .5135 / h);
+    Vec cy = (cx % cam.d).norm() * .5135;
+    Vec r;
+
+    for (int y = y_start; y < y_end; y++) {
+        for (unsigned short x = 0, Xi[3] = {0, 0, (unsigned short)(y * y * y)}; x < w; x++) {
+            int i = (h - y - 1) * w + x;
+            accum_buffer[i] = Vec(0, 0, 0);
+            for (int sy = 0; sy < 2; sy++) {
+                for (int sx = 0; sx < 2; sx++, r = Vec()) {
+                    for (int s = 0; s < samps; s++) {
+                        double r1 = 2.0 * erand48(Xi), dx = r1 < 1 ? sqrt(r1) - 1.0 : 1.0 - sqrt(2.0 - r1);
+                        double r2 = 2.0 * erand48(Xi), dy = r2 < 1 ? sqrt(r2) - 1.0 : 1.0 - sqrt(2.0 - r2);
+                        Vec d = cx * (((sx + .5 + dx) / 2.0 + x) / w - .5) +
+                                cy * (((sy + .5 + dy) / 2.0 + y) / h - .5) + cam.d;
+                        r = r + radiance(Ray(cam.o + d * 140.0, d.norm()), 0, Xi) * (1.0 / samps);
+                    }
+                    accum_buffer[i] = accum_buffer[i] + Vec(clamp(r.x), clamp(r.y), clamp(r.z)) * .25;
+                }
+            }
+            out_buffer[i * 4 + 0] = (uint8_t)toInt(accum_buffer[i].x);
+            out_buffer[i * 4 + 1] = (uint8_t)toInt(accum_buffer[i].y);
+            out_buffer[i * 4 + 2] = (uint8_t)toInt(accum_buffer[i].z);
+            out_buffer[i * 4 + 3] = 255;
+        }
+    }
+    return out_buffer;
+}
+
+EMSCRIPTEN_KEEPALIVE
+uint8_t* render_scene(int w, int h, int samps) {
+    init_render(w, h);
+    return render_rows(w, h, samps, 0, h);
+}
+
+}
