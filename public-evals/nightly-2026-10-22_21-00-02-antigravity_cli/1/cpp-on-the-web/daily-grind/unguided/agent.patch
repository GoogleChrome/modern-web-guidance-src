+
+    function ensureWasmBuffer(w, h) {
+      const needed = w * h * 4;
+      if (wasmBufferPtr && wasmBufferSize < needed) {
+        Module._free(wasmBufferPtr);
+        wasmBufferPtr = 0;
+      }
+      if (!wasmBufferPtr) {
+        wasmBufferPtr = Module._malloc(needed);
+        wasmBufferSize = needed;
+      }
+      return wasmBufferPtr;
+    }
