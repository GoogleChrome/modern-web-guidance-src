+    function toDisplayHex(r, g, b) {
+      const gamma = (v) => Math.min(255, Math.max(0, Math.round(Math.pow(Math.min(1, Math.max(0, v)), 1 / 2.2) * 255)));
+      const hr = gamma(r).toString(16).padStart(2, "0");
+      const hg = gamma(g).toString(16).padStart(2, "0");
+      const hb = gamma(b).toString(16).padStart(2, "0");
+      return `#${hr}${hg}${hb}`;
+    }
