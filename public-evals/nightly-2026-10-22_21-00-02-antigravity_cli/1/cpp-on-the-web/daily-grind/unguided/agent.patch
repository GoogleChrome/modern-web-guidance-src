+      if (!wasmReady) return;
+      sphereListEl.innerHTML = "";
+      for (const meta of SPHERE_METADATA) {
+        const r = Module._get_sphere_color_r(meta.id);
+        const g = Module._get_sphere_color_g(meta.id);
+        const b = Module._get_sphere_color_b(meta.id);
+        const hex = meta.id === 8 ? "#ffffff" : toDisplayHex(r, g, b);
+
+        const row = document.createElement("div");
+        row.className = "sphere-item";
+        row.innerHTML = `
+          <div class="sphere-info">
+            <span class="color-swatch" style="background: ${hex};"></span>
+            <div class="sphere-meta">
+              <span class="sphere-name">${meta.name}</span>
+              <span class="sphere-type">${meta.type}</span>
+            </div>
+          </div>
+          <span class="sphere-rgb">(${r.toFixed(2)}, ${g.toFixed(2)}, ${b.toFixed(2)})</span>
+        `;
+        sphereListEl.appendChild(row);
+      }
+    }
+
+    function hslToRgb(h, s, l) {
+      const a = s * Math.min(l, 1 - l);
+      const f = (n) => {
+        const k = (n + h / 30) % 12;
+        return l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1);
+      };
+      return [f(0), f(8), f(4)];
+    }
+
+    function randomizeSphereColors() {
+      if (!wasmReady) return;
+      for (const meta of SPHERE_METADATA) {
+        if (!meta.randomize) continue;
+        if (meta.type === "DIFFUSE") {
+          // Vivid yet physically plausible albedo (0.15 - 0.85) for rich global illumination color bleeding
+          const hue = Math.random() * 360;
+          const sat = 0.55 + Math.random() * 0.4;
+          const light = 0.35 + Math.random() * 0.35;
+          const [r, g, b] = hslToRgb(hue, sat, light);
+          Module._set_sphere_color(meta.id, r, g, b);
+        } else {
+          // Tinted mirror & glass spheres (high reflectance/transmittance 0.65 - 0.999)
+          const hue = Math.random() * 360;
+          const sat = 0.65 + Math.random() * 0.35;
+          const light = 0.72 + Math.random() * 0.24;
+          const [r, g, b] = hslToRgb(hue, sat, light);
+          Module._set_sphere_color(meta.id, r, g, b);
+        }
+      }
+      updateSphereUI();
+    }
+
+    function startRender({ resetAccumulation = true, sampsOverride = null } = {}) {
+      if (!wasmReady) return;
+
+      renderJobId++;
+      const activeJob = renderJobId;
+      const { w, h } = getResolution();
+      const samps = sampsOverride !== null ? sampsOverride : getSampsPerSubpixel();
+
+      if (canvas.width !== w || canvas.height !== h) {
+        canvas.width = w;
+        canvas.height = h;
+      }
+
+      const outPtr = ensureWasmBuffer(w, h);
+
+      if (resetAccumulation) {
+        Module._init_accumulation(w, h);
+        currentPass = 0;
+        totalSamplesAccumulated = 0;
+      }
+
+      const passNumber = currentPass + 1;
+      currentSeed = (currentSeed * 1664525 + 1013904223) & 0x7fffffff;
+
+      statResolution.innerHTML = `${w} &times; ${h}`;
+      statusDot.className = "status-dot rendering";
+      statusText.textContent = `Tracing Rays (Pass #${passNumber})...`;
+      progressBar.style.width = "0%";
+      statProgress.textContent = "0%";
+
+      const startTime = performance.now();
+      const rowsPerChunk = Math.max(4, Math.floor(h / 20));
+      let currentRow = 0;
+
+      function stepChunk() {
+        if (activeJob !== renderJobId) return;
+
+        const nextRow = Math.min(h, currentRow + rowsPerChunk);
+        Module._render_rows(w, h, currentRow, nextRow, samps, currentSeed, outPtr);
+        Module._update_rows_rgba(w, h, currentRow, nextRow, passNumber, outPtr);
+
+        const heapSlice = new Uint8ClampedArray(Module.HEAPU8.buffer, outPtr, w * h * 4);
+        const imageData = new ImageData(new Uint8ClampedArray(heapSlice), w, h);
+        ctx.putImageData(imageData, 0, 0);
+
+        currentRow = nextRow;
+        const pct = Math.round((currentRow / h) * 100);
+        const elapsed = ((performance.now() - startTime) / 1000).toFixed(2);
+
+        progressBar.style.width = `${pct}%`;
+        statProgress.textContent = `${pct}%`;
+        statTime.textContent = `${elapsed}s`;
+
+        if (currentRow < h) {
+          requestAnimationFrame(stepChunk);
+        } else {
+          Module._finalize_pass(w, h, outPtr);
+          currentPass = passNumber;
+          totalSamplesAccumulated += samps * 4;
+
+          const finalSlice = new Uint8ClampedArray(Module.HEAPU8.buffer, outPtr, w * h * 4);
+          ctx.putImageData(new ImageData(new Uint8ClampedArray(finalSlice), w, h), 0, 0);
+
+          statSamples.textContent = `${totalSamplesAccumulated} spp`;
+          statusDot.className = "status-dot ready";
+          statusText.textContent = `Render Complete (${totalSamplesAccumulated} spp)`;
+        }
+      }
+
+      requestAnimationFrame(stepChunk);
+    }
+
+    randomizeBtn.addEventListener("click", () => {
+      randomizeSphereColors();
+      startRender({ resetAccumulation: true });
+    });
+
+    resetBtn.addEventListener("click", () => {
+      Module._reset_scene_colors();
+      updateSphereUI();
+      startRender({ resetAccumulation: true });
+    });
+
+    refineBtn.addEventListener("click", () => {
+      startRender({ resetAccumulation: false, sampsOverride: 4 });
+    });
+
+    resolutionSelect.addEventListener("change", () => {
+      startRender({ resetAccumulation: true });
+    });
+
+    samplesSelect.addEventListener("change", () => {
+      startRender({ resetAccumulation: true });
+    });
+
+    function onWasmLoaded() {
+      if (wasmReady) return;
+      wasmReady = true;
+      randomizeBtn.disabled = false;
+      resetBtn.disabled = false;
+      refineBtn.disabled = false;
+      refineBtn.textContent = `+ Add Quality Pass (+16 spp)`;
+      updateSphereUI();
+      startRender({ resetAccumulation: true });
+    }
+
+    if (typeof Module !== "undefined") {
+      if (Module.calledRun || Module.asm) {
+        onWasmLoaded();
+      } else {
+        const prevInit = Module.onRuntimeInitialized;
+        Module.onRuntimeInitialized = function () {
+          if (prevInit) prevInit();
+          onWasmLoaded();
+        };
+      }
+    }
+  </script>
 </body>
 
 </html>
