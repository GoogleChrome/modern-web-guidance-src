+  <script type="module">
+    import Module from './smallpt.js';
+
+    const canvas = document.getElementById('render-canvas');
+    const ctx = canvas.getContext('2d');
+    const progressBar = document.getElementById('progress-bar');
+    const statusDot = document.getElementById('status-dot');
+    const statusText = document.getElementById('status-text');
+    const metricsText = document.getElementById('metrics-text');
+    const randomizeBtn = document.getElementById('randomize-btn');
+    const resetBtn = document.getElementById('reset-btn');
+    const resolutionSelect = document.getElementById('resolution-select');
+    const passesSelect = document.getElementById('passes-select');
+    const paletteList = document.getElementById('palette-list');
+
+    let worker = null;
+    let fallbackMod = null;
+    let activeJobId = 0;
+
+    function parseResolution() {
+      const [w, h] = resolutionSelect.value.split('x').map(Number);
+      return { width: w || 320, height: h || 240 };
+    }
+
+    function updatePaletteUI(palette) {
+      if (!Array.isArray(palette)) return;
+      paletteList.innerHTML = '';
+      for (const item of palette) {
+        const row = document.createElement('div');
+        row.className = 'palette-item';
+
+        const info = document.createElement('div');
+        info.className = 'swatch-info';
+
+        const box = document.createElement('span');
+        box.className = 'swatch-box';
+        box.style.backgroundColor = item.hex;
+
+        const name = document.createElement('span');
+        name.textContent = item.name;
+
+        info.appendChild(box);
+        info.appendChild(name);
+
+        const meta = document.createElement('span');
+        meta.className = 'swatch-meta';
+        meta.textContent = `${item.type} ${item.hex.toUpperCase()}`;
+
+        row.appendChild(info);
+        row.appendChild(meta);
+        paletteList.appendChild(row);
+      }
+    }
+
+    function drawPixels(buffer, width, height) {
+      if (canvas.width !== width || canvas.height !== height) {
+        canvas.width = width;
+        canvas.height = height;
+      }
+      const clamped = new Uint8ClampedArray(buffer);
+      const imageData = new ImageData(clamped, width, height);
+      ctx.putImageData(imageData, 0, 0);
+    }
+
+    function initWorker() {
+      try {
+        worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' });
+        worker.addEventListener('message', (event) => {
+          const msg = event.data;
+          if (msg.type === 'palette') {
+            updatePaletteUI(msg.palette);
+          } else if (msg.type === 'progress') {
+            drawPixels(msg.pixels, msg.width, msg.height);
+            const pct = Math.min(100, Math.round(msg.progress * 100));
+            progressBar.style.width = `${pct}%`;
+            statusDot.className = 'dot rendering';
+            statusText.textContent = `Rendering pass ${msg.pass}/${msg.targetPasses} (${pct}%)`;
+            metricsText.textContent = `${msg.spp} spp \u2022 ${(msg.elapsedMs / 1000).toFixed(2)}s`;
+          } else if (msg.type === 'complete') {
+            drawPixels(msg.pixels, msg.width, msg.height);
+            progressBar.style.width = '100%';
+            statusDot.className = 'dot done';
+            statusText.textContent = `Render complete (${msg.width}\u00d7${msg.height})`;
+            metricsText.textContent = `${msg.spp} spp \u2022 ${(msg.elapsedMs / 1000).toFixed(2)}s`;
+            if (msg.palette) updatePaletteUI(msg.palette);
+          }
+        });
+        worker.addEventListener('error', (err) => {
+          console.warn('Worker failed, falling back to main thread chunked Wasm:', err);
+          worker = null;
+          startRender({ randomize: false, resetDefault: false });
+        });
+      } catch (e) {
+        worker = null;
+      }
+    }
+
+    async function runFallbackRender({ width, height, targetPasses, randomize, resetDefault, seed }) {
+      const jobId = ++activeJobId;
+      if (!fallbackMod) {
+        fallbackMod = await Module();
+      }
+      if (jobId !== activeJobId) return;
+
+      if (resetDefault) {
+        fallbackMod._reset_default_colors();
+      } else if (randomize) {
+        fallbackMod._randomize_sphere_colors(seed >>> 0);
+      }
+
+      const sphereNames = [
+        { index: 0, name: 'Left Wall', type: 'DIFF' },
+        { index: 1, name: 'Right Wall', type: 'DIFF' },
+        { index: 2, name: 'Back Wall', type: 'DIFF' },
+        { index: 4, name: 'Floor', type: 'DIFF' },
+        { index: 5, name: 'Ceiling', type: 'DIFF' },
+        { index: 6, name: 'Mirror Sphere', type: 'SPEC' },
+        { index: 7, name: 'Glass Sphere', type: 'REFR' }
+      ];
+      const palette = sphereNames.map((meta) => {
+        const r = fallbackMod._get_sphere_color_channel(meta.index, 0);
+        const g = fallbackMod._get_sphere_color_channel(meta.index, 1);
+        const b = fallbackMod._get_sphere_color_channel(meta.index, 2);
+        return {
+          ...meta,
+          hex: '#' + [r, g, b].map((v) => Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255).toString(16).padStart(2, '0')).join('')
+        };
+      });
+      updatePaletteUI(palette);
+
+      const ptr = fallbackMod._init_render(width, height);
+      const startTime = performance.now();
+      const chunkRows = 16;
+
+      for (let pass = 0; pass < targetPasses; pass++) {
+        const passSeed = ((seed >>> 0) + pass * 104729) | 0;
+        for (let y = 0; y < height; y += chunkRows) {
+          if (jobId !== activeJobId) return;
+          const endY = Math.min(y + chunkRows, height);
+          fallbackMod._render_rows(y, endY, 1, passSeed);
+
+          const copy = new Uint8ClampedArray(fallbackMod.HEAPU8.buffer, ptr, width * height * 4).slice();
+          drawPixels(copy.buffer, width, height);
+
+          const progress = (pass * height + endY) / (targetPasses * height);
+          const pct = Math.min(100, Math.round(progress * 100));
+          const elapsedMs = performance.now() - startTime;
+          progressBar.style.width = `${pct}%`;
+          statusDot.className = 'dot rendering';
+          statusText.textContent = `Rendering pass ${pass + 1}/${targetPasses} (${pct}%)`;
+          metricsText.textContent = `${Math.round((pass + endY / height) * 4)} spp \u2022 ${(elapsedMs / 1000).toFixed(2)}s`;
+
+          await new Promise((r) => setTimeout(r, 0));
+        }
+      }
+
+      if (jobId === activeJobId) {
+        progressBar.style.width = '100%';
+        statusDot.className = 'dot done';
+        statusText.textContent = `Render complete (${width}\u00d7${height})`;
+      }
+    }
+
+    function startRender({ randomize = false, resetDefault = false } = {}) {
+      const { width, height } = parseResolution();
+      const targetPasses = Number(passesSelect.value) || 4;
+      const seed = (Date.now() ^ Math.floor(Math.random() * 0xffffffff)) >>> 0;
+
+      progressBar.style.width = '0%';
+      statusDot.className = 'dot rendering';
+      statusText.textContent = randomize
+        ? 'Randomizing sphere colors & starting path tracer...'
+        : 'Starting WebAssembly path tracer...';
+
+      if (worker) {
+        worker.postMessage({
+          type: 'render',
+          width,
+          height,
+          targetPasses,
+          randomize,
+          resetDefault,
+          seed
+        });
+      } else {
+        runFallbackRender({ width, height, targetPasses, randomize, resetDefault, seed });
+      }
+    }
+
+    randomizeBtn.addEventListener('click', () => {
+      startRender({ randomize: true, resetDefault: false });
+    });
+
+    resetBtn.addEventListener('click', () => {
+      startRender({ randomize: false, resetDefault: true });
+    });
+
+    resolutionSelect.addEventListener('change', () => {
+      startRender({ randomize: false, resetDefault: false });
+    });
+
+    passesSelect.addEventListener('change', () => {
+      startRender({ randomize: false, resetDefault: false });
+    });
+
+    initWorker();
+    startRender({ randomize: false, resetDefault: true });
+  </script>
 </body>
 
