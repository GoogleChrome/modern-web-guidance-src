+// Web Worker for running the WebAssembly smallpt path tracer off the main thread
+import Module from './smallpt.js';
+
+let wasmModule = null;
+let currentRenderId = 0;
+
+const SPHERE_NAMES = [
+  { index: 0, name: 'Left Wall', type: 'DIFF' },
+  { index: 1, name: 'Right Wall', type: 'DIFF' },
+  { index: 2, name: 'Back Wall', type: 'DIFF' },
+  { index: 4, name: 'Floor', type: 'DIFF' },
+  { index: 5, name: 'Ceiling', type: 'DIFF' },
+  { index: 6, name: 'Mirror Sphere', type: 'SPEC' },
+  { index: 7, name: 'Glass Sphere', type: 'REFR' }
+];
+
+function readSpherePalette() {
+  if (!wasmModule) return [];
+  return SPHERE_NAMES.map((meta) => {
+    const r = wasmModule._get_sphere_color_channel(meta.index, 0);
+    const g = wasmModule._get_sphere_color_channel(meta.index, 1);
+    const b = wasmModule._get_sphere_color_channel(meta.index, 2);
+    return {
+      ...meta,
+      r,
+      g,
+      b,
+      hex: '#' + [r, g, b].map((v) => Math.round(Math.pow(Math.max(0, Math.min(1, v)), 1 / 2.2) * 255).toString(16).padStart(2, '0')).join('')
+    };
+  });
+}
+
+async function ensureModule() {
+  if (!wasmModule) {
+    wasmModule = await Module();
+  }
+  return wasmModule;
+}
+
+self.addEventListener('message', async (event) => {
+  const { type, width = 320, height = 240, targetPasses = 4, randomize = false, resetDefault = false, customColors = null, seed = Date.now() } = event.data;
+
+  if (type === 'stop') {
+    currentRenderId++;
+    return;
+  }
+
+  if (type === 'render') {
+    const renderId = ++currentRenderId;
+    const mod = await ensureModule();
+    if (renderId !== currentRenderId) return;
+
+    if (resetDefault) {
+      mod._reset_default_colors();
+    } else if (randomize) {
+      mod._randomize_sphere_colors(seed >>> 0);
+    }
+
+    if (Array.isArray(customColors)) {
+      for (const c of customColors) {
+        mod._set_sphere_color(c.index, c.r, c.g, c.b);
+      }
+    }
+
+    const palette = readSpherePalette();
+    self.postMessage({ type: 'palette', palette, renderId });
+
+    const ptr = mod._init_render(width, height);
+    const startTime = performance.now();
+    const chunkRows = 24;
+
+    for (let pass = 0; pass < targetPasses; pass++) {
+      const passSeed = ((seed >>> 0) + pass * 104729) | 0;
+      for (let y = 0; y < height; y += chunkRows) {
+        if (renderId !== currentRenderId) return;
+        const endY = Math.min(y + chunkRows, height);
+        mod._render_rows(y, endY, 1, passSeed);
+
+        const rgbaCopy = new Uint8ClampedArray(
+          mod.HEAPU8.buffer,
+          ptr,
+          width * height * 4
+        ).slice();
+
+        const elapsedMs = performance.now() - startTime;
+        const totalRowsDone = pass * height + endY;
+        const totalRowsTarget = targetPasses * height;
+        const progress = totalRowsDone / totalRowsTarget;
+        const spp = (pass + (endY / height)) * 4;
+
+        self.postMessage(
+          {
+            type: 'progress',
+            renderId,
+            width,
+            height,
+            pass: pass + 1,
+            targetPasses,
+            spp: Math.round(spp),
+            progress,
+            elapsedMs,
+            pixels: rgbaCopy.buffer
+          },
+          [rgbaCopy.buffer]
+        );
+
+        // Yield briefly to allow stop/new-render messages to be processed
+        await new Promise((resolve) => setTimeout(resolve, 0));
+      }
+    }
+
+    if (renderId === currentRenderId) {
+      const finalPtr = mod._get_rgba_buffer();
+      const finalCopy = new Uint8ClampedArray(
+        mod.HEAPU8.buffer,
+        finalPtr,
+        width * height * 4
+      ).slice();
+
+      self.postMessage(
+        {
+          type: 'complete',
+          renderId,
+          width,
+          height,
+          spp: targetPasses * 4,
+          elapsedMs: performance.now() - startTime,
+          pixels: finalCopy.buffer,
+          palette
+        },
+        [finalCopy.buffer]
+      );
+    }
+  }
+});
