+  <script>
+    (function () {
+      const form = document.getElementById('order-form');
+      const shopSelect = document.getElementById('local-shop');
+      const errorMsg = document.getElementById('local-shop-error');
+      const successMsg = document.getElementById('order-success');
+
+      function updateShopValidity(markTouched) {
+        if (markTouched) {
+          shopSelect.classList.add('touched');
+        }
+        const isInvalid = !shopSelect.checkValidity();
+        if (shopSelect.classList.contains('touched') || form.classList.contains('was-validated')) {
+          shopSelect.setAttribute('aria-invalid', isInvalid ? 'true' : 'false');
+          errorMsg.hidden = !isInvalid;
+        }
+      }
+
+      shopSelect.addEventListener('change', function () {
+        updateShopValidity(true);
+        if (shopSelect.checkValidity()) {
+          successMsg.style.display = 'none';
+        }
+      });
+
+      shopSelect.addEventListener('blur', function () {
+        updateShopValidity(true);
+      });
+
+      shopSelect.addEventListener('invalid', function () {
+        updateShopValidity(true);
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        form.classList.add('was-validated');
+        updateShopValidity(true);
+
+        if (!form.checkValidity()) {
+          successMsg.style.display = 'none';
+          shopSelect.focus();
+          return;
+        }
+
+        successMsg.style.display = 'block';
+      });
+    })();
+  </script>
+
