+  <script>
+    const TARGET_TIMEZONES = [
+      { label: 'New York', id: 'America/New_York' },
+      { label: 'London', id: 'Europe/London' },
+      { label: 'Tokyo', id: 'Asia/Tokyo' },
+      { label: 'UTC', id: 'UTC' }
+    ];
+
+    function updateSchedule() {
+      if (typeof Temporal === 'undefined') return;
+
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const date = dateInput.value;
+      const time = timeInput.value;
+      const timeZone = hostTzSelect.value;
+
+      if (!date || !time || !timeZone) return;
+
+      const inputStr = `${date}T${time}[${timeZone}]`;
+
+      // Detect DST gap or overlap conflicts using disambiguation: 'reject'
+      let hasConflict = false;
+      try {
+        Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'reject' });
+      } catch (e) {
+        if (e instanceof RangeError) {
+          hasConflict = true;
+        } else {
+          return;
+        }
+      }
+
+      // Safely resolve the host time using disambiguation: 'compatible'
+      const hostTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'compatible' });
+
+      if (hasConflict) {
+        const earlierTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'earlier' });
+        const laterTime = Temporal.ZonedDateTime.from(inputStr, { disambiguation: 'later' });
+        const resolvedFormatted = hostTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+
+        // During a spring-forward gap, 'compatible' resolves to the 'later' transition time;
+        // during a fall-back overlap, 'compatible' resolves to the 'earlier' occurrence.
+        const isGap = Temporal.ZonedDateTime.compare(hostTime, laterTime) === 0 &&
+          earlierTime.offset !== laterTime.offset &&
+          hostTime.toPlainTime().toString({ smallestUnit: 'minute' }) !== time.slice(0, 5);
+
+        if (isGap) {
+          hostWarning.textContent = `Daylight Saving Time Conflict: The selected time (${time}) does not exist in ${timeZone} due to a spring-forward DST transition gap. Using compatible disambiguation, the immutable ZonedDateTime was safely resolved forward to ${resolvedFormatted} (${hostTime.offset}).`;
+        } else {
+          hostWarning.textContent = `Daylight Saving Time Conflict: The selected time (${time}) is ambiguous in ${timeZone} because clocks fall back and repeat this hour during a DST transition overlap. Using compatible disambiguation, the immutable ZonedDateTime was safely resolved to the first occurrence at ${resolvedFormatted} (${hostTime.offset}).`;
+        }
+        hostWarning.hidden = false;
+      } else {
+        hostWarning.textContent = '';
+        hostWarning.hidden = true;
+      }
+
+      // Render cards for each target timezone without mutating hostTime
+      grid.innerHTML = '';
+      for (const target of TARGET_TIMEZONES) {
+        const convertedTime = hostTime.withTimeZone(target.id);
+        const formattedTime = convertedTime.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit'
+        });
+        const formattedDate = convertedTime.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+
+        const card = document.createElement('div');
+        card.className = 'card tz-card';
+
+        const heading = document.createElement('h3');
+        heading.textContent = target.label;
+
+        const tzCode = document.createElement('span');
+        tzCode.className = 'tz-code';
+        tzCode.textContent = `${target.id} (${convertedTime.offset})`;
+
+        const timeEl = document.createElement('div');
+        timeEl.className = 'tz-time';
+        timeEl.textContent = formattedTime;
+
+        const dateEl = document.createElement('div');
+        dateEl.className = 'tz-date';
+        dateEl.textContent = formattedDate;
+
+        card.append(heading, tzCode, timeEl, dateEl);
+        grid.appendChild(card);
+      }
+    }
+
+    function initializeApp() {
+      const controls = ['dateInput', 'timeInput', 'hostTzSelect'];
+      for (const id of controls) {
+        const el = document.getElementById(id);
+        if (el) {
+          el.addEventListener('change', updateSchedule);
+          el.addEventListener('input', updateSchedule);
+        }
+      }
+      updateSchedule();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
