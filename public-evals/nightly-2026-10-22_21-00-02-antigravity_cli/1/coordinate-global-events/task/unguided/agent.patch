+  <script>
+    (function () {
+      const dateInput = document.getElementById('dateInput');
+      const timeInput = document.getElementById('timeInput');
+      const hostTzSelect = document.getElementById('hostTzSelect');
+      const hostWarning = document.getElementById('hostWarning');
+      const grid = document.getElementById('grid');
+
+      const TARGET_TIMEZONES = [
+        { label: 'New York', tz: 'America/New_York' },
+        { label: 'London', tz: 'Europe/London' },
+        { label: 'Tokyo', tz: 'Asia/Tokyo' },
+        { label: 'UTC', tz: 'UTC' }
+      ];
+
+      function formatLocalTime(zdt) {
+        return zdt.toLocaleString('en-US', {
+          hour: 'numeric',
+          minute: '2-digit',
+          hour12: true
+        });
+      }
+
+      function formatLocalDate(zdt) {
+        return zdt.toLocaleString('en-US', {
+          weekday: 'short',
+          month: 'short',
+          day: 'numeric',
+          year: 'numeric'
+        });
+      }
+
+      function updateCoordinator() {
+        const dateVal = dateInput.value;
+        const timeVal = timeInput.value;
+        const hostTz = hostTzSelect.value;
+
+        if (!dateVal || !timeVal || !hostTz) {
+          return;
+        }
+
+        // Parse date and time into immutable Temporal objects
+        const plainDate = Temporal.PlainDate.from(dateVal);
+        const plainTime = Temporal.PlainTime.from(timeVal);
+        const requestedDateTime = plainDate.toPlainDateTime(plainTime);
+
+        // Compute earlier, later, and compatible disambiguations for DST conflict detection
+        const zdtEarlier = requestedDateTime.toZonedDateTime(hostTz, { disambiguation: 'earlier' });
+        const zdtLater = requestedDateTime.toZonedDateTime(hostTz, { disambiguation: 'later' });
+        const hostZdt = requestedDateTime.toZonedDateTime(hostTz, { disambiguation: 'compatible' });
+
+        // Check for DST gap (non-existent local time) or DST overlap (ambiguous local time)
+        const actualWallTime = hostZdt.toPlainDateTime();
+        const isGap = !actualWallTime.equals(requestedDateTime);
+        const isOverlap = !isGap && !zdtEarlier.equals(zdtLater);
+
+        if (isGap) {
+          const resolvedTimeStr = formatLocalTime(hostZdt);
+          hostWarning.textContent = `Daylight Saving Time Gap Detected: The selected local time (${timeVal}) does not exist in ${hostTz} because clocks spring forward during a DST transition. Using immutable Temporal resolution ('compatible' disambiguation), the time was automatically adjusted forward to ${resolvedTimeStr} (${hostZdt.offset}).`;
+          hostWarning.classList.add('visible');
+        } else if (isOverlap) {
+          const resolvedTimeStr = formatLocalTime(hostZdt);
+          hostWarning.textContent = `Daylight Saving Time Overlap Detected: The selected local time (${timeVal}) is ambiguous and occurs twice in ${hostTz} (${zdtEarlier.offset} and ${zdtLater.offset}) as clocks fall back. Using immutable Temporal resolution ('compatible' / earlier occurrence), it was resolved to the first occurrence at ${resolvedTimeStr} (${hostZdt.offset}).`;
+          hostWarning.classList.add('visible');
+        } else {
+          hostWarning.textContent = '';
+          hostWarning.classList.remove('visible');
+        }
+
+        // Render cards for each target timezone using .withTimeZone() on the immutable ZonedDateTime
+        grid.innerHTML = '';
+        TARGET_TIMEZONES.forEach((target) => {
+          const convertedZdt = hostZdt.withTimeZone(target.tz);
+          const timeFormatted = formatLocalTime(convertedZdt);
+          const dateFormatted = formatLocalDate(convertedZdt);
+
+          const card = document.createElement('div');
+          card.className = 'card tz-card' + (target.tz === hostTz ? ' is-host' : '');
+          card.setAttribute('data-tz', target.tz);
+
+          card.innerHTML = `
+            <h3 class="tz-city">${target.label}</h3>
+            <div class="tz-id">${target.tz}</div>
+            <div class="tz-time">${timeFormatted}</div>
+            <div class="tz-date">${dateFormatted}</div>
+            <div class="tz-offset">UTC${convertedZdt.offset === '+00:00' ? '' : convertedZdt.offset}</div>
+          `;
+
+          grid.appendChild(card);
+        });
+      }
+
+      dateInput.addEventListener('input', updateCoordinator);
+      dateInput.addEventListener('change', updateCoordinator);
+      timeInput.addEventListener('input', updateCoordinator);
+      timeInput.addEventListener('change', updateCoordinator);
+      hostTzSelect.addEventListener('change', updateCoordinator);
+
+      updateCoordinator();
+    })();
+  </script>
 </body>
 
