@@ -206,7 +314,75 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const form = document.getElementById('mailing-list-form');
+      const emailInput = document.getElementById('mailing-email');
+      const errorMsg = document.getElementById('email-error');
+      const successMsg = document.getElementById('mailing-success');
+      let hasInteracted = false;
+
+      function showError(message) {
+        errorMsg.textContent = message;
+        emailInput.classList.add('invalid');
+        emailInput.setAttribute('aria-invalid', 'true');
+        errorMsg.classList.add('visible');
+        successMsg.classList.remove('visible');
+      }
+
+      function clearError() {
+        emailInput.classList.remove('invalid');
+        emailInput.removeAttribute('aria-invalid');
+        errorMsg.classList.remove('visible');
+      }
+
+      emailInput.addEventListener('focus', function () {
+        hasInteracted = true;
+      });
+
+      emailInput.addEventListener('blur', function () {
+        hasInteracted = true;
+        const value = emailInput.value.trim();
+        if (value === '') {
+          showError('Please enter your email address.');
+        } else if (!emailInput.validity.valid) {
+          showError('Please enter a valid email address.');
+        } else {
+          clearError();
+        }
+      });
+
+      emailInput.addEventListener('input', function () {
+        hasInteracted = true;
+        const value = emailInput.value.trim();
+        if (value === '') {
+          showError('Please enter your email address.');
+        } else {
+          clearError();
+        }
+      });
+
+      form.addEventListener('submit', function (e) {
+        e.preventDefault();
+        hasInteracted = true;
+        const value = emailInput.value.trim();
+        if (value === '') {
+          showError('Please enter your email address.');
+          emailInput.focus();
+        } else if (!emailInput.validity.valid) {
+          showError('Please enter a valid email address.');
+          emailInput.focus();
+        } else {
+          clearError();
+          successMsg.textContent = 'Thanks for subscribing to our mailing list!';
+          successMsg.classList.add('visible');
+          form.reset();
+        }
+      });
+    })();
+  </script>
+
 </body>
 
 </html>
