+  <script>
+    const mailingForm = document.getElementById('mailing-list-form');
+    const emailInput = document.getElementById('mailing-email');
+    const successMsg = document.getElementById('mailing-success');
+
+    const syncAriaInvalid = (input) => {
+      if (!input.checkValidity()) {
+        input.setAttribute('aria-invalid', 'true');
+      } else {
+        input.removeAttribute('aria-invalid');
+      }
+    };
+
+    mailingForm.addEventListener('blur', (e) => {
+      if (e.target.matches('input[required]')) {
+        syncAriaInvalid(e.target);
+      }
+    }, true);
+
+    mailingForm.addEventListener('input', (e) => {
+      if (e.target.matches('input[required]') && e.target.checkValidity()) {
+        e.target.removeAttribute('aria-invalid');
+      }
+    });
+
+    mailingForm.addEventListener('submit', (e) => {
+      mailingForm.querySelectorAll('input[required]').forEach(syncAriaInvalid);
+      if (mailingForm.checkValidity()) {
+        e.preventDefault();
+        const submitBtn = mailingForm.querySelector('button[type="submit"]');
+        submitBtn.disabled = true;
+        successMsg.style.display = 'block';
+      }
+    });
+  </script>
+
 </body>
 
