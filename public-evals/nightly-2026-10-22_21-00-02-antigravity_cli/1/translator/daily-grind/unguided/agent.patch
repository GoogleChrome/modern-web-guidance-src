+
+        if (targetLanguage === currentLanguage) {
+          return;
+        }
+
+        translatableElements.forEach((el) => el.classList.add('translating'));
+        updateStatus('downloading', `Translating page content to ${targetLanguage.toUpperCase()}...`);
+
+        const TranslatorAPI = getTranslatorNamespace();
+
+        try {
+          if (TranslatorAPI) {
+            let sourceLanguage = currentLanguage;
+            let useOriginalSource = false;
+
+            if (sourceLanguage !== 'en' && typeof TranslatorAPI.availability === 'function') {
+              const directAvailability = await TranslatorAPI.availability({
+                sourceLanguage,
+                targetLanguage
+              });
+              if (directAvailability === 'unavailable' || directAvailability === 'no') {
+                if (targetLanguage === 'en') {
+                  translatableElements.forEach((el) => {
+                    el.textContent = originalTexts.get(el);
+                    el.removeAttribute('lang');
+                  });
+                  document.documentElement.lang = 'en';
+                  currentLanguage = 'en';
+                  setProgress(0, false);
+                  updateStatus('available', 'Restored original English text.');
+                  return;
+                }
+                sourceLanguage = 'en';
+                useOriginalSource = true;
+              }
+            } else if (sourceLanguage === 'en') {
+              useOriginalSource = true;
+            }
+
+            const translator = await getOrCreateTranslator(sourceLanguage, targetLanguage, requestId);
+            if (requestId !== activeTranslationId) return;
+
+            for (const el of translatableElements) {
+              if (requestId !== activeTranslationId) return;
+              const inputText = useOriginalSource ? originalTexts.get(el) : el.textContent.trim();
+              const translated = await translator.translate(inputText);
+              if (requestId !== activeTranslationId) return;
+              el.textContent = translated;
+              el.setAttribute('lang', targetLanguage);
+            }
+
+            document.documentElement.lang = targetLanguage;
+            currentLanguage = targetLanguage;
+            updateStatus('available', `Translated on-device (${sourceLanguage.toUpperCase()} → ${targetLanguage.toUpperCase()}) using the browser Translator API.`);
+          } else {
+            throw new Error('Built-in Translator API is not supported in this browser.');
+          }
+        } catch (err) {
+          if (requestId !== activeTranslationId) return;
+          setProgress(0, false);
+
+          if (targetLanguage === 'en') {
+            translatableElements.forEach((el) => {
+              el.textContent = originalTexts.get(el);
+              el.removeAttribute('lang');
+            });
+            document.documentElement.lang = 'en';
+            currentLanguage = 'en';
+            updateStatus('unavailable', 'Restored original English text.');
+            return;
+          }
+
+          const dict = fallbackTranslations[targetLanguage];
+          if (dict) {
+            translatableElements.forEach((el) => {
+              const key = el.getAttribute('data-translatable');
+              if (dict[key]) {
+                el.textContent = dict[key];
+                el.setAttribute('lang', targetLanguage);
+              }
+            });
+            document.documentElement.lang = targetLanguage;
+            currentLanguage = targetLanguage;
+            updateStatus('unavailable', `Browser on-device Translator API unavailable (${err.message}). Applied built-in offline translation pack for ${targetLanguage.toUpperCase()}.`);
+          } else {
+            updateStatus('unavailable', `Could not translate to ${targetLanguage.toUpperCase()}: ${err.message}`);
+          }
+        } finally {
+          if (requestId === activeTranslationId) {
+            translatableElements.forEach((el) => el.classList.remove('translating'));
+          }
+        }
+      }
+
+      // Initialize status badge on load based on Translator API support
+      (async function initTranslatorStatus() {
+        const TranslatorAPI = getTranslatorNamespace();
+        if (TranslatorAPI) {
+          updateStatus('available', 'Chrome On-Device Translator API detected. Choose a language to translate in your browser.');
+        } else {
+          updateStatus('unavailable', 'On-Device Translator API not detected in this browser; built-in offline translations will be used as fallback.');
+        }
+      })();
+
+      languageSelect.addEventListener('change', (event) => {
+        translatePage(event.target.value);
+      });
+    })();
+  </script>
