+      function getTranslatorNamespace() {
+        if ('Translator' in self && typeof self.Translator?.create === 'function') {
+          return self.Translator;
+        }
+        if (self.ai?.translator && typeof self.ai.translator.create === 'function') {
+          return self.ai.translator;
+        }
+        if (self.translation && typeof self.translation.createTranslator === 'function') {
+          return {
+            availability: async (opts) => self.translation.canTranslate(opts),
+            create: async (opts) => self.translation.createTranslator(opts)
+          };
+        }
+        return null;
+      }
+
+      function updateStatus(state, message) {
+        statusBadge.className = 'status-badge ' + (state || '');
+        if (state === 'available') {
+          statusBadge.textContent = 'On-Device AI Ready';
+        } else if (state === 'downloading' || state === 'downloadable') {
+          statusBadge.textContent = 'Downloading Model';
+        } else if (state === 'unavailable') {
+          statusBadge.textContent = 'Fallback Mode';
+        } else {
+          statusBadge.textContent = 'On-Device Translator';
+        }
+        statusText.textContent = message;
+      }
+
+      function setProgress(percent, visible) {
+        if (!visible) {
+          progressContainer.classList.remove('active');
+          return;
+        }
+        progressContainer.classList.add('active');
+        const clamped = Math.max(0, Math.min(100, Math.round(percent)));
+        progressBar.value = clamped;
+        progressText.textContent = clamped + '%';
+      }
+
+      async function getOrCreateTranslator(sourceLanguage, targetLanguage, requestId) {
+        const pairKey = `${sourceLanguage}->${targetLanguage}`;
+        if (translatorCache.has(pairKey)) {
+          return translatorCache.get(pairKey);
+        }
+
+        const TranslatorAPI = getTranslatorNamespace();
+        if (!TranslatorAPI) {
+          return null;
+        }
+
+        if (typeof TranslatorAPI.availability === 'function') {
+          const availability = await TranslatorAPI.availability({
+            sourceLanguage,
+            targetLanguage
+          });
+
+          if (availability === 'unavailable' || availability === 'no') {
+            throw new Error(`Language pair ${sourceLanguage} to ${targetLanguage} is unavailable on this device.`);
+          }
+
+          if (availability === 'downloadable' || availability === 'downloading' || availability === 'after-download') {
+            updateStatus('downloading', `Downloading ${targetLanguage.toUpperCase()} language pack for on-device translation...`);
+            setProgress(0, true);
+          }
+        }
+
+        const translator = await TranslatorAPI.create({
+          sourceLanguage,
+          targetLanguage,
+          monitor(m) {
+            m.addEventListener('downloadprogress', (e) => {
+              if (requestId !== activeTranslationId) return;
+              const ratio = e.total ? e.loaded / e.total : e.loaded;
+              const pct = Number.isFinite(ratio) ? ratio * 100 : 0;
+              setProgress(pct, true);
+            });
+          }
+        });
+
+        setProgress(100, false);
+        translatorCache.set(pairKey, translator);
+        return translator;
+      }
