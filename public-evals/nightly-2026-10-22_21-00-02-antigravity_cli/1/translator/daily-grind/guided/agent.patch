+  <script>
+    document.addEventListener('DOMContentLoaded', () => {
+      if (!CSS.supports('appearance', 'base-select')) {
+        // Custom select overrides degrade gracefully to native OS select
+      }
+
+      const languageSelect = document.getElementById('language-select');
+      const banner = document.getElementById('translation-banner');
+      const statusText = document.getElementById('translation-status');
+      const startTranslationBtn = document.getElementById('start-translation-btn');
+      const translatableElements = Array.from(document.querySelectorAll('[data-translatable]'));
+
+      // Store original English source strings so translations can always switch cleanly
+      translatableElements.forEach((el) => {
+        el.dataset.originalText = el.textContent.trim();
+      });
+
+      let currentLanguage = 'en';
+      let pendingOptions = null;
+
+      function setBanner(message, showActionBtn = false) {
+        if (!message) {
+          banner.hidden = true;
+          statusText.textContent = '';
+          startTranslationBtn.hidden = true;
+          return;
+        }
+        statusText.textContent = message;
+        startTranslationBtn.hidden = !showActionBtn;
+        banner.hidden = false;
+      }
+
+      function restoreEnglish() {
+        translatableElements.forEach((el) => {
+          el.textContent = el.dataset.originalText;
+        });
+        document.documentElement.lang = 'en';
+        currentLanguage = 'en';
+        setBanner('');
+      }
+
+      // Check if the on-device Translator API is available in the global scope
+      if (!('Translator' in self)) {
+        languageSelect.disabled = true;
+        setBanner('Client-side translation is currently unsupported in this browser.');
+        return;
+      }
+
+      async function runTranslation(options) {
+        try {
+          setBanner('Preparing on-device translation model...');
+          const translator = await self.Translator.create({
+            ...options,
+            monitor(m) {
+              m.addEventListener('downloadprogress', (e) => {
+                const percent = Math.round((e.loaded || 0) * 100);
+                setBanner(`Downloading language model (${percent}%)...`);
+              });
+            },
+          });
+
+          setBanner('Translating coffee menu and story on-device...');
+          for (const el of translatableElements) {
+            const sourceText = el.dataset.originalText;
+            const translated = await translator.translate(sourceText);
+            el.textContent = translated;
+          }
+
+          document.documentElement.lang = options.targetLanguage;
+          currentLanguage = options.targetLanguage;
+          setBanner(`Translated on-device to ${options.targetLanguage.toUpperCase()}.`);
+        } catch (err) {
+          console.warn('On-device translation failed:', err);
+          setBanner('Unable to complete on-device translation on this device.');
+        }
+      }
+
+      languageSelect.addEventListener('change', async () => {
+        const targetLanguage = languageSelect.value;
+        pendingOptions = null;
+
+        if (targetLanguage === 'en') {
+          restoreEnglish();
+          return;
+        }
+
+        // Pass identical configuration options to availability() and create()
+        const options = {
+          sourceLanguage: 'en',
+          targetLanguage,
+        };
+
+        try {
+          const availability = await self.Translator.availability(options);
+
+          if (availability === 'available') {
+            await runTranslation(options);
+          } else if (availability === 'downloadable' || availability === 'downloading') {
+            // Change event is a user gesture, attempt direct creation or offer explicit button click gesture
+            pendingOptions = options;
+            try {
+              await runTranslation(options);
+            } catch (gestureErr) {
+              setBanner(
+                `Language pack (${targetLanguage.toUpperCase()}) requires download.`,
+                true
+              );
+            }
+          } else {
+            // 'unavailable'
+            console.warn('Translation model is unavailable on this device.');
+            languageSelect.value = currentLanguage;
+            setBanner('Translation for this language pair is unavailable on this device.');
+          }
+        } catch (err) {
+          console.warn('Error checking Translator availability:', err);
+          languageSelect.value = currentLanguage;
+          setBanner('Client-side translation is currently unavailable on this device.');
+        }
+      });
+
+      startTranslationBtn.addEventListener('click', async () => {
+        if (!pendingOptions) return;
+        const options = pendingOptions;
+        pendingOptions = null;
+        await runTranslation(options);
+      });
+    });
+  </script>
+
