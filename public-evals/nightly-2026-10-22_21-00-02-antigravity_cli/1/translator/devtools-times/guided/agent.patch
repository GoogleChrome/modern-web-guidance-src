+++ b/src/components/ArticleTranslator.tsx
@@ -0,0 +1,457 @@
+import React, { useState, useEffect, useCallback } from 'react';
+import { LanguageIcon, ArrowPathIcon, ExclamationTriangleIcon } from '@heroicons/react/24/outline';
+
+export interface LanguageOption {
+  code: string;
+  label: string;
+}
+
+export const SUPPORTED_LANGUAGES: LanguageOption[] = [
+  { code: 'en', label: 'English (en)' },
+  { code: 'es', label: 'Spanish — Español (es)' },
+  { code: 'fr', label: 'French — Français (fr)' },
+  { code: 'de', label: 'German — Deutsch (de)' },
+  { code: 'it', label: 'Italian — Italiano (it)' },
+  { code: 'pt', label: 'Portuguese — Português (pt)' },
+  { code: 'nl', label: 'Dutch — Nederlands (nl)' },
+  { code: 'ja', label: 'Japanese — 日本語 (ja)' },
+  { code: 'ko', label: 'Korean — 한국어 (ko)' },
+  { code: 'zh', label: 'Chinese — 中文 (zh)' },
+  { code: 'zh-Hant', label: 'Chinese Traditional — 繁體中文 (zh-Hant)' },
+  { code: 'ar', label: 'Arabic — العربية (ar)' },
+  { code: 'hi', label: 'Hindi — हिन्दी (hi)' },
+  { code: 'ru', label: 'Russian — Русский (ru)' },
+  { code: 'pl', label: 'Polish — Polski (pl)' },
+  { code: 'tr', label: 'Turkish — Türkçe (tr)' },
+  { code: 'vi', label: 'Vietnamese — Tiếng Việt (vi)' },
+  { code: 'id', label: 'Indonesian — Bahasa Indonesia (id)' },
+  { code: 'th', label: 'Thai — ไทย (th)' },
+  { code: 'uk', label: 'Ukrainian — Українська (uk)' },
+  { code: 'sv', label: 'Swedish — Svenska (sv)' },
+  { code: 'da', label: 'Danish — Dansk (da)' },
+  { code: 'no', label: 'Norwegian — Norsk (no)' },
+  { code: 'fi', label: 'Finnish — Suomi (fi)' },
+  { code: 'cs', label: 'Czech — Čeština (cs)' },
+  { code: 'el', label: 'Greek — Ελληνικά (el)' },
+  { code: 'he', label: 'Hebrew — עברית (he)' },
+  { code: 'ro', label: 'Romanian — Română (ro)' },
+  { code: 'hu', label: 'Hungarian — Magyar (hu)' },
+  { code: 'bg', label: 'Bulgarian — Български (bg)' },
+  { code: 'hr', label: 'Croatian — Hrvatski (hr)' },
+  { code: 'sk', label: 'Slovak — Slovenčina (sk)' },
+  { code: 'sl', label: 'Slovenian — Slovenščina (sl)' },
+  { code: 'lt', label: 'Lithuanian — Lietuvių (lt)' },
+  { code: 'bn', label: 'Bengali — বাংলা (bn)' },
+  { code: 'ta', label: 'Tamil — தமிழ் (ta)' },
+  { code: 'te', label: 'Telugu — తెలుగు (te)' },
+  { code: 'mr', label: 'Marathi — मराठी (mr)' },
+  { code: 'kn', label: 'Kannada — ಕನ್ನಡ (kn)' },
+];
+
+interface TranslationTarget {
+  element: HTMLElement;
+  originalText: string;
+}
+
+const originalTextStore = new WeakMap<HTMLElement, string>();
+
+function collectTranslatableElements(root: ParentNode = document): TranslationTarget[] {
+  const results: TranslationTarget[] = [];
+  const seen = new Set<HTMLElement>();
+
+  const explicitNodes = root.querySelectorAll<HTMLElement>('[data-translatable]');
+  explicitNodes.forEach((el) => {
+    // If a container is marked data-translatable="prose", collect its text block children
+    if (el.getAttribute('data-translatable') === 'prose') {
+      const blocks = el.querySelectorAll<HTMLElement>('p, h2, h3, h4, li, blockquote, figcaption');
+      blocks.forEach((block) => {
+        if (seen.has(block)) return;
+        const text = (originalTextStore.get(block) ?? block.textContent ?? '').trim();
+        if (text) {
+          if (!originalTextStore.has(block)) {
+            originalTextStore.set(block, block.textContent ?? '');
+          }
+          seen.add(block);
+          results.push({ element: block, originalText: originalTextStore.get(block)! });
+        }
+      });
+    } else {
+      if (seen.has(el)) return;
+      const text = (originalTextStore.get(el) ?? el.textContent ?? '').trim();
+      if (text) {
+        if (!originalTextStore.has(el)) {
+          originalTextStore.set(el, el.textContent ?? '');
+        }
+        seen.add(el);
+        results.push({ element: el, originalText: originalTextStore.get(el)! });
+      }
+    }
+  });
+
+  return results;
+}
+
+interface ArticleTranslatorProps {
+  compact?: boolean;
+}
+
+export default function ArticleTranslator({ compact = false }: ArticleTranslatorProps) {
+  const [sourceLanguage, setSourceLanguage] = useState<string>('en');
+  const [targetLanguage, setTargetLanguage] = useState<string>('es');
+  const [apiSupported, setApiSupported] = useState<boolean | null>(null);
+  const [availability, setAvailability] = useState<TranslatorAvailability | 'checking' | 'same-language'>('checking');
+  const [isTranslating, setIsTranslating] = useState<boolean>(false);
+  const [downloadProgress, setDownloadProgress] = useState<number | null>(null);
+  const [translatedCount, setTranslatedCount] = useState<{ current: number; total: number } | null>(null);
+  const [isTranslated, setIsTranslated] = useState<boolean>(false);
+  const [activeTargetLang, setActiveTargetLang] = useState<string | null>(null);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [isExpanded, setIsExpanded] = useState<boolean>(!compact);
+
+  // Check if global Translator API exists and check pair availability
+  const checkAvailability = useCallback(async (src: string, tgt: string) => {
+    setErrorMessage(null);
+    if (typeof self === 'undefined' || !('Translator' in self) || !self.Translator) {
+      setApiSupported(false);
+      setAvailability('unavailable');
+      return;
+    }
+
+    setApiSupported(true);
+
+    if (src === tgt) {
+      setAvailability('same-language');
+      return;
+    }
+
+    setAvailability('checking');
+    try {
+      const options: TranslatorLanguageOptions = {
+        sourceLanguage: src,
+        targetLanguage: tgt,
+      };
+      const status = await self.Translator.availability(options);
+      setAvailability(status);
+    } catch (err) {
+      console.warn('Translator availability check failed:', err);
+      setAvailability('unavailable');
+    }
+  }, []);
+
+  useEffect(() => {
+    checkAvailability(sourceLanguage, targetLanguage);
+  }, [sourceLanguage, targetLanguage, checkAvailability]);
+
+  const handleResetOriginal = useCallback(() => {
+    const targets = collectTranslatableElements(document);
+    targets.forEach(({ element, originalText }) => {
+      element.textContent = originalText;
+      element.removeAttribute('lang');
+    });
+    setIsTranslated(false);
+    setActiveTargetLang(null);
+    setTranslatedCount(null);
+    setErrorMessage(null);
+  }, []);
+
+  const handleTranslate = async () => {
+    setErrorMessage(null);
+
+    if (typeof self === 'undefined' || !('Translator' in self) || !self.Translator) {
+      setApiSupported(false);
+      setAvailability('unavailable');
+      setErrorMessage('Client-side translation is currently unsupported in this browser.');
+      return;
+    }
+
+    if (sourceLanguage === targetLanguage) {
+      handleResetOriginal();
+      return;
+    }
+
+    // Identical language pair options object for availability() and create()
+    const options: TranslatorLanguageOptions = {
+      sourceLanguage,
+      targetLanguage,
+    };
+
+    try {
+      setIsTranslating(true);
+      setDownloadProgress(null);
+
+      const currentAvailability = await self.Translator.availability(options);
+      setAvailability(currentAvailability);
+
+      if (currentAvailability === 'unavailable') {
+        setErrorMessage(
+          `On-device translation from ${sourceLanguage.toUpperCase()} to ${targetLanguage.toUpperCase()} is unavailable on this device.`
+        );
+        setIsTranslating(false);
+        return;
+      }
+
+      // Create translator inside the user gesture handler with downloadprogress monitor
+      const translator = await self.Translator.create({
+        ...options,
+        monitor(m) {
+          m.addEventListener('downloadprogress', (e) => {
+            const pct = Math.round((e.loaded || 0) * 100);
+            setDownloadProgress(pct);
+          });
+        },
+      });
+
+      setDownloadProgress(null);
+      setAvailability('available');
+
+      const targets = collectTranslatableElements(document);
+      if (targets.length === 0) {
+        setIsTranslating(false);
+        return;
+      }
+
+      setTranslatedCount({ current: 0, total: targets.length });
+
+      for (let i = 0; i < targets.length; i++) {
+        const { element, originalText } = targets[i];
+        const trimmed = originalText.trim();
+        if (!trimmed) continue;
+
+        if (trimmed.length > 260 && typeof translator.translateStreaming === 'function') {
+          const stream = translator.translateStreaming(trimmed);
+          let accumulated = '';
+          for await (const chunk of stream) {
+            accumulated += chunk;
+            element.textContent = accumulated;
+          }
+          element.setAttribute('lang', targetLanguage);
+        } else {
+          const translated = await translator.translate(trimmed);
+          element.textContent = translated;
+          element.setAttribute('lang', targetLanguage);
+        }
+
+        setTranslatedCount({ current: i + 1, total: targets.length });
+      }
+
+      if (typeof translator.destroy === 'function') {
+        translator.destroy();
+      }
+
+      setIsTranslated(true);
+      setActiveTargetLang(targetLanguage);
+    } catch (err: any) {
+      console.error('Translation failed:', err);
+      setErrorMessage(
+        err?.message || 'Unable to complete on-device translation. Ensure browser AI models are enabled.'
+      );
+    } finally {
+      setIsTranslating(false);
+      setDownloadProgress(null);
+    }
+  };
+
+  const handleSwapLanguages = () => {
+    const prevSource = sourceLanguage;
+    setSourceLanguage(targetLanguage);
+    setTargetLanguage(prevSource);
+  };
+
+  const isDisabled =
+    apiSupported === false ||
+    availability === 'unavailable' ||
+    availability === 'checking' ||
+    availability === 'same-language' ||
+    isTranslating;
+
+  if (compact && !isExpanded) {
+    return (
+      <div className="relative inline-flex items-center">
+        <button
+          type="button"
+          onClick={() => setIsExpanded(true)}
+          className="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-700 hover:text-amber-600 bg-gray-100 hover:bg-amber-50 border border-gray-300 px-2.5 py-1.5 rounded transition-colors cursor-pointer"
+          title="Translate articles & teasers on-device"
+        >
+          <LanguageIcon className="w-4 h-4 text-amber-600" />
+          <span>Translate</span>
+          {isTranslated && activeTargetLang && (
+            <span className="bg-amber-500 text-white text-[10px] px-1.5 py-0.2 rounded uppercase">
+              {activeTargetLang}
+            </span>
+          )}
+        </button>
+      </div>
+    );
+  }
+
+  return (
+    <div
+      className={`${
+        compact
+          ? 'bg-gray-50 border border-gray-300 rounded-md p-2.5 shadow-sm text-xs'
+          : 'bg-amber-50/60 border border-amber-200/80 rounded-lg p-3.5 my-4 text-sm'
+      }`}
+      aria-label="On-device article translator"
+    >
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        {/* Title & Status Badge */}
+        <div className="flex items-center gap-2">
+          <LanguageIcon className="w-5 h-5 text-amber-700 flex-shrink-0" />
+          <span className="font-semibold text-gray-900">On-Device Translate</span>
+          {apiSupported === false && (
+            <span className="inline-flex items-center gap-1 text-xs bg-gray-200 text-gray-700 px-2 py-0.5 rounded">
+              <ExclamationTriangleIcon className="w-3.5 h-3.5 text-gray-600" />
+              Unsupported Browser
+            </span>
+          )}
+          {apiSupported && availability === 'available' && (
+            <span className="text-[11px] bg-green-100 text-green-800 px-2 py-0.5 rounded font-medium">
+              Model Ready
+            </span>
+          )}
+          {apiSupported && (availability === 'downloadable' || availability === 'downloading') && (
+            <span className="text-[11px] bg-amber-100 text-amber-800 px-2 py-0.5 rounded font-medium">
+              {availability === 'downloading' ? 'Downloading Model…' : 'Model Downloadable'}
+            </span>
+          )}
+          {apiSupported && availability === 'unavailable' && (
+            <span className="text-[11px] bg-red-100 text-red-800 px-2 py-0.5 rounded font-medium">
+              Pair Unavailable
+            </span>
+          )}
+        </div>
+
+        {/* Controls */}
+        <div className="flex flex-wrap items-center gap-2">
+          <label className="flex items-center gap-1 text-xs text-gray-600">
+            <span className="sr-only sm:not-sr-only font-medium">From:</span>
+            <select
+              aria-label="Source language"
+              value={sourceLanguage}
+              onChange={(e) => setSourceLanguage(e.target.value)}
+              disabled={apiSupported === false || isTranslating}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-50"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`src-${lang.code}`} value={lang.code}>
+                  {lang.label}
+                </option>
+              ))}
+            </select>
+          </label>
+
+          <button
+            type="button"
+            onClick={handleSwapLanguages}
+            disabled={apiSupported === false || isTranslating}
+            title="Swap source and target languages"
+            aria-label="Swap source and target languages"
+            className="p-1 text-gray-500 hover:text-amber-700 disabled:opacity-40 cursor-pointer"
+          >
+            ⇄
+          </button>
+
+          <label className="flex items-center gap-1 text-xs text-gray-600">
+            <span className="sr-only sm:not-sr-only font-medium">To:</span>
+            <select
+              aria-label="Target language"
+              value={targetLanguage}
+              onChange={(e) => setTargetLanguage(e.target.value)}
+              disabled={apiSupported === false || isTranslating}
+              className="bg-white border border-gray-300 rounded px-2 py-1 text-xs text-gray-800 focus:outline-none focus:ring-2 focus:ring-amber-400 disabled:opacity-50"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`tgt-${lang.code}`} value={lang.code}>
+                  {lang.label}
+                </option>
+              ))}
+            </select>
+          </label>
+
+          <button
+            type="button"
+            onClick={handleTranslate}
+            disabled={isDisabled}
+            className="inline-flex items-center gap-1.5 bg-gray-900 hover:bg-amber-600 disabled:bg-gray-300 disabled:text-gray-500 text-white font-semibold text-xs px-3 py-1.5 rounded transition-colors cursor-pointer disabled:cursor-not-allowed"
+          >
+            {isTranslating ? (
+              <>
+                <ArrowPathIcon className="w-3.5 h-3.5 animate-spin" />
+                <span>
+                  {downloadProgress !== null
+                    ? `Downloading ${downloadProgress}%`
+                    : translatedCount
+                    ? `Translating (${translatedCount.current}/${translatedCount.total})`
+                    : 'Translating…'}
+                </span>
+              </>
+            ) : (
+              <span>
+                {availability === 'downloadable' ? 'Download & Translate' : 'Translate Page'}
+              </span>
+            )}
+          </button>
+
+          {isTranslated && (
+            <button
+              type="button"
+              onClick={handleResetOriginal}
+              disabled={isTranslating}
+              className="inline-flex items-center gap-1 bg-white hover:bg-gray-100 text-gray-700 border border-gray-300 font-medium text-xs px-2.5 py-1.5 rounded transition-colors cursor-pointer"
+            >
+              Restore Original
+            </button>
+          )}
+
+          {compact && (
+            <button
+              type="button"
+              onClick={() => setIsExpanded(false)}
+              className="text-gray-400 hover:text-gray-600 px-1 text-xs cursor-pointer"
+              aria-label="Minimize translation bar"
+              title="Minimize"
+            >
+              ✕
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Download Progress Bar */}
+      {downloadProgress !== null && (
+        <div className="mt-2">
+          <div className="flex justify-between text-[11px] text-gray-600 mb-1">
+            <span>Downloading on-device language model…</span>
+            <span>{downloadProgress}%</span>
+          </div>
+          <div className="w-full bg-gray-200 h-1.5 rounded-full overflow-hidden">
+            <div
+              className="bg-amber-500 h-full transition-all duration-200"
+              style={{ width: `${downloadProgress}%` }}
+            />
+          </div>
+        </div>
+      )}
+
+      {/* Graceful Degradation & Status Messages */}
+      {apiSupported === false && (
+        <p className="mt-2 text-xs text-gray-600" role="status">
+          Client-side translation is currently unsupported in this browser. Use Chrome 138+ or Edge 148+ on desktop to translate articles and teasers on-device with the Built-in AI Translator API.
+        </p>
+      )}
+
+      {apiSupported && availability === 'unavailable' && !errorMessage && (
+        <p className="mt-2 text-xs text-red-700" role="status">
+          Translation model for {sourceLanguage.toUpperCase()} → {targetLanguage.toUpperCase()} is unavailable on this device. Please select another language pair.
+        </p>
+      )}
+
+      {errorMessage && (
+        <p className="mt-2 text-xs text-red-700" role="alert">
+          {errorMessage}
+        </p>
+      )}
+    </div>
+  );
+}
