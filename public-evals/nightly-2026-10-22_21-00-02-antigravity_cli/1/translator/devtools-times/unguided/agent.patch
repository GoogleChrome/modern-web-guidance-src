+export async function getOrCreateTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onProgress?: (progressPercent: number) => void,
+  signal?: AbortSignal
+): Promise<TranslatorInstance> {
+  const pairKey = `${sourceLanguage}->${targetLanguage}`;
+  const cached = translatorCache.get(pairKey);
+  if (cached) {
+    onProgress?.(100);
+    return cached;
+  }
+
+  const monitorCallback = (monitor: TranslatorCreateMonitor) => {
+    monitor.addEventListener('downloadprogress', (e) => {
+      const loaded = typeof e.loaded === 'number' ? e.loaded : 0;
+      const total = typeof e.total === 'number' && e.total > 0 ? e.total : 1;
+      // In Chrome's Built-in AI spec, e.loaded is often between 0 and 1, or loaded/total bytes
+      const ratio = loaded <= 1 && total === 1 ? loaded : loaded / total;
+      const pct = Math.min(100, Math.max(0, Math.round(ratio * 100)));
+      onProgress?.(pct);
+    });
+  };
+
+  // Try official Translator.create()
+  const TranslatorAPI = typeof window !== 'undefined' ? ((self as any).Translator || window.Translator) : undefined;
+  if (TranslatorAPI && typeof TranslatorAPI.create === 'function') {
+    const instance = await TranslatorAPI.create({
+      sourceLanguage,
+      targetLanguage,
+      signal,
+      monitor: monitorCallback,
+    });
+    translatorCache.set(pairKey, instance);
+    onProgress?.(100);
+    return instance;
+  }
+
+  // Try window.ai.translator.create()
+  if (typeof window !== 'undefined' && window.ai?.translator && typeof window.ai.translator.create === 'function') {
+    const instance = await window.ai.translator.create({
+      sourceLanguage,
+      targetLanguage,
+      signal,
+      monitor: monitorCallback,
+    });
+    translatorCache.set(pairKey, instance);
+    onProgress?.(100);
+    return instance;
+  }
+
+  // Try legacy window.translation.createTranslator()
+  if (typeof window !== 'undefined' && window.translation && typeof window.translation.createTranslator === 'function') {
+    const instance = await window.translation.createTranslator({
+      sourceLanguage,
+      targetLanguage,
+      signal,
+      monitor: monitorCallback,
+    });
+    translatorCache.set(pairKey, instance);
+    onProgress?.(100);
+    return instance;
+  }
+
+  // On-device fallback translator when browser native Translator API is not enabled
+  const fallbackInstance = createLocalFallbackTranslator(sourceLanguage, targetLanguage, onProgress);
+  translatorCache.set(pairKey, fallbackInstance);
+  return fallbackInstance;
+}
