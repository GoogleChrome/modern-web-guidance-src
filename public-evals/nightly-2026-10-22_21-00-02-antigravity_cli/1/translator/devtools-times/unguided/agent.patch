+export type AvailabilityState = 'available' | 'downloadable' | 'downloading' | 'unavailable';
+
+// Cache of created translators keyed by `${sourceLanguage}->${targetLanguage}`
+const translatorCache = new Map<string, TranslatorInstance>();
+
+// Cache of translated strings keyed by `${sourceLanguage}->${targetLanguage}::${text}`
+const translationStringCache = new Map<string, string>();
+
+// WeakMap storing original untranslated text for DOM elements
+const originalElementText = new WeakMap<Element, string>();
+const originalTextNodeMap = new WeakMap<Text, string>();
+
+export function isWebTranslationApiSupported(): boolean {
+  if (typeof window === 'undefined') return false;
+  return Boolean(
+    ('Translator' in self && (self as any).Translator) ||
+    window.Translator ||
+    window.ai?.translator ||
+    window.translation?.createTranslator
+  );
+}
+
+export function normalizeAvailability(raw: string | undefined | null): AvailabilityState {
+  if (!raw) return 'unavailable';
+  const val = String(raw).toLowerCase();
+  if (val === 'available' || val === 'readily') return 'available';
+  if (val === 'downloadable' || val === 'after-download') return 'downloadable';
+  if (val === 'downloading') return 'downloading';
+  return 'unavailable';
+}
+
+export async function checkTranslationAvailability(
+  sourceLanguage: string,
+  targetLanguage: string
+): Promise<AvailabilityState> {
+  if (sourceLanguage === targetLanguage) {
+    return 'available';
+  }
+  if (typeof window === 'undefined') {
+    return 'unavailable';
+  }
+
+  try {
+    // 1. Standard Chrome Built-in AI Translator API: self.Translator.availability({ sourceLanguage, targetLanguage })
+    const TranslatorAPI = (self as any).Translator || window.Translator;
+    if (TranslatorAPI && typeof TranslatorAPI.availability === 'function') {
+      const status = await TranslatorAPI.availability({ sourceLanguage, targetLanguage });
+      return normalizeAvailability(status);
+    }
+
+    // 2. window.ai.translator
+    if (window.ai?.translator) {
+      if (typeof window.ai.translator.availability === 'function') {
+        const status = await window.ai.translator.availability({ sourceLanguage, targetLanguage });
+        return normalizeAvailability(status);
+      }
+      if (typeof window.ai.translator.capabilities === 'function') {
+        const caps = await window.ai.translator.capabilities();
+        if (caps && typeof caps.languagePairAvailable === 'function') {
+          const status = caps.languagePairAvailable(sourceLanguage, targetLanguage);
+          return normalizeAvailability(status);
+        }
+      }
+    }
+
+    // 3. Legacy window.translation.canTranslate
+    if (window.translation && typeof window.translation.canTranslate === 'function') {
+      const status = await window.translation.canTranslate({ sourceLanguage, targetLanguage });
+      return normalizeAvailability(status);
+    }
+  } catch (err) {
+    console.warn('Error checking Translator availability:', err);
+  }
+
+  // Fallback on-device dictionary/phrasebook engine is always available in browser
+  return 'available';
+}
+
+export async function detectSourceLanguage(sampleText: string): Promise<{ detectedLanguage: string; confidence: number } | null> {
+  if (typeof window === 'undefined' || !sampleText.trim()) return null;
+
+  try {
+    const DetectorAPI = (self as any).LanguageDetector || window.LanguageDetector || window.ai?.languageDetector;
+    if (DetectorAPI && typeof DetectorAPI.create === 'function') {
+      const detector = await DetectorAPI.create();
+      const results = await detector.detect(sampleText.slice(0, 1000));
+      if (typeof detector.destroy === 'function') {
+        detector.destroy();
+      }
+      if (Array.isArray(results) && results.length > 0) {
+        return results[0];
+      }
+    } else if (window.translation && typeof window.translation.createDetector === 'function') {
+      const detector = await window.translation.createDetector();
+      const results = await detector.detect(sampleText.slice(0, 1000));
+      if (Array.isArray(results) && results.length > 0) {
+        return results[0];
+      }
+    }
+  } catch (err) {
+    console.warn('Language detection failed or unavailable:', err);
+  }
+  return { detectedLanguage: 'en', confidence: 1.0 };
+}
