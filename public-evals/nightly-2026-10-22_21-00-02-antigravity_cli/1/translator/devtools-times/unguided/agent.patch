diff --git a/src/components/ArticleTranslator.tsx b/src/components/ArticleTranslator.tsx
new file mode 100644
index 0000000..2207e66
--- /dev/null
+++ b/src/components/ArticleTranslator.tsx
@@ -0,0 +1,673 @@
+import React, { useState, useEffect, useRef, useCallback } from 'react';
+import {
+  SUPPORTED_LANGUAGES,
+  checkTranslationAvailability,
+  detectSourceLanguage,
+  isWebTranslationApiSupported,
+  translateDOMElements,
+  restoreOriginalDOMElements,
+  loadTranslationPreferences,
+  saveTranslationPreferences,
+  type AvailabilityState,
+} from '../utils/translator';
+
+export interface ArticleTranslatorProps {
+  /**
+   * 'article': Full toolbar for an individual article page.
+   * 'teaser': Compact inline button/popover for an individual teaser card.
+   * 'global': Global header control to translate all articles & teasers on the page.
+   */
+  mode?: 'article' | 'teaser' | 'global';
+  /**
+   * Optional CSS selector or scope ID to target specific elements.
+   * When omitted:
+   * - 'article' targets `[data-article-translatable]` (or `[data-translatable]` inside `<article>`)
+   * - 'teaser' targets the closest `[data-teaser-card]` container's `[data-translatable]` elements
+   * - 'global' targets all `[data-translatable]` elements on the page
+   */
+  scopeId?: string;
+  defaultSourceLanguage?: string;
+  defaultTargetLanguage?: string;
+}
+
+export default function ArticleTranslator({
+  mode = 'article',
+  scopeId,
+  defaultSourceLanguage = 'en',
+  defaultTargetLanguage = 'es',
+}: ArticleTranslatorProps) {
+  const [sourceLanguage, setSourceLanguage] = useState<string>(defaultSourceLanguage);
+  const [targetLanguage, setTargetLanguage] = useState<string>(defaultTargetLanguage);
+  const [detectedLang, setDetectedLang] = useState<{ code: string; confidence: number } | null>(null);
+  const [availability, setAvailability] = useState<AvailabilityState>('available');
+  const [hasNativeApi, setHasNativeApi] = useState<boolean>(false);
+  const [status, setStatus] = useState<'idle' | 'downloading' | 'translating' | 'translated' | 'error'>('idle');
+  const [activeLanguage, setActiveLanguage] = useState<string | null>(null);
+  const [progress, setProgress] = useState<{ completed: number; total: number; downloadPercent: number }>({
+    completed: 0,
+    total: 0,
+    downloadPercent: 0,
+  });
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+  const [isOpen, setIsOpen] = useState<boolean>(false);
+
+  const rootRef = useRef<HTMLDivElement>(null);
+  const abortControllerRef = useRef<AbortController | null>(null);
+
+  const getTargetElements = useCallback((): Element[] => {
+    if (typeof document === 'undefined') return [];
+
+    if (scopeId) {
+      const container = document.getElementById(scopeId) || document.querySelector(`[data-translate-scope="${scopeId}"]`);
+      if (container) {
+        return Array.from(container.querySelectorAll('[data-translatable]'));
+      }
+    }
+
+    if (mode === 'teaser' && rootRef.current) {
+      const card = rootRef.current.closest('[data-teaser-card]');
+      if (card) {
+        return Array.from(card.querySelectorAll('[data-translatable]'));
+      }
+    }
+
+    if (mode === 'article') {
+      const articleContainer =
+        (rootRef.current && rootRef.current.closest('article')) ||
+        document.querySelector('article[data-article-root]') ||
+        document.querySelector('article');
+      if (articleContainer) {
+        const items = Array.from(articleContainer.querySelectorAll('[data-translatable]'));
+        if (items.length > 0) return items;
+      }
+    }
+
+    return Array.from(document.querySelectorAll('[data-translatable]'));
+  }, [mode, scopeId]);
+
+  // Initialize saved language preferences & check API support
+  useEffect(() => {
+    const prefs = loadTranslationPreferences();
+    if (prefs.sourceLanguage) setSourceLanguage(prefs.sourceLanguage);
+    if (prefs.targetLanguage) setTargetLanguage(prefs.targetLanguage);
+    setHasNativeApi(isWebTranslationApiSupported());
+  }, []);
+
+  // Update availability status whenever source/target language changes
+  useEffect(() => {
+    let cancelled = false;
+    checkTranslationAvailability(sourceLanguage, targetLanguage).then((state) => {
+      if (!cancelled) {
+        setAvailability(state);
+      }
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [sourceLanguage, targetLanguage]);
+
+  // Detect source language from content on article page
+  useEffect(() => {
+    if (mode !== 'article') return;
+    const elements = getTargetElements();
+    const sample = elements
+      .slice(0, 3)
+      .map((el) => el.textContent || '')
+      .join(' ')
+      .trim();
+    if (!sample) return;
+
+    let cancelled = false;
+    detectSourceLanguage(sample).then((res) => {
+      if (!cancelled && res && res.detectedLanguage) {
+        setDetectedLang({ code: res.detectedLanguage, confidence: res.confidence });
+      }
+    });
+    return () => {
+      cancelled = true;
+    };
+  }, [mode, getTargetElements]);
+
+  // Listen for global translation broadcasts so individual controls stay synchronized
+  useEffect(() => {
+    const handleGlobalTranslateEvent = (e: Event) => {
+      const customEvent = e as CustomEvent<{
+        sourceLanguage: string;
+        targetLanguage: string;
+        action: 'translate' | 'restore';
+      }>;
+      if (!customEvent.detail) return;
+      const { sourceLanguage: src, targetLanguage: tgt, action } = customEvent.detail;
+      if (action === 'restore') {
+        setActiveLanguage(null);
+        setStatus('idle');
+      } else if (action === 'translate') {
+        setSourceLanguage(src);
+        setTargetLanguage(tgt);
+        setActiveLanguage(tgt);
+        setStatus('translated');
+      }
+    };
+
+    window.addEventListener('devtools-times:translation-change', handleGlobalTranslateEvent);
+    return () => {
+      window.removeEventListener('devtools-times:translation-change', handleGlobalTranslateEvent);
+    };
+  }, []);
+
+  // Close popover on outside click for teaser/global modes
+  useEffect(() => {
+    if (!isOpen) return;
+    const handleClickOutside = (event: MouseEvent) => {
+      if (rootRef.current && !rootRef.current.contains(event.target as Node)) {
+        setIsOpen(false);
+      }
+    };
+    document.addEventListener('mousedown', handleClickOutside);
+    return () => {
+      document.removeEventListener('mousedown', handleClickOutside);
+    };
+  }, [isOpen]);
+
+  const handleTranslate = async (overrideTargetLang?: string, overrideSourceLang?: string) => {
+    const srcLang = overrideSourceLang || sourceLanguage;
+    const tgtLang = overrideTargetLang || targetLanguage;
+
+    if (srcLang === tgtLang) {
+      handleRestoreOriginal();
+      return;
+    }
+
+    abortControllerRef.current?.abort();
+    const controller = new AbortController();
+    abortControllerRef.current = controller;
+
+    setErrorMessage(null);
+    const elements = getTargetElements();
+    if (elements.length === 0) {
+      return;
+    }
+
+    saveTranslationPreferences({ sourceLanguage: srcLang, targetLanguage: tgtLang });
+
+    try {
+      setStatus(availability === 'downloadable' ? 'downloading' : 'translating');
+      setProgress({ completed: 0, total: elements.length, downloadPercent: 0 });
+
+      await translateDOMElements(elements, srcLang, tgtLang, {
+        signal: controller.signal,
+        onProgress: (completed, total, downloadPct = 100) => {
+          if (completed === 0 && downloadPct < 100) {
+            setStatus('downloading');
+          } else {
+            setStatus('translating');
+          }
+          setProgress({ completed, total, downloadPercent: downloadPct });
+        },
+      });
+
+      if (!controller.signal.aborted) {
+        setStatus('translated');
+        setActiveLanguage(tgtLang);
+        setAvailability('available');
+
+        if (mode === 'global') {
+          window.dispatchEvent(
+            new CustomEvent('devtools-times:translation-change', {
+              detail: { sourceLanguage: srcLang, targetLanguage: tgtLang, action: 'translate' },
+            })
+          );
+        }
+      }
+    } catch (err: any) {
+      if (err?.name === 'AbortError') return;
+      console.error('On-device translation failed:', err);
+      setStatus('error');
+      setErrorMessage(err?.message || 'Unable to complete on-device translation.');
+    }
+  };
+
+  const handleRestoreOriginal = () => {
+    abortControllerRef.current?.abort();
+    const elements = getTargetElements();
+    restoreOriginalDOMElements(elements);
+    setStatus('idle');
+    setActiveLanguage(null);
+    setErrorMessage(null);
+
+    if (mode === 'global') {
+      window.dispatchEvent(
+        new CustomEvent('devtools-times:translation-change', {
+          detail: { sourceLanguage, targetLanguage, action: 'restore' },
+        })
+      );
+    }
+  };
+
+  const handleSwapLanguages = () => {
+    const nextSource = targetLanguage;
+    const nextTarget = sourceLanguage;
+    setSourceLanguage(nextSource);
+    setTargetLanguage(nextTarget);
+    saveTranslationPreferences({ sourceLanguage: nextSource, targetLanguage: nextTarget });
+    if (status === 'translated') {
+      handleTranslate(nextTarget, nextSource);
+    }
+  };
+
+  const targetLangObj = SUPPORTED_LANGUAGES.find((l) => l.code === targetLanguage) || SUPPORTED_LANGUAGES[1];
+  const activeLangObj = activeLanguage ? SUPPORTED_LANGUAGES.find((l) => l.code === activeLanguage) : null;
+
+  // 1. COMPACT TEASER MODE
+  if (mode === 'teaser') {
+    return (
+      <div ref={rootRef} className="relative inline-flex items-center" data-no-translate="true">
+        <div className="inline-flex items-center rounded-full border border-gray-200 bg-gray-50 hover:bg-amber-50 hover:border-amber-300 transition-colors text-xs">
+          <button
+            type="button"
+            onClick={(e) => {
+              e.preventDefault();
+              e.stopPropagation();
+              if (status === 'translated' && activeLanguage === targetLanguage) {
+                handleRestoreOriginal();
+              } else {
+                handleTranslate(targetLanguage, sourceLanguage);
+              }
+            }}
+            title={
+              status === 'translated'
+                ? 'Restore original language'
+                : `Translate teaser to ${targetLangObj.name} on-device`
+            }
+            aria-label={
+              status === 'translated'
+                ? 'Restore original language'
+                : `Translate teaser to ${targetLangObj.name}`
+            }
+            className={`inline-flex items-center gap-1 px-2 py-1 rounded-l-full font-medium cursor-pointer ${
+              status === 'translated' ? 'text-amber-800 bg-amber-100/70' : 'text-gray-600 hover:text-gray-900'
+            }`}
+          >
+            {/* Translate Icon */}
+            <svg
+              className="w-3.5 h-3.5 text-amber-600 shrink-0"
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+            <span>
+              {status === 'translating' || status === 'downloading'
+                ? '...'
+                : status === 'translated' && activeLangObj
+                ? `Original (${activeLangObj.code.toUpperCase()})`
+                : targetLangObj.code.toUpperCase()}
+            </span>
+          </button>
+
+          <button
+            type="button"
+            onClick={(e) => {
+              e.preventDefault();
+              e.stopPropagation();
+              setIsOpen((prev) => !prev);
+            }}
+            aria-label="Choose teaser translation language"
+            title="Select translation language"
+            className="px-1.5 py-1 border-l border-gray-200 text-gray-500 hover:text-gray-800 rounded-r-full cursor-pointer"
+          >
+            <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+              <path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" />
+            </svg>
+          </button>
+        </div>
+
+        {isOpen && (
+          <div
+            onClick={(e) => {
+              e.preventDefault();
+              e.stopPropagation();
+            }}
+            className="absolute bottom-full right-0 mb-1.5 w-52 bg-white border border-gray-200 rounded-lg shadow-lg p-2.5 z-30 text-xs"
+          >
+            <div className="flex items-center justify-between mb-2 pb-1.5 border-b border-gray-100">
+              <span className="font-semibold text-gray-800 flex items-center gap-1">
+                <span className="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
+                On-Device Translate
+              </span>
+              {status === 'translated' && (
+                <button
+                  type="button"
+                  onClick={() => {
+                    handleRestoreOriginal();
+                    setIsOpen(false);
+                  }}
+                  className="text-amber-700 hover:underline font-medium cursor-pointer"
+                >
+                  Reset
+                </button>
+              )}
+            </div>
+
+            <label className="block text-[11px] text-gray-500 mb-1">Translate teaser into:</label>
+            <div className="grid grid-cols-2 gap-1 max-h-40 overflow-y-auto">
+              {SUPPORTED_LANGUAGES.filter((l) => l.code !== sourceLanguage).map((lang) => (
+                <button
+                  key={lang.code}
+                  type="button"
+                  onClick={() => {
+                    setTargetLanguage(lang.code);
+                    handleTranslate(lang.code, sourceLanguage);
+                    setIsOpen(false);
+                  }}
+                  className={`flex items-center gap-1.5 px-2 py-1 rounded text-left transition-colors cursor-pointer ${
+                    activeLanguage === lang.code
+                      ? 'bg-amber-100 text-amber-900 font-semibold'
+                      : 'hover:bg-gray-100 text-gray-700'
+                  }`}
+                >
+                  <span>{lang.flag}</span>
+                  <span className="truncate">{lang.name}</span>
+                </button>
+              ))}
+            </div>
+          </div>
+        )}
+      </div>
+    );
+  }
+
+  // 2. GLOBAL HEADER TRANSLATION CONTROL MODE
+  if (mode === 'global') {
+    return (
+      <div ref={rootRef} className="relative inline-flex items-center" data-no-translate="true">
+        <div className="inline-flex items-center bg-gray-100 border border-gray-300 rounded-md text-xs overflow-hidden">
+          <button
+            type="button"
+            onClick={() => {
+              if (status === 'translated') {
+                handleRestoreOriginal();
+              } else {
+                handleTranslate(targetLanguage, sourceLanguage);
+              }
+            }}
+            className={`inline-flex items-center gap-1.5 px-2.5 py-1.5 font-semibold transition-colors cursor-pointer ${
+              status === 'translated'
+                ? 'bg-amber-400 text-gray-900 hover:bg-amber-300'
+                : 'text-gray-700 hover:bg-gray-200'
+            }`}
+            title="Translate articles and teasers on this page using on-device AI"
+          >
+            <svg
+              className="w-4 h-4 text-amber-600 shrink-0"
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+            <span>
+              {status === 'translating' || status === 'downloading'
+                ? `Translating (${progress.completed}/${progress.total})...`
+                : status === 'translated' && activeLangObj
+                ? `Translated: ${activeLangObj.name}`
+                : 'Translate Page'}
+            </span>
+          </button>
+
+          <select
+            aria-label="Select target language for page translation"
+            value={targetLanguage}
+            onChange={(e) => {
+              const newLang = e.target.value;
+              setTargetLanguage(newLang);
+              handleTranslate(newLang, sourceLanguage);
+            }}
+            className="bg-white border-l border-gray-300 px-2 py-1.5 text-xs font-medium text-gray-800 focus:outline-none cursor-pointer"
+          >
+            {SUPPORTED_LANGUAGES.map((lang) => (
+              <option key={lang.code} value={lang.code}>
+                {lang.flag} {lang.name}
+              </option>
+            ))}
+          </select>
+
+          {status === 'translated' && (
+            <button
+              type="button"
+              onClick={handleRestoreOriginal}
+              className="px-2 py-1.5 border-l border-gray-300 bg-white text-gray-600 hover:text-gray-900 font-medium cursor-pointer"
+              title="Restore original language"
+            >
+              Original
+            </button>
+          )}
+        </div>
+      </div>
+    );
+  }
+
+  // 3. ARTICLE PAGE FULL TRANSLATION CONTROL BAR
+  return (
+    <div
+      ref={rootRef}
+      data-no-translate="true"
+      data-testid="article-translator-control"
+      className="my-5 rounded-lg border border-gray-200 bg-gray-50/90 p-4 shadow-xs transition-all"
+    >
+      <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
+        {/* Left: Badge & Status */}
+        <div className="flex items-center gap-2.5">
+          <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-800">
+            <svg
+              className="w-5 h-5"
+              xmlns="http://www.w3.org/2000/svg"
+              fill="none"
+              viewBox="0 0 24 24"
+              strokeWidth={1.8}
+              stroke="currentColor"
+            >
+              <path
+                strokeLinecap="round"
+                strokeLinejoin="round"
+                d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
+              />
+            </svg>
+          </div>
+          <div>
+            <div className="flex flex-wrap items-center gap-2">
+              <span className="text-sm font-bold text-gray-900">On-Device Article Translation</span>
+              <span
+                className={`inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium ${
+                  availability === 'available'
+                    ? 'bg-emerald-100 text-emerald-800'
+                    : availability === 'downloadable' || availability === 'downloading'
+                    ? 'bg-amber-100 text-amber-800'
+                    : 'bg-gray-200 text-gray-700'
+                }`}
+              >
+                <span
+                  className={`h-1.5 w-1.5 rounded-full ${
+                    availability === 'available'
+                      ? 'bg-emerald-500'
+                      : availability === 'downloadable' || availability === 'downloading'
+                      ? 'bg-amber-500'
+                      : 'bg-gray-500'
+                  }`}
+                />
+                {hasNativeApi
+                  ? availability === 'available'
+                    ? 'Browser AI Ready'
+                    : availability === 'downloadable'
+                    ? 'Model Downloadable'
+                    : 'Browser AI'
+                  : 'On-Device Ready'}
+              </span>
+            </div>
+            <p className="text-xs text-gray-500">
+              Translate this article and related teasers directly in your browser without sending text to external servers.
+              {detectedLang && (
+                <span className="ml-1 text-gray-400">
+                  (Detected: {detectedLang.code.toUpperCase()})
+                </span>
+              )}
+            </p>
+          </div>
+        </div>
+
+        {/* Right: Language Selectors and Action Buttons */}
+        <div className="flex flex-wrap items-center gap-2">
+          {/* Source Language */}
+          <div className="flex items-center gap-1">
+            <label htmlFor="article-source-lang" className="sr-only">
+              From language
+            </label>
+            <select
+              id="article-source-lang"
+              aria-label="Source language"
+              value={sourceLanguage}
+              onChange={(e) => setSourceLanguage(e.target.value)}
+              className="rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-700 focus:border-amber-400 focus:outline-none"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`src-${lang.code}`} value={lang.code}>
+                  {lang.flag} {lang.name}
+                </option>
+              ))}
+            </select>
+          </div>
+
+          {/* Swap Button */}
+          <button
+            type="button"
+            onClick={handleSwapLanguages}
+            title="Swap languages"
+            aria-label="Swap source and target languages"
+            className="rounded-md border border-gray-300 bg-white p-1.5 text-gray-600 hover:bg-gray-100 hover:text-gray-900 transition-colors cursor-pointer"
+          >
+            <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
+              <path strokeLinecap="round" strokeLinejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
+            </svg>
+          </button>
+
+          {/* Target Language */}
+          <div className="flex items-center gap-1">
+            <label htmlFor="article-target-lang" className="sr-only">
+              To language
+            </label>
+            <select
+              id="article-target-lang"
+              aria-label="Target language"
+              value={targetLanguage}
+              onChange={(e) => {
+                const nextTarget = e.target.value;
+                setTargetLanguage(nextTarget);
+                if (status === 'translated') {
+                  handleTranslate(nextTarget, sourceLanguage);
+                }
+              }}
+              className="rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-900 focus:border-amber-400 focus:outline-none"
+            >
+              {SUPPORTED_LANGUAGES.map((lang) => (
+                <option key={`tgt-${lang.code}`} value={lang.code}>
+                  {lang.flag} {lang.name} ({lang.nativeName})
+                </option>
+              ))}
+            </select>
+          </div>
+
+          {/* Translate Action Button */}
+          <button
+            type="button"
+            onClick={() => handleTranslate()}
+            disabled={status === 'translating' || status === 'downloading'}
+            className="inline-flex items-center gap-1.5 rounded-md bg-gray-900 px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-amber-500 hover:text-gray-900 disabled:opacity-50 transition-colors cursor-pointer"
+          >
+            {status === 'downloading' ? (
+              <>
+                <span className="h-3.5 w-3.5 animate-spin rounded-full border-2 border-white border-t-transparent" />
+                <span>Downloading Model ({progress.downloadPercent}%)</span>
+              </>
+            ) : status === 'translating' ? (
+              <>
+                <span className="h-3.5 w-3.5 animate-spin rounded-full border-2 border-white border-t-transparent" />
+                <span>
+                  Translating ({progress.completed}/{progress.total})
+                </span>
+              </>
+            ) : (
+              <span>Translate</span>
+            )}
+          </button>
+
+          {/* Restore Original Button */}
+          {status === 'translated' && (
+            <button
+              type="button"
+              onClick={handleRestoreOriginal}
+              className="inline-flex items-center gap-1 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-100 transition-colors cursor-pointer"
+            >
+              Show Original
+            </button>
+          )}
+        </div>
+      </div>
+
+      {/* Progress Bar when downloading or translating */}
+      {(status === 'downloading' || status === 'translating') && (
+        <div className="mt-3">
+          <div className="h-1.5 w-full overflow-hidden rounded-full bg-gray-200">
+            <div
+              className="h-full bg-amber-500 transition-all duration-200"
+              style={{
+                width: `${
+                  status === 'downloading'
+                    ? progress.downloadPercent
+                    : progress.total > 0
+                    ? Math.round((progress.completed / progress.total) * 100)
+                    : 50
+                }%`,
+              }}
+            />
+          </div>
+        </div>
+      )}
+
+      {/* Active Translation Banner */}
+      {status === 'translated' && activeLangObj && (
+        <div className="mt-2.5 flex items-center justify-between border-t border-gray-200/80 pt-2 text-xs text-amber-900">
+          <span>
+            Viewing on-device translation in <strong>{activeLangObj.name} ({activeLangObj.nativeName})</strong>.
+          </span>
+          <button
+            type="button"
+            onClick={handleRestoreOriginal}
+            className="font-semibold text-amber-800 hover:underline cursor-pointer"
+          >
+            Revert to original
+          </button>
+        </div>
+      )}
+
+      {/* Error Banner */}
+      {status === 'error' && errorMessage && (
+        <div className="mt-2.5 rounded bg-red-50 px-3 py-2 text-xs text-red-700 border border-red-200">
+          {errorMessage}
+        </div>
+      )}
+    </div>
+  );
+}
