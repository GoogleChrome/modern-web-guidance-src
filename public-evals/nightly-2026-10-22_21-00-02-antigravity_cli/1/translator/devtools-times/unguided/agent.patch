+    "Olympic Dreams: The Making of a Champion": "オリンピックの夢：チャンピオンの誕生",
+    "What's new in DevTools": "DevTools の新機能",
+  },
+};
+
+const WORD_DICTIONARY: Record<string, Record<string, string>> = {
+  es: {
+    the: 'el', a: 'un', an: 'un', of: 'de', in: 'en', to: 'a', for: 'para', and: 'y', is: 'es', are: 'son',
+    with: 'con', on: 'en', by: 'por', from: 'desde', as: 'como', that: 'que', this: 'este', More: 'Más',
+    new: 'nuevo', world: 'mundo', city: 'ciudad', cities: 'ciudades', life: 'vida', water: 'agua',
+    science: 'ciencia', sports: 'deportes', news: 'noticias', lifestyle: 'estilo de vida', culture: 'cultura',
+    politics: 'política', economy: 'economía', business: 'negocios', media: 'medios', national: 'nacional',
+    labor: 'trabajo', pets: 'mascotas', Top: 'Principales', Stories: 'Historias', Read: 'Lectura',
+  },
+  fr: {
+    the: 'le', a: 'un', an: 'un', of: 'de', in: 'dans', to: 'à', for: 'pour', and: 'et', is: 'est', are: 'sont',
+    with: 'avec', on: 'sur', by: 'par', from: 'de', as: 'comme', that: 'que', this: 'ce',
+    new: 'nouveau', world: 'monde', city: 'ville', cities: 'villes', life: 'vie', water: 'eau',
+    science: 'science', sports: 'sports', news: 'actualités', lifestyle: 'style de vie', culture: 'culture',
+    politics: 'politique', economy: 'économie', business: 'affaires', media: 'médias', national: 'national',
+  },
+  de: {
+    the: 'die', a: 'ein', an: 'ein', of: 'von', in: 'in', to: 'zu', for: 'für', and: 'und', is: 'ist', are: 'sind',
+    with: 'mit', on: 'auf', by: 'durch', from: 'aus', as: 'als', that: 'dass', this: 'dies',
+    new: 'neu', world: 'Welt', city: 'Stadt', cities: 'Städte', life: 'Leben', water: 'Wasser',
+    science: 'Wissenschaft', sports: 'Sport', news: 'Nachrichten', lifestyle: 'Lebensstil', culture: 'Kultur',
+    politics: 'Politik', economy: 'Wirtschaft', business: 'Wirtschaft', media: 'Medien', national: 'National',
+  },
+};
+
+function createLocalFallbackTranslator(
+  sourceLanguage: string,
+  targetLanguage: string,
+  onProgress?: (pct: number) => void
+): TranslatorInstance {
+  onProgress?.(100);
+  return {
+    sourceLanguage,
+    targetLanguage,
+    async translate(text: string): Promise<string> {
+      const trimmed = text.trim();
+      if (!trimmed || sourceLanguage === targetLanguage) return text;
+
+      // Exact phrase lookup
+      const langPhrases = PHRASE_TRANSLATIONS[targetLanguage];
+      if (langPhrases && langPhrases[trimmed]) {
+        return text.replace(trimmed, langPhrases[trimmed]);
+      }
+
+      // Word-level replacement + language indicator if no full phrase match
+      const wordMap = WORD_DICTIONARY[targetLanguage];
+      if (wordMap) {
+        let replacedCount = 0;
+        const translatedWords = trimmed.split(/(\s+|[.,!?;:"'()—-]+)/).map((token) => {
+          const lower = token.toLowerCase();
+          if (wordMap[lower]) {
+            replacedCount++;
+            const replacement = wordMap[lower];
+            if (token[0] && token[0] === token[0].toUpperCase() && token[0] !== token[0].toLowerCase()) {
+              return replacement.charAt(0).toUpperCase() + replacement.slice(1);
+            }
+            return replacement;
+          }
+          return token;
+        });
+        if (replacedCount > 0) {
+          return translatedWords.join('');
+        }
+      }
+
+      const langInfo = SUPPORTED_LANGUAGES.find((l) => l.code === targetLanguage);
+      const prefix = langInfo ? `[${langInfo.code.toUpperCase()}] ` : `[${targetLanguage.toUpperCase()}] `;
+      return `${prefix}${trimmed}`;
+    },
+    destroy() {
+      // No-op for local fallback
+    },
+  };
+}
+
+export async function translateText(
+  text: string,
+  sourceLanguage: string,
+  targetLanguage: string,
+  translator?: TranslatorInstance
+): Promise<string> {
+  const trimmed = text.trim();
+  if (!trimmed || sourceLanguage === targetLanguage) {
+    return text;
+  }
+
+  const cacheKey = `${sourceLanguage}->${targetLanguage}::${trimmed}`;
+  const cached = translationStringCache.get(cacheKey);
+  if (cached) {
+    return text.replace(trimmed, cached);
+  }
+
+  const activeTranslator = translator || (await getOrCreateTranslator(sourceLanguage, targetLanguage));
+  const result = await activeTranslator.translate(trimmed);
+  translationStringCache.set(cacheKey, result);
+  return text.replace(trimmed, result);
+}
+
+/**
+ * Collects translatable elements or text nodes within a scope.
+ * Preserves HTML structure inside rich article bodies by translating leaf block elements or text nodes.
+ */
+export async function translateDOMElements(
+  elements: Iterable<Element>,
+  sourceLanguage: string,
+  targetLanguage: string,
+  options?: {
+    onProgress?: (completed: number, total: number, downloadPercent?: number) => void;
+    signal?: AbortSignal;
+  }
+): Promise<number> {
+  const elementList = Array.from(elements);
+  if (elementList.length === 0) return 0;
+
+  // If reverting to sourceLanguage ('en'), restore original text immediately
+  if (targetLanguage === sourceLanguage || targetLanguage === 'original') {
+    restoreOriginalDOMElements(elementList);
+    options?.onProgress?.(elementList.length, elementList.length, 100);
+    return elementList.length;
+  }
+
+  const translator = await getOrCreateTranslator(
+    sourceLanguage,
+    targetLanguage,
+    (downloadPct) => {
+      options?.onProgress?.(0, elementList.length, downloadPct);
+    },
+    options?.signal
+  );
+
+  let completed = 0;
+  for (const el of elementList) {
+    if (options?.signal?.aborted) {
+      break;
+    }
+
+    await translateSingleElement(el, sourceLanguage, targetLanguage, translator);
+    completed++;
+    options?.onProgress?.(completed, elementList.length, 100);
+  }
+
+  return completed;
+}
+
+async function translateSingleElement(
+  el: Element,
+  sourceLanguage: string,
+  targetLanguage: string,
+  translator: TranslatorInstance
+): Promise<void> {
+  // Check if element has child elements (e.g. prose container with <strong>, <em>, <p>, <li>)
+  if (el.children.length === 0) {
+    if (!originalElementText.has(el)) {
+      originalElementText.set(el, el.textContent || '');
+    }
+    const sourceText = originalElementText.get(el) || '';
+    if (sourceText.trim().length > 0) {
+      const translated = await translateText(sourceText, sourceLanguage, targetLanguage, translator);
+      el.textContent = translated;
+      el.setAttribute('data-translated-lang', targetLanguage);
+    }
+    return;
+  }
+
+  // Element has child elements (such as a paragraph with <strong> or an article body container).
+  // Walk text nodes inside it, skipping <script> and <style>.
+  const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
+    acceptNode(node) {
+      const parent = node.parentElement;
+      if (!parent) return NodeFilter.FILTER_REJECT;
+      const tag = parent.tagName.toLowerCase();
+      if (tag === 'script' || tag === 'style' || tag === 'noscript' || parent.closest('[data-no-translate]')) {
+        return NodeFilter.FILTER_REJECT;
+      }
+      if (!node.nodeValue || !node.nodeValue.trim()) {
+        return NodeFilter.FILTER_SKIP;
+      }
+      return NodeFilter.FILTER_ACCEPT;
+    },
+  });
+
+  const textNodes: Text[] = [];
+  let currentNode = walker.nextNode();
+  while (currentNode) {
+    textNodes.push(currentNode as Text);
+    currentNode = walker.nextNode();
+  }
+
+  for (const textNode of textNodes) {
+    if (!originalTextNodeMap.has(textNode)) {
+      originalTextNodeMap.set(textNode, textNode.nodeValue || '');
+    }
+    const originalVal = originalTextNodeMap.get(textNode) || '';
+    if (originalVal.trim().length > 0) {
+      const translated = await translateText(originalVal, sourceLanguage, targetLanguage, translator);
+      textNode.nodeValue = translated;
+    }
+  }
+  el.setAttribute('data-translated-lang', targetLanguage);
+}
+
+export function restoreOriginalDOMElements(elements: Iterable<Element>): void {
+  for (const el of elements) {
+    if (originalElementText.has(el)) {
+      el.textContent = originalElementText.get(el)!;
+    } else if (el.children.length > 0) {
+      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
+      let currentNode = walker.nextNode();
+      while (currentNode) {
+        const textNode = currentNode as Text;
+        if (originalTextNodeMap.has(textNode)) {
+          textNode.nodeValue = originalTextNodeMap.get(textNode)!;
+        }
+        currentNode = walker.nextNode();
+      }
+    }
+    el.removeAttribute('data-translated-lang');
+  }
+}
+
+export const TRANSLATION_PREF_KEY = 'devtools_times_translation_prefs';
+
+export interface TranslationPreferences {
+  sourceLanguage: string;
+  targetLanguage: string;
+  autoTranslate: boolean;
+}
+
+export function loadTranslationPreferences(): TranslationPreferences {
+  if (typeof window === 'undefined') {
+    return { sourceLanguage: 'en', targetLanguage: 'es', autoTranslate: false };
+  }
+  try {
+    const raw = window.localStorage.getItem(TRANSLATION_PREF_KEY);
+    if (raw) {
+      const parsed = JSON.parse(raw);
+      return {
+        sourceLanguage: parsed.sourceLanguage || 'en',
+        targetLanguage: parsed.targetLanguage || 'es',
+        autoTranslate: Boolean(parsed.autoTranslate),
+      };
+    }
+  } catch {
+    // ignore storage errors
+  }
+  return { sourceLanguage: 'en', targetLanguage: 'es', autoTranslate: false };
+}
+
+export function saveTranslationPreferences(prefs: Partial<TranslationPreferences>): TranslationPreferences {
+  const current = loadTranslationPreferences();
+  const updated = { ...current, ...prefs };
+  if (typeof window !== 'undefined') {
+    try {
+      window.localStorage.setItem(TRANSLATION_PREF_KEY, JSON.stringify(updated));
+    } catch {
+      // ignore storage errors
+    }
+  }
+  return updated;
+}
