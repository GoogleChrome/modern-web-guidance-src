--- a/index.html
+++ b/index.html
@@ -207,6 +207,361 @@
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script>
+    (function () {
+      const menuCatalog = [
+        {
+          id: 'maple-oat-latte',
+          name: 'Maple Oat Latte',
+          category: 'seasonal',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup.',
+          price: 5.50,
+          sizes: ['Small', 'Medium', 'Large'],
+          url: '/menu/seasonal'
+        },
+        {
+          id: 'dark-roast-espresso',
+          name: 'Dark Roast Espresso',
+          category: 'espresso',
+          description: 'Bold, smokey, and perfect for a morning boost.',
+          price: 3.75,
+          sizes: ['Single', 'Double'],
+          url: '/menu/espresso'
+        },
+        {
+          id: 'cold-brew',
+          name: 'Cold Brew',
+          category: 'cold-brew',
+          description: 'Steeped for 18 hours for maximum smoothness.',
+          price: 4.50,
+          sizes: ['Small', 'Medium', 'Large'],
+          url: '/menu/cold-brew'
+        }
+      ];
+
+      const storeLocations = [
+        {
+          id: 'downtown',
+          name: 'Downtown Roastery & Cafe',
+          address: '124 Main Street',
+          hours: '6:00 AM - 7:00 PM'
+        },
+        {
+          id: 'riverside',
+          name: 'Riverside Espresso Bar',
+          address: '450 River Road',
+          hours: '6:30 AM - 6:00 PM'
+        }
+      ];
+
+      const pageRoutes = {
+        home: '/',
+        menu: '/menu',
+        seasonal: '/menu/seasonal',
+        espresso: '/menu/espresso',
+        'cold-brew': '/menu/cold-brew',
+        locations: '/locations',
+        rewards: '/rewards',
+        account: '/account',
+        'order-online': '/order-online',
+        about: '/about',
+        careers: '/careers',
+        contact: '/contact',
+        'privacy-policy': '/privacy-policy',
+        logout: '/logout'
+      };
+
+      const orders = [];
+
+      const tools = [
+        {
+          name: 'get_menu_items',
+          description: 'Get the list of artisanal coffee drinks and seasonal favorites available at The Daily Grind, optionally filtered by category or search query.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              category: {
+                type: 'string',
+                enum: ['all', 'seasonal', 'espresso', 'cold-brew'],
+                description: 'Filter menu items by category.'
+              },
+              query: {
+                type: 'string',
+                description: 'Optional search keyword to filter drinks by name or description.'
+              }
+            }
+          },
+          annotations: {
+            readOnlyHint: true
+          },
+          execute: async (input = {}) => {
+            const category = input.category && input.category !== 'all' ? input.category.toLowerCase() : null;
+            const query = input.query ? input.query.toLowerCase().trim() : null;
+
+            const filtered = menuCatalog.filter((item) => {
+              const matchesCategory = !category || item.category === category;
+              const matchesQuery =
+                !query ||
+                item.name.toLowerCase().includes(query) ||
+                item.description.toLowerCase().includes(query);
+              return matchesCategory && matchesQuery;
+            });
+
+            return {
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify({ items: filtered })
+                }
+              ]
+            };
+          }
+        },
+        {
+          name: 'get_drink_details',
+          description: 'View detailed information, pricing, and available sizes for a specific coffee drink on the menu.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drink: {
+                type: 'string',
+                description: 'The name or ID of the drink (e.g., "Maple Oat Latte", "Dark Roast Espresso", "Cold Brew").'
+              }
+            },
+            required: ['drink']
+          },
+          annotations: {
+            readOnlyHint: true
+          },
+          execute: async (input = {}) => {
+            const target = (input.drink || '').toLowerCase().trim();
+            const found = menuCatalog.find(
+              (item) =>
+                item.id === target ||
+                item.name.toLowerCase() === target ||
+                item.name.toLowerCase().includes(target)
+            );
+
+            if (!found) {
+              return {
+                isError: true,
+                content: [
+                  {
+                    type: 'text',
+                    text: JSON.stringify({
+                      error: `Drink "${input.drink}" not found.`,
+                      availableDrinks: menuCatalog.map((i) => i.name)
+                    })
+                  }
+                ]
+              };
+            }
+
+            return {
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify(found)
+                }
+              ]
+            };
+          }
+        },
+        {
+          name: 'place_order',
+          description: 'Place an online coffee order at The Daily Grind for pickup or delivery.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              drink: {
+                type: 'string',
+                description: 'The name of the coffee drink to order (e.g., "Maple Oat Latte", "Dark Roast Espresso", "Cold Brew").'
+              },
+              size: {
+                type: 'string',
+                enum: ['Small', 'Medium', 'Large', 'Single', 'Double'],
+                description: 'The size of the drink.'
+              },
+              quantity: {
+                type: 'number',
+                minimum: 1,
+                description: 'Number of drinks to order (defaults to 1).'
+              },
+              milk: {
+                type: 'string',
+                enum: ['Whole', 'Skim', 'Oat', 'Almond', 'None'],
+                description: 'Optional milk preference.'
+              },
+              customerName: {
+                type: 'string',
+                description: 'Optional name for the order.'
+              }
+            },
+            required: ['drink']
+          },
+          annotations: {
+            readOnlyHint: false
+          },
+          execute: async (input = {}) => {
+            const target = (input.drink || '').toLowerCase().trim();
+            const item =
+              menuCatalog.find(
+                (i) =>
+                  i.id === target ||
+                  i.name.toLowerCase() === target ||
+                  i.name.toLowerCase().includes(target)
+              ) || {
+                id: 'custom-drink',
+                name: input.drink,
+                price: 4.50
+              };
+
+            const quantity = Number(input.quantity) > 0 ? Number(input.quantity) : 1;
+            const size = input.size || (item.sizes ? item.sizes[0] : 'Medium');
+            const total = Number((item.price * quantity).toFixed(2));
+
+            const order = {
+              orderId: `DG-${Date.now()}`,
+              drink: item.name,
+              size,
+              quantity,
+              milk: input.milk || 'Standard',
+              customerName: input.customerName || 'Guest',
+              totalPrice: total,
+              status: 'confirmed'
+            };
+
+            orders.push(order);
+
+            return {
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify({
+                    message: `Order ${order.orderId} confirmed for ${quantity}x ${size} ${item.name}.`,
+                    order
+                  })
+                }
+              ]
+            };
+          }
+        },
+        {
+          name: 'get_locations',
+          description: 'Get the list of The Daily Grind cafe locations and opening hours.',
+          inputSchema: {
+            type: 'object',
+            properties: {}
+          },
+          annotations: {
+            readOnlyHint: true
+          },
+          execute: async () => {
+            return {
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify({ locations: storeLocations })
+                }
+              ]
+            };
+          }
+        },
+        {
+          name: 'navigate_to_page',
+          description: 'Navigate to a specific section or page of The Daily Grind website (e.g., menu, locations, rewards, account, order-online, about, careers, contact, privacy-policy).',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              page: {
+                type: 'string',
+                enum: Object.keys(pageRoutes),
+                description: 'The target page identifier or section name.'
+              }
+            },
+            required: ['page']
+          },
+          annotations: {
+            readOnlyHint: false
+          },
+          execute: async (input = {}) => {
+            const path = pageRoutes[input.page] || input.page;
+            if (!path) {
+              return {
+                isError: true,
+                content: [
+                  {
+                    type: 'text',
+                    text: JSON.stringify({ error: `Unknown page: ${input.page}` })
+                  }
+                ]
+              };
+            }
+            window.location.href = path;
+            return {
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify({ status: 'navigating', url: path })
+                }
+              ]
+            };
+          }
+        },
+        {
+          name: 'logout_user',
+          description: 'Log out the current user from their Daily Grind account.',
+          inputSchema: {
+            type: 'object',
+            properties: {}
+          },
+          annotations: {
+            readOnlyHint: false
+          },
+          execute: async () => {
+            window.location.href = '/logout';
+            return {
+              content: [
+                {
+                  type: 'text',
+                  text: JSON.stringify({ status: 'logged_out', redirectUrl: '/logout' })
+                }
+              ]
+            };
+          }
+        }
+      ];
+
+      function registerWebMCPTools() {
+        const modelContext = navigator.modelContext || document.modelContext;
+        if (!modelContext) return;
+
+        if (typeof modelContext.provideContext === 'function') {
+          try {
+            modelContext.provideContext({ tools });
+          } catch (e) {
+            // Fallback to individual registration if provideContext signature differs
+          }
+        }
+
+        if (typeof modelContext.registerTool === 'function') {
+          for (const tool of tools) {
+            try {
+              modelContext.registerTool(tool);
+            } catch (e) {
+              // Ignore duplicate registration errors if provideContext already registered the tool
+            }
+          }
+        }
+      }
+
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', registerWebMCPTools);
+      } else {
+        registerWebMCPTools();
+      }
+    })();
+  </script>
 </body>
 
 </html>
