@@ -0,0 +1,469 @@
+import React, { useState, useEffect } from 'react';
+import { BookmarkIcon } from '@heroicons/react/24/outline';
+
+interface ArticleUtilitiesProps {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  initialIsBookmarked: boolean;
+}
+
+type FontSizePreset = 'small' | 'normal' | 'large' | 'xlarge';
+
+const FONT_SIZE_CLASSES: Record<FontSizePreset, string> = {
+  small: 'prose-sm',
+  normal: 'prose-base',
+  large: 'prose-lg',
+  xlarge: 'prose-xl',
+};
+
+export default function ArticleUtilities({
+  slug,
+  title,
+  summary,
+  author,
+  date,
+  category,
+  readingTime,
+  initialIsBookmarked,
+}: ArticleUtilitiesProps) {
+  const [isBookmarked, setIsBookmarked] = useState(initialIsBookmarked);
+  const [fontSize, setFontSize] = useState<FontSizePreset>('normal');
+  const [statusMessage, setStatusMessage] = useState<string | null>(null);
+  const [articleStats, setArticleStats] = useState<{
+    wordCount: number;
+    estimatedReadingTimeMinutes: number;
+    headings: string[];
+  } | null>(null);
+
+  const applyFontSizeToDOM = (size: FontSizePreset) => {
+    const validSize: FontSizePreset = ['small', 'normal', 'large', 'xlarge'].includes(size)
+      ? size
+      : 'normal';
+    setFontSize(validSize);
+    const bodyEl = document.getElementById('article-body-content') || document.querySelector('article .prose');
+    if (bodyEl) {
+      Object.values(FONT_SIZE_CLASSES).forEach(cls => bodyEl.classList.remove(cls));
+      bodyEl.classList.add(FONT_SIZE_CLASSES[validSize]);
+      bodyEl.setAttribute('data-font-size', validSize);
+    }
+    return validSize;
+  };
+
+  const computeArticleDetails = () => {
+    const bodyEl = document.getElementById('article-body-content') || document.querySelector('article .prose');
+    const bodyText = bodyEl?.textContent?.trim() || '';
+    const words = bodyText ? bodyText.split(/\s+/).filter(Boolean) : [];
+    const wordCount = words.length;
+    const estimatedReadingTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));
+    const headingEls = bodyEl ? Array.from(bodyEl.querySelectorAll('h1, h2, h3, h4')) : [];
+    const headings = headingEls.map(h => h.textContent?.trim() || '').filter(Boolean);
+
+    const details = {
+      slug,
+      title,
+      summary,
+      author,
+      date,
+      category,
+      readingTime: readingTime ?? estimatedReadingTimeMinutes,
+      wordCount,
+      estimatedReadingTimeMinutes,
+      headings,
+      isBookmarked,
+      fontSize,
+      url: typeof window !== 'undefined' ? window.location.href : `${import.meta.env.BASE_URL}articles/${slug}`,
+      content: bodyText,
+    };
+
+    setArticleStats({
+      wordCount,
+      estimatedReadingTimeMinutes,
+      headings,
+    });
+
+    return details;
+  };
+
+  const toggleBookmarkAction = async (action: 'add' | 'remove' | 'toggle' = 'toggle') => {
+    const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/json',
+      },
+      body: JSON.stringify({ slug, action }),
+    });
+    const data = await response.json();
+    const readingList: string[] = data.readingList || [];
+    const bookmarked = readingList.includes(slug);
+    setIsBookmarked(bookmarked);
+    window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: { readingList } }));
+    setStatusMessage(bookmarked ? 'Saved to reading list' : 'Removed from reading list');
+    return {
+      slug,
+      title,
+      isBookmarked: bookmarked,
+      readingList,
+    };
+  };
+
+  const shareOrCopyArticle = async (platform: string = 'copy') => {
+    const shareUrl = typeof window !== 'undefined' ? window.location.href : `${import.meta.env.BASE_URL}articles/${slug}`;
+    let copied = false;
+
+    if (typeof navigator !== 'undefined' && navigator.clipboard?.writeText) {
+      try {
+        await navigator.clipboard.writeText(shareUrl);
+        copied = true;
+      } catch {
+        copied = false;
+      }
+    }
+
+    const message =
+      platform === 'copy'
+        ? `Link copied to clipboard: ${shareUrl}`
+        : `Prepared share link for ${platform}: ${shareUrl}`;
+    setStatusMessage(message);
+
+    return {
+      slug,
+      title,
+      platform,
+      url: shareUrl,
+      copiedToClipboard: copied,
+      message,
+    };
+  };
+
+  const highlightArticleText = (phrase: string) => {
+    const bodyEl = document.getElementById('article-body-content') || document.querySelector('article .prose');
+    const cleanPhrase = String(phrase || '').trim();
+    if (!bodyEl || !cleanPhrase) {
+      return { phrase: cleanPhrase, matches: 0 };
+    }
+    const text = bodyEl.textContent || '';
+    const regex = new RegExp(cleanPhrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi');
+    const matches = (text.match(regex) || []).length;
+    setStatusMessage(`Found ${matches} occurrence(s) of "${cleanPhrase}"`);
+    return {
+      slug,
+      phrase: cleanPhrase,
+      matches,
+    };
+  };
+
+  useEffect(() => {
+    computeArticleDetails();
+
+    const handleReadingListUpdated = (e: Event) => {
+      const customEvent = e as CustomEvent<{ readingList?: string[] }>;
+      if (customEvent.detail?.readingList) {
+        setIsBookmarked(customEvent.detail.readingList.includes(slug));
+      }
+    };
+    window.addEventListener('reading-list-updated', handleReadingListUpdated);
+    return () => {
+      window.removeEventListener('reading-list-updated', handleReadingListUpdated);
+    };
+  }, [slug]);
+
+  useEffect(() => {
+    if (typeof navigator === 'undefined' || !navigator.modelContext) return;
+
+    const controller = new AbortController();
+    const registeredTools = [
+      'get_article_utilities',
+      'get_article_info',
+      'toggle_article_bookmark',
+      'set_article_font_size',
+      'share_article',
+      'find_in_article',
+    ];
+
+    try {
+      navigator.modelContext.registerTool(
+        {
+          name: 'get_article_info',
+          description:
+            'Get metadata, summary, word count, estimated reading time, section headings, and full text of the current article.',
+          inputSchema: {
+            type: 'object',
+            properties: {},
+          },
+          annotations: {
+            readOnlyHint: true,
+          },
+          execute: async () => {
+            const info = computeArticleDetails();
+            return {
+              ...info,
+              content: [{ type: 'text', text: JSON.stringify(info) }],
+            };
+          },
+        },
+        { signal: controller.signal }
+      );
+
+      navigator.modelContext.registerTool(
+        {
+          name: 'get_article_utilities',
+          description:
+            'Inspect and get the current state and statistics of the client-side article utilities (metadata, word count, reading time, font size, and bookmark status).',
+          inputSchema: {
+            type: 'object',
+            properties: {},
+          },
+          annotations: {
+            readOnlyHint: true,
+          },
+          execute: async () => {
+            const info = computeArticleDetails();
+            return {
+              ...info,
+              content: [{ type: 'text', text: JSON.stringify(info) }],
+            };
+          },
+        },
+        { signal: controller.signal }
+      );
+
+      navigator.modelContext.registerTool(
+        {
+          name: 'toggle_article_bookmark',
+          description:
+            "Bookmark or unbookmark the current article in the user's reading list.",
+          inputSchema: {
+            type: 'object',
+            properties: {
+              action: {
+                type: 'string',
+                enum: ['add', 'remove', 'toggle'],
+                description: "Optional action: 'add', 'remove', or 'toggle' (defaults to 'toggle').",
+              },
+            },
+          },
+          annotations: {
+            readOnlyHint: false,
+          },
+          execute: async (input: Record<string, any>) => {
+            const action = (input?.action as 'add' | 'remove' | 'toggle') || 'toggle';
+            const result = await toggleBookmarkAction(action);
+            return {
+              ...result,
+              content: [{ type: 'text', text: JSON.stringify(result) }],
+            };
+          },
+        },
+        { signal: controller.signal }
+      );
+
+      navigator.modelContext.registerTool(
+        {
+          name: 'set_article_font_size',
+          description:
+            "Adjust the client-side reading font size of the current article ('small', 'normal', 'large', or 'xlarge').",
+          inputSchema: {
+            type: 'object',
+            properties: {
+              size: {
+                type: 'string',
+                enum: ['small', 'normal', 'large', 'xlarge'],
+                description: "The desired text size preset: 'small', 'normal', 'large', or 'xlarge'.",
+              },
+            },
+            required: ['size'],
+          },
+          annotations: {
+            readOnlyHint: false,
+          },
+          execute: async (input: Record<string, any>) => {
+            const appliedSize = applyFontSizeToDOM((input?.size as FontSizePreset) || 'normal');
+            const payload = {
+              slug,
+              fontSize: appliedSize,
+              message: `Article font size set to ${appliedSize}.`,
+            };
+            setStatusMessage(payload.message);
+            return {
+              ...payload,
+              content: [{ type: 'text', text: JSON.stringify(payload) }],
+            };
+          },
+        },
+        { signal: controller.signal }
+      );
+
+      navigator.modelContext.registerTool(
+        {
+          name: 'share_article',
+          description:
+            'Copy the current article URL or generate a share link for social platforms (copy, facebook, x, whatsapp, email).',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              platform: {
+                type: 'string',
+                enum: ['copy', 'facebook', 'x', 'whatsapp', 'email'],
+                description: "Target sharing channel: 'copy', 'facebook', 'x', 'whatsapp', or 'email'.",
+              },
+            },
+          },
+          annotations: {
+            readOnlyHint: true,
+          },
+          execute: async (input: Record<string, any>) => {
+            const result = await shareOrCopyArticle(String(input?.platform || 'copy'));
+            return {
+              ...result,
+              content: [{ type: 'text', text: JSON.stringify(result) }],
+            };
+          },
+        },
+        { signal: controller.signal }
+      );
+
+      navigator.modelContext.registerTool(
+        {
+          name: 'find_in_article',
+          description: 'Search for a specific keyword or phrase within the current article text and return the match count.',
+          inputSchema: {
+            type: 'object',
+            properties: {
+              phrase: {
+                type: 'string',
+                description: 'The keyword or phrase to search for inside the current article body.',
+              },
+            },
+            required: ['phrase'],
+          },
+          annotations: {
+            readOnlyHint: true,
+          },
+          execute: async (input: Record<string, any>) => {
+            const result = highlightArticleText(String(input?.phrase || ''));
+            return {
+              ...result,
+              content: [{ type: 'text', text: JSON.stringify(result) }],
+            };
+          },
+        },
+        { signal: controller.signal }
+      );
+    } catch (err) {
+      console.warn('WebMCP registerTool error in ArticleUtilities:', err);
+    }
+
+    return () => {
+      controller.abort();
+      for (const name of registeredTools) {
+        try {
+          navigator.modelContext?.unregisterTool?.(name);
+        } catch {
+          // Ignore if already unregistered
+        }
+      }
+    };
+  }, [slug, isBookmarked, fontSize]);
+
+  return (
+    <div className="border-b border-gray-200 pb-6 mb-6">
+      <div className="flex flex-wrap justify-between items-center gap-4">
+        {/* Social Share & Bookmark Utilities */}
+        <div className="flex space-x-3 items-center">
+          <span className="text-sm font-semibold text-gray-800">Share:</span>
+          <button
+            type="button"
+            onClick={() => shareOrCopyArticle('facebook')}
+            aria-label="Share on Facebook"
+            className="w-8 h-8 rounded-full bg-blue-800 text-white flex items-center justify-center font-bold text-lg cursor-pointer"
+          >
+            f
+          </button>
+          <button
+            type="button"
+            onClick={() => shareOrCopyArticle('x')}
+            aria-label="Share on X"
+            className="w-8 h-8 rounded-full bg-black text-white flex items-center justify-center font-bold text-lg cursor-pointer"
+          >
+            X
+          </button>
+          <button
+            type="button"
+            onClick={() => shareOrCopyArticle('copy')}
+            aria-label="Copy article link"
+            className="w-8 h-8 rounded-full bg-green-500 text-white flex items-center justify-center cursor-pointer"
+          >
+            <svg className="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
+              <path d="M10.001 2.002a7.994 7.994 0 00-6.43 12.868l-1.564 1.563a.5.5 0 00.707.707l1.564-1.564a7.994 7.994 0 105.722-13.574zm0 14.986a6.994 6.994 0 110-13.988 6.994 6.994 0 010 13.988zM6.58 8.016a.5.5 0 00-.707 0L4.5 9.387A3.5 3.5 0 007.485 14.5l.34-.34a.5.5 0 000-.707l-.34-.34a2.5 2.5 0 01-.702-2.31l1.693-1.693a.5.5 0 000-.707L6.58 8.016zM13.42 11.98a.5.5 0 00.707 0l1.372-1.373a3.5 3.5 0 00-2.985-5.113l-.34.34a.5.5 0 000 .707l.34.34a2.5 2.5 0 01.703 2.31l-1.694 1.693a.5.5 0 000 .707l1.89 1.89z" />
+            </svg>
+          </button>
+          <button
+            type="button"
+            onClick={() => shareOrCopyArticle('email')}
+            aria-label="Share via Email"
+            className="w-8 h-8 rounded-full bg-gray-600 text-white flex items-center justify-center cursor-pointer"
+          >
+            <svg className="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
+              <path d="M2.003 5.884L10 10.884l7.997-5V4H2.003v1.884zM18 6.116l-8 4.05-8-4.05V16h16V6.116zM2 4h16v-1c0-.552-.448-1-1-1H3c-.552 0-1 .448-1 1v1z" />
+            </svg>
+          </button>
+          <button
+            type="button"
+            onClick={() => toggleBookmarkAction('toggle')}
+            aria-label={isBookmarked ? 'Remove from reading list' : 'Add to reading list'}
+            data-bookmark-slug={slug}
+            className="p-1 cursor-pointer"
+          >
+            <BookmarkIcon
+              className={`h-5 w-5 ${isBookmarked ? 'text-amber-400 fill-current' : 'text-gray-400'}`}
+            />
+          </button>
+        </div>
+
+        {/* Client-side Reader Utilities: Font Size & Reading Stats */}
+        <div className="flex items-center space-x-3 text-xs text-gray-600">
+          {articleStats && (
+            <span className="hidden sm:inline-block text-gray-500" data-testid="article-reading-stats">
+              {articleStats.wordCount} words · ~{readingTime ?? articleStats.estimatedReadingTimeMinutes} min read
+            </span>
+          )}
+          <div className="flex items-center space-x-1 border border-gray-200 rounded-md p-1 bg-gray-50">
+            <span className="px-1 font-medium text-gray-500">Text:</span>
+            {(['small', 'normal', 'large', 'xlarge'] as FontSizePreset[]).map(size => (
+              <button
+                key={size}
+                type="button"
+                onClick={() => applyFontSizeToDOM(size)}
+                className={`px-2 py-0.5 rounded capitalize cursor-pointer transition ${
+                  fontSize === size
+                    ? 'bg-gray-800 text-white font-semibold'
+                    : 'text-gray-600 hover:bg-gray-200'
+                }`}
+              >
+                {size === 'small' ? 'A-' : size === 'normal' ? 'A' : size === 'large' ? 'A+' : 'A++'}
+              </button>
+            ))}
+          </div>
+        </div>
+      </div>
+
+      {statusMessage && (
+        <div className="mt-3 text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded px-3 py-1.5 flex justify-between items-center" role="status">
+          <span>{statusMessage}</span>
+          <button
+            type="button"
+            onClick={() => setStatusMessage(null)}
+            className="text-amber-700 hover:text-amber-900 font-bold ml-2"
+          >
+            ×
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
