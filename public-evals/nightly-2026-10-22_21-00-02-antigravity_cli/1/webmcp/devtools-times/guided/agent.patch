diff --git a/src/components/ArticleUtilities.tsx b/src/components/ArticleUtilities.tsx
new file mode 100644
index 0000000..575a916
--- /dev/null
+++ b/src/components/ArticleUtilities.tsx
@@ -0,0 +1,276 @@
+import React, { useState, useEffect } from 'react';
+import { useWebMCP } from 'use-webmcp-tool';
+
+interface RelatedArticle {
+  slug: string;
+  title: string;
+  summary: string;
+  category: string;
+}
+
+interface Props {
+  slug: string;
+  title: string;
+  summary: string;
+  author: string;
+  date: string;
+  category: string;
+  readingTime?: number;
+  initialIsBookmarked: boolean;
+  relatedArticles: RelatedArticle[];
+}
+
+const EMPTY_SCHEMA = {
+  type: 'object',
+  properties: {},
+} as const;
+
+const HIGHLIGHT_SCHEMA = {
+  type: 'object',
+  properties: {
+    term: {
+      type: 'string',
+      description: 'Word or phrase to highlight inside the article body, or an empty string to clear highlights.',
+    },
+  },
+  required: ['term'],
+} as const;
+
+const READ_ONLY_ANNOTATIONS = {
+  readOnlyHint: true,
+} as const;
+
+const MUTATION_ANNOTATIONS = {
+  readOnlyHint: false,
+} as const;
+
+export default function ArticleUtilities({
+  slug,
+  title,
+  summary,
+  author,
+  date,
+  category,
+  readingTime,
+  initialIsBookmarked,
+  relatedArticles,
+}: Props) {
+  const [isBookmarked, setIsBookmarked] = useState(initialIsBookmarked);
+  const [popularity, setPopularity] = useState<{ views: number; trending: boolean } | null>(null);
+  const [highlightedTerm, setHighlightedTerm] = useState<string>('');
+
+  useEffect(() => {
+    const handleUpdated = (event: Event) => {
+      const customEvent = event as CustomEvent<{ readingList?: string[] }>;
+      if (customEvent.detail?.readingList) {
+        setIsBookmarked(customEvent.detail.readingList.includes(slug));
+      }
+    };
+    window.addEventListener('reading-list-updated', handleUpdated);
+    return () => {
+      window.removeEventListener('reading-list-updated', handleUpdated);
+    };
+  }, [slug]);
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'get_current_article_details',
+    description: 'Read metadata, full body text, word count, bookmark status, and related articles for the article currently open on the page.',
+    inputSchema: EMPTY_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    execute: () => {
+      const bodyEl = document.getElementById('article-body-content');
+      const bodyText = bodyEl?.textContent?.trim() ?? '';
+      const words = bodyText ? bodyText.split(/\s+/).length : 0;
+      const headings = bodyEl
+        ? Array.from(bodyEl.querySelectorAll('h2, h3, h4')).map((h) => h.textContent?.trim() ?? '')
+        : [];
+
+      return {
+        slug,
+        title,
+        summary,
+        author,
+        date,
+        category,
+        readingTimeMinutes: readingTime ?? Math.max(1, Math.ceil(words / 200)),
+        wordCount: words,
+        bookmarked: isBookmarked,
+        headings,
+        bodyText,
+        relatedArticles: relatedArticles.map((r) => ({
+          ...r,
+          url: `${import.meta.env.BASE_URL}articles/${r.slug}`,
+        })),
+      };
+    },
+  });
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'get_current_article_popularity',
+    description: 'Fetch live view count and trending status for the currently open article.',
+    inputSchema: EMPTY_SCHEMA,
+    annotations: READ_ONLY_ANNOTATIONS,
+    execute: async (_input, { signal }) => {
+      try {
+        const response = await fetch(
+          `${import.meta.env.BASE_URL}api/article-popularity?id=${encodeURIComponent(slug)}`,
+          { signal }
+        );
+        if (!response.ok) {
+          return { error: `Failed to fetch article popularity (status ${response.status})` };
+        }
+        const data = await response.json();
+        setPopularity({ views: data.views, trending: Boolean(data.trending) });
+        return {
+          slug,
+          title,
+          views: data.views,
+          trending: Boolean(data.trending),
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  useWebMCP<Record<string, never>, unknown>({
+    name: 'bookmark_current_article',
+    description: 'Toggle whether the currently open article is saved in the user reading list.',
+    inputSchema: EMPTY_SCHEMA,
+    annotations: MUTATION_ANNOTATIONS,
+    execute: async (_input, { signal }) => {
+      try {
+        const response = await fetch(`${import.meta.env.BASE_URL}api/reading-list.json`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ slug }),
+          signal,
+        });
+        if (!response.ok) {
+          return { error: `Failed to update reading list (status ${response.status})` };
+        }
+        const data = await response.json();
+        const readingList: string[] = data.readingList || [];
+        const bookmarked = readingList.includes(slug);
+        setIsBookmarked(bookmarked);
+        window.dispatchEvent(new CustomEvent('reading-list-updated', { detail: { readingList } }));
+        return {
+          slug,
+          title,
+          bookmarked,
+          readingList,
+        };
+      } catch (err) {
+        if (signal.aborted) {
+          throw err;
+        }
+        return { error: err instanceof Error ? err.message : String(err) };
+      }
+    },
+  });
+
+  useWebMCP<{ term: string }, unknown>({
+    name: 'highlight_article_text',
+    description: 'Highlight occurrences of a search term or phrase inside the current article body, or clear existing highlights.',
+    inputSchema: HIGHLIGHT_SCHEMA,
+    annotations: MUTATION_ANNOTATIONS,
+    execute: (input) => {
+      if (typeof input?.term !== 'string') {
+        return { error: 'Pass a string term to highlight (or empty string to clear).' };
+      }
+      const term = input.term.trim();
+      const bodyEl = document.getElementById('article-body-content');
+      if (!bodyEl) {
+        return { error: 'Article body element not found on the page.' };
+      }
+
+      // Clear previous highlights first
+      const existingMarks = bodyEl.querySelectorAll('mark[data-webmcp-highlight]');
+      existingMarks.forEach((mark) => {
+        const parent = mark.parentNode;
+        if (parent) {
+          parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
+          parent.normalize();
+        }
+      });
+
+      if (!term) {
+        setHighlightedTerm('');
+        return { term: '', matchesHighlighted: 0 };
+      }
+
+      let matchesHighlighted = 0;
+      const escaped = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+      const regex = new RegExp(`(${escaped})`, 'gi');
+
+      const walker = document.createTreeWalker(bodyEl, NodeFilter.SHOW_TEXT);
+      const textNodes: Text[] = [];
+      let currentNode = walker.nextNode();
+      while (currentNode) {
+        if (
+          currentNode.parentElement &&
+          !['SCRIPT', 'STYLE', 'MARK'].includes(currentNode.parentElement.tagName)
+        ) {
+          textNodes.push(currentNode as Text);
+        }
+        currentNode = walker.nextNode();
+      }
+
+      for (const textNode of textNodes) {
+        const text = textNode.nodeValue || '';
+        if (!regex.test(text)) continue;
+        regex.lastIndex = 0;
+
+        const fragment = document.createDocumentFragment();
+        let lastIndex = 0;
+        let match: RegExpExecArray | null;
+        while ((match = regex.exec(text)) !== null) {
+          if (match.index > lastIndex) {
+            fragment.appendChild(document.createTextNode(text.slice(lastIndex, match.index)));
+          }
+          const mark = document.createElement('mark');
+          mark.setAttribute('data-webmcp-highlight', 'true');
+          mark.className = 'bg-amber-200 text-gray-900 px-0.5 rounded';
+          mark.textContent = match[0];
+          fragment.appendChild(mark);
+          matchesHighlighted++;
+          lastIndex = regex.lastIndex;
+        }
+        if (lastIndex < text.length) {
+          fragment.appendChild(document.createTextNode(text.slice(lastIndex)));
+        }
+        textNode.parentNode?.replaceChild(fragment, textNode);
+      }
+
+      setHighlightedTerm(term);
+      return {
+        slug,
+        term,
+        matchesHighlighted,
+      };
+    },
+  });
+
+  if (!popularity && !highlightedTerm) {
+    return null;
+  }
+
+  return (
+    <div className="flex flex-wrap items-center gap-3 text-xs text-gray-600 mb-4">
+      {popularity && (
+        <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-50 text-amber-900 border border-amber-200">
+          <span>{popularity.views.toLocaleString()} views</span>
+          {popularity.trending && <span className="font-semibold text-amber-700">• Trending</span>}
+        </span>
+      )}
+      {highlightedTerm && (
+        <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-gray-100 text-gray-700">
+          <span>Highlighted: "{highlightedTerm}"</span>
+        </span>
+      )}
+    </div>
+  );
+}
