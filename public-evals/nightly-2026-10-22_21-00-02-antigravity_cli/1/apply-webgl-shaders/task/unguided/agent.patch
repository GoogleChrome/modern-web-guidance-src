+
+      function updateHtmlTexture(state) {
+        const { el, canvas, gl, texture, texCanvas, texCtx } = state;
+        const heroRect = hero.getBoundingClientRect();
+        const elRect = el.getBoundingClientRect();
+        const dpr = Math.min(window.devicePixelRatio || 1, 2);
+
+        const elemW = Math.max(1, Math.round(elRect.width));
+        const elemH = Math.max(1, Math.round(elRect.height));
+        const totalW = elemW + BLEED * 2;
+        const totalH = elemH + BLEED * 2;
+
+        const left = elRect.left - heroRect.left - BLEED;
+        const top = elRect.top - heroRect.top - BLEED;
+
+        canvas.style.left = left + 'px';
+        canvas.style.top = top + 'px';
+        canvas.style.width = totalW + 'px';
+        canvas.style.height = totalH + 'px';
+
+        const pixelW = Math.max(1, Math.round(totalW * dpr));
+        const pixelH = Math.max(1, Math.round(totalH * dpr));
+
+        if (canvas.width !== pixelW || canvas.height !== pixelH) {
+          canvas.width = pixelW;
+          canvas.height = pixelH;
+        }
+        if (texCanvas.width !== pixelW || texCanvas.height !== pixelH) {
+          texCanvas.width = pixelW;
+          texCanvas.height = pixelH;
+        }
+
+        state.width = pixelW;
+        state.height = pixelH;
+
+        const styleInfo = capturedStyles.get(el);
+        const cs = window.getComputedStyle(el);
+        const fontSize = cs.fontSize || styleInfo.fontSize;
+        const fontWeight = cs.fontWeight || styleInfo.fontWeight;
+        const fontFamily = cs.fontFamily || styleInfo.fontFamily;
+
+        texCtx.save();
+        texCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
+        texCtx.clearRect(0, 0, totalW, totalH);
