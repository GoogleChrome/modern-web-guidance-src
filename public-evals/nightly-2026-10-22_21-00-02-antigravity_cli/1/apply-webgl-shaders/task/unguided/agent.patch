+          gl.activeTexture(gl.TEXTURE0);
+          gl.bindTexture(gl.TEXTURE_2D, texture);
+          gl.uniform1i(locations.uTexture, 0);
+          gl.uniform1f(locations.uTime, timeSec);
+          gl.uniform2f(locations.uMouse, state.mouse.x, state.mouse.y);
+          gl.uniform1f(locations.uHover, state.hover);
+          gl.uniform2f(locations.uResolution, state.width, state.height);
+
+          const flatRipples = new Float32Array(32);
+          for (let i = 0; i < 8; i++) {
+            flatRipples[i * 4 + 0] = state.ripples[i][0];
+            flatRipples[i * 4 + 1] = state.ripples[i][1];
+            flatRipples[i * 4 + 2] = state.ripples[i][2];
+            flatRipples[i * 4 + 3] = state.ripples[i][3];
+          }
+          gl.uniform4fv(locations.uRipples, flatRipples);
+
+          gl.drawArrays(gl.TRIANGLES, 0, meshData.vertexCount);
+        });
+      }
+
+      if (typeof MutationObserver !== 'undefined') {
+        const mo = new MutationObserver(syncAllTextures);
+        targets.forEach((t) => mo.observe(t, { childList: true, characterData: true, subtree: true }));
+      }
+
+      function animate(nowMs) {
+        render(nowMs);
+        requestAnimationFrame(animate);
+      }
+
+      render(performance.now());
+      requestAnimationFrame(animate);
+    })();
+  </script>
+
