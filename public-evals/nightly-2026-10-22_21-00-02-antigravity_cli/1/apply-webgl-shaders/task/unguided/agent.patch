+        vec4 r = u_ripples[i];
+        float age = u_time - r.z;
+        if (r.w > 0.0 && age >= 0.0 && age < 3.5) {
+          vec2 rPos = vec2(r.x * aspect, r.y);
+          vec2 delta = aspectUv - rPos;
+          float d = length(delta);
+          vec2 dir = d > 0.0001 ? delta / d : vec2(0.0);
+          float ring = sin(d * 26.0 - age * 8.5) * exp(-d * 4.0) * exp(-age * 1.4) * r.w;
+          waveOffset += dir * ring * vec2(0.015 / max(aspect, 1.0), 0.022);
+          totalRipple += ring;
+        }
