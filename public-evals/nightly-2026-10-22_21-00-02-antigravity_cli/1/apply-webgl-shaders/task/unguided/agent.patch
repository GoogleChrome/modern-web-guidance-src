+  <script>
+    (function () {
+      const hero = document.querySelector('.hero');
+      if (!hero) return;
+
+      const heading = hero.querySelector('h1');
+      const orderBtn = hero.querySelector('.btn');
+      const targets = [heading, orderBtn].filter(Boolean);
+      if (!targets.length) return;
+
+      const vertexShaderSrc = document.getElementById('vertex-shader').textContent;
+      const fragmentShaderSrc = document.getElementById('fragment-shader').textContent;
+
+      function compileShader(gl, type, source) {
+        const shader = gl.createShader(type);
+        gl.shaderSource(shader, source);
+        gl.compileShader(shader);
+        if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
+          gl.deleteShader(shader);
+          return null;
+        }
+        return shader;
+      }
+
+      function createProgram(gl, vsSource, fsSource) {
+        const vs = compileShader(gl, gl.VERTEX_SHADER, vsSource);
+        const fs = compileShader(gl, gl.FRAGMENT_SHADER, fsSource);
+        if (!vs || !fs) return null;
+        const program = gl.createProgram();
+        gl.attachShader(program, vs);
+        gl.attachShader(program, fs);
+        gl.linkProgram(program);
+        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
+          gl.deleteProgram(program);
+          return null;
+        }
+        return program;
+      }
+
+      function buildSubdividedMesh(cols, rows) {
+        const positions = [];
+        const texCoords = [];
+        for (let y = 0; y < rows; y++) {
+          const v0 = y / rows;
+          const v1 = (y + 1) / rows;
+          const py0 = 1.0 - v0 * 2.0;
+          const py1 = 1.0 - v1 * 2.0;
+          for (let x = 0; x < cols; x++) {
+            const u0 = x / cols;
+            const u1 = (x + 1) / cols;
+            const px0 = u0 * 2.0 - 1.0;
+            const px1 = u1 * 2.0 - 1.0;
+
+            positions.push(
+              px0, py0,
+              px1, py0,
+              px0, py1,
+              px0, py1,
+              px1, py0,
+              px1, py1
+            );
+            texCoords.push(
+              u0, v0,
+              u1, v0,
+              u0, v1,
+              u0, v1,
+              u1, v0,
+              u1, v1
+            );
+          }
+        }
+        return {
+          positions: new Float32Array(positions),
+          texCoords: new Float32Array(texCoords),
+          vertexCount: cols * rows * 6
+        };
+      }
+
+      function drawRoundedRect(ctx, x, y, w, h, r) {
+        const radius = Math.min(r, w / 2, h / 2);
+        ctx.beginPath();
+        ctx.moveTo(x + radius, y);
+        ctx.arcTo(x + w, y, x + w, y + h, radius);
+        ctx.arcTo(x + w, y + h, x, y + h, radius);
+        ctx.arcTo(x, y + h, x, y, radius);
+        ctx.arcTo(x, y, x + w, y, radius);
+        ctx.closePath();
+      }
+
+      const meshData = buildSubdividedMesh(32, 16);
+      const BLEED = 24;
+      const instances = [];
+
+      // Capture original styles before hiding raw DOM text/background
