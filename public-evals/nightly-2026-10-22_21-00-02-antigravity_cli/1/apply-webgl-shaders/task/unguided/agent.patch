+      let lastMoveDrop = 0;
+      hero.addEventListener('mousemove', (e) => {
+        const now = performance.now();
+        instances.forEach((state) => {
+          const rect = state.canvas.getBoundingClientRect();
+          const nx = (e.clientX - rect.left) / Math.max(rect.width, 1);
+          const ny = (e.clientY - rect.top) / Math.max(rect.height, 1);
+          state.targetMouse.x = Math.min(1.2, Math.max(-0.2, nx));
+          state.targetMouse.y = Math.min(1.2, Math.max(-0.2, ny));
