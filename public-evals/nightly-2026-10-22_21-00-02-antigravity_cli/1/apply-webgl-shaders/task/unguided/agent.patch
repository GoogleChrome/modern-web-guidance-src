+
+    void main() {
+      float aspect = u_resolution.x / max(u_resolution.y, 1.0);
+      vec2 uv = v_texCoord;
+      vec2 aspectUv = vec2(uv.x * aspect, uv.y);
+
+      // Continuous GPU fluid wave distortion
+      vec2 waveOffset = vec2(
+        sin(uv.y * 10.0 + u_time * 2.6) * 0.0045 + cos(uv.x * 7.0 - u_time * 1.9) * 0.003,
+        cos(uv.x * 9.0 + u_time * 2.3) * 0.0085 + sin(uv.y * 8.0 - u_time * 2.1) * 0.004
+      );
+
+      // Interactive cursor proximity ripple
+      vec2 aspectMouse = vec2(u_mouse.x * aspect, u_mouse.y);
+      vec2 toMouse = aspectUv - aspectMouse;
+      float mouseDist = length(toMouse);
+      vec2 mouseDir = mouseDist > 0.0001 ? toMouse / mouseDist : vec2(0.0);
+      float hoverStrength = 0.35 + 0.65 * u_hover;
+      float cursorWave = sin(mouseDist * 22.0 - u_time * 6.5) * exp(-mouseDist * 3.2) * hoverStrength;
+      waveOffset += mouseDir * cursorWave * vec2(0.012 / max(aspect, 1.0), 0.018);
+
+      // Propagating drop ripples triggered by pointer movement and clicks
+      float totalRipple = cursorWave;
