+          drawRoundedRect(texCtx, BLEED, BLEED, elemW, elemH, styleInfo.borderRadius);
+          texCtx.fill();
+        }
+
+        texCtx.font = `${fontWeight} ${fontSize} ${fontFamily}`;
+        texCtx.fillStyle = styleInfo.color;
+        texCtx.textAlign = 'center';
+        texCtx.textBaseline = 'middle';
+        const text = (el.textContent || '').trim();
