+      float dist = distance(aspectUv, aspectMouse);
+      float mouseRipple = sin(dist * 18.0 - u_time * 5.0) * exp(-dist * 3.5) * (0.35 + 0.65 * u_hover);
+      float ambientWave = sin(a_texCoord.x * 8.0 + u_time * 2.2) * cos(a_texCoord.y * 6.0 + u_time * 1.8) * 0.25;
