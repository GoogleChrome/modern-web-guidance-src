+          gl.bindBuffer(gl.ARRAY_BUFFER, texBuffer);
+          gl.enableVertexAttribArray(locations.aTexCoord);
+          gl.vertexAttribPointer(locations.aTexCoord, 2, gl.FLOAT, false, 0, 0);
