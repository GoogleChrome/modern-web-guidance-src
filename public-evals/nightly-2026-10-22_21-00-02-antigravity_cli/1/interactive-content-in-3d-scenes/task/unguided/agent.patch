+          uSampler: gl.getUniformLocation(glProgram, 'uSampler')
+        };
+
+        glTextures = [
+          createFaceCanvasTexture(gl, {
+            bgStart: '#3e2723', bgEnd: '#271a16',
+            title: 'THE DAILY GRIND', subtitle: 'CUSTOM ROAST FRONT',
+            lines: ['Interactive Order Label', '100% Arabica Whole Bean', 'Net Wt. 12 oz (340g)']
+          }),
+          createFaceCanvasTexture(gl, {
+            bgStart: '#4e342e', bgEnd: '#2b1b17',
+            title: 'THE DAILY GRIND', subtitle: 'ROASTERY RESERVE',
+            lines: ['Small Batch Artisanal', 'Harvested at 1,850 Meters', 'Tasting: Cocoa & Toasted Almond', 'Roasted Fresh Daily']
+          }),
+          createFaceCanvasTexture(gl, {
+            bgStart: '#5d4037', bgEnd: '#3e2723',
+            title: 'FRESH SEALED', subtitle: 'TOP BOX FLAP',
+            lines: ['Open Here for Aroma', 'Batch #2026-DG']
+          }),
+          createFaceCanvasTexture(gl, {
+            bgStart: '#3e2723', bgEnd: '#1b0f0d',
+            title: 'DAILY GRIND CO.', subtitle: 'RECYCLABLE CARTON',
+            lines: ['Cert. Fair Trade Organic', 'SKU: DG-3D-BOX']
+          }),
+          createFaceCanvasTexture(gl, {
+            bgStart: '#4e342e', bgEnd: '#271a16',
+            title: 'BREWING GUIDE', subtitle: 'POUR OVER & ESPRESSO',
+            lines: ['Water Temp: 200°F (93°C)', 'Ratio: 1:16 Coffee to Water', 'Bloom Time: 35 Seconds']
+          }),
+          createFaceCanvasTexture(gl, {
+            bgStart: '#4e342e', bgEnd: '#271a16',
+            title: 'ORIGIN STORY', subtitle: 'ETHICALLY SOURCED',
+            lines: ['Direct Trade Partner Farms', 'Washed & Sun-Dried', 'Zero Carbon Roasting']
+          })
+        ];
+
+        gl.enable(gl.DEPTH_TEST);
+        gl.enable(gl.CULL_FACE);
+        gl.cullFace(gl.BACK);
+      }
+
+      function updateFrontTextureWithOrder(recipient, roast, grind, qty) {
+        if (!gl || !glTextures.length) return;
+        glTextures[0] = createFaceCanvasTexture(gl, {
+          bgStart: '#3e2723',
+          bgEnd: '#271a16',
+          title: recipient.toUpperCase().slice(0, 18),
+          subtitle: roast.toUpperCase(),
+          lines: [
+            'Grind: ' + grind,
+            'Quantity: ' + qty + ' x 12oz Box',
+            'Custom 3D Packed Order'
+          ]
+        });
+      }
+
+      function resizeScene() {
+        const rect = viewport.getBoundingClientRect();
+        const width = Math.max(1, Math.floor(rect.width));
+        const height = Math.max(1, Math.floor(rect.height));
+        const dpr = Math.min(window.devicePixelRatio || 1, 2);
+
+        if (canvas.width !== width * dpr || canvas.height !== height * dpr) {
+          canvas.width = width * dpr;
+          canvas.height = height * dpr;
+        }
+
+        // Synchronize CSS perspective focal length with WebGL vertical FOV
+        const cssPerspectivePx = (height / 2) / Math.tan(FOV_Y_RAD / 2);
+        viewport.style.perspective = cssPerspectivePx.toFixed(2) + 'px';
+      }
+
+      function renderScene(nowMs) {
+        if (!renderScene.lastTime) renderScene.lastTime = nowMs;
+        const dt = Math.min((nowMs - renderScene.lastTime) / 1000, 0.1);
+        renderScene.lastTime = nowMs;
+
+        if (isSpinning && !isDragging) {
+          rotY += spinSpeed * spinDirection * dt;
+        }
+
+        resizeScene();
+
+        const rect = viewport.getBoundingClientRect();
+        const aspect = rect.width / Math.max(1, rect.height);
+        const cssPerspectivePx = (rect.height / 2) / Math.tan(FOV_Y_RAD / 2);
+
+        // Compute shared rotation matrix for both WebGL and CSS3D
+        const rotXMat = mat4RotationX(rotX);
+        const rotYMat = mat4RotationY(rotY);
+        const modelRotation = mat4Multiply(rotYMat, rotXMat);
+
+        // WebGL Render Pass
+        if (gl && glProgram && glBuffers) {
+          gl.viewport(0, 0, canvas.width, canvas.height);
+          gl.clearColor(0, 0, 0, 0);
+          gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+
+          gl.useProgram(glProgram);
+
+          const projMatrix = mat4Perspective(FOV_Y_RAD, aspect, 10, 3000);
+          const viewTranslation = mat4Translation(0, 0, -CAMERA_Z);
+          const modelViewMatrix = mat4Multiply(viewTranslation, modelRotation);
+
+          gl.uniformMatrix4fv(glLocations.uProjectionMatrix, false, new Float32Array(projMatrix));
+          gl.uniformMatrix4fv(glLocations.uModelViewMatrix, false, new Float32Array(modelViewMatrix));
+          gl.uniformMatrix4fv(glLocations.uNormalMatrix, false, new Float32Array(modelRotation));
+
+          gl.bindBuffer(gl.ARRAY_BUFFER, glBuffers.posBuffer);
+          gl.enableVertexAttribArray(glLocations.aPosition);
+          gl.vertexAttribPointer(glLocations.aPosition, 3, gl.FLOAT, false, 0, 0);
+
+          gl.bindBuffer(gl.ARRAY_BUFFER, glBuffers.normBuffer);
+          gl.enableVertexAttribArray(glLocations.aNormal);
+          gl.vertexAttribPointer(glLocations.aNormal, 3, gl.FLOAT, false, 0, 0);
+
+          gl.bindBuffer(gl.ARRAY_BUFFER, glBuffers.uvBuffer);
+          gl.enableVertexAttribArray(glLocations.aUv);
+          gl.vertexAttribPointer(glLocations.aUv, 2, gl.FLOAT, false, 0, 0);
+
+          gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, glBuffers.idxBuffer);
+
+          for (let faceIdx = 0; faceIdx < 6; faceIdx++) {
+            gl.activeTexture(gl.TEXTURE0);
+            gl.bindTexture(gl.TEXTURE_2D, glTextures[faceIdx]);
+            gl.uniform1i(glLocations.uSampler, 0);
+            gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, faceIdx * 6 * 2);
+          }
+        }
+
+        // Synchronize CSS 3D Projected HTML Form
+        // Note: CSS Y-axis points down whereas WebGL Y-axis points up.
+        // Flipping the X-axis angle & Y-axis rotation sign aligns CSS3D with WebGL handedness.
+        const cssRotX = mat4RotationX(-rotX);
+        const cssRotY = mat4RotationY(rotY);
+        const cssRotation = mat4Multiply(cssRotY, cssRotX);
+        const faceOffset = mat4Translation(0, 0, HALF_D + 1.5);
+        const cameraOffset = mat4Translation(0, 0, cssPerspectivePx - CAMERA_Z);
+        const cssMatrix = mat4Multiply(cameraOffset, mat4Multiply(cssRotation, faceOffset));
+
+        formAnchor.style.transform = `matrix3d(${cssMatrix.map(n => Number(n.toFixed(6))).join(',')})`;
+
+        const yawDeg = Math.round(((rotY * 180) / Math.PI) % 360);
+        const pitchDeg = Math.round((rotX * 180) / Math.PI);
+        angleReadout.textContent = `Yaw: ${yawDeg}° | Pitch: ${pitchDeg}°`;
+
+        requestAnimationFrame(renderScene);
+      }
+
+      // Orbit drag on the WebGL canvas background without blocking HTML form clicks
+      canvas.addEventListener('pointerdown', (e) => {
+        isDragging = true;
+        lastPointerX = e.clientX;
+        lastPointerY = e.clientY;
+        canvas.setPointerCapture(e.pointerId);
+      });
+
+      canvas.addEventListener('pointermove', (e) => {
+        if (!isDragging) return;
+        const dx = e.clientX - lastPointerX;
+        const dy = e.clientY - lastPointerY;
+        lastPointerX = e.clientX;
+        lastPointerY = e.clientY;
+        rotY += dx * 0.008;
+        rotX = Math.max(-0.85, Math.min(0.85, rotX - dy * 0.006));
+      });
+
+      canvas.addEventListener('pointerup', (e) => {
+        isDragging = false;
+        if (canvas.hasPointerCapture(e.pointerId)) {
+          canvas.releasePointerCapture(e.pointerId);
+        }
+      });
+
+      // Control buttons
+      toggleSpinBtn.addEventListener('click', () => {
+        isSpinning = !isSpinning;
+        toggleSpinBtn.textContent = isSpinning ? 'Pause Spin' : 'Resume Spin';
+        toggleSpinBtn.classList.toggle('active', isSpinning);
+      });
+
+      frontViewBtn.addEventListener('click', () => {
+        rotY = 0;
+        rotX = 0;
+        statusMsg.textContent = 'Aligned coffee box to front face';
+      });
+
+      reverseSpinBtn.addEventListener('click', () => {
+        spinDirection *= -1;
+        reverseSpinBtn.classList.toggle('active', spinDirection < 0);
+      });
+
+      // Interactive form handlers inside the 3D scene
+      randomizeBtn.addEventListener('click', () => {
+        const sampleNames = ['Jordan Lee', 'Maya Lin', 'Samira Patel', 'Liam O\'Connor', 'Elena Rostova'];
+        const roasts = ['Espresso Dark', 'Velvet Medium', 'Honey Light', 'Decaf Swiss'];
+        const grinds = ['Whole Bean', 'Espresso Fine', 'Pour Over', 'French Press'];
+
+        recipientInput.value = sampleNames[Math.floor(Math.random() * sampleNames.length)];
+        roastSelect.value = roasts[Math.floor(Math.random() * roasts.length)];
+        grindSelect.value = grinds[Math.floor(Math.random() * grinds.length)];
+        quantityInput.value = String(Math.floor(Math.random() * 4) + 1);
+
+        updateFrontTextureWithOrder(
+          recipientInput.value,
+          roastSelect.value,
+          grindSelect.value,
+          quantityInput.value
+        );
+        statusMsg.textContent = `Surprise blend selected for ${recipientInput.value}!`;
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+        const recipient = recipientInput.value.trim() || 'Coffee Lover';
+        const roast = roastSelect.value;
+        const grind = grindSelect.value;
+        const qty = quantityInput.value;
+
+        updateFrontTextureWithOrder(recipient, roast, grind, qty);
+        statusMsg.textContent = `Added ${qty}x ${roast} (${grind}) for ${recipient}!`;
+      });
+
+      initWebGL();
+      requestAnimationFrame(renderScene);
+    })();
+  </script>
 </body>
 
