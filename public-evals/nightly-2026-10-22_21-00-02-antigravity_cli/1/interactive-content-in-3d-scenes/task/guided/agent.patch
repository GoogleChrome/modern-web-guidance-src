+      gl.vertexAttribPointer(1, 2, gl.FLOAT, false, 20, 12);
+
+      const labelIbo = gl.createBuffer();
+      gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, labelIbo);
+      gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, labelIndices, gl.STATIC_DRAW);
+
+      gl.bindVertexArray(null);
+    }
+
+    function createPerspectiveMatrix(fovRad, aspect, near, far) {
+      const f = 1.0 / Math.tan(fovRad / 2);
+      const nf = 1 / (near - far);
+      return new DOMMatrix([
+        f / aspect, 0, 0, 0,
+        0, f, 0, 0,
+        0, 0, (far + near) * nf, -1,
+        0, 0, 2 * far * near * nf, 0
+      ]);
+    }
+
+    let isSpinning = true;
+    let rotationAngle = 0;
+    let lastFrameTime = performance.now();
+
+    function renderCoffeeBoxScene() {
+      const now = performance.now();
+      const dt = (now - lastFrameTime) * 0.001;
+      lastFrameTime = now;
+
+      if (isSpinning) {
+        rotationAngle += dt * 0.9;
+      }
+
+      const aspect = (canvas.width || 760) / (canvas.height || 560);
+      const projection = createPerspectiveMatrix(Math.PI / 4, aspect, 0.1, 100.0);
+
+      // Gentle 3D rotation so the coffee box spins while keeping the front label accessible
+      const yawDeg = Math.sin(rotationAngle) * 28;
+      const pitchDeg = Math.cos(rotationAngle * 0.7) * 8;
+
+      const boxMatrix = new DOMMatrix()
+        .translate(0, 0, -2.5)
+        .rotate(pitchDeg, yawDeg, 0);
+
+      const boxMVPMatrix = projection.multiply(boxMatrix);
+
+      // Position the unit-square HTML quad slightly in front of the front face (z = 0.302)
+      const labelModelMatrix = boxMatrix
+        .translate(0, 0, 0.302)
+        .scale(1.06, 1.36, 1);
+
+      const htmlElementMVP = projection.multiply(labelModelMatrix).toFloat32Array();
+
+      if (gl) {
+        gl.viewport(0, 0, canvas.width, canvas.height);
+        gl.clearColor(0.16, 0.10, 0.08, 1.0);
+        gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
+        gl.enable(gl.DEPTH_TEST);
+
+        // Draw 3D coffee box
+        gl.useProgram(boxProgram);
+        gl.uniformMatrix4fv(
+          gl.getUniformLocation(boxProgram, "uMVP"),
+          false,
+          boxMVPMatrix.toFloat32Array()
+        );
+        gl.bindVertexArray(boxVao);
+        gl.drawElements(gl.TRIANGLES, 36, gl.UNSIGNED_SHORT, 0);
+
+        // Draw projected HTML form quad on the front face
+        if (textureState.width > 0 && textureState.height > 0) {
+          gl.enable(gl.BLEND);
+          gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
+          gl.useProgram(labelProgram);
+          gl.activeTexture(gl.TEXTURE0);
+          gl.bindTexture(gl.TEXTURE_2D, texture);
+          gl.uniform1i(gl.getUniformLocation(labelProgram, "uTexture"), 0);
+          gl.uniformMatrix4fv(
+            gl.getUniformLocation(labelProgram, "uMVP"),
+            false,
+            htmlElementMVP
+          );
+          gl.bindVertexArray(labelVao);
+          gl.drawElements(gl.TRIANGLES, 6, gl.UNSIGNED_SHORT, 0);
+          gl.disable(gl.BLEND);
+        }
+      }
+
+      return htmlElementMVP;
+    }
+
+    // 5. Render HTML content to a texture and sync geometry inside canvas.onpaint
+    canvas.onpaint = (event) => {
+      if (gl && (!event?.changedElements || event.changedElements.length > 0 || textureState.width === 0)) {
+        try {
+          uploadElementWebGL(gl, canvas, texture, uiElement, textureState);
+        } catch (err) {
+          console.error("texElementSubImage2D copy failed:", err);
+        }
+      }
+
+      const htmlElementMVP = renderCoffeeBoxScene();
+
+      // Sync DOM position, hit testing, and accessibility bounds with 3D scene
+      if (typeof canvas.updateElementGeometry === "function") {
+        canvas.updateElementGeometry(uiElement, {
+          canvasTransform: computeCanvasTransform(canvas, uiElement, htmlElementMVP),
+        });
+      }
+    };
+
+    function render() {
+      if ("content" in HTMLCanvasElement.prototype && typeof canvas.requestPaint === "function") {
+        // Request to update the canvas
+        canvas.requestPaint();
+      } else {
+        renderCoffeeBoxScene();
+      }
+      requestAnimationFrame(render);
+    }
+    requestAnimationFrame(render);
+
+    // 6. Interactive form controls & validation
+    const form = document.getElementById("coffee-box-form");
+    const nameInput = document.getElementById("customer-name");
+    const emailInput = document.getElementById("customer-email");
+    const submitBtn = document.getElementById("submit-box-btn");
+    const spinToggleBtn = document.getElementById("spin-toggle-btn");
+    const formStatus = document.getElementById("form-status");
+
+    function validateField(input, message) {
+      if (input.validity.valueMissing || input.validity.typeMismatch) {
+        input.setCustomValidity(message);
+        return false;
+      }
+      input.setCustomValidity("");
+      return true;
+    }
+
+    nameInput.addEventListener("input", () => {
+      nameInput.setCustomValidity("");
+      submitBtn.disabled = false;
+    });
+
+    nameInput.addEventListener("blur", () => {
+      validateField(nameInput, "Please enter a recipient name for your coffee box.");
+    });
+
+    emailInput.addEventListener("input", () => {
+      emailInput.setCustomValidity("");
+      submitBtn.disabled = false;
+    });
+
+    emailInput.addEventListener("blur", () => {
+      validateField(emailInput, "Please enter a valid email address for order tracking.");
+    });
+
+    spinToggleBtn.addEventListener("click", () => {
+      isSpinning = !isSpinning;
+      spinToggleBtn.setAttribute("aria-pressed", String(!isSpinning));
+      spinToggleBtn.textContent = isSpinning ? "Pause Spin" : "Resume Spin";
+    });
+
+    form.addEventListener("submit", (e) => {
+      e.preventDefault();
+      const validName = validateField(nameInput, "Please enter a recipient name for your coffee box.");
+      const validEmail = validateField(emailInput, "Please enter a valid email address for order tracking.");
+
+      if (!validName || !validEmail || !form.checkValidity()) {
+        formStatus.className = "error";
+        formStatus.textContent = !validName
+          ? nameInput.validationMessage
+          : emailInput.validationMessage;
+        (!validName ? nameInput : emailInput).focus();
+        return;
+      }
+
+      const data = new FormData(form);
+      const roast = data.get("roast_level") || "Medium";
+      const recipient = data.get("customer_name");
+      submitBtn.disabled = true;
+      formStatus.className = "";
+      formStatus.textContent = `Reserved ${roast} Roast box for ${recipient}!`;
+    });
+  </script>
+
 </body>
 
