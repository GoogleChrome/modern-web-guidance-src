+
+    #tooltip {
+      position: fixed;
+      position-area: block-start;
+      position-try-fallbacks: flip-block;
+      container-type: anchored;
+      background: transparent;
+      border: none;
+      padding: 0;
+      overflow: visible;
+    }
+
+    .tooltip-content {
+      position: relative;
+      background: var(--primary);
+      color: var(--light);
+      padding: 0.6rem 0.9rem;
