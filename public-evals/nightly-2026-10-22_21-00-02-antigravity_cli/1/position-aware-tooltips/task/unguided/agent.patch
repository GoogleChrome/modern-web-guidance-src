+      margin-bottom: 4px;
+      border-radius: 8px 8px 2px 2px;
+    }
+
+    #maple-tooltip::after {
+      content: "";
+      position: absolute;
+      top: 100%;
+      left: 50%;
+      transform: translateX(-50%);
+      border-width: 6px;
+      border-style: solid;
+      border-color: var(--primary) transparent transparent transparent;
+    }
