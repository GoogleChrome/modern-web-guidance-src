+      prevItemBtn.addEventListener('click', function () {
+        const targetId = prevItemBtn.getAttribute('data-sibling-id');
+        if (targetId) {
+          pushDetailView(targetId, { updateHistory: true, replaceHistory: false });
+        }
+      });
+
+      nextItemBtn.addEventListener('click', function () {
+        const targetId = nextItemBtn.getAttribute('data-sibling-id');
+        if (targetId) {
+          pushDetailView(targetId, { updateHistory: true, replaceHistory: false });
+        }
+      });
+
+      // Quantity Stepper & Add to Order
+      qtyMinusBtn.addEventListener('click', function () {
+        if (quantity > 1) {
+          quantity -= 1;
+          renderCustomizationControls();
+        }
+      });
+
+      qtyPlusBtn.addEventListener('click', function () {
+        if (quantity < 12) {
+          quantity += 1;
+          renderCustomizationControls();
+        }
+      });
+
+      addToOrderBtn.addEventListener('click', function () {
+        if (!currentItem) return;
+        bagCount += quantity;
+        bagCountEl.textContent = String(bagCount);
+        const sizeLabel = currentItem.sizes[selectedSizeIndex].label;
+        orderToast.textContent = 'Added ' + quantity + '× ' + currentItem.title + ' (' + sizeLabel + ') to your bag.';
+        orderToast.classList.add('is-shown');
+        if (toastTimer) clearTimeout(toastTimer);
+        toastTimer = setTimeout(function () {
+          orderToast.classList.remove('is-shown');
+        }, 3200);
+      });
+
+      // Keyboard Navigation (Escape or Alt+ArrowLeft pops back)
+      window.addEventListener('keydown', function (e) {
+        if (stackViewport.getAttribute('data-stack-depth') !== '1') return;
+        if (e.key === 'Escape' || (e.altKey && e.key === 'ArrowLeft')) {
+          e.preventDefault();
+          popToRootView({ updateHistory: true });
+        }
+      });
+
+      // Browser History Sync (Back / Forward buttons & hash changes)
+      window.addEventListener('popstate', function () {
+        if (sessionPushCount > 0 && !resolveItemFromLocation()) {
+          sessionPushCount = Math.max(0, sessionPushCount - 1);
+        }
+        syncStackWithLocation(false);
+      });
+
+      window.addEventListener('hashchange', function () {
+        syncStackWithLocation(false);
+      });
+
+      // =========================================================================
+      // Interactive Touch & Pointer Swipe-Back Gesture Controller
+      // =========================================================================
+      let gestureState = null;
+
+      function isInteractiveTarget(target) {
+        if (!target || !target.closest) return false;
+        return Boolean(
+          target.closest('button, a, input, select, textarea, [role="radio"]')
+        );
+      }
+
+      function beginGesture(clientX, clientY, fromEdgeHandle, target) {
+        if (stackViewport.getAttribute('data-stack-depth') !== '1') return;
+        if (!fromEdgeHandle && isInteractiveTarget(target)) return;
+
+        gestureState = {
+          startX: clientX,
+          startY: clientY,
+          currentX: clientX,
+          currentY: clientY,
+          startTime: performance.now(),
+          fromEdge: fromEdgeHandle || clientX <= 48,
+          isSwiping: false,
+          aborted: false
+        };
+      }
+
+      function updateGesture(clientX, clientY, rawEvent) {
+        if (!gestureState || gestureState.aborted) return;
+
+        const dx = clientX - gestureState.startX;
+        const dy = clientY - gestureState.startY;
+        gestureState.currentX = clientX;
+        gestureState.currentY = clientY;
+
+        if (!gestureState.isSwiping) {
+          // Ignore tiny jitter movements
+          if (Math.hypot(dx, dy) < 8) return;
+
+          // Lock to horizontal right-swipe if horizontal motion dominates
+          if (dx > 0 && Math.abs(dx) > Math.abs(dy) * 1.15) {
+            gestureState.isSwiping = true;
+            stackViewport.classList.add('is-dragging');
+          } else {
+            gestureState.aborted = true;
+            return;
+          }
+        }
+
+        if (gestureState.isSwiping) {
+          if (rawEvent && rawEvent.cancelable) {
+            rawEvent.preventDefault();
+          }
+          const clampedDx = Math.max(0, dx);
+          const viewportWidth = stackViewport.clientWidth || window.innerWidth || 375;
+          const progress = Math.min(1, clampedDx / viewportWidth);
+
+          detailView.style.transform = 'translate3d(' + clampedDx + 'px, 0, 0)';
+          const rootTranslate = -25 * (1 - progress);
+          const rootScale = 0.96 + 0.04 * progress;
+          rootView.style.transform = 'translate3d(' + rootTranslate + '%, 0, 0) scale(' + rootScale + ')';
+          stackScrim.style.opacity = String(Math.max(0, 1 - progress));
+        }
+      }
+
+      function endGesture() {
+        if (!gestureState) return;
+        const state = gestureState;
+        gestureState = null;
+
+        if (!state.isSwiping) return;
+
+        const dx = Math.max(0, state.currentX - state.startX);
+        const elapsed = Math.max(1, performance.now() - state.startTime);
+        const velocity = dx / elapsed; // px per ms
+        const viewportWidth = stackViewport.clientWidth || window.innerWidth || 375;
+
+        const shouldPop =
+          dx > viewportWidth * 0.24 ||
+          dx > 95 ||
+          (dx > 36 && velocity > 0.32);
+
+        clearSwipeInlineStyles();
+
+        if (shouldPop) {
+          popToRootView({ updateHistory: true });
+        }
+      }
+
+      // Touch Events (Mobile / Touch Emulation)
+      stackViewport.addEventListener(
+        'touchstart',
+        function (e) {
+          if (!e.touches || e.touches.length !== 1) return;
+          const touch = e.touches[0];
+          const fromEdge = e.target === swipeEdgeZone || swipeEdgeZone.contains(e.target);
+          beginGesture(touch.clientX, touch.clientY, fromEdge, e.target);
+        },
+        { passive: true }
+      );
+
+      stackViewport.addEventListener(
+        'touchmove',
+        function (e) {
+          if (!e.touches || e.touches.length !== 1) return;
+          const touch = e.touches[0];
+          updateGesture(touch.clientX, touch.clientY, e);
+        },
+        { passive: false }
+      );
+
+      stackViewport.addEventListener('touchend', endGesture);
+      stackViewport.addEventListener('touchcancel', endGesture);
+
+      // Pointer / Mouse Drag Events (Desktop / Automated Pointer Swipe)
+      let isMouseDown = false;
+
+      stackViewport.addEventListener('pointerdown', function (e) {
+        if (e.pointerType === 'touch') return; // Handled by touch listeners
+        if (e.button !== 0) return;
+        const fromEdge = e.target === swipeEdgeZone || swipeEdgeZone.contains(e.target);
+        isMouseDown = true;
+        beginGesture(e.clientX, e.clientY, fromEdge, e.target);
+      });
+
+      window.addEventListener('pointermove', function (e) {
+        if (!isMouseDown || e.pointerType === 'touch') return;
+        updateGesture(e.clientX, e.clientY, e);
+      });
+
+      window.addEventListener('pointerup', function (e) {
+        if (!isMouseDown || e.pointerType === 'touch') return;
+        isMouseDown = false;
+        endGesture();
+      });
+
+      window.addEventListener('pointercancel', function () {
+        if (!isMouseDown) return;
+        isMouseDown = false;
+        endGesture();
+      });
+
+      // Fallback Mouse Events for synthetic mouse drag dispatchers that don't fire pointer events
+      stackViewport.addEventListener('mousedown', function (e) {
+        if (gestureState || e.button !== 0) return;
+        const fromEdge = e.target === swipeEdgeZone || swipeEdgeZone.contains(e.target);
+        isMouseDown = true;
+        beginGesture(e.clientX, e.clientY, fromEdge, e.target);
+      });
+
+      window.addEventListener('mousemove', function (e) {
+        if (!isMouseDown || !gestureState) return;
+        updateGesture(e.clientX, e.clientY, e);
+      });
+
+      window.addEventListener('mouseup', function () {
+        if (!isMouseDown) return;
+        isMouseDown = false;
+        endGesture();
+      });
+
+      // Boot the Navigation Stack in sync with the initial URL / Deep Link
+      syncStackWithLocation(true);
+    })();
+  </script>
+</body>
+
+</html>
