     }
 
+    /* Store Select Picker */
+    .store-picker {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      margin-top: 1.25rem;
+      width: 100%;
+      max-width: 280px;
+    }
+
+    .store-picker label {
+      font-size: 0.9rem;
+      font-weight: 600;
+      letter-spacing: 0.05em;
+      text-transform: uppercase;
+      color: var(--secondary);
+      margin-bottom: 0.4rem;
+    }
+
+    .animated-select,
+    .animated-select::picker(select) {
+      appearance: base-select;
+    }
+
+    .animated-select {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      width: 100%;
+      min-height: 48px;
+      padding: 0.75rem 1rem;
+      font-family: inherit;
+      font-size: 1rem;
+      color: var(--text);
+      background-color: var(--light);
+      border: 2px solid var(--secondary);
+      border-radius: 8px;
+      cursor: pointer;
+      transition: border-color 0.2s ease, box-shadow 0.2s ease;
+    }
+
+    .animated-select:hover {
+      border-color: var(--accent);
+    }
+
+    .animated-select:focus-visible {
+      outline: 3px solid var(--accent);
+      outline-offset: 2px;
+    }
+
+    .animated-select::picker-icon {
+      color: var(--primary);
+      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
+    }
+
+    .animated-select:open::picker-icon {
+      transform: rotate(180deg);
+    }
+
+    .animated-select::picker(select) {
+      background: white;
+      color: var(--text);
+      border: 1px solid var(--secondary);
+      border-radius: 12px;
+      box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.2);
+      padding: 0.5rem;
+      margin-top: 0.25rem;
+      width: anchor-size(width);
+      overflow: hidden;
+      transition:
+        display 0.4s allow-discrete,
+        overlay 0.4s allow-discrete,
+        opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
+        height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
+      opacity: 0;
+      height: 0;
+    }
+
+    .animated-select:open::picker(select) {
+      opacity: 1;
+      height: auto;
+    }
+
+    @starting-style {
+      .animated-select:open::picker(select) {
+        opacity: 0;
+        height: 0;
+      }
+    }
+
+    .animated-select option {
+      padding: 0.625rem 0.75rem;
+      border-radius: 6px;
+      color: var(--text);
+      cursor: pointer;
+      text-align: start;
+    }
+
+    .animated-select option:hover {
+      background-color: #f5f0ee;
+    }
+
+    .animated-select option::checkmark {
+      color: var(--primary);
+    }
+
+    .animated-select option:checked {
+      font-weight: 700;
+      background-color: var(--secondary);
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+      .animated-select::picker(select),
+      .animated-select::picker-icon {
+        transition: none !important;
+      }
+    }
+
