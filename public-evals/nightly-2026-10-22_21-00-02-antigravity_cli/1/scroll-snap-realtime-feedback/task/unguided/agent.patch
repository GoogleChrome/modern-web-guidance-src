+  <script>
+    const gallery = document.getElementById('gallery');
+    const galleryItems = Array.from(gallery.querySelectorAll('.gallery-item'));
+    const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
+
+    gallery.addEventListener('scrollsnapchanging', (event) => {
+      thumbnails.forEach((thumb) => {
+        thumb.classList.remove('pending');
+      });
+
+      const target = event.snapTargetInline || event.snapTargetBlock;
+      const item = target?.closest?.('.gallery-item') || target;
+      const index = galleryItems.indexOf(item);
+      if (index !== -1 && thumbnails[index]) {
+        thumbnails[index].classList.add('pending');
+      }
+    });
+
+    gallery.addEventListener('scrollsnapchange', (event) => {
+      thumbnails.forEach((thumb) => {
+        thumb.classList.remove('pending');
+        thumb.classList.remove('active');
+        thumb.removeAttribute('aria-current');
+      });
+
+      const target = event.snapTargetInline || event.snapTargetBlock;
+      const item = target?.closest?.('.gallery-item') || target;
+      const index = galleryItems.indexOf(item);
+      if (index !== -1 && thumbnails[index]) {
+        thumbnails[index].classList.add('active');
+        thumbnails[index].setAttribute('aria-current', 'true');
+      }
+    });
+
+    thumbnails.forEach((thumb, index) => {
+      thumb.addEventListener('click', () => {
+        if (galleryItems[index]) {
+          galleryItems[index].scrollIntoView({
+            behavior: 'smooth',
+            block: 'nearest',
+            inline: 'center'
+          });
+        }
+      });
+    });
+  </script>
