+  <script>
+    (function () {
+      const initialBeans = [
+        {
+          id: 'ethiopian-yirgacheffe',
+          name: 'Ethiopian Yirgacheffe',
+          roast: 'Light Roast',
+          notes: 'Bright bergamot, jasmine blossom, and sweet Meyer lemon finish.',
+          price: '$19.50',
+          image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80',
+          selected: false
+        },
+        {
+          id: 'colombian-supremo',
+          name: 'Colombian Supremo',
+          roast: 'Medium Roast',
+          notes: 'Velvety caramel, roasted hazelnut, and balanced red apple acidity.',
+          price: '$17.00',
+          image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80',
+          selected: true
+        },
+        {
+          id: 'sumatra-mandheling',
+          name: 'Sumatra Mandheling',
+          roast: 'Dark Roast',
+          notes: 'Full-bodied dark chocolate, cedar spice, and smooth earthy undertone.',
+          price: '$18.50',
+          image: 'https://images.unsplash.com/photo-1497935586351-b67a49e012bf?auto=format&fit=crop&w=600&q=80',
+          selected: false
+        },
+        {
+          id: 'guatemala-antigua',
+          name: 'Guatemala Antigua',
+          roast: 'Medium Roast',
+          notes: 'Rich cocoa nibs, brown sugar sweetness, and subtle orange zest.',
+          price: '$18.00',
+          image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80',
+          selected: true
+        }
+      ];
+
+      const reserveCatalog = [
+        {
+          id: 'kenya-aa',
+          name: 'Kenya AA Nyeri',
+          roast: 'Light-Medium',
+          notes: 'Juicy blackcurrant,ruby grapefruit, and crisp wine-like complexity.',
+          price: '$21.00',
+          image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'costa-rica-tarrazu',
+          name: 'Costa Rica Tarrazú',
+          roast: 'Medium Roast',
+          notes: 'Honeyed Graham cracker, crisp pear, and silky almond finish.',
+          price: '$19.00',
+          image: 'https://images.unsplash.com/photo-1511920170033-f8396924c348?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'brazil-cerrado',
+          name: 'Brazil Cerrado',
+          roast: 'Medium-Dark',
+          notes: 'Toasted walnut, creamy milk chocolate, and low-acid sweetness.',
+          price: '$16.50',
+          image: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=600&q=80'
+        },
+        {
+          id: 'panama-geisha',
+          name: 'Panama Boquete Reserve',
+          roast: 'Light Roast',
+          notes: 'Delicate honeysuckle, ripe white peach, and oolong tea aroma.',
+          price: '$26.00',
+          image: 'https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?auto=format&fit=crop&w=600&q=80'
+        }
+      ];
+
+      let beans = [...initialBeans];
+      let reserveIndex = 0;
+
+      const availableGrid = document.getElementById('available-beans-grid');
+      const selectedGrid = document.getElementById('selected-beans-grid');
+      const availableCount = document.getElementById('available-count');
+      const selectedCount = document.getElementById('selected-count');
+      const addCatalogBtn = document.getElementById('add-catalog-bean-btn');
+      const shuffleBtn = document.getElementById('shuffle-beans-btn');
+      const clearSelectedBtn = document.getElementById('clear-selected-btn');
+
+      function runWithViewTransition(updateFn) {
+        if (typeof document.startViewTransition === 'function') {
+          document.startViewTransition(() => {
+            updateFn();
+          });
+        } else {
+          updateFn();
+        }
+      }
+
+      function createBeanCard(bean) {
+        const card = document.createElement('article');
+        card.className = 'bean-card';
+        card.dataset.beanId = bean.id;
+        // Unique view-transition-name per item combined with shared view-transition-class: bean-item in CSS
+        card.style.viewTransitionName = `bean-${bean.id}`;
+
+        const actionLabel = bean.selected ? 'Remove' : 'Add to Box';
+        const actionClass = bean.selected ? 'bean-action-btn remove-btn' : 'bean-action-btn';
+
+        card.innerHTML = `
+          <img class="bean-card-img" src="${bean.image}" alt="${bean.name}" loading="lazy">
+          <div class="bean-card-body">
+            <span class="bean-roast-tag">${bean.roast}</span>
+            <h4 class="bean-card-title">${bean.name}</h4>
+            <p class="bean-card-notes">${bean.notes}</p>
+            <div class="bean-card-footer">
+              <span class="bean-price">${bean.price}</span>
+              <div class="bean-card-actions">
+                <button type="button" class="${actionClass}" data-action="toggle" data-id="${bean.id}">
+                  ${actionLabel}
+                </button>
+                <button type="button" class="bean-delete-btn" data-action="delete" data-id="${bean.id}" title="Remove item from list" aria-label="Delete ${bean.name}">
+                  &times;
+                </button>
+              </div>
+            </div>
+          </div>
+        `;
+
+        return card;
+      }
+
+      function renderBeans() {
+        const availableBeans = beans.filter((b) => !b.selected);
+        const selectedBeans = beans.filter((b) => b.selected);
+
+        availableGrid.innerHTML = '';
+        selectedGrid.innerHTML = '';
+
+        if (availableBeans.length === 0) {
+          const empty = document.createElement('p');
+          empty.className = 'empty-state';
+          empty.textContent = 'All available beans have been added to your tasting box!';
+          availableGrid.appendChild(empty);
+        } else {
+          availableBeans.forEach((bean) => {
+            availableGrid.appendChild(createBeanCard(bean));
+          });
+        }
+
+        if (selectedBeans.length === 0) {
+          const empty = document.createElement('p');
+          empty.className = 'empty-state';
+          empty.textContent = 'Your tasting box is empty. Add some roasts from the left!';
+          selectedGrid.appendChild(empty);
+        } else {
+          selectedBeans.forEach((bean) => {
+            selectedGrid.appendChild(createBeanCard(bean));
+          });
+        }
+
+        availableCount.textContent = availableBeans.length;
+        selectedCount.textContent = selectedBeans.length;
+        clearSelectedBtn.disabled = selectedBeans.length === 0;
+      }
+
+      function toggleBeanSelection(beanId) {
+        runWithViewTransition(() => {
+          beans = beans.map((bean) =>
+            bean.id === beanId ? { ...bean, selected: !bean.selected } : bean
+          );
+          renderBeans();
+        });
+      }
+
+      function addReserveBean() {
+        const template = reserveCatalog[reserveIndex % reserveCatalog.length];
+        reserveIndex += 1;
+        const uniqueSuffix = Date.now().toString(36) + '-' + reserveIndex;
+        const newBean = {
+          ...template,
+          id: `${template.id}-${uniqueSuffix}`,
+          selected: false
+        };
+
+        runWithViewTransition(() => {
+          beans = [newBean, ...beans];
+          renderBeans();
+        });
+      }
+
+      function shuffleBeans() {
+        runWithViewTransition(() => {
+          const copy = [...beans];
+          for (let i = copy.length - 1; i > 0; i--) {
+            const j = Math.floor(Math.random() * (i + 1));
+            [copy[i], copy[j]] = [copy[j], copy[i]];
+          }
+          beans = copy;
+          renderBeans();
+        });
+      }
+
+      function clearSelectedBeans() {
+        runWithViewTransition(() => {
+          beans = beans.map((bean) => ({ ...bean, selected: false }));
+          renderBeans();
+        });
+      }
+
+      function deleteBean(beanId) {
+        runWithViewTransition(() => {
+          beans = beans.filter((bean) => bean.id !== beanId);
+          renderBeans();
+        });
+      }
+
+      document.getElementById('coffee-bean-selection').addEventListener('click', (event) => {
+        const button = event.target.closest('button[data-action]');
+        if (!button) return;
+        const beanId = button.dataset.id;
+        const action = button.dataset.action;
+        if (!beanId) return;
+
+        if (action === 'toggle') {
+          toggleBeanSelection(beanId);
+        } else if (action === 'delete') {
+          deleteBean(beanId);
+        }
+      });
+
+      addCatalogBtn.addEventListener('click', addReserveBean);
+      shuffleBtn.addEventListener('click', shuffleBeans);
+      clearSelectedBtn.addEventListener('click', clearSelectedBeans);
+
+      renderBeans();
+    })();
+  </script>
 </body>
 
