+  <script>
+    const BEAN_CATALOG = [
+      {
+        id: 'bean-ethiopian-yirgacheffe',
+        name: 'Ethiopian Yirgacheffe',
+        origin: 'Ethiopia',
+        roast: 'Light Roast',
+        notes: 'Bright bergamot, jasmine blossom, and sweet lemon zest.',
+        price: '$19.00',
+        image: 'https://images.unsplash.com/photo-1559056199-641a0ac8b55e?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-colombian-supremo',
+        name: 'Colombian Supremo',
+        origin: 'Colombia',
+        roast: 'Medium Roast',
+        notes: 'Rich caramel sweetness, toasted walnut, and balanced citrus.',
+        price: '$17.50',
+        image: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-sumatra-mandheling',
+        name: 'Sumatra Mandheling',
+        origin: 'Indonesia',
+        roast: 'Dark Roast',
+        notes: 'Full-bodied dark chocolate, cedar spice, and velvety earthiness.',
+        price: '$18.50',
+        image: 'https://images.unsplash.com/photo-1587734195503-904fca47e0e9?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-guatemala-antigua',
+        name: 'Guatemala Antigua',
+        origin: 'Guatemala',
+        roast: 'Medium Roast',
+        notes: 'Velvety cocoa, brown sugar, and a crisp green apple finish.',
+        price: '$18.00',
+        image: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-kenya-aa',
+        name: 'Kenya AA Nyeri',
+        origin: 'Kenya',
+        roast: 'Medium-Light',
+        notes: 'Juicy blackberry, ruby grapefruit, and sparkling wine acidity.',
+        price: '$20.00',
+        image: 'https://images.unsplash.com/photo-1611854779393-1b2da9d400fe?auto=format&fit=crop&w=600&q=80'
+      },
+      {
+        id: 'bean-costa-rica-tarrazu',
+        name: 'Costa Rica Tarrazú',
+        origin: 'Costa Rica',
+        roast: 'Medium Roast',
+        notes: 'Honeyed apricot, toasted almond, and silky milk chocolate.',
+        price: '$18.50',
+        image: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?auto=format&fit=crop&w=600&q=80'
+      }
+    ];
+
+    const INITIAL_IDS = [
+      'bean-ethiopian-yirgacheffe',
+      'bean-colombian-supremo',
+      'bean-sumatra-mandheling',
+      'bean-guatemala-antigua'
+    ];
+
+    let selectedBeanIds = [...INITIAL_IDS];
+
+    const beanListEl = document.getElementById('bean-list');
+    const selectEl = document.getElementById('bean-catalog-select');
+    const addBtnEl = document.getElementById('add-bean-btn');
+    const resetBtnEl = document.getElementById('reset-beans-btn');
+
+    function renderBeans() {
+      const availableToAdd = BEAN_CATALOG.filter(bean => !selectedBeanIds.includes(bean.id));
+      selectEl.replaceChildren();
+
+      if (availableToAdd.length === 0) {
+        const option = document.createElement('option');
+        option.value = '';
+        option.textContent = 'All signature beans selected';
+        selectEl.appendChild(option);
+        selectEl.disabled = true;
+        addBtnEl.disabled = true;
+      } else {
+        selectEl.disabled = false;
+        addBtnEl.disabled = false;
+        for (const bean of availableToAdd) {
+          const option = document.createElement('option');
+          option.value = bean.id;
+          option.textContent = `${bean.name} (${bean.roast}) — ${bean.price}`;
+          selectEl.appendChild(option);
+        }
+      }
+
+      beanListEl.replaceChildren();
+
+      if (selectedBeanIds.length === 0) {
+        const emptyLi = document.createElement('li');
+        emptyLi.className = 'bean-empty';
+        emptyLi.textContent = 'Your coffee bean box is empty. Choose a roast above to add it!';
+        beanListEl.appendChild(emptyLi);
+        return;
+      }
+
+      for (const id of selectedBeanIds) {
+        const bean = BEAN_CATALOG.find(item => item.id === id);
+        if (!bean) continue;
+
+        const li = document.createElement('li');
+        li.className = 'bean-item';
+        li.style.viewTransitionName = bean.id;
+        li.dataset.beanId = bean.id;
+
+        const img = document.createElement('img');
+        img.src = bean.image;
+        img.alt = bean.name;
+        img.loading = 'lazy';
+
+        const body = document.createElement('div');
+        body.className = 'bean-item-body';
+
+        const meta = document.createElement('div');
+        meta.className = 'bean-meta';
+
+        const originSpan = document.createElement('span');
+        originSpan.textContent = bean.origin;
+
+        const roastSpan = document.createElement('span');
+        roastSpan.className = 'bean-roast';
+        roastSpan.textContent = bean.roast;
+
+        meta.append(originSpan, roastSpan);
+
+        const title = document.createElement('h3');
+        title.textContent = bean.name;
+
+        const notes = document.createElement('p');
+        notes.className = 'bean-notes';
+        notes.textContent = bean.notes;
+
+        const footer = document.createElement('div');
+        footer.className = 'bean-item-footer';
+
+        const price = document.createElement('span');
+        price.className = 'bean-price';
+        price.textContent = bean.price;
+
+        const removeBtn = document.createElement('button');
+        removeBtn.type = 'button';
+        removeBtn.className = 'bean-remove-btn';
+        removeBtn.dataset.removeId = bean.id;
+        removeBtn.setAttribute('aria-label', `Remove ${bean.name}`);
+        removeBtn.textContent = 'Remove';
+
+        footer.append(price, removeBtn);
+        body.append(meta, title, notes, footer);
+        li.append(img, body);
+        beanListEl.appendChild(li);
+      }
+    }
+
+    function updateBeanSelection(mutateState, focusFallbackSelector) {
+      const applyUpdate = () => {
+        mutateState();
+        renderBeans();
+        if (focusFallbackSelector) {
+          const target = document.querySelector(focusFallbackSelector);
+          if (target) target.focus();
+        }
+      };
+
+      if (document.startViewTransition) {
+        document.startViewTransition(() => applyUpdate());
+      } else {
+        applyUpdate();
+      }
+    }
+
+    addBtnEl.addEventListener('click', () => {
+      const chosenId = selectEl.value;
+      if (!chosenId || selectedBeanIds.includes(chosenId)) return;
+      updateBeanSelection(() => {
+        selectedBeanIds.push(chosenId);
+      });
+    });
+
+    resetBtnEl.addEventListener('click', () => {
+      updateBeanSelection(() => {
+        selectedBeanIds = [...INITIAL_IDS];
+      });
+    });
+
+    beanListEl.addEventListener('click', (event) => {
+      const btn = event.target.closest('[data-remove-id]');
+      if (!btn) return;
+      const removeId = btn.dataset.removeId;
+      const index = selectedBeanIds.indexOf(removeId);
+      if (index === -1) return;
+
+      const nextFocusId = selectedBeanIds[index + 1] || selectedBeanIds[index - 1];
+      const fallbackSelector = nextFocusId
+        ? `[data-remove-id="${nextFocusId}"]`
+        : '#bean-catalog-select';
+
+      updateBeanSelection(() => {
+        selectedBeanIds = selectedBeanIds.filter(id => id !== removeId);
+      }, fallbackSelector);
+    });
+
+    renderBeans();
+  </script>
+
 </body>
 
 </html>
