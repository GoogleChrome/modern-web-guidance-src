+    }
+
+    @keyframes bean-slide-out {
+      to {
+        opacity: 0;
+        translate: 0 -24px;
+        scale: 0.92;
+      }
+    }
+
+    /* Handle accessibility by respecting motion preferences */
+    @media (prefers-reduced-motion: reduce) {
+      ::view-transition-group(*),
+      ::view-transition-old(*),
+      ::view-transition-new(*) {
+        animation: none !important;
+      }
+    }
