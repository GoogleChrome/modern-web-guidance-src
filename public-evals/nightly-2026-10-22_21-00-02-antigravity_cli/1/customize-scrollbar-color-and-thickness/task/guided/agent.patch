+      --scrollbar-thumb: var(--accent);
+      --scrollbar-track: var(--primary);
+
+      max-height: 280px;
+      overflow-y: auto;
+      background: white;
+      border-radius: 8px;
+      padding: 20px;
+      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
+      border: 1px solid var(--secondary);
+      scrollbar-width: thin;
+      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
+      list-style: none;
+    }
+
+    /* Legacy fallback for WebKit/Blink browsers */
+    @supports not (scrollbar-color: auto) {
+      .feedback-log::-webkit-scrollbar {
+        /* Must define base size in WebKit for custom colors to be visual */
+        width: 8px;
+        height: 8px;
+      }
+
+      .feedback-log::-webkit-scrollbar-thumb {
+        background: var(--scrollbar-thumb);
+        border-radius: 4px;
+      }
+
+      .feedback-log::-webkit-scrollbar-track {
+        background: var(--scrollbar-track);
+      }
+    }
+
+    .feedback-item {
+      padding: 15px 0;
+    }
+
+    .feedback-item:not(:last-child) {
+      border-bottom: 1px solid var(--secondary);
+    }
+
+    .feedback-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+      margin-bottom: 6px;
+    }
