+  <script>
+    (function () {
+      const coffeeDetails = {
+        'maple-oat-latte': {
+          title: 'Maple Oat Latte',
+          badge: 'Seasonal Specialty',
+          description: 'Creamy oat milk with a hint of Vermont maple syrup. Crafted with our signature double-shot espresso, velvety steamed barista oat milk, and pure Grade A dark amber maple syrup finished with a light dusting of cinnamon.',
+          price: '$5.75 (12 oz)',
+          notes: 'Rich maple, toasted oats, warm cinnamon',
