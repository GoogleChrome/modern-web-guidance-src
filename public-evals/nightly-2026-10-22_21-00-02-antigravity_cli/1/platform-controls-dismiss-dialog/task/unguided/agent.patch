+          imageAlt: 'Maple Oat Latte topped with foam and cinnamon'
+        },
+        'dark-roast-espresso': {
+          title: 'Dark Roast Espresso',
+          badge: 'Signature Roast',
+          description: 'Bold, smokey, and perfect for a morning boost. Slow-roasted single-origin Arabica beans pulled to perfection with a rich, velvety crema and deep bittersweet cocoa undertones.',
+          price: '$3.50 (Double Shot)',
+          notes: 'Dark chocolate, toasted walnut, smoky caramel',
+          ingredients: '100% Ethically Sourced Dark Roast Arabica Beans, Filtered Water',
+          calories: '10 kcal',
+          image: 'https://images.unsplash.com/photo-1510591509098-f4fdc6d0ff04?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Freshly pulled shot of Dark Roast Espresso'
+        },
+        'cold-brew': {
+          title: 'Cold Brew',
+          badge: 'House Favorite',
+          description: 'Steeped for 18 hours for maximum smoothness. Coarse-ground Colombian and Ethiopian beans cold-steeped in small batches for an ultra-smooth, naturally sweet cup with low acidity.',
+          price: '$4.75 (16 oz)',
+          notes: 'Smooth cocoa, brown sugar, crisp citrus finish',
+          ingredients: 'Cold-Steeped Specialty Coffee Beans, Filtered Water, Ice',
+          calories: '15 kcal',
+          image: 'https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=800&q=80',
+          imageAlt: 'Chilled glass of Cold Brew coffee over ice'
+        }
+      };
+
+      const modal = document.getElementById('coffee-modal');
+      const modalTitle = document.getElementById('modal-title');
+      const modalBadge = document.getElementById('modal-badge');
+      const modalDescription = document.getElementById('modal-description');
+      const modalPrice = document.getElementById('modal-price');
+      const modalNotes = document.getElementById('modal-notes');
+      const modalIngredients = document.getElementById('modal-ingredients');
+      const modalCalories = document.getElementById('modal-calories');
+      const modalImage = document.getElementById('modal-image');
+      const closeBtn = document.getElementById('modal-close-btn');
+      const triggerButtons = document.querySelectorAll('[data-coffee]');
+
+      let lastTrigger = null;
+
+      function openCoffeeModal(coffeeKey, triggerEl) {
+        const data = coffeeDetails[coffeeKey];
+        if (!data || !modal) return;
+
+        lastTrigger = triggerEl || document.activeElement;
+
+        modalTitle.textContent = data.title;
+        modalBadge.textContent = data.badge;
+        modalDescription.textContent = data.description;
+        modalPrice.textContent = data.price;
+        modalNotes.textContent = data.notes;
+        modalIngredients.textContent = data.ingredients;
+        modalCalories.textContent = data.calories;
+        modalImage.src = data.image;
+        modalImage.alt = data.imageAlt;
+
+        if (!(window.history.state && window.history.state.coffeeModalOpen)) {
+          window.history.pushState({ coffeeModalOpen: true, coffeeKey: coffeeKey }, '');
+        } else {
+          window.history.replaceState({ coffeeModalOpen: true, coffeeKey: coffeeKey }, '');
+        }
+
+        if (!modal.open) {
+          if (typeof modal.showModal === 'function') {
+            modal.showModal();
+          } else {
+            modal.setAttribute('open', '');
+          }
+        }
+
+        closeBtn.focus();
+      }
+
+      function closeCoffeeModal() {
+        if (!modal || !modal.open) return;
+        if (typeof modal.close === 'function') {
+          modal.close();
+        } else {
+          modal.removeAttribute('open');
+        }
+      }
+
+      triggerButtons.forEach((button) => {
+        button.addEventListener('click', () => {
+          openCoffeeModal(button.getAttribute('data-coffee'), button);
+        });
+      });
+
+      closeBtn.addEventListener('click', () => {
+        closeCoffeeModal();
+      });
+
+      modal.addEventListener('click', (event) => {
+        if (event.target === modal) {
+          closeCoffeeModal();
+        }
+      });
+
+      modal.addEventListener('close', () => {
+        if (lastTrigger && typeof lastTrigger.focus === 'function') {
+          lastTrigger.focus();
+        }
+      });
+
+      document.addEventListener('keydown', (event) => {
+        if (event.key === 'Escape' && modal && modal.open) {
+          closeCoffeeModal();
+        }
+      });
+
+      window.addEventListener('popstate', () => {
+        if (modal && modal.open) {
+          closeCoffeeModal();
+        }
+      });
+    })();
+  </script>
