+  <script>
+    // Discrete display transition probe and exit fallback helpers
+    let supportsDisplayTransition;
+    function canTransitionDisplay() {
+      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
+      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
+        return false;
+      }
+      const probe = document.createElement('div');
+      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
+      document.body.appendChild(probe);
+      getComputedStyle(probe).display;
+      probe.style.display = 'none';
+      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
+      probe.remove();
+      return supportsDisplayTransition;
+    }
+
+    async function hideElement(el) {
+      if (canTransitionDisplay()) {
+        el.hidden = true;
+      } else {
+        el.setAttribute('data-closing', '');
+      }
+
+      const animations = el.getAnimations();
+      if (animations.length > 0) {
+        await Promise.race([
+          Promise.allSettled(animations.map((a) => a.finished)),
+          new Promise((r) => setTimeout(r, 2000)),
+        ]);
+      }
+
+      if (el.hasAttribute('data-closing')) {
+        el.removeAttribute('data-closing');
+        el.hidden = true;
+      }
+    }
+
+    function showElement(el) {
+      el.removeAttribute('data-closing');
+      el.hidden = false;
+    }
+
+    // Fallback for browsers that do not support view() scroll-driven animations
+    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+    if (
+      !prefersReducedMotion.matches &&
+      !window.CSS?.supports?.('(animation-timeline: view()) and (animation-range: entry)')
+    ) {
+      const observer = new IntersectionObserver(
+        (entries) => {
+          for (const entry of entries) {
+            if (prefersReducedMotion.matches) {
+              entry.target.style.opacity = '';
+              entry.target.style.scale = '';
+              continue;
+            }
+            const ratio = Math.min(1, entry.intersectionRatio / 0.35);
+            entry.target.style.opacity = String(0.2 + ratio * 0.8);
+            entry.target.style.scale = String(0.96 + ratio * 0.04);
+          }
+        },
+        {
+          threshold: Array.from({ length: 21 }, (_, i) => i / 20),
+        }
+      );
+
+      document.querySelectorAll('.card, footer').forEach((el) => {
+        observer.observe(el);
+      });
+    }
+  </script>
+
