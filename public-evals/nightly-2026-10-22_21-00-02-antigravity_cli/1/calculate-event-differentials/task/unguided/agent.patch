+  <script>
+    function updatePromotionTimer() {
+      const countdownEl = document.getElementById('maple-oat-countdown');
+      const elapsedEl = document.getElementById('maple-oat-elapsed');
+      if (!countdownEl || !elapsedEl) return;
+
+      const userTimeZone = Temporal.Now.timeZoneId();
+      const now = Temporal.Now.zonedDateTimeISO(userTimeZone);
+
+      const promoStart = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 2,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone
+      });
+
+      const promoEnd = Temporal.ZonedDateTime.from({
+        year: 2026,
+        month: 3,
+        day: 1,
+        hour: 0,
+        minute: 0,
+        second: 0,
+        timeZone: userTimeZone
+      });
+
+      const remaining = now.until(promoEnd, { largestUnit: 'days' });
+      const elapsed = now.since(promoStart, { largestUnit: 'days' });
+
+      if (Temporal.ZonedDateTime.compare(now, promoEnd) >= 0) {
+        countdownEl.textContent = '0 days, 0 hours (Offer ended)';
+      } else {
+        countdownEl.textContent = `${remaining.days} days, ${remaining.hours} hours`;
+      }
+
+      if (Temporal.ZonedDateTime.compare(now, promoStart) < 0) {
+        elapsedEl.textContent = '0 days, 0 hours (Not started yet)';
+      } else {
+        elapsedEl.textContent = `${elapsed.days} days, ${elapsed.hours} hours`;
+      }
+    }
+
+    document.addEventListener('DOMContentLoaded', updatePromotionTimer);
+  </script>
 </body>
 
