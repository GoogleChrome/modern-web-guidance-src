+  <script>
+    function formatDuration(duration) {
+      if (typeof Intl !== 'undefined' && typeof Intl.DurationFormat !== 'undefined') {
+        const formatter = new Intl.DurationFormat(undefined, { style: 'long' });
+        return formatter.format(duration);
+      }
+      if (typeof duration.toLocaleString === 'function') {
+        return duration.toLocaleString(undefined, { style: 'long' });
+      }
+      const d = duration.days || 0;
+      const h = duration.hours || 0;
+      const daysStr = `${d} day${d === 1 ? '' : 's'}`;
+      const hoursStr = `${h} hour${h === 1 ? '' : 's'}`;
+      return `${daysStr}, ${hoursStr}`;
+    }
+
+    function updatePromotionTimer() {
+      const remainingEl = document.getElementById('maple-oat-remaining');
+      const elapsedEl = document.getElementById('maple-oat-elapsed');
+      if (!remainingEl || !elapsedEl) return;
+
+      // 1. Get current time point in the user's local system time zone
+      const now = Temporal.Now.zonedDateTimeISO();
+      const tz = now.timeZoneId;
+
+      // 2. Combine separate date and time strings directly using Temporal methods
+      const startDateStr = "2026-02-01";
+      const startTimeStr = "00:00:00";
+      const endDateStr = "2026-03-01";
+      const endTimeStr = "00:00:00";
+
+      const start = Temporal.PlainDate.from(startDateStr).toPlainDateTime(startTimeStr).toZonedDateTime(tz);
+      const end = Temporal.PlainDate.from(endDateStr).toPlainDateTime(endTimeStr).toZonedDateTime(tz);
+
+      // 3. Calculate elapsed and remaining time using .since() and .until()
+      const timeActive = now.since(start, { largestUnit: 'day', smallestUnit: 'hour' });
+      const timeRemaining = now.until(end, { largestUnit: 'day', smallestUnit: 'hour' });
+
+      // 4. Format and update display, checking .sign for status
+      if (timeActive.sign < 0) {
+        elapsedEl.textContent = 'Promotion has not started yet';
+      } else {
+        const balancedActive = timeActive.round({ largestUnit: 'day', smallestUnit: 'hour', relativeTo: start });
+        elapsedEl.textContent = formatDuration(balancedActive);
+      }
+
+      if (timeRemaining.sign <= 0) {
+        remainingEl.textContent = 'Offer has ended';
+      } else {
+        const balancedRemaining = timeRemaining.round({ largestUnit: 'day', smallestUnit: 'hour', relativeTo: now });
+        remainingEl.textContent = formatDuration(balancedRemaining);
+      }
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import("https://esm.sh/@js-temporal/polyfill");
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', updatePromotionTimer);
+      } else {
+        updatePromotionTimer();
+      }
+    })();
+  </script>
