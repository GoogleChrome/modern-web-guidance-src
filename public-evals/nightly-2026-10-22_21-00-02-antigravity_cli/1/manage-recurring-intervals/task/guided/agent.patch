+  <script type="module">
+    const startDateInput = document.getElementById('startDateInput');
+    const yearsInput = document.getElementById('yearsInput');
+    const monthsInput = document.getElementById('monthsInput');
+    const overflowSelect = document.getElementById('overflowSelect');
+    const resultDate = document.getElementById('resultDate');
+
+    function calculateNextDelivery() {
+      if (typeof Temporal === 'undefined') {
+        return;
+      }
+
+      const startValue = startDateInput.value.trim();
+      const years = Number(yearsInput.value) || 0;
+      const months = Number(monthsInput.value) || 0;
+      const overflow = overflowSelect.value;
+
+      if (!startValue) {
+        resultDate.textContent = 'Error: Please enter a valid start date.';
+        resultDate.classList.add('error');
+        return;
+      }
+
+      try {
+        const startDate = Temporal.PlainDate.from(startValue);
+        const nextDeliveryDate = startDate.add(
+          { years, months },
+          { overflow }
+        );
+        resultDate.textContent = nextDeliveryDate.toString();
+        resultDate.classList.remove('error');
+      } catch (error) {
+        resultDate.textContent = `Error: Unable to calculate delivery date (${error.message || error.name})`;
+        resultDate.classList.add('error');
+      }
+    }
+
+    function initializePlanner() {
+      const inputs = [startDateInput, yearsInput, monthsInput, overflowSelect];
+      inputs.forEach((el) => {
+        el.addEventListener('input', calculateNextDelivery);
+        el.addEventListener('change', calculateNextDelivery);
+      });
+      calculateNextDelivery();
+    }
+
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializePlanner();
+    })();
+  </script>
+
