+  <script type="module">
+    let TemporalAPI = globalThis.Temporal;
+
+    async function getTemporal() {
+      if (TemporalAPI) {
+        return TemporalAPI;
+      }
+      if ('Temporal' in globalThis) {
+        TemporalAPI = globalThis.Temporal;
+        return TemporalAPI;
+      }
+      const mod = await import('https://esm.sh/@js-temporal/polyfill');
+      TemporalAPI = mod.Temporal;
+      return TemporalAPI;
+    }
+
+    const startDateInput = document.getElementById('startDateInput');
+    const yearsInput = document.getElementById('yearsInput');
+    const monthsInput = document.getElementById('monthsInput');
+    const overflowSelect = document.getElementById('overflowSelect');
+    const resultDate = document.getElementById('resultDate');
+
+    async function updateDeliveryDate() {
+      try {
+        const Temporal = await getTemporal();
+        const rawDate = startDateInput.value.trim();
+        if (!rawDate) {
+          throw new Error('Please enter a valid start date.');
+        }
+
+        const startDate = Temporal.PlainDate.from(rawDate);
+        const years = Number(yearsInput.value || 0);
+        const months = Number(monthsInput.value || 0);
+        if (!Number.isInteger(years) || !Number.isInteger(months)) {
+          throw new RangeError('Years and months must be whole numbers.');
+        }
+
+        const duration = Temporal.Duration.from({ years, months });
+        const overflow = overflowSelect.value;
+
+        const nextDelivery = startDate.add(duration, { overflow });
+        resultDate.textContent = nextDelivery.toString();
+        resultDate.classList.remove('error');
+      } catch (err) {
+        resultDate.textContent = `Error: ${err.message || 'Invalid date calculation'}`;
+        resultDate.classList.add('error');
+      }
+    }
+
+    [startDateInput, yearsInput, monthsInput, overflowSelect].forEach((el) => {
+      el.addEventListener('input', updateDeliveryDate);
+      el.addEventListener('change', updateDeliveryDate);
+    });
+
+    updateDeliveryDate();
+  </script>
 </body>
 
