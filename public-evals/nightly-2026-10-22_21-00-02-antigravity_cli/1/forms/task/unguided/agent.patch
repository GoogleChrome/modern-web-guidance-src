+      brewRadios.forEach(function (radio) {
+        radio.addEventListener('change', function () {
+          validateSingleField(radio);
+        });
+      });
+
+      // Step Navigation Button Listeners
+      form.querySelectorAll('[data-next-step]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const nextStep = Number(btn.getAttribute('data-next-step'));
+          if (validateStep(currentStep)) {
+            goToStep(nextStep);
+          }
+        });
+      });
+
+      form.querySelectorAll('[data-prev-step]').forEach(function (btn) {
+        btn.addEventListener('click', function () {
+          const prevStep = Number(btn.getAttribute('data-prev-step'));
+          goToStep(prevStep);
+        });
+      });
+
+      // Final Form Submission with Security Safeguards
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        if (isSubmitting) return;
+
+        // 1. Check Honeypot field for automated bot submissions
+        const honeypot = document.getElementById('company-website');
+        if (honeypot && honeypot.value.trim() !== '') {
+          return;
+        }
+
+        // 2. Verify CSRF token integrity
+        if (!csrfInput || !csrfInput.value || !csrfInput.value.startsWith('dg_csrf_')) {
+          renderErrorSummary([{
+            id: 'submit-registration-btn',
+            label: 'Security Verification',
+            message: 'Invalid form security token. Please refresh the page and try again.'
+          }]);
+          return;
+        }
+
+        // 3. Validate all steps sequentially
+        for (let step = 1; step <= 3; step++) {
+          if (!validateStep(step)) {
+            if (currentStep !== step) {
+              goToStep(step);
+              validateStep(step);
+            }
+            return;
+          }
+        }
+
+        // 4. Prevent double submission & lock sensitive fields
+        isSubmitting = true;
+        if (submitBtn) {
+          submitBtn.disabled = true;
+          submitBtn.setAttribute('aria-busy', 'true');
+          submitBtn.textContent = 'Creating Account...';
+        }
+
+        // Ensure password fields are masked before completion
+        if (passwordInput) passwordInput.type = 'password';
+        if (confirmPasswordInput) confirmPasswordInput.type = 'password';
+
+        const memberEmail = (document.getElementById('email').value || '').trim();
+
+        // Clear sensitive password fields from DOM after capture
+        if (passwordInput) passwordInput.value = '';
+        if (confirmPasswordInput) confirmPasswordInput.value = '';
+
+        // 5. Display accessible confirmation state
+        if (confirmedEmailEl) {
+          confirmedEmailEl.textContent = memberEmail;
+        }
+
+        stepperItems.forEach(function (item) {
+          if (!item) return;
+          item.removeAttribute('aria-current');
+          item.classList.add('is-complete');
+          const numBadge = item.querySelector('.step-number');
+          if (numBadge) numBadge.textContent = '✓';
+        });
+
+        hideErrorSummary();
+        form.hidden = true;
+        if (successBanner) {
+          successBanner.hidden = false;
+          successBanner.focus();
+        }
+      });
+    })();
+  </script>
