+  let email = '';
+  let token = '';
+  let sessionId = null;
+  let expectedAudience = RP_ORIGIN;
+
+  if (typeof input?.formData === 'function') {
+    const formData = await input.formData();
+    name = String(formData.get('name') || '').trim();
+    email = String(formData.get('email') || '').trim();
+    token = String(formData.get('token') || '').trim();
+    sessionId = getSessionIdFromHeaders(input.headers || {});
+  } else {
+    name = String(input.name || '').trim();
+    email = String(input.email || '').trim();
+    token = String(input.token || '').trim();
+    sessionId = input.sessionId ?? null;
+    if (input.expectedAudience) {
+      expectedAudience = input.expectedAudience;
+    }
+  }
+
+  const submittedName = name;
+  const submittedEmail = email;
+  const rawToken = token;
+
+  // Atomically read and delete the single-use nonce from server-side session state
+  const expectedNonce = input.expectedNonce ?? consumeSessionNonce(sessionId);
+
+  if (!submittedEmail || !submittedEmail.includes('@')) {
+    return {
+      status: 400,
+      body: {
+        ok: false,
+        error: 'Please provide a valid email address.',
+      },
+    };
+  }
+
+  if (rawToken && expectedNonce) {
+    try {
+      await verifyEmailVerificationToken({
+        rawToken,
+        submittedEmail,
+        expectedNonce,
+        expectedAudience,
+      });
+      // Fast path: email ownership is cryptographically verified; skip OTP email.
+      const result = await completeAccountCreation({
+        name: submittedName,
+        email: submittedEmail,
+      });
+      return { status: 200, body: result };
+    } catch (err) {
+      // Log token verification failures before falling back to standard email verification.
+      console.error('Email verification token check failed:', err);
+    }
+  }
+
+  // Fallback path: send standard OTP code or magic link email to submittedEmail.
+  const fallbackResult = await sendTraditionalVerificationEmail({
+    name: submittedName,
+    email: submittedEmail,
+  });
+  return { status: 200, body: fallbackResult };
+}
+
+function setSecurityHeaders(res) {
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  res.setHeader('X-Frame-Options', 'SAMEORIGIN');
+  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
+  res.setHeader('Cross-Origin-Opener-Policy', 'same-origin-allow-popups');
+}
+
+export const server = createServer(async (req, res) => {
+  setSecurityHeaders(res);
+
+  const url = new URL(req.url || '/', `http://${req.headers.host || 'localhost'}`);
+
+  if (req.method === 'GET' && url.pathname === '/logout') {
+    res.setHeader('Clear-Site-Data', '"cookies", "storage", "cache"');
+    res.writeHead(302, { Location: '/' });
+    res.end();
+    return;
+  }
+
+  if (
+    req.method === 'POST' &&
+    (url.pathname === '/api/verify-email' || url.pathname === '/api/rewards/signup')
+  ) {
+    res.setHeader('Cache-Control', 'no-store');
+    const body = await parseFormBody(req);
+    const existingSessionId = getSessionIdFromHeaders(req.headers);
+
+    const { status, body: resultBody } = await handleSignupSubmission({
+      name: body.name,
+      email: body.email,
+      token: body.token,
+      sessionId: existingSessionId,
+      expectedAudience: RP_ORIGIN,
+    });
+
+    // Issue a fresh nonce in session state in case the client re-renders or retries
+    const { sessionId, nonce } = createSessionNonce(existingSessionId);
+    res.setHeader(
+      'Set-Cookie',
+      `${SESSION_COOKIE_NAME}=${encodeURIComponent(sessionId)}; SameSite=Lax; HttpOnly; Secure; Path=/`
+    );
+
+    const accept = req.headers.accept || '';
+    if (accept.includes('application/json')) {
+      res.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8' });
+      res.end(JSON.stringify({ ...resultBody, nextNonce: nonce }));
+      return;
+    }
+
+    // Standard HTML response for non-AJAX form submissions
+    const escapeHtml = (str = '') =>
+      String(str)
+        .replace(/&/g, '&amp;')
+        .replace(/</g, '&lt;')
+        .replace(/>/g, '&gt;')
+        .replace(/"/g, '&quot;')
+        .replace(/'/g, '&#39;');
+
+    res.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8' });
+    res.end(`<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>Daily Grind Rewards | Registration Status</title>
+</head>
+<body style="font-family: system-ui, sans-serif; max-width: 600px; margin: 4rem auto; padding: 0 1.5rem; color: #3e2723;">
+  <h1>${resultBody.verified ? 'Rewards Account Verified!' : 'Check Your Email'}</h1>
+  <p>${escapeHtml(resultBody.message || resultBody.error)}</p>
+  <p><a href="/" style="color: #4e342e; font-weight: 600;">Return to The Daily Grind</a></p>
+</body>
+</html>`);
+    return;
+  }
+
+  if (req.method === 'GET' && (url.pathname === '/' || url.pathname === '/index.html')) {
+    try {
+      const existingSessionId = getSessionIdFromHeaders(req.headers);
+      const { sessionId, nonce } = createSessionNonce(existingSessionId);
+
+      const rawHtml = await readFile(join(__dirname, 'index.html'), 'utf8');
+      const renderedHtml = rawHtml
+        .replaceAll('SERVER_GENERATED_PER_FORM_NONCE', nonce)
+        .replaceAll('DAILY_GRIND_EVP_ORIGIN_TRIAL_TOKEN', ORIGIN_TRIAL_TOKEN);
+
+      res.setHeader('Origin-Trial', ORIGIN_TRIAL_TOKEN);
+      res.setHeader('Cache-Control', 'no-store');
+      res.setHeader(
+        'Set-Cookie',
+        `${SESSION_COOKIE_NAME}=${encodeURIComponent(sessionId)}; SameSite=Lax; HttpOnly; Secure; Path=/`
+      );
+      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
+      res.end(renderedHtml);
+      return;
+    } catch (err) {
+      res.writeHead(500, { 'Content-Type': 'text/plain; charset=utf-8' });
+      res.end('Internal Server Error');
+      return;
+    }
+  }
+
+  // Serve any other static files if present
+  try {
+    const safePath = url.pathname.replace(/^\/+/, '');
+    if (safePath && !safePath.includes('..')) {
+      const content = await readFile(join(__dirname, safePath));
+      const ext = extname(safePath);
+      const mimeTypes = {
+        '.html': 'text/html; charset=utf-8',
+        '.js': 'application/javascript; charset=utf-8',
+        '.css': 'text/css; charset=utf-8',
+        '.json': 'application/json; charset=utf-8',
+        '.svg': 'image/svg+xml',
+      };
+      res.writeHead(200, { 'Content-Type': mimeTypes[ext] || 'application/octet-stream' });
+      res.end(content);
+      return;
+    }
+  } catch {}
+
+  res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' });
+  res.end('Not Found');
+});
+
+export { verifyEmailVerificationToken, createSessionNonce, consumeSessionNonce };
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
+  server.listen(PORT, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+  });
+}
diff --git a/verify-email.js b/verify-email.js
new file mode 100644
index 0000000..d6710e8
--- /dev/null
+++ b/verify-email.js
@@ -0,0 +1,164 @@
+import { createHash, randomBytes } from 'node:crypto';
+import dns from 'node:dns/promises';
+import { decodeSdJwtSync, SDJwtInstance } from '@sd-jwt/core';
+import { createRemoteJWKSet, importJWK, jwtVerify } from 'jose';
+
+// IETF draft-hardt-email-verification-02 (§3.3, §5.1.1) specifies RFC 9864 'Ed25519' and 'ES256'.
+// Include 'EdDSA' while live issuers and Chrome Origin Trial builds transition to 'Ed25519'.
+const ALLOWED_ALGS = ['Ed25519', 'EdDSA', 'ES256'];
+const normalizeAlg = (alg) => (alg === 'Ed25519' ? 'EdDSA' : alg);
+
+const hasher = (data, alg) =>
+  createHash(alg === 'sha-256' ? 'sha256' : alg).update(data).digest();
+
+// Server-side session store mapping sessionId -> { nonce, createdAt }
+const sessionStore = new Map();
+
+/**
+ * Generates a fresh cryptographic nonce (at least 128 bits of entropy)
+ * and stores it in server-side session state keyed by sessionId.
+ */
+export function createSessionNonce(existingSessionId) {
+  const sessionId = existingSessionId || randomBytes(24).toString('base64url');
+  const nonce = randomBytes(32).toString('base64url');
+  sessionStore.set(sessionId, {
+    nonce,
+    createdAt: Date.now(),
+  });
+  return { sessionId, nonce };
+}
+
+/**
+ * Atomically reads and deletes the single-use nonce from server-side session state.
+ */
+export function consumeSessionNonce(sessionId) {
+  if (!sessionId) return null;
+  const entry = sessionStore.get(sessionId);
+  sessionStore.delete(sessionId);
+  if (!entry) return null;
+  // Expire nonces older than 5 minutes
+  if (Date.now() - entry.createdAt > 5 * 60 * 1000) {
+    return null;
+  }
+  return entry.nonce;
+}
+
+/**
+ * Verifies an Email Verification Token (EVT + KB-JWT SD-JWT presentation)
+ * according to the Email Verification Protocol (EVP).
+ */
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience,
+}) {
+  // Step 1: Parse the SD-JWT claims and validate the email address
+  const decoded = decodeSdJwtSync(rawToken, hasher);
+  const evtPayload = decoded.jwt?.payload;
+  const iss = evtPayload?.iss;
+
+  if (!expectedNonce || !decoded.kbJwt || !iss || evtPayload.email_verified !== true) {
+    throw new Error('Missing nonce, KB-JWT, issuer, or email_verified !== true.');
+  }
+
+  // MANDATORY: Compare email addresses case-insensitively
+  if (evtPayload.email?.toLowerCase() !== submittedEmail.toLowerCase()) {
+    throw new Error('Submitted email does not match the EVT email claim.');
+  }
+
+  // Step 2: Validate DNS TXT delegation and load the issuer JWKS
+  const domain = submittedEmail.split('@')[1];
+  if (!domain) {
+    throw new Error('Invalid email domain.');
+  }
+
+  const txtRecords = (await dns.resolveTxt(`_email-verification.${domain}`)).map((r) =>
+    r.join('')
+  );
+  if (
+    !txtRecords.some(
+      (txt) => txt.startsWith('iss=') && `https://${txt.slice(4).trim()}` === iss
+    )
+  ) {
+    throw new Error(`Issuer "${iss}" is not delegated via DNS for "${domain}".`);
+  }
+
+  const discoveryUrl = new URL('/.well-known/email-verification', iss);
+  if (discoveryUrl.protocol !== 'https:') {
+    throw new Error('Issuer must use HTTPS.');
+  }
+
+  const metadata = await (await fetch(discoveryUrl)).json();
+  if (metadata.issuer !== iss || !metadata.jwks_uri?.startsWith('https://')) {
+    throw new Error('Invalid issuer metadata or non-HTTPS jwks_uri.');
+  }
+
+  const issuerJwks = createRemoteJWKSet(new URL(metadata.jwks_uri));
+
+  // Step 3: Verify the EVT signature and Key Binding JWT (KB-JWT)
+  const evtOptions = {
+    typ: 'ev+sd-jwt',
+    issuer: iss,
+    algorithms: ALLOWED_ALGS,
+    maxTokenAge: '5m',
+    clockTolerance: '1m',
+  };
+
+  const sdJwt = new SDJwtInstance({
+    hasher,
+    verifier: async (data, sig) => {
+      const compactEvt = `${data}.${sig}`;
+      try {
+        await jwtVerify(compactEvt, issuerJwks, evtOptions);
+      } catch (err) {
+        // When `kid` is omitted (e.g. Gmail) and multiple keys match in the JWKS,
+        // jose throws ERR_JWKS_MULTIPLE_MATCHING_KEYS, which yields each matching CryptoKey.
+        if (err?.code !== 'ERR_JWKS_MULTIPLE_MATCHING_KEYS') throw err;
+        let matched = false;
+        for await (const publicKey of err) {
+          try {
+            await jwtVerify(compactEvt, publicKey, evtOptions);
+            matched = true;
+            break;
+          } catch {}
+        }
+        if (!matched) throw err;
+      }
+      return true;
+    },
+    kbVerifier: async (data, sig) => {
+      const holderJwk = evtPayload.cnf?.jwk;
+      const holderAlg = holderJwk?.alg;
+      const kbAlg = decoded.kbJwt.header.alg;
+      if (
+        !holderAlg ||
+        !kbAlg ||
+        !ALLOWED_ALGS.includes(holderAlg) ||
+        !ALLOWED_ALGS.includes(kbAlg) ||
+        normalizeAlg(kbAlg) !== normalizeAlg(holderAlg)
+      ) {
+        throw new Error('Missing, disallowed, or mismatched KB-JWT algorithm.');
+      }
+      const holderKey = await importJWK(holderJwk, kbAlg);
+      await jwtVerify(`${data}.${sig}`, holderKey, {
+        typ: 'kb+jwt',
+        audience: expectedAudience,
+        algorithms: [kbAlg],
+        maxTokenAge: '5m',
+        clockTolerance: '1m',
+      });
+      return true;
+    },
+  });
+
+  const verified = await sdJwt.verify(rawToken, {
+    requiredClaimKeys: ['email', 'email_verified'],
+    keyBindingNonce: expectedNonce,
+    expectedKeyBindingAudience: expectedAudience,
+    keyBindingMaxAgeSeconds: 300,
+    skewSeconds: 60,
+  });
+
+  return verified;
+}
