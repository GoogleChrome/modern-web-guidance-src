diff --git a/evp-verifier.mjs b/evp-verifier.mjs
new file mode 100644
index 0000000..a032882
--- /dev/null
+++ b/evp-verifier.mjs
@@ -0,0 +1,663 @@
+import { createHash, randomUUID } from "node:crypto";
+import dns from "node:dns/promises";
+import net from "node:net";
+import { SDJwtInstance, decodeSdJwtSync } from "@sd-jwt/core";
+import { compactVerify, importJWK } from "jose";
+
+const ALLOWED_ASYMMETRIC_ALGS = ["Ed25519", "EdDSA", "ES256"];
+const MAX_JSON_BYTES = 64 * 1024; // 64 KB cap for issuer metadata / JWKS responses
+
+/**
+ * Checks whether a string is a canonical HTTPS bare origin (e.g. "https://accounts.google.com")
+ * with no trailing slash, path, query, fragment, userinfo, or default port suffix.
+ */
+export function isBareOrigin(value, allowLocalHttp = false) {
+  if (typeof value !== "string" || !value) return false;
+  try {
+    const parsed = new URL(value);
+    const isHttps = parsed.protocol === "https:";
+    const isLocalHttp =
+      allowLocalHttp &&
+      parsed.protocol === "http:" &&
+      (parsed.hostname === "localhost" || parsed.hostname === "127.0.0.1");
+    if (!isHttps && !isLocalHttp) return false;
+    if (parsed.username || parsed.password) return false;
+    if (parsed.pathname !== "/" || parsed.search || parsed.hash) return false;
+    return parsed.origin === value;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Validates that a delegated DNS domain from `_email-verification.<domain>` TXT (`iss=<domain>`)
+ * is a safe canonical DNS hostname without protocol, path, or IP literals.
+ */
+export function isValidDnsIssuerDomain(domain) {
+  if (typeof domain !== "string" || !domain || domain.length > 253) return false;
+  if (net.isIP(domain) !== 0) return false;
+  const domainRegex = /^(?!-)[A-Za-z0-9-]{1,63}(?<!-)(\.(?!-)[A-Za-z0-9-]{1,63}(?<!-))+$/;
+  return domainRegex.test(domain);
+}
+
+/**
+ * Checks whether a private/loopback IP or local hostname is targeted to prevent SSRF.
+ */
+function isPrivateOrReservedHost(hostname) {
+  const lower = hostname.toLowerCase();
+  if (
+    lower === "localhost" ||
+    lower.endsWith(".localhost") ||
+    lower.endsWith(".local") ||
+    lower.endsWith(".internal")
+  ) {
+    return true;
+  }
+  const ipVersion = net.isIP(lower.replace(/^\[|\]$/g, ""));
+  if (ipVersion === 4) {
+    const parts = lower.split(".").map(Number);
+    if (parts[0] === 10) return true;
+    if (parts[0] === 127) return true;
+    if (parts[0] === 0) return true;
+    if (parts[0] === 169 && parts[1] === 254) return true;
+    if (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31) return true;
+    if (parts[0] === 192 && parts[1] === 168) return true;
+    return true; // Disallow raw IPv4 literals for issuer endpoints
+  }
+  if (ipVersion === 6) {
+    return true; // Disallow raw IPv6 literals for issuer endpoints
+  }
+  return false;
+}
+
+/**
+ * Validates that a discovery or JWKS URL uses HTTPS and targets a public hostname.
+ */
+export function isSafeIssuerUrl(urlStr, allowPrivateForTests = false) {
+  if (typeof urlStr !== "string" || !urlStr) return false;
+  try {
+    const parsed = new URL(urlStr);
+    if (parsed.username || parsed.password) return false;
+    if (allowPrivateForTests && (parsed.protocol === "https:" || parsed.protocol === "http:")) {
+      return true;
+    }
+    if (parsed.protocol !== "https:") return false;
+    if (isPrivateOrReservedHost(parsed.hostname)) return false;
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Reads a JSON response with a strict byte limit to prevent memory exhaustion.
+ */
+export async function readBoundedJson(response, sourceLabel, maxBytes = MAX_JSON_BYTES) {
+  const reader = response.body?.getReader();
+  if (!reader) {
+    const text = await response.text();
+    if (Buffer.byteLength(text, "utf8") > maxBytes) {
+      throw new Error(`Response from ${sourceLabel} exceeded maximum allowed size (${maxBytes} bytes).`);
+    }
+    return JSON.parse(text);
+  }
+
+  const chunks = [];
+  let totalBytes = 0;
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    totalBytes += value.byteLength;
+    if (totalBytes > maxBytes) {
+      await reader.cancel();
+      throw new Error(`Response from ${sourceLabel} exceeded maximum allowed size (${maxBytes} bytes).`);
+    }
+    chunks.push(Buffer.from(value));
+  }
+  const rawText = Buffer.concat(chunks).toString("utf8");
+  return JSON.parse(rawText);
+}
+
+/**
+ * Validates standard JWT temporal claims (`iat` required, optional `exp`, and freshness window).
+ */
+export function validateClaims(payload, maxAgeSeconds = 300, clockSkewSeconds = 60, nowSeconds = Math.floor(Date.now() / 1000)) {
+  const exp = typeof payload.exp === "number" ? payload.exp : undefined;
+  const iat = typeof payload.iat === "number" ? payload.iat : undefined;
+
+  if (exp !== undefined && nowSeconds > exp + clockSkewSeconds) {
+    throw new Error(`The token has expired (exp: ${exp}, current: ${nowSeconds}).`);
+  }
+  if (iat === undefined) {
+    throw new Error("Required issued-at ('iat') claim is missing.");
+  }
+  if (exp !== undefined && iat >= exp) {
+    throw new Error(`Token timestamps are inconsistent (iat: ${iat} >= exp: ${exp}).`);
+  }
+  const age = nowSeconds - iat;
+  if (age > maxAgeSeconds + clockSkewSeconds) {
+    throw new Error(`Token is too old (issued ${age} seconds ago, max limit: ${maxAgeSeconds}s).`);
+  }
+  if (age < -clockSkewSeconds) {
+    throw new Error(`Token has a future issuance timestamp (iat: ${iat}, current: ${nowSeconds}).`);
+  }
+}
+
+/**
+ * Normalizes algorithm names and imports a JWK for verification with `jose`,
+ * supporting both RFC 9864 `Ed25519` and `EdDSA` identifiers as well as `ES256`.
+ */
+async function importVerificationJwk(jwk, fallbackAlg) {
+  const algToUse = jwk.alg || fallbackAlg;
+  try {
+    return await importJWK(jwk, algToUse);
+  } catch (err) {
+    if (algToUse === "Ed25519") {
+      return await importJWK({ ...jwk, alg: "EdDSA" }, "EdDSA");
+    }
+    if (algToUse === "EdDSA") {
+      return await importJWK({ ...jwk, alg: "Ed25519" }, "Ed25519");
+    }
+    throw err;
+  }
+}
+
+/**
+ * Verifies a compact JWS signature while tolerating `Ed25519` <-> `EdDSA` header algorithm variations.
+ */
+async function verifyJwsWithKey(compactJws, pubKey) {
+  try {
+    await compactVerify(compactJws, pubKey);
+    return true;
+  } catch (err) {
+    // Some versions of jose check the JWS protected header `alg` string strictly against "EdDSA" or "Ed25519"
+    const parts = compactJws.split(".");
+    if (parts.length === 3) {
+      const headerJson = JSON.parse(Buffer.from(parts[0], "base64url").toString("utf8"));
+      if (headerJson.alg === "Ed25519" || headerJson.alg === "EdDSA") {
+        const publicKeyObject = await import("node:crypto").then((m) => m.createPublicKey({ key: pubKey, format: "jwk" }).catch(() => null));
+        if (publicKeyObject) {
+          const { verify } = await import("node:crypto");
+          const signingInput = Buffer.from(`${parts[0]}.${parts[1]}`, "utf8");
+          const signature = Buffer.from(parts[2], "base64url");
+          if (verify(null, signingInput, publicKeyObject, signature)) {
+            return true;
+          }
+        }
+      }
+    }
+    throw err;
+  }
+}
+
+/**
+ * Creates a fresh 6-step verification trace structure for diagnostics and UI rendering.
+ */
+export function createVerificationTrace() {
+  return [
+    {
+      step: 1,
+      name: "Step 1: Parse the SD-JWT+KB token",
+      description:
+        "Parse the submitted token into its Issuer-signed Email Verification Token (EVT) and Key Binding JWT (KB-JWT) components.",
+      status: "pending",
+    },
+    {
+      step: 2,
+      name: "Step 2: Validate expected values and session claims",
+      description:
+        "Verify email_verified === true, case-insensitive email match, session nonce, relying party origin audience, and token freshness.",
+      status: "pending",
+    },
+    {
+      step: 3,
+      name: "Step 3: Verify DNS delegation (_email-verification.<domain>)",
+      description:
+        "Query the email domain's _email-verification TXT record to confirm it delegates verification authority to the token issuer.",
+      status: "pending",
+    },
+    {
+      step: 4,
+      name: "Step 4: Discover issuer metadata & fetch JWKS",
+      description:
+        "Fetch https://<issuer>/.well-known/email-verification, verify the issuer identifier, and download the public JWKS keys.",
+      status: "pending",
+    },
+    {
+      step: 5,
+      name: "Step 5: Verify Issuer EVT cryptographic signature",
+      description:
+        "Verify the EVT signature against the issuer's JWKS (matching by kid if present, or iterating through candidate keys).",
+      status: "pending",
+    },
+    {
+      step: 6,
+      name: "Step 6: Verify Browser Key Binding JWT (KB-JWT)",
+      description:
+        "Verify the KB-JWT signature using the browser's ephemeral public key in cnf.jwk, plus audience, nonce, and sd_hash binding.",
+      status: "pending",
+    },
+  ];
+}
+
+/**
+ * Full 6-step server-side Email Verification Protocol (EVP) token verifier.
+ *
+ * @param {object} options
+ * @param {string} options.rawToken - The raw `<EVT>~<KB-JWT>` string from `input[autocomplete="email-verification-token"]`
+ * @param {string} options.submittedEmail - The email address submitted in the registration form
+ * @param {string} options.expectedNonce - The server-generated session nonce bound to the form
+ * @param {string} options.expectedAudience - The Relying Party's expected origin (e.g. `https://...` or request origin)
+ * @param {string[]} [options.allowedAudiences] - Additional acceptable audience origins (e.g. behind reverse proxies)
+ * @param {typeof dns.resolveTxt} [options.resolveTxt] - Custom DNS TXT resolver (defaults to `dns.resolveTxt`)
+ * @param {typeof fetch} [options.fetchImpl] - Custom fetch implementation (defaults to global `fetch`)
+ * @param {boolean} [options.allowPrivateUrls] - Allow private/localhost issuer URLs in unit tests
+ * @param {number} [options.maxAgeSeconds] - Maximum token age in seconds (default 300)
+ * @param {number} [options.clockSkewSeconds] - Allowed clock skew in seconds (default 60)
+ */
+export async function verifyEmailVerificationToken({
+  rawToken,
+  submittedEmail,
+  expectedNonce,
+  expectedAudience,
+  allowedAudiences = [],
+  resolveTxt = (hostname) => dns.resolveTxt(hostname),
+  fetchImpl = globalThis.fetch,
+  allowPrivateUrls = false,
+  maxAgeSeconds = 300,
+  clockSkewSeconds = 60,
+}) {
+  const trace = createVerificationTrace();
+
+  try {
+    const cleanEmail = (submittedEmail || "").trim();
+    const cleanToken = (rawToken || "").trim();
+
+    if (!cleanEmail || !cleanEmail.includes("@")) {
+      throw new Error("A valid email address is required.");
+    }
+    if (!cleanToken) {
+      throw new Error(
+        "No browser email verification token was provided. Please use a browser that supports the Email Verification Protocol and ensure you are signed in to your email provider.",
+      );
+    }
+
+    // =========================================================================
+    // STEP 1: Parse the SD-JWT+KB token (<EVT>~<KB-JWT>)
+    // =========================================================================
+    trace[0].inputSent = { rawTokenLength: cleanToken.length };
+
+    const hasher = (data, alg) =>
+      createHash(!alg || alg.toLowerCase() === "sha-256" ? "sha256" : alg)
+        .update(data)
+        .digest();
+
+    let decodedSdJwt;
+    try {
+      decodedSdJwt = decodeSdJwtSync(cleanToken, hasher);
+    } catch (err) {
+      trace[0].status = "failed";
+      throw new Error(`Invalid SD-JWT+KB token format: ${err.message}`, { cause: err });
+    }
+
+    if (!decodedSdJwt.kbJwt) {
+      trace[0].status = "failed";
+      throw new Error("Missing Key Binding JWT (KB-JWT) component in verification token.");
+    }
+
+    const evtHeader = decodedSdJwt.jwt.header || {};
+    const evtPayload = decodedSdJwt.jwt.payload || {};
+    const kbHeader = decodedSdJwt.kbJwt.header || {};
+    const kbPayload = decodedSdJwt.kbJwt.payload || {};
+
+    if (evtHeader.typ !== "evt+jwt") {
+      trace[0].status = "failed";
+      throw new Error(`Invalid EVT 'typ' header: expected 'evt+jwt', received '${evtHeader.typ || "none"}'.`);
+    }
+
+    if (kbHeader.typ !== "kb+jwt") {
+      trace[0].status = "failed";
+      throw new Error(`Invalid KB-JWT 'typ' header: expected 'kb+jwt', received '${kbHeader.typ || "none"}'.`);
+    }
+
+    const iss = evtPayload.iss;
+    if (!iss || typeof iss !== "string") {
+      trace[0].status = "failed";
+      throw new Error("EVT is missing the required issuer ('iss') claim.");
+    }
+
+    if (!isBareOrigin(iss, allowPrivateUrls)) {
+      trace[0].status = "failed";
+      throw new Error(`Security Exception: EVT 'iss' claim ('${iss}') must be a bare HTTPS origin.`);
+    }
+
+    trace[0].outputReceived = {
+      evtHeader,
+      evtPayload,
+      kbHeader,
+      kbPayload,
+      disclosuresCount: decodedSdJwt.disclosures?.length ?? 0,
+    };
+    trace[0].status = "success";
+
+    // =========================================================================
+    // STEP 2: Validate expected values and session claims
+    // =========================================================================
+    const candidateAudiences = Array.from(
+      new Set([expectedAudience, ...allowedAudiences].filter(Boolean)),
+    );
+
+    trace[1].inputSent = {
+      submittedEmail: cleanEmail,
+      tokenEmail: evtPayload.email,
+      emailVerifiedClaim: evtPayload.email_verified,
+      expectedNonce: expectedNonce || null,
+      tokenNonce: kbPayload.nonce || null,
+      expectedAudiences: candidateAudiences,
+      tokenAudience: kbPayload.aud || null,
+    };
+
+    if (!expectedNonce) {
+      trace[1].status = "failed";
+      throw new Error(
+        "Security Exception: Missing or expired session nonce. Please reload the page and submit the form again.",
+      );
+    }
+
+    if (evtPayload.email_verified !== true) {
+      trace[1].status = "failed";
+      throw new Error("Security Exception: The token 'email_verified' claim must be explicitly true.");
+    }
+
+    if (
+      typeof evtPayload.email !== "string" ||
+      evtPayload.email.toLowerCase() !== cleanEmail.toLowerCase()
+    ) {
+      trace[1].status = "failed";
+      throw new Error(
+        `Email mismatch: Form submitted '${cleanEmail}', but verification token is for '${evtPayload.email}'.`,
+      );
+    }
+
+    if (kbPayload.nonce !== expectedNonce) {
+      trace[1].status = "failed";
+      throw new Error("Security Exception: KB-JWT 'nonce' claim does not match the active session nonce.");
+    }
+
+    if (
+      typeof kbPayload.aud !== "string" ||
+      (candidateAudiences.length > 0 && !candidateAudiences.includes(kbPayload.aud))
+    ) {
+      trace[1].status = "failed";
+      throw new Error(
+        `Security Exception: KB-JWT 'aud' claim ('${kbPayload.aud}') does not match expected origin ('${expectedAudience}').`,
+      );
+    }
+
+    // Validate temporal claims on both EVT and KB-JWT early
+    try {
+      validateClaims(evtPayload, maxAgeSeconds, clockSkewSeconds);
+      validateClaims(kbPayload, maxAgeSeconds, clockSkewSeconds);
+    } catch (timeErr) {
+      trace[1].status = "failed";
+      throw timeErr;
+    }
+
+    trace[1].outputReceived = {
+      emailMatched: true,
+      emailVerified: true,
+      nonceMatched: true,
+      audienceMatched: kbPayload.aud,
+      timestampsValid: true,
+    };
+    trace[1].status = "success";
+
+    // =========================================================================
+    // STEP 3: Verify DNS delegation (_email-verification.<domain>)
+    // =========================================================================
+    const emailDomain = cleanEmail.split("@")[1]?.toLowerCase();
+    const dnsTarget = `_email-verification.${emailDomain}`;
+    trace[2].serverCalled = `DNS TXT ${dnsTarget}`;
+    trace[2].inputSent = { emailDomain, dnsLookupTarget: dnsTarget, expectedIssuer: iss };
+
+    let records;
+    try {
+      records = await resolveTxt(dnsTarget);
+    } catch (dnsErr) {
+      trace[2].status = "failed";
+      throw new Error(
+        `DNS delegation lookup failed for ${dnsTarget}: ${dnsErr.message}`,
+        { cause: dnsErr },
+      );
+    }
+
+    let isAuthoritative = false;
+    const discoveredIssuers = [];
+
+    for (const record of records) {
+      const txt = Array.isArray(record) ? record.join("") : String(record);
+      if (txt.startsWith("iss=")) {
+        const delegatedValue = txt.substring(4).trim();
+        if (!isValidDnsIssuerDomain(delegatedValue) && !allowPrivateUrls) {
+          continue;
+        }
+        const derivedOrigin = delegatedValue.startsWith("https://") || delegatedValue.startsWith("http://")
+          ? delegatedValue
+          : `https://${delegatedValue}`;
+        discoveredIssuers.push(derivedOrigin);
+        if (iss === derivedOrigin) {
+          isAuthoritative = true;
+          break;
+        }
+      }
+    }
+
+    trace[2].outputReceived = {
+      dnsTxtRecords: records,
+      discoveredIssuers,
+      authoritativeMatch: isAuthoritative,
+    };
+
+    if (!isAuthoritative) {
+      trace[2].status = "failed";
+      throw new Error(
+        `Security Exception: Issuer '${iss}' is not authorized by DNS TXT record at ${dnsTarget}.`,
+      );
+    }
+    trace[2].status = "success";
+
+    // =========================================================================
+    // STEP 4: Issuer discovery & JWKS fetching
+    // =========================================================================
+    const discoveryUrl = `${iss}/.well-known/email-verification`;
+    trace[3].serverCalled = discoveryUrl;
+    trace[3].inputSent = { discoveryUrl };
+
+    if (!isSafeIssuerUrl(discoveryUrl, allowPrivateUrls)) {
+      trace[3].status = "failed";
+      throw new Error(`Security Exception: Unsafe or invalid issuer discovery URL '${discoveryUrl}'.`);
+    }
+
+    const metadataRes = await fetchImpl(discoveryUrl, {
+      redirect: "error",
+      signal: AbortSignal.timeout(5000),
+      headers: { Accept: "application/json" },
+    });
+
+    if (!metadataRes.ok) {
+      trace[3].status = "failed";
+      throw new Error(
+        `Failed to fetch issuer metadata from ${discoveryUrl} (HTTP ${metadataRes.status}).`,
+      );
+    }
+
+    const metadata = await readBoundedJson(metadataRes, discoveryUrl);
+    if (metadata.issuer && metadata.issuer !== iss) {
+      trace[3].status = "failed";
+      throw new Error(
+        `Issuer metadata mismatch at ${discoveryUrl}: expected '${iss}', got '${metadata.issuer}'.`,
+      );
+    }
+
+    const jwksUri = metadata.jwks_uri;
+    if (!jwksUri || !isSafeIssuerUrl(jwksUri, allowPrivateUrls)) {
+      trace[3].status = "failed";
+      throw new Error(`Issuer metadata at ${discoveryUrl} is missing a valid HTTPS 'jwks_uri'.`);
+    }
+
+    trace[3].serverCalled = `${discoveryUrl} -> ${jwksUri}`;
+    const jwksRes = await fetchImpl(jwksUri, {
+      redirect: "error",
+      signal: AbortSignal.timeout(5000),
+      headers: { Accept: "application/json" },
+    });
+
+    if (!jwksRes.ok) {
+      trace[3].status = "failed";
+      throw new Error(`Failed to fetch issuer JWKS from ${jwksUri} (HTTP ${jwksRes.status}).`);
+    }
+
+    const jwksData = await readBoundedJson(jwksRes, jwksUri);
+    if (!jwksData || !Array.isArray(jwksData.keys) || jwksData.keys.length === 0) {
+      trace[3].status = "failed";
+      throw new Error(`Issuer JWKS from ${jwksUri} contains no keys.`);
+    }
+
+    trace[3].outputReceived = {
+      issuerMetadata: metadata,
+      jwksKeyCount: jwksData.keys.length,
+    };
+    trace[3].status = "success";
+
+    // =========================================================================
+    // STEP 5 & 6: Cryptographic Signature & Key Binding Verification
+    // =========================================================================
+    const evtAlg = evtHeader.alg;
+    const kbAlg = kbHeader.alg;
+
+    if (!evtAlg || !ALLOWED_ASYMMETRIC_ALGS.includes(evtAlg)) {
+      trace[4].status = "failed";
+      throw new Error(
+        `Security Exception: Unsupported or insecure EVT signing algorithm '${evtAlg || "none"}'.`,
+      );
+    }
+
+    if (!kbAlg || !ALLOWED_ASYMMETRIC_ALGS.includes(kbAlg)) {
+      trace[5].status = "failed";
+      throw new Error(
+        `Security Exception: Unsupported or insecure KB-JWT signing algorithm '${kbAlg || "none"}'.`,
+      );
+    }
+
+    const browserJwk = evtPayload.cnf?.jwk;
+    if (!browserJwk || typeof browserJwk !== "object") {
+      trace[5].status = "failed";
+      throw new Error("EVT is missing the required 'cnf.jwk' ephemeral browser public key.");
+    }
+
+    if (
+      browserJwk.alg &&
+      browserJwk.alg !== kbAlg &&
+      !(
+        (browserJwk.alg === "Ed25519" && kbAlg === "EdDSA") ||
+        (browserJwk.alg === "EdDSA" && kbAlg === "Ed25519")
+      )
+    ) {
+      trace[5].status = "failed";
+      throw new Error(
+        `Security Exception: KB-JWT algorithm ('${kbAlg}') does not match EVT cnf.jwk.alg ('${browserJwk.alg}').`,
+      );
+    }
+
+    trace[4].inputSent = { evtAlg, kid: evtHeader.kid || "(omitted - trial all keys)" };
+    trace[5].inputSent = { kbAlg, cnfJwkKty: browserJwk.kty, cnfJwkCrv: browserJwk.crv };
+
+    const sdJwt = new SDJwtInstance({ hasher });
+    sdJwt.config({
+      hasher,
+      verifier: async (data, sig) => {
+        const compactEvt = `${data}.${sig}`;
+        const kid = evtHeader.kid;
+        const keysToTry = kid
+          ? jwksData.keys.filter((k) => k.kid === kid)
+          : jwksData.keys;
+
+        for (const jwk of keysToTry) {
+          try {
+            const pubKey = await importVerificationJwk(jwk, evtAlg);
+            await verifyJwsWithKey(compactEvt, pubKey);
+            trace[4].outputReceived = {
+              evtSignatureVerified: true,
+              matchedKeyId: jwk.kid || "(unlabeled key)",
+            };
+            trace[4].status = "success";
+            return true;
+          } catch {
+            // Try next candidate key in JWKS
+          }
+        }
+        return false;
+      },
+      kbVerifier: async (data, sig) => {
+        try {
+          const pubKey = await importVerificationJwk(browserJwk, kbAlg);
+          await verifyJwsWithKey(`${data}.${sig}`, pubKey);
+          return true;
+        } catch {
+          return false;
+        }
+      },
+    });
+
+    let verifyResult;
+    try {
+      verifyResult = await sdJwt.verify(cleanToken, {
+        kb: {
+          expectedNonce,
+          expectedAudience: kbPayload.aud,
+          required: true,
+        },
+      });
+    } catch (cryptoErr) {
+      if (trace[4].status !== "success") {
+        trace[4].status = "failed";
+      } else {
+        trace[5].status = "failed";
+      }
+      throw new Error(`Cryptographic verification failed: ${cryptoErr.message}`, {
+        cause: cryptoErr,
+      });
+    }
+
+    trace[5].outputReceived = {
+      kbSignatureVerified: true,
