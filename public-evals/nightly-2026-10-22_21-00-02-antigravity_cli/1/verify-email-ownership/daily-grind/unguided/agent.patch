+      evtPayload: verifyResult.payload,
+      kbHeader,
+      kbPayload,
+      trace,
+    };
+  } catch (err) {
+    const failedStep = trace.find((s) => s.status === "failed" || s.status === "pending");
+    if (failedStep) {
+      failedStep.status = "failed";
+      failedStep.error = err instanceof Error ? err.message : String(err);
+    }
+    err.trace = trace;
+    throw err;
+  }
