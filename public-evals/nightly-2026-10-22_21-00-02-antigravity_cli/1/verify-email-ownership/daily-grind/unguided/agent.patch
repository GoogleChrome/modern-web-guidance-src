+import fs from "node:fs/promises";
+import http from "node:http";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  generateSessionNonce,
+  verifyEmailVerificationToken,
+} from "./evp-verifier.mjs";
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+export const NONCE_COOKIE_NAME = "evp_rp_nonce";
+const MAX_BODY_BYTES = 128 * 1024; // 128 KB max request body
+
+// In-memory store for verified Daily Grind Rewards members and active nonces
+export const rewardsMembers = new Map();
+const activeNonces = new Set();
+
+const MIME_TYPES = {
+  ".html": "text/html; charset=utf-8",
+  ".css": "text/css; charset=utf-8",
+  ".js": "application/javascript; charset=utf-8",
+  ".mjs": "application/javascript; charset=utf-8",
+  ".json": "application/json; charset=utf-8",
+  ".svg": "image/svg+xml",
+  ".png": "image/png",
+  ".jpg": "image/jpeg",
+  ".jpeg": "image/jpeg",
+  ".webp": "image/webp",
+  ".ico": "image/x-icon",
+};
+
+/**
+ * Parses HTTP request `Cookie` header into a plain key-value object.
+ */
+export function parseCookies(cookieHeader = "") {
+  const cookies = {};
+  if (!cookieHeader) return cookies;
+  for (const pair of cookieHeader.split(";")) {
+    const idx = pair.indexOf("=");
+    if (idx === -1) continue;
+    const key = pair.slice(0, idx).trim();
+    const val = pair.slice(idx + 1).trim();
+    if (key) {
+      try {
+        cookies[key] = decodeURIComponent(val);
+      } catch {
+        cookies[key] = val;
+      }
+    }
+  }
+  return cookies;
+}
+
+/**
+ * Formats a Set-Cookie header string for the EVP relying party session nonce.
+ */
+export function buildNonceCookie(nonce, isSecure = false) {
+  const parts = [
+    `${NONCE_COOKIE_NAME}=${encodeURIComponent(nonce)}`,
+    "Path=/",
+    "HttpOnly",
+    "SameSite=Lax",
+    "Max-Age=300",
+  ];
+  if (isSecure) {
+    parts.push("Secure");
+  }
+  return parts.join("; ");
+}
+
+/**
+ * Formats a Set-Cookie header string that immediately expires/consumes the session nonce.
+ */
+export function buildClearNonceCookie() {
+  return `${NONCE_COOKIE_NAME}=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0`;
+}
+
+/**
+ * Escapes HTML special characters for safe server-side HTML rendering.
+ */
+export function escapeHtml(value = "") {
+  return String(value)
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+/**
+ * Determines the Relying Party origin from the incoming HTTP request.
+ */
+export function getRequestOrigins(req) {
+  const forwardedProto = (req.headers["x-forwarded-proto"] || "").split(",")[0].trim();
+  const forwardedHost = (req.headers["x-forwarded-host"] || "").split(",")[0].trim();
+  const host = forwardedHost || req.headers.host || "localhost:11222";
+  const proto = forwardedProto || (req.socket?.encrypted ? "https" : "http");
+
+  const primaryOrigin = `${proto}://${host}`;
+  const candidates = new Set([primaryOrigin]);
+
+  if (req.headers.origin) {
+    candidates.add(req.headers.origin);
+  }
+  // Also tolerate https://<host> and http://<host> when running behind local/cloud proxies
+  candidates.add(`https://${host}`);
+  candidates.add(`http://${host}`);
+
+  return {
+    primaryOrigin,
+    allowedAudiences: Array.from(candidates),
+    isSecure: proto === "https",
+  };
+}
+
+/**
+ * Reads and parses the incoming request body (supports JSON and application/x-www-form-urlencoded).
+ */
+async function parseRequestBody(req) {
+  const chunks = [];
+  let totalBytes = 0;
+
+  for await (const chunk of req) {
+    totalBytes += chunk.length;
+    if (totalBytes > MAX_BODY_BYTES) {
+      throw new Error("Request body too large.");
+    }
+    chunks.push(chunk);
+  }
+
+  const rawBody = Buffer.concat(chunks).toString("utf8");
+  const contentType = (req.headers["content-type"] || "").toLowerCase();
+
+  if (contentType.includes("application/json")) {
+    return rawBody ? JSON.parse(rawBody) : {};
+  }
+
+  // Default to URL-encoded form parsing
+  const params = new URLSearchParams(rawBody);
+  const data = {};
+  for (const [key, value] of params.entries()) {
+    data[key] = value;
+  }
+  return data;
+}
+
+/**
+ * Renders server-side verification feedback banner HTML to inject into `index.html` when
+ * a form is submitted via standard HTML POST without JavaScript interception.
+ */
+function renderServerStatusBanner({ status, member, error, trace, submittedFields = {} }) {
+  if (!status) return "";
+
+  const traceHtml = Array.isArray(trace)
+    ? `<div class="evp-trace-box">
+        <h4>Browser-Assisted Email Verification Protocol (EVP) Trace</h4>
+        <ol class="evp-trace-list">
+          ${trace
+            .map(
+              (step) => `
+            <li class="evp-trace-step ${escapeHtml(step.status)}">
+              <div class="evp-trace-step-header">
+                <strong>${escapeHtml(step.name)}</strong>
+                <span class="evp-badge ${escapeHtml(step.status)}">${escapeHtml(step.status)}</span>
+              </div>
+              <p>${escapeHtml(step.description)}</p>
+              ${step.error ? `<p class="evp-trace-error">${escapeHtml(step.error)}</p>` : ""}
+            </li>`,
+            )
+            .join("")}
+        </ol>
+      </div>`
+    : "";
+
+  if (status === "verified" && member) {
+    return `
+      <div id="server-verification-result" class="rewards-alert success" role="status" aria-live="polite">
+        <div class="rewards-alert-header">
+          <span class="rewards-badge-verified">✓ Cryptographically Verified via Browser EVP</span>
+          <h3>Welcome to Daily Grind Rewards, ${escapeHtml(member.fullName)}!</h3>
+        </div>
+        <p>
+          Your email address <strong>${escapeHtml(member.email)}</strong> was verified directly with
+          <code>${escapeHtml(member.issuer)}</code> using an SD-JWT+KB token—no one-time passcode or magic link email needed!
+        </p>
+        <div class="rewards-member-card">
+          <div><strong>Member ID:</strong> <code>${escapeHtml(member.memberId)}</code></div>
+          <div><strong>Welcome Bonus:</strong> <span>${escapeHtml(String(member.points))} Beans (Free Handcrafted Drink Unlocked)</span></div>
+          <div><strong>Favorite Drink:</strong> <span>${escapeHtml(member.favoriteDrink || "Maple Oat Latte")}</span></div>
+        </div>
+        ${traceHtml}
+      </div>
+    `;
+  }
+
+  return `
+    <div id="server-verification-result" class="rewards-alert error" role="alert" aria-live="assertive">
+      <div class="rewards-alert-header">
+        <span class="rewards-badge-error">⚠️ Verification Failed</span>
+        <h3>Could not verify email ownership</h3>
+      </div>
+      <p>${escapeHtml(error || "Unable to verify email verification token.")}</p>
+      ${traceHtml}
+    </div>
+  `;
+}
+
+/**
+ * Loads `index.html` and injects the fresh per-render cryptographic session `nonce`
+ * (and optional server-rendered verification banner).
+ */
+async function renderIndexHtml(nonce, bannerState = null) {
+  const indexPath = path.join(__dirname, "index.html");
+  let html = await fs.readFile(indexPath, "utf8");
+
+  // Inject the dynamic server-generated nonce into the EVP hidden token input
+  html = html.replace(/__EVP_SERVER_NONCE__/g, escapeHtml(nonce));
+
+  const bannerHtml = bannerState ? renderServerStatusBanner(bannerState) : "";
+  html = html.replace("<!-- __EVP_SERVER_RESULT__ -->", bannerHtml);
+
+  return html;
+}
+
+/**
+ * Handles the rewards sign-up verification request (shared by JSON fetch and HTML form POST).
+ */
+export async function processRewardsSignup({
+  body,
+  cookies,
+  primaryOrigin,
+  allowedAudiences,
+  verifierOptions = {},
+}) {
+  const fullName = (body.fullName || body.name || "Coffee Lover").trim();
+  const email = (body.email || body["email-address"] || "").trim();
+  const favoriteDrink = (body.favoriteDrink || "Maple Oat Latte").trim();
+  const birthday = (body.birthday || "").trim();
+
+  // Accept token from `token` or `evt` field
+  const rawToken = (body.token || body.evt || "").trim();
+
+  // Retrieve the session nonce from the HttpOnly cookie (or tracked active nonces)
+  const cookieNonce = cookies[NONCE_COOKIE_NAME];
+  const expectedNonce = cookieNonce || (activeNonces.has(body.nonce) ? body.nonce : undefined);
+
+  if (expectedNonce) {
+    activeNonces.delete(expectedNonce);
+  }
+
+  const verification = await verifyEmailVerificationToken({
+    rawToken,
+    submittedEmail: email,
+    expectedNonce,
+    expectedAudience: primaryOrigin,
+    allowedAudiences,
+    ...verifierOptions,
+  });
+
+  const member = {
+    memberId: `DG-${Math.random().toString(36).substring(2, 8).toUpperCase()}`,
+    fullName,
+    email: verification.email,
+    tokenEmail: verification.tokenEmail,
+    issuer: verification.issuer,
+    favoriteDrink,
+    birthday: birthday || null,
+    points: 150,
+    tier: "Gold Bean",
+    verifiedVia: "W3C-EVP-SD-JWT+KB",
+    verifiedAt: new Date().toISOString(),
+  };
+
+  rewardsMembers.set(verification.email.toLowerCase(), member);
+
+  return {
+    ok: true,
+    verified: true,
+    member,
+    verification: {
+      email: verification.email,
+      issuer: verification.issuer,
+      evtHeader: verification.evtHeader,
+      evtPayload: verification.evtPayload,
+      kbHeader: verification.kbHeader,
+      kbPayload: verification.kbPayload,
+      trace: verification.trace,
+    },
+  };
+}
+
+/**
+ * Creates the HTTP request handler for The Daily Grind web server and EVP verification endpoints.
+ */
+export function createAppHandler(verifierOptions = {}) {
+  return async (req, res) => {
+    try {
+      const { primaryOrigin, allowedAudiences, isSecure } = getRequestOrigins(req);
+      const url = new URL(req.url || "/", primaryOrigin);
+      const pathname = url.pathname;
+      const method = (req.method || "GET").toUpperCase();
+      const cookies = parseCookies(req.headers.cookie);
+
+      // 1. Fresh Nonce API Endpoint (`GET /api/rewards/nonce` or `GET /api/nonce`)
+      if (method === "GET" && (pathname === "/api/rewards/nonce" || pathname === "/api/nonce")) {
+        const nonce = generateSessionNonce();
+        activeNonces.add(nonce);
+        res.writeHead(200, {
+          "Content-Type": "application/json; charset=utf-8",
+          "Cache-Control": "no-store, no-cache, must-revalidate",
+          "Set-Cookie": buildNonceCookie(nonce, isSecure),
+        });
+        res.end(JSON.stringify({ nonce }));
+        return;
+      }
+
+      // 2. Rewards Sign-Up & EVP Verification Endpoint
+      // Supports `POST /api/rewards/signup`, `POST /api/verify-email`, `POST /rewards/signup`, and `POST /`
+      const isSignupPost =
+        method === "POST" &&
+        (pathname === "/api/rewards/signup" ||
+          pathname === "/api/verify-email" ||
+          pathname === "/rewards/signup" ||
+          pathname === "/signup" ||
+          pathname === "/");
+
+      if (isSignupPost) {
+        const body = await parseRequestBody(req);
+        const acceptsJson =
+          (req.headers.accept || "").includes("application/json") ||
+          (req.headers["content-type"] || "").includes("application/json") ||
+          pathname.startsWith("/api/");
+
+        //Always rotate/issue a new nonce for subsequent attempts while consuming the previous one
+        const nextNonce = generateSessionNonce();
+        activeNonces.add(nextNonce);
+
+        try {
+          const result = await processRewardsSignup({
+            body,
+            cookies,
+            primaryOrigin,
+            allowedAudiences,
+            verifierOptions,
+          });
+
+          if (acceptsJson) {
+            res.writeHead(200, {
+              "Content-Type": "application/json; charset=utf-8",
+              "Cache-Control": "no-store",
+              "Set-Cookie": buildNonceCookie(nextNonce, isSecure),
+            });
+            res.end(
+              JSON.stringify({
+                ...result,
+                nextNonce,
+              }),
+            );
+            return;
+          }
+
+          const html = await renderIndexHtml(nextNonce, {
+            status: "verified",
+            member: result.member,
+            trace: result.verification.trace,
+          });
+          res.writeHead(200, {
+            "Content-Type": "text/html; charset=utf-8",
+            "Cache-Control": "no-store",
+            "Set-Cookie": buildNonceCookie(nextNonce, isSecure),
+          });
+          res.end(html);
+          return;
+        } catch (verifyErr) {
+          const errMsg = verifyErr instanceof Error ? verifyErr.message : "Email verification failed.";
+          const trace = verifyErr.trace || null;
+
+          if (acceptsJson) {
+            res.writeHead(400, {
+              "Content-Type": "application/json; charset=utf-8",
+              "Cache-Control": "no-store",
+              "Set-Cookie": buildNonceCookie(nextNonce, isSecure),
+            });
+            res.end(
+              JSON.stringify({
+                ok: false,
+                verified: false,
+                error: errMsg,
+                trace,
+                nextNonce,
+              }),
+            );
+            return;
+          }
+
+          const html = await renderIndexHtml(nextNonce, {
+            status: "error",
+            error: errMsg,
+            trace,
+          });
+          res.writeHead(400, {
+            "Content-Type": "text/html; charset=utf-8",
+            "Cache-Control": "no-store",
+            "Set-Cookie": buildNonceCookie(nextNonce, isSecure),
+          });
+          res.end(html);
+          return;
+        }
+      }
+
+      // 3. Homepage (`GET /` or `GET /index.html` or `GET /rewards`)
+      if (
+        method === "GET" &&
+        (pathname === "/" || pathname === "/index.html" || pathname === "/rewards")
+      ) {
+        const nonce = generateSessionNonce();
+        activeNonces.add(nonce);
+        const html = await renderIndexHtml(nonce);
+        res.writeHead(200, {
+          "Content-Type": "text/html; charset=utf-8",
+          "Cache-Control": "no-store, no-cache, must-revalidate",
+          "Set-Cookie": buildNonceCookie(nonce, isSecure),
+        });
+        res.end(html);
+        return;
+      }
+
+      // 4. Static Asset Serving (safe path resolution within workspace directory)
+      if (method === "GET" || method === "HEAD") {
+        const safeRelPath = path.normalize(pathname).replace(/^(\.\.(\/|\\|$))+/, "");
+        const filePath = path.join(__dirname, safeRelPath);
+        if (filePath.startsWith(__dirname)) {
+          try {
+            const stat = await fs.stat(filePath);
+            if (stat.isFile()) {
+              const ext = path.extname(filePath).toLowerCase();
+              const contentType = MIME_TYPES[ext] || "application/octet-stream";
+              const content = await fs.readFile(filePath);
+              res.writeHead(200, { "Content-Type": contentType });
+              res.end(method === "HEAD" ? undefined : content);
+              return;
+            }
+          } catch {
+            // Fall through to 404
+          }
+        }
+      }
+
+      res.writeHead(404, { "Content-Type": "application/json; charset=utf-8" });
+      res.end(JSON.stringify({ error: "Not Found" }));
+    } catch (err) {
+      res.writeHead(500, { "Content-Type": "application/json; charset=utf-8" });
+      res.end(
+        JSON.stringify({
+          ok: false,
+          error: err instanceof Error ? err.message : "Internal Server Error",
+        }),
+      );
+    }
+  };
+}
+
+// Start the HTTP server only when executed directly as the main entrypoint
+if (process.argv[1] && path.resolve(process.argv[1]) === __filename) {
+  const port = Number(process.env.PORT) || 11222;
+  const server = http.createServer(createAppHandler());
+  server.listen(port, () => {
+    console.log(`The Daily Grind server listening on http://localhost:${port}`);
+  });
+}
