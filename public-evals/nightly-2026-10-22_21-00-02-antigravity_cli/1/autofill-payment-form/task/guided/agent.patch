   </main>
 
+  <script>
+    const paymentForm = document.getElementById('payment-form');
+    const payBtn = document.getElementById('pay-btn');
+    const fields = [
+      { id: 'cc-number', errorId: 'cc-number-error', msg: 'Please enter a valid 13 to 19 digit card number.' },
+      { id: 'cc-name', errorId: 'cc-name-error', msg: 'Please enter the name as it appears on your card.' },
+      { id: 'cc-exp', errorId: 'cc-exp-error', msg: 'Please enter the expiry date in MM/YY format.' },
+      { id: 'cc-csc', errorId: 'cc-csc-error', msg: 'Please enter the 3 or 4 digit security code.' }
+    ];
+
+    fields.forEach(({ id, errorId, msg }) => {
+      const input = document.getElementById(id);
+      const errorEl = document.getElementById(errorId);
+
+      input.addEventListener('input', () => {
+        input.setCustomValidity('');
+        errorEl.textContent = '';
+      });
+
+      input.addEventListener('blur', () => {
+        if (input.value && !input.checkValidity()) {
+          errorEl.textContent = msg;
+        }
+      });
+
+      input.addEventListener('invalid', () => {
+        input.setCustomValidity(msg);
+        errorEl.textContent = msg;
+      });
+    });
+
+    paymentForm.addEventListener('submit', (e) => {
+      if (!paymentForm.checkValidity()) {
+        e.preventDefault();
+        return;
+      }
+      payBtn.disabled = true;
+    });
+  </script>
