+    <section class="payment-section" aria-labelledby="payment-heading">
+      <h2 id="payment-heading">Payment Details</h2>
+      <form id="payment-form" class="payment-form" action="/checkout" method="POST">
+        <fieldset>
+          <legend class="visually-hidden">Credit or Debit Card Information</legend>
+
+          <div class="form-group">
+            <label for="cc-number">Card number (required)</label>
+            <span id="cc-number-hint" class="hint">13 to 19 digits, spaces allowed</span>
+            <input id="cc-number" name="cc-number" type="text" autocomplete="cc-number"
+                   inputmode="numeric" maxlength="19" pattern="[\d ]{13,19}"
+                   autocorrect="off" autocapitalize="off" spellcheck="false"
+                   enterkeyhint="next" aria-describedby="cc-number-hint cc-number-error" required>
+            <div id="cc-number-error" class="error-msg" aria-live="polite"></div>
+          </div>
+
+          <div class="form-group">
+            <label for="cc-name">Name on card (required)</label>
+            <input id="cc-name" name="cc-name" type="text" autocomplete="cc-name"
+                   maxlength="50" pattern="[\p{L} \-\.]+"
+                   enterkeyhint="next" aria-describedby="cc-name-error" required>
+            <div id="cc-name-error" class="error-msg" aria-live="polite"></div>
+          </div>
+
+          <div class="form-group">
+            <label for="cc-exp">Expiry date (required)</label>
+            <span id="exp-hint" class="hint">Format: MM/YY</span>
+            <input id="cc-exp" name="cc-exp" type="text" autocomplete="cc-exp"
+                   inputmode="numeric" maxlength="5" pattern="(0[1-9]|1[0-2])\/[0-9]{2}"
+                   autocorrect="off" autocapitalize="off" spellcheck="false"
+                   enterkeyhint="next" aria-describedby="exp-hint cc-exp-error" required>
+            <div id="cc-exp-error" class="error-msg" aria-live="polite"></div>
+          </div>
+
+          <div class="form-group">
+            <label for="cc-csc">Security code (required)</label>
+            <span id="csc-hint" class="hint">3 or 4 digits on the back or front of your card</span>
+            <input id="cc-csc" name="cc-csc" type="text" autocomplete="cc-csc"
+                   inputmode="numeric" maxlength="4" pattern="[0-9]{3,4}"
+                   autocorrect="off" autocapitalize="off" spellcheck="false"
+                   enterkeyhint="done" aria-describedby="csc-hint cc-csc-error" required>
+            <div id="cc-csc-error" class="error-msg" aria-live="polite"></div>
+          </div>
+
+          <button type="submit" id="pay-btn" class="btn">Complete Payment</button>
