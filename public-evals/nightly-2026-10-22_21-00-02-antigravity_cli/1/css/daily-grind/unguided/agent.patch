+/* ==========================================================================
+   The Daily Grind — Modern CSS Architecture
+   ========================================================================== */
+
+/* 1. Cascade Layer Order Declaration
+   Explicitly defines specificity precedence from lowest (reset) to highest (utilities). */
+@layer reset, tokens, base, layout, components, utilities;
+
+/* ==========================================================================
+   2. Design Tokens (@layer tokens & @property)
+   Typed custom properties, primitive scales, and semantic tokens.
+   ========================================================================== */
+@property --color-brand-primary {
+  syntax: '<color>';
+  inherits: true;
+  initial-value: #4e342e;
+}
+
+@property --color-brand-accent {
+  syntax: '<color>';
+  inherits: true;
+  initial-value: #ffab40;
+}
+
+@property --card-elevation {
+  syntax: '<length>';
+  inherits: false;
+  initial-value: 0px;
+}
+
+@layer tokens {
+  :root {
+    /* --- Primitive Color Palette (OKLCH with Hex fallbacks) --- */
+    --palette-espresso-900: oklch(26% 0.04 42);    /* ~#3e2723 */
+    --palette-espresso-800: oklch(32% 0.045 42);   /* ~#4e342e */
+    --palette-espresso-700: oklch(40% 0.05 42);    /* ~#5d4037 */
+    --palette-latte-200: oklch(85% 0.02 55);       /* ~#d7ccc8 */
+    --palette-latte-100: oklch(93% 0.012 60);      /* ~#efebe9 */
+    --palette-cream-50: oklch(98.5% 0.004 70);     /* ~#fafafa */
+    --palette-amber-400: oklch(80% 0.16 70);       /* ~#ffab40 */
+    --palette-amber-300: oklch(85% 0.14 75);       /* ~#ffd180 */
+    --palette-white: oklch(100% 0 0);
+    --palette-black: oklch(0% 0 0);
+
+    /* --- Semantic Color Tokens --- */
+    --color-brand-primary: #4e342e;
+    --color-brand-primary-hover: #3e2723;
+    --color-brand-secondary: #d7ccc8;
+    --color-brand-accent: #ffab40;
+
+    --color-surface-canvas: var(--palette-cream-50, #fafafa);
+    --color-surface-card: var(--palette-white, #ffffff);
+    --color-surface-muted: var(--palette-latte-200, #d7ccc8);
+    --color-surface-inverse: var(--color-brand-primary);
+
+    --color-text-primary: #3e2723;
+    --color-text-muted: color-mix(in oklch, var(--color-text-primary) 75%, transparent);
+    --color-text-on-dark: var(--palette-white, #ffffff);
+    --color-text-heading: var(--color-brand-primary);
+
+    --color-border-subtle: color-mix(in oklch, var(--color-brand-primary) 15%, transparent);
+    --color-border-accent: var(--color-brand-accent);
+
+    /* --- Typography Tokens --- */
+    --font-sans: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Roboto, Tahoma, Geneva, Verdana, sans-serif;
+    --font-display: var(--font-sans);
+
+    --text-xs: clamp(0.75rem, 0.7rem + 0.2vw, 0.85rem);
+    --text-sm: clamp(0.85rem, 0.8rem + 0.25vw, 0.925rem);
+    --text-base: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem);
+    --text-lg: clamp(1.125rem, 1.05rem + 0.35vw, 1.25rem);
+    --text-xl: clamp(1.35rem, 1.2rem + 0.6vw, 1.65rem);
+    --text-2xl: clamp(1.75rem, 1.45rem + 1.2vw, 2.25rem);
+    --text-hero: clamp(2.25rem, 1.75rem + 2.5vw, 3.25rem);
+
+    --leading-tight: 1.2;
+    --leading-snug: 1.35;
+    --leading-normal: 1.6;
+
+    --tracking-wide: 0.06em;
+    --tracking-normal: 0em;
+
+    --weight-regular: 400;
+    --weight-medium: 500;
+    --weight-semibold: 600;
+    --weight-bold: 700;
+
+    /* --- Spacing Scale (Fluid & Logical) --- */
+    --space-2xs: 0.25rem;  /* 4px */
+    --space-xs: 0.5rem;    /* 8px */
+    --space-sm: 0.75rem;   /* 12px */
+    --space-md: 1rem;      /* 16px */
+    --space-lg: 1.25rem;   /* 20px */
+    --space-xl: 1.5rem;    /* 24px */
+    --space-2xl: 2.5rem;   /* 40px */
+    --space-3xl: clamp(2.5rem, 2rem + 2.5vw, 4rem);
+    --space-gutter: clamp(1.25rem, 5vw, 4rem);
+
+    /* --- Layout & Sizing Tokens --- */
+    --container-max-inline: 68.75rem; /* 1100px */
+    --grid-min-col: 15.625rem;        /* 250px */
+    --hero-min-block: 60vh;
+
+    /* --- Radii, Shadows & Transitions --- */
+    --radius-sm: 0.25rem;  /* 4px */
+    --radius-md: 0.3125rem;/* 5px */
+    --radius-lg: 0.5rem;   /* 8px */
+    --radius-pill: 9999px;
+
+    --shadow-sm: 0 2px 5px color-mix(in srgb, var(--palette-black) 10%, transparent);
+    --shadow-md: 0 8px 20px -4px color-mix(in srgb, var(--color-brand-primary) 18%, transparent);
+    --shadow-focus: 0 0 0 3px color-mix(in srgb, var(--color-brand-accent) 55%, transparent);
+
+    --ease-standard: cubic-bezier(0.22, 1, 0.36, 1);
+    --duration-fast: 150ms;
+    --duration-normal: 300ms;
+
+    /* --- Legacy Token Aliases (for backward compatibility) --- */
+    --primary: var(--color-brand-primary);
+    --secondary: var(--color-brand-secondary);
+    --accent: var(--color-brand-accent);
+    --text: var(--color-text-primary);
+    --light: var(--color-surface-canvas);
+
+    /* --- Z-Index Scale --- */
+    --z-sticky: 1000;
+  }
+}
+
+/* ==========================================================================
+   3. Modern CSS Reset (@layer reset)
+   Low-specificity normalization using :where() so downstream rules override easily.
+   ========================================================================== */
+@layer reset {
+  *,
+  *::before,
+  *::after {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+  }
+
+  :where(html) {
+    -webkit-text-size-adjust: 100%;
+    text-size-adjust: 100%;
+    scroll-behavior: smooth;
+  }
+
+  :where(ul, ol) {
+    list-style: none;
+  }
+
+  :where(img, picture, svg, video) {
+    display: block;
+    max-inline-size: 100%;
+  }
+
+  :where(a) {
+    color: inherit;
+    text-decoration: none;
+  }
+
+  :where(button, input, select, textarea) {
+    font: inherit;
+    color: inherit;
+  }
+}
+
+/* ==========================================================================
+   4. Base Document Elements (@layer base)
+   ========================================================================== */
+@layer base {
+  body {
+    font-family: var(--font-sans);
+    font-size: var(--text-base);
+    line-height: var(--leading-normal);
+    color: var(--color-text-primary);
+    background-color: var(--color-surface-canvas);
+    min-block-size: 100dvh;
+    display: flex;
+    flex-direction: column;
+    -webkit-font-smoothing: antialiased;
+  }
+
+  main {
+    flex: 1;
+  }
+
+  :is(h1, h2, h3, h4, h5, h6) {
+    font-family: var(--font-display);
+    line-height: var(--leading-tight);
+    font-weight: var(--weight-bold);
+    text-wrap: balance;
+  }
+
+  p {
+    text-wrap: pretty;
+  }
+
+  :focus-visible {
+    outline: 2px solid var(--color-brand-accent);
+    outline-offset: 3px;
+    border-radius: var(--radius-sm);
+  }
+}
+
+/* ==========================================================================
+   5. Structural Layout Primitives (@layer layout)
+   ========================================================================== */
+@layer layout {
+  .container {
+    width: min(100% - (var(--space-lg) * 2), var(--container-max-inline));
+    margin-inline: auto;
+    margin-block: var(--space-2xl);
+  }
+
+  .section-header,
+  section > h2 {
+    text-align: center;
+    margin-block-end: var(--space-lg);
+    font-size: var(--text-2xl);
+    color: var(--color-text-primary);
+
+    & h2 {
+      font-size: inherit;
+      color: inherit;
+    }
+  }
+
+  .grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--grid-min-col)), 1fr));
+    gap: var(--space-lg);
+    margin-block-start: var(--space-lg);
+    container-type: inline-size;
+    container-name: card-grid;
+  }
+}
+
+/* ==========================================================================
+   6. Scoped & Nested UI Components (@layer components)
+   Uses @scope with donut scoping and native CSS nesting (&).
+   ========================================================================== */
+@layer components {
+  /* --- Site Navigation Scope --- */
+  @scope (nav, .site-nav) {
+    :scope {
+      background-color: var(--color-surface-inverse);
+      color: var(--color-text-on-dark);
+      padding-block: var(--space-md);
+      padding-inline: var(--space-gutter);
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: space-between;
+      align-items: center;
+      gap: var(--space-md);
+      position: sticky;
+      inset-block-start: 0;
+      z-index: var(--z-sticky);
+      box-shadow: var(--shadow-sm);
+    }
+
+    .logo {
+      font-size: var(--text-xl);
+      font-weight: var(--weight-bold);
+      letter-spacing: var(--tracking-wide);
+      color: var(--color-text-on-dark);
+      text-decoration: none;
+    }
+
+    ul,
+    .nav-list {
+      display: flex;
+      flex-wrap: wrap;
+      align-items: center;
+      gap: var(--space-lg);
+      list-style: none;
+    }
+
+    a:not(.logo),
+    .nav-link {
+      color: var(--color-text-on-dark);
+      text-decoration: none;
+      font-size: var(--text-sm);
+      transition: color var(--duration-normal) var(--ease-standard),
+                  border-color var(--duration-normal) var(--ease-standard),
+                  background-color var(--duration-normal) var(--ease-standard);
+
+      &:is(:hover, :focus-visible) {
+        color: var(--color-brand-accent);
+      }
+
+      &.logout-link,
+      &[data-variant="outlined"] {
+        border: 1px solid var(--color-border-accent);
+        padding-block: 0.3125rem;
+        padding-inline: var(--space-sm);
+        border-radius: var(--radius-sm);
+
+        &:is(:hover, :focus-visible) {
+          background-color: color-mix(in oklch, var(--color-brand-accent) 15%, transparent);
+        }
+      }
+    }
+  }
+
+  /* --- Hero Banner Scope (Donut Scope: stops at nested .btn) --- */
+  @scope (.hero) to (.btn) {
+    :scope {
+      --hero-overlay: color-mix(in srgb, var(--palette-black) 50%, transparent);
+      --hero-bg-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1350&q=80');
+
+      min-block-size: var(--hero-min-block);
+      background-image:
+        linear-gradient(var(--hero-overlay), var(--hero-overlay)),
+        var(--hero-bg-image);
+      background-size: cover;
+      background-position: center;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+      align-items: center;
+      color: var(--color-text-on-dark);
+      text-align: center;
+      padding-inline: var(--space-lg);
+      padding-block: var(--space-3xl);
+    }
+
+    h1 {
+      font-size: var(--text-hero);
+      margin-block-end: var(--space-md);
+    }
+
+    p {
+      font-size: var(--text-lg);
+      max-inline-size: 55ch;
+      opacity: 0.95;
+    }
+  }
+
+  /* --- Card Component Scope (Donut Scope: stops at action .btn) --- */
+  @scope (.card) to (.btn) {
+    :scope {
+      --card-bg: var(--color-surface-card);
+      --card-padding: var(--space-lg);
+      --card-radius: var(--radius-lg);
+
+      background-color: var(--card-bg);
+      padding: var(--card-padding);
+      border-radius: var(--card-radius);
+      border: 1px solid var(--color-border-subtle);
+      box-shadow: var(--shadow-sm);
+      text-align: center;
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: space-between;
+      transform: translateY(var(--card-elevation));
+      transition: transform var(--duration-normal) var(--ease-standard),
+                  box-shadow var(--duration-normal) var(--ease-standard),
+                  border-color var(--duration-normal) var(--ease-standard);
+
+      /* Relational selector: elevate card when its interactive CTA is hovered or focused */
+      &:has(~ .btn:hover),
+      &:has(.btn:is(:hover, :focus-visible)),
+      &:hover {
+        --card-elevation: -3px;
+        box-shadow: var(--shadow-md);
+        border-color: color-mix(in oklch, var(--color-brand-primary) 30%, transparent);
+      }
+    }
+
+    h3 {
+      margin-block-end: 0.625rem;
+      color: var(--color-text-heading);
+      font-size: var(--text-lg);
+    }
+
+    p {
+      color: var(--color-text-muted);
+      font-size: var(--text-base);
+      flex: 1;
+    }
+  }
+
+  /* --- Button Component Scope --- */
+  @scope (.btn) {
+    :scope {
+      --btn-bg: var(--color-brand-primary);
+      --btn-bg-hover: var(--color-brand-primary-hover);
+      --btn-text: var(--color-text-on-dark);
+
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      background-color: var(--btn-bg);
+      color: var(--btn-text);
+      padding-block: 0.625rem;
+      padding-inline: var(--space-lg);
+      text-decoration: none;
+      font-weight: var(--weight-medium);
+      border-radius: var(--radius-md);
+      margin-block-start: 0.9375rem;
+      cursor: pointer;
+      transition: background-color var(--duration-normal) var(--ease-standard),
+                  transform var(--duration-fast) var(--ease-standard),
+                  box-shadow var(--duration-normal) var(--ease-standard);
+
+      &:is(:hover, :focus-visible) {
+        background-color: var(--btn-bg-hover);
+      }
+
+      &:active {
+        transform: translateY(1px);
+      }
+    }
+  }
+
+  /* --- Site Footer Scope --- */
+  @scope (footer, .site-footer) {
+    :scope {
+      background-color: var(--color-surface-muted);
+      color: var(--color-text-primary);
+      text-align: center;
+      padding-block: var(--space-2xl);
+      padding-inline: var(--space-lg);
+      margin-block-start: var(--space-2xl);
+    }
+
+    .footer-links {
+      display: flex;
+      flex-wrap: wrap;
+      justify-content: center;
+      align-items: center;
+      gap: var(--space-sm);
+      margin-block-end: var(--space-lg);
+      list-style: none;
+
+      & li {
+        display: inline-flex;
+        align-items: center;
+
+        /* Relational selector: add separator between sibling links */
+        &:not(:last-child)::after {
+          content: "|";
+          margin-inline-start: var(--space-sm);
+          opacity: 0.5;
+          user-select: none;
+        }
+      }
+
+      & a {
+        color: var(--color-text-primary);
+        text-decoration: none;
+        font-size: var(--text-xs);
+        margin-inline: 0.625rem;
+        transition: color var(--duration-normal) var(--ease-standard);
+
+        &:is(:hover, :focus-visible) {
+          color: var(--color-brand-primary);
+          text-decoration: underline;
+          text-underline-offset: 0.25em;
+        }
+      }
+    }
+
+    p,
+    .copyright {
+      font-size: var(--text-sm);
+      color: var(--color-text-muted);
+    }
+  }
+}
+
+/* ==========================================================================
+   7. Utilities & Accessibility Overrides (@layer utilities)
+   Highest cascade priority for targeted single-purpose classes and motion preferences.
+   ========================================================================== */
+@layer utilities {
+  .text-center {
+    text-align: center;
+  }
+
+  .visually-hidden {
+    position: absolute;
+    inline-size: 1px;
+    block-size: 1px;
+    padding: 0;
+    margin: -1px;
+    overflow: hidden;
+    clip: rect(0, 0, 0, 0);
+    white-space: nowrap;
+    border: 0;
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    *,
+    *::before,
+    *::after {
+      animation-duration: 0.01ms !important;
+      animation-iteration-count: 1 !important;
+      transition-duration: 0.01ms !important;
+      scroll-behavior: auto !important;
+    }
+  }
+}
