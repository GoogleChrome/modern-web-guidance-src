diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -206,7 +206,92 @@
     </div>
     <p>&copy; 2026 The Daily Grind Coffee Co. All rights reserved.</p>
   </footer>
 
+  <script type="module">
+    const menuItems = [
+      {
+        name: "Maple Oat Latte",
+        description: "Creamy oat milk with a hint of Vermont maple syrup.",
+        category: "Seasonal",
+        price: "$5.50",
+        calories: 210,
+        caffeine: "150mg",
+        url: "/menu/seasonal"
+      },
+      {
+        name: "Dark Roast Espresso",
+        description: "Bold, smokey, and perfect for a morning boost.",
+        category: "Espresso",
+        price: "$3.25",
+        calories: 10,
+        caffeine: "180mg",
+        url: "/menu/espresso"
+      },
+      {
+        name: "Cold Brew",
+        description: "Steeped for 18 hours for maximum smoothness.",
+        category: "Cold Brew",
+        price: "$4.75",
+        calories: 5,
+        caffeine: "200mg",
+        url: "/menu/cold-brew"
+      }
+    ];
+
+    if ("modelContext" in document) {
+      const controller = new AbortController();
+      const cleanup = () => controller.abort();
+
+      window.addEventListener("pagehide", cleanup);
+      window.addEventListener("unload", cleanup);
+
+      await document.modelContext.registerTool(
+        {
+          name: "get_menu_item_details",
+          description:
+            "Retrieves details for a menu item from The Daily Grind menu. Use when the user asks about a drink's description, price, nutrition, or link.",
+          inputSchema: {
+            type: "object",
+            properties: {
+              itemName: {
+                type: "string",
+                description: "The name of the menu item to look up."
+              }
+            },
+            required: ["itemName"]
+          },
+          execute(input) {
+            const rawName = input?.itemName;
+            if (typeof rawName !== "string" || !rawName.trim()) {
+              return {
+                error: "Please provide a valid menu item name.",
+                availableItems: menuItems.map((entry) => entry.name)
+              };
+            }
+
+            const query = rawName.trim().toLowerCase();
+            const item = menuItems.find(
+              (entry) => entry.name.toLowerCase() === query
+            );
+
+            if (!item) {
+              return {
+                error: `Menu item "${rawName}" not found.`,
+                availableItems: menuItems.map((entry) => entry.name)
+              };
+            }
+
+            return item;
+          },
+          annotations: {
+            readOnlyHint: true
+          }
+        },
+        { signal: controller.signal }
+      );
+    }
+  </script>
+
 </body>
 
 </html>
