+      document.getElementById(id).addEventListener('input', syncFormToPayload);
+      document.getElementById(id).addEventListener('change', syncFormToPayload);
+    });
+
+    document.getElementById('rotate-keys-btn').addEventListener('click', async () => {
+      await initOrRotateKeys();
+      await handleSignArtifact();
+    });
+
+    document.getElementById('sign-artifact-btn').addEventListener('click', handleSignArtifact);
+    document.getElementById('verify-artifact-btn').addEventListener('click', handleVerifyArtifact);
+    document.getElementById('tamper-payload-btn').addEventListener('click', handleTamperPayload);
+    verifyContextSelect.addEventListener('change', handleVerifyArtifact);
+
+    // Initialize default receipt & sign on load
