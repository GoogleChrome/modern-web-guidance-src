+  <script type="module">
+    const ML_DSA_PUBLIC_KEY_ALGORITHMS = {
+      1312: 'ML-DSA-44',
+      1952: 'ML-DSA-65',
+      2592: 'ML-DSA-87',
+    };
+
+    const CONTEXT_BY_TYPE = {
+      receipt: 'daily-grind-order-receipt-v1',
+      voucher: 'daily-grind-gift-voucher-v1',
+    };
+
+    export function supportsPostQuantumSignatures() {
+      return (
+        typeof globalThis.SubtleCrypto?.supports === 'function' &&
+        SubtleCrypto.supports('sign', 'ML-DSA-65')
+      );
+    }
+
+    export async function generateSigningKeyPair() {
+      if (supportsPostQuantumSignatures()) {
+        const keyPair = await crypto.subtle.generateKey('ML-DSA-65', false, ['sign', 'verify']);
+        const publicKeyBytes = new Uint8Array(
+          await crypto.subtle.exportKey('raw-public', keyPair.publicKey),
+        );
+        return {
+          suite: 'ML-DSA-65',
+          keyFormat: 'raw-public',
+          keyPair,
+          publicKeyBytes,
+        };
+      }
+
+      // Classical fallback: Ed25519
+      const keyPair = await crypto.subtle.generateKey('Ed25519', false, ['sign', 'verify']);
+      const publicKeyBytes = new Uint8Array(await crypto.subtle.exportKey('raw', keyPair.publicKey));
+      return {
+        suite: 'Ed25519',
+        keyFormat: 'raw',
+        keyPair,
+        publicKeyBytes,
+      };
+    }
+
+    function frameFallbackInput(payloadBytes, contextBytes) {
+      if (contextBytes.byteLength > 255) {
+        throw new DOMException('Context must not exceed 255 bytes', 'OperationError');
+      }
+      const framed = new Uint8Array(1 + contextBytes.byteLength + payloadBytes.byteLength);
+      framed[0] = contextBytes.byteLength;
+      framed.set(contextBytes, 1);
+      framed.set(payloadBytes, 1 + contextBytes.byteLength);
+      return framed;
+    }
+
+    export async function signPayload(
+      privateKey,
+      payloadBytes,
+      contextBytes = new Uint8Array(0),
+    ) {
+      if (privateKey.algorithm.name.startsWith('ML-DSA')) {
+        const sig = await crypto.subtle.sign(
+          { name: privateKey.algorithm.name, context: contextBytes },
+          privateKey,
+          payloadBytes,
+        );
+        return new Uint8Array(sig);
+      }
+
+      const framed = frameFallbackInput(payloadBytes, contextBytes);
+      const sig = await crypto.subtle.sign('Ed25519', privateKey, framed);
+      return new Uint8Array(sig);
+    }
+
+    export async function verifyPayload(
+      publicKeyOrBytes,
+      signatureBytes,
+      payloadBytes,
+      contextBytes = new Uint8Array(0),
+    ) {
+      const publicKey =
+        publicKeyOrBytes instanceof CryptoKey
+          ? publicKeyOrBytes
+          : await (() => {
+              const bytes =
+                publicKeyOrBytes instanceof Uint8Array
+                  ? publicKeyOrBytes
+                  : new Uint8Array(publicKeyOrBytes);
+              const mlDsaName = ML_DSA_PUBLIC_KEY_ALGORITHMS[bytes.byteLength];
+              return mlDsaName
+                ? crypto.subtle.importKey('raw-public', bytes, mlDsaName, true, ['verify'])
+                : crypto.subtle.importKey('raw', bytes, 'Ed25519', true, ['verify']);
+            })();
+
+      if (publicKey.algorithm.name.startsWith('ML-DSA')) {
+        return crypto.subtle.verify(
+          { name: publicKey.algorithm.name, context: contextBytes },
+          publicKey,
+          signatureBytes,
+          payloadBytes,
+        );
+      }
+
+      const framed = frameFallbackInput(payloadBytes, contextBytes);
+      return crypto.subtle.verify('Ed25519', publicKey, signatureBytes, framed);
+    }
+
+    function bytesToHex(bytes) {
+      return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+    }
+
+    function hexToBytes(hex) {
+      const clean = hex.trim().replace(/[^0-9a-fA-F]/g, '');
+      if (clean.length === 0 || clean.length % 2 !== 0) {
+        throw new Error('Invalid hexadecimal input');
+      }
+      const out = new Uint8Array(clean.length / 2);
+      for (let i = 0; i < out.length; i++) {
+        out[i] = parseInt(clean.slice(i * 2, i * 2 + 2), 16);
+      }
+      return out;
+    }
+
+    // UI State & Wiring
+    let activeKeyBundle = null;
+
+    const artifactTypeSelect = document.getElementById('artifact-type');
+    const receiptFields = document.getElementById('receipt-fields');
+    const voucherFields = document.getElementById('voucher-fields');
+    const payloadEditor = document.getElementById('payload-editor');
+    const signerContextDisplay = document.getElementById('signer-context-display');
+    const signerKeyMeta = document.getElementById('signer-key-meta');
+    const activeSuiteBadge = document.getElementById('active-suite-badge');
+
+    const verifyContextSelect = document.getElementById('verify-context');
+    const verifyPayloadInput = document.getElementById('verify-payload');
+    const verifyPublicKeyInput = document.getElementById('verify-public-key');
+    const verifySignatureInput = document.getElementById('verify-signature');
+    const verifyStatusBanner = document.getElementById('verify-status-banner');
+
+    function buildPayloadFromFields() {
+      const type = artifactTypeSelect.value;
+      if (type === 'voucher') {
+        return JSON.stringify(
+          {
+            issuer: 'The Daily Grind Coffee Co.',
+            artifactType: 'gift-voucher',
+            voucherCode: document.getElementById('voucher-code').value.trim(),
+            recipient: document.getElementById('voucher-recipient').value.trim(),
+            amount: document.getElementById('voucher-amount').value.trim(),
+            expiresOn: document.getElementById('voucher-expires').value,
+          },
+          null,
+          2,
+        );
+      }
+
+      return JSON.stringify(
+        {
+          issuer: 'The Daily Grind Coffee Co.',
+          artifactType: 'coffee-order-receipt',
+          orderId: document.getElementById('receipt-order-id').value.trim(),
+          customer: document.getElementById('receipt-customer').value.trim(),
+          item: document.getElementById('receipt-item').value,
+          total: document.getElementById('receipt-total').value.trim(),
+          issuedAt: '2026-10-22T09:30:00Z',
+        },
+        null,
+        2,
+      );
+    }
+
+    function syncFormToPayload() {
+      const type = artifactTypeSelect.value;
+      receiptFields.hidden = type !== 'receipt';
+      voucherFields.hidden = type !== 'voucher';
+      const contextStr = CONTEXT_BY_TYPE[type];
+      signerContextDisplay.textContent = `context: ${contextStr}`;
+      payloadEditor.value = buildPayloadFromFields();
+    }
+
+    async function initOrRotateKeys() {
+      activeKeyBundle = await generateSigningKeyPair();
+      const isPq = activeKeyBundle.suite.startsWith('ML-DSA');
+      activeSuiteBadge.textContent = isPq
+        ? `Post-Quantum: ${activeKeyBundle.suite} (${activeKeyBundle.keyFormat})`
+        : `Classical Fallback: ${activeKeyBundle.suite} (${activeKeyBundle.keyFormat})`;
+      activeSuiteBadge.classList.toggle('pq', isPq);
+
+      const pubHex = bytesToHex(activeKeyBundle.publicKeyBytes);
+      signerKeyMeta.textContent = `Active Suite: ${activeKeyBundle.suite} | Export Format: '${activeKeyBundle.keyFormat}' | Public Key (${activeKeyBundle.publicKeyBytes.byteLength} bytes): ${pubHex.slice(0, 48)}...`;
+      verifyPublicKeyInput.value = pubHex;
+    }
+
+    async function handleSignArtifact() {
+      if (!activeKeyBundle) {
+        await initOrRotateKeys();
+      }
+      const type = artifactTypeSelect.value;
+      const contextStr = CONTEXT_BY_TYPE[type];
+      const encoder = new TextEncoder();
+      const payloadBytes = encoder.encode(payloadEditor.value);
+      const contextBytes = encoder.encode(contextStr);
+
+      const signatureBytes = await signPayload(
+        activeKeyBundle.keyPair.privateKey,
+        payloadBytes,
+        contextBytes,
+      );
+
+      verifyContextSelect.value = contextStr;
+      verifyPayloadInput.value = payloadEditor.value;
+      verifyPublicKeyInput.value = bytesToHex(activeKeyBundle.publicKeyBytes);
+      verifySignatureInput.value = bytesToHex(signatureBytes);
+
+      await handleVerifyArtifact();
+    }
+
+    async function handleVerifyArtifact() {
+      try {
+        const encoder = new TextEncoder();
+        const payloadBytes = encoder.encode(verifyPayloadInput.value);
+        const contextBytes = encoder.encode(verifyContextSelect.value);
+        const pubKeyBytes = hexToBytes(verifyPublicKeyInput.value);
+        const sigBytes = hexToBytes(verifySignatureInput.value);
+
+        const isValid = await verifyPayload(pubKeyBytes, sigBytes, payloadBytes, contextBytes);
+        const detectedAlgo = ML_DSA_PUBLIC_KEY_ALGORITHMS[pubKeyBytes.byteLength] || 'Ed25519';
+
+        if (isValid) {
+          verifyStatusBanner.className = 'verify-banner valid';
+          verifyStatusBanner.textContent = `Authentic & Intact: Verified ${detectedAlgo} signature (${sigBytes.byteLength} bytes) for context "${verifyContextSelect.value}".`;
+        } else {
+          verifyStatusBanner.className = 'verify-banner invalid';
+          verifyStatusBanner.textContent = `Verification Failed: Signature does not match payload, public key, or domain context "${verifyContextSelect.value}".`;
+        }
+      } catch (err) {
+        verifyStatusBanner.className = 'verify-banner invalid';
+        verifyStatusBanner.textContent = `Verification Failed: ${err.message || 'Invalid cryptographic key or signature format.'}`;
+      }
+    }
+
+    function handleTamperPayload() {
+      try {
+        const parsed = JSON.parse(verifyPayloadInput.value);
+        if (parsed.total) {
+          parsed.total = '$0.01';
+        } else if (parsed.amount) {
+          parsed.amount = '$999.00';
+        } else {
+          parsed.tampered = true;
+        }
+        verifyPayloadInput.value = JSON.stringify(parsed, null, 2);
+      } catch {
+        verifyPayloadInput.value += '\n/* tampered */';
+      }
+      handleVerifyArtifact();
+    }
+
+    artifactTypeSelect.addEventListener('change', () => {
+      syncFormToPayload();
+      handleSignArtifact();
+    });
+
+    [
+      'receipt-order-id',
+      'receipt-customer',
+      'receipt-item',
+      'receipt-total',
+      'voucher-code',
+      'voucher-recipient',
+      'voucher-amount',
+      'voucher-expires',
