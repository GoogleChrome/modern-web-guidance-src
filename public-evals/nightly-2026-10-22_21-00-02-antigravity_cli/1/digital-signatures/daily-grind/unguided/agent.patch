+              <span style="min-width: 20px; text-align:center; font-weight:700;">${item.quantity}</span>
+              <button type="button" class="qty-btn" data-action="inc" data-idx="${idx}" aria-label="Increase quantity">+</button>
+              <span style="min-width: 58px; text-align:right; font-weight:700;">$${lineTotal}</span>
+            </div>
+          `;
+          orderItemsContainer.appendChild(row);
+        });
+      }
+
+      const subtotal = orderItems.reduce((sum, item) => sum + item.unitPrice * item.quantity, 0);
+      const tax = subtotal * 0.085;
+      const tip = parseFloat(receiptTipInput.value) || 0;
+      const total = subtotal + tax + tip;
+      subtotalPreviewEl.textContent = `$${subtotal.toFixed(2)}`;
+      totalPreviewEl.textContent = `$${total.toFixed(2)}`;
+    }
+
+    orderItemsContainer.addEventListener('click', (e) => {
+      const btn = e.target.closest('.qty-btn');
+      if (!btn) return;
+      const idx = Number(btn.dataset.idx);
+      const action = btn.dataset.action;
+      if (action === 'inc') {
+        orderItems[idx].quantity += 1;
+      } else if (action === 'dec') {
+        orderItems[idx].quantity -= 1;
+        if (orderItems[idx].quantity <= 0) {
+          orderItems.splice(idx, 1);
+        }
+      }
+      renderOrderItems();
+    });
+
+    addItemBtn.addEventListener('click', () => {
+      const [id, name, priceStr] = addMenuItemSelect.value.split('|');
+      const unitPrice = parseFloat(priceStr);
+      const existing = orderItems.find((i) => i.id === id);
+      if (existing) {
+        existing.quantity += 1;
+      } else {
+        orderItems.push({ id, name, unitPrice, quantity: 1 });
+      }
+      renderOrderItems();
+    });
+
+    document.querySelectorAll('.quick-add-btn').forEach((btn) => {
+      btn.addEventListener('click', () => {
+        const id = btn.dataset.id;
+        const name = btn.dataset.name;
+        const unitPrice = parseFloat(btn.dataset.price);
+        const existing = orderItems.find((i) => i.id === id);
+        if (existing) {
+          existing.quantity += 1;
+        } else {
+          orderItems.push({ id, name, unitPrice, quantity: 1 });
+        }
+        renderOrderItems();
+        document.getElementById('crypto-order-section').scrollIntoView({ behavior: 'smooth' });
+      });
+    });
+
+    receiptTipInput.addEventListener('input', renderOrderItems);
+
+    voucherAmountSelect.addEventListener('change', () => {
+      voucherCustomCodeInput.value = generateFreshVoucherCode(voucherAmountSelect.value);
+    });
+
+    regenVoucherCodeBtn.addEventListener('click', () => {
+      voucherCustomCodeInput.value = generateFreshVoucherCode(voucherAmountSelect.value);
+    });
+
+    function updateKeyringUI(bundle) {
+      const spec = ALGORITHMS[bundle.algorithm];
+      algSelect.value = bundle.algorithm;
+      algDesc.textContent = spec.description;
+      keyCategoryBadge.textContent = `${spec.category} (${spec.standard})`;
+      keyCategoryBadge.className = `badge ${spec.badgeClass}`;
+      activeKeyIdEl.textContent = bundle.keyId;
+      activeKeyEngineEl.textContent = bundle.engine;
+      activeKeyFpEl.textContent = bundle.fingerprint;
+      activePubKeyPemEl.value = bundle.publicKeyPem;
+    }
+
+    async function initOrRotateKeypair(algorithmId) {
+      rotateKeysBtn.disabled = true;
+      rotateKeysBtn.textContent = 'Generating Keys...';
+      try {
+        activeKeyBundle = await generateKeyBundle(algorithmId);
+        try {
+          localStorage.setItem(STORAGE_KEY_BUNDLE, JSON.stringify(activeKeyBundle));
+        } catch {
+          // Ignore storage quota errors
+        }
+        updateKeyringUI(activeKeyBundle);
+      } finally {
+        rotateKeysBtn.disabled = false;
+        rotateKeysBtn.textContent = 'Generate / Rotate Keypair';
+      }
+    }
+
+    algSelect.addEventListener('change', async () => {
+      await initOrRotateKeypair(algSelect.value);
+    });
+
+    rotateKeysBtn.addEventListener('click', async () => {
+      await initOrRotateKeypair(algSelect.value);
+    });
+
+    copyPubKeyBtn.addEventListener('click', async () => {
+      if (!activeKeyBundle) return;
+      try {
+        await navigator.clipboard.writeText(activeKeyBundle.publicKeyPem);
+        copyPubKeyBtn.textContent = 'Copied PEM!';
+        setTimeout(() => {
+          copyPubKeyBtn.textContent = 'Copy Public Key PEM';
+        }, 1800);
+      } catch {
+        activePubKeyPemEl.select();
+      }
+    });
+
+    function renderVisualArtifactCard(envelope, verificationResult) {
+      const { payload, signature } = envelope;
+      const isReceipt = payload.type === 'COFFEE_RECEIPT';
+      previewDocTypeBadge.textContent = isReceipt ? 'COFFEE ORDER RECEIPT' : 'GIFT VOUCHER';
+      previewDocTypeBadge.className = `badge ${ALGORITHMS[signature.algorithm]?.badgeClass || 'badge-classical'}`;
+
+      const statusStamp = verificationResult.valid
+        ? `<span class="badge" style="background:var(--success-bg); color:var(--success); border:1px solid var(--success-border);">&#10004; VERIFIED AUTHENTIC (${signature.algorithm})</span>`
+        : `<span class="badge" style="background:var(--danger-bg); color:var(--danger); border:1px solid var(--danger-border);">&#10008; TAMPERED / INVALID SIGNATURE</span>`;
+
+      if (isReceipt) {
+        const itemsHtml = (payload.items || [])
+          .map(
+            (i) => `
+          <div class="ticket-row">
+            <span>${i.quantity}x ${i.name}</span>
+            <strong>$${Number(i.lineTotal).toFixed(2)}</strong>
+          </div>`
+          )
+          .join('');
+
+        visualArtifactCard.innerHTML = `
+          <div class="ticket-header">
+            <h4>THE DAILY GRIND</h4>
+            <div style="font-size: 0.8rem; color: var(--text-muted);">${payload.storeLocation}</div>
+            <div style="margin-top: 6px;">${statusStamp}</div>
+          </div>
+          <div class="ticket-row"><span>Receipt ID:</span><strong style="font-family:monospace;">${payload.receiptId}</strong></div>
+          <div class="ticket-row"><span>Customer:</span><strong>${payload.customerName}</strong></div>
+          <div class="ticket-row"><span>Issued At:</span><span>${new Date(payload.issuedAt).toLocaleString()}</span></div>
+          <div class="ticket-divider"></div>
+          ${itemsHtml}
+          <div class="ticket-divider"></div>
+          <div class="ticket-row"><span>Subtotal:</span><span>$${Number(payload.subtotal).toFixed(2)}</span></div>
+          <div class="ticket-row"><span>Tax (8.5%):</span><span>$${Number(payload.tax).toFixed(2)}</span></div>
+          <div class="ticket-row"><span>Barista Tip:</span><span>$${Number(payload.tip).toFixed(2)}</span></div>
+          <div class="ticket-row ticket-total"><span>Total Paid (${payload.currency}):</span><span>$${Number(payload.total).toFixed(2)}</span></div>
+          <div class="crypto-seal">
+            <div><strong>ALG:</strong> ${signature.algorithm} (${signature.category})</div>
+            <div><strong>KEY ID:</strong> ${signature.keyId}</div>
+            <div><strong>PAYLOAD SHA-256:</strong> ${verificationResult.computedSha256.slice(0, 32)}...</div>
+            <div><strong>SIGNATURE:</strong> ${signature.hex.slice(0, 56)}...</div>
+          </div>
+        `;
+      } else {
+        visualArtifactCard.innerHTML = `
+          <div class="ticket-header">
+            <h4>THE DAILY GRIND GIFT VOUCHER</h4>
+            <div style="font-size: 0.8rem; color: var(--text-muted);">${payload.tier}</div>
+            <div style="margin-top: 6px;">${statusStamp}</div>
+          </div>
+          <div class="voucher-banner">
+            <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1px;">Bearer Gift Balance</div>
+            <div class="voucher-amount">$${Number(payload.amount).toFixed(2)} ${payload.currency}</div>
+            <div class="voucher-code">${payload.voucherCode}</div>
+          </div>
+          <div class="ticket-row"><span>Recipient:</span><strong>${payload.recipientName}</strong></div>
+          <div class="ticket-row"><span>From:</span><strong>${payload.senderName}</strong></div>
+          <div class="ticket-row"><span>Message:</span><em>"${payload.message}"</em></div>
+          <div class="ticket-row"><span>Valid Until:</span><span>${new Date(payload.expiresAt).toLocaleDateString()}</span></div>
+          <div class="crypto-seal">
+            <div><strong>ALG:</strong> ${signature.algorithm} (${signature.category})</div>
+            <div><strong>KEY ID:</strong> ${signature.keyId}</div>
+            <div><strong>PAYLOAD SHA-256:</strong> ${verificationResult.computedSha256.slice(0, 32)}...</div>
+            <div><strong>SIGNATURE:</strong> ${signature.hex.slice(0, 56)}...</div>
+          </div>
+        `;
+      }
+    }
+
+    function updateVerificationInspectorUI(res) {
+      if (res.valid) {
+        statusBanner.className = 'verify-banner authentic';
+        statusIcon.innerHTML = '&#10004;';
+        statusTitle.textContent = `AUTHENTIC & INTEGRITY VERIFIED (${res.algorithm})`;
+        statusReason.textContent = res.reason;
+      } else {
+        statusBanner.className = 'verify-banner tampered';
+        statusIcon.innerHTML = '&#10008;';
+        statusTitle.textContent = 'VERIFICATION FAILED — TAMPERING OR INVALID SIGNATURE';
+        statusReason.textContent = res.reason;
+      }
+
+      checkStructure.className = `check-pill ${res.checks?.structureValid ? 'pass' : 'fail'}`;
+      checkStructure.textContent = `1. Envelope Schema: ${res.checks?.structureValid ? 'PASS' : 'FAIL'}`;
+
+      checkDigest.className = `check-pill ${res.checks?.hashMatch ? 'pass' : 'fail'}`;
+      checkDigest.textContent = `2. SHA-256 Digest: ${res.checks?.hashMatch ? 'MATCH' : 'MISMATCH'}`;
+
+      checkSignature.className = `check-pill ${res.checks?.signatureValid ? 'pass' : 'fail'}`;
+      checkSignature.textContent = `3. Asymmetric Sig: ${res.checks?.signatureValid ? 'VALID' : 'REJECTED'}`;
+
+      inspectorAlg.textContent = `${res.algorithm || 'Unknown'} (${res.category || ''})`;
+      inspectorKeyId.textContent = res.keyId || 'N/A';
+      inspectorLatency.textContent = `${res.elapsedMs ?? 0} ms`;
+      inspectorSha256.textContent = res.computedSha256 || 'N/A';
+    }
+
+    async function loadEnvelopeIntoWorkspace(envelope, saveAsOriginal = true) {
+      if (saveAsOriginal) {
+        currentOriginalEnvelope = structuredClone(envelope);
+      }
+      inspectorJsonTextarea.value = JSON.stringify(envelope, null, 2);
+      const res = await verifyDocument(envelope);
+      updateVerificationInspectorUI(res);
+      renderVisualArtifactCard(envelope, res);
+    }
+
+    function addEnvelopeToLedger(envelope) {
+      const id = envelope.payload.receiptId || envelope.payload.voucherCode;
+      signedLedger = signedLedger.filter(
+        (item) => (item.payload.receiptId || item.payload.voucherCode) !== id
+      );
+      signedLedger.unshift(structuredClone(envelope));
+      if (signedLedger.length > 8) {
+        signedLedger = signedLedger.slice(0, 8);
+      }
+      try {
+        localStorage.setItem(STORAGE_LEDGER, JSON.stringify(signedLedger));
+      } catch {
+        // Ignore quota errors
+      }
+      renderLedgerList(id);
+    }
+
+    function renderLedgerList(activeId = null) {
+      signedLedgerList.innerHTML = '';
+      signedLedger.forEach((env) => {
+        const isReceipt = env.payload.type === 'COFFEE_RECEIPT';
+        const id = isReceipt ? env.payload.receiptId : env.payload.voucherCode;
+        const amount = isReceipt ? env.payload.total : env.payload.amount;
+        const party = isReceipt ? env.payload.customerName : env.payload.recipientName;
+        const card = document.createElement('div');
+        card.className = `ledger-item ${id === activeId ? 'active' : ''}`;
+        card.innerHTML = `
+          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
+            <span class="badge ${ALGORITHMS[env.signature.algorithm]?.badgeClass || 'badge-classical'}">${env.signature.algorithm}</span>
+            <strong style="color:var(--primary-dark);">$${Number(amount).toFixed(2)}</strong>
+          </div>
+          <div style="font-weight:700; font-size:0.88rem;">${isReceipt ? 'Receipt' : 'Voucher'}: <span style="font-family:monospace;">${id}</span></div>
+          <div style="font-size:0.8rem; color:var(--text-muted);">${isReceipt ? 'Customer' : 'Recipient'}: ${party}</div>
+        `;
+        card.addEventListener('click', () => {
+          renderLedgerList(id);
+          loadEnvelopeIntoWorkspace(env, true);
+        });
+        signedLedgerList.appendChild(card);
+      });
+    }
+
+    // Sign Coffee Order Receipt Handler
+    receiptForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      if (!activeKeyBundle) {
+        await initOrRotateKeypair(algSelect.value);
+      }
+      if (orderItems.length === 0) {
+        orderItems.push({ id: 'maple-oat-latte', name: 'Maple Oat Latte', unitPrice: 5.75, quantity: 1 });
+        renderOrderItems();
+      }
+      const payload = createCoffeeReceiptPayload({
+        customerName: document.getElementById('receipt-customer').value,
+        storeLocation: document.getElementById('receipt-location').value,
+        items: orderItems,
+        tip: parseFloat(receiptTipInput.value) || 0
+      });
+      const signedEnvelope = await signDocument(payload, activeKeyBundle);
+      addEnvelopeToLedger(signedEnvelope);
+      await loadEnvelopeIntoWorkspace(signedEnvelope, true);
+    });
+
+    // Sign Gift Voucher Handler
+    voucherForm.addEventListener('submit', async (e) => {
+      e.preventDefault();
+      if (!activeKeyBundle) {
+        await initOrRotateKeypair(algSelect.value);
+      }
+      const payload = createGiftVoucherPayload({
+        voucherCode: voucherCustomCodeInput.value.trim(),
+        amount: parseFloat(voucherAmountSelect.value),
+        recipientName: document.getElementById('voucher-recipient').value,
+        senderName: document.getElementById('voucher-sender').value,
+        tier: document.getElementById('voucher-tier').value,
+        message: document.getElementById('voucher-message').value
+      });
+      const signedEnvelope = await signDocument(payload, activeKeyBundle);
+      addEnvelopeToLedger(signedEnvelope);
+      await loadEnvelopeIntoWorkspace(signedEnvelope, true);
+      voucherCustomCodeInput.value = generateFreshVoucherCode(voucherAmountSelect.value);
+    });
+
+    // Tamper Attack Simulator
+    tamperAmountBtn.addEventListener('click', async () => {
+      try {
+        const parsed = JSON.parse(inspectorJsonTextarea.value);
+        if (parsed.payload) {
+          if (parsed.payload.type === 'COFFEE_RECEIPT') {
+            parsed.payload.total = 0.01;
+            parsed.payload.customerName = `${parsed.payload.customerName} [TAMPERED]`;
+          } else {
+            parsed.payload.amount = 9999.00;
+            parsed.payload.recipientName = `${parsed.payload.recipientName} [TAMPERED]`;
+          }
+          await loadEnvelopeIntoWorkspace(parsed, false);
+        }
+      } catch (err) {
+        statusBanner.className = 'verify-banner tampered';
+        statusReason.textContent = 'Invalid JSON in inspector textarea.';
+      }
+    });
+
+    // Restore Original Signed Payload
+    restoreAuthenticBtn.addEventListener('click', async () => {
+      if (currentOriginalEnvelope) {
+        await loadEnvelopeIntoWorkspace(currentOriginalEnvelope, false);
+      }
+    });
+
+    // Verify Edited JSON in Inspector
+    async function verifyCurrentTextarea() {
+      try {
+        const parsed = JSON.parse(inspectorJsonTextarea.value);
+        const res = await verifyDocument(parsed);
+        updateVerificationInspectorUI(res);
+        if (parsed.payload && parsed.signature) {
+          renderVisualArtifactCard(parsed, res);
+        }
+      } catch (err) {
+        updateVerificationInspectorUI({
+          valid: false,
+          reason: `Malformed JSON syntax: ${err.message}`,
+          checks: { structureValid: false, hashMatch: false, signatureValid: false }
+        });
+      }
+    }
+
+    verifyNowBtn.addEventListener('click', verifyCurrentTextarea);
+    verifyJsonBtn.addEventListener('click', verifyCurrentTextarea);
+    inspectorJsonTextarea.addEventListener('input', () => {
+      verifyCurrentTextarea();
+    });
+
+    copyEnvelopeBtn.addEventListener('click', async () => {
+      try {
+        await navigator.clipboard.writeText(inspectorJsonTextarea.value);
+        clipboardFeedback.textContent = 'Signed JSON copied to clipboard!';
+        setTimeout(() => {
+          clipboardFeedback.textContent = '';
+        }, 2000);
+      } catch {
+        inspectorJsonTextarea.select();
+      }
+    });
+
+    downloadEnvelopeBtn.addEventListener('click', () => {
+      const blob = new Blob([inspectorJsonTextarea.value], { type: 'application/json' });
+      const url = URL.createObjectURL(blob);
+      const a = document.createElement('a');
+      const id = currentOriginalEnvelope?.payload?.receiptId || currentOriginalEnvelope?.payload?.voucherCode || 'signed-document';
+      a.href = url;
+      a.download = `${id}.signed.json`;
+      a.click();
+      URL.revokeObjectURL(url);
+    });
+
+    // Initialize Application State on Load
+    (async function bootstrap() {
+      renderOrderItems();
+
+      // Restore or create initial Quantum-Resistant ML-DSA-65 KeyBundle
+      let savedBundle = null;
+      try {
+        const raw = localStorage.getItem(STORAGE_KEY_BUNDLE);
+        if (raw) savedBundle = JSON.parse(raw);
+      } catch {
+        savedBundle = null;
+      }
+
+      if (savedBundle && savedBundle.algorithm && ALGORITHMS[savedBundle.algorithm]) {
+        activeKeyBundle = savedBundle;
+        updateKeyringUI(activeKeyBundle);
+      } else {
+        await initOrRotateKeypair('ML-DSA-65');
+      }
+
+      // Restore or seed initial signed Receipt and Gift Voucher
+      let savedLedger = null;
+      try {
+        const rawLedger = localStorage.getItem(STORAGE_LEDGER);
+        if (rawLedger) savedLedger = JSON.parse(rawLedger);
+      } catch {
+        savedLedger = null;
+      }
+
+      if (Array.isArray(savedLedger) && savedLedger.length > 0) {
+        signedLedger = savedLedger;
+        renderLedgerList(signedLedger[0].payload.receiptId || signedLedger[0].payload.voucherCode);
+        await loadEnvelopeIntoWorkspace(signedLedger[0], true);
+      } else {
+        // Seed one signed Gift Voucher and one signed Coffee Order Receipt
+        const initialVoucherPayload = createGiftVoucherPayload({
+          voucherCode: 'GRIND-50-2026-Q7M2',
+          amount: 50,
+          recipientName: 'Marcus Sterling',
+          senderName: 'Elena Vance',
+          tier: 'Artisanal Gold Bean',
+          message: 'Enjoy a week of freshly roasted pour-overs on me!'
+        });
+        const signedVoucher = await signDocument(initialVoucherPayload, activeKeyBundle);
+        addEnvelopeToLedger(signedVoucher);
+
+        const initialReceiptPayload = createCoffeeReceiptPayload({
+          customerName: 'Elena Vance',
+          storeLocation: 'Downtown Roastery — 402 Bean Ave',
+          items: orderItems,
+          tip: 2.00
+        });
+        const signedReceipt = await signDocument(initialReceiptPayload, activeKeyBundle);
+        addEnvelopeToLedger(signedReceipt);
+
+        await loadEnvelopeIntoWorkspace(signedReceipt, true);
+      }
+    })();
+  </script>
