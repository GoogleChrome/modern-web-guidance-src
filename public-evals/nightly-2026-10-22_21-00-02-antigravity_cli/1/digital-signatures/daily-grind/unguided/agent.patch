+/**
+ * Helper to create a structured Coffee Order Receipt payload.
+ */
+export function createCoffeeReceiptPayload({
+  orderId,
+  customerName = 'Alex Rivera',
+  items = [],
+  storeLocation = 'Downtown Roastery — 402 Bean Ave',
+  barista = 'Maya Lin',
+  taxRate = 0.085,
+  tip = 0,
+  timestamp = new Date().toISOString()
+}) {
+  const normalizedItems = items.map((item) => ({
+    id: item.id,
+    name: item.name,
+    size: item.size || '12oz',
+    milk: item.milk || 'Oat Milk',
+    quantity: Number(item.quantity) || 1,
+    unitPrice: Number(Number(item.unitPrice).toFixed(2)),
+    lineTotal: Number((Number(item.quantity || 1) * Number(item.unitPrice)).toFixed(2))
+  }));
+
+  const subtotal = Number(
+    normalizedItems.reduce((sum, item) => sum + item.lineTotal, 0).toFixed(2)
+  );
+  const tax = Number((subtotal * taxRate).toFixed(2));
+  const tipAmount = Number(Number(tip || 0).toFixed(2));
+  const total = Number((subtotal + tax + tipAmount).toFixed(2));
+
+  return {
+    type: 'COFFEE_RECEIPT',
+    receiptId: orderId || `DG-RCP-${Date.now().toString(36).toUpperCase()}`,
+    merchant: 'The Daily Grind Coffee Co.',
+    storeLocation,
+    barista,
+    customerName: customerName.trim() || 'Guest Coffee Lover',
+    issuedAt: timestamp,
+    currency: 'USD',
+    items: normalizedItems,
+    subtotal,
+    tax,
+    tip: tipAmount,
+    total
+  };
+}
+
+/**
+ * Helper to create a structured Gift Voucher payload.
+ */
+export function createGiftVoucherPayload({
+  voucherCode,
+  amount = 25,
+  recipientName = 'Jordan Taylor',
+  senderName = 'Sam Chen',
+  tier = 'Artisanal Gold Bean',
+  message = 'Enjoy a week of freshly roasted pour-overs on me!',
+  issuedAt = new Date().toISOString(),
+  expiresAt = null
+}) {
+  const issuedDate = new Date(issuedAt);
+  const expiryDate = expiresAt
+    ? new Date(expiresAt)
+    : new Date(issuedDate.getTime() + 365 * 24 * 60 * 60 * 1000);
+
+  const randomSuffix = Math.random().toString(36).substring(2, 6).toUpperCase();
+  const code =
+    voucherCode ||
+    `GRIND-${Number(amount).toFixed(0)}-${issuedDate.getFullYear()}-${randomSuffix}`;
+
+  return {
+    type: 'GIFT_VOUCHER',
+    voucherCode: code,
+    merchant: 'The Daily Grind Coffee Co.',
+    tier,
+    amount: Number(Number(amount).toFixed(2)),
+    currency: 'USD',
+    recipientName: recipientName.trim() || 'Valued Guest',
+    senderName: senderName.trim() || 'A Friend',
+    message: message.trim() || 'Enjoy your artisanal coffee at The Daily Grind!',
+    redeemableAt: 'All Daily Grind Locations & Online Ordering',
+    issuedAt: issuedDate.toISOString(),
+    expiresAt: expiryDate.toISOString(),
+    status: 'ACTIVE_UNREDEEMED'
+  };
+}
