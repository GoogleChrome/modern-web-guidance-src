+  <script>
+    function initializeApp() {
+      // 1. Rewards Card Expiration Month-Year using Temporal.PlainYearMonth
+      const expiryMonthInput = document.getElementById('expiry-month');
+      const expiryYearInput = document.getElementById('expiry-year');
+      const expiryDisplay = document.getElementById('expiry-display');
+      const expiryStatus = document.getElementById('expiry-status');
+      const checkExpiryBtn = document.getElementById('check-expiry-btn');
+
+      function updateRewardsExpiration() {
+        const year = Number(expiryYearInput.value) || 2027;
+        const month = Number(expiryMonthInput.value) || 12;
+
+        // Create a PlainYearMonth with explicit calendar for polyfill safety
+        const expiry = Temporal.PlainYearMonth.from({ year, month, calendar: 'iso8601' });
+        const currentMonth = Temporal.Now.plainDateISO().toPlainYearMonth();
+
+        // Calculate duration until expiry using largestUnit: 'years'
+        const duration = currentMonth.until(expiry, { largestUnit: 'years' });
+
+        expiryDisplay.textContent = `Expires: ${expiry.toString()}`;
+
+        if (duration.sign < 0) {
+          expiryStatus.textContent = 'Card Expired — please renew in your account.';
+        } else if (duration.sign === 0) {
+          expiryStatus.textContent = 'Expires this month — use your bonus beans soon!';
+        } else {
+          expiryStatus.textContent = `Active — expires in ${duration.years} year(s) and ${duration.months} month(s).`;
+        }
+      }
+
+      checkExpiryBtn.addEventListener('click', updateRewardsExpiration);
+
+      // 2. Customer Birthday Perks using Temporal.PlainMonthDay
+      const bdayMonthInput = document.getElementById('bday-month');
+      const bdayDayInput = document.getElementById('bday-day');
+      const birthdayDisplay = document.getElementById('birthday-display');
+      const birthdayStatus = document.getElementById('birthday-status');
+      const checkBdayBtn = document.getElementById('check-bday-btn');
+
+      function updateBirthdayPerks() {
+        const month = Number(bdayMonthInput.value) || 10;
+        const day = Number(bdayDayInput.value) || 31;
+
+        // Create a PlainMonthDay with explicit calendar for polyfill safety
+        const birthday = Temporal.PlainMonthDay.from({ month, day, calendar: 'iso8601' });
+        const today = Temporal.Now.plainDateISO();
+        const isBirthdayToday = birthday.equals(today.toPlainMonthDay());
+
+        birthdayDisplay.textContent = `Birthday: ${birthday.toString()}`;
+
+        if (isBirthdayToday) {
+          birthdayStatus.textContent = 'Happy Birthday! Your free drink reward is ready to redeem today!';
+        } else {
+          // Convert PlainMonthDay to a full PlainDate with a specific year before performing arithmetic
+          let nextBirthday = birthday.toPlainDate({ year: today.year });
+          if (Temporal.PlainDate.compare(nextBirthday, today) < 0) {
+            nextBirthday = birthday.toPlainDate({ year: today.year + 1 });
+          }
+          const daysUntil = today.until(nextBirthday, { largestUnit: 'days' }).days;
+          birthdayStatus.textContent = `Your next birthday perk unlocks in ${daysUntil} day(s) (${nextBirthday.toString()}).`;
+        }
+      }
+
+      checkBdayBtn.addEventListener('click', updateBirthdayPerks);
+
+      // 3. Daily Shop Opening Hours using Temporal.PlainTime
+      const hoursDisplay = document.getElementById('hours-display');
+      const hoursStatus = document.getElementById('hours-status');
+      const roastSchedule = document.getElementById('roast-schedule');
+
+      function updateShopHours() {
+        const openingTime = Temporal.PlainTime.from('06:30:00');
+        const closingTime = Temporal.PlainTime.from('19:00:00');
+        // Add a duration to PlainTime for morning pastry warm-up / fresh batch schedule
+        const freshPastryTime = openingTime.add({ minutes: 30 });
+        const afternoonRushTime = openingTime.add({ hours: 8 });
+
+        hoursDisplay.textContent = `${openingTime.toString({ smallestUnit: 'minute' })} – ${closingTime.toString({ smallestUnit: 'minute' })}`;
+
+        const nowTime = Temporal.Now.plainTimeISO();
+        const isOpen =
+          Temporal.PlainTime.compare(nowTime, openingTime) >= 0 &&
+          Temporal.PlainTime.compare(nowTime, closingTime) < 0;
+
+        if (isOpen) {
+          const untilClose = nowTime.until(closingTime, { largestUnit: 'hours' });
+          hoursStatus.textContent = `We're Open! Closing in ${untilClose.hours}h ${untilClose.minutes}m.`;
+        } else {
+          hoursStatus.textContent = `Currently Closed — doors open daily at ${openingTime.toString({ smallestUnit: 'minute' })}.`;
+        }
+
+        roastSchedule.textContent = `Fresh pastries out at ${freshPastryTime.toString({ smallestUnit: 'minute' })} · Afternoon cold brew tap at ${afternoonRushTime.toString({ smallestUnit: 'minute' })}`;
+      }
+
+      updateRewardsExpiration();
+      updateBirthdayPerks();
+      updateShopHours();
+    }
+
+    // Check if Temporal is supported natively; load @js-temporal/polyfill fallback if needed
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
