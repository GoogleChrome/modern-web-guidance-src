+  <script>
+    // 1. Rewards Card Expiration Month-Year (lacks a specific day -> Temporal.PlainYearMonth)
+    function evaluateRewardsExpiration(yearMonthInput, referenceDate = Temporal.Now.plainDateISO()) {
+      const expirationYearMonth = Temporal.PlainYearMonth.from(yearMonthInput);
+      const currentYearMonth = referenceDate.toPlainYearMonth();
+      const comparison = Temporal.PlainYearMonth.compare(expirationYearMonth, currentYearMonth);
+      const isExpired = comparison < 0;
+      const isExpiringThisMonth = comparison === 0;
+      const durationUntilExpiry = currentYearMonth.until(expirationYearMonth, { largestUnit: 'year' });
+
+      // Convert to a full PlainDate only at the end of the expiration month when needed
+      const lastValidDate = expirationYearMonth.toPlainDate({
+        day: expirationYearMonth.daysInMonth
+      });
+
+      const formattedMonthYear = expirationYearMonth.toLocaleString('en-US', {
+        month: 'long',
+        year: 'numeric',
+        calendar: expirationYearMonth.calendarId || 'iso8601'
+      });
+
+      return {
+        expirationYearMonth,
+        currentYearMonth,
+        isExpired,
+        isExpiringThisMonth,
+        durationUntilExpiry,
+        lastValidDate,
+        formattedMonthYear,
+        isoString: expirationYearMonth.toString()
+      };
+    }
+
+    // 2. Customer Birthday Perks (lacks a specific year -> Temporal.PlainMonthDay)
+    function evaluateBirthdayPerk(monthDayInput, referenceDate = Temporal.Now.plainDateISO()) {
+      const birthdayMonthDay = Temporal.PlainMonthDay.from(monthDayInput);
+      const todayMonthDay = referenceDate.toPlainMonthDay();
+      const isBirthdayToday = birthdayMonthDay.equals(todayMonthDay);
+
+      const resolveBirthdayInYear = (year) => {
+        try {
+          return birthdayMonthDay.toPlainDate({ year });
+        } catch {
+          return Temporal.PlainDate.from({
+            year,
+            monthCode: birthdayMonthDay.monthCode,
+            day: birthdayMonthDay.day
+          });
+        }
+      };
+
+      // Combine PlainMonthDay with a year (handling Feb 29 leap-day constraining automatically)
+      let nextBirthdayDate = resolveBirthdayInYear(referenceDate.year);
+      if (Temporal.PlainDate.compare(nextBirthdayDate, referenceDate) < 0) {
+        nextBirthdayDate = resolveBirthdayInYear(referenceDate.year + 1);
+      }
+
+      const daysUntilBirthday = referenceDate.until(nextBirthdayDate, { largestUnit: 'day' }).days;
+      const isBirthdayMonth = nextBirthdayDate.month === referenceDate.month && daysUntilBirthday <= 31;
+
+      const formattedBirthday = birthdayMonthDay.toLocaleString('en-US', {
+        month: 'long',
+        day: 'numeric',
+        calendar: birthdayMonthDay.calendarId || 'iso8601'
+      });
+
+      return {
+        birthdayMonthDay,
+        todayMonthDay,
+        isBirthdayToday,
+        isBirthdayMonth,
+        nextBirthdayDate,
+        daysUntilBirthday,
+        formattedBirthday,
+        isoString: birthdayMonthDay.toString()
+      };
+    }
+
+    // 3. Daily Shop Opening Hours (lacks a date -> Temporal.PlainTime)
+    const SHOP_SCHEDULE = {
+      openTime: Temporal.PlainTime.from({ hour: 6, minute: 30 }),
+      closeTime: Temporal.PlainTime.from({ hour: 20, minute: 0 }),
+      happyHourStart: Temporal.PlainTime.from('14:00'),
+      happyHourEnd: Temporal.PlainTime.from('16:00')
+    };
+
+    function evaluateShopHours(
+      checkTimeInput = Temporal.Now.plainTimeISO(),
+      schedule = SHOP_SCHEDULE
+    ) {
+      const currentTime = Temporal.PlainTime.from(checkTimeInput);
+      const { openTime, closeTime, happyHourStart, happyHourEnd } = schedule;
+
+      const isAfterOpen = Temporal.PlainTime.compare(currentTime, openTime) >= 0;
+      const isBeforeClose = Temporal.PlainTime.compare(currentTime, closeTime) < 0;
+      const isOpen = isAfterOpen && isBeforeClose;
+
+      const isHappyHour =
+        Temporal.PlainTime.compare(currentTime, happyHourStart) >= 0 &&
+        Temporal.PlainTime.compare(currentTime, happyHourEnd) < 0;
+
+      let statusDuration;
+      if (isOpen) {
+        statusDuration = currentTime.until(closeTime, {
+          largestUnit: 'hour',
+          smallestUnit: 'minute'
+        });
+      } else if (Temporal.PlainTime.compare(currentTime, openTime) < 0) {
+        statusDuration = currentTime.until(openTime, {
+          largestUnit: 'hour',
+          smallestUnit: 'minute'
+        });
+      } else {
+        // After closing: compute time until tomorrow's opening across midnight
+        const untilMidnight = currentTime.until(Temporal.PlainTime.from('23:59:59'));
+        const fromMidnightToOpen = Temporal.PlainTime.from('00:00').until(openTime);
+        statusDuration = untilMidnight
+          .add({ seconds: 1 })
+          .add(fromMidnightToOpen)
+          .round({ largestUnit: 'hour', smallestUnit: 'minute' });
+      }
+
+      const dailyOperatingDuration = openTime.until(closeTime, { largestUnit: 'hour' });
+
+      return {
+        currentTime,
+        openTime,
+        closeTime,
+        isOpen,
+        isHappyHour,
+        statusDuration,
+        dailyOperatingDuration,
+        formattedRange: `${openTime.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' })} – ${closeTime.toLocaleString('en-US', { hour: 'numeric', minute: '2-digit' })}`
+      };
+    }
+
+    function renderRewardsExpiration(yearMonthStr) {
+      try {
+        const result = evaluateRewardsExpiration(yearMonthStr);
+        document.getElementById('rewards-expiry-display').textContent =
+          `Expires: ${result.formattedMonthYear} (${result.isoString})`;
+
+        const statusEl = document.getElementById('rewards-expiry-status');
+        const countdownEl = document.getElementById('rewards-expiry-countdown');
+
+        if (result.isExpired) {
+          statusEl.textContent = 'Card Expired';
+          statusEl.className = 'status-pill status-closed';
+          const elapsed = result.expirationYearMonth.until(result.currentYearMonth, { largestUnit: 'year' });
+          countdownEl.textContent = `Expired ${elapsed.years ? elapsed.years + ' yr ' : ''}${elapsed.months} mo ago`;
+        } else if (result.isExpiringThisMonth) {
+          statusEl.textContent = 'Expires This Month';
+          statusEl.className = 'status-pill status-warning';
+          countdownEl.textContent = 'Renew before the end of the month to keep Gold status.';
+        } else {
+          statusEl.textContent = 'Active Member Card';
+          statusEl.className = 'status-pill status-active';
+          const { years, months } = result.durationUntilExpiry;
+          const parts = [];
+          if (years > 0) parts.push(`${years} ${years === 1 ? 'year' : 'years'}`);
+          if (months > 0) parts.push(`${months} ${months === 1 ? 'month' : 'months'}`);
+          countdownEl.textContent = `Valid for ${parts.join(', ')} remaining`;
+        }
+
+        document.getElementById('rewards-expiry-last-day').textContent =
+          `Benefits valid through ${result.lastValidDate.toString()} (${result.expirationYearMonth.daysInMonth} days in month)`;
+      } catch (err) {
+        document.getElementById('rewards-expiry-status').textContent = 'Invalid Month-Year';
+        document.getElementById('rewards-expiry-status').className = 'status-pill status-closed';
+      }
+    }
+
+    function renderBirthdayPerk(monthDayStr) {
+      try {
+        const result = evaluateBirthdayPerk(monthDayStr);
+        document.getElementById('birthday-display').textContent =
+          `Birthday: ${result.formattedBirthday} (${result.isoString})`;
+
+        const statusEl = document.getElementById('birthday-perk-status');
+        const countdownEl = document.getElementById('birthday-countdown');
+
+        if (result.isBirthdayToday) {
+          statusEl.textContent = '🎉 Free Drink Available Today!';
+          statusEl.className = 'status-pill status-active';
+          countdownEl.textContent = 'Redeem any handcrafted beverage at the counter today.';
+        } else if (result.daysUntilBirthday <= 7) {
+          statusEl.textContent = 'Birthday Week Approaching!';
+          statusEl.className = 'status-pill status-warning';
+          countdownEl.textContent = `Only ${result.daysUntilBirthday} ${result.daysUntilBirthday === 1 ? 'day' : 'days'} until your free birthday drink!`;
+        } else {
+          statusEl.textContent = 'Perk Registered';
+          statusEl.className = 'status-pill status-active';
+          countdownEl.textContent = `${result.daysUntilBirthday} days until your next birthday reward`;
+        }
+
+        document.getElementById('birthday-next-date').textContent =
+          `Next celebration date: ${result.nextBirthdayDate.toString()}`;
+      } catch (err) {
+        document.getElementById('birthday-perk-status').textContent = 'Use MM-DD Format';
+        document.getElementById('birthday-perk-status').className = 'status-pill status-closed';
+      }
+    }
+
+    function renderShopHours(timeInput) {
+      try {
+        const result = evaluateShopHours(timeInput);
+        document.getElementById('shop-hours-display').textContent =
+          `Daily Hours: ${result.formattedRange} (${result.openTime.toString({ smallestUnit: 'minute' })}–${result.closeTime.toString({ smallestUnit: 'minute' })})`;
+
+        const statusEl = document.getElementById('shop-open-status');
+        const remainingEl = document.getElementById('shop-time-remaining');
+        const happyHourEl = document.getElementById('shop-happy-hour');
+
+        const { hours, minutes } = result.statusDuration;
+        const durationText = `${hours > 0 ? hours + 'h ' : ''}${minutes}m`;
+
+        if (result.isOpen) {
+          statusEl.textContent = 'Open Now — Brewing Fresh';
+          statusEl.className = 'status-pill status-active';
+          remainingEl.textContent = `Checked at ${result.currentTime.toString({ smallestUnit: 'minute' })} • Closes in ${durationText}`;
+        } else {
+          statusEl.textContent = 'Currently Closed';
+          statusEl.className = 'status-pill status-closed';
+          remainingEl.textContent = `Checked at ${result.currentTime.toString({ smallestUnit: 'minute' })} • Opens in ${durationText}`;
+        }
+
+        if (result.isHappyHour) {
+          happyHourEl.textContent = '☕ Afternoon Espresso Happy Hour is active now (14:00–16:00)!';
+        } else {
+          happyHourEl.textContent = `Espresso Happy Hour: ${SHOP_SCHEDULE.happyHourStart.toString({ smallestUnit: 'minute' })}–${SHOP_SCHEDULE.happyHourEnd.toString({ smallestUnit: 'minute' })} daily`;
+        }
+      } catch (err) {
+        document.getElementById('shop-open-status').textContent = 'Invalid Time';
+        document.getElementById('shop-open-status').className = 'status-pill status-closed';
+      }
+    }
+
+    function initDailyGrindTemporal() {
+      const expiryInput = document.getElementById('expiry-input');
+      const renewBtn = document.getElementById('renew-card-btn');
+      const birthdayInput = document.getElementById('birthday-input');
+      const birthdayBtn = document.getElementById('update-birthday-btn');
+      const timeInput = document.getElementById('check-time-input');
+      const currentTimeBtn = document.getElementById('use-current-time-btn');
+
+      // Initialize with current wall-clock time for the shop hours input
+      const nowTime = Temporal.Now.plainTimeISO();
+      timeInput.value = nowTime.toString({ smallestUnit: 'minute' });
+
+      renderRewardsExpiration(expiryInput.value);
+      renderBirthdayPerk(birthdayInput.value);
+      renderShopHours(nowTime);
+
+      expiryInput.addEventListener('change', (e) => {
+        renderRewardsExpiration(e.target.value);
+      });
+
+      renewBtn.addEventListener('click', () => {
+        const currentYm = Temporal.PlainYearMonth.from(expiryInput.value);
+        const extendedYm = currentYm.add({ years: 1 });
+        expiryInput.value = extendedYm.toString();
+        renderRewardsExpiration(extendedYm);
+      });
+
+      birthdayBtn.addEventListener('click', () => {
+        renderBirthdayPerk(birthdayInput.value.trim());
+      });
+
+      birthdayInput.addEventListener('change', (e) => {
+        renderBirthdayPerk(e.target.value.trim());
+      });
+
+      timeInput.addEventListener('change', (e) => {
+        renderShopHours(e.target.value);
+      });
+
+      currentTimeBtn.addEventListener('click', () => {
+        const freshNow = Temporal.Now.plainTimeISO();
+        timeInput.value = freshNow.toString({ smallestUnit: 'minute' });
+        renderShopHours(freshNow);
+      });
+    }
+
+    if (document.readyState === 'loading') {
+      document.addEventListener('DOMContentLoaded', initDailyGrindTemporal);
+    } else {
+      initDailyGrindTemporal();
+    }
+  </script>
 </body>
 
