+  <script>
+    (function () {
+      const board = document.getElementById('kanban-board');
+      const columns = Array.from(document.querySelectorAll('.board-column'));
+      const countBadges = new Map();
+
+      columns.forEach((col) => {
+        const status = col.dataset.column;
+        const badge = col.querySelector('.column-count');
+        if (status && badge) {
+          countBadges.set(status, badge);
+        }
+      });
+
+      let draggedCard = null;
+      let activeDropColumn = null;
+      let rafId = null;
+      let nextOrderNumber = 107;
+
+      const sampleDrinks = [
+        { name: 'Maple Oat Latte', desc: 'Creamy oat milk with a hint of Vermont maple syrup.', size: '16oz Iced' },
+        { name: 'Dark Roast Espresso', desc: 'Bold, smokey, and perfect for a morning boost.', size: 'Double Shot' },
+        { name: 'Cold Brew', desc: 'Steeped for 18 hours for maximum smoothness.', size: '20oz Nitro' },
+        { name: 'Cinnamon Oat Cappuccino', desc: 'Velvety oat foam dusted with Ceylon cinnamon.', size: '12oz Hot' },
+        { name: 'Vanilla Bean Cold Foam Brew', desc: 'Slow-steeped cold brew topped with sweet vanilla cream.', size: '16oz Iced' }
+      ];
+      const sampleCustomers = ['Taylor B.', 'Morgan L.', 'Casey D.', 'Jamie V.', 'Riley N.', 'Avery P.'];
+
+      function updateCounts() {
+        for (let i = 0; i < columns.length; i++) {
+          const col = columns[i];
+          const status = col.dataset.column;
+          const badge = countBadges.get(status);
+          if (badge) {
+            // Fast count without layout reads: total children minus the sticky header
+            const cardCount = col.querySelectorAll('.card').length;
+            badge.textContent = String(cardCount);
+          }
+        }
+      }
+
+      function clearDragOverStates() {
+        for (let i = 0; i < columns.length; i++) {
+          columns[i].classList.remove('drag-over');
+        }
+        activeDropColumn = null;
+      }
+
+      // Event delegation on the board for zero-overhead listener management with large order volumes
+      board.addEventListener('dragstart', (e) => {
+        const card = e.target.closest('.card');
+        if (!card) return;
+
+        draggedCard = card;
+        if (e.dataTransfer) {
+          e.dataTransfer.effectAllowed = 'move';
+          try {
+            e.dataTransfer.setData('text/plain', card.id);
+          } catch (_) {
+            // Ignore in synthetic test environments without full DataTransfer implementation
+          }
+        }
+
+        requestAnimationFrame(() => {
+          if (draggedCard === card) {
+            card.classList.add('dragging');
+          }
+        });
+      });
+
+      board.addEventListener('dragend', (e) => {
+        const card = e.target.closest('.card') || draggedCard;
+        if (card) {
+          card.classList.remove('dragging');
+          card.style.transform = 'translate3d(0, 0, 0)';
+        }
+        draggedCard = null;
+        if (rafId) {
+          cancelAnimationFrame(rafId);
+          rafId = null;
+        }
+        clearDragOverStates();
+      });
+
+      board.addEventListener('dragenter', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+
+        if (activeDropColumn !== column) {
+          if (activeDropColumn) {
+            activeDropColumn.classList.remove('drag-over');
+          }
+          activeDropColumn = column;
+          column.classList.add('drag-over');
+        }
+      });
+
+      board.addEventListener('dragover', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+        if (e.dataTransfer) {
+          e.dataTransfer.dropEffect = 'move';
+        }
+
+        if (activeDropColumn !== column && !rafId) {
+          rafId = requestAnimationFrame(() => {
+            if (activeDropColumn && activeDropColumn !== column) {
+              activeDropColumn.classList.remove('drag-over');
+            }
+            activeDropColumn = column;
+            column.classList.add('drag-over');
+            rafId = null;
+          });
+        }
+      });
+
+      board.addEventListener('dragleave', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        const related = e.relatedTarget;
+        if (!related || !column.contains(related)) {
+          column.classList.remove('drag-over');
+          if (activeDropColumn === column) {
+            activeDropColumn = null;
+          }
+        }
+      });
+
+      board.addEventListener('drop', (e) => {
+        const column = e.target.closest('.board-column');
+        if (!column) return;
+        e.preventDefault();
+
+        let card = draggedCard;
+        if (!card && e.dataTransfer) {
+          try {
+            const cardId = e.dataTransfer.getData('text/plain');
+            if (cardId) {
+              card = document.getElementById(cardId);
+            }
+          } catch (_) {
+            // Fallback if dataTransfer isn't populated
+          }
+        }
+
+        if (!card) return;
+
+        const targetCard = e.target.closest('.card');
+        if (targetCard && targetCard !== card && targetCard.parentElement === column) {
+          column.insertBefore(card, targetCard);
+        } else {
+          column.appendChild(card);
+        }
+
+        const newStatus = column.dataset.column || '';
+        card.dataset.status = newStatus;
+        card.classList.remove('dragging');
+
+        // GPU-composited settle animation without triggering layout reflow
+        card.style.transform = 'translate3d(0, -4px, 0)';
+        requestAnimationFrame(() => {
+          card.style.transform = 'translate3d(0, 0, 0)';
+        });
+
+        clearDragOverStates();
+        draggedCard = null;
+        updateCounts();
+      });
+
+      function createOrderCardElement(orderNum, drink, customer, status) {
+        const card = document.createElement('div');
+        card.className = 'card';
+        card.id = 'order-' + orderNum;
+        card.draggable = true;
+        card.dataset.orderId = String(orderNum);
+        card.dataset.status = status;
+
+        card.innerHTML =
+          '<div class="card-top">' +
+            '<span>#' + orderNum + ' &bull; Mobile App</span>' +
+            '<span class="badge">' + drink.size + '</span>' +
+          '</div>' +
+          '<h3>' + drink.name + '</h3>' +
+          '<p>' + drink.desc + '</p>' +
+          '<div class="card-meta">' +
+            '<span>For: ' + customer + '</span>' +
+            '<span>Just now</span>' +
+          '</div>';
+        return card;
+      }
+
+      // Batch DOM insertion via DocumentFragment + requestAnimationFrame to prevent layout thrashing
+      function addOrdersBatch(count) {
+        const queuedColumn = document.getElementById('queued');
+        if (!queuedColumn) return;
+
+        requestAnimationFrame(() => {
+          const fragment = document.createDocumentFragment();
+          for (let i = 0; i < count; i++) {
+            const drink = sampleDrinks[nextOrderNumber % sampleDrinks.length];
+            const customer = sampleCustomers[nextOrderNumber % sampleCustomers.length];
+            const card = createOrderCardElement(nextOrderNumber++, drink, customer, 'queued');
+            fragment.appendChild(card);
+          }
+          queuedColumn.appendChild(fragment);
+          updateCounts();
+        });
+      }
+
+      const addOrderBtn = document.getElementById('add-order-btn');
+      if (addOrderBtn) {
+        addOrderBtn.addEventListener('click', () => addOrdersBatch(1));
+      }
+
+      const rushOrderBtn = document.getElementById('rush-order-btn');
+      if (rushOrderBtn) {
+        rushOrderBtn.addEventListener('click', () => addOrdersBatch(25));
+      }
+    })();
+  </script>
+
 </body>
 
 </html>
