+  <script>
+    (function () {
+      const board = document.getElementById('order-board');
+      if (!board) return;
+
+      let draggedCard = null;
+
+      // Move a DOM node while preserving element state when supported,
+      // scoped inside the target column's containment boundary.
+      function moveNodeToContainer(node, container, referenceNode = null) {
+        if ('moveBefore' in Element.prototype && node.isConnected && container.isConnected) {
+          try {
+            container.moveBefore(node, referenceNode);
+            return;
+          } catch (_) {
+            // Fall through to standard DOM insertion if moveBefore is disallowed
+          }
+        }
+        container.insertBefore(node, referenceNode);
+      }
+
+      function updateColumnCounts() {
+        const columns = board.querySelectorAll('.board-column');
+        columns.forEach((col) => {
+          const status = col.getAttribute('data-status');
+          const countEl = col.querySelector(`[data-count-for="${status}"]`);
+          const cardList = col.querySelector('.column-cards') || col;
+          const count = cardList.querySelectorAll('.card').length;
+          if (countEl) {
+            countEl.textContent = String(count);
+          }
+        });
+      }
+
+      function updateCardActionLabel(card, status) {
+        const btn = card.querySelector('.advance-btn');
+        if (!btn) return;
+        if (status === 'ready') {
+          btn.innerHTML = 'Complete &check;';
+        } else {
+          btn.innerHTML = 'Next Stage &rarr;';
+        }
+      }
+
+      function getDragAfterElement(container, y) {
+        const draggableElements = [...container.querySelectorAll('.card:not(.dragging)')];
+        let closest = { offset: Number.NEGATIVE_INFINITY, element: null };
+
+        for (const child of draggableElements) {
+          const box = child.getBoundingClientRect();
+          const offset = y - box.top - box.height / 2;
+          if (offset < 0 && offset > closest.offset) {
+            closest = { offset, element: child };
+          }
+        }
+        return closest.element;
+      }
+
+      board.addEventListener('dragstart', (event) => {
+        const card = event.target.closest('.board-column .card');
+        if (!card) return;
+        draggedCard = card;
+        card.classList.add('dragging');
+        if (event.dataTransfer) {
+          event.dataTransfer.effectAllowed = 'move';
+          event.dataTransfer.setData('text/plain', card.id);
+        }
+      });
+
+      board.addEventListener('dragend', () => {
+        if (draggedCard) {
+          draggedCard.classList.remove('dragging');
+          draggedCard = null;
+        }
+        board.querySelectorAll('.board-column.drag-over').forEach((col) => {
+          col.classList.remove('drag-over');
+        });
+      });
+
+      board.addEventListener('dragover', (event) => {
+        const column = event.target.closest('.board-column');
+        if (!column) return;
+        event.preventDefault();
+        if (event.dataTransfer) {
+          event.dataTransfer.dropEffect = 'move';
+        }
+        if (!column.classList.contains('drag-over')) {
+          board.querySelectorAll('.board-column.drag-over').forEach((col) => {
+            if (col !== column) col.classList.remove('drag-over');
+          });
+          column.classList.add('drag-over');
+        }
+      });
+
+      board.addEventListener('dragleave', (event) => {
+        const column = event.target.closest('.board-column');
+        if (!column) return;
+        if (!column.contains(event.relatedTarget)) {
+          column.classList.remove('drag-over');
+        }
+      });
+
+      board.addEventListener('drop', (event) => {
+        const column = event.target.closest('.board-column');
+        if (!column) return;
+        event.preventDefault();
+        column.classList.remove('drag-over');
+
+        const cardId = event.dataTransfer ? event.dataTransfer.getData('text/plain') : '';
+        const card = draggedCard || (cardId ? document.getElementById(cardId) : null);
+        if (!card) return;
+
+        const targetContainer = column.querySelector('.column-cards') || column;
+        const afterElement = getDragAfterElement(targetContainer, event.clientY);
+        moveNodeToContainer(card, targetContainer, afterElement);
+
+        const newStatus = column.getAttribute('data-status');
+        updateCardActionLabel(card, newStatus);
+        updateColumnCounts();
+      });
+
+      // Handle quick-advance buttons inside cards
+      board.addEventListener('click', (event) => {
+        const btn = event.target.closest('.advance-btn');
+        if (!btn) return;
+        const card = btn.closest('.card');
+        const currentColumn = btn.closest('.board-column');
+        if (!card || !currentColumn) return;
+
+        const status = currentColumn.getAttribute('data-status');
+        const nextStatusMap = { queued: 'brewing', brewing: 'ready', ready: 'queued' };
+        const nextStatus = nextStatusMap[status] || 'queued';
+        const nextColumn = board.querySelector(`.board-column[data-status="${nextStatus}"]`);
+        if (!nextColumn) return;
+
+        const targetContainer = nextColumn.querySelector('.column-cards') || nextColumn;
+        moveNodeToContainer(card, targetContainer, null);
+        updateCardActionLabel(card, nextStatus);
+        updateColumnCounts();
+      });
+
+      // Bulk order generator for high-volume rush simulation
+      let nextOrderNum = 103;
+      const sampleDrinks = [
+        { name: 'Maple Oat Latte', badge: 'Hot • 12oz', desc: 'Creamy oat milk with Vermont maple syrup.' },
+        { name: 'Dark Roast Espresso', badge: 'Double Shot', desc: 'Bold, smokey, pulled fresh to order.' },
+        { name: 'Cold Brew', badge: 'Iced • 16oz', desc: 'Steeped for 18 hours for maximum smoothness.' }
+      ];
+      const sampleCustomers = ['Morgan P.', 'Casey L.', 'Riley T.', 'Jamie S.', 'Avery D.', 'Quinn B.'];
+
+      async function yieldToMain() {
+        if ('scheduler' in window && 'yield' in scheduler) {
+          return await scheduler.yield();
+        }
+        return new Promise((resolve) => setTimeout(resolve, 0));
+      }
+
+      const addBatchBtn = document.getElementById('add-sample-orders');
+      if (addBatchBtn) {
+        addBatchBtn.addEventListener('click', async () => {
+          const queuedCol = document.getElementById('queued');
+          const container = queuedCol ? (queuedCol.querySelector('.column-cards') || queuedCol) : null;
+          if (!container) return;
+
+          const fragment = document.createDocumentFragment();
+          for (let i = 0; i < 20; i++) {
+            const drink = sampleDrinks[i % sampleDrinks.length];
+            const customer = sampleCustomers[i % sampleCustomers.length];
+            const orderId = nextOrderNum++;
+
+            const article = document.createElement('article');
+            article.className = 'card';
+            article.id = `order-${orderId}`;
+            article.draggable = true;
+            article.setAttribute('data-order-id', String(orderId));
+            article.innerHTML = `
+              <div class="card-meta">
+                <span>#${orderId} • ${customer}</span>
+                <span class="order-badge">${drink.badge}</span>
+              </div>
+              <h3>${drink.name}</h3>
+              <p>${drink.desc}</p>
+              <footer class="card-actions">
+                <span>Just now</span>
+                <button type="button" class="advance-btn" aria-label="Move ${drink.name} to next stage">Next Stage &rarr;</button>
+              </footer>
+            `;
+            fragment.appendChild(article);
+
+            if ((i + 1) % 50 === 0) {
+              await yieldToMain();
+            }
+          }
+          container.appendChild(fragment);
+          updateColumnCounts();
+        });
+      }
+    })();
+  </script>
 </body>
 
 </html>
