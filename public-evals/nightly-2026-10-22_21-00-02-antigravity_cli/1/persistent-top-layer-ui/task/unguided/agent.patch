+  <script>
+    (function () {
+      const dialog = document.getElementById('feedback-dialog');
+      const moveBtn = document.getElementById('move-dialog-btn');
+      const openBtn = document.getElementById('open-feedback-btn');
+      const closeBtn = document.getElementById('close-feedback-btn');
+      const form = document.getElementById('feedback-form');
+      const messageInput = document.getElementById('feedback-message');
+      const hostBadge = document.getElementById('dialog-host-badge');
+      const apiBadge = document.getElementById('dialog-api-badge');
+      const feedbackStatus = document.getElementById('feedback-status');
+
+      const slots = [
+        document.getElementById('feedback-slot-main'),
+        document.getElementById('feedback-slot-footer'),
+        document.getElementById('feedback-slot-hero')
+      ];
+
+      let lastFocusedControl = messageInput;
+      let moveCount = 0;
+
+      // Track the most recently focused interactive element inside the dialog
+      dialog.addEventListener('focusin', function (event) {
+        if (event.target && event.target !== dialog && dialog.contains(event.target)) {
+          lastFocusedControl = event.target;
+        }
+      });
+
+      // Keep focus on the currently focused control inside the dialog when clicking the move button
+      moveBtn.addEventListener('mousedown', function (event) {
+        if (dialog.contains(document.activeElement) && document.activeElement !== document.body) {
+          event.preventDefault();
+        }
+      });
+
+      function openFeedbackModal() {
+        if (!dialog.open) {
+          if (typeof dialog.showModal === 'function') {
+            dialog.showModal();
+          } else if (typeof dialog.show === 'function') {
+            dialog.show();
+          } else {
+            dialog.setAttribute('open', '');
+          }
+        }
+        if (!dialog.contains(document.activeElement)) {
+          const target = (lastFocusedControl && dialog.contains(lastFocusedControl))
+            ? lastFocusedControl
+            : messageInput;
+          if (target && typeof target.focus === 'function') {
+            target.focus({ preventScroll: true });
+          }
+        }
+      }
+
+      function updateSlotIndicators(activeSlot, methodUsed) {
+        slots.forEach(function (slot) {
+          if (!slot) return;
+          const isCurrent = slot === activeSlot;
+          slot.classList.toggle('active-slot', isCurrent);
+          const statusEl = slot.querySelector('.slot-status');
+          if (statusEl) {
+            statusEl.textContent = isCurrent ? 'Active Parent' : 'Standby';
+          }
+        });
+
+        const label = (activeSlot && activeSlot.dataset.slotLabel) || (activeSlot && activeSlot.id) || 'Custom Host';
+        if (hostBadge) {
+          hostBadge.textContent = 'Host: ' + label;
+        }
+        if (apiBadge && methodUsed) {
+          apiBadge.textContent = 'API: ' + methodUsed;
+        }
+      }
+
+      /**
+       * Relocates the open <dialog> to targetParent using the state-preserving
+       * ParentNode.prototype.moveBefore API when available, with a fallback
+       * that manually re-opens and restores modal + focus state in unsupported browsers.
+       */
+      function relocateDialog(targetParent, referenceNode) {
+        const ref = referenceNode === undefined ? null : referenceNode;
+        if (!targetParent) return;
+
+        // Ensure dialog is open before relocating
+        if (!dialog.open) {
+          openFeedbackModal();
+        }
+
+        const wasOpen = dialog.open;
+        let wasModal = true;
+        if (wasOpen && typeof dialog.matches === 'function') {
+          try {
+            wasModal = dialog.matches(':modal');
+          } catch (_) {
+            wasModal = true;
+          }
+        }
+
+        const currentActive = document.activeElement;
+        const focusTarget = (currentActive && dialog.contains(currentActive) && currentActive !== dialog)
+          ? currentActive
+          : ((lastFocusedControl && dialog.contains(lastFocusedControl))
+              ? lastFocusedControl
+              : (messageInput || moveBtn));
+
+        // Save text selection state if an input/textarea is focused
+        let selStart = null;
+        let selEnd = null;
+        let selDir = null;
+        if (focusTarget && typeof focusTarget.selectionStart === 'number') {
+          try {
+            selStart = focusTarget.selectionStart;
+            selEnd = focusTarget.selectionEnd;
+            selDir = focusTarget.selectionDirection;
+          } catch (_) {}
+        }
+
+        const scrollTop = dialog.scrollTop;
+        const scrollLeft = dialog.scrollLeft;
+
+        let usedNativeMoveBefore = false;
+
+        if (typeof targetParent.moveBefore === 'function') {
+          try {
+            targetParent.moveBefore(dialog, ref);
+            usedNativeMoveBefore = true;
+          } catch (_) {
+            usedNativeMoveBefore = false;
+          }
+        }
+
+        if (!usedNativeMoveBefore) {
+          // Fallback for browsers without moveBefore support:
+          // Standard insertBefore removes and re-inserts the <dialog>, which closes it and drops focus.
+          targetParent.insertBefore(dialog, ref);
+
+          if (wasOpen && !dialog.open) {
+            if (wasModal && typeof dialog.showModal === 'function') {
+              dialog.showModal();
+            } else if (typeof dialog.show === 'function') {
+              dialog.show();
+            } else {
+              dialog.setAttribute('open', '');
+            }
+          }
+
+          dialog.scrollTop = scrollTop;
+          dialog.scrollLeft = scrollLeft;
+
+          if (focusTarget && typeof focusTarget.focus === 'function') {
+            focusTarget.focus({ preventScroll: true });
+            if (selStart !== null && selEnd !== null && typeof focusTarget.setSelectionRange === 'function') {
+              try {
+                focusTarget.setSelectionRange(selStart, selEnd, selDir || 'none');
+              } catch (_) {}
+            }
+          }
+        } else {
+          // Verify modal stays open and focus-active even if focus wasn't inside dialog prior to click
+          if (wasOpen && !dialog.open) {
+            if (wasModal && typeof dialog.showModal === 'function') {
+              dialog.showModal();
+            } else {
+              dialog.setAttribute('open', '');
+            }
+          }
+          if (!dialog.contains(document.activeElement) && focusTarget && typeof focusTarget.focus === 'function') {
+            focusTarget.focus({ preventScroll: true });
+          }
+        }
+
+        moveCount += 1;
+        dialog.dataset.moveCount = String(moveCount);
+        dialog.dataset.currentSlot = targetParent.id || '';
+        const methodLabel = usedNativeMoveBefore ? 'moveBefore' : 'fallback';
+        dialog.dataset.moveMethod = methodLabel;
+
+        updateSlotIndicators(targetParent, methodLabel);
+        if (feedbackStatus) {
+          const hostName = targetParent.dataset.slotLabel || targetParent.id || 'new container';
+          feedbackStatus.textContent = 'Relocated to ' + hostName + ' via ' + methodLabel + '.';
+        }
+      }
+
+      moveBtn.addEventListener('click', function () {
+        const currentParent = dialog.parentElement;
+        const currentIdx = slots.indexOf(currentParent);
+        const nextIdx = currentIdx === -1 ? 0 : (currentIdx + 1) % slots.length;
+        const nextSlot = slots[nextIdx] === currentParent
+          ? slots[(nextIdx + 1) % slots.length]
+          : slots[nextIdx];
+
+        relocateDialog(nextSlot, null);
+      });
+
+      openBtn.addEventListener('click', function () {
+        openFeedbackModal();
+      });
+
+      closeBtn.addEventListener('click', function () {
+        if (dialog.open) {
+          dialog.close();
+        }
+      });
+
+      form.addEventListener('submit', function (event) {
+        event.preventDefault();
+        if (feedbackStatus) {
+          feedbackStatus.textContent = 'Thank you! Your feedback has been saved.';
+        }
+      });
+
+      // Open the persistent feedback modal on initial load and ensure focus is active inside it
+      openFeedbackModal();
+    })();
+  </script>
