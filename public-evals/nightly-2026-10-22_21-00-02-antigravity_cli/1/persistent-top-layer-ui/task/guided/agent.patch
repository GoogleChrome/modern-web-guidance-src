+  <script type="module">
+    if (!('commandForElement' in HTMLButtonElement.prototype)) {
+      import('https://esm.run/invokers-polyfill').catch(() => {});
+    }
+
+    const dialog = document.getElementById('feedback-dialog');
+    const primaryHost = document.getElementById('primary-dialog-host');
+    const secondaryHost = document.getElementById('secondary-dialog-host');
+    const parentLabel = document.getElementById('dialog-parent-label');
+    const moveMethodBadge = document.getElementById('move-method-badge');
+    const openTriggers = document.querySelectorAll('[commandfor="feedback-dialog"][command="show-modal"]');
+    const closeTriggers = document.querySelectorAll('[commandfor="feedback-dialog"][command="close"]');
+    const moveButtons = document.querySelectorAll('[data-action="move-dialog"]');
+
+    // Ensure open/close buttons work seamlessly even if Invoker Commands aren't natively supported or offline
+    openTriggers.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        if (!dialog.open && typeof dialog.showModal === 'function') {
+          dialog.showModal();
+        }
+      });
+    });
+
+    closeTriggers.forEach((btn) => {
+      btn.addEventListener('click', () => {
+        if (dialog.open && typeof dialog.close === 'function') {
+          dialog.close(btn.value || 'close');
+        }
+      });
+    });
+
+    function relocateDialog() {
+      const currentParent = dialog.parentElement;
+      const targetParent = currentParent === primaryHost ? secondaryHost : primaryHost;
+
+      // Check if moveBefore is supported on Element.prototype
+      if ('moveBefore' in Element.prototype) {
+        // Atomic state-preserving move: keeps modal open and preserves focus/selection state
+        targetParent.moveBefore(dialog, null);
+        moveMethodBadge.textContent = 'Moved via moveBefore()';
+      } else {
+        // Fallback for unsupported browsers: traditional DOM move resets top-layer state and closes <dialog>
+        const wasOpen = dialog.hasAttribute('open') || dialog.matches(':popover-open');
+        const previousActive = document.activeElement;
+        const hadFocusInside = dialog.contains(previousActive);
+        let selectionStart = null;
+        let selectionEnd = null;
+
+        if (hadFocusInside && previousActive && typeof previousActive.selectionStart === 'number') {
+          selectionStart = previousActive.selectionStart;
+          selectionEnd = previousActive.selectionEnd;
+        }
+
+        targetParent.insertBefore(dialog, null);
+
+        // Manually restore modal / popover state and focus
+        if (wasOpen && typeof dialog.showModal === 'function') {
+          dialog.showModal();
+        } else if (wasOpen && typeof dialog.showPopover === 'function') {
+          dialog.showPopover();
+        }
+
+        if (hadFocusInside && previousActive && typeof previousActive.focus === 'function') {
+          previousActive.focus();
+          if (selectionStart !== null && typeof previousActive.setSelectionRange === 'function') {
+            try {
+              previousActive.setSelectionRange(selectionStart, selectionEnd);
+            } catch {
+              // Ignore input types that do not support selection ranges
+            }
+          }
+        }
+
+        moveMethodBadge.textContent = 'Moved via fallback';
+      }
+
+      parentLabel.textContent = targetParent.dataset.hostName || targetParent.id;
+    }
+
+    moveButtons.forEach((btn) => {
+      btn.addEventListener('click', relocateDialog);
+    });
+  </script>
