+  <script>
+    (() => {
+      const widget = document.getElementById('roasting-widget');
+      const canvas = document.getElementById('roast-canvas');
+      const tempValueEl = document.getElementById('roast-temp-value');
+      const statusEl = document.getElementById('roast-status');
+      if (!widget || !canvas || !tempValueEl) return;
+
+      const ctx = canvas.getContext('2d');
+      let animationFrameId = null;
+      let tempIntervalId = null;
+      let isRunning = false;
+      let currentTemp = 385.0;
+      let targetDirection = 1;
+
+      // Create coffee beans for the drum simulation
+      const beans = Array.from({ length: 28 }, (_, i) => ({
+        x: 60 + Math.random() * (canvas.width - 120),
+        y: 50 + Math.random() * (canvas.height - 100),
+        vx: (Math.random() - 0.5) * 3.2,
+        vy: (Math.random() - 0.5) * 3.2,
+        angle: Math.random() * Math.PI * 2,
+        vAngle: (Math.random() - 0.5) * 0.08,
+        rx: 12 + (i % 4),
+        ry: 8 + (i % 3),
+        shade: i % 3 === 0 ? '#4e342e' : i % 3 === 1 ? '#5d4037' : '#3e2723'
+      }));
+
+      function drawRoasterFrame() {
+        ctx.clearRect(0, 0, canvas.width, canvas.height);
+
+        // Subtle heat glow at bottom of drum
+        const grad = ctx.createLinearGradient(0, canvas.height - 80, 0, canvas.height);
+        grad.addColorStop(0, 'rgba(255, 171, 64, 0)');
+        grad.addColorStop(1, 'rgba(255, 109, 0, 0.22)');
+        ctx.fillStyle = grad;
+        ctx.fillRect(0, canvas.height - 80, canvas.width, 80);
+
+        for (const b of beans) {
+          b.x += b.vx;
+          b.y += b.vy;
+          b.angle += b.vAngle;
+
+          if (b.x < 30 || b.x > canvas.width - 30) b.vx *= -1;
+          if (b.y < 30 || b.y > canvas.height - 30) b.vy *= -1;
+
+          ctx.save();
+          ctx.translate(b.x, b.y);
+          ctx.rotate(b.angle);
+
+          // Bean body
+          ctx.beginPath();
+          ctx.ellipse(0, 0, b.rx, b.ry, 0, 0, Math.PI * 2);
+          ctx.fillStyle = b.shade;
+          ctx.fill();
+          ctx.lineWidth = 1.5;
+          ctx.strokeStyle = '#8d6e63';
+          ctx.stroke();
+
+          // Bean center crease
+          ctx.beginPath();
+          ctx.moveTo(-b.rx * 0.7, 0);
+          ctx.quadraticCurveTo(0, 2.5, b.rx * 0.7, 0);
+          ctx.strokeStyle = '#271815';
+          ctx.lineWidth = 1.5;
+          ctx.stroke();
+
+          ctx.restore();
+        }
+      }
+
+      function animate() {
+        if (!isRunning) return;
+        drawRoasterFrame();
+        animationFrameId = requestAnimationFrame(animate);
+      }
+
+      function updateTemperature() {
+        const delta = (Math.random() * 1.4 + 0.3) * targetDirection;
+        currentTemp += delta;
+        if (currentTemp >= 435) targetDirection = -1;
+        if (currentTemp <= 375) targetDirection = 1;
+
+        tempValueEl.textContent = currentTemp.toFixed(1);
+        if (statusEl) {
+          if (currentTemp < 395) {
+            statusEl.textContent = 'Maillard Reaction';
+          } else if (currentTemp < 420) {
+            statusEl.textContent = 'First Crack Stage';
+          } else {
+            statusEl.textContent = 'Medium-Dark Development';
+          }
+        }
+      }
+
+      function startSimulation() {
+        if (isRunning) return;
+        isRunning = true;
+        animationFrameId = requestAnimationFrame(animate);
+        tempIntervalId = setInterval(updateTemperature, 800);
+      }
+
+      function stopSimulation() {
+        if (!isRunning) return;
+        isRunning = false;
+        if (animationFrameId !== null) {
+          cancelAnimationFrame(animationFrameId);
+          animationFrameId = null;
+        }
+        if (tempIntervalId !== null) {
+          clearInterval(tempIntervalId);
+          tempIntervalId = null;
+        }
+      }
+
+      // Draw initial static frame so canvas is never blank
+      drawRoasterFrame();
+      startSimulation();
+
+      // Check if content-visibility and contentvisibilityautostatechange are supported
+      const isSupported =
+        'contentVisibility' in document.documentElement.style &&
+        'oncontentvisibilityautostatechange' in window;
+
+      // Direct listener for contentvisibilityautostatechange (does not reliably bubble)
+      widget.addEventListener('contentvisibilityautostatechange', (event) => {
+        if (event.skipped) {
+          // The browser skipped rendering this content.
+          stopSimulation();
+        } else {
+          // The browser is about to render the content.
+          startSimulation();
+        }
+      });
+
+      // Fallback using IntersectionObserver for older browsers lacking native rendering state change support
+      if (!isSupported && 'IntersectionObserver' in window) {
+        const observer = new IntersectionObserver((entries) => {
+          entries.forEach((entry) => {
+            if (entry.isIntersecting) {
+              startSimulation();
+            } else {
+              stopSimulation();
+            }
+          });
+        }, {
+          rootMargin: '200px'
+        });
+
+        observer.observe(widget);
+      }
+    })();
+  </script>
