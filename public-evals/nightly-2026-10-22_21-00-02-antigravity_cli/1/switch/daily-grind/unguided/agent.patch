+      outline: 3px solid var(--focus-ring);
+      outline-offset: 2px;
+    }
+
+    .switch:hover:not(:disabled):not([aria-disabled="true"]) {
+      filter: brightness(1.08);
+    }
+
+    .switch:disabled,
+    .switch[aria-disabled="true"] {
+      opacity: 0.5;
+      cursor: not-allowed;
+    }
+
+    .switch-thumb {
