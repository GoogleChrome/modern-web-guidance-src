+    .switch {
+      position: relative;
+      display: inline-flex;
+      align-items: center;
+      width: 52px;
+      height: 28px;
+      padding: 2px;
+      background-color: var(--switch-off);
+      border: 2px solid transparent;
+      border-radius: 999px;
+      cursor: pointer;
+      transition: background-color 0.25s ease, box-shadow 0.2s ease, opacity 0.2s ease;
+      flex-shrink: 0;
+    }
+
+    .switch[aria-checked="true"] {
+      background-color: var(--switch-on);
+    }
+
+    .switch:focus-visible,
