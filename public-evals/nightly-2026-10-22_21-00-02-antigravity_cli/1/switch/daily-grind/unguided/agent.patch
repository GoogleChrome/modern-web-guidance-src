+  <script>
+    (function () {
+      const liveRegion = document.getElementById('switch-live-region');
+
+      function toggleSwitch(switchEl) {
+        if (switchEl.disabled || switchEl.getAttribute('aria-disabled') === 'true') {
+          return;
+        }
+
+        const isChecked = switchEl.getAttribute('aria-checked') === 'true';
+        const nextState = !isChecked;
+        switchEl.setAttribute('aria-checked', String(nextState));
+
+        if (switchEl.id === 'dark-mode-switch') {
+          if (nextState) {
+            document.body.setAttribute('data-theme', 'dark');
+          } else {
+            document.body.removeAttribute('data-theme');
+          }
+        }
+
+        const labelId = switchEl.getAttribute('aria-labelledby');
+        const labelEl = labelId ? document.getElementById(labelId) : null;
+        const labelText = labelEl ? labelEl.textContent.trim() : (switchEl.getAttribute('aria-label') || 'Switch');
+
+        if (liveRegion) {
+          liveRegion.textContent = `${labelText} ${nextState ? 'enabled' : 'disabled'}`;
+        }
+
+        switchEl.dispatchEvent(
+          new CustomEvent('switch-change', {
+            bubbles: true,
+            detail: { checked: nextState, id: switchEl.id }
+          })
+        );
+      }
+
+      document.querySelectorAll('[role="switch"]').forEach((switchEl) => {
+        switchEl.addEventListener('click', () => {
+          toggleSwitch(switchEl);
+        });
+
+        switchEl.addEventListener('keydown', (event) => {
+          // Native <button> already triggers 'click' on Space and Enter,
+          // but we ensure explicit keyboard support if role="switch" is used on non-button elements.
+          if (switchEl.tagName !== 'BUTTON' && (event.key === ' ' || event.key === 'Enter')) {
+            event.preventDefault();
+            toggleSwitch(switchEl);
+          }
+        });
+      });
+    })();
+  </script>
+
