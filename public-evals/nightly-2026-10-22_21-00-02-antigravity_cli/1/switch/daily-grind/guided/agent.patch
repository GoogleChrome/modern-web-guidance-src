+  <script type="module">
+    if (!('switch' in HTMLInputElement.prototype)) {
+      import('input-switch-polyfill');
+    }
+
+    const statusEl = document.getElementById('preferences-status');
+    const switches = document.querySelectorAll('input[type="checkbox"][switch]');
+
+    switches.forEach((switchInput) => {
+      switchInput.addEventListener('change', (event) => {
+        const target = event.currentTarget;
+        const isChecked = target.checked;
+        const label = document.querySelector(`label[for="${target.id}"]`);
+        const labelText = label ? label.textContent.trim() : target.name;
+        if (statusEl) {
+          statusEl.textContent = `${labelText}: ${isChecked ? 'Enabled' : 'Disabled'}`;
+        }
+      });
+    });
+  </script>
