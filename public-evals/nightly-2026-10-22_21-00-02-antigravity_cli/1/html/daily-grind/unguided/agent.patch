@@ -0,0 +1,25 @@
+// Native <dialog> and Popover API interaction handlers with proper focus management.
+document.addEventListener('DOMContentLoaded', () => {
+  const orderBtn = document.getElementById('open-order-modal');
+  const orderDialog = document.getElementById('order-dialog');
+
+  if (orderBtn && orderDialog instanceof HTMLDialogElement) {
+    orderBtn.addEventListener('click', (event) => {
+      event.preventDefault();
+      orderDialog.showModal();
+    });
+
+    // Close modal when clicking on the backdrop outside the dialog box
+    orderDialog.addEventListener('click', (event) => {
+      const rect = orderDialog.getBoundingClientRect();
+      const clickedOutside =
+        event.clientX < rect.left ||
+        event.clientX > rect.right ||
+        event.clientY < rect.top ||
+        event.clientY > rect.bottom;
+      if (clickedOutside) {
+        orderDialog.close();
+      }
+    });
+  }
+});
