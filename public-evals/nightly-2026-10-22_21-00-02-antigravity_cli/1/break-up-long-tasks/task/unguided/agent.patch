+
+      const BREW_MODIFIERS = {
+        'pour-over': { acidity: 1.08, body: 0.92, sweetness: 1.05, aroma: 1.1 },
+        'espresso': { acidity: 0.95, body: 1.18, sweetness: 1.02, aroma: 1.05 },
+        'immersion': { acidity: 0.88, body: 1.12, sweetness: 1.04, aroma: 0.96 }
+      };
+
+      /**
+       * Yields control back to the main thread so the browser can handle
+       * user input, rendering updates, and high-priority tasks without blocking.
+       */
+      function yieldToMain() {
+        if (typeof scheduler !== 'undefined' && typeof scheduler.yield === 'function') {
+          return scheduler.yield();
+        }
+        return new Promise(function (resolve) {
+          setTimeout(resolve, 0);
+        });
+      }
+
+      /**
+       * Determines whether the current task slice should yield to the main thread
+       * based on pending input, elapsed chunk duration (budget < 5ms), or chunk count.
+       */
+      function shouldYield(chunkStartTime, itemsInChunk, maxChunkItems) {
+        if (itemsInChunk >= maxChunkItems) {
+          return true;
+        }
+        if (
+          typeof navigator !== 'undefined' &&
+          navigator.scheduling &&
+          typeof navigator.scheduling.isInputPending === 'function' &&
+          navigator.scheduling.isInputPending()
+        ) {
+          return true;
+        }
+        return (performance.now() - chunkStartTime) >= 4;
+      }
+
+      function createRecipeAtIndex(i) {
+        const primaryIdx = i % ORIGINS.length;
+        const secondaryIdx = (i * 3 + 1) % ORIGINS.length;
+        const tertiaryIdx = (i * 5 + 2) % ORIGINS.length;
+
+        const r1 = 45 + ((i * 7) % 35);
+        const r2 = 15 + ((i * 11) % (90 - r1 - 10));
+        const r3 = 100 - r1 - r2;
+
+        return {
+          id: i + 1,
+          name: 'Artisanal Blend #' + (1001 + i),
+          components: [
+            { origin: ORIGINS[primaryIdx], ratio: r1 },
+            { origin: ORIGINS[secondaryIdx], ratio: r2 },
+            { origin: ORIGINS[tertiaryIdx], ratio: r3 }
+          ],
+          grindMicrons: 400 + ((i * 19) % 600),
+          waterTempC: 88 + (i % 9)
+        };
+      }
+
+      function simulateSingleRecipe(recipe, config) {
+        const roastMod = ROAST_MODIFIERS[config.roast] || ROAST_MODIFIERS.medium;
+        const brewMod = BREW_MODIFIERS[config.brew] || BREW_MODIFIERS['pour-over'];
+
+        let rawAcidity = 0;
+        let rawBody = 0;
+        let rawSweetness = 0;
+        let rawAroma = 0;
+        const noteSet = new Set();
+
+        for (let c = 0; c < recipe.components.length; c++) {
+          const comp = recipe.components[c];
+          const weight = comp.ratio / 100;
+          rawAcidity += comp.origin.acidity * weight;
+          rawBody += comp.origin.body * weight;
+          rawSweetness += comp.origin.sweetness * weight;
+          rawAroma += comp.origin.aroma * weight;
+          for (let n = 0; n < comp.origin.notes.length; n++) {
+            noteSet.add(comp.origin.notes[n]);
+          }
+        }
+
+        // Simulate extraction kinetics curves across temperature & grind harmonics
+        let extractionFactor = 1.0;
+        for (let step = 1; step <= 18; step++) {
+          const tempFactor = Math.sin((recipe.waterTempC + step) * 0.05) * 0.015;
+          const grindFactor = Math.cos((recipe.grindMicrons - step * 10) * 0.004) * 0.015;
+          extractionFactor += (tempFactor + grindFactor) / 18;
+        }
+
+        const clamp = function (val) {
+          return Math.max(10, Math.min(100, Math.round(val)));
+        };
+
+        const acidity = clamp(rawAcidity * roastMod.acidity * brewMod.acidity * extractionFactor);
+        const body = clamp(rawBody * roastMod.body * brewMod.body * extractionFactor);
+        const sweetness = clamp(rawSweetness * roastMod.sweetness * brewMod.sweetness * extractionFactor);
+        const aroma = clamp(rawAroma * roastMod.aroma * brewMod.aroma * extractionFactor);
+
+        const diffAcidity = Math.abs(acidity - config.targetAcidity);
+        const diffBody = Math.abs(body - config.targetBody);
+        const diffSweetness = Math.abs(sweetness - config.targetSweetness);
+        const diffAroma = Math.abs(aroma - config.targetAroma);
+
+        const avgDeviation = (diffAcidity + diffBody + diffSweetness + diffAroma) / 4;
+        const matchScore = Math.max(10, Math.min(99, Math.round(100 - avgDeviation * 1.15)));
+
+        return {
+          id: recipe.id,
+          name: recipe.name,
+          compositionText: recipe.components
+            .map(function (c) { return c.ratio + '% ' + c.origin.name; })
+            .join(' • '),
+          acidity: acidity,
+          body: body,
+          sweetness: sweetness,
+          aroma: aroma,
+          matchScore: matchScore,
+          notes: Array.from(noteSet).slice(0, 4)
+        };
+      }
