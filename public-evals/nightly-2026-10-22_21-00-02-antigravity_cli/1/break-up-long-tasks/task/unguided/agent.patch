+        { name: 'Kenya AA Nyeri', acidity: 94, body: 68, sweetness: 78, aroma: 90, bitterness: 36, notes: ['Blackcurrant', 'Grapefruit', 'Hibiscus'] },
+        { name: 'Brazil Cerrado', acidity: 48, body: 84, sweetness: 82, aroma: 72, bitterness: 54, notes: ['Hazelnut', 'Dark Chocolate', 'Molasses'] },
