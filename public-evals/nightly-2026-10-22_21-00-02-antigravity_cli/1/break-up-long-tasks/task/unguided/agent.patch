+        medium: { acidity: 1.0, body: 1.0, sweetness: 1.06, aroma: 1.0, bitterness: 1.0 },
+        dark: { acidity: 0.78, body: 1.15, sweetness: 0.92, aroma: 0.9, bitterness: 1.25 }
