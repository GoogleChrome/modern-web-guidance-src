+            yieldCount++;
+
+            const processedCount = i + 1;
+            const pct = Math.round((processedCount / total) * 100);
+            const avgChunkMs = (totalChunkDuration / chunkCount).toFixed(2);
+            const avgScore = Math.round(scoreSum / processedCount);
+
+            progressPctEl.textContent = pct + '%';
+            progressFillEl.style.width = pct + '%';
+            progressBarEl.setAttribute('aria-valuenow', String(pct));
+            metricProcessedEl.textContent = processedCount.toLocaleString() + ' / ' + total.toLocaleString();
+            metricYieldsEl.textContent = String(yieldCount);
+            metricChunkTimeEl.textContent = avgChunkMs + ' ms';
+            metricAvgScoreEl.textContent = avgScore + '%';
+
+            // Yield to the main thread so user interactions and rendering never block
+            await yieldToMain();
+
+            chunkStartTime = performance.now();
+            itemsInChunk = 0;
+          }
+        }
+
+        if (runId !== currentRunId) {
+          return;
+        }
+
+        latestSimulatedResults = simulated;
+        isRunning = false;
+        runBtn.disabled = false;
+        cancelBtn.disabled = true;
+        statusTextEl.textContent = 'Simulation complete (' + total.toLocaleString() + ' blends evaluated across ' + yieldCount + ' yielded slices)';
+
+        renderTopBlends(latestSimulatedResults, blendFilterInput.value);
+      }
+
+      runBtn.addEventListener('click', function () {
+        runBatchSimulation();
+      });
+
+      cancelBtn.addEventListener('click', function () {
+        if (!isRunning) return;
+        currentRunId++;
+        isRunning = false;
+        runBtn.disabled = false;
+        cancelBtn.disabled = true;
+        statusTextEl.textContent = 'Simulation paused by user';
+      });
+
+      blendFilterInput.addEventListener('input', function () {
+        if (latestSimulatedResults.length > 0) {
+          renderTopBlends(latestSimulatedResults, blendFilterInput.value);
+        }
+      });
+
+      // Run initial non-blocking simulation on page load
+      if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', function () {
+          runBatchSimulation();
+        });
+      } else {
+        runBatchSimulation();
+      }
+    })();
+  </script>
 </body>
 
 </html>
