+  <script>
+    (() => {
+      const ORIGINS = [
+        { name: 'Ethiopia Yirgacheffe', acidity: 9.2, body: 5.5, sweetness: 8.4, bitterness: 2.8, aroma: 9.5, notes: 'Jasmine, Bergamot, Peach' },
+        { name: 'Colombia Huila', acidity: 7.5, body: 7.2, sweetness: 8.8, bitterness: 3.5, aroma: 8.2, notes: 'Caramel, Red Apple, Citrus' },
+        { name: 'Sumatra Mandheling', acidity: 4.2, body: 9.4, sweetness: 6.5, bitterness: 7.2, aroma: 7.8, notes: 'Dark Chocolate, Cedar, Earthy' },
+        { name: 'Guatemala Antigua', acidity: 7.0, body: 7.8, sweetness: 8.0, bitterness: 4.5, aroma: 8.5, notes: 'Cocoa, Brown Spice, Orange' },
+        { name: 'Brazil Cerrado', acidity: 5.0, body: 8.2, sweetness: 7.9, bitterness: 5.5, aroma: 7.2, notes: 'Roasted Hazelnut, Milk Chocolate' },
+        { name: 'Kenya AA', acidity: 9.5, body: 6.8, sweetness: 7.8, bitterness: 3.2, aroma: 9.1, notes: 'Blackcurrant, Grapefruit, Winey' }
+      ];
+
+      const ROAST_TARGETS = {
+        light: { acidity: 8.8, body: 6.0, sweetness: 8.2, bitterness: 3.0, aroma: 9.2 },
+        medium: { acidity: 7.2, body: 7.5, sweetness: 8.5, bitterness: 4.2, aroma: 8.4 },
+        dark: { acidity: 4.8, body: 9.0, sweetness: 7.0, bitterness: 6.8, aroma: 7.8 }
+      };
+
+      const batchSizeEl = document.getElementById('batch-size');
+      const roastTargetEl = document.getElementById('roast-target');
+      const brewMethodEl = document.getElementById('brew-method');
+      const waterTempEl = document.getElementById('water-temp');
+      const tempDisplayEl = document.getElementById('temp-display');
+      const runBtn = document.getElementById('run-sim-btn');
+      const cancelBtn = document.getElementById('cancel-sim-btn');
+      const testResponsiveBtn = document.getElementById('test-responsive-btn');
+      const clickCounterEl = document.getElementById('click-counter');
+      const statusTextEl = document.getElementById('sim-status-text');
+      const progressPctEl = document.getElementById('sim-progress-pct');
+      const progressFillEl = document.getElementById('sim-progress-fill');
+      const progressBarEl = document.getElementById('sim-progressbar');
+      const statProcessedEl = document.getElementById('stat-processed');
+      const statYieldsEl = document.getElementById('stat-yields');
+      const statBestScoreEl = document.getElementById('stat-best-score');
+      const statElapsedEl = document.getElementById('stat-elapsed');
+      const resultsGridEl = document.getElementById('sim-results-grid');
+
+      let clickCount = 0;
+      let cancelRequested = false;
+
+      waterTempEl.addEventListener('input', () => {
+        tempDisplayEl.textContent = waterTempEl.value;
+      });
+
+      testResponsiveBtn.addEventListener('click', () => {
+        clickCount += 1;
+        clickCounterEl.textContent = String(clickCount);
+      });
+
+      cancelBtn.addEventListener('click', () => {
+        cancelRequested = true;
+      });
+
+      // Generate a deterministic or pseudo-random recipe blend item and run thermodynamics extraction simulation
+      function simulateBlendItem(index, targetProfile, brewMethod, waterTemp) {
+        // Select 3 distinct origins per blend based on index
+        const o1 = ORIGINS[index % ORIGINS.length];
+        const o2 = ORIGINS[(index * 7 + 1) % ORIGINS.length];
+        const o3 = ORIGINS[(index * 13 + 3) % ORIGINS.length];
+
+        // Compute normalized ratios
+        const r1 = ((index * 31) % 60) + 20;
+        const r2 = ((index * 17) % (85 - r1)) + 10;
+        const r3 = 100 - r1 - r2;
+
+        const w1 = r1 / 100;
+        const w2 = r2 / 100;
+        const w3 = r3 / 100;
+
+        // Multi-step extraction curve integration across 120 micro-intervals to simulate heavy CPU work per recipe
+        const tempFactor = (waterTemp - 85) / 13; // 0..1
+        const methodPressure = brewMethod === 'espresso' ? 1.25 : brewMethod === 'pourover' ? 1.0 : 0.82;
+
+        let extractedAcidity = 0;
+        let extractedBody = 0;
+        let extractedSweetness = 0;
+        let extractedBitterness = 0;
+        let extractedAroma = 0;
+
+        const baseAcidity = o1.acidity * w1 + o2.acidity * w2 + o3.acidity * w3;
+        const baseBody = o1.body * w1 + o2.body * w2 + o3.body * w3;
+        const baseSweetness = o1.sweetness * w1 + o2.sweetness * w2 + o3.sweetness * w3;
+        const baseBitterness = o1.bitterness * w1 + o2.bitterness * w2 + o3.bitterness * w3;
+        const baseAroma = o1.aroma * w1 + o2.aroma * w2 + o3.aroma * w3;
+
+        const steps = 120;
+        for (let t = 1; t <= steps; t++) {
+          const tau = t / steps;
+          const kinetic = Math.sin(tau * Math.PI) * methodPressure;
+          const thermal = Math.exp(-Math.pow(tau - (0.45 + tempFactor * 0.2), 2) / 0.18);
+          extractedAcidity += baseAcidity * (0.65 + 0.35 * Math.cos(tau * 1.4)) * kinetic / steps;
+          extractedBody += baseBody * (0.55 + 0.45 * thermal) * methodPressure / steps;
+          extractedSweetness += baseSweetness * (0.7 + 0.3 * thermal) / steps;
+          extractedBitterness += baseBitterness * (0.5 + 0.5 * tau * tempFactor) * methodPressure / steps;
+          extractedAroma += baseAroma * (0.6 + 0.4 * Math.sin(tau * 2.1)) / steps;
+        }
+
+        const clamp10 = val => Math.min(10, Math.max(1, Number(val.toFixed(1))));
+        const profile = {
+          acidity: clamp10(extractedAcidity * 1.35),
+          body: clamp10(extractedBody * 1.25),
+          sweetness: clamp10(extractedSweetness * 1.15),
+          bitterness: clamp10(extractedBitterness * 1.3),
+          aroma: clamp10(extractedAroma * 1.3)
+        };
+
+        // Calculate similarity to target roast profile (0 - 100 cupping score)
+        const diff =
+          Math.abs(profile.acidity - targetProfile.acidity) * 2.2 +
+          Math.abs(profile.body - targetProfile.body) * 2.0 +
+          Math.abs(profile.sweetness - targetProfile.sweetness) * 2.5 +
+          Math.abs(profile.bitterness - targetProfile.bitterness) * 1.8 +
+          Math.abs(profile.aroma - targetProfile.aroma) * 2.1;
+
+        const score = Number(Math.max(50, Math.min(99.8, 100 - diff * 1.45)).toFixed(1));
+
+        return {
+          id: index + 1,
+          name: `Blend #${index + 1}`,
+          composition: `${r1}% ${o1.name}, ${r2}% ${o2.name}, ${r3}% ${o3.name}`,
+          notes: `${o1.notes.split(', ')[0]}, ${o2.notes.split(', ')[1] || o2.notes}`,
+          profile,
+          score
+        };
+      }
+
+      function renderTopBlends(topBlends) {
+        resultsGridEl.innerHTML = '';
+        for (const blend of topBlends) {
+          const card = document.createElement('article');
+          card.className = 'blend-card';
+
+          const metrics = [
+            ['Acidity', blend.profile.acidity],
+            ['Body', blend.profile.body],
+            ['Sweetness', blend.profile.sweetness],
+            ['Aroma', blend.profile.aroma],
+            ['Bitterness', blend.profile.bitterness]
+          ];
+
+          const barsHtml = metrics.map(([label, val]) => `
+            <div class="flavor-bar-row">
+              <span>${label}</span>
+              <div class="flavor-bar-bg">
+                <div class="flavor-bar-fill" style="width: ${val * 10}%"></div>
+              </div>
+              <span>${val}/10</span>
+            </div>
+          `).join('');
+
+          card.innerHTML = `
+            <div class="blend-card-header">
+              <h3>${blend.name}</h3>
+              <span class="blend-score">${blend.score} pts</span>
+            </div>
+            <p class="blend-composition"><strong>Ratio:</strong> ${blend.composition}</p>
+            <p class="blend-composition"><strong>Tasting Notes:</strong> ${blend.notes}</p>
+            <div class="flavor-bars">${barsHtml}</div>
+          `;
+          resultsGridEl.appendChild(card);
+        }
+      }
+
+      function updateProgressUI(processed, total, yields, bestScore, startTime) {
+        const pct = Math.round((processed / total) * 100);
+        progressPctEl.textContent = `${pct}%`;
+        progressFillEl.style.width = `${pct}%`;
+        progressBarEl.setAttribute('aria-valuenow', String(pct));
+        statProcessedEl.textContent = processed.toLocaleString();
+        statYieldsEl.textContent = yields.toLocaleString();
+        statBestScoreEl.textContent = bestScore > 0 ? bestScore.toFixed(1) : '—';
+        statElapsedEl.textContent = `${Math.round(performance.now() - startTime)} ms`;
+      }
+
+      async function processRecipeBatch(items) {
+        const total = items.length;
+        const targetKey = roastTargetEl.value;
+        const targetProfile = ROAST_TARGETS[targetKey] || ROAST_TARGETS.medium;
+        const brewMethod = brewMethodEl.value;
+        const waterTemp = Number(waterTempEl.value);
+
+        const startTime = performance.now();
+        // Set a time-based deadline 50 milliseconds into the future (Long Task threshold)
+        let deadline = performance.now() + 50;
+        let processed = 0;
+        let yields = 0;
+        let topBlends = [];
+
+        for (const itemIndex of items) {
+          if (cancelRequested) {
+            statusTextEl.textContent = `Simulation cancelled at ${processed.toLocaleString()} blends.`;
+            break;
+          }
+
+          const result = simulateBlendItem(itemIndex, targetProfile, brewMethod, waterTemp);
+          processed += 1;
+
+          if (topBlends.length < 3 || result.score > topBlends[topBlends.length - 1].score) {
+            topBlends.push(result);
+            topBlends.sort((a, b) => b.score - a.score);
+            if (topBlends.length > 3) {
+              topBlends.pop();
+            }
+          }
+
+          // Yield to the main thread periodically when the 50ms deadline is exceeded
+          if (performance.now() >= deadline) {
+            yields += 1;
+            const currentBest = topBlends.length > 0 ? topBlends[0].score : 0;
+            statusTextEl.textContent = `Simulating blends... (${processed.toLocaleString()} / ${total.toLocaleString()})`;
+            updateProgressUI(processed, total, yields, currentBest, startTime);
+
+            if ('scheduler' in window && 'yield' in window.scheduler) {
+              await scheduler.yield();
+            } else {
+              await new Promise(resolve => setTimeout(resolve, 0));
+            }
+            deadline = performance.now() + 50;
+          }
+        }
+
+        const finalBest = topBlends.length > 0 ? topBlends[0].score : 0;
+        updateProgressUI(processed, total, yields, finalBest, startTime);
+        if (!cancelRequested) {
+          statusTextEl.textContent = `Completed ${processed.toLocaleString()} recipe blend simulations across ${yields} main-thread yields.`;
+        }
+        renderTopBlends(topBlends);
+      }
+
+      runBtn.addEventListener('click', async () => {
+        const count = Number(batchSizeEl.value) || 10000;
+        const batchItems = Array.from({ length: count }, (_, i) => i);
+
+        cancelRequested = false;
+        runBtn.disabled = true;
+        cancelBtn.disabled = false;
+        statusTextEl.textContent = 'Starting batch flavor simulation...';
+
+        try {
+          await processRecipeBatch(batchItems);
+        } finally {
+          runBtn.disabled = false;
+          cancelBtn.disabled = true;
+        }
+      });
+    })();
+  </script>
