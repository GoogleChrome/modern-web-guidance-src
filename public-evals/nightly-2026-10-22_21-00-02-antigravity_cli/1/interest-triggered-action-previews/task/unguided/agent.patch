+  <script>
+    const seasonalPreview = document.getElementById('seasonal-preview');
+    const defaultPreviewText = 'Select a drink to preview';
+
+    seasonalPreview.addEventListener('interest', (event) => {
+      let source = event.source;
+      if (!source) {
+        try {
+          source = document.querySelector('[interestfor="seasonal-preview"]:interest-source');
+        } catch {}
+      }
+      if (!source) {
+        source = document.querySelector('[interestfor="seasonal-preview"]:hover, [interestfor="seasonal-preview"]:focus');
+      }
+      const drinkName =
+        source?.dataset?.drink ||
+        source?.closest('.card')?.querySelector('h3')?.textContent?.trim() ||
+        'Maple Oat Latte';
+      seasonalPreview.textContent = drinkName;
+      seasonalPreview.classList.add('active');
+    });
+
+    seasonalPreview.addEventListener('loseinterest', () => {
+      seasonalPreview.textContent = defaultPreviewText;
+      seasonalPreview.classList.remove('active');
+    });
+  </script>
+
