+      margin-top: 8px;
+      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
+      width: min(620px, 92vw);
+      display: grid;
+      grid-template-columns: repeat(3, 1fr);
+      gap: 14px;
+    }
+
+    .roast-options-grid {
+      grid-column: 1 / -1;
+      display: grid;
+      grid-template-columns: repeat(3, 1fr);
+      gap: 14px;
+    }
+
+    .roast-select option {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      text-align: center;
+      padding: 14px 12px;
+      border: 2px solid #efebe9;
+      border-radius: 10px;
+      background: var(--light);
+      color: var(--text);
+      cursor: pointer;
+      transition: border-color 0.2s, background-color 0.2s, transform 0.2s, box-shadow 0.2s;
+    }
+
+    .roast-select option:hover,
+    .roast-select option:focus-visible {
+      border-color: var(--accent);
+      background: #fff8e1;
+      transform: translateY(-2px);
+      box-shadow: 0 4px 12px rgba(78, 52, 46, 0.12);
+      outline: none;
+    }
+
+    .roast-select option:checked {
+      border-color: var(--primary);
+      background: #efebe9;
+      box-shadow: 0 4px 12px rgba(78, 52, 46, 0.18);
+    }
+
+    .roast-select option::checkmark {
+      display: none;
+    }
+
+    .roast-select option img {
+      width: 100%;
