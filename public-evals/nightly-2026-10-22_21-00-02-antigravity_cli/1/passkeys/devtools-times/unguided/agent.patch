index 0000000..fb9d937
--- /dev/null
+++ b/src/utils/passkeys.ts
@@ -0,0 +1,407 @@
+import React, { useState, useEffect } from 'react';
+import {
+  KeyIcon,
+  FingerPrintIcon,
+  ShieldCheckIcon,
+  PlusIcon,
+  TrashIcon,
+  PencilSquareIcon,
+  CheckIcon,
+  XMarkIcon,
+  ComputerDesktopIcon,
+  DevicePhoneMobileIcon,
+  CloudIcon,
+  LockClosedIcon,
+  ExclamationTriangleIcon,
+  CheckCircleIcon,
+  InformationCircleIcon,
+} from '@heroicons/react/24/outline';
+
+export interface StoredPasskey {
+  id: string;
+  rawId: string;
+  username: string;
+  userId: string;
+  name: string;
+  createdAt: string;
+  lastUsedAt: string | null;
+  transports: string[];
+  authenticatorAttachment: string;
+  backedUp: boolean;
+  publicKey?: string;
+  algorithm?: number;
+}
+
+export interface UserSession {
+  username: string;
+  userId: string;
+  email: string;
+  authMethod: 'passkey' | 'password';
+  signedInAt: string;
+  lastReauthAt: string;
+}
+
+const PASSKEYS_STORAGE_KEY = 'devtools_times_passkeys';
+const SESSION_STORAGE_KEY = 'devtools_times_session';
+const USERS_STORAGE_KEY = 'devtools_times_users';
+
+export function bufferToBase64url(buffer: ArrayBuffer): string {
+  const bytes = new Uint8Array(buffer);
+  let binary = '';
+  for (let i = 0; i < bytes.byteLength; i++) {
+    binary += String.fromCharCode(bytes[i]);
+  }
+  return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+export function base64urlToBuffer(base64url: string): ArrayBuffer {
+  const padding = '='.repeat((4 - (base64url.length % 4)) % 4);
+  const base64 = (base64url + padding).replace(/-/g, '+').replace(/_/g, '/');
+  const rawData = atob(base64);
+  const outputArray = new Uint8Array(rawData.length);
+  for (let i = 0; i < rawData.length; ++i) {
+    outputArray[i] = rawData.charCodeAt(i);
+  }
+  return outputArray.buffer;
+}
+
+export function generateChallenge(): Uint8Array {
+  const challenge = new Uint8Array(32);
+  if (typeof window !== 'undefined' && window.crypto) {
+    window.crypto.getRandomValues(challenge);
+  }
+  return challenge;
+}
+
+export function getStoredPasskeys(): StoredPasskey[] {
+  if (typeof window === 'undefined') return [];
+  try {
+    const raw = localStorage.getItem(PASSKEYS_STORAGE_KEY);
+    if (!raw) return [];
+    return JSON.parse(raw);
+  } catch {
+    return [];
+  }
+}
+
+export function saveStoredPasskeys(passkeys: StoredPasskey[]): void {
+  if (typeof window === 'undefined') return;
+  localStorage.setItem(PASSKEYS_STORAGE_KEY, JSON.stringify(passkeys));
+  window.dispatchEvent(new CustomEvent('passkeys-updated'));
+}
+
+export function getCurrentSession(): UserSession | null {
+  if (typeof window === 'undefined') return null;
+  try {
+    const raw = localStorage.getItem(SESSION_STORAGE_KEY);
+    if (!raw) return null;
+    return JSON.parse(raw);
+  } catch {
+    return null;
+  }
+}
+
+export function saveCurrentSession(session: UserSession | null): void {
+  if (typeof window === 'undefined') return;
+  if (session) {
+    localStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(session));
+  } else {
+    localStorage.removeItem(SESSION_STORAGE_KEY);
+  }
+  window.dispatchEvent(new CustomEvent('session-updated'));
+}
+
+export function detectDevicePasskeyName(): string {
+  if (typeof navigator === 'undefined') return 'This Device Passkey';
+  const ua = navigator.userAgent;
+  if (/Macintosh|Mac OS X/i.test(ua)) return 'iCloud Keychain / Mac Passkey';
+  if (/iPhone|iPad|iPod/i.test(ua)) return 'iCloud Keychain (iOS)';
+  if (/Android/i.test(ua)) return 'Google Password Manager (Android)';
+  if (/Windows/i.test(ua)) return 'Windows Hello Passkey';
+  if (/Linux/i.test(ua)) return 'Chrome Profile / Linux Passkey';
+  return 'Passkey on This Device';
+}
+
+export async function createWebAuthnPasskey(options: {
+  username: string;
+  userId?: string;
+  passkeyName?: string;
+  authenticatorAttachment?: AuthenticatorAttachment;
+  existingPasskeys?: StoredPasskey[];
+}): Promise<StoredPasskey> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) {
+    throw new Error('WebAuthn passkeys are not supported in this browser.');
+  }
+
+  const userId = options.userId || bufferToBase64url( new TextEncoder().encode(options.username + '-' + Date.now()).buffer );
+  const userIdBuffer = new TextEncoder().encode(userId);
+  const challenge = generateChallenge();
+
+  const excludeCredentials: PublicKeyCredentialDescriptor[] = (options.existingPasskeys || [])
+    .filter((pk) => pk.username.toLowerCase() === options.username.toLowerCase())
+    .map((pk) => {
+      try {
+        return {
+          id: base64urlToBuffer(pk.rawId || pk.id),
+          type: 'public-key' as const,
+          transports: (pk.transports || ['internal', 'hybrid']) as AuthenticatorTransport[],
+        };
+      } catch {
+        return null;
+      }
+    })
+    .filter(Boolean) as PublicKeyCredentialDescriptor[];
+
+  const publicKeyCredentialCreationOptions: PublicKeyCredentialCreationOptions = {
+    challenge: challenge.buffer as ArrayBuffer,
+    rp: {
+      name: 'The DevTools Times',
+      id: window.location.hostname || 'localhost',
+    },
+    user: {
+      id: userIdBuffer,
+      name: options.username,
+      displayName: options.username,
+    },
+    pubKeyCredParams: [
+      { alg: -7, type: 'public-key' },   // ES256
+      { alg: -257, type: 'public-key' }, // RS256
+      { alg: -8, type: 'public-key' },   // EdDSA
+    ],
+    timeout: 60000,
+    attestation: 'none',
+    excludeCredentials,
+    authenticatorSelection: {
+      residentKey: 'required',
+      requireResidentKey: true,
+      userVerification: 'required',
+      ...(options.authenticatorAttachment ? { authenticatorAttachment: options.authenticatorAttachment } : {}),
+    },
+  };
+
+  // Also sync with backend API if possible or local API
+  let serverChallengeId: string | undefined;
+  try {
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    const res = await fetch(`${baseUrl}api/passkeys/register-options`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: options.username, userId }),
+    });
+    if (res.ok) {
+      const serverOpts = await res.json();
+      if (serverOpts.challenge) {
+        publicKeyCredentialCreationOptions.challenge = base64urlToBuffer(serverOpts.challenge);
+        serverChallengeId = serverOpts.challengeId;
+      }
+    }
+  } catch {
+    // Fallback to client-generated challenge if offline
+  }
+
+  const credential = (await navigator.credentials.create({
+    publicKey: publicKeyCredentialCreationOptions,
+  })) as PublicKeyCredential | null;
+
+  if (!credential) {
+    throw new Error('Passkey creation was cancelled or returned no credential.');
+  }
+
+  const response = credential.response as AuthenticatorAttestationResponse;
+  const transports = typeof response.getTransports === 'function' ? response.getTransports() : ['internal', 'hybrid'];
+  const publicKeyBuffer = typeof response.getPublicKey === 'function' ? response.getPublicKey() : null;
+  const publicKeyAlgo = typeof response.getPublicKeyAlgorithm === 'function' ? response.getPublicKeyAlgorithm() : -7;
+
+  // Parse flags from authenticatorData if available to check backup state (BE/BS flags)
+  let backedUp = true;
+  try {
+    if (typeof response.getAuthenticatorData === 'function') {
+      const authData = new Uint8Array(response.getAuthenticatorData());
+      if (authData.length >= 33) {
+        const flags = authData[32];
+        // Bit 4 (0x10) is Backup State (BS)
+        backedUp = (flags & 0x10) !== 0;
+      }
+    }
+  } catch {
+    backedUp = true;
+  }
+
+  const newPasskey: StoredPasskey = {
+    id: credential.id,
+    rawId: bufferToBase64url(credential.rawId),
+    username: options.username,
+    userId,
+    name: options.passkeyName?.trim() || detectDevicePasskeyName(),
+    createdAt: new Date().toISOString(),
+    lastUsedAt: new Date().toISOString(),
+    transports,
+    authenticatorAttachment: (credential as any).authenticatorAttachment || options.authenticatorAttachment || 'platform',
+    backedUp,
+    publicKey: publicKeyBuffer ? bufferToBase64url(publicKeyBuffer) : undefined,
+    algorithm: publicKeyAlgo,
+  };
+
+  // Verify with server endpoint and store
+  try {
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    await fetch(`${baseUrl}api/passkeys/register-verify`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        challengeId: serverChallengeId,
+        passkey: newPasskey,
+        attestationObject: bufferToBase64url(response.attestationObject),
+        clientDataJSON: bufferToBase64url(response.clientDataJSON),
+      }),
+    });
+  } catch {
+    // Continue storing locally
+  }
+
+  const currentPasskeys = getStoredPasskeys();
+  const updated = [...currentPasskeys.filter((p) => p.id !== newPasskey.id), newPasskey];
+  saveStoredPasskeys(updated);
+
+  return newPasskey;
+}
+
+export async function authenticateWithWebAuthnPasskey(options?: {
+  username?: string;
+  mediation?: CredentialMediationRequirement;
+  signal?: AbortSignal;
+  requireReauthForUser?: string;
+}): Promise<{ passkey: StoredPasskey; credential: PublicKeyCredential }> {
+  if (typeof window === 'undefined' || !window.PublicKeyCredential) {
+    throw new Error('WebAuthn passkeys are not supported in this browser.');
+  }
+
+  const challenge = generateChallenge();
+  const storedPasskeys = getStoredPasskeys();
+
+  const targetUsername = options?.requireReauthForUser || options?.username;
+  const matchingPasskeys = targetUsername
+    ? storedPasskeys.filter((p) => p.username.toLowerCase() === targetUsername.toLowerCase())
+    : [];
+
+  const allowCredentials: PublicKeyCredentialDescriptor[] = matchingPasskeys
+    .map((pk) => {
+      try {
+        return {
+          id: base64urlToBuffer(pk.rawId || pk.id),
+          type: 'public-key' as const,
+          transports: (pk.transports || ['internal', 'hybrid']) as AuthenticatorTransport[],
+        };
+      } catch {
+        return null;
+      }
+    })
+    .filter(Boolean) as PublicKeyCredentialDescriptor[];
+
+  const publicKeyCredentialRequestOptions: PublicKeyCredentialRequestOptions = {
+    challenge: challenge.buffer as ArrayBuffer,
+    rpId: window.location.hostname || 'localhost',
+    timeout: 60000,
+    userVerification: 'required',
+    ...(allowCredentials.length > 0 ? { allowCredentials } : {}),
+  };
+
+  let serverChallengeId: string | undefined;
+  try {
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    const res = await fetch(`${baseUrl}api/passkeys/auth-options`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: targetUsername }),
+    });
+    if (res.ok) {
+      const serverOpts = await res.json();
+      if (serverOpts.challenge) {
+        publicKeyCredentialRequestOptions.challenge = base64urlToBuffer(serverOpts.challenge);
+        serverChallengeId = serverOpts.challengeId;
+      }
+    }
+  } catch {
+    // Fallback to client challenge
+  }
+
+  const credential = (await navigator.credentials.get({
+    publicKey: publicKeyCredentialRequestOptions,
+    mediation: options?.mediation,
+    signal: options?.signal,
+  })) as PublicKeyCredential | null;
+
+  if (!credential) {
+    throw new Error('Passkey authentication was cancelled or failed.');
+  }
+
+  const assertionResponse = credential.response as AuthenticatorAssertionResponse;
+  const rawIdB64 = bufferToBase64url(credential.rawId);
+
+  let matchedPasskey = storedPasskeys.find(
+    (p) => p.id === credential.id || p.rawId === rawIdB64
+  );
+
+  // Decode userHandle if returned by discoverable credential
+  let userHandleText = '';
+  if (assertionResponse.userHandle) {
+    try {
+      userHandleText = new TextDecoder().decode(assertionResponse.userHandle);
+    } catch {
+      userHandleText = bufferToBase64url(assertionResponse.userHandle);
+    }
+  }
+
+  if (!matchedPasskey) {
+    const inferredUsername =
+      targetUsername ||
+      (userHandleText ? userHandleText.replace(/-\d+$/, '') : '') ||
+      'reader';
+
+    matchedPasskey = {
+      id: credential.id,
+      rawId: rawIdB64,
+      username: inferredUsername,
+      userId: userHandleText || inferredUsername,
+      name: detectDevicePasskeyName(),
+      createdAt: new Date().toISOString(),
+      lastUsedAt: new Date().toISOString(),
+      transports: ['internal', 'hybrid'],
+      authenticatorAttachment: (credential as any).authenticatorAttachment || 'platform',
+      backedUp: true,
+    };
+  } else {
+    matchedPasskey = {
+      ...matchedPasskey,
+      lastUsedAt: new Date().toISOString(),
+    };
+  }
+
+  // Verify assertion with server endpoint
+  try {
+    const baseUrl = import.meta.env.BASE_URL || '/';
+    await fetch(`${baseUrl}api/passkeys/auth-verify`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        challengeId: serverChallengeId,
+        credentialId: credential.id,
+        rawId: rawIdB64,
+        authenticatorData: bufferToBase64url(assertionResponse.authenticatorData),
+        clientDataJSON: bufferToBase64url(assertionResponse.clientDataJSON),
+        signature: bufferToBase64url(assertionResponse.signature),
+        userHandle: assertionResponse.userHandle ? bufferToBase64url(assertionResponse.userHandle) : null,
+      }),
+    });
+  } catch {
+    // Continue locally
+  }
+
+  const updatedPasskeys = [
+    ...storedPasskeys.filter((p) => p.id !== matchedPasskey!.id),
+    matchedPasskey,
+  ];
+  saveStoredPasskeys(updatedPasskeys);
+
+  return { passkey: matchedPasskey, credential };
+}
