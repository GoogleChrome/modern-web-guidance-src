@@ -0,0 +1,66 @@
+import type { APIRoute } from 'astro';
+
+export const GET: APIRoute = async ({ session, url }) => {
+  const username = url.searchParams.get('username');
+  const passkeys = (await session?.get('passkeys')) || [];
+  const filtered = username
+    ? passkeys.filter((p: any) => p.username?.toLowerCase() === username.toLowerCase())
+    : passkeys;
+
+  return new Response(JSON.stringify({ passkeys: filtered }), {
+    status: 200,
+    headers: { 'Content-Type': 'application/json' },
+  });
+};
+
+export const PATCH: APIRoute = async ({ request, session }) => {
+  try {
+    const { id, name } = await request.json();
+    if (!id || !name) {
+      return new Response(JSON.stringify({ error: 'id and name are required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const passkeys = (await session?.get('passkeys')) || [];
+    const updated = passkeys.map((p: any) => (p.id === id ? { ...p, name } : p));
+    await session?.set('passkeys', updated);
+
+    return new Response(JSON.stringify({ passkeys: updated }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Failed to update passkey' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
+
+export const DELETE: APIRoute = async ({ request, session }) => {
+  try {
+    const { id } = await request.json();
+    if (!id) {
+      return new Response(JSON.stringify({ error: 'id is required' }), {
+        status: 400,
+        headers: { 'Content-Type': 'application/json' },
+      });
+    }
+
+    const passkeys = (await session?.get('passkeys')) || [];
+    const updated = passkeys.filter((p: any) => p.id !== id);
+    await session?.set('passkeys', updated);
+
+    return new Response(JSON.stringify({ passkeys: updated }), {
+      status: 200,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  } catch (err: any) {
+    return new Response(JSON.stringify({ error: err?.message || 'Failed to delete passkey' }), {
+      status: 500,
+      headers: { 'Content-Type': 'application/json' },
+    });
+  }
+};
