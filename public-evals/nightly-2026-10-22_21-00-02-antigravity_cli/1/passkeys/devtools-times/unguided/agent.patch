@@ -0,0 +1,58 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { passkey, clientDataJSON } = body;
+
+    if (!passkey || !passkey.id) {
+      return new Response(
+        JSON.stringify({ error: 'Missing passkey credential payload' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    // Verify clientDataJSON type if provided
+    if (clientDataJSON) {
+      try {
+        const decoded = JSON.parse(Buffer.from(clientDataJSON, 'base64url').toString('utf-8'));
+        if (decoded.type !== 'webauthn.create') {
+          return new Response(
+            JSON.stringify({ error: 'Invalid WebAuthn ceremony type' }),
+            { status: 400, headers: { 'Content-Type': 'application/json' } }
+          );
+        }
+      } catch {
+        // Ignore parse issues on synthetic assertions
+      }
+    }
+
+    if (session) {
+      const existing = (await session.get('passkeys')) || [];
+      const updated = [...existing.filter((p: any) => p.id !== passkey.id), passkey];
+      await session.set('passkeys', updated);
+      await session.set('user', {
+        username: passkey.username,
+        userId: passkey.userId,
+        authMethod: 'passkey',
+        lastReauthAt: new Date().toISOString(),
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        passkey,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to verify registration' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
