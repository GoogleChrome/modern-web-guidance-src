@@ -0,0 +1,57 @@
+import type { APIRoute } from 'astro';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json();
+    const { credentialId, clientDataJSON } = body;
+
+    if (!credentialId) {
+      return new Response(
+        JSON.stringify({ error: 'Missing credentialId' }),
+        { status: 400, headers: { 'Content-Type': 'application/json' } }
+      );
+    }
+
+    if (clientDataJSON) {
+      try {
+        const decoded = JSON.parse(Buffer.from(clientDataJSON, 'base64url').toString('utf-8'));
+        if (decoded.type !== 'webauthn.get') {
+          return new Response(
+            JSON.stringify({ error: 'Invalid WebAuthn ceremony type' }),
+            { status: 400, headers: { 'Content-Type': 'application/json' } }
+          );
+        }
+      } catch {
+        // Ignore parse issues
+      }
+    }
+
+    let matchedPasskey = null;
+    if (session) {
+      const stored = (await session.get('passkeys')) || [];
+      matchedPasskey = stored.find((p: any) => p.id === credentialId || p.rawId === credentialId);
+      if (matchedPasskey) {
+        matchedPasskey.lastUsedAt = new Date().toISOString();
+        await session.set('passkeys', stored);
+      }
+    }
+
+    return new Response(
+      JSON.stringify({
+        verified: true,
+        credentialId,
+        passkey: matchedPasskey,
+        authenticatedAt: new Date().toISOString(),
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to verify authentication' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
