+import React, { useState, useEffect } from 'react';
+import {
+  KeyIcon,
+  FingerPrintIcon,
+  ShieldCheckIcon,
+  PlusIcon,
+  TrashIcon,
+  PencilSquareIcon,
+  CheckIcon,
+  XMarkIcon,
+  ComputerDesktopIcon,
+  DevicePhoneMobileIcon,
+  CloudIcon,
+  LockClosedIcon,
+  ExclamationTriangleIcon,
+  CheckCircleIcon,
+  UserCircleIcon,
+  ArrowRightOnRectangleIcon,
+  EnvelopeIcon,
+  IdentificationIcon,
+} from '@heroicons/react/24/outline';
+import {
+  getStoredPasskeys,
+  saveStoredPasskeys,
+  getCurrentSession,
+  saveCurrentSession,
+  createWebAuthnPasskey,
+  authenticateWithWebAuthnPasskey,
+  detectDevicePasskeyName,
+  type StoredPasskey,
+  type UserSession,
+} from '../utils/passkeys';
+
+type PendingSensitiveAction =
+  | { type: 'delete_passkey'; passkey: StoredPasskey }
+  | { type: 'change_email'; newEmail: string }
+  | { type: 'change_password'; newPassword: string }
+  | { type: 'delete_account' }
+  | { type: 'manual_reauth' };
+
+const REAUTH_WINDOW_MS = 5 * 60 * 1000; // 5 minutes fresh reauth window
+
+export default function AccountSettings() {
+  const [session, setSession] = useState<UserSession | null>(null);
+  const [passkeys, setPasskeys] = useState<StoredPasskey[]>([]);
+  const [statusBanner, setStatusBanner] = useState<{
+    type: 'success' | 'error' | 'info';
+    message: string;
+  } | null>(null);
+
+  // Add passkey form state
+  const [showAddForm, setShowAddForm] = useState(false);
+  const [newPasskeyName, setNewPasskeyName] = useState('');
+  const [newPasskeyAttachment, setNewPasskeyAttachment] = useState<
+    'platform' | 'cross-platform' | ''
+  >('');
+  const [creatingPasskey, setCreatingPasskey] = useState(false);
+
+  // Rename passkey state
+  const [editingPasskeyId, setEditingPasskeyId] = useState<string | null>(null);
+  const [editingNameValue, setEditingNameValue] = useState('');
+
+  // Profile & sensitive settings state
+  const [emailInput, setEmailInput] = useState('alex.reporter@devtoolstimes.com');
+  const [newPasswordInput, setNewPasswordInput] = useState('');
+
+  // Reauthentication modal state
+  const [pendingAction, setPendingAction] = useState<PendingSensitiveAction | null>(null);
+  const [reauthPassword, setReauthPassword] = useState('');
+  const [reauthLoading, setReauthLoading] = useState(false);
+  const [reauthError, setReauthError] = useState<string | null>(null);
+
+  const baseUrl = import.meta.env.BASE_URL || '/';
+
+  useEffect(() => {
+    const currentSess = getCurrentSession();
+    if (currentSess) {
+      setSession(currentSess);
+      setEmailInput(currentSess.email);
+    } else {
+      const defaultSess: UserSession = {
+        username: 'alex.reporter',
+        userId: 'alex.reporter-default',
+        email: 'alex.reporter@devtoolstimes.com',
+        authMethod: 'passkey',
+        signedInAt: new Date(Date.now() - 3600 * 1000).toISOString(),
+        lastReauthAt: new Date(Date.now() - 15 * 60 * 1000).toISOString(), // 15 mins ago so reauth is prompted on sensitive actions
+      };
+      setSession(defaultSess);
+      setEmailInput(defaultSess.email);
+    }
+
+    const stored = getStoredPasskeys();
+    setPasskeys(stored);
+    setNewPasskeyName(detectDevicePasskeyName());
+  }, []);
+
+  const isReauthFresh = (): boolean => {
+    if (!session?.lastReauthAt) return false;
+    const elapsed = Date.now() - new Date(session.lastReauthAt).getTime();
+    return elapsed < REAUTH_WINDOW_MS;
+  };
+
+  const markReauthenticated = (method: 'passkey' | 'password') => {
+    if (!session) return;
+    const updated: UserSession = {
+      ...session,
+      authMethod: method,
+      lastReauthAt: new Date().toISOString(),
+    };
+    setSession(updated);
+    saveCurrentSession(updated);
+  };
+
+  const executeSensitiveAction = async (action: PendingSensitiveAction) => {
+    const base = import.meta.env.BASE_URL || '/';
+
+    if (action.type === 'delete_passkey') {
+      const updated = passkeys.filter((p) => p.id !== action.passkey.id);
+      setPasskeys(updated);
+      saveStoredPasskeys(updated);
+      try {
+        await fetch(`${base}api/passkeys`, {
+          method: 'DELETE',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ id: action.passkey.id }),
+        });
+      } catch {
+        // Ignore offline error
+      }
+      setStatusBanner({
+        type: 'success',
+        message: `Passkey "${action.passkey.name}" has been removed after reauthentication.`,
+      });
+    } else if (action.type === 'change_email') {
+      if (session) {
+        const updated: UserSession = {
+          ...session,
+          email: action.newEmail,
+          lastReauthAt: new Date().toISOString(),
+        };
+        setSession(updated);
+        saveCurrentSession(updated);
+      }
+      setStatusBanner({
+        type: 'success',
+        message: `Account email updated to ${action.newEmail}.`,
+      });
+    } else if (action.type === 'change_password') {
+      setNewPasswordInput('');
+      setStatusBanner({
+        type: 'success',
+        message: 'Account password updated successfully.',
+      });
+    } else if (action.type === 'delete_account') {
+      saveStoredPasskeys([]);
+      saveCurrentSession(null);
+      setPasskeys([]);
+      setStatusBanner({
+        type: 'info',
+        message: 'Your account and all registered passkeys have been deleted.',
+      });
+    } else if (action.type === 'manual_reauth') {
+      setStatusBanner({
+        type: 'success',
+        message: 'Identity re-verified! Sensitive account actions are unlocked for 5 minutes.',
+      });
+    }
+  };
+
+  const requestSensitiveAction = (action: PendingSensitiveAction) => {
+    setStatusBanner(null);
+    setReauthError(null);
+    setReauthPassword('');
+    if (action.type !== 'manual_reauth' && isReauthFresh()) {
+      executeSensitiveAction(action);
+    } else {
+      setPendingAction(action);
+    }
+  };
+
+  const handlePasskeyReauth = async () => {
+    if (!pendingAction) return;
+    setReauthLoading(true);
+    setReauthError(null);
+
+    try {
+      const { passkey } = await authenticateWithWebAuthnPasskey({
+        requireReauthForUser: session?.username,
+      });
+
+      markReauthenticated('passkey');
+      setPasskeys(getStoredPasskeys());
+      const actionToRun = pendingAction;
+      setPendingAction(null);
+      await executeSensitiveAction(actionToRun);
+      if (actionToRun.type === 'manual_reauth') {
+        setStatusBanner({
+          type: 'success',
+          message: `Reauthenticated with passkey "${passkey.name}". Sensitive actions unlocked for 5 minutes.`,
+        });
+      }
+    } catch (err: any) {
+      if (err?.name === 'NotAllowedError') {
+        setReauthError('Passkey verification was cancelled or did not match.');
+      } else {
+        setReauthError(
+          err?.message || 'Passkey verification failed. Try again or use password fallback.'
+        );
+      }
+    } finally {
+      setReauthLoading(false);
+    }
+  };
+
+  const handlePasswordReauth = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!pendingAction) return;
+    if (!reauthPassword || reauthPassword.length < 4) {
+      setReauthError('Please enter your current password to verify your identity.');
+      return;
+    }
+
+    setReauthLoading(true);
+    setReauthError(null);
+
+    try {
+      markReauthenticated('password');
+      const actionToRun = pendingAction;
+      setPendingAction(null);
+      await executeSensitiveAction(actionToRun);
+    } finally {
+      setReauthLoading(false);
+    }
+  };
+
+  const handleCreatePasskey = async (e: React.FormEvent) => {
+    e.preventDefault();
+    setStatusBanner(null);
+    setCreatingPasskey(true);
+
+    try {
+      const username = session?.username || 'alex.reporter';
+      const created = await createWebAuthnPasskey({
+        username,
+        userId: session?.userId,
+        passkeyName: newPasskeyName.trim() || detectDevicePasskeyName(),
+        authenticatorAttachment: newPasskeyAttachment || undefined,
+        existingPasskeys: passkeys,
+      });
+
+      setPasskeys(getStoredPasskeys());
+      markReauthenticated('passkey');
+      setShowAddForm(false);
+      setNewPasskeyName(detectDevicePasskeyName());
+      setStatusBanner({
+        type: 'success',
+        message: `Registered new passkey "${created.name}" (${created.id.slice(0, 12)}...).`,
+      });
+    } catch (err: any) {
+      if (err?.name === 'InvalidStateError') {
+        setStatusBanner({
+          type: 'error',
+          message: 'This authenticator already has a registered passkey for your account.',
+        });
+      } else if (err?.name === 'NotAllowedError') {
+        setStatusBanner({
+          type: 'error',
+          message: 'Passkey registration was cancelled or timed out.',
+        });
+      } else {
+        setStatusBanner({
+          type: 'error',
+          message: err?.message || 'Could not create passkey. Please verify WebAuthn support.',
+        });
+      }
+    } finally {
+      setCreatingPasskey(false);
+    }
+  };
+
+  const startRenamePasskey = (pk: StoredPasskey) => {
+    setEditingPasskeyId(pk.id);
+    setEditingNameValue(pk.name);
+  };
+
+  const saveRenamePasskey = async (id: string) => {
+    const trimmed = editingNameValue.trim();
+    if (!trimmed) return;
+
+    const updated = passkeys.map((p) => (p.id === id ? { ...p, name: trimmed } : p));
+    setPasskeys(updated);
+    saveStoredPasskeys(updated);
+    setEditingPasskeyId(null);
+
+    try {
+      await fetch(`${baseUrl}api/passkeys`, {
+        method: 'PATCH',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ id, name: trimmed }),
+      });
+    } catch {
+      // Ignore offline error
+    }
+
+    setStatusBanner({
+      type: 'success',
+      message: `Passkey renamed to "${trimmed}".`,
+    });
+  };
+
+  const handleSignOut = () => {
+    saveCurrentSession(null);
+    window.location.href = `${baseUrl}signin`;
+  };
+
+  const getActionDescription = (action: PendingSensitiveAction): string => {
+    switch (action.type) {
+      case 'delete_passkey':
+        return `Remove passkey "${action.passkey.name}"`;
+      case 'change_email':
+        return `Update account email to "${action.newEmail}"`;
+      case 'change_password':
+        return 'Change your account password';
+      case 'delete_account':
+        return 'Permanently delete your account and all credentials';
+      case 'manual_reauth':
+        return 'Verify your identity to unlock sensitive account settings';
+    }
+  };
+
+  return (
+    <div className="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 space-y-8">
+      {/* Page Header */}
+      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 border-b border-gray-200 gap-4">
+        <div>
+          <h1 className="text-3xl font-brand text-gray-900">Account &amp; Security Settings</h1>
+          <p className="text-sm text-gray-600 mt-1">
+            Manage your passkeys, WebAuthn authenticators, profile details, and reauthentication security.
+          </p>
+        </div>
+
+        <div className="flex items-center gap-3">
+          <div className="flex items-center gap-2 px-3 py-1.5 rounded-full bg-gray-100 text-xs font-medium text-gray-800">
+            <UserCircleIcon className="w-4 h-4 text-gray-600" />
+            <span>{session?.username || 'alex.reporter'}</span>
+          </div>
+          <button
+            type="button"
+            onClick={handleSignOut}
+            className="inline-flex items-center gap-1.5 px-3 py-1.5 border border-gray-300 rounded-md text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50"
+          >
+            <ArrowRightOnRectangleIcon className="w-4 h-4" />
+            <span>Sign out</span>
+          </button>
+        </div>
+      </div>
+
+      {/* Status Alert Banner */}
+      {statusBanner && (
+        <div
+          role="alert"
+          className={`p-4 rounded-lg border flex items-start justify-between gap-3 text-sm ${
+            statusBanner.type === 'success'
+              ? 'bg-green-50 border-green-200 text-green-800'
+              : statusBanner.type === 'error'
+              ? 'bg-red-50 border-red-200 text-red-800'
+              : 'bg-blue-50 border-blue-200 text-blue-800'
+          }`}
+        >
+          <div className="flex items-center gap-2">
+            <CheckCircleIcon className="w-5 h-5 shrink-0" />
+            <span>{statusBanner.message}</span>
+          </div>
+          <button
+            type="button"
+            onClick={() => setStatusBanner(null)}
+            className="text-gray-400 hover:text-gray-600"
+            aria-label="Dismiss notification"
+          >
+            <XMarkIcon className="w-4 h-4" />
+          </button>
+        </div>
+      )}
+
+      {/* Reauthentication Status Bar */}
+      <section className="p-4 bg-gray-50 border border-gray-200 rounded-lg flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+        <div className="flex items-start gap-3">
+          <ShieldCheckIcon
+            className={`w-6 h-6 shrink-0 mt-0.5 ${
+              isReauthFresh() ? 'text-emerald-600' : 'text-amber-600'
+            }`}
+          />
+          <div>
+            <div className="flex items-center gap-2">
+              <h2 className="text-sm font-bold text-gray-900">Session Verification Status</h2>
+              <span
+                className={`text-[11px] font-semibold px-2 py-0.5 rounded-full ${
+                  isReauthFresh()
+                    ? 'bg-emerald-100 text-emerald-800'
+                    : 'bg-amber-100 text-amber-800'
+                }`}
+              >
+                {isReauthFresh() ? 'Recently Verified' : 'Reauthentication Required for Changes'}
+              </span>
+            </div>
+            <p className="text-xs text-gray-600 mt-0.5">
+              Sensitive actions (removing a passkey, changing your email/password, or deleting your
+              account) require recent WebAuthn passkey reauthentication.
+            </p>
+          </div>
+        </div>
+
+        <button
+          type="button"
+          id="reauthenticate-now-btn"
+          onClick={() => requestSensitiveAction({ type: 'manual_reauth' })}
+          className="shrink-0 inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-md text-xs font-semibold border border-gray-900 text-gray-900 bg-white hover:bg-gray-100 transition-colors"
+        >
+          <FingerPrintIcon className="w-4 h-4" />
+          <span>Reauthenticate with Passkey</span>
+        </button>
+      </section>
+
+      {/* Passkey Management Section */}
+      <section className="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
+        <div className="p-6 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
+          <div>
+            <div className="flex items-center gap-2">
+              <KeyIcon className="w-5 h-5 text-gray-900" />
+              <h2 className="text-xl font-bold text-gray-900">Passkeys</h2>
+              <span className="text-xs font-semibold px-2 py-0.5 rounded-full bg-gray-100 text-gray-700">
+                {passkeys.length}
+              </span>
+            </div>
+            <p className="text-sm text-gray-600 mt-1">
+              Passkeys are a safer and faster replacement for passwords using Touch ID, Face ID,
+              Windows Hello, or hardware security keys.
+            </p>
+          </div>
+
+          <button
+            type="button"
+            id="add-passkey-toggle-btn"
+            onClick={() => setShowAddForm((prev) => !prev)}
+            className="shrink-0 inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-md text-sm font-semibold text-white bg-gray-900 hover:bg-gray-800 transition-colors"
+          >
+            <PlusIcon className="w-4 h-4" />
+            <span>Create a passkey</span>
+          </button>
+        </div>
+
+        {/* Create New Passkey Form */}
+        {showAddForm && (
+          <form
+            onSubmit={handleCreatePasskey}
+            className="p-6 bg-gray-50 border-b border-gray-200 space-y-4"
+          >
+            <div className="flex items-center justify-between">
+              <h3 className="text-sm font-bold text-gray-900">Register a New Passkey</h3>
+              <button
+                type="button"
+                onClick={() => setShowAddForm(false)}
+                className="text-xs text-gray-500 hover:text-gray-800"
+              >
+                Cancel
+              </button>
+            </div>
+
+            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
+              <div>
+                <label
+                  htmlFor="new-passkey-name"
+                  className="block text-xs font-semibold text-gray-700 mb-1"
+                >
+                  Passkey Name / Nickname
+                </label>
+                <input
+                  type="text"
+                  id="new-passkey-name"
+                  value={newPasskeyName}
+                  onChange={(e) => setNewPasskeyName(e.target.value)}
+                  placeholder="e.g. Work Laptop Touch ID"
+                  required
+                  className="w-full px-3 py-2 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                />
+              </div>
+
+              <div>
+                <label
+                  htmlFor="new-passkey-attachment"
+                  className="block text-xs font-semibold text-gray-700 mb-1"
+                >
+                  Authenticator Attachment
+                </label>
+                <select
+                  id="new-passkey-attachment"
+                  value={newPasskeyAttachment}
+                  onChange={(e) => setNewPasskeyAttachment(e.target.value as any)}
+                  className="w-full px-3 py-2 bg-white border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-gray-900"
+                >
+                  <option value="">Any Authenticator (Default)</option>
+                  <option value="platform">This Device / Platform Authenticator</option>
+                  <option value="cross-platform">Security Key / Phone (Cross-Platform)</option>
+                </select>
+              </div>
+            </div>
+
+            <div className="flex justify-end gap-2">
+              <button
+                type="button"
+                onClick={() => setShowAddForm(false)}
+                className="px-3 py-2 border border-gray-300 rounded-md text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50"
+              >
+                Cancel
+              </button>
+              <button
+                type="submit"
+                id="confirm-create-passkey-btn"
+                disabled={creatingPasskey}
+                className="inline-flex items-center gap-1.5 px-4 py-2 rounded-md text-xs font-semibold text-white bg-gray-900 hover:bg-gray-800 disabled:opacity-60"
+              >
+                <KeyIcon className="w-4 h-4" />
+                <span>{creatingPasskey ? 'Registering with authenticator...' : 'Register Passkey'}</span>
+              </button>
+            </div>
+          </form>
+        )}
+
+        {/* Passkey List */}
+        <div className="divide-y divide-gray-200">
+          {passkeys.length === 0 ? (
+            <div className="p-8 text-center">
+              <FingerPrintIcon className="w-10 h-10 text-gray-400 mx-auto mb-2" />
+              <h3 className="text-sm font-semibold text-gray-900">No passkeys registered yet</h3>
+              <p className="text-xs text-gray-500 mt-1 max-w-md mx-auto">
+                Add a passkey to sign in faster without typing a password and protect your account
+                against phishing.
+              </p>
+              <button
+                type="button"
+                onClick={() => setShowAddForm(true)}
+                className="mt-4 inline-flex items-center gap-1.5 px-4 py-2 rounded-md text-xs font-semibold text-white bg-gray-900 hover:bg-gray-800"
+              >
+                <PlusIcon className="w-4 h-4" />
+                <span>Add your first passkey</span>
+              </button>
+            </div>
+          ) : (
+            passkeys.map((pk) => {
+              const isEditing = editingPasskeyId === pk.id;
+              const isCrossPlatform = pk.authenticatorAttachment === 'cross-platform';
+
+              return (
+                <div
+                  key={pk.id}
+                  data-testid="passkey-item"
+                  className="p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 hover:bg-gray-50/60 transition-colors"
+                >
+                  <div className="flex items-start gap-3.5">
+                    <div className="w-10 h-10 rounded-lg bg-gray-100 border border-gray-200 flex items-center justify-center text-gray-700 shrink-0 mt-0.5">
+                      {isCrossPlatform ? (
+                        <DevicePhoneMobileIcon className="w-5 h-5" />
+                      ) : (
+                        <ComputerDesktopIcon className="w-5 h-5" />
+                      )}
+                    </div>
+
+                    <div className="space-y-1">
+                      {isEditing ? (
+                        <div className="flex items-center gap-2">
+                          <input
+                            type="text"
+                            value={editingNameValue}
+                            onChange={(e) => setEditingNameValue(e.target.value)}
+                            aria-label="Edit passkey name"
+                            className="px-2.5 py-1 border border-gray-300 rounded text-sm font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-gray-900"
+                          />
+                          <button
+                            type="button"
+                            onClick={() => saveRenamePasskey(pk.id)}
+                            className="p-1.5 rounded bg-gray-900 text-white hover:bg-gray-800"
+                            title="Save passkey name"
+                          >
+                            <CheckIcon className="w-4 h-4" />
+                          </button>
+                          <button
+                            type="button"
+                            onClick={() => setEditingPasskeyId(null)}
+                            className="p-1.5 rounded border border-gray-300 text-gray-600 hover:bg-gray-100"
+                            title="Cancel rename"
+                          >
+                            <XMarkIcon className="w-4 h-4" />
+                          </button>
+                        </div>
+                      ) : (
+                        <div className="flex flex-wrap items-center gap-2">
+                          <span className="font-bold text-gray-900 text-sm">{pk.name}</span>
+                          {pk.backedUp && (
+                            <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-200">
+                              <CloudIcon className="w-3 h-3" /> Synced
+                            </span>
+                          )}
+                          <span className="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-gray-100 text-gray-600">
+                            {pk.authenticatorAttachment || 'platform'}
+                          </span>
+                        </div>
+                      )}
+
+                      <div className="text-xs text-gray-500 flex flex-wrap items-center gap-x-3 gap-y-1">
+                        <span>
+                          User: <strong className="text-gray-700">{pk.username}</strong>
+                        </span>
+                        <span>•</span>
+                        <span>
+                          Created: {new Date(pk.createdAt).toLocaleDateString()}{' '}
+                          {new Date(pk.createdAt).toLocaleTimeString([], {
+                            hour: '2-digit',
+                            minute: '2-digit',
+                          })}
+                        </span>
+                        <span>•</span>
+                        <span>
+                          Last used:{' '}
+                          {pk.lastUsedAt
+                            ? `${new Date(pk.lastUsedAt).toLocaleDateString()} ${new Date(
+                                pk.lastUsedAt
