index 0000000..0b37b9a
--- /dev/null
+++ b/src/pages/api/passkeys/auth-options.ts
@@ -0,0 +1,53 @@
+import type { APIRoute } from 'astro';
+import crypto from 'node:crypto';
+
+export const POST: APIRoute = async ({ request, session }) => {
+  try {
+    const body = await request.json().catch(() => ({}));
+    const username = body.username || undefined;
+
+    const challengeBytes = crypto.randomBytes(32);
+    const challenge = challengeBytes.toString('base64url');
+    const challengeId = crypto.randomUUID();
+
+    let allowCredentials: any[] = [];
+    if (session && username) {
+      const stored = (await session.get('passkeys')) || [];
+      allowCredentials = stored
+        .filter((p: any) => p.username?.toLowerCase() === username.toLowerCase())
+        .map((p: any) => ({
+          id: p.rawId || p.id,
+          type: 'public-key',
+          transports: p.transports || ['internal', 'hybrid'],
+        }));
+    }
+
+    if (session) {
+      await session.set('webauthn_auth_challenge', {
+        challenge,
+        challengeId,
+        username,
+        createdAt: Date.now(),
+      });
+    }
+
+    return new Response(
+      JSON.stringify({
+        challenge,
+        challengeId,
+        timeout: 60000,
+        userVerification: 'required',
+        allowCredentials,
+      }),
+      {
+        status: 200,
+        headers: { 'Content-Type': 'application/json' },
+      }
+    );
+  } catch (err: any) {
+    return new Response(
+      JSON.stringify({ error: err?.message || 'Failed to generate authentication options' }),
+      { status: 500, headers: { 'Content-Type': 'application/json' } }
+    );
+  }
+};
