+            : `<span class="badge badge-device" title="Bound to a single device">${pk.credentialDeviceType === 'multiDevice' ? 'Multi-Device' : 'Device-Bound'}</span>`;
+
+          const transportsBadges = (pk.transports || [])
+            .map((t) => `<span class="badge badge-transport">${escapeHtml(t)}</span>`)
