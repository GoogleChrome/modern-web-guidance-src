+                <button
+                  type="button"
+                  class="btn btn-sm btn-danger btn-delete-passkey"
+                  data-id="${escapeHtml(pk.id)}"
+                  aria-label="Delete passkey ${escapeHtml(pk.name)}"
+                >
+                  Delete
+                </button>
+              </div>
+            </div>
+          `;
+        })
+        .join('')}
+    </div>
+  `;
+}
