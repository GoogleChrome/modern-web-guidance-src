+    return res.status(400).json({ error: 'This account is passwordless. Please reauthenticate with your passkey.' });
+  }
+  if (!password || !verifyPassword(password, req.user.passwordHash)) {
+    return res.status(401).json({ verified: false, error: 'Incorrect password.' });
+  }
+  req.session.lastVerifiedAt = Date.now();
+  return res.json({
+    verified: true,
+    user: sanitizeUser(req.user, req),
+  });
+});
+
+// --- Passkey Management Endpoints (List, Rename, Delete) ---
+
+app.get('/api/passkeys', requireAuth, (req, res) => {
+  return res.json({
+    passkeys: req.user.passkeys.map(sanitizePasskey),
+  });
+});
+
+app.patch('/api/passkeys/:id', requireAuth, (req, res) => {
+  const { id } = req.params;
+  const { name } = req.body || {};
+  if (!name || typeof name !== 'string' || !name.trim()) {
+    return res.status(400).json({ error: 'A valid passkey name is required.' });
+  }
+
+  const passkey = req.user.passkeys.find((pk) => pk.id === id);
+  if (!passkey) {
+    return res.status(404).json({ error: 'Passkey not found.' });
+  }
+
+  passkey.name = name.trim().slice(0, 64);
+  return res.json({
+    passkey: sanitizePasskey(passkey),
+    user: sanitizeUser(req.user, req),
+  });
+});
+
+// Deleting a passkey is a sensitive security action protected by fresh reauthentication
+app.delete('/api/passkeys/:id', requireAuth, requireFreshReauth, (req, res) => {
+  const { id } = req.params;
+  const index = req.user.passkeys.findIndex((pk) => pk.id === id);
+  if (index === -1) {
+    return res.status(404).json({ error: 'Passkey not found.' });
+  }
+
+  // Prevent locking out a passwordless user if it's their only passkey unless ?force=true
+  if (req.user.passkeys.length === 1 && !req.user.passwordHash && req.query.force !== 'true') {
+    return res.status(400).json({
+      error: 'Cannot delete your only passkey on a passwordless account without setting a backup passkey first.',
+      code: 'LAST_CREDENTIAL',
+    });
+  }
+
+  const [removed] = req.user.passkeys.splice(index, 1);
+  const rpID = getRPID(req);
+
+  return res.json({
+    deletedId: removed.id,
+    user: sanitizeUser(req.user, req),
+    signals: {
+      unknownCredential: {
+        signalName: 'unknownCredential',
+        rpID,
+        credentialID: removed.id,
+      },
+      allAcceptedCredentials: {
+        signalName: 'allAcceptedCredentials',
+        rpID,
+        userID: req.user.id,
+        allAcceptedCredentialIDs: req.user.passkeys.map((pk) => pk.id),
+      },
+    },
+  });
+});
+
+// --- Sensitive Account & Order Actions (Protected by Reauthentication) ---
+
+app.patch('/api/account/profile', requireAuth, requireFreshReauth, (req, res) => {
+  const { displayName, username, defaultPaymentMethod } = req.body || {};
+  const user = req.user;
+
+  if (username && typeof username === 'string' && username.trim() !== user.username) {
+    const existing = findUserByUsername(username.trim());
+    if (existing && existing.id !== user.id) {
+      return res.status(409).json({ error: 'That email/username is already in use.' });
+    }
+    user.username = username.trim();
+  }
+
+  if (displayName && typeof displayName === 'string' && displayName.trim()) {
+    user.displayName = displayName.trim();
+  }
+
+  if (defaultPaymentMethod && typeof defaultPaymentMethod === 'string' && defaultPaymentMethod.trim()) {
+    user.defaultPaymentMethod = defaultPaymentMethod.trim();
+  }
+
+  const rpID = getRPID(req);
+
+  return res.json({
+    message: 'Account profile updated.',
+    user: sanitizeUser(user, req),
+    signals: {
+      currentUserDetails: {
+        signalName: 'currentUserDetails',
+        rpID,
+        userID: user.id,
+        userName: user.username,
+        userDisplayName: user.displayName,
+      },
+    },
+  });
+});
+
+app.post('/api/orders/checkout', requireAuth, requireFreshReauth, (req, res) => {
+  const { itemName, totalAmount, useRewards } = req.body || {};
+  const user = req.user;
+
+  if (useRewards) {
+    if (user.rewardPoints < 100) {
+      return res.status(400).json({ error: 'Not enough reward points (100 pts required).' });
+    }
+    user.rewardPoints -= 100;
+  } else {
+    user.rewardPoints += 25;
+  }
+
+  const order = {
+    orderId: `ORD-${Math.random().toString(36).substring(2, 8).toUpperCase()}`,
+    itemName: itemName || 'Seasonal Specialty Coffee',
+    totalAmount: totalAmount || '$5.75',
+    paymentUsed: useRewards ? '100 Coffee Rewards Points' : user.defaultPaymentMethod,
+    timestamp: new Date().toISOString(),
+  };
+
+  return res.json({
+    message: `Order ${order.orderId} confirmed!`,
+    order,
+    user: sanitizeUser(user, req),
+  });
+});
+
+// Serve static files and SPA fallback
+app.use(express.static(__dirname));
+
+app.get('/{*splat}', (req, res) => {
+  res.sendFile(path.join(__dirname, 'index.html'));
+});
+
+app.listen(PORT, () => {
+  console.log(`The Daily Grind server listening on http://localhost:${PORT}`);
+});
