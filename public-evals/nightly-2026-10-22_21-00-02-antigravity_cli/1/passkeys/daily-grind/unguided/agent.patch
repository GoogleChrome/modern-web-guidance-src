+                <div class="passkey-icon-wrap" aria-hidden="true">🔑</div>
+                <div class="passkey-details">
+                  <div class="passkey-title-row">
+                    <strong class="passkey-name-label" data-testid="passkey-name">${escapeHtml(pk.name)}</strong>
+                    ${syncBadge}
+                    ${transportsBadges}
+                  </div>
+                  <div class="passkey-meta">
