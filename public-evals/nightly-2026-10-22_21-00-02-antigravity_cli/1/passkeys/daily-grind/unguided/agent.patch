+import {
+  startRegistration,
+  startAuthentication,
+  sendSignal,
+  browserSupportsWebAuthn,
+  browserSupportsWebAuthnAutofill,
+  platformAuthenticatorIsAvailable,
+  WebAuthnAbortService,
+} from '/vendor/simplewebauthn-browser/index.js';
+
+// Application State
+const state = {
+  authenticated: false,
+  user: null,
+  rpID: window.location.hostname || 'localhost',
+  activeView: 'home', // 'home' | 'account' | 'auth'
+  authTab: 'signin', // 'signin' | 'register'
+  conditionalMediationActive: false,
+  pendingReauthCallback: null,
+  pendingReauthDescription: '',
+  orders: [],
+  reauthTimerId: null,
+};
+
+// Utility: Toast Notification
+export function showToast(message, type = 'info') {
+  const container = document.getElementById('toast-container');
+  if (!container) return;
+
+  const toast = document.createElement('div');
+  toast.className = `toast toast-${type}`;
+  toast.setAttribute('role', 'status');
+  toast.innerHTML = `
+    <span class="toast-icon">${type === 'success' ? '✓' : type === 'error' ? '!' : 'ℹ'}</span>
+    <span class="toast-msg">${escapeHtml(message)}</span>
+  `;
+  container.appendChild(toast);
+
+  setTimeout(() => {
+    toast.classList.add('toast-fade');
+    setTimeout(() => toast.remove(), 300);
+  }, 4200);
+}
+
+function escapeHtml(str) {
+  if (str === null || str === undefined) return '';
+  return String(str)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#039;');
+}
+
+function formatDate(isoStr) {
+  if (!isoStr) return 'Never';
+  try {
+    const d = new Date(isoStr);
+    return d.toLocaleDateString(undefined, {
+      month: 'short',
+      day: 'numeric',
+      year: 'numeric',
+      hour: '2-digit',
+      minute: '2-digit',
+    });
+  } catch {
+    return isoStr;
+  }
+}
+
+// Helper: Safely invoke WebAuthn Signal APIs (signalUnknownCredential, signalAllAcceptedCredentials, signalCurrentUserDetails)
+async function broadcastWebAuthnSignals(signalsObj) {
+  if (!signalsObj || typeof signalsObj !== 'object') return;
+  for (const key of Object.keys(signalsObj)) {
+    const signalPayload = signalsObj[key];
+    if (signalPayload && signalPayload.signalName) {
+      try {
+        await sendSignal(signalPayload);
+      } catch (err) {
+        // Signals are fire-and-forget best-effort broadcasts; ignore if browser doesn't support L3 signals
+        console.debug(`WebAuthn Signal (${signalPayload.signalName}) skipped:`, err.message || err);
+      }
+    }
+  }
+}
+
+// Fetch wrapper with JSON handling
+async function apiFetch(url, options = {}) {
+  const headers = {
+    'Content-Type': 'application/json',
+    ...(options.headers || {}),
+  };
+  const response = await fetch(url, {
+    ...options,
+    headers,
+    body: options.body ? JSON.stringify(options.body) : undefined,
+  });
+  const data = await response.json().catch(() => ({}));
+  return { ok: response.ok, status: response.status, data };
+}
+
+// --- Core WebAuthn Ceremonies ---
+
+/**
+ * 1. Passkey Registration Ceremony
+ * Supports both creating a brand new account with a passkey OR adding a passkey to a signed-in account.
+ */
+export async function registerPasskey({ username, displayName, passkeyName } = {}) {
+  if (!browserSupportsWebAuthn()) {
+    showToast('WebAuthn passkeys are not supported in this browser.', 'error');
+    return false;
+  }
+
+  try {
+    // Cancel any pending conditional UI request before starting a modal ceremony
+    WebAuthnAbortService.cancelCeremony();
+    state.conditionalMediationActive = false;
+
+    const { ok, data: optionsJSON } = await apiFetch('/api/passkeys/register/options', {
+      method: 'POST',
+      body: { username, displayName, passkeyName },
+    });
+
+    if (!ok) {
+      showToast(optionsJSON.error || 'Could not start passkey registration.', 'error');
+      return false;
+    }
+
+    const attResp = await startRegistration({ optionsJSON });
+
+    const { ok: verifyOk, data: verifyData } = await apiFetch('/api/passkeys/register/verify', {
+      method: 'POST',
+      body: {
+        response: attResp,
+        passkeyName,
+      },
+    });
+
+    if (!verifyOk || !verifyData.verified) {
+      showToast(verifyData.error || 'Passkey registration failed verification.', 'error');
+      return false;
+    }
+
+    if (verifyData.signals) {
+      await broadcastWebAuthnSignals(verifyData.signals);
+    }
+
+    state.authenticated = true;
+    state.user = verifyData.user;
+    showToast(`Passkey "${verifyData.passkey.name}" registered!`, 'success');
+    navigateTo('account');
+    return true;
+  } catch (err) {
+    if (err.name === 'NotAllowedError') {
+      showToast('Passkey creation was cancelled or timed out.', 'info');
+    } else if (err.name === 'InvalidStateError') {
+      showToast('A passkey from this authenticator is already registered for your account.', 'info');
+    } else {
+      showToast(err.message || 'Passkey registration error.', 'error');
+    }
+    return false;
+  }
+}
+
+/**
+ * 2. Passkey Authentication Ceremony (Modal or Conditional UI Autofill)
+ */
+export async function authenticateWithPasskey({ username = '', useBrowserAutofill = false } = {}) {
+  if (!browserSupportsWebAuthn()) {
+    if (!useBrowserAutofill) {
+      showToast('WebAuthn passkeys are not supported in this browser.', 'error');
+    }
+    return false;
+  }
+
+  try {
+    if (useBrowserAutofill) {
+      const autofillSupported = await browserSupportsWebAuthnAutofill();
+      if (!autofillSupported) return false;
+      if (state.conditionalMediationActive || state.authenticated) return false;
+    } else {
+      WebAuthnAbortService.cancelCeremony();
+      state.conditionalMediationActive = false;
+    }
+
+    const { ok, data: optionsJSON } = await apiFetch('/api/passkeys/authenticate/options', {
+      method: 'POST',
+      body: { username },
+    });
+
+    if (!ok) {
+      if (!useBrowserAutofill) {
+        showToast(optionsJSON.error || 'Failed to initialize passkey sign-in.', 'error');
+      }
+      return false;
+    }
+
+    if (useBrowserAutofill) {
+      state.conditionalMediationActive = true;
+    }
+
+    const asseResp = await startAuthentication({
+      optionsJSON,
+      useBrowserAutofill,
+      verifyBrowserAutofillInput: false,
+    });
+
+    state.conditionalMediationActive = false;
+
+    const { ok: verifyOk, data: verifyData } = await apiFetch('/api/passkeys/authenticate/verify', {
+      method: 'POST',
+      body: { response: asseResp },
+    });
+
+    if (verifyData?.signalUnknownCredential) {
+      await broadcastWebAuthnSignals({ unknownCredential: verifyData.signalUnknownCredential });
+    }
+
+    if (!verifyOk || !verifyData.verified) {
+      showToast(verifyData.error || 'Passkey sign-in failed verification.', 'error');
+      return false;
+    }
+
+    if (verifyData.signals) {
+      await broadcastWebAuthnSignals(verifyData.signals);
+    }
+
+    state.authenticated = true;
+    state.user = verifyData.user;
+    showToast(`Signed in as ${verifyData.user.displayName} via passkey!`, 'success');
+    navigateTo('account');
+    return true;
+  } catch (err) {
+    state.conditionalMediationActive = false;
+    if (useBrowserAutofill || err.name === 'AbortError') {
+      // Silent abort when switching views or clicking explicit modal sign-in
+      return false;
+    }
+    if (err.name === 'NotAllowedError') {
+      showToast('Passkey sign-in was cancelled or not allowed.', 'info');
+    } else {
+      showToast(err.message || 'Could not sign in with passkey.', 'error');
+    }
+    return false;
+  }
+}
+
+/**
+ * 3. Passkey Step-Up Reauthentication Ceremony
+ * Strictly verifies the currently logged-in user before executing sensitive operations.
+ */
+export async function performPasskeyReauthentication(actionName = 'sensitive-action') {
+  if (!browserSupportsWebAuthn()) {
+    showToast('WebAuthn is not supported in this browser.', 'error');
+    return false;
+  }
+
+  try {
+    WebAuthnAbortService.cancelCeremony();
+    state.conditionalMediationActive = false;
+
+    const { ok, data: optionsJSON } = await apiFetch('/api/passkeys/reauthenticate/options', {
+      method: 'POST',
+      body: { action: actionName },
+    });
+
+    if (!ok) {
+      showToast(optionsJSON.error || 'Could not start passkey reauthentication.', 'error');
+      return false;
+    }
+
+    const asseResp = await startAuthentication({ optionsJSON });
+
+    const { ok: verifyOk, data: verifyData } = await apiFetch('/api/passkeys/reauthenticate/verify', {
+      method: 'POST',
+      body: { response: asseResp },
+    });
+
+    if (verifyData?.signalUnknownCredential) {
+      await broadcastWebAuthnSignals({ unknownCredential: verifyData.signalUnknownCredential });
+    }
+
+    if (!verifyOk || !verifyData.verified) {
+      showToast(verifyData.error || 'Passkey reauthentication failed.', 'error');
+      return false;
+    }
+
+    state.user = verifyData.user;
+    showToast(`Identity re-verified with "${verifyData.passkey.name}".`, 'success');
+    closeReauthModal();
+    renderApp();
+
+    if (typeof state.pendingReauthCallback === 'function') {
+      const cb = state.pendingReauthCallback;
+      state.pendingReauthCallback = null;
+      await cb();
+    }
+    return true;
+  } catch (err) {
+    if (err.name === 'NotAllowedError') {
+      showToast('Reauthentication cancelled.', 'info');
+    } else {
+      showToast(err.message || 'Passkey reauthentication failed.', 'error');
+    }
+    return false;
+  }
+}
+
+/**
+ * Open Step-Up Reauthentication Modal when an action requires fresh verification
+ */
+export function promptReauthentication(description, onVerifiedCallback) {
+  state.pendingReauthDescription = description || 'Verify your identity with a passkey to continue.';
+  state.pendingReauthCallback = onVerifiedCallback;
+
+  const modal = document.getElementById('reauth-modal');
+  const descEl = document.getElementById('reauth-modal-description');
+  const passkeyBtn = document.getElementById('reauth-passkey-btn');
+  const noPasskeyNotice = document.getElementById('reauth-no-passkey-notice');
+
+  if (descEl) descEl.textContent = state.pendingReauthDescription;
+
+  const hasPasskeys = (state.user?.passkeys?.length || 0) > 0;
+  if (passkeyBtn) {
+    passkeyBtn.style.display = hasPasskeys ? 'inline-flex' : 'none';
+  }
+  if (noPasskeyNotice) {
+    noPasskeyNotice.style.display = hasPasskeys ? 'none' : 'block';
+  }
+
+  if (modal) {
+    modal.classList.add('open');
+    modal.setAttribute('aria-hidden', 'false');
+  }
+}
+
+export function closeReauthModal() {
+  const modal = document.getElementById('reauth-modal');
+  if (modal) {
+    modal.classList.remove('open');
+    modal.setAttribute('aria-hidden', 'true');
+  }
+}
+
+/**
+ * 4. Passkey Management Operations (Rename & Delete with Reauth Step-Up)
+ */
+export async function renamePasskey(credentialId, newName) {
+  if (!newName || !newName.trim()) {
+    showToast('Please enter a name for your passkey.', 'error');
+    return false;
+  }
+  const { ok, data } = await apiFetch(`/api/passkeys/${encodeURIComponent(credentialId)}`, {
+    method: 'PATCH',
+    body: { name: newName.trim() },
+  });
+  if (!ok) {
+    showToast(data.error || 'Could not rename passkey.', 'error');
+    return false;
+  }
+  state.user = data.user;
+  showToast(`Passkey renamed to "${data.passkey.name}".`, 'success');
+  renderApp();
+  return true;
+}
+
+export async function deletePasskey(credentialId, force = false) {
+  const url = `/api/passkeys/${encodeURIComponent(credentialId)}${force ? '?force=true' : ''}`;
+  const { ok, status, data } = await apiFetch(url, { method: 'DELETE' });
+
+  if (status === 403 && data.code === 'REAUTH_REQUIRED') {
+    promptReauthentication(
+      'Deleting a passkey requires step-up reauthentication to protect your account security.',
+      () => deletePasskey(credentialId, force)
+    );
+    return false;
+  }
+
+  if (!ok) {
+    showToast(data.error || 'Failed to delete passkey.', 'error');
+    return false;
+  }
+
+  if (data.signals) {
+    await broadcastWebAuthnSignals(data.signals);
+  }
+
+  state.user = data.user;
+  showToast('Passkey removed from your account.', 'success');
+  renderApp();
+  return true;
+}
+
+/**
+ * Sensitive Action: Update Account Profile & Payment Method (Protected by Reauthentication)
+ */
+export async function updateProfileSettings({ displayName, username, defaultPaymentMethod }) {
+  const { ok, status, data } = await apiFetch('/api/account/profile', {
+    method: 'PATCH',
+    body: { displayName, username, defaultPaymentMethod },
+  });
+
+  if (status === 403 && data.code === 'REAUTH_REQUIRED') {
+    promptReauthentication(
+      'Updating your account email, profile, or payment method requires step-up passkey reauthentication.',
+      () => updateProfileSettings({ displayName, username, defaultPaymentMethod })
+    );
+    return false;
+  }
+
+  if (!ok) {
+    showToast(data.error || 'Could not update profile.', 'error');
+    return false;
+  }
+
+  if (data.signals) {
+    await broadcastWebAuthnSignals(data.signals);
+  }
+
+  state.user = data.user;
+  showToast('Account settings updated!', 'success');
+  renderApp();
+  return true;
+}
+
+/**
+ * Sensitive Action: One-Click Express Coffee Order / Rewards Redemption (Protected by Reauthentication)
+ */
+export async function placeExpressOrder({ itemName, totalAmount, useRewards = false }) {
+  if (!state.authenticated) {
+    showToast('Please sign in with your passkey to place an order.', 'info');
+    navigateTo('auth');
+    return false;
+  }
+
+  const { ok, status, data } = await apiFetch('/api/orders/checkout', {
+    method: 'POST',
+    body: { itemName, totalAmount, useRewards },
+  });
+
+  if (status === 403 && data.code === 'REAUTH_REQUIRED') {
+    promptReauthentication(
+      `Confirm your order for ${itemName} (${useRewards ? '100 Rewards Pts' : totalAmount}) with a quick passkey check.`,
+      () => placeExpressOrder({ itemName, totalAmount, useRewards })
+    );
+    return false;
+  }
+
+  if (!ok) {
+    showToast(data.error || 'Could not complete order.', 'error');
+    return false;
+  }
+
+  state.user = data.user;
+  state.orders.unshift(data.order);
+  showToast(`${data.message} (${data.order.itemName})`, 'success');
+  renderApp();
+  return true;
+}
+
+// --- Navigation & View Rendering ---
+
+export function navigateTo(view, subTab = null) {
+  state.activeView = view;
+  if (subTab) {
+    state.authTab = subTab;
+  }
+
+  const urlMap = {
+    home: '/',
+    account: '/account',
+    auth: '/login',
+  };
+  const targetPath = urlMap[view] || '/';
+  if (window.location.pathname !== targetPath) {
+    window.history.pushState({ view }, '', targetPath);
+  }
+
+  renderApp();
+}
+
