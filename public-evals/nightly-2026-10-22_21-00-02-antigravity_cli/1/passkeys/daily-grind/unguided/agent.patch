+        </div>
+      </div>
+
+      <!-- Security & Reauthentication Status Card -->
+      <div class="card section-card security-status-card" id="reauth-status-section">
+        <div class="section-header-row">
+          <div>
+            <h3>Step-Up Reauthentication Status</h3>
+            <p class="section-subtitle">
+              Sensitive operations (deleting passkeys, changing account email/payment details, or redeeming rewards) require recent verification.
+            </p>
+          </div>
+          <div class="reauth-badge-wrap">
+            ${
+              isVerified
+                ? `<span class="status-pill status-verified" id="reauth-status-badge">✓ Verified (${remainingMin}:${remSecPart} remaining)</span>`
+                : `<span class="status-pill status-locked" id="reauth-status-badge">🔒 Step-Up Verification Required</span>`
+            }
+          </div>
+        </div>
+        <div class="reauth-controls-row">
+          <button type="button" class="btn btn-passkey" id="btn-trigger-reauth">
+            🔑 Reauthenticate Now with Passkey
+          </button>
+          ${
+            isVerified
+              ? `<button type="button" class="btn btn-outline" id="btn-expire-reauth">
+                  🔒 Lock / Require Reauthentication Now
+                </button>`
+              : ''
+          }
+        </div>
+      </div>
+
+      <!-- Passkey Management Section -->
+      <div class="card section-card" id="passkey-management-section">
+        <div class="section-header-row">
+          <div>
+            <h3>Passkey Management</h3>
+            <p class="section-subtitle">
+              Register new passkeys for your devices, rename existing credentials, or revoke access.
+            </p>
+          </div>
+        </div>
+
+        <!-- Register New Passkey Form -->
+        <form id="add-passkey-form" class="add-passkey-bar">
+          <input
+            type="text"
+            id="new-passkey-label"
+            class="input-field"
+            placeholder="Passkey label (e.g., MacBook Touch ID, Work YubiKey, iPhone)"
+            aria-label="Passkey label"
+            maxlength="64"
+          />
+          <button type="submit" class="btn btn-passkey" id="btn-register-new-passkey">
+            + Register New Passkey
+          </button>
+        </form>
+
+        <!-- Registered Passkeys List -->
+        ${renderPasskeyList(user.passkeys)}
+      </div>
+
+      <!-- Protected Account Settings & Express Reauth Order Section -->
+      <div class="account-two-col">
+        <!-- Sensitive Profile & Payment Settings -->
+        <div class="card section-card">
+          <h3>Protected Account & Payment Settings</h3>
+          <p class="section-subtitle">Changes here require step-up reauthentication if your session is locked.</p>
+          <form id="protected-profile-form" class="stacked-form">
+            <div class="form-group">
+              <label for="profile-display-name">Display Name</label>
+              <input
+                type="text"
+                id="profile-display-name"
+                class="input-field"
+                value="${escapeHtml(user.displayName)}"
+                required
+              />
+            </div>
+            <div class="form-group">
+              <label for="profile-username">Account Email / Username</label>
+              <input
+                type="text"
+                id="profile-username"
+                class="input-field"
+                value="${escapeHtml(user.username)}"
+                required
+              />
+            </div>
+            <div class="form-group">
+              <label for="profile-payment">Saved Payment Method</label>
+              <input
+                type="text"
+                id="profile-payment"
+                class="input-field"
+                value="${escapeHtml(user.defaultPaymentMethod)}"
+                required
+              />
+            </div>
+            <button type="submit" class="btn" id="btn-save-protected-profile">
+              Save Protected Settings
+            </button>
+          </form>
+        </div>
+
+        <!-- Rewards Redemption & Express Reauthenticated Checkout -->
+        <div class="card section-card">
+          <h3>Daily Grind Rewards & Express Order</h3>
+          <p class="section-subtitle">Redeem your points or place a 1-tap order protected by passkey reauthentication.</p>
+          <div class="rewards-summary-box">
+            <div>
+              <strong>Available Balance:</strong> ${Number(user.rewardPoints)} pts
+            </div>
+            <small>100 pts = 1 Free Artisanal Beverage</small>
+          </div>
+          <div class="express-order-actions">
+            <button
+              type="button"
+              class="btn btn-passkey"
+              id="btn-redeem-reward-order"
+              ${user.rewardPoints < 100 ? 'disabled' : ''}
+            >
+              🎁 Redeem 100 Pts for Free Maple Oat Latte
+            </button>
+            <button
+              type="button"
+              class="btn btn-outline"
+              id="btn-express-card-order"
+            >
+              ☕ Express Order Cold Brew ($5.50 on ${escapeHtml(user.defaultPaymentMethod)})
+            </button>
+          </div>
+
+          ${
+            state.orders.length > 0
+              ? `
+                <div class="recent-orders-list" id="recent-orders-list">
+                  <h4>Recent Verified Orders</h4>
+                  ${state.orders
+                    .slice(0, 3)
+                    .map(
+                      (o) => `
+                      <div class="order-receipt-item">
+                        <strong>${escapeHtml(o.orderId)}</strong> — ${escapeHtml(o.itemName)}
+                        <span>(${escapeHtml(o.paymentUsed)})</span>
+                      </div>
+                    `
+                    )
+                    .join('')}
+                </div>
+              `
+              : ''
+          }
+        </div>
+      </div>
+    `;
+
+    bindAccountEvents();
+  }
+}
+
+function bindAccountEvents() {
+  // Add New Passkey Form
+  const addPasskeyForm = document.getElementById('add-passkey-form');
+  addPasskeyForm?.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const labelInput = document.getElementById('new-passkey-label');
+    const passkeyName = labelInput ? labelInput.value.trim() : '';
+    const ok = await registerPasskey({ passkeyName });
+    if (ok && labelInput) labelInput.value = '';
+  });
+
+  // Reauthenticate Now button
+  document.getElementById('btn-trigger-reauth')?.addEventListener('click', () => {
+    promptReauthentication(
+      'Verify your identity using one of your registered passkeys to unlock sensitive account operations for 5 minutes.',
+      async () => {
+        const { ok, data } = await apiFetch('/api/auth/session');
+        if (ok && data.authenticated) {
+          state.user = data.user;
+          renderApp();
+        }
+      }
+    );
+  });
+
+  // Lock / Expire Reauthentication Window button
+  document.getElementById('btn-expire-reauth')?.addEventListener('click', async () => {
+    const { ok, data } = await apiFetch('/api/auth/lock-reauth', { method: 'POST' });
+    if (ok) {
+      state.user = data.user;
+      showToast('Step-up verification window locked. Sensitive actions will now prompt for reauthentication.', 'info');
+      renderApp();
+    }
+  });
+
+  // Rename Passkey buttons
+  document.querySelectorAll('.btn-rename-passkey').forEach((btn) => {
+    btn.addEventListener('click', () => {
+      const id = btn.dataset.id;
+      const box = document.getElementById(`rename-box-${id}`);
+      if (box) {
+        box.style.display = 'flex';
+        box.querySelector('input')?.focus();
+      }
+    });
+  });
+
+  document.querySelectorAll('.btn-cancel-rename').forEach((btn) => {
+    btn.addEventListener('click', () => {
+      const id = btn.dataset.id;
+      const box = document.getElementById(`rename-box-${id}`);
+      if (box) box.style.display = 'none';
+    });
+  });
+
+  document.querySelectorAll('.btn-save-rename').forEach((btn) => {
+    btn.addEventListener('click', async () => {
+      const id = btn.dataset.id;
+      const box = document.getElementById(`rename-box-${id}`);
+      const input = box?.querySelector('input');
+      if (input) {
+        await renamePasskey(id, input.value);
+      }
+    });
+  });
+
+  // Delete Passkey buttons
+  document.querySelectorAll('.btn-delete-passkey').forEach((btn) => {
+    btn.addEventListener('click', async () => {
+      const id = btn.dataset.id;
+      await deletePasskey(id);
+    });
+  });
+
+  // Protected Profile Form
+  const profileForm = document.getElementById('protected-profile-form');
+  profileForm?.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const displayName = document.getElementById('profile-display-name')?.value || '';
+    const username = document.getElementById('profile-username')?.value || '';
+    const defaultPaymentMethod = document.getElementById('profile-payment')?.value || '';
+    await updateProfileSettings({ displayName, username, defaultPaymentMethod });
+  });
+
+  // Express Orders
+  document.getElementById('btn-redeem-reward-order')?.addEventListener('click', async () => {
+    await placeExpressOrder({
+      itemName: 'Maple Oat Latte (Reward Redemption)',
+      totalAmount: '$0.00',
+      useRewards: true,
+    });
+  });
+
+  document.getElementById('btn-express-card-order')?.addEventListener('click', async () => {
+    await placeExpressOrder({
+      itemName: '18-Hour Cold Brew',
+      totalAmount: '$5.50',
+      useRewards: false,
+    });
+  });
+}
+
+// --- Initialization & Static Event Bindings ---
+
+async function initApp() {
+  // Check browser passkey support banner
+  const supportStatusEl = document.getElementById('webauthn-capability-status');
+  if (supportStatusEl) {
+    const supported = browserSupportsWebAuthn();
+    const platformAvailable = supported ? await platformAuthenticatorIsAvailable() : false;
+    supportStatusEl.textContent = supported
+      ? platformAvailable
+        ? '✓ Passkeys & Platform Biometrics Ready'
+        : '✓ WebAuthn Passkeys Supported'
+      : '⚠ WebAuthn Not Available in this Browser';
+  }
+
+  // Load current session
+  const { ok, data } = await apiFetch('/api/auth/session');
+  if (ok && data.authenticated) {
+    state.authenticated = true;
+    state.user = data.user;
+    state.rpID = data.rpID || state.rpID;
+  }
+
+  // Route based on current URL pathname
+  const path = window.location.pathname;
+  if (path === '/account' || path === '/rewards') {
+    state.activeView = 'account';
+  } else if (path === '/login' || path === '/register') {
+    state.activeView = 'auth';
+    state.authTab = path === '/register' ? 'register' : 'signin';
+  } else {
+    state.activeView = 'home';
+  }
+
+  // Bind Top Navigation links
+  document.getElementById('nav-logo')?.addEventListener('click', (e) => {
+    e.preventDefault();
+    navigateTo('home');
+  });
+
+  document.getElementById('nav-home-link')?.addEventListener('click', (e) => {
+    e.preventDefault();
+    navigateTo('home');
+  });
+
+  document.getElementById('nav-rewards-link')?.addEventListener('click', (e) => {
+    e.preventDefault();
+    navigateTo('account');
+  });
+
+  document.getElementById('nav-account-link')?.addEventListener('click', (e) => {
+    e.preventDefault();
+    navigateTo('account');
+  });
+
+  document.getElementById('nav-auth-action')?.addEventListener('click', async (e) => {
+    e.preventDefault();
+    if (state.authenticated) {
+      WebAuthnAbortService.cancelCeremony();
+      await apiFetch('/api/auth/logout', { method: 'POST' });
+      state.authenticated = false;
+      state.user = null;
+      showToast('You have been logged out.', 'info');
+      navigateTo('auth', 'signin');
+    } else {
+      navigateTo('auth', 'signin');
+    }
+  });
+
+  // Hero & Menu order buttons
+  document.querySelectorAll('.js-order-btn').forEach((btn) => {
+    btn.addEventListener('click', async (e) => {
+      e.preventDefault();
+      const item = btn.dataset.item || 'Artisanal Coffee';
+      const price = btn.dataset.price || '$5.25';
+      if (!state.authenticated) {
+        showToast('Sign in or create a passkey to order online!', 'info');
+        navigateTo('auth', 'signin');
+        return;
+      }
+      await placeExpressOrder({ itemName: item, totalAmount: price, useRewards: false });
+    });
+  });
+
+  // Auth View Tabs
+  document.getElementById('tab-btn-signin')?.addEventListener('click', () => {
+    state.authTab = 'signin';
+    renderApp();
+  });
+
+  document.getElementById('tab-btn-register')?.addEventListener('click', () => {
+    state.authTab = 'register';
+    renderApp();
+  });
+
+  // Sign-In with Passkey Button (Modal Ceremony)
+  document.getElementById('btn-signin-passkey')?.addEventListener('click', async () => {
+    const usernameInput = document.getElementById('signin-username');
+    const username = usernameInput ? usernameInput.value.trim() : '';
+    await authenticateWithPasskey({ username, useBrowserAutofill: false });
+  });
+
+  // Fallback Password Sign-In Form
+  document.getElementById('signin-password-form')?.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const username = document.getElementById('signin-username')?.value.trim() || '';
+    const password = document.getElementById('signin-password')?.value || '';
+    const { ok, data } = await apiFetch('/api/auth/login-password', {
+      method: 'POST',
+      body: { username, password },
+    });
+    if (!ok) {
+      showToast(data.error || 'Invalid credentials.', 'error');
+      return;
+    }
+    WebAuthnAbortService.cancelCeremony();
+    state.authenticated = true;
+    state.user = data.user;
+    showToast(`Welcome back, ${data.user.displayName}!`, 'success');
+    navigateTo('account');
+  });
+
+  // Register New Account with Passkey Form
+  document.getElementById('register-passkey-form')?.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const username = document.getElementById('register-username')?.value.trim() || '';
+    const displayName = document.getElementById('register-display-name')?.value.trim() || '';
+    const passkeyName = document.getElementById('register-passkey-name')?.value.trim() || '';
+    if (!username) {
+      showToast('Please enter your email or username.', 'error');
+      return;
+    }
+    await registerPasskey({ username, displayName, passkeyName });
+  });
+
+  // Register with Password fallback button
+  document.getElementById('btn-register-password-fallback')?.addEventListener('click', async () => {
+    const username = document.getElementById('register-username')?.value.trim() || '';
+    const displayName = document.getElementById('register-display-name')?.value.trim() || '';
+    const password = document.getElementById('register-password')?.value || 'coffee123';
+    if (!username) {
+      showToast('Please enter an email or username first.', 'error');
+      return;
+    }
+    const { ok, data } = await apiFetch('/api/auth/signup', {
+      method: 'POST',
+      body: { username, displayName, password },
+    });
+    if (!ok) {
+      showToast(data.error || 'Could not create account.', 'error');
+      return;
+    }
+    state.authenticated = true;
+    state.user = data.user;
+    showToast('Account created! You can now register a passkey in My Account.', 'success');
+    navigateTo('account');
+  });
+
+  // Step-Up Reauthentication Modal Bindings
+  document.getElementById('reauth-passkey-btn')?.addEventListener('click', async () => {
+    await performPasskeyReauthentication('step-up-modal');
+  });
+
+  document.getElementById('reauth-password-form')?.addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const passwordInput = document.getElementById('reauth-password-input');
+    const password = passwordInput ? passwordInput.value : '';
+    const { ok, data } = await apiFetch('/api/auth/reauthenticate-password', {
+      method: 'POST',
+      body: { password },
+    });
+    if (!ok) {
+      showToast(data.error || 'Password verification failed.', 'error');
+      return;
+    }
+    if (passwordInput) passwordInput.value = '';
+    state.user = data.user;
+    showToast('Identity verified with password.', 'success');
+    closeReauthModal();
+    renderApp();
+    if (typeof state.pendingReauthCallback === 'function') {
+      const cb = state.pendingReauthCallback;
+      state.pendingReauthCallback = null;
+      await cb();
+    }
+  });
+
+  document.getElementById('reauth-cancel-btn')?.addEventListener('click', () => {
+    state.pendingReauthCallback = null;
+    closeReauthModal();
+  });
+
+  window.addEventListener('popstate', () => {
+    const p = window.location.pathname;
+    if (p === '/account' || p === '/rewards') state.activeView = 'account';
+    else if (p === '/login' || p === '/register') state.activeView = 'auth';
+    else state.activeView = 'home';
+    renderApp();
+  });
+
+  renderApp();
+}
+
+document.addEventListener('DOMContentLoaded', initApp);
