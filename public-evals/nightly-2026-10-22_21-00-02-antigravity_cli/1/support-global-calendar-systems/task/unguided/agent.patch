+  <script type="module">
+    async function ensureTemporal() {
+      if (typeof globalThis.Temporal !== 'undefined') {
+        return globalThis.Temporal;
+      }
+      const { Temporal } = await import('https://cdn.jsdelivr.net/npm/temporal-polyfill@0.3.0/+esm');
+      globalThis.Temporal = Temporal;
+      return Temporal;
+    }
+
+    const CALENDARS = [
+      {
+        id: 'islamic-umalqura',
+        prefix: 'islamic',
+        locale: 'en-US',
+        formatOptions: {
+          calendar: 'islamic-umalqura',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      },
+      {
+        id: 'hebrew',
+        prefix: 'hebrew',
+        locale: 'en-US',
+        formatOptions: {
+          calendar: 'hebrew',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      },
+      {
+        id: 'japanese',
+        prefix: 'japanese',
+        locale: 'en-US',
+        formatOptions: {
+          calendar: 'japanese',
+          era: 'long',
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        }
+      }
+    ];
+
+    function getTimelineLabel(Temporal, selectedIsoDate, todayIsoDate) {
+      const cmp = Temporal.PlainDate.compare(selectedIsoDate, todayIsoDate);
+      if (cmp < 0) return 'Past';
+      if (cmp > 0) return 'Future';
+      return 'Today';
+    }
+
+    function renderCalendars(Temporal, isoDateString) {
+      if (!isoDateString) return;
+
+      let selectedIsoDate;
+      try {
+        selectedIsoDate = Temporal.PlainDate.from(isoDateString);
+      } catch {
+        return;
+      }
+
+      const todayIsoDate = Temporal.Now.plainDateISO();
+      const timelineLabel = getTimelineLabel(Temporal, selectedIsoDate, todayIsoDate);
+
+      for (const calConfig of CALENDARS) {
+        const convertedDate = selectedIsoDate.withCalendar(calConfig.id);
+
+        // 1. Formatted localized date (with era names for Japanese)
+        const formattedDate = convertedDate.toLocaleString(calConfig.locale, calConfig.formatOptions);
+        const dateEl = document.getElementById(`${calConfig.prefix}-date`);
+        if (dateEl) {
+          dateEl.textContent = formattedDate;
+        }
+
+        // 2. Converted year, numeric month, and unique stable month code
+        const yearEl = document.getElementById(`${calConfig.prefix}-year`);
+        if (yearEl) {
+          yearEl.textContent = String(convertedDate.year);
+        }
+
+        const monthEl = document.getElementById(`${calConfig.prefix}-month`);
+        if (monthEl) {
+          monthEl.textContent = String(convertedDate.month);
+        }
+
+        const monthCodeEl = document.getElementById(`${calConfig.prefix}-month-code`);
+        if (monthCodeEl) {
+          monthCodeEl.textContent = convertedDate.monthCode;
+        }
+
+        // 3. Total number of months in that specific calendar year
+        const monthsInYearEl = document.getElementById(`${calConfig.prefix}-months-in-year`);
+        if (monthsInYearEl) {
+          monthsInYearEl.textContent = String(convertedDate.monthsInYear);
+        }
+
+        // 4. Timeline label comparing selected date against current date ('Past', 'Future', or 'Today')
+        const timelineEl = document.getElementById(`${calConfig.prefix}-timeline`);
+        if (timelineEl) {
+          timelineEl.textContent = timelineLabel;
+          timelineEl.className = `timeline-badge timeline-${timelineLabel.toLowerCase()}`;
+        }
+
+        // 5. Month breakdown showing each month's code and how many days are in that month for that specific year
+        const breakdownListEl = document.getElementById(`${calConfig.prefix}-month-breakdown`);
+        if (breakdownListEl) {
+          breakdownListEl.innerHTML = '';
+          const totalMonths = convertedDate.monthsInYear;
+          for (let m = 1; m <= totalMonths; m++) {
+            const monthDate = convertedDate.with({ month: m, day: 1 });
+            const code = monthDate.monthCode;
+            const days = monthDate.daysInMonth;
+
+            const li = document.createElement('li');
+            const isCurrentMonth = code === convertedDate.monthCode;
+            const isLeapMonth = code.endsWith('L');
+            li.className = `month-chip${isCurrentMonth ? ' active-month' : ''}${isLeapMonth ? ' leap-month' : ''}`;
+            li.setAttribute('data-month-code', code);
+            li.setAttribute('data-days-in-month', String(days));
+
+            const codeSpan = document.createElement('span');
+            codeSpan.className = 'month-chip-code';
+            codeSpan.textContent = code;
+
+            const daysSpan = document.createElement('span');
+            daysSpan.className = 'month-chip-days';
+            daysSpan.textContent = `${days} days`;
+
+            li.append(codeSpan, daysSpan);
+            breakdownListEl.appendChild(li);
+          }
+        }
+      }
+    }
+
+    async function initCalendarExplorer() {
+      const Temporal = await ensureTemporal();
+      const dateInput = document.getElementById('calendar-date-input');
+      if (!dateInput) return;
+
+      const todayIso = Temporal.Now.plainDateISO();
+      if (!dateInput.value) {
+        dateInput.value = todayIso.toString();
+      }
+
+      renderCalendars(Temporal, dateInput.value);
+
+      const handleDateUpdate = (event) => {
+        renderCalendars(Temporal, event.target.value);
+      };
+
+      dateInput.addEventListener('input', handleDateUpdate);
+      dateInput.addEventListener('change', handleDateUpdate);
+    }
+
+    initCalendarExplorer();
+  </script>
 </body>
 
