+  <script type="module">
+    async function getTemporal() {
+      if (typeof Temporal !== 'undefined') {
+        return Temporal;
+      }
+
+      try {
+        const module = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+        if (module.toTemporalInstant && !Date.prototype.toTemporalInstant) {
+          Date.prototype.toTemporalInstant = module.toTemporalInstant;
+        }
+        return module.Temporal;
+      } catch (e) {
+        console.error('Failed to load Temporal polyfill:', e);
+        throw e;
+      }
+    }
+
+    function isCalendarSupported(calendarId) {
+      try {
+        return Intl.supportedValuesOf('calendar').includes(calendarId);
+      } catch {
+        return false;
+      }
+    }
+
+    const CALENDARS = [
+      {
+        id: 'islamic-umalqura',
+        title: 'Islamic (Umm al-Qura)',
+        locale: 'en-u-ca-islamic-umalqura',
+        formattedId: 'islamic-date',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric'
+        }
+      },
+      {
+        id: 'hebrew',
+        title: 'Hebrew Calendar',
+        locale: 'en-u-ca-hebrew',
+        formattedId: 'hebrew-date',
+        formatOptions: {
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric'
+        }
+      },
+      {
+        id: 'japanese',
+        title: 'Japanese Calendar',
+        locale: 'en-u-ca-japanese',
+        formattedId: 'japanese-date',
+        formatOptions: {
+          era: 'long',
+          day: 'numeric',
+          month: 'long',
+          year: 'numeric'
+        }
+      }
+    ];
+
+    function renderCalendars(TemporalRef, isoDateString) {
+      const container = document.getElementById('calendar-cards');
+      if (!container || !isoDateString) return;
+
+      let selectedIsoDate;
+      try {
+        selectedIsoDate = TemporalRef.PlainDate.from(isoDateString);
+      } catch {
+        return;
+      }
+
+      const todayIso = TemporalRef.Now.plainDateISO();
+      container.replaceChildren();
+
+      for (const cal of CALENDARS) {
+        const supported = isCalendarSupported(cal.id);
+        const targetDate = supported
+          ? selectedIsoDate.withCalendar(cal.id)
+          : selectedIsoDate;
+        const todayInCalendar = supported
+          ? todayIso.withCalendar(cal.id)
+          : todayIso;
+
+        const comparison = TemporalRef.PlainDate.compare(targetDate, todayInCalendar);
+        const timelineLabel = comparison < 0 ? 'Past' : comparison > 0 ? 'Future' : 'Today';
+
+        const localizedDisplay = targetDate.toLocaleString(cal.locale, cal.formatOptions);
+
+        const card = document.createElement('article');
+        card.className = 'card calendar-card';
+        card.dataset.calendar = cal.id;
+
+        const header = document.createElement('div');
+        header.className = 'calendar-card-header';
+
+        const titleEl = document.createElement('h3');
+        titleEl.textContent = cal.title;
+
+        const badgeEl = document.createElement('span');
+        badgeEl.className = 'timeline-badge';
+        badgeEl.dataset.timeline = timelineLabel;
+        badgeEl.textContent = timelineLabel;
+
+        header.append(titleEl, badgeEl);
+
+        const formattedEl = document.createElement('div');
+        formattedEl.className = 'formatted-date';
+        formattedEl.id = cal.formattedId;
+        formattedEl.textContent = localizedDisplay;
+
+        const metaGrid = document.createElement('div');
+        metaGrid.className = 'calendar-meta';
+
+        const yearItem = document.createElement('div');
+        yearItem.innerHTML = `<strong>Year:</strong> <span class="calendar-year">${targetDate.year}</span>`;
+
+        const monthItem = document.createElement('div');
+        monthItem.innerHTML = `<strong>Month:</strong> <span class="calendar-month">${targetDate.month}</span>`;
+
+        const monthCodeItem = document.createElement('div');
+        monthCodeItem.innerHTML = `<strong>Month Code:</strong> <span class="calendar-month-code">${targetDate.monthCode}</span>`;
+
+        const monthsInYearItem = document.createElement('div');
+        monthsInYearItem.innerHTML = `<strong>Months in Year:</strong> <span class="calendar-months-in-year">${targetDate.monthsInYear}</span>`;
+
+        metaGrid.append(yearItem, monthItem, monthCodeItem, monthsInYearItem);
+
+        const breakdown = document.createElement('div');
+        breakdown.className = 'month-breakdown';
+
+        const breakdownTitle = document.createElement('h4');
+        breakdownTitle.textContent = `Month Breakdown (${targetDate.monthsInYear} months)`;
+
+        const monthList = document.createElement('ul');
+        monthList.className = 'month-list';
+
+        for (let m = 1; m <= targetDate.monthsInYear; m++) {
+          const monthDate = targetDate.with({ month: m, day: 1 });
+          const li = document.createElement('li');
+          li.className = 'month-item' + (monthDate.monthCode === targetDate.monthCode ? ' active-month' : '');
+          li.dataset.monthCode = monthDate.monthCode;
+          li.dataset.daysInMonth = String(monthDate.daysInMonth);
+
+          const codeSpan = document.createElement('span');
+          codeSpan.className = 'month-code';
+          codeSpan.textContent = monthDate.monthCode;
+
+          const daysSpan = document.createElement('span');
+          daysSpan.className = 'month-days';
+          daysSpan.textContent = `${monthDate.daysInMonth} days`;
+
+          li.append(codeSpan, document.createTextNode(': '), daysSpan);
+          monthList.appendChild(li);
+        }
+
+        breakdown.append(breakdownTitle, monthList);
+        card.append(header, formattedEl, metaGrid, breakdown);
+        container.appendChild(card);
+      }
+    }
+
+    async function initCalendarTool() {
+      const TemporalRef = await getTemporal();
+      const dateInput = document.getElementById('calendar-date-input');
+      if (!dateInput) return;
+
+      const todayIso = TemporalRef.Now.plainDateISO().toString();
+      if (!dateInput.value) {
+        dateInput.value = todayIso;
+      }
+
+      renderCalendars(TemporalRef, dateInput.value);
+
+      dateInput.addEventListener('input', (event) => {
+        renderCalendars(TemporalRef, event.target.value);
+      });
+      dateInput.addEventListener('change', (event) => {
+        renderCalendars(TemporalRef, event.target.value);
+      });
+    }
+
+    initCalendarTool();
+  </script>
 </body>
 
