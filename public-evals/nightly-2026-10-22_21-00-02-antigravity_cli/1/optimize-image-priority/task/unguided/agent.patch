diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -0,0 +1,460 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1.0">
+  <title>AETHER // Studio Reference Headphone</title>
+  <!-- Preload LCP Hero Image -->
+  <link rel="preload" as="image" href="hero-lcp.jpg" fetchpriority="high">
+  <style>
+    :root {
+      --bg: #FAF9F6;
+      --surface: #F2F0EA;
+      --text: #141413;
+      --muted: #686662;
+      --accent: #C84B31;
+      --border: #E2DFD7;
+    }
+
+    * {
+      box-sizing: border-box;
+      margin: 0;
+      padding: 0;
+    }
+
+    body {
+      background-color: var(--bg);
+      color: var(--text);
+      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+      line-height: 1.5;
+      -webkit-font-smoothing: antialiased;
+    }
+
+    /* Header & Mega Menu */
+    header {
+      position: relative;
+      border-bottom: 1px solid var(--border);
+      background: var(--bg);
+      z-index: 20;
+    }
+
+    .nav-bar {
+      max-width: 1200px;
+      margin: 0 auto;
+      padding: 1.25rem 2rem;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    .brand {
+      font-weight: 700;
+      letter-spacing: 0.12em;
+      font-size: 0.95rem;
+      text-transform: uppercase;
+      text-decoration: none;
+      color: var(--text);
+    }
+
+    .menu-trigger {
+      background: none;
+      border: 1px solid var(--border);
+      padding: 0.5rem 1rem;
+      font-size: 0.85rem;
+      font-family: inherit;
+      color: var(--text);
+      cursor: pointer;
+      letter-spacing: 0.04em;
+    }
+
+    .mega-menu {
+      border-top: 1px solid var(--border);
+      background: var(--surface);
+      padding: 2.5rem 2rem;
+    }
+
+    .mega-menu[hidden] {
+      display: none;
+    }
+
+    .mega-menu-inner {
+      max-width: 1200px;
+      margin: 0 auto;
+      display: grid;
+      grid-template-columns: 1fr 320px;
+      gap: 2rem;
+      align-items: center;
+    }
+
+    .mega-links {
+      display: flex;
+      gap: 3rem;
+      list-style: none;
+    }
+
+    .mega-links a {
+      color: var(--text);
+      text-decoration: none;
+      font-size: 0.95rem;
+      font-weight: 500;
+    }
+
+    .mega-promo img {
+      width: 100%;
+      height: auto;
+      display: block;
+      background: var(--border);
+      border: 1px solid var(--border);
+    }
+
+    /* Main Content & Hero (LCP) */
+    main {
+      max-width: 1200px;
+      margin: 0 auto;
+      padding: 0 2rem;
+    }
+
+    .hero {
+      padding: 4rem 0;
+      display: grid;
+      grid-template-columns: 1fr 1.25fr;
+      gap: 4rem;
+      align-items: center;
+      border-bottom: 1px solid var(--border);
+    }
+
+    .hero-eyebrow {
+      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      letter-spacing: 0.1em;
+      color: var(--accent);
+      margin-bottom: 1rem;
+    }
+
+    .hero h1 {
+      font-size: clamp(2.25rem, 4vw, 3.5rem);
+      line-height: 1.08;
+      letter-spacing: -0.03em;
+      margin-bottom: 1.25rem;
+    }
+
+    .hero p {
+      color: var(--muted);
+      font-size: 1.05rem;
+      margin-bottom: 2rem;
+      max-width: 44ch;
+    }
+
+    .cta {
+      display: inline-block;
+      background: var(--text);
+      color: var(--bg);
+      text-decoration: none;
+      padding: 0.875rem 1.75rem;
+      font-size: 0.9rem;
+      font-weight: 500;
+      letter-spacing: 0.03em;
+    }
+
+    .hero-media img {
+      width: 100%;
+      height: auto;
+      aspect-ratio: 16 / 10;
+      object-fit: cover;
+      display: block;
+      background: var(--surface);
+      border: 1px solid var(--border);
+    }
+
+    /* Product Gallery */
+    .gallery-section {
+      padding: 5rem 0;
+      border-bottom: 1px solid var(--border);
+    }
+
+    .section-header {
+      display: flex;
+      justify-content: space-between;
+      align-items: baseline;
+      margin-bottom: 2rem;
+    }
+
+    .section-header h2 {
+      font-size: 1.5rem;
+      letter-spacing: -0.02em;
+    }
+
+    .gallery-controls {
+      display: flex;
+      gap: 0.5rem;
+    }
+
+    .toggle-btn {
+      background: transparent;
+      border: 1px solid var(--border);
+      padding: 0.5rem 1rem;
+      font-size: 0.85rem;
+      font-family: inherit;
+      cursor: pointer;
+      color: var(--text);
+    }
+
+    .toggle-btn[aria-pressed="true"] {
+      background: var(--text);
+      color: var(--bg);
+      border-color: var(--text);
+    }
+
+    .gallery-stage img {
+      width: 100%;
+      max-width: 800px;
+      height: auto;
+      aspect-ratio: 4 / 3;
+      object-fit: cover;
+      display: block;
+      background: var(--surface);
+      border: 1px solid var(--border);
+    }
+
+    .gallery-stage img[hidden] {
+      display: none;
+    }
+
+    /* Below-the-fold Specifications to push footer down */
+    .specs-section {
+      padding: 6rem 0;
+      min-height: 90vh;
+      display: flex;
+      flex-direction: column;
+      justify-content: center;
+    }
+
+    .specs-grid {
+      display: grid;
+      grid-template-columns: repeat(3, 1fr);
+      gap: 2rem;
+      border-top: 1px solid var(--border);
+      padding-top: 2rem;
+    }
+
+    .spec-card dt {
+      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+      font-size: 0.75rem;
+      text-transform: uppercase;
+      color: var(--muted);
+      margin-bottom: 0.5rem;
+    }
+
+    .spec-card dd {
+      font-size: 1.5rem;
+      font-weight: 600;
+      letter-spacing: -0.02em;
+    }
+
+    /* Footer */
+    footer {
+      border-top: 1px solid var(--border);
+      padding: 4rem 2rem;
+      background: var(--surface);
+    }
+
+    .footer-inner {
+      max-width: 1200px;
+      margin: 0 auto;
+      display: flex;
+      justify-content: space-between;
+      align-items: center;
+    }
+
+    .footer-inner img {
+      display: block;
+      width: 120px;
+      height: 36px;
+      object-fit: contain;
+    }
+
+    .copyright {
+      font-size: 0.85rem;
+      color: var(--muted);
+    }
+
+    @media (max-width: 768px) {
+      .hero, .mega-menu-inner, .specs-grid {
+        grid-template-columns: 1fr;
+      }
+    }
+  </style>
+</head>
+<body>
+
+  <header>
+    <nav class="nav-bar" aria-label="Main Navigation">
+      <a href="#" class="brand">Aether Acoustics</a>
+      <button
+        type="button"
+        id="mega-menu-toggle"
+        class="menu-trigger"
+        aria-expanded="false"
+        aria-controls="mega-menu-panel"
+      >
+        Explore Series
+      </button>
+    </nav>
+
+    <!-- Secondary navigation mega-menu, initially hidden -->
+    <div id="mega-menu-panel" class="mega-menu" hidden>
+      <div class="mega-menu-inner">
+        <ul class="mega-links">
+          <li><a href="#overview">Reference 01</a></li>
+          <li><a href="#gallery">Finish Options</a></li>
+          <li><a href="#specs">Acoustic Architecture</a></li>
+        </ul>
+        <div class="mega-promo">
+          <img
+            src="mega-menu-promo.jpg"
+            alt="Limited edition anodized titanium edition preview"
+            width="320"
+            height="180"
+            loading="lazy"
+            decoding="async"
+            fetchpriority="low"
+          >
+        </div>
+      </div>
+    </div>
+  </header>
+
+  <main>
+    <!-- Hero Section: Largest Contentful Paint (LCP) Element -->
+    <section id="overview" class="hero">
+      <div class="hero-copy">
+        <p class="hero-eyebrow">Model 01 // Open-Back Planar</p>
+        <h1>Uncolored Acoustic Precision.</h1>
+        <p>Machined from solid billet aluminum with an ultra-thin 1.8-micron diaphragm for zero-distortion transient response.</p>
+        <a href="#specs" class="cta">Reserve Batch 04 — $890</a>
+      </div>
+      <div class="hero-media">
+        <img
+          src="hero-lcp.jpg"
+          alt="Aether Model 01 Open-Back Reference Headphones"
+          width="1200"
+          height="750"
+          loading="eager"
+          fetchpriority="high"
+          decoding="sync"
+        >
+      </div>
+    </section>
+
+    <!-- Product Image Gallery with Toggle -->
+    <section id="gallery" class="gallery-section">
+      <div class="section-header">
+        <h2>Chassis Views</h2>
+        <div class="gallery-controls">
+          <button
+            type="button"
+            id="gallery-toggle"
+            class="toggle-btn"
+            aria-pressed="false"
+            aria-controls="gallery-alt-img"
+          >
+            Toggle Alternate Angle
+          </button>
+        </div>
+      </div>
+
+      <div class="gallery-stage">
+        <!-- First visible gallery image -->
+        <img
+          id="gallery-main-img"
+          src="gallery-main.jpg"
+          alt="Primary profile view of the CNC milled ear cup"
+          width="800"
+          height="600"
+        >
+        <!-- Second gallery image hidden behind a toggle -->
+        <img
+          id="gallery-alt-img"
+          src="gallery-alt.jpg"
+          alt="Alternate detail view of the planar magnetic driver grille"
+          width="800"
+          height="600"
+          loading="lazy"
+          decoding="async"
+          fetchpriority="low"
+          hidden
+        >
+      </div>
+    </section>
+
+    <!-- Technical Specifications to ensure footer stays well below the fold -->
+    <section id="specs" class="specs-section">
+      <dl class="specs-grid">
+        <div class="spec-card">
+          <dt>Frequency Response</dt>
+          <dd>5 Hz – 55,000 Hz</dd>
+        </div>
+        <div class="spec-card">
+          <dt>Total Harmonic Distortion</dt>
+          <dd>&lt; 0.04% @ 1 kHz</dd>
+        </div>
+        <div class="spec-card">
+          <dt>Total Mass</dt>
+          <dd>340g (Uncabled)</dd>
+        </div>
+      </dl>
+    </section>
+  </main>
+
+  <footer>
+    <div class="footer-inner">
+      <img
+        src="footer-logo.png"
+        alt="Aether Acoustics Logo"
+        width="120"
+        height="36"
+        loading="lazy"
+        decoding="async"
+        fetchpriority="low"
+      >
+      <p class="copyright">&copy; 2026 Aether Acoustics Lab. All rights reserved.</p>
+    </div>
+  </footer>
+
+  <script>
+    // Navigation Mega-Menu Toggle
+    const menuBtn = document.getElementById('mega-menu-toggle');
+    const menuPanel = document.getElementById('mega-menu-panel');
+
+    menuBtn.addEventListener('click', () => {
+      const isHidden = menuPanel.hasAttribute('hidden');
+      if (isHidden) {
+        menuPanel.removeAttribute('hidden');
+        menuBtn.setAttribute('aria-expanded', 'true');
+      } else {
+        menuPanel.setAttribute('hidden', '');
+        menuBtn.setAttribute('aria-expanded', 'false');
+      }
+    });
+
+    // Product Gallery Image Toggle
+    const galleryBtn = document.getElementById('gallery-toggle');
+    const mainImg = document.getElementById('gallery-main-img');
+    const altImg = document.getElementById('gallery-alt-img');
+
+    galleryBtn.addEventListener('click', () => {
+      const isAltHidden = altImg.hasAttribute('hidden');
+      if (isAltHidden) {
+        altImg.removeAttribute('hidden');
+        mainImg.setAttribute('hidden', '');
+        galleryBtn.setAttribute('aria-pressed', 'true');
+      } else {
+        altImg.setAttribute('hidden', '');
+        mainImg.removeAttribute('hidden');
+        galleryBtn.setAttribute('aria-pressed', 'false');
+      }
+    });
+  </script>
+</body>
+</html>
