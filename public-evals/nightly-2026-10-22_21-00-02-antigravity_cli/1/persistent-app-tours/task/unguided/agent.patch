+  <script>
+    const featureLink = document.getElementById('feature');
+    const tourStep = document.getElementById('tour-step');
+    const closeBtn = document.getElementById('close-tour');
+
+    let isTourOpen = true;
+
+    if (typeof tourStep.showPopover === 'function') {
+      tourStep.showPopover();
+    }
+
+    tourStep.addEventListener('toggle', (event) => {
+      isTourOpen = event.newState === 'open';
+    });
+
+    closeBtn.addEventListener('click', () => {
+      isTourOpen = false;
+      if (typeof tourStep.hidePopover === 'function') {
+        if (tourStep.matches(':popover-open')) {
+          tourStep.hidePopover();
+        }
+      } else {
+        tourStep.hidden = true;
+      }
+    });
+
+    featureLink.addEventListener('click', (event) => {
+      if (isTourOpen || (typeof tourStep.matches === 'function' && tourStep.matches(':popover-open'))) {
+        event.preventDefault();
+      }
+    });
+
+    if (typeof CSS === 'undefined' || !CSS.supports('anchor-name', '--feature')) {
+      const updatePosition = () => {
+        if (!isTourOpen) return;
+        const rect = featureLink.getBoundingClientRect();
+        tourStep.style.top = `${rect.bottom + 12}px`;
+        tourStep.style.left = `${rect.left + rect.width / 2}px`;
+      };
+      updatePosition();
+      window.addEventListener('resize', updatePosition);
+      window.addEventListener('scroll', updatePosition, { passive: true });
+    }
+  </script>
+
