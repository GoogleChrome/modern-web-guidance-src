     <!-- Top Stories Bar -->
     <div class="bg-white border-b border-gray-300">
         <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
-            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
-                {topStories.map(article => (
-                    <div class="border-l border-gray-300 pl-4 first:border-l-0 first:pl-0">
-                        <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
-                            <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
-                        </a>
-                        <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
-                    </div>
-                ))}
+            <div id="top-stories-slider" class="flex items-center justify-between gap-4">
+                <button
+                    id="prev-story-btn"
+                    type="button"
+                    class="px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+                >
+                    Previous
+                </button>
+
+                <div id="top-story-slide" class="top-story-slide flex-1 min-w-0 overflow-hidden text-center">
+                    {topStories.map((article, index) => (
+                        <div
+                            data-story-slide
+                            hidden={index !== 0}
+                            class={index === 0 ? "block" : "hidden"}
+                        >
+                            <a href={`${import.meta.env.BASE_URL}articles/${article.id}`}>
+                                <h3 class="font-bold text-gray-900 hover:text-amber-400 cursor-pointer">{article.data.title}</h3>
+                            </a>
+                            <span class="text-xs text-gray-500">{article.data.date.toLocaleDateString()}</span>
+                        </div>
+                    ))}
+                </div>
+
+                <button
+                    id="next-story-btn"
+                    type="button"
+                    class="px-3 py-1.5 text-sm font-semibold text-gray-700 bg-gray-100 hover:bg-amber-400 hover:text-gray-900 rounded transition-colors cursor-pointer shrink-0"
+                >
+                    Next
+                </button>
             </div>
         </div>
     </div>
 
+    <script>
+        function navigate(updateDOM: () => void, direction: 'forward' | 'backward') {
+            if (!document.startViewTransition) {
+                updateDOM();
+                return;
+            }
+
+            const transition = document.startViewTransition({
+                update: updateDOM,
+                types: [direction],
+            });
+            transition.ready?.catch(() => {});
+        }
+
+        function initTopStoriesSlider() {
+            const slider = document.getElementById('top-stories-slider');
+            if (!slider || slider.dataset.initialized === 'true') return;
+            slider.dataset.initialized = 'true';
+
+            const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-story-slide]'));
+            const prevBtn = document.getElementById('prev-story-btn');
+            const nextBtn = document.getElementById('next-story-btn');
+
+            if (slides.length === 0 || !prevBtn || !nextBtn) return;
+
+            let currentIndex = 0;
+
+            const showSlide = (nextIndex: number, direction: 'forward' | 'backward') => {
+                navigate(() => {
+                    currentIndex = nextIndex;
+                    slides.forEach((slide, index) => {
+                        const isActive = index === currentIndex;
+                        slide.hidden = !isActive;
+                        slide.classList.toggle('hidden', !isActive);
+                        slide.classList.toggle('block', isActive);
+                    });
+                }, direction);
+            };
+
+            nextBtn.addEventListener('click', () => {
+                const nextIndex = (currentIndex + 1) % slides.length;
+                showSlide(nextIndex, 'forward');
+            });
+
+            prevBtn.addEventListener('click', () => {
+                const prevIndex = (currentIndex - 1 + slides.length) % slides.length;
+                showSlide(prevIndex, 'backward');
+            });
+        }
+
+        initTopStoriesSlider();
+        document.addEventListener('astro:page-load', initTopStoriesSlider);
+    </script>
+
     <!-- Main Content Area -->
     <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-6 mt-6">
         <ArticleTeaser article={topArticle} large={true} />
