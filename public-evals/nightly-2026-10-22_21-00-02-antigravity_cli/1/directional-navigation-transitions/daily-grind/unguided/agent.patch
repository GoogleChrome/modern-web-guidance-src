+  <script>
+    (function () {
+      const cards = Array.from(document.querySelectorAll('.carousel-viewport .card'));
+      const prevBtn = document.getElementById('prev-btn');
+      const nextBtn = document.getElementById('next-btn');
+      let currentIndex = 0;
+
+      function showItem(newIndex, direction) {
+        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+
+        cards.forEach((card, index) => {
+          card.classList.remove('active', 'slide-in-right', 'slide-in-left');
+          if (index === newIndex) {
+            card.classList.add('active');
+            if (!reduceMotion && direction) {
+              // Trigger reflow so animation restarts cleanly on rapid clicks
+              void card.offsetWidth;
+              card.classList.add(direction === 'next' ? 'slide-in-right' : 'slide-in-left');
+            }
+          }
+        });
+
+        currentIndex = newIndex;
+      }
+
+      prevBtn.addEventListener('click', () => {
+        const nextIndex = (currentIndex - 1 + cards.length) % cards.length;
+        showItem(nextIndex, 'prev');
+      });
+
+      nextBtn.addEventListener('click', () => {
+        const nextIndex = (currentIndex + 1) % cards.length;
+        showItem(nextIndex, 'next');
+      });
+    })();
+  </script>
