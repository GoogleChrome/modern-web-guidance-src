+  <script>
+    const STORAGE_KEY_TIME = 'dailyGrind_pickupReminderPlainTime';
+    const STORAGE_KEY_DATE = 'dailyGrind_coffeeAnniversaryPlainDate';
+
+    function initializeApp() {
+      const form = document.getElementById('coffee-preferences-form');
+      const timeInput = document.getElementById('pickup-reminder-time');
+      const dateInput = document.getElementById('coffee-anniversary-date');
+      const statusEl = document.getElementById('preferences-status');
+
+      const displayTimeEl = document.getElementById('display-pickup-time');
+      const displayTimeDetailsEl = document.getElementById('display-pickup-details');
+      const displayDateEl = document.getElementById('display-anniversary-date');
+      const displayDateDetailsEl = document.getElementById('display-anniversary-details');
+
+      // Load saved plain ISO strings if available
+      const savedTimeStr = localStorage.getItem(STORAGE_KEY_TIME) || timeInput.value || '08:30';
+      const savedDateStr = localStorage.getItem(STORAGE_KEY_DATE) || dateInput.value || '2023-10-22';
+
+      let currentPlainTime = Temporal.PlainTime.from(savedTimeStr);
+      let currentPlainDate = Temporal.PlainDate.from(savedDateStr);
+
+      function renderSchedule(plainTime, plainDate) {
+        // Use Temporal.PlainTime and Temporal.PlainDate directly without time zone conversion
+        const { hour, minute } = plainTime;
+        const { year, month, day } = plainDate;
+
+        const isoTime = `${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')}`;
+        const isoDate = plainDate.toString();
+
+        timeInput.value = isoTime;
+        dateInput.value = isoDate;
+
+        displayTimeEl.textContent = plainTime.toLocaleString(undefined, {
+          hour: '2-digit',
+          minute: '2-digit'
+        });
+        displayTimeDetailsEl.textContent = `Wall-clock time: ${isoTime} (Hour ${hour}, Minute ${String(minute).padStart(2, '0')} — invariant across time zones)`;
+
+        displayDateEl.textContent = plainDate.toLocaleString(undefined, {
+          year: 'numeric',
+          month: 'long',
+          day: 'numeric'
+        });
+        displayDateDetailsEl.textContent = `Calendar date: ${isoDate} (Year ${year}, Month ${month}, Day ${day} — invariant across time zones)`;
+      }
+
+      renderSchedule(currentPlainTime, currentPlainDate);
+
+      timeInput.addEventListener('input', () => {
+        timeInput.setCustomValidity('');
+        statusEl.textContent = '';
+      });
+
+      dateInput.addEventListener('input', () => {
+        dateInput.setCustomValidity('');
+        statusEl.textContent = '';
+      });
+
+      form.addEventListener('submit', (e) => {
+        e.preventDefault();
+
+        try {
+          const nextPlainTime = Temporal.PlainTime.from(timeInput.value);
+          const nextPlainDate = Temporal.PlainDate.from(dateInput.value);
+
+          const unchanged =
+            nextPlainTime.equals(currentPlainTime) &&
+            nextPlainDate.equals(currentPlainDate);
+
+          currentPlainTime = nextPlainTime;
+          currentPlainDate = nextPlainDate;
+
+          localStorage.setItem(STORAGE_KEY_TIME, currentPlainTime.toString());
+          localStorage.setItem(STORAGE_KEY_DATE, currentPlainDate.toString());
+
+          renderSchedule(currentPlainTime, currentPlainDate);
+          statusEl.textContent = unchanged
+            ? 'Preferences confirmed (no changes needed).'
+            : 'Preferences saved! Your reminder and anniversary remain fixed regardless of travel.';
+        } catch (err) {
+          statusEl.textContent = 'Please enter a valid time and calendar date.';
+        }
+      });
+    }
+
+    // Check if Temporal is supported natively; load polyfill conditionally if needed
+    (async () => {
+      if (typeof Temporal === 'undefined') {
+        const module = await import('https://esm.sh/@js-temporal/polyfill');
+        globalThis.Temporal = module.Temporal;
+        Date.prototype.toTemporalInstant = module.toTemporalInstant;
+      }
+      initializeApp();
+    })();
+  </script>
 </body>
 
